      228   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   function check-by-mask returns logical (
      230     input p-mask  as character
      231     ,input p-str as character
      232      ,output p-descr as character
      233     ).
      234   define variable ii as integer no-undo .
      235   define variable v-max as integer no-undo .
      236   define variable v-mask-char as character no-undo .
      237   assign
      238   v-max = length (p-mask).
      239   _do:
      240   do ii = 1 to v-max:
      241     assign
      242     v-mask-char = substring(p-mask, ii, 1).
      243     if v-mask-char = chr(63) then NEXT _do.
      244     if v-mask-char = "*":U then do:
      245       if ii < v-max then do:
      246         assign
      247         p-descr = substitute("неверная маска &1: звездочка может быть только последним символом маски").
      248         return no .
      249       end.
      250       return yes.
      251     end.
      252     else do:
      253       if v-mask-char <> substring(p-str, ii, 1) then do:
      254         assign
      255         p-descr = substitute("№ ДК &1 не соответствует МАСКЕ &2", p-str, p-mask).
      256         return no.
      257       end.
      258       next _do.
      259     end.
      260   end.
      261   if v-mask-char = chr(63) and v-max = length(p-str) then return yes.
      262   end function.
      263   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   function card-by-mask returns CHARACTER (
      265                                                input p-cli-mask  as character
      266                                               ,input p-cc-run as INTEGER
      267                                               ,input p-full-number as character
      268                                               ):
      269   define variable ii as integer no-undo .
      270   define variable v-cli-mask as character no-undo .
      271   define variable v-full-number as character no-undo .
      272   define variable v-short-number as character no-undo .
      273     if length(p-cli-mask) <> length(p-full-number) then return '':U.
      274     v-cli-mask = p-cli-mask.
      275     do ii = 1 to length(p-cli-mask):
      276       if substring(v-cli-mask, ii, 1) = 'D' then do:
      277         substring(v-cli-mask, ii, 1) = substring(p-full-number, ii, 1).
      278         assign
      279         v-short-number = v-short-number  + substring(p-full-number, ii, 1)
      280         v-full-number = v-full-number + substring(p-full-number, ii, 1)
      281         .
      282       end.
      283       else do:
      284          if substring(v-cli-mask, ii, 1) = 'C' then do:
      285            v-full-number = v-full-number + substring(p-full-number, ii, 1).
      286          end.
      287          else do:
      288            v-full-number = v-full-number + substring(p-cli-mask, ii, 1).
      289          end.
      290       end.
      291     END.
      292     if v-full-number <> p-full-number then return '':U.
      293     v-full-number = ''.
      294     if index(v-cli-mask, 'C') > 0 then do:
      295       if p-cc-run = 0 then return '':U.
      296       CASE p-cc-run:
      297         when integer('1':U) then do:
      298           run gbl/pluhnalg.p ( input v-cli-mask, output v-full-number) no-error .
      299         end.
      300         otherwise do:
      301           error-status:error = yes.
      302         end.
      303       end case.
      304       if error-status:error then do:
      305         return '':U.
      306       end.
      307       if v-full-number <> p-full-number then return '':U.
      308     end.
      309     return v-short-number.
      310   end function.
      311   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   FUNCTION libchkvl_get-ranged-shift-num returns integer (input p-shift-num-list as character
      313                                                 ,input p-status-list as character):
      314    if num-entries(p-shift-num-list) = 1 then return integer(p-shift-num-list).
      315    if index(p-status-list, '3') > 0 then return integer(entry(lookup('3', p-status-list) ,p-shift-num-list )).
      316    if index(p-status-list, '2') > 0 then return integer(entry(lookup('2', p-status-list) ,p-shift-num-list )).
      317    if index(p-status-list, '1') > 0 then return integer(entry(lookup('1', p-status-list) ,p-shift-num-list )).
      318    if index(p-status-list, '0') > 0 then return integer(entry(lookup('0', p-status-list) ,p-shift-num-list )).
      319   END FUNCTION.
      320   procedure libchkvl_get-shift-num :
      321   define input parameter p-obj-type like ub.chk-doc.obj-type no-undo .
      322   define input parameter p-obj-code like ub.chk-doc.obj-code no-undo .
      323   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
      324   define input parameter p-shift-name as character no-undo .
      325   define output parameter p-shift-num as integer no-undo .
      326   define variable v-shift-num-list as character no-undo .
      327   define variable v-status-list as character no-undo .
      328   define buffer buf_shift-obj for ub.shift-obj .
      329     do
      330     on error undo, return error
      331     :
      332       for each  buf_shift-obj no-lock  where
      333               buf_shift-obj.obj-type    = p-obj-type
      334           AND  buf_shift-obj.obj-code   = p-obj-code
      335           AND  buf_shift-obj.shift-date = p-shift-date
      336           and  buf_shift-obj.shift-name = p-shift-name
      337           on error undo, return error return-value :
      338         assign
      339         v-shift-num-list = string(buf_shift-obj.shift-num) +
      340                           (if v-shift-num-list = '':U then '':U else chr(44)) + v-shift-num-list
      341         v-status-list    = entry(lookup(buf_shift-obj.status_, 'ожд,тек,зкр,отм':U), '2,3,1,0':U) +
      342                           (if v-status-list = '':U then '':U else chr(44)) + v-status-list
      343         .
      344       end.
      345       if v-shift-num-list = '':U then do:
      346         p-shift-num = 0.
      347       end.
      348       else do:
      349         assign
      350         p-shift-num = libchkvl_get-ranged-shift-num(v-shift-num-list, v-status-list).
      351       end.
      352     end.
      353   end procedure.
      354   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      356                                                       ,input p-range-type as character
      357                                                       ,input p-code as integer):
      358   define variable v-seq-val as integer no-undo .
      359   define buffer buf_code-range for ub.code-range.
      360   find first buf_code-range no-lock where
      361             buf_code-range.db-num = p-db-num
      362       and  buf_code-range.range-type = p-range-type
      363       and  buf_code-range.stts = 'u'
      364       and buf_code-range.first-code <= p-code
      365       and buf_code-range.last-code >= p-code no-error .
      366   if available buf_code-range then return yes.
      367   CASE p-range-type:
      368     when 'pngb':U then do:
      369       v-seq-val = current-value(s-pngb-code, ub).
      370     end.
      371     when 'fmgb':U then do:
      372       v-seq-val = current-value(s-fmgb-code, ub).
      373     end.
      374   END CASE.
      375   if p-code <= v-seq-val then do:
      376     find first buf_code-range no-lock where
      377               buf_code-range.db-num = p-db-num
      378         and  buf_code-range.range-type = p-range-type
      379         and  buf_code-range.stts = 'a'
      380         and buf_code-range.first-code <= p-code
      381         no-error .
      382    if available buf_code-range then return yes.
      383   end.
      384   find first buf_code-range no-lock where
      385             buf_code-range.db-num = p-db-num
      386       and  buf_code-range.range-type = p-range-type
      387       and  buf_code-range.stts = 'f'
      388       and buf_code-range.first-code <= p-code
      389       and buf_code-range.last-code >= p-code
      390       no-error .
      391   if available buf_code-range then return yes.
      392   return no.
      393   END FUNCTION.
      394   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      395                                                       ,input p-range-type as character
      396                                                       ,input p-code as integer):
      397   define variable v-seq-val as integer no-undo .
      398   define buffer buf_code-range for ub.code-range.
      399   CASE p-range-type:
      400     when 'pngb':U then do:
      401       v-seq-val = current-value(s-pngb-code, ub).
      402     end.
      403     when 'fmgb':U then do:
      404       v-seq-val = current-value(s-fmgb-code, ub).
      405     end.
      406   END CASE.
      407   if p-code <= v-seq-val then do:
      408     find first buf_code-range no-lock where
      409               buf_code-range.db-num = p-db-num
      410         and  buf_code-range.range-type = p-range-type
      411         and buf_code-range.first-code <= p-code
      412         and buf_code-range.last-code >= p-code no-error .
      413     if available buf_code-range then return yes.
      414   end.
      415   return no.
      416   END FUNCTION.
      417   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      418                                                       ,input p-db-num as integer
      419                                                       ,input p-staff-code as integer
      420                                                       ,input p-date as date
      421                                                        ):
      422   define buffer buf_staff for ub.staff.
      423   if p-date = ? then do:
      424     p-date = today .
      425   end.
      426   find first buf_staff no-lock where
      427             buf_staff.role = p-role
      428         and buf_staff.role-level = 'db':U
      429         and buf_staff.db-num = p-db-num
      430         and buf_staff.staff-code = p-staff-code
      431         and buf_staff.date-end >= p-date use-index pi  no-error .
      432   if available buf_staff then do:
      433     return buf_staff.psn-code.
      434   end.
      435   return 0.
      436   end FUNCTION.
      437   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      438                                                             ,input p-db-num as integer
      439                                                             ,input p-date as date
      440                                                                 ):
      441   define buffer buf_staff for ub.staff.
      442   define buffer buf2_staff for ub.staff.
      443   if p-date = ? then do:
      444     p-date = today .
      445   end.
      446   for each  buf_staff no-lock where
      447             buf_staff.role = p-role
      448         and buf_staff.db-num = p-db-num,
      449   first buf2_staff no-lock where
      450         buf2_staff.role = p-role
      451     and buf2_staff.role-level = 'db':U
      452     and buf2_staff.staff-code = buf_staff.staff-code
      453     and buf2_staff.date-start <= p-date
      454     and buf2_staff.date-end >= p-date
      455   by buf_staff.staff-code
      456   by date-start descending:
      457     return buf_staff.staff-code.
      458   end.
      459   end FUNCTION.
      460   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      461                                                  ,input p-db-num as integer
      462                                                  ,input p-psn-code as integer
      463                                                  ,input p-date as date
      464                                                  ,output p-c-password as character
      465                                                        ):
      466   define buffer buf_staff for ub.staff.
      467   if p-date = ? then do:
      468     p-date = today .
      469   end.
      470   find first buf_staff no-lock where
      471             buf_staff.role = p-role
      472         and buf_staff.role-level = 'db':U
      473         and buf_staff.db-num = p-db-num
      474        and buf_staff.date-end >= p-date
      475        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      476   if available buf_staff
      477   then do:
      478     assign
      479     p-c-password = buf_staff.password.
      480     return buf_staff.staff-code.
      481   end.
      482   p-c-password = ''.
      483   return 0.
      484   end FUNCTION.
      485   FUNCTION gbclcode-is-psn-role returns integer (
      486                                                 input p-role as character
      487                                                 ,input p-psn-code as integer
      488                                                 ,input p-date as date
      489                                                     ):
      490   define buffer buf_staff for ub.staff.
      491   if p-date = ? then do:
      492     p-date = today .
      493   end.
      494   for each buf_staff no-lock where
      495             buf_staff.psn-code = p-psn-code
      496        and  buf_staff.role = p-role
      497   by buf_staff.role-level
      498   by buf_staff.date-start
      499        :
      500     if  buf_staff.date-start <= p-date and
      501     buf_staff.date-end >= p-date  then do:
      502       return buf_staff.staff-code.
      503     end.
      504   end.
      505   return 0.
      506   end FUNCTION.
      507   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      508   define variable v-role-name as character no-undo .
      509   assign
      510   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      511   no-error .
      512   return v-role-name.
      513   END.
      514   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   FUNCTION gbclcode-get-position returns character ( input p-role as character
      516                                                     ,input p-role-level as character
      517                                                     ,input p-work-place as character
      518                                                     ,input p-staff-code as integer
      519                                                                ):
      520   define variable v-role-name as character no-undo .
      521   define variable v-role-level as character no-undo .
      522   define variable v-staff-code as integer no-undo .
      523   assign
      524   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      525   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      526   v-staff-code = p-staff-code
      527   no-error .
      528   return substitute("&1, &2, Код &3"
      529                   ,v-role-name
      530                   ,v-role-level
      531                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      532   END.
      533   FUNCTION gbclcode-get-work-place returns character (
      534                                                   input p-role as character
      535                                                  ,input p-role-level as character
      536                                                  ,input p-db-num as integer
      537                                                  ,input p-host-code as integer
      538                                                  ,input p-obj-type as character
      539                                                  ,input p-obj-code as integer
      540                                                  ) :
      541   define variable v-work-place as character no-undo .
      542   define variable v-obj-type as character no-undo .
      543     case p-role-level:
      544       when 'db':U then do:
      545         v-work-place = string(p-db-num, "99999").
      546       end.
      547       when 'firm':U then do:
      548         v-work-place = string(p-host-code, "99999").
      549       end.
      550       when 'object':U then do:
      551         assign
      552         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      553         .
      554       end.
      555     END CASE.
      556     return v-work-place.
      557   END FUNCTION.
      558   FUNCTION gbclcode-get-level-last-code returns integer (
      559                                                           input p-role as character
      560                                                         , input p-role-level as character
      561                                                         , input p-work-place as character
      562                                                         , input p-date-start as date
      563                                                         ):
      564   DEFINE VARIABLE v-today as date no-undo .
      565   define buffer buf_staff for ub.staff.
      566   if p-work-place = chr(63) then return ?.
      567   if p-date-start = ? then do:
      568     v-today = today .
      569   end.
      570   else do:
      571     v-today = p-date-start.
      572   end.
      573   find last buf_staff no-lock where
      574             buf_staff.role = p-role
      575        and  buf_staff.role-level = p-role-level
      576        and  buf_staff.work-place = p-work-place
      577        and  buf_staff.date-start <= v-today + 1
      578        and  buf_staff.date-end >= v-today + 1
      579        use-index pi  no-error .
      580   if available buf_staff
      581   then return buf_staff.staff-code.
      582   return 0.
      583   end FUNCTION.
      584   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   procedure cur-time :
      586      define output parameter p-today as date      no-undo .
      587      define output parameter p-time  as integer   no-undo .
      588     do
      589     on error undo, return error
      590     :
      591       define variable v-date1 as date      no-undo .
      592       define variable v-date2 as date      no-undo .
      593       define variable v-time  as integer   no-undo .
      594       assign
      595         v-date1 = today
      596         v-time  = time
      597         v-date2 = today
      598       .
      599       if v-date1 <> v-date2
      600       then do:
      601         assign
      602           v-date1 = today
      603           v-time  = v-time
      604         .
      605       end.
      606       assign
      607         p-today = v-date1
      608         p-time  = v-time
      609       .
      610     end.
      611   end.
      612   function cur-time-date returns character
      613   :
      614     return string(today, '99/99/9999':U) .
      615   end.
      616   function cur-time-mjd returns decimal
      617   :
      618     define variable v-date as date      no-undo .
      619     define variable v-time as integer   no-undo .
      620     run cur-time in this-procedure
      621       (output v-date
      622       ,output v-time
      623       ) .
      624     return integer(v-date) - 2400002 + (v-time / 86400) .
      625   end.
      626   function cur-time-get-ending-index returns integer
      627   (input p-number as integer
      628   )
      629   :
      630     if p-number < 0
      631     or p-number = ?
      632     then do:
      633       return 1 .
      634     end.
      635     define variable v-rest as integer   no-undo .
      636     assign
      637       p-number = p-number modulo 100
      638     .
      639     if p-number < 20
      640     then do:
      641       assign
      642         v-rest = p-number
      643       .
      644     end.
      645     else do:
      646       assign
      647         v-rest = p-number modulo 10
      648       .
      649     end.
      650     case v-rest :
      651       when 1
      652       then do:
      653         return 2 .
      654       end.
      655       when 2 or
      656       when 3 or
      657       when 4
      658       then do:
      659         return 3 .
      660       end.
      661       otherwise do:
      662         return 1 .
      663       end.
      664     end case .
      665   end.
      666   procedure cur-time-mjd-to-date :
      667      define input  parameter i-mjd-diff as decimal no-undo.
      668      define output parameter o-Date     as date    no-undo.
      669      define output parameter o-Time     as integer no-undo.
      670      define variable v-day-number as integer   no-undo .
      671      if    i-mjd-diff < 0
      672         or i-mjd-diff = ?
      673      then do:
      674         return "?" .
      675      end.
      676      assign
      677         v-day-number = truncate(i-mjd-diff,0).
      678         o-Date = date(v-day-number + 2400002).
      679         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      680     .
      681   end.
      682   function cur-time-mjd-to-string returns character
      683   (input p-mjd-diff as decimal
      684   )
      685   :
      686     define variable v-day-number as integer   no-undo .
      687     define variable v-seconds    as integer   no-undo .
      688     define variable v-hour       as integer   no-undo .
      689     define variable v-min        as integer   no-undo .
      690     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      691     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      692     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      693     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      694     if p-mjd-diff < 0
      695     or p-mjd-diff = ?
      696     then do:
      697       return "?" .
      698     end.
      699     assign
      700       v-day-number = integer(truncate(p-mjd-diff,0))
      701       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      702     .
      703     if v-seconds > 86400
      704     then do:
      705       assign
      706         v-seconds = 86400 - 1
      707       .
      708     end.
      709     if v-seconds < 0
      710     then do:
      711       assign
      712         v-seconds = 0
      713       .
      714     end.
      715     assign
      716       v-hour = truncate(v-seconds / 3600, 0)
      717     .
      718     assign
      719       v-seconds = v-seconds modulo 3600
      720     .
      721     assign
      722       v-min = truncate(v-seconds / 60, 0)
      723     .
      724     assign
      725       v-seconds = v-seconds modulo 60
      726     .
      727     return
      728         (if v-day-number <> 0
      729           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      730           else ""
      731         )
      732       + (if v-day-number <> 0 or v-hour <> 0
      733           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      734           else ""
      735         )
      736       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      737           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      738           else ""
      739         )
      740       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      741       .
      742   end.
      743   function cur-time-string returns character
      744   :
      745     define variable v-date as date      no-undo .
      746     define variable v-time as integer   no-undo .
      747     run cur-time in this-procedure
      748       (output v-date
      749       ,output v-time
      750       ) .
      751     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      752   end.
      753   function cur-time-string-sec returns character
      754   :
      755     define variable v-date as date      no-undo .
      756     define variable v-time as integer   no-undo .
      757     run cur-time in this-procedure
      758       (output v-date
      759       ,output v-time
      760       ) .
      761     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      762   end.
      763   function cur-time-custom  returns character
      764   (input p-prefix as character
      765   ,input p-date-format as character
      766   ,input p-delimiter as character
      767   ,input p-time-format as character
      768   ,input p-suffix as character
      769   )
      770   :
      771     define variable v-date as date      no-undo .
      772     define variable v-time as integer   no-undo .
      773     run cur-time in this-procedure
      774       (output v-date
      775       ,output v-time
      776       ) .
      777     return
      778       p-prefix
      779       + string(v-date, p-date-format)
      780       + p-delimiter
      781       + string(v-time, p-time-format)
      782       + p-suffix
      783       .
      784   end.
      785   function cur-time-print  returns character
      786   :
      787     define variable v-date as date      no-undo .
      788     define variable v-time as integer   no-undo .
      789     run cur-time in this-procedure
      790       (output v-date
      791       ,output v-time
      792       ) .
      793     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      794   end.
      795   function cur-time-datetime returns datetime
      796   :
      797     define variable v-char as character no-undo .
      798     define variable v-datetime as datetime no-undo .
      799     v-char = cur-time-string().
      800     v-datetime = datetime(v-char).
      801     return  v-datetime.
      802   end.
      803   function cur-time-string-msec returns character
      804   :
      805     define variable v-date as datetime  no-undo .
      806     v-date = now.
      807     return string(v-date) .
      808   end.
      809   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   define temp-table libchkvl_dis-card-mask no-undo
      811   like ub.dis-card-mask
      812   .
      813   function ChkGdsPromo returns logical
      814       (input iDocCode as character)
      815       :
      816       define buffer buf_chk-gds for ub.chk-gds.
      817       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      818       define variable vPromo as logical no-undo.
      819       vPromo = no.
      820       cspr:
      821       for each buf_chk-gds no-lock where
      822                    buf_chk-gds.doc-code = iDocCode,
      823              first buf_chk-gds-attr no-lock where
      824                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      825                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      826                and buf_chk-gds-attr.attr-code = "CSPromo"
      827                and buf_chk-gds-attr.attr-value <> "0":
      828          vPromo = yes.
      829          leave cspr.
      830       end.
      831       return vPromo.
      832   end.
      833   function ChkPromoLine returns logical
      834       (input iDocCode as character,
      835       input iLineNum as integer)
      836       :
      837       define buffer buf_chk-gds for ub.chk-gds.
      838       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      839       define variable vPromo as logical no-undo.
      840       vPromo = no.
      841       find first buf_chk-gds-attr no-lock where
      842                    buf_chk-gds-attr.doc-code = iDocCode
      843                and buf_chk-gds-attr.line-num  = iLineNum
      844                and buf_chk-gds-attr.attr-code = "CSPromo"
      845                and buf_chk-gds-attr.attr-value <> "0"
      846       no-error.
      847       if avail buf_chk-gds-attr then vPromo = yes.
      848       return vPromo.
      849   end.
      850   function ChkPromoSum returns decimal
      851       (input iDocCode as character,
      852        input iLineNum as integer)
      853       :
      854      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      855      define variable vSumPromo as decimal no-undo.
      856      find first buf_chk-gds-attr no-lock where
      857                 buf_chk-gds-attr.doc-code = iDocCode
      858             and buf_chk-gds-attr.line-num  = iLineNum
      859             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      860         no-error.
      861      if avail buf_chk-gds-attr then
      862         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      863      return vSumPromo.
      864   end function.
      865   function ChkPromoPrice returns logical
      866       (input iDocCode as character,
      867        input iLineNum as integer)
      868       :
      869      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      870      define variable v-is-promo as logical no-undo.
      871      v-is-promo = no.
      872      find first buf_chk-gds-attr no-lock where
      873                 buf_chk-gds-attr.doc-code = iDocCode
      874             and buf_chk-gds-attr.line-num  = iLineNum
      875             and buf_chk-gds-attr.attr-code = "CSPromo"
      876         no-error.
      877      if avail buf_chk-gds-attr
      878        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      879      then v-is-promo = yes.
      880      return v-is-promo.
      881   end function.
      882   function ChkDopLitr returns logical
      883       (input iDocCode as character,
      884        input iLineNum as integer)
      885       :
      886      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      887      define variable v-is-promo as logical no-undo.
      888      v-is-promo = no.
      889      find first buf_chk-gds-attr no-lock where
      890                 buf_chk-gds-attr.doc-code = iDocCode
      891             and buf_chk-gds-attr.line-num  = iLineNum
      892             and buf_chk-gds-attr.attr-code = "CSPromo"
      893         no-error.
      894      if avail buf_chk-gds-attr and
      895        buf_chk-gds-attr.attr-value = "3"
      896      then v-is-promo = yes.
      897      return v-is-promo.
      898   end function.
      899   function RoundUp return decimal
      900       (input iQnty as decimal,
      901        input iPrice as decimal):
      902       def var vSum  as decimal no-undo.
      903       def var vSumR as decimal no-undo.
      904       vSum = ABSOLUTE(iQnty) * iPrice.
      905       vSumR = Round(vSum,2).
      906       if vSumR < vSum then vSumR = vSumR + 0.01.
      907       if iQnty < 0 then vSumR = - vSumR.
      908       return vSumR.
      909   end function.
      910   function GetPromoSum returns decimal
      911       (input iDocCode as character)
      912       :
      913       define buffer buf_chk-doc for ub.chk-doc.
      914       define buffer buf2_chk-doc for ub.chk-doc.
      915       define buffer buf_chk-gds for ub.chk-gds.
      916       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      917       define buffer buf2_chk-gds for ub.chk-gds.
      918       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      919       define variable v-price-base as decimal no-undo.
      920       define variable v-doc-qnty as decimal no-undo.
      921       define variable v-sum-base as decimal no-undo.
      922       define variable v-sum-all as decimal no-undo.
      923       define variable v-sum-promo as decimal no-undo.
      924       define variable v-sum-chk as decimal no-undo.
      925       assign
      926          v-price-base = 0
      927          v-doc-qnty = 0
      928          v-sum-all = 0
      929          v-sum-chk = 0
      930          v-sum-promo = 0
      931          .
      932       for each buf_chk-gds no-lock where
      933                buf_chk-gds.doc-code = iDocCode,
      934          first buf_chk-gds-attr no-lock where
      935                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      936            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      937            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      938          :
      939          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      940       end.
      941       if v-sum-promo = 0 then do:
      942           for each buf_chk-gds no-lock where
      943                    buf_chk-gds.doc-code = iDocCode,
      944              first buf_chk-gds-attr no-lock where
      945                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      946                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      947                and buf_chk-gds-attr.attr-code = "CSPromo"
      948                and can-do("1,6", buf_chk-gds-attr.attr-value)
      949              :
      950              assign
      951                v-price-base = buf_chk-gds.price-base
      952                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      953                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      954                .
      955           end.
      956           for each buf_chk-gds no-lock where
      957                    buf_chk-gds.doc-code = iDocCode,
      958              first buf_chk-gds-attr no-lock where
      959                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      960                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      961                and buf_chk-gds-attr.attr-code = "CSPromo"
      962                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      963              :
      964              if v-price-base = 0 then do:
      965                 find first buf_chk-doc no-lock where
      966                            buf_chk-doc.doc-code = iDocCode
      967                     no-error.
      968                 if avail buf_chk-doc and
      969                    buf_chk-doc.chk-type = int('6':U) and
      970                    buf_chk-doc.doc-num2 > ""  and
      971                    num-entries(buf_chk-doc.doc-num2,":") = 2
      972                 then
      973                 for first buf2_chk-doc no-lock where
      974                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      975                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      976                       and buf2_chk-doc.chk-type = int('1':U)
      977                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      978                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      979                       :
      980                   for each buf2_chk-gds no-lock where
      981                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      982                      first buf2_chk-gds-attr no-lock where
      983                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      984                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      985                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      986                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      987                      :
      988                       v-price-base = buf2_chk-gds.price-base.
      989                   end.
      990                 end.
      991              end.
      992              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
      993                  assign
      994                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
      995                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
      996                     .
      997              end.
      998              else do:
      999                 assign
     1000                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     1001                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     1002                 .
     1003              end.
     1004           end.
     1005           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     1006       end.
     1007       return v-sum-promo.
     1008   end function.
     1009   function GetUnBaseSum returns decimal
     1010       (input iDocCode as character,
     1011        input iLineNum as integer,
     1012        input iQnty as decimal,
     1013        input iPrice as decimal):
     1014      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1015      define variable vBaseSum as decimal no-undo.
     1016      define variable vDiscSum as decimal no-undo.
     1017      vDiscSum = 0.
     1018      find first buf_chk-gds-attr no-lock where
     1019                        buf_chk-gds-attr.doc-code = iDocCode
     1020                    and buf_chk-gds-attr.line-num  = iLineNum
     1021                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1022             no-error.
     1023      if avail buf_chk-gds-attr then
     1024         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     1025      vBaseSum = iQnty * iPrice + vDiscSum.
     1026      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     1027         vBaseSum = RoundUp(iQnty, iPrice).
     1028      return vBaseSum.
     1029   end function.
     1030   function GetRoundSum returns decimal
     1031       (input iDocCode as character,
     1032        input iLineNum as integer,
     1033        input iQnty as decimal,
     1034        input iPrice as decimal):
     1035      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1036      define variable vBaseSum as decimal no-undo.
     1037      if ChkPromoPrice(iDocCode, iLineNum) then
     1038         vBaseSum = RoundUp(iQnty, iPrice).
     1039      else vBaseSum = iQnty * iPrice.
     1040      return vBaseSum.
     1041   end function.
     1042   function GetRoundSumChkDel returns decimal
     1043       (input iDocCode as character,
     1044        input iLineNum as integer,
     1045        input iChipNum as integer,
     1046        input iQnty as decimal,
     1047        input iPrice as decimal):
     1048      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1049      define variable vBaseSum as decimal no-undo.
     1050      define variable vIsPromo as logical no-undo.
     1051      for each buf_c-chk-doc-attr no-lock where
     1052               buf_c-chk-doc-attr.doc-code = iDocCode
     1053           and buf_c-chk-doc-attr.chip-num = iChipNum
     1054          :
     1055          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     1056          then do :
     1057            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     1058            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     1059            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     1060            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     1061            then vIsPromo = yes.
     1062          end.
     1063      end.
     1064      if ChkPromoPrice(iDocCode, iLineNum) then
     1065         vBaseSum = RoundUp(iQnty, iPrice).
     1066      else vBaseSum = iQnty * iPrice.
     1067      return vBaseSum.
     1068   end function.
     1069   function GetSaleRetDisc returns decimal
     1070       (input iDocCode as character,
     1071        input iSaleCode as character):
     1072      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1073      define buffer buf_chk-gds for ub.chk-gds.
     1074      define variable vQntyPromoRet as decimal no-undo.
     1075      define variable vQntyPromoSel as decimal no-undo.
     1076      define variable vDiscSumRet   as decimal no-undo.
     1077      define variable vDiscSumSale  as decimal no-undo.
     1078      vDiscSumRet = 0.
     1079      cspr:
     1080      for each  buf_chk-gds no-lock where
     1081                buf_chk-gds.doc-code = iDocCode,
     1082          first buf_chk-gds-attr no-lock where
     1083                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1084            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1085            and buf_chk-gds-attr.attr-code = "CSPromo"
     1086            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1087          :
     1088          vQntyPromoRet = buf_chk-gds.src-qnty.
     1089          leave cspr.
     1090      end.
     1091      if vQntyPromoRet <> 0 then
     1092      for each  buf_chk-gds no-lock where
     1093                buf_chk-gds.doc-code = iSaleCode:
     1094          find first buf_chk-gds-attr no-lock where
     1095                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1096                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1097                 and buf_chk-gds-attr.attr-code = "CSPromo"
     1098          no-error.
     1099          if avail buf_chk-gds-attr
     1100               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1101          then
     1102            vQntyPromoSel = buf_chk-gds.src-qnty.
     1103          find first buf_chk-gds-attr no-lock where
     1104                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1105                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1106                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1107          no-error.
     1108          if avail buf_chk-gds-attr then
     1109             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     1110      end.
     1111      if vQntyPromoRet <> 0 and
     1112         vQntyPromoSel = -1 * vQntyPromoRet
     1113      then vDiscSumRet = -1 * vDiscSumSale.
     1114      return vDiscSumRet.
     1115   end function.
     1116   function SetPromoDisc return logical
     1117    (input iDocCode as character,
     1118        input iLineNum as integer
     1119        )
     1120       :
     1121      define buffer buf_chk-doc for ub.chk-doc.
     1122      define buffer buf2_chk-doc for ub.chk-doc.
     1123      define buffer buf_chk-gds for ub.chk-gds.
     1124      define buffer buf2_chk-gds for ub.chk-gds.
     1125      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1126      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1127      define buffer buf_chk-discnt for ub.chk-discnt.
     1128      define buffer buf2_chk-discnt for ub.chk-discnt.
     1129      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     1130      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     1131      define variable v-promo-sum as decimal no-undo.
     1132      define variable v-disc-promo-id as character no-undo.
     1133      define variable var-discnt-id as integer no-undo.
     1134      define variable v-chk-sale as character no-undo.
     1135      find first buf_chk-gds-attr no-lock where
     1136                 buf_chk-gds-attr.doc-code = iDocCode
     1137             and buf_chk-gds-attr.line-num  = iLineNum
     1138             and buf_chk-gds-attr.attr-code = "CSPromo"
     1139         no-error.
     1140      if avail buf_chk-gds-attr
     1141        then do:
     1142        find first buf_chk-discnt no-lock where
     1143                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1144               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     1145               and buf_chk-discnt.record-type = 0
     1146               and buf_chk-discnt.promo-id > ""
     1147               no-error.
     1148        if not avail buf_chk-discnt then do:
     1149           find first buf_chk-doc no-lock where
     1150                      buf_chk-doc.doc-code = iDocCode
     1151              no-error.
     1152           find first buf_chk-gds no-lock where
     1153                      buf_chk-gds.doc-code = iDocCode
     1154                 and  buf_chk-gds.line-num = iLineNum
     1155              no-error.
     1156          for first buf2_chk-doc no-lock where
     1157                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1158                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1159                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1160                and buf2_chk-doc.chk-type = int('1':U)
     1161                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1162                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1163              :
     1164              find first buf2_chk-gds no-lock where
     1165                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1166                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1167              no-error.
     1168              if not avail buf2_chk-gds then return no.
     1169              v-chk-sale = buf2_chk-doc.doc-code.
     1170              find first buf_chk-discnt no-lock where
     1171                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1172                         buf_chk-discnt.record-type = 1 and
     1173                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1174                         buf_chk-discnt.promo-id > ""
     1175              no-error .
     1176              if avail buf_chk-discnt
     1177              then do:
     1178                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1179                 find first buf2_chk-discnt no-lock where
     1180                   buf2_chk-discnt.doc-code = iDocCode and
     1181                   buf2_chk-discnt.record-type = 5 and
     1182                   buf2_chk-discnt.line-num = 0 and
     1183                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1184                 no-error.
     1185                 find first buf2_chk-discnt-attr no-lock where
     1186                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1187                            buf2_chk-discnt-attr.record-type = 5 and
     1188                            buf2_chk-discnt-attr.line-num = 0 and
     1189                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1190                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1191                       no-error .
     1192                 if not avail buf2_chk-discnt
     1193                 then do:
     1194                     for each buf_chk-discnt no-lock where
     1195                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1196                          and buf_chk-discnt.record-type = 5:
     1197                          var-discnt-id  = var-discnt-id + 1.
     1198                     end.
     1199                     create buf2_chk-discnt.
     1200                     assign
     1201                       buf2_chk-discnt.doc-code = iDocCode
     1202                       buf2_chk-discnt.record-type = 5
     1203                       buf2_chk-discnt.line-num = 0
     1204                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1205                       buf2_chk-discnt.object-sum = 0
     1206                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1207                                                      then buf2_chk-discnt-attr.discnt-id
     1208                                                      else (var-discnt-id + 1)
     1209                       var-discnt-id = 0
     1210                       buf2_chk-discnt.object-line-num = 0
     1211                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1212                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1213                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1214                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1215                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1216                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1217                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1218                       .
     1219                 end.
     1220                 if avail buf2_chk-discnt and
     1221                    not avail buf2_chk-discnt-attr
     1222                 then do:
     1223                    create buf2_chk-discnt-attr.
     1224                    assign
     1225                       buf2_chk-discnt-attr.doc-code = iDocCode
     1226                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1227                       buf2_chk-discnt-attr.record-type     = 5
     1228                       buf2_chk-discnt-attr.line-num        = 0
     1229                       buf2_chk-discnt-attr.object-line-num = 0
     1230                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1231                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1232                       .
     1233                 end.
     1234              end.
     1235          end.
     1236           v-promo-sum = 0.
     1237           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1238           then do:
     1239              if v-chk-sale <> ? and v-chk-sale <> "" then
     1240                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1241              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1242              if v-promo-sum <> 0 then do:
     1243                  find first buf2_chk-gds-attr no-lock where
     1244                             buf2_chk-gds-attr.doc-code = iDocCode
     1245                         and buf2_chk-gds-attr.line-num  = iLineNum
     1246                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1247                     no-error.
     1248                  if not avail buf2_chk-gds-attr then do:
     1249                      create buf2_chk-gds-attr.
     1250                      assign
     1251                         buf2_chk-gds-attr.doc-code = iDocCode
     1252                         buf2_chk-gds-attr.line-num  = iLineNum
     1253                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1254                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1255                         .
     1256                  end.
     1257              end.
     1258           end.
     1259           for each buf_chk-discnt no-lock where
     1260                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1261               and buf_chk-discnt.record-type = 0:
     1262              var-discnt-id  = var-discnt-id + 1.
     1263           end.
     1264           create buf_chk-discnt.
     1265           assign
     1266               buf_chk-discnt.doc-code = iDocCode
     1267               buf_chk-discnt.line-num = iLineNum
     1268               buf_chk-discnt.record-type = 0
     1269               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1270               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1271               buf_chk-discnt.line-type = integer('1':U)
     1272               buf_chk-discnt.line-sign = no
     1273               buf_chk-discnt.pass-discnt = integer('0':U)
     1274               buf_chk-discnt.value-type = integer('2':U)
     1275               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1276               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1277               buf_chk-discnt.discnt-value-abs = 0
     1278               buf_chk-discnt.discnt-value-pcnt = 0
     1279               buf_chk-discnt.object-line-num = iLineNum
     1280               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1281               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1282               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1283               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1284               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1285               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1286               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1287               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1288               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1289               var-discnt-id = var-discnt-id + 1
     1290               buf_chk-discnt.promo-id = v-disc-promo-id
     1291               buf_chk-discnt.discnt-type = integer('7':U)
     1292               .
     1293           find first buf_chk-discnt-attr no-lock where
     1294                      buf_chk-discnt-attr.attr-code = "promo-id"
     1295                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1296                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1297                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1298                  no-error.
     1299           if not avail buf_chk-discnt-attr then
     1300           do:
     1301               create buf_chk-discnt-attr .
     1302               assign
     1303                   buf_chk-discnt-attr.attr-code = "promo-id"
     1304                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1305                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1306                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1307                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1308                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1309                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1310                   .
     1311            end.
     1312        end.
     1313      end.
     1314      return yes.
     1315   end function.
     1316   function GetPromoPriceSum returns decimal
     1317       (input iDocCode as character)
     1318       :
     1319       define buffer buf_chk-gds for ub.chk-gds.
     1320       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1321       define variable vPromoSum as decimal no-undo.
     1322       vPromoSum = 0.
     1323       cspr:
     1324       for each buf_chk-gds no-lock where
     1325                    buf_chk-gds.doc-code = iDocCode,
     1326              first buf_chk-gds-attr no-lock where
     1327                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1328                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1329                and buf_chk-gds-attr.attr-code = "CSPromo"
     1330                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1331          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1332          leave cspr.
     1333       end.
     1334       return vPromoSum.
     1335   end.
     1336   function GetPromoPriceLine returns integer
     1337       (input iDocCode as character)
     1338       :
     1339       define buffer buf_chk-gds for ub.chk-gds.
     1340       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1341       define variable vPromoLine as integer no-undo.
     1342       vPromoLine = 0.
     1343       cspr:
     1344       for each buf_chk-gds no-lock where
     1345                    buf_chk-gds.doc-code = iDocCode,
     1346              first buf_chk-gds-attr no-lock where
     1347                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1348                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1349                and buf_chk-gds-attr.attr-code = "CSPromo"
     1350                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1351          vPromoLine = buf_chk-gds-attr.line-num.
     1352          leave cspr.
     1353       end.
     1354       return vPromoLine.
     1355   end.
     1356   define variable log-file-name as character no-undo init "get-chkf.log".
     1357   define variable log-file-name0 as character no-undo init "get-chkf.log".
     1358   if valid-handle (g#libchkvl)
     1359   and g#libchkvl <> this-procedure :handle
     1360   and g#libchkvl :get-signature('libchkvl_get-dc-mask-array ':u) <> ""
     1361   then do:
     1362     message
     1363       vss-workfile vss-revision vss-description skip
     1364       "Попытка повторной загрузки библиотеки для проверки валидности чека" skip
     1365       g#libchkvl skip
     1366       g#libchkvl :type skip
     1367       g#libchkvl :file-name skip
     1368       valid-handle(g#libchkvl) skip
     1369       this-procedure :handle skip
     1370       this-procedure :type skip
     1371       this-procedure :file-name skip
     1372       valid-handle(this-procedure) skip
     1373       view-as alert-box error .
     1374     undo, return error .
     1375   end.
     1376   else do:
     1377     assign
     1378       g#libchkvl = this-procedure :handle
     1379     .
     1380   end.
     1381   on delete of this-procedure do:
     1382     assign
     1383       g#libchkvl = ?
     1384     .
     1385   end.
     1386   procedure libchkvl_get-dc-mask-array :
     1387   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1388   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1389   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1390   define buffer buf_dis-card-mask for ub.dis-card-mask.
     1391   define buffer buf_libchkvl_dis-card-mask for libchkvl_dis-card-mask.
     1392   for each buf_libchkvl_dis-card-mask:
     1393     delete buf_libchkvl_dis-card-mask.
     1394   end.
     1395   _maska:
     1396   for each buf_dis-card-mask no-lock where
     1397       buf_Dis-card-mask.stts              = integer('0':U)
     1398   by buf_Dis-card-mask.host-code
     1399   by buf_Dis-card-mask.obj-type
     1400   by buf_Dis-card-mask.obj-code
     1401   by buf_Dis-card-mask.rank
     1402   :
     1403     if buf_dis-card-mask.host-code <> 0
     1404     And buf_dis-card-mask.host-code <> p-host-code then next _maska.
     1405     if (buf_dis-card-mask.obj-type <> "":U
     1406     AND buf_dis-card-mask.obj-type <> p-obj-type)
     1407     or (buf_dis-card-mask.obj-code <> 0
     1408     and buf_dis-card-mask.obj-code <> p-obj-code)
     1409     then NEXT _maska.
     1410     if buf_dis-card-mask.use-on = integer('1':U) then NEXT _Maska.
     1411     create buf_libchkvl_dis-card-mask.
     1412     buffer-copy buf_dis-card-mask to
     1413     buf_libchkvl_dis-card-mask.
     1414   end.
     1415   end.
     1416   function libchkvl_right-netto-sign returns integer ( input p-chk-type as integer):
     1417   if p-chk-type > 200 then p-chk-type = p-chk-type - 100.
     1418   if p-chk-type > 100 then p-chk-type = p-chk-type - 100.
     1419   case p-chk-type:
     1420     when integer('1':U)
     1421     or
     1422     when integer('201':U)
     1423     or
     1424     when integer('3':U)
     1425     or
     1426     when integer('7':U)
     1427       then do:
     1428       return 1.
     1429     end.
     1430     when integer('6':U)
     1431     or
     1432     when integer('96':U)
     1433     or
     1434     when integer('206':U)
     1435     or
     1436     when integer('2':U)
     1437     or
     1438     when integer('5':U)
     1439     then do:
     1440       return -1.
     1441     end.
     1442     when integer('8':U)
     1443     or
     1444     when integer('208':U)
     1445     or
     1446     when integer('11':U)
     1447     or
     1448     when integer('12':U)
     1449     or
     1450     when integer('69':U)
     1451     or
     1452     when integer('14':U)
     1453     or
     1454     when integer('15':U)
     1455     or
     1456     when integer('16':U)
     1457     or
     1458     when integer('17':U)
     1459     or
     1460     when integer('13':U)
     1461     or
     1462     when integer('40':U)
     1463     or
     1464     when integer('4':U)
     1465     then do:
     1466       return 0.
     1467     end.
     1468   end case.
     1469   end function.
     1470   FUNCTION libchkvl_direct-sign returns logical ( input p-chk-type as integer
     1471                                                  ,input p-qnty as decimal):
     1472   return yes.
     1473   end.
     1474   procedure libchkvl_get-cash-shift :
     1475   define input parameter p-context-bh as handle no-undo .
     1476   define parameter buffer buf_shift-cash for ub.shift-cash.
     1477   define input parameter p-cash-num as integer no-undo .
     1478   define input parameter p-shift-date as date no-undo .
     1479   define input parameter p-shift-name as character no-undo .
     1480   define input parameter p-z-number as integer no-undo .
     1481   define input parameter p-chk-date as date no-undo .
     1482   define input parameter p-chk-time as integer no-undo .
     1483   define input parameter p-shift-open-time as integer no-undo .
     1484   DEFINE VARIABLE current-cas-shift-num      as   integer               no-undo .
     1485   DEFINE VARIABLE current-cas-shift-name     as   character             no-undo .
     1486   DEFINE VARIABLE current-cas-shift-date     as   date                  no-undo .
     1487   DEFINE VARIABLE current-cas-shift-status_  as   char                  no-undo .
     1488   DEFINE VARIABLE current-shift-status_      as   character             no-undo init 'тек':U.
     1489   define variable vrecid as recid no-undo .
     1490   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491   define variable v-parparentproc       as widget-handle           no-undo .
     1492   define variable v-p-log-handle        as handle                  no-undo .
     1493   define variable v-p-log-file-name     as character               no-undo .
     1494   define variable v-view-log            as logical                 no-undo .
     1495   define variable v-ll                  as integer                 no-undo .
     1496   define variable v-tt-wd-bh            as handle                  no-undo .
     1497   define variable v-pos-type            as character               no-undo .
     1498   define variable v-cash-num            as integer                 no-undo .
     1499   define variable v-obj-type            as character init 'маг':U  no-undo .
     1500   define variable v-obj-code            as integer                 no-undo .
     1501   define variable v-db-num              as integer                 no-undo .
     1502   define variable v-r-b                 as character               no-undo .
     1503   define variable v-host-code           as integer                 no-undo .
     1504   define variable v-base-code           as integer                 no-undo .
     1505   define variable v-cre-pay             as integer                 no-undo .
     1506   define variable v-is-catering         as logical                 no-undo .
     1507   define variable v-is-cdinv            as logical                 no-undo .
     1508   define variable v-is-ptrl             as logical                 no-undo .
     1509   define variable v-is-wth              as logical                 no-undo .
     1510   define variable v-process-sale        as logical                 no-undo .
     1511   define variable v-dc-mask             as logical                 no-undo .
     1512   define variable v-card-by-mask        as logical                 no-undo .
     1513   define variable v-sclspref            as character               no-undo .
     1514   define variable v-scpgpref            as character               no-undo .
     1515   define variable v-scpgpref-pre        as character               no-undo .
     1516   define variable v-doc-prt             as logical                 no-undo .
     1517   define variable v-shift-on            as logical                 no-undo .
     1518   define variable v-cas-shft            as logical                 no-undo .
     1519   define variable v-t-shft              as integer                 no-undo .
     1520   define variable v-v-shft              as integer                 no-undo .
     1521   define variable v-ptrl-check          as logical                 no-undo .
     1522   define variable v-annu-check          as logical                 no-undo .
     1523   define variable v-z-check             as logical                 no-undo .
     1524   define variable v-hnum                as logical                 no-undo .
     1525   define variable v-is-100-discnt       as logical                 no-undo .
     1526   define variable v-zero-cashier        as integer                 no-undo .
     1527   define variable v-rnd-znak            as integer                 no-undo .
     1528   define variable v-cas-curs            as logical                 no-undo .
     1529   define variable v-nam-2str            as logical                 no-undo .
     1530   define variable v-nam-artc            as logical                 no-undo .
     1531   define variable v-cod-pcod            as logical                 no-undo .
     1532   define variable v-name-2cd            as character               no-undo .
     1533   define variable v-how-temp-disc       as character               no-undo .
     1534   define variable v-nalc                as integer                 no-undo .
     1535   define variable v-rmethod-type        as character               no-undo .
     1536   define variable v-rmethod-coeff       as decimal                 no-undo .
     1537   define variable v-serial-code         as character               no-undo .
     1538   define variable v-salesman-mandatory  as integer                 no-undo .
     1539   define variable v-sales-man           as integer                 no-undo .
     1540   define variable v-salesman-psn-code   as integer                 no-undo .
     1541   define variable v-pos-type-for-discnt as character               no-undo .
     1542   define variable v-manual-discnt       as integer                 no-undo .
     1543   define variable v-is-grp-totals       as logical                 no-undo .
     1544   define variable v-is-gds-totals       as logical                 no-undo .
     1545   define variable v-cash-counter        as decimal                 no-undo .
     1546   define variable v-pre-cash-counter    as decimal                 no-undo .
     1547   define variable v-qnty-change         as logical                 no-undo .
     1548   define variable v-log-level           as integer                 no-undo .
     1549   define variable v-chk-discnt-table    as handle                  no-undo .
     1550   define variable v-chk-gds-table       as handle                  no-undo .
     1551   define variable v-chk-pay-table       as handle                  no-undo .
     1552   define variable v-z-number            as integer                 no-undo .
     1553   define variable v-shift-num           as integer                 no-undo .
     1554   define variable v-shift-date          as date                    no-undo .
     1555   define variable v-shift-name          as character               no-undo .
     1556   define variable v-emulator-mode       as integer                 no-undo .
     1557   define variable v-ibmgroup            as logical                 no-undo .
     1558   define buffer buf_shift-obj for ub.shift-obj.
     1559   main-block:
     1560   do
     1561   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1562   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1563   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1564   :
     1565   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   assign
     1567   v-parparentproc                      =  p-context-bh::parparentproc
     1568   v-p-log-handle                       =  p-context-bh::p-log-handle
     1569   v-p-log-file-name                    =  p-context-bh::p-log-file-name
     1570   v-view-log                           =  p-context-bh::view-log
     1571   v-ll                                 =  p-context-bh::ll
     1572   v-tt-wd-bh                           =  p-context-bh::tt-wd-bh
     1573   v-pos-type                           =  p-context-bh::pos-type
     1574   v-cash-num                           =  p-context-bh::cash-num
     1575   v-obj-type                           =  p-context-bh::obj-type
     1576   v-db-num                             =  p-context-bh::db-num
     1577   v-obj-code                           =  p-context-bh::obj-code
     1578   v-r-b                                =  p-context-bh::r-b
     1579   v-host-code                          =  p-context-bh::host-code
     1580   v-base-code                          =  p-context-bh::base-code
     1581   v-cre-pay                            =  p-context-bh::cre-pay
     1582   v-is-catering                        =  p-context-bh::is-catering
     1583   v-is-cdinv                           =  p-context-bh::is-cdinv
     1584   v-is-ptrl                            =  p-context-bh::is-ptrl
     1585   v-is-wth                             =  p-context-bh::is-wth
     1586   v-dc-mask                            =  p-context-bh::dc-mask
     1587   v-card-by-mask                       =  p-context-bh::card-by-mask
     1588   v-sclspref                           =  p-context-bh::sclspref
     1589   v-scpgpref                           =  p-context-bh::scpgpref
     1590   v-scpgpref-pre                       =  p-context-bh::scpgpref-pre
     1591   v-doc-prt                            =  p-context-bh::doc-prt
     1592   v-shift-on                           =  p-context-bh::shift-on
     1593   v-cas-shft                           =  p-context-bh::cas-shft
     1594   v-t-shft                             =  p-context-bh::t-shft
     1595   v-v-shft                             =  p-context-bh::v-shft
     1596   v-ptrl-check                         =  p-context-bh::ptrl-check
     1597   v-annu-check                         =  p-context-bh::annu-check
     1598   v-z-check                            =  p-context-bh::z-check
     1599   v-hnum                               =  p-context-bh::hnum
     1600   v-is-100-discnt                      =  p-context-bh::is-100-discnt
     1601   v-zero-cashier                       =  p-context-bh::zero-cashier
     1602   v-rnd-znak                           =  p-context-bh::rnd-znak
     1603   v-cas-curs                           =  p-context-bh::cas-curs
     1604   v-nam-2str                           =  p-context-bh::nam-2str
     1605   v-nam-artc                           =  p-context-bh::nam-artc
     1606   v-cod-pcod                           =  p-context-bh::cod-pcod
     1607   v-name-2cd                           =  p-context-bh::name-2cd
     1608   v-how-temp-disc                      =  p-context-bh::how-temp-disc
     1609   v-nalc                               =  p-context-bh::nalc
     1610   v-serial-code                        =  p-context-bh::serial-code
     1611   v-salesman-mandatory                 =  p-context-bh::salesman-mandatory
     1612   v-sales-man                          =  p-context-bh::sales-man
     1613   v-salesman-psn-code                  =  p-context-bh::salesman-psn-code
     1614   v-pos-type-for-discnt                =  p-context-bh::pos-type-for-discnt
     1615   v-manual-discnt                      =  p-context-bh::manual-discnt
     1616   v-is-grp-totals                      =  p-context-bh::is-grp-totals
     1617   v-is-gds-totals                      =  p-context-bh::is-gds-totals
     1618   v-chk-discnt-table                   =  p-context-bh::chk-discnt-table
     1619   v-chk-gds-table                      =  p-context-bh::chk-gds-table
     1620   v-chk-pay-table                      =  p-context-bh::chk-pay-table
     1621   v-z-number                           =  p-context-bh::z-number
     1622   v-shift-num                          =  p-context-bh::shift-num
     1623   v-shift-date                         =  p-context-bh::shift-date
     1624   v-shift-name                         =  p-context-bh::shift-name
     1625   v-emulator-mode                      =  p-context-bh::emulator-mode
     1626   v-ibmgroup                           =  p-context-bh::ibmgroup
     1627   .
     1628     if v-p-log-file-name <> ""
     1629     or v-p-log-file-name <> ? then do:
     1630       log-file-name = v-p-log-file-name.
     1631     end.
     1632     else do:
     1633       log-file-name = log-file-name0.
     1634     end.
     1635     if v-shift-on then do:
     1636       _sc:
     1637       for each  buf_shift-cash Exclusive-LOCK WHERE
     1638                 (buf_shift-cash.obj-type = v-obj-type
     1639             AND buf_shift-cash.obj-code = v-obj-code
     1640             AND buf_shift-cash.cash-num = p-cash-num
     1641             AND buf_shift-cash.shift-date = p-shift-date
     1642             AND buf_shift-cash.src-shift-name = p-shift-name)
     1643         or
     1644                 (buf_shift-cash.obj-type = v-obj-type
     1645             AND buf_shift-cash.obj-code = v-obj-code
     1646             AND buf_shift-cash.cash-num = p-cash-num
     1647             AND buf_shift-cash.shift-date = p-shift-date
     1648             AND buf_shift-cash.shift-name = p-shift-name) :
     1649         if BUF_shift-cash.src-shift-name = p-shift-name
     1650         or BUF_shift-cash.shift-name = p-shift-name
     1651         then do:
     1652           IF buf_shift-cash.shift-date = p-chk-date
     1653           and BUF_shift-cash.shift-open-time = p-chk-time
     1654           and BUF_shift-cash.src-shift-name = p-shift-name
     1655           and p-z-number = ?
     1656           and buf_shift-cash.opened = 'прием-чек':U
     1657           then  do:
     1658             LEAVE _sc.
     1659           end.
     1660           IF BUF_shift-cash.shift-close-date = p-chk-date
     1661           and BUF_shift-cash.shift-close-time = p-chk-time
     1662           and (BUF_shift-cash.src-shift-name = p-shift-name
     1663               or
     1664               (BUF_shift-cash.shift-name = p-shift-name
     1665               and
     1666               buf_shift-cash.opened <> 'прием-чек':U)
     1667               or
     1668               (BUF_shift-cash.shift-name = p-shift-name
     1669               and
     1670               BUF_shift-cash.src-shift-name <> p-shift-name)
     1671             )
     1672           and (p-z-number <> ?
     1673               and
     1674               buf_shift-cash.status_ = 'зкр':U)
     1675           then  do:
     1676             LEAVE _sc.
     1677           end.
     1678           if buf_shift-cash.opened <> 'прием-чек':U
     1679           and buf_shift-cash.shift-num <> ? then do:
     1680             find first buf_shift-obj no-lock where
     1681                       buf_shift-obj.obj-type = v-obj-type
     1682                   AND buf_shift-obj.obj-code = v-obj-code
     1683                   AND buf_shift-obj.shift-date = buf_shift-cash.shift-date
     1684                   and buf_shift-obj.shift-num = buf_shift-cash.shift-num No-ERROR.
     1685             if available buf_shift-obj and
     1686             buf_shift-obj.status_ = 'факт':U then next _sc.
     1687           end.
     1688           leave _sc.
     1689         end.
     1690       end.
     1691        IF AVAIL buf_shift-cash
     1692        and buf_shift-cash.shift-num <> 0
     1693        and buf_shift-cash.shift-num <> ?
     1694        and buf_shift-cash.opened eq 'прием-чек':U
     1695        then
     1696        assign
     1697        current-cas-shift-num  = buf_shift-cash.shift-num
     1698        current-cas-shift-name = p-shift-name
     1699        current-cas-shift-date = buf_shift-cash.shift-date
     1700        current-cas-shift-status_ = buf_shift-cash.status_
     1701        .
     1702        else do:
     1703          run str/shftccr.p (
     1704                           input v-obj-type
     1705                          ,input v-obj-code
     1706                          ,input p-cash-num
     1707                          ,input p-shift-date
     1708                          ,input (if not v-shift-on then ? else p-shift-name)
     1709                          ,input p-shift-name
     1710                          ,input (if not v-shift-on then ? else integer(p-shift-name))
     1711                          ,input (if p-z-number <> ?
     1712                                  then p-shift-open-time
     1713                                  else (if p-chk-date = p-shift-date then p-chk-time else ?)
     1714                                  )
     1715                          ,input p-z-number
     1716                          ,input 'прием-чек':U
     1717                          ,output vrecid) no-error.
     1718          if error-status:error then do:
     1719            if valid-handle( v-p-log-handle) then do:
     1720              run write-log-and-file in v-p-log-handle (
     1721                    input 1
     1722                  , input log-file-name
     1723                  , input 1
     1724                  , input substitute( "!!!Произошла ошибка при попытке создания записи кассовой смены для кассы &1: смена N&2 за &3"
     1725                                      , p-cash-num
     1726                                      , p-shift-name
     1727                                      , string(p-shift-date, "99/99/9999")
     1728                                    )
     1729                                                    ).
     1730              v-view-log = yes.
     1731            end.
     1732          end.
     1733          else do:
     1734            FIND FIRST buf_shift-cash WHERE recid(buf_shift-cash) = vrecid.
     1735            assign
     1736            current-cas-shift-name = p-shift-name
     1737            current-cas-shift-num = buf_shift-cash.shift-num
     1738            current-cas-shift-date = p-shift-date
     1739            current-cas-shift-status_ = 'тек':U
     1740            .
     1741          end.
     1742        end.
     1743        if avail buf_shift-cash then do:
     1744          if v-shift-on then do:
     1745            if current-cas-shift-num  = ? then do:
     1746              run libchkvl_get-shift-num  in this-procedure (
     1747                                                     input  v-obj-type
     1748                                                    ,input  v-obj-code
     1749                                                    ,input  current-cas-shift-date
     1750                                                    ,input  current-cas-shift-name
     1751                                                    ,output current-cas-shift-num ) no-error .
     1752            end.
     1753            if current-cas-shift-num <> ? then do:
     1754              FIND FIRST buf_shift-obj NO-LOCK WHERE
     1755                          buf_shift-obj.obj-type = v-obj-type AND
     1756                          buf_shift-obj.obj-code = v-obj-code AND
     1757                          buf_shift-obj.shift-date = current-cas-shift-date AND
     1758                          buf_shift-obj.shift-num = current-cas-shift-num No-ERROR.
     1759            end.
     1760            else release buf_shift-obj.
     1761            if avail buf_shift-obj then
     1762            current-shift-status_ = buf_shift-obj.status_.
     1763            else
     1764            current-shift-status_ = 'тек':U.
     1765          end.
     1766          if p-z-number <> ?  then do:
     1767            assign
     1768            buf_shift-cash.status_ = 'зкр':U
     1769            buf_shift-cash.z-num = p-z-number
     1770            buf_shift-cash.closed = 'прием-чек':U
     1771            buf_shift-cash.shift-num = (if buf_shift-cash.shift-num = ?
     1772                                    and not can-find(first ub.shift-cash where
     1773                                                          ub.shift-cash.obj-type = buf_shift-cash.obj-type
     1774                                                      and  ub.shift-cash.obj-code = buf_shift-cash.obj-code
     1775                                                      and  ub.shift-cash.cash-num = current-cas-shift-num
     1776                                                      and  ub.shift-cash.shift-date = buf_shift-cash.shift-date
     1777                                                      and  ub.shift-cash.shift-num = buf_shift-cash.shift-num
     1778                                                      and  ub.shift-cash.src-shift-name = buf_shift-cash.src-shift-name
     1779                                                      and  recid(ub.shift-cash) <> recid(buf_shift-cash)
     1780                                                      )
     1781                                    then current-cas-shift-num
     1782                                    else buf_shift-cash.shift-num)
     1783            buf_shift-cash.shift-name = if buf_shift-cash.shift-num <> ?
     1784                                        then current-cas-shift-name
     1785                                        else buf_shift-cash.shift-name
     1786            buf_shift-cash.shift-open-time  = (if buf_shift-cash.shift-open-time > p-shift-open-time
     1787                                                then p-shift-open-time
     1788                                                else buf_shift-cash.shift-open-time)
     1789            buf_shift-cash.shift-close-date = (if buf_shift-cash.shift-close-date = ?
     1790                                                or buf_shift-cash.shift-close-date < p-chk-date
     1791                                                then p-chk-date
     1792                                                else buf_shift-cash.shift-close-date)
     1793            buf_shift-cash.shift-close-time = (if buf_shift-cash.shift-close-time = 0
     1794                                                or (buf_shift-cash.shift-close-date = p-chk-date
     1795                                                    and
     1796                                                    buf_shift-cash.shift-close-time < p-chk-time)
     1797                                                then p-chk-time
     1798                                                else buf_shift-cash.shift-close-time)
     1799            .
     1800          end.
     1801        end.
     1802     end.
     1803   end.
     1804   end procedure.
     1805   procedure libchkvl_chk-gds-wro :
     1806   define input parameter p-chk-type as integer no-undo .
     1807   define input parameter p-line-num as integer no-undo .
     1808   define input parameter p-src-qnty as decimal no-undo .
     1809   define input parameter p-wro-code as integer no-undo .
     1810   define output parameter p-valid as logical no-undo .
     1811   define output parameter p-mess as character no-undo .
     1812   main-block:
     1813   do
     1814   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1815   :
     1816     if (p-wro-code <> ?
     1817         and p-wro-code <> 0 )
     1818         or
     1819       p-chk-type = integer('96':U)
     1820       or
     1821       p-chk-type = integer('69':U)
     1822       then do:
     1823       if (lookup(string(p-chk-type), '1,69,14,15,16,36':U) > 0
     1824       and p-wro-code < 0)
     1825       or
     1826       (lookup(string(p-chk-type), '6,96':U) > 0
     1827       and p-wro-code > 0 and p-src-qnty <> 0)
     1828       or
     1829       (p-chk-type = integer('96':U)
     1830       and (p-wro-code = 0
     1831           or
     1832           p-wro-code = ?)
     1833         )
     1834       or
     1835       (p-chk-type = integer('69':U)
     1836       and (p-wro-code = 0
     1837           or
     1838           p-wro-code = ?)
     1839         )
     1840       then do:
     1841                 p-mess = substitute("&1В товарной строке №&2 тип списания &3 не соответствует типу чека&4 &1"
     1842                               , chr(10)
     1843                               , p-line-num
     1844                               , entry (lookup (string(if p-wro-code <> ? then p-wro-code else 0 ),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U)
     1845                               , entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     1846                             ).
     1847       end.
     1848       else do:
     1849         p-valid = yes.
     1850       end.
     1851     end.
     1852     else do:
     1853       p-valid = yes.
     1854     end.
     1855   end.
     1856   end procedure.
     1857   procedure libchkvl_unit-type-qnty :
     1858   define input parameter p-chk-type as integer no-undo .
     1859   define input parameter p-line-num as integer no-undo .
     1860   define input parameter p-unit-type as character no-undo .
     1861   define input parameter p-unit-cli-type as character no-undo .
     1862   define input parameter p-src-code as character no-undo .
     1863   define input parameter p-in-code as character no-undo .
     1864   define input parameter p-src-qnty as decimal no-undo .
     1865   define input parameter p-min-rate as decimal no-undo .
     1866   define input parameter p-max-rate as decimal no-undo .
     1867   define output parameter p-valid as logical no-undo .
     1868   define output parameter p-mess as character no-undo .
     1869   define output parameter p-chr-err as character no-undo .
     1870   main-block:
     1871   do
     1872   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1873   :
     1874     if LOOKUP( 'сер':U, p-unit-type ) > 0  AND abs(p-src-qnty) <> 1 then do:
     1875       p-mess = p-mess + chr(10) + substitute("Товар по коду &1 - серийный, кол-во должно быть=1", p-src-code).
     1876       p-chr-err = p-chr-err + chr(44) + 'сер-ош':U.
     1877     end.
     1878     if LOOKUP( 'сер':U, p-unit-type ) > 0
     1879     AND ( p-in-code = "" ) then do:
     1880       p-mess =  substitute("Товар по коду &1 нельзя продавать БЕЗ учета серийного номера"
     1881                           , p-src-code  ).
     1882       p-chr-err = p-chr-err + chr(44) + 'сер-ош':U.
     1883     end.
     1884     if (LOOKUP( 'сер':U, p-unit-type ) > 0
     1885     OR LOOKUP( '2ед':U, p-unit-type ) > 0 )
     1886     AND NOT libchkvl_direct-sign(p-chk-type, p-src-qnty)
     1887      then do:
     1888       p-mess =  substitute("Не может быть строки аннуляции или отмены для товара по коду &2 с типом единицы измерения &1"
     1889                           , p-unit-type
     1890                           ,p-src-code).
     1891       p-chr-err = p-chr-err + chr(44) + (if LOOKUP( 'сер':U, p-unit-type ) > 0
     1892                                                then 'сер-ош':U
     1893                                                else 'кол-ош':U).
     1894     end.
     1895     if lookup('2ед':U, p-unit-type) > 0  and (p-min-RATE = 0 or p-max-RATE = 0 )  then do:
     1896       p-mess = substitute("Товар по коду &1 в справочнике имеет неверные значения полей КОЛИЧЕСТВО ДРОБНОГО В ШТУКЕ"
     1897                            , p-src-code).
     1898       p-chr-err = p-chr-err + chr(44) + 'кол-ош':U.
     1899     end.
     1900     if (lookup('2ед':U, p-unit-type) > 0 AND (abs(p-src-qnty) < p-min-RATE or abs(p-src-qnty) > p-max-RATE)) OR
     1901         (lookup('доп':U, p-unit-type) > 0 AND NOT abs(p-src-qnty) = 1) then do:
     1902       p-mess =  substitute("Товар по коду &1 не может быть продан с несоответствием количеств по основной и дополнительной единицам измерения"
     1903                            , p-src-code ).
     1904       p-chr-err = p-chr-err + chr(44) + 'кол-ош':U.
     1905     end.
     1906     p-chr-err = trim(p-chr-err, chr(44)).
     1907     if p-chr-err = "" then
     1908     p-valid = yes.
     1909   end.
     1910   end procedure.
     1911   procedure libchkvl_part-valid :
     1912   define input parameter p-chk-type as integer no-undo .
     1913   define input parameter p-line-num as integer no-undo .
     1914   define input parameter p-unit-type as character no-undo .
     1915   define input parameter p-unit-cli-type as character no-undo .
     1916   define input parameter p-src-code as character no-undo .
     1917   define input parameter p-in-code as character no-undo .
     1918   define input parameter p-part-code as character no-undo .
     1919   define input parameter p-cashparts as logical no-undo .
     1920   define input parameter p-src-qnty as decimal no-undo .
     1921   define output parameter p-valid as logical no-undo .
     1922   define output parameter p-mess as character no-undo .
     1923   define output parameter p-chr-err as character no-undo .
     1924   main-block:
     1925   do
     1926   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1927   :
     1928     if LOOKUP('сер':U, p-unit-type) = 0 then do:
     1929       if p-cashparts and p-in-code = "" then do:
     1930         p-mess = substitute("Партионный товар по коду &1 не может быть продан БЕЗ учета N партии"
     1931                             , p-src-code).
     1932         p-chr-err = p-chr-err + chr(44) + 'прт-ош':U .
     1933       end.
     1934       if NOT p-cashparts AND NOT (p-in-code = "" AND p-part-code = "") then do:
     1935         p-mess = substitute("НЕПартионный товар по коду &1 не может быть продан по коду партии"
     1936                                 , p-src-code
     1937                               ) .
     1938         p-chr-err = p-chr-err + chr(44) + 'прт-ош':U.
     1939       end.
     1940     end.
     1941     if lookup(p-unit-type, 'шту':U) > 0
     1942     AND ( p-src-qnty - TRUNCATE( p-src-qnty , 0 ) <> 0) then do:
     1943        p-mess =substitute("Штучный товар по коду &1 не может быть продан с дробным количеством"
     1944                           , p-src-code
     1945                               ).
     1946       p-chr-err = p-chr-err + chr(44) + 'кол-ош':U.
     1947     end.
     1948     p-chr-err = trim(p-chr-err, chr(44)).
     1949     if p-chr-err = "" then
     1950     p-valid = yes.
     1951   end.
     1952   end procedure.
     1953   procedure libchkvl_prt-valid :
     1954   define input parameter p-chk-type as integer no-undo .
     1955   define input parameter p-line-num as integer no-undo .
     1956   define input parameter p-doc-prt as logical no-undo .
     1957   define input parameter p-src-code as character no-undo .
     1958   define input parameter p-empty-scale as logical no-undo .
     1959   define input parameter p-root-node-code as integer no-undo .
     1960   define input parameter p-node-code as integer no-undo .
     1961   define output parameter p-valid as logical no-undo .
     1962   define output parameter p-mess as character no-undo .
     1963   define output parameter p-chr-err as character no-undo .
     1964   main-block:
     1965   do
     1966   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1967   :
     1968     if p-doc-prt then do:
     1969       if not p-empty-scale
     1970       AND  can-find( first ub.gds-prt where ub.gds-prt.upper-code = p-node-code ) then do:
     1971         p-mess = substitute("Товар по коду &1 не может быт продан БЕЗ признаков"
     1972                            , p-src-code
     1973                               ).
     1974         p-chr-err = p-chr-err  + chr(44) + 'при-ош':U.
     1975       end.
     1976     end.
     1977     else do:
     1978       if p-root-node-code <> p-node-code then do:
     1979         p-mess = substitute("Товар по коду &1 не может быть продан c признаками на объекте, где они выключены"
     1980                             , p-src-code
     1981                               ) .
     1982         p-chr-err = p-chr-err + chr(44)  + 'при-ош':U.
     1983       end.
     1984     end.
     1985     p-chr-err = trim(p-chr-err, chr(44)).
     1986     if p-chr-err = "" then
     1987     p-valid = yes.
     1988   end.
     1989   end procedure.
     1990   procedure libchkvl_fbr-valid :
     1991   define input parameter p-chk-type as integer no-undo .
     1992   define input parameter p-line-num as integer no-undo .
     1993   define input parameter p-obj-type as character no-undo .
     1994   define input parameter p-obj-code as integer no-undo .
     1995   define input parameter p-is-catering as logical no-undo .
     1996   define input parameter p-pos-type as character no-undo .
     1997   define input parameter p-src-code as character no-undo .
     1998   define input parameter p-gds-code as integer no-undo .
     1999   define input parameter p-src-price as decimal no-undo .
     2000   define input parameter p-src-discnt as decimal no-undo .
     2001   define input parameter p-write-off-code as integer no-undo .
     2002   define input-output parameter p-depart-type as character no-undo .
     2003   define input-output parameter p-depart-code as integer no-undo .
     2004   define output parameter p-null-price as logical no-undo .
     2005   define output parameter p-valid as logical no-undo .
     2006   define output parameter p-mess as character no-undo .
     2007   define output parameter p-chr-err as character no-undo .
     2008   define variable v-depart-code as integer no-undo .
     2009   define variable v-depart-type as character no-undo .
     2010   define variable v-modificator-null-price as logical no-undo .
     2011   define buffer buf_shop for ub.shop.
     2012   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2013   main-block:
     2014   do
     2015   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2016   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2017   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2018   :
     2019     if p-is-catering
     2020     and (
     2021        p-pos-type = 'MAGIA-XML':U
     2022     or p-pos-type = 'IBM':U
     2023     or p-pos-type = 'IBM-XML':U
     2024     or p-pos-type = 'r-keeper':U
     2025     or p-pos-type = 'IBS-TH':U
     2026     or p-pos-type = 'NCR-AS@R':U
     2027     )
     2028     then do:
     2029       find first buf_fbr-gds-obj no-lock where
     2030                   buf_fbr-gds-obj.obj-type = p-obj-type
     2031               AND buf_fbr-gds-obj.obj-code = p-obj-code
     2032               AND buf_fbr-gds-obj.gds-code = p-gds-code no-error .
     2033       if p-depart-code > 0 then v-depart-code = p-depart-code.
     2034       else do:
     2035         if available buf_fbr-gds-obj
     2036         AND (buf_fbr-gds-obj.is-menu
     2037              or
     2038              buf_fbr-gds-obj.is-semi-finished)
     2039         then do:
     2040               assign
     2041               v-depart-code = buf_fbr-gds-obj.fbr-obj-code
     2042               v-depart-type = 'маг':U
     2043               .
     2044             if v-depart-code = ?
     2045             or v-depart-code = 0  then do:
     2046               p-mess = substitute("Произведенный товар по кодом &1 продан без ссылки  на ОБЪЕКТ  ПРОИЗВОДСТВА (кухню)"
     2047                                   , p-src-code
     2048                                     ) .
     2049               p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2050             end.
     2051         end.
     2052       end.
     2053       if available buf_fbr-gds-obj
     2054       and (buf_fbr-gds-obj.is-modificator
     2055           and
     2056           buf_fbr-gds-obj.is-null-price) then do:
     2057         assign
     2058         v-modificator-null-price = yes.
     2059       end.
     2060       else  do:
     2061         assign
     2062         v-modificator-null-price = no.
     2063       end.
     2064           if (lookup (STRING(if p-write-off-code <> ? then p-write-off-code else 0),  '2,-2,3,-3,-4':U) > 0) then do:
     2065         if not v-modificator-null-price then do:
     2066           p-mess = substitute("Указанный в чеке товар-модификатор по коду &1 с 0 ценой (&2) не имеет соответствующих признаков в атрибутах РЕСТОРАН &3&4"
     2067                               , p-src-code
     2068                               ,p-obj-type
     2069                               ,p-obj-code
     2070                                 ) .
     2071           p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2072         end.
     2073         if p-src-price <> 0
     2074         or p-src-discnt <> 0 then do:
     2075           p-mess = substitute("Указанный в чеке товар-модификатор по коду &1 с 0 ценой (&2) имеет в чеке НЕНУЛЕВУЮ ЦЕНУ &4 или СКИДКУ &5"
     2076                               , p-src-code
     2077                               ,p-obj-type
     2078                               ,p-obj-code
     2079                                 ) .
     2080           p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2081         end.
     2082       end.
     2083     end.
     2084     else do:
     2085       assign
     2086       v-depart-code = 0
     2087       v-depart-type = ''
     2088       .
     2089     end.
     2090     if v-depart-code <> ? and
     2091         v-depart-code <> 0
     2092     and v-depart-code <> p-obj-code    then do:
     2093       find first buf_shop no-lock where
     2094                 buf_shop.obj-code = v-depart-code no-error .
     2095       if not available buf_shop then do:
     2096         assign
     2097         v-depart-code = 0
     2098         p-mess = substitute("Не найдена кухня &1&2, произведшая товар  с кодом &3"
     2099                             ,'маг':U
     2100                             ,p-obj-code
     2101                             ,p-src-code
     2102                               ) .
     2103         p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2104       end.
     2105       else do:
     2106         assign
     2107         v-depart-code = (if v-depart-code = ? then 0 else v-depart-code)
     2108         v-depart-type = 'маг':U
     2109         .
     2110       end.
     2111     end.
     2112     if p-src-price = 0
     2113     and not (lookup (STRING(if p-write-off-code <> ? then p-write-off-code else 0),  '2,-2,3,-3,-4':U) > 0)
     2114     and not v-modificator-null-price
     2115     and not p-chk-type = integer('11':U)
     2116     and not p-pos-type = 'Autotank':U
     2117     and not p-pos-type = 'IBM-XML':U
     2118     and not p-pos-type = 'IBM':U
     2119     and not p-pos-type = 'MAGIA-XML':U
     2120     then do:
     2121       p-mess = substitute("Товар с кодом &1: цена = 0"
     2122                           ,p-src-code
     2123                             ) .
     2124       p-chr-err = p-chr-err + chr(44)  + 'сум-ош':U.
     2125     end.
     2126     assign
     2127     p-depart-code = v-depart-code
     2128     p-depart-type = v-depart-type
     2129     p-chr-err = trim(p-chr-err, chr(44)).
     2130     if p-chr-err = "" then
     2131     p-valid = yes.
     2132   end.
     2133   end procedure.
     2134   procedure libchkvl_place-valid :
     2135   define input parameter p-chk-type as integer no-undo .
     2136   define input parameter p-line-num as integer no-undo .
     2137   define input parameter p-obj-type as character no-undo .
     2138   define input parameter p-obj-code as integer no-undo .
     2139   define input parameter p-src-code as character no-undo .
     2140   define input parameter p-gds-code as integer no-undo .
     2141   define input parameter p-loc1 as character no-undo .
     2142   define input parameter p-src-pl-code as integer no-undo .
     2143   define output parameter p-pl-code as integer no-undo .
     2144   define output parameter p-valid as logical no-undo .
     2145   define output parameter p-mess as character no-undo .
     2146   define output parameter p-chr-err as character no-undo .
     2147   define variable v-loc1-setted as logical no-undo .
     2148   define variable v-src-pl-code-setted as logical no-undo .
     2149   define buffer buf_place for ub.place.
     2150   main-block:
     2151   do
     2152   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2153   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2154   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2155   :
     2156     assign
     2157     v-loc1-setted = p-loc1 <> '':U
     2158                     and
     2159                     p-loc1 <> ?
     2160     v-src-pl-code-setted = p-src-pl-code <> ?
     2161                             and
     2162                             p-src-pl-code <> 0
     2163     .
     2164     if v-loc1-setted
     2165     or v-src-pl-code-setted then do:
     2166       find first buf_place no-lock where
     2167                 buf_place.obj-type = p-obj-type
     2168             and buf_place.obj-code = p-obj-code
     2169             and (buf_place.loc1 = p-loc1 or not v-loc1-setted)
     2170             and (buf_place.pl-code = p-pl-code or not v-src-pl-code-setted)
     2171       no-error.
     2172       if not available buf_place then do:
     2173         p-mess = substitute("Товар с кодом &1: указано неверное складское место &2 или резервуар &3"
     2174                             ,p-src-code
     2175                             ,p-loc1
     2176                             ,p-src-pl-code
     2177                               ) .
     2178         p-chr-err = p-chr-err + chr(44)  + 'кол-ош':U.
     2179       end.
     2180       else do:
     2181          p-pl-code = buf_place.pl-code.
     2182       end.
     2183     end.
     2184     if p-chr-err = "" then
     2185     p-valid = yes.
     2186     end.
     2187   end procedure.
     2188   procedure libchkvl_petrol-valid :
     2189   define input parameter p-chk-type as integer no-undo .
     2190   define input parameter p-line-num as integer no-undo .
     2191   define input parameter p-obj-type as character no-undo .
     2192   define input parameter p-obj-code as integer no-undo .
     2193   define input parameter p-pos-type as character no-undo .
     2194   define input parameter p-src-code as character no-undo .
     2195   define input parameter p-gds-code as integer no-undo .
     2196   define input parameter p-unit-type as character no-undo .
     2197   define input parameter p-pump as integer no-undo .
     2198   define input parameter p-nozzle-code as integer no-undo .
     2199   define output parameter p-valid as logical no-undo .
     2200   define output parameter p-mess as character no-undo .
     2201   define output parameter p-chr-err as character no-undo .
     2202   main-block:
     2203   do
     2204   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2205   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2206   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2207   :
     2208     if lookup(string(p-chk-type), '14,15,16,17,36':U) > 0
     2209     and LOOKUP('топ':U, p-unit-type) = 0
     2210     then do:
     2211         p-mess = substitute("Чек типа &2, но товар с кодом &1 не топливный&2"
     2212                              , entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     2213                             ,p-src-code
     2214                               ) .
     2215         p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2216     end.
     2217     IF  p-pump > 0
     2218     and LOOKUP('топ':U, p-unit-type) = 0 then do:
     2219         p-mess = substitute("Номер ТРК > 0, но товар с кодом &1 не топливный&2"
     2220                             ,p-src-code
     2221                               ) .
     2222         p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2223     end.
     2224     IF p-pump = 0
     2225     and LOOKUP('топ':U, p-unit-type) > 0
     2226     AND LOOKUP('шту':U, p-unit-type) = 0 then do:
     2227       p-mess = substitute("Товар с кодом &1 топливо, но номер ТРК = 0"
     2228                           ,p-src-code
     2229                             ) .
     2230       p-chr-err = p-chr-err + chr(44)  + 'тов-ош':U.
     2231     end.
     2232     if p-chr-err = "" then
     2233     p-valid = yes.
     2234   end.
     2235   end procedure.
