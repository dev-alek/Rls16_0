     2532         and thbjattr_thbj-attr.obj-code = p-obj-code
     2533         and thbjattr_thbj-attr.upper-prop-code = 'get-chk':U
     2534     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2535     :
     2536       case thbjattr_thbj-attr.prop-code:
     2537         when 'cas-shft':U then do:
     2538           v-cas-shft = thbjattr_thbj-attr.property-value-logical.
     2539         end.
     2540         when 'cas-curs':U then do:
     2541           v-cas-curs = thbjattr_thbj-attr.property-value-logical.
     2542         end.
     2543         when 'hnum':U then do:
