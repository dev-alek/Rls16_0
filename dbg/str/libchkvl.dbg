     6600                                   then buf_chk-pay.tot-sum * buf_chk-doc.cash-rate
     6601                                   else buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     6602               buf_chk-pay.calc-rate = buf_chk-pay.tot-rubl /  buf_chk-pay.tot-sum
     6603               .
