     4494                 chk-gds.doc-code = chk-doc.doc-code,
     4495           first t-gds where
     4496                 t-gds.b-code = chk-gds.b-code and
     4497                 t-gds.drc = recid(chk-doc):
     4498         find first ub.bar-code where ub.bar-code.b-code = buf_chk-gds.b-code no-error.
