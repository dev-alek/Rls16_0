     5752                 buf_chk-doc.correct = no
     5753                 v-view-log = yes
     5754                 v-get-qnty-method =''
     5755                 .
     5756               end.
     5757             end.
     5758           end case.
     5759         end.
     5760       end.
     5761     end.
     5762     CASE ABS(buf_chk-pay.curr-code):
     5763       when 0 then do:
     5764         assign
     5765         buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum
     5766         buf_chk-pay.exch-date = buf_chk-doc.chk-date
     5767         buf_chk-pay.exch-time = buf_chk-doc.chk-time
     5768         buf_chk-pay.exch-rate = 1
     5769         buf_chk-pay.exch-scale = 1
     5770         buf_chk-pay.calc-rate = 1
     5771         .
     5772         if v-cas-curs and v-r-b = 'base':U then do:
     5773           assign
