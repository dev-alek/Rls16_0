     4672             var-gds-for-discnt = (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty
     4673             netto-for-tot-d-pcnt = netto-for-tot-d-pcnt + var-gds-for-discnt
     4674             buf_chk-gds.discnt = buf_chk-gds.discnt +  str-dec
