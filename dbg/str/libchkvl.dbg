     4593                             then (buf_chk-gds.price-base - buf_chk-gds.discnt)
     4594                             else (buf_chk-gds.price-base - buf_chk-gds.discnt) * (buf0_chk-discnt.discnt-value-abs / buf0_chk-discnt.object-sum - v-excsum)
     4595                             )
     4596                       else 0
     4597             v-discnt-sum = v-discnt-sum + str-dec * buf_chk-gds.doc-qnty
     4598             buf_chk-gds.discnt = buf_chk-gds.discnt + str-dec
     4599             t-gds.discnt-sum = t-gds.discnt-sum + buf_chk-gds.doc-qnty * str-dec
     4600             .
     4601             create buf_chk-discnt.
     4602             buffer-copy buf0_chk-discnt to buf_chk-discnt
     4603             assign
     4604             buf_chk-discnt.record-type = 1
     4605             buf_chk-discnt.object-line-num = buf_chk-gds.line-num
     4606             buf_chk-discnt.object-qnty = buf_chk-gds.doc-qnty
     4607             buf_chk-discnt.object-sum = var-gds-for-discnt
     4608             buf_chk-discnt.discnt-value-abs =  buf_chk-gds.doc-qnty * str-dec
     4609             buf_chk-discnt.discnt-value-pcnt = if buf_chk-discnt.object-sum <> 0
     4610                                               then (if buf0_chk-discnt.discnt-value-pcnt = 100
     4611                                                     and buf0_chk-discnt.value-type= integer('1':U)
     4612                                                     then 100
     4613                                                     else (buf_chk-discnt.discnt-value-abs / buf_chk-discnt.object-sum * 100)
     4614                                                     )
     4615                                               else 0
     4616             .
     4617           end.
     4618         if abs(v-discnt-sum - buf0_chk-discnt.DISCNT-VALUE-ABS) > 0.0000000001 then do:
     4619           if buf0_chk-discnt.discnt-value-pcnt = 100
     4620           and buf0_chk-discnt.value-type = integer('1':U) then do:
