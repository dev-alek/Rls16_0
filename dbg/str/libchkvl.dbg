     4569             find first ub.bar-code where ub.bar-code.b-code = buf_chk-gds.b-code no-error.
     4570             find first ub.dis-gds-rule where ub.dis-gds-rule.gds-code = ub.bar-code.gds-code and ub.dis-gds-rule.templ-rl-root = 55 no-error.
     4571             find first ub.clients where ub.clients.obj-type = v-obj-type and ub.clients.obj-code = v-obj-code no-error.
     4572             if can-find (first ub.dis-rule no-lock where ub.dis-rule.rule-num = ub.dis-gds-rule.rule-num and
     4573                                ((ub.dis-rule.host-code = 0 and ub.dis-rule.obj-code = 0 and ub.dis-rule.obj-type = "")
     4574                             or (ub.dis-rule.host-code = ub.clients.host-code and ub.dis-rule.obj-code = 0 and ub.dis-rule.obj-type = "")
     4575                             or (ub.dis-rule.obj-code = v-obj-code and ub.dis-rule.obj-type = v-obj-type))
     4576                           )
     4577             then do:
     4578               NEXT _buf_chk-gds.
     4579             end.
     4580             if buf0_chk-discnt.object-sum - v-excsum = 0
     4581             then do:
     4582               v-excsum = v-excsum - buf_chk-gds.doc-qnty.
     4583             end.
