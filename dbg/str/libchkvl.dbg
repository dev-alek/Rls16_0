     3856     end.
     3857       FIND FIRST buf_goods WHERE
     3858                buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     3859     FIND FIRST ub.gds-obj No-LOCK WHERE
     3860                ub.gds-obj.gds-code = buf_bar-code.gds-code AND
     3861                ub.gds-obj.obj-type =  buf_chk-doc.obj-type AND
     3862                ub.gds-obj.obj-code =   buf_chk-doc.obj-code NO-ERROR.
     3863     cashparts = IF AVAIL ub.gds-obj then ub.gds-obj.cash-parts else no.
     3864     FIND FIRST buf_units WHERE buf_units.unit-name = buf_goods.unit-base NO-LOCK .
     3865     if LOOKUP(buf_goods.gds-type, for-chk-type) = 0 then
     3866     do:
