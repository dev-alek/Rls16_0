     4500         find first ub.clients where ub.clients.obj-type = v-obj-type and ub.clients.obj-code = v-obj-code no-error.
     4501         if can-find (first ub.dis-rule no-lock where ub.dis-rule.rule-num = ub.dis-gds-rule.rule-num and
     4502                            ((ub.dis-rule.host-code = 0 and ub.dis-rule.obj-code = 0 and ub.dis-rule.obj-type = "")
     4503                         or (ub.dis-rule.host-code = ub.clients.host-code and ub.dis-rule.obj-code = 0 and ub.dis-rule.obj-type = "")
     4504                         or (ub.dis-rule.obj-code = v-obj-code and ub.dis-rule.obj-type = v-obj-type))
     4505                       )
     4506         then do:
     4507           v-excsum = chk-gds.src-sum + v-excsum.
