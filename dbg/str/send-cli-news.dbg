     3024   procedure alienini-getkey :
     3025   define input parameter i-filename as char.
     3026   define input parameter i-section as char.
     3027   define input parameter i-key as char.
     3028   define output parameter o-value as char.
     3029   define variable EntryPointer as integer no-undo.
     3030   define variable mem1 as memptr no-undo.
     3031   define variable mem2 as memptr no-undo.
     3032   define variable mem1size as integer no-undo.
     3033   define variable mem2size as integer no-undo.
     3034   define variable ii       as integer    no-undo.
     3035   define variable cbReturnSize  as integer    no-undo.
     3036   assign
     3037   set-size(mem1)  = 4000
     3038   mem1size = 4000.
     3039   if i-key = "" then EntryPointer = 0.
     3040   else do:
     3041     assign
     3042     set-size(mem2) = 128
     3043     mem2size = 128
     3044     EntryPointer = get-pointer-value(mem2)
     3045     put-string(mem2, 1) = i-key.
     3046   end.
     3047   run getprivateprofilestringA
     3048                                 (i-section,
     3049                                  EntryPointer,
     3050                                  "",
     3051                                  get-pointer-value(mem1),
     3052                                  input mem1size,
     3053                                  i-filename,
     3054                                  output cbReturnSize).
     3055   do ii = 1 to cbReturnSize:
     3056     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3057                  then o-value + ","
     3058                  else o-value + chr(get-byte(mem1, ii)).
     3059   end.
     3060     set-size(mem1) = 0.
     3061     set-size(mem2) = 0.
     3062   end procedure.
     3063   procedure alienini-putkey :
     3064   define input parameter i-filename as char.
     3065   define input parameter i-section as char.
     3066   define input parameter i-key as char.
     3067   define input parameter i-value as char.
     3068   define variable cbReturnSize as integer.
     3069   run writeprivateprofilestringA
     3070                                  (i-section,
     3071                                   i-key,
     3072                                   i-value,
     3073                                   i-filename,
     3074                                   output cbReturnSize ).
     3075   end procedure.
     3076   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3077     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3078     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3079     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3080     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3081     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3082     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3083     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3084   END PROCEDURE.
     3085   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3086     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3087     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3088     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3089     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3090     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3091   END PROCEDURE.
     3092   define   temp-table temp-tekka-tsk no-undo
     3093   field filename      as character
     3094   field obj-num       as integer
     3095   field obj-name      as character
     3096   field num-records   as integer
     3097   field max-records   as integer
     3098   field min-plu       as integer
     3099   field max-plu       as integer
     3100   field num-fields    as integer
     3101   field task-num      as character
     3102   field by-record     as logical
     3103   field send-get      as character
     3104   field cash-num      as integer
     3105   field cash-num-char as character
     3106   field port-num      as character
     3107   field way           as character
     3108   field is-script     as logical
     3109   field pswd          as character
     3110   field waiting-sek   as integer
     3111   field other-info    as character
     3112   field order-num     as integer
     3113   field secondary     as integer
     3114   field shift-fields  as integer
     3115   field binary        as logical
     3116   field range         as integer
     3117   index pi is unique primary
     3118   filename
     3119   range
     3120   index lpi
     3121   filename
     3122   min-plu
     3123   index gpi
     3124   filename
     3125   max-plu
     3126   index iorder
     3127   order-num
     3128   .
     3129   define   temp-table temp-tekka-schema no-undo
     3130   field obj-num as integer
     3131   field obj-name as character
     3132   field field-num as integer
     3133   field field-name as character
     3134   field num-records as integer
     3135   field size_ as integer
     3136   field host as character
     3137   field progress-type as character
     3138   field custom-type as character
     3139   field start-pos as integer
     3140   field end-pos as integer
     3141   field bin-group as character
     3142   index pi is unique primary
     3143   host obj-num field-num
     3144   .
     3145   define temp-table temp-tekka-record no-undo
     3146   field obj-num as integer
     3147   field plu as integer
     3148   field body as character
     3149   field shift as integer
     3150   index pi is unique primary obj-num plu.
     3151   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3152   define variable v-is-closed-shift-journal as integer no-undo .
     3153   assign
     3154   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3155                               +
     3156                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3157                               +
     3158                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3159   .
     3160   return v-is-closed-shift-journal.
     3161   END FUNCTION.
     3162   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3163   define variable v-is-first-journal as logical no-undo .
     3164   assign
     3165   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3166                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3167                     or (p-journal-num =  integer(entry(1, '17':U)))
     3168                     or (p-journal-num = integer(entry(1, '16':U)))
     3169   .
     3170   return v-is-first-journal.
     3171   END FUNCTION.
     3172   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3173   define variable v-is-petrol-journal as logical no-undo .
     3174   assign
     3175   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3176   return v-is-petrol-journal.
     3177   END FUNCTION.
     3178   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3179   define variable v-max-record-num as integer no-undo .
     3180   assign
     3181   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3182                       then 1489
     3183                       else 2340).
     3184   return v-max-record-num.
     3185   END FUNCTION.
     3186   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3187   define variable v-max-record-num as integer no-undo .
     3188   assign
     3189   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3190                       then 1489 * num-entries('30,31,32,33':U)
     3191                       else 2340 * num-entries('17':U)).
     3192   return v-max-record-num.
     3193   END FUNCTION.
     3194   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3195                                           ,input p-rec-no as integer):
     3196   define variable v-num-recs as integer no-undo .
     3197   if tekka-is-petrol-journal (p-journal-num) then do:
     3198     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3199       assign
     3200       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3201       .
     3202     end.
     3203     else do:
     3204       assign
     3205       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3206       .
     3207     end.
     3208   end.
     3209   else do:
     3210     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3211       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3212         assign
     3213         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3214         .
     3215       end.
     3216       else do:
     3217         assign
     3218         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3219         .
     3220       end.
     3221     end.
     3222     else do:
     3223       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3224         assign
     3225         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3226         .
     3227       end.
     3228       else do:
     3229         assign
     3230         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3231         .
     3232       end.
     3233     end.
     3234   end.
     3235   return v-num-recs.
     3236   END FUNCTION.
     3237   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3238                                              ,input p-is-petrol as logical
     3239                                              ,input p-is-current as logical
     3240                                              ,output p-rec-no as decimal
     3241                                              ):
     3242   define variable v-obj-num0 as integer no-undo .
     3243   define variable v-obj-num as integer no-undo .
     3244   define variable v-obj-num2 as integer no-undo .
     3245   define variable p-num-recs2 as integer no-undo .
     3246   define variable p-rec-no2 as integer no-undo .
     3247   if p-is-petrol then do:
     3248     assign
     3249     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3250     .
     3251     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3252     then
     3253     assign
     3254     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3255     p-rec-no = p-num-recs modulo 1489
     3256     .
     3257     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3258     then
     3259     assign
     3260     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3261     p-rec-no = p-num-recs modulo 1489
     3262     .
     3263   end.
     3264   else do:
     3265     assign
     3266     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3267     p-num-recs = trunc(p-num-recs, 0)
     3268     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3269     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3270     .
     3271     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3272     then
     3273     assign
     3274     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3275     p-rec-no = p-num-recs modulo 2340
     3276     .
     3277     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3278     then
     3279     assign
     3280     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3281     p-rec-no = p-num-recs modulo 2340
     3282     .
     3283     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3284     then
     3285     assign
     3286     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3287     p-rec-no2 = p-num-recs2 modulo 2978
     3288     .
     3289     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3290     then
     3291     assign
     3292     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3293     p-rec-no2 = p-num-recs2 modulo 2978
     3294     .
     3295     assign
     3296     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3297     .
     3298   end.
     3299   if v-obj-num = 0 then v-obj-num = 100.
     3300   return v-obj-num.
     3301   END FUNCTION.
     3302   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3303   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3304   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3305      if p-is-ptrl then
     3306      return integer(entry(1, '26,27,28,29':U)).
     3307      if not p-is-ptrl then
     3308      return integer(entry(1, '16':U)).
     3309   end.
     3310   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3311   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3312   return 0.
     3313   END FUNCTION.
     3314   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3315   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3316   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3317     if p-is-ptrl then
     3318     return integer(entry(1, '26,27,28,29':U)).
     3319     if not p-is-ptrl then
     3320     return integer(entry(1, '16':U)).
     3321   end.
     3322   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3323   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3324   return 0.
     3325   END FUNCTION.
     3326   PROCEDURE maria-put:
     3327   define parameter buffer buf_cash-desk for ub.cash-desk.
     3328   define input parameter p-out    as character no-undo .
     3329   define input parameter p-fname as character no-undo .
     3330   define input parameter p-by-record as logical no-undo .
     3331   define input parameter p-shift-fields as integer no-undo .
     3332   define input parameter p-binary as logical no-undo .
     3333   define input parameter p-obj-num as integer no-undo .
     3334   define input parameter p-max-records as integer no-undo .
     3335   define input parameter p-plu as integer no-undo .
     3336   define input parameter p-value as character no-undo .
     3337   define variable v-file-name as character no-undo .
     3338   define variable v-create as logical no-undo .
     3339   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3340   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3341   output stream IBMSTREAM
     3342   to value(v-file-name) append .
     3343   Put  stream IBMSTREAM unformatted
     3344   p-plu
     3345   chr(3)
     3346   p-value
     3347   skip.
     3348   output stream IBMSTREAM
     3349   close.
     3350   if not p-by-record then do:
     3351     find first buf_temp-tekka-tsk where
     3352               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3353     if not available buf_temp-tekka-tsk then do:
     3354       v-create = yes.
     3355     end.
     3356   end.
     3357   else do:
     3358     find first buf_temp-tekka-tsk where
     3359               buf_temp-tekka-tsk.filename  = v-file-name
     3360           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3361     if not available buf_temp-tekka-tsk
     3362     then do:
     3363       find first buf_temp-tekka-tsk where
     3364                 buf_temp-tekka-tsk.filename  = v-file-name
     3365             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3366       if not available buf_temp-tekka-tsk
     3367       then do:
     3368         v-create = yes.
     3369       end.
     3370     end.
     3371   end.
     3372   if v-create then do:
     3373     create buf_temp-tekka-tsk.
     3374     assign
     3375     buf_temp-tekka-tsk.filename = v-file-name
     3376     buf_temp-tekka-tsk.range    = p-plu
     3377     buf_temp-tekka-tsk.obj-num = p-obj-num
     3378     buf_temp-tekka-tsk.obj-name = '':U
     3379     buf_temp-tekka-tsk.num-records = 0
     3380     buf_temp-tekka-tsk.max-records = p-max-records
     3381     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3382     buf_temp-tekka-tsk.task-num = p-fname
     3383     buf_temp-tekka-tsk.by-record = p-by-record
     3384     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3385     buf_temp-tekka-tsk.binary = p-binary
     3386     buf_temp-tekka-tsk.send-get = 'send'
     3387     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3388     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3389     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3390     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3391                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3392                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3393                                 then 'local'
     3394                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3395     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3396     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3397     buf_temp-tekka-tsk.waiting-sek = 30
     3398     buf_temp-tekka-tsk.min-plu     = p-plu
     3399     buf_temp-tekka-tsk.max-plu     = p-plu
     3400     .
     3401   end.
     3402   assign
     3403   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3404   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3405   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3406   .
     3407   END PROCEDURE.
     3408   PROCEDURE maria-get:
     3409   define parameter buffer buf_cash-desk for ub.cash-desk.
     3410   define input parameter p-out    as character no-undo .
     3411   define input parameter p-fname as character no-undo .
     3412   define input parameter p-by-record as logical no-undo .
     3413   define input parameter p-obj-num as integer no-undo .
     3414   define input parameter p-num-fields as integer no-undo .
     3415   define input parameter p-max-records as integer no-undo .
     3416   define input parameter p-min-plu as integer no-undo .
     3417   define input parameter p-max-plu as integer no-undo .
     3418   define input parameter p-other as character no-undo .
     3419   define input parameter p-order-num as integer no-undo .
     3420   define variable v-file-name as character no-undo .
     3421   define variable v-secondary-obj-num as character no-undo .
     3422   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3423   if p-by-record then do:
     3424     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3425   end.
     3426   else do:
     3427     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3428   end.
     3429   find first buf_temp-tekka-tsk where
     3430             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3431   if not available buf_temp-tekka-tsk then do:
     3432     create buf_temp-tekka-tsk.
     3433     assign
     3434     buf_temp-tekka-tsk.filename = v-file-name
     3435     buf_temp-tekka-tsk.obj-num = p-obj-num
     3436     buf_temp-tekka-tsk.obj-name = '':U
     3437     buf_temp-tekka-tsk.max-records = p-max-records
     3438     buf_temp-tekka-tsk.num-fields = p-num-fields
     3439     buf_temp-tekka-tsk.task-num = p-fname
     3440     buf_temp-tekka-tsk.by-record = p-by-record
     3441     buf_temp-tekka-tsk.send-get = 'get'
     3442     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3443     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3444     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3445     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3446                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3447                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3448                                   then 'local'
     3449                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3450     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3451     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3452     buf_temp-tekka-tsk.waiting-sek = 30
     3453     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3454     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3455     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3456                                       and p-max-plu <> ?
     3457                                       then p-max-plu - p-min-plu + 1
     3458                                       else 0)
     3459     buf_temp-tekka-tsk.other-info = p-other
     3460     buf_temp-tekka-tsk.order-num = p-order-num
     3461     .
     3462     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3463       assign
     3464       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3465       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3466       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3467       no-error
     3468       .
     3469       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3470     end.
     3471   end.
     3472   END PROCEDURE.
     3473   PROCEDURE maria-task:
     3474   define parameter buffer buf_cash-desk for ub.cash-desk.
     3475   define input parameter p-fname as character no-undo .
     3476   define input parameter p-obj-num-list as character no-undo .
     3477   define input parameter p-parameters as character no-undo .
     3478   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3479   find first buf_temp-tekka-tsk where
     3480             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3481   if not available buf_temp-tekka-tsk then do:
     3482     create buf_temp-tekka-tsk.
     3483     assign
     3484     buf_temp-tekka-tsk.filename = ''
     3485     buf_temp-tekka-tsk.range = 1
     3486     buf_temp-tekka-tsk.obj-num = 0
     3487     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3488     buf_temp-tekka-tsk.task-num = p-fname
     3489     buf_temp-tekka-tsk.by-record = no
     3490     buf_temp-tekka-tsk.send-get = 'task'
     3491     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3492     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3493     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3494     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3495                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3496                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3497                                   then 'local'
     3498                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3499     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3500     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3501     buf_temp-tekka-tsk.waiting-sek = 30
     3502     buf_temp-tekka-tsk.other-info = p-parameters
     3503     buf_temp-tekka-tsk.order-num = 0
     3504     .
     3505   end.
     3506   END PROCEDURE.
     3507   procedure tekkatsk-verify-schema :
     3508   define input parameter p-obj-list as character no-undo .
     3509   define input parameter p-dir-path as character no-undo .
     3510   define variable v-obj-num as integer no-undo .
     3511   define variable v-obj-name as character no-undo .
     3512   define variable v-num-records as integer no-undo .
     3513   define variable v-size_ as integer no-undo .
     3514   define variable v-value as character no-undo .
     3515   define variable ii as integer no-undo .
     3516   define variable jj as integer no-undo .
     3517   define variable ii-ibs as integer no-undo .
     3518   define variable ii-tekka as integer no-undo .
     3519   define variable v-result as character no-undo .
     3520   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3521   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3522     do
     3523     on error undo, return error
     3524     :
     3525        for each buf_temp-tekka-schema:
     3526          delete buf_temp-tekka-schema.
     3527        end.
     3528        input from value('tekkasch.d').
     3529        repeat :
     3530          create buf_temp-tekka-schema.
     3531          import buf_temp-tekka-schema.
     3532          assign
     3533          buf_temp-tekka-schema.host = 'IBS'
     3534          ii = ii + 1.
     3535          .
     3536        end.
     3537        input close.
     3538        ii-ibs = ii.
     3539         _ii:
     3540         do ii = 1 to 256:
     3541           if p-obj-list = "ALL"
     3542           or lookup(string(ii), p-obj-list) > 0 then do:
     3543             assign
     3544             v-obj-num = 0
     3545             v-obj-name = ''
     3546             v-num-records = 0
     3547             v-size_ = 0
     3548             .
     3549             run alienini-getkey in this-procedure (
     3550                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3551                                                     ,input ('obj' + string(ii, '999'))
     3552                                                     ,input 'oname'
     3553                                                     ,output v-value) no-error .
     3554             if v-value = ? then next _ii.
     3555             assign
     3556             v-obj-num = ii
     3557             v-obj-name = v-value
     3558             .
     3559             run alienini-getkey in this-procedure (
     3560                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3561                                                     ,input ('obj' + string(ii, '999'))
     3562                                                     ,input 'size'
     3563                                                     ,output v-value) no-error .
     3564             assign
     3565             v-num-records = integer(v-value) no-error  .
     3566             if error-status:error
     3567             or v-num-records = 0 then next _ii.
     3568             run alienini-getkey in this-procedure (
     3569                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3570                                                     ,input 'obj' + string(ii, '999')
     3571                                                     ,input 'f000'
     3572                                                     ,output v-value) no-error .
     3573             assign
     3574             v-size_ = integer(v-value) no-error  .
     3575             if error-status:error
     3576             or v-size_ = 0 then next _ii.
     3577             _jj:
     3578             do jj = 1 to 256:
     3579               run alienini-getkey in this-procedure (
     3580                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3581                                                       ,input 'obj' + string(ii, '999')
     3582                                                       ,input 'f' + string(jj, '999')
     3583                                                       ,output v-value) no-error .
     3584               if v-value = ? then next _ii.
     3585               create buf_temp-tekka-schema.
     3586               assign
     3587               buf_temp-tekka-schema.host = 'tekka'
     3588               buf_temp-tekka-schema.obj-num = v-obj-num
     3589               buf_temp-tekka-schema.obj-name = v-obj-name
     3590               buf_temp-tekka-schema.num-records = v-num-records
     3591               buf_temp-tekka-schema.size_ = v-size_
     3592               buf_temp-tekka-schema.field-num = jj
     3593               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3594               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3595                                                  then entry(2, entry(2, v-value, '#'), ':')
     3596                                                  else '':U)
     3597               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3598               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3599               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3600                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3601               no-error
     3602               .
     3603               if error-status:error then do:
     3604                 delete buf_temp-tekka-schema.
     3605                 next _jj.
     3606               end.
     3607               run alienini-getkey in this-procedure (
     3608                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3609                                                       ,input 'obj' + string(ii, '999') + 'name'
     3610                                                       ,input 'n' + string(jj, '999')
     3611                                                       ,output v-value) no-error .
     3612               if v-value <> ? then
     3613               buf_temp-tekka-schema.field-name = v-value.
     3614             end.
     3615           end.
     3616         end.
     3617         ii-tekka = ii - 1.
     3618        if p-obj-list <> 'ALL' then do:
     3619         if ii-tekka <> ii-ibs then do:
     3620           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3621                                   , ii-ibs
     3622                                   , ii-tekka).
     3623         end.
     3624        end.
     3625        for each buf_temp-tekka-schema where
     3626               buf_temp-tekka-schema.host = 'tekka':
     3627          find first buf2_temp-tekka-schema where
     3628                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3629                AND buf2_temp-tekka-schema.host = 'ibs'
     3630                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3631          if not available buf2_temp-tekka-schema then do:
     3632           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3633                                   , buf_temp-tekka-schema.field-num
     3634                                   , buf_temp-tekka-schema.obj-num).
     3635          end.
     3636          buffer-compare buf_temp-tekka-schema
     3637          to buf2_temp-tekka-schema
     3638          save result in v-result.
     3639          if v-result <> '':U then do:
     3640           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3641                                   , buf_temp-tekka-schema.field-num
     3642                                   , buf_temp-tekka-schema.obj-num).
     3643          end.
     3644        end.
     3645     end.
     3646   end procedure.
     3647   FUNCTION set-Sx returns character (input p-string as character):
     3648   return p-string.
     3649   END FUNCTION.
     3650   FUNCTION get-Sx returns character (input p-string  as character):
     3651   return p-string.
     3652   END FUNCTION.
     3653   FUNCTION set-B returns character (input p-string  as character):
     3654   return chr(integer(p-string)).
     3655   END FUNCTION.
     3656   FUNCTION get-B returns character (input p-string  as character):
     3657   return string(asc(p-string)).
     3658   END FUNCTION.
     3659   FUNCTION set-BF returns character (input p-string  as character):
     3660   define variable v-dopi as integer no-undo .
     3661   define variable ii as integer no-undo .
     3662   do ii = 1 to 8:
     3663     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3664   end.
     3665   return chr(v-dopi).
     3666   END FUNCTION.
     3667   FUNCTION get-BF returns character (input p-string  as character):
     3668   define variable v-dopi as integer no-undo .
     3669   define variable v-dops as character no-undo .
     3670   define variable ii as integer no-undo .
     3671   v-dopi = asc(p-string).
     3672   do ii = 8 to 1 BY -1:
     3673     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3674   end.
     3675   return v-dops.
     3676   END FUNCTION.
     3677   FUNCTION set-BN returns character (input p-string  as character
     3678                                     ,input p-bin-group as character):
     3679   define variable v-dopi as integer no-undo .
     3680   define variable ii as integer no-undo .
     3681   define variable jj as integer no-undo .
     3682   define variable v-grp-nums as integer no-undo .
     3683   define variable v-dopi2 as integer no-undo .
     3684   v-grp-nums = num-entries(p-bin-group).
     3685   do jj = 0 to v-grp-nums - 1:
     3686     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3687     do ii = 1 to 8:
     3688       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3689     end.
     3690   end.
     3691   return chr(v-dopi).
     3692   END FUNCTION.
     3693   FUNCTION get-BN returns character (input p-string  as character
     3694                                     ,input p-bin-group as character):
     3695   define variable v-dopi as integer no-undo .
     3696   define variable v-dops as character no-undo .
     3697   define variable v-grp-nums as integer no-undo .
     3698   define variable ii as integer no-undo .
     3699   define variable jj as integer no-undo .
     3700   v-dopi = asc(p-string).
     3701   v-grp-nums = num-entries(p-bin-group).
     3702   do jj = 1 to v-grp-nums:
     3703   do ii = 8 to 1 BY -1:
     3704     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3705   end.
     3706   end.
     3707   return v-dops.
     3708   END FUNCTION.
     3709   procedure fill-temp-cd :
     3710   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3711   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3712   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3713   define input parameter p-clear-table as logical no-undo .
     3714   define buffer buf_temp-cd for temp-cd.
     3715   define buffer buf_cash-desk for ub.cash-desk.
     3716     do
     3717     on error undo, return error
     3718     :
     3719        if p-clear-table  then do:
     3720          for each buf_temp-cd:
     3721            delete buf_temp-cd.
     3722          end.
     3723        end.
     3724        for each buf_cash-desk no-lock where
     3725               buf_cash-desk.db-num = p-db-num
     3726           AND buf_cash-desk.obj-code = p-obj-code
     3727           and buf_cash-desk.cash-on  = yes
     3728        BREAK by buf_cash-desk.pos-type:
     3729          if first-of(buf_cash-desk.pos-type) then do:
     3730            create buf_temp-cd.
     3731            buffer-copy buf_cash-desk to buf_temp-cd.
     3732          end.
     3733        end.
     3734     end.
     3735   end procedure.
     3736   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3737   function windows-date-format returns character ( input p-date  as date, input p-format as character ):
     3738   define variable v-string-date as character no-undo .
     3739   CASE p-format:
     3740     when "dd.mm.yyyy":U
     3741     or
     3742     when "dd.mm.yy":U
     3743     or
     3744     when "dd/mm/yy":U
     3745     then do:
     3746       assign
     3747       p-format = replace(p-format, "dd", "99")
     3748       p-format = replace(p-format, "mm", "99")
     3749       p-format = replace(p-format, "yy", "99")
     3750       v-string-date = string(p-date, p-format)
     3751       .
     3752     end.
     3753     when "d.m.yy":U then do:
     3754       ASSIGN
     3755       v-string-date = string(day(p-date), ">9") + string(month(p-date), ">9") +
     3756                       substring(string(p-date, "99/99/99"), 7, 2)
     3757       .
     3758     end.
     3759     when "yyyy-mm-dd":U then do:
     3760       ASSIGN
     3761       v-string-date = string(year(p-date), "9999") + "-":U + string(month(p-date), "99") + string(day(p-date), "99")
     3762       .
     3763     end.
     3764   END CASE.
     3765   return v-string-date.
     3766   END FUNCTION.
     3767   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3768   define new global shared variable g#attr-lib  as handle no-undo .
     3769   define variable v-attr-lib-variable as handle no-undo .
     3770   procedure clntattr-code :
     3771     define input  parameter p-code           as character no-undo .
     3772     define output parameter p-type           as character no-undo .
     3773     define output parameter p-format         as character no-undo .
     3774     define output parameter p-label          as character no-undo .
     3775     define output parameter p-user-can-edit  as logical   no-undo .
     3776     define output parameter p-output-display as logical   no-undo .
     3777     define output parameter p-other          as character no-undo .
     3778     do
     3779     on error undo, return error return-value
     3780     :
     3781           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     3782         (input  p-code
     3783         ,output p-type
     3784         ,output p-format
     3785         ,output p-label
     3786         ,output p-user-can-edit
     3787         ,output p-output-display
     3788         ,output p-other
     3789         ) no-error .
     3790       if error-status :error
     3791       then do:
     3792         undo, return error return-value .
     3793       end.
     3794     end.
     3795   end procedure.
     3796   procedure clntattr-tooltip :
     3797     define input  parameter p-code    as character no-undo .
     3798     define output parameter p-tooltip as character no-undo .
     3799     define output parameter p-label   as character no-undo .
     3800     do
     3801     on error undo, return error return-value
     3802     :
     3803           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
     3804         (input  p-code
     3805         ,output p-tooltip
     3806         ,output p-label
     3807         ) no-error .
     3808       if error-status :error
     3809       then do:
     3810         undo, return error return-value .
     3811       end.
     3812     end.
