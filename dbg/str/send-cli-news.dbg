     6176                 FIRST for-clients No-LOCK WHERE
     6177                       for-clients.obj-type = 'маг':U
     6178                   AND for-clients.obj-code = for-shop.obj-code
     6179                   AND for-clients.db-num = g#db-num:
     6180               FIND ub.sysconf WHERE
     6181                   ub.sysconf.host-code = ub.shop.host-code NO-LOCK.
     6182               assign
     6183               i-obj-code = for-shop.obj-code
     6184               .
     6185               RUN SENDING in this-procedure no-error.
     6186               if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6187             END.
     6188           end.
     6189           else
     6190           RUN SENDING in this-procedure no-error.
     6191           if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6192         end.
     6193         assign
     6194         start-paket = yes
     6195         cr = 0
     6196         ii = 0
     6197         .
     6198       end.
     6199     END.
     6200   end.
     6201   if (cr > 0 AND (g#news
     6202                   or g#esys
     6203                   or run-from = "S":U
     6204                   or run-from = "O":U
     6205                   or run-from = "E":U
     6206                   )
     6207      )
     6208   or
     6209      (NOT (g#news
     6210            or g#esys
     6211            OR run-from = "S"
     6212            or run-from = "O":U
     6213            or run-from = "E":U)
     6214            AND can-find(first cash-cli)
     6215       ) then do:
