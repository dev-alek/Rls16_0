     6218               FIRST for-clients No-LOCK WHERE
     6219                     for-clients.obj-type = 'маг':U AND
     6220                     for-clients.obj-code = for-shop.obj-code AND
     6221                     for-clients.db-num = g#db-num,
     6222         first buf_cash-desk no-lock where
     6223              buf_cash-desk.db-num = g#db-num
     6224          AND buf_cash-desk.obj-code = for-clients.obj-code
     6225          AND buf_cash-desk.cash-on = yes   :
     6226         FIND ub.sysconf WHERE
     6227             ub.sysconf.host-code = ub.shop.host-code NO-LOCK.
     6228         assign
     6229         i-obj-code = for-shop.obj-code
     6230         .
     6231         run write-log-and-file in p-log-handle (
     6232               input 1
     6233             , input log-file-name
     6234             , input 1
     6235             , input substitute("Пересылка на кассы &1&2 информации о дисконтных картах", 'маг':U, i-obj-code)
     6236                                                   ).
     6237         RUN SENDING in this-procedure no-error.
     6238         if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6239       END.
     6240     end.
     6241     else do:
     6242       run write-log-and-file in p-log-handle (
     6243                 input 1
     6244               , input log-file-name
     6245               , input 1
     6246               , input substitute("Пересылка на кассы &1&2 информации о дисконтных картах", 'маг':U, i-obj-code)
     6247                                                     ).
     6248       RUN SENDING in this-procedure no-error.
     6249       if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6250     end.
     6251   end.
     6252   for each cash-cli:
     6253       delete cash-cli.
     6254   end.
     6255   if p-batch then do:
     6256     if v-view-log then
     6257     run set-view-log in p-log-handle(yes).
     6258   end.
     6259   else do:
     6260   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6261   if v-view-log
     6262   and not g#news
     6263   and not g#auto
     6264   then do:
     6265     message
     6266     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     6267     "!!!Внимательно прочитайте Log-file!!"
     6268     view-as alert-box error .
     6269        define variable v-user-action40   as character no-undo .
     6270     define variable v-printed40       as logical   no-undo .
     6271     run gbl/prnfilen.w
     6272       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     6273       ,input  0
     6274       ,input  (string("./":U) + log-file-name)
     6275       ,input  7
     6276       ,output v-user-action40
     6277       ,output v-printed40
     6278       ) .
     6279   end.
     6280   if v-view-log = true
     6281   and (g#news
     6282   or g#auto)
     6283   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     6284   then do:
     6285      run cb_set-view-log in p-parent-handle ( input yes).
     6286   end.
     6287   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     6288     OS-DELETE value(string("./":U) + log-file-name).
     6289   end.
     6290   end.
     6291   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6292   PROCEDURE putc-2.
     6293   define parameter buffer buf_cash-desk for ub.cash-desk.
     6294   define input parameter pos-type   as character no-undo.
