      221   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      223   define variable v-disprop-menu-section-num as integer no-undo .
      224   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      226   procedure gen-key-rec :
      227     define input  parameter p-tbl-name    as character no-undo.
      228     define input  parameter p-bh_tbl-name as handle    no-undo.
      229     define output parameter p-key-rec     as character no-undo.
      230     do
      231     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      232     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      233     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      234     :
      235       define variable fh               as handle    no-undo .
      236       define variable v-ok             as logical   no-undo .
      237       define variable v-inform         as character no-undo .
      238       define variable v-ind            as integer   no-undo .
      239       define variable v-idx-field-qnty as integer   no-undo .
      240       if p-tbl-name = ?
      241         or p-tbl-name = "":U
      242       then do:
      243         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      244       end.
      245       if not p-bh_tbl-name:available then do:
      246         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      247       end.
      248       assign
      249         p-key-rec = p-tbl-name
      250         v-inform  = p-bh_tbl-name:index-information(1)
      251         v-ind     = 2
      252       .
      253       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      254       on error undo, return error
      255       :
      256         assign
      257           v-inform = p-bh_tbl-name:index-information( v-ind )
      258           v-ind    = v-ind + 1
      259         .
      260       end.
      261       if v-inform = ?
      262         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      263         or entry( 3, v-inform, ",":U ) <> "1":U
      264       then do:
      265         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      266       end.
      267       else do:
      268         assign
      269           v-idx-field-qnty = num-entries( v-inform ) - 4
      270         .
      271         if v-idx-field-qnty < 2 then do:
      272           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      273         end.
      274         do v-ind = 1 to v-idx-field-qnty by 2
      275         on error undo, return error
      276         :
      277           assign
      278             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      279             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      280           .
      281         end.
      282       end.
      283       if p-key-rec = ? then do:
      284         assign
      285           p-key-rec = "":U
      286         .
      287         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      288       end.
      289     end.
      290     return.
      291   end procedure.
      292   procedure gen-where-keyr-tab :
      293     define input  parameter i-tableSerach as character no-undo.
      294     define input  parameter i-tablekey   as character  no-undo.
      295     define input  parameter p-key-rec    as character  no-undo.
      296     define input  parameter p-key-handle as handle     no-undo .
      297     define input  parameter p-db-name    as character  no-undo .
      298     define input  parameter p-tt-handle  as handle     no-undo .
      299     define output parameter o-Where      as character  no-undo.
      300     do
      301     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      302     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      303     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      304     :
      305       define variable v-full-tbl-name  as character no-undo .
      306       define variable bh_tbl-name      as handle    no-undo .
      307       define variable fh_key           as handle    no-undo .
      308       define variable fh_search        as handle    no-undo .
      309       define variable v-field-num      as integer   no-undo .
      310       define variable v-count-fld      as integer   no-undo .
      311       define variable v-inform         as character no-undo .
      312       define variable v-ind            as integer   no-undo .
      313       define variable v-idx-field-qnty as integer   no-undo .
      314       define variable v-field-name     as character no-undo .
      315       define variable v-field-val      as character no-undo .
      316       define variable v-word-link      as character no-undo .
      317       define variable vTable           as character no-undo.
      318       define variable bh_tbl-key       as handle    no-undo .
      319       assign
      320         p-key-rec = trim( p-key-rec )
      321       .
      322       if p-key-handle <> ? then do:
      323         if not valid-handle(p-key-handle)
      324            or p-key-handle:type <> "buffer"
      325         then do:
      326           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      327         end.
      328         if num-entries( p-key-rec, chr(3) ) > 1
      329           or p-key-rec = ?
      330           or p-key-rec = "":U
      331         then do:
      332           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      333         end.
      334       end.
      335       else do:
      336         if p-key-rec = ?
      337           or p-key-rec = "":U
      338         then do:
      339           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      340         end.
      341       end.
      342       assign
      343         vTable = entry( 1 , p-key-rec, chr(3) )
      344       .
      345       if p-tt-handle <> ?
      346         and ( not valid-handle(p-tt-handle)
      347               or p-tt-handle:type <> "buffer"
      348             )
      349       then do:
      350         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      351       end.
      352       if p-tt-handle = ? then do:
      353         assign
      354           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      355         .
      356         create buffer bh_tbl-name for table v-full-tbl-name .
      357       end.
      358       else do:
      359         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      360       end.
      361       assign
      362         v-inform = bh_tbl-name:index-information(1)
      363         v-ind    = 2
      364       .
      365       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      366       on error undo, return error
      367       :
      368         assign
      369           v-inform = bh_tbl-name:index-information( v-ind )
      370           v-ind    = v-ind + 1
      371         .
      372       end.
      373       if v-inform = ?
      374         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      375         or entry( 3, v-inform, ",":U ) <> "1":U
      376       then do:
      377         delete object bh_tbl-name no-error.
      378         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      379       end.
      380       assign
      381         v-idx-field-qnty = num-entries( v-inform ) - 4
      382       .
      383       if v-idx-field-qnty < 2 then do:
      384         delete object bh_tbl-name no-error.
      385         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      386       end.
      387       assign
      388         o-where     = "where":U
      389         v-word-link = "":U
      390         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      391         v-count-fld = 0
      392       .
      393       if i-tablekey ne "" and i-tablekey ne ?
      394       then do:
      395         assign
      396           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      397         .
      398         create buffer bh_tbl-key for table v-full-tbl-name .
      399       end.
      400       if i-tableSerach ne "" and i-tableSerach ne ?
      401       then do:
      402         delete object bh_tbl-name no-error.
      403         assign
      404           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      405         .
      406         create buffer bh_tbl-name for table v-full-tbl-name .
      407       end.
      408       block_where:
      409       do v-ind = 1 to v-idx-field-qnty by 2
      410       on error undo, return error
      411       :
      412         assign
      413           v-count-fld = v-count-fld + 1
      414         .
      415         if p-key-handle = ?
      416           and v-count-fld > v-field-num
      417         then do:
      418           leave block_where.
      419         end.
      420         define variable VfieldKeyTable as handle no-undo.
      421         assign
      422           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      423           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      424         .
      425         if     bh_tbl-key ne ?
      426         then do:
      427            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      428            if VfieldKeyTable eq ?
      429            then next block_where.
      430         end.
      431         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      432         then
      433            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      434         else
      435            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      436         if p-key-handle = ? then do:
      437           assign
      438             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      439           .
      440         end.
      441         else do:
      442           assign
      443             fh_key = p-key-handle:buffer-field( v-field-name )
      444           .
      445           if fh_key = ?
      446             or not valid-handle( fh_key )
      447           then do:
      448             delete object bh_tbl-name.
      449             if     bh_tbl-key ne ?
      450             then
      451                delete object bh_tbl-key.
      452             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      453           end.
      454           assign
      455             v-field-val = fh_key:buffer-value
      456           .
      457         end.
      458         if fh_search:data-type ="character":U then do:
      459           assign
      460             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      461             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      462             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      463             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      464             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      465             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      466             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      467             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      468             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      469             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      470             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      471             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      472             v-field-val = substitute( '"&1"', v-field-val )
      473           .
      474         end.
      475         assign
      476           o-where = substitute( "&1 &2", o-where, v-field-val )
      477         .
      478         if v-word-link = "":U then do:
      479           assign
      480             v-word-link = "and":U
      481           .
      482         end.
      483       end.
      484       delete object bh_tbl-name.
      485       if     bh_tbl-key ne ?
      486       then
      487          delete object bh_tbl-key.
      488       if p-key-handle = ?
      489         and v-count-fld <> v-field-num
      490       then do:
      491         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      492       end.
      493     end.
      494   end procedure.
      495   procedure gen-hn-keyr-tab :
      496     define input  parameter i-tableSerach as character no-undo.
      497     define input  parameter i-tablekey   as character no-undo.
      498     define input  parameter p-key-rec    as character no-undo.
      499     define input  parameter p-key-handle as handle    no-undo .
      500     define input  parameter p-db-name    as character no-undo .
      501     define input  parameter p-tt-handle  as handle    no-undo .
      502     define input  parameter p-stts-lock  as integer   no-undo .
      503     define output parameter o-hn         as handle    no-undo.
      504     define variable v-full-tbl-name as character no-undo.
      505     define variable v-where         as character no-undo.
      506     define variable bh_tbl-name     as handle    no-undo.
      507     define variable vTable          as character no-undo.
      508     do
      509     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      512         run gen-where-keyr-tab(i-tableSerach,
      513                                i-tablekey,
      514                                p-key-rec,
      515                                p-key-handle,
      516                                p-db-name,
      517                                p-tt-handle,
      518                                output v-where).
      519         if i-tableSerach ne "" and i-tableSerach ne ?
      520         then do:
      521            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      522            create buffer bh_tbl-name for table v-full-tbl-name .
      523         end.
      524         else do:
      525            if p-tt-handle = ? then do:
      526               assign
      527                  vTable = entry( 1 , p-key-rec, chr(3) )
      528               .
      529               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      530               create buffer bh_tbl-name for table v-full-tbl-name .
      531            end.
      532            else do:
      533               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      534            end.
      535         end.
      536         if p-tt-handle = ? then do:
      537            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      538         end.
      539         else do:
      540            bh_tbl-name:find-first( v-where ) no-error .
      541         end.
      542         o-hn = bh_tbl-name.
      543      end.
      544   end procedure.
      545   procedure gen-hn-keyr :
      546     define input  parameter p-key-rec    as character no-undo.
      547     define input  parameter p-key-handle as handle    no-undo .
      548     define input  parameter p-db-name    as character no-undo .
      549     define input  parameter p-tt-handle  as handle    no-undo .
      550     define input  parameter p-stts-lock  as integer   no-undo .
      551     define output parameter o-hn         as handle    no-undo.
      552     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      553   end.
      554   procedure gen-row-keyr :
      555     define input  parameter p-key-rec    as character no-undo.
      556     define input  parameter p-key-handle as handle    no-undo .
      557     define input  parameter p-db-name    as character no-undo .
      558     define input  parameter p-tt-handle  as handle    no-undo .
      559     define input  parameter p-stts-lock  as integer   no-undo .
      560     define output parameter p-tbl-row    as rowid     no-undo.
      561     define output parameter p-tbl-name   as character no-undo.
      562     define variable vHn as handle no-undo.
      563       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      564       p-tbl-row = if vHn:available then vHn:rowid else ?.
      565       p-tbl-name =  vHn:table.
      566       delete object vHn no-error.
      567     if p-tbl-row = ? then do:
      568       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      569     end.
      570     else do:
      571       return.
      572     end.
      573   end procedure.
      574   procedure gen-key-fv :
      575     define input  parameter p-key-rec    as character no-undo .
      576     define output parameter p-field-list as character no-undo .
      577     define output parameter p-value-list as character no-undo.
      578     do
      579     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      580     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      581     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      582     :
      583       define variable v-full-tbl-name  as character no-undo .
      584       define variable bh_tbl-name      as handle    no-undo .
      585       define variable v-tbl-name       as character no-undo .
      586       define variable v-field-num      as integer   no-undo .
      587       define variable v-count-fld      as integer   no-undo .
      588       define variable v-inform         as character no-undo .
      589       define variable v-ind            as integer   no-undo .
      590       define variable v-idx-field-qnty as integer   no-undo .
      591       define variable v-delim-key      as character no-undo .
      592       if p-key-rec = ?
      593         or p-key-rec = "":U
      594       then do:
      595         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      596       end.
      597       assign
      598         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      599         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      600       .
      601       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      602       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      603       assign
      604         v-inform = bh_tbl-name:index-information(1)
      605         v-ind    = 2
      606       .
      607       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      608       on error undo, return error
      609       :
      610         assign
      611           v-inform = bh_tbl-name:index-information( v-ind )
      612           v-ind    = v-ind + 1
      613         .
      614       end.
      615       if v-inform = ?
      616         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      617         or entry( 3, v-inform, ",":U ) <> "1":U
      618       then do:
      619         delete object bh_tbl-name no-error.
      620         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      621       end.
      622       assign
      623         v-idx-field-qnty = num-entries( v-inform ) - 4
      624       .
      625       if v-idx-field-qnty < 2 then do:
      626         delete object bh_tbl-name no-error.
      627         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      628       end.
      629       assign
      630         p-field-list = "":U
      631         p-value-list = "":U
      632         v-delim-key  = "":U
      633         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      634         v-count-fld  = 0
      635       .
      636       block_where:
      637       do v-ind = 1 to v-idx-field-qnty by 2
      638       on error undo, return error
      639       :
      640         assign
      641           v-count-fld = v-count-fld + 1
      642         .
      643         if v-count-fld > v-field-num then do:
      644           leave block_where.
      645         end.
      646         assign
      647           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      648           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      649         .
      650         if v-ind = 1 then do:
      651           assign
      652             v-delim-key = chr(3)
      653           .
      654         end.
      655       end.
      656       delete object bh_tbl-name.
      657       if v-count-fld <> v-field-num then do:
      658         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      659       end.
      660     end.
      661   end procedure.
      662   procedure gen-key-field :
      663     define input  parameter p-table      as character no-undo .
      664     define output parameter p-field-list as character no-undo .
      665     do
      666     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      667     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      668     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      669     :
      670       define variable v-full-tbl-name  as character no-undo .
      671       define variable bh_tbl-name      as handle    no-undo .
      672       define variable v-tbl-name       as character no-undo .
      673       define variable v-field-num      as integer   no-undo .
      674       define variable v-count-fld      as integer   no-undo .
      675       define variable v-inform         as character no-undo .
      676       define variable v-ind            as integer   no-undo .
      677       define variable v-idx-field-qnty as integer   no-undo .
      678       define variable v-delim-key      as character no-undo .
      679       if p-table = ?
      680         or p-table = "":U
      681       then do:
      682         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      683       end.
      684       assign
      685         v-tbl-name      = p-table
      686         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      687       .
      688       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      689       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      690       assign
      691         v-inform = bh_tbl-name:index-information(1)
      692         v-ind    = 2
      693       .
      694       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      695       on error undo, return error
      696       :
      697         assign
      698           v-inform = bh_tbl-name:index-information( v-ind )
      699           v-ind    = v-ind + 1
      700         .
      701       end.
      702       if v-inform = ?
      703         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      704         or entry( 3, v-inform, ",":U ) <> "1":U
      705       then do:
      706         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      707       end.
      708       assign
      709         v-idx-field-qnty = num-entries( v-inform ) - 4
      710       .
      711       if v-idx-field-qnty < 2 then do:
      712         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      713       end.
      714       assign
      715         p-field-list = "":U
      716         v-delim-key  = "":U
      717         v-count-fld  = 0
      718       .
      719       block_where:
      720       do v-ind = 1 to v-idx-field-qnty by 2
      721       on error undo, return error
      722       :
      723         assign
      724           v-count-fld = v-count-fld + 1
      725         .
      726         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      727         if v-ind = 1 then do:
      728           assign
      729             v-delim-key = chr(3)
      730           .
      731         end.
      732       end.
      733       delete object bh_tbl-name.
      734     end.
      735   end procedure.
      736   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   define new global shared variable g#lib-nws as handle no-undo .
      738   procedure disproph_write-dis-card-property-proc  :
      739   define parameter buffer buf_dis-card-property for ub.dis-card-property .
      740   define parameter buffer buf_dis-card for ub.dis-card.
      741   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
      742   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
      743   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
      744   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
      745   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
      746   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
      747   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
      748   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
      749   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
      750   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
      751   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
      752   define input parameter p-action      as integer no-undo .
      753   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      754   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      755   define input-output parameter p-chip-num as integer no-undo .
      756   define input-output parameter p-corr-date as date no-undo .
      757   define input-output parameter p-corr-time as integer no-undo .
      758   define variable v-date as date      no-undo.
      759   define variable v-time  as integer   no-undo.
      760   define variable v-uniq-key-rec as character no-undo .
      761   define variable v-send as integer no-undo .
      762   define buffer buf_c-dc-hist for ub.c-dc-hist.
      763   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      764     main-block:
      765     do
      766     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      767     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      768     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      769     :
      770       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
      771         message
      772           vss-workfile vss-revision vss-description skip
      773           "Ошибка задания входных параметров" skip
      774           "Не определена запись СВОЙСТВА ДК" skip
      775           view-as alert-box error .
      776         undo, return error .
      777       end.
      778     v-send = integer('0':U).
      779     if not p-action = integer('1':U) then do:
      780       if available buf_dis-card then do:
      781         if g#news then do:
      782   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      784     (input  g#db-num
      785     ,input  'dis-card-property':U
      786     ,input  0
      787     ,input  '':U
      788     ,input  0
      789     ,input  buf_dis-card.type
      790     ,input  '':U
      791     ,input  '':U
      792     ,input  buf_dis-card.emitent-host-code
      793     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      794     ,input  0
      795     ,input  'nws-to-hist'
      796     ,output v-send
      797     ) no-error .
      798         end.
      799         else do:
      800   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      802     (input  g#db-num
      803     ,input  'dis-card-property':U
      804     ,input  0
      805     ,input  '':U
      806     ,input  0
      807     ,input  buf_dis-card.type
      808     ,input  '':U
      809     ,input  '':U
      810     ,input  buf_dis-card.emitent-host-code
      811     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      812     ,input  0
      813     ,input  'hist-from-prim'
      814     ,output v-send
      815     ) no-error .
      816         end.
      817       end.
      818     end.
      819     if v-send >= 0 then do:
      820       run cur-time in this-procedure(output v-date, output v-time).
      821       if p-action = integer('1':U) then do:
      822         create buf_c-dis-card-property.
      823         assign
      824         buf_c-dis-card-property.d-card            = p-d-card
      825         buf_c-dis-card-property.card-num          = p-card-num
      826         buf_c-dis-card-property.host-code         = p-host-code
      827         buf_c-dis-card-property.obj-type          = p-obj-type
      828         buf_c-dis-card-property.obj-code          = p-obj-code
      829         buf_c-dis-card-property.dt-code           = p-dt-code
      830         buf_c-dis-card-property.node-code         = p-node-code
      831         buf_c-dis-card-property.dtm-code         = p-dtm-code
      832         buf_c-dis-card-property.main-card         = p-main-card
      833         buf_c-dis-card-property.first-main-card   = p-first-main-card
      834         buf_c-dis-card-property.first-card        = p-first-card
      835         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
      836                                                      then next-value (s-dc-chip, ub)
      837                                                      else p-chip-num)
      838         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
      839                                                      then v-time
      840                                                      else p-corr-time)
      841         buf_c-dis-card-property.corr-user-db-num  = g#db-num
      842         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
      843         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
      844                                                      then v-date
      845                                                      else p-corr-date)
      846         .
      847       end.
      848       else do:
      849         create buf_c-dis-card-property.
      850         buffer-copy buf_dis-card-property to buf_c-dis-card-property
      851         assign
      852         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
      853         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
      854         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
      855         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
      856         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
      857         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
      858         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
      859         buf_c-dis-card-property.obj-type          = p-obj-type
      860         buf_c-dis-card-property.obj-code          = p-obj-code
      861         buf_c-dis-card-property.node-code         = p-node-code
      862         buf_c-dis-card-property.dtm-code         = p-dtm-code
      863         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
      864                                                       then next-value (s-dc-chip, ub)
      865                                                       else p-chip-num)
      866         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
      867                                                       then v-time
      868                                                       else p-corr-time)
      869         buf_c-dis-card-property.corr-user-db-num   = g#db-num
      870               buf_c-dis-card-property.corr-user-name    = (if g#news
      871                                                      then (chr(4) +  'СПН':U)
      872                                                      else (if g#esys
      873                                                            then (chr(4) +  'ВС':U)
      874                                                            else g#userid
      875                                                            )
      876                                                      )
      877         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
      878                                                       then v-date
      879                                                       else p-corr-date)
      880         .
      881         run gen-key-rec in this-procedure (
      882                                             input 'dis-card-property':U
      883                                           ,input buffer buf_dis-card-property:handle
      884                                           ,output v-uniq-key-rec).
      885       end.
      886       if p-chip-num = 0   then do:
      887         create buf_c-dc-hist.
      888         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
      889         assign
      890         buf_c-dc-hist.action =  p-action
      891         buf_c-dc-hist.subject = 'dis-card-property':U
      892         buf_c-dc-hist.is-news = g#news
      893         buf_c-dc-hist.source-type = p-source-type
      894         buf_c-dc-hist.source-ref = p-source-ref
      895         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
      896         .
      897       end.
      898       assign
      899       p-chip-num = buf_c-dis-card-property.chip-num
      900       p-corr-date = buf_c-dis-card-property.corr-date
      901       p-corr-time = buf_c-dis-card-property.corr-time
      902       .
      903       run disproph_send-nws in this-procedure (
      904                                                 buffer buf_c-dis-card-property
      905                                                ,buffer buf_c-dc-hist
      906                                                ,buffer buf_dis-card
      907                                                 ).
      908       end.
      909     end.
      910   end procedure.
      911   procedure disproph_send-nws :
      912   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
      913   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
      914   define parameter buffer buf_Dis-card for ub.dis-card.
      915   define variable v-dh-hn as integer no-undo .
      916   main-block:
      917   do
      918   on error undo, return error return-value
      919   :
      920     if g#news
      921     and g#db-num > 0
      922     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
      923     then return.
      924     if g#db-num = 0
      925     or (g#news
      926         and g#db-num > 0
      927         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
      928         )
      929     then do:
      930       if not available buf_dis-card then do:
      931         find first buf_dis-card no-lock where
      932                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
      933       end.
      934       if not available buf_dis-card then do:
      935         assign
      936         v-dh-hn = integer('0':U).
      937       end.
      938       else do:
      939   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      941     (input  g#db-num
      942     ,input  'dis-card-property':U
      943     ,input  0
      944     ,input  '':U
      945     ,input  0
      946     ,input  buf_dis-card.type
      947     ,input  '':U
      948     ,input  '':U
      949     ,input  buf_dis-card.emitent-host-code
      950     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
      951     ,input  0
      952     ,input  'hist-to-nws'
      953     ,output v-dh-hn
      954     ) no-error .
      955       end.
      956       if v-dh-hn >= 0 then do:
      957         run str/callnews.p (
      958           input 'c-dis-card-property':U
      959           ,input (buffer buf_c-dis-card-property:handle)
      960           ) no-error .
      961         if error-status:error then do:
      962           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      963         end.
      964         if available buf_c-dc-hist then do:
      965           run str/callnews.p (
      966             input 'c-dc-hist':U
      967             ,input (buffer buf_c-dc-hist:handle)
      968             ) no-error .
      969           if error-status:error then do:
      970             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      971           end.
      972         end.
      973       end.
      974     end.
      975   end.
      976   end procedure.
      977   procedure discprop-node-code :
      978   define input parameter p-dtm-code as integer no-undo .
      979   define input parameter p-node-code as integer no-undo .
      980   define output parameter p-data-type as character no-undo .
      981   define output parameter p-format as character no-undo .
      982   define output parameter p-label as character no-undo .
      983   define output parameter p-range as integer no-undo .
      984   define output parameter p-rw-option as character no-undo .
      985   define buffer buf_prop-map for ub.prop-map.
      986   define buffer buf_prop-head for ub.prop-head.
      987   do
      988   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      989   :
      990   find first buf_prop-head no-lock where
      991             buf_prop-head.dtm-code = p-dtm-code no-error .
      992   if available buf_prop-head then do:
      993     if p-node-code > 0 then do:
      994       find first buf_prop-map no-lock where
      995                 buf_prop-map.dtm-code = p-dtm-code
      996             and buf_prop-map.node-code = p-node-code no-error .
      997       if available buf_prop-map then do:
      998         assign
      999         p-data-type = buf_prop-map.node-value-type
     1000         p-format = buf_prop-map.node-format
     1001         p-label = buf_prop-map.node-label
     1002         p-rw-option = buf_prop-map.rw-option
     1003         .
     1004       end.
     1005     end.
     1006     if buf_prop-head.storage-place  = "":U
     1007     and buf_prop-head.storage-place-host  > "":U
     1008     and buf_prop-head.storage-place-obj  > "":U then do:
     1009       p-range =  12.
     1010     end.
     1011     if buf_prop-head.storage-place  > "":U
     1012     and buf_prop-head.storage-place-host  > "":U
     1013     and buf_prop-head.storage-place-obj  > "":U then do:
     1014       p-range =  3.
     1015     end.
     1016     if buf_prop-head.storage-place  > "":U
     1017     and buf_prop-head.storage-place-host  > "":U
     1018     and buf_prop-head.storage-place-obj  = "":U then do:
     1019       p-range =  2.
     1020     end.
     1021     if buf_prop-head.storage-place  = "":U
     1022     and buf_prop-head.storage-place-host  > "":U
     1023     and buf_prop-head.storage-place-obj  = "":U then do:
     1024       p-range =  1.
     1025     end.
     1026     if buf_prop-head.storage-place  > "":U
     1027     and buf_prop-head.storage-place-host  = "":U
     1028     and buf_prop-head.storage-place-obj  = "":U then do:
     1029       p-range =  0.
     1030     end.
     1031   end.
     1032   end.
     1033   end procedure.
     1034   procedure discprop-initial:
     1035   define input parameter p-dtm-code as integer no-undo .
     1036   define input parameter p-node-code as integer no-undo .
     1037   define output parameter p-init-value-character as character no-undo .
     1038   define output parameter p-init-value-date as date no-undo .
     1039   define output parameter p-init-value-decimal as decimal no-undo .
     1040   define output parameter p-init-value-integer as integer no-undo .
     1041   define output parameter p-init-value-logical as logical no-undo .
     1042   define buffer buf_prop-map for ub.prop-map.
     1043   find first buf_prop-map no-lock where
     1044             buf_prop-map.dtm-code = p-dtm-code
     1045         and buf_prop-map.node-code = p-node-code no-error.
     1046   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1047                                                               , p-node-code
     1048                                                               , p-dtm-code).
     1049   assign
     1050   p-init-value-character = buf_prop-map.init-value-character
     1051   p-init-value-date = buf_prop-map.init-value-date
     1052   p-init-value-decimal = buf_prop-map.init-value-decimal
     1053   p-init-value-integer = buf_prop-map.init-value-integer
     1054   p-init-value-logical = buf_prop-map.init-value-logical
     1055   .
     1056   end procedure.
     1057   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1058   define buffer buf_attr-prop for ub.attr-prop.
     1059   find first buf_attr-prop no-lock where
     1060             buf_attr-prop.table-name = 'dis-card-property':U
     1061         and buf_attr-prop.templ-rl-root = p-dtm-code
     1062         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1063         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1064   if not available buf_attr-prop
     1065   or logical(buf_attr-prop.property-value) = no then do:
     1066     return no.
     1067   end.
     1068   return yes.
     1069   end function.
     1070   procedure discprop-edit :
     1071   define input parameter p-dtm-code-node-name as character no-undo .
     1072   define output parameter p-edit-menu-section-num as integer no-undo .
     1073   define buffer buf_attr-prop for ub.attr-prop.
     1074   do
     1075   on error undo, return error return-value
     1076   :
     1077     find first buf_attr-prop no-lock where
     1078             buf_attr-prop.table-name = 'dis-card-property':U
     1079        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1080        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1081        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1082     if available buf_attr-prop then do:
     1083       assign
     1084       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1085     end.
     1086   end.
     1087   end procedure.
     1088   procedure discprop-node-name :
     1089   define input parameter p-dtm-code-node-name as character no-undo .
     1090   define output parameter p-tool-tip as character no-undo .
     1091   define output parameter p-node-label as character no-undo .
     1092   define buffer buf_prop-map for ub.prop-map.
     1093   define buffer buf_prop-head for ub.prop-head.
     1094   do
     1095   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1096   :
     1097     find first buf_prop-head no-lock where
     1098               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1099     assign
     1100     p-tool-tip   = if available buf_prop-head
     1101                    then buf_prop-head.prop-des
     1102                    else entry(1, p-dtm-code-node-name, chr(4) )
     1103     p-node-label = (if available buf_prop-head
     1104                     then buf_prop-head.prop-label
     1105                     else '':U)
     1106     .
     1107     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1108       find first buf_prop-map no-lock where
     1109                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1110           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1111       if available buf_prop-map then do:
     1112         assign
     1113         p-tool-tip   = buf_prop-map.node-description
     1114         p-node-label = (if available buf_prop-head
     1115                         then buf_prop-head.prop-label
     1116                         else '':U) + ":" + buf_prop-map.node-label
     1117         .
     1118       end.
     1119     end.
     1120   end.
     1121   end procedure.
     1122   procedure discprop-write :
     1123   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1124   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1125   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1126   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1127   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1128   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1129   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1130   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1131   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1132   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1133   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1134   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1135   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1136   define input parameter p-source-type     as character no-undo .
     1137   define input parameter p-source-ref      as character no-undo .
     1138   define input-output parameter p-chip-num as integer no-undo .
     1139   define input-output parameter p-corr-date as date no-undo .
     1140   define input-output parameter p-corr-time as integer no-undo .
     1141   do
     1142   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1143   :
     1144     define buffer buf_dis-card-property for ub.dis-card-property .
     1145     define buffer buf_dis-card for ub.dis-card.
     1146     define buffer buf_prop-ref for ub.prop-ref.
     1147     define variable v-data-type      as character no-undo .
     1148     define variable v-data-type-1    as character no-undo .
     1149     define variable v-format         as character no-undo .
     1150     define variable v-label          as character no-undo .
     1151     define variable v-range          as integer   no-undo .
     1152     define variable v-rw-option      as character no-undo .
     1153     run discprop-node-code in this-procedure
     1154       (
     1155        input  p-dtm-code
     1156       ,input  p-node-code
     1157       ,output v-data-type
     1158       ,output v-format
     1159       ,output v-label
     1160       ,output v-range
     1161       ,output v-rw-option
     1162       ) no-error .
     1163     if error-status :error then do:
     1164       undo, return error return-value .
     1165     end.
     1166     v-data-type-1 = entry(1, v-data-type).
     1167     if p-dt-code = ? then do:
     1168       find buf_prop-ref no-lock where
     1169           buf_prop-ref.dtm-code = p-dtm-code
     1170       and buf_prop-ref.sum-id = p-sum-id no-error.
     1171       if not available buf_prop-ref then do:
     1172         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1173                                       ,p-dtm-code
     1174                                       ,p-sum-id).
     1175       end.
     1176       assign
     1177       p-dt-code = buf_prop-ref.dt-code.
     1178     end.
     1179     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1180       undo, return error "Нельзя редактировать свойство в данной БД".
     1181     end.
     1182     run discprop-check in this-procedure (
     1183                                             input v-range
     1184                                           ,input p-d-card
     1185                                           ,input p-host-code
     1186                                           ,input p-obj-type
     1187                                           ,input p-obj-code
     1188                                           ,input p-dtm-code
     1189                                           ,input p-node-code
     1190                                           ,input p-dt-code
     1191                                         ) no-error .
     1192     if error-status:error then undo,  return error return-value .
     1193     find first buf_dis-card-property exclusive-lock
     1194       where buf_dis-card-property.d-card    = p-d-card
     1195         and buf_dis-card-property.host-code = p-host-code
     1196         and buf_dis-card-property.obj-type  = p-obj-type
     1197         and buf_dis-card-property.obj-code  = p-obj-code
     1198         and buf_dis-card-property.dt-code = p-dt-code
     1199         and buf_dis-card-property.node-code = p-node-code
     1200       no-error .
     1201       find first buf_dis-card no-lock where
     1202                   buf_dis-card.d-card = p-d-card.
     1203     if not available buf_dis-card-property then do:
     1204       create buf_dis-card-property .
     1205       assign
     1206         buf_dis-card-property.d-card    = p-d-card
     1207         buf_dis-card-property.host-code = p-host-code
     1208         buf_dis-card-property.obj-type  = p-obj-type
     1209         buf_dis-card-property.obj-code  = p-obj-code
     1210         buf_dis-card-property.dt-code = p-dt-code
     1211         buf_dis-card-property.node-code = p-node-code
     1212         buf_dis-card-property.dtm-code = p-dtm-code
     1213         buf_dis-card-property.sum-id   = p-sum-id
     1214         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1215         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1216         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1217         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1218       .
     1219     end.
     1220     else do:
     1221       if (v-data-type-1 = 'character':U
     1222       and buf_dis-card-property.property-value-character = p-value-character)
     1223       or  (v-data-type-1 = 'date':U
     1224           and buf_dis-card-property.property-value-date = p-value-date)
     1225       or  (v-data-type-1 = 'decimal':U
     1226           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1227       or  (v-data-type-1 = 'integer':U
     1228           and buf_dis-card-property.property-value-integer = p-value-integer)
     1229       or  (v-data-type-1 = 'logical':U
     1230           and buf_dis-card-property.property-value-logical = p-value-logical)
     1231       then return.
     1232     end.
     1233     run disproph_write-dis-card-property-proc  in this-procedure (
     1234             buffer buf_dis-card-property
     1235             ,buffer Buf_dis-card
     1236             ,input p-d-card
     1237             ,input p-dt-code
     1238             ,input p-host-code
     1239             ,input p-obj-type
     1240             ,input p-obj-code
     1241             ,input p-dtm-code
     1242             ,input buf_dis-card.card-num
     1243             ,input buf_dis-card.main-card
     1244             ,input buf_dis-card.first-card
     1245             ,input buf_dis-card.first-main-card
     1246             ,input p-node-code
     1247             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1248             ,input p-source-type
     1249             ,input p-source-ref
     1250             ,input-output p-chip-num
     1251             ,input-output p-corr-date
     1252             ,input-output p-corr-time
     1253             ).
     1254     assign
     1255     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1256                                                       then p-value-character
     1257                                                       else buf_dis-card-property.property-value-character)
     1258     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1259                                                       then p-value-date
     1260                                                       else buf_dis-card-property.property-value-date)
     1261     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1262                                                       then p-value-decimal
     1263                                                       else buf_dis-card-property.property-value-decimal)
     1264     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1265                                                       then p-value-integer
     1266                                                       else buf_dis-card-property.property-value-integer)
     1267     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1268                                                       then p-value-logical
     1269                                                       else buf_dis-card-property.property-value-logical)
     1270     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1271     .
     1272     release buf_dis-card-property no-error .
     1273     if error-status:error then do:
     1274       return error return-value .
     1275     end.
     1276   end.
     1277   end procedure.
     1278   procedure discprop-delete :
     1279   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1280   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1281   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1282   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1283   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1284   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1285   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1286   define input parameter p-source-type as character no-undo .
     1287   define input parameter p-source-ref as character no-undo .
     1288   define output parameter p-deleted  as logical no-undo.
     1289   define input-output parameter p-chip-num as integer no-undo .
     1290   define input-output parameter p-corr-date as date no-undo .
     1291   define input-output parameter p-corr-time as integer no-undo .
     1292   do
     1293   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1294   :
     1295   define buffer buf_dis-card-property for ub.dis-card-property .
     1296   define buffer buf_dis-card for ub.dis-card.
     1297   define variable v-data-type      as character no-undo .
     1298   define variable v-format         as character no-undo .
     1299   define variable v-label          as character no-undo .
     1300   define variable v-range          as integer   no-undo .
     1301   define variable v-rw-option      as character   no-undo .
     1302     run discprop-node-code in this-procedure
     1303       (input  p-dtm-code
     1304       ,input  p-node-code
     1305       ,output v-data-type
     1306       ,output v-format
     1307       ,output v-label
     1308       ,output v-range
     1309       ,output v-rw-option
     1310       ) no-error .
     1311     if error-status :error then do:
     1312       undo, return error return-value .
     1313     end.
     1314     find first buf_dis-card-property exclusive-lock
     1315       where buf_dis-card-property.d-card    = p-d-card
     1316         and buf_dis-card-property.host-code = p-host-code
     1317         and buf_dis-card-property.obj-type  = p-obj-type
     1318         and buf_dis-card-property.obj-code  = p-obj-code
     1319         and buf_dis-card-property.dt-code = p-dt-code
     1320         and buf_dis-card-property.node-code = p-node-code
     1321       no-error NO-WAIT.
     1322     if not available buf_dis-card-property then do:
     1323       p-deleted = no.
     1324     end.
     1325     else do:
     1326       run disproph_write-dis-card-property-proc  in this-procedure (
     1327            buffer buf_dis-card-property
     1328           ,buffer buf_dis-card
     1329           ,input buf_dis-card-property.d-card
     1330           ,input buf_dis-card-property.dt-code
     1331           ,input buf_dis-card-property.host-code
     1332           ,input buf_dis-card-property.obj-type
     1333           ,input buf_dis-card-property.obj-code
     1334           ,input buf_dis-card-property.dtm-code
     1335           ,input buf_dis-card-property.card-num
     1336           ,input buf_dis-card-property.main-card
     1337           ,input buf_dis-card-property.first-card
     1338           ,input buf_dis-card-property.first-main-card
     1339           ,input buf_dis-card-property.node-code
     1340           ,input integer('99':U)
     1341           ,input p-source-type
     1342           ,input p-source-ref
     1343           ,input-output p-chip-num
     1344           ,input-output p-corr-date
     1345           ,input-output p-corr-time
     1346            ).
     1347       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1348       delete buf_dis-card-property no-error .
     1349       if error-status:error then do:
     1350         return error return-value.
     1351       end.
     1352       p-deleted = yes.
     1353     end.
     1354   end.
     1355   end procedure.
     1356   procedure discprop-check :
     1357   define input parameter p-range  as integer no-undo .
     1358   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1359   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1360   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1361   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1362   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1363   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1364   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1365   define variable v-message as character no-undo .
     1366   define buffer buf_sysconf for ub.sysconf.
     1367   define buffer buf_clients for ub.clients.
     1368   define buffer buf_dis-card for ub.dis-card.
     1369   define buffer buf_attr-prop for ub.attr-prop.
     1370   do
     1371   on error undo, return error return-value
     1372   :
     1373     if p-host-code > 0 then do:
     1374       FIND FIRST buf_sysconf No-LOCK WHERE
     1375                 buf_sysconf.host-code = p-host-code No-ERROR.
     1376       IF NOT AVAIL buf_sysconf THEN DO:
     1377         v-message = substitute("Не найдена фирма &1", p-host-code).
     1378         RETURN ERROR v-message.
     1379       END.
     1380     end.
     1381     if p-obj-type <> "":U or
     1382         p-obj-code <> 0 then do:
     1383       find first buf_clients No-LOCK WHERE
     1384                 buf_clients.obj-type = p-obj-type AND
     1385                 buf_clients.obj-code = p-obj-code no-error .
     1386       if not available buf_clients then do:
     1387         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1388         RETURN ERROR v-message.
     1389       end.
     1390     end.
     1391     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1392       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1393                               , p-obj-type
     1394                               , p-obj-code
     1395                               , p-host-code).
     1396       RETURN ERROR v-message.
     1397     end.
     1398     if p-d-card <> "":U then do:
     1399       find first buf_dis-card No-LOCK WHERE
     1400                   buf_dis-card.d-card = p-d-card No-ERROR.
     1401       if not avail buf_dis-card then do:
     1402         v-message =substitute("Не найдена ДК").
     1403         return error  v-message.
     1404       end.
     1405       if buf_dis-card.emitent-host-code <> 0
     1406       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1407         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1408         return error v-message.
     1409       end.
     1410       if buf_dis-card.emitent-host-code = 0
     1411       and p-range = 1
     1412       and p-host-code <> 0 then do:
     1413         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1414                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1415                                 , chr(10)
     1416                               ).
     1417         return error v-message.
     1418       end.
     1419     end.
     1420   end.
     1421   end procedure.
     1422   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   define variable dcard-algo-field-name as character no-undo extent 3 init [
     1424    'd-pcnt':U
     1425   ,'cash-d-pcnt':U
     1426   ,'pcnt-kat':U].
     1427   define variable algo-field-abbr as character no-undo extent 3 init [
     1428    'ITEM%':U
     1429   ,'TOTAL%':U
     1430   ,'CATEG':U].
     1431   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     1432   define variable v-date-str as character no-undo .
     1433   assign
     1434   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     1435                string(Month(p-date), "99":U) + chr(47) +
     1436                string(DAY(p-date), "99":U).
     1437   return v-date-str.
     1438   END FUNCTION.
     1439   function dct-algo-string-to-date returns date ( input p-string  as character):
     1440     define variable v-date as date no-undo .
     1441     assign
     1442     v-date = date(integer(substring(p-string, 6, 2))
     1443                   ,integer(substring(p-string, 9, 2))
     1444                   ,integer(substring(p-string, 1, 4))
     1445                  ) no-error .
     1446     if error-status:error then return ?.
     1447     return v-date.
     1448   END FUNCTION.
     1449   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     1450   define buffer buf_prop-ref for ub.prop-ref.
     1451   find first buf_prop-ref no-lock where
     1452             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     1453   if not available buf_prop-ref then do:
     1454     return chr(63).
     1455   end.
     1456   return buf_prop-ref.sum-id.
     1457   END FUNCTION.
     1458   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     1459   define variable v-des as character no-undo .
     1460   define buffer buf_prop-ref for ub.prop-ref.
     1461   define buffer buf_prop-head for ub.prop-head.
     1462   find first buf_prop-ref no-lock where
     1463             buf_prop-ref.dt-code = p-dt-code no-error.
     1464   if not available buf_prop-ref then do:
     1465     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1466   end.
     1467   find first buf_prop-head no-lock where
     1468           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     1469   if not available buf_prop-head then do:
     1470     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     1471   end.
     1472   assign
     1473   v-des = substitute("&1  &2 &3"
     1474                     , buf_prop-head.prop-name
     1475                     , buf_prop-ref.sum-id
     1476                     , buf_prop-ref.caller_id).
     1477   return v-des.
     1478   end FUNCTION.
     1479   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     1480                                                               ,input p-dt-code as integer
     1481                                                               ,input p-node-code as integer
     1482                                                               ):
     1483   define variable v-des as character no-undo .
     1484   define buffer buf_prop-ref for ub.prop-ref.
     1485   define buffer buf_prop-head for ub.prop-head.
     1486   define buffer buf_prop-map for ub.prop-map.
     1487   find first buf_prop-ref no-lock where
     1488             buf_prop-ref.dt-code = p-dt-code no-error.
     1489   if not available buf_prop-ref then do:
     1490     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1491   end.
     1492   find first buf_prop-head no-lock where
     1493           buf_prop-head.dtm-code = p-dtm-code no-error.
     1494   if not available buf_prop-head then do:
     1495     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     1496   end.
     1497   find first buf_prop-map no-lock where
     1498           buf_prop-map.dtm-code = p-dtm-code
     1499       and buf_prop-map.node-code = p-node-code no-error .
     1500   if not available buf_prop-map then do:
     1501     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     1502                       , p-dt-code
     1503                       , buf_prop-head.prop-label
     1504                       , p-node-code).
     1505   end.
     1506   assign
     1507   v-des = substitute("&1.&2 &3 &4"
     1508                     , buf_prop-head.prop-label
     1509                     , buf_prop-map.node-label
     1510                     , buf_prop-ref.sum-id
     1511                     , buf_prop-ref.caller_id).
     1512   return v-des.
     1513   end FUNCTION.
     1514   function dct-algo-get-prev-sum-id RETURNS integer (
     1515                                                       input p-dt-code as integer
     1516                                                      ):
     1517   define variable v-dtm-code as integer no-undo .
     1518   define variable v-sum-id as character no-undo .
     1519   define variable v-caller-id as character no-undo .
     1520   define buffer buf_prop-ref for ub.prop-ref.
     1521   find first buf_prop-ref no-lock where
     1522           buf_prop-ref.dt-code = p-dt-code no-error.
     1523   if not available buf_prop-ref then return ?.
     1524   assign
     1525   v-dtm-code = buf_prop-ref.dtm-code
     1526   v-sum-id = buf_prop-ref.sum-id.
     1527   v-caller-id = buf_prop-ref.caller_id.
     1528   find last buf_prop-ref no-lock where
     1529             buf_prop-ref.dtm-code = v-dtm-code
     1530        and  buf_prop-ref.sum-id < v-sum-id
     1531        and  buf_prop-ref.caller_id = v-caller-id
     1532        no-error.
     1533   if available buf_prop-ref then return buf_prop-ref.dt-code.
     1534   return -1 .
     1535   END FUNCTION.
     1536   FUNCTION dct-algo-get_dcproperty-value returns logical (
     1537                                                             input p-prop-name as character
     1538                                                           , input p-d-card    as character
     1539                                                           , input p-host-code as integer
     1540                                                           , input p-obj-type  as character
     1541                                                           , input p-obj-code  as integer
     1542                                                           , output p-value-character as character
     1543                                                           , output p-value-date   as date
     1544                                                           , output p-value-integer as integer
     1545                                                           , output p-value-decimal as decimal
     1546                                                           , output p-value-logical as logical):
     1547     return no.
     1548   END FUNCTION.
     1549   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     1550                                                             input p-d-card    as character
     1551                                                           , input p-emitent-host-code as integer
     1552                                                           , input p-type as character
     1553                                                           , input p-host-code as integer
     1554                                                           , input p-obj-type  as character
     1555                                                           , input p-obj-code  as integer
     1556                                                           , output p-value-chr as character):
     1557   define variable v-dt-code as integer no-undo .
     1558   define variable v-node-code as integer no-undo .
     1559   define variable v-field-name as character no-undo .
     1560   define variable v-storage-place as character no-undo .
     1561   define variable v-sum-id-value as character no-undo .
     1562   define variable v-sum-id-output as logical no-undo .
     1563   define variable v-value-chr as character no-undo .
     1564   define variable v-ii as integer no-undo .
     1565   define buffer buf_dis-card-property for ub.dis-card-property.
     1566   define buffer buf_dis-host for ub.dis-host.
     1567   define buffer buf_dis-obj for ub.dis-obj.
     1568   run get-cd-sumid in this-procedure (
     1569                                         input p-emitent-host-code
     1570                                        ,input p-type
     1571                                        ,input p-host-code
     1572                                        ,input p-obj-type
     1573                                        ,input p-obj-code
     1574                                        ,output v-sum-id-value
     1575                                        ,output v-sum-id-output
     1576                                       ) no-error.
     1577   if not v-sum-id-output then do:
     1578     return no.
     1579   end.
     1580   do v-ii = 1 to num-entries(v-sum-id-value):
     1581     assign
     1582     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     1583     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     1584     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     1585     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     1586     no-error .
     1587     if not error-status:error then do:
     1588       case v-storage-place:
     1589         when 'dis-card-property':U then do:
     1590           find first buf_dis-card-property no-lock where
     1591                     buf_dis-card-property.d-card = p-d-card
     1592               and  buf_dis-card-property.host-code = p-host-code
     1593               and  buf_dis-card-property.obj-type = p-obj-type
     1594               and  buf_dis-card-property.obj-code = p-obj-code
     1595               and  buf_dis-card-property.dt-code = v-dt-code
     1596               and  buf_dis-card-property.node-code = v-node-code no-error .
     1597           if available buf_dis-card-property then do:
     1598             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     1599           end.
     1600           else do:
     1601             v-value-chr = chr(63).
     1602           end.
     1603         end.
     1604         when 'dis-obj':U then do:
     1605           find first buf_dis-obj no-lock where
     1606                     buf_dis-obj.d-card = p-d-card
     1607               and  buf_dis-obj.obj-type = p-obj-type
     1608               and  buf_dis-obj.obj-code = p-obj-code
     1609               and  buf_dis-obj.dt-code = v-dt-code no-error .
     1610           if available buf_dis-obj then do:
     1611             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     1612           end.
     1613           else do:
     1614             v-value-chr = chr(63).
     1615           end.
     1616         end.
     1617         when 'dis-host':U then do:
     1618           find first buf_dis-host no-lock where
     1619                     buf_dis-host.d-card = p-d-card
     1620               and  buf_dis-host.host-code = p-host-code
     1621               and  buf_dis-host.dt-code = v-dt-code no-error .
     1622           if available buf_dis-host then do:
     1623             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     1624           end.
     1625           else do:
     1626             v-value-chr = chr(63).
     1627           end.
     1628         end.
     1629       end.
     1630     end.
     1631     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     1632   end.
     1633   END FUNCTION.
     1634   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     1635     ( INPUT p-custom-sent as character ) :
     1636   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1637   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1638   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1639   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1640   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1641   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     1642   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1643   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     1644   assign
     1645   v-storage-place = entry(1, p-custom-sent, chr(4))
     1646   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     1647   v-sum-id   = entry(3, p-custom-sent, chr(4))
     1648   v-caller-id = entry(4, p-custom-sent, chr(4))
     1649   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     1650   no-error .
     1651   IF ERROR-STATUS:ERROR THEN DO:
     1652     MESSAGE
     1653     "Не могу разобрать строку, описывающую итог"
     1654      VIEW-AS ALERT-BOX WARNING.
     1655     RETURN chr(63).
     1656   END.
     1657   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1658             buf_prop-ref.dtm-code = v-dtm-code
     1659        AND  buf_prop-ref.sum-id = v-sum-id
     1660        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1661   IF NOT AVAILABLE buf_prop-ref THEN DO:
     1662     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1663               buf_prop-ref.dtm-code = v-dtm-code
     1664         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1665     IF NOT AVAILABLE buf_prop-ref THEN DO:
     1666         MESSAGE
     1667         "Не могу разобрать строку, описывающую итог"
     1668          VIEW-AS ALERT-BOX WARNING.
     1669         RETURN chr(63).
     1670      end.
     1671   end.
     1672   ASSIGN
     1673   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     1674                                                          ,buf_prop-ref.dt-code
     1675                                                          ,v-node-code).
     1676   RETURN v-sum-id-description.
     1677   END FUNCTION.
     1678   define variable vss-include-info12 as character format "X(65)" no-undo
     1679   initial "@(#)$Workfile$ $Revision$".
     1680   define variable v-bgelib-bgefmt        as character         no-undo.
     1681   define variable v-bgelib-bgeflold      as character         no-undo.
     1682   define stream stmXMLOut.
     1683   define stream stmXMLLog.
     1684   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   procedure cur-time :
     1686      define output parameter p-today as date      no-undo .
     1687      define output parameter p-time  as integer   no-undo .
     1688     do
     1689     on error undo, return error
     1690     :
     1691       define variable v-date1 as date      no-undo .
     1692       define variable v-date2 as date      no-undo .
     1693       define variable v-time  as integer   no-undo .
     1694       assign
     1695         v-date1 = today
     1696         v-time  = time
     1697         v-date2 = today
     1698       .
     1699       if v-date1 <> v-date2
     1700       then do:
     1701         assign
     1702           v-date1 = today
     1703           v-time  = v-time
     1704         .
     1705       end.
     1706       assign
     1707         p-today = v-date1
     1708         p-time  = v-time
     1709       .
     1710     end.
     1711   end.
     1712   function cur-time-date returns character
     1713   :
     1714     return string(today, '99/99/9999':U) .
     1715   end.
     1716   function cur-time-mjd returns decimal
     1717   :
     1718     define variable v-date as date      no-undo .
     1719     define variable v-time as integer   no-undo .
     1720     run cur-time in this-procedure
     1721       (output v-date
     1722       ,output v-time
     1723       ) .
     1724     return integer(v-date) - 2400002 + (v-time / 86400) .
     1725   end.
     1726   function cur-time-get-ending-index returns integer
     1727   (input p-number as integer
     1728   )
     1729   :
     1730     if p-number < 0
     1731     or p-number = ?
     1732     then do:
     1733       return 1 .
     1734     end.
     1735     define variable v-rest as integer   no-undo .
     1736     assign
     1737       p-number = p-number modulo 100
     1738     .
     1739     if p-number < 20
     1740     then do:
     1741       assign
     1742         v-rest = p-number
     1743       .
     1744     end.
     1745     else do:
     1746       assign
     1747         v-rest = p-number modulo 10
     1748       .
     1749     end.
     1750     case v-rest :
     1751       when 1
     1752       then do:
     1753         return 2 .
     1754       end.
     1755       when 2 or
     1756       when 3 or
     1757       when 4
     1758       then do:
     1759         return 3 .
     1760       end.
     1761       otherwise do:
     1762         return 1 .
     1763       end.
     1764     end case .
     1765   end.
     1766   procedure cur-time-mjd-to-date :
     1767      define input  parameter i-mjd-diff as decimal no-undo.
     1768      define output parameter o-Date     as date    no-undo.
     1769      define output parameter o-Time     as integer no-undo.
     1770      define variable v-day-number as integer   no-undo .
     1771      if    i-mjd-diff < 0
     1772         or i-mjd-diff = ?
     1773      then do:
     1774         return "?" .
     1775      end.
     1776      assign
     1777         v-day-number = truncate(i-mjd-diff,0).
     1778         o-Date = date(v-day-number + 2400002).
     1779         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1780     .
     1781   end.
     1782   function cur-time-mjd-to-string returns character
     1783   (input p-mjd-diff as decimal
     1784   )
     1785   :
     1786     define variable v-day-number as integer   no-undo .
     1787     define variable v-seconds    as integer   no-undo .
     1788     define variable v-hour       as integer   no-undo .
     1789     define variable v-min        as integer   no-undo .
     1790     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1791     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1792     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1793     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1794     if p-mjd-diff < 0
     1795     or p-mjd-diff = ?
     1796     then do:
     1797       return "?" .
     1798     end.
     1799     assign
     1800       v-day-number = integer(truncate(p-mjd-diff,0))
     1801       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1802     .
     1803     if v-seconds > 86400
     1804     then do:
     1805       assign
     1806         v-seconds = 86400 - 1
     1807       .
     1808     end.
     1809     if v-seconds < 0
     1810     then do:
     1811       assign
     1812         v-seconds = 0
     1813       .
     1814     end.
     1815     assign
     1816       v-hour = truncate(v-seconds / 3600, 0)
     1817     .
     1818     assign
     1819       v-seconds = v-seconds modulo 3600
     1820     .
     1821     assign
     1822       v-min = truncate(v-seconds / 60, 0)
     1823     .
     1824     assign
     1825       v-seconds = v-seconds modulo 60
     1826     .
     1827     return
     1828         (if v-day-number <> 0
     1829           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1830           else ""
     1831         )
     1832       + (if v-day-number <> 0 or v-hour <> 0
     1833           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1834           else ""
     1835         )
     1836       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1837           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1838           else ""
     1839         )
     1840       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1841       .
     1842   end.
     1843   function cur-time-string returns character
     1844   :
     1845     define variable v-date as date      no-undo .
     1846     define variable v-time as integer   no-undo .
     1847     run cur-time in this-procedure
     1848       (output v-date
     1849       ,output v-time
     1850       ) .
     1851     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1852   end.
     1853   function cur-time-string-sec returns character
     1854   :
     1855     define variable v-date as date      no-undo .
     1856     define variable v-time as integer   no-undo .
     1857     run cur-time in this-procedure
     1858       (output v-date
     1859       ,output v-time
     1860       ) .
     1861     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1862   end.
     1863   function cur-time-custom  returns character
     1864   (input p-prefix as character
     1865   ,input p-date-format as character
     1866   ,input p-delimiter as character
     1867   ,input p-time-format as character
     1868   ,input p-suffix as character
     1869   )
     1870   :
     1871     define variable v-date as date      no-undo .
     1872     define variable v-time as integer   no-undo .
     1873     run cur-time in this-procedure
     1874       (output v-date
     1875       ,output v-time
     1876       ) .
     1877     return
     1878       p-prefix
     1879       + string(v-date, p-date-format)
     1880       + p-delimiter
     1881       + string(v-time, p-time-format)
     1882       + p-suffix
     1883       .
     1884   end.
     1885   function cur-time-print  returns character
     1886   :
     1887     define variable v-date as date      no-undo .
     1888     define variable v-time as integer   no-undo .
     1889     run cur-time in this-procedure
     1890       (output v-date
     1891       ,output v-time
     1892       ) .
     1893     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1894   end.
     1895   function cur-time-datetime returns datetime
     1896   :
     1897     define variable v-char as character no-undo .
     1898     define variable v-datetime as datetime no-undo .
     1899     v-char = cur-time-string().
     1900     v-datetime = datetime(v-char).
     1901     return  v-datetime.
     1902   end.
     1903   function cur-time-string-msec returns character
     1904   :
     1905     define variable v-date as datetime  no-undo .
     1906     v-date = now.
     1907     return string(v-date) .
     1908   end.
     1909   define variable vss-include-info14 as character format "X(65)" no-undo
     1910   initial "@(#)$Workfile$ $Revision$".
     1911   procedure xmlchar-test :
     1912   define input parameter p-in-string          as character        no-undo.
     1913   define output parameter p-out-string-enc    as character        no-undo.
     1914   define output parameter p-out-string-dec    as character        no-undo.
     1915   do
     1916   on error undo, return error
     1917   :
     1918          run xmlchar-encode in this-procedure
     1919       (
     1920             input p-in-string
     1921           , output p-out-string-enc
     1922       ).
     1923          run xmlchar-decode in this-procedure
     1924       (
     1925             input p-out-string-enc
     1926           , output p-out-string-dec
     1927       ).
     1928   end.
     1929   end .
     1930   procedure xmlchar-encode :
     1931   define input parameter p-in-string      as character        no-undo.
     1932   define output parameter p-out-string    as character        no-undo.
     1933       define variable v-position      as integer      no-undo.
     1934       define variable v-current-char  as character    no-undo.
     1935   do
     1936   on error undo, return error
     1937   :
     1938       assign
     1939           p-out-string = "":U
     1940       .
     1941       case p-in-string
     1942       :
     1943           when ?
     1944           then do:
     1945               assign
     1946                   p-out-string = "?":U
     1947               .
     1948           end.
     1949           when "?":U
     1950           then do:
     1951               assign
     1952                   p-out-string = "&#63;":U
     1953               .
     1954           end.
     1955           otherwise do:
     1956               do v-position = 1 to length( p-in-string )
     1957               :
     1958                   assign
     1959                       v-current-char = substring( p-in-string, v-position, 1 )
     1960                   .
     1961                   case v-current-char
     1962                   :
     1963                       when "&":U
     1964                       then do:
     1965                           assign
     1966                               p-out-string = p-out-string + "&amp;":U
     1967                           .
     1968                       end.
     1969                       when ">":U
     1970                       then do:
     1971                           assign
     1972                               p-out-string = p-out-string + "&gt;":U
     1973                           .
     1974                       end.
     1975                       when "<":U
     1976                       then do:
     1977                           assign
     1978                               p-out-string = p-out-string + "&lt;":U
     1979                           .
     1980                       end.
     1981                       when "'":U
     1982                       then do:
     1983                           assign
     1984                               p-out-string = p-out-string + "&apos;":U
     1985                           .
     1986                       end.
     1987                       when '"':U
     1988                       then do:
     1989                           assign
     1990                               p-out-string = p-out-string + "&quot;":U
     1991                           .
     1992                       end.
     1993                       when chr(1)
     1994                       then do:
     1995                           assign
     1996                               p-out-string = p-out-string + "":U
     1997                           .
     1998                       end.
     1999                       when chr(2)
     2000                       then do:
     2001                           assign
     2002                               p-out-string = p-out-string + "":U
     2003                           .
     2004                       end.
     2005                       when chr(3)
     2006                       then do:
     2007                           assign
     2008                               p-out-string = p-out-string + "":U
     2009                           .
     2010                       end.
     2011                       when chr(4)
     2012                       then do:
     2013                           assign
     2014                               p-out-string = p-out-string + "":U
     2015                           .
     2016                       end.
     2017                       when chr(5)
     2018                       then do:
     2019                           assign
     2020                               p-out-string = p-out-string + "":U
     2021                           .
     2022                       end.
     2023                       when chr(6)
     2024                       then do:
     2025                           assign
     2026                               p-out-string = p-out-string + "":U
     2027                           .
     2028                       end.
     2029                       when chr(7)
     2030                       then do:
     2031                           assign
     2032                               p-out-string = p-out-string + "":U
     2033                           .
     2034                       end.
     2035                       when chr(8)
     2036                       then do:
     2037                           assign
     2038                               p-out-string = p-out-string + "":U
     2039                           .
     2040                       end.
     2041                       when chr(9)
     2042                       then do:
     2043                           assign
     2044                               p-out-string = p-out-string + "":U
     2045                           .
     2046                       end.
     2047                       when chr(29)
     2048                       then do:
     2049                           assign
     2050                               p-out-string = p-out-string + "":U
     2051                           .
     2052                       end.
     2053                       when chr(10)
     2054                       then do:
     2055                           assign
     2056                               p-out-string = p-out-string + "&#10;":U
     2057                           .
     2058                       end.
     2059                       when chr(13)
     2060                       then do:
     2061                           assign
     2062                               p-out-string = p-out-string + "&#13;":U
     2063                           .
     2064                       end.
     2065                       otherwise do:
     2066                           assign
     2067                               p-out-string = p-out-string + v-current-char
     2068                           .
     2069                       end.
     2070                   end case.
     2071               end.
     2072           end.
     2073       end case.
     2074   end.
     2075   end .
     2076   procedure xmlchar-encode-1c :
     2077   define input parameter p-in-string      as character        no-undo.
     2078   define output parameter p-out-string    as character        no-undo.
     2079       define variable v-position      as integer      no-undo.
     2080       define variable v-current-char  as character    no-undo.
     2081   do
     2082   on error undo, return error
     2083   :
     2084       assign
     2085           p-out-string = "":U
     2086       .
