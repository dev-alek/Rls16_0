     6133        and  ub.dis-card-property.d-card = cash-cli.d-card
     6134        AND  ub.dis-card-property.HOST-CODE = 0
     6135        AND  ub.dis-card-property.obj-type = '':U
     6136        AND  ub.dis-card-property.obj-code = 0
     6137     break
