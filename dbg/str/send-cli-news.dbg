     8711         , input log-file-name
     8712         , input 1
     8713         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     8714                             , ub.cash-desk.pos-type
     8715                             , ub.cash-desk.obj-code
     8716                             , chr(10)
     8717                             , error-status:get-message(1)
     8718                             , return-value )).
     8719     assign
     8720     v-view-log = yes.
     8721     return error return-value .
     8722   end.
     8723   run adm/shattri.p (
     8724           input "get":U
     8725           ,input  'маг':U
     8726           ,input  ub.cash-desk.obj-code
     8727           ,input  'cd-type-r-keeper':U
     8728           ,input  'date-format':U
     8729           ,output v-value-character
     8730           ,output v-value-date
     8731           ,output v-value-decimal
     8732           ,output v-value-integer
     8733           ,output v-value-logical
     8734           ,output v-param-type
     8735           ,INPUT-OUTPUT table-handle v-tth
     8736           ) no-error .
     8737     IF not error-status:error then do:
     8738       delete object v-tth.
     8739       v-date-format = v-value-character.
     8740     end.
     8741     else do:
     8742       delete object v-tth.
     8743       return error return-value .
     8744     end.
     8745     end.
     8746   END CASE.
     8747       RUN for-cash-cycle no-error.
     8748     END.
     8749     IF LAST-OF(ub.cash-desk.pos-type) then do:
     8750   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8751   case ub.cash-desk.pos-type:
     8752     when 'IPC-Servis+':U then do:
     8753   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8754     end.
     8755     when 'NCR-GM':U
     8756     then do:
     8757   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8758     _lock-gds:
     8759     DO while ind < 100 :
     8760       run gbl/lock-prc.p (
     8761            input 'pncr':U
     8762           ,input i-obj-code
     8763           ,input 0
     8764           ,input 0
     8765           ,input 'маг':U
     8766           ,input "":U
     8767           ,input "":U
     8768           ,input ("Код объекта" + ",,,":U +
     8769                   "Тип объекта" +  ",,,":U + 'Пересылка дисконтных карт')
     8770           ,input no
     8771           ,buffer lock-batchprocess
     8772           ) no-error .
     8773       if not error-status:error then do:
     8774         leave _lock-gds.
     8775       end.
     8776       run write-log-and-file in p-log-handle (
     8777           input 1
     8778         , input log-file-name
     8779         , input 1
     8780         , input substitute( "Объект &1: Файл для выгрузки данных ЗАНЯТ - Ждите", i-obj-code
     8781                           )
     8782                                           ).
     8783       pause 1.
     8784     end.
     8785       OS-append
     8786       value( out + fname + '.dat':U )
     8787       value( out + "gmrecmnt.dat":U).
     8788       if search(out + 'debug.flg') = ? then do:
     8789         OS-delete value( out + fname + '.dat':U ).
     8790       end.
     8791       if ub.cash-desk.pos-type = 'NCR-AS@R':U then do:
     8792         output stream ibmstream to value( out + "gmrecmnt.ctl":U).
     8793         put unformatted skip.
     8794         output stream ibmstream close.
     8795       end.
     8796       run write-log-and-file in p-log-handle (
     8797             input 1
     8798           , input log-file-name
     8799           , input 1
     8800           , input substitute( "Данные выгружены в файл &1"
     8801                               ,( out + "gmrecmnt.dat":U)
     8802                             )
     8803                                            ).
     8804       if g#news
     8805       or g#auto
     8806       or g#esys
     8807       then do:
     8808         run str/waitpn.w (
     8809                      input (out + "gmrecmnt.dat":U)
     8810                     ,input ( if action = 'U'
     8811                               then ('Ждите - ' + 'добавление дисконтных карт')
     8812                               else ('Ждите - ' + 'удаление дисконтных карт') )
     8813                     ,input ' Подождите 15 сек '
     8814                     ,input 15
     8815                     ) no-error.
     8816       end.
     8817       else do:
     8818         run str/waitp.w (
     8819                      input (out + "gmrecmnt.dat":U)
     8820                     ,input ( if action = 'U'
     8821                               then ('Ждите - ' + 'добавление дисконтных карт')
     8822                               else ('Ждите - ' + 'удаление дисконтных карт') )
     8823                     ,input ' Подождите 15 сек '
     8824                     ,input 'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!'
     8825                     ,input 15
     8826                     )
     8827                     no-error.
     8828       end.
     8829       if error-status:error then do:
     8830           run write-log-and-file in p-log-handle (
     8831                 input 1
     8832               , input log-file-name
     8833               , input 1
     8834               , input substitute( "!!!Прерван обмен информацией с кассой, на кассе осталась устаревшая информация"
     8835                                 )
     8836                                                 ).
     8837           os-delete value( out + "gmrecmnt.dat":U).
     8838           assign
     8839           v-view-log = yes
     8840           .
     8841           return "error":U.
     8842       end.
     8843     end.
