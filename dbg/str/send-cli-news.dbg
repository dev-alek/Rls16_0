     4592     define output parameter p-send-param     as logical no-undo .
     4593     do
     4594     on error undo, return error return-value
     4595     :
     4596           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-send-param in g#attr-lib
     4597         (input  p-ucode
     4598         ,input  p-code
     4599         ,output p-send-param
     4600         ) no-error .
     4601       if error-status :error
     4602       then do:
     4603         undo, return error return-value .
     4604       end.
     4605     end.
     4606   end procedure.
     4607   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4608   PROCEDURE cd-mrkt_plu-marketer :
     4609   define input parameter p-silence as logical no-undo .
     4610   define parameter buffer buf_cash-desk for ub.cash-desk.
     4611   define input parameter p-id as character no-undo .
     4612   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4613   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4614   define input parameter p-loc-ean as logical no-undo .
     4615   define input parameter p-is-petrolium as logical no-undo .
     4616   define input parameter p-extra as character no-undo .
     4617   define variable v-tot-gds as integer no-undo .
     4618   define variable v-max-gds as integer no-undo .
     4619   define variable v-petrol-start as integer no-undo .
     4620   define variable v-petrol-range as integer no-undo .
     4621   DEFINE VARIABLE v-today as date no-undo .
     4622   DEFINE VARIABLE v-time as integer no-undo .
     4623   define variable v-plu-type as character no-undo .
     4624   define variable v-int as integer no-undo .
     4625   define buffer  buf_cd-plu for ub.cd-plu.
     4626   define buffer  loc_cd-plu for ub.cd-plu.
     4627   define variable  ii as integer no-undo.
     4628   define variable v-mes as character no-undo .
     4629   _main:
     4630   DO ON ERROR undo, leave on stop undo, leave:
     4631     if buf_cash-desk.pos-type <> 'MARIA':U
     4632     or buf_cash-desk.cash-num <> 0 then do:
     4633       assign
     4634       v-mes =
     4635       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4636                 , buf_cash-desk.pos-type).
     4637       if not p-silence then
     4638       message
     4639       v-mes
     4640       view-as alert-box error .
     4641       return error v-mes.
     4642     end.
     4643     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4644                                     ,input 'MARIA_operative':U
     4645                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4646                                           and p-is-petrolium
     4647                                           then 'tot-petrol':U
     4648                                           else 'tot-gds':U)
     4649                                     , output v-mes).
     4650     if v-tot-gds = ? then undo _main, return error v-mes.
     4651     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4652                                     ,input 'MARIA_general':U
     4653                                     ,input 'max-gds':U
     4654                                     ,output v-mes).
     4655     if v-max-gds = ? then undo _main, return error v-mes.
     4656     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4657                                          ,input 'petrolium-range':U
     4658                                          ,input 'petrolium-range':U
     4659                                          ,output v-mes).
     4660     if v-petrol-range = ? then undo _main, return error v-mes.
     4661     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4662       assign
     4663       v-petrol-start = 1
     4664       v-max-gds = (if p-is-petrolium
     4665                    then v-petrol-range
     4666                    else v-max-gds)
     4667       v-plu-type = (if p-is-petrolium
     4668                  then 'топ':U
     4669                  else '':U)
     4670       .
     4671       if p-is-petrolium then do:
     4672         if p-id = '':U then do:
     4673           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4674                               "Невозможно привязать к кассе типа &3"
     4675                               , p-b-str
     4676                               , chr(10)
     4677                               , 'MARIA':U).
     4678           if not p-silence then
     4679           message
     4680           v-mes
     4681           view-as alert-box error .
     4682           return error v-mes.
     4683         end.
     4684         assign
     4685         v-int = integer(p-id)
     4686         no-error
     4687         .
     4688         if error-status:error
     4689         or v-int > v-petrol-range then do:
     4690           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4691                               "в диапазоны номеров резервуаров для кассы типа &4"
     4692                               , p-id
     4693                               , p-b-str
     4694                               , chr(10)
     4695                               , 'MARIA':U).
     4696           if not p-silence then
     4697           message
     4698           v-mes
     4699           view-as alert-box error .
     4700           return error v-mes.
     4701         end.
     4702       end.
     4703     end.
     4704     if buf_cash-desk.pos-type = 'MARIA':U
     4705     and p-is-petrolium then do:
     4706       find first loc_cd-plu where
     4707                loc_cd-plu.obj-type = 'маг':U
     4708            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4709            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4710            and loc_cd-plu.plu-type = 'топ':U
     4711      no-error .
     4712      if available loc_cd-plu then do:
     4713        if loc_cd-plu.b-code = p-b-code
     4714        and loc_cd-plu.b-str = p-b-str then do:
     4715           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4716                               , p-id
     4717                               , p-b-str
     4718                               , chr(10)
     4719                               ).
     4720           if not p-silence then
     4721           message
     4722           v-mes
     4723           view-as alert-box WARNING .
     4724           return v-mes.
     4725        end.
     4726        else do:
     4727           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4728                               "нельзя его привязать к топливу &2&3"
     4729                               , p-id
     4730                               , loc_cd-plu.b-str
     4731                               , chr(10)
     4732                               , p-b-str).
     4733           if not p-silence then
     4734           message
     4735           v-mes
     4736           view-as alert-box error .
     4737           return error v-mes.
     4738        end.
     4739      end.
     4740      ii = v-int.
     4741     end.
     4742     else do:
     4743       DO ii = (if p-is-petrolium
     4744               then v-petrol-start
     4745               else (if buf_cash-desk.pos-type = 'MARIA':U
     4746                    then 1
     4747                    else (if v-petrol-start = 1
     4748                           then (v-petrol-range + 1)
     4749                           else 1)
     4750                   )
     4751               )
     4752         to v-max-gds :
     4753         if not can-find (loc_cd-plu where
     4754                         loc_cd-plu.obj-type = 'маг':U
     4755                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4756                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4757                      and loc_cd-plu.plu-type = v-plu-type
     4758                      and loc_cd-plu.plu-code = ii
     4759                       )
     4760         then LEAVE .
     4761       END .
     4762     end.
     4763     if ii > v-max-gds then do:
     4764         if not p-silence then
     4765         message
     4766         substitute("Превышено максимально допустимое количество &5 &1" +
     4767                   "для касс &2 &3&4"
     4768                   , chr(10)
     4769                   , v-max-gds
     4770                   , 'маг':U
     4771                   , buf_cash-desk.obj-code
     4772                   , (if p-is-petrolium then "топлив" else "товаров")
     4773                   )
     4774         view-as alert-box ERROR .
     4775         undo, return error "max-gds":U.
     4776     end.
     4777     DO ii = (if p-is-petrolium
     4778              then v-petrol-start
     4779              else (if v-petrol-start = 1
     4780                    then (v-petrol-range + 1)
     4781                    else 1)
     4782              )
     4783        to v-max-gds :
     4784       if not can-find (loc_cd-plu where
     4785                         loc_cd-plu.obj-type = 'маг':U
     4786                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4787                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4788                      and loc_cd-plu.plu-type = v-plu-type
     4789                      and loc_cd-plu.plu-code = ii
     4790                      )
     4791       then LEAVE .
     4792     END .
     4793     if ii > v-max-gds then do:
     4794         if not p-silence then
     4795         message
     4796         substitute("Превышено максимально допустимое количество &5 &1" +
     4797                   "для касс &2 &3&4"
     4798                   , chr(10)
     4799                   , v-max-gds
     4800                   , 'маг':U
     4801                   , buf_cash-desk.obj-code
     4802                   , (if p-is-petrolium then "топлив" else "товаров")
     4803                   )
     4804         view-as alert-box ERROR .
     4805         undo, return error "max-gds":U.
     4806     end.
     4807     run cur-time in this-procedure ( output v-today, output v-time).
     4808     create buf_cd-plu.
     4809     assign
     4810     buf_cd-plu.b-code = p-b-code
     4811     buf_cd-plu.b-str = p-b-str
     4812     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4813                                         then buf_cash-desk.addr-path
     4814                                         else "U":U)
     4815     buf_cd-plu.to-send = yes
     4816     buf_cd-plu.charkey_one = "":U
     4817     buf_cd-plu.to-del = no
     4818     buf_cd-plu.plu-code = ii
     4819     buf_cd-plu.obj-type = 'маг':U
     4820     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4821     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4822     buf_cd-plu.plu-type = v-plu-type
     4823     buf_cd-plu.logkey_one = p-loc-ean
     4824     buf_cd-plu.key#_one = integer(p-extra)
     4825     .
     4826     run cd-attr-write  in this-procedure (
     4827                                           input   buf_cash-desk.db-num
     4828                                           ,input  buf_cash-desk.obj-code
     4829                                           ,input  buf_cash-desk.pos-type
     4830                                           ,input  buf_cash-desk.cash-num
     4831                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4832                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4833                                                 and p-is-petrolium
     4834                                                 then 'tot-petrol':U
     4835                                                 else 'tot-gds':U)
     4836                                           ,input ''
     4837                                           ,input ?
     4838                                           ,input 0.0
     4839                                           ,input  (v-tot-gds + 1)
     4840                                           ,input no
     4841                                          ) no-error .
     4842     if error-status:error then do:
     4843       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4844                          ,buf_cash-desk.cash-num
     4845                          , 'маг':U
     4846                          ,buf_cash-desk.obj-code
     4847                          , chr(10)
     4848                          , error-status:get-message(1)
     4849                          , return-value
     4850                          ).
     4851       if not p-silence then
     4852       message
     4853       v-mes
     4854       view-as alert-box error .
     4855       undo _main, return error v-mes.
     4856     end.
     4857     run cd-attr-write  in this-procedure (
     4858                                           input   buf_cash-desk.db-num
     4859                                           ,input  buf_cash-desk.obj-code
     4860                                           ,input  buf_cash-desk.pos-type
     4861                                           ,input  buf_cash-desk.cash-num
     4862                                           ,input  'MARIA_operative':U
     4863                                           ,input  'to-send':U
     4864                                           ,input ''
     4865                                           ,input ?
     4866                                           ,input 0.0
     4867                                           ,input 0
     4868                                           ,input yes
     4869                                          ) no-error .
     4870     if error-status:error then do:
     4871       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     4872                          ,buf_cash-desk.cash-num
     4873                          , 'маг':U
     4874                          ,buf_cash-desk.obj-code
     4875                          , chr(10)
     4876                          , error-status:get-message(1)
     4877                          , return-value
     4878                          ).
     4879       if not p-silence then
     4880       message
     4881       v-mes
     4882       view-as alert-box error .
     4883       undo _main, return error v-mes.
     4884     end.
     4885     return "":U.
     4886   end.
     4887   END PROCEDURE.
     4888   procedure cd-mrkt_update-marketer :
     4889   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     4890   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     4891   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     4892   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     4893   define input parameter p-is-petrolium as logical no-undo .
     4894   define variable v-to-send as logical no-undo .
     4895   define variable v-tot-gds as integer no-undo .
     4896   define variable v-max-plu as integer no-undo .
     4897   define buffer buf_cd-plu for ub.cd-plu.
     4898   define variable v-plu-type as character no-undo .
     4899     do
     4900     on error undo, return error
     4901     :
     4902       v-to-send = no.
     4903       v-tot-gds = 0.
     4904       assign
     4905       v-plu-type = (if p-is-petrolium
     4906                     then  'топ':U
     4907                     else '':U
     4908                 )
     4909       .
     4910       FOR EACH buf_cd-plu WHERE
     4911              buf_cd-plu.obj-type = 'маг':U
     4912         and  buf_cd-plu.obj-code = p-obj-code
     4913         and  buf_cd-plu.pos-type = p-pos-type
     4914         and  buf_cd-plu.plu-type = v-plu-type
     4915             :
     4916         if  buf_cd-plu.to-del
     4917         or  buf_cd-plu.to-send then do:
     4918           assign
     4919           v-to-send = yes.
     4920         end.
     4921         assign
     4922         v-tot-gds = v-tot-gds + 1.
     4923       end.
     4924       run cd-attr-write  in this-procedure (
     4925                                               input   p-db-num
     4926                                               ,input  p-obj-code
     4927                                               ,input  p-pos-type
     4928                                               ,input  p-cash-num
     4929                                               ,input  'MARIA_operative':U
     4930                                               ,input  (if p-pos-type = 'MARIA':U
     4931                                                        and p-is-petrolium
     4932                                                        then  'tot-petrol':U
     4933                                                        else 'tot-gds':U)
     4934                                               ,input ''
     4935                                               ,input ?
     4936                                               ,input 0.0
     4937                                               ,input v-tot-gds
     4938                                               ,input no
     4939                                                                                           ) no-error .
     4940       if error-status:error then do:
     4941           UNDO, RETURN ERROR RETURN-VALUE.
     4942       END.
     4943       run cd-attr-write  in this-procedure (
     4944                                               input   p-db-num
     4945                                               ,input  p-obj-code
     4946                                               ,input  p-pos-type
     4947                                               ,input  p-cash-num
     4948                                               ,input  'MARIA_operative':U
     4949                                               ,input  (if p-pos-type = 'MARIA':U
     4950                                                        and p-is-petrolium
     4951                                                        then  'petrol-to-send':U
     4952                                                        else 'to-send':U)
     4953                                               ,input ''
     4954                                               ,input ?
     4955                                               ,input 0.0
     4956                                               ,input 0
     4957                                               ,input v-to-send
     4958                                               ) no-error .
     4959       if error-status:error then do:
     4960           UNDO, RETURN ERROR RETURN-VALUE.
     4961       END.
     4962       FIND LAST buf_cd-plu NO-LOCK  WHERE
     4963                buf_cd-plu.obj-type = 'маг':U
     4964            and buf_cd-plu.obj-code = p-obj-code
     4965            and buf_cd-plu.pos-type = p-pos-type
     4966            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     4967       if available buf_cd-plu then do:
     4968         if v-max-plu < buf_cd-plu.plu-code
     4969         then
     4970         v-max-plu = buf_cd-plu.plu-code .
     4971       end.
     4972       else do:
     4973         v-max-plu = 0.
     4974       end.
     4975       run cd-attr-write  in this-procedure (
     4976                                             input   p-db-num
     4977                                             ,input  p-obj-code
     4978                                             ,input  p-pos-type
     4979                                             ,input  p-cash-num
     4980                                             ,input  'MARIA_operative':U
     4981                                             ,input  (if p-pos-type = 'MARIA':U
     4982                                                     and p-is-petrolium
     4983                                                     then 'max-petrol-plu':U
     4984                                                     else 'max-plu':U)
     4985                                               ,input ''
     4986                                               ,input ?
     4987                                               ,input 0.0
     4988                                               ,input v-max-plu
     4989                                               ,input no
     4990                                             ) no-error .
     4991       if error-status:error then do:
     4992           UNDO, RETURN ERROR RETURN-VALUE.
     4993       END.
     4994     end.
     4995   end procedure.
     4996   PROCEDURE cd-mrkt_clu-marketer :
     4997   define input parameter p-silence as logical no-undo .
     4998   define parameter buffer buf_cash-desk for ub.cash-desk.
     4999   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5000   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5001   define variable v-tot-cli as integer no-undo .
     5002   define variable v-max-cli as integer no-undo .
     5003   DEFINE VARIABLE v-today as date no-undo .
     5004   DEFINE VARIABLE v-time as integer no-undo .
     5005   define buffer  buf_cd-clu for ub.cd-clu.
     5006   define buffer  loc_cd-clu for ub.cd-clu.
     5007   define variable  ii as integer no-undo.
     5008   define variable v-mes as character no-undo .
     5009   _main:
     5010   DO ON ERROR undo, leave on stop undo, leave:
     5011     if buf_cash-desk.pos-type <> 'MARIA':U
     5012     or buf_cash-desk.cash-num <> 0 then do:
     5013       assign
     5014       v-mes =
     5015       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5016                 , buf_cash-desk.pos-type).
     5017       if not p-silence then
     5018       message
     5019       v-mes
     5020       view-as alert-box error .
     5021       return error v-mes.
     5022     end.
     5023     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5024                                     ,input 'MARIA_operative':U
     5025                                     ,input 'tot-cli':U
     5026                                     ,output v-mes).
     5027     if v-tot-cli = ? then undo _main, return error v-mes.
     5028     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5029                                     ,input 'MARIA_general':U
     5030                                     ,input 'max-cli':U
     5031                                     , output v-mes).
     5032     if v-max-cli = ? then undo _main, return error v-mes.
     5033     DO ii = 1
     5034        to v-max-cli :
     5035       if not can-find (loc_cd-clu where
     5036                       loc_cd-clu.obj-type = 'маг':U
     5037                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5038                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5039                   and loc_cd-clu.clu-type = '':U
     5040                   and loc_cd-clu.clu-code = ii
     5041                      )
     5042       then LEAVE .
     5043     END .
     5044     if ii > v-max-cli then do:
     5045         if not p-silence then
     5046         message
     5047         substitute("Превышено максимально допустимое количество клиентов &1" +
     5048                   "для касс &2 &3&4"
     5049                   , chr(10)
     5050                   , v-max-cli
     5051                   , 'маг':U
     5052                   , buf_cash-desk.obj-code
     5053                   )
     5054         view-as alert-box ERROR .
     5055         undo, return error "max-cli":U.
     5056     end.
     5057     run cur-time in this-procedure ( output v-today, output v-time).
     5058     create buf_cd-clu.
     5059     assign
     5060     buf_cd-clu.cli-code = p-obj-code
     5061     buf_cd-clu.cli-type = p-obj-type
     5062     buf_cd-clu.obj-type = 'маг':U
     5063     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5064     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5065     buf_cd-clu.clu-type = '':U
     5066     buf_cd-clu.to-send = yes
     5067     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5068                               then buf_cash-desk.addr-path
     5069                               else "U":U)
     5070     buf_cd-clu.clu-code = ii
     5071     .
     5072     run cd-attr-write  in this-procedure (
     5073                                           input   buf_cash-desk.db-num
     5074                                           ,input  buf_cash-desk.obj-code
     5075                                           ,input  buf_cash-desk.pos-type
     5076                                           ,input  buf_cash-desk.cash-num
     5077                                           ,input  'MARIA_operative':U
     5078                                           ,input  'tot-cli':U
     5079                                           ,input ''
     5080                                           ,input ?
     5081                                           ,input 0.0
     5082                                           ,input  (v-tot-cli + 1)
     5083                                           ,input no
     5084                                          ) no-error .
     5085     if error-status:error then do:
     5086       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5087                          ,buf_cash-desk.cash-num
     5088                          , 'маг':U
     5089                          ,buf_cash-desk.obj-code
     5090                          , chr(10)
     5091                          , error-status:get-message(1)
     5092                          , return-value
     5093                          ).
     5094       if not p-silence then
     5095       message
     5096       v-mes
     5097       view-as alert-box error .
     5098       undo _main, return error v-mes.
     5099     end.
     5100     run cd-attr-write  in this-procedure (
     5101                                           input   buf_cash-desk.db-num
     5102                                           ,input  buf_cash-desk.obj-code
     5103                                           ,input  buf_cash-desk.pos-type
     5104                                           ,input  buf_cash-desk.cash-num
     5105                                           ,input  'MARIA_operative':U
     5106                                           ,input  'cli-to-send':U
     5107                                           ,input ''
     5108                                           ,input ?
     5109                                           ,input 0.0
     5110                                           ,input 0
     5111                                           ,input yes
     5112                                          ) no-error .
     5113     if error-status:error then do:
     5114       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5115                          ,buf_cash-desk.cash-num
     5116                          , 'маг':U
     5117                          ,buf_cash-desk.obj-code
     5118                          , chr(10)
     5119                          , error-status:get-message(1)
     5120                          , return-value
     5121                          ).
     5122       if not p-silence then
     5123       message
     5124       v-mes
     5125       view-as alert-box error .
     5126       undo _main, return error v-mes.
     5127     end.
     5128     return "":U.
     5129   end.
     5130   END PROCEDURE.
     5131   procedure cd-mrkt_update-marketer-cli :
     5132   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5133   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5134   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5135   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5136   define variable v-cli-to-send as logical no-undo .
     5137   define variable v-tot-cli as integer no-undo .
     5138   define variable v-max-clu as integer no-undo .
     5139   define buffer buf_cd-clu for ub.cd-clu.
     5140   do
     5141   on error undo, return error return-value
     5142   :
     5143     v-cli-to-send = no.
     5144     v-tot-cli = 0.
     5145     FOR EACH buf_cd-clu WHERE
     5146           buf_cd-clu.obj-type = 'маг':U
     5147       and buf_cd-clu.obj-code =  p-obj-code
     5148       and buf_cd-clu.pos-type =  p-pos-type
     5149       and buf_cd-clu.clu-type =  '':U
     5150       :
     5151       if buf_cd-clu.to-del = yes then do:
     5152         assign
     5153         v-cli-to-send = yes.
     5154       end.
     5155       assign
     5156       v-tot-cli = v-tot-cli + 1.
     5157     end.
     5158     run cd-attr-write  in this-procedure (
     5159                                             input   p-db-num
     5160                                             ,input  p-obj-code
     5161                                             ,input  p-pos-type
     5162                                             ,input  p-cash-num
     5163                                             ,input  'MARIA_operative':U
     5164                                             ,input  'tot-cli':U
     5165                                             ,input ''
     5166                                             ,input ?
     5167                                             ,input 0.0
     5168                                             ,input v-tot-cli
     5169                                             ,input no
     5170                                             ) no-error .
     5171     if error-status:error then do:
     5172         UNDO, RETURN ERROR RETURN-VALUE.
     5173     END.
     5174     run cd-attr-write  in this-procedure (
     5175                                             input   p-db-num
     5176                                             ,input  p-obj-code
     5177                                             ,input  p-pos-type
     5178                                             ,input  p-cash-num
     5179                                             ,input  'MARIA_operative':U
     5180                                             ,input  'cli-to-send':U
     5181                                             ,input ''
     5182                                             ,input ?
     5183                                             ,input 0.0
     5184                                             ,input 0
     5185                                             ,input v-cli-to-send
     5186                                             ) no-error .
     5187     if error-status:error then do:
     5188         UNDO, RETURN ERROR RETURN-VALUE.
     5189     END.
     5190     FIND LAST buf_cd-clu WHERE
     5191             buf_cd-clu.obj-type = 'маг':U
     5192         and buf_cd-clu.obj-code = p-obj-code
     5193         and buf_cd-clu.pos-type = p-pos-type
     5194         and buf_cd-clu.clu-type = '':U
     5195         NO-LOCK use-index pi no-error .
     5196     if available buf_cd-clu then do:
     5197       if v-max-clu < buf_cd-clu.clu-code
     5198       then
     5199       v-max-clu = buf_cd-clu.clu-code.
     5200     end.
     5201     else do:
     5202       v-max-clu = 0.
     5203     end.
     5204     run cd-attr-write  in this-procedure (
     5205                                           input   p-db-num
     5206                                           ,input  p-obj-code
     5207                                           ,input  p-pos-type
     5208                                           ,input  p-cash-num
     5209                                           ,input  'MARIA_operative':U
     5210                                           ,input  'max-clu':U
     5211                                           ,input ''
     5212                                           ,input ?
     5213                                           ,input 0.0
     5214                                           ,input v-max-clu
     5215                                           ,input no
     5216                                           ) no-error .
     5217     if error-status:error then do:
     5218         UNDO, RETURN ERROR RETURN-VALUE.
     5219     END.
     5220   end.
     5221   end procedure.
     5222   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5223   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5224   define temp-table temp-dis-card-type no-undo like ub.dis-card-type.
     5225   procedure get-cd-sumid :
     5226   define input parameter p-emitent-host-code as integer no-undo .
     5227   define input parameter p-type as character no-undo .
     5228   define input parameter p-obj-type as character no-undo .
     5229   define input parameter p-obj-code as integer no-undo .
     5230   define input parameter p-host-code as integer no-undo .
     5231   define output parameter p-sum-id-value as character no-undo .
     5232   define output parameter p-sum-id-output as logical no-undo .
     5233   define variable v-param-type as character no-undo .
     5234   define variable v-value-character as character no-undo .
     5235   define variable v-value-date as date no-undo .
     5236   define variable v-value-decimal as decimal no-undo .
     5237   define variable v-value-integer as INTEGER no-undo .
     5238   define variable v-value-logical AS LOGICAL no-undo .
     5239   define variable v-tth as handle no-undo .
     5240   define variable v-dt-code as integer no-undo .
     5241   define variable v-dtm-code as integer no-undo .
     5242   define variable v-caller-id as character no-undo .
     5243   define variable v-node-code as integer no-undo .
     5244   define variable v-node-value-type as character no-undo .
     5245   define variable v-value-field-name as character no-undo .
     5246   define variable v-storage-place as character no-undo .
     5247   define variable v-current-sum-id1 as character no-undo .
     5248   define variable v-current-sum-id2 as character no-undo .
     5249   DEFINE VARIABLE v-today as date no-undo .
     5250   DEFINE VARIABLE v-time as integer no-undo .
     5251   define variable v-ii as integer no-undo .
     5252   define buffer buf_prop-ref for ub.prop-ref.
     5253   define buffer buf_prop-map for ub.prop-map.
     5254   define buffer buf_temp-dis-card-type for temp-dis-card-type.
     5255   define buffer buf_dis-card-type for ub.dis-card-type.
     5256   do
     5257   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5258   :
     5259     find first buf_temp-dis-card-type no-lock where
     5260               buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     5261           and buf_temp-dis-card-type.type = p-type
     5262           and buf_temp-dis-card-type.obj-type = p-obj-type
     5263           and buf_temp-dis-card-type.obj-code = p-obj-code no-error .
     5264     if not available buf_temp-dis-card-type then do:
     5265       find first buf_dis-card-type no-lock where
     5266                 buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5267             and buf_dis-card-type.type = p-type
     5268             and buf_dis-card-type.obj-type = p-obj-type
     5269             and buf_dis-card-type.obj-code = p-obj-code no-error .
     5270       if not available buf_Dis-card-type then do:
     5271         find first buf_dis-card-type no-lock where
     5272                   buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5273               and buf_dis-card-type.type = p-type
     5274               and buf_dis-card-type.host-code = p-host-code no-error .
     5275         if not available buf_Dis-card-type
     5276         and p-emitent-host-code = 0 then do:
     5277           find first buf_dis-card-type no-lock where
     5278                     buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5279                 and buf_dis-card-type.type = p-type
     5280                 and buf_dis-card-type.host-code = 0 no-error .
     5281         end.
     5282       end.
     5283       if available buf_dis-card-type then do:
     5284         find first buf_temp-dis-card-type where
     5285                     buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     5286                 and buf_temp-dis-card-type.type = p-type
     5287                 and buf_temp-dis-card-type.host-code = 0 no-error .
     5288         if not available buf_temp-dis-card-type then do:
     5289           create buf_temp-dis-card-type.
     5290           buffer-copy buf_dis-card-type to
     5291           buf_temp-dis-card-type.
     5292         end.
     5293       end.
     5294     end.
     5295     if available buf_temp-dis-card-type then do:
     5296       assign
     5297       v-sum-id-value = buf_temp-dis-card-type.custom-sent
     5298       p-sum-id-output = not (v-sum-id-value = fill(chr(63), num-entries(v-sum-id-value)))
     5299       .
     5300     end.
     5301     if p-sum-id-output then do:
     5302       do v-ii = 1 to num-entries(v-sum-id-value):
     5303         assign
     5304         v-value-character = entry(v-ii, v-sum-id-value)
     5305         v-storage-place = entry(1, v-value-character, chr(4))
     5306         v-dtm-code = integer(entry(2, v-value-character, chr(4)))
     5307         v-sum-id   = entry(3, v-value-character, chr(4))
     5308         v-caller-id = entry(4, v-value-character, chr(4))
     5309         v-node-code = integer(entry(5, v-value-character, chr(4)))
     5310         no-error .
     5311         if error-status:error then do:
     5312           assign
     5313           p-sum-id-value = chr(63)
     5314           p-sum-id-output = no
     5315           .
     5316           return.
     5317         end.
     5318         else do:
     5319           run cur-time in this-procedure ( output v-today, output v-time).
     5320           _prop-ref:
     5321           for each buf_prop-ref no-lock where
     5322                   buf_prop-ref.dtm-code = v-dtm-code
     5323               and buf_prop-ref.caller_id = v-caller-id,
     5324               first buf_prop-map no-lock where
     5325                     buf_prop-map.dtm-code = v-dtm-code
     5326                 and buf_prop-map.node-code = v-node-code
     5327           by buf_prop-ref.dtm-code
     5328           by buf_prop-ref.sum-id:
     5329             assign
     5330             p-sum-id-value = substitute("&2&1&3&1&4&1&5"
     5331                                         , chr(4)
     5332                                         ,v-storage-place
     5333                                         ,buf_prop-ref.dt-code
     5334                                         ,v-node-code
     5335                                         ,buf_prop-map.node-name).
     5336             if buf_prop-ref.ref-type = 'period':U then do:
     5337               v-current-sum-id1 = entry(1, buf_prop-ref.sum-id, "-":U) + "-" + dct-algo-Date-to-String(v-today).
     5338               v-current-sum-id2 = dct-algo-Date-to-String(v-today) + "-" + entry(2, buf_prop-ref.sum-id, "-":U).
     5339               if v-current-sum-id1 <= buf_prop-ref.sum-id
     5340               and v-current-sum-id2 >= buf_prop-ref.sum-id
     5341               then do:
     5342                 leave _prop-ref.
     5343               end.
     5344             end.
     5345             else do:
     5346               if buf_prop-ref.sum-id = v-sum-id then leave _prop-ref.
     5347             end.
     5348           end.
     5349           if not available buf_prop-ref then do:
     5350             assign
     5351             p-sum-id-value = chr(63)
     5352             p-sum-id-output = no
     5353             .
     5354           end.
     5355         end.
     5356       end.
     5357     end.
     5358   end.
     5359   end procedure.
     5360   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5361   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5362   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
     5363   define variable v-date-str as character no-undo .
     5364   assign
     5365   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     5366                string(Month(p-date), "99":U) + chr(47) +
     5367                string(DAY(p-date), "99":U).
     5368   return v-date-str.
     5369   END FUNCTION.
     5370   function propreft-string-to-date returns date ( input p-string  as character):
     5371     define variable v-date as date no-undo .
     5372     assign
     5373     v-date = date(integer(substring(p-string, 6, 2))
     5374                   ,integer(substring(p-string, 9, 2))
     5375                   ,integer(substring(p-string, 1, 4))
     5376                  ) no-error .
     5377     if error-status:error then return ?.
     5378     return v-date.
     5379   END FUNCTION.
     5380   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
     5381   define variable v-date-str as character no-undo .
     5382   assign
     5383   v-date-str = substitute("petrol-&1", p-gds-code).
     5384   return v-date-str.
     5385   END FUNCTION.
     5386   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
     5387   define variable v-gds-code as integer no-undo .
     5388   assign
     5389   v-gds-code = integer(entry(2, p-string, "-")) no-error.
     5390   return v-gds-code.
     5391   END FUNCTION.
     5392   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5393   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5394   FUNCTION get-dpcn RETURNS CHARACTER (
     5395        input p-d-card as character
     5396       ,input p-emitent-host-code as integer
     5397       ,input p-type as character
     5398       ,input parhost-code as integer
     5399       ,input parobj-type as character
     5400       ,input parobj-code as integer
     5401       ,input p-node-code as integer
     5402       ,input p-d-pcnt as decimal
     5403       ,input p-cash-d-pcnt as decimal
     5404       ,input p-category as integer
     5405       ) :
     5406   define buffer buf_dis-card-type for ub.dis-card-type.
     5407   define variable loc-d-v as decimal no-undo init ?.
     5408   define variable v-discnt-role as character no-undo .
     5409   define buffer buf_dis-card-property for ub.dis-card-property.
     5410   find first buf_dis-card-type no-lock where
     5411             buf_dis-card-type.type = p-type
     5412         and buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5413         and buf_dis-card-type.host-code = 0
     5414         and buf_dis-card-type.obj-type = '':U
     5415         and buf_dis-card-type.obj-code = 0 no-error.
     5416   if available buf_dis-card-type then do:
     5417     case p-node-code:
     5418       when 1 then do:
     5419         assign
     5420         v-discnt-role = 'def-pcnt':U .
     5421       end.
     5422       when 2 then do:
     5423         assign
     5424         v-discnt-role = 'def-cash-pcnt':U.
     5425       end.
     5426       when 3 then do:
     5427         assign
     5428         v-discnt-role = 'def-categ':U.
     5429       end.
     5430     end case.
     5431     if buf_dis-card-type.d-pcnt-byshop then do:
     5432      find first buf_dis-card-property no-lock where
     5433                buf_dis-card-property.d-card = p-d-card
     5434            and buf_dis-card-property.dtm-code = 26
     5435            and buf_dis-card-property.host-code = parhost-code
     5436            and buf_dis-card-property.obj-type = parobj-type
     5437            and buf_dis-card-property.obj-code = parobj-code
     5438            and buf_dis-card-property.node-code = p-node-code no-error.
     5439      if available buf_dis-card-property then do:
     5440        if v-discnt-role = 'def-categ':U then do:
     5441          assign
     5442          loc-d-v = buf_dis-card-property.property-value-integer.
     5443        end.
     5444        else do:
     5445          assign
     5446          loc-d-v = buf_dis-card-property.property-value-decimal.
     5447        end.
     5448      end.
     5449      if loc-d-v = ? then do:
     5450   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5451   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5452     (
     5453      input  p-type
     5454     ,input  p-emitent-host-code
     5455     ,input  parhost-code
     5456     ,input  parobj-type
     5457     ,input  parobj-code
     5458     ,input  v-discnt-role
     5459     ,output loc-d-v
     5460     ) no-error .
     5461       end.
     5462       if loc-d-v = ? then do:
     5463         find first buf_dis-card-property no-lock where
     5464                   buf_dis-card-property.d-card = p-d-card
     5465               and buf_dis-card-property.dtm-code = 26
     5466               and buf_dis-card-property.host-code = parhost-code
     5467               and buf_dis-card-property.obj-type = ''
     5468               and buf_dis-card-property.obj-code = 0
     5469               and buf_dis-card-property.node-code = p-node-code no-error.
     5470         if available buf_dis-card-property then do:
     5471           if v-discnt-role = 'def-categ':U then do:
     5472             assign
     5473             loc-d-v = buf_dis-card-property.property-value-integer.
     5474           end.
     5475           else do:
     5476             assign
     5477             loc-d-v = buf_dis-card-property.property-value-decimal.
     5478           end.
     5479         end.
     5480       end.
     5481       if loc-d-v = ? then do:
     5482   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5484     (
     5485      input  p-type
     5486     ,input  p-emitent-host-code
     5487     ,input  parhost-code
     5488     ,input  ''
     5489     ,input  0
     5490     ,input  v-discnt-role
     5491     ,output loc-d-v
     5492     ) no-error .
     5493       end.
     5494       if loc-d-v = ? then do:
     5495         case v-discnt-role:
     5496           when 'def-categ':U then do:
     5497             loc-d-v = p-category.
     5498           end.
     5499           when 'def-pcnt':U then do:
     5500             loc-d-v = p-d-pcnt.
     5501           end.
     5502           when 'def-cash-pcnt':U then do:
     5503             loc-d-v = p-cash-d-pcnt.
     5504           end.
     5505         end case.
     5506       end.
     5507       if v-discnt-role = 'def-categ':U then do:
     5508         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     5509       end.
     5510       else do:
     5511         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     5512       end.
     5513     end.
     5514   end.
     5515   else do:
     5516    return "ОШИБКА-НЕТ ТИПА".
     5517   end.
     5518   case v-discnt-role:
     5519     when 'def-categ':U then do:
     5520        loc-d-v = p-category.
     5521        return string(loc-d-v, ">>>9").
     5522     end.
     5523     when 'def-pcnt':U then do:
     5524       loc-d-v = p-d-pcnt.
     5525       return string(loc-d-v, "->9.99%").
     5526     end.
     5527     when 'def-cash-pcnt':U then do:
     5528       loc-d-v = p-cash-d-pcnt.
     5529       return string(loc-d-v, "->9.99%").
     5530     end.
     5531   end case.
     5532   END FUNCTION.
     5533   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     5534   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5535   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     5536   procedure disrules-fill-properties:
     5537   define input  parameter p-templ-rl-root as integer   no-undo .
     5538   define buffer buf_drt-prop for ub.drt-prop.
     5539   define buffer buf_temp-drt-prop for temp-drt-prop.
     5540   do
     5541   on error undo, return error return-value
     5542   :
     5543     for each buf_temp-drt-prop:
     5544       delete buf_temp-drt-prop.
     5545     end.
     5546     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     5547       create buf_temp-drt-prop.
     5548       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     5549     end.
     5550   end.
     5551   end procedure.
     5552   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     5553   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     5554   procedure create-dis-rule :
     5555   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     5556   define input parameter p-tree as logical no-undo .
     5557   define buffer buf_dis-rule for ub.dis-rule.
     5558   define buffer buf_dis-time-rule for ub.dis-time-rule.
     5559   define buffer term_dis-rule for ub.dis-rule.
     5560   define buffer term_dis-time-rule for ub.dis-time-rule.
     5561   define buffer root_cash-dis-rule for cash-dis-rule.
     5562   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     5563   define buffer term_cash-dis-rule for cash-dis-rule.
     5564   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     5565     do
     5566     on error undo, return error
     5567     :
     5568       find first root_cash-dis-rule no-lock where                                                         ~
     5569                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     5570       if not available root_cash-dis-rule then do:
     5571         find first buf_dis-rule no-lock where
     5572                   buf_dis-rule.rule-num = p-rule-num no-error.
     5573         if available buf_dis-rule then do:
     5574           if buf_dis-rule.time-rule-num <> 0 then do:
     5575             find first buf_dis-time-rule no-lock where
     5576                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     5577           end.
     5578           create root_cash-dis-rule.
     5579           buffer-copy buf_dis-rule to root_cash-dis-rule.
     5580           if available buf_dis-time-rule then do:
     5581             find first root_cash-dis-time-rule no-lock where
     5582                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     5583             if not available root_cash-dis-time-rule then do:
     5584               create root_cash-dis-time-rule.
     5585               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     5586             end.
     5587           end.
     5588           else do:
     5589             assign
     5590             root_cash-dis-rule.time-rule-num = 0.
     5591           end.
     5592           if buf_dis-rule.uniq-field <> "":U then do:
     5593             for each term_dis-rule no-lock where
     5594                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     5595               if term_dis-rule.time-rule-num <> 0 then do:
     5596                 find first term_dis-time-rule no-lock where
     5597                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     5598               end.
     5599               create term_cash-dis-rule.
     5600               buffer-copy term_dis-rule to term_cash-dis-rule.
     5601               if term_dis-rule.time-rule-num = 0
     5602               or available term_dis-time-rule
     5603               or root_cash-dis-rule.time-rule-num = 0
     5604               then do:
     5605                 if available term_dis-time-rule then do:
     5606                   find first term_cash-dis-time-rule no-lock where
     5607                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     5608                   if not available term_cash-dis-time-rule then do:
     5609                     create term_cash-dis-time-rule.
     5610                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     5611                   end.
     5612                 end.
     5613               end.
     5614             end.
     5615           end.
     5616         end.
     5617       end.
     5618     end.
     5619   end procedure.
     5620   define shared temp-table dc-dis-card-mask no-undo like ub.dis-card-mask.
     5621   define shared temp-table dc-dis-card-mask-attr no-undo like ub.dis-card-mask-attr.
     5622   define variable ii as integer no-undo.
     5623   define variable conf-attr as character no-undo.
     5624   define variable conf-par as character no-undo.
     5625   define variable par-type as character no-undo.
     5626   DEFINE VARIABLE ind as integer no-undo .
     5627   DEFINE VARIABLE v-type as character no-undo .
     5628   define variable alllstcs as logical no-undo init no.
     5629   define variable v-curr-r-b as character no-undo .
     5630   define variable v-date-format as character no-undo .
     5631   define variable v-del-mrkt-cli as logical        no-undo .
     5632   define variable v-record as character no-undo .
     5633   define variable dr-list as character no-undo .
     5634   define variable drdcrank as character no-undo .
     5635   define variable v-magia-kat-codes-rule as integer no-undo .
     5636   define buffer for-shop for ub.shop.
     5637   define buffer for-clients for ub.clients.
     5638   define buffer lock-batchprocess for ub.batchprocess .
     5639   define buffer buf_cash-desk for ub.cash-desk.
     5640   define variable run-from as char no-undo.
     5641   define variable v-num as integer no-undo.
     5642   DEFINE VARIABLE var-report-num as integer no-undo .
     5643   DEFINE VARIABLE v-date as date no-undo .
     5644   DEFINE VARIABLE v-time as integer no-undo .
     5645   assign
     5646   i-obj-code = integer(entry(1, p-parameter, chr(4)))
     5647   action = entry(2, p-parameter, chr(4))
     5648   multiple-shops = (if entry(3, p-parameter, chr(4)) = "yes":U
     5649                    then yes
     5650                    else (if entry(3, p-parameter, chr(4)) = "no":U
     5651                          then no
     5652                          else ?)
     5653                    )
     5654   p-batch = (if entry(4, p-parameter, chr(4)) = "yes":U
     5655                    then yes
     5656                    else (if entry(4, p-parameter, chr(4)) = "no":U
     5657                          then no
     5658                          else ?)
     5659                    )
     5660   p-other = (if num-entries(p-parameter, chr(4)) >= 5
     5661             then entry(5, p-parameter, chr(4))
     5662             else '':U)
     5663   no-error
     5664   .
     5665   if error-status:error
     5666   or multiple-shops = ?
     5667   or p-batch = ?
     5668   then
     5669   return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5670   assign
     5671   v-del-mrkt-cli = lookup("del-mrkt-cli":U, p-other) > 0
     5672   .
     5673   run fill-temp-cd in this-procedure ( input g#db-num, input 'маг':U, input i-obj-code, input yes).
     5674   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5675   define variable v-param-type35 as character no-undo .
     5676   define variable v-value-character35 as date no-undo .
     5677   define variable v-value-date35 as date no-undo .
     5678   define variable v-value-decimal35 as decimal no-undo .
     5679   define variable v-value-integer35 as INTEGER no-undo .
     5680   define variable v-value-logical35 AS LOGICAL no-undo .
     5681   define variable v-tth35 as handle no-undo .
     5682   define variable cdpcknum as integer no-undo init 200.
     5683   run adm/shattri.p (
     5684       input "get":U
     5685       ,input  'маг':U
     5686       ,input  i-obj-code
     5687       ,input  'cd-sending':U
     5688       ,input  'cdpcknum':U
     5689       ,output v-value-character35
     5690       ,output v-value-date35
     5691       ,output v-value-decimal35
     5692       ,output cdpcknum
     5693       ,output v-value-logical35
     5694       ,output v-param-type35
     5695       ,INPUT-OUTPUT table-handle v-tth35
     5696       )  .
     5697   delete object v-tth35.
     5698   define variable p-obj-type as character no-undo.
     5699   p-obj-type = 'маг':U.
     5700   run adm/shattri.p (
     5701       input "get":U
     5702       ,input  'маг':U
     5703       ,input  i-obj-code
     5704       ,input  'cd-sending':U
     5705       ,input  'alllstcs':U
     5706       ,output v-value-character
     5707       ,output v-value-date
     5708       ,output v-value-decimal
     5709       ,output v-value-integer
     5710       ,output v-value-logical
     5711       ,output v-param-type
     5712       ,INPUT-OUTPUT table-handle v-tth
     5713       ) no-error .
     5714   IF not error-status:error
     5715   then do:
     5716     delete object v-tth.
     5717     alllstcs = v-value-logical.
     5718   end.
     5719   else do:
     5720     delete object v-tth.
     5721     return error return-value .
     5722   end.
     5723   assign
     5724   var-report-num = dynamic-next-value( "next-report":U, "ubflt":U)
     5725   .
     5726   FIND ub.shop WHERE ub.shop.obj-code = i-obj-code NO-LOCK .
     5727   FIND ub.sysconf WHERE ub.sysconf.host-code = ub.shop.host-code NO-LOCK .
     5728   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5730     (output v-curr-r-b
     5731     )  .
     5732   if action = "S":U then
     5733   assign
     5734   run-from = "S":U
     5735   action = "U":U.
     5736   if action = "O":U then
     5737   assign
     5738   run-from = "O":U
     5739   action = "U":U.
     5740   if action = "E":U then
     5741   assign
     5742   run-from = "E":U
     5743   action = "U":U.
     5744   if can-find(first cash-desk No-LOCK WHERE
     5745                     cash-desk.db-num = g#db-num and
     5746                     cash-desk.obj-code = i-obj-code AND
     5747                     cash-desk.cash-on = yes AND
     5748                     cash-desk.pos-type = 'IPC-Servis+':U) then do:
     5749     _lock-cli:
     5750     DO while ind < 100 :
     5751     run gbl/lock-prc.p
     5752         (input 'pcd2':U
     5753         ,input i-obj-code
     5754         ,input 0
     5755         ,input 0
     5756         ,input 'маг':U
     5757         ,input ""
     5758         ,input ""
     5759         ,input (
     5760                 "Код объекта" + ",,," +
     5761                 "Тип объекта" +  ",,,Передача диск. карт"
     5762               )
     5763         ,input no
     5764         ,buffer lock-batchprocess
     5765         ) no-error .
     5766       if not error-status:error then do:
     5767         leave _lock-cli.
     5768       end.
     5769     run write-log-and-file in p-log-handle (
     5770           input 1
     5771         , input log-file-name
     5772         , input 1
     5773         , input substitute( "Объект &1: Файл для выгрузки данных ЗАНЯТ - Ждите", i-obj-code
     5774                           )
     5775                                           ).
     5776       pause 1.
     5777     end.
     5778   end.
     5779   if can-find(first cash-desk No-LOCK WHERE
     5780                     cash-desk.db-num = g#db-num and
     5781                     cash-desk.obj-code = i-obj-code AND
     5782                     cash-desk.cash-on = yes AND
     5783                     cash-desk.pos-type = 'MAGIA-XML':U) then do:
     5784     find first buf_dis-thbj-rule no-lock where
     5785               buf_dis-thbj-rule.obj-type = ''
     5786            and buf_dis-thbj-rule.obj-code = 0
     5787            and buf_dis-thbj-rule.pos-type = 'MAGIA-XML':U
     5788            and buf_dis-thbj-rule.discnt-role = 'kateg-codes':U no-error .
     5789     if available buf_dis-thbj-rule then do:
     5790       v-magia-kat-codes-rule = buf_dis-thbj-rule.rule-num.
     5791       run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num, yes) no-error .
     5792     end.
     5793   end.
     5794   if v-del-mrkt-cli then do:
     5795     for each cash-cli:
     5796   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5797   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     5798   IF can-find( first temp-cd where temp-cd.pos-type = 'MARIA':U) then do:
     5799     for each buf_dis-dc-rule no-lock where
     5800               buf_dis-dc-rule.d-card = cash-cli.d-card
     5801           and buf_dis-dc-rule.host-code = ub.sysconf.host-code
     5802           and buf_dis-dc-rule.obj-type = 'маг':U
     5803           and buf_dis-dc-rule.obj-code = i-obj-code:
     5804       if buf_dis-dc-rule.discnt-role = 'debet-pay-pcnt-disc':U
     5805       or buf_dis-dc-rule.discnt-role = 'debet-pay-abs-disc':U
     5806       or buf_dis-dc-rule.discnt-role = 'debet-pay-qnty-disc':U
     5807       or buf_dis-dc-rule.discnt-role = 'debet-pay-sum-disc':U
     5808       or buf_dis-dc-rule.discnt-role = 'debet-pay-free-disc':U  then do:
     5809         assign
     5810         cash-cli.dcr-debet-pay = buf_dis-dc-rule.rule-num
     5811         no-error
     5812         .
     5813         leave.
     5814       end.
     5815     end.
     5816     for each buf_dis-dc-rule no-lock where
     5817               buf_dis-dc-rule.d-card = cash-cli.d-card
     5818           and buf_dis-dc-rule.host-code = ub.sysconf.host-code
     5819           and buf_dis-dc-rule.obj-type = 'маг':U
     5820           and buf_dis-dc-rule.obj-code = i-obj-code:
     5821       if buf_dis-dc-rule.discnt-role = 'credit-pay-pcnt-disc':U
     5822       or buf_dis-dc-rule.discnt-role = 'credit-pay-abs-disc':U
     5823       or buf_dis-dc-rule.discnt-role = 'credit-pay-qnty-disc':U
     5824       or buf_dis-dc-rule.discnt-role = 'credit-pay-sum-disc':U
     5825       or buf_dis-dc-rule.discnt-role = 'credit-pay-free-disc':U  then do:
     5826         assign
     5827         cash-cli.dcr-credit-pay = buf_dis-dc-rule.rule-num
     5828         no-error
     5829         .
     5830       end.
     5831     end.
     5832   end.
     5833     end.
     5834     find last cash-cli use-index pi no-error .
     5835     if available cash-cli then do:
     5836       cr = cash-cli.crf + 1.
     5837     end.
     5838   end.
     5839   if g#news
     5840   or g#esys
     5841   OR run-from = "S":U
     5842   or run-from = "O":U
     5843   or run-from = "E":U
     5844   then do:
     5845     FOR EACH dc-list NO-LOCK,
     5846         FIRST dis-card no-lock where
     5847               dis-card.d-card = dc-list.d-card,
     5848         first clients no-lock where
     5849               clients.obj-type = dis-card.cli-type
     5850           AND  clients.obj-code = dis-card.cli-code,
     5851         FIRST ub.dis-card-type No-LOCK WHERE
     5852               ub.dis-card-type.type = dis-card.type AND
     5853               ub.dis-card-type.emitent-host-code = dis-card.emitent-host-code AND
     5854               ub.dis-card-type.host-code = 0 AND
     5855               ub.dis-card-type.obj-type = "":U AND
     5856               ub.dis-card-type.obj-code = 0 :
     5857       if dis-card.emitent-host-code <> 0 and
     5858         dis-card.emitent-host-code <> ub.shop.host-code then NEXT.
     5859       ii = ii + 1.
     5860   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5861   FIND FIRST cash-cli where cash-cli.crf = (cr + 1) No-ERROR.
     5862   start-paket = no.
     5863   if not avail cash-cli then
     5864   create cash-cli.
     5865   else do:
     5866     assign
     5867     cash-cli.cli-adr   = ""
     5868     cash-cli.cli-adr2  = ""
     5869     cash-cli.director  = ""
     5870     cash-cli.engl-name = ""
     5871     cash-cli.telex     = "":U
     5872     cash-cli.phone1-note  = "":U
     5873     cash-cli.post-addr1 = "":U
     5874     cash-cli.post-addr2 = "":U
     5875     cash-cli.phone1  = "":U
     5876     cash-cli.post-box  = ""
     5877     cash-cli.valid-date = 12/31/9999
     5878     cash-cli.property-value-chr[1] = '':U
     5879     cash-cli.property-value-chr[2] = '':U
     5880     cash-cli.property-value-chr[3] = '':U
     5881     cash-cli.property-value-chr[4] = '':U
     5882     cash-cli.dcr-pcnt        = 0
     5883     cash-cli.dcr-abs         = 0
     5884     cash-cli.dcr-pcnt-qnty   = 0
     5885     cash-cli.dcr-pcnt-tot    = 0
     5886     cash-cli.ef-format       = 0
     5887     cash-cli.ef-access-key   = ""
     5888     cash-cli.has-attrs       = no
     5889     cash-cli.has-attrs-lim   = no
     5890     .
     5891   end.
     5892   error-status:error = false.
     5893   cash-cli.crf = cr + 1.
     5894   cr = cr + 1.
     5895   if ub.clients.obj-type = 'орг':U then do:
     5896     FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code .
     5897     assign
     5898     cash-cli.cli-type = 'орг':U
     5899     cash-cli.cli-code = ub.clients.obj-code
     5900     cash-cli.cli-city = ub.firm.city
     5901     cash-cli.cli-adr = trim( ub.firm.addres1 )
     5902     cash-cli.cli-adr2 = trim( ub.firm.addres2 )
     5903     cash-cli.director = trim( ub.firm.director )
     5904     cash-cli.e-mail = trim( ub.firm.e-mail )
     5905     cash-cli.engl-name = trim( ub.firm.engl-name)
     5906     cash-cli.fax     = trim( ub.firm.fax)
     5907     cash-cli.telex     = trim( ub.firm.telex)
     5908     cash-cli.position  = trim( ub.firm.head-position)
     5909     cash-cli.is-pboul  = ub.firm.is-pboul
     5910     cash-cli.okonh     = trim(ub.firm.okonh)
     5911     cash-cli.okpo      = trim(ub.firm.okpo)
     5912     cash-cli.phone1-note  = trim(ub.firm.phone1-note)
     5913     cash-cli.post-addr1 = trim( ub.firm.post-addr1 )
     5914     cash-cli.post-addr2 = trim( ub.firm.post-addr2 )
     5915     cash-cli.cli-inn = trim(ub.firm.inn)
     5916     cash-cli.cli-phone = trim(ub.firm.phone)
     5917     cash-cli.cli-ind = ub.firm.ind
     5918     cash-cli.justface = 1
     5919     cash-cli.kpp     = ub.firm.kpp
     5920     .
     5921   end.
     5922   else do:
     5923     if ub.clients.obj-type = 'чел':U then do:
     5924       FIND ub.person WHERE ub.person.psn-code = ub.clients.obj-code .
     5925       assign
     5926       cash-cli.cli-type = 'чел':U
     5927       cash-cli.cli-code = ub.clients.obj-code
     5928       cash-cli.cli-city = ub.person.city
     5929       cash-cli.cli-adr = trim( ub.person.address )
     5930       cash-cli.cli-inn = trim(ub.person.inn)
     5931       cash-cli.cli-phone = trim(ub.person.phone1)
     5932       cash-cli.cli-ind = ub.person.ind
     5933       cash-cli.phone1  = trim(ub.person.phone1)
     5934       cash-cli.e-mail = trim( ub.person.e-mail )
     5935       cash-cli.fax     = trim( ub.person.fax)
     5936       cash-cli.position  = trim( ub.person.position)
     5937       cash-cli.is-pboul  = ub.person.is-pboul
     5938       cash-cli.okonh     = trim(ub.person.okonh)
     5939       cash-cli.okpo      = trim(ub.person.okpo)
     5940       cash-cli.post-box  = trim(ub.person.post-box)
     5941       cash-cli.justface = 0
     5942       cash-cli.kpp     = ub.person.kpp
     5943       .
     5944     end.
     5945     else do:
     5946       NEXT .
     5947     end.
     5948   end.
     5949   assign
     5950   cash-cli.mask-card     = ub.dis-card.mask-card
     5951   cash-cli.current-saldo =  (if ub.dis-card.credit-card = yes
     5952                               then (if v-curr-r-b = 'base':U
     5953                                     then ub.dis-card.saldo-base
     5954                                     else ub.dis-card.saldo-rubl)
     5955                               else 0)
     5956   cash-cli.current-saldo-rubl = ub.dis-card.saldo-rubl
     5957   cash-cli.current-saldo-base = ub.dis-card.saldo-base
     5958   cash-cli.lim-kr = (if ub.dis-card.credit-card = yes
     5959                       then ub.dis-card.lim-kr
     5960                       else 0)
     5961   cash-cli.d-pcnt = ub.dis-card.d-pcnt
     5962   cash-cli.kat-pcnt = ub.dis-card.category
     5963   cash-cli.h-ka = (if ub.dis-card.category > 0 then 2 else 0)
     5964   cash-cli.cash-d-pcnt = ub.dis-card.cash-d-pcnt
     5965   cash-cli.d-pcnt-method = ub.dis-card.d-pcnt-method
     5966   cash-cli.status_ = ub.dis-card.status_
     5967   cash-cli.d-card = ub.dis-card.d-card
     5968   cash-cli.issue-code = ub.dis-card.issue-code
     5969   cash-cli.issue-date = ub.dis-card.issue-date
     5970   cash-cli.type = ub.dis-card.type
     5971   cash-cli.emitent-host-code = ub.dis-card.emitent-host-code
     5972   cash-cli.d-pcnt-byshop = ub.dis-card-type.d-pcnt-byshop
     5973   cash-cli.cli-status_ = ub.clients.stts
     5974   cash-cli.card-media = ub.dis-card-type.card-media
     5975   cash-cli.credit-card = ub.dis-card.credit-card
     5976   cash-cli.debet-card = ub.dis-card.debet-card
     5977   cash-cli.staff-card = ub.dis-card.staff-card
     5978   cash-cli.cli-message = ub.dis-card.cli-message
     5979   cash-cli.fiscal-pay = (if cash-cli.debet-card
     5980                           or cash-cli.credit-card
     5981                           then  ub.dis-card-type.fiscal-pay
     5982                           else no)
     5983   cash-cli.pay-code = ub.dis-card-type.pay-code
