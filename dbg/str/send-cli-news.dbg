     5989   .
     5990   if cash-cli.card-media = integer('5':U) then do:
     5991     find first buf_Dis-card-property no-lock where
     5992               buf_Dis-card-property.d-card = cash-cli.d-card
     5993          and buf_Dis-card-property.dtm-code = integer(25)
     5994          and buf_Dis-card-property.node-code = integer(4)
     5995          and buf_Dis-card-property.host-code = 0
     5996          and buf_Dis-card-property.obj-type = ''
