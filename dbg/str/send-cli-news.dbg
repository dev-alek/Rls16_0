     2155                           .
     2156                       end.
     2157                       when chr(29)
     2158                       then do:
     2159                           assign
     2160                               p-out-string = p-out-string + " ":U
     2161                           .
     2162                       end.
     2163                       when chr(10)
     2164                       then do:
     2165                           assign
     2166                               p-out-string = p-out-string + " ":U
     2167                           .
     2168                       end.
     2169                       when chr(13)
     2170                       then do:
     2171                           assign
     2172                               p-out-string = p-out-string + " ":U
     2173                           .
     2174                       end.
     2175                       otherwise do:
     2176                           assign
     2177                               p-out-string = p-out-string + v-current-char
     2178                           .
     2179                       end.
     2180                   end case.
     2181               end.
     2182           end.
     2183       end case.
     2184   end.
     2185   end .
     2186   procedure xmlchar-decode :
     2187   define input parameter p-in-string      as character        no-undo.
     2188   define output parameter p-out-string    as character        no-undo.
     2189       define variable v-position      as integer      no-undo.
     2190       define variable v-last-position as integer      no-undo.
     2191       define variable v-temp-integer  as integer      no-undo.
     2192       define variable v-current-char  as character    no-undo.
     2193       define variable v-next-char     as character    no-undo.
     2194       define variable v-success       as logical      no-undo.
     2195   do
     2196   on error undo, return error
     2197   :
     2198       assign
     2199           p-out-string = "":U
     2200           v-position   = 0
     2201       .
     2202       replace-cycle:
     2203       do while yes
     2204       on error undo, return error
     2205       :
     2206           assign
     2207               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2208           .
     2209           if v-last-position <= v-position
     2210           then do:
     2211               if v-position = 0
     2212               then do:
     2213                   assign
     2214                       p-out-string = p-in-string
     2215                   .
     2216               end.
     2217               else do:
     2218                   assign
     2219                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2220                   .
     2221               end.
     2222               leave replace-cycle.
     2223           end.
     2224           else do:
     2225               assign
     2226                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2227                   v-position      = v-last-position
     2228                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2229               .
     2230               if v-current-char = "#":U
     2231               then do:
     2232                   assign
     2233                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2234                   .
     2235                   if v-last-position > 0
     2236                   then do:
     2237                       run xmlchar-read-integer in this-procedure
     2238                        (
     2239                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2240                           , output v-temp-integer
     2241                           , output v-success
     2242                       ).
     2243                       if v-success = yes
     2244                       and v-temp-integer >= 1
     2245                       and v-temp-integer <= 255
     2246                       then do:
     2247                           assign
     2248                               p-out-string = p-out-string + chr( v-temp-integer )
     2249                               v-position   = v-last-position + 1
     2250                           .
     2251                       end.
     2252                       else do:
     2253                           assign
     2254                               p-out-string = p-out-string + "&":U
     2255                               v-position   = v-position   + 1
     2256                           .
     2257                       end.
     2258                   end.
     2259                   else do:
     2260                       assign
     2261                           p-out-string = p-out-string + "&":U
     2262                           v-position   = v-position   + 1
     2263                       .
     2264                   end.
     2265               end.
     2266               else do:
     2267                   case substring( p-in-string, v-position + 1, 3 )
     2268                   :
     2269                       when "lt;":U
     2270                       then do:
     2271                           assign
     2272                               p-out-string = p-out-string + "<":U
     2273                               v-position   = v-position   + 3
     2274                           .
     2275                       end.
     2276                       when "gt;":U
     2277                       then do:
     2278                           assign
     2279                               p-out-string = p-out-string + ">":U
     2280                               v-position   = v-position   + 3
     2281                           .
     2282                       end.
     2283                       otherwise do:
     2284                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2285                           then do:
     2286                               assign
     2287                                   p-out-string = p-out-string + "&":U
     2288                                   v-position   = v-position   + 4
     2289                               .
     2290                           end.
     2291                           else do:
     2292                               case substring( p-in-string, v-position + 1, 5 )
     2293                               :
     2294                                   when "quot;":U
     2295                                   then do:
     2296                                       assign
     2297                                           p-out-string = p-out-string + '"':U
     2298                                           v-position   = v-position   + 5
     2299                                       .
     2300                                   end.
     2301                                   when "apos;":U
     2302                                   then do:
     2303                                       assign
     2304                                           p-out-string = p-out-string + "'":U
     2305                                           v-position   = v-position   + 5
     2306                                       .
     2307                                   end.
     2308                                   otherwise do:
     2309                                       assign
     2310                                           p-out-string = p-out-string + "&":U
     2311                                       .
     2312                                   end.
     2313                               end case.
     2314                           end.
     2315                       end.
     2316                   end case.
     2317               end.
     2318           end.
     2319       end.
     2320   end.
     2321   end .
     2322   procedure xmlchar-read-integer :
     2323   define input parameter p-input-string      as character        no-undo.
     2324   define output parameter p-output-integer   as integer          no-undo.
     2325   define output parameter p-success       as logical          no-undo.
     2326   do
     2327   on error undo, return error
     2328   :
     2329       assign
     2330           p-output-integer = integer( p-input-string )
     2331       no-error.
     2332       if error-status :error
     2333       then do:
     2334           assign
     2335               p-success           = no
     2336               p-output-integer    = 0
     2337           .
     2338       end.
     2339       else do:
     2340           assign
     2341               p-success           = yes
     2342           .
     2343       end.
     2344   end.
     2345   end.
     2346   define variable v-bgelib-bgeclall           as logical      no-undo.
     2347   define variable v-bgelib-bgedict            as logical      no-undo.
     2348   define temp-table temp_ext-doc-type no-undo
     2349       field edt-key               as integer
     2350       field ext-doc-type          as character
     2351       field ext-doc-type-label    as character
     2352       index pi is primary unique
     2353           edt-key
     2354   .
