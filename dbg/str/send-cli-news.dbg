     2374   .
     2375   procedure bgelib-tag-open:
     2376   do
     2377   on error undo, return error
     2378   :
     2379   define input parameter v-tag-level  as integer      no-undo.
     2380   define input parameter v-tag-name   as character    no-undo.
     2381   define input parameter v-tag-value  as character    no-undo.
     2382       put stream stmXMLOut unformatted
     2383           chr(10)
     2384           + fill(" ", 4 * v-tag-level)
     2385           + "<" + v-tag-name
     2386           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2387           + v-tag-value + ">"
     2388       .
     2389   end.
     2390   end procedure.
     2391   procedure bgelib-tag-put:
     2392   do
     2393   on error undo, return error
     2394   :
     2395   define input parameter v-tag-level      as integer      no-undo.
     2396   define input parameter v-tag-name       as character    no-undo.
     2397   define input parameter v-tag-value      as character    no-undo.
     2398   define input parameter v-empty-mode     as integer      no-undo.
     2399       v-tag-name = trim(v-tag-name).
     2400       if  v-empty-mode = 1
     2401       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2402       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2403       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2404       then do:
     2405           run xmlchar-encode in this-procedure (
     2406                 input v-tag-value
     2407               , output v-tag-value
     2408           ).
     2409           put stream stmXMLOut unformatted
     2410               chr(10) + fill(" ", 4 * v-tag-level)
     2411                           + '<' + v-tag-name + '>'
     2412                           + v-tag-value
     2413                           + '</' + v-tag-name + '>'
     2414           .
     2415       end.
     2416   end.
     2417   end procedure.
     2418   procedure bgelib-tag-close:
     2419   do
     2420   on error undo, return error
     2421   :
     2422   define input parameter v-tag-level as integer      no-undo.
     2423   define input parameter v-tag-name  as character    no-undo.
     2424       put stream stmXMLOut unformatted
     2425           chr(10)
     2426           + fill( " ", 4 * v-tag-level)
     2427           + '</' + v-tag-name + '>'
     2428       .
     2429   end.
     2430   end procedure.
     2431   procedure bgelib-write-log:
     2432   do
     2433   on error undo, return error
     2434   :
     2435   define input parameter v-filename   as character    no-undo.
     2436   define input parameter v-log-level  as integer      no-undo.
     2437   define input parameter v-out-string as character    no-undo.
     2438       output stream stmXMLLog to value( v-filename ) append.
     2439       put stream stmXMLLog unformatted
     2440           chr(10)
     2441       .
     2442       put stream stmXMLLog unformatted
     2443           ( if v-log-level = 0
     2444             or v-out-string = "&DLine"
     2445             or v-out-string = "&Line"
     2446             then ""
     2447             else cur-time-string-sec() + " " )
     2448       .
     2449       put stream stmXMLLog unformatted
     2450           ( if v-out-string = "&Line"
     2451             then fill( "-", 80 )
     2452             else if v-out-string = "&DLine"
     2453                  then fill( "=", 80 )
     2454                  else v-out-string )
     2455       .
     2456       output stream stmXMLLog close.
     2457   end.
     2458   end procedure.
     2459   procedure bgelib-write-edt:
     2460   do
     2461   on error undo, return error
     2462   :
     2463   define input parameter v-editor-handle    as handle       no-undo.
     2464   define input parameter v-log-level        as integer      no-undo.
     2465   define input parameter v-out-string       as character    no-undo.
     2466       if valid-handle ( v-editor-handle )
     2467       then do:
     2468           v-editor-handle :move-to-eof().
     2469           v-editor-handle :insert-string( ( if v-log-level = 0
     2470                                             or v-out-string = "&DLine"
     2471                                             or v-out-string = "&Line"
     2472                                             then ""
     2473                                             else cur-time-string-sec() + " "
     2474                                         ) ).
     2475           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2476                                             then fill( "-", 80 )
     2477                                             else if v-out-string = "&DLine" then fill("=", 80)
     2478                                             else fill( " ", v-log-level) + v-out-string
     2479                                         ) ).
     2480           v-editor-handle :insert-string( chr(10) ).
     2481       end.
     2482       process events.
     2483       output to 'bgescn.txt' append.
     2484           put unformatted
     2485               chr(10)
     2486               string( ( if v-log-level = 0
     2487                         or v-out-string = "&DLine"
     2488                         or v-out-string = "&Line"
     2489                         then ""
     2490                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2491                     ) )
     2492               string( ( if v-out-string = "&Line"
     2493                         then fill( "-", 80 )
     2494                         else if v-out-string = "&DLine"
     2495                              then fill( "=", 80 )
     2496                              else fill( " ", v-log-level ) + v-out-string
     2497                     ) )
     2498           .
     2499       output close.
     2500   end.
     2501   end procedure.
     2502   procedure bgelib-show-cnt:
     2503   do
     2504   on error undo, return error
     2505   :
     2506   define input parameter v-fillin-handle     as handle   no-undo.
     2507       if valid-handle( v-fillin-handle )
     2508       then do:
     2509           assign
     2510               v-fillin-handle :visible = true
     2511           .
     2512       end.
     2513   end.
     2514   end procedure.
     2515   procedure bgelib-hide-cnt:
     2516   do
     2517   on error undo, return error
     2518   :
     2519   define input parameter v-fillin-handle     as handle   no-undo.
     2520       if valid-handle( v-fillin-handle )
     2521       then do:
     2522           assign v-fillin-handle :visible = false.
     2523       end.
     2524   end.
     2525   end procedure.
     2526   procedure bgelib-write-cnt:
     2527   do
     2528   on error undo, return error
     2529   :
     2530   define input parameter v-fillin-handle    as handle       no-undo.
     2531   define input parameter v-fillin-string    as character    no-undo.
     2532       if valid-handle( v-fillin-handle )
     2533       then do:
     2534           assign
     2535               v-fillin-handle :SCREEN-value = v-fillin-string
     2536           .
     2537       end.
     2538   end.
     2539   end procedure.
     2540   procedure bgelib-write-header:
     2541   do
     2542   on error undo, return error
     2543   :
     2544   define input parameter p-first-file     as logical      no-undo.
     2545   define input parameter p-xml-file-name  as character    no-undo.
     2546   define input parameter p-list-file-name as character    no-undo.
     2547   define input parameter p-file-number    as integer      no-undo.
     2548   define input parameter p-have-prev      as logical      no-undo.
     2549   define input parameter p-prev-filename  as character    no-undo.
     2550   define input parameter p-obj-list       as character    no-undo.
     2551   define input parameter p-doc-type-list  as character    no-undo.
     2552   define input parameter p-parameter-list as character    no-undo.
     2553       define variable v-counter    as integer        no-undo.
     2554       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2555       put stream stmXMLOut unformatted
     2556           "<?xml version='1.0' encoding='windows-1251'?>"
     2557       .
     2558       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2559       run bgelib-tag-open( input 0, input "header", input "" ).
     2560       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2561       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2562       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2563       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2564       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2565       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2566       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2567       :
     2568           run bgelib-tag-put(
     2569                 input 1
     2570               , input entry( 2 * v-counter, p-parameter-list )
     2571               , input entry( 2 * v-counter + 1, p-parameter-list )
     2572               , input 0
     2573           ).
     2574       end.
     2575       run bgelib-tag-close( input 0, input "header" ).
     2576       output stream stmXMLOut close.
     2577       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2578       if p-first-file = yes
     2579       then do:
     2580           put stream stmXMLOut unformatted
     2581               "<?xml version='1.0' encoding='windows-1251'?>"
     2582           .
     2583           run bgelib-tag-open( input 0, input "export", input "" ).
     2584       end.
     2585       run bgelib-tag-open( input 1, input "file", input "" ).
     2586       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2587       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2588       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2589       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2590       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2591       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2592       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2593       :
     2594           run bgelib-tag-put(
     2595                 input 2
     2596               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2597               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2598               , input 0
     2599           ).
     2600       end.
     2601       run bgelib-tag-close( input 1, input "file" ).
     2602       output stream stmXMLOut close.
     2603   end.
     2604   end procedure.
     2605   procedure bgelib-write-footer:
     2606   do
     2607   on error undo, return error
     2608   :
     2609   define input parameter p-last-file      as logical      no-undo.
     2610   define input parameter p-xml-file-name  as character    no-undo.
     2611   define input parameter p-list-file-name as character    no-undo.
     2612   define input parameter p-have-next      as logical      no-undo.
     2613   define input parameter p-next-file-name as character    no-undo.
     2614       define variable v-error-num     as integer           no-undo.
     2615       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2616       if p-have-next = yes
     2617       then do:
     2618           run bgelib-tag-open( input 0, input "footer", "" ).
     2619           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2620           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2621           run bgelib-tag-close( input 0, input "footer" ).
     2622       end.
     2623       run bgelib-tag-close( input 0, input "root" ).
     2624       output stream stmXMLOut close.
     2625       run bge/os_copy.p (
     2626             input "M"
     2627           , input p-xml-file-name + "tmp"
     2628           , input p-xml-file-name + "xml"
     2629           , output v-error-num
     2630       ).
     2631       if p-last-file = yes
     2632       then do:
     2633           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2634               run bgelib-tag-close( input 0, input "export" ).
     2635           output stream stmXMLOut close.
     2636           run bge/os_copy.p (
     2637                 input "M"
     2638               , input p-list-file-name + "tmp"
     2639               , input p-list-file-name + "xml"
     2640               , output v-error-num
     2641           ).
     2642       end.
     2643   end.
     2644   end procedure.
     2645   procedure bgelib-filename :
     2646   do
     2647   on error undo, return error
     2648   :
     2649   define input parameter p-prefix             as character    no-undo.
     2650   define output parameter p-xml-file-name     as character    no-undo.
     2651   define output parameter p-log-file-name     as character    no-undo.
     2652   define output parameter p-list-file-name    as character    no-undo.
     2653       define variable v-home-dir  as character    no-undo.
     2654       define variable v-error-num as integer      no-undo.
     2655       get-key-value section "BGE" key "outdir" value v-home-dir.
     2656       if v-home-dir = ?
     2657       then do:
     2658           message
     2659             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2660             skip(1)
     2661             skip "Обратитесь к администратору."
     2662           view-as alert-box error.
     2663           undo, return error .
     2664       end.
     2665       run gbl/dir-cre.p (
     2666           input v-home-dir
     2667       ) no-error.
     2668       if error-status :error
     2669       then do:
     2670           message
     2671             skip "Неверно задан каталог экспорта."
     2672             skip(1)
     2673             skip "Обратитесь к администратору."
     2674           view-as alert-box error.
     2675           undo, return error .
     2676       end.
     2677       run bge/genfname.p (
     2678             input v-home-dir
     2679           , input p-prefix
     2680           , input ""
     2681           , input "xml"
     2682           , input "tmp"
     2683           , output p-xml-file-name
     2684       ).
     2685       assign
     2686           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2687           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2688           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2689       .
     2690   end.
     2691   end procedure.
     2692   procedure bgelib-read-config :
     2693   do
     2694   on error undo, return error
     2695   :
     2696   define variable v-par-type as character     no-undo.
     2697     define variable v-param-type      as character  no-undo .
     2698     define variable v-value-character as character  no-undo .
     2699     define variable v-value-date      as date       no-undo .
     2700     define variable v-value-decimal   as decimal    no-undo .
     2701     define variable v-value-integer   as integer    no-undo .
     2702     define variable v-value-logical   as logical    no-undo .
     2703     define variable v-tth             as handle     no-undo .
     2704       assign
     2705           v-bgelib-bgeclall = no
     2706           v-bgelib-bgedict  = no
     2707       .
     2708       run adm/shattri.p ( input "get":U
     2709                         , input  '':u
     2710                         , input  0
     2711                         , input  'bge-export':U
     2712                         , input  'bgeclall':U
     2713                         , output v-value-character
     2714                         , output v-value-date
     2715                         , output v-value-decimal
     2716                         , output v-value-integer
     2717                         , output v-value-logical
     2718                         , output v-param-type
     2719                         , input-output table-handle v-tth
     2720                         ) no-error .
     2721       if error-status :error
     2722       then do:
     2723         assign
     2724           v-bgelib-bgeclall = no
     2725         .
     2726       end.
     2727       else do:
     2728         assign
     2729           v-bgelib-bgeclall = v-value-logical
     2730         .
     2731       end.
     2732       delete object v-tth.
     2733       run adm/shattri.p ( input "get":U
     2734                         , input  '':u
     2735                         , input  0
     2736                         , input  'bge-export':U
     2737                         , input  'bgedict':U
     2738                         , output v-value-character
     2739                         , output v-value-date
     2740                         , output v-value-decimal
     2741                         , output v-value-integer
     2742                         , output v-value-logical
     2743                         , output v-param-type
     2744                         , input-output table-handle v-tth
     2745                         ) no-error .
     2746       if error-status :error
     2747       then do:
     2748         assign
     2749           v-bgelib-bgedict = no
     2750         .
     2751       end.
     2752       else do:
     2753         assign
     2754           v-bgelib-bgedict = v-value-logical
     2755         .
     2756       end.
     2757       delete object v-tth.
     2758       run adm/shattri.p ( input "get":U
     2759                         , input  '':u
     2760                         , input  0
     2761                         , input  'bge-export':U
     2762                         , input  'bgefmt':U
     2763                         , output v-value-character
     2764                         , output v-value-date
     2765                         , output v-value-decimal
     2766                         , output v-value-integer
     2767                         , output v-value-logical
     2768                         , output v-param-type
     2769                         , input-output table-handle v-tth
     2770                         ) no-error .
     2771       if error-status :error
     2772       then do:
     2773         assign
     2774           v-bgelib-bgefmt  = "xml":U
     2775         .
     2776       end.
     2777       else do:
     2778         assign
     2779           v-bgelib-bgefmt  = v-value-character
     2780         .
     2781       end.
     2782       delete object v-tth.
     2783       run adm/shattri.p ( input "get":U
     2784                         , input  '':u
     2785                         , input  0
     2786                         , input  'bge-export':U
     2787                         , input  'bgeflold':U
     2788                         , output v-value-character
     2789                         , output v-value-date
     2790                         , output v-value-decimal
     2791                         , output v-value-integer
     2792                         , output v-value-logical
     2793                         , output v-param-type
     2794                         , input-output table-handle v-tth
     2795                         ) no-error .
     2796       if error-status :error
     2797       then do:
     2798         assign
     2799           v-bgelib-bgeflold  = "old":U
     2800         .
     2801       end.
     2802       else do:
     2803         assign
     2804           v-bgelib-bgeflold  = v-value-character
     2805         .
     2806       end.
     2807       delete object v-tth.
     2808   end.
     2809   end procedure.
     2810   procedure bgelib-check-file-size :
     2811   do
     2812   on error undo, return error
     2813   :
     2814   define input parameter p-out-filename   as character    no-undo.
     2815   define output parameter p-is-big        as logical      no-undo.
     2816       define variable v-current-position    as integer        no-undo.
     2817       assign
     2818           v-current-position = seek( stmXMLOut )
     2819       .
     2820       if v-current-position / 1024 / 1024  >= 100
     2821       then do:
     2822           assign
     2823               p-is-big = yes
     2824           .
     2825       end.
     2826   end.
     2827   end procedure.
     2828   procedure bgelib-init-ext-doc-type :
     2829       define variable v-counter    as integer      no-undo.
     2830       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2831   do
     2832   for buf_temp_ext-doc-type
     2833   on error undo, return error
     2834   :
     2835       empty temp-table buf_temp_ext-doc-type.
     2836       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2837       :
     2838           create buf_temp_ext-doc-type.
     2839           assign
     2840               buf_temp_ext-doc-type.edt-key               = v-counter
     2841               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2842               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2843           .
     2844       end.
     2845   end.
     2846   end procedure.
     2847   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2848   define variable v-xml-file-name     as character            no-undo.
     2849   define variable v-xml-file-name-path as character            no-undo.
     2850   define variable v-log-file-name     as character            no-undo.
     2851   define variable v-locked            as logical              no-undo.
     2852   define variable v-log-string        as character            no-undo.
     2853   define variable v-oper-num          as integer              no-undo.
     2854   define variable v-obj-list          as character            no-undo.
     2855   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2856   DEF VAR intRep      AS INT NO-UNDO.
     2857   define variable hEDT             AS HANDLE NO-UNDO.
     2858   define variable hCNT             AS HANDLE NO-UNDO.
     2859   procedure xml-cd-write-header:
     2860   do
     2861   on error undo, return error
     2862   :
     2863   define input parameter p-xml-file-name       as character    no-undo.
     2864   define input parameter p-xml-file-name-path  as character    no-undo.
     2865   define input parameter p-doc-name            as character    no-undo.
     2866   define input parameter p-version             as character    no-undo.
     2867   define input parameter p-obj-list            as character    no-undo.
     2868   define input parameter p-correspondent       as character    no-undo .
     2869   define input parameter p-write-header        as logical      no-undo .
     2870   define variable OS-time as character no-undo .
     2871   define variable id as character no-undo .
     2872   define buffer buf_db for ub.db.
     2873   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2874   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2875   assign
     2876   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2877   .
     2878   run bgelib-tag-open in this-procedure (
     2879                                        1
     2880                                       ,p-doc-name
     2881                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2882                                         ).
     2883   if p-write-header then do:
     2884     run bgelib-tag-open(2, "Header","").
     2885     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2886     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2887     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2888     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2889     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2890     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2891     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2892     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2893     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2894     run bgelib-tag-close( 2, "Header" ).
     2895   end.
     2896   output stream stmXMLOut close.
     2897   end.
     2898   end procedure.
     2899   procedure xml-cd-write-footer:
     2900   do
     2901   on error undo, return error
     2902   :
     2903   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2904   define input parameter p-xml-file-name as character    no-undo.
     2905   define input parameter p-doc-name      as character    no-undo .
     2906   define variable v-error-num     as integer           no-undo.
     2907   define variable v-md5-signature as character no-undo .
     2908   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2909   run bgelib-tag-close( 0, p-doc-name ).
     2910   put stream stmXMLOut unformatted skip.
     2911   output stream stmXMLOut close.
     2912   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2913   if v-error-num > 0
     2914   then do:
     2915      return error.
     2916   end.
     2917   if opsys = "unix"
     2918   then do:
     2919       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2920   end.
     2921   end.
     2922   end procedure.
     2923   procedure xml-cd-filename :
     2924   do
     2925   on error undo, return error
     2926   :
     2927   define input parameter  p-out               as character no-undo .
     2928   define output parameter p-xml-file-name     as character    no-undo.
     2929   define output parameter p-xml-file-name-path   as character    no-undo.
     2930   define output parameter p-log-file-name     as character    no-undo.
     2931   define output parameter p-locked            as logical      no-undo.
     2932   define variable v-out as character     no-undo.
     2933   define variable loc#log as logical no-undo .
     2934   define variable BadFlag as logical no-undo .
     2935   define variable fq as integer no-undo .
     2936   define variable v-remote as character no-undo .
     2937   assign
     2938   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2939   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2940   p-log-file-name = p-out + "actions.log"
     2941   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2942   .
     2943   end.
     2944   end procedure.
     2945   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2946   define variable v-date-str as character no-undo .
     2947   assign
     2948   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2949                string(Month(p-date), "99":U) + "-":U +
     2950                string(DAY(p-date), "99":U).
     2951   return v-date-str.
     2952   END FUNCTION.
     2953   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2954   define variable v-date-str as character no-undo .
     2955   assign
     2956   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2957                string(Month(p-date), "99":U) + "-":U +
     2958                string(DAY(p-date), "99":U) + chr(32) +
     2959                string(p-time, "HH:MM:SS").
     2960   return v-date-str.
     2961   END FUNCTION.
     2962   function string-to-date returns date ( input p-string  as character):
     2963     define variable v-date as date no-undo .
     2964     assign
     2965     v-date = date(integer(substring(p-string, 4, 2))
     2966                   ,integer(substring(p-string, 1, 2))
     2967                   ,integer(substring(p-string, 7, 4))
     2968                  ) no-error .
     2969     if error-status:error then return ?.
     2970     return v-date.
     2971   END FUNCTION.
     2972   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2973   define variable v-time as integer no-undo init ?.
     2974   define variable v-dop1 as character no-undo .
     2975   define variable v-dop2 as character no-undo .
     2976   assign
     2977   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2978   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2979   no-error .
     2980   if error-status:error then return ?.
     2981   assign
     2982   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2983             integer(entry(2, v-dop2, ";":U)) * 60 +
     2984             integer(entry(3, v-dop2, ";":U)) no-error .
     2985   return v-time.
     2986   END FUNCTION.
