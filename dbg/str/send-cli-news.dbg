     6843         .
     6844         run bgelib-tag-put in this-procedure ( input 3, input "ClientCode"       , input string(cash-cli.cli-code + 1000000000 * cash-cli.justface), input 1 ).
     6845         run bgelib-tag-put in this-procedure ( input 3, input "CardDisCat"       , input string(v-magia-kat-pcnt), input 1 ).
     6846         run bgelib-tag-put in this-procedure ( input 3, input "CardType"        , input string(cash-cli.card-media), input 1 ).
     6847         run bgelib-tag-put in this-procedure ( input 3, input "CardOperation"   , input string(v-magia-card-operation), input 1 ).
     6848         run bgelib-tag-put in this-procedure ( input 3, input "CardNumber"      , input v-full-number, input 1 ).
     6849         if cash-cli.cli-message <> ?
     6850         then
     6851         run bgelib-tag-put in this-procedure ( input 3, input "CardMessage"     , input string(cash-cli.cli-message), input 1 ).
     6852         run bgelib-tag-put in this-procedure ( input 3, input "CardFiscal"      ,  input string(if cash-cli.fiscal-pay then 1 else 0), input 1 ).
     6853         if v-magia-curr-code <> ? then
     6854         run bgelib-tag-put in this-procedure ( input 3, input "CardCurrCode"    ,  input string(v-magia-curr-code), input 1 ).
     6855         run bgelib-tag-put in this-procedure ( input 3, input "CardMixedPay"    ,  input string(if cash-cli.mixed-pay then 1 else 0), input 1 ).
     6856         run bgelib-tag-put in this-procedure ( input 3, input "CardSaldo"        , input string(cash-cli.current-saldo), input 1 ).
     6857         run bgelib-tag-put in this-procedure ( input 3, input "CardLimit"        , input string(- cash-cli.lim-kr), input 1 ).
     6858         run bgelib-tag-put in this-procedure ( input 3, input "CardLock"         ,
     6859                                             input string(if lookup('тек':U, cash-cli.status_ ) > 0
     6860                                                                 then 0
     6861                                                                 else 1
     6862                                                         )
     6863                                                         , input 1 ).
     6864         run bgelib-tag-close in this-procedure ( input 2, input "Card").
     6865       end.
     6866     end.
     6867     when 'IPC-Servis+':U then  do:
     6868       FIND FIRST ub.dis-card-type No-LOCK WHERE
     6869                   ub.dis-card-type.type = cash-cli.type AND
     6870                   ub.dis-card-type.emitent-host-code = cash-cli.emitent-host-code AND
     6871                   ub.dis-card-type.host-code = 0 AND
     6872                   ub.dis-card-type.obj-type = "":U AND
     6873                   ub.dis-card-type.obj-code = 0 No-ERROR.
     6874       if not cash-cli.mask-card then do:
     6875         PUT UNFORMATTED
     6876         (ub.dis-card-type.dc-pfx + cash-cli.d-card) ","
     6877         '"' caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)")) '"' ","
     6878         string( if cash-cli.d-pcnt-byshop
     6879               then (v-d-pcnt)
     6880               else ( cash-cli.d-pcnt ) , "->>9.99" ) ","
     6881         string( 0, ">>>>>>>>9")
     6882         SKIP.
     6883       end.
     6884     end.
     6885     when 'OMRON':U then do:
     6886       if not cash-cli.mask-card then do:
     6887         PUT unformatted
     6888         string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6889         "000000000000"
     6890         caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6891         fill( " ", 20)
     6892         caps( string( cash-cli.cli-adr , "x(25)" ) )
     6893         caps( string( cash-cli.cli-city , "x(20)" ) )
     6894         string( cash-cli.cli-ind, ">>>>>9" )
     6895         fill(" ", 14)
     6896         fill(" ", 14)
     6897         string(today, "999999")
     6898         (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6899                 (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6900                 else "D":U)
     6901                 else string( action, "x(1)" )
     6902                 )
     6903         string( if cash-cli.d-pcnt-byshop
     6904                 then ( round(v-d-pcnt, 2) * 100 )
     6905                 else ( round(cash-cli.d-pcnt, 2) * 100 )
     6906               , "9999" )
     6907         SKIP
     6908         .
     6909       end.
     6910     end.
     6911     when 'OMRON-NEW':U then  do:
     6912       if not cash-cli.mask-card then do:
     6913         assign
     6914         v-versiond = decimal(p-version)
     6915         no-error .
     6916         if v-versiond >= 33.0 then do:
     6917           PUT unformatted
     6918           string( fill( "0", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6919           "000000000000"
     6920           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6921           fill( " ", 20)
     6922           caps( string( cash-cli.cli-adr , "x(25)" ) )
     6923           caps( string( cash-cli.cli-city , "x(20)" ) )
     6924           string( cash-cli.cli-ind, ">>>>>9" )
     6925           fill(" ", 14)
     6926           fill(" ", 14)
     6927           string(today, "999999")
     6928           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6929                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6930                   else "D":U)
     6931                   else string( action, "x(1)" )
     6932                   )
     6933           string( if cash-cli.d-pcnt-byshop
     6934                   then ( round(v-d-pcnt, 2) * 100 )
     6935                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     6936                 , "9999" )
     6937           replace(string(today, "99/99/9999"), chr(47), "":U)
     6938           '00':U
     6939           '000':U
     6940           fill( chr(32) , 31)
     6941           SKIP.
     6942         end.
     6943         else do:
     6944           PUT unformatted
     6945           string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6946           "000000000000"
     6947           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6948           fill( " ", 20)
     6949           caps( string( cash-cli.cli-adr , "x(25)" ) )
     6950           caps( string( cash-cli.cli-city , "x(20)" ) )
     6951           string( cash-cli.cli-ind, ">>>>>9" )
     6952           fill(" ", 14)
     6953           fill(" ", 14)
     6954           string(today, "999999")
     6955           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6956                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6957                   else "D":U)
     6958                   else string( action, "x(1)" )
     6959                   )
     6960           string( if cash-cli.d-pcnt-byshop
     6961                   then ( round(v-d-pcnt, 2) * 100 )
     6962                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     6963                 , "9999" )
     6964           SKIP
     6965           .
     6966         end.
     6967       end.
     6968     end.
     6969     when 'NCR-GM':U
     6970     or when 'NCR-AS@R':U
     6971     then do:
     6972       if length(cash-cli.d-card) > (if pos-type = 'NCR-GM':U then 10 else 12) then do:
     6973         if not (g#news or g#esys) then  do:
     6974           run write-log-and-file in p-log-handle (
     6975                 input 1
     6976               , input log-file-name
     6977               , input 1
     6978               , input substitute("!Ошибка при пересылке на кассу: Данные по дисконтной карте &1 не могут быть переданы на кассу NCR"
     6979                      , cash-cli.d-card )
     6980                                                 ).
     6981         end.
     6982         return .
     6983       end.
     6984       if cash-cli.kat-pcnt <> 0
     6985       AND (cash-cli.kat-pcnt < 10
     6986       or cash-cli.kat-pcnt > 99)
     6987       then do:
     6988         if not (g#news or g#esys) then  do:
     6989           run write-log-and-file in p-log-handle (
     6990                 input 1
     6991               , input log-file-name
     6992               , input 1
     6993               , input substitute("!Ошибка при пересылке на кассу:&2Данные по дисконтной карте &1 не могут быть переданы на кассу NCR&2" +
     6994                                  "Неверное значение категории карты: &3"
     6995                                  , cash-cli.d-card
     6996                                  , chr(10)
     6997                                  , cash-cli.kat-pcnt
     6998                                  )
     6999                                                 ).
     7000         end.
     7001         return .
     7002       end.
     7003       if not cash-cli.mask-card then do:
     7004         if (g#news or g#esys or run-from = "O":U or run-from = "E":U ) and
     7005             lookup('тек':U, cash-cli.status_ ) = 0  or
     7006             action = "D":U then do:
     7007           PUT stream IBMstream unformatted
     7008           "C1":U
     7009           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7010           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7011           "-":U
     7012           fill("-":U, 61)
     7013           chr(10)
     7014           "C2":U
     7015           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7016           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7017           "-":U
     7018           fill("-":U, 61)
     7019           chr(10)
     7020           .
     7021         end.
     7022         else do:
     7023           PUT stream IBMstream unformatted
     7024           "C1":U
     7025           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7026           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7027           "00":U
     7028           string(cash-cli.kat-pcnt, "99")
     7029           replace(string((if cash-cli.d-pcnt-method = integer('1':U)
     7030                         or cash-cli.d-pcnt-method = integer('3':U)
     7031                         then cash-cli.d-pcnt
     7032                         else 0), "999.9":U ), ".":U, "")
     7033           replace(string((if cash-cli.d-pcnt-method = integer('2':U)
     7034                         or cash-cli.d-pcnt-method = integer('3':U)
     7035                         then cash-cli.cash-d-pcnt
     7036                         else 0), "999.9":U ), ".":U, "")
     7037           "0000":U
     7038           "00000000":U
     7039           replace(string(cash-cli.lim-kr, "999999.99":U ), ".":U, "":U)
     7040           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(30)" ) )
     7041           chr(10)
     7042           "C2":U
     7043           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7044           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7045           fill(chr(32), 2)
     7046           caps( string( cash-cli.cli-adr , "x(30)" ) )
     7047           (if cash-cli.property-value-chr[1] <> '':U
     7048           then (cash-cli.property-value-chr[1] + chr(32) + cash-cli.property-value-chr[2])
     7049           else
     7050           (string( cash-cli.cli-ind, ">>>>>9" ) + chr(32) + caps( string( cash-cli.cli-city , "x(23)" ) ))
     7051           )
     7052           chr(10)
     7053           .
     7054         end.
     7055       end.
     7056     end.
     7057     when 'r-keeper':U then do:
     7058       if g#news
     7059       or g#esys
     7060       or action <> "D"
     7061       and not cash-cli.mask-card
     7062       then do:
     7063         if length(cash-cli.d-card) > 9 then do:
     7064           run write-log-and-file in p-log-handle (
     7065                 input 1
     7066               , input log-file-name
     7067               , input 1
     7068               , input substitute("!Невозможно переслать на кассу типа &1 карту &2: слишком длинный номер карты"
     7069                                 , cash-cli.d-card
     7070                                 , 'r-keeper':U
     7071                                 )
     7072                                                 ).
     7073         end.
     7074         put stream IBMStream unformatted
     7075         cash-cli.d-card chr(44)
     7076         windows-date-format(if cash-cli.valid-date = 12/31/9999
     7077                then (today + 36500)
     7078                else cash-cli.valid-date, v-date-format) chr(44)
     7079         chr(44)
     7080         chr(44)
     7081         chr(44)
     7082         entry(1, cash-cli.cli-name, chr(4)) chr(44)
     7083         (if not cash-cli.credit-card
     7084         then 0
     7085         else 4
     7086         )  chr(44)
     7087       cash-cli.lim-kr
     7088         skip.
     7089       end.
     7090     end.
     7091     when 'MARIA':U then do:
     7092       if p-send-cli then do:
     7093         find first buf_cd-clu EXCLUSIVE-LOCK where
     7094                   buf_cd-clu.obj-type = 'маг':U
     7095               and buf_cd-clu.obj-code = abs((if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code))
     7096               and buf_cd-clu.pos-type = 'MARIA':U
     7097               and buf_cd-clu.clu-type = '':U
     7098               AND buf_cd-clu.cli-type = cash-cli.cli-type
     7099               AND buf_cd-clu.cli-code = cash-cli.cli-code  NO-ERROR.
     7100         if not available buf_cd-clu then do:
     7101           if v-del-mrkt-cli = no then do:
     7102             run write-log-and-file in p-log-handle (
     7103                   input 1
     7104                 , input log-file-name
     7105                 , input 1
     7106                 , input substitute("!!!Клиент &1&2 &3 не включен в число КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     7107                                     "пропускается...."
     7108                                     , cash-cli.cli-type
     7109                                     , cash-cli.cli-code
     7110                                     , cash-cli.obj-name
     7111                                     , pos-type
     7112                                     , 'маг':U
     7113                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     7114                                     , chr(10)
     7115                                     )
     7116                                       ).
     7117           end.
     7118         end.
     7119         assign
     7120         v-clu = buf_cd-clu.clu-code.
     7121         if (buf_cd-clu.to-del and v-del-mrkt-cli)
     7122         or action = "D" then do:
     7123           assign
     7124           v-marketer-action = "D":U.
     7125           if v-del-mrkt-cli then do:
     7126             create temp-cd-clu.
     7127             buffer-copy buf_cd-clu
     7128             to temp-cd-clu
     7129             assign
     7130             buf_cd-clu.charkey_one = v-cd-list-delete
     7131             .
     7132           end.
     7133           else do:
     7134             run write-log-and-file in p-log-handle (
     7135                   input 1
     7136                 , input log-file-name
     7137                 , input 1
     7138                 , input substitute("!!!Клиент &1&2 &3 может быть удален с кассы типа &4 ТОЛЬКО при удалении из числа КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     7139                                     "пропускается...."
     7140                                     , cash-cli.cli-type
     7141                                     , cash-cli.cli-code
     7142                                     , cash-cli.obj-name
     7143                                     , pos-type
     7144                                     , 'маг':U
     7145                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     7146                                     , chr(10)
     7147                                     )
     7148                                       ).
     7149             v-view-log = yes.
     7150           end.
     7151         end.
     7152         else do:
     7153           assign
     7154           v-marketer-action = action.
     7155           if buf_cd-clu.to-send then do:
     7156             create temp-cd-clu.
     7157             buffer-copy buf_cd-clu
     7158             to temp-cd-clu
     7159             assign
     7160             temp-cd-clu.charkey_two = ""
     7161             temp-cd-clu.to-send = no
     7162             .
     7163           end.
     7164         end.
     7165         run maria-put in this-procedure (
     7166                                         buffer buf_cash-desk
     7167                                       , input out
     7168                                       , input fname
     7169                                       , input yes
     7170                                       , input 0
     7171                                       , input no
     7172                                       , input 1
     7173                                       , input 200
     7174                                       , input string(v-clu)
     7175                                       , input (if v-marketer-action = 'd' then '':U else string(cash-cli.obj-name, "X(18)"))).
     7176         v-maria-discnt-value = string(0, '999').
     7177         if action <> 'D':U  then do:
     7178           _do:
     7179           do v-ii = 1 to 2:
     7180             if v-ii = 1 then
     7181             assign
     7182             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-debet-pay"):buffer-value.
     7183             if v-ii = 2 then
     7184             assign
     7185             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-credit-pay"):buffer-value.
     7186             find first buf_dis-rule no-lock where
     7187               buf_dis-rule.obj-type = 'маг':U
     7188                   AND buf_dis-rule.obj-code = i-obj-code
     7189                   AND buf_dis-rule.rule-num = v-dc-rule-num
     7190                   AND buf_dis-rule.sts = integer('0':U) no-error .
     7191             if available buf_dis-rule then do:
     7192               if buf_dis-rule.discnt-type = integer('13':U) then do:
     7193                 assign
     7194                 v-maria-discnt-value = string('003')
     7195                 .
     7196               end.
     7197               else do:
     7198                 if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
     7199                   assign
     7200                   v-dop = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
     7201                   v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
     7202                   v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
     7203                   v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     7204                   .
     7205                 end.
     7206               end.
     7207             end.
     7208             else do:
     7209             end.
     7210             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     7211           end.
     7212         end.
     7213         else do:
     7214           do v-ii = 1 to 2:
     7215             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     7216           end.
     7217         end.
     7218       end.
     7219     end.
     7220   END CASE .
     7221   END PROCEDURE .
     7222   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7223   PROCEDURE putc-dis-card-mask.
     7224   define parameter buffer buf_cash-desk for ub.cash-desk.
     7225   define input parameter p-pos-type as character no-undo.
     7226   define input parameter p-version as character no-undo .
     7227   define variable v-host-code like ub.sysconf.host-code no-undo .
     7228   define variable v-version-dec as decimal no-undo .
     7229   define variable v-reg-cahs  as integer  no-undo .
     7230   define buffer dis-card for dc-list.
     7231   define buffer buf_dis-card-mask for dc-dis-card-mask.
     7232   define buffer buf_dis-card-mask-attr  for dc-dis-card-mask-attr.
     7233   define buffer buf_dis-card-type for ub.dis-card-type.
     7234   define buffer bf_dis-card-type for ub.dis-card-type.
     7235   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7237     (input  p-obj-type
     7238     ,input  i-obj-code
     7239     ,output v-host-code
     7240     )  .
     7241   assign
     7242   v-version-dec = decimal(p-version) no-error .
     7243   _mask:
     7244   for each buf_dis-card-mask no-lock where
     7245         buf_dis-card-mask.host-code = 0
     7246       OR (buf_dis-card-mask.host-code = v-host-code
     7247           AND buf_dis-card-mask.obj-code = 0)
     7248       or (buf_dis-card-mask.obj-type = p-obj-type
     7249           AND
     7250           buf_dis-card-mask.obj-code = i-obj-code)
     7251     :
     7252     if buf_dis-card-mask.use-on = integer('2':U) then next.
     7253     find first buf_dis-card-mask-attr no-lock where buf_dis-card-mask-attr.attr-code = "reg-cash" and buf_dis-card-mask-attr.mask-num = buf_dis-card-mask.mask-num no-error .
     7254     if available (buf_dis-card-mask-attr) then do:
     7255      if buf_dis-card-mask-attr.attr-value = "yes" then v-reg-cahs = 1 .
     7256      else v-reg-cahs = 0 .
     7257     end.
     7258     else do:
     7259     find first dis-card-mask-attr no-lock where dis-card-mask-attr.attr-code = "reg-cash" and dis-card-mask-attr.mask-num = buf_dis-card-mask.mask-num no-error .
     7260     if available (dis-card-mask-attr) then do:
     7261      if dis-card-mask-attr.attr-value = "yes" then v-reg-cahs = 1 .
     7262      else v-reg-cahs = 0 .
     7263     end.
     7264     else v-reg-cahs = 0 .
     7265     end.
     7266     find first dis-card no-lock where
     7267                dis-card.d-card = buf_dis-card-mask.mask no-error .
     7268     if available dis-card and
     7269     buf_dis-card-mask.cli-code <> 0 then do:
     7270       find first ub.clients no-lock where
     7271                 ub.clients.obj-type = buf_dis-card-mask.cli-type
     7272           AND  ub.clients.obj-code = buf_dis-card-mask.cli-code no-error .
     7273       if not available ub.clients then next _mask.
     7274       find first ub.dis-card-type no-lock where
     7275                 ub.dis-card-type.type = buf_dis-card-mask.type
     7276             AND ub.dis-card-type.emitent-host-code = buf_dis-card-mask.emitent-host-code
     7277                   no-error .
     7278       if buf_dis-card-mask.cli-code  = 0 then do:
     7279         find first cash-cli no-lock where
     7280                   cash-cli.cli-type = buf_dis-card-mask.cli-type
     7281               AND cash-cli.cli-code = buf_dis-card-mask.cli-code no-error .
     7282       end.
     7283       else do:
     7284         find first cash-cli no-lock where
     7285                   cash-cli.d-card = buf_dis-card-mask.mask
     7286                no-error .
     7287       end.
     7288     end.
     7289   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7290   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     7291     (
     7292      input  buf_dis-card-mask.type
     7293     ,input  buf_dis-card-mask.emitent-host-code
     7294     ,input  0
     7295     ,input  '':U
     7296     ,input  0
     7297     ,input  'def-pcnt':U
     7298     ,output v-d-pcnt0
     7299     )  .
     7300   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     7302     (
     7303      input  buf_dis-card-mask.type
     7304     ,input  buf_dis-card-mask.emitent-host-code
     7305     ,input  0
     7306     ,input  '':U
     7307     ,input  0
     7308     ,input  'def-pcnt':U
     7309     ,output v-cash-d-pcnt0
     7310     )  .
     7311   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     7313     (
     7314      input  buf_dis-card-mask.type
     7315     ,input  buf_dis-card-mask.emitent-host-code
     7316     ,input  0
     7317     ,input  '':U
     7318     ,input  0
     7319     ,input  'def-categ':U
     7320     ,output v-categ0
     7321     )  .
     7322     if v-d-pcnt0 = ? then do:
     7323       v-d-pcnt0 = 0.
     7324     end.
     7325     if v-cash-d-pcnt0 = ? then do:
     7326       v-cash-d-pcnt0 = 0.
     7327     end.
     7328     if v-categ0 = ? then do:
     7329       v-categ0 = 0.
     7330     end.
     7331     CASE p-pos-type:
     7332       when 'IBM':U then do:
     7333         put stream IBMStream unformatted
     7334         '20' chr(32)
     7335         chr(34) string( action, "x(1)" ) chr(34) chr(32)
     7336         string(buf_Dis-card-mask.rank) chr(32)
     7337         chr(34)
     7338         string( fill( chr(32) , 19 - length(trim(string(BUF_DIS-CARD-MASK.mask)))
     7339                     ) + buf_dis-card-mask.mask
     7340               )
     7341         chr(34) chr(32)
     7342         (if v-version-dec >= 4.54
     7343         then 5
     7344         else (if buf_dis-card-mask.cli-code <> 0
     7345               then 2
     7346               else 1)
     7347         ) chr(32)
     7348         chr(34)
     7349         (if buf_dis-card-mask.cli-mask <> '':U
     7350         then replace(buf_dis-card-mask.cli-mask, 'C', chr(63))
     7351         else string(fill( chr(32), 19)))  chr(34)  chr(32)
     7352         chr(34)
     7353         (if buf_dis-card-mask.cli-code <> 0
     7354         then string( fill( chr(32) , 16 - length( trim(string((if BUF_DIS-CARD-MASK.cli-type = 'орг':U then 1 else 0) * 1000000000 + BUF_DIS-CARD-MASK.cli-code ) ) ) )
     7355               + string((if BUF_DIS-CARD-MASK.cli-type = 'орг':U then 1 else 0) * 1000000000 + BUF_DIS-CARD-MASK.cli-code)
     7356               )
     7357         else string(fill( chr(32), 15) + "0":U)
     7358         )  chr(34)  chr(32)
     7359         (if available cash-cli
     7360         then string( if cash-cli.d-pcnt-byshop and avail bf_dis-card-type
     7361                 then (- v-d-pcnt)
     7362                 else ( - cash-cli.d-pcnt ) , "->>9.99" )
     7363         else string(- v-d-pcnt0, "->>9.99")
     7364         )  chr(32)
     7365         (if available cash-cli
     7366         then  string( cash-cli.kat-pcnt, ">>>9" )
     7367         else  string(v-categ)
     7368         )  chr(32)
     7369         Os2-time
     7370         chr(10).
     7371       end.
     7372       when 'IBM-XML':U then do:
     7373         run bgelib-tag-open in this-procedure ( input 2, input "MaskCard"
     7374                                               , input substitute("code='&1' ctrl='&2' tms='&3'", buf_dis-card-mask.rank
     7375                                               ,(if action = "U":U then if buf_dis-card-mask.stts eq 0
     7376                                                                        then 'ADD'
     7377                                                                        else 'DEL'
     7378                                                 else 'DEL')
     7379                                               ,OS2-time)).
     7380         run bgelib-tag-put in this-procedure ( input 3, input "MCCard", input buf_dis-card-mask.mask, input 1 ).
     7381         if v-version-dec >= 1.05 then do:
     7382           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(5), input 1 ).
     7383         end.
     7384         else do:
     7385           if buf_dis-card-mask.cli-code  = 0
     7386           then
     7387           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(1), input 1 ).
     7388           else
     7389           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(2), input 1 ).
     7390         end.
     7391         if buf_dis-card-mask.cli-mask <> '':U
     7392         then
     7393         run bgelib-tag-put in this-procedure ( input 3, input "MCRule"
     7394                                               , input  replace(buf_dis-card-mask.cli-mask, 'C', chr(63))
     7395                                               , input 1 ).
     7396         if buf_dis-card-mask.cli-code <> 0
     7397         then
     7398         run bgelib-tag-put in this-procedure ( input 3, input "MCClient"
     7399                                               , input  string((if buf_dis-card-mask.cli-type = 'орг':U then 1 else 0) * 1000000000 + buf_dis-card-mask.cli-code)
     7400                                               , input 1 ).
     7401         if available cash-cli
     7402         then
     7403         run bgelib-tag-put in this-procedure ( input 3, input "MCValue"
     7404                                              , input  string( if cash-cli.d-pcnt-byshop and avail bf_dis-card-type
     7405                                                               then (- v-d-pcnt)
     7406                                                               else ( - cash-cli.d-pcnt ) , "->>9.99" )
     7407                                              , input 1 ).
     7408         else
     7409         run bgelib-tag-put in this-procedure ( input 3, input "MCValue", input string(- v-d-pcnt0, "->>9.99"), input 1 ).
     7410         if available cash-cli
     7411         then
     7412         run bgelib-tag-put in this-procedure ( input 3, input "MCCat", input string( cash-cli.kat-pcnt, ">>>9" ), input 1 ).
     7413         else
     7414         run bgelib-tag-put in this-procedure ( input 3, input "MCCat", input string(v-categ0), input 1 ).
     7415         run bgelib-tag-put in this-procedure ( input 3, input "MCLock"
     7416                                             , input string(0), input 1 ).
     7417         run bgelib-tag-put in this-procedure ( input 3, input "MCBarRead", input string(v-reg-cahs), input 1 ).
     7418         run bgelib-tag-close in this-procedure ( input 2, input "MaskCard").
     7419       end.
     7420     END CASE .
     7421   END.
     7422   END PROCEDURE .
     7423   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7424   PROCEDURE   for-cash-cycle:
     7425   DEFINE VARIABLE fname-list as character no-undo .
     7426   DEFINE VARIABLE out-list as character no-undo .
     7427   DEFINE VARIABLE var-file-num as integer no-undo .
     7428   DEFINE VARIABLE v-dir-remote as character no-undo .
     7429   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     7430   define variable v-versiond as decimal no-undo .
     7431   define variable v-clu as character no-undo .
     7432   define variable v-dc-host-code like ub.sysconf.host-code no-undo .
     7433   define variable v-type              as character no-undo .
     7434   define buffer for-cash-desk for ub.cash-desk.
     7435   define buffer buf_cd-clu for ub.cd-clu.
     7436   FOR EACH for-cash-desk NO-LOCK WHERE
     7437           for-cash-desk.db-num = g#db-num AND
     7438           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     7439           for-cash-desk.obj-code = i-obj-code AND
     7440           for-cash-desk.cash-on  = yes
     7441   BREAK
     7442   BY for-cash-desk.db-num
     7443   BY for-cash-desk.obj-code
     7444   BY for-cash-desk.pos-type
     7445   BY for-cash-desk.cash-on
     7446   BY for-cash-desk.cash-num:
     7447      IF (LOOKUP(ub.cash-desk.pos-type,
     7448                 ('NCR-GM':U + chr(44) +
     7449                  'IBM-XML':U + chr(44) +
     7450                  'MAGIA-XML':U + chr(44) +
     7451                  'NCR-AS@R':U )) > 0
     7452        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     7453     if run-from = "E":U then NEXT.
     7454     if LOOKUP(ub.cash-desk.pos-type,
     7455               'MARIA':U
     7456                  ) > 0 then do:
     7457       if for-cash-desk.autonomy = integer('2':U) then do:
     7458         if v-del-mrkt-cli = no then next.
     7459         assign
     7460         v-cd-list-update = for-cash-desk.addr-path
     7461         v-cd-list-delete = for-cash-desk.addr-path
     7462         .
     7463         NEXT.
     7464       end.
     7465       else do:
     7466         if v-cd-list-update = '':U then nExt.
     7467       end.
     7468     end.
     7469     run write-log-and-file in p-log-handle (
     7470           input 1
     7471         , input log-file-name
     7472         , input 1
     7473         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     7474                           )
     7475                                           ).
     7476   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7477   case for-cash-desk.pos-type:
     7478       when 'IBM-XML':U or when 'Autotank':U
     7479     then do:
     7480   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7481   run xml-cd-filename in this-procedure (
     7482         input out
     7483       , output v-xml-file-name
     7484       , output v-xml-file-name-path
     7485       , output v-log-file-name
     7486       , output v-locked
     7487   ).
     7488   run write-log-and-file in p-log-handle (
     7489         input 1
     7490       , input log-file-name
     7491       , input 1
     7492       , input substitute( ("'Пересылка дисконтных карт/клиентов)'" + " &1")
     7493                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     7494                         )
     7495                                         ).
     7496   run write-log-and-file in p-log-handle (
     7497         input 1
     7498       , input log-file-name
     7499       , input 1
     7500       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     7501                                         ).
     7502   assign
     7503   v-obj-list = 'маг':U + string(i-obj-code)
     7504   .
     7505   run xml-cd-write-header in this-procedure (
     7506         input v-xml-file-name
     7507       , input v-xml-file-name-path
     7508       , input 'data'
     7509       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     7510       , input v-obj-list
     7511       , input (
     7512                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     7513                   then (if for-cash-desk.autonomy = integer('0':U)
     7514                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     7515                         else ("КМ"   )
     7516                         )
     7517                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     7518                   )
     7519               )
     7520       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     7521   ).
     7522   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     7523   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     7524     end.
     7525     when 'MAGIA-XML':U then do:
     7526   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7527   run xml-cd-filename in this-procedure (
     7528         input out
     7529       , output v-xml-file-name
     7530       , output v-xml-file-name-path
     7531       , output v-log-file-name
     7532       , output v-locked
     7533   ).
     7534   run write-log-and-file in p-log-handle (
     7535         input 1
     7536       , input log-file-name
     7537       , input 1
     7538       , input substitute( ("'Пересылка дисконтных карт/клиентов)'" + " &1")
     7539                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     7540                         )
     7541                                         ).
     7542   run write-log-and-file in p-log-handle (
     7543         input 1
     7544       , input log-file-name
     7545       , input 1
     7546       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     7547                                         ).
     7548   assign
     7549   v-obj-list = 'маг':U + string(i-obj-code)
     7550   .
     7551   run xml-cd-write-header in this-procedure (
     7552         input v-xml-file-name
     7553       , input v-xml-file-name-path
     7554       , input 'data'
     7555       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     7556       , input v-obj-list
     7557       , input (
     7558                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     7559                   then (if for-cash-desk.autonomy = integer('0':U)
     7560                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     7561                         else ("КМ"   )
     7562                         )
     7563                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     7564                   )
     7565               )
     7566       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     7567   ).
     7568   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     7569   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     7570     end.
     7571     when 'IBM':U
     7572     or
     7573     when 'Emulator-NKT-IBM':U
     7574     then do:
     7575   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7576   if for-cash-desk.cash-os = ""
     7577   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     7578   then NEXT.
     7579   assign
     7580   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     7581               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     7582   Cash-DOS = NOT CASH-OS2
     7583   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     7584   v-dir-remote-tmp = v-remote + "tmp":U
     7585   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     7586   .
     7587   if for-cash-desk.remote = 1 then do:
     7588     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     7589       if error-status:error then do:
     7590         run write-log-and-file in p-log-handle (
     7591               input 1
     7592             , input log-file-name
     7593             , input 1
     7594             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     7595                               "и/или попытка его создания не удалась"
     7596                               ,v-dir-remote-tmp
     7597                               ,for-cash-desk.cash-num
     7598                               ,chr(10)
     7599                               )
     7600                                               ).
     7601         NEXT.
     7602     end.
     7603     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     7604       if error-status:error then do:
     7605         run write-log-and-file in p-log-handle (
     7606               input 1
     7607             , input log-file-name
     7608             , input 1
     7609             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     7610                               "и/или попытка его создания не удалась"
     7611                               ,v-dir-remote
     7612                               ,for-cash-desk.cash-num
     7613                               ,chr(10)
     7614                               )
     7615                                               ).
     7616         NEXT.
     7617       end.
     7618   end.
     7619   output stream IBMStream
     7620   to value( (if for-cash-desk.remote = 1
     7621               then (v-dir-remote-tmp + chr(47) + "fl":U)
     7622               else out) + fname + '.dat' ) convert target "ibm866".
     7623   OS2-time =       ( if Cash-OS2 then
     7624                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     7625                         else "" )
     7626   .
     7627     end.
     7628     when 'OMRON-NEW':U then do:
     7629   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7630   assign
     7631   v-versiond = decimal(for-cash-desk.version)
     7632   no-error .
     7633   if error-status:error
     7634   or v-versiond < 0 then do:
     7635     run write-log-and-file in p-log-handle (
     7636           input 1
     7637         , input log-file-name
     7638         , input 1
     7639         , input  substitute("Неверное значение поля <ВЕРСИЯ> &1 для кассы типа &2 № &3 в справочнике касс&4" +
     7640                 "Значение версии может быть только десятичным числом > 0"
     7641                 ,for-cash-desk.version
     7642                 ,for-cash-desk.pos-type
     7643                 ,for-cash-desk.cash-num
     7644                 ,chr(10)
     7645                 ) ).
     7646     return error .
     7647   end.
     7648     assign
     7649     out = (for-cash-desk.addr-path + "out\":U )
     7650     fname = 'client'.
     7651     output to value( out + fname + '.dat':U ) convert target "ibm866".
     7652     end.
     7653     when 'IPC-Servis+':U then do:
     7654   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7655     assign
     7656     out = for-cash-desk.addr-path + "in\":U
     7657     fname = "disccli":U
     7658     .
     7659     output to value(
     7660     string( session:temp-directory + "cli":U + string( var-report-num ) ) + '.cli':U
     7661           )
     7662     convert target "ibm866".
     7663     end.
     7664     when 'NCR-GM':U then do:
     7665   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7666     fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     7667     output stream IBMStream
     7668     to value( out + fname + '.dat' ) convert target "ibm866".
     7669     .
     7670     end.
     7671     when 'NCR-AS@R':U then do:
     7672   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7673     fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     7674     output stream IBMStream
     7675     to value( out + fname + '.dat' ) convert target "ibm866".
     7676     .
     7677     end.
     7678     when 'r-keeper':U then do:
     7679   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7680   assign
     7681   fname = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     7682   .
     7683   output stream IBMStream
     7684   to value( out + fname + '.txt' ) convert target "1251".
     7685     end.
     7686     when 'MARIA':U then do:
     7687   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7688   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     7689      v-record = fill( chr(63) + chr(4), 400).
     7690     end.
     7691   END CASE.
     7692     _cash-cli:
     7693     FOR EACH cash-cli
     7694     where ((NOT (g#news or g#esys OR run-from = "S":U or run-from = "O":U))  OR (cash-cli.crf <= cr))
     7695     NO-LOCK
     7696     BREAK
     7697     by cash-cli.cli-type
     7698     by cash-cli.cli-code
     7699     :
     7700       if cash-cli.cli-code eq ?
     7701       then do:
     7702       end.
     7703       else if for-cash-desk.pos-type = 'MARIA':U then do:
     7704       end.
     7705       else do:
     7706         FIND FIRST ub.dis-card-type No-LOCK WHERE
     7707                     ub.dis-card-type.type = cash-cli.type and
     7708                     ub.dis-card-type.emitent-host-code = cash-cli.emitent-host-code AND
     7709                     ub.dis-card-type.host-code = 0 AND
     7710                     ub.dis-card-type.obj-type = "":U AND
