     6164     if last-of(ub.dis-card-property.dt-code) then do:
     6165       cash-cli.has-attrs-lim = yes.
     6166     end.
     6167   end.
     6168       if dc-list.flog = yes then delete dc-list.
     6169       if ( ii  > cdpcknum)   and NOT alllstcs  then do:
     6170         if cr > 0 then do:
     6171           if g#news
     6172           or g#esys
     6173           then do:
     6174             FOR EACH for-shop NO-LOCK where
