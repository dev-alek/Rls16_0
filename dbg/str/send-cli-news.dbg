     6348                                 else i-obj-code)
     6349                        , input 1
     6350                        , input cash-cli.d-pcnt
     6351                        , input cash-cli.cash-d-pcnt
     6352                        , input cash-cli.kat-pcnt), "%)(i ")).
     6353     v-categ = integer(trim(get-dpcn ( input cash-cli.d-card
     6354                        , input cash-cli.emitent-host-code
     6355                        , input cash-cli.type
     6356                        , input ub.sysconf.host-code
     6357                        , input 'маг':U
     6358                        , input (if g#news
     6359                                 or g#esys
     6360                                 then buf_cash-desk.obj-code
     6361                                 else i-obj-code)
     6362                        , input 1
     6363                        , input cash-cli.d-pcnt
     6364                        , input cash-cli.cash-d-pcnt
     6365                        , input cash-cli.kat-pcnt), "%)(i ")).
     6366   end.
     6367   CASE pos-type:
     6368     when 'IBM':U
     6369     or
     6370     when 'Emulator-NKT-IBM':U
     6371     then do:
     6372       if pos-type = 'Emulator-NKT-IBM':U then
     6373       v-version-dec = 0.
     6374       else
     6375       assign
     6376       v-version-dec = decimal(p-version) no-error .
     6377       if v-version-dec >= 4.4
     6378       then do:
     6379         PUT stream IBMstream unformatted
     6380         '19' chr(32)
     6381         '"'  (if g#news or g#esys or run-from = "O":U or run-from = "E":U
     6382                 then
     6383                 (if cash-cli.cli-status_  = 0 then "U":U
     6384                 else "D":U)
     6385                 else string( action, "x(1)" )
     6386                 ) '"' chr(32)
     6387         chr(34)
     6388         string( fill( chr(32) , 16 - length( trim(string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code ) ) ) )
     6389               + string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code)
     6390               )
     6391         chr(34)
     6392         chr(32)
     6393         chr(34) caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(40)" ) )   chr(34)   chr(32)
     6394         chr(34) caps( string( cash-cli.cli-city , "x(20)" ) )   chr(34)  chr(32)
     6395         chr(34) caps( string( cash-cli.cli-adr , "x(40)" ) ) chr(34) chr(32)
     6396          string( cash-cli.kat-pcnt, ">>>9" ) chr(32)
     6397         chr(34) string(cash-cli.cli-inn, "X(20)") chr(34) chr(32)
     6398         chr(34) string(cash-cli.kpp, "X(25)") chr(34) chr(32)
     6399         string(cash-cli.h-ka, ">>>>>9") chr(32)
     6400         (if  cash-cli.mask-card
     6401         then string( cash-cli.lim-kr, ">>>>>>>>9.99" )
     6402         else string( 0, ">>>>>>>>9.99" )
     6403         ) chr(32)
     6404        (if  cash-cli.mask-card
     6405         then string(cash-cli.current-saldo, "->>>>>>>>9.99" )
     6406         else string( 0 , "->>>>>>>>9.99" )
     6407         ) chr(32)
     6408         (if cash-cli.mask-card
     6409         then string( if cash-cli.d-pcnt-byshop
     6410                     then (- v-d-pcnt)
     6411                     else ( - cash-cli.d-pcnt ) , "->>9.99" )
     6412         else string( 0 , "->>9.99" )
     6413         )
     6414         chr(32)
     6415         Os2-time
     6416         chr(10).
     6417         if not cash-cli.mask-card then do:
     6418           PUT stream IBMstream unformatted
     6419           '21' chr(32)
     6420           '"'  (if g#news or g#esys or run-from = "O":U or run-from = "E":U
     6421                   then
     6422                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6423                   else "D":U)
     6424                   else string( action, "x(1)" )
     6425                   ) '"' chr(32)
     6426           chr(34)
     6427           string( fill( " ", 19 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     6428           chr(34)
     6429           chr(32)
     6430           chr(34)
