     2127                       when chr(5)
     2128                       then do:
     2129                           assign
     2130                               p-out-string = p-out-string + " ":U
     2131                           .
     2132                       end.
     2133                       when chr(6)
     2134                       then do:
     2135                           assign
     2136                               p-out-string = p-out-string + " ":U
     2137                           .
     2138                       end.
     2139                       when chr(7)
     2140                       then do:
     2141                           assign
     2142                               p-out-string = p-out-string + " ":U
     2143                           .
     2144                       end.
     2145                       when chr(8)
     2146                       then do:
     2147                           assign
     2148                               p-out-string = p-out-string + " ":U
