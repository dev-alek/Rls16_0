     2088       :
     2089           when ?
     2090           then do:
     2091               assign
     2092                   p-out-string = "?":U
     2093               .
     2094           end.
     2095           otherwise do:
     2096               do v-position = 1 to length( p-in-string )
     2097               :
     2098                   assign
     2099                       v-current-char = substring( p-in-string, v-position, 1 )
     2100                   .
