     6311   define variable v-dc-rule-num as integer no-undo .
     6312   define variable v-maria-rule-num as integer no-undo .
     6313   define variable v-magia-kat-pcnt as integer no-undo .
     6314   define buffer buf_cash-pay for ub.cash-pay.
     6315   define buffer buf_currency for ub.currency.
     6316   define buffer buf_cd-clu for ub.cd-clu.
     6317   define buffer buf_dis-rule for ub.dis-rule.
     6318   define buffer root_cash-dis-rule for cash-dis-rule.
     6319   if cash-cli.d-pcnt >= 100  then do:
     6320     return error
     6321     substitute("Карта &1:неверный процент скидки по карте &2"
     6322                 ,  cash-cli.d-card
     6323                 , cash-cli.d-pcnt
     6324                 ).
     6325   end.
     6326   if cash-cli.d-pcnt-byshop then do:
     6327     v-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     6328                        , input cash-cli.emitent-host-code
     6329                        , input cash-cli.type
     6330                        , input ub.sysconf.host-code
     6331                        , input 'маг':U
     6332                        , input (if g#news
