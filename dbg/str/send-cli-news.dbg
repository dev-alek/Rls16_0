     5998     if available buf_dis-card-property then
     5999     cash-cli.ef-access-key = buf_Dis-card-property.property-value-character.
     6000     find first buf_Dis-card-property no-lock where
     6001               buf_Dis-card-property.d-card = cash-cli.d-card
     6002          and buf_Dis-card-property.dtm-code = integer(25)
     6003          and buf_Dis-card-property.node-code = integer(3)
     6004          and buf_Dis-card-property.host-code = 0
     6005          and buf_Dis-card-property.obj-type = ''
     6006          and buf_Dis-card-property.obj-code = 0 no-error.
