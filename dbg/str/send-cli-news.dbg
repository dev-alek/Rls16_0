     6334                                 then buf_cash-desk.obj-code
     6335                                 else i-obj-code)
     6336                        , input 1
     6337                        , input cash-cli.d-pcnt
     6338                        , input cash-cli.cash-d-pcnt
     6339                        , input cash-cli.kat-pcnt), "%)(i ")).
     6340     v-cash-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     6341                        , input cash-cli.emitent-host-code
     6342                        , input cash-cli.type
     6343                        , input ub.sysconf.host-code
     6344                        , input 'маг':U
