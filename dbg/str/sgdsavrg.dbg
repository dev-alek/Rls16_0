      428           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
      429                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      430               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      431         assign
      432           vat-cli-loc            = ?
      433           slt-cli-loc            = ?
      434           price-cli-with-tax-loc = ?.
      435      end.
      436      else do:
      437                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
      438                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
      439                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
      440                                         in-vatp-parts.artic     = buf_doc-line.artic     and
      441                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
      442                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
      443                            use-index out-code no-lock:
      444             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      445                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      446                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      447                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      448                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      449                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      450                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      451                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      452                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      453                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      454                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      455                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      456                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      457                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      458                         .
      459         end.
      460         ASSIGN
      461           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      462           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      463           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      464           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      465           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      466           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      467                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      468           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      469                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      470           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      471           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      472           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      473         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      474         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      475         if transport-base-loc = ? then transport-base-loc = 0.
      476         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      477         if other-base-loc     = ? then other-base-loc     = 0.
      478         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      479         assign
      480           transport-cli-loc      = 0
      481           other-cli-loc          = 0
      482           road-tax-cli-loc       = ?
      483           vat-cli-loc            = ?
      484           slt-cli-loc            = ?
      485           price-cli-with-tax-loc = ?.
      486      end.
      487   ASSIGN
      488             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      489       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      490   .
      491                         Assign
      492                             p-road-tax-rubl =  road-tax-rubl-loc
      493                             p-road-tax-base =  road-tax-base-loc
      494                             .
      495                         end.
      496       end.
      497   end procedure.
      498   define buffer buf_goods   for ub.goods .
      499   define buffer buf_gds-obj for ub.gds-obj .
      500   def var v-total-avrg-base as decimal no-undo .
      501   def var v-total-avrg-rubl as decimal no-undo .
      502   def var v-total-avrg-qnty as decimal no-undo .
      503   def var v-last-in-code  like ub.gds-obj.in-code  no-undo .
      504   def var v-last-obj-type like ub.gds-obj.obj-type no-undo .
      505   def var v-last-obj-code like ub.gds-obj.obj-code no-undo .
      506   find first buf_goods no-lock
      507     where buf_goods.artic     = p-artic
      508       and buf_goods.prod-type = p-prod-type
      509       and buf_goods.prod-code = p-prod-code
      510     no-error .
      511   if not available buf_goods then do:
      512     message
      513       vss-workfile vss-revision vss-description skip
      514       "Не найден товар" skip
      515       "Артикул" p-artic p-prod-type p-prod-code skip
      516       view-as alert-box .
      517     undo, return error .
      518   end.
      519   case p-price-type :
      520     when 'УчетнаяS':U then do:
      521       if buf_goods.gds-type = 'т':U then do:
      522         assign
      523           v-total-avrg-base = 0
      524           v-total-avrg-rubl = 0
      525           v-total-avrg-qnty = 0
      526         .
      527         for each x_obj-group ,
      528           each buf_gds-obj no-lock
      529           where buf_gds-obj.obj-type  = x_obj-group.obj-type
      530             and buf_gds-obj.obj-code  = x_obj-group.obj-code
      531             and buf_gds-obj.artic     = p-artic
      532             and buf_gds-obj.prod-type = p-prod-type
      533             and buf_gds-obj.prod-code = p-prod-code
      534         on error undo, return error
      535         :
      536           if buf_gds-obj.avrg-base > 0 then do:
      537             assign
      538               v-total-avrg-base = v-total-avrg-base
      539                                 + (buf_gds-obj.avrg-base * buf_gds-obj.avrg-qnty)
      540               v-total-avrg-rubl = v-total-avrg-rubl
      541                                 + (buf_gds-obj.avrg-rubl * buf_gds-obj.avrg-qnty)
      542               v-total-avrg-qnty = v-total-avrg-qnty
      543                                 + buf_gds-obj.avrg-qnty
      544             .
      545           end.
      546         end.
      547         if v-total-avrg-qnty > 0 then do:
      548           assign
      549             p-price-base = v-total-avrg-base / v-total-avrg-qnty
      550             p-price-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      551           .
      552         end.
      553         else do:
      554           run last-incom-S in this-procedure
      555           ( input   p-artic ,
      556             input   p-prod-type,
      557             input   p-prod-code ,
      558             output  v-last-in-code,
      559             output  v-last-obj-type,
      560             output  v-last-obj-code ).
      561           find first buf_gds-obj no-lock
      562             where buf_gds-obj.obj-type  = v-last-obj-type
      563               and buf_gds-obj.obj-code  = v-last-obj-code
      564               and buf_gds-obj.artic     = p-artic
      565               and buf_gds-obj.prod-type = p-prod-type
      566               and buf_gds-obj.prod-code = p-prod-code
      567             no-error .
      568           if available buf_gds-obj then do:
      569             assign
      570               p-price-base = buf_gds-obj.last-base
      571               p-price-rubl = buf_gds-obj.last-rubl
      572             .
      573           end.
      574         end.
      575       end.
      576       else do:
      577         assign
      578           p-price-base = ?
      579           p-price-rubl = ?
      580         .
      581       end.
      582     end.
      583     when 'Учет-рзрвS':U then do:
      584       if buf_goods.gds-type = 'т':U then do:
      585         define buffer buf_parts for ub.parts .
      586         for each x_obj-group ,
      587           each buf_parts no-lock
      588           where buf_parts.obj-type  = x_obj-group.obj-type
      589             and buf_parts.obj-code  = x_obj-group.obj-code
      590             and buf_parts.artic     = p-artic
      591             and buf_parts.prod-type = p-prod-type
      592             and buf_parts.prod-code = p-prod-code
      593             and buf_parts.status_   = no
      594             and buf_parts.out-code  = 'free-zone':U
      595             and buf_parts.qnty      > 0
      596         on error undo, return error
      597         :
      598             assign
      599             v-total-avrg-base = v-total-avrg-base
      600                               + (buf_parts.price-base * buf_parts.qnty)
      601             v-total-avrg-rubl = v-total-avrg-rubl
      602                               + (buf_parts.price-rubl * buf_parts.qnty)
      603             v-total-avrg-qnty = v-total-avrg-qnty
      604                               + buf_parts.qnty
      605           .
      606         end.
      607         if v-total-avrg-qnty > 0 then do:
      608           assign
      609             p-price-base = v-total-avrg-base / v-total-avrg-qnty
      610             p-price-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      611           .
      612         end.
      613         else do:
      614           run last-incom-S in this-procedure
      615           ( input   p-artic ,
      616             input   p-prod-type,
      617             input   p-prod-code ,
      618             output  v-last-in-code,
      619             output  v-last-obj-type,
      620             output  v-last-obj-code ).
      621           find first buf_gds-obj no-lock
      622             where buf_gds-obj.obj-type  = v-last-obj-type
      623               and buf_gds-obj.obj-code  = v-last-obj-code
      624               and buf_gds-obj.artic     = p-artic
      625               and buf_gds-obj.prod-type = p-prod-type
      626               and buf_gds-obj.prod-code = p-prod-code
      627             no-error .
      628           if available buf_gds-obj then do:
      629             assign
      630               p-price-base = buf_gds-obj.last-base
      631               p-price-rubl = buf_gds-obj.last-rubl
      632             .
      633           end.
      634         end.
      635       end.
      636       else do:
      637         assign
      638           p-price-base = ?
      639           p-price-rubl = ?
      640         .
      641         for each  x_obj-group ,
      642          first buf_gds-obj no-lock
      643           where buf_gds-obj.obj-type  = x_obj-group.obj-type
      644             and buf_gds-obj.obj-code  = x_obj-group.obj-code
      645             and buf_gds-obj.artic     = p-artic
      646             and buf_gds-obj.prod-type = p-prod-type
      647             and buf_gds-obj.prod-code = p-prod-code :
      648           assign
      649             p-price-base = buf_gds-obj.price-base
      650             p-price-rubl = buf_gds-obj.price-rubl
      651           .
      652         end.
      653       end.
      654     end.
      655     when 'ПриходнаяS':U then do:
      656       if buf_goods.gds-type = 'т':U then do:
      657           run last-incom-S in this-procedure
      658           ( input   p-artic ,
      659             input   p-prod-type,
      660             input   p-prod-code ,
      661             output  v-last-in-code,
      662             output  v-last-obj-type,
      663             output  v-last-obj-code ).
      664         find first buf_gds-obj no-lock
      665           where buf_gds-obj.obj-type  = v-last-obj-type
      666             and buf_gds-obj.obj-code  = v-last-obj-code
      667             and buf_gds-obj.artic     = p-artic
      668             and buf_gds-obj.prod-type = p-prod-type
      669             and buf_gds-obj.prod-code = p-prod-code
      670           no-error .
      671         if available buf_gds-obj then do:
      672           assign
      673             p-price-base = buf_gds-obj.last-base
      674             p-price-rubl = buf_gds-obj.last-rubl
      675           .
      676         end.
      677       end.
      678     end.
      679     otherwise do:
      680       message
      681         vss-workfile vss-revision vss-description skip
      682         "Ошибка задания входных параметров" skip
      683         "Недопустимое значение аргумента p-price-type" p-price-type skip
      684         "Артикул" p-artic p-prod-type p-prod-code skip
      685         view-as alert-box error .
      686       undo, return error .
      687     end.
      688   end case.
      689   if p-price-base = 0 then do:
      690     assign
      691       p-price-base = ?
      692     .
      693   end.
      694   if p-price-rubl = 0 then do:
      695     assign
      696       p-price-rubl = ?
      697     .
      698   end.
      699   if (p-price-base = ?) <> (p-price-rubl = ?) then do:
      700     message
      701       vss-workfile vss-revision vss-description skip
      702       "Учетная цена в одной из валют не задана" skip
      703       "p-price-base" p-price-base skip
      704       "p-price-rubl" p-price-rubl skip
      705       view-as alert-box error .
      706     undo, return error .
      707   end.
