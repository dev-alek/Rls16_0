     6134   .
     6135    if lookup ( buf_contract.usl-opl , "По факту поставки,По факту реализации,По реализации части приход. накладной") > 0
     6136      then v-date-pay = today  .
     6137      else dO:
     6138           if p-cons = 2 and available   buf_trn-doc then do:
     6139               var-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     6140               if var-date < today then var-date = today.
     6141               v-date-pay = var-date.
     6142           end.
     6143      end.
     6144    if p-cons = 2 then do:
     6145         if available   buf_trn-doc
     6146            then
     6147            assign
     6148              n-trn-doc-code       =  buf_trn-doc.doc-code
     6149            .
     6150            else  n-trn-doc-code       = ?   .
     6151        end.
     6152        else do:
     6153          if pfo = true and available   buf_trn-doc
     6154            then  assign
     6155              n-trn-doc-code       =  buf_trn-doc.doc-code
     6156            .
     6157            else  n-trn-doc-code      = ?   .
     6158        end.
     6159   assign
     6160     n-user-db-num-doc    = g#db-num
     6161     n-user-name-doc      = g#userid
     6162     n-contract-code      = buf_contract.contract-code
     6163     n-contract-curr      = n-curr-code
     6164     n-contract-rate      = n-exch-rate
     6165     n-contract-scale     = n-exch-scale
     6166     n-pay-date           = v-date-pay
     6167     n-sum-rubl-orig      = v-sum-rubl
     6168     n-sum-base-orig      =     v-sum-base
     6169     n-sum-contract       =    v-sum-contract
     6170     n-sum-base           = n-sum-base-orig
     6171     n-sum-doc-orig       = n-sum-contract
     6172     n-sum-doc            = n-sum-contract
     6173     n-sum-rubl           = n-sum-rubl-orig
     6174     n-trn-doc-code-orig  = if available  buf_parts-attr then buf_parts-attr.income-in-code else  ?
     6175     n-in-type            = 0
     6176     n-sum-tax-base       = 0
     6177     n-sum-tax-doc        = 0
     6178     n-sum-tax-rubl       = 0
     6179     n-sum-tax-contract   = 0
     6180     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     6181    .
     6182     if  buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     6183         then n-pay-date = n-doc-date .
     6184         else n-pay-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     6185         run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     6186         run create-fin-liab in this-procedure (
     6187           input yes ,
     6188           input  p-doc-code                       ,
     6189           input  n-doc-date            ,
     6190           input  n-doc-type           ,
     6191           input  n-payer-name         ,
     6192           input  n-receiver-name      ,
     6193           input  n-curr-code           ,
     6194           input  n-sum-doc             ,
     6195           input  n-user-db-num-doc     ,
     6196           input  n-user-name-doc       ,
     6197           input  n-base-rate           ,
     6198           input  n-base-scale          ,
     6199           input  n-receiver-code       ,
     6200           input  n-receiver-type       ,
     6201           input  n-contract-code       ,
     6202           input  n-exch-rate           ,
     6203           input  n-exch-scale          ,
     6204           input  n-contract-curr       ,
     6205           input  n-contract-rate       ,
     6206           input  n-contract-scale      ,
     6207           input  n-fact-date           ,
     6208           input  n-fact-order          ,
     6209           input  par-host-code         ,
     6210           input  n-payer-code          ,
     6211           input  n-payer-type          ,
     6212           input  n-pay-date            ,
     6213           input  string(p-doc-code)    ,
     6214           input  'авто':U            ,
     6215           input  n-sum-base-orig       ,
     6216           input  n-sum-base            ,
     6217           input  n-sum-doc-orig        ,
     6218           input  n-sum-rubl-orig       ,
     6219           input  n-sum-rubl            ,
     6220           input  n-sum-contract        ,
     6221           input  n-trn-doc-code        ,
     6222           input  n-user-db-num-fact    ,
     6223           input  n-user-db-num-pay        ,
     6224           input  n-user-name-fact         ,
     6225           input  n-user-name-pay          ,
     6226           input  n-in-type                ,
     6227           input  n-sum-tax-base           ,
     6228           input  n-sum-tax-doc            ,
     6229           input  n-sum-tax-rubl           ,
     6230           input  n-sum-tax-contract       ,
     6231           input "" ,
     6232           output p-ri )
     6233           no-error .
     6234           col-fo = col-fo + 1.
     6235           col-contract = col-contract + 1 .
     6236           find first  buf_fin-ob-trn no-lock  where
     6237                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     6238                 buf_fin-ob-trn.host-code      = par-host-code  and
     6239                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     6240                 no-error .
