     3899   procedure thbjattr_code :
     3900      define input  parameter p-upper-code     as character no-undo .
     3901      define input  parameter p-code           as character no-undo .
     3902      define output parameter p-label          as character no-undo .
     3903      define output parameter p-user-can-edit  as logical   no-undo .
     3904      define output parameter p-output-display as logical   no-undo .
     3905      define output parameter p-other          as character no-undo .
     3906      define output parameter p-prop-list      as character no-undo .
     3907      define output parameter p-prop-type-list as character no-undo .
     3908      define output parameter p-prop-label-list as character no-undo .
     3909      define output parameter p-global          as logical no-undo .
     3910      define output parameter p-host           as logical no-undo .
     3911      define output parameter p-shop           as logical no-undo .
     3912      define output parameter p-store          as logical no-undo .
     3913      define output parameter p-db             as logical no-undo .
     3914      define variable p-region as logical no-undo.
     3915      run thbjattr_code_reg in this-procedure (
     3916                                               p-upper-code,
     3917                                               p-code,
     3918                                               output p-label,
     3919                                               output p-user-can-edit,
     3920                                               output p-output-display,
     3921                                               output p-other,
     3922                                               output p-prop-list,
     3923                                               output p-prop-type-list,
     3924                                               output p-prop-label-list,
     3925                                               output p-global,
     3926                                               output p-host,
     3927                                               output p-shop,
     3928                                               output p-store,
     3929                                               output p-db,
     3930                                               output p-region
     3931                                               ).
     3932   end procedure.
     3933   procedure thbjattr_code_reg :
     3934   define input  parameter p-upper-code     as character no-undo .
     3935   define input  parameter p-code           as character no-undo .
     3936   define output parameter p-label          as character no-undo .
     3937   define output parameter p-user-can-edit  as logical   no-undo .
     3938   define output parameter p-output-display as logical   no-undo .
     3939   define output parameter p-other          as character no-undo .
     3940   define output parameter p-prop-list      as character no-undo .
     3941   define output parameter p-prop-type-list as character no-undo .
     3942   define output parameter p-prop-label-list as character no-undo .
     3943   define output parameter p-global          as logical no-undo .
     3944   define output parameter p-host           as logical no-undo .
     3945   define output parameter p-shop           as logical no-undo .
     3946   define output parameter p-store          as logical no-undo .
     3947   define output parameter p-db             as logical no-undo .
     3948   define output parameter p-region         as logical no-undo .
     3949   do
     3950   on error undo, return error return-value
     3951   :
     3952       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     3953       (input  p-upper-code
     3954       ,input  p-code
     3955       ,output p-label
     3956       ,output p-user-can-edit
     3957       ,output p-output-display
     3958       ,output p-other
     3959       ,output p-prop-list
     3960       ,output p-prop-type-list
     3961       ,output p-prop-label-list
     3962       ,output p-global
     3963       ,output p-host
     3964       ,output p-shop
     3965       ,output p-store
     3966       ,output p-db
     3967       ,output p-region
     3968       ) no-error .
     3969     if error-status :error
     3970     then do:
     3971       undo, return error substitute( "&1. &2&3&4", vss-include-info25, return-value, chr(10), error-status :get-message (1)).
     3972     end.
     3973   end.
     3974   end procedure.
