     4324   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4325   do:
     4326     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4327       (input  v-cntxt-db-num
     4328       ,input  v-cntxt-userid
     4329       ,input  0
     4330       ,input  'actn_fin-liability_add-def':U
     4331       ,input  'firm':U
     4332       ,input  par-host-code
     4333       ,input  '':U
     4334       ,input  0
     4335       ,input  0
     4336       ,input  0
     4337       ,input  0
     4338       ,input  true
     4339       ,output g-log
     4340       )  .
     4341   end.
     4342   if not g-log then  return .
     4343   run waitfram-show in this-procedure ("Ждите...").
     4344   define variable var-fin-calc as integer no-undo .
     4345   find first sysconf no-lock where sysconf.host-code = par-host-code no-error .
     4346   var-fin-calc = sysconf.fin-calc   .
     4347   if p-trn-doc = 1  then do:
     4348       p-usl-opl =  'По факту поставки,Отсрочка платежа (по поставке)' .
     4349      end.
     4350      else do:
     4351       p-usl-opl =  'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)'  .
     4352      end.
     4353   run make-temp-obj-firm in this-procedure .
     4354   if p-trn-doc = ? then assign
     4355                          v-type-trn-doc = 'ie,ep,':U + 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U
     4356                          v-sign-list    = '1,-1,':U + '1,1,-1,-1,1,1,1,':U + '1,1,1,1,':U
     4357                          .
     4358   if p-trn-doc = 1 then assign
     4359                          v-type-trn-doc = 'ie,ep,':U + 'vt,ap,mp,vp,':U
     4360                          v-shot-type-trn-doc = 'при':U
     4361                          v-sign-list    = '1,-1,':U + '1,1,1,1,':U
     4362                          .
     4363   if p-trn-doc = 2 then assign
     4364                         v-type-trn-doc = 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U
     4365                         v-shot-type-trn-doc = 'рас':U
     4366                         v-sign-list    = '1,1,-1,-1,1,1,1,':U + '1,1,1,1,':U
     4367                         .
     4368   if p-trn-doc <> ?  then do:
     4369           if p-trn-doc = 1  then do:
     4370              for each buf_trn-doc no-lock where
     4371                   buf_trn-doc.host-code  = par-host-code          and
     4372                   buf_trn-doc.need-incfo = 1                      and
     4373                 ( p-adm or
     4374                   buf_trn-doc.cr-incfo   = false )                 and
     4375                   lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0 and
     4376                   buf_trn-doc.status_    = 'факт':U                and
     4377                   buf_trn-doc.fact-date <= p-date-end
     4378                   on error undo, return error
     4379                   :
     4380                   run proc-body-corr-acc in this-procedure .
     4381                   run proc-body in this-procedure .
     4382              end.
     4383           end.
     4384           if p-trn-doc = 2  then do:
     4385              for each buf_trn-doc no-lock where
     4386                   buf_trn-doc.host-code  = par-host-code          and
     4387                   buf_trn-doc.need-expfo = 1                      and
     4388                   ( p-adm or buf_trn-doc.cr-expfo   = false  )    and
     4389                   lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0 and
     4390                   buf_trn-doc.status_    = 'факт':U                and
     4391                   buf_trn-doc.fact-date <= p-date-end
     4392                   on error undo, return error
     4393                   :
     4394                   run proc-body-corr-acc in this-procedure .
     4395                   run proc-body in this-procedure .
     4396              end.
     4397           end.
     4398    end.
     4399    else do:
     4400       p-usl-opl = 'По факту поставки,Отсрочка платежа (по поставке)' + "," + 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' .
     4401       for each tt-trn-doc  no-lock  where
     4402           lookup(tt-trn-doc.ext-doc-type , v-type-trn-doc) > 0
     4403           and    tt-trn-doc.status_    = 'факт':U
     4404           break by tt-trn-doc.ext-doc-type
     4405           on error undo, return error
     4406           :
     4407           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-trn-doc.doc-code no-error .
     4408           if available buf_trn-doc then  do:
     4409                   run proc-body-corr-acc in this-procedure  .
     4410                   run proc-body in this-procedure .
     4411           end.
     4412       end.
     4413    end.
     4414     if p-cons = 1  then do:
     4415        assign
     4416           var-sum-rubl     =  0
     4417           var-sum-base     =  0
     4418           var-sum-contract =  0
     4419           col-contract     =  0
     4420           .
     4421        if var-fin-calc = 1  then do:
     4422           for each temp-obj-firm
     4423               on error undo, return error :
     4424                     assign
     4425                       var-sum-rubl     =  0
     4426                       var-sum-base     =  0
     4427                       var-sum-contract =  0
     4428                       col-contract     =  0
     4429                     .
     4430                     for each tt-fin-ob where
     4431                               tt-fin-ob.obj-code =  temp-obj-firm.obj-code and
     4432                               tt-fin-ob.obj-type =  temp-obj-firm.obj-type
     4433                               ,
     4434                         first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     4435                                                         buf_contract.host-code     = par-host-code           and
     4436                                                         buf_contract.usl-opl       <> 'По реализации части приход. накладной':U
     4437                               break
     4438                               by tt-fin-ob.contract-code
     4439                               by tt-fin-ob.pc
     4440                               on error undo, return error :
     4441                               var-sum-rubl     = var-sum-rubl     + tt-fin-ob.sum-rubl.
     4442                               var-sum-base     = var-sum-base     + tt-fin-ob.sum-base.
     4443                               var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract .
     4444                               if last-of(tt-fin-ob.contract-code)  or (p-nalog = 2 and last-of(tt-fin-ob.pc)) then do:
     4445                                   col-contract = col-contract + 1 .
     4446                                   if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show in this-procedure ( "Объединение по договорам : " + string( col-contract )) .
     4447                                   run make-s-fo-obj in this-procedure (
     4448                                         input var-sum-rubl,
     4449                                         input var-sum-base,
     4450                                         input var-sum-contract,
     4451                                         input temp-obj-firm.obj-type ,
     4452                                         input temp-obj-firm.obj-code ,
     4453                                         input tt-fin-ob.pc )
     4454                                         no-error .
     4455                                       if error-status :error then do:
     4456                                         col-fo = col-fo - 1.
     4457                                         p-res = p-res + chr(10) + error-status :get-message(1) .
     4458                                       end.
     4459                                   var-sum-rubl =  0 .
     4460                                   var-sum-base =  0 .
     4461                                   var-sum-contract =  0 .
     4462                               end.
     4463                       end.
     4464           end.
     4465        end.
     4466        else do:
     4467             for each tt-fin-ob  ,
     4468                 first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     4469                                                   buf_contract.host-code     = par-host-code           and
     4470                                                   buf_contract.usl-opl       <> 'По реализации части приход. накладной':U
     4471                       break
     4472                          by tt-fin-ob.contract-code
     4473                          by tt-fin-ob.pc
     4474                       on error undo, return error :
     4475                       var-sum-rubl = var-sum-rubl + tt-fin-ob.sum-rubl.
     4476                       var-sum-base = var-sum-base + tt-fin-ob.sum-base.
     4477                       var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract.
     4478                       if last-of(tt-fin-ob.contract-code) or (p-nalog = 2 and last-of(tt-fin-ob.pc)) then do:
     4479                           col-contract = col-contract + 1 .
     4480                           if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show in this-procedure ( "Объединение по договорам : " + string( col-contract )) .
     4481                           run make-s-fo in this-procedure ( input var-sum-rubl , input var-sum-base , input var-sum-contract , input tt-fin-ob.pc ) no-error .
     4482                               if error-status :error then do:
     4483                                 col-fo = col-fo - 1.
     4484                                 p-res = p-res + chr(10) + error-status :get-message(1) .
     4485                               end.
     4486                           var-sum-rubl     =  0 .
     4487                           var-sum-base     =  0 .
     4488                           var-sum-contract =  0 .
     4489                       end.
     4490               end.
     4491        end.
     4492     end.
     4493   run waitfram-hide in this-procedure .
     4494   if col-fo    < 0 then col-fo    = 0 .
     4495   if col-bfo   < 0 then col-bfo   = 0 .
     4496   p-res = p-res  + chr(10)   +
     4497          "Генерация завершена: " + cur-time-string()  + chr(10) +
     4498          "за период до " + string( p-date-end,"99/99/9999")  + chr(10) +
     4499          " Создано финансовых обязательств :" + string(col-fo) + chr(10) +
     4500          " Создано ПредФинанОбязательств   :" + string(col-bfo) + chr(10) +  chr(10) +
     4501          "Просмотрено накладных            :" + string(col-trn)           + chr(10) +
     4502          "Просмотрено договоров            :" + string(col-contract)
