     4310   .
     4311   p-res = p-res +  chr(10).
     4312   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4313     run mainmenu_getcntxt in parparentproc
     4314       (output v-cntxt-db-num
     4315       ,output v-cntxt-userid
     4316       ,output v-cntxt-level
     4317       ,output v-cntxt-host-code-obj
     4318       ,output v-cntxt-obj-type
