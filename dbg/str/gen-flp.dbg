     5597               create buf_fin-ob-trn.
     5598               assign
     5599                 buf_fin-ob-trn.doc-code       = p-doc-code
     5600                 buf_fin-ob-trn.host-code      = par-host-code
     5601                 buf_fin-ob-trn.sum-rubl       = tt-trn-code.sum-rubl
     5602                 buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code
     5603               .
     5604               end.
     5605         find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = tt-trn-code.doc-code no-error .
     5606         if available buf2_trn-doc then do:
     5607           if lookup( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)'  ) > 0 then do:
     5608               assign
     5609                 buf2_trn-doc.cr-incfo   = true
     5610                 buf2_trn-doc.cr-incorexpfo = true
     5611                 buf2_trn-doc.incfo-date = today
     5612               .
     5613             if buf2_trn-doc.need-incfo = 2 then do:
     5614               assign
     5615                 buf2_trn-doc.need-incfo      = 1
     5616                 buf2_trn-doc.need-expfo      = 0
     5617                 buf2_trn-doc.need-incorexpfo = 1
     5618                         .
     5619             end.
     5620           end.
     5621             else do:
     5622               assign
     5623                 buf2_trn-doc.cr-expfo   = true
     5624                 buf2_trn-doc.cr-incorexpfo = true
     5625                 buf2_trn-doc.expfo-date = today
     5626               .
     5627               if buf2_trn-doc.need-expfo = 2 then do:
     5628                 assign
     5629                   buf2_trn-doc.need-expfo      = 1
     5630                   buf2_trn-doc.need-incfo      = 0
     5631                   buf2_trn-doc.need-incorexpfo = 1
     5632                 .
     5633               end.
     5634             end.
     5635          end.
     5636          else do:
     5637             message vss-workfile vss-revision vss-description skip
     5638                    "Ошибка test " skip
     5639                     skip
     5640                     error-status :get-message(1) skip
     5641                     return-value skip
     5642                     view-as alert-box error
     5643             .
     5644          end.
     5645          if p-nalog = 1 then
     5646             run make-fin-parts in this-procedure ( input p-doc-code, input 2) .
     5647          else
     5648             run make-fin-parts-VAT in this-procedure ( input p-doc-code, input v-pc) .
     5649     end.
     5650     run make-tax in this-procedure (
     5651           input p-doc-code ,
     5652           input par-host-code
     5653           )                .
     5654     run update-fin-ob_obj in this-procedure (
     5655           input p-doc-code ,
     5656           input par-host-code
     5657           )
     5658       .
     5659    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     5660    if error-status :error then
     5661       p-res = p-res + chr(10) + " Ошибка процедуры закрытия на ФАКТ совокупного ФО "  + error-status :get-message(1)  + return-value .
     5662    end.
     5663   end procedure.
     5664   procedure make-temp-obj-firm :
     5665    do
     5666    on error undo, return error return-value
     5667    :
     5668    define buffer buf_shop for shop .
     5669    define buffer buf_store for store .
     5670   for each temp-obj-firm : delete temp-obj-firm. end.
     5671       for each buf_shop no-lock where buf_shop.host-code = par-host-code  on error undo, return error :
     5672           create temp-obj-firm.
     5673           assign
     5674             temp-obj-firm.obj-code = buf_shop.obj-code
     5675             temp-obj-firm.obj-type = 'маг':U
     5676           .
     5677       end.
     5678       for each buf_store no-lock where buf_store.host-code = par-host-code  on error undo, return error :
     5679           create temp-obj-firm.
     5680           assign
     5681             temp-obj-firm.obj-code = buf_store.obj-code
     5682             temp-obj-firm.obj-type = 'скл':U
     5683           .
     5684       end.
     5685    end.
     5686   end procedure.
     5687   procedure make-bfo :
     5688    do
     5689    on error undo, return error return-value
     5690    :
     5691   define input parameter v-sum-rubl as decimal no-undo .
     5692   define input parameter v-sum-base as decimal no-undo .
     5693   define input parameter v-sum-contract as decimal no-undo .
     5694   define buffer t-buf_fin-ob-trn for fin-ob-trn .
     5695   define buffer t-buf_fin-ob     for fin-ob .
     5696   define buffer buf4_trn-doc for trn-doc.
     5697   define variable v-n as character no-undo .
     5698   define variable v-fo-prih as logical no-undo .
     5699   v-fo-prih = false .
     5700   for each t-buf_fin-ob-trn no-lock where
     5701            t-buf_fin-ob-trn.trn-doc-code = var-income-in-code
     5702            :
     5703            v-n = t-buf_fin-ob-trn.doc-code  .
     5704            if  can-find ( first t-buf_fin-ob no-lock where
     5705                                 t-buf_fin-ob.doc-code      = v-n   and
     5706                                 t-buf_fin-ob.contract-code = buf_contract.contract-code
     5707                                 )
     5708             then do:
     5709             find first buf4_trn-doc  exclusive-lock  where buf4_trn-doc.doc-code = buf_trn-doc.doc-code no-error .
     5710                 if available buf4_trn-doc then do:
     5711                     p-res = p-res + ">> Создание ПФО - На накладную " + string(var-income-in-code) +
     5712                                    " уже создано ФО " + string(v-n)  + chr(10)
     5713                                    .
     5714                     v-fo-prih = true  .
     5715                 end.
     5716             end.
     5717    end.
     5718   define buffer buf3_trn-doc for trn-doc.
