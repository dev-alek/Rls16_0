     3614               .
     3615             end.
     3616             assign
     3617               varlastcur-base     = varprice-sale
     3618               varlastcur-road-tax = varroad-tax
     3619               varlastcur-excise   = varexcise
     3620               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3621               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3622               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3623               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3624             .
     3625         end.
     3626       end.
     3627       if varcur-fact-qnty = 0 then do:
     3628         assign
     3629           varcur-base      = varlastcur-base
     3630           varcur-road-tax  = varlastcur-road-tax
     3631           varcur-excise    = varlastcur-excise
     3632         .
     3633       end.
     3634       else do:
     3635         assign
     3636           varcur-base      = varcur-base      / varcur-fact-qnty
     3637           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3638           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3639         .
     3640       end.
