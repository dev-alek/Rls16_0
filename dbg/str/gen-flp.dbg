     6647   end procedure.
     6648   procedure clc-price :
     6649    do
     6650    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6651    :
     6652   for each tt-clcparts
     6653       on error undo, return error :
     6654       delete tt-clcparts .
     6655   end.
     6656   BUFFER-COPY buf_parts to tt-clcparts .
     6657   run clcprtsl_calc-parts in this-procedure
     6658   (
     6659     input recid(tt-clcparts) ,
     6660     input varis-doc          ,
     6661     input varis-cur          ,
     6662     input varroad-tax        ,
     6663     input varexcise          ,
     6664     input varvat-pc          ,
     6665     input varcons-vat-pc     ,
     6666     input varslt-pc          ,
     6667     input varbase-rate       ,
     6668     input varbase-scale      ,
     6669     input varr-b             ,
     6670     input varcur-base        ,
     6671     input varcurroad-tax     ,
     6672     input varcurexcise       ,
     6673     input varcurvat-pc       ,
     6674     input varcurcons-vat-pc  ,
     6675     input varcurslt-pc
     6676     ) no-error
     6677     .
     6678     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) + return-value .
     6679        find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error .
     6680     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) .
     6681    end.
     6682   end procedure.
     6683   procedure clc-price-tmp :
     6684    do
     6685    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6686    :
     6687   for each tt-clcparts
     6688       on error undo, return error :
     6689       delete tt-clcparts .
     6690   end.
     6691   BUFFER-COPY temp-parts to tt-clcparts .
     6692   run clcprtsl_calc-parts in this-procedure
     6693   (
     6694     input recid(tt-clcparts) ,
     6695     input varis-doc          ,
     6696     input varis-cur          ,
     6697     input varroad-tax        ,
     6698     input varexcise          ,
     6699     input varvat-pc          ,
     6700     input varcons-vat-pc     ,
     6701     input varslt-pc          ,
     6702     input varbase-rate       ,
     6703     input varbase-scale      ,
     6704     input varr-b             ,
     6705     input varcur-base        ,
     6706     input varcurroad-tax     ,
     6707     input varcurexcise       ,
     6708     input varcurvat-pc       ,
     6709     input varcurcons-vat-pc  ,
     6710     input varcurslt-pc
     6711     ) no-error
     6712     .
     6713     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) + return-value .
     6714        find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error .
     6715     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) .
     6716    end.
     6717   end procedure.
     6718   procedure make-fin-parts :
     6719    do
     6720    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6721    :
     6722   define input parameter p-doc-code as character no-undo .
     6723   define input parameter p-type as integer no-undo .
     6724   define variable col-part   as integer   no-undo .
     6725     for each temp-parts no-lock  where
     6726              temp-parts.contract-code = buf_contract.contract-code and
     6727              ((p-type  = 1 ) or
     6728              ( p-type  = 2 and temp-parts.out-code      = buf_fin-ob-trn.trn-doc-code))
     6729              on error undo, return error :
     6730                   if not can-find (first buf_fin-gds-part no-lock where
     6731                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     6732                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     6733                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     6734                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     6735                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     6736                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     6737                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     6738                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     6739                   then do:
     6740                       col-part = col-part + 1.
     6741                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show in this-procedure ( "Создано партий : " + string( col-part )) .
     6742                         run clc-price-tmp in this-procedure .
     6743                         create buf_fin-gds-part.
     6744                         buffer-copy temp-parts to buf_fin-gds-part
     6745                         assign
     6746                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     6747                           buf_fin-gds-part.status_dop         = 'авто':U
     6748                           buf_fin-gds-part.user-db-num        = g#db-num
     6749                           buf_fin-gds-part.user-name          = g#userid
     6750                           buf_fin-gds-part.doc-qnty           = temp-parts.qnty
     6751                           buf_fin-gds-part.sum-rubl-orig      = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6752                           buf_fin-gds-part.sum-rubl           = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6753                           buf_fin-gds-part.sum-base-orig      = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6754                           buf_fin-gds-part.sum-base           = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6755                           buf_fin-gds-part.sum-contract-orig  = tt-allsum.sum-dsc-cli-acc
     6756                           buf_fin-gds-part.sum-contract       = tt-allsum.sum-dsc-cli-acc
     6757                           buf_fin-gds-part.other-rubl-orig    = tt-allsum.other-rubl-acc
     6758                           buf_fin-gds-part.road-tax-rubl-orig = tt-allsum.road-tax-rubl-acc
     6759                           buf_fin-gds-part.transport-rubl-orig= tt-allsum.transport-rubl-acc
     6760                           buf_fin-gds-part.other-base-orig    = tt-allsum.other-base-acc
     6761                           buf_fin-gds-part.road-tax-base-orig = tt-allsum.road-tax-base-acc
     6762                           buf_fin-gds-part.transport-base-orig= tt-allsum.transport-base-acc
     6763                           buf_fin-gds-part.other-contract-orig     = tt-allsum.other-cli-acc
     6764                           buf_fin-gds-part.road-tax-contract-orig  = tt-allsum.road-tax-cli-acc
     6765                           buf_fin-gds-part.transport-contract-orig = tt-allsum.transport-cli-acc
     6766                           buf_fin-gds-part.vat-rubl-orig      = tt-allsum.vat-rubl-acc
     6767                           buf_fin-gds-part.vat-rubl           = tt-allsum.vat-rubl-acc
     6768                           buf_fin-gds-part.slt-rubl-orig      = tt-allsum.slt-rubl-acc
     6769                           buf_fin-gds-part.slt-rubl           = tt-allsum.slt-rubl-acc
     6770                           buf_fin-gds-part.vat-base-orig      = tt-allsum.vat-base-acc
     6771                           buf_fin-gds-part.vat-base           = tt-allsum.vat-base-acc
     6772                           buf_fin-gds-part.slt-base-orig      = tt-allsum.slt-base-acc
     6773                           buf_fin-gds-part.slt-base           = tt-allsum.slt-base-acc
     6774                           buf_fin-gds-part.vat-contract-orig  = tt-allsum.vat-cli-acc
     6775                           buf_fin-gds-part.vat-contract       = tt-allsum.vat-cli-acc
     6776                           buf_fin-gds-part.slt-contract-orig  = tt-allsum.slt-cli-acc
     6777                           buf_fin-gds-part.slt-contract       = tt-allsum.slt-cli-acc
     6778                         .
     6779                   end.
     6780               end.
     6781    end.
     6782   end procedure.
     6783   procedure ver-type-purch :
     6784   do
     6785   on error undo, return error return-value
     6786   :
     6787    define output parameter p-ok as logical   no-undo .
     6788    p-ok = true .
     6789     if buf_trn-doc.ext-doc-type   = 'pc':U then do:
     6790       p-ok = false  .
     6791       if  buf_contract.contract-type = 'Ответственного хранения':U and
     6792           buf_parts.purch-code       = 3  then p-ok = true .
     6793     end.
     6794   end.
     6795   end procedure.
     6796   procedure ver-purch-resp-store :
     6797   do
     6798   on error undo, return error return-value
     6799    :
     6800    define output parameter p-ok as logical   no-undo .
     6801    p-ok = true .
     6802     if buf_trn-doc.ext-doc-type   <> 'pc':U then do:
     6803       if  buf_contract.contract-type = 'Ответственного хранения':U and
     6804           buf_parts.purch-code      <> 3  then p-ok = false  .
     6805     end.
     6806   end.
     6807   end procedure.
     6808   procedure make-fin-parts-VAT :
     6809    do
     6810    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6811    :
     6812   define input parameter p-doc-code as character no-undo .
     6813   define input  parameter v-pc as decimal   no-undo .
     6814   if var-fin-calc <> 1  then find first temp-obj-firm no-error .
     6815   define variable col-part   as integer   no-undo .
     6816     for each temp-parts no-lock  where
     6817              temp-parts.contract-code = buf_contract.contract-code and
     6818              temp-parts.VAT-pc = v-pc  and
     6819              ( var-fin-calc <> 1  or (
     6820              temp-parts.obj-type = temp-obj-firm.obj-type  and
     6821              temp-parts.obj-code = temp-obj-firm.obj-code ))
     6822              on error undo, return error :
     6823                   if not can-find (first buf_fin-gds-part no-lock where
     6824                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     6825                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     6826                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     6827                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     6828                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     6829                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     6830                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     6831                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     6832                   then do:
     6833                       col-part = col-part + 1.
     6834                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show in this-procedure ( "Создано партий : " + string( col-part )) .
     6835                         run clc-price-tmp in this-procedure .
     6836                         create buf_fin-gds-part.
     6837                         buffer-copy temp-parts to buf_fin-gds-part
     6838                         assign
     6839                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     6840                           buf_fin-gds-part.status_dop         = 'авто':U
     6841                           buf_fin-gds-part.user-db-num        = g#db-num
     6842                           buf_fin-gds-part.user-name          = g#userid
     6843                           buf_fin-gds-part.doc-qnty           = temp-parts.qnty
     6844                           buf_fin-gds-part.sum-rubl-orig      = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6845                           buf_fin-gds-part.sum-rubl           = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6846                           buf_fin-gds-part.sum-base-orig      = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6847                           buf_fin-gds-part.sum-base           = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6848                           buf_fin-gds-part.sum-contract-orig  = tt-allsum.sum-dsc-cli-acc
     6849                           buf_fin-gds-part.sum-contract       = tt-allsum.sum-dsc-cli-acc
     6850                           buf_fin-gds-part.other-rubl-orig    = tt-allsum.other-rubl-acc
     6851                           buf_fin-gds-part.road-tax-rubl-orig = tt-allsum.road-tax-rubl-acc
     6852                           buf_fin-gds-part.transport-rubl-orig= tt-allsum.transport-rubl-acc
     6853                           buf_fin-gds-part.other-base-orig    = tt-allsum.other-base-acc
     6854                           buf_fin-gds-part.road-tax-base-orig = tt-allsum.road-tax-base-acc
     6855                           buf_fin-gds-part.transport-base-orig= tt-allsum.transport-base-acc
     6856                           buf_fin-gds-part.other-contract-orig     = tt-allsum.other-cli-acc
     6857                           buf_fin-gds-part.road-tax-contract-orig  = tt-allsum.road-tax-cli-acc
     6858                           buf_fin-gds-part.transport-contract-orig = tt-allsum.transport-cli-acc
     6859                           buf_fin-gds-part.vat-rubl-orig      = tt-allsum.vat-rubl-acc
     6860                           buf_fin-gds-part.vat-rubl           = tt-allsum.vat-rubl-acc
     6861                           buf_fin-gds-part.slt-rubl-orig      = tt-allsum.slt-rubl-acc
     6862                           buf_fin-gds-part.slt-rubl           = tt-allsum.slt-rubl-acc
     6863                           buf_fin-gds-part.vat-base-orig      = tt-allsum.vat-base-acc
     6864                           buf_fin-gds-part.vat-base           = tt-allsum.vat-base-acc
     6865                           buf_fin-gds-part.slt-base-orig      = tt-allsum.slt-base-acc
     6866                           buf_fin-gds-part.slt-base           = tt-allsum.slt-base-acc
     6867                           buf_fin-gds-part.vat-contract-orig  = tt-allsum.vat-cli-acc
     6868                           buf_fin-gds-part.vat-contract       = tt-allsum.vat-cli-acc
     6869                           buf_fin-gds-part.slt-contract-orig  = tt-allsum.slt-cli-acc
     6870                           buf_fin-gds-part.slt-contract       = tt-allsum.slt-cli-acc
     6871                         .
     6872                   end.
     6873               end.
     6874    end.
     6875   end procedure.
     6876   procedure ver-parts-attr :
     6877     do
     6878     on error undo, return error return-value
     6879     :
     6880         for each buf_parts no-lock where buf_parts.out-code  = buf_trn-doc.doc-code   and
     6881                                          buf_parts.host-code = buf_trn-doc.host-code  and
     6882                                          buf_parts.obj-type  = buf_trn-doc.obj-type   and
     6883                                          buf_parts.obj-code  = buf_trn-doc.obj-code ,
     6884                 first buf_goods no-lock where buf_goods.artic     = buf_parts.artic      and
     6885                                               buf_goods.prod-type = buf_parts.prod-type  and
     6886                                               buf_goods.prod-code = buf_parts.prod-code ,
     6887                 first buf_contract no-lock where buf_contract.contract-code = buf_parts.contract-code and
     6888                                                  buf_contract.host-code     = buf_parts.host-code     and
     6889                                                  lookup(buf_contract.usl-opl , p-usl-opl ) > 0  and
     6890                               ((
     6891                               lookup ( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0 and
     6892                               lookup ( buf_trn-doc.ext-doc-type , 'ie,ep,':U ) > 0
     6893                               ) OR
     6894                               ( lookup ( buf_contract.usl-opl , 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' ) > 0   and
     6895                                 lookup ( buf_trn-doc.ext-doc-type , 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U ) > 0
     6896                                 ) )
     6897        :
     6898           find first buf_parts-attr no-lock where buf_parts-attr.in-code   = buf_parts.in-code   and
     6899                                                 buf_parts-attr.part-code = buf_parts.part-code and
     6900                                                 buf_parts-attr.gds-code  = buf_goods.gds-code no-error .
     6901                  if not available buf_parts-attr then
     6902                     p-res = p-res + chr(10)   + " У документа " +  buf_trn-doc.doc-code + "Нет атрибутов партий !!! Используйте утилиту восстановления" .
     6903     end.
     6904     end.
     6905   end procedure.
