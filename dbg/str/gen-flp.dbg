     6517       input  n-user-db-num-doc     ,
     6518       input  n-user-name-doc       ,
     6519       input  n-base-rate           ,
     6520       input  n-base-scale          ,
     6521       input  n-receiver-code       ,
     6522       input  n-receiver-type       ,
     6523       input  n-contract-code       ,
     6524       input  n-exch-rate           ,
     6525       input  n-exch-scale          ,
     6526       input  n-contract-curr       ,
     6527       input  n-contract-rate       ,
     6528       input  n-contract-scale      ,
     6529       input  n-fact-date           ,
     6530       input  n-fact-order          ,
     6531       input  par-host-code         ,
     6532       input  n-payer-code          ,
     6533       input  n-payer-type          ,
     6534       input  n-pay-date            ,
     6535       input  string(p-doc-code)    ,
     6536       input  'авто':U            ,
