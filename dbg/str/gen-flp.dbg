     5780   define variable v-date-pay as date      no-undo .
     5781   define variable var-date as date no-undo .
     5782   if not available buf_contract then return .
     5783   if not can-find (first temp-parts no-lock ) then return .
     5784   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5785   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5786     (input  par-host-code
     5787     ,input  today
     5788     ,output n-base-rate
     5789     ,output n-base-scale
     5790     )  .
     5791     n-curr-code          = buf_contract.curr-code.
     5792   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5794     (input  n-curr-code
     5795     ,input  today
     5796     ,output n-exch-rate
     5797     ,output n-exch-scale
     5798     ,output n-abbr-doc
     5799     )  .
     5800   assign
     5801     n-doc-type            =  'рас':U
     5802     n-receiver-code       =  buf_contract.cli-code
     5803     n-receiver-type       =  buf_contract.cli-type
     5804     n-receiver-name       =  buf_contract.cli-name
     5805     n-payer-code          =  par-host-code
     5806     n-payer-type          =  'орг':U
     5807     n-payer-name          =  buf_contract.own-name
     5808   .
     5809    if lookup ( buf_contract.usl-opl , "По факту поставки,По факту реализации,По реализации части приход. накладной") > 0
     5810      then v-date-pay = today  .
     5811      else dO:
     5812           if p-cons = 2 and available   buf_trn-doc then do:
     5813               var-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     5814               if var-date < today then var-date = today.
     5815               v-date-pay = var-date.
     5816           end.
     5817      end.
     5818    if p-cons = 2 then do:
     5819         if available   buf_trn-doc
     5820            then
     5821            assign
     5822              n-trn-doc-code       =  buf_trn-doc.doc-code
     5823            .
     5824            else  n-trn-doc-code       = ?   .
     5825        end.
     5826        else do:
     5827          if pfo = true and available   buf_trn-doc
     5828            then  assign
     5829              n-trn-doc-code       =  buf_trn-doc.doc-code
     5830            .
     5831            else  n-trn-doc-code      = ?   .
     5832        end.
     5833   assign
     5834     n-user-db-num-doc    = g#db-num
     5835     n-user-name-doc      = g#userid
     5836     n-contract-code      = buf_contract.contract-code
     5837     n-contract-curr      = n-curr-code
     5838     n-contract-rate      = n-exch-rate
     5839     n-contract-scale     = n-exch-scale
     5840     n-pay-date           = v-date-pay
     5841     n-sum-rubl-orig      = v-sum-rubl
     5842     n-sum-base-orig      =     v-sum-base
     5843     n-sum-contract       =    v-sum-contract
     5844     n-sum-base           = n-sum-base-orig
     5845     n-sum-doc-orig       = n-sum-contract
     5846     n-sum-doc            = n-sum-contract
     5847     n-sum-rubl           = n-sum-rubl-orig
     5848     n-trn-doc-code-orig  = if available  buf_parts-attr then buf_parts-attr.income-in-code else  ?
     5849     n-in-type            = 0
     5850     n-sum-tax-base       = 0
     5851     n-sum-tax-doc        = 0
     5852     n-sum-tax-rubl       = 0
     5853     n-sum-tax-contract   = 0
     5854     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     5855    .
     5856    if v-fo-prih = true  then do:
     5857     assign
     5858       var-status          = 'авто':U
     5859       v-fo-doc-code       = v-n
     5860       .
     5861    end.
     5862    else do:
     5863      assign
     5864       var-status = 'авто':U
     5865       v-fo-doc-code = ""
     5866      .
     5867    end.
     5868         run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     5869         run create-fin-ob-before in this-procedure (
     5870           input yes                    ,
     5871           input  p-doc-code            ,
     5872           input  v-fo-doc-code         ,
     5873           input  n-doc-date ,
     5874           input  n-doc-type            ,
     5875           input  n-payer-name          ,
     5876           input  n-receiver-name       ,
     5877           input  n-curr-code           ,
     5878           input  n-sum-doc             ,
     5879           input  n-user-db-num-doc     ,
     5880           input  n-user-name-doc       ,
     5881           input  n-base-rate           ,
     5882           input  n-base-scale          ,
     5883           input  n-receiver-code       ,
     5884           input  n-receiver-type       ,
     5885           input  n-contract-code       ,
     5886           input  n-exch-rate           ,
     5887           input  n-exch-scale          ,
     5888           input  n-contract-curr       ,
     5889           input  n-contract-rate       ,
     5890           input  n-contract-scale      ,
     5891           input  n-fact-date           ,
     5892           input  n-fact-order          ,
     5893           input  par-host-code         ,
     5894           input  n-payer-code          ,
     5895           input  n-payer-type          ,
     5896           input  n-pay-date            ,
     5897           input  string(p-doc-code)    ,
     5898           input  var-status            ,
     5899           input  n-sum-base-orig       ,
     5900           input  n-sum-base            ,
     5901           input  n-sum-doc-orig        ,
     5902           input  n-sum-rubl-orig       ,
     5903           input  n-sum-rubl            ,
     5904           input  n-sum-contract        ,
     5905           input  n-trn-doc-code        ,
     5906           input  n-trn-doc-code-orig   ,
     5907           input  n-user-db-num-fact    ,
     5908           input  n-user-db-num-pay      ,
     5909           input  n-user-name-fact       ,
     5910           input  n-user-name-pay        ,
     5911           input  n-in-type              ,
     5912           input  n-sum-tax-base         ,
     5913           input  n-sum-tax-doc          ,
     5914           input  n-sum-tax-rubl         ,
     5915           input  n-sum-tax-contract     ,
     5916           input "" ,
     5917           output p-ri )
     5918           no-error .
     5919           col-bfo = col-bfo + 1.
     5920           col-contract = col-contract + 1 .
     5921           find first  buf_fin-ob-trn no-lock  where
     5922                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     5923                 buf_fin-ob-trn.host-code      = par-host-code  and
     5924                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     5925                 no-error .
     5926                 if not available  buf_fin-ob-trn then  do:
     5927               create buf_fin-ob-trn.
     5928               assign
     5929                 buf_fin-ob-trn.doc-code       = p-doc-code
     5930                 buf_fin-ob-trn.host-code      = par-host-code
     5931                 buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     5932                 buf_fin-ob-trn.sum-tax-rubl   = n-sum-tax-rubl
     5933                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     5934               .
     5935               end.
     5936                   find first buf3_trn-doc  exclusive-lock  where buf3_trn-doc.doc-code = buf_trn-doc.doc-code no-error .
     5937                   if available buf3_trn-doc then do:
     5938                       assign
     5939                         buf3_trn-doc.cr-expfo      = true
     5940                         buf3_trn-doc.cr-incorexpfo = true
     5941                         buf3_trn-doc.expfo-date    = today
     5942                        .
     5943                       end.
     5944                     else message error-status :get-message(1) "test pfo".
     5945                run make-fin-parts in this-procedure ( input p-doc-code, input 2 ) .
     5946                 for each temp-parts  where temp-parts.contract-code = buf_contract.contract-code
     5947                                        and temp-parts.out-code      = buf_fin-ob-trn.trn-doc-code :
     5948                     delete temp-parts .
     5949                 end.
     5950                 run make-tax-before in this-procedure (
     5951                       input p-doc-code ,
     5952                       input par-host-code
     5953                       )                .
     5954    end.
     5955   end procedure.
     5956   procedure make-tax-before :
     5957    do
     5958    on error undo, return error return-value
     5959    :
     5960   define input parameter p-doc-code as character no-undo .
     5961   define input parameter p-host-code as integer no-undo .
     5962   define buffer buf_fin-gds-part for  fin-gds-part .
     5963   define buffer buf_fin-ob-tax-before   for  fin-ob-tax-before .
     5964   define buffer buf_fin-ob-before       for  fin-ob-before     .
     5965   define variable v-line    as integer no-undo .
     5966   define variable v-sum     as decimal no-undo .
     5967   define variable v-tax-sum as decimal no-undo .
     5968   define variable v-tax-sum-rubl as decimal no-undo .
     5969   define variable v-tax-sum-base as decimal no-undo .
     5970   define variable v-tax-sum-contr as decimal no-undo .
     5971   define variable v-tax-sum-doc  as decimal no-undo .
     5972   for each buf_fin-ob-before  exclusive-lock  where  buf_fin-ob-before.host-code   = p-host-code and
     5973                                                      buf_fin-ob-before.before-code = p-doc-code
     5974                                                      on error undo, return error :
     5975       v-tax-sum-rubl = 0 .
     5976       v-tax-sum-base = 0 .
     5977       v-tax-sum-contr = 0 .
     5978       v-tax-sum-doc  = 0 .
     5979       v-sum  = 0 .
     5980       v-line = 0 .
     5981       for each buf_fin-gds-part no-lock where
     5982                buf_fin-gds-part.host-code   = buf_fin-ob-before.host-code and
     5983                buf_fin-gds-part.fin-ob-code = buf_fin-ob-before.before-code
     5984                break  by buf_fin-gds-part.SLT-pc
     5985                       by buf_fin-gds-part.SLT-type
     5986                       by buf_fin-gds-part.vat-pc
     5987                       by buf_fin-gds-part.vat-type
     5988                       by buf_fin-gds-part.gds-code
     5989                on error undo, return error :
     5990                v-sum = v-sum + buf_fin-gds-part.sum-rubl .
     5991                if last-of(buf_fin-gds-part.gds-code) then do:
     5992                   v-line = v-line + 1.
     5993                   create buf_fin-ob-tax-before.
     5994                   assign
     5995                       buf_fin-ob-tax-before.before-code        = buf_fin-ob-before.before-code
     5996                       buf_fin-ob-tax-before.host-code          = buf_fin-ob-before.host-code
     5997                       buf_fin-ob-tax-before.line-num           = v-line
     5998                       buf_fin-ob-tax-before.slt-pc             = buf_fin-gds-part.slt-pc
     5999                       buf_fin-ob-tax-before.vat-pc             = buf_fin-gds-part.vat-pc
     6000                       buf_fin-ob-tax-before.with-slt           = true
     6001                       buf_fin-ob-tax-before.with-vat           = true
     6002                       buf_fin-ob-tax-before.sum-line-rubl      = v-sum
     6003                       buf_fin-ob-tax-before.sum-slt-line-rubl  = buf_fin-ob-tax-before.slt-PC *    buf_fin-ob-tax-before.sum-line-rubl  / ( 100 + buf_fin-ob-tax-before.slt-PC )
     6004                       buf_fin-ob-tax-before.sum-vat-line-rubl  = buf_fin-ob-tax-before.vat-PC * (( buf_fin-ob-tax-before.sum-line-rubl  -         buf_fin-ob-tax-before.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax-before.vat-PC))
     6005                       buf_fin-ob-tax-before.sum-line-base       = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-line-rubl
     6006                       buf_fin-ob-tax-before.sum-line-doc        = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-line-rubl
     6007                       buf_fin-ob-tax-before.sum-line-contr      = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-line-rubl
     6008                       buf_fin-ob-tax-before.sum-slt-line-base    = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-slt-line-rubl
     6009                       buf_fin-ob-tax-before.sum-slt-line-doc     = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-slt-line-rubl
     6010                       buf_fin-ob-tax-before.sum-slt-line-contr   = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-slt-line-rubl
     6011                       buf_fin-ob-tax-before.sum-vat-line-base    = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-vat-line-rubl
     6012                       buf_fin-ob-tax-before.sum-vat-line-doc     = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-vat-line-rubl
     6013                       buf_fin-ob-tax-before.sum-vat-line-contr   = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-vat-line-rubl
     6014                       .
     6015                   assign
     6016                       buf_fin-ob-tax-before.with-slt-orig                = buf_fin-ob-tax-before.with-slt
     6017                       buf_fin-ob-tax-before.slt-pc-orig                  = buf_fin-ob-tax-before.slt-pc
     6018                       buf_fin-ob-tax-before.vat-pc-orig                  = buf_fin-ob-tax-before.vat-pc
     6019                       buf_fin-ob-tax-before.sum-slt-line-doc-orig        = buf_fin-ob-tax-before.sum-slt-line-doc
     6020                       buf_fin-ob-tax-before.sum-slt-line-base-orig       = buf_fin-ob-tax-before.sum-slt-line-base
     6021                       buf_fin-ob-tax-before.sum-slt-line-contr-orig      = buf_fin-ob-tax-before.sum-slt-line-contr
     6022                       buf_fin-ob-tax-before.sum-slt-line-rubl-orig       = buf_fin-ob-tax-before.sum-slt-line-rubl
     6023                       buf_fin-ob-tax-before.with-vat-orig                = buf_fin-ob-tax-before.with-vat
     6024                       buf_fin-ob-tax-before.sum-vat-line-doc-orig        = buf_fin-ob-tax-before.sum-vat-line-doc
     6025                       buf_fin-ob-tax-before.sum-vat-line-base-orig       = buf_fin-ob-tax-before.sum-vat-line-base
     6026                       buf_fin-ob-tax-before.sum-vat-line-contr-orig      = buf_fin-ob-tax-before.sum-vat-line-contr
     6027                       buf_fin-ob-tax-before.sum-vat-line-rubl-orig       = buf_fin-ob-tax-before.sum-vat-line-rubl
     6028                   .
     6029                   assign
     6030                       v-tax-sum-rubl                    = v-tax-sum-rubl + buf_fin-ob-tax-before.sum-slt-line-rubl   + buf_fin-ob-tax-before.sum-vat-line-rubl
     6031                       v-tax-sum-base                    = v-tax-sum-base + buf_fin-ob-tax-before.sum-slt-line-base   + buf_fin-ob-tax-before.sum-vat-line-base
     6032                       v-tax-sum-contr                   = v-tax-sum-contr + buf_fin-ob-tax-before.sum-slt-line-contr + buf_fin-ob-tax-before.sum-vat-line-contr
     6033                       v-tax-sum-doc                     = v-tax-sum-doc + buf_fin-ob-tax-before.sum-slt-line-doc     + buf_fin-ob-tax-before.sum-vat-line-doc
     6034                   .
     6035                   v-sum  = 0 .
     6036                 end.
     6037       end.
     6038       buf_fin-ob-before.sum-tax-doc   = v-tax-sum-doc .
     6039       buf_fin-ob-before.sum-tax-rubl  = v-tax-sum-rubl .
     6040       buf_fin-ob-before.sum-tax-base  = v-tax-sum-base .
     6041       buf_fin-ob-before.sum-tax-contract = v-tax-sum-contr .
     6042       v-tax-sum-rubl = 0 .
     6043       v-tax-sum-base = 0 .
     6044       v-tax-sum-contr = 0 .
     6045       v-tax-sum-doc  = 0 .
     6046   end.
     6047    end.
     6048   end procedure.
