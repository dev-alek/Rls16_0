        1   block-level on error undo, throw.
        2   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
        3   define input parameter parparentproc  as widget-handle no-undo.
        4   define input parameter par-host-code  like ub.clients.obj-code no-undo.
        5   define input parameter p-date-end     as date no-undo    .
        6   define input parameter p-trn-doc      as integer no-undo .
        7   define input parameter p-cons         as integer no-undo .
        8   define input parameter p-nalog        as integer no-undo .
        9   define input parameter table for tt-trn-doc .
       10   define input-output parameter p-res as character no-undo .
       11   define input  parameter p-type-date as integer   no-undo .
       12   define input  parameter p-adm       as logical   no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: gen-flp.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/gen-flp.p $":U .
       18   define variable vss-description as character no-undo init "процедура генерации Фин Об по заданным параметрам".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define new global shared variable g#language as character no-undo .
      119   if g#language <> '' and g#language <> 'rus':U then do:
      120     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      121   end.
      122   define new global shared variable g#library  as handle no-undo .
      123   define new global shared variable g#library2 as handle no-undo .
      124   define   shared variable g#auto as logical no-undo.
      125   define   shared variable g#news as logical no-undo.
      126   define   shared variable g#oxml as logical no-undo.
      127   define   shared variable g#esys as logical no-undo.
      128   define   shared variable g#news-source-db as integer no-undo.
      129   define   shared variable g#esys-source-esys as integer no-undo.
      130   define   shared variable g#db-num as integer   no-undo .
      131   define   shared variable g#userid as character no-undo .
      132   define   shared variable g#passwd as character no-undo .
      133   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable v-waitfram-action01         as character   no-undo .
      135   define variable v-waitfram-action02         as character   no-undo .
      136   define variable v-waitfram-action03         as character   no-undo .
      137   define variable mWaitFramTextBeg            as character   no-undo.
      138   define variable mWaitFramTextEnd            as character   no-undo.
      139   define variable mWaitFramView               as logical     no-undo.
      140   define variable mWaitProcEvent              as logical     no-undo init yes.
      141   define variable mWaitFramInterval           as integer     no-undo init 1 .
      142   define variable mWaitFramStop               as logical     no-undo.
      143   define variable mWaitFramStopUser           as logical     no-undo.
      144   define variable mWaitFramStopTimeOut        as logical     no-undo.
      145   define variable mWaitFramStartProc          as datetime-tz no-undo.
      146   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      147   define button B-WaitFramStop auto-end-key
      148        label "Стоп"
      149        size 10 by 1 tooltip "Остоновить процесс".
      150   define button B-viewProcInfo
      151        label "Информация"
      152        size 15 by 1 tooltip "Информация о процесс".
      153   define frame waitfram
      154     v-waitfram-action01 format "x(72)" no-label skip
      155     v-waitfram-action02 format "x(72)" no-label skip
      156     v-waitfram-action03 format "x(72)" no-label skip
      157     B-viewProcInfo
      158     B-WaitFramStop at row 4 col 30
      159     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      160     .
      161   define new global shared variable mBatchMode as logical no-undo init ?.
      162   define variable mFramBachModHandle as handle no-undo.
      163   mFramBachModHandle = frame waitfram:handle.
      164   define variable mFameOldVis as logical no-undo.
      165   define variable mVisCUrentVin as logical no-undo.
      166   if session:batch-mode
      167   then
      168      mBatchMode = yes.
      169   if mBatchMode = ? then do:
      170     mVisCUrentVin = current-window:visible.
      171     mFameOldVis = mFramBachModHandle:visible.
      172     mFramBachModHandle:visible  = yes.
      173     mBatchMode = mFramBachModHandle:visible ne yes.
      174     mFramBachModHandle:visible = mFameOldVis.
      175     current-window:visible = mVisCUrentVin.
      176   end.
      177    if  log-manager:logfile-name ne ?
      178     then DO:
      179         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      180         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      181         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      182     end.
      183   on choose of B-WaitFramStop in frame waitfram
      184   do:
      185     mWaitFramStop = yes.
      186     mWaitFramStopUser = yes.
      187   end.
      188   function waitfram-check-timeout returns logical():
      189      define variable vtime as int64 no-undo.
      190      if mWaitFramStopTimeOut
      191      then
      192         return yes.
      193      vtime = ( now - mWaitFramStartProc ) / 1000 .
      194      if     mWaitFramTimeOut ne ?
      195         and mWaitFramTimeOut ne 0
      196         and mWaitFramTimeOut lt vtime
      197      then do:
      198         mWaitFramStopTimeOut = yes.
      199      end.
      200      return mWaitFramStopTimeOut.
      201   end.
      202   procedure waitfram-hide :
      203     if not session:batch-mode
      204     then do
      205     on error undo, return error return-value
      206     :
      207       pause 0 before-hide .
      208       if not mBatchMode then
      209         hide frame waitfram .
      210     if     not mWaitFramView
      211        and mWaitProcEvent
      212     then
      213       process events .
      214     end.
      215   end procedure.
      216   procedure waitfram-show :
      217     define input  parameter p-message as character no-undo .
      218     define variable v-left-margin as integer   no-undo .
      219     if not session:batch-mode
      220     then do
      221     on error undo, return error return-value
      222     :
      223       if length(p-message) <= 70 then do:
      224         assign
      225           v-left-margin = integer((70 - length(p-message)) / 2)
      226         .
      227         assign
      228           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      229         .
      230         assign
      231           v-waitfram-action01 = " "
      232           v-waitfram-action02 = " "
      233                                    + fill(" ", v-left-margin)
      234                                    + p-message
      235           v-waitfram-action03 = " "
      236         .
      237       end.
      238       else do:
      239         define variable vRindex1 as integer no-undo.
      240         define variable vRindex2 as integer no-undo.
      241         vRindex1 = r-index(p-message," ",70).
      242         if vRindex1 = 0
      243         then
      244            vRindex1 = 70.
      245         if length(p-message)  <= vRindex1 + 70 then do:
      246           assign
      247             v-waitfram-action01 = " "
      248             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      250           .
      251         end.
      252         else do:
      253           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      254           if vRindex2 <= vRindex1
      255           then
      256              vRindex2 = vRindex1 + 70.
      257           assign
      258             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      259             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      260             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      261           .
      262         end.
      263       end.
      264       B-viewProcInfo:visible   in frame waitfram = no.
      265       B-viewProcInfo:sensitive in frame waitfram = no.
      266       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       if  (   mWaitFramView
      269          or  mWaitProcEvent)
      270          and not mBatchMode
      271       then
      272          display
      273             v-waitfram-action01 skip
      274             v-waitfram-action02 skip
      275             v-waitfram-action03 skip
      276          with frame waitfram .
      277       if     mWaitFramView
      278          then do:
      279             if     mWaitFramInterval ne ?
      280                and not mBatchMode
      281             then
      282                wait-for go of frame waitfram pause mWaitFramInterval.
      283          end.
      284          else
      285             if     mWaitProcEvent
      286                and not mBatchMode
      287             then
      288                process events .
      289     end.
      290   end procedure.
      291      procedure waitfram-show-this:
      292         define input  parameter iInterval as int64 no-undo.
      293         define variable vtime as int64 no-undo.
      294         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      295         mWaitFramInterval = iInterval.
      296         run waitfram-show (substitute("&1&2 &3&4" ,
      297                                       mWaitFramTextBeg ,
      298                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      299                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      300                                       mWaitFramTextEnd
      301                                      )
      302                           ).
      303      end.
      304      procedure WaitFramRunPause:
      305         define input  parameter iInterval as dec no-undo.
      306         define variable vStart  as datetime-tz no-undo.
      307         define variable vend    as datetime-tz no-undo.
      308         define variable vint as int64 no-undo.
      309         define variable vOk as logical no-undo.
      310         vStart = now.
      311         vend   = vStart.
      312         publish "WaitFramPause" (iInterval,output vOk).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and (   vint > 0
      318                 or (    not vOk
      319                     and iInterval eq ?
      320                     )
      321                 )
      322         then
      323            run waitfram-show-this (iInterval).
      324         vend   =  now.
      325         vint = vend - vStart.
      326         vint = iInterval - vint / 1000.
      327         if     not mWaitFramStop
      328            and vint > 0
      329         then do:
      330            run gbl/pause.p (vint * 1000).
      331         end.
      332         if iInterval ne ?
      333         then
      334            publish "WaitFramStop".
      335         waitfram-check-timeout().
      336      end.
      337      procedure WaitFramWaitFor:
      338         define input  parameter iInterval as dec no-undo.
      339         assign
      340            mWaitFramStartProc   = now
      341            mWaitFramStopUser    = no
      342            mWaitFramStopTimeOut = no
      343         .
      344         block-wait:
      345         do while not mWaitFramStop:
      346            run WaitFramRunPause (iInterval).
      347            if  waitfram-check-timeout()
      348            then do:
      349               leave block-wait.
      350            end.
      351         end.
      352         run waitfram-hide.
      353      end.
      354   procedure waitfram-join :
      355     define input  parameter p-line-1  as character no-undo .
      356     define input  parameter p-line-2  as character no-undo .
      357     define input  parameter p-line-3  as character no-undo .
      358     define output parameter p-message as character no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362       assign
      363         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      366       .
      367     end.
      368   end procedure.
      369   function waitfram-join-function returns character
      370     (input p-line-1 as character
      371     ,input p-line-2 as character
      372     ,input p-line-3 as character
      373     ).
      374     define variable v-message as character no-undo .
      375     run waitfram-join in this-procedure
      376       (input  p-line-1
      377       ,input  p-line-2
      378       ,input  p-line-3
      379       ,output v-message
      380       ) .
      381     return v-message .
      382   end function .
      383   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure cur-time :
      385      define output parameter p-today as date      no-undo .
      386      define output parameter p-time  as integer   no-undo .
      387     do
      388     on error undo, return error
      389     :
      390       define variable v-date1 as date      no-undo .
      391       define variable v-date2 as date      no-undo .
      392       define variable v-time  as integer   no-undo .
      393       assign
      394         v-date1 = today
      395         v-time  = time
      396         v-date2 = today
      397       .
      398       if v-date1 <> v-date2
      399       then do:
      400         assign
      401           v-date1 = today
      402           v-time  = v-time
      403         .
      404       end.
      405       assign
      406         p-today = v-date1
      407         p-time  = v-time
      408       .
      409     end.
      410   end.
      411   function cur-time-date returns character
      412   :
      413     return string(today, '99/99/9999':U) .
      414   end.
      415   function cur-time-mjd returns decimal
      416   :
      417     define variable v-date as date      no-undo .
      418     define variable v-time as integer   no-undo .
      419     run cur-time in this-procedure
      420       (output v-date
      421       ,output v-time
      422       ) .
      423     return integer(v-date) - 2400002 + (v-time / 86400) .
      424   end.
      425   function cur-time-get-ending-index returns integer
      426   (input p-number as integer
      427   )
      428   :
      429     if p-number < 0
      430     or p-number = ?
      431     then do:
      432       return 1 .
      433     end.
      434     define variable v-rest as integer   no-undo .
      435     assign
      436       p-number = p-number modulo 100
      437     .
      438     if p-number < 20
      439     then do:
      440       assign
      441         v-rest = p-number
      442       .
      443     end.
      444     else do:
      445       assign
      446         v-rest = p-number modulo 10
      447       .
      448     end.
      449     case v-rest :
      450       when 1
      451       then do:
      452         return 2 .
      453       end.
      454       when 2 or
      455       when 3 or
      456       when 4
      457       then do:
      458         return 3 .
      459       end.
      460       otherwise do:
      461         return 1 .
      462       end.
      463     end case .
      464   end.
      465   procedure cur-time-mjd-to-date :
      466      define input  parameter i-mjd-diff as decimal no-undo.
      467      define output parameter o-Date     as date    no-undo.
      468      define output parameter o-Time     as integer no-undo.
      469      define variable v-day-number as integer   no-undo .
      470      if    i-mjd-diff < 0
      471         or i-mjd-diff = ?
      472      then do:
      473         return "?" .
      474      end.
      475      assign
      476         v-day-number = truncate(i-mjd-diff,0).
      477         o-Date = date(v-day-number + 2400002).
      478         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      479     .
      480   end.
      481   function cur-time-mjd-to-string returns character
      482   (input p-mjd-diff as decimal
      483   )
      484   :
      485     define variable v-day-number as integer   no-undo .
      486     define variable v-seconds    as integer   no-undo .
      487     define variable v-hour       as integer   no-undo .
      488     define variable v-min        as integer   no-undo .
      489     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      490     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      491     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      492     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      493     if p-mjd-diff < 0
      494     or p-mjd-diff = ?
      495     then do:
      496       return "?" .
      497     end.
      498     assign
      499       v-day-number = integer(truncate(p-mjd-diff,0))
      500       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      501     .
      502     if v-seconds > 86400
      503     then do:
      504       assign
      505         v-seconds = 86400 - 1
      506       .
      507     end.
      508     if v-seconds < 0
      509     then do:
      510       assign
      511         v-seconds = 0
      512       .
      513     end.
      514     assign
      515       v-hour = truncate(v-seconds / 3600, 0)
      516     .
      517     assign
      518       v-seconds = v-seconds modulo 3600
      519     .
      520     assign
      521       v-min = truncate(v-seconds / 60, 0)
      522     .
      523     assign
      524       v-seconds = v-seconds modulo 60
      525     .
      526     return
      527         (if v-day-number <> 0
      528           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      529           else ""
      530         )
      531       + (if v-day-number <> 0 or v-hour <> 0
      532           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      533           else ""
      534         )
      535       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      536           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      537           else ""
      538         )
      539       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      540       .
      541   end.
      542   function cur-time-string returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      551   end.
      552   function cur-time-string-sec returns character
      553   :
      554     define variable v-date as date      no-undo .
      555     define variable v-time as integer   no-undo .
      556     run cur-time in this-procedure
      557       (output v-date
      558       ,output v-time
      559       ) .
      560     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      561   end.
      562   function cur-time-custom  returns character
      563   (input p-prefix as character
      564   ,input p-date-format as character
      565   ,input p-delimiter as character
      566   ,input p-time-format as character
      567   ,input p-suffix as character
      568   )
      569   :
      570     define variable v-date as date      no-undo .
      571     define variable v-time as integer   no-undo .
      572     run cur-time in this-procedure
      573       (output v-date
      574       ,output v-time
      575       ) .
      576     return
      577       p-prefix
      578       + string(v-date, p-date-format)
      579       + p-delimiter
      580       + string(v-time, p-time-format)
      581       + p-suffix
      582       .
      583   end.
      584   function cur-time-print  returns character
      585   :
      586     define variable v-date as date      no-undo .
      587     define variable v-time as integer   no-undo .
      588     run cur-time in this-procedure
      589       (output v-date
      590       ,output v-time
      591       ) .
      592     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      593   end.
      594   function cur-time-datetime returns datetime
      595   :
      596     define variable v-char as character no-undo .
      597     define variable v-datetime as datetime no-undo .
      598     v-char = cur-time-string().
      599     v-datetime = datetime(v-char).
      600     return  v-datetime.
      601   end.
      602   function cur-time-string-msec returns character
      603   :
      604     define variable v-date as datetime  no-undo .
      605     v-date = now.
      606     return string(v-date) .
      607   end.
      608   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define buffer buf_file for ub.fin-ob .
      610   procedure current-db :
      611    do
      612    on error undo, return error return-value
      613    :
      614   define input parameter  p-host-code as integer no-undo .
      615   define input parameter  c-host-code as integer no-undo .
      616   define output parameter ret         as logical no-undo .
      617   define buffer current_sysconf for ub.sysconf.
      618   define variable v-current-db as integer no-undo .
      619   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      620   if error-status :error then return error .
      621      v-current-db = current_sysconf.firm-db-num .
      622      ret = true .
      623   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      624   if not( ub.sysconf.firm-db-num = v-current-db or
      625           ub.sysconf.firm-db-num = 0 )
      626     then do:
      627     ret = false .
      628     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      629     return .
      630   end.
      631    end.
      632   end procedure.
      633   procedure ver-db :
      634    do
      635    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      636    :
      637   define input parameter  c-host-code as integer no-undo .
      638   define input parameter  par-ver-db  as integer no-undo .
      639   define input parameter  p-mess as logical no-undo .
      640   define output parameter ret         as logical no-undo .
      641   define buffer current_sysconf for ub.sysconf.
      642   define variable v-current-db as integer no-undo .
      643   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      644   if error-status :error then return error .
      645      v-current-db = current_sysconf.firm-db-num .
      646      ret = true .
      647   if not( par-ver-db = v-current-db or
      648           par-ver-db = 0 )
      649     then do:
      650     ret = false .
      651     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      652     return .
      653   end.
      654    end.
      655   end procedure.
      656   procedure fin-ob-code :
      657    do
      658    on error undo, return error return-value
      659    :
      660     define input  parameter p-db-num as integer no-undo .
      661     define output parameter p-fin-ob-code  as character no-undo .
      662     if p-db-num = 0 then
      663         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
      664         else
      665         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
      666    end.
      667   end procedure.
      668   procedure create-fin-liab :
