     6245                 buf_fin-ob-trn.host-code      = par-host-code
     6246                 buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     6247                 buf_fin-ob-trn.sum-tax-rubl   = n-sum-tax-rubl
     6248                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     6249               .
     6250               end.
     6251                   find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = buf_trn-doc.doc-code no-error .
     6252                   if available buf2_trn-doc then do:
     6253                      if lookup( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)'  ) > 0 then do:
     6254                       assign
     6255                         buf2_trn-doc.cr-incfo   = true
     6256                         buf2_trn-doc.cr-incorexpfo = true
     6257                         buf2_trn-doc.incfo-date = today
     6258                       .
     6259                       if buf2_trn-doc.need-incfo = 2 then do:
     6260                         assign
     6261                           buf2_trn-doc.need-incfo      = 1
     6262                           buf2_trn-doc.need-expfo      = 0
     6263                           buf2_trn-doc.need-incorexpfo = 1
     6264                         .
     6265                       end.
     6266                     end.
     6267                     else do:
     6268                       assign
     6269                         buf2_trn-doc.cr-expfo   = true
     6270                         buf2_trn-doc.cr-incorexpfo = true
     6271                         buf2_trn-doc.expfo-date = today
     6272                       .
     6273                       if buf2_trn-doc.need-expfo = 2 then do:
     6274                         assign
     6275                           buf2_trn-doc.need-expfo      = 1
     6276                           buf2_trn-doc.need-incfo      = 0
     6277                           buf2_trn-doc.need-incorexpfo = 1
     6278                         .
     6279                       end.
     6280                     end.
     6281                       end.
     6282                     else message "test4" error-status :get-message(1) .
     6283           run make-fin-parts in this-procedure ( input p-doc-code , input 1 ) .
     6284           for each temp-parts  where temp-parts.contract-code = buf_contract.contract-code  : delete temp-parts . end.
     6285           run make-tax in this-procedure (
     6286                 input p-doc-code ,
     6287                 input par-host-code
     6288                 )                .
     6289           run update-fin-ob_obj in this-procedure (
     6290                 input p-doc-code ,
     6291                 input par-host-code
     6292                 )
     6293             .
     6294    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     6295    if error-status :error then
     6296       p-res = p-res + chr(10) +  " Ошибка при закрытии на факт ФО " + return-value  + error-status :get-message(1) .
     6297    end.
     6298   end procedure.
     6299   procedure close-fo-fact :
     6300    do
     6301    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6302    :
     6303   define input parameter p-host-code as integer no-undo .
     6304   define input parameter p-doc-code  as character no-undo .
     6305   define buffer buf_fact-fin-ob   for fin-ob .
     6306   define buffer buf_fact-contract for contract .
     6307   find first buf_fact-fin-ob  no-lock where buf_fact-fin-ob.host-code = p-host-code and
     6308                                             buf_fact-fin-ob.doc-code  = p-doc-code no-error .
     6309                                             if error-status :error then
     6310                                             do:
     6311                                             return  error .
     6312                                             end.
     6313     find first buf_fact-contract no-lock where  buf_fact-contract.host-code = buf_fact-fin-ob.host-code and
     6314                                                 buf_fact-contract.contract-code = buf_fact-fin-ob.contract-code no-error .
     6315                                                 if error-status :error then
     6316                                                 do:
     6317                                                 return  error .
     6318                                                 end.
     6319     if buf_fact-contract.auto-pay  > 0 then do:
     6320         run proc-close-one-fin-ob in this-procedure (recid(buf_fact-fin-ob)) no-error .
     6321         if error-status :error then do:
     6322            message vss-workfile vss-revision vss-description skip
     6323                   "№ ФО :" buf_fact-fin-ob.doc-code skip
     6324                   "№ фирмы :" buf_fact-fin-ob.host-code skip
     6325                   "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     6326                   "Ошибка закрытия на факт ФО на ПН " skip
     6327                    skip
     6328                    error-status :get-message(1) skip
     6329                    return-value skip
     6330                    view-as alert-box error
     6331            .
     6332            return error .
     6333         end.
     6334         if buf_fact-contract.auto-pay > 1 then do:
     6335            run str/payfoavt.p ( input parParentProc, input par-host-code, input recid(buf_fact-fin-ob)) no-error .
     6336            if error-status :error then do:
     6337               message vss-workfile vss-revision vss-description skip
     6338                       "№ ФО :" buf_fact-fin-ob.doc-code skip
     6339                       "№ фирмы :" buf_fact-fin-ob.host-code skip
     6340                       "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     6341                       "Ошибка автоматического создания платежа . Вернула процедура  payfoavt.p " skip
     6342                       "ЭТО ПРОЦЕДУРА КОЧЕТКОВА "
     6343                       skip
     6344                       error-status :get-message(1) skip
     6345                       return-value skip
     6346                       view-as alert-box error
