     5733   define variable p-ri       as recid   no-undo .
     5734   define variable p-doc-code             like         ub.fin-ob.doc-code         no-undo .
     5735   define variable n-doc-date             like         ub.fin-ob.doc-date         no-undo .
     5736   define variable n-doc-type             like     ub.fin-ob.doc-type             no-undo .
     5737   define variable n-payer-name           like         ub.fin-ob.payer-name       no-undo .
     5738   define variable n-receiver-name        like         ub.fin-ob.receiver-name    no-undo .
     5739   define variable n-curr-code            like         ub.fin-ob.curr-code        no-undo .
     5740   define variable n-sum-doc              like         ub.fin-ob.sum-doc          no-undo .
     5741   define variable n-user-db-num-doc      like         ub.fin-ob.user-db-num-doc  no-undo .
     5742   define variable n-user-name-doc        like         ub.fin-ob.user-name-doc    no-undo .
     5743   define variable n-base-rate            like         ub.fin-ob.base-rate        no-undo .
     5744   define variable n-base-scale           like         ub.fin-ob.base-scale       no-undo .
     5745   define variable n-receiver-code        like         ub.fin-ob.receiver-code    no-undo .
     5746   define variable n-receiver-type        like         ub.fin-ob.receiver-type    no-undo .
     5747   define variable n-contract-code        like         ub.fin-ob.contract-code    no-undo .
     5748   define variable n-exch-rate            like         ub.fin-ob.exch-rate        no-undo .
     5749   define variable n-exch-scale           like         ub.fin-ob.exch-scale       no-undo .
     5750   define variable n-contract-curr        like         ub.fin-ob.contract-curr    no-undo .
     5751   define variable n-contract-rate        like         ub.fin-ob.contract-rate    no-undo .
     5752   define variable n-contract-scale       like         ub.fin-ob.contract-scale   no-undo .
     5753   define variable n-fact-date            like         ub.fin-ob.fact-date        no-undo .
     5754   define variable n-fact-order           like         ub.fin-ob.fact-order       no-undo .
     5755   define variable n-payer-code           like         ub.fin-ob.payer-code       no-undo .
     5756   define variable n-payer-type           like         ub.fin-ob.payer-type       no-undo .
     5757   define variable n-pay-date             like         ub.fin-ob.pay-date         no-undo .
     5758   define variable n-prn-doc-code         like         ub.fin-ob.prn-doc-code     no-undo .
     5759   define variable n-sum-base-orig        like         ub.fin-ob.sum-base-orig    no-undo .
     5760   define variable n-sum-base             like         ub.fin-ob.sum-base         no-undo .
     5761   define variable n-sum-doc-orig         like         ub.fin-ob.sum-doc-orig     no-undo .
     5762   define variable n-sum-rubl-orig        like         ub.fin-ob.sum-rubl-orig    no-undo .
     5763   define variable n-sum-rubl             like         ub.fin-ob.sum-rubl         no-undo .
     5764   define variable n-sum-contract         like         ub.fin-ob.sum-contract     no-undo .
     5765   define variable n-trn-doc-code         like         ub.fin-ob.trn-doc-code     no-undo .
     5766   define variable n-trn-doc-code-orig    like         ub.fin-ob.trn-doc-code     no-undo .
     5767   define variable n-user-db-num-fact     like         ub.fin-ob.user-db-num-fact no-undo .
     5768   define variable n-user-db-num-pay      like         ub.fin-ob.user-db-num-pay  no-undo .
     5769   define variable n-user-name-fact       like         ub.fin-ob.user-name-fact   no-undo .
     5770   define variable n-user-name-pay        like         ub.fin-ob.user-name-pay    no-undo .
     5771   define variable n-in-type              like         ub.fin-ob.in-type          no-undo .
     5772   define variable n-sum-tax-base         like         ub.fin-ob.sum-tax-base     no-undo .
     5773   define variable n-sum-tax-doc          like         ub.fin-ob.sum-tax-doc      no-undo .
     5774   define variable n-sum-tax-rubl         like         ub.fin-ob.sum-tax-rubl     no-undo .
     5775   define variable n-sum-tax-contract     like         ub.fin-ob.sum-tax-contract no-undo .
     5776   define variable n-obj-code             like         ub.fin-ob.obj-code       no-undo .
     5777   define variable n-obj-type             like         ub.fin-ob.obj-type       no-undo .
     5778   define variable col-part   as integer   no-undo .
