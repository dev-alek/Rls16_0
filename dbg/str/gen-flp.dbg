     4853                     assign
     4854                             var-sum-rubl     = var-sum-rubl     + (-1) * abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc))
     4855                             var-sum-contract = var-sum-contract + (-1) * abs(tt-allsum.sum-dsc-cli-acc )
     4856                             var-sum-base     = var-sum-base     + (-1) * abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc))
     4857                     .
     4858                     create temp-parts.
     4859                     BUFFER-COPY buf_parts to temp-parts
     4860                     assign
     4861                       temp-parts.cli-qnty       =  (-1) * abs( buf_parts.cli-qnty)
     4862                       temp-parts.fact-qnty      =  (-1) * abs( buf_parts.fact-qnty)
     4863                       temp-parts.qnty           =  (-1) * abs( buf_parts.qnty     )
     4864                       temp-parts.gds-code       =  buf_goods.gds-code
     4865                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     4866                       var-income-in-code        =  buf_parts-attr.income-in-code
     4867                     .
     4868               if last-of(buf_parts.contract-code) or (p-nalog = 2 and last-of(buf_parts.vat-pc)) then do:
     4869                 run make-fo-corr-acc in this-procedure
     4870                   ( input var-sum-rubl ,
     4871                     input var-sum-base ,
     4872                     input var-sum-contract )
     4873                     no-error .
     4874                 if error-status :error then p-res = p-res + chr(10) + error-status :get-message(1) .
     4875                 var-sum-rubl      = 0 .
     4876                 var-sum-rublb     = 0 .
     4877                 var-sum-base      = 0 .
     4878                 var-sum-baseb     = 0 .
     4879                 var-sum-contract  = 0 .
     4880                 var-sum-contractb = 0 .
     4881               end.
     4882         end.
     4883   var-sum-rubl  = 0 .
     4884   var-sum-rublb = 0 .
     4885   var-sum-base      = 0 .
     4886   var-sum-baseb     = 0 .
     4887   var-sum-contract  = 0 .
     4888   var-sum-contractb = 0 .
     4889         for each buf_parts no-lock where buf_parts.out-code  = buf_trn-doc.doc-code   and
     4890                                          buf_parts.in-code   = buf_trn-doc.doc-code   and
     4891                                          buf_parts.host-code = buf_trn-doc.host-code  and
     4892                                          buf_parts.obj-type  = buf_trn-doc.obj-type   and
     4893                                          buf_parts.obj-code  = buf_trn-doc.obj-code   and
     4894                                          buf_parts.fact-qnty >= 0     ,
     4895                 first buf_goods no-lock where buf_goods.artic     = buf_parts.artic      and
     4896                                               buf_goods.prod-type = buf_parts.prod-type  and
     4897                                               buf_goods.prod-code = buf_parts.prod-code ,
     4898                 first buf_contract no-lock where buf_contract.contract-code = buf_parts.contract-code and
     4899                                                  buf_contract.host-code     = buf_parts.host-code     and
     4900                                                  lookup(buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0 and
     4901                                                  v-flag-po = false
     4902                 and ( can-find (first old_fin-gds-part no-lock where
     4903                                       old_fin-gds-part.obj-type  = buf_parts.obj-type  and
     4904                                       old_fin-gds-part.obj-code  = buf_parts.obj-code  and
     4905                                       old_fin-gds-part.gds-code  = buf_goods.gds-code  and
     4906                                       old_fin-gds-part.in-code   = buf_parts.in-code   and
     4907                                       old_fin-gds-part.part-code = buf_parts.part-code and
     4908                                       old_fin-gds-part.doc-type  = ""                  and
     4909                                       old_fin-gds-part.out-code  = buf_parts.out-code  )
     4910                       = false )
     4911                 break
     4912                       by buf_parts.contract-code
     4913                       by buf_parts.vat-pc
     4914                       on error undo, return error :
     4915                 run clc-price in this-procedure .
     4916                 find first buf_parts-attr no-lock where buf_parts-attr.in-code   = buf_parts.in-code   and
     4917                                                    buf_parts-attr.part-code = buf_parts.part-code and
     4918                                                    buf_parts-attr.gds-code  = buf_goods.gds-code .
     4919                     assign
     4920                             var-sum-rubl     = var-sum-rubl     +  abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc))
     4921                             var-sum-contract = var-sum-contract +  abs(tt-allsum.sum-dsc-cli-acc )
     4922                             var-sum-base     = var-sum-base     +  abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc))
     4923                     .
     4924                     create temp-parts.
     4925                     BUFFER-COPY buf_parts to temp-parts
     4926                     assign
     4927                       temp-parts.cli-qnty       =  abs( buf_parts.cli-qnty  )
     4928                       temp-parts.fact-qnty      =  abs( buf_parts.fact-qnty )
     4929                       temp-parts.qnty           =  abs( buf_parts.qnty      )
     4930                       temp-parts.gds-code       =  buf_goods.gds-code
     4931                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     4932                       var-income-in-code        =  buf_parts-attr.income-in-code
     4933                     .
     4934               if last-of(buf_parts.contract-code) or (p-nalog = 2 and last-of(buf_parts.vat-pc)) then do:
     4935                 run make-fo-corr-acc in this-procedure
     4936                 (  input var-sum-rubl ,
     4937                    input var-sum-base ,
     4938                    input var-sum-contract ) no-error .
     4939                 if error-status :error then p-res = p-res + chr(10) + error-status :get-message(1) .
     4940                 var-sum-rubl = 0 .
     4941                 var-sum-rublb = 0 .
     4942                 var-sum-base      = 0 .
     4943                 var-sum-baseb     = 0 .
     4944                 var-sum-contract  = 0 .
     4945                 var-sum-contractb = 0 .
     4946               end.
     4947         end.
     4948    end.
     4949   end procedure.
     4950   procedure make-fo :
     4951    do
     4952    on error undo, return error return-value
     4953    :
     4954   define input parameter v-sum-rubl as decimal no-undo .
     4955   define input parameter v-sum-base as decimal no-undo .
     4956   define input parameter v-sum-contract as decimal no-undo .
     4957   define variable pfo as logical no-undo .
     4958    pfo = false  .
     4959   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4960   define variable p-ri       as recid   no-undo .
     4961   define variable p-doc-code             like         ub.fin-ob.doc-code         no-undo .
     4962   define variable n-doc-date             like         ub.fin-ob.doc-date         no-undo .
     4963   define variable n-doc-type             like     ub.fin-ob.doc-type             no-undo .
     4964   define variable n-payer-name           like         ub.fin-ob.payer-name       no-undo .
     4965   define variable n-receiver-name        like         ub.fin-ob.receiver-name    no-undo .
     4966   define variable n-curr-code            like         ub.fin-ob.curr-code        no-undo .
     4967   define variable n-sum-doc              like         ub.fin-ob.sum-doc          no-undo .
     4968   define variable n-user-db-num-doc      like         ub.fin-ob.user-db-num-doc  no-undo .
     4969   define variable n-user-name-doc        like         ub.fin-ob.user-name-doc    no-undo .
     4970   define variable n-base-rate            like         ub.fin-ob.base-rate        no-undo .
     4971   define variable n-base-scale           like         ub.fin-ob.base-scale       no-undo .
     4972   define variable n-receiver-code        like         ub.fin-ob.receiver-code    no-undo .
     4973   define variable n-receiver-type        like         ub.fin-ob.receiver-type    no-undo .
     4974   define variable n-contract-code        like         ub.fin-ob.contract-code    no-undo .
     4975   define variable n-exch-rate            like         ub.fin-ob.exch-rate        no-undo .
     4976   define variable n-exch-scale           like         ub.fin-ob.exch-scale       no-undo .
     4977   define variable n-contract-curr        like         ub.fin-ob.contract-curr    no-undo .
     4978   define variable n-contract-rate        like         ub.fin-ob.contract-rate    no-undo .
     4979   define variable n-contract-scale       like         ub.fin-ob.contract-scale   no-undo .
     4980   define variable n-fact-date            like         ub.fin-ob.fact-date        no-undo .
     4981   define variable n-fact-order           like         ub.fin-ob.fact-order       no-undo .
     4982   define variable n-payer-code           like         ub.fin-ob.payer-code       no-undo .
     4983   define variable n-payer-type           like         ub.fin-ob.payer-type       no-undo .
     4984   define variable n-pay-date             like         ub.fin-ob.pay-date         no-undo .
     4985   define variable n-prn-doc-code         like         ub.fin-ob.prn-doc-code     no-undo .
     4986   define variable n-sum-base-orig        like         ub.fin-ob.sum-base-orig    no-undo .
     4987   define variable n-sum-base             like         ub.fin-ob.sum-base         no-undo .
     4988   define variable n-sum-doc-orig         like         ub.fin-ob.sum-doc-orig     no-undo .
     4989   define variable n-sum-rubl-orig        like         ub.fin-ob.sum-rubl-orig    no-undo .
     4990   define variable n-sum-rubl             like         ub.fin-ob.sum-rubl         no-undo .
     4991   define variable n-sum-contract         like         ub.fin-ob.sum-contract     no-undo .
     4992   define variable n-trn-doc-code         like         ub.fin-ob.trn-doc-code     no-undo .
     4993   define variable n-trn-doc-code-orig    like         ub.fin-ob.trn-doc-code     no-undo .
     4994   define variable n-user-db-num-fact     like         ub.fin-ob.user-db-num-fact no-undo .
     4995   define variable n-user-db-num-pay      like         ub.fin-ob.user-db-num-pay  no-undo .
     4996   define variable n-user-name-fact       like         ub.fin-ob.user-name-fact   no-undo .
     4997   define variable n-user-name-pay        like         ub.fin-ob.user-name-pay    no-undo .
     4998   define variable n-in-type              like         ub.fin-ob.in-type          no-undo .
     4999   define variable n-sum-tax-base         like         ub.fin-ob.sum-tax-base     no-undo .
     5000   define variable n-sum-tax-doc          like         ub.fin-ob.sum-tax-doc      no-undo .
     5001   define variable n-sum-tax-rubl         like         ub.fin-ob.sum-tax-rubl     no-undo .
     5002   define variable n-sum-tax-contract     like         ub.fin-ob.sum-tax-contract no-undo .
     5003   define variable n-obj-code             like         ub.fin-ob.obj-code       no-undo .
     5004   define variable n-obj-type             like         ub.fin-ob.obj-type       no-undo .
     5005   define variable col-part   as integer   no-undo .
     5006   define variable n-abbr-doc as character no-undo .
     5007   define variable v-date-pay as date      no-undo .
     5008   define variable var-date as date no-undo .
     5009   if not available buf_contract then return .
     5010   if not can-find (first temp-parts no-lock ) then return .
     5011   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5012   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5013     (input  par-host-code
     5014     ,input  today
     5015     ,output n-base-rate
     5016     ,output n-base-scale
     5017     )  .
     5018     n-curr-code          = buf_contract.curr-code.
     5019   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5021     (input  n-curr-code
     5022     ,input  today
     5023     ,output n-exch-rate
     5024     ,output n-exch-scale
     5025     ,output n-abbr-doc
     5026     )  .
     5027   assign
     5028     n-doc-type            =  'рас':U
     5029     n-receiver-code       =  buf_contract.cli-code
     5030     n-receiver-type       =  buf_contract.cli-type
     5031     n-receiver-name       =  buf_contract.cli-name
     5032     n-payer-code          =  par-host-code
     5033     n-payer-type          =  'орг':U
     5034     n-payer-name          =  buf_contract.own-name
     5035   .
     5036    if lookup ( buf_contract.usl-opl , "По факту поставки,По факту реализации,По реализации части приход. накладной") > 0
     5037      then v-date-pay = today  .
     5038      else dO:
     5039           if p-cons = 2 and available   buf_trn-doc then do:
     5040               var-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     5041               if var-date < today then var-date = today.
     5042               v-date-pay = var-date.
     5043           end.
     5044      end.
     5045    if p-cons = 2 then do:
     5046         if available   buf_trn-doc
     5047            then
     5048            assign
     5049              n-trn-doc-code       =  buf_trn-doc.doc-code
     5050            .
     5051            else  n-trn-doc-code       = ?   .
     5052        end.
     5053        else do:
     5054          if pfo = true and available   buf_trn-doc
     5055            then  assign
     5056              n-trn-doc-code       =  buf_trn-doc.doc-code
     5057            .
     5058            else  n-trn-doc-code      = ?   .
     5059        end.
     5060   assign
     5061     n-user-db-num-doc    = g#db-num
     5062     n-user-name-doc      = g#userid
     5063     n-contract-code      = buf_contract.contract-code
     5064     n-contract-curr      = n-curr-code
     5065     n-contract-rate      = n-exch-rate
     5066     n-contract-scale     = n-exch-scale
     5067     n-pay-date           = v-date-pay
     5068     n-sum-rubl-orig      = v-sum-rubl
     5069     n-sum-base-orig      =     v-sum-base
     5070     n-sum-contract       =    v-sum-contract
     5071     n-sum-base           = n-sum-base-orig
     5072     n-sum-doc-orig       = n-sum-contract
     5073     n-sum-doc            = n-sum-contract
     5074     n-sum-rubl           = n-sum-rubl-orig
     5075     n-trn-doc-code-orig  = if available  buf_parts-attr then buf_parts-attr.income-in-code else  ?
     5076     n-in-type            = 0
     5077     n-sum-tax-base       = 0
     5078     n-sum-tax-doc        = 0
     5079     n-sum-tax-rubl       = 0
     5080     n-sum-tax-contract   = 0
     5081     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     5082    .
     5083     run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     5084     run create-fin-liab in this-procedure (
     5085           input yes ,
     5086           input  p-doc-code                       ,
     5087           input  n-doc-date            ,
     5088           input  n-doc-type           ,
     5089           input  n-payer-name         ,
     5090           input  n-receiver-name      ,
     5091           input  n-curr-code           ,
     5092           input  n-sum-doc             ,
     5093           input  n-user-db-num-doc     ,
     5094           input  n-user-name-doc       ,
     5095           input  n-base-rate           ,
     5096           input  n-base-scale          ,
     5097           input  n-receiver-code       ,
     5098           input  n-receiver-type       ,
     5099           input  n-contract-code       ,
     5100           input  n-exch-rate           ,
     5101           input  n-exch-scale          ,
     5102           input  n-contract-curr       ,
     5103           input  n-contract-rate       ,
     5104           input  n-contract-scale      ,
     5105           input  n-fact-date           ,
     5106           input  n-fact-order          ,
     5107           input  par-host-code         ,
     5108           input  n-payer-code          ,
     5109           input  n-payer-type          ,
     5110           input  n-pay-date            ,
     5111           input  string(p-doc-code)    ,
     5112           input  'авто':U            ,
     5113           input  n-sum-base-orig       ,
     5114           input  n-sum-base            ,
     5115           input  n-sum-doc-orig        ,
     5116           input  n-sum-rubl-orig       ,
     5117           input  n-sum-rubl            ,
     5118           input  n-sum-contract        ,
     5119           input  n-trn-doc-code        ,
     5120           input  n-user-db-num-fact    ,
     5121           input  n-user-db-num-pay        ,
     5122           input  n-user-name-fact         ,
     5123           input  n-user-name-pay          ,
     5124           input  n-in-type                ,
     5125           input  n-sum-tax-base           ,
     5126           input  n-sum-tax-doc            ,
     5127           input  n-sum-tax-rubl           ,
     5128           input  n-sum-tax-contract       ,
     5129           input  ""                       ,
     5130           output p-ri )
     5131           no-error .
     5132           define variable v-vv as character no-undo .
     5133           col-fo = col-fo + 1.
     5134           col-contract = col-contract + 1 .
     5135           find first  buf_fin-ob-trn exclusive-lock where
     5136                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     5137                 buf_fin-ob-trn.host-code      = par-host-code  and
     5138                 buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code  no-error .
     5139                 if not available  buf_fin-ob-trn then  do:
     5140                     create buf_fin-ob-trn.
     5141                     assign
     5142                       buf_fin-ob-trn.doc-code       = p-doc-code
     5143                       buf_fin-ob-trn.host-code      = par-host-code
     5144                       buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     5145                       buf_fin-ob-trn.trn-doc-code   =  buf_trn-doc.doc-code
     5146                     .
     5147                     v-vv = buf_fin-ob-trn.trn-doc-code .
     5148                     release buf_fin-ob-trn no-error .
     5149                 end.
     5150                find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = v-vv no-error .
     5151                   if available buf2_trn-doc then do:
     5152                      if lookup( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)'  ) > 0 then do:
     5153                       assign
     5154                         buf2_trn-doc.cr-incfo        = true
     5155                         buf2_trn-doc.cr-incorexpfo   = true
     5156                         buf2_trn-doc.incfo-date      = today
     5157                       .
     5158                       if buf2_trn-doc.need-incfo = 2 then do:
     5159                         assign
     5160                           buf2_trn-doc.need-incfo      = 1
     5161                           buf2_trn-doc.need-expfo      = 0
     5162                           buf2_trn-doc.need-incorexpfo = 1
     5163                         .
     5164                       end.
     5165                      end.
     5166                      else do:
     5167                           assign
     5168                             buf2_trn-doc.cr-expfo      = true
     5169                             buf2_trn-doc.cr-incorexpfo = true
     5170                             buf2_trn-doc.expfo-date    = today
     5171                           .
     5172                           if buf2_trn-doc.need-expfo = 2 then do:
     5173                             assign
     5174                               buf2_trn-doc.need-expfo      = 1
     5175                               buf2_trn-doc.need-incfo      = 0
     5176                               buf2_trn-doc.need-incorexpfo = 1
     5177                             .
     5178                           end.
     5179                      end.
     5180                   end.
     5181                   else
     5182                     message vss-workfile vss-revision vss-description skip
     5183                            "Ошибка  test2" skip
     5184                             "№ ФО :" p-doc-code skip
     5185                             "№ фирмы :" par-host-code skip
     5186                             skip
     5187                             error-status :get-message(1) skip
     5188                             return-value skip
     5189                             view-as alert-box error
     5190                     .
     5191      run make-fin-parts in this-procedure ( input p-doc-code , input 1 ) .
     5192     for each temp-parts where
     5193              temp-parts.contract-code = buf_contract.contract-code
     5194              :
     5195               delete temp-parts .
     5196     end.
     5197     run make-tax in this-procedure (
     5198           input p-doc-code ,
     5199           input par-host-code
     5200           )                .
     5201     run update-fin-ob_obj in this-procedure (
     5202           input p-doc-code ,
     5203           input par-host-code
     5204           )
     5205       .
     5206    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     5207    if error-status :error then
     5208       p-res = p-res + chr(10) + " Ошибка при закрытии на факт ФО " + return-value  + error-status :get-message(1) .
     5209   end.
     5210   end procedure.
     5211   procedure make-tt-fo :
     5212    do
     5213    on error undo, return error return-value
     5214    :
     5215   define input  parameter v-sum-rubl as decimal no-undo .
     5216   define input  parameter v-sum-base as decimal no-undo .
     5217   define input  parameter v-sum-contract as decimal no-undo .
     5218   define input  parameter v-pc as decimal   no-undo .
     5219     v-pc = if p-nalog = 1 then 0 else v-pc .
     5220    define variable pfo as logical no-undo .
     5221    pfo = false  .
     5222   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5223   define variable p-ri       as recid   no-undo .
     5224   define variable p-doc-code             like         ub.fin-ob.doc-code         no-undo .
     5225   define variable n-doc-date             like         ub.fin-ob.doc-date         no-undo .
     5226   define variable n-doc-type             like     ub.fin-ob.doc-type             no-undo .
     5227   define variable n-payer-name           like         ub.fin-ob.payer-name       no-undo .
     5228   define variable n-receiver-name        like         ub.fin-ob.receiver-name    no-undo .
     5229   define variable n-curr-code            like         ub.fin-ob.curr-code        no-undo .
     5230   define variable n-sum-doc              like         ub.fin-ob.sum-doc          no-undo .
     5231   define variable n-user-db-num-doc      like         ub.fin-ob.user-db-num-doc  no-undo .
     5232   define variable n-user-name-doc        like         ub.fin-ob.user-name-doc    no-undo .
