     6503           end.
     6504         if  min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     6505             then n-pay-date = n-doc-date .
     6506             else n-pay-date = min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     6507     run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     6508     run create-fin-liab in this-procedure (
     6509       input  yes                   ,
