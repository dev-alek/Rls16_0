     1479   procedure placelib_write-attr:
     1480   define input  parameter p-code     like ub.place-attr.attr-code .
     1481   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1482   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1483   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1484   define input  parameter p-value    like ub.place-attr.attr-value .
     1485   define output parameter p-ok       as logical.
     1486   define buffer buf_place-attr for ub.place-attr .
     1487     do on error undo, return error return-value :
     1488        p-ok = false.
     1489        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1490                                                   and buf_place-attr.obj-code    = p-obj-code
     1491                                                   and buf_place-attr.obj-type    = p-obj-type
     1492                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1493        if not available buf_place-attr then do :
     1494           create buf_place-attr.
     1495           assign
     1496             buf_place-attr.attr-code   = p-code
     1497             buf_place-attr.attr-value  = p-value
     1498             buf_place-attr.obj-code    = p-obj-code
     1499             buf_place-attr.obj-type    = p-obj-type
     1500             buf_place-attr.pl-code     = p-pl-code
     1501           .
     1502           p-ok = true.
     1503        end.
     1504        else do:
     1505           buf_place-attr.attr-value  = p-value .
     1506           p-ok = true.
     1507        end.
     1508     end.
     1509   end.
     1510   procedure placelib_get-attr:
     1511   define input  parameter  p-code     like ub.place-attr.attr-code .
     1512   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1513   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1514   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1515   define output parameter  p-value    like ub.place-attr.attr-value .
     1516   define output parameter  p-ok       as logical.
     1517   define buffer buf_place-attr for ub.place-attr .
     1518     do on error undo, return error return-value :
     1519        p-ok = false.
     1520        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1521                                                   and buf_place-attr.obj-code    = p-obj-code
     1522                                                   and buf_place-attr.obj-type    = p-obj-type
     1523                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1524        if available buf_place-attr then do :
     1525          p-value = buf_place-attr.attr-value.
     1526          p-ok = true.
     1527        end.
     1528        else do :
     1529          p-ok = false.
     1530        end.
     1531     end.
     1532   end.
     1533   procedure placelib_del-attr:
     1534   define input parameter  p-code     like ub.place-attr.attr-code .
     1535   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1536   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1537   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1538   define input parameter  p-value    like ub.place-attr.attr-value .
     1539   define output parameter p-ok       as logical.
     1540   define buffer buf_place-attr for ub.place-attr .
     1541     do on error undo, return error return-value :
     1542        p-ok = false.
     1543        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1544                                                   and buf_place-attr.obj-code    = p-obj-code
     1545                                                   and buf_place-attr.obj-type    = p-obj-type
     1546                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1547        if available buf_place-attr then do :
     1548           delete buf_place-attr.
     1549           p-ok = true.
     1550        end.
     1551     end.
     1552   end.
     1553   define   shared variable g#auto as logical no-undo.
     1554   define   shared variable g#news as logical no-undo.
     1555   define   shared variable g#oxml as logical no-undo.
     1556   define   shared variable g#esys as logical no-undo.
