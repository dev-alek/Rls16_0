     1636        SIZE 10 BY 1.
     1637   DEFINE BUTTON b-lkp
     1638        LABEL "Просмотр":L
     1639        SIZE 10 BY 1.
     1640   DEFINE BUTTON b-mark
     1641        LABEL "*":L
     1642        SIZE 3 BY 1.
     1643   DEFINE BUTTON b-print
     1644        LABEL "Печать":L
     1645        SIZE 7 BY 1.
     1646   DEFINE BUTTON b-quit AUTO-GO
     1647        LABEL "Выход":L
     1648        SIZE 10 BY 1.
     1649   DEFINE BUTTON b-sel
     1650        LABEL "Выбор":L
     1651        SIZE 10 BY 1.
     1652   DEFINE VARIABLE ed-notes AS CHARACTER
     1653        VIEW-AS EDITOR
     1654        SIZE 99 BY 2
     1655        BGCOLOR 8  NO-UNDO.
     1656   DEFINE VARIABLE f-agnt-name AS CHARACTER FORMAT "X(19)":U
     1657        LABEL "Исп"
     1658         VIEW-AS TEXT
     1659        SIZE 19.6 BY .67 NO-UNDO.
     1660   DEFINE VARIABLE f-boss-name AS CHARACTER FORMAT "X(19)":U
     1661        LABEL "М-р"
     1662         VIEW-AS TEXT
     1663        SIZE 19.6 BY .67 NO-UNDO.
     1664   DEFINE VARIABLE f-cre-name AS CHARACTER FORMAT "X(19)":U
     1665        LABEL "Опер"
     1666         VIEW-AS TEXT
     1667        SIZE 19.6 BY .67 NO-UNDO.
     1668   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(13)":U
     1669        LABEL "Объект"
     1670         VIEW-AS TEXT
     1671        SIZE 62.6 BY .67 NO-UNDO.
     1672   DEFINE VARIABLE f-wrkr-name AS CHARACTER FORMAT "X(19)":U
     1673        LABEL "Кл-к"
     1674         VIEW-AS TEXT
     1675        SIZE 19.6 BY .67 NO-UNDO.
     1676   DEFINE NEW SHARED QUERY br-r-docs for r-doc SCROLLING.
     1677   DEFINE BROWSE br-r-docs
     1678     QUERY br-r-docs DISPLAY
     1679        (substring (r-doc.rvs-type, 1, 9))  COLUMN-LABEL ' Tип '  FORMAT "x(20)"
     1680        autorvs (recid(r-doc))  COLUMN-LABEL ' '  FORMAT "x(2)"
     1681        r-doc.status_  COLUMN-LABEL 'Стат'  format "x(5)"
     1682        r-doc.rvs-code  column-label 'Документ'  format "x(15)"
     1683        (substring ((string (r-doc.doc-date)), 1, 5))  column-label 'Дата'
     1684        r-doc.fact-date  COLUMN-LABEL 'Факт'
     1685        string(r-doc.fact-time,'hh:mm:ss')  COLUMN-LABEL 'Время'
     1686        (substring ((string (r-doc.shift-date)), 1, 5))  COLUMN-LABEL 'Смена'  format "x(5)"
     1687        shift-name (recid(r-doc))  column-label '№'  format "x(10)"
     1688        obj-name (recid(r-doc)) column-label 'Объект'
     1689       WITH SEPARATORS SIZE 99 BY 16.76.
     1690   DEFINE FRAME d-all-r-docs
     1691        b-quit AT ROW 1 COL 1
     1692        b-mark AT ROW 1 COL 11
     1693        b-sel AT ROW 1 COL 14
     1694        b-add AT ROW 1 COL 24
     1695        b-chg AT ROW 1 COL 34
     1696        b-del AT ROW 1 COL 44
     1697        b-lkp AT ROW 1 COL 54
     1698        b-close AT ROW 1 COL 64
     1699        b-print AT ROW 1 COL 92.6
     1700        br-r-docs AT ROW 2 COL 1
     1701        ed-notes AT ROW 20.52 COL 1 NO-LABEL
     1702        f-boss-name AT ROW 19 COL 5 COLON-ALIGNED
     1703        f-obj-name AT ROW 19 COL 35 COLON-ALIGNED
     1704        f-agnt-name AT ROW 19.76 COL 5 COLON-ALIGNED
     1705        f-wrkr-name AT ROW 19.76 COL 35 COLON-ALIGNED
     1706        f-cre-name AT ROW 19.76 COL 65 COLON-ALIGNED
     1707        SPACE(13.40) SKIP(2.09)
     1708       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1709            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1710            TITLE "<insert dialog title>".
     1711   ASSIGN
     1712          FRAME d-all-r-docs:SCROLLABLE       = FALSE
     1713          FRAME d-all-r-docs:HIDDEN           = TRUE.
     1714   ASSIGN
     1715          br-r-docs:NUM-LOCKED-COLUMNS IN FRAME d-all-r-docs     = 4
     1716          br-r-docs:COLUMN-RESIZABLE IN FRAME d-all-r-docs       = TRUE.
     1717   ON WINDOW-CLOSE OF FRAME d-all-r-docs
     1718   DO:
     1719           APPLY "END-ERROR":U TO SELF.
     1720       END.
     1721   ON CHOOSE OF b-add IN FRAME d-all-r-docs
     1722   DO:
     1723           if rdc-value <>  "pomi-rn" then
     1724           do:
     1725             message "Работа с документом проверки корректности работы АСИ в резервуаре невозможна при выключенной интеграции с библиотекой ПОкМИ." view-as alert-box.
     1726             return no-apply.
     1727           end.
     1728           assign
     1729               rvs-rec = ?
     1730               .
     1731           do
     1732               on stop undo, return no-apply
     1733               :
     1734               run str/test-asi-add.p
     1735                   ( input parparentproc
     1736                   ,input 'ДОБАВЛЕНИЕ':U
     1737                   ,output rvs-rec
     1738                   ) no-error.
     1739               if error-status :error then
     1740               do:
     1741                   undo, return no-apply.
     1742               end.
     1743           end.
     1744           if rvs-rec = ? then
     1745           do:
     1746               return no-apply.
     1747           end.
     1748           message
     1749               "Новый документ проверки корректности работы АСИ в резервуаре добавлен в Базу Данных."
     1750               view-as alert-box information.
     1751           run UI-on in this-procedure.
     1752       END.
     1753   ON CHOOSE OF b-chg IN FRAME d-all-r-docs
     1754   DO:
     1755           define buffer bf_trn-doc for ub.trn-doc.
     1756           if not available r-doc then do:     message       "Неправильный выбор документа проверки корректности работы АСИ в резервуаре."       view-as alert-box .     return no-apply.   end.   else do:     assign       rvs-rec = recid (r-doc)     .   end.
     1757     if r-doc.status_ = 'факт':U
     1758     then do:
     1759           message
     1760               "Данный документ проверки корректности работы АСИ в резервуаре закрыт по факту или не может быть обработан в этом списке."
     1761               view-as alert-box.
     1762           return no-apply.
     1763     end.
     1764     if rdc-value <>  "pomi-rn" then
     1765     do:
     1766       message "Работа с документом проверки корректности работы АСИ в резервуаре невозможна при выключенной интеграции с библиотекой ПОкМИ." view-as alert-box.
     1767       return no-apply.
     1768     end.
     1769     assign
     1770         rvs-rec = recid( r-doc )
     1771     .
     1772     run str/test-asi-doc.w
     1773         ( input        parparentproc
     1774         ,input        'ИЗМЕНЕНИЕ':U
     1775         ,input        ""
     1776         ,input        no
     1777         ,input-output rvs-rec
     1778         ) no-error.
     1779     if error-status :error then
     1780     do:
     1781         find r-doc no-lock
     1782             where recid (r-doc) = rvs-rec
     1783             .
     1784         return no-apply.
     1785     end.
     1786     apply "entry" to br-r-docs in frame d-all-r-docs.
     1787     run UI-on in this-procedure .
     1788   END.
     1789   ON CHOOSE OF b-close IN FRAME d-all-r-docs
     1790   DO:
     1791     define variable varchg-inv as logical   no-undo.
     1792     define variable v-inv-doc  as character no-undo .
     1793     if not available r-doc then do:     message       "Неправильный выбор документа проверки корректности работы АСИ в резервуаре."       view-as alert-box .     return no-apply.   end.   else do:     assign       rvs-rec = recid (r-doc)     .   end.
     1794     if r-doc.status_ = 'факт':U
     1795     then do:
     1796         message
     1797             "Данный документ проверки корректности работы АСИ в резервуаре закрыт по факту или не может быть обработан в этом списке."
     1798             view-as alert-box.
     1799         return no-apply.
     1800     end.
     1801     if r-doc.status_ = 'новый':U then
     1802     do:
     1803       if rdc-value <>  "pomi-rn" then
     1804       do:
     1805         message "Работа с документом проверки корректности работы АСИ в резервуаре невозможна при выключенной интеграции с библиотекой ПОкМИ." view-as alert-box.
     1806         return no-apply.
     1807       end.
     1808       assign
     1809           varlog = no
     1810           .
     1811       message
     1812           "Вы хотите закрыть документ проверки корректности работы АСИ в резервуаре?"
     1813           view-as alert-box question buttons yes-no update varlog .
     1814       if varlog <> yes then
     1815       do:
     1816           return no-apply.
     1817       end.
     1818       tr:
     1819       do transaction
     1820       on error   undo tr, leave
     1821       on end-key undo tr, leave
     1822       on stop    undo tr, leave
     1823       :
     1824   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
     1825                         input recid(r-doc) ,
     1826                         input yes ) no-error .
     1827         if error-status :error then do:
     1828           message
     1829             "Ошибка при закрытии документа проверки корректности работы АСИ в резервуаре." skip
     1830             error-status:get-message(1) skip
     1831             return-value
     1832             view-as alert-box error.
     1833           undo tr, leave.
     1834         end.
     1835       end.
     1836     end.
     1837     find first r-doc no-lock
     1838         where recid (r-doc) = rvs-rec
     1839         .
     1840     run UI-on in this-procedure .
     1841   END.
     1842   ON CHOOSE OF b-del IN FRAME d-all-r-docs
     1843   DO:
     1844       define variable v-person as character no-undo.
     1845       define variable v-vid-action as integer  no-undo .
     1846       define variable v-vid-param  as longchar no-undo .
     1847       define variable v-mess as char no-undo.
     1848       define variable p-rvs-doc as character no-undo.
     1849       if not available r-doc then
     1850       do:
     1851           message "Не выбрана сверка, которую нужно удалить." view-as alert-box.
     1852           return no-apply.
     1853       end.
     1854       if rdc-value <>  "pomi-rn" then
     1855       do:
     1856         message "Работа с документом проверки корректности работы АСИ в резервуаре невозможна при выключенной интеграции с библиотекой ПОкМИ." view-as alert-box.
     1857         return no-apply.
     1858       end.
     1859       p-rvs-doc = r-doc.rvs-code.
     1860       run proc-del in this-procedure
     1861           no-error.
     1862       run openbr in this-procedure .
     1863   END.
     1864   ON CHOOSE OF b-lkp IN FRAME d-all-r-docs
     1865   DO:
     1866           br-handle = br-r-docs:handle.
     1867           if not available r-doc then do:     message       "Неправильный выбор документа проверки корректности работы АСИ в резервуаре."       view-as alert-box .     return no-apply.   end.   else do:     assign       rvs-rec = recid (r-doc)     .   end.
     1868   do
     1869       on stop undo, return no-apply
     1870       :
     1871       assign
     1872           rvs-rec = recid( r-doc ).
     1873       run str/test-asi-doc.w
     1874           ( input        parparentproc
     1875           ,input        'ПРОСМОТР':U
     1876           ,input        ""
     1877           ,input        no
     1878           ,input-output rvs-rec
     1879           ) no-error.
     1880       if error-status :error then
     1881       do:
     1882           return no-apply.
     1883       end.
     1884   end.
     1885   if br-handle = ? then
     1886   do:
