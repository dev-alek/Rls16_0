     1596   define variable bcol             as handle    extent 34 no-undo.
     1597   define variable ii               as integer.
     1598   define variable sch-field        as char      no-undo.
     1599   define variable del-list         as char      no-undo.
     1600   define variable mark             as char      no-undo.
     1601   define variable auto             as char      no-undo.
     1602   define variable hd-rvs           as handle    no-undo.
     1603   define variable varobj-type      like ub.rvs-doc.obj-type no-undo .
     1604   define variable varobj-code      like ub.rvs-doc.obj-code no-undo .
     1605   define variable varhost-code     like ub.rvs-doc.host-code no-undo .
     1606   define variable varstatus_       like ub.rvs-doc.status_ no-undo .
