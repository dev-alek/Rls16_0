     2078   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2079   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2080   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2081   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2082   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2083   define variable v-diasize-current-frame-height as decimal   no-undo .
     2084   define variable v-diasize-change-size          as logical   no-undo .
     2085   define variable v-diasize-resize-button        as handle    no-undo .
     2086   define variable v-diasize-wndmax               as logical   no-undo .
     2087   define variable v-diasize-wndstore             as logical   no-undo .
     2088   define variable v-diasize-proc-name            as character no-undo .
     2089   define variable v-diasize-browse-handle        as handle    no-undo .
     2090   define variable v-diasize-browse-number        as integer   no-undo .
     2091   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2092   define temp-table temp-diasize-handle no-undo
     2093     field handle-value  as handle
     2094     field save-position as decimal
     2095     index xpk is primary unique handle-value
     2096     .
     2097   define temp-table temp-browse-handle no-undo
     2098     field browse-type   as character
     2099     field browse-number as integer
     2100     field browse-handle as handle
     2101     field original-size as decimal
     2102     index xpk is primary unique browse-type browse-number
     2103     index xie browse-type browse-handle
     2104   .
     2105   procedure diasize_change-height :
     2106     define input  parameter p-change-value  as decimal   no-undo .
     2107     define input  parameter p-move-resize   as logical   no-undo .
     2108     define variable v-field-group-handle    as handle    no-undo .
     2109     define variable v-object-handle         as handle    no-undo .
     2110     define variable v-frame-height          as decimal   no-undo .
     2111     define variable v-frame-virtual-height  as decimal   no-undo .
     2112     define variable v-browse-height         as decimal   no-undo .
     2113     define variable v-window-height         as decimal   no-undo .
     2114     define variable v-window-virtual-height as decimal   no-undo .
     2115     define variable v-change-sign           as integer   no-undo .
     2116     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2117     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2118     if p-change-value > 0
     2119     then do:
     2120       if frame d-all-r-docs :height + p-change-value
     2121           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2122       then do:
     2123         assign
     2124           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2125                           - (frame d-all-r-docs :height-chars)
     2126         .
     2127         if p-change-value <= 0
     2128         then do:
     2129           run diasize_position-resize-button in this-procedure .
     2130           return .
     2131         end.
     2132       end.
     2133     end.
     2134     if p-change-value < 0
     2135     then do:
     2136       if frame d-all-r-docs :height + p-change-value < v-diasize-orig-frame-height
     2137       then do:
     2138         assign
     2139           p-change-value = v-diasize-orig-frame-height
     2140                          - (frame d-all-r-docs :height-chars)
     2141         .
     2142         if p-change-value >= 0
     2143         then do:
     2144           run diasize_position-resize-button in this-procedure .
     2145           return .
     2146         end.
     2147       end.
     2148     end.
     2149     if p-change-value >= 0
     2150     then do:
     2151       assign
     2152         v-change-sign = 1
     2153       .
     2154     end.
     2155     else do:
     2156       assign
     2157         v-change-sign = -1
     2158       .
     2159     end.
     2160     assign
     2161       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2162     .
     2163     if p-change-value = 0
     2164     then do:
     2165       run diasize_position-resize-button in this-procedure .
     2166       return .
     2167     end.
     2168     move_block:
     2169     do
     2170     on error undo move_block, retry move_block
     2171     :
     2172       if retry
     2173       then do:
     2174         do
     2175         on error undo move_block, leave move_block
     2176         :
     2177           if p-change-value > 0
     2178           then do:
     2179             for each buf_temp-diasize-handle
     2180             on error undo, next
     2181             :
     2182               assign
     2183                 v-object-handle = buf_temp-diasize-handle.handle-value
     2184               .
     2185               if v-object-handle <> v-diasize-resize-button
     2186               then do:
     2187                 assign
     2188                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2189                 .
     2190               end.
     2191             end.
     2192             assign
     2193               v-diasize-browse-handle :height = v-browse-height
     2194             .
     2195             for each buf_temp-browse-handle
     2196               where buf_temp-browse-handle.browse-type = 'height':u
     2197             on error undo, next
     2198             :
     2199               assign
     2200                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2201               .
     2202             end.
     2203             assign
     2204               frame d-all-r-docs :height = v-frame-height
     2205             .
     2206             if frame d-all-r-docs :scrollable = true
     2207             then do:
     2208               assign
     2209                 frame d-all-r-docs :virtual-height = v-frame-virtual-height
     2210               .
     2211             end.
     2212             run diasize_position-resize-button in this-procedure .
     2213           end.
     2214           else do:
     2215             if frame d-all-r-docs :scrollable = true
     2216             then do:
     2217               assign
     2218                 frame d-all-r-docs :virtual-height = v-frame-virtual-height
     2219               .
     2220             end.
     2221             assign
     2222               frame d-all-r-docs :height = v-frame-height
     2223             .
     2224             assign
     2225               v-diasize-browse-handle :height = v-browse-height
     2226             .
     2227             for each buf_temp-browse-handle
     2228               where buf_temp-browse-handle.browse-type = 'height':u
     2229             on error undo, next
     2230             :
     2231               assign
     2232                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2233               .
     2234             end.
     2235             for each buf_temp-diasize-handle
     2236             on error undo, next
     2237             :
     2238               assign
     2239                 v-object-handle = buf_temp-diasize-handle.handle-value
     2240               .
     2241               if v-object-handle <> v-diasize-resize-button
     2242               then do:
     2243                 assign
     2244                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2245                 .
     2246               end.
     2247             end.
     2248             run diasize_position-resize-button in this-procedure .
     2249           end.
     2250           assign
     2251             v-diasize-change-size = false
     2252           .
     2253           leave move_block .
     2254         end.
     2255       end.
     2256       assign
     2257         v-diasize-need-full-display = true
     2258       .
     2259       if v-diasize-change-size = false
     2260       then do:
     2261         assign
     2262           v-diasize-change-size = true
     2263         .
     2264       end.
     2265       else do:
     2266         return .
     2267       end.
     2268       assign
     2269         v-frame-height = frame d-all-r-docs :height
     2270         v-frame-virtual-height = frame d-all-r-docs :virtual-height
     2271         v-browse-height = v-diasize-browse-handle :height
     2272       .
     2273       for each buf_temp-browse-handle
     2274         where buf_temp-browse-handle.browse-type = 'height':u
     2275       :
     2276         assign
     2277           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2278         .
     2279       end.
     2280       for each buf_temp-diasize-handle
     2281       :
     2282         delete buf_temp-diasize-handle .
     2283       end.
     2284       assign
     2285         v-field-group-handle = frame d-all-r-docs :first-child
     2286       .
     2287       do while valid-handle(v-field-group-handle)
     2288       :
     2289         assign
     2290           v-object-handle = v-field-group-handle :first-child
     2291         .
     2292         do while valid-handle(v-object-handle)
     2293         :
     2294           if  v-object-handle <> v-diasize-browse-handle :handle
     2295           and can-query(v-object-handle, "row")
     2296           and can-query(v-object-handle, "height")
     2297           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2298           then do:
     2299             find first buf_temp-browse-handle
     2300               where buf_temp-browse-handle.browse-type   = 'height':u
     2301                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2302               no-error .
     2303             if available buf_temp-browse-handle
     2304             then do:
     2305             end.
     2306             else do:
     2307               create buf_temp-diasize-handle .
     2308               assign
     2309                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2310                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2311               .
     2312             end.
     2313           end.
     2314           assign
     2315             v-object-handle = v-object-handle :next-sibling
     2316           .
     2317         end.
     2318         assign
     2319           v-field-group-handle = v-field-group-handle :next-sibling
     2320         .
     2321       end.
     2322       do with frame d-all-r-docs
     2323       :
     2324         hide v-diasize-resize-button .
     2325         assign
     2326           v-diasize-resize-button :row    = 1
     2327           v-diasize-resize-button :column = 1
     2328         .
     2329       end.
