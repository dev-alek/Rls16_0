     2689               where buf_temp-browse-handle.browse-type   = 'width':u
     2690                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2691               no-error .
     2692             if available buf_temp-browse-handle
     2693             then do:
     2694             end.
     2695             else do:
     2696               create buf_temp-diasize-handle .
     2697               assign
