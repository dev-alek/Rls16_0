     2867   procedure diasize_set-width :
     2868     define input  parameter p-new-width  as decimal   no-undo .
     2869     define input  parameter p-move-resize as logical   no-undo .
     2870     do
     2871     on error undo, return error return-value
     2872     :
     2873       run diasize_change-width in this-procedure
     2874         (input  (p-new-width - frame d-all-r-docs :width)
     2875         ,input  p-move-resize
     2876         ) .
     2877     end.
     2878   end procedure.
     2879   procedure diasize_position-resize-button :
     2880     do with frame d-all-r-docs
     2881     :
     2882       hide v-diasize-resize-button .
     2883       assign
     2884         v-diasize-resize-button :row = frame d-all-r-docs :height - v-diasize-resize-button :height
     2885                     - 1
     2886                     - (frame d-all-r-docs :border-bottom-pixels / session :pixels-per-row)
     2887         v-diasize-resize-button :col = frame d-all-r-docs :width - v-diasize-resize-button :width
     2888                     - 1
     2889                     - (frame d-all-r-docs :border-right-pixels / session :pixels-per-column)
     2890       .
     2891       view v-diasize-resize-button .
     2892     end.
     2893   end procedure.
     2894   on alt-right anywhere
     2895   do:
     2896     run diasize_change-width in this-procedure
     2897       (input 1
     2898       ,input true
     2899       ) .
     2900     return no-apply .
     2901   end.
     2902   on alt-left anywhere
     2903   do:
     2904     run diasize_change-width in this-procedure
     2905       (input -1
     2906       ,input true
     2907       ) .
     2908     return no-apply .
     2909   end.
     2910   on alt-down anywhere
     2911   do:
     2912     run diasize_change-height in this-procedure
     2913       (input 1
     2914       ,input true
     2915       ) .
     2916     return no-apply .
     2917   end.
     2918   on alt-up anywhere
     2919   do:
     2920     run diasize_change-height in this-procedure
     2921       (input -1
     2922       ,input true
     2923       ) .
     2924     return no-apply .
     2925   end.
     2926   on alt-enter of frame d-all-r-docs
     2927   do:
     2928     run diasize_maximize in this-procedure
     2929       (input  ?
     2930       ).
     2931     return no-apply .
     2932   end.
     2933   procedure diasize_end-move :
     2934     do
     2935     on error undo, return error return-value
     2936     :
     2937       define variable v-row-delta as decimal   no-undo .
     2938       define variable v-col-delta as decimal   no-undo .
     2939       define variable v-new-row as decimal   no-undo .
     2940       define variable v-new-col as decimal   no-undo .
     2941       assign
     2942         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2943         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2944       .
     2945       assign
     2946         v-row-delta = v-new-row - frame d-all-r-docs :height
     2947         v-col-delta = v-new-col - frame d-all-r-docs :width
     2948       .
     2949       run diasize_change-height in this-procedure
     2950         (input v-row-delta
     2951         ,input true
     2952         ) .
     2953       run diasize_change-width in this-procedure
     2954         (input v-col-delta
     2955         ,input true
     2956         ) .
     2957     end.
     2958   end procedure.
     2959   procedure diasize_maximize :
     2960     define input  parameter p-action as logical   no-undo .
     2961     do
     2962     on error undo, return error return-value
     2963     :
     2964       if p-action = ?
     2965       then do:
     2966         if v-diasize-need-maximize = true
     2967         then do:
     2968           assign
     2969             p-action = true
     2970           .
     2971         end.
     2972         else do:
     2973           assign
     2974             p-action = false
     2975           .
     2976         end.
     2977       end.
     2978       if p-action = true
     2979       then do:
     2980         run diasize_change-height in this-procedure
     2981           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2982               - frame d-all-r-docs :height-chars
     2983           ,input true
     2984           ) .
     2985         run diasize_change-width in this-procedure
     2986           (input session :width-chars
     2987               - frame d-all-r-docs :width-chars
     2988           ,input true
     2989           ) .
     2990         assign
     2991           v-diasize-need-maximize = false
     2992         .
     2993       end.
     2994       else do:
     2995         run diasize_change-width in this-procedure
     2996           (input v-diasize-orig-frame-width
     2997               - frame d-all-r-docs :width-chars
     2998           ,input true
     2999           ) .
     3000         run diasize_change-height in this-procedure
     3001           (input v-diasize-orig-frame-height
     3002               - frame d-all-r-docs :height-chars
     3003           ,input true
     3004           ) .
     3005         assign
     3006           v-diasize-need-maximize = true
     3007         .
     3008       end.
     3009     end.
     3010   end procedure.
     3011   procedure diasize_restore-orig-size :
     3012     do
     3013     on error undo, return error return-value
     3014     :
     3015       assign
     3016         v-diasize-current-frame-width  = frame d-all-r-docs :width
     3017         v-diasize-current-frame-height = frame d-all-r-docs :height
     3018       .
     3019       run diasize_set-height in this-procedure
     3020         (input  v-diasize-orig-frame-height
     3021         ,input  true
     3022         ) .
     3023       run diasize_set-width in this-procedure
     3024         (input  v-diasize-orig-frame-width
     3025         ,input  true
     3026         ) .
     3027     end.
     3028   end procedure.
     3029   procedure diasize_restore-current-size :
     3030     do
     3031     on error undo, return error return-value
     3032     :
     3033       run diasize_set-height in this-procedure
     3034         (input  v-diasize-current-frame-height
     3035         ,input  true
     3036         ) .
     3037       run diasize_set-width in this-procedure
     3038         (input  v-diasize-current-frame-width
     3039         ,input  true
     3040         ) .
     3041     end.
     3042   end procedure.
     3043   procedure diasize_set-browse-handle :
     3044     define input  parameter p-browse-handle as handle   no-undo .
     3045     define buffer buf_temp-browse-handle for temp-browse-handle .
     3046     do
     3047     on error undo, return error return-value
     3048     :
     3049       assign
     3050         v-diasize-browse-handle = p-browse-handle
     3051       .
     3052       for each buf_temp-browse-handle
     3053       on error undo, return error return-value
     3054       :
     3055         delete buf_temp-browse-handle .
     3056       end.
     3057     end.
     3058   end procedure.
     3059   procedure diasize_add_browse :
     3060     define input  parameter p-browse-type   as character no-undo .
     3061     define input  parameter p-browse-handle as handle    no-undo .
     3062     define buffer buf_temp-browse-handle for temp-browse-handle .
     3063     do
     3064     on error undo, return error return-value
     3065     :
     3066       assign
     3067         v-diasize-browse-number = v-diasize-browse-number + 1
     3068       .
     3069       create buf_temp-browse-handle .
     3070       assign
     3071         buf_temp-browse-handle.browse-type   = p-browse-type
     3072         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3073         buf_temp-browse-handle.browse-handle = p-browse-handle
     3074       .
     3075     end.
     3076   end procedure.
     3077   procedure diasize_init :
     3078     define variable v-default-value    as logical   no-undo .
     3079     define variable v-restore-saved    as logical   no-undo .
     3080     define variable v-resize-value-str as character no-undo .
     3081     do
     3082     on error undo, return error return-value
     3083     :
     3084       do with frame d-all-r-docs
     3085       :
     3086         assign
     3087           v-diasize-orig-frame-height = frame d-all-r-docs :height
     3088           v-diasize-orig-frame-width  = frame d-all-r-docs :width
     3089           v-diasize-browse-handle     = browse br-r-docs :handle
     3090         .
     3091         create button v-diasize-resize-button
     3092         assign
     3093           parent        = frame d-all-r-docs :first-child
     3094           label         = "s"
     3095           height-pixels = 16
     3096           width-pixels  = 16
     3097           visible       = true
     3098           sensitive     = true
     3099           movable       = true
     3100           triggers:
     3101             on end-move persistent run diasize_end-move in this-procedure .
     3102           end triggers.
     3103         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3104         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3105         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3106         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3107         assign
     3108           v-diasize-wndmax = false
     3109         .
     3110         if connected("ub") = true
     3111         then do:
     3112           define variable v-cntxt-db-num        as integer   no-undo .
     3113           define variable v-cntxt-userid        as character no-undo .
     3114           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3115                                             , OUTPUT v-cntxt-userid
     3116                                             ) .
     3117           run gbl/wndpar_r.p
     3118             (input  v-cntxt-db-num
     3119             ,input  v-cntxt-userid
     3120             ,input  'wndmax':U
     3121             ,output v-diasize-wndmax
     3122             ,output v-default-value
     3123             ) .
     3124         end.
     3125         assign
     3126           v-diasize-wndstore = false
     3127         .
     3128         if connected("ub") = true
     3129         then do:
     3130           run gbl/wndpar_r.p
     3131             (input  v-cntxt-db-num
     3132             ,input  v-cntxt-userid
     3133             ,input  'wndstore':U
     3134             ,output v-diasize-wndstore
     3135             ,output v-default-value
     3136             ) .
     3137         end.
     3138         assign
     3139           v-diasize-proc-name = entry(1, program-name(2), '.')
     3140         .
     3141         if v-diasize-wndstore = true
     3142         then do:
     3143           assign
     3144             v-restore-saved = false
     3145           .
     3146           if connected("ub") = true
     3147           then do:
     3148             run gbl/wndsizer.p
     3149               (input  v-cntxt-db-num
     3150               ,input  v-cntxt-userid
     3151               ,input  v-diasize-proc-name
     3152               ,input  'height':u
     3153               ,output v-resize-value-str
     3154               ) .
     3155             if v-resize-value-str <> '':U
     3156             then do:
     3157               run diasize_change-height in this-procedure
     3158                 (input  integer(v-resize-value-str)
     3159                 ,input  true
     3160                 ) .
     3161               assign
     3162                 v-restore-saved = true
     3163               .
     3164             end.
     3165           end.
     3166           if connected("ub") = true
     3167           then do:
     3168             run gbl/wndsizer.p
     3169               (input  v-cntxt-db-num
     3170               ,input  v-cntxt-userid
     3171               ,input  v-diasize-proc-name
     3172               ,input  'width':u
     3173               ,output v-resize-value-str
     3174               ) .
     3175             if v-resize-value-str <> '':U
     3176             then do:
     3177               run diasize_change-width in this-procedure
     3178                 (input  integer(v-resize-value-str)
     3179                 ,input  true
     3180                 ) .
     3181               assign
     3182                 v-restore-saved = true
     3183               .
     3184             end.
     3185           end.
     3186           if v-restore-saved <> true
     3187           then do:
     3188             if v-diasize-wndmax = true
     3189             then do:
     3190               run diasize_maximize in this-procedure
     3191                 (input  true
     3192                 ) .
     3193             end.
     3194           end.
     3195         end.
     3196         else do:
     3197           if v-diasize-wndmax = true
     3198           then do:
     3199             run diasize_maximize in this-procedure
     3200               (input  true
     3201               ) .
     3202           end.
     3203         end.
     3204       end.
     3205     end.
     3206   end procedure.
     3207   procedure diasize_need-full-display :
     3208     define output parameter p-need-full-display as logical   no-undo .
     3209     do
     3210     on error undo, return error return-value
     3211     :
     3212       assign
     3213         p-need-full-display = v-diasize-need-full-display
     3214       .
     3215       assign
     3216         v-diasize-need-full-display = false
     3217       .
     3218     end.
     3219   end procedure.
     3220   procedure get-context :
     3221      define output parameter p-db-num as integer          no-undo.
     3222      define output parameter p-user-id as character        no-undo.
     3223      define variable v-login               as character    no-undo.
     3224      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3225      define buffer buf_user-login  for ub.user-login .
     3226      do
     3227      on error undo, return error
     3228      :
     3229            FIND FIRST buf_sys-ctrl no-lock.
     3230            ASSIGN
     3231               v-login = USERID("ub")
     3232               p-db-num = buf_sys-ctrl.db-num
     3233            .
     3234            FIND FIRST buf_user-login
     3235                 WHERE buf_user-login.db-num = p-db-num
     3236                   AND buf_user-login.user-login = v-login
     3237                 no-lock
     3238                 no-error
     3239                 .
     3240            IF AVAILABLE buf_user-login
     3241            THEN DO:
     3242               assign
     3243                  p-user-id = buf_user-login.user-id
     3244               .
     3245            END.
     3246      end.
     3247   end procedure.
     3248       run diasize_init in this-procedure .
     3249   def var sort-labelbr-r-docs   as character no-undo .
     3250   def var sort-clmnbr-r-docs    as handle    no-undo .
     3251   def var cur-clmnbr-r-docs     as handle    no-undo .
     3252   def var cur-clmn-locbr-r-docs as integer   no-undo .
     3253   def var re-querybr-r-docs     as logical   initial no no-undo .
     3254   on start-search, ctrl-o of br-r-docs in frame d-all-r-docs do:
     3255      run sort-brbr-r-docs
     3256        (input (if available r-doc
     3257                then recid(r-doc)
     3258                else ?
     3259               )
     3260        ).
     3261   end.
     3262   PROCEDURE sort-brbr-r-docs :
     3263     define input parameter p-recid as recid no-undo .
     3264     if re-querybr-r-docs = no then do:
     3265       assign
     3266          cur-clmnbr-r-docs = br-r-docs:current-column in frame d-all-r-docs
     3267       .
     3268       if sort-clmnbr-r-docs <> ? then sort-clmnbr-r-docs:column-fgcolor = 0.
     3269       if cur-clmnbr-r-docs = sort-clmnbr-r-docs then do:
     3270         assign
     3271            sort-labelbr-r-docs = ""
     3272            sort-clmnbr-r-docs = ?
     3273         .
     3274        end.
     3275        else do:
     3276          assign
     3277            sort-labelbr-r-docs = cur-clmnbr-r-docs:label
     3278            sort-clmnbr-r-docs  = cur-clmnbr-r-docs
     3279            sort-clmnbr-r-docs:column-fgcolor = 4
     3280          .
     3281        end.
     3282      end.
     3283     assign
     3284       cur-clmn-locbr-r-docs = 1
     3285     .
     3286     def var column-handle as handle no-undo .
     3287     column-handle = br-r-docs:first-column.
     3288     do while valid-handle(column-handle) :
     3289       if column-handle = cur-clmnbr-r-docs then do:
     3290         leave .
     3291       end.
     3292       column-handle = column-handle:NEXT-COLUMN.
     3293       assign
     3294         cur-clmn-locbr-r-docs = cur-clmn-locbr-r-docs + 1
     3295       .
     3296     end.
     3297     case sort-labelbr-r-docs:
     3298           when ' Tип '  then DO:    assign       sort-column-name = "(substring (r-doc.rvs-type, 1, 9))"     .     run OpenBr   . END.
     3299           when ' '  then DO:   assign       sort-column-name = substitute('dynamic-function(&1autorvs&1, recid(r-doc)) ', chr(34) )     .     run OpenBr   . END.
     3300           when 'Стат'  then DO:    assign       sort-column-name = "r-doc.status_"     .     run OpenBr   . END.
     3301           when 'Документ'  then DO:    assign       sort-column-name = "r-doc.rvs-code"     .     run OpenBr   . END.
     3302           when 'Дата'  then DO:    assign       sort-column-name = "(substring ((string (r-doc.doc-date)), 1, 5))"     .     run OpenBr   . END.
     3303           when 'Факт'  then DO:    assign       sort-column-name = "r-doc.fact-date"     .     run OpenBr   . END.
     3304           when 'Время'  then DO:    assign       sort-column-name = "string(r-doc.fact-time,'hh:mm:ss')"     .     run OpenBr   . END.
     3305           when 'Смена'  then DO:    assign       sort-column-name = "(substring ((string (r-doc.shift-date)), 1, 5))"     .     run OpenBr   . END.
     3306           when '№'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-name&1, recid( r-doc)) ', chr(34) )     .     run OpenBr   . END.
     3307           when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-name&1, recid( r-doc)) ', chr(34) )     .     run OpenBr   . END.
     3308       otherwise do:
     3309         assign
     3310           sort-column-name = ""
     3311         .
     3312         run OpenBr.
     3313           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-r-docs') then do:
     3314             run mv-brw-defaultbr-r-docs.
     3315           end.
     3316         if sort-labelbr-r-docs <> "" then do:
     3317           assign
     3318             cur-clmnbr-r-docs:column-fgcolor = 0
     3319           .
     3320         end.
     3321         assign
     3322           cur-clmn-locbr-r-docs = ?
     3323         .
     3324       end.
     3325     end case.
     3326       if cur-clmn-locbr-r-docs <> ? then do:
     3327         if can-do( this-procedure:internal-entries, 'ch-clmnbr-r-docs') then do:
     3328           run ch-clmnbr-r-docs in this-procedure (cur-clmn-locbr-r-docs).
     3329         end.
     3330       end.
     3331     if p-recid <> ? then do:
     3332       reposition br-r-docs to recid p-recid no-error.
     3333       apply "value-changed" to br-r-docs in frame d-all-r-docs.
     3334     end.
     3335     apply "entry" to br-r-docs in frame d-all-r-docs.
     3336   END PROCEDURE.
     3337   procedure re-open-query-srt-clmnbr-r-docs:
     3338   if cur-clmnbr-r-docs = ? then do:
     3339      run OpenBr.
     3340   end.
     3341   else do:
     3342      assign re-querybr-r-docs = yes.
     3343      run sort-brbr-r-docs
     3344        (input (if available r-doc
     3345                then recid(r-doc)
     3346                else ?
     3347               )
     3348        ).
     3349      assign re-querybr-r-docs = no.
     3350   end.
     3351   end.
     3352   MAIN-BLOCK:
     3353   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3354       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3355       assign
     3356           filter-point = "all-test-asi":U
     3357           .
     3358       RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-value, OUTPUT rdc-type) NO-ERROR.
     3359       run UI-on in this-procedure .
     3360       WAIT-FOR GO OF FRAME d-all-r-docs focus br-r-docs.
     3361   END.
     3362   RUN disable_UI in this-procedure .
     3363   PROCEDURE disable_UI :
     3364     HIDE FRAME d-all-r-docs.
     3365   END PROCEDURE.
     3366   PROCEDURE enable_UI :
     3367     DISPLAY ed-notes f-boss-name f-obj-name f-agnt-name f-wrkr-name f-cre-name
     3368         WITH FRAME d-all-r-docs.
     3369     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-close b-print br-r-docs
     3370            ed-notes
     3371         WITH FRAME d-all-r-docs.
     3372     VIEW FRAME d-all-r-docs.
     3373     OPEN QUERY br-r-docs FOR EACH r-doc .
     3374   END PROCEDURE.
     3375   PROCEDURE local-mark :
     3376   if not available r-doc then
     3377       do:
     3378           message "Неправильный выбор строки.".
     3379           return .
     3380       end.
     3381   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3382   define variable v-str-recid22 as character no-undo .
     3383   define variable v-num-entry22 as integer   no-undo .
     3384   assign
     3385     v-str-recid22 = trim( string( recid( r-doc ) , "->>>>>>>>>>>9":U ) )
     3386     v-num-entry22 = lookup( v-str-recid22 , del-list )
     3387   .
     3388   if v-num-entry22 > 0 then do:
     3389     assign
     3390       entry( v-num-entry22, del-list ) = "":U
     3391       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3392     .
     3393   end.
     3394   else do:
     3395     assign
     3396       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid22
     3397     .
     3398   end.
     3399       br-r-docs:refresh() in frame d-all-r-docs .
     3400   END PROCEDURE.
     3401   PROCEDURE Openbr :
     3402   define variable sort-column-phrase as character no-undo .
     3403       define variable l-query-was-opened as logical   no-undo .
     3404       define buffer bf_clients for ub.clients.
     3405       run waitfram-show in this-procedure
     3406           (input "Ждите..."
     3407           ).
     3408       case sort-column-name :
     3409           when "" then
     3410               do:
     3411                   assign
     3412                       sort-column-phrase = ""
     3413                       .
     3414               end.
     3415           otherwise
     3416           do:
     3417               assign
     3418                   sort-column-phrase = "by " + sort-column-name
     3419                   .
     3420           end.
     3421       end case.
     3422       assign
     3423           varobj-type  = v-cntxt-obj-type
     3424           varobj-code  = v-cntxt-obj-code
     3425           varhost-code = v-cntxt-host-code-obj
     3426           vartest-asi  = 'проверка':U
     3427       .
     3428       find first bf_clients  where bf_clients.obj-type = v-cntxt-obj-type and
     3429           bf_clients.obj-code = v-cntxt-obj-code no-lock.
     3430       case parlist-mode:
     3431           when 'работа':U then
     3432               do:
     3433                   assign
     3434                       frame d-all-r-docs:title = "ДОКУМЕНТЫ проверки корректности работы АСИ в резервуаре".
     3435   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3436   define variable  l-disable-where-24  as logical   no-undo .
     3437   define variable  l-filter-open-24    as logical   .
     3438   define variable  flt-rec-24       as recid     no-undo .
     3439   define variable  filter-name-24      as character no-undo .
     3440   define variable  where-phrase-24     as character no-undo .
     3441   define variable  sort-phrase-24      as character no-undo .
     3442   define variable  where-phrase-rus-24 as character no-undo .
     3443   define variable  sort-phrase-rus-24  as character no-undo .
     3444   run gbl/flt-get.p
     3445     (input filter-point
     3446     ,output flt-rec-24
     3447     ,output filter-name-24
     3448     ,output where-phrase-24
     3449     ,output sort-phrase-24
     3450     ,output where-phrase-rus-24
     3451     ,output sort-phrase-rus-24
     3452     ).
     3453       run set-filter-name in this-procedure
     3454         (INPUT filter-name-24
     3455         ) no-error .
     3456     assign
     3457       l-filter-open-24 = false
     3458     .
     3459     if flt-rec-24 <> ?
     3460       or sort-column-phrase > ""
     3461     then do:
     3462       define variable  parameter-2-24 as character no-undo .
     3463       define variable  parameter-3-24 as character no-undo .
     3464       define variable  parameter-4-24 as character no-undo .
     3465       define variable  parameter-5-24 as character no-undo .
     3466       define variable  parameter-6-24 as character no-undo .
     3467       define variable  parameter-7-24 as character no-undo .
     3468         assign
     3469         parameter-3-24 =
     3470                                 "FOR EACH r-doc"
     3471         parameter-4-24 =
     3472           (
