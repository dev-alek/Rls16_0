     2502     define variable v-change-sign          as integer   no-undo .
     2503     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2504     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2505     if p-change-value > 0
     2506     then do:
     2507       if frame d-all-r-docs :width + p-change-value >
     2508           session :width-chars
     2509       then do:
     2510         assign
     2511           p-change-value = session :width-chars - frame d-all-r-docs :width
     2512         .
     2513         if p-change-value <= 0
     2514         then do:
     2515           run diasize_position-resize-button in this-procedure .
     2516           return .
     2517         end.
     2518       end.
     2519     end.
     2520     if p-change-value < 0
     2521     then do:
     2522       if frame d-all-r-docs :width + p-change-value < v-diasize-orig-frame-width
     2523       then do:
     2524         assign
     2525           p-change-value = v-diasize-orig-frame-width
     2526                          - frame d-all-r-docs :width
     2527         .
     2528         if p-change-value >= 0
     2529         then do:
     2530           run diasize_position-resize-button in this-procedure .
     2531           return .
     2532         end.
     2533       end.
     2534     end.
     2535     if p-change-value >= 0
     2536     then do:
     2537       assign
     2538         v-change-sign = 1
     2539       .
     2540     end.
     2541     else do:
     2542       assign
     2543         v-change-sign = -1
     2544       .
     2545     end.
     2546     assign
     2547       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2548     .
     2549     if p-change-value = 0
     2550     then do:
     2551       run diasize_position-resize-button in this-procedure .
     2552       return .
     2553     end.
     2554     move_block:
     2555     do
     2556     on error undo move_block, leave move_block
     2557     :
