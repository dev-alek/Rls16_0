     2041   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-all-r-docs:PARENT eq ?
     2042       THEN FRAME d-all-r-docs:PARENT = ACTIVE-WINDOW.
     2043   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
