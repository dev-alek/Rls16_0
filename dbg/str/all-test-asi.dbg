     1564   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1565   function autorvs return char
     1566       ( input p-rec as recid  ) :
     1567       define variable p-autorvs as char no-undo.
     1568       define buffer Buf_doc-attr for doc-attr.
     1569       define buffer r-d          for rvs-doc.
     1570       find first r-d no-lock where recid(r-d) = p-rec no-error.
     1571       find first buf_doc-attr no-lock where r-d.rvs-code = buf_doc-attr.doc-code and buf_doc-attr.attr-code = "rvs-auto" and buf_doc-attr.attr-value = "Yes" no-error.
     1572       if available buf_doc-attr then
     1573       do :
     1574           p-autorvs = 'а'.
     1575       end.
     1576       else
     1577       do:
     1578           if r-d.is-full = yes then
     1579           do:
     1580               p-autorvs =  "п" .
     1581           end.
     1582           else
     1583           do :
     1584               p-autorvs = " ".
     1585           end.
     1586       end.
     1587       return ( p-autorvs ).
     1588   end function.
     1589   define temp-table autorvs no-undo
     1590   field attr-code like doc-attr.attr-code
     1591   field attr-value like doc-attr.attr-value
     1592   field rvs-code  like r-doc.rvs-code
     1593   field auto as logical
     1594   .
