     1610   define variable v-ok             as logical   no-undo.
     1611   define variable sort-column-name as character no-undo.
     1612   define variable filter-point     as character no-undo.
     1613   define variable varstr           as character no-undo.
     1614   define variable varrecid         as recid     no-undo.
     1615   define variable rvs-rec          as recid     no-undo.
     1616   define variable varlog           as logical   no-undo.
     1617   define variable p-auto           as char      no-undo.
     1618   define variable rvsinvstrObj     as class rvsinvstr no-undo.
     1619   define variable rdc-value        as character no-undo .
     1620   define variable rdc-type         as character no-undo.
     1621   FUNCTION obj-name RETURNS CHARACTER
     1622       ( p-rec as recid )  FORWARD.
     1623   FUNCTION shift-name RETURNS CHARACTER
     1624       ( p-rec as recid )  FORWARD.
     1625   DEFINE BUTTON b-add
     1626        LABEL "Добавить":L
     1627        SIZE 10 BY 1.
     1628   DEFINE BUTTON b-chg
     1629        LABEL "Изменить":L
     1630        SIZE 10 BY 1.
     1631   DEFINE BUTTON b-close
