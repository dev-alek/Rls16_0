     3998     apply "value-changed" to br-r-docs in frame d-all-r-docs.
     3999       end.
     4000       run waitfram-hide in this-procedure .
     4001   END PROCEDURE.
     4002   PROCEDURE proc-del :
     4003       define variable del-rec   as recid   no-undo.
     4004       define variable unrv-qnty as decimal no-undo.
     4005       define variable varfind   as logical no-undo.
     4006       define buffer bf-prev_rvs-doc  for ub.rvs-doc.
     4007       define buffer bf_trn-doc       for ub.trn-doc.
     4008       define buffer bf_doc-line      for ub.doc-line.
     4009       define buffer bf_goods         for ub.goods.
     4010       define buffer bf_rvs-line      for ub.rvs-line.
     4011       define buffer bf-prev_rvs-line for ub.rvs-line.
     4012       do
     4013           on error   undo, return error
     4014           on end-key undo, return error
     4015           on stop    undo, return error
     4016           :
     4017           if r-doc.status_ <> 'новый':U
     4018               and r-doc.status_ <> 'факт':U
     4019               then
     4020           do:
     4021               message
     4022                   "Документ в данном статусе не может быть удален."
     4023                   view-as alert-box.
     4024               return error   "Документ проверки корректности работы АСИ в резервуаре с типом 'смена' в данном статусе не может быть удален" .
     4025           end.
     4026           if r-doc.status_ = 'факт':U then
     4027           do:
     4028             if not v-cntxt-is-admin
     4029             then do :
     4030               message "Удаление доступно только пользователю с ролью технического администратора." view-as alert-box .
     4031               return error "Удаление доступно только пользователю с ролью технического администратора." .
     4032             end .
     4033           end.
     4034           assign
     4035               varlog = no.
     4036           message
     4037               "Удалить документ проверки корректности работы АСИ в резервуаре №" r-doc.rvs-code "?" skip
     4038               "   Вы уверены ?"
     4039               view-as alert-box question buttons OK-Cancel update varlog.
     4040           assign
     4041               rvs-rec = recid( r-doc )
     4042               .
     4043           if not varlog then
     4044           do:
     4045               find first r-doc no-lock
     4046                   where recid (r-doc) = rvs-rec
     4047                   .
     4048               return no-apply.
     4049           end.
     4050           run waitfram-show in this-procedure
     4051               ( input "Удаление документа проверки корректности работы АСИ в резервуаре № " + r-doc.rvs-code + ". Ждите..."
     4052               ).
     4053           assign
     4054               br-handle = br-r-docs :handle in frame d-all-r-docs
     4055               del-rec   = recid( r-doc )
     4056               .
     4057           if valid-handle( br-handle ) then
     4058           do:
     4059               assign
     4060                   varlog = br-handle :select-next-row( )
     4061                   .
     4062               if varlog <> true then
     4063               do:
     4064                   assign
     4065                       varlog = br-handle :select-prev-row( )
     4066                       .
     4067               end.
     4068               if varlog = true then
     4069               do:
     4070                   assign
     4071                       rvs-rec = recid( r-doc )
     4072                       .
     4073               end.
     4074           end.
     4075           del-doc:
     4076           do transaction
     4077               on stop    undo del-doc, retry del-doc
     4078               on error   undo del-doc, retry del-doc
     4079               on end-key undo del-doc, retry del-doc
     4080               :
     4081               if retry then
     4082               do:
     4083                   message
     4084                       vss-workfile vss-revision vss-description skip
     4085                       substitute("Ошибка при удалении документа проверки корректности работы АСИ в резервуаре.") skip
     4086                       error-status :get-message(1) skip
     4087                       return-value skip
     4088                       view-as alert-box error .
     4089                   leave del-doc .
     4090               end.
     4091               find first r-doc exclusive-lock
     4092                   where recid( r-doc ) = del-rec
     4093                   .
     4094               assign
     4095                   r-doc.is-del = true
     4096                   .
     4097               delete r-doc.
     4098           end.
     4099           run waitfram-hide in this-procedure .
     4100       end.
     4101   END PROCEDURE.
     4102   PROCEDURE UI-on :
     4103   ENABLE
     4104           b-quit
     4105           b-lkp
     4106           b-print
     4107           ed-notes
     4108           br-r-docs
     4109           WITH FRAME d-all-r-docs.
     4110       run OpenBr in this-procedure .
     4111   END PROCEDURE.
     4112   FUNCTION shift-name RETURNS CHARACTER
     4113       ( p-rec as recid ) :
     4114       def buffer loc-rvs-doc for ub.rvs-doc  .
     4115       find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
     4116       if error-status :error then return '' .
     4117       if loc-rvs-doc.shift-date = ? then
     4118       do:
     4119           return "":u.
     4120       end.
     4121       else
     4122       do:
     4123           if loc-rvs-doc.shift-num = integer(loc-rvs-doc.shift-name) then
     4124           do:
     4125               return loc-rvs-doc.shift-name.
     4126           end.
     4127           else
     4128           do:
     4129               return loc-rvs-doc.shift-name + "(" + string(loc-rvs-doc.shift-num) + ")".
     4130           end.
     4131       end.
     4132   end function.
     4133   FUNCTION obj-name RETURNS CHARACTER
     4134       ( p-rec as recid ) :
     4135       define buffer loc-rvs-doc for ub.rvs-doc  .
     4136       define variable v-ret-val as character no-undo .
     4137       find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
     4138       if error-status :error then return '' .
     4139       v-ret-val = loc-rvs-doc.obj-type + string(loc-rvs-doc.obj-code) .
     4140       return v-ret-val .
     4141   end function.
