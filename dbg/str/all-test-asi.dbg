      714     define new global shared variable g#lib-rvs as handle no-undo.
      715   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      717   procedure fltopend_fltopend :
      718   define input parameter p-parent-handle as handle no-undo .
      719   define input parameter p-qh as handle no-undo .
      720   define input parameter p-flt-open-open-query  as character no-undo .
      721   define input parameter p-where-cond as character no-undo .
      722   define input parameter p-use-indFIRST-query-tail as character no-undo .
      723   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      724   define input parameter p-indexed-reposition as character no-undo .
      725     do
      726     on error undo, return error
      727     :
      728   define variable v-prepare-string as character no-undo .
      729   define variable glog as logical no-undo .
      730   assign
      731   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      732                      p-where-cond + chr(32)  +
      733                      p-use-indFIRST-query-tail + chr(32) +
      734                      p-use-ind-sort-clmn-by + chr(32) +
      735                      p-indexed-reposition
      736   .
      737   assign
      738   glog = p-qh:query-prepare(v-prepare-string) no-error .
      739   if not glog
      740   or error-status:error then do:
      741     message error-status:get-message(1) view-as alert-box .
      742     undo, return error .
      743   end.
      744   assign
      745   glog = p-qh:query-open no-error .
      746   if not glog
      747   or error-status:error then do:
      748     message error-status:get-message(1) view-as alert-box .
      749     undo, return error .
      750   end.
      751     end.
      752   end procedure.
      753   procedure fltopend_fltfindd :
      754   define input parameter p-parent-handle as handle no-undo .
      755   define input parameter p-qh as handle no-undo .
      756   define input parameter p-rowid as rowid no-undo .
      757   define input parameter p-next as logical no-undo .
      758   define input parameter p-lock as integer no-undo .
      759   define input parameter p-bh as handle no-undo .
      760   define input parameter p-where-cond as character no-undo .
      761   define input parameter p-use-index-phrase as character no-undo .
      762   define variable glog as logical no-undo .
      763   define variable v-qh as handle no-undo .
      764   define variable v-bh as handle no-undo .
      765   define variable v-recid as recid no-undo .
      766   define variable v-prepare-string as character no-undo .
      767   do
      768   on error undo, return error
      769   on stop undo, return error
      770   :
      771     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      772     create buffer v-bh for table p-bh buffer-name p-bh:name.
      773     create query v-qh.
      774     v-qh:set-buffers(v-bh).
      775     v-prepare-string = substitute("for each &1 &2 &3"
      776                                     ,v-bh:name
      777                                     ,p-where-cond
      778                                     ,p-use-index-phrase).
      779     glog = v-qh:query-prepare(v-prepare-string) no-error.
      780     if not glog then do:
      781       delete object v-qh.
      782       delete object v-bh.
      783       undo, return error .
      784     end.
      785     glog = v-qh:query-open no-error .
      786     if not glog then do:
      787       delete object v-qh.
      788       delete object v-bh.
      789       undo, return error .
      790     end.
      791     if p-next then do:
      792       v-qh:reposition-to-rowid(p-rowid) no-error .
      793       glog = v-qh:get-next( p-lock) no-error .
      794       glog = v-qh:get-next( p-lock) no-error .
      795       if not glog or v-qh:query-off-end = yes then do:
      796         glog = v-qh:get-first( p-lock) no-error .
      797       end.
      798     end.
      799     else do:
      800       glog = v-qh:get-first( p-lock) no-error .
      801     end.
      802     v-recid = v-bh:recid no-error .
      803     delete object v-qh.
      804     delete object v-bh.
      805     return string(v-recid) .
      806   end.
      807   end procedure.
      808   procedure fltopend_fltfindq :
      809   define input parameter p-parent-handle as handle no-undo .
      810   define input parameter p-qh as handle no-undo .
      811   define input parameter p-next as logical no-undo .
      812   define input parameter p-lock as integer no-undo .
      813   define input parameter p-flt-open-open-query  as character no-undo .
      814   define input parameter p-where-cond as character no-undo .
      815   define input parameter p-use-indFIRST-query-tail as character no-undo .
      816   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      817   define input parameter p-indexed-reposition as character no-undo .
      818   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      819   define variable glog as logical no-undo .
      820   define variable v-qh as handle no-undo .
      821   define variable v-bh as handle no-undo extent 18.
      822   define variable v-rowid as rowid no-undo extent 18.
      823   define variable v-ii as integer no-undo .
      824   define variable v-prepare-string as character no-undo .
      825   do
      826   on error undo, return error
      827   on stop undo, return error
      828   :
      829     create query v-qh.
      830     do v-ii = 1 to p-qh:num-buffers:
      831       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      832       assign
      833       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      834       no-error.
      835       v-qh:add-buffer(v-bh[v-ii]).
      836     end.
      837     assign
      838     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      839                       p-where-cond + chr(32)  +
      840                       p-use-indFIRST-query-tail + chr(32) +
      841                       p-use-ind-sort-clmn-by + chr(32) +
      842                       p-indexed-reposition
      843     .
      844     glog = v-qh:query-prepare( v-prepare-string) no-error .
      845     if not glog then do:
      846       delete object v-qh.
      847       do v-ii = 1 to p-qh:num-buffers:
      848         delete object v-bh[v-ii].
      849       end.
      850       undo, return error .
      851     end.
      852     glog = v-qh:query-open no-error .
      853     if not glog then do:
      854       delete object v-qh.
      855       do v-ii = 1 to p-qh:num-buffers:
      856         delete object v-bh[v-ii].
      857       end.
      858       undo, return error .
      859     end.
      860     if p-next then do:
      861       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      862       glog = v-qh:get-next( p-lock) no-error .
      863       glog = v-qh:get-next( p-lock) no-error .
      864       if not glog or v-qh:query-off-end = yes then do:
      865         glog = v-qh:get-first( p-lock) no-error .
      866       end.
      867     end.
      868     else do:
      869       glog = v-qh:get-first( p-lock) no-error .
      870     end.
      871     do v-ii = 1 to p-qh:num-buffers:
      872       assign
      873       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      874       no-error.
      875     end.
      876     delete object v-qh.
      877     do v-ii = 1 to p-qh:num-buffers:
      878       delete object v-bh[v-ii].
      879     end.
      880   end.
      881   end procedure.
