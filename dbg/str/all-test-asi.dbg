     2773             then do:
     2774               undo move_block, retry move_block .
     2775             end.
     2776           end.
     2777         end.
     2778       end.
     2779       else do:
     2780         for each buf_temp-diasize-handle
     2781         on error undo move_block, retry move_block
     2782         :
     2783           assign
     2784             v-object-handle = buf_temp-diasize-handle.handle-value
     2785           .
     2786           if v-object-handle <> v-diasize-resize-button
     2787           then do:
     2788             assign
