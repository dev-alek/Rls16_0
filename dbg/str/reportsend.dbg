        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-userId as character no-undo .
        4   define input parameter p-shift-date  as date no-undo .
        5   define input parameter p-shift-num  as integer no-undo .
        6   define input parameter p-shift-name  as character no-undo .
        7   define input parameter p-obj-code   as integer no-undo .
        8   define input parameter p-obj-type as character no-undo .
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   define buffer buf_reportShift  for ub.reportShift .
       25   define buffer buf_shift-attr   for ub.shift-obj-attr .
       26   define buffer buf_user-account for ub.user-account .
       27   define variable user-id as character no-undo .
       28   define variable fio     as character no-undo .
       29   find first buf_user-account no-lock where buf_user-account.user-id = p-userId no-error .
       30   if available (buf_user-account) then
       31   do:
       32       assign
       33           user-id = buf_user-account.user-id
       34           fio     = buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name .
       35   end.
       36   find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = p-shift-date and
       37       buf_reportShift.shift-num = p-shift-num and buf_reportShift.obj-code = p-obj-code and
       38       buf_reportShift.obj-type = p-obj-type and buf_reportShift.report-type = 1 no-error .
       39   if not available (buf_reportShift) then
       40   do:
       41       find first buf_shift-attr exclusive-lock where buf_shift-attr.attr-code = "reportShift" and
       42           buf_shift-attr.obj-code = p-obj-code and
       43           buf_shift-attr.obj-type = p-obj-type and
       44           buf_shift-attr.shift-date = 01/01/1970 and
       45           buf_shift-attr.shift-num = 1 no-error .
       46       if available (buf_shift-attr) then
       47       do:
       48           buf_shift-attr.attr-value = string(integer(buf_shift-attr.attr-value) + 1) .
       49       end.
       50       else
       51       do:
       52           create buf_shift-attr .
       53           assign
       54               buf_shift-attr.attr-code  = "reportShift"
       55               buf_shift-attr.obj-code   = p-obj-code
       56               buf_shift-attr.obj-type   = p-obj-type
       57               buf_shift-attr.shift-date = 01/01/1970
       58               buf_shift-attr.shift-num  = 1
       59               buf_shift-attr.attr-value = string(next-value(s-reportShift, ub)).
       60       end.
       61       create buf_reportShift.
       62       assign
       63           buf_reportShift.id          = integer(buf_shift-attr.attr-value)
       64           buf_reportShift.obj-code    = p-obj-code
       65           buf_reportShift.obj-type    = p-obj-type
       66           buf_reportShift.report-type = 1
       67           buf_reportShift.shift-date  = p-shift-date
       68           buf_reportShift.shift-num   = p-shift-num
       69           .
       70   end.
       71   assign
       72       buf_reportShift.date       = today
       73       buf_reportShift.user-id    = user-id
       74       buf_reportShift.fio        = fio
       75       buf_reportShift.time_      = time
       76       buf_reportShift.shift-name = p-shift-name
       77       .
       78   run bge\send1cerp.p (parparentproc,
       79       this-procedure,
       80       this-procedure,
       81       "reportShift",
       82       (buffer buf_reportShift:handle),
       83       ?,
       84       ?) no-error.
       85   if  error-status:error then
       86   do:
       87       message return-value
       88           view-as alert-box.
       89       return .
       90   end.
