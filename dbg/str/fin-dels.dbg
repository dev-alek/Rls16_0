      967   procedure uf-get :
      968     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      969     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      970     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      971     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      972     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      973     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      974     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      975     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      976     do
      977     on error undo, return error
      978     :
      979       define buffer buf_usr-flt for ubflt.usr-flt .
      980       define variable v-use-List_     as logical   no-undo .
      981       define variable v-type-List_     as character no-undo .
      982       define variable v-format-List_   as character no-undo .
      983       define variable v-use-Naim      as logical   no-undo .
      984       define variable v-type-Naim      as character no-undo .
      985       define variable v-format-Naim    as character no-undo .
      986       define variable v-use-print-graft as logical   no-undo .
      987       define variable v-use-sort-gr     as logical   no-undo .
      988       define variable v-use-type-price  as logical   no-undo .
      989       define variable v-use-type-val    as logical   no-undo .
      990       define variable v-label          as character no-undo .
      991       define variable v-tooltip        as character no-undo .
      992       define variable v-user-can-edit  as logical   no-undo .
      993       define variable v-output-display as logical   no-undo .
      994       define variable v-other          as character no-undo .
      995       run uf-name in this-procedure
      996          (input  entry(1, p-code, chr(4))
      997         ,output v-use-List_
      998         ,output v-type-List_
      999         ,output v-format-List_
     1000         ,output v-use-Naim
     1001         ,output v-type-Naim
     1002         ,output v-format-Naim
     1003         ,output v-use-print-graft
     1004         ,output v-use-sort-gr
     1005         ,output v-use-type-price
     1006         ,output v-use-type-val
     1007         ,output v-label
     1008         ,output v-tooltip
     1009         ,output v-user-can-edit
     1010         ,output v-output-display
     1011         ,output v-other
     1012         ) no-error .
     1013       if error-status :error then do:
     1014         undo, return error return-value .
     1015       end.
     1016       find first buf_usr-flt no-lock where
     1017                  buf_usr-flt.Call-point     = p-code AND
     1018                  buf_usr-flt.user-name       = p-user-name
     1019         no-error .
     1020       if avail buf_usr-flt then do:
     1021         assign
     1022         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1023         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1024         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1025         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1026         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1027         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1028         .
     1029       end.
     1030       else do:
     1031         assign
     1032         p-List_        = (if v-use-List_       then "":U                    else ?)
     1033         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1034         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1035         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1036         p-type-price   = (if v-use-type-price  then no                      else ?)
     1037         p-type-val     = (if v-use-List_       then no                      else ?)
     1038         .
     1039       end.
     1040     end.
     1041   end procedure.
     1042   procedure uf-set :
     1043     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1044     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1045     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1046     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1047     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1048     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1049     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1050     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1051     do
     1052     on error undo, return error
     1053     :
     1054       define buffer buf_usr-flt for ubflt.usr-flt .
     1055       define variable v-use-List_     as logical   no-undo .
     1056       define variable v-type-List_     as character no-undo .
     1057       define variable v-format-List_   as character no-undo .
     1058       define variable v-use-Naim      as logical   no-undo .
     1059       define variable v-type-Naim      as character no-undo .
     1060       define variable v-format-Naim    as character no-undo .
     1061       define variable v-use-print-graft as logical   no-undo .
     1062       define variable v-use-sort-gr   as logical   no-undo .
     1063       define variable v-use-type-price as logical   no-undo .
     1064       define variable v-use-type-val  as logical   no-undo .
     1065       define variable v-tooltip        as character no-undo .
     1066       define variable v-label          as character no-undo .
     1067       define variable v-user-can-edit  as logical   no-undo .
     1068       define variable v-output-display as logical   no-undo .
     1069       define variable v-other          as character no-undo .
     1070       run uf-name in this-procedure
     1071         (input  entry(1, p-code, chr(4))
     1072         ,output v-use-List_
     1073         ,output v-type-List_
     1074         ,output v-format-List_
     1075         ,output v-use-Naim
     1076         ,output v-type-Naim
     1077         ,output v-format-Naim
     1078         ,output v-use-print-graft
     1079         ,output v-use-sort-gr
     1080         ,output v-use-type-price
     1081         ,output v-use-type-val
     1082         ,output v-label
     1083         ,output v-tooltip
     1084         ,output v-user-can-edit
     1085         ,output v-output-display
     1086         ,output v-other
     1087         ) no-error .
     1088       if error-status :error then do:
     1089         undo, return error return-value .
     1090       end.
     1091       find first buf_usr-flt where
     1092                  buf_usr-flt.Call-point     = p-code AND
     1093                  buf_usr-flt.user-name       = p-user-name
     1094         no-error .
     1095       if not avail buf_usr-flt then do:
     1096           create buf_usr-flt .
     1097           assign
     1098           buf_usr-flt.call-point = p-code
     1099           buf_usr-flt.user-name  = p-user-name
     1100           .
     1101       end.
     1102       if avail buf_usr-flt then do:
     1103        assign
     1104        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1105        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1106        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1107        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1108        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1109        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1110       .
     1111       release buf_usr-flt.
     1112       end.
     1113       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1114     end.
     1115   end procedure.
     1116   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117     define variable v-cntxt-db-num        as integer   no-undo .
     1118     define variable v-cntxt-userid        as character no-undo .
     1119     define variable v-cntxt-level         as character no-undo .
     1120     define variable v-cntxt-host-code-obj as integer   no-undo .
     1121     define variable v-cntxt-obj-type      as character no-undo .
     1122     define variable v-cntxt-obj-code      as integer   no-undo .
     1123     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1124     define variable v-cntxt-is-admin      as logical   no-undo .
     1125   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1126   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1127   procedure fltopend_fltopend :
     1128   define input parameter p-parent-handle as handle no-undo .
     1129   define input parameter p-qh as handle no-undo .
     1130   define input parameter p-flt-open-open-query  as character no-undo .
     1131   define input parameter p-where-cond as character no-undo .
     1132   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1133   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1134   define input parameter p-indexed-reposition as character no-undo .
     1135     do
     1136     on error undo, return error
     1137     :
     1138   define variable v-prepare-string as character no-undo .
     1139   define variable glog as logical no-undo .
     1140   assign
     1141   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1142                      p-where-cond + chr(32)  +
     1143                      p-use-indFIRST-query-tail + chr(32) +
     1144                      p-use-ind-sort-clmn-by + chr(32) +
     1145                      p-indexed-reposition
     1146   .
     1147   assign
     1148   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1149   if not glog
     1150   or error-status:error then do:
     1151     message error-status:get-message(1) view-as alert-box .
     1152     undo, return error .
     1153   end.
     1154   assign
     1155   glog = p-qh:query-open no-error .
     1156   if not glog
     1157   or error-status:error then do:
     1158     message error-status:get-message(1) view-as alert-box .
     1159     undo, return error .
     1160   end.
     1161     end.
     1162   end procedure.
     1163   procedure fltopend_fltfindd :
     1164   define input parameter p-parent-handle as handle no-undo .
     1165   define input parameter p-qh as handle no-undo .
     1166   define input parameter p-rowid as rowid no-undo .
     1167   define input parameter p-next as logical no-undo .
     1168   define input parameter p-lock as integer no-undo .
     1169   define input parameter p-bh as handle no-undo .
     1170   define input parameter p-where-cond as character no-undo .
     1171   define input parameter p-use-index-phrase as character no-undo .
     1172   define variable glog as logical no-undo .
     1173   define variable v-qh as handle no-undo .
     1174   define variable v-bh as handle no-undo .
     1175   define variable v-recid as recid no-undo .
     1176   define variable v-prepare-string as character no-undo .
     1177   do
     1178   on error undo, return error
     1179   on stop undo, return error
     1180   :
     1181     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1182     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1183     create query v-qh.
     1184     v-qh:set-buffers(v-bh).
     1185     v-prepare-string = substitute("for each &1 &2 &3"
     1186                                     ,v-bh:name
     1187                                     ,p-where-cond
     1188                                     ,p-use-index-phrase).
     1189     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1190     if not glog then do:
     1191       delete object v-qh.
     1192       delete object v-bh.
     1193       undo, return error .
     1194     end.
     1195     glog = v-qh:query-open no-error .
     1196     if not glog then do:
     1197       delete object v-qh.
     1198       delete object v-bh.
     1199       undo, return error .
     1200     end.
     1201     if p-next then do:
     1202       v-qh:reposition-to-rowid(p-rowid) no-error .
     1203       glog = v-qh:get-next( p-lock) no-error .
     1204       glog = v-qh:get-next( p-lock) no-error .
     1205       if not glog or v-qh:query-off-end = yes then do:
     1206         glog = v-qh:get-first( p-lock) no-error .
     1207       end.
     1208     end.
     1209     else do:
     1210       glog = v-qh:get-first( p-lock) no-error .
     1211     end.
     1212     v-recid = v-bh:recid no-error .
     1213     delete object v-qh.
     1214     delete object v-bh.
     1215     return string(v-recid) .
     1216   end.
     1217   end procedure.
     1218   procedure fltopend_fltfindq :
     1219   define input parameter p-parent-handle as handle no-undo .
     1220   define input parameter p-qh as handle no-undo .
     1221   define input parameter p-next as logical no-undo .
     1222   define input parameter p-lock as integer no-undo .
     1223   define input parameter p-flt-open-open-query  as character no-undo .
     1224   define input parameter p-where-cond as character no-undo .
     1225   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1226   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1227   define input parameter p-indexed-reposition as character no-undo .
     1228   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1229   define variable glog as logical no-undo .
     1230   define variable v-qh as handle no-undo .
     1231   define variable v-bh as handle no-undo extent 18.
     1232   define variable v-rowid as rowid no-undo extent 18.
     1233   define variable v-ii as integer no-undo .
     1234   define variable v-prepare-string as character no-undo .
     1235   do
     1236   on error undo, return error
     1237   on stop undo, return error
     1238   :
     1239     create query v-qh.
     1240     do v-ii = 1 to p-qh:num-buffers:
     1241       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1242       assign
     1243       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1244       no-error.
     1245       v-qh:add-buffer(v-bh[v-ii]).
     1246     end.
     1247     assign
     1248     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1249                       p-where-cond + chr(32)  +
     1250                       p-use-indFIRST-query-tail + chr(32) +
     1251                       p-use-ind-sort-clmn-by + chr(32) +
     1252                       p-indexed-reposition
     1253     .
     1254     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1255     if not glog then do:
     1256       delete object v-qh.
     1257       do v-ii = 1 to p-qh:num-buffers:
     1258         delete object v-bh[v-ii].
     1259       end.
     1260       undo, return error .
     1261     end.
     1262     glog = v-qh:query-open no-error .
     1263     if not glog then do:
     1264       delete object v-qh.
     1265       do v-ii = 1 to p-qh:num-buffers:
     1266         delete object v-bh[v-ii].
     1267       end.
     1268       undo, return error .
     1269     end.
     1270     if p-next then do:
     1271       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1272       glog = v-qh:get-next( p-lock) no-error .
     1273       glog = v-qh:get-next( p-lock) no-error .
     1274       if not glog or v-qh:query-off-end = yes then do:
     1275         glog = v-qh:get-first( p-lock) no-error .
     1276       end.
     1277     end.
     1278     else do:
     1279       glog = v-qh:get-first( p-lock) no-error .
     1280     end.
     1281     do v-ii = 1 to p-qh:num-buffers:
     1282       assign
     1283       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1284       no-error.
     1285     end.
     1286     delete object v-qh.
     1287     do v-ii = 1 to p-qh:num-buffers:
     1288       delete object v-bh[v-ii].
     1289     end.
     1290   end.
     1291   end procedure.
     1292   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   FUNCTION mark-string RETURNS CHARACTER
     1294     ( input p-recid as recid, input mark-list as character  ) :
     1295     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1296   END FUNCTION.
     1297   define variable filter-point as character no-undo init "Спиcок удаленных ФО" .
     1298   define variable filter-point0 as character no-undo init "Фин_обязательcтва_удаленные" .
     1299   define variable sort-column-name as character no-undo .
     1300   define variable print-type as character no-undo.
     1301   define variable del-type as character no-undo.
