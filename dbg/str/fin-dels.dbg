     1837     run proc-b-sch in this-procedure no-error.
     1838     if error-status:error then return no-apply.
     1839   END.
     1840   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1841   DO:
     1842       if ( available buf_fin-liab ) AND ( rid-list = "" ) then
     1843       rid-list = string( recid( buf_fin-liab ) ) .
     1844   END.
     1845   ON DELETE-CHARACTER OF br-cdocs IN FRAME Dialog-Frame
     1846   DO:
     1847      if b-mark:sensitive in frame Dialog-Frame then
     1848     APPLY "CHOOSE" to b-mark.
     1849   END.
     1850   ON INSERT-MODE OF br-cdocs IN FRAME Dialog-Frame
     1851   DO:
     1852       if b-mark:sensitive in frame Dialog-Frame then
     1853     APPLY "CHOOSE" to b-mark.
     1854       else do:
     1855         if b-sel:sensitive in frame Dialog-Frame then
     1856         APPLY "CHOOSE" to b-sel.
     1857       end.
     1858   END.
     1859   ON RETURN OF br-cdocs IN FRAME Dialog-Frame
     1860   OR MOUSE-SELECT-DBLCLICK OF br-cdocs IN FRAME Dialog-Frame
     1861   DO:
     1862         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1863           apply "choose" to b-sel in frame Dialog-Frame.
     1864       else
     1865           apply "choose" to B-lkp in frame Dialog-Frame.
     1866   END.
     1867   ON VALUE-CHANGED OF br-cdocs IN FRAME Dialog-Frame
     1868   DO:
     1869   if available buf_fin-liab then do:
     1870       assign
     1871       loc_receiver-name  = buf_fin-liab.receiver-name
     1872       loc_payer-name        = buf_fin-liab.payer-name
     1873       loc_sum-base  = buf_fin-liab.sum-base
     1874       loc_sum-doc   = buf_fin-liab.sum-doc
     1875       loc_sum-rubl  = buf_fin-liab.sum-rubl
     1876       loc_sum-contr  =  buf_fin-liab.sum-contract
     1877       d-abbr        = sel-abbr(buf_fin-liab.curr-code)
     1878       v-abbr        = sel-abbr(p-base-code)
     1879       v-abbr-contr    = sel-abbr(buf_fin-liab.contract-curr)
     1880       loc_user-name = buf_fin-liab.user-name-doc
     1881     .
     1882   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1884     (input  buf_fin-liab.user-name-doc
     1885     ,output loc_user-name
     1886     )  .
     1887   end.
     1888   else
     1889    assign
     1890      loc_receiver-name  = ""
     1891      loc_payer-name        = ""
     1892      loc_sum-base            = 0
     1893      loc_sum-doc             = 0
     1894      loc_sum-rubl            = 0
     1895      loc_user-name           = ""
     1896      d-abbr                         = ""
     1897      loc_sum-contr            = 0
     1898         v-abbr-contr  = ""
     1899       .
     1900   display
     1901     loc_receiver-name
     1902     loc_payer-name
     1903     loc_sum-base
     1904     loc_sum-doc
     1905     loc_sum-rubl
     1906     loc_sum-contr
     1907     r-abbr
     1908     v-abbr
     1909     d-abbr
     1910     loc_user-name
     1911     v-abbr-contr
     1912     with frame Dialog-Frame.
     1913   END.
     1914   ON LEAVE OF p-date IN FRAME Dialog-Frame
     1915   DO:
     1916   END.
     1917   ON CTRL-J OF p-date IN FRAME Dialog-Frame
     1918   DO:
     1919   assign p-date no-error .
     1920     if error-status:error then return no-apply.
     1921     run proc-find-date in this-procedure(yes, p-date) no-error.
     1922     if error-status:error then return no-apply.
