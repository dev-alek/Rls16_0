     3296               assign
     3297                   v-frame-width = frame Dialog-Frame:width - 0.3
     3298                   fh            = frame Dialog-Frame:first-child
     3299                   hh            = fh:first-child
     3300                   ii            = 1
     3301                   .
     3302               do while valid-handle(hh):
     3303                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3304                   do:
     3305                       case lc(hh:name) :
     3306                           when "b-help" then
     3307                               do:
     3308                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3309                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3310                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3311                                   hh:TOOLTIP = "Помощь" .
     3312                                   v-help-old-x = hh:column .
     3313                                   v-help-old-y = hh:row    .
     3314                                   v-help-old-size = hh:width .
     3315                                   hh:width-chars = 2.5 .
     3316                               end.
     3317                           when "b-print" then
     3318                               do:
     3319                                   hh:load-image("cmp/b-print.bmp":u) .
     3320                                   hh:TOOLTIP = "Печать" .
     3321                                   v-h[ii] = hh:handle .
     3322                                   ii = ii + 1 .
     3323                                   hh:width-chars = 3 .
     3324                               end.
     3325                           when "b-history" or
     3326                           when "b-hist" then
     3327                               do:
     3328                                   hh:load-image("cmp/b-hist.bmp":u) .
     3329                                   hh:TOOLTIP = "История" .
     3330                                   v-h[ii] = hh:handle .
     3331                                   ii = ii + 1 .
     3332                                   hh:width-chars = 3 .
     3333                               end.
     3334                           when "b-sch" then
     3335                               do:
     3336                                   hh:load-image("cmp/b-sch.bmp":u) .
     3337                                   hh:TOOLTIP = "Установка Фильтра" .
     3338                                   v-h[ii] = hh:handle .
     3339                                   ii = ii + 1 .
     3340                                   hh:width-chars = 3 .
     3341                               end.
     3342                           when "b-hist-user" then
     3343                               do:
     3344                                   hh:load-image("cmp/b-hist.bmp":u) .
     3345                                   hh:TOOLTIP = "История пользователя" .
     3346                                   ii = ii + 1 .
     3347                               end.
     3348                       end case.
     3349                   end.
     3350                   hh = hh:next-sibling.
     3351               end.
     3352               b-help:column = v-frame-width - b-help:width-chars.
     3353               jj = 0.
     3354               repeat ii = 4 to 1 by -1 :
     3355                   if valid-handle (v-h[ii] ) then
     3356                   do:
     3357                       jj  = jj + 1 .
     3358                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3359                       v-h[ii]:row    = v-help-old-y .
     3360                   end.
     3361               end.
     3362           end.
     3363       end.
     3364   end procedure.
     3365   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3366   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3367   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3368   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3369   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3370   define variable v-diasize-current-frame-height as decimal   no-undo .
     3371   define variable v-diasize-change-size          as logical   no-undo .
     3372   define variable v-diasize-resize-button        as handle    no-undo .
     3373   define variable v-diasize-wndmax               as logical   no-undo .
     3374   define variable v-diasize-wndstore             as logical   no-undo .
     3375   define variable v-diasize-proc-name            as character no-undo .
     3376   define variable v-diasize-browse-handle        as handle    no-undo .
     3377   define variable v-diasize-browse-number        as integer   no-undo .
     3378   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3379   define temp-table temp-diasize-handle no-undo
     3380     field handle-value  as handle
     3381     field save-position as decimal
     3382     index xpk is primary unique handle-value
     3383     .
     3384   define temp-table temp-browse-handle no-undo
     3385     field browse-type   as character
     3386     field browse-number as integer
     3387     field browse-handle as handle
     3388     field original-size as decimal
     3389     index xpk is primary unique browse-type browse-number
     3390     index xie browse-type browse-handle
     3391   .
     3392   procedure diasize_change-height :
     3393     define input  parameter p-change-value  as decimal   no-undo .
     3394     define input  parameter p-move-resize   as logical   no-undo .
     3395     define variable v-field-group-handle    as handle    no-undo .
     3396     define variable v-object-handle         as handle    no-undo .
     3397     define variable v-frame-height          as decimal   no-undo .
     3398     define variable v-frame-virtual-height  as decimal   no-undo .
     3399     define variable v-browse-height         as decimal   no-undo .
     3400     define variable v-window-height         as decimal   no-undo .
     3401     define variable v-window-virtual-height as decimal   no-undo .
     3402     define variable v-change-sign           as integer   no-undo .
     3403     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3404     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3405     if p-change-value > 0
     3406     then do:
     3407       if frame Dialog-Frame :height + p-change-value
     3408           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3409       then do:
     3410         assign
     3411           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3412                           - (frame Dialog-Frame :height-chars)
     3413         .
     3414         if p-change-value <= 0
     3415         then do:
     3416           run diasize_position-resize-button in this-procedure .
     3417           return .
     3418         end.
     3419       end.
     3420     end.
     3421     if p-change-value < 0
     3422     then do:
     3423       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3424       then do:
     3425         assign
     3426           p-change-value = v-diasize-orig-frame-height
     3427                          - (frame Dialog-Frame :height-chars)
     3428         .
     3429         if p-change-value >= 0
     3430         then do:
     3431           run diasize_position-resize-button in this-procedure .
     3432           return .
     3433         end.
     3434       end.
     3435     end.
     3436     if p-change-value >= 0
     3437     then do:
     3438       assign
     3439         v-change-sign = 1
     3440       .
     3441     end.
     3442     else do:
     3443       assign
     3444         v-change-sign = -1
     3445       .
     3446     end.
     3447     assign
     3448       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3449     .
     3450     if p-change-value = 0
     3451     then do:
     3452       run diasize_position-resize-button in this-procedure .
     3453       return .
     3454     end.
     3455     move_block:
     3456     do
     3457     on error undo move_block, retry move_block
     3458     :
     3459       if retry
     3460       then do:
     3461         do
     3462         on error undo move_block, leave move_block
     3463         :
     3464           if p-change-value > 0
     3465           then do:
     3466             for each buf_temp-diasize-handle
     3467             on error undo, next
     3468             :
     3469               assign
     3470                 v-object-handle = buf_temp-diasize-handle.handle-value
     3471               .
     3472               if v-object-handle <> v-diasize-resize-button
     3473               then do:
     3474                 assign
     3475                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3476                 .
     3477               end.
     3478             end.
     3479             assign
     3480               v-diasize-browse-handle :height = v-browse-height
     3481             .
     3482             for each buf_temp-browse-handle
     3483               where buf_temp-browse-handle.browse-type = 'height':u
     3484             on error undo, next
     3485             :
     3486               assign
     3487                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3488               .
     3489             end.
     3490             assign
     3491               frame Dialog-Frame :height = v-frame-height
     3492             .
     3493             if frame Dialog-Frame :scrollable = true
     3494             then do:
     3495               assign
     3496                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3497               .
     3498             end.
     3499             run diasize_position-resize-button in this-procedure .
     3500           end.
     3501           else do:
     3502             if frame Dialog-Frame :scrollable = true
     3503             then do:
     3504               assign
     3505                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3506               .
     3507             end.
     3508             assign
     3509               frame Dialog-Frame :height = v-frame-height
     3510             .
     3511             assign
     3512               v-diasize-browse-handle :height = v-browse-height
     3513             .
     3514             for each buf_temp-browse-handle
     3515               where buf_temp-browse-handle.browse-type = 'height':u
     3516             on error undo, next
     3517             :
     3518               assign
     3519                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3520               .
     3521             end.
     3522             for each buf_temp-diasize-handle
     3523             on error undo, next
     3524             :
     3525               assign
     3526                 v-object-handle = buf_temp-diasize-handle.handle-value
     3527               .
     3528               if v-object-handle <> v-diasize-resize-button
     3529               then do:
     3530                 assign
     3531                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3532                 .
     3533               end.
     3534             end.
     3535             run diasize_position-resize-button in this-procedure .
     3536           end.
     3537           assign
     3538             v-diasize-change-size = false
     3539           .
     3540           leave move_block .
     3541         end.
     3542       end.
     3543       assign
     3544         v-diasize-need-full-display = true
     3545       .
     3546       if v-diasize-change-size = false
     3547       then do:
     3548         assign
     3549           v-diasize-change-size = true
     3550         .
     3551       end.
     3552       else do:
     3553         return .
     3554       end.
     3555       assign
     3556         v-frame-height = frame Dialog-Frame :height
     3557         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3558         v-browse-height = v-diasize-browse-handle :height
     3559       .
     3560       for each buf_temp-browse-handle
     3561         where buf_temp-browse-handle.browse-type = 'height':u
     3562       :
     3563         assign
     3564           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3565         .
     3566       end.
     3567       for each buf_temp-diasize-handle
     3568       :
     3569         delete buf_temp-diasize-handle .
     3570       end.
     3571       assign
     3572         v-field-group-handle = frame Dialog-Frame :first-child
     3573       .
     3574       do while valid-handle(v-field-group-handle)
     3575       :
     3576         assign
     3577           v-object-handle = v-field-group-handle :first-child
     3578         .
     3579         do while valid-handle(v-object-handle)
     3580         :
     3581           if  v-object-handle <> v-diasize-browse-handle :handle
     3582           and can-query(v-object-handle, "row")
     3583           and can-query(v-object-handle, "height")
     3584           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3585           then do:
     3586             find first buf_temp-browse-handle
     3587               where buf_temp-browse-handle.browse-type   = 'height':u
     3588                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3589               no-error .
     3590             if available buf_temp-browse-handle
     3591             then do:
     3592             end.
     3593             else do:
     3594               create buf_temp-diasize-handle .
     3595               assign
     3596                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3597                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3598               .
     3599             end.
     3600           end.
     3601           assign
     3602             v-object-handle = v-object-handle :next-sibling
     3603           .
     3604         end.
     3605         assign
     3606           v-field-group-handle = v-field-group-handle :next-sibling
     3607         .
     3608       end.
     3609       do with frame Dialog-Frame
     3610       :
     3611         hide v-diasize-resize-button .
     3612         assign
     3613           v-diasize-resize-button :row    = 1
     3614           v-diasize-resize-button :column = 1
     3615         .
     3616       end.
     3617       if p-change-value > 0
     3618       then do:
     3619         if frame Dialog-Frame :scrollable = true
     3620         then do:
     3621           assign
     3622             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3623             no-error .
     3624           if error-status :error
     3625           or error-status :get-message(1) <> ""
     3626           then do:
     3627             undo move_block, retry move_block .
     3628           end.
     3629         end.
     3630         assign
     3631           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3632           no-error .
     3633         if error-status :error
     3634         or error-status :get-message(1) <> ""
     3635         then do:
     3636           undo move_block, retry move_block .
     3637         end.
     3638         assign
     3639           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3640           no-error .
     3641         if error-status :error
     3642         or error-status :get-message(1) <> ""
     3643         then do:
     3644           undo move_block, retry move_block .
     3645         end.
     3646         for each buf_temp-browse-handle
     3647           where buf_temp-browse-handle.browse-type = 'height':u
     3648         on error undo move_block, retry move_block
     3649         :
     3650           assign
     3651             buf_temp-browse-handle.browse-handle :height
     3652               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3653             no-error .
     3654           if error-status :error
     3655           or error-status :get-message(1) <> ""
     3656           then do:
     3657             undo move_block, retry move_block .
     3658           end.
     3659         end.
     3660         for each buf_temp-diasize-handle
     3661         on error undo move_block, retry move_block
     3662         :
     3663           assign
     3664             v-object-handle = buf_temp-diasize-handle.handle-value
     3665           .
     3666           if v-object-handle <> v-diasize-resize-button
     3667           then do:
     3668             assign
     3669               v-object-handle :row = v-object-handle :row + p-change-value
     3670               no-error .
     3671             if error-status :error
     3672             or error-status :get-message(1) <> ""
     3673             then do:
     3674               undo move_block, retry move_block .
     3675             end.
     3676           end.
     3677         end.
     3678       end.
     3679       else do:
     3680         for each buf_temp-diasize-handle
     3681         on error undo move_block, retry move_block
     3682         :
     3683           assign
     3684             v-object-handle = buf_temp-diasize-handle.handle-value
     3685           .
     3686           if v-object-handle <> v-diasize-resize-button
     3687           then do:
     3688             assign
     3689               v-object-handle :row = v-object-handle :row + p-change-value
     3690               no-error .
     3691             if error-status :error
     3692             or error-status :get-message(1) <> ""
     3693             then do:
     3694               undo move_block, retry move_block .
     3695             end.
     3696           end.
     3697         end.
     3698         assign
     3699           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3700           no-error .
     3701         if error-status :error
     3702         or error-status :get-message(1) <> ""
     3703         then do:
     3704           undo move_block, retry move_block .
     3705         end.
     3706         for each buf_temp-browse-handle
     3707           where buf_temp-browse-handle.browse-type = 'height':u
     3708         on error undo move_block, retry move_block
     3709         :
     3710           assign
     3711             buf_temp-browse-handle.browse-handle :height
     3712               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3713             no-error .
     3714           if error-status :error
     3715           or error-status :get-message(1) <> ""
     3716           then do:
     3717             undo move_block, retry move_block .
     3718           end.
     3719         end.
     3720         assign
     3721           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3722           no-error .
     3723         if error-status :error
     3724         or error-status :get-message(1) <> ""
     3725         then do:
     3726           undo move_block, retry move_block .
     3727         end.
     3728         if frame Dialog-Frame :scrollable = true
     3729         then do:
     3730           assign
     3731             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3732             no-error .
     3733           if error-status :error
     3734           or error-status :get-message(1) <> ""
     3735           then do:
     3736             undo move_block, retry move_block .
     3737           end.
     3738         end.
     3739       end.
     3740       if p-move-resize = true
     3741       then do:
     3742         run diasize_position-resize-button in this-procedure .
     3743       end.
     3744       if v-diasize-wndstore = true
     3745       then do:
     3746         if connected("ub") = true
     3747         then do:
     3748           define variable v-cntxt-db-num        as integer   no-undo .
     3749           define variable v-cntxt-userid        as character no-undo .
     3750           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3751                                             , OUTPUT v-cntxt-userid
     3752                                             ) .
     3753           run gbl/wndsizew.p
     3754             (input  v-cntxt-db-num
     3755             ,input  v-cntxt-userid
     3756             ,input  v-diasize-proc-name
     3757             ,input  'height':u
     3758             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3759             ) .
     3760         end.
     3761       end.
     3762     end.
     3763     assign
     3764       v-diasize-change-size = false
     3765     .
     3766   end procedure.
     3767   procedure diasize_set-height :
     3768     define input  parameter p-new-height  as decimal   no-undo .
     3769     define input  parameter p-move-resize as logical   no-undo .
     3770     do
     3771     on error undo, return error return-value
     3772     :
     3773       run diasize_change-height in this-procedure
     3774         (input  (p-new-height - frame Dialog-Frame :height)
     3775         ,input  p-move-resize
     3776         ) .
     3777     end.
     3778   end procedure.
     3779   procedure diasize_change-width :
     3780     define input  parameter p-change-value as decimal   no-undo .
     3781     define input  parameter p-move-resize  as logical   no-undo .
     3782     define variable v-field-group-handle   as handle    no-undo .
     3783     define variable v-object-handle        as handle    no-undo .
     3784     define variable v-frame-width          as decimal   no-undo .
     3785     define variable v-frame-virtual-width  as decimal   no-undo .
     3786     define variable v-browse-width         as decimal   no-undo .
     3787     define variable v-window-width         as decimal   no-undo .
     3788     define variable v-window-virtual-width as decimal   no-undo .
     3789     define variable v-change-sign          as integer   no-undo .
     3790     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3791     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3792     if p-change-value > 0
     3793     then do:
     3794       if frame Dialog-Frame :width + p-change-value >
     3795           session :width-chars
     3796       then do:
     3797         assign
     3798           p-change-value = session :width-chars - frame Dialog-Frame :width
     3799         .
     3800         if p-change-value <= 0
     3801         then do:
     3802           run diasize_position-resize-button in this-procedure .
     3803           return .
     3804         end.
     3805       end.
     3806     end.
     3807     if p-change-value < 0
     3808     then do:
     3809       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3810       then do:
     3811         assign
     3812           p-change-value = v-diasize-orig-frame-width
     3813                          - frame Dialog-Frame :width
     3814         .
     3815         if p-change-value >= 0
     3816         then do:
     3817           run diasize_position-resize-button in this-procedure .
     3818           return .
     3819         end.
     3820       end.
     3821     end.
     3822     if p-change-value >= 0
     3823     then do:
     3824       assign
     3825         v-change-sign = 1
     3826       .
     3827     end.
     3828     else do:
     3829       assign
     3830         v-change-sign = -1
     3831       .
     3832     end.
     3833     assign
     3834       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3835     .
     3836     if p-change-value = 0
     3837     then do:
     3838       run diasize_position-resize-button in this-procedure .
     3839       return .
     3840     end.
     3841     move_block:
     3842     do
     3843     on error undo move_block, leave move_block
     3844     :
     3845       if retry
     3846       then do:
     3847         do
     3848         on error undo move_block, leave move_block
     3849         :
     3850           if p-change-value > 0
     3851           then do:
     3852             for each buf_temp-diasize-handle
     3853             on error undo, next
     3854             :
     3855               assign
     3856                 v-object-handle = buf_temp-diasize-handle.handle-value
     3857               .
     3858               if v-object-handle <> v-diasize-resize-button
     3859               then do:
     3860                 assign
     3861                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3862                 .
     3863               end.
     3864             end.
     3865             assign
     3866               v-diasize-browse-handle :width = v-browse-width
     3867             .
     3868             for each buf_temp-browse-handle
     3869               where buf_temp-browse-handle.browse-type = 'width':u
     3870             on error undo, next
     3871             :
     3872               assign
     3873                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3874               .
     3875             end.
     3876             assign
     3877               frame Dialog-Frame :width = v-frame-width
     3878             .
     3879             if frame Dialog-Frame :scrollable = true
     3880             then do:
     3881               assign
     3882                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3883               .
     3884             end.
     3885             run diasize_position-resize-button in this-procedure .
     3886           end.
     3887           else do:
     3888             if frame Dialog-Frame :scrollable = true
     3889             then do:
     3890               assign
     3891                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3892               .
     3893             end.
     3894             assign
     3895               frame Dialog-Frame :width = v-frame-width
     3896             .
     3897             for each buf_temp-browse-handle
     3898               where buf_temp-browse-handle.browse-type = 'width':u
     3899             on error undo, next
     3900             :
     3901               assign
     3902                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3903               .
     3904             end.
     3905             assign
     3906               v-diasize-browse-handle :width = v-browse-width
     3907             .
     3908             for each buf_temp-diasize-handle
     3909             on error undo, next
     3910             :
     3911               assign
     3912                 v-object-handle = buf_temp-diasize-handle.handle-value
     3913               .
     3914               if v-object-handle <> v-diasize-resize-button
     3915               then do:
     3916                 assign
     3917                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3918                 .
     3919               end.
     3920             end.
     3921             run diasize_position-resize-button in this-procedure .
     3922           end.
     3923           assign
     3924             v-diasize-change-size = false
     3925           .
     3926           leave move_block .
     3927         end.
     3928       end.
     3929       assign
     3930         v-diasize-need-full-display = true
     3931       .
     3932       if v-diasize-change-size = false
     3933       then do:
     3934         assign
     3935           v-diasize-change-size = true
     3936         .
     3937       end.
     3938       else do:
     3939         return .
     3940       end.
     3941       assign
     3942         v-frame-width = frame Dialog-Frame :width
     3943         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3944         v-browse-width = v-diasize-browse-handle :width
     3945       .
     3946       for each buf_temp-browse-handle
     3947         where buf_temp-browse-handle.browse-type = 'width':u
     3948       :
     3949         assign
     3950           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3951         .
     3952       end.
     3953       for each buf_temp-diasize-handle
     3954       :
     3955         delete buf_temp-diasize-handle .
     3956       end.
     3957       assign
     3958         v-field-group-handle = frame Dialog-Frame :first-child
     3959       .
     3960       do while valid-handle(v-field-group-handle)
     3961       :
     3962         assign
     3963           v-object-handle = v-field-group-handle :first-child
     3964         .
     3965         do while valid-handle(v-object-handle)
     3966         :
     3967           if  v-object-handle <> v-diasize-browse-handle :handle
     3968           and v-object-handle <> v-diasize-resize-button
     3969           and can-query(v-object-handle, "row")
     3970           and can-query(v-object-handle, "height")
     3971           and ( v-object-handle :col + v-object-handle :width
     3972                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3973               )
     3974           then do:
     3975             find first buf_temp-browse-handle
     3976               where buf_temp-browse-handle.browse-type   = 'width':u
     3977                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3978               no-error .
     3979             if available buf_temp-browse-handle
     3980             then do:
     3981             end.
     3982             else do:
     3983               create buf_temp-diasize-handle .
     3984               assign
     3985                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3986                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3987               .
     3988             end.
     3989           end.
     3990           assign
     3991             v-object-handle = v-object-handle :next-sibling
     3992           .
     3993         end.
     3994         assign
     3995           v-field-group-handle = v-field-group-handle :next-sibling
     3996         .
     3997       end.
     3998       do with frame Dialog-Frame
     3999       :
     4000         hide v-diasize-resize-button .
     4001         v-diasize-resize-button :row = 1.
     4002         v-diasize-resize-button :column = 1.
     4003       end.
     4004       if p-change-value > 0
     4005       then do:
     4006         if frame Dialog-Frame :scrollable = true
     4007         then do:
     4008           assign
     4009             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4010             no-error .
     4011           if error-status :error
     4012           or error-status :get-message(1) <> ""
     4013           then do:
     4014             undo move_block, retry move_block.
     4015           end.
     4016         end.
     4017         assign
     4018           frame Dialog-Frame :width = v-frame-width + p-change-value
     4019           no-error .
     4020         if error-status :error
     4021         or error-status :get-message(1) <> ""
     4022         then do:
     4023           undo move_block, retry move_block.
     4024         end.
     4025         assign
     4026           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4027         no-error .
     4028         if error-status :error
     4029         or error-status :get-message(1) <> ""
     4030         then do:
     4031           undo move_block, retry move_block.
     4032         end.
     4033         for each buf_temp-browse-handle
     4034           where buf_temp-browse-handle.browse-type = 'width':u
     4035         on error undo move_block, retry move_block
     4036         :
     4037           assign
     4038             buf_temp-browse-handle.browse-handle :width
     4039               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4040             no-error .
     4041           if error-status :error
     4042           or error-status :get-message(1) <> ""
     4043           then do:
     4044             undo move_block, retry move_block .
     4045           end.
     4046         end.
     4047         for each buf_temp-diasize-handle
     4048         on error undo move_block, retry move_block
     4049         :
     4050           assign
     4051             v-object-handle = buf_temp-diasize-handle.handle-value
     4052           .
     4053           if v-object-handle <> v-diasize-resize-button
     4054           then do:
     4055             assign
     4056               v-object-handle :col = v-object-handle :col + p-change-value
     4057               no-error .
     4058             if error-status :error
     4059             or error-status :get-message(1) <> ""
     4060             then do:
     4061               undo move_block, retry move_block .
     4062             end.
     4063           end.
     4064         end.
     4065       end.
     4066       else do:
     4067         for each buf_temp-diasize-handle
     4068         on error undo move_block, retry move_block
     4069         :
     4070           assign
     4071             v-object-handle = buf_temp-diasize-handle.handle-value
     4072           .
     4073           if v-object-handle <> v-diasize-resize-button
     4074           then do:
     4075             assign
     4076               v-object-handle :col = v-object-handle :col + p-change-value
     4077               no-error .
     4078             if error-status :error
     4079             or error-status :get-message(1) <> ""
     4080             then do:
     4081               undo move_block, retry move_block .
     4082             end.
     4083           end.
     4084         end.
     4085         for each buf_temp-browse-handle
     4086           where buf_temp-browse-handle.browse-type = 'width':u
     4087         on error undo move_block, retry move_block
     4088         :
     4089           assign
     4090             buf_temp-browse-handle.browse-handle :width
     4091               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4092             no-error .
     4093           if error-status :error
     4094           or error-status :get-message(1) <> ""
     4095           then do:
     4096             undo move_block, retry move_block .
     4097           end.
     4098         end.
     4099         assign
     4100           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4101           no-error .
     4102         if error-status :error
     4103         or error-status :get-message(1) <> ""
     4104         then do:
     4105           undo move_block, retry move_block.
     4106         end.
     4107         assign
     4108           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4109         no-error .
     4110         if error-status :error
     4111         or error-status :get-message(1) <> ""
     4112         then do:
     4113           undo move_block, retry move_block.
     4114         end.
     4115         if frame Dialog-Frame :scrollable = true
     4116         then do:
     4117           assign
     4118             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4119           no-error .
     4120           if error-status :error
     4121           or error-status :get-message(1) <> ""
     4122           then do:
     4123             undo move_block, retry move_block.
     4124           end.
     4125         end.
     4126       end.
     4127       if p-move-resize
     4128       then do:
     4129         run diasize_position-resize-button in this-procedure .
     4130       end.
     4131       if v-diasize-wndstore = true
     4132       then do:
     4133         if connected("ub") = true
     4134         then do:
     4135           define variable v-cntxt-db-num        as integer   no-undo .
     4136           define variable v-cntxt-userid        as character no-undo .
     4137           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4138                                             , OUTPUT v-cntxt-userid
     4139                                             ) .
     4140           run gbl/wndsizew.p
     4141             (input  v-cntxt-db-num
     4142             ,input  v-cntxt-userid
     4143             ,input  v-diasize-proc-name
     4144             ,input  'width':u
     4145             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4146             ) .
     4147         end.
     4148       end.
     4149     end.
     4150     assign
     4151       v-diasize-change-size = false
     4152     .
     4153   end procedure.
     4154   procedure diasize_set-width :
     4155     define input  parameter p-new-width  as decimal   no-undo .
     4156     define input  parameter p-move-resize as logical   no-undo .
     4157     do
     4158     on error undo, return error return-value
     4159     :
     4160       run diasize_change-width in this-procedure
     4161         (input  (p-new-width - frame Dialog-Frame :width)
     4162         ,input  p-move-resize
     4163         ) .
     4164     end.
     4165   end procedure.
     4166   procedure diasize_position-resize-button :
     4167     do with frame Dialog-Frame
     4168     :
     4169       hide v-diasize-resize-button .
     4170       assign
     4171         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4172                     - 1
     4173                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4174         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4175                     - 1
     4176                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4177       .
     4178       view v-diasize-resize-button .
     4179     end.
     4180   end procedure.
     4181   on alt-right anywhere
     4182   do:
     4183     run diasize_change-width in this-procedure
     4184       (input 1
     4185       ,input true
     4186       ) .
     4187     return no-apply .
     4188   end.
     4189   on alt-left anywhere
     4190   do:
     4191     run diasize_change-width in this-procedure
     4192       (input -1
     4193       ,input true
     4194       ) .
     4195     return no-apply .
     4196   end.
     4197   on alt-down anywhere
     4198   do:
     4199     run diasize_change-height in this-procedure
     4200       (input 1
     4201       ,input true
     4202       ) .
     4203     return no-apply .
     4204   end.
     4205   on alt-up anywhere
     4206   do:
     4207     run diasize_change-height in this-procedure
     4208       (input -1
     4209       ,input true
     4210       ) .
     4211     return no-apply .
     4212   end.
     4213   on alt-enter of frame Dialog-Frame
     4214   do:
     4215     run diasize_maximize in this-procedure
     4216       (input  ?
     4217       ).
     4218     return no-apply .
     4219   end.
     4220   procedure diasize_end-move :
     4221     do
     4222     on error undo, return error return-value
     4223     :
     4224       define variable v-row-delta as decimal   no-undo .
     4225       define variable v-col-delta as decimal   no-undo .
     4226       define variable v-new-row as decimal   no-undo .
     4227       define variable v-new-col as decimal   no-undo .
     4228       assign
     4229         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4230         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4231       .
     4232       assign
     4233         v-row-delta = v-new-row - frame Dialog-Frame :height
     4234         v-col-delta = v-new-col - frame Dialog-Frame :width
     4235       .
     4236       run diasize_change-height in this-procedure
     4237         (input v-row-delta
     4238         ,input true
     4239         ) .
     4240       run diasize_change-width in this-procedure
     4241         (input v-col-delta
     4242         ,input true
     4243         ) .
     4244     end.
     4245   end procedure.
     4246   procedure diasize_maximize :
     4247     define input  parameter p-action as logical   no-undo .
     4248     do
     4249     on error undo, return error return-value
     4250     :
     4251       if p-action = ?
     4252       then do:
     4253         if v-diasize-need-maximize = true
     4254         then do:
     4255           assign
     4256             p-action = true
     4257           .
     4258         end.
     4259         else do:
     4260           assign
     4261             p-action = false
     4262           .
     4263         end.
     4264       end.
     4265       if p-action = true
     4266       then do:
     4267         run diasize_change-height in this-procedure
     4268           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4269               - frame Dialog-Frame :height-chars
     4270           ,input true
     4271           ) .
     4272         run diasize_change-width in this-procedure
     4273           (input session :width-chars
     4274               - frame Dialog-Frame :width-chars
     4275           ,input true
     4276           ) .
     4277         assign
     4278           v-diasize-need-maximize = false
     4279         .
     4280       end.
     4281       else do:
     4282         run diasize_change-width in this-procedure
     4283           (input v-diasize-orig-frame-width
     4284               - frame Dialog-Frame :width-chars
     4285           ,input true
     4286           ) .
     4287         run diasize_change-height in this-procedure
     4288           (input v-diasize-orig-frame-height
     4289               - frame Dialog-Frame :height-chars
     4290           ,input true
     4291           ) .
     4292         assign
     4293           v-diasize-need-maximize = true
     4294         .
     4295       end.
     4296     end.
     4297   end procedure.
     4298   procedure diasize_restore-orig-size :
     4299     do
     4300     on error undo, return error return-value
     4301     :
     4302       assign
     4303         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4304         v-diasize-current-frame-height = frame Dialog-Frame :height
     4305       .
     4306       run diasize_set-height in this-procedure
     4307         (input  v-diasize-orig-frame-height
     4308         ,input  true
     4309         ) .
     4310       run diasize_set-width in this-procedure
     4311         (input  v-diasize-orig-frame-width
     4312         ,input  true
     4313         ) .
     4314     end.
     4315   end procedure.
     4316   procedure diasize_restore-current-size :
     4317     do
     4318     on error undo, return error return-value
     4319     :
     4320       run diasize_set-height in this-procedure
     4321         (input  v-diasize-current-frame-height
     4322         ,input  true
     4323         ) .
     4324       run diasize_set-width in this-procedure
     4325         (input  v-diasize-current-frame-width
     4326         ,input  true
     4327         ) .
     4328     end.
     4329   end procedure.
     4330   procedure diasize_set-browse-handle :
     4331     define input  parameter p-browse-handle as handle   no-undo .
     4332     define buffer buf_temp-browse-handle for temp-browse-handle .
     4333     do
     4334     on error undo, return error return-value
     4335     :
     4336       assign
     4337         v-diasize-browse-handle = p-browse-handle
     4338       .
     4339       for each buf_temp-browse-handle
     4340       on error undo, return error return-value
     4341       :
     4342         delete buf_temp-browse-handle .
     4343       end.
     4344     end.
     4345   end procedure.
     4346   procedure diasize_add_browse :
     4347     define input  parameter p-browse-type   as character no-undo .
     4348     define input  parameter p-browse-handle as handle    no-undo .
     4349     define buffer buf_temp-browse-handle for temp-browse-handle .
     4350     do
     4351     on error undo, return error return-value
     4352     :
     4353       assign
     4354         v-diasize-browse-number = v-diasize-browse-number + 1
     4355       .
     4356       create buf_temp-browse-handle .
     4357       assign
     4358         buf_temp-browse-handle.browse-type   = p-browse-type
     4359         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4360         buf_temp-browse-handle.browse-handle = p-browse-handle
     4361       .
     4362     end.
     4363   end procedure.
     4364   procedure diasize_init :
     4365     define variable v-default-value    as logical   no-undo .
     4366     define variable v-restore-saved    as logical   no-undo .
     4367     define variable v-resize-value-str as character no-undo .
     4368     do
     4369     on error undo, return error return-value
     4370     :
     4371       do with frame Dialog-Frame
     4372       :
     4373         assign
     4374           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4375           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4376           v-diasize-browse-handle     = browse br-cdocs :handle
     4377         .
     4378         create button v-diasize-resize-button
     4379         assign
     4380           parent        = frame Dialog-Frame :first-child
     4381           label         = "s"
     4382           height-pixels = 16
     4383           width-pixels  = 16
     4384           visible       = true
     4385           sensitive     = true
     4386           movable       = true
     4387           triggers:
     4388             on end-move persistent run diasize_end-move in this-procedure .
     4389           end triggers.
     4390         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4391         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4392         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4393         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4394         assign
     4395           v-diasize-wndmax = false
     4396         .
     4397         if connected("ub") = true
     4398         then do:
     4399           define variable v-cntxt-db-num        as integer   no-undo .
     4400           define variable v-cntxt-userid        as character no-undo .
     4401           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4402                                             , OUTPUT v-cntxt-userid
     4403                                             ) .
     4404           run gbl/wndpar_r.p
     4405             (input  v-cntxt-db-num
     4406             ,input  v-cntxt-userid
     4407             ,input  'wndmax':U
     4408             ,output v-diasize-wndmax
     4409             ,output v-default-value
     4410             ) .
     4411         end.
     4412         assign
     4413           v-diasize-wndstore = false
     4414         .
     4415         if connected("ub") = true
     4416         then do:
     4417           run gbl/wndpar_r.p
     4418             (input  v-cntxt-db-num
     4419             ,input  v-cntxt-userid
     4420             ,input  'wndstore':U
     4421             ,output v-diasize-wndstore
     4422             ,output v-default-value
     4423             ) .
     4424         end.
     4425         assign
     4426           v-diasize-proc-name = entry(1, program-name(2), '.')
     4427         .
     4428         if v-diasize-wndstore = true
     4429         then do:
     4430           assign
     4431             v-restore-saved = false
     4432           .
     4433           if connected("ub") = true
     4434           then do:
     4435             run gbl/wndsizer.p
     4436               (input  v-cntxt-db-num
     4437               ,input  v-cntxt-userid
     4438               ,input  v-diasize-proc-name
     4439               ,input  'height':u
     4440               ,output v-resize-value-str
     4441               ) .
     4442             if v-resize-value-str <> '':U
     4443             then do:
     4444               run diasize_change-height in this-procedure
     4445                 (input  integer(v-resize-value-str)
     4446                 ,input  true
     4447                 ) .
     4448               assign
     4449                 v-restore-saved = true
     4450               .
     4451             end.
     4452           end.
     4453           if connected("ub") = true
     4454           then do:
     4455             run gbl/wndsizer.p
     4456               (input  v-cntxt-db-num
     4457               ,input  v-cntxt-userid
     4458               ,input  v-diasize-proc-name
     4459               ,input  'width':u
     4460               ,output v-resize-value-str
     4461               ) .
     4462             if v-resize-value-str <> '':U
     4463             then do:
     4464               run diasize_change-width in this-procedure
     4465                 (input  integer(v-resize-value-str)
     4466                 ,input  true
     4467                 ) .
     4468               assign
     4469                 v-restore-saved = true
     4470               .
     4471             end.
     4472           end.
     4473           if v-restore-saved <> true
     4474           then do:
     4475             if v-diasize-wndmax = true
     4476             then do:
     4477               run diasize_maximize in this-procedure
     4478                 (input  true
     4479                 ) .
     4480             end.
     4481           end.
     4482         end.
     4483         else do:
     4484           if v-diasize-wndmax = true
     4485           then do:
     4486             run diasize_maximize in this-procedure
     4487               (input  true
     4488               ) .
     4489           end.
     4490         end.
     4491       end.
     4492     end.
     4493   end procedure.
     4494   procedure diasize_need-full-display :
     4495     define output parameter p-need-full-display as logical   no-undo .
     4496     do
     4497     on error undo, return error return-value
     4498     :
     4499       assign
     4500         p-need-full-display = v-diasize-need-full-display
     4501       .
     4502       assign
     4503         v-diasize-need-full-display = false
     4504       .
     4505     end.
     4506   end procedure.
     4507   procedure get-context :
     4508      define output parameter p-db-num as integer          no-undo.
     4509      define output parameter p-user-id as character        no-undo.
     4510      define variable v-login               as character    no-undo.
     4511      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4512      define buffer buf_user-login  for ub.user-login .
     4513      do
     4514      on error undo, return error
     4515      :
     4516            FIND FIRST buf_sys-ctrl no-lock.
     4517            ASSIGN
     4518               v-login = USERID("ub")
     4519               p-db-num = buf_sys-ctrl.db-num
     4520            .
     4521            FIND FIRST buf_user-login
     4522                 WHERE buf_user-login.db-num = p-db-num
     4523                   AND buf_user-login.user-login = v-login
     4524                 no-lock
     4525                 no-error
     4526                 .
     4527            IF AVAILABLE buf_user-login
     4528            THEN DO:
     4529               assign
     4530                  p-user-id = buf_user-login.user-id
     4531               .
     4532            END.
     4533      end.
     4534   end procedure.
     4535       run diasize_init in this-procedure .
     4536   def var sort-labelbr-cdocs   as character no-undo .
     4537   def var sort-clmnbr-cdocs    as handle    no-undo .
     4538   def var cur-clmnbr-cdocs     as handle    no-undo .
     4539   def var cur-clmn-locbr-cdocs as integer   no-undo .
     4540   def var re-querybr-cdocs     as logical   initial no no-undo .
     4541   on start-search, ctrl-o of br-cdocs in frame Dialog-Frame do:
     4542      run sort-brbr-cdocs
     4543        (input (if available c-fin-ob
     4544                then recid(c-fin-ob)
     4545                else ?
     4546               )
     4547        ).
     4548   end.
     4549   PROCEDURE sort-brbr-cdocs :
     4550     define input parameter p-recid as recid no-undo .
     4551     if re-querybr-cdocs = no then do:
     4552       assign
     4553          cur-clmnbr-cdocs = br-cdocs:current-column in frame Dialog-Frame
     4554       .
     4555       if sort-clmnbr-cdocs <> ? then sort-clmnbr-cdocs:column-fgcolor = 0.
     4556       if cur-clmnbr-cdocs = sort-clmnbr-cdocs then do:
     4557         assign
     4558            sort-labelbr-cdocs = ""
     4559            sort-clmnbr-cdocs = ?
     4560         .
     4561        end.
     4562        else do:
     4563          assign
     4564            sort-labelbr-cdocs = cur-clmnbr-cdocs:label
     4565            sort-clmnbr-cdocs  = cur-clmnbr-cdocs
     4566            sort-clmnbr-cdocs:column-fgcolor = 4
     4567          .
     4568        end.
     4569      end.
     4570     assign
     4571       cur-clmn-locbr-cdocs = 1
     4572     .
     4573     def var column-handle as handle no-undo .
     4574     column-handle = br-cdocs:first-column.
     4575     do while valid-handle(column-handle) :
     4576       if column-handle = cur-clmnbr-cdocs then do:
     4577         leave .
     4578       end.
     4579       column-handle = column-handle:NEXT-COLUMN.
     4580       assign
     4581         cur-clmn-locbr-cdocs = cur-clmn-locbr-cdocs + 1
     4582       .
     4583     end.
     4584     case sort-labelbr-cdocs:
     4585           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_fin-liab), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     4586           when 'Статуc'  then DO:    assign       sort-column-name = "buf_fin-liab.status_"     .     run OpenBr(yes, no, '':U).   . END.
     4587           when '№ док-та'  then DO:    assign       sort-column-name = "buf_fin-liab.prn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     4588           when 'Создан'  then DO:    assign       sort-column-name = "buf_fin-liab.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     4589           when 'Удален'  then DO:    assign       sort-column-name = "buf_fin-liab.corr-date"     .     run OpenBr(yes, no, '':U).   . END.
     4590           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-id&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     4591           when 'Получатель'  then DO:    assign       sort-column-name = "(buf_fin-liab.receiver-type + ' ' + string(buf_fin-liab.receiver-code))"     .     run OpenBr(yes, no, '':U).   . END.
     4592           when 'Плательщик'  then DO:    assign       sort-column-name = "(buf_fin-liab.payer-type + ' ' + string(buf_fin-liab.payer-code))"     .     run OpenBr(yes, no, '':U).   . END.
     4593           when 'Платеж'  then DO:    assign       sort-column-name = "buf_fin-liab.pay-date"     .     run OpenBr(yes, no, '':U).   . END.
     4594           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1val-abbr-type&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     4595           when 'Сумма в валюте док-та'  then DO:    assign       sort-column-name = "buf_fin-liab.sum-doc"     .     run OpenBr(yes, no, '':U).   . END.
     4596           when 'Внутр.№'  then DO:    assign       sort-column-name = "buf_fin-liab.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     4597           when 'Тип'  then DO:    assign       sort-column-name = "if buf_fin-liab.doc-type = 'при':U then 'c покупателем' else 'c поcтавщиком'"     .     run OpenBr(yes, no, '':U).   . END.
     4598           when 'Непогаш.задолж.(руб.)'  then DO:    assign       sort-column-name = "(buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl)"     .     run OpenBr(yes, no, '':U).   . END.
     4599           when 'Объект'  then DO:    assign       sort-column-name = "(buf_fin-liab.obj-type + ' ' + string(buf_fin-liab.obj-code))"     .     run OpenBr(yes, no, '':U).   . END.
     4600           when 'Наименование'  then DO:    assign       sort-column-name = "buf_fin-liab.receiver-name"     .     run OpenBr(yes, no, '':U).   . END.
     4601           when 'Уcловие генерации'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-gen&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     4602       otherwise do:
     4603         assign
     4604           sort-column-name = ""
     4605         .
     4606         run OpenBr(yes, no, '':U).
     4607           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cdocs') then do:
     4608             run mv-brw-defaultbr-cdocs.
     4609           end.
     4610         if sort-labelbr-cdocs <> "" then do:
     4611           assign
     4612             cur-clmnbr-cdocs:column-fgcolor = 0
     4613           .
     4614         end.
     4615         assign
     4616           cur-clmn-locbr-cdocs = ?
     4617         .
     4618       end.
     4619     end case.
     4620       if cur-clmn-locbr-cdocs <> ? then do:
     4621         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cdocs') then do:
     4622           run ch-clmnbr-cdocs in this-procedure (cur-clmn-locbr-cdocs).
     4623         end.
     4624       end.
     4625     if p-recid <> ? then do:
     4626       reposition br-cdocs to recid p-recid no-error.
     4627       apply "value-changed" to br-cdocs in frame Dialog-Frame.
     4628     end.
     4629     apply "entry" to br-cdocs in frame Dialog-Frame.
     4630   END PROCEDURE.
     4631   procedure re-open-query-srt-clmnbr-cdocs:
     4632   if cur-clmnbr-cdocs = ? then do:
     4633      run OpenBr(yes, no, '':U).
     4634   end.
     4635   else do:
     4636      assign re-querybr-cdocs = yes.
     4637      run sort-brbr-cdocs
     4638        (input (if available c-fin-ob
     4639                then recid(c-fin-ob)
     4640                else ?
     4641               )
     4642        ).
     4643      assign re-querybr-cdocs = no.
     4644   end.
     4645   end.
     4646   MAIN-BLOCK:
     4647   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4648      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4649     find first sysconf no-lock where sysconf.host-code = par-host-code no-error .
     4650     var-fin-calc = sysconf.fin-calc   .
     4651   buf_fin-liab.receiver-name:resizable in browse br-cdocs   = true .
     4652   buf_fin-liab.sum-doc:resizable in browse br-cdocs   = true .
     4653   buf_fin-liab.status_:resizable in browse br-cdocs   = true .
     4654   buf_fin-liab.receiver-name:width     in browse br-cdocs   = v-size-col1 .
     4655   buf_fin-liab.sum-doc:width     in browse br-cdocs   = v-size-col3 .
     4656   buf_fin-liab.status_:width     in browse br-cdocs   = v-size-col5 .
     4657   buf_fin-liab.status_:read-only in browse br-cdocs = true .
     4658   define variable p-file-label as character no-undo .
     4659   p-file-label =  "Удаленные Финанcовые обязательcтва".
     4660   r-abbr  =  "РУБ".
     4661   define buffer buf_clients for  ub.clients .
     4662   CASE par-mode:
     4663       WHEN 'фирма':U THEN DO:
     4664         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     4665         if not available buf_clients then  return .
     4666       END.
     4667       WHEN "doc-type":U THEN DO:
     4668         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     4669         if not available buf_clients then  return .
     4670       END.
     4671       WHEN "status":U THEN DO:
     4672         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     4673         if not available buf_clients then  return .
     4674       END.
     4675       WHEN "contract":U THEN DO:
     4676       end.
     4677       otherwise do:
     4678         message vss-workfile vss-revision vss-description skip
     4679         "Неверный вызов - par-mode=" par-mode
     4680         view-as alert-box ERROR.
     4681         return.
     4682       end.
     4683     end CASE.
     4684       if pardoc-rec <> ? then do:
     4685         FIND FIRST find_code No-LOCK where
     4686                    recid(find_code) = pardoc-rec No-ERROR.
     4687         if not avail find_code then do:
     4688           message
     4689           vss-workfile vss-revision vss-description skip
     4690           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     4691           view-as alert-box error .
     4692           return error.
     4693         end.
     4694         doc-rec = pardoc-rec.
     4695       end.
     4696     run my-enable_ui in this-procedure .
     4697     r-1 = 1 .
     4698     r-2 = 1 .
     4699     r-3 = 1 .
     4700     run openbr in this-procedure ( yes, no, '':u).
     4701   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4702   DEF VAR cur-clmn-numbr-cdocs as INT EXTENT 17 no-undo.
     4703   DEF VAR varmvibr-cdocs       as INT no-undo.
     4704   DEF VAR varmvjbr-cdocs       as INT no-undo.
     4705   DEF VAR varmvkbr-cdocs       as INT no-undo.
     4706   DEF VAR varmvlbr-cdocs       as INT no-undo.
     4707   DEF VAR move-elementbr-cdocs as INT no-undo.
     4708   def var jjbr-cdocs           as int no-undo.
     4709   do varmvibr-cdocs = 1 to EXTENT(cur-clmn-numbr-cdocs):
     4710     ASSIGN cur-clmn-numbr-cdocs[varmvibr-cdocs] = varmvibr-cdocs.
     4711   END.
     4712   RUN start-mv-clmnbr-cdocs.
     4713   PROCEDURE start-mv-clmnbr-cdocs:
     4714   def var old-session as logical no-undo.
     4715      old-session = SESSION:IMMEDIATE-DISPLAY.
     4716      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4717          IF  true = true   THEN DO:
     4718      DO jjbr-cdocs = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     4719        RUN re-move-clmnbr-cdocs ( cur-clmn-numbr-cdocs[INTEGER(ENTRY (jjbr-cdocs, v-order-col))] , 4).
     4720      END.
     4721          END.
     4722      SESSION:IMMEDIATE-DISPLAY = old-session.
     4723   END.
     4724   ON ctrl-cursor-right OF BROWSE br-cdocs do:
     4725     RUN re-move-clmnbr-cdocs ( 4, 17).
     4726   END.
     4727   ON ctrl-cursor-left OF BROWSE br-cdocs do:
     4728     RUN re-move-clmnbr-cdocs (17, 4).
     4729   END.
     4730   PROCEDURE re-move-clmnbr-cdocs:
     4731     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4732     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4733     DO varmvibr-cdocs = 1 TO EXTENT(cur-clmn-numbr-cdocs):
     4734       if cur-clmn-numbr-cdocs[varmvibr-cdocs] = source-column THEN cur-clmn-numbr-cdocs[varmvibr-cdocs] = -1.
     4735     END.
     4736     if br-cdocs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4737     if source-column > target-column THEN
     4738     DO varmvjbr-cdocs = source-column - 1 to target-column BY -1:
     4739       DO varmvibr-cdocs = 1 TO EXTENT(cur-clmn-numbr-cdocs):
     4740           if cur-clmn-numbr-cdocs[varmvibr-cdocs] = varmvjbr-cdocs THEN DO:
     4741             cur-clmn-numbr-cdocs[varmvibr-cdocs] = cur-clmn-numbr-cdocs[varmvibr-cdocs] + 1.
     4742           END.
     4743       END.
     4744     END.
     4745     ELSE
     4746     DO varmvjbr-cdocs = source-column + 1 to target-column:
     4747       DO varmvibr-cdocs = 1 TO EXTENT(cur-clmn-numbr-cdocs):
     4748         if cur-clmn-numbr-cdocs[varmvibr-cdocs] = varmvjbr-cdocs THEN DO:
     4749           cur-clmn-numbr-cdocs[varmvibr-cdocs] = cur-clmn-numbr-cdocs[varmvibr-cdocs] - 1.
     4750         END.
     4751       END.
     4752     END.
     4753     DO varmvibr-cdocs = 1 TO EXTENT(cur-clmn-numbr-cdocs):
     4754       if cur-clmn-numbr-cdocs[varmvibr-cdocs] = -1 THEN cur-clmn-numbr-cdocs[varmvibr-cdocs] = target-column.
     4755     END.
     4756   END PROCEDURE.
     4757   PROCEDURE ch-clmnbr-cdocs:
     4758     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4759     if cur-clmn-loc <= 4 then do:
     4760       return .
     4761     end.
     4762     DO varmvibr-cdocs = 1 TO EXTENT(cur-clmn-numbr-cdocs):
     4763       if cur-clmn-numbr-cdocs[varmvibr-cdocs] = cur-clmn-loc THEN move-elementbr-cdocs = varmvibr-cdocs.
     4764     END.
     4765     RUN re-move-clmnbr-cdocs (cur-clmn-loc, 4).
     4766   END PROCEDURE.
     4767   PROCEDURE mv-brw-defaultbr-cdocs:
     4768   def var old-session as logical no-undo.
     4769     old-session = SESSION:IMMEDIATE-DISPLAY.
     4770     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4771     do varmvlbr-cdocs = 4 to EXTENT(cur-clmn-numbr-cdocs):
     4772       RUN re-move-clmnbr-cdocs (cur-clmn-numbr-cdocs[varmvlbr-cdocs], varmvlbr-cdocs).
     4773     END.
     4774     RUN start-mv-clmnbr-cdocs.
     4775     SESSION:IMMEDIATE-DISPLAY = old-session.
     4776   END PROCEDURE.
     4777   .
     4778     hide mark-num  b-lkp b-pfo  B-Export B-trn in frame Dialog-Frame .
     4779     if pardoc-rec <> ? then
     4780        reposition br-cdocs to recid doc-rec no-error.
     4781     apply "VALUE-CHANGED" to br-cdocs in frame Dialog-Frame.
     4782     WAIT-FOR GO OF FRAME Dialog-Frame focus br-cdocs.
     4783   END.
     4784   Run Disable_Ui In This-procedure .
     4785   PROCEDURE add-proc :
     4786   define variable v-doc-rec as recid no-undo .
     4787   if  p-doc-type = ?   then do:
     4788     message  "Добавление финанcовых обязательcтв возможно только  по типам !" view-as alert-box information .
     4789     return .
     4790   end.
     4791   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4792   do:
     4793     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4794       (input  v-cntxt-db-num
     4795       ,input  v-cntxt-userid
     4796       ,input  0
     4797       ,input  'actn_fin-liability_add-def':U
     4798       ,input  'firm':U
     4799       ,input  par-host-code
     4800       ,input  '':U
     4801       ,input  0
     4802       ,input  0
     4803       ,input  0
     4804       ,input  0
     4805       ,input  true
     4806       ,output g-log
     4807       )  .
     4808   end.
     4809   if not g-log then  return .
     4810   define variable rr as recid no-undo .
     4811     run str/fi-liabi.w ( parParentProc, 'ДОБАВЛЕНИЕ':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
     4812     v-doc-rec = rr .
     4813     run openbr in this-procedure (yes, no, '':u).
     4814     reposition br-cdocs to recid v-doc-rec no-error .
     4815     apply "VALUE-CHANGED" TO br-cdocs IN FRAME Dialog-Frame.
     4816   END PROCEDURE.
     4817   PROCEDURE disable_UI :
     4818     HIDE FRAME Dialog-Frame.
     4819   END PROCEDURE.
     4820   PROCEDURE enable_UI :
     4821     DISPLAY R-1 R-2 v-date-doc-1 v-date-pay-1 R-3 v-date-doc-2 v-date-pay-2
     4822             sch-code p-desc p-date T-paket mark-num FILL-IN-20 FILL-IN-21
     4823             FILL-IN-22 FILL-IN-24 FILL-IN-26 s-name FILL-IN-1 loc_receiver-name
     4824             loc_sum-doc d-abbr loc_user-name loc_payer-name loc_sum-rubl r-abbr
     4825             loc_sum-base v-abbr loc_sum-contr v-abbr-contr
     4826         WITH FRAME Dialog-Frame.
     4827     ENABLE B-exit B-mark B-sel B-lkp B-History B-sch B-print B-Export B-PFO B-trn
     4828            B-parts B-Help RECT-1 R-1 R-2 v-date-doc-1 v-date-pay-1 R-3
     4829            v-date-doc-2 v-date-pay-2 B-reopen-br sch-code p-desc p-date br-cdocs
     4830            T-paket mark-num FILL-IN-20 FILL-IN-21 FILL-IN-22 FILL-IN-24
     4831            FILL-IN-26 s-name FILL-IN-1 loc_receiver-name loc_sum-doc d-abbr
     4832            loc_user-name loc_payer-name loc_sum-rubl r-abbr loc_sum-base v-abbr
     4833            loc_sum-contr v-abbr-contr
     4834         WITH FRAME Dialog-Frame.
     4835     VIEW FRAME Dialog-Frame.
     4836     OPEN QUERY br-cdocs FOR EACH buf_fin-liab  NO-LOCK ,        FIRST xx-contract .
     4837   END PROCEDURE.
     4838   PROCEDURE my-enable_UI :
     4839   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4841     (input  par-host-code
     4842     ,output p-base-code
     4843     )  .
     4844   assign
     4845   loc_sum-rubl:label in frame Dialog-Frame = "Сумма руб."
     4846   .
     4847   DISPLAY sch-code p-desc   p-date mark-num FILL-IN-1 FILL-IN-20 FILL-IN-21 FILL-IN-22 FILL-IN-24
     4848        FILL-IN-26
     4849         WITH FRAME Dialog-Frame.
     4850     ENABLE B-exit
     4851            B-lkp
     4852            B-Export
     4853            B-PFO
     4854            B-History
     4855            b-trn
     4856            b-parts
     4857            B-sch
     4858            B-print
     4859            B-Help
     4860            b-sel       when LOOKUP("b-sel":U,  bttns) > 0
     4861            b-mark      when LOOKUP("b-mark":U, bttns) > 0
     4862            br-cdocs sch-code p-desc p-date  mark-num
     4863            T-paket
     4864         B-reopen-br R-1 R-2 r-3  v-date-doc-1 v-date-doc-2 v-date-pay-1 v-date-pay-2
     4865         WITH FRAME Dialog-Frame.
     4866     VIEW FRAME Dialog-Frame.
     4867   END PROCEDURE.
     4868   PROCEDURE OpenBr :
     4869   define input  parameter p-open-query     as logical   no-undo .
     4870   define input  parameter p-find-next      as logical   no-undo .
     4871   define input  parameter p-find-condition as character no-undo .
     4872   define variable l-query-was-opened as logical no-undo .
     4873   define variable title0 as character no-undo.
     4874   define buffer buff_contract for contract.
     4875   define variable loc_contract-code as character no-undo .
     4876   title0 = caps(p-file-label) + chr(32).
     4877   define variable sort-column-phrase as character no-undo .
     4878   case sort-column-name :
     4879     when "" then do:
     4880       assign
     4881         sort-column-phrase = ""
     4882       .
     4883     end.
     4884     otherwise do:
     4885       assign
     4886         sort-column-phrase = "by " + sort-column-name
     4887       .
     4888     end.
     4889   end case.
     4890   define variable l-open-query as logical   no-undo .
     4891          find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     4892          if not available buf_clients then return .
     4893          filter-point = filter-point0 + par-mode.
     4894          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + " код: " +  string(par-host-code).
     4895   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4896   define variable  l-disable-where-36  as logical   no-undo .
     4897   define variable  l-filter-open-36    as logical   .
     4898   define variable  flt-rec-36       as recid     no-undo .
     4899   define variable  filter-name-36      as character no-undo .
     4900   define variable  where-phrase-36     as character no-undo .
     4901   define variable  sort-phrase-36      as character no-undo .
     4902   define variable  where-phrase-rus-36 as character no-undo .
     4903   define variable  sort-phrase-rus-36  as character no-undo .
     4904     run waitfram-show in this-procedure
     4905       (input "ЖДИТЕ ..."
     4906       ).
     4907   run gbl/flt-get.p
     4908     (input filter-point
     4909     ,output flt-rec-36
     4910     ,output filter-name-36
     4911     ,output where-phrase-36
     4912     ,output sort-phrase-36
     4913     ,output where-phrase-rus-36
     4914     ,output sort-phrase-rus-36
     4915     ).
     4916   if p-open-query then do:
     4917       run set-filter-name in this-procedure
     4918         (INPUT filter-name-36
     4919         ) no-error .
     4920     assign
     4921       l-filter-open-36 = false
     4922     .
     4923     if flt-rec-36 <> ?
     4924       or sort-column-phrase > ""
     4925     then do:
     4926       define variable  parameter-2-36 as character no-undo .
     4927       define variable  parameter-3-36 as character no-undo .
     4928       define variable  parameter-4-36 as character no-undo .
     4929       define variable  parameter-5-36 as character no-undo .
     4930       define variable  parameter-6-36 as character no-undo .
     4931       define variable  parameter-7-36 as character no-undo .
     4932         assign
     4933         parameter-3-36 =
     4934                                 "FOR EACH buf_fin-liab"
     4935         parameter-4-36 =
     4936           (
     4937             if (" buf_fin-liab.is-doc-del = true and buf_fin-liab.host-code = par-host-code and   ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))      " + " " + where-phrase-36) <> ""
     4938             then           substitute('           buf_fin-liab.host-code = &2  and           buf_fin-liab.is-doc-del = true and          ( &3 = 1 or ( buf_fin-liab.receiver-code = &4 and buf_fin-liab.receiver-type = &1&5&1 )) and          ( &6 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &7 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ' , chr(34) , par-host-code , r-1 , hard-flt-cli-code , hard-flt-cli-type , r-31 ,r-32) +          substitute('           ( &2 = 1  or ( &3 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &4 )) and          ( &5 = 1  or ( &6 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &7 ))           ' , chr(34) , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1 , v-date-pay-2 )           + " " + where-phrase-36
     4939             else "true"
     4940           )
     4941         parameter-5-36 = (" " + "" + " " + substitute(' , FIRST xx-contract where (  &1 = 1  or (  xx-contract.contract-code = buf_fin-liab.contract-code )) ' , r-2 ))
     4942         parameter-6-36 = if sort-phrase-36 = ''
     4943                              then
     4944           (
     4945           " " + " " +
