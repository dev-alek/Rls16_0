     1944   ON VALUE-CHANGED OF R-1 IN FRAME Dialog-Frame
     1945   DO:
     1946          hard-flt-cli-code = ?.
     1947          hard-flt-cli-type = ?.
     1948          s-name = "" .
     1949     assign r-1 .
     1950     if r-1 = 1 then
     1951        hide s-name in frame Dialog-Frame .
     1952     else do :
     1953     def buffer b#clients for clients.
     1954      run ref/cli-all.w ( parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     1955      find first b#clients where recid(b#clients) = integer(rid-list) no-lock no-error.
     1956      if available  b#clients then do:
     1957          hard-flt-cli-code = b#clients.obj-code.
     1958          hard-flt-cli-type = b#clients.obj-type.
     1959          s-name = b#clients.obj-name.
     1960      end.
     1961      else do:
     1962        r-1 = 1 .
     1963      end.
     1964      display  r-1 s-name with frame Dialog-Frame .
     1965     end.
     1966   END.
     1967   ON VALUE-CHANGED OF R-2 IN FRAME Dialog-Frame
     1968   DO:
     1969   define buffer buf_contract for ub.contract  .
     1970   define variable ii as integer   no-undo .
     1971   define variable v-tt as character no-undo .
     1972   define variable p-rid-list as character no-undo .
     1973   define variable v-cli-type as character no-undo .
     1974   define variable v-cli-code as integer   no-undo .
     1975   assign r-2 .
     1976   for each x-contract : delete x-contract . end.
     1977     if r-2 = 1 then do:
     1978        hide s-tt in frame Dialog-Frame .
     1979         FIND FIRST buf_contract no-lock  no-error .
     1980         if available buf_contract then do:
     1981                 CREATE x-contract.
     1982                 BUFFER-COPY buf_contract TO x-contract  .
     1983         end.
     1984         else  do:
     1985           CREATE x-contract.
     1986           assign
     1987             x-contract.contract-code = 1
     1988             x-contract.host-code = 1
     1989           .
     1990         end.
     1991     end.
     1992     else do:
     1993         if r-1 = 2 then do:
     1994           assign
     1995             v-cli-type = hard-flt-cli-type
     1996             v-cli-code = hard-flt-cli-code
     1997           .
     1998         end.
     1999         else do:
     2000           assign
     2001             v-cli-type = ?
     2002             v-cli-code = ?
     2003             .
     2004         end.
     2005         run str/cont-all.w (
     2006             input   parParentProc   ,
     2007             input   par-host-code   ,
     2008             input   "b-sel,b-mark"  ,
     2009             input   'фирма':U      ,
     2010             input   v-cli-type               ,
     2011             input   v-cli-code               ,
     2012             input   ?               ,
     2013             input   ?               ,
     2014             input   "current"       ,
     2015             input   "all"           ,
     2016             input-output p-rid-list )
     2017             .
     2018             if p-rid-list = "" then do:
     2019               CREATE x-contract.
     2020               assign
     2021                 x-contract.contract-code = 1
     2022                 x-contract.host-code = 1
     2023               .
     2024               r-2 = 1.
     2025             end.
     2026             v-tt =  "".
     2027             v-nn = num-entries (p-rid-list) .
     2028             repeat ii = 1 to v-nn :
     2029               find first buf_contract no-lock where recid(buf_contract) =  integer( entry(ii, p-rid-list)) no-error .
     2030               if available buf_contract then do:
     2031                     CREATE x-contract.
     2032                     BUFFER-COPY buf_contract TO x-contract  .
     2033                     v-tt = v-tt + buf_contract.contract-prn-code + "(" + string (buf_contract.contract-code) + "),".
     2034               end.
     2035             end.
     2036           s-tt:LIST-ITEMS  = trim (v-tt, ",") .
     2037           display s-tt r-2 with frame Dialog-Frame .
     2038           enable s-tt with frame Dialog-Frame .
     2039     end.
     2040   END.
     2041   ON VALUE-CHANGED OF R-3 IN FRAME Dialog-Frame
     2042   DO:
     2043     ASSIGN r-3 .
     2044   END.
     2045   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2046   DO:
     2047     run proc-find-code in this-procedure(no, input frame Dialog-Frame sch-code) no-error.
     2048     return no-apply.
     2049   END.
     2050   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2051   DO:
     2052     run proc-find-code in this-procedure(yes, input frame Dialog-Frame sch-code) no-error.
     2053     if error-status:error then return no-apply.
     2054   END.
     2055   ON VALUE-CHANGED OF T-paket IN FRAME Dialog-Frame
     2056   DO:
     2057     assign T-paket.
     2058     rid-list = "" .
     2059     g-log = br-cdocs:SELECT-ROW(1) no-error  .
     2060     if error-status :get-message(1) = "" then
     2061        g-log = br-cdocs:refresh()  .
     2062     IF t-paket= TRUE THEN DO:
     2063         ENABLE
     2064                B-lkp when LOOKUP("b-lkp":U,  bttns) > 0
     2065                B-mark
     2066                with frame Dialog-Frame .
     2067         disable
     2068            B-sel     when LOOKUP("b-sel":U,  bttns) > 0
     2069            B-History
     2070            B-parts
     2071            B-PFO
     2072            B-print
     2073            B-trn
     2074         with frame Dialog-Frame .
     2075     END.
     2076     ELSE DO:
     2077         disable
     2078                B-mark when LOOKUP("b-mark":U,  bttns) = 0
     2079                with frame Dialog-Frame .
     2080         enable
     2081            B-sel     when LOOKUP("b-sel":U,  bttns) > 0
     2082            B-History
     2083            B-parts
     2084            B-PFO
     2085            B-print
     2086            B-trn
     2087         with frame Dialog-Frame .
     2088     END.
     2089   END.
