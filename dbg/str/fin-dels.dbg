      388   procedure fltfield-clear :
      389     define output parameter loc-fld as character no-undo.
      390     define output parameter loc-lab as character no-undo .
      391     define output parameter loc-spr as character no-undo .
      392     define output parameter loc-dim as character no-undo .
      393     assign
      394       loc-fld = ""
      395       loc-lab = ""
      396       loc-spr = ""
      397       loc-dim = "0"
      398     .
      399   end procedure .
      400   procedure fltfield-add :
      401     define input        parameter par-fld as character no-undo.
      402     define input        parameter par-lab as character no-undo .
      403     define input        parameter par-spr as character no-undo .
      404     define input-output parameter loc-fld as character no-undo.
      405     define input-output parameter loc-lab as character no-undo .
      406     define input-output parameter loc-spr as character no-undo .
      407     define input-output parameter loc-dim as character no-undo .
      408     do
      409     on error undo, return error
      410     :
      411       assign
      412       loc-fld = if loc-dim = '0'
      413                 then par-fld
      414                 else (loc-fld + chr(44) + par-fld)
      415       loc-lab = if loc-dim = '0'
      416                 then par-lab
      417                 else (loc-lab + chr(44) + par-lab)
      418       loc-spr = if loc-dim = '0'
      419                 then par-spr
      420                 else (loc-spr + chr(44) + par-spr)
      421       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      422                 string(integer(if num-entries(loc-dim) > 1
      423                               then entry(2, loc-dim)
      424                               else entry(1, loc-dim)
      425                               ) + 1)
      426       no-error
      427       .
      428     end.
      429   end procedure.
      430   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   define  stream PrnLibStream.
      432   procedure prn-lib-prn-file :
      433     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      434     define input parameter p-DIsabledoptions as integer no-undo .
      435     define variable v-report-name as character no-undo .
      436     define variable v-user-action as character no-undo .
      437     define variable v-printed     as logical   no-undo .
      438     define variable v-exist       as logical   no-undo .
      439     do
      440       on error undo, return error
      441       :
      442       run prn-lib-get-report-name  in this-procedure (
      443         input parParentProc
      444         ,output v-report-name
      445         ).
      446   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      448     (input  v-report-name
      449     ,input  2
      450     ,output v-exist
      451     )  .
      452       if NOT v-exist then
      453       DO:
      454         Message
      455           "Нет заданий на печать ! "
      456           view-as alert-box .
      457         Return  .
      458       End.
      459       run gbl/prnfilen.w
      460         (input  ""
      461         ,input  p-DisabledOptions
      462         ,input  string(v-report-name )
      463         ,input  7
      464         ,output v-user-action
      465         ,output v-printed
      466         ) .
      467       if v-printed then
      468       do:
      469         return "YES" .
      470       end.
      471       else
      472       do:
      473         return "NO" .
      474       end.
      475     end.
      476   end procedure.
      477   procedure prn-lib-open-stream :
      478     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      479     define input parameter p-page-size    as integer no-undo .
      480     define input parameter p-is-stream    as logical no-undo .
      481     define input parameter p-append       as logical no-undo .
      482     define variable v-report-name as character no-undo .
      483     do
      484       on error undo, return error
      485       :
      486       run prn-lib-get-report-name  in this-procedure (
      487         input parParentProc
      488         ,output v-report-name
      489         ).
      490       if p-is-stream then
      491       do:
      492         if p-append then
      493         do:
      494           output stream PrnLibStream to value( v-report-name )
      495             page-size value(p-page-size) append .
      496         end.
      497         if not p-append then
      498         do:
      499           output stream PrnLibStream to value( v-report-name )
      500             page-size value(p-page-size) .
      501         end.
      502       end.
      503       if not p-is-stream then
      504       do:
      505         if p-append then
      506         do:
      507           output to value( v-report-name )
      508             page-size value(p-page-size) append .
      509         end.
      510         if not p-append then
      511         do:
      512           output to value( v-report-name )
      513             page-size value(p-page-size) .
      514         end.
      515       end.
      516     end.
      517   end procedure.
      518   procedure prn-lib-open-exp :
      519     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      520     define input parameter p-is-stream    as logical no-undo .
      521     define input parameter p-is-append    as logical no-undo .
      522     define output parameter p-ReportFileName as char init "report" no-undo.
      523     define output parameter p-process as logical no-undo .
      524     define variable glog as logical no-undo .
      525     do
      526       on error undo, return error
      527       :
      528       SYSTEM-DIALOG GET-FILE p-ReportFileName
      529         TITLE      "Укажите путь"
      530         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      531         ASK-OVERWRITE
      532         CREATE-TEST-FILE
      533         SAVE-AS
      534         USE-FILENAME
      535         DEFAULT-EXTENSION "txt"
      536         UPDATE glog
      537         .
      538       if not glog then  return.
      539       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      540       if p-is-stream then
      541       do:
      542         if p-is-append then
      543         do:
      544           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      545         end.
      546         else
      547         do:
      548           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      549         end.
      550       end.
      551       else
      552       do:
      553         if p-is-append then
      554         do:
      555           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      556         end.
      557         else
      558         do:
      559           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      560         end.
      561       end.
      562       p-process = yes.
      563     end.
      564   end procedure.
      565   procedure prn-lib-get-report-name :
      566     define input parameter parParentProc  as widget-handle no-undo.
      567     define output parameter p-report-name as character no-undo .
      568     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      569   end procedure.
      570   procedure prn-lib-reportviewer-report-name :
