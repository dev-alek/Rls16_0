     4959       on stop undo, leave
     4960       on error undo, leave
     4961       :
     4962         assign
     4963           l-disable-where-36 =
     4964             (" buf_fin-liab.is-doc-del = true and buf_fin-liab.host-code = par-host-code and   ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))      " + " " + where-phrase-36 = "")
     4965         .
     4966         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4967                             ,input query br-cdocs:handle
     4968                             ,input parameter-3-36
     4969                             ,input parameter-4-36
     4970                             ,input parameter-5-36
     4971                             ,input parameter-6-36
     4972                             ,input parameter-7-36
     4973                             )
     4974         .
     4975         assign
     4976           l-filter-open-36 = true
     4977         .
     4978       end.
     4979       if l-filter-open-36 = false then do:
     4980         message
     4981           "Ошибка при фильтрации / сортировке" skip
     4982           "Будут показаны записи без учета фильтра" skip
     4983           view-as alert-box .
     4984       end.
     4985       else do:
     4986           assign
     4987             l-query-was-opened = true
     4988           .
     4989       end.
     4990     end.
     4991     if l-filter-open-36 = false then do:
     4992       OPEN QUERY br-cdocs FOR EACH buf_fin-liab no-lock
     4993         where  buf_fin-liab.is-doc-del = true and buf_fin-liab.host-code = par-host-code and   ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))
     4994       , FIRST xx-contract where ( r-2 = 1  or ( buf_fin-liab.contract-code = xx-contract.contract-code ))
     4995     .
     4996         assign
     4997           l-query-was-opened = true
     4998         .
     4999     end.
     5000   end.
     5001   else do:
     5002     assign
     5003       doc-rec = recid( buf_fin-liab )
     5004     .
     5005     do
     5006     on stop undo, leave
     5007     on error undo, leave
     5008     :
     5009       if query br-cdocs:handle:get-buffer-handle(1) = (buffer buf_fin-liab:handle) then do:
     5010         assign
     5011         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     5012         parameter-4-36 =
     5013           "where ":u +           substitute('           buf_fin-liab.host-code = &2  and           buf_fin-liab.is-doc-del = true and          ( &3 = 1 or ( buf_fin-liab.receiver-code = &4 and buf_fin-liab.receiver-type = &1&5&1 )) and          ( &6 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &7 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ' , chr(34) , par-host-code , r-1 , hard-flt-cli-code , hard-flt-cli-type , r-31 ,r-32) +          substitute('           ( &2 = 1  or ( &3 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &4 )) and          ( &5 = 1  or ( &6 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &7 ))           ' , chr(34) , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1 , v-date-pay-2 )           + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     5014         parameter-5-36 = " "
     5015       .
     5016         run fltopend_fltfindd in this-procedure  (
     5017                             input this-procedure:handle
     5018                             ,input query br-cdocs:handle
     5019                             ,input rowid(buf_fin-liab)
     5020                             ,input logical(parameter-2-36)
     5021                             ,input no-lock
     5022                             ,input (buffer buf_fin-liab:handle)
     5023                             ,input parameter-4-36
     5024                             ,input parameter-5-36
     5025                             ) no-error.
     5026         .
     5027         assign
     5028           doc-rec = integer(return-value)
     5029           v-fltopend-rowid[1] = ?
     5030         .
     5031       end.
     5032       else do:
     5033         assign
     5034         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     5035         parameter-3-36 =  "FOR EACH buf_fin-liab"
     5036         parameter-4-36 =
     5037           (
     5038             if (" buf_fin-liab.is-doc-del = true and buf_fin-liab.host-code = par-host-code and   ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))      " + " " + where-phrase-36) <> ""
     5039             then           substitute('           buf_fin-liab.host-code = &2  and           buf_fin-liab.is-doc-del = true and          ( &3 = 1 or ( buf_fin-liab.receiver-code = &4 and buf_fin-liab.receiver-type = &1&5&1 )) and          ( &6 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &7 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ' , chr(34) , par-host-code , r-1 , hard-flt-cli-code , hard-flt-cli-type , r-31 ,r-32) +          substitute('           ( &2 = 1  or ( &3 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &4 )) and          ( &5 = 1  or ( &6 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &7 ))           ' , chr(34) , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1 , v-date-pay-2 )           + " " + where-phrase-36
     5040             else "true"
     5041           )
     5042         parameter-5-36 = (" " + "" + " " + substitute(' , FIRST xx-contract where (  &1 = 1  or (  xx-contract.contract-code = buf_fin-liab.contract-code )) ' , r-2 ) + " " + p-find-condition)
     5043         parameter-6-36 = if sort-phrase-36 = ''
     5044                              then
     5045           (
     5046           " " + " " +
     5047             " " + sort-column-phrase +
     5048           " " + " "
     5049           )
     5050                              else
     5051           (
     5052           " " + " " +
     5053             " " + sort-column-phrase +
     5054           " " + sort-phrase-36
     5055           )
     5056         parameter-7-36 =
     5057           "   "
     5058       .
     5059         run fltopend_fltfindq in this-procedure  (
     5060                             input this-procedure:handle
     5061                             ,input query br-cdocs:handle
     5062                             ,input logical(parameter-2-36)
     5063                             ,input no-lock
     5064                             ,input parameter-3-36
     5065                             ,input parameter-4-36
