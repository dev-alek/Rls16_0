     1612        FILL-IN-20 AT ROW 3.13 COL 1.25 NO-LABEL
     1613        FILL-IN-21 AT ROW 3.13 COL 13.5 NO-LABEL
     1614        FILL-IN-22 AT ROW 3.13 COL 44.5 NO-LABEL
     1615        FILL-IN-24 AT ROW 3.13 COL 58.75 NO-LABEL
     1616        FILL-IN-26 AT ROW 3.13 COL 72 NO-LABEL
     1617        s-name AT ROW 5.25 COL 1.5 NO-LABEL
     1618        FILL-IN-1 AT ROW 6.75 COL 1.5 NO-LABEL
     1619        loc_receiver-name AT ROW 20.25 COL 1.5
     1620        loc_sum-doc AT ROW 20.25 COL 44.5 COLON-ALIGNED
     1621        d-abbr AT ROW 20.25 COL 62.88 COLON-ALIGNED NO-LABEL
     1622        loc_user-name AT ROW 20.25 COL 79.13 COLON-ALIGNED
     1623        loc_payer-name AT ROW 21.08 COL 1.5
     1624        loc_sum-rubl AT ROW 21.08 COL 44.5 COLON-ALIGNED
     1625        r-abbr AT ROW 21.08 COL 62.88 COLON-ALIGNED NO-LABEL
     1626        loc_sum-base AT ROW 21.92 COL 44.5 COLON-ALIGNED
     1627        v-abbr AT ROW 21.92 COL 62.88 COLON-ALIGNED NO-LABEL
     1628        loc_sum-contr AT ROW 22.71 COL 44.5 COLON-ALIGNED
     1629        v-abbr-contr AT ROW 22.71 COL 62.88 COLON-ALIGNED NO-LABEL
     1630        RECT-1 AT ROW 3 COL 1
     1631        SPACE(1.63) SKIP(17.08)
     1632       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1633            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1634            TITLE "Удаленные Финанcовые обязательcтва"
     1635            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
     1636   ASSIGN
     1637          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1638          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1639   ASSIGN
     1640          br-cdocs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1641   ASSIGN
     1642          mark-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1643   ASSIGN
     1644          S-tt:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1645   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1646   DO:
     1647     APPLY "END-ERROR":U TO SELF.
     1648   END.
     1649   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1650   DO:
     1651     define variable cur-clmn-loc as integer   no-undo .
     1652   define variable column-handle as handle no-undo .
     1653   define variable v-list as character no-undo .
     1654     assign
     1655       cur-clmn-loc  = 1
     1656       column-handle = br-cdocs:first-column
     1657       v-list        = column-handle:label + "#"
     1658     .
     1659     do while valid-handle(column-handle) :
     1660       if cur-clmn-loc = br-cdocs:num-columns then do:
     1661         leave .
     1662       end.
     1663       assign
     1664         column-handle = column-handle:NEXT-COLUMN
     1665         cur-clmn-loc  = cur-clmn-loc + 1
     1666         v-list        = v-list + column-handle:label + "#"
     1667       .
     1668     end.
     1669      v-list = trim(v-list, "#") .
     1670      define variable v-i as integer   no-undo .
     1671      define variable v-pos as integer   no-undo .
     1672      define variable v-list-new as character no-undo .
     1673      define variable v-elem as character no-undo .
     1674      repeat v-i = 1 to br-cdocs:num-columns :
     1675         v-elem = entry( v-i, v-list , "#") .
     1676         v-pos = lookup( v-elem, '*' + '#' +  'Статуc' + '#' +  '№ док-та' + '#' +  'Создан' + '#' +  'Удален' + '#' +  'Договор' + '#' +  'Получатель' + '#' +  'Плательщик' + '#' +  'Платеж' + '#' +  'Вал' + '#' +  'Сумма в валюте док-та' + '#' +  'Внутр.№' + '#' +  'Тип' + '#' +  'Непогаш.задолж.(руб.)' + '#' +  'Объект' + '#' +  'Наименование' + '#' +  'Уcловие генерации' , "#") .
     1677         v-list-new = v-list-new + string(v-pos) + "," .
     1678      end.
     1679      define variable v-list-str as character no-undo .
     1680      v-nn = num-entries(v-list-new) .
     1681      v-list-str = "" .
     1682      repeat v-i = 1 to  v-nn:
     1683         v-elem = entry(v-i , v-list-new ) .
     1684         if int(v-elem) > 3 then
     1685         v-list-str  = v-list-str + v-elem + "," .
     1686      end.
     1687      v-list-new = trim(v-list-str ,",")  +  chr(4)
     1688                 + string(decimal( buf_fin-liab.receiver-name:width in browse br-cdocs)) +  chr(4)
     1689                 + string(decimal( buf_fin-liab.sum-doc:width     in browse br-cdocs)) +  chr(4)
     1690                 + string(decimal( buf_fin-liab.status_:width     in browse br-cdocs)) +  chr(4)  .
     1691   run uf-set in this-procedure (
     1692       input  'cfin-ob-p':U
     1693       ,input v-cntxt-userid
     1694       ,input v-list-new
     1695       ,input v-uf-Naim
     1696       ,input v-uf-print-graft
     1697       ,input v-uf-sort-gr
     1698       ,input v-uf-type-price
     1699       ,input v-uf-type-val
     1700   ) no-error    .
     1701       if error-status :error then
     1702       message
     1703         vss-workfile vss-revision vss-description skip
     1704         error-status :get-message(1) skip
     1705         return-value skip
     1706         "uf-set"
     1707         view-as alert-box error
     1708       .
     1709   END.
     1710   ON CHOOSE OF B-Export IN FRAME Dialog-Frame
     1711   DO:
     1712   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   do:
     1714     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1715       (input  v-cntxt-db-num
     1716       ,input  v-cntxt-userid
     1717       ,input  0
     1718       ,input  'actn_fin-liability_export':U
     1719       ,input  'firm':U
     1720       ,input  par-host-code
     1721       ,input  '':U
     1722       ,input  0
     1723       ,input  0
     1724       ,input  0
     1725       ,input  0
     1726       ,input  true
     1727       ,output g-log
     1728       )  .
     1729   end.
     1730     if not g-log then  return .
     1731     run proc-b-exp in this-procedure no-error.
     1732     if error-status:error then return no-apply.
     1733   END.
     1734   ON CHOOSE OF B-History IN FRAME Dialog-Frame
     1735   DO:
     1736   if available buf_fin-liab then do:
     1737          run str/fincliab.w
     1738            (input  parparentproc          ,
     1739             input  ""                      ,
     1740             input  'фирма':U                  ,
     1741             input  par-host-code           ,
     1742             input  buf_fin-liab.doc-code   ,
     1743             output rid-list       ).
     1744       end.
     1745   END.
     1746   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1747   DO:
     1748   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1749   do:
     1750     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1751       (input  v-cntxt-db-num
     1752       ,input  v-cntxt-userid
     1753       ,input  0
     1754       ,input  'actn_fin-liability_lookup':U
     1755       ,input  'firm':U
     1756       ,input  par-host-code
     1757       ,input  '':U
     1758       ,input  0
     1759       ,input  0
     1760       ,input  0
     1761       ,input  0
     1762       ,input  true
     1763       ,output g-log
     1764       )  .
     1765   end.
     1766   if not g-log then  return .
     1767   define variable rr as recid no-undo .
     1768       if available buf_fin-liab then do:
     1769           rr = recid( buf_fin-liab ).
     1770           p-doc-type = buf_fin-liab.doc-type .
     1771           p-status_  = buf_fin-liab.status_  .
     1772         br-handle = br-cdocs:handle in frame Dialog-Frame .
     1773         next-prev = no.
     1774         do while next-prev <> ?:
     1775           if not available buf_fin-liab then do:
     1776             message "Неправильный выбор документа.".
     1777             return no-apply.
     1778           end.
     1779           run str/fi-liabi.w ( parParentProc, 'ПРОСМОТР':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
     1780           if br-handle = ? then reposition br-cdocs to recid rr no-error.
     1781         end.
     1782        end.
     1783   END.
     1784   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1785   DO:
     1786         if available buf_fin-liab then do:
     1787   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1788   define variable v-str-recid15 as character no-undo .
     1789   define variable v-num-entry15 as integer   no-undo .
     1790   assign
     1791     v-str-recid15 = trim( string( recid( buf_fin-liab ) , "->>>>>>>>>>>9":U ) )
     1792     v-num-entry15 = lookup( v-str-recid15 , rid-list )
     1793   .
     1794   if v-num-entry15 > 0 then do:
     1795     assign
     1796       entry( v-num-entry15, rid-list ) = "":U
     1797       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1798     .
     1799   end.
     1800   else do:
     1801     assign
     1802       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1803     .
     1804   end.
     1805           g-log = br-cdocs:refresh() .
     1806           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1807               g-log = br-cdocs:select-next-row ().
     1808               apply "VALUE-CHANGED" to br-cdocs in frame Dialog-Frame.
     1809           end.
     1810           if num-entries( rid-list ) = 0
     1811           then
     1812               hide mark-num in frame Dialog-Frame.
     1813           else do:
     1814               end.
     1815       end.
     1816       apply "entry" to br-cdocs in frame Dialog-Frame.
     1817   END.
     1818   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1819   DO:
     1820       if not available buf_fin-liab then return .
     1821       run str/ficparts.w
     1822         ( input parParentProc ,
     1823           input buf_fin-liab.doc-code ,
     1824           input par-host-code  ) .
     1825   END.
     1826   ON CHOOSE OF B-print IN FRAME Dialog-Frame
