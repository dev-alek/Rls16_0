      575   procedure prn-lib-reportviewer :
      576     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      577     define input parameter p-report-name-html as character no-undo .
      578     define input parameter p-param        as character no-undo .
      579     define variable v-excel           as character no-undo init 'TRUE' .
      580     define variable v-value-character as character no-undo .
      581     define variable v-value-integer   as character no-undo .
      582     define variable v-value-date      as date      no-undo .
      583     define variable v-value-decimal   as decimal   no-undo .
      584     define variable rep-excel         as logical   no-undo .
      585     define variable excel-string      as character no-undo .
      586     define variable v-param-type      as character no-undo .
      587     define variable v-tth             as handle    no-undo .
      588     run adm/shattri.p (
      589       input "get":U
      590       ,input  ""
      591       ,input  0
      592       ,input  'report-glob':U
      593       ,input  'rep-excel':U
      594       ,output v-value-character
      595       ,output v-value-date
      596       ,output v-value-decimal
      597       ,output v-value-integer
      598       ,output rep-excel
      599       ,output v-param-type
      600       ,INPUT-OUTPUT table-handle v-tth
      601       )  .
      602     if rep-excel then v-excel = "TRUE" .
      603     else v-excel = "FALSE" .
      604     if p-param eq ""
      605     then
      606        p-param = "EXCEL:" + v-excel.
      607     else
      608        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      609     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      610   end procedure.
      611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   define variable v-waitfram-action01         as character   no-undo .
      613   define variable v-waitfram-action02         as character   no-undo .
      614   define variable v-waitfram-action03         as character   no-undo .
      615   define variable mWaitFramTextBeg            as character   no-undo.
      616   define variable mWaitFramTextEnd            as character   no-undo.
      617   define variable mWaitFramView               as logical     no-undo.
      618   define variable mWaitProcEvent              as logical     no-undo init yes.
      619   define variable mWaitFramInterval           as integer     no-undo init 1 .
      620   define variable mWaitFramStop               as logical     no-undo.
      621   define variable mWaitFramStopUser           as logical     no-undo.
      622   define variable mWaitFramStopTimeOut        as logical     no-undo.
      623   define variable mWaitFramStartProc          as datetime-tz no-undo.
      624   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      625   define button B-WaitFramStop auto-end-key
      626        label "Стоп"
      627        size 10 by 1 tooltip "Остоновить процесс".
      628   define button B-viewProcInfo
      629        label "Информация"
      630        size 15 by 1 tooltip "Информация о процесс".
      631   define frame waitfram
      632     v-waitfram-action01 format "x(72)" no-label skip
      633     v-waitfram-action02 format "x(72)" no-label skip
      634     v-waitfram-action03 format "x(72)" no-label skip
      635     B-viewProcInfo
      636     B-WaitFramStop at row 4 col 30
      637     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      638     .
      639   define new global shared variable mBatchMode as logical no-undo init ?.
      640   define variable mFramBachModHandle as handle no-undo.
      641   mFramBachModHandle = frame waitfram:handle.
      642   define variable mFameOldVis as logical no-undo.
      643   define variable mVisCUrentVin as logical no-undo.
      644   if session:batch-mode
      645   then
      646      mBatchMode = yes.
      647   if mBatchMode = ? then do:
      648     mVisCUrentVin = current-window:visible.
      649     mFameOldVis = mFramBachModHandle:visible.
      650     mFramBachModHandle:visible  = yes.
      651     mBatchMode = mFramBachModHandle:visible ne yes.
      652     mFramBachModHandle:visible = mFameOldVis.
      653     current-window:visible = mVisCUrentVin.
      654   end.
      655    if  log-manager:logfile-name ne ?
      656     then DO:
      657         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      658         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      659         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      660     end.
      661   on choose of B-WaitFramStop in frame waitfram
      662   do:
      663     mWaitFramStop = yes.
      664     mWaitFramStopUser = yes.
      665   end.
      666   function waitfram-check-timeout returns logical():
      667      define variable vtime as int64 no-undo.
      668      if mWaitFramStopTimeOut
      669      then
      670         return yes.
      671      vtime = ( now - mWaitFramStartProc ) / 1000 .
      672      if     mWaitFramTimeOut ne ?
      673         and mWaitFramTimeOut ne 0
      674         and mWaitFramTimeOut lt vtime
      675      then do:
      676         mWaitFramStopTimeOut = yes.
      677      end.
      678      return mWaitFramStopTimeOut.
      679   end.
      680   procedure waitfram-hide :
      681     if not session:batch-mode
      682     then do
      683     on error undo, return error return-value
      684     :
      685       pause 0 before-hide .
      686       if not mBatchMode then
      687         hide frame waitfram .
      688     if     not mWaitFramView
      689        and mWaitProcEvent
      690     then
      691       process events .
      692     end.
      693   end procedure.
      694   procedure waitfram-show :
      695     define input  parameter p-message as character no-undo .
      696     define variable v-left-margin as integer   no-undo .
      697     if not session:batch-mode
      698     then do
      699     on error undo, return error return-value
      700     :
      701       if length(p-message) <= 70 then do:
      702         assign
      703           v-left-margin = integer((70 - length(p-message)) / 2)
      704         .
      705         assign
      706           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      707         .
      708         assign
      709           v-waitfram-action01 = " "
      710           v-waitfram-action02 = " "
      711                                    + fill(" ", v-left-margin)
      712                                    + p-message
      713           v-waitfram-action03 = " "
      714         .
      715       end.
      716       else do:
      717         define variable vRindex1 as integer no-undo.
      718         define variable vRindex2 as integer no-undo.
      719         vRindex1 = r-index(p-message," ",70).
      720         if vRindex1 = 0
      721         then
      722            vRindex1 = 70.
      723         if length(p-message)  <= vRindex1 + 70 then do:
      724           assign
      725             v-waitfram-action01 = " "
      726             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      727             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      728           .
      729         end.
      730         else do:
      731           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      732           if vRindex2 <= vRindex1
      733           then
      734              vRindex2 = vRindex1 + 70.
      735           assign
      736             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      737             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      738             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      739           .
      740         end.
      741       end.
      742       B-viewProcInfo:visible   in frame waitfram = no.
      743       B-viewProcInfo:sensitive in frame waitfram = no.
      744       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      745       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      746       if  (   mWaitFramView
      747          or  mWaitProcEvent)
      748          and not mBatchMode
      749       then
      750          display
      751             v-waitfram-action01 skip
      752             v-waitfram-action02 skip
      753             v-waitfram-action03 skip
      754          with frame waitfram .
      755       if     mWaitFramView
      756          then do:
      757             if     mWaitFramInterval ne ?
      758                and not mBatchMode
      759             then
      760                wait-for go of frame waitfram pause mWaitFramInterval.
      761          end.
      762          else
      763             if     mWaitProcEvent
      764                and not mBatchMode
      765             then
      766                process events .
      767     end.
      768   end procedure.
      769      procedure waitfram-show-this:
      770         define input  parameter iInterval as int64 no-undo.
      771         define variable vtime as int64 no-undo.
      772         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      773         mWaitFramInterval = iInterval.
      774         run waitfram-show (substitute("&1&2 &3&4" ,
      775                                       mWaitFramTextBeg ,
      776                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      777                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      778                                       mWaitFramTextEnd
      779                                      )
      780                           ).
      781      end.
      782      procedure WaitFramRunPause:
      783         define input  parameter iInterval as dec no-undo.
      784         define variable vStart  as datetime-tz no-undo.
      785         define variable vend    as datetime-tz no-undo.
      786         define variable vint as int64 no-undo.
      787         define variable vOk as logical no-undo.
      788         vStart = now.
      789         vend   = vStart.
      790         publish "WaitFramPause" (iInterval,output vOk).
      791         vend   =  now.
      792         vint = vend - vStart.
      793         vint = iInterval - vint / 1000.
      794         if     not mWaitFramStop
      795            and (   vint > 0
      796                 or (    not vOk
      797                     and iInterval eq ?
      798                     )
      799                 )
      800         then
      801            run waitfram-show-this (iInterval).
      802         vend   =  now.
      803         vint = vend - vStart.
      804         vint = iInterval - vint / 1000.
      805         if     not mWaitFramStop
      806            and vint > 0
      807         then do:
      808            run gbl/pause.p (vint * 1000).
      809         end.
      810         if iInterval ne ?
      811         then
      812            publish "WaitFramStop".
      813         waitfram-check-timeout().
      814      end.
      815      procedure WaitFramWaitFor:
      816         define input  parameter iInterval as dec no-undo.
      817         assign
      818            mWaitFramStartProc   = now
      819            mWaitFramStopUser    = no
      820            mWaitFramStopTimeOut = no
      821         .
      822         block-wait:
      823         do while not mWaitFramStop:
      824            run WaitFramRunPause (iInterval).
      825            if  waitfram-check-timeout()
      826            then do:
      827               leave block-wait.
      828            end.
      829         end.
      830         run waitfram-hide.
      831      end.
      832   procedure waitfram-join :
      833     define input  parameter p-line-1  as character no-undo .
      834     define input  parameter p-line-2  as character no-undo .
      835     define input  parameter p-line-3  as character no-undo .
      836     define output parameter p-message as character no-undo .
      837     do
      838     on error undo, return error return-value
      839     :
      840       assign
      841         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      842                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      843                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      844       .
      845     end.
      846   end procedure.
      847   function waitfram-join-function returns character
      848     (input p-line-1 as character
      849     ,input p-line-2 as character
      850     ,input p-line-3 as character
      851     ).
      852     define variable v-message as character no-undo .
      853     run waitfram-join in this-procedure
      854       (input  p-line-1
      855       ,input  p-line-2
      856       ,input  p-line-3
      857       ,output v-message
      858       ) .
      859     return v-message .
      860   end function .
      861   define new global shared variable g#libofarh as handle no-undo .
      862   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      864   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      865   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      866   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      867   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      868   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      869   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      870   procedure uf-name :
      871     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      872     define output parameter p-use-List_     as logical   no-undo .
      873     define output parameter p-type-List_     as character no-undo .
      874     define output parameter p-format-List_   as character no-undo .
      875     define output parameter p-use-Naim      as logical   no-undo .
      876     define output parameter p-type-Naim      as character no-undo .
      877     define output parameter p-format-Naim    as character no-undo .
      878     define output parameter p-use-print-graft as logical   no-undo .
      879     define output parameter p-use-sort-gr   as logical   no-undo .
      880     define output parameter p-use-type-price as logical   no-undo .
      881     define output parameter p-use-type-val  as logical   no-undo .
      882     define output parameter p-label          as character no-undo .
      883     define output parameter p-tooltip        as character no-undo .
      884     define output parameter p-user-can-edit  as logical   no-undo .
      885     define output parameter p-output-display as logical   no-undo .
      886     define output parameter p-other          as character no-undo .
      887     do
      888     on error undo, return error
      889     :
      890       case p-code :
      891               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      892               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      893               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      894               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      895               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      896               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      897               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      898               when 'findocs-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника платежей"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника платежей"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      899               when 'fin-obi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      900               when 'seqeallo':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Порядок колонок в АВТО-ЗАКАЗЕ"     p-tooltip = "Порядок колонок в РАСЧЕТЕ потребности заказа и его импорте"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      901               when 'skm-rep':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова выгрузки файла данных по продажам по СКМ"     p-tooltip = "Параметры по умолчанию, используемые для вызова выгрузки файла данных по продажам по СКМ"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      902               when 'imp-goods':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Импорт в карточке товара"     p-tooltip = "Заполнение по умолчанию параметров импорта товаров из карточки товара"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      903               when 'discards-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Справочник ДК"     p-tooltip = "Справочник дисконтных карт"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
