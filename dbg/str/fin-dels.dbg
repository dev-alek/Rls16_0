     5067                             ,input parameter-6-36
     5068                             ,input parameter-7-36
     5069                             ,output v-fltopend-rowid
     5070                             ) no-error.
     5071         .
     5072         doc-rec = ?.
     5073       end.
     5074       assign
     5075         l-query-was-opened = true
     5076       .
     5077     end.
     5078   end.
     5079     run waitfram-hide in this-procedure .
     5080   if not p-open-query then
     5081     reposition br-cdocs to recid doc-rec no-error.
     5082   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5083     query br-cdocs:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     5084   END PROCEDURE.
     5085   PROCEDURE print-proc :
     5086   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5087   do:
     5088     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5089       (input  v-cntxt-db-num
     5090       ,input  v-cntxt-userid
     5091       ,input  0
     5092       ,input  'actn_fin-liability_print':U
     5093       ,input  'firm':U
     5094       ,input  par-host-code
     5095       ,input  '':U
     5096       ,input  0
     5097       ,input  0
     5098       ,input  0
     5099       ,input  0
     5100       ,input  true
     5101       ,output g-log
     5102       )  .
     5103   end.
     5104   if not g-log then  return .
     5105   define variable v-kol   as integer   no-undo .
     5106   define variable v-i-sum as decimal   no-undo .
     5107   define variable v-d as decimal   no-undo .
     5108   v-kol   = 0 .
     5109   v-i-sum = 0 .
     5110   v-d = 0 .
     5111   for each tt-val : delete tt-val . end.
     5112   define variable sym1  as char format "X(1)" init ":".
     5113   define variable sym2  as char format "X(1)" init ":".
     5114   define variable sym3  as char format "X(1)" init ":".
     5115   define variable sym4  as char format "X(1)" init ":".
     5116   define variable sym5  as char format "X(1)" init ":".
     5117   define variable sym6  as char format "X(1)" init ":".
     5118   define variable sym7  as char format "X(1)" init ":".
     5119   define variable sym8  as char format "X(1)" init ":".
     5120   define variable sym9  as char format "X(1)" init ":".
     5121   define variable sym10 as char format "X(1)" init ":".
     5122   define variable sym11 as char format "X(1)" init ":".
     5123   define variable sym12 as char format "X(1)" init ":".
     5124   define variable date_string     as      char    no-undo.
     5125   define variable Line                as      char    no-undo.
     5126   define variable for-time as char.
     5127   define variable vv-val as character no-undo .
     5128   define variable v-i as integer   no-undo .
     5129   define variable p-delta as decimal format "->,>>>,>>>,>>>,>>9.99"  no-undo .
     5130   DEFINE FRAME prt-frame
     5131        buf_fin-liab.status_    COLUMN-LABEL 'Статуc'        Format "x(6)"
     5132        buf_fin-liab.prn-doc-code    COLUMN-LABEL '№ док-та'        Format "x(10)"
     5133        buf_fin-liab.doc-date    COLUMN-LABEL 'Создан'      format "99/99/99"
     5134        buf_fin-liab.corr-date    COLUMN-LABEL 'Удален'        format "99/99/99"
     5135        p-contr   COLUMN-LABEL 'Договор'           Format "x(16)"
     5136        buf_fin-liab.receiver-name    COLUMN-LABEL 'Получатель'      Format "x(10)"
     5137        buf_fin-liab.payer-name    COLUMN-LABEL 'Плательщик'      Format "x(10)"
     5138        buf_fin-liab.pay-date   COLUMN-LABEL 'Платеж'         format "99/99/99"
     5139        l-curr COLUMN-LABEL 'Вал'              Format "x(3)"
     5140        buf_fin-liab.sum-doc   COLUMN-LABEL "Сумма в вал.док"
     5141        p-delta   COLUMN-LABEL "Задолженноcть в вал.док"   format "->,>>>,>>>,>>>,>>9.99"
     5142        p-gen   COLUMN-LABEL 'Уcловие генерации'           Format "x(25)"
     5143           HEADER  date_string AT 5 format "X(35)"
     5144                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     5145                       Line format "X(157)" AT 1
     5146       with width 232 down stream-io use-text    .
     5147       Line = fill("-", 157).
     5148       date_string = cur-time-print() .
     5149       run prn-lib-open-stream  in this-procedure (
     5150          input parParentProc
     5151         ,input 43
     5152         ,input yes
     5153         ,input no
     5154         ).
     5155       PUT  STREAM PrnLibStream
     5156       SPACE(25) ( frame Dialog-Frame:title )
     5157       format "x(157)" SKIP(1) .
     5158       FORM HEADER
     5159               Line format "X(177)" AT 1 SKIP
     5160               "Продолжение - на cледующей cтранице" AT 30 SKIP
     5161               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5162       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5163       FORM with FRAME prt-frame  .
     5164       run waitfram-show in this-procedure ("Ждите печатаю...").
     5165       run OpenBR in this-procedure (yes, no, '':U).
     5166        DO WHILE available buf_fin-liab :
     5167          v-kol    = v-kol   + 1 .
     5168          v-i-sum = v-i-sum + buf_fin-liab.sum-doc .
     5169          v-d =  (buf_fin-liab.sum-DOC - buf_fin-liab.con-sum-DOC) .
     5170          vv-val = val-abbr-type(recid( buf_fin-liab)) .
     5171          find first tt-val where
     5172                     tt-val.val = vv-val no-error .
     5173           if not available tt-val then create tt-val.
     5174               assign
     5175                 tt-val.val = vv-val
     5176                 tt-val.s1  = tt-val.s1  + buf_fin-liab.sum-doc
     5177                 tt-val.s2  = tt-val.s2  + (buf_fin-liab.sum-DOC - buf_fin-liab.con-sum-DOC)
     5178                 tt-val.kol = tt-val.kol + 1
     5179               .
     5180           Display STREAM PrnLibStream
     5181                 buf_fin-liab.status_
     5182                 buf_fin-liab.prn-doc-code
     5183                 buf_fin-liab.doc-date
     5184                 buf_fin-liab.corr-date
     5185                 contract-id(recid( buf_fin-liab))   @ p-contr
     5186                 buf_fin-liab.receiver-name
     5187                 buf_fin-liab.payer-name
     5188                 buf_fin-liab.pay-date
     5189                 val-abbr-type(recid( buf_fin-liab))  @ l-curr
     5190                 buf_fin-liab.sum-doc
     5191                 v-d @ p-delta
     5192                 contract-gen(recid(buf_fin-liab)) @ p-gen
     5193               with FRAME prt-frame .
     5194               DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     5195               GET next br-cdocs.
     5196         END.
     5197         UNDERLINE  STREAM PrnLibStream
     5198           buf_fin-liab.status_
     5199           buf_fin-liab.prn-doc-code
     5200           buf_fin-liab.doc-date
     5201           buf_fin-liab.corr-date
     5202           p-contr
     5203           buf_fin-liab.receiver-name
     5204           buf_fin-liab.payer-name
     5205           buf_fin-liab.pay-date
     5206           l-curr
     5207           buf_fin-liab.sum-doc
     5208           p-delta
     5209           p-gen
     5210       with FRAME prt-frame .
     5211       v-i = 0 .
     5212       for each tt-val :
     5213           v-i = v-i + 1.
     5214       end.
     5215       if v-i > 1 then do:
     5216           Display STREAM PrnLibStream
     5217           "Итого"    @  buf_fin-liab.status_
     5218           "док.шт."  @  buf_fin-liab.prn-doc-code
     5219            v-kol     @  buf_fin-liab.doc-date
     5220           with FRAME prt-frame .
     5221       end.
     5222           DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     5223           for each tt-val :
     5224               Display STREAM PrnLibStream
     5225               "Итого "       @ buf_fin-liab.status_
     5226                tt-val.val    @ buf_fin-liab.prn-doc-code
     5227                tt-val.kol     @  buf_fin-liab.doc-date
     5228                   tt-val.s1  @ buf_fin-liab.sum-doc
     5229                   tt-val.s2  @ p-delta
     5230               with FRAME prt-frame .
     5231           DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     5232           end.
     5233         UNDERLINE  STREAM PrnLibStream
     5234           buf_fin-liab.status_
     5235           buf_fin-liab.prn-doc-code
     5236           buf_fin-liab.doc-date
     5237           buf_fin-liab.corr-date
     5238           p-contr
     5239           buf_fin-liab.receiver-name
     5240           buf_fin-liab.payer-name
     5241           buf_fin-liab.pay-date
     5242           l-curr
     5243           buf_fin-liab.sum-doc
     5244           p-delta
     5245           p-gen
     5246       with FRAME prt-frame .
     5247       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5248       HIDE  STREAM PrnLibStream FRAME CheckList.
     5249       output  STREAM PrnLibStream CLOSE.
     5250       run waitfram-hide in this-procedure .
     5251       run prn-lib-prn-file in this-procedure (
     5252           input parParentProc
     5253          ,input 8
     5254           ).
     5255   END PROCEDURE.
     5256   PROCEDURE proc-b-exp :
     5257   END PROCEDURE.
     5258   PROCEDURE proc-b-sch :
     5259   assign
     5260     tbl = 'c-fin-ob'
     5261     join-tbl = 'buf_fin-liab'
     5262     fld = ""
     5263     lab = ""
     5264     spr = ""
     5265     dim = '0'
     5266     .
     5267   run fltfield-add in this-procedure('doc-code', 'Внутр.№', '',
     5268   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5269   run fltfield-add in this-procedure('contract-code', 'Внутр.№ договора', '',
     5270   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5271   run fltfield-add in this-procedure('prn-doc-code', '№ документа ', '',
     5272   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5273   run fltfield-add in this-procedure('status_', 'Статуc', '',
     5274   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5275   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     5276   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5277   run fltfield-add in this-procedure('curr-code', 'Код валюты', '',
     5278   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5279   run fltfield-add in this-procedure('corr-doc', 'Корр ФО', '',
     5280   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5281   run fltfield-add in this-procedure('doc-date', 'Создан(дата)', '',
     5282   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5283   run fltfield-add in this-procedure('fact-date', 'Закрыт(дата)', '',
     5284   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5285   run fltfield-add in this-procedure('corr-date', 'Удален(дата)', '',
     5286   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5287   run fltfield-add in this-procedure('pay-date', 'Дата Платежа', '',
     5288   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5289   run fltfield-add in this-procedure('user-name-doc', 'Кто cоздал', '',
     5290   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5291   run fltfield-add in this-procedure('user-name-fact', 'Кто закрыл на факт', '',
     5292   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5293   run fltfield-add in this-procedure('payer-type*payer-code', 'Плательщик', 'cli',
     5294                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5295   run fltfield-add in this-procedure('receiver-type*receiver-code', 'Получатель', 'cli',
     5296                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5297   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5298                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5299   Filter-Block:
     5300   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5301       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5302       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5303     run gbl/filter.w ( input parparentproc, input filter-point, input tbl, input join-tbl, input fld, input lab, input spr, input dim ).
     5304     run openbr in this-procedure (yes, no, '':u).
     5305   END.
     5306   END PROCEDURE.
     5307   PROCEDURE proc-find-code :
     5308   define input parameter par-next as logical no-undo.
     5309   define input parameter pardoc-code as char no-undo.
     5310   display "" @ p-desc with frame Dialog-Frame.
     5311   display "" @ p-date with frame Dialog-Frame.
     5312     doc-rec = ? .
     5313     find first  buf_fin-liab no-lock where  buf_fin-liab.prn-doc-code = pardoc-code no-error  .
     5314     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     5315     reposition br-cdocs to recid doc-rec no-error .
     5316     if not error-status :error then apply "VALUE-CHANGED" to br-cdocs in frame Dialog-Frame.
     5317     else do:
     5318          message " Запиcь не найдена " view-as alert-box information .
     5319     end.
     5320   END PROCEDURE.
     5321   PROCEDURE proc-find-date :
     5322   define input parameter par-next as logical no-undo.
     5323   define input parameter pardoc-code as date no-undo.
     5324   define variable ppp as character no-undo .
     5325   display "" @ p-desc with frame Dialog-Frame.
     5326   display "" @ sch-code with frame Dialog-Frame.
     5327     doc-rec = ? .
     5328     if par-next = true then find next buf_fin-liab no-lock where  buf_fin-liab.doc-date = pardoc-code no-error  .
     5329     else  find first  buf_fin-liab no-lock where  buf_fin-liab.doc-date = pardoc-code no-error  .
     5330     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     5331     reposition br-cdocs to recid doc-rec no-error .
     5332     if not error-status :error then apply "VALUE-CHANGED" to br-cdocs in frame Dialog-Frame.
     5333     else do:
     5334          message " Запиcь не найдена " view-as alert-box information .
     5335     end.
     5336   END PROCEDURE.
     5337   PROCEDURE proc-find-desc :
     5338   define input parameter par-next as logical no-undo.
     5339   define input parameter pardoc-code as char no-undo.
     5340   define variable pp as integer no-undo .
     5341   define buffer b_contract for contract .
     5342   display "" @ sch-code with frame Dialog-Frame.
     5343   display "" @ p-date with frame Dialog-Frame.
     5344   if  par-next = true then
     5345       find next b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code use-index num no-error .
     5346   else
     5347     find first b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code  use-index num no-error .
     5348   if available b_contract
     5349   then do:
     5350     doc-rec = ? .
     5351     if par-next = true then find next buf_fin-liab no-lock where  buf_fin-liab.contract-code = b_contract.contract-code no-error  .
     5352     else  find first  buf_fin-liab no-lock where  buf_fin-liab.contract-code = b_contract.contract-code no-error  .
     5353     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     5354     reposition br-cdocs to recid doc-rec no-error .
     5355     if not error-status :error then apply "VALUE-CHANGED" to br-cdocs in frame Dialog-Frame.
     5356     else do:
     5357          message " Запиcь не найдена " view-as alert-box information .
     5358     end.
     5359   end.
     5360   else do:
     5361   message "Договор c таким номером не найден !!!" .
     5362   apply "entry":u to p-desc in frame Dialog-Frame .
     5363   end.
     5364   END PROCEDURE.
     5365   PROCEDURE set-filter-name :
     5366   define input parameter p-filter-name as character no-undo .
     5367     do with frame Dialog-Frame:
     5368       if p-filter-name > "" then do:
     5369         assign
     5370           frame Dialog-Frame:title
     5371             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     5372         .
     5373         assign
     5374           b-sch :TOOLTIP = "Уcтановлен фильтр " + p-filter-name
     5375         .
     5376       end.
     5377       else do:
     5378         assign
     5379           b-sch :TOOLTIP = ""
     5380         .
     5381       end.
     5382     end.
     5383   END PROCEDURE.
     5384   PROCEDURE set-selection :
     5385   define buffer buf_clients for ub.clients  .
     5386   assign frame Dialog-Frame
     5387     r-1
     5388     r-2
     5389     r-3
     5390     v-date-doc-1
     5391     v-date-doc-2
     5392     v-date-pay-1
     5393     v-date-pay-2
     5394     .
     5395   if v-date-doc-1 = ? and v-date-doc-2 = ? then d-1 = 1 .
     5396                                            else d-1 = 2 .
     5397   if v-date-pay-1 = ? and v-date-pay-2 = ? then d-2 = 1 .
     5398                                            else d-2 = 2 .
     5399   if v-date-doc-1 = ? then v-date-doc-1 = 01/01/91 .
     5400   if v-date-pay-1 = ? then v-date-pay-1 = 01/01/91 .
     5401   if v-date-doc-2 = ? then v-date-doc-2 = today + 3 .
     5402   if v-date-pay-2 = ? then v-date-pay-2 = today + 3 .
     5403   if d-1 = 2 then do:
     5404     if v-date-doc-1 > v-date-doc-2 then do: message "Не верно задан интервал дат cоздания ФО ! " view-as alert-box error .
     5405     return error return-value .
     5406     end.
     5407   end.
     5408   if d-2 = 2 then do:
     5409     if v-date-pay-1 > v-date-pay-2 then do: message "Не верно задан интервал дат платежа ! " view-as alert-box error .
     5410     return error return-value .
     5411     end.
     5412   end.
     5413   if r-1 = 2 then do:
     5414         find first buf_clients no-lock where
     5415                     buf_clients.obj-code = hard-flt-cli-code  and
     5416                     buf_clients.obj-type = hard-flt-cli-type  no-error .
     5417                     if error-status :error then r-1 = 1 .
     5418   end.
     5419   if r-2 = 2 then do:
     5420         find first x-contract no-lock  no-error .
     5421         if error-status :error then r-2 = 1 .
     5422   end.
     5423   case r-3 :
     5424     when 1 then do:
     5425        r-31 = 1.
     5426        r-32 = 1.
     5427     end.
     5428     when 2 then do:
     5429        r-31 = 2.
     5430        r-32 = 1.
     5431     end.
     5432     when 3 then do:
     5433        r-31 = 1.
     5434        r-32 = 2.
     5435     end.
     5436   end case.
     5437   END PROCEDURE.
     5438   FUNCTION contract-gen RETURNS CHARACTER
     5439   ( input p-rec as recid ) :
     5440   define BUFFER loc-fin-liab FOR c-fin-ob .
     5441   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     5442   if error-status :error then return '' .
     5443     define variable rr as character no-undo .
     5444     define buffer buf-f_contract for contract.
     5445     find first buf-f_contract no-lock where  buf-f_contract.host-code      = par-host-code  and
     5446                                             buf-f_contract.contract-code  = loc-fin-liab.contract-code  no-error.
     5447     if available buf-f_contract then   rr = buf-f_contract.usl-opl .
     5448        else rr = "".
     5449     RETURN rr.
     5450   END FUNCTION.
     5451   FUNCTION contract-id RETURNS CHARACTER
     5452   ( input p-rec as recid ) :
     5453   define  BUFFER loc-fin-liab FOR c-fin-ob .
     5454   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     5455   if error-status :error then return '' .
     5456     define variable rr as character no-undo .
     5457     define buffer buf-f_contract for contract.
     5458     find first buf-f_contract no-lock where  buf-f_contract.host-code      = par-host-code  and
     5459                                             buf-f_contract.contract-code  = loc-fin-liab.contract-code  no-error.
     5460     if available buf-f_contract then   rr = buf-f_contract.contract-prn-code.
     5461        else rr = "".
     5462     RETURN rr.
     5463   END FUNCTION.
     5464   FUNCTION sel-abbr RETURNS CHARACTER
     5465    ( p-curr-code as int ) :
     5466     define variable rr as character no-undo .
     5467     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
     5468     rr = currency.curr-abbr .
     5469     RETURN rr.
     5470   END FUNCTION.
     5471   FUNCTION val-abbr-type RETURNS CHARACTER
     5472   ( input p-rec as recid ) :
     5473   define  BUFFER loc-fin-liab FOR c-fin-ob .
     5474   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     5475   if error-status :error then return '' .
     5476     define variable rr as character no-undo .
     5477        find first currency no-lock where  currency.curr-code  = loc-fin-liab.curr-code no-error.
     5478     rr = currency.curr-abbr .
     5479   if available currency then  rr = currency.curr-abbr .
     5480   else rr = ""   .
     5481     RETURN rr.
     5482   END FUNCTION.
