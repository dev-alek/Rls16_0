        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fbrclcin.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/fbrclcin.p $":U .
        7   define variable vss-description as character no-undo init "Производство: размазывание учётной цены".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define input parameter p-doc-code       as character        no-undo.
       69   define input parameter p-recipe-code    as character        no-undo.
       70   define input parameter p-base           as logical          no-undo.
       71   define input parameter p-base-rate      as decimal          no-undo.
       72   define input parameter p-base-scale     as decimal          no-undo.
       73       define variable v-comp-sum-cost-rubl            as decimal      no-undo.
       74       define variable v-comp-sum-vat-cost-rubl        as decimal      no-undo.
       75       define variable v-comp-sum-cost-base            as decimal      no-undo.
       76       define variable v-comp-sum-vat-cost-base        as decimal      no-undo.
       77       define variable v-comp-sum-fixed-cost-rubl      as decimal      no-undo.
       78       define variable v-comp-sum-fixed-vat-cost-rubl  as decimal      no-undo.
       79       define variable v-comp-sum-fixed-cost-base      as decimal      no-undo.
       80       define variable v-comp-sum-fixed-vat-cost-base  as decimal      no-undo.
       81       define variable v-ingr-fixed-sum-cost-rubl      as decimal      no-undo.
       82       define variable v-ingr-fixed-sum-vat-cost-rubl  as decimal      no-undo.
       83       define variable v-ingr-fixed-sum-cost-base      as decimal      no-undo.
       84       define variable v-ingr-fixed-sum-vat-cost-base  as decimal      no-undo.
       85       define variable v-vat-pc                        as decimal      no-undo.
       86       define variable v-income-sum-price-sale     as decimal      no-undo.
       87       define buffer buf_fbr-line for fbr-line.
       88   do
       89   for buf_fbr-line
       90   on error undo, return error
       91   :
       92       find first buf_fbr-line no-lock
       93            where buf_fbr-line.doc-code    = p-doc-code
       94              and buf_fbr-line.recipe-code = p-recipe-code
       95              and buf_fbr-line.is-comp     = no
       96              and buf_fbr-line.fix-cost    = no
       97              and buf_fbr-line.is-waste    = no
       98       no-error.
       99       if not available buf_fbr-line
      100       then do:
      101           message
      102               "Все строки прихода фиксированы."
      103               skip "Изменение учётной цены невозможно."
      104           view-as alert-box error
      105           title "Изменение учётной цены ингредиента".
      106           undo, return error.
      107       end.
      108       find first buf_fbr-line no-lock
      109            where buf_fbr-line.doc-code    = p-doc-code
      110              and buf_fbr-line.recipe-code = p-recipe-code
      111              and buf_fbr-line.is-comp     = yes
      112       .
      113       assign
      114           v-comp-sum-cost-rubl         = buf_fbr-line.price-sum-rubl
      115           v-comp-sum-vat-cost-rubl     = buf_fbr-line.price-sum-vat-rubl
      116           v-comp-sum-cost-base         = buf_fbr-line.price-sum-base
      117           v-comp-sum-vat-cost-base     = buf_fbr-line.price-sum-vat-base
      118       .
      119       for each buf_fbr-line no-lock
      120          where buf_fbr-line.doc-code    = p-doc-code
      121            and buf_fbr-line.recipe-code = p-recipe-code
      122            and buf_fbr-line.is-comp     = no
      123            and buf_fbr-line.fix-cost    = yes
      124       :
      125           assign
      126               v-ingr-fixed-sum-cost-rubl       = v-ingr-fixed-sum-cost-rubl     + buf_fbr-line.price-sum-rubl
      127               v-ingr-fixed-sum-vat-cost-rubl   = v-ingr-fixed-sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
      128               v-ingr-fixed-sum-cost-base       = v-ingr-fixed-sum-cost-base     + buf_fbr-line.price-sum-base
      129               v-ingr-fixed-sum-vat-cost-base   = v-ingr-fixed-sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
      130           .
      131       end.
      132       assign
      133           v-comp-sum-fixed-cost-rubl     = v-comp-sum-cost-rubl       - v-ingr-fixed-sum-cost-rubl
      134           v-comp-sum-fixed-vat-cost-rubl = v-comp-sum-vat-cost-rubl   - v-ingr-fixed-sum-vat-cost-rubl
      135           v-comp-sum-fixed-cost-base     = v-comp-sum-cost-base       - v-ingr-fixed-sum-cost-base
      136           v-comp-sum-fixed-vat-cost-base = v-comp-sum-vat-cost-base   - v-ingr-fixed-sum-vat-cost-base
      137       .
      138       if v-comp-sum-fixed-cost-rubl     < 0
      139       or v-comp-sum-fixed-vat-cost-rubl < 0
      140       or v-comp-sum-fixed-cost-base     < 0
      141       or v-comp-sum-fixed-vat-cost-base < 0
      142       then do:
      143           message
      144               "Фиксированная учётная цена слишком велика."
      145           view-as alert-box information.
      146           undo, return error .
      147       end.
      148       for each buf_fbr-line no-lock
      149          where buf_fbr-line.doc-code    = p-doc-code
      150            and buf_fbr-line.recipe-code = p-recipe-code
      151            and buf_fbr-line.is-comp     = no
      152            and buf_fbr-line.fix-cost    = no
      153            and buf_fbr-line.is-waste    = no
      154       :
      155           assign
      156               v-income-sum-price-sale = v-income-sum-price-sale + ( buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
      157           .
      158       end.
      159       do transaction
      160       on error undo, return no-apply
      161       :
      162           for each buf_fbr-line exclusive-lock
      163              where buf_fbr-line.doc-code    = p-doc-code
      164                and buf_fbr-line.recipe-code = p-recipe-code
      165                and buf_fbr-line.is-comp     = no
      166                and buf_fbr-line.fix-cost    = no
      167                and buf_fbr-line.is-waste    = no
      168           :
      169               if p-base = yes
      170               then do:
      171                   assign
      172                       v-vat-pc = buf_fbr-line.price-sum-vat-base / buf_fbr-line.price-sum-base
      173                   .
      174                   assign
      175                       buf_fbr-line.price-base         = v-comp-sum-fixed-cost-base    * buf_fbr-line.price-sale / v-income-sum-price-sale
      176                       buf_fbr-line.price-sum-base     = buf_fbr-line.price-base       * buf_fbr-line.fact-qnty
      177                       buf_fbr-line.price-sum-vat-base = buf_fbr-line.price-sum-base   * v-vat-pc
      178                   .
      179                   assign
      180                       buf_fbr-line.price-rubl         = buf_fbr-line.price-base
      181                                                               * ( if p-base-rate = 0 then 1 else p-base-rate )
      182                                                               / ( if p-base-scale = 0 then 1 else p-base-scale )
      183                       buf_fbr-line.price-sum-rubl     = buf_fbr-line.price-rubl * buf_fbr-line.fact-qnty
      184                       buf_fbr-line.price-sum-vat-rubl = buf_fbr-line.price-sum-vat-base
      185                                                               * ( if p-base-rate = 0 then 1 else p-base-rate )
      186                                                               / ( if p-base-scale = 0 then 1 else p-base-scale )
      187                   .
      188               end.
      189               else do:
      190                   assign
      191                       v-vat-pc = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.price-sum-rubl
      192                   .
      193                   assign
      194                       buf_fbr-line.price-rubl         = v-comp-sum-fixed-cost-rubl    * buf_fbr-line.price-sale / v-income-sum-price-sale
      195                       buf_fbr-line.price-sum-rubl     = buf_fbr-line.price-rubl       * buf_fbr-line.fact-qnty
      196                       buf_fbr-line.price-sum-vat-rubl = buf_fbr-line.price-sum-rubl   * v-vat-pc
      197                   .
      198                   assign
      199                       buf_fbr-line.price-base         = buf_fbr-line.price-rubl
      200                                                               / ( if p-base-rate = 0 then 1 else p-base-rate )
      201                                                               * ( if p-base-scale = 0 then 1 else p-base-scale )
      202                       buf_fbr-line.price-sum-base     = buf_fbr-line.price-base * buf_fbr-line.fact-qnty
      203                       buf_fbr-line.price-sum-vat-base = buf_fbr-line.price-sum-vat-rubl
      204                                                               / ( if p-base-rate = 0 then 1 else p-base-rate )
      205                                                               * ( if p-base-scale = 0 then 1 else p-base-scale )
      206                   .
      207               end.
      208           end.
      209           assign
      210               v-ingr-fixed-sum-cost-rubl      = 0
      211               v-ingr-fixed-sum-vat-cost-rubl  = 0
      212               v-ingr-fixed-sum-cost-base      = 0
      213               v-ingr-fixed-sum-vat-cost-base  = 0
      214           .
      215           for each buf_fbr-line exclusive-lock
      216              where buf_fbr-line.doc-code    = p-doc-code
      217                and buf_fbr-line.recipe-code = p-recipe-code
      218                and buf_fbr-line.is-comp     = no
      219           :
      220               assign
      221                   v-ingr-fixed-sum-cost-rubl      = v-ingr-fixed-sum-cost-rubl        + buf_fbr-line.price-sum-rubl
      222                   v-ingr-fixed-sum-vat-cost-rubl  = v-ingr-fixed-sum-vat-cost-rubl    + buf_fbr-line.price-sum-vat-rubl
      223                   v-ingr-fixed-sum-cost-base      = v-ingr-fixed-sum-cost-base        + buf_fbr-line.price-sum-base
      224                   v-ingr-fixed-sum-vat-cost-base  = v-ingr-fixed-sum-vat-cost-base    + buf_fbr-line.price-sum-vat-base
      225               .
      226           end.
      227           if v-ingr-fixed-sum-cost-rubl     <> v-comp-sum-cost-rubl
      228           or v-ingr-fixed-sum-vat-cost-rubl <> v-comp-sum-vat-cost-rubl
      229           or v-ingr-fixed-sum-cost-base     <> v-comp-sum-cost-base
      230           or v-ingr-fixed-sum-vat-cost-base <> v-comp-sum-vat-cost-base
      231           then do:
      232               max-ingr-plus-delta:
      233               for each buf_fbr-line exclusive-lock
      234                  where buf_fbr-line.doc-code    = p-doc-code
      235                    and buf_fbr-line.recipe-code = p-recipe-code
      236                    and buf_fbr-line.is-comp     = no
      237                    and buf_fbr-line.fix-cost    = no
      238                    and buf_fbr-line.is-waste    = no
      239               by buf_fbr-line.price-sum-rubl descending
      240               :
      241                   assign
      242                       buf_fbr-line.price-sum-rubl         = buf_fbr-line.price-sum-rubl      - v-ingr-fixed-sum-cost-rubl     + v-comp-sum-cost-rubl
      243                       buf_fbr-line.price-sum-vat-rubl     = buf_fbr-line.price-sum-vat-rubl  - v-ingr-fixed-sum-vat-cost-rubl + v-comp-sum-vat-cost-rubl
      244                       buf_fbr-line.price-sum-base         = buf_fbr-line.price-sum-base      - v-ingr-fixed-sum-cost-base     + v-comp-sum-cost-base
      245                       buf_fbr-line.price-sum-vat-base     = buf_fbr-line.price-sum-vat-base  - v-ingr-fixed-sum-vat-cost-base + v-comp-sum-vat-cost-base
      246                       buf_fbr-line.price-rubl             = buf_fbr-line.price-sum-rubl / buf_fbr-line.fact-qnty
      247                       buf_fbr-line.price-base             = buf_fbr-line.price-sum-base / buf_fbr-line.fact-qnty
      248                   .
      249                   leave max-ingr-plus-delta.
      250               end.
      251           end.
      252       end.
      253   end.
