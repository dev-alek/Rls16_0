       82   define variable parParentProc  as widget-handle no-undo .
       83   parParentProc = this-procedure.
       84   procedure vss-get-info :
       85     define output parameter p-vss-revision    like vss-revision    no-undo .
       86     define output parameter p-vss-author      like vss-author      no-undo .
       87     define output parameter p-vss-date        like vss-date        no-undo .
       88     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       89     define output parameter p-vss-archive     like vss-archive     no-undo .
       90     define output parameter p-vss-description like vss-description no-undo .
       91     assign
       92       p-vss-revision    = vss-revision
