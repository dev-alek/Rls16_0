      872   define frame a
      873       i format ">>>>9" label "Просмотрено" space (20) skip
      874       j format ">>>>9" label "Обработано"
      875       with view-as dialog-box side-labels three-d title "".
      876   def var mess as char no-undo.
      877   procedure check-code:
      878   define input parameter parbar-str AS char no-undo.
      879   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      880   define input parameter parqnty    as dec no-undo.
      881   define input  parameter parg#doc-prt as logical no-undo.
      882   define input  parameter parscales-pref as character no-undo.
      883   define input  parameter parpgscales-pref as character no-undo.
      884   define output parameter parplace   as log initial no no-undo.
      885   define output parameter parb-c     as int no-undo.
      886   define output parameter parrate    as dec no-undo.
      887   define variable varresult   as character       no-undo.
      888   define variable vartype-bc  as character       no-undo.
      889   define variable varweight   as decimal         no-undo.
      890   def buffer b-bar-code for ub.bar-code.
      891   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      892   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      893   (
      894    input  parparentproc
      895   ,input  parbar-str
      896   ,input  parprice
      897   ,input  v-cntxt-obj-type
      898   ,input  v-cntxt-obj-code
      899   ,input  yes
      900   ,input  no
      901   ,input  parscales-pref
      902   ,input  parpgscales-pref
      903   ,output varresult
      904   ,output vartype-bc
      905   ,output varweight
      906   ,buffer ub.bar-code
      907   ,buffer ub.prod-bc
      908   ,buffer ub.place
      909   ) no-error.
      910   if error-status:error then do:
      911     return error "Ошибка при разборе бар-кода: " + parbar-str.
      912   end.
      913   if not available bar-code THEN DO:
      914      if add-sens = ? and available place
      915      then DO: parPlace = YES. RETURN. END.
      916      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      917   END.
      918   else do:
      919       assign  parb-c  = bar-code.b-code
      920               parrate = bar-code.cli-base-rate.
      921       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      922       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      923       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      924       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      925          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      926          RETURN ERROR "Ссылка не на подробный признак.".
      927       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      928            bar-code.node-code <> gds-prt.node-code then do:
      929         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      930         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      931                         and bar-code.node-code = gds-prt.node-code
      932                         and bar-code.in-code   = b-bar-code.in-code
      933                         and bar-code.part-code = b-bar-code.part-code
      934                         and bar-code.unit-cli  = ub.goods.unit-base
      935                           no-lock.
      936         parb-c = bar-code.b-code.
      937         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      938       end.
      939   end.
      940   RETURN.
      941   END PROCEDURE.
      942   procedure proc-code.
      943   define input parameter pl-str as char no-undo.
      944   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
      945   define input parameter parscales-pref as character no-undo.
      946   define input parameter parpgscales-pref as character no-undo.
      947   define buffer b-bar-code for ub.bar-code.
      948   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
      949   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
      950   define variable varres        as logical         no-undo.
      951   define variable var-code-temp like ub.place.pl-code no-undo.
      952   define buffer pc-goods for ub.goods.
      953   define variable g-log-char as character no-undo.
      954   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
      955   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
      956   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
      957   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      958   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
      959   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
      960   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      961   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
      962   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
      963   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
      964   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
      965   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
      966   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
      967   define variable lns-cnt                 as   integer               no-undo.
      968   IF mode-proc = "PLACE" THEN DO:
      969       do lns-cnt = 1 to num-entries (part-list):
      970         find ub.bar-code where ub.bar-code.b-code  = integer (entry (lns-cnt, part-list)) no-lock.
      971         find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      972         RUN plgdsfnd (input  no,
      973                       input  v-cntxt-obj-type,
      974                       input  v-cntxt-obj-code,
      975                       input  pc-goods.gds-code,
      976                       output varres,
      977                       output var-code-temp) no-error.
      978        if varres = yes or error-status:error then do:
      979             put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      980             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      981             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      982             put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      983             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      984             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      985             put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      986         end.
      987         else
      988         for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      989                          and ub.parts.obj-code  = v-cntxt-obj-code
      990                          and ub.parts.artic     = pc-goods.artic
      991                          and ub.parts.prod-type = pc-goods.prod-type
      992                          and ub.parts.prod-code = pc-goods.prod-code
      993                          and ub.parts.in-code   = ub.bar-code.in-code
      994                          and ub.parts.part-code = ub.bar-code.part-code
      995                          and ub.parts.rsrv-free = yes:
      996           ub.parts.pl-code = ub.place.pl-code.
      997           put stream log unformatted mess "Партия: код: " bar-code.b-code " артикул: " ub.parts.artic " номер: " ub.parts.part-code " Место: " ub.parts.pl-code " - успешно" skip.
      998           j = j + 1.
      999           disp j with frame a.
     1000         end.
     1001       end.
     1002       part-list = "".
     1003   END.
     1004   ELSE DO:
     1005     if add-sens = ? then part-list = if part-list = "" then string (b-c) else part-list + "," + string (b-c).
     1006     else do:
     1007       if ub.goods.gds-type <> 'т':U and (t-doc.doc-type <> 'рас':U or t-doc.internal) then do:
     1008         put stream log unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
     1009         put stream ler unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
     1010         put stream err unformatted bar-str "," qnty-str skip.
     1011         return error.
     1012       end.
     1013       if g-type = ? then g-type = ub.goods.gds-type.
     1014       if g-type <> ub.goods.gds-type then do:
     1015         put stream log unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
     1016         put stream ler unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
     1017         put stream err unformatted bar-str ","  qnty-str skip.
     1018         return error.
     1019       end.
     1020       assign g-log-char = "yes".
     1021       do transaction on error undo , leave:
