      169   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   procedure cur-time :
      171      define output parameter p-today as date      no-undo .
      172      define output parameter p-time  as integer   no-undo .
      173     do
      174     on error undo, return error
      175     :
      176       define variable v-date1 as date      no-undo .
      177       define variable v-date2 as date      no-undo .
      178       define variable v-time  as integer   no-undo .
      179       assign
      180         v-date1 = today
      181         v-time  = time
      182         v-date2 = today
      183       .
      184       if v-date1 <> v-date2
      185       then do:
      186         assign
      187           v-date1 = today
      188           v-time  = v-time
      189         .
      190       end.
      191       assign
      192         p-today = v-date1
      193         p-time  = v-time
      194       .
      195     end.
      196   end.
      197   function cur-time-date returns character
      198   :
      199     return string(today, '99/99/9999':U) .
      200   end.
      201   function cur-time-mjd returns decimal
      202   :
      203     define variable v-date as date      no-undo .
      204     define variable v-time as integer   no-undo .
      205     run cur-time in this-procedure
      206       (output v-date
      207       ,output v-time
      208       ) .
      209     return integer(v-date) - 2400002 + (v-time / 86400) .
      210   end.
      211   function cur-time-get-ending-index returns integer
      212   (input p-number as integer
      213   )
      214   :
      215     if p-number < 0
      216     or p-number = ?
      217     then do:
      218       return 1 .
      219     end.
      220     define variable v-rest as integer   no-undo .
      221     assign
      222       p-number = p-number modulo 100
      223     .
      224     if p-number < 20
      225     then do:
      226       assign
      227         v-rest = p-number
      228       .
      229     end.
      230     else do:
      231       assign
      232         v-rest = p-number modulo 10
      233       .
      234     end.
      235     case v-rest :
      236       when 1
      237       then do:
      238         return 2 .
      239       end.
      240       when 2 or
      241       when 3 or
      242       when 4
      243       then do:
      244         return 3 .
      245       end.
      246       otherwise do:
      247         return 1 .
      248       end.
      249     end case .
      250   end.
      251   procedure cur-time-mjd-to-date :
      252      define input  parameter i-mjd-diff as decimal no-undo.
      253      define output parameter o-Date     as date    no-undo.
      254      define output parameter o-Time     as integer no-undo.
      255      define variable v-day-number as integer   no-undo .
      256      if    i-mjd-diff < 0
      257         or i-mjd-diff = ?
      258      then do:
      259         return "?" .
      260      end.
      261      assign
      262         v-day-number = truncate(i-mjd-diff,0).
      263         o-Date = date(v-day-number + 2400002).
      264         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      265     .
      266   end.
      267   function cur-time-mjd-to-string returns character
      268   (input p-mjd-diff as decimal
      269   )
      270   :
      271     define variable v-day-number as integer   no-undo .
      272     define variable v-seconds    as integer   no-undo .
      273     define variable v-hour       as integer   no-undo .
      274     define variable v-min        as integer   no-undo .
      275     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      276     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      277     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      278     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      279     if p-mjd-diff < 0
      280     or p-mjd-diff = ?
      281     then do:
      282       return "?" .
      283     end.
      284     assign
      285       v-day-number = integer(truncate(p-mjd-diff,0))
      286       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      287     .
      288     if v-seconds > 86400
      289     then do:
      290       assign
      291         v-seconds = 86400 - 1
      292       .
      293     end.
      294     if v-seconds < 0
      295     then do:
      296       assign
      297         v-seconds = 0
      298       .
      299     end.
      300     assign
      301       v-hour = truncate(v-seconds / 3600, 0)
      302     .
      303     assign
      304       v-seconds = v-seconds modulo 3600
      305     .
      306     assign
      307       v-min = truncate(v-seconds / 60, 0)
      308     .
      309     assign
      310       v-seconds = v-seconds modulo 60
      311     .
      312     return
      313         (if v-day-number <> 0
      314           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0
      318           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      319           else ""
      320         )
      321       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      322           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      323           else ""
      324         )
      325       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      326       .
      327   end.
      328   function cur-time-string returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-string-sec returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      347   end.
      348   function cur-time-custom  returns character
      349   (input p-prefix as character
      350   ,input p-date-format as character
      351   ,input p-delimiter as character
      352   ,input p-time-format as character
      353   ,input p-suffix as character
      354   )
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return
      363       p-prefix
      364       + string(v-date, p-date-format)
      365       + p-delimiter
      366       + string(v-time, p-time-format)
      367       + p-suffix
      368       .
      369   end.
      370   function cur-time-print  returns character
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      379   end.
      380   function cur-time-datetime returns datetime
      381   :
      382     define variable v-char as character no-undo .
      383     define variable v-datetime as datetime no-undo .
      384     v-char = cur-time-string().
      385     v-datetime = datetime(v-char).
      386     return  v-datetime.
      387   end.
      388   function cur-time-string-msec returns character
      389   :
      390     define variable v-date as datetime  no-undo .
      391     v-date = now.
      392     return string(v-date) .
      393   end.
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   define variable v-waitfram-action01         as character   no-undo .
      396   define variable v-waitfram-action02         as character   no-undo .
      397   define variable v-waitfram-action03         as character   no-undo .
      398   define variable mWaitFramTextBeg            as character   no-undo.
      399   define variable mWaitFramTextEnd            as character   no-undo.
      400   define variable mWaitFramView               as logical     no-undo.
      401   define variable mWaitProcEvent              as logical     no-undo init yes.
      402   define variable mWaitFramInterval           as integer     no-undo init 1 .
      403   define variable mWaitFramStop               as logical     no-undo.
      404   define variable mWaitFramStopUser           as logical     no-undo.
      405   define variable mWaitFramStopTimeOut        as logical     no-undo.
      406   define variable mWaitFramStartProc          as datetime-tz no-undo.
      407   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      408   define button B-WaitFramStop auto-end-key
      409        label "Стоп"
      410        size 10 by 1 tooltip "Остоновить процесс".
      411   define button B-viewProcInfo
      412        label "Информация"
      413        size 15 by 1 tooltip "Информация о процесс".
      414   define frame waitfram
      415     v-waitfram-action01 format "x(72)" no-label skip
      416     v-waitfram-action02 format "x(72)" no-label skip
      417     v-waitfram-action03 format "x(72)" no-label skip
      418     B-viewProcInfo
      419     B-WaitFramStop at row 4 col 30
      420     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      421     .
      422   define new global shared variable mBatchMode as logical no-undo init ?.
      423   define variable mFramBachModHandle as handle no-undo.
      424   mFramBachModHandle = frame waitfram:handle.
      425   define variable mFameOldVis as logical no-undo.
      426   define variable mVisCUrentVin as logical no-undo.
      427   if session:batch-mode
      428   then
      429      mBatchMode = yes.
      430   if mBatchMode = ? then do:
      431     mVisCUrentVin = current-window:visible.
      432     mFameOldVis = mFramBachModHandle:visible.
      433     mFramBachModHandle:visible  = yes.
      434     mBatchMode = mFramBachModHandle:visible ne yes.
      435     mFramBachModHandle:visible = mFameOldVis.
      436     current-window:visible = mVisCUrentVin.
      437   end.
      438    if  log-manager:logfile-name ne ?
      439     then DO:
      440         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      441         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      442         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      443     end.
      444   on choose of B-WaitFramStop in frame waitfram
      445   do:
      446     mWaitFramStop = yes.
      447     mWaitFramStopUser = yes.
      448   end.
      449   function waitfram-check-timeout returns logical():
      450      define variable vtime as int64 no-undo.
      451      if mWaitFramStopTimeOut
      452      then
      453         return yes.
      454      vtime = ( now - mWaitFramStartProc ) / 1000 .
      455      if     mWaitFramTimeOut ne ?
      456         and mWaitFramTimeOut ne 0
      457         and mWaitFramTimeOut lt vtime
      458      then do:
      459         mWaitFramStopTimeOut = yes.
      460      end.
      461      return mWaitFramStopTimeOut.
      462   end.
      463   procedure waitfram-hide :
      464     if not session:batch-mode
      465     then do
      466     on error undo, return error return-value
      467     :
      468       pause 0 before-hide .
      469       if not mBatchMode then
      470         hide frame waitfram .
      471     end.
      472   end procedure.
      473   procedure waitfram-show :
      474     define input  parameter p-message as character no-undo .
      475     define variable v-left-margin as integer   no-undo .
      476     if not session:batch-mode
      477     then do
      478     on error undo, return error return-value
      479     :
      480       if length(p-message) <= 70 then do:
      481         assign
      482           v-left-margin = integer((70 - length(p-message)) / 2)
      483         .
      484         assign
      485           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      486         .
      487         assign
      488           v-waitfram-action01 = " "
      489           v-waitfram-action02 = " "
      490                                    + fill(" ", v-left-margin)
      491                                    + p-message
      492           v-waitfram-action03 = " "
      493         .
      494       end.
      495       else do:
      496         define variable vRindex1 as integer no-undo.
      497         define variable vRindex2 as integer no-undo.
      498         vRindex1 = r-index(p-message," ",70).
      499         if vRindex1 = 0
      500         then
      501            vRindex1 = 70.
      502         if length(p-message)  <= vRindex1 + 70 then do:
      503           assign
      504             v-waitfram-action01 = " "
      505             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      506             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      507           .
      508         end.
      509         else do:
      510           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      511           if vRindex2 <= vRindex1
      512           then
      513              vRindex2 = vRindex1 + 70.
      514           assign
      515             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      516             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      517             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      518           .
      519         end.
      520       end.
      521       B-viewProcInfo:visible   in frame waitfram = no.
      522       B-viewProcInfo:sensitive in frame waitfram = no.
      523       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      524       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      525       if  (   mWaitFramView
      526          or  mWaitProcEvent)
      527          and not mBatchMode
      528       then
      529          display
      530             v-waitfram-action01 skip
      531             v-waitfram-action02 skip
      532             v-waitfram-action03 skip
      533          with frame waitfram .
      534     end.
      535   end procedure.
      536      procedure waitfram-show-this:
      537         define input  parameter iInterval as int64 no-undo.
      538         define variable vtime as int64 no-undo.
      539         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      540         mWaitFramInterval = iInterval.
      541         run waitfram-show (substitute("&1&2 &3&4" ,
      542                                       mWaitFramTextBeg ,
      543                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      544                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      545                                       mWaitFramTextEnd
      546                                      )
      547                           ).
      548      end.
      549      procedure WaitFramRunPause:
      550         define input  parameter iInterval as dec no-undo.
      551         define variable vStart  as datetime-tz no-undo.
      552         define variable vend    as datetime-tz no-undo.
      553         define variable vint as int64 no-undo.
      554         define variable vOk as logical no-undo.
      555         vStart = now.
      556         vend   = vStart.
      557         publish "WaitFramPause" (iInterval,output vOk).
      558         vend   =  now.
      559         vint = vend - vStart.
      560         vint = iInterval - vint / 1000.
      561         if     not mWaitFramStop
      562            and (   vint > 0
      563                 or (    not vOk
      564                     and iInterval eq ?
      565                     )
      566                 )
      567         then
      568            run waitfram-show-this (iInterval).
      569         vend   =  now.
      570         vint = vend - vStart.
      571         vint = iInterval - vint / 1000.
      572         if     not mWaitFramStop
      573            and vint > 0
      574         then do:
      575            run gbl/pause.p (vint * 1000).
      576         end.
      577         if iInterval ne ?
      578         then
      579            publish "WaitFramStop".
      580         waitfram-check-timeout().
      581      end.
      582      procedure WaitFramWaitFor:
      583         define input  parameter iInterval as dec no-undo.
      584         assign
      585            mWaitFramStartProc   = now
      586            mWaitFramStopUser    = no
      587            mWaitFramStopTimeOut = no
      588         .
      589         block-wait:
      590         do while not mWaitFramStop:
      591            run WaitFramRunPause (iInterval).
      592            if  waitfram-check-timeout()
      593            then do:
      594               leave block-wait.
      595            end.
      596         end.
      597         run waitfram-hide.
      598      end.
      599   procedure waitfram-join :
      600     define input  parameter p-line-1  as character no-undo .
      601     define input  parameter p-line-2  as character no-undo .
      602     define input  parameter p-line-3  as character no-undo .
      603     define output parameter p-message as character no-undo .
      604     do
      605     on error undo, return error return-value
      606     :
      607       assign
      608         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      609                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      610                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      611       .
      612     end.
      613   end procedure.
      614   function waitfram-join-function returns character
      615     (input p-line-1 as character
      616     ,input p-line-2 as character
      617     ,input p-line-3 as character
      618     ).
      619     define variable v-message as character no-undo .
      620     run waitfram-join in this-procedure
      621       (input  p-line-1
      622       ,input  p-line-2
      623       ,input  p-line-3
      624       ,output v-message
      625       ) .
      626     return v-message .
      627   end function .
