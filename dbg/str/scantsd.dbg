       76   define variable vss-revision    as character no-undo initial "$Revision: e5fbdeab5909, 1547, rls $":U .
       77   define variable vss-author      as character no-undo initial "$Author: ASMorozov $":U .
       78   define variable vss-date        as character no-undo initial "$Date: Tue Oct 09 19:01:47 2018 +0300 $":U .
       79   define variable vss-workfile    as character no-undo initial "$Workfile: scantsd.p $":U .
       80   define variable vss-archive     as character no-undo initial "$Archive: str/scantsd.p $":U .
