     1042             vartransport-rubl-old  = ub.doc-line.transport-rubl
     1043             varother-rubl-old      = ub.doc-line.other-rubl.
     1044          end.
     1045          else mode-create = yes.
     1046   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-scn in g#lib-trn
     1047     ( input  parparentproc
     1048      ,input  recid(t-doc)
     1049      ,input  bar-code.b-code
     1050      ,input  decimal(qnty-str) * rate
     1051      ,input  is-all
     1052      ,input  add-sens
     1053      ,input  line-mode
     1054      ,output tempmess
     1055      ,output g-log-char
     1056     ) no-error .
     1057          assign
     1058          mess = mess + tempmess.
     1059          if error-status:error then do:
     1060            assign
     1061            mess = mess + return-value.
     1062            put stream err unformatted bar-str "," qnty-str skip.
     1063            put stream log unformatted "***" mess " - ошибка" skip.
     1064            put stream ler unformatted "***" mess " - ошибка" skip.
     1065            return error.
     1066          end.
     1067          else do:
     1068            put stream log unformatted mess " - успешно" skip.
     1069            if pl-str <> "" then run store-place in this-procedure ( input pl-str
     1070                                                                    ,input parscales-pref
     1071                                                                    ,input parpgscales-pref
     1072                                                                    ).
     1073            j = j + 1.
     1074            disp j with frame a.
     1075          end.
     1076          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
     1077                                    ub.doc-line.artic     = ub.goods.artic     and
     1078                                    ub.doc-line.prod-type = ub.goods.prod-type and
     1079                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
     1080          if t-doc.doc-type = 'при':U then do:
     1081            if mode-create then do:
     1082   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     1083     (
     1084      input parparentproc
     1085     ,input recid(doc-line)
     1086     ,input t-doc.doc-code
     1087     ,input ub.doc-line.artic
     1088     ,input ub.doc-line.prod-type
     1089     ,input ub.doc-line.prod-code
     1090     ,input 0
     1091     ,input 0
     1092     ,input 0
     1093     ,input 0
     1094     ,input 0
     1095     ,input 0
     1096     ,input 0
     1097     ,input 0
     1098     ,input 0
     1099     ,input 0
     1100     ,input 0
     1101     ,input 0
     1102     ,input 0
     1103     ,input 'create'
