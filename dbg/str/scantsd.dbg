     1137       if substring(g-log-char, 1, 4) = "qnty" then do:
     1138             put stream err unformatted bar-str "," ENTRY(2, g-log-char, "=") skip.
     1139             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
     1140             put stream ler unformatted "***" mess " - не все количество зарезервировано" skip.
     1141       end.
     1142     end.
     1143   end.
     1144   os-delete value (scan-txt).
     1145   end procedure.
     1146   procedure store-place:
     1147   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
     1148   define input parameter parscales-pref as character no-undo.
     1149   define input parameter parpgscales-pref as character no-undo.
     1150   define variable pl-c as int no-undo.
     1151   define variable varres        as logical         no-undo.
     1152   define variable var-code-temp like ub.place.pl-code no-undo.
     1153   define variable varresult   as character       no-undo.
     1154   define variable vartype-bc  as character       no-undo.
     1155   define variable varweight   as decimal         no-undo.
     1156   define buffer pc-goods for ub.goods.
     1157   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1158   (
     1159    input  parparentproc
     1160   ,input  pl-str
     1161   ,input  ?
     1162   ,input  v-cntxt-obj-type
     1163   ,input  v-cntxt-obj-code
     1164   ,input  yes
     1165   ,input  no
     1166   ,input  parscales-pref
     1167   ,input  parpgscales-pref
     1168   ,output varresult
     1169   ,output vartype-bc
     1170   ,output varweight
     1171   ,buffer ub.bar-code
     1172   ,buffer ub.prod-bc
     1173   ,buffer ub.place
     1174   ) no-error.
     1175   if error-status:error then do:
     1176     return error "Ошибка при разборе бар-кода: " + pl-str.
     1177   end.
     1178   if available place then do:
     1179     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
     1180     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
     1181     RUN plgdsfnd (input  no,
     1182                   input  v-cntxt-obj-type,
     1183                   input  v-cntxt-obj-code,
     1184                   input  pc-goods.gds-code,
     1185                   output varres,
     1186                   output var-code-temp) no-error.
     1187     if varres = yes or error-status:error then do:
     1188         put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
     1189             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     1190             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
     1191         put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
     1192             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     1193             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
     1194         put stream err unformatted bar-str "," qnty-str "," pl-str skip.
     1195     end.
     1196     else
     1197     for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
     1198                      and ub.parts.obj-code  = v-cntxt-obj-code
     1199                      and ub.parts.artic     = pc-goods.artic
     1200                      and ub.parts.prod-type = pc-goods.prod-type
     1201                      and ub.parts.prod-code = pc-goods.prod-code
     1202                      and ub.parts.in-code   = ub.bar-code.in-code
     1203                      and ub.parts.part-code = ub.bar-code.part-code:
     1204       if ub.parts.rsrv-free or
     1205          ub.parts.out-code = t-doc.doc-code then ub.parts.pl-code = ub.place.pl-code.
     1206     end.
     1207   end.
     1208   end procedure.
     1209   procedure plgdsfnd :
     1210     define input  parameter p-chk-and-chs    as logical               no-undo .
     1211     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1212     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1213     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1214     define output parameter p-reserv-pl-code as   logical             no-undo .
     1215     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1216     define buffer buf_goods         for ub.goods .
     1217     define buffer buf_pl-gds        for ub.pl-gds .
     1218     define buffer buf_second_pl-gds for ub.pl-gds .
     1219     find first buf_goods no-lock where
     1220                buf_goods.gds-code = p-gds-code no-error .
     1221     if not available buf_goods
     1222     then do:
     1223       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1224     end.
     1225   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1227     (input  p-obj-type
     1228     ,input  p-obj-code
     1229     ,input  buf_goods.artic
     1230     ,input  buf_goods.prod-type
     1231     ,input  buf_goods.prod-code
     1232     ,input  'place-rsrv=request'
     1233     ,output p-reserv-pl-code
     1234     ) no-error .
     1235     if error-status :error
     1236     then do:
     1237       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1238     end.
     1239     if p-reserv-pl-code = no
     1240     then do:
     1241       return .
     1242     end.
     1243     if p-chk-and-chs <> yes
     1244     then do:
     1245       return .
     1246     end.
     1247     find first buf_pl-gds no-lock where
     1248                buf_pl-gds.obj-type = p-obj-type and
     1249                buf_pl-gds.obj-code = p-obj-code and
     1250                buf_pl-gds.gds-code = p-gds-code no-error .
     1251     if not available buf_pl-gds
     1252     then do:
     1253       return error "К товару не привязано ни одного места хранения" .
     1254     end.
     1255     find first buf_second_pl-gds no-lock where
     1256                buf_second_pl-gds.obj-type  = p-obj-type          and
     1257                buf_second_pl-gds.obj-code  = p-obj-code          and
     1258                buf_second_pl-gds.gds-code  = p-gds-code          and
     1259                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1260     if not available buf_second_pl-gds
     1261     then do:
     1262       assign
     1263         p-pl-code = buf_pl-gds.pl-code
     1264       .
     1265     end.
     1266     else do:
     1267       run str/plgdssel.p
     1268         (
     1269            input parparentproc
     1270         ,  input p-obj-type
     1271         ,  input p-obj-code
     1272         ,  input p-gds-code
     1273         , output p-pl-code
     1274         ) no-error .
     1275       if error-status :error
     1276       then do:
     1277         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1278                                , 'plgdssel.p':U
     1279                                , chr(10)
     1280                                , error-status :get-message( 1 )
     1281                                , return-value
     1282                                ) .
     1283       end.
     1284       if p-pl-code = ? or
     1285          p-pl-code = 0
     1286       then do:
     1287         return error "Не выбрано место хранения " + chr(10) .
     1288       end.
     1289     end.
     1290   end procedure.
     1291     assign
     1292       v-pri-nakl- = false
     1293       v-silent    = true
     1294       v-first-del = false
     1295     .
     1296     case v-num :
     1297       when 1 then do:
     1298         assign is-all = yes.
     1299       end.
     1300       when 2 then do:
     1301         assign is-all = no.
     1302       end.
     1303       when 3 then do:
     1304         assign is-all = ?.
     1305       end.
     1306       when 4 then do:
     1307         if v-pri-nakl- = true then do:
     1308           assign
     1309             is-all = yes
     1310             v-first-del = true
     1311           .
     1312         end.
     1313         else do:
     1314           return error.
     1315         end.
     1316       end.
     1317       otherwise do:
     1318         return error.
     1319       end.
     1320     end case.
     1321   scan-name = "scantsd".
     1322   frame a :title = "Разбор таблицы бар-кодов".
     1323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1324     (input  'noapndsc'
     1325     ,input  0
     1326     ,input  ''
     1327     ,input  0
     1328     ,input  ''
     1329     ,input  ''
     1330     ,input  ''
     1331     ,input  no
     1332     ,output varnoapnd
     1333     ,output vartype
     1334     ) no-error .
     1335   if varnoapnd = "yes":u then do:
     1336     output stream log to value (scan-name + ".log").
     1337     output stream err to value (scan-name + ".err").
     1338     output stream ler to value (scan-name + ".ler").
     1339   end.
     1340   else do:
     1341     output stream log to value (scan-name + ".log") append.
     1342     output stream err to value (scan-name + ".err") append.
     1343     output stream ler to value (scan-name + ".ler") append.
     1344   end.
     1345   put stream log unformatted "  " skip.
     1346   put stream log unformatted cur-time-string-sec() skip.
     1347   put stream ler unformatted "  " skip.
     1348   put stream ler unformatted cur-time-string-sec() skip.
     1349   if add-sens = ? then
     1350     put stream log unformatted " " skip skip "Привязка партий к складским местам.  Объект : " v-cntxt-obj-type " " string (v-cntxt-obj-code) skip skip.
     1351   else do:
     1352     put stream log unformatted " " skip skip "Накладная: " t-doc.doc-code
     1353           " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " t-doc.status_ " ОК: " string (t-doc.flag_, "+/-") skip skip.
     1354     put stream ler unformatted " " skip skip "Накладная: " t-doc.doc-code
     1355           " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " t-doc.status_ " ОК: " string (t-doc.flag_, "+/-") skip skip.
     1356     find first doc-line where doc-line.doc-code = t-doc.doc-code no-lock no-error.
     1357     if available doc-line then do:
     1358       find goods where goods.artic = doc-line.artic
     1359                    and goods.prod-type = doc-line.prod-type
     1360                    and goods.prod-code = doc-line.prod-code no-lock.
     1361       g-type =  goods.gds-type.
     1362     end.
     1363   end.
     1364   view frame a.
     1365   if t-doc.doc-type = 'инв':U and
     1366      t-doc.status_  = 'разрешен':U and
     1367      add-sens       = ?            then do:
     1368     return.
     1369   end.
     1370   if t-doc.doc-type = 'инв':U and
     1371      t-doc.status_  = 'разрешен':U then do:
     1372     put stream log unformatted " " skip skip "!!! Инвентаризация: " t-doc.doc-code
     1373           " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1374   end.
     1375   else do:
     1376     put stream log unformatted " " skip skip "!!! Складской документ: " t-doc.doc-code
     1377           " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1378   end.
     1379   for each un-bc on error undo, return error return-value :
     1380       delete un-bc.
     1381   end.
     1382   run str/bc-anlz.p (parParentProc , "table", string(temp-table TempDocLineIsTSD:handle), yes, output varerr, output table in-bc) no-error.
     1383   if error-status:error then do:
     1384      message "Ошибка при обработке файла." skip
     1385              error-status:get-message(1)
     1386         view-as alert-box error buttons ok.
     1387      return error.
     1388   end.
     1389   if varerr = yes then is-err = yes.
     1390   define variable vari    as integer no-undo.
     1391   define variable vartime as integer no-undo.
     1392   run waitfram-show in this-procedure ("Записываем результат разбора файла в log-файл.").
     1393   assign
     1394     vari    = 0.
     1395     vartime = time.
     1396   for each in-bc on error undo, return error return-value :
     1397       assign
     1398         vari = vari + 1.
     1399       run waitfram-show in this-procedure (substitute("Записываем ошибки разбора в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1400       if in-bc.rez = "err" then do:
     1401          put stream log unformatted in-bc.err-msg skip.
     1402          put stream ler unformatted in-bc.err-msg skip.
     1403          put stream err unformatted in-bc.bar-str skip.
     1404          assign is-err = yes.
     1405       end.
     1406       if in-bc.des <> "" and in-bc.des <> ? then put stream log unformatted in-bc.des.
     1407   end.
     1408   for each un-bc on error undo, return error return-value :
     1409       assign
     1410         vari = vari + 1.
     1411       run waitfram-show in this-procedure (substitute("Записываем ошибки разбора  в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1412       if un-bc.rez = "err" then do:
     1413          put stream log unformatted un-bc.err-msg skip.
     1414          put stream ler unformatted un-bc.err-msg skip.
     1415          put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1416          assign is-err = yes.
     1417       end.
     1418   end.
     1419   if v-first-del = true then do:
     1420     for each bb_doc-line
     1421       where bb_doc-line.doc-code = t-doc.doc-code
     1422     on error undo, return error return-value
     1423     :
     1424       delete bb_doc-line .
     1425     end.
     1426   end.
     1427   if t-doc.doc-type = 'при':U
     1428     and t-doc.status_  = 'накл':U
     1429     and t-doc.flag_    = yes
     1430   then do:
     1431     run waitfram-show in this-procedure ("Строим таблицу сравнения по загруженой информации из файла.").
     1432     for each bb_doc-line where bb_doc-line.doc-code = t-doc.doc-code no-lock on error undo, return error return-value :
     1433       find first bb_goods where bb_goods.artic     = bb_doc-line.artic     and
     1434                                 bb_goods.prod-type = bb_doc-line.prod-type and
     1435                                 bb_goods.prod-code = bb_doc-line.prod-code no-lock.
     1436       find first bb_gds-prt where bb_gds-prt.upper-code = bb_goods.prt-root no-lock.
     1437       if bb_gds-prt.node-name = '_Пустая шкала':U then do:
     1438         find first bb_bar-code where bb_bar-code.gds-code  = bb_goods.gds-code    and
     1439                                      bb_bar-code.node-code = bb_gds-prt.node-code and
     1440                                      bb_bar-code.part-code = ""                   and
     1441                                      bb_bar-code.in-code   = ""                   and
     1442                                      bb_bar-code.unit-cli  = bb_goods.unit-base   no-lock.
     1443         create tt-bar-code-doc.
     1444         assign
     1445           tt-bar-code-doc.b-c      = bb_bar-code.b-code
     1446           tt-bar-code-doc.scn-qnty = bb_doc-line.doc-qnty.
     1447         create tt-bar-code-ne.
     1448         assign
     1449           tt-bar-code-ne.nm            = 0
     1450           tt-bar-code-ne.mark          = "d"
     1451           tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1452           tt-bar-code-ne.scn-qnty-doc  = bb_doc-line.doc-qnty
     1453           tt-bar-code-ne.scn-qnty-file = 0
     1454           tt-bar-code-ne.artic         = bb_goods.artic
     1455           tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1456           tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1457           tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1458           tt-bar-code-ne.node-name     = "--------------------"
     1459           tt-bar-code-ne.in-code       = ""
     1460           tt-bar-code-ne.part-code     = "".
     1461       end.
     1462       else do:
     1463         for each bb_gds-dtl where bb_gds-dtl.doc-code  = bb_doc-line.doc-code  and
     1464                                   bb_gds-dtl.artic     = bb_doc-line.artic     and
     1465                                   bb_gds-dtl.prod-type = bb_doc-line.prod-type and
     1466                                   bb_gds-dtl.prod-code = bb_doc-line.prod-code no-lock on error undo, return error return-value :
     1467            find first bb_gds-prt where bb_gds-prt.node-code = bb_gds-dtl.prt-code no-lock.
     1468            find first bb_bar-code where bb_bar-code.gds-code  = bb_goods.gds-code    and
     1469                                         bb_bar-code.node-code = bb_gds-prt.node-code and
     1470                                         bb_bar-code.part-code = ""                   and
     1471                                         bb_bar-code.in-code   = ""                   and
     1472                                         bb_bar-code.unit-cli  = bb_goods.unit-base   no-lock.
     1473            create tt-bar-code-doc.
     1474            assign
     1475              tt-bar-code-doc.b-c      = bb_bar-code.b-code
     1476              tt-bar-code-doc.scn-qnty = bb_doc-line.doc-qnty.
     1477            create tt-bar-code-ne.
     1478            assign
     1479              tt-bar-code-ne.nm            = 0
     1480              tt-bar-code-ne.mark          = "d"
     1481              tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1482              tt-bar-code-ne.scn-qnty-doc  = bb_gds-dtl.doc-qnty
     1483              tt-bar-code-ne.scn-qnty-file = 0
     1484              tt-bar-code-ne.artic         = bb_goods.artic
     1485              tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1486              tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1487              tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1488              tt-bar-code-ne.node-name     = bb_gds-prt.node-name
     1489              tt-bar-code-ne.in-code       = ""
     1490              tt-bar-code-ne.part-code     = "".
     1491         end.
     1492       end.
     1493     end.
     1494     assign
     1495       varanlz = yes.
     1496     for each main-bc on error undo, return error return-value :
     1497       if main-bc.scn-pl <> "" then do:
     1498         assign
     1499           varanlz = no.
     1500       end.
     1501       find first bb_bar-code where bb_bar-code.b-code = main-bc.b-c no-lock.
     1502       if bb_bar-code.in-code   <> "" or
     1503          bb_bar-code.part-code <> "" then do:
     1504          message "В файле экспорте есть бар-код, cоответствующий бар-коду партии " bb_bar-code.b-code " ." skip
     1505                  "По данному бар-коду невозможно произвести сравнительный анализ. Он будет выведен отдельной строкой в таблицу анализа."
     1506          view-as alert-box.
     1507       end.
     1508       find first tt-bar-code-ne where tt-bar-code-ne.b-c = bb_bar-code.b-code no-error.
     1509       if not available tt-bar-code-ne then do:
     1510         find first bb_goods where bb_goods.gds-code = bb_bar-code.gds-code no-lock.
     1511         find first bb_gds-prt where bb_gds-prt.upper-code = bb_goods.prt-root no-lock.
     1512         create tt-bar-code-ne.
     1513         if bb_gds-prt.node-name = '_Пустая шкала':U then do:
     1514           assign
     1515             tt-bar-code-ne.nm            = -1
     1516             tt-bar-code-ne.mark          = (if bb_bar-code.in-code <> "" or bb_bar-code.part-code <> "" then "?" else "f")
     1517             tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1518             tt-bar-code-ne.scn-qnty-doc  = 0
     1519             tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty
     1520             tt-bar-code-ne.artic         = bb_goods.artic
     1521             tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1522             tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1523             tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1524             tt-bar-code-ne.node-name     = "------------------"
     1525             tt-bar-code-ne.in-code       = bb_bar-code.in-code
     1526             tt-bar-code-ne.part-code     = bb_bar-code.part-code.
     1527         end.
     1528         else do:
     1529           find first bb_gds-prt where bb_gds-prt.node-code = bb_bar-code.node-code no-lock.
     1530           assign
     1531             tt-bar-code-ne.nm            = main-bc.nm
     1532             tt-bar-code-ne.mark          = (if bb_bar-code.in-code <> "" or bb_bar-code.part-code <> "" then "?" else "f")
     1533             tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1534             tt-bar-code-ne.scn-qnty-doc  = 0
     1535             tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty
     1536             tt-bar-code-ne.artic         = bb_goods.artic
     1537             tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1538             tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1539             tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1540             tt-bar-code-ne.node-name     = bb_gds-prt.node-name
     1541             tt-bar-code-ne.in-code       = bb_bar-code.in-code
     1542             tt-bar-code-ne.part-code     = bb_bar-code.part-code.
     1543         end.
     1544       end.
     1545       else do:
     1546         assign
     1547           tt-bar-code-ne.nm            = main-bc.nm
     1548           tt-bar-code-ne.mark          = (if tt-bar-code-ne.scn-qnty-doc = main-bc.scn-qnty then "" else (if tt-bar-code-ne.scn-qnty-doc > main-bc.scn-qnty then "<" else ">"))
     1549           tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty.
     1550       end.
     1551     end.
     1552     if varanlz = yes then do:
     1553     end.
     1554   end.
     1555   run waitfram-hide in this-procedure.
     1556   assign
     1557     i    = 0
     1558     j    = 0
     1559     .
     1560   define buffer buf_gds-obj for ub.gds-obj  .
     1561   find first buf_gds-obj no-lock where
     1562              buf_gds-obj.obj-type = t-doc.obj-type and
     1563              buf_gds-obj.obj-code = t-doc.obj-code and
     1564              buf_gds-obj.gds-code = goods.gds-code no-error .
     1565   if available buf_gds-obj and buf_gds-obj.cash-parts then do:
     1566   for each anlz-bc on error undo, return error return-value :
     1567     i = i + 1.
     1568     display i with frame a.
     1569     find first bar-code where bar-code.b-code   = anlz-bc.b-c        no-lock.
     1570     find first goods    where goods.gds-code    = bar-code.gds-code  no-lock.
     1571     assign bar-str  = string( anlz-bc.b-c)
     1572            qnty-str = string( anlz-bc.scn-qnty)
     1573            rate     = 1
     1574            pl-str   = anlz-bc.scn-pl
     1575            mess     = anlz-bc.des.
     1576     find first tt-bar-code-doc where tt-bar-code-doc.b-c = anlz-bc.b-c.
     1577     run proc-code in this-procedure (input anlz-bc.scn-pl
     1578                                     ,input (if anlz-bc.rez = "place" then "place" else if p-action = "rsvmarks" then p-action else "")
     1579                                     ,input varscales-pref
     1580                                     ,input varpgscales-pref
     1581                                     ) no-error.
     1582     if error-status:error then do:
     1583        assign is-err = yes.
     1584     end.
     1585     else do:
     1586       assign
     1587         j = j + 1.
     1588       display j with frame a.
     1589     end.
     1590   end.
     1591   end.
     1592   else do:
     1593   for each main-bc on error undo, return error return-value :
     1594     i = i + 1.
     1595     display i with frame a.
     1596     find first bar-code where bar-code.b-code   = main-bc.b-c        no-lock.
     1597     find first goods    where goods.gds-code    = bar-code.gds-code  no-lock.
     1598   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1599     (
     1600        input goods.artic
     1601     ,  input goods.prod-type
     1602     ,  input goods.prod-code
     1603     , output varis-petrolium
     1604     , output varis-pieces
     1605     ) .
     1606     find first gds-prt  where gds-prt.node-code = bar-code.node-code no-lock.
     1607     if gds-prt.is-term <> yes then do:
     1608       put stream log unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1609       put stream ler unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1610       put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1611       assign is-err = yes.
     1612       next.
     1613     end.
     1614     assign bar-str  = string(main-bc.b-c)
     1615            qnty-str = string(main-bc.scn-qnty)
     1616            rate     = 1
     1617            pl-str   = main-bc.scn-pl
     1618            mess     = main-bc.des.
     1619     run proc-code in this-procedure (input main-bc.scn-pl
     1620                                     ,input (if main-bc.rez = "place" then "place" else if p-action = "rsvmarks" then p-action else "")
     1621                                     ,input varscales-pref
     1622                                     ,input varpgscales-pref
     1623                                     ) no-error.
     1624     if error-status:error then do:
     1625        assign is-err = yes.
     1626     end.
     1627     else do:
     1628       assign
     1629         j = j + 1.
     1630       display j with frame a.
     1631     end.
     1632   end.
     1633   end.
     1634   output stream log close.
     1635   output stream err close.
     1636   output stream ler close.
     1637   output stream cur close.
     1638   run gbl/calc-trn.p (  this-procedure , recid(t-doc)) no-error .
     1639   if error-status :error then
     1640   do:
     1641     undo, return error substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     1642   end.
     1643   if t-doc.doc-type = 'инв':U then do:
     1644     run str/clcsumga.p ( input t-doc.doc-code ).
     1645     if error-status :error then
     1646     do:
     1647       undo, return error substitute(" Ошибка пересчета документа &1 &2" , error-status :get-message(1)  , return-value) .
     1648     end.
     1649   end.
     1650   if is-err then do:
     1651   end.
     1652   procedure mainmenu_getcntxt :
     1653   define output parameter p-cntxt-db-num                as integer   no-undo .
     1654   define output parameter p-cntxt-userid                as character no-undo .
     1655   define output parameter p-cntxt-level                 as character no-undo .
     1656   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     1657   define output parameter p-cntxt-obj-type              as character no-undo .
     1658   define output parameter p-cntxt-obj-code              as integer   no-undo .
     1659   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     1660   define output parameter p-cntxt-is-admin              as logical   no-undo .
     1661     do
     1662     on error undo, return error return-value
     1663     :
     1664   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1666     (input  vt-obj-type
     1667     ,input  vt-obj-code
     1668     ,output p-cntxt-db-num-obj
     1669     )  .
     1670     assign
     1671       p-cntxt-db-num          =  v-cntxt-db-num
     1672       p-cntxt-userid          =  v-cntxt-userid
     1673       p-cntxt-level           =  v-cntxt-level
     1674       p-cntxt-host-code-obj   =  vt-host-code
     1675       p-cntxt-obj-type        =  vt-obj-type
     1676       p-cntxt-obj-code        =  vt-obj-code
     1677       p-cntxt-is-admin        =  v-cntxt-is-admin
     1678     .
     1679     end.
     1680    end procedure.
     1681    procedure get-report-num :
     1682   define output parameter p-report-num as integer no-undo .
     1683     do
     1684     on error undo, return error return-value
     1685     :
     1686       run gbl/getrpnum.p (output p-report-num).
     1687     end.
     1688   end procedure.
     1689   procedure get-db-num:
     1690     define output parameter pDbNum as integer no-undo.
     1691     pDbNum = v-cntxt-db-num.
     1692   end.
     1693   procedure get-userid:
     1694     define output parameter pUserId as character no-undo.
     1695     assign
     1696       pUserId  = v-cntxt-userid
     1697       .
     1698   end.
