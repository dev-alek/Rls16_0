     3025   procedure xml-cd-write-header:
     3026   do
     3027   on error undo, return error
     3028   :
     3029   define input parameter p-xml-file-name       as character    no-undo.
     3030   define input parameter p-xml-file-name-path  as character    no-undo.
     3031   define input parameter p-doc-name            as character    no-undo.
     3032   define input parameter p-version             as character    no-undo.
     3033   define input parameter p-obj-list            as character    no-undo.
     3034   define input parameter p-correspondent       as character    no-undo .
     3035   define input parameter p-write-header        as logical      no-undo .
     3036   define variable OS-time as character no-undo .
     3037   define variable id as character no-undo .
     3038   define buffer buf_db for ub.db.
     3039   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3040   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3041   assign
     3042   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3043   .
     3044   run bgelib-tag-open in this-procedure (
     3045                                        1
     3046                                       ,p-doc-name
     3047                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3048                                         ).
     3049   if p-write-header then do:
     3050     run bgelib-tag-open(2, "Header","").
     3051     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3052     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3053     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3054     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3055     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3056     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3057     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3058     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3059     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3060     run bgelib-tag-close( 2, "Header" ).
     3061   end.
     3062   output stream stmXMLOut close.
     3063   end.
     3064   end procedure.
     3065   procedure xml-cd-write-footer:
     3066   do
     3067   on error undo, return error
     3068   :
     3069   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3070   define input parameter p-xml-file-name as character    no-undo.
     3071   define input parameter p-doc-name      as character    no-undo .
     3072   define variable v-error-num     as integer           no-undo.
     3073   define variable v-md5-signature as character no-undo .
     3074   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3075   run bgelib-tag-close( 0, p-doc-name ).
     3076   put stream stmXMLOut unformatted skip.
     3077   output stream stmXMLOut close.
     3078   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3079   if v-error-num > 0
     3080   then do:
     3081      return error.
     3082   end.
     3083   if opsys = "unix"
     3084   then do:
     3085       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3086   end.
     3087   end.
     3088   end procedure.
     3089   procedure xml-cd-filename :
     3090   do
     3091   on error undo, return error
     3092   :
     3093   define input parameter  p-out               as character no-undo .
     3094   define output parameter p-xml-file-name     as character    no-undo.
     3095   define output parameter p-xml-file-name-path   as character    no-undo.
     3096   define output parameter p-log-file-name     as character    no-undo.
     3097   define output parameter p-locked            as logical      no-undo.
     3098   define variable v-out as character     no-undo.
     3099   define variable loc#log as logical no-undo .
     3100   define variable BadFlag as logical no-undo .
     3101   define variable fq as integer no-undo .
     3102   define variable v-remote as character no-undo .
     3103   assign
     3104   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3105   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3106   p-log-file-name = p-out + "actions.log"
     3107   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3108   .
     3109   end.
     3110   end procedure.
     3111   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3112   define variable v-date-str as character no-undo .
     3113   assign
     3114   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3115                string(Month(p-date), "99":U) + "-":U +
     3116                string(DAY(p-date), "99":U).
     3117   return v-date-str.
     3118   END FUNCTION.
     3119   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3120   define variable v-date-str as character no-undo .
     3121   assign
     3122   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3123                string(Month(p-date), "99":U) + "-":U +
     3124                string(DAY(p-date), "99":U) + chr(32) +
     3125                string(p-time, "HH:MM:SS").
     3126   return v-date-str.
     3127   END FUNCTION.
     3128   function string-to-date returns date ( input p-string  as character):
     3129     define variable v-date as date no-undo .
     3130     assign
     3131     v-date = date(integer(substring(p-string, 4, 2))
     3132                   ,integer(substring(p-string, 1, 2))
     3133                   ,integer(substring(p-string, 7, 4))
     3134                  ) no-error .
     3135     if error-status:error then return ?.
     3136     return v-date.
     3137   END FUNCTION.
     3138   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3139   define variable v-time as integer no-undo init ?.
     3140   define variable v-dop1 as character no-undo .
     3141   define variable v-dop2 as character no-undo .
     3142   assign
     3143   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3144   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3145   no-error .
     3146   if error-status:error then return ?.
     3147   assign
     3148   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3149             integer(entry(2, v-dop2, ";":U)) * 60 +
     3150             integer(entry(3, v-dop2, ";":U)) no-error .
     3151   return v-time.
     3152   END FUNCTION.
     3153   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3154   procedure gdcstcod_cst-code :
     3155     define input  parameter p-obj-type  as character no-undo .
     3156     define input  parameter p-obj-code  as integer   no-undo .
     3157     define input  parameter p-gds-code  as integer   no-undo .
     3158     define input  parameter p-in-code   as character no-undo .
     3159     define input  parameter p-part-code as character no-undo .
     3160     define output parameter p-cst-code  as character no-undo .
     3161     define buffer buf_goods for ub.goods .
     3162     define buffer buf_parts for ub.parts .
     3163     do
     3164     on error undo, return error return-value
     3165     :
     3166       assign
     3167         p-cst-code = ''
     3168       .
     3169       find first buf_goods no-lock
     3170         where buf_goods.gds-code = p-gds-code
     3171         no-error .
     3172       if not available buf_goods
     3173       then do:
     3174         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3175       end.
     3176       if p-in-code = ?
     3177       then do:
     3178         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3179       end.
     3180       if p-part-code = ?
     3181       then do:
     3182         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3183       end.
     3184       if p-in-code = '':u
     3185       then do:
     3186         find first buf_parts no-lock
     3187           where buf_parts.obj-type  = p-obj-type
     3188             and buf_parts.obj-code  = p-obj-code
     3189             and buf_parts.artic     = buf_goods.artic
     3190             and buf_parts.prod-type = buf_goods.prod-type
     3191             and buf_parts.prod-code = buf_goods.prod-code
     3192             and buf_parts.out-code  = 'free-zone':U
     3193             and buf_parts.status_   = false
     3194           no-error .
     3195         if available buf_parts
     3196         then do:
     3197           assign
     3198             p-cst-code = buf_parts.cst-code
     3199           .
     3200         end.
     3201       end.
     3202       else do:
     3203         find first buf_parts no-lock
     3204           where buf_parts.obj-type  = p-obj-type
     3205             and buf_parts.obj-code  = p-obj-code
     3206             and buf_parts.artic     = buf_goods.artic
     3207             and buf_parts.prod-type = buf_goods.prod-type
     3208             and buf_parts.prod-code = buf_goods.prod-code
     3209             and buf_parts.out-code  = 'free-zone':U
     3210             and buf_parts.in-code   = p-in-code
     3211             and buf_parts.part-code = p-part-code
     3212           no-error .
     3213         if available buf_parts
     3214         then do:
     3215           assign
     3216             p-cst-code = buf_parts.cst-code
     3217           .
     3218         end.
     3219       end.
     3220     end.
     3221   end procedure.
