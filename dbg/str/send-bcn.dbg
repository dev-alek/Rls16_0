    12861   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12862   define variable v-found105 as logical no-undo .
    12863   define variable v-is-script105 as logical no-undo.
    12864   define variable v-fields-shift105 as integer no-undo .
    12865      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    12866      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    12867      then do:
    12868        v-fields-shift105 = - 1.
    12869   if v-record <> '':U then
    12870       run maria-put in this-procedure (
    12871                                       buffer for-cash-desk
    12872                                     , input out
    12873                                     , input fname
    12874                                     , input yes
    12875                                     , input v-fields-shift105
    12876                                     , input yes
    12877                                     , input 24
    12878                                     , input 1
    12879                                     , input string(1)
    12880                                     , input v-record
    12881                                       ).
    12882      end.
    12883   find first temp-tekka-tsk no-error.
    12884   if available temp-tekka-tsk then do:
    12885      v-found105 = yes.
    12886   end.
    12887   if v-found105 = yes then do:
    12888   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    12889   v-is-script105 = no.
    12890   for each temp-tekka-tsk:
    12891     if (temp-tekka-tsk.num-rec > 0
    12892     or temp-tekka-tsk.send-get = 'task')
    12893     and temp-tekka-tsk.task-num = fname then do:
    12894       export stream IBmSTREAM temp-tekka-tsk.
    12895       v-found105 = yes.
    12896     end.
    12897     if temp-tekka-tsk.is-script then do:
    12898       v-is-script105 = yes.
    12899     end.
    12900     delete temp-tekka-tsk.
    12901   end.
    12902   output stream IBMStream
    12903   close.
    12904   run write-log-and-file in p-log-handle (
    12905         input 1
    12906       , input log-file-name
    12907       , input 1
    12908       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
    12909                           , (out + fname)
    12910                           , chr(10)
    12911                           , (out + fname + '.tsk')
    12912                           )
    12913                                          ).
