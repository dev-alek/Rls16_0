     1849   define stream stmXMLLog.
     1850   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   procedure cur-time :
     1852      define output parameter p-today as date      no-undo .
     1853      define output parameter p-time  as integer   no-undo .
     1854     do
     1855     on error undo, return error
     1856     :
     1857       define variable v-date1 as date      no-undo .
     1858       define variable v-date2 as date      no-undo .
     1859       define variable v-time  as integer   no-undo .
     1860       assign
     1861         v-date1 = today
     1862         v-time  = time
     1863         v-date2 = today
     1864       .
     1865       if v-date1 <> v-date2
     1866       then do:
     1867         assign
     1868           v-date1 = today
     1869           v-time  = v-time
     1870         .
     1871       end.
     1872       assign
     1873         p-today = v-date1
     1874         p-time  = v-time
     1875       .
     1876     end.
     1877   end.
     1878   function cur-time-date returns character
     1879   :
     1880     return string(today, '99/99/9999':U) .
     1881   end.
     1882   function cur-time-mjd returns decimal
     1883   :
     1884     define variable v-date as date      no-undo .
     1885     define variable v-time as integer   no-undo .
     1886     run cur-time in this-procedure
     1887       (output v-date
     1888       ,output v-time
     1889       ) .
     1890     return integer(v-date) - 2400002 + (v-time / 86400) .
     1891   end.
     1892   function cur-time-get-ending-index returns integer
     1893   (input p-number as integer
     1894   )
     1895   :
     1896     if p-number < 0
     1897     or p-number = ?
     1898     then do:
     1899       return 1 .
     1900     end.
     1901     define variable v-rest as integer   no-undo .
     1902     assign
     1903       p-number = p-number modulo 100
     1904     .
     1905     if p-number < 20
     1906     then do:
     1907       assign
     1908         v-rest = p-number
     1909       .
     1910     end.
     1911     else do:
     1912       assign
     1913         v-rest = p-number modulo 10
     1914       .
     1915     end.
     1916     case v-rest :
     1917       when 1
     1918       then do:
     1919         return 2 .
     1920       end.
     1921       when 2 or
     1922       when 3 or
     1923       when 4
     1924       then do:
     1925         return 3 .
     1926       end.
     1927       otherwise do:
     1928         return 1 .
     1929       end.
     1930     end case .
     1931   end.
     1932   procedure cur-time-mjd-to-date :
     1933      define input  parameter i-mjd-diff as decimal no-undo.
     1934      define output parameter o-Date     as date    no-undo.
     1935      define output parameter o-Time     as integer no-undo.
     1936      define variable v-day-number as integer   no-undo .
     1937      if    i-mjd-diff < 0
     1938         or i-mjd-diff = ?
     1939      then do:
     1940         return "?" .
     1941      end.
     1942      assign
     1943         v-day-number = truncate(i-mjd-diff,0).
     1944         o-Date = date(v-day-number + 2400002).
     1945         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1946     .
     1947   end.
     1948   function cur-time-mjd-to-string returns character
     1949   (input p-mjd-diff as decimal
     1950   )
     1951   :
     1952     define variable v-day-number as integer   no-undo .
     1953     define variable v-seconds    as integer   no-undo .
     1954     define variable v-hour       as integer   no-undo .
     1955     define variable v-min        as integer   no-undo .
     1956     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1957     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1958     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1959     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1960     if p-mjd-diff < 0
     1961     or p-mjd-diff = ?
     1962     then do:
     1963       return "?" .
     1964     end.
     1965     assign
     1966       v-day-number = integer(truncate(p-mjd-diff,0))
     1967       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1968     .
     1969     if v-seconds > 86400
     1970     then do:
     1971       assign
     1972         v-seconds = 86400 - 1
     1973       .
     1974     end.
     1975     if v-seconds < 0
     1976     then do:
     1977       assign
     1978         v-seconds = 0
     1979       .
     1980     end.
     1981     assign
     1982       v-hour = truncate(v-seconds / 3600, 0)
     1983     .
     1984     assign
     1985       v-seconds = v-seconds modulo 3600
     1986     .
     1987     assign
     1988       v-min = truncate(v-seconds / 60, 0)
     1989     .
     1990     assign
     1991       v-seconds = v-seconds modulo 60
     1992     .
     1993     return
     1994         (if v-day-number <> 0
     1995           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1996           else ""
     1997         )
     1998       + (if v-day-number <> 0 or v-hour <> 0
     1999           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2000           else ""
     2001         )
     2002       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2003           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2004           else ""
     2005         )
     2006       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2007       .
     2008   end.
     2009   function cur-time-string returns character
     2010   :
     2011     define variable v-date as date      no-undo .
     2012     define variable v-time as integer   no-undo .
     2013     run cur-time in this-procedure
     2014       (output v-date
     2015       ,output v-time
     2016       ) .
     2017     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2018   end.
     2019   function cur-time-string-sec returns character
     2020   :
     2021     define variable v-date as date      no-undo .
     2022     define variable v-time as integer   no-undo .
     2023     run cur-time in this-procedure
     2024       (output v-date
     2025       ,output v-time
     2026       ) .
     2027     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2028   end.
     2029   function cur-time-custom  returns character
     2030   (input p-prefix as character
     2031   ,input p-date-format as character
     2032   ,input p-delimiter as character
     2033   ,input p-time-format as character
     2034   ,input p-suffix as character
     2035   )
     2036   :
     2037     define variable v-date as date      no-undo .
     2038     define variable v-time as integer   no-undo .
     2039     run cur-time in this-procedure
     2040       (output v-date
     2041       ,output v-time
     2042       ) .
     2043     return
     2044       p-prefix
     2045       + string(v-date, p-date-format)
     2046       + p-delimiter
     2047       + string(v-time, p-time-format)
     2048       + p-suffix
     2049       .
     2050   end.
     2051   function cur-time-print  returns character
     2052   :
     2053     define variable v-date as date      no-undo .
     2054     define variable v-time as integer   no-undo .
     2055     run cur-time in this-procedure
     2056       (output v-date
     2057       ,output v-time
     2058       ) .
     2059     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2060   end.
     2061   function cur-time-datetime returns datetime
     2062   :
     2063     define variable v-char as character no-undo .
     2064     define variable v-datetime as datetime no-undo .
     2065     v-char = cur-time-string().
     2066     v-datetime = datetime(v-char).
     2067     return  v-datetime.
     2068   end.
     2069   function cur-time-string-msec returns character
     2070   :
     2071     define variable v-date as datetime  no-undo .
     2072     v-date = now.
     2073     return string(v-date) .
     2074   end.
     2075   define variable vss-include-info26 as character format "X(65)" no-undo
     2076   initial "@(#)$Workfile$ $Revision$".
     2077   procedure xmlchar-test :
     2078   define input parameter p-in-string          as character        no-undo.
     2079   define output parameter p-out-string-enc    as character        no-undo.
     2080   define output parameter p-out-string-dec    as character        no-undo.
     2081   do
     2082   on error undo, return error
     2083   :
     2084          run xmlchar-encode in this-procedure
     2085       (
