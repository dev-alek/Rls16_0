     9902           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
     9903                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
     9904                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
     9905                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
     9906                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
     9907                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
     9908                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
     9909           .
     9910           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
     9911           assign
     9912           temp-disc-dec = 0
     9913           temp-disc-reason = 0
     9914           temp-disc-weekday = 0
     9915           temp-disc-time-start = 0
     9916           temp-disc-time-end = 0
