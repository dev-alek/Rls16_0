     8614                                     , ub.goods.prod-code
     8615                                     , prichina
     8616                                     )
     8617                                         ).
     8618               assign
     8619               v-view-log = yes
     8620               .
     8621               if (g#news or g#esys or g#auto) and return-value <> "error" then do:
     8622                 return error prichina.
     8623               end.
     8624               else if not (g#news or g#esys or g#auto) then do:
     8625                   error-status:error = no.
     8626                   return.
     8627               end.
     8628           end.
     8629           if return-value = "error" then do:
     8630             run write-log-and-file in p-log-handle (
     8631                   input 1
