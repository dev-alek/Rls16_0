    12847                                       , input yes
    12848                                       , input 0
    12849                                       , input no
    12850                                       , input 6
    12851                                       , input 5000
    12852                                       , input v-plu
    12853                                       , input (if cash-gds.grp-code = 0
    12854                                                then '001'
    12855                                                else string(cash-gds.grp-code, "999"))).
    12856       end.
    12857     end.
    12858   end.
    12859     end.
