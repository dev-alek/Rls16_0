     2096   procedure xmlchar-encode :
     2097   define input parameter p-in-string      as character        no-undo.
     2098   define output parameter p-out-string    as character        no-undo.
     2099       define variable v-position      as integer      no-undo.
     2100       define variable v-current-char  as character    no-undo.
     2101   do
     2102   on error undo, return error
     2103   :
     2104       assign
     2105           p-out-string = "":U
     2106       .
     2107       case p-in-string
     2108       :
     2109           when ?
     2110           then do:
     2111               assign
     2112                   p-out-string = "?":U
     2113               .
     2114           end.
     2115           when "?":U
     2116           then do:
     2117               assign
     2118                   p-out-string = "&#63;":U
     2119               .
     2120           end.
     2121           otherwise do:
     2122               do v-position = 1 to length( p-in-string )
     2123               :
     2124                   assign
     2125                       v-current-char = substring( p-in-string, v-position, 1 )
     2126                   .
     2127                   case v-current-char
     2128                   :
     2129                       when "&":U
     2130                       then do:
     2131                           assign
     2132                               p-out-string = p-out-string + "&amp;":U
     2133                           .
     2134                       end.
     2135                       when ">":U
     2136                       then do:
     2137                           assign
     2138                               p-out-string = p-out-string + "&gt;":U
     2139                           .
     2140                       end.
     2141                       when "<":U
     2142                       then do:
     2143                           assign
     2144                               p-out-string = p-out-string + "&lt;":U
     2145                           .
     2146                       end.
     2147                       when "'":U
     2148                       then do:
     2149                           assign
     2150                               p-out-string = p-out-string + "&apos;":U
     2151                           .
     2152                       end.
     2153                       when '"':U
     2154                       then do:
     2155                           assign
     2156                               p-out-string = p-out-string + "&quot;":U
     2157                           .
     2158                       end.
     2159                       when chr(1)
     2160                       then do:
     2161                           assign
     2162                               p-out-string = p-out-string + "":U
     2163                           .
     2164                       end.
     2165                       when chr(2)
     2166                       then do:
     2167                           assign
     2168                               p-out-string = p-out-string + "":U
     2169                           .
     2170                       end.
     2171                       when chr(3)
     2172                       then do:
     2173                           assign
     2174                               p-out-string = p-out-string + "":U
     2175                           .
     2176                       end.
     2177                       when chr(4)
     2178                       then do:
     2179                           assign
     2180                               p-out-string = p-out-string + "":U
     2181                           .
     2182                       end.
     2183                       when chr(5)
     2184                       then do:
     2185                           assign
     2186                               p-out-string = p-out-string + "":U
     2187                           .
     2188                       end.
     2189                       when chr(6)
     2190                       then do:
     2191                           assign
     2192                               p-out-string = p-out-string + "":U
     2193                           .
     2194                       end.
     2195                       when chr(7)
     2196                       then do:
     2197                           assign
     2198                               p-out-string = p-out-string + "":U
     2199                           .
     2200                       end.
     2201                       when chr(8)
     2202                       then do:
     2203                           assign
     2204                               p-out-string = p-out-string + "":U
     2205                           .
     2206                       end.
     2207                       when chr(9)
     2208                       then do:
     2209                           assign
     2210                               p-out-string = p-out-string + "":U
     2211                           .
     2212                       end.
     2213                       when chr(29)
     2214                       then do:
     2215                           assign
     2216                               p-out-string = p-out-string + "":U
     2217                           .
     2218                       end.
     2219                       when chr(10)
     2220                       then do:
     2221                           assign
     2222                               p-out-string = p-out-string + "&#10;":U
     2223                           .
     2224                       end.
     2225                       when chr(13)
     2226                       then do:
     2227                           assign
     2228                               p-out-string = p-out-string + "&#13;":U
     2229                           .
     2230                       end.
     2231                       otherwise do:
     2232                           assign
     2233                               p-out-string = p-out-string + v-current-char
     2234                           .
     2235                       end.
     2236                   end case.
     2237               end.
     2238           end.
     2239       end case.
     2240   end.
     2241   end .
     2242   procedure xmlchar-encode-1c :
     2243   define input parameter p-in-string      as character        no-undo.
     2244   define output parameter p-out-string    as character        no-undo.
     2245       define variable v-position      as integer      no-undo.
     2246       define variable v-current-char  as character    no-undo.
     2247   do
     2248   on error undo, return error
     2249   :
     2250       assign
     2251           p-out-string = "":U
     2252       .
     2253       case p-in-string
     2254       :
     2255           when ?
     2256           then do:
     2257               assign
     2258                   p-out-string = "?":U
     2259               .
     2260           end.
     2261           otherwise do:
     2262               do v-position = 1 to length( p-in-string )
     2263               :
     2264                   assign
     2265                       v-current-char = substring( p-in-string, v-position, 1 )
     2266                   .
     2267                   case v-current-char
     2268                   :
     2269                       when chr(1)
     2270                       then do:
     2271                           assign
     2272                               p-out-string = p-out-string + " ":U
     2273                           .
     2274                       end.
     2275                       when chr(2)
     2276                       then do:
     2277                           assign
     2278                               p-out-string = p-out-string + " ":U
     2279                           .
     2280                       end.
     2281                       when chr(3)
     2282                       then do:
     2283                           assign
     2284                               p-out-string = p-out-string + " ":U
     2285                           .
     2286                       end.
     2287                       when chr(4)
     2288                       then do:
     2289                           assign
     2290                               p-out-string = p-out-string + " ":U
     2291                           .
     2292                       end.
     2293                       when chr(5)
     2294                       then do:
     2295                           assign
     2296                               p-out-string = p-out-string + " ":U
     2297                           .
     2298                       end.
     2299                       when chr(6)
     2300                       then do:
     2301                           assign
     2302                               p-out-string = p-out-string + " ":U
     2303                           .
     2304                       end.
     2305                       when chr(7)
     2306                       then do:
     2307                           assign
     2308                               p-out-string = p-out-string + " ":U
     2309                           .
     2310                       end.
     2311                       when chr(8)
     2312                       then do:
     2313                           assign
     2314                               p-out-string = p-out-string + " ":U
     2315                           .
     2316                       end.
     2317                       when chr(9)
     2318                       then do:
     2319                           assign
     2320                               p-out-string = p-out-string + " ":U
     2321                           .
     2322                       end.
     2323                       when chr(29)
     2324                       then do:
     2325                           assign
     2326                               p-out-string = p-out-string + " ":U
     2327                           .
     2328                       end.
     2329                       when chr(10)
     2330                       then do:
     2331                           assign
     2332                               p-out-string = p-out-string + " ":U
     2333                           .
     2334                       end.
     2335                       when chr(13)
     2336                       then do:
     2337                           assign
     2338                               p-out-string = p-out-string + " ":U
     2339                           .
     2340                       end.
     2341                       otherwise do:
     2342                           assign
     2343                               p-out-string = p-out-string + v-current-char
     2344                           .
     2345                       end.
     2346                   end case.
     2347               end.
     2348           end.
     2349       end case.
     2350   end.
     2351   end .
     2352   procedure xmlchar-decode :
     2353   define input parameter p-in-string      as character        no-undo.
     2354   define output parameter p-out-string    as character        no-undo.
     2355       define variable v-position      as integer      no-undo.
     2356       define variable v-last-position as integer      no-undo.
     2357       define variable v-temp-integer  as integer      no-undo.
     2358       define variable v-current-char  as character    no-undo.
     2359       define variable v-next-char     as character    no-undo.
     2360       define variable v-success       as logical      no-undo.
     2361   do
     2362   on error undo, return error
     2363   :
     2364       assign
     2365           p-out-string = "":U
     2366           v-position   = 0
     2367       .
     2368       replace-cycle:
     2369       do while yes
     2370       on error undo, return error
     2371       :
     2372           assign
     2373               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2374           .
     2375           if v-last-position <= v-position
     2376           then do:
     2377               if v-position = 0
     2378               then do:
     2379                   assign
     2380                       p-out-string = p-in-string
     2381                   .
     2382               end.
     2383               else do:
     2384                   assign
     2385                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2386                   .
     2387               end.
     2388               leave replace-cycle.
     2389           end.
     2390           else do:
     2391               assign
     2392                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2393                   v-position      = v-last-position
     2394                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2395               .
     2396               if v-current-char = "#":U
     2397               then do:
     2398                   assign
     2399                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2400                   .
     2401                   if v-last-position > 0
     2402                   then do:
     2403                       run xmlchar-read-integer in this-procedure
     2404                        (
     2405                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2406                           , output v-temp-integer
     2407                           , output v-success
     2408                       ).
     2409                       if v-success = yes
     2410                       and v-temp-integer >= 1
     2411                       and v-temp-integer <= 255
     2412                       then do:
     2413                           assign
     2414                               p-out-string = p-out-string + chr( v-temp-integer )
     2415                               v-position   = v-last-position + 1
     2416                           .
     2417                       end.
     2418                       else do:
     2419                           assign
     2420                               p-out-string = p-out-string + "&":U
     2421                               v-position   = v-position   + 1
     2422                           .
     2423                       end.
     2424                   end.
     2425                   else do:
     2426                       assign
     2427                           p-out-string = p-out-string + "&":U
     2428                           v-position   = v-position   + 1
     2429                       .
     2430                   end.
     2431               end.
     2432               else do:
     2433                   case substring( p-in-string, v-position + 1, 3 )
     2434                   :
     2435                       when "lt;":U
     2436                       then do:
     2437                           assign
     2438                               p-out-string = p-out-string + "<":U
     2439                               v-position   = v-position   + 3
     2440                           .
     2441                       end.
     2442                       when "gt;":U
     2443                       then do:
     2444                           assign
     2445                               p-out-string = p-out-string + ">":U
     2446                               v-position   = v-position   + 3
     2447                           .
     2448                       end.
     2449                       otherwise do:
     2450                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2451                           then do:
     2452                               assign
     2453                                   p-out-string = p-out-string + "&":U
     2454                                   v-position   = v-position   + 4
     2455                               .
     2456                           end.
     2457                           else do:
     2458                               case substring( p-in-string, v-position + 1, 5 )
     2459                               :
     2460                                   when "quot;":U
     2461                                   then do:
     2462                                       assign
     2463                                           p-out-string = p-out-string + '"':U
     2464                                           v-position   = v-position   + 5
     2465                                       .
     2466                                   end.
     2467                                   when "apos;":U
     2468                                   then do:
     2469                                       assign
     2470                                           p-out-string = p-out-string + "'":U
     2471                                           v-position   = v-position   + 5
     2472                                       .
     2473                                   end.
     2474                                   otherwise do:
     2475                                       assign
     2476                                           p-out-string = p-out-string + "&":U
     2477                                       .
     2478                                   end.
     2479                               end case.
     2480                           end.
     2481                       end.
     2482                   end case.
     2483               end.
     2484           end.
     2485       end.
     2486   end.
     2487   end .
     2488   procedure xmlchar-read-integer :
     2489   define input parameter p-input-string      as character        no-undo.
     2490   define output parameter p-output-integer   as integer          no-undo.
     2491   define output parameter p-success       as logical          no-undo.
     2492   do
     2493   on error undo, return error
     2494   :
     2495       assign
     2496           p-output-integer = integer( p-input-string )
     2497       no-error.
     2498       if error-status :error
     2499       then do:
     2500           assign
     2501               p-success           = no
     2502               p-output-integer    = 0
     2503           .
     2504       end.
     2505       else do:
     2506           assign
     2507               p-success           = yes
     2508           .
     2509       end.
     2510   end.
     2511   end.
     2512   define variable v-bgelib-bgeclall           as logical      no-undo.
     2513   define variable v-bgelib-bgedict            as logical      no-undo.
     2514   define temp-table temp_ext-doc-type no-undo
     2515       field edt-key               as integer
     2516       field ext-doc-type          as character
     2517       field ext-doc-type-label    as character
     2518       index pi is primary unique
     2519           edt-key
     2520   .
     2521   define temp-table temp_bgelib_goods no-undo
     2522       field gds-code as integer
     2523       index pi is primary unique
     2524           gds-code
     2525   .
     2526   define temp-table temp_bgelib_clients no-undo
     2527       field obj-type as character
     2528       field obj-code as integer
     2529       index pi is primary unique
     2530           obj-type
     2531           obj-code
     2532   .
     2533   define temp-table temp_bgelib_dis-card no-undo
     2534       field d-card as character
     2535       index pi is primary unique
     2536           d-card
     2537   .
     2538   define temp-table temp_bgelib_trn-doc no-undo
     2539       field doc-code as integer
     2540   .
     2541   procedure bgelib-tag-open:
     2542   do
     2543   on error undo, return error
     2544   :
     2545   define input parameter v-tag-level  as integer      no-undo.
     2546   define input parameter v-tag-name   as character    no-undo.
     2547   define input parameter v-tag-value  as character    no-undo.
     2548       put stream stmXMLOut unformatted
     2549           chr(10)
     2550           + fill(" ", 4 * v-tag-level)
     2551           + "<" + v-tag-name
     2552           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2553           + v-tag-value + ">"
     2554       .
     2555   end.
     2556   end procedure.
     2557   procedure bgelib-tag-put:
     2558   do
     2559   on error undo, return error
     2560   :
     2561   define input parameter v-tag-level      as integer      no-undo.
     2562   define input parameter v-tag-name       as character    no-undo.
     2563   define input parameter v-tag-value      as character    no-undo.
     2564   define input parameter v-empty-mode     as integer      no-undo.
     2565       v-tag-name = trim(v-tag-name).
     2566       if  v-empty-mode = 1
     2567       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2568       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2569       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2570       then do:
     2571           run xmlchar-encode in this-procedure (
     2572                 input v-tag-value
     2573               , output v-tag-value
     2574           ).
     2575           put stream stmXMLOut unformatted
     2576               chr(10) + fill(" ", 4 * v-tag-level)
     2577                           + '<' + v-tag-name + '>'
     2578                           + v-tag-value
     2579                           + '</' + v-tag-name + '>'
     2580           .
     2581       end.
     2582   end.
     2583   end procedure.
     2584   procedure bgelib-tag-close:
     2585   do
     2586   on error undo, return error
     2587   :
     2588   define input parameter v-tag-level as integer      no-undo.
     2589   define input parameter v-tag-name  as character    no-undo.
     2590       put stream stmXMLOut unformatted
     2591           chr(10)
     2592           + fill( " ", 4 * v-tag-level)
     2593           + '</' + v-tag-name + '>'
     2594       .
     2595   end.
     2596   end procedure.
     2597   procedure bgelib-write-log:
     2598   do
     2599   on error undo, return error
     2600   :
     2601   define input parameter v-filename   as character    no-undo.
     2602   define input parameter v-log-level  as integer      no-undo.
     2603   define input parameter v-out-string as character    no-undo.
     2604       output stream stmXMLLog to value( v-filename ) append.
     2605       put stream stmXMLLog unformatted
     2606           chr(10)
     2607       .
     2608       put stream stmXMLLog unformatted
     2609           ( if v-log-level = 0
     2610             or v-out-string = "&DLine"
     2611             or v-out-string = "&Line"
     2612             then ""
     2613             else cur-time-string-sec() + " " )
     2614       .
     2615       put stream stmXMLLog unformatted
     2616           ( if v-out-string = "&Line"
     2617             then fill( "-", 80 )
     2618             else if v-out-string = "&DLine"
     2619                  then fill( "=", 80 )
     2620                  else v-out-string )
     2621       .
     2622       output stream stmXMLLog close.
     2623   end.
     2624   end procedure.
     2625   procedure bgelib-write-edt:
     2626   do
     2627   on error undo, return error
     2628   :
     2629   define input parameter v-editor-handle    as handle       no-undo.
     2630   define input parameter v-log-level        as integer      no-undo.
     2631   define input parameter v-out-string       as character    no-undo.
     2632       if valid-handle ( v-editor-handle )
     2633       then do:
     2634           v-editor-handle :move-to-eof().
     2635           v-editor-handle :insert-string( ( if v-log-level = 0
     2636                                             or v-out-string = "&DLine"
     2637                                             or v-out-string = "&Line"
     2638                                             then ""
     2639                                             else cur-time-string-sec() + " "
     2640                                         ) ).
     2641           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2642                                             then fill( "-", 80 )
     2643                                             else if v-out-string = "&DLine" then fill("=", 80)
     2644                                             else fill( " ", v-log-level) + v-out-string
     2645                                         ) ).
     2646           v-editor-handle :insert-string( chr(10) ).
     2647       end.
     2648       process events.
     2649       output to 'bgescn.txt' append.
     2650           put unformatted
     2651               chr(10)
     2652               string( ( if v-log-level = 0
     2653                         or v-out-string = "&DLine"
     2654                         or v-out-string = "&Line"
     2655                         then ""
     2656                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2657                     ) )
     2658               string( ( if v-out-string = "&Line"
     2659                         then fill( "-", 80 )
     2660                         else if v-out-string = "&DLine"
     2661                              then fill( "=", 80 )
     2662                              else fill( " ", v-log-level ) + v-out-string
     2663                     ) )
     2664           .
     2665       output close.
     2666   end.
     2667   end procedure.
     2668   procedure bgelib-show-cnt:
     2669   do
     2670   on error undo, return error
     2671   :
     2672   define input parameter v-fillin-handle     as handle   no-undo.
     2673       if valid-handle( v-fillin-handle )
     2674       then do:
     2675           assign
     2676               v-fillin-handle :visible = true
     2677           .
     2678       end.
     2679   end.
     2680   end procedure.
     2681   procedure bgelib-hide-cnt:
     2682   do
     2683   on error undo, return error
     2684   :
     2685   define input parameter v-fillin-handle     as handle   no-undo.
     2686       if valid-handle( v-fillin-handle )
     2687       then do:
     2688           assign v-fillin-handle :visible = false.
     2689       end.
     2690   end.
     2691   end procedure.
     2692   procedure bgelib-write-cnt:
     2693   do
     2694   on error undo, return error
     2695   :
     2696   define input parameter v-fillin-handle    as handle       no-undo.
     2697   define input parameter v-fillin-string    as character    no-undo.
     2698       if valid-handle( v-fillin-handle )
     2699       then do:
     2700           assign
     2701               v-fillin-handle :SCREEN-value = v-fillin-string
     2702           .
     2703       end.
     2704   end.
     2705   end procedure.
     2706   procedure bgelib-write-header:
     2707   do
     2708   on error undo, return error
     2709   :
     2710   define input parameter p-first-file     as logical      no-undo.
     2711   define input parameter p-xml-file-name  as character    no-undo.
     2712   define input parameter p-list-file-name as character    no-undo.
     2713   define input parameter p-file-number    as integer      no-undo.
     2714   define input parameter p-have-prev      as logical      no-undo.
     2715   define input parameter p-prev-filename  as character    no-undo.
     2716   define input parameter p-obj-list       as character    no-undo.
     2717   define input parameter p-doc-type-list  as character    no-undo.
     2718   define input parameter p-parameter-list as character    no-undo.
     2719       define variable v-counter    as integer        no-undo.
     2720       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2721       put stream stmXMLOut unformatted
     2722           "<?xml version='1.0' encoding='windows-1251'?>"
     2723       .
     2724       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2725       run bgelib-tag-open( input 0, input "header", input "" ).
     2726       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2727       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2728       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2729       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2730       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2731       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2732       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2733       :
     2734           run bgelib-tag-put(
     2735                 input 1
     2736               , input entry( 2 * v-counter, p-parameter-list )
     2737               , input entry( 2 * v-counter + 1, p-parameter-list )
     2738               , input 0
     2739           ).
     2740       end.
     2741       run bgelib-tag-close( input 0, input "header" ).
     2742       output stream stmXMLOut close.
     2743       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2744       if p-first-file = yes
     2745       then do:
     2746           put stream stmXMLOut unformatted
     2747               "<?xml version='1.0' encoding='windows-1251'?>"
     2748           .
     2749           run bgelib-tag-open( input 0, input "export", input "" ).
     2750       end.
     2751       run bgelib-tag-open( input 1, input "file", input "" ).
     2752       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2753       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2754       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2755       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2756       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2757       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2758       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2759       :
     2760           run bgelib-tag-put(
     2761                 input 2
     2762               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2763               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2764               , input 0
     2765           ).
     2766       end.
     2767       run bgelib-tag-close( input 1, input "file" ).
     2768       output stream stmXMLOut close.
     2769   end.
     2770   end procedure.
     2771   procedure bgelib-write-footer:
     2772   do
     2773   on error undo, return error
     2774   :
     2775   define input parameter p-last-file      as logical      no-undo.
     2776   define input parameter p-xml-file-name  as character    no-undo.
     2777   define input parameter p-list-file-name as character    no-undo.
     2778   define input parameter p-have-next      as logical      no-undo.
     2779   define input parameter p-next-file-name as character    no-undo.
     2780       define variable v-error-num     as integer           no-undo.
     2781       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2782       if p-have-next = yes
     2783       then do:
     2784           run bgelib-tag-open( input 0, input "footer", "" ).
     2785           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2786           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2787           run bgelib-tag-close( input 0, input "footer" ).
     2788       end.
     2789       run bgelib-tag-close( input 0, input "root" ).
     2790       output stream stmXMLOut close.
     2791       run bge/os_copy.p (
     2792             input "M"
     2793           , input p-xml-file-name + "tmp"
     2794           , input p-xml-file-name + "xml"
     2795           , output v-error-num
     2796       ).
     2797       if p-last-file = yes
     2798       then do:
     2799           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2800               run bgelib-tag-close( input 0, input "export" ).
     2801           output stream stmXMLOut close.
     2802           run bge/os_copy.p (
     2803                 input "M"
     2804               , input p-list-file-name + "tmp"
     2805               , input p-list-file-name + "xml"
     2806               , output v-error-num
     2807           ).
     2808       end.
     2809   end.
     2810   end procedure.
     2811   procedure bgelib-filename :
     2812   do
     2813   on error undo, return error
     2814   :
     2815   define input parameter p-prefix             as character    no-undo.
     2816   define output parameter p-xml-file-name     as character    no-undo.
     2817   define output parameter p-log-file-name     as character    no-undo.
     2818   define output parameter p-list-file-name    as character    no-undo.
     2819       define variable v-home-dir  as character    no-undo.
     2820       define variable v-error-num as integer      no-undo.
     2821       get-key-value section "BGE" key "outdir" value v-home-dir.
     2822       if v-home-dir = ?
     2823       then do:
     2824           message
     2825             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2826             skip(1)
     2827             skip "Обратитесь к администратору."
     2828           view-as alert-box error.
     2829           undo, return error .
     2830       end.
     2831       run gbl/dir-cre.p (
     2832           input v-home-dir
     2833       ) no-error.
     2834       if error-status :error
     2835       then do:
     2836           message
     2837             skip "Неверно задан каталог экспорта."
     2838             skip(1)
     2839             skip "Обратитесь к администратору."
     2840           view-as alert-box error.
     2841           undo, return error .
     2842       end.
     2843       run bge/genfname.p (
     2844             input v-home-dir
     2845           , input p-prefix
     2846           , input ""
     2847           , input "xml"
     2848           , input "tmp"
     2849           , output p-xml-file-name
     2850       ).
     2851       assign
     2852           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2853           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2854           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2855       .
     2856   end.
     2857   end procedure.
     2858   procedure bgelib-read-config :
     2859   do
     2860   on error undo, return error
     2861   :
     2862   define variable v-par-type as character     no-undo.
     2863     define variable v-param-type      as character  no-undo .
     2864     define variable v-value-character as character  no-undo .
     2865     define variable v-value-date      as date       no-undo .
     2866     define variable v-value-decimal   as decimal    no-undo .
     2867     define variable v-value-integer   as integer    no-undo .
     2868     define variable v-value-logical   as logical    no-undo .
     2869     define variable v-tth             as handle     no-undo .
     2870       assign
     2871           v-bgelib-bgeclall = no
     2872           v-bgelib-bgedict  = no
     2873       .
     2874       run adm/shattri.p ( input "get":U
     2875                         , input  '':u
     2876                         , input  0
     2877                         , input  'bge-export':U
     2878                         , input  'bgeclall':U
     2879                         , output v-value-character
     2880                         , output v-value-date
     2881                         , output v-value-decimal
     2882                         , output v-value-integer
     2883                         , output v-value-logical
     2884                         , output v-param-type
     2885                         , input-output table-handle v-tth
     2886                         ) no-error .
     2887       if error-status :error
     2888       then do:
     2889         assign
     2890           v-bgelib-bgeclall = no
     2891         .
     2892       end.
     2893       else do:
     2894         assign
     2895           v-bgelib-bgeclall = v-value-logical
     2896         .
     2897       end.
     2898       delete object v-tth.
     2899       run adm/shattri.p ( input "get":U
     2900                         , input  '':u
     2901                         , input  0
     2902                         , input  'bge-export':U
     2903                         , input  'bgedict':U
     2904                         , output v-value-character
     2905                         , output v-value-date
     2906                         , output v-value-decimal
     2907                         , output v-value-integer
     2908                         , output v-value-logical
     2909                         , output v-param-type
     2910                         , input-output table-handle v-tth
     2911                         ) no-error .
     2912       if error-status :error
     2913       then do:
     2914         assign
     2915           v-bgelib-bgedict = no
     2916         .
     2917       end.
     2918       else do:
     2919         assign
     2920           v-bgelib-bgedict = v-value-logical
     2921         .
     2922       end.
     2923       delete object v-tth.
     2924       run adm/shattri.p ( input "get":U
     2925                         , input  '':u
     2926                         , input  0
     2927                         , input  'bge-export':U
     2928                         , input  'bgefmt':U
     2929                         , output v-value-character
     2930                         , output v-value-date
     2931                         , output v-value-decimal
     2932                         , output v-value-integer
     2933                         , output v-value-logical
     2934                         , output v-param-type
     2935                         , input-output table-handle v-tth
     2936                         ) no-error .
     2937       if error-status :error
     2938       then do:
     2939         assign
     2940           v-bgelib-bgefmt  = "xml":U
     2941         .
     2942       end.
     2943       else do:
     2944         assign
     2945           v-bgelib-bgefmt  = v-value-character
     2946         .
     2947       end.
     2948       delete object v-tth.
     2949       run adm/shattri.p ( input "get":U
     2950                         , input  '':u
     2951                         , input  0
     2952                         , input  'bge-export':U
     2953                         , input  'bgeflold':U
     2954                         , output v-value-character
     2955                         , output v-value-date
     2956                         , output v-value-decimal
     2957                         , output v-value-integer
     2958                         , output v-value-logical
     2959                         , output v-param-type
     2960                         , input-output table-handle v-tth
     2961                         ) no-error .
     2962       if error-status :error
     2963       then do:
     2964         assign
     2965           v-bgelib-bgeflold  = "old":U
     2966         .
     2967       end.
     2968       else do:
     2969         assign
     2970           v-bgelib-bgeflold  = v-value-character
     2971         .
     2972       end.
     2973       delete object v-tth.
     2974   end.
     2975   end procedure.
     2976   procedure bgelib-check-file-size :
     2977   do
     2978   on error undo, return error
     2979   :
     2980   define input parameter p-out-filename   as character    no-undo.
     2981   define output parameter p-is-big        as logical      no-undo.
     2982       define variable v-current-position    as integer        no-undo.
     2983       assign
     2984           v-current-position = seek( stmXMLOut )
     2985       .
     2986       if v-current-position / 1024 / 1024  >= 100
     2987       then do:
     2988           assign
     2989               p-is-big = yes
     2990           .
     2991       end.
     2992   end.
     2993   end procedure.
     2994   procedure bgelib-init-ext-doc-type :
     2995       define variable v-counter    as integer      no-undo.
     2996       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2997   do
     2998   for buf_temp_ext-doc-type
     2999   on error undo, return error
     3000   :
     3001       empty temp-table buf_temp_ext-doc-type.
     3002       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3003       :
     3004           create buf_temp_ext-doc-type.
     3005           assign
     3006               buf_temp_ext-doc-type.edt-key               = v-counter
     3007               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3008               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3009           .
     3010       end.
     3011   end.
     3012   end procedure.
     3013   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3014   define variable v-xml-file-name     as character            no-undo.
     3015   define variable v-xml-file-name-path as character            no-undo.
     3016   define variable v-log-file-name     as character            no-undo.
     3017   define variable v-locked            as logical              no-undo.
     3018   define variable v-log-string        as character            no-undo.
     3019   define variable v-oper-num          as integer              no-undo.
     3020   define variable v-obj-list          as character            no-undo.
     3021   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3022   DEF VAR intRep      AS INT NO-UNDO.
     3023   define variable hEDT             AS HANDLE NO-UNDO.
