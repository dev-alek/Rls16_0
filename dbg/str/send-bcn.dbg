     3259   procedure alienini-getkey :
     3260   define input parameter i-filename as char.
     3261   define input parameter i-section as char.
     3262   define input parameter i-key as char.
     3263   define output parameter o-value as char.
     3264   define variable EntryPointer as integer no-undo.
     3265   define variable mem1 as memptr no-undo.
     3266   define variable mem2 as memptr no-undo.
     3267   define variable mem1size as integer no-undo.
     3268   define variable mem2size as integer no-undo.
     3269   define variable ii       as integer    no-undo.
     3270   define variable cbReturnSize  as integer    no-undo.
     3271   assign
     3272   set-size(mem1)  = 4000
     3273   mem1size = 4000.
     3274   if i-key = "" then EntryPointer = 0.
     3275   else do:
     3276     assign
     3277     set-size(mem2) = 128
     3278     mem2size = 128
     3279     EntryPointer = get-pointer-value(mem2)
     3280     put-string(mem2, 1) = i-key.
     3281   end.
     3282   run getprivateprofilestringA
     3283                                 (i-section,
     3284                                  EntryPointer,
     3285                                  "",
     3286                                  get-pointer-value(mem1),
     3287                                  input mem1size,
     3288                                  i-filename,
     3289                                  output cbReturnSize).
     3290   do ii = 1 to cbReturnSize:
     3291     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3292                  then o-value + ","
     3293                  else o-value + chr(get-byte(mem1, ii)).
     3294   end.
     3295     set-size(mem1) = 0.
     3296     set-size(mem2) = 0.
     3297   end procedure.
     3298   procedure alienini-putkey :
     3299   define input parameter i-filename as char.
     3300   define input parameter i-section as char.
     3301   define input parameter i-key as char.
     3302   define input parameter i-value as char.
     3303   define variable cbReturnSize as integer.
     3304   run writeprivateprofilestringA
     3305                                  (i-section,
     3306                                   i-key,
     3307                                   i-value,
     3308                                   i-filename,
     3309                                   output cbReturnSize ).
     3310   end procedure.
     3311   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3312     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3313     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3314     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3315     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3316     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3317     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3318     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3319   END PROCEDURE.
     3320   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3321     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3322     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3323     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3324     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3325     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3326   END PROCEDURE.
     3327   define   temp-table temp-tekka-tsk no-undo
     3328   field filename      as character
     3329   field obj-num       as integer
     3330   field obj-name      as character
     3331   field num-records   as integer
     3332   field max-records   as integer
     3333   field min-plu       as integer
     3334   field max-plu       as integer
     3335   field num-fields    as integer
     3336   field task-num      as character
     3337   field by-record     as logical
     3338   field send-get      as character
     3339   field cash-num      as integer
     3340   field cash-num-char as character
     3341   field port-num      as character
     3342   field way           as character
     3343   field is-script     as logical
     3344   field pswd          as character
     3345   field waiting-sek   as integer
     3346   field other-info    as character
     3347   field order-num     as integer
     3348   field secondary     as integer
     3349   field shift-fields  as integer
     3350   field binary        as logical
     3351   field range         as integer
     3352   index pi is unique primary
     3353   filename
     3354   range
     3355   index lpi
     3356   filename
     3357   min-plu
     3358   index gpi
     3359   filename
     3360   max-plu
     3361   index iorder
     3362   order-num
     3363   .
     3364   define   temp-table temp-tekka-schema no-undo
     3365   field obj-num as integer
     3366   field obj-name as character
     3367   field field-num as integer
     3368   field field-name as character
     3369   field num-records as integer
     3370   field size_ as integer
     3371   field host as character
     3372   field progress-type as character
     3373   field custom-type as character
     3374   field start-pos as integer
     3375   field end-pos as integer
     3376   field bin-group as character
     3377   index pi is unique primary
     3378   host obj-num field-num
     3379   .
     3380   define temp-table temp-tekka-record no-undo
     3381   field obj-num as integer
     3382   field plu as integer
     3383   field body as character
     3384   field shift as integer
     3385   index pi is unique primary obj-num plu.
     3386   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3387   define variable v-is-closed-shift-journal as integer no-undo .
     3388   assign
     3389   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3390                               +
     3391                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3392                               +
     3393                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3394   .
     3395   return v-is-closed-shift-journal.
     3396   END FUNCTION.
     3397   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3398   define variable v-is-first-journal as logical no-undo .
     3399   assign
     3400   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3401                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3402                     or (p-journal-num =  integer(entry(1, '17':U)))
     3403                     or (p-journal-num = integer(entry(1, '16':U)))
     3404   .
     3405   return v-is-first-journal.
     3406   END FUNCTION.
     3407   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3408   define variable v-is-petrol-journal as logical no-undo .
     3409   assign
     3410   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3411   return v-is-petrol-journal.
     3412   END FUNCTION.
     3413   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3414   define variable v-max-record-num as integer no-undo .
     3415   assign
     3416   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3417                       then 1489
     3418                       else 2340).
     3419   return v-max-record-num.
     3420   END FUNCTION.
     3421   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3422   define variable v-max-record-num as integer no-undo .
     3423   assign
     3424   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3425                       then 1489 * num-entries('30,31,32,33':U)
     3426                       else 2340 * num-entries('17':U)).
     3427   return v-max-record-num.
     3428   END FUNCTION.
     3429   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3430                                           ,input p-rec-no as integer):
     3431   define variable v-num-recs as integer no-undo .
     3432   if tekka-is-petrol-journal (p-journal-num) then do:
     3433     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3434       assign
     3435       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3436       .
     3437     end.
     3438     else do:
     3439       assign
     3440       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3441       .
     3442     end.
     3443   end.
     3444   else do:
     3445     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3446       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3447         assign
     3448         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3449         .
     3450       end.
     3451       else do:
     3452         assign
     3453         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3454         .
     3455       end.
     3456     end.
     3457     else do:
     3458       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3459         assign
     3460         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3461         .
     3462       end.
     3463       else do:
     3464         assign
     3465         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3466         .
     3467       end.
     3468     end.
     3469   end.
     3470   return v-num-recs.
     3471   END FUNCTION.
     3472   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3473                                              ,input p-is-petrol as logical
     3474                                              ,input p-is-current as logical
     3475                                              ,output p-rec-no as decimal
     3476                                              ):
     3477   define variable v-obj-num0 as integer no-undo .
     3478   define variable v-obj-num as integer no-undo .
     3479   define variable v-obj-num2 as integer no-undo .
     3480   define variable p-num-recs2 as integer no-undo .
     3481   define variable p-rec-no2 as integer no-undo .
     3482   if p-is-petrol then do:
     3483     assign
     3484     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3485     .
     3486     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3487     then
     3488     assign
     3489     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3490     p-rec-no = p-num-recs modulo 1489
     3491     .
     3492     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3493     then
     3494     assign
     3495     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3496     p-rec-no = p-num-recs modulo 1489
     3497     .
     3498   end.
     3499   else do:
     3500     assign
     3501     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3502     p-num-recs = trunc(p-num-recs, 0)
     3503     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3504     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3505     .
     3506     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3507     then
     3508     assign
     3509     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3510     p-rec-no = p-num-recs modulo 2340
     3511     .
     3512     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3513     then
     3514     assign
     3515     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3516     p-rec-no = p-num-recs modulo 2340
     3517     .
     3518     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3519     then
     3520     assign
     3521     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3522     p-rec-no2 = p-num-recs2 modulo 2978
     3523     .
     3524     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3525     then
     3526     assign
     3527     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3528     p-rec-no2 = p-num-recs2 modulo 2978
     3529     .
     3530     assign
     3531     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3532     .
     3533   end.
     3534   if v-obj-num = 0 then v-obj-num = 100.
     3535   return v-obj-num.
     3536   END FUNCTION.
     3537   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3538   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3539   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3540      if p-is-ptrl then
     3541      return integer(entry(1, '26,27,28,29':U)).
     3542      if not p-is-ptrl then
     3543      return integer(entry(1, '16':U)).
     3544   end.
     3545   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3546   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3547   return 0.
     3548   END FUNCTION.
     3549   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3550   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3551   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3552     if p-is-ptrl then
     3553     return integer(entry(1, '26,27,28,29':U)).
     3554     if not p-is-ptrl then
     3555     return integer(entry(1, '16':U)).
     3556   end.
     3557   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3558   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3559   return 0.
     3560   END FUNCTION.
     3561   PROCEDURE maria-put:
     3562   define parameter buffer buf_cash-desk for ub.cash-desk.
     3563   define input parameter p-out    as character no-undo .
     3564   define input parameter p-fname as character no-undo .
     3565   define input parameter p-by-record as logical no-undo .
     3566   define input parameter p-shift-fields as integer no-undo .
     3567   define input parameter p-binary as logical no-undo .
     3568   define input parameter p-obj-num as integer no-undo .
     3569   define input parameter p-max-records as integer no-undo .
     3570   define input parameter p-plu as integer no-undo .
     3571   define input parameter p-value as character no-undo .
     3572   define variable v-file-name as character no-undo .
     3573   define variable v-create as logical no-undo .
     3574   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3575   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3576   output stream IBMSTREAM
     3577   to value(v-file-name) append .
     3578   Put  stream IBMSTREAM unformatted
     3579   p-plu
     3580   chr(3)
     3581   p-value
     3582   skip.
     3583   output stream IBMSTREAM
     3584   close.
     3585   if not p-by-record then do:
     3586     find first buf_temp-tekka-tsk where
     3587               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3588     if not available buf_temp-tekka-tsk then do:
     3589       v-create = yes.
     3590     end.
     3591   end.
     3592   else do:
     3593     find first buf_temp-tekka-tsk where
     3594               buf_temp-tekka-tsk.filename  = v-file-name
     3595           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3596     if not available buf_temp-tekka-tsk
     3597     then do:
     3598       find first buf_temp-tekka-tsk where
     3599                 buf_temp-tekka-tsk.filename  = v-file-name
     3600             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3601       if not available buf_temp-tekka-tsk
     3602       then do:
     3603         v-create = yes.
     3604       end.
     3605     end.
     3606   end.
     3607   if v-create then do:
     3608     create buf_temp-tekka-tsk.
     3609     assign
     3610     buf_temp-tekka-tsk.filename = v-file-name
     3611     buf_temp-tekka-tsk.range    = p-plu
     3612     buf_temp-tekka-tsk.obj-num = p-obj-num
     3613     buf_temp-tekka-tsk.obj-name = '':U
     3614     buf_temp-tekka-tsk.num-records = 0
     3615     buf_temp-tekka-tsk.max-records = p-max-records
     3616     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3617     buf_temp-tekka-tsk.task-num = p-fname
     3618     buf_temp-tekka-tsk.by-record = p-by-record
     3619     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3620     buf_temp-tekka-tsk.binary = p-binary
     3621     buf_temp-tekka-tsk.send-get = 'send'
     3622     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3623     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3624     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3625     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3626                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3627                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3628                                 then 'local'
     3629                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3630     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3631     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3632     buf_temp-tekka-tsk.waiting-sek = 30
     3633     buf_temp-tekka-tsk.min-plu     = p-plu
     3634     buf_temp-tekka-tsk.max-plu     = p-plu
     3635     .
     3636   end.
     3637   assign
     3638   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3639   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3640   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3641   .
     3642   END PROCEDURE.
     3643   PROCEDURE maria-get:
     3644   define parameter buffer buf_cash-desk for ub.cash-desk.
     3645   define input parameter p-out    as character no-undo .
     3646   define input parameter p-fname as character no-undo .
     3647   define input parameter p-by-record as logical no-undo .
     3648   define input parameter p-obj-num as integer no-undo .
     3649   define input parameter p-num-fields as integer no-undo .
     3650   define input parameter p-max-records as integer no-undo .
     3651   define input parameter p-min-plu as integer no-undo .
     3652   define input parameter p-max-plu as integer no-undo .
     3653   define input parameter p-other as character no-undo .
     3654   define input parameter p-order-num as integer no-undo .
     3655   define variable v-file-name as character no-undo .
     3656   define variable v-secondary-obj-num as character no-undo .
     3657   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3658   if p-by-record then do:
     3659     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3660   end.
     3661   else do:
     3662     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3663   end.
     3664   find first buf_temp-tekka-tsk where
     3665             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3666   if not available buf_temp-tekka-tsk then do:
     3667     create buf_temp-tekka-tsk.
     3668     assign
     3669     buf_temp-tekka-tsk.filename = v-file-name
     3670     buf_temp-tekka-tsk.obj-num = p-obj-num
     3671     buf_temp-tekka-tsk.obj-name = '':U
     3672     buf_temp-tekka-tsk.max-records = p-max-records
     3673     buf_temp-tekka-tsk.num-fields = p-num-fields
     3674     buf_temp-tekka-tsk.task-num = p-fname
     3675     buf_temp-tekka-tsk.by-record = p-by-record
     3676     buf_temp-tekka-tsk.send-get = 'get'
     3677     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3678     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3679     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3680     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3681                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3682                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3683                                   then 'local'
     3684                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3685     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3686     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3687     buf_temp-tekka-tsk.waiting-sek = 30
     3688     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3689     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3690     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3691                                       and p-max-plu <> ?
     3692                                       then p-max-plu - p-min-plu + 1
     3693                                       else 0)
     3694     buf_temp-tekka-tsk.other-info = p-other
     3695     buf_temp-tekka-tsk.order-num = p-order-num
     3696     .
     3697     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3698       assign
     3699       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3700       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3701       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3702       no-error
     3703       .
     3704       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3705     end.
     3706   end.
     3707   END PROCEDURE.
     3708   PROCEDURE maria-task:
     3709   define parameter buffer buf_cash-desk for ub.cash-desk.
     3710   define input parameter p-fname as character no-undo .
     3711   define input parameter p-obj-num-list as character no-undo .
     3712   define input parameter p-parameters as character no-undo .
     3713   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3714   find first buf_temp-tekka-tsk where
     3715             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3716   if not available buf_temp-tekka-tsk then do:
     3717     create buf_temp-tekka-tsk.
     3718     assign
     3719     buf_temp-tekka-tsk.filename = ''
     3720     buf_temp-tekka-tsk.range = 1
     3721     buf_temp-tekka-tsk.obj-num = 0
     3722     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3723     buf_temp-tekka-tsk.task-num = p-fname
     3724     buf_temp-tekka-tsk.by-record = no
     3725     buf_temp-tekka-tsk.send-get = 'task'
     3726     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3727     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3728     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3729     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3730                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3731                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3732                                   then 'local'
     3733                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3734     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3735     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3736     buf_temp-tekka-tsk.waiting-sek = 30
     3737     buf_temp-tekka-tsk.other-info = p-parameters
     3738     buf_temp-tekka-tsk.order-num = 0
     3739     .
     3740   end.
     3741   END PROCEDURE.
     3742   procedure tekkatsk-verify-schema :
     3743   define input parameter p-obj-list as character no-undo .
     3744   define input parameter p-dir-path as character no-undo .
     3745   define variable v-obj-num as integer no-undo .
     3746   define variable v-obj-name as character no-undo .
     3747   define variable v-num-records as integer no-undo .
     3748   define variable v-size_ as integer no-undo .
     3749   define variable v-value as character no-undo .
     3750   define variable ii as integer no-undo .
     3751   define variable jj as integer no-undo .
     3752   define variable ii-ibs as integer no-undo .
     3753   define variable ii-tekka as integer no-undo .
     3754   define variable v-result as character no-undo .
     3755   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3756   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3757     do
     3758     on error undo, return error
     3759     :
     3760        for each buf_temp-tekka-schema:
     3761          delete buf_temp-tekka-schema.
     3762        end.
     3763        input from value('tekkasch.d').
     3764        repeat :
     3765          create buf_temp-tekka-schema.
     3766          import buf_temp-tekka-schema.
     3767          assign
     3768          buf_temp-tekka-schema.host = 'IBS'
     3769          ii = ii + 1.
     3770          .
     3771        end.
     3772        input close.
     3773        ii-ibs = ii.
     3774         _ii:
     3775         do ii = 1 to 256:
     3776           if p-obj-list = "ALL"
     3777           or lookup(string(ii), p-obj-list) > 0 then do:
     3778             assign
     3779             v-obj-num = 0
     3780             v-obj-name = ''
     3781             v-num-records = 0
     3782             v-size_ = 0
     3783             .
     3784             run alienini-getkey in this-procedure (
     3785                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3786                                                     ,input ('obj' + string(ii, '999'))
     3787                                                     ,input 'oname'
     3788                                                     ,output v-value) no-error .
     3789             if v-value = ? then next _ii.
     3790             assign
     3791             v-obj-num = ii
     3792             v-obj-name = v-value
     3793             .
     3794             run alienini-getkey in this-procedure (
     3795                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3796                                                     ,input ('obj' + string(ii, '999'))
     3797                                                     ,input 'size'
     3798                                                     ,output v-value) no-error .
     3799             assign
     3800             v-num-records = integer(v-value) no-error  .
     3801             if error-status:error
     3802             or v-num-records = 0 then next _ii.
     3803             run alienini-getkey in this-procedure (
     3804                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3805                                                     ,input 'obj' + string(ii, '999')
     3806                                                     ,input 'f000'
     3807                                                     ,output v-value) no-error .
     3808             assign
     3809             v-size_ = integer(v-value) no-error  .
     3810             if error-status:error
     3811             or v-size_ = 0 then next _ii.
     3812             _jj:
     3813             do jj = 1 to 256:
     3814               run alienini-getkey in this-procedure (
     3815                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3816                                                       ,input 'obj' + string(ii, '999')
     3817                                                       ,input 'f' + string(jj, '999')
     3818                                                       ,output v-value) no-error .
     3819               if v-value = ? then next _ii.
     3820               create buf_temp-tekka-schema.
     3821               assign
     3822               buf_temp-tekka-schema.host = 'tekka'
     3823               buf_temp-tekka-schema.obj-num = v-obj-num
     3824               buf_temp-tekka-schema.obj-name = v-obj-name
     3825               buf_temp-tekka-schema.num-records = v-num-records
     3826               buf_temp-tekka-schema.size_ = v-size_
     3827               buf_temp-tekka-schema.field-num = jj
     3828               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3829               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3830                                                  then entry(2, entry(2, v-value, '#'), ':')
     3831                                                  else '':U)
     3832               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3833               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3834               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3835                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3836               no-error
     3837               .
     3838               if error-status:error then do:
     3839                 delete buf_temp-tekka-schema.
     3840                 next _jj.
     3841               end.
     3842               run alienini-getkey in this-procedure (
     3843                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3844                                                       ,input 'obj' + string(ii, '999') + 'name'
     3845                                                       ,input 'n' + string(jj, '999')
     3846                                                       ,output v-value) no-error .
     3847               if v-value <> ? then
     3848               buf_temp-tekka-schema.field-name = v-value.
     3849             end.
     3850           end.
     3851         end.
     3852         ii-tekka = ii - 1.
     3853        if p-obj-list <> 'ALL' then do:
     3854         if ii-tekka <> ii-ibs then do:
     3855           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3856                                   , ii-ibs
     3857                                   , ii-tekka).
     3858         end.
     3859        end.
     3860        for each buf_temp-tekka-schema where
     3861               buf_temp-tekka-schema.host = 'tekka':
     3862          find first buf2_temp-tekka-schema where
     3863                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3864                AND buf2_temp-tekka-schema.host = 'ibs'
     3865                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3866          if not available buf2_temp-tekka-schema then do:
     3867           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3868                                   , buf_temp-tekka-schema.field-num
     3869                                   , buf_temp-tekka-schema.obj-num).
     3870          end.
     3871          buffer-compare buf_temp-tekka-schema
     3872          to buf2_temp-tekka-schema
     3873          save result in v-result.
     3874          if v-result <> '':U then do:
     3875           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3876                                   , buf_temp-tekka-schema.field-num
     3877                                   , buf_temp-tekka-schema.obj-num).
     3878          end.
     3879        end.
     3880     end.
     3881   end procedure.
     3882   FUNCTION set-Sx returns character (input p-string as character):
     3883   return p-string.
     3884   END FUNCTION.
     3885   FUNCTION get-Sx returns character (input p-string  as character):
     3886   return p-string.
     3887   END FUNCTION.
     3888   FUNCTION set-B returns character (input p-string  as character):
     3889   return chr(integer(p-string)).
     3890   END FUNCTION.
     3891   FUNCTION get-B returns character (input p-string  as character):
     3892   return string(asc(p-string)).
     3893   END FUNCTION.
     3894   FUNCTION set-BF returns character (input p-string  as character):
     3895   define variable v-dopi as integer no-undo .
     3896   define variable ii as integer no-undo .
     3897   do ii = 1 to 8:
     3898     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3899   end.
     3900   return chr(v-dopi).
     3901   END FUNCTION.
     3902   FUNCTION get-BF returns character (input p-string  as character):
     3903   define variable v-dopi as integer no-undo .
     3904   define variable v-dops as character no-undo .
     3905   define variable ii as integer no-undo .
     3906   v-dopi = asc(p-string).
     3907   do ii = 8 to 1 BY -1:
     3908     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3909   end.
     3910   return v-dops.
     3911   END FUNCTION.
     3912   FUNCTION set-BN returns character (input p-string  as character
     3913                                     ,input p-bin-group as character):
     3914   define variable v-dopi as integer no-undo .
     3915   define variable ii as integer no-undo .
     3916   define variable jj as integer no-undo .
     3917   define variable v-grp-nums as integer no-undo .
     3918   define variable v-dopi2 as integer no-undo .
     3919   v-grp-nums = num-entries(p-bin-group).
     3920   do jj = 0 to v-grp-nums - 1:
     3921     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3922     do ii = 1 to 8:
     3923       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3924     end.
     3925   end.
     3926   return chr(v-dopi).
     3927   END FUNCTION.
     3928   FUNCTION get-BN returns character (input p-string  as character
     3929                                     ,input p-bin-group as character):
     3930   define variable v-dopi as integer no-undo .
     3931   define variable v-dops as character no-undo .
     3932   define variable v-grp-nums as integer no-undo .
     3933   define variable ii as integer no-undo .
     3934   define variable jj as integer no-undo .
     3935   v-dopi = asc(p-string).
     3936   v-grp-nums = num-entries(p-bin-group).
     3937   do jj = 1 to v-grp-nums:
     3938   do ii = 8 to 1 BY -1:
     3939     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3940   end.
     3941   end.
     3942   return v-dops.
     3943   END FUNCTION.
     3944   procedure fill-temp-cd :
     3945   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3946   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3947   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3948   define input parameter p-clear-table as logical no-undo .
     3949   define buffer buf_temp-cd for temp-cd.
     3950   define buffer buf_cash-desk for ub.cash-desk.
     3951     do
     3952     on error undo, return error
     3953     :
     3954        if p-clear-table  then do:
     3955          for each buf_temp-cd:
     3956            delete buf_temp-cd.
     3957          end.
     3958        end.
     3959        for each buf_cash-desk no-lock where
     3960               buf_cash-desk.db-num = p-db-num
     3961           AND buf_cash-desk.obj-code = p-obj-code
     3962           and buf_cash-desk.cash-on  = yes
     3963        BREAK by buf_cash-desk.pos-type:
     3964          if first-of(buf_cash-desk.pos-type) then do:
     3965            create buf_temp-cd.
     3966            buffer-copy buf_cash-desk to buf_temp-cd.
     3967          end.
     3968        end.
     3969     end.
     3970   end procedure.
     3971   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3972   FUNCTION name-2cdf returns character
     3973                      (  input p-name-2cd as character
     3974                       , input p-mode as logical
     3975                       , input p-cod-pcod as logical
     3976                       , input p-b-code  as integer
     3977                       , input p-gds-code as integer
     3978                       , input p-artic   as character
     3979                       , input p-engl-name  as character
     3980                       , input p-in-code as character
     3981                       , input p-part-code as character
     3982                       , input p-obj-type as character
     3983                       , input p-obj-code as integer
     3984                       , input p-alpha1 as character
     3985                       , output p-gtd as character
     3986                       ) :
     3987   define variable v-name-2cd as character no-undo .
     3988   define variable v-dop-alt-name as character no-undo.
     3989   define variable v-type as character no-undo.
     3990   define buffer buf_parts for ub.parts.
     3991   define buffer buf_code for ub.code.
     3992   if not p-mode and p-name-2cd = "PLU":U then do:
     3993     return "PLU кассы":U.
     3994   end.
     3995   if not p-mode then do:
     3996     if p-name-2cd <> "GTD":U
     3997     and  p-name-2cd <> "alpha1|gtd":U
     3998     then do:
     3999     assign
     4000     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4001   end.
     4002   end.
     4003   if p-part-code = "":U or p-cod-pcod = no then do:
     4004     run gdsoattr-value in this-procedure (
     4005       'dt-seasons':U,
     4006       p-gds-code,
     4007       p-obj-type,
     4008       p-obj-code,
     4009       output v-dop-alt-name,
     4010       output v-type
     4011     ) no-error.
     4012     if v-dop-alt-name <> "" then do:
     4013       find first buf_code where
     4014                  buf_code.parent = "DTSeasons"
     4015              and buf_code.code   = v-dop-alt-name
     4016            no-lock no-error.
     4017       if available buf_code then
     4018         assign
     4019           p-engl-name = ""
     4020           v-dop-alt-name =  buf_code.misc1
     4021         .
     4022     end.
     4023     else do:
     4024       run gdsoattr-value in this-procedure
     4025                           ( input  'dop-alt-name-o':U
     4026                            ,input  p-gds-code
     4027                            ,input  p-obj-type
     4028                            ,input  p-obj-code
     4029                            ,output v-dop-alt-name
     4030                            ,output v-type
     4031                           ) no-error .
     4032     end.
     4033     CASE p-name-2cd:
     4034       when "name" then do:
     4035         if p-mode then return p-engl-name + v-dop-alt-name.
     4036         return "Англ. название".
     4037       end.
     4038       when "code":U then do:
     4039         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4040         return "Лок. код товара"  .
     4041       end.
     4042       when "GTD":U
     4043       or
     4044       when "name-GTD":U
     4045       or
     4046       when "code-GTD":U
     4047       or
     4048       when "alpha1|gtd":U
     4049       or
     4050       when "name-alpha1|gtd":U
     4051       or
     4052       when "code-alpha1|gtd":U
     4053       then do:
     4054         if p-mode then do:
     4055           run gdcstcod_cst-code  in this-procedure (
     4056                                                       input  p-obj-type
     4057                                                       ,input  p-obj-code
     4058                                                       ,input  p-gds-code
     4059                                                       ,input  p-in-code
     4060                                                       ,input  p-part-code
     4061                                                       ,output p-gtd
     4062                                                       ) no-error .
     4063         end.
     4064         if p-name-2cd = "name-gtd":U then do:
     4065           if p-mode then return p-engl-name  + v-dop-alt-name.
     4066           return "Англ. название".
     4067         end.
     4068         if p-name-2cd = "name-alpha1|gtd":U then do:
     4069           if p-mode then return p-engl-name  + v-dop-alt-name.
     4070           return "Англ. название".
     4071         end.
     4072         if p-name-2cd = "code-GTD":U then do:
     4073           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4074           return "Лок. код товара"  .
     4075         end.
     4076         if p-name-2cd = "code-alpha1|gtd":U then do:
     4077           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4078           return "Лок. код товара"  .
     4079         end.
     4080         if p-mode then do:
     4081           if p-name-2cd = "GTD" then  return p-gtd.
     4082           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4083         end.
     4084         if p-name-2cd = "GTD" then  return "Код ГТД".
     4085         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4086       end.
     4087     END CASE.
     4088   end.
     4089   else do:
     4090     if p-name-2cd = "name-gtd":U
     4091     or p-name-2cd = "code-GTD":U
     4092     or p-name-2cd = "name-alpha1|GTD":U
     4093     or p-name-2cd = "code-alpha1|GTD":U
     4094     or p-name-2cd = "alpha1|GTD":U
     4095     then do:
     4096       if p-mode then do:
     4097         run gdcstcod_cst-code  in this-procedure (
     4098                                                      input  p-obj-type
     4099                                                     ,input  p-obj-code
     4100                                                     ,input  p-gds-code
     4101                                                     ,input  p-in-code
     4102                                                     ,input  p-part-code
     4103                                                     ,output p-gtd
     4104                                                     ) no-error .
     4105       end.
     4106       else do:
     4107         if p-name-2cd = "gtd":U then
     4108         p-gtd = "Код ГТД".
     4109         if p-name-2cd = "alpha1|Gtd":U then
     4110         p-gtd = "Страна|Код ГТД".
     4111       end.
     4112     end.
     4113     if p-mode then  return p-part-code.
     4114     return "Код партии".
     4115   end.
     4116   END FUNCTION.
     4117   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4118                                            ,input p-nam-2str as logical
     4119                                            ,input p-nam-artc as logical
     4120                                            ,input p-unit-cli-type as character
     4121                                            ,input p-unit-base as character
     4122                                            ,input p-unit-cli as character
     4123                                            ,input p-cli-base-rate as decimal
     4124                                            ,input p-artic as character
     4125                                            ,input p-f-name as character
     4126                                            ,input p-gds-name as character
     4127                                            ,input p-gds-name1 as character
     4128                                            ,output p-second-name as character):
     4129   define variable v-length as integer no-undo .
     4130   define variable nam-2str-shift as integer no-undo .
     4131   define variable chk_name as character no-undo .
     4132   assign
     4133   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4134   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4135   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4136               then 5
     4137               else v-length)
     4138   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4139   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4140   .
     4141   if p-nam-artc then do:
     4142     assign
     4143     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4144       .
     4145   end.
     4146   else  do:
     4147     assign
     4148     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4149     .
     4150   end.
     4151   if p-unit-base <> p-unit-cli then do:
     4152     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4153     assign
     4154     chk_name = string(substr(chk_name
     4155                               ,1
     4156                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4157                       "*":U +
     4158                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4159   end.
     4160   else do:
     4161     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4162   end.
     4163   if p-nam-2str then do:
     4164     assign
     4165     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4166     chk_name = substr(chk_name, 1, v-length)
     4167     .
     4168   end.
     4169   else do:
     4170     assign
     4171     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4172     p-second-name =   (chr(34) +
     4173                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4174                       + chr(34) )
     4175     .
     4176   end.
     4177   return chk_name.
     4178   end function.
     4179   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4180   procedure disrules-get-interface-form :
     4181   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4182   define output parameter p-form-name as character no-undo .
     4183   define buffer buf_temp-drt-prop for temp-drt-prop.
     4184   define buffer buf_drt-prop for ub.drt-prop.
     4185   find first buf_temp-drt-prop where
     4186             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4187         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4188         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4189   if not available buf_temp-drt-prop then do:
     4190     find first buf_drt-prop where
     4191               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4192           and buf_drt-prop.upper-prop-code = "InputForm"
     4193           and buf_drt-prop.prop-code = "FormName" no-error.
     4194     if available buf_drt-prop then do:
     4195       p-form-name = buf_drt-prop.property-value.
     4196     end.
     4197     else do:
     4198       p-form-name = "ref/dis-ruli.w".
     4199     end.
     4200   end.
     4201   else do:
     4202     p-form-name = buf_temp-drt-prop.property-value.
     4203   end.
     4204   end procedure.
