     8899   define variable iii as integer no-undo .
     8900     do
     8901     on error undo, return error
     8902     :
     8903       if cash-gds.b-str = "" then do:
     8904         assign
     8905         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
     8906         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
     8907           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8908               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8909             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8910             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
     8911           end.
     8912           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8913               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8914             IBM-good-code-2 = b_code.
     8915           end.
     8916         end.
     8917       end.
     8918       else do:
     8919         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
     8920         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8921                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8922                              or
     8923                              cash-gds.bc-on-type = 'pglc':U)
     8924                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
     8925                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
     8926                                       trim( cash-gds.b-str ), "9999999999999" ) ).
     8927          if action <> "D":U then do:
     8928           is-sc = no.
     8929           find first request_prod-bc no-lock where
     8930                     request_prod-bc.b-str = cash-gds.b-str no-error .
     8931           if not avail request_prod-bc then do :
     8932             if mask_s-c <> "" then do :
     8933               iii_ :
     8934               do iii = 1 to num-entries(mask_s-c) :
     8935                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
     8936                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
     8937                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
     8938                   if available request_prod-bc then leave iii_ .
