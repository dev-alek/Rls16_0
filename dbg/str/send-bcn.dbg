    12919                       ,input out
    12920                       ,input fname
    12921                       ,input v-remote
    12922                       ,input v-is-script105
    12923                       ) no-error .
    12924   if error-status:error then do:
    12925     for each temp-tekka-tsk:
    12926       os-delete value( temp-tekka-tsk.filename) .
    12927       delete temp-tekka-tsk.
    12928     end.
    12929     run write-log-and-file in p-log-handle (
    12930           input 1
    12931         , input log-file-name
    12932         , input 1
    12933         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    12934                              ,for-cash-desk.cash-num
    12935                              ,chr(10)
    12936                              ,return-value
    12937                           )
    12938                                           ).
    12939     assign
    12940     v-view-log = yes
    12941     .
    12942       for each temp-cd-plu:
    12943         delete temp-cd-plu.
    12944       end.
    12945     return "error":U.
    12946   end.
    12947   else do:
    12948     for each temp-cd-plu,
    12949         first buf_cd-plu where
    12950                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    12951                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    12952                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    12953                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    12954                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    12955       if temp-cd-plu.to-del = yes
    12956       and v-del-mrkt-gds
    12957       then do:
    12958         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    12959           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    12960           assign
    12961           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    12962           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    12963           .
    12964         end.
    12965         if buf_cd-plu.charkey_one = '':U then do:
    12966           delete buf_cd-plu.
    12967           NEXT.
    12968         end.
    12969       end.
    12970       if temp-cd-plu.charkey_two = "":U
    12971       then
    12972       assign
    12973       buf_cd-plu.charkey_two = "":U
    12974       buf_cd-plu.to-send = no
    12975       .
    12976       delete temp-cd-plu.
    12977     end.
    12978   end.
    12979   end.
    12980   run cd-mrkt_update-marketer in this-procedure (
    12981                                                   input for-cash-desk.db-num
    12982                                                   ,input for-cash-desk.obj-code
    12983                                                   ,input for-cash-desk.pos-type
    12984                                                   ,input for-cash-desk.cash-num
    12985                                                   ,input no
    12986                                                 )  .
    12987       end.
    12988     end.
    12989   END CASE.
    12990   END .
