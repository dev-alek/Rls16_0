    12100         end.
    12101         input stream bar from value(v-kat-file) convert source "ibm866" .
    12102         assign
    12103         ss0 = ''
    12104         ss = '':U
    12105         v-cd-subject-code = '':U
    12106         v-cd-disc-string  = '':U
    12107         v-next = no
    12108         v-updated-subject-dis-kat = no
    12109         .
    12110         output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    12111         _rr2:
    12112         repeat:
    12113           import stream bar unformatted ss.
    12114           assign
    12115           v-next = no
    12116           v-updated-subject-dis-kat = no
    12117           v-cd-subject-code = substring(ss, 1, 16)
    12118           v-cd-disc-string =  substring(ss, 17, 7)
    12119           .
    12120           if not ss begins fill(chr(32), 2 )
    12121           then do:
    12122             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
    12123               put stream plucash unformatted
    12124               ss skip.
    12125               ss0 = v-cd-subject-code.
    12126               NEXT _rr2.
    12127             end.
    12128             v-next = yes.
    12129           end.
    12130           _for_rr2:
    12131           for each  buf_cash-ncr-dis-kat no-lock where
    12132                     buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12133                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    12134                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    12135                 and crf <= cr-ncr-dis-kat
    12136           by buf_cash-ncr-dis-kat.cd-subject-code
    12137           by buf_cash-ncr-dis-kat.cd-disc-string
    12138           :
    12139             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12140             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    12141               leave  _for_rr2.
    12142             end.
    12143             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    12144               v-updated-subject-dis-kat = yes.
    12145             end.
    12146             find first  cash-ncr-save-param no-lock where
    12147                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    12148                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    12149                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    12150             if available cash-ncr-save-param then do:
    12151               put stream plucash unformatted
    12152               cash-ncr-save-param.cd-line
    12153               cash-ncr-save-param.cd-other
    12154               skip.
    12155               v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7)
    12156                                  .
    12157               NEXT _for_rr2.
    12158             end.
    12159             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    12160           end.
    12161           if v-next then do:
    12162             ss0 = v-cd-subject-code.
    12163             put stream plucash unformatted
    12164             ss skip.
    12165             NEXT _rr2.
    12166           end.
    12167           if not v-updated-subject-dis-kat then do:
    12168             find first buf_cash-ncr-dis-kat no-lock where
    12169                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12170                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
    12171             if not available buf_cash-ncr-dis-kat then do:
    12172               put stream plucash unformatted
    12173               ss skip.
    12174             end.
    12175           end.
    12176           ss0 = v-cd-subject-code.
    12177         end.
    12178         input stream bar close.
    12179         _for_rr3:
    12180         for each  buf_cash-ncr-dis-kat no-lock where
    12181                   buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12182               AND buf_cash-ncr-dis-kat.cd-subject-code >= v-cd-subject-code
    12183               and crf <= cr-ncr-dis-kat
    12184         by buf_cash-ncr-dis-kat.cd-subject-code
    12185         by buf_cash-ncr-dis-kat.cd-disc-string
    12186         :
    12187             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12188             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) <= v-cd-disc-string then do:
    12189               next  _for_rr3.
    12190             end.
    12191           find first  cash-ncr-save-param no-lock where
    12192                         cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    12193                     AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    12194                                                       substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    12195           if available cash-ncr-save-param then do:
    12196             put stream plucash unformatted
    12197             cash-ncr-save-param.cd-line
    12198             cash-ncr-save-param.cd-other
    12199             skip.
    12200             v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7) .
    12201           end.
    12202           else do:
    12203             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    12204           end.
    12205         end.
    12206         output stream plucash close.
    12207         find first temp-dis-kat-file no-lock where                                                       temp-dis-kat-file.dis-kat = cash-ncr-dis-kat.dis-kat no-error.                   if not available temp-dis-kat-file then                                                create temp-dis-kat-file.                                                              assign                                                                                 temp-dis-kat-file.dis-kat   = cash-ncr-dis-kat.dis-kat                                     .                                                                                      assign                                                                                 temp-dis-kat-file.temp-file = v-temp-kat-file                                          temp-dis-kat-file.send-file = v-kat-file                                               temp-dis-kat-file.to-send   = yes.
    12208       end.
    12209     END.
    12210   end.
    12211     end.
    12212     when 'MARIA':U then do:
    12213   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12214   define variable v-found100 as logical no-undo .
    12215   define variable v-is-script100 as logical no-undo.
    12216   define variable v-fields-shift100 as integer no-undo .
    12217      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    12218      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    12219      then do:
    12220        v-fields-shift100 = - 1.
    12221   if v-record <> '':U then
    12222       run maria-put in this-procedure (
    12223                                       buffer for-cash-desk
    12224                                     , input out
    12225                                     , input fname
    12226                                     , input yes
    12227                                     , input v-fields-shift100
    12228                                     , input yes
    12229                                     , input 24
    12230                                     , input 1
    12231                                     , input string(1)
    12232                                     , input v-record
    12233                                       ).
