     8750     if (ub.shop.in-ov and  l-in-ov64 ) then
     8751                 return.
     8752   if (NOT ub.shop.all-prt )
     8753       AND  ub.goods.gds-type = 'т':U
     8754       AND  NOT l-empty-scale then do:
     8755     if not available ub.prt-obj then do:
     8756       if ub.shop.sub-store-on then do:
     8757         if NOT can-find( first ub.gds-dtl where
     8758                             ub.gds-dtl.artic = ub.goods.artic AND
     8759                             ub.gds-dtl.prod-type = ub.goods.prod-type AND
