    11122       then do:
    11123   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11124   define variable ncr-disc-string as character no-undo .
    11125   if nam-artc then
    11126   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    11127   else  do:
    11128     chk_name = "" .
    11129     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
