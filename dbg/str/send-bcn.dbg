     1490   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1493   procedure disrules-fill-properties:
     1494   define input  parameter p-templ-rl-root as integer   no-undo .
     1495   define buffer buf_drt-prop for ub.drt-prop.
     1496   define buffer buf_temp-drt-prop for temp-drt-prop.
     1497   do
     1498   on error undo, return error return-value
     1499   :
     1500     for each buf_temp-drt-prop:
     1501       delete buf_temp-drt-prop.
     1502     end.
     1503     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1504       create buf_temp-drt-prop.
     1505       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1506     end.
     1507   end.
     1508   end procedure.
     1509   ~
     1510   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1511   procedure discfgru-check :
     1512   define input parameter p-table-name as character no-undo .
     1513   define input parameter p-templ-rl-root as integer no-undo .
     1514   define input parameter p-time-templ-rl-root as integer no-undo .
     1515   define input parameter p-pos-type as character no-undo .
     1516   define output parameter p-disnct-role as character no-undo .
     1517   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       find first buf_dis-cfg-rule no-lock where
     1522               buf_dis-cfg-rule.table-name = p-table-name
     1523           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1524           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1525           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1526       if not available buf_dis-cfg-rule
     1527       or p-pos-type = "":U
     1528       then do:
     1529          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1530                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1531                                  , p-templ-rl-root
     1532                                  , (if p-time-templ-rl-root = ?
     1533                                     then '':U
     1534                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1535                                     )
     1536                                  ).
     1537       end.
     1538       assign
     1539       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1540       .
     1541     end.
     1542   end procedure.
     1543   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   FUNCTION get-region RETURNS CHARACTER
     1545     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1546     define variable par-region as character no-undo.
     1547     if parhost-code = 0 and
     1548          parobj-type = "":U and
     1549          parobj-code = 0 then do:
     1550          par-region = "Глобально".
     1551          return par-region.
     1552       end.
     1553       if parobj-type = 'орг':U then do:
     1554          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1555          return par-region.
     1556       end.
     1557       if parobj-type = 'регион':U
     1558       then do:
     1559          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1560          return par-region.
     1561       end.
     1562       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1563       return par-region.
     1564   END FUNCTION.
     1565   FUNCTION get-objregion RETURNS CHARACTER
     1566     (  input parobj-type as character, input parobj-code as integer ) :
     1567     define variable par-region as character no-undo.
     1568     if  parobj-type = "":U and
     1569         parobj-code = 0
     1570     then do:
     1571        par-region = "Глобально".
     1572     end.
     1573     else if parobj-type = 'орг':U
     1574     then do:
     1575        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1576     end.
     1577     else if parobj-type = 'регион':U
     1578     then do:
     1579        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1580     end.
     1581     else
     1582        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1583     return par-region.
     1584   END FUNCTION.
     1585   procedure disgdsru-name :
     1586   define buffer buf_dis-rule for ub.dis-rule.
     1587   do
     1588     on error undo, return error
     1589     :
     1590     define input  parameter p-templ-rl-root  as integer no-undo .
     1591     define output parameter p-label          as character no-undo .
     1592     find first buf_dis-rule no-lock where
     1593               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1594     if available buf_dis-rule
     1595     then do:
     1596       if buf_dis-rule.rule-num > 0 then
     1597       p-label = buf_dis-rule.des.
     1598     end.
     1599     else do:
     1600       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1601     end.
     1602   end.
     1603   end procedure.
     1604   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1605   define variable v-rule-label as character no-undo .
     1606   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1607                                        ,output v-rule-label) no-error.
     1608   return v-rule-label.
     1609   end function.
     1610   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1611   define variable v-rule-label as character no-undo .
     1612   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1613   end function.
     1614   procedure disgdsru-write :
     1615     do
     1616     on error undo, return error
     1617     :
     1618       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1619       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1620       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1621       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1622       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1623       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1624       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1625       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1626       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1627       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1628       define buffer buf_dis-rule for ub.dis-rule.
     1629       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1630       define variable v-label          as character no-undo .
     1631       define variable v-discnt-role as character no-undo .
     1632       run discfgru-check in this-procedure (
     1633                                             input 'dis-gds-rule':U
     1634                                            ,input p-templ-rl-root
     1635                                            ,input p-time-templ-rl-root
     1636                                            ,input p-pos-type
     1637                                            ,output v-discnt-role
     1638                                             ) no-error .
     1639       if error-status :error then do:
     1640         undo, return error return-value .
     1641       end.
     1642       if p-discnt-role = ? then do:
     1643         p-discnt-role = v-discnt-role.
     1644       end.
     1645       if p-discnt-role <> v-discnt-role then do:
     1646         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1647                                 ,p-gds-code
     1648                                 ,p-obj-type
     1649                                 ,p-obj-code
     1650                                 ,p-pos-type
     1651                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1652                                 ,chr(10)
     1653                                 ,p-templ-rl-root
     1654                                 ,p-rule-num).
     1655       end.
     1656       if p-pos-type = ? then do:
     1657   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1658   define variable v-param-type23 as character no-undo .
     1659   define variable v-value-date23 as date no-undo .
     1660   define variable v-value-decimal23 as decimal no-undo .
     1661   define variable v-value-integer23 as INTEGER no-undo .
     1662   define variable v-value-logical23 AS LOGICAL no-undo .
     1663   define variable v-tth23 as handle no-undo .
     1664   run adm/shattri.p (
     1665       input "get":U
     1666       ,input  p-obj-type
     1667       ,input  p-obj-code
     1668       ,input  'cd-sending':U
     1669       ,input  'dflt-cd':U
     1670       ,output p-pos-type
     1671       ,output v-value-date23
     1672       ,output v-value-decimal23
     1673       ,output v-value-integer23
     1674       ,output v-value-logical23
     1675       ,output v-param-type23
     1676       ,INPUT-OUTPUT table-handle v-tth23
     1677       )  .
     1678   delete object v-tth23 no-error.
     1679       end.
     1680       find first buf_dis-rule no-lock where
     1681                 buf_dis-rule.rule-num = p-rule-num no-error.
     1682       if not available buf_Dis-rule then do:
     1683         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1684                                 ,p-gds-code
     1685                                 ,p-obj-type
     1686                                 ,p-obj-code
     1687                                 ,p-pos-type
     1688                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1689                                 ,chr(10)
     1690                                 ,p-rule-num).
     1691       end.
     1692       if buf_dis-rule.root <> yes then do:
     1693         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1694                                 ,p-gds-code
     1695                                 ,p-obj-type
     1696                                 ,p-obj-code
     1697                                 ,p-pos-type
     1698                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1699                                 ,chr(10)
     1700                                 ,p-rule-num).
     1701       end.
     1702       if not (p-obj-type = buf_dis-rule.obj-type
     1703           and p-obj-code = buf_dis-rule.obj-code)
     1704       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1705                and
     1706                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1707        then do:
     1708         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1709                                 ,p-gds-code
     1710                                 ,p-obj-type
     1711                                 ,p-obj-code
     1712                                 ,p-pos-type
     1713                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1714                                 ,chr(10)
     1715                                 ) +
     1716                             substitute("Правило скидки &1 определено для &2&3" +
     1717                                        "а привязка к товару для &4"
     1718                                        ,buf_dis-rule.rule-num
     1719                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1720                                        ,chr(10)
     1721                                        ,get-objregion( p-obj-type, p-obj-code)
     1722                                        ))
     1723                                 .
     1724       end.
     1725       find first buf_dis-gds-rule exclusive-lock where
     1726                  buf_dis-gds-rule.gds-code  = p-gds-code
     1727              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1728              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1729              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1730              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1731              and buf_dis-gds-rule.nonunique = p-nonunique
     1732              no-error .
     1733       if not available buf_dis-gds-rule then do:
     1734         find first buf_dis-gds-rule exclusive-lock where
     1735                   buf_dis-gds-rule.gds-code  = p-gds-code
     1736               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1737               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1738               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1739               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1740               no-error .
     1741         if available buf_Dis-gds-rule then do:
     1742           if p-nonunique = ''
     1743           and available buf_dis-gds-rule
     1744           then do:
     1745             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1746                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1747                                      , p-gds-code
     1748                                      , buf_Dis-rule.obj-type
     1749                                      , buf_Dis-rule.obj-code
     1750                                      , p-nonunique
     1751                                     ).
     1752           end.
     1753           if available buf_dis-gds-rule
     1754           and buf_dis-gds-rule.nonunique = ''
     1755           and p-nonunique <> ''then do:
     1756             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1757                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1758                                      , p-gds-code
     1759                                      , buf_Dis-rule.obj-type
     1760                                      , buf_Dis-rule.obj-code
     1761                                     ).
     1762           end.
     1763         end.
     1764         create buf_dis-gds-rule .
     1765         assign
     1766         buf_dis-gds-rule.gds-code  = p-gds-code
     1767         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1768         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1769         buf_dis-gds-rule.pos-type = p-pos-type
     1770         buf_dis-gds-rule.discnt-role = v-discnt-role
     1771         buf_dis-gds-rule.rule-num = p-rule-num
     1772         buf_dis-gds-rule.nonunique = p-nonunique
     1773         no-error
     1774         .
     1775       end.
     1776       ASSIGN
     1777       buf_dis-gds-rule.rule-num = p-rule-num
     1778       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1779       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1780       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1781       buf_dis-gds-rule.nonunique = p-nonunique
     1782       no-error.
     1783     end.
     1784   end procedure.
     1785   PROCEDURE cmp-disgdsru-write :
     1786   do
     1787   on error undo, return error
     1788   :
     1789     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1790     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1791     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1792     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1793     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1794     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1795     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1796     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1797     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1798     define variable v-rule-label          as character no-undo .
     1799     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1800     define buffer buf_dis-rule     for ub.dis-rule.
     1801     run disgdsru-name in this-procedure (
     1802                                         input  p-templ-rl-root
     1803                                         ,output v-rule-label
     1804                                         ) no-error .
     1805     if error-status :error then do:
     1806       undo, return error return-value .
     1807     end.
     1808     find first buf_tt0-dis-gds-rule exclusive-lock where
     1809                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1810             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1811             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1812             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1813             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1814             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1815             no-error .
     1816     if not available buf_tt0-dis-gds-rule then do:
     1817       create buf_tt0-dis-gds-rule .
     1818       assign
     1819       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1820       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1821       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1822       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1823       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1824       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1825       no-error
     1826       .
     1827     end.
     1828     find first buf_dis-rule no-lock where
     1829               buf_dis-rule.rule-num = p-rule-num.
     1830     ASSIGN
     1831     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1832     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1833     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1834     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1835     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1836     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1837     no-error.
     1838     release buf_tt0-dis-gds-rule no-error .
     1839     if error-status:error then do:
     1840       undo, return error return-value .
     1841     end.
     1842   end.
     1843   END PROCEDURE.
     1844   define variable vss-include-info24 as character format "X(65)" no-undo
     1845   initial "@(#)$Workfile$ $Revision$".
     1846   define variable v-bgelib-bgefmt        as character         no-undo.
