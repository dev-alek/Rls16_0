    11338     .
    11339   end.
    11340       end.
    11341     END CASE .
    11342   END PROCEDURE .
    11343   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11344   PROCEDURE   for-cash-cycle:
    11345   DEFINE VARIABLE fname-list as character no-undo .
    11346   DEFINE VARIABLE out-list as character no-undo .
    11347   DEFINE VARIABLE var-file-num as integer no-undo .
    11348   DEFINE VARIABLE v-dir-remote as character no-undo .
    11349   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
    11350   define variable v-plu as character no-undo .
    11351   define variable v-pl-code as integer no-undo .
    11352   define variable ss  as character no-undo .
    11353   define variable ss0  as character no-undo .
    11354   define variable v-temp-kat-file as character no-undo .
    11355   define variable v-kat-file as character no-undo .
    11356   define variable v-kat-file-save as character no-undo .
    11357   define variable v-updated-subject-dis-kat as logical no-undo .
    11358   define variable v-next as logical no-undo .
    11359   define variable v-cd-subject-code as character no-undo .
    11360   define variable v-cd-disc-string as character no-undo .
    11361   define variable v-versiond as decimal no-undo .
    11362   define variable v-maria-discnt-value as character no-undo .
    11363   define variable v-ii as integer no-undo .
    11364   define variable v-dop as character no-undo .
    11365   define variable v-gds-rule-num as integer no-undo .
    11366   define variable v-maria-rule-num as integer no-undo .
    11367   define buffer for-cash-desk for ub.cash-desk.
    11368   define buffer buf_cd-plu for ub.cd-plu.
    11369   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    11370   define buffer buf_cash-gds for cash-gds.
    11371   define buffer buf_dis-rule for ub.dis-rule.
    11372   define buffer buf_place for ub.place.
    11373   define buffer buf_pl-gds for ub.pl-gds.
    11374   FOR EACH for-cash-desk NO-LOCK WHERE
    11375           for-cash-desk.db-num = g#db-num AND
    11376           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    11377           for-cash-desk.obj-code = i-obj-code AND
    11378    for-cash-desk.cash-on  = yes
    11379       BREAK
    11380       BY for-cash-desk.db-num
    11381       BY for-cash-desk.obj-code
    11382       BY for-cash-desk.pos-type
    11383       BY for-cash-desk.cash-on
    11384       BY for-cash-desk.cash-num
    11385       :
    11386     if LOOKUP(ub.cash-desk.pos-type,
    11387               ('NCR-GM':U + chr(44) +
    11388                'IBM-XML':U + chr(44) +
    11389                'MAGIA-XML':U + chr(44) +
    11390                'NCR-AS@R':U  + chr(44) +
    11391                'Autotank':U
    11392                  )) > 0
