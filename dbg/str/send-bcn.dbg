     6231         or v-fact-order = 0 then do:
     6232           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6233         end.
     6234         p-fact-order = v-fact-order .
     6235   end.
     6236     end.
     6237   end procedure.
