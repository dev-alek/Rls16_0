      380   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      382                                                                     input  orders as integer):
      383   define variable  round-m-sum as decimal no-undo.
      384   if orders >= 0 then
      385   round-m-sum = round(mysum,orders).
      386   else
      387   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      388   return round-m-sum.
      389   END FUNCTION.
      390   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   procedure factord :
      392     define input  parameter p-fact-date            as date    no-undo .
      393     define input  parameter p-fact-time            as integer no-undo .
      394     define input  parameter p-fact-num             as integer no-undo .
      395     define input  parameter p-shift-date           as date    no-undo .
      396     define input  parameter p-shift-num            as integer no-undo .
      397     define input  parameter p-shift-on             as logical no-undo .
      398     define output parameter p-fact-order           as decimal no-undo .
      399     define output parameter p-shift-end-fact-order as decimal no-undo .
      400     define output parameter p-day-end-fact-order   as decimal no-undo .
      401     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      402     if p-fact-date = ?
      403     then do:
      404       return error "Не указана фактическая дата" .
      405     end.
      406     define variable v-fact-date-num as integer no-undo .
      407     assign
      408       v-fact-date-num = integer(p-fact-date)
      409     .
      410     if p-fact-num = ?
      411     or p-fact-num = 0
      412     then do:
      413       return error "Не задан p-fact-num " + string(p-fact-num) .
      414     end.
      415     if p-fact-num < 0
      416     then do:
      417       return error "Отрицательный fact-num " + string(p-fact-num) .
      418     end.
      419     if p-fact-num >= 100000000
      420     then do:
      421       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      422     end.
      423     if p-shift-on = true
      424     then do:
      425       if p-shift-date = ?
      426       then do:
      427         return error "Не задана дата смены" .
      428       end.
      429       if p-shift-num = ?
      430       or p-shift-num = 0
      431       then do:
      432         return error "Не задан номер смены" .
      433       end.
      434     end.
      435     else do:
      436       assign
      437         p-shift-date = p-fact-date
      438         p-shift-num  = 24
      439       .
      440     end.
      441     define variable v-shift-offset as integer no-undo .
      442     if p-shift-date = p-fact-date
      443     then do:
      444       assign
      445         v-shift-offset = 1
      446       .
      447     end.
      448     if p-shift-date < p-fact-date
      449     then do:
      450       assign
      451         v-shift-offset = 0
      452       .
      453     end.
      454     if p-shift-date > p-fact-date
      455     then do:
      456       message
      457         vss-workfile vss-revision vss-description skip
      458         "Неправильная дата закрытия смены" skip
      459         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      460         view-as alert-box error .
      461       undo, return error
      462         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      463           ,string(p-fact-date, '99/99/9999':U)
      464           ,string(p-shift-date, '99/99/9999':U)
      465           )
      466       .
      467     end.
      468     if p-shift-num < 1
      469     or p-shift-num > 24
      470     then do:
      471       message
      472         vss-workfile vss-revision vss-description skip
      473         "Неправильный номер смены" skip
      474         "p-shift-num" p-shift-num skip
      475         view-as alert-box error .
      476       undo, return error return-value .
      477     end.
      478     assign
      479       p-fact-order           = v-fact-date-num
      480                              + v-shift-offset * 0.5
      481                              + p-shift-num    * 0.02 - 0.01
      482                              + p-fact-num     * 0.0000000001
      483       p-shift-end-fact-order = v-fact-date-num
      484                              + v-shift-offset * 0.5
      485                              + p-shift-num    * 0.02
      486       p-day-end-fact-order   = v-fact-date-num
      487                              + 0.99
      488     .
      489     if p-fact-order           <= v-fact-date-num
      490     or p-shift-end-fact-order <= v-fact-date-num
      491     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      492     or p-shift-end-fact-order >= p-day-end-fact-order
      493     then do:
      494       message
      495         vss-workfile vss-revision vss-description skip
      496         "Внутренняя ошибка при генерации фактического номера" skip
      497         "p-fact-date"            p-fact-date            skip
      498         "p-fact-time"            p-fact-time            skip
      499         "p-fact-num"             p-fact-num             skip
      500         "p-shift-date"           p-shift-date           skip
      501         "p-shift-num"            p-shift-num            skip
      502         "p-shift-on"             p-shift-on             skip
      503         "p-shift-end-fact-order" p-shift-end-fact-order skip
      504         "p-day-end-fact-order"   p-day-end-fact-order   skip
      505         "v-fact-date-num"        v-fact-date-num        skip
      506         view-as alert-box error .
      507       undo, return error return-value .
      508     end.
      509   end procedure.
      510   procedure day-begin-fact-order :
      511     define input  parameter p-fact-date            as date    no-undo .
      512     define output parameter p-day-begin-fact-order as decimal no-undo .
      513     do
      514     on error undo, return error return-value
      515     :
      516       if p-fact-date = ?
      517       then do:
      518         assign
      519           p-day-begin-fact-order = 0
      520         .
      521       end.
      522       else do:
      523         assign
      524           p-day-begin-fact-order = integer(p-fact-date)
      525         .
      526       end.
      527     end.
      528   end procedure.
      529   procedure factord-max-fact-order :
      530     define output parameter p-max-fact-order as decimal   no-undo .
      531     do
      532     on error undo, return error return-value
      533     :
      534       run day-begin-fact-order in this-procedure
      535         (input  date(1, 1, 5000)
      536         ,output p-max-fact-order
      537         ) .
      538     end.
      539   end procedure.
      540   procedure factord-cut-archive :
      541     define input  parameter p-obj-type             as character no-undo .
      542     define input  parameter p-obj-code             as integer   no-undo .
      543     define input  parameter p-fact-date            as date      no-undo .
      544     define output parameter p-shift-on             as logical   no-undo .
      545     define output parameter p-shift-date           as date      no-undo .
      546     define output parameter p-shift-num            as integer   no-undo .
      547     define output parameter p-day-end-fact-order   as decimal   no-undo .
      548     define output parameter p-shift-end-fact-order as decimal   no-undo .
      549     define variable v-fact-order as decimal   no-undo .
      550     define buffer buf_shift-obj for ub.shift-obj .
      551     do
      552     on error undo, return error return-value
      553     :
      554   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      556     (input  p-obj-type
      557     ,input  p-obj-code
      558     ,input  'shift-on=request'
      559     ,output p-shift-on
      560     ) no-error .
      561       if error-status :error
      562       then do:
      563         message
      564           vss-workfile vss-revision vss-description skip
      565           "Ошибка при определении атрибута объекта" skip
      566           "Объект" p-obj-type p-obj-code skip
      567           error-status :get-message(1) skip
      568           return-value skip
      569           view-as alert-box error .
      570         undo, return error return-value .
      571       end.
      572       if p-shift-on = false
      573       then do:
      574         assign
      575           p-shift-date               = ?
      576           p-shift-num                = 0
      577         .
      578       end.
      579       else do:
      580         find first buf_shift-obj share-lock
      581           where buf_shift-obj.obj-type   = p-obj-type
      582             and buf_shift-obj.obj-code   = p-obj-code
      583             and buf_shift-obj.shift-date > p-fact-date
      584           use-index pi
      585           no-error .
      586         if not available buf_shift-obj
      587         or buf_shift-obj.status_ <> 'зкр':U
      588         then do:
      589           message
      590             vss-workfile vss-revision vss-description skip
      591             "Невозможно вычислить последнюю смену" skip
      592             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      593             "Объект" p-obj-type p-obj-code skip
      594             "Дата" p-fact-date skip
      595             view-as alert-box error .
      596           undo, return error return-value .
      597         end.
      598         find last buf_shift-obj share-lock
      599           where buf_shift-obj.obj-type = p-obj-type
      600             and buf_shift-obj.obj-code = p-obj-code
      601             and buf_shift-obj.shift-date <= p-fact-date
      602           use-index pi
      603           no-error .
      604         if available buf_shift-obj
      605         then do:
      606           if  buf_shift-obj.status_ = 'зкр':U
      607           then do:
      608             assign
      609               p-shift-date = buf_shift-obj.shift-date
      610               p-shift-num  = buf_shift-obj.shift-num
      611             .
      612           end.
      613           else do:
      614             message
      615               vss-workfile vss-revision vss-description skip
      616               "Невозможно вычислить последнюю смену" skip
      617               "Статус смены отличен от статуса" 'зкр':U skip
      618               "Объект" p-obj-type p-obj-code skip
      619               "Дата" p-fact-date skip
      620               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      621               view-as alert-box error .
      622             undo, return error return-value .
      623           end.
      624         end.
      625         else do:
      626           assign
      627             p-shift-date = p-fact-date - 1
      628             p-shift-num  = 1
      629           .
      630         end.
      631       end.
      632       run factord in this-procedure
      633         (input  p-fact-date
      634         ,input  1
      635         ,input  1
      636         ,input  p-shift-date
      637         ,input  p-shift-num
      638         ,input  p-shift-on
      639         ,output v-fact-order
      640         ,output p-shift-end-fact-order
      641         ,output p-day-end-fact-order
      642         ) no-error .
      643       if error-status :error
      644       then do:
      645         message
      646           vss-workfile vss-revision vss-description skip
      647           "Ошибка при вызове процедуры factord"
      648           error-status :get-message(1) skip
      649           return-value skip
      650           view-as alert-box error .
      651         undo, return error return-value .
      652       end.
      653     end.
      654   end procedure.
      655   procedure factord-lock-shift :
      656     define input  parameter p-obj-type  as character no-undo .
      657     define input  parameter p-obj-code  as integer   no-undo .
      658     define input  parameter p-fact-date as date      no-undo .
      659     define parameter buffer buf_shift-obj for ub.shift-obj .
      660     define variable v-shift-on      as logical   no-undo .
      661     define variable v-extra-message as character no-undo .
      662     define variable v-error as character no-undo .
      663     do
      664     on error undo, return error return-value
      665     :
      666   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      668     (input  p-obj-type
      669     ,input  p-obj-code
      670     ,input  'shift-on=request'
      671     ,output v-shift-on
      672     ) no-error .
      673       if error-status :error
      674       then do:
      675         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      676         undo, return error v-error .
      677       end.
      678       if v-shift-on = true
      679       then do:
      680         find first buf_shift-obj share-lock
      681           where buf_shift-obj.obj-type   = p-obj-type
      682             and buf_shift-obj.obj-code   = p-obj-code
      683             and buf_shift-obj.shift-date > p-fact-date
      684           use-index pi
      685           no-error .
      686         if not available buf_shift-obj
      687         or buf_shift-obj.status_ <> 'зкр':U
      688         then do:
      689           find last buf_shift-obj
      690             where buf_shift-obj.obj-type = p-obj-type
      691               and buf_shift-obj.obj-code = p-obj-code
      692               and buf_shift-obj.status_  = 'зкр':U
      693             use-index stts
      694             no-error .
      695           if available buf_shift-obj
      696           then do:
      697             assign
      698               v-extra-message =
      699                     substitute("Дата начала последеней закрытой смены на объекте &1"
      700                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      701                               )
      702             .
      703           end.
      704           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      705           undo, return error v-error .
      706         end.
      707       end.
      708     end.
      709   end procedure.
      710   procedure factord-end-day :
      711     define input  parameter p-fact-date            as date    no-undo .
      712     define output parameter p-day-end-fact-order   as decimal no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716       if p-fact-date = ?
      717       then do:
      718         return error "Не указана фактическая дата" .
      719       end.
      720       assign
      721         p-day-end-fact-order = integer(p-fact-date) + 0.99
      722       .
      723     end.
      724   end procedure.
      725   procedure factord-to-date :
      726     define input  parameter p-fact-order as decimal no-undo .
      727     define output parameter p-fact-date  as date    no-undo .
      728     define variable v-ref-date  as date      no-undo .
      729     define variable v-ref-delta as integer   no-undo .
      730     do
      731     on error undo, return error return-value
      732     :
      733       if p-fact-order = ?
      734       or p-fact-order = 0
      735       then do:
      736         return error "Не указан fact-order" .
      737       end.
      738       assign
      739         v-ref-date  = date(1, 1, 2000)
      740       .
      741       assign
      742         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      743       .
      744       assign
      745         p-fact-date = v-ref-date + v-ref-delta
      746       .
      747     end.
      748   end procedure.
      749   procedure factord-to-fact-num :
      750     define input  parameter p-fact-order as decimal no-undo .
      751     define output parameter p-fact-num   as integer no-undo .
      752     define variable v-fact-order-trunc as decimal no-undo .
      753     do
      754     on error undo, return error return-value
      755     :
      756       if p-fact-order = ?
      757       or p-fact-order = 0
      758       then do:
      759         return error "Не указан fact-order" .
      760       end.
      761       assign
      762        v-fact-order-trunc = truncate(p-fact-order, 2)
      763       .
      764       assign
      765         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      766       .
      767     end.
      768   end procedure.
      769   procedure factord-to-shift-num :
      770     define input  parameter p-fact-order as decimal no-undo .
      771     define output parameter p-shift-num   as integer no-undo .
      772     define variable  p-shift-numd  as decimal   no-undo .
      773     define variable v-fact-order-trunc as decimal no-undo .
      774     do
      775     on error undo, return error return-value
      776     :
      777       if p-fact-order = ?
      778       or p-fact-order = 0
      779       then do:
      780         return error "Не указан fact-order" .
      781       end.
      782       assign
      783        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      784       .
      785       if v-fact-order-trunc < 0.5 then do:
      786         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      787       end.
      788       assign
      789         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      790         .
      791        assign
      792         p-shift-num = truncate (p-shift-numd , 0)
      793       .
      794     end.
      795   end procedure.
      796   define new global shared variable g#lib-trn  as handle no-undo .
      797   define new global shared variable g#lib-trn2 as handle no-undo .
      798   define new global shared variable g#lib-trn3 as handle no-undo .
      799   define new global shared variable g#lib-trn4 as handle no-undo .
      800   define temp-table  tt-tax no-undo
      801     field tax-code    like ub.tax.tax-code
      802     field individual  like ub.tax.individual
      803     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      804     field rate-code   like ub.tax-rate.rate-code
      805     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      806     field tax-type    like ub.tax.tax-type
      807     field rate-value  like ub.tax-rate-value.rate-value
      808     field tax-rate-gds-rc  as recid
      809     field to-cashdesk like ub.tax.to-cashdesk
      810     index tax-code is unique primary tax-code
      811     .
      812   procedure tax-val :
      813     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      814     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      815     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      816     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      817     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      818     define input  parameter       parunits-type like ub.units.type         no-undo.
      819     define input  parameter       parrec-id     as recid                   no-undo.
      820     define input  parameter       paris-log     as logical                 no-undo.
      821     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      822     define input  parameter       vattaxcdvalue as integer                 no-undo.
      823     define input  parameter       exctaxcdvalue as integer                 no-undo.
      824     define input  parameter       only-check    as logical                 no-undo.
      825     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      826     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      827     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      828     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      829     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      830     define output parameter       parerr-mes    as character               no-undo.
      831     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      832     do
      833     on error undo, return error return-value
      834     :
      835   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      837   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      838   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      839   define variable gp-excise     like ub.price-list.excise     no-undo.
      840   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      841   define variable gp-fact-order as decimal   no-undo .
      842   define variable gp-price-sale-parts as decimal   no-undo .
      843       define buffer buf_tax          for ub.tax .
      844       define buffer buf_tax-rate     for ub.tax-rate .
      845       define buffer buf_tax-units    for ub.tax-units .
      846       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      847       define buffer buf_goods        for ub.goods .
      848       define buffer buf_bar-code     for ub.bar-code .
      849       define buffer buf_prod-bc      for ub.prod-bc .
      850       define buffer buf_units        for ub.units .
      851       define buffer buf_shop         for ub.shop .
      852       define buffer buf_store        for ub.store .
      853       define buffer buf_gds-prt      for ub.gds-prt .
      854       define buffer buf_tt-tax       for tt-tax .
      855       define variable varrate-value    as decimal   initial ? no-undo.
      856       define variable pr-list-recid    as recid     initial ? no-undo.
      857       define variable varmes           as character no-undo.
      858       define variable varfactorrtvalue as char      initial ? no-undo.
      859       define variable varfactorrttype  as char      initial ? no-undo.
      860       define variable is-petrolium     as logical no-undo.
      861       define variable is-pieces        as logical no-undo.
      862       define variable vargds-code      like ub.goods.gds-code no-undo.
      863       define variable pargds-code      like ub.goods.gds-code no-undo.
      864       define variable var-fact-order   as decimal no-undo .
      865       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      866       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      867       define variable currate-gds-rc   as recid no-undo .
      868       define variable v-today          as date no-undo .
      869       define variable v-time           as integer no-undo .
      870       for each buf_tt-tax:
      871         delete buf_tt-tax.
      872       end.
      873       run cur-time in this-procedure(output v-today, output v-time).
      874       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      875       if parartic     = ?
      876       or parprod-type = ?
      877       or parprod-code = ?
      878       or parunit-base = ?
      879       then do:
      880         find first buf_goods no-lock
      881           where recid(buf_goods) = parrec-id
      882           no-error .
      883       end.
      884       else do:
      885         find first buf_goods no-lock
      886           where buf_goods.artic = parartic
      887             and buf_goods.prod-type = parprod-type
      888             and buf_goods.prod-code = parprod-code
      889           no-error .
      890       end.
      891       if not available buf_goods then do:
      892         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      893         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      894       end.
      895       assign
      896         parartic     = buf_goods.artic
      897         parprod-type = buf_goods.prod-type
      898         parprod-code = buf_goods.prod-code
      899         parunit-base = buf_goods.unit-base
      900         pargds-code  = buf_goods.gds-code
      901       .
      902       if parunits-type = ?
      903       then do:
      904         find buf_units no-lock
      905           where buf_units.unit-name = parunit-base
      906           no-error .
      907         if not available buf_units then do:
      908           assign
      909             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      910           .
      911           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      912         end.
      913         assign
      914           parunits-type = buf_units.type
      915         .
      916       end.
      917       if parhost-code = ?
      918       or parhost-code = 0
      919       then do:
      920   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      922     (input  parobj-type
      923     ,input  abs(parobj-code)
      924     ,output parhost-code
      925     ) no-error .
      926         if error-status :error then do:
      927           assign
      928             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      929               ,string(parobj-type)
      930               ,string(parobj-code)
      931               ) + chr(10)
      932           .
      933           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      934         end.
      935       end.
      936       assign
      937         vargds-code = buf_goods.gds-code
      938       .
      939       for each buf_tax-units no-lock
      940         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      941       ,first buf_tax no-lock
      942         where buf_tax.tax-code = buf_tax-units.tax-code
      943       :
      944         find first buf_tt-tax where
      945                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      946         if not available buf_tt-tax then do:
      947           create buf_tt-tax .
      948         end.
      949         assign
      950           buf_tt-tax.tax-code = buf_tax.tax-code
      951         .
      952         if buf_tax.individual = false then do:
      953           assign
      954             currate-gds-rc = ?
      955           .
      956           _tax-rate-gds:
      957           for each buf_tax-rate-gds no-lock where
      958                   buf_tax-rate-gds.gds-code = pargds-code and
      959                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      960           first buf_tax-rate where
      961                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      962                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      963           by buf_tax-rate-gds.host-code
      964           by buf_tax-rate-gds.obj-type
      965           by buf_tax-rate-gds.obj-code
      966           by buf_tax-rate-gds.fact-order
      967           :
      968             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      969               next _tax-rate-gds.
      970             end.
      971             if buf_tax-rate-gds.host-code = 0 or
      972               ((buf_tax-rate-gds.host-code = parhost-code) or
      973               (buf_tax-rate-gds.obj-type = parobj-type AND
      974               buf_tax-rate-gds.obj-code = parobj-code))
      975             then do:
      976               assign
      977               currate-code = buf_tax-rate.rate-code
      978               currate-name = buf_tax-rate.rate-name
      979               currate-gds-rc = recid(buf_tax-rate)
      980               .
      981             end.
      982             else do:
      983               next _tax-rate-gds.
      984             end.
      985           end.
      986           if currate-gds-rc = ? then do:
      987             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      988                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      989                             chr(10).
      990             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      991           end.
      992         end.
      993         assign
      994           buf_tt-tax.rate-code   = currate-code
      995           buf_tt-tax.individual  = buf_tax.individual
