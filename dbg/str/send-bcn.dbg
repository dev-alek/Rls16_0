     9302         assign
     9303         std-disc-lim = cash-dis-time-rule.date-to
     9304         .
     9305         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
     9306         assign
     9307         std-disc-dec = 0
     9308         std-disc-reason = 0
     9309         .
