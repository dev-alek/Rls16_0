    11298         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    11299         if ncr-disc-string <> '':U then
    11300         PUT stream IBMstream unformatted
    11301         chr(32)
    11302         "X":U
    11303         chr(32)
    11304         IBm-good-code
    11305         chr(32)
    11306         chr(32)
    11307         ncr-disc-string
    11308         chr(10)
    11309         .
    11310       end.
    11311     end.
    11312     if pos-type = 'NCR-AS@R':U
    11313     and cash-gds.kat-discnt-rule <> 0
    11314     then do:
    11315       case how-pcnt-kat :
    11316         when 'pcnt-kat-pdf':U then do:
    11317             v-kat-discnt = cash-gds.price-sale.
    11318           end.
    11319         otherwise do:
    11320           v-kat-discnt = ?.
