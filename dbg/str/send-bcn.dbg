     6112   procedure fact-order-mpl :
     6113     do
     6114     on error undo, return error return-value
     6115     :
     6116   define input  parameter p-doc-date as date     no-undo .
     6117   define input  parameter p-obj-type as character no-undo .
     6118   define input  parameter p-obj-code as integer   no-undo .
     6119   define output parameter p-fact-order as decimal   no-undo .
     6120   define variable v-fact-date            as date    no-undo .
     6121   define variable v-fact-time            as integer no-undo .
     6122   define variable v-fact-order           as decimal no-undo .
     6123   define variable v-shift-end-fact-order as decimal no-undo .
     6124   define variable v-day-end-fact-order   as decimal no-undo .
     6125   define variable l-shift-on as logical no-undo .
     6126   define variable l-date as date      no-undo .
     6127   define variable l-time as integer   no-undo .
     6128   define variable shift-date as date      no-undo .
     6129   define variable shift-num  as integer   no-undo .
     6130   define variable shift-name as character no-undo .
     6131   define variable max-fact-order as decimal   no-undo .
     6132   define buffer buf_global-state for ub.global-state  .
     6133   find first buf_global-state no-lock no-error .
     6134   if not available buf_global-state then do:
     6135      message
     6136        "Не заданы параметры ценообразования!"
     6137        view-as alert-box error
     6138      .
     6139      return error return-value .
     6140   end.
     6141     run cur-time in this-procedure
     6142     ( output v-fact-date ,
     6143       output v-fact-time  ).
     6144   if p-doc-date = ? then do:
     6145   if buf_global-state.pl-use-sys-date-time  = true then do:
     6146         run factord in this-procedure
     6147           (input  v-fact-date
     6148           ,input  v-fact-time
     6149           ,input  v-fact-time
     6150           ,input  ?
     6151           ,input  ?
     6152           ,input  false
     6153           ,output v-fact-order
     6154           ,output v-shift-end-fact-order
     6155           ,output v-day-end-fact-order
     6156           ) no-error .
     6157         if error-status :error
     6158         or v-fact-order = ?
     6159         or v-fact-order = 0 then do:
     6160           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6161         end.
     6162         p-fact-order = v-fact-order .
     6163   end.
     6164   else do:
     6165   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6166   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6167     (input  p-obj-type
     6168     ,input  p-obj-code
     6169     ,input  'shift-on=request'
     6170     ,output l-shift-on
     6171     ) no-error .
     6172         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6173         if p-doc-date <> ? then do:
     6174         end.
     6175          run gbl/factdate.p
     6176          ( input        p-obj-type  ,
     6177            input        p-obj-code  ,
     6178            input-output v-fact-date ,
     6179            input-output v-fact-time ,
     6180            input-output shift-date      ,
     6181            input-output shift-num       ,
     6182            input-output shift-name      ,
     6183            input        yes
     6184            ) no-error .
     6185         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6186         run factord in this-procedure
     6187           (input  v-fact-date
     6188           ,input  v-fact-time
     6189           ,input  v-fact-time
     6190           ,input  shift-date
     6191           ,input  shift-num
     6192           ,input  l-shift-on
     6193           ,output v-fact-order
     6194           ,output v-shift-end-fact-order
     6195           ,output v-day-end-fact-order
     6196           ) no-error .
     6197         if error-status :error
     6198         or v-fact-order = ?
     6199         or v-fact-order = 0 then do:
     6200           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6201         end.
     6202         p-fact-order = v-fact-order .
     6203   end.
     6204   end.
     6205   else do:
     6206          run gbl/factdate.p
     6207          ( input        p-obj-type  ,
     6208            input        p-obj-code  ,
     6209            input-output v-fact-date ,
     6210            input-output v-fact-time ,
     6211            input-output shift-date      ,
     6212            input-output shift-num       ,
     6213            input-output shift-name      ,
     6214            input        yes
     6215            ) no-error .
     6216         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6217         v-fact-date = p-doc-date .
     6218         run factord in this-procedure
     6219           (input  v-fact-date
     6220           ,input  v-fact-time
     6221           ,input  v-fact-time
     6222           ,input  shift-date
     6223           ,input  shift-num
     6224           ,input  l-shift-on
     6225           ,output v-fact-order
     6226           ,output v-shift-end-fact-order
     6227           ,output v-day-end-fact-order
     6228           ) no-error .
     6229         if error-status :error
