     8445   if NOT (ub.shop.cd-bc-base OR ub.shop.cd-bc-alt OR ub.shop.cd-loc-base OR ub.shop.cd-loc-alt) then return.
     8446   FOR EACH bc-list NO-LOCK BREAK by bc-list.gds-code:
     8447     if NOT (action = "D") = bc-list.del then NEXT.
     8448     if first-of(bc-list.gds-code) then new-good = yes.
     8449     else new-good = no.
     8450     RUN term-prt no-error.
     8451     if error-status:error then return error.
     8452     if return-value = "NEXT" then NEXT.
     8453   END.
     8454   if can-find(first cash-gds) then
     8455   RUN SENDING no-error.
     8456   if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     8457   FOR EACH cash-gds:
     8458       delete cash-gds.
     8459   END.
     8460   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8461   PROCEDURE term-prt.
     8462   DEFINE var incode like ub.bar-code.in-code no-undo.
