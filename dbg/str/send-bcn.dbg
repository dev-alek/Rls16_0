     8649         run clntattr-value in this-procedure  ( input 'маг':U
     8650                                               , input ub.shop.obj-code
     8651                                               , input "envd"
     8652                                               , output v-attr-val
     8653                                               , output v-attr-type
     8654                                               ) no-error.
     8655         if tax-cass and new-good then do:
     8656             tax-string = "".
     8657             _tt-tax:
