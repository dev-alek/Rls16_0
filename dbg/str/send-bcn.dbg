     9342               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9343     if available cash-dis-rule
     9344              and cash-dis-rule.is-term = yes then do:
     9345       if cash-dis-rule.time-rule-num > 0 then do:
     9346         find first cash-dis-time-rule no-lock where
     9347                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9348         if available cash-dis-time-rule
     9349         and cash-dis-time-rule.templ-rl-root = 50001
     9350             or
     9351             (
     9352              (
     9353               (cash-dis-time-rule.date-from < today)
     9354               or
     9355               (cash-dis-time-rule.date-from = 12/31/1989)
     9356              )
     9357             and
     9358             (
     9359              (cash-dis-time-rule.date-to >= today)
     9360              or
     9361              (cash-dis-time-rule.date-to = 12/31/1989)
     9362             )
     9363            ) then do:
     9364            temp-disc-dec = ?.
     9365         end.
     9366         else do:
     9367           assign
     9368           temp-disc-dec = 0
     9369           .
     9370         end.
     9371       end.
     9372       else do:
     9373         temp-disc-dec = ?.
     9374       end.
     9375       if temp-disc-dec = ? then do:
     9376         case cash-dis-rule.value-type:
     9377           when integer('1':U) then do:
     9378         assign
     9379         temp-disc-dec = - cash-dis-rule.discnt-value
     9380         .
     9381       end.
     9382           when integer('11':U) then do:
     9383             find first cash-gds-discnt where
     9384                       cash-gds-discnt.b-code = cash-gds.b-code
     9385                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9386                   and cash-gds-discnt.obj-type = 'маг':U
     9387                   and cash-gds-discnt.obj-code = i-obj-code
     9388                   no-error.
     9389             if available cash-gds-discnt then do:
     9390               assign
     9391               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
     9392               .
     9393             end.
     9394             else do:
     9395              assign
     9396               temp-disc-dec = 0.
     9397             end.
     9398           end.
     9399           otherwise do:
     9400             temp-disc-dec = 0.
     9401           end.
     9402         end case.
     9403       end.
     9404     end.
     9405   end.
