    11328                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    11329                                                   ,input 'time-rule-num':U
    11330                                                   ,input v-kat-discnt
    11331                                                   ) no-error .
    11332       if error-status:error then do:
