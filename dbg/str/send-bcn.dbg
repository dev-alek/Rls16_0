     9009             return error.
     9010           end.
     9011           assign
     9012             sum69 = sum69 + integer(v-sum-char69)
     9013           .
     9014         end.
     9015         if varcont69 = yes then do:
     9016           assign
     9017             sum69 = sum69 * 3
     9018           .
     9019           do i69 = 2 to len-code69 by 2
     9020           :
     9021             assign
     9022               v-sum-char69 = substr(IBm-good-code, len-code69 - i69 + 1, 1)
     9023             .
