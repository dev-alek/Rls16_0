     9860           if buf_cash-dis-rule.is-term
     9861           and buf_cash-dis-rule.root then do:
     9862           end.
     9863           else do:
     9864             case buf_cash-dis-rule.value-type:
     9865               when integer('1':U) then do:
     9866                 assign
     9867                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
     9868                 .
     9869               end.
     9870               when integer('11':U) then do:
     9871                 find first cash-gds-discnt where
