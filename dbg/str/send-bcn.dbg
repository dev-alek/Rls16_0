    11210       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    11211       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    11212       then "2":U
    11213       else "0":U)
    11214       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    11215        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    11216        or is-sc
    11217        then "1":U
    11218        else "0":U)
    11219         (if pos-type = 'NCR-GM':U or
    11220         wd-option = 0
    11221         then   ncrdsc
    11222         else '0':U)
    11223        (if cash-gds.vat-code = ? or
    11224        cash-gds.vat-code > 7 then
    11225        "0"
    11226        else string(cash-gds.vat-code, "9"))
    11227       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    11228       or (is-sc
    11229       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    11230       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    11231       and  (cash-gds.taracode  <> '':u
    11232            or taracode-bc <> '')
    11233       then (if taracode-bc <> ''
    11234             then taracode-bc
    11235             else cash-gds.taracode)
    11236       else '00'
    11237       )
    11238       (if cash-gds.unit-cli begins "№"
    11239        then substring(cash-gds.unit-cli, 2, 2)
    11240        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    11241       "0010":U
    11242       "0000":U
    11243       chk_name
    11244       fill(chr(32), 4)
    11245       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    11246       fill(chr(32), 8)
    11247       conf-par
    11248       replace(string( cash-gds.price-sale, "999999.99")
