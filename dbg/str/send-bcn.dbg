    12259       , input 1
    12260       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
    12261                           , (out + fname)
    12262                           , chr(10)
    12263                           , (out + fname + '.tsk')
    12264                           )
    12265                                          ).
    12266   run str/runtekka.p (
    12267                        input parparentproc
    12268                       ,input p-parent-handle
    12269                       ,input p-log-handle
    12270                       ,input out
    12271                       ,input out
    12272                       ,input fname
