    12040     then do:
    12041   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12042   output stream IBMStream close.
    12043   define variable v-kat-file-number as integer no-undo .
    12044   if action = 'D':U then do:
    12045     do v-kat-file-number = 0 to 99:
    12046       if v-kat-file-number > 0
    12047       and v-kat-file-number < 10 then NEXt.
    12048       assign                                                                                 v-temp-kat-file = out + fname + '.' + string(v-kat-file-number)                     v-kat-file = (if v-kat-file-number  > 0                                                          then (entry(1, out2, chr(4))   + 'group_':U  + string(v-kat-file-number))                   else (entry(2, out2, chr(4))   + 's_plurbt':U ))                               + '.dat':u                                                                v-updated-subject-dis-kat = no.                                                        if ncr-save-param <> 'no' then do:                                                       v-kat-file-save = if ncr-save-param = 'NCR'                                                              then replace(v-kat-file, '.dat', '.sav')                                                else search((if v-kat-file-number  > 0                                                          then ('group_':U  + string(v-kat-file-number))                                      else 's_plurbt':U) + '.sav':U).                         end.
    12049       V-NEXT = NO.
    12050       if search(v-kat-file) = ? then do:
    12051         next .
    12052       end.
    12053       if ncr-save-param <> 'no':U then do:                                                     if search(v-kat-file-save) <> ? then do:                                               input stream bar from value(v-kat-file-save) convert source "ibm866" .                 repeat:                                                                                  import stream bar unformatted ss.                                                      find first cash-ncr-save-param where                                                            cash-ncr-save-param.dis-kat = v-kat-file-number                                 AND cash-ncr-save-param.cd-line = substring(ss, 1, 24) no-error.                  if not available cash-ncr-save-param then do:                                            create cash-ncr-save-param.                                                            assign                                                                                 cash-ncr-save-param.dis-kat = v-kat-file-number                                     cash-ncr-save-param.cd-line = substring(ss, 1, 24)                                     cash-ncr-save-param.cd-other = substring(ss, 25)                                       .                                                                                    end.                                                                                 end.                                                                                   input stream bar close .                                                               end.                                                                                   else do:                                                                               end.                                                                                 end.
    12054       input stream bar from value(v-kat-file) convert source "ibm866" .
