     8834   END PROCEDURE.
     8835   run finish-send in this-procedure no-error .
     8836   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8837   procedure ibm-gdsc :
     8838   define input  parameter p-zeros         as logical no-undo .
     8839   define output parameter IBM-good-code as character no-undo .
     8840   define output parameter IBM-good-code-2 as character no-undo .
     8841   define output parameter IBM2-short      as character no-undo .
     8842   define variable v-delim as character no-undo .
     8843   define variable v-format-str-16 as character no-undo .
     8844     do
     8845     on error undo, return error
     8846     :
     8847       if p-zeros then do:
     8848         assign
     8849         v-delim = '0'
     8850         v-format-str-16 =  "9999999999999999"
     8851         .
     8852       end.
     8853       else do:
     8854         assign
     8855         v-delim = chr(32)
     8856         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
     8857         .
     8858       end.
     8859       if cash-gds.b-str = "" then do:
     8860         assign
     8861         b_code = string( cash-gds.b-code, v-format-str-16 ) .
     8862         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
     8863         or cash-gds.unit-base <> cash-gds.unit-cli
     8864         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
     8865         then
     8866         do:
     8867           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8868               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8869             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8870             iBM2-short = bar_code.
     8871             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
     8872           END.
     8873           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8874               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8875             IBM-good-code-2 = b_code.
     8876           end.
     8877         end.
     8878       end.
     8879       else do:
     8880         IBm-good-code =
     8881         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8882           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8883            or
     8884            cash-gds.bc-on-type = 'pglc':U)
     8885         then string( decimal( cash-gds.b-str ), v-format-str-16)
