     9878                   assign
     9879                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
     9880                   .
     9881                 end.
     9882                 else do:
     9883                   assign
     9884                   temp-disc-dec = 0.
     9885                 end.
     9886               end.
     9887               otherwise do:
     9888                 temp-disc-dec = 0.
     9889               end.
     9890             end case.
     9891           end.
