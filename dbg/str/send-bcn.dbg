     9046                .
     9047              end.
     9048           end.
     9049         end.
     9050       end.
     9051     end.
     9052             end.
     9053             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     9054                cash-gds.bc-on-type = 'pglc':U
     9055                then do:
     9056   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
