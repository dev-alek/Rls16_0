     7235   def var vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7236   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7237   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7238   procedure create-dis-rule :
     7239   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7240   define input parameter p-tree as logical no-undo .
     7241   define buffer buf_dis-rule for ub.dis-rule.
     7242   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7243   define buffer term_dis-rule for ub.dis-rule.
     7244   define buffer term_dis-time-rule for ub.dis-time-rule.
     7245   define buffer root_cash-dis-rule for cash-dis-rule.
     7246   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7247   define buffer term_cash-dis-rule for cash-dis-rule.
     7248   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7249     do
     7250     on error undo, return error
     7251     :
     7252       find first root_cash-dis-rule no-lock where                                                         ~
     7253                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7254       if not available root_cash-dis-rule then do:
     7255         find first buf_dis-rule no-lock where
     7256                   buf_dis-rule.rule-num = p-rule-num no-error.
     7257         if available buf_dis-rule then do:
     7258           if buf_dis-rule.time-rule-num <> 0 then do:
     7259             find first buf_dis-time-rule no-lock where
     7260                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7261           end.
     7262           create root_cash-dis-rule.
     7263           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7264           if available buf_dis-time-rule then do:
     7265             find first root_cash-dis-time-rule no-lock where
     7266                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7267             if not available root_cash-dis-time-rule then do:
     7268               create root_cash-dis-time-rule.
     7269               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7270             end.
     7271           end.
     7272           else do:
     7273             assign
     7274             root_cash-dis-rule.time-rule-num = 0.
     7275           end.
     7276           if buf_dis-rule.uniq-field <> "":U then do:
     7277             for each term_dis-rule no-lock where
     7278                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7279               if term_dis-rule.time-rule-num <> 0 then do:
     7280                 find first term_dis-time-rule no-lock where
     7281                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7282               end.
     7283               create term_cash-dis-rule.
     7284               buffer-copy term_dis-rule to term_cash-dis-rule.
     7285               if term_dis-rule.time-rule-num = 0
     7286               or available term_dis-time-rule
     7287               or root_cash-dis-rule.time-rule-num = 0
     7288               then do:
     7289                 if available term_dis-time-rule then do:
     7290                   find first term_cash-dis-time-rule no-lock where
     7291                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7292                   if not available term_cash-dis-time-rule then do:
     7293                     create term_cash-dis-time-rule.
     7294                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7295                   end.
     7296                 end.
     7297               end.
     7298             end.
     7299           end.
     7300         end.
     7301       end.
     7302     end.
     7303   end procedure.
     7304   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7305   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7306   function ncr-amnt-disc returns character (
     7307     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7308   define variable v-result as character no-undo .
     7309   define variable ii as integer no-undo .
     7310   define variable v-entry as character no-undo extent 3.
     7311   for each cash-dis-rule  no-lock where
     7312         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7313     assign
     7314     ii = ii + 1
     7315     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7316                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7317     .
     7318   end.
     7319   if v-entry[2] = "":U then
     7320   assign
     7321   v-entry[2] = v-entry[1]
     7322   .
     7323   if v-entry[3] = "":U then
     7324   assign
     7325   v-entry[3] = v-entry[2]
     7326   .
     7327   assign
     7328   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7329   .
     7330   return v-result.
     7331   END FUNCTION.
     7332   function ncr-date-disc returns character (
     7333     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7334   define variable v-result as character no-undo .
     7335   define variable ii as integer no-undo .
     7336   define variable v-entry as character no-undo extent 3.
     7337   for each cash-dis-rule  no-lock where
     7338         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7339       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7340     assign
     7341     ii = ii + 1
     7342     v-entry[ii] =
     7343                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7344                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7345                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7346                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7347                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7348                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7349                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7350   end.
     7351   if v-entry[2] = "":U then
     7352   assign
     7353   v-entry[2] = v-entry[1]
     7354   .
     7355   if v-entry[3] = "":U then
     7356   assign
     7357   v-entry[3] = v-entry[2]
     7358   .
     7359   assign
     7360   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7361   .
     7362   return v-result.
     7363   END FUNCTION.
     7364   function ncr-temp-disc returns character (
     7365     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7366   define variable v-result as character no-undo .
     7367   define variable ii as integer no-undo .
     7368   define variable v-entry as character no-undo extent 3.
     7369   define variable v-dec as decimal no-undo .
     7370   define variable v-disc-price-sale as decimal no-undo .
     7371   define variable v-pdf-id as integer no-undo .
     7372   define variable v-pdf-db-num as integer no-undo .
     7373   define buffer buf_cash-dis-rule for cash-dis-rule.
     7374   find first buf_cash-dis-rule where
     7375            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7376   if not available buf_cash-dis-rule then return "":U.
     7377   if buf_cash-dis-rule.templ-rl-root <> 29
     7378   and buf_cash-dis-rule.templ-rl-root <> 86
     7379   then do:
     7380     assign
     7381     v-entry[1] =
     7382     "000"                                                   +
     7383     "0"                                                     +
     7384     "0000"                                                  +
     7385     "2359"                                                     +
     7386      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7387      .
     7388   end.
     7389   else do:
     7390     for each cash-dis-rule  no-lock where
     7391           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7392         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7393       case cash-dis-rule.value-type:
     7394         when integer('1':U) then do:
     7395           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7396         end.
     7397         when integer('12':U) then do:
     7398           find first cash-gds-discnt where
     7399                     cash-gds-discnt.b-code = cash-gds.b-code
     7400                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7401                 and cash-gds-discnt.obj-type = 'маг':U
     7402                 and cash-gds-discnt.obj-code = i-obj-code
     7403                 no-error.
     7404           if not available cash-gds-discnt then do:
     7405             v-dec = cash-gds.price-sale.
     7406           end.
     7407           else do:
     7408             assign
     7409             v-dec = cash-gds-discnt.discnt-value
     7410             .
     7411           end.
     7412         end.
     7413         otherwise do:
     7414           v-dec = cash-gds.price-sale.
     7415         end.
     7416       end case.
     7417       assign
     7418       ii = ii + 1
     7419       v-entry[ii] =
     7420                     "000"                                                   +
     7421                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7422                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7423                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7424                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7425                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7426                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7427                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7428                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7429                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7430                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7431                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7432       .
     7433   if ii = 3 then leave.
     7434     end.
     7435   end.
     7436   if v-entry[2] = "":U then
     7437   assign
     7438   v-entry[2] = v-entry[1]
     7439   .
     7440   if v-entry[3] = "":U then
     7441   assign
     7442   v-entry[3] = v-entry[2]
     7443   .
     7444   assign
     7445   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7446   .
     7447   return v-result.
     7448   END FUNCTION.
     7449   function ncr-d-rank returns character (
     7450     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7451   define variable v-result as character no-undo .
     7452   define variable ii as integer no-undo .
     7453   do ii = 1 to length(p-d-rank):
     7454     CASE substr(p-d-rank, ii, 1):
     7455       when "X":U then do:
     7456         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7457       end.
     7458       when "T":U then do:
     7459         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7460       end.
     7461       when "D":U then do:
     7462         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7463       end.
     7464     END CASE.
     7465     if v-result <> "":U then LEAVE.
     7466   end.
     7467   if v-result = "":U then v-result = chr(32).
     7468   return v-result.
     7469   END FUNCTION.
     7470   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7471       define variable v-upper-code as int no-undo.
     7472       define variable v-value as character no-undo.
     7473       define variable v-type as character no-undo.
     7474       define buffer lc_gds-grp for ub.gds-grp.
     7475       define buffer lc_goods for ub.goods.
     7476      if p-gds-code <> 0 then do:
     7477       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7478       v-upper-code = lc_goods.grp-code.
     7479       do while v-upper-code > 0 :
     7480           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7481           run ggoattr-value(
     7482             input lc_gds-grp.node-code,
     7483             input 0,
     7484             input "",
     7485             input 0,
     7486             input 'ban-sales-via-cd':U,
     7487             output v-value,
     7488             output v-type
     7489           ).
     7490          if v-value = "yes" then
     7491             return true.
     7492          else
     7493          do:
     7494             run ggoattr-value(
     7495                input lc_gds-grp.node-code,
     7496                input shop.host-code,
     7497                input "",
     7498                input 0,
     7499                input 'ban-sales-via-cd':U,
     7500                output v-value,
     7501                output v-type
     7502                ).
     7503             if v-value = "yes" then
     7504                return true.
     7505             else
     7506             do:
     7507                run ggoattr-value(
     7508                   input lc_gds-grp.node-code,
     7509                   input shop.host-code,
     7510                   input 'маг':U,
     7511                   input i-obj-code,
     7512                   input 'ban-sales-via-cd':U,
     7513                   output v-value,
     7514                   output v-type
     7515                   ).
     7516                if v-value = "yes" then
     7517                   return true.
     7518                else v-upper-code = lc_gds-grp.upper-code.
     7519             end .
     7520          end.
     7521         end.
     7522       end.
     7523   end.
     7524   FUNCTION convert-tax-code returns integer
     7525                                             ( input p-rate-code as integer
     7526                                              ,input p-cdtaxlst  as character
     7527                                             ) :
     7528   define variable jj as integer no-undo .
     7529     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7530       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7531         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7532       end.
     7533     end.
     7534   END FUNCTION.
     7535   FUNCTION convert-maria-tax-code returns character
     7536                                             ( input p-vat-rate-code as integer
     7537                                              ,input p-slt-rate-code as integer
     7538                                              ,input p-cdtaxlst  as character
     7539                                             ) :
     7540   define variable jj as integer no-undo .
     7541   define variable aa as character no-undo extent 8.
     7542   define variable v-return-value as character no-undo .
     7543     do jj = 1 to 8:
     7544       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7545         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7546           aa[jj] = '1'.
     7547         end.
     7548         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7549           aa[jj] = '1'.
     7550         end.
     7551       end.
     7552       if aa[jj] = '':U then aa[jj] = '0'.
     7553       v-return-value = aa[jj] + v-return-value.
     7554     end.
     7555   return v-return-value.
     7556   END FUNCTION.
     7557   FUNCTION convert-maria-tax-code-2 returns integer
     7558                                             ( input p-rate-code as integer
     7559                                              ,input p-cdtaxlst  as character
     7560                                             ) :
     7561   define variable jj as integer no-undo .
     7562   define variable v-return-value as integer no-undo .
     7563     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7564       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7565         return jj.
     7566       end.
     7567     end.
     7568   return 0.
     7569   END FUNCTION.
     7570   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
