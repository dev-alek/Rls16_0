    11250              )
    11251       chr(10)
    11252       .
    11253       if pos-type = 'NCR-AS@R':U
    11254       and ncrdsc <> '0':U
    11255       and wd-option > 0
    11256       and cash-gds.std-discnt-rule > 0
    11257       then do:
