     7609   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7610   PROCEDURE asc-gds.
     7611   DEFINE parameter buffer loc-goods for ub.goods.
     7612   DEFINE parameter buffer loc-bar-code for bc-list.
     7613   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7614   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7615   DEFINE parameter buffer loc-price-list for ub.price-list.
     7616   DEFINE parameter buffer loc-units for ub.units.
     7617   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7618   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7619   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7620   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7621   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7622   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7623   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7624   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7625   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7626   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7627   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7628   define variable v-disc-price-sale as decimal no-undo .
     7629   define variable v-pdf-id as integer no-undo .
     7630   define variable v-pdf-db-num as integer no-undo .
     7631   define variable v-oss as character no-undo.
     7632   define variable v-gtd as character no-undo .
     7633   define variable v-is-gas as character no-undo .
     7634   define variable v-ban-bonus as character no-undo .
     7635   define variable v-ptrl-as-good as character no-undo .
     7636   define variable v-type as character no-undo .
     7637   define variable disc-b-code as integer no-undo .
     7638   define variable v-main-prt-b-code as integer no-undo .
     7639   define variable IBM-good-code as character no-undo .
     7640   define variable IBM-good-code-2 as character no-undo .
     7641   define variable IBM2-short      as character no-undo .
     7642   define variable v-gds-null-price as character no-undo .
     7643   define variable iii as integer no-undo .
     7644   define variable v-mask-full as character no-undo .
     7645   define variable v-mask-short as character no-undo .
     7646   define variable vKKT as integer no-undo.
     7647   define variable attrValue as character no-undo.
     7648   define variable attrType  as character no-undo.
     7649   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7650   define buffer buf_price-list for ub.price-list.
     7651   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7652   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7653   define buffer main-prt-bar-code  for ub.bar-code.
     7654   define buffer buf_goods-attr for goods-attr.
     7655   define buffer b-code for code.
     7656   if action = "U" then do:
     7657     if loc-bar-code.stts = Integer('79':U) then return.
     7658       for-price = ?.
     7659   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7661     (input  'маг':U
     7662     ,input  ub.shop.obj-code
     7663     ,input  loc-bar-code.b-code
     7664     ,input  main-b-code
     7665     ,input  0
     7666     ,output v-doc-num
     7667     ,output for-price
     7668     ,output for-road
     7669     ,output for-excise
     7670     ) no-error .
     7671       if error-status:error then do:
     7672           if g#news
     7673           or g#auto
     7674           or g#esys
     7675           then return error.
     7676           else do:
     7677               error-status:error = no.
     7678               message "Ошибка при определении цены на товар "
     7679                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7680               view-as alert-box ERROR.
     7681               return.
     7682           end.
     7683       end.
     7684       if return-value = "error" then do:
     7685           if for-price = ? then do:
     7686             return.
     7687           end.
     7688           if not g#news
     7689           and not g#auto
     7690           and not g#esys
     7691           then
     7692           message prichina view-as alert-box ERROR.
     7693           return error.
     7694       end.
     7695       else if (for-price = ? or for-price = 0) then do:
     7696         if v-is-restaurant and v-is-null-price  then do:
     7697           assign
     7698           for-price = 0.
     7699         end.
     7700         else do:
     7701           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7702                                                  ,input 'null-price':U
     7703                                                  ,output v-gds-null-price
     7704                                                  ,output v-type) no-error.
     7705           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7706           return "NEXT".
     7707         end.
     7708       end.
     7709     end.
     7710     else do:
     7711           for-price = 0.
     7712     end.
     7713   for-price = round-m( for-price , rnd-znak ).
     7714   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7715   start-paket = no.
     7716   if not avail cash-gds then do:
     7717   create cash-gds.
     7718   error-status:error = false.
     7719   end.
     7720   cash-gds.crf = cr + 1.
     7721   cr = cr + 1.
     7722   if loc-bar-code.in-code <> ''
     7723   or loc-bar-code.part-code <> ''
     7724   then do:
     7725     find first main-prt-bar-code no-lock where
     7726               main-prt-bar-code.gds-code = loc-goods.gds-code
     7727           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7728           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7729           and main-prt-bar-code.part-code = ''
     7730           and main-prt-bar-code.in-code = '' no-error.
     7731     if available main-prt-bar-code then do:
     7732       v-main-prt-b-code = main-prt-bar-code.b-code.
     7733     end.
     7734   end.
     7735   else do:
     7736     v-main-prt-b-code = loc-bar-code.b-code.
     7737   end.
     7738   find first tt-tax no-lock where
     7739              tt-tax.tax-code = vattaxcd no-error .
     7740   do iii = 1 to num-entries(mask_s-c) :
     7741     assign
     7742       v-mask-full  = trim(entry(iii, mask_s-c))
     7743       v-mask-short = entry(1, v-mask-full, "*")
     7744       loc-prod-bc  = trim(loc-prod-bc)
     7745     .
     7746     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7747       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7748   end.
     7749   define variable vBc-on as logical no-undo.
     7750   if loc-prod-bc ne ?
     7751   then do:
     7752       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7753                            and prod-bc.b-str  eq loc-prod-bc
     7754                            no-lock no-error.
     7755       if available prod-bc
     7756       then
     7757          vBc-on = prod-bc.bc-on.
     7758       else
     7759          vBc-on = yes.
     7760   end.
     7761   else
     7762      vBc-on = yes.
     7763   run gdsoattr-value in this-procedure (
     7764     'dt-seasons':U,
     7765     loc-goods.gds-code,
     7766     parobj-type,
     7767     parobj-code,
     7768     output attrValue,
     7769     output attrType
     7770   ) no-error.
     7771   if attrValue <> "" then do:
     7772     find first b-code where
     7773                b-code.parent = "DTSeasons"
     7774            and b-code.code   = attrValue
     7775          no-lock no-error.
     7776     v-main-prt-b-code = integer(b-code.code).
     7777   end.
     7778   else release b-code.
     7779   assign
     7780   cash-gds.gds-code = loc-goods.gds-code
     7781   cash-gds.artic = loc-goods.artic
     7782   cash-gds.b-code = loc-bar-code.b-code
     7783   cash-gds.main-prt-b-code = v-main-prt-b-code
     7784   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7785   cash-gds.bc-on-type = loc-bc-on-type
     7786   cash-gds.bc-on = vBc-on
     7787   cash-gds.unit-cli = loc-bar-code.unit-cli
     7788   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7789   cash-gds.std-discnt-rule = std-discnt-rule_
     7790   cash-gds.gds-namelong = loc-goods.gds-name
     7791   cash-gds.gds-name = IF nam-2str
     7792                       then if available b-code then b-code.codename else loc-goods.gds-name
     7793                       else (
     7794                             IF nam-artc
     7795                             then loc-goods.artic
     7796                             else if available b-code
     7797                                  then b-code.codename
     7798                                  else (if loc-goods.chk-name <> ""
     7799                                        then loc-goods.chk-name
     7800                                        else loc-goods.gds-name)
     7801                            )
     7802   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7803   cash-gds.unit-base = loc-goods.unit-base
     7804   cash-gds.grp-code = for-grp-code
     7805   cash-gds.fp = for-fp
     7806   cash-gds.ingredient = loc-goods.struct
     7807   cash-gds.producer = for-producer
     7808   cash-gds.producer-int = for-producer-int
     7809   cash-gds.alpha1     = loc-goods.alpha1.
     7810     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7811                                            ,input 'office-type':U
     7812                                            ,output v-oss
     7813                                            ,output v-type) no-error.
     7814   cash-gds.office-type = v-oss.
     7815     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7816                                            ,input 'type-method-calc':U
     7817                                            ,output v-oss
     7818                                            ,output v-type) no-error.
     7819   if v-oss <> "" then
     7820     assign
     7821       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7822       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7823     .
     7824   else
     7825     assign
     7826       cash-gds.CalculationMethod = 0
     7827       cash-gds.CalculationMethodRestr = 0
     7828     .
     7829   assign
     7830   cash-gds.fact-qnty = for-fact-qnty
     7831   cash-gds.okei = loc-bc-units-okei
     7832   cash-gds.kat-discnt-method = kat-discnt-method_
     7833   cash-gds.temp-discnt-method = temp-discnt-method_
     7834   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7835                                then  kat-discnt-rule_pdf
     7836                                else  kat-discnt-rule_)
     7837   cash-gds.date-discnt-rule = date-discnt-rule_
     7838   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7839   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7840   cash-gds.wgd-rule = for-wgd
     7841   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7842                           then 1
     7843                           else 0)
     7844   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7845                        or for-petrol-purse
     7846                        then (cash-gds.gds-stat + 8)
     7847                        else cash-gds.gds-stat)
     7848   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7849                       then (cash-gds.gds-stat + 16)
     7850                       else cash-gds.gds-stat
     7851   cash-gds.gds-stat = if cash-gds.fp
     7852                       then (cash-gds.gds-stat + 2)
     7853                       else cash-gds.gds-stat
     7854   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7855                       then (cash-gds.gds-stat + 128)
     7856                       else cash-gds.gds-stat
     7857   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7858   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7859                                then temp-discnt-rule_pdf
     7860                                else temp-discnt-rule_)
     7861   cash-gds.wd-rule = for-wd
     7862   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7863   cash-gds.need-auth = (if need-auth then 1 else 0)
     7864   cash-gds.price-sale =  for-price
     7865   cash-gds.unit-type = loc-units.type
     7866   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7867   cash-gds.tax-string = tax-string
     7868   cash-gds.new-good = new-good
     7869   cash-gds.rc = recid(loc-goods)
     7870   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7871   cash-gds.vat-pc = (if avail tt-tax
     7872                      then tt-tax.rate-value
     7873                      else 0)
     7874   cash-gds.vat-code = (if avail tt-tax
     7875                        then tt-tax.rate-code
     7876                        else ?)
     7877   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7878   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7879   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7880   cash-gds.fbr-grp-code = v-fbr-grp-code
     7881   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7882   cash-gds.DepartID = v-fbr-obj-code
     7883   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7884   cash-gds.node-code = loc-bar-code.node-code
     7885   cash-gds.taracode = for-taracode
     7886   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7887                            and loc-bar-code.in-code = ""
     7888                            and loc-bar-code.part-code = ""
     7889                            and cash-gds.unit-base = cash-gds.unit-cli
     7890                            then yes
     7891                            else no)
     7892   cash-gds.obj-type = parobj-type
     7893   cash-gds.obj-code = parobj-code
     7894   .
     7895   assign
     7896   cash-gds.gds-name1 =   name-2cdf(
     7897                         input name-2cd
     7898                       , input yes
     7899                       , input cod-pcod
     7900                       , input cash-gds.b-code
     7901                       , input loc-goods.gds-code
     7902                       , input loc-goods.artic
     7903                       , input loc-goods.engl-name
     7904                       , input loc-bar-code.in-code
     7905                       , input loc-bar-code.part-code
     7906                       , input parobj-type
     7907                       , input parobj-code
     7908                       , input loc-goods.alpha1
     7909                       , output v-gtd
     7910                       )
     7911   cash-gds.gtd   = v-gtd
     7912   .
     7913   vKKT = 255.
     7914   find first b-code where
     7915              b-code.parent  = "okei-kkt"
     7916          and b-code.code    = string(cash-gds.okei)
     7917          and b-code.status_ = 0
     7918   no-lock no-error.
     7919   if avail b-code then
     7920      vKKT = integer(b-code.CodeName) no-error.
     7921   if error-status:error then vKKT = 255.
     7922   cash-gds.kkt = vKKT.
     7923   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7924      run gds-attr-value in this-procedure  (
     7925                                             input cash-gds.gds-code
     7926                                            ,input 'fuel-type':U
     7927                                            ,output v-is-gas
     7928                                            ,output v-type) no-error.
     7929      run gds-attr-value in this-procedure  (
     7930                                             input cash-gds.gds-code
     7931                                            ,input 'ptrl-as-good':U
     7932                                            ,output v-ptrl-as-good
     7933                                            ,output v-type) no-error.
     7934      assign
     7935      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7936      no-error .
     7937      assign
     7938      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7939      no-error .
     7940      if cash-gds.is-gas then do:
     7941        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7942      end.
     7943   end.
     7944      run gds-attr-value in this-procedure  (
     7945                                             input cash-gds.gds-code
     7946                                            ,input 'ban-bonus':U
     7947                                            ,output v-ban-bonus
     7948                                            ,output v-type) no-error.
     7949     assign
     7950      cash-gds.wd = int(logical(v-ban-bonus))
     7951      no-error .
     7952   if how-temp-disc = 'temp-disc':U then do:
     7953     case temp-discnt-method_:
     7954       when "" then do:
     7955       end.
     7956       when "bar-code.b-code" then do:
     7957         if loc-bar-code.in-code <> ''
     7958         or loc-bar-code.part-code <> ''
     7959         then do:
     7960           disc-b-code = cash-gds.main-prt-b-code.
     7961         end.
     7962         else do:
     7963           disc-b-code = cash-gds.b-code.
     7964         end.
     7965         find first buf_temp-dis-gds-rule where
     7966                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7967             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7968         if available buf_temp-dis-gds-rule then do:
     7969             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7970         end.
     7971       end.
     7972       otherwise do:
     7973         cash-gds.temp-discnt-rule = 0.
     7974       end.
     7975     end.
     7976   end.
     7977   assign
     7978   cash-gds.gds-name1 =   name-2cdf(
     7979                         input name-2cd
     7980                       , input yes
     7981                       , input cod-pcod
     7982                       , input cash-gds.b-code
     7983                       , input loc-goods.gds-code
     7984                       , input loc-goods.artic
     7985                       , input loc-goods.engl-name
     7986                       , input loc-bar-code.in-code
     7987                       , input loc-bar-code.part-code
     7988                       , input parobj-type
     7989                       , input parobj-code
     7990                       , input loc-goods.alpha1
     7991                       , output v-gtd
     7992                       )
     7993   cash-gds.gtd   = v-gtd
     7994   .
     7995   assign
     7996   cash-gds.ean-lz = ''
     7997   cash-gds.ean-rz = ''
     7998   cash-gds.code-short = ''
     7999   .
     8000   run ibm-gdsc in this-procedure (input no
     8001                                 , output cash-gds.ean-lz
     8002                                 , output cash-gds.ean-rz
     8003                                 , output cash-gds.code-short
     8004                                 ) no-error .
     8005   if new-good then new-good = not new-good.
     8006   if action = "U" then do:
     8007     if cash-gds.kat-discnt-rule <> 0
     8008     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8009     then do:
     8010       for each cash-dis-rule no-lock where
     8011             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8012       :
     8013         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8014                                             ,input 'маг':U
     8015                                             ,input i-obj-code
     8016                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8017                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8018                                             ,input ?
     8019                                             ,output v-disc-price-sale
     8020                                             ,output v-pdf-id
     8021                                             ,output v-pdf-db-num ) no-error.
     8022         if error-status:error
     8023         or v-disc-price-sale = 0
     8024         or v-disc-price-sale = ?
     8025         then do:
     8026         end.
     8027         else do:
     8028           find first  cash-gds-discnt where
     8029                     cash-gds-discnt.b-code = cash-gds.b-code
     8030                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8031                   and cash-gds-discnt.obj-type = parobj-type
     8032                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8033           if not available cash-gds-discnt then do:
     8034             find first  cash-gds-discnt where
     8035                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8036             if not available cash-gds-discnt then do:
     8037               create cash-gds-discnt.
     8038               assign
     8039               cash-gds-discnt.crf = crgd + 1.
     8040             end.
     8041             crgd = crgd + 1.
     8042             assign
     8043             cash-gds-discnt.b-code = cash-gds.b-code
     8044             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8045             cash-gds-discnt.obj-type = parobj-type
     8046             cash-gds-discnt.obj-code = parobj-code
     8047             cash-gds-discnt.discnt-value = v-disc-price-sale
     8048             .
     8049             release cash-gds-discnt.
     8050           end.
     8051         end.
     8052       end.
     8053     end.
     8054     if cash-gds.temp-discnt-rule <> 0
     8055     and how-temp-disc = 'temp-disc-pdf':U
     8056     then do:
     8057       for each cash-dis-rule no-lock where
     8058             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8059         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8060         and cash-dis-rule.is-term = yes
     8061       :
     8062         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8063                                             ,input 'маг':U
     8064                                             ,input i-obj-code
     8065                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8066                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8067                                             ,input ?
     8068                                             ,output v-disc-price-sale
     8069                                             ,output v-pdf-id
     8070                                             ,output v-pdf-db-num ) no-error.
     8071         if error-status:error
     8072         or v-disc-price-sale = 0
     8073         or v-disc-price-sale = ?
     8074         then do:
     8075         end.
     8076         else do:
     8077           find first  cash-gds-discnt where
     8078                     cash-gds-discnt.b-code = cash-gds.b-code
     8079                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8080                   and cash-gds-discnt.obj-type = parobj-type
     8081                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8082           if not available cash-gds-discnt then do:
     8083             find first  cash-gds-discnt where
     8084                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8085             if not available cash-gds-discnt then do:
     8086               create cash-gds-discnt.
     8087               assign
     8088               cash-gds-discnt.crf = crgd + 1.
     8089             end.
     8090             crgd = crgd + 1.
     8091             assign
     8092             cash-gds-discnt.b-code = cash-gds.b-code
     8093             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8094             cash-gds-discnt.obj-type = parobj-type
     8095             cash-gds-discnt.obj-code = parobj-code
     8096             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8097             release cash-gds-discnt.
     8098           end.
     8099         end.
     8100       end.
     8101     end.
     8102   end.
     8103   END PROCEDURE.
