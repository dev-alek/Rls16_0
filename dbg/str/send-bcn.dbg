     4744   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4745   PROCEDURE cd-mrkt_plu-marketer :
     4746   define input parameter p-silence as logical no-undo .
     4747   define parameter buffer buf_cash-desk for ub.cash-desk.
     4748   define input parameter p-id as character no-undo .
     4749   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4750   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4751   define input parameter p-loc-ean as logical no-undo .
     4752   define input parameter p-is-petrolium as logical no-undo .
     4753   define input parameter p-extra as character no-undo .
     4754   define variable v-tot-gds as integer no-undo .
     4755   define variable v-max-gds as integer no-undo .
     4756   define variable v-petrol-start as integer no-undo .
     4757   define variable v-petrol-range as integer no-undo .
     4758   DEFINE VARIABLE v-today as date no-undo .
     4759   DEFINE VARIABLE v-time as integer no-undo .
     4760   define variable v-plu-type as character no-undo .
     4761   define variable v-int as integer no-undo .
     4762   define buffer  buf_cd-plu for ub.cd-plu.
     4763   define buffer  loc_cd-plu for ub.cd-plu.
     4764   define variable  ii as integer no-undo.
     4765   define variable v-mes as character no-undo .
     4766   _main:
     4767   DO ON ERROR undo, leave on stop undo, leave:
     4768     if buf_cash-desk.pos-type <> 'MARIA':U
     4769     or buf_cash-desk.cash-num <> 0 then do:
     4770       assign
     4771       v-mes =
     4772       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4773                 , buf_cash-desk.pos-type).
     4774       if not p-silence then
     4775       message
     4776       v-mes
     4777       view-as alert-box error .
     4778       return error v-mes.
     4779     end.
     4780     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4781                                     ,input 'MARIA_operative':U
     4782                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4783                                           and p-is-petrolium
     4784                                           then 'tot-petrol':U
     4785                                           else 'tot-gds':U)
     4786                                     , output v-mes).
     4787     if v-tot-gds = ? then undo _main, return error v-mes.
     4788     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4789                                     ,input 'MARIA_general':U
     4790                                     ,input 'max-gds':U
     4791                                     ,output v-mes).
     4792     if v-max-gds = ? then undo _main, return error v-mes.
     4793     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4794                                          ,input 'petrolium-range':U
     4795                                          ,input 'petrolium-range':U
     4796                                          ,output v-mes).
     4797     if v-petrol-range = ? then undo _main, return error v-mes.
     4798     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4799       assign
     4800       v-petrol-start = 1
     4801       v-max-gds = (if p-is-petrolium
     4802                    then v-petrol-range
     4803                    else v-max-gds)
     4804       v-plu-type = (if p-is-petrolium
     4805                  then 'топ':U
     4806                  else '':U)
     4807       .
     4808       if p-is-petrolium then do:
     4809         if p-id = '':U then do:
     4810           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4811                               "Невозможно привязать к кассе типа &3"
     4812                               , p-b-str
     4813                               , chr(10)
     4814                               , 'MARIA':U).
     4815           if not p-silence then
     4816           message
     4817           v-mes
     4818           view-as alert-box error .
     4819           return error v-mes.
     4820         end.
     4821         assign
     4822         v-int = integer(p-id)
     4823         no-error
     4824         .
     4825         if error-status:error
     4826         or v-int > v-petrol-range then do:
     4827           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4828                               "в диапазоны номеров резервуаров для кассы типа &4"
     4829                               , p-id
     4830                               , p-b-str
     4831                               , chr(10)
     4832                               , 'MARIA':U).
     4833           if not p-silence then
     4834           message
     4835           v-mes
     4836           view-as alert-box error .
     4837           return error v-mes.
     4838         end.
     4839       end.
     4840     end.
     4841     if buf_cash-desk.pos-type = 'MARIA':U
     4842     and p-is-petrolium then do:
     4843       find first loc_cd-plu where
     4844                loc_cd-plu.obj-type = 'маг':U
     4845            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4846            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4847            and loc_cd-plu.plu-type = 'топ':U
     4848      no-error .
     4849      if available loc_cd-plu then do:
     4850        if loc_cd-plu.b-code = p-b-code
     4851        and loc_cd-plu.b-str = p-b-str then do:
     4852           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4853                               , p-id
     4854                               , p-b-str
     4855                               , chr(10)
     4856                               ).
     4857           if not p-silence then
     4858           message
     4859           v-mes
     4860           view-as alert-box WARNING .
     4861           return v-mes.
     4862        end.
     4863        else do:
     4864           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4865                               "нельзя его привязать к топливу &2&3"
     4866                               , p-id
     4867                               , loc_cd-plu.b-str
     4868                               , chr(10)
     4869                               , p-b-str).
     4870           if not p-silence then
     4871           message
     4872           v-mes
     4873           view-as alert-box error .
     4874           return error v-mes.
     4875        end.
     4876      end.
     4877      ii = v-int.
     4878     end.
     4879     else do:
     4880       DO ii = (if p-is-petrolium
     4881               then v-petrol-start
     4882               else (if buf_cash-desk.pos-type = 'MARIA':U
     4883                    then 1
     4884                    else (if v-petrol-start = 1
     4885                           then (v-petrol-range + 1)
     4886                           else 1)
     4887                   )
     4888               )
     4889         to v-max-gds :
     4890         if not can-find (loc_cd-plu where
     4891                         loc_cd-plu.obj-type = 'маг':U
     4892                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4893                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4894                      and loc_cd-plu.plu-type = v-plu-type
     4895                      and loc_cd-plu.plu-code = ii
     4896                       )
     4897         then LEAVE .
     4898       END .
     4899     end.
     4900     if ii > v-max-gds then do:
     4901         if not p-silence then
     4902         message
     4903         substitute("Превышено максимально допустимое количество &5 &1" +
     4904                   "для касс &2 &3&4"
     4905                   , chr(10)
     4906                   , v-max-gds
     4907                   , 'маг':U
     4908                   , buf_cash-desk.obj-code
     4909                   , (if p-is-petrolium then "топлив" else "товаров")
     4910                   )
     4911         view-as alert-box ERROR .
     4912         undo, return error "max-gds":U.
     4913     end.
     4914     DO ii = (if p-is-petrolium
     4915              then v-petrol-start
     4916              else (if v-petrol-start = 1
     4917                    then (v-petrol-range + 1)
     4918                    else 1)
     4919              )
     4920        to v-max-gds :
     4921       if not can-find (loc_cd-plu where
     4922                         loc_cd-plu.obj-type = 'маг':U
     4923                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4924                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4925                      and loc_cd-plu.plu-type = v-plu-type
     4926                      and loc_cd-plu.plu-code = ii
     4927                      )
     4928       then LEAVE .
     4929     END .
     4930     if ii > v-max-gds then do:
     4931         if not p-silence then
     4932         message
     4933         substitute("Превышено максимально допустимое количество &5 &1" +
     4934                   "для касс &2 &3&4"
     4935                   , chr(10)
     4936                   , v-max-gds
     4937                   , 'маг':U
     4938                   , buf_cash-desk.obj-code
     4939                   , (if p-is-petrolium then "топлив" else "товаров")
     4940                   )
     4941         view-as alert-box ERROR .
     4942         undo, return error "max-gds":U.
     4943     end.
     4944     run cur-time in this-procedure ( output v-today, output v-time).
     4945     create buf_cd-plu.
     4946     assign
     4947     buf_cd-plu.b-code = p-b-code
     4948     buf_cd-plu.b-str = p-b-str
     4949     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4950                                         then buf_cash-desk.addr-path
     4951                                         else "U":U)
     4952     buf_cd-plu.to-send = yes
     4953     buf_cd-plu.charkey_one = "":U
     4954     buf_cd-plu.to-del = no
     4955     buf_cd-plu.plu-code = ii
     4956     buf_cd-plu.obj-type = 'маг':U
     4957     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4958     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4959     buf_cd-plu.plu-type = v-plu-type
     4960     buf_cd-plu.logkey_one = p-loc-ean
     4961     buf_cd-plu.key#_one = integer(p-extra)
     4962     .
     4963     run cd-attr-write  in this-procedure (
     4964                                           input   buf_cash-desk.db-num
     4965                                           ,input  buf_cash-desk.obj-code
     4966                                           ,input  buf_cash-desk.pos-type
     4967                                           ,input  buf_cash-desk.cash-num
     4968                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4969                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4970                                                 and p-is-petrolium
     4971                                                 then 'tot-petrol':U
     4972                                                 else 'tot-gds':U)
     4973                                           ,input ''
     4974                                           ,input ?
     4975                                           ,input 0.0
     4976                                           ,input  (v-tot-gds + 1)
     4977                                           ,input no
     4978                                          ) no-error .
     4979     if error-status:error then do:
     4980       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4981                          ,buf_cash-desk.cash-num
     4982                          , 'маг':U
     4983                          ,buf_cash-desk.obj-code
     4984                          , chr(10)
     4985                          , error-status:get-message(1)
     4986                          , return-value
     4987                          ).
     4988       if not p-silence then
     4989       message
     4990       v-mes
     4991       view-as alert-box error .
     4992       undo _main, return error v-mes.
     4993     end.
     4994     run cd-attr-write  in this-procedure (
     4995                                           input   buf_cash-desk.db-num
     4996                                           ,input  buf_cash-desk.obj-code
     4997                                           ,input  buf_cash-desk.pos-type
     4998                                           ,input  buf_cash-desk.cash-num
     4999                                           ,input  'MARIA_operative':U
     5000                                           ,input  'to-send':U
     5001                                           ,input ''
     5002                                           ,input ?
     5003                                           ,input 0.0
     5004                                           ,input 0
     5005                                           ,input yes
     5006                                          ) no-error .
     5007     if error-status:error then do:
     5008       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5009                          ,buf_cash-desk.cash-num
     5010                          , 'маг':U
     5011                          ,buf_cash-desk.obj-code
     5012                          , chr(10)
     5013                          , error-status:get-message(1)
     5014                          , return-value
     5015                          ).
     5016       if not p-silence then
     5017       message
     5018       v-mes
     5019       view-as alert-box error .
     5020       undo _main, return error v-mes.
     5021     end.
     5022     return "":U.
     5023   end.
     5024   END PROCEDURE.
     5025   procedure cd-mrkt_update-marketer :
     5026   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5027   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5028   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5029   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5030   define input parameter p-is-petrolium as logical no-undo .
     5031   define variable v-to-send as logical no-undo .
     5032   define variable v-tot-gds as integer no-undo .
     5033   define variable v-max-plu as integer no-undo .
     5034   define buffer buf_cd-plu for ub.cd-plu.
     5035   define variable v-plu-type as character no-undo .
     5036     do
     5037     on error undo, return error
     5038     :
     5039       v-to-send = no.
     5040       v-tot-gds = 0.
     5041       assign
     5042       v-plu-type = (if p-is-petrolium
     5043                     then  'топ':U
     5044                     else '':U
     5045                 )
     5046       .
     5047       FOR EACH buf_cd-plu WHERE
     5048              buf_cd-plu.obj-type = 'маг':U
     5049         and  buf_cd-plu.obj-code = p-obj-code
     5050         and  buf_cd-plu.pos-type = p-pos-type
     5051         and  buf_cd-plu.plu-type = v-plu-type
     5052             :
     5053         if  buf_cd-plu.to-del
     5054         or  buf_cd-plu.to-send then do:
     5055           assign
     5056           v-to-send = yes.
     5057         end.
     5058         assign
     5059         v-tot-gds = v-tot-gds + 1.
     5060       end.
     5061       run cd-attr-write  in this-procedure (
     5062                                               input   p-db-num
     5063                                               ,input  p-obj-code
     5064                                               ,input  p-pos-type
     5065                                               ,input  p-cash-num
     5066                                               ,input  'MARIA_operative':U
     5067                                               ,input  (if p-pos-type = 'MARIA':U
     5068                                                        and p-is-petrolium
     5069                                                        then  'tot-petrol':U
     5070                                                        else 'tot-gds':U)
     5071                                               ,input ''
     5072                                               ,input ?
     5073                                               ,input 0.0
     5074                                               ,input v-tot-gds
     5075                                               ,input no
     5076                                                                                           ) no-error .
     5077       if error-status:error then do:
     5078           UNDO, RETURN ERROR RETURN-VALUE.
     5079       END.
     5080       run cd-attr-write  in this-procedure (
     5081                                               input   p-db-num
     5082                                               ,input  p-obj-code
     5083                                               ,input  p-pos-type
     5084                                               ,input  p-cash-num
     5085                                               ,input  'MARIA_operative':U
     5086                                               ,input  (if p-pos-type = 'MARIA':U
     5087                                                        and p-is-petrolium
     5088                                                        then  'petrol-to-send':U
     5089                                                        else 'to-send':U)
     5090                                               ,input ''
     5091                                               ,input ?
     5092                                               ,input 0.0
     5093                                               ,input 0
     5094                                               ,input v-to-send
     5095                                               ) no-error .
     5096       if error-status:error then do:
     5097           UNDO, RETURN ERROR RETURN-VALUE.
     5098       END.
     5099       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5100                buf_cd-plu.obj-type = 'маг':U
     5101            and buf_cd-plu.obj-code = p-obj-code
     5102            and buf_cd-plu.pos-type = p-pos-type
     5103            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5104       if available buf_cd-plu then do:
     5105         if v-max-plu < buf_cd-plu.plu-code
     5106         then
     5107         v-max-plu = buf_cd-plu.plu-code .
     5108       end.
     5109       else do:
     5110         v-max-plu = 0.
     5111       end.
     5112       run cd-attr-write  in this-procedure (
     5113                                             input   p-db-num
     5114                                             ,input  p-obj-code
     5115                                             ,input  p-pos-type
     5116                                             ,input  p-cash-num
     5117                                             ,input  'MARIA_operative':U
     5118                                             ,input  (if p-pos-type = 'MARIA':U
     5119                                                     and p-is-petrolium
     5120                                                     then 'max-petrol-plu':U
     5121                                                     else 'max-plu':U)
     5122                                               ,input ''
     5123                                               ,input ?
     5124                                               ,input 0.0
     5125                                               ,input v-max-plu
     5126                                               ,input no
     5127                                             ) no-error .
     5128       if error-status:error then do:
     5129           UNDO, RETURN ERROR RETURN-VALUE.
     5130       END.
     5131     end.
     5132   end procedure.
     5133   PROCEDURE cd-mrkt_clu-marketer :
     5134   define input parameter p-silence as logical no-undo .
     5135   define parameter buffer buf_cash-desk for ub.cash-desk.
     5136   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5137   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5138   define variable v-tot-cli as integer no-undo .
     5139   define variable v-max-cli as integer no-undo .
     5140   DEFINE VARIABLE v-today as date no-undo .
     5141   DEFINE VARIABLE v-time as integer no-undo .
     5142   define buffer  buf_cd-clu for ub.cd-clu.
     5143   define buffer  loc_cd-clu for ub.cd-clu.
     5144   define variable  ii as integer no-undo.
     5145   define variable v-mes as character no-undo .
     5146   _main:
     5147   DO ON ERROR undo, leave on stop undo, leave:
     5148     if buf_cash-desk.pos-type <> 'MARIA':U
     5149     or buf_cash-desk.cash-num <> 0 then do:
     5150       assign
     5151       v-mes =
     5152       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5153                 , buf_cash-desk.pos-type).
     5154       if not p-silence then
     5155       message
     5156       v-mes
     5157       view-as alert-box error .
     5158       return error v-mes.
     5159     end.
     5160     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5161                                     ,input 'MARIA_operative':U
     5162                                     ,input 'tot-cli':U
     5163                                     ,output v-mes).
     5164     if v-tot-cli = ? then undo _main, return error v-mes.
     5165     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5166                                     ,input 'MARIA_general':U
     5167                                     ,input 'max-cli':U
     5168                                     , output v-mes).
     5169     if v-max-cli = ? then undo _main, return error v-mes.
     5170     DO ii = 1
     5171        to v-max-cli :
     5172       if not can-find (loc_cd-clu where
     5173                       loc_cd-clu.obj-type = 'маг':U
     5174                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5175                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5176                   and loc_cd-clu.clu-type = '':U
     5177                   and loc_cd-clu.clu-code = ii
     5178                      )
     5179       then LEAVE .
     5180     END .
     5181     if ii > v-max-cli then do:
     5182         if not p-silence then
     5183         message
     5184         substitute("Превышено максимально допустимое количество клиентов &1" +
     5185                   "для касс &2 &3&4"
     5186                   , chr(10)
     5187                   , v-max-cli
     5188                   , 'маг':U
     5189                   , buf_cash-desk.obj-code
     5190                   )
     5191         view-as alert-box ERROR .
     5192         undo, return error "max-cli":U.
     5193     end.
     5194     run cur-time in this-procedure ( output v-today, output v-time).
     5195     create buf_cd-clu.
     5196     assign
     5197     buf_cd-clu.cli-code = p-obj-code
     5198     buf_cd-clu.cli-type = p-obj-type
     5199     buf_cd-clu.obj-type = 'маг':U
     5200     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5201     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5202     buf_cd-clu.clu-type = '':U
     5203     buf_cd-clu.to-send = yes
     5204     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5205                               then buf_cash-desk.addr-path
     5206                               else "U":U)
     5207     buf_cd-clu.clu-code = ii
     5208     .
     5209     run cd-attr-write  in this-procedure (
     5210                                           input   buf_cash-desk.db-num
     5211                                           ,input  buf_cash-desk.obj-code
     5212                                           ,input  buf_cash-desk.pos-type
     5213                                           ,input  buf_cash-desk.cash-num
     5214                                           ,input  'MARIA_operative':U
     5215                                           ,input  'tot-cli':U
     5216                                           ,input ''
     5217                                           ,input ?
     5218                                           ,input 0.0
     5219                                           ,input  (v-tot-cli + 1)
     5220                                           ,input no
     5221                                          ) no-error .
     5222     if error-status:error then do:
     5223       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5224                          ,buf_cash-desk.cash-num
     5225                          , 'маг':U
     5226                          ,buf_cash-desk.obj-code
     5227                          , chr(10)
     5228                          , error-status:get-message(1)
     5229                          , return-value
     5230                          ).
     5231       if not p-silence then
     5232       message
     5233       v-mes
     5234       view-as alert-box error .
     5235       undo _main, return error v-mes.
     5236     end.
     5237     run cd-attr-write  in this-procedure (
     5238                                           input   buf_cash-desk.db-num
     5239                                           ,input  buf_cash-desk.obj-code
     5240                                           ,input  buf_cash-desk.pos-type
     5241                                           ,input  buf_cash-desk.cash-num
     5242                                           ,input  'MARIA_operative':U
     5243                                           ,input  'cli-to-send':U
     5244                                           ,input ''
     5245                                           ,input ?
     5246                                           ,input 0.0
     5247                                           ,input 0
     5248                                           ,input yes
     5249                                          ) no-error .
     5250     if error-status:error then do:
     5251       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5252                          ,buf_cash-desk.cash-num
     5253                          , 'маг':U
     5254                          ,buf_cash-desk.obj-code
     5255                          , chr(10)
     5256                          , error-status:get-message(1)
     5257                          , return-value
     5258                          ).
     5259       if not p-silence then
     5260       message
     5261       v-mes
     5262       view-as alert-box error .
     5263       undo _main, return error v-mes.
     5264     end.
     5265     return "":U.
     5266   end.
     5267   END PROCEDURE.
     5268   procedure cd-mrkt_update-marketer-cli :
     5269   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5270   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5271   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5272   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5273   define variable v-cli-to-send as logical no-undo .
     5274   define variable v-tot-cli as integer no-undo .
     5275   define variable v-max-clu as integer no-undo .
     5276   define buffer buf_cd-clu for ub.cd-clu.
     5277   do
     5278   on error undo, return error return-value
     5279   :
     5280     v-cli-to-send = no.
     5281     v-tot-cli = 0.
     5282     FOR EACH buf_cd-clu WHERE
     5283           buf_cd-clu.obj-type = 'маг':U
     5284       and buf_cd-clu.obj-code =  p-obj-code
     5285       and buf_cd-clu.pos-type =  p-pos-type
     5286       and buf_cd-clu.clu-type =  '':U
     5287       :
     5288       if buf_cd-clu.to-del = yes then do:
     5289         assign
     5290         v-cli-to-send = yes.
     5291       end.
     5292       assign
     5293       v-tot-cli = v-tot-cli + 1.
     5294     end.
     5295     run cd-attr-write  in this-procedure (
     5296                                             input   p-db-num
     5297                                             ,input  p-obj-code
     5298                                             ,input  p-pos-type
     5299                                             ,input  p-cash-num
     5300                                             ,input  'MARIA_operative':U
     5301                                             ,input  'tot-cli':U
     5302                                             ,input ''
     5303                                             ,input ?
     5304                                             ,input 0.0
     5305                                             ,input v-tot-cli
     5306                                             ,input no
     5307                                             ) no-error .
     5308     if error-status:error then do:
     5309         UNDO, RETURN ERROR RETURN-VALUE.
     5310     END.
     5311     run cd-attr-write  in this-procedure (
     5312                                             input   p-db-num
     5313                                             ,input  p-obj-code
     5314                                             ,input  p-pos-type
     5315                                             ,input  p-cash-num
     5316                                             ,input  'MARIA_operative':U
     5317                                             ,input  'cli-to-send':U
     5318                                             ,input ''
     5319                                             ,input ?
     5320                                             ,input 0.0
     5321                                             ,input 0
     5322                                             ,input v-cli-to-send
     5323                                             ) no-error .
     5324     if error-status:error then do:
     5325         UNDO, RETURN ERROR RETURN-VALUE.
     5326     END.
     5327     FIND LAST buf_cd-clu WHERE
     5328             buf_cd-clu.obj-type = 'маг':U
     5329         and buf_cd-clu.obj-code = p-obj-code
     5330         and buf_cd-clu.pos-type = p-pos-type
     5331         and buf_cd-clu.clu-type = '':U
     5332         NO-LOCK use-index pi no-error .
     5333     if available buf_cd-clu then do:
     5334       if v-max-clu < buf_cd-clu.clu-code
     5335       then
     5336       v-max-clu = buf_cd-clu.clu-code.
     5337     end.
     5338     else do:
     5339       v-max-clu = 0.
     5340     end.
     5341     run cd-attr-write  in this-procedure (
     5342                                           input   p-db-num
     5343                                           ,input  p-obj-code
     5344                                           ,input  p-pos-type
     5345                                           ,input  p-cash-num
     5346                                           ,input  'MARIA_operative':U
     5347                                           ,input  'max-clu':U
     5348                                           ,input ''
     5349                                           ,input ?
     5350                                           ,input 0.0
     5351                                           ,input v-max-clu
     5352                                           ,input no
     5353                                           ) no-error .
     5354     if error-status:error then do:
     5355         UNDO, RETURN ERROR RETURN-VALUE.
     5356     END.
     5357   end.
     5358   end procedure.
