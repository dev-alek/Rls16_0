     8770   end.
     8771   end.
     8772   FIND FIRST ub.bar-code WHERE
     8773               ub.bar-code.node-code = b-g-p.node-code AND
     8774               ub.bar-code.gds-code = ub.goods.gds-code AND
     8775               ub.bar-code.in-code = "" AND
