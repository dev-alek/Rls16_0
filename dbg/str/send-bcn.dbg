     8988       else do:
     8989         assign
     8990           IBm-good-code = ncrsc-pfx + substring( tmp-str69, length( ncrsc-pfx ) + 1, length( tmp-str69 ) - length( ncrsc-pfx ) )
     8991           len-code69    = length( IBm-good-code )
     8992         .
