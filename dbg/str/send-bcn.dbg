     8660               if v-attr-val = "yes" then do:
     8661                   find first ub.tax-rate-attr where ub.tax-rate-attr.attr-code = "envd" no-error.
     8662                   if AVAILABLE ub.tax-rate-attr then do:
     8663                       tax-string = tax-string + " " + (if tt-tax.individual
     8664                                                 then (if tt-tax.rate-value <> 0
     8665                                                           then string(ub.tax-rate-attr.rate-code + txfixnum)
     8666                                                           else "")
     8667                                                 else string(ub.tax-rate-attr.rate-code)).
     8668                   end.
     8669                   else do:
     8670                       tax-string = tax-string + " " + (if tt-tax.individual
     8671                                                 then (if tt-tax.rate-value <> 0
     8672                                                           then string(tt-tax.rate-code + txfixnum)
     8673                                                           else "")
     8674                                                 else string(tt-tax.rate-code)).
     8675                   end.
     8676               end.
     8677               else do:
     8678               tax-string = tax-string + " " + (if tt-tax.individual
     8679                                                 then (if tt-tax.rate-value <> 0
     8680                                                           then string(tt-tax.rate-code + txfixnum)
     8681                                                           else "")
     8682                                                 else string(tt-tax.rate-code)).
     8683               end.
     8684               if tt-tax.individual and tt-tax.rate-value <> 0 then do:
     8685                 FIND FIRST cash-txr where
     8686                           cash-txr.tax-code = tt-tax.tax-code
     8687                       and cash-txr.host-code = ub.shop.host-code
     8688                       and cash-txr.obj-type = 'маг':U
     8689                       and cash-txr.obj-code = ub.shop.obj-code
     8690                       and cash-txr.status_  = 'тек':U
     8691                       and cash-txr.rc = recid(ub.goods) no-error.
     8692                 if not available cash-txr then do:
     8693                   FIND FIRST cash-txr where cash-txr.crf = (cr-txr + 1) No-ERROR.
     8694                   start-paket-txr = no.
     8695                   if not avail cash-txr then
     8696                   create cash-txr.
     8697                   cash-txr.crf = cr-txr + 1.
     8698                   cr-txr = cr-txr + 1.
     8699                   BUFFER-COPY tt-tax USING tax-code rate-code tax-type rate-value
     8700                                       TO  cash-txr
     8701                                       ASSIGN
     8702                                       cash-txr.rc = recid(ub.goods)
     8703                                       cash-txr.host-code = ub.shop.host-code
     8704                                       cash-txr.obj-type = 'маг':U
     8705                                       cash-txr.obj-code = i-obj-code
     8706                                       cash-txr.status_ = 'тек':U
     8707                                       .
     8708                   cash-txr.rate-code = cash-txr.rate-code + txfixnum.
     8709                 end.
     8710               end.
     8711             END.
     8712         end.
     8713     end.
     8714     if LOOKUP('топ':U, ub.units.type) > 0 and
     8715         LOOKUP('дро':U, ub.units.type) > 0 AND
