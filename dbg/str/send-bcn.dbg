     6295   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6296   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6297   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6298   define buffer buf_price-all              for ub.price-all  .
     6299   define buffer buf_goods                  for ub.goods      .
     6300   define buffer buf_global-state           for ub.global-state  .
     6301   define buffer buf_buyer-group            for ub.buyer-group  .
     6302   define buffer buf_turnover-group         for ub.turnover-group  .
     6303   define buffer buf_main-code              for ub.bar-code  .
     6304   define buffer buf_bar-code               for ub.bar-code  .
     6305   define buffer buf_pay-type               for ub.pay-type  .
     6306   define buffer buf_cash-pay               for ub.cash-pay  .
     6307   define variable to-day          as date      no-undo .
     6308   define variable v-base-rate0    as decimal   no-undo .
     6309   define variable v-base-scale0   as decimal   no-undo .
     6310   define variable v-exch-rate0    as decimal   no-undo .
     6311   define variable v-exch-scale0   as decimal   no-undo .
     6312   define variable v-base-rate     as decimal   no-undo .
     6313   define variable v-base-scale    as decimal   no-undo .
     6314   define variable v-exch-rate     as decimal   no-undo .
     6315   define variable v-exch-scale    as decimal   no-undo .
     6316   define variable v-host-code     as integer   no-undo .
     6317   define variable v-curr-abbr     as character no-undo .
     6318   define variable v-grp-name      as character no-undo .
     6319   define variable v-date-1        as date      no-undo .
     6320   define variable v-date-2        as date      no-undo .
     6321   define variable v-interv        as character no-undo .
     6322   define variable v-pay-name      as character no-undo .
     6323   define variable v-cli-oborot    as decimal   no-undo .
     6324   define variable v-trn-pay-code  as integer   no-undo .
     6325   define variable v-cash-pay-curr as integer   no-undo .
     6326   define variable v-cash-pay-code as integer   no-undo .
     6327   do
     6328   on error undo, return error return-value
     6329   :
     6330   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6331   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6332   if p-fact-order = ? then do:
     6333     run fact-order-mpl (
     6334         input   today       ,
     6335         input   p-obj-type  ,
     6336         input   p-obj-code  ,
     6337         output  p-fact-order ).
     6338   end.
     6339   if p-vid-pay <> "" then do:
     6340      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6341      if available buf_pay-type
     6342         then v-trn-pay-code = buf_pay-type.obj-code.
     6343         else v-trn-pay-code =  0.
     6344   end.
     6345   else v-trn-pay-code = 0 .
     6346   if p-cash-pay-type <> "" then do:
     6347      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6348      if available buf_pay-type
     6349         then
     6350           assign
     6351             v-cash-pay-curr = buf_cash-pay.curr-code
     6352             v-cash-pay-code = buf_cash-pay.cdpay-code
     6353           .
     6354         else
     6355           assign
     6356             v-cash-pay-curr = 0
     6357             v-cash-pay-code = 0
     6358             .
     6359   end.
     6360   else
     6361     assign
     6362       v-cash-pay-curr = 0
     6363       v-cash-pay-code = 0
     6364       .
     6365   for each tt_price-all  : delete tt_price-all . end.
     6366   assign
     6367     p-plt-id             = ?
     6368     p-plt-db-num         = ?
     6369     p-pdf-id             = ?
     6370     p-pdf-db-num         = ?
     6371     p-sale-price-base    = ?
     6372     p-sale-price-rubl    = ?
     6373     v-cli-oborot         = 0
     6374   .
     6375   find first buf_global-state no-lock no-error .
     6376   if not available buf_global-state then do:
     6377      message
     6378        "Не заданы параметры ценообразования!"
     6379        view-as alert-box error
     6380      .
     6381      return error return-value .
     6382   end.
     6383   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6385     (input  p-obj-type
     6386     ,input  p-obj-code
     6387     ,output to-day
     6388     )  .
     6389   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6391     (input  p-obj-type
     6392     ,input  p-obj-code
     6393     ,output v-host-code
     6394     )  .
     6395   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6397     (input  v-host-code
     6398     ,input  to-day
     6399     ,output v-base-rate0
     6400     ,output v-base-scale0
     6401     )  .
     6402     v-cli-oborot-ALL  = 0 .
     6403     for each buf_turnover-buyer-main no-lock  where
     6404              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6405              buf_turnover-buyer-main.cli-code = p-cli-code
     6406              :
     6407              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6408     end.
     6409   for each buf_price-all no-lock where
     6410            buf_price-all.obj-type = p-obj-type and
     6411            buf_price-all.obj-code = p-obj-code and
     6412            buf_price-all.gds-code = buf_goods.gds-code and
     6413            buf_price-all.status_  = 'акт':U  and
     6414          ( p-only-b-code = false   or
     6415          ( buf_price-all.b-code = p-main-b-code or
     6416            buf_price-all.b-code = p-b-code))    and
     6417           ( p-only-b-code = true  or
     6418             buf_price-all.b-code = p-b-code)
     6419             and
     6420             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6421           ( buf_price-all.fact-order-sys-to = ? or
     6422             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6423           :
     6424            v-interv   = "" .
     6425            v-grp-name = "" .
     6426            v-pay-name = "" .
     6427            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6428            if buf_price-all.bgr-id > 0 then do:
     6429               find first buf_buyer-group no-lock where
     6430                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6431                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6432               if available buf_buyer-group then do:
     6433                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6434                  find first buf_buyer-in-buyer-group no-lock where
     6435                             buf_buyer-in-buyer-group.stts         = 0 and
     6436                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6437                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6438                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6439                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6440                             no-error .
     6441                             if not available buf_buyer-in-buyer-group then do:
     6442                                v-grp-name = "".
     6443                                next.
     6444                             end.
     6445                             v-grp-name = buf_buyer-group.name .
     6446                  end.
     6447               end.
     6448               else do:
     6449                    v-grp-name = "".
     6450                    next.
     6451               end.
     6452            end.
     6453            if buf_price-all.tog-id > 0 then do:
     6454               find first buf_turnover-group no-lock where
     6455                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6456                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6457               if available buf_turnover-group then do:
     6458                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6459                     v-cli-oborot = v-cli-oborot-all  .
     6460                     find first buf1_tnv-in-turnover-group no-lock where
     6461                                buf1_tnv-in-turnover-group.stts       =  0     and
     6462                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6463                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6464                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6465                     find first buf2_tnv-in-turnover-group no-lock where
     6466                                buf2_tnv-in-turnover-group.stts       =  0     and
     6467                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6468                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6469                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6470                     if not (available buf1_tnv-in-turnover-group and
     6471                             available buf2_tnv-in-turnover-group ) then do:
     6472                             v-grp-name = "".
     6473                             next .
     6474                     end.
     6475                     v-grp-name = buf_turnover-group.name.
     6476                  end.
     6477               end.
     6478               else do:
     6479                    v-grp-name = "".
     6480                    next.
     6481               end.
     6482            end.
     6483            if buf_price-all.plt-fix-cource-crc-base = true then
     6484               assign
     6485                 v-base-rate  = buf_price-all.pdf-base-rate
     6486                 v-base-scale = buf_price-all.pdf-base-scale
     6487               .
     6488               else
     6489               assign
     6490                 v-base-rate  = v-base-rate0
     6491                 v-base-scale = v-base-scale0
     6492               .
     6493            if buf_price-all.plt-fix-cource-crc-doc = true then
     6494               assign
     6495                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6496                 v-exch-scale = buf_price-all.pdf-exch-scale
     6497               .
     6498               else do:
     6499   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6501     (input  buf_price-all.curr-code
     6502     ,input  to-day
     6503     ,output v-exch-rate0
     6504     ,output v-exch-scale0
     6505     ,output v-curr-abbr
     6506     )  .
     6507               assign
     6508                 v-exch-rate  = v-exch-rate0
     6509                 v-exch-scale = v-exch-scale0
     6510                 .
     6511              end.
     6512              v-date-1 = date ( "" )  .
     6513              if buf_price-all.fact-order-sys-from > 0 then do:
     6514                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6515                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6516                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6517              end.
     6518              v-date-2 =  date ( "" )  .
     6519              if buf_price-all.fact-order-sys-to > 0 then do:
     6520                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6521                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6522                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6523              end.
     6524              if buf_price-all.qnty-from <> ? then do :
     6525                 if not (
     6526                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6527                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6528                 ) then do:
     6529                        v-interv = "".
     6530                        next.
     6531                 end.
     6532                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6533              end.
     6534              if buf_price-all.sum-from <> ? then do :
     6535                 if not (
     6536                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6537                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6538                 ) then do:
     6539                    v-interv = "".
     6540                    next.
     6541                 end.
     6542                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6543              end.
     6544              if buf_price-all.turnover-from <> ? then do :
     6545                 if not (
     6546                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6547                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6548                 ) then do:
     6549                    v-interv = "".
     6550                    next.
     6551                 end.
     6552                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6553              end.
     6554              if buf_price-all.use-pay-type = 1 then do :
     6555                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6556                    v-pay-name = "" .
     6557                    next.
     6558                  end.
     6559                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6560              end.
     6561              if buf_price-all.use-cash-pay = 1 then do :
     6562                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6563                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6564                   v-pay-name = "" .
     6565                   next.
     6566                 end.
     6567                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6568              end.
     6569             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6570             create tt_price-all .
     6571             buffer-copy buf_price-all to tt_price-all
     6572             assign
     6573               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6574               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6575               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6576               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6577               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6578               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6579               tt_price-all.price-sale     = buf_price-all.price-sale
     6580               tt_price-all.road-tax       = buf_price-all.road-tax
     6581               tt_price-all.excise         = buf_price-all.excise
     6582               tt_price-all.pdf-exch-rate   = v-exch-rate
     6583               tt_price-all.pdf-exch-scale  = v-exch-scale
     6584               tt_price-all.pdf-base-rate   = v-base-rate
     6585               tt_price-all.pdf-base-scale  = v-base-scale
     6586               tt_price-all.grp-name        = v-grp-name
     6587               tt_price-all.date-1          = v-date-1
     6588               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6589               tt_price-all.time-1          = buf_price-all.start-sys-time
     6590               tt_price-all.date-2          = v-date-2
     6591               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6592               tt_price-all.time-2          = buf_price-all.end-sys-time
     6593               tt_price-all.interv-name     = v-interv
     6594               tt_price-all.pay-name        = v-pay-name
     6595               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6596             .
     6597   end.
     6598   define variable vt-plt-id as integer   no-undo .
     6599   define variable vt-plt-db as integer   no-undo .
     6600   define variable vt-pdf-id as integer   no-undo .
     6601   define variable vt-pdf-db as integer   no-undo .
     6602   define buffer neos_price-all for tt_price-all  .
     6603   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6604       if available tt_price-all then do:
     6605        assign
     6606          vt-plt-id = tt_price-all.plt-id
     6607          vt-plt-db = tt_price-all.plt-db-num
     6608          vt-pdf-id = tt_price-all.pdf-id
     6609          vt-pdf-db = tt_price-all.pdf-db
     6610        .
     6611        if tt_price-all.b-code = p-b-code then do:
     6612             assign
     6613               p-plt-id           = tt_price-all.plt-id
     6614               p-plt-db-num       = tt_price-all.plt-db-num
     6615               p-pdf-id           = tt_price-all.pdf-id
     6616               p-pdf-db-num       = tt_price-all.pdf-db
     6617               p-sale-price-base  = tt_price-all.price-sale-base
     6618               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6619               p-road-tax-base    = tt_price-all.road-tax-base
     6620               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6621               p-excise-base      = tt_price-all.excise-base
     6622               p-excise-rubl      = tt_price-all.excise-rubl
     6623               .
     6624        end.
     6625        else do:
     6626          find first neos_price-all where
     6627                     neos_price-all.b-code     = p-b-code  and
     6628                     neos_price-all.plt-id     = vt-plt-id and
     6629                     neos_price-all.plt-db-num = vt-plt-db and
     6630                     neos_price-all.pdf-id     = vt-pdf-id and
     6631                     neos_price-all.pdf-db     = vt-pdf-db
     6632                     use-index pi no-error .
     6633            if available neos_price-all then do:
     6634             assign
     6635               p-plt-id           = tt_price-all.plt-id
     6636               p-plt-db-num       = tt_price-all.plt-db-num
     6637               p-pdf-id           = tt_price-all.pdf-id
     6638               p-pdf-db-num       = tt_price-all.pdf-db
     6639               p-sale-price-base  = neos_price-all.price-sale-base
     6640               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6641               p-road-tax-base    = neos_price-all.road-tax-base
     6642               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6643               p-excise-base      = neos_price-all.excise-base
     6644               p-excise-rubl      = neos_price-all.excise-rubl
     6645               .
     6646            end.
     6647            else do:
     6648                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6649                 if error-status :error    then do:
     6650                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6651                   return error return-value .
     6652                 end.
     6653             assign
     6654               p-plt-id           = tt_price-all.plt-id
     6655               p-plt-db-num       = tt_price-all.plt-db-num
     6656               p-pdf-id           = tt_price-all.pdf-id
     6657               p-pdf-db-num       = tt_price-all.pdf-db
     6658               p-sale-price-base  = tt_price-all.price-sale-base
     6659               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6660               p-road-tax-base    = tt_price-all.road-tax-base
     6661               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6662               p-excise-base      = tt_price-all.excise-base
     6663               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6664               .
     6665            end.
     6666        end.
     6667     end.
     6668   end.
     6669   end procedure.
     6670   procedure mpl-tpl-auto :
     6671   define input  parameter p-b-code     as integer   no-undo .
     6672   define input  parameter p-obj-type   as character no-undo .
     6673   define input  parameter p-obj-code   as integer   no-undo .
     6674   define input  parameter p-plt-id     as integer   no-undo .
     6675   define input  parameter p-plt-db-num as integer   no-undo .
     6676   define input  parameter p-fact-order as decimal   no-undo .
     6677   define output parameter p-sale-price as decimal   no-undo .
     6678   define output parameter p-pdf-id     as integer   no-undo .
     6679   define output parameter p-pdf-db-num as integer   no-undo .
     6680     do
     6681     on error undo, return error return-value
     6682     :
     6683   if p-fact-order = ? then do:
     6684     run fact-order-mpl (
     6685         input   today       ,
     6686         input   p-obj-type  ,
     6687         input   p-obj-code  ,
     6688         output  p-fact-order ) .
     6689   end.
     6690   assign
     6691     p-pdf-id      = ?
     6692     p-pdf-db-num  = ?
     6693     p-sale-price  = ?
     6694   .
     6695   define buffer buf_bar-code for ub.bar-code  .
     6696   define buffer buf_goods for ub.goods  .
     6697   find first buf_bar-code no-lock where
     6698              buf_bar-code.b-code = p-b-code
     6699              no-error .
     6700   if error-status :error then return error return-value .
     6701   find first buf_goods no-lock where
     6702              buf_goods.gds-code = buf_bar-code.gds-code
     6703              no-error .
     6704   if error-status :error then return error return-value .
     6705   define variable v-main-b-code as integer   no-undo .
     6706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6707     (input  buf_goods.gds-code
     6708     ,input  ?
     6709     ,output v-main-b-code
     6710     )  .
     6711   define buffer buf_price-all for ub.price-all  .
     6712   for each tt_price-all : delete tt_price-all. end.
     6713       for each buf_price-all no-lock where
     6714               buf_price-all.plt-id     = p-plt-id                 and
     6715               buf_price-all.plt-db-num = p-plt-db-num             and
     6716               buf_price-all.obj-type   = p-obj-type               and
     6717               buf_price-all.obj-code   = p-obj-code               and
     6718               buf_price-all.gds-code   = buf_goods.gds-code       and
     6719             ( buf_price-all.b-code = v-main-b-code or
     6720               buf_price-all.b-code = p-b-code)    and
     6721               buf_price-all.status_    = 'акт':U         and
     6722               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6723             ( buf_price-all.fact-order-sys-to = ? or
     6724               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6725               :
     6726                 create tt_price-all .
     6727                 buffer-copy buf_price-all to tt_price-all
     6728                 assign
     6729                   tt_price-all.price-sale  = buf_price-all.price-sale
     6730                 .
     6731       end.
     6732   define variable vt-plt-id as integer   no-undo .
     6733   define variable vt-plt-db as integer   no-undo .
     6734   define variable vt-pdf-id as integer   no-undo .
     6735   define variable vt-pdf-db as integer   no-undo .
     6736   define buffer neos_price-all for tt_price-all  .
     6737   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6738       if available tt_price-all then do:
     6739        assign
     6740          vt-plt-id = tt_price-all.plt-id
     6741          vt-plt-db = tt_price-all.plt-db-num
     6742          vt-pdf-id = tt_price-all.pdf-id
     6743          vt-pdf-db = tt_price-all.pdf-db
     6744        .
     6745        if tt_price-all.b-code = p-b-code then do:
     6746             assign
     6747               p-plt-id           = tt_price-all.plt-id
     6748               p-plt-db-num       = tt_price-all.plt-db-num
     6749               p-pdf-id           = tt_price-all.pdf-id
     6750               p-pdf-db-num       = tt_price-all.pdf-db
     6751               p-sale-price       = tt_price-all.price-sale
     6752               .
     6753        end.
     6754        else do:
     6755          find first neos_price-all where
     6756                     neos_price-all.b-code     = p-b-code  and
     6757                     neos_price-all.plt-id     = vt-plt-id and
     6758                     neos_price-all.plt-db-num = vt-plt-db and
     6759                     neos_price-all.pdf-id     = vt-pdf-id and
     6760                     neos_price-all.pdf-db     = vt-pdf-db
     6761                     use-index pi no-error .
     6762            if available neos_price-all then do:
     6763             assign
     6764               p-plt-id           = tt_price-all.plt-id
     6765               p-plt-db-num       = tt_price-all.plt-db-num
     6766               p-pdf-id           = tt_price-all.pdf-id
     6767               p-pdf-db-num       = tt_price-all.pdf-db
     6768               p-sale-price       = neos_price-all.price-sale
     6769               .
     6770            end.
     6771            else do:
     6772           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6773           if error-status :error    then do:
     6774              message "Не найден бар-код" p-b-code view-as alert-box error .
     6775              return error return-value .
     6776           end.
     6777             assign
     6778               p-plt-id           = tt_price-all.plt-id
     6779               p-plt-db-num       = tt_price-all.plt-db-num
     6780               p-pdf-id           = tt_price-all.pdf-id
     6781               p-pdf-db-num       = tt_price-all.pdf-db
     6782               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6783               .
     6784            end.
     6785        end.
     6786     end.
     6787     end.
     6788   end procedure.
