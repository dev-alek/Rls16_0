    11151       assign
    11152       par-type = entry(ff, ncrgmdsc , ";":U)
    11153       conf-par = entry(2, par-type, "=":U)
    11154       no-error
    11155       .
    11156       if error-status:error then do:
    11157         LEAVE.
    11158       end.
    11159       if conf-par  = string( - std-disc-dec) then do:
    11160         ncrdsc =  entry(1, par-type, "=").
