    12777                                                       substring(maria-good-code104, 6, 14)
    12778                                                     )
    12779                                                 else (fill('0', 5) + chr(4) + fill('0', 9)))
    12780                                           ).
    12781         run maria-put in this-procedure (
    12782                                         buffer for-cash-desk
    12783                                       , input out
    12784                                       , input fname
    12785                                       , input yes
    12786                                       , input 0
    12787                                       , input no
    12788                                       , input 9
    12789                                       , input 5000
    12790                                       , input v-plu
    12791                                       , input (if v-marketer-action = 'u':U
    12792                                               then string(cash-gds.price-sale * 100, "999999999")
    12793                                               else '000000000')
    12794         ).
    12795         run maria-put in this-procedure (
    12796                                         buffer for-cash-desk
    12797                                       , input out
    12798                                       , input fname
    12799                                       , input yes
    12800                                       , input 0
    12801                                       , input no
    12802                                       , input 10
    12803                                       , input 5000
    12804                                       , input v-plu
    12805                                       , input (if v-marketer-action = "U"
    12806                                                 then (
    12807                                                     string(cash-gds.gds-stat MODULO 2) +
    12808                                                     string(if cash-gds.fp then 1 else 0) +
    12809                                                     string(cash-gds.office) )
    12810                                                 else '000')
    12811                                             ).
    12812         run maria-put in this-procedure (
    12813                                         buffer for-cash-desk
    12814                                       , input out
    12815                                       , input fname
    12816                                       , input yes
    12817                                       , input 0
    12818                                       , input no
    12819                                       , input 12
    12820                                       , input 5000
    12821                                       , input v-plu
    12822                                       , input (if v-marketer-action = "U"
    12823                                                 then  string(cash-gds.b-code, "999999999")
    12824                                                 else "000000000")
    12825                                             ).
    12826         run maria-put in this-procedure (
    12827                                         buffer for-cash-desk
    12828                                       , input out
    12829                                       , input fname
    12830                                       , input yes
    12831                                       , input 0
    12832                                       , input no
    12833                                       , input (if integer(v-plu) <= v-20-part1
    12834                                               then 20
    12835                                               else 21)
    12836                                       , input (if integer(v-plu) <= v-20-part1
    12837                                               then 2621
    12838                                               else 2379)
    12839                                       , input v-plu
    12840                                       , input (if v-marketer-action = 'U':U
    12841                                                 then string(convert-maria-tax-code(cash-gds.vat-code, 0  , cdtaxlst), "X(8)")
    12842                                                 else '00000000':U) + chr(4) + chk_name).
    12843         run maria-put in this-procedure (
    12844                                         buffer for-cash-desk
    12845                                       , input out
