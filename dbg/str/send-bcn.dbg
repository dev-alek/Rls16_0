     6980   procedure grp-obj-notcorr-value :
     6981   do
     6982   on error undo, return error
     6983   :
     6984   define input parameter p-node-code             as integer      no-undo.
     6985   define input parameter p-obj-type              as character    no-undo.
     6986   define input parameter p-obj-code              as integer      no-undo.
     6987   define output parameter p-notcorr              as character    no-undo init ?.
     6988   define output parameter p-range-notcorr     as integer      no-undo.
     6989   define output parameter p-exists-notcorr    as logical      no-undo.
     6990   define variable v-host-code as integer      no-undo.
     6991   DEFINE VARIABLE v-found as logical no-undo .
     6992   DEFINE VARIABLE v-exists as logical no-undo .
     6993   DEFINE VARIABLE v-range as integer no-undo .
     6994   DEFINE VARIABLE jj as integer no-undo .
     6995   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6996   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6997   define buffer buf_gds-grp for ub.gds-grp.
     6998   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     6999   find first buf_gds-grp no-lock where
     7000              buf_gds-grp.node-code = p-node-code no-error .
     7001   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7002     message
     7003       vss-workfile vss-revision vss-description
     7004       skip "Не удалось найти группу товаров с кодом" p-node-code
     7005       view-as alert-box error .
     7006     undo, return error .
     7007   end.
     7008   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7010     (input  p-obj-type
     7011     ,input  p-obj-code
     7012     ,output v-host-code
     7013     ) no-error .
     7014   if error-status :error
     7015   then do:
     7016       message
     7017         vss-workfile vss-revision vss-description
     7018         skip "Не удалось найти фирму объекта"
     7019         skip p-obj-type p-obj-code
     7020         skip return-value
     7021         skip trim(error-status :get-message(1))
     7022       view-as alert-box error.
     7023       undo, return error .
     7024   end.
     7025   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7026   do while v-found = no and jj < 2:
     7027     if v-range <> 3 then do:
     7028       find first buf_gds-grp-obj no-lock
     7029           where buf_gds-grp-obj.node-code = p-node-code
     7030             and buf_gds-grp-obj.host-code = v-host-code
     7031             and buf_gds-grp-obj.obj-type  = p-obj-type
     7032             and buf_gds-grp-obj.obj-code  = p-obj-code
     7033       no-error .
     7034     end.
     7035     if v-range = 3 or not available buf_gds-grp-obj
     7036     then do:
     7037        if v-range <> 2 then do:
     7038           find first buf_gds-grp-obj no-lock
     7039               where buf_gds-grp-obj.node-code = p-node-code
     7040                 and buf_gds-grp-obj.host-code = v-host-code
     7041                 and buf_gds-grp-obj.obj-type  = ""
     7042                 and buf_gds-grp-obj.obj-code  = 0
     7043           no-error .
     7044         end.
     7045         if v-range = 2 or not available buf_gds-grp-obj
     7046         then do:
     7047             if v-range <> 1 then do:
     7048               find first buf_gds-grp-obj no-lock
     7049                   where buf_gds-grp-obj.node-code = p-node-code
     7050                   and buf_gds-grp-obj.host-code = 0
     7051                   and buf_gds-grp-obj.obj-type  = ""
     7052                   and buf_gds-grp-obj.obj-code  = 0
     7053               no-error .
     7054             end.
     7055             if v-range = 1 or not available buf_gds-grp-obj
     7056             then do:
     7057                 assign
     7058                     v-exists = no
     7059                 .
     7060             end.
     7061             else do:
     7062                 assign
     7063                     v-exists = yes
     7064                     v-range = 1
     7065                 .
     7066             end.
     7067         end.
     7068         else do:
     7069             assign
     7070                 v-exists = yes
     7071                 v-range  = 2
     7072             .
     7073         end.
     7074     end.
     7075     else do:
     7076         assign
     7077             v-exists = yes
     7078             v-range  = 3
     7079         .
     7080     end.
     7081     if available buf_gds-grp-obj
     7082     then do:
     7083       find first buf_gds-grp-obj-attr no-lock
     7084         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7085           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7086           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7087           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7088           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7089         no-error .
     7090       if available buf_gds-grp-obj-attr then do:
     7091         assign
     7092           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7093         .
     7094       end.
     7095       else do:
     7096         assign
     7097           v-notcorr-value = ?
     7098         .
     7099       end.
     7100       assign
     7101       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7102                           then yes
     7103                           else p-exists-notcorr)
     7104       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7105                         then v-range
     7106                         else p-range-notcorr
     7107       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7108                         then v-notcorr-value
     7109                         else p-notcorr
     7110       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7111       jj = jj + 1
     7112       .
     7113     end.
     7114     else do:
     7115       assign
     7116       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7117       jj = jj + 1
     7118       .
     7119     end.
     7120   end.
     7121   end.
     7122   end procedure.
