        1   block-level on error undo, throw.
        2   using ibs.th.gbl.sys.objsrv.
        3   define variable vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: makeBase64doc-LK_RECEIPT.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/makeBase64doc-LK_RECEIPT.p $":U .
        8   define variable vss-description as character no-undo init "Список УПД".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function getattrUtdex returns char
       80   (idb-num   as integer,
       81    idoc-id   as integer,
       82    iattrcode as character,
       83    iExValue  as character  ):
       84      define buffer utd-attr for utd-attr.
       85      find first utd-attr where utd-attr.db-num eq idb-num
       86                            and utd-attr.doc-id eq idoc-id
       87                            and utd-attr.attr-code eq iattrcode
       88      no-lock no-error.
       89      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
       90   end.
       91   function getattrUtd returns char
       92   (idb-num   as integer,
       93    idoc-id   as integer,
       94    iattrcode as character ):
       95     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
       96   end.
       97   function setattrUtd returns logical
       98   (idb-num   as integer,
       99    idoc-id   as integer,
      100    iattrcode as character,
      101    iattrval  as character ):
      102      define buffer utd-attr for utd-attr.
      103      find first utd-attr where utd-attr.db-num eq idb-num
      104                            and utd-attr.doc-id eq idoc-id
      105                            and utd-attr.attr-code eq iattrcode
      106      no-lock no-error.
      107      if not available utd-attr
      108      then do:
      109         create utd-attr.
      110         assign
      111            utd-attr.db-num    = idb-num
      112            utd-attr.doc-id    = idoc-id
      113            utd-attr.attr-code = iattrcode
      114            utd-attr.attr-value = iattrval
      115         .
      116      end.
      117      else do:
      118         if utd-attr.attr-value ne iattrval
      119         then do:
      120            find current utd-attr exclusive-lock no-error.
      121            if available utd-attr
      122            then
      123               utd-attr.attr-value = iattrval.
      124         end.
      125      end.
      126      release utd-attr.
      127   end.
      128   function GetAttrUtdlinesEx returns char
      129   (idb-num   as integer,
      130    idoc-id   as integer,
      131    ilinenum  as integer,
      132    iattrcode as character,
      133    iExValue  as character  ):
      134      define buffer utd-lines-attr for utd-lines-attr.
      135      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      136                                  and utd-lines-attr.doc-id    eq idoc-id
      137                                  and utd-lines-attr.lineNum   eq ilineNum
      138                                  and utd-lines-attr.attr-code eq iattrcode
      139      no-lock no-error.
      140      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      141   end.
      142   function GetAttrUtdlines returns char
      143   (idb-num   as integer,
      144    idoc-id   as integer,
      145    ilinenum  as integer,
      146    iattrcode as character ):
      147      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      148   end.
      149   function setattrUtdlines returns logical
      150   (idb-num   as integer,
      151    idoc-id   as integer,
      152    ilinenum  as integer,
      153    iattrcode as character,
      154    iattrval  as character ):
      155      define buffer utd-lines-attr for utd-lines-attr.
      156      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      157                                  and utd-lines-attr.doc-id    eq idoc-id
      158                                  and utd-lines-attr.lineNum   eq ilineNum
      159                                  and utd-lines-attr.attr-code eq iattrcode
      160      no-lock no-error.
      161      if not available utd-lines-attr
      162      then do:
      163         if iattrval ne ?
      164            and iattrval ne ""
      165         then do:
      166            create utd-lines-attr.
      167            assign
      168               utd-lines-attr.db-num    = idb-num
      169               utd-lines-attr.doc-id    = idoc-id
      170               utd-lines-attr.lineNum   = ilineNum
      171               utd-lines-attr.attr-code = iattrcode
      172               utd-lines-attr.attr-value = iattrval
      173            .
      174         end.
      175      end.
      176      else do:
      177         if utd-lines-attr.attr-value ne iattrval
      178         then do:
      179            find current utd-lines-attr exclusive-lock no-error.
      180            if available utd-lines-attr
      181            then do:
      182               if    iattrval eq ?
      183                  or iattrval eq ""
      184               then do:
      185                  delete utd-lines-attr.
      186               end.
      187               else do:
      188                  utd-lines-attr.attr-value = iattrval.
      189               end.
      190            end.
      191         end.
      192      end.
      193      release utd-lines-attr.
      194   end.
      195   function GetAttrUtdMarkingLinesEx returns char
      196   (idb-num   as integer,
      197    idoc-id   as integer,
      198    ilinenum  as integer,
      199    imark     as character,
      200    iattrcode as character,
      201    iExValue  as character  ):
      202      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      203      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      204                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      205                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      206                                          and utd-marking-lines-attr.mark      eq imark
      207                                          and utd-marking-lines-attr.attr-code eq iattrcode
      208      no-lock no-error.
      209      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      210   end.
      211   function GetAttrUtdMarkingLines returns char
      212   (idb-num   as integer,
      213    idoc-id   as integer,
      214    ilinenum  as integer,
      215    imark     as character,
      216    iattrcode as character ):
      217      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      218   end.
      219   function setattrUtdMarkingLines returns logical
      220   (idb-num   as integer,
      221    idoc-id   as integer,
      222    ilinenum  as integer,
      223    imark     as character,
      224    iattrcode as character,
      225    iattrval  as character ):
      226      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      227      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      228                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      229                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      230                                          and utd-marking-lines-attr.mark      eq imark
      231                                          and utd-marking-lines-attr.attr-code eq iattrcode
      232      no-lock no-error.
      233      if not available utd-marking-lines-attr
      234      then do:
      235         if iattrval ne ?
      236            and iattrval ne ""
      237         then do:
      238            create utd-marking-lines-attr.
      239            assign
      240               utd-marking-lines-attr.db-num     = idb-num
      241               utd-marking-lines-attr.doc-id     = idoc-id
      242               utd-marking-lines-attr.lineNum    = ilineNum
      243               utd-marking-lines-attr.mark       = imark
      244               utd-marking-lines-attr.attr-code  = iattrcode
      245               utd-marking-lines-attr.attr-value = iattrval
      246            .
      247         end.
      248      end.
      249      else do:
      250         if utd-marking-lines-attr.attr-value ne iattrval
      251         then do:
      252            find current utd-marking-lines-attr exclusive-lock no-error.
      253            if available utd-marking-lines-attr
      254            then do:
      255               if    iattrval eq ?
      256                  or iattrval eq ""
      257               then do:
      258                  delete utd-marking-lines-attr.
      259               end.
      260               else do:
      261                  utd-marking-lines-attr.attr-value = iattrval.
      262               end.
      263            end.
      264         end.
      265      end.
      266      release utd-marking-lines-attr.
      267   end.
      268   define input parameter p-db-num as integer no-undo .
      269   define input parameter p-doc-id as integer no-undo .
      270   define output parameter p-Base64doc as longchar no-undo .
      271   define buffer buf_utd for ub.utd .
      272   define buffer buf_utd-lines for ub.utd-lines .
      273   define variable v-tmp-filename as character no-undo .
      274   define variable vData as longchar no-undo .
      275   define variable vMemptr as memptr no-undo .
      276   define variable vAction as character no-undo .
      277   define variable vBaseDocCustomName as character no-undo .
      278   define variable vINN as character no-undo .
      279   function writeTag returns character
      280     (input pTag as character,
      281      input pValue as character)
      282   :
      283     return quoter(pTag) + ":" + quoter(pValue).
      284   end function .
      285   function putDate returns character
      286     (input pDate as date)
      287   :
      288     define variable vDateStr as character no-undo .
      289     vDateStr = string(year(pDate)) + "-" + string(month(pDate), "99") + "-" + string(day(pDate), "99") .
      290     return vDateStr .
      291   end function .
      292   find first buf_utd no-lock where buf_utd.db-num = p-db-num
      293                                and buf_utd.doc-id = p-doc-id
      294                                no-error .
      295   if not available buf_utd
      296   then do :
      297     return error "Документ не найден!".
      298   end .
      299   vAction = getattrUtd(input buf_utd.db-num, input buf_utd.doc-id, input "LK_RECEIPT_Action") .
      300   if vAction = ?
      301   or trim(vAction) = ""
      302   then do :
      303     return error "В документе не заполненен атрибут LK_RECEIPT_Action (Причина выбытия)!".
      304   end .
      305   vINN = trim(buf_utd.obj-inn) .
      306   if vINN = ""
      307   then do :
      308     for first firm no-lock where firm.firm-code = buf_utd.host-code :
      309       vINN = trim(firm.inn) .
      310     end .
      311   end .
      312   if vINN = ""
      313   then do :
      314     return error "В документе не заполненен ИНН".
      315   end .
      316   case vAction :
      317     when "PRODUCTION_USE" then vBaseDocCustomName = "Production" .
      318     when "LOSS" then vBaseDocCustomName = "Inventory" .
      319     when "DESTRUCTION" then vBaseDocCustomName = "Write-off" .
      320     otherwise do :
      321       return error ("В документе недопустимое значение атрибута LK_RECEIPT_Action (Причина выбытия) - " + vAction) .
      322     end .
      323   end case .
      324   vData = "" .
      325   vData = vData + "~{" .
      326   vData = vData + writeTag("inn", vINN) + "," .
      327   vData = vData + writeTag("action", vAction) + "," .
      328   vData = vData + writeTag("action_date", putDate(buf_utd.DocumentDate)) + "," .
      329   vData = vData + writeTag("document_type", "OTHER") + "," .
      330   vData = vData + writeTag("document_number", replace(buf_utd.doc-code, "м", "m")) + "," .
      331   vData = vData + writeTag("document_date", putDate(buf_utd.DocumentDate)) + "," .
      332   vData = vData + writeTag("primary_document_custom_name", vBaseDocCustomName) + "," .
      333   vData = vData + quoter("products") + ":" + "~[" .
      334   for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
      335                                    and buf_utd-lines.doc-id = buf_utd.doc-id
      336                                    break by buf_utd-lines.LineNum
      337   :
      338     vData = vData + "~{" .
      339     vData = vData + writeTag("gtin", buf_utd-lines.ProductCode) + "," .
      340     vData = vData + quoter("gtin_quantity")  + ":" + string(integer(buf_utd-lines.Quantity)) .
      341     vData = vData + "~}" .
      342     if not last(buf_utd-lines.LineNum) then vData = vData + "," .
      343   end .
      344   vData = vData + "~]" .
      345   vData = vData + "~}" .
      346   copy-lob from vData to vMemptr .
      347   p-Base64doc = base64-encode(vMemptr) .
