     8787          varvatcons-base-docovp  = varvatcons-base-docovp  + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     8788          vardsc-base-docovp  = vardsc-base-docovp  + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.doc-qnty
     8789         .
     8790         assign
     8791                varsum-rubl-factovp = varsum-rubl-factovp + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.fact-qnty
     8792          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     8793          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     8794          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     8795          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     8796          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     8797          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     8798          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     8799          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     8800          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     8801       end.
     8802       if buf_trn-doc.doc-type = 'инв':U then do:
     8803         ASSIGN
     8804                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     8805           slt-base-sale               = varslt-base-docovp / varfact-qnty
     8806           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     8807           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     8808           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     8809                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     8810           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     8811           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     8812           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     8813           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     8814       end.
     8815       else do:
     8816         ASSIGN
     8817                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     8818           slt-base-sale               = varslt-base-factovp / varfact-qnty
     8819           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     8820           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     8821           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     8822                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     8823           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     8824           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     8825           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     8826           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     8827       end.
     8828     end.
     8829   end.
     8830   assign
     8831     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8832     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8833       end.
     8834       _doc-line:
     8835       for each buf_parts where
     8836               buf_parts.out-code = buf_doc-line.doc-code
     8837           and buf_parts.obj-type = buf_doc-line.obj-type
     8838           and buf_parts.obj-code = buf_doc-line.obj-code
     8839           and buf_parts.artic = buf_doc-line.artic
     8840           and buf_parts.prod-type = buf_doc-line.prod-type
     8841           and buf_parts.prod-code = buf_doc-line.prod-code
     8842           and buf_parts.status_ = no
     8843       on error undo _main,  return error :
     8844         if buf_parts.purch-code <> par-source-purch-code then do:
     8845           NEXT _doc-line.
     8846         end.
     8847         find first temp-supp no-lock where
     8848                    temp-supp.cli-type      = buf_trn-doc.obj-type
     8849                and temp-supp.cli-code      = buf_trn-doc.obj-code no-error .
     8850         if available temp-supp then do:
     8851           find first supp_trn-doc where supp_trn-doc.doc-code = temp-supp.doc-code no-error .
     8852           if not available supp_trn-doc
     8853           OR not (supp_trn-doc.doc-type = 'инв':U
     8854             AND internal = no
     8855             AND supp_trn-doc.ext-doc-type = 'pc':U
     8856             AND supp_trn-doc.status_ = 'накл':U
     8857                 ) then do:
     8858             undo _main, return error substitute("Не найден документ &1 смены типа приобретения для &2"
     8859                                                 , temp-supp.doc-code
     8860                                                 , par-doc-code).
     8861           end.
     8862         end.
     8863         else do:
     8864           run doc-code in this-procedure
     8865           (input "main",
     8866             input buf_trn-doc.obj-type,
     8867             input buf_trn-doc.obj-code,
     8868             input ?,
     8869             output vardoc-code ) no-error.
     8870           if error-status:error then do:
     8871             undo, return error substitute("Ошибка при генерации номера документа смены типа приобретения для &1:&2&3 &4"
     8872                                           , par-doc-code
     8873                                           , chr(10)
     8874                                           , error-status:get-message(1)
     8875                                           , return-value ).
     8876           end.
     8877           find first buf_clients no-lock where
     8878                      buf_clients.obj-type = buf_trn-doc.obj-type
     8879                  AND buf_clients.obj-code = buf_trn-doc.obj-code .
     8880           if buf_trn-doc.obj-type = 'маг':U then do:
     8881             find first buf_shop no-lock where
     8882                       buf_shop.obj-code = buf_trn-doc.obj-code .
     8883             assign
     8884             v-inv-pay = buf_shop.inv-pay.
     8885           end.
     8886           else do:
     8887             find first buf_store no-lock where
     8888                       buf_store.obj-code = buf_trn-doc.obj-code .
     8889             assign
     8890             v-inv-pay = buf_store.inv-pay.
     8891           end.
     8892   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     8893   (input buf_trn-doc.acc-date
     8894   ,input buf_trn-doc.bge-date
     8895   ,input buf_trn-doc.base-rate
     8896   ,input buf_trn-doc.base-scale
     8897   ,input buf_trn-doc.obj-code
     8898   ,input buf_trn-doc.obj-type
     8899   ,input buf_clients.obj-name
     8900   ,input g#db-num
     8901   ,input g#userid
     8902   ,input ''
     8903   ,input vardoc-code
     8904   ,input buf_trn-doc.doc-date
     8905   ,input 'инв':U
     8906   ,input buf_trn-doc.flag_
     8907   ,input buf_trn-doc.host-code
     8908   ,input no
     8909   ,input buf_trn-doc.obj-code
     8910   ,input buf_trn-doc.obj-type
     8911   ,input no
     8912   ,input v-inv-pay
     8913   ,input ('@документ коррекции типа приобретения для накладной' + chr(32) + buf_trn-doc.doc-code)
     8914   ,input no
     8915   ,input ?
     8916   ,input 'накл':U
     8917   ,input ?
     8918   ,input 'pc':U
     8919   ,input ?
     8920   ) no-error
     8921   .
     8922           if error-status:error then do:
     8923             undo _main, return error substitute("Ошибка при создании документа смены типа приобретения для &1:&2&3 &4"
     8924                                           , par-doc-code
     8925                                           , chr(10)
     8926                                           , error-status:get-message(1)
     8927                                           , return-value ).
     8928           end.
     8929           find supp_trn-doc where
     8930               supp_trn-doc.doc-code = vardoc-code.
     8931           create temp-supp.
     8932           assign
     8933           temp-supp.doc-code      = supp_trn-doc.doc-code
     8934           temp-supp.cli-type      = supp_trn-doc.cli-type
     8935           temp-supp.cli-code      = supp_trn-doc.cli-code
     8936           supp_trn-doc.fact-date  = par-fact-date
     8937           supp_trn-doc.fact-time  = par-fact-time
     8938           supp_trn-doc.shift-date = par-shift-date
     8939           supp_trn-doc.shift-num  = par-shift-num
     8940           supp_trn-doc.shift-name = par-shift-name
     8941           supp_trn-doc.out-code   = buf_trn-doc.doc-code
     8942           supp_trn-doc.closed     = yes
     8943           supp_trn-doc.agnt       = buf_trn-doc.agnt
     8944           supp_trn-doc.boss       = buf_trn-doc.boss
     8945           supp_trn-doc.wrkr       = buf_trn-doc.wrkr
     8946           .
     8947         end.
     8948         FIND FIRST supp_doc-line WHERE
     8949                    supp_doc-line.doc-code  = supp_trn-doc.doc-code
     8950               AND  supp_doc-line.artic     = buf_parts.artic
     8951               and  supp_doc-line.prod-type = buf_parts.prod-type
     8952               and  supp_doc-line.prod-code = buf_parts.prod-code NO-ERROR .
     8953         if NOT available supp_doc-line then do:
     8954           find first buf_goods No-LOCK WHERE
     8955                      buf_goods.artic = buf_parts.artic
     8956                  AND buf_goods.prod-type = buf_parts.prod-type
     8957                  AND buf_goods.prod-code = buf_parts.prod-code.
     8958           find first buf_gds-prt no-lock where
     8959                       buf_gds-prt.upper-code = buf_goods.prt-root .
     8960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     8961     (input  buf_gds-prt.node-code
     8962     ,output var-term-node
     8963     )  .
     8964           CREATE supp_doc-line.
     8965           assign
     8966           supp_doc-line.doc-code    = supp_trn-doc.doc-code
     8967           supp_doc-line.artic       = buf_parts.artic
     8968           supp_doc-line.prod-type   = buf_parts.prod-type
     8969           supp_doc-line.prod-code   = buf_parts.prod-code
     8970           supp_doc-line.obj-type    = buf_parts.obj-type
     8971           supp_doc-line.obj-code    = buf_parts.obj-code
     8972           supp_doc-line.doc-qnty    = 0
     8973           supp_doc-line.fact-qnty   = 0
     8974           supp_doc-line.price-base  = 0
     8975           supp_doc-line.price-rubl  = 0
     8976           supp_doc-line.prt-OK      = yes
     8977           supp_doc-line.prt-root    = buf_doc-line.prt-root
     8978           supp_doc-line.VAT-pc      = buf_parts.vat-pc
     8979           supp_doc-line.cons-vat-pc = buf_sysconf.cons-VAT-pc
     8980           supp_doc-line.SLT-pc      = 0
     8981           supp_doc-line.road-tax    = 0
     8982           supp_doc-line.excise      = 0
     8983           supp_doc-line.other-rubl  = 0
     8984           supp_doc-line.other-base  = 0
     8985           .
     8986         end.
     8987         find first supp_gds-dtl where
     8988                   supp_gds-dtl.doc-code  = supp_doc-line.doc-code
     8989               and supp_gds-dtl.artic     = supp_doc-line.artic
     8990               and supp_gds-dtl.prod-code = supp_doc-line.prod-code
     8991               and supp_gds-dtl.prod-type = supp_doc-line.prod-type
     8992               and supp_gds-dtl.prt-code  = var-term-node no-error .
     8993         if not available supp_gds-dtl then do:
     8994   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     8995     ( input supp_doc-line.obj-code
     8996      ,input supp_doc-line.obj-type
     8997      ,input supp_doc-line.doc-code
     8998      ,input supp_doc-line.artic
     8999      ,input supp_doc-line.prod-code
     9000      ,input supp_doc-line.prod-type
     9001      ,input var-term-node
     9002      ,input no
     9003     ) no-error .
     9004             if error-status:error then do:
     9005               undo _main, return error substitute("Ошибка при создании строки документа &1 смены типа приобретения для &2:&3" +
     9006                                                 "товар  &4&2&5 &6"
     9007                                                   ,supp_doc-line.doc-code
     9008                                                   ,par-doc-code
     9009                                                   ,chr(10)
     9010                                                   ,(supp_doc-line.artic + chr(32) + supp_doc-line.prod-type + string(supp_doc-line.prod-code))
     9011                                                   ,error-status:get-message(1)
     9012                                                   ,return-value ).
     9013             end.
     9014           FIND FIRST supp_gds-dtl WHERE
     9015                     supp_gds-dtl.doc-code  = supp_doc-line.doc-code
     9016                 and supp_gds-dtl.artic     = supp_doc-line.artic
     9017                 and supp_gds-dtl.prod-code = supp_doc-line.prod-code
     9018                 and supp_gds-dtl.prod-type = supp_doc-line.prod-type
     9019                 and supp_gds-dtl.prt-code  = var-term-node.
     9020           assign
     9021           supp_gds-dtl.discnt-type = no
     9022           supp_gds-dtl.fact-qnty = 0
     9023           supp_gds-dtl.doc-qnty = 0
     9024           supp_gds-dtl.ov = no
     9025           supp_gds-dtl.discnt-rubl = 0
     9026           supp_gds-dtl.discnt-base = 0
     9027           supp_gds-dtl.price-rubl =  price-rubl-with-tax-sale
     9028           supp_gds-dtl.price-base =  price-base-with-tax-sale
     9029           supp_doc-line.road-tax   =  (if v-curr-r-b = 'base':U
     9030                                       then road-tax-base-sale
     9031                                       else road-tax-rubl-sale
     9032                                     )
     9033           supp_doc-line.excise   =  (if v-curr-r-b = 'base':U
     9034                                       then excise-base-sale
     9035                                       else excise-rubl-sale
     9036                                     )
     9037           .
     9038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9039     (input  buf_goods.gds-code
     9040     ,input  supp_gds-dtl.prt-code
     9041     ,output v-prt-b-code
     9042     ) no-error .
     9043           if error-status :error then do:
     9044             undo _main, return error substitute("Ошибка при определении бар-кода признака&1" +
     9045                                                "документ  &2 код товара &3 код признака &4:&1&5 &6"
     9046                                                 ,chr(10)
     9047                                                 ,supp_trn-doc.doc-code
     9048                                                 ,buf_goods.gds-code
     9049                                                 ,supp_gds-dtl.prt-code
     9050                                                 ,error-status:get-message(1)
