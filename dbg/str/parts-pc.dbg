     8607   end.
     8608   else do:
     8609     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     8610                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     8611                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     8612                                  and out-vatp_parts.artic      = buf_doc-line.artic
     8613                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     8614                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     8615       if out-vatp_parts.purch-code = 2 then do:
