     1838       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1839       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1840       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1841       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1842       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1843       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1844       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1845       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1846       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1847       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1848       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1849       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1850       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1851       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1852       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1853       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1854       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1855       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1856       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1857       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1858       .
     1859   end.
     1860   otherwise do:
     1861     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1862                              cl_tt-clcparts.purch-code,
     1863                              cl_tt-clcparts.part-code,
     1864                              cl_tt-clcparts.out-code,
     1865                              cl_tt-clcparts.in-code,
     1866                              cl_tt-clcparts.artic,
     1867                              cl_tt-clcparts.prod-type,
     1868                              cl_tt-clcparts.prod-code).
     1869   end.
     1870   end case.
     1871   end.
     1872   end procedure.
     1873   procedure clcprtsl_calc-line :
     1874   define input  parameter parrec-line as recid no-undo.
     1875   define variable v-tax-date         as   date                     no-undo.
     1876   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1877   define variable varr-b             as   character                no-undo.
     1878   define variable varr-btype         as   character                no-undo.
     1879   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1880   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1881   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1882   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1883   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1884   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1885   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1886   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1887   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1888   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1889   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1890   define variable varexcise          like ub.price-list.excise     no-undo.
     1891   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1892   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1893   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1894   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1895   define variable v-varsum           as decimal                  no-undo.
     1896   define variable varprice-salef as decimal   no-undo .
     1897   define buffer bf_trn-doc             for ub.trn-doc.
     1898   define buffer bf_doc-line            for ub.doc-line.
     1899   define buffer bf_gds-dtl             for ub.gds-dtl.
     1900   define buffer bf_goods               for ub.goods.
     1901   define buffer bf_parts               for ub.parts.
     1902   define buffer bf_sysconf             for ub.sysconf.
     1903   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1904   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1905   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1906   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1907   define buffer buf_parts        for ub.parts.
     1908   v-calcbypart = no.
     1909   do on error undo, return error return-value :
     1910   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1912     (output varr-b
     1913     )  .
     1914     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1915     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1916     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1917                               bf_goods.prod-type = bf_doc-line.prod-type and
     1918                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1919     if bf_trn-doc.fact-date <> ?        then do:
     1920       assign v-tax-date = bf_trn-doc.fact-date.
     1921     end.
     1922     else do:
     1923       assign v-tax-date = ?.
     1924     end.
     1925   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1926   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1927     (input  bf_goods.gds-code
     1928     ,input  '1':U
     1929     ,input  v-tax-date
     1930     ,input  bf_trn-doc.host-code
     1931     ,input  bf_trn-doc.obj-type
     1932     ,input  bf_trn-doc.obj-code
     1933     ,output v-vat-pc
     1934     ) no-error .
     1935     if error-status :error
     1936     or v-vat-pc = ? then do:
     1937        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1938     end.
     1939     if bf_goods.gds-type = 'у':U or
     1940        bf_trn-doc.status_ = 'запрос':U then do:
     1941       for each bf_tt-allsum-line
     1942       on error undo, return error return-value
     1943        :
     1944         delete bf_tt-allsum-line.
     1945       end.
     1946       create bf_tt-allsum-line.
     1947       assign
     1948        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1949       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1950                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1951                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1952                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1953         assign
     1954           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1955           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1956           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1957           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1958           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1959           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1960           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1961           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1962           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1963           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1964           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1965           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1966           bf_tt-allsum-line.vat-cli-acc          =  ?
     1967           .
     1968       end.
     1969       assign
     1970         bf_tt-allsum-line.cli-qnty             =  ?
     1971         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1972         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1973         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1974         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1975         bf_tt-allsum-line.road-tax-base-doc    =  0
     1976         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1977         bf_tt-allsum-line.excise-base-doc      =  0
     1978         bf_tt-allsum-line.excise-rubl-doc      =  0
     1979         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1980         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1981         bf_tt-allsum-line.dsc-base-cur         =  0
     1982         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1983         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1984         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1985         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1986         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1987         bf_tt-allsum-line.road-tax-base-cur    =  0
     1988         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1989         bf_tt-allsum-line.excise-base-cur      =  0
     1990         bf_tt-allsum-line.excise-rubl-cur      =  0
     1991         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1992         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1993         bf_tt-allsum-line.dsc-base-acc         =  0
     1994         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1995         bf_tt-allsum-line.dsc-cli-acc          =  0
     1996         bf_tt-allsum-line.slt-base-acc         =  0
     1997         bf_tt-allsum-line.slt-rubl-acc         =  0
     1998         bf_tt-allsum-line.slt-cli-acc          =  0
     1999         bf_tt-allsum-line.road-tax-base-acc    =  0
     2000         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2001         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2002         bf_tt-allsum-line.excise-base-acc      =  0
     2003         bf_tt-allsum-line.excise-rubl-acc      =  0
     2004         bf_tt-allsum-line.excise-cli-acc       =  0
     2005         bf_tt-allsum-line.transport-base-acc   =  0
     2006         bf_tt-allsum-line.transport-rubl-acc   =  0
     2007         bf_tt-allsum-line.transport-cli-acc    =  0
     2008         bf_tt-allsum-line.other-base-acc       =  0
     2009         bf_tt-allsum-line.other-rubl-acc       =  0
     2010         bf_tt-allsum-line.other-cli-acc        =  0
     2011         .
     2012       create bfs_tt-allsum-line.
     2013       assign
     2014       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2015       if bf_trn-doc.doc-type = 'инв':U or
     2016          bf_trn-doc.doc-type = 'при':U    or
     2017          bf_trn-doc.doc-type = 'возврат':U    then do:
     2018          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2019       end.
     2020       else do:
     2021         assign
     2022           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2023           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2024           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2025           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2026           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2027           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2028           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2029           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2030           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2031           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2032           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2033           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2034           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2035           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2036           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2037           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2038           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2039           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2040           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2041           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2042           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2043           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2044           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2045           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2046           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2047           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2048           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2049           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2050           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2051           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2052           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2053           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2054           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2055           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2056           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2057           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2058           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2059           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2060           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2061           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2062           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2063           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2064           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     2065           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     2066           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     2067           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     2068           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     2069           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     2070           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     2071           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     2072           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     2073           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
     2074           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
     2075           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     2076           .
     2077       end.
     2078       create bfo_tt-allsum-line.
     2079       assign
