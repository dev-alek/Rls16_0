       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define variable v-waitfram-action01         as character   no-undo .
       91   define variable v-waitfram-action02         as character   no-undo .
       92   define variable v-waitfram-action03         as character   no-undo .
       93   define variable mWaitFramTextBeg            as character   no-undo.
       94   define variable mWaitFramTextEnd            as character   no-undo.
       95   define variable mWaitFramView               as logical     no-undo.
       96   define variable mWaitProcEvent              as logical     no-undo init yes.
       97   define variable mWaitFramInterval           as integer     no-undo init 1 .
       98   define variable mWaitFramStop               as logical     no-undo.
       99   define variable mWaitFramStopUser           as logical     no-undo.
      100   define variable mWaitFramStopTimeOut        as logical     no-undo.
      101   define variable mWaitFramStartProc          as datetime-tz no-undo.
      102   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      103   define button B-WaitFramStop auto-end-key
      104        label "Стоп"
      105        size 10 by 1 tooltip "Остоновить процесс".
      106   define button B-viewProcInfo
      107        label "Информация"
      108        size 15 by 1 tooltip "Информация о процесс".
      109   define frame waitfram
      110     v-waitfram-action01 format "x(72)" no-label skip
      111     v-waitfram-action02 format "x(72)" no-label skip
      112     v-waitfram-action03 format "x(72)" no-label skip
      113     B-viewProcInfo
      114     B-WaitFramStop at row 4 col 30
      115     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      116     .
      117   define new global shared variable mBatchMode as logical no-undo init ?.
      118   define variable mFramBachModHandle as handle no-undo.
      119   mFramBachModHandle = frame waitfram:handle.
      120   define variable mFameOldVis as logical no-undo.
      121   define variable mVisCUrentVin as logical no-undo.
      122   if session:batch-mode
      123   then
      124      mBatchMode = yes.
      125   if mBatchMode = ? then do:
      126     mVisCUrentVin = current-window:visible.
      127     mFameOldVis = mFramBachModHandle:visible.
      128     mFramBachModHandle:visible  = yes.
      129     mBatchMode = mFramBachModHandle:visible ne yes.
      130     mFramBachModHandle:visible = mFameOldVis.
      131     current-window:visible = mVisCUrentVin.
      132   end.
      133    if  log-manager:logfile-name ne ?
      134     then DO:
      135         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      136         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      137         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      138     end.
      139   on choose of B-WaitFramStop in frame waitfram
      140   do:
      141     mWaitFramStop = yes.
      142     mWaitFramStopUser = yes.
      143   end.
      144   function waitfram-check-timeout returns logical():
      145      define variable vtime as int64 no-undo.
      146      if mWaitFramStopTimeOut
      147      then
      148         return yes.
      149      vtime = ( now - mWaitFramStartProc ) / 1000 .
      150      if     mWaitFramTimeOut ne ?
      151         and mWaitFramTimeOut ne 0
      152         and mWaitFramTimeOut lt vtime
      153      then do:
      154         mWaitFramStopTimeOut = yes.
      155      end.
      156      return mWaitFramStopTimeOut.
      157   end.
      158   procedure waitfram-hide :
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       pause 0 before-hide .
      164       if not mBatchMode then
      165         hide frame waitfram .
      166     end.
      167   end procedure.
      168   procedure waitfram-show :
      169     define input  parameter p-message as character no-undo .
      170     define variable v-left-margin as integer   no-undo .
      171     if not session:batch-mode
      172     then do
      173     on error undo, return error return-value
      174     :
      175       if length(p-message) <= 70 then do:
      176         assign
      177           v-left-margin = integer((70 - length(p-message)) / 2)
      178         .
      179         assign
      180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      181         .
      182         assign
      183           v-waitfram-action01 = " "
      184           v-waitfram-action02 = " "
      185                                    + fill(" ", v-left-margin)
      186                                    + p-message
      187           v-waitfram-action03 = " "
      188         .
      189       end.
      190       else do:
      191         define variable vRindex1 as integer no-undo.
      192         define variable vRindex2 as integer no-undo.
      193         vRindex1 = r-index(p-message," ",70).
      194         if vRindex1 = 0
      195         then
      196            vRindex1 = 70.
      197         if length(p-message)  <= vRindex1 + 70 then do:
      198           assign
      199             v-waitfram-action01 = " "
      200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      202           .
      203         end.
      204         else do:
      205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      206           if vRindex2 <= vRindex1
      207           then
      208              vRindex2 = vRindex1 + 70.
      209           assign
      210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      213           .
      214         end.
      215       end.
      216       B-viewProcInfo:visible   in frame waitfram = no.
      217       B-viewProcInfo:sensitive in frame waitfram = no.
      218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       if  (   mWaitFramView
      221          or  mWaitProcEvent)
      222          and not mBatchMode
      223       then
      224          display
      225             v-waitfram-action01 skip
      226             v-waitfram-action02 skip
      227             v-waitfram-action03 skip
      228          with frame waitfram .
      229     end.
      230   end procedure.
      231      procedure waitfram-show-this:
      232         define input  parameter iInterval as int64 no-undo.
      233         define variable vtime as int64 no-undo.
      234         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      235         mWaitFramInterval = iInterval.
      236         run waitfram-show (substitute("&1&2 &3&4" ,
      237                                       mWaitFramTextBeg ,
      238                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      239                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      240                                       mWaitFramTextEnd
      241                                      )
      242                           ).
      243      end.
      244      procedure WaitFramRunPause:
      245         define input  parameter iInterval as dec no-undo.
      246         define variable vStart  as datetime-tz no-undo.
      247         define variable vend    as datetime-tz no-undo.
      248         define variable vint as int64 no-undo.
      249         define variable vOk as logical no-undo.
      250         vStart = now.
      251         vend   = vStart.
      252         publish "WaitFramPause" (iInterval,output vOk).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and (   vint > 0
      258                 or (    not vOk
      259                     and iInterval eq ?
      260                     )
      261                 )
      262         then
      263            run waitfram-show-this (iInterval).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and vint > 0
      269         then do:
      270            run gbl/pause.p (vint * 1000).
      271         end.
      272         if iInterval ne ?
      273         then
      274            publish "WaitFramStop".
      275         waitfram-check-timeout().
      276      end.
      277      procedure WaitFramWaitFor:
      278         define input  parameter iInterval as dec no-undo.
      279         assign
      280            mWaitFramStartProc   = now
      281            mWaitFramStopUser    = no
      282            mWaitFramStopTimeOut = no
      283         .
      284         block-wait:
      285         do while not mWaitFramStop:
      286            run WaitFramRunPause (iInterval).
      287            if  waitfram-check-timeout()
      288            then do:
      289               leave block-wait.
      290            end.
      291         end.
      292         run waitfram-hide.
      293      end.
      294   procedure waitfram-join :
      295     define input  parameter p-line-1  as character no-undo .
      296     define input  parameter p-line-2  as character no-undo .
      297     define input  parameter p-line-3  as character no-undo .
      298     define output parameter p-message as character no-undo .
      299     do
      300     on error undo, return error return-value
      301     :
      302       assign
      303         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      306       .
      307     end.
      308   end procedure.
      309   function waitfram-join-function returns character
      310     (input p-line-1 as character
      311     ,input p-line-2 as character
      312     ,input p-line-3 as character
      313     ).
      314     define variable v-message as character no-undo .
      315     run waitfram-join in this-procedure
      316       (input  p-line-1
      317       ,input  p-line-2
      318       ,input  p-line-3
      319       ,output v-message
      320       ) .
      321     return v-message .
      322   end function .
      323   define new global shared variable g#lib-trn  as handle no-undo .
      324   define new global shared variable g#lib-trn2 as handle no-undo .
      325   define new global shared variable g#lib-trn3 as handle no-undo .
      326   define new global shared variable g#lib-trn4 as handle no-undo .
      327   define new global shared variable g#libtfarh as handle no-undo .
      328   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   procedure doc-code:
      330   define input  parameter parmode          as   character           no-undo.
      331   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      332   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      333   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      334   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      335   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      336   define variable vardb-remote     as   logical             no-undo.
      337   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      338   define variable v-delimiter as character no-undo .
      339   do
      340   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      341   :
      342   find first buf_sys-ctrl no-lock .
      343   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      344     CASE parmode:
      345       when "main":u then do:
      346         if vardb-remote then do:
      347           assign
      348             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      349         end.
      350         else do:
      351           assign
      352             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      353         end.
      354       end.
      355       when "trio" then do:
      356         assign
      357           pardoc-code = replace (parroot-doc-code, "=", "*").
      358       end.
      359       otherwise do:
      360         assign
      361         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      362         no-error
      363         .
      364         if error-status:error  then do:
      365           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      366                                         ,chr(10)
      367                                         ,parmode
      368                                         ).
      369         end.
      370         if num-entries(parmode) = 1
      371         and parmode <> "chip":U
      372         and parmode <> "chip_s":U
      373         then do:
      374           assign
      375           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      376         end.
      377         else if (lookup("chip":U, parmode) > 0
      378                  or
      379                  lookup("chip_s":U, parmode) > 0) then do:
      380           assign
      381             vartemp-doc-code = parroot-doc-code.
      382           do while true:
      383             if index (vartemp-doc-code , ".") = 0 then
      384               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      385             else
      386               vartemp-doc-code  =
      387               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      388               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      389               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      390             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      391           end.
      392           assign
      393             pardoc-code = vartemp-doc-code.
      394         end.
      395       end.
      396     end CASE.
      397     if pardoc-code = '':U
      398     or (parroot-doc-code <> '':U
      399     and pardoc-code = parroot-doc-code) then do:
      400       undo, return error substitute("Ошибка при генерации номера документа&1"
      401                                     ,chr(10)).
      402     end.
      403   end.
      404   end. // procedure/method
      405   function get-doc-code-int64 returns int64
      406     ( input p-doc-code as character ) :
      407     define variable v-ind              as integer   no-undo .
      408     define variable v-num-entries      as integer   no-undo .
      409     define variable v-doc-code-int64   as int64     no-undo .
      410     define variable v-canonic-doc-code as character no-undo .
      411     assign
      412       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      413       v-canonic-doc-code = p-doc-code
      414     .
      415     do v-ind = 1 to v-num-entries
      416     :
      417       assign
      418         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      419       .
      420     end.
      421     assign
      422       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      423     .
      424     return v-doc-code-int64 .
      425   end. // function/method
