     7487                   "Необходимо резервировать" v-need-rsrv skip
     7488                   "Резерв" v-rsrv-code skip
     7489                   "Необходимо снятие резервов" v-need-unrv skip
     7490                   "Снятие резервов" v-unrv-code skip
     7491                   error-status :get-message(1) skip
     7492                   return-value skip
     7493                   view-as alert-box error .
     7494                 undo, return error .
     7495               end.
     7496               assign
     7497                 buf_parts.fact-date = buf_parts-attr.fact-date
     7498                 buf_parts.fact-num  = v-fact-num
     7499                 buf_parts.doc-type  = v-doc-type
     7500               .
     7501             end.
     7502             assign
     7503               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     7504               buf_parts.fact-qnty = buf_parts.qnty
     7505             .
     7506   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     7508     (input  buf_parts.artic
     7509     ,input  buf_parts.prod-type
     7510     ,input  buf_parts.prod-code
     7511     ,output v-gds-code
     7512     ) no-error .
     7513             if buf_parts.out-code = 'free-zone':U
     7514             then
     7515             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     7516                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     7517                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     7518                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     7519                                                         and buf_marking-lines.out-code = archive_parts.out-code
     7520                                                         and buf_marking-lines.part-code = archive_parts.part-code
     7521                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     7522               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     7523                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     7524                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     7525                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     7526                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     7527                                                         and free_marking-lines.in-code    = buf_parts.in-code
     7528                                                         and free_marking-lines.out-code   = buf_parts.out-code
     7529                                                         and free_marking-lines.part-code  = buf_parts.part-code
     7530                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     7531                                                         no-error .
     7532                 if not available free_marking-lines
     7533                 then do :
     7534                   create free_marking-lines .
     7535                   assign
     7536                     free_marking-lines.mark       = buf_marking-lines.mark
     7537                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     7538                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     7539                     free_marking-lines.obj-type   = buf_parts.obj-type
     7540                     free_marking-lines.obj-code   = buf_parts.obj-code
     7541                     free_marking-lines.in-code    = buf_parts.in-code
     7542                     free_marking-lines.out-code   = buf_parts.out-code
     7543                     free_marking-lines.part-code  = buf_parts.part-code
     7544                     free_marking-lines.prt-code   = buf_parts.prt-code
     7545                   .
     7546                 end .
     7547                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     7548                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     7549                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     7550                 if buf_trn-doc.ext-doc-type = 'es':U
     7551                 then do :
     7552                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     7553                 end .
     7554                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     7555                   assign buf_marking-chk.sts = 0 .
     7556                 end .
     7557               end .
     7558               delete buf_marking-lines .
     7559             end.
     7560             if v-goods-twounit = true
     7561             then do:
     7562               assign
     7563                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     7564               .
     7565             end.
     7566             else do:
     7567               if buf_parts.cli-base-rate <> 0
     7568               then do:
     7569                 assign
     7570                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     7571                 .
     7572               end.
     7573               else do:
     7574                 assign
     7575                   buf_parts.cli-qnty = 0
     7576                 .
     7577               end.
     7578             end.
     7579             if  buf_parts.qnty      = 0
     7580             and buf_parts.fact-qnty = 0
     7581             then do:
     7582               if v-goods-twounit = true
     7583               then do:
     7584                 if buf_parts.cli-qnty <> 0
     7585                 then do:
     7586                   message
     7587                     vss-workfile vss-revision vss-description skip
     7588                     vss-include-info28 skip
     7589                     "Ошибка при удалении партии" skip
     7590                     "Документ" p-doc-code skip
     7591                     "Объект" p-obj-type p-obj-code skip
     7592                     "Артикул" p-artic p-prod-type p-prod-code skip
     7593                     "Партия" buf_parts.in-code buf_parts.part-code skip
     7594                     "Резерв" buf_parts.out-code skip
     7595                     "qnty" buf_parts.qnty skip
     7596                     "fact-qnty" buf_parts.fact-qnty skip
     7597                     "cli-qnty" buf_parts.cli-qnty skip
     7598                     view-as alert-box error .
     7599                   undo, return error .
     7600                 end.
     7601               end.
     7602               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     7603                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     7604                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     7605                                                           and del_marking-lines.in-code = buf_parts.in-code
     7606                                                           and del_marking-lines.out-code = buf_parts.out-code
     7607                                                           and del_marking-lines.part-code = buf_parts.part-code
     7608                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     7609                 delete del_marking-lines .
     7610               end.
     7611               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     7612                                           ,input (buffer buf_parts:handle)
     7613                                           ,output part-key-rec).
     7614               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     7615                                        and ub.gen-attr.p-key =  part-key-rec
     7616               :
     7617                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     7618                 find current buf1_gen-attr exclusive-lock.
     7619                 delete buf1_gen-attr .
     7620               end.
     7621               delete buf_parts .
     7622             end.
     7623           end.
     7624         end.
     7625       end.
     7626     end.
     7627   end procedure.
     7628   procedure partcopy-rsrv-parts :
     7629     define input  parameter p-doc-code-rowid as rowid no-undo .
     7630     define input  parameter p-parts-rowid    as rowid no-undo .
     7631     define input  parameter p-rsrv-direction as logical   no-undo .
     7632     define input  parameter p-goods-twounit  as logical   no-undo .
     7633     define input  parameter p-is-hold        as logical   no-undo .
     7634     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     7635     define buffer buf_trn-doc for ub.trn-doc .
     7636     define buffer archive_parts for ub.parts .
     7637     define buffer buf_parts   for ub.parts .
     7638     define buffer orig_marking-lines for ub.marking-lines .
     7639     define buffer buf_marking-lines for ub.marking-lines .
     7640     define buffer buf_marking   for ub.marking .
     7641     define buffer buf_goods for ub.goods .
     7642     define variable v-rsrv-code as character no-undo .
     7643     do
     7644     on error undo, return error return-value
     7645     :
     7646       find first buf_trn-doc no-lock
     7647         where rowid(buf_trn-doc) = p-doc-code-rowid
     7648         no-error .
     7649       if not available buf_trn-doc
     7650       then do:
     7651         message
     7652           vss-workfile vss-revision vss-description skip
     7653           vss-include-info28 skip
     7654           "Ошибка задания входных параметров" skip
     7655           "Не найден документ" skip
     7656           "Документ" string(p-doc-code-rowid) skip
     7657           "Партия" string(p-parts-rowid) skip
     7658           error-status :get-message(1) skip
     7659           return-value skip
     7660           view-as alert-box error .
     7661         undo, return error .
     7662       end.
     7663       find first archive_parts
     7664         where rowid(archive_parts) = p-parts-rowid
     7665         no-error .
     7666       if not available archive_parts
     7667       then do:
     7668         message
     7669           vss-workfile vss-revision vss-description skip
     7670           vss-include-info28 skip
     7671           "Ошибка задания входных параметров" skip
     7672           "Не найдена партия" skip
     7673           "Документ" string(p-doc-code-rowid) skip
     7674           "Партия" string(p-parts-rowid) skip
     7675           error-status :get-message(1) skip
     7676           return-value skip
     7677           view-as alert-box error .
     7678         undo, return error .
     7679       end.
     7680       if  archive_parts.out-code <> archive_parts.in-code
     7681       and archive_parts.qnty <> 0
     7682       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     7683       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     7684       then do:
     7685         assign
     7686           v-rsrv-code =
     7687           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     7688         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     7689         then 'free-zone':U
     7690         else 'out-zone':U )
     7691         .
     7692         run partcopy in this-procedure
     7693           (input  true
     7694           ,input  v-rsrv-code
     7695           ,buffer archive_parts
     7696           ,buffer buf_parts
     7697           ,input  "news"
     7698           ) no-error .
     7699         if error-status :error
     7700         then do:
     7701           message
     7702             vss-workfile vss-revision vss-description skip
     7703             vss-include-info28 skip
     7704             "Ошибка при создании партии" skip
     7705             "Документ" buf_trn-doc.doc-code skip
     7706             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     7707             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     7708             "Партия" archive_parts.in-code archive_parts.part-code skip
     7709             "Количество" archive_parts.qnty skip
     7710             "Резерв" v-rsrv-code skip
     7711             error-status :get-message(1) skip
     7712             return-value skip
     7713             view-as alert-box error .
     7714           undo, return error .
     7715         end.
     7716         assign
     7717           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     7718                                                     * (if p-rsrv-direction = true
     7719                                                       then 1
     7720                                                       else -1
     7721                                                       )
     7722           buf_parts.fact-qnty = buf_parts.qnty
     7723         .
     7724         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     7725                                        and buf_goods.prod-type = archive_parts.prod-type
     7726                                        and buf_goods.prod-code = archive_parts.prod-code
     7727                                        .
     7728         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     7729                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     7730                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     7731                                               and orig_marking-lines.in-code    = archive_parts.in-code
     7732                                               and orig_marking-lines.out-code   = archive_parts.out-code
     7733                                               and orig_marking-lines.part-code  = archive_parts.part-code
     7734                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     7735                                               :
     7736           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     7737                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     7738                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     7739                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     7740                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     7741                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     7742                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     7743                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     7744                                                   no-error .
     7745           if available buf_marking-lines
     7746           then do :
     7747             find current buf_marking-lines exclusive-lock .
     7748             delete buf_marking-lines .
     7749             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     7750               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     7751             end .
     7752           end .
     7753           else do :
     7754             create buf_marking-lines .
     7755             assign
     7756               buf_marking-lines.mark       = orig_marking-lines.mark
     7757               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     7758               buf_marking-lines.gds-code   = buf_goods.gds-code
     7759               buf_marking-lines.obj-type   = buf_parts.obj-type
     7760               buf_marking-lines.obj-code   = buf_parts.obj-code
     7761               buf_marking-lines.in-code    = buf_parts.in-code
     7762               buf_marking-lines.out-code   = buf_parts.out-code
     7763               buf_marking-lines.part-code  = buf_parts.part-code
     7764               buf_marking-lines.prt-code   = buf_parts.prt-code
     7765             .
     7766             if buf_parts.out-code <> buf_parts.in-code
     7767             and buf_parts.out-code <> 'free-zone':U
     7768             and buf_parts.out-code <> 'out-zone':U
     7769             then do :
     7770               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     7771               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     7772             end .
     7773             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     7774               assign
     7775                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     7776                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     7777               .
     7778             end .
     7779           end .
     7780           release buf_marking-lines no-error .
     7781         end.
     7782         if p-goods-twounit = true
     7783         then do:
     7784           assign
     7785             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     7786                                                     * (if p-rsrv-direction = true
     7787                                                       then 1
     7788                                                       else -1
     7789                                                       )
     7790           .
     7791         end.
     7792         if  buf_parts.qnty      = 0
     7793         and buf_parts.fact-qnty = 0
     7794         then do:
     7795           if p-goods-twounit = true
     7796           then do:
     7797             if buf_parts.cli-qnty <> 0
     7798             then do:
     7799               message
     7800                 vss-workfile vss-revision vss-description skip
     7801                 vss-include-info28 skip
     7802                 "Ошибка при удалении партии" skip
     7803                 "Документ" buf_trn-doc.doc-code skip
     7804                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     7805                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     7806                 "Партия" buf_parts.in-code buf_parts.part-code skip
     7807                 "Резерв" buf_parts.out-code skip
     7808                 "qnty" buf_parts.qnty skip
     7809                 "fact-qnty" buf_parts.fact-qnty skip
     7810                 "cli-qnty" buf_parts.cli-qnty skip
     7811                 view-as alert-box error .
     7812               undo, return error .
     7813             end.
     7814           end.
     7815           delete buf_parts .
     7816         end.
     7817       end.
     7818     end.
     7819   end procedure.
     7820   procedure partcopy-update-doc-line-tot-fact :
     7821     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     7822     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     7823     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     7824     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     7825     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     7826       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     7827     define buffer buf_doc-line for ub.doc-line .
     7828     do
     7829     on error undo, return error return-value
     7830     :
     7831       find first buf_doc-line exclusive-lock
     7832         where buf_doc-line.doc-code  = p-doc-code
     7833           and buf_doc-line.artic     = p-artic
     7834           and buf_doc-line.prod-type = p-prod-type
     7835           and buf_doc-line.prod-code = p-prod-code
     7836         no-error .
     7837       if error-status :error
     7838       then do:
     7839         message
     7840           vss-workfile vss-revision vss-description skip
     7841           vss-include-info28 skip
     7842           "Ошибка задания входных параметров" skip
     7843           "Не найдена строка документа" skip
     7844           "Документ" p-doc-code skip
     7845           "Артикул" p-artic p-prod-type p-prod-code skip
     7846           error-status :get-message(1) skip
     7847           return-value skip
     7848           view-as alert-box error .
     7849         undo, return error .
     7850       end.
     7851       run partrqst in this-procedure
     7852         (input buf_doc-line.doc-code
     7853         ,input buf_doc-line.obj-type
     7854         ,input buf_doc-line.obj-code
     7855         ,input buf_doc-line.artic
     7856         ,input buf_doc-line.prod-type
     7857         ,input buf_doc-line.prod-code
     7858               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     7859         ) no-error .
     7860       if error-status :error
     7861       then do:
     7862         message
     7863           vss-workfile vss-revision vss-description skip
     7864           vss-include-info28 skip
     7865           "Ошибка при сборе информации по партиям" skip
     7866           "Документ" p-doc-code skip
     7867           "Артикул" p-artic p-prod-type p-prod-code skip
     7868           view-as alert-box error .
     7869         undo, return error .
     7870       end.
     7871       if v-total-parts-fact-qnty <> 0
     7872       then do:
     7873         assign
     7874           buf_doc-line.price-base      = v-total-parts-price-base
     7875                                        / v-total-parts-fact-qnty
     7876           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     7877                                        / v-total-parts-fact-qnty
     7878           buf_doc-line.transport-base  = v-total-parts-transport-base
     7879                                        / v-total-parts-fact-qnty
     7880           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     7881                                        / v-total-parts-fact-qnty
     7882           buf_doc-line.other-base      = v-total-parts-other-base
     7883                                        / v-total-parts-fact-qnty
     7884           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     7885                                        / v-total-parts-fact-qnty
     7886         .
     7887       end.
     7888       else do:
     7889       end.
     7890     end.
     7891   end procedure.
     7892   procedure partcopy-change-purch-code :
     7893     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     7894     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     7895     define parameter buffer buf_orig_parts     for ub.parts .
     7896     define parameter buffer buf1_parts         for ub.parts .
     7897     define parameter buffer buf2_parts         for ub.parts .
     7898     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     7899     define variable var-out-code  like ub.parts.out-code no-undo .
     7900     define variable var-part-code like ub.parts.part-code no-undo .
     7901     define buffer buf_goods        for ub.goods .
     7902     define buffer buf_parts-root   for ub.parts-root.
     7903     define buffer buf_trn-doc      for ub.trn-doc.
     7904     define buffer buf-orig_trn-doc for ub.trn-doc.
     7905     define buffer buf_units        for ub.units .
     7906     do
     7907     on error undo, return error return-value
     7908     :
     7909       if buf_orig_parts.out-code = p-in-code
     7910       then do:
     7911         message
     7912           vss-workfile vss-revision vss-description skip
     7913           vss-include-info28 skip
     7914           "Ошибка задания входных параметров процедуры partcopy" skip
     7915           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     7916           "p-in-code" p-in-code skip
     7917           view-as alert-box error .
     7918         undo, return error .
     7919       end.
     7920       find first buf_trn-doc no-lock
     7921         where buf_trn-doc.doc-code = p-in-code
     7922         .
     7923       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     7924       find first buf_goods no-lock
     7925         where buf_goods.artic = buf_orig_parts.artic
     7926           and buf_goods.prod-type = buf_orig_parts.prod-type
     7927           and buf_goods.prod-code = buf_orig_parts.prod-code
     7928         .
     7929       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     7930       find first buf1_parts exclusive-lock
     7931         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     7932           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     7933           and buf1_parts.artic     = buf_orig_parts.artic
     7934           and buf1_parts.prod-type = buf_orig_parts.prod-type
     7935           and buf1_parts.prod-code = buf_orig_parts.prod-code
     7936           and buf1_parts.in-code   = buf_orig_parts.in-code
     7937           and buf1_parts.out-code  = p-in-code
     7938           and buf1_parts.part-code = buf_orig_parts.part-code
     7939         no-error.
     7940       if not available buf1_parts
     7941       then do:
     7942         create buf1_parts .
     7943         buffer-copy buf_orig_parts to buf1_parts
     7944         assign
     7945           buf1_parts.in-code    = buf_orig_parts.in-code
     7946           buf1_parts.out-code   = p-in-code
     7947           buf1_parts.status_    = no
     7948           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     7949           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     7950           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     7951           buf1_parts.purch-code = buf_orig_parts.purch-code
     7952           buf1_parts.rsrv-free  = ?
     7953           buf1_parts.status_    = yes
     7954         .
     7955         validate buf1_parts .
     7956       end.
     7957       if  lookup('сер':U, buf_units.type) > 0
     7958       then do:
     7959          var-part-code = buf_orig_parts.part-code.
     7960       end.
     7961       else do:
     7962           run holdprts-get-part-code in this-procedure
     7963             (input  p-in-code
     7964             ,output var-part-code
     7965             ) no-error .
     7966           if error-status :error
     7967           then dO:
     7968             undo, return error return-value.
     7969           end.
     7970       end.
     7971       find first buf2_parts exclusive-lock
     7972         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     7973           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     7974           and buf2_parts.artic     = buf_orig_parts.artic
     7975           and buf2_parts.prod-type = buf_orig_parts.prod-type
     7976           and buf2_parts.prod-code = buf_orig_parts.prod-code
     7977           and buf2_parts.in-code   = p-in-code
     7978           and buf2_parts.out-code  = p-in-code
     7979           and buf2_parts.part-code = var-part-code
     7980         no-error.
     7981       if not available buf2_parts
     7982       then do:
     7983         create buf2_parts .
     7984         buffer-copy buf_orig_parts to buf2_parts
     7985         assign
     7986           buf2_parts.in-code   = p-in-code
     7987           buf2_parts.out-code  = p-in-code
     7988           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     7989           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     7990           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     7991           buf2_parts.purch-code = p-dest-purch-code
     7992           buf2_parts.part-code  = var-part-code
     7993           buf2_parts.rsrv-free  = ?
     7994           buf2_parts.status_    = yes
     7995         .
     7996         validate buf2_parts .
     7997       end.
     7998       assign
     7999         buf_orig_parts.in-code    = p-in-code
     8000         buf_orig_parts.part-code  = buf2_parts.part-code
     8001         buf_orig_parts.purch-code = buf2_parts.purch-code
     8002       .
     8003       find first buf_parts-root
     8004         where buf_parts-root.doc-code       = p-in-code
     8005           and buf_parts-root.in-code        = p-in-code
     8006           and buf_parts-root.gds-code       = buf_goods.gds-code
     8007           and buf_parts-root.part-code      = buf2_parts.part-code
     8008           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     8009           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     8010           and buf_parts-root.orig-part-code = buf1_parts.part-code
     8011         no-error .
     8012       if not available buf_parts-root
     8013       then do:
     8014         create buf_parts-root.
     8015         assign
     8016         buf_parts-root.doc-code       = p-in-code
     8017         buf_parts-root.in-code        = p-in-code
     8018         buf_parts-root.gds-code       = buf_goods.gds-code
     8019         buf_parts-root.part-code      = buf2_parts.part-code
     8020         buf_parts-root.orig-in-code   = buf1_parts.in-code
     8021         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     8022         buf_parts-root.orig-part-code = buf1_parts.part-code
     8023         .
     8024       end.
     8025     end.
     8026   end procedure.
     8027   procedure addChildMarkingLines:
     8028     define input parameter iMark as character no-undo.
     8029     define input parameter iSts  as integer   no-undo.
     8030     define parameter buffer buf_marking-lines  for ub.marking-lines.
     8031     define parameter buffer buf_parts          for ub.parts.
     8032     define parameter buffer orig_marking-lines for ub.marking-lines.
     8033     define parameter buffer buf_orig_parts     for ub.parts.
     8034     define parameter buffer buf_goods          for ub.goods.
     8035     define buffer buf_marking-childs        for ub.marking.
     8036     define buffer buf_marking-lines-childs  for ub.marking-lines.
     8037     define buffer buf_marking-chk           for ub.marking-chk.
     8038     define buffer buf_chk-doc               for ub.chk-doc.
     8039     define buffer orig_marking-lines-childs for ub.marking-lines.
     8040     for each buf_marking-childs exclusive-lock where
     8041              buf_marking-childs.mark-parent = iMark :
     8042         find first buf_marking-lines-childs no-lock where
     8043                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     8044                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     8045                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     8046                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     8047                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     8048                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     8049                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     8050                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     8051         no-error .
     8052         if not available buf_marking-lines-childs then
     8053         do:
     8054           create buf_marking-lines-childs .
     8055           assign
     8056             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     8057             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     8058             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     8059             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     8060             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     8061             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     8062             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     8063             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     8064             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     8065             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     8066           .
     8067           validate buf_marking-childs.
     8068         end .
     8069         buf_marking-childs.sts = iSts .
     8070         for each buf_marking-chk exclusive-lock where
     8071                  buf_marking-chk.mark begins buf_marking-childs.mark
     8072         :
     8073           for first buf_chk-doc no-lock where
     8074                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     8075                 and buf_chk-doc.out-code = buf_parts.out-code
     8076           :
     8077             buf_marking-chk.sts = 0 .
     8078             validate buf_marking-chk.
     8079           end .
     8080         end .
     8081         if available orig_marking-lines
     8082         then do :
     8083           find first orig_marking-lines-childs exclusive-lock where
     8084                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     8085                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     8086                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     8087                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     8088                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     8089                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     8090                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     8091                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     8092           no-error .
     8093           if available orig_marking-lines-childs then
     8094             delete orig_marking-lines-childs .
     8095         end.
     8096         run addChildMarkingLines in this-procedure (
     8097           buf_marking-childs.mark,
     8098           iSts,
     8099           buffer buf_marking-lines,
     8100           buffer buf_parts,
     8101           buffer orig_marking-lines,
     8102           buffer buf_orig_parts,
     8103           buffer buf_goods
     8104         ).
     8105     end .
     8106   end.
     8107   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8108   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     8109   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     8110   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     8111   define variable gp-excise     like ub.price-list.excise     no-undo.
     8112   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     8113   define variable gp-fact-order as decimal   no-undo .
     8114   define variable gp-price-sale-parts as decimal   no-undo .
     8115   procedure corparts_clc-doc :
     8116   define input parameter parrec-id as recid no-undo.
     8117   define buffer bf_trn-doc  for ub.trn-doc.
     8118   define buffer bf_doc-line for ub.doc-line.
     8119   do on error undo, return error return-value :
     8120   find first bf_trn-doc where recid(bf_trn-doc) = parrec-id no-lock.
     8121   assign
     8122     bf_trn-doc.fact-rubl       = 0
     8123     bf_trn-doc.fact-base       = 0
     8124     bf_trn-doc.vat-rubl        = 0
     8125     bf_trn-doc.vat-base        = 0
     8126     bf_trn-doc.slt-rubl        = 0
     8127     bf_trn-doc.slt-base        = 0
     8128     bf_trn-doc.road-tax        = 0
     8129     bf_trn-doc.tot-transp   = 0
     8130     bf_trn-doc.tot-other       = 0.
     8131   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code on error undo, return error return-value :
     8132      run corparts_clc-line in this-procedure  (recid (bf_doc-line), "create":u) no-error.
     8133      if error-status:error then do:
     8134        return error substitute ("Ошибка &1 &2 &3 при пересчете линии документа &4. Товар &5 &6 &7.", return-value, error-status:get-message(1), error-status:get-message(2), bf_doc-line.doc-code, bf_doc-line.artic, bf_doc-line.prod-type, bf_doc-line.prod-code).
     8135      end.
     8136   end.
     8137   end.
     8138   end procedure.
     8139   procedure corparts_clc-line :
     8140   define input parameter parrec-id as recid     no-undo.
     8141   define input parameter parmode   as character no-undo.
     8142   define buffer bf_doc-line   for ub.doc-line.
     8143   define buffer bf_trn-doc    for ub.trn-doc.
     8144   define buffer bf_parts      for ub.parts.
     8145   define buffer bf_goods      for ub.goods.
     8146   define buffer bf_parts-root for ub.parts-root.
     8147   define variable varr-b      as character no-undo.
     8148   define variable varr-btype  as character no-undo.
     8149   do on error undo, return error return-value :
     8150     find first bf_doc-line where recid(bf_doc-line) = parrec-id no-lock.
     8151     for each bf_parts where bf_parts.out-code  = bf_doc-line.doc-code
     8152                         and bf_parts.obj-type  = bf_doc-line.obj-type
     8153                         and bf_parts.obj-code  = bf_doc-line.obj-code
     8154                         and bf_parts.artic     = bf_doc-line.artic
     8155                         and bf_parts.prod-type = bf_doc-line.prod-type
     8156                         and bf_parts.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     8157       run corparts_clc-parts in this-procedure (input recid(bf_parts), input parmode) no-error.
     8158       if error-status:error then do:
     8159         return error substitute ("Ошибка при пересчете партии документа &1 с кодом &2 товара &3 &4 &5.", bf_parts.out-code, bf_parts.part-code, bf_parts.artic, bf_parts.prod-type, bf_parts.prod-code).
     8160       end.
     8161     end.
     8162     assign
     8163       bf_doc-line.price-base     = 0
     8164       bf_doc-line.price-rubl     = 0
     8165       bf_doc-line.road-tax       = 0
     8166       bf_doc-line.transport-base = 0
     8167       bf_doc-line.transport-rubl = 0
     8168       bf_doc-line.other-base     = 0
     8169       bf_doc-line.other-rubl     = 0.
     8170   end.
     8171   end procedure.
     8172   procedure corparts_clc-parts :
     8173   define input parameter parrec-id as recid     no-undo.
     8174   define input parameter parmode   as character no-undo.
     8175   define variable varsign as integer no-undo.
     8176   define variable varvat-pc-buyer-doc like ub.doc-line.vat-pc no-undo.
     8177   define variable varvat-pc-sale-doc  like ub.doc-line.vat-pc no-undo.
     8178   define variable varslt-pc-sale-doc  like ub.doc-line.vat-pc no-undo.
     8179   define variable varvat-pc-acc       like ub.doc-line.vat-pc no-undo.
     8180   define variable varslt-pc-acc       like ub.doc-line.vat-pc no-undo.
     8181   define variable varr-b      as character no-undo.
     8182   define variable varr-btype  as character no-undo.
     8183   define buffer bf_parts    for ub.parts.
     8184   define buffer bf_doc-line for ub.doc-line.
     8185   define buffer bf_trn-doc  for ub.trn-doc.
     8186   do on error undo, return error return-value :
     8187   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8189     (output varr-b
     8190     )  .
     8191     find first bf_parts   where recid(bf_parts) = parrec-id no-lock.
     8192     find first bf_trn-doc where bf_trn-doc.doc-code = bf_parts.out-code no-lock.
     8193     find first bf_doc-line where bf_doc-line.doc-code  = bf_trn-doc.doc-code
     8194                              and bf_doc-line.artic     = bf_parts.artic
     8195                              and bf_doc-line.prod-type = bf_parts.prod-type
     8196                              and bf_doc-line.prod-code = bf_parts.prod-code no-lock.
     8197     if parmode <> "create":u and
     8198        parmode <> "delete":u then do:
     8199       return error substitute ("Неверный параметр parmode &1 передан процедуре corparts_clc-parts.", parmode).
     8200     end.
     8201     if parmode = "create":u then do:
     8202       assign
     8203         varsign = 1.
     8204     end.
     8205     else do:
     8206       assign
     8207         varsign = -1.
     8208     end.
     8209     for each tt-clcparts :
     8210       delete tt-clcparts.
     8211     end.
     8212     create tt-clcparts.
     8213     buffer-copy bf_parts to tt-clcparts.
     8214     run clcprtsl_calc-parts in this-procedure
     8215       (input recid(tt-clcparts),
     8216        input yes,
     8217        input no,
     8218        input bf_doc-line.road-tax,
     8219        input bf_doc-line.excise,
     8220        input bf_doc-line.vat-pc,
     8221        input bf_doc-line.cons-vat-pc,
     8222        input bf_doc-line.slt-pc,
     8223        input bf_trn-doc.base-rate,
     8224        input bf_trn-doc.base-scale,
     8225        input varr-b,
     8226        input ?,
     8227        input ?,
     8228        input ?,
     8229        input ?,
     8230        input ?,
     8231        input ?
     8232        ) no-error.
     8233     if error-status:error then do:
     8234       return error substitute ("Ошибка при расчете партии с кодом &1 документа &2 товар &3 &4 &5.", bf_parts.part-code, bf_parts.out-code, bf_parts.artic, bf_parts.prod-type, bf_parts.prod-code).
     8235     end.
     8236     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     8237     assign
     8238       bf_trn-doc.fact-rubl      = bf_trn-doc.fact-rubl      + varsign * bf_parts.price-rubl     * bf_parts.fact-qnty
     8239       bf_trn-doc.fact-base      = bf_trn-doc.fact-base      + varsign * bf_parts.price-base     * bf_parts.fact-qnty
     8240       bf_trn-doc.vat-rubl       = bf_trn-doc.vat-rubl       + varsign * tt-allsum.vat-rubl-doc  * bf_parts.fact-qnty
     8241       bf_trn-doc.vat-base       = bf_trn-doc.vat-base       + varsign * tt-allsum.vat-base-doc  * bf_parts.fact-qnty
     8242       bf_trn-doc.slt-rubl       = bf_trn-doc.slt-rubl       + varsign * tt-allsum.slt-rubl-doc  * bf_parts.fact-qnty
     8243       bf_trn-doc.slt-base       = bf_trn-doc.slt-base       + varsign * tt-allsum.slt-base-doc  * bf_parts.fact-qnty
     8244       bf_trn-doc.road-tax       = bf_trn-doc.road-tax       + varsign * bf_parts.road-tax-rubl  * bf_parts.fact-qnty
     8245       bf_trn-doc.tot-transp     = bf_trn-doc.tot-transp     + varsign * bf_parts.transport-rubl * bf_parts.fact-qnty
     8246       bf_trn-doc.tot-other      = bf_trn-doc.tot-other      + varsign * bf_parts.other-rubl     * bf_parts.fact-qnty.
     8247   end.
     8248   end procedure.
     8249       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     8250       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     8251       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     8252       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     8253       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     8254       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     8255       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     8256       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     8257       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     8258       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     8259       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     8260       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     8261       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     8262       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     8263       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
     8264       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
