     8490   _main:
     8491   do
     8492   on error undo, return error return-value
     8493   :
     8494     find first buf_trn-doc exclusive-lock where
     8495               buf_trn-doc.doc-code = par-doc-code .
     8496     find first  buf_sysconf no-lock where
     8497                 buf_sysconf.host-code = buf_trn-doc.host-code.
     8498     for each buf_doc-line no-lock where
     8499             buf_doc-line.doc-code = buf_trn-doc.doc-code
     8500     break
     8501     by buf_doc-line.doc-code
     8502     by buf_doc-line.artic
     8503     by buf_doc-line.prod-type
     8504     by buf_doc-line.prod-code
     8505     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     8506     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     8507     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     8508     :
     8509       if first-of(buf_doc-line.prod-code) then do:
     8510   if buf_trn-doc.ext-doc-type = 'ot':U or
     8511      buf_trn-doc.ext-doc-type = ?                 then do:
     8512     assign
     8513      out-vatp-have-vat-slt = yes.
     8514   end.
     8515   else do:
     8516     find first out-vatp_doc-attr no-lock
     8517       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8518         and out-vatp_doc-attr.attr-code = 'envd':U
     8519         no-error .
     8520     if not available out-vatp_doc-attr then do:
     8521       assign
     8522         out-vatp-have-vat-slt = yes.
     8523     end.
     8524     else do:
     8525        out-vatp-have-vat-slt = no.
     8526     end.
     8527   end.
     8528   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     8529                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     8530                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     8531   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     8533     (input  buf_doc-line.artic
     8534     ,input  buf_doc-line.prod-type
     8535     ,input  buf_doc-line.prod-code
     8536     ,output varroot-node
