     8556       "Ошибка при определении атрибута признака" skip
     8557       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8558       "Признак" varroot-node skip
     8559       "Запрашивался атрибут" "empty-scale=request" skip
     8560       error-status :get-message(1) skip
     8561       return-value skip
     8562       view-as alert-box error .
