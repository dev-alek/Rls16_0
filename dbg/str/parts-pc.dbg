     8565   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8567     (output varoutvprb
     8568     )  .
     8569   if varoutvprb = "base":u then do:
     8570     assign
     8571           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     8572       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     8573     .
     8574   end.
     8575   else do:
     8576     assign
     8577           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     8578       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     8579     .
     8580   end.
     8581   if varoutvprb = "rubl":u then do:
     8582     assign
     8583           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     8584       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     8585   end.
     8586   else do:
     8587     assign
     8588           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     8589       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     8590   end.
     8591   assign
     8592     varis-cons-parts-have =  no.
     8593   assign
     8594     varfact-qnty       = 0
     8595     varcons-qnty       = 0
     8596     varprice-base-cons = 0
     8597     varprice-rubl-cons = 0.
     8598   find first out-vatp_doc-line where
     8599              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     8600          and out-vatp_doc-line.artic      = buf_doc-line.artic
     8601          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     8602          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     8603   if available out-vatp_doc-line           and
     8604     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     8605     assign
