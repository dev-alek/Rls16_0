     2163     ,input  varb-code
     2164     ,input  0
     2165     ,input  bf_trn-doc.fact-order
     2166     ,output vardoc-num
     2167     ,output varprice-sale
     2168     ,output varroad-tax
     2169     ,output varexcise
     2170     )  .
     2171             if varprice-sale = ?
