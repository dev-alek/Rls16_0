     2300   procedure clcprtsl_calc-ttable :
     2301   define input parameter paris-doc           as   logical                 no-undo.
     2302   define input parameter paris-cur           as   logical                 no-undo.
     2303   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2304   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2305   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2306   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2307   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2308   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2309   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2310   define input parameter parr-b              as   character               no-undo.
     2311   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2312   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2313   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2314   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2315   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2316   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2317   define buffer bf_tt-allsum      for tt-allsum.
     2318   define buffer bf_tt-clcparts    for tt-clcparts.
     2319   define buffer bf_tt-allsum-line for tt-allsum-line.
     2320   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2321   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2322   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2323   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2324   define variable varexcise          like ub.price-list.excise     no-undo.
     2325   do on error undo, return error return-value :
     2326   for each bf_tt-allsum-line
     2327   on error undo, return error return-value
     2328    :
     2329     delete bf_tt-allsum-line.
     2330   end.
     2331   for each bf_tt-allsum
     2332   on error undo, return error return-value
     2333   :
     2334     delete bf_tt-allsum.
     2335   end.
     2336   for each bf_tt-clcparts
     2337   on error undo, return error return-value
     2338   :
     2339   if v-calcbypart then do:
     2340             assign
     2341             parcur-base =   bf_tt-clcparts.part-cur-base
     2342             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2343             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2344             .
     2345   end.
     2346      run clcprtsl_calc-parts in this-procedure (
     2347        input recid(bf_tt-clcparts),
     2348        input paris-doc,
     2349        input paris-cur,
     2350        input parroad-tax,
     2351        input parexcise,
     2352        input parvat-pc,
     2353        input parcons-vat-pc,
     2354        input parslt-pc,
     2355        input parbase-rate,
     2356        input parbase-scale,
     2357        input parr-b,
     2358        input parcur-base,
     2359        input parcur-road-tax,
     2360        input parcur-excise,
     2361        input parcur-vat-pc,
     2362        input parcurcons-vat-pc,
     2363        input parcurslt-pc
     2364        ) no-error.
     2365     if error-status:error then do:
     2366       message
     2367         vss-workfile vss-revision vss-description skip
     2368         vss-include-info2 skip
     2369         "Ошибка при обсчете партии" skip
     2370         "Документ партии " bf_tt-clcparts.out-code skip
