     2403         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2404         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2405         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2406         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2407         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2408         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2409         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2410         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2411         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2412         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2413         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2414         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2415         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2416         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2417         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2418         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2419         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2420         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2421         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2422         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2423         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2424         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2425         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2426         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2427         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2428         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2429         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2430         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2431         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2432         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2433         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2434         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2435         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2436         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2437         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2438         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2439         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2440         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2441         .
     2442     end.
     2443   end.
     2444   end.
     2445   end procedure.
     2446   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   procedure partrqst :
     2448     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     2449     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     2450     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     2451     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     2452     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     2453     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     2454     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     2455     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     2456     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     2457     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     2458     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     2459     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     2460     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     2461     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     2462     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     2463     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     2464     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     2465     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     2466     do
     2467     on error undo, return error return-value
     2468     :
     2469       assign
     2470         p-total-parts-qnty           = 0
     2471         p-total-parts-fact-qnty      = 0
     2472         p-total-parts-cli-qnty       = 0
     2473         p-total-parts-fact-cli-qnty  = 0
     2474         p-total-parts-price-cli      = 0
     2475         p-total-parts-price-base     = 0
     2476         p-total-parts-price-rubl     = 0
     2477         p-total-parts-transport-base = 0
     2478         p-total-parts-transport-rubl = 0
     2479         p-total-parts-other-base     = 0
     2480         p-total-parts-other-rubl     = 0
     2481       .
     2482       define buffer buf_parts for ub.parts .
     2483       for each buf_parts no-lock
     2484         where buf_parts.out-code  = p-doc-code
     2485           and buf_parts.obj-type  = p-obj-type
     2486           and buf_parts.obj-code  = p-obj-code
     2487           and buf_parts.artic     = p-artic
     2488           and buf_parts.prod-type = p-prod-type
     2489           and buf_parts.prod-code = p-prod-code
     2490       on error undo, return error return-value
     2491       :
     2492         define variable v-parts-fact-multiplier as decimal   no-undo .
     2493         assign
     2494           v-parts-fact-multiplier = 1
     2495         .
     2496         if buf_parts.qnty <> 0 then do:
     2497           assign
     2498             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     2499           .
     2500         end.
     2501         assign
     2502           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     2503           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     2504           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     2505           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     2506                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     2507           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     2508           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     2509           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     2510           p-total-parts-transport-base  = p-total-parts-transport-base
     2511                                         + buf_parts.fact-qnty
     2512                                           * (if   buf_parts.transport-base <> ?
     2513                                             then buf_parts.transport-base
     2514                                             else 0
     2515                                             )
     2516           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     2517                                         + buf_parts.fact-qnty
     2518                                           * (if   buf_parts.transport-rubl <> ?
     2519                                             then buf_parts.transport-rubl
     2520                                             else 0
     2521                                             )
     2522           p-total-parts-other-base      = p-total-parts-other-base
     2523                                         + buf_parts.fact-qnty
     2524                                           * (if   buf_parts.other-base <> ?
     2525                                             then buf_parts.other-base
     2526                                             else 0
     2527                                             )
     2528           p-total-parts-other-rubl      = p-total-parts-other-rubl
     2529                                         + buf_parts.fact-qnty
     2530                                           * (if   buf_parts.other-rubl <> ?
     2531                                             then buf_parts.other-rubl
     2532                                             else 0
     2533                                             )
     2534         .
     2535       end.
     2536     end.
     2537   end procedure.
     2538   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   define new global shared variable g#trdcalib as handle no-undo.
     2540   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2541   procedure holdprts-create-parts-supp :
     2542     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
     2543     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
     2544     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
     2545     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
     2546     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
     2547     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
     2548     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
     2549     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
     2550     define buffer buf_parent_trn-doc  for ub.trn-doc .
     2551     define buffer buf_child_trn-doc   for ub.trn-doc .
     2552     define buffer buf_parts           for ub.parts .
     2553     define buffer buf_parts-supp      for ub.parts-supp .
     2554     define buffer buf_orig_parts-supp for ub.parts-supp .
     2555     define buffer buf_income_trn-doc  for ub.trn-doc .
     2556     define buffer buf_income_doc-line for ub.doc-line .
     2557     define buffer buf_goods           for ub.goods .
     2558       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2559       define buffer   in-vatp-parts    for ub.parts   .
     2560       define buffer   in-vatp-doc      for ub.trn-doc .
     2561       define buffer   in-vatp-goods    for ub.goods   .
     2562       define buffer   in-vatp-sysconf  for ub.sysconf .
     2563       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2564       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2565       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2566       define variable varinvprb                  as   character              no-undo.
     2567       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2568       define variable cli-base-rate              as   decimal                no-undo.
     2569       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2570       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2571       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2572       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2573       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2574       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2575       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2576       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2577       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2578       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2579       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2580       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2581       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2582       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2583       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2584       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2585       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2586       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2587       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2588       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2589       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2590       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2591       define variable varinvatp-envd             as   character              no-undo.
     2592       define variable varinvatp-type             as   character              no-undo.
     2593     do
     2594     on error undo, return error return-value
     2595     :
     2596       find first buf_child_trn-doc no-lock
     2597         where buf_child_trn-doc.doc-code = p-in-code
     2598         no-error .
     2599       if not available buf_child_trn-doc
     2600       then do:
     2601         return substitute("Не найден исходный документ &1", p-in-code) .
     2602       end.
     2603       find first buf_parent_trn-doc no-lock
     2604         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
     2605         no-error .
     2606       if not available buf_parent_trn-doc
     2607       then do:
     2608         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
     2609       end.
     2610       find first buf_parts-supp exclusive-lock
     2611         where buf_parts-supp.in-code   = p-in-code
     2612           and buf_parts-supp.artic     = p-artic
     2613           and buf_parts-supp.prod-type = p-prod-type
     2614           and buf_parts-supp.prod-code = p-prod-code
     2615           and buf_parts-supp.part-code = p-part-code
     2616         no-error .
     2617       if available buf_parts-supp
     2618       then do:
     2619         message
     2620           vss-workfile vss-revision vss-description skip
     2621           vss-include-info18 skip
     2622           "Попытка повторного создания партии атрибутов" skip
     2623           "Документ прихода" p-in-code skip
     2624           "Артикул" p-artic p-prod-type p-prod-code skip
     2625           "Код партии" p-part-code skip
     2626           "Исходный код партии" p-orig-in-code skip
     2627           "Исходный код документа" p-orig-part-code skip
     2628           view-as alert-box error .
     2629         undo, return error .
     2630       end.
     2631       create buf_parts-supp .
     2632       assign
     2633         buf_parts-supp.in-code   = p-in-code
     2634         buf_parts-supp.artic     = p-artic
     2635         buf_parts-supp.prod-type = p-prod-type
     2636         buf_parts-supp.prod-code = p-prod-code
     2637         buf_parts-supp.part-code = p-part-code
     2638       .
     2639       assign
     2640         buf_parts-supp.orig-in-code   = p-orig-in-code
     2641         buf_parts-supp.orig-part-code = p-orig-part-code
     2642       .
     2643       find first buf_orig_parts-supp share-lock
     2644         where buf_orig_parts-supp.in-code   = p-orig-in-code
     2645           and buf_orig_parts-supp.artic     = p-artic
     2646           and buf_orig_parts-supp.prod-type = p-prod-type
     2647           and buf_orig_parts-supp.prod-code = p-prod-code
     2648           and buf_orig_parts-supp.part-code = p-orig-part-code
     2649         no-error .
     2650       if available buf_orig_parts-supp
     2651       then do:
     2652         buffer-copy buf_orig_parts-supp
     2653         except
     2654           buf_orig_parts-supp.in-code
     2655           buf_orig_parts-supp.artic
     2656           buf_orig_parts-supp.prod-type
     2657           buf_orig_parts-supp.prod-code
     2658           buf_orig_parts-supp.part-code
     2659           buf_orig_parts-supp.orig-in-code
     2660           buf_orig_parts-supp.orig-part-code
     2661         to buf_parts-supp.
     2662       end.
     2663       else do:
     2664         find first buf_parts share-lock
     2665           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
     2666             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
     2667             and buf_parts.artic     = p-artic
     2668             and buf_parts.prod-type = p-prod-type
     2669             and buf_parts.prod-code = p-prod-code
     2670             and buf_parts.in-code   = p-orig-in-code
     2671             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
     2672             and buf_parts.part-code = p-orig-part-code
     2673           no-error .
     2674         if not available buf_parts
     2675         then do:
     2676           message
     2677             vss-workfile vss-revision vss-description skip
     2678             vss-include-info18 skip
     2679             "Ошибка задания входных параметров" skip
     2680             "Не найдена исходная партия" skip
     2681             "Исходный документ" p-orig-in-code skip
     2682             "Артикул" p-artic p-prod-type p-prod-code skip
     2683             "Код партии" p-orig-part-code skip
     2684             view-as alert-box error .
     2685           undo, return error .
     2686         end.
     2687         define variable v-base-rate         as decimal   no-undo .
     2688         define variable v-base-scale        as integer   no-undo .
     2689         define variable v-exch-rate         as decimal   no-undo .
     2690         define variable v-exch-scale        as integer   no-undo .
     2691         define variable v-extended-doc-type as character no-undo .
     2692         define variable v-unit-cli          as character no-undo .
     2693         find first buf_income_trn-doc no-lock
     2694           where buf_income_trn-doc.doc-code = p-orig-in-code
     2695           no-error .
     2696         if available buf_income_trn-doc
     2697         then do:
     2698           find first buf_income_doc-line no-lock
     2699             where buf_income_doc-line.doc-code  = p-orig-in-code
     2700               and buf_income_doc-line.artic     = p-artic
     2701               and buf_income_doc-line.prod-type = p-prod-type
     2702               and buf_income_doc-line.prod-code = p-prod-code
     2703             no-error .
     2704           if not available buf_income_doc-line
     2705           then do:
     2706             message
     2707               vss-workfile vss-revision vss-description skip
     2708               vss-include-info18 skip
     2709               "Не найдена исходная строка документа прихода" skip
     2710               "Исходный документ" p-orig-in-code skip
     2711               "Артикул" p-artic p-prod-type p-prod-code skip
     2712               "Код партии" p-orig-part-code skip
     2713               view-as alert-box error .
     2714             undo, return error .
     2715           end.
     2716           assign
     2717             v-base-rate         = buf_income_trn-doc.base-rate
     2718             v-base-scale        = buf_income_trn-doc.base-scale
     2719             v-exch-rate         = buf_income_trn-doc.exch-rate
     2720             v-exch-scale        = buf_income_trn-doc.exch-scale
     2721             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
     2722             v-unit-cli          = buf_income_doc-line.unit-cli
     2723           .
     2724         end.
     2725         else do:
     2726           find first buf_goods no-lock
     2727             where buf_goods.artic     = buf_parts.artic
     2728               and buf_goods.prod-type = buf_parts.prod-type
     2729               and buf_goods.prod-code = buf_parts.prod-code
     2730             .
     2731           assign
     2732             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
     2733             v-base-scale        = 1
     2734             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
     2735             v-exch-scale        = 1
     2736             v-extended-doc-type = 'ie':U
     2737             v-unit-cli          = buf_goods.unit-cli
     2738           .
     2739         end.
     2740          if v-base-rate = ? then v-base-rate = 1.
     2741          if v-exch-rate = ? then v-exch-rate = 1.
     2742   assign
     2743     price-rubl-with-tax-loc = buf_parts.price-rubl
     2744     price-base-with-tax-loc = buf_parts.price-base
     2745   .
     2746   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2747   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2748     (output varinvprb
     2749     )  .
     2750     if buf_parts.out-code = 'free-zone':U     or
     2751        buf_parts.out-code = 'out-zone':U   or
     2752        buf_parts.doc-type = 'акт':U then do:
     2753       assign
     2754         in-vatp-have-vat-slt = yes.
     2755     end.
     2756     else do:
     2757       find first in-vatp_doc-attr no-lock
     2758         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     2759           and in-vatp_doc-attr.attr-code = 'envd':U
     2760         no-error .
     2761       if not available in-vatp_doc-attr then do:
     2762         assign
     2763           in-vatp-have-vat-slt = yes.
     2764       end.
     2765       else do:
     2766            in-vatp-have-vat-slt = no.
     2767       end.
     2768     end.
     2769     assign
     2770      price-cli-with-tax-loc = buf_parts.price-cli
     2771      cli-base-rate          = buf_parts.cli-base-rate.
     2772     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2773              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2774     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2775             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2776             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2777             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2778             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2779             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2780             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2781       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2782     assign
     2783       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2784     assign
     2785       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2786       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2787       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2788       transport-cli-loc  = 0
     2789       other-cli-loc      = 0
     2790     .
     2791   ASSIGN
     2792             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2793       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2794   .
     2795         assign
     2796           buf_parts-supp.PS                = buf_parts.PS
     2797           buf_parts-supp.SLT-type          = buf_parts.SLT-type
     2798           buf_parts-supp.VAT-type          = buf_parts.VAT-type
     2799           buf_parts-supp.base-rate         = v-base-rate
     2800           buf_parts-supp.base-scale        = v-base-scale
     2801           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
     2802           buf_parts-supp.cst-code          = buf_parts.cst-code
     2803           buf_parts-supp.doc-qnty          = buf_parts.qnty
     2804           buf_parts-supp.exch-code         = buf_parts.exch-code
     2805           buf_parts-supp.exch-rate         = v-exch-rate
     2806           buf_parts-supp.exch-scale        = v-exch-scale
     2807           buf_parts-supp.extended-doc-type = v-extended-doc-type
     2808           buf_parts-supp.fact-date         = buf_parts.fact-date
     2809           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
     2810           buf_parts-supp.last-date         = buf_parts.last-date
     2811           buf_parts-supp.pay-code          = buf_parts.pay-code
     2812           buf_parts-supp.price-cli         = buf_parts.price-cli
     2813           buf_parts-supp.purch-code        = buf_parts.purch-code
     2814           buf_parts-supp.supp-code         = buf_parts.supp-code
     2815           buf_parts-supp.supp-type         = buf_parts.supp-type
     2816           buf_parts-supp.unit-cli          = v-unit-cli
     2817         .
     2818         assign
     2819           buf_parts-supp.vat-pc         = vat-pc-loc
     2820           buf_parts-supp.slt-pc         = slt-pc-loc
     2821           buf_parts-supp.price-base     = price-base-with-tax-loc
     2822           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
     2823           buf_parts-supp.vat-base       = vat-base-loc
     2824           buf_parts-supp.vat-rubl       = vat-rubl-loc
     2825           buf_parts-supp.slt-base       = slt-base-loc
     2826           buf_parts-supp.slt-rubl       = slt-rubl-loc
     2827           buf_parts-supp.road-tax-base  = road-tax-base-loc
     2828           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
     2829           buf_parts-supp.transport-base = transport-base-loc
     2830           buf_parts-supp.transport-rubl = transport-rubl-loc
     2831           buf_parts-supp.other-base     = other-base-loc
     2832           buf_parts-supp.other-rubl     = other-rubl-loc
     2833         .
     2834       end.
     2835     end.
     2836   end procedure.
     2837   procedure holdprts-get-part-code :
     2838     define input  parameter p-doc-code       as character no-undo .
     2839     define output parameter p-hold-part-code as integer   no-undo .
     2840     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
     2841     define variable v-attr-value as character no-undo .
     2842     define variable v-attr-type  as character no-undo .
     2843     define buffer buf_trn-doc for ub.trn-doc .
     2844     do
     2845     on error undo, return error return-value
     2846     :
     2847       find first buf_trn-doc exclusive-lock
     2848         where buf_trn-doc.doc-code = p-doc-code
     2849         no-error .
     2850       if not available buf_trn-doc
     2851       then do:
     2852         message
     2853           vss-workfile vss-revision vss-description skip
     2854           vss-include-info18 skip
     2855           "Ошибка задания входных параметров" skip
     2856           "Не найден документ" p-doc-code skip
     2857           view-as alert-box error .
     2858         undo, return error .
     2859       end.
     2860   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     2861                           input 'hold-part-code':U ,
     2862                          output v-attr-value ,
     2863                          output v-attr-type )  .
     2864       assign
     2865         p-hold-part-code = integer(v-attr-value) + 1
     2866       .
     2867   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     2868                          input 'hold-part-code':U ,
     2869                          input string(p-hold-part-code) )  .
     2870     end.
     2871   end procedure.
     2872   procedure holdprts-validate-document :
     2873     define input  parameter p-doc-code as character no-undo .
     2874     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
     2875     define buffer buf_trn-doc    for ub.trn-doc .
     2876     define buffer parent_trn-doc for ub.trn-doc .
     2877     define buffer buf_parts      for ub.parts .
     2878     define buffer buf_parts-supp for ub.parts-supp .
     2879     do
     2880     on error undo, return error return-value
     2881     :
     2882       find first buf_trn-doc exclusive-lock
     2883         where buf_trn-doc.doc-code = p-doc-code
     2884         no-error .
     2885       if not available buf_trn-doc
     2886       then do:
     2887         message
     2888           vss-workfile vss-revision vss-description skip
     2889           vss-include-info18 skip
     2890           "Ошибка задания входных параметров" skip
     2891           "Не найден документ" p-doc-code skip
     2892           view-as alert-box error .
     2893         undo, return error .
     2894       end.
     2895       find first parent_trn-doc exclusive-lock
     2896         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
     2897         no-error .
     2898       if not available parent_trn-doc
     2899       then do:
     2900         message
     2901           vss-workfile vss-revision vss-description skip
     2902           vss-include-info18 skip
     2903           "Не найден родительский документ" skip
     2904           "Документ" buf_trn-doc.doc-code skip
     2905           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2906           view-as alert-box error .
     2907         undo, return error .
     2908       end.
     2909       if buf_trn-doc.ext-doc-type <> 'ie':U
     2910       then do:
     2911         return .
     2912       end.
     2913       for each buf_parts share-lock
     2914         where buf_parts.out-code = buf_trn-doc.doc-code
     2915       on error undo, return error
     2916       :
     2917         find first buf_parts-supp share-lock
     2918           where buf_parts-supp.in-code   = buf_parts.in-code
     2919             and buf_parts-supp.artic     = buf_parts.artic
     2920             and buf_parts-supp.prod-type = buf_parts.prod-type
     2921             and buf_parts-supp.prod-code = buf_parts.prod-code
     2922             and buf_parts-supp.part-code = buf_parts.part-code
     2923           no-error .
     2924         if not available buf_parts-supp
     2925         then do:
     2926           message
     2927             vss-workfile vss-revision vss-description skip
     2928             vss-include-info18 skip
     2929             "Не найдена информация о поставщике" skip
     2930             "Документ" buf_trn-doc.doc-code skip
     2931             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2932             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2933             "Номер партии" buf_parts.part-code skip
     2934             view-as alert-box error .
     2935           undo, return error .
     2936         end.
     2937       end.
     2938       for each buf_parts-supp share-lock
     2939         where buf_parts-supp.in-code = buf_trn-doc.doc-code
     2940       on error undo, return error
     2941       :
     2942         find first buf_parts share-lock
     2943           where buf_parts.out-code  = buf_parts-supp.in-code
     2944             and buf_parts.obj-type  = buf_trn-doc.obj-type
     2945             and buf_parts.obj-code  = buf_trn-doc.obj-code
     2946             and buf_parts.artic     = buf_parts-supp.artic
     2947             and buf_parts.prod-type = buf_parts-supp.prod-type
     2948             and buf_parts.prod-code = buf_parts-supp.prod-code
     2949             and buf_parts.part-code = buf_parts-supp.part-code
     2950           no-error .
     2951         if not available buf_parts
     2952         then do:
     2953           message
     2954             vss-workfile vss-revision vss-description skip
     2955             vss-include-info18 skip
     2956             "Задана информация о поставщике для неизвестной партии" skip
     2957             "Документ" buf_trn-doc.doc-code skip
     2958             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2959             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2960             "Номер партии" buf_parts.part-code skip
     2961             view-as alert-box error .
     2962           undo, return error .
     2963         end.
     2964       end.
     2965       for each buf_parts share-lock
     2966         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
     2967       on error undo, return error
     2968       :
     2969         if  buf_trn-doc.doc-type = 'при':U
     2970         and buf_parts.qnty = buf_parts.fact-qnty
     2971         then do:
     2972           next.
     2973         end.
     2974         find first buf_parts-supp share-lock
     2975           where buf_parts-supp.orig-in-code   = buf_parts.in-code
     2976             and buf_parts-supp.artic          = buf_parts.artic
     2977             and buf_parts-supp.prod-type      = buf_parts.prod-type
     2978             and buf_parts-supp.prod-code      = buf_parts.prod-code
     2979             and buf_parts-supp.orig-part-code = buf_parts.part-code
     2980           no-error .
     2981         if not available buf_parts-supp
     2982         then do:
     2983           message
     2984             vss-workfile vss-revision vss-description skip
     2985             vss-include-info18 skip
     2986             "Не найдена информация о поставщике для исходной накладной" skip
     2987             "Документ" buf_trn-doc.doc-code skip
     2988             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2989             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2990             "Номер партии" buf_parts.part-code skip
     2991             view-as alert-box error .
     2992           undo, return error .
     2993         end.
     2994       end.
     2995     end.
     2996   end procedure.
     2997   procedure holdprts-doc-type :
     2998     define input  parameter p-cat-code as integer   no-undo .
     2999     define input  parameter p-doc-code as character no-undo .
     3000     define output parameter p-is-sale  as logical   no-undo .
     3001     define output parameter p-is-purch as logical   no-undo .
     3002     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
     3003     define buffer buf_trn-doc for ub.trn-doc .
     3004     do
     3005     on error undo, return error return-value
     3006     :
     3007       find first buf_trn-doc no-lock
     3008         where buf_trn-doc.doc-code = p-doc-code
     3009         no-error .
     3010       if not available buf_trn-doc
     3011       then do:
     3012         message
     3013           vss-workfile vss-revision vss-description skip
     3014           vss-include-info18 skip
     3015           "Ошибка задания входных параметров" skip
     3016           "Не найден документ" skip
     3017           "Документ" p-doc-code skip
     3018           "Тип архива" p-cat-code skip
     3019           view-as alert-box error .
     3020         undo, return error .
     3021       end.
     3022       case p-cat-code :
     3023         when 1
     3024         then do:
     3025           define variable v-is-hold as logical   no-undo .
     3026   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3028     (input  buf_trn-doc.doc-code
     3029     ,output v-is-hold
     3030     )  .
     3031           if v-is-hold = true
     3032           then do:
     3033             assign
     3034               p-is-sale  = false
     3035               p-is-purch = false
     3036             .
     3037           end.
     3038           else do:
     3039             case buf_trn-doc.ext-doc-type :
     3040               when 'ie':U or
     3041               when 'ep':U
     3042               then do:
     3043                 assign
     3044                   p-is-sale  = false
     3045                   p-is-purch = true
     3046                 .
     3047               end.
     3048               when 'ee':U or
     3049               when 'es':U or
     3050               when 're':U or
     3051               when 'rs':U
     3052               then do:
     3053                 assign
     3054                   p-is-sale  = true
     3055                   p-is-purch = false
     3056                 .
     3057               end.
     3058               when 'we':U or
     3059               when 'vt':U or
     3060               when 'vp':U or
     3061               when 'ap':U or
     3062               when 'mp':U or
     3063               when 'pc':U or
     3064               when 'iv':U or
     3065               when 'ev':U or
     3066               when 'io':U or
     3067               when 'eo':U or
     3068               when 'rv':U or
     3069               when 'em':U or
     3070               when 'wm':U or
     3071               when 'im':U
     3072               then do:
     3073                 assign
     3074                   p-is-sale  = false
     3075                   p-is-purch = false
     3076                 .
     3077               end.
     3078               otherwise do:
     3079                 message
     3080                   vss-workfile vss-revision vss-description skip
     3081                   vss-include-info18 skip
     3082                   "Неизвестный тип документа" skip
     3083                   "Документ" buf_trn-doc.doc-code skip
     3084                   "Тип документа" buf_trn-doc.ext-doc-type skip
     3085                   "Тип архива" p-cat-code skip
     3086                   view-as alert-box error .
     3087                 undo, return error .
     3088               end.
     3089             end.
     3090           end.
     3091         end.
     3092         when 2
     3093         then do:
     3094           case buf_trn-doc.ext-doc-type :
     3095             when 'vt':U or
     3096             when 'vp':U
     3097             then do:
     3098               assign
     3099                 p-is-sale  = false
     3100                 p-is-purch = true
     3101               .
     3102             end.
     3103             otherwise do:
     3104               assign
     3105                 p-is-sale  = false
     3106                 p-is-purch = false
     3107               .
     3108             end.
     3109           end.
     3110         end.
     3111         when 3
     3112         then do:
     3113           case buf_trn-doc.ext-doc-type :
     3114             when 'we':U
     3115             then do:
     3116               assign
     3117                 p-is-sale  = false
     3118                 p-is-purch = true
     3119               .
     3120             end.
     3121             otherwise do:
     3122               assign
     3123                 p-is-sale  = false
     3124                 p-is-purch = false
     3125               .
     3126             end.
     3127           end.
     3128         end.
     3129         otherwise do:
     3130           message
     3131             vss-workfile vss-revision vss-description skip
     3132             "Неизвестный тип архивов" skip
     3133             "Документ" buf_trn-doc.doc-code skip
     3134             "Тип документа" buf_trn-doc.ext-doc-type skip
     3135             "Тип архива" p-cat-code skip
     3136             view-as alert-box error .
     3137           undo, return error return-value .
     3138         end.
     3139       end.
     3140     end.
     3141   end procedure.
     3142   procedure holdprts-purch-values :
     3143     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
     3144     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
     3145     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
     3146     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
     3147     define output parameter p-fact-qnty            as decimal   no-undo .
     3148     define output parameter p-purch-sum-base       as decimal   no-undo .
     3149     define output parameter p-purch-sum-rubl       as decimal   no-undo .
     3150     define output parameter p-purch-VAT-base       as decimal   no-undo .
     3151     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
     3152     define output parameter p-purch-SLT-base       as decimal   no-undo .
     3153     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
     3154     define output parameter p-purch-road-tax-base  as decimal   no-undo .
     3155     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
     3156     define output parameter p-purch-excise-base    as decimal   no-undo .
     3157     define output parameter p-purch-excise-rubl    as decimal   no-undo .
     3158     define output parameter p-purch-transport-base as decimal   no-undo .
     3159     define output parameter p-purch-transport-rubl as decimal   no-undo .
     3160     define output parameter p-purch-other-base     as decimal   no-undo .
     3161     define output parameter p-purch-other-rubl     as decimal   no-undo .
     3162     define output parameter p-purch-discnt-base    as decimal   no-undo .
     3163     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
     3164     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
     3165     define variable v-price-base     as decimal   no-undo .
     3166     define variable v-price-rubl     as decimal   no-undo .
     3167     define variable v-VAT-base       as decimal   no-undo .
     3168     define variable v-VAT-rubl       as decimal   no-undo .
     3169     define variable v-SLT-base       as decimal   no-undo .
     3170     define variable v-SLT-rubl       as decimal   no-undo .
     3171     define variable v-road-tax-base  as decimal   no-undo .
     3172     define variable v-road-tax-rubl  as decimal   no-undo .
     3173     define variable v-transport-base as decimal   no-undo .
     3174     define variable v-transport-rubl as decimal   no-undo .
     3175     define variable v-other-base     as decimal   no-undo .
     3176     define variable v-other-rubl     as decimal   no-undo .
     3177     define buffer buf_trn-doc        for ub.trn-doc .
     3178     define buffer buf_parts          for ub.parts .
     3179     define buffer buf_parts-supp     for ub.parts-supp .
     3180     define buffer buf_doc-line       for ub.doc-line .
     3181     define buffer buf_income_trn-doc for ub.trn-doc .
     3182     do
     3183     on error undo, return error return-value
     3184     :
     3185       find first buf_trn-doc no-lock
     3186         where buf_trn-doc.doc-code = p-doc-code
     3187         no-error .
     3188       if not available buf_trn-doc
     3189       then do:
     3190         message
     3191           vss-workfile vss-revision vss-description skip
     3192           vss-include-info18 skip
     3193           "Ошибка задания входных параметров" skip
     3194           "Не найден документ" skip
     3195           "Документ" p-doc-code skip
     3196           view-as alert-box error .
     3197         undo, return error .
     3198       end.
     3199       find first buf_doc-line no-lock
     3200         where buf_doc-line.doc-code  = p-doc-code
     3201           and buf_doc-line.artic     = p-artic
     3202           and buf_doc-line.prod-type = p-prod-type
     3203           and buf_doc-line.prod-code = p-prod-code
     3204         no-error .
     3205       if not available buf_doc-line
     3206       then do:
     3207         message
     3208           vss-workfile vss-revision vss-description skip
     3209           vss-include-info18 skip
     3210           "Ошибка задания входных параметров" skip
     3211           "Не найдена строка документа" skip
     3212           "Документ" p-doc-code skip
     3213           "Артикул" p-artic p-prod-type p-prod-code skip
     3214           view-as alert-box error .
     3215         undo, return error .
     3216       end.
     3217       assign
     3218         p-fact-qnty            = 0
     3219         p-purch-sum-base       = 0
     3220         p-purch-sum-rubl       = 0
     3221         p-purch-VAT-base       = 0
     3222         p-purch-VAT-rubl       = 0
     3223         p-purch-SLT-base       = 0
     3224         p-purch-SLT-rubl       = 0
     3225         p-purch-road-tax-base  = 0
     3226         p-purch-road-tax-rubl  = 0
     3227         p-purch-excise-base    = 0
     3228         p-purch-excise-rubl    = 0
     3229         p-purch-transport-base = 0
     3230         p-purch-transport-rubl = 0
     3231         p-purch-other-base     = 0
     3232         p-purch-other-rubl     = 0
     3233         p-purch-discnt-base    = 0
     3234         p-purch-discnt-rubl    = 0
     3235       .
     3236       for each buf_parts no-lock
     3237         where buf_parts.out-code  = buf_doc-line.doc-code
     3238           and buf_parts.obj-type  = buf_doc-line.obj-type
     3239           and buf_parts.obj-code  = buf_doc-line.obj-code
     3240           and buf_parts.artic     = buf_doc-line.artic
     3241           and buf_parts.prod-type = buf_doc-line.prod-type
     3242           and buf_parts.prod-code = buf_doc-line.prod-code
     3243       on error undo, return error
     3244       :
     3245         define variable v-parts-qnty as decimal   no-undo .
     3246         assign
     3247           v-parts-qnty = buf_parts.fact-qnty
     3248                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
     3249                            then -1
     3250                            else 1
     3251                          )
     3252         .
     3253         find first buf_parts-supp no-lock
     3254           where buf_parts-supp.in-code   = buf_parts.in-code
     3255             and buf_parts-supp.artic     = buf_parts.artic
     3256             and buf_parts-supp.prod-type = buf_parts.prod-type
     3257             and buf_parts-supp.prod-code = buf_parts.prod-code
     3258             and buf_parts-supp.part-code = buf_parts.part-code
     3259           no-error .
     3260         if available buf_parts-supp
     3261         then do:
     3262           assign
     3263             v-price-base     = buf_parts-supp.price-base
     3264             v-price-rubl     = buf_parts-supp.price-rubl
     3265             v-VAT-base       = buf_parts-supp.VAT-base
     3266             v-VAT-rubl       = buf_parts-supp.VAT-rubl
     3267             v-SLT-base       = buf_parts-supp.SLT-base
     3268             v-SLT-rubl       = buf_parts-supp.SLT-rubl
     3269             v-road-tax-base  = buf_parts-supp.road-tax-base
     3270             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
     3271             v-transport-base = buf_parts-supp.transport-base
     3272             v-transport-rubl = buf_parts-supp.transport-rubl
     3273             v-other-base     = buf_parts-supp.other-base
     3274             v-other-rubl     = buf_parts-supp.other-rubl
     3275           .
     3276         end.
     3277         else do:
     3278       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3279       define buffer   in-vatp-parts    for ub.parts   .
     3280       define buffer   in-vatp-doc      for ub.trn-doc .
     3281       define buffer   in-vatp-goods    for ub.goods   .
     3282       define buffer   in-vatp-sysconf  for ub.sysconf .
     3283       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3284       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3285       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3286       define variable varinvprb                  as   character              no-undo.
     3287       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3288       define variable cli-base-rate              as   decimal                no-undo.
     3289       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3290       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3291       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3292       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3293       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3294       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3295       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3296       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3297       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3298       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3299       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3300       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3301       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3302       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3303       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3304       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3305       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3306       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3307       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3308       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3309       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3310       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3311       define variable varinvatp-envd             as   character              no-undo.
     3312       define variable varinvatp-type             as   character              no-undo.
     3313   assign
     3314     price-rubl-with-tax-loc = buf_parts.price-rubl
     3315     price-base-with-tax-loc = buf_parts.price-base
     3316   .
     3317   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3318   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3319     (output varinvprb
     3320     )  .
     3321     if buf_parts.out-code = 'free-zone':U     or
     3322        buf_parts.out-code = 'out-zone':U   or
     3323        buf_parts.doc-type = 'акт':U then do:
     3324       assign
     3325         in-vatp-have-vat-slt = yes.
     3326     end.
     3327     else do:
     3328       find first in-vatp_doc-attr no-lock
     3329         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3330           and in-vatp_doc-attr.attr-code = 'envd':U
     3331         no-error .
     3332       if not available in-vatp_doc-attr then do:
     3333         assign
     3334           in-vatp-have-vat-slt = yes.
     3335       end.
     3336       else do:
     3337            in-vatp-have-vat-slt = no.
     3338       end.
     3339     end.
     3340     assign
     3341      price-cli-with-tax-loc = buf_parts.price-cli
     3342      cli-base-rate          = buf_parts.cli-base-rate.
     3343     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3344              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3345     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3346             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3347             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3348             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3349             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3350             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     3351             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3352       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3353     assign
     3354       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     3355     assign
     3356       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3357       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3358       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3359       transport-cli-loc  = 0
     3360       other-cli-loc      = 0
     3361     .
     3362   ASSIGN
     3363             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3364       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3365   .
     3366           assign
     3367             v-price-base     = price-base-with-tax-loc
     3368             v-price-rubl     = price-rubl-with-tax-loc
     3369             v-VAT-base       = vat-base-loc
     3370             v-VAT-rubl       = vat-rubl-loc
     3371             v-SLT-base       = slt-base-loc
     3372             v-SLT-rubl       = slt-rubl-loc
     3373             v-road-tax-base  = road-tax-base-loc
     3374             v-road-tax-rubl  = road-tax-rubl-loc
     3375             v-transport-base = transport-base-loc
     3376             v-transport-rubl = transport-rubl-loc
     3377             v-other-base     = other-base-loc
     3378             v-other-rubl     = other-rubl-loc
     3379           .
     3380         end.
     3381         assign
     3382           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
     3383           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
     3384           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
     3385           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
     3386           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
     3387           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
     3388           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
     3389           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
     3390           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
     3391           p-purch-excise-base    = p-purch-excise-base    + 0
     3392           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
     3393           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
     3394           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
     3395           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
     3396           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
     3397           p-purch-discnt-base    = p-purch-discnt-base    + 0
     3398           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
     3399         .
     3400       end.
     3401     end.
     3402   end procedure.
     3403   procedure holdprts-sale-values :
     3404     define input  parameter p-doc-code            like ub.doc-line.doc-code  no-undo .
     3405     define input  parameter p-artic               like ub.doc-line.artic     no-undo .
     3406     define input  parameter p-prod-type           like ub.doc-line.prod-type no-undo .
     3407     define input  parameter p-prod-code           like ub.doc-line.prod-code no-undo .
     3408     define output parameter p-fact-qnty           as decimal   no-undo .
     3409     define output parameter p-sale-sum-base       as decimal   no-undo .
     3410     define output parameter p-sale-sum-rubl       as decimal   no-undo .
     3411     define output parameter p-sale-VAT-base       as decimal   no-undo .
     3412     define output parameter p-sale-VAT-rubl       as decimal   no-undo .
     3413     define output parameter p-sale-SLT-base       as decimal   no-undo .
     3414     define output parameter p-sale-SLT-rubl       as decimal   no-undo .
     3415     define output parameter p-sale-road-tax-base  as decimal   no-undo .
     3416     define output parameter p-sale-road-tax-rubl  as decimal   no-undo .
     3417     define output parameter p-sale-excise-base    as decimal   no-undo .
     3418     define output parameter p-sale-excise-rubl    as decimal   no-undo .
     3419     define output parameter p-sale-transport-base as decimal   no-undo .
     3420     define output parameter p-sale-transport-rubl as decimal   no-undo .
     3421     define output parameter p-sale-other-base     as decimal   no-undo .
     3422     define output parameter p-sale-other-rubl     as decimal   no-undo .
     3423     define output parameter p-sale-discnt-base    as decimal   no-undo .
     3424     define output parameter p-sale-discnt-rubl    as decimal   no-undo .
     3425     define variable vss-description as character no-undo init "holdprts-sale-values-01: параметры продажи товара".
     3426     define variable v-gds-dtl-fact-qnty as decimal   no-undo .
     3427     define buffer buf_doc-line for ub.doc-line .
     3428     define buffer buf_gds-dtl  for ub.gds-dtl.
     3429     define buffer buf_goods    for ub.goods.
     3430     define buffer buf_trn-doc  for ub.trn-doc.
     3431       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     3432       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     3433       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     3434       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     3435       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     3436       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     3437       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     3438       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     3439       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     3440       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     3441       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     3442       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     3443       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     3444       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     3445       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
     3446       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
     3447       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
     3448       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
     3449       define buffer out-vatp_parts       for ub.parts.
     3450       define buffer out-vatp_sysconf     for ub.sysconf.
     3451       define buffer out-vatp_doc-line    for ub.doc-line.
     3452       define buffer out-vatp_goods       for ub.goods.
     3453       define buffer out-vatp_trn-doc     for ub.trn-doc.
     3454       define buffer out-vatp_doc-attr    for ub.doc-attr.
     3455       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
     3456       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
     3457       define variable varfrm-cnsv-type         as   character                           no-undo.
     3458       define variable varfrm-cnsv              as   character                           no-undo.
     3459       define variable varroot-node             as   integer                             no-undo.
     3460       define variable varempty-scale           as   logical                             no-undo.
     3461       define variable varis-cons-parts-have    as   logical                             no-undo.
     3462       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3463       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3464       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3465       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     3466       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3467       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3468       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3469       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3470       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     3471       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3472       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3473       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3474       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3475       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     3476       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3477       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3478       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3479       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3480       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     3481       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3482       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     3483       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     3484       define variable varis-one-gds-dtl        as   logical                             no-undo.
     3485       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     3486       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     3487       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     3488       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     3489       define variable varoutvprb               as   character                           no-undo.
     3490       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     3491       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     3492       define buffer   in-vatp-partso    for ub.parts   .
     3493       define buffer   in-vatp-doco      for ub.trn-doc .
     3494       define buffer   in-vatp-goodso    for ub.goods   .
     3495       define buffer   in-vatp-sysconfo  for ub.sysconf .
     3496       define buffer   in-vatp_doc-attro for ub.doc-attr.
     3497       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     3498       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     3499       define variable varinvprbo                  as   character              no-undo.
     3500       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     3501       define variable cli-base-rateo              as   decimal                no-undo.
     3502       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     3503       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     3504       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     3505       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     3506       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     3507       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     3508       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     3509       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3510       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     3511       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     3512       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3513       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     3514       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     3515       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     3516       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     3517       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     3518       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     3519       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     3520       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     3521       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     3522       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     3523       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     3524       define variable varinvatp-envdo             as   character              no-undo.
     3525       define variable varinvatp-typeo             as   character              no-undo.
     3526     do
     3527     on error undo, return error return-value
     3528     :
     3529       find first buf_trn-doc no-lock
     3530         where buf_trn-doc.doc-code = p-doc-code
     3531       no-error .
     3532       if not available buf_trn-doc
     3533       then do:
     3534         message
     3535           vss-workfile vss-revision vss-description skip
     3536           vss-include-info18 skip
     3537           "Ошибка задания входных параметров" skip
     3538           "Не найден документ" skip
     3539           "Документ" p-doc-code skip
     3540           "Артикул" p-artic p-prod-type p-prod-code skip
     3541           view-as alert-box error .
     3542         undo, return error .
     3543       end.
     3544       find first buf_doc-line no-lock
     3545         where buf_doc-line.doc-code  = p-doc-code
     3546           and buf_doc-line.artic     = p-artic
     3547           and buf_doc-line.prod-type = p-prod-type
     3548           and buf_doc-line.prod-code = p-prod-code
     3549         no-error .
     3550       if not available buf_doc-line
     3551       then do:
     3552         message
     3553           vss-workfile vss-revision vss-description skip
     3554           vss-include-info18 skip
     3555           "Ошибка задания входных параметров" skip
     3556           "Не найдена строка документа" skip
     3557           "Документ" p-doc-code skip
     3558           "Артикул" p-artic p-prod-type p-prod-code skip
     3559           view-as alert-box error .
     3560         undo, return error .
     3561       end.
     3562       for each buf_gds-dtl no-lock
     3563         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     3564           and buf_gds-dtl.artic     = buf_doc-line.artic
     3565           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     3566           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     3567       on error undo, return error
     3568       :
     3569         if buf_trn-doc.doc-type <> 'инв':U
     3570         then do:
     3571           if buf_trn-doc.doc-type = 'при':U
     3572           or buf_trn-doc.doc-type = 'возврат':U
     3573           then do:
     3574             assign
     3575               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     3576             .
     3577           end.
     3578           else do:
     3579             assign
     3580               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     3581             .
     3582           end.
     3583         end.
     3584         else do:
     3585           assign
     3586             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     3587           .
     3588         end.
     3589         if v-gds-dtl-fact-qnty <> 0
     3590         then do:
     3591   if buf_trn-doc.ext-doc-type = 'ot':U or
     3592      buf_trn-doc.ext-doc-type = ?                 then do:
     3593     assign
     3594      out-vatp-have-vat-slt = yes.
     3595   end.
     3596   else do:
     3597     find first out-vatp_doc-attr no-lock
     3598       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     3599         and out-vatp_doc-attr.attr-code = 'envd':U
     3600         no-error .
     3601     if not available out-vatp_doc-attr then do:
     3602       assign
     3603         out-vatp-have-vat-slt = yes.
     3604     end.
     3605     else do:
     3606        out-vatp-have-vat-slt = no.
     3607     end.
     3608   end.
     3609   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     3610                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     3611                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     3612   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3614     (input  buf_doc-line.artic
     3615     ,input  buf_doc-line.prod-type
     3616     ,input  buf_doc-line.prod-code
     3617     ,output varroot-node
     3618     ) no-error .
     3619   if error-status :error then do:
     3620     message
     3621       vss-workfile vss-revision vss-description skip
     3622       "Ошибка при определении корневого признака товара" skip
     3623       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3624       error-status :get-message(1) skip
     3625       return-value skip
     3626       view-as alert-box error .
     3627     undo, return error .
     3628   end.
     3629   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3630     (input  varroot-node
     3631     ,input  'empty-scale=request'
     3632     ,output varempty-scale
     3633     ) no-error .
     3634   if error-status :error then do:
     3635     message
     3636       vss-workfile vss-revision vss-description skip
     3637       "Ошибка при определении атрибута признака" skip
     3638       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3639       "Признак" varroot-node skip
     3640       "Запрашивался атрибут" "empty-scale=request" skip
     3641       error-status :get-message(1) skip
     3642       return-value skip
     3643       view-as alert-box error .
     3644     undo, return error .
     3645   end.
     3646   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3648     (output varoutvprb
     3649     )  .
     3650   if varoutvprb = "base":u then do:
     3651     assign
     3652           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3653       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     3654     .
     3655   end.
     3656   else do:
     3657     assign
     3658           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3659       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3660     .
     3661   end.
     3662   if varoutvprb = "rubl":u then do:
     3663     assign
     3664           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3665       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     3666   end.
     3667   else do:
     3668     assign
     3669           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     3670       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     3671   end.
     3672   assign
     3673     varis-cons-parts-have =  no.
     3674   assign
     3675     varfact-qnty       = 0
     3676     varcons-qnty       = 0
     3677     varprice-base-cons = 0
     3678     varprice-rubl-cons = 0.
     3679   find first out-vatp_doc-line where
     3680              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     3681          and out-vatp_doc-line.artic      = buf_doc-line.artic
     3682          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     3683          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     3684   if available out-vatp_doc-line           and
     3685     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     3686     assign
     3687       varfact-qnty = out-vatp_doc-line.fact-qnty.
     3688   end.
     3689   else do:
     3690     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     3691                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     3692                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     3693                                  and out-vatp_parts.artic      = buf_doc-line.artic
     3694                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     3695                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     3696       if out-vatp_parts.purch-code = 2 then do:
     3697   assign
     3698     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     3699     price-base-with-tax-loco = out-vatp_parts.price-base
     3700   .
     3701   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3703     (output varinvprbo
     3704     )  .
     3705     if out-vatp_parts.out-code = 'free-zone':U     or
     3706        out-vatp_parts.out-code = 'out-zone':U   or
     3707        out-vatp_parts.doc-type = 'акт':U then do:
     3708       assign
     3709         in-vatp-have-vat-slto = yes.
     3710     end.
     3711     else do:
     3712       find first in-vatp_doc-attro no-lock
     3713         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     3714           and in-vatp_doc-attro.attr-code = 'envd':U
     3715         no-error .
     3716       if not available in-vatp_doc-attro then do:
     3717         assign
     3718           in-vatp-have-vat-slto = yes.
     3719       end.
     3720       else do:
     3721            in-vatp-have-vat-slto = no.
     3722       end.
     3723     end.
     3724     assign
     3725      price-cli-with-tax-loco = out-vatp_parts.price-cli
     3726      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     3727     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     3728              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     3729     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     3730             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     3731             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     3732             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     3733             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     3734             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     3735             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3736       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3737     assign
     3738       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     3739     assign
     3740       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     3741       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     3742       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     3743       transport-cli-loco  = 0
     3744       other-cli-loco      = 0
     3745     .
     3746   ASSIGN
     3747             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     3748       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     3749   .
     3750         assign
     3751           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     3752           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     3753         assign
     3754           varis-cons-parts-have = yes
     3755           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     3756       end.
     3757       assign
     3758         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     3759     end.
     3760   end.
     3761   assign
     3762     varprice-base-cons = varprice-base-cons / varcons-qnty
     3763     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     3764   if varprice-base-cons = ? then do:
     3765     assign
     3766       varprice-base-cons = 0.
     3767   end.
     3768   if varprice-rubl-cons = ? then do:
     3769     assign
     3770       varprice-rubl-cons = 0.
     3771   end.
     3772   assign
     3773       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     3774     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3775     discnt-base-sale            = buf_gds-dtl.discnt-base
     3776     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     3777       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     3778     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3779     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     3780     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     3781     .
     3782   if buf_trn-doc.doc-type = 'инв':U then do:
     3783     assign
     3784       varfact-qnty = buf_gds-dtl.doc-qnty.
     3785   end.
     3786   else do:
     3787     assign
     3788       varfact-qnty = buf_gds-dtl.fact-qnty.
     3789   end.
     3790   if varis-cons-parts-have = no then do:
     3791     assign
     3792           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3793           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     3794   end.
     3795   else do:
     3796     if buf_trn-doc.doc-type = 'инв':U then do:
     3797       assign
     3798               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3799               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3800        .
     3801     end.
     3802     else do:
     3803       assign
     3804               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3805               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3806        .
     3807     end.
     3808   end.
     3809   assign
     3810   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     3811   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     3812           assign
     3813             p-fact-qnty           = p-fact-qnty          + v-gds-dtl-fact-qnty
     3814             p-sale-sum-base       = p-sale-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     3815             p-sale-sum-rubl       = p-sale-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     3816             p-sale-vat-base       = p-sale-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     3817             p-sale-vat-rubl       = p-sale-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     3818             p-sale-slt-base       = p-sale-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     3819             p-sale-slt-rubl       = p-sale-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     3820             p-sale-road-tax-base  = p-sale-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     3821             p-sale-road-tax-rubl  = p-sale-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     3822             p-sale-excise-base    = p-sale-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     3823             p-sale-excise-rubl    = p-sale-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     3824             p-sale-discnt-base    = p-sale-discnt-base   + discnt-base-sale          * v-gds-dtl-fact-qnty
     3825             p-sale-discnt-rubl    = p-sale-discnt-rubl   + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     3826           .
     3827         end.
     3828       end.
     3829       assign
     3830         p-sale-transport-base = 0
     3831         p-sale-transport-rubl = 0
     3832         p-sale-other-base     = 0
     3833         p-sale-other-rubl     = 0
     3834       .
     3835     end.
     3836   end procedure.
     3837   def var vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3838   procedure gen-key-rec :
     3839     define input  parameter p-tbl-name    as character no-undo.
     3840     define input  parameter p-bh_tbl-name as handle    no-undo.
     3841     define output parameter p-key-rec     as character no-undo.
     3842     do
     3843     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3844     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3845     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3846     :
     3847       define variable fh               as handle    no-undo .
     3848       define variable v-ok             as logical   no-undo .
     3849       define variable v-inform         as character no-undo .
     3850       define variable v-ind            as integer   no-undo .
     3851       define variable v-idx-field-qnty as integer   no-undo .
     3852       if p-tbl-name = ?
     3853         or p-tbl-name = "":U
     3854       then do:
     3855         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info25 ).
     3856       end.
     3857       if not p-bh_tbl-name:available then do:
     3858         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info25, p-tbl-name ).
     3859       end.
     3860       assign
     3861         p-key-rec = p-tbl-name
     3862         v-inform  = p-bh_tbl-name:index-information(1)
     3863         v-ind     = 2
     3864       .
     3865       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3866       on error undo, return error
     3867       :
     3868         assign
     3869           v-inform = p-bh_tbl-name:index-information( v-ind )
     3870           v-ind    = v-ind + 1
     3871         .
     3872       end.
     3873       if v-inform = ?
     3874         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3875         or entry( 3, v-inform, ",":U ) <> "1":U
     3876       then do:
     3877         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info25, p-tbl-name ).
     3878       end.
     3879       else do:
     3880         assign
     3881           v-idx-field-qnty = num-entries( v-inform ) - 4
     3882         .
     3883         if v-idx-field-qnty < 2 then do:
     3884           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info25, v-inform, p-tbl-name ).
     3885         end.
     3886         do v-ind = 1 to v-idx-field-qnty by 2
     3887         on error undo, return error
     3888         :
     3889           assign
     3890             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3891             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3892           .
     3893         end.
     3894       end.
     3895       if p-key-rec = ? then do:
     3896         assign
     3897           p-key-rec = "":U
     3898         .
     3899         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info25, p-tbl-name ).
     3900       end.
     3901     end.
     3902     return.
     3903   end procedure.
     3904   procedure gen-where-keyr-tab :
     3905     define input  parameter i-tableSerach as character no-undo.
     3906     define input  parameter i-tablekey   as character  no-undo.
     3907     define input  parameter p-key-rec    as character  no-undo.
     3908     define input  parameter p-key-handle as handle     no-undo .
     3909     define input  parameter p-db-name    as character  no-undo .
     3910     define input  parameter p-tt-handle  as handle     no-undo .
     3911     define output parameter o-Where      as character  no-undo.
     3912     do
     3913     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3914     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3915     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3916     :
     3917       define variable v-full-tbl-name  as character no-undo .
     3918       define variable bh_tbl-name      as handle    no-undo .
     3919       define variable fh_key           as handle    no-undo .
     3920       define variable fh_search        as handle    no-undo .
     3921       define variable v-field-num      as integer   no-undo .
     3922       define variable v-count-fld      as integer   no-undo .
     3923       define variable v-inform         as character no-undo .
     3924       define variable v-ind            as integer   no-undo .
     3925       define variable v-idx-field-qnty as integer   no-undo .
     3926       define variable v-field-name     as character no-undo .
     3927       define variable v-field-val      as character no-undo .
     3928       define variable v-word-link      as character no-undo .
     3929       define variable vTable           as character no-undo.
     3930       define variable bh_tbl-key       as handle    no-undo .
     3931       assign
     3932         p-key-rec = trim( p-key-rec )
     3933       .
     3934       if p-key-handle <> ? then do:
     3935         if not valid-handle(p-key-handle)
     3936            or p-key-handle:type <> "buffer"
     3937         then do:
     3938           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info25 ).
     3939         end.
     3940         if num-entries( p-key-rec, chr(3) ) > 1
     3941           or p-key-rec = ?
     3942           or p-key-rec = "":U
     3943         then do:
     3944           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info25, p-key-rec ).
     3945         end.
     3946       end.
     3947       else do:
     3948         if p-key-rec = ?
     3949           or p-key-rec = "":U
     3950         then do:
     3951           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info25 ).
     3952         end.
     3953       end.
     3954       assign
     3955         vTable = entry( 1 , p-key-rec, chr(3) )
     3956       .
     3957       if p-tt-handle <> ?
     3958         and ( not valid-handle(p-tt-handle)
     3959               or p-tt-handle:type <> "buffer"
     3960             )
     3961       then do:
     3962         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info25, vTable, chr(10) ).
     3963       end.
     3964       if p-tt-handle = ? then do:
     3965         assign
     3966           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3967         .
     3968         create buffer bh_tbl-name for table v-full-tbl-name .
     3969       end.
     3970       else do:
     3971         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3972       end.
     3973       assign
     3974         v-inform = bh_tbl-name:index-information(1)
     3975         v-ind    = 2
     3976       .
     3977       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3978       on error undo, return error
     3979       :
     3980         assign
     3981           v-inform = bh_tbl-name:index-information( v-ind )
     3982           v-ind    = v-ind + 1
     3983         .
     3984       end.
     3985       if v-inform = ?
     3986         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3987         or entry( 3, v-inform, ",":U ) <> "1":U
     3988       then do:
     3989         delete object bh_tbl-name no-error.
     3990         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info25, vTable ).
     3991       end.
     3992       assign
     3993         v-idx-field-qnty = num-entries( v-inform ) - 4
     3994       .
     3995       if v-idx-field-qnty < 2 then do:
     3996         delete object bh_tbl-name no-error.
     3997         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info25, v-inform, vTable ).
     3998       end.
     3999       assign
     4000         o-where     = "where":U
     4001         v-word-link = "":U
     4002         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     4003         v-count-fld = 0
     4004       .
     4005       if i-tablekey ne "" and i-tablekey ne ?
     4006       then do:
     4007         assign
     4008           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     4009         .
     4010         create buffer bh_tbl-key for table v-full-tbl-name .
     4011       end.
     4012       if i-tableSerach ne "" and i-tableSerach ne ?
     4013       then do:
     4014         delete object bh_tbl-name no-error.
     4015         assign
     4016           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     4017         .
     4018         create buffer bh_tbl-name for table v-full-tbl-name .
     4019       end.
     4020       block_where:
     4021       do v-ind = 1 to v-idx-field-qnty by 2
     4022       on error undo, return error
     4023       :
     4024         assign
     4025           v-count-fld = v-count-fld + 1
     4026         .
     4027         if p-key-handle = ?
     4028           and v-count-fld > v-field-num
     4029         then do:
     4030           leave block_where.
     4031         end.
     4032         define variable VfieldKeyTable as handle no-undo.
     4033         assign
     4034           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     4035           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     4036         .
     4037         if     bh_tbl-key ne ?
     4038         then do:
     4039            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     4040            if VfieldKeyTable eq ?
     4041            then next block_where.
     4042         end.
     4043         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     4044         then
     4045            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     4046         else
     4047            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     4048         if p-key-handle = ? then do:
     4049           assign
     4050             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     4051           .
     4052         end.
     4053         else do:
     4054           assign
     4055             fh_key = p-key-handle:buffer-field( v-field-name )
     4056           .
     4057           if fh_key = ?
     4058             or not valid-handle( fh_key )
     4059           then do:
     4060             delete object bh_tbl-name.
     4061             if     bh_tbl-key ne ?
     4062             then
     4063                delete object bh_tbl-key.
     4064             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info25, p-key-handle:name, v-field-name ).
     4065           end.
     4066           assign
     4067             v-field-val = fh_key:buffer-value
     4068           .
     4069         end.
     4070         if fh_search:data-type ="character":U then do:
     4071           assign
     4072             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     4073             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     4074             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     4075             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     4076             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     4077             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     4078             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     4079             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     4080             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     4081             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     4082             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     4083             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     4084             v-field-val = substitute( '"&1"', v-field-val )
     4085           .
     4086         end.
     4087         assign
     4088           o-where = substitute( "&1 &2", o-where, v-field-val )
     4089         .
     4090         if v-word-link = "":U then do:
     4091           assign
     4092             v-word-link = "and":U
     4093           .
     4094         end.
     4095       end.
     4096       delete object bh_tbl-name.
     4097       if     bh_tbl-key ne ?
     4098       then
     4099          delete object bh_tbl-key.
     4100       if p-key-handle = ?
     4101         and v-count-fld <> v-field-num
     4102       then do:
     4103         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info25, vTable ).
     4104       end.
     4105     end.
     4106   end procedure.
     4107   procedure gen-hn-keyr-tab :
     4108     define input  parameter i-tableSerach as character no-undo.
     4109     define input  parameter i-tablekey   as character no-undo.
     4110     define input  parameter p-key-rec    as character no-undo.
     4111     define input  parameter p-key-handle as handle    no-undo .
     4112     define input  parameter p-db-name    as character no-undo .
     4113     define input  parameter p-tt-handle  as handle    no-undo .
     4114     define input  parameter p-stts-lock  as integer   no-undo .
     4115     define output parameter o-hn         as handle    no-undo.
     4116     define variable v-full-tbl-name as character no-undo.
     4117     define variable v-where         as character no-undo.
     4118     define variable bh_tbl-name     as handle    no-undo.
     4119     define variable vTable          as character no-undo.
     4120     do
     4121     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4122     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4123     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     4124         run gen-where-keyr-tab(i-tableSerach,
     4125                                i-tablekey,
     4126                                p-key-rec,
     4127                                p-key-handle,
     4128                                p-db-name,
     4129                                p-tt-handle,
     4130                                output v-where).
     4131         if i-tableSerach ne "" and i-tableSerach ne ?
     4132         then do:
     4133            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     4134            create buffer bh_tbl-name for table v-full-tbl-name .
     4135         end.
     4136         else do:
     4137            if p-tt-handle = ? then do:
     4138               assign
     4139                  vTable = entry( 1 , p-key-rec, chr(3) )
     4140               .
     4141               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     4142               create buffer bh_tbl-name for table v-full-tbl-name .
     4143            end.
     4144            else do:
     4145               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4146            end.
     4147         end.
     4148         if p-tt-handle = ? then do:
     4149            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     4150         end.
     4151         else do:
     4152            bh_tbl-name:find-first( v-where ) no-error .
     4153         end.
     4154         o-hn = bh_tbl-name.
     4155      end.
     4156   end procedure.
     4157   procedure gen-hn-keyr :
     4158     define input  parameter p-key-rec    as character no-undo.
     4159     define input  parameter p-key-handle as handle    no-undo .
     4160     define input  parameter p-db-name    as character no-undo .
     4161     define input  parameter p-tt-handle  as handle    no-undo .
     4162     define input  parameter p-stts-lock  as integer   no-undo .
     4163     define output parameter o-hn         as handle    no-undo.
     4164     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     4165   end.
     4166   procedure gen-row-keyr :
     4167     define input  parameter p-key-rec    as character no-undo.
     4168     define input  parameter p-key-handle as handle    no-undo .
     4169     define input  parameter p-db-name    as character no-undo .
     4170     define input  parameter p-tt-handle  as handle    no-undo .
     4171     define input  parameter p-stts-lock  as integer   no-undo .
     4172     define output parameter p-tbl-row    as rowid     no-undo.
     4173     define output parameter p-tbl-name   as character no-undo.
     4174     define variable vHn as handle no-undo.
     4175       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     4176       p-tbl-row = if vHn:available then vHn:rowid else ?.
     4177       p-tbl-name =  vHn:table.
     4178       delete object vHn no-error.
     4179     if p-tbl-row = ? then do:
     4180       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info25, p-tbl-name, p-key-rec ).
     4181     end.
     4182     else do:
     4183       return.
     4184     end.
     4185   end procedure.
     4186   procedure gen-key-fv :
     4187     define input  parameter p-key-rec    as character no-undo .
     4188     define output parameter p-field-list as character no-undo .
     4189     define output parameter p-value-list as character no-undo.
     4190     do
     4191     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4192     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4193     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4194     :
     4195       define variable v-full-tbl-name  as character no-undo .
     4196       define variable bh_tbl-name      as handle    no-undo .
     4197       define variable v-tbl-name       as character no-undo .
     4198       define variable v-field-num      as integer   no-undo .
     4199       define variable v-count-fld      as integer   no-undo .
     4200       define variable v-inform         as character no-undo .
     4201       define variable v-ind            as integer   no-undo .
     4202       define variable v-idx-field-qnty as integer   no-undo .
     4203       define variable v-delim-key      as character no-undo .
     4204       if p-key-rec = ?
     4205         or p-key-rec = "":U
     4206       then do:
     4207         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info25 ).
     4208       end.
     4209       assign
     4210         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     4211         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4212       .
     4213       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4214       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info25 ).
     4215       assign
     4216         v-inform = bh_tbl-name:index-information(1)
     4217         v-ind    = 2
     4218       .
     4219       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4220       on error undo, return error
     4221       :
     4222         assign
     4223           v-inform = bh_tbl-name:index-information( v-ind )
     4224           v-ind    = v-ind + 1
     4225         .
     4226       end.
     4227       if v-inform = ?
     4228         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4229         or entry( 3, v-inform, ",":U ) <> "1":U
     4230       then do:
     4231         delete object bh_tbl-name no-error.
     4232         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info25, v-tbl-name ).
     4233       end.
     4234       assign
     4235         v-idx-field-qnty = num-entries( v-inform ) - 4
     4236       .
     4237       if v-idx-field-qnty < 2 then do:
     4238         delete object bh_tbl-name no-error.
     4239         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info25, v-inform, v-tbl-name ).
     4240       end.
     4241       assign
     4242         p-field-list = "":U
     4243         p-value-list = "":U
     4244         v-delim-key  = "":U
     4245         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     4246         v-count-fld  = 0
     4247       .
     4248       block_where:
     4249       do v-ind = 1 to v-idx-field-qnty by 2
     4250       on error undo, return error
     4251       :
     4252         assign
     4253           v-count-fld = v-count-fld + 1
     4254         .
     4255         if v-count-fld > v-field-num then do:
     4256           leave block_where.
     4257         end.
     4258         assign
     4259           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     4260           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     4261         .
     4262         if v-ind = 1 then do:
     4263           assign
     4264             v-delim-key = chr(3)
     4265           .
     4266         end.
     4267       end.
     4268       delete object bh_tbl-name.
     4269       if v-count-fld <> v-field-num then do:
     4270         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info25, v-tbl-name ).
     4271       end.
     4272     end.
     4273   end procedure.
     4274   procedure gen-key-field :
     4275     define input  parameter p-table      as character no-undo .
     4276     define output parameter p-field-list as character no-undo .
     4277     do
     4278     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4279     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4280     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4281     :
     4282       define variable v-full-tbl-name  as character no-undo .
     4283       define variable bh_tbl-name      as handle    no-undo .
     4284       define variable v-tbl-name       as character no-undo .
     4285       define variable v-field-num      as integer   no-undo .
     4286       define variable v-count-fld      as integer   no-undo .
     4287       define variable v-inform         as character no-undo .
     4288       define variable v-ind            as integer   no-undo .
     4289       define variable v-idx-field-qnty as integer   no-undo .
     4290       define variable v-delim-key      as character no-undo .
     4291       if p-table = ?
     4292         or p-table = "":U
     4293       then do:
     4294         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info25 ).
     4295       end.
     4296       assign
     4297         v-tbl-name      = p-table
     4298         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4299       .
     4300       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4301       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info25 ).
     4302       assign
     4303         v-inform = bh_tbl-name:index-information(1)
     4304         v-ind    = 2
     4305       .
     4306       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4307       on error undo, return error
     4308       :
     4309         assign
     4310           v-inform = bh_tbl-name:index-information( v-ind )
     4311           v-ind    = v-ind + 1
     4312         .
     4313       end.
     4314       if v-inform = ?
     4315         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4316         or entry( 3, v-inform, ",":U ) <> "1":U
     4317       then do:
     4318         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info25, v-tbl-name ).
     4319       end.
     4320       assign
     4321         v-idx-field-qnty = num-entries( v-inform ) - 4
     4322       .
     4323       if v-idx-field-qnty < 2 then do:
     4324         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info25, v-inform, v-tbl-name ).
     4325       end.
     4326       assign
     4327         p-field-list = "":U
     4328         v-delim-key  = "":U
     4329         v-count-fld  = 0
     4330       .
     4331       block_where:
     4332       do v-ind = 1 to v-idx-field-qnty by 2
     4333       on error undo, return error
     4334       :
     4335         assign
     4336           v-count-fld = v-count-fld + 1
     4337         .
     4338         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     4339         if v-ind = 1 then do:
     4340           assign
     4341             v-delim-key = chr(3)
     4342           .
     4343         end.
     4344       end.
     4345       delete object bh_tbl-name.
     4346     end.
     4347   end procedure.
     4348   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4349   define variable vss-include-info27 as character format "X(65)" no-undo
     4350   initial "@(#)$Workfile$ $Revision$".
     4351   procedure xmlchar-test :
     4352   define input parameter p-in-string          as character        no-undo.
     4353   define output parameter p-out-string-enc    as character        no-undo.
     4354   define output parameter p-out-string-dec    as character        no-undo.
     4355   do
     4356   on error undo, return error
     4357   :
     4358          run xmlchar-encode in this-procedure
     4359       (
     4360             input p-in-string
     4361           , output p-out-string-enc
     4362       ).
     4363          run xmlchar-decode in this-procedure
     4364       (
     4365             input p-out-string-enc
     4366           , output p-out-string-dec
     4367       ).
     4368   end.
     4369   end .
     4370   procedure xmlchar-encode :
     4371   define input parameter p-in-string      as character        no-undo.
     4372   define output parameter p-out-string    as character        no-undo.
     4373       define variable v-position      as integer      no-undo.
     4374       define variable v-current-char  as character    no-undo.
     4375   do
     4376   on error undo, return error
     4377   :
     4378       assign
     4379           p-out-string = "":U
     4380       .
     4381       case p-in-string
     4382       :
     4383           when ?
     4384           then do:
     4385               assign
     4386                   p-out-string = "?":U
     4387               .
     4388           end.
     4389           when "?":U
     4390           then do:
     4391               assign
     4392                   p-out-string = "&#63;":U
     4393               .
     4394           end.
     4395           otherwise do:
     4396               do v-position = 1 to length( p-in-string )
     4397               :
     4398                   assign
     4399                       v-current-char = substring( p-in-string, v-position, 1 )
     4400                   .
     4401                   case v-current-char
     4402                   :
     4403                       when "&":U
     4404                       then do:
     4405                           assign
     4406                               p-out-string = p-out-string + "&amp;":U
     4407                           .
     4408                       end.
     4409                       when ">":U
     4410                       then do:
     4411                           assign
     4412                               p-out-string = p-out-string + "&gt;":U
     4413                           .
     4414                       end.
     4415                       when "<":U
     4416                       then do:
     4417                           assign
     4418                               p-out-string = p-out-string + "&lt;":U
     4419                           .
     4420                       end.
     4421                       when "'":U
     4422                       then do:
     4423                           assign
     4424                               p-out-string = p-out-string + "&apos;":U
     4425                           .
     4426                       end.
     4427                       when '"':U
     4428                       then do:
     4429                           assign
     4430                               p-out-string = p-out-string + "&quot;":U
     4431                           .
     4432                       end.
     4433                       when chr(1)
     4434                       then do:
     4435                           assign
     4436                               p-out-string = p-out-string + "":U
     4437                           .
     4438                       end.
     4439                       when chr(2)
     4440                       then do:
     4441                           assign
     4442                               p-out-string = p-out-string + "":U
     4443                           .
     4444                       end.
     4445                       when chr(3)
     4446                       then do:
     4447                           assign
     4448                               p-out-string = p-out-string + "":U
     4449                           .
     4450                       end.
     4451                       when chr(4)
     4452                       then do:
     4453                           assign
     4454                               p-out-string = p-out-string + "":U
     4455                           .
     4456                       end.
     4457                       when chr(5)
     4458                       then do:
     4459                           assign
     4460                               p-out-string = p-out-string + "":U
     4461                           .
     4462                       end.
     4463                       when chr(6)
     4464                       then do:
     4465                           assign
     4466                               p-out-string = p-out-string + "":U
     4467                           .
     4468                       end.
     4469                       when chr(7)
     4470                       then do:
     4471                           assign
     4472                               p-out-string = p-out-string + "":U
     4473                           .
     4474                       end.
     4475                       when chr(8)
     4476                       then do:
     4477                           assign
     4478                               p-out-string = p-out-string + "":U
     4479                           .
     4480                       end.
     4481                       when chr(9)
     4482                       then do:
     4483                           assign
     4484                               p-out-string = p-out-string + "":U
     4485                           .
     4486                       end.
     4487                       when chr(29)
     4488                       then do:
     4489                           assign
     4490                               p-out-string = p-out-string + "":U
     4491                           .
     4492                       end.
     4493                       when chr(10)
     4494                       then do:
     4495                           assign
     4496                               p-out-string = p-out-string + "&#10;":U
     4497                           .
     4498                       end.
     4499                       when chr(13)
     4500                       then do:
     4501                           assign
     4502                               p-out-string = p-out-string + "&#13;":U
     4503                           .
     4504                       end.
     4505                       otherwise do:
     4506                           assign
     4507                               p-out-string = p-out-string + v-current-char
     4508                           .
     4509                       end.
     4510                   end case.
     4511               end.
     4512           end.
     4513       end case.
     4514   end.
     4515   end .
     4516   procedure xmlchar-encode-1c :
     4517   define input parameter p-in-string      as character        no-undo.
     4518   define output parameter p-out-string    as character        no-undo.
     4519       define variable v-position      as integer      no-undo.
     4520       define variable v-current-char  as character    no-undo.
     4521   do
     4522   on error undo, return error
     4523   :
     4524       assign
     4525           p-out-string = "":U
     4526       .
     4527       case p-in-string
     4528       :
     4529           when ?
     4530           then do:
     4531               assign
     4532                   p-out-string = "?":U
     4533               .
     4534           end.
     4535           otherwise do:
     4536               do v-position = 1 to length( p-in-string )
     4537               :
     4538                   assign
     4539                       v-current-char = substring( p-in-string, v-position, 1 )
     4540                   .
     4541                   case v-current-char
     4542                   :
     4543                       when chr(1)
     4544                       then do:
     4545                           assign
     4546                               p-out-string = p-out-string + " ":U
     4547                           .
     4548                       end.
     4549                       when chr(2)
     4550                       then do:
     4551                           assign
     4552                               p-out-string = p-out-string + " ":U
     4553                           .
     4554                       end.
     4555                       when chr(3)
     4556                       then do:
     4557                           assign
     4558                               p-out-string = p-out-string + " ":U
     4559                           .
     4560                       end.
     4561                       when chr(4)
     4562                       then do:
     4563                           assign
     4564                               p-out-string = p-out-string + " ":U
     4565                           .
     4566                       end.
     4567                       when chr(5)
     4568                       then do:
     4569                           assign
     4570                               p-out-string = p-out-string + " ":U
     4571                           .
     4572                       end.
     4573                       when chr(6)
     4574                       then do:
     4575                           assign
     4576                               p-out-string = p-out-string + " ":U
     4577                           .
     4578                       end.
     4579                       when chr(7)
     4580                       then do:
     4581                           assign
     4582                               p-out-string = p-out-string + " ":U
     4583                           .
     4584                       end.
     4585                       when chr(8)
     4586                       then do:
     4587                           assign
     4588                               p-out-string = p-out-string + " ":U
     4589                           .
     4590                       end.
     4591                       when chr(9)
     4592                       then do:
     4593                           assign
     4594                               p-out-string = p-out-string + " ":U
     4595                           .
     4596                       end.
     4597                       when chr(29)
     4598                       then do:
     4599                           assign
     4600                               p-out-string = p-out-string + " ":U
     4601                           .
     4602                       end.
     4603                       when chr(10)
     4604                       then do:
     4605                           assign
     4606                               p-out-string = p-out-string + " ":U
     4607                           .
     4608                       end.
     4609                       when chr(13)
     4610                       then do:
     4611                           assign
     4612                               p-out-string = p-out-string + " ":U
     4613                           .
     4614                       end.
     4615                       otherwise do:
     4616                           assign
     4617                               p-out-string = p-out-string + v-current-char
     4618                           .
     4619                       end.
     4620                   end case.
     4621               end.
     4622           end.
     4623       end case.
     4624   end.
     4625   end .
     4626   procedure xmlchar-decode :
     4627   define input parameter p-in-string      as character        no-undo.
     4628   define output parameter p-out-string    as character        no-undo.
     4629       define variable v-position      as integer      no-undo.
     4630       define variable v-last-position as integer      no-undo.
     4631       define variable v-temp-integer  as integer      no-undo.
     4632       define variable v-current-char  as character    no-undo.
     4633       define variable v-next-char     as character    no-undo.
     4634       define variable v-success       as logical      no-undo.
     4635   do
     4636   on error undo, return error
     4637   :
     4638       assign
     4639           p-out-string = "":U
     4640           v-position   = 0
     4641       .
     4642       replace-cycle:
     4643       do while yes
     4644       on error undo, return error
     4645       :
     4646           assign
     4647               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4648           .
     4649           if v-last-position <= v-position
     4650           then do:
     4651               if v-position = 0
     4652               then do:
     4653                   assign
     4654                       p-out-string = p-in-string
     4655                   .
     4656               end.
     4657               else do:
     4658                   assign
     4659                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4660                   .
     4661               end.
     4662               leave replace-cycle.
     4663           end.
     4664           else do:
     4665               assign
     4666                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4667                   v-position      = v-last-position
     4668                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4669               .
     4670               if v-current-char = "#":U
     4671               then do:
     4672                   assign
     4673                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4674                   .
     4675                   if v-last-position > 0
     4676                   then do:
     4677                       run xmlchar-read-integer in this-procedure
     4678                        (
     4679                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4680                           , output v-temp-integer
     4681                           , output v-success
     4682                       ).
     4683                       if v-success = yes
     4684                       and v-temp-integer >= 1
     4685                       and v-temp-integer <= 255
     4686                       then do:
     4687                           assign
     4688                               p-out-string = p-out-string + chr( v-temp-integer )
     4689                               v-position   = v-last-position + 1
     4690                           .
     4691                       end.
     4692                       else do:
     4693                           assign
     4694                               p-out-string = p-out-string + "&":U
     4695                               v-position   = v-position   + 1
     4696                           .
     4697                       end.
     4698                   end.
     4699                   else do:
     4700                       assign
     4701                           p-out-string = p-out-string + "&":U
     4702                           v-position   = v-position   + 1
     4703                       .
     4704                   end.
     4705               end.
     4706               else do:
     4707                   case substring( p-in-string, v-position + 1, 3 )
     4708                   :
     4709                       when "lt;":U
     4710                       then do:
     4711                           assign
     4712                               p-out-string = p-out-string + "<":U
     4713                               v-position   = v-position   + 3
     4714                           .
     4715                       end.
     4716                       when "gt;":U
     4717                       then do:
     4718                           assign
     4719                               p-out-string = p-out-string + ">":U
     4720                               v-position   = v-position   + 3
     4721                           .
     4722                       end.
     4723                       otherwise do:
     4724                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4725                           then do:
     4726                               assign
     4727                                   p-out-string = p-out-string + "&":U
     4728                                   v-position   = v-position   + 4
     4729                               .
     4730                           end.
     4731                           else do:
     4732                               case substring( p-in-string, v-position + 1, 5 )
     4733                               :
     4734                                   when "quot;":U
     4735                                   then do:
     4736                                       assign
     4737                                           p-out-string = p-out-string + '"':U
     4738                                           v-position   = v-position   + 5
     4739                                       .
     4740                                   end.
     4741                                   when "apos;":U
     4742                                   then do:
     4743                                       assign
     4744                                           p-out-string = p-out-string + "'":U
     4745                                           v-position   = v-position   + 5
     4746                                       .
     4747                                   end.
     4748                                   otherwise do:
     4749                                       assign
     4750                                           p-out-string = p-out-string + "&":U
     4751                                       .
     4752                                   end.
     4753                               end case.
     4754                           end.
     4755                       end.
     4756                   end case.
     4757               end.
     4758           end.
     4759       end.
     4760   end.
     4761   end .
     4762   procedure xmlchar-read-integer :
     4763   define input parameter p-input-string      as character        no-undo.
     4764   define output parameter p-output-integer   as integer          no-undo.
     4765   define output parameter p-success       as logical          no-undo.
     4766   do
     4767   on error undo, return error
     4768   :
     4769       assign
     4770           p-output-integer = integer( p-input-string )
     4771       no-error.
     4772       if error-status :error
     4773       then do:
     4774           assign
     4775               p-success           = no
     4776               p-output-integer    = 0
     4777           .
     4778       end.
     4779       else do:
     4780           assign
     4781               p-success           = yes
     4782           .
     4783       end.
     4784   end.
     4785   end.
     4786   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     4787   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     4788   define new global shared variable g#attr-lib  as handle no-undo .
     4789   define variable v-attr-lib-variable as handle no-undo .
     4790   define variable mMRCCode  as logical    no-undo.
     4791   define variable mTypeMark as character  no-undo.
     4792   function IS-NeedMark returns logical
     4793   ( input ib-code as integer  ,
     4794     input ib-str as character ):
     4795      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4796      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4797                                    and buf_prod-bc-attr.b-str  eq ib-str
     4798                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4799        no-lock no-error.
     4800      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4801   end.
     4802   function repTegforDm return char
     4803   (iDM as char ):
     4804       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4805       define variable vteg as character no-undo.
     4806       define variable oDM as character no-undo.
     4807       define variable vi as integer no-undo.
     4808       oDM = iDm.
     4809       do vi = 1 to num-entries(vTeglist):
     4810          vTeg = entry(vi,vTeglist).
     4811          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4812       end.
     4813       return oDM.
     4814   end.
     4815   function repSpecSimbforDm return char
     4816   (iDM as char ):
     4817       define variable oDM as character no-undo.
     4818     run
     4819       xmlchar-decode(iDM, output oDM).
     4820     return repTegforDm (oDM).
     4821   end.
     4822   function CheckGtin return logical
     4823   (iGtin as char):
     4824      define variable bar_code as character no-undo.
     4825      define variable vGtin as logical no-undo init "yes".
     4826      if length(iGtin) eq 14
     4827      then do:
     4828         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4829         run str/chk-sum.p
     4830          (input-output bar_code ) no-error .
     4831         if iGtin ne  bar_code
     4832         then
     4833            vGtin = no.
     4834      end.
     4835      else
     4836         vGtin = no.
     4837      return vgtin.
     4838   end.
     4839   function repSpecSimbforXlm return char
     4840   (iDM as char ):
     4841       iDM = replace(iDM,chr(29),"").
     4842       return iDM.
     4843   end.
     4844   function getGtinByDM return char
     4845   (IDM as char):
     4846      define variable VTXT as char no-undo.
     4847      define variable vGtin as char no-undo.
     4848      vTXt = IdM.
     4849      vGtin = IDM.
     4850      if    length(vtxt) > 14
     4851      then do:
     4852         if   vtxt begins "(01)"
     4853                or vtxt begins "(02)"
     4854         then
     4855            vGtin = substring(vtxt,5,14).
     4856         else if   (vtxt begins "01"
     4857                or vtxt begins "02" )
     4858                and (   (    substring(iDm,17,2) eq "21"
     4859                         and length(vtxt) >= 21)
     4860                     or substring(iDm,17,2) eq "37"
     4861                     or substring(iDm,17,4) eq "(37)" )
     4862         then do:
     4863            vGtin = substring(vtxt,3,14).
     4864            if not checkGtin(vGtin)
     4865            then
     4866               vGtin = substring(vtxt,1,14).
     4867         end.
     4868         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4869             or length(vtxt) eq 14 + 7 + 4
     4870             or length(vtxt) eq 14 + 7
     4871         then
     4872            vGtin = substring(vtxt,1,14).
     4873      end.
     4874      if not checkGtin(vGtin)
     4875      then
     4876         vGtin = "".
     4877      return vgtin.
     4878   end.
     4879   function getGdsCodeByGtin return int
     4880   (iGtin as char):
     4881      define buffer prod-bc  for ub.prod-bc.
     4882      define buffer bar-code for ub.bar-code.
     4883      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4884      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4885      return if avail bar-code then bar-code.gds-code else ?.
     4886   end.
     4887   function getQntyCodeByGtin return decimal
     4888   (iGtin as char):
     4889      define buffer prod-bc  for ub.prod-bc.
     4890      define buffer bar-code for ub.bar-code.
     4891      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4892      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4893      return if avail bar-code then bar-code.cli-base-rate else ?.
     4894   end.
     4895   function getGdsCodeByDM return int
     4896   (iDm as char):
     4897      define variable vGtin as char no-undo.
     4898      define buffer prod-bc for ub.prod-bc.
     4899      vGtin  = getGtinByDM (IDM ).
     4900      return getGdsCodeByGtin (vGtin).
     4901   end.
     4902   function ChekTypeMarkByGds return logical
     4903   (iGds-code as integer ):
     4904      define buffer goods-attr for ub.goods-attr.
     4905      find first goods-attr where goods-attr.gds-code   = iGds-code
     4906                              and goods-attr.attr-code  = 'mark-type':U
     4907      no-lock no-error.
     4908      if available goods-attr
     4909      then do:
     4910         mTypeMark = goods-attr.attr-value.
     4911         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4912           .
     4913      end.
     4914      else
     4915         return no.
     4916   end.
     4917   function ChekTypeMarkByDm return logical
     4918   (iDM as char ):
     4919      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4920   end.
     4921   function ChekTypeMarkByGtin return logical
     4922   (iGtin as char ):
     4923      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4924   end.
     4925   function GetNextElement return character
     4926     (input iAllTeg        as logical
     4927     ,output oteg          as character
     4928     ,output otegval       as character
     4929     ,input-output pstr    as character
     4930      ):
     4931        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4932        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4933        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4934        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4935        define variable vTeg as character no-undo.
     4936        define variable vLength as integer no-undo.
     4937        define variable vi as integer no-undo.
     4938        define variable vj as integer no-undo.
     4939        define buffer code for ub.code.
     4940        find first code where Code.parent eq "MarkType"
     4941                          and Code.CodeValue   eq mTypeMark
     4942                          no-lock no-error.
     4943        if     available code
     4944           and Code.misc1 ne ""
     4945           and Code.misc1 ne ?
     4946        then do:
     4947           integer (Code.misc1) no-error.
     4948           if not error-status:error
     4949           then
     4950             entry (4,vlistleng) = Code.misc1.
     4951        end.
     4952        if iAllTeg
     4953        then
     4954           assign
     4955              vlistElem     = vlistElem    + vlistElemDop
     4956              vlistleng     = vlistleng    + vlistlengDop
     4957           .
     4958        else if mMRCCode
     4959        then
     4960           assign
     4961              vlistElem     = vlistElem    + ",(8005),8005"
     4962              vlistleng     = vlistleng    + ",000006,0006"
     4963           .
     4964       block-elem:
     4965       do vi = 1 to num-entries(vlistElem):
     4966          vTeg = entry(vi,vlistElem).
     4967          if pstr begins vTeg
     4968          then do:
     4969             if    vTeg eq "21"
     4970             then
     4971                vLength = index(pstr,chr(29)) - 2 no-error.
     4972             if vLength  <= 0
     4973             then
     4974                vLength = int(entry(vi,vlistleng)).
     4975             otegval = substring (pstr,length(vteg) + 1, vLength).
     4976             oteg = replace(replace(vteg,")",""),"(","").
     4977             vTeg = vteg + otegval.
     4978             otegval = replace(otegval,chr(29),"").
     4979             oteg = replace(replace(oteg,")",""),"(","").
     4980             pstr = substring (pstr,length(vTeg)+ 1).
     4981             vTeg = replace(vTeg,chr(29),"").
     4982             leave block-elem.
     4983          end.
     4984          else
     4985             vTeg = "".
     4986       end.
     4987       return vteg.
     4988   end.
     4989   function GetCodeIdent return character
     4990   (iDm as char):
     4991      define variable Velement   as character no-undo init "first".
     4992      define variable oCodeIdent as character no-undo.
     4993      define variable vteg as character no-undo.
     4994      define variable vtegval as character no-undo.
     4995      define variable vGtin as character no-undo.
     4996      define buffer marking for ub.marking.
     4997      for first marking no-lock where
     4998                marking.mark eq iDm
     4999            and marking.unit-ext = "LEVEL2"
     5000      :
     5001        return iDm.
     5002      end.
     5003      vGtin  = getGtinByDM (iDm ).
     5004      ChekTypeMarkByDm(idm).
     5005      if iDm begins 'tech_':U
     5006      then
     5007         oCodeIdent = iDm.
     5008      else if length(iDm) < 21
     5009      then do:
     5010         find first marking where marking.mark eq idm
     5011         no-lock no-error.
     5012         oCodeIdent = if available marking then marking.mark else  ?.
     5013      end.
     5014      else if     length(iDm) eq 29
     5015         and not iDm begins "01"
     5016         and not iDm begins "02"
     5017      then
     5018         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5019      else  if     length(iDm) >= 24
     5020               and (  iDm begins "01"
     5021                   or iDm begins "02")
     5022               and  substring(iDm,17,2) ne "21"
     5023      then do:
     5024         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5025                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5026         then
     5027            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5028         else
     5029            oCodeIdent = iDM.
     5030      end.
     5031      else  if     (   length(iDm) eq 25
     5032                    or length(iDm) eq 21)
     5033               and (not iDm begins "01"
     5034               and  not iDm begins "02")
     5035      then
     5036         oCodeIdent = substring(iDm,1,21).
     5037      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5038      then
     5039         oCodeIdent = substring(iDm,1,21).
     5040      else do while Velement ne "" and idm ne "":
     5041         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5042         oCodeIdent = oCodeIdent + Velement.
     5043      end.
     5044      return oCodeIdent.
     5045   end.
     5046   function GetTegCod return character
     5047   (icodeIdent as char, iTeg as char):
     5048      define variable Velement   as character no-undo init "first".
     5049      define variable oTeg as character no-undo init ?.
     5050      define variable vteg as character no-undo.
     5051      define variable vtegval as character no-undo.
     5052      if     ((length(icodeIdent) eq 21
     5053         and not icodeIdent begins "01"
     5054         and not icodeIdent begins "02")
     5055         or
     5056             ( length(icodeIdent) eq 25
     5057               and not icodeIdent begins "01"
     5058               and not icodeIdent begins "02"))
     5059      then do:
     5060         if iTeg eq "01" or iTeg eq "02"
     5061         then
     5062            oTeg = substring(icodeIdent,1,21).
     5063         else  if  iTeg eq "21"
     5064         then
     5065            oTeg = substring(icodeIdent,15,7).
     5066      end.
     5067      else do:
     5068         ChekTypeMarkByDm(icodeIdent).
     5069         block-teg:
     5070            do while Velement ne "" and icodeIdent ne "":
     5071            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5072            if    Velement begins iTeg
     5073               or Velement begins "(" + iTeg + ")"
     5074            then do:
     5075               oTeg = vtegval.
     5076               leave block-teg.
     5077            end.
     5078         end.
     5079      end.
     5080      return oTeg.
     5081   end.
     5082   function isOAD return logical
     5083   (icodeIdent as character):
     5084      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5085   end.
     5086   function isMark return logical
     5087   (icodeIdent as character):
     5088      define buffer buf_marking for ub.marking.
     5089      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5090             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5091   end.
     5092   function addBracketForCode return character
     5093   (icodeIdent as char):
     5094      define variable Velement   as character no-undo init "first".
     5095      define variable oTeg as character no-undo.
     5096      define variable vteg as character no-undo.
     5097      define variable vtegval as character no-undo.
     5098      define buffer marking for ub.marking.
     5099      find first marking no-lock where
     5100                 marking.mark begins icodeIdent no-error.
     5101      if    not ChekTypeMarkByDm(icodeIdent)
     5102         or length(icodeIdent) le 24
     5103         or (avail marking and marking.unit-ext = "LEVEL2")
     5104      then
     5105         oTeg = icodeIdent.
     5106      else do:
     5107         if (  icodeIdent begins "01"
     5108            or icodeIdent begins "02"
     5109            ) and CheckGtin(substring (icodeIdent,3,14))
     5110            and substring (icodeIdent,17,2) eq "21"
     5111         then do:
     5112            mMRCCode = yes.
     5113            ChekTypeMarkByDm(icodeIdent).
     5114            block-teg:
     5115            do while Velement ne "" and icodeIdent ne "":
     5116               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5117               if vteg ne ""
     5118               then
     5119                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5120            end.
     5121            mMRCCode = no.
     5122         end.
     5123         else do:
     5124            oTeg = icodeIdent.
     5125         end.
     5126      end.
     5127      return oTeg.
     5128   end.
     5129   function getlevelByCodId return int
     5130   (iCode as char):
     5131      define variable vLength as int no-undo.
     5132      define variable vLevel  as int no-undo.
     5133      if not ChekTypeMarkByDM (icode) then return ?.
     5134      vLength = length(iCode).
     5135      if    vLength eq 18
     5136         or vLength eq 20
     5137      then
     5138         Vlevel = 4.
     5139      else if vLength eq 21
     5140      then
     5141         Vlevel = 1.
     5142      else if vLength eq 25
     5143      then do:
     5144         if  iCode begins "01"
     5145         then
     5146            Vlevel = 3.
     5147         else
     5148            Vlevel = 1.
     5149      end.
     5150      else if     vLength >= 26
     5151              and vLength <= 46
     5152      then do:
     5153         if    substring(iCode,17,2) eq "11"
     5154            or substring(iCode,17,2) eq "13"
     5155            or (    substring(iCode,17,2) eq "21"
     5156                and vLength >= 33
     5157                and substring(iCode,26,4) ne "8005")
     5158         then
     5159            Vlevel = 4.
     5160         else if    vLength eq 31
     5161                 or vLength eq 38
     5162                 or vLength eq 39
     5163                 or vLength eq 45
     5164         then
     5165            Vlevel = 1.
     5166         else if    vLength eq 35
     5167                 or vLength eq 43
     5168         then
     5169            Vlevel = 3.
     5170         else
     5171            Vlevel = ?.
     5172      end.
     5173      else
     5174         Vlevel = ?.
     5175      return Vlevel.
     5176   end.
     5177   function getLevelMotpBycodid return character
     5178   (iDm as char):
     5179      define variable vLevel as integer no-undo.
     5180      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5181      vLevel = getlevelByCodId(iDm).
     5182      if    vLevel eq ?
     5183         or vLevel < 1
     5184         or vLevel > 6
     5185      then
     5186         return ?.
     5187      else
     5188         return entry(vlevel,vList).
     5189   end.
     5190   function getLevelUTDByLevelMotp return character
     5191   (iUnit as char):
     5192      define variable vLevel as integer no-undo.
     5193      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5194      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5195      vLevel = lookup(iUnit,vListMOTP).
     5196      if    vLevel eq ?
     5197         or vLevel < 1
     5198         or vLevel > 4
     5199      then
     5200         return ?.
     5201      else
     5202         return entry(vlevel,vListutd).
     5203   end.
     5204   function getLevelMotpByDM return character
     5205   (iDm as char):
     5206      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5207   end.
     5208   function getLevelUTDByCodId return character
     5209   (iDm as char):
     5210      define variable vLevel as integer no-undo.
     5211      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5212      vLevel = getlevelByCodId(iDm).
     5213      if    vLevel eq ?
     5214         or vLevel < 1
     5215         or vLevel > 4
     5216      then
     5217         return ?.
     5218      else
     5219         return entry(vlevel,vList).
     5220   end.
     5221   function getLevelUTDByDM return character
     5222   (iDm as char):
     5223      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5224   end.
     5225   define variable mNotMarkQnty as logical no-undo.
     5226   function getQntyUTDByCodId return decimal
     5227   (iDM as char):
     5228      define variable vLevel as integer no-undo.
     5229      define variable vList as character no-undo init "1,5,10,500".
     5230      define variable vGtin as character no-undo.
     5231      define variable vqnty as decimal no-undo init ?.
     5232      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5233      if vqnty eq ?
     5234      then do:
     5235         if not mNotMarkQnty
     5236         then do:
     5237            define buffer marking for ub.marking.
     5238            define variable vCodident as character no-undo.
     5239            vCodident = GetCodeIdent(idm).
     5240            find first marking where marking.mark begins vCodident no-lock no-error.
     5241            if     available marking
     5242               and marking.box-qnty ne ?
     5243            then
     5244               return marking.box-qnty.
     5245         end.
     5246         vGtin = getGtinByDm(iDM).
     5247         if ChekTypeMarkByGtin (vGtin)
     5248         then do:
     5249            vLevel = getlevelByCodId(iDM).
     5250            if     vLevel >= 1
     5251               and vLevel <= 4
     5252            then
     5253               vqnty = int(entry(vlevel,vList)).
     5254         end.
     5255         else
     5256            vqnty = getQntyCodeByGtin(vgtin).
     5257      end.
     5258      return vqnty.
     5259   end.
     5260   function getQntyUTDByDM return decimal
     5261   (iDm as char):
     5262      define variable vDM as character no-undo.
     5263      if     length (iDm) ne 25
     5264         and length (iDm) ne 29
     5265         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5266      then
     5267         vDM = substring (iDm,1,length (iDm) - 6 ).
     5268      else
     5269         vDM = substring (iDm,1,length (iDm) - 4 ).
     5270      return getQntyUTDByCodId(vDM).
     5271   end.
     5272   function getMRC4 return decimal
     5273   (iMRC as char):
     5274      define variable oMrc     as decimal no-undo init ?.
     5275      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5276      define variable vi       as integer no-undo.
     5277      define variable vfound   as integer no-undo.
     5278      define variable vposStart   as integer no-undo.
     5279      do:
     5280      OMRc = 0.
     5281      do vi = 1 to 4:
     5282         define variable vsimb as character no-undo.
     5283         vsimb = substring(iMRC,vi,1).
     5284         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5285         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5286         if vfound > 0
     5287         then
     5288            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5289         end.
     5290         OMRc = OMRc / 100.
     5291      end.
     5292      return OMRc.
     5293   end.
     5294   function getMRCByDM return decimal
     5295   (iDm as char):
     5296      define variable vMRC     as character no-undo.
     5297      define variable oMrc     as decimal no-undo init ?.
     5298      define variable Velement as character no-undo init "empty".
     5299      define variable vteg as character no-undo.
     5300      define variable vtegval as character no-undo.
     5301      if    length(idm) eq 14 + 7 + 4 + 4
     5302         or length(idm) eq 14 + 7 + 4
     5303      then do:
     5304         vMRC = substring(idm,22,4).
     5305         omrc = getMRC4(vMRC).
     5306      end.
     5307      else do:
     5308          ChekTypeMarkByDm(iDm).
     5309          block-mrc:
     5310          do while Velement ne "" and idm ne "":
     5311             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5312             if Velement begins "8005"
     5313             then do:
     5314                vMRC = substring(Velement,5,6).
     5315                leave block-mrc.
     5316             end.
     5317             else if Velement begins "(8005)"
     5318             then do:
     5319                vMRC = substring(Velement,7,6).
     5320                leave block-mrc.
     5321             end.
     5322          end.
     5323          if vMRC ne ""
     5324          then
     5325             OMRc = dec(vmrc) / 100 no-error.
     5326      end.
     5327      return OMRc.
     5328   end.
     5329   function MoveDate return Date
     5330   (idate as date,
     5331    iMonth as int64):
     5332      define variable vMonth   as int64 no-undo.
     5333      define variable vYear    as int64 no-undo.
     5334      define variable vDateNew as date  no-undo.
     5335       define variable vDay     as int64 no-undo.
     5336       vMonth = month(iDate) + iMonth.
     5337       vYear =  year(iDate).
     5338       if vMonth <= 0
     5339       then assign
     5340          vMonth = vMonth + 12
     5341           vYear  = vYear - 1
     5342       .
     5343       else if vMonth > 12
     5344       then assign
     5345          vMonth = vMonth - 12
     5346           vYear  = vYear + 1
     5347       .
     5348       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5349       do while error-status:error eq yes:
     5350          VDay = vDay + 1.
     5351          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5352       end.
     5353       if VDay > 0
     5354       then
     5355          vDateNew + 1.
     5356       return vDateNew.
     5357   end.
     5358   procedure checkEMRC:
     5359   define input  parameter iDm as character no-undo.
     5360   define output parameter vok as logical   no-undo init yes.
     5361      define variable v-value-emrc as character no-undo.
     5362      define variable v-type-emrc  as character no-undo.
     5363      define variable vDateIso     as character no-undo.
     5364      define variable vMRC         as decimal no-undo.
     5365      define variable vqnty        as decimal no-undo.
     5366      define variable vPrice       as decimal no-undo.
     5367      define variable vparent      as character no-undo.
     5368      define variable vgds-code    as integer no-undo.
     5369      define buffer code for ub.code.
     5370      vMRC = getMRCByDM(iDm).
     5371      if vMRC > 0
     5372      then do:
     5373         vgds-code = getGdsCodeByDM(iDm).
     5374         vqnty     = getQntyUTDByDM(iDm).
     5375               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5376            (
     5377             input   vgds-code
     5378            ,input   'emrc-type':U
     5379            ,output   v-value-emrc
     5380            ,output   v-type-emrc
     5381          ) no-error.
     5382          if     v-value-emrc ne ""
     5383             and v-value-emrc ne ?
     5384          then do:
     5385             vDateIso = iso-date(today).
     5386             vPrice = vMRC / vqnty.
     5387             vparent ="emc" + chr(4) + v-value-emrc.
     5388             find last code where Code.parent      eq vparent
     5389                              and Code.code        le vDateIso
     5390                              and code.status_  eq 0
     5391             no-lock no-error.
     5392             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5393             then
     5394                vOk = true .
     5395             else do:
     5396                 define variable vText      as character no-undo.
     5397                 define variable vDate      as date no-undo.
     5398                 define variable vDateLast  as character no-undo.
     5399                 define variable vDateFirst as character no-undo.
     5400                 define variable vDate3     as date no-undo.
     5401                 vdate = date(code.misc1).
     5402                 vDateLast = code.misc1.
     5403                 vDate3 = MoveDate(today, - 3 ).
     5404                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5405                                      string(vDate3  , "99/99/9999"),
     5406                                      string(vDate   , "99/99/9999")
     5407                                      ).
     5408                 vdateIso = iso-date(vdate3).
     5409                 find last code  where Code.parent      eq vparent
     5410                                   and Code.code        le vDateIso
     5411                                   and code.status_  eq 0 no-lock no-error.
     5412                 if available code
     5413                 then
     5414                    vDateIso = code.code.
     5415                 vDateFirst = vDateIso.
     5416                 vDateLast = iso-date(vdate).
     5417                 define variable vGood as logical no-undo.
     5418                 define variable vDateSale as date no-undo.
     5419                 define buffer bcode for code.
     5420                 for last code where Code.parent   eq vparent
     5421                                 and code.status_  eq 0
     5422                                 and code.code     < vDateLast
     5423                                 and code.code     >= vDateFirst
     5424                 no-lock:
     5425                    find first bcode where bCode.parent   eq vparent
     5426                                       and bcode.status_  eq 0
     5427                                       and bcode.code     > code.code no-lock no-error.
     5428                    if available bcode
     5429                    then do:
     5430                       if vPrice < dec(Code.CodeValue)
     5431                       then
     5432                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5433                                                     chr(10),
     5434                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5435                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5436                                                     ).
     5437                       else do:
     5438                          vGood = yes.
     5439                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5440                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5441                                                     chr(10),
     5442                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5443                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5444                                                     string(         vDateSale            ,"99/99/9999"),
     5445                                                     string(vDateSale - today)
     5446                                                     ).
     5447                       end.
     5448                    end.
     5449                 end.
     5450                 if vgood
     5451                 then do:
     5452                    define variable choice as integer no-undo .
     5453                    run gbl/d-askw.w (input "Уточнение"
     5454                           ,input  vText
     5455                           ,input "|"
     5456                           ,input "Принять|Вернуть"
     5457                           ,input "Принять данный товар|Вернуть товар постащику"
     5458                           ,input 1
     5459                           ,input 2
     5460                           ,output choice) no-error.
     5461                    vok = choice eq 1.
     5462                 end.
     5463                 else
     5464                    vok =false.
     5465             end.
     5466          end.
     5467      end.
     5468   end.
     5469   function addGs2Mark return character
     5470   (iMark as char):
     5471      define variable vDM   as character no-undo.
     5472      define variable vIdx  as integer   no-undo.
     5473      if index(iMark,chr(29),1) > 0
     5474      then return iMark.
     5475      if substring(iMark,26,4) = "8005" then
     5476      do:
     5477        vIdx = index(iMark,"93",26 + 4 + 5).
     5478        if vIdx > 1 then do:
     5479          vDM = substitute("&1&4&2&4&3",
     5480                           substring(iMark,1,25),
     5481                           substring(iMark,26,vIdx - 25 - 1),
     5482                           substring(iMark,vIdx),
     5483                           chr(29)) no-error.
     5484          vIdx = index(vDm,"240",vIdx + 4).
     5485          if vIdx > 0 then
     5486          do:
     5487            vDM = substitute("&1&3&2",
     5488                             substring(vDm,1,vIdx - 1),
     5489                             substring(vDm,vIdx),
     5490                             chr(29)) no-error.
     5491          end.
     5492        end.
     5493        else
     5494          vDM = substitute("&1&3&2",
     5495                           substring(iMark,1,25),
     5496                           substring(iMark,26),
     5497                           chr(29)) no-error.
     5498      end.
     5499      else if substring(iMark,32,2) = "91" then
     5500      do:
     5501        vIdx = index(iMark,"92",32).
     5502        if vIdx > 1 then
     5503          vDM = substitute("&1&4&2&4&3",
     5504                           substring(iMark,1,31),
     5505                           substring(iMark,32,vIdx - 31 - 1),
     5506                           substring(iMark,vIdx),
     5507                           chr(29)) no-error.
     5508        else
     5509          vDM = substitute("&1&3&2",
     5510                           substring(iMark,1,31),
     5511                           substring(iMark,32),
     5512                           chr(29)) no-error.
     5513      end.
     5514      else if substring(iMark,39,2) = "91" then
     5515      do:
     5516        vIdx = index(iMark,"92",38).
     5517        if vIdx > 1 then
     5518          vDM = substitute("&1&4&2&4&3",
     5519                           substring(iMark,1,38),
     5520                           substring(iMark,39,vIdx - 38 - 1),
     5521                           substring(iMark,vIdx),
     5522                           chr(29)) no-error.
     5523        else
     5524          vDM = substitute("&1&3&2",
     5525                           substring(iMark,1,38),
     5526                           substring(iMark,39),
     5527                           chr(29)) no-error.
     5528      end.
     5529      else if substring(iMark,25,2) = "93" then
     5530      do:
     5531        vIdx = index(iMark,"92",25).
     5532        if vIdx > 1 then
     5533          vDM = substitute("&1&4&2&4&3",
     5534                           substring(iMark,1,24),
     5535                           substring(iMark,25,vIdx - 24 - 1),
     5536                           substring(iMark,vIdx),
     5537                           chr(29)) no-error.
     5538        else
     5539          vIdx = index(iMark,"3103",25).
     5540          if vIdx > 0 then
     5541          vDM = substitute("&1&4&2&4&3",
     5542                           substring(iMark,1,24),
     5543                           substring(iMark,25,vIdx - 24 - 1),
     5544                           substring(iMark,vIdx),
     5545                           chr(29)) no-error.
     5546          else
     5547            vDM = substitute("&1&3&2",
     5548                             substring(iMark,1,24),
     5549                             substring(iMark,25),
     5550                             chr(29)) no-error.
     5551      end.
     5552      else if substring(iMark,32,2) = "93" then
     5553      do:
     5554        vDM = substitute("&1&3&2",
     5555              substring(iMark,1,31),
     5556              substring(iMark,32),
     5557              chr(29)) no-error.
     5558      end.
     5559      return if vDM <> "" then vDm else iMark.
     5560   end.
     5561   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5562   procedure partcopy :
     5563     define input parameter  p-free-output-copy as logical   no-undo .
     5564     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     5565     define parameter buffer buf_orig_parts     for ub.parts .
     5566     define parameter buffer buf_parts          for ub.parts .
     5567     define input parameter  p-mark             as character no-undo .
     5568     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     5569     define variable v-value-character as character no-undo .
     5570     define variable v-value-date      as date no-undo .
     5571     define variable v-value-decimal   as decimal no-undo .
     5572     define variable v-value-integer   as integer no-undo .
     5573     define variable v-izlcstpr        as logical no-undo .
     5574     define variable v-tth             as handle no-undo .
     5575     define variable v-type            as character no-undo .
     5576     define variable part-key-rec      as character no-undo .
     5577     define variable orig-part-key-rec as character no-undo .
     5578     define variable del-part-key-rec  as character no-undo .
     5579     define variable objMarks as class excisemarks  no-undo .
     5580     define variable v-parent-mark-sts as integer   no-undo .
     5581     define variable v-mark-sts-list   as character no-undo .
     5582     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     5583     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     5584     define buffer buf_gen-attr for ub.gen-attr .
     5585     define buffer buf1_gen-attr for ub.gen-attr .
     5586     define buffer buf_doc-line  for ub.doc-line .
     5587     define buffer buf_marking for ub.marking .
     5588     define buffer buf_marking-childs for ub.marking .
     5589     define buffer orig_marking-lines for ub.marking-lines .
     5590     define buffer orig_marking-lines-childs for ub.marking-lines .
     5591     define buffer buf_marking-lines for ub.marking-lines .
     5592     define buffer buf_marking-lines-childs for ub.marking-lines .
     5593     define buffer buf_marking-pack for ub.marking .
     5594     define buffer buf_marking-chk for ub.marking-chk .
     5595     define buffer buf_goods for ub.goods .
     5596     define buffer buf_trn-doc for ub.trn-doc .
     5597     define buffer pri_trn-doc for ub.trn-doc .
     5598     define buffer buf_chk-doc for ub.chk-doc .
     5599     do
     5600     on error undo, return error return-value
     5601     :
     5602       if p-free-output-copy = true
     5603       then do:
     5604         if  p-out-code <> 'free-zone':U
     5605         and p-out-code <> 'out-zone':U
     5606         then do:
     5607           message
     5608             vss-workfile vss-revision vss-description skip
     5609             vss-include-info28 skip
     5610             "Ошибка задания входных параметров процедуры partcopy" skip
     5611             "p-free-output-copy" p-free-output-copy skip
     5612             "p-out-code" p-out-code skip
     5613             view-as alert-box error .
     5614           undo, return error .
     5615         end.
     5616       end.
     5617       if buf_orig_parts.out-code <> p-out-code
     5618       then do:
     5619         find first buf_parts exclusive-lock
     5620           where buf_parts.obj-type  = buf_orig_parts.obj-type
     5621             and buf_parts.obj-code  = buf_orig_parts.obj-code
     5622             and buf_parts.artic     = buf_orig_parts.artic
     5623             and buf_parts.prod-type = buf_orig_parts.prod-type
     5624             and buf_parts.prod-code = buf_orig_parts.prod-code
     5625             and buf_parts.in-code   = buf_orig_parts.in-code
     5626             and buf_parts.out-code  = p-out-code
     5627             and buf_parts.part-code = buf_orig_parts.part-code
     5628           no-error.
     5629         if not available buf_parts
     5630         then do:
     5631           define variable v-rsrv-free as logical   no-undo .
     5632           if p-out-code = 'free-zone':U
     5633           or p-out-code = 'out-zone':U
     5634           then do:
     5635             assign
     5636               v-rsrv-free =
     5637          (if p-out-code = 'free-zone':U then yes else no)
     5638             .
     5639           end.
     5640           else do:
     5641             assign
     5642               v-rsrv-free = ?
     5643             .
     5644           end.
     5645           create buf_parts .
     5646           buffer-copy buf_orig_parts to buf_parts
     5647           assign
     5648             buf_parts.out-code  = p-out-code
     5649             buf_parts.status_   = no
     5650             buf_parts.rsrv-free = v-rsrv-free
     5651             buf_parts.qnty      = 0
     5652             buf_parts.fact-qnty = 0
     5653             buf_parts.real-qnty = 0
     5654             buf_parts.cli-qnty  = 0
     5655           .
     5656           validate buf_parts .
     5657         end.
     5658         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5659                                           ,input (buffer buf_orig_parts:handle)
     5660                                           ,output orig-part-key-rec).
     5661         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5662                                           ,input (buffer buf_parts:handle)
     5663                                           ,output part-key-rec).
     5664         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     5665               and ub.gen-attr.p-key =  orig-part-key-rec:
     5666             if not valid-object (objMarks)
     5667               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     5668               if p-out-code = 'free-zone':U
     5669               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     5670                then
     5671               do:
     5672                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     5673                   if objMarks:StatusErr
     5674                       then
     5675                   do:
     5676                       message objMarks:ReturnMsg view-as alert-box error.
     5677                       delete object objMarks no-error.
     5678                       undo, return error.
     5679                   end.
     5680               end.
     5681             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     5682             do:
     5683                 if p-mark <> "" then do:
     5684                 if p-out-code = 'free-zone':U then do:
     5685                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     5686                 end.
     5687                 else do:
     5688                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     5689                 end.
     5690                 if objMarks:StatusErr
     5691                   then
     5692                 do:
     5693                   message objMarks:ReturnMsg view-as alert-box error.
     5694                   delete object objMarks no-error.
     5695                   undo, return error.
     5696                 end.
     5697               end.
     5698             end.
     5699             if p-out-code = 'out-zone':U then
     5700             do:
     5701                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     5702                 if objMarks:StatusErr
     5703                     then
     5704                 do:
     5705                     message objMarks:ReturnMsg view-as alert-box error.
     5706                     delete object objMarks no-error.
     5707                     undo, return error.
     5708                 end.
     5709             end.
     5710         end.
     5711         delete object objMarks no-error.
     5712         if p-mark = "news" then return .
     5713         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     5714         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     5715         if not available buf_trn-doc
     5716         then
     5717            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     5718         if (
     5719             p-out-code = 'free-zone':U
     5720             and buf_orig_parts.in-code = buf_orig_parts.out-code
     5721            )
     5722         or
     5723            (
     5724             p-out-code = 'free-zone':U
     5725             and available pri_trn-doc
     5726             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     5727            )
     5728         or
     5729            (
     5730             available buf_trn-doc
     5731             and p-out-code = buf_trn-doc.doc-code
     5732             and buf_trn-doc.ext-doc-type = 'vt':U
     5733            )
     5734         or
     5735            (
     5736             p-mark = ""
     5737             and available buf_trn-doc
     5738             and p-out-code = 'free-zone':U
     5739             and buf_trn-doc.ext-doc-type = 'vt':U
     5740            )
     5741         or
     5742            (
     5743             p-mark = ""
     5744             and available buf_trn-doc
     5745             and p-out-code = 'free-zone':U
     5746             and buf_trn-doc.ext-doc-type = 'rs':U
     5747            )
     5748         then do :
     5749           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     5750             and ub.goods.prod-type = buf_parts.prod-type
     5751             and ub.goods.prod-code = buf_parts.prod-code.
     5752           def buffer buf_orig_ml for ub.marking-lines.
     5753           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     5754             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     5755             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     5756             and buf_orig_ml.in-code = buf_orig_parts.in-code
     5757             and buf_orig_ml.out-code = buf_orig_parts.out-code
     5758             and buf_orig_ml.part-code = buf_orig_parts.part-code
     5759             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     5760             if available pri_trn-doc
     5761             and pri_trn-doc.ext-doc-type = 'iv':U
     5762             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5763             then do :
     5764               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     5765                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     5766               end .
     5767               next .
     5768             end .
     5769             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     5770                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     5771                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     5772                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     5773                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     5774                                                   and ub.marking-lines.out-code = p-out-code
     5775                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     5776                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     5777                                                   no-error .
     5778             if not available ub.marking-lines
     5779             then do :
     5780               create ub.marking-lines.
     5781               buffer-copy buf_orig_ml to ub.marking-lines
     5782               assign
     5783                 ub.marking-lines.out-code  = p-out-code
     5784                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     5785               .
     5786               validate ub.marking-lines.
     5787             end .
     5788             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     5789             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     5790               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     5791               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     5792                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     5793                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     5794                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     5795                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     5796               then do:
     5797                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5798                 validate buf_marking.
     5799               end.
     5800             end .
     5801           end .
     5802           end.
     5803         end .
     5804         define variable v-doc-type  as character no-undo .
     5805         define variable   v-status    as character no-undo .
     5806         define variable v-fact-qnty   as  decimal no-undo .
     5807         define variable ii    as integer no-undo .
     5808         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     5809                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     5810                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     5811                                        .
     5812         if available pri_trn-doc
     5813         and pri_trn-doc.ext-doc-type = 'rs':U
     5814         then do :
     5815           if p-mark <> ""
     5816           then do :
     5817           end .
     5818           else do :
     5819           end .
     5820         end .
     5821         else do :
     5822           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     5823           and p-mark <> ""
     5824           then do :
     5825             if p-out-code = 'free-zone':U
     5826             then do:
     5827                 if chg-qnty < 0
     5828                 then do :
     5829                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     5830                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     5831                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     5832                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     5833                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     5834                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     5835                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     5836                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     5837                                                           no-error .
     5838                   if available orig_marking-lines
     5839                   then do :
     5840                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     5841                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     5842                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     5843                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     5844                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     5845                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     5846                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     5847                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     5848                                                            no-error .
     5849                     if not available buf_marking-lines
     5850                     then do :
     5851                       create buf_marking-lines .
     5852                       assign
     5853                         buf_marking-lines.mark       = p-mark
     5854                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     5855                         buf_marking-lines.gds-code   = buf_goods.gds-code
     5856                         buf_marking-lines.obj-type   = buf_parts.obj-type
     5857                         buf_marking-lines.obj-code   = buf_parts.obj-code
     5858                         buf_marking-lines.in-code    = buf_parts.in-code
     5859                         buf_marking-lines.out-code   = buf_parts.out-code
     5860                         buf_marking-lines.part-code  = buf_parts.part-code
     5861                         buf_marking-lines.prt-code   = buf_parts.prt-code
     5862                       .
     5863                       validate buf_marking-lines.
     5864                     end .
     5865                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     5866                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5867                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     5868                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     5869                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     5870                                                         :
     5871                           assign buf_marking-chk.sts = 0 .
     5872                           validate buf_marking-chk.
     5873                         end .
     5874                       end .
     5875                       if buf_marking.unit-ext <> "UNIT" or
     5876                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     5877                       then do :
     5878                         run addChildMarkingLines in this-procedure (
     5879                           buf_marking.mark,
     5880                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     5881                           buffer buf_marking-lines,
     5882                           buffer buf_parts,
     5883                           buffer orig_marking-lines,
     5884                           buffer buf_orig_parts,
     5885                           buffer buf_goods
     5886                         ).
     5887                       end .
     5888                     end.
     5889                     find current orig_marking-lines exclusive-lock .
     5890                     delete orig_marking-lines .
     5891                   end .
     5892                 end .
     5893             end.
     5894             else do:
     5895               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     5896                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     5897                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     5898                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     5899                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     5900                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     5901                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     5902                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     5903                                                              no-error .
     5904                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     5905                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     5906                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     5907                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     5908                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     5909                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     5910                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     5911                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     5912                                                         no-error .
     5913                 if not available buf_marking-lines
     5914                 then do :
     5915                   create buf_marking-lines .
     5916                   assign
     5917                     buf_marking-lines.mark       = p-mark
     5918                     buf_marking-lines.doc-level  = 1
     5919                     buf_marking-lines.gds-code   = buf_goods.gds-code
     5920                     buf_marking-lines.obj-type   = buf_parts.obj-type
     5921                     buf_marking-lines.obj-code   = buf_parts.obj-code
     5922                     buf_marking-lines.in-code    = buf_parts.in-code
     5923                     buf_marking-lines.out-code   = buf_parts.out-code
     5924                     buf_marking-lines.part-code  = buf_parts.part-code
     5925                     buf_marking-lines.prt-code   = buf_parts.prt-code
     5926                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     5927                   .
     5928                   validate buf_marking-lines.
     5929                 end .
     5930                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     5931                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     5932                   validate buf_marking.
     5933                   for first buf_marking-childs exclusive-lock where
     5934                             buf_marking-childs.mark = buf_marking.mark-parent:
     5935                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     5936                     validate buf_marking-childs.
     5937                   end.
     5938                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     5939                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     5940                                                     and buf_chk-doc.out-code = buf_parts.out-code
     5941                                                     :
     5942                       if buf_marking-chk.sts <> 2 then
     5943                       do:
     5944                          assign buf_marking-chk.sts = 1 .
     5945                          validate buf_marking-chk.
     5946                       end.
     5947                     end .
     5948                   end .
     5949                   if buf_marking.unit-ext <> "UNIT" or
     5950                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     5951                   then do :
     5952                     run addChildMarkingLines in this-procedure (
     5953                       buf_marking.mark,
     5954                       buf_marking.sts,
     5955                       buffer buf_marking-lines,
     5956                       buffer buf_parts,
     5957                       buffer orig_marking-lines,
     5958                       buffer buf_orig_parts,
     5959                       buffer buf_goods
     5960                     ).
     5961                   end .
     5962                 end.
     5963                 if available orig_marking-lines then
     5964                   delete orig_marking-lines .
     5965             end.
     5966           end.
     5967         end .
     5968         if p-out-code = 'out-zone':U
     5969         and trim(p-mark) = ""
     5970         then do :
     5971           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5972                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     5973                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     5974                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     5975                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     5976                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     5977                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     5978                                                 :
     5979             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     5980                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     5981                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     5982                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     5983                                                     and buf_marking-lines.out-code   = p-out-code
     5984                                                     no-error .
     5985             if available buf_marking-lines
     5986             then do :
     5987               find current buf_marking-lines exclusive-lock .
     5988               delete buf_marking-lines .
     5989               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5990                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     5991                 then do :
     5992                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5993                   validate buf_marking.
     5994                 end.
     5995               end .
     5996             end .
     5997             else do :
     5998               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     5999               create buf_marking-lines .
     6000               assign
     6001                 buf_marking-lines.mark       = orig_marking-lines.mark
     6002                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     6003                 buf_marking-lines.gds-code   = buf_goods.gds-code
     6004                 buf_marking-lines.obj-type   = buf_parts.obj-type
     6005                 buf_marking-lines.obj-code   = buf_parts.obj-code
     6006                 buf_marking-lines.in-code    = buf_parts.in-code
     6007                 buf_marking-lines.out-code   = buf_parts.out-code
     6008                 buf_marking-lines.part-code  = buf_parts.part-code
     6009                 buf_marking-lines.prt-code   = buf_parts.prt-code
     6010               .
     6011               validate buf_marking-lines.
     6012               if buf_parts.out-code <> buf_parts.in-code
     6013               and buf_parts.out-code <> 'free-zone':U
     6014               and buf_parts.out-code <> 'out-zone':U
     6015               then do :
     6016                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     6017                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     6018               end .
     6019               end.
     6020             end .
     6021             release buf_marking-lines no-error .
     6022           end.
     6023         end .
     6024         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     6025         then do:
     6026           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     6027                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     6028                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     6029                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     6030                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     6031                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     6032                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     6033                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     6034                                                   .
     6035             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     6036                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     6037                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     6038                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     6039                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     6040                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     6041                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     6042                                                    no-error .
     6043             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     6044               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     6045                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     6046               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     6047                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     6048               validate ub.marking.
     6049             end.
     6050             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     6051             if available (buf_marking-lines)
     6052             then do:
     6053               assign
     6054                 buf_marking-lines.mark       = p-mark
     6055                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     6056                 buf_marking-lines.gds-code   = buf_goods.gds-code
     6057                 buf_marking-lines.obj-type   = buf_parts.obj-type
     6058                 buf_marking-lines.obj-code   = buf_parts.obj-code
     6059                 buf_marking-lines.in-code    = buf_parts.in-code
     6060                 buf_marking-lines.out-code   = buf_parts.out-code
     6061                 buf_marking-lines.part-code  = buf_parts.part-code
     6062               .
     6063               validate buf_marking-lines.
     6064             end.
     6065           end.
     6066         end.
     6067       end.
     6068       else do:
     6069         find first buf_parts exclusive-lock
     6070           where recid(buf_parts) = recid(buf_orig_parts)
     6071           .
     6072       end.
     6073       if p-out-code = 'free-zone':U
     6074       or p-out-code = 'out-zone':U
     6075       then do:
     6076         if buf_parts.rsrv-free <>
     6077          (if buf_parts.out-code = 'free-zone':U then yes else no)
     6078         then do:
     6079           message
     6080             vss-workfile vss-revision vss-description skip
     6081             vss-include-info28 skip
     6082             "Ошибка типа резерва партии" skip
     6083             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     6084             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6085             "Партия" buf_parts.in-code buf_parts.part-code skip
     6086             "Резерв" buf_parts.out-code skip
     6087             "Статус" buf_parts.status_ skip
     6088             "Тип резерва" buf_parts.rsrv-free skip
     6089             view-as alert-box error .
     6090           undo, return error .
     6091         end.
     6092       end.
     6093     end.
     6094   end procedure.
     6095   procedure partcopy-to-childs-mark :
     6096     define parameter buffer buf_ml for ub.marking-lines .
     6097     define parameter buffer buf_orig-ml for ub.marking-lines .
     6098     define input parameter p-out-code as character no-undo .
     6099     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     6100     define buffer buf_ml-childs for ub.marking-lines .
     6101     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     6102       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     6103         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     6104       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     6105         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     6106       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     6107         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     6108         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     6109         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     6110         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     6111         and buf_ml-childs.part-code = buf_orig-ml.part-code
     6112         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     6113         :
     6114         assign
     6115           buf_ml-childs.out-code  = p-out-code
     6116         .
     6117         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     6118       end.
     6119     end.
     6120   end.
     6121   procedure partcopy-update-parts :
     6122     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     6123     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     6124     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     6125     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     6126     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     6127     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     6128     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     6129     define buffer buf_trn-doc for ub.trn-doc .
     6130     define buffer archive_parts for ub.parts .
     6131     define buffer buf_parts   for ub.parts .
     6132     define buffer orig_marking-lines for ub.marking-lines .
     6133     define buffer buf_marking for ub.marking .
     6134     define buffer buf_goods for ub.goods .
     6135     define variable v-rsrv-code     as character no-undo .
     6136     define variable v-goods-twounit as logical   no-undo .
     6137     define variable v-value-character as character no-undo .
     6138     define variable v-value-date      as date no-undo .
     6139     define variable v-value-decimal   as decimal no-undo .
     6140     define variable v-value-integer   as integer no-undo .
     6141     define variable v-izlcstpr        as logical no-undo .
     6142     define variable v-tth             as handle no-undo .
     6143     define variable v-type            as character no-undo .
     6144     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     6145     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     6146     do
     6147     on error undo, return error return-value
     6148     :
     6149       find first buf_trn-doc no-lock
     6150         where buf_trn-doc.doc-code = p-doc-code
     6151         no-error .
     6152       if not available buf_trn-doc
     6153       then do:
     6154         message
     6155           vss-workfile vss-revision vss-description skip
     6156           vss-include-info28 skip
     6157           "Ошибка задания входных параметров" skip
     6158           "Не найден документ" skip
     6159           "Документ" p-doc-code skip
     6160           "Объект" p-obj-type p-obj-code skip
     6161           "Артикул" p-artic p-prod-type p-prod-code skip
     6162           error-status :get-message(1) skip
     6163           return-value skip
     6164           view-as alert-box error .
     6165         undo, return error .
     6166       end.
     6167       find first buf_goods no-lock where buf_goods.artic = p-artic
     6168                                      and buf_goods.prod-type = p-prod-type
     6169                                      and buf_goods.prod-code = p-prod-code
     6170                                      no-error .
     6171       if not available buf_goods
     6172       then do:
     6173         message
     6174           vss-workfile vss-revision vss-description skip
     6175           vss-include-info28 skip
     6176           "Ошибка задания входных параметров" skip
     6177           "Не найден товар" skip
     6178           "Документ" p-doc-code skip
     6179           "Объект" p-obj-type p-obj-code skip
     6180           "Артикул" p-artic p-prod-type p-prod-code skip
     6181           error-status :get-message(1) skip
     6182           return-value skip
     6183           view-as alert-box error .
     6184         undo, return error .
     6185       end.
     6186       if buf_trn-doc.ext-doc-type = 'vt':U
     6187       then do :
     6188           delete object v-tth no-error.
     6189           run adm/shattri.p (
     6190              input "get":U
     6191             ,input buf_trn-doc.obj-type
     6192             ,input buf_trn-doc.obj-code
     6193             ,input 'inv-obj':U
     6194             ,input  "izlcstpr"
     6195             ,output v-value-character
     6196             ,output v-value-date
     6197             ,output v-value-decimal
     6198             ,output v-value-integer
     6199             ,output v-izlcstpr
     6200             ,output v-type
     6201             ,INPUT-OUTPUT table-handle v-tth
     6202             ) no-error .
     6203             delete object v-tth no-error.
     6204           if error-status:error then do:
     6205             v-izlcstpr = false .
     6206           end.
     6207       end.
     6208       else do :
     6209           v-izlcstpr = false .
     6210       end.
     6211   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6213     (input  p-artic
     6214     ,input  p-prod-type
     6215     ,input  p-prod-code
     6216     ,input  'twounit=request':u
     6217     ,output v-goods-twounit
     6218     ) no-error .
     6219       if error-status :error
     6220       then do:
     6221         message
     6222           vss-workfile vss-revision vss-description skip
     6223           vss-include-info28 skip
     6224           "Ошибка при определении атрибута товара" skip
     6225           "Артикул" p-artic p-prod-type p-prod-code skip
     6226           error-status :get-message(1) skip
     6227           return-value skip
     6228           view-as alert-box error .
     6229         undo, return error .
     6230       end.
     6231       define query partcopy-select-parts for archive_parts .
     6232       open query partcopy-select-parts preselect each archive_parts
     6233         where archive_parts.obj-type  = p-obj-type
     6234           and archive_parts.obj-code  = p-obj-code
     6235           and archive_parts.artic     = p-artic
     6236           and archive_parts.prod-type = p-prod-type
     6237           and archive_parts.prod-code = p-prod-code
     6238           and archive_parts.out-code  = p-doc-code
     6239         .
     6240       get first partcopy-select-parts .
     6241       if buf_trn-doc.doc-type = 'при':U
     6242       then do:
     6243         do while available archive_parts
     6244         on error undo, return error return-value
     6245         :
     6246           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     6247           or (buf_trn-doc.doc-type = 'инв':U
     6248               and archive_parts.fact-qnty < 0)
     6249           then do:
     6250             assign
     6251               v-rsrv-code = 'out-zone':U
     6252             .
     6253           end.
     6254           else do:
     6255             assign
     6256               v-rsrv-code = 'free-zone':U
     6257             .
     6258           end.
     6259           assign
     6260             archive_parts.status_   = yes
     6261             archive_parts.rsrv-free = ?
     6262           .
     6263           if archive_parts.in-code = p-doc-code
     6264           then do:
     6265             assign
     6266               archive_parts.fact-num  = buf_trn-doc.fact-num
     6267               archive_parts.fact-date = buf_trn-doc.fact-date
     6268               archive_parts.doc-type  = buf_trn-doc.doc-type
     6269             .
     6270           end.
     6271           if archive_parts.fact-qnty <> 0
     6272           then do:
     6273             run partcopy in this-procedure
     6274               (input  true
     6275               ,input  v-rsrv-code
     6276               ,buffer archive_parts
     6277               ,buffer buf_parts
     6278               ,input  ""
     6279               ) no-error .
     6280             if error-status :error
     6281             then do:
     6282               message
     6283                 vss-workfile vss-revision vss-description skip
     6284                 vss-include-info28 skip
     6285                 "Ошибка при создании партии" skip
     6286                 "Документ" p-doc-code skip
     6287                 "Объект" p-obj-type p-obj-code skip
     6288                 "Артикул" p-artic p-prod-type p-prod-code skip
     6289                 "Партия" archive_parts.in-code archive_parts.part-code skip
     6290                 "Резерв" v-rsrv-code skip
     6291                 error-status :get-message(1) skip
     6292                 return-value skip
     6293                 view-as alert-box error .
     6294               undo, return error .
     6295             end.
     6296             assign
     6297               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     6298               buf_parts.fact-qnty = buf_parts.qnty
     6299             .
     6300             if v-goods-twounit = true
     6301             then do:
     6302               assign
     6303                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     6304               .
     6305               case buf_trn-doc.ext-doc-type :
     6306                 when 'ie':U
     6307                 then do:
     6308                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     6309                   then do:
     6310                     message
     6311                       vss-workfile vss-revision vss-description skip
     6312                       vss-include-info28 skip
     6313                       "Клиентское количество для товара," skip
     6314                       "который учитывается по двум единицам измерения" skip
     6315                       "должно равняться единице" skip
     6316                       "Документ" p-doc-code skip
     6317                       "Объект" p-obj-type p-obj-code skip
     6318                       "Артикул" p-artic p-prod-type p-prod-code skip
     6319                       "Партия" archive_parts.in-code archive_parts.part-code skip
     6320                       "Количество по документу" archive_parts.qnty skip
     6321                       "Фактическое количество" archive_parts.fact-qnty skip
     6322                       "Клиентское количество" archive_parts.cli-qnty skip
     6323                       view-as alert-box error .
     6324                     undo, return error .
     6325                   end.
     6326                 end.
     6327                 when 'iv':U
     6328                 then do:
     6329                   if archive_parts.cli-qnty <> 1
     6330                   then do:
     6331                     message
     6332                       vss-workfile vss-revision vss-description skip
     6333                       vss-include-info28 skip
     6334                       "Клиентское количество для товара," skip
     6335                       "который учитывается по двум единицам измерения" skip
     6336                       "должно равняться единице" skip
     6337                       "Документ" p-doc-code skip
     6338                       "Объект" p-obj-type p-obj-code skip
     6339                       "Артикул" p-artic p-prod-type p-prod-code skip
     6340                       "Партия" archive_parts.in-code archive_parts.part-code skip
     6341                       "Количество по документу" archive_parts.qnty skip
     6342                       "Фактическое количество" archive_parts.fact-qnty skip
     6343                       "Клиентское количество" archive_parts.cli-qnty skip
     6344                       view-as alert-box error .
     6345                     undo, return error .
     6346                   end.
     6347                 end.
     6348                 otherwise do:
     6349                   message
     6350                     vss-workfile vss-revision vss-description skip
     6351                     vss-include-info28 skip
     6352                     "Товар учитывается по двум единицам измерения" skip
     6353                     "Для приходов разрешен только внешний приход или приход перемещение" skip
     6354                     "Документ" p-doc-code skip
     6355                     "Объект" p-obj-type p-obj-code skip
     6356                     "Артикул" p-artic p-prod-type archive_parts.prod-code skip
     6357                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6358                     "Количество по документу" archive_parts.qnty skip
     6359                     "Фактическое количество" archive_parts.fact-qnty skip
     6360                     "Клиентское количество" archive_parts.cli-qnty skip
     6361                     view-as alert-box error .
     6362                   undo, return error .
     6363                 end.
     6364               end.
     6365             end.
     6366             else do:
     6367               if buf_parts.cli-base-rate <> 0
     6368               then do:
     6369                 assign
     6370                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6371                 .
     6372               end.
     6373               else do:
     6374                 assign
     6375                   buf_parts.cli-qnty = 0
     6376                 .
     6377               end.
     6378             end.
     6379             if  buf_parts.qnty      = 0
     6380             and buf_parts.fact-qnty = 0
     6381             then do:
     6382               if v-goods-twounit = true
     6383               then do:
     6384                 if buf_parts.cli-qnty <> 0
     6385                 then do:
     6386                   message
     6387                     vss-workfile vss-revision vss-description skip
     6388                     vss-include-info28 skip
     6389                     "Ошибка при удалении партии" skip
     6390                     "Документ" p-doc-code skip
     6391                     "Объект" p-obj-type p-obj-code skip
     6392                     "Артикул" p-artic p-prod-type p-prod-code skip
     6393                     "Партия" buf_parts.in-code buf_parts.part-code skip
     6394                     "Резерв" buf_parts.out-code skip
     6395                     "qnty" buf_parts.qnty skip
     6396                     "fact-qnty" buf_parts.fact-qnty skip
     6397                     "cli-qnty" buf_parts.cli-qnty skip
     6398                     view-as alert-box error .
     6399                   undo, return error .
     6400                 end.
     6401               end.
     6402               delete buf_parts .
     6403             end.
     6404           end.
     6405           else do :
     6406             if buf_trn-doc.ext-doc-type = 'iv':U
     6407             then
     6408             for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6409                                                   and orig_marking-lines.obj-type   = archive_parts.obj-type
     6410                                                   and orig_marking-lines.obj-code   = archive_parts.obj-code
     6411                                                   and orig_marking-lines.in-code    = archive_parts.in-code
     6412                                                   and orig_marking-lines.out-code   = archive_parts.out-code
     6413                                                   and orig_marking-lines.part-code  = archive_parts.part-code,
     6414             first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6415               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     6416             end .
     6417           end .
     6418           get next partcopy-select-parts .
     6419         end.
     6420       end.
     6421       if buf_trn-doc.doc-type = 'рас':U
     6422       or buf_trn-doc.doc-type = 'спи':U
     6423       or buf_trn-doc.doc-type = 'возврат':U
     6424       or buf_trn-doc.doc-type = 'инв':U
     6425       then do:
     6426         do while available archive_parts
     6427         on error undo, return error return-value
     6428         :
     6429           assign
     6430             archive_parts.status_   = yes
     6431             archive_parts.rsrv-free = ?
     6432           .
     6433           if archive_parts.fact-qnty <> archive_parts.qnty
     6434           then do:
     6435             define variable v-is-hold as logical   no-undo .
     6436   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6437   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     6438     (input  buf_trn-doc.doc-code
     6439     ,output v-is-hold
     6440     ) no-error .
     6441             if error-status :error
     6442             then do:
     6443               message
     6444                 vss-workfile vss-revision vss-description skip
     6445                 vss-include-info28
     6446                 "Ошибка при определении типа документа hold-doc.i" skip
     6447                 "Документ" p-doc-code skip
     6448                 "Объект" p-obj-type p-obj-code skip
     6449                 "Артикул" p-artic p-prod-type p-prod-code skip
     6450                 error-status :get-message(1) skip
     6451                 return-value skip
     6452                 view-as alert-box error .
     6453               undo, return error .
     6454             end.
     6455             if buf_trn-doc.ext-doc-type = 'vt':U
     6456             or (buf_trn-doc.ext-doc-type = 're':U and v-is-hold = true)
     6457             or buf_trn-doc.ext-doc-type = 'ap':U
     6458             or buf_trn-doc.ext-doc-type = 'pc':U
     6459             or buf_trn-doc.ext-doc-type = 'mp':U
     6460             or  buf_trn-doc.ext-doc-type = 'vp':U
     6461             then do:
     6462               message
     6463                 vss-workfile vss-revision vss-description skip
     6464                 vss-include-info28 skip
     6465                 "Фактическое количество не может отличаться от количества по документу" skip
     6466                 "для документов инвентаризации, внутреннего возврата и автоматического возврата между фирмами" skip
     6467                 "Документ" p-doc-code skip
     6468                 "Объект" p-obj-type p-obj-code skip
     6469                 "Артикул" p-artic p-prod-type p-prod-code skip
     6470                 "Партия" archive_parts.in-code archive_parts.part-code skip
     6471                 "Количество по документу" archive_parts.qnty skip
     6472                 "Фактическое количество" archive_parts.fact-qnty skip
     6473                 "Клиентское количество" archive_parts.cli-qnty skip
     6474                 view-as alert-box error .
     6475               undo, return error .
     6476             end.
     6477             if archive_parts.in-code <> archive_parts.out-code
     6478             then do:
     6479               if can-do('рас,спи':U,buf_trn-doc.doc-type)
     6480               or (buf_trn-doc.doc-type = 'инв':U
     6481                   and archive_parts.fact-qnty < 0)
     6482               then do:
     6483                 assign
     6484                   v-rsrv-code = 'free-zone':U
     6485                 .
     6486               end.
     6487               else do:
     6488                 assign
     6489                   v-rsrv-code = 'out-zone':U
     6490                 .
     6491               end.
     6492               run partcopy in this-procedure
     6493                 (input  true
     6494                 ,input  v-rsrv-code
     6495                 ,buffer archive_parts
     6496                 ,buffer buf_parts
     6497                 ,input  ""
     6498                 ) no-error .
     6499               if error-status :error
     6500               then do:
     6501                 message
     6502                   vss-workfile vss-revision vss-description skip
     6503                   vss-include-info28 skip
     6504                   "Ошибка при создании партии" skip
     6505                   "Документ" p-doc-code skip
     6506                   "Объект" p-obj-type p-obj-code skip
     6507                   "Артикул" p-artic p-prod-type p-prod-code skip
     6508                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6509                   "Резерв" v-rsrv-code skip
     6510                   error-status :get-message(1) skip
     6511                   return-value skip
     6512                   view-as alert-box error .
     6513                 undo, return error .
     6514               end.
     6515               assign
     6516                 buf_parts.qnty      = buf_parts.qnty + (archive_parts.qnty - archive_parts.fact-qnty)
     6517                 buf_parts.fact-qnty = buf_parts.qnty
     6518               .
     6519               if v-goods-twounit = true
     6520               then do:
     6521                 if archive_parts.cli-qnty <> 1
     6522                 then do:
     6523                   message
     6524                     vss-workfile vss-revision vss-description skip
     6525                     vss-include-info28 skip
     6526                     "Клиентское количество для товара," skip
     6527                     "который учитывается по двум единицам измерения" skip
     6528                     "должно равняться единице" skip
     6529                     "Документ" p-doc-code skip
     6530                     "Объект" p-obj-type p-obj-code skip
     6531                     "Артикул" p-artic p-prod-type p-prod-code skip
     6532                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6533                     "Количество по документу" archive_parts.qnty skip
     6534                     "Фактическое количество" archive_parts.fact-qnty skip
     6535                     "Клиентское количество" archive_parts.cli-qnty skip
     6536                     view-as alert-box error .
     6537                   undo, return error .
     6538                 end.
     6539                 if archive_parts.fact-qnty = 0
     6540                 then do:
     6541                   assign
     6542                     buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     6543                   .
     6544                 end.
     6545                 else do:
     6546                   message
     6547                     vss-workfile vss-revision vss-description skip
     6548                     vss-include-info28 skip
     6549                     "Фактическое количество для товара," skip
     6550                     "который учитывается по двум единицам измерения" skip
     6551                     "должно равняться нулю или количеству по документу" skip
     6552                     "Документ" p-doc-code skip
     6553                     "Объект" p-obj-type p-obj-code skip
     6554                     "Артикул" p-artic p-prod-type p-prod-code skip
     6555                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6556                     "Количество по документу" archive_parts.qnty skip
     6557                     "Фактическое количество" archive_parts.fact-qnty skip
     6558                     "Клиентское количество" archive_parts.cli-qnty skip
     6559                     view-as alert-box error .
     6560                   undo, return error .
     6561                 end.
     6562               end.
     6563               else do:
     6564                 if buf_parts.cli-base-rate <> 0
     6565                 then do:
     6566                   assign
     6567                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6568                   .
     6569                 end.
     6570                 else do:
     6571                   assign
     6572                     buf_parts.cli-qnty = 0
     6573                   .
     6574                 end.
     6575               end.
     6576             end.
     6577             if  available buf_parts
     6578             and buf_parts.qnty      = 0
     6579             and buf_parts.fact-qnty = 0
     6580             then do:
     6581               if v-goods-twounit = true
     6582               then do:
     6583                 if buf_parts.cli-qnty <> 0
     6584                 then do:
     6585                   message
     6586                     vss-workfile vss-revision vss-description skip
     6587                     vss-include-info28 skip
     6588                     "Ошибка при удалении партии" skip
     6589                     "Документ" p-doc-code skip
     6590                     "Объект" p-obj-type p-obj-code skip
     6591                     "Артикул" p-artic p-prod-type p-prod-code skip
     6592                     "Партия" buf_parts.in-code buf_parts.part-code skip
     6593                     "Резерв" buf_parts.out-code skip
     6594                     "qnty" buf_parts.qnty skip
     6595                     "fact-qnty" buf_parts.fact-qnty skip
     6596                     "cli-qnty" buf_parts.cli-qnty skip
     6597                     view-as alert-box error .
     6598                   undo, return error .
     6599                 end.
     6600               end.
     6601               delete buf_parts .
     6602             end.
     6603           end.
     6604           if archive_parts.in-code = buf_trn-doc.doc-code
     6605           then do:
     6606             assign
     6607               archive_parts.fact-num  = buf_trn-doc.fact-num
     6608               archive_parts.fact-date = buf_trn-doc.fact-date
     6609               archive_parts.doc-type  = buf_trn-doc.doc-type
     6610             .
     6611           end.
     6612           if archive_parts.fact-qnty <> 0
     6613           then do:
     6614             if can-do('рас,спи':U, buf_trn-doc.doc-type)
     6615             or (buf_trn-doc.doc-type = 'инв':U
     6616                 and archive_parts.fact-qnty < 0
     6617               )
     6618             then do:
     6619   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     6621     (input  buf_trn-doc.doc-code
     6622     ,output v-is-hold
     6623     ) no-error .
     6624               if error-status :error
     6625               then do:
     6626                 message
     6627                   vss-workfile vss-revision vss-description skip
     6628                   vss-include-info28
     6629                   "Ошибка при определении типа документа hold-doc.i" skip
     6630                   "Документ" p-doc-code skip
     6631                   "Объект" p-obj-type p-obj-code skip
     6632                   "Артикул" p-artic p-prod-type p-prod-code skip
     6633                   error-status :get-message(1) skip
     6634                   return-value skip
     6635                   view-as alert-box error .
     6636                 undo, return error .
     6637               end.
     6638               assign
     6639                 v-rsrv-code = 'out-zone':U
     6640               .
     6641               if buf_trn-doc.ext-doc-type  = 'ep':U
     6642               or (buf_trn-doc.ext-doc-type = 'ap':U )
     6643               or (buf_trn-doc.ext-doc-type = 'pc':U )
     6644               then do:
     6645                 assign
     6646                   v-rsrv-code = ""
     6647                 .
     6648                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6649                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     6650                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     6651                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     6652                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     6653                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     6654                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6655                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     6656                 end .
     6657               end.
     6658             end.
     6659             else do:
     6660               assign
     6661                 v-rsrv-code = 'free-zone':U
     6662               .
     6663             end.
     6664             if v-rsrv-code <> ""
     6665             then do:
     6666               run partcopy in this-procedure
     6667                 (input  true
     6668                 ,input  v-rsrv-code
     6669                 ,buffer archive_parts
     6670                 ,buffer buf_parts
     6671                 ,input  ""
     6672                 ) no-error .
     6673               if error-status :error
     6674               then do:
     6675                 message
     6676                   vss-workfile vss-revision vss-description skip
     6677                   vss-include-info28 skip
     6678                   "Ошибка при создании партии" skip
     6679                   "Документ" buf_trn-doc.doc-code skip
     6680                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     6681                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     6682                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6683                   "Резерв" v-rsrv-code skip
     6684                   error-status :get-message(1) skip
     6685                   return-value skip
     6686                   view-as alert-box error .
     6687                 undo, return error .
     6688               end.
     6689               assign
     6690                 buf_parts.qnty      = buf_parts.qnty + abs(archive_parts.fact-qnty)
     6691                 buf_parts.fact-qnty = buf_parts.qnty
     6692               .
     6693               if v-goods-twounit = true
     6694               then do:
     6695                 define variable v-qnty-sign as integer   no-undo .
     6696                 assign
     6697                   v-qnty-sign = 1
     6698                 .
     6699                 if  buf_trn-doc.doc-type = 'инв':U
     6700                 and archive_parts.fact-qnty < 0
     6701                 then do:
     6702                   assign
     6703                     v-qnty-sign = - 1
     6704                   .
     6705                 end.
     6706                 if archive_parts.cli-qnty <> v-qnty-sign
     6707                 then do:
     6708                   message
     6709                     vss-workfile vss-revision vss-description skip
     6710                     vss-include-info28 skip
     6711                     "Клиентское количество для товара," skip
     6712                     "который учитывается по двум единицам измерения" skip
     6713                     "должно равняться" v-qnty-sign skip
     6714                     "Документ" p-doc-code skip
     6715                     "Объект" p-obj-type p-obj-code skip
     6716                     "Артикул" p-artic p-prod-type p-prod-code skip
     6717                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6718                     "Количество по документу" archive_parts.qnty skip
     6719                     "Фактическое количество" archive_parts.fact-qnty skip
     6720                     "Клиентское количество" archive_parts.cli-qnty skip
     6721                     view-as alert-box error .
     6722                   undo, return error .
     6723                 end.
     6724                 if archive_parts.fact-qnty = archive_parts.qnty
     6725                 then do:
     6726                   assign
     6727                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     6728                   .
     6729                 end.
     6730                 else do:
     6731                   message
     6732                     vss-workfile vss-revision vss-description skip
     6733                     vss-include-info28 skip
     6734                     "Фактическое количество для товара," skip
     6735                     "который учитывается по двум единицам измерения" skip
     6736                     "должно равняться нулю или количеству по документу" skip
     6737                     "Документ" p-doc-code skip
     6738                     "Объект" p-obj-type p-obj-code skip
     6739                     "Артикул" p-artic p-prod-type p-prod-code skip
     6740                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6741                     "Количество по документу" archive_parts.qnty skip
     6742                     "Фактическое количество" archive_parts.fact-qnty skip
     6743                     "Клиентское количество" archive_parts.cli-qnty skip
     6744                     view-as alert-box error .
     6745                   undo, return error .
     6746                 end.
     6747               end.
     6748               else do:
     6749                 if buf_parts.cli-base-rate <> 0
     6750                 then do:
     6751                   assign
     6752                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6753                   .
     6754                 end.
     6755                 else do:
     6756                   assign
     6757                     buf_parts.cli-qnty = 0
     6758                   .
     6759                 end.
     6760               end.
     6761               if  buf_parts.qnty      = 0
     6762               and buf_parts.fact-qnty = 0
     6763               then do:
     6764                 if v-goods-twounit = true
     6765                 then do:
     6766                   if buf_parts.cli-qnty <> 0
     6767                   then do:
     6768                     message
     6769                       vss-workfile vss-revision vss-description skip
     6770                       vss-include-info28 skip
     6771                       "Ошибка при удалении партии" skip
     6772                       "Документ" p-doc-code skip
     6773                       "Объект" p-obj-type p-obj-code skip
     6774                       "Артикул" p-artic p-prod-type p-prod-code skip
     6775                       "Партия" buf_parts.in-code buf_parts.part-code skip
     6776                       "Резерв" buf_parts.out-code skip
     6777                       "qnty" buf_parts.qnty skip
     6778                       "fact-qnty" buf_parts.fact-qnty skip
     6779                       "cli-qnty" buf_parts.cli-qnty skip
     6780                       view-as alert-box error .
     6781                     undo, return error .
     6782                   end.
     6783                 end.
     6784                 delete buf_parts .
     6785               end.
     6786             end.
     6787           end.
     6788           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     6789           and archive_parts.supp-type =
     6790           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     6791           and archive_parts.supp-code =
     6792           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     6793           )
     6794           or buf_trn-doc.ext-doc-type = 'rv':U
     6795           then do:
     6796             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     6797             or (buf_trn-doc.doc-type = 'инв':U
     6798                 and archive_parts.fact-qnty < 0
     6799               )
     6800             then do:
     6801               assign
     6802                 v-rsrv-code = 'free-zone':U
     6803               .
     6804             end.
     6805             else do:
     6806               assign
     6807                 v-rsrv-code = 'out-zone':U
     6808               .
     6809             end.
     6810             if not v-izlcstpr
     6811             then do :
     6812                 run partcopy in this-procedure
     6813                   (input  true
     6814                   ,input  v-rsrv-code
     6815                   ,buffer archive_parts
     6816                   ,buffer buf_parts
     6817                   ,input  ""
     6818                   ) no-error .
     6819                 if error-status :error
     6820                 then do:
     6821                   message
     6822                     vss-workfile vss-revision vss-description skip
     6823                     vss-include-info28 skip
     6824                     "Ошибка при создании партии" skip
     6825                     "Документ" p-doc-code skip
     6826                     "Объект" p-obj-type p-obj-code skip
     6827                     "Артикул" p-artic p-prod-type p-prod-code skip
     6828                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6829                     "Резерв" v-rsrv-code skip
     6830                     error-status :get-message(1) skip
     6831                     return-value skip
     6832                     view-as alert-box error .
     6833                   undo, return error .
     6834                 end.
     6835                 assign
     6836                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     6837                   buf_parts.fact-qnty = buf_parts.qnty
     6838                 .
     6839                 if buf_trn-doc.ext-doc-type = 'rv':U
     6840                 then
     6841                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6842                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     6843                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     6844                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     6845                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     6846                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     6847                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     6848                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6849                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     6850                   then
     6851                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6852                 end .
     6853                 if v-goods-twounit = true
     6854                 then do:
     6855                   message
     6856                     vss-workfile vss-revision vss-description skip
     6857                     vss-include-info28 skip
     6858                     "Запрещено порождение партий," skip
     6859                     "который учитывается по двум единицам измерения" skip
     6860                     "Документ" p-doc-code skip
     6861                     "Объект" p-obj-type p-obj-code skip
     6862                     "Артикул" p-artic p-prod-type p-prod-code skip
     6863                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6864                     "Количество по документу" archive_parts.qnty skip
     6865                     "Фактическое количество" archive_parts.fact-qnty skip
     6866                     "Клиентское количество" archive_parts.cli-qnty skip
     6867                     view-as alert-box error .
     6868                   undo, return error .
     6869                 end.
     6870                 else do:
     6871                   if buf_parts.cli-base-rate <> 0
     6872                   then do:
     6873                     assign
     6874                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6875                     .
     6876                   end.
     6877                   else do:
     6878                     assign
     6879                       buf_parts.cli-qnty = 0
     6880                     .
     6881                   end.
     6882                 end.
     6883             end.
     6884           end.
     6885           get next partcopy-select-parts .
     6886         end.
     6887       end.
     6888     end.
     6889   end procedure.
     6890   procedure partcopy-update-parts-delete :
     6891     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     6892     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     6893     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     6894     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     6895     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     6896     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     6897     define variable objMarks as class excisemarks no-undo.
     6898     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     6899     define buffer buf_trn-doc    for ub.trn-doc .
     6900     define buffer archive_parts  for ub.parts .
     6901     define buffer buf_parts      for ub.parts .
     6902     define buffer buf_parts-attr for ub.parts-attr .
     6903     define variable v-rsrv-code as character no-undo .
     6904     define variable v-unrv-code as character no-undo .
     6905     define variable v-need-rsrv as logical   no-undo .
     6906     define variable v-need-unrv as logical   no-undo .
     6907     define variable v-rsrv-sign as integer   no-undo .
     6908     define variable v-unrv-sign as integer   no-undo .
     6909     define variable v-goods-twounit as logical   no-undo .
     6910     define variable v-value-character as character no-undo .
     6911     define variable v-value-date      as date no-undo .
     6912     define variable v-value-decimal   as decimal no-undo .
     6913     define variable v-value-integer   as integer no-undo .
     6914     define variable v-izlcstpr        as logical no-undo .
     6915     define variable v-tth             as handle no-undo .
     6916     define variable v-type            as character no-undo .
     6917     define buffer buf_marking-lines for ub.marking-lines .
     6918     define buffer del_marking-lines for ub.marking-lines .
     6919     define buffer free_marking-lines for ub.marking-lines .
     6920     define buffer buf_marking for ub.marking .
     6921     define buffer buf_marking-chk for ub.marking-chk .
     6922     define buffer buf_chk-doc for ub.chk-doc .
     6923     define variable part-key-rec as character no-undo .
     6924     define variable part-key-rec_arhive   as character no-undo .
     6925     define buffer buf1_gen-attr for ub.gen-attr .
     6926     do
     6927     on error undo, return error return-value
     6928     :
     6929       find first buf_trn-doc no-lock
     6930         where buf_trn-doc.doc-code = p-doc-code
     6931         no-error .
     6932       if not available buf_trn-doc
     6933       then do:
     6934         message
     6935           vss-workfile vss-revision vss-description skip
     6936           vss-include-info28 skip
     6937           "Ошибка задания входных параметров" skip
     6938           "Не найден документ" skip
     6939           "Документ" p-doc-code skip
     6940           "Объект" p-obj-type p-obj-code skip
     6941           "Артикул" p-artic p-prod-type p-prod-code skip
     6942           error-status :get-message(1) skip
     6943           return-value skip
     6944           view-as alert-box error .
     6945         undo, return error .
     6946       end.
     6947       if buf_trn-doc.ext-doc-type = 'vt':U
     6948       then do :
     6949           delete object v-tth no-error.
     6950           run adm/shattri.p (
     6951              input "get":U
     6952             ,input buf_trn-doc.obj-type
     6953             ,input buf_trn-doc.obj-code
     6954             ,input 'inv-obj':U
     6955             ,input  "izlcstpr"
     6956             ,output v-value-character
     6957             ,output v-value-date
     6958             ,output v-value-decimal
     6959             ,output v-value-integer
     6960             ,output v-izlcstpr
     6961             ,output v-type
     6962             ,INPUT-OUTPUT table-handle v-tth
     6963             ) no-error .
     6964             delete object v-tth no-error.
     6965           if error-status:error then do:
     6966             v-izlcstpr = false .
     6967           end.
     6968       end.
     6969       else do :
     6970           v-izlcstpr = false .
     6971       end.
     6972   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6974     (input  p-artic
     6975     ,input  p-prod-type
     6976     ,input  p-prod-code
     6977     ,input  'twounit=request':u
     6978     ,output v-goods-twounit
     6979     ) no-error .
     6980       if error-status :error
     6981       then do:
     6982         message
     6983           vss-workfile vss-revision vss-description skip
     6984           vss-include-info28 skip
     6985           "Ошибка при определении атрибута товара" skip
     6986           "Артикул" p-artic p-prod-type p-prod-code skip
     6987           error-status :get-message(1) skip
     6988           return-value skip
     6989           view-as alert-box error .
     6990         undo, return error .
     6991       end.
     6992       define variable v-gds-code as integer   no-undo .
     6993   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6995     (input  p-artic
     6996     ,input  p-prod-type
     6997     ,input  p-prod-code
     6998     ,output v-gds-code
     6999     ) no-error .
     7000       for each archive_parts
     7001         where archive_parts.obj-type  = p-obj-type
     7002           and archive_parts.obj-code  = p-obj-code
     7003           and archive_parts.artic     = p-artic
     7004           and archive_parts.prod-type = p-prod-type
     7005           and archive_parts.prod-code = p-prod-code
     7006           and archive_parts.out-code  = p-doc-code
     7007       on error undo, return error return-value
     7008       :
     7009         if archive_parts.fact-qnty <> 0
     7010         then do:
     7011           define variable v-create-part as logical   no-undo .
     7012           define variable v-old-return  as logical   no-undo .
     7013           assign
     7014             v-create-part = false
     7015             v-old-return  = false
     7016           .
     7017           if archive_parts.in-code = buf_trn-doc.doc-code
     7018           then do:
     7019             assign
     7020               v-create-part = true
     7021             .
     7022             if archive_parts.supp-type <>
     7023           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     7024             or archive_parts.supp-code <>
     7025           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     7026             then do:
     7027               assign
     7028                 v-old-return = true
     7029               .
     7030             end.
     7031           end.
     7032           define variable v-is-hold as logical   no-undo .
     7033   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     7035     (input  buf_trn-doc.doc-code
     7036     ,output v-is-hold
     7037     ) no-error .
     7038           if error-status :error
     7039           then do:
     7040             message
     7041               vss-workfile vss-revision vss-description skip
     7042               vss-include-info28
     7043               "Ошибка при определении типа документа hold-doc.i" skip
     7044               "Документ" p-doc-code skip
     7045               "Объект" p-obj-type p-obj-code skip
     7046               "Артикул" p-artic p-prod-type p-prod-code skip
     7047               error-status :get-message(1) skip
     7048               return-value skip
     7049               view-as alert-box error .
     7050             undo, return error .
     7051           end.
     7052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
     7053     (input  buf_trn-doc.ext-doc-type
     7054     ,input  v-is-hold
     7055     ,input  archive_parts.fact-qnty
