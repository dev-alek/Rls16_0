     2173               assign
     2174                 varprice-sale = 0
     2175                 varroad-tax   = 0
     2176                 varexcise     = 0
     2177               .
     2178             end.
     2179             assign
     2180               varlastcur-base     = varprice-sale
     2181               varlastcur-road-tax = varroad-tax
     2182               varlastcur-excise   = varexcise
     2183               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2184               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2185               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2186               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2187             .
     2188         end.
     2189       end.
     2190       if varcur-fact-qnty = 0 then do:
     2191         assign
     2192           varcur-base      = varlastcur-base
     2193           varcur-road-tax  = varlastcur-road-tax
     2194           varcur-excise    = varlastcur-excise
     2195         .
     2196       end.
     2197       else do:
     2198         assign
     2199           varcur-base      = varcur-base      / varcur-fact-qnty
     2200           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2201           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2202         .
     2203       end.
