     8415   function diff-list returns character (
     8416     input parfirst-list  as character,
     8417     input parsecond-list as character,
     8418     input pardelim       as character).
     8419     if pardelim = ""
     8420     or pardelim = ?
     8421     then do:
     8422       assign
     8423         pardelim = ","
     8424       .
     8425     end.
     8426     def var ind as integer no-undo .
     8427     def var v-elem as character no-undo .
     8428     def var v-result-list as character no-undo init "".
     8429     def var v-num-parfirst-list as integer no-undo .
     8430     assign
     8431       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     8432     .
     8433     do ind = 1 to v-num-parfirst-list
     8434     :
     8435       assign
     8436         v-elem = entry(ind, parfirst-list, pardelim)
     8437       .
     8438       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     8439         assign
     8440           v-result-list = v-result-list
     8441                         + (if v-result-list > "" then pardelim else "")
     8442                         + v-elem
     8443         .
     8444       end.
     8445     end.
     8446     return v-result-list .
     8447   end function.
     8448   define temp-table temp-parts no-undo
