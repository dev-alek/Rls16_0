        1   block-level on error undo, throw.
        2   define input parameter p-table-version like ub.place-imp.table-version no-undo .
        3   define input parameter p-tank-code like ub.place-imp.pl-code no-undo .
        4   define input parameter p-status-date like ub.place-imp.corr-date no-undo .
        5   define input parameter p-status-time like ub.place-imp.corr-time no-undo .
        6   define input parameter p-status_ like ub.place-imp.status_ no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision:$":U .
        8   define variable vss-author      as character no-undo init "$Author:$":U .
        9   define variable vss-date        as character no-undo init "$Date:$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       11   define variable vss-archive     as character no-undo init "$Archive:$":U .
       12   define variable vss-description as character no-undo init "".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable expData as memptr no-undo .
       68   define variable log-file-name as character no-undo initial "status-cal-tbl.log" .
       69   define variable v-pid as int64 no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   run create-esys-data .
      300   run exp1C .
      301   procedure create-esys-data :
      302     define variable sw as handle no-undo.
      303     create sax-writer sw.
      304     sw:set-output-destination ("memptr", expData).
      305     sw:encoding = "UTF-8".
      306     sw:fragment = true .
      307     sw:formatted = true .
      308     sw:start-document () .
      309       sw:start-element ("status-cal-tbl") .
      310         sw:write-data-element ("table-version", string(p-table-version)).
      311         sw:write-data-element ("tank-code", string(p-tank-code)).
      312         sw:write-data-element ("status-date", iso-date(p-status-date)).
      313         sw:write-data-element ("status-time", string (p-status-time, "HH:MM:SS")).
      314         sw:write-data-element ("status", string(p-status_)).
      315       sw:end-element ("status-cal-tbl") .
      316     sw:end-document () .
      317   end procedure .
      318   procedure exp1C :
      319     run str/send1C-some-data.p (input ?,
      320                                 input this-procedure,
      321                                 input this-procedure,
      322                                 input expData,
      323                                 input "status-cal-tbls")
      324                                 no-error .
      325     if error-status:error
      326     then do :
      327       run write-to-log( "Ошибка при отправке в 1С. " + return-value ).
      328     end .
      329   end procedure .
      330   procedure write-to-log :
      331     define input param p-str as character no-undo .
      332     assign
      333       p-str = substitute( "&3&1&3&2&3", cur-time-string(), p-str, chr(10) )
      334     .
      335     output to value(log-file-name) append .
      336     put unformatted p-str .
      337     output close .
      338   end procedure .
      339   procedure write-log-and-file :
      340     define input parameter p-tab-position   as integer   no-undo.
      341     define input parameter p-file-name      as character no-undo .
      342     define input parameter p-log-level      as integer   no-undo .
      343     define input parameter p-log-string     AS CHARacter NO-UNDO.
      344     define variable v-jj as integer   no-undo .
      345     run write-to-log (input p-log-string) .
      346   end procedure .
