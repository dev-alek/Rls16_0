     1252   field slt-base-acc       like ub.doc-line.price-base
     1253   field slt-rubl-acc       like ub.doc-line.price-base
     1254   field slt-cli-acc        like ub.doc-line.price-cli
     1255   field road-tax-base-acc  like ub.doc-line.price-base
     1256   field road-tax-rubl-acc  like ub.doc-line.price-base
     1257   field road-tax-cli-acc   like ub.doc-line.price-cli
     1258   field excise-base-acc    like ub.doc-line.price-base
     1259   field excise-rubl-acc    like ub.doc-line.price-base
     1260   field excise-cli-acc     like ub.doc-line.price-cli
     1261   field transport-base-acc like ub.doc-line.price-base
     1262   field transport-rubl-acc like ub.doc-line.price-base
     1263   field transport-cli-acc  like ub.doc-line.price-cli
     1264   field other-base-acc     like ub.doc-line.price-base
     1265   field other-rubl-acc     like ub.doc-line.price-base
     1266   field other-cli-acc      like ub.doc-line.price-cli
     1267   field sum-dsc-base-cur   like ub.doc-line.price-base
     1268   field sum-dsc-rubl-cur   like ub.doc-line.price-base
     1269   field dsc-base-cur       like ub.doc-line.price-base
     1270   field dsc-rubl-cur       like ub.doc-line.price-base
     1271   field vat-base-cur       like ub.doc-line.price-base
     1272   field vat-rubl-cur       like ub.doc-line.price-base
     1273   field vat-base-buyer-cur like ub.doc-line.price-base
     1274   field vat-rubl-buyer-cur like ub.doc-line.price-base
     1275   field slt-base-cur       like ub.doc-line.price-base
     1276   field slt-rubl-cur       like ub.doc-line.price-base
     1277   field road-tax-base-cur  like ub.doc-line.price-base
     1278   field road-tax-rubl-cur  like ub.doc-line.price-base
     1279   field excise-base-cur    like ub.doc-line.price-base
     1280   field excise-rubl-cur    like ub.doc-line.price-base
     1281   index sum-type is primary unique sum-type.
     1282   .
     1283   define temp-table tt-allsum no-undo
