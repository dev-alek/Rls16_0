     2671   procedure clcprtsl_calc-line :
     2672   define input  parameter parrec-line as recid no-undo.
     2673   define variable v-tax-date         as   date                     no-undo.
     2674   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2675   define variable varr-b             as   character                no-undo.
     2676   define variable varr-btype         as   character                no-undo.
     2677   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2678   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2679   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2680   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2681   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2682   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2683   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2684   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2685   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2686   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2687   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2688   define variable varexcise          like ub.price-list.excise     no-undo.
     2689   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2690   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2691   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2692   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2693   define variable v-varsum           as decimal                  no-undo.
     2694   define variable varprice-salef as decimal   no-undo .
     2695   define buffer bf_trn-doc             for ub.trn-doc.
     2696   define buffer bf_doc-line            for ub.doc-line.
     2697   define buffer bf_gds-dtl             for ub.gds-dtl.
     2698   define buffer bf_goods               for ub.goods.
     2699   define buffer bf_parts               for ub.parts.
     2700   define buffer bf_sysconf             for ub.sysconf.
     2701   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2702   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2703   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2704   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2705   define buffer buf_parts        for ub.parts.
     2706   v-calcbypart = no.
     2707   do on error undo, return error return-value :
     2708   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2710     (output varr-b
     2711     )  .
     2712     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2713     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2714     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2715                               bf_goods.prod-type = bf_doc-line.prod-type and
     2716                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2717     if bf_trn-doc.fact-date <> ?        then do:
     2718       assign v-tax-date = bf_trn-doc.fact-date.
     2719     end.
     2720     else do:
     2721       assign v-tax-date = ?.
     2722     end.
     2723   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2725     (input  bf_goods.gds-code
     2726     ,input  '1':U
     2727     ,input  v-tax-date
     2728     ,input  bf_trn-doc.host-code
     2729     ,input  bf_trn-doc.obj-type
     2730     ,input  bf_trn-doc.obj-code
     2731     ,output v-vat-pc
     2732     ) no-error .
     2733     if error-status :error
     2734     or v-vat-pc = ? then do:
     2735        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2736     end.
     2737     if bf_goods.gds-type = 'у':U or
     2738        bf_trn-doc.status_ = 'запрос':U then do:
     2739       for each bf_tt-allsum-line
     2740       on error undo, return error return-value
     2741        :
     2742         delete bf_tt-allsum-line.
     2743       end.
     2744       create bf_tt-allsum-line.
     2745       assign
     2746        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2747       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2748                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2749                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2750                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2751         assign
     2752           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2753           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2754           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2755           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2756           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2757           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2758           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2759           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2760           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2761           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2762           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2763           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2764           bf_tt-allsum-line.vat-cli-acc          =  ?
     2765           .
     2766       end.
     2767       assign
     2768         bf_tt-allsum-line.cli-qnty             =  ?
     2769         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2770         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2771         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2772         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2773         bf_tt-allsum-line.road-tax-base-doc    =  0
     2774         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2775         bf_tt-allsum-line.excise-base-doc      =  0
     2776         bf_tt-allsum-line.excise-rubl-doc      =  0
     2777         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2778         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2779         bf_tt-allsum-line.dsc-base-cur         =  0
     2780         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2781         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2782         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2783         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2784         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2785         bf_tt-allsum-line.road-tax-base-cur    =  0
     2786         bf_tt-allsum-line.road-tax-rubl-cur    =  0
