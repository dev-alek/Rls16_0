     2936       end.
     2937       if varcur-slt-pc = ?
     2938       then do:
     2939         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2940       end.
     2941       v-calcbypart = no.
     2942       if bf_doc-line.whole-send-news = integer('1':U)   then
     2943       v-calcbypart = yes.
     2944       else do:
     2945       for each bf_gds-dtl no-lock
