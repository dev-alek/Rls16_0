        1   block-level on error undo, throw.
        2   define input parameter v-doc-code like ub.trn-doc.doc-code no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: clcsumga.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: str/clcsumga.p $":U .
        8   define variable vss-description as character no-undo initial "Пересчет основных сумм":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1':U,v-doc-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206     end.
      207   end procedure.
      208      procedure waitfram-show-this:
      209         define input  parameter iInterval as int64 no-undo.
      210         define variable vtime as int64 no-undo.
      211         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      212         mWaitFramInterval = iInterval.
      213         run waitfram-show (substitute("&1&2 &3&4" ,
      214                                       mWaitFramTextBeg ,
      215                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      216                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      217                                       mWaitFramTextEnd
      218                                      )
      219                           ).
      220      end.
      221      procedure WaitFramRunPause:
      222         define input  parameter iInterval as dec no-undo.
      223         define variable vStart  as datetime-tz no-undo.
      224         define variable vend    as datetime-tz no-undo.
      225         define variable vint as int64 no-undo.
      226         define variable vOk as logical no-undo.
      227         vStart = now.
      228         vend   = vStart.
      229         publish "WaitFramPause" (iInterval,output vOk).
      230         vend   =  now.
      231         vint = vend - vStart.
      232         vint = iInterval - vint / 1000.
      233         if     not mWaitFramStop
      234            and (   vint > 0
      235                 or (    not vOk
      236                     and iInterval eq ?
      237                     )
      238                 )
      239         then
      240            run waitfram-show-this (iInterval).
      241         vend   =  now.
      242         vint = vend - vStart.
      243         vint = iInterval - vint / 1000.
      244         if     not mWaitFramStop
      245            and vint > 0
      246         then do:
      247            run gbl/pause.p (vint * 1000).
      248         end.
      249         if iInterval ne ?
      250         then
      251            publish "WaitFramStop".
      252         waitfram-check-timeout().
      253      end.
      254      procedure WaitFramWaitFor:
      255         define input  parameter iInterval as dec no-undo.
      256         assign
      257            mWaitFramStartProc   = now
      258            mWaitFramStopUser    = no
      259            mWaitFramStopTimeOut = no
      260         .
      261         block-wait:
      262         do while not mWaitFramStop:
      263            run WaitFramRunPause (iInterval).
      264            if  waitfram-check-timeout()
      265            then do:
      266               leave block-wait.
      267            end.
      268         end.
      269         run waitfram-hide.
      270      end.
      271   procedure waitfram-join :
      272     define input  parameter p-line-1  as character no-undo .
      273     define input  parameter p-line-2  as character no-undo .
      274     define input  parameter p-line-3  as character no-undo .
      275     define output parameter p-message as character no-undo .
      276     do
      277     on error undo, return error return-value
      278     :
      279       assign
      280         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      281                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      282                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      283       .
      284     end.
      285   end procedure.
      286   function waitfram-join-function returns character
      287     (input p-line-1 as character
      288     ,input p-line-2 as character
      289     ,input p-line-3 as character
      290     ).
      291     define variable v-message as character no-undo .
      292     run waitfram-join in this-procedure
      293       (input  p-line-1
      294       ,input  p-line-2
      295       ,input  p-line-3
      296       ,output v-message
      297       ) .
      298     return v-message .
      299   end function .
      300   define new global shared variable g#language as character no-undo .
      301   if g#language <> '' and g#language <> 'rus':U then do:
      302     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      303   end.
      304   function diff-list returns character (
      305     input parfirst-list  as character,
      306     input parsecond-list as character,
      307     input pardelim       as character).
      308     if pardelim = ""
      309     or pardelim = ?
      310     then do:
      311       assign
      312         pardelim = ","
      313       .
      314     end.
      315     def var ind as integer no-undo .
      316     def var v-elem as character no-undo .
      317     def var v-result-list as character no-undo init "".
      318     def var v-num-parfirst-list as integer no-undo .
      319     assign
      320       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      321     .
      322     do ind = 1 to v-num-parfirst-list
      323     :
      324       assign
      325         v-elem = entry(ind, parfirst-list, pardelim)
      326       .
      327       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      328         assign
      329           v-result-list = v-result-list
      330                         + (if v-result-list > "" then pardelim else "")
      331                         + v-elem
      332         .
      333       end.
      334     end.
      335     return v-result-list .
      336   end function.
      337   function add-list returns character (
      338    input parfirst-list  as character,
      339    input parsecond-list as character,
      340    input pardelim       as character).
      341     if pardelim = ""
      342     or pardelim = ?
      343     then do:
      344       assign
      345         pardelim = ","
      346       .
      347     end.
      348     def var ind as integer no-undo .
      349     def var v-elem as character no-undo .
      350     def var v-result-list as character no-undo init "".
      351     def var v-num-parfirst-list as integer no-undo .
      352     assign
      353       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      354     .
      355     do ind = 1 to v-num-parfirst-list
      356     :
      357       assign
      358         v-elem = entry(ind, parfirst-list, pardelim)
      359       .
      360       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      361         assign
      362           v-result-list = v-result-list
      363                         + (if v-result-list > "" then pardelim else "")
      364                         + v-elem
      365         .
      366       end.
      367     end.
      368     def var v-num-parsecond-list as integer no-undo .
      369     assign
      370       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      371     .
      372     do ind = 1 to v-num-parsecond-list
      373     :
      374       assign
      375         v-elem = entry(ind, parsecond-list, pardelim)
      376       .
      377       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      378         assign
      379           v-result-list = v-result-list
      380                         + (if v-result-list > "" then pardelim else "")
      381                         + v-elem
      382         .
      383       end.
      384     end.
      385     return v-result-list .
      386   end function.
      387   function cross-list returns character (
      388    input parfirst-list  as character,
      389    input parsecond-list as character,
      390    input pardelim       as character).
      391     if pardelim = ""
      392     or pardelim = ?
      393     then do:
      394       assign
      395         pardelim = ","
      396       .
      397     end.
      398     def var ind as integer no-undo .
      399     def var v-elem as character no-undo .
      400     def var v-result-list as character no-undo init "".
      401     def var v-num-parfirst-list as integer no-undo .
      402     assign
      403       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      404     .
      405     do ind = 1 to v-num-parfirst-list
      406     :
      407       assign
      408         v-elem = entry(ind, parfirst-list, pardelim)
      409       .
      410       if lookup(v-elem, v-result-list, pardelim) = 0
      411       and lookup(v-elem, parsecond-list, pardelim) > 0
      412       then do:
      413         assign
      414           v-result-list = v-result-list
      415                         + (if v-result-list > "" then pardelim else "")
      416                         + v-elem
      417         .
      418       end.
      419     end.
      420     return v-result-list .
      421   end function.
      422   function radio-label returns character (
      423    input par-rs-value  as character,
      424    input par-rs-radio-buttons as character)
      425    .
      426    DEFINE variable v-result-label as character no-undo.
      427    assign
      428    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      429                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      430                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      431                             ), par-rs-radio-buttons
      432                           )
      433    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      434    .
      435   return v-result-label.
      436   end function.
      437   function m-radio-label returns character (
      438    input par-rs-value  as character,
      439    input par-rs-radio-buttons as character,
      440    input par-delim as character
      441    )
      442    .
      443    DEFINE variable v-result-label as character no-undo.
      444    assign
      445    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      446                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      447                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      448                             ), par-rs-radio-buttons, par-delim
      449                           )
      450    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      451    .
      452   return v-result-label.
      453   end function.
      454   FUNCTION mixlist returns character
      455   (
      456    input parfirst-list  as character
      457    ,input parsecond-list as character
      458    ,input pardelim       as character
      459    ,input pardelim-result as character ) :
      460     if pardelim = ""
      461     or pardelim = ?
      462     then do:
      463       assign
      464         pardelim = ","
      465       .
      466     end.
      467     def var ind as integer no-undo .
      468     def var v-elem1 as character no-undo .
      469     def var v-elem2 as character no-undo .
      470     def var v-result-list as character no-undo init "".
      471     do ind = 1 to num-entries(parfirst-list, pardelim)
      472     :
      473       assign
      474         v-elem1 = entry(ind, parfirst-list, pardelim)
      475         v-elem2 = entry(ind, parsecond-list, pardelim)
      476       .
      477         assign
      478           v-result-list = v-result-list
      479                         + (if v-result-list > "" then pardelim-result else "")
      480                         + v-elem1 + pardelim-result + v-elem2
      481         .
      482     end.
      483     return v-result-list .
      484   END FUNCTION.
      485   define new global shared variable g#library  as handle no-undo .
      486   define new global shared variable g#library2 as handle no-undo .
      487   define new global shared variable g#lib-trn  as handle no-undo .
      488   define new global shared variable g#lib-trn2 as handle no-undo .
      489   define new global shared variable g#lib-trn3 as handle no-undo .
      490   define new global shared variable g#lib-trn4 as handle no-undo .
      491   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      493   procedure partslib-clear-temp-parts :
      494     define buffer buf_temp-parts for temp-parts .
      495     do
      496     on error undo, return error
      497     :
      498       for each buf_temp-parts
      499       on error undo, return error
      500       :
      501         delete buf_temp-parts .
      502       end.
      503     end.
      504   end procedure.
      505   procedure partslib-create-temp-parts :
      506     define parameter buffer buf_parts       for ub.parts .
      507     define parameter buffer buf_temp-parts  for temp-parts .
      508     define input  parameter p-goods-twounit as logical   no-undo .
      509     define variable v-base-part-code as character no-undo .
      510     do
      511     on error undo, return error
      512     :
      513       if p-goods-twounit = true
      514       then do:
      515         assign
      516           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      517         .
      518       end.
      519       else do:
      520         assign
      521           v-base-part-code = buf_parts.part-code
      522         .
      523       end.
      524       find first buf_temp-parts exclusive-lock
      525         where buf_temp-parts.obj-type  = buf_parts.obj-type
      526           and buf_temp-parts.obj-code  = buf_parts.obj-code
      527           and buf_temp-parts.artic     = buf_parts.artic
      528           and buf_temp-parts.prod-type = buf_parts.prod-type
      529           and buf_temp-parts.prod-code = buf_parts.prod-code
      530           and buf_temp-parts.in-code   = buf_parts.in-code
      531           and buf_temp-parts.out-code  = 'free-zone':U
      532           and buf_temp-parts.part-code = v-base-part-code
      533         no-error.
      534       if not available buf_temp-parts
      535       then do:
      536         create buf_temp-parts .
      537         buffer-copy buf_parts to buf_temp-parts
      538         assign
      539           buf_temp-parts.out-code  = 'free-zone':U
      540           buf_temp-parts.part-code = v-base-part-code
      541           buf_temp-parts.rsrv-free = yes
      542           buf_temp-parts.status_   = no
      543           buf_temp-parts.qnty      = 0
      544           buf_temp-parts.fact-qnty = 0
      545           buf_temp-parts.real-qnty = 0
      546           buf_temp-parts.cli-qnty  = 0
      547         .
      548       end.
      549     end.
      550   end procedure.
      551   procedure partslib-init-temp-parts :
      552     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      553     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      554     define input parameter p-artic           like ub.parts.artic     no-undo .
      555     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      556     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      557     define buffer buf_parts      for ub.parts .
      558     define buffer buf_temp-parts for temp-parts .
      559     define variable v-goods-twounit    as logical   no-undo .
      560     do
      561     on error undo, return error
      562     :
      563   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      565     (input  p-artic
      566     ,input  p-prod-type
      567     ,input  p-prod-code
      568     ,input  'twounit=request':u
      569     ,output v-goods-twounit
      570     ) no-error .
      571       if error-status :error
      572       then do:
      573         message
      574           vss-workfile vss-revision vss-description skip
      575           vss-include-info1 skip
      576           "Ошибка при определении атрибута товара" skip
      577           "Артикул" p-artic p-prod-type p-prod-code skip
      578           "twounit=request" skip
      579           error-status :get-message(1) skip
      580           return-value skip
      581           view-as alert-box error .
      582         undo, return error return-value .
      583       end.
      584       run partslib-clear-temp-parts in this-procedure .
      585       for each buf_parts
      586         where buf_parts.obj-type  = p-obj-type
      587           and buf_parts.obj-code  = p-obj-code
      588           and buf_parts.artic     = p-artic
      589           and buf_parts.prod-type = p-prod-type
      590           and buf_parts.prod-code = p-prod-code
      591           and buf_parts.rsrv-free = yes
      592           and buf_parts.status_   = no
      593           and buf_parts.in-code   <> buf_parts.out-code
      594       on error undo, return error
      595       :
      596         run partslib-create-temp-parts in this-procedure
      597           (buffer buf_parts
      598           ,buffer buf_temp-parts
      599           ,input  v-goods-twounit
      600           ) .
      601         define variable v-parts-qnty          as decimal   no-undo .
      602         define variable v-parts-cli-qnty      as decimal   no-undo .
      603         define variable v-parts-free-qnty     as decimal   no-undo .
      604         define variable v-parts-free-cli-qnty as decimal   no-undo .
      605         if buf_parts.out-code = 'free-zone':U
      606         then do:
      607           assign
      608             v-parts-qnty          = buf_parts.qnty
      609             v-parts-cli-qnty      = buf_parts.cli-qnty
      610             v-parts-free-qnty     = buf_parts.qnty
      611             v-parts-free-cli-qnty = buf_parts.cli-qnty
      612           .
      613         end.
      614         else do:
      615           assign
      616             v-parts-qnty          = abs(buf_parts.qnty)
      617             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      618             v-parts-free-qnty     = 0
      619             v-parts-free-cli-qnty = 0
      620           .
      621         end.
      622         assign
      623           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      624           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      625           buf_temp-parts.real-qnty     = 0
      626           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      627           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      628           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      629         .
      630       end.
      631     end.
      632   end procedure.
      633   procedure partslib-init-temp-parts-by-factord :
      634     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      635     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      636     define input parameter p-artic              like ub.parts.artic     no-undo .
      637     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      638     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      639     define input parameter p-fact-order         as decimal   no-undo .
      640     define input parameter p-include-fact-order as logical   no-undo .
      641     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      642     define buffer buf_gds-obj  for ub.gds-obj .
      643     do
      644     on error undo, return error
      645     :
      646       do transaction
      647       on error undo, return error
      648       :
      649   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      651     (input  p-obj-type
      652     ,input  p-obj-code
      653     ,input  p-artic
      654     ,input  p-prod-type
      655     ,input  p-prod-code
      656     ,buffer buf_gds-obj
      657     ) no-error .
      658         if error-status :error
      659         then do:
      660           message
      661             vss-workfile vss-revision vss-description skip
      662             vss-include-info1 skip
      663             "Невозможно найти товар на объекте" skip
      664             "Объект" p-obj-type p-obj-code skip
      665             "Артикул" p-artic p-prod-type p-prod-code skip
      666             error-status :get-message(1) skip
      667             return-value skip
      668             view-as alert-box error .
      669           undo, return error .
      670         end.
      671         find current buf_gds-obj exclusive-lock .
      672       end.
      673       run partslib-init-temp-parts in this-procedure
      674         (input p-obj-type
      675         ,input p-obj-code
      676         ,input p-artic
      677         ,input p-prod-type
      678         ,input p-prod-code
      679         ) no-error .
      680       if error-status :error
      681       then do:
      682         message
      683           vss-workfile vss-revision vss-description skip
      684           vss-include-info1 skip
      685           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      686           "Объект" p-obj-type p-obj-code skip
      687           "Артикул" p-artic p-prod-type p-prod-code skip
      688           "p-fact-order" p-fact-order skip
      689           view-as alert-box error .
      690         undo, return error .
      691       end.
      692       if p-include-fact-order = true
      693       then do:
      694         assign
      695           p-fact-order = p-fact-order - 0.0000000001
      696         .
      697       end.
      698       define variable v-max-fact-order as character no-undo .
      699       run factord-max-fact-order in this-procedure
      700         (output v-max-fact-order
      701         ) no-error .
      702       if error-status :error
      703       then do:
      704         message
      705           vss-workfile vss-revision vss-description skip
      706           vss-include-info1 skip
      707           "Ошибка при вызове процедуры factord-max-fact-order" skip
      708           "Объект" p-obj-type p-obj-code skip
      709           "Артикул" p-artic p-prod-type p-prod-code skip
      710           "p-fact-order" p-fact-order skip
      711           view-as alert-box error .
      712         undo, return error .
      713       end.
      714       run partslib-update-by-factord in this-procedure
      715         (input p-obj-type
      716         ,input p-obj-code
      717         ,input p-artic
      718         ,input p-prod-type
      719         ,input p-prod-code
      720         ,input p-fact-order
      721         ,input v-max-fact-order
      722         ,input false
      723         ) no-error .
      724       if error-status :error
      725       then do:
      726         message
      727           vss-workfile vss-revision vss-description skip
      728           vss-include-info1 skip
      729           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      730           "Объект" p-obj-type p-obj-code skip
      731           "Артикул" p-artic p-prod-type p-prod-code skip
      732           "p-fact-order" p-fact-order skip
      733           "v-max-fact-order" v-max-fact-order skip
      734           view-as alert-box error .
      735         undo, return error .
      736       end.
      737     end.
      738   end procedure.
      739   procedure partslib-update-by-factord :
      740     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      741     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      742     define input parameter p-artic              like ub.parts.artic     no-undo .
      743     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      744     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      745     define input parameter p-start-fact-order   as decimal   no-undo .
      746     define input parameter p-end-fact-order     as decimal   no-undo .
      747     define input parameter p-lock-gds-obj       as logical   no-undo .
      748     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      749     define buffer buf_gds-obj  for ub.gds-obj .
      750     define buffer buf_doc-line for ub.doc-line .
      751     define variable v-total-parts-qnty as decimal   no-undo .
      752     define variable v-goods-gds-goods  as logical   no-undo .
      753     define variable v-goods-twounit    as logical   no-undo .
      754     do
      755     on error undo, return error
      756     :
      757       if p-start-fact-order > p-end-fact-order
      758       then do:
      759         message
      760           vss-workfile vss-revision vss-description skip
      761           vss-include-info1 skip
      762           "Ошибка задания входных параметров" skip
      763           "Начало интервала превышает конец интервала" skip
      764           "Объект" p-obj-type p-obj-code skip
      765           "Артикул" p-artic p-prod-type p-prod-code skip
      766           "p-start-fact-order" p-start-fact-order skip
      767           "p-end-fact-order"   p-end-fact-order skip
      768           view-as alert-box error .
      769         undo, return error .
      770       end.
      771       if p-lock-gds-obj = true
      772       then do:
      773         do transaction
      774         on error undo, return error
      775         :
      776   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      778     (input  p-obj-type
      779     ,input  p-obj-code
      780     ,input  p-artic
      781     ,input  p-prod-type
      782     ,input  p-prod-code
      783     ,buffer buf_gds-obj
      784     ) no-error .
      785           if error-status :error
      786           then do:
      787             message
      788               vss-workfile vss-revision vss-description skip
      789               vss-include-info1 skip
      790               "Невозможно найти gds-obj" skip
      791               error-status :get-message(1) skip
      792               return-value skip
      793               view-as alert-box error .
      794             undo, return error .
      795           end.
      796           find current buf_gds-obj exclusive-lock .
      797         end.
      798       end.
      799   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      801     (input  p-artic
      802     ,input  p-prod-type
      803     ,input  p-prod-code
      804     ,input  'gds-goods=request':u
      805     ,output v-goods-gds-goods
      806     ) no-error .
      807       if error-status :error
      808       then do:
      809         message
      810           vss-workfile vss-revision vss-description skip
      811           vss-include-info1 skip
      812           "Ошибка при определении атрибута товара" skip
      813           "Артикул" p-artic p-prod-type p-prod-code skip
      814           "gds-goods=request" skip
      815           error-status :get-message(1) skip
      816           return-value skip
      817           view-as alert-box error .
      818         undo, return error return-value .
      819       end.
      820   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      822     (input  p-artic
      823     ,input  p-prod-type
      824     ,input  p-prod-code
      825     ,input  'twounit=request':u
      826     ,output v-goods-twounit
      827     ) no-error .
      828       if error-status :error
      829       then do:
      830         message
      831           vss-workfile vss-revision vss-description skip
      832           vss-include-info1 skip
      833           "Ошибка при определении атрибута товара" skip
      834           "Артикул" p-artic p-prod-type p-prod-code skip
      835           "twounit=request" skip
      836           error-status :get-message(1) skip
      837           return-value skip
      838           view-as alert-box error .
      839         undo, return error return-value .
      840       end.
      841       for each buf_doc-line no-lock
      842         where buf_doc-line.obj-type   = p-obj-type
      843           and buf_doc-line.obj-code   = p-obj-code
      844           and buf_doc-line.artic      = p-artic
      845           and buf_doc-line.prod-type  = p-prod-type
      846           and buf_doc-line.prod-code  = p-prod-code
      847           and buf_doc-line.status_    = 'факт':U
      848           and buf_doc-line.fact-order > p-start-fact-order
      849           and buf_doc-line.fact-order <= p-end-fact-order
      850       on error undo, return error
      851       :
      852         run partslib-process-document in this-procedure
      853           (input  buf_doc-line.doc-code
      854           ,input  p-obj-type
      855           ,input  p-obj-code
      856           ,input  p-artic
      857           ,input  p-prod-type
      858           ,input  p-prod-code
      859           ,input  v-goods-gds-goods
      860           ,input  v-goods-twounit
      861           ,output v-total-parts-qnty
      862           ) no-error .
      863         if error-status :error
      864         then do:
      865           message
      866             vss-workfile vss-revision vss-description skip
      867             vss-include-info1 skip
      868             "Ошибка при вызове процедуры partslib-process-document" skip
      869             "Документ" buf_doc-line.doc-code skip
      870             "Объект" p-obj-type p-obj-code skip
      871             "Артикул" p-artic p-prod-type p-prod-code skip
      872             "p-start-fact-order" p-start-fact-order skip
      873             "p-end-fact-order" p-end-fact-order skip
      874             error-status :get-message(1) skip
      875             return-value skip
      876             view-as alert-box error .
      877           undo, return error return-value .
      878         end.
      879       end.
      880     end.
      881   end procedure.
      882   procedure partslib-process-document :
      883     define input  parameter p-doc-code         as character no-undo .
      884     define input  parameter p-obj-type         as character no-undo .
      885     define input  parameter p-obj-code         as integer   no-undo .
      886     define input  parameter p-artic            as character no-undo .
      887     define input  parameter p-prod-type        as character no-undo .
      888     define input  parameter p-prod-code        as integer   no-undo .
      889     define input  parameter p-goods-gds-goods  as logical   no-undo .
      890     define input  parameter p-goods-twounit    as logical   no-undo .
      891     define output parameter p-total-parts-qnty as decimal   no-undo .
      892     define variable v-parts-sign as integer   no-undo .
      893     define buffer buf_trn-doc    for ub.trn-doc .
      894     define buffer buf_doc-line   for ub.doc-line .
      895     define buffer buf_parts      for ub.parts .
      896     define buffer buf_temp-parts for temp-parts .
      897     do
      898     on error undo, return error return-value
      899     :
      900       find first buf_trn-doc no-lock
      901         where buf_trn-doc.doc-code = p-doc-code
      902         no-error .
      903       if not available buf_trn-doc
      904       then do:
      905         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      906                                      ,p-doc-code
      907                                      ) .
      908       end.
      909       case buf_trn-doc.doc-type
      910       :
      911         when 'при':U or
      912         when 'возврат':U or
      913         when 'инв':U
      914         then do:
      915           assign
      916             v-parts-sign = -1
      917           .
      918         end.
      919         when 'рас':U or
      920         when 'спи':U
      921         then do:
      922           assign
      923             v-parts-sign = 1
      924           .
      925         end.
      926         otherwise do:
      927           undo, return error substitute("Неизвестный тип документа &1"
      928                                       ,buf_trn-doc.doc-type
      929                                       ) .
      930         end.
      931       end.
      932       find first buf_doc-line no-lock
      933         where buf_doc-line.doc-code  = p-doc-code
      934           and buf_doc-line.artic     = p-artic
      935           and buf_doc-line.prod-type = p-prod-type
      936           and buf_doc-line.prod-code = p-prod-code
      937         no-error .
      938       if not available buf_doc-line
      939       then do:
      940         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      941                                      ,p-doc-code
      942                                      ,artic
      943                                      ,prod-type
      944                                      ,prod-code
      945                                      ) .
      946       end.
      947       assign
      948         p-total-parts-qnty = 0
      949       .
      950       if p-goods-gds-goods = true
      951       then do:
      952         for each buf_parts no-lock
      953           where buf_parts.out-code  = p-doc-code
      954             and buf_parts.obj-type  = p-obj-type
      955             and buf_parts.obj-code  = p-obj-code
      956             and buf_parts.artic     = p-artic
      957             and buf_parts.prod-type = p-prod-type
      958             and buf_parts.prod-code = p-prod-code
      959         on error undo, return error
      960         :
      961           run partslib-create-temp-parts in this-procedure
      962             (buffer buf_parts
      963             ,buffer buf_temp-parts
      964             ,input  p-goods-twounit
      965             ) .
      966           assign
      967             p-total-parts-qnty        = p-total-parts-qnty
      968                                       + v-parts-sign * buf_parts.fact-qnty
      969             buf_temp-parts.qnty       = buf_temp-parts.qnty
      970                                       + v-parts-sign * buf_parts.fact-qnty
      971             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      972                                       + v-parts-sign * buf_parts.fact-qnty
      973             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      974                                       + v-parts-sign * buf_parts.cli-qnty
      975           .
      976           if buf_temp-parts.qnty = 0
      977           then do:
      978             delete buf_temp-parts .
      979           end.
      980         end.
      981       end.
      982       else do:
      983         assign
      984           p-total-parts-qnty = p-total-parts-qnty
      985                              + v-parts-sign * buf_doc-line.fact-qnty
      986         .
      987       end.
      988     end.
      989   end procedure.
      990   procedure partslib-init-temp-parts-by-date :
      991     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      992     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      993     define input parameter p-artic           like ub.parts.artic     no-undo .
      994     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      995     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      996     define input parameter p-fact-date       as date      no-undo .
      997     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      998     do
      999     on error undo, return error
     1000     :
     1001       define variable v-fact-order                as decimal   no-undo .
     1002       define variable v-shift-end-fact-order      as decimal   no-undo .
     1003       define variable v-day-end-fact-order        as decimal   no-undo .
     1004       run factord in this-procedure
     1005         (input  p-fact-date
     1006         ,input  1
     1007         ,input  1
     1008         ,input  ?
     1009         ,input  0
     1010         ,input  false
     1011         ,output v-fact-order
     1012         ,output v-shift-end-fact-order
     1013         ,output v-day-end-fact-order
     1014         ) no-error .
     1015       if error-status :error
     1016       then do:
     1017         message
     1018           vss-workfile vss-revision vss-description skip
     1019           vss-include-info1 skip
     1020           "Ошибка при определении момента времени, на который требуется остаток" skip
     1021           "Объект" p-obj-type p-obj-code skip
     1022           "Артикул" p-artic p-prod-type p-prod-code skip
     1023           "Дата" p-fact-date skip
     1024           view-as alert-box error .
     1025         undo, return error .
     1026       end.
     1027       run partslib-init-temp-parts-by-factord in this-procedure
     1028         (input p-obj-type
     1029         ,input p-obj-code
     1030         ,input p-artic
     1031         ,input p-prod-type
     1032         ,input p-prod-code
     1033         ,input v-day-end-fact-order
     1034         ,input false
     1035         ) no-error .
     1036       if error-status :error
     1037       then do:
     1038         message
     1039           vss-workfile vss-revision vss-description skip
     1040           vss-include-info1 skip
     1041           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1042           "Объект" p-obj-type p-obj-code skip
     1043           "Артикул" p-artic p-prod-type p-prod-code skip
     1044           "Дата" p-fact-date skip
     1045           view-as alert-box error .
     1046         undo, return error .
     1047       end.
     1048     end.
     1049   end procedure.
     1050   procedure partslib-calc-cost :
     1051     define output parameter p-fact-qnty      as decimal   no-undo .
     1052     define output parameter p-vat-pc         as decimal   no-undo .
     1053     define output parameter p-slt-pc         as decimal   no-undo .
     1054     define output parameter p-sum-base       as decimal   no-undo .
     1055     define output parameter p-sum-rubl       as decimal   no-undo .
     1056     define output parameter p-vat-base       as decimal   no-undo .
     1057     define output parameter p-vat-rubl       as decimal   no-undo .
     1058     define output parameter p-slt-base       as decimal   no-undo .
     1059     define output parameter p-slt-rubl       as decimal   no-undo .
     1060     define output parameter p-road-tax-base  as decimal   no-undo .
     1061     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1062     define output parameter p-transport-base as decimal   no-undo .
     1063     define output parameter p-transport-rubl as decimal   no-undo .
     1064     define output parameter p-other-base     as decimal   no-undo .
     1065     define output parameter p-other-rubl     as decimal   no-undo .
     1066     define output parameter p-excise-base    as decimal   no-undo .
     1067     define output parameter p-excise-rubl    as decimal   no-undo .
     1068     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1069     do
     1070     on error undo, return error return-value
     1071     :
     1072       define buffer buf_temp-parts for temp-parts .
     1073       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1074       define buffer   in-vatp-parts    for ub.parts   .
     1075       define buffer   in-vatp-doc      for ub.trn-doc .
     1076       define buffer   in-vatp-goods    for ub.goods   .
     1077       define buffer   in-vatp-sysconf  for ub.sysconf .
     1078       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1079       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1080       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1081       define variable varinvprb                  as   character              no-undo.
     1082       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1083       define variable cli-base-rate              as   decimal                no-undo.
     1084       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1085       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1086       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1087       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1088       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1089       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1090       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1091       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1092       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1093       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1094       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1095       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1096       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1097       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1098       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1099       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1100       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1101       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1102       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1103       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1104       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1105       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1106       define variable varinvatp-envd             as   character              no-undo.
     1107       define variable varinvatp-type             as   character              no-undo.
     1108       for each buf_temp-parts
     1109       on error undo, return error
     1110       :
     1111   assign
     1112     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1113     price-base-with-tax-loc = buf_temp-parts.price-base
     1114   .
     1115   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1116   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1117     (output varinvprb
     1118     )  .
     1119     if buf_temp-parts.out-code = 'free-zone':U     or
     1120        buf_temp-parts.out-code = 'out-zone':U   or
     1121        buf_temp-parts.doc-type = 'акт':U then do:
     1122       assign
     1123         in-vatp-have-vat-slt = yes.
     1124     end.
     1125     else do:
     1126       find first in-vatp_doc-attr no-lock
     1127         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1128           and in-vatp_doc-attr.attr-code = 'envd':U
     1129         no-error .
     1130       if not available in-vatp_doc-attr then do:
     1131         assign
     1132           in-vatp-have-vat-slt = yes.
     1133       end.
     1134       else do:
     1135            in-vatp-have-vat-slt = no.
     1136       end.
     1137     end.
     1138     assign
     1139      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1140      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1141     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1142              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1143     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1144             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1145             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1146             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1147             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1148             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1149             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1150       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1151     assign
     1152       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1153     assign
     1154       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1155       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1156       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1157       transport-cli-loc  = 0
     1158       other-cli-loc      = 0
     1159     .
     1160   ASSIGN
     1161             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1162       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1163   .
     1164         assign
     1165           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1166           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1167           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1168           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1169           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1170           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1171           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1172           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1173           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1174           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1175           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1176           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1177           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1178           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1179           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1180           p-excise-base    = p-excise-base    + 0
     1181           p-excise-rubl    = p-excise-rubl    + 0
     1182         .
     1183       end.
     1184       if p-fact-qnty      = ?
     1185       or p-sum-base       = ?
     1186       or p-sum-rubl       = ?
     1187       or p-vat-base       = ?
     1188       or p-vat-rubl       = ?
     1189       or p-slt-base       = ?
     1190       or p-slt-rubl       = ?
     1191       or p-road-tax-base  = ?
     1192       or p-road-tax-rubl  = ?
     1193       or p-transport-base = ?
     1194       or p-transport-rubl = ?
     1195       or p-other-base     = ?
     1196       or p-other-rubl     = ?
     1197       or p-excise-base    = ?
     1198       or p-excise-rubl    = ?
     1199       then do:
     1200         message
     1201           vss-workfile vss-revision vss-description skip
     1202           vss-include-info1 skip
     1203           "Программа in-vatp.i вернула неопределенные значения" skip
     1204           "p-fact-qnty"      p-fact-qnty      skip
     1205           "p-sum-base"       p-sum-base       skip
     1206           "p-sum-rubl"       p-sum-rubl       skip
     1207           "p-vat-base"       p-vat-base       skip
     1208           "p-vat-rubl"       p-vat-rubl       skip
     1209           "p-slt-base"       p-slt-base       skip
     1210           "p-slt-rubl"       p-slt-rubl       skip
     1211           "p-road-tax-base"  p-road-tax-base  skip
     1212           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1213           "p-transport-base" p-transport-base skip
     1214           "p-transport-rubl" p-transport-rubl skip
     1215           "p-other-base"     p-other-base     skip
     1216           "p-other-rubl"     p-other-rubl     skip
     1217           "p-excise-base"    p-excise-base    skip
     1218           "p-excise-rubl"    p-excise-rubl    skip
     1219           view-as alert-box error .
     1220         undo, return error .
     1221       end.
     1222     end.
     1223   end procedure.
     1224   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   define temp-table tt-allsum-line      no-undo
     1226   field sum-type           as   character
     1227   field fact-qnty          like ub.doc-line.fact-qnty
     1228   field cli-qnty           like ub.doc-line.cli-qnty
     1229   field sum-dsc-base-doc   like ub.doc-line.price-base
     1230   field sum-dsc-rubl-doc   like ub.doc-line.price-base
