     1232   field dsc-rubl-doc       like ub.doc-line.price-base
     1233   field vat-base-doc       like ub.doc-line.price-base
     1234   field vat-rubl-doc       like ub.doc-line.price-base
     1235   field vat-base-buyer-doc like ub.doc-line.price-base
     1236   field vat-rubl-buyer-doc like ub.doc-line.price-base
