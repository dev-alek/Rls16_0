     1242   field excise-rubl-doc    like ub.doc-line.price-base
     1243   field sum-dsc-base-acc   like ub.doc-line.price-base
     1244   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     1245   field sum-dsc-cli-acc    like ub.doc-line.price-cli
