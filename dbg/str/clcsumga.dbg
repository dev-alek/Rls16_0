     2273     bf_tt-allsum.slt-rubl-cur       =  (if slt-rubl-salecur            = ? then 0 else slt-rubl-salecur            * cl_tt-clcparts.fact-qnty)
     2274     bf_tt-allsum.vat-base-buyer-cur =  (if vat-base-buyercur           = ? then 0 else vat-base-buyercur           * cl_tt-clcparts.fact-qnty)
     2275     bf_tt-allsum.vat-rubl-buyer-cur =  (if vat-rubl-buyercur           = ? then 0 else vat-rubl-buyercur           * cl_tt-clcparts.fact-qnty)
     2276     bf_tt-allsum.road-tax-base-cur  =  (if road-tax-base-salecur       = ? then 0 else road-tax-base-salecur       * cl_tt-clcparts.fact-qnty)
     2277     bf_tt-allsum.road-tax-rubl-cur  =  (if road-tax-rubl-salecur       = ? then 0 else road-tax-rubl-salecur       * cl_tt-clcparts.fact-qnty)
     2278     bf_tt-allsum.excise-base-cur    =  (if excise-base-salecur         = ? then 0 else excise-base-salecur         * cl_tt-clcparts.fact-qnty)
     2279     bf_tt-allsum.excise-rubl-cur    =  (if excise-rubl-salecur         = ? then 0 else excise-rubl-salecur         * cl_tt-clcparts.fact-qnty)
     2280     .
     2281   if cl_tt-clcparts.purch-code = integer('2':U) then do:
     2282     assign
     2283       bf_tt-allsum.vat-base-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecl  - road-tax-base-salecl  - slt-base-salecl  - (cl_tt-clcparts.price-base - cl_tt-clcparts.road-tax-base)) * parcons-vat-pc / (100 + parcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     2284       bf_tt-allsum.vat-rubl-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecl  - road-tax-rubl-salecl  - slt-rubl-salecl  - (cl_tt-clcparts.price-rubl - cl_tt-clcparts.road-tax-rubl)) * parcons-vat-pc / (100 + parcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     2285       bf_tt-allsum.vat-base-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecur - road-tax-base-salecur - slt-base-salecur - (cl_tt-clcparts.price-base - cl_tt-clcparts.road-tax-base)) * parcurcons-vat-pc / (100 + parcurcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     2286       bf_tt-allsum.vat-rubl-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecur - road-tax-rubl-salecur - slt-rubl-salecur - (cl_tt-clcparts.price-rubl - cl_tt-clcparts.road-tax-rubl)) * parcurcons-vat-pc / (100 + parcurcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     2287       .
     2288   end.
     2289   else do:
     2290     assign
     2291       bf_tt-allsum.vat-base-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecl  - road-tax-base-salecl  - slt-base-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     2292       bf_tt-allsum.vat-rubl-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecl  - road-tax-rubl-salecl  - slt-rubl-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     2293       bf_tt-allsum.vat-base-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecur - road-tax-base-salecur - slt-base-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     2294       bf_tt-allsum.vat-rubl-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecur - road-tax-rubl-salecur - slt-rubl-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     2295       .
     2296   end.
     2297   if bf_tt-allsum.vat-base-doc = ? then bf_tt-allsum.vat-base-doc = 0.
     2298   if bf_tt-allsum.vat-rubl-doc = ? then bf_tt-allsum.vat-rubl-doc = 0.
     2299   assign
     2300     bf_tt-allsum.sum-dsc-base-acc     = (if price-base-with-tax-loccl    = ? then 0 else price-base-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     2301     bf_tt-allsum.sum-dsc-rubl-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     2302     bf_tt-allsum.sum-dsc-cli-acc      = (if (price-cli-with-tax-loccl +
     2303                                              road-tax-cli-loccl       +
     2304                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2305                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2306                                              ) / cli-base-ratecl = ? then 0
     2307                                           else
     2308                                             (price-cli-with-tax-loccl +
     2309                                              road-tax-cli-loccl       +
     2310                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2311                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2312                                              ) / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     2313     bf_tt-allsum.dsc-base-acc         = 0
     2314     bf_tt-allsum.dsc-rubl-acc         = 0
     2315     bf_tt-allsum.dsc-cli-acc          = 0
     2316     bf_tt-allsum.vat-base-acc         = (if vat-base-loccl      = ? then 0 else vat-base-loccl      * cl_tt-clcparts.fact-qnty)
     2317     bf_tt-allsum.vat-rubl-acc         = (if vat-rubl-loccl      = ? then 0 else vat-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2318     bf_tt-allsum.vat-cli-acc          = (if vat-cli-loccl / cli-base-ratecl      = ? then 0 else vat-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     2319     bf_tt-allsum.slt-base-acc         = (if slt-base-loccl      = ? then 0 else slt-base-loccl      * cl_tt-clcparts.fact-qnty)
     2320     bf_tt-allsum.slt-rubl-acc         = (if slt-rubl-loccl      = ? then 0 else slt-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2321     bf_tt-allsum.slt-cli-acc          = (if slt-cli-loccl / cli-base-ratecl      = ? then 0 else slt-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     2322     bf_tt-allsum.road-tax-base-acc    = (if road-tax-base-loccl = ? then 0 else road-tax-base-loccl * cl_tt-clcparts.fact-qnty)
     2323     bf_tt-allsum.road-tax-rubl-acc    = (if road-tax-rubl-loccl = ? then 0 else road-tax-rubl-loccl * cl_tt-clcparts.fact-qnty)
     2324     bf_tt-allsum.road-tax-cli-acc     = (if road-tax-cli-loccl / cli-base-ratecl = ? then 0 else road-tax-cli-loccl / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     2325     bf_tt-allsum.excise-base-acc      = 0
     2326     bf_tt-allsum.excise-rubl-acc      = 0
     2327     bf_tt-allsum.excise-cli-acc       = 0
     2328     bf_tt-allsum.transport-base-acc   = (if transport-base-loccl   = ? then 0 else transport-base-loccl  * cl_tt-clcparts.fact-qnty)
     2329     bf_tt-allsum.transport-rubl-acc   = (if transport-rubl-loccl   = ? then 0 else transport-rubl-loccl  * cl_tt-clcparts.fact-qnty)
     2330     bf_tt-allsum.transport-cli-acc    = (if transport-cli-loccl / cli-base-ratecl   = ? then 0 else transport-cli-loccl / cli-base-ratecl  * cl_tt-clcparts.fact-qnty)
     2331     bf_tt-allsum.other-base-acc       = (if other-base-loccl       = ? then 0 else other-base-loccl      * cl_tt-clcparts.fact-qnty)
     2332     bf_tt-allsum.other-rubl-acc       = (if other-rubl-loccl       = ? then 0 else other-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2333     bf_tt-allsum.other-cli-acc        = (if other-cli-loccl / cli-base-ratecl       = ? then 0 else other-cli-loccl     / cli-base-ratecl  * cl_tt-clcparts.fact-qnty).
     2334   create bfs_tt-allsum.
     2335   assign
     2336     bfs_tt-allsum.sum-type = 'основная_сумма_со_знаком':U.
     2337   if pardoc-type = 'инв':U or
     2338      pardoc-type = 'при':U    or
     2339      pardoc-type = 'возврат':U    then do:
     2340      buffer-copy bf_tt-allsum except bf_tt-allsum.sum-type to bfs_tt-allsum.
     2341   end.
     2342   else do:
     2343     assign
     2344       bfs_tt-allsum.fact-qnty           =  - bf_tt-allsum.fact-qnty
     2345       bfs_tt-allsum.cli-qnty            =  - bf_tt-allsum.cli-qnty
     2346       bfs_tt-allsum.sum-dsc-base-doc    =  - bf_tt-allsum.sum-dsc-base-doc
     2347       bfs_tt-allsum.sum-dsc-rubl-doc    =  - bf_tt-allsum.sum-dsc-rubl-doc
     2348       bfs_tt-allsum.dsc-base-doc        =  - bf_tt-allsum.dsc-base-doc
     2349       bfs_tt-allsum.dsc-rubl-doc        =  - bf_tt-allsum.dsc-rubl-doc
     2350       bfs_tt-allsum.vat-base-doc        =  - bf_tt-allsum.vat-base-doc
     2351       bfs_tt-allsum.vat-rubl-doc        =  - bf_tt-allsum.vat-rubl-doc
     2352       bfs_tt-allsum.vat-base-buyer-doc  =  - bf_tt-allsum.vat-base-buyer-doc
     2353       bfs_tt-allsum.vat-rubl-buyer-doc  =  - bf_tt-allsum.vat-rubl-buyer-doc
     2354       bfs_tt-allsum.slt-base-doc        =  - bf_tt-allsum.slt-base-doc
     2355       bfs_tt-allsum.slt-rubl-doc        =  - bf_tt-allsum.slt-rubl-doc
     2356       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     2357       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     2358       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
     2359       bfs_tt-allsum.excise-rubl-doc     =  - bf_tt-allsum.excise-rubl-doc
     2360       bfs_tt-allsum.sum-dsc-base-cur    =  - bf_tt-allsum.sum-dsc-base-cur
     2361       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     2362       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     2363       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     2364       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     2365       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     2366       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     2367       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     2368       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     2369       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     2370       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     2371       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     2372       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     2373       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     2374       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     2375       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     2376       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     2377       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     2378       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     2379       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     2380       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     2381       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     2382       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     2383       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     2384       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     2385       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     2386       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     2387       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     2388       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     2389       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     2390       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     2391       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     2392       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     2393       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     2394       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     2395       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     2396       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     2397       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     2398   end.
     2399   create bfpc_tt-allsum.
     2400   create bfspc_tt-allsum.
     2401   case cl_tt-clcparts.purch-code :
     2402   when 1           then do:
     2403     assign
     2404       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     2405       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     2406     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2407     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2408   end.
     2409   when 4    then do:
     2410     assign
     2411       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     2412       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     2413     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2414     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2415   end.
     2416   when 3 then do:
     2417     assign
     2418       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     2419       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     2420     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2421     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2422   end.
     2423   when 2 then do:
     2424     assign
     2425       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     2426       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     2427     assign
     2428       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     2429       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     2430       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     2431       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     2432       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     2433       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     2434       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     2435       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     2436       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     2437       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     2438       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     2439       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     2440       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     2441       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     2442       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     2443       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
     2444       bfpc_tt-allsum.sum-dsc-base-cur    = bf_tt-allsum.sum-dsc-base-cur    - bf_tt-allsum.sum-dsc-base-acc
     2445       bfpc_tt-allsum.sum-dsc-rubl-cur    = bf_tt-allsum.sum-dsc-rubl-cur    - bf_tt-allsum.sum-dsc-rubl-acc
     2446       bfpc_tt-allsum.dsc-base-cur        = bf_tt-allsum.dsc-base-cur        - bf_tt-allsum.dsc-base-acc
     2447       bfpc_tt-allsum.dsc-rubl-cur        = bf_tt-allsum.dsc-rubl-cur        - bf_tt-allsum.dsc-rubl-acc
     2448       bfpc_tt-allsum.vat-base-cur        = bf_tt-allsum.vat-base-cur
     2449       bfpc_tt-allsum.vat-rubl-cur        = bf_tt-allsum.vat-rubl-cur
     2450       bfpc_tt-allsum.vat-base-buyer-cur  = bf_tt-allsum.vat-base-buyer-cur  - bf_tt-allsum.vat-base-acc
     2451       bfpc_tt-allsum.vat-rubl-buyer-cur  = bf_tt-allsum.vat-rubl-buyer-cur  - bf_tt-allsum.vat-rubl-acc
     2452       bfpc_tt-allsum.slt-base-cur        = bf_tt-allsum.slt-base-cur        - bf_tt-allsum.slt-base-acc
     2453       bfpc_tt-allsum.slt-rubl-cur        = bf_tt-allsum.slt-rubl-cur        - bf_tt-allsum.slt-rubl-acc
     2454       bfpc_tt-allsum.road-tax-base-cur   = bf_tt-allsum.road-tax-base-cur   - bf_tt-allsum.road-tax-base-acc
     2455       bfpc_tt-allsum.road-tax-rubl-cur   = bf_tt-allsum.road-tax-rubl-cur   - bf_tt-allsum.road-tax-rubl-acc
     2456       bfpc_tt-allsum.excise-base-cur     = bf_tt-allsum.excise-base-cur
     2457       bfpc_tt-allsum.excise-rubl-cur     = bf_tt-allsum.excise-rubl-cur
     2458       bfpc_tt-allsum.sum-dsc-base-acc    = 0
     2459       bfpc_tt-allsum.sum-dsc-rubl-acc    = 0
     2460       bfpc_tt-allsum.sum-dsc-cli-acc     = 0
     2461       bfpc_tt-allsum.dsc-base-acc        = 0
     2462       bfpc_tt-allsum.dsc-rubl-acc        = 0
     2463       bfpc_tt-allsum.dsc-cli-acc         = 0
     2464       bfpc_tt-allsum.vat-base-acc        = 0
     2465       bfpc_tt-allsum.vat-rubl-acc        = 0
     2466       bfpc_tt-allsum.vat-cli-acc         = 0
     2467       bfpc_tt-allsum.slt-base-acc        = 0
     2468       bfpc_tt-allsum.slt-rubl-acc        = 0
     2469       bfpc_tt-allsum.slt-cli-acc         = 0
     2470       bfpc_tt-allsum.road-tax-base-acc   = 0
     2471       bfpc_tt-allsum.road-tax-rubl-acc   = 0
     2472       bfpc_tt-allsum.road-tax-cli-acc    = 0
     2473       bfpc_tt-allsum.excise-base-acc     = 0
     2474       bfpc_tt-allsum.excise-rubl-acc     = 0
     2475       bfpc_tt-allsum.excise-cli-acc      = 0
     2476       bfpc_tt-allsum.transport-base-acc  = 0
     2477       bfpc_tt-allsum.transport-rubl-acc  = 0
     2478       bfpc_tt-allsum.transport-cli-acc   = 0
     2479       bfpc_tt-allsum.other-base-acc      = 0
     2480       bfpc_tt-allsum.other-rubl-acc      = 0
     2481       bfpc_tt-allsum.other-cli-acc       = 0
