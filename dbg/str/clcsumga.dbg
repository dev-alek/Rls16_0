     2958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2959     (input  bf_trn-doc.obj-type
     2960     ,input  bf_trn-doc.obj-code
     2961     ,input  varb-code
     2962     ,input  0
     2963     ,input  bf_trn-doc.fact-order
     2964     ,output vardoc-num
     2965     ,output varprice-sale
     2966     ,output varroad-tax
     2967     ,output varexcise
     2968     )  .
     2969             if varprice-sale = ?
     2970             then do:
     2971               assign
     2972                 varprice-sale = 0
     2973                 varroad-tax   = 0
     2974                 varexcise     = 0
     2975               .
     2976             end.
     2977             assign
     2978               varlastcur-base     = varprice-sale
     2979               varlastcur-road-tax = varroad-tax
     2980               varlastcur-excise   = varexcise
     2981               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2982               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2983               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2984               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2985             .
     2986         end.
     2987       end.
     2988       if varcur-fact-qnty = 0 then do:
     2989         assign
     2990           varcur-base      = varlastcur-base
     2991           varcur-road-tax  = varlastcur-road-tax
     2992           varcur-excise    = varlastcur-excise
     2993         .
     2994       end.
     2995       else do:
     2996         assign
     2997           varcur-base      = varcur-base      / varcur-fact-qnty
     2998           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2999           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3000         .
     3001       end.
     3002       if varcur-vat-pc = ?
     3003       then do:
     3004         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3005       end.
     3006       if varcur-slt-pc = ?
     3007       then do:
     3008         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3009       end.
     3010       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3011       assign
     3012         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3013       if varcur-cons-vat-pc = ? then do:
     3014         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3015       end.
     3016       define buffer buf_tt-clcparts for tt-clcparts .
     3017       for each buf_tt-clcparts
     3018       on error undo, return error return-value
     3019       :
     3020         delete buf_tt-clcparts.
     3021       end.
     3022       for each bf_parts no-lock
     3023         where bf_parts.out-code  = bf_doc-line.doc-code
     3024           and bf_parts.obj-type  = bf_doc-line.obj-type
     3025           and bf_parts.obj-code  = bf_doc-line.obj-code
     3026           and bf_parts.artic     = bf_doc-line.artic
     3027           and bf_parts.prod-type = bf_doc-line.prod-type
     3028           and bf_parts.prod-code = bf_doc-line.prod-code
     3029       on error undo, return error return-value
     3030       :
     3031         create buf_tt-clcparts .
     3032         buffer-copy bf_parts to buf_tt-clcparts .
     3033         if v-calcbypart = yes   then do:
     3034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3035     (buffer bf_parts
     3036     ,output v-b-pcode
     3037     ) no-error .
     3038   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3040     (input  bf_parts.obj-type
     3041     ,input  bf_parts.obj-code
     3042     ,input  v-b-pcode
     3043     ,input  0
     3044     ,input  bf_trn-doc.fact-order
     3045     ,output vardoc-num
     3046     ,output varprice-salef
     3047     ,output varroad-tax
     3048     ,output varexcise
     3049     ) no-error .
     3050             if varprice-sale = ?
     3051             then do:
     3052               assign
     3053                 varprice-salef = 0
     3054                 varroad-tax   = 0
     3055                 varexcise     = 0
     3056               .
     3057             end.
     3058             assign
     3059             part-cur-base  = varprice-salef
     3060             part-cur-road-tax  = varroad-tax
     3061             part-cur-excise = varexcise.
     3062         end.
     3063       end.
     3064       run clcprtsl_calc-ttable in this-procedure
     3065         (input yes,
     3066          input yes,
     3067          input bf_doc-line.road-tax,
     3068          input bf_doc-line.excise,
     3069          input bf_doc-line.vat-pc,
     3070          input bf_doc-line.cons-vat-pc,
     3071          input bf_doc-line.slt-pc,
     3072          input bf_trn-doc.base-rate,
     3073          input bf_trn-doc.base-scale,
     3074          input varr-b,
     3075          input varcur-base,
     3076          input varcur-road-tax,
     3077          input varcur-excise,
     3078          input varcur-vat-pc,
     3079          input varcur-cons-vat-pc,
     3080          input varcur-slt-pc
     3081          ) no-error.
     3082       if error-status:error then do:
     3083         message
     3084           vss-workfile vss-revision vss-description skip
     3085           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3086           return-value skip
     3087           trim(error-status :get-message(1))
     3088           trim(error-status :get-message(2))
     3089           trim(error-status :get-message(3))
     3090           trim(error-status :get-message(4))
     3091           trim(error-status :get-message(5)) skip
     3092           view-as alert-box error.
     3093         undo, return error .
     3094       end.
     3095     end.
     3096   end.
     3097   end.
     3098   procedure clcprtsl_calc-ttable :
     3099   define input parameter paris-doc           as   logical                 no-undo.
     3100   define input parameter paris-cur           as   logical                 no-undo.
     3101   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3102   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3103   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3104   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3105   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3106   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3107   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3108   define input parameter parr-b              as   character               no-undo.
     3109   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3110   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3111   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3112   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3113   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3114   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3115   define buffer bf_tt-allsum      for tt-allsum.
     3116   define buffer bf_tt-clcparts    for tt-clcparts.
     3117   define buffer bf_tt-allsum-line for tt-allsum-line.
     3118   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3119   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3120   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3121   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3122   define variable varexcise          like ub.price-list.excise     no-undo.
     3123   do on error undo, return error return-value :
     3124   for each bf_tt-allsum-line
     3125   on error undo, return error return-value
     3126    :
     3127     delete bf_tt-allsum-line.
     3128   end.
     3129   for each bf_tt-allsum
     3130   on error undo, return error return-value
     3131   :
     3132     delete bf_tt-allsum.
     3133   end.
     3134   for each bf_tt-clcparts
     3135   on error undo, return error return-value
     3136   :
     3137   if v-calcbypart then do:
     3138             assign
     3139             parcur-base =   bf_tt-clcparts.part-cur-base
     3140             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3141             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3142             .
     3143   end.
     3144      run clcprtsl_calc-parts in this-procedure (
     3145        input recid(bf_tt-clcparts),
     3146        input paris-doc,
     3147        input paris-cur,
     3148        input parroad-tax,
     3149        input parexcise,
     3150        input parvat-pc,
     3151        input parcons-vat-pc,
     3152        input parslt-pc,
     3153        input parbase-rate,
     3154        input parbase-scale,
     3155        input parr-b,
     3156        input parcur-base,
     3157        input parcur-road-tax,
     3158        input parcur-excise,
     3159        input parcur-vat-pc,
     3160        input parcurcons-vat-pc,
     3161        input parcurslt-pc
     3162        ) no-error.
     3163     if error-status:error then do:
     3164       message
     3165         vss-workfile vss-revision vss-description skip
     3166         vss-include-info8 skip
     3167         "Ошибка при обсчете партии" skip
     3168         "Документ партии " bf_tt-clcparts.out-code skip
     3169         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3170         return-value skip
     3171         error-status:get-message(1) skip
     3172         error-status:get-message(2) skip
     3173         error-status:get-message(3) skip
     3174         view-as alert-box error .
     3175       undo, return error .
     3176     end.
     3177     for each bf_tt-allsum on error undo, return error return-value :
     3178       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3179       if not available bf_tt-allsum-line then do:
     3180         create bf_tt-allsum-line.
     3181         assign
     3182           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3183       end.
     3184       assign
     3185         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3186         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3187         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3188         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3189         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3190         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3191         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3192         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3193         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3194         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3195         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3196         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3197         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3198         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3199         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3200         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3201         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3202         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3203         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3204         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3205         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3206         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3207         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3208         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3209         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3210         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3211         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3212         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3213         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3214         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3215         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3216         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3217         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3218         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3219         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3220         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3221         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3222         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3223         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3224         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3225         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3226         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3227         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3228         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3229         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3230         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3231         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3232         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3233         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3234         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3235         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3236         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3237         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3238         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3239         .
     3240     end.
     3241   end.
     3242   end.
     3243   end procedure.
     3244   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3245   define new global shared variable g#trdcalib as handle no-undo.
     3246   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
     3247   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
     3248   define temp-table tt-wast-line        no-undo
     3249     field obj-type            like ub.doc-line.obj-type
     3250     field obj-code            like ub.doc-line.obj-code
     3251     field status_             like ub.doc-line.status_
     3252     field artic               like ub.doc-line.artic
     3253     field prod-type           like ub.doc-line.prod-type
     3254     field prod-code           like ub.doc-line.prod-code
     3255     field fact-order          like ub.doc-line.fact-order
     3256     field prev-inv-fact-order like ub.doc-line.fact-order
     3257     index prev-inv-fact-order      prev-inv-fact-order.
     3258     define new global shared variable g#lib-rwds as handle no-undo.
     3259   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3260   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3261   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3262   define variable par-type          as character no-undo.
     3263   define variable v-value-character as character no-undo .
     3264   define variable v-value-date      as date      no-undo .
     3265   define variable v-value-decimal   as decimal   no-undo .
     3266   define variable v-value-integer   as integer   no-undo .
     3267   define variable v-value-logical   as logical   no-undo .
     3268   define variable varcalcasstring  as character no-undo.
     3269   define variable varcalcastype    as character no-undo.
     3270   define variable varinvclcspvalue as character no-undo.
     3271   define variable varinvclcsptype  as character no-undo.
     3272   define variable varneed-calc     as logical   no-undo.
     3273   define variable vartime          as integer   no-undo.
     3274   define variable varcount         as integer   no-undo.
     3275   define buffer bf_goods           for ub.goods.
     3276   define buffer bf_tt-doc-line-sum for tt-doc-line-sum.
     3277   do transaction on error undo, return error return-value :
     3278     assign
     3279       vartime = time.
     3280     find first ub.trn-doc no-lock where
     3281                ub.trn-doc.doc-code = v-doc-code
     3282     .
     3283   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3284   empty temp-table thbjattr_thbj-attr.
     3285   run adm/shattri.p (
     3286      input "get":U
     3287     ,input ub.trn-doc.obj-type
     3288     ,input ub.trn-doc.obj-code
     3289     ,input 'inv-obj':U
     3290     ,input  ""
     3291     ,output v-value-character
     3292     ,output v-value-date
     3293     ,output v-value-decimal
     3294     ,output v-value-integer
     3295     ,output v-value-logical
     3296     ,output par-type
     3297     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3298     ) no-error .
     3299   for each thbjattr_thbj-attr :
     3300       if thbjattr_thbj-attr.prop-code = 'invclcsp'  then varinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     3301   end.
     3302     if ub.trn-doc.ext-doc-type <> 'vt':U              and
     3303        ub.trn-doc.ext-doc-type <> 'vp':U         and
     3304        ub.trn-doc.ext-doc-type <> 'mp':U and
     3305        ub.trn-doc.ext-doc-type <> 'pc':U   and
     3306        ub.trn-doc.ext-doc-type <> 'ap':U   then do:
     3307       return error substitute( "Документ &1 имеет недопустимый расширенный тип &2 для данной операции."
     3308                              , ub.trn-doc.doc-code
     3309                              , ub.trn-doc.ext-doc-type).
     3310     end.
     3311     if ub.trn-doc.status_ <> 'факт':U      and
     3312        ub.trn-doc.status_ <> 'разрешен':U then do:
     3313       assign
     3314         varneed-calc = no.
     3315     end.
     3316     else do:
     3317       assign
