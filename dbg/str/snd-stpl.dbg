        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: snd-stpl.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/snd-stpl.p $":U .
       11   define variable vss-description as character no-undo init "Пересылка стоплистов на кассы всех магазинов".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable p-stop-list-code as character no-undo.
       82   define variable log-file-name                as character      no-undo init "send-cd.txt".
       83   define variable v-view-log                   as logical        no-undo .
       84   define buffer buf_stop-list for ub.stop-list.
       85   define buffer buf2_stop-list for ub.stop-list.
       86   define buffer buf_clients for ub.clients.
       87   define buffer buf_cash-desk for ub.cash-desk.
       88   assign
       89   p-stop-list-code = entry(1, p-parameter, chr(4))
       90   no-error
       91   .
       92   if error-status:error then do:
       93     run write-log-and-file in p-log-handle (
       94           input 1
       95         , input log-file-name
       96         , input 1
       97         , input substitute("Ошибка входных параметров &1:&2&3&4"
       98                            , p-parameter
       99                            , chr(10)
      100                            , error-status:get-message(1)
      101                            , return-value
      102                            )).
      103     assign
      104     v-view-log = yes.
      105   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if v-view-log
      107   and not g#news
      108   and not g#auto
      109   then do:
      110     message
      111     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      112     "!!!Внимательно прочитайте Log-file!!"
      113     view-as alert-box error .
      114        define variable v-user-action1   as character no-undo .
      115     define variable v-printed1       as logical   no-undo .
      116     run gbl/prnfilen.w
      117       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      118       ,input  0
      119       ,input  (string("./":U) + 'send-cd.txt')
      120       ,input  7
      121       ,output v-user-action1
      122       ,output v-printed1
      123       ) .
      124   end.
      125   if v-view-log = true
      126   and (g#news
      127   or g#auto)
      128   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      129   then do:
      130      run cb_set-view-log in p-parent-handle ( input yes).
      131   end.
      132   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      133     OS-DELETE value(string("./":U) + 'send-cd.txt').
      134   end.
      135                           return.
      136   end.
      137   find first buf_stop-list no-lock where
      138             buf_stop-list.classif-type = 'dis-card':U
      139        and  buf_stop-list.stop-list-code = p-stop-list-code no-error .
      140   if not available buf_stop-list then do:
      141     run write-log-and-file in p-log-handle (
      142           input 1
      143         , input log-file-name
      144         , input 1
      145         , input substitute("Ошибка входного параметра p-stop-list-code&1:не найден стоп-лист с таким номером"
      146                           ,p-stop-list-code
      147                           )               ).
      148     assign
      149     v-view-log = yes.
      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   if v-view-log
      152   and not g#news
      153   and not g#auto
      154   then do:
      155     message
      156     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      157     "!!!Внимательно прочитайте Log-file!!"
      158     view-as alert-box error .
      159        define variable v-user-action3   as character no-undo .
      160     define variable v-printed3       as logical   no-undo .
      161     run gbl/prnfilen.w
      162       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      163       ,input  0
      164       ,input  (string("./":U) + 'send-cd.txt')
      165       ,input  7
      166       ,output v-user-action3
      167       ,output v-printed3
      168       ) .
      169   end.
      170   if v-view-log = true
      171   and (g#news
      172   or g#auto)
      173   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      174   then do:
      175      run cb_set-view-log in p-parent-handle ( input yes).
      176   end.
      177   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      178     OS-DELETE value(string("./":U) + 'send-cd.txt').
      179   end.
      180                           return.
      181   end.
      182   IF buf_stop-list.status_   <> 'факт':U then do:
      183     run write-log-and-file in p-log-handle (
      184           input 1
      185         , input log-file-name
      186         , input 1
      187         , input  substitute("Стоплист &1 не закрыт на факт&2Отослать на кассу невозможно"
      188                , buf_stop-list.status_
      189                , chr(10)))
      190                .
      191     assign
      192     v-view-log = yes.
      193   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   if v-view-log
      195   and not g#news
      196   and not g#auto
      197   then do:
      198     message
      199     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      200     "!!!Внимательно прочитайте Log-file!!"
      201     view-as alert-box error .
      202        define variable v-user-action5   as character no-undo .
      203     define variable v-printed5       as logical   no-undo .
      204     run gbl/prnfilen.w
      205       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      206       ,input  0
      207       ,input  (string("./":U) + 'send-cd.txt')
      208       ,input  7
      209       ,output v-user-action5
      210       ,output v-printed5
      211       ) .
      212   end.
      213   if v-view-log = true
      214   and (g#news
      215   or g#auto)
      216   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      217   then do:
      218      run cb_set-view-log in p-parent-handle ( input yes).
      219   end.
      220   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      221     OS-DELETE value(string("./":U) + 'send-cd.txt').
      222   end.
      223                           return.
      224   END.
      225   find first buf2_stop-list NO-LOCK WHERE
      226           buf2_stop-list.classif-type = buf_stop-list.classif-type
      227       and buf2_stop-list.host-code = 0
      228       and buf2_stop-list.obj-type = '':U
      229       and buf2_stop-list.obj-code = 0
      230       and buf2_stop-list.status_ = 'факт':U
      231       and buf2_stop-list.fact-order > buf_stop-list.fact-order no-error .
      232   if available buf2_stop-list THEN DO:
      233       if g#news then return.
      234       run write-log-and-file in p-log-handle (
      235             input 1
      236           , input log-file-name
      237           , input 1
      238           , input  substitute("Уже есть более поздний стоплист &1 чем стоплист &2&3" +
      239                               "Нельзя отослать стоплист &2 на кассу"
      240                 , buf2_stop-list.stop-list-code
      241                 , buf_stop-list.stop-list-code
      242                 , chr(10)))
      243                 .
      244     assign
      245     v-view-log = yes.
      246   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   if v-view-log
      248   and not g#news
      249   and not g#auto
      250   then do:
      251     message
      252     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      253     "!!!Внимательно прочитайте Log-file!!"
      254     view-as alert-box error .
      255        define variable v-user-action7   as character no-undo .
      256     define variable v-printed7       as logical   no-undo .
      257     run gbl/prnfilen.w
      258       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      259       ,input  0
      260       ,input  (string("./":U) + 'send-cd.txt')
      261       ,input  7
      262       ,output v-user-action7
      263       ,output v-printed7
      264       ) .
      265   end.
      266   if v-view-log = true
      267   and (g#news
      268   or g#auto)
      269   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      270   then do:
      271      run cb_set-view-log in p-parent-handle ( input yes).
      272   end.
      273   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      274     OS-DELETE value(string("./":U) + 'send-cd.txt').
      275   end.
      276                           return.
      277   END.
      278   for each buf_clients no-lock
      279       where buf_clients.obj-type = 'маг':U
      280         and buf_clients.db-num   = g#db-num,
      281       first buf_cash-desk no-lock where
      282             buf_cash-desk.db-num = G#db-num
      283         AND buf_cash-desk.obj-code = buf_clients.obj-code
      284         AND buf_cash-desk.cash-on = yes
      285   on error undo, return error
      286   :
      287     run set-title in p-log-handle (
      288           input "Отправка стоп листов на кассу"
      289                                     ).
      290     run str/sendstpl.p (
      291                     input parparentproc
      292                   ,input p-parent-handle
      293                   ,input p-log-handle
      294                   ,input (string(buf_clients.obj-code) + chr(4) + p-stop-list-code + chr(4) )
      295                     ) no-error .
      296     if error-status:error then do:
      297       run write-log-and-file in p-log-handle (
      298             input 1
      299           , input log-file-name
      300           , input 1
      301           , input substitute( "ошибка при отправке стоплистов на кассу по магазину &1&2&3&2&4"
      302                             , buf_clients.obj-code
      303                             , chr(10)
      304                             , error-status:get-message(1)
      305                             , return-value
      306                             )).
      307       assign
      308       v-view-log = yes.
      309     end.
      310   end.
