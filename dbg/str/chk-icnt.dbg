        1   block-level on error undo, throw.
        2   define input parameter parrecid as recid no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: chk-icnt.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/chk-icnt.p $":U .
        8   define variable vss-description as character no-undo init "Проверка документов счетчиков ТРК".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define buffer buf_icnt-doc for ub.icnt-doc.
       68   define buffer buf_icnt-line for ub.icnt-line.
       69   define buffer aft_icnt-doc for ub.icnt-doc.
       70   tr:
       71   do transaction on error   undo tr, return error
       72                  on end-key undo tr, return error
       73                  on stop    undo tr, return error:
       74   find buf_icnt-doc where recid(buf_icnt-doc) = parrecid exclusive no-error.
       75   if not available buf_icnt-doc then undo tr, return error "Ошибка при поиске документа инвентаризации счетчиков ТРК (файл chk-icnt.p)".
       76   if buf_icnt-doc.doc-type = 'инв-сч-трк':U then do:
       77     find first aft_icnt-doc where aft_icnt-doc.obj-type   = buf_icnt-doc.obj-type       and
       78                                   aft_icnt-doc.obj-code   = buf_icnt-doc.obj-code       and
       79                                   aft_icnt-doc.doc-type   = 'инв-сч-трк':U                 and
       80                                 (aft_icnt-doc.shift-date > buf_icnt-doc.shift-date or
       81                                   aft_icnt-doc.shift-date = buf_icnt-doc.shift-date and
       82                                   aft_icnt-doc.shift-num  > buf_icnt-doc.shift-num    ) and
       83                                   aft_icnt-doc.status_     = 'факт':U           no-lock no-error.
       84     if available aft_icnt-doc then undo tr, return error "Уже имеется более поздний документ инвентаризации счетчиков ТРК: " + aft_icnt-doc.doc-code +  " Смена: " + string(aft_icnt-doc.shift-date) + " " + string(aft_icnt-doc.shift-num).
       85   end.
       86   if buf_icnt-doc.status_ = 'факт':U then do:
       87      for each buf_icnt-line where buf_icnt-line.doc-code = buf_icnt-doc.doc-code no-lock:
       88          if buf_icnt-line.state-el-cnt = ? then do:
       89            if buf_icnt-doc.doc-type = 'инв-сч-трк':U then do:
       90               undo tr, return error substitute("Не задано количество по электронному счетчику ТРК: &1 пистолет &2."
       91                                               ,buf_icnt-line.pump-code
       92                                               ,buf_icnt-line.nozzle-code).
       93            end.
       94            if buf_icnt-doc.doc-type = 'сч-трк-погр':U then do:
       95               undo tr, return error substitute("Не задано количество по счетчику ТРК: &1 пистолет &2."
       96                                               ,buf_icnt-line.pump-code
       97                                               ,buf_icnt-line.nozzle-code).
       98            end.
       99          end.
      100          if buf_icnt-line.state-mh-cnt = ? then do:
      101            if buf_icnt-doc.doc-type = 'инв-сч-трк':U then do:
      102              undo tr, return error substitute("Не задано количество по механическому счетчику ТРК: &1 пистолет &2."
      103                                               ,buf_icnt-line.pump-code
      104                                               ,buf_icnt-line.nozzle-code) .
      105            end.
      106            if buf_icnt-doc.doc-type = 'сч-трк-погр':U then do:
      107              undo tr, return error substitute("Не задано количество по мернику для ТРК: &1 пистолет &2."
      108                                               ,buf_icnt-line.pump-code
      109                                               ,buf_icnt-line.nozzle-code) .
      110            end.
      111          end.
      112      end.
      113      run gbl/chk-date.p
      114        (input buf_icnt-doc.obj-type
      115        ,input buf_icnt-doc.obj-code
      116        ,input buf_icnt-doc.fact-date
      117        ,input buf_icnt-doc.fact-time
      118        ,input buf_icnt-doc.shift-date
      119        ,input buf_icnt-doc.shift-num
      120        ,input true
      121        ) no-error .
      122      if error-status:error then undo tr, return error
      123       substitute("Неверная дата и время в документе счетчиков ТРК:&1"  +
      124                  "fact-date=&2 fact-time = &3 shift-date=&4 shift-num=&5"
      125                  ,chr(10)
      126                  ,buf_icnt-doc.fact-date
      127                  ,buf_icnt-doc.fact-time
      128                  ,buf_icnt-doc.shift-date
      129                  ,buf_icnt-doc.shift-num)
      130      .
      131     end.
      132   end.
