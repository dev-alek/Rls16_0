      992   ON CHOOSE OF b-unblock IN FRAME Dialog-Frame
      993      DO:
      994         define variable quest-ok as logical no-undo .
      995   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   do:
      997     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      998       (input  v-cntxt-db-num
      999       ,input  v-cntxt-userid
     1000       ,input  0
     1001       ,input  'actn_nozzle-sts_work':U
     1002       ,input  'object':U
     1003       ,input  v-cntxt-host-code-obj
     1004       ,input  v-cntxt-obj-type
     1005       ,input  v-cntxt-obj-code
     1006       ,input  0
     1007       ,input  0
     1008       ,input  0
     1009       ,input  true
     1010       ,output glog
     1011       )  .
     1012   end.
     1013         IF NOT glog THEN RETURN NO-APPLY.
     1014         if available X_marking then
     1015         do:
     1016            message "Разблокировать все пистолеты в" skip
     1017               "АСУ 'Заправщик'?"
     1018               view-as alert-box question buttons yes-no update quest-ok.
     1019            if quest-ok then
     1020            do:
     1021               pl-list = "".
     1022               for each X_marking :
     1023                  if pl-list = "" then
     1024                  do:
     1025                     pl-list =
     1026                        string(X_marking.nozzle-code) + ":" +
     1027                        string(X_marking.pump-code)
     1028                        .
     1029                  end.
     1030                  else
     1031                  do:
     1032                     pl-list = pl-list + ";" +
     1033                        string(X_marking.nozzle-code) + ":" +
     1034                        string(X_marking.pump-code)
     1035                        .
     1036                  end.
     1037               end.
     1038               run str/diallog.w ( input parparentproc
     1039                  ,input this-procedure
     1040                  ,input 'str/get-block-nozzle.p':U
     1041                  ,input (v-cntxt-obj-type + chr(4) +
     1042                  string(v-cntxt-obj-code) + chr(4) +
     1043                  string(1) + chr(4) +
     1044                  string(0) + chr(4) +
     1045                  chr(4) +
     1046                  chr(4) +
     1047                  chr(4) +
     1048                  substitute("&1,&2"
     1049                  ,"unblock"
     1050                  ,pl-list))
     1051                  ,input yes
     1052                  ,input ''
     1053                  ,input 'Разблокировка пистолетов') .
     1054               if not error-status:error then
     1055               do:
     1056                  if return-value begins "Для кассы" then
     1057                  do:
     1058                     message return-value
     1059                        view-as alert-box question buttons yes-no update v-ok as logical  .
     1060                     if v-ok then apply "choose" to b-repeate-unblock in frame Dialog-Frame .
     1061                     else message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     1062                           view-as alert-box.
     1063                  end.
     1064                  else
     1065                  do:
     1066                     message "Разблокировка пистолетов прошла успешно"
     1067                        view-as alert-box.
     1068                  end.
     1069               end.
     1070               else
     1071               do:
     1072                  message return-value
     1073                     view-as alert-box question buttons yes-no update v-ok .
     1074                  if v-ok then apply "choose" to b-repeate-block in frame Dialog-Frame .
     1075                  else                   message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     1076                        view-as alert-box.
     1077               end.
     1078               apply "choose" to b-exit in frame Dialog-Frame.
     1079            end.
     1080         end.
     1081      END.
     1082   ON CHOOSE OF bt-not-sel-all IN FRAME Dialog-Frame
     1083      DO:
     1084         define variable loc#log as logical no-undo .
     1085         if available X_marking then
     1086         do:
     1087            for each X_marking :
     1088               X_marking.marking-string = "*" .
     1089               loc#log = b-plgdspm:refresh() no-error.
     1090            end.
     1091         end.
     1092         apply "entry" to b-plgdspm in frame Dialog-Frame.
     1093      END.
     1094   ON CHOOSE OF bt-not-sel-desel-all IN FRAME Dialog-Frame
     1095      DO:
     1096         define variable loc#log as logical no-undo .
     1097         For each X_marking where X_marking.marking-string = "*":
     1098            X_marking.marking-string = "" .
     1099         end.
     1100         loc#log = b-plgdspm:refresh() no-error.
     1101      END.
     1102   ON VALUE-CHANGED OF c-nozzle-code IN FRAME Dialog-Frame
     1103      DO:
     1104         assign c-nozzle-code .
     1105         run sort_ .
     1106      END.
     1107   ON VALUE-CHANGED OF c-pump-code IN FRAME Dialog-Frame
     1108      DO:
     1109         assign c-pump-code .
     1110         run sort_ .
     1111      END.
     1112   ON leave OF search-goods IN FRAME Dialog-Frame
     1113      DO:
     1114         assign search-goods .
     1115         run sort_ .
     1116      END.
     1117   ON return OF search-goods IN FRAME Dialog-Frame
     1118      DO:
     1119         assign search-goods .
     1120         run sort_ .
     1121      END.
     1122   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1123      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1124   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125   on help of frame Dialog-Frame
     1126   do:
     1127     run gbl/app_help.p
     1128       (input this-procedure :file-name
     1129       ,input ''
     1130       ,input ?
     1131       ) no-error.
     1132     if error-status :error then do:
     1133       message
     1134         "Ошибка при вызове помощи"
     1135         error-status :get-message(1)
     1136         view-as alert-box .
     1137     end.
     1138   end.
     1139   run minbtn-set in this-procedure .
     1140   on choose of b-help in frame Dialog-Frame
     1141   do:
     1142     apply "help":u to frame Dialog-Frame .
     1143   end.
     1144   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   procedure minbtn-set :
     1146       do
     1147           on error undo, return error return-value
     1148           :
     1149           define variable ii              as integer       no-undo .
     1150           define variable fh              as widget-handle no-undo .
     1151           define variable hh              as widget-handle no-undo .
     1152           define variable v-h             as handle        extent 4 no-undo .
     1153           define variable v-name-button   as character     no-undo .
     1154           define variable v-help-old-x    as decimal       no-undo .
     1155           define variable v-help-old-y    as decimal       no-undo .
     1156           define variable v-help-old-size as decimal       no-undo .
     1157           define variable v-frame-width   as decimal       no-undo .
     1158           define variable jj              as integer       no-undo .
     1159           do
     1160               on error undo, return error
     1161               :
     1162               assign
     1163                   v-frame-width = frame Dialog-Frame:width - 0.3
     1164                   fh            = frame Dialog-Frame:first-child
     1165                   hh            = fh:first-child
     1166                   ii            = 1
     1167                   .
     1168               do while valid-handle(hh):
     1169                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1170                   do:
     1171                       case lc(hh:name) :
     1172                           when "b-help" then
     1173                               do:
     1174                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1175                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1176                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1177                                   hh:TOOLTIP = "Помощь" .
     1178                                   v-help-old-x = hh:column .
     1179                                   v-help-old-y = hh:row    .
     1180                                   v-help-old-size = hh:width .
     1181                                   hh:width-chars = 2.5 .
     1182                               end.
     1183                           when "b-print" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-print.bmp":u) .
     1186                                   hh:TOOLTIP = "Печать" .
     1187                                   v-h[ii] = hh:handle .
     1188                                   ii = ii + 1 .
     1189                                   hh:width-chars = 3 .
     1190                               end.
     1191                           when "b-history" or
     1192                           when "b-hist" then
     1193                               do:
     1194                                   hh:load-image("cmp/b-hist.bmp":u) .
     1195                                   hh:TOOLTIP = "История" .
     1196                                   v-h[ii] = hh:handle .
     1197                                   ii = ii + 1 .
     1198                                   hh:width-chars = 3 .
     1199                               end.
     1200                           when "b-sch" then
     1201                               do:
     1202                                   hh:load-image("cmp/b-sch.bmp":u) .
     1203                                   hh:TOOLTIP = "Установка Фильтра" .
     1204                                   v-h[ii] = hh:handle .
     1205                                   ii = ii + 1 .
     1206                                   hh:width-chars = 3 .
     1207                               end.
     1208                           when "b-hist-user" then
     1209                               do:
     1210                                   hh:load-image("cmp/b-hist.bmp":u) .
     1211                                   hh:TOOLTIP = "История пользователя" .
     1212                                   ii = ii + 1 .
     1213                               end.
     1214                       end case.
     1215                   end.
     1216                   hh = hh:next-sibling.
     1217               end.
     1218               b-help:column = v-frame-width - b-help:width-chars.
     1219               jj = 0.
     1220               repeat ii = 4 to 1 by -1 :
     1221                   if valid-handle (v-h[ii] ) then
     1222                   do:
     1223                       jj  = jj + 1 .
     1224                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1225                       v-h[ii]:row    = v-help-old-y .
     1226                   end.
     1227               end.
     1228           end.
     1229       end.
     1230   end procedure.
     1231   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1232   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1233   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1234   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1235   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1236   define variable v-diasize-current-frame-height as decimal   no-undo .
     1237   define variable v-diasize-change-size          as logical   no-undo .
     1238   define variable v-diasize-resize-button        as handle    no-undo .
     1239   define variable v-diasize-wndmax               as logical   no-undo .
     1240   define variable v-diasize-wndstore             as logical   no-undo .
     1241   define variable v-diasize-proc-name            as character no-undo .
     1242   define variable v-diasize-browse-handle        as handle    no-undo .
     1243   define variable v-diasize-browse-number        as integer   no-undo .
     1244   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1245   define temp-table temp-diasize-handle no-undo
     1246     field handle-value  as handle
     1247     field save-position as decimal
     1248     index xpk is primary unique handle-value
     1249     .
     1250   define temp-table temp-browse-handle no-undo
     1251     field browse-type   as character
     1252     field browse-number as integer
     1253     field browse-handle as handle
     1254     field original-size as decimal
     1255     index xpk is primary unique browse-type browse-number
     1256     index xie browse-type browse-handle
     1257   .
     1258   procedure diasize_change-height :
     1259     define input  parameter p-change-value  as decimal   no-undo .
     1260     define input  parameter p-move-resize   as logical   no-undo .
     1261     define variable v-field-group-handle    as handle    no-undo .
     1262     define variable v-object-handle         as handle    no-undo .
     1263     define variable v-frame-height          as decimal   no-undo .
     1264     define variable v-frame-virtual-height  as decimal   no-undo .
     1265     define variable v-browse-height         as decimal   no-undo .
     1266     define variable v-window-height         as decimal   no-undo .
     1267     define variable v-window-virtual-height as decimal   no-undo .
     1268     define variable v-change-sign           as integer   no-undo .
     1269     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1270     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1271     if p-change-value > 0
     1272     then do:
     1273       if frame Dialog-Frame :height + p-change-value
     1274           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1275       then do:
     1276         assign
     1277           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1278                           - (frame Dialog-Frame :height-chars)
     1279         .
     1280         if p-change-value <= 0
     1281         then do:
     1282           run diasize_position-resize-button in this-procedure .
     1283           return .
     1284         end.
     1285       end.
     1286     end.
     1287     if p-change-value < 0
     1288     then do:
     1289       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1290       then do:
     1291         assign
     1292           p-change-value = v-diasize-orig-frame-height
     1293                          - (frame Dialog-Frame :height-chars)
     1294         .
     1295         if p-change-value >= 0
     1296         then do:
     1297           run diasize_position-resize-button in this-procedure .
     1298           return .
     1299         end.
     1300       end.
     1301     end.
     1302     if p-change-value >= 0
     1303     then do:
     1304       assign
     1305         v-change-sign = 1
     1306       .
     1307     end.
     1308     else do:
     1309       assign
     1310         v-change-sign = -1
     1311       .
     1312     end.
     1313     assign
     1314       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1315     .
     1316     if p-change-value = 0
     1317     then do:
     1318       run diasize_position-resize-button in this-procedure .
     1319       return .
     1320     end.
     1321     move_block:
     1322     do
     1323     on error undo move_block, retry move_block
     1324     :
     1325       if retry
     1326       then do:
     1327         do
     1328         on error undo move_block, leave move_block
     1329         :
     1330           if p-change-value > 0
     1331           then do:
     1332             for each buf_temp-diasize-handle
     1333             on error undo, next
     1334             :
     1335               assign
     1336                 v-object-handle = buf_temp-diasize-handle.handle-value
     1337               .
     1338               if v-object-handle <> v-diasize-resize-button
     1339               then do:
     1340                 assign
     1341                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1342                 .
     1343               end.
     1344             end.
     1345             assign
     1346               v-diasize-browse-handle :height = v-browse-height
     1347             .
     1348             for each buf_temp-browse-handle
     1349               where buf_temp-browse-handle.browse-type = 'height':u
     1350             on error undo, next
     1351             :
     1352               assign
     1353                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1354               .
     1355             end.
     1356             assign
     1357               frame Dialog-Frame :height = v-frame-height
     1358             .
     1359             if frame Dialog-Frame :scrollable = true
     1360             then do:
     1361               assign
     1362                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1363               .
     1364             end.
     1365             run diasize_position-resize-button in this-procedure .
     1366           end.
     1367           else do:
     1368             if frame Dialog-Frame :scrollable = true
     1369             then do:
     1370               assign
     1371                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1372               .
     1373             end.
     1374             assign
     1375               frame Dialog-Frame :height = v-frame-height
     1376             .
     1377             assign
     1378               v-diasize-browse-handle :height = v-browse-height
     1379             .
     1380             for each buf_temp-browse-handle
     1381               where buf_temp-browse-handle.browse-type = 'height':u
     1382             on error undo, next
     1383             :
     1384               assign
     1385                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1386               .
     1387             end.
     1388             for each buf_temp-diasize-handle
     1389             on error undo, next
     1390             :
     1391               assign
     1392                 v-object-handle = buf_temp-diasize-handle.handle-value
     1393               .
     1394               if v-object-handle <> v-diasize-resize-button
     1395               then do:
     1396                 assign
     1397                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1398                 .
     1399               end.
     1400             end.
     1401             run diasize_position-resize-button in this-procedure .
     1402           end.
     1403           assign
     1404             v-diasize-change-size = false
     1405           .
     1406           leave move_block .
     1407         end.
     1408       end.
     1409       assign
     1410         v-diasize-need-full-display = true
     1411       .
     1412       if v-diasize-change-size = false
     1413       then do:
     1414         assign
     1415           v-diasize-change-size = true
     1416         .
     1417       end.
     1418       else do:
     1419         return .
     1420       end.
     1421       assign
     1422         v-frame-height = frame Dialog-Frame :height
     1423         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1424         v-browse-height = v-diasize-browse-handle :height
     1425       .
     1426       for each buf_temp-browse-handle
     1427         where buf_temp-browse-handle.browse-type = 'height':u
     1428       :
     1429         assign
     1430           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1431         .
     1432       end.
     1433       for each buf_temp-diasize-handle
     1434       :
     1435         delete buf_temp-diasize-handle .
     1436       end.
     1437       assign
     1438         v-field-group-handle = frame Dialog-Frame :first-child
     1439       .
     1440       do while valid-handle(v-field-group-handle)
     1441       :
     1442         assign
     1443           v-object-handle = v-field-group-handle :first-child
     1444         .
     1445         do while valid-handle(v-object-handle)
     1446         :
     1447           if  v-object-handle <> v-diasize-browse-handle :handle
     1448           and can-query(v-object-handle, "row")
     1449           and can-query(v-object-handle, "height")
     1450           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1451           then do:
     1452             find first buf_temp-browse-handle
     1453               where buf_temp-browse-handle.browse-type   = 'height':u
     1454                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1455               no-error .
     1456             if available buf_temp-browse-handle
     1457             then do:
     1458             end.
     1459             else do:
     1460               create buf_temp-diasize-handle .
     1461               assign
     1462                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1463                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1464               .
     1465             end.
     1466           end.
     1467           assign
     1468             v-object-handle = v-object-handle :next-sibling
     1469           .
     1470         end.
     1471         assign
     1472           v-field-group-handle = v-field-group-handle :next-sibling
     1473         .
     1474       end.
     1475       do with frame Dialog-Frame
     1476       :
     1477         hide v-diasize-resize-button .
     1478         assign
     1479           v-diasize-resize-button :row    = 1
     1480           v-diasize-resize-button :column = 1
     1481         .
     1482       end.
     1483       if p-change-value > 0
     1484       then do:
     1485         if frame Dialog-Frame :scrollable = true
     1486         then do:
     1487           assign
     1488             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1489             no-error .
     1490           if error-status :error
     1491           or error-status :get-message(1) <> ""
     1492           then do:
     1493             undo move_block, retry move_block .
     1494           end.
     1495         end.
     1496         assign
     1497           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1498           no-error .
     1499         if error-status :error
     1500         or error-status :get-message(1) <> ""
     1501         then do:
     1502           undo move_block, retry move_block .
     1503         end.
     1504         assign
     1505           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1506           no-error .
     1507         if error-status :error
     1508         or error-status :get-message(1) <> ""
     1509         then do:
     1510           undo move_block, retry move_block .
     1511         end.
     1512         for each buf_temp-browse-handle
     1513           where buf_temp-browse-handle.browse-type = 'height':u
     1514         on error undo move_block, retry move_block
     1515         :
     1516           assign
     1517             buf_temp-browse-handle.browse-handle :height
     1518               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1519             no-error .
     1520           if error-status :error
     1521           or error-status :get-message(1) <> ""
     1522           then do:
     1523             undo move_block, retry move_block .
     1524           end.
     1525         end.
     1526         for each buf_temp-diasize-handle
     1527         on error undo move_block, retry move_block
     1528         :
     1529           assign
     1530             v-object-handle = buf_temp-diasize-handle.handle-value
     1531           .
     1532           if v-object-handle <> v-diasize-resize-button
     1533           then do:
     1534             assign
     1535               v-object-handle :row = v-object-handle :row + p-change-value
     1536               no-error .
     1537             if error-status :error
     1538             or error-status :get-message(1) <> ""
     1539             then do:
     1540               undo move_block, retry move_block .
     1541             end.
     1542           end.
     1543         end.
     1544       end.
     1545       else do:
     1546         for each buf_temp-diasize-handle
     1547         on error undo move_block, retry move_block
     1548         :
     1549           assign
     1550             v-object-handle = buf_temp-diasize-handle.handle-value
     1551           .
     1552           if v-object-handle <> v-diasize-resize-button
     1553           then do:
     1554             assign
     1555               v-object-handle :row = v-object-handle :row + p-change-value
     1556               no-error .
     1557             if error-status :error
     1558             or error-status :get-message(1) <> ""
     1559             then do:
     1560               undo move_block, retry move_block .
     1561             end.
     1562           end.
     1563         end.
     1564         assign
     1565           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1566           no-error .
     1567         if error-status :error
     1568         or error-status :get-message(1) <> ""
     1569         then do:
     1570           undo move_block, retry move_block .
     1571         end.
     1572         for each buf_temp-browse-handle
     1573           where buf_temp-browse-handle.browse-type = 'height':u
     1574         on error undo move_block, retry move_block
     1575         :
     1576           assign
     1577             buf_temp-browse-handle.browse-handle :height
     1578               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1579             no-error .
     1580           if error-status :error
     1581           or error-status :get-message(1) <> ""
     1582           then do:
     1583             undo move_block, retry move_block .
     1584           end.
     1585         end.
     1586         assign
     1587           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1588           no-error .
     1589         if error-status :error
     1590         or error-status :get-message(1) <> ""
     1591         then do:
     1592           undo move_block, retry move_block .
     1593         end.
     1594         if frame Dialog-Frame :scrollable = true
     1595         then do:
     1596           assign
     1597             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1598             no-error .
     1599           if error-status :error
     1600           or error-status :get-message(1) <> ""
     1601           then do:
     1602             undo move_block, retry move_block .
     1603           end.
     1604         end.
     1605       end.
     1606       if p-move-resize = true
     1607       then do:
     1608         run diasize_position-resize-button in this-procedure .
     1609       end.
     1610       if v-diasize-wndstore = true
     1611       then do:
     1612         if connected("ub") = true
     1613         then do:
     1614           define variable v-cntxt-db-num        as integer   no-undo .
     1615           define variable v-cntxt-userid        as character no-undo .
     1616           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1617                                             , OUTPUT v-cntxt-userid
     1618                                             ) .
     1619           run gbl/wndsizew.p
     1620             (input  v-cntxt-db-num
     1621             ,input  v-cntxt-userid
     1622             ,input  v-diasize-proc-name
     1623             ,input  'height':u
     1624             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1625             ) .
     1626         end.
     1627       end.
     1628     end.
     1629     assign
     1630       v-diasize-change-size = false
     1631     .
     1632   end procedure.
     1633   procedure diasize_set-height :
     1634     define input  parameter p-new-height  as decimal   no-undo .
     1635     define input  parameter p-move-resize as logical   no-undo .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639       run diasize_change-height in this-procedure
     1640         (input  (p-new-height - frame Dialog-Frame :height)
     1641         ,input  p-move-resize
     1642         ) .
     1643     end.
     1644   end procedure.
     1645   procedure diasize_change-width :
     1646     define input  parameter p-change-value as decimal   no-undo .
     1647     define input  parameter p-move-resize  as logical   no-undo .
     1648     define variable v-field-group-handle   as handle    no-undo .
     1649     define variable v-object-handle        as handle    no-undo .
     1650     define variable v-frame-width          as decimal   no-undo .
     1651     define variable v-frame-virtual-width  as decimal   no-undo .
     1652     define variable v-browse-width         as decimal   no-undo .
     1653     define variable v-window-width         as decimal   no-undo .
     1654     define variable v-window-virtual-width as decimal   no-undo .
     1655     define variable v-change-sign          as integer   no-undo .
     1656     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1657     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1658     if p-change-value > 0
     1659     then do:
     1660       if frame Dialog-Frame :width + p-change-value >
     1661           session :width-chars
     1662       then do:
     1663         assign
     1664           p-change-value = session :width-chars - frame Dialog-Frame :width
     1665         .
     1666         if p-change-value <= 0
     1667         then do:
     1668           run diasize_position-resize-button in this-procedure .
     1669           return .
     1670         end.
     1671       end.
     1672     end.
     1673     if p-change-value < 0
     1674     then do:
     1675       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1676       then do:
     1677         assign
     1678           p-change-value = v-diasize-orig-frame-width
     1679                          - frame Dialog-Frame :width
     1680         .
     1681         if p-change-value >= 0
     1682         then do:
     1683           run diasize_position-resize-button in this-procedure .
     1684           return .
     1685         end.
     1686       end.
     1687     end.
     1688     if p-change-value >= 0
     1689     then do:
     1690       assign
     1691         v-change-sign = 1
     1692       .
     1693     end.
     1694     else do:
     1695       assign
     1696         v-change-sign = -1
     1697       .
     1698     end.
     1699     assign
     1700       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1701     .
     1702     if p-change-value = 0
     1703     then do:
     1704       run diasize_position-resize-button in this-procedure .
     1705       return .
     1706     end.
     1707     move_block:
     1708     do
     1709     on error undo move_block, leave move_block
     1710     :
     1711       if retry
     1712       then do:
     1713         do
     1714         on error undo move_block, leave move_block
     1715         :
     1716           if p-change-value > 0
     1717           then do:
     1718             for each buf_temp-diasize-handle
     1719             on error undo, next
     1720             :
     1721               assign
     1722                 v-object-handle = buf_temp-diasize-handle.handle-value
     1723               .
     1724               if v-object-handle <> v-diasize-resize-button
     1725               then do:
     1726                 assign
     1727                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1728                 .
     1729               end.
     1730             end.
     1731             assign
     1732               v-diasize-browse-handle :width = v-browse-width
     1733             .
     1734             for each buf_temp-browse-handle
     1735               where buf_temp-browse-handle.browse-type = 'width':u
     1736             on error undo, next
     1737             :
     1738               assign
     1739                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1740               .
     1741             end.
     1742             assign
     1743               frame Dialog-Frame :width = v-frame-width
     1744             .
     1745             if frame Dialog-Frame :scrollable = true
     1746             then do:
     1747               assign
     1748                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1749               .
     1750             end.
     1751             run diasize_position-resize-button in this-procedure .
     1752           end.
     1753           else do:
     1754             if frame Dialog-Frame :scrollable = true
     1755             then do:
     1756               assign
     1757                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1758               .
     1759             end.
     1760             assign
     1761               frame Dialog-Frame :width = v-frame-width
     1762             .
     1763             for each buf_temp-browse-handle
     1764               where buf_temp-browse-handle.browse-type = 'width':u
     1765             on error undo, next
     1766             :
     1767               assign
     1768                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1769               .
     1770             end.
     1771             assign
     1772               v-diasize-browse-handle :width = v-browse-width
     1773             .
     1774             for each buf_temp-diasize-handle
     1775             on error undo, next
     1776             :
     1777               assign
     1778                 v-object-handle = buf_temp-diasize-handle.handle-value
     1779               .
     1780               if v-object-handle <> v-diasize-resize-button
     1781               then do:
     1782                 assign
     1783                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1784                 .
     1785               end.
     1786             end.
     1787             run diasize_position-resize-button in this-procedure .
     1788           end.
     1789           assign
     1790             v-diasize-change-size = false
     1791           .
     1792           leave move_block .
     1793         end.
     1794       end.
     1795       assign
     1796         v-diasize-need-full-display = true
     1797       .
     1798       if v-diasize-change-size = false
     1799       then do:
     1800         assign
     1801           v-diasize-change-size = true
     1802         .
     1803       end.
     1804       else do:
     1805         return .
     1806       end.
     1807       assign
     1808         v-frame-width = frame Dialog-Frame :width
     1809         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1810         v-browse-width = v-diasize-browse-handle :width
     1811       .
     1812       for each buf_temp-browse-handle
     1813         where buf_temp-browse-handle.browse-type = 'width':u
     1814       :
     1815         assign
     1816           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1817         .
     1818       end.
     1819       for each buf_temp-diasize-handle
     1820       :
     1821         delete buf_temp-diasize-handle .
     1822       end.
     1823       assign
     1824         v-field-group-handle = frame Dialog-Frame :first-child
     1825       .
     1826       do while valid-handle(v-field-group-handle)
     1827       :
     1828         assign
     1829           v-object-handle = v-field-group-handle :first-child
     1830         .
     1831         do while valid-handle(v-object-handle)
     1832         :
     1833           if  v-object-handle <> v-diasize-browse-handle :handle
     1834           and v-object-handle <> v-diasize-resize-button
     1835           and can-query(v-object-handle, "row")
     1836           and can-query(v-object-handle, "height")
     1837           and ( v-object-handle :col + v-object-handle :width
     1838                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1839               )
     1840           then do:
     1841             find first buf_temp-browse-handle
     1842               where buf_temp-browse-handle.browse-type   = 'width':u
     1843                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1844               no-error .
     1845             if available buf_temp-browse-handle
     1846             then do:
     1847             end.
     1848             else do:
     1849               create buf_temp-diasize-handle .
     1850               assign
     1851                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1852                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1853               .
     1854             end.
     1855           end.
     1856           assign
     1857             v-object-handle = v-object-handle :next-sibling
     1858           .
     1859         end.
     1860         assign
     1861           v-field-group-handle = v-field-group-handle :next-sibling
     1862         .
     1863       end.
     1864       do with frame Dialog-Frame
     1865       :
     1866         hide v-diasize-resize-button .
     1867         v-diasize-resize-button :row = 1.
     1868         v-diasize-resize-button :column = 1.
     1869       end.
     1870       if p-change-value > 0
     1871       then do:
     1872         if frame Dialog-Frame :scrollable = true
     1873         then do:
     1874           assign
     1875             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1876             no-error .
     1877           if error-status :error
     1878           or error-status :get-message(1) <> ""
     1879           then do:
     1880             undo move_block, retry move_block.
     1881           end.
     1882         end.
     1883         assign
     1884           frame Dialog-Frame :width = v-frame-width + p-change-value
     1885           no-error .
     1886         if error-status :error
     1887         or error-status :get-message(1) <> ""
     1888         then do:
     1889           undo move_block, retry move_block.
     1890         end.
     1891         assign
     1892           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1893         no-error .
     1894         if error-status :error
     1895         or error-status :get-message(1) <> ""
     1896         then do:
     1897           undo move_block, retry move_block.
     1898         end.
     1899         for each buf_temp-browse-handle
     1900           where buf_temp-browse-handle.browse-type = 'width':u
     1901         on error undo move_block, retry move_block
     1902         :
     1903           assign
     1904             buf_temp-browse-handle.browse-handle :width
     1905               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1906             no-error .
     1907           if error-status :error
     1908           or error-status :get-message(1) <> ""
     1909           then do:
     1910             undo move_block, retry move_block .
     1911           end.
     1912         end.
     1913         for each buf_temp-diasize-handle
     1914         on error undo move_block, retry move_block
     1915         :
     1916           assign
     1917             v-object-handle = buf_temp-diasize-handle.handle-value
     1918           .
     1919           if v-object-handle <> v-diasize-resize-button
     1920           then do:
     1921             assign
     1922               v-object-handle :col = v-object-handle :col + p-change-value
     1923               no-error .
     1924             if error-status :error
     1925             or error-status :get-message(1) <> ""
     1926             then do:
     1927               undo move_block, retry move_block .
     1928             end.
     1929           end.
     1930         end.
     1931       end.
     1932       else do:
     1933         for each buf_temp-diasize-handle
     1934         on error undo move_block, retry move_block
     1935         :
     1936           assign
     1937             v-object-handle = buf_temp-diasize-handle.handle-value
     1938           .
     1939           if v-object-handle <> v-diasize-resize-button
     1940           then do:
     1941             assign
     1942               v-object-handle :col = v-object-handle :col + p-change-value
     1943               no-error .
     1944             if error-status :error
     1945             or error-status :get-message(1) <> ""
     1946             then do:
     1947               undo move_block, retry move_block .
     1948             end.
     1949           end.
     1950         end.
     1951         for each buf_temp-browse-handle
     1952           where buf_temp-browse-handle.browse-type = 'width':u
     1953         on error undo move_block, retry move_block
     1954         :
     1955           assign
     1956             buf_temp-browse-handle.browse-handle :width
     1957               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1958             no-error .
     1959           if error-status :error
     1960           or error-status :get-message(1) <> ""
     1961           then do:
     1962             undo move_block, retry move_block .
     1963           end.
     1964         end.
     1965         assign
     1966           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1967           no-error .
     1968         if error-status :error
     1969         or error-status :get-message(1) <> ""
     1970         then do:
     1971           undo move_block, retry move_block.
     1972         end.
     1973         assign
     1974           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1975         no-error .
     1976         if error-status :error
     1977         or error-status :get-message(1) <> ""
     1978         then do:
     1979           undo move_block, retry move_block.
     1980         end.
     1981         if frame Dialog-Frame :scrollable = true
     1982         then do:
     1983           assign
     1984             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1985           no-error .
     1986           if error-status :error
     1987           or error-status :get-message(1) <> ""
     1988           then do:
     1989             undo move_block, retry move_block.
     1990           end.
     1991         end.
     1992       end.
     1993       if p-move-resize
     1994       then do:
     1995         run diasize_position-resize-button in this-procedure .
     1996       end.
     1997       if v-diasize-wndstore = true
     1998       then do:
     1999         if connected("ub") = true
     2000         then do:
     2001           define variable v-cntxt-db-num        as integer   no-undo .
     2002           define variable v-cntxt-userid        as character no-undo .
     2003           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2004                                             , OUTPUT v-cntxt-userid
     2005                                             ) .
     2006           run gbl/wndsizew.p
     2007             (input  v-cntxt-db-num
     2008             ,input  v-cntxt-userid
     2009             ,input  v-diasize-proc-name
     2010             ,input  'width':u
     2011             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2012             ) .
     2013         end.
     2014       end.
     2015     end.
     2016     assign
     2017       v-diasize-change-size = false
     2018     .
     2019   end procedure.
     2020   procedure diasize_set-width :
     2021     define input  parameter p-new-width  as decimal   no-undo .
     2022     define input  parameter p-move-resize as logical   no-undo .
     2023     do
     2024     on error undo, return error return-value
     2025     :
     2026       run diasize_change-width in this-procedure
     2027         (input  (p-new-width - frame Dialog-Frame :width)
     2028         ,input  p-move-resize
     2029         ) .
     2030     end.
     2031   end procedure.
     2032   procedure diasize_position-resize-button :
     2033     do with frame Dialog-Frame
     2034     :
     2035       hide v-diasize-resize-button .
     2036       assign
     2037         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2038                     - 1
     2039                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2040         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2041                     - 1
     2042                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2043       .
     2044       view v-diasize-resize-button .
     2045     end.
     2046   end procedure.
     2047   on alt-right anywhere
     2048   do:
     2049     run diasize_change-width in this-procedure
     2050       (input 1
     2051       ,input true
     2052       ) .
     2053     return no-apply .
     2054   end.
     2055   on alt-left anywhere
     2056   do:
     2057     run diasize_change-width in this-procedure
     2058       (input -1
     2059       ,input true
     2060       ) .
     2061     return no-apply .
     2062   end.
     2063   on alt-down anywhere
     2064   do:
     2065     run diasize_change-height in this-procedure
     2066       (input 1
     2067       ,input true
     2068       ) .
     2069     return no-apply .
     2070   end.
     2071   on alt-up anywhere
     2072   do:
     2073     run diasize_change-height in this-procedure
     2074       (input -1
     2075       ,input true
     2076       ) .
     2077     return no-apply .
     2078   end.
     2079   on alt-enter of frame Dialog-Frame
     2080   do:
     2081     run diasize_maximize in this-procedure
     2082       (input  ?
     2083       ).
     2084     return no-apply .
     2085   end.
     2086   procedure diasize_end-move :
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       define variable v-row-delta as decimal   no-undo .
     2091       define variable v-col-delta as decimal   no-undo .
     2092       define variable v-new-row as decimal   no-undo .
     2093       define variable v-new-col as decimal   no-undo .
     2094       assign
     2095         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2096         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2097       .
     2098       assign
     2099         v-row-delta = v-new-row - frame Dialog-Frame :height
     2100         v-col-delta = v-new-col - frame Dialog-Frame :width
     2101       .
     2102       run diasize_change-height in this-procedure
     2103         (input v-row-delta
     2104         ,input true
     2105         ) .
     2106       run diasize_change-width in this-procedure
     2107         (input v-col-delta
     2108         ,input true
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_maximize :
     2113     define input  parameter p-action as logical   no-undo .
     2114     do
     2115     on error undo, return error return-value
     2116     :
     2117       if p-action = ?
     2118       then do:
     2119         if v-diasize-need-maximize = true
     2120         then do:
     2121           assign
     2122             p-action = true
     2123           .
     2124         end.
     2125         else do:
     2126           assign
     2127             p-action = false
     2128           .
     2129         end.
     2130       end.
     2131       if p-action = true
     2132       then do:
     2133         run diasize_change-height in this-procedure
     2134           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2135               - frame Dialog-Frame :height-chars
     2136           ,input true
     2137           ) .
     2138         run diasize_change-width in this-procedure
     2139           (input session :width-chars
     2140               - frame Dialog-Frame :width-chars
     2141           ,input true
     2142           ) .
     2143         assign
     2144           v-diasize-need-maximize = false
     2145         .
     2146       end.
     2147       else do:
     2148         run diasize_change-width in this-procedure
     2149           (input v-diasize-orig-frame-width
     2150               - frame Dialog-Frame :width-chars
     2151           ,input true
     2152           ) .
     2153         run diasize_change-height in this-procedure
     2154           (input v-diasize-orig-frame-height
     2155               - frame Dialog-Frame :height-chars
     2156           ,input true
     2157           ) .
     2158         assign
     2159           v-diasize-need-maximize = true
     2160         .
     2161       end.
     2162     end.
     2163   end procedure.
     2164   procedure diasize_restore-orig-size :
     2165     do
     2166     on error undo, return error return-value
     2167     :
     2168       assign
     2169         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2170         v-diasize-current-frame-height = frame Dialog-Frame :height
     2171       .
     2172       run diasize_set-height in this-procedure
     2173         (input  v-diasize-orig-frame-height
     2174         ,input  true
     2175         ) .
     2176       run diasize_set-width in this-procedure
     2177         (input  v-diasize-orig-frame-width
     2178         ,input  true
     2179         ) .
     2180     end.
     2181   end procedure.
     2182   procedure diasize_restore-current-size :
     2183     do
     2184     on error undo, return error return-value
     2185     :
     2186       run diasize_set-height in this-procedure
     2187         (input  v-diasize-current-frame-height
     2188         ,input  true
     2189         ) .
     2190       run diasize_set-width in this-procedure
     2191         (input  v-diasize-current-frame-width
     2192         ,input  true
     2193         ) .
     2194     end.
     2195   end procedure.
     2196   procedure diasize_set-browse-handle :
     2197     define input  parameter p-browse-handle as handle   no-undo .
     2198     define buffer buf_temp-browse-handle for temp-browse-handle .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       assign
     2203         v-diasize-browse-handle = p-browse-handle
     2204       .
     2205       for each buf_temp-browse-handle
     2206       on error undo, return error return-value
     2207       :
     2208         delete buf_temp-browse-handle .
     2209       end.
     2210     end.
     2211   end procedure.
     2212   procedure diasize_add_browse :
     2213     define input  parameter p-browse-type   as character no-undo .
     2214     define input  parameter p-browse-handle as handle    no-undo .
     2215     define buffer buf_temp-browse-handle for temp-browse-handle .
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       assign
     2220         v-diasize-browse-number = v-diasize-browse-number + 1
     2221       .
     2222       create buf_temp-browse-handle .
     2223       assign
     2224         buf_temp-browse-handle.browse-type   = p-browse-type
     2225         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2226         buf_temp-browse-handle.browse-handle = p-browse-handle
     2227       .
