       27   define variable vss-revision    as character no-undo init "$Revision$":U .
       28   define variable vss-author      as character no-undo init "$Author$":U .
       29   define variable vss-date        as character no-undo init "$Date$":U .
       30   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       31   define variable vss-archive     as character no-undo init "$Archive$":U .
       32   define variable vss-description as character no-undo init "Блокировка пистолетов".
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   procedure proc-alt-shift-f2:
       92     if not ibs.th.gbl.gbl-var:rcode
       93   then
       94     run gbl\inidebug.p .
       95   end.
       96   procedure proc-alt-shift-f3:
       97     run gbl/prvssinf.p
       98       ( input this-procedure
       99       ) .
      100   end.
      101   define variable v-inform-launched as logical no-undo initial false .
      102   procedure proc-alt-shift-f4:
      103     define variable v-action as character no-undo .
      104     if v-inform-launched = false then do:
      105       assign
      106         v-inform-launched = true
      107       .
      108       run gbl/d-inform.w
      109         (  input self
      110         ,  input this-procedure
      111         , output v-action
      112         ) no-error .
      113       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      114       assign
      115         v-inform-launched = false
      116       .
      117     end.
      118   end.
      119   procedure proc-alt-f1:
      120     run gbl/corrhelp.p
      121       (input this-procedure
      122       ) .
      123   end .
      124   on alt-shift-f2 anywhere do:
      125     run proc-alt-shift-f2.
      126   end.
      127   on alt-shift-f3 anywhere do:
      128     run proc-alt-shift-f3 in this-procedure .
      129   end.
      130   on alt-shift-f4 anywhere do:
      131     run proc-alt-shift-f4 in this-procedure.
      132   end.
      133   on alt-f1 anywhere do:
      134     run proc-alt-f1 in this-procedure .
      135   end.
      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable c-point  as character no-undo .
      138   define variable tbl      as character no-undo .
      139   define variable join-tbl as character no-undo .
      140   define variable fld      as character no-undo .
      141   define variable lab      as character no-undo .
      142   define variable spr      as character no-undo .
      143   define variable dim      as character no-undo .
      144   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   procedure fltfield-clear :
      146     define output parameter loc-fld as character no-undo.
      147     define output parameter loc-lab as character no-undo .
      148     define output parameter loc-spr as character no-undo .
      149     define output parameter loc-dim as character no-undo .
      150     assign
      151       loc-fld = ""
      152       loc-lab = ""
      153       loc-spr = ""
      154       loc-dim = "0"
      155     .
      156   end procedure .
      157   procedure fltfield-add :
      158     define input        parameter par-fld as character no-undo.
      159     define input        parameter par-lab as character no-undo .
      160     define input        parameter par-spr as character no-undo .
      161     define input-output parameter loc-fld as character no-undo.
      162     define input-output parameter loc-lab as character no-undo .
      163     define input-output parameter loc-spr as character no-undo .
      164     define input-output parameter loc-dim as character no-undo .
      165     do
      166     on error undo, return error
      167     :
      168       assign
      169       loc-fld = if loc-dim = '0'
      170                 then par-fld
      171                 else (loc-fld + chr(44) + par-fld)
      172       loc-lab = if loc-dim = '0'
      173                 then par-lab
      174                 else (loc-lab + chr(44) + par-lab)
      175       loc-spr = if loc-dim = '0'
      176                 then par-spr
      177                 else (loc-spr + chr(44) + par-spr)
      178       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      179                 string(integer(if num-entries(loc-dim) > 1
      180                               then entry(2, loc-dim)
      181                               else entry(1, loc-dim)
      182                               ) + 1)
      183       no-error
      184       .
      185     end.
      186   end procedure.
      187   define new global shared variable g#library  as handle no-undo .
      188   define new global shared variable g#library2 as handle no-undo .
      189   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   function nzpl-spl returns logical
      191   (input p-obj-type as character
      192                                   , input p-obj-code as integer):
      193   define variable v-dopi    as integer no-undo .
      194   define variable v-param-type as character no-undo .
      195   define variable v-value-character as character no-undo .
      196   define variable v-value-date as date no-undo .
      197   define variable v-value-decimal as decimal no-undo .
      198   define variable v-value-integer as integer no-undo .
      199   define variable v-value-logical as logical no-undo .
      200   define variable v-tth as handle no-undo .
      201   define variable dflt-cd as character no-undo .
      202   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   define variable v-param-type3 as character no-undo .
      204   define variable v-value-date3 as date no-undo .
      205   define variable v-value-decimal3 as decimal no-undo .
      206   define variable v-value-integer3 as INTEGER no-undo .
      207   define variable v-value-logical3 AS LOGICAL no-undo .
      208   define variable v-tth3 as handle no-undo .
      209   run adm/shattri.p (
      210       input "get":U
      211       ,input  p-obj-type
      212       ,input  p-obj-code
      213       ,input  'cd-sending':U
      214       ,input  'dflt-cd':U
      215       ,output dflt-cd
      216       ,output v-value-date3
      217       ,output v-value-decimal3
      218       ,output v-value-integer3
      219       ,output v-value-logical3
      220       ,output v-param-type3
      221       ,INPUT-OUTPUT table-handle v-tth3
      222       ) no-error .
      223   delete object v-tth3 no-error.
      224   if dflt-cd <> 'IBM':U
      225   and dflt-cd <> 'IBM-XML':U then return no.
      226   if dflt-cd = 'IBM-XML':U then return yes.
      227   run adm/shattri.p (
      228       input "get":U
      229       ,input  p-obj-type
      230       ,input  p-obj-code
      231       ,input  'cd-type-ibm':U
      232       ,input  'ibmspool':U
      233       ,output v-value-character
      234       ,output v-value-date
      235       ,output v-value-decimal
      236       ,output v-value-integer
      237       ,output v-value-logical
      238       ,output v-param-type
      239       ,INPUT-OUTPUT table-handle v-tth
      240       ) no-error .
      241   if error-status:error then do:
      242     delete object v-tth.
      243     return no.
      244   end.
      245   delete object v-tth.
      246   assign
      247   v-dopi = v-value-integer no-error .
      248   if v-dopi >= 6 then return yes.
      249   end. // FUNCTION/method
      250   FUNCTION nzpl-two returns logical
      251                                    (input p-obj-type as character
      252                                     , input p-obj-code as integer):
      253     define variable v-nzpl-two as logical no-undo.
      254     run
      255     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      256     return v-nzpl-two.
      257   end. // FUNCTION/method
      258   procedure nzpl-two-proc :
      259   define input  parameter p-obj-type   as character no-undo.
      260   define input  parameter p-obj-code   as integer   no-undo.
      261   define output parameter varge-two-pl as logical   no-undo.
      262   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      263   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      264   //do on error undo, return error return-value :
      265   assign
      266     varge-two-pl = no.
      267   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      268                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      269                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      270     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      271                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      272                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      273                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      274                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      275                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      276     if available bf-other_pl-gds-pump then do:
      277       assign
      278         varge-two-pl = yes.
      279       leave.
      280     end.
      281   end.
      282   //end.
      283   end. // procedure/method .
      284   procedure cplgdspm :
      285     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      286     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      287     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      288     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      289     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      290     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      291       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      292       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      293       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      294       define buffer bf-place                for ub.place.
      295       if parstatus = 'тек':U then do:
      296         for each bf_pl-gds-pump no-lock
      297           where bf_pl-gds-pump.obj-type  =  parobj-type
      298             and bf_pl-gds-pump.obj-code  =  parobj-code
      299             and bf_pl-gds-pump.gds-code  =  pargds-code
      300             and bf_pl-gds-pump.pump-code =  parpump-code
      301             and bf_pl-gds-pump.pl-code   <> parpl-code
      302             and bf_pl-gds-pump.status_   =  'тек':U
      303         on error undo, return error
      304         :
      305           find first place where
      306                      place.obj-type = parobj-type
      307                  and place.obj-code = parobj-code
      308                  and place.pl-code  = parpl-code
      309                no-lock no-error.
      310           find first bf-place where
      311                      bf-place.obj-type = parobj-type
      312                  and bf-place.obj-code = parobj-code
      313                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      314                no-lock no-error.
      315           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      316             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      317                                        ,parobj-type
      318                                        ,parobj-code
      319                                        ,if available place then place.loc1 else string(parpl-code)
      320                                        ,pargds-code
      321                                        ,parpump-code
      322                                        ,parstatus
      323                                        ,chr(10)
      324                                       )
      325                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      326                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      327                                     ).
      328           end.
      329           else do:
      330             find first bf_pl-pump-nozzle no-lock
      331               where bf_pl-pump-nozzle.obj-type  = parobj-type
      332                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      333                 and bf_pl-pump-nozzle.pump-code = parpump-code
      334                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      335               no-error.
      336             if available bf_pl-pump-nozzle then do:
      337               find first bf-other_pl-pump-nozzle no-lock
      338                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      339                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      340                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      341                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      342                 no-error.
      343               if available bf-other_pl-pump-nozzle
      344                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      345               then do:
      346                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      347                                          ,parobj-type
      348                                          ,parobj-code
      349                                          ,if available place then place.loc1 else string(parpl-code)
      350                                          ,pargds-code
      351                                          ,parpump-code
      352                                          ,parstatus
      353                                          ,chr(10)
      354                                        )
      355                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      356                                           ,bf_pl-gds-pump.obj-type
      357                                           ,bf_pl-gds-pump.obj-code
      358                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      359                                           ,bf_pl-gds-pump.status_
      360                                         ).
      361               end.
      362             end.
      363           end.
      364         end.
      365       end.
      366   end . // procedure/method
      367   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define variable v-waitfram-action01         as character   no-undo .
      378   define variable v-waitfram-action02         as character   no-undo .
      379   define variable v-waitfram-action03         as character   no-undo .
      380   define variable mWaitFramTextBeg            as character   no-undo.
      381   define variable mWaitFramTextEnd            as character   no-undo.
      382   define variable mWaitFramView               as logical     no-undo.
      383   define variable mWaitProcEvent              as logical     no-undo init yes.
      384   define variable mWaitFramInterval           as integer     no-undo init 1 .
      385   define variable mWaitFramStop               as logical     no-undo.
      386   define variable mWaitFramStopUser           as logical     no-undo.
      387   define variable mWaitFramStopTimeOut        as logical     no-undo.
      388   define variable mWaitFramStartProc          as datetime-tz no-undo.
      389   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      390   define button B-WaitFramStop auto-end-key
      391        label "Стоп"
      392        size 10 by 1 tooltip "Остоновить процесс".
      393   define button B-viewProcInfo
      394        label "Информация"
      395        size 15 by 1 tooltip "Информация о процесс".
      396   define frame waitfram
      397     v-waitfram-action01 format "x(72)" no-label skip
      398     v-waitfram-action02 format "x(72)" no-label skip
      399     v-waitfram-action03 format "x(72)" no-label skip
      400     B-viewProcInfo
      401     B-WaitFramStop at row 4 col 30
      402     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      403     .
      404   define new global shared variable mBatchMode as logical no-undo init ?.
      405   define variable mFramBachModHandle as handle no-undo.
      406   mFramBachModHandle = frame waitfram:handle.
      407   define variable mFameOldVis as logical no-undo.
      408   define variable mVisCUrentVin as logical no-undo.
      409   if session:batch-mode
      410   then
      411      mBatchMode = yes.
      412   if mBatchMode = ? then do:
      413     mVisCUrentVin = current-window:visible.
      414     mFameOldVis = mFramBachModHandle:visible.
      415     mFramBachModHandle:visible  = yes.
      416     mBatchMode = mFramBachModHandle:visible ne yes.
      417     mFramBachModHandle:visible = mFameOldVis.
      418     current-window:visible = mVisCUrentVin.
      419   end.
      420    if  log-manager:logfile-name ne ?
      421     then DO:
      422         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      423         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      424         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      425     end.
      426   on choose of B-WaitFramStop in frame waitfram
      427   do:
      428     mWaitFramStop = yes.
      429     mWaitFramStopUser = yes.
      430   end.
      431   function waitfram-check-timeout returns logical():
      432      define variable vtime as int64 no-undo.
      433      if mWaitFramStopTimeOut
      434      then
      435         return yes.
      436      vtime = ( now - mWaitFramStartProc ) / 1000 .
      437      if     mWaitFramTimeOut ne ?
      438         and mWaitFramTimeOut ne 0
      439         and mWaitFramTimeOut lt vtime
      440      then do:
      441         mWaitFramStopTimeOut = yes.
      442      end.
      443      return mWaitFramStopTimeOut.
      444   end.
      445   procedure waitfram-hide :
      446     if not session:batch-mode
      447     then do
      448     on error undo, return error return-value
      449     :
      450       pause 0 before-hide .
      451       if not mBatchMode then
      452         hide frame waitfram .
      453     if     not mWaitFramView
      454        and mWaitProcEvent
      455     then
      456       process events .
      457     end.
      458   end procedure.
      459   procedure waitfram-show :
      460     define input  parameter p-message as character no-undo .
      461     define variable v-left-margin as integer   no-undo .
      462     if not session:batch-mode
      463     then do
      464     on error undo, return error return-value
      465     :
      466       if length(p-message) <= 70 then do:
      467         assign
      468           v-left-margin = integer((70 - length(p-message)) / 2)
      469         .
      470         assign
      471           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      472         .
      473         assign
      474           v-waitfram-action01 = " "
      475           v-waitfram-action02 = " "
      476                                    + fill(" ", v-left-margin)
      477                                    + p-message
      478           v-waitfram-action03 = " "
      479         .
      480       end.
      481       else do:
      482         define variable vRindex1 as integer no-undo.
      483         define variable vRindex2 as integer no-undo.
      484         vRindex1 = r-index(p-message," ",70).
      485         if vRindex1 = 0
      486         then
      487            vRindex1 = 70.
      488         if length(p-message)  <= vRindex1 + 70 then do:
      489           assign
      490             v-waitfram-action01 = " "
      491             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      493           .
      494         end.
      495         else do:
      496           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      497           if vRindex2 <= vRindex1
      498           then
      499              vRindex2 = vRindex1 + 70.
      500           assign
      501             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      502             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      503             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      504           .
      505         end.
      506       end.
      507       B-viewProcInfo:visible   in frame waitfram = no.
      508       B-viewProcInfo:sensitive in frame waitfram = no.
      509       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      510       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      511       if  (   mWaitFramView
      512          or  mWaitProcEvent)
      513          and not mBatchMode
      514       then
      515          display
      516             v-waitfram-action01 skip
      517             v-waitfram-action02 skip
      518             v-waitfram-action03 skip
      519          with frame waitfram .
      520       if     mWaitFramView
      521          then do:
      522             if     mWaitFramInterval ne ?
      523                and not mBatchMode
      524             then
      525                wait-for go of frame waitfram pause mWaitFramInterval.
      526          end.
      527          else
      528             if     mWaitProcEvent
      529                and not mBatchMode
      530             then
      531                process events .
      532     end.
      533   end procedure.
      534      procedure waitfram-show-this:
      535         define input  parameter iInterval as int64 no-undo.
      536         define variable vtime as int64 no-undo.
      537         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      538         mWaitFramInterval = iInterval.
      539         run waitfram-show (substitute("&1&2 &3&4" ,
      540                                       mWaitFramTextBeg ,
      541                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      542                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      543                                       mWaitFramTextEnd
      544                                      )
      545                           ).
      546      end.
      547      procedure WaitFramRunPause:
      548         define input  parameter iInterval as dec no-undo.
      549         define variable vStart  as datetime-tz no-undo.
      550         define variable vend    as datetime-tz no-undo.
      551         define variable vint as int64 no-undo.
      552         define variable vOk as logical no-undo.
      553         vStart = now.
      554         vend   = vStart.
      555         publish "WaitFramPause" (iInterval,output vOk).
      556         vend   =  now.
      557         vint = vend - vStart.
      558         vint = iInterval - vint / 1000.
      559         if     not mWaitFramStop
      560            and (   vint > 0
      561                 or (    not vOk
      562                     and iInterval eq ?
      563                     )
      564                 )
      565         then
      566            run waitfram-show-this (iInterval).
      567         vend   =  now.
      568         vint = vend - vStart.
      569         vint = iInterval - vint / 1000.
      570         if     not mWaitFramStop
      571            and vint > 0
      572         then do:
      573            run gbl/pause.p (vint * 1000).
      574         end.
      575         if iInterval ne ?
      576         then
      577            publish "WaitFramStop".
      578         waitfram-check-timeout().
      579      end.
      580      procedure WaitFramWaitFor:
      581         define input  parameter iInterval as dec no-undo.
      582         assign
      583            mWaitFramStartProc   = now
      584            mWaitFramStopUser    = no
      585            mWaitFramStopTimeOut = no
      586         .
      587         block-wait:
      588         do while not mWaitFramStop:
      589            run WaitFramRunPause (iInterval).
      590            if  waitfram-check-timeout()
      591            then do:
      592               leave block-wait.
      593            end.
      594         end.
      595         run waitfram-hide.
      596      end.
      597   procedure waitfram-join :
      598     define input  parameter p-line-1  as character no-undo .
      599     define input  parameter p-line-2  as character no-undo .
      600     define input  parameter p-line-3  as character no-undo .
      601     define output parameter p-message as character no-undo .
      602     do
      603     on error undo, return error return-value
      604     :
      605       assign
      606         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      607                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      608                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      609       .
      610     end.
      611   end procedure.
      612   function waitfram-join-function returns character
      613     (input p-line-1 as character
      614     ,input p-line-2 as character
      615     ,input p-line-3 as character
      616     ).
      617     define variable v-message as character no-undo .
      618     run waitfram-join in this-procedure
      619       (input  p-line-1
      620       ,input  p-line-2
      621       ,input  p-line-3
      622       ,output v-message
      623       ) .
      624     return v-message .
      625   end function .
      626   define variable varlog            as logical   no-undo.
      627   define variable gds-rec           as recid     no-undo .
      628   define variable v-doc-rec         as recid     no-undo .
      629   define variable pl-list           as character no-undo .
      630   define variable v-tth             as handle    no-undo.
      631   define variable v-Param-Type      as character no-undo.
      632   define variable glog              as logical   no-undo.
      633   define variable v-value-character as character no-undo.
      634   define variable v-value-date      as date      no-undo.
      635   define variable v-value-decimal   as decimal   no-undo.
      636   define variable v-value-integer   as integer   no-undo.
      637   define variable v-value-logical   as logical   no-undo.
      638   define variable filter-label      as character no-undo init "Блокировка пистолетов" .
      639   define variable filter-label0     as character no-undo init "Блокировка пистолетов" .
      640   define variable filter-point      as character no-undo init "blockplgdspm".
      641   define variable filter-point0     as character no-undo init "blockplgdspm".
      642   define variable v-ok              as logical   no-undo .
      643   define variable v-title           as character no-undo .
      644   DEFINE BUTTON b-block
      645      LABEL "&Блок в МП"
      646      SIZE 10 BY 1 TOOLTIP "Установить статут <Блокированный>".
      647   DEFINE BUTTON b-cur
      648      LABEL "&Текущий"
      649      SIZE 10 BY 1 TOOLTIP "Установить статут <Текущий>".
      650   DEFINE BUTTON b-exit AUTO-GO
      651      LABEL "&Выход"
      652      SIZE 10 BY 1
      653      BGCOLOR 8 .
      654   DEFINE BUTTON b-help
      655      LABEL "&Помощь"
      656      SIZE 3 BY 1
      657      BGCOLOR 8 .
      658   DEFINE BUTTON B-hist
      659      LABEL "Ис&тория"
      660      SIZE 3 BY 1.
      661   DEFINE BUTTON b-mark
      662      LABEL "&*"
      663      SIZE 3 BY 1.
      664   DEFINE BUTTON b-repeate-block
      665      LABEL "b-repeate-block"
      666      SIZE 10 BY 1.
      667   DEFINE BUTTON b-repeate-unblock
      668      LABEL "b-repeate-unblock"
      669      SIZE 10 BY 1.
      670   DEFINE BUTTON b-unblock
      671      LABEL "&Разблок"
      672      SIZE 10 BY 1.
      673   DEFINE BUTTON bt-not-sel-all
      674      LABEL "+"
      675      SIZE 3 BY 1 TOOLTIP "Выбрать все".
      676   DEFINE BUTTON bt-not-sel-desel-all
      677      LABEL "-"
      678      SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      679   DEFINE VARIABLE c-nozzle-code AS INTEGER   FORMAT ">>9":U INITIAL 0
      680      LABEL "Номер пистолета"
      681      VIEW-AS COMBO-BOX INNER-LINES 5
      682      LIST-ITEMS "0","1","2","3","4"
      683      DROP-DOWN-LIST
      684      SIZE 15.5 BY 1 NO-UNDO.
      685   DEFINE VARIABLE c-pump-code   AS INTEGER   FORMAT ">>9":U INITIAL 0
      686      LABEL "Номер ТРК"
      687      VIEW-AS COMBO-BOX INNER-LINES 5
      688      LIST-ITEMS "0","1","2","3","4"
      689      DROP-DOWN-LIST
      690      SIZE 15.5 BY 1 NO-UNDO.
      691   DEFINE VARIABLE search-goods  AS CHARACTER FORMAT "X(256)":U
      692      LABEL "Фильтр по товару"
      693      VIEW-AS FILL-IN
      694      SIZE 60 BY 1 TOOLTIP "Введите начало любого слова в названии товара и нажать Enter" NO-UNDO.
      695   DEFINE QUERY b-plgdspm FOR
      696      X_marking
      697      SCROLLING.
      698   if parbutton = "un-block" then v-title = "Разблокировка пистолетов" .
      699   else v-title = "Блокировка пистолетов" .
      700   DEFINE BROWSE b-plgdspm
      701      QUERY b-plgdspm NO-LOCK DISPLAY
      702      X_marking.marking-string column-label "*" format "X(3)":U
      703      X_marking.pump-code FORMAT ">9":U
      704      X_marking.nozzle-code FORMAT ">9":U
      705      X_marking.artic FORMAT "X(16)":U
      706      X_marking.gds-code FORMAT "999999999":U
      707      X_marking.gds-name FORMAT "X(10)":U
      708      X_marking.loc1 COLUMN-LABEL "Резервуар" FORMAT "X(8)":U
      709      X_marking.status_ FORMAT "X(8)":U
      710      X_marking.pl-code COLUMN-LABEL "Код резервуара" FORMAT ">>>>>>>>>>>>9":U
      711      X_marking.pl-name COLUMN-LABEL "Название резервуара"
      712      X_marking.prod-code FORMAT ">>>>>>>>9":U
      713      X_marking.prod-type COLUMN-LABEL "товара" FORMAT "X(3)":U
      714       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.42.
      715   DEFINE FRAME Dialog-Frame
      716      b-exit AT ROW 1 COL 1.25
      717      b-cur AT ROW 1 COL 11.25
      718      b-unblock AT ROW 1 COL 21.25
      719      b-block AT ROW 1 COL 22
      720      b-repeate-block AT ROW 1 COL 22
      721      b-repeate-unblock AT ROW 1 COL 22
      722      B-hist AT ROW 1 COL 92.88
      723      b-help AT ROW 1 COL 95.88
