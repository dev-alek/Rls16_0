     2373   procedure get-context :
     2374      define output parameter p-db-num as integer          no-undo.
     2375      define output parameter p-user-id as character        no-undo.
     2376      define variable v-login               as character    no-undo.
     2377      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2378      define buffer buf_user-login  for ub.user-login .
     2379      do
     2380      on error undo, return error
     2381      :
     2382            FIND FIRST buf_sys-ctrl no-lock.
     2383            ASSIGN
     2384               v-login = USERID("ub")
     2385               p-db-num = buf_sys-ctrl.db-num
     2386            .
     2387            FIND FIRST buf_user-login
     2388                 WHERE buf_user-login.db-num = p-db-num
     2389                   AND buf_user-login.user-login = v-login
     2390                 no-lock
     2391                 no-error
     2392                 .
     2393            IF AVAILABLE buf_user-login
     2394            THEN DO:
     2395               assign
     2396                  p-user-id = buf_user-login.user-id
     2397               .
     2398            END.
     2399      end.
     2400   end procedure.
     2401       run diasize_init in this-procedure .
     2402   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2403   on F9 of frame Dialog-Frame anywhere do:
     2404     if not available ub.goods then
     2405       return no-apply.
     2406     gds-rec = recid (ub.goods).
     2407     run ref/gds-form.w ( input parparentproc
     2408                         ,input 'ПРОСМОТР':U
     2409                         ,input ?
     2410                         ,input ?
     2411                         ,input ?
     2412                         ,input-output gds-rec).
     2413     apply "entry" to b-plgdspm in frame Dialog-Frame.
     2414     return no-apply.
     2415   end.
     2416   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2417   do:
     2418     b-plgdspm :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2419   end.
     2420   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2421   on f5 of frame Dialog-Frame anywhere
     2422   do:
     2423      if available X_marking then v-doc-rec = recid(X_marking). OPEN QUERY b-plgdspm FOR EACH X_marking OUTER-JOIN BY X_marking.obj-type      BY X_marking.obj-code       BY X_marking.pump-code        BY X_marking.nozzle-code.   reposition b-plgdspm to recid v-doc-rec no-error. apply 'ENTRY' to b-plgdspm.
     2424       apply "VALUE-CHANGED" to b-plgdspm.
     2425   end.
     2426   MAIN-BLOCK:
     2427   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2428      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2429   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430     run mainmenu_getcntxt in parparentproc
     2431       (output v-cntxt-db-num
     2432       ,output v-cntxt-userid
     2433       ,output v-cntxt-level
     2434       ,output v-cntxt-host-code-obj
     2435       ,output v-cntxt-obj-type
     2436       ,output v-cntxt-obj-code
     2437       ,output v-cntxt-db-num-obj
     2438       ,output v-cntxt-is-admin
     2439       ) .
     2440   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2441   do:
     2442     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2443       (input  v-cntxt-db-num
     2444       ,input  v-cntxt-userid
     2445       ,input  0
     2446       ,input  'actn_nozzle-sts_work':U
     2447       ,input  'object':U
     2448       ,input  v-cntxt-host-code-obj
     2449       ,input  v-cntxt-obj-type
     2450       ,input  v-cntxt-obj-code
     2451       ,input  0
     2452       ,input  0
     2453       ,input  0
     2454       ,input  false
     2455       ,output v-ok
     2456       )  .
     2457   end.
     2458      if NOT v-ok then
     2459      do:
     2460         message "Недостаточно прав доступа для выполнения блокировки\разблокировки пистолетов в ручную." skip
     2461            "нет права - 'actn_nozzle-sts_work' "
     2462            view-as alert-box.
     2463         return no-apply .
     2464      end.
     2465      RUN enable_tt.
     2466      RUN enable_UI.
     2467      WAIT-FOR GO OF FRAME Dialog-Frame.
     2468   END.
     2469   RUN disable_UI.
     2470   PROCEDURE disable_UI :
     2471      HIDE FRAME Dialog-Frame.
     2472   END PROCEDURE.
     2473   PROCEDURE enable_tt :
     2474      FOR EACH X_pl-gds-pump       WHERE X_pl-gds-pump.obj-type = parobj-type  AND X_pl-gds-pump.obj-code = parobj-code NO-LOCK, ~
     2475         EACH X_goods WHERE X_goods.gds-code = X_pl-gds-pump.gds-code NO-LOCK, ~
     2476         EACH X_place WHERE X_place.pl-code = X_pl-gds-pump.pl-code NO-LOCK, ~
     2477         EACH X_pl-pump-nozzle WHERE X_pl-pump-nozzle.obj-type = X_pl-gds-pump.obj-type   AND X_pl-pump-nozzle.obj-code = X_pl-gds-pump.obj-code   AND X_pl-pump-nozzle.pl-code = X_pl-gds-pump.pl-code   AND X_pl-pump-nozzle.pump-code = X_pl-gds-pump.pump-code NO-LOCK     BY X_pl-gds-pump.obj-type      BY X_pl-gds-pump.obj-code       BY X_pl-pump-nozzle.pump-code        BY X_pl-pump-nozzle.nozzle-code:
     2478         find first X_marking where X_marking.pl-code = X_pl-gds-pump.pl-code and
     2479            X_marking.pump-code = X_pl-gds-pump.pump-code and
     2480            X_marking.gds-code = X_pl-gds-pump.gds-code and
     2481            X_marking.nozzle-code = X_pl-pump-nozzle.nozzle-code no-error .
     2482         if not available (X_marking) then
     2483         do:
     2484            create X_marking .
     2485            assign
     2486               X_marking.obj-code    = X_pl-gds-pump.obj-code
     2487               X_marking.obj-type    = X_pl-gds-pump.obj-type
     2488               X_marking.pl-code     = X_pl-gds-pump.pl-code
     2489               X_marking.pump-code   = X_pl-gds-pump.pump-code
     2490               X_marking.gds-code    = X_pl-gds-pump.gds-code
     2491               X_marking.nozzle-code = X_pl-pump-nozzle.nozzle-code
     2492               X_marking.artic       = X_goods.artic
     2493               X_marking.gds-code    = X_goods.gds-code
     2494               X_marking.gds-name    = X_goods.gds-name
     2495               X_marking.loc1        = X_place.loc1
     2496               X_marking.status_     = X_pl-gds-pump.status_
     2497               X_marking.pl-name     = X_place.pl-name
     2498               X_marking.prod-code   = X_goods.prod-code
     2499               X_marking.prod-type   = X_goods.prod-type
     2500               X_marking.search-log  = false
     2501               .
     2502         end.
     2503      end.
     2504   END PROCEDURE.
     2505   PROCEDURE iniTable :
     2506      for each X_marking:
     2507         for first X_pl-pump-nozzle WHERE X_pl-pump-nozzle.obj-type = X_marking.obj-type   AND
     2508            X_pl-pump-nozzle.obj-code = X_marking.obj-code   AND
     2509            X_pl-pump-nozzle.pl-code = X_marking.pl-code   AND
     2510            X_pl-pump-nozzle.pump-code = X_marking.pump-code ,
     2511            first X_place no-lock where X_place.pl-code = X_marking.pl-code,
     2512            first X_pl-gds-pump exclusive-lock where X_pl-gds-pump.gds-code = X_marking.gds-code and
     2513            X_pl-gds-pump.obj-code = X_pl-pump-nozzle.obj-code and
     2514            X_pl-gds-pump.obj-type = X_pl-pump-nozzle.obj-type and
     2515            X_pl-gds-pump.pl-code = X_pl-pump-nozzle.pl-code and
     2516            X_pl-gds-pump.pump-code = X_pl-pump-nozzle.pump-code:
     2517            X_pl-gds-pump.status_ = X_marking.status_ .
     2518         end.
     2519      end.
     2520   END PROCEDURE.
     2521   PROCEDURE enable_UI :
     2522      define variable ii            as integer   no-undo .
     2523      define variable v-pump-code   as character no-undo .
     2524      define variable v-nozzle-code as character no-undo .
     2525      for each X_marking by X_marking.pump-code by X_marking.nozzle-code:
     2526         if lookup(string(X_marking.pump-code), v-pump-code, ",") = 0 then
     2527            v-pump-code = v-pump-code + "," + string(X_marking.pump-code) .
     2528         if lookup(string(X_marking.nozzle-code), v-nozzle-code, ",") = 0 then
     2529            v-nozzle-code = v-nozzle-code + "," + string(X_marking.nozzle-code) .
     2530      end.
     2531      ASSIGN
     2532         c-pump-code:list-items  in frame Dialog-Frame   = v-pump-code
     2533         c-nozzle-code:list-items  in frame Dialog-Frame = v-nozzle-code .
     2534      DISPLAY search-goods
     2535         WITH FRAME Dialog-Frame.
     2536      if parbutton = "block" then
     2537      do:
     2538         ENABLE b-exit b-block B-hist b-help search-goods b-mark bt-not-sel-all c-nozzle-code c-pump-code
     2539            bt-not-sel-desel-all b-plgdspm
     2540            WITH FRAME Dialog-Frame.
     2541         hide b-unblock in frame Dialog-Frame .
     2542      end.
     2543      if parbutton = "un-block" then
     2544      do:
     2545         ENABLE b-exit b-unblock B-hist b-help search-goods b-plgdspm c-nozzle-code c-pump-code
     2546            WITH FRAME Dialog-Frame.
     2547         hide b-block in frame Dialog-Frame .
     2548      end.
     2549      else
     2550      do:
     2551         ENABLE b-exit B-hist b-help b-plgdspm
     2552            WITH FRAME Dialog-Frame.
     2553      end.
     2554      VIEW FRAME Dialog-Frame.
     2555      hide b-repeate-block b-repeate-unblock in frame Dialog-Frame .
     2556      OPEN QUERY b-plgdspm FOR EACH X_marking OUTER-JOIN BY X_marking.obj-type      BY X_marking.obj-code       BY X_marking.pump-code        BY X_marking.nozzle-code.
     2557   END PROCEDURE.
     2558   PROCEDURE local-stts :
     2559      define input  parameter p-stts as character no-undo .
     2560      define variable varrecid    as recid   no-undo.
     2561      define variable v-host-code as integer no-undo .
     2562      define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     2563      do transaction
     2564         on error undo, retry
     2565         :
     2566         if retry then
     2567         do:
     2568            message
     2569               vss-workfile vss-revision vss-description skip(1)
     2570               substitute( "Ошибка при приcвоении статуса <&1>!", p-stts ) skip
     2571               return-value skip
     2572               error-status :get-message(1)
     2573               view-as alert-box error.
     2574            undo, return error .
     2575         end.
     2576         find first buf_pl-gds-pump exclusive-lock where
     2577            recid(buf_pl-gds-pump) = recid(X_pl-gds-pump).
     2578         if buf_pl-gds-pump.status_ = p-stts then
     2579         do:
     2580            message
     2581               substitute( "Запись уже имеет статус <&1>.", p-stts )
     2582               view-as alert-box information
     2583               .
     2584            undo, return error .
     2585         end.
     2586   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2588     (input  parobj-type
     2589     ,input  parobj-code
     2590     ,output v-host-code
     2591     )  .
     2592   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2593   do:
     2594     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2595       (input  v-cntxt-db-num
     2596       ,input  v-cntxt-userid
     2597       ,input  0
     2598       ,input  'actn_plgdspm-sts_work':U
     2599       ,input  'object':U
     2600       ,input  v-host-code
     2601       ,input  parobj-type
     2602       ,input  parobj-code
     2603       ,input  0
     2604       ,input  0
     2605       ,input  0
     2606       ,input  true
     2607       ,output varlog
     2608       )  .
     2609   end.
     2610         if not varlog then
     2611         do:
     2612            undo, return error .
     2613         end.
     2614         assign
     2615            buf_pl-gds-pump.status_ = p-stts
     2616            .
     2617         if p-stts = 'тек':U then
     2618         do:
     2619            run cplgdspm in this-procedure
     2620               ( input buf_pl-gds-pump.obj-type
     2621               ,input buf_pl-gds-pump.obj-code
     2622               ,input buf_pl-gds-pump.pl-code
     2623               ,input buf_pl-gds-pump.gds-code
     2624               ,input buf_pl-gds-pump.pump-code
     2625               ,input p-stts
     2626               ).
     2627         end.
     2628      end.
     2629      assign
     2630         varrecid = recid(X_pl-gds-pump)
     2631         .
     2632      OPEN QUERY b-plgdspm FOR EACH X_marking OUTER-JOIN BY X_marking.obj-type      BY X_marking.obj-code       BY X_marking.pump-code        BY X_marking.nozzle-code.
     2633      reposition b-plgdspm to recid varrecid.
     2634   end procedure.
     2635   PROCEDURE sort_ :
     2636      define variable ii as integer no-undo .
     2637      empty temp-table X_marking .
     2638      run enable_tt .
     2639      if c-pump-code <> ? and c-pump-code <> 0 then
     2640      do:
     2641         for each X_marking where X_marking.pump-code <> c-pump-code:
     2642            delete X_marking .
     2643         end.
     2644      end.
     2645      if c-nozzle-code <> ? and c-nozzle-code <> 0 then
     2646      do:
     2647         for each X_marking where X_marking.nozzle-code <> c-nozzle-code:
     2648            delete X_marking .
     2649         end.
     2650      end.
     2651      if search-goods <> "" then
     2652      do:
     2653         for each X_marking:
     2654            do ii = 1 to num-entries (X_marking.gds-name," "):
     2655               if entry(ii,X_marking.gds-name," ") begins search-goods then X_marking.search-log = true .
     2656            end.
     2657         end.
     2658         for each X_marking where X_marking.search-log <> true:
     2659            delete X_marking .
     2660         end.
     2661      end.
     2662      OPEN QUERY b-plgdspm FOR EACH X_marking OUTER-JOIN BY X_marking.obj-type      BY X_marking.obj-code       BY X_marking.pump-code        BY X_marking.nozzle-code.
     2663   end procedure.
