      949         define variable list-pl  as character no-undo .
      950         run str/diallog.w ( input parparentproc
      951            ,input this-procedure
      952            ,input 'str/get-block-nozzle.p':U
      953            ,input (v-cntxt-obj-type + chr(4) +
      954            string(v-cntxt-obj-code) + chr(4) +
