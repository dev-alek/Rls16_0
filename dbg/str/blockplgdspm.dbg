     2230   procedure diasize_init :
     2231     define variable v-default-value    as logical   no-undo .
     2232     define variable v-restore-saved    as logical   no-undo .
     2233     define variable v-resize-value-str as character no-undo .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       do with frame Dialog-Frame
     2238       :
     2239         assign
     2240           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2241           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2242           v-diasize-browse-handle     = browse b-plgdspm :handle
     2243         .
     2244         create button v-diasize-resize-button
     2245         assign
     2246           parent        = frame Dialog-Frame :first-child
     2247           label         = "s"
     2248           height-pixels = 16
     2249           width-pixels  = 16
     2250           visible       = true
     2251           sensitive     = true
     2252           movable       = true
     2253           triggers:
     2254             on end-move persistent run diasize_end-move in this-procedure .
     2255           end triggers.
     2256         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2257         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2258         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2259         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2260         assign
     2261           v-diasize-wndmax = false
     2262         .
     2263         if connected("ub") = true
     2264         then do:
     2265           define variable v-cntxt-db-num        as integer   no-undo .
     2266           define variable v-cntxt-userid        as character no-undo .
     2267           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2268                                             , OUTPUT v-cntxt-userid
     2269                                             ) .
     2270           run gbl/wndpar_r.p
     2271             (input  v-cntxt-db-num
     2272             ,input  v-cntxt-userid
     2273             ,input  'wndmax':U
     2274             ,output v-diasize-wndmax
     2275             ,output v-default-value
     2276             ) .
     2277         end.
     2278         assign
     2279           v-diasize-wndstore = false
     2280         .
     2281         if connected("ub") = true
     2282         then do:
     2283           run gbl/wndpar_r.p
     2284             (input  v-cntxt-db-num
     2285             ,input  v-cntxt-userid
     2286             ,input  'wndstore':U
     2287             ,output v-diasize-wndstore
     2288             ,output v-default-value
     2289             ) .
     2290         end.
     2291         assign
     2292           v-diasize-proc-name = entry(1, program-name(2), '.')
     2293         .
     2294         if v-diasize-wndstore = true
     2295         then do:
     2296           assign
     2297             v-restore-saved = false
     2298           .
     2299           if connected("ub") = true
     2300           then do:
     2301             run gbl/wndsizer.p
     2302               (input  v-cntxt-db-num
     2303               ,input  v-cntxt-userid
     2304               ,input  v-diasize-proc-name
     2305               ,input  'height':u
     2306               ,output v-resize-value-str
     2307               ) .
     2308             if v-resize-value-str <> '':U
     2309             then do:
     2310               run diasize_change-height in this-procedure
     2311                 (input  integer(v-resize-value-str)
     2312                 ,input  true
     2313                 ) .
     2314               assign
     2315                 v-restore-saved = true
     2316               .
     2317             end.
     2318           end.
     2319           if connected("ub") = true
     2320           then do:
     2321             run gbl/wndsizer.p
     2322               (input  v-cntxt-db-num
     2323               ,input  v-cntxt-userid
     2324               ,input  v-diasize-proc-name
     2325               ,input  'width':u
     2326               ,output v-resize-value-str
     2327               ) .
     2328             if v-resize-value-str <> '':U
     2329             then do:
     2330               run diasize_change-width in this-procedure
     2331                 (input  integer(v-resize-value-str)
     2332                 ,input  true
     2333                 ) .
     2334               assign
     2335                 v-restore-saved = true
     2336               .
     2337             end.
     2338           end.
     2339           if v-restore-saved <> true
     2340           then do:
     2341             if v-diasize-wndmax = true
     2342             then do:
     2343               run diasize_maximize in this-procedure
     2344                 (input  true
     2345                 ) .
     2346             end.
     2347           end.
     2348         end.
     2349         else do:
     2350           if v-diasize-wndmax = true
     2351           then do:
     2352             run diasize_maximize in this-procedure
     2353               (input  true
     2354               ) .
     2355           end.
     2356         end.
     2357       end.
     2358     end.
     2359   end procedure.
     2360   procedure diasize_need-full-display :
     2361     define output parameter p-need-full-display as logical   no-undo .
     2362     do
     2363     on error undo, return error return-value
     2364     :
     2365       assign
     2366         p-need-full-display = v-diasize-need-full-display
     2367       .
     2368       assign
     2369         v-diasize-need-full-display = false
     2370       .
     2371     end.
