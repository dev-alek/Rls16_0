      751         assign search-goods .
      752         run sort_ .
      753      END.
      754   ON CHOOSE OF b-block IN FRAME Dialog-Frame
      755      DO:
      756         define variable quest-ok as logical   no-undo .
      757         define variable ii       as integer   no-undo .
      758         define variable jj       as integer   no-undo .
      759         define variable list-pl  as character no-undo .
      760   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   do:
      762     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      763       (input  v-cntxt-db-num
      764       ,input  v-cntxt-userid
      765       ,input  0
      766       ,input  'actn_nozzle-sts_work':U
      767       ,input  'object':U
      768       ,input  v-cntxt-host-code-obj
      769       ,input  v-cntxt-obj-type
      770       ,input  v-cntxt-obj-code
      771       ,input  0
      772       ,input  0
      773       ,input  0
      774       ,input  true
      775       ,output glog
      776       )  .
      777   end.
      778         IF NOT glog THEN RETURN NO-APPLY.
      779         if available X_marking then
      780         do:
      781            message "Блокировать выбранные пистолеты в" skip
      782               "АСУ 'Заправщик'"
      783               view-as alert-box question buttons yes-no update quest-ok.
      784            if quest-ok then
      785            do:
      786               pl-list = "".
      787               for each X_marking where X_marking.marking-string = "*" :
      788                  if pl-list = "" then
      789                  do:
      790                     pl-list =
      791                        string(X_marking.nozzle-code) + ":" +
      792                        string(X_marking.pump-code)
      793                        .
      794                  end.
      795                  else
      796                  do:
      797                     pl-list = pl-list + ";" +
      798                        string(X_marking.nozzle-code) + ":" +
      799                        string(X_marking.pump-code)
      800                        .
      801                  end.
      802               end.
      803               if pl-list = "" then
      804               do:
      805                  message "Ни один пистолет не выбран для блокировки"
      806                     view-as alert-box.
      807                  OPEN QUERY b-plgdspm FOR EACH X_marking OUTER-JOIN BY X_marking.obj-type      BY X_marking.obj-code       BY X_marking.pump-code        BY X_marking.nozzle-code.
      808                  return no-apply .
      809               end.
      810               run str/diallog.w ( input parparentproc
      811                  ,input this-procedure
      812                  ,input 'str/get-block-nozzle.p':U
      813                  ,input (v-cntxt-obj-type + chr(4) +
      814                  string(v-cntxt-obj-code) + chr(4) +
      815                  string(0) + chr(4) +
      816                  string(0) + chr(4) +
      817                  chr(4) +
      818                  chr(4) +
      819                  chr(4) +
      820                  substitute("&1,&2"
      821                  ,"block"
      822                  ,pl-list))
      823                  ,input yes
      824                  ,input ''
      825                  ,input 'Блокировка выбранных пистолетов') .
      826               if not error-status:error then
      827               do:
      828                  if return-value begins "Для кассы" then
      829                  do:
      830                     message return-value
      831                        view-as alert-box question buttons yes-no update v-ok as logical  .
      832                     if v-ok then apply "choose" to b-repeate-block in frame Dialog-Frame .
      833                     else                   message "Сообщите в службу поддержки о неуспешной попытке блокировки пистолетов"
      834                           view-as alert-box.
      835                  end.
      836                  else
      837                  do:
      838                     message "Блокировка пистолетов прошла успешно"
      839                        view-as alert-box.
      840                  end.
      841               end.
      842               else
      843               do:
      844                  message return-value
      845                     view-as alert-box question buttons yes-no update v-ok .
      846                  if v-ok then apply "choose" to b-repeate-block in frame Dialog-Frame .
      847                  else                   message "Сообщите в службу поддержки о неуспешной попытке блокировки пистолетов"
      848                        view-as alert-box.
      849               end.
      850               apply "choose" to b-exit in frame Dialog-Frame.
      851            end.
      852         end.
      853      END.
