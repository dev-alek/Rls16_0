       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   function fnc-convert-dot-to-colon returns character
       79       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
       80   function fnc-convert-dot-to-colon returns character
       81   (input p-data as decimal, input p-accur as character, input p-num as integer):
       82       define variable result as character no-undo.
       83       define variable v-str-result as character no-undo.
       84       if p-data = ? then p-data = 0 .
       85       p-data = round(p-data, p-num).
       86       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
       87       return v-str-result.
       88   END FUNCTION.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  stream PrnLibStream.
       91   procedure prn-lib-prn-file :
       92     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       93     define input parameter p-DIsabledoptions as integer no-undo .
       94     define variable v-report-name as character no-undo .
       95     define variable v-user-action as character no-undo .
       96     define variable v-printed     as logical   no-undo .
       97     define variable v-exist       as logical   no-undo .
       98     do
       99       on error undo, return error
      100       :
      101       run prn-lib-get-report-name  in this-procedure (
      102         input parParentProc
      103         ,output v-report-name
      104         ).
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      107     (input  v-report-name
      108     ,input  2
      109     ,output v-exist
      110     )  .
      111       if NOT v-exist then
      112       DO:
      113         Message
      114           "Нет заданий на печать ! "
      115           view-as alert-box .
      116         Return  .
      117       End.
      118       run gbl/prnfilen.w
      119         (input  ""
      120         ,input  p-DisabledOptions
      121         ,input  string(v-report-name )
      122         ,input  7
      123         ,output v-user-action
      124         ,output v-printed
      125         ) .
      126       if v-printed then
      127       do:
      128         return "YES" .
      129       end.
      130       else
      131       do:
      132         return "NO" .
      133       end.
      134     end.
      135   end procedure.
      136   procedure prn-lib-open-stream :
      137     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      138     define input parameter p-page-size    as integer no-undo .
      139     define input parameter p-is-stream    as logical no-undo .
      140     define input parameter p-append       as logical no-undo .
      141     define variable v-report-name as character no-undo .
      142     do
      143       on error undo, return error
      144       :
      145       run prn-lib-get-report-name  in this-procedure (
      146         input parParentProc
      147         ,output v-report-name
      148         ).
      149       if p-is-stream then
      150       do:
      151         if p-append then
      152         do:
      153           output stream PrnLibStream to value( v-report-name )
      154             page-size value(p-page-size) append .
      155         end.
      156         if not p-append then
      157         do:
      158           output stream PrnLibStream to value( v-report-name )
      159             page-size value(p-page-size) .
      160         end.
      161       end.
      162       if not p-is-stream then
      163       do:
      164         if p-append then
      165         do:
      166           output to value( v-report-name )
      167             page-size value(p-page-size) append .
      168         end.
      169         if not p-append then
      170         do:
      171           output to value( v-report-name )
      172             page-size value(p-page-size) .
      173         end.
      174       end.
      175     end.
      176   end procedure.
      177   procedure prn-lib-open-exp :
      178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      179     define input parameter p-is-stream    as logical no-undo .
      180     define input parameter p-is-append    as logical no-undo .
      181     define output parameter p-ReportFileName as char init "report" no-undo.
      182     define output parameter p-process as logical no-undo .
      183     define variable glog as logical no-undo .
      184     do
      185       on error undo, return error
      186       :
      187       SYSTEM-DIALOG GET-FILE p-ReportFileName
      188         TITLE      "Укажите путь"
      189         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      190         ASK-OVERWRITE
      191         CREATE-TEST-FILE
      192         SAVE-AS
      193         USE-FILENAME
      194         DEFAULT-EXTENSION "txt"
      195         UPDATE glog
      196         .
      197       if not glog then  return.
      198       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      199       if p-is-stream then
      200       do:
      201         if p-is-append then
      202         do:
      203           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      204         end.
      205         else
      206         do:
      207           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      208         end.
      209       end.
      210       else
      211       do:
      212         if p-is-append then
      213         do:
      214           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      215         end.
      216         else
      217         do:
      218           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      219         end.
      220       end.
      221       p-process = yes.
      222     end.
      223   end procedure.
      224   procedure prn-lib-get-report-name :
      225     define input parameter parParentProc  as widget-handle no-undo.
      226     define output parameter p-report-name as character no-undo .
      227     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      228   end procedure.
      229   procedure prn-lib-reportviewer-report-name :
      230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      231     define input parameter p-report-name-html as character no-undo .
      232     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      233   end procedure.
      234   procedure prn-lib-reportviewer :
      235     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      236     define input parameter p-report-name-html as character no-undo .
      237     define input parameter p-param        as character no-undo .
      238     define variable v-excel           as character no-undo init 'TRUE' .
      239     define variable v-value-character as character no-undo .
      240     define variable v-value-integer   as character no-undo .
      241     define variable v-value-date      as date      no-undo .
      242     define variable v-value-decimal   as decimal   no-undo .
      243     define variable rep-excel         as logical   no-undo .
      244     define variable excel-string      as character no-undo .
      245     define variable v-param-type      as character no-undo .
      246     define variable v-tth             as handle    no-undo .
      247     run adm/shattri.p (
      248       input "get":U
      249       ,input  ""
      250       ,input  0
      251       ,input  'report-glob':U
      252       ,input  'rep-excel':U
      253       ,output v-value-character
      254       ,output v-value-date
      255       ,output v-value-decimal
      256       ,output v-value-integer
      257       ,output rep-excel
      258       ,output v-param-type
      259       ,INPUT-OUTPUT table-handle v-tth
      260       )  .
      261     if rep-excel then v-excel = "TRUE" .
      262     else v-excel = "FALSE" .
      263     if p-param eq ""
      264     then
      265        p-param = "EXCEL:" + v-excel.
      266     else
      267        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      268     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      269   end procedure.
      270   define stream Out-Stream .
      271   define stream OutStr-html.
      272   function Str-chk-type returns character
      273       (input p-chk-type as character) forward .
      274   function datetime_ returns character
      275       (input p-chk-date as date,
      276       input p-chk-time as integer) forward .
      277   DEFINE BUTTON B-chg
      278       LABEL "&Указать причину"
      279       SIZE 20 BY 1 TOOLTIP "Указать причину".
      280   DEFINE BUTTON B-lookup
      281       LABEL "&Просмотр"
      282       SIZE 10 BY 1 TOOLTIP "Просмотр чека".
      283   DEFINE BUTTON B-print
      284       LABEL "Пе&чать"
      285       SIZE 3 BY 1 TOOLTIP "Печать списка чеков, списка строк по всем чекам, списка оплат ...".
      286   DEFINE BUTTON b-quit AUTO-go
      287       LABEL "&Выход"
      288       SIZE 10 BY 1
      289       BGCOLOR 8 .
      290   DEFINE BUTTON b-help
      291       LABEL "Помощь":L
      292       SIZE 7 BY 1.
      293   DEFINE QUERY br-docs FOR
      294       c-doc SCROLLING.
      295   DEFINE BROWSE br-docs
      296       QUERY br-docs NO-LOCK DISPLAY
      297       c-doc.office COLUMN-LABEL "Признак" FORMAT "X(256)":U
      298       WIDTH 20
      299       c-doc.doc-code COLUMN-LABEL "№ чека в ТН" FORMAT "X(20)":U
      300       entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) COLUMN-LABEL "Тип чека" FORMAT "X(20)":U WIDTH 15
      301       c-doc.chk-num COLUMN-LABEL "№ чека!на кассе" FORMAT ">>>>>>>>>>9":U
      302       WIDTH 12
      303       c-doc.pay-desk COLUMN-LABEL "№ кассы" FORMAT ">>>9":U WIDTH 10
      304       datetime_(c-doc.chk-date, c-doc.chk-time) COLUMN-LABEL "Дата/время" FORMAT "X(20)":U WIDTH 20
      305       c-doc.reason-name COLUMN-LABEL "Причина возникновения чека" FORMAT "x(250)":U WIDTH 40
      306       c-doc.link-chk COLUMN-LABEL 'Ссылка на "корректный" чек' FORMAT "x(250)":U WIDTH 40
      307       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 16.5 .
      308   DEFINE FRAME Dialog-Frame
      309       b-quit AT ROW 1 COL 1
      310       B-lookup AT ROW 1 COL 11
      311       B-chg AT ROW 1 COL 21
      312       B-print AT ROW 1 COL 95.5
      313       br-docs AT ROW 2 COL 1 WIDGET-ID 100
      314       b-help AT ROW 1 COL 92.5
      315       SPACE(0.50) SKIP(0.16)
      316       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      317       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      318       TITLE "Подозрительные чеки"
      319       CANCEL-BUTTON b-quit.
      320   ASSIGN
      321       FRAME Dialog-Frame:SCROLLABLE = FALSE
      322       FRAME Dialog-Frame:HIDDEN     = TRUE.
      323   ASSIGN
      324       br-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame = TRUE.
      325   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      326       DO:
      327           APPLY "END-ERROR":U TO SELF.
      328       END.
      329   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      330       DO:
      331           run proc-b-print in this-procedure no-error.
      332           if error-status:error then return no-apply.
      333       END.
      334   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      335       DO:
      336           define variable v-close as logical no-undo .
      337           if par-mode <> 'ПРОСМОТР':U then
      338           do:
      339               find first c-doc where c-doc.reason-name = "" no-error .
      340               if available (c-doc) then
      341               do:
      342                   message "Причина указана не для всех найденных чеков." skip
      343                       "Отменить закрытие смены?"
      344                       view-as alert-box question buttons yes-no update v-close.
      345                   if not v-close then return no-apply .
      346                   else
      347                   do:
      348                       empty temp-table tt-susp-chk .
      349                       for each ub.susp-chk no-lock where ub.susp-chk.obj-code = parobj-code and
      350                           ub.susp-chk.obj-type = parobj-type and
      351                           ub.susp-chk.shift-date = parshift-date and
      352                           ub.susp-chk.shift-num = parshift-num and
      353                           ub.susp-chk.shift-name = parshift-name:
      354                           create tt-susp-chk .
      355                           buffer-copy ub.susp-chk to tt-susp-chk .
      356                       end.
      357                   end.
      358               end.
      359               else p-ok = true .
      360           end.
      361       END.
      362   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      363       DO:
      364           define variable next-prev as character no-undo .
      365           define variable v-doc-rec as recid     no-undo .
      366           define buffer buf_chk-doc for ub.chk-doc .
      367           define variable reason-name as character no-undo .
      368           define variable link-chk as character no-undo .
      369               if NOT available c-doc then
      370               do:
      371                   message "Неправильно выбран чек." view-as alert-box ERROR.
      372                   return no-apply.
      373               end.
      374               if available (c-doc) then
      375               do:
      376                   v-doc-rec = recid(c-doc).
      377                   run str/diffSuspChk.w
      378                       (input parparentproc
      379                       ,input-output v-doc-rec
      380                       ,output reason-name
      381                       ,output link-chk
      382                       )
      383                       .
      384                       find first ub.susp-chk exclusive-lock where recid(ub.susp-chk) = v-doc-rec no-error .
      385                       if available (ub.susp-chk) then do:
      386                           ub.susp-chk.reason-name = reason-name .
      387                           ub.susp-chk.link-chk = link-chk .
      388                       end.
      389               end.
      390               else
      391               do:
      392                   message "Неправильно выбран чек." view-as alert-box ERROR.
      393                   return no-apply.
      394               end.
      395           br-docs:refresh () .
      396       END.
      397   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      398       DO:
      399           define variable next-prev as character no-undo .
      400           define variable v-doc-rec as recid     no-undo .
      401           define buffer buf_chk-doc for ub.chk-doc .
      402           assign
      403               next-prev = '':U
      404               .
      405           DO WHILE next-prev = '':U:
      406               if NOT available c-doc then
      407               do:
      408                   message "Неправильно выбран чек." view-as alert-box ERROR.
      409                   return no-apply.
      410               end.
      411               find first buf_chk-doc no-lock where buf_chk-doc.doc-code = c-doc.doc-code no-error .
      412               if available (buf_chk-doc) then
      413               do:
      414                   v-doc-rec = recid(buf_chk-doc).
      415                   run str/superchk.w
      416                       (input parparentproc
      417                       ,input 'ПРОСМОТР':U
      418                       ,input buf_chk-doc.obj-type
      419                       ,input buf_chk-doc.obj-code
      420                       ,input-output v-doc-rec
      421                       ,input this-procedure:handle
      422                       ,input-output next-prev
      423                       )
      424                       .
      425               end.
      426               else
      427               do:
      428                   message "Неправильно выбран чек." view-as alert-box ERROR.
      429                   return no-apply.
      430               end.
      431           END .
      432           apply "entry" to br-docs in frame Dialog-Frame.
      433           apply "value-changed" to br-docs in frame Dialog-Frame.
      434       END.
      435   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      436       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      437   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   do:
      439     br-docs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      440   end.
      441   MAIN-BLOCK:
      442   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      443       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      444   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   on help of frame Dialog-Frame
      446   do:
      447     run gbl/app_help.p
      448       (input this-procedure :file-name
      449       ,input ''
      450       ,input ?
      451       ) no-error.
      452     if error-status :error then do:
      453       message
      454         "Ошибка при вызове помощи"
      455         error-status :get-message(1)
      456         view-as alert-box .
      457     end.
      458   end.
      459   run minbtn-set in this-procedure .
      460   on choose of b-help in frame Dialog-Frame
      461   do:
      462     apply "help":u to frame Dialog-Frame .
      463   end.
      464   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   procedure minbtn-set :
      466       do
      467           on error undo, return error return-value
      468           :
      469           define variable ii              as integer       no-undo .
      470           define variable fh              as widget-handle no-undo .
      471           define variable hh              as widget-handle no-undo .
      472           define variable v-h             as handle        extent 4 no-undo .
      473           define variable v-name-button   as character     no-undo .
      474           define variable v-help-old-x    as decimal       no-undo .
      475           define variable v-help-old-y    as decimal       no-undo .
      476           define variable v-help-old-size as decimal       no-undo .
      477           define variable v-frame-width   as decimal       no-undo .
      478           define variable jj              as integer       no-undo .
      479           do
      480               on error undo, return error
      481               :
      482               assign
      483                   v-frame-width = frame Dialog-Frame:width - 0.3
      484                   fh            = frame Dialog-Frame:first-child
      485                   hh            = fh:first-child
      486                   ii            = 1
      487                   .
      488               do while valid-handle(hh):
      489                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      490                   do:
      491                       case lc(hh:name) :
      492                           when "b-help" then
      493                               do:
      494                                   hh:load-image-up("cmp/b-help.bmp":u) .
      495                                   hh:load-image-down("cmp/b-help.bmp":u) .
      496                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      497                                   hh:TOOLTIP = "Помощь" .
      498                                   v-help-old-x = hh:column .
      499                                   v-help-old-y = hh:row    .
      500                                   v-help-old-size = hh:width .
      501                                   hh:width-chars = 2.5 .
      502                               end.
      503                           when "b-print" then
      504                               do:
      505                                   hh:load-image("cmp/b-print.bmp":u) .
      506                                   hh:TOOLTIP = "Печать" .
      507                                   v-h[ii] = hh:handle .
      508                                   ii = ii + 1 .
      509                                   hh:width-chars = 3 .
      510                               end.
      511                           when "b-history" or
      512                           when "b-hist" then
      513                               do:
      514                                   hh:load-image("cmp/b-hist.bmp":u) .
      515                                   hh:TOOLTIP = "История" .
      516                                   v-h[ii] = hh:handle .
      517                                   ii = ii + 1 .
      518                                   hh:width-chars = 3 .
      519                               end.
      520                           when "b-sch" then
      521                               do:
      522                                   hh:load-image("cmp/b-sch.bmp":u) .
      523                                   hh:TOOLTIP = "Установка Фильтра" .
      524                                   v-h[ii] = hh:handle .
      525                                   ii = ii + 1 .
      526                                   hh:width-chars = 3 .
      527                               end.
      528                           when "b-hist-user" then
      529                               do:
      530                                   hh:load-image("cmp/b-hist.bmp":u) .
      531                                   hh:TOOLTIP = "История пользователя" .
      532                                   ii = ii + 1 .
      533                               end.
      534                       end case.
      535                   end.
      536                   hh = hh:next-sibling.
      537               end.
      538               b-help:column = v-frame-width - b-help:width-chars.
      539               jj = 0.
      540               repeat ii = 4 to 1 by -1 :
      541                   if valid-handle (v-h[ii] ) then
      542                   do:
      543                       jj  = jj + 1 .
      544                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      545                       v-h[ii]:row    = v-help-old-y .
      546                   end.
      547               end.
      548           end.
      549       end.
      550   end procedure.
      551   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      552   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      553   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      554   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      555   define variable v-diasize-current-frame-width  as decimal   no-undo .
      556   define variable v-diasize-current-frame-height as decimal   no-undo .
      557   define variable v-diasize-change-size          as logical   no-undo .
      558   define variable v-diasize-resize-button        as handle    no-undo .
      559   define variable v-diasize-wndmax               as logical   no-undo .
      560   define variable v-diasize-wndstore             as logical   no-undo .
      561   define variable v-diasize-proc-name            as character no-undo .
      562   define variable v-diasize-browse-handle        as handle    no-undo .
      563   define variable v-diasize-browse-number        as integer   no-undo .
      564   define variable v-diasize-need-full-display    as logical   no-undo init false .
      565   define temp-table temp-diasize-handle no-undo
      566     field handle-value  as handle
      567     field save-position as decimal
      568     index xpk is primary unique handle-value
      569     .
      570   define temp-table temp-browse-handle no-undo
      571     field browse-type   as character
      572     field browse-number as integer
      573     field browse-handle as handle
      574     field original-size as decimal
      575     index xpk is primary unique browse-type browse-number
      576     index xie browse-type browse-handle
      577   .
      578   procedure diasize_change-height :
      579     define input  parameter p-change-value  as decimal   no-undo .
      580     define input  parameter p-move-resize   as logical   no-undo .
      581     define variable v-field-group-handle    as handle    no-undo .
      582     define variable v-object-handle         as handle    no-undo .
      583     define variable v-frame-height          as decimal   no-undo .
      584     define variable v-frame-virtual-height  as decimal   no-undo .
      585     define variable v-browse-height         as decimal   no-undo .
      586     define variable v-window-height         as decimal   no-undo .
      587     define variable v-window-virtual-height as decimal   no-undo .
      588     define variable v-change-sign           as integer   no-undo .
      589     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      590     define buffer buf_temp-browse-handle  for temp-browse-handle .
      591     if p-change-value > 0
      592     then do:
      593       if frame Dialog-Frame :height + p-change-value
      594           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      595       then do:
      596         assign
      597           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      598                           - (frame Dialog-Frame :height-chars)
      599         .
      600         if p-change-value <= 0
      601         then do:
      602           run diasize_position-resize-button in this-procedure .
      603           return .
      604         end.
      605       end.
      606     end.
      607     if p-change-value < 0
      608     then do:
      609       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      610       then do:
      611         assign
      612           p-change-value = v-diasize-orig-frame-height
      613                          - (frame Dialog-Frame :height-chars)
      614         .
      615         if p-change-value >= 0
      616         then do:
      617           run diasize_position-resize-button in this-procedure .
      618           return .
      619         end.
      620       end.
      621     end.
      622     if p-change-value >= 0
      623     then do:
      624       assign
      625         v-change-sign = 1
      626       .
      627     end.
      628     else do:
      629       assign
      630         v-change-sign = -1
      631       .
      632     end.
      633     assign
      634       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      635     .
      636     if p-change-value = 0
      637     then do:
      638       run diasize_position-resize-button in this-procedure .
      639       return .
      640     end.
      641     move_block:
      642     do
      643     on error undo move_block, retry move_block
      644     :
      645       if retry
      646       then do:
      647         do
      648         on error undo move_block, leave move_block
      649         :
      650           if p-change-value > 0
      651           then do:
      652             for each buf_temp-diasize-handle
      653             on error undo, next
      654             :
      655               assign
      656                 v-object-handle = buf_temp-diasize-handle.handle-value
      657               .
      658               if v-object-handle <> v-diasize-resize-button
      659               then do:
      660                 assign
      661                   v-object-handle :row = buf_temp-diasize-handle.save-position
      662                 .
      663               end.
      664             end.
      665             assign
      666               v-diasize-browse-handle :height = v-browse-height
      667             .
      668             for each buf_temp-browse-handle
      669               where buf_temp-browse-handle.browse-type = 'height':u
      670             on error undo, next
      671             :
      672               assign
      673                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      674               .
      675             end.
      676             assign
      677               frame Dialog-Frame :height = v-frame-height
      678             .
      679             if frame Dialog-Frame :scrollable = true
      680             then do:
      681               assign
      682                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      683               .
      684             end.
      685             run diasize_position-resize-button in this-procedure .
      686           end.
      687           else do:
      688             if frame Dialog-Frame :scrollable = true
      689             then do:
      690               assign
      691                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      692               .
      693             end.
      694             assign
      695               frame Dialog-Frame :height = v-frame-height
      696             .
      697             assign
      698               v-diasize-browse-handle :height = v-browse-height
      699             .
      700             for each buf_temp-browse-handle
      701               where buf_temp-browse-handle.browse-type = 'height':u
      702             on error undo, next
      703             :
      704               assign
      705                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      706               .
      707             end.
      708             for each buf_temp-diasize-handle
      709             on error undo, next
      710             :
      711               assign
      712                 v-object-handle = buf_temp-diasize-handle.handle-value
      713               .
      714               if v-object-handle <> v-diasize-resize-button
      715               then do:
      716                 assign
      717                   v-object-handle :row = buf_temp-diasize-handle.save-position
      718                 .
      719               end.
      720             end.
      721             run diasize_position-resize-button in this-procedure .
      722           end.
      723           assign
      724             v-diasize-change-size = false
      725           .
      726           leave move_block .
      727         end.
      728       end.
      729       assign
      730         v-diasize-need-full-display = true
      731       .
      732       if v-diasize-change-size = false
      733       then do:
      734         assign
      735           v-diasize-change-size = true
      736         .
      737       end.
      738       else do:
      739         return .
      740       end.
      741       assign
      742         v-frame-height = frame Dialog-Frame :height
      743         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      744         v-browse-height = v-diasize-browse-handle :height
      745       .
      746       for each buf_temp-browse-handle
      747         where buf_temp-browse-handle.browse-type = 'height':u
      748       :
      749         assign
      750           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      751         .
      752       end.
      753       for each buf_temp-diasize-handle
      754       :
      755         delete buf_temp-diasize-handle .
      756       end.
      757       assign
      758         v-field-group-handle = frame Dialog-Frame :first-child
      759       .
      760       do while valid-handle(v-field-group-handle)
      761       :
      762         assign
      763           v-object-handle = v-field-group-handle :first-child
      764         .
      765         do while valid-handle(v-object-handle)
      766         :
      767           if  v-object-handle <> v-diasize-browse-handle :handle
      768           and can-query(v-object-handle, "row")
      769           and can-query(v-object-handle, "height")
      770           and ( v-object-handle :row > v-diasize-browse-handle :row )
      771           then do:
      772             find first buf_temp-browse-handle
      773               where buf_temp-browse-handle.browse-type   = 'height':u
      774                 and buf_temp-browse-handle.browse-handle = v-object-handle
      775               no-error .
      776             if available buf_temp-browse-handle
      777             then do:
      778             end.
      779             else do:
      780               create buf_temp-diasize-handle .
      781               assign
      782                 buf_temp-diasize-handle.handle-value  = v-object-handle
      783                 buf_temp-diasize-handle.save-position = v-object-handle :row
      784               .
      785             end.
      786           end.
      787           assign
      788             v-object-handle = v-object-handle :next-sibling
      789           .
      790         end.
      791         assign
      792           v-field-group-handle = v-field-group-handle :next-sibling
      793         .
      794       end.
      795       do with frame Dialog-Frame
      796       :
      797         hide v-diasize-resize-button .
      798         assign
      799           v-diasize-resize-button :row    = 1
      800           v-diasize-resize-button :column = 1
      801         .
      802       end.
      803       if p-change-value > 0
      804       then do:
      805         if frame Dialog-Frame :scrollable = true
      806         then do:
      807           assign
      808             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      809             no-error .
      810           if error-status :error
      811           or error-status :get-message(1) <> ""
      812           then do:
      813             undo move_block, retry move_block .
      814           end.
      815         end.
      816         assign
      817           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      818           no-error .
      819         if error-status :error
      820         or error-status :get-message(1) <> ""
      821         then do:
      822           undo move_block, retry move_block .
      823         end.
      824         assign
      825           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      826           no-error .
      827         if error-status :error
      828         or error-status :get-message(1) <> ""
      829         then do:
      830           undo move_block, retry move_block .
      831         end.
      832         for each buf_temp-browse-handle
      833           where buf_temp-browse-handle.browse-type = 'height':u
      834         on error undo move_block, retry move_block
      835         :
      836           assign
      837             buf_temp-browse-handle.browse-handle :height
      838               = buf_temp-browse-handle.browse-handle :height + p-change-value
      839             no-error .
      840           if error-status :error
      841           or error-status :get-message(1) <> ""
      842           then do:
      843             undo move_block, retry move_block .
      844           end.
      845         end.
      846         for each buf_temp-diasize-handle
      847         on error undo move_block, retry move_block
      848         :
      849           assign
      850             v-object-handle = buf_temp-diasize-handle.handle-value
      851           .
      852           if v-object-handle <> v-diasize-resize-button
      853           then do:
      854             assign
      855               v-object-handle :row = v-object-handle :row + p-change-value
      856               no-error .
      857             if error-status :error
      858             or error-status :get-message(1) <> ""
      859             then do:
      860               undo move_block, retry move_block .
      861             end.
      862           end.
      863         end.
      864       end.
      865       else do:
      866         for each buf_temp-diasize-handle
      867         on error undo move_block, retry move_block
      868         :
      869           assign
      870             v-object-handle = buf_temp-diasize-handle.handle-value
      871           .
      872           if v-object-handle <> v-diasize-resize-button
      873           then do:
      874             assign
      875               v-object-handle :row = v-object-handle :row + p-change-value
      876               no-error .
      877             if error-status :error
      878             or error-status :get-message(1) <> ""
      879             then do:
      880               undo move_block, retry move_block .
      881             end.
      882           end.
      883         end.
      884         assign
      885           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      886           no-error .
      887         if error-status :error
      888         or error-status :get-message(1) <> ""
      889         then do:
      890           undo move_block, retry move_block .
      891         end.
      892         for each buf_temp-browse-handle
      893           where buf_temp-browse-handle.browse-type = 'height':u
      894         on error undo move_block, retry move_block
      895         :
      896           assign
      897             buf_temp-browse-handle.browse-handle :height
      898               = buf_temp-browse-handle.browse-handle :height + p-change-value
      899             no-error .
      900           if error-status :error
      901           or error-status :get-message(1) <> ""
      902           then do:
      903             undo move_block, retry move_block .
      904           end.
      905         end.
      906         assign
      907           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      908           no-error .
      909         if error-status :error
      910         or error-status :get-message(1) <> ""
      911         then do:
      912           undo move_block, retry move_block .
      913         end.
      914         if frame Dialog-Frame :scrollable = true
      915         then do:
      916           assign
      917             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      918             no-error .
      919           if error-status :error
      920           or error-status :get-message(1) <> ""
      921           then do:
      922             undo move_block, retry move_block .
      923           end.
      924         end.
      925       end.
      926       if p-move-resize = true
      927       then do:
      928         run diasize_position-resize-button in this-procedure .
      929       end.
      930       if v-diasize-wndstore = true
      931       then do:
      932         if connected("ub") = true
      933         then do:
      934           define variable v-cntxt-db-num        as integer   no-undo .
      935           define variable v-cntxt-userid        as character no-undo .
      936           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      937                                             , OUTPUT v-cntxt-userid
      938                                             ) .
      939           run gbl/wndsizew.p
      940             (input  v-cntxt-db-num
      941             ,input  v-cntxt-userid
      942             ,input  v-diasize-proc-name
      943             ,input  'height':u
      944             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      945             ) .
      946         end.
      947       end.
      948     end.
      949     assign
      950       v-diasize-change-size = false
      951     .
      952   end procedure.
      953   procedure diasize_set-height :
      954     define input  parameter p-new-height  as decimal   no-undo .
      955     define input  parameter p-move-resize as logical   no-undo .
      956     do
      957     on error undo, return error return-value
      958     :
      959       run diasize_change-height in this-procedure
      960         (input  (p-new-height - frame Dialog-Frame :height)
      961         ,input  p-move-resize
      962         ) .
      963     end.
      964   end procedure.
      965   procedure diasize_change-width :
      966     define input  parameter p-change-value as decimal   no-undo .
      967     define input  parameter p-move-resize  as logical   no-undo .
      968     define variable v-field-group-handle   as handle    no-undo .
      969     define variable v-object-handle        as handle    no-undo .
      970     define variable v-frame-width          as decimal   no-undo .
      971     define variable v-frame-virtual-width  as decimal   no-undo .
      972     define variable v-browse-width         as decimal   no-undo .
      973     define variable v-window-width         as decimal   no-undo .
      974     define variable v-window-virtual-width as decimal   no-undo .
      975     define variable v-change-sign          as integer   no-undo .
      976     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      977     define buffer buf_temp-browse-handle  for temp-browse-handle .
      978     if p-change-value > 0
      979     then do:
      980       if frame Dialog-Frame :width + p-change-value >
      981           session :width-chars
      982       then do:
      983         assign
      984           p-change-value = session :width-chars - frame Dialog-Frame :width
      985         .
      986         if p-change-value <= 0
      987         then do:
      988           run diasize_position-resize-button in this-procedure .
      989           return .
      990         end.
      991       end.
      992     end.
      993     if p-change-value < 0
      994     then do:
      995       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      996       then do:
      997         assign
      998           p-change-value = v-diasize-orig-frame-width
      999                          - frame Dialog-Frame :width
     1000         .
     1001         if p-change-value >= 0
     1002         then do:
     1003           run diasize_position-resize-button in this-procedure .
     1004           return .
     1005         end.
     1006       end.
     1007     end.
     1008     if p-change-value >= 0
     1009     then do:
     1010       assign
     1011         v-change-sign = 1
     1012       .
     1013     end.
     1014     else do:
     1015       assign
     1016         v-change-sign = -1
     1017       .
     1018     end.
     1019     assign
     1020       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1021     .
     1022     if p-change-value = 0
     1023     then do:
     1024       run diasize_position-resize-button in this-procedure .
     1025       return .
     1026     end.
     1027     move_block:
     1028     do
     1029     on error undo move_block, leave move_block
     1030     :
     1031       if retry
     1032       then do:
     1033         do
     1034         on error undo move_block, leave move_block
     1035         :
     1036           if p-change-value > 0
     1037           then do:
     1038             for each buf_temp-diasize-handle
     1039             on error undo, next
     1040             :
     1041               assign
     1042                 v-object-handle = buf_temp-diasize-handle.handle-value
     1043               .
     1044               if v-object-handle <> v-diasize-resize-button
     1045               then do:
     1046                 assign
     1047                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1048                 .
     1049               end.
     1050             end.
     1051             assign
     1052               v-diasize-browse-handle :width = v-browse-width
     1053             .
     1054             for each buf_temp-browse-handle
     1055               where buf_temp-browse-handle.browse-type = 'width':u
     1056             on error undo, next
     1057             :
     1058               assign
     1059                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1060               .
     1061             end.
     1062             assign
     1063               frame Dialog-Frame :width = v-frame-width
     1064             .
     1065             if frame Dialog-Frame :scrollable = true
     1066             then do:
     1067               assign
     1068                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1069               .
     1070             end.
     1071             run diasize_position-resize-button in this-procedure .
     1072           end.
     1073           else do:
     1074             if frame Dialog-Frame :scrollable = true
     1075             then do:
     1076               assign
     1077                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1078               .
     1079             end.
     1080             assign
     1081               frame Dialog-Frame :width = v-frame-width
     1082             .
     1083             for each buf_temp-browse-handle
     1084               where buf_temp-browse-handle.browse-type = 'width':u
     1085             on error undo, next
     1086             :
     1087               assign
     1088                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1089               .
     1090             end.
     1091             assign
     1092               v-diasize-browse-handle :width = v-browse-width
     1093             .
     1094             for each buf_temp-diasize-handle
     1095             on error undo, next
     1096             :
     1097               assign
     1098                 v-object-handle = buf_temp-diasize-handle.handle-value
     1099               .
     1100               if v-object-handle <> v-diasize-resize-button
     1101               then do:
     1102                 assign
     1103                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1104                 .
     1105               end.
     1106             end.
     1107             run diasize_position-resize-button in this-procedure .
     1108           end.
     1109           assign
     1110             v-diasize-change-size = false
     1111           .
     1112           leave move_block .
     1113         end.
     1114       end.
     1115       assign
     1116         v-diasize-need-full-display = true
     1117       .
     1118       if v-diasize-change-size = false
     1119       then do:
     1120         assign
     1121           v-diasize-change-size = true
     1122         .
     1123       end.
     1124       else do:
     1125         return .
     1126       end.
     1127       assign
     1128         v-frame-width = frame Dialog-Frame :width
     1129         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1130         v-browse-width = v-diasize-browse-handle :width
     1131       .
     1132       for each buf_temp-browse-handle
     1133         where buf_temp-browse-handle.browse-type = 'width':u
     1134       :
     1135         assign
     1136           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1137         .
     1138       end.
     1139       for each buf_temp-diasize-handle
     1140       :
     1141         delete buf_temp-diasize-handle .
     1142       end.
     1143       assign
     1144         v-field-group-handle = frame Dialog-Frame :first-child
     1145       .
     1146       do while valid-handle(v-field-group-handle)
     1147       :
     1148         assign
     1149           v-object-handle = v-field-group-handle :first-child
     1150         .
     1151         do while valid-handle(v-object-handle)
     1152         :
     1153           if  v-object-handle <> v-diasize-browse-handle :handle
     1154           and v-object-handle <> v-diasize-resize-button
     1155           and can-query(v-object-handle, "row")
     1156           and can-query(v-object-handle, "height")
     1157           and ( v-object-handle :col + v-object-handle :width
     1158                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1159               )
     1160           then do:
     1161             find first buf_temp-browse-handle
     1162               where buf_temp-browse-handle.browse-type   = 'width':u
     1163                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1164               no-error .
     1165             if available buf_temp-browse-handle
     1166             then do:
     1167             end.
     1168             else do:
     1169               create buf_temp-diasize-handle .
     1170               assign
     1171                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1172                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1173               .
     1174             end.
     1175           end.
     1176           assign
     1177             v-object-handle = v-object-handle :next-sibling
     1178           .
     1179         end.
     1180         assign
     1181           v-field-group-handle = v-field-group-handle :next-sibling
     1182         .
     1183       end.
     1184       do with frame Dialog-Frame
     1185       :
     1186         hide v-diasize-resize-button .
     1187         v-diasize-resize-button :row = 1.
     1188         v-diasize-resize-button :column = 1.
     1189       end.
     1190       if p-change-value > 0
     1191       then do:
     1192         if frame Dialog-Frame :scrollable = true
     1193         then do:
     1194           assign
     1195             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1196             no-error .
     1197           if error-status :error
     1198           or error-status :get-message(1) <> ""
     1199           then do:
     1200             undo move_block, retry move_block.
     1201           end.
     1202         end.
     1203         assign
     1204           frame Dialog-Frame :width = v-frame-width + p-change-value
     1205           no-error .
     1206         if error-status :error
     1207         or error-status :get-message(1) <> ""
     1208         then do:
     1209           undo move_block, retry move_block.
     1210         end.
     1211         assign
     1212           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1213         no-error .
     1214         if error-status :error
     1215         or error-status :get-message(1) <> ""
     1216         then do:
     1217           undo move_block, retry move_block.
     1218         end.
     1219         for each buf_temp-browse-handle
     1220           where buf_temp-browse-handle.browse-type = 'width':u
     1221         on error undo move_block, retry move_block
     1222         :
     1223           assign
     1224             buf_temp-browse-handle.browse-handle :width
     1225               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1226             no-error .
     1227           if error-status :error
     1228           or error-status :get-message(1) <> ""
     1229           then do:
     1230             undo move_block, retry move_block .
     1231           end.
     1232         end.
     1233         for each buf_temp-diasize-handle
     1234         on error undo move_block, retry move_block
     1235         :
     1236           assign
     1237             v-object-handle = buf_temp-diasize-handle.handle-value
     1238           .
     1239           if v-object-handle <> v-diasize-resize-button
     1240           then do:
     1241             assign
     1242               v-object-handle :col = v-object-handle :col + p-change-value
     1243               no-error .
     1244             if error-status :error
     1245             or error-status :get-message(1) <> ""
     1246             then do:
     1247               undo move_block, retry move_block .
     1248             end.
     1249           end.
     1250         end.
     1251       end.
     1252       else do:
     1253         for each buf_temp-diasize-handle
     1254         on error undo move_block, retry move_block
     1255         :
     1256           assign
     1257             v-object-handle = buf_temp-diasize-handle.handle-value
     1258           .
     1259           if v-object-handle <> v-diasize-resize-button
     1260           then do:
     1261             assign
     1262               v-object-handle :col = v-object-handle :col + p-change-value
     1263               no-error .
     1264             if error-status :error
     1265             or error-status :get-message(1) <> ""
     1266             then do:
     1267               undo move_block, retry move_block .
     1268             end.
     1269           end.
     1270         end.
     1271         for each buf_temp-browse-handle
     1272           where buf_temp-browse-handle.browse-type = 'width':u
     1273         on error undo move_block, retry move_block
     1274         :
     1275           assign
     1276             buf_temp-browse-handle.browse-handle :width
     1277               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1278             no-error .
     1279           if error-status :error
     1280           or error-status :get-message(1) <> ""
     1281           then do:
     1282             undo move_block, retry move_block .
     1283           end.
     1284         end.
     1285         assign
     1286           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1287           no-error .
     1288         if error-status :error
     1289         or error-status :get-message(1) <> ""
     1290         then do:
     1291           undo move_block, retry move_block.
     1292         end.
     1293         assign
     1294           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1295         no-error .
     1296         if error-status :error
     1297         or error-status :get-message(1) <> ""
     1298         then do:
     1299           undo move_block, retry move_block.
     1300         end.
     1301         if frame Dialog-Frame :scrollable = true
     1302         then do:
     1303           assign
     1304             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1305           no-error .
     1306           if error-status :error
     1307           or error-status :get-message(1) <> ""
     1308           then do:
     1309             undo move_block, retry move_block.
     1310           end.
     1311         end.
     1312       end.
     1313       if p-move-resize
     1314       then do:
     1315         run diasize_position-resize-button in this-procedure .
     1316       end.
     1317       if v-diasize-wndstore = true
     1318       then do:
     1319         if connected("ub") = true
     1320         then do:
     1321           define variable v-cntxt-db-num        as integer   no-undo .
     1322           define variable v-cntxt-userid        as character no-undo .
     1323           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1324                                             , OUTPUT v-cntxt-userid
     1325                                             ) .
     1326           run gbl/wndsizew.p
     1327             (input  v-cntxt-db-num
     1328             ,input  v-cntxt-userid
     1329             ,input  v-diasize-proc-name
     1330             ,input  'width':u
     1331             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1332             ) .
     1333         end.
     1334       end.
     1335     end.
     1336     assign
     1337       v-diasize-change-size = false
     1338     .
     1339   end procedure.
     1340   procedure diasize_set-width :
     1341     define input  parameter p-new-width  as decimal   no-undo .
     1342     define input  parameter p-move-resize as logical   no-undo .
     1343     do
     1344     on error undo, return error return-value
     1345     :
     1346       run diasize_change-width in this-procedure
     1347         (input  (p-new-width - frame Dialog-Frame :width)
     1348         ,input  p-move-resize
     1349         ) .
     1350     end.
     1351   end procedure.
     1352   procedure diasize_position-resize-button :
     1353     do with frame Dialog-Frame
     1354     :
     1355       hide v-diasize-resize-button .
     1356       assign
     1357         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1358                     - 1
     1359                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1360         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1361                     - 1
     1362                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1363       .
     1364       view v-diasize-resize-button .
     1365     end.
     1366   end procedure.
     1367   on alt-right anywhere
     1368   do:
     1369     run diasize_change-width in this-procedure
     1370       (input 1
     1371       ,input true
     1372       ) .
     1373     return no-apply .
     1374   end.
     1375   on alt-left anywhere
     1376   do:
     1377     run diasize_change-width in this-procedure
     1378       (input -1
     1379       ,input true
     1380       ) .
     1381     return no-apply .
     1382   end.
     1383   on alt-down anywhere
     1384   do:
     1385     run diasize_change-height in this-procedure
     1386       (input 1
     1387       ,input true
     1388       ) .
     1389     return no-apply .
     1390   end.
     1391   on alt-up anywhere
     1392   do:
     1393     run diasize_change-height in this-procedure
     1394       (input -1
     1395       ,input true
     1396       ) .
     1397     return no-apply .
     1398   end.
     1399   on alt-enter of frame Dialog-Frame
     1400   do:
     1401     run diasize_maximize in this-procedure
     1402       (input  ?
     1403       ).
     1404     return no-apply .
     1405   end.
     1406   procedure diasize_end-move :
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       define variable v-row-delta as decimal   no-undo .
     1411       define variable v-col-delta as decimal   no-undo .
     1412       define variable v-new-row as decimal   no-undo .
     1413       define variable v-new-col as decimal   no-undo .
     1414       assign
     1415         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1416         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1417       .
     1418       assign
     1419         v-row-delta = v-new-row - frame Dialog-Frame :height
     1420         v-col-delta = v-new-col - frame Dialog-Frame :width
     1421       .
     1422       run diasize_change-height in this-procedure
     1423         (input v-row-delta
     1424         ,input true
     1425         ) .
     1426       run diasize_change-width in this-procedure
     1427         (input v-col-delta
     1428         ,input true
     1429         ) .
     1430     end.
     1431   end procedure.
     1432   procedure diasize_maximize :
     1433     define input  parameter p-action as logical   no-undo .
     1434     do
     1435     on error undo, return error return-value
     1436     :
     1437       if p-action = ?
     1438       then do:
     1439         if v-diasize-need-maximize = true
     1440         then do:
     1441           assign
     1442             p-action = true
     1443           .
     1444         end.
     1445         else do:
     1446           assign
     1447             p-action = false
     1448           .
     1449         end.
     1450       end.
     1451       if p-action = true
     1452       then do:
     1453         run diasize_change-height in this-procedure
     1454           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1455               - frame Dialog-Frame :height-chars
     1456           ,input true
     1457           ) .
     1458         run diasize_change-width in this-procedure
     1459           (input session :width-chars
     1460               - frame Dialog-Frame :width-chars
     1461           ,input true
     1462           ) .
     1463         assign
     1464           v-diasize-need-maximize = false
     1465         .
     1466       end.
     1467       else do:
     1468         run diasize_change-width in this-procedure
     1469           (input v-diasize-orig-frame-width
     1470               - frame Dialog-Frame :width-chars
     1471           ,input true
     1472           ) .
     1473         run diasize_change-height in this-procedure
     1474           (input v-diasize-orig-frame-height
     1475               - frame Dialog-Frame :height-chars
     1476           ,input true
     1477           ) .
     1478         assign
     1479           v-diasize-need-maximize = true
     1480         .
     1481       end.
     1482     end.
     1483   end procedure.
     1484   procedure diasize_restore-orig-size :
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488       assign
     1489         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1490         v-diasize-current-frame-height = frame Dialog-Frame :height
     1491       .
     1492       run diasize_set-height in this-procedure
     1493         (input  v-diasize-orig-frame-height
     1494         ,input  true
     1495         ) .
     1496       run diasize_set-width in this-procedure
     1497         (input  v-diasize-orig-frame-width
     1498         ,input  true
     1499         ) .
     1500     end.
     1501   end procedure.
     1502   procedure diasize_restore-current-size :
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506       run diasize_set-height in this-procedure
     1507         (input  v-diasize-current-frame-height
     1508         ,input  true
     1509         ) .
     1510       run diasize_set-width in this-procedure
     1511         (input  v-diasize-current-frame-width
     1512         ,input  true
     1513         ) .
     1514     end.
     1515   end procedure.
     1516   procedure diasize_set-browse-handle :
     1517     define input  parameter p-browse-handle as handle   no-undo .
     1518     define buffer buf_temp-browse-handle for temp-browse-handle .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       assign
     1523         v-diasize-browse-handle = p-browse-handle
     1524       .
     1525       for each buf_temp-browse-handle
     1526       on error undo, return error return-value
     1527       :
     1528         delete buf_temp-browse-handle .
     1529       end.
     1530     end.
     1531   end procedure.
     1532   procedure diasize_add_browse :
     1533     define input  parameter p-browse-type   as character no-undo .
     1534     define input  parameter p-browse-handle as handle    no-undo .
     1535     define buffer buf_temp-browse-handle for temp-browse-handle .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         v-diasize-browse-number = v-diasize-browse-number + 1
     1541       .
     1542       create buf_temp-browse-handle .
     1543       assign
     1544         buf_temp-browse-handle.browse-type   = p-browse-type
     1545         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1546         buf_temp-browse-handle.browse-handle = p-browse-handle
     1547       .
     1548     end.
     1549   end procedure.
     1550   procedure diasize_init :
     1551     define variable v-default-value    as logical   no-undo .
     1552     define variable v-restore-saved    as logical   no-undo .
     1553     define variable v-resize-value-str as character no-undo .
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       do with frame Dialog-Frame
     1558       :
     1559         assign
     1560           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1561           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1562           v-diasize-browse-handle     = browse br-docs :handle
     1563         .
     1564         create button v-diasize-resize-button
     1565         assign
     1566           parent        = frame Dialog-Frame :first-child
     1567           label         = "s"
     1568           height-pixels = 16
     1569           width-pixels  = 16
     1570           visible       = true
     1571           sensitive     = true
     1572           movable       = true
     1573           triggers:
     1574             on end-move persistent run diasize_end-move in this-procedure .
     1575           end triggers.
     1576         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1577         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1578         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1579         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1580         assign
     1581           v-diasize-wndmax = false
     1582         .
     1583         if connected("ub") = true
     1584         then do:
     1585           define variable v-cntxt-db-num        as integer   no-undo .
     1586           define variable v-cntxt-userid        as character no-undo .
     1587           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1588                                             , OUTPUT v-cntxt-userid
     1589                                             ) .
     1590           run gbl/wndpar_r.p
     1591             (input  v-cntxt-db-num
     1592             ,input  v-cntxt-userid
     1593             ,input  'wndmax':U
     1594             ,output v-diasize-wndmax
     1595             ,output v-default-value
     1596             ) .
     1597         end.
     1598         assign
     1599           v-diasize-wndstore = false
     1600         .
     1601         if connected("ub") = true
     1602         then do:
     1603           run gbl/wndpar_r.p
     1604             (input  v-cntxt-db-num
     1605             ,input  v-cntxt-userid
     1606             ,input  'wndstore':U
     1607             ,output v-diasize-wndstore
     1608             ,output v-default-value
     1609             ) .
     1610         end.
     1611         assign
     1612           v-diasize-proc-name = entry(1, program-name(2), '.')
     1613         .
     1614         if v-diasize-wndstore = true
     1615         then do:
     1616           assign
     1617             v-restore-saved = false
     1618           .
     1619           if connected("ub") = true
     1620           then do:
     1621             run gbl/wndsizer.p
     1622               (input  v-cntxt-db-num
     1623               ,input  v-cntxt-userid
     1624               ,input  v-diasize-proc-name
     1625               ,input  'height':u
     1626               ,output v-resize-value-str
     1627               ) .
     1628             if v-resize-value-str <> '':U
     1629             then do:
     1630               run diasize_change-height in this-procedure
     1631                 (input  integer(v-resize-value-str)
     1632                 ,input  true
     1633                 ) .
     1634               assign
     1635                 v-restore-saved = true
     1636               .
     1637             end.
     1638           end.
     1639           if connected("ub") = true
     1640           then do:
     1641             run gbl/wndsizer.p
     1642               (input  v-cntxt-db-num
     1643               ,input  v-cntxt-userid
     1644               ,input  v-diasize-proc-name
     1645               ,input  'width':u
     1646               ,output v-resize-value-str
     1647               ) .
     1648             if v-resize-value-str <> '':U
     1649             then do:
     1650               run diasize_change-width in this-procedure
     1651                 (input  integer(v-resize-value-str)
     1652                 ,input  true
     1653                 ) .
     1654               assign
     1655                 v-restore-saved = true
     1656               .
     1657             end.
     1658           end.
     1659           if v-restore-saved <> true
     1660           then do:
     1661             if v-diasize-wndmax = true
     1662             then do:
     1663               run diasize_maximize in this-procedure
     1664                 (input  true
     1665                 ) .
     1666             end.
     1667           end.
     1668         end.
     1669         else do:
     1670           if v-diasize-wndmax = true
     1671           then do:
     1672             run diasize_maximize in this-procedure
     1673               (input  true
     1674               ) .
     1675           end.
     1676         end.
     1677       end.
     1678     end.
     1679   end procedure.
     1680   procedure diasize_need-full-display :
     1681     define output parameter p-need-full-display as logical   no-undo .
     1682     do
     1683     on error undo, return error return-value
     1684     :
     1685       assign
     1686         p-need-full-display = v-diasize-need-full-display
     1687       .
     1688       assign
     1689         v-diasize-need-full-display = false
     1690       .
     1691     end.
     1692   end procedure.
     1693   procedure get-context :
     1694      define output parameter p-db-num as integer          no-undo.
     1695      define output parameter p-user-id as character        no-undo.
     1696      define variable v-login               as character    no-undo.
     1697      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1698      define buffer buf_user-login  for ub.user-login .
     1699      do
     1700      on error undo, return error
     1701      :
     1702            FIND FIRST buf_sys-ctrl no-lock.
     1703            ASSIGN
     1704               v-login = USERID("ub")
     1705               p-db-num = buf_sys-ctrl.db-num
     1706            .
     1707            FIND FIRST buf_user-login
     1708                 WHERE buf_user-login.db-num = p-db-num
     1709                   AND buf_user-login.user-login = v-login
     1710                 no-lock
     1711                 no-error
     1712                 .
     1713            IF AVAILABLE buf_user-login
     1714            THEN DO:
     1715               assign
     1716                  p-user-id = buf_user-login.user-id
     1717               .
     1718            END.
     1719      end.
     1720   end procedure.
     1721       run diasize_init in this-procedure .
     1722       run enable_UI .
     1723       if par-mode = 'ПРОСМОТР':U then
     1724       do:
     1725           p-ok = true .
     1726           disable B-chg with frame Dialog-Frame .
     1727       end.
     1728       WAIT-FOR GO OF FRAME Dialog-Frame.
     1729   END.
     1730   RUN disable_UI in this-procedure .
     1731   PROCEDURE disable_UI :
     1732       HIDE FRAME Dialog-Frame.
     1733   END PROCEDURE.
     1734   PROCEDURE enable_UI :
     1735       ENABLE b-quit B-lookup B-chg B-print br-docs
     1736           WITH FRAME Dialog-Frame.
     1737       VIEW FRAME Dialog-Frame.
     1738       OPEN QUERY br-docs FOR EACH c-doc where c-doc.obj-code = parobj-code and c-doc.obj-type = parobj-type and c-doc.shift-date = parshift-date and c-doc.shift-num = parshift-num and c-doc.shift-name = parshift-name NO-LOCK INDEXED-REPOSITION.
     1739   END PROCEDURE.
     1740   PROCEDURE PrintProc :
     1741   END PROCEDURE.
     1742   PROCEDURE proc-b-chg :
     1743   END PROCEDURE.
     1744   PROCEDURE reposition-chk-doc :
     1745       define input  parameter p-direction   as character no-undo .
     1746       define output parameter p-chk-doc-recid as recid no-undo .
     1747       define buffer buf_chk-doc for ub.chk-doc .
     1748       case p-direction :
     1749           when "first":U
     1750           then
     1751               do:
     1752                   get first br-docs.
     1753               end.
     1754           when "last":U
     1755           then
     1756               do:
     1757                   get last br-docs.
     1758               end.
     1759           when "prev":U
     1760           then
     1761               do:
     1762                   get prev br-docs.
     1763                   if not available c-doc then
     1764                   do:
     1765                       message
     1766                           "Это первый чек списка"
     1767                           view-as alert-box.
     1768                   end.
     1769               end.
     1770           when "next":U
     1771           then
     1772               do:
     1773                   get next br-docs.
     1774                   if not available c-doc then
     1775                   do:
     1776                       message
     1777                           "Это последний чек списка"
     1778                           view-as alert-box.
     1779                   end.
     1780               end.
     1781       end case .
     1782       find first buf_chk-doc no-lock where buf_chk-doc.doc-code = c-doc.doc-code no-error .
     1783       if available (buf_chk-doc) then
     1784       do:
     1785           assign
     1786               p-chk-doc-recid = recid(buf_chk-doc)
     1787               .
     1788           run reposition-query in this-procedure
     1789               (input p-chk-doc-recid
     1790               ).
     1791       end.
     1792   END PROCEDURE.
     1793   PROCEDURE reposition-query :
     1794       define input parameter p-recid as recid no-undo .
     1795       define variable p-rec as recid no-undo .
     1796       define buffer buf_chk-doc for ub.chk-doc .
     1797       if p-recid <> ?
     1798           then
     1799       do:
     1800           find first buf_chk-doc no-lock where recid (buf_chk-doc) = p-recid .
     1801           find first c-doc no-lock where c-doc.doc-code = buf_chk-doc.doc-code .
     1802           p-rec = recid (c-doc) .
     1803           reposition br-docs to recid p-rec no-error.
     1804       end.
     1805       do with frame Dialog-Frame:
     1806           apply "entry":u to browse br-docs .
     1807           apply "VALUE-CHANGED":u to browse br-docs .
     1808       end.
     1809   END PROCEDURE.
     1810   PROCEDURE proc-b-print :
     1811       define VARIABLE p-report-id         as character no-undo .
     1812       define variable v-file-name-rep-htm as character no-undo .
     1813       define buffer buf_shiftParam for ub.shift-param .
     1814       define buffer buf_goods      for ub.goods .
     1815       define buffer buf_susp-chk   for ub.susp-chk .
     1816       define buffer bf_shift-obj   for ub.shift-obj .
     1817       run get-report-num (output p-report-id).
     1818       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1819       find first bf_shift-obj no-lock where bf_shift-obj.obj-code = parobj-code and
     1820           bf_shift-obj.obj-type = parobj-type and
     1821           bf_shift-obj.shift-date = parshift-date and
     1822           bf_shift-obj.Shift-num = parshift-num no-error .
     1823       if not available (bf_shift-obj) then return error.
     1824       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1825       put stream OutStr-html unformatted
     1826           "<!DOCTYPE HTML>" skip
     1827           ' <html>' skip
     1828           '  <head>' skip
     1829           '   <meta charset="utf-8">' skip
     1830           '    <style type="text/css">' skip
     1831           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1832           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1833           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1834           '   </style>' skip
     1835           '  </head>' skip
     1836           .
     1837       put stream OutStr-html unformatted
     1838           '<body>' skip
     1839           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1840           '<thead>' skip
     1841           .
     1842       put stream OutStr-html unformatted
     1843           '<tr class="set_columns">' skip
     1844           '<td style="width: 100px;"></td>' skip
     1845           '<td style="width: 200px;"></td>' skip
     1846           '<td style="width: 100px;"></td>' skip
     1847           '<td style="width: 150px;"></td>' skip
     1848           '<td style="width: 150px;"></td>' skip
     1849           '<td style="width: 150px;"></td>' skip
     1850           '<td style="width: 150px;"></td>' skip
     1851           '<td style="width: 150px;"></td>' skip
     1852           '<td style="width: 350px;"></td>' skip
     1853           '</tr>' skip
     1854           .
     1855       put stream OutStr-html unformatted
     1856           '<tr>' skip
     1857           '<td colspan="9" style="text-align: left;">АЗК №' + string(bf_shift-obj.obj-code) + ' </td>' skip
     1858           '</tr>' skip
     1859           .
     1860       put stream OutStr-html unformatted
     1861           '</thead>' skip .
     1862       put stream OutStr-html unformatted
     1863           '<TR style="height:55px;">' skip
     1864           '<TD text_wrap="true" colspan="9" style="text-align: center; font-weight:bold;">"Подозрительные" чеки.</TD>' skip
     1865           '</tr>' skip
     1866           '<tr>' skip
     1867           '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Признак</TD>' skip
     1868           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека в ТН</TD>' skip
     1869           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Тип чека</TD>' skip
     1870           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека на кассе</TD>' skip
     1871           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ кассы</TD>' skip
     1872           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата/время</TD>' skip
     1873           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина возникновения чека</TD>' skip
     1874           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Ссылка на "корректный" чек</TD>' skip
     1875           '</TR>' skip
     1876           .
     1877       for each buf_susp-chk no-lock
     1878           where buf_susp-chk.obj-code = parobj-code
     1879           and buf_susp-chk.obj-type = parobj-type
     1880           and buf_susp-chk.shift-date = parshift-date
     1881           and buf_susp-chk.shift-num = parshift-num:
     1882           put stream OutStr-html unformatted
     1883               '<TR>' skip
     1884               '<TD text_wrap="true" colspan="2" style="text-align: center;">' + buf_susp-chk.office + '</TD>' skip
     1885               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.doc-code) + '</TD>' skip
     1886               '<TD text_wrap="true" style="text-align: center;">' + Str-chk-type(string(buf_susp-chk.chk-type)) + '</TD>' skip
     1887               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.chk-num) + '</TD>' skip
     1888               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.pay-desk) + '</TD>' skip
     1889               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.chk-date,"99.99.9999") + '/' + string(buf_susp-chk.chk-time,"hh:mm") + '</TD>' skip
     1890               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.reason-name) + '</TD>' skip
     1891               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.link-chk) + '</TD>' skip
     1892               '</tr>' skip
     1893               .
     1894       end.
     1895       put stream OutStr-html unformatted
     1896           '</tbody>' skip .
     1897       put stream OutStr-html unformatted
     1898           '</table>' skip
     1899           '</body>' skip
     1900           '</html>' skip
     1901           .
     1902       output stream OutStr-html close.
     1903       run prn-lib-reportviewer-report-name in this-procedure (
     1904           input parparentproc
     1905           ,input v-file-name-rep-htm
     1906           ) .
     1907       if error-status:error then
     1908       do:
     1909           message return-value view-as alert-box.
     1910           return .
     1911       end.
     1912   END PROCEDURE.
     1913   PROCEDURE get-report-num :
     1914       define output parameter p-report-num as integer no-undo .
     1915       do
     1916           on error undo, return error return-value
     1917           :
     1918           run gbl/getrpnum.p (output p-report-num).
     1919       end.
     1920   END PROCEDURE.
     1921   function Str-chk-type returns character
     1922       (input p-chk-type as character):
     1923       define variable v-num-element   as integer   no-undo.
     1924       define variable p-name-chk-type as character no-undo .
     1925       v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     1926       p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     1927       if p-chk-type <> "" and v-num-element = 0 then
     1928       do:
     1929           message "Ошибка 115." view-as alert-box.
     1930       end.
     1931       else return p-name-chk-type .
     1932   end function.
     1933   function datetime_ returns character
     1934       (input p-chk-date as date, input p-chk-time as integer):
     1935       define variable p-datetime as character no-undo .
     1936       p-datetime = string(p-chk-date,"99.99.9999") + " " + string(p-chk-time,"HH:MM") .
     1937       return p-datetime .
     1938   end function.
