      367         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p7)
      368         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p8)
      369         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p9)
      370         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p10)
      371         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p11)
      372         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p12)
      373         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p13)
      374         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p14)
      375         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p15)
      376         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p16)
      377         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p17)
      378         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p18)
      379       .
      380     end.
      381     ii = num-entries (v-density-20-list) .
      382     if p-tank-density-pomi > decimal (entry (ii, v-density-20-list)) or p-tank-density-pomi < decimal (entry(1, v-density-20-list))
      383     then do:
      384       message substitute ("Не возможно выполнить приведение объема, т.к. приведенная плотность вышла за допустимый диапазон &1:&2", decimal (entry(1, v-density-20-list)), decimal (entry (ii, v-density-20-list))) view-as alert-box information.
      385       p-tank-vol-pomi = ? .
      386     end.
      387     else do:
      388       _forvollist:
      389       do ii = 1 to num-entries (v-density-20-list) :
      390         if p-tank-density-pomi >=  decimal (entry(ii, v-density-20-list)) and p-tank-density-pomi <=  decimal (entry(ii + 1, v-density-20-list))
      391         then do:
      392           leave _forvollist.
      393         end.
      394       end.
      395       assign
      396         x1 = decimal (entry(ii, v-vol-list1)) +
      397             (p-tank-density - decimal (entry(ii, v-density-20-list))) * (decimal (entry(ii + 1, v-vol-list1)) - decimal (entry(ii, v-vol-list1))) / 10
      398         x2 = decimal (entry(ii, v-vol-list2)) +
      399             (p-tank-density - decimal (entry(ii, v-density-20-list))) * (decimal (entry(ii + 1, v-vol-list2)) - decimal (entry(ii, v-vol-list2))) / 10
      400         v-coef-vol = (x1 + x2) / 2
      401       .
      402     end.
      403     assign
      404       p-tank-density-pomi = p-tank-density-pomi / 1000
      405       p-tank-vol-pomi = v-coef-vol * p-tank-vol when v-coef-vol <> ? and v-coef-vol <> 0
      406     .
      407     put stream outstream unformatted v-temp1 " - " v-vol-list1 skip v-temp2 " - " v-vol-list2 skip "область: " x1 " - " x2 skip "коэф. " v-coef-vol " прив. объем " p-tank-vol-pomi skip.
      408     put stream outstream unformatted "конец" skip.
      409     output stream outstream close.
      410     input stream str-fueldt close.
      411     input stream str-fuelvt close.
      412   end.
