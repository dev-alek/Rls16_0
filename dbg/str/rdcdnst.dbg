        1   block-level on error undo, throw.
        2   define input parameter p-tank-density as decimal    no-undo.
        3   define input parameter p-dens-temp    as decimal    no-undo.
        4   define input parameter p-tank-vol     as decimal    no-undo.
        5   define input parameter p-tank-temp    as decimal    no-undo.
        6   define input parameter p-fuel-type    as character  no-undo.
        7   define output parameter p-tank-density-pomi  as decimal no-undo.
        8   define output parameter p-tank-vol-pomi as decimal no-undo.
        9   define temp-table tt-fueldt no-undo
       10     field temp as decimal
       11     field p1   as decimal
       12     field p2   as decimal
       13     field p3   as decimal
       14     field p4   as decimal
       15     field p5   as decimal
       16     field p6   as decimal
       17     field p7   as decimal
       18     field p8   as decimal
       19     field p9   as decimal
       20     field p10  as decimal
       21     field p11  as decimal
       22     field p12  as decimal
       23     field p13  as decimal
       24     field p14  as decimal
       25     field p15  as decimal
       26     field p16  as decimal
       27     field p17  as decimal
       28     field p18  as decimal
       29     index pi is primary temp
       30   .
       31   define temp-table tt-fuelvt no-undo
       32     field temp as decimal
       33     field p1   as decimal
       34     field p2   as decimal
       35     field p3   as decimal
       36     field p4   as decimal
       37     field p5   as decimal
       38     field p6   as decimal
       39     field p7   as decimal
       40     field p8   as decimal
       41     field p9   as decimal
       42     field p10  as decimal
       43     field p11  as decimal
       44     field p12  as decimal
       45     field p13  as decimal
       46     field p14  as decimal
       47     field p15  as decimal
       48     field p16  as decimal
       49     field p17  as decimal
       50     field p18  as decimal
       51     index pi is primary temp ascending
       52   .
       53   define temp-table tt-dieseldt no-undo
       54     field temp as decimal
       55     field p1   as decimal
       56     field p2   as decimal
       57     field p3   as decimal
       58     field p4   as decimal
       59     field p5   as decimal
       60     field p6   as decimal
       61     field p7   as decimal
       62     field p8   as decimal
       63     field p9   as decimal
       64     field p10  as decimal
       65     field p11  as decimal
       66     index pi is primary temp
       67   .
       68   define temp-table tt-dieselvt no-undo
       69     field temp as decimal
       70     field p1   as decimal
       71     field p2   as decimal
       72     field p3   as decimal
       73     field p4   as decimal
       74     field p5   as decimal
       75     field p6   as decimal
       76     field p7   as decimal
       77     field p8   as decimal
       78     field p9   as decimal
       79     field p10  as decimal
       80     field p11  as decimal
       81     index pi is primary temp ascending
       82   .
       83   do:
       84     def var str as char.
       85     define variable file-fuel         as character no-undo.
       86     define variable file-vol          as character no-undo.
       87     define variable v-density-list1   as character no-undo.
       88     define variable v-density-list2   as character no-undo.
       89     define variable v-density-20-list as character no-undo.
       90     define variable v-vol-list1   as character no-undo.
       91     define variable v-vol-list2   as character no-undo.
       92     define variable v-coef-vol    as decimal   no-undo.
       93     define variable x1        as decimal   no-undo init ?.
       94     define variable x2        as decimal   no-undo init ?.
       95     define variable v-temp1   as decimal   no-undo init ?.
       96     define variable v-temp2   as decimal   no-undo init ?.
       97     define variable ii        as integer   no-undo.
       98     define stream str-fueldt.
       99     define stream str-fuelvt.
      100     define stream outstream.
      101     output stream outstream to value ("rdcdnst.log") append.
      102     assign
      103       file-fuel = search ('cmp/petrldt.txt') when p-fuel-type = "petrol"
      104       file-fuel = search ('cmp/dsldt.txt') when p-fuel-type = "diesel-sum" or p-fuel-type = "diesel-wint"
      105       file-vol = search ('cmp/petrlvt.txt') when p-fuel-type = "petrol"
      106       file-vol = search ('cmp/dslvt.txt') when p-fuel-type = "diesel-sum" or p-fuel-type = "diesel-wint"
      107     .
      108     if file-fuel = ? or file-vol = ? then do:
      109       undo, return error "Не найдены файлы с таблицами привидения плотности и объема".
      110     end.
      111     input stream str-fueldt from value(file-fuel).
      112     input stream str-fuelvt from value(file-vol).
      113     if p-fuel-type matches "*diesel*" then do:
      114       repeat :
      115         create tt-dieseldt no-error.
      116         import stream str-fueldt delimiter ";" tt-dieseldt.
      117       end.
      118       for each tt-dieseldt where tt-dieseldt.p1 = 0  and tt-dieseldt.temp = 0:
      119         delete tt-dieseldt.
      120       end.
      121       find first tt-dieseldt where tt-dieseldt.temp = 20 no-error.
      122       if not available tt-dieseldt then  undo, return error "Не верная таблица приведения плотности".
      123       assign
      124         v-density-20-list = string (tt-dieseldt.p1)
      125         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p2)
      126         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p3)
      127         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p4)
      128         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p5)
      129         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p6)
      130         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p7)
      131         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p8)
      132         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p9)
      133         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p10)
      134         v-density-20-list = v-density-20-list + "," + string (tt-dieseldt.p11)
      135       .
      136       find first tt-dieseldt where tt-dieseldt.temp = p-dens-temp use-index pi no-error.
      137       if not available tt-dieseldt then do:
      138         find first tt-dieseldt where tt-dieseldt.temp > p-dens-temp use-index pi no-error.
      139       end.
      140       if not available tt-dieseldt then  undo, return error "Температура измерений за допустимыми пределами".
      141       assign
      142         v-temp2 = tt-dieseldt.temp
      143         v-density-list2 = string (tt-dieseldt.p1)
      144         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p2)
      145         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p3)
      146         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p4)
      147         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p5)
      148         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p6)
      149         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p7)
      150         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p8)
      151         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p9)
      152         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p10)
      153         v-density-list2 = v-density-list2 + "," + string (tt-dieseldt.p11)
      154       .
      155       if tt-dieseldt.temp <> p-dens-temp then do:
      156         find prev tt-dieseldt where tt-dieseldt.temp < p-dens-temp use-index pi no-error.
      157       end.
      158       if not available tt-dieseldt then  undo, return error "Температура измерений за допустимыми пределами".
      159       assign
      160         v-temp1 = tt-dieseldt.temp
      161         v-density-list1 = string (tt-dieseldt.p1)
      162         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p2)
      163         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p3)
      164         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p4)
      165         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p5)
      166         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p6)
      167         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p7)
      168         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p8)
      169         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p9)
      170         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p10)
      171         v-density-list1 = v-density-list1 + "," + string (tt-dieseldt.p11)
      172       .
      173     end.
      174     else do:
      175       repeat :
      176         create tt-fueldt no-error.
      177         import stream str-fueldt delimiter ";" tt-fueldt.
      178       end.
      179       for each tt-fueldt where tt-fueldt.p1 = 0  and tt-fueldt.temp = 0:
      180         delete tt-fueldt.
      181       end.
      182       find first tt-fueldt where tt-fueldt.temp = 20 no-error.
      183       if not available tt-fueldt then  undo, return error "Не верная таблица приведения плотности".
      184       assign
      185         v-density-20-list = string (tt-fueldt.p1)
      186         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p2)
      187         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p3)
      188         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p4)
      189         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p5)
      190         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p6)
      191         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p7)
      192         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p8)
      193         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p9)
      194         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p10)
      195         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p11)
      196         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p12)
      197         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p13)
      198         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p14)
      199         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p15)
      200         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p16)
      201         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p17)
      202         v-density-20-list = v-density-20-list + "," + string (tt-fueldt.p18)
      203       .
      204       find first tt-fueldt where tt-fueldt.temp = p-dens-temp use-index pi no-error.
      205       if not available tt-fueldt then do:
      206         find first tt-fueldt where tt-fueldt.temp > p-dens-temp use-index pi no-error.
      207       end.
      208       if not available tt-fueldt then  undo, return error "Температура измерений за допустимыми пределами".
      209       assign
      210         v-temp2 = tt-fueldt.temp
      211         v-density-list2 = string (tt-fueldt.p1)
      212         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p2)
      213         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p3)
      214         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p4)
      215         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p5)
      216         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p6)
      217         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p7)
      218         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p8)
      219         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p9)
      220         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p10)
      221         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p11)
      222         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p12)
      223         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p13)
      224         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p14)
      225         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p15)
      226         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p16)
      227         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p17)
      228         v-density-list2 = v-density-list2 + "," + string (tt-fueldt.p18)
      229       .
      230       if tt-fueldt.temp <> p-dens-temp then do:
      231         find prev tt-fueldt where tt-fueldt.temp < p-dens-temp use-index pi no-error.
      232       end.
      233       if not available tt-fueldt then  undo, return error "Температура измерений за допустимым пределами".
      234       assign
      235         v-temp1 = tt-fueldt.temp
      236         v-density-list1 = string (tt-fueldt.p1)
      237         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p2)
      238         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p3)
      239         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p4)
      240         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p5)
      241         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p6)
      242         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p7)
      243         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p8)
      244         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p9)
      245         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p10)
      246         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p11)
      247         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p12)
      248         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p13)
      249         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p14)
      250         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p15)
      251         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p16)
      252         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p17)
      253         v-density-list1 = v-density-list1 + "," + string (tt-fueldt.p18)
      254       .
      255     end.
      256     ii = num-entries (v-density-20-list) .
      257     if p-tank-density > decimal (entry (ii, v-density-20-list)) or p-tank-density < decimal (entry(1, v-density-20-list))
      258         then  undo, return error substitute ("Измеренная плотность вышла за допустимый диапазон &1:&2", decimal (entry(1, v-density-20-list)), decimal (entry (ii, v-density-20-list))).
      259     _fordenslist:
      260     do ii = 1 to num-entries (v-density-20-list) :
      261       if p-tank-density >=  decimal (entry(ii, v-density-20-list)) and p-tank-density <=  decimal (entry(ii + 1, v-density-20-list))
      262       then do:
      263         leave _fordenslist.
      264       end.
      265     end.
      266     assign
      267       x1 = decimal (entry(ii, v-density-list1)) +
      268           (p-tank-density - decimal (entry(ii, v-density-20-list))) * (decimal (entry(ii + 1, v-density-list1)) - decimal (entry(ii, v-density-list1))) / 10
      269       x2 = decimal (entry(ii, v-density-list2)) +
      270           (p-tank-density - decimal (entry(ii, v-density-20-list))) * (decimal (entry(ii + 1, v-density-list2)) - decimal (entry(ii, v-density-list2))) / 10
      271       p-tank-density-pomi = (x1 + x2) / 2
      272     .
      273     put stream outstream unformatted "начало" skip.
      274     put stream outstream unformatted v-temp1 " - " v-density-list1 skip v-temp2 " - " v-density-list2 skip "область: " x1 " - " x2 skip "приведенная плотность: " p-tank-density-pomi skip.
      275     if p-fuel-type matches "*diesel*" then do:
      276      repeat :
      277         create tt-dieselvt no-error.
      278         import stream str-fuelvt delimiter ";" tt-dieselvt.
      279       end.
      280       for each tt-dieselvt where tt-dieselvt.p1 = 0  and tt-dieselvt.temp = 0:
      281         delete tt-dieselvt.
      282       end.
      283       find first tt-dieselvt where tt-dieselvt.temp = p-tank-temp no-error.
      284       if not available tt-dieselvt then do:
      285         find first tt-dieselvt where tt-dieselvt.temp > p-tank-temp use-index pi no-error.
      286       end.
      287       if not available tt-dieselvt then  undo, return error "Температура измерений объема за допустимыми пределами".
      288       assign
      289         v-temp2 = tt-dieselvt.temp
      290         v-vol-list2 = string (tt-dieselvt.p1)
      291         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p2)
      292         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p3)
      293         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p4)
      294         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p5)
      295         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p6)
      296         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p7)
      297         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p8)
      298         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p9)
      299         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p10)
      300         v-vol-list2 = v-vol-list2 + "," + string (tt-dieselvt.p11)
      301       .
      302       if tt-dieselvt.temp <> p-tank-temp then do:
      303         find prev tt-dieselvt where tt-dieselvt.temp < p-tank-temp use-index pi no-error.
      304       end.
      305       if not available tt-dieselvt then  undo, return error "Температура измерений объема за допустимыми пределами".
      306       assign
      307         v-temp1 = tt-dieselvt.temp
      308         v-vol-list1 = string (tt-dieselvt.p1)
      309         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p2)
      310         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p3)
      311         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p4)
      312         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p5)
      313         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p6)
      314         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p7)
      315         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p8)
      316         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p9)
      317         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p10)
      318         v-vol-list1 = v-vol-list1 + "," + string (tt-dieselvt.p11)
      319       .
      320     end.
      321     else do:
      322       repeat :
      323         create tt-fuelvt no-error.
      324         import stream str-fuelvt delimiter ";" tt-fuelvt.
      325       end.
      326       for each tt-fuelvt where tt-fuelvt.p1 = 0  and tt-fuelvt.temp = 0:
      327         delete tt-fuelvt.
      328       end.
      329       find first tt-fuelvt where tt-fuelvt.temp = p-tank-temp no-error.
      330       if not available tt-fuelvt then do:
      331         find first tt-fuelvt where tt-fuelvt.temp > p-tank-temp use-index pi no-error.
      332       end.
      333       if not available tt-fuelvt then  undo, return error "Температура измерений объема за допустимыми пределами".
      334       assign
      335         v-temp2 = tt-fuelvt.temp
      336         v-vol-list2 = string (tt-fuelvt.p1)
      337         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p2)
      338         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p3)
      339         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p4)
      340         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p5)
      341         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p6)
      342         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p7)
      343         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p8)
      344         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p9)
      345         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p10)
      346         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p11)
      347         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p12)
      348         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p13)
      349         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p14)
      350         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p15)
      351         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p16)
      352         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p17)
      353         v-vol-list2 = v-vol-list2 + "," + string (tt-fuelvt.p18)
      354       .
      355       if tt-fuelvt.temp <> p-tank-temp then do:
      356         find prev tt-fuelvt where tt-fuelvt.temp < p-tank-temp use-index pi no-error.
      357       end.
      358       if not available tt-fuelvt then  undo, return error "Температура измерений объема за допустимыми пределами".
      359       assign
      360         v-temp1 = tt-fuelvt.temp
      361         v-vol-list1 = string (tt-fuelvt.p1)
      362         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p2)
      363         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p3)
      364         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p4)
      365         v-vol-list1 = v-vol-list1 + "," + string (tt-fuelvt.p5)
