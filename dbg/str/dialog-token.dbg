        1   define input parameter p-mode as logical no-undo .
        2   define input-output parameter p-Token as logical no-undo .
        3   DEFINE BUTTON Btn_cancel AUTO-GO
        4     LABEL "Отмена"
        5     SIZE 10 BY 1
        6     BGCOLOR 8 .
        7   DEFINE BUTTON Btn_OK AUTO-GO
        8     LABEL "Сохранить"
        9     SIZE 10 BY 1
       10     BGCOLOR 8 .
       11   DEFINE VARIABLE T-token AS LOGICAL INITIAL no
       12     LABEL "Отключить запрос Token"
       13     VIEW-AS TOGGLE-BOX
       14     SIZE 36 BY .83 NO-UNDO.
       15   DEFINE FRAME Dialog-Frame
       16     Btn_OK AT ROW 1 COL 1
       17     Btn_cancel AT ROW 1 COL 11.13 WIDGET-ID 2
       18     T-token AT ROW 2.75 COL 5.5 WIDGET-ID 4
       19     SPACE(0.00) SKIP(1.12)
       20     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       21     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       22     TITLE "Token"
       23     DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       24   ASSIGN
       25     FRAME Dialog-Frame:SCROLLABLE = FALSE
       26     FRAME Dialog-Frame:HIDDEN     = TRUE.
       27   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       28     DO:
       29       APPLY "END-ERROR":U TO SELF.
       30     END.
       31   ON VALUE-CHANGED OF T-token IN FRAME Dialog-Frame
       32     DO:
       33       assign t-token .
       34     END.
       35   ON choose OF Btn_OK IN FRAME Dialog-Frame
       36     DO:
       37       p-Token = t-token .
       38     END.
       39   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       40     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       41   MAIN-BLOCK:
       42   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       43     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       44     RUN enable_UI.
       45     WAIT-FOR GO OF FRAME Dialog-Frame.
       46   END.
       47   RUN disable_UI.
       48   PROCEDURE disable_UI :
       49     HIDE FRAME Dialog-Frame.
       50   END PROCEDURE.
       51   PROCEDURE enable_UI :
       52     T-token = p-Token .
       53     DISPLAY T-token
       54       WITH FRAME Dialog-Frame.
       55     if p-mode = yes then
       56     do:
       57       enable T-token with frame Dialog-Frame .
       58     end.
       59     ENABLE Btn_OK Btn_cancel WITH FRAME Dialog-Frame.
       60     VIEW FRAME Dialog-Frame.
       61   END PROCEDURE.
