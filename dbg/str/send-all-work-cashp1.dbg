      611   define variable Mfirst as logical no-undo.
      612   function getValueConvert returns character  (igroup as char,
      613                                                iparam as char,
      614                                                ivalue as char):
      615      define variable v-param-empty as character no-undo.
      616      v-param-empty = "MACC_IP,MaxApiToken,Proxy_*,LmCHzLogin,LmCHzPass,TspiotHostAddr".
      617      if igroup eq "FUCO"
      618      then do:
      619         if iparam eq "TrkDispAdr"
      620         then
      621            ivalue = "".
      622      end.
      623      else if igroup eq "GS1"
      624      then do:
      625         if can-do(v-param-empty, iparam)
      626         then
      627            ivalue = "".
      628      end.
      629      else if igroup eq "INTFACE"
      630      then do:
      631         if    iparam eq "DOMS_IP"
      632            or iparam eq "DOMSPASSWORD"
      633            or iparam eq "IFSFIP"
      634            or iparam eq "LOGURL"
      635            or iparam eq "MW20ADDRESS"
      636            or iparam eq "ONLINEADDR"
      637            or iparam eq "PRCATCHHOST"
      638            or iparam begins "MSG_Cas_"
      639         then
      640            ivalue = "".
      641      end.
      642      else if igroup eq "TABLEMENU"
      643      then do:
      644         if iparam eq "URL"
      645         then
      646            ivalue = "".
      647      end.
      648      else if igroup eq "UFO2"
      649      then do:
      650         if iparam eq "VPNtestIP"
      651         then
      652            ivalue = "".
      653      end.
      654      return ivalue.
      655   end.
      656   function getDevice returns integer ():
      657      define variable v-attr-value as character no-undo .
      658      define variable v-attr-type  as character no-undo .
      659      define variable v-device-kind as integer no-undo.
      660      define variable v-date as date no-undo.
      661      define variable v-decimal as decimal no-undo.
      662      define variable v-logical as logical no-undo.
      663      define variable v-dop as character no-undo.
      664      run cd-attr-value in this-procedure
      665         ( input mdb-num
      666            ,input mObjCode
      667            ,input mPostType
      668            ,input mCashNum
      669            ,input  (if mPostType = 'IBM-XML':U
      670                                                              then 'IBM-XML_operative':U
      671                                                              else 'AUTOTANK_operative':U)
      672            ,input  (if mPostType = 'IBM-XML':U
      673                                                              then 'device-kind':U
      674                                                              else 'device-kind':U)
      675            ,output v-attr-value
      676            ,output v-date
      677            ,output v-decimal
      678            ,output v-device-kind
      679            ,output v-logical
      680            ,output v-dop
      681            ) no-error.
      682      if v-device-kind = ?
      683      then v-device-kind = 0.
      684      return v-device-kind.
      685   end.
      686   define variable mParent as character no-undo.
      687   define variable mDevice as integer   no-undo.
      688   procedure putc :
      689      define input parameter iSAXWriter as handle no-undo .
      690      define input parameter i-action   as character  no-undo .
      691      define input parameter p-value    as character  no-undo .
      692      define output parameter oSend      as logical    no-undo.
      693      define buffer code-group for ub.code.
      694      define buffer code-param for ub.code.
      695      mDevice = getDevice().
      696      mParent = "cash-param" + chr(4) + string(mDevice).
      697      for each code-group where code-group.parent     eq mParent
      698                            and code-group.code       eq "1"
      699      no-lock:
      700         iSAXWriter:start-element("Param").
      701         do:
      702            iSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
      703            iSAXWriter:insert-attribute("group",  "*"                 )   no-error.
      704            iSAXWriter:insert-attribute("key",    "*"                 )   no-error.
      705         end.
      706         iSAXWriter:end-element("Param" ).
      707         oSend = yes.
      708         leave.
      709      end.
      710       mParent = mParent + chr(4) + string("1" ).
      711   end procedure.
      712   procedure get-cash-types:
      713      define output parameter otypes as character no-undo init "Autotank,IBM-XML".
      714   end.
      715   procedure get-root-teg:
      716      define output parameter otypes as character no-undo init "config".
      717   end.
      718   define variable parparentproc as handle no-undo.
      719   define variable mLogHandle    as handle no-undo.
      720   define variable mLogFile      as character no-undo.
      721   procedure set-context:
      722      define input         parameter iparparentproc as handle      no-undo.
      723      define input         parameter i-log-handle   as handle      no-undo.
      724      define input         parameter iLogFile       as character   no-undo.
      725      define output        parameter oProcIndo      as character   no-undo init "Настроек параметров".
      726      assign
      727         parparentproc = iparparentproc
      728         mLogHandle    = i-log-handle
      729         mLogFile      = iLogFile
      730      .
      731   end.
      732   procedure set-cash-info:
      733      define input         parameter iDB-num        as integer     no-undo.
      734      define input         parameter iObjType       as character   no-undo.
      735      define input         parameter iObjCode       as integer     no-undo.
      736      define input         parameter iPostType      as character   no-undo.
      737      define input         parameter iCashNum       as integer     no-undo.
      738      assign
      739         mDB-num       = iDB-num
      740         mObjType      = iObjType
      741         mObjCode      = iObjCode
      742         mPostType     = iPostType
      743         mCashNum      = iCashNum
      744         Mfirst        = yes
      745      .
      746   end.
      747   define variable mOk      as logical   no-undo init ?.
      748   procedure parse-result:
      749      define input         parameter iWebRespMptr  as memptr      no-undo.
      750      define input-output  parameter pViewLog      as logical     no-undo.
      751      mOk = ?.
      752      define variable hParser as handle no-undo.
      753      create sax-reader hParser.
      754      hParser:set-input-source("memptr", iWebRespMptr).
      755      hParser:sax-parse () no-error.
      756      if error-status:error
      757      then do:
      758         if error-status:num-messages > 0 then
      759            return error error-status:get-message(1).
      760         else
      761            return error return-value.
      762      end.
      763      delete object hParser.
      764      if not mOk
      765      then
      766         pViewLog = yes.
      767   end.
      768   procedure StartDocument:
      769   end procedure.
      770   define temp-table tt-cash-param-hist no-undo like ub.cash-param-hist .
      771   define variable mElement as character no-undo.
      772   define variable mtstamp as decimal no-undo.
      773   procedure StartElement:
      774     define input parameter namespaceURI as character.
      775     define input parameter localName as character.
      776     define input parameter qname as character.
      777     define input parameter attributes as handle.
      778     mElement = qname.
      779     if mElement = "Param" then do:
      780       empty temp-table tt-cash-param-hist.
      781       create tt-cash-param-hist.
      782       assign
      783         tt-cash-param-hist.obj-type    = mObjType
      784         tt-cash-param-hist.obj-code    = mObjCode
      785         tt-cash-param-hist.device      = mDevice
      786         tt-cash-param-hist.cash-num    = mCashNum
      787         tt-cash-param-hist.param_section      = "1"
      788         tt-cash-param-hist.param_group = attributes:get-value-by-qname("group")
      789         tt-cash-param-hist.param_name  = attributes:get-value-by-qname("key")
      790         tt-cash-param-hist.tstamp      = mtstamp + timezone(now) * 60
      791       .
      792     end.
      793     else if mElement = "config"
      794     then do:
      795        mtstamp = dec(attributes:get-value-by-qname("tstamp")).
      796     end.
      797   end procedure.
      798   procedure Characters:
      799     define input parameter charData as memptr.
      800     define input parameter numChars as integer.
      801     define variable vCurrContent as longchar no-undo.
      802     define variable vLengthMemptr as int64 no-undo.
      803     define variable vReadByte as int64 no-undo.
      804     define variable vRead     as integer no-undo.
      805     vLengthMemptr = numChars.
      806     do while vLengthMemptr - vReadByte > 0 :
      807        vRead = min(vLengthMemptr - vReadByte,30000).
      808        vCurrContent = vCurrContent + GET-STRING(charData,vReadByte + 1,vRead).
      809        vReadByte = vReadByte + vRead.
      810     end.
      811     if trim(vCurrContent) = "" then return.
      812     case mElement:
      813       when "ParamValue" then
      814         tt-cash-param-hist.param_value = vCurrContent .
      815       when "ParamDesc" then
      816         tt-cash-param-hist.description = vCurrContent .
      817       when "ErrorMessage" then do:
      818         run write-log-and-file in mLogHandle (
      819                                  input 1
      820                                , input mLogFile
      821                                , input 1
      822                                , input (if available tt-cash-param-hist
      823                                         then substitute ('Group = "&1" key="&2":&3',
      824                                         tt-cash-param-hist.param_group,
      825                                         tt-cash-param-hist.param_name,
      826                                         chr(10))
      827                                         else "") + vCurrContent ).
      828                                         end.
      829     end case.
      830   end procedure.
      831   procedure EndElement:
      832     define input parameter name_ as character.
      833     define input parameter localName as character.
      834     define input parameter qName as character.
      835     define buffer Cash-param-hist for Cash-param-hist.
      836     define buffer code for code.
      837     define variable ii as integer no-undo .
      838     if qname = "ErrorMessage" then do:
      839        mOk = false.
      840     end.
      841     else if qname = "Param" then do:
      842       do:
      843       tt-cash-param-hist.param_value = getValueConvert(tt-cash-param-hist.param_group, tt-cash-param-hist.param_name, tt-cash-param-hist.param_value).
      844       define variable vParantNotCaseSens as character no-undo.
      845       define variable vCodeNotCaseSens as character no-undo.
      846       vParantNotCaseSens = mParent +  chr(4) + tt-cash-param-hist.param_group.
      847       vCodeNotCaseSens   = tt-cash-param-hist.param_name.
      848       find first code where code.parent eq vParantNotCaseSens
      849                         and code.code   eq vCodeNotCaseSens
      850       no-lock no-error.
      851       if not available code
      852       then
      853          find first code where code.parent eq vParantNotCaseSens
      854                            and can-do(code.code, tt-cash-param-hist.param_name) no-lock no-error.
      855          if Mfirst
      856          then do:
      857             for each cash-param-hist where cash-param-hist.obj-type      = tt-cash-param-hist.obj-type
      858                                        and cash-param-hist.obj-code      = tt-cash-param-hist.obj-code
      859                                        and cash-param-hist.cash-num      = tt-cash-param-hist.cash-num
      860                                        and cash-param-hist.param_section = tt-cash-param-hist.param_section
      861             exclusive-lock:
      862                delete Cash-param-hist.
      863             end.
      864             Mfirst = false.
      865          end.
      866          find first cash-param-hist where cash-param-hist.obj-type      = tt-cash-param-hist.obj-type
      867                                       and cash-param-hist.obj-code      = tt-cash-param-hist.obj-code
      868                                       and cash-param-hist.cash-num      = tt-cash-param-hist.cash-num
      869                                       and cash-param-hist.param_section = tt-cash-param-hist.param_section
      870                                       and cash-param-hist.param_group   = tt-cash-param-hist.param_group
      871                                       and cash-param-hist.param_name    = if available code then code.code else tt-cash-param-hist.param_name
      872                                        no-error .
      873          buffer-copy tt-cash-param-hist except param_name to cash-param-hist
      874          assign
      875             cash-param-hist.param_name    = if available code then code.code else tt-cash-param-hist.param_name
      876           .
      877        end.
      878     end.
      879   end procedure.
      880   procedure EndDocument:
      881     if mOk eq ?
      882     then
      883        mOk = true.
      884   end procedure.
      885   procedure Warning:
      886     define input parameter ErrMessage as character no-undo.
      887     message "The following WARNING was generated:~n" + ErrMessage
      888          view-as alert-box info buttons ok.
      889   end procedure.
      890   procedure Error:
      891     define input parameter ErrMessage as character no-undo.
      892     message "The following NONFATAL ERROR was generated:~n" + ErrMessage
      893          view-as alert-box info buttons ok.
      894   end procedure.
      895   procedure FatalError:
      896     define input parameter ErrMessage as character no-undo.
      897     return error "The following FATAL ERROR was generated:~n" + ErrMessage.
      898   end procedure.
