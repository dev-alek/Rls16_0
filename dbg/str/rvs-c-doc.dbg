     1412   c-rvs-doc.state-am-qnty           at row 7 col 63    colon-aligned label "Сумма"            view-as text format "->,>>>,>>>,>>>.<<<"
     1413   c-rvs-doc.state-cf-qnty           at row 7 col 85.5  colon-aligned label "Наливы"           view-as text
     1414   b-mark              at row 8  col 1
     1415   b-lkp               at row 8  col 34
     1416   br-line      at row 9  col 1
