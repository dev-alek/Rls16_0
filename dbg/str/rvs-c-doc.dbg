      136   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      137   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      138   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      141      IF parundefine-var = ? THEN RETURN 0.00.
      142                             ELSE RETURN parundefine-var.
