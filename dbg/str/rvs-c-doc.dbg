      152   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure doc-code:
      154   define input  parameter parmode          as   character           no-undo.
      155   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      156   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      157   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      158   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      159   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      160   define variable vardb-remote     as   logical             no-undo.
      161   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      162   define variable v-delimiter as character no-undo .
      163   do
      164   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      165   :
      166   find first buf_sys-ctrl no-lock .
      167   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      168     CASE parmode:
      169       when "main":u then do:
      170         if vardb-remote then do:
      171           assign
      172             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      173         end.
      174         else do:
      175           assign
      176             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      177         end.
      178       end.
      179       when "trio" then do:
      180         assign
      181           pardoc-code = replace (parroot-doc-code, "=", "*").
      182       end.
      183       otherwise do:
      184         assign
      185         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      186         no-error
      187         .
      188         if error-status:error  then do:
      189           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      190                                         ,chr(10)
      191                                         ,parmode
      192                                         ).
      193         end.
      194         if num-entries(parmode) = 1
      195         and parmode <> "chip":U
      196         and parmode <> "chip_s":U
      197         then do:
      198           assign
      199           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      200         end.
      201         else if (lookup("chip":U, parmode) > 0
      202                  or
      203                  lookup("chip_s":U, parmode) > 0) then do:
      204           assign
      205             vartemp-doc-code = parroot-doc-code.
      206           do while true:
      207             if index (vartemp-doc-code , ".") = 0 then
      208               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      209             else
      210               vartemp-doc-code  =
      211               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      212               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      213               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      214             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      215           end.
      216           assign
      217             pardoc-code = vartemp-doc-code.
      218         end.
      219       end.
      220     end CASE.
      221     if pardoc-code = '':U
      222     or (parroot-doc-code <> '':U
      223     and pardoc-code = parroot-doc-code) then do:
      224       undo, return error substitute("Ошибка при генерации номера документа&1"
      225                                     ,chr(10)).
      226     end.
      227   end.
      228   end. // procedure/method
      229   function get-doc-code-int64 returns int64
      230     ( input p-doc-code as character ) :
      231     define variable v-ind              as integer   no-undo .
      232     define variable v-num-entries      as integer   no-undo .
      233     define variable v-doc-code-int64   as int64     no-undo .
      234     define variable v-canonic-doc-code as character no-undo .
      235     assign
      236       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      237       v-canonic-doc-code = p-doc-code
      238     .
      239     do v-ind = 1 to v-num-entries
      240     :
      241       assign
      242         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      243       .
      244     end.
      245     assign
      246       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      247     .
      248     return v-doc-code-int64 .
      249   end. // function/method
      250   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251     define variable v-cntxt-db-num        as integer   no-undo .
      252     define variable v-cntxt-userid        as character no-undo .
      253     define variable v-cntxt-level         as character no-undo .
      254     define variable v-cntxt-host-code-obj as integer   no-undo .
      255     define variable v-cntxt-obj-type      as character no-undo .
      256     define variable v-cntxt-obj-code      as integer   no-undo .
      257     define variable v-cntxt-db-num-obj    as integer   no-undo .
      258     define variable v-cntxt-is-admin      as logical   no-undo .
      259   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260     run mainmenu_getcntxt in parparentproc
      261       (output v-cntxt-db-num
      262       ,output v-cntxt-userid
      263       ,output v-cntxt-level
      264       ,output v-cntxt-host-code-obj
      265       ,output v-cntxt-obj-type
      266       ,output v-cntxt-obj-code
      267       ,output v-cntxt-db-num-obj
      268       ,output v-cntxt-is-admin
      269       ) .
      270     define new global shared variable g#lib-rvs as handle no-undo.
      271   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   define variable v-waitfram-action01         as character   no-undo .
      273   define variable v-waitfram-action02         as character   no-undo .
      274   define variable v-waitfram-action03         as character   no-undo .
      275   define variable mWaitFramTextBeg            as character   no-undo.
      276   define variable mWaitFramTextEnd            as character   no-undo.
      277   define variable mWaitFramView               as logical     no-undo.
      278   define variable mWaitProcEvent              as logical     no-undo init yes.
      279   define variable mWaitFramInterval           as integer     no-undo init 1 .
      280   define variable mWaitFramStop               as logical     no-undo.
      281   define variable mWaitFramStopUser           as logical     no-undo.
      282   define variable mWaitFramStopTimeOut        as logical     no-undo.
      283   define variable mWaitFramStartProc          as datetime-tz no-undo.
      284   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      285   define button B-WaitFramStop auto-end-key
      286        label "Стоп"
      287        size 10 by 1 tooltip "Остоновить процесс".
      288   define button B-viewProcInfo
      289        label "Информация"
      290        size 15 by 1 tooltip "Информация о процесс".
      291   define frame waitfram
      292     v-waitfram-action01 format "x(72)" no-label skip
      293     v-waitfram-action02 format "x(72)" no-label skip
      294     v-waitfram-action03 format "x(72)" no-label skip
      295     B-viewProcInfo
      296     B-WaitFramStop at row 4 col 30
      297     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      298     .
      299   define new global shared variable mBatchMode as logical no-undo init ?.
      300   define variable mFramBachModHandle as handle no-undo.
      301   mFramBachModHandle = frame waitfram:handle.
      302   define variable mFameOldVis as logical no-undo.
      303   define variable mVisCUrentVin as logical no-undo.
      304   if session:batch-mode
      305   then
      306      mBatchMode = yes.
      307   if mBatchMode = ? then do:
      308     mVisCUrentVin = current-window:visible.
      309     mFameOldVis = mFramBachModHandle:visible.
      310     mFramBachModHandle:visible  = yes.
      311     mBatchMode = mFramBachModHandle:visible ne yes.
      312     mFramBachModHandle:visible = mFameOldVis.
      313     current-window:visible = mVisCUrentVin.
      314   end.
      315    if  log-manager:logfile-name ne ?
      316     then DO:
      317         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      318         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      319         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      320     end.
      321   on choose of B-WaitFramStop in frame waitfram
      322   do:
      323     mWaitFramStop = yes.
      324     mWaitFramStopUser = yes.
      325   end.
      326   function waitfram-check-timeout returns logical():
      327      define variable vtime as int64 no-undo.
      328      if mWaitFramStopTimeOut
      329      then
      330         return yes.
      331      vtime = ( now - mWaitFramStartProc ) / 1000 .
      332      if     mWaitFramTimeOut ne ?
      333         and mWaitFramTimeOut ne 0
      334         and mWaitFramTimeOut lt vtime
      335      then do:
      336         mWaitFramStopTimeOut = yes.
      337      end.
      338      return mWaitFramStopTimeOut.
      339   end.
      340   procedure waitfram-hide :
      341     if not session:batch-mode
      342     then do
      343     on error undo, return error return-value
      344     :
      345       pause 0 before-hide .
      346       if not mBatchMode then
      347         hide frame waitfram .
      348     if     not mWaitFramView
      349        and mWaitProcEvent
      350     then
      351       process events .
      352     end.
      353   end procedure.
      354   procedure waitfram-show :
      355     define input  parameter p-message as character no-undo .
      356     define variable v-left-margin as integer   no-undo .
      357     if not session:batch-mode
      358     then do
      359     on error undo, return error return-value
      360     :
      361       if length(p-message) <= 70 then do:
      362         assign
      363           v-left-margin = integer((70 - length(p-message)) / 2)
      364         .
      365         assign
      366           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      367         .
      368         assign
      369           v-waitfram-action01 = " "
      370           v-waitfram-action02 = " "
      371                                    + fill(" ", v-left-margin)
      372                                    + p-message
      373           v-waitfram-action03 = " "
      374         .
      375       end.
      376       else do:
      377         define variable vRindex1 as integer no-undo.
      378         define variable vRindex2 as integer no-undo.
      379         vRindex1 = r-index(p-message," ",70).
      380         if vRindex1 = 0
      381         then
      382            vRindex1 = 70.
      383         if length(p-message)  <= vRindex1 + 70 then do:
      384           assign
      385             v-waitfram-action01 = " "
      386             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      387             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      388           .
      389         end.
      390         else do:
      391           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      392           if vRindex2 <= vRindex1
      393           then
      394              vRindex2 = vRindex1 + 70.
      395           assign
      396             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      397             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      398             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      399           .
      400         end.
      401       end.
      402       B-viewProcInfo:visible   in frame waitfram = no.
      403       B-viewProcInfo:sensitive in frame waitfram = no.
      404       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      405       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      406       if  (   mWaitFramView
      407          or  mWaitProcEvent)
      408          and not mBatchMode
      409       then
      410          display
      411             v-waitfram-action01 skip
      412             v-waitfram-action02 skip
      413             v-waitfram-action03 skip
      414          with frame waitfram .
      415       if     mWaitFramView
      416          then do:
      417             if     mWaitFramInterval ne ?
      418                and not mBatchMode
      419             then
      420                wait-for go of frame waitfram pause mWaitFramInterval.
      421          end.
      422          else
      423             if     mWaitProcEvent
      424                and not mBatchMode
      425             then
      426                process events .
      427     end.
      428   end procedure.
      429      procedure waitfram-show-this:
      430         define input  parameter iInterval as int64 no-undo.
      431         define variable vtime as int64 no-undo.
      432         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      433         mWaitFramInterval = iInterval.
      434         run waitfram-show (substitute("&1&2 &3&4" ,
      435                                       mWaitFramTextBeg ,
      436                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      437                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      438                                       mWaitFramTextEnd
      439                                      )
      440                           ).
      441      end.
      442      procedure WaitFramRunPause:
      443         define input  parameter iInterval as dec no-undo.
      444         define variable vStart  as datetime-tz no-undo.
      445         define variable vend    as datetime-tz no-undo.
      446         define variable vint as int64 no-undo.
      447         define variable vOk as logical no-undo.
      448         vStart = now.
      449         vend   = vStart.
      450         publish "WaitFramPause" (iInterval,output vOk).
      451         vend   =  now.
      452         vint = vend - vStart.
      453         vint = iInterval - vint / 1000.
      454         if     not mWaitFramStop
      455            and (   vint > 0
      456                 or (    not vOk
      457                     and iInterval eq ?
      458                     )
      459                 )
      460         then
      461            run waitfram-show-this (iInterval).
      462         vend   =  now.
      463         vint = vend - vStart.
      464         vint = iInterval - vint / 1000.
      465         if     not mWaitFramStop
      466            and vint > 0
      467         then do:
      468            run gbl/pause.p (vint * 1000).
      469         end.
      470         if iInterval ne ?
      471         then
      472            publish "WaitFramStop".
      473         waitfram-check-timeout().
      474      end.
      475      procedure WaitFramWaitFor:
      476         define input  parameter iInterval as dec no-undo.
      477         assign
      478            mWaitFramStartProc   = now
      479            mWaitFramStopUser    = no
      480            mWaitFramStopTimeOut = no
      481         .
      482         block-wait:
      483         do while not mWaitFramStop:
      484            run WaitFramRunPause (iInterval).
      485            if  waitfram-check-timeout()
      486            then do:
      487               leave block-wait.
      488            end.
      489         end.
      490         run waitfram-hide.
      491      end.
      492   procedure waitfram-join :
      493     define input  parameter p-line-1  as character no-undo .
      494     define input  parameter p-line-2  as character no-undo .
      495     define input  parameter p-line-3  as character no-undo .
      496     define output parameter p-message as character no-undo .
      497     do
      498     on error undo, return error return-value
      499     :
      500       assign
      501         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      502                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      503                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      504       .
      505     end.
      506   end procedure.
      507   function waitfram-join-function returns character
      508     (input p-line-1 as character
      509     ,input p-line-2 as character
      510     ,input p-line-3 as character
      511     ).
      512     define variable v-message as character no-undo .
      513     run waitfram-join in this-procedure
      514       (input  p-line-1
      515       ,input  p-line-2
      516       ,input  p-line-3
      517       ,output v-message
      518       ) .
      519     return v-message .
      520   end function .
