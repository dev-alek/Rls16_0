     1308   define variable del-list as character no-undo.
     1309   function get-mark return character (buffer local-rvs-line for ub.c-rvs-line ).
     1310      if lookup (string (recid (local-rvs-line)), del-list) > 0 then return "*".
     1311                                                                    else return "".
     1312   end function.
     1313   function deviation-fact    return decimal (buffer local-rvs-line for ub.c-rvs-line ).
     1314      return (local-rvs-line.state-measure-qnty   + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1315   end function.
     1316   function deviation-measure return decimal (buffer local-rvs-line for ub.c-rvs-line ).
     1317      return (local-rvs-line.measure-qnty + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1318   end function.
     1319   define query br-line      for ub.c-rvs-line, ub.goods, ub.place scrolling.
     1320   define query br-pump for ub.c-rvs-line-pump                scrolling.
     1321   define browse br-line query br-line no-lock display
     1322         get-mark (buffer ub.c-rvs-line)  column-label '*'  format "x(1)"
     1323         ub.goods.artic  column-label 'Артикул'
     1324         ub.goods.gds-name  column-label 'Название'  format "x(15)"
     1325         ub.c-rvs-line.pl-code  column-label 'Скл.место'
