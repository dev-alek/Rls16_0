     1421   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   DEF VAR cur-clmn-numbr-line as INT EXTENT 35 no-undo.
     1423   DEF VAR varmvibr-line       as INT no-undo.
     1424   DEF VAR varmvjbr-line       as INT no-undo.
     1425   DEF VAR varmvkbr-line       as INT no-undo.
     1426   DEF VAR varmvlbr-line       as INT no-undo.
     1427   DEF VAR move-elementbr-line as INT no-undo.
     1428   def var jjbr-line           as int no-undo.
     1429   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     1430     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     1431   END.
     1432   RUN start-mv-clmnbr-line.
     1433   PROCEDURE start-mv-clmnbr-line:
     1434   def var old-session as logical no-undo.
     1435      old-session = SESSION:IMMEDIATE-DISPLAY.
     1436      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1437      SESSION:IMMEDIATE-DISPLAY = old-session.
     1438   END.
     1439   ON ctrl-cursor-right OF BROWSE br-line do:
     1440     RUN re-move-clmnbr-line ( 6, 35).
     1441   END.
     1442   ON ctrl-cursor-left OF BROWSE br-line do:
     1443     RUN re-move-clmnbr-line (35, 6).
     1444   END.
     1445   PROCEDURE re-move-clmnbr-line:
     1446     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1447     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1448     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1449       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     1450     END.
     1451     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1452     if source-column > target-column THEN
     1453     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     1454       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1455           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1456             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     1457           END.
     1458       END.
     1459     END.
     1460     ELSE
     1461     DO varmvjbr-line = source-column + 1 to target-column:
     1462       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1463         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1464           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     1465         END.
     1466       END.
     1467     END.
     1468     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1469       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     1470     END.
     1471   END PROCEDURE.
     1472   PROCEDURE ch-clmnbr-line:
     1473     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1474     if cur-clmn-loc <= 6 then do:
     1475       return .
     1476     end.
     1477     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1478       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     1479     END.
     1480     RUN re-move-clmnbr-line (cur-clmn-loc, 6).
     1481   END PROCEDURE.
     1482   PROCEDURE mv-brw-defaultbr-line:
     1483   def var old-session as logical no-undo.
     1484     old-session = SESSION:IMMEDIATE-DISPLAY.
     1485     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1486     do varmvlbr-line = 6 to EXTENT(cur-clmn-numbr-line):
     1487       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     1488     END.
     1489     RUN start-mv-clmnbr-line.
     1490     SESSION:IMMEDIATE-DISPLAY = old-session.
     1491   END PROCEDURE.
     1492   .
     1493   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1494   DEF VAR cur-clmn-numbr-pump as INT EXTENT 18 no-undo.
     1495   DEF VAR varmvibr-pump       as INT no-undo.
     1496   DEF VAR varmvjbr-pump       as INT no-undo.
     1497   DEF VAR varmvkbr-pump       as INT no-undo.
     1498   DEF VAR varmvlbr-pump       as INT no-undo.
     1499   DEF VAR move-elementbr-pump as INT no-undo.
     1500   def var jjbr-pump           as int no-undo.
     1501   do varmvibr-pump = 1 to EXTENT(cur-clmn-numbr-pump):
     1502     ASSIGN cur-clmn-numbr-pump[varmvibr-pump] = varmvibr-pump.
     1503   END.
     1504   RUN start-mv-clmnbr-pump.
     1505   PROCEDURE start-mv-clmnbr-pump:
     1506   def var old-session as logical no-undo.
     1507      old-session = SESSION:IMMEDIATE-DISPLAY.
     1508      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1509      SESSION:IMMEDIATE-DISPLAY = old-session.
     1510   END.
     1511   ON ctrl-cursor-right OF BROWSE br-pump do:
     1512     RUN re-move-clmnbr-pump ( 3, 18).
     1513   END.
     1514   ON ctrl-cursor-left OF BROWSE br-pump do:
     1515     RUN re-move-clmnbr-pump (18, 3).
     1516   END.
     1517   PROCEDURE re-move-clmnbr-pump:
     1518     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1519     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1520     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1521       if cur-clmn-numbr-pump[varmvibr-pump] = source-column THEN cur-clmn-numbr-pump[varmvibr-pump] = -1.
     1522     END.
     1523     if br-pump:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1524     if source-column > target-column THEN
     1525     DO varmvjbr-pump = source-column - 1 to target-column BY -1:
     1526       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1527           if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1528             cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] + 1.
     1529           END.
     1530       END.
     1531     END.
     1532     ELSE
     1533     DO varmvjbr-pump = source-column + 1 to target-column:
     1534       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1535         if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1536           cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] - 1.
     1537         END.
     1538       END.
     1539     END.
     1540     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1541       if cur-clmn-numbr-pump[varmvibr-pump] = -1 THEN cur-clmn-numbr-pump[varmvibr-pump] = target-column.
     1542     END.
     1543   END PROCEDURE.
     1544   PROCEDURE ch-clmnbr-pump:
     1545     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1546     if cur-clmn-loc <= 3 then do:
     1547       return .
     1548     end.
     1549     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1550       if cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-loc THEN move-elementbr-pump = varmvibr-pump.
     1551     END.
     1552     RUN re-move-clmnbr-pump (cur-clmn-loc, 3).
     1553   END PROCEDURE.
     1554   PROCEDURE mv-brw-defaultbr-pump:
     1555   def var old-session as logical no-undo.
     1556     old-session = SESSION:IMMEDIATE-DISPLAY.
     1557     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1558     do varmvlbr-pump = 3 to EXTENT(cur-clmn-numbr-pump):
     1559       RUN re-move-clmnbr-pump (cur-clmn-numbr-pump[varmvlbr-pump], varmvlbr-pump).
     1560     END.
     1561     RUN start-mv-clmnbr-pump.
     1562     SESSION:IMMEDIATE-DISPLAY = old-session.
     1563   END PROCEDURE.
     1564   .
     1565   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   on F9 of frame d-rvs anywhere do:
     1567     if not available ub.goods then
     1568       return no-apply.
     1569     gds-rec = recid (ub.goods).
     1570     run ref/gds-form.w ( input parparentproc
     1571                         ,input 'ПРОСМОТР':U
     1572                         ,input ?
     1573                         ,input ?
     1574                         ,input ?
     1575                         ,input-output gds-rec).
     1576     apply "entry" to br-line in frame d-rvs.
     1577     return no-apply.
     1578   end.
     1579   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1580   on F3 of frame d-rvs anywhere do:
     1581     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-rvs. END.
     1582     return no-apply.
     1583   end.
     1584   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1585   on INS of frame d-rvs anywhere do:
     1586     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-rvs. END.
     1587     return no-apply.
     1588   end.
     1589   on end-error, stop of frame d-rvs do:
     1590     apply "choose" to b-exit in frame d-rvs.
     1591     return no-apply.
     1592   end.
     1593   ON WINDOW-CLOSE OF FRAME d-rvs
     1594   DO:
     1595     p-next-prev = "QUIT".
     1596     APPLY "END-ERROR":U TO SELF.
     1597   END.
     1598   on choose of b-notes in frame d-rvs
     1599   do:
     1600     assign notes = c-rvs-doc.ps.
     1601     run gbl/notes.w ( input pardoc-mode, input-output notes ).
     1602     if c-rvs-doc.ps <> notes then do:
     1603       do on stop undo, return no-apply :
     1604         find c-rvs-doc exclusive-lock where recid (c-rvs-doc) = parrvs-rec.
     1605         assign c-rvs-doc.ps = notes.
     1606       end.
     1607     end.
     1608   end.
     1609   on choose of b-history in frame d-rvs
     1610   do:
     1611     define variable v-list as character no-undo.
     1612     if available c-rvs-doc then do:
     1613       run str/rvscdocs.w ( input        parparentproc,
     1614                        input        "":U,
     1615                        input        "one":U,
     1616                        input        c-rvs-doc.rvs-code,
     1617                        input-output v-list                  ).
     1618     end.
     1619   end.
     1620   on choose of b-exit in frame d-rvs
     1621   do:
     1622       p-next-prev = "QUIT".
     1623   end.
     1624   on mouse-select-dblclick, return of c-rvs-doc.agnt in frame d-rvs
     1625   do:
     1626     run local-psn-chk in this-procedure ( input "agnt", input "ret-mouse" ).
     1627     apply "entry" to c-rvs-doc.boss in frame d-rvs.
     1628     return no-apply.
     1629   end.
     1630   on mouse-select-dblclick, return of c-rvs-doc.boss in frame d-rvs
     1631   do:
     1632     run local-psn-chk in this-procedure ( input "boss", input "ret-mouse" ).
     1633     apply "entry" to b-exit in frame d-rvs.
     1634     return no-apply.
     1635   end.
     1636   on mouse-select-dblclick, return of c-rvs-doc.wrkr in frame d-rvs
     1637   do:
     1638     run local-psn-chk in this-procedure ( input "wrkr", input "ret-mouse" ).
     1639     apply "entry" to c-rvs-doc.agnt in frame d-rvs.
     1640     return no-apply.
     1641   end.
     1642   ON CHOOSE OF B-next IN FRAME d-rvs
     1643   DO:
     1644        run reposition-c-rvs-doc in this-procedure
     1645     (input 'next':U
     1646     ) no-error .
     1647     if error-status:error then return no-apply.
     1648   END.
     1649   ON CHOOSE OF B-prev IN FRAME d-rvs
     1650   DO:
     1651      run reposition-c-rvs-doc in this-procedure
     1652     (input 'prev':U
     1653     ) no-error .
     1654   if error-status:error then return no-apply.
     1655   END.
     1656   on choose of r-agnt in frame d-rvs
     1657   do:
     1658     run local-psn-chk in this-procedure ( input "agnt", input "button" ).
     1659     apply "entry" to c-rvs-doc.boss in frame d-rvs.
     1660     return no-apply.
     1661   end.
     1662   on choose of r-boss in frame d-rvs
     1663   do:
     1664      run local-psn-chk in this-procedure ( input "boss", input "button" ).
     1665     apply "entry" to b-exit in frame d-rvs.
     1666     return no-apply.
     1667   end.
     1668   on choose of r-wrkr in frame d-rvs
     1669   do:
     1670     run local-psn-chk in this-procedure ( input "wrkr", input "button" ).
     1671     apply "entry" to c-rvs-doc.agnt in frame d-rvs.
     1672     return no-apply.
     1673   end.
     1674   on leave of c-rvs-doc.agnt in frame d-rvs
     1675   do:
     1676      run local-psn-chk in this-procedure ( input "agnt", input "leave" ).
     1677   end.
     1678   on leave of c-rvs-doc.boss in frame d-rvs
     1679   do:
     1680      run local-psn-chk in this-procedure ( input "boss", input "leave" ).
     1681   end.
     1682   on leave of c-rvs-doc.wrkr in frame d-rvs
     1683   do:
     1684      run local-psn-chk in this-procedure ( input "wrkr", input "leave" ).
     1685   end.
     1686   on choose of b-mark in frame d-rvs do:
     1687     run local-mark in this-procedure.
     1688     varlog = br-line:select-next-row ().
     1689     apply "entry" to br-line in frame d-rvs.
     1690   end.
     1691   on choose of b-lkp-pump in frame d-rvs
     1692   do:
     1693     run proc-lookup in this-procedure no-error.
     1694     if error-status :error then do: return no-apply. end.
     1695   end.
     1696   on choose of b-lkp in frame d-rvs
     1697   do:
     1698     run proc-lkp in this-procedure no-error.
     1699     if error-status :error then do: return no-apply. end.
     1700   end.
     1701   def var sort-labelbr-line   as character no-undo .
     1702   def var sort-clmnbr-line    as handle    no-undo .
     1703   def var cur-clmnbr-line     as handle    no-undo .
     1704   def var cur-clmn-locbr-line as integer   no-undo .
     1705   def var re-querybr-line     as logical   initial no no-undo .
     1706   on start-search, ctrl-o of br-line in frame d-rvs do:
     1707      run sort-brbr-line
     1708        (input (if available ub.c-rvs-line
     1709                then recid(ub.c-rvs-line)
     1710                else ?
     1711               )
     1712        ).
     1713   end.
     1714   PROCEDURE sort-brbr-line :
     1715     define input parameter p-recid as recid no-undo .
     1716     if re-querybr-line = no then do:
     1717       assign
     1718          cur-clmnbr-line = br-line:current-column in frame d-rvs
     1719       .
     1720       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     1721       if cur-clmnbr-line = sort-clmnbr-line then do:
     1722         assign
     1723            sort-labelbr-line = ""
     1724            sort-clmnbr-line = ?
     1725         .
     1726        end.
     1727        else do:
     1728          assign
     1729            sort-labelbr-line = cur-clmnbr-line:label
     1730            sort-clmnbr-line  = cur-clmnbr-line
     1731            sort-clmnbr-line:column-fgcolor = 4
     1732          .
     1733        end.
     1734      end.
     1735     assign
     1736       cur-clmn-locbr-line = 1
     1737     .
     1738     def var column-handle as handle no-undo .
     1739     column-handle = br-line:first-column.
     1740     do while valid-handle(column-handle) :
     1741       if column-handle = cur-clmnbr-line then do:
     1742         leave .
     1743       end.
     1744       column-handle = column-handle:NEXT-COLUMN.
     1745       assign
     1746         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     1747       .
     1748     end.
     1749     case sort-labelbr-line:
     1750           when '*'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by get-mark (buffer ub.c-rvs-line) .   . END.
     1751           when 'Артикул'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.goods.artic .   . END.
     1752           when 'Название'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.goods.gds-name .   . END.
     1753           when 'Скл.место'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.pl-code .   . END.
     1754           when 'Номер резервуара'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by place.loc1 .   . END.
     1755           when 'Факт остаток'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-measure-qnty .   . END.
     1756           when 'Измер. остаток'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.measure-qnty .   . END.
     1757           when 'Учет'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.system-qnty .   . END.
     1758           when 'Первонач.учет'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.orig-system-qnty .   . END.
     1759           when 'Факт в!трубопроводе'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-add-qnty .   . END.
     1760           when 'Отклонение(факт)'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by deviation-fact(buffer ub.c-rvs-line) .   . END.
     1761           when 'Отклонение(измер)'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by deviation-measure(buffer ub.c-rvs-line) .   . END.
     1762           when 'Допустимое!отклонение'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.tolerance .   . END.
     1763           when 'Факт брутто'  then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-brutto-qnty .   . END.
     1764           when ub.c-rvs-line.brutto-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.brutto-qnty .   . END.
     1765           when ub.c-rvs-line.state-density:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-density .   . END.
     1766           when ub.c-rvs-line.density:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.density .   . END.
     1767           when ub.c-rvs-line.state-measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-measure-cli-qnty .   . END.
     1768           when ub.c-rvs-line.measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.measure-cli-qnty .   . END.
     1769           when ub.c-rvs-line.system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.system-cli-qnty .   . END.
     1770           when ub.c-rvs-line.orig-system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.orig-system-cli-qnty .   . END.
     1771           when ub.c-rvs-line.state-brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-brutto-cli-qnty .   . END.
     1772           when ub.c-rvs-line.brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.brutto-cli-qnty .   . END.
     1773           when ub.c-rvs-line.state-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-mh-qnty .   . END.
     1774           when ub.c-rvs-line.meas-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.meas-mh-qnty .   . END.
     1775           when ub.c-rvs-line.state-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-am-qnty .   . END.
     1776           when ub.c-rvs-line.meas-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.meas-am-qnty .   . END.
     1777           when ub.c-rvs-line.state-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-cf-qnty .   . END.
     1778           when ub.c-rvs-line.meas-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.meas-cf-qnty .   . END.
     1779           when ub.c-rvs-line.state-level-total:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-level-total .   . END.
     1780           when ub.c-rvs-line.level-total:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.level-total .   . END.
     1781           when ub.c-rvs-line.state-level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-level-petrol .   . END.
     1782           when ub.c-rvs-line.level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.level-petrol .   . END.
     1783           when ub.c-rvs-line.state-level-water:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-level-water .   . END.
     1784           when ub.c-rvs-line.level-water:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.level-water .   . END.
     1785           when ub.c-rvs-line.state-temperature:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.state-temperature .   . END.
     1786           when ub.c-rvs-line.temperature:label in browse br-line then DO:   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.c-rvs-line.temperature .   . END.
     1787       otherwise do:
     1788         open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     1789           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     1790             run mv-brw-defaultbr-line.
     1791           end.
     1792         if sort-labelbr-line <> "" then do:
     1793           assign
     1794             cur-clmnbr-line:column-fgcolor = 0
     1795           .
     1796         end.
     1797         assign
     1798           cur-clmn-locbr-line = ?
     1799         .
     1800       end.
     1801     end case.
     1802       if cur-clmn-locbr-line <> ? then do:
     1803         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     1804           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     1805         end.
     1806       end.
     1807     if p-recid <> ? then do:
     1808       reposition br-line to recid p-recid no-error.
     1809       apply "value-changed" to br-line in frame d-rvs.
     1810     end.
     1811     apply "entry" to br-line in frame d-rvs.
     1812   END PROCEDURE.
     1813   procedure re-open-query-srt-clmnbr-line:
     1814   if cur-clmnbr-line = ? then do:
     1815      open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     1816   end.
     1817   else do:
     1818      assign re-querybr-line = yes.
     1819      run sort-brbr-line
     1820        (input (if available ub.c-rvs-line
     1821                then recid(ub.c-rvs-line)
     1822                else ?
     1823               )
     1824        ).
     1825      assign re-querybr-line = no.
     1826   end.
     1827   end.
     1828   def var sort-labelbr-pump   as character no-undo .
     1829   def var sort-clmnbr-pump    as handle    no-undo .
     1830   def var cur-clmnbr-pump     as handle    no-undo .
     1831   def var cur-clmn-locbr-pump as integer   no-undo .
     1832   def var re-querybr-pump     as logical   initial no no-undo .
     1833   on start-search, ctrl-o of br-pump in frame d-rvs do:
     1834      run sort-brbr-pump
     1835        (input (if available ub.c-rvs-line-pump
     1836                then recid(ub.c-rvs-line-pump)
     1837                else ?
     1838               )
     1839        ).
     1840   end.
     1841   PROCEDURE sort-brbr-pump :
     1842     define input parameter p-recid as recid no-undo .
     1843     if re-querybr-pump = no then do:
     1844       assign
     1845          cur-clmnbr-pump = br-pump:current-column in frame d-rvs
     1846       .
     1847       if sort-clmnbr-pump <> ? then sort-clmnbr-pump:column-fgcolor = 0.
     1848       if cur-clmnbr-pump = sort-clmnbr-pump then do:
     1849         assign
     1850            sort-labelbr-pump = ""
     1851            sort-clmnbr-pump = ?
     1852         .
     1853        end.
     1854        else do:
     1855          assign
     1856            sort-labelbr-pump = cur-clmnbr-pump:label
     1857            sort-clmnbr-pump  = cur-clmnbr-pump
     1858            sort-clmnbr-pump:column-fgcolor = 4
     1859          .
     1860        end.
     1861      end.
     1862     assign
     1863       cur-clmn-locbr-pump = 1
     1864     .
     1865     def var column-handle as handle no-undo .
     1866     column-handle = br-pump:first-column.
     1867     do while valid-handle(column-handle) :
     1868       if column-handle = cur-clmnbr-pump then do:
     1869         leave .
     1870       end.
     1871       column-handle = column-handle:NEXT-COLUMN.
     1872       assign
     1873         cur-clmn-locbr-pump = cur-clmn-locbr-pump + 1
     1874       .
     1875     end.
     1876     case sort-labelbr-pump:
     1877           when 'ТРК'  then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.pump-code .   . END.
     1878           when 'П'  then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.nozzle-code .   . END.
     1879           when ub.c-rvs-line-pump.state-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-mh-qnty .   . END.
     1880           when ub.c-rvs-line-pump.meas-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-mh-qnty .   . END.
     1881           when ub.c-rvs-line-pump.state-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-am-qnty .   . END.
     1882           when ub.c-rvs-line-pump.meas-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-am-qnty .   . END.
     1883           when ub.c-rvs-line-pump.state-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-cf-qnty .   . END.
     1884           when ub.c-rvs-line-pump.meas-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-cf-qnty .   . END.
     1885           when ub.c-rvs-line-pump.state-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-mh-cnt .   . END.
     1886           when ub.c-rvs-line-pump.meas-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-mh-cnt .   . END.
     1887           when ub.c-rvs-line-pump.state-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-el-cnt .   . END.
     1888           when ub.c-rvs-line-pump.meas-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-el-cnt .   . END.
     1889           when ub.c-rvs-line-pump.state-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-am-cnt .   . END.
     1890           when ub.c-rvs-line-pump.meas-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-am-cnt .   . END.
     1891           when ub.c-rvs-line-pump.state-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.state-cf-cnt .   . END.
     1892           when ub.c-rvs-line-pump.meas-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.meas-cf-cnt .   . END.
     1893           when ub.c-rvs-line-pump.icnt-code:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.icnt-code .   . END.
     1894           when ub.c-rvs-line-pump.rvs-prev-code:label in browse br-pump then DO:   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num by ub.c-rvs-line-pump.rvs-prev-code .   . END.
     1895       otherwise do:
     1896         open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num.
     1897           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pump') then do:
     1898             run mv-brw-defaultbr-pump.
     1899           end.
     1900         if sort-labelbr-pump <> "" then do:
     1901           assign
     1902             cur-clmnbr-pump:column-fgcolor = 0
     1903           .
     1904         end.
     1905         assign
     1906           cur-clmn-locbr-pump = ?
     1907         .
     1908       end.
     1909     end case.
     1910       if cur-clmn-locbr-pump <> ? then do:
     1911         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pump') then do:
     1912           run ch-clmnbr-pump in this-procedure (cur-clmn-locbr-pump).
     1913         end.
     1914       end.
     1915     if p-recid <> ? then do:
     1916       reposition br-pump to recid p-recid no-error.
     1917       apply "value-changed" to br-pump in frame d-rvs.
     1918     end.
     1919     apply "entry" to br-pump in frame d-rvs.
     1920   END PROCEDURE.
     1921   procedure re-open-query-srt-clmnbr-pump:
     1922   if cur-clmnbr-pump = ? then do:
     1923      open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num.
     1924   end.
     1925   else do:
     1926      assign re-querybr-pump = yes.
     1927      run sort-brbr-pump
     1928        (input (if available ub.c-rvs-line-pump
     1929                then recid(ub.c-rvs-line-pump)
     1930                else ?
     1931               )
     1932        ).
     1933      assign re-querybr-pump = no.
     1934   end.
     1935   end.
     1936   on value-changed of br-line in frame d-rvs do:
     1937     if available ub.c-rvs-line then do:
     1938       run re-open-query-srt-clmnbr-pump in this-procedure.
     1939     end.
     1940   end.
     1941   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-rvs:PARENT eq ?
     1942   THEN FRAME d-rvs:PARENT = ACTIVE-WINDOW.
     1943   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1944   on help of frame d-rvs
     1945   do:
     1946     run gbl/app_help.p
     1947       (input this-procedure :file-name
     1948       ,input ''
     1949       ,input ?
     1950       ) no-error.
     1951     if error-status :error then do:
     1952       message
     1953         "Ошибка при вызове помощи"
     1954         error-status :get-message(1)
     1955         view-as alert-box .
     1956     end.
     1957   end.
     1958   run minbtn-set in this-procedure .
     1959   on choose of b-help in frame d-rvs
     1960   do:
     1961     apply "help":u to frame d-rvs .
     1962   end.
     1963   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   procedure minbtn-set :
     1965       do
     1966           on error undo, return error return-value
     1967           :
     1968           define variable ii              as integer       no-undo .
     1969           define variable fh              as widget-handle no-undo .
     1970           define variable hh              as widget-handle no-undo .
     1971           define variable v-h             as handle        extent 4 no-undo .
     1972           define variable v-name-button   as character     no-undo .
     1973           define variable v-help-old-x    as decimal       no-undo .
     1974           define variable v-help-old-y    as decimal       no-undo .
     1975           define variable v-help-old-size as decimal       no-undo .
     1976           define variable v-frame-width   as decimal       no-undo .
     1977           define variable jj              as integer       no-undo .
     1978           do
     1979               on error undo, return error
     1980               :
     1981               assign
     1982                   v-frame-width = frame d-rvs:width - 0.3
     1983                   fh            = frame d-rvs:first-child
     1984                   hh            = fh:first-child
     1985                   ii            = 1
     1986                   .
     1987               do while valid-handle(hh):
     1988                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1989                   do:
     1990                       case lc(hh:name) :
     1991                           when "b-help" then
     1992                               do:
     1993                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1994                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1995                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1996                                   hh:TOOLTIP = "Помощь" .
     1997                                   v-help-old-x = hh:column .
     1998                                   v-help-old-y = hh:row    .
     1999                                   v-help-old-size = hh:width .
     2000                                   hh:width-chars = 2.5 .
     2001                               end.
     2002                           when "b-print" then
     2003                               do:
     2004                                   hh:load-image("cmp/b-print.bmp":u) .
     2005                                   hh:TOOLTIP = "Печать" .
     2006                                   v-h[ii] = hh:handle .
     2007                                   ii = ii + 1 .
     2008                                   hh:width-chars = 3 .
     2009                               end.
     2010                           when "b-history" or
     2011                           when "b-hist" then
     2012                               do:
     2013                                   hh:load-image("cmp/b-hist.bmp":u) .
     2014                                   hh:TOOLTIP = "История" .
     2015                                   v-h[ii] = hh:handle .
     2016                                   ii = ii + 1 .
     2017                                   hh:width-chars = 3 .
     2018                               end.
     2019                           when "b-sch" then
     2020                               do:
     2021                                   hh:load-image("cmp/b-sch.bmp":u) .
     2022                                   hh:TOOLTIP = "Установка Фильтра" .
     2023                                   v-h[ii] = hh:handle .
     2024                                   ii = ii + 1 .
     2025                                   hh:width-chars = 3 .
     2026                               end.
     2027                           when "b-hist-user" then
     2028                               do:
     2029                                   hh:load-image("cmp/b-hist.bmp":u) .
     2030                                   hh:TOOLTIP = "История пользователя" .
     2031                                   ii = ii + 1 .
     2032                               end.
     2033                       end case.
     2034                   end.
     2035                   hh = hh:next-sibling.
     2036               end.
     2037               b-help:column = v-frame-width - b-help:width-chars.
     2038               jj = 0.
     2039               repeat ii = 4 to 1 by -1 :
     2040                   if valid-handle (v-h[ii] ) then
     2041                   do:
     2042                       jj  = jj + 1 .
     2043                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2044                       v-h[ii]:row    = v-help-old-y .
     2045                   end.
     2046               end.
     2047           end.
     2048       end.
     2049   end procedure.
     2050   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2051   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2052   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2053   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2054   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2055   define variable v-diasize-current-frame-height as decimal   no-undo .
     2056   define variable v-diasize-change-size          as logical   no-undo .
     2057   define variable v-diasize-resize-button        as handle    no-undo .
     2058   define variable v-diasize-wndmax               as logical   no-undo .
     2059   define variable v-diasize-wndstore             as logical   no-undo .
     2060   define variable v-diasize-proc-name            as character no-undo .
     2061   define variable v-diasize-browse-handle        as handle    no-undo .
     2062   define variable v-diasize-browse-number        as integer   no-undo .
     2063   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2064   define temp-table temp-diasize-handle no-undo
     2065     field handle-value  as handle
     2066     field save-position as decimal
     2067     index xpk is primary unique handle-value
     2068     .
     2069   define temp-table temp-browse-handle no-undo
     2070     field browse-type   as character
     2071     field browse-number as integer
     2072     field browse-handle as handle
     2073     field original-size as decimal
     2074     index xpk is primary unique browse-type browse-number
     2075     index xie browse-type browse-handle
     2076   .
     2077   procedure diasize_change-height :
     2078     define input  parameter p-change-value  as decimal   no-undo .
     2079     define input  parameter p-move-resize   as logical   no-undo .
     2080     define variable v-field-group-handle    as handle    no-undo .
     2081     define variable v-object-handle         as handle    no-undo .
     2082     define variable v-frame-height          as decimal   no-undo .
     2083     define variable v-frame-virtual-height  as decimal   no-undo .
     2084     define variable v-browse-height         as decimal   no-undo .
     2085     define variable v-window-height         as decimal   no-undo .
     2086     define variable v-window-virtual-height as decimal   no-undo .
     2087     define variable v-change-sign           as integer   no-undo .
     2088     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2089     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2090     if p-change-value > 0
     2091     then do:
     2092       if frame d-rvs :height + p-change-value
     2093           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2094       then do:
     2095         assign
     2096           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2097                           - (frame d-rvs :height-chars)
     2098         .
     2099         if p-change-value <= 0
     2100         then do:
     2101           run diasize_position-resize-button in this-procedure .
     2102           return .
     2103         end.
     2104       end.
     2105     end.
     2106     if p-change-value < 0
     2107     then do:
     2108       if frame d-rvs :height + p-change-value < v-diasize-orig-frame-height
     2109       then do:
     2110         assign
     2111           p-change-value = v-diasize-orig-frame-height
     2112                          - (frame d-rvs :height-chars)
     2113         .
     2114         if p-change-value >= 0
     2115         then do:
     2116           run diasize_position-resize-button in this-procedure .
     2117           return .
     2118         end.
     2119       end.
     2120     end.
     2121     if p-change-value >= 0
     2122     then do:
     2123       assign
     2124         v-change-sign = 1
     2125       .
     2126     end.
     2127     else do:
     2128       assign
     2129         v-change-sign = -1
     2130       .
     2131     end.
     2132     assign
     2133       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2134     .
     2135     if p-change-value = 0
     2136     then do:
     2137       run diasize_position-resize-button in this-procedure .
     2138       return .
     2139     end.
     2140     move_block:
     2141     do
     2142     on error undo move_block, retry move_block
     2143     :
     2144       if retry
     2145       then do:
     2146         do
     2147         on error undo move_block, leave move_block
     2148         :
     2149           if p-change-value > 0
     2150           then do:
     2151             for each buf_temp-diasize-handle
     2152             on error undo, next
     2153             :
     2154               assign
     2155                 v-object-handle = buf_temp-diasize-handle.handle-value
     2156               .
     2157               if v-object-handle <> v-diasize-resize-button
     2158               then do:
     2159                 assign
     2160                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2161                 .
     2162               end.
     2163             end.
     2164             assign
     2165               v-diasize-browse-handle :height = v-browse-height
     2166             .
     2167             for each buf_temp-browse-handle
     2168               where buf_temp-browse-handle.browse-type = 'height':u
     2169             on error undo, next
     2170             :
     2171               assign
     2172                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2173               .
     2174             end.
     2175             assign
     2176               frame d-rvs :height = v-frame-height
     2177             .
     2178             if frame d-rvs :scrollable = true
     2179             then do:
     2180               assign
     2181                 frame d-rvs :virtual-height = v-frame-virtual-height
     2182               .
     2183             end.
     2184             run diasize_position-resize-button in this-procedure .
     2185           end.
     2186           else do:
     2187             if frame d-rvs :scrollable = true
     2188             then do:
     2189               assign
     2190                 frame d-rvs :virtual-height = v-frame-virtual-height
     2191               .
     2192             end.
     2193             assign
     2194               frame d-rvs :height = v-frame-height
     2195             .
     2196             assign
     2197               v-diasize-browse-handle :height = v-browse-height
     2198             .
     2199             for each buf_temp-browse-handle
     2200               where buf_temp-browse-handle.browse-type = 'height':u
     2201             on error undo, next
     2202             :
     2203               assign
     2204                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2205               .
     2206             end.
     2207             for each buf_temp-diasize-handle
     2208             on error undo, next
     2209             :
     2210               assign
     2211                 v-object-handle = buf_temp-diasize-handle.handle-value
     2212               .
     2213               if v-object-handle <> v-diasize-resize-button
     2214               then do:
     2215                 assign
     2216                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2217                 .
     2218               end.
     2219             end.
     2220             run diasize_position-resize-button in this-procedure .
     2221           end.
     2222           assign
     2223             v-diasize-change-size = false
     2224           .
     2225           leave move_block .
     2226         end.
     2227       end.
     2228       assign
     2229         v-diasize-need-full-display = true
     2230       .
     2231       if v-diasize-change-size = false
     2232       then do:
     2233         assign
     2234           v-diasize-change-size = true
     2235         .
     2236       end.
     2237       else do:
     2238         return .
     2239       end.
     2240       assign
     2241         v-frame-height = frame d-rvs :height
     2242         v-frame-virtual-height = frame d-rvs :virtual-height
     2243         v-browse-height = v-diasize-browse-handle :height
     2244       .
     2245       for each buf_temp-browse-handle
     2246         where buf_temp-browse-handle.browse-type = 'height':u
     2247       :
     2248         assign
     2249           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2250         .
     2251       end.
     2252       for each buf_temp-diasize-handle
     2253       :
     2254         delete buf_temp-diasize-handle .
     2255       end.
     2256       assign
     2257         v-field-group-handle = frame d-rvs :first-child
     2258       .
     2259       do while valid-handle(v-field-group-handle)
     2260       :
     2261         assign
     2262           v-object-handle = v-field-group-handle :first-child
     2263         .
     2264         do while valid-handle(v-object-handle)
     2265         :
     2266           if  v-object-handle <> v-diasize-browse-handle :handle
     2267           and can-query(v-object-handle, "row")
     2268           and can-query(v-object-handle, "height")
     2269           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2270           then do:
     2271             find first buf_temp-browse-handle
     2272               where buf_temp-browse-handle.browse-type   = 'height':u
     2273                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2274               no-error .
     2275             if available buf_temp-browse-handle
     2276             then do:
     2277             end.
     2278             else do:
     2279               create buf_temp-diasize-handle .
     2280               assign
     2281                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2282                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2283               .
     2284             end.
     2285           end.
     2286           assign
     2287             v-object-handle = v-object-handle :next-sibling
     2288           .
     2289         end.
     2290         assign
     2291           v-field-group-handle = v-field-group-handle :next-sibling
     2292         .
     2293       end.
     2294       do with frame d-rvs
     2295       :
     2296         hide v-diasize-resize-button .
     2297         assign
     2298           v-diasize-resize-button :row    = 1
     2299           v-diasize-resize-button :column = 1
     2300         .
     2301       end.
     2302       if p-change-value > 0
     2303       then do:
     2304         if frame d-rvs :scrollable = true
     2305         then do:
     2306           assign
     2307             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     2308             no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block .
     2313           end.
     2314         end.
     2315         assign
     2316           frame d-rvs :height = frame d-rvs :height + p-change-value
     2317           no-error .
     2318         if error-status :error
     2319         or error-status :get-message(1) <> ""
     2320         then do:
     2321           undo move_block, retry move_block .
     2322         end.
     2323         assign
     2324           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2325           no-error .
     2326         if error-status :error
     2327         or error-status :get-message(1) <> ""
     2328         then do:
     2329           undo move_block, retry move_block .
     2330         end.
     2331         for each buf_temp-browse-handle
     2332           where buf_temp-browse-handle.browse-type = 'height':u
     2333         on error undo move_block, retry move_block
     2334         :
     2335           assign
     2336             buf_temp-browse-handle.browse-handle :height
     2337               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2338             no-error .
     2339           if error-status :error
     2340           or error-status :get-message(1) <> ""
     2341           then do:
     2342             undo move_block, retry move_block .
     2343           end.
     2344         end.
     2345         for each buf_temp-diasize-handle
     2346         on error undo move_block, retry move_block
     2347         :
     2348           assign
     2349             v-object-handle = buf_temp-diasize-handle.handle-value
     2350           .
     2351           if v-object-handle <> v-diasize-resize-button
     2352           then do:
     2353             assign
     2354               v-object-handle :row = v-object-handle :row + p-change-value
     2355               no-error .
     2356             if error-status :error
     2357             or error-status :get-message(1) <> ""
     2358             then do:
     2359               undo move_block, retry move_block .
     2360             end.
     2361           end.
     2362         end.
     2363       end.
     2364       else do:
     2365         for each buf_temp-diasize-handle
     2366         on error undo move_block, retry move_block
     2367         :
     2368           assign
     2369             v-object-handle = buf_temp-diasize-handle.handle-value
     2370           .
     2371           if v-object-handle <> v-diasize-resize-button
     2372           then do:
     2373             assign
     2374               v-object-handle :row = v-object-handle :row + p-change-value
     2375               no-error .
     2376             if error-status :error
     2377             or error-status :get-message(1) <> ""
     2378             then do:
     2379               undo move_block, retry move_block .
     2380             end.
     2381           end.
     2382         end.
     2383         assign
     2384           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2385           no-error .
     2386         if error-status :error
     2387         or error-status :get-message(1) <> ""
     2388         then do:
     2389           undo move_block, retry move_block .
     2390         end.
     2391         for each buf_temp-browse-handle
     2392           where buf_temp-browse-handle.browse-type = 'height':u
     2393         on error undo move_block, retry move_block
     2394         :
     2395           assign
     2396             buf_temp-browse-handle.browse-handle :height
     2397               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2398             no-error .
     2399           if error-status :error
     2400           or error-status :get-message(1) <> ""
     2401           then do:
     2402             undo move_block, retry move_block .
     2403           end.
     2404         end.
     2405         assign
     2406           frame d-rvs :height = frame d-rvs :height + p-change-value
     2407           no-error .
     2408         if error-status :error
     2409         or error-status :get-message(1) <> ""
     2410         then do:
     2411           undo move_block, retry move_block .
     2412         end.
     2413         if frame d-rvs :scrollable = true
     2414         then do:
     2415           assign
     2416             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     2417             no-error .
     2418           if error-status :error
     2419           or error-status :get-message(1) <> ""
     2420           then do:
     2421             undo move_block, retry move_block .
     2422           end.
     2423         end.
     2424       end.
     2425       if p-move-resize = true
     2426       then do:
     2427         run diasize_position-resize-button in this-procedure .
     2428       end.
     2429       if v-diasize-wndstore = true
     2430       then do:
     2431         if connected("ub") = true
     2432         then do:
     2433           define variable v-cntxt-db-num        as integer   no-undo .
     2434           define variable v-cntxt-userid        as character no-undo .
     2435           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2436                                             , OUTPUT v-cntxt-userid
     2437                                             ) .
     2438           run gbl/wndsizew.p
     2439             (input  v-cntxt-db-num
     2440             ,input  v-cntxt-userid
     2441             ,input  v-diasize-proc-name
     2442             ,input  'height':u
     2443             ,input  string(frame d-rvs :height - v-diasize-orig-frame-height)
     2444             ) .
     2445         end.
     2446       end.
     2447     end.
     2448     assign
     2449       v-diasize-change-size = false
     2450     .
     2451   end procedure.
     2452   procedure diasize_set-height :
     2453     define input  parameter p-new-height  as decimal   no-undo .
     2454     define input  parameter p-move-resize as logical   no-undo .
     2455     do
     2456     on error undo, return error return-value
     2457     :
     2458       run diasize_change-height in this-procedure
     2459         (input  (p-new-height - frame d-rvs :height)
     2460         ,input  p-move-resize
     2461         ) .
     2462     end.
     2463   end procedure.
     2464   procedure diasize_change-width :
     2465     define input  parameter p-change-value as decimal   no-undo .
     2466     define input  parameter p-move-resize  as logical   no-undo .
     2467     define variable v-field-group-handle   as handle    no-undo .
     2468     define variable v-object-handle        as handle    no-undo .
     2469     define variable v-frame-width          as decimal   no-undo .
     2470     define variable v-frame-virtual-width  as decimal   no-undo .
     2471     define variable v-browse-width         as decimal   no-undo .
     2472     define variable v-window-width         as decimal   no-undo .
     2473     define variable v-window-virtual-width as decimal   no-undo .
     2474     define variable v-change-sign          as integer   no-undo .
     2475     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2476     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2477     if p-change-value > 0
     2478     then do:
     2479       if frame d-rvs :width + p-change-value >
     2480           session :width-chars
     2481       then do:
     2482         assign
     2483           p-change-value = session :width-chars - frame d-rvs :width
     2484         .
     2485         if p-change-value <= 0
     2486         then do:
     2487           run diasize_position-resize-button in this-procedure .
     2488           return .
     2489         end.
     2490       end.
     2491     end.
     2492     if p-change-value < 0
     2493     then do:
     2494       if frame d-rvs :width + p-change-value < v-diasize-orig-frame-width
     2495       then do:
     2496         assign
     2497           p-change-value = v-diasize-orig-frame-width
     2498                          - frame d-rvs :width
     2499         .
     2500         if p-change-value >= 0
     2501         then do:
     2502           run diasize_position-resize-button in this-procedure .
     2503           return .
     2504         end.
     2505       end.
     2506     end.
     2507     if p-change-value >= 0
     2508     then do:
     2509       assign
     2510         v-change-sign = 1
     2511       .
     2512     end.
     2513     else do:
     2514       assign
     2515         v-change-sign = -1
     2516       .
     2517     end.
     2518     assign
     2519       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2520     .
     2521     if p-change-value = 0
     2522     then do:
     2523       run diasize_position-resize-button in this-procedure .
     2524       return .
     2525     end.
     2526     move_block:
     2527     do
     2528     on error undo move_block, leave move_block
     2529     :
     2530       if retry
     2531       then do:
     2532         do
     2533         on error undo move_block, leave move_block
     2534         :
     2535           if p-change-value > 0
     2536           then do:
     2537             for each buf_temp-diasize-handle
     2538             on error undo, next
     2539             :
     2540               assign
     2541                 v-object-handle = buf_temp-diasize-handle.handle-value
     2542               .
     2543               if v-object-handle <> v-diasize-resize-button
     2544               then do:
     2545                 assign
     2546                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2547                 .
     2548               end.
     2549             end.
     2550             assign
     2551               v-diasize-browse-handle :width = v-browse-width
     2552             .
     2553             for each buf_temp-browse-handle
     2554               where buf_temp-browse-handle.browse-type = 'width':u
     2555             on error undo, next
     2556             :
     2557               assign
     2558                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2559               .
     2560             end.
     2561             assign
     2562               frame d-rvs :width = v-frame-width
     2563             .
     2564             if frame d-rvs :scrollable = true
     2565             then do:
     2566               assign
     2567                 frame d-rvs :virtual-width = v-frame-virtual-width
     2568               .
     2569             end.
     2570             run diasize_position-resize-button in this-procedure .
     2571           end.
     2572           else do:
     2573             if frame d-rvs :scrollable = true
     2574             then do:
     2575               assign
     2576                 frame d-rvs :virtual-width = v-frame-virtual-width
     2577               .
     2578             end.
     2579             assign
     2580               frame d-rvs :width = v-frame-width
     2581             .
     2582             for each buf_temp-browse-handle
     2583               where buf_temp-browse-handle.browse-type = 'width':u
     2584             on error undo, next
     2585             :
     2586               assign
     2587                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2588               .
     2589             end.
     2590             assign
     2591               v-diasize-browse-handle :width = v-browse-width
     2592             .
     2593             for each buf_temp-diasize-handle
     2594             on error undo, next
     2595             :
     2596               assign
     2597                 v-object-handle = buf_temp-diasize-handle.handle-value
     2598               .
     2599               if v-object-handle <> v-diasize-resize-button
     2600               then do:
     2601                 assign
     2602                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2603                 .
     2604               end.
     2605             end.
     2606             run diasize_position-resize-button in this-procedure .
     2607           end.
     2608           assign
     2609             v-diasize-change-size = false
     2610           .
     2611           leave move_block .
     2612         end.
     2613       end.
     2614       assign
     2615         v-diasize-need-full-display = true
     2616       .
     2617       if v-diasize-change-size = false
     2618       then do:
     2619         assign
     2620           v-diasize-change-size = true
     2621         .
     2622       end.
     2623       else do:
     2624         return .
     2625       end.
     2626       assign
     2627         v-frame-width = frame d-rvs :width
     2628         v-frame-virtual-width = frame d-rvs :virtual-width
     2629         v-browse-width = v-diasize-browse-handle :width
     2630       .
     2631       for each buf_temp-browse-handle
     2632         where buf_temp-browse-handle.browse-type = 'width':u
     2633       :
     2634         assign
     2635           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2636         .
     2637       end.
     2638       for each buf_temp-diasize-handle
     2639       :
     2640         delete buf_temp-diasize-handle .
     2641       end.
     2642       assign
     2643         v-field-group-handle = frame d-rvs :first-child
     2644       .
     2645       do while valid-handle(v-field-group-handle)
     2646       :
     2647         assign
     2648           v-object-handle = v-field-group-handle :first-child
     2649         .
     2650         do while valid-handle(v-object-handle)
     2651         :
     2652           if  v-object-handle <> v-diasize-browse-handle :handle
     2653           and v-object-handle <> v-diasize-resize-button
     2654           and can-query(v-object-handle, "row")
     2655           and can-query(v-object-handle, "height")
     2656           and ( v-object-handle :col + v-object-handle :width
     2657                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2658               )
     2659           then do:
     2660             find first buf_temp-browse-handle
     2661               where buf_temp-browse-handle.browse-type   = 'width':u
     2662                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2663               no-error .
     2664             if available buf_temp-browse-handle
     2665             then do:
     2666             end.
     2667             else do:
     2668               create buf_temp-diasize-handle .
     2669               assign
     2670                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2671                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2672               .
     2673             end.
     2674           end.
     2675           assign
     2676             v-object-handle = v-object-handle :next-sibling
     2677           .
     2678         end.
     2679         assign
     2680           v-field-group-handle = v-field-group-handle :next-sibling
     2681         .
     2682       end.
     2683       do with frame d-rvs
     2684       :
     2685         hide v-diasize-resize-button .
     2686         v-diasize-resize-button :row = 1.
     2687         v-diasize-resize-button :column = 1.
     2688       end.
     2689       if p-change-value > 0
     2690       then do:
     2691         if frame d-rvs :scrollable = true
     2692         then do:
     2693           assign
     2694             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     2695             no-error .
     2696           if error-status :error
     2697           or error-status :get-message(1) <> ""
     2698           then do:
     2699             undo move_block, retry move_block.
     2700           end.
     2701         end.
     2702         assign
     2703           frame d-rvs :width = v-frame-width + p-change-value
     2704           no-error .
     2705         if error-status :error
     2706         or error-status :get-message(1) <> ""
     2707         then do:
     2708           undo move_block, retry move_block.
     2709         end.
     2710         assign
     2711           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2712         no-error .
     2713         if error-status :error
     2714         or error-status :get-message(1) <> ""
     2715         then do:
     2716           undo move_block, retry move_block.
     2717         end.
     2718         for each buf_temp-browse-handle
     2719           where buf_temp-browse-handle.browse-type = 'width':u
     2720         on error undo move_block, retry move_block
     2721         :
     2722           assign
     2723             buf_temp-browse-handle.browse-handle :width
     2724               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2725             no-error .
     2726           if error-status :error
     2727           or error-status :get-message(1) <> ""
     2728           then do:
     2729             undo move_block, retry move_block .
     2730           end.
     2731         end.
     2732         for each buf_temp-diasize-handle
     2733         on error undo move_block, retry move_block
     2734         :
     2735           assign
     2736             v-object-handle = buf_temp-diasize-handle.handle-value
     2737           .
     2738           if v-object-handle <> v-diasize-resize-button
     2739           then do:
     2740             assign
     2741               v-object-handle :col = v-object-handle :col + p-change-value
     2742               no-error .
     2743             if error-status :error
     2744             or error-status :get-message(1) <> ""
     2745             then do:
     2746               undo move_block, retry move_block .
     2747             end.
     2748           end.
     2749         end.
     2750       end.
     2751       else do:
     2752         for each buf_temp-diasize-handle
     2753         on error undo move_block, retry move_block
     2754         :
     2755           assign
     2756             v-object-handle = buf_temp-diasize-handle.handle-value
     2757           .
     2758           if v-object-handle <> v-diasize-resize-button
     2759           then do:
     2760             assign
     2761               v-object-handle :col = v-object-handle :col + p-change-value
     2762               no-error .
     2763             if error-status :error
     2764             or error-status :get-message(1) <> ""
     2765             then do:
     2766               undo move_block, retry move_block .
     2767             end.
     2768           end.
     2769         end.
     2770         for each buf_temp-browse-handle
     2771           where buf_temp-browse-handle.browse-type = 'width':u
     2772         on error undo move_block, retry move_block
     2773         :
     2774           assign
     2775             buf_temp-browse-handle.browse-handle :width
     2776               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2777             no-error .
     2778           if error-status :error
     2779           or error-status :get-message(1) <> ""
     2780           then do:
     2781             undo move_block, retry move_block .
     2782           end.
     2783         end.
     2784         assign
     2785           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2786           no-error .
     2787         if error-status :error
     2788         or error-status :get-message(1) <> ""
     2789         then do:
     2790           undo move_block, retry move_block.
     2791         end.
     2792         assign
     2793           frame d-rvs :width = frame d-rvs :width + p-change-value
     2794         no-error .
     2795         if error-status :error
     2796         or error-status :get-message(1) <> ""
     2797         then do:
     2798           undo move_block, retry move_block.
     2799         end.
     2800         if frame d-rvs :scrollable = true
     2801         then do:
     2802           assign
     2803             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     2804           no-error .
     2805           if error-status :error
     2806           or error-status :get-message(1) <> ""
     2807           then do:
     2808             undo move_block, retry move_block.
     2809           end.
     2810         end.
     2811       end.
     2812       if p-move-resize
     2813       then do:
     2814         run diasize_position-resize-button in this-procedure .
     2815       end.
     2816       if v-diasize-wndstore = true
     2817       then do:
     2818         if connected("ub") = true
     2819         then do:
     2820           define variable v-cntxt-db-num        as integer   no-undo .
     2821           define variable v-cntxt-userid        as character no-undo .
     2822           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2823                                             , OUTPUT v-cntxt-userid
     2824                                             ) .
     2825           run gbl/wndsizew.p
     2826             (input  v-cntxt-db-num
     2827             ,input  v-cntxt-userid
     2828             ,input  v-diasize-proc-name
     2829             ,input  'width':u
     2830             ,input  string(frame d-rvs :width - v-diasize-orig-frame-width)
     2831             ) .
     2832         end.
     2833       end.
     2834     end.
     2835     assign
     2836       v-diasize-change-size = false
     2837     .
     2838   end procedure.
     2839   procedure diasize_set-width :
     2840     define input  parameter p-new-width  as decimal   no-undo .
     2841     define input  parameter p-move-resize as logical   no-undo .
     2842     do
     2843     on error undo, return error return-value
     2844     :
     2845       run diasize_change-width in this-procedure
     2846         (input  (p-new-width - frame d-rvs :width)
     2847         ,input  p-move-resize
     2848         ) .
     2849     end.
     2850   end procedure.
     2851   procedure diasize_position-resize-button :
     2852     do with frame d-rvs
     2853     :
     2854       hide v-diasize-resize-button .
     2855       assign
     2856         v-diasize-resize-button :row = frame d-rvs :height - v-diasize-resize-button :height
     2857                     - 1
     2858                     - (frame d-rvs :border-bottom-pixels / session :pixels-per-row)
     2859         v-diasize-resize-button :col = frame d-rvs :width - v-diasize-resize-button :width
     2860                     - 1
     2861                     - (frame d-rvs :border-right-pixels / session :pixels-per-column)
     2862       .
     2863       view v-diasize-resize-button .
     2864     end.
     2865   end procedure.
     2866   on alt-right anywhere
     2867   do:
     2868     run diasize_change-width in this-procedure
     2869       (input 1
     2870       ,input true
     2871       ) .
     2872     return no-apply .
     2873   end.
     2874   on alt-left anywhere
     2875   do:
     2876     run diasize_change-width in this-procedure
     2877       (input -1
     2878       ,input true
     2879       ) .
     2880     return no-apply .
     2881   end.
     2882   on alt-down anywhere
     2883   do:
     2884     run diasize_change-height in this-procedure
     2885       (input 1
     2886       ,input true
     2887       ) .
     2888     return no-apply .
     2889   end.
     2890   on alt-up anywhere
     2891   do:
     2892     run diasize_change-height in this-procedure
     2893       (input -1
     2894       ,input true
     2895       ) .
     2896     return no-apply .
     2897   end.
     2898   on alt-enter of frame d-rvs
     2899   do:
     2900     run diasize_maximize in this-procedure
     2901       (input  ?
     2902       ).
     2903     return no-apply .
     2904   end.
     2905   procedure diasize_end-move :
     2906     do
     2907     on error undo, return error return-value
     2908     :
     2909       define variable v-row-delta as decimal   no-undo .
     2910       define variable v-col-delta as decimal   no-undo .
     2911       define variable v-new-row as decimal   no-undo .
     2912       define variable v-new-col as decimal   no-undo .
     2913       assign
     2914         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2915         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2916       .
     2917       assign
     2918         v-row-delta = v-new-row - frame d-rvs :height
     2919         v-col-delta = v-new-col - frame d-rvs :width
     2920       .
     2921       run diasize_change-height in this-procedure
     2922         (input v-row-delta
     2923         ,input true
     2924         ) .
     2925       run diasize_change-width in this-procedure
     2926         (input v-col-delta
     2927         ,input true
     2928         ) .
     2929     end.
     2930   end procedure.
     2931   procedure diasize_maximize :
     2932     define input  parameter p-action as logical   no-undo .
     2933     do
     2934     on error undo, return error return-value
     2935     :
     2936       if p-action = ?
     2937       then do:
     2938         if v-diasize-need-maximize = true
     2939         then do:
     2940           assign
     2941             p-action = true
     2942           .
     2943         end.
     2944         else do:
     2945           assign
     2946             p-action = false
     2947           .
     2948         end.
     2949       end.
     2950       if p-action = true
     2951       then do:
     2952         run diasize_change-height in this-procedure
     2953           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2954               - frame d-rvs :height-chars
     2955           ,input true
     2956           ) .
     2957         run diasize_change-width in this-procedure
     2958           (input session :width-chars
     2959               - frame d-rvs :width-chars
     2960           ,input true
     2961           ) .
     2962         assign
     2963           v-diasize-need-maximize = false
     2964         .
     2965       end.
     2966       else do:
     2967         run diasize_change-width in this-procedure
     2968           (input v-diasize-orig-frame-width
     2969               - frame d-rvs :width-chars
     2970           ,input true
     2971           ) .
     2972         run diasize_change-height in this-procedure
     2973           (input v-diasize-orig-frame-height
     2974               - frame d-rvs :height-chars
     2975           ,input true
     2976           ) .
     2977         assign
     2978           v-diasize-need-maximize = true
     2979         .
     2980       end.
     2981     end.
     2982   end procedure.
     2983   procedure diasize_restore-orig-size :
     2984     do
     2985     on error undo, return error return-value
     2986     :
     2987       assign
     2988         v-diasize-current-frame-width  = frame d-rvs :width
     2989         v-diasize-current-frame-height = frame d-rvs :height
     2990       .
     2991       run diasize_set-height in this-procedure
     2992         (input  v-diasize-orig-frame-height
     2993         ,input  true
     2994         ) .
     2995       run diasize_set-width in this-procedure
     2996         (input  v-diasize-orig-frame-width
     2997         ,input  true
     2998         ) .
     2999     end.
     3000   end procedure.
     3001   procedure diasize_restore-current-size :
     3002     do
     3003     on error undo, return error return-value
     3004     :
     3005       run diasize_set-height in this-procedure
     3006         (input  v-diasize-current-frame-height
     3007         ,input  true
     3008         ) .
     3009       run diasize_set-width in this-procedure
     3010         (input  v-diasize-current-frame-width
     3011         ,input  true
     3012         ) .
     3013     end.
     3014   end procedure.
     3015   procedure diasize_set-browse-handle :
     3016     define input  parameter p-browse-handle as handle   no-undo .
     3017     define buffer buf_temp-browse-handle for temp-browse-handle .
     3018     do
     3019     on error undo, return error return-value
     3020     :
     3021       assign
     3022         v-diasize-browse-handle = p-browse-handle
     3023       .
     3024       for each buf_temp-browse-handle
     3025       on error undo, return error return-value
     3026       :
     3027         delete buf_temp-browse-handle .
     3028       end.
     3029     end.
     3030   end procedure.
     3031   procedure diasize_add_browse :
     3032     define input  parameter p-browse-type   as character no-undo .
     3033     define input  parameter p-browse-handle as handle    no-undo .
     3034     define buffer buf_temp-browse-handle for temp-browse-handle .
     3035     do
     3036     on error undo, return error return-value
     3037     :
     3038       assign
     3039         v-diasize-browse-number = v-diasize-browse-number + 1
     3040       .
     3041       create buf_temp-browse-handle .
     3042       assign
     3043         buf_temp-browse-handle.browse-type   = p-browse-type
     3044         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3045         buf_temp-browse-handle.browse-handle = p-browse-handle
     3046       .
     3047     end.
     3048   end procedure.
     3049   procedure diasize_init :
     3050     define variable v-default-value    as logical   no-undo .
     3051     define variable v-restore-saved    as logical   no-undo .
     3052     define variable v-resize-value-str as character no-undo .
     3053     do
     3054     on error undo, return error return-value
     3055     :
     3056       do with frame d-rvs
     3057       :
     3058         assign
     3059           v-diasize-orig-frame-height = frame d-rvs :height
     3060           v-diasize-orig-frame-width  = frame d-rvs :width
     3061           v-diasize-browse-handle     = browse br-line :handle
     3062         .
     3063         create button v-diasize-resize-button
     3064         assign
     3065           parent        = frame d-rvs :first-child
     3066           label         = "s"
     3067           height-pixels = 16
     3068           width-pixels  = 16
     3069           visible       = true
     3070           sensitive     = true
     3071           movable       = true
     3072           triggers:
     3073             on end-move persistent run diasize_end-move in this-procedure .
     3074           end triggers.
     3075         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3076         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3077         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3078         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3079         assign
     3080           v-diasize-wndmax = false
     3081         .
     3082         if connected("ub") = true
     3083         then do:
     3084           define variable v-cntxt-db-num        as integer   no-undo .
     3085           define variable v-cntxt-userid        as character no-undo .
     3086           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3087                                             , OUTPUT v-cntxt-userid
     3088                                             ) .
     3089           run gbl/wndpar_r.p
     3090             (input  v-cntxt-db-num
     3091             ,input  v-cntxt-userid
     3092             ,input  'wndmax':U
     3093             ,output v-diasize-wndmax
     3094             ,output v-default-value
     3095             ) .
     3096         end.
     3097         assign
     3098           v-diasize-wndstore = false
     3099         .
     3100         if connected("ub") = true
     3101         then do:
     3102           run gbl/wndpar_r.p
     3103             (input  v-cntxt-db-num
     3104             ,input  v-cntxt-userid
     3105             ,input  'wndstore':U
     3106             ,output v-diasize-wndstore
     3107             ,output v-default-value
     3108             ) .
     3109         end.
     3110         assign
     3111           v-diasize-proc-name = entry(1, program-name(2), '.')
     3112         .
     3113         if v-diasize-wndstore = true
     3114         then do:
     3115           assign
     3116             v-restore-saved = false
     3117           .
     3118           if connected("ub") = true
     3119           then do:
     3120             run gbl/wndsizer.p
     3121               (input  v-cntxt-db-num
     3122               ,input  v-cntxt-userid
     3123               ,input  v-diasize-proc-name
     3124               ,input  'height':u
     3125               ,output v-resize-value-str
     3126               ) .
     3127             if v-resize-value-str <> '':U
     3128             then do:
     3129               run diasize_change-height in this-procedure
     3130                 (input  integer(v-resize-value-str)
     3131                 ,input  true
     3132                 ) .
     3133               assign
     3134                 v-restore-saved = true
     3135               .
     3136             end.
     3137           end.
     3138           if connected("ub") = true
     3139           then do:
     3140             run gbl/wndsizer.p
     3141               (input  v-cntxt-db-num
     3142               ,input  v-cntxt-userid
     3143               ,input  v-diasize-proc-name
     3144               ,input  'width':u
     3145               ,output v-resize-value-str
     3146               ) .
     3147             if v-resize-value-str <> '':U
     3148             then do:
     3149               run diasize_change-width in this-procedure
     3150                 (input  integer(v-resize-value-str)
     3151                 ,input  true
     3152                 ) .
     3153               assign
     3154                 v-restore-saved = true
     3155               .
     3156             end.
     3157           end.
     3158           if v-restore-saved <> true
     3159           then do:
     3160             if v-diasize-wndmax = true
     3161             then do:
     3162               run diasize_maximize in this-procedure
     3163                 (input  true
     3164                 ) .
     3165             end.
     3166           end.
     3167         end.
     3168         else do:
     3169           if v-diasize-wndmax = true
     3170           then do:
     3171             run diasize_maximize in this-procedure
     3172               (input  true
     3173               ) .
     3174           end.
     3175         end.
     3176       end.
     3177     end.
     3178   end procedure.
     3179   procedure diasize_need-full-display :
     3180     define output parameter p-need-full-display as logical   no-undo .
     3181     do
     3182     on error undo, return error return-value
     3183     :
     3184       assign
     3185         p-need-full-display = v-diasize-need-full-display
     3186       .
     3187       assign
     3188         v-diasize-need-full-display = false
     3189       .
     3190     end.
     3191   end procedure.
     3192   procedure get-context :
     3193      define output parameter p-db-num as integer          no-undo.
     3194      define output parameter p-user-id as character        no-undo.
     3195      define variable v-login               as character    no-undo.
     3196      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3197      define buffer buf_user-login  for ub.user-login .
     3198      do
     3199      on error undo, return error
     3200      :
     3201            FIND FIRST buf_sys-ctrl no-lock.
     3202            ASSIGN
     3203               v-login = USERID("ub")
     3204               p-db-num = buf_sys-ctrl.db-num
     3205            .
     3206            FIND FIRST buf_user-login
     3207                 WHERE buf_user-login.db-num = p-db-num
     3208                   AND buf_user-login.user-login = v-login
     3209                 no-lock
     3210                 no-error
     3211                 .
     3212            IF AVAILABLE buf_user-login
     3213            THEN DO:
     3214               assign
     3215                  p-user-id = buf_user-login.user-id
     3216               .
     3217            END.
     3218      end.
     3219   end procedure.
     3220       run diasize_init in this-procedure .
     3221   p-next-prev = "":U.
     3222   main-block:
     3223   do on error   undo main-block, leave main-block
     3224      on end-key undo main-block, leave main-block
     3225      on stop    undo main-block, leave main-block:
     3226     p-next-prev = "QUIT".
     3227      run mode-on in this-procedure
     3228        no-error.
     3229      if error-status :error then do:
     3230        return error return-value .
     3231      end.
     3232      run ui-on in this-procedure.
     3233   end.
     3234   WAIT-FOR GO OF FRAME d-rvs.
     3235   run disable_ui in this-procedure.
     3236   procedure disable_ui :
     3237     hide frame d-rvs.
     3238   end procedure.
     3239   procedure ui-on :
     3240   del-list = "".
     3241   find first ub.clients where ub.clients.obj-type = c-rvs-doc.obj-type and
     3242                      ub.clients.obj-code = c-rvs-doc.obj-code no-lock.
     3243   assign frame d-rvs:title = "(" + substring (ub.clients.obj-name, 1, 35) +
     3244          ") :   ДОКУМЕНТ СВЕРКИ - " + c-rvs-doc.status_ + " № " + c-rvs-doc.rvs-code + "      - " + pardoc-mode.
     3245   disable all with frame d-rvs.
     3246   enable b-exit b-help b-lkp b-lkp-pump B-prev B-next br-line br-pump b-history b-notes with frame d-rvs.
     3247   assign ub.c-rvs-line.temperature:read-only in browse br-line = yes
     3248          ub.c-rvs-line-pump.rvs-prev-code:read-only in browse br-pump = yes.
     3249   if available ub.clients then disp ub.clients.obj-name with frame d-rvs.
     3250   else disp ? @ ub.clients.obj-name with frame d-rvs.
     3251   disp c-rvs-doc.obj-code
     3252        c-rvs-doc.obj-type
     3253        c-rvs-doc.doc-date
     3254        c-rvs-doc.state-measure-qnty
     3255        c-rvs-doc.measure-qnty
     3256        c-rvs-doc.system-qnty
     3257        c-rvs-doc.state-measure-cli-qnty
     3258       c-rvs-doc.measure-cli-qnty
     3259       c-rvs-doc.system-cli-qnty
     3260       c-rvs-doc.system-cli-avrg-qnty
     3261        c-rvs-doc.state-mh-qnty
     3262        c-rvs-doc.state-am-qnty
     3263       c-rvs-doc.state-cf-qnty
     3264       c-rvs-doc.out-code
     3265        with frame d-rvs.
     3266   open query br-line    for each  ub.c-rvs-line no-lock where              ub.c-rvs-line.rvs-code =    c-rvs-doc.rvs-code              and c-rvs-line.chip-num = c-rvs-doc.chip-num      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.c-rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.c-rvs-line.obj-type and              ub.place.obj-code        = ub.c-rvs-line.obj-code and              ub.place.pl-code         = ub.c-rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     3267   if pardoc-mode = 'ПРОСМОТР':U then do:
     3268     if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     3269   end.
     3270   open query br-pump    for each ub.c-rvs-line-pump no-lock where             ub.c-rvs-line-pump.rvs-code = ub.c-rvs-line.rvs-code and             ub.c-rvs-line-pump.obj-type = ub.c-rvs-line.obj-type and             ub.c-rvs-line-pump.obj-code = ub.c-rvs-line.obj-code and             ub.c-rvs-line-pump.pl-code  = ub.c-rvs-line.pl-code  and             ub.c-rvs-line-pump.gds-code = ub.c-rvs-line.gds-code and               ub.c-rvs-line-pump.chip-num = ub.c-rvs-line.chip-num.
     3271   if rvs-line-pump-rec <> ? then reposition br-pump to recid rvs-line-pump-rec no-error.
     3272    VIEW FRAME d-rvs.
     3273   end procedure.
     3274   PROCEDURE local-mark:
     3275     if not available ub.c-rvs-line then do:
     3276       message "Неправильный выбор строки.".
     3277       return no-apply.
     3278     end.
     3279   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3280   define variable v-str-recid16 as character no-undo .
     3281   define variable v-num-entry16 as integer   no-undo .
     3282   assign
     3283     v-str-recid16 = trim( string( recid( ub.c-rvs-line ) , "->>>>>>>>>>>9":U ) )
     3284     v-num-entry16 = lookup( v-str-recid16 , del-list )
     3285   .
     3286   if v-num-entry16 > 0 then do:
     3287     assign
     3288       entry( v-num-entry16, del-list ) = "":U
     3289       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3290     .
     3291   end.
     3292   else do:
     3293     assign
     3294       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid16
     3295     .
     3296   end.
     3297     br-line:refresh() in frame d-rvs .
     3298   END PROCEDURE.
     3299   procedure mode-on :
     3300   define variable v-shift-date like ub.shift-obj.shift-date no-undo.
     3301   define variable v-shift-num  like ub.shift-obj.shift-num  no-undo.
     3302   define variable v-shift-name as   character               no-undo.
     3303   define variable v-obj-date   as   date                    no-undo.
     3304       if pardoc-mode  =   'ПРОСМОТР':U then
     3305       do:
     3306           find c-rvs-doc no-lock where recid (c-rvs-doc) = parrvs-rec and c-rvs-doc.action = integer('99':U).
     3307       end.
     3308   if not available c-rvs-doc then do:
     3309     message "Неправильно выбран документ.".
     3310     undo, return error.
     3311   end.
     3312   end procedure.
     3313   procedure local-psn-chk:
     3314   define input parameter parman    as character no-undo.
     3315   define input parameter paraction as character no-undo.
     3316   if parman = "agnt" and paraction = "ret-mouse" then do:
     3317     define variable v-ref-rec17   as recid no-undo .
     3318     find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.agnt
     3319                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3320     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3321       if input frame d-rvs c-rvs-doc.agnt <> ""
     3322          and input frame d-rvs c-rvs-doc.agnt <> ? then
     3323         message "Из справочника клиентов Вы должны выбрать человека.".
     3324       run ref/cli-all.w (  input parparentproc
     3325                     ,  input "b-sel"
     3326                     ,  input 'чел':U
     3327                     ,  input ?
     3328                     ,  input ?
     3329                     ,  input v-ref-rec
     3330                     ,  input ",,,,,,NO"
     3331                     ,  input "lock-cli-type"
     3332                     , output ref-list ) .
     3333       assign v-ref-rec17 = integer( ref-list ).
     3334       v-ref-rec = integer( ref-list ) .
     3335       find cli-buf where recid (cli-buf) =
     3336          v-ref-rec
     3337          no-lock no-error.
     3338       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3339         find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.agnt
     3340                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3341     end.
     3342     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3343       display cli-buf.obj-code @ c-rvs-doc.agnt
     3344               cli-buf.obj-name @ agnt-name with frame d-rvs.
     3345       assign frame d-rvs c-rvs-doc.agnt.
     3346     end.
     3347     else display ? @ c-rvs-doc.agnt
     3348                  ? @ agnt-name with frame d-rvs.
     3349     apply "entry" to c-rvs-doc.boss
     3350                               in frame d-rvs.
     3351   if available cli-buf then do:
     3352         display cli-buf.obj-code @ c-rvs-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3353     end.
     3354     else display ? @ c-rvs-doc.agnt ? @ agnt-name with frame d-rvs.
     3355         return no-apply.
     3356   end.
     3357   if parman = "agnt" and paraction = "button" then do:
     3358     define variable v-ref-rec18   as recid no-undo .
     3359     find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.agnt
     3360                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3361     assign v-ref-rec18 = ( if available cli-buf then recid( cli-buf ) else ? ).
     3362     v-ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     3363     release cli-buf.
     3364     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3365       run ref/cli-all.w (  input parparentproc
     3366                     ,  input "b-sel"
     3367                     ,  input 'чел':U
     3368                     ,  input ?
     3369                     ,  input ?
     3370                     ,  input v-ref-rec
     3371                     ,  input ",,,,,,NO"
     3372                     ,  input "lock-cli-type"
     3373                     , output ref-list ) .
     3374       assign v-ref-rec18 = integer( ref-list ).
     3375       v-ref-rec = integer( ref-list ) .
     3376       find cli-buf where recid (cli-buf) =
     3377          v-ref-rec
     3378          no-lock no-error.
     3379       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3380         find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.agnt
     3381                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3382     end.
     3383     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3384       display cli-buf.obj-code @ c-rvs-doc.agnt
     3385               cli-buf.obj-name @ agnt-name with frame d-rvs.
     3386       assign frame d-rvs c-rvs-doc.agnt.
     3387     end.
     3388     else display ? @ c-rvs-doc.agnt
     3389                  ? @ agnt-name with frame d-rvs.
     3390     apply "entry" to c-rvs-doc.boss
     3391                               in frame d-rvs.
     3392   if available cli-buf then do:
     3393         display cli-buf.obj-code @ c-rvs-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3394     end.
     3395     else display ? @ c-rvs-doc.agnt ? @ agnt-name with frame d-rvs.
     3396         return no-apply.
     3397   end.
     3398   if parman = "agnt" and paraction = "leave" then do:
     3399     define variable v-ref-rec19   as recid no-undo .
     3400     find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.agnt
     3401                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3402   if available cli-buf then do:
     3403         display cli-buf.obj-code @ c-rvs-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3404             assign frame d-rvs c-rvs-doc.agnt.
     3405     end.
     3406     else display ? @ c-rvs-doc.agnt ? @ agnt-name with frame d-rvs.
     3407   end.
     3408   if parman = "boss" and paraction = "ret-mouse" then do:
     3409     define variable v-ref-rec20   as recid no-undo .
     3410     find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.boss
     3411                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3412     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3413       if input frame d-rvs c-rvs-doc.boss <> ""
     3414          and input frame d-rvs c-rvs-doc.boss <> ? then
     3415         message "Из справочника клиентов Вы должны выбрать человека.".
     3416       run ref/cli-all.w (  input parparentproc
     3417                     ,  input "b-sel"
     3418                     ,  input 'чел':U
     3419                     ,  input ?
     3420                     ,  input ?
     3421                     ,  input v-ref-rec
     3422                     ,  input ",,,,,,NO"
     3423                     ,  input "lock-cli-type"
     3424                     , output ref-list ) .
     3425       assign v-ref-rec20 = integer( ref-list ).
     3426       v-ref-rec = integer( ref-list ) .
     3427       find cli-buf where recid (cli-buf) =
     3428          v-ref-rec
     3429          no-lock no-error.
     3430       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3431         find cli-buf where cli-buf.obj-code = input frame d-rvs c-rvs-doc.boss
     3432                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3433     end.
     3434     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3435       display cli-buf.obj-code @ c-rvs-doc.boss
     3436               cli-buf.obj-name @ boss-name with frame d-rvs.
     3437       assign frame d-rvs c-rvs-doc.boss.
     3438     end.
     3439     else display ? @ c-rvs-doc.boss
     3440                  ? @ boss-name with frame d-rvs.
     3441     apply "entry" to  b-exit in frame d-rvs.
     3442   if available cli-buf then do:
