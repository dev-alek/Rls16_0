     3850       ,input  c-rvs-doc.host-code
     3851       ,input  c-rvs-doc.obj-type
     3852       ,input  c-rvs-doc.obj-code
     3853       ,input  0
     3854       ,input  0
     3855       ,input  0
     3856       ,input  true
     3857       ,output varlog
     3858       )  .
     3859   end.
     3860       end.
     3861       when 'контроль':U
     3862       then do:
     3863   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3864   do:
     3865     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3866       (input  v-cntxt-db-num
     3867       ,input  v-cntxt-userid
     3868       ,input  0
     3869       ,input  'actn_rvs-control_lookup':U
     3870       ,input  'object':U
     3871       ,input  c-rvs-doc.host-code
     3872       ,input  c-rvs-doc.obj-type
     3873       ,input  c-rvs-doc.obj-code
     3874       ,input  0
     3875       ,input  0
     3876       ,input  0
     3877       ,input  true
     3878       ,output varlog
     3879       )  .
     3880   end.
     3881       end.
     3882       when 'проверка':U
     3883       then do:
     3884         varlog = yes .
     3885       end .
     3886       otherwise do:
     3887         message
     3888           vss-workfile vss-revision vss-description skip
     3889           "Неизвестный тип сверки" skip
     3890           "Тип сверки" c-rvs-doc.rvs-type skip
     3891           "Код сверки" c-rvs-doc.rvs-code skip
     3892           view-as alert-box error .
     3893         undo, return error return-value .
     3894       end.
     3895     end case .
     3896   if varlog <> yes then do: return error. end.
     3897   find first buf_goods where buf_goods.gds-code = ub.c-rvs-line.gds-code no-lock.
     3898   if not error-status :error
     3899      and is-gas(buf_goods.gds-code) then do:
     3900       run str/rvs-lin-mask-c.w
     3901         (input  parparentproc
     3902         ,input  recid(c-rvs-line)
     3903         ,input  'ПРОСМОТР':U
     3904         ,input  " # "     + c-rvs-doc.rvs-code +
     3905                 " товар " + buf_goods.artic     + " " +
     3906                             buf_goods.prod-type + " " +
     3907                             string(buf_goods.prod-code) +
     3908                 " складское место " + string(ub.c-rvs-line.pl-code)
     3909         ) no-error.
     3910   end.
     3911   else do:
     3912   run str/rvs-lin-c.w
     3913     (input  parparentproc
     3914     ,input  recid(c-rvs-line)
     3915     ,input  'ПРОСМОТР':U
     3916     ,input  " # "     + c-rvs-doc.rvs-code +
     3917             " товар " + buf_goods.artic     + " " +
     3918                         buf_goods.prod-type + " " +
     3919                         string(buf_goods.prod-code) +
     3920             " складское место " + string(ub.c-rvs-line.pl-code)
     3921     ) no-error.
     3922   end.
     3923   if error-status :error then do:
     3924      message "Ошибка при просмотре строки сверки." skip
     3925              return-value skip
     3926              error-status:get-message(1)
     3927      view-as alert-box error.
     3928      return error.
     3929   end.
     3930   find c-rvs-doc where recid(c-rvs-doc) = parrvs-rec.
     3931   run ui-on in this-procedure .
     3932   end procedure.
