     3589   procedure plgdsfnd :
     3590     define input  parameter p-chk-and-chs    as logical               no-undo .
     3591     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     3592     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     3593     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     3594     define output parameter p-reserv-pl-code as   logical             no-undo .
     3595     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     3596     define buffer buf_goods         for ub.goods .
     3597     define buffer buf_pl-gds        for ub.pl-gds .
     3598     define buffer buf_second_pl-gds for ub.pl-gds .
     3599     find first buf_goods no-lock where
     3600                buf_goods.gds-code = p-gds-code no-error .
     3601     if not available buf_goods
     3602     then do:
     3603       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     3604     end.
     3605   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3607     (input  p-obj-type
     3608     ,input  p-obj-code
     3609     ,input  buf_goods.artic
     3610     ,input  buf_goods.prod-type
     3611     ,input  buf_goods.prod-code
     3612     ,input  'place-rsrv=request'
     3613     ,output p-reserv-pl-code
     3614     ) no-error .
     3615     if error-status :error
     3616     then do:
     3617       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     3618     end.
     3619     if p-reserv-pl-code = no
     3620     then do:
     3621       return .
     3622     end.
     3623     if p-chk-and-chs <> yes
     3624     then do:
     3625       return .
     3626     end.
     3627     find first buf_pl-gds no-lock where
     3628                buf_pl-gds.obj-type = p-obj-type and
     3629                buf_pl-gds.obj-code = p-obj-code and
     3630                buf_pl-gds.gds-code = p-gds-code no-error .
     3631     if not available buf_pl-gds
     3632     then do:
     3633       return error "К товару не привязано ни одного места хранения" .
     3634     end.
     3635     find first buf_second_pl-gds no-lock where
     3636                buf_second_pl-gds.obj-type  = p-obj-type          and
     3637                buf_second_pl-gds.obj-code  = p-obj-code          and
     3638                buf_second_pl-gds.gds-code  = p-gds-code          and
     3639                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     3640     if not available buf_second_pl-gds
     3641     then do:
     3642       assign
     3643         p-pl-code = buf_pl-gds.pl-code
     3644       .
     3645     end.
     3646     else do:
     3647       run str/plgdssel.p
     3648         (
     3649            input parparentproc
     3650         ,  input p-obj-type
     3651         ,  input p-obj-code
     3652         ,  input p-gds-code
     3653         , output p-pl-code
     3654         ) no-error .
     3655       if error-status :error
     3656       then do:
     3657         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     3658                                , 'plgdssel.p':U
     3659                                , chr(10)
     3660                                , error-status :get-message( 1 )
     3661                                , return-value
     3662                                ) .
     3663       end.
     3664       if p-pl-code = ? or
     3665          p-pl-code = 0
     3666       then do:
     3667         return error "Не выбрано место хранения " + chr(10) .
     3668       end.
     3669     end.
     3670   end procedure.
     3671   PROCEDURE reposition-c-rvs-doc :
     3672   define input parameter p-direction as character no-undo .
     3673   define variable  v-new-c-rvs-doc-recid as recid no-undo .
     3674   do
     3675   on error undo, return error
     3676   :
     3677     if valid-handle(p-call-prog)
     3678     then do:
     3679       run reposition-c-rvs-doc in p-call-prog
     3680         (input  p-direction
     3681         ,output v-new-c-rvs-doc-recid
     3682         ).
     3683       if v-new-c-rvs-doc-recid <> ?
     3684       then do:
     3685         define buffer buf_c-rvs-doc for ub.c-rvs-doc .
     3686         find first buf_c-rvs-doc no-lock
     3687           where recid(buf_c-rvs-doc) = v-new-c-rvs-doc-recid
     3688           no-error .
     3689         assign
     3690         parrvs-rec = v-new-c-rvs-doc-recid
     3691         p-next-prev = '':U
     3692         .
     3693       end.
     3694     end.
     3695     else do:
     3696       message "Список документов сверки." view-as alert-box INFORMATION .
     3697       return no-apply.
     3698     end.
     3699     END.
     3700   END PROCEDURE.
     3701   procedure proc-lookup:
     3702   define buffer buf_goods for ub.goods.
     3703   if not available ub.c-rvs-line-pump then do:
     3704     message "Неправильный выбор строки.".
     3705     return error.
     3706   end.
     3707   assign rvs-line-rec      = (if available ub.c-rvs-line then recid(ub.c-rvs-line) else ?)
     3708          rvs-line-pump-rec = recid(ub.c-rvs-line-pump).
     3709     case c-rvs-doc.rvs-type
     3710     :
     3711       when 'перед_док':U
     3712       or when 'после_док':U
     3713       then do:
     3714   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3715   do:
     3716     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3717       (input  v-cntxt-db-num
     3718       ,input  v-cntxt-userid
     3719       ,input  0
     3720       ,input  'actn_rvs-on-doc_lookup':U
     3721       ,input  'object':U
     3722       ,input  c-rvs-doc.host-code
     3723       ,input  c-rvs-doc.obj-type
     3724       ,input  c-rvs-doc.obj-code
     3725       ,input  0
     3726       ,input  0
     3727       ,input  0
     3728       ,input  true
     3729       ,output varlog
     3730       )  .
     3731   end.
     3732       end.
     3733       when 'смена':U
     3734       then do:
     3735   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3736   do:
     3737     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3738       (input  v-cntxt-db-num
     3739       ,input  v-cntxt-userid
     3740       ,input  0
     3741       ,input  'actn_rvs-shift_lookup':U
     3742       ,input  'object':U
     3743       ,input  c-rvs-doc.host-code
     3744       ,input  c-rvs-doc.obj-type
     3745       ,input  c-rvs-doc.obj-code
     3746       ,input  0
     3747       ,input  0
     3748       ,input  0
     3749       ,input  true
     3750       ,output varlog
     3751       )  .
     3752   end.
     3753       end.
     3754       when 'контроль':U
     3755       then do:
     3756   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3757   do:
     3758     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3759       (input  v-cntxt-db-num
     3760       ,input  v-cntxt-userid
     3761       ,input  0
     3762       ,input  'actn_rvs-control_lookup':U
     3763       ,input  'object':U
     3764       ,input  c-rvs-doc.host-code
     3765       ,input  c-rvs-doc.obj-type
     3766       ,input  c-rvs-doc.obj-code
     3767       ,input  0
     3768       ,input  0
     3769       ,input  0
     3770       ,input  true
     3771       ,output varlog
     3772       )  .
     3773   end.
     3774       end.
     3775       otherwise do:
     3776         message
     3777           vss-workfile vss-revision vss-description skip
     3778           "Неизвестный тип сверки" skip
     3779           "Тип сверки" c-rvs-doc.rvs-type skip
     3780           "Код сверки" c-rvs-doc.rvs-code skip
     3781           view-as alert-box error .
     3782         undo, return error return-value .
     3783       end.
     3784     end case .
     3785   if varlog <> yes then do: return error. end.
     3786   find first buf_goods where buf_goods.gds-code = ub.c-rvs-line-pump.gds-code no-lock.
     3787   run str/rvs-lnp-c.w
     3788     (input  parparentproc
     3789     ,input  recid(c-rvs-line-pump)
     3790     ,input  'ПРОСМОТР':U
     3791     ,input  " # "     + c-rvs-doc.rvs-code +
     3792             " товар " + buf_goods.artic     + " " +
     3793                         buf_goods.prod-type + " " +
     3794                         string(buf_goods.prod-code) +
     3795             " складское место " + string(ub.c-rvs-line-pump.pl-code) +
     3796             " ТРК " + string(ub.c-rvs-line-pump.pump-code) +
     3797             " пистолет " + string(ub.c-rvs-line-pump.nozzle-code)
     3798     ) no-error.
     3799   if error-status :error then do:
     3800      message "Ошибка при просмотре данных по ТРК." skip
     3801              return-value skip
     3802              error-status:get-message(1)
     3803      view-as alert-box error.
     3804      return error.
     3805   end.
     3806   find c-rvs-doc where recid(c-rvs-doc) = parrvs-rec.
     3807   end procedure.
