     1386   B-prev              at row 1 col 30
     1387   B-next             at row 1 col 34
     1388   b-help              at row 1  col 81
     1389   "Объект:"                         at row 2 col 10
     1390   c-rvs-doc.obj-code                    at row 2 col 16   colon-aligned no-label       view-as text size 7    by 1
     1391   c-rvs-doc.obj-type                    at row 2 col 23   colon-aligned no-label       view-as text size 7.13 by 1
     1392   ub.clients.obj-name               at row 2 col 33   colon-aligned no-label       view-as text size 40 by 1 fgcolor 4
     1393   c-rvs-doc.out-code                    at row 3 col 20   colon-aligned label "На основе документа" view-as text
