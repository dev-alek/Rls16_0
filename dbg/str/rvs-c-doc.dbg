     1148   function is-gas returns logical
     1149           (input p-gds-code as integer):
     1150   define variable result as logical no-undo.
     1151   define variable c-value as character no-undo.
     1152   define variable c-type as character no-undo.
     1153   do on error undo, return error:
     1154           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1155         (input  p-gds-code
     1156         ,input  'fuel-type':U
     1157         ,output c-value
     1158         ,output c-type) no-error.
     1159   end.
     1160   result = logical(c-value = 'metan':U) no-error.
     1161   return result.
     1162   end function.
     1163   procedure placelib_write-attr:
     1164   define input  parameter p-code     like ub.place-attr.attr-code .
     1165   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1166   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1167   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1168   define input  parameter p-value    like ub.place-attr.attr-value .
     1169   define output parameter p-ok       as logical.
     1170   define buffer buf_place-attr for ub.place-attr .
     1171     do on error undo, return error return-value :
     1172        p-ok = false.
     1173        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1174                                                   and buf_place-attr.obj-code    = p-obj-code
     1175                                                   and buf_place-attr.obj-type    = p-obj-type
     1176                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1177        if not available buf_place-attr then do :
     1178           create buf_place-attr.
     1179           assign
     1180             buf_place-attr.attr-code   = p-code
     1181             buf_place-attr.attr-value  = p-value
     1182             buf_place-attr.obj-code    = p-obj-code
     1183             buf_place-attr.obj-type    = p-obj-type
     1184             buf_place-attr.pl-code     = p-pl-code
     1185           .
     1186           p-ok = true.
     1187        end.
     1188        else do:
     1189           buf_place-attr.attr-value  = p-value .
     1190           p-ok = true.
     1191        end.
     1192     end.
     1193   end.
     1194   procedure placelib_get-attr:
     1195   define input  parameter  p-code     like ub.place-attr.attr-code .
     1196   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1197   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1198   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1199   define output parameter  p-value    like ub.place-attr.attr-value .
     1200   define output parameter  p-ok       as logical.
     1201   define buffer buf_place-attr for ub.place-attr .
     1202     do on error undo, return error return-value :
     1203        p-ok = false.
     1204        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1205                                                   and buf_place-attr.obj-code    = p-obj-code
     1206                                                   and buf_place-attr.obj-type    = p-obj-type
     1207                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1208        if available buf_place-attr then do :
     1209          p-value = buf_place-attr.attr-value.
     1210          p-ok = true.
     1211        end.
     1212        else do :
     1213          p-ok = false.
     1214        end.
     1215     end.
     1216   end.
     1217   procedure placelib_del-attr:
     1218   define input parameter  p-code     like ub.place-attr.attr-code .
     1219   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1220   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1221   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1222   define input parameter  p-value    like ub.place-attr.attr-value .
     1223   define output parameter p-ok       as logical.
     1224   define buffer buf_place-attr for ub.place-attr .
     1225     do on error undo, return error return-value :
     1226        p-ok = false.
     1227        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1228                                                   and buf_place-attr.obj-code    = p-obj-code
     1229                                                   and buf_place-attr.obj-type    = p-obj-type
     1230                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1231        if available buf_place-attr then do :
     1232           delete buf_place-attr.
     1233           p-ok = true.
     1234        end.
     1235     end.
     1236   end.
