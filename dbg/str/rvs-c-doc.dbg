     1402   c-rvs-doc.measure-cli-qnty            at row 5 col 85.5 colon-aligned label "Измер.вес" view-as text
     1403   c-rvs-doc.agnt                        at row 6 col 4.5 colon-aligned format "999999999"  view-as fill-in size 10 by 1
     1404   agnt-name                         at row 6 col 15  colon-aligned no-label fgcolor 4
     1405   r-agnt                            at row 6 col 28  no-label
