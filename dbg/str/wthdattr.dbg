        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Редактирование атрибутов документа МЦ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure wthcattr-sprcli :
       66   define input parameter parparentproc  as widget-handle no-undo.
       67   define input parameter p-mode  as character no-undo.
       68   define input-output parameter p-value as character no-undo .
       69   define output parameter p-setted as logical no-undo .
       70     DEFINE VARIABLE v-value as character no-undo .
       71     define variable v-cli-type as character no-undo .
       72     define variable v-cli-code as integer no-undo .
       73     define buffer buf_clients   for ub.clients.
       74     define variable v_rid as character no-undo.
       75     define variable ref-rec as recid no-undo .
       76     do
       77     on error undo, return error
       78     :
       79         v-value = p-value.
       80      if p-value <> '':U then do:
       81       assign
       82       v-cli-type = substring(p-value, 1, 3)
       83       v-cli-code = integer(substring(p-value, 4))
       84       no-error.
       85       if error-status:error then do:
       86         assign
       87         v-cli-type = '':U
       88         v-cli-code = 0
       89         .
       90       end.
       91      end.
       92      FIND FIRST buf_clients NO-LOCK WHERE
       93               buf_clients.obj-type = v-cli-type AND
       94               buf_clients.obj-code = v-cli-code  NO-ERROR.
       95      IF available(buf_clients) then do:
       96       run ref/cli-all.w (
       97                   input parparentproc
       98                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
       99                  ,input v-cli-type
      100                  ,input 'все':U
      101                  ,input 'все':U
      102                  ,input RECID( buf_clients )
      103                  ,input ",,,,,,NO"
      104                  ,input ?
      105                  ,OUTPUT v_rid ).
      106     END.
      107     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      108       run ref/cli-all.w (
      109                    input parparentproc
      110                   ,INPUT "b-sel":U
      111                  ,input  v-cli-type
      112                  ,input 'все':U
      113                  ,input 'текущие':U
      114                  ,input ?
      115                  ,input ",,,,,,NO"
      116                  ,input ?
      117                  ,OUTPUT v_rid ).
      118     END.
      119     else do:
      120       message
      121       if p-value = "":U then 'Атрибут не задан!'
      122       else substitute('Не найден клиент &1',p-value)
      123       view-as alert-box warning.
      124     end.
      125     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      126       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      127       IF ERROR-STATUS:ERROR THEN DO:
      128           RETURN NO-APPLY.
      129       END.
      130       FIND FIRST buf_clients NO-LOCK WHERE
      131                  RECID( buf_clients ) = ref-rec NO-ERROR.
      132       IF AVAIL buf_clients THEN DO:
      133         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      134       end.
      135     end.
      136     if v-value <> p-value then do:
      137       p-value = v-value.
      138       p-setted = yes.
      139     end.
      140     end.
      141   end procedure.
      142     define new global shared variable g#wthcalib as handle no-undo.
      143   procedure proc-alt-shift-f2:
      144     if not ibs.th.gbl.gbl-var:rcode
      145   then
      146     run gbl\inidebug.p .
      147   end.
      148   procedure proc-alt-shift-f3:
      149     run gbl/prvssinf.p
      150       ( input this-procedure
      151       ) .
      152   end.
      153   define variable v-inform-launched as logical no-undo initial false .
      154   procedure proc-alt-shift-f4:
      155     define variable v-action as character no-undo .
      156     if v-inform-launched = false then do:
      157       assign
      158         v-inform-launched = true
      159       .
      160       run gbl/d-inform.w
      161         (  input self
      162         ,  input this-procedure
      163         , output v-action
      164         ) no-error .
      165       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      166       assign
      167         v-inform-launched = false
      168       .
      169     end.
      170   end.
      171   procedure proc-alt-f1:
      172     run gbl/corrhelp.p
      173       (input this-procedure
      174       ) .
      175   end .
      176   on alt-shift-f2 anywhere do:
      177     run proc-alt-shift-f2.
      178   end.
      179   on alt-shift-f3 anywhere do:
      180     run proc-alt-shift-f3 in this-procedure .
      181   end.
      182   on alt-shift-f4 anywhere do:
      183     run proc-alt-shift-f4 in this-procedure.
      184   end.
      185   on alt-f1 anywhere do:
      186     run proc-alt-f1 in this-procedure .
      187   end.
      188   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189   define temp-table tt-upd-attr no-undo
      190     field code           as character
      191     field type-attr      as character
      192     field format-attr    as character
      193     field fillin_width   as integer
      194     field fillin_height  as integer
      195     field label-attr     as character
      196     field user-can-edit  as logical
      197     field output-display as logical
      198     field hot-key        as character
      199     field can-select     as logical
      200     field other          as character
      201     field proc-attr      as character
      202     field proc-win       as character
      203     field proc-func      as character
      204     field full-screen-val as character
      205     field sort_       as integer
      206     index code is primary unique code
      207     index output-display output-display code
      208     index by-sort sort_
      209     .
      210   define temp-table tt-upd-attr-fuel no-undo
      211     field code           as character
      212     field type-attr      as character
      213     field format-attr    as character
      214     field fillin_width   as integer
      215     field fillin_height  as integer
      216     field label-attr     as character
      217     field user-can-edit  as logical
      218     field output-display as logical
      219     field hot-key        as character
      220     field can-select     as logical
      221     field other          as character
      222     field proc-attr      as character
      223     field proc-win       as character
      224     field proc-func      as character
      225     field full-screen-val as character
      226     field sort_       as integer
      227     index code is primary unique code
      228     index output-display output-display code
      229     index by-sort sort_
      230     .
      231   define input parameter parparentproc  as widget-handle no-undo.
      232   define input parameter parbtn as character no-undo.
      233   define input parameter pardoc-code like ub.wth-doc.doc-code no-undo.
      234   define input parameter table for tt-upd-attr .
      235   define variable varrec-id as recid no-undo.
      236   define variable v-no-news as logical   no-undo init false .
      237   DEFINE BUTTON b-add
      238        LABEL "&Добавить"
      239        SIZE 10 BY 1
      240        BGCOLOR 8 .
      241   DEFINE BUTTON b-chg
      242        LABEL "&Изменить"
      243        SIZE 10 BY 1
      244        BGCOLOR 8 .
      245   DEFINE BUTTON b-del
      246        LABEL "&Удалить"
      247        SIZE 10 BY 1
      248        BGCOLOR 8 .
      249   DEFINE BUTTON b-exit AUTO-GO
      250        LABEL "&Выход"
      251        SIZE 10 BY 1
      252        BGCOLOR 8 .
      253   DEFINE BUTTON b-help
      254        LABEL "&Помощь"
      255        SIZE 10 BY 1
      256        BGCOLOR 8 .
      257   DEFINE BUTTON b-lkp
      258        LABEL "&Просмотр"
      259        SIZE 10 BY 1
      260        BGCOLOR 8 .
      261   DEFINE QUERY b-doc-attr FOR
      262         ub.wth-doc-attr,
      263         tt-upd-attr SCROLLING.
      264   DEFINE BROWSE b-doc-attr
      265     QUERY b-doc-attr NO-LOCK DISPLAY
      266         tt-upd-attr.label-attr COLUMN-LABEL "Код" FORMAT "X(40)"
      267         ub.wth-doc-attr.attr-value COLUMN-LABEL "Значение" FORMAT "X(60)"
      268       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.63 BY 19.29.
      269   DEFINE FRAME Dialog-Frame
      270        b-exit AT ROW 1 COL 1
      271        b-add AT ROW 1 COL 11
      272        b-lkp AT ROW 1 COL 21
      273        b-chg AT ROW 1 COL 31
      274        b-del AT ROW 1 COL 41
      275        b-help AT ROW 1 COL 51
      276        b-doc-attr AT ROW 2.46 COL 1.75
      277        SPACE(0.00) SKIP(0.07)
      278       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      279            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      280            TITLE "Атрибуты документа МЦ"
      281            DEFAULT-BUTTON b-exit.
      282   ASSIGN
      283          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      284          FRAME Dialog-Frame:HIDDEN           = TRUE.
      285   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      286   DO:
      287     APPLY "END-ERROR":U TO SELF.
      288   END.
      289   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      290   DO:
      291     assign
      292       varrec-id = recid(ub.wth-doc-attr).
      293     run st-attr in this-procedure no-error.
      294     OPEN QUERY b-doc-attr FOR EACH ub.wth-doc-attr       WHERE ub.wth-doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.wth-doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  NO-LOCK .
      295     if varrec-id <> ? then reposition b-doc-attr to recid varrec-id.
      296   end.
      297   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      298   DO:
      299   define variable vartemp-char as character  no-undo.
      300   DEFINE VARIABLE v-spr as character no-undo .
      301   define variable jj as integer no-undo .
      302   DEFINE VARIABLE v-setted as logical no-undo .
      303   if available tt-upd-attr then do:
      304     if tt-upd-attr.user-can-edit then do:
      305       do jj = 1 to num-entries(tt-upd-attr.other, chr(47)):
      306       if entry(1, entry(jj, tt-upd-attr.other, chr(47)), "=":U) = "spr":U
      307       then do:
      308         assign
      309         v-spr = string(entry(2, entry(jj, tt-upd-attr.other, chr(47)), "=":U))
      310         .
      311         end.
      312       end.
      313       assign
      314           vartemp-char = ub.wth-doc-attr.attr-value.
      315       if v-spr = "":u then do:
      316         run gbl/d-prompt.w (
      317            'title=':u + 'Изменение атрибутов документа' + '\':u
      318           + 'text1=':u + tt-upd-attr.label-attr + '\':u
      319           + 'format=' + tt-upd-attr.format-attr + '\':u
      320           + 'type=' + tt-upd-attr.type-attr + '\':u
      321           + 'fillin_row=2\':u
      322           + 'fillin_col=4\':u
      323           + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      324           + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      325           + 'max-chars=70\':u
      326           + 'readonly=' + 'no':u + '\':u
      327           , input-output vartemp-char
      328           ) no-error.
      329           if error-status:error then do:
      330               message "Ошибка при изменении атрибута." skip
      331                       return-value skip
      332                       error-status:get-message(1) view-as alert-box error.
      333               return no-apply.
      334           end.
      335           if return-value = 'false':u then do:
      336             return no-apply.
      337           end.
      338        end.
      339        else do:
      340         run  value(v-spr) in this-procedure (
      341                                             input parparentproc
      342                                             ,input 'ИЗМЕНЕНИЕ':U
      343                                             ,input-output vartemp-char
      344                                             ,output v-setted) no-error .
      345         if not v-setted then return.
      346        end.
      347   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-wrt in g#wthcalib ( input ub.wth-doc-attr.doc-code ,
      348                          input ub.wth-doc-attr.attr-code ,
      349                          input vartemp-char ) no-error .
      350        if error-status :error then do:
      351          message "Ошибка при сохранении атрибута." view-as alert-box.
      352          undo, return no-apply.
      353        end.
      354        assign
      355          varrec-id = recid(ub.wth-doc-attr).
      356        if not v-no-news  then do:
      357   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-oth in g#wthcalib ( input ub.wth-doc-attr.doc-code ,
      358                          input ub.wth-doc-attr.attr-code ,
      359                          input vartemp-char ) no-error .
      360             if error-status :error then do:
      361               message "Ошибка при обработке атрибута." view-as alert-box.
      362               undo, return no-apply.
      363             end.
      364        end.
      365        OPEN QUERY b-doc-attr FOR EACH ub.wth-doc-attr       WHERE ub.wth-doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.wth-doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  NO-LOCK .
      366        reposition b-doc-attr to recid varrec-id.
      367     end.
      368     else do:
      369        message "Атрибут " tt-upd-attr.label-attr " не редактируется в данном интерфейсе."
      370        view-as alert-box.
      371        return no-apply.
      372     end.
      373   end.
      374   END.
      375   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      376   DO:
      377   define variable varg-log  as logical no-undo.
      378   define variable v-deleted as logical no-undo.
      379   define variable vartemp-char as character  no-undo.
      380   do on error undo, return no-apply :
      381   if available tt-upd-attr then do:
      382     message "Вы хотите удалить атрибут " tt-upd-attr.label-attr " ?" view-as alert-box
      383     question buttons yes-no update varg-log.
      384     if varg-log then do:
      385   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-del in g#wthcalib (  input ub.wth-doc-attr.doc-code ,
      386                           input ub.wth-doc-attr.attr-code ,
      387                          output v-deleted ) no-error .
      388       if error-status :error then do:
      389         message "Ошибка при удалении атрибута." skip
      390         return-value skip
      391         error-status:get-message(1)
      392         view-as alert-box.
      393         undo, return no-apply.
      394       end.
      395       if not v-no-news  then do:
      396   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-oth in g#wthcalib ( input ub.wth-doc-attr.doc-code ,
      397                          input ub.wth-doc-attr.attr-code ,
      398                          input vartemp-char ) no-error .
      399             if error-status :error then do:
      400               message "Ошибка при обработке атрибута." view-as alert-box.
      401               undo, return no-apply.
      402             end.
      403        end.
      404       OPEN QUERY b-doc-attr FOR EACH ub.wth-doc-attr       WHERE ub.wth-doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.wth-doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  NO-LOCK .
      405     end.
      406   end.
      407   end.
      408   END.
      409   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      410   DO:
      411   define variable vartemp-char as character  no-undo.
      412   DEFINE VARIABLE v-spr as character no-undo .
      413   define variable jj as integer no-undo .
      414   DEFINE VARIABLE v-setted as logical no-undo .
      415   if available tt-upd-attr then do:
      416       do jj = 1 to num-entries(tt-upd-attr.other, chr(47)):
      417       if entry(1, entry(jj, tt-upd-attr.other, chr(47)), "=":U) = "spr":U
      418       then do:
      419         assign
      420         v-spr = string(entry(2, entry(jj, tt-upd-attr.other, chr(47)), "=":U))
      421         .
      422         end.
      423       end.
      424       assign
      425           vartemp-char = ub.wth-doc-attr.attr-value.
      426       if v-spr = "":u then do:
      427           assign
      428           vartemp-char = ub.wth-doc-attr.attr-value.
      429           run gbl/d-prompt.w (
      430                 'title=':u + 'Изменение атрибутов документа' + '\':u
      431               + 'text1=':u + tt-upd-attr.label-attr + '\':u
      432               + 'format=' + tt-upd-attr.format-attr + '\':u
      433               + 'type=' + tt-upd-attr.type-attr + '\':u
      434               + 'fillin_row=2\':u
      435               + 'fillin_col=4\':u
      436               + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      437               + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      438               + 'max-chars=70\':u
      439               + 'readonly=' + 'yes':u + '\':u
      440               , input-output vartemp-char
      441               ) no-error.
      442        end.
      443        else do:
      444         run  value(v-spr) in this-procedure (
      445                                             input parparentproc
      446                                             ,input 'ПРОСМОТР':U
      447                                             ,input-output vartemp-char
      448                                             ,output v-setted) no-error .
      449        end.
      450   end.
      451   end.
      452   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      453   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      454   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   on help of frame Dialog-Frame
      456   do:
      457     run gbl/app_help.p
      458       (input this-procedure :file-name
      459       ,input ''
      460       ,input ?
      461       ) no-error.
      462     if error-status :error then do:
      463       message
      464         "Ошибка при вызове помощи"
      465         error-status :get-message(1)
      466         view-as alert-box .
      467     end.
      468   end.
      469   run minbtn-set in this-procedure .
      470   on choose of b-help in frame Dialog-Frame
      471   do:
      472     apply "help":u to frame Dialog-Frame .
      473   end.
      474   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   procedure minbtn-set :
      476       do
      477           on error undo, return error return-value
      478           :
      479           define variable ii              as integer       no-undo .
      480           define variable fh              as widget-handle no-undo .
      481           define variable hh              as widget-handle no-undo .
      482           define variable v-h             as handle        extent 4 no-undo .
      483           define variable v-name-button   as character     no-undo .
      484           define variable v-help-old-x    as decimal       no-undo .
      485           define variable v-help-old-y    as decimal       no-undo .
      486           define variable v-help-old-size as decimal       no-undo .
      487           define variable v-frame-width   as decimal       no-undo .
      488           define variable jj              as integer       no-undo .
      489           do
      490               on error undo, return error
      491               :
      492               assign
      493                   v-frame-width = frame Dialog-Frame:width - 0.3
      494                   fh            = frame Dialog-Frame:first-child
      495                   hh            = fh:first-child
      496                   ii            = 1
      497                   .
      498               do while valid-handle(hh):
      499                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      500                   do:
      501                       case lc(hh:name) :
      502                           when "b-help" then
      503                               do:
      504                                   hh:load-image-up("cmp/b-help.bmp":u) .
      505                                   hh:load-image-down("cmp/b-help.bmp":u) .
      506                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      507                                   hh:TOOLTIP = "Помощь" .
      508                                   v-help-old-x = hh:column .
      509                                   v-help-old-y = hh:row    .
      510                                   v-help-old-size = hh:width .
      511                                   hh:width-chars = 2.5 .
      512                               end.
      513                           when "b-print" then
      514                               do:
      515                                   hh:load-image("cmp/b-print.bmp":u) .
      516                                   hh:TOOLTIP = "Печать" .
      517                                   v-h[ii] = hh:handle .
      518                                   ii = ii + 1 .
      519                                   hh:width-chars = 3 .
      520                               end.
      521                           when "b-history" or
      522                           when "b-hist" then
      523                               do:
      524                                   hh:load-image("cmp/b-hist.bmp":u) .
      525                                   hh:TOOLTIP = "История" .
      526                                   v-h[ii] = hh:handle .
      527                                   ii = ii + 1 .
      528                                   hh:width-chars = 3 .
      529                               end.
      530                           when "b-sch" then
      531                               do:
      532                                   hh:load-image("cmp/b-sch.bmp":u) .
      533                                   hh:TOOLTIP = "Установка Фильтра" .
      534                                   v-h[ii] = hh:handle .
      535                                   ii = ii + 1 .
      536                                   hh:width-chars = 3 .
      537                               end.
      538                           when "b-hist-user" then
      539                               do:
      540                                   hh:load-image("cmp/b-hist.bmp":u) .
      541                                   hh:TOOLTIP = "История пользователя" .
      542                                   ii = ii + 1 .
      543                               end.
      544                       end case.
      545                   end.
      546                   hh = hh:next-sibling.
      547               end.
      548               b-help:column = v-frame-width - b-help:width-chars.
      549               jj = 0.
      550               repeat ii = 4 to 1 by -1 :
      551                   if valid-handle (v-h[ii] ) then
      552                   do:
      553                       jj  = jj + 1 .
      554                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      555                       v-h[ii]:row    = v-help-old-y .
      556                   end.
      557               end.
      558           end.
      559       end.
      560   end procedure.
      561   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      562   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      563   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      564   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      565   define variable v-diasize-current-frame-width  as decimal   no-undo .
      566   define variable v-diasize-current-frame-height as decimal   no-undo .
      567   define variable v-diasize-change-size          as logical   no-undo .
      568   define variable v-diasize-resize-button        as handle    no-undo .
      569   define variable v-diasize-wndmax               as logical   no-undo .
      570   define variable v-diasize-wndstore             as logical   no-undo .
      571   define variable v-diasize-proc-name            as character no-undo .
      572   define variable v-diasize-browse-handle        as handle    no-undo .
      573   define variable v-diasize-browse-number        as integer   no-undo .
      574   define variable v-diasize-need-full-display    as logical   no-undo init false .
      575   define temp-table temp-diasize-handle no-undo
      576     field handle-value  as handle
      577     field save-position as decimal
      578     index xpk is primary unique handle-value
      579     .
      580   define temp-table temp-browse-handle no-undo
      581     field browse-type   as character
      582     field browse-number as integer
      583     field browse-handle as handle
      584     field original-size as decimal
      585     index xpk is primary unique browse-type browse-number
      586     index xie browse-type browse-handle
      587   .
      588   procedure diasize_change-height :
      589     define input  parameter p-change-value  as decimal   no-undo .
      590     define input  parameter p-move-resize   as logical   no-undo .
      591     define variable v-field-group-handle    as handle    no-undo .
      592     define variable v-object-handle         as handle    no-undo .
      593     define variable v-frame-height          as decimal   no-undo .
      594     define variable v-frame-virtual-height  as decimal   no-undo .
      595     define variable v-browse-height         as decimal   no-undo .
      596     define variable v-window-height         as decimal   no-undo .
      597     define variable v-window-virtual-height as decimal   no-undo .
      598     define variable v-change-sign           as integer   no-undo .
      599     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      600     define buffer buf_temp-browse-handle  for temp-browse-handle .
      601     if p-change-value > 0
      602     then do:
      603       if frame Dialog-Frame :height + p-change-value
      604           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      605       then do:
      606         assign
      607           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      608                           - (frame Dialog-Frame :height-chars)
      609         .
      610         if p-change-value <= 0
      611         then do:
      612           run diasize_position-resize-button in this-procedure .
      613           return .
      614         end.
      615       end.
      616     end.
      617     if p-change-value < 0
      618     then do:
      619       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      620       then do:
      621         assign
      622           p-change-value = v-diasize-orig-frame-height
      623                          - (frame Dialog-Frame :height-chars)
      624         .
      625         if p-change-value >= 0
      626         then do:
      627           run diasize_position-resize-button in this-procedure .
      628           return .
      629         end.
      630       end.
      631     end.
      632     if p-change-value >= 0
      633     then do:
      634       assign
      635         v-change-sign = 1
      636       .
      637     end.
      638     else do:
      639       assign
      640         v-change-sign = -1
      641       .
      642     end.
      643     assign
      644       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      645     .
      646     if p-change-value = 0
      647     then do:
      648       run diasize_position-resize-button in this-procedure .
      649       return .
      650     end.
      651     move_block:
      652     do
      653     on error undo move_block, retry move_block
      654     :
      655       if retry
      656       then do:
      657         do
      658         on error undo move_block, leave move_block
      659         :
      660           if p-change-value > 0
      661           then do:
      662             for each buf_temp-diasize-handle
      663             on error undo, next
      664             :
      665               assign
      666                 v-object-handle = buf_temp-diasize-handle.handle-value
      667               .
      668               if v-object-handle <> v-diasize-resize-button
      669               then do:
      670                 assign
      671                   v-object-handle :row = buf_temp-diasize-handle.save-position
      672                 .
      673               end.
      674             end.
      675             assign
      676               v-diasize-browse-handle :height = v-browse-height
      677             .
      678             for each buf_temp-browse-handle
      679               where buf_temp-browse-handle.browse-type = 'height':u
      680             on error undo, next
      681             :
      682               assign
      683                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      684               .
      685             end.
      686             assign
      687               frame Dialog-Frame :height = v-frame-height
      688             .
      689             if frame Dialog-Frame :scrollable = true
      690             then do:
      691               assign
      692                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      693               .
      694             end.
      695             run diasize_position-resize-button in this-procedure .
      696           end.
      697           else do:
      698             if frame Dialog-Frame :scrollable = true
      699             then do:
      700               assign
      701                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      702               .
      703             end.
      704             assign
      705               frame Dialog-Frame :height = v-frame-height
      706             .
      707             assign
      708               v-diasize-browse-handle :height = v-browse-height
      709             .
      710             for each buf_temp-browse-handle
      711               where buf_temp-browse-handle.browse-type = 'height':u
      712             on error undo, next
      713             :
      714               assign
      715                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      716               .
      717             end.
      718             for each buf_temp-diasize-handle
      719             on error undo, next
      720             :
      721               assign
      722                 v-object-handle = buf_temp-diasize-handle.handle-value
      723               .
      724               if v-object-handle <> v-diasize-resize-button
      725               then do:
      726                 assign
      727                   v-object-handle :row = buf_temp-diasize-handle.save-position
      728                 .
      729               end.
      730             end.
      731             run diasize_position-resize-button in this-procedure .
      732           end.
      733           assign
      734             v-diasize-change-size = false
      735           .
      736           leave move_block .
      737         end.
      738       end.
      739       assign
      740         v-diasize-need-full-display = true
      741       .
      742       if v-diasize-change-size = false
      743       then do:
      744         assign
      745           v-diasize-change-size = true
      746         .
      747       end.
      748       else do:
      749         return .
      750       end.
      751       assign
      752         v-frame-height = frame Dialog-Frame :height
      753         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      754         v-browse-height = v-diasize-browse-handle :height
      755       .
      756       for each buf_temp-browse-handle
      757         where buf_temp-browse-handle.browse-type = 'height':u
      758       :
      759         assign
      760           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      761         .
      762       end.
      763       for each buf_temp-diasize-handle
      764       :
      765         delete buf_temp-diasize-handle .
      766       end.
      767       assign
      768         v-field-group-handle = frame Dialog-Frame :first-child
      769       .
      770       do while valid-handle(v-field-group-handle)
      771       :
      772         assign
      773           v-object-handle = v-field-group-handle :first-child
      774         .
      775         do while valid-handle(v-object-handle)
      776         :
      777           if  v-object-handle <> v-diasize-browse-handle :handle
      778           and can-query(v-object-handle, "row")
      779           and can-query(v-object-handle, "height")
      780           and ( v-object-handle :row > v-diasize-browse-handle :row )
      781           then do:
      782             find first buf_temp-browse-handle
      783               where buf_temp-browse-handle.browse-type   = 'height':u
      784                 and buf_temp-browse-handle.browse-handle = v-object-handle
      785               no-error .
      786             if available buf_temp-browse-handle
      787             then do:
      788             end.
      789             else do:
      790               create buf_temp-diasize-handle .
      791               assign
      792                 buf_temp-diasize-handle.handle-value  = v-object-handle
      793                 buf_temp-diasize-handle.save-position = v-object-handle :row
      794               .
      795             end.
      796           end.
      797           assign
      798             v-object-handle = v-object-handle :next-sibling
      799           .
      800         end.
      801         assign
      802           v-field-group-handle = v-field-group-handle :next-sibling
      803         .
      804       end.
      805       do with frame Dialog-Frame
      806       :
      807         hide v-diasize-resize-button .
      808         assign
      809           v-diasize-resize-button :row    = 1
      810           v-diasize-resize-button :column = 1
      811         .
      812       end.
      813       if p-change-value > 0
      814       then do:
      815         if frame Dialog-Frame :scrollable = true
      816         then do:
      817           assign
      818             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      819             no-error .
      820           if error-status :error
      821           or error-status :get-message(1) <> ""
      822           then do:
      823             undo move_block, retry move_block .
      824           end.
      825         end.
      826         assign
      827           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      828           no-error .
      829         if error-status :error
      830         or error-status :get-message(1) <> ""
      831         then do:
      832           undo move_block, retry move_block .
      833         end.
      834         assign
      835           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      836           no-error .
      837         if error-status :error
      838         or error-status :get-message(1) <> ""
      839         then do:
      840           undo move_block, retry move_block .
      841         end.
      842         for each buf_temp-browse-handle
      843           where buf_temp-browse-handle.browse-type = 'height':u
      844         on error undo move_block, retry move_block
      845         :
      846           assign
      847             buf_temp-browse-handle.browse-handle :height
      848               = buf_temp-browse-handle.browse-handle :height + p-change-value
      849             no-error .
      850           if error-status :error
      851           or error-status :get-message(1) <> ""
      852           then do:
      853             undo move_block, retry move_block .
      854           end.
      855         end.
      856         for each buf_temp-diasize-handle
      857         on error undo move_block, retry move_block
      858         :
      859           assign
      860             v-object-handle = buf_temp-diasize-handle.handle-value
      861           .
      862           if v-object-handle <> v-diasize-resize-button
      863           then do:
      864             assign
      865               v-object-handle :row = v-object-handle :row + p-change-value
      866               no-error .
      867             if error-status :error
      868             or error-status :get-message(1) <> ""
      869             then do:
      870               undo move_block, retry move_block .
      871             end.
      872           end.
      873         end.
      874       end.
      875       else do:
      876         for each buf_temp-diasize-handle
      877         on error undo move_block, retry move_block
      878         :
      879           assign
      880             v-object-handle = buf_temp-diasize-handle.handle-value
      881           .
      882           if v-object-handle <> v-diasize-resize-button
      883           then do:
      884             assign
      885               v-object-handle :row = v-object-handle :row + p-change-value
      886               no-error .
      887             if error-status :error
      888             or error-status :get-message(1) <> ""
      889             then do:
      890               undo move_block, retry move_block .
      891             end.
      892           end.
      893         end.
      894         assign
      895           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      896           no-error .
      897         if error-status :error
      898         or error-status :get-message(1) <> ""
      899         then do:
      900           undo move_block, retry move_block .
      901         end.
      902         for each buf_temp-browse-handle
      903           where buf_temp-browse-handle.browse-type = 'height':u
      904         on error undo move_block, retry move_block
      905         :
      906           assign
      907             buf_temp-browse-handle.browse-handle :height
      908               = buf_temp-browse-handle.browse-handle :height + p-change-value
      909             no-error .
      910           if error-status :error
      911           or error-status :get-message(1) <> ""
      912           then do:
      913             undo move_block, retry move_block .
      914           end.
      915         end.
      916         assign
      917           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      918           no-error .
      919         if error-status :error
      920         or error-status :get-message(1) <> ""
      921         then do:
      922           undo move_block, retry move_block .
      923         end.
      924         if frame Dialog-Frame :scrollable = true
      925         then do:
      926           assign
      927             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      928             no-error .
      929           if error-status :error
      930           or error-status :get-message(1) <> ""
      931           then do:
      932             undo move_block, retry move_block .
      933           end.
      934         end.
      935       end.
      936       if p-move-resize = true
      937       then do:
      938         run diasize_position-resize-button in this-procedure .
      939       end.
      940       if v-diasize-wndstore = true
      941       then do:
      942         if connected("ub") = true
      943         then do:
      944           define variable v-cntxt-db-num        as integer   no-undo .
      945           define variable v-cntxt-userid        as character no-undo .
      946           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      947                                             , OUTPUT v-cntxt-userid
      948                                             ) .
      949           run gbl/wndsizew.p
      950             (input  v-cntxt-db-num
      951             ,input  v-cntxt-userid
      952             ,input  v-diasize-proc-name
      953             ,input  'height':u
      954             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      955             ) .
      956         end.
      957       end.
      958     end.
      959     assign
      960       v-diasize-change-size = false
      961     .
      962   end procedure.
      963   procedure diasize_set-height :
      964     define input  parameter p-new-height  as decimal   no-undo .
      965     define input  parameter p-move-resize as logical   no-undo .
      966     do
      967     on error undo, return error return-value
      968     :
      969       run diasize_change-height in this-procedure
      970         (input  (p-new-height - frame Dialog-Frame :height)
      971         ,input  p-move-resize
      972         ) .
      973     end.
      974   end procedure.
      975   procedure diasize_change-width :
      976     define input  parameter p-change-value as decimal   no-undo .
      977     define input  parameter p-move-resize  as logical   no-undo .
      978     define variable v-field-group-handle   as handle    no-undo .
      979     define variable v-object-handle        as handle    no-undo .
      980     define variable v-frame-width          as decimal   no-undo .
      981     define variable v-frame-virtual-width  as decimal   no-undo .
      982     define variable v-browse-width         as decimal   no-undo .
      983     define variable v-window-width         as decimal   no-undo .
      984     define variable v-window-virtual-width as decimal   no-undo .
      985     define variable v-change-sign          as integer   no-undo .
      986     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      987     define buffer buf_temp-browse-handle  for temp-browse-handle .
      988     if p-change-value > 0
      989     then do:
      990       if frame Dialog-Frame :width + p-change-value >
      991           session :width-chars
      992       then do:
      993         assign
      994           p-change-value = session :width-chars - frame Dialog-Frame :width
      995         .
      996         if p-change-value <= 0
      997         then do:
      998           run diasize_position-resize-button in this-procedure .
      999           return .
     1000         end.
     1001       end.
     1002     end.
     1003     if p-change-value < 0
     1004     then do:
     1005       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1006       then do:
     1007         assign
     1008           p-change-value = v-diasize-orig-frame-width
     1009                          - frame Dialog-Frame :width
     1010         .
     1011         if p-change-value >= 0
     1012         then do:
     1013           run diasize_position-resize-button in this-procedure .
     1014           return .
     1015         end.
     1016       end.
     1017     end.
     1018     if p-change-value >= 0
     1019     then do:
     1020       assign
     1021         v-change-sign = 1
     1022       .
     1023     end.
     1024     else do:
     1025       assign
     1026         v-change-sign = -1
     1027       .
     1028     end.
     1029     assign
     1030       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1031     .
     1032     if p-change-value = 0
     1033     then do:
     1034       run diasize_position-resize-button in this-procedure .
     1035       return .
     1036     end.
     1037     move_block:
     1038     do
     1039     on error undo move_block, leave move_block
     1040     :
     1041       if retry
     1042       then do:
     1043         do
     1044         on error undo move_block, leave move_block
     1045         :
     1046           if p-change-value > 0
     1047           then do:
     1048             for each buf_temp-diasize-handle
     1049             on error undo, next
     1050             :
     1051               assign
     1052                 v-object-handle = buf_temp-diasize-handle.handle-value
     1053               .
     1054               if v-object-handle <> v-diasize-resize-button
     1055               then do:
     1056                 assign
     1057                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1058                 .
     1059               end.
     1060             end.
     1061             assign
     1062               v-diasize-browse-handle :width = v-browse-width
     1063             .
     1064             for each buf_temp-browse-handle
     1065               where buf_temp-browse-handle.browse-type = 'width':u
     1066             on error undo, next
     1067             :
     1068               assign
     1069                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1070               .
     1071             end.
     1072             assign
     1073               frame Dialog-Frame :width = v-frame-width
     1074             .
     1075             if frame Dialog-Frame :scrollable = true
     1076             then do:
     1077               assign
     1078                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1079               .
     1080             end.
     1081             run diasize_position-resize-button in this-procedure .
     1082           end.
     1083           else do:
     1084             if frame Dialog-Frame :scrollable = true
     1085             then do:
     1086               assign
     1087                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1088               .
     1089             end.
     1090             assign
     1091               frame Dialog-Frame :width = v-frame-width
     1092             .
     1093             for each buf_temp-browse-handle
     1094               where buf_temp-browse-handle.browse-type = 'width':u
     1095             on error undo, next
     1096             :
     1097               assign
     1098                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1099               .
     1100             end.
     1101             assign
     1102               v-diasize-browse-handle :width = v-browse-width
     1103             .
     1104             for each buf_temp-diasize-handle
     1105             on error undo, next
     1106             :
     1107               assign
     1108                 v-object-handle = buf_temp-diasize-handle.handle-value
     1109               .
     1110               if v-object-handle <> v-diasize-resize-button
     1111               then do:
     1112                 assign
     1113                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1114                 .
     1115               end.
     1116             end.
     1117             run diasize_position-resize-button in this-procedure .
     1118           end.
     1119           assign
     1120             v-diasize-change-size = false
     1121           .
     1122           leave move_block .
     1123         end.
     1124       end.
     1125       assign
     1126         v-diasize-need-full-display = true
     1127       .
     1128       if v-diasize-change-size = false
     1129       then do:
     1130         assign
     1131           v-diasize-change-size = true
     1132         .
     1133       end.
     1134       else do:
     1135         return .
     1136       end.
     1137       assign
     1138         v-frame-width = frame Dialog-Frame :width
     1139         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1140         v-browse-width = v-diasize-browse-handle :width
     1141       .
     1142       for each buf_temp-browse-handle
     1143         where buf_temp-browse-handle.browse-type = 'width':u
     1144       :
     1145         assign
     1146           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1147         .
     1148       end.
     1149       for each buf_temp-diasize-handle
     1150       :
     1151         delete buf_temp-diasize-handle .
     1152       end.
     1153       assign
     1154         v-field-group-handle = frame Dialog-Frame :first-child
     1155       .
     1156       do while valid-handle(v-field-group-handle)
     1157       :
     1158         assign
     1159           v-object-handle = v-field-group-handle :first-child
     1160         .
     1161         do while valid-handle(v-object-handle)
     1162         :
     1163           if  v-object-handle <> v-diasize-browse-handle :handle
     1164           and v-object-handle <> v-diasize-resize-button
     1165           and can-query(v-object-handle, "row")
     1166           and can-query(v-object-handle, "height")
     1167           and ( v-object-handle :col + v-object-handle :width
     1168                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1169               )
     1170           then do:
     1171             find first buf_temp-browse-handle
     1172               where buf_temp-browse-handle.browse-type   = 'width':u
     1173                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1174               no-error .
     1175             if available buf_temp-browse-handle
     1176             then do:
     1177             end.
     1178             else do:
     1179               create buf_temp-diasize-handle .
     1180               assign
     1181                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1182                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1183               .
     1184             end.
     1185           end.
     1186           assign
     1187             v-object-handle = v-object-handle :next-sibling
     1188           .
     1189         end.
     1190         assign
     1191           v-field-group-handle = v-field-group-handle :next-sibling
     1192         .
     1193       end.
     1194       do with frame Dialog-Frame
     1195       :
     1196         hide v-diasize-resize-button .
     1197         v-diasize-resize-button :row = 1.
     1198         v-diasize-resize-button :column = 1.
     1199       end.
     1200       if p-change-value > 0
     1201       then do:
     1202         if frame Dialog-Frame :scrollable = true
     1203         then do:
     1204           assign
     1205             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1206             no-error .
     1207           if error-status :error
     1208           or error-status :get-message(1) <> ""
     1209           then do:
     1210             undo move_block, retry move_block.
     1211           end.
     1212         end.
     1213         assign
     1214           frame Dialog-Frame :width = v-frame-width + p-change-value
     1215           no-error .
     1216         if error-status :error
     1217         or error-status :get-message(1) <> ""
     1218         then do:
     1219           undo move_block, retry move_block.
     1220         end.
     1221         assign
     1222           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1223         no-error .
     1224         if error-status :error
     1225         or error-status :get-message(1) <> ""
     1226         then do:
     1227           undo move_block, retry move_block.
     1228         end.
     1229         for each buf_temp-browse-handle
     1230           where buf_temp-browse-handle.browse-type = 'width':u
     1231         on error undo move_block, retry move_block
     1232         :
     1233           assign
     1234             buf_temp-browse-handle.browse-handle :width
     1235               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1236             no-error .
     1237           if error-status :error
     1238           or error-status :get-message(1) <> ""
     1239           then do:
     1240             undo move_block, retry move_block .
     1241           end.
     1242         end.
     1243         for each buf_temp-diasize-handle
     1244         on error undo move_block, retry move_block
     1245         :
     1246           assign
     1247             v-object-handle = buf_temp-diasize-handle.handle-value
     1248           .
     1249           if v-object-handle <> v-diasize-resize-button
     1250           then do:
     1251             assign
     1252               v-object-handle :col = v-object-handle :col + p-change-value
     1253               no-error .
     1254             if error-status :error
     1255             or error-status :get-message(1) <> ""
     1256             then do:
     1257               undo move_block, retry move_block .
     1258             end.
     1259           end.
     1260         end.
     1261       end.
     1262       else do:
     1263         for each buf_temp-diasize-handle
     1264         on error undo move_block, retry move_block
     1265         :
     1266           assign
     1267             v-object-handle = buf_temp-diasize-handle.handle-value
     1268           .
     1269           if v-object-handle <> v-diasize-resize-button
     1270           then do:
     1271             assign
     1272               v-object-handle :col = v-object-handle :col + p-change-value
     1273               no-error .
     1274             if error-status :error
     1275             or error-status :get-message(1) <> ""
     1276             then do:
     1277               undo move_block, retry move_block .
     1278             end.
     1279           end.
     1280         end.
     1281         for each buf_temp-browse-handle
     1282           where buf_temp-browse-handle.browse-type = 'width':u
     1283         on error undo move_block, retry move_block
     1284         :
     1285           assign
     1286             buf_temp-browse-handle.browse-handle :width
     1287               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1288             no-error .
     1289           if error-status :error
     1290           or error-status :get-message(1) <> ""
     1291           then do:
     1292             undo move_block, retry move_block .
     1293           end.
     1294         end.
     1295         assign
     1296           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1297           no-error .
     1298         if error-status :error
     1299         or error-status :get-message(1) <> ""
     1300         then do:
     1301           undo move_block, retry move_block.
     1302         end.
     1303         assign
     1304           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1305         no-error .
     1306         if error-status :error
     1307         or error-status :get-message(1) <> ""
     1308         then do:
     1309           undo move_block, retry move_block.
     1310         end.
     1311         if frame Dialog-Frame :scrollable = true
     1312         then do:
     1313           assign
     1314             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1315           no-error .
     1316           if error-status :error
     1317           or error-status :get-message(1) <> ""
     1318           then do:
     1319             undo move_block, retry move_block.
     1320           end.
     1321         end.
     1322       end.
     1323       if p-move-resize
     1324       then do:
     1325         run diasize_position-resize-button in this-procedure .
     1326       end.
     1327       if v-diasize-wndstore = true
     1328       then do:
     1329         if connected("ub") = true
     1330         then do:
     1331           define variable v-cntxt-db-num        as integer   no-undo .
     1332           define variable v-cntxt-userid        as character no-undo .
     1333           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1334                                             , OUTPUT v-cntxt-userid
     1335                                             ) .
     1336           run gbl/wndsizew.p
     1337             (input  v-cntxt-db-num
     1338             ,input  v-cntxt-userid
     1339             ,input  v-diasize-proc-name
     1340             ,input  'width':u
     1341             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1342             ) .
     1343         end.
     1344       end.
     1345     end.
     1346     assign
     1347       v-diasize-change-size = false
     1348     .
     1349   end procedure.
     1350   procedure diasize_set-width :
     1351     define input  parameter p-new-width  as decimal   no-undo .
     1352     define input  parameter p-move-resize as logical   no-undo .
     1353     do
     1354     on error undo, return error return-value
     1355     :
     1356       run diasize_change-width in this-procedure
     1357         (input  (p-new-width - frame Dialog-Frame :width)
     1358         ,input  p-move-resize
     1359         ) .
     1360     end.
     1361   end procedure.
     1362   procedure diasize_position-resize-button :
     1363     do with frame Dialog-Frame
     1364     :
     1365       hide v-diasize-resize-button .
     1366       assign
     1367         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1368                     - 1
     1369                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1370         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1371                     - 1
     1372                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1373       .
     1374       view v-diasize-resize-button .
     1375     end.
     1376   end procedure.
     1377   on alt-right anywhere
     1378   do:
     1379     run diasize_change-width in this-procedure
     1380       (input 1
     1381       ,input true
     1382       ) .
     1383     return no-apply .
     1384   end.
     1385   on alt-left anywhere
     1386   do:
     1387     run diasize_change-width in this-procedure
     1388       (input -1
     1389       ,input true
     1390       ) .
     1391     return no-apply .
     1392   end.
     1393   on alt-down anywhere
     1394   do:
     1395     run diasize_change-height in this-procedure
     1396       (input 1
     1397       ,input true
     1398       ) .
     1399     return no-apply .
     1400   end.
     1401   on alt-up anywhere
     1402   do:
     1403     run diasize_change-height in this-procedure
     1404       (input -1
     1405       ,input true
     1406       ) .
     1407     return no-apply .
     1408   end.
     1409   on alt-enter of frame Dialog-Frame
     1410   do:
     1411     run diasize_maximize in this-procedure
     1412       (input  ?
     1413       ).
     1414     return no-apply .
     1415   end.
     1416   procedure diasize_end-move :
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       define variable v-row-delta as decimal   no-undo .
     1421       define variable v-col-delta as decimal   no-undo .
     1422       define variable v-new-row as decimal   no-undo .
     1423       define variable v-new-col as decimal   no-undo .
     1424       assign
     1425         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1426         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1427       .
     1428       assign
     1429         v-row-delta = v-new-row - frame Dialog-Frame :height
     1430         v-col-delta = v-new-col - frame Dialog-Frame :width
     1431       .
     1432       run diasize_change-height in this-procedure
     1433         (input v-row-delta
     1434         ,input true
     1435         ) .
     1436       run diasize_change-width in this-procedure
     1437         (input v-col-delta
     1438         ,input true
     1439         ) .
     1440     end.
     1441   end procedure.
     1442   procedure diasize_maximize :
     1443     define input  parameter p-action as logical   no-undo .
     1444     do
     1445     on error undo, return error return-value
     1446     :
     1447       if p-action = ?
     1448       then do:
     1449         if v-diasize-need-maximize = true
     1450         then do:
     1451           assign
     1452             p-action = true
     1453           .
     1454         end.
     1455         else do:
     1456           assign
     1457             p-action = false
     1458           .
     1459         end.
     1460       end.
     1461       if p-action = true
     1462       then do:
     1463         run diasize_change-height in this-procedure
     1464           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1465               - frame Dialog-Frame :height-chars
     1466           ,input true
     1467           ) .
     1468         run diasize_change-width in this-procedure
     1469           (input session :width-chars
     1470               - frame Dialog-Frame :width-chars
     1471           ,input true
     1472           ) .
     1473         assign
     1474           v-diasize-need-maximize = false
     1475         .
     1476       end.
     1477       else do:
     1478         run diasize_change-width in this-procedure
     1479           (input v-diasize-orig-frame-width
     1480               - frame Dialog-Frame :width-chars
     1481           ,input true
     1482           ) .
     1483         run diasize_change-height in this-procedure
     1484           (input v-diasize-orig-frame-height
     1485               - frame Dialog-Frame :height-chars
     1486           ,input true
     1487           ) .
     1488         assign
     1489           v-diasize-need-maximize = true
     1490         .
     1491       end.
     1492     end.
     1493   end procedure.
     1494   procedure diasize_restore-orig-size :
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       assign
     1499         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1500         v-diasize-current-frame-height = frame Dialog-Frame :height
     1501       .
     1502       run diasize_set-height in this-procedure
     1503         (input  v-diasize-orig-frame-height
     1504         ,input  true
     1505         ) .
     1506       run diasize_set-width in this-procedure
     1507         (input  v-diasize-orig-frame-width
     1508         ,input  true
     1509         ) .
     1510     end.
     1511   end procedure.
     1512   procedure diasize_restore-current-size :
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       run diasize_set-height in this-procedure
     1517         (input  v-diasize-current-frame-height
     1518         ,input  true
     1519         ) .
     1520       run diasize_set-width in this-procedure
     1521         (input  v-diasize-current-frame-width
     1522         ,input  true
     1523         ) .
     1524     end.
     1525   end procedure.
     1526   procedure diasize_set-browse-handle :
     1527     define input  parameter p-browse-handle as handle   no-undo .
     1528     define buffer buf_temp-browse-handle for temp-browse-handle .
     1529     do
     1530     on error undo, return error return-value
     1531     :
     1532       assign
     1533         v-diasize-browse-handle = p-browse-handle
     1534       .
     1535       for each buf_temp-browse-handle
     1536       on error undo, return error return-value
     1537       :
     1538         delete buf_temp-browse-handle .
     1539       end.
     1540     end.
     1541   end procedure.
     1542   procedure diasize_add_browse :
     1543     define input  parameter p-browse-type   as character no-undo .
     1544     define input  parameter p-browse-handle as handle    no-undo .
     1545     define buffer buf_temp-browse-handle for temp-browse-handle .
     1546     do
     1547     on error undo, return error return-value
     1548     :
     1549       assign
     1550         v-diasize-browse-number = v-diasize-browse-number + 1
     1551       .
     1552       create buf_temp-browse-handle .
     1553       assign
     1554         buf_temp-browse-handle.browse-type   = p-browse-type
     1555         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1556         buf_temp-browse-handle.browse-handle = p-browse-handle
     1557       .
     1558     end.
     1559   end procedure.
     1560   procedure diasize_init :
     1561     define variable v-default-value    as logical   no-undo .
     1562     define variable v-restore-saved    as logical   no-undo .
     1563     define variable v-resize-value-str as character no-undo .
     1564     do
     1565     on error undo, return error return-value
     1566     :
     1567       do with frame Dialog-Frame
     1568       :
     1569         assign
     1570           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1571           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1572           v-diasize-browse-handle     = browse b-doc-attr :handle
     1573         .
     1574         create button v-diasize-resize-button
     1575         assign
     1576           parent        = frame Dialog-Frame :first-child
     1577           label         = "s"
     1578           height-pixels = 16
     1579           width-pixels  = 16
     1580           visible       = true
     1581           sensitive     = true
     1582           movable       = true
     1583           triggers:
     1584             on end-move persistent run diasize_end-move in this-procedure .
     1585           end triggers.
     1586         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1587         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1588         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1589         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1590         assign
     1591           v-diasize-wndmax = false
     1592         .
     1593         if connected("ub") = true
     1594         then do:
     1595           define variable v-cntxt-db-num        as integer   no-undo .
     1596           define variable v-cntxt-userid        as character no-undo .
     1597           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1598                                             , OUTPUT v-cntxt-userid
     1599                                             ) .
     1600           run gbl/wndpar_r.p
     1601             (input  v-cntxt-db-num
     1602             ,input  v-cntxt-userid
     1603             ,input  'wndmax':U
     1604             ,output v-diasize-wndmax
     1605             ,output v-default-value
     1606             ) .
     1607         end.
     1608         assign
     1609           v-diasize-wndstore = false
     1610         .
     1611         if connected("ub") = true
     1612         then do:
     1613           run gbl/wndpar_r.p
     1614             (input  v-cntxt-db-num
     1615             ,input  v-cntxt-userid
     1616             ,input  'wndstore':U
     1617             ,output v-diasize-wndstore
     1618             ,output v-default-value
     1619             ) .
     1620         end.
     1621         assign
     1622           v-diasize-proc-name = entry(1, program-name(2), '.')
     1623         .
     1624         if v-diasize-wndstore = true
     1625         then do:
     1626           assign
     1627             v-restore-saved = false
     1628           .
     1629           if connected("ub") = true
     1630           then do:
     1631             run gbl/wndsizer.p
     1632               (input  v-cntxt-db-num
     1633               ,input  v-cntxt-userid
     1634               ,input  v-diasize-proc-name
     1635               ,input  'height':u
     1636               ,output v-resize-value-str
     1637               ) .
     1638             if v-resize-value-str <> '':U
     1639             then do:
     1640               run diasize_change-height in this-procedure
     1641                 (input  integer(v-resize-value-str)
     1642                 ,input  true
     1643                 ) .
     1644               assign
     1645                 v-restore-saved = true
     1646               .
     1647             end.
     1648           end.
     1649           if connected("ub") = true
     1650           then do:
     1651             run gbl/wndsizer.p
     1652               (input  v-cntxt-db-num
     1653               ,input  v-cntxt-userid
     1654               ,input  v-diasize-proc-name
     1655               ,input  'width':u
     1656               ,output v-resize-value-str
     1657               ) .
     1658             if v-resize-value-str <> '':U
     1659             then do:
     1660               run diasize_change-width in this-procedure
     1661                 (input  integer(v-resize-value-str)
     1662                 ,input  true
     1663                 ) .
     1664               assign
     1665                 v-restore-saved = true
     1666               .
     1667             end.
     1668           end.
     1669           if v-restore-saved <> true
     1670           then do:
     1671             if v-diasize-wndmax = true
     1672             then do:
     1673               run diasize_maximize in this-procedure
     1674                 (input  true
     1675                 ) .
     1676             end.
     1677           end.
     1678         end.
     1679         else do:
     1680           if v-diasize-wndmax = true
     1681           then do:
     1682             run diasize_maximize in this-procedure
     1683               (input  true
     1684               ) .
     1685           end.
     1686         end.
     1687       end.
     1688     end.
     1689   end procedure.
     1690   procedure diasize_need-full-display :
     1691     define output parameter p-need-full-display as logical   no-undo .
     1692     do
     1693     on error undo, return error return-value
     1694     :
     1695       assign
     1696         p-need-full-display = v-diasize-need-full-display
     1697       .
     1698       assign
     1699         v-diasize-need-full-display = false
     1700       .
     1701     end.
     1702   end procedure.
     1703   procedure get-context :
     1704      define output parameter p-db-num as integer          no-undo.
     1705      define output parameter p-user-id as character        no-undo.
     1706      define variable v-login               as character    no-undo.
     1707      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1708      define buffer buf_user-login  for ub.user-login .
     1709      do
     1710      on error undo, return error
     1711      :
     1712            FIND FIRST buf_sys-ctrl no-lock.
     1713            ASSIGN
     1714               v-login = USERID("ub")
     1715               p-db-num = buf_sys-ctrl.db-num
     1716            .
     1717            FIND FIRST buf_user-login
     1718                 WHERE buf_user-login.db-num = p-db-num
     1719                   AND buf_user-login.user-login = v-login
     1720                 no-lock
     1721                 no-error
     1722                 .
     1723            IF AVAILABLE buf_user-login
     1724            THEN DO:
     1725               assign
     1726                  p-user-id = buf_user-login.user-id
     1727               .
     1728            END.
     1729      end.
     1730   end procedure.
     1731       run diasize_init in this-procedure .
     1732   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733   on F3 of frame Dialog-Frame anywhere do:
     1734     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1735     return no-apply.
     1736   end.
     1737   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1739     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1740     return no-apply.
     1741   end.
     1742   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1743   on F4 of frame Dialog-Frame anywhere do:
     1744     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1745     return no-apply.
     1746   end.
     1747   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1748   on F8 of frame Dialog-Frame anywhere do:
     1749     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1750     return no-apply.
     1751   end.
     1752   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   on f5 of frame Dialog-Frame anywhere
     1754   do:
     1755     OPEN QUERY b-doc-attr FOR EACH ub.wth-doc-attr       WHERE ub.wth-doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.wth-doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  NO-LOCK .
     1756       apply "VALUE-CHANGED" to b-doc-attr.
     1757   end.
     1758   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   do:
     1760     b-doc-attr :SET-REPOSITIONED-ROW(4, "CONDITIONAL") .
     1761   end.
     1762   MAIN-BLOCK:
     1763   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1764      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1765     if lookup ("b-lkp", parbtn) > 0 then do:
     1766       enable b-lkp with frame Dialog-Frame.
     1767     end.
     1768     if lookup ("b-chg", parbtn) > 0 then do:
     1769       enable b-chg with frame Dialog-Frame.
     1770     end.
     1771     if lookup ("b-del", parbtn) > 0 then do:
     1772       enable b-del with frame Dialog-Frame.
     1773     end.
     1774     if lookup ("no-news", parbtn) > 0 then do:
     1775        v-no-news = true .
     1776     end.
     1777     RUN enable_UI.
     1778     apply 'entry':u to browse b-doc-attr .
     1779     wait-for go of frame Dialog-Frame.
     1780   END.
     1781   RUN disable_UI.
     1782   PROCEDURE disable_UI :
     1783     HIDE FRAME Dialog-Frame.
     1784   END PROCEDURE.
     1785   PROCEDURE enable_UI :
     1786     ENABLE b-exit b-help b-doc-attr
     1787         WITH FRAME Dialog-Frame.
     1788     VIEW FRAME Dialog-Frame.
     1789     OPEN QUERY b-doc-attr FOR EACH ub.wth-doc-attr       WHERE ub.wth-doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.wth-doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  NO-LOCK .
     1790   END PROCEDURE.
     1791   PROCEDURE st-attr :
     1792     define variable varattr-code like ub.wth-doc-attr.attr-code no-undo.
     1793     define buffer bf_wth-doc-attr for ub.wth-doc-attr.
     1794     define variable vartemp-char as character no-undo.
     1795     define buffer buf_wth-doc-attr for ub.wth-doc-attr .
     1796     define buffer buf_tt-upd-attr for tt-upd-attr .
     1797     do
     1798     transaction on error undo, return error return-value
     1799     :
     1800       for each buf_tt-upd-attr
     1801       on error undo, return error return-value
     1802       :
     1803         find first buf_wth-doc-attr no-lock
     1804           where buf_wth-doc-attr.doc-code  = pardoc-code
     1805             and buf_wth-doc-attr.attr-code = buf_tt-upd-attr.code
     1806           no-error .
     1807         if available buf_wth-doc-attr
     1808         then do:
     1809           assign
     1810             buf_tt-upd-attr.can-select = false
     1811           .
     1812         end.
     1813         else do:
     1814           assign
     1815             buf_tt-upd-attr.can-select = true
     1816           .
     1817         end.
     1818       end.
     1819       run str/b-attr.w
     1820         (input table tt-upd-attr
     1821         ,output varattr-code
     1822         ) no-error .
     1823       if error-status :error
     1824       then do:
     1825         if return-value <> ""
     1826         then do:
     1827           message
     1828             "Ошибка при выборе добавляемого атрибута."
     1829             view-as alert-box error.
     1830         end.
     1831         undo, return error.
     1832       end.
     1833       find first tt-upd-attr where tt-upd-attr.code = varattr-code no-error.
     1834       if not available tt-upd-attr then do:
     1835         message "Не верно выбран атрибут для добавления." view-as alert-box error.
     1836         undo, return error.
     1837       end.
     1838       if tt-upd-attr.user-can-edit <> yes then do:
     1839         message "Атрибут нельзя добавить в данном интерфейсе." view-as alert-box.
     1840         undo, return error.
     1841       end.
     1842       find first bf_wth-doc-attr where bf_wth-doc-attr.doc-code   = pardoc-code and
     1843                                   bf_wth-doc-attr.attr-code = varattr-code no-lock no-error.
     1844       if available bf_wth-doc-attr then  do:
     1845         message "Атрибут " tt-upd-attr.label-attr " уже есть в документе " pardoc-code " ."
     1846         view-as alert-box error.
     1847         undo, return error.
     1848       end.
     1849       create ub.wth-doc-attr.
     1850       assign
     1851         ub.wth-doc-attr.doc-code   = pardoc-code
     1852         ub.wth-doc-attr.attr-code = varattr-code.
     1853       run gbl/d-prompt.w (
     1854             'title=':u + 'Изменение атрибутов документа' + '\':u
     1855             + 'text1=':u + tt-upd-attr.label-attr + '\':u
     1856             + 'format=' + tt-upd-attr.format-attr + '\':u
     1857             + 'type=' + tt-upd-attr.type-attr + '\':u
     1858             + 'fillin_row=2\':u
     1859             + 'fillin_col=4\':u
     1860             + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
     1861             + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
     1862             + 'max-chars=70\':u
     1863             + 'readonly=' + 'no':u + '\':u
     1864             , input-output vartemp-char
     1865             ) no-error.
     1866       if error-status:error then do:
     1867         message "Ошибка при изменении атрибута." skip
     1868                 return-value skip
     1869                 error-status:get-message(1) view-as alert-box error.
     1870         undo, return error.
     1871       end.
     1872       if return-value = 'false':u then do:
     1873         undo, return error.
     1874       end.
     1875   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-wrt in g#wthcalib ( input ub.wth-doc-attr.doc-code ,
     1876                          input ub.wth-doc-attr.attr-code ,
     1877                          input vartemp-char ) no-error .
     1878       if error-status :error then do:
     1879           message "Ошибка при сохранении атрибута." view-as alert-box.
     1880           undo, return error.
     1881         end.
     1882       assign
     1883         varrec-id = recid(ub.wth-doc-attr).
     1884        if not v-no-news  then do:
     1885   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-oth in g#wthcalib ( input ub.wth-doc-attr.doc-code ,
     1886                          input ub.wth-doc-attr.attr-code ,
     1887                          input vartemp-char ) no-error .
     1888             if error-status :error then do:
     1889               message "Ошибка при обработке атрибута." view-as alert-box.
     1890               undo, return no-apply.
     1891             end.
     1892        end.
     1893     end.
     1894   END PROCEDURE.
