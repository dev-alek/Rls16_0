      766   function is-sug returns logical
      767           (input p-gds-code as integer):
      768   define variable result as logical no-undo.
      769   define variable c-value as character no-undo.
      770   define variable c-type as character no-undo.
      771   do on error undo, return error:
      772           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      773         (input  p-gds-code
      774         ,input  'fuel-type':U
      775         ,output c-value
      776         ,output c-type) no-error.
      777   end.
      778   result = logical(c-value = 'lgas':U) no-error.
      779   return result.
      780   end function.
      781   tr:
      782   do transaction
      783       on error  undo tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      784       on stop   undo tr, return error substitute( "&1. stop", vss-workfile )
      785       on endkey undo tr, return error substitute( "&1. endkey", vss-workfile )
      786       :
      787       define variable vardata-type as character no-undo.
      788       define variable was_found    as logical   no-undo initial no.
      789       define variable v-auto       as logical   no-undo.
      790       define buffer buf_rvs-doc  for ub.rvs-doc .
      791       define buffer buf_rvs-line for ub.rvs-line .
      792       define buffer buf_doc-pl   for ub.doc-pl .
      793       define buffer buf_pl-gds   for ub.pl-gds .
      794       define buffer buf_place    for ub.place .
      795       define buffer last-rvs-doc for ub.rvs-doc .
      796       define buffer last-rvs-line for ub.rvs-line .
      797       define buffer buf_doc-attr for ub.doc-attr .
      798       define variable v-cardif        as integer   no-undo .
      799       define variable v-abs-critdif   as decimal   no-undo .
      800       define variable v-dif-res-count as integer   no-undo .
      801       define variable v-dif-res       as character no-undo .
      802       define variable v-ok            as logical   no-undo .
      803       define variable v-first-volue      as decimal  no-undo .
      804       define variable v-first-density    as decimal  no-undo .
      805       define variable v-first-temp       as decimal  no-undo .
      806       define variable v-first-water      as decimal  no-undo .
      807       find first buf_rvs-doc exclusive-lock
      808           where recid(buf_rvs-doc) = parrecid
      809           .
      810       if autorvs(recid(buf_rvs-doc)) = "А"
      811       then do:
      812         v-auto = yes.
      813       end.
      814   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   empty temp-table thbjattr_thbj-attr.
      816   run adm/shattri.p (
      817      input "get":U
      818     ,input buf_rvs-doc.obj-type
      819     ,input buf_rvs-doc.obj-code
      820     ,input 'petrol':U
      821     ,input  ""
      822     ,output v-value-character
      823     ,output v-value-date
      824     ,output v-value-decimal
      825     ,output v-value-integer
      826     ,output v-value-logical
      827     ,output par-type
      828     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      829     ) no-error .
      830       for each thbjattr_thbj-attr :
      831         if thbjattr_thbj-attr.prop-code = 'CriticalDif':U then assign v-cardif = integer( thbjattr_thbj-attr.property-value-character) .
      832       end.
      833       if buf_rvs-doc.rvs-type <> 'смена':U
      834       and buf_rvs-doc.rvs-type <> 'контроль':U
      835       and buf_rvs-doc.rvs-type <> 'перед_док':U
      836       and buf_rvs-doc.rvs-type <> 'после_док':U
      837       and buf_rvs-doc.rvs-type <> 'проверка':U
      838       then do:
      839         undo tr, return error substitute("Смена статуса документа сверки. Неизвестный тип документа сверки &1.", buf_rvs-doc.rvs-type).
      840       end.
