       76   procedure placelib_write-attr:
       77   define input  parameter p-code     like ub.place-attr.attr-code .
       78   define input  parameter p-obj-code like ub.place-attr.obj-code .
       79   define input  parameter p-obj-type like ub.place-attr.obj-type .
       80   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       81   define input  parameter p-value    like ub.place-attr.attr-value .
       82   define output parameter p-ok       as logical.
       83   define buffer buf_place-attr for ub.place-attr .
       84     do on error undo, return error return-value :
       85        p-ok = false.
       86        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       87                                                   and buf_place-attr.obj-code    = p-obj-code
       88                                                   and buf_place-attr.obj-type    = p-obj-type
       89                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       90        if not available buf_place-attr then do :
       91           create buf_place-attr.
       92           assign
       93             buf_place-attr.attr-code   = p-code
       94             buf_place-attr.attr-value  = p-value
       95             buf_place-attr.obj-code    = p-obj-code
       96             buf_place-attr.obj-type    = p-obj-type
       97             buf_place-attr.pl-code     = p-pl-code
       98           .
       99           p-ok = true.
      100        end.
      101        else do:
      102           buf_place-attr.attr-value  = p-value .
      103           p-ok = true.
      104        end.
      105     end.
      106   end.
      107   procedure placelib_get-attr:
      108   define input  parameter  p-code     like ub.place-attr.attr-code .
      109   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      110   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      111   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      112   define output parameter  p-value    like ub.place-attr.attr-value .
      113   define output parameter  p-ok       as logical.
      114   define buffer buf_place-attr for ub.place-attr .
      115     do on error undo, return error return-value :
      116        p-ok = false.
      117        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      118                                                   and buf_place-attr.obj-code    = p-obj-code
      119                                                   and buf_place-attr.obj-type    = p-obj-type
      120                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      121        if available buf_place-attr then do :
      122          p-value = buf_place-attr.attr-value.
      123          p-ok = true.
      124        end.
      125        else do :
      126          p-ok = false.
      127        end.
      128     end.
      129   end.
      130   procedure placelib_del-attr:
      131   define input parameter  p-code     like ub.place-attr.attr-code .
      132   define input parameter  p-obj-code like ub.place-attr.obj-code .
      133   define input parameter  p-obj-type like ub.place-attr.obj-type .
      134   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      135   define input parameter  p-value    like ub.place-attr.attr-value .
      136   define output parameter p-ok       as logical.
      137   define buffer buf_place-attr for ub.place-attr .
      138     do on error undo, return error return-value :
      139        p-ok = false.
      140        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      141                                                   and buf_place-attr.obj-code    = p-obj-code
      142                                                   and buf_place-attr.obj-type    = p-obj-type
      143                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      144        if available buf_place-attr then do :
      145           delete buf_place-attr.
      146           p-ok = true.
      147        end.
      148     end.
      149   end.
      150   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   function autorvs return char
      152       ( input p-rec as recid  ) :
      153       define variable p-autorvs as char no-undo.
      154       define buffer Buf_doc-attr for doc-attr.
      155       define buffer r-d          for rvs-doc.
      156       find first r-d no-lock where recid(r-d) = p-rec no-error.
      157       find first buf_doc-attr no-lock where r-d.rvs-code = buf_doc-attr.doc-code and buf_doc-attr.attr-code = "rvs-auto" and buf_doc-attr.attr-value = "Yes" no-error.
      158       if available buf_doc-attr then
      159       do :
      160           p-autorvs = 'а'.
      161       end.
      162       else
      163       do:
      164           if r-d.is-full = yes then
      165           do:
      166               p-autorvs =  "п" .
      167           end.
      168           else
      169           do :
      170               p-autorvs = " ".
      171           end.
      172       end.
      173       return ( p-autorvs ).
      174   end function.
