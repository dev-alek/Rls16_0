      133      run thbjattr_code_reg in this-procedure (
      134                                               p-upper-code,
      135                                               p-code,
      136                                               output p-label,
      137                                               output p-user-can-edit,
      138                                               output p-output-display,
      139                                               output p-other,
      140                                               output p-prop-list,
      141                                               output p-prop-type-list,
      142                                               output p-prop-label-list,
      143                                               output p-global,
      144                                               output p-host,
