      117   procedure thbjattr_code :
      118      define input  parameter p-upper-code     as character no-undo .
      119      define input  parameter p-code           as character no-undo .
      120      define output parameter p-label          as character no-undo .
      121      define output parameter p-user-can-edit  as logical   no-undo .
      122      define output parameter p-output-display as logical   no-undo .
      123      define output parameter p-other          as character no-undo .
      124      define output parameter p-prop-list      as character no-undo .
      125      define output parameter p-prop-type-list as character no-undo .
      126      define output parameter p-prop-label-list as character no-undo .
      127      define output parameter p-global          as logical no-undo .
      128      define output parameter p-host           as logical no-undo .
      129      define output parameter p-shop           as logical no-undo .
      130      define output parameter p-store          as logical no-undo .
      131      define output parameter p-db             as logical no-undo .
