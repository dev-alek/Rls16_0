      684   procedure ver-clients :
      685   define input  parameter p-obj-type as character no-undo .
      686   define input  parameter p-obj-code as integer   no-undo .
      687   define output parameter p-error as logical   no-undo .
      688   define variable v-veto-man-doc as character no-undo .
      689   define variable v-type        as character no-undo .
      690     do
      691     on error undo, return error return-value
      692     :
      693     p-error = false .
      694   run clntattr-value in this-procedure (
      695    input p-obj-type ,
      696    input p-obj-code ,
      697    input 'veto-man-doc':U     ,
      698    output v-veto-man-doc ,
      699    output v-type        ) no-error .
      700    if error-status :error then message
      701      error-status :get-message(1) skip
      702      return-value skip
      703      "Ошибка clntattr-veto-man-doc"
      704      view-as alert-box error
      705    .
      706     if v-veto-man-doc = 'ALL' then do:
      707         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
      708         p-error = true .
      709     end.
      710    end.
      711   end procedure.
      712   define input  parameter parparentproc         as handle               no-undo.
      713   define input  parameter parobj-type           as character            no-undo.
      714   define input  parameter parobj-code           as integer              no-undo.
      715   define output parameter parno-change-cli-cntr as logical              no-undo.
      716   define output parameter parcli-type           as character            no-undo.
      717   define output parameter parcli-code           as integer              no-undo.
      718   define output parameter parcontract-code      as integer              no-undo.
      719   define output parameter parset-cli-contr      as logical   initial no no-undo.
      720   define variable varwithout-obj-host-code like ub.sysconf.host-code      no-undo.
      721   define variable varobj-type              like ub.clients.obj-type       no-undo.
      722   define variable varobj-code              like ub.clients.obj-code       no-undo.
      723   define variable varhost-code             like ub.clients.obj-code       no-undo.
      724   define variable varcontract-code         like ub.contract.contract-code no-undo.
      725   define variable varneed-contract         as logical   no-undo .
      726   define variable varneed-contract-type    as   character                 no-undo.
      727   define variable v-err as logical   no-undo .
      728   define buffer bf-host_clients for ub.clients.
      729   DEFINE BUTTON b-cancel AUTO-END-KEY
      730        LABEL "&Отмена"
      731        SIZE 10 BY 1
      732        BGCOLOR 8 .
      733   DEFINE BUTTON b-exit AUTO-GO
      734        LABEL "&Ввод"
      735        SIZE 10 BY 1
      736        BGCOLOR 8 .
      737   DEFINE BUTTON b-help
      738        LABEL "&Помощь"
      739        SIZE 10 BY 1
      740        BGCOLOR 8 .
      741   DEFINE BUTTON r-cli
      742        IMAGE-UP FILE "btn-down-arrow":U
      743        IMAGE-DOWN FILE "btn-down-arrow":U
      744        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      745        LABEL ""
      746        SIZE 3 BY .88.
      747   DEFINE BUTTON r-contract
      748        IMAGE-UP FILE "btn-down-arrow":U
      749        IMAGE-DOWN FILE "btn-down-arrow":U
      750        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      751        LABEL ""
      752        SIZE 3 BY .88.
      753   DEFINE VARIABLE varcli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      754        LABEL "&Поставщик"
      755        VIEW-AS FILL-IN
      756        SIZE 10 BY 1 NO-UNDO.
      757   DEFINE VARIABLE varcli-name AS CHARACTER FORMAT "X(256)":U
      758        VIEW-AS FILL-IN
      759        SIZE 44.13 BY 1 NO-UNDO.
      760   DEFINE VARIABLE varcli-type AS CHARACTER FORMAT "X(3)":U
      761        VIEW-AS FILL-IN
      762        SIZE 4 BY 1 NO-UNDO.
      763   DEFINE VARIABLE varcontract-prn-code AS CHARACTER FORMAT "X(256)":U INITIAL "БЕЗ ДОГОВОРА"
      764        LABEL "&Договор"
      765        VIEW-AS FILL-IN
      766        SIZE 17 BY 1 NO-UNDO.
      767   DEFINE VARIABLE b-choose AS INTEGER INITIAL 1
      768        VIEW-AS RADIO-SET VERTICAL
      769        RADIO-BUTTONS
      770             "По тем же контрагентам и договорам", 1,
      771   "Выбор контрагента и договора", 2
      772        SIZE 38 BY 3 NO-UNDO.
      773   DEFINE FRAME Dialog-Frame
      774        b-exit AT ROW 1 COL 1
      775        b-cancel AT ROW 1 COL 11.5
      776        b-help AT ROW 1 COL 22
      777        b-choose AT ROW 2.75 COL 1.5 NO-LABEL
      778        varcli-code AT ROW 6 COL 11 COLON-ALIGNED
      779        varcli-type AT ROW 6 COL 21.5 COLON-ALIGNED NO-LABEL
      780        r-cli AT ROW 6 COL 28
      781        varcli-name AT ROW 7.25 COL 11 COLON-ALIGNED NO-LABEL
      782        varcontract-prn-code AT ROW 8.75 COL 11 COLON-ALIGNED
      783        r-contract AT ROW 8.75 COL 31
      784        SPACE(23.37) SKIP(0.36)
      785       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      786            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      787            TITLE "Выбор контрагента"
      788            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      789   ASSIGN
      790          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      791          FRAME Dialog-Frame:HIDDEN           = TRUE.
      792   ASSIGN
      793          r-cli:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      794   ASSIGN
      795          r-contract:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      796   ASSIGN
      797          varcli-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      798   ASSIGN
      799          varcli-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      800   ASSIGN
      801          varcli-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      802   ASSIGN
      803          varcontract-prn-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      804   ON GO OF FRAME Dialog-Frame
      805   DO:
      806       define buffer bf_clients  for ub.clients.
      807       define buffer bf_contract for ub.contract.
      808       if b-choose = 1 then do:
      809         assign
      810           parcli-type           = "":u
      811           parcli-code           = 0
      812           parcontract-code      = 0
      813           parno-change-cli-cntr = yes
      814           parset-cli-contr      = yes.
      815       end.
      816       else do:
      817         if varcli-code = ?  or
      818            varcli-code = 0  then do:
      819           message "Не указан контрагент." view-as alert-box.
      820           apply "entry" to varcli-code in frame Dialog-Frame.
      821           return no-apply.
      822         end.
      823         if varcli-type = ?  or
      824            varcli-type = "" then do:
      825             message "Не указан контрагент." view-as alert-box.
      826             apply "entry" to varcli-type in frame Dialog-Frame.
      827             return no-apply.
      828         end.
      829         find first bf_clients where bf_clients.obj-type = varcli-type and
      830                                     bf_clients.obj-code = varcli-code no-lock no-error.
      831         if not available bf_clients then do:
      832           message "Не найден контрагент " bf_clients.obj-type " " bf_clients.obj-code " ." view-as alert-box.
      833           apply "entry" to varcli-type in frame Dialog-Frame.
      834           return no-apply.
      835         end.
      836         if bf_clients.obj-type = 'маг':U  or
      837            bf_clients.obj-type = 'скл':U then do:
      838           message "Контрагент не может иметь тип: " 'маг':U " или " 'скл':U " ." view-as alert-box.
      839           return no-apply.
      840         end.
      841         if varneed-contract = yes and
      842            not (bf_clients.obj-type = 'орг':U and bf_clients.obj-code = varhost-code) then do:
      843           if varcontract-code = 0 then do:
      844             message "В системе запрещено создание складских документов без договоров." skip
      845                     "По контрагенту " bf_clients.obj-code " " bf_clients.obj-type " " bf_clients.obj-name " не выбран договор для текущей фирмы."
      846             view-as alert-box.
      847             return no-apply.
      848           end.
      849         end.
      850         if varcontract-code <> 0 then do:
      851           find first bf_contract where bf_contract.host-code     = varhost-code     and
      852                                        bf_contract.contract-code = varcontract-code no-lock no-error.
      853           if not available bf_contract then do:
      854             message "Не наден договор номер " varcontract-prn-code " внутренний номер " varcontract-code " по фирме " varhost-code " ." view-as alert-box.
      855             return no-apply.
      856           end.
      857           if bf_contract.cli-type = bf_clients.obj-type and
      858              bf_contract.cli-code = bf_clients.obj-code then do:
      859             assign
      860               parcontract-code     = bf_contract.contract-code.
      861           end.
      862           else do:
      863             message "Выбранный договор " bf_contract.contract-prn-code " с внутренним номером " bf_contract.contract-code " ." skip
      864                     "Принадлежит контрагенту: " bf_contract.cli-code " " bf_contract.cli-type " ." skip
      865                     "Вы выбрали контрагента: " bf_clients.obj-code "  " bf_clients.obj-type " ."
      866             view-as alert-box.
      867             return no-apply.
      868           end.
      869         end.
      870         assign
      871           parcli-type = bf_clients.obj-type
      872           parcli-code = bf_clients.obj-code.
      873         assign
      874           parno-change-cli-cntr = no
      875           parset-cli-contr      = yes.
      876       end.
      877   END.
      878   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      879   DO:
      880     APPLY "END-ERROR":U TO SELF.
      881   END.
      882   ON VALUE-CHANGED OF b-choose IN FRAME Dialog-Frame
      883   DO:
      884     assign frame Dialog-Frame
      885       b-choose.
      886     if b-choose = 1 then do:
      887       assign
      888         varcli-type          = ""
      889         varcli-code          = 0
      890         varcontract-code     = 0
      891         varcontract-prn-code = "БЕЗ ДОГОВОРА".
      892       hide varcli-type varcli-code r-cli r-contract varcontract-prn-code in frame Dialog-Frame.
      893     end.
      894     else do:
      895       assign
      896         varcli-type          = 'орг':U
      897         varcli-code          = varhost-code
      898         varcontract-code     = 0
      899         varcontract-prn-code = "БЕЗ ДОГОВОРА".
      900       view varcli-type varcli-code r-cli r-contract varcontract-prn-code in frame Dialog-Frame.
      901       enable varcli-type varcli-code r-cli r-contract with frame Dialog-Frame.
      902       display varcli-type varcli-code varcontract-prn-code with frame Dialog-Frame.
      903     end.
      904   END.
      905   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      906   DO:
      907   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   if lookup(self :type
      909            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      910            ) = 0
      911   then do:
      912     message
      913       "$Workfile$"
      914       "Указанному интерфейсному элементу фокус не может быть передан" skip
      915       "Интерфейсный элемент" self :name  skip
      916       "Тип" self :type  skip
      917       "Процедура" this-procedure :file-name skip
      918       view-as alert-box .
      919   end.
      920   else do:
      921     apply "entry":u to self  .
      922     if focus :handle <> self :handle  then do:
      923       return no-apply .
      924     end.
      925   end.
      926   END.
      927   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
      928   DO:
      929     DEFINE VARIABLE varrec-list AS CHARACTER NO-UNDO.
      930     define variable varrid-list as character no-undo.
      931     DEFINE VARIABLE varrecid    AS RECID     NO-UNDO.
      932     DEFINE BUFFER bf_clients  FOR ub.clients.
      933     DEFINE BUFFER bf_contract FOR ub.contract.
      934     if transaction = yes then do:
      935       message "Критическая ошибка." skip
      936               "Вы находитесь в транзакции." skip
      937               "Работа со справочником клиентов невозможна."
      938       view-as alert-box error.
      939       return no-apply.
      940     end.
      941     run ref/cli-all.w (parparentproc
      942                   , "b-sel,b-add"
      943                   , 'все':U
      944                   , ?
      945                   , ?
      946                   , ?
      947                   , ?
      948                   , ?
      949                   , output varrec-list) NO-ERROR.
      950     IF ERROR-STATUS:ERROR THEN DO:
      951       RETURN NO-APPLY.
      952     END.
      953     IF varrec-list <> "" THEN DO:
      954       ASSIGN
      955         varrecid = integer(ENTRY(1, varrec-list)).
      956       FIND FIRST bf_clients WHERE RECID(bf_clients) = varrecid NO-LOCK.
      957       IF bf_clients.obj-type = 'маг':U  OR
      958          bf_clients.obj-type = 'скл':U THEN DO:
      959          MESSAGE "Склад или магазин не может быть контрагентом в данном документе."
      960          VIEW-AS ALERT-BOX.
      961          RETURN NO-APPLY.
      962       END.
      963       IF bf_clients.obj-type = 'орг':U       AND
      964          bf_clients.obj-code = varhost-code THEN DO:
      965          ASSIGN
      966            varcontract-code     = 0
      967            varcontract-prn-code = "БЕЗ ДОГОВОРА"
      968          .
      969       END.
      970       ELSE DO:
      971         FIND FIRST bf_contract WHERE bf_contract.host-code = varhost-code        AND
      972                                      bf_contract.cli-type  = bf_clients.obj-type AND
      973                                      bf_contract.cli-code  = bf_clients.obj-code AND
      974                                      bf_contract.status_   = 'тек':U    NO-LOCK NO-ERROR.
      975         IF NOT AVAILABLE bf_contract THEN DO:
      976           IF varneed-contract = yes THEN DO:
      977             MESSAGE "В системе запрещено создание складских документов без договоров." SKIP
      978                     "По контрагенту " bf_clients.obj-code " " bf_clients.obj-type " " bf_clients.obj-name " нет ни одного открытого договора для текущей фирмы."
      979             VIEW-AS ALERT-BOX.
      980             RETURN NO-APPLY.
      981           END.
      982         END.
      983         ELSE DO:
      984           run str/cont-all.w (input parparentproc,
      985                           input varhost-code,
      986                           input "b-sel",
      987                           input 'фирма':U ,
      988                           input bf_clients.obj-type,
      989                           input bf_clients.obj-code,
      990                           input ?,
      991                           input ?,
      992                           input "current":u,
      993                           input 'при':U,
      994                           input-output varrid-list ) no-error.
      995           if error-status:error then do:
      996             message "Ошибка при вызове справочника договоров." skip
      997                     return-value                skip
      998             view-as alert-box error.
      999             return no-apply.
     1000           end.
     1001           IF varrid-list <> "" THEN DO:
     1002             assign
     1003               varrecid = integer(entry(1, varrid-list)).
     1004             find first bf_contract where recid(bf_contract) = varrecid no-lock.
     1005             if bf_contract.cli-type = bf_clients.obj-type and
     1006                bf_contract.cli-code = bf_clients.obj-code  then do:
     1007               assign
     1008                 varcontract-code     = bf_contract.contract-code
     1009                 varcontract-prn-code = bf_contract.contract-prn-code.
     1010             end.
     1011             ELSE DO:
     1012               MESSAGE "Выбранный договор " bf_contract.contract-prn-code " с внутренним номером " bf_contract.contract-code " ." SKIP
     1013                       "Принадлежит контрагенту: " bf_contract.cli-code " " bf_contract.cli-type " ." SKIP
     1014                       "Вы выбрали контрагента: " bf_clients.obj-code "  " bf_clients.obj-type " ."
     1015               VIEW-AS ALERT-BOX.
     1016               RETURN NO-APPLY.
     1017             END.
     1018           END.
     1019           ELSE DO:
     1020             IF varneed-contract = yes THEN DO:
     1021               MESSAGE "В системе запрещено создание складских документов без договоров." SKIP
     1022                       "По контрагенту " bf_clients.obj-code " " bf_clients.obj-type " " bf_clients.obj-name " не выбран договор для текущей фирмы."
     1023               VIEW-AS ALERT-BOX.
     1024               RETURN NO-APPLY.
     1025             END.
     1026           END.
     1027         END.
     1028       END.
     1029       ASSIGN
     1030         varcli-type = bf_clients.obj-type
     1031         varcli-code = bf_clients.obj-code
     1032         varcli-name = bf_clients.obj-name.
     1033       DISPLAY varcli-type varcli-code varcli-name varcontract-prn-code WITH FRAME Dialog-Frame.
     1034     END.
     1035   END.
     1036   ON CHOOSE OF r-contract IN FRAME Dialog-Frame
     1037   DO:
     1038     DEFINE BUFFER bf_contract FOR ub.contract.
     1039     DEFINE VARIABLE varrid-list AS CHARACTER NO-UNDO.
     1040     DEFINE VARIABLE varrecid    AS RECID     NO-UNDO.
     1041     IF varcli-type <> ?    AND
     1042        varcli-type <> "":u AND
     1043        varcli-code <> 0    AND
     1044        varcli-code <> ?    THEN DO:
     1045       IF NOT (varcli-type = 'орг':U       AND
     1046         INPUT FRAME Dialog-Frame varcli-code  = varhost-code) THEN DO:
     1047         run str/cont-all.w (input parparentproc,
     1048                         input varhost-code,
     1049                         input "b-sel",
     1050                         input 'фирма':U ,
     1051                         input varcli-type,
     1052                         input varcli-code,
     1053                         input ?,
     1054                         input ?,
     1055                         input "current":u,
     1056                         input 'при':U,
     1057                         input-output varrid-list ) no-error.
     1058         if error-status:error then do:
     1059           message "Ошибка при вызове справочника договоров." skip
     1060                   return-value                skip
     1061           view-as alert-box error.
     1062           return NO-APPLY.
     1063         end.
     1064         IF varrid-list <> "" THEN DO:
     1065           assign
     1066             varrecid = integer(entry(1, varrid-list)).
     1067           find first bf_contract where recid(bf_contract) = varrecid NO-LOCK.
     1068           if bf_contract.cli-type = varcli-type AND
     1069              bf_contract.cli-code = varcli-code then do:
     1070             assign
     1071               varcontract-code     = bf_contract.contract-code
     1072               varcontract-prn-code = bf_contract.contract-prn-code.
     1073             DISPLAY varcontract-prn-code WITH FRAME Dialog-Frame.
     1074           end.
     1075           ELSE DO:
     1076             MESSAGE "Выбранный договор " bf_contract.contract-prn-code " с внутренним номером " bf_contract.contract-code " ." SKIP
     1077                     "Принадлежит контрагенту: " bf_contract.cli-code " " bf_contract.cli-type " ." SKIP
     1078                     "Вы выбрали контрагента: " varcli-code "  " varcli-type " ."
     1079             VIEW-AS ALERT-BOX.
     1080             RETURN NO-APPLY.
     1081           END.
     1082         END.
     1083         ELSE DO:
     1084           IF varneed-contract = yes THEN DO:
     1085             MESSAGE "В системе запрещено создание складских документов без договоров." SKIP
     1086                     "По контрагенту " varcli-code " " varcli-type " нет ни одного открытого договора для текущей фирмы."
     1087             VIEW-AS ALERT-BOX.
     1088             RETURN NO-APPLY.
     1089           END.
     1090           ASSIGN
     1091             varcontract-code = 0
     1092             varcontract-prn-code = "БЕЗ ДОГОВОРА".
     1093         END.
     1094       END.
     1095       ELSE DO:
     1096         ASSIGN
     1097           varcontract-code = 0
     1098           varcontract-prn-code = "БЕЗ ДОГОВОРА".
     1099       END.
     1100       DISPLAY varcontract-prn-code WITH FRAME Dialog-Frame.
     1101     END.
     1102     ELSE DO:
     1103       MESSAGE "Выбрать договор можно только после указания контрагента." VIEW-AS ALERT-BOX.
     1104       RETURN NO-APPLY.
     1105     END.
     1106   END.
     1107   ON LEAVE OF varcli-code IN FRAME Dialog-Frame
     1108   DO:
     1109     ASSIGN FRAME Dialog-Frame
     1110       varcli-code.
     1111     APPLY "entry" TO varcli-type IN FRAME Dialog-Frame.
     1112     RETURN NO-APPLY.
     1113   END.
     1114   ON LEAVE OF varcli-type IN FRAME Dialog-Frame
     1115   DO:
     1116    RUN find-cli IN THIS-PROCEDURE NO-ERROR.
     1117    IF ERROR-STATUS:ERROR THEN DO:
     1118      RETURN NO-APPLY.
     1119    END.
     1120   END.
     1121   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1122   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1123   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   on help of frame Dialog-Frame
     1125   do:
     1126     run gbl/app_help.p
     1127       (input this-procedure :file-name
     1128       ,input ''
     1129       ,input ?
     1130       ) no-error.
     1131     if error-status :error then do:
     1132       message
     1133         "Ошибка при вызове помощи"
     1134         error-status :get-message(1)
     1135         view-as alert-box .
     1136     end.
     1137   end.
     1138   run minbtn-set in this-procedure .
     1139   on choose of b-help in frame Dialog-Frame
     1140   do:
     1141     apply "help":u to frame Dialog-Frame .
     1142   end.
     1143   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   procedure minbtn-set :
     1145       do
     1146           on error undo, return error return-value
     1147           :
     1148           define variable ii              as integer       no-undo .
     1149           define variable fh              as widget-handle no-undo .
     1150           define variable hh              as widget-handle no-undo .
     1151           define variable v-h             as handle        extent 4 no-undo .
     1152           define variable v-name-button   as character     no-undo .
     1153           define variable v-help-old-x    as decimal       no-undo .
     1154           define variable v-help-old-y    as decimal       no-undo .
     1155           define variable v-help-old-size as decimal       no-undo .
     1156           define variable v-frame-width   as decimal       no-undo .
     1157           define variable jj              as integer       no-undo .
     1158           do
     1159               on error undo, return error
     1160               :
     1161               assign
     1162                   v-frame-width = frame Dialog-Frame:width - 0.3
     1163                   fh            = frame Dialog-Frame:first-child
     1164                   hh            = fh:first-child
     1165                   ii            = 1
     1166                   .
     1167               do while valid-handle(hh):
     1168                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1169                   do:
     1170                       case lc(hh:name) :
     1171                           when "b-help" then
     1172                               do:
     1173                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1174                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1175                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1176                                   hh:TOOLTIP = "Помощь" .
     1177                                   v-help-old-x = hh:column .
     1178                                   v-help-old-y = hh:row    .
     1179                                   v-help-old-size = hh:width .
     1180                                   hh:width-chars = 2.5 .
     1181                               end.
     1182                           when "b-print" then
     1183                               do:
     1184                                   hh:load-image("cmp/b-print.bmp":u) .
     1185                                   hh:TOOLTIP = "Печать" .
     1186                                   v-h[ii] = hh:handle .
     1187                                   ii = ii + 1 .
     1188                                   hh:width-chars = 3 .
     1189                               end.
     1190                           when "b-history" or
     1191                           when "b-hist" then
     1192                               do:
     1193                                   hh:load-image("cmp/b-hist.bmp":u) .
     1194                                   hh:TOOLTIP = "История" .
     1195                                   v-h[ii] = hh:handle .
     1196                                   ii = ii + 1 .
     1197                                   hh:width-chars = 3 .
     1198                               end.
     1199                           when "b-sch" then
     1200                               do:
     1201                                   hh:load-image("cmp/b-sch.bmp":u) .
     1202                                   hh:TOOLTIP = "Установка Фильтра" .
     1203                                   v-h[ii] = hh:handle .
     1204                                   ii = ii + 1 .
     1205                                   hh:width-chars = 3 .
     1206                               end.
     1207                           when "b-hist-user" then
     1208                               do:
     1209                                   hh:load-image("cmp/b-hist.bmp":u) .
     1210                                   hh:TOOLTIP = "История пользователя" .
     1211                                   ii = ii + 1 .
     1212                               end.
     1213                       end case.
     1214                   end.
     1215                   hh = hh:next-sibling.
     1216               end.
     1217               b-help:column = v-frame-width - b-help:width-chars.
     1218               jj = 0.
     1219               repeat ii = 4 to 1 by -1 :
     1220                   if valid-handle (v-h[ii] ) then
     1221                   do:
     1222                       jj  = jj + 1 .
     1223                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1224                       v-h[ii]:row    = v-help-old-y .
     1225                   end.
     1226               end.
     1227           end.
     1228       end.
     1229   end procedure.
     1230   MAIN-BLOCK:
     1231   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1232      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1233     FIND FIRST bf-host_clients WHERE bf-host_clients.obj-type = parobj-type AND
     1234                                      bf-host_clients.obj-code = parobj-code NO-LOCK.
     1235     ASSIGN
     1236       varhost-code = bf-host_clients.host-code
     1237       .
     1238   define variable varcontract       as character no-undo .
     1239   define variable varcontract-type  as character no-undo .
     1240   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
     1241   define variable v-value-date      like ub.thbj-attr.property-value-date no-undo .
     1242   define variable v-value-decimal   like ub.thbj-attr.property-value-decimal no-undo .
     1243   define variable v-value-logical   like ub.thbj-attr.property-value-logical no-undo .
     1244   define variable v-value-integer   like ub.thbj-attr.property-value-integer no-undo .
     1245   define variable v-mastc           as logical   no-undo init false .
     1246       run adm/shattri.p (
     1247         input "get":U
     1248         ,input parobj-type
     1249         ,input parobj-code
     1250         ,input 'contr-in':U
     1251         ,input "contr-in-income"
     1252         ,output v-value-character
     1253         ,output v-value-date
     1254         ,output v-value-decimal
     1255         ,output v-value-integer
     1256         ,output varneed-contract
     1257         ,output varneed-contract-type
     1258         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1259         ) no-error .
     1260         if error-status :error then
     1261         message
     1262           vss-workfile vss-revision vss-description skip
     1263           error-status :get-message(1) skip
     1264           return-value skip
     1265           "adm/shattri.p"
     1266           view-as alert-box error
     1267         .
     1268     RUN enable_UI.
     1269     WAIT-FOR GO OF FRAME Dialog-Frame.
     1270   END.
     1271   RUN disable_UI.
     1272   PROCEDURE disable_UI :
     1273     HIDE FRAME Dialog-Frame.
     1274   END PROCEDURE.
     1275   PROCEDURE enable_UI :
     1276     DISPLAY b-choose
     1277         WITH FRAME Dialog-Frame.
     1278     ENABLE b-exit b-cancel b-help b-choose
     1279         WITH FRAME Dialog-Frame.
     1280     VIEW FRAME Dialog-Frame.
     1281   END PROCEDURE.
     1282   PROCEDURE find-cli :
     1283   DEFINE BUFFER bf_clients  FOR ub.clients.
     1284     DEFINE BUFFER bf_contract FOR ub.contract.
     1285     DEFINE VARIABLE varrid-list AS CHARACTER NO-UNDO.
     1286     DEFINE VARIABLE varrec-list AS CHARACTER NO-UNDO.
     1287     DEFINE VARIABLE varrecid    AS RECID     NO-UNDO.
     1288     FIND FIRST bf_clients WHERE bf_clients.obj-type = INPUT FRAME Dialog-Frame varcli-type AND
     1289                                 bf_clients.obj-code = varcli-code NO-LOCK NO-ERROR.
     1290     IF NOT AVAILABLE bf_clients THEN DO:
     1291       MESSAGE "Нет контрагента " varcli-code " " INPUT FRAME Dialog-Frame varcli-type " ."
     1292       VIEW-AS ALERT-BOX.
     1293       run ref/cli-all.w (parparentproc
     1294                     , "b-sel,b-add"
     1295                     , 'все':U
     1296                     , ?
     1297                     , ?
     1298                     , ?
     1299                     , ?
     1300                     , ?
     1301                     , output varrec-list) NO-ERROR.
     1302       IF ERROR-STATUS:ERROR THEN DO:
     1303         RETURN NO-APPLY.
     1304       END.
     1305       IF varrec-list <> "" THEN DO:
     1306         ASSIGN
     1307           varrecid = integer(ENTRY(1, varrec-list)).
     1308         FIND FIRST bf_clients WHERE recid(bf_clients) = varrecid NO-LOCK.
     1309         ASSIGN
     1310           varcli-code = bf_clients.obj-code.
     1311         DISPLAY varcli-code bf_clients.obj-type @ varcli-type WITH FRAME Dialog-Frame.
     1312       END.
     1313       ELSE DO:
     1314         RETURN NO-APPLY.
     1315       END.
     1316     END.
     1317     IF varneed-contract = yes THEN DO:
     1318       FIND FIRST bf_contract WHERE bf_contract.host-code = varhost-code     AND
     1319                                    bf_contract.cli-type  = INPUT FRAME Dialog-Frame varcli-type      AND
     1320                                    bf_contract.cli-code  = varcli-code      AND
     1321                                    bf_contract.status_   = 'тек':U NO-LOCK NO-ERROR.
     1322       IF NOT AVAILABLE bf_contract THEN DO:
     1323         MESSAGE "В системе запрещено создание складских документов без договоров." SKIP
     1324                 "По контрагенту " bf_clients.obj-code " " INPUT FRAME Dialog-Frame varcli-type " нет ни одного открытого договора для текущей фирмы."
     1325         VIEW-AS ALERT-BOX.
     1326         RETURN NO-APPLY.
     1327       END.
     1328       ELSE DO:
     1329         run str/cont-all.w (input parparentproc,
     1330                         input varhost-code,
     1331                         input "b-sel",
     1332                         input 'фирма':U ,
     1333                         input INPUT FRAME Dialog-Frame varcli-type,
     1334                         input varcli-code,
     1335                         input ?,
     1336                         input ?,
     1337                         input "current":u,
     1338                         input 'при':U,
     1339                         input-output varrid-list ) no-error.
     1340         if error-status:error then do:
     1341           message "Ошибка при вызове справочника договоров." skip
     1342                   return-value                skip
     1343           view-as alert-box error.
     1344           return NO-APPLY.
     1345         end.
     1346         IF varrid-list <> "" THEN DO:
     1347           assign
     1348             varrecid = integer(entry(1, varrid-list)).
     1349           find first bf_contract where recid(bf_contract) = varrecid NO-LOCK.
     1350           if bf_contract.cli-type = INPUT FRAME Dialog-Frame varcli-type AND
     1351              bf_contract.cli-code = varcli-code then do:
     1352             assign
     1353               varcontract-code     = bf_contract.contract-code
     1354               varcontract-prn-code = bf_contract.contract-prn-code.
     1355             DISPLAY varcontract-prn-code WITH FRAME Dialog-Frame.
     1356           end.
     1357           ELSE DO:
     1358             MESSAGE "Выбранный договор " bf_contract.contract-prn-code " с внутренним номером " bf_contract.contract-code " ." SKIP
     1359                     "Принадлежит контрагенту: " bf_contract.cli-code " " bf_contract.cli-type " ." SKIP
     1360                     "Вы выбрали контрагента: " varcli-code "  " INPUT FRAME Dialog-Frame varcli-type " ."
     1361             VIEW-AS ALERT-BOX.
     1362             RETURN NO-APPLY.
     1363           END.
     1364         END.
     1365         ELSE DO:
     1366           MESSAGE "В системе запрещено создание складских документов без договоров." SKIP
     1367                   "По контрагенту " bf_clients.obj-code " " INPUT FRAME Dialog-Frame varcli-type " не выбран договор по текущей фирмы."
     1368           VIEW-AS ALERT-BOX.
     1369           RETURN NO-APPLY.
     1370         END.
     1371       END.
     1372     END.
     1373     run ver-clients  (bf_clients.obj-type , bf_clients.obj-code , output v-err) .
     1374     if  v-err then return NO-APPLY.
     1375     ASSIGN FRAME Dialog-Frame varcli-type.
     1376     FIND FIRST bf_clients WHERE bf_clients.obj-type = varcli-type AND
     1377                                 bf_clients.obj-code = varcli-code NO-LOCK NO-ERROR.
     1378     ASSIGN FRAME Dialog-Frame
     1379       varcli-name.
     1380     DISPLAY varcli-name WITH FRAME Dialog-Frame.
     1381   END PROCEDURE.
