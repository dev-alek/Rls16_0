      151   procedure thbjattr_code_reg :
      152   define input  parameter p-upper-code     as character no-undo .
      153   define input  parameter p-code           as character no-undo .
      154   define output parameter p-label          as character no-undo .
      155   define output parameter p-user-can-edit  as logical   no-undo .
      156   define output parameter p-output-display as logical   no-undo .
      157   define output parameter p-other          as character no-undo .
      158   define output parameter p-prop-list      as character no-undo .
      159   define output parameter p-prop-type-list as character no-undo .
      160   define output parameter p-prop-label-list as character no-undo .
      161   define output parameter p-global          as logical no-undo .
      162   define output parameter p-host           as logical no-undo .
      163   define output parameter p-shop           as logical no-undo .
      164   define output parameter p-store          as logical no-undo .
      165   define output parameter p-db             as logical no-undo .
      166   define output parameter p-region         as logical no-undo .
      167   do
      168   on error undo, return error return-value
      169   :
      170       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      171       (input  p-upper-code
      172       ,input  p-code
      173       ,output p-label
      174       ,output p-user-can-edit
      175       ,output p-output-display
      176       ,output p-other
      177       ,output p-prop-list
      178       ,output p-prop-type-list
      179       ,output p-prop-label-list
      180       ,output p-global
      181       ,output p-host
      182       ,output p-shop
      183       ,output p-store
      184       ,output p-db
      185       ,output p-region
      186       ) no-error .
      187     if error-status :error
      188     then do:
      189       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      190     end.
      191   end.
      192   end procedure.
