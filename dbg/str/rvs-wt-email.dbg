        1   block-level on error undo, throw.
        2   define input parameter p-rvs-code as character no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: rvs-wt-email.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/rvs-wt-email.p $":U .
        8   define variable vss-description as character no-undo init "Отправка емайла при воде в линии сверки".
        9   define variable v-param-type as character no-undo .
       10   define variable v-value-date as date no-undo .
       11   define variable v-value-decimal as decimal no-undo .
       12   define variable v-value-integer as INTEGER no-undo .
       13   define variable v-value-logical AS LOGICAL no-undo .
       14   define variable v-tth as handle no-undo .
       15   define variable v-emails as character no-undo.
       16   define buffer buf_rvs-line for ub.rvs-line.
       17   define buffer buf_rvs-doc for ub.rvs-doc.
       18   define stream fs1.
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   find first buf_rvs-doc no-lock
       89       where buf_rvs-doc.rvs-code = p-rvs-code
       90       no-error.
       91   if not available buf_rvs-doc then
       92       run write-error(subst("Сверка &1 не найдена", p-rvs-code)) no-error.
       93   run adm/shattri.p (
       94       input "get":U
       95       ,input  buf_rvs-doc.obj-type
       96       ,input  buf_rvs-doc.obj-code
       97       ,input  'petrol':U
       98       ,input  'rvs-wt-email':U
       99       ,output v-emails
      100       ,output v-value-date
      101       ,output v-value-decimal
      102       ,output v-value-integer
      103       ,output v-value-logical
      104       ,output v-param-type
      105       ,INPUT-OUTPUT table-handle v-tth
      106   ) no-error .
      107   if v-emails = ? or v-emails = "" then
      108       return.
      109   for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = p-rvs-code:
      110       if (buf_rvs-line.level-water <> ? and buf_rvs-line.level-water <> 0) or (buf_rvs-line.state-level-water <> ? and buf_rvs-line.state-level-water <> 0) then do:
      111           run send-messages no-error.
      112           if error-status:error then
      113               run write-error(return-value) no-error.
      114       end.
      115   end.
      116   procedure send-messages:
      117       define variable email as character no-undo.
      118       define variable num as integer no-undo.
      119       define variable i as integer no-undo.
      120       define variable subject as character no-undo.
      121       define variable body as character no-undo.
      122       define variable obj as character no-undo.
      123       define variable rvs as character no-undo.
      124       define variable pl as character no-undo.
      125       define variable gds as character no-undo.
      126       define buffer buf_place for ub.place.
      127       define buffer buf_goods for ub.goods.
      128       find first buf_place no-lock
      129           where buf_place.pl-code = buf_rvs-line.pl-code.
      130       find first buf_goods no-lock
      131           where buf_goods.gds-code = buf_rvs-line.gds-code.
      132       num = num-entries (v-emails).
      133       subject = "Вода в сверке".
      134       body = " Объект &1 ~n Сверка &2 ~n Складское место &3 ~n Товар &4".
      135       obj = subst("&1 &2", buf_rvs-line.obj-type, buf_rvs-line.obj-code).
      136       rvs = subst("&1 &2 &3", buf_rvs-line.rvs-code, buf_rvs-doc.fact-date, string(buf_rvs-doc.fact-time, "HH:MM")).
      137       pl = subst("&1 &2", buf_place.pl-code, buf_place.pl-name).
      138       gds = subst("&1 &2", buf_goods.gds-code, buf_goods.gds-name).
      139       body = subst(body, obj, rvs, pl, gds).
      140       do i = 1 to num:
      141           email = trim(entry(i, v-emails)).
      142           if email = ? or email = "" then next.
      143           run gbl/sendmail.p(
      144               email,
      145               subject,
      146               body,
      147               ""
      148           ) no-error.
      149           if error-status:error then
      150               run write-error(subst("Ошибка при отправке на почту &1 - &2", email, return-value)) no-error.
      151       end.
      152   end.
      153   procedure write-error:
      154       define input parameter p-str as character no-undo.
      155       output stream fs1 to value("rvs_water_email_errors.txt").
      156       put stream fs1 unformatted p-str skip.
      157       output stream fs1 close.
      158   end.
