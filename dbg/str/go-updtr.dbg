        1   define input  parameter  ParParentProc as handle no-undo .
        2   define input  parameter  P-Parent as handle no-undo .
        3   define input-output parameter  p-value     as character no-undo .
        4   define input-output parameter  p-full-name as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable v-mode as character no-undo .
       70   define variable ref-rec   as recid no-undo .
       71   define variable rep-rec2 as recid no-undo .
       72   v-mode = 'ИЗМЕНЕНИЕ':U .
       73   DEFINE BUTTON B-Cancel AUTO-END-KEY
       74        LABEL "&Отмена"
       75        SIZE 10 BY 1
       76        BGCOLOR 8 .
       77   DEFINE BUTTON B-clear
       78        LABEL "&Очистить"
       79        SIZE 10 BY 1 TOOLTIP "Очистить значение"
       80        BGCOLOR 8 .
       81   DEFINE BUTTON B-Help
       82        LABEL "&Help"
       83        SIZE 6 BY 1
       84        BGCOLOR 8 .
       85   DEFINE BUTTON B-OK AUTO-GO
       86        LABEL "&Ввод"
       87        SIZE 10 BY 1
       88        BGCOLOR 8 .
       89   DEFINE BUTTON r-cli
       90        IMAGE-UP FILE "btn-down-arrow":U
       91        IMAGE-DOWN FILE "btn-down-arrow":U
       92        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       93        LABEL "r-cli"
       94        SIZE 3 BY 1.
       95   DEFINE VARIABLE cli AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
       96        VIEW-AS FILL-IN
       97        SIZE 10.5 BY 1 NO-UNDO.
       98   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(256)":U
       99         VIEW-AS TEXT
      100        SIZE 37 BY .67
      101        FGCOLOR 1  NO-UNDO.
      102   DEFINE VARIABLE cli-type AS CHARACTER FORMAT "X(3)":U
      103        LABEL "Грузоотправитель"
      104        VIEW-AS FILL-IN
      105        SIZE 4 BY 1 NO-UNDO.
      106   DEFINE FRAME Dialog-Frame
      107        B-OK AT ROW 1 COL 1
      108        B-Cancel AT ROW 1 COL 11
      109        B-clear AT ROW 1 COL 21 WIDGET-ID 10
      110        B-Help AT ROW 1 COL 74
      111        cli-type AT ROW 3.75 COL 22 COLON-ALIGNED WIDGET-ID 4
      112        r-cli AT ROW 3.75 COL 28.5 WIDGET-ID 6
      113        cli AT ROW 3.75 COL 30 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      114        cli-name AT ROW 3.92 COL 41 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      115        SPACE(0.37) SKIP(4.48)
      116       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      117            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      118            TITLE "<insert dialog title>"
      119            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      120   ASSIGN
      121          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      122          FRAME Dialog-Frame:HIDDEN           = TRUE.
      123   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      124   DO:
      125     APPLY "END-ERROR":U TO SELF.
      126   END.
      127   ON CHOOSE OF B-clear IN FRAME Dialog-Frame
      128   DO:
      129     if v-mode = 'ПРОСМОТР':U then return.
      130     assign
      131       cli = 0
      132       cli-type = ""
      133     .
      134       p-value      = "" .
      135       p-full-name  = "" .
      136       cli-name     = "" .
      137       display  cli  cli-type cli-name  with frame Dialog-Frame .
      138   END.
      139   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      140   OR HELP OF FRAME Dialog-Frame
      141   DO:
      142   END.
      143   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      144   DO:
      145   define buffer buf_clients for ub.clients  .
      146     if v-mode = 'ПРОСМОТР':U then return.
      147     assign
      148       cli
      149       cli-type
      150     .
      151      find first buf_clients no-lock where
      152           buf_clients.obj-code = cli and
      153           buf_clients.obj-type = cli-type no-error .
      154           if not available buf_clients and  not(
      155              cli = 0 and cli-type = "" )
      156           then do:
      157              message "Не верно введен Грузопоотправитель!" view-as alert-box error .
      158              return no-apply.
      159           end.
      160       if cli = 0 and cli-type = "" then do:
      161           p-value      = "" .
      162           p-full-name  = "" .
      163       end.
      164       else do:
      165         p-value      = trim(cli-type) + string(cli)  .
      166         p-full-name  = buf_clients.obj-name          .
      167       end.
      168   END.
      169   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      170   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      171   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
      173   DO:
      174      run proc-r-cli in this-procedure .
      175   END.
      176   ON LEAVE OF cli IN FRAME Dialog-Frame
      177   DO:
      178      run leave-proc-cli in this-procedure .
      179   END.
      180   procedure leave-proc-cli :
      181    do
      182    on error undo, return error return-value
      183    :
      184   define buffer cli-clients for ub.clients.
      185     Assign frame Dialog-Frame cli  cli-type .
      186     if cli-type = "" then do:
      187        find cli-clients no-lock where  cli-clients.obj-code = cli no-error.
      188        if not error-status :error  then
      189        assign
      190          cli-type  =  cli-clients.obj-type
      191          cli-name  =  cli-clients.obj-name
      192        .
      193        Display  cli cli-type cli-name with frame Dialog-Frame.
      194     end.
      195     else do:
      196        find first  cli-clients no-lock where  cli-clients.obj-code = cli  and cli-clients.obj-type  = cli-type no-error.
      197        if available cli-clients then
      198        assign
      199          cli-type  =  cli-clients.obj-type
      200          cli-name  =  cli-clients.obj-name
      201        .
      202        else run proc-r-cli .
      203        Display  cli cli-type cli-name with frame Dialog-Frame.
      204     end.
      205   end.
      206   end procedure.
      207   ON  RETURN OF cli IN FRAME Dialog-Frame
      208   DO:
      209       if cli = ?  then run proc-r-cli in this-procedure .
      210       apply "entry" to cli-type in frame Dialog-Frame.
      211       return no-apply .
      212   END.
      213   ON MOUSE-SELECT-DBLCLICK OF cli IN FRAME Dialog-Frame
      214   DO:
      215     apply "choose" to r-cli in frame Dialog-Frame.
      216     apply "entry" to cli in frame Dialog-Frame.
      217     return no-apply .
      218   end.
      219   Procedure proc-r-cli :
      220    do
      221    on error undo, return error return-value
      222    :
      223     define variable rid-list    as  char no-undo .
      224     define buffer cli#clients for ub.clients.
      225       run ref/cli-all.w
      226       ( input parParentProc,
      227         input "b-sel",
      228         input 'все':U,
      229         input ?,
      230         input ?,
      231         input ref-rec ,
      232         input ",,,,,,NO"   ,
      233         input "",
      234         output  rid-list
      235         ) .
      236       Assign
      237         rep-rec2 = integer(rid-list)
      238         ref-rec = integer(rid-list)
      239         no-error.
      240       find first cli#clients where recid(cli#clients) = rep-rec2 no-lock no-error.
      241       if available cli#clients then
      242           Assign
      243               cli      = cli#clients.obj-code
      244               cli-name = cli#clients.obj-name
      245               cli-type = cli#clients.obj-type
      246                .
      247       Display cli cli-type cli-name with frame Dialog-Frame .
      248   end.
      249   end procedure.
      250   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   on help of frame Dialog-Frame
      252   do:
      253     run gbl/app_help.p
      254       (input this-procedure :file-name
      255       ,input ''
      256       ,input ?
      257       ) no-error.
      258     if error-status :error then do:
      259       message
      260         "Ошибка при вызове помощи"
      261         error-status :get-message(1)
      262         view-as alert-box .
      263     end.
      264   end.
      265   run minbtn-set in this-procedure .
      266   on choose of b-help in frame Dialog-Frame
      267   do:
      268     apply "help":u to frame Dialog-Frame .
      269   end.
      270   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   procedure minbtn-set :
      272       do
      273           on error undo, return error return-value
      274           :
      275           define variable ii              as integer       no-undo .
      276           define variable fh              as widget-handle no-undo .
      277           define variable hh              as widget-handle no-undo .
      278           define variable v-h             as handle        extent 4 no-undo .
      279           define variable v-name-button   as character     no-undo .
      280           define variable v-help-old-x    as decimal       no-undo .
      281           define variable v-help-old-y    as decimal       no-undo .
      282           define variable v-help-old-size as decimal       no-undo .
      283           define variable v-frame-width   as decimal       no-undo .
      284           define variable jj              as integer       no-undo .
      285           do
      286               on error undo, return error
      287               :
      288               assign
      289                   v-frame-width = frame Dialog-Frame:width - 0.3
      290                   fh            = frame Dialog-Frame:first-child
      291                   hh            = fh:first-child
      292                   ii            = 1
      293                   .
      294               do while valid-handle(hh):
      295                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      296                   do:
      297                       case lc(hh:name) :
      298                           when "b-help" then
      299                               do:
      300                                   hh:load-image-up("cmp/b-help.bmp":u) .
      301                                   hh:load-image-down("cmp/b-help.bmp":u) .
      302                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      303                                   hh:TOOLTIP = "Помощь" .
      304                                   v-help-old-x = hh:column .
      305                                   v-help-old-y = hh:row    .
      306                                   v-help-old-size = hh:width .
      307                                   hh:width-chars = 2.5 .
      308                               end.
      309                           when "b-print" then
      310                               do:
      311                                   hh:load-image("cmp/b-print.bmp":u) .
      312                                   hh:TOOLTIP = "Печать" .
      313                                   v-h[ii] = hh:handle .
      314                                   ii = ii + 1 .
      315                                   hh:width-chars = 3 .
      316                               end.
      317                           when "b-history" or
      318                           when "b-hist" then
      319                               do:
      320                                   hh:load-image("cmp/b-hist.bmp":u) .
      321                                   hh:TOOLTIP = "История" .
      322                                   v-h[ii] = hh:handle .
      323                                   ii = ii + 1 .
      324                                   hh:width-chars = 3 .
      325                               end.
      326                           when "b-sch" then
      327                               do:
      328                                   hh:load-image("cmp/b-sch.bmp":u) .
      329                                   hh:TOOLTIP = "Установка Фильтра" .
      330                                   v-h[ii] = hh:handle .
      331                                   ii = ii + 1 .
      332                                   hh:width-chars = 3 .
      333                               end.
      334                           when "b-hist-user" then
      335                               do:
      336                                   hh:load-image("cmp/b-hist.bmp":u) .
      337                                   hh:TOOLTIP = "История пользователя" .
      338                                   ii = ii + 1 .
      339                               end.
      340                       end case.
      341                   end.
      342                   hh = hh:next-sibling.
      343               end.
      344               b-help:column = v-frame-width - b-help:width-chars.
      345               jj = 0.
      346               repeat ii = 4 to 1 by -1 :
      347                   if valid-handle (v-h[ii] ) then
      348                   do:
      349                       jj  = jj + 1 .
      350                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      351                       v-h[ii]:row    = v-help-old-y .
      352                   end.
      353               end.
      354           end.
      355       end.
      356   end procedure.
      357   MAIN-BLOCK:
      358   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      359      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      360     frame Dialog-Frame:title = "Определение грузопоотправитель" .
      361     assign
      362       cli = integer(substring(p-value,4,10))
      363       cli-type = substring(p-value,1,3)
      364       no-error .
      365     if error-status :error then do:
      366         assign
      367           cli = 0
      368           cli-type = ""
      369           .
      370      end.
      371      else do:
      372       apply "LEAVE"  to cli  in frame Dialog-Frame .
      373      end.
      374     RUN enable_UI.
      375     if v-mode <> 'ИЗМЕНЕНИЕ':U then do:
      376        disable cli cli-type r-cli cli-name  b-clear  with frame Dialog-Frame.
      377        B-ok:label = "Вы&ход"  .
      378        hide B-cancel in frame Dialog-Frame .
      379     END.
      380     WAIT-FOR GO OF FRAME Dialog-Frame.
      381   END.
      382   RUN disable_UI.
      383   PROCEDURE disable_UI :
      384     HIDE FRAME Dialog-Frame.
      385   END PROCEDURE.
      386   PROCEDURE enable_UI :
      387     DISPLAY cli-type cli cli-name
      388         WITH FRAME Dialog-Frame.
      389     ENABLE B-OK B-Cancel B-clear B-Help cli-type r-cli cli cli-name
      390         WITH FRAME Dialog-Frame.
      391     VIEW FRAME Dialog-Frame.
      392   END PROCEDURE.
