     3907   END CASE.
     3908   end.
     3909   Open QUery br-changes for each temp-changes.
     3910   END PROCEDURE.
     3911   PROCEDURE set-filter-name :
     3912   define input parameter p-filter-name as character no-undo .
     3913     do with frame Dialog-Frame:
     3914       if p-filter-name > "" then do:
     3915         assign
     3916           frame Dialog-Frame:title
     3917             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3918         .
     3919         assign
     3920           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     3921         .
     3922       end.
     3923       else do:
     3924         assign
     3925           b-sch :TOOLTIP = ""
     3926         .
     3927       end.
     3928     end.
     3929   END PROCEDURE.
     3930   FUNCTION sel-abbr RETURNS CHARACTER
     3931    ( p-curr-code as int ) :
     3932     define variable rr as character no-undo .
     3933     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
     3934     rr = currency.curr-abbr .
     3935     RETURN rr.
     3936   END FUNCTION.
     3937   FUNCTION val-abbr-type RETURNS CHARACTER
     3938   ( input p-rec as recid ) :
     3939   define  BUFFER loc-fin-liab FOR c-fin-ob .
     3940   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     3941   if error-status :error then return '' .
     3942     define variable rr as character no-undo .
     3943        find first currency no-lock where  currency.curr-code  = loc-fin-liab.curr-code no-error.
     3944     rr = currency.curr-abbr .
     3945   if available currency then  rr = currency.curr-abbr .
     3946   else rr = ""   .
     3947     RETURN rr.
     3948   END FUNCTION.
