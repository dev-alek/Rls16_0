     1144        buf_c-fin-liab.prn-doc-code    COLUMN-LABEL '№ док-та'  Format "x(10)"
     1145        substring(string(buf_c-fin-liab.doc-date),1,5)    COLUMN-LABEL 'Создан'  format "x(5)"
     1146        buf_c-fin-liab.fact-date    COLUMN-LABEL 'Закрыт'  format "99/99/99"
     1147        buf_c-fin-liab.contract-code    COLUMN-LABEL 'Договор'
     1148        buf_c-fin-liab.receiver-type + " " + string(buf_c-fin-liab.receiver-code)    COLUMN-LABEL 'Получатель'  Format "x(10)"
     1149        buf_c-fin-liab.payer-type + " " + string(buf_c-fin-liab.payer-code)    COLUMN-LABEL 'Плательщик'  Format "x(10)"
     1150        buf_c-fin-liab.pay-date    COLUMN-LABEL 'Платеж'  format "99/99/99"
     1151        val-abbr-type(recid( buf_c-fin-liab))   COLUMN-LABEL 'Вал' Format "x(3)"
     1152        buf_c-fin-liab.sum-doc   COLUMN-LABEL 'Сумма в валюте док-та'
     1153        buf_c-fin-liab.doc-code   COLUMN-LABEL 'Внутр.№' Format "99999999"
     1154        buf_c-fin-liab.corr-date   COLUMN-LABEL 'Дата изменения'
     1155        buf_c-fin-liab.corr-doc-code   COLUMN-LABEL 'Документ изменения'
     1156        string(buf_c-fin-liab.corr-time,'hh:mm:ss')   COLUMN-LABEL 'Время изменения '  LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1157        buf_c-fin-liab.corr-user-db-num   COLUMN-LABEL 'Изменение с БД №'  format ">>>>9" LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1158        buf_c-fin-liab.corr-user-name   COLUMN-LABEL 'Изменил' LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1159         usrfulnf(buf_c-fin-liab.corr-user-name) COLUMN-LABEL "Кто изменил!ФИО" Format "x(15)" LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1160         buf_c-fin-liab.chip-num
     1161         buf_c-fin-liab.sum-base
     1162         buf_c-fin-liab.sum-rubl
     1163         buf_c-fin-liab.sum-contract
     1164         buf_c-fin-liab.con-stat
     1165         buf_c-fin-liab.con-sum-base
     1166         buf_c-fin-liab.con-sum-rubl
     1167         buf_c-fin-liab.con-sum-base
     1168         buf_c-fin-liab.con-sum-rubl
     1169         buf_c-fin-liab.con-sum-contr
     1170         buf_c-fin-liab.contract-curr     COLUMN-LABEL  "вал.договора"
     1171         buf_c-fin-liab.contract-rate     COLUMN-LABEL  "вал.дог м"
     1172         buf_c-fin-liab.contract-scale    COLUMN-LABEL  "вал.дог ш"
     1173         buf_c-fin-liab.base-rate         COLUMN-LABEL  "баз.вал. м"
     1174         buf_c-fin-liab.base-scale        COLUMN-LABEL  "баз.вал. ш"
     1175         buf_c-fin-liab.curr-code         COLUMN-LABEL  "вал.платежа"
     1176         buf_c-fin-liab.exch-rate         COLUMN-LABEL  "баз.пл. м"
     1177         buf_c-fin-liab.exch-scale        COLUMN-LABEL  "баз.пл. ш"
     1178         buf_c-fin-liab.corr-doc
     1179         buf_c-fin-liab.is-back-date
     1180         buf_c-fin-liab.is-corr
     1181         buf_c-fin-liab.is-del
     1182         buf_c-fin-liab.is-doc-del
     1183        enable buf_c-fin-liab.doc-type
     1184       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 90 BY 8.92.
     1185   DEFINE FRAME Dialog-Frame
     1186        B-Cancel AT ROW 1 COL 1
     1187        B-mark AT ROW 1 COL 11.5
     1188        B-sel AT ROW 1 COL 21
     1189        B-lookup AT ROW 1 COL 31.13
     1190        B-sch AT ROW 1 COL 41.25
     1191        B-parts AT ROW 1 COL 51.25
     1192        B-Help AT ROW 1 COL 81.5
     1193        BR-docs AT ROW 2.21 COL 1.25
     1194        BR-changes AT ROW 13.92 COL 1
     1195        mark-num AT ROW 1 COL 14.88 NO-LABEL
     1196        loc_receiver-name AT ROW 11.21 COL 2.88
     1197        loc_sum-doc AT ROW 11.21 COL 50 COLON-ALIGNED
     1198        d-abbr AT ROW 11.21 COL 64.63 COLON-ALIGNED NO-LABEL
     1199        loc_payer-name AT ROW 12.04 COL 2.88
     1200        loc_sum-rubl AT ROW 12.04 COL 49.88 COLON-ALIGNED
     1201        r-abbr AT ROW 12.04 COL 64.63 COLON-ALIGNED NO-LABEL
     1202        loc_sum-base AT ROW 12.88 COL 50 COLON-ALIGNED
     1203        v-abbr AT ROW 12.88 COL 64.63 COLON-ALIGNED NO-LABEL
     1204        SPACE(21.24) SKIP(10.03)
     1205       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1206            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1207            TITLE "Финансовые обязательства"
     1208            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
     1209   ASSIGN
     1210          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1211          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1212   ASSIGN
     1213          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1214   ASSIGN
     1215          B-parts:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1216   ASSIGN
     1217          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 4.
     1218   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1219   DO:
     1220     APPLY "END-ERROR":U TO SELF.
     1221   END.
     1222   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1223   DO:
     1224   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   do:
     1226     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1227       (input  v-cntxt-db-num
     1228       ,input  v-cntxt-userid
     1229       ,input  0
     1230       ,input  'actn_fin-liability_lookup':U
     1231       ,input  'firm':U
     1232       ,input  par-host-code
     1233       ,input  '':U
     1234       ,input  0
     1235       ,input  0
     1236       ,input  0
     1237       ,input  0
     1238       ,input  true
     1239       ,output g-log
     1240       )  .
     1241   end.
     1242   if not g-log then  return .
     1243   define variable rr as recid no-undo .
     1244       if available buf_c-fin-liab then do:
     1245           rr = recid( buf_c-fin-liab ).
     1246           p-doc-type = buf_c-fin-liab.doc-type .
     1247           p-status_  = buf_c-fin-liab.status_  .
     1248           run str/fi-liabi.w
     1249           ( input parparentproc ,
     1250             input 'ПРОСМОТР':U ,
     1251             input-output rr ,
     1252             input par-host-code  ,
     1253             input p-doc-type,
     1254             input p-status_
     1255             ).
     1256        end.
     1257   END.
     1258   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1259   DO:
     1260         if available buf_c-fin-liab then do:
     1261   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262   define variable v-str-recid15 as character no-undo .
     1263   define variable v-num-entry15 as integer   no-undo .
     1264   assign
     1265     v-str-recid15 = trim( string( recid( buf_c-fin-liab ) , "->>>>>>>>>>>9":U ) )
     1266     v-num-entry15 = lookup( v-str-recid15 , rid-list )
     1267   .
     1268   if v-num-entry15 > 0 then do:
     1269     assign
     1270       entry( v-num-entry15, rid-list ) = "":U
     1271       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1272     .
     1273   end.
     1274   else do:
     1275     assign
     1276       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1277     .
     1278   end.
     1279           g-log = br-docs:refresh() .
     1280           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1281               g-log = br-docs:select-next-row ().
     1282               apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1283           end.
     1284           if num-entries( rid-list ) = 0
     1285           then
     1286               hide mark-num in frame Dialog-Frame.
     1287           else do:
     1288               mark-num:screen-value in frame Dialog-Frame  = string (num-entries( rid-list )) .
     1289               enable mark-num with frame Dialog-Frame.
     1290               end.
     1291       end.
     1292       apply "entry" to br-docs in frame Dialog-Frame.
     1293   END.
     1294   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1295   DO:
     1296       run str/fi-parts.w
     1297         ( input parParentProc ,
     1298           input buf_c-fin-liab.doc-code ,
     1299           input par-host-code  ) .
     1300   END.
     1301   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1302   DO:
     1303     run proc-b-sch in this-procedure no-error.
     1304     if not available buf_c-fin-liab then run OpenBr in this-procedure (yes, no, '':U).
     1305   END.
     1306   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1307   DO:
     1308       if ( available buf_c-fin-liab ) AND ( rid-list = "" ) then
     1309       rid-list = string( recid( buf_c-fin-liab ) ) .
     1310   END.
     1311   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1312   DO:
     1313      if b-mark:sensitive in frame Dialog-Frame then
     1314     APPLY "CHOOSE" to b-mark.
     1315   END.
     1316   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1317   DO:
     1318       if b-mark:sensitive in frame Dialog-Frame then
     1319     APPLY "CHOOSE" to b-mark.
     1320       else do:
     1321         if b-sel:sensitive in frame Dialog-Frame then
     1322         APPLY "CHOOSE" to b-sel.
     1323       end.
     1324   END.
     1325   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1326   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1327   DO:
     1328         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1329           apply "choose" to b-sel in frame Dialog-Frame.
     1330       else
     1331           apply "choose" to b-lookup in frame Dialog-Frame.
     1332   END.
     1333   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1334   DO:
     1335   if available buf_c-fin-liab then do:
     1336   assign
     1337       loc_receiver-name  = buf_c-fin-liab.receiver-name
     1338       loc_payer-name  = buf_c-fin-liab.payer-name
     1339       loc_sum-base  = buf_c-fin-liab.sum-base
     1340       loc_sum-doc   = buf_c-fin-liab.sum-doc
     1341       loc_sum-rubl  = buf_c-fin-liab.sum-rubl
     1342       d-abbr        = sel-abbr(buf_c-fin-liab.curr-code)
     1343       v-abbr        = sel-abbr(p-base-code)
     1344       .
     1345   end.
     1346   else
     1347    assign
     1348      loc_receiver-name  = ""
     1349      loc_payer-name  = ""
     1350      loc_sum-base  = 0
     1351      loc_sum-doc   = 0
     1352      loc_sum-rubl  = 0
     1353      d-abbr = ""
     1354       .
     1355     display
     1356     loc_receiver-name loc_payer-name loc_sum-base loc_sum-doc loc_sum-rubl
     1357     r-abbr v-abbr  d-abbr
     1358     with frame Dialog-Frame.
     1359     run proc-view-changes in this-procedure no-error.
     1360   END.
     1361   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1362   define buffer buf_file for ub.fin-ob .
     1363   procedure current-db :
     1364    do
     1365    on error undo, return error return-value
     1366    :
     1367   define input parameter  p-host-code as integer no-undo .
     1368   define input parameter  c-host-code as integer no-undo .
     1369   define output parameter ret         as logical no-undo .
     1370   define buffer current_sysconf for ub.sysconf.
     1371   define variable v-current-db as integer no-undo .
     1372   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1373   if error-status :error then return error .
     1374      v-current-db = current_sysconf.firm-db-num .
     1375      ret = true .
     1376   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     1377   if not( ub.sysconf.firm-db-num = v-current-db or
     1378           ub.sysconf.firm-db-num = 0 )
     1379     then do:
     1380     ret = false .
     1381     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     1382     return .
     1383   end.
     1384    end.
     1385   end procedure.
     1386   procedure ver-db :
     1387    do
     1388    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1389    :
     1390   define input parameter  c-host-code as integer no-undo .
     1391   define input parameter  par-ver-db  as integer no-undo .
     1392   define input parameter  p-mess as logical no-undo .
     1393   define output parameter ret         as logical no-undo .
     1394   define buffer current_sysconf for ub.sysconf.
     1395   define variable v-current-db as integer no-undo .
     1396   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1397   if error-status :error then return error .
     1398      v-current-db = current_sysconf.firm-db-num .
     1399      ret = true .
     1400   if not( par-ver-db = v-current-db or
     1401           par-ver-db = 0 )
     1402     then do:
     1403     ret = false .
     1404     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     1405     return .
     1406   end.
     1407    end.
     1408   end procedure.
     1409   procedure fin-ob-code :
     1410    do
     1411    on error undo, return error return-value
     1412    :
     1413     define input  parameter p-db-num as integer no-undo .
     1414     define output parameter p-fin-ob-code  as character no-undo .
     1415     if p-db-num = 0 then
     1416         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
     1417         else
     1418         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
     1419    end.
     1420   end procedure.
     1421   procedure create-fin-liab :
     1422    do
     1423    on error undo, return error return-value
     1424    :
     1425   define input parameter p-ver as logical no-undo .
     1426   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     1427   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     1428   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     1429   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     1430   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     1431   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     1432   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     1433   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     1434   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     1435   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     1436   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     1437   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     1438   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     1439   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     1440   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     1441   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     1442   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     1443   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     1444   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     1445   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     1446   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     1447   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     1448   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     1449   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     1450   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     1451   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     1452   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     1453   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     1454   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     1455   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     1456   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     1457   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     1458   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     1459   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     1460   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     1461   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     1462   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     1463   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     1464   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     1465   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     1466   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     1467   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     1468   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     1469   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     1470   define output parameter p-rec-id as recid no-undo .
     1471   if p-ver then do:
     1472       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1473                                           buf_file.doc-code  = p-doc-code no-error .
     1474       if available buf_file then return error .
     1475   end.
     1476   define variable p-ret as logical no-undo .
     1477   run current-db in this-procedure (
     1478       input p-host-code,
     1479       input p-host-code,
     1480       output p-ret ) .
     1481    if p-ret = no then return.
     1482   p-rec-id = ? .
     1483    create ub.fin-ob.
     1484    assign
     1485      ub.fin-ob.host-code     =     p-host-code
     1486      ub.fin-ob.doc-code      =     p-doc-code
     1487      ub.fin-ob.status_       =     p-status_
     1488      ub.fin-ob.doc-date      =     p-doc-date
     1489      ub.fin-ob.doc-type      =     p-doc-type
     1490      ub.fin-ob.payer-name    =     p-payer-name
     1491      ub.fin-ob.receiver-name =     p-receiver-name
     1492      ub.fin-ob.curr-code     =     p-curr-code
     1493      ub.fin-ob.user-db-num-doc =   p-user-db-num-doc
     1494      ub.fin-ob.user-name-doc   =   p-user-name-doc
     1495      ub.fin-ob.base-rate     =     p-base-rate
     1496      ub.fin-ob.base-scale    =     p-base-scale
     1497      ub.fin-ob.receiver-code =     p-receiver-code
     1498      ub.fin-ob.receiver-type =     p-receiver-type
     1499      ub.fin-ob.contract-code =     p-contract-code
     1500      ub.fin-ob.exch-rate     =     p-exch-rate
     1501      ub.fin-ob.exch-scale    =     p-exch-scale
     1502      ub.fin-ob.contract-curr =     p-contract-curr
     1503      ub.fin-ob.contract-rate =     p-contract-rate
     1504      ub.fin-ob.contract-scale =    p-contract-scale
     1505      ub.fin-ob.fact-date     =     p-fact-date
     1506      ub.fin-ob.fact-order    =     p-fact-order
     1507      ub.fin-ob.host-code     =     p-host-code
     1508      ub.fin-ob.payer-code    =     p-payer-code
     1509      ub.fin-ob.payer-type    =     p-payer-type
     1510      ub.fin-ob.pay-date      =     p-pay-date
     1511      ub.fin-ob.prn-doc-code  =     p-prn-doc-code
     1512      ub.fin-ob.status_       =     p-status_
     1513      ub.fin-ob.sum-doc       =     p-sum-doc
     1514      ub.fin-ob.sum-base      =     p-sum-base
     1515      ub.fin-ob.sum-contract  =     p-sum-contract
     1516      ub.fin-ob.sum-rubl      =     p-sum-rubl
     1517      ub.fin-ob.sum-tax-doc   =     p-sum-tax-doc
     1518      ub.fin-ob.sum-tax-base  =     p-sum-tax-base
     1519      ub.fin-ob.sum-tax-contract =  p-sum-tax-contract
     1520      ub.fin-ob.sum-tax-rubl  =     p-sum-tax-rubl
     1521      ub.fin-ob.sum-doc-orig  =     p-sum-doc-orig
     1522      ub.fin-ob.sum-rubl-orig =     p-sum-rubl-orig
     1523      ub.fin-ob.sum-base-orig =     p-sum-base-orig
     1524      ub.fin-ob.trn-doc-code  =     p-trn-doc-code
     1525      ub.fin-ob.user-db-num-fact =  p-user-db-num-fact
     1526      ub.fin-ob.user-db-num-pay  =  p-user-db-num-pay
     1527      ub.fin-ob.user-name-fact   =  p-user-name-fact
     1528      ub.fin-ob.user-name-pay    =  p-user-name-pay
     1529      ub.fin-ob.in-type          =  p-in-type
     1530      ub.fin-ob.ps               =  p-PS
     1531     no-error .
     1532     if error-status :error then do:
     1533         message vss-include-info16 skip
     1534                 error-status :get-message(1)
     1535                 view-as alert-box error .
     1536         return error .
     1537     end.
     1538     if ub.fin-ob.status_ = 'факт':U then
     1539       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
     1540     p-rec-id = recid(fin-ob) .
     1541    end.
     1542   end procedure.
     1543   procedure create-fin-ob-before :
     1544    do
     1545    on error undo, return error return-value
     1546    :
     1547   define input parameter p-ver as logical no-undo .
     1548   define input parameter p-doc-id              like ub.fin-ob-before.before-code             no-undo .
     1549   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     1550   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     1551   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     1552   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     1553   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     1554   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     1555   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     1556   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     1557   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     1558   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     1559   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     1560   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     1561   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     1562   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     1563   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     1564   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     1565   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     1566   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     1567   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     1568   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     1569   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     1570   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     1571   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     1572   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     1573   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     1574   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     1575   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     1576   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     1577   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     1578   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     1579   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     1580   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     1581   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     1582   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     1583   define input parameter p-trn-doc-code-orig   like ub.fin-ob.trn-doc-code         no-undo .
     1584   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     1585   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     1586   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     1587   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     1588   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     1589   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     1590   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     1591   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     1592   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     1593   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     1594   define output parameter p-rec-id as recid no-undo .
     1595   define buffer buf_file for ub.fin-ob-before .
     1596   if p-ver then do:
     1597       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1598                                           buf_file.doc-code  = p-doc-code  and
     1599                                           buf_file.before-code =  p-doc-id
     1600                                           no-error .
     1601       if available buf_file then return error .
     1602   end.
     1603   define variable p-ret as logical no-undo .
     1604   run current-db in this-procedure  (
     1605       input p-host-code,
     1606       input p-host-code,
     1607       output p-ret ) .
     1608    if p-ret = no then return.
     1609   p-rec-id = ? .
     1610    create ub.fin-ob-before.
     1611    assign
     1612      ub.fin-ob-before.before-code   =  p-doc-id
     1613      ub.fin-ob-before.host-code     =     p-host-code
     1614      ub.fin-ob-before.doc-code      =     p-doc-code
     1615      ub.fin-ob-before.status_       =     p-status_
     1616      ub.fin-ob-before.doc-date      =     p-doc-date
     1617      ub.fin-ob-before.doc-type      =     p-doc-type
     1618      ub.fin-ob-before.payer-name    =     p-payer-name
     1619      ub.fin-ob-before.receiver-name =     p-receiver-name
     1620      ub.fin-ob-before.curr-code     =     p-curr-code
     1621      ub.fin-ob-before.user-db-num-doc =   p-user-db-num-doc
     1622      ub.fin-ob-before.user-name-doc   =   p-user-name-doc
     1623      ub.fin-ob-before.base-rate     =     p-base-rate
     1624      ub.fin-ob-before.base-scale    =     p-base-scale
     1625      ub.fin-ob-before.receiver-code =     p-receiver-code
     1626      ub.fin-ob-before.receiver-type =     p-receiver-type
     1627      ub.fin-ob-before.contract-code =     p-contract-code
     1628      ub.fin-ob-before.exch-rate     =     p-exch-rate
     1629      ub.fin-ob-before.exch-scale    =     p-exch-scale
     1630      ub.fin-ob-before.contract-curr =     p-contract-curr
     1631      ub.fin-ob-before.contract-rate =     p-contract-rate
     1632      ub.fin-ob-before.contract-scale =    p-contract-scale
     1633      ub.fin-ob-before.fact-date     =     p-fact-date
     1634      ub.fin-ob-before.fact-order    =     p-fact-order
     1635      ub.fin-ob-before.host-code     =     p-host-code
     1636      ub.fin-ob-before.payer-code    =     p-payer-code
     1637      ub.fin-ob-before.payer-type    =     p-payer-type
     1638      ub.fin-ob-before.pay-date      =     p-pay-date
     1639      ub.fin-ob-before.prn-doc-code  =     p-prn-doc-code
     1640      ub.fin-ob-before.status_       =     p-status_
     1641      ub.fin-ob-before.sum-doc       =     p-sum-doc
     1642      ub.fin-ob-before.sum-base      =     p-sum-base
     1643      ub.fin-ob-before.sum-contract  =     p-sum-contract
     1644      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
     1645      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
     1646      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
     1647      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
     1648      ub.fin-ob-before.sum-tax-rubl  =     p-sum-tax-rubl
     1649      ub.fin-ob-before.sum-doc-orig  =     p-sum-doc-orig
     1650      ub.fin-ob-before.sum-rubl-orig =     p-sum-rubl-orig
     1651      ub.fin-ob-before.sum-base-orig =     p-sum-base-orig
     1652      ub.fin-ob-before.trn-doc-code  =     p-trn-doc-code
     1653      ub.fin-ob-before.trn-doc-code-orig  =     p-trn-doc-code-orig
     1654      ub.fin-ob-before.user-db-num-fact =  p-user-db-num-fact
     1655      ub.fin-ob-before.user-db-num-pay  =  p-user-db-num-pay
     1656      ub.fin-ob-before.user-name-fact   =  p-user-name-fact
     1657      ub.fin-ob-before.user-name-pay    =  p-user-name-pay
     1658      ub.fin-ob-before.in-type          =  p-in-type
     1659      ub.fin-ob-before.ps               =  p-ps
     1660     no-error .
     1661     if error-status :error then do:
     1662         message vss-include-info16 skip
     1663                 error-status :get-message(1)
     1664                 view-as alert-box error .
     1665         return error .
     1666     end.
     1667     p-rec-id = recid(fin-ob-before) .
     1668    end.
     1669   end procedure.
     1670   procedure make-tax :
     1671    do
     1672    on error undo, return error return-value
     1673    :
     1674   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1675   define input parameter p-host-code as integer no-undo .
     1676   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1677   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1678   define buffer buf_fin-ob       for  ub.fin-ob     .
     1679   define variable v-line              as integer no-undo .
     1680   define variable v-sum               as decimal no-undo .
     1681   define variable v-sum-rubl          as decimal no-undo .
     1682   define variable v-sum-base          as decimal no-undo .
     1683   define variable v-sum-contract      as decimal no-undo .
     1684   define variable v-sum-slt           as decimal no-undo .
     1685   define variable v-sum-rubl-slt      as decimal no-undo .
     1686   define variable v-sum-base-slt      as decimal no-undo .
     1687   define variable v-sum-contract-slt  as decimal no-undo .
     1688   define variable v-sum-vat           as decimal no-undo .
     1689   define variable v-sum-rubl-vat      as decimal no-undo .
     1690   define variable v-sum-base-vat      as decimal no-undo .
     1691   define variable v-sum-contract-vat  as decimal no-undo .
     1692   define variable v-tax-sum           as decimal no-undo .
     1693   define variable v-tax-sum-rubl      as decimal no-undo .
     1694   define variable v-tax-sum-base      as decimal no-undo .
     1695   define variable v-tax-sum-contr     as decimal no-undo .
     1696   define variable v-tax-sum-doc       as decimal no-undo .
     1697   define variable var-doc             as decimal no-undo .
     1698   define variable var-doc-slt         as decimal no-undo .
     1699   define variable var-doc-vat         as decimal no-undo .
     1700   define variable v-basecode as integer no-undo .
     1701   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1703     (input  p-host-code
     1704     ,output v-basecode
     1705     )  .
     1706   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1707                                               buf_fin-ob.doc-code  = p-doc-code
     1708                                               on error undo, return error :
     1709      assign
     1710       v-tax-sum-rubl  = 0
     1711       v-tax-sum-base  = 0
     1712       v-tax-sum-contr = 0
     1713       v-tax-sum-doc   = 0
     1714       v-sum           = 0
     1715       v-sum-rubl      = 0
     1716       v-sum-base      = 0
     1717       v-sum-contract  = 0
     1718       v-sum-vat       = 0
     1719       v-sum-rubl-vat  = 0
     1720       v-sum-base-vat  = 0
     1721       v-sum-contract-vat  = 0
     1722       v-sum-slt           = 0
     1723       v-sum-rubl-slt      = 0
     1724       v-sum-base-slt      = 0
     1725       v-sum-contract-slt  = 0
     1726       v-line = 0
     1727       .
     1728       for each buf_fin-gds-part no-lock where
     1729                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1730                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1731                break  by buf_fin-gds-part.SLT-pc
     1732                       by buf_fin-gds-part.vat-pc
     1733                on error undo, return error :
     1734                 case buf_fin-ob.curr-code:
     1735                   when 0 then do :
     1736                   assign
     1737                   var-doc      =  buf_fin-gds-part.sum-rubl
     1738                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
     1739                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
     1740                   .
     1741                   end.
     1742                   when v-basecode then do :
     1743                   assign
     1744                   var-doc      =  buf_fin-gds-part.sum-base
     1745                   var-doc-slt  =  buf_fin-gds-part.slt-base
     1746                   var-doc-vat  =  buf_fin-gds-part.vat-base
     1747                   .
     1748                   end.
     1749                   when buf_fin-ob.contract-curr then do :
     1750                   assign
     1751                   var-doc      =  buf_fin-gds-part.sum-contract
     1752                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     1753                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     1754                   .
     1755                   end.
     1756                 end case.
     1757                assign
     1758                  v-sum           = v-sum          + var-doc
     1759                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     1760                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     1761                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     1762                  v-sum-slt           = v-sum-slt          + var-doc-slt
     1763                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     1764                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     1765                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     1766                  v-sum-vat           = v-sum-vat          + var-doc-vat
     1767                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     1768                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     1769                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     1770                .
     1771                if last-of(buf_fin-gds-part.vat-pc) then do:
     1772                   v-line = v-line + 1.
     1773                   create buf_fin-ob-tax.
     1774                   assign
     1775                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1776                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1777                       buf_fin-ob-tax.line-num           = v-line
     1778                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1779                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1780                       buf_fin-ob-tax.with-slt           = true
     1781                       buf_fin-ob-tax.with-vat           = true
     1782                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     1783                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     1784                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     1785                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     1786                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     1787                       buf_fin-ob-tax.sum-line-doc        = v-sum
     1788                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     1789                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     1790                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     1791                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     1792                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     1793                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     1794                       .
     1795                       assign
     1796                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1797                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1798                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1799                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1800                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1801                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1802                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1803                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1804                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1805                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1806                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1807                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1808                       .
     1809                       assign
     1810                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     1811                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     1812                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     1813                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     1814                       .
     1815                       assign
     1816                       v-sum  = 0
     1817                       v-sum-rubl      = 0
     1818                       v-sum-base      = 0
     1819                       v-sum-contract  = 0
     1820                       v-sum-slt           =0
     1821                       v-sum-rubl-slt      =0
     1822                       v-sum-base-slt      =0
     1823                       v-sum-contract-slt  =0
     1824                       v-sum-vat           =0
     1825                       v-sum-rubl-vat      =0
     1826                       v-sum-base-vat      =0
     1827                       v-sum-contract-vat  =0
     1828                       .
     1829                 end.
     1830       end.
     1831       assign
     1832         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     1833         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     1834         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     1835         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     1836         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     1837         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     1838         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     1839         buf_fin-ob.base-scale       = 1
     1840         buf_fin-ob.exch-scale       = 1
     1841         buf_fin-ob.contract-scale   = 1
     1842       .
     1843       assign
     1844       v-tax-sum-rubl  = 0
     1845       v-tax-sum-base  = 0
     1846       v-tax-sum-contr = 0
     1847       v-tax-sum-doc   = 0
     1848       v-sum-vat          = 0
     1849       v-sum-rubl-vat     = 0
     1850       v-sum-base-vat     = 0
     1851       v-sum-contract-vat    = 0
     1852       v-sum-slt          = 0
     1853       v-sum-rubl-slt     = 0
     1854       v-sum-base-slt     = 0
     1855       v-sum-contract-slt    = 0
     1856       .
     1857   end.
     1858    end.
     1859   end procedure.
     1860   procedure update-fin-ob_obj :
     1861    do
     1862    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1863    :
     1864   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1865   define input parameter p-host-code as integer no-undo .
     1866   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1867   define buffer buf_fin-ob       for  ub.fin-ob     .
     1868   define variable v-obj-code as integer no-undo init 0 .
     1869   define variable v-obj-type as character no-undo init "" .
     1870   define variable var-fin-calc as integer no-undo .
     1871   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     1872   var-fin-calc = ub.sysconf.fin-calc   .
     1873   if var-fin-calc = 0 then return.
     1874   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1875                                               buf_fin-ob.doc-code = p-doc-code
     1876                                               on error undo, return error :
     1877       for each buf_fin-gds-part no-lock where
     1878                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1879                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1880                on error undo, return error :
     1881             assign
     1882                v-obj-code  =  buf_fin-gds-part.obj-code
     1883                v-obj-type  =  buf_fin-gds-part.obj-type
     1884                .
     1885              leave.
     1886       end.
     1887       assign
     1888         buf_fin-ob.obj-code  =   v-obj-code
     1889         buf_fin-ob.obj-type  =   v-obj-type
     1890       .
     1891   end.
     1892    end.
     1893   end procedure.
     1894   procedure make-tax-rubl :
     1895    do
     1896    on error undo, return error return-value
     1897    :
     1898   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     1899   define input parameter p-host-code as integer no-undo .
     1900   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1901   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1902   define buffer buf_fin-ob       for  ub.fin-ob     .
     1903   define variable v-line    as integer no-undo .
     1904   define variable v-sum         as decimal no-undo .
     1905   define variable v-tax-sum       as decimal no-undo .
     1906   define variable v-tax-sum-rubl  as decimal no-undo .
     1907   define variable v-tax-sum-base  as decimal no-undo .
     1908   define variable v-tax-sum-contr as decimal no-undo .
     1909   define variable v-tax-sum-doc   as decimal no-undo .
     1910   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1911                                               buf_fin-ob.doc-code = p-doc-code
     1912                                               on error undo, return error :
     1913      assign
     1914       v-tax-sum-rubl = 0
     1915       v-tax-sum-base = 0
     1916       v-tax-sum-contr = 0
     1917       v-tax-sum-doc  = 0
     1918       v-sum          = 0
     1919       v-line = 0
     1920       .
     1921       for each buf_fin-gds-part no-lock where
     1922                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1923                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1924                break  by buf_fin-gds-part.SLT-pc
     1925                       by buf_fin-gds-part.vat-pc
     1926                on error undo, return error :
     1927                assign
     1928                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     1929                .
     1930                if last-of(buf_fin-gds-part.vat-pc) then do:
     1931                   v-line = v-line + 1.
     1932                   create buf_fin-ob-tax.
     1933                   assign
     1934                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1935                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1936                       buf_fin-ob-tax.line-num           = v-line
     1937                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1938                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1939                       buf_fin-ob-tax.with-slt           = true
     1940                       buf_fin-ob-tax.with-vat           = true
     1941                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     1942                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     1943                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     1944                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     1945                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     1946                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     1947                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1948                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1949                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     1950                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1951                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1952                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     1953                       .
     1954                       assign
     1955                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1956                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1957                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1958                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1959                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1960                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1961                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1962                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1963                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1964                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1965                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1966                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1967                       .
     1968                       assign
     1969                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     1970                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     1971                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     1972                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     1973                       .
     1974                       v-sum  = 0 .
     1975                 end.
     1976       end.
     1977       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     1978       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     1979       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     1980       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     1981       v-tax-sum-rubl  = 0 .
     1982       v-tax-sum-base  = 0 .
     1983       v-tax-sum-contr = 0 .
     1984       v-tax-sum-doc   = 0 .
     1985   end.
     1986    end.
     1987   end procedure.
     1988   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1989   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1990   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1991   on help of frame Dialog-Frame
     1992   do:
     1993     run gbl/app_help.p
     1994       (input this-procedure :file-name
     1995       ,input ''
     1996       ,input ?
     1997       ) no-error.
     1998     if error-status :error then do:
     1999       message
     2000         "Ошибка при вызове помощи"
     2001         error-status :get-message(1)
     2002         view-as alert-box .
     2003     end.
     2004   end.
     2005   run minbtn-set in this-procedure .
     2006   on choose of b-help in frame Dialog-Frame
     2007   do:
     2008     apply "help":u to frame Dialog-Frame .
     2009   end.
     2010   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2011   procedure minbtn-set :
     2012       do
     2013           on error undo, return error return-value
     2014           :
     2015           define variable ii              as integer       no-undo .
     2016           define variable fh              as widget-handle no-undo .
     2017           define variable hh              as widget-handle no-undo .
     2018           define variable v-h             as handle        extent 4 no-undo .
     2019           define variable v-name-button   as character     no-undo .
     2020           define variable v-help-old-x    as decimal       no-undo .
     2021           define variable v-help-old-y    as decimal       no-undo .
     2022           define variable v-help-old-size as decimal       no-undo .
     2023           define variable v-frame-width   as decimal       no-undo .
     2024           define variable jj              as integer       no-undo .
     2025           do
     2026               on error undo, return error
     2027               :
     2028               assign
     2029                   v-frame-width = frame Dialog-Frame:width - 0.3
     2030                   fh            = frame Dialog-Frame:first-child
     2031                   hh            = fh:first-child
     2032                   ii            = 1
     2033                   .
     2034               do while valid-handle(hh):
     2035                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2036                   do:
     2037                       case lc(hh:name) :
     2038                           when "b-help" then
     2039                               do:
     2040                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2041                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2042                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2043                                   hh:TOOLTIP = "Помощь" .
     2044                                   v-help-old-x = hh:column .
     2045                                   v-help-old-y = hh:row    .
     2046                                   v-help-old-size = hh:width .
     2047                                   hh:width-chars = 2.5 .
     2048                               end.
     2049                           when "b-print" then
     2050                               do:
     2051                                   hh:load-image("cmp/b-print.bmp":u) .
     2052                                   hh:TOOLTIP = "Печать" .
     2053                                   v-h[ii] = hh:handle .
     2054                                   ii = ii + 1 .
     2055                                   hh:width-chars = 3 .
     2056                               end.
     2057                           when "b-history" or
     2058                           when "b-hist" then
     2059                               do:
     2060                                   hh:load-image("cmp/b-hist.bmp":u) .
     2061                                   hh:TOOLTIP = "История" .
     2062                                   v-h[ii] = hh:handle .
     2063                                   ii = ii + 1 .
     2064                                   hh:width-chars = 3 .
     2065                               end.
     2066                           when "b-sch" then
     2067                               do:
     2068                                   hh:load-image("cmp/b-sch.bmp":u) .
     2069                                   hh:TOOLTIP = "Установка Фильтра" .
     2070                                   v-h[ii] = hh:handle .
     2071                                   ii = ii + 1 .
     2072                                   hh:width-chars = 3 .
     2073                               end.
     2074                           when "b-hist-user" then
     2075                               do:
     2076                                   hh:load-image("cmp/b-hist.bmp":u) .
     2077                                   hh:TOOLTIP = "История пользователя" .
     2078                                   ii = ii + 1 .
     2079                               end.
     2080                       end case.
     2081                   end.
     2082                   hh = hh:next-sibling.
     2083               end.
     2084               b-help:column = v-frame-width - b-help:width-chars.
     2085               jj = 0.
     2086               repeat ii = 4 to 1 by -1 :
     2087                   if valid-handle (v-h[ii] ) then
     2088                   do:
     2089                       jj  = jj + 1 .
     2090                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2091                       v-h[ii]:row    = v-help-old-y .
     2092                   end.
     2093               end.
     2094           end.
     2095       end.
     2096   end procedure.
     2097   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2098   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2099   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2100   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2101   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2102   define variable v-diasize-current-frame-height as decimal   no-undo .
     2103   define variable v-diasize-change-size          as logical   no-undo .
     2104   define variable v-diasize-resize-button        as handle    no-undo .
     2105   define variable v-diasize-wndmax               as logical   no-undo .
     2106   define variable v-diasize-wndstore             as logical   no-undo .
     2107   define variable v-diasize-proc-name            as character no-undo .
     2108   define variable v-diasize-browse-handle        as handle    no-undo .
     2109   define variable v-diasize-browse-number        as integer   no-undo .
     2110   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2111   define temp-table temp-diasize-handle no-undo
     2112     field handle-value  as handle
     2113     field save-position as decimal
     2114     index xpk is primary unique handle-value
     2115     .
     2116   define temp-table temp-browse-handle no-undo
     2117     field browse-type   as character
     2118     field browse-number as integer
     2119     field browse-handle as handle
     2120     field original-size as decimal
     2121     index xpk is primary unique browse-type browse-number
     2122     index xie browse-type browse-handle
     2123   .
     2124   procedure diasize_change-height :
     2125     define input  parameter p-change-value  as decimal   no-undo .
     2126     define input  parameter p-move-resize   as logical   no-undo .
     2127     define variable v-field-group-handle    as handle    no-undo .
     2128     define variable v-object-handle         as handle    no-undo .
     2129     define variable v-frame-height          as decimal   no-undo .
     2130     define variable v-frame-virtual-height  as decimal   no-undo .
     2131     define variable v-browse-height         as decimal   no-undo .
     2132     define variable v-window-height         as decimal   no-undo .
     2133     define variable v-window-virtual-height as decimal   no-undo .
     2134     define variable v-change-sign           as integer   no-undo .
     2135     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2136     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2137     if p-change-value > 0
     2138     then do:
     2139       if frame Dialog-Frame :height + p-change-value
     2140           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2141       then do:
     2142         assign
     2143           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2144                           - (frame Dialog-Frame :height-chars)
     2145         .
     2146         if p-change-value <= 0
     2147         then do:
     2148           run diasize_position-resize-button in this-procedure .
     2149           return .
     2150         end.
     2151       end.
     2152     end.
     2153     if p-change-value < 0
     2154     then do:
     2155       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2156       then do:
     2157         assign
     2158           p-change-value = v-diasize-orig-frame-height
     2159                          - (frame Dialog-Frame :height-chars)
     2160         .
     2161         if p-change-value >= 0
     2162         then do:
     2163           run diasize_position-resize-button in this-procedure .
     2164           return .
     2165         end.
     2166       end.
     2167     end.
     2168     if p-change-value >= 0
     2169     then do:
     2170       assign
     2171         v-change-sign = 1
     2172       .
     2173     end.
     2174     else do:
     2175       assign
     2176         v-change-sign = -1
     2177       .
     2178     end.
     2179     assign
     2180       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2181     .
     2182     if p-change-value = 0
     2183     then do:
     2184       run diasize_position-resize-button in this-procedure .
     2185       return .
     2186     end.
     2187     move_block:
     2188     do
     2189     on error undo move_block, retry move_block
     2190     :
     2191       if retry
     2192       then do:
     2193         do
     2194         on error undo move_block, leave move_block
     2195         :
     2196           if p-change-value > 0
     2197           then do:
     2198             for each buf_temp-diasize-handle
     2199             on error undo, next
     2200             :
     2201               assign
     2202                 v-object-handle = buf_temp-diasize-handle.handle-value
     2203               .
     2204               if v-object-handle <> v-diasize-resize-button
     2205               then do:
     2206                 assign
     2207                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2208                 .
     2209               end.
     2210             end.
     2211             assign
     2212               v-diasize-browse-handle :height = v-browse-height
     2213             .
     2214             for each buf_temp-browse-handle
     2215               where buf_temp-browse-handle.browse-type = 'height':u
     2216             on error undo, next
     2217             :
     2218               assign
     2219                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2220               .
     2221             end.
     2222             assign
     2223               frame Dialog-Frame :height = v-frame-height
     2224             .
     2225             if frame Dialog-Frame :scrollable = true
     2226             then do:
     2227               assign
     2228                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2229               .
     2230             end.
     2231             run diasize_position-resize-button in this-procedure .
     2232           end.
     2233           else do:
     2234             if frame Dialog-Frame :scrollable = true
     2235             then do:
     2236               assign
     2237                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2238               .
     2239             end.
     2240             assign
     2241               frame Dialog-Frame :height = v-frame-height
     2242             .
     2243             assign
     2244               v-diasize-browse-handle :height = v-browse-height
     2245             .
     2246             for each buf_temp-browse-handle
     2247               where buf_temp-browse-handle.browse-type = 'height':u
     2248             on error undo, next
     2249             :
     2250               assign
     2251                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2252               .
     2253             end.
     2254             for each buf_temp-diasize-handle
     2255             on error undo, next
     2256             :
     2257               assign
     2258                 v-object-handle = buf_temp-diasize-handle.handle-value
     2259               .
     2260               if v-object-handle <> v-diasize-resize-button
     2261               then do:
     2262                 assign
     2263                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2264                 .
     2265               end.
     2266             end.
     2267             run diasize_position-resize-button in this-procedure .
     2268           end.
     2269           assign
     2270             v-diasize-change-size = false
     2271           .
     2272           leave move_block .
     2273         end.
     2274       end.
     2275       assign
     2276         v-diasize-need-full-display = true
     2277       .
     2278       if v-diasize-change-size = false
     2279       then do:
     2280         assign
     2281           v-diasize-change-size = true
     2282         .
     2283       end.
     2284       else do:
     2285         return .
     2286       end.
     2287       assign
     2288         v-frame-height = frame Dialog-Frame :height
     2289         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2290         v-browse-height = v-diasize-browse-handle :height
     2291       .
     2292       for each buf_temp-browse-handle
     2293         where buf_temp-browse-handle.browse-type = 'height':u
     2294       :
     2295         assign
     2296           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2297         .
     2298       end.
     2299       for each buf_temp-diasize-handle
     2300       :
     2301         delete buf_temp-diasize-handle .
     2302       end.
     2303       assign
     2304         v-field-group-handle = frame Dialog-Frame :first-child
     2305       .
     2306       do while valid-handle(v-field-group-handle)
     2307       :
     2308         assign
     2309           v-object-handle = v-field-group-handle :first-child
     2310         .
     2311         do while valid-handle(v-object-handle)
     2312         :
     2313           if  v-object-handle <> v-diasize-browse-handle :handle
     2314           and can-query(v-object-handle, "row")
     2315           and can-query(v-object-handle, "height")
     2316           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2317           then do:
     2318             find first buf_temp-browse-handle
     2319               where buf_temp-browse-handle.browse-type   = 'height':u
     2320                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2321               no-error .
     2322             if available buf_temp-browse-handle
     2323             then do:
     2324             end.
     2325             else do:
     2326               create buf_temp-diasize-handle .
     2327               assign
     2328                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2329                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2330               .
     2331             end.
     2332           end.
     2333           assign
     2334             v-object-handle = v-object-handle :next-sibling
     2335           .
     2336         end.
     2337         assign
     2338           v-field-group-handle = v-field-group-handle :next-sibling
     2339         .
     2340       end.
     2341       do with frame Dialog-Frame
     2342       :
     2343         hide v-diasize-resize-button .
     2344         assign
     2345           v-diasize-resize-button :row    = 1
     2346           v-diasize-resize-button :column = 1
     2347         .
     2348       end.
     2349       if p-change-value > 0
     2350       then do:
     2351         if frame Dialog-Frame :scrollable = true
     2352         then do:
     2353           assign
     2354             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2355             no-error .
     2356           if error-status :error
     2357           or error-status :get-message(1) <> ""
     2358           then do:
     2359             undo move_block, retry move_block .
     2360           end.
     2361         end.
     2362         assign
     2363           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2364           no-error .
     2365         if error-status :error
     2366         or error-status :get-message(1) <> ""
     2367         then do:
     2368           undo move_block, retry move_block .
     2369         end.
     2370         assign
     2371           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2372           no-error .
     2373         if error-status :error
     2374         or error-status :get-message(1) <> ""
     2375         then do:
     2376           undo move_block, retry move_block .
     2377         end.
     2378         for each buf_temp-browse-handle
     2379           where buf_temp-browse-handle.browse-type = 'height':u
     2380         on error undo move_block, retry move_block
     2381         :
     2382           assign
     2383             buf_temp-browse-handle.browse-handle :height
     2384               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2385             no-error .
     2386           if error-status :error
     2387           or error-status :get-message(1) <> ""
     2388           then do:
     2389             undo move_block, retry move_block .
     2390           end.
     2391         end.
     2392         for each buf_temp-diasize-handle
     2393         on error undo move_block, retry move_block
     2394         :
     2395           assign
     2396             v-object-handle = buf_temp-diasize-handle.handle-value
     2397           .
     2398           if v-object-handle <> v-diasize-resize-button
     2399           then do:
     2400             assign
     2401               v-object-handle :row = v-object-handle :row + p-change-value
     2402               no-error .
     2403             if error-status :error
     2404             or error-status :get-message(1) <> ""
     2405             then do:
     2406               undo move_block, retry move_block .
     2407             end.
     2408           end.
     2409         end.
     2410       end.
     2411       else do:
     2412         for each buf_temp-diasize-handle
     2413         on error undo move_block, retry move_block
     2414         :
     2415           assign
     2416             v-object-handle = buf_temp-diasize-handle.handle-value
     2417           .
     2418           if v-object-handle <> v-diasize-resize-button
     2419           then do:
     2420             assign
     2421               v-object-handle :row = v-object-handle :row + p-change-value
     2422               no-error .
     2423             if error-status :error
     2424             or error-status :get-message(1) <> ""
     2425             then do:
     2426               undo move_block, retry move_block .
     2427             end.
     2428           end.
     2429         end.
     2430         assign
     2431           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2432           no-error .
     2433         if error-status :error
     2434         or error-status :get-message(1) <> ""
     2435         then do:
     2436           undo move_block, retry move_block .
     2437         end.
     2438         for each buf_temp-browse-handle
     2439           where buf_temp-browse-handle.browse-type = 'height':u
     2440         on error undo move_block, retry move_block
     2441         :
     2442           assign
     2443             buf_temp-browse-handle.browse-handle :height
     2444               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2445             no-error .
     2446           if error-status :error
     2447           or error-status :get-message(1) <> ""
     2448           then do:
     2449             undo move_block, retry move_block .
     2450           end.
     2451         end.
     2452         assign
     2453           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2454           no-error .
     2455         if error-status :error
     2456         or error-status :get-message(1) <> ""
     2457         then do:
     2458           undo move_block, retry move_block .
     2459         end.
     2460         if frame Dialog-Frame :scrollable = true
     2461         then do:
     2462           assign
     2463             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2464             no-error .
     2465           if error-status :error
     2466           or error-status :get-message(1) <> ""
     2467           then do:
     2468             undo move_block, retry move_block .
     2469           end.
     2470         end.
     2471       end.
     2472       if p-move-resize = true
     2473       then do:
     2474         run diasize_position-resize-button in this-procedure .
     2475       end.
     2476       if v-diasize-wndstore = true
     2477       then do:
     2478         if connected("ub") = true
     2479         then do:
     2480           define variable v-cntxt-db-num        as integer   no-undo .
     2481           define variable v-cntxt-userid        as character no-undo .
     2482           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2483                                             , OUTPUT v-cntxt-userid
     2484                                             ) .
     2485           run gbl/wndsizew.p
     2486             (input  v-cntxt-db-num
     2487             ,input  v-cntxt-userid
     2488             ,input  v-diasize-proc-name
     2489             ,input  'height':u
     2490             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2491             ) .
     2492         end.
     2493       end.
     2494     end.
     2495     assign
     2496       v-diasize-change-size = false
     2497     .
     2498   end procedure.
     2499   procedure diasize_set-height :
     2500     define input  parameter p-new-height  as decimal   no-undo .
     2501     define input  parameter p-move-resize as logical   no-undo .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       run diasize_change-height in this-procedure
     2506         (input  (p-new-height - frame Dialog-Frame :height)
     2507         ,input  p-move-resize
     2508         ) .
     2509     end.
     2510   end procedure.
     2511   procedure diasize_change-width :
     2512     define input  parameter p-change-value as decimal   no-undo .
     2513     define input  parameter p-move-resize  as logical   no-undo .
     2514     define variable v-field-group-handle   as handle    no-undo .
     2515     define variable v-object-handle        as handle    no-undo .
     2516     define variable v-frame-width          as decimal   no-undo .
     2517     define variable v-frame-virtual-width  as decimal   no-undo .
     2518     define variable v-browse-width         as decimal   no-undo .
     2519     define variable v-window-width         as decimal   no-undo .
     2520     define variable v-window-virtual-width as decimal   no-undo .
     2521     define variable v-change-sign          as integer   no-undo .
     2522     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2523     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2524     if p-change-value > 0
     2525     then do:
     2526       if frame Dialog-Frame :width + p-change-value >
     2527           session :width-chars
     2528       then do:
     2529         assign
     2530           p-change-value = session :width-chars - frame Dialog-Frame :width
     2531         .
     2532         if p-change-value <= 0
     2533         then do:
     2534           run diasize_position-resize-button in this-procedure .
     2535           return .
     2536         end.
     2537       end.
     2538     end.
     2539     if p-change-value < 0
     2540     then do:
     2541       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2542       then do:
     2543         assign
     2544           p-change-value = v-diasize-orig-frame-width
     2545                          - frame Dialog-Frame :width
     2546         .
     2547         if p-change-value >= 0
     2548         then do:
     2549           run diasize_position-resize-button in this-procedure .
     2550           return .
     2551         end.
     2552       end.
     2553     end.
     2554     if p-change-value >= 0
     2555     then do:
     2556       assign
     2557         v-change-sign = 1
     2558       .
     2559     end.
     2560     else do:
     2561       assign
     2562         v-change-sign = -1
     2563       .
     2564     end.
     2565     assign
     2566       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2567     .
     2568     if p-change-value = 0
     2569     then do:
     2570       run diasize_position-resize-button in this-procedure .
     2571       return .
     2572     end.
     2573     move_block:
     2574     do
     2575     on error undo move_block, leave move_block
     2576     :
     2577       if retry
     2578       then do:
     2579         do
     2580         on error undo move_block, leave move_block
     2581         :
     2582           if p-change-value > 0
     2583           then do:
     2584             for each buf_temp-diasize-handle
     2585             on error undo, next
     2586             :
     2587               assign
     2588                 v-object-handle = buf_temp-diasize-handle.handle-value
     2589               .
     2590               if v-object-handle <> v-diasize-resize-button
     2591               then do:
     2592                 assign
     2593                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2594                 .
     2595               end.
     2596             end.
     2597             assign
     2598               v-diasize-browse-handle :width = v-browse-width
     2599             .
     2600             for each buf_temp-browse-handle
     2601               where buf_temp-browse-handle.browse-type = 'width':u
     2602             on error undo, next
     2603             :
     2604               assign
     2605                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2606               .
     2607             end.
     2608             assign
     2609               frame Dialog-Frame :width = v-frame-width
     2610             .
     2611             if frame Dialog-Frame :scrollable = true
     2612             then do:
     2613               assign
     2614                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2615               .
     2616             end.
     2617             run diasize_position-resize-button in this-procedure .
     2618           end.
     2619           else do:
     2620             if frame Dialog-Frame :scrollable = true
     2621             then do:
     2622               assign
     2623                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2624               .
     2625             end.
     2626             assign
     2627               frame Dialog-Frame :width = v-frame-width
     2628             .
     2629             for each buf_temp-browse-handle
     2630               where buf_temp-browse-handle.browse-type = 'width':u
     2631             on error undo, next
     2632             :
     2633               assign
     2634                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2635               .
     2636             end.
     2637             assign
     2638               v-diasize-browse-handle :width = v-browse-width
     2639             .
     2640             for each buf_temp-diasize-handle
     2641             on error undo, next
     2642             :
     2643               assign
     2644                 v-object-handle = buf_temp-diasize-handle.handle-value
     2645               .
     2646               if v-object-handle <> v-diasize-resize-button
     2647               then do:
     2648                 assign
     2649                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2650                 .
     2651               end.
     2652             end.
     2653             run diasize_position-resize-button in this-procedure .
     2654           end.
     2655           assign
     2656             v-diasize-change-size = false
     2657           .
     2658           leave move_block .
     2659         end.
     2660       end.
     2661       assign
     2662         v-diasize-need-full-display = true
     2663       .
     2664       if v-diasize-change-size = false
     2665       then do:
     2666         assign
     2667           v-diasize-change-size = true
     2668         .
     2669       end.
     2670       else do:
     2671         return .
     2672       end.
     2673       assign
     2674         v-frame-width = frame Dialog-Frame :width
     2675         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2676         v-browse-width = v-diasize-browse-handle :width
     2677       .
     2678       for each buf_temp-browse-handle
     2679         where buf_temp-browse-handle.browse-type = 'width':u
     2680       :
     2681         assign
     2682           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2683         .
     2684       end.
     2685       for each buf_temp-diasize-handle
     2686       :
     2687         delete buf_temp-diasize-handle .
     2688       end.
     2689       assign
     2690         v-field-group-handle = frame Dialog-Frame :first-child
     2691       .
     2692       do while valid-handle(v-field-group-handle)
     2693       :
     2694         assign
     2695           v-object-handle = v-field-group-handle :first-child
     2696         .
     2697         do while valid-handle(v-object-handle)
     2698         :
     2699           if  v-object-handle <> v-diasize-browse-handle :handle
     2700           and v-object-handle <> v-diasize-resize-button
     2701           and can-query(v-object-handle, "row")
     2702           and can-query(v-object-handle, "height")
     2703           and ( v-object-handle :col + v-object-handle :width
     2704                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2705               )
     2706           then do:
     2707             find first buf_temp-browse-handle
     2708               where buf_temp-browse-handle.browse-type   = 'width':u
     2709                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2710               no-error .
     2711             if available buf_temp-browse-handle
     2712             then do:
     2713             end.
     2714             else do:
     2715               create buf_temp-diasize-handle .
     2716               assign
     2717                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2718                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2719               .
     2720             end.
     2721           end.
     2722           assign
     2723             v-object-handle = v-object-handle :next-sibling
     2724           .
     2725         end.
     2726         assign
     2727           v-field-group-handle = v-field-group-handle :next-sibling
     2728         .
     2729       end.
     2730       do with frame Dialog-Frame
     2731       :
     2732         hide v-diasize-resize-button .
     2733         v-diasize-resize-button :row = 1.
     2734         v-diasize-resize-button :column = 1.
     2735       end.
     2736       if p-change-value > 0
     2737       then do:
     2738         if frame Dialog-Frame :scrollable = true
     2739         then do:
     2740           assign
     2741             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2742             no-error .
     2743           if error-status :error
     2744           or error-status :get-message(1) <> ""
     2745           then do:
     2746             undo move_block, retry move_block.
     2747           end.
     2748         end.
     2749         assign
     2750           frame Dialog-Frame :width = v-frame-width + p-change-value
     2751           no-error .
     2752         if error-status :error
     2753         or error-status :get-message(1) <> ""
     2754         then do:
     2755           undo move_block, retry move_block.
     2756         end.
     2757         assign
     2758           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2759         no-error .
     2760         if error-status :error
     2761         or error-status :get-message(1) <> ""
     2762         then do:
     2763           undo move_block, retry move_block.
     2764         end.
     2765         for each buf_temp-browse-handle
     2766           where buf_temp-browse-handle.browse-type = 'width':u
     2767         on error undo move_block, retry move_block
     2768         :
     2769           assign
     2770             buf_temp-browse-handle.browse-handle :width
     2771               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2772             no-error .
     2773           if error-status :error
     2774           or error-status :get-message(1) <> ""
     2775           then do:
     2776             undo move_block, retry move_block .
     2777           end.
     2778         end.
     2779         for each buf_temp-diasize-handle
     2780         on error undo move_block, retry move_block
     2781         :
     2782           assign
     2783             v-object-handle = buf_temp-diasize-handle.handle-value
     2784           .
     2785           if v-object-handle <> v-diasize-resize-button
     2786           then do:
     2787             assign
     2788               v-object-handle :col = v-object-handle :col + p-change-value
     2789               no-error .
     2790             if error-status :error
     2791             or error-status :get-message(1) <> ""
     2792             then do:
     2793               undo move_block, retry move_block .
     2794             end.
     2795           end.
     2796         end.
     2797       end.
     2798       else do:
     2799         for each buf_temp-diasize-handle
     2800         on error undo move_block, retry move_block
     2801         :
     2802           assign
     2803             v-object-handle = buf_temp-diasize-handle.handle-value
     2804           .
     2805           if v-object-handle <> v-diasize-resize-button
     2806           then do:
     2807             assign
     2808               v-object-handle :col = v-object-handle :col + p-change-value
     2809               no-error .
     2810             if error-status :error
     2811             or error-status :get-message(1) <> ""
     2812             then do:
     2813               undo move_block, retry move_block .
     2814             end.
     2815           end.
     2816         end.
     2817         for each buf_temp-browse-handle
     2818           where buf_temp-browse-handle.browse-type = 'width':u
     2819         on error undo move_block, retry move_block
     2820         :
     2821           assign
     2822             buf_temp-browse-handle.browse-handle :width
     2823               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2824             no-error .
     2825           if error-status :error
     2826           or error-status :get-message(1) <> ""
     2827           then do:
     2828             undo move_block, retry move_block .
     2829           end.
     2830         end.
     2831         assign
     2832           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2833           no-error .
     2834         if error-status :error
     2835         or error-status :get-message(1) <> ""
     2836         then do:
     2837           undo move_block, retry move_block.
     2838         end.
     2839         assign
     2840           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2841         no-error .
     2842         if error-status :error
     2843         or error-status :get-message(1) <> ""
     2844         then do:
     2845           undo move_block, retry move_block.
     2846         end.
     2847         if frame Dialog-Frame :scrollable = true
     2848         then do:
     2849           assign
     2850             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2851           no-error .
     2852           if error-status :error
     2853           or error-status :get-message(1) <> ""
     2854           then do:
     2855             undo move_block, retry move_block.
     2856           end.
     2857         end.
     2858       end.
     2859       if p-move-resize
     2860       then do:
     2861         run diasize_position-resize-button in this-procedure .
     2862       end.
     2863       if v-diasize-wndstore = true
     2864       then do:
     2865         if connected("ub") = true
     2866         then do:
     2867           define variable v-cntxt-db-num        as integer   no-undo .
     2868           define variable v-cntxt-userid        as character no-undo .
     2869           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2870                                             , OUTPUT v-cntxt-userid
     2871                                             ) .
     2872           run gbl/wndsizew.p
     2873             (input  v-cntxt-db-num
     2874             ,input  v-cntxt-userid
     2875             ,input  v-diasize-proc-name
     2876             ,input  'width':u
     2877             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2878             ) .
     2879         end.
     2880       end.
     2881     end.
     2882     assign
     2883       v-diasize-change-size = false
     2884     .
     2885   end procedure.
     2886   procedure diasize_set-width :
     2887     define input  parameter p-new-width  as decimal   no-undo .
     2888     define input  parameter p-move-resize as logical   no-undo .
     2889     do
     2890     on error undo, return error return-value
     2891     :
     2892       run diasize_change-width in this-procedure
     2893         (input  (p-new-width - frame Dialog-Frame :width)
     2894         ,input  p-move-resize
     2895         ) .
     2896     end.
     2897   end procedure.
     2898   procedure diasize_position-resize-button :
     2899     do with frame Dialog-Frame
     2900     :
     2901       hide v-diasize-resize-button .
     2902       assign
     2903         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2904                     - 1
     2905                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2906         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2907                     - 1
     2908                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2909       .
     2910       view v-diasize-resize-button .
     2911     end.
     2912   end procedure.
     2913   on alt-right anywhere
     2914   do:
     2915     run diasize_change-width in this-procedure
     2916       (input 1
     2917       ,input true
     2918       ) .
     2919     return no-apply .
     2920   end.
     2921   on alt-left anywhere
     2922   do:
     2923     run diasize_change-width in this-procedure
     2924       (input -1
     2925       ,input true
     2926       ) .
     2927     return no-apply .
     2928   end.
     2929   on alt-down anywhere
     2930   do:
     2931     run diasize_change-height in this-procedure
     2932       (input 1
     2933       ,input true
     2934       ) .
     2935     return no-apply .
     2936   end.
     2937   on alt-up anywhere
     2938   do:
     2939     run diasize_change-height in this-procedure
     2940       (input -1
     2941       ,input true
     2942       ) .
     2943     return no-apply .
     2944   end.
     2945   on alt-enter of frame Dialog-Frame
     2946   do:
     2947     run diasize_maximize in this-procedure
     2948       (input  ?
     2949       ).
     2950     return no-apply .
     2951   end.
     2952   procedure diasize_end-move :
     2953     do
     2954     on error undo, return error return-value
     2955     :
     2956       define variable v-row-delta as decimal   no-undo .
     2957       define variable v-col-delta as decimal   no-undo .
     2958       define variable v-new-row as decimal   no-undo .
     2959       define variable v-new-col as decimal   no-undo .
     2960       assign
     2961         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2962         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2963       .
     2964       assign
     2965         v-row-delta = v-new-row - frame Dialog-Frame :height
     2966         v-col-delta = v-new-col - frame Dialog-Frame :width
     2967       .
     2968       run diasize_change-height in this-procedure
     2969         (input v-row-delta
     2970         ,input true
     2971         ) .
     2972       run diasize_change-width in this-procedure
     2973         (input v-col-delta
     2974         ,input true
     2975         ) .
     2976     end.
     2977   end procedure.
     2978   procedure diasize_maximize :
     2979     define input  parameter p-action as logical   no-undo .
     2980     do
     2981     on error undo, return error return-value
     2982     :
     2983       if p-action = ?
     2984       then do:
     2985         if v-diasize-need-maximize = true
     2986         then do:
     2987           assign
     2988             p-action = true
     2989           .
     2990         end.
     2991         else do:
     2992           assign
     2993             p-action = false
     2994           .
     2995         end.
     2996       end.
     2997       if p-action = true
     2998       then do:
     2999         run diasize_change-height in this-procedure
     3000           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3001               - frame Dialog-Frame :height-chars
     3002           ,input true
     3003           ) .
     3004         run diasize_change-width in this-procedure
     3005           (input session :width-chars
     3006               - frame Dialog-Frame :width-chars
     3007           ,input true
     3008           ) .
     3009         assign
     3010           v-diasize-need-maximize = false
     3011         .
     3012       end.
     3013       else do:
     3014         run diasize_change-width in this-procedure
     3015           (input v-diasize-orig-frame-width
     3016               - frame Dialog-Frame :width-chars
     3017           ,input true
     3018           ) .
     3019         run diasize_change-height in this-procedure
     3020           (input v-diasize-orig-frame-height
     3021               - frame Dialog-Frame :height-chars
     3022           ,input true
     3023           ) .
     3024         assign
     3025           v-diasize-need-maximize = true
     3026         .
     3027       end.
     3028     end.
     3029   end procedure.
     3030   procedure diasize_restore-orig-size :
     3031     do
     3032     on error undo, return error return-value
     3033     :
     3034       assign
     3035         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3036         v-diasize-current-frame-height = frame Dialog-Frame :height
     3037       .
     3038       run diasize_set-height in this-procedure
     3039         (input  v-diasize-orig-frame-height
     3040         ,input  true
     3041         ) .
     3042       run diasize_set-width in this-procedure
     3043         (input  v-diasize-orig-frame-width
     3044         ,input  true
     3045         ) .
     3046     end.
     3047   end procedure.
     3048   procedure diasize_restore-current-size :
     3049     do
     3050     on error undo, return error return-value
     3051     :
     3052       run diasize_set-height in this-procedure
     3053         (input  v-diasize-current-frame-height
     3054         ,input  true
     3055         ) .
     3056       run diasize_set-width in this-procedure
     3057         (input  v-diasize-current-frame-width
     3058         ,input  true
     3059         ) .
     3060     end.
     3061   end procedure.
     3062   procedure diasize_set-browse-handle :
     3063     define input  parameter p-browse-handle as handle   no-undo .
     3064     define buffer buf_temp-browse-handle for temp-browse-handle .
     3065     do
     3066     on error undo, return error return-value
     3067     :
     3068       assign
     3069         v-diasize-browse-handle = p-browse-handle
     3070       .
     3071       for each buf_temp-browse-handle
     3072       on error undo, return error return-value
     3073       :
     3074         delete buf_temp-browse-handle .
     3075       end.
     3076     end.
     3077   end procedure.
     3078   procedure diasize_add_browse :
     3079     define input  parameter p-browse-type   as character no-undo .
     3080     define input  parameter p-browse-handle as handle    no-undo .
     3081     define buffer buf_temp-browse-handle for temp-browse-handle .
     3082     do
     3083     on error undo, return error return-value
     3084     :
     3085       assign
     3086         v-diasize-browse-number = v-diasize-browse-number + 1
     3087       .
     3088       create buf_temp-browse-handle .
     3089       assign
     3090         buf_temp-browse-handle.browse-type   = p-browse-type
     3091         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3092         buf_temp-browse-handle.browse-handle = p-browse-handle
     3093       .
     3094     end.
     3095   end procedure.
     3096   procedure diasize_init :
     3097     define variable v-default-value    as logical   no-undo .
     3098     define variable v-restore-saved    as logical   no-undo .
     3099     define variable v-resize-value-str as character no-undo .
     3100     do
     3101     on error undo, return error return-value
     3102     :
     3103       do with frame Dialog-Frame
     3104       :
     3105         assign
     3106           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3107           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3108           v-diasize-browse-handle     = browse BR-changes :handle
     3109         .
     3110         create button v-diasize-resize-button
     3111         assign
     3112           parent        = frame Dialog-Frame :first-child
     3113           label         = "s"
     3114           height-pixels = 16
     3115           width-pixels  = 16
     3116           visible       = true
     3117           sensitive     = true
     3118           movable       = true
     3119           triggers:
     3120             on end-move persistent run diasize_end-move in this-procedure .
     3121           end triggers.
     3122         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3123         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3124         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3125         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3126         assign
     3127           v-diasize-wndmax = false
     3128         .
     3129         if connected("ub") = true
     3130         then do:
     3131           define variable v-cntxt-db-num        as integer   no-undo .
     3132           define variable v-cntxt-userid        as character no-undo .
     3133           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3134                                             , OUTPUT v-cntxt-userid
     3135                                             ) .
     3136           run gbl/wndpar_r.p
     3137             (input  v-cntxt-db-num
     3138             ,input  v-cntxt-userid
     3139             ,input  'wndmax':U
     3140             ,output v-diasize-wndmax
     3141             ,output v-default-value
     3142             ) .
     3143         end.
     3144         assign
     3145           v-diasize-wndstore = false
     3146         .
     3147         if connected("ub") = true
     3148         then do:
     3149           run gbl/wndpar_r.p
     3150             (input  v-cntxt-db-num
     3151             ,input  v-cntxt-userid
     3152             ,input  'wndstore':U
     3153             ,output v-diasize-wndstore
     3154             ,output v-default-value
     3155             ) .
     3156         end.
     3157         assign
     3158           v-diasize-proc-name = entry(1, program-name(2), '.')
     3159         .
     3160         if v-diasize-wndstore = true
     3161         then do:
     3162           assign
     3163             v-restore-saved = false
     3164           .
     3165           if connected("ub") = true
     3166           then do:
     3167             run gbl/wndsizer.p
     3168               (input  v-cntxt-db-num
     3169               ,input  v-cntxt-userid
     3170               ,input  v-diasize-proc-name
     3171               ,input  'height':u
     3172               ,output v-resize-value-str
     3173               ) .
     3174             if v-resize-value-str <> '':U
     3175             then do:
     3176               run diasize_change-height in this-procedure
     3177                 (input  integer(v-resize-value-str)
     3178                 ,input  true
     3179                 ) .
     3180               assign
     3181                 v-restore-saved = true
     3182               .
     3183             end.
     3184           end.
     3185           if connected("ub") = true
     3186           then do:
     3187             run gbl/wndsizer.p
     3188               (input  v-cntxt-db-num
     3189               ,input  v-cntxt-userid
     3190               ,input  v-diasize-proc-name
     3191               ,input  'width':u
     3192               ,output v-resize-value-str
     3193               ) .
     3194             if v-resize-value-str <> '':U
     3195             then do:
     3196               run diasize_change-width in this-procedure
     3197                 (input  integer(v-resize-value-str)
     3198                 ,input  true
     3199                 ) .
     3200               assign
     3201                 v-restore-saved = true
     3202               .
     3203             end.
     3204           end.
     3205           if v-restore-saved <> true
     3206           then do:
     3207             if v-diasize-wndmax = true
     3208             then do:
     3209               run diasize_maximize in this-procedure
     3210                 (input  true
     3211                 ) .
     3212             end.
     3213           end.
     3214         end.
     3215         else do:
     3216           if v-diasize-wndmax = true
     3217           then do:
     3218             run diasize_maximize in this-procedure
     3219               (input  true
     3220               ) .
     3221           end.
     3222         end.
     3223       end.
     3224     end.
     3225   end procedure.
     3226   procedure diasize_need-full-display :
     3227     define output parameter p-need-full-display as logical   no-undo .
     3228     do
     3229     on error undo, return error return-value
     3230     :
     3231       assign
     3232         p-need-full-display = v-diasize-need-full-display
     3233       .
     3234       assign
     3235         v-diasize-need-full-display = false
     3236       .
     3237     end.
     3238   end procedure.
     3239   procedure get-context :
     3240      define output parameter p-db-num as integer          no-undo.
     3241      define output parameter p-user-id as character        no-undo.
     3242      define variable v-login               as character    no-undo.
     3243      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3244      define buffer buf_user-login  for ub.user-login .
     3245      do
     3246      on error undo, return error
     3247      :
     3248            FIND FIRST buf_sys-ctrl no-lock.
     3249            ASSIGN
     3250               v-login = USERID("ub")
     3251               p-db-num = buf_sys-ctrl.db-num
     3252            .
     3253            FIND FIRST buf_user-login
     3254                 WHERE buf_user-login.db-num = p-db-num
     3255                   AND buf_user-login.user-login = v-login
     3256                 no-lock
     3257                 no-error
     3258                 .
     3259            IF AVAILABLE buf_user-login
     3260            THEN DO:
     3261               assign
     3262                  p-user-id = buf_user-login.user-id
     3263               .
     3264            END.
     3265      end.
     3266   end procedure.
     3267       run diasize_init in this-procedure .
     3268   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3269   DEF VAR cur-clmn-numBR-changes as INT EXTENT 13 no-undo.
     3270   DEF VAR varmviBR-changes       as INT no-undo.
     3271   DEF VAR varmvjBR-changes       as INT no-undo.
     3272   DEF VAR varmvkBR-changes       as INT no-undo.
     3273   DEF VAR varmvlBR-changes       as INT no-undo.
     3274   DEF VAR move-elementBR-changes as INT no-undo.
     3275   def var jjBR-changes           as int no-undo.
     3276   do varmviBR-changes = 1 to EXTENT(cur-clmn-numBR-changes):
     3277     ASSIGN cur-clmn-numBR-changes[varmviBR-changes] = varmviBR-changes.
     3278   END.
     3279   RUN start-mv-clmnBR-changes.
     3280   PROCEDURE start-mv-clmnBR-changes:
     3281   def var old-session as logical no-undo.
     3282      old-session = SESSION:IMMEDIATE-DISPLAY.
     3283      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3284      SESSION:IMMEDIATE-DISPLAY = old-session.
     3285   END.
     3286   ON ctrl-cursor-right OF BROWSE BR-changes do:
     3287     RUN re-move-clmnBR-changes ( 4, 13).
     3288   END.
     3289   ON ctrl-cursor-left OF BROWSE BR-changes do:
     3290     RUN re-move-clmnBR-changes (13, 4).
     3291   END.
     3292   PROCEDURE re-move-clmnBR-changes:
     3293     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3294     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3295     DO varmviBR-changes = 1 TO EXTENT(cur-clmn-numBR-changes):
     3296       if cur-clmn-numBR-changes[varmviBR-changes] = source-column THEN cur-clmn-numBR-changes[varmviBR-changes] = -1.
     3297     END.
     3298     if BR-changes:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3299     if source-column > target-column THEN
     3300     DO varmvjBR-changes = source-column - 1 to target-column BY -1:
     3301       DO varmviBR-changes = 1 TO EXTENT(cur-clmn-numBR-changes):
     3302           if cur-clmn-numBR-changes[varmviBR-changes] = varmvjBR-changes THEN DO:
     3303             cur-clmn-numBR-changes[varmviBR-changes] = cur-clmn-numBR-changes[varmviBR-changes] + 1.
     3304           END.
     3305       END.
     3306     END.
     3307     ELSE
     3308     DO varmvjBR-changes = source-column + 1 to target-column:
     3309       DO varmviBR-changes = 1 TO EXTENT(cur-clmn-numBR-changes):
     3310         if cur-clmn-numBR-changes[varmviBR-changes] = varmvjBR-changes THEN DO:
     3311           cur-clmn-numBR-changes[varmviBR-changes] = cur-clmn-numBR-changes[varmviBR-changes] - 1.
     3312         END.
     3313       END.
     3314     END.
     3315     DO varmviBR-changes = 1 TO EXTENT(cur-clmn-numBR-changes):
     3316       if cur-clmn-numBR-changes[varmviBR-changes] = -1 THEN cur-clmn-numBR-changes[varmviBR-changes] = target-column.
     3317     END.
     3318   END PROCEDURE.
     3319   PROCEDURE ch-clmnBR-changes:
     3320     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3321     if cur-clmn-loc <= 4 then do:
     3322       return .
     3323     end.
     3324     DO varmviBR-changes = 1 TO EXTENT(cur-clmn-numBR-changes):
     3325       if cur-clmn-numBR-changes[varmviBR-changes] = cur-clmn-loc THEN move-elementBR-changes = varmviBR-changes.
     3326     END.
     3327     RUN re-move-clmnBR-changes (cur-clmn-loc, 4).
     3328   END PROCEDURE.
     3329   PROCEDURE mv-brw-defaultBR-changes:
     3330   def var old-session as logical no-undo.
     3331     old-session = SESSION:IMMEDIATE-DISPLAY.
     3332     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3333     do varmvlBR-changes = 4 to EXTENT(cur-clmn-numBR-changes):
     3334       RUN re-move-clmnBR-changes (cur-clmn-numBR-changes[varmvlBR-changes], varmvlBR-changes).
     3335     END.
     3336     RUN start-mv-clmnBR-changes.
     3337     SESSION:IMMEDIATE-DISPLAY = old-session.
     3338   END PROCEDURE.
     3339   .
     3340   def var sort-labelBR-changes   as character no-undo .
     3341   def var sort-clmnBR-changes    as handle    no-undo .
     3342   def var cur-clmnBR-changes     as handle    no-undo .
     3343   def var cur-clmn-locBR-changes as integer   no-undo .
     3344   def var re-queryBR-changes     as logical   initial no no-undo .
     3345   on start-search, ctrl-o of BR-changes in frame Dialog-Frame do:
     3346      run sort-brBR-changes
     3347        (input (if available c-fin-ob
     3348                then recid(c-fin-ob)
     3349                else ?
     3350               )
     3351        ).
     3352   end.
     3353   PROCEDURE sort-brBR-changes :
     3354     define input parameter p-recid as recid no-undo .
     3355     if re-queryBR-changes = no then do:
     3356       assign
     3357          cur-clmnBR-changes = BR-changes:current-column in frame Dialog-Frame
     3358       .
     3359       if sort-clmnBR-changes <> ? then sort-clmnBR-changes:column-fgcolor = 0.
     3360       if cur-clmnBR-changes = sort-clmnBR-changes then do:
     3361         assign
     3362            sort-labelBR-changes = ""
     3363            sort-clmnBR-changes = ?
     3364         .
     3365        end.
     3366        else do:
     3367          assign
     3368            sort-labelBR-changes = cur-clmnBR-changes:label
     3369            sort-clmnBR-changes  = cur-clmnBR-changes
     3370            sort-clmnBR-changes:column-fgcolor = 4
     3371          .
     3372        end.
     3373      end.
     3374     assign
     3375       cur-clmn-locBR-changes = 1
     3376     .
     3377     def var column-handle as handle no-undo .
     3378     column-handle = BR-changes:first-column.
     3379     do while valid-handle(column-handle) :
     3380       if column-handle = cur-clmnBR-changes then do:
     3381         leave .
     3382       end.
     3383       column-handle = column-handle:NEXT-COLUMN.
     3384       assign
     3385         cur-clmn-locBR-changes = cur-clmn-locBR-changes + 1
     3386       .
     3387     end.
     3388     case sort-labelBR-changes:
     3389           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_c-fin-liab), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     3390           when 'Т'  then DO:    assign       sort-column-name = "buf_c-fin-liab.doc-type"     .     run OpenBr (yes, no, '':U).   . END.
     3391           when 'Статус'  then DO:    assign       sort-column-name = "buf_c-fin-liab.status_"     .     run OpenBr (yes, no, '':U).   . END.
     3392           when '№ док-та'  then DO:    assign       sort-column-name = "buf_c-fin-liab.prn-doc-code"     .     run OpenBr (yes, no, '':U).   . END.
     3393           when 'Создан'  then DO:    assign       sort-column-name = "substring(string(buf_c-fin-liab.doc-date),1,5)"     .     run OpenBr (yes, no, '':U).   . END.
     3394           when 'Закрыт'  then DO:    assign       sort-column-name = "buf_c-fin-liab.fact-date"     .     run OpenBr (yes, no, '':U).   . END.
     3395           when 'Договор'  then DO:    assign       sort-column-name = "buf_c-fin-liab.contract-code"     .     run OpenBr (yes, no, '':U).   . END.
     3396           when 'Получатель'  then DO:    assign       sort-column-name = "buf_c-fin-liab.receiver-type + "     .     run OpenBr (yes, no, '':U).   . END.
     3397           when 'Плательщик'  then DO:    assign       sort-column-name = "buf_c-fin-liab.payer-type + "     .     run OpenBr (yes, no, '':U).   . END.
     3398           when 'Платеж'  then DO:    assign       sort-column-name = "buf_c-fin-liab.pay-date"     .     run OpenBr (yes, no, '':U).   . END.
     3399           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1val-abbr-type&1, recid(buf_c-fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     3400           when 'Сумма в валюте док-та'  then DO:    assign       sort-column-name = "buf_c-fin-liab.sum-doc"     .     run OpenBr (yes, no, '':U).   . END.
     3401           when 'Внутр.№'  then DO:    assign       sort-column-name = "buf_c-fin-liab.doc-code"     .     run OpenBr (yes, no, '':U).   . END.
     3402       otherwise do:
     3403         assign
     3404           sort-column-name = ""
     3405         .
     3406         run OpenBr (yes, no, '':U).
     3407           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-changes') then do:
     3408             run mv-brw-defaultBR-changes.
     3409           end.
     3410         if sort-labelBR-changes <> "" then do:
     3411           assign
     3412             cur-clmnBR-changes:column-fgcolor = 0
     3413           .
     3414         end.
     3415         assign
     3416           cur-clmn-locBR-changes = ?
     3417         .
     3418       end.
     3419     end case.
     3420       if cur-clmn-locBR-changes <> ? then do:
     3421         if can-do( this-procedure:internal-entries, 'ch-clmnBR-changes') then do:
     3422           run ch-clmnBR-changes in this-procedure (cur-clmn-locBR-changes).
     3423         end.
     3424       end.
     3425     if p-recid <> ? then do:
     3426       reposition BR-changes to recid p-recid no-error.
     3427       apply "value-changed" to BR-changes in frame Dialog-Frame.
     3428     end.
     3429     apply "entry" to BR-changes in frame Dialog-Frame.
     3430   END PROCEDURE.
     3431   procedure re-open-query-srt-clmnBR-changes:
     3432   if cur-clmnBR-changes = ? then do:
     3433      run OpenBr (yes, no, '':U).
     3434   end.
     3435   else do:
     3436      assign re-queryBR-changes = yes.
     3437      run sort-brBR-changes
     3438        (input (if available c-fin-ob
     3439                then recid(c-fin-ob)
     3440                else ?
     3441               )
     3442        ).
     3443      assign re-queryBR-changes = no.
     3444   end.
     3445   end.
     3446   MAIN-BLOCK:
     3447   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3448      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3449   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3450     run mainmenu_getcntxt in parparentproc
     3451       (output v-cntxt-db-num
     3452       ,output v-cntxt-userid
     3453       ,output v-cntxt-level
     3454       ,output v-cntxt-host-code-obj
     3455       ,output v-cntxt-obj-type
     3456       ,output v-cntxt-obj-code
     3457       ,output v-cntxt-db-num-obj
     3458       ,output v-cntxt-is-admin
     3459       ) .
     3460   buf_c-fin-liab.doc-type:read-only in browse br-docs = true .
     3461   loc_sum-rubl:LABEL = "Сумма руб." .
     3462   define variable p-file-label as character no-undo .
     3463   p-file-label =  "Финансовые обязательства - история".
     3464   define buffer buf_clients for  ub.clients .
     3465   CASE par-mode:
     3466       WHEN 'фирма':U THEN DO:
     3467         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3468         if not available buf_clients then  return .
     3469       END.
     3470       WHEN "doc-type":U THEN DO:
     3471         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3472         if not available buf_clients then  return .
     3473       END.
     3474       WHEN "status":U THEN DO:
     3475         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3476         if not available buf_clients then  return .
     3477       END.
     3478       otherwise do:
     3479         message vss-workfile vss-revision vss-description skip
     3480         "Неверный вызов - par-mode=" par-mode
     3481         view-as alert-box ERROR.
     3482         return.
     3483       end.
     3484     end CASE.
     3485     run my-enable_ui.
     3486     run openbr (yes, no, '':u).
     3487     hide mark-num in frame Dialog-Frame .
     3488     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     3489     wait-for go of frame Dialog-Frame.
     3490   END.
     3491   run disable_ui.
     3492   PROCEDURE add-proc :
     3493   define variable v-doc-rec as recid no-undo .
     3494   if  p-doc-type = ?   then do:
     3495     message  "Добавление финансовых обязательств возможно только  по типам !" view-as alert-box information .
     3496     return .
     3497   end.
     3498   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3499   do:
     3500     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3501       (input  v-cntxt-db-num
     3502       ,input  v-cntxt-userid
     3503       ,input  0
     3504       ,input  'actn_fin-liability_add-def':U
     3505       ,input  'firm':U
     3506       ,input  par-host-code
     3507       ,input  '':U
     3508       ,input  0
     3509       ,input  0
     3510       ,input  0
     3511       ,input  0
     3512       ,input  true
     3513       ,output g-log
     3514       )  .
     3515   end.
     3516   if not g-log then  return .
     3517   define variable rr as recid no-undo .
     3518     run str/fi-liabi.w
     3519       ( input parparentproc,
     3520         input 'ДОБАВЛЕНИЕ':U ,
     3521         input-output rr ,
     3522         input par-host-code  ,
     3523         input p-doc-type,
     3524         input p-status_
     3525         ).
     3526     v-doc-rec = rr .
     3527     run openbr (yes, no, '':u).
     3528     reposition br-docs to recid v-doc-rec no-error .
     3529     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     3530   END PROCEDURE.
     3531   PROCEDURE disable_UI :
     3532     HIDE FRAME Dialog-Frame.
     3533   END PROCEDURE.
     3534   PROCEDURE enable_UI :
     3535     OPEN QUERY Dialog-Frame FOR EACH c-fin-ob SHARE-LOCK.
     3536     GET FIRST Dialog-Frame.
     3537     DISPLAY mark-num loc_receiver-name loc_sum-doc d-abbr loc_payer-name
     3538             loc_sum-rubl r-abbr loc_sum-base v-abbr
     3539         WITH FRAME Dialog-Frame.
     3540     ENABLE B-Cancel B-mark B-sel B-Help BR-docs BR-changes mark-num
     3541            loc_receiver-name loc_sum-doc d-abbr loc_payer-name loc_sum-rubl
     3542            r-abbr loc_sum-base v-abbr
     3543         WITH FRAME Dialog-Frame.
     3544     VIEW FRAME Dialog-Frame.
     3545     OPEN QUERY BR-docs FOR EACH buf_c-fin-liab no-lock.
     3546   END PROCEDURE.
     3547   PROCEDURE my-enable_UI :
     3548   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3550     (input  par-host-code
     3551     ,output p-base-code
     3552     )  .
     3553   DISPLAY   mark-num
     3554         WITH FRAME Dialog-Frame.
     3555     ENABLE B-Cancel
     3556            B-sch
     3557            B-Help
     3558            b-sel       when LOOKUP("b-sel":U,  bttns) > 0
     3559            b-mark      when LOOKUP("b-mark":U, bttns) > 0
     3560            BR-docs   mark-num
     3561            BR-changes
     3562         WITH FRAME Dialog-Frame.
     3563     VIEW FRAME Dialog-Frame.
     3564   END PROCEDURE.
     3565   PROCEDURE OpenBr :
     3566   define input  parameter p-open-query     as logical   no-undo .
     3567   define input  parameter p-find-next      as logical   no-undo .
     3568   define input  parameter p-find-condition as character no-undo .
     3569   def var l-query-was-opened as logical no-undo .
     3570   define variable title0 as character no-undo.
     3571   title0 = caps(p-file-label) + chr(32).
     3572   def var sort-column-phrase as character no-undo .
     3573   case sort-column-name :
     3574     when "" then do:
     3575       assign
     3576         sort-column-phrase = ""
     3577       .
     3578     end.
     3579     otherwise do:
     3580       assign
     3581         sort-column-phrase = "by " + sort-column-name
     3582       .
     3583     end.
     3584   end case.
     3585   define variable l-open-query as logical   no-undo .
     3586          find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3587          if not available buf_clients then return .
     3588          filter-point = filter-point0 + par-mode.
     3589     CASE par-mode :
     3590       WHEN 'фирма':U THEN DO:
     3591          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + " Код фирмы " +  string(par-host-code).
     3592   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3593   define variable  l-disable-where-26  as logical   no-undo .
     3594   define variable  l-filter-open-26    as logical   .
     3595   define variable  flt-rec-26       as recid     no-undo .
     3596   define variable  filter-name-26      as character no-undo .
     3597   define variable  where-phrase-26     as character no-undo .
     3598   define variable  sort-phrase-26      as character no-undo .
     3599   define variable  where-phrase-rus-26 as character no-undo .
     3600   define variable  sort-phrase-rus-26  as character no-undo .
     3601   run gbl/flt-get.p
     3602     (input filter-point
     3603     ,output flt-rec-26
     3604     ,output filter-name-26
     3605     ,output where-phrase-26
     3606     ,output sort-phrase-26
     3607     ,output where-phrase-rus-26
     3608     ,output sort-phrase-rus-26
     3609     ).
     3610   if p-open-query then do:
     3611       run set-filter-name in this-procedure
     3612         (INPUT filter-name-26
     3613         ) no-error .
     3614     assign
     3615       l-filter-open-26 = false
     3616     .
     3617     if flt-rec-26 <> ?
     3618       or sort-column-phrase > ""
     3619     then do:
     3620       define variable  parameter-2-26 as character no-undo .
     3621       define variable  parameter-3-26 as character no-undo .
     3622       define variable  parameter-4-26 as character no-undo .
     3623       define variable  parameter-5-26 as character no-undo .
     3624       define variable  parameter-6-26 as character no-undo .
     3625       define variable  parameter-7-26 as character no-undo .
     3626         assign
     3627         parameter-3-26 =
     3628                                 "FOR EACH buf_c-fin-liab"
     3629         parameter-4-26 =
     3630           (
     3631             if (" buf_c-fin-liab.doc-code = par-doc-code and  buf_c-fin-liab.host-code =  par-host-code  " + " " + where-phrase-26) <> ""
     3632             then   substitute(' buf_c-fin-liab.host-code = &2  and  buf_c-fin-liab.doc-code = &1&3&1'                            , chr(34) , par-host-code , par-doc-code )  + " " + where-phrase-26
     3633             else "true"
     3634           )
     3635         parameter-5-26 = (" " + "" + " " + "")
     3636         parameter-6-26 = if sort-phrase-26 = ''
     3637                              then
     3638           (
     3639           " " + "  " +
     3640             " " + sort-column-phrase +
     3641           " " + "  "
     3642           )
     3643                              else
     3644           (
     3645           " " + "  " +
     3646             " " + sort-column-phrase +
     3647           " " + sort-phrase-26
     3648           )
     3649         parameter-7-26 =
     3650           " indexed-reposition  "
     3651       .
     3652       do
     3653       on stop undo, leave
     3654       on error undo, leave
     3655       :
     3656         assign
     3657           l-disable-where-26 =
     3658             (" buf_c-fin-liab.doc-code = par-doc-code and  buf_c-fin-liab.host-code =  par-host-code  " + " " + where-phrase-26 = "")
     3659         .
     3660         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3661                             ,input query br-docs:handle
     3662                             ,input parameter-3-26
     3663                             ,input parameter-4-26
     3664                             ,input parameter-5-26
     3665                             ,input parameter-6-26
     3666                             ,input parameter-7-26
     3667                             )
     3668         .
     3669         assign
     3670           l-filter-open-26 = true
     3671         .
     3672       end.
     3673       if l-filter-open-26 = false then do:
     3674         message
     3675           "Ошибка при фильтрации / сортировке" skip
     3676           "Будут показаны записи без учета фильтра" skip
     3677           view-as alert-box .
     3678       end.
     3679       else do:
     3680           assign
     3681             l-query-was-opened = true
     3682           .
     3683       end.
     3684     end.
     3685     if l-filter-open-26 = false then do:
     3686       OPEN QUERY br-docs FOR EACH buf_c-fin-liab
     3687         where  buf_c-fin-liab.doc-code = par-doc-code and  buf_c-fin-liab.host-code =  par-host-code
     3688         indexed-reposition
     3689     .
     3690         assign
     3691           l-query-was-opened = true
     3692         .
     3693     end.
     3694   end.
     3695   else do:
     3696     assign
     3697       doc-rec = recid( buf_c-fin-liab )
     3698     .
     3699     do
     3700     on stop undo, leave
     3701     on error undo, leave
     3702     :
     3703       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-fin-liab:handle) then do:
     3704         assign
     3705         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3706         parameter-4-26 =
     3707           "where ":u +   substitute(' buf_c-fin-liab.host-code = &2  and  buf_c-fin-liab.doc-code = &1&3&1'                            , chr(34) , par-host-code , par-doc-code )  + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3708         parameter-5-26 = "  "
     3709       .
     3710         run fltopend_fltfindd in this-procedure  (
     3711                             input this-procedure:handle
     3712                             ,input query br-docs:handle
     3713                             ,input rowid(buf_c-fin-liab)
     3714                             ,input logical(parameter-2-26)
     3715                             ,input no-lock
     3716                             ,input (buffer buf_c-fin-liab:handle)
     3717                             ,input parameter-4-26
     3718                             ,input parameter-5-26
     3719                             ) no-error.
     3720         .
     3721         assign
     3722           doc-rec = integer(return-value)
     3723           v-fltopend-rowid[1] = ?
     3724         .
     3725       end.
     3726       else do:
     3727         assign
     3728         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3729         parameter-3-26 =  "FOR EACH buf_c-fin-liab"
     3730         parameter-4-26 =
     3731           (
     3732             if (" buf_c-fin-liab.doc-code = par-doc-code and  buf_c-fin-liab.host-code =  par-host-code  " + " " + where-phrase-26) <> ""
     3733             then   substitute(' buf_c-fin-liab.host-code = &2  and  buf_c-fin-liab.doc-code = &1&3&1'                            , chr(34) , par-host-code , par-doc-code )  + " " + where-phrase-26
     3734             else "true"
     3735           )
     3736         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3737         parameter-6-26 = if sort-phrase-26 = ''
     3738                              then
     3739           (
     3740           " " + "  " +
     3741             " " + sort-column-phrase +
     3742           " " + "  "
     3743           )
     3744                              else
     3745           (
     3746           " " + "  " +
     3747             " " + sort-column-phrase +
     3748           " " + sort-phrase-26
     3749           )
     3750         parameter-7-26 =
     3751           " indexed-reposition  "
     3752       .
     3753         run fltopend_fltfindq in this-procedure  (
     3754                             input this-procedure:handle
     3755                             ,input query br-docs:handle
     3756                             ,input logical(parameter-2-26)
     3757                             ,input no-lock
     3758                             ,input parameter-3-26
     3759                             ,input parameter-4-26
     3760                             ,input parameter-5-26
     3761                             ,input parameter-6-26
     3762                             ,input parameter-7-26
     3763                             ,output v-fltopend-rowid
     3764                             ) no-error.
     3765         .
     3766         doc-rec = ?.
     3767       end.
     3768       assign
     3769         l-query-was-opened = true
     3770       .
     3771     end.
     3772   end.
     3773       END.
     3774   END CASE.
     3775   if not p-open-query then
     3776   REPOSITION br-docs to recid doc-rec No-ERROR.
     3777   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3778   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     3779   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     3780   APPLY "ENTRY" TO br-docs.
     3781   END PROCEDURE.
     3782   PROCEDURE proc-b-sch :
     3783   assign
     3784     tbl = 'c-fin-ob'
     3785     join-tbl = 'buf_c-fin-liab'
     3786     fld = ""
     3787     lab = ""
     3788     spr = ""
     3789     dim = '0'
     3790     .
     3791   run fltfield-add in this-procedure('doc-code', 'Внутр.№', '',
     3792   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3793   run fltfield-add in this-procedure('prn-doc-code', '№ документа ', '',
     3794   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3795   run fltfield-add in this-procedure('status_', 'Статус', '',
     3796   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3797   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     3798   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3799   run fltfield-add in this-procedure('curr-code', 'Код валюты', '',
     3800   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3801   run fltfield-add in this-procedure('fact-date', 'Закрыт', '',
     3802   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3803   run fltfield-add in this-procedure('pay-date', 'Дата Платежа', '',
     3804   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3805   run fltfield-add in this-procedure('trn-doc-code', 'Накладная', '',
     3806   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3807   run fltfield-add in this-procedure('user-name-doc', 'Создал', '',
     3808   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3809   run fltfield-add in this-procedure('user-name-fact', 'Закрыл на факт', '',
     3810   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3811   run fltfield-add in this-procedure('payer-type*payer-code', 'Плательщик', 'cli',
     3812                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3813   run fltfield-add in this-procedure('receiver-type*receiver-code', 'Получатель', 'cli',
     3814                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3815   run fltfield-add in this-procedure('corr-doc', 'Корр ФО', '',
     3816   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3817   Filter-Block:
     3818   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3819       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3820       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3821     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3822     run openbr (yes, no, '':u).
     3823   END.
     3824   END PROCEDURE.
     3825   PROCEDURE proc-find-code :
     3826   define input parameter par-next as logical no-undo.
     3827   define input parameter pardoc-code as char no-undo.
     3828   assign
     3829     pardoc-code = chr(34) + pardoc-code + chr(34) .
     3830   run OpenBr in this-procedure
     3831       (input false
     3832       ,input par-next
     3833       ,input substitute("and buf_c-fin-liab.prn-doc-code = &1 "
     3834         , pardoc-code)
     3835       ).
     3836   END PROCEDURE.
     3837   PROCEDURE proc-view-changes :
     3838   define buffer new_c-fin-ob for ub.c-fin-ob.
     3839   define buffer current_fin-ob for ub.fin-ob.
     3840   define variable v-chg-fields as character no-undo.
     3841   define variable v-old-fields as character no-undo.
     3842   define variable v-new-fields as character no-undo.
     3843   define variable ii as integer no-undo.
     3844   for each temp-changes:
     3845       delete temp-changes.
     3846   END.
     3847   if not available buf_c-fin-liab then do:
     3848     Open QUery br-changes for each temp-changes.
     3849     return.
     3850   end.
     3851   find first new_c-fin-ob no-lock where
     3852               new_c-fin-ob.host-code = buf_c-fin-liab.host-code
     3853          AND new_c-fin-ob.doc-code  = buf_c-fin-liab.doc-code
     3854          AND new_c-fin-ob.chip-num  > buf_c-fin-liab.chip-num no-error.
     3855   if not available new_c-fin-ob then do:
     3856       find first current_fin-ob no-lock where
     3857                  current_fin-ob.host-code = buf_c-fin-liab.host-code
     3858              AND current_fin-ob.doc-code  = buf_c-fin-liab.doc-code no-error.
     3859            if not available current_fin-ob then do:
     3860            return error.
     3861       end.
     3862       buffer-compare current_fin-ob to buf_c-fin-liab
     3863       save result in v-chg-fields.
     3864   end.
     3865   else do:
     3866       buffer-compare new_c-fin-ob except chip-num corr-date corr-user-name corr-user-db-num to buf_c-fin-liab
     3867       save result in v-chg-fields.
     3868   end.
     3869   define variable v-nn as integer   no-undo .
     3870   v-nn = num-entries(v-chg-fields) .
     3871   do ii = 1 to v-nn :
     3872   CASE entry(ii, v-chg-fields):
