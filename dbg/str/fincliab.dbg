     1127   DEFINE QUERY BR-changes FOR
     1128         temp-changes SCROLLING.
     1129   DEFINE new shared QUERY BR-docs FOR
     1130         buf_c-fin-liab SCROLLING.
     1131   DEFINE QUERY Dialog-Frame FOR
     1132         c-fin-ob SCROLLING.
     1133   DEFINE BROWSE BR-changes
     1134     QUERY BR-changes DISPLAY
     1135         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(25)"
     1136         temp-changes.v_old COLUMn-LABEL "Было" format "X(35)"
     1137         temp-changes.v_new COLUMn-LABEL "Стало" format "X(35)"
     1138       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.75 BY 9.67.
     1139   DEFINE BROWSE BR-docs
     1140     QUERY BR-docs DISPLAY
     1141        mark-string(recid( buf_c-fin-liab), rid-list)    COLUMN-LABEL '*'  FORMAT "x(1)"
     1142        buf_c-fin-liab.doc-type    COLUMN-LABEL 'Т'  Format "x(1)"
