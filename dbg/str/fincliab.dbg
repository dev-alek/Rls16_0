      372   procedure fltfield-clear :
      373     define output parameter loc-fld as character no-undo.
      374     define output parameter loc-lab as character no-undo .
      375     define output parameter loc-spr as character no-undo .
      376     define output parameter loc-dim as character no-undo .
      377     assign
      378       loc-fld = ""
      379       loc-lab = ""
      380       loc-spr = ""
      381       loc-dim = "0"
      382     .
      383   end procedure .
      384   procedure fltfield-add :
      385     define input        parameter par-fld as character no-undo.
      386     define input        parameter par-lab as character no-undo .
      387     define input        parameter par-spr as character no-undo .
      388     define input-output parameter loc-fld as character no-undo.
      389     define input-output parameter loc-lab as character no-undo .
      390     define input-output parameter loc-spr as character no-undo .
      391     define input-output parameter loc-dim as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       assign
      396       loc-fld = if loc-dim = '0'
      397                 then par-fld
      398                 else (loc-fld + chr(44) + par-fld)
      399       loc-lab = if loc-dim = '0'
      400                 then par-lab
      401                 else (loc-lab + chr(44) + par-lab)
      402       loc-spr = if loc-dim = '0'
      403                 then par-spr
      404                 else (loc-spr + chr(44) + par-spr)
      405       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      406                 string(integer(if num-entries(loc-dim) > 1
      407                               then entry(2, loc-dim)
      408                               else entry(1, loc-dim)
      409                               ) + 1)
      410       no-error
      411       .
      412     end.
      413   end procedure.
      414   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define  stream PrnLibStream.
      416   procedure prn-lib-prn-file :
      417     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      418     define input parameter p-DIsabledoptions as integer no-undo .
      419     define variable v-report-name as character no-undo .
      420     define variable v-user-action as character no-undo .
      421     define variable v-printed     as logical   no-undo .
      422     define variable v-exist       as logical   no-undo .
      423     do
      424       on error undo, return error
      425       :
      426       run prn-lib-get-report-name  in this-procedure (
      427         input parParentProc
      428         ,output v-report-name
      429         ).
      430   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      432     (input  v-report-name
      433     ,input  2
      434     ,output v-exist
      435     )  .
      436       if NOT v-exist then
      437       DO:
      438         Message
      439           "Нет заданий на печать ! "
      440           view-as alert-box .
      441         Return  .
      442       End.
      443       run gbl/prnfilen.w
      444         (input  ""
      445         ,input  p-DisabledOptions
      446         ,input  string(v-report-name )
      447         ,input  7
      448         ,output v-user-action
      449         ,output v-printed
      450         ) .
      451       if v-printed then
      452       do:
      453         return "YES" .
      454       end.
      455       else
      456       do:
      457         return "NO" .
      458       end.
      459     end.
      460   end procedure.
      461   procedure prn-lib-open-stream :
      462     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      463     define input parameter p-page-size    as integer no-undo .
      464     define input parameter p-is-stream    as logical no-undo .
      465     define input parameter p-append       as logical no-undo .
      466     define variable v-report-name as character no-undo .
      467     do
      468       on error undo, return error
      469       :
      470       run prn-lib-get-report-name  in this-procedure (
      471         input parParentProc
      472         ,output v-report-name
      473         ).
      474       if p-is-stream then
      475       do:
      476         if p-append then
      477         do:
      478           output stream PrnLibStream to value( v-report-name )
      479             page-size value(p-page-size) append .
      480         end.
      481         if not p-append then
      482         do:
      483           output stream PrnLibStream to value( v-report-name )
      484             page-size value(p-page-size) .
      485         end.
      486       end.
      487       if not p-is-stream then
      488       do:
      489         if p-append then
      490         do:
      491           output to value( v-report-name )
      492             page-size value(p-page-size) append .
      493         end.
      494         if not p-append then
      495         do:
      496           output to value( v-report-name )
      497             page-size value(p-page-size) .
      498         end.
      499       end.
      500     end.
      501   end procedure.
      502   procedure prn-lib-open-exp :
      503     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      504     define input parameter p-is-stream    as logical no-undo .
      505     define input parameter p-is-append    as logical no-undo .
      506     define output parameter p-ReportFileName as char init "report" no-undo.
      507     define output parameter p-process as logical no-undo .
      508     define variable glog as logical no-undo .
      509     do
      510       on error undo, return error
      511       :
      512       SYSTEM-DIALOG GET-FILE p-ReportFileName
      513         TITLE      "Укажите путь"
      514         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      515         ASK-OVERWRITE
      516         CREATE-TEST-FILE
      517         SAVE-AS
      518         USE-FILENAME
      519         DEFAULT-EXTENSION "txt"
      520         UPDATE glog
      521         .
      522       if not glog then  return.
      523       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      524       if p-is-stream then
      525       do:
      526         if p-is-append then
      527         do:
      528           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      529         end.
      530         else
      531         do:
      532           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      533         end.
      534       end.
      535       else
      536       do:
      537         if p-is-append then
      538         do:
      539           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      540         end.
      541         else
      542         do:
      543           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      544         end.
      545       end.
      546       p-process = yes.
      547     end.
      548   end procedure.
      549   procedure prn-lib-get-report-name :
      550     define input parameter parParentProc  as widget-handle no-undo.
      551     define output parameter p-report-name as character no-undo .
      552     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      553   end procedure.
