     1988       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1989       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1990       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     1991       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1992       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1993       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1994       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     1995       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1996       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1997       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1998       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1999       define variable varoutvprbprl               as   character                           no-undo.
     2000       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     2001       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     2002       define buffer   in-vatp-partsoprl    for ub.parts   .
     2003       define buffer   in-vatp-docoprl      for ub.trn-doc .
     2004       define buffer   in-vatp-goodsoprl    for ub.goods   .
     2005       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     2006       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     2007       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     2008       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     2009       define variable varinvprboprl                  as   character              no-undo.
     2010       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     2011       define variable cli-base-rateoprl              as   decimal                no-undo.
     2012       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     2013       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     2014       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     2015       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     2016       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     2017       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     2018       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     2019       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2020       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2021       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     2022       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2023       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2024       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     2025       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     2026       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     2027       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     2028       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     2029       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     2030       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     2031       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     2032       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     2033       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     2034       define variable varinvatp-envdoprl             as   character              no-undo.
     2035       define variable varinvatp-typeoprl             as   character              no-undo.
     2036     define buffer bf_price-list for ub.price-list.
     2037     define buffer bf_goods      for ub.goods.
     2038     define buffer bf_sysconf    for ub.sysconf.
     2039     define buffer bf_parts      for ub.parts.
     2040     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     2041     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     2042     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     2043     define variable varexcise      like ub.price-list.excise     no-undo.
     2044     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     2045     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     2046     define variable varprice-base  like ub.price-list.price-sale no-undo.
     2047     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     2048     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     2049     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     2050     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     2051     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     2052     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     2053     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     2054     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     2055     define variable varartic       like ub.price-list.artic      no-undo.
     2056     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     2057     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     2058     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     2059     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     2060     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2061     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     2062     define variable vardoc-type     as   character              no-undo.
     2063     do
     2064     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2065     :
     2066       find first bf_price-list no-lock
     2067         where recid(bf_price-list) = parrecid
     2068         no-error .
     2069       if not available bf_price-list
     2070       then do:
     2071         return error "Ошибка во входящих параметрах prl-vat.i" .
     2072       end.
     2073       find first bf_goods no-lock
     2074         where bf_goods.artic     = bf_price-list.artic
     2075           and bf_goods.prod-type = bf_price-list.prod-type
     2076           and bf_goods.prod-code = bf_price-list.prod-code
     2077         no-error .
     2078       if not available bf_goods
     2079       then do:
     2080         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2081       end.
     2082       assign
     2083         varvat-pc = bf_price-list.vat-pc
     2084         varslt-pc = bf_price-list.slt-pc
     2085       .
     2086       if varvat-pc = ?
     2087       then do:
     2088         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2089       end.
     2090       if varslt-pc = ?
     2091       then do:
     2092         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2093       end.
     2094       assign
     2095         varbase-rate   = 1
     2096         varbase-scale  = 1
     2097         varroad-tax    = bf_price-list.road-tax
