      497         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
      498         v-old-fact-base     = buf_gds-obj.fact-base
      499         v-old-fact-rubl     = buf_gds-obj.fact-rubl
      500         v-old-fact-sale     = buf_gds-obj.fact-sale
      501       .
      502       assign
      503         buf_gds-obj.price-sale = v-price-sale
      504         buf_gds-obj.fact-sale  = v-total-fact-sale
      505       .
