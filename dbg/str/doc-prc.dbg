      178         undo, return error .
      179       end.
      180       find current buf_gds-obj  exclusive-lock .
      181       find current buf_prt-obj  exclusive-lock .
      182   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      184     (input  p-artic
      185     ,input  p-prod-type
      186     ,input  p-prod-code
      187     ,output v-gds-code
      188     )  .
      189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      190     (input  v-gds-code
      191     ,input  v-root-node
      192     ,output v-root-b-code
      193     )  .
      194   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      196     (input  p-obj-type
      197     ,input  p-obj-code
      198     ,input  v-root-b-code
      199     ,input  v-root-b-code
      200     ,input  0
      201     ,output v-doc-num
      202     ,output v-price-sale
      203     ,output v-road-tax
      204     ,output v-excise
      205     ) no-error .
      206       if error-status :error
      207       then do:
      208         message
      209           vss-workfile vss-revision vss-description skip
      210           vss-include-info0 skip
      211           "Ошибка при определении цены признака на объекте" skip
      212           "Объект"     p-obj-type p-obj-code  skip
      213           "Бар-код"    v-root-b-code skip
      214           error-status :get-message(1) skip
      215           return-value skip
      216           view-as alert-box error .
      217         undo, return error .
      218       end.
      219       run prdoclib-init-temp-prt-obj in this-procedure
      220         (input p-obj-type
      221         ,input p-obj-code
      222         ,input p-artic
      223         ,input p-prod-type
      224         ,input p-prod-code
      225         ,input v-price-sale
      226         ) .
      227       find first buf_price-list no-lock
      228         where buf_price-list.doc-num    = v-doc-num
      229           and buf_price-list.price-type = ""
      230           and buf_price-list.b-code     = v-root-b-code
