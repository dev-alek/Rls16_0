     3913       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     3914       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     3915       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3916       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
