      780     (input  buf_main_price-list.obj-type
      781     ,input  buf_main_price-list.obj-code
      782     ,input  buf_goods.artic
      783     ,input  buf_goods.prod-type
      784     ,input  buf_goods.prod-code
      785     ,buffer buf_gds-obj
      786     ) no-error .
      787           if error-status :error then do:
      788              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      789           end.
      790         end.
      791       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
      792       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
      793       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
      794       define variable price-base-without-tax-sale-prl as decimal   no-undo .
      795       define variable vat-base-sale-prl               as decimal   no-undo .
      796       define variable vat-rubl-sale-prl               as decimal   no-undo .
      797       define variable vat-base-buyer-prl              as decimal   no-undo .
      798       define variable vat-rubl-buyer-prl              as decimal   no-undo .
      799       define variable slt-base-sale-prl               as decimal   no-undo .
      800       define variable slt-rubl-sale-prl               as decimal   no-undo .
      801       define variable road-tax-base-sale-prl          as decimal   no-undo .
      802       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
      803       define variable excise-base-sale-prl            as decimal   no-undo .
      804       define variable excise-rubl-sale-prl            as decimal   no-undo .
      805       define variable discnt-base-sale-prl            as decimal   no-undo .
      806       define variable discnt-rubl-sale-prl            as decimal   no-undo .
      807       if buf_main_price-list.doc-qnty <> 0
      808       then do:
      809         run prl-vat in this-procedure
      810           (input  recid(buf_main_price-list)
      811           ,output price-rubl-with-tax-sale-prl
      812           ,output price-base-with-tax-sale-prl
      813           ,output price-rubl-without-tax-sale-prl
      814           ,output price-base-without-tax-sale-prl
      815           ,output vat-base-sale-prl
      816           ,output vat-rubl-sale-prl
      817           ,output vat-base-buyer-prl
      818           ,output vat-rubl-buyer-prl
      819           ,output slt-base-sale-prl
      820           ,output slt-rubl-sale-prl
      821           ,output road-tax-base-sale-prl
      822           ,output road-tax-rubl-sale-prl
      823           ,output excise-base-sale-prl
      824           ,output excise-rubl-sale-prl
      825           ,output discnt-base-sale-prl
      826           ,output discnt-rubl-sale-prl
      827           ) no-error .
      828         if error-status :error
      829         then do:
      830           message
      831             vss-workfile vss-revision vss-description skip
      832             vss-include-info0 skip
      833             "Ошибка при вызове процеды prl-vat" skip
      834             "Документ" buf_main_price-list.doc-num skip
      835             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      836             error-status :get-message(1) skip
      837             return-value skip
      838             view-as alert-box error .
      839           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      840         end.
      841       end.
      842       else do:
      843         assign
      844           price-rubl-with-tax-sale-prl    = 0
      845           price-base-with-tax-sale-prl    = 0
      846           price-rubl-without-tax-sale-prl = 0
      847           price-base-without-tax-sale-prl = 0
      848           vat-base-sale-prl               = 0
      849           vat-rubl-sale-prl               = 0
      850           vat-base-buyer-prl              = 0
      851           vat-rubl-buyer-prl              = 0
      852           slt-base-sale-prl               = 0
      853           slt-rubl-sale-prl               = 0
      854           road-tax-base-sale-prl          = 0
      855           road-tax-rubl-sale-prl          = 0
      856           excise-base-sale-prl            = 0
      857           excise-rubl-sale-prl            = 0
      858           discnt-base-sale-prl            = 0
      859           discnt-rubl-sale-prl            = 0
      860         .
      861       end.
      862       define variable v-curr-r-b as character no-undo .
      863   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      865     (output v-curr-r-b
      866     )  .
      867       if v-curr-r-b = 'base':U
      868       then do:
      869         assign
      870           p-fact-qnty         = buf_main_price-list.doc-qnty
      871           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
      872           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
      873           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
      874           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
      875           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-fact-qnty         = buf_main_price-list.doc-qnty
      881           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
      882           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
      883           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
      884           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
      885           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
      886         .
      887       end.
      888         define variable v-unit-base like ub.goods.unit-base no-undo .
      889   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      891     (input  buf_goods.gds-code
      892     ,output v-unit-base
      893     ) no-error .
      894         if error-status :error
      895         then do:
      896           message
      897             vss-workfile vss-revision vss-description skip
      898             vss-include-info0 skip
      899             "Ошибка при определении базовой единицы измерения товара" skip
      900             "Код товара" buf_goods.gds-code skip
      901             error-status :get-message(1) skip
      902             return-value skip
      903             view-as alert-box error .
      904           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      905         end.
      906         for each buf_price-list no-lock
      907           where buf_price-list.doc-num    = buf_main_price-list.doc-num
      908             and buf_price-list.main-price = false
      909             and buf_price-list.artic      = buf_main_price-list.artic
      910             and buf_price-list.prod-type  = buf_main_price-list.prod-type
      911             and buf_price-list.prod-code  = buf_main_price-list.prod-code
      912         :
      913           if buf_price-list.doc-qnty = ?
      914           then do:
      915             find first buf_bar-code no-lock
      916               where buf_bar-code.b-code = buf_price-list.b-code
      917               no-error .
      918             if available buf_bar-code
      919             and buf_bar-code.unit-cli = v-unit-base
      920             then do:
      921               message
      922                 vss-workfile vss-revision vss-description skip
      923                 vss-include-info0 skip
      924                 "Ошибка при закрытии переоценки" skip
      925                 "Не задано количество для бар-кода с основной единицей измерения" skip
      926                 "Переоценка" buf_main_price-list.doc-num skip
      927                 "Бар-код" buf_price-list.b-code skip
      928                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      929                 "Количество" buf_price-list.doc-qnty skip
      930                 "Основная единица измерения" v-unit-base skip
      931                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      932                 view-as alert-box error .
      933               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      934             end.
      935             next .
      936           end.
      937           if not can-find
      938             (first buf_bar-code
      939             where buf_bar-code.b-code = buf_price-list.b-code
      940             )
      941           then do:
      942             message
      943               vss-workfile vss-revision vss-description skip
      944               vss-include-info0 skip
      945               "В переоценке задан несуществующий бар-код" skip
      946               "Переоценка" buf_price-list.doc-num skip
      947               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      948               "Бар-код" buf_price-list.b-code skip
      949               view-as alert-box error .
      950             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      951           end.
      952           if buf_price-list.doc-qnty <> 0
      953           then do:
      954             run prl-vat in this-procedure
      955               (input  recid(buf_price-list)
      956               ,output price-rubl-with-tax-sale-prl
      957               ,output price-base-with-tax-sale-prl
      958               ,output price-rubl-without-tax-sale-prl
      959               ,output price-base-without-tax-sale-prl
      960               ,output vat-base-sale-prl
      961               ,output vat-rubl-sale-prl
      962               ,output vat-base-buyer-prl
      963               ,output vat-rubl-buyer-prl
      964               ,output slt-base-sale-prl
      965               ,output slt-rubl-sale-prl
      966               ,output road-tax-base-sale-prl
      967               ,output road-tax-rubl-sale-prl
      968               ,output excise-base-sale-prl
      969               ,output excise-rubl-sale-prl
      970               ,output discnt-base-sale-prl
      971               ,output discnt-rubl-sale-prl
      972               ) no-error .
      973             if error-status :error
      974             then do:
      975               message
      976                 vss-workfile vss-revision vss-description skip
      977                 vss-include-info0 skip
      978                 "Ошибка при вызове процеды prl-vat" skip
      979                 "Документ" buf_price-list.doc-num skip
      980                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      981                 error-status :get-message(1) skip
      982                 return-value skip
      983                 view-as alert-box error .
      984               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      985             end.
      986           end.
      987           else do:
      988             assign
      989               price-rubl-with-tax-sale-prl    = 0
      990               price-base-with-tax-sale-prl    = 0
      991               price-rubl-without-tax-sale-prl = 0
      992               price-base-without-tax-sale-prl = 0
      993               vat-base-sale-prl               = 0
      994               vat-rubl-sale-prl               = 0
      995               vat-base-buyer-prl              = 0
      996               vat-rubl-buyer-prl              = 0
      997               slt-base-sale-prl               = 0
      998               slt-rubl-sale-prl               = 0
      999               road-tax-base-sale-prl          = 0
     1000               road-tax-rubl-sale-prl          = 0
     1001               excise-base-sale-prl            = 0
     1002               excise-rubl-sale-prl            = 0
     1003               discnt-base-sale-prl            = 0
     1004               discnt-rubl-sale-prl            = 0
     1005             .
     1006           end.
     1007           if v-curr-r-b = 'base':U
     1008           then do:
     1009             assign
     1010               p-fact-qnty         = p-fact-qnty
     1011                                   + buf_price-list.doc-qnty
     1012               p-cur-base          = p-cur-base
     1013                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1014               p-cur-VAT-base      = p-cur-VAT-base
     1015                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1016               p-cur-SLT-base      = p-cur-SLT-base
     1017                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1018               p-cur-road-tax-base = p-cur-road-tax-base
     1019                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1020               p-cur-excise-base   = p-cur-excise-base
     1021                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1022             .
     1023           end.
     1024           else do:
     1025             assign
     1026               p-fact-qnty         = p-fact-qnty
     1027                                   + buf_price-list.doc-qnty
     1028               p-cur-base          = p-cur-base
     1029                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1030               p-cur-VAT-base      = p-cur-VAT-base
     1031                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1032               p-cur-SLT-base      = p-cur-SLT-base
     1033                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1034               p-cur-road-tax-base = p-cur-road-tax-base
     1035                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1036               p-cur-excise-base   = p-cur-excise-base
     1037                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1038             .
     1039           end.
     1040         end.
     1041     end.
     1042   end procedure.
     1043   procedure prdoclib-calc-prc :
     1044     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1045     define input  parameter p-cons-pay        as   integer                no-undo.
     1046     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1047     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1048     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1049     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1050     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1051     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1052     do
     1053     on error undo, return error return-value
     1054     :
     1055       define buffer buf_price-doc       for ub.price-doc .
     1056       define buffer buf_price-list      for ub.price-list .
     1057       define buffer buf_parts           for ub.parts .
     1058       define variable v-ov-qnty     as decimal   no-undo .
     1059       define variable v-ov-base     as decimal   no-undo .
     1060       define variable v-ov-VAT-base as decimal   no-undo .
     1061       define variable v-ov-SLT-base as decimal   no-undo .
     1062       define variable v-cons-qnty   as decimal   no-undo .
     1063       define variable v-prch-qnty   as decimal   no-undo .
     1064       define variable v-cons-mult   as decimal   no-undo .
     1065       define variable v-prch-mult   as decimal   no-undo .
     1066       find first buf_price-doc no-lock
     1067         where recid(buf_price-doc) = p-price-doc-recid
     1068         no-error .
     1069       if not available buf_price-doc
     1070       then do:
     1071         message
     1072           vss-workfile vss-revision vss-description skip
     1073           vss-include-info0 skip
     1074           "Ошибка задания входных параметров" skip
     1075           "Не найден документ переоценки" skip
     1076           "Код записи (recid)" p-price-doc-recid skip
     1077           view-as alert-box error .
     1078         undo, return error .
     1079       end.
     1080       for each buf_price-list no-lock
     1081         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1082           and buf_price-list.main-price = true
     1083       on error undo, return error return-value
     1084       :
     1085         run prdoclib-calc-ov
     1086           (input recid(buf_price-list)
     1087           ,output v-ov-qnty
     1088           ,output v-ov-base
     1089           ,output v-ov-VAT-base
     1090           ,output v-ov-SLT-base
     1091           ) no-error .
     1092         if error-status :error
     1093         then do:
     1094           if error-status :get-message(1) <> ""
     1095           then do:
     1096             message
     1097               vss-workfile vss-revision vss-description skip
     1098               vss-include-info0 skip
     1099               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1100               error-status :get-message(1) skip
     1101               return-value skip
     1102               view-as alert-box error .
     1103           end.
     1104           undo, return error return-value .
     1105         end.
     1106         assign
     1107           v-cons-qnty = 0
     1108           v-prch-qnty = 0
     1109         .
     1110         for each buf_parts no-lock
     1111           where buf_parts.out-code  = buf_price-list.doc-num
     1112             and buf_parts.obj-type  = buf_price-list.obj-type
     1113             and buf_parts.obj-code  = buf_price-list.obj-code
     1114             and buf_parts.artic     = buf_price-list.artic
     1115             and buf_parts.prod-type = buf_price-list.prod-type
     1116             and buf_parts.prod-code = buf_price-list.prod-code
     1117         on error undo, return error return-value
     1118         :
     1119           if buf_parts.pay-code = p-cons-pay
     1120           then do:
     1121             assign
     1122               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1123             .
     1124           end.
     1125           else do:
     1126             assign
     1127               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1128             .
     1129           end.
     1130         end.
     1131         if (v-cons-qnty + v-prch-qnty) = 0
     1132         then do:
     1133           assign
     1134             v-cons-mult = 0
     1135             v-prch-mult = 1
     1136           .
     1137         end.
     1138         else do:
     1139           assign
     1140             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1141             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1142           .
     1143         end.
     1144         assign
     1145           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1146           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1147           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1148           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1149           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1150           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1151         .
     1152       end.
     1153     end.
     1154   end procedure.
     1155   procedure prdoclib-calc-ov :
     1156     define input  parameter p-price-list-recid as recid     no-undo .
     1157     define output parameter p-fact-qnty        as decimal   no-undo .
     1158     define output parameter p-ov-base          as decimal   no-undo .
     1159     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1160     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1161     do
     1162     on error undo, return error return-value
     1163     :
     1164       define buffer buf_main_price-list    for ub.price-list .
     1165       define buffer buf_prev_price-list    for ub.price-list .
     1166       define buffer buf_special_price-list for ub.price-list .
     1167       define buffer buf_goods              for ub.goods .
     1168       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1169       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1170       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1171       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1172       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1173       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1174       define variable v-prev-price-list-recid as   recid                  no-undo.
     1175       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1176       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1177       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1178       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1179       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1180       find first buf_main_price-list no-lock
     1181         where recid(buf_main_price-list) = p-price-list-recid
     1182         no-error .
     1183       if not available buf_main_price-list
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           vss-include-info0 skip
     1188           "Ошибка задания входных параметров" skip
     1189           "Не найдена строка переоценки" skip
     1190           "Код записи (recid)" p-price-list-recid skip
     1191           view-as alert-box error .
     1192         undo, return error .
     1193       end.
     1194       if buf_main_price-list.main-price <> true
     1195       then do:
     1196         message
     1197           vss-workfile vss-revision vss-description skip
     1198           vss-include-info0 skip
     1199           "Ошибка задания входных параметров" skip
     1200           "Строка переоценки не является основной" skip
     1201           "Код записи (recid)" p-price-list-recid skip
     1202           "Переоценка" buf_main_price-list.doc-num skip
     1203           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1204           "Бар-код" buf_main_price-list.b-code skip
     1205           view-as alert-box error .
     1206         undo, return error .
     1207       end.
     1208       run prdoclib-calc-fact-sale in this-procedure
     1209         (input  recid(buf_main_price-list)
     1210         ,output v-fact-qnty
     1211         ,output v-cur-base
     1212         ,output v-cur-VAT-base
     1213         ,output v-cur-SLT-base
     1214         ,output v-cur-road-tax-base
     1215         ,output v-cur-excise-base
     1216         ) no-error.
     1217       if error-status :error
     1218       then do:
     1219         message
     1220           vss-workfile vss-revision vss-description skip
     1221           vss-include-info0 skip
     1222           "Ошибка при расчете сумм переоценки." skip
     1223           "Документ переоценки" buf_main_price-list.doc-num skip
     1224           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1225           error-status :get-message(1) skip
     1226           return-value skip
     1227           view-as alert-box error .
     1228         undo, return error .
     1229       end.
     1230   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1232     (input  buf_main_price-list.obj-type
     1233     ,input  buf_main_price-list.obj-code
     1234     ,input  buf_main_price-list.b-code
     1235     ,input  buf_main_price-list.b-code
     1236     ,input  buf_main_price-list.fact-order
     1237     ,output v-prev-price-list-recid
     1238     ,output v-prev-cli-base-rate
     1239     ) no-error .
     1240       if error-status :error
     1241       then do:
     1242         message
     1243           vss-workfile vss-revision vss-description skip
     1244           vss-include-info0 skip
     1245           "Ошибка при поиске предыдущей переоценки." skip
     1246           "Документ переоценки " buf_main_price-list.doc-num skip
     1247           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1248           error-status :get-message(1) skip
     1249           return-value skip
     1250           view-as alert-box error .
     1251         undo, return error .
     1252       end.
     1253       if v-prev-price-list-recid <> ?
     1254       then do:
     1255         find first buf_prev_price-list no-lock
     1256           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1257           .
     1258         find first buf_special_price-list no-lock
     1259           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1260             and buf_special_price-list.main-price = false
     1261             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1262             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1263             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1264             and buf_special_price-list.doc-qnty   <> ?
     1265           no-error .
     1266         if available buf_special_price-list
     1267         then do:
     1268           message
     1269             "Товар имеет специальные цены на признаки" skip
     1270             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1271             "Переоценка" buf_prev_price-list.doc-num skip
     1272             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1273             view-as alert-box error .
     1274           undo, return error .
     1275         end.
     1276         find first buf_goods no-lock
     1277           where buf_goods.artic     = buf_main_price-list.artic
     1278             and buf_goods.prod-type = buf_main_price-list.prod-type
     1279             and buf_goods.prod-code = buf_main_price-list.prod-code
     1280           no-error .
     1281         if not available buf_goods
     1282         then do:
     1283           message
     1284             vss-workfile vss-revision vss-description skip
     1285             vss-include-info0 skip
     1286             "Не найден товар" skip
     1287             "Переоценка" buf_main_price-list.doc-num skip
     1288             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1289             view-as alert-box error .
     1290           undo, return error .
     1291         end.
     1292         if buf_prev_price-list.vat-pc = ?
     1293         or buf_prev_price-list.slt-pc = ?
     1294         then do:
     1295           message
     1296             "В переоценке не заданы налоги товара" skip
     1297             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1298             "Переоценка" buf_prev_price-list.doc-num skip
     1299             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1300             "НДС" buf_prev_price-list.vat-pc skip
     1301             "НП" buf_prev_price-list.slt-pc skip
     1302             view-as alert-box error .
     1303           undo, return error return-value .
     1304         end.
     1305         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1306         assign
     1307           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1308         .
     1309         assign
     1310           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1311           v-prev-cur-VAT-base = v-fact-qnty
     1312                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1313                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1314           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1315         .
     1316         assign
     1317           p-fact-qnty   = v-fact-qnty
     1318           p-ov-base     = v-cur-base     - v-prev-cur-base
     1319           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1320           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1321         .
     1322       end.
     1323       else do:
     1324         assign
     1325           v-prev-cur-base     = 0
     1326           v-prev-cur-VAT-base = 0
     1327           v-prev-cur-SLT-base = 0
     1328           .
     1329         assign
     1330           p-fact-qnty   = v-fact-qnty
     1331           p-ov-base     = v-cur-base     - v-prev-cur-base
     1332           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1333           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1334         .
     1335       end.
     1336     end.
     1337   end procedure.
     1338   procedure prdoclib-init-prt-obj-by-factord :
     1339     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1340     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1341     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1342     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1343     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1344     define input parameter p-fact-order         as decimal   no-undo .
     1345     define input parameter p-include-fact-order as logical   no-undo .
     1346     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1347     define buffer buf_gds-obj      for ub.gds-obj .
     1348     define buffer buf_doc-line     for ub.doc-line .
     1349     define buffer buf_temp-prt-obj for temp-prt-obj .
     1350     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       do transaction
     1355       on error undo, return error return-value
     1356       :
     1357   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1359     (input  p-obj-type
     1360     ,input  p-obj-code
     1361     ,input  p-artic
     1362     ,input  p-prod-type
     1363     ,input  p-prod-code
     1364     ,buffer buf_gds-obj
     1365     ) no-error .
     1366         if error-status :error
     1367         then do:
     1368           message
     1369             vss-workfile vss-revision vss-description skip
     1370             vss-include-info0 skip
     1371             "Невозможно найти gds-obj" skip
     1372             error-status :get-message(1) skip
     1373             return-value skip
     1374             view-as alert-box error .
     1375           undo, return error .
     1376         end.
     1377         find current buf_gds-obj exclusive-lock .
     1378       end.
     1379       run prdoclib-init-temp-prt-obj in this-procedure
     1380         (input p-obj-type
     1381         ,input p-obj-code
     1382         ,input p-artic
     1383         ,input p-prod-type
     1384         ,input p-prod-code
     1385         ,input 0
     1386         ) .
     1387       for each buf_temp-prt-obj
     1388         where buf_temp-prt-obj.is-term <> true
     1389       on error undo, return error return-value
     1390       :
     1391         delete buf_temp-prt-obj .
     1392       end.
     1393       if p-include-fact-order = true
     1394       then do:
     1395         assign
     1396          p-fact-order = p-fact-order - 0.0000000001
     1397         .
     1398       end.
     1399       for each buf_doc-line no-lock
     1400         where buf_doc-line.obj-type   = p-obj-type
     1401           and buf_doc-line.obj-code   = p-obj-code
     1402           and buf_doc-line.artic      = p-artic
     1403           and buf_doc-line.prod-type  = p-prod-type
     1404           and buf_doc-line.prod-code  = p-prod-code
     1405           and buf_doc-line.status_    = 'факт':U
     1406           and buf_doc-line.fact-order >= p-fact-order
     1407       on error undo, return error return-value
     1408       :
     1409         run prdoclib-process-document in this-procedure
     1410           (input  buf_doc-line.doc-code
     1411           ,input  p-obj-type
     1412           ,input  p-obj-code
     1413           ,input  p-artic
     1414           ,input  p-prod-type
     1415           ,input  p-prod-code
     1416           ,output v-total-gds-dtl-qnty
     1417           ) .
     1418       end.
     1419     end.
     1420   end procedure.
     1421   procedure prdoclib-process-document :
     1422     define input  parameter p-doc-code           as character no-undo .
     1423     define input  parameter p-obj-type           as character no-undo .
     1424     define input  parameter p-obj-code           as integer   no-undo .
     1425     define input  parameter p-artic              as character no-undo .
     1426     define input  parameter p-prod-type          as character no-undo .
     1427     define input  parameter p-prod-code          as integer   no-undo .
     1428     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     1429     define buffer buf_trn-doc      for ub.trn-doc .
     1430     define buffer buf_gds-dtl      for ub.gds-dtl .
     1431     define buffer buf_temp-prt-obj for temp-prt-obj .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       find first buf_trn-doc no-lock
     1436         where buf_trn-doc.doc-code = p-doc-code
     1437         no-error .
     1438       if not available buf_trn-doc then do:
     1439         message
     1440           vss-workfile vss-revision vss-description skip
     1441           vss-include-info0 skip
     1442           "Ошибка при поиске документа" skip
     1443           "Документ" p-doc-code skip
     1444           "Объект" p-obj-type p-obj-code skip
     1445           "Артикул" p-artic p-prod-type p-prod-code skip
     1446           view-as alert-box error .
     1447         undo, return error .
     1448       end.
     1449       assign
     1450         p-total-gds-dtl-qnty = 0
     1451       .
     1452       for each buf_gds-dtl no-lock
     1453         where buf_gds-dtl.doc-code  = p-doc-code
     1454           and buf_gds-dtl.artic     = p-artic
     1455           and buf_gds-dtl.prod-type = p-prod-type
     1456           and buf_gds-dtl.prod-code = p-prod-code
     1457       on error undo, return error
     1458       :
     1459         define variable v-term-node as integer   no-undo .
     1460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1461     (input  buf_gds-dtl.prt-code
     1462     ,output v-term-node
     1463     )  .
     1464         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     1465           (input  v-term-node
     1466           ,buffer buf_temp-prt-obj
     1467           ) .
     1468         if buf_temp-prt-obj.is-term <> true then do:
     1469           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     1470                                        ,buf_gds-dtl.prt-code
     1471                                        ) .
     1472         end.
     1473         case buf_trn-doc.doc-type :
     1474           when 'при':U or
     1475           when 'возврат':U
     1476           then do:
     1477             assign
     1478               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1479                                           - buf_gds-dtl.fact-qnty
     1480               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1481                                           - buf_gds-dtl.fact-qnty
     1482             .
     1483           end.
     1484           when 'рас':U or
     1485           when 'спи':U
     1486           then do:
     1487             assign
     1488               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1489                                           + buf_gds-dtl.fact-qnty
     1490               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1491                                           + buf_gds-dtl.fact-qnty
     1492             .
     1493           end.
     1494           when 'инв':U
     1495           then do:
     1496             assign
     1497               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1498                                           - buf_gds-dtl.doc-qnty
     1499               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1500                                           - buf_gds-dtl.doc-qnty
     1501             .
     1502           end.
     1503           otherwise do:
     1504             undo, return error substitute("Неизвестный тип документа &1"
     1505                                          ,buf_trn-doc.doc-type
     1506                                          ) .
     1507           end.
     1508         end.
     1509       end.
     1510     end.
     1511   end procedure.
     1512   procedure prdoclib-prc-pl-document :
     1513     define input  parameter p-doc-code              as character no-undo .
     1514     define input  parameter p-obj-type              as character no-undo .
     1515     define input  parameter p-obj-code              as integer   no-undo .
     1516     define input  parameter p-gds-code              as integer   no-undo .
     1517     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     1518     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       define buffer buf_trn-doc      for ub.trn-doc .
     1523       define buffer buf_doc-pl       for ub.doc-pl .
     1524       define buffer buf_temp-pl-gds for temp-pl-gds .
     1525       define variable v-sign as decimal   no-undo .
     1526       find first buf_trn-doc no-lock
     1527         where buf_trn-doc.doc-code = p-doc-code
     1528         no-error .
     1529       if not available buf_trn-doc then do:
     1530         message
     1531           vss-workfile vss-revision vss-description skip
     1532           vss-include-info0 skip
     1533           "Ошибка при поиске документа" skip
     1534           "Документ" p-doc-code skip
     1535           "Объект" p-obj-type p-obj-code skip
     1536           "Товар" p-gds-code skip
     1537           view-as alert-box error .
     1538         undo, return error .
     1539       end.
     1540       assign
     1541         p-total-pl-gds-qnty     = 0
     1542         p-total-pl-gds-cli-qnty = 0
     1543       .
     1544       for each buf_doc-pl no-lock
     1545         where buf_doc-pl.out-code  = p-doc-code
     1546           and buf_doc-pl.gds-code  = p-gds-code
     1547       on error undo, return error return-value
     1548       :
     1549         find first buf_temp-pl-gds
     1550           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     1551             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     1552             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     1553           .
     1554         case buf_trn-doc.doc-type :
     1555           when 'при':U
     1556           or when 'возврат':U
     1557           or when 'инв':U
     1558           then do:
     1559             assign
     1560               v-sign = -1.0
     1561             .
     1562           end.
     1563           when 'рас':U or
     1564           when 'спи':U
     1565           then do:
     1566             assign
     1567               v-sign = 1.0
     1568             .
     1569           end.
     1570           otherwise do:
     1571             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     1572           end.
     1573         end case.
     1574         assign
     1575           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     1576           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     1577           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     1578           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     1579         .
     1580       end.
     1581     end.
     1582   end procedure.
     1583   procedure prdoclib-init-prt-obj-by-date :
     1584     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     1585     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     1586     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     1587     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     1588     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     1589     define input parameter p-fact-date  as date      no-undo .
     1590     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     1591     do
     1592     on error undo, return error return-value
     1593     :
     1594       define variable v-fact-order                as decimal   no-undo .
     1595       define variable v-shift-end-fact-order      as decimal   no-undo .
     1596       define variable v-day-end-fact-order        as decimal   no-undo .
     1597       run factord in this-procedure
     1598         (input  p-fact-date
     1599         ,input  1
     1600         ,input  1
     1601         ,input  ?
     1602         ,input  0
     1603         ,input  false
     1604         ,output v-fact-order
     1605         ,output v-shift-end-fact-order
     1606         ,output v-day-end-fact-order
     1607         ) no-error .
     1608       if error-status :error
     1609       then do:
     1610         message
     1611           vss-workfile vss-revision vss-description skip
     1612           vss-include-info0 skip
     1613           "Ошибка при определении момента времени, на который требуется остаток" skip
     1614           "Объект" p-obj-type p-obj-code skip
     1615           "Артикул" p-artic p-prod-type p-prod-code skip
     1616           "Дата" p-fact-date skip
     1617           view-as alert-box error .
     1618         undo, return error .
     1619       end.
     1620       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     1621         (input p-obj-type
     1622         ,input p-obj-code
     1623         ,input p-artic
     1624         ,input p-prod-type
     1625         ,input p-prod-code
     1626         ,input v-day-end-fact-order
     1627         ,input false
     1628         ) no-error .
     1629       if error-status :error
     1630       then do:
     1631         message
     1632           vss-workfile vss-revision vss-description skip
     1633           vss-include-info0 skip
     1634           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     1635           "Объект" p-obj-type p-obj-code skip
     1636           "Артикул" p-artic p-prod-type p-prod-code skip
     1637           "Дата" p-fact-date skip
     1638           view-as alert-box error .
     1639         undo, return error .
     1640       end.
     1641     end.
     1642   end procedure.
     1643   procedure prdoclib-calc-temp-fact-sale :
     1644     define input  parameter p-obj-type           as character no-undo .
     1645     define input  parameter p-obj-code           as integer   no-undo .
     1646     define input  parameter p-gds-code           as integer   no-undo .
     1647     define input  parameter p-day-end-fact-order as decimal   no-undo .
     1648     define input  parameter p-curr-r-b           as character no-undo .
     1649     define output parameter p-fact-qnty          as decimal   no-undo .
     1650     define output parameter p-cur-base           as decimal   no-undo .
     1651     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1652     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1653     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1654     define output parameter p-cur-excise-base    as decimal   no-undo .
     1655     define buffer buf_temp-prt-obj for temp-prt-obj .
     1656     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     1657     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     1658     define variable parrecid-prl        as recid     no-undo .
     1659     define variable v-fact-qnty         as decimal   no-undo .
     1660     define variable v-cur-base          as decimal   no-undo .
     1661     define variable v-cur-VAT-base      as decimal   no-undo .
     1662     define variable v-cur-SLT-base      as decimal   no-undo .
     1663     define variable v-cur-road-tax-base as decimal   no-undo .
     1664     define variable v-cur-excise-base   as decimal   no-undo .
     1665     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1666     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1667     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1668     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1669     define variable vat-base-sale-prl               as decimal   no-undo .
     1670     define variable vat-rubl-sale-prl               as decimal   no-undo .
     1671     define variable vat-base-buyer-prl              as decimal   no-undo .
     1672     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1673     define variable slt-base-sale-prl               as decimal   no-undo .
     1674     define variable slt-rubl-sale-prl               as decimal   no-undo .
     1675     define variable road-tax-base-sale-prl          as decimal   no-undo .
     1676     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1677     define variable excise-base-sale-prl            as decimal   no-undo .
     1678     define variable excise-rubl-sale-prl            as decimal   no-undo .
     1679     define variable discnt-base-sale-prl            as decimal   no-undo .
     1680     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1681     do
     1682     on error undo, return error return-value
     1683     :
     1684       for each buf_temp-prt-obj no-lock
     1685       on error undo, return error return-value
     1686       :
     1687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1688     (input  p-gds-code
     1689     ,input  buf_temp-prt-obj.prt-code
     1690     ,output v-prt-b-code
     1691     ) no-error .
     1692         if error-status :error
     1693         then do:
     1694           message
     1695             vss-workfile vss-revision vss-description skip
     1696             "Ошибка при определении бар-кода признака" skip
     1697             "Код товара"   p-gds-code skip
     1698             "Код признака" buf_temp-prt-obj.prt-code skip
     1699             error-status :get-message(1) skip
     1700             return-value skip
     1701             view-as alert-box error .
     1702           undo, return error .
     1703         end.
     1704   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1705   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1706     (input  p-obj-type
     1707     ,input  p-obj-code
     1708     ,input  v-prt-b-code
     1709     ,input  0
     1710     ,input  p-day-end-fact-order
     1711     ,output parrecid-prl
     1712     ,output v-cli-base-rate
     1713     ) no-error .
     1714         if error-status :error
     1715         then do:
     1716           message
     1717             vss-workfile vss-revision vss-description skip
     1718             "Ошибка при определении цены бар-кода" skip
     1719             "Объект" p-obj-type p-obj-code skip
     1720             "Бар-код" v-prt-b-code skip
     1721             "fact-order" p-day-end-fact-order skip
     1722             error-status :get-message(1) skip
     1723             return-value skip
     1724             view-as alert-box error .
     1725           undo, return error .
     1726         end.
     1727         if parrecid-prl <> ?
     1728         then do:
     1729           run prl-vat in this-procedure
     1730             (input  parrecid-prl
     1731             ,output price-rubl-with-tax-sale-prl
     1732             ,output price-base-with-tax-sale-prl
     1733             ,output price-rubl-without-tax-sale-prl
     1734             ,output price-base-without-tax-sale-prl
     1735             ,output vat-base-sale-prl
     1736             ,output vat-rubl-sale-prl
     1737             ,output vat-base-buyer-prl
     1738             ,output vat-rubl-buyer-prl
     1739             ,output slt-base-sale-prl
     1740             ,output slt-rubl-sale-prl
     1741             ,output road-tax-base-sale-prl
     1742             ,output road-tax-rubl-sale-prl
     1743             ,output excise-base-sale-prl
     1744             ,output excise-rubl-sale-prl
     1745             ,output discnt-base-sale-prl
     1746             ,output discnt-rubl-sale-prl
     1747             ) no-error .
     1748           if error-status :error
     1749           then do:
     1750             message
     1751               vss-workfile vss-revision vss-description skip
     1752               "Ошибка при вызове процеды prl-vat" skip
     1753               "Объект" p-obj-type p-obj-code skip
     1754               "Код товара" p-gds-code skip
     1755               "Указатель на запись переоценки" parrecid-prl skip
     1756               error-status :get-message(1) skip
     1757               return-value skip
     1758               view-as alert-box error .
     1759             undo, return error .
     1760           end.
     1761         end.
     1762         else do:
     1763           assign
     1764             price-rubl-with-tax-sale-prl    = 0
     1765             price-base-with-tax-sale-prl    = 0
     1766             price-rubl-without-tax-sale-prl = 0
     1767             price-base-without-tax-sale-prl = 0
     1768             vat-base-sale-prl               = 0
     1769             vat-rubl-sale-prl               = 0
     1770             slt-base-sale-prl               = 0
     1771             slt-rubl-sale-prl               = 0
     1772             road-tax-base-sale-prl          = 0
     1773             road-tax-rubl-sale-prl          = 0
     1774             excise-base-sale-prl            = 0
     1775             excise-rubl-sale-prl            = 0
     1776             discnt-base-sale-prl            = 0
     1777             discnt-rubl-sale-prl            = 0
     1778           .
     1779         end.
     1780         assign
     1781           v-fact-qnty         = v-fact-qnty
     1782                               + buf_temp-prt-obj.fact-qnty
     1783           v-cur-base          = v-cur-base
     1784                               + (if p-curr-r-b = 'base':U
     1785                                   then price-base-with-tax-sale-prl
     1786                                   else price-rubl-with-tax-sale-prl
     1787                                 )
     1788                               * buf_temp-prt-obj.fact-qnty
     1789           v-cur-VAT-base      = v-cur-VAT-base
     1790                               + (if p-curr-r-b = 'base':U
     1791                                   then vat-base-sale-prl
     1792                                   else vat-rubl-sale-prl
     1793                                 )
     1794                               * buf_temp-prt-obj.fact-qnty
     1795           v-cur-SLT-base      = v-cur-SLT-base
     1796                               + (if p-curr-r-b = 'base':U
     1797                                   then slt-base-sale-prl
     1798                                   else slt-rubl-sale-prl
     1799                                 )
     1800                               * buf_temp-prt-obj.fact-qnty
     1801           v-cur-road-tax-base = v-cur-road-tax-base
     1802                               + (if p-curr-r-b = 'base':U
     1803                                   then road-tax-base-sale-prl
     1804                                   else road-tax-rubl-sale-prl
     1805                                 )
     1806                               * buf_temp-prt-obj.fact-qnty
     1807           v-cur-excise-base   = v-cur-excise-base
     1808                               + (if p-curr-r-b = 'base':U
     1809                                   then excise-base-sale-prl
     1810                                   else excise-rubl-sale-prl
     1811                                 )
     1812                               * buf_temp-prt-obj.fact-qnty
     1813         .
     1814       end.
     1815       assign
     1816         p-fact-qnty         = v-fact-qnty
     1817         p-cur-base          = v-cur-base
     1818         p-cur-VAT-base      = v-cur-VAT-base
     1819         p-cur-SLT-base      = v-cur-SLT-base
     1820         p-cur-road-tax-base = v-cur-road-tax-base
     1821         p-cur-excise-base   = v-cur-excise-base
     1822       .
     1823     end.
     1824   end procedure.
     1825   procedure prdoclib-clear-temp-pl-gds :
     1826     define buffer buf_temp-pl-gds for temp-pl-gds .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       for each buf_temp-pl-gds
     1831       on error undo, return error return-value
     1832       :
     1833         delete buf_temp-pl-gds .
     1834       end.
     1835     end.
     1836   end procedure.
     1837   procedure prdoclib-init-temp-pl-gds :
     1838     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     1839     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     1840     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     1841     define buffer buf_pl-gds      for ub.pl-gds .
     1842     define buffer buf_temp-pl-gds for temp-pl-gds .
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       run prdoclib-clear-temp-pl-gds in this-procedure .
     1847       for each buf_pl-gds
     1848         where buf_pl-gds.obj-type = p-obj-type
     1849           and buf_pl-gds.obj-code = p-obj-code
     1850           and buf_pl-gds.gds-code = p-gds-code
     1851       on error undo, return error return-value
     1852       :
     1853         create buf_temp-pl-gds .
     1854         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     1855       end.
     1856     end.
     1857   end procedure.
     1858   procedure prdoclib-init-pl-gds-by-factord :
     1859     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1860     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1861     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1862     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1863     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1864     define input parameter p-fact-order         as decimal   no-undo .
     1865     define input parameter p-include-fact-order as logical   no-undo .
     1866     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     1867     define buffer buf_goods       for ub.goods .
     1868     define buffer buf_gds-obj     for ub.gds-obj .
     1869     define buffer buf_doc-line    for ub.doc-line .
     1870     define buffer buf_temp-pl-gds for temp-pl-gds .
     1871     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     1872     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876       do transaction
     1877       on error undo, return error return-value
     1878       :
     1879   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1881     (input  p-obj-type
     1882     ,input  p-obj-code
     1883     ,input  p-artic
     1884     ,input  p-prod-type
     1885     ,input  p-prod-code
     1886     ,buffer buf_gds-obj
     1887     ) no-error .
     1888         if error-status :error
     1889         then do:
     1890           message
     1891             vss-workfile vss-revision vss-description skip
     1892             vss-include-info0 skip
     1893             "Невозможно найти gds-obj" skip
     1894             error-status :get-message(1) skip
     1895             return-value skip
     1896             view-as alert-box error .
     1897           undo, return error return-value .
     1898         end.
     1899         find current buf_gds-obj exclusive-lock .
     1900       end.
     1901       find first buf_goods no-lock
     1902         where buf_goods.artic     = p-artic
     1903           and buf_goods.prod-type = p-prod-type
     1904           and buf_goods.prod-code = p-prod-code
     1905         .
     1906       run prdoclib-init-temp-pl-gds in this-procedure
     1907         (input p-obj-type
     1908         ,input p-obj-code
     1909         ,input buf_goods.gds-code
     1910         ) .
     1911       if p-include-fact-order = true
     1912       then do:
     1913         assign
     1914          p-fact-order = p-fact-order - 0.0000000001
     1915         .
     1916       end.
     1917       for each buf_doc-line no-lock
     1918         where buf_doc-line.obj-type   = p-obj-type
     1919           and buf_doc-line.obj-code   = p-obj-code
     1920           and buf_doc-line.artic      = p-artic
     1921           and buf_doc-line.prod-type  = p-prod-type
     1922           and buf_doc-line.prod-code  = p-prod-code
     1923           and buf_doc-line.status_    = 'факт':U
     1924           and buf_doc-line.fact-order >= p-fact-order
     1925       on error undo, return error return-value
     1926       :
     1927         run prdoclib-prc-pl-document in this-procedure
     1928           ( input  buf_doc-line.doc-code
     1929            ,input  p-obj-type
     1930            ,input  p-obj-code
     1931            ,input  buf_goods.gds-code
     1932            ,output v-total-pl-gds-qnty
     1933            ,output v-total-pl-gds-cli-qnty
     1934           ) .
     1935       end.
     1936     end.
     1937   end procedure.
     1938   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1939   procedure prl-vat:
     1940     define input parameter parrecid as recid no-undo.
