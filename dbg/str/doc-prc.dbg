        1   define variable vss-revision    as character no-undo init "$Revision$":u .
        2   define variable vss-author      as character no-undo init "$Author$":u .
        3   define variable vss-date        as character no-undo init "$Date$":u .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        5   define variable vss-archive     as character no-undo init "$Archive$":u .
        6   define variable vss-description as character no-undo init "Просмотр сумм по документу, разделенных по поставщикам (партии)" .
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#library  as handle no-undo .
      111   define new global shared variable g#library2 as handle no-undo .
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
      114   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
      115   procedure prdoclib-process-goods :
      116     define input  parameter p-obj-type          as character no-undo .
      117     define input  parameter p-obj-code          as integer   no-undo .
      118     define input  parameter p-artic             as character no-undo .
      119     define input  parameter p-prod-type         as character no-undo .
      120     define input  parameter p-prod-code         as integer   no-undo .
      121     define input  parameter p-check-price-list  as logical   no-undo .
      122     define input  parameter p-check-price-parts as logical   no-undo .
      123     define input  parameter p-doc-num           as character no-undo .
      124     define input  parameter p-fact-date         as date      no-undo .
      125     define input  parameter p-corr-user-db-num  as integer   no-undo .
      126     define input  parameter p-corr-user-name    as character no-undo .
      127     define input  parameter p-corr-date         as date      no-undo .
      128     define input  parameter p-corr-time         as integer   no-undo .
      129     define input  parameter p-corr-time-str     as character no-undo .
      130     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
      131     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
      132     define buffer buf_gds-obj      for ub.gds-obj .
      133     define buffer buf_prt-obj      for ub.prt-obj .
      134     define buffer buf_price-list   for ub.price-list .
      135     define buffer buf_bar-code     for ub.bar-code .
      136     define buffer buf_temp-prt-obj for temp-prt-obj .
      137     define variable v-gds-code             like ub.goods.gds-code    no-undo .
      138     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
      139     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
      140     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
      141     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
      142     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
      143     define variable v-price-sale  like ub.price-list.price-sale no-undo .
      144     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
      145     define variable v-excise      like ub.price-list.excise     no-undo .
      146     do
      147     on error undo, return error return-value
      148     :
      149   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      151     (input  p-artic
      152     ,input  p-prod-type
      153     ,input  p-prod-code
