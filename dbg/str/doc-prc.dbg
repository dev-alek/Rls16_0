      574   procedure prdoclib-clear-temp-prt-obj :
      575     define buffer buf_temp-prt-obj for temp-prt-obj .
      576     do
      577     on error undo, return error return-value
      578     :
      579       for each buf_temp-prt-obj
      580       on error undo, return error return-value
      581       :
      582         delete buf_temp-prt-obj .
      583       end.
      584     end.
      585   end procedure.
      586   procedure prdoclib-create-temp-prt-obj :
      587     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
      588     define parameter buffer buf_prt-obj       for ub.prt-obj .
      589     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      590     define buffer buf_gds-prt for ub.gds-prt .
      591     do
      592     on error undo, return error return-value
      593     :
      594       find first buf_temp-prt-obj
      595         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
      596         no-error .
      597       if not available buf_temp-prt-obj
      598       then do:
      599         create buf_temp-prt-obj .
      600         assign
      601           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
      602           buf_temp-prt-obj.price-sale       = ?
      603           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
      604           buf_temp-prt-obj.price-list-qnty  = ?
      605           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
      606           buf_temp-prt-obj.price-list-recid = ?
      607         .
      608         find first buf_gds-prt no-lock
      609           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      610           .
      611         assign
      612           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      613         .
      614         if buf_temp-prt-obj.is-term
      615         then do:
      616           assign
      617             buf_temp-prt-obj.price-sale = p-root-price-sale
      618           .
      619         end.
      620       end.
      621     end.
      622   end procedure.
      623   procedure prdoclib-temp-prt-obj-by-prt-root :
      624     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
      625     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      626     define buffer buf_gds-prt for ub.gds-prt .
      627     do
      628     on error undo, return error return-value
      629     :
      630       find first buf_temp-prt-obj
      631         where buf_temp-prt-obj.prt-code = p-prt-code
      632         no-error .
      633       if not available buf_temp-prt-obj
      634       then do:
      635         create buf_temp-prt-obj .
      636         assign
      637           buf_temp-prt-obj.prt-code         = p-prt-code
      638           buf_temp-prt-obj.price-sale       = ?
      639           buf_temp-prt-obj.fact-qnty        = 0
      640           buf_temp-prt-obj.price-list-qnty  = ?
      641           buf_temp-prt-obj.prt-obj-recid    = ?
      642           buf_temp-prt-obj.price-list-recid = ?
      643         .
      644         find first buf_gds-prt no-lock
      645           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      646           .
      647         assign
      648           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      649         .
      650         if buf_temp-prt-obj.is-term
      651         then do:
      652           assign
      653             buf_temp-prt-obj.price-sale = 0
      654           .
      655         end.
      656       end.
      657     end.
      658   end procedure.
      659   procedure prdoclib-init-temp-prt-obj :
      660     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
      661     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
      662     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
      663     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
      664     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
      665     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
      666     define buffer buf_prt-obj      for ub.prt-obj .
      667     define buffer buf_temp-prt-obj for temp-prt-obj .
      668     do
      669     on error undo, return error return-value
      670     :
      671       run prdoclib-clear-temp-prt-obj in this-procedure .
      672       for each buf_prt-obj
      673         where buf_prt-obj.obj-type  = p-obj-type
      674           and buf_prt-obj.obj-code  = p-obj-code
      675           and buf_prt-obj.artic     = p-artic
      676           and buf_prt-obj.prod-type = p-prod-type
      677           and buf_prt-obj.prod-code = p-prod-code
      678       on error undo, return error return-value
      679       :
      680         run prdoclib-create-temp-prt-obj in this-procedure
      681           (input  p-root-price-sale
      682           ,buffer buf_prt-obj
      683           ,buffer buf_temp-prt-obj
      684           ).
      685       end.
      686     end.
      687   end procedure.
      688   procedure prdoclib-calc-fact-sale :
      689     define input  parameter p-price-list-recid   as recid     no-undo .
      690     define output parameter p-fact-qnty          as decimal   no-undo .
      691     define output parameter p-cur-base           as decimal   no-undo .
      692     define output parameter p-cur-VAT-base       as decimal   no-undo .
      693     define output parameter p-cur-SLT-base       as decimal   no-undo .
      694     define output parameter p-cur-road-tax-base  as decimal   no-undo .
      695     define output parameter p-cur-excise-base    as decimal   no-undo .
      696     define buffer buf_main_price-list for ub.price-list .
      697     define buffer buf_price-list      for ub.price-list .
      698     define buffer buf_goods           for ub.goods .
      699     define buffer buf_gds-obj         for ub.gds-obj .
      700     define buffer buf_bar-code        for ub.bar-code .
      701     define variable l-empty-scale   as logical   no-undo .
      702     do
      703     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
      704     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
      705     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
      706     :
      707       find first buf_main_price-list no-lock
      708         where recid(buf_main_price-list) = p-price-list-recid
      709         no-error .
      710       if not available buf_main_price-list
      711       then do:
      712         message
      713           vss-workfile vss-revision vss-description skip
      714           vss-include-info0 skip
      715           "Ошибка задания входных параметров" skip
      716           "Не найдена строка переоценки" skip
      717           "Код записи (recid)" p-price-list-recid skip
      718           view-as alert-box error .
      719         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
      720       end.
      721       if buf_main_price-list.main-price <> true
      722       then do:
      723         message
      724           vss-workfile vss-revision vss-description skip
      725           vss-include-info0 skip
      726           "Ошибка задания входных параметров" skip
      727           "Строка переоценки не является основной" skip
      728           "Код записи (recid)" p-price-list-recid skip
      729           "Переоценка" buf_main_price-list.doc-num skip
      730           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      731           "Бар-код" buf_main_price-list.b-code skip
      732           view-as alert-box error .
      733         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
      734       end.
      735       find first buf_goods no-lock
      736         where buf_goods.artic     = buf_main_price-list.artic
      737           and buf_goods.prod-type = buf_main_price-list.prod-type
      738           and buf_goods.prod-code = buf_main_price-list.prod-code
      739         no-error .
      740       if not available buf_goods
      741       then do:
      742         message
      743           vss-workfile vss-revision vss-description skip
      744           vss-include-info0 skip
      745           "Не найден товар" skip
      746           "Переоценка" buf_main_price-list.doc-num skip
      747           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      748           view-as alert-box error .
      749         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      750       end.
      751   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      753     (input  buf_main_price-list.artic
      754     ,input  buf_main_price-list.prod-type
      755     ,input  buf_main_price-list.prod-code
