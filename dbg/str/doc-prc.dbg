      238         buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
      239       .
      240       define variable l-empty-scale as logical no-undo .
      241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      242     (input  v-root-node
      243     ,input  'empty-scale=request'
      244     ,output l-empty-scale
      245     ) no-error .
      246       if error-status :error
      247       then do:
      248         message
      249           vss-workfile vss-revision vss-description skip
      250           vss-include-info0 skip
      251           "Ошибка при определении атрибута шкалы" skip
      252           "Код признака" v-root-node skip
      253           "Запрашивался атрибут" "empty-scale=request" skip
      254           error-status :get-message(1) skip
      255           return-value skip
      256           view-as alert-box error .
      257         undo, return error .
      258       end.
      259       assign
      260         v-total-term-fact-qnty = 0
      261         v-total-fact-sale      = 0
      262       .
      263       if l-empty-scale = true
      264       then do:
      265         for each buf_price-list
      266           where buf_price-list.doc-num    = v-doc-num
      267             and buf_price-list.main-price = false
      268             and buf_price-list.artic      = p-artic
      269             and buf_price-list.prod-type  = p-prod-type
      270             and buf_price-list.prod-code  = p-prod-code
      271             and buf_price-list.price-type = ""
      272         on error undo, return error return-value
      273         :
      274           if buf_price-list.doc-qnty <> ? and p-check-price-parts
      275           then do:
      276             message
      277               vss-workfile vss-revision vss-description skip
      278               vss-include-info0 skip
      279               "Ошибка при закрытии переоценки" skip
      280               "Для неосновного бар-кода товара с пустой шкалой" skip
      281               "указано количество отличное от ?" skip
      282               "Переоценка" v-doc-num skip
      283               "Бар-код" buf_price-list.b-code skip
      284               "Артикул" p-artic p-prod-type p-prod-code skip
      285               "Количество" buf_price-list.doc-qnty skip
      286               view-as alert-box error .
      287             undo, return error .
      288           end.
      289         end.
      290       end.
      291       if l-empty-scale = false
      292       then do:
      293         define variable v-unit-base like ub.goods.unit-base no-undo .
      294   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      296     (input  v-gds-code
      297     ,output v-unit-base
      298     ) no-error .
      299         if error-status :error
      300         then do:
      301           message
      302             vss-workfile vss-revision vss-description skip
      303             vss-include-info0 skip
      304             "Ошибка при определении базовой единицы измерения товара" skip
      305             "Код товара" v-gds-code skip
      306             error-status :get-message(1) skip
      307             return-value skip
      308             view-as alert-box error .
      309           undo, return error .
      310         end.
      311         for each buf_price-list
      312           where buf_price-list.doc-num    = v-doc-num
      313             and buf_price-list.main-price = false
      314             and buf_price-list.artic      = p-artic
      315             and buf_price-list.prod-type  = p-prod-type
      316             and buf_price-list.prod-code  = p-prod-code
      317             and buf_price-list.price-type = ""
      318         on error undo, return error
      319         :
      320           if buf_price-list.doc-qnty = ?
