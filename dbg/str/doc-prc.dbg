      169         message
      170           vss-workfile vss-revision vss-description skip
      171           vss-include-info0 skip
      172           "Ошибка при начале товародвижения товара на объекте" skip
      173           "Объект" p-obj-type p-obj-code skip
      174           "Артикул" p-artic p-prod-type p-prod-code skip
      175           error-status :get-message(1) skip
      176           return-value skip
