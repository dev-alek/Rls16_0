     3975       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3976       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3977       .
     3978   end.
     3979   otherwise do:
     3980     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3981                              cl_tt-clcparts.purch-code,
     3982                              cl_tt-clcparts.part-code,
     3983                              cl_tt-clcparts.out-code,
     3984                              cl_tt-clcparts.in-code,
     3985                              cl_tt-clcparts.artic,
     3986                              cl_tt-clcparts.prod-type,
     3987                              cl_tt-clcparts.prod-code).
     3988   end.
     3989   end case.
     3990   end.
     3991   end procedure.
     3992   procedure clcprtsl_calc-line :
     3993   define input  parameter parrec-line as recid no-undo.
     3994   define variable v-tax-date         as   date                     no-undo.
     3995   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3996   define variable varr-b             as   character                no-undo.
     3997   define variable varr-btype         as   character                no-undo.
     3998   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3999   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     4000   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     4001   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     4002   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     4003   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     4004   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     4005   define variable varb-code          like ub.bar-code.b-code       no-undo.
     4006   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4007   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4008   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4009   define variable varexcise          like ub.price-list.excise     no-undo.
     4010   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     4011   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     4012   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     4013   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4014   define variable v-varsum           as decimal                  no-undo.
     4015   define variable varprice-salef as decimal   no-undo .
     4016   define buffer bf_trn-doc             for ub.trn-doc.
     4017   define buffer bf_doc-line            for ub.doc-line.
     4018   define buffer bf_gds-dtl             for ub.gds-dtl.
     4019   define buffer bf_goods               for ub.goods.
     4020   define buffer bf_parts               for ub.parts.
     4021   define buffer bf_sysconf             for ub.sysconf.
     4022   define buffer bf_tt-allsum-line      for tt-allsum-line.
     4023   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     4024   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     4025   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     4026   define buffer buf_parts        for ub.parts.
     4027   v-calcbypart = no.
     4028   do on error undo, return error return-value :
     4029   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4030   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4031     (output varr-b
     4032     )  .
     4033     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     4034     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     4035     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     4036                               bf_goods.prod-type = bf_doc-line.prod-type and
     4037                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     4038     if bf_trn-doc.fact-date <> ?        then do:
     4039       assign v-tax-date = bf_trn-doc.fact-date.
     4040     end.
     4041     else do:
     4042       assign v-tax-date = ?.
     4043     end.
     4044   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4045   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4046     (input  bf_goods.gds-code
     4047     ,input  '1':U
     4048     ,input  v-tax-date
     4049     ,input  bf_trn-doc.host-code
     4050     ,input  bf_trn-doc.obj-type
     4051     ,input  bf_trn-doc.obj-code
     4052     ,output v-vat-pc
     4053     ) no-error .
     4054     if error-status :error
     4055     or v-vat-pc = ? then do:
     4056        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4057     end.
     4058     if bf_goods.gds-type = 'у':U or
     4059        bf_trn-doc.status_ = 'запрос':U then do:
     4060       for each bf_tt-allsum-line
     4061       on error undo, return error return-value
     4062        :
     4063         delete bf_tt-allsum-line.
     4064       end.
     4065       create bf_tt-allsum-line.
     4066       assign
     4067        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     4068       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     4069                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     4070                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     4071                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     4072         assign
     4073           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     4074           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     4075           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     4076           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     4077           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     4078           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4079           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4080           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     4081           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     4082           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     4083           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4084           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4085           bf_tt-allsum-line.vat-cli-acc          =  ?
     4086           .
     4087       end.
     4088       assign
     4089         bf_tt-allsum-line.cli-qnty             =  ?
     4090         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4091         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4092         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4093         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4094         bf_tt-allsum-line.road-tax-base-doc    =  0
     4095         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     4096         bf_tt-allsum-line.excise-base-doc      =  0
     4097         bf_tt-allsum-line.excise-rubl-doc      =  0
