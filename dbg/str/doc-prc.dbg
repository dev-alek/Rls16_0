     4411           trim(error-status :get-message(4))
     4412           trim(error-status :get-message(5)) skip
     4413           view-as alert-box error.
     4414         undo, return error .
     4415       end.
     4416     end.
     4417   end.
     4418   end.
     4419   procedure clcprtsl_calc-ttable :
     4420   define input parameter paris-doc           as   logical                 no-undo.
     4421   define input parameter paris-cur           as   logical                 no-undo.
     4422   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4423   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4424   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4425   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4426   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4427   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4428   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4429   define input parameter parr-b              as   character               no-undo.
     4430   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4431   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4432   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4433   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4434   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4435   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4436   define buffer bf_tt-allsum      for tt-allsum.
     4437   define buffer bf_tt-clcparts    for tt-clcparts.
     4438   define buffer bf_tt-allsum-line for tt-allsum-line.
     4439   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4440   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4441   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4442   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4443   define variable varexcise          like ub.price-list.excise     no-undo.
     4444   do on error undo, return error return-value :
     4445   for each bf_tt-allsum-line
     4446   on error undo, return error return-value
     4447    :
     4448     delete bf_tt-allsum-line.
     4449   end.
     4450   for each bf_tt-allsum
     4451   on error undo, return error return-value
     4452   :
     4453     delete bf_tt-allsum.
     4454   end.
     4455   for each bf_tt-clcparts
     4456   on error undo, return error return-value
     4457   :
     4458   if v-calcbypart then do:
     4459             assign
     4460             parcur-base =   bf_tt-clcparts.part-cur-base
     4461             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4462             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4463             .
     4464   end.
     4465      run clcprtsl_calc-parts in this-procedure (
     4466        input recid(bf_tt-clcparts),
     4467        input paris-doc,
     4468        input paris-cur,
     4469        input parroad-tax,
     4470        input parexcise,
     4471        input parvat-pc,
     4472        input parcons-vat-pc,
     4473        input parslt-pc,
     4474        input parbase-rate,
     4475        input parbase-scale,
     4476        input parr-b,
     4477        input parcur-base,
     4478        input parcur-road-tax,
     4479        input parcur-excise,
     4480        input parcur-vat-pc,
     4481        input parcurcons-vat-pc,
     4482        input parcurslt-pc
     4483        ) no-error.
     4484     if error-status:error then do:
     4485       message
     4486         vss-workfile vss-revision vss-description skip
     4487         vss-include-info22 skip
     4488         "Ошибка при обсчете партии" skip
     4489         "Документ партии " bf_tt-clcparts.out-code skip
     4490         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4491         return-value skip
     4492         error-status:get-message(1) skip
     4493         error-status:get-message(2) skip
     4494         error-status:get-message(3) skip
     4495         view-as alert-box error .
     4496       undo, return error .
     4497     end.
     4498     for each bf_tt-allsum on error undo, return error return-value :
     4499       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4500       if not available bf_tt-allsum-line then do:
     4501         create bf_tt-allsum-line.
     4502         assign
     4503           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4504       end.
     4505       assign
     4506         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4507         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4508         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     4509         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     4510         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
