     4317         assign
     4318           varcur-base      = varcur-base      / varcur-fact-qnty
     4319           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     4320           varcur-excise    = varcur-excise    / varcur-fact-qnty
