     3918       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3919       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3920       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3921       .
     3922     assign
     3923       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3924       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3925       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3926       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3927       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3928       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3929       bfsacc_tt-allsum.vat-base-doc        = 0
     3930       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3931       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3932       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
