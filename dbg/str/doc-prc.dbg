      324               no-error .
      325             if  available buf_bar-code
      326             and buf_bar-code.unit-cli = v-unit-base
      327             then do:
      328               message
      329                 vss-workfile vss-revision vss-description skip
      330                 vss-include-info0 skip
      331                 "Ошибка при закрытии переоценки" skip
      332                 "Не задано количество для бар-кода с основной единицей измерения" skip
      333                 "Переоценка" v-doc-num skip
      334                 "Бар-код" buf_price-list.b-code skip
      335                 "Артикул" p-artic p-prod-type p-prod-code skip
      336                 "Количество" buf_price-list.doc-qnty skip
      337                 "Основная единица измерения" v-unit-base skip
      338                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      339                 view-as alert-box error .
      340               undo, return error .
      341             end.
      342             next .
      343           end.
      344           find first buf_bar-code no-lock
      345             where buf_bar-code.b-code = buf_price-list.b-code
      346             no-error .
      347           if not available buf_bar-code
      348           then do:
      349             message
      350               vss-workfile vss-revision vss-description skip
      351               vss-include-info0 skip
      352               "В переоценке задан несуществующий бар-код" skip
      353               "Переоценка" v-doc-num skip
      354               "Артикул" p-artic p-prod-type p-prod-code skip
      355               "Бар-код" buf_price-list.b-code skip
      356               view-as alert-box error .
      357             undo, return error .
      358           end.
      359           if buf_bar-code.in-code <> ""
      360           or buf_bar-code.part-code <> ""
      361           then do:
      362             message
      363               vss-workfile vss-revision vss-description skip
      364               vss-include-info0 skip
      365               "В переоценке задан бар-код партии" skip
      366               "Данная версия системы не рассчитана на работу со специальными ценами по партиям" skip
      367               "Переоценка" v-doc-num skip
      368               "Бар-код" buf_price-list.b-code skip
      369               "Артикул" p-artic p-prod-type p-prod-code skip
      370               "Код ПН" buf_bar-code.in-code buf_bar-code.part-code skip
      371               view-as alert-box error .
      372             undo, return error .
      373           end.
      374           if buf_bar-code.node-code <> v-root-node
      375           then do:
      376   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      378     (input  p-obj-type
      379     ,input  p-obj-code
      380     ,input  p-artic
      381     ,input  p-prod-type
      382     ,input  p-prod-code
      383     ,input  buf_bar-code.node-code
      384     ,buffer buf_prt-obj
      385     ) no-error .
      386             if error-status :error
      387             then do:
      388               message
      389                 vss-workfile vss-revision vss-description skip
      390                 vss-include-info0 skip
      391                 "Невозможно найти prt-obj" skip
      392                 error-status :get-message(1) skip
      393                 return-value skip
      394                 view-as alert-box error .
      395               undo, return error .
      396             end.
      397             run prdoclib-create-temp-prt-obj in this-procedure
      398               (input  v-price-sale
      399               ,buffer buf_prt-obj
      400               ,buffer buf_temp-prt-obj
      401               ).
      402             assign
      403               buf_temp-prt-obj.price-sale       = buf_price-list.price-sale
      404               buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
      405               buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
      406             .
      407           end.
      408         end.
      409         for each buf_temp-prt-obj
      410           where buf_temp-prt-obj.is-term = true
      411         :
      412           if buf_temp-prt-obj.price-list-recid <> ?
      413           then do:
      414             assign
      415               v-total-term-fact-qnty = v-total-term-fact-qnty
      416                                     + buf_temp-prt-obj.fact-qnty
      417               v-total-fact-sale = v-total-fact-sale
      418                                 + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      419             .
      420           end.
      421           if p-check-price-list = true
      422           then do:
      423             if buf_temp-prt-obj.price-list-recid = ?
      424             or buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.price-list-qnty
      425             then do:
      426             end.
      427             else do:
      428               message
      429                 vss-workfile vss-revision vss-description skip
      430                 vss-include-info0 skip
      431                 "Ошибка при закрытии переоценки" skip
      432                 "Несовпадают текущие количества по признаку" skip
      433                 "и количество признака в переоценке" skip
      434                 "Переоценка" v-doc-num skip
      435                 "Артикул" p-artic p-prod-type p-prod-code skip
      436                 "Код признака" buf_temp-prt-obj.prt-code skip
      437                 "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      438                 "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      439                 "Корень шкалы товара" v-root-node skip
      440                 view-as alert-box error .
      441               undo, return error .
      442             end.
      443           end.
      444         end.
      445       end.
      446       find first buf_temp-prt-obj
      447         where buf_temp-prt-obj.prt-code = v-root-node
      448         .
      449       assign
      450         buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
      451                                     - v-total-term-fact-qnty
      452       .
      453       if p-check-price-list = true
      454       then do:
      455         if buf_temp-prt-obj.fact-qnty <> buf_temp-prt-obj.price-list-qnty and p-check-price-parts
      456         then do:
      457           message
      458             vss-workfile vss-revision vss-description skip
      459             vss-include-info0 skip
      460             "Ошибка при закрытии переоценки" skip
      461             "Несовпадают текущие количества по корневому признаку" skip
      462             "и количество признака в переоценке" skip
      463             "Переоценка" v-doc-num skip
      464             "Артикул" p-artic p-prod-type p-prod-code skip
      465             "Код признака" buf_temp-prt-obj.prt-code skip
      466             "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      467             "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      468             view-as alert-box error .
      469           undo, return error .
      470         end.
      471       end.
      472       assign
      473         v-total-fact-sale = v-total-fact-sale
      474                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      475       .
      476       if v-total-fact-sale = ?
      477       then do:
      478         message
      479           vss-workfile vss-revision vss-description skip
      480           vss-include-info0 skip
      481           "Ошибка при вычислении суммы в продажных ценах" skip
      482           "Получено неопределенное значение" skip
      483           "Переоценка" v-doc-num skip
      484           "Артикул" p-artic p-prod-type p-prod-code skip
      485           "Код признака" buf_temp-prt-obj.prt-code skip
      486           "Сумма в продажных ценах" v-total-fact-sale skip
      487           view-as alert-box error .
      488         undo, return error .
      489       end.
      490       define variable v-old-fact-qnty     as decimal   no-undo .
      491       define variable v-old-fact-cli-qnty as decimal   no-undo .
      492       define variable v-old-fact-base     as decimal   no-undo .
      493       define variable v-old-fact-rubl     as decimal   no-undo .
      494       define variable v-old-fact-sale     as decimal   no-undo .
      495       assign
