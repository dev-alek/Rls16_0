     4515         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     4516         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     4517         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     4518         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     4519         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     4520         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     4521         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     4522         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     4523         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     4524         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     4525         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     4526         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     4527         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     4528         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     4529         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     4530         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     4531         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     4532         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     4533         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     4534         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     4535         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     4536         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     4537         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     4538         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     4539         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     4540         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     4541         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     4542         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     4543         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     4544         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     4545         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     4546         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     4547         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     4548         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     4549         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     4550         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     4551         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     4552         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     4553         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     4554         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     4555         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     4556         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     4557         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     4558         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     4559         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     4560         .
     4561     end.
     4562   end.
     4563   end.
     4564   end procedure.
     4565   define variable v-ov-qnty     like ub.parts.fact-qnty no-undo .
     4566   define variable v-ov-base     like ub.doc-line.price-base no-undo.
     4567   define variable v-ov-VAT-base like ub.doc-line.price-base no-undo.
     4568   define variable v-ov-SLT-base like ub.doc-line.price-base no-undo.
     4569   def shared buffer p-doc for price-doc.
     4570   DEFINE BUTTON B-Help
     4571        LABEL "Помо&щь"
     4572        SIZE 10 BY 1
     4573        BGCOLOR 8 .
     4574   DEFINE BUTTON b_exit AUTO-END-KEY
     4575        LABEL "Выход"
     4576        SIZE 10 BY 1
     4577        BGCOLOR 8 .
     4578   DEFINE VARIABLE ov AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
     4579        LABEL "Переоценка"
     4580         VIEW-AS TEXT
     4581        SIZE 14 BY .67
     4582        FGCOLOR 4  NO-UNDO.
     4583   DEFINE VARIABLE ov-no-SLT-VAT AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
     4584        LABEL "Без НДС и НсП"
     4585         VIEW-AS TEXT
     4586        SIZE 14 BY .67 TOOLTIP "Переоцека без НДС и налога с продаж"
     4587        FGCOLOR 4  NO-UNDO.
     4588   DEFINE VARIABLE SLT AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
     4589        LABEL "НсП"
     4590         VIEW-AS TEXT
     4591        SIZE 14 BY .67 TOOLTIP "Налог с продаж"
     4592        FGCOLOR 4  NO-UNDO.
     4593   DEFINE VARIABLE VAT AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
     4594        LABEL "НДС"
     4595         VIEW-AS TEXT
     4596        SIZE 14 BY .67 TOOLTIP "НДС"
     4597        FGCOLOR 4  NO-UNDO.
     4598   DEFINE QUERY BROWSE-3 FOR
     4599         tt-title SCROLLING.
     4600   DEFINE BROWSE BROWSE-3
     4601     QUERY BROWSE-3 DISPLAY
     4602         tt-title.purch-name format "x(11)" column-label "Тип приобретения"
     4603   tt-title.fact-qnty column-label "Кол-во"
     4604   tt-title.ov-base   column-label "Сумма(б.в.)"
     4605   tt-title.no-VAT-base column-label "Без НДС и НсП(б.в.)"
     4606   tt-title.VAT-base  column-label "НДС(б.в.)"
     4607   tt-title.SLT-base  column-label "НсП(б.в.)"
     4608       WITH NO-ROW-MARKERS SEPARATORS SIZE 78.75 BY 8.38.
     4609   DEFINE FRAME Dialog-Frame
     4610        b_exit AT ROW 1 COL 1
     4611        B-Help AT ROW 1 COL 11
     4612        BROWSE-3 AT ROW 5.38 COL 1.63
     4613        ov AT ROW 1.46 COL 37.38 COLON-ALIGNED
     4614        ov-no-SLT-VAT AT ROW 2.38 COL 37.38 COLON-ALIGNED
     4615        SLT AT ROW 3.29 COL 37.38 COLON-ALIGNED
     4616        VAT AT ROW 4.13 COL 37.38 COLON-ALIGNED
     4617        SPACE(27.99) SKIP(9.15)
     4618       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4619            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4620            TITLE "<insert dialog title>"
     4621            CANCEL-BUTTON b_exit.
     4622   ASSIGN
     4623          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4624          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4625   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4626   DO:
     4627     APPLY "END-ERROR":U TO SELF.
     4628   END.
     4629   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4630   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4631   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4632   on help of frame Dialog-Frame
     4633   do:
     4634     run gbl/app_help.p
     4635       (input this-procedure :file-name
     4636       ,input ''
     4637       ,input ?
     4638       ) no-error.
     4639     if error-status :error then do:
     4640       message
     4641         "Ошибка при вызове помощи"
     4642         error-status :get-message(1)
     4643         view-as alert-box .
     4644     end.
     4645   end.
     4646   run minbtn-set in this-procedure .
     4647   on choose of b-help in frame Dialog-Frame
     4648   do:
     4649     apply "help":u to frame Dialog-Frame .
     4650   end.
     4651   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4652   procedure minbtn-set :
     4653       do
     4654           on error undo, return error return-value
     4655           :
     4656           define variable ii              as integer       no-undo .
     4657           define variable fh              as widget-handle no-undo .
     4658           define variable hh              as widget-handle no-undo .
     4659           define variable v-h             as handle        extent 4 no-undo .
     4660           define variable v-name-button   as character     no-undo .
     4661           define variable v-help-old-x    as decimal       no-undo .
     4662           define variable v-help-old-y    as decimal       no-undo .
     4663           define variable v-help-old-size as decimal       no-undo .
     4664           define variable v-frame-width   as decimal       no-undo .
     4665           define variable jj              as integer       no-undo .
     4666           do
     4667               on error undo, return error
     4668               :
     4669               assign
     4670                   v-frame-width = frame Dialog-Frame:width - 0.3
     4671                   fh            = frame Dialog-Frame:first-child
     4672                   hh            = fh:first-child
     4673                   ii            = 1
     4674                   .
     4675               do while valid-handle(hh):
     4676                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4677                   do:
     4678                       case lc(hh:name) :
     4679                           when "b-help" then
     4680                               do:
     4681                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4682                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4683                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4684                                   hh:TOOLTIP = "Помощь" .
     4685                                   v-help-old-x = hh:column .
     4686                                   v-help-old-y = hh:row    .
     4687                                   v-help-old-size = hh:width .
     4688                                   hh:width-chars = 2.5 .
     4689                               end.
     4690                           when "b-print" then
     4691                               do:
     4692                                   hh:load-image("cmp/b-print.bmp":u) .
     4693                                   hh:TOOLTIP = "Печать" .
     4694                                   v-h[ii] = hh:handle .
     4695                                   ii = ii + 1 .
     4696                                   hh:width-chars = 3 .
     4697                               end.
     4698                           when "b-history" or
     4699                           when "b-hist" then
     4700                               do:
     4701                                   hh:load-image("cmp/b-hist.bmp":u) .
     4702                                   hh:TOOLTIP = "История" .
     4703                                   v-h[ii] = hh:handle .
     4704                                   ii = ii + 1 .
     4705                                   hh:width-chars = 3 .
     4706                               end.
     4707                           when "b-sch" then
     4708                               do:
     4709                                   hh:load-image("cmp/b-sch.bmp":u) .
     4710                                   hh:TOOLTIP = "Установка Фильтра" .
     4711                                   v-h[ii] = hh:handle .
     4712                                   ii = ii + 1 .
     4713                                   hh:width-chars = 3 .
     4714                               end.
     4715                           when "b-hist-user" then
     4716                               do:
     4717                                   hh:load-image("cmp/b-hist.bmp":u) .
     4718                                   hh:TOOLTIP = "История пользователя" .
     4719                                   ii = ii + 1 .
     4720                               end.
     4721                       end case.
     4722                   end.
     4723                   hh = hh:next-sibling.
     4724               end.
     4725               b-help:column = v-frame-width - b-help:width-chars.
     4726               jj = 0.
     4727               repeat ii = 4 to 1 by -1 :
     4728                   if valid-handle (v-h[ii] ) then
     4729                   do:
     4730                       jj  = jj + 1 .
     4731                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4732                       v-h[ii]:row    = v-help-old-y .
     4733                   end.
     4734               end.
     4735           end.
     4736       end.
     4737   end procedure.
     4738   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4739   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4740   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4741   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4742   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4743   define variable v-diasize-current-frame-height as decimal   no-undo .
     4744   define variable v-diasize-change-size          as logical   no-undo .
     4745   define variable v-diasize-resize-button        as handle    no-undo .
     4746   define variable v-diasize-wndmax               as logical   no-undo .
     4747   define variable v-diasize-wndstore             as logical   no-undo .
     4748   define variable v-diasize-proc-name            as character no-undo .
     4749   define variable v-diasize-browse-handle        as handle    no-undo .
     4750   define variable v-diasize-browse-number        as integer   no-undo .
     4751   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4752   define temp-table temp-diasize-handle no-undo
     4753     field handle-value  as handle
     4754     field save-position as decimal
     4755     index xpk is primary unique handle-value
     4756     .
     4757   define temp-table temp-browse-handle no-undo
     4758     field browse-type   as character
     4759     field browse-number as integer
     4760     field browse-handle as handle
     4761     field original-size as decimal
     4762     index xpk is primary unique browse-type browse-number
     4763     index xie browse-type browse-handle
     4764   .
     4765   procedure diasize_change-height :
     4766     define input  parameter p-change-value  as decimal   no-undo .
     4767     define input  parameter p-move-resize   as logical   no-undo .
     4768     define variable v-field-group-handle    as handle    no-undo .
     4769     define variable v-object-handle         as handle    no-undo .
     4770     define variable v-frame-height          as decimal   no-undo .
     4771     define variable v-frame-virtual-height  as decimal   no-undo .
     4772     define variable v-browse-height         as decimal   no-undo .
     4773     define variable v-window-height         as decimal   no-undo .
     4774     define variable v-window-virtual-height as decimal   no-undo .
     4775     define variable v-change-sign           as integer   no-undo .
     4776     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4777     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4778     if p-change-value > 0
     4779     then do:
     4780       if frame Dialog-Frame :height + p-change-value
     4781           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4782       then do:
     4783         assign
     4784           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4785                           - (frame Dialog-Frame :height-chars)
     4786         .
     4787         if p-change-value <= 0
     4788         then do:
     4789           run diasize_position-resize-button in this-procedure .
     4790           return .
     4791         end.
     4792       end.
     4793     end.
     4794     if p-change-value < 0
     4795     then do:
     4796       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4797       then do:
     4798         assign
     4799           p-change-value = v-diasize-orig-frame-height
     4800                          - (frame Dialog-Frame :height-chars)
     4801         .
     4802         if p-change-value >= 0
     4803         then do:
     4804           run diasize_position-resize-button in this-procedure .
     4805           return .
     4806         end.
     4807       end.
     4808     end.
     4809     if p-change-value >= 0
     4810     then do:
     4811       assign
     4812         v-change-sign = 1
     4813       .
     4814     end.
     4815     else do:
     4816       assign
     4817         v-change-sign = -1
     4818       .
     4819     end.
     4820     assign
     4821       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4822     .
     4823     if p-change-value = 0
     4824     then do:
     4825       run diasize_position-resize-button in this-procedure .
     4826       return .
     4827     end.
     4828     move_block:
     4829     do
     4830     on error undo move_block, retry move_block
     4831     :
     4832       if retry
     4833       then do:
     4834         do
     4835         on error undo move_block, leave move_block
     4836         :
     4837           if p-change-value > 0
     4838           then do:
     4839             for each buf_temp-diasize-handle
     4840             on error undo, next
     4841             :
     4842               assign
     4843                 v-object-handle = buf_temp-diasize-handle.handle-value
     4844               .
     4845               if v-object-handle <> v-diasize-resize-button
     4846               then do:
     4847                 assign
     4848                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4849                 .
     4850               end.
     4851             end.
     4852             assign
     4853               v-diasize-browse-handle :height = v-browse-height
     4854             .
     4855             for each buf_temp-browse-handle
     4856               where buf_temp-browse-handle.browse-type = 'height':u
     4857             on error undo, next
     4858             :
     4859               assign
     4860                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4861               .
     4862             end.
     4863             assign
     4864               frame Dialog-Frame :height = v-frame-height
     4865             .
     4866             if frame Dialog-Frame :scrollable = true
     4867             then do:
     4868               assign
     4869                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4870               .
     4871             end.
     4872             run diasize_position-resize-button in this-procedure .
     4873           end.
     4874           else do:
     4875             if frame Dialog-Frame :scrollable = true
     4876             then do:
     4877               assign
     4878                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4879               .
     4880             end.
     4881             assign
     4882               frame Dialog-Frame :height = v-frame-height
     4883             .
     4884             assign
     4885               v-diasize-browse-handle :height = v-browse-height
     4886             .
     4887             for each buf_temp-browse-handle
     4888               where buf_temp-browse-handle.browse-type = 'height':u
     4889             on error undo, next
     4890             :
     4891               assign
     4892                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4893               .
     4894             end.
     4895             for each buf_temp-diasize-handle
     4896             on error undo, next
     4897             :
     4898               assign
     4899                 v-object-handle = buf_temp-diasize-handle.handle-value
     4900               .
     4901               if v-object-handle <> v-diasize-resize-button
     4902               then do:
     4903                 assign
     4904                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4905                 .
     4906               end.
     4907             end.
     4908             run diasize_position-resize-button in this-procedure .
     4909           end.
     4910           assign
     4911             v-diasize-change-size = false
     4912           .
     4913           leave move_block .
     4914         end.
     4915       end.
     4916       assign
     4917         v-diasize-need-full-display = true
     4918       .
     4919       if v-diasize-change-size = false
     4920       then do:
     4921         assign
     4922           v-diasize-change-size = true
     4923         .
     4924       end.
     4925       else do:
     4926         return .
     4927       end.
     4928       assign
     4929         v-frame-height = frame Dialog-Frame :height
     4930         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4931         v-browse-height = v-diasize-browse-handle :height
     4932       .
     4933       for each buf_temp-browse-handle
     4934         where buf_temp-browse-handle.browse-type = 'height':u
     4935       :
     4936         assign
     4937           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4938         .
     4939       end.
     4940       for each buf_temp-diasize-handle
     4941       :
     4942         delete buf_temp-diasize-handle .
     4943       end.
     4944       assign
     4945         v-field-group-handle = frame Dialog-Frame :first-child
     4946       .
     4947       do while valid-handle(v-field-group-handle)
     4948       :
     4949         assign
     4950           v-object-handle = v-field-group-handle :first-child
     4951         .
     4952         do while valid-handle(v-object-handle)
     4953         :
     4954           if  v-object-handle <> v-diasize-browse-handle :handle
     4955           and can-query(v-object-handle, "row")
     4956           and can-query(v-object-handle, "height")
     4957           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4958           then do:
     4959             find first buf_temp-browse-handle
     4960               where buf_temp-browse-handle.browse-type   = 'height':u
     4961                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4962               no-error .
     4963             if available buf_temp-browse-handle
     4964             then do:
     4965             end.
     4966             else do:
     4967               create buf_temp-diasize-handle .
     4968               assign
     4969                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4970                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4971               .
     4972             end.
     4973           end.
     4974           assign
     4975             v-object-handle = v-object-handle :next-sibling
     4976           .
     4977         end.
     4978         assign
     4979           v-field-group-handle = v-field-group-handle :next-sibling
     4980         .
     4981       end.
     4982       do with frame Dialog-Frame
     4983       :
     4984         hide v-diasize-resize-button .
     4985         assign
     4986           v-diasize-resize-button :row    = 1
     4987           v-diasize-resize-button :column = 1
     4988         .
     4989       end.
     4990       if p-change-value > 0
     4991       then do:
     4992         if frame Dialog-Frame :scrollable = true
     4993         then do:
     4994           assign
     4995             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4996             no-error .
     4997           if error-status :error
     4998           or error-status :get-message(1) <> ""
     4999           then do:
     5000             undo move_block, retry move_block .
     5001           end.
     5002         end.
     5003         assign
     5004           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5005           no-error .
     5006         if error-status :error
     5007         or error-status :get-message(1) <> ""
     5008         then do:
     5009           undo move_block, retry move_block .
     5010         end.
     5011         assign
     5012           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5013           no-error .
     5014         if error-status :error
     5015         or error-status :get-message(1) <> ""
     5016         then do:
     5017           undo move_block, retry move_block .
     5018         end.
     5019         for each buf_temp-browse-handle
     5020           where buf_temp-browse-handle.browse-type = 'height':u
     5021         on error undo move_block, retry move_block
     5022         :
     5023           assign
     5024             buf_temp-browse-handle.browse-handle :height
     5025               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5026             no-error .
     5027           if error-status :error
     5028           or error-status :get-message(1) <> ""
     5029           then do:
     5030             undo move_block, retry move_block .
     5031           end.
     5032         end.
     5033         for each buf_temp-diasize-handle
     5034         on error undo move_block, retry move_block
     5035         :
     5036           assign
     5037             v-object-handle = buf_temp-diasize-handle.handle-value
     5038           .
     5039           if v-object-handle <> v-diasize-resize-button
     5040           then do:
     5041             assign
     5042               v-object-handle :row = v-object-handle :row + p-change-value
     5043               no-error .
     5044             if error-status :error
     5045             or error-status :get-message(1) <> ""
     5046             then do:
     5047               undo move_block, retry move_block .
     5048             end.
     5049           end.
     5050         end.
     5051       end.
     5052       else do:
     5053         for each buf_temp-diasize-handle
     5054         on error undo move_block, retry move_block
     5055         :
     5056           assign
     5057             v-object-handle = buf_temp-diasize-handle.handle-value
     5058           .
     5059           if v-object-handle <> v-diasize-resize-button
     5060           then do:
     5061             assign
     5062               v-object-handle :row = v-object-handle :row + p-change-value
     5063               no-error .
     5064             if error-status :error
     5065             or error-status :get-message(1) <> ""
     5066             then do:
     5067               undo move_block, retry move_block .
     5068             end.
     5069           end.
     5070         end.
     5071         assign
     5072           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5073           no-error .
     5074         if error-status :error
     5075         or error-status :get-message(1) <> ""
     5076         then do:
     5077           undo move_block, retry move_block .
     5078         end.
     5079         for each buf_temp-browse-handle
     5080           where buf_temp-browse-handle.browse-type = 'height':u
     5081         on error undo move_block, retry move_block
     5082         :
     5083           assign
     5084             buf_temp-browse-handle.browse-handle :height
     5085               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5086             no-error .
     5087           if error-status :error
     5088           or error-status :get-message(1) <> ""
     5089           then do:
     5090             undo move_block, retry move_block .
     5091           end.
     5092         end.
     5093         assign
     5094           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5095           no-error .
     5096         if error-status :error
     5097         or error-status :get-message(1) <> ""
     5098         then do:
     5099           undo move_block, retry move_block .
     5100         end.
     5101         if frame Dialog-Frame :scrollable = true
     5102         then do:
     5103           assign
     5104             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     5105             no-error .
     5106           if error-status :error
     5107           or error-status :get-message(1) <> ""
     5108           then do:
     5109             undo move_block, retry move_block .
     5110           end.
     5111         end.
     5112       end.
     5113       if p-move-resize = true
     5114       then do:
     5115         run diasize_position-resize-button in this-procedure .
     5116       end.
     5117       if v-diasize-wndstore = true
     5118       then do:
     5119         if connected("ub") = true
     5120         then do:
     5121           define variable v-cntxt-db-num        as integer   no-undo .
     5122           define variable v-cntxt-userid        as character no-undo .
     5123           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5124                                             , OUTPUT v-cntxt-userid
     5125                                             ) .
     5126           run gbl/wndsizew.p
     5127             (input  v-cntxt-db-num
     5128             ,input  v-cntxt-userid
     5129             ,input  v-diasize-proc-name
     5130             ,input  'height':u
     5131             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     5132             ) .
     5133         end.
     5134       end.
     5135     end.
     5136     assign
     5137       v-diasize-change-size = false
     5138     .
     5139   end procedure.
     5140   procedure diasize_set-height :
     5141     define input  parameter p-new-height  as decimal   no-undo .
     5142     define input  parameter p-move-resize as logical   no-undo .
     5143     do
     5144     on error undo, return error return-value
     5145     :
     5146       run diasize_change-height in this-procedure
     5147         (input  (p-new-height - frame Dialog-Frame :height)
     5148         ,input  p-move-resize
     5149         ) .
     5150     end.
     5151   end procedure.
     5152   procedure diasize_change-width :
     5153     define input  parameter p-change-value as decimal   no-undo .
     5154     define input  parameter p-move-resize  as logical   no-undo .
     5155     define variable v-field-group-handle   as handle    no-undo .
     5156     define variable v-object-handle        as handle    no-undo .
     5157     define variable v-frame-width          as decimal   no-undo .
     5158     define variable v-frame-virtual-width  as decimal   no-undo .
     5159     define variable v-browse-width         as decimal   no-undo .
     5160     define variable v-window-width         as decimal   no-undo .
     5161     define variable v-window-virtual-width as decimal   no-undo .
     5162     define variable v-change-sign          as integer   no-undo .
     5163     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5164     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5165     if p-change-value > 0
     5166     then do:
     5167       if frame Dialog-Frame :width + p-change-value >
     5168           session :width-chars
     5169       then do:
     5170         assign
     5171           p-change-value = session :width-chars - frame Dialog-Frame :width
     5172         .
     5173         if p-change-value <= 0
     5174         then do:
     5175           run diasize_position-resize-button in this-procedure .
     5176           return .
     5177         end.
     5178       end.
     5179     end.
     5180     if p-change-value < 0
     5181     then do:
     5182       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5183       then do:
     5184         assign
     5185           p-change-value = v-diasize-orig-frame-width
     5186                          - frame Dialog-Frame :width
     5187         .
     5188         if p-change-value >= 0
     5189         then do:
     5190           run diasize_position-resize-button in this-procedure .
     5191           return .
     5192         end.
     5193       end.
     5194     end.
     5195     if p-change-value >= 0
     5196     then do:
     5197       assign
     5198         v-change-sign = 1
     5199       .
     5200     end.
     5201     else do:
     5202       assign
     5203         v-change-sign = -1
     5204       .
     5205     end.
     5206     assign
     5207       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5208     .
     5209     if p-change-value = 0
     5210     then do:
     5211       run diasize_position-resize-button in this-procedure .
     5212       return .
     5213     end.
     5214     move_block:
     5215     do
     5216     on error undo move_block, leave move_block
     5217     :
     5218       if retry
     5219       then do:
     5220         do
     5221         on error undo move_block, leave move_block
     5222         :
     5223           if p-change-value > 0
     5224           then do:
     5225             for each buf_temp-diasize-handle
     5226             on error undo, next
     5227             :
     5228               assign
     5229                 v-object-handle = buf_temp-diasize-handle.handle-value
     5230               .
     5231               if v-object-handle <> v-diasize-resize-button
     5232               then do:
     5233                 assign
     5234                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5235                 .
     5236               end.
     5237             end.
     5238             assign
     5239               v-diasize-browse-handle :width = v-browse-width
     5240             .
     5241             for each buf_temp-browse-handle
     5242               where buf_temp-browse-handle.browse-type = 'width':u
     5243             on error undo, next
     5244             :
     5245               assign
     5246                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5247               .
     5248             end.
     5249             assign
     5250               frame Dialog-Frame :width = v-frame-width
     5251             .
     5252             if frame Dialog-Frame :scrollable = true
     5253             then do:
     5254               assign
     5255                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5256               .
     5257             end.
     5258             run diasize_position-resize-button in this-procedure .
     5259           end.
     5260           else do:
     5261             if frame Dialog-Frame :scrollable = true
     5262             then do:
     5263               assign
     5264                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5265               .
     5266             end.
     5267             assign
     5268               frame Dialog-Frame :width = v-frame-width
     5269             .
     5270             for each buf_temp-browse-handle
     5271               where buf_temp-browse-handle.browse-type = 'width':u
     5272             on error undo, next
     5273             :
     5274               assign
     5275                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5276               .
     5277             end.
     5278             assign
     5279               v-diasize-browse-handle :width = v-browse-width
     5280             .
     5281             for each buf_temp-diasize-handle
     5282             on error undo, next
     5283             :
     5284               assign
     5285                 v-object-handle = buf_temp-diasize-handle.handle-value
     5286               .
     5287               if v-object-handle <> v-diasize-resize-button
     5288               then do:
     5289                 assign
     5290                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5291                 .
     5292               end.
     5293             end.
     5294             run diasize_position-resize-button in this-procedure .
     5295           end.
     5296           assign
     5297             v-diasize-change-size = false
     5298           .
     5299           leave move_block .
     5300         end.
     5301       end.
     5302       assign
     5303         v-diasize-need-full-display = true
     5304       .
     5305       if v-diasize-change-size = false
     5306       then do:
     5307         assign
     5308           v-diasize-change-size = true
     5309         .
     5310       end.
     5311       else do:
     5312         return .
     5313       end.
     5314       assign
     5315         v-frame-width = frame Dialog-Frame :width
     5316         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5317         v-browse-width = v-diasize-browse-handle :width
     5318       .
     5319       for each buf_temp-browse-handle
     5320         where buf_temp-browse-handle.browse-type = 'width':u
     5321       :
     5322         assign
     5323           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5324         .
     5325       end.
     5326       for each buf_temp-diasize-handle
     5327       :
     5328         delete buf_temp-diasize-handle .
     5329       end.
     5330       assign
     5331         v-field-group-handle = frame Dialog-Frame :first-child
     5332       .
     5333       do while valid-handle(v-field-group-handle)
     5334       :
     5335         assign
     5336           v-object-handle = v-field-group-handle :first-child
     5337         .
     5338         do while valid-handle(v-object-handle)
     5339         :
     5340           if  v-object-handle <> v-diasize-browse-handle :handle
     5341           and v-object-handle <> v-diasize-resize-button
     5342           and can-query(v-object-handle, "row")
     5343           and can-query(v-object-handle, "height")
     5344           and ( v-object-handle :col + v-object-handle :width
     5345                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5346               )
     5347           then do:
     5348             find first buf_temp-browse-handle
     5349               where buf_temp-browse-handle.browse-type   = 'width':u
     5350                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5351               no-error .
     5352             if available buf_temp-browse-handle
     5353             then do:
     5354             end.
     5355             else do:
     5356               create buf_temp-diasize-handle .
     5357               assign
     5358                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5359                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5360               .
     5361             end.
     5362           end.
     5363           assign
     5364             v-object-handle = v-object-handle :next-sibling
     5365           .
     5366         end.
     5367         assign
     5368           v-field-group-handle = v-field-group-handle :next-sibling
     5369         .
     5370       end.
     5371       do with frame Dialog-Frame
     5372       :
     5373         hide v-diasize-resize-button .
     5374         v-diasize-resize-button :row = 1.
     5375         v-diasize-resize-button :column = 1.
     5376       end.
     5377       if p-change-value > 0
     5378       then do:
     5379         if frame Dialog-Frame :scrollable = true
     5380         then do:
     5381           assign
     5382             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5383             no-error .
     5384           if error-status :error
     5385           or error-status :get-message(1) <> ""
     5386           then do:
     5387             undo move_block, retry move_block.
     5388           end.
     5389         end.
     5390         assign
     5391           frame Dialog-Frame :width = v-frame-width + p-change-value
     5392           no-error .
     5393         if error-status :error
     5394         or error-status :get-message(1) <> ""
     5395         then do:
     5396           undo move_block, retry move_block.
     5397         end.
     5398         assign
     5399           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5400         no-error .
     5401         if error-status :error
     5402         or error-status :get-message(1) <> ""
     5403         then do:
     5404           undo move_block, retry move_block.
     5405         end.
     5406         for each buf_temp-browse-handle
     5407           where buf_temp-browse-handle.browse-type = 'width':u
     5408         on error undo move_block, retry move_block
     5409         :
     5410           assign
     5411             buf_temp-browse-handle.browse-handle :width
     5412               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5413             no-error .
     5414           if error-status :error
     5415           or error-status :get-message(1) <> ""
     5416           then do:
     5417             undo move_block, retry move_block .
     5418           end.
     5419         end.
     5420         for each buf_temp-diasize-handle
     5421         on error undo move_block, retry move_block
     5422         :
     5423           assign
     5424             v-object-handle = buf_temp-diasize-handle.handle-value
     5425           .
     5426           if v-object-handle <> v-diasize-resize-button
     5427           then do:
     5428             assign
     5429               v-object-handle :col = v-object-handle :col + p-change-value
     5430               no-error .
     5431             if error-status :error
     5432             or error-status :get-message(1) <> ""
     5433             then do:
     5434               undo move_block, retry move_block .
     5435             end.
     5436           end.
     5437         end.
     5438       end.
     5439       else do:
     5440         for each buf_temp-diasize-handle
     5441         on error undo move_block, retry move_block
     5442         :
     5443           assign
     5444             v-object-handle = buf_temp-diasize-handle.handle-value
     5445           .
     5446           if v-object-handle <> v-diasize-resize-button
     5447           then do:
     5448             assign
     5449               v-object-handle :col = v-object-handle :col + p-change-value
     5450               no-error .
     5451             if error-status :error
     5452             or error-status :get-message(1) <> ""
     5453             then do:
     5454               undo move_block, retry move_block .
     5455             end.
     5456           end.
     5457         end.
     5458         for each buf_temp-browse-handle
     5459           where buf_temp-browse-handle.browse-type = 'width':u
     5460         on error undo move_block, retry move_block
     5461         :
     5462           assign
     5463             buf_temp-browse-handle.browse-handle :width
     5464               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5465             no-error .
     5466           if error-status :error
     5467           or error-status :get-message(1) <> ""
     5468           then do:
     5469             undo move_block, retry move_block .
     5470           end.
     5471         end.
     5472         assign
     5473           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5474           no-error .
     5475         if error-status :error
     5476         or error-status :get-message(1) <> ""
     5477         then do:
     5478           undo move_block, retry move_block.
     5479         end.
     5480         assign
     5481           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5482         no-error .
     5483         if error-status :error
     5484         or error-status :get-message(1) <> ""
     5485         then do:
     5486           undo move_block, retry move_block.
     5487         end.
     5488         if frame Dialog-Frame :scrollable = true
     5489         then do:
     5490           assign
     5491             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5492           no-error .
     5493           if error-status :error
     5494           or error-status :get-message(1) <> ""
     5495           then do:
     5496             undo move_block, retry move_block.
     5497           end.
     5498         end.
     5499       end.
     5500       if p-move-resize
     5501       then do:
     5502         run diasize_position-resize-button in this-procedure .
     5503       end.
     5504       if v-diasize-wndstore = true
     5505       then do:
     5506         if connected("ub") = true
     5507         then do:
     5508           define variable v-cntxt-db-num        as integer   no-undo .
     5509           define variable v-cntxt-userid        as character no-undo .
     5510           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5511                                             , OUTPUT v-cntxt-userid
     5512                                             ) .
     5513           run gbl/wndsizew.p
     5514             (input  v-cntxt-db-num
     5515             ,input  v-cntxt-userid
     5516             ,input  v-diasize-proc-name
     5517             ,input  'width':u
     5518             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5519             ) .
     5520         end.
     5521       end.
     5522     end.
     5523     assign
     5524       v-diasize-change-size = false
     5525     .
     5526   end procedure.
     5527   procedure diasize_set-width :
     5528     define input  parameter p-new-width  as decimal   no-undo .
     5529     define input  parameter p-move-resize as logical   no-undo .
     5530     do
     5531     on error undo, return error return-value
     5532     :
     5533       run diasize_change-width in this-procedure
     5534         (input  (p-new-width - frame Dialog-Frame :width)
     5535         ,input  p-move-resize
     5536         ) .
     5537     end.
     5538   end procedure.
     5539   procedure diasize_position-resize-button :
     5540     do with frame Dialog-Frame
     5541     :
     5542       hide v-diasize-resize-button .
     5543       assign
     5544         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5545                     - 1
     5546                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5547         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5548                     - 1
     5549                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5550       .
     5551       view v-diasize-resize-button .
     5552     end.
     5553   end procedure.
     5554   on alt-right anywhere
     5555   do:
     5556     run diasize_change-width in this-procedure
     5557       (input 1
     5558       ,input true
     5559       ) .
     5560     return no-apply .
     5561   end.
     5562   on alt-left anywhere
     5563   do:
     5564     run diasize_change-width in this-procedure
     5565       (input -1
     5566       ,input true
     5567       ) .
     5568     return no-apply .
     5569   end.
     5570   on alt-down anywhere
     5571   do:
     5572     run diasize_change-height in this-procedure
     5573       (input 1
     5574       ,input true
     5575       ) .
     5576     return no-apply .
     5577   end.
     5578   on alt-up anywhere
     5579   do:
     5580     run diasize_change-height in this-procedure
     5581       (input -1
     5582       ,input true
     5583       ) .
     5584     return no-apply .
     5585   end.
     5586   on alt-enter of frame Dialog-Frame
     5587   do:
     5588     run diasize_maximize in this-procedure
     5589       (input  ?
     5590       ).
     5591     return no-apply .
     5592   end.
     5593   procedure diasize_end-move :
     5594     do
     5595     on error undo, return error return-value
     5596     :
     5597       define variable v-row-delta as decimal   no-undo .
     5598       define variable v-col-delta as decimal   no-undo .
     5599       define variable v-new-row as decimal   no-undo .
     5600       define variable v-new-col as decimal   no-undo .
     5601       assign
     5602         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5603         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5604       .
     5605       assign
     5606         v-row-delta = v-new-row - frame Dialog-Frame :height
     5607         v-col-delta = v-new-col - frame Dialog-Frame :width
     5608       .
     5609       run diasize_change-height in this-procedure
     5610         (input v-row-delta
     5611         ,input true
     5612         ) .
     5613       run diasize_change-width in this-procedure
     5614         (input v-col-delta
     5615         ,input true
     5616         ) .
     5617     end.
     5618   end procedure.
     5619   procedure diasize_maximize :
     5620     define input  parameter p-action as logical   no-undo .
     5621     do
     5622     on error undo, return error return-value
     5623     :
     5624       if p-action = ?
     5625       then do:
     5626         if v-diasize-need-maximize = true
     5627         then do:
     5628           assign
     5629             p-action = true
     5630           .
     5631         end.
     5632         else do:
     5633           assign
     5634             p-action = false
     5635           .
     5636         end.
     5637       end.
     5638       if p-action = true
     5639       then do:
     5640         run diasize_change-height in this-procedure
     5641           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5642               - frame Dialog-Frame :height-chars
     5643           ,input true
     5644           ) .
     5645         run diasize_change-width in this-procedure
     5646           (input session :width-chars
     5647               - frame Dialog-Frame :width-chars
     5648           ,input true
     5649           ) .
     5650         assign
     5651           v-diasize-need-maximize = false
     5652         .
     5653       end.
     5654       else do:
     5655         run diasize_change-width in this-procedure
     5656           (input v-diasize-orig-frame-width
     5657               - frame Dialog-Frame :width-chars
     5658           ,input true
     5659           ) .
     5660         run diasize_change-height in this-procedure
     5661           (input v-diasize-orig-frame-height
     5662               - frame Dialog-Frame :height-chars
     5663           ,input true
     5664           ) .
     5665         assign
     5666           v-diasize-need-maximize = true
     5667         .
     5668       end.
     5669     end.
     5670   end procedure.
     5671   procedure diasize_restore-orig-size :
     5672     do
     5673     on error undo, return error return-value
     5674     :
     5675       assign
     5676         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5677         v-diasize-current-frame-height = frame Dialog-Frame :height
     5678       .
     5679       run diasize_set-height in this-procedure
     5680         (input  v-diasize-orig-frame-height
     5681         ,input  true
     5682         ) .
     5683       run diasize_set-width in this-procedure
     5684         (input  v-diasize-orig-frame-width
     5685         ,input  true
     5686         ) .
     5687     end.
     5688   end procedure.
     5689   procedure diasize_restore-current-size :
     5690     do
     5691     on error undo, return error return-value
     5692     :
     5693       run diasize_set-height in this-procedure
     5694         (input  v-diasize-current-frame-height
     5695         ,input  true
     5696         ) .
     5697       run diasize_set-width in this-procedure
     5698         (input  v-diasize-current-frame-width
     5699         ,input  true
     5700         ) .
     5701     end.
     5702   end procedure.
     5703   procedure diasize_set-browse-handle :
     5704     define input  parameter p-browse-handle as handle   no-undo .
     5705     define buffer buf_temp-browse-handle for temp-browse-handle .
     5706     do
     5707     on error undo, return error return-value
     5708     :
     5709       assign
     5710         v-diasize-browse-handle = p-browse-handle
     5711       .
     5712       for each buf_temp-browse-handle
     5713       on error undo, return error return-value
     5714       :
     5715         delete buf_temp-browse-handle .
     5716       end.
     5717     end.
     5718   end procedure.
     5719   procedure diasize_add_browse :
     5720     define input  parameter p-browse-type   as character no-undo .
     5721     define input  parameter p-browse-handle as handle    no-undo .
     5722     define buffer buf_temp-browse-handle for temp-browse-handle .
     5723     do
     5724     on error undo, return error return-value
     5725     :
     5726       assign
     5727         v-diasize-browse-number = v-diasize-browse-number + 1
     5728       .
     5729       create buf_temp-browse-handle .
     5730       assign
     5731         buf_temp-browse-handle.browse-type   = p-browse-type
     5732         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5733         buf_temp-browse-handle.browse-handle = p-browse-handle
     5734       .
     5735     end.
     5736   end procedure.
     5737   procedure diasize_init :
     5738     define variable v-default-value    as logical   no-undo .
     5739     define variable v-restore-saved    as logical   no-undo .
     5740     define variable v-resize-value-str as character no-undo .
     5741     do
     5742     on error undo, return error return-value
     5743     :
     5744       do with frame Dialog-Frame
     5745       :
     5746         assign
     5747           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5748           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5749           v-diasize-browse-handle     = browse BROWSE-3 :handle
     5750         .
     5751         create button v-diasize-resize-button
     5752         assign
     5753           parent        = frame Dialog-Frame :first-child
     5754           label         = "s"
     5755           height-pixels = 16
     5756           width-pixels  = 16
     5757           visible       = true
     5758           sensitive     = true
     5759           movable       = true
     5760           triggers:
     5761             on end-move persistent run diasize_end-move in this-procedure .
     5762           end triggers.
     5763         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5764         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5765         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5766         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5767         assign
     5768           v-diasize-wndmax = false
     5769         .
     5770         if connected("ub") = true
     5771         then do:
     5772           define variable v-cntxt-db-num        as integer   no-undo .
     5773           define variable v-cntxt-userid        as character no-undo .
     5774           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5775                                             , OUTPUT v-cntxt-userid
     5776                                             ) .
     5777           run gbl/wndpar_r.p
     5778             (input  v-cntxt-db-num
     5779             ,input  v-cntxt-userid
     5780             ,input  'wndmax':U
     5781             ,output v-diasize-wndmax
     5782             ,output v-default-value
     5783             ) .
     5784         end.
     5785         assign
     5786           v-diasize-wndstore = false
     5787         .
     5788         if connected("ub") = true
     5789         then do:
     5790           run gbl/wndpar_r.p
     5791             (input  v-cntxt-db-num
     5792             ,input  v-cntxt-userid
     5793             ,input  'wndstore':U
     5794             ,output v-diasize-wndstore
     5795             ,output v-default-value
     5796             ) .
     5797         end.
     5798         assign
     5799           v-diasize-proc-name = entry(1, program-name(2), '.')
     5800         .
     5801         if v-diasize-wndstore = true
     5802         then do:
     5803           assign
     5804             v-restore-saved = false
     5805           .
     5806           if connected("ub") = true
     5807           then do:
     5808             run gbl/wndsizer.p
     5809               (input  v-cntxt-db-num
     5810               ,input  v-cntxt-userid
     5811               ,input  v-diasize-proc-name
     5812               ,input  'height':u
     5813               ,output v-resize-value-str
     5814               ) .
     5815             if v-resize-value-str <> '':U
     5816             then do:
     5817               run diasize_change-height in this-procedure
     5818                 (input  integer(v-resize-value-str)
     5819                 ,input  true
     5820                 ) .
     5821               assign
     5822                 v-restore-saved = true
     5823               .
     5824             end.
     5825           end.
     5826           if connected("ub") = true
     5827           then do:
     5828             run gbl/wndsizer.p
     5829               (input  v-cntxt-db-num
     5830               ,input  v-cntxt-userid
     5831               ,input  v-diasize-proc-name
     5832               ,input  'width':u
     5833               ,output v-resize-value-str
     5834               ) .
     5835             if v-resize-value-str <> '':U
     5836             then do:
     5837               run diasize_change-width in this-procedure
     5838                 (input  integer(v-resize-value-str)
     5839                 ,input  true
     5840                 ) .
     5841               assign
     5842                 v-restore-saved = true
     5843               .
     5844             end.
     5845           end.
     5846           if v-restore-saved <> true
     5847           then do:
     5848             if v-diasize-wndmax = true
     5849             then do:
     5850               run diasize_maximize in this-procedure
     5851                 (input  true
     5852                 ) .
     5853             end.
     5854           end.
     5855         end.
     5856         else do:
     5857           if v-diasize-wndmax = true
     5858           then do:
     5859             run diasize_maximize in this-procedure
     5860               (input  true
     5861               ) .
     5862           end.
     5863         end.
     5864       end.
     5865     end.
     5866   end procedure.
     5867   procedure diasize_need-full-display :
     5868     define output parameter p-need-full-display as logical   no-undo .
     5869     do
     5870     on error undo, return error return-value
     5871     :
     5872       assign
     5873         p-need-full-display = v-diasize-need-full-display
     5874       .
     5875       assign
     5876         v-diasize-need-full-display = false
     5877       .
     5878     end.
     5879   end procedure.
     5880   procedure get-context :
     5881      define output parameter p-db-num as integer          no-undo.
     5882      define output parameter p-user-id as character        no-undo.
     5883      define variable v-login               as character    no-undo.
     5884      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5885      define buffer buf_user-login  for ub.user-login .
     5886      do
     5887      on error undo, return error
     5888      :
     5889            FIND FIRST buf_sys-ctrl no-lock.
     5890            ASSIGN
     5891               v-login = USERID("ub")
     5892               p-db-num = buf_sys-ctrl.db-num
     5893            .
     5894            FIND FIRST buf_user-login
     5895                 WHERE buf_user-login.db-num = p-db-num
     5896                   AND buf_user-login.user-login = v-login
     5897                 no-lock
     5898                 no-error
     5899                 .
     5900            IF AVAILABLE buf_user-login
     5901            THEN DO:
     5902               assign
     5903                  p-user-id = buf_user-login.user-id
     5904               .
     5905            END.
     5906      end.
     5907   end procedure.
     5908       run diasize_init in this-procedure .
     5909   MAIN-BLOCK:
     5910   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5911      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5912        run prdoclib-calc-prc-loc in this-procedure
     5913       (recid(p-doc)
     5914       ,output v-ov-qnty
     5915       ,output v-ov-base
     5916       ,output v-ov-VAT-base
     5917       ,output v-ov-SLT-base
     5918       ) no-error.
     5919     if error-status :error then do:
     5920       if error-status :get-message(1) <> "" then do:
     5921         message
     5922           vss-workfile vss-revision vss-description skip
     5923           "Ошибка при вызове программы prdoclib-calc-prc" skip
     5924           error-status :get-message(1) skip
     5925           return-value skip
     5926           view-as alert-box error .
     5927       end.
     5928       undo, return error .
     5929     end.
     5930     assign
     5931     ov = v-ov-base
     5932     SLT = v-ov-SLT-base
     5933     VAT = v-ov-VAT-base
     5934     ov-no-SLT-VAT = ov - slt - vat
     5935     .
     5936       frame Dialog-Frame:title = p-doc.doc-num  + "  : ПЕРЕОЦЕНКА".
     5937     RUN enable_UI.
     5938     WAIT-FOR GO OF FRAME Dialog-Frame.
     5939   END.
     5940   RUN disable_UI.
     5941   PROCEDURE disable_UI :
     5942     HIDE FRAME Dialog-Frame.
     5943   END PROCEDURE.
     5944   PROCEDURE enable_UI :
     5945     DISPLAY ov ov-no-SLT-VAT SLT VAT
     5946         WITH FRAME Dialog-Frame.
     5947     ENABLE b_exit B-Help BROWSE-3 ov ov-no-SLT-VAT SLT VAT
     5948         WITH FRAME Dialog-Frame.
     5949     VIEW FRAME Dialog-Frame.
     5950     OPEN QUERY BROWSE-3 FOR EACH tt-title.
     5951   END PROCEDURE.
     5952   PROCEDURE prdoclib-calc-prc-loc :
     5953   define input  parameter p-price-doc-recid as   recid                  no-undo.
     5954     define output parameter  tv-ov-qnty     as decimal   no-undo .
     5955     define output parameter  tv-ov-base     as decimal   no-undo .
     5956     define output parameter  tv-ov-VAT-base as decimal   no-undo .
     5957     define output parameter  tv-ov-SLT-base as decimal   no-undo .
     5958    define variable  v-ov-qnty     as decimal   no-undo .
     5959    define variable  v-ov-base     as decimal   no-undo .
     5960    define variable  v-ov-VAT-base as decimal   no-undo .
     5961    define variable  v-ov-SLT-base as decimal   no-undo .
     5962     do
     5963     on error undo, return error
     5964     :
     5965       define buffer buf_price-doc       for ub.price-doc .
     5966       define buffer buf_price-list      for ub.price-list .
     5967       define buffer buf_parts           for ub.parts .
     5968       for each tt-title:
     5969         delete tt-title.
     5970       end.
     5971       assign
     5972           tv-ov-qnty       = 0
     5973           tv-ov-base       = 0
     5974           tv-ov-VAT-base   = 0
     5975           tv-ov-SLT-base   = 0
     5976       .
     5977       find first buf_price-doc no-lock
     5978         where recid(buf_price-doc) = p-price-doc-recid
     5979         no-error .
     5980       if not available buf_price-doc then do:
     5981         message
     5982           vss-workfile vss-revision vss-description skip
     5983           skip
     5984           "Ошибка задания входных параметров" skip
     5985           "Не найден документ переоценки" skip
     5986           "Код записи (recid)" p-price-doc-recid skip
     5987           view-as alert-box error .
     5988         undo, return error .
     5989       end.
     5990       for each buf_price-list no-lock
     5991         where buf_price-list.doc-num    = buf_price-doc.doc-num
     5992           and buf_price-list.main-price = true
     5993       on error undo, return error
     5994       :
     5995         run prdoclib-calc-ov
     5996           (input recid(buf_price-list)
     5997           ,output v-ov-qnty
     5998           ,output v-ov-base
     5999           ,output v-ov-VAT-base
     6000           ,output v-ov-SLT-base
     6001           ) no-error .
     6002         if error-status :error then do:
     6003           if error-status :get-message(1) <> "" then do:
     6004             message
     6005               vss-workfile vss-revision vss-description skip
     6006              skip
     6007               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     6008               error-status :get-message(1) skip
     6009               return-value skip
     6010               view-as alert-box error .
     6011           end.
     6012           undo, return error .
     6013         end.
     6014         assign
     6015             tv-ov-qnty       = tv-ov-qnty     +   v-ov-qnty
     6016             tv-ov-base       = tv-ov-base     +   v-ov-base
     6017             tv-ov-VAT-base   = tv-ov-VAT-base +   v-ov-VAT-base
     6018             tv-ov-SLT-base   = tv-ov-SLT-base +   v-ov-SLT-base
     6019         .
     6020         end.
     6021       for each buf_price-list no-lock
     6022         where buf_price-list.doc-num    = buf_price-doc.doc-num
     6023           and buf_price-list.main-price = true
     6024       on error undo, return error
     6025       :
     6026         for each buf_parts no-lock
     6027           where buf_parts.out-code  = buf_price-list.doc-num
     6028             and buf_parts.obj-type  = buf_price-list.obj-type
     6029             and buf_parts.obj-code  = buf_price-list.obj-code
     6030             and buf_parts.artic     = buf_price-list.artic
     6031             and buf_parts.prod-type = buf_price-list.prod-type
     6032             and buf_parts.prod-code = buf_price-list.prod-code
     6033         on error undo, return error
     6034         :
     6035         find first tt-title where tt-title.purch-code = buf_parts.purch-code no-error .
     6036         if not available tt-title  then do:
     6037                   create tt-title.
     6038                   assign
     6039                   tt-title.fact-qnty  = buf_parts.fact-qnty
     6040                   tt-title.purch-code = buf_parts.purch-code .
     6041            end.
     6042            else do:
     6043                   assign
     6044                   tt-title.fact-qnty  = tt-title.fact-qnty + buf_parts.fact-qnty
     6045                   tt-title.purch-code = buf_parts.purch-code .
     6046            end.
     6047                       assign
     6048                   tt-title.purch-name = entry (lookup (string(tt-title.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
     6049                   .
     6050               end.
     6051     end.
     6052     for each tt-title :
     6053         assign
     6054           tt-title.VAT-base    = tv-ov-VAT-base * (tt-title.fact-qnty / tv-ov-qnty )
     6055           tt-title.SLT-base    = tv-ov-SLT-base * (tt-title.fact-qnty / tv-ov-qnty )
     6056           tt-title.ov-base     = tv-ov-base     * (tt-title.fact-qnty / tv-ov-qnty )
     6057           tt-title.no-VAT-base = tt-title.ov-base - tt-title.VAT-base - tt-title.SLT-base
     6058         .
     6059     end.
     6060     end.
     6061   end procedure.
