     9513     assign
     9514       bf-expp_trn-doc-sum.fact-qnty           = bf-expp_trn-doc-sum.fact-qnty           +  (if parmode <> "delete" then bf-expp_doc-line-sum.fact-qnty           else 0) - varoldfact-qnty-exp
     9515       bf-expp_trn-doc-sum.cost-sum-base       = bf-expp_trn-doc-sum.cost-sum-base       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-sum-base       else 0) - varoldcost-sum-base-exp
     9516       bf-expp_trn-doc-sum.cost-sum-rubl       = bf-expp_trn-doc-sum.cost-sum-rubl       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-sum-rubl       else 0) - varoldcost-sum-rubl-exp
     9517       bf-expp_trn-doc-sum.cost-vat-base       = bf-expp_trn-doc-sum.cost-vat-base       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-vat-base       else 0) - varoldcost-vat-base-exp
     9518       bf-expp_trn-doc-sum.cost-vat-rubl       = bf-expp_trn-doc-sum.cost-vat-rubl       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-vat-rubl       else 0) - varoldcost-vat-rubl-exp
     9519       bf-expp_trn-doc-sum.cost-slt-base       = bf-expp_trn-doc-sum.cost-slt-base       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-slt-base       else 0) - varoldcost-slt-base-exp
     9520       bf-expp_trn-doc-sum.cost-slt-rubl       = bf-expp_trn-doc-sum.cost-slt-rubl       +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-slt-rubl       else 0) - varoldcost-slt-rubl-exp
     9521       bf-expp_trn-doc-sum.cost-road-tax-base  = bf-expp_trn-doc-sum.cost-road-tax-base  +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-road-tax-base  else 0) - varoldcost-road-tax-base-exp
     9522       bf-expp_trn-doc-sum.cost-road-tax-rubl  = bf-expp_trn-doc-sum.cost-road-tax-rubl  +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-road-tax-rubl  else 0) - varoldcost-road-tax-rubl-exp
     9523       bf-expp_trn-doc-sum.cost-excise-base    = bf-expp_trn-doc-sum.cost-excise-base    +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-excise-base    else 0) - varoldcost-excise-base-exp
     9524       bf-expp_trn-doc-sum.cost-excise-rubl    = bf-expp_trn-doc-sum.cost-excise-rubl    +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-excise-rubl    else 0) - varoldcost-excise-rubl-exp
     9525       bf-expp_trn-doc-sum.cost-transport-base = bf-expp_trn-doc-sum.cost-transport-base +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-transport-base else 0) - varoldcost-transport-base-exp
     9526       bf-expp_trn-doc-sum.cost-transport-rubl = bf-expp_trn-doc-sum.cost-transport-rubl +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-transport-rubl else 0) - varoldcost-transport-rubl-exp
     9527       bf-expp_trn-doc-sum.cost-other-base     = bf-expp_trn-doc-sum.cost-other-base     +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-other-base     else 0) - varoldcost-other-base-exp
     9528       bf-expp_trn-doc-sum.cost-other-rubl     = bf-expp_trn-doc-sum.cost-other-rubl     +  (if parmode <> "delete" then bf-expp_doc-line-sum.cost-other-rubl     else 0) - varoldcost-other-rubl-exp
     9529       bf-incp_trn-doc-sum.fact-qnty           = bf-incp_trn-doc-sum.fact-qnty           +  (if parmode <> "delete" then bf-incp_doc-line-sum.fact-qnty           else 0) - varoldfact-qnty-inp
     9530       bf-incp_trn-doc-sum.cost-sum-base       = bf-incp_trn-doc-sum.cost-sum-base       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-sum-base       else 0) - varoldcost-sum-base-inp
     9531       bf-incp_trn-doc-sum.cost-sum-rubl       = bf-incp_trn-doc-sum.cost-sum-rubl       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-sum-rubl       else 0) - varoldcost-sum-rubl-inp
     9532       bf-incp_trn-doc-sum.cost-vat-base       = bf-incp_trn-doc-sum.cost-vat-base       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-vat-base       else 0) - varoldcost-vat-base-inp
     9533       bf-incp_trn-doc-sum.cost-vat-rubl       = bf-incp_trn-doc-sum.cost-vat-rubl       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-vat-rubl       else 0) - varoldcost-vat-rubl-inp
     9534       bf-incp_trn-doc-sum.cost-slt-base       = bf-incp_trn-doc-sum.cost-slt-base       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-slt-base       else 0) - varoldcost-slt-base-inp
     9535       bf-incp_trn-doc-sum.cost-slt-rubl       = bf-incp_trn-doc-sum.cost-slt-rubl       +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-slt-rubl       else 0) - varoldcost-slt-rubl-inp
     9536       bf-incp_trn-doc-sum.cost-road-tax-base  = bf-incp_trn-doc-sum.cost-road-tax-base  +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-road-tax-base  else 0) - varoldcost-road-tax-base-inp
     9537       bf-incp_trn-doc-sum.cost-road-tax-rubl  = bf-incp_trn-doc-sum.cost-road-tax-rubl  +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-road-tax-rubl  else 0) - varoldcost-road-tax-rubl-inp
     9538       bf-incp_trn-doc-sum.cost-excise-base    = bf-incp_trn-doc-sum.cost-excise-base    +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-excise-base    else 0) - varoldcost-excise-base-inp
     9539       bf-incp_trn-doc-sum.cost-excise-rubl    = bf-incp_trn-doc-sum.cost-excise-rubl    +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-excise-rubl    else 0) - varoldcost-excise-rubl-inp
     9540       bf-incp_trn-doc-sum.cost-transport-base = bf-incp_trn-doc-sum.cost-transport-base +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-transport-base else 0) - varoldcost-transport-base-inp
     9541       bf-incp_trn-doc-sum.cost-transport-rubl = bf-incp_trn-doc-sum.cost-transport-rubl +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-transport-rubl else 0) - varoldcost-transport-rubl-inp
     9542       bf-incp_trn-doc-sum.cost-other-base     = bf-incp_trn-doc-sum.cost-other-base     +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-other-base     else 0) - varoldcost-other-base-inp
     9543       bf-incp_trn-doc-sum.cost-other-rubl     = bf-incp_trn-doc-sum.cost-other-rubl     +  (if parmode <> "delete" then bf-incp_doc-line-sum.cost-other-rubl     else 0) - varoldcost-other-rubl-inp
     9544     .
     9545   end.
     9546   else do:
     9547     assign
     9548       varoldfact-qnty-exp            =   bf-expp_doc-line-sum.fact-qnty
     9549       varoldcost-sum-base-exp        =   bf-expp_doc-line-sum.cost-sum-base
     9550       varoldcost-sum-rubl-exp        =   bf-expp_doc-line-sum.cost-sum-rubl
     9551       varoldcost-vat-base-exp        =   bf-expp_doc-line-sum.cost-vat-base
     9552       varoldcost-vat-rubl-exp        =   bf-expp_doc-line-sum.cost-vat-rubl
     9553       varoldcost-slt-base-exp        =   bf-expp_doc-line-sum.cost-slt-base
     9554       varoldcost-slt-rubl-exp        =   bf-expp_doc-line-sum.cost-slt-rubl
     9555       varoldcost-road-tax-base-exp   =   bf-expp_doc-line-sum.cost-road-tax-base
     9556       varoldcost-road-tax-rubl-exp   =   bf-expp_doc-line-sum.cost-road-tax-rubl
     9557       varoldcost-excise-base-exp     =   bf-expp_doc-line-sum.cost-excise-base
     9558       varoldcost-excise-rubl-exp     =   bf-expp_doc-line-sum.cost-excise-rubl
     9559       varoldcost-transport-base-exp  =   bf-expp_doc-line-sum.cost-transport-base
     9560       varoldcost-transport-rubl-exp  =   bf-expp_doc-line-sum.cost-transport-rubl
     9561       varoldcost-other-base-exp      =   bf-expp_doc-line-sum.cost-other-base
     9562       varoldcost-other-rubl-exp      =   bf-expp_doc-line-sum.cost-other-rubl
     9563       varoldfact-qnty-inp            =   bf-incp_doc-line-sum.fact-qnty
     9564       varoldcost-sum-base-inp        =   bf-incp_doc-line-sum.cost-sum-base
     9565       varoldcost-sum-rubl-inp        =   bf-incp_doc-line-sum.cost-sum-rubl
     9566       varoldcost-vat-base-inp        =   bf-incp_doc-line-sum.cost-vat-base
     9567       varoldcost-vat-rubl-inp        =   bf-incp_doc-line-sum.cost-vat-rubl
     9568       varoldcost-slt-base-inp        =   bf-incp_doc-line-sum.cost-slt-base
     9569       varoldcost-slt-rubl-inp        =   bf-incp_doc-line-sum.cost-slt-rubl
     9570       varoldcost-road-tax-base-inp   =   bf-incp_doc-line-sum.cost-road-tax-base
     9571       varoldcost-road-tax-rubl-inp   =   bf-incp_doc-line-sum.cost-road-tax-rubl
     9572       varoldcost-excise-base-inp     =   bf-incp_doc-line-sum.cost-excise-base
     9573       varoldcost-excise-rubl-inp     =   bf-incp_doc-line-sum.cost-excise-rubl
     9574       varoldcost-transport-base-inp  =   bf-incp_doc-line-sum.cost-transport-base
     9575       varoldcost-transport-rubl-inp  =   bf-incp_doc-line-sum.cost-transport-rubl
     9576       varoldcost-other-base-inp      =   bf-incp_doc-line-sum.cost-other-base
     9577       varoldcost-other-rubl-inp      =   bf-incp_doc-line-sum.cost-other-rubl
     9578     .
     9579   end.
     9580   end.
     9581   end procedure.
     9582   procedure local-delete :
     9583   define input parameter parrec-line as recid no-undo.
     9584   define buffer bf_doc-line for ub.doc-line.
     9585   define variable l-inv-on as logical no-undo.
     9586   do on error undo, return error return-value :
     9587   find first bf_doc-line where recid( bf_doc-line ) = parrec-line.
     9588   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9590     (input  bf_doc-line.obj-type
     9591     ,input  bf_doc-line.obj-code
     9592     ,input  bf_doc-line.artic
     9593     ,input  bf_doc-line.prod-type
     9594     ,input  bf_doc-line.prod-code
     9595     ,input  'inv-on=false'
     9596     ,output l-inv-on
     9597     ) no-error .
     9598   if error-status :error then do:
     9599     message
     9600       vss-workfile vss-revision vss-description skip
     9601       "Ошибка установки атрибута товара на объекте" skip
     9602       "Документ" bf_doc-line.doc-code skip
     9603       "Объект" bf_doc-line.obj-type bf_doc-line.obj-code skip
     9604       "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     9605       "l-inv-on" l-inv-on skip
     9606       view-as alert-box error .
     9607     undo, return error .
     9608   end.
     9609   delete bf_doc-line.
     9610   end.
     9611   end procedure.
     9612   procedure local-chg:
     9613   define buffer bf_goods for ub.goods.
     9614   define variable varhvrdtax        as   logical                  no-undo.
     9615   define variable varis-ok as logical no-undo.
     9616   define variable varlog as logical no-undo.
     9617   define variable varmode as character no-undo.
     9618   if not available bf_doc-line then do:
     9619     message "Неправильный выбор строки.".
     9620     return no-apply.
     9621   end.
     9622   do transaction on error undo, return no-apply :
     9623   run local-recalc in this-procedure ( input "old":U,
     9624                                        input recid( bf_doc-line ) ) no-error.
     9625   if error-status :error then do:
     9626     undo, return error "Ошибка при пересчете строки документа".
     9627   end.
     9628   find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     9629                             bf_goods.prod-type = bf_doc-line.prod-type and
     9630                             bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     9631   assign
     9632     varhvrdtax = hvrdtax ( recid( bf_goods ) ).
     9633   assign
     9634     varlog = ?.
     9635   message
     9636   "Товар " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name
     9637   "Вы можете поменять цены по: " skip
     9638   " - всем выбранным партиям из свободной зоны (YES) " skip
     9639   " - новым выбранным партиям из свободной зоны (NO) "
     9640   view-as alert-box question buttons yes-no update varlog.
     9641   if varlog = yes then do:
     9642     assign
     9643       varmode = "chg_parts":u.
     9644   end.
     9645   else do:
     9646     varmode = "chg_new_parts":u.
     9647   end.
     9648   find first bf_sysconf where bf_sysconf.host-code = t-doc.host-code no-lock.
     9649   run update-line in this-procedure
     9650   (  input varmode
     9651    , input recid( bf_doc-line )
     9652    , input bf_sysconf.cash-pay
     9653    , input ?
     9654    , input ?
     9655    , input ?
     9656    , input ?
     9657   ) no-error.
     9658   if error-status :error then do:
     9659     undo, return error "Ошибка при редактировании линии документа по товару " + bf_doc-line.artic + " " + bf_doc-line.prod-type + " " + string(bf_doc-line.prod-code).
     9660   end.
     9661   if available bf_doc-line then do:
     9662     run local-recalc in this-procedure ( input "update":U,
     9663                                          input recid( bf_doc-line ) ) no-error.
     9664     if error-status :error then do:
     9665       undo, return error "Ошибка при пересчете строки документа".
     9666     end.
     9667   end.
     9668   end.
     9669   end procedure.
     9670   procedure local-lockup:
     9671   define buffer bf_goods for ub.goods.
     9672   define variable prt-rec as recid no-undo.
     9673   if available bf_doc-line then do:
     9674     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     9675                               bf_goods.prod-type = bf_doc-line.prod-type and
     9676                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     9677      run str/parts-l.w
     9678        (input parparentproc
     9679        ,input t-doc.obj-type
     9680        ,input t-doc.obj-code
     9681        ,input bf_goods.gds-code
     9682        ,input bf_doc-line.doc-code
     9683        ,input 'ПРОСМОТР':U
     9684        ,input 'документ':U
     9685        ,input 'текущий':U
     9686        ,input 'документ':U
     9687        ,output prt-rec
     9688        ) .
     9689   end.
     9690   end procedure.
     9691   procedure change-price :
     9692     define parameter buffer buf-orig_parts for  ub.parts .
     9693     define input  parameter  parqnty             like ub.parts.fact-qnty      no-undo.
     9694     define input  parameter  parexch-code        like ub.parts.exch-code      no-undo.
     9695     define input  parameter  parcli-base-rate    like ub.parts.cli-base-rate  no-undo.
     9696     define input  parameter  parvat-type         like ub.parts.vat-type       no-undo.
     9697     define input  parameter  parslt-type         like ub.parts.slt-type       no-undo.
     9698     define input  parameter  parprice-cli        like ub.parts.price-cli      no-undo.
     9699     define input  parameter  parprice-base       like ub.parts.price-base     no-undo.
     9700     define input  parameter  parprice-rubl       like ub.parts.price-rubl     no-undo.
     9701     define input  parameter  parvat-pc           like ub.parts.vat-pc         no-undo.
     9702     define input  parameter  parslt-pc           like ub.parts.slt-pc         no-undo.
     9703     define input  parameter  parroad-tax-base    like ub.parts.road-tax-base  no-undo.
     9704     define input  parameter  parroad-tax-rubl    like ub.parts.road-tax-rubl  no-undo.
     9705     define input  parameter  partransport-base   like ub.parts.transport-base no-undo.
     9706     define input  parameter  partransport-rubl   like ub.parts.transport-rubl no-undo.
     9707     define input  parameter  parother-base       like ub.parts.other-base     no-undo.
     9708     define input  parameter  parother-rubl       like ub.parts.other-rubl     no-undo.
     9709     define input  parameter  parcash-pay         like ub.parts.pay-code       no-undo.
     9710     define input  parameter  parinternal         like ub.trn-doc.internal     no-undo.
     9711     define input  parameter  pardoc-type         like ub.trn-doc.doc-type     no-undo.
     9712     define input  parameter  parext-doc-type     like ub.trn-doc.ext-doc-type no-undo.
     9713     define input  parameter  parcreate-new-parts as   logical                 no-undo.
     9714     define input  parameter  parrecid-caus-parts as   recid                   no-undo.
     9715     define input  parameter  parpurch-code       like ub.parts.purch-code     no-undo.
     9716     define output parameter  parrec-parts        as   recid                   no-undo.
     9717     define buffer buf-caus_parts for ub.parts.
     9718     define buffer buf_units      for ub.units.
     9719     define buffer buf-have_parts for ub.parts.
     9720     define variable varnew-slt-type as character no-undo.
     9721     define variable varpart-code like ub.parts.part-code no-undo.
     9722     define variable varslt-yes as logical no-undo.
     9723     define buffer buf_goods      for ub.goods.
     9724     define buffer buf_parts-root for ub.parts-root.
     9725     do on error undo, return error return-value :
     9726       find first buf_goods           no-lock where
     9727                  buf_goods.artic     = buf-orig_parts.artic
     9728              and buf_goods.prod-type = buf-orig_parts.prod-type
     9729              and buf_goods.prod-code = buf-orig_parts.prod-code .
     9730       find buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     9731       if (parroad-tax-base <> 0 and
     9732           parroad-tax-base <> ?     ) or
     9733          (parroad-tax-rubl <> 0 and
     9734           parroad-tax-rubl <> ?     )
     9735          then do:
     9736          if hvrdtax ( recid( buf_goods ) ) = no then do:
     9737            message
     9738              vss-workfile vss-revision vss-description skip
     9739              "Для товара " buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     9740              " недопустима установка дополнительной компоненты отличной от 0." skip
     9741            view-as alert-box error.
     9742            undo, return error .
     9743          end.
     9744       end.
     9745       if parcreate-new-parts then do:
     9746         if lookup('сер':U, buf_units.type) > 0 then do:
     9747           find first buf-have_parts where buf-have_parts.obj-type  = buf-orig_parts.obj-type  and
     9748                                           buf-have_parts.obj-code  = buf-orig_parts.obj-code  and
     9749                                           buf-have_parts.artic     = buf-orig_parts.artic     and
     9750                                           buf-have_parts.prod-type = buf-orig_parts.prod-type and
     9751                                           buf-have_parts.prod-code = buf-orig_parts.prod-code and
     9752                                           buf-have_parts.in-code   = buf-orig_parts.out-code  and
     9753                                           buf-have_parts.out-code  = buf-orig_parts.out-code  and
     9754                                           buf-have_parts.part-code = buf-orig_parts.part-code no-lock no-error.
     9755           if available buf-have_parts then do:
     9756             message "Товар " buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code " " buf_goods.gds-name " - серийный." skip
     9757                     "Делаем коррекцию учетной цены по партии с кодом " buf-orig_parts.part-code "." skip
     9758                     "Но в документе уже есть порожденная партия этого товара с таким кодом либо в данном процессе должны породиться две партии с таким кодом."
     9759             view-as alert-box error.
     9760             undo, return error return-value.
     9761           end.
     9762           else do:
     9763             assign
     9764               varpart-code = buf-orig_parts.part-code.
     9765           end.
     9766         end.
     9767         else do:
     9768           run holdprts-get-part-code in this-procedure (  input buf-orig_parts.out-code
     9769                                                        , output varpart-code
     9770                                                         ) no-error .
     9771           if error-status :error then dO:
     9772             message
     9773               vss-workfile vss-revision vss-description skip
     9774               "Ошибка при получении кода партии." skip
     9775               return-value skip
     9776               trim(error-status :get-message(1)) skip
     9777               view-as alert-box error.
     9778             undo, return error return-value.
     9779           end.
     9780         end.
     9781         create buf-caus_parts .
     9782         buffer-copy buf-orig_parts
     9783         except in-code rsrv-free status_ qnty fact-qnty real-qnty cli-qnty price-rubl price-base
     9784                vat-pc slt-pc road-tax-rubl road-tax-base transport-rubl transport-base other-rubl
     9785                other-base part-code exch-code cli-base-rate price-cli vat-type slt-type to buf-caus_parts.
     9786         assign
     9787           buf-caus_parts.in-code        = buf-caus_parts.out-code
     9788           buf-caus_parts.part-code      = varpart-code
     9789           buf-caus_parts.rsrv-free      = ?
     9790           buf-caus_parts.status_        = no
     9791           buf-caus_parts.qnty           = parqnty
     9792           buf-caus_parts.fact-qnty      = parqnty
     9793           buf-caus_parts.real-qnty      = 0
     9794           buf-caus_parts.cli-base-rate  = parcli-base-rate
     9795           buf-caus_parts.vat-type       = parvat-type
     9796           buf-caus_parts.slt-type       = parslt-type
     9797           buf-caus_parts.cli-qnty       = parqnty / parcli-base-rate
     9798           buf-caus_parts.exch-code      = parexch-code
     9799         .
     9800         find first buf_parts-root where
     9801                    buf_parts-root.doc-code       = buf-caus_parts.out-code
     9802              and   buf_parts-root.in-code        = buf-caus_parts.in-code
     9803              and   buf_parts-root.gds-code       = buf_goods.gds-code
     9804              and   buf_parts-root.part-code      = buf-caus_parts.part-code
     9805              and   buf_parts-root.orig-in-code   = buf-orig_parts.in-code
     9806              and   buf_parts-root.orig-gds-code  = buf_goods.gds-code
     9807              and   buf_parts-root.orig-part-code = buf-orig_parts.part-code no-error .
     9808         if not available buf_parts-root then do:
     9809           create buf_parts-root.
     9810           assign
     9811             buf_parts-root.doc-code       = buf-caus_parts.out-code
     9812             buf_parts-root.in-code        = buf-caus_parts.in-code
     9813             buf_parts-root.gds-code       = buf_goods.gds-code
     9814             buf_parts-root.part-code      = buf-caus_parts.part-code
     9815             buf_parts-root.orig-in-code   = buf-orig_parts.in-code
     9816             buf_parts-root.orig-gds-code  = buf_goods.gds-code
     9817             buf_parts-root.orig-part-code = buf-orig_parts.part-code
     9818           .
     9819         end.
     9820       end.
     9821       else do:
     9822         find first buf-caus_parts where recid( buf-caus_parts ) = parrecid-caus-parts.
     9823       end.
     9824       assign
     9825         buf-caus_parts.price-rubl     = parprice-rubl
     9826         buf-caus_parts.price-base     = parprice-base
     9827         buf-caus_parts.price-cli      = parprice-cli
     9828         buf-caus_parts.vat-pc         = parvat-pc
     9829         buf-caus_parts.slt-pc         = parslt-pc
     9830         buf-caus_parts.road-tax-rubl  = parroad-tax-rubl
     9831         buf-caus_parts.road-tax-base  = parroad-tax-base
     9832         buf-caus_parts.transport-rubl = partransport-rubl
     9833         buf-caus_parts.transport-base = partransport-base
     9834         buf-caus_parts.other-rubl     = parother-rubl
     9835         buf-caus_parts.other-base     = parother-base
     9836       .
     9837       if parslt-pc <> 0 then do:
     9838         if buf-caus_parts.slt-type <> 'в т. ч.':U and
     9839            buf-caus_parts.slt-type <> 'нет':U  then do:
     9840           assign
     9841             buf-caus_parts.slt-type = 'в т. ч.':U .
     9842         end.
     9843       end.
     9844       if parpurch-code <> ? then do:
     9845         assign
     9846           buf-caus_parts.purch-code = parpurch-code.
     9847       end.
     9848     end.
     9849   end procedure.
     9850   procedure check-cli :
     9851   define variable v-today as date      no-undo.
     9852   define variable v-time  as integer   no-undo.
     9853   define buffer bf_contract for ub.contract.
     9854   define buffer bf_currency for ub.currency.
     9855   define variable varexch-rate  like ub.trn-doc.exch-rate  no-undo.
     9856   define variable varexch-scale like ub.trn-doc.exch-scale no-undo.
     9857   define variable varcurr-abbr  as   character             no-undo.
     9858   define variable varcontract-code like ub.contract.contract-code no-undo.
     9859   define variable varbase-code like ub.sysconf.base-code no-undo.
     9860   do on error undo, return error return-value :
     9861   if input frame d-doc t-doc.cli-type = ? or input frame d-doc t-doc.cli-type = "" then do:
     9862     if can-find (clients where clients.obj-code = input frame d-doc t-doc.cli-code
     9863                            and clients.obj-type = 'орг':U no-lock) then do:
     9864       display 'орг':U @ t-doc.cli-type with frame d-doc.
     9865     end.
     9866     else do:
     9867       display 'чел':U @ t-doc.cli-type with frame d-doc.
     9868     end.
     9869   end.
     9870   find clients where clients.obj-code = input frame d-doc t-doc.cli-code
     9871                  and clients.obj-type = input frame d-doc t-doc.cli-type no-error.
     9872   if not available clients then do:
     9873     if input frame d-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
     9874     message "Неправильный код или тип контрагента.".
     9875     apply "entry" to t-doc.cli-code in frame d-doc.
     9876     return error.
     9877   end.
     9878   display clients.obj-type @ t-doc.cli-type with frame d-doc.
     9879   if clients.obj-type = 'скл':U or
     9880      clients.obj-type = 'маг':U  then do:
     9881     release clients no-error.
     9882     message "Выберите организацию или человека.".
     9883     apply "entry" to t-doc.cli-code in frame d-doc.
     9884     return error.
     9885   end.
     9886   define variable v-err as logical   no-undo .
     9887     run ver-clients  ( clients.obj-type , clients.obj-code , output v-err ) .
     9888     if  v-err then do:
     9889       apply "entry" to t-doc.cli-code in frame d-doc.
     9890       return error.
     9891     end.
     9892   assign
     9893     t-doc.cli-code = input frame d-doc t-doc.cli-code
     9894     t-doc.cli-type = input frame d-doc t-doc.cli-type.
     9895   display clients.obj-name with frame d-doc.
     9896   assign
     9897     pardoc-mode = 'ИЗМЕНЕНИЕ':U.
     9898   find first bf_contract where bf_contract.host-code = t-doc.host-code                          and
     9899                                bf_contract.cli-type  = input frame d-doc t-doc.cli-type and
     9900                                bf_contract.cli-code  = input frame d-doc t-doc.cli-code and
     9901                                bf_contract.status_   = 'тек':U                         no-lock no-error.
     9902   if not available bf_contract then do:
     9903     assign
     9904       t-doc.contract-code  = 0
     9905       varcntr-prn-code     = ""
     9906       varcntr-name         = "БЕЗ ДОГОВОРА"
     9907       .
     9908   end.
     9909   else do:
     9910     run check-contract-code in this-procedure (input  "choose":u,
     9911                                                input  t-doc.host-code,
     9912                                                input  input frame d-doc t-doc.cli-type,
     9913                                                input  input frame d-doc t-doc.cli-code,
     9914                                                input  ?,
     9915                                                input  parparentproc,
     9916                                                input  t-doc.doc-date,
     9917                                                input  "" ,
     9918                                                output varcontract-code) no-error.
     9919     if error-status :error    or
     9920        varcontract-code = ?  or
     9921        varcontract-code = 0  then do:
     9922       message "Вы не выбрали договор. Вы хотите редактировать партии свободной зоны по приходам без договора?"
     9923       view-as alert-box question buttons yes-no update varlog.
     9924       if varlog = no then do:
     9925         apply "entry" to t-doc.cli-code in frame d-doc.
     9926         return error.
     9927       end.
     9928       else do:
     9929         assign
     9930           t-doc.contract-code = 0
     9931           varcntr-prn-code    = ""
     9932           varcntr-name        = "БЕЗ ДОГОВОРА"
     9933         .
     9934       end.
     9935     end.
     9936     else do:
     9937       find first bf_contract where bf_contract.host-code     = t-doc.host-code  and
     9938                                    bf_contract.contract-code = varcontract-code no-lock.
     9939       find first bf_currency where bf_currency.curr-code = bf_contract.curr-code no-lock no-error.
     9940       if not available bf_currency then do:
     9941         message "В договоре указана валюта " bf_contract.curr-code "." skip
     9942                 "Но этой валюты нет в справочнике валют."
     9943         view-as alert-box error.
     9944         apply "entry" to t-doc.cli-code in frame d-doc.
     9945         return error.
     9946       end.
     9947   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     9949     (input  bf_currency.curr-code
     9950     ,input  t-doc.exch-date
     9951     ,output varexch-rate
     9952     ,output varexch-scale
     9953     ,output varcurr-abbr
     9954     ) no-error .
     9955       if error-status :error then do:
     9956         message "Ошибка при поиске курса валюты поставки по договору." skip
     9957                 return-value skip
     9958                 error-status :get-message( 1 ) skip
     9959                 error-status :get-message( 2 )
     9960         view-as alert-box error.
     9961         return error.
     9962       end.
     9963       assign
     9964         t-doc.contract-code = varcontract-code
     9965         t-doc.exch-code     = bf_contract.curr-code
     9966         t-doc.exch-rate     = varexch-rate
     9967         t-doc.exch-scale    = varexch-scale
     9968         varcntr-prn-code    = bf_contract.contract-prn-code
     9969         varcntr-name        = bf_contract.contract-name
     9970       .
     9971     end.
     9972   end.
     9973   if clients.obj-type = 'орг':U then do:
     9974     find firm where firm.firm-code = clients.obj-code no-lock.
     9975     find clients where clients.obj-type = 'чел':U
     9976                           and clients.obj-code = firm.tobj-code no-lock no-error.
     9977     if available clients then
     9978       display clients.obj-code @ t-doc.boss
     9979               clients.obj-name @ boss-name with frame d-doc.
     9980   end.
     9981   release clients.
     9982   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9983   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     9984     (input  t-doc.obj-type
     9985     ,input  t-doc.obj-code
     9986     ,output v-today
     9987     )  .
     9988   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     9990     (input  t-doc.host-code
     9991     ,output varbase-code
     9992     )  .
     9993   find last curr-accnt where curr-accnt.curr-code  = varbase-code
     9994                          and curr-accnt.exch-date <= v-today use-index pi no-lock no-error.
     9995   if not available curr-accnt then do:
     9996      message "На дату" v-today "неизвестен курс базовой валюты." SKIP
     9997      view-as alert-box error.
     9998      return error.
     9999   end.
    10000   else do:
    10001     assign
    10002       t-doc.base-rate  = curr-accnt.exch-rate
    10003       t-doc.base-scale = curr-accnt.exch-scale.
    10004   end.
    10005   assign
    10006     t-doc.exch-date     = v-today
    10007     t-doc.print-rubl    = yes.
    10008   run UI-on in this-procedure ( input "enable" ).
    10009   if b-add :sensitive = yes then apply "entry" to b-add in frame d-doc.
    10010   end.
    10011   end procedure.
    10012   procedure choose-cli:
    10013   define variable varfirm-code like firm.firm-code no-undo.
    10014   define buffer bf_clients for ub.clients.
    10015   do on error undo, return error return-value :
    10016   run check-cli in this-procedure no-error.
    10017   if error-status :error then do:
    10018     run ref/cli-all.w (parparentproc
    10019                   , "b-sel"
    10020                   , 'орг':U
    10021                   , ?
    10022                   , ?
    10023                   , ?
    10024                   , ?
    10025                   , ?
    10026                   , output ref-list) .
    10027     if ref-list <> "" then do:
    10028       ref-rec = integer (ref-list).
    10029       find first bf_clients where recid( bf_clients ) = ref-rec no-lock.
    10030       display bf_clients.obj-code @ t-doc.cli-code
    10031               bf_clients.obj-name @ clients.obj-name with frame d-doc.
    10032       display bf_clients.obj-type @ t-doc.cli-type   with frame d-doc.
    10033     end.
    10034     run check-cli in this-procedure no-error.
    10035     if error-status :error then do:
    10036       return error return-value.
    10037     end.
    10038   end.
    10039   end.
    10040   end procedure.
    10041   procedure check-line :
    10042   define input parameter parrec-line as recid no-undo.
    10043   define buffer bf_doc-line   for ub.doc-line.
    10044   define buffer bf_goods      for ub.goods.
    10045   define buffer bf_parts-root for ub.parts-root.
    10046   define buffer bf_parts      for ub.parts.
    10047   define buffer bf-cr_parts   for ub.parts.
    10048   define variable varqnty    as decimal no-undo.
    10049   define variable varcr-qnty as decimal no-undo.
    10050   do on error undo, return error return-value :
    10051   find first bf_doc-line where recid( bf_doc-line ) = parrec-line no-error.
    10052   if not available bf_doc-line then do:
    10053     return error substitute ("Не найдена строка документа в процедуре check-line.").
    10054   end.
    10055   find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    10056                             bf_goods.prod-type = bf_doc-line.prod-type and
    10057                             bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    10058   for each bf_parts where bf_parts.out-code      = t-doc.doc-code
    10059                       and bf_parts.obj-type      = t-doc.obj-type
    10060                       and bf_parts.obj-code      = t-doc.obj-code
    10061                       and bf_parts.artic         = bf_doc-line.artic
    10062                       and bf_parts.prod-type     = bf_doc-line.prod-type
    10063                       and bf_parts.prod-code     = bf_doc-line.prod-code
    10064                       and bf_parts.in-code      <> t-doc.doc-code         on error undo, return error return-value :
    10065     assign
    10066       varqnty = varqnty + bf_parts.fact-qnty.
    10067     for each bf_parts-root where bf_parts-root.doc-code       = bf_parts.out-code
    10068                              and bf_parts-root.orig-in-code   = bf_parts.in-code
    10069                              and bf_parts-root.orig-gds-code  = bf_goods.gds-code
    10070                              and bf_parts-root.orig-part-code = bf_parts.part-code on error undo, return error return-value :
    10071       find first bf-cr_parts where bf-cr_parts.obj-type  = t-doc.obj-type
    10072                                and bf-cr_parts.obj-code  = t-doc.obj-code
    10073                                and bf-cr_parts.artic     = bf_doc-line.artic
    10074                                and bf-cr_parts.prod-type = bf_doc-line.prod-type
    10075                                and bf-cr_parts.prod-code = bf_doc-line.prod-code
    10076                                and bf-cr_parts.in-code   = bf_parts-root.in-code
    10077                                and bf-cr_parts.out-code  = bf_parts-root.doc-code
    10078                                and bf-cr_parts.part-code = bf_parts-root.part-code .
    10079       assign
    10080         varcr-qnty = varcr-qnty + bf-cr_parts.fact-qnty.
    10081     end.
    10082   end.
    10083   if varqnty <> - varcr-qnty then do:
    10084     return error substitute ("Критическая ошибка. Кол-во по взятым партиям из свободной зоны &1. Количество по созданым партиям &2.", varqnty, varcr-qnty).
    10085   end.
    10086   for each bf_parts-root where bf_parts-root.doc-code = t-doc.doc-code on error undo, return error return-value :
    10087     find first bf_goods where bf_goods.gds-code = bf_parts-root.gds-code.
    10088     find first bf_parts where bf_parts.obj-type  = t-doc.obj-type
    10089                           and bf_parts.obj-code  = t-doc.obj-code
    10090                           and bf_parts.artic     = bf_goods.artic
    10091                           and bf_parts.prod-type = bf_goods.prod-type
    10092                           and bf_parts.prod-code = bf_goods.prod-code
    10093                           and bf_parts.in-code   = bf_parts-root.orig-in-code
    10094                           and bf_parts.part-code = bf_parts-root.orig-part-code no-error.
    10095     if not available bf_parts then do:
    10096       return error substitute ("Критическая ошибка. Есть запись parts-root c ссылкой на родительскую партию. Партия: Объект &1 &2. Товар &3 &4 &5. Порожд. док-т. &6. Код партии &7.",
    10097                               t-doc.obj-type,
    10098                               t-doc.obj-code,
    10099                               bf_goods.artic,
    10100                               bf_goods.prod-type,
    10101                               bf_goods.prod-code,
    10102                               bf_parts-root.orig-in-code,
    10103                               bf_parts-root.orig-part-code
    10104                              ).
    10105     end.
    10106     find first bf-cr_parts where bf-cr_parts.obj-type  = t-doc.obj-type
    10107                              and bf-cr_parts.obj-code  = t-doc.obj-code
    10108                              and bf-cr_parts.artic     = bf_goods.artic
    10109                              and bf-cr_parts.prod-type = bf_goods.prod-type
    10110                              and bf-cr_parts.prod-code = bf_goods.prod-code
    10111                              and bf-cr_parts.in-code   = bf_parts-root.in-code
    10112                              and bf-cr_parts.out-code  = bf_parts-root.doc-code
    10113                              and bf-cr_parts.part-code = bf_parts-root.part-code no-error.
    10114     if not available bf-cr_parts then do:
    10115       return error substitute ("Критическая ошибка. Есть запись parts-root c ссылкой на дочернюю партию. Партия: Объект &1 &2. Товар &3 &4 &5. Порожд. док-т. &6. Док-т &7. Код партии &8.",
    10116                               t-doc.obj-type,
    10117                               t-doc.obj-code,
    10118                               bf_goods.artic,
    10119                               bf_goods.prod-type,
    10120                               bf_goods.prod-code,
    10121                               bf_parts-root.in-code,
    10122                               bf_parts-root.doc-code,
    10123                               bf_parts-root.part-code
    10124                              ).
    10125     end.
    10126   end.
    10127   for each bf-cr_parts where bf-cr_parts.out-code  = t-doc.out-code
    10128                          and bf-cr_parts.obj-type  = t-doc.obj-type
    10129                          and bf-cr_parts.obj-code  = t-doc.obj-code
    10130                          and bf-cr_parts.artic     = bf_doc-line.artic
    10131                          and bf-cr_parts.prod-type = bf_doc-line.prod-type
    10132                          and bf-cr_parts.prod-code = bf_doc-line.prod-code on error undo, return error return-value :
    10133     find first bf_parts-root where bf_parts-root.doc-code  = bf-cr_parts.out-code
    10134                                and bf_parts-root.in-code   = bf-cr_parts.out-code
    10135                                and bf_parts-root.gds-code  = bf_goods.gds-code
    10136                                and bf_parts-root.part-code = bf-cr_parts.part-code no-error.
    10137     if not available bf_parts-root then do:
    10138       return error substitute ("Критическая ошибка. Не найден parts-root для партии. Объект &1 &2. Товар &3 &4 &5. Код партии &6.",
    10139                                bf-cr_parts.obj-type,
    10140                                bf-cr_parts.obj-code,
    10141                                bf-cr_parts.artic,
    10142                                bf-cr_parts.prod-type,
    10143                                bf-cr_parts.prod-code,
    10144                                bf-cr_parts.part-code).
    10145     end.
    10146   end.
    10147   end.
    10148   end procedure.
    10149   procedure local-chg-vat :
    10150   define variable varlog           as   logical            no-undo.
    10151   define variable varvat-pc        like ub.doc-line.vat-pc no-undo.
    10152   define variable varpurch-list    as   character          no-undo.
    10153   define variable varoldvat-pc     like ub.doc-line.vat-pc no-undo.
    10154   define variable varchange-price  as   logical            no-undo.
    10155   define variable varis-ok         as   logical            no-undo.
    10156   define variable varartic         like ub.goods.artic     no-undo.
    10157   define variable recid-line       as   recid              no-undo.
    10158   define variable varcount         as   integer            no-undo.
    10159   define variable vartime          as   integer            no-undo.
    10160   define variable varoutput-string as   character          no-undo.
    10161   define variable varnotes as character no-undo.
    10162   define variable varlns-cnt as integer no-undo.
    10163   define buffer bf_goods      for ub.goods.
    10164   define buffer bf-free_parts for ub.parts.
    10165   assign
    10166     vartime = time.
    10167   do on error undo, return error return-value :
    10168   message "Вы хотите поменять НДС по всем партиям свободной зоны для списка товаров?" skip
    10169           view-as alert-box question button yes-no update varlog.
    10170   if varlog <> yes then do:
    10171     return.
    10172   end.
    10173   run str/chg-vat.w (output varoldvat-pc,
    10174                  output varvat-pc,
    10175                  output varpurch-list,
    10176                  output varchange-price,
    10177                  output varis-ok)     no-error.
    10178   if error-status :error then do:
    10179     if return-value <> "" then do:
    10180       message "Ошибка при установке процента НДС." skip
    10181               return-value skip
    10182       view-as alert-box error.
    10183       return error.
    10184     end.
    10185   end.
    10186   if varis-ok <> yes then do:
    10187     return error.
    10188   end.
    10189   run str/chs-gds.w
    10190     ( input parparentproc,
    10191       input v-cntxt-obj-type,
    10192       input v-cntxt-obj-code,
    10193       input "":u,
    10194       input t-doc.status_,
    10195       input "Строка накладной № " + t-doc.doc-code,
    10196       input ?,
    10197       input ?,
    10198       input ?,
    10199       input v-cntxt-host-code-obj,
    10200       input parext-doc-type,
    10201       input-output varartic,
    10202       output varnotes).
    10203   if varnotes = '' then return.
    10204   varlns-cnt = 1.
    10205   do while varlns-cnt <= num-entries (varnotes) on error undo, return error return-value :
    10206   gds:
    10207   do transaction on error undo, leave :
    10208     find first bf_goods where recid( bf_goods ) = integer( entry( varlns-cnt, varnotes ) ) no-lock.
    10209     varlns-cnt = varlns-cnt + 1.
    10210     find first bf_doc-line where bf_doc-line.doc-code  = t-doc.doc-code     and
    10211                                  bf_doc-line.artic     = bf_goods.artic     and
    10212                                  bf_doc-line.prod-type = bf_goods.prod-type and
    10213                                  bf_doc-line.prod-code = bf_goods.prod-code no-error.
    10214     if available bf_doc-line then do:
    10215       message "Товар " bf_doc-line.artic " " bf_doc-line.prod-type " " bf_doc-line.prod-code " " bf_goods.gds-name " уже есть в данной накладной." skip
    10216               "Хотите отредактировать его?" view-as alert-box question buttons yes-no update varlog.
    10217       if not varlog then do:
    10218         undo, leave gds.
    10219       end.
    10220     end.
    10221     else do:
    10222   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_chkgdsd in g#lib-trn3
    10223   ( input recid(t-doc)
    10224    ,input recid(bf_goods)
    10225   ) no-error.
    10226       if error-status :error then do:
    10227         put stream str-err unformatted return-value.
    10228         undo, leave gds.
    10229       end.
    10230       find first bf-free_parts where bf-free_parts.host-code     = t-doc.host-code       and
    10231                                      bf-free_parts.supp-type     = t-doc.cli-type        and
    10232                                      bf-free_parts.supp-code     = t-doc.cli-code        and
    10233                                      bf-free_parts.status_       = no                    and
    10234                                      bf-free_parts.obj-type      = t-doc.obj-type        and
    10235                                      bf-free_parts.obj-code      = t-doc.obj-code        and
    10236                                      bf-free_parts.rsrv-free     = yes                   and
    10237                                      bf-free_parts.out-code      = 'free-zone':U          and
    10238                                      bf-free_parts.prod-type     = bf_goods.prod-type    and
    10239                                      bf-free_parts.prod-code     = bf_goods.prod-code    and
    10240                                      bf-free_parts.artic         = bf_goods.artic        and
    10241                                      bf-free_parts.contract-code = t-doc.contract-code   and
    10242                                      lookup(string(bf-free_parts.purch-code), varpurch-list) > 0 no-lock no-error.
    10243       if not available bf-free_parts then do:
    10244         assign
    10245           varlog-err = yes.
    10246         put stream str-err unformatted
    10247                 "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name "."
    10248                 "Объект: " t-doc.obj-type " " t-doc.obj-code skip
    10249                 "Поставщик " t-doc.cli-type " " t-doc.cli-code " " t-doc.cli-name skip
    10250                 "Нет товара от поставщика по заданым типам приобретения в свободной зоне на объекте." skip
    10251                 "Пропускаем." skip.
    10252         undo, leave gds.
    10253       end.
    10254       run add-doc-inv-line in this-procedure ( input recid( bf_goods ), output recid-line ) no-error.
    10255       if error-status :error then do:
    10256         message
    10257           vss-workfile vss-revision vss-description skip
    10258           "Ошибка при добавлении товара " skip
    10259           bf_goods.artic skip
    10260           bf_goods.prod-type skip
    10261           bf_goods.prod-code skip
    10262           " в документ."
    10263           return-value skip
    10264           trim(error-status :get-message(1))
    10265           view-as alert-box error.
    10266         undo, leave gds.
    10267       end.
    10268       find first bf_doc-line where recid( bf_doc-line ) = recid-line.
    10269     end.
    10270     assign
    10271       bf_doc-line.prt-OK = ?.
    10272     run local-recalc in this-procedure ( input "old":U,
    10273                                          input recid( bf_doc-line ) ) no-error.
    10274     if error-status :error then do:
    10275       message
    10276       vss-workfile vss-revision vss-description skip
    10277       "Ошибка при пересчете строки документа" skip
    10278       return-value skip
    10279       trim( error-status :get-message( 1 ) )
    10280       view-as alert-box error.
    10281       undo, leave gds.
    10282     end.
    10283     assign
    10284       varcount = varcount + 1.
    10285     run waitfram-join in this-procedure (substitute("Коррекция НДС в партиях свободной зоны. Обрабатываем товар: &1 &2 &3 &4.", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_goods.gds-name),
    10286                                          substitute("Всего обработано товаров: &1.", varcount),
    10287                                          substitute("Время: &1.", string(TIME - vartime, "hh:mm:ss")),
    10288                                          output varoutput-string).
    10289     run waitfram-show in this-procedure (varoutput-string).
    10290     find first bf_sysconf where bf_sysconf.host-code = t-doc.host-code no-lock.
    10291     run update-line in this-procedure (   input "chg_vat":u
    10292                                         , input recid( bf_doc-line )
    10293                                         , input bf_sysconf.cash-pay
    10294                                         , input varoldvat-pc
    10295                                         , input varvat-pc
    10296                                         , input varpurch-list
    10297                                         , input varchange-price
    10298                                         )  no-error.
    10299     if error-status :error then do:
    10300       if return-value <> "" then do:
    10301         message
    10302           vss-workfile vss-revision vss-description skip
    10303           "Ошибка при обработке товара " skip
    10304           bf_doc-line.artic skip
    10305           bf_doc-line.prod-type skip
    10306           bf_doc-line.prod-code skip
    10307           return-value skip
    10308           trim(error-status :get-message(1))
    10309           view-as alert-box error.
    10310       end.
    10311       undo, leave gds.
    10312     end.
    10313     if available bf_doc-line then do:
    10314       run local-recalc in this-procedure ( input "update":U,
    10315                                            input recid( bf_doc-line ) ) no-error.
    10316       if error-status :error then do:
    10317         message
    10318         vss-workfile vss-revision vss-description skip
    10319         "Ошибка при пересчете строки документа" skip
    10320         return-value skip
    10321         trim( error-status :get-message( 1 ) )
    10322         view-as alert-box error.
    10323         undo, leave gds.
    10324       end.
    10325     end.
    10326   end.
    10327   end.
    10328   run waitfram-hide in this-procedure.
    10329   end.
    10330   end procedure.
    10331   procedure notes-tr:
    10332   define variable notes as character no-undo.
    10333   assign
    10334     notes = t-doc.PS.
    10335   run gbl/d-prompt.w (
    10336       'title=Примечание\'
    10337     + 'type=editor\'
    10338     + 'fillin_width=96\'
    10339     + 'fillin_height=15\'
    10340     + (if pardoc-mode = 'ПРОСМОТР':U then 'readonly=yes\' else '':U)
    10341     , input-output notes).
    10342   if pardoc-mode <> 'ПРОСМОТР':U then do:
    10343     if return-value = 'false':u
    10344     then do:
    10345       return .
    10346     end.
    10347     if t-doc.PS <> notes then do:
    10348       do transaction on error undo, return error return-value :
    10349         find t-doc where recid( t-doc ) = pardoc-rec exclusive-lock.
    10350         assign
    10351           t-doc.PS = notes.
    10352       end.
    10353     end.
    10354   end.
    10355   end procedure.
    10356   procedure proc-exit:
    10357   parnext-prev = ?.
    10358   if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
    10359     if not can-find (first doc-line where doc-line.doc-code = t-doc.doc-code no-lock) then do:
    10360       varlog = yes.
    10361       message "В документе нет строк, поэтому он удаляется." view-as alert-box
    10362         question buttons OK-Cancel update varlog.
    10363       if varlog then do:
    10364         delete t-doc.
    10365         assign pardoc-rec = ?.
    10366         return.
    10367       end.
    10368       else return error.
    10369     end.
    10370     assign frame d-doc t-doc.wrkr t-doc.agnt t-doc.boss .
    10371   end.
    10372   end procedure.
    10373   procedure st-exch-rate:
    10374     define output parameter parexch-code     like ub.trn-doc.exch-code   no-undo.
    10375     define output parameter parexch-rate     like ub.trn-doc.exch-rate   no-undo.
    10376     define output parameter parexch-scale    like ub.trn-doc.exch-scale  no-undo.
    10377     define output parameter parcli-base-rate like ub.parts.cli-base-rate no-undo.
    10378     define output parameter parvat-type      like ub.parts.vat-type      no-undo.
    10379     define output parameter parslt-type      like ub.parts.slt-type      no-undo.
    10380     define variable varcurr-abbr as character no-undo.
    10381     define buffer bf_contract for ub.contract.
    10382     do
    10383     on error undo, return error return-value
    10384     :
    10385       find first tt-chs-parts.
    10386       assign
    10387         parcli-base-rate = tt-chs-parts.cli-base-rate
    10388         parexch-code     = tt-chs-parts.exch-code
    10389         parvat-type      = tt-chs-parts.vat-type
    10390         parslt-type      = tt-chs-parts.slt-type .
    10391       for each tt-chs-parts on error undo, return error return-value :
    10392         if t-doc.contract-code <> 0 then do:
    10393           find first bf_contract where bf_contract.host-code     = t-doc.host-code     and
    10394                                       bf_contract.contract-code = t-doc.contract-code no-lock.
    10395           if tt-chs-parts.exch-code <> bf_contract.curr-code then do:
    10396             message "Критическая ошибка." skip
    10397                     "Договору " bf_contract.contract-prn-code " задан в валюте с кодом " bf_contract.curr-code " ." skip
    10398                     "Выбрана партия из свободной зоны: ПН " tt-chs-parts.in-code " Код партии " tt-chs-parts.part-code " Товар " tt-chs-parts.artic tt-chs-parts.prod-type tt-chs-parts.prod-code " в валюте с кодом " tt-chs-parts.exch-code " ."
    10399             view-as alert-box error.
    10400             return error.
    10401           end.
    10402         end.
    10403         else do:
    10404           if tt-chs-parts.exch-code <> parexch-code then do:
    10405             assign
    10406               parexch-code = ?.
    10407           end.
    10408         end.
    10409         if tt-chs-parts.vat-type =  'без':U and
    10410           tt-chs-parts.vat-pc   <> 0              then do:
    10411           message "Критическая ошибка в партии: " skip
    10412                   "Объект: " tt-chs-parts.obj-type " " tt-chs-parts.obj-code " " skip
    10413                   "Товар: " tt-chs-parts.artic " " tt-chs-parts.prod-type " " tt-chs-parts.prod-code skip
    10414                   "ПН: " tt-chs-parts.in-code skip
    10415                   "Код партии: " tt-chs-parts.part-code skip
    10416                   "Тип НДС в партии имеет тип " tt-chs-parts.vat-type " , а процент НДС в партии установлен " tt-chs-parts.vat-pc " ." skip
    10417           view-as alert-box error.
    10418           return error.
    10419         end.
    10420         if tt-chs-parts.slt-type =  'без':U and
    10421           tt-chs-parts.slt-pc   <> 0              then do:
    10422           message "Критическая ошибка в партии: " skip
    10423                   "Объект: " tt-chs-parts.obj-type " " tt-chs-parts.obj-code " " skip
    10424                   "Товар: " tt-chs-parts.artic " " tt-chs-parts.prod-type " " tt-chs-parts.prod-code skip
    10425                   "ПН: " tt-chs-parts.in-code skip
    10426                   "Код партии: " tt-chs-parts.part-code skip
    10427                   "Тип НП в партии имеет тип " tt-chs-parts.slt-type " , а процент НП в партии установлен " tt-chs-parts.slt-pc " ." skip
    10428           view-as alert-box error.
    10429           return error.
    10430         end.
    10431         if tt-chs-parts.cli-base-rate <> parcli-base-rate then do:
    10432           assign
    10433             parcli-base-rate = 1.
    10434         end.
    10435       end.
    10436       assign
    10437         parvat-type = ?
    10438         parslt-type = ?.
    10439       if parcli-base-rate = 1 then do:
    10440         for each tt-chs-parts on error undo, return error return-value :
    10441           assign
    10442             tt-chs-parts.price-cli     = tt-chs-parts.price-cli / tt-chs-parts.cli-base-rate
    10443             tt-chs-parts.cli-base-rate = 1
    10444           .
    10445         end.
    10446       end.
    10447       if parexch-code = ? then do:
    10448         for each tt-chs-parts on error undo, return error return-value :
    10449           assign
    10450             tt-chs-parts.exch-code = 1
    10451             tt-chs-parts.price-cli = tt-chs-parts.price-rubl * tt-chs-parts.cli-base-rate
    10452           .
    10453         end.
    10454         assign
    10455           parexch-code = 1.
    10456       end.
    10457       if parvat-type = ? then do:
    10458         for each tt-chs-parts where tt-chs-parts.vat-type <> 'в т. ч.':U on error undo, return error return-value :
    10459           for each tt-clcparts on error undo, return error return-value :
    10460             delete tt-clcparts.
    10461           end.
    10462           for each tt-allsum on error undo, return error return-value :
    10463             delete tt-allsum.
    10464           end.
    10465           create tt-clcparts.
    10466           buffer-copy tt-chs-parts to tt-clcparts.
    10467           run clcprtsl_calc-parts in this-procedure
    10468               (input recid( tt-clcparts ),
    10469               input no,
    10470               input no,
    10471               input 0,
    10472               input 0,
    10473               input 0,
    10474               input 0,
    10475               input 0,
    10476               input 0,
    10477               input 0,
    10478               input "":u,
    10479               input 0,
    10480               input 0,
    10481               input 0,
    10482               input 0,
    10483               input 0,
    10484               input 0).
    10485           find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
    10486           assign
    10487             tt-chs-parts.vat-type  = 'в т. ч.':U
    10488             tt-chs-parts.price-cli = tt-chs-parts.price-cli + tt-allsum.vat-cli-acc
    10489           .
    10490         end.
    10491         assign
    10492           parvat-type = 'в т. ч.':U.
    10493       end.
    10494       if parslt-type = ? then do:
    10495         for each tt-chs-parts where tt-chs-parts.slt-type <> 'в т. ч.':U on error undo, return error return-value :
    10496           for each tt-clcparts on error undo, return error return-value :
    10497             delete tt-clcparts.
    10498           end.
    10499           for each tt-allsum on error undo, return error return-value :
    10500             delete tt-allsum.
    10501           end.
    10502           create tt-clcparts.
    10503           buffer-copy tt-chs-parts to tt-clcparts.
    10504           run clcprtsl_calc-parts in this-procedure
    10505               (input recid( tt-clcparts ),
    10506               input no,
    10507               input no,
    10508               input 0,
    10509               input 0,
    10510               input 0,
    10511               input 0,
    10512               input 0,
    10513               input 0,
    10514               input 0,
    10515               input "":u,
    10516               input 0,
    10517               input 0,
    10518               input 0,
    10519               input 0,
    10520               input 0,
    10521               input 0).
    10522           find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
    10523           assign
    10524             tt-chs-parts.slt-type  = 'в т. ч.':U
    10525             tt-chs-parts.price-cli = tt-chs-parts.price-cli + tt-allsum.slt-cli-acc
    10526           .
    10527         end.
    10528         assign
    10529           parslt-type = 'в т. ч.':U.
    10530       end.
    10531       if t-doc.contract-code = 0 then do:
    10532         if parexch-code <> 0 then do:
    10533   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
    10535     (input  parexch-code
    10536     ,input  t-doc.exch-date
    10537     ,output parexch-rate
    10538     ,output parexch-scale
    10539     ,output varcurr-abbr
    10540     )  .
    10541         end.
    10542         else do:
    10543           assign
    10544             parexch-rate  = 1
    10545             parexch-scale = 1
    10546           .
    10547         end.
    10548       end.
    10549       else do:
    10550         assign
    10551           parexch-rate  = t-doc.exch-rate
    10552           parexch-scale = t-doc.exch-scale
    10553         .
    10554       end.
    10555     end.
    10556   end procedure.
    10557   procedure proc-history :
    10558     define variable loc-ref-list as character no-undo.
    10559     define variable loc-doc-save as recid     no-undo.
    10560     define variable loc-mode     as character no-undo.
    10561     define variable loc#stat     as character no-undo.
    10562     define variable loc#type     as character no-undo.
    10563     define variable loc#internal as logical   no-undo.
    10564     do
    10565     on error undo, return error return-value
    10566     :
    10567       if not available t-doc then do:
    10568         message "Неправильный выбор документа." view-as alert-box.
    10569         return error.
    10570       end.
    10571       assign
    10572         pardoc-rec = recid( t-doc )
    10573       .
    10574   define variable vss-include-info79 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10575   do:
    10576     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10577       (input  v-cntxt-db-num
    10578       ,input  v-cntxt-userid
    10579       ,input  0
    10580       ,input  'actn_c-documents_all':U
    10581       ,input  'object':U
    10582       ,input  t-doc.host-code
    10583       ,input  t-doc.obj-type
    10584       ,input  t-doc.obj-code
    10585       ,input  0
    10586       ,input  0
    10587       ,input  0
    10588       ,input  true
    10589       ,output varlog
    10590       )  .
    10591   end.
    10592       if varlog <> yes then do: return no-apply. end.
    10593       run str/calldocs.w ( input  parparentproc,
    10594                        input  loc-mode,
    10595                        input  loc#stat,
    10596                        input  loc#type,
    10597                        input  ?,
    10598                        input  loc#internal,
    10599                        input  "":U,
    10600                        input  t-doc.ext-doc-type,
    10601                        input  ?,
    10602                        input  recid(t-doc),
    10603                        input t-doc.obj-type,
    10604                        input t-doc.obj-code,
    10605                        output loc-ref-list ).
    10606       apply "ENTRY":U to br in frame d-doc.
    10607     end.
    10608   end procedure.
    10609   procedure check-reason :
    10610     define variable j_rsn-code like ub.trn-reason.reason-code no-undo.
    10611     assign j_rsn-code = ( input frame d-doc t-doc.reason-code ).
    10612     find first ub.trn-reason no-lock where
    10613                ub.trn-reason.reason-code = j_rsn-code no-error.
    10614     if not available ub.trn-reason then do:
    10615       if j_rsn-code <> ? and j_rsn-code <> 0 then do:
    10616         message "Неверно указано основание (причина) создания документа." view-as alert-box error.
    10617       end.
    10618       assign  rsn-name = "".
    10619       display rsn-name with frame d-doc.
    10620       if j_rsn-code = ? or j_rsn-code = 0 then do:
    10621         assign t-doc.reason-code = 0.
    10622         return.
    10623       end.
    10624       else do:
    10625         return error.
    10626       end.
    10627     end.
    10628     assign  rsn-name = ub.trn-reason.reason-name.
    10629     display rsn-name with frame d-doc.
    10630     assign  frame d-doc t-doc.reason-code.
    10631   end procedure.
    10632   procedure select-reason :
    10633     define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
    10634     assign j-rsn-code = ( input frame d-doc t-doc.reason-code ).
    10635     run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
    10636     find first ub.trn-reason no-lock where ub.trn-reason.reason-code = j-rsn-code no-error.
    10637     if available ub.trn-reason then do:
    10638       assign  rsn-name          = ub.trn-reason.reason-name
    10639               t-doc.reason-code = ub.trn-reason.reason-code.
    10640       display t-doc.reason-code rsn-name with frame d-doc.
    10641     end.
    10642   end procedure.
