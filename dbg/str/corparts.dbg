     3670       define variable varempty-scale           as   logical                             no-undo.
     3671       define variable varis-cons-parts-have    as   logical                             no-undo.
     3672       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3673       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3674       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3675       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     3676       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3677       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3678       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3679       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3680       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     3681       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3682       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3683       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3684       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3685       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     3686       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3687       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3688       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3689       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3690       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     3691       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3692       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     3693       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     3694       define variable varis-one-gds-dtl        as   logical                             no-undo.
     3695       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     3696       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     3697       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     3698       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     3699       define variable varoutvprb               as   character                           no-undo.
     3700       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     3701       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     3702       define buffer   in-vatp-partso    for ub.parts   .
     3703       define buffer   in-vatp-doco      for ub.trn-doc .
     3704       define buffer   in-vatp-goodso    for ub.goods   .
     3705       define buffer   in-vatp-sysconfo  for ub.sysconf .
     3706       define buffer   in-vatp_doc-attro for ub.doc-attr.
     3707       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     3708       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     3709       define variable varinvprbo                  as   character              no-undo.
     3710       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     3711       define variable cli-base-rateo              as   decimal                no-undo.
     3712       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     3713       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     3714       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     3715       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     3716       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     3717       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     3718       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     3719       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3720       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     3721       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     3722       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3723       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     3724       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     3725       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     3726       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     3727       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     3728       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     3729       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     3730       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     3731       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     3732       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     3733       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     3734       define variable varinvatp-envdo             as   character              no-undo.
     3735       define variable varinvatp-typeo             as   character              no-undo.
     3736     do
     3737     on error undo, return error return-value
     3738     :
     3739       find first buf_trn-doc no-lock
     3740         where buf_trn-doc.doc-code = p-doc-code
     3741       no-error .
     3742       if not available buf_trn-doc
     3743       then do:
     3744         message
     3745           vss-workfile vss-revision vss-description skip
     3746           vss-include-info19 skip
     3747           "Ошибка задания входных параметров" skip
     3748           "Не найден документ" skip
     3749           "Документ" p-doc-code skip
     3750           "Артикул" p-artic p-prod-type p-prod-code skip
     3751           view-as alert-box error .
     3752         undo, return error .
     3753       end.
     3754       find first buf_doc-line no-lock
     3755         where buf_doc-line.doc-code  = p-doc-code
     3756           and buf_doc-line.artic     = p-artic
     3757           and buf_doc-line.prod-type = p-prod-type
     3758           and buf_doc-line.prod-code = p-prod-code
     3759         no-error .
     3760       if not available buf_doc-line
     3761       then do:
     3762         message
     3763           vss-workfile vss-revision vss-description skip
     3764           vss-include-info19 skip
     3765           "Ошибка задания входных параметров" skip
     3766           "Не найдена строка документа" skip
     3767           "Документ" p-doc-code skip
     3768           "Артикул" p-artic p-prod-type p-prod-code skip
     3769           view-as alert-box error .
     3770         undo, return error .
     3771       end.
     3772       for each buf_gds-dtl no-lock
     3773         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     3774           and buf_gds-dtl.artic     = buf_doc-line.artic
     3775           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     3776           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     3777       on error undo, return error
     3778       :
     3779         if buf_trn-doc.doc-type <> 'инв':U
     3780         then do:
     3781           if buf_trn-doc.doc-type = 'при':U
     3782           or buf_trn-doc.doc-type = 'возврат':U
     3783           then do:
     3784             assign
     3785               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     3786             .
     3787           end.
     3788           else do:
     3789             assign
     3790               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     3791             .
     3792           end.
     3793         end.
     3794         else do:
     3795           assign
     3796             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     3797           .
     3798         end.
     3799         if v-gds-dtl-fact-qnty <> 0
     3800         then do:
     3801   if buf_trn-doc.ext-doc-type = 'ot':U or
     3802      buf_trn-doc.ext-doc-type = ?                 then do:
     3803     assign
     3804      out-vatp-have-vat-slt = yes.
     3805   end.
     3806   else do:
     3807     find first out-vatp_doc-attr no-lock
     3808       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     3809         and out-vatp_doc-attr.attr-code = 'envd':U
     3810         no-error .
     3811     if not available out-vatp_doc-attr then do:
     3812       assign
     3813         out-vatp-have-vat-slt = yes.
     3814     end.
     3815     else do:
     3816        out-vatp-have-vat-slt = no.
     3817     end.
     3818   end.
     3819   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     3820                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     3821                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     3822   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3824     (input  buf_doc-line.artic
     3825     ,input  buf_doc-line.prod-type
     3826     ,input  buf_doc-line.prod-code
     3827     ,output varroot-node
     3828     ) no-error .
     3829   if error-status :error then do:
     3830     message
     3831       vss-workfile vss-revision vss-description skip
     3832       "Ошибка при определении корневого признака товара" skip
     3833       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3834       error-status :get-message(1) skip
     3835       return-value skip
     3836       view-as alert-box error .
     3837     undo, return error .
     3838   end.
     3839   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3840     (input  varroot-node
     3841     ,input  'empty-scale=request'
     3842     ,output varempty-scale
     3843     ) no-error .
     3844   if error-status :error then do:
     3845     message
     3846       vss-workfile vss-revision vss-description skip
     3847       "Ошибка при определении атрибута признака" skip
     3848       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3849       "Признак" varroot-node skip
     3850       "Запрашивался атрибут" "empty-scale=request" skip
     3851       error-status :get-message(1) skip
     3852       return-value skip
     3853       view-as alert-box error .
     3854     undo, return error .
     3855   end.
     3856   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3858     (output varoutvprb
     3859     )  .
     3860   if varoutvprb = "base":u then do:
     3861     assign
     3862           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3863       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     3864     .
     3865   end.
     3866   else do:
     3867     assign
     3868           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3869       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3870     .
     3871   end.
     3872   if varoutvprb = "rubl":u then do:
     3873     assign
     3874           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3875       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     3876   end.
     3877   else do:
     3878     assign
     3879           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     3880       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     3881   end.
     3882   assign
     3883     varis-cons-parts-have =  no.
     3884   assign
     3885     varfact-qnty       = 0
     3886     varcons-qnty       = 0
     3887     varprice-base-cons = 0
     3888     varprice-rubl-cons = 0.
     3889   find first out-vatp_doc-line where
     3890              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     3891          and out-vatp_doc-line.artic      = buf_doc-line.artic
     3892          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     3893          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     3894   if available out-vatp_doc-line           and
     3895     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     3896     assign
     3897       varfact-qnty = out-vatp_doc-line.fact-qnty.
     3898   end.
     3899   else do:
     3900     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     3901                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     3902                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     3903                                  and out-vatp_parts.artic      = buf_doc-line.artic
     3904                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     3905                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     3906       if out-vatp_parts.purch-code = 2 then do:
     3907   assign
     3908     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     3909     price-base-with-tax-loco = out-vatp_parts.price-base
     3910   .
     3911   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3913     (output varinvprbo
     3914     )  .
     3915     if out-vatp_parts.out-code = 'free-zone':U     or
     3916        out-vatp_parts.out-code = 'out-zone':U   or
     3917        out-vatp_parts.doc-type = 'акт':U then do:
     3918       assign
     3919         in-vatp-have-vat-slto = yes.
     3920     end.
     3921     else do:
     3922       find first in-vatp_doc-attro no-lock
     3923         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     3924           and in-vatp_doc-attro.attr-code = 'envd':U
     3925         no-error .
     3926       if not available in-vatp_doc-attro then do:
     3927         assign
     3928           in-vatp-have-vat-slto = yes.
     3929       end.
     3930       else do:
     3931            in-vatp-have-vat-slto = no.
     3932       end.
     3933     end.
     3934     assign
     3935      price-cli-with-tax-loco = out-vatp_parts.price-cli
     3936      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     3937     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     3938              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     3939     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     3940             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     3941             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     3942             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     3943             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     3944             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     3945             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3946       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3947     assign
     3948       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     3949     assign
     3950       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     3951       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     3952       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     3953       transport-cli-loco  = 0
     3954       other-cli-loco      = 0
     3955     .
     3956   ASSIGN
     3957             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     3958       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     3959   .
     3960         assign
     3961           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     3962           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     3963         assign
     3964           varis-cons-parts-have = yes
     3965           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     3966       end.
     3967       assign
     3968         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     3969     end.
     3970   end.
     3971   assign
     3972     varprice-base-cons = varprice-base-cons / varcons-qnty
     3973     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     3974   if varprice-base-cons = ? then do:
     3975     assign
     3976       varprice-base-cons = 0.
     3977   end.
     3978   if varprice-rubl-cons = ? then do:
     3979     assign
     3980       varprice-rubl-cons = 0.
     3981   end.
     3982   assign
     3983       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     3984     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3985     discnt-base-sale            = buf_gds-dtl.discnt-base
     3986     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     3987       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     3988     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3989     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     3990     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     3991     .
     3992   if buf_trn-doc.doc-type = 'инв':U then do:
     3993     assign
     3994       varfact-qnty = buf_gds-dtl.doc-qnty.
     3995   end.
     3996   else do:
     3997     assign
     3998       varfact-qnty = buf_gds-dtl.fact-qnty.
     3999   end.
     4000   if varis-cons-parts-have = no then do:
     4001     assign
     4002           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4003           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     4004   end.
     4005   else do:
     4006     if buf_trn-doc.doc-type = 'инв':U then do:
     4007       assign
     4008               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4009               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4010        .
     4011     end.
     4012     else do:
     4013       assign
     4014               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4015               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4016        .
     4017     end.
     4018   end.
     4019   assign
     4020   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     4021   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     4022           assign
     4023             p-fact-qnty           = p-fact-qnty          + v-gds-dtl-fact-qnty
     4024             p-sale-sum-base       = p-sale-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     4025             p-sale-sum-rubl       = p-sale-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     4026             p-sale-vat-base       = p-sale-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     4027             p-sale-vat-rubl       = p-sale-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     4028             p-sale-slt-base       = p-sale-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     4029             p-sale-slt-rubl       = p-sale-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     4030             p-sale-road-tax-base  = p-sale-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     4031             p-sale-road-tax-rubl  = p-sale-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     4032             p-sale-excise-base    = p-sale-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     4033             p-sale-excise-rubl    = p-sale-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     4034             p-sale-discnt-base    = p-sale-discnt-base   + discnt-base-sale          * v-gds-dtl-fact-qnty
     4035             p-sale-discnt-rubl    = p-sale-discnt-rubl   + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     4036           .
     4037         end.
     4038       end.
     4039       assign
     4040         p-sale-transport-base = 0
     4041         p-sale-transport-rubl = 0
     4042         p-sale-other-base     = 0
     4043         p-sale-other-rubl     = 0
     4044       .
     4045     end.
     4046   end procedure.
     4047   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4048   procedure tax-name:
     4049   define input  parameter pardef-tax  as character           no-undo.
     4050   define output parameter parname-tax as character initial ? no-undo.
     4051   define buffer bf_tax for ub.tax.
     4052   do on error undo, return error :
     4053      case pardef-tax:
     4054         when 'vat':U then do:
     4055                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     4056         end.
     4057         when 'slt':U then do:
     4058                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     4059         end.
     4060         when 'rdt':U then do:
     4061                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     4062         end.
     4063         when 'exc':U then do:
     4064                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     4065         end.
     4066         otherwise do:
     4067            return error "Задан неверный параметр " + pardef-tax + " .".
     4068         end.
     4069      end case.
     4070   end.
     4071   end procedure.
     4072   procedure check-contract-code :
     4073   define input  parameter parmode           as   character                     no-undo.
     4074   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     4075   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     4076   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     4077   define input  parameter parframe-value    as   character                     no-undo.
     4078   define input  parameter parmenu-handle    as   handle                        no-undo.
     4079   define input  parameter parobj-date       as   date                          no-undo.
     4080   define input  parameter partype-contract  as   character                     no-undo .
     4081   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     4082   define buffer bf_contract     for ub.contract.
     4083   define buffer bf-oth_contract for ub.contract.
     4084   define variable varrid-list as character no-undo.
     4085   define variable varrecid    as recid     no-undo.
     4086   define variable varlog      as logical   no-undo.
     4087   define variable var-args    as char      no-undo.
     4088   define variable var-ext-doc-type as char     no-undo.
     4089   do on error undo, return error return-value :
     4090   var-args = parmode.
     4091   parmode = entry(1, parmode).
     4092   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     4093   if partype-contract = "" or partype-contract = ? then
     4094      partype-contract = 'при':U .
     4095   assign
     4096     parcontract-code = 0
     4097   .
     4098   if parmode = "input":u
     4099   then do:
     4100     if parframe-value = ""
     4101     then do:
     4102       assign
     4103         parcontract-code = 0
     4104       .
     4105     end.
     4106     else do:
     4107       find first bf_contract no-lock
     4108         where bf_contract.host-code         = parhost-code
     4109           and bf_contract.cli-type          = parcli-type
     4110           and bf_contract.cli-code          = parcli-code
     4111           and bf_contract.contract-prn-code = parframe-value
     4112         no-error.
     4113       if available bf_contract
     4114       then do:
     4115         find first bf-oth_contract no-lock
     4116           where bf-oth_contract.host-code          = parhost-code
     4117             and bf-oth_contract.contract-prn-code  = parframe-value
     4118             and bf-oth_contract.cli-type           = parcli-type
     4119             and bf-oth_contract.cli-code           = parcli-code
     4120             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     4121           no-error .
     4122         if available bf-oth_contract
     4123         then do:
     4124           message
     4125             "На фирме " parhost-code skip
     4126             "у контрагента" parcli-type parcli-code skip
     4127             "имеются два контракта с номером" parframe-value skip
     4128           view-as alert-box .
     4129         end.
     4130         else do:
     4131           assign
     4132             parcontract-code = bf_contract.contract-code
     4133           .
     4134         end.
     4135       end.
     4136     end.
     4137   end.
     4138   if parmode <> "input":u
     4139   or parcontract-code = 0
     4140   then do:
     4141     run str/cont-all.w (input parmenu-handle,
     4142                     input parhost-code,
     4143                     input "b-sel",
     4144                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     4145                     input parcli-type,
     4146                     input parcli-code,
     4147                     input ?,
     4148                     input ?,
     4149                     input "current":u,
     4150                     input partype-contract,
     4151                     input-output varrid-list ) no-error.
     4152     if error-status:error then do:
     4153       message "Ошибка при вызове справочника договоров." skip
     4154               return-value                skip
     4155               error-status:get-message(1) skip
     4156               error-status:get-message(2)
     4157       view-as alert-box error.
     4158       return error.
     4159     end.
     4160     assign
     4161       varrecid = integer(entry(1, varrid-list)).
     4162     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     4163     if available bf_contract then do:
     4164       assign
     4165         parcontract-code = bf_contract.contract-code.
     4166     end.
     4167   end.
     4168   if parcontract-code <> 0
     4169   then do:
     4170     if (bf_contract.status_ = 'зкр':U or
     4171         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     4172       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     4173       then do:
     4174           assign
     4175             varlog = no.
     4176           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     4177           view-as alert-box.
     4178           assign
     4179             parcontract-code = 0
     4180           .
     4181       end.
     4182     end.
     4183     if bf_contract.contract-date-beg > parobj-date then do:
     4184       assign
     4185         varlog = no.
     4186       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     4187       view-as alert-box.
     4188       assign
     4189         parcontract-code = 0
     4190       .
     4191     end.
     4192     if parcontract-code <> 0
     4193     then do:
     4194       if bf_contract.cli-type <> parcli-type
     4195       or bf_contract.cli-code <> parcli-code
     4196       then do:
     4197          message "По договору " bf_contract.contract-code
     4198                  ( if bf_contract.doc-type =  'при':U
     4199                    then " поставщиком является "
     4200                    else " покупателем является " )
     4201                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     4202                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     4203          view-as alert-box error.
     4204          assign
     4205            parcontract-code = 0.
     4206       end.
     4207       if parcontract-code <> ? then do:
     4208         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     4209           message "Контракт имеет недопустимый тип." view-as alert-box.
     4210           assign
     4211             parcontract-code = 0.
     4212         end.
     4213       end.
     4214     end.
     4215   end.
     4216   end.
     4217   end procedure.
     4218   procedure cntrcode-get-arg-val:
     4219       def input param p-args as char no-undo.
     4220       def input param p-key as char no-undo.
     4221       def output param p-val as char no-undo.
     4222       def var i as int no-undo.
     4223       def var nums as int no-undo.
     4224       def var key-val as char no-undo.
     4225       nums = num-entries(p-args).
     4226       do i = 1 to nums:
     4227           key-val = entry(i, p-args).
     4228           if key-val begins (p-key + "=") then do:
     4229               p-val = entry(2, key-val, "=").
     4230               return.
     4231           end.
     4232       end.
     4233       p-val = "".
     4234   end.
