     4655   procedure ver-clients :
     4656   define input  parameter p-obj-type as character no-undo .
     4657   define input  parameter p-obj-code as integer   no-undo .
     4658   define output parameter p-error as logical   no-undo .
     4659   define variable v-veto-man-doc as character no-undo .
     4660   define variable v-type        as character no-undo .
     4661     do
     4662     on error undo, return error return-value
     4663     :
     4664     p-error = false .
     4665   run clntattr-value in this-procedure (
     4666    input p-obj-type ,
     4667    input p-obj-code ,
     4668    input 'veto-man-doc':U     ,
     4669    output v-veto-man-doc ,
     4670    output v-type        ) no-error .
     4671    if error-status :error then message
     4672      error-status :get-message(1) skip
     4673      return-value skip
     4674      "Ошибка clntattr-veto-man-doc"
     4675      view-as alert-box error
     4676    .
     4677     if v-veto-man-doc = 'ALL' then do:
     4678         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     4679         p-error = true .
     4680     end.
     4681    end.
     4682   end procedure.
     4683   define temp-table temp-parts no-undo
     4684     like ub.parts
     4685     field free-qnty as decimal
     4686     field free-cli-qnty as decimal
     4687   .
     4688   define temp-table tt-old-doc-line-sum no-undo like ub.doc-line-sum.
     4689   function disp-unit-base return character (buffer local-parts for bf-orig_parts).
     4690   define buffer bf_goods for ub.goods.
     4691   find first bf_goods where bf_goods.artic     = local-parts.artic     and
     4692                             bf_goods.prod-type = local-parts.prod-type and
     4693                             bf_goods.prod-code = local-parts.prod-code no-lock.
     4694   return bf_goods.unit-base.
     4695   end function.
     4696   define temp-table tt-del-list no-undo
     4697   field rec-id as recid
     4698   index rec-id is unique primary rec-id.
     4699   define temp-table tt-del-list-op no-undo
     4700   field rec-id as recid
     4701   index rec-id is unique primary rec-id.
     4702   define temp-table tt-cur-parts no-undo like ub.parts.
     4703   define temp-table tt-new-parts no-undo like ub.parts.
     4704   function get-mark-orig return character (buffer local-parts for bf-orig_parts ).
     4705      find first tt-del-list-op where tt-del-list-op.rec-id = recid( local-parts ) no-error.
     4706      if available tt-del-list-op then do:
     4707        return "*".
     4708      end.
     4709      else do:
     4710        return "".
     4711      end.
     4712   end function.
     4713   function get-mark return character (buffer local-doc-line for ub.doc-line).
     4714      find first tt-del-list where tt-del-list.rec-id = recid( local-doc-line ) no-error.
     4715      if available tt-del-list then do:
     4716        return "*".
     4717      end.
     4718      else do:
     4719        return "".
     4720      end.
     4721   end function.
     4722   function fpurch-code return character (buffer local-parts for ub.parts).
     4723       return entry (lookup (string(local-parts.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     4724   end.
