     5439                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     5440     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     5441       if input frame d-doc t-doc.agnt <> ""
     5442          and input frame d-doc t-doc.agnt <> ? then
     5443         message "Из справочника клиентов Вы должны выбрать человека.".
