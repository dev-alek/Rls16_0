     3047   procedure holdprts-get-part-code :
     3048     define input  parameter p-doc-code       as character no-undo .
     3049     define output parameter p-hold-part-code as integer   no-undo .
     3050     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
     3051     define variable v-attr-value as character no-undo .
     3052     define variable v-attr-type  as character no-undo .
     3053     define buffer buf_trn-doc for ub.trn-doc .
     3054     do
     3055     on error undo, return error return-value
     3056     :
     3057       find first buf_trn-doc exclusive-lock
     3058         where buf_trn-doc.doc-code = p-doc-code
     3059         no-error .
     3060       if not available buf_trn-doc
     3061       then do:
     3062         message
     3063           vss-workfile vss-revision vss-description skip
     3064           vss-include-info19 skip
     3065           "Ошибка задания входных параметров" skip
     3066           "Не найден документ" p-doc-code skip
     3067           view-as alert-box error .
     3068         undo, return error .
     3069       end.
     3070   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     3071                           input 'hold-part-code':U ,
     3072                          output v-attr-value ,
     3073                          output v-attr-type )  .
     3074       assign
     3075         p-hold-part-code = integer(v-attr-value) + 1
     3076       .
     3077   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     3078                          input 'hold-part-code':U ,
     3079                          input string(p-hold-part-code) )  .
     3080     end.
     3081   end procedure.
     3082   procedure holdprts-validate-document :
     3083     define input  parameter p-doc-code as character no-undo .
     3084     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
     3085     define buffer buf_trn-doc    for ub.trn-doc .
     3086     define buffer parent_trn-doc for ub.trn-doc .
     3087     define buffer buf_parts      for ub.parts .
     3088     define buffer buf_parts-supp for ub.parts-supp .
     3089     do
     3090     on error undo, return error return-value
     3091     :
     3092       find first buf_trn-doc exclusive-lock
     3093         where buf_trn-doc.doc-code = p-doc-code
     3094         no-error .
     3095       if not available buf_trn-doc
     3096       then do:
     3097         message
     3098           vss-workfile vss-revision vss-description skip
     3099           vss-include-info19 skip
     3100           "Ошибка задания входных параметров" skip
     3101           "Не найден документ" p-doc-code skip
     3102           view-as alert-box error .
     3103         undo, return error .
     3104       end.
     3105       find first parent_trn-doc exclusive-lock
     3106         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
     3107         no-error .
     3108       if not available parent_trn-doc
     3109       then do:
     3110         message
     3111           vss-workfile vss-revision vss-description skip
     3112           vss-include-info19 skip
     3113           "Не найден родительский документ" skip
     3114           "Документ" buf_trn-doc.doc-code skip
     3115           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     3116           view-as alert-box error .
     3117         undo, return error .
     3118       end.
     3119       if buf_trn-doc.ext-doc-type <> 'ie':U
     3120       then do:
     3121         return .
     3122       end.
     3123       for each buf_parts share-lock
     3124         where buf_parts.out-code = buf_trn-doc.doc-code
     3125       on error undo, return error
     3126       :
     3127         find first buf_parts-supp share-lock
     3128           where buf_parts-supp.in-code   = buf_parts.in-code
     3129             and buf_parts-supp.artic     = buf_parts.artic
     3130             and buf_parts-supp.prod-type = buf_parts.prod-type
     3131             and buf_parts-supp.prod-code = buf_parts.prod-code
     3132             and buf_parts-supp.part-code = buf_parts.part-code
     3133           no-error .
     3134         if not available buf_parts-supp
     3135         then do:
     3136           message
     3137             vss-workfile vss-revision vss-description skip
     3138             vss-include-info19 skip
     3139             "Не найдена информация о поставщике" skip
     3140             "Документ" buf_trn-doc.doc-code skip
     3141             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     3142             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3143             "Номер партии" buf_parts.part-code skip
     3144             view-as alert-box error .
     3145           undo, return error .
     3146         end.
     3147       end.
     3148       for each buf_parts-supp share-lock
     3149         where buf_parts-supp.in-code = buf_trn-doc.doc-code
     3150       on error undo, return error
     3151       :
     3152         find first buf_parts share-lock
     3153           where buf_parts.out-code  = buf_parts-supp.in-code
     3154             and buf_parts.obj-type  = buf_trn-doc.obj-type
     3155             and buf_parts.obj-code  = buf_trn-doc.obj-code
     3156             and buf_parts.artic     = buf_parts-supp.artic
     3157             and buf_parts.prod-type = buf_parts-supp.prod-type
     3158             and buf_parts.prod-code = buf_parts-supp.prod-code
     3159             and buf_parts.part-code = buf_parts-supp.part-code
     3160           no-error .
     3161         if not available buf_parts
     3162         then do:
     3163           message
     3164             vss-workfile vss-revision vss-description skip
     3165             vss-include-info19 skip
     3166             "Задана информация о поставщике для неизвестной партии" skip
     3167             "Документ" buf_trn-doc.doc-code skip
     3168             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     3169             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3170             "Номер партии" buf_parts.part-code skip
     3171             view-as alert-box error .
     3172           undo, return error .
     3173         end.
     3174       end.
     3175       for each buf_parts share-lock
     3176         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
     3177       on error undo, return error
     3178       :
     3179         if  buf_trn-doc.doc-type = 'при':U
     3180         and buf_parts.qnty = buf_parts.fact-qnty
     3181         then do:
     3182           next.
     3183         end.
     3184         find first buf_parts-supp share-lock
     3185           where buf_parts-supp.orig-in-code   = buf_parts.in-code
     3186             and buf_parts-supp.artic          = buf_parts.artic
     3187             and buf_parts-supp.prod-type      = buf_parts.prod-type
     3188             and buf_parts-supp.prod-code      = buf_parts.prod-code
     3189             and buf_parts-supp.orig-part-code = buf_parts.part-code
     3190           no-error .
     3191         if not available buf_parts-supp
     3192         then do:
     3193           message
     3194             vss-workfile vss-revision vss-description skip
     3195             vss-include-info19 skip
     3196             "Не найдена информация о поставщике для исходной накладной" skip
     3197             "Документ" buf_trn-doc.doc-code skip
     3198             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     3199             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3200             "Номер партии" buf_parts.part-code skip
     3201             view-as alert-box error .
     3202           undo, return error .
     3203         end.
     3204       end.
     3205     end.
     3206   end procedure.
     3207   procedure holdprts-doc-type :
     3208     define input  parameter p-cat-code as integer   no-undo .
     3209     define input  parameter p-doc-code as character no-undo .
     3210     define output parameter p-is-sale  as logical   no-undo .
     3211     define output parameter p-is-purch as logical   no-undo .
     3212     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
     3213     define buffer buf_trn-doc for ub.trn-doc .
     3214     do
     3215     on error undo, return error return-value
     3216     :
     3217       find first buf_trn-doc no-lock
     3218         where buf_trn-doc.doc-code = p-doc-code
     3219         no-error .
     3220       if not available buf_trn-doc
     3221       then do:
     3222         message
     3223           vss-workfile vss-revision vss-description skip
     3224           vss-include-info19 skip
     3225           "Ошибка задания входных параметров" skip
     3226           "Не найден документ" skip
     3227           "Документ" p-doc-code skip
     3228           "Тип архива" p-cat-code skip
     3229           view-as alert-box error .
     3230         undo, return error .
     3231       end.
     3232       case p-cat-code :
     3233         when 1
     3234         then do:
     3235           define variable v-is-hold as logical   no-undo .
     3236   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3238     (input  buf_trn-doc.doc-code
     3239     ,output v-is-hold
     3240     )  .
     3241           if v-is-hold = true
     3242           then do:
     3243             assign
     3244               p-is-sale  = false
     3245               p-is-purch = false
     3246             .
     3247           end.
     3248           else do:
     3249             case buf_trn-doc.ext-doc-type :
     3250               when 'ie':U or
     3251               when 'ep':U
     3252               then do:
     3253                 assign
     3254                   p-is-sale  = false
     3255                   p-is-purch = true
     3256                 .
     3257               end.
     3258               when 'ee':U or
     3259               when 'es':U or
     3260               when 're':U or
     3261               when 'rs':U
     3262               then do:
     3263                 assign
     3264                   p-is-sale  = true
     3265                   p-is-purch = false
     3266                 .
     3267               end.
     3268               when 'we':U or
     3269               when 'vt':U or
     3270               when 'vp':U or
     3271               when 'ap':U or
     3272               when 'mp':U or
     3273               when 'pc':U or
     3274               when 'iv':U or
     3275               when 'ev':U or
     3276               when 'io':U or
     3277               when 'eo':U or
     3278               when 'rv':U or
     3279               when 'em':U or
     3280               when 'wm':U or
     3281               when 'im':U
     3282               then do:
     3283                 assign
     3284                   p-is-sale  = false
     3285                   p-is-purch = false
     3286                 .
     3287               end.
     3288               otherwise do:
     3289                 message
     3290                   vss-workfile vss-revision vss-description skip
     3291                   vss-include-info19 skip
     3292                   "Неизвестный тип документа" skip
     3293                   "Документ" buf_trn-doc.doc-code skip
     3294                   "Тип документа" buf_trn-doc.ext-doc-type skip
     3295                   "Тип архива" p-cat-code skip
     3296                   view-as alert-box error .
     3297                 undo, return error .
     3298               end.
     3299             end.
     3300           end.
     3301         end.
     3302         when 2
     3303         then do:
     3304           case buf_trn-doc.ext-doc-type :
     3305             when 'vt':U or
     3306             when 'vp':U
     3307             then do:
     3308               assign
     3309                 p-is-sale  = false
     3310                 p-is-purch = true
     3311               .
     3312             end.
     3313             otherwise do:
     3314               assign
     3315                 p-is-sale  = false
     3316                 p-is-purch = false
     3317               .
     3318             end.
     3319           end.
     3320         end.
     3321         when 3
     3322         then do:
     3323           case buf_trn-doc.ext-doc-type :
     3324             when 'we':U
     3325             then do:
     3326               assign
     3327                 p-is-sale  = false
     3328                 p-is-purch = true
     3329               .
     3330             end.
     3331             otherwise do:
     3332               assign
     3333                 p-is-sale  = false
     3334                 p-is-purch = false
     3335               .
     3336             end.
     3337           end.
     3338         end.
     3339         otherwise do:
     3340           message
     3341             vss-workfile vss-revision vss-description skip
     3342             "Неизвестный тип архивов" skip
     3343             "Документ" buf_trn-doc.doc-code skip
     3344             "Тип документа" buf_trn-doc.ext-doc-type skip
     3345             "Тип архива" p-cat-code skip
     3346             view-as alert-box error .
     3347           undo, return error return-value .
     3348         end.
     3349       end.
     3350     end.
     3351   end procedure.
     3352   procedure holdprts-purch-values :
     3353     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
     3354     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
     3355     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
     3356     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
     3357     define output parameter p-fact-qnty            as decimal   no-undo .
     3358     define output parameter p-purch-sum-base       as decimal   no-undo .
     3359     define output parameter p-purch-sum-rubl       as decimal   no-undo .
     3360     define output parameter p-purch-VAT-base       as decimal   no-undo .
     3361     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
     3362     define output parameter p-purch-SLT-base       as decimal   no-undo .
     3363     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
     3364     define output parameter p-purch-road-tax-base  as decimal   no-undo .
     3365     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
     3366     define output parameter p-purch-excise-base    as decimal   no-undo .
     3367     define output parameter p-purch-excise-rubl    as decimal   no-undo .
     3368     define output parameter p-purch-transport-base as decimal   no-undo .
     3369     define output parameter p-purch-transport-rubl as decimal   no-undo .
     3370     define output parameter p-purch-other-base     as decimal   no-undo .
     3371     define output parameter p-purch-other-rubl     as decimal   no-undo .
     3372     define output parameter p-purch-discnt-base    as decimal   no-undo .
     3373     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
     3374     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
     3375     define variable v-price-base     as decimal   no-undo .
     3376     define variable v-price-rubl     as decimal   no-undo .
     3377     define variable v-VAT-base       as decimal   no-undo .
     3378     define variable v-VAT-rubl       as decimal   no-undo .
     3379     define variable v-SLT-base       as decimal   no-undo .
     3380     define variable v-SLT-rubl       as decimal   no-undo .
     3381     define variable v-road-tax-base  as decimal   no-undo .
     3382     define variable v-road-tax-rubl  as decimal   no-undo .
     3383     define variable v-transport-base as decimal   no-undo .
     3384     define variable v-transport-rubl as decimal   no-undo .
     3385     define variable v-other-base     as decimal   no-undo .
     3386     define variable v-other-rubl     as decimal   no-undo .
     3387     define buffer buf_trn-doc        for ub.trn-doc .
     3388     define buffer buf_parts          for ub.parts .
     3389     define buffer buf_parts-supp     for ub.parts-supp .
     3390     define buffer buf_doc-line       for ub.doc-line .
     3391     define buffer buf_income_trn-doc for ub.trn-doc .
     3392     do
     3393     on error undo, return error return-value
     3394     :
     3395       find first buf_trn-doc no-lock
     3396         where buf_trn-doc.doc-code = p-doc-code
     3397         no-error .
     3398       if not available buf_trn-doc
     3399       then do:
     3400         message
     3401           vss-workfile vss-revision vss-description skip
     3402           vss-include-info19 skip
     3403           "Ошибка задания входных параметров" skip
     3404           "Не найден документ" skip
     3405           "Документ" p-doc-code skip
     3406           view-as alert-box error .
     3407         undo, return error .
     3408       end.
     3409       find first buf_doc-line no-lock
     3410         where buf_doc-line.doc-code  = p-doc-code
     3411           and buf_doc-line.artic     = p-artic
     3412           and buf_doc-line.prod-type = p-prod-type
     3413           and buf_doc-line.prod-code = p-prod-code
     3414         no-error .
     3415       if not available buf_doc-line
     3416       then do:
     3417         message
     3418           vss-workfile vss-revision vss-description skip
     3419           vss-include-info19 skip
     3420           "Ошибка задания входных параметров" skip
     3421           "Не найдена строка документа" skip
     3422           "Документ" p-doc-code skip
     3423           "Артикул" p-artic p-prod-type p-prod-code skip
     3424           view-as alert-box error .
     3425         undo, return error .
     3426       end.
     3427       assign
     3428         p-fact-qnty            = 0
     3429         p-purch-sum-base       = 0
     3430         p-purch-sum-rubl       = 0
     3431         p-purch-VAT-base       = 0
     3432         p-purch-VAT-rubl       = 0
     3433         p-purch-SLT-base       = 0
     3434         p-purch-SLT-rubl       = 0
     3435         p-purch-road-tax-base  = 0
     3436         p-purch-road-tax-rubl  = 0
     3437         p-purch-excise-base    = 0
     3438         p-purch-excise-rubl    = 0
     3439         p-purch-transport-base = 0
     3440         p-purch-transport-rubl = 0
     3441         p-purch-other-base     = 0
     3442         p-purch-other-rubl     = 0
     3443         p-purch-discnt-base    = 0
     3444         p-purch-discnt-rubl    = 0
     3445       .
     3446       for each buf_parts no-lock
     3447         where buf_parts.out-code  = buf_doc-line.doc-code
     3448           and buf_parts.obj-type  = buf_doc-line.obj-type
     3449           and buf_parts.obj-code  = buf_doc-line.obj-code
     3450           and buf_parts.artic     = buf_doc-line.artic
     3451           and buf_parts.prod-type = buf_doc-line.prod-type
     3452           and buf_parts.prod-code = buf_doc-line.prod-code
     3453       on error undo, return error
     3454       :
     3455         define variable v-parts-qnty as decimal   no-undo .
     3456         assign
     3457           v-parts-qnty = buf_parts.fact-qnty
     3458                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
     3459                            then -1
     3460                            else 1
     3461                          )
     3462         .
     3463         find first buf_parts-supp no-lock
     3464           where buf_parts-supp.in-code   = buf_parts.in-code
     3465             and buf_parts-supp.artic     = buf_parts.artic
     3466             and buf_parts-supp.prod-type = buf_parts.prod-type
     3467             and buf_parts-supp.prod-code = buf_parts.prod-code
     3468             and buf_parts-supp.part-code = buf_parts.part-code
     3469           no-error .
     3470         if available buf_parts-supp
     3471         then do:
     3472           assign
     3473             v-price-base     = buf_parts-supp.price-base
     3474             v-price-rubl     = buf_parts-supp.price-rubl
     3475             v-VAT-base       = buf_parts-supp.VAT-base
     3476             v-VAT-rubl       = buf_parts-supp.VAT-rubl
     3477             v-SLT-base       = buf_parts-supp.SLT-base
     3478             v-SLT-rubl       = buf_parts-supp.SLT-rubl
     3479             v-road-tax-base  = buf_parts-supp.road-tax-base
     3480             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
     3481             v-transport-base = buf_parts-supp.transport-base
     3482             v-transport-rubl = buf_parts-supp.transport-rubl
     3483             v-other-base     = buf_parts-supp.other-base
     3484             v-other-rubl     = buf_parts-supp.other-rubl
     3485           .
     3486         end.
     3487         else do:
     3488       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3489       define buffer   in-vatp-parts    for ub.parts   .
     3490       define buffer   in-vatp-doc      for ub.trn-doc .
     3491       define buffer   in-vatp-goods    for ub.goods   .
     3492       define buffer   in-vatp-sysconf  for ub.sysconf .
     3493       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3494       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3495       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3496       define variable varinvprb                  as   character              no-undo.
     3497       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3498       define variable cli-base-rate              as   decimal                no-undo.
     3499       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3500       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3501       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3502       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3503       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3504       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3505       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3506       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3507       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3508       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3509       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3510       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3511       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3512       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3513       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3514       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3515       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3516       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3517       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3518       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3519       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3520       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3521       define variable varinvatp-envd             as   character              no-undo.
     3522       define variable varinvatp-type             as   character              no-undo.
     3523   assign
     3524     price-rubl-with-tax-loc = buf_parts.price-rubl
     3525     price-base-with-tax-loc = buf_parts.price-base
     3526   .
     3527   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3529     (output varinvprb
     3530     )  .
     3531     if buf_parts.out-code = 'free-zone':U     or
     3532        buf_parts.out-code = 'out-zone':U   or
     3533        buf_parts.doc-type = 'акт':U then do:
     3534       assign
     3535         in-vatp-have-vat-slt = yes.
     3536     end.
     3537     else do:
     3538       find first in-vatp_doc-attr no-lock
     3539         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3540           and in-vatp_doc-attr.attr-code = 'envd':U
     3541         no-error .
     3542       if not available in-vatp_doc-attr then do:
     3543         assign
     3544           in-vatp-have-vat-slt = yes.
     3545       end.
     3546       else do:
     3547            in-vatp-have-vat-slt = no.
     3548       end.
     3549     end.
     3550     assign
     3551      price-cli-with-tax-loc = buf_parts.price-cli
     3552      cli-base-rate          = buf_parts.cli-base-rate.
     3553     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3554              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3555     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3556             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3557             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3558             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3559             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3560             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     3561             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3562       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3563     assign
     3564       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     3565     assign
     3566       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3567       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3568       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3569       transport-cli-loc  = 0
     3570       other-cli-loc      = 0
     3571     .
     3572   ASSIGN
     3573             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3574       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3575   .
     3576           assign
     3577             v-price-base     = price-base-with-tax-loc
     3578             v-price-rubl     = price-rubl-with-tax-loc
     3579             v-VAT-base       = vat-base-loc
     3580             v-VAT-rubl       = vat-rubl-loc
     3581             v-SLT-base       = slt-base-loc
     3582             v-SLT-rubl       = slt-rubl-loc
     3583             v-road-tax-base  = road-tax-base-loc
     3584             v-road-tax-rubl  = road-tax-rubl-loc
     3585             v-transport-base = transport-base-loc
     3586             v-transport-rubl = transport-rubl-loc
     3587             v-other-base     = other-base-loc
     3588             v-other-rubl     = other-rubl-loc
     3589           .
     3590         end.
     3591         assign
     3592           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
     3593           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
     3594           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
     3595           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
     3596           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
     3597           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
     3598           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
     3599           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
     3600           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
     3601           p-purch-excise-base    = p-purch-excise-base    + 0
     3602           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
     3603           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
     3604           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
     3605           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
     3606           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
     3607           p-purch-discnt-base    = p-purch-discnt-base    + 0
     3608           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
     3609         .
     3610       end.
     3611     end.
     3612   end procedure.
     3613   procedure holdprts-sale-values :
     3614     define input  parameter p-doc-code            like ub.doc-line.doc-code  no-undo .
