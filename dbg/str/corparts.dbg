     5084   PROCEDURE mv-brw-defaultbr-cp:
     5085   def var old-session as logical no-undo.
     5086     old-session = SESSION:IMMEDIATE-DISPLAY.
     5087     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5088     do varmvlbr-cp = 2 to EXTENT(cur-clmn-numbr-cp):
     5089       RUN re-move-clmnbr-cp (cur-clmn-numbr-cp[varmvlbr-cp], varmvlbr-cp).
