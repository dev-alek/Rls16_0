     3018           buf_parts-supp.fact-date         = buf_parts.fact-date
     3019           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
     3020           buf_parts-supp.last-date         = buf_parts.last-date
     3021           buf_parts-supp.pay-code          = buf_parts.pay-code
     3022           buf_parts-supp.price-cli         = buf_parts.price-cli
     3023           buf_parts-supp.purch-code        = buf_parts.purch-code
     3024           buf_parts-supp.supp-code         = buf_parts.supp-code
     3025           buf_parts-supp.supp-type         = buf_parts.supp-type
     3026           buf_parts-supp.unit-cli          = v-unit-cli
     3027         .
     3028         assign
     3029           buf_parts-supp.vat-pc         = vat-pc-loc
     3030           buf_parts-supp.slt-pc         = slt-pc-loc
     3031           buf_parts-supp.price-base     = price-base-with-tax-loc
     3032           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
     3033           buf_parts-supp.vat-base       = vat-base-loc
     3034           buf_parts-supp.vat-rubl       = vat-rubl-loc
     3035           buf_parts-supp.slt-base       = slt-base-loc
     3036           buf_parts-supp.slt-rubl       = slt-rubl-loc
     3037           buf_parts-supp.road-tax-base  = road-tax-base-loc
     3038           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
     3039           buf_parts-supp.transport-base = transport-base-loc
     3040           buf_parts-supp.transport-rubl = transport-rubl-loc
     3041           buf_parts-supp.other-base     = other-base-loc
     3042           buf_parts-supp.other-rubl     = other-rubl-loc
     3043         .
     3044       end.
     3045     end.
