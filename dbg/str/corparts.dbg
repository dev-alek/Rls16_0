     5094   .
     5095   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5096   DEF VAR cur-clmn-numbr as INT EXTENT 26 no-undo.
     5097   DEF VAR varmvibr       as INT no-undo.
     5098   DEF VAR varmvjbr       as INT no-undo.
     5099   DEF VAR varmvkbr       as INT no-undo.
     5100   DEF VAR varmvlbr       as INT no-undo.
     5101   DEF VAR move-elementbr as INT no-undo.
     5102   def var jjbr           as int no-undo.
     5103   do varmvibr = 1 to EXTENT(cur-clmn-numbr):
     5104     ASSIGN cur-clmn-numbr[varmvibr] = varmvibr.
     5105   END.
     5106   RUN start-mv-clmnbr.
     5107   PROCEDURE start-mv-clmnbr:
     5108   def var old-session as logical no-undo.
     5109      old-session = SESSION:IMMEDIATE-DISPLAY.
     5110      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5111      SESSION:IMMEDIATE-DISPLAY = old-session.
     5112   END.
     5113   ON ctrl-cursor-right OF BROWSE br do:
     5114     RUN re-move-clmnbr ( 3, 26).
     5115   END.
     5116   ON ctrl-cursor-left OF BROWSE br do:
     5117     RUN re-move-clmnbr (26, 3).
     5118   END.
     5119   PROCEDURE re-move-clmnbr:
     5120     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5121     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5122     DO varmvibr = 1 TO EXTENT(cur-clmn-numbr):
     5123       if cur-clmn-numbr[varmvibr] = source-column THEN cur-clmn-numbr[varmvibr] = -1.
     5124     END.
     5125     if br:MOVE-COLUMN(source-column, target-column) IN FRAME d-doc then.
     5126     if source-column > target-column THEN
     5127     DO varmvjbr = source-column - 1 to target-column BY -1:
     5128       DO varmvibr = 1 TO EXTENT(cur-clmn-numbr):
     5129           if cur-clmn-numbr[varmvibr] = varmvjbr THEN DO:
     5130             cur-clmn-numbr[varmvibr] = cur-clmn-numbr[varmvibr] + 1.
     5131           END.
     5132       END.
     5133     END.
     5134     ELSE
     5135     DO varmvjbr = source-column + 1 to target-column:
     5136       DO varmvibr = 1 TO EXTENT(cur-clmn-numbr):
     5137         if cur-clmn-numbr[varmvibr] = varmvjbr THEN DO:
     5138           cur-clmn-numbr[varmvibr] = cur-clmn-numbr[varmvibr] - 1.
     5139         END.
     5140       END.
     5141     END.
     5142     DO varmvibr = 1 TO EXTENT(cur-clmn-numbr):
     5143       if cur-clmn-numbr[varmvibr] = -1 THEN cur-clmn-numbr[varmvibr] = target-column.
     5144     END.
     5145   END PROCEDURE.
     5146   PROCEDURE ch-clmnbr:
     5147     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5148     if cur-clmn-loc <= 3 then do:
     5149       return .
     5150     end.
     5151     DO varmvibr = 1 TO EXTENT(cur-clmn-numbr):
     5152       if cur-clmn-numbr[varmvibr] = cur-clmn-loc THEN move-elementbr = varmvibr.
     5153     END.
     5154     RUN re-move-clmnbr (cur-clmn-loc, 3).
     5155   END PROCEDURE.
     5156   PROCEDURE mv-brw-defaultbr:
     5157   def var old-session as logical no-undo.
     5158     old-session = SESSION:IMMEDIATE-DISPLAY.
     5159     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5160     do varmvlbr = 3 to EXTENT(cur-clmn-numbr):
     5161       RUN re-move-clmnbr (cur-clmn-numbr[varmvlbr], varmvlbr).
     5162     END.
     5163     RUN start-mv-clmnbr.
     5164     SESSION:IMMEDIATE-DISPLAY = old-session.
     5165   END PROCEDURE.
     5166   .
     5167   def var sort-labelbr   as character no-undo .
     5168   def var sort-clmnbr    as handle    no-undo .
     5169   def var cur-clmnbr     as handle    no-undo .
     5170   def var cur-clmn-locbr as integer   no-undo .
     5171   def var re-querybr     as logical   initial no no-undo .
     5172   on start-search, ctrl-o of br in frame d-doc do:
     5173      run sort-brbr
     5174        (input (if available bf_doc-line
     5175                then recid(bf_doc-line)
     5176                else ?
     5177               )
     5178        ).
     5179   end.
     5180   PROCEDURE sort-brbr :
     5181     define input parameter p-recid as recid no-undo .
     5182     if re-querybr = no then do:
     5183       assign
     5184          cur-clmnbr = br:current-column in frame d-doc
     5185       .
     5186       if sort-clmnbr <> ? then sort-clmnbr:column-fgcolor = 0.
     5187       if cur-clmnbr = sort-clmnbr then do:
     5188         assign
     5189            sort-labelbr = ""
     5190            sort-clmnbr = ?
     5191         .
     5192        end.
     5193        else do:
     5194          assign
     5195            sort-labelbr = cur-clmnbr:label
     5196            sort-clmnbr  = cur-clmnbr
     5197            sort-clmnbr:column-fgcolor = 4
     5198          .
     5199        end.
     5200      end.
     5201     assign
     5202       cur-clmn-locbr = 1
     5203     .
     5204     def var column-handle as handle no-undo .
     5205     column-handle = br:first-column.
     5206     do while valid-handle(column-handle) :
     5207       if column-handle = cur-clmnbr then do:
     5208         leave .
     5209       end.
     5210       column-handle = column-handle:NEXT-COLUMN.
     5211       assign
     5212         cur-clmn-locbr = cur-clmn-locbr + 1
     5213       .
     5214     end.
     5215     case sort-labelbr:
     5216           when '*'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by get-mark (buffer bf_doc-line) .   . END.
     5217           when 'Артикул'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf_doc-line.artic .   . END.
     5218           when 'Название товара'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf_goods.gds-name .   . END.
     5219           when 'Тип'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf_doc-line.prod-type .   . END.
     5220           when 'Код произ'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf_doc-line.prod-code .   . END.
     5221           when 'Изм. кол-во'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf-expp_doc-line-sum.fact-qnty .   . END.
     5222           when 'Расход сумма (руб)'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf-expp_doc-line-sum.cost-sum-rubl descending .   . END.
     5223           when 'Расход сумма (вал)'  then DO:   open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U by bf-expp_doc-line-sum.cost-sum-base descending .   . END.
