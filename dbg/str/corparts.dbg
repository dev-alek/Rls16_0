     5254         .
     5255       end.
     5256     end case.
     5257       if cur-clmn-locbr <> ? then do:
     5258         if can-do( this-procedure:internal-entries, 'ch-clmnbr') then do:
     5259           run ch-clmnbr in this-procedure (cur-clmn-locbr).
     5260         end.
     5261       end.
     5262     if p-recid <> ? then do:
     5263       reposition br to recid p-recid no-error.
     5264       apply "value-changed" to br in frame d-doc.
     5265     end.
     5266     apply "entry" to br in frame d-doc.
     5267   END PROCEDURE.
     5268   procedure re-open-query-srt-clmnbr:
     5269   if cur-clmnbr = ? then do:
     5270      open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U.
     5271   end.
     5272   else do:
     5273      assign re-querybr = yes.
     5274      run sort-brbr
     5275        (input (if available bf_doc-line
     5276                then recid(bf_doc-line)
     5277                else ?
     5278               )
     5279        ).
