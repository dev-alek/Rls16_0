     6119   on choose of b-lkp-cp in frame d-doc
     6120   do:
     6121     define buffer bf_doc-line for ub.doc-line.
     6122     define buffer bf_goods    for ub.goods.
     6123     define variable prt-rec as recid no-undo.
     6124     if not available bf-caus_parts then do:
     6125       message "Неправильно выбрана порожденная партия." view-as alert-box information.
     6126       return no-apply.
     6127     end.
     6128     find first bf_doc-line where bf_doc-line.doc-code  = bf-caus_parts.out-code  and
     6129                                 bf_doc-line.artic     = bf-caus_parts.artic     and
     6130                                 bf_doc-line.prod-type = bf-caus_parts.prod-type and
     6131                                 bf_doc-line.prod-code = bf-caus_parts.prod-code no-lock.
     6132     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     6133                               bf_goods.prod-type = bf_doc-line.prod-type and
     6134                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     6135     assign
     6136       prt-rec   = recid( bf-caus_parts )
     6137       .
     6138     run str/parts-f.w
     6139       (input        parparentproc
     6140       ,input        ?
     6141       ,input        'ПРОСМОТР':U
     6142       ,input        bf_doc-line.doc-code
     6143       ,input        bf_goods.gds-code
     6144       ,input        0
     6145       ,input-output prt-rec
     6146       ).
     6147   end.
     6148   on value-changed of browse br do:
     6149    open query br-op   for each bf-orig_parts where bf-orig_parts.out-code  = t-doc.doc-code        and                                  bf-orig_parts.obj-type  = t-doc.obj-type        and                                  bf-orig_parts.obj-code  = t-doc.obj-code        and                                  bf-orig_parts.artic     = bf_doc-line.artic     and                                  bf-orig_parts.prod-type = bf_doc-line.prod-type and                                  bf-orig_parts.prod-code = bf_doc-line.prod-code and                                  bf-orig_parts.in-code  <> t-doc.doc-code no-lock,       first bf-orig_goods where bf-orig_goods.artic     = bf-orig_parts.artic     and                                      bf-orig_goods.prod-type = bf-orig_parts.prod-type and                                      bf-orig_goods.prod-code = bf-orig_parts.prod-code no-lock.
     6150    open query br-cp   for each bf_parts-root where bf_parts-root.doc-code       = bf-orig_parts.out-code  and                                     bf_parts-root.orig-in-code   = bf-orig_parts.in-code   and                                     bf_parts-root.orig-gds-code  = bf-orig_goods.gds-code  and                                     bf_parts-root.orig-part-code = bf-orig_parts.part-code no-lock,       first bf-caus_parts where bf-caus_parts.out-code  = bf_parts-root.doc-code  and                                 bf-caus_parts.obj-type  = bf-orig_parts.obj-type  and                                 bf-caus_parts.obj-code  = bf-orig_parts.obj-code  and                                 bf-caus_parts.artic     = bf-orig_parts.artic     and                                 bf-caus_parts.prod-type = bf-orig_parts.prod-type and                                 bf-caus_parts.prod-code = bf-orig_parts.prod-code and                                 bf-caus_parts.in-code   = bf_parts-root.in-code   and                                 bf-caus_parts.part-code = bf_parts-root.part-code.
     6151   end.
     6152   on value-changed of browse br-op do:
     6153     open query br-cp   for each bf_parts-root where bf_parts-root.doc-code       = bf-orig_parts.out-code  and                                     bf_parts-root.orig-in-code   = bf-orig_parts.in-code   and                                     bf_parts-root.orig-gds-code  = bf-orig_goods.gds-code  and                                     bf_parts-root.orig-part-code = bf-orig_parts.part-code no-lock,       first bf-caus_parts where bf-caus_parts.out-code  = bf_parts-root.doc-code  and                                 bf-caus_parts.obj-type  = bf-orig_parts.obj-type  and                                 bf-caus_parts.obj-code  = bf-orig_parts.obj-code  and                                 bf-caus_parts.artic     = bf-orig_parts.artic     and                                 bf-caus_parts.prod-type = bf-orig_parts.prod-type and                                 bf-caus_parts.prod-code = bf-orig_parts.prod-code and                                 bf-caus_parts.in-code   = bf_parts-root.in-code   and                                 bf-caus_parts.part-code = bf_parts-root.part-code.
     6154   end.
     6155   on entry of t-doc.cli-code, r-clients in frame d-doc do:
     6156     if t-doc.cli-code <> ? then do:
     6157       assign pardoc-mode = 'ДОБАВЛЕНИЕ':U.
     6158       run UI-on in this-procedure ( input "enable" ).
     6159     end.
     6160   end.
     6161   on choose of r-clients in frame d-doc
     6162   do:
     6163     define buffer bf_clients for ub.clients.
     6164     run ref/cli-all.w (  input parparentproc
     6165                   ,  input "b-sel"
     6166                   ,  input ?
     6167                   ,  input ?
     6168                   ,  input ?
     6169                   ,  input ?
     6170                   ,  input ?
     6171                   ,  input ?
     6172                   , output ref-list ) .
     6173     if ref-list <> "" then do:
     6174       assign
     6175         ref-rec = integer (ref-list).
     6176       find first bf_clients where recid( bf_clients ) = ref-rec no-lock.
     6177       display bf_clients.obj-code @ t-doc.cli-code
     6178           bf_clients.obj-name @ clients.obj-name
     6179           bf_clients.obj-type @ t-doc.cli-type with frame d-doc.
     6180     end.
     6181     run check-cli in this-procedure no-error.
     6182     if error-status :error then do:
     6183       return no-apply.
     6184     end.
     6185   end.
     6186   on mouse-select-dblclick, return of t-doc.cli-code, t-doc.cli-type
     6187     in frame d-doc
     6188   do:
     6189     run choose-cli in this-procedure no-error.
     6190     if error-status :error then do:
     6191       display ? @ t-doc.cli-type ? @ t-doc.cli-code with frame d-doc.
     6192     end.
     6193     return no-apply.
     6194   end.
     6195   on leave of t-doc.reason-code in frame d-doc do:
     6196     run check-reason in this-procedure no-error.
     6197     if error-status :error then do: return no-apply. end.
     6198   end.
     6199   on return of t-doc.reason-code in frame d-doc do:
     6200     run check-reason in this-procedure no-error .
     6201     if error-status :error then do: return no-apply. end.
     6202   end.
     6203   on choose of r-reas in frame d-doc do:
     6204     run select-reason in this-procedure.
     6205   end.
     6206   if valid-handle(active-window) and frame d-doc:parent eq ?
     6207   then frame d-doc:parent = active-window.
     6208   on window-close of frame d-doc apply "end-error":u to self.
     6209   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6210   on help of frame d-doc
     6211   do:
     6212     run gbl/app_help.p
     6213       (input this-procedure :file-name
     6214       ,input ''
     6215       ,input ?
     6216       ) no-error.
     6217     if error-status :error then do:
     6218       message
     6219         "Ошибка при вызове помощи"
     6220         error-status :get-message(1)
     6221         view-as alert-box .
     6222     end.
     6223   end.
     6224   run minbtn-set in this-procedure .
     6225   on choose of b-help in frame d-doc
     6226   do:
     6227     apply "help":u to frame d-doc .
     6228   end.
     6229   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6230   procedure minbtn-set :
     6231       do
     6232           on error undo, return error return-value
     6233           :
     6234           define variable ii              as integer       no-undo .
     6235           define variable fh              as widget-handle no-undo .
     6236           define variable hh              as widget-handle no-undo .
     6237           define variable v-h             as handle        extent 4 no-undo .
     6238           define variable v-name-button   as character     no-undo .
     6239           define variable v-help-old-x    as decimal       no-undo .
     6240           define variable v-help-old-y    as decimal       no-undo .
     6241           define variable v-help-old-size as decimal       no-undo .
     6242           define variable v-frame-width   as decimal       no-undo .
     6243           define variable jj              as integer       no-undo .
     6244           do
     6245               on error undo, return error
     6246               :
     6247               assign
     6248                   v-frame-width = frame d-doc:width - 0.3
     6249                   fh            = frame d-doc:first-child
     6250                   hh            = fh:first-child
     6251                   ii            = 1
     6252                   .
     6253               do while valid-handle(hh):
     6254                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6255                   do:
     6256                       case lc(hh:name) :
     6257                           when "b-help" then
     6258                               do:
     6259                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6260                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6261                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6262                                   hh:TOOLTIP = "Помощь" .
     6263                                   v-help-old-x = hh:column .
     6264                                   v-help-old-y = hh:row    .
     6265                                   v-help-old-size = hh:width .
     6266                                   hh:width-chars = 2.5 .
     6267                               end.
     6268                           when "b-print" then
     6269                               do:
     6270                                   hh:load-image("cmp/b-print.bmp":u) .
     6271                                   hh:TOOLTIP = "Печать" .
     6272                                   v-h[ii] = hh:handle .
     6273                                   ii = ii + 1 .
     6274                                   hh:width-chars = 3 .
     6275                               end.
     6276                           when "b-history" or
     6277                           when "b-hist" then
     6278                               do:
     6279                                   hh:load-image("cmp/b-hist.bmp":u) .
     6280                                   hh:TOOLTIP = "История" .
     6281                                   v-h[ii] = hh:handle .
     6282                                   ii = ii + 1 .
     6283                                   hh:width-chars = 3 .
     6284                               end.
     6285                           when "b-sch" then
     6286                               do:
     6287                                   hh:load-image("cmp/b-sch.bmp":u) .
     6288                                   hh:TOOLTIP = "Установка Фильтра" .
     6289                                   v-h[ii] = hh:handle .
     6290                                   ii = ii + 1 .
     6291                                   hh:width-chars = 3 .
     6292                               end.
     6293                           when "b-hist-user" then
     6294                               do:
     6295                                   hh:load-image("cmp/b-hist.bmp":u) .
     6296                                   hh:TOOLTIP = "История пользователя" .
     6297                                   ii = ii + 1 .
     6298                               end.
     6299                       end case.
     6300                   end.
     6301                   hh = hh:next-sibling.
     6302               end.
     6303               b-help:column = v-frame-width - b-help:width-chars.
     6304               jj = 0.
     6305               repeat ii = 4 to 1 by -1 :
     6306                   if valid-handle (v-h[ii] ) then
     6307                   do:
     6308                       jj  = jj + 1 .
     6309                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6310                       v-h[ii]:row    = v-help-old-y .
     6311                   end.
     6312               end.
     6313           end.
     6314       end.
     6315   end procedure.
     6316   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     6317   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     6318   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     6319   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     6320   define variable v-diasize-current-frame-width  as decimal   no-undo .
     6321   define variable v-diasize-current-frame-height as decimal   no-undo .
     6322   define variable v-diasize-change-size          as logical   no-undo .
     6323   define variable v-diasize-resize-button        as handle    no-undo .
     6324   define variable v-diasize-wndmax               as logical   no-undo .
     6325   define variable v-diasize-wndstore             as logical   no-undo .
     6326   define variable v-diasize-proc-name            as character no-undo .
     6327   define variable v-diasize-browse-handle        as handle    no-undo .
     6328   define variable v-diasize-browse-number        as integer   no-undo .
     6329   define variable v-diasize-need-full-display    as logical   no-undo init false .
     6330   define temp-table temp-diasize-handle no-undo
     6331     field handle-value  as handle
     6332     field save-position as decimal
     6333     index xpk is primary unique handle-value
     6334     .
     6335   define temp-table temp-browse-handle no-undo
     6336     field browse-type   as character
     6337     field browse-number as integer
     6338     field browse-handle as handle
     6339     field original-size as decimal
     6340     index xpk is primary unique browse-type browse-number
     6341     index xie browse-type browse-handle
     6342   .
     6343   procedure diasize_change-height :
     6344     define input  parameter p-change-value  as decimal   no-undo .
     6345     define input  parameter p-move-resize   as logical   no-undo .
     6346     define variable v-field-group-handle    as handle    no-undo .
     6347     define variable v-object-handle         as handle    no-undo .
     6348     define variable v-frame-height          as decimal   no-undo .
     6349     define variable v-frame-virtual-height  as decimal   no-undo .
     6350     define variable v-browse-height         as decimal   no-undo .
     6351     define variable v-window-height         as decimal   no-undo .
     6352     define variable v-window-virtual-height as decimal   no-undo .
     6353     define variable v-change-sign           as integer   no-undo .
     6354     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6355     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6356     if p-change-value > 0
     6357     then do:
     6358       if frame d-doc :height + p-change-value
     6359           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     6360       then do:
     6361         assign
     6362           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     6363                           - (frame d-doc :height-chars)
     6364         .
     6365         if p-change-value <= 0
     6366         then do:
     6367           run diasize_position-resize-button in this-procedure .
     6368           return .
     6369         end.
     6370       end.
     6371     end.
     6372     if p-change-value < 0
     6373     then do:
     6374       if frame d-doc :height + p-change-value < v-diasize-orig-frame-height
     6375       then do:
     6376         assign
     6377           p-change-value = v-diasize-orig-frame-height
     6378                          - (frame d-doc :height-chars)
     6379         .
     6380         if p-change-value >= 0
     6381         then do:
     6382           run diasize_position-resize-button in this-procedure .
     6383           return .
     6384         end.
     6385       end.
     6386     end.
     6387     if p-change-value >= 0
     6388     then do:
     6389       assign
     6390         v-change-sign = 1
     6391       .
     6392     end.
     6393     else do:
     6394       assign
     6395         v-change-sign = -1
     6396       .
     6397     end.
     6398     assign
     6399       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6400     .
     6401     if p-change-value = 0
     6402     then do:
     6403       run diasize_position-resize-button in this-procedure .
     6404       return .
     6405     end.
     6406     move_block:
     6407     do
     6408     on error undo move_block, retry move_block
     6409     :
     6410       if retry
     6411       then do:
     6412         do
     6413         on error undo move_block, leave move_block
     6414         :
     6415           if p-change-value > 0
     6416           then do:
     6417             for each buf_temp-diasize-handle
     6418             on error undo, next
     6419             :
     6420               assign
     6421                 v-object-handle = buf_temp-diasize-handle.handle-value
     6422               .
     6423               if v-object-handle <> v-diasize-resize-button
     6424               then do:
     6425                 assign
     6426                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6427                 .
     6428               end.
     6429             end.
     6430             assign
     6431               v-diasize-browse-handle :height = v-browse-height
     6432             .
     6433             for each buf_temp-browse-handle
     6434               where buf_temp-browse-handle.browse-type = 'height':u
     6435             on error undo, next
     6436             :
     6437               assign
     6438                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6439               .
     6440             end.
     6441             assign
     6442               frame d-doc :height = v-frame-height
     6443             .
     6444             if frame d-doc :scrollable = true
     6445             then do:
     6446               assign
     6447                 frame d-doc :virtual-height = v-frame-virtual-height
     6448               .
     6449             end.
     6450             run diasize_position-resize-button in this-procedure .
     6451           end.
     6452           else do:
     6453             if frame d-doc :scrollable = true
     6454             then do:
     6455               assign
     6456                 frame d-doc :virtual-height = v-frame-virtual-height
     6457               .
     6458             end.
     6459             assign
     6460               frame d-doc :height = v-frame-height
     6461             .
     6462             assign
     6463               v-diasize-browse-handle :height = v-browse-height
     6464             .
     6465             for each buf_temp-browse-handle
     6466               where buf_temp-browse-handle.browse-type = 'height':u
     6467             on error undo, next
     6468             :
     6469               assign
     6470                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6471               .
     6472             end.
     6473             for each buf_temp-diasize-handle
     6474             on error undo, next
     6475             :
     6476               assign
     6477                 v-object-handle = buf_temp-diasize-handle.handle-value
     6478               .
     6479               if v-object-handle <> v-diasize-resize-button
     6480               then do:
     6481                 assign
     6482                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6483                 .
     6484               end.
     6485             end.
     6486             run diasize_position-resize-button in this-procedure .
     6487           end.
     6488           assign
     6489             v-diasize-change-size = false
     6490           .
     6491           leave move_block .
     6492         end.
     6493       end.
     6494       assign
     6495         v-diasize-need-full-display = true
     6496       .
     6497       if v-diasize-change-size = false
     6498       then do:
     6499         assign
     6500           v-diasize-change-size = true
     6501         .
     6502       end.
     6503       else do:
     6504         return .
     6505       end.
     6506       assign
     6507         v-frame-height = frame d-doc :height
     6508         v-frame-virtual-height = frame d-doc :virtual-height
     6509         v-browse-height = v-diasize-browse-handle :height
     6510       .
     6511       for each buf_temp-browse-handle
     6512         where buf_temp-browse-handle.browse-type = 'height':u
     6513       :
     6514         assign
     6515           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6516         .
     6517       end.
     6518       for each buf_temp-diasize-handle
     6519       :
     6520         delete buf_temp-diasize-handle .
     6521       end.
     6522       assign
     6523         v-field-group-handle = frame d-doc :first-child
     6524       .
     6525       do while valid-handle(v-field-group-handle)
     6526       :
     6527         assign
     6528           v-object-handle = v-field-group-handle :first-child
     6529         .
     6530         do while valid-handle(v-object-handle)
     6531         :
     6532           if  v-object-handle <> v-diasize-browse-handle :handle
     6533           and can-query(v-object-handle, "row")
     6534           and can-query(v-object-handle, "height")
     6535           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6536           then do:
     6537             find first buf_temp-browse-handle
     6538               where buf_temp-browse-handle.browse-type   = 'height':u
     6539                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6540               no-error .
     6541             if available buf_temp-browse-handle
     6542             then do:
     6543             end.
     6544             else do:
     6545               create buf_temp-diasize-handle .
     6546               assign
     6547                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6548                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6549               .
     6550             end.
     6551           end.
     6552           assign
     6553             v-object-handle = v-object-handle :next-sibling
     6554           .
     6555         end.
     6556         assign
     6557           v-field-group-handle = v-field-group-handle :next-sibling
     6558         .
     6559       end.
     6560       do with frame d-doc
     6561       :
     6562         hide v-diasize-resize-button .
     6563         assign
     6564           v-diasize-resize-button :row    = 1
     6565           v-diasize-resize-button :column = 1
     6566         .
     6567       end.
     6568       if p-change-value > 0
     6569       then do:
     6570         if frame d-doc :scrollable = true
     6571         then do:
     6572           assign
     6573             frame d-doc :virtual-height = frame d-doc :virtual-height + p-change-value
     6574             no-error .
     6575           if error-status :error
     6576           or error-status :get-message(1) <> ""
     6577           then do:
     6578             undo move_block, retry move_block .
     6579           end.
     6580         end.
     6581         assign
     6582           frame d-doc :height = frame d-doc :height + p-change-value
     6583           no-error .
     6584         if error-status :error
     6585         or error-status :get-message(1) <> ""
     6586         then do:
     6587           undo move_block, retry move_block .
     6588         end.
     6589         assign
     6590           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6591           no-error .
     6592         if error-status :error
     6593         or error-status :get-message(1) <> ""
     6594         then do:
     6595           undo move_block, retry move_block .
     6596         end.
     6597         for each buf_temp-browse-handle
     6598           where buf_temp-browse-handle.browse-type = 'height':u
     6599         on error undo move_block, retry move_block
     6600         :
     6601           assign
     6602             buf_temp-browse-handle.browse-handle :height
     6603               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6604             no-error .
     6605           if error-status :error
     6606           or error-status :get-message(1) <> ""
     6607           then do:
     6608             undo move_block, retry move_block .
     6609           end.
     6610         end.
     6611         for each buf_temp-diasize-handle
     6612         on error undo move_block, retry move_block
     6613         :
     6614           assign
     6615             v-object-handle = buf_temp-diasize-handle.handle-value
     6616           .
     6617           if v-object-handle <> v-diasize-resize-button
     6618           then do:
     6619             assign
     6620               v-object-handle :row = v-object-handle :row + p-change-value
     6621               no-error .
     6622             if error-status :error
     6623             or error-status :get-message(1) <> ""
     6624             then do:
     6625               undo move_block, retry move_block .
     6626             end.
     6627           end.
     6628         end.
     6629       end.
     6630       else do:
     6631         for each buf_temp-diasize-handle
     6632         on error undo move_block, retry move_block
     6633         :
     6634           assign
     6635             v-object-handle = buf_temp-diasize-handle.handle-value
     6636           .
     6637           if v-object-handle <> v-diasize-resize-button
     6638           then do:
     6639             assign
     6640               v-object-handle :row = v-object-handle :row + p-change-value
     6641               no-error .
     6642             if error-status :error
     6643             or error-status :get-message(1) <> ""
     6644             then do:
     6645               undo move_block, retry move_block .
     6646             end.
     6647           end.
     6648         end.
     6649         assign
     6650           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6651           no-error .
     6652         if error-status :error
     6653         or error-status :get-message(1) <> ""
     6654         then do:
     6655           undo move_block, retry move_block .
     6656         end.
     6657         for each buf_temp-browse-handle
     6658           where buf_temp-browse-handle.browse-type = 'height':u
     6659         on error undo move_block, retry move_block
     6660         :
     6661           assign
     6662             buf_temp-browse-handle.browse-handle :height
     6663               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6664             no-error .
     6665           if error-status :error
     6666           or error-status :get-message(1) <> ""
     6667           then do:
     6668             undo move_block, retry move_block .
     6669           end.
     6670         end.
     6671         assign
     6672           frame d-doc :height = frame d-doc :height + p-change-value
     6673           no-error .
     6674         if error-status :error
     6675         or error-status :get-message(1) <> ""
     6676         then do:
     6677           undo move_block, retry move_block .
     6678         end.
     6679         if frame d-doc :scrollable = true
     6680         then do:
     6681           assign
     6682             frame d-doc :virtual-height = frame d-doc :virtual-height + p-change-value
     6683             no-error .
     6684           if error-status :error
     6685           or error-status :get-message(1) <> ""
     6686           then do:
     6687             undo move_block, retry move_block .
     6688           end.
     6689         end.
     6690       end.
     6691       if p-move-resize = true
     6692       then do:
     6693         run diasize_position-resize-button in this-procedure .
     6694       end.
     6695       if v-diasize-wndstore = true
     6696       then do:
     6697         if connected("ub") = true
     6698         then do:
     6699           define variable v-cntxt-db-num        as integer   no-undo .
     6700           define variable v-cntxt-userid        as character no-undo .
     6701           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6702                                             , OUTPUT v-cntxt-userid
     6703                                             ) .
     6704           run gbl/wndsizew.p
     6705             (input  v-cntxt-db-num
     6706             ,input  v-cntxt-userid
     6707             ,input  v-diasize-proc-name
     6708             ,input  'height':u
     6709             ,input  string(frame d-doc :height - v-diasize-orig-frame-height)
     6710             ) .
     6711         end.
     6712       end.
     6713     end.
     6714     assign
     6715       v-diasize-change-size = false
     6716     .
     6717   end procedure.
     6718   procedure diasize_set-height :
     6719     define input  parameter p-new-height  as decimal   no-undo .
     6720     define input  parameter p-move-resize as logical   no-undo .
     6721     do
     6722     on error undo, return error return-value
     6723     :
     6724       run diasize_change-height in this-procedure
     6725         (input  (p-new-height - frame d-doc :height)
     6726         ,input  p-move-resize
     6727         ) .
     6728     end.
     6729   end procedure.
     6730   procedure diasize_change-width :
     6731     define input  parameter p-change-value as decimal   no-undo .
     6732     define input  parameter p-move-resize  as logical   no-undo .
     6733     define variable v-field-group-handle   as handle    no-undo .
     6734     define variable v-object-handle        as handle    no-undo .
     6735     define variable v-frame-width          as decimal   no-undo .
     6736     define variable v-frame-virtual-width  as decimal   no-undo .
     6737     define variable v-browse-width         as decimal   no-undo .
     6738     define variable v-window-width         as decimal   no-undo .
     6739     define variable v-window-virtual-width as decimal   no-undo .
     6740     define variable v-change-sign          as integer   no-undo .
     6741     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6742     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6743     if p-change-value > 0
     6744     then do:
     6745       if frame d-doc :width + p-change-value >
     6746           session :width-chars
     6747       then do:
     6748         assign
     6749           p-change-value = session :width-chars - frame d-doc :width
     6750         .
     6751         if p-change-value <= 0
     6752         then do:
     6753           run diasize_position-resize-button in this-procedure .
     6754           return .
     6755         end.
     6756       end.
     6757     end.
     6758     if p-change-value < 0
     6759     then do:
     6760       if frame d-doc :width + p-change-value < v-diasize-orig-frame-width
     6761       then do:
     6762         assign
     6763           p-change-value = v-diasize-orig-frame-width
     6764                          - frame d-doc :width
     6765         .
     6766         if p-change-value >= 0
     6767         then do:
     6768           run diasize_position-resize-button in this-procedure .
     6769           return .
     6770         end.
     6771       end.
     6772     end.
     6773     if p-change-value >= 0
     6774     then do:
     6775       assign
     6776         v-change-sign = 1
     6777       .
     6778     end.
     6779     else do:
     6780       assign
     6781         v-change-sign = -1
     6782       .
     6783     end.
     6784     assign
     6785       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6786     .
     6787     if p-change-value = 0
     6788     then do:
     6789       run diasize_position-resize-button in this-procedure .
     6790       return .
     6791     end.
     6792     move_block:
     6793     do
     6794     on error undo move_block, leave move_block
     6795     :
     6796       if retry
     6797       then do:
     6798         do
     6799         on error undo move_block, leave move_block
     6800         :
     6801           if p-change-value > 0
     6802           then do:
     6803             for each buf_temp-diasize-handle
     6804             on error undo, next
     6805             :
     6806               assign
     6807                 v-object-handle = buf_temp-diasize-handle.handle-value
     6808               .
     6809               if v-object-handle <> v-diasize-resize-button
     6810               then do:
     6811                 assign
     6812                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6813                 .
     6814               end.
     6815             end.
     6816             assign
     6817               v-diasize-browse-handle :width = v-browse-width
     6818             .
     6819             for each buf_temp-browse-handle
     6820               where buf_temp-browse-handle.browse-type = 'width':u
     6821             on error undo, next
     6822             :
     6823               assign
     6824                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6825               .
     6826             end.
     6827             assign
     6828               frame d-doc :width = v-frame-width
     6829             .
     6830             if frame d-doc :scrollable = true
     6831             then do:
     6832               assign
     6833                 frame d-doc :virtual-width = v-frame-virtual-width
     6834               .
     6835             end.
     6836             run diasize_position-resize-button in this-procedure .
     6837           end.
     6838           else do:
     6839             if frame d-doc :scrollable = true
     6840             then do:
     6841               assign
     6842                 frame d-doc :virtual-width = v-frame-virtual-width
     6843               .
     6844             end.
     6845             assign
     6846               frame d-doc :width = v-frame-width
     6847             .
     6848             for each buf_temp-browse-handle
     6849               where buf_temp-browse-handle.browse-type = 'width':u
     6850             on error undo, next
     6851             :
     6852               assign
     6853                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6854               .
     6855             end.
     6856             assign
     6857               v-diasize-browse-handle :width = v-browse-width
     6858             .
     6859             for each buf_temp-diasize-handle
     6860             on error undo, next
     6861             :
     6862               assign
     6863                 v-object-handle = buf_temp-diasize-handle.handle-value
     6864               .
     6865               if v-object-handle <> v-diasize-resize-button
     6866               then do:
     6867                 assign
     6868                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6869                 .
     6870               end.
     6871             end.
     6872             run diasize_position-resize-button in this-procedure .
     6873           end.
     6874           assign
     6875             v-diasize-change-size = false
     6876           .
     6877           leave move_block .
     6878         end.
     6879       end.
     6880       assign
     6881         v-diasize-need-full-display = true
     6882       .
     6883       if v-diasize-change-size = false
     6884       then do:
     6885         assign
     6886           v-diasize-change-size = true
     6887         .
     6888       end.
     6889       else do:
     6890         return .
     6891       end.
     6892       assign
     6893         v-frame-width = frame d-doc :width
     6894         v-frame-virtual-width = frame d-doc :virtual-width
     6895         v-browse-width = v-diasize-browse-handle :width
     6896       .
     6897       for each buf_temp-browse-handle
     6898         where buf_temp-browse-handle.browse-type = 'width':u
     6899       :
     6900         assign
     6901           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6902         .
     6903       end.
     6904       for each buf_temp-diasize-handle
     6905       :
     6906         delete buf_temp-diasize-handle .
     6907       end.
     6908       assign
     6909         v-field-group-handle = frame d-doc :first-child
     6910       .
     6911       do while valid-handle(v-field-group-handle)
     6912       :
     6913         assign
     6914           v-object-handle = v-field-group-handle :first-child
     6915         .
     6916         do while valid-handle(v-object-handle)
     6917         :
     6918           if  v-object-handle <> v-diasize-browse-handle :handle
     6919           and v-object-handle <> v-diasize-resize-button
     6920           and can-query(v-object-handle, "row")
     6921           and can-query(v-object-handle, "height")
     6922           and ( v-object-handle :col + v-object-handle :width
     6923                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6924               )
     6925           then do:
     6926             find first buf_temp-browse-handle
     6927               where buf_temp-browse-handle.browse-type   = 'width':u
     6928                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6929               no-error .
     6930             if available buf_temp-browse-handle
     6931             then do:
     6932             end.
     6933             else do:
     6934               create buf_temp-diasize-handle .
     6935               assign
     6936                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6937                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6938               .
     6939             end.
     6940           end.
     6941           assign
     6942             v-object-handle = v-object-handle :next-sibling
     6943           .
     6944         end.
     6945         assign
     6946           v-field-group-handle = v-field-group-handle :next-sibling
     6947         .
     6948       end.
     6949       do with frame d-doc
     6950       :
     6951         hide v-diasize-resize-button .
     6952         v-diasize-resize-button :row = 1.
     6953         v-diasize-resize-button :column = 1.
     6954       end.
     6955       if p-change-value > 0
     6956       then do:
     6957         if frame d-doc :scrollable = true
     6958         then do:
     6959           assign
     6960             frame d-doc :virtual-width = frame d-doc :virtual-width + p-change-value
     6961             no-error .
     6962           if error-status :error
     6963           or error-status :get-message(1) <> ""
     6964           then do:
     6965             undo move_block, retry move_block.
     6966           end.
     6967         end.
     6968         assign
     6969           frame d-doc :width = v-frame-width + p-change-value
     6970           no-error .
     6971         if error-status :error
     6972         or error-status :get-message(1) <> ""
     6973         then do:
     6974           undo move_block, retry move_block.
     6975         end.
     6976         assign
     6977           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6978         no-error .
     6979         if error-status :error
     6980         or error-status :get-message(1) <> ""
     6981         then do:
     6982           undo move_block, retry move_block.
     6983         end.
     6984         for each buf_temp-browse-handle
     6985           where buf_temp-browse-handle.browse-type = 'width':u
     6986         on error undo move_block, retry move_block
     6987         :
     6988           assign
     6989             buf_temp-browse-handle.browse-handle :width
     6990               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6991             no-error .
     6992           if error-status :error
     6993           or error-status :get-message(1) <> ""
     6994           then do:
     6995             undo move_block, retry move_block .
     6996           end.
     6997         end.
     6998         for each buf_temp-diasize-handle
     6999         on error undo move_block, retry move_block
     7000         :
     7001           assign
     7002             v-object-handle = buf_temp-diasize-handle.handle-value
     7003           .
     7004           if v-object-handle <> v-diasize-resize-button
     7005           then do:
     7006             assign
     7007               v-object-handle :col = v-object-handle :col + p-change-value
     7008               no-error .
     7009             if error-status :error
     7010             or error-status :get-message(1) <> ""
     7011             then do:
     7012               undo move_block, retry move_block .
     7013             end.
     7014           end.
     7015         end.
     7016       end.
     7017       else do:
     7018         for each buf_temp-diasize-handle
     7019         on error undo move_block, retry move_block
     7020         :
     7021           assign
     7022             v-object-handle = buf_temp-diasize-handle.handle-value
     7023           .
     7024           if v-object-handle <> v-diasize-resize-button
     7025           then do:
     7026             assign
     7027               v-object-handle :col = v-object-handle :col + p-change-value
     7028               no-error .
     7029             if error-status :error
     7030             or error-status :get-message(1) <> ""
     7031             then do:
     7032               undo move_block, retry move_block .
     7033             end.
     7034           end.
     7035         end.
     7036         for each buf_temp-browse-handle
     7037           where buf_temp-browse-handle.browse-type = 'width':u
     7038         on error undo move_block, retry move_block
     7039         :
     7040           assign
     7041             buf_temp-browse-handle.browse-handle :width
     7042               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7043             no-error .
     7044           if error-status :error
     7045           or error-status :get-message(1) <> ""
     7046           then do:
     7047             undo move_block, retry move_block .
     7048           end.
     7049         end.
     7050         assign
     7051           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     7052           no-error .
     7053         if error-status :error
     7054         or error-status :get-message(1) <> ""
     7055         then do:
     7056           undo move_block, retry move_block.
     7057         end.
     7058         assign
     7059           frame d-doc :width = frame d-doc :width + p-change-value
     7060         no-error .
     7061         if error-status :error
     7062         or error-status :get-message(1) <> ""
     7063         then do:
     7064           undo move_block, retry move_block.
     7065         end.
     7066         if frame d-doc :scrollable = true
     7067         then do:
     7068           assign
     7069             frame d-doc :virtual-width = frame d-doc :virtual-width + p-change-value
     7070           no-error .
     7071           if error-status :error
     7072           or error-status :get-message(1) <> ""
     7073           then do:
     7074             undo move_block, retry move_block.
     7075           end.
     7076         end.
     7077       end.
     7078       if p-move-resize
     7079       then do:
     7080         run diasize_position-resize-button in this-procedure .
     7081       end.
     7082       if v-diasize-wndstore = true
     7083       then do:
     7084         if connected("ub") = true
     7085         then do:
     7086           define variable v-cntxt-db-num        as integer   no-undo .
     7087           define variable v-cntxt-userid        as character no-undo .
     7088           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7089                                             , OUTPUT v-cntxt-userid
     7090                                             ) .
     7091           run gbl/wndsizew.p
     7092             (input  v-cntxt-db-num
     7093             ,input  v-cntxt-userid
     7094             ,input  v-diasize-proc-name
     7095             ,input  'width':u
     7096             ,input  string(frame d-doc :width - v-diasize-orig-frame-width)
     7097             ) .
     7098         end.
     7099       end.
     7100     end.
     7101     assign
     7102       v-diasize-change-size = false
     7103     .
     7104   end procedure.
     7105   procedure diasize_set-width :
     7106     define input  parameter p-new-width  as decimal   no-undo .
     7107     define input  parameter p-move-resize as logical   no-undo .
     7108     do
     7109     on error undo, return error return-value
     7110     :
     7111       run diasize_change-width in this-procedure
     7112         (input  (p-new-width - frame d-doc :width)
     7113         ,input  p-move-resize
     7114         ) .
     7115     end.
     7116   end procedure.
     7117   procedure diasize_position-resize-button :
     7118     do with frame d-doc
     7119     :
     7120       hide v-diasize-resize-button .
     7121       assign
     7122         v-diasize-resize-button :row = frame d-doc :height - v-diasize-resize-button :height
     7123                     - 1
     7124                     - (frame d-doc :border-bottom-pixels / session :pixels-per-row)
     7125         v-diasize-resize-button :col = frame d-doc :width - v-diasize-resize-button :width
     7126                     - 1
     7127                     - (frame d-doc :border-right-pixels / session :pixels-per-column)
     7128       .
     7129       view v-diasize-resize-button .
     7130     end.
     7131   end procedure.
     7132   on alt-right anywhere
     7133   do:
     7134     run diasize_change-width in this-procedure
     7135       (input 1
     7136       ,input true
     7137       ) .
     7138     return no-apply .
     7139   end.
     7140   on alt-left anywhere
     7141   do:
     7142     run diasize_change-width in this-procedure
     7143       (input -1
     7144       ,input true
     7145       ) .
     7146     return no-apply .
     7147   end.
     7148   on alt-down anywhere
     7149   do:
     7150     run diasize_change-height in this-procedure
     7151       (input 1
     7152       ,input true
     7153       ) .
     7154     return no-apply .
     7155   end.
     7156   on alt-up anywhere
     7157   do:
     7158     run diasize_change-height in this-procedure
     7159       (input -1
     7160       ,input true
     7161       ) .
     7162     return no-apply .
     7163   end.
     7164   on alt-enter of frame d-doc
     7165   do:
     7166     run diasize_maximize in this-procedure
     7167       (input  ?
     7168       ).
     7169     return no-apply .
     7170   end.
     7171   procedure diasize_end-move :
     7172     do
     7173     on error undo, return error return-value
     7174     :
     7175       define variable v-row-delta as decimal   no-undo .
     7176       define variable v-col-delta as decimal   no-undo .
     7177       define variable v-new-row as decimal   no-undo .
     7178       define variable v-new-col as decimal   no-undo .
     7179       assign
     7180         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     7181         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     7182       .
     7183       assign
     7184         v-row-delta = v-new-row - frame d-doc :height
     7185         v-col-delta = v-new-col - frame d-doc :width
     7186       .
     7187       run diasize_change-height in this-procedure
     7188         (input v-row-delta
     7189         ,input true
     7190         ) .
     7191       run diasize_change-width in this-procedure
     7192         (input v-col-delta
     7193         ,input true
     7194         ) .
     7195     end.
     7196   end procedure.
     7197   procedure diasize_maximize :
     7198     define input  parameter p-action as logical   no-undo .
     7199     do
     7200     on error undo, return error return-value
     7201     :
     7202       if p-action = ?
     7203       then do:
     7204         if v-diasize-need-maximize = true
     7205         then do:
     7206           assign
     7207             p-action = true
     7208           .
     7209         end.
     7210         else do:
     7211           assign
     7212             p-action = false
     7213           .
     7214         end.
     7215       end.
     7216       if p-action = true
     7217       then do:
     7218         run diasize_change-height in this-procedure
     7219           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     7220               - frame d-doc :height-chars
     7221           ,input true
     7222           ) .
     7223         run diasize_change-width in this-procedure
     7224           (input session :width-chars
     7225               - frame d-doc :width-chars
     7226           ,input true
     7227           ) .
     7228         assign
     7229           v-diasize-need-maximize = false
     7230         .
     7231       end.
     7232       else do:
     7233         run diasize_change-width in this-procedure
     7234           (input v-diasize-orig-frame-width
     7235               - frame d-doc :width-chars
     7236           ,input true
     7237           ) .
     7238         run diasize_change-height in this-procedure
     7239           (input v-diasize-orig-frame-height
     7240               - frame d-doc :height-chars
     7241           ,input true
     7242           ) .
     7243         assign
     7244           v-diasize-need-maximize = true
     7245         .
     7246       end.
     7247     end.
     7248   end procedure.
     7249   procedure diasize_restore-orig-size :
     7250     do
     7251     on error undo, return error return-value
     7252     :
     7253       assign
     7254         v-diasize-current-frame-width  = frame d-doc :width
     7255         v-diasize-current-frame-height = frame d-doc :height
     7256       .
     7257       run diasize_set-height in this-procedure
     7258         (input  v-diasize-orig-frame-height
     7259         ,input  true
     7260         ) .
     7261       run diasize_set-width in this-procedure
     7262         (input  v-diasize-orig-frame-width
     7263         ,input  true
     7264         ) .
     7265     end.
     7266   end procedure.
     7267   procedure diasize_restore-current-size :
     7268     do
     7269     on error undo, return error return-value
     7270     :
     7271       run diasize_set-height in this-procedure
     7272         (input  v-diasize-current-frame-height
     7273         ,input  true
     7274         ) .
     7275       run diasize_set-width in this-procedure
     7276         (input  v-diasize-current-frame-width
     7277         ,input  true
     7278         ) .
     7279     end.
     7280   end procedure.
     7281   procedure diasize_set-browse-handle :
     7282     define input  parameter p-browse-handle as handle   no-undo .
     7283     define buffer buf_temp-browse-handle for temp-browse-handle .
     7284     do
     7285     on error undo, return error return-value
     7286     :
     7287       assign
     7288         v-diasize-browse-handle = p-browse-handle
     7289       .
     7290       for each buf_temp-browse-handle
     7291       on error undo, return error return-value
     7292       :
     7293         delete buf_temp-browse-handle .
     7294       end.
     7295     end.
     7296   end procedure.
     7297   procedure diasize_add_browse :
     7298     define input  parameter p-browse-type   as character no-undo .
     7299     define input  parameter p-browse-handle as handle    no-undo .
     7300     define buffer buf_temp-browse-handle for temp-browse-handle .
     7301     do
     7302     on error undo, return error return-value
     7303     :
     7304       assign
     7305         v-diasize-browse-number = v-diasize-browse-number + 1
     7306       .
     7307       create buf_temp-browse-handle .
     7308       assign
     7309         buf_temp-browse-handle.browse-type   = p-browse-type
     7310         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     7311         buf_temp-browse-handle.browse-handle = p-browse-handle
     7312       .
     7313     end.
     7314   end procedure.
     7315   procedure diasize_init :
     7316     define variable v-default-value    as logical   no-undo .
     7317     define variable v-restore-saved    as logical   no-undo .
     7318     define variable v-resize-value-str as character no-undo .
     7319     do
     7320     on error undo, return error return-value
     7321     :
     7322       do with frame d-doc
     7323       :
     7324         assign
     7325           v-diasize-orig-frame-height = frame d-doc :height
     7326           v-diasize-orig-frame-width  = frame d-doc :width
     7327           v-diasize-browse-handle     = browse br :handle
     7328         .
     7329         create button v-diasize-resize-button
     7330         assign
     7331           parent        = frame d-doc :first-child
     7332           label         = "s"
     7333           height-pixels = 16
     7334           width-pixels  = 16
     7335           visible       = true
     7336           sensitive     = true
     7337           movable       = true
     7338           triggers:
     7339             on end-move persistent run diasize_end-move in this-procedure .
     7340           end triggers.
     7341         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     7342         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     7343         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     7344         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     7345         assign
     7346           v-diasize-wndmax = false
     7347         .
     7348         if connected("ub") = true
     7349         then do:
     7350           define variable v-cntxt-db-num        as integer   no-undo .
     7351           define variable v-cntxt-userid        as character no-undo .
     7352           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7353                                             , OUTPUT v-cntxt-userid
     7354                                             ) .
     7355           run gbl/wndpar_r.p
     7356             (input  v-cntxt-db-num
     7357             ,input  v-cntxt-userid
     7358             ,input  'wndmax':U
     7359             ,output v-diasize-wndmax
     7360             ,output v-default-value
     7361             ) .
     7362         end.
     7363         assign
     7364           v-diasize-wndstore = false
     7365         .
     7366         if connected("ub") = true
     7367         then do:
     7368           run gbl/wndpar_r.p
     7369             (input  v-cntxt-db-num
     7370             ,input  v-cntxt-userid
     7371             ,input  'wndstore':U
     7372             ,output v-diasize-wndstore
     7373             ,output v-default-value
     7374             ) .
     7375         end.
     7376         assign
     7377           v-diasize-proc-name = entry(1, program-name(2), '.')
     7378         .
     7379         if v-diasize-wndstore = true
     7380         then do:
     7381           assign
     7382             v-restore-saved = false
     7383           .
     7384           if connected("ub") = true
     7385           then do:
     7386             run gbl/wndsizer.p
     7387               (input  v-cntxt-db-num
     7388               ,input  v-cntxt-userid
     7389               ,input  v-diasize-proc-name
     7390               ,input  'height':u
     7391               ,output v-resize-value-str
     7392               ) .
     7393             if v-resize-value-str <> '':U
     7394             then do:
     7395               run diasize_change-height in this-procedure
     7396                 (input  integer(v-resize-value-str)
     7397                 ,input  true
     7398                 ) .
     7399               assign
     7400                 v-restore-saved = true
     7401               .
     7402             end.
     7403           end.
     7404           if connected("ub") = true
     7405           then do:
     7406             run gbl/wndsizer.p
     7407               (input  v-cntxt-db-num
     7408               ,input  v-cntxt-userid
     7409               ,input  v-diasize-proc-name
     7410               ,input  'width':u
     7411               ,output v-resize-value-str
     7412               ) .
     7413             if v-resize-value-str <> '':U
     7414             then do:
     7415               run diasize_change-width in this-procedure
     7416                 (input  integer(v-resize-value-str)
     7417                 ,input  true
     7418                 ) .
     7419               assign
     7420                 v-restore-saved = true
     7421               .
     7422             end.
     7423           end.
     7424           if v-restore-saved <> true
     7425           then do:
     7426             if v-diasize-wndmax = true
     7427             then do:
     7428               run diasize_maximize in this-procedure
     7429                 (input  true
     7430                 ) .
     7431             end.
     7432           end.
     7433         end.
     7434         else do:
     7435           if v-diasize-wndmax = true
     7436           then do:
     7437             run diasize_maximize in this-procedure
     7438               (input  true
     7439               ) .
     7440           end.
     7441         end.
     7442       end.
     7443     end.
     7444   end procedure.
     7445   procedure diasize_need-full-display :
     7446     define output parameter p-need-full-display as logical   no-undo .
     7447     do
     7448     on error undo, return error return-value
     7449     :
     7450       assign
     7451         p-need-full-display = v-diasize-need-full-display
     7452       .
     7453       assign
     7454         v-diasize-need-full-display = false
     7455       .
     7456     end.
     7457   end procedure.
     7458   procedure get-context :
     7459      define output parameter p-db-num as integer          no-undo.
     7460      define output parameter p-user-id as character        no-undo.
     7461      define variable v-login               as character    no-undo.
     7462      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7463      define buffer buf_user-login  for ub.user-login .
     7464      do
     7465      on error undo, return error
     7466      :
     7467            FIND FIRST buf_sys-ctrl no-lock.
     7468            ASSIGN
     7469               v-login = USERID("ub")
     7470               p-db-num = buf_sys-ctrl.db-num
     7471            .
     7472            FIND FIRST buf_user-login
     7473                 WHERE buf_user-login.db-num = p-db-num
     7474                   AND buf_user-login.user-login = v-login
     7475                 no-lock
     7476                 no-error
     7477                 .
     7478            IF AVAILABLE buf_user-login
     7479            THEN DO:
     7480               assign
     7481                  p-user-id = buf_user-login.user-id
     7482               .
     7483            END.
     7484      end.
     7485   end procedure.
     7486   run diasize_add_browse in this-procedure
     7487     (input  'width':u
     7488     ,input  browse br-op :handle
     7489     ) .
     7490   run diasize_add_browse in this-procedure
     7491     (input  'width':u
     7492     ,input  browse br-cp :handle
     7493     ) .
     7494   run diasize_init in this-procedure .
     7495   assign
     7496     parnext-prev = yes.
     7497   n-p:
     7498   do while parnext-prev :
     7499     assign
     7500       parext-doc-mode =
     7501         ( if num-entries( pardoc-mode, '*':U ) > 1 then entry( 2, pardoc-mode, '*':U ) else '':U )
     7502       pardoc-mode     = entry( 1, pardoc-mode, '*':U )
     7503     .
     7504     if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.
     7505     main-block:
     7506     do on error undo main-block, leave main-block :
     7507       define variable varroad-tax-label as character no-undo.
     7508       run tax-name in this-procedure ( input 'rdt':U, output varroad-tax-label ) no-error.
     7509       if error-status :error then do:
     7510         assign
     7511           parnext-prev = no.
     7512         return error.
     7513       end.
     7514       assign
     7515         bf-expp_doc-line-sum.cost-road-tax-rubl:label in browse br =  "Расход <" + varroad-tax-label + "> (руб)"
     7516         bf-expp_doc-line-sum.cost-road-tax-base:label in browse br =  "Расход <" + varroad-tax-label + "> (вал)"
     7517         bf-incp_doc-line-sum.cost-road-tax-rubl:label in browse br =  "Приход <" + varroad-tax-label + "> (руб)"
     7518         bf-incp_doc-line-sum.cost-road-tax-base:label in browse br =  "Приход <" + varroad-tax-label + "> (вал)"
     7519       .
     7520       assign
     7521         bf-orig_parts.road-tax-rubl:label in browse br-op = varroad-tax-label + "(руб)"
     7522         bf-orig_parts.road-tax-base:label in browse br-op = varroad-tax-label + "(вал)"
     7523         bf-caus_parts.road-tax-rubl:label in browse br-cp = varroad-tax-label + "(руб)"
     7524         bf-caus_parts.road-tax-base:label in browse br-cp = varroad-tax-label + "(вал)"
     7525       .
     7526        run mode-on in this-procedure no-error.
     7527        if error-status :error then do:
     7528          assign
     7529            parnext-prev = no.
     7530          return error.
     7531        end.
     7532        run ui-on in this-procedure ( input "enable":U ) no-error.
     7533        if error-status:error then do:
     7534          assign
     7535            parnext-prev = no.
     7536          return error.
     7537        end.
     7538        find first bf_sysconf where bf_sysconf.host-code = t-doc.host-code no-lock.
     7539        if pardoc-mode = 'ПРОСМОТР':U then do:
     7540          wait-for go of frame d-doc focus b-lkp.
     7541        end.
     7542        else do:
     7543          if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     7544            wait-for go of frame d-doc focus t-doc.cli-code.
     7545          end.
     7546          else do:
     7547            wait-for go of frame d-doc focus b-add.
     7548          end.
     7549        end.
     7550     end.
     7551   end.
     7552   run disable_ui in this-procedure.
     7553   procedure disable_ui :
     7554     hide frame d-doc.
     7555   end procedure.
     7556   procedure ui-on :
     7557     define input parameter fnc as character no-undo.
     7558     define buffer bf-expp_trn-doc-sum  for ub.trn-doc-sum.
     7559     define buffer bf-incp_trn-doc-sum  for ub.trn-doc-sum.
     7560     do on error undo, return error return-value :
     7561       for each tt-del-list-op on error undo, return error return-value :
     7562         delete tt-del-list-op.
     7563       end.
     7564       for each tt-del-list on error undo, return error return-value :
     7565         delete tt-del-list.
     7566       end.
     7567       if fnc = "enable":U then do:
     7568         assign
     7569           bf_doc-line.prod-code:read-only    in browse br    = yes
     7570           bf-orig_parts.qnty:read-only in browse br-op = yes
     7571           bf-caus_parts.qnty:read-only in browse br-cp = yes.
     7572         disable all with frame d-doc.
     7573         enable b-exit b-lkp b-lkp-op b-lkp-cp b-help
     7574                br br-op br-cp
     7575                b-arch b-cnt b-history b-notes
     7576         with frame d-doc.
     7577         if pardoc-mode <> 'ПРОСМОТР':U or pardoc-mode = 'ПРОСМОТР':U and parext-doc-mode = "reason-code" then do:
     7578           enable r-reas t-doc.reason-code with frame d-doc.
     7579         end.
     7580         case pardoc-mode :
     7581           when 'ПРОСМОТР':U then do:
     7582             enable b-prev b-next with frame d-doc.
     7583           end.
     7584           when 'ДОБАВЛЕНИЕ':U then do:
     7585             enable t-doc.cli-code t-doc.cli-type r-clients with frame d-doc.
     7586           end.
     7587           otherwise do:
     7588             enable b-add b-chg b-chgvat b-del b-mark b-file
     7589                    b-mark-op
     7590                    b-chg-cp
     7591                    t-doc.wrkr t-doc.agnt t-doc.boss
     7592                    r-wrkr r-agnt r-boss
     7593             with frame d-doc.
     7594   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7595   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     7596     (input  t-doc.obj-type
     7597     ,input  t-doc.obj-code
     7598     ,input  'shift-on=request'
     7599     ,output varlog
     7600     ) no-error .
     7601             if error-status :error then do:
     7602               message
     7603               vss-workfile vss-revision vss-description skip
     7604               "Ошибка при запуске процедуры objat" skip
     7605               error-status :get-message(1) skip
     7606               return-value skip
     7607               view-as alert-box error .
     7608               return error.
     7609             end.
     7610             if not varlog then do:
     7611              hide t-doc.shift-date t-doc.shift-num t-doc.shift-name  in frame d-doc.
     7612             end.
     7613           end.
     7614         end case.
     7615       end.
     7616       find first bf-expp_trn-doc-sum no-lock where
     7617                  bf-expp_trn-doc-sum.doc-code = t-doc.doc-code       and
     7618                  bf-expp_trn-doc-sum.sum-type = 'exp':U no-error.
     7619       find first bf-incp_trn-doc-sum no-lock where
     7620                  bf-incp_trn-doc-sum.doc-code = t-doc.doc-code       and
     7621                  bf-incp_trn-doc-sum.sum-type = 'inp':U  no-error.
     7622       display
     7623         ( if available bf-expp_trn-doc-sum then bf-expp_trn-doc-sum.cost-sum-rubl else ? ) @ varsum-exp-rubl
     7624         ( if available bf-incp_trn-doc-sum then bf-incp_trn-doc-sum.cost-sum-rubl else ? ) @ varsum-inc-rubl
     7625         ( if available bf-expp_trn-doc-sum then bf-expp_trn-doc-sum.cost-sum-base else ? ) @ varsum-exp-base
     7626         ( if available bf-incp_trn-doc-sum then bf-incp_trn-doc-sum.cost-sum-base else ? ) @ varsum-inc-base
     7627         ( if available bf-expp_trn-doc-sum then bf-expp_trn-doc-sum.cost-vat-rubl else ? ) @ varvat-exp-rubl
     7628         ( if available bf-incp_trn-doc-sum then bf-incp_trn-doc-sum.cost-vat-rubl else ? ) @ varvat-inc-rubl
     7629         ( if available bf-expp_trn-doc-sum then bf-expp_trn-doc-sum.cost-vat-base else ? ) @ varvat-exp-base
     7630         ( if available bf-incp_trn-doc-sum then bf-incp_trn-doc-sum.cost-vat-base else ? ) @ varvat-inc-base
     7631       with frame d-doc.
     7632       display t-doc.doc-date t-doc.fact-date t-doc.shift-date t-doc.shift-num t-doc.shift-name
     7633               t-doc.fact-rubl
     7634               t-doc.fact-base
     7635               t-doc.cli-type t-doc.cli-code
     7636               varcntr-prn-code
     7637               varcntr-name
     7638       with frame d-doc.
     7639       find first clients where
     7640                  clients.obj-type = t-doc.cli-type and
     7641                  clients.obj-code = t-doc.cli-code no-error.
     7642       if available clients then do:
     7643         display clients.obj-name with frame d-doc.
     7644       end.
     7645       find ub.trn-reason no-lock where
     7646            ub.trn-reason.reason-code = t-doc.reason-code no-error.
     7647       assign
     7648         rsn-name = ( if available ub.trn-reason then ub.trn-reason.reason-name else "":U )
     7649       .
     7650       display t-doc.reason-code rsn-name with frame d-doc.
     7651       assign
     7652         frame d-doc :title = t-doc.obj-type + " " + string( t-doc.obj-code, ">>>>9":U ) + "  : КОРРЕКЦИЯ " +
     7653         ( if t-doc.ext-doc-type = 'ap':U   then "УЧЕТНЫХ ЦЕН "         else
     7654         ( if t-doc.ext-doc-type = 'mp':U then "ОТРИЦАТЕЛЬНЫХ ПАРТИЙ" else "ТИПА ПРИОБРЕТЕНИЯ" ) ) +
     7655         t-doc.status_ + " " + string( t-doc.flag_, "+/-":U ) + " № " + t-doc.doc-code + "   - ".
     7656       assign frame d-doc :title = frame d-doc :title +
     7657         ( if parext-doc-mode = ""            then title-mode( pardoc-mode ) else ( caps( 'редакт-факт':U ) +
     7658         ( if parext-doc-mode = "reason-code" then " кода основания"         else "":U ) ) ).
     7659       display t-doc.wrkr t-doc.agnt t-doc.boss with frame d-doc.
     7660     define variable v-ref-rec58   as recid no-undo .
     7661     find cli-buf where cli-buf.obj-code = input frame d-doc t-doc.wrkr
     7662                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     7663   if not available cli-buf then do:
     7664     display t-doc.wrkr with frame d-doc.
     7665     find cli-buf no-lock where cli-buf.obj-code = input frame d-doc t-doc.wrkr
     7666                            and cli-buf.obj-type = 'чел':U no-error.
     7667   end.
     7668   if available cli-buf then do:
     7669         display cli-buf.obj-code @ t-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-doc.
     7670     end.
     7671     else display ? @ t-doc.wrkr ? @ wrkr-name with frame d-doc.
     7672     define variable v-ref-rec59   as recid no-undo .
     7673     find cli-buf where cli-buf.obj-code = input frame d-doc t-doc.agnt
     7674                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     7675   if not available cli-buf then do:
     7676     display t-doc.agnt with frame d-doc.
     7677     find cli-buf no-lock where cli-buf.obj-code = input frame d-doc t-doc.agnt
     7678                            and cli-buf.obj-type = 'чел':U no-error.
     7679   end.
     7680   if available cli-buf then do:
     7681         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-doc.
     7682     end.
     7683     else display ? @ t-doc.agnt ? @ agnt-name with frame d-doc.
     7684     define variable v-ref-rec60   as recid no-undo .
     7685     find cli-buf where cli-buf.obj-code = input frame d-doc t-doc.boss
     7686                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     7687   if not available cli-buf then do:
     7688     display t-doc.boss with frame d-doc.
     7689     find cli-buf no-lock where cli-buf.obj-code = input frame d-doc t-doc.boss
     7690                            and cli-buf.obj-type = 'чел':U no-error.
     7691   end.
     7692   if available cli-buf then do:
     7693         display cli-buf.obj-code @ t-doc.boss cli-buf.obj-name @ boss-name with frame d-doc.
     7694     end.
     7695     else display ? @ t-doc.boss ? @ boss-name with frame d-doc.
     7696       run open-all-browse in this-procedure.
     7697     end.
     7698   end procedure.
     7699   procedure mark-list:
     7700   do on error undo, return error return-value :
     7701   if not available bf_doc-line then do:
     7702     message "Неправильный выбор строки.".
     7703     return no-apply.
     7704   end.
     7705   find first tt-del-list where tt-del-list.rec-id = recid( bf_doc-line ) no-error.
     7706   if available tt-del-list then do:
     7707     delete tt-del-list.
     7708   end.
     7709   else do:
     7710     create tt-del-list.
     7711     assign
     7712       tt-del-list.rec-id = recid( bf_doc-line ).
     7713   end.
     7714   br:refresh() in frame d-doc.
     7715   varlog = br:select-next-row () in frame d-doc.
     7716   apply "entry" to br in frame d-doc.
     7717   end.
     7718   end procedure.
     7719   procedure mark-list-op:
     7720   do on error undo, return error return-value :
     7721   if not available bf-orig_parts then do:
     7722     message "Неправильный выбор строки.".
     7723     return no-apply.
     7724   end.
     7725   find first tt-del-list-op where tt-del-list-op.rec-id = recid( bf-orig_parts ) no-error.
     7726   if available tt-del-list-op then do:
     7727     delete tt-del-list-op.
     7728   end.
     7729   else do:
     7730     create tt-del-list-op.
     7731     assign
     7732       tt-del-list-op.rec-id = recid( bf-orig_parts ).
     7733   end.
     7734   br-op:refresh() in frame d-doc.
     7735   varlog = br-op:select-next-row () in frame d-doc.
     7736   apply "entry" to br-op in frame d-doc.
     7737   end.
     7738   end procedure.
     7739   procedure local-del:
     7740   define output parameter parrep-rec as recid no-undo.
     7741   define variable vartemp-rec as recid no-undo.
     7742   define buffer bf-del_doc-line   for ub.doc-line.
     7743   define buffer bf-del-orig_parts for ub.parts.
     7744   do on error undo, return error return-value :
     7745   find first tt-del-list no-error.
     7746   if not available tt-del-list then do:
     7747     if not available bf_doc-line then do:
     7748       message "Неправильный выбор строки.".
     7749       return error.
     7750     end.
     7751     assign
     7752       varlog = no.
     7753     message "Удалить строку из документа? Вы уверены?"
     7754             view-as alert-box question buttons ok-cancel update varlog.
     7755     if not varlog then return error.
     7756     assign
     7757       vartemp-rec =  recid( bf_doc-line ).
     7758     create tt-del-list.
     7759       assign
     7760       tt-del-list.rec-id = recid( bf_doc-line ).
     7761     get next br.
     7762     if available bf_doc-line then do:
     7763       assign
     7764         parrep-rec = recid( bf_doc-line ).
     7765     end.
     7766     else do:
     7767       reposition br to recid vartemp-rec no-error.
     7768       get prev br.
     7769       assign
     7770         parrep-rec = recid( bf_doc-line ).
     7771     end.
     7772   end.
     7773   else do:
     7774     assign
     7775       varlog = no.
     7776     message "УДАЛИТЬ ВСЕ ОТМЕЧЕННЫЕ строки документа? Вы уверены ?"
     7777     view-as alert-box question buttons ok-cancel update varlog.
     7778     if not varlog then do:
     7779       return error.
     7780     end.
     7781     assign
     7782       parrep-rec = ?.
     7783   end.
     7784   for each tt-del-list on error undo, return error return-value :
     7785     find first bf-del_doc-line where recid( bf-del_doc-line ) = tt-del-list.rec-id exclusive-lock no-error.
     7786     if not available bf-del_doc-line then do:
     7787       message
     7788         vss-workfile vss-revision vss-description skip
     7789         "Ошибка при удалении линии. Не найдена линия для удаления." skip
     7790         return-value skip
     7791         trim(error-status :get-message(1))
     7792         view-as alert-box error.
     7793       undo, return error .
     7794     end.
     7795     run local-recalc in this-procedure ( input "old":U,
     7796                                          input recid( bf-del_doc-line ) ) no-error.
     7797     if error-status :error then do:
     7798       message
     7799         vss-workfile vss-revision vss-description skip
     7800         "Ошибка при пересчете строки документа" skip
     7801         return-value skip
     7802         trim(error-status :get-message(1))
     7803         view-as alert-box error.
     7804       undo, return error .
     7805     end.
     7806     run trg/rsrv-del.p ( input bf-del_doc-line.doc-code,
     7807                      input bf-del_doc-line.artic,
     7808                      input bf-del_doc-line.prod-type,
     7809                      input bf-del_doc-line.prod-code ) no-error.
     7810     if error-status :error then do:
     7811       message
     7812         vss-workfile vss-revision vss-description skip "Ошибка при разрезервировании по линии документа" skip
     7813         return-value skip trim(error-status :get-message(1))
     7814         view-as alert-box error.
     7815       undo, return error .
     7816     end.
     7817     run local-recalc in this-procedure ( input "delete":U,
     7818                                          input recid( bf-del_doc-line ) ) no-error.
     7819     if error-status :error then do:
     7820       message
     7821         vss-workfile vss-revision vss-description skip
     7822         "Ошибка при пересчете строки документа" skip
     7823         return-value skip
     7824         trim(error-status :get-message(1))
     7825         view-as alert-box error.
     7826       undo, return error .
     7827     end.
     7828     run local-delete in this-procedure ( input recid( bf-del_doc-line ) ) no-error.
     7829     if error-status :error then do:
     7830       message
     7831         vss-workfile vss-revision vss-description skip
     7832         "Ошибка при удалении строки документа." skip
     7833         "Товар " bf-del_doc-line.artic " " bf-del_doc-line.prod-type " " bf-del_doc-line.prod-code skip
     7834         return-value skip
     7835         trim(error-status :get-message(1))
     7836         view-as alert-box error.
     7837       undo, return error .
     7838     end.
     7839   end.
     7840   end.
     7841   end procedure.
     7842   define temp-table tt-doc-line no-undo like ub.doc-line.
     7843   procedure local-check-gds:
     7844   define input parameter parrec-gds as recid no-undo.
     7845   define buffer bf_goods for ub.goods.
     7846   define buffer bf_parts for ub.parts.
     7847   define variable l-inv-on as logical no-undo .
     7848   find first bf_goods where recid( bf_goods ) = parrec-gds no-lock.
     7849   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     7851     (input  v-cntxt-obj-type
     7852     ,input  v-cntxt-obj-code
     7853     ,input  bf_goods.artic
     7854     ,input  bf_goods.prod-type
     7855     ,input  bf_goods.prod-code
     7856     ,input  'inv-on=request'
     7857     ,output l-inv-on
     7858     ) no-error .
     7859     if error-status :error then do:
     7860       message
     7861         vss-workfile vss-revision vss-description skip
     7862         "Ошибка получения признака товара на объекте" skip
     7863         return-value skip
     7864         trim(error-status :get-message(1))
     7865         view-as alert-box error.
     7866       undo, return error .
     7867     end.
     7868     if l-inv-on then do:
     7869       assign
     7870         varlog-err = yes.
     7871       put stream str-err unformatted "Артикул : " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " - товар в инвентаризации. Операция невозможна." skip.
     7872       return error.
     7873     end.
     7874     for each tt-doc-line :
     7875       delete tt-doc-line.
     7876     end.
     7877     create tt-doc-line.
     7878     assign
     7879       tt-doc-line.doc-code  = t-doc.doc-code
     7880       tt-doc-line.obj-type  = t-doc.obj-type
     7881       tt-doc-line.obj-code  = t-doc.obj-code
     7882       tt-doc-line.artic     = bf_goods.artic
     7883       tt-doc-line.prod-type = bf_goods.prod-type
     7884       tt-doc-line.prod-code = bf_goods.prod-code.
     7885     bl-inv-on:
     7886     for
     7887    each bf_parts no-lock
     7888           where
     7889               (     bf_parts.prod-type = tt-doc-line.prod-type
     7890                 and bf_parts.prod-code = tt-doc-line.prod-code
     7891                 and bf_parts.artic     = tt-doc-line.artic
     7892                 and bf_parts.obj-type  = tt-doc-line.obj-type
     7893                 and bf_parts.obj-code  = tt-doc-line.obj-code
     7894                 and bf_parts.rsrv-free = true
     7895                 and bf_parts.status_   = false
     7896                 and bf_parts.out-code  <> 'free-zone':U
     7897                 and bf_parts.out-code  <> t-doc.doc-code
     7898               )
     7899               or
     7900               (     bf_parts.prod-type = tt-doc-line.prod-type
     7901                 and bf_parts.prod-code = tt-doc-line.prod-code
     7902                 and bf_parts.artic     = tt-doc-line.artic
     7903                 and bf_parts.obj-type  = tt-doc-line.obj-type
     7904                 and bf_parts.obj-code  = tt-doc-line.obj-code
     7905                 and bf_parts.rsrv-free = false
     7906                 and bf_parts.status_   = false
     7907                 and bf_parts.out-code  <> 'out-zone':U
     7908                 and bf_parts.out-code  <> t-doc.doc-code
     7909               )
     7910     on error undo bl-inv-on, return error :
     7911       assign
     7912         varlog-err = yes.
     7913       put stream str-err unformatted "Включить инвентаризацию нельзя - на товарах есть резервы. Товар " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " Документ " bf_parts.out-code skip.
     7914       undo bl-inv-on, return error.
     7915     end.
     7916   end procedure.
     7917   procedure chk-upd-date:
     7918   define variable v-today as date      no-undo.
     7919   define variable v-time  as integer   no-undo.
     7920   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     7922     (input  v-cntxt-obj-type
     7923     ,input  v-cntxt-obj-code
     7924     ,output v-today
     7925     )  .
     7926   if input frame d-doc t-doc.fact-date > v-today then do:
     7927      message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
     7928      display t-doc.fact-date with frame d-doc.
     7929      return error.
     7930   end.
     7931   if input frame d-doc t-doc.fact-date < v-today - 7 then do:
     7932      varlog = yes.
     7933      message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
     7934              "Отказаться от заведения даты?" view-as alert-box question
     7935              buttons yes-no update varlog.
     7936      if varlog then do:
     7937         display t-doc.fact-date with frame d-doc.
     7938         return error.
     7939      end.
     7940   end.
     7941   if input frame d-doc t-doc.fact-date <> t-doc.fact-date then do:
     7942   define variable v-value-character as character no-undo .
     7943   define variable v-value-date      as date no-undo .
     7944   define variable v-value-decimal   as decimal no-undo .
     7945   define variable v-value-integer   as integer no-undo .
     7946   define variable v-value-logical   as logical no-undo .
     7947   define variable v-tth             as handle no-undo .
     7948   define variable v-back-date as logical   no-undo .
     7949   define variable v-back-date-type as character no-undo .
     7950         delete object v-tth no-error.
     7951         run adm/shattri.p (
     7952              input "get":U
     7953             ,input v-cntxt-obj-type
     7954             ,input v-cntxt-obj-code
     7955             ,input 'nakl_par':U
     7956             ,input  "back-date"
     7957             ,output v-value-character
     7958             ,output v-value-date
     7959             ,output v-value-decimal
     7960             ,output v-value-integer
     7961             ,output v-back-date
     7962             ,output v-back-date-type
     7963             ,INPUT-OUTPUT table-handle v-tth
     7964             ) no-error .
     7965             if error-status :error  then v-back-date = false .
     7966             delete object v-tth no-error.
     7967       if v-back-date <> true then do:
     7968         message "Запрещено работать задним числом !" view-as alert-box information .
     7969         display t-doc.fact-date with frame d-doc.
     7970         return error.
     7971       end.
     7972      assign varlog = no.
     7973      case t-doc.doc-type
     7974      :
     7975        when 'при':U
     7976        then do:
     7977   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7978   do:
     7979     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7980       (input  v-cntxt-db-num
     7981       ,input  v-cntxt-userid
     7982       ,input  0
     7983       ,input  'actn_income_add-back-date':U
     7984       ,input  'object':U
     7985       ,input  t-doc.host-code
     7986       ,input  t-doc.obj-type
     7987       ,input  t-doc.obj-code
     7988       ,input  0
     7989       ,input  0
     7990       ,input  0
     7991       ,input  true
     7992       ,output varlog
     7993       )  .
     7994   end.
     7995        end.
     7996        when 'рас':U
     7997        then do:
     7998   define variable vss-include-info64 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7999   do:
     8000     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8001       (input  v-cntxt-db-num
     8002       ,input  v-cntxt-userid
     8003       ,input  0
     8004       ,input  'actn_expense_add-back-date':U
     8005       ,input  'object':U
     8006       ,input  t-doc.host-code
     8007       ,input  t-doc.obj-type
     8008       ,input  t-doc.obj-code
     8009       ,input  0
     8010       ,input  0
     8011       ,input  0
     8012       ,input  true
     8013       ,output varlog
     8014       )  .
     8015   end.
     8016        end.
     8017        when 'спи':U
     8018        then do:
     8019   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8020   do:
     8021     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8022       (input  v-cntxt-db-num
     8023       ,input  v-cntxt-userid
     8024       ,input  0
     8025       ,input  'actn_write-off_add-back-date':U
     8026       ,input  'object':U
     8027       ,input  t-doc.host-code
     8028       ,input  t-doc.obj-type
     8029       ,input  t-doc.obj-code
     8030       ,input  0
     8031       ,input  0
     8032       ,input  0
     8033       ,input  true
     8034       ,output varlog
     8035       )  .
     8036   end.
     8037        end.
     8038        when 'возврат':U
     8039        then do:
     8040   define variable vss-include-info66 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8041   do:
     8042     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8043       (input  v-cntxt-db-num
     8044       ,input  v-cntxt-userid
     8045       ,input  0
     8046       ,input  'actn_return_add-back-date':U
     8047       ,input  'object':U
     8048       ,input  t-doc.host-code
     8049       ,input  t-doc.obj-type
     8050       ,input  t-doc.obj-code
     8051       ,input  0
     8052       ,input  0
     8053       ,input  0
     8054       ,input  true
     8055       ,output varlog
     8056       )  .
     8057   end.
     8058        end.
     8059        when 'инв':U
     8060        then do:
     8061   define variable vss-include-info67 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8062   do:
     8063     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8064       (input  v-cntxt-db-num
     8065       ,input  v-cntxt-userid
     8066       ,input  0
     8067       ,input  'actn_inventory_add-back-date':U
     8068       ,input  'object':U
     8069       ,input  t-doc.host-code
     8070       ,input  t-doc.obj-type
     8071       ,input  t-doc.obj-code
     8072       ,input  0
     8073       ,input  0
     8074       ,input  0
     8075       ,input  true
     8076       ,output varlog
     8077       )  .
     8078   end.
     8079        end.
     8080        otherwise do:
     8081          message
     8082            vss-workfile vss-revision vss-description skip
     8083            "Неизвестный тип документа" skip
     8084            "Тип документа" t-doc.doc-type skip
     8085            "Код документа" t-doc.doc-code skip
     8086            view-as alert-box error .
     8087          undo, return error return-value .
     8088        end.
     8089      end case .
     8090      if varlog = no then do:
     8091         display t-doc.fact-date with frame d-doc.
     8092         return error.
     8093      end.
     8094      varlog = no.
     8095      message "Вы хотите изменить фактическую дату?" skip
     8096              "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
     8097      view-as alert-box question buttons yes-no update varlog.
     8098      if not varlog then do:
     8099         display t-doc.fact-date with frame d-doc.
     8100         return error.
     8101      end.
     8102      assign t-doc.fact-time = (24 * 60 * 60).
     8103   end.
     8104   end procedure.
     8105   procedure mode-on :
     8106   define buffer bf_clients for ub.clients.
     8107   define buffer bf_store   for ub.store.
     8108   define variable varrecid as recid no-undo.
     8109   define variable varactive-obj as logical no-undo.
     8110   do on error undo, return error :
     8111   if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     8112      RUN add-doc in this-procedure ( output varrecid ) no-error.
     8113      if error-status :error then do:
     8114        message
     8115          vss-workfile vss-revision vss-description skip
     8116          "Ошибка при добавлении документа." skip
     8117          return-value skip
     8118          trim(error-status :get-message(1))
     8119          view-as alert-box error.
     8120        undo, return error .
     8121      end.
     8122   end.
     8123   else do:
     8124     find first t-doc where recid(t-doc) = pardoc-rec no-lock.
     8125     if available t-doc then do:
     8126       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     8127         if t-doc.status_ <> 'накл':U then do:
     8128           message "Документ закрыт." skip (1)
     8129                   "Редактирование невозможно."
     8130                   view-as alert-box error.
     8131           return error.
     8132         end.
     8133         else do:
     8134           find first bf_clients where bf_clients.obj-type = v-cntxt-obj-type and
     8135                                       bf_clients.obj-code = v-cntxt-obj-code no-lock.
     8136           if v-cntxt-db-num <> bf_clients.db-num then do:
     8137             message
     8138               vss-workfile vss-revision vss-description skip
     8139               "Редактирование документа возможно только на активной стороне." skip
     8140               return-value skip
     8141               trim(error-status :get-message(1))
     8142               view-as alert-box error.
     8143             undo, return error .
     8144           end.
     8145         end.
     8146       end.
     8147     end.
     8148     else do:
     8149       message "Неправильный выбор документа.".
     8150       return error.
     8151     end.
     8152   end.
     8153   end.
     8154   end procedure.
     8155   procedure add-doc:
     8156   define output parameter parrecid as recid no-undo.
     8157   define variable vardoc-code   like ub.trn-doc.doc-code    no-undo.
     8158   define variable v-today       as date                     no-undo.
     8159   do on error undo, return error :
     8160     if not can-find (pay-type where pay-type.obj-code = v-cntxp-inv-pay no-lock) then do:
     8161       message "Не задан код оплаты для инвентаризации в настройках по текущему объекту.".
     8162       return error.
     8163     end.
     8164     run doc-code in this-procedure
     8165     (input  "main",
     8166      input  v-cntxt-obj-type,
     8167      input  v-cntxt-obj-code,
     8168      input  ?,
     8169      output vardoc-code ) no-error.
     8170     if error-status :error then do:
     8171       message
     8172         vss-workfile vss-revision vss-description skip
     8173         "Ошибка при генерации номера документа." skip
     8174         return-value skip
     8175         trim( error-status :get-message( 1 ) )
     8176         view-as alert-box error.
     8177       undo, return error .
     8178     end.
     8179   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8180   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     8181     (input  v-cntxt-obj-type
     8182     ,input  v-cntxt-obj-code
     8183     ,output v-today
     8184     )  .
     8185   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     8186   (input ?
     8187   ,input ?
     8188   ,input 1
     8189   ,input 1
     8190   ,input ?
     8191   ,input ?
     8192   ,input ?
     8193   ,input v-cntxt-db-num
     8194   ,input v-cntxt-userid
     8195   ,input ' '
     8196   ,input vardoc-code
     8197   ,input v-today
     8198   ,input 'инв':U
     8199   ,input no
     8200   ,input v-cntxt-host-code-obj
     8201   ,input no
     8202   ,input v-cntxt-obj-code
     8203   ,input v-cntxt-obj-type
     8204   ,input no
     8205   ,input v-cntxp-inv-pay
     8206   ,input '@  '
     8207   ,input no
     8208   ,input 'без':U
     8209   ,input 'накл':U
     8210   ,input 'в т. ч.':U
     8211   ,input 'ap':U
     8212   ,input ?
     8213   ) no-error
     8214   .
     8215     if error-status :error then do:
     8216       message
     8217         vss-workfile vss-revision vss-description skip
     8218         "Ошибка при создании документа процедурой crtrndoc" skip
     8219         return-value skip
     8220         trim(error-status :get-message(1))
     8221         view-as alert-box error.
     8222       undo, return error .
     8223     end.
     8224     find t-doc where t-doc.doc-code = vardoc-code.
     8225     assign
     8226       pardoc-rec = recid( t-doc ).
     8227     assign parrecid = recid( t-doc ).
     8228   end.
     8229   end procedure.
     8230   procedure open-all-browse :
     8231     open query br    for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code,      first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic   and                                 bf_goods.prod-type = bf_doc-line.prod-type and                                 bf_goods.prod-code = bf_doc-line.prod-code ,         first bf-expp_doc-line-sum outer-join where bf-expp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                        bf-expp_doc-line-sum.gds-code = bf_goods.gds-code    and                                        bf-expp_doc-line-sum.sum-type = 'exp':U ,            first bf-incp_doc-line-sum outer-join where bf-incp_doc-line-sum.doc-code = bf_doc-line.doc-code and                                          bf-incp_doc-line-sum.gds-code = bf_goods.gds-code    and                                          bf-incp_doc-line-sum.sum-type = 'inp':U.
     8232     if line-rec <> ? then do:
     8233       reposition br to recid line-rec no-error.
     8234     end.
     8235     open query br-op   for each bf-orig_parts where bf-orig_parts.out-code  = t-doc.doc-code        and                                  bf-orig_parts.obj-type  = t-doc.obj-type        and                                  bf-orig_parts.obj-code  = t-doc.obj-code        and                                  bf-orig_parts.artic     = bf_doc-line.artic     and                                  bf-orig_parts.prod-type = bf_doc-line.prod-type and                                  bf-orig_parts.prod-code = bf_doc-line.prod-code and                                  bf-orig_parts.in-code  <> t-doc.doc-code no-lock,       first bf-orig_goods where bf-orig_goods.artic     = bf-orig_parts.artic     and                                      bf-orig_goods.prod-type = bf-orig_parts.prod-type and                                      bf-orig_goods.prod-code = bf-orig_parts.prod-code no-lock.
     8236     open query br-cp   for each bf_parts-root where bf_parts-root.doc-code       = bf-orig_parts.out-code  and                                     bf_parts-root.orig-in-code   = bf-orig_parts.in-code   and                                     bf_parts-root.orig-gds-code  = bf-orig_goods.gds-code  and                                     bf_parts-root.orig-part-code = bf-orig_parts.part-code no-lock,       first bf-caus_parts where bf-caus_parts.out-code  = bf_parts-root.doc-code  and                                 bf-caus_parts.obj-type  = bf-orig_parts.obj-type  and                                 bf-caus_parts.obj-code  = bf-orig_parts.obj-code  and                                 bf-caus_parts.artic     = bf-orig_parts.artic     and                                 bf-caus_parts.prod-type = bf-orig_parts.prod-type and                                 bf-caus_parts.prod-code = bf-orig_parts.prod-code and                                 bf-caus_parts.in-code   = bf_parts-root.in-code   and                                 bf-caus_parts.part-code = bf_parts-root.part-code.
     8237   end procedure.
     8238   procedure local-add:
     8239   define variable varartic   like ub.doc-line.artic no-undo.
     8240   define variable recid-line as   recid             no-undo.
     8241   define variable varmode    as   character         no-undo.
     8242   define variable varhvrdtax as   logical           no-undo.
     8243   define variable varlog     as   logical           no-undo.
     8244   define variable varis-ok   as   logical           no-undo.
     8245   define buffer bf_goods      for ub.goods.
     8246   define buffer bf-free_parts for ub.parts.
     8247   define buffer bf_contract   for ub.contract.
     8248   define variable varnum as integer no-undo.
     8249   define variable varstay-lns-cnt as integer no-undo.
     8250   define variable varnotes as character no-undo.
     8251   define variable varlns-cnt as integer no-undo.
     8252   do on error undo, return error return-value :
     8253   run str/chs-gds.w
     8254     ( input parparentproc,
     8255       input v-cntxt-obj-type,
     8256       input v-cntxt-obj-code,
     8257       input "":u,
     8258       input t-doc.status_,
     8259       input "Строка накладной № " + t-doc.doc-code,
     8260       input ?,
     8261       input ?,
     8262       input ?,
     8263       input v-cntxt-host-code-obj,
     8264       input parext-doc-type,
     8265       input-output varartic,
     8266       output varnotes
     8267       ) .
     8268   if varnotes = '' then do: return error. end.
     8269   varlns-cnt = 1.
     8270   cycle:
     8271   do while varlns-cnt <= num-entries (varnotes) on error undo, return error return-value :
     8272   gds:
     8273   do transaction on error undo, leave :
     8274     find first bf_goods where recid( bf_goods ) = integer( entry( varlns-cnt, varnotes ) ) no-lock.
     8275     assign
     8276       varlns-cnt = varlns-cnt + 1.
     8277     if hvrdtax ( recid( bf_goods ) ) = no then do:
     8278       assign
     8279         varhvrdtax = no.
     8280     end.
     8281     find first bf_doc-line where bf_doc-line.doc-code  = t-doc.doc-code     and
     8282                                  bf_doc-line.artic     = bf_goods.artic     and
     8283                                  bf_doc-line.prod-type = bf_goods.prod-type and
     8284                                  bf_doc-line.prod-code = bf_goods.prod-code no-error.
     8285     if available bf_doc-line then do:
     8286       message "Товар " bf_doc-line.artic " " bf_doc-line.prod-type " " bf_doc-line.prod-code " " bf_goods.gds-name " уже есть в данной накладной." skip
     8287               "Хотите отредактировать его?" view-as alert-box question buttons yes-no update varlog.
     8288       if not varlog then do:
     8289         undo, leave gds.
     8290       end.
     8291       run gbl/d-askw.w
     8292       (input "Смена цен"
     8293       ,input "Товар " + bf_goods.artic + " " + bf_goods.prod-type + " " + string(bf_goods.prod-code) + " " + substring(bf_goods.gds-name,1,30)
     8294       ,input "|^"
     8295       ,input "Все|Новые|Отменить"
     8296       ,input "Всем выбранным партиям из свободной зоны|"
     8297            + "Новым выбранным партиям из свободной зоны|"
     8298            + "Прекратить обработку товаров"
     8299       ,input 1
     8300       ,input 3
     8301       ,output varnum
     8302       ).
     8303       case varnum :
     8304         when 1 then do:
     8305           assign
     8306             varmode = "chg_parts":u.
     8307         end.
     8308         when 2 then do:
     8309           assign
     8310             varmode = "chg_new_parts":u.
     8311         end.
     8312         when 3 then do:
     8313           assign
     8314             varlog-err = yes.
     8315           assign
     8316             varstay-lns-cnt = varlns-cnt.
     8317           do while varstay-lns-cnt <= num-entries (varnotes) on error undo, return error return-value :
     8318             find first bf_goods where recid( bf_goods ) = integer( entry( varlns-cnt, varnotes ) ) no-lock.
     8319             assign
     8320               varstay-lns-cnt = varstay-lns-cnt + 1.
     8321             put stream str-err unformatted "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " ,из списка выбранных, не обрабатывался в связи с нажатием кнопки 'Отмена'." skip.
     8322           end.
     8323           undo gds, leave cycle.
     8324         end.
     8325       end case.
     8326     end.
     8327     else do:
     8328   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_chkgdsd in g#lib-trn3
     8329   ( input recid(t-doc)
     8330    ,input recid(bf_goods)
     8331   ) no-error.
     8332       if error-status :error then do:
     8333         assign
     8334           varlog-err = yes.
     8335         put stream str-err unformatted return-value.
     8336         undo, leave gds.
     8337       end.
     8338       find first bf-free_parts where bf-free_parts.host-code     = t-doc.host-code       and
     8339                                      bf-free_parts.supp-type     = t-doc.cli-type        and
     8340                                      bf-free_parts.supp-code     = t-doc.cli-code        and
     8341                                      bf-free_parts.status_       = no                    and
     8342                                      bf-free_parts.obj-type      = t-doc.obj-type        and
     8343                                      bf-free_parts.obj-code      = t-doc.obj-code        and
     8344                                      bf-free_parts.rsrv-free     = yes                   and
     8345                                      bf-free_parts.out-code      = 'free-zone':U          and
     8346                                      bf-free_parts.prod-type     = bf_goods.prod-type    and
     8347                                      bf-free_parts.prod-code     = bf_goods.prod-code    and
     8348                                      bf-free_parts.artic         = bf_goods.artic        and
     8349                                      bf-free_parts.contract-code = t-doc.contract-code   no-lock no-error.
     8350       if not available bf-free_parts then do:
     8351         if t-doc.contract-code <> 0 then do:
     8352           find first bf_contract where bf_contract.host-code     = t-doc.host-code     and
     8353                                        bf_contract.contract-code = t-doc.contract-code no-lock.
     8354         end.
     8355         assign
     8356           varlog-err = yes.
     8357         put stream str-err unformatted
     8358                 "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name "."
     8359                 "Объект: " t-doc.obj-type " " t-doc.obj-code
     8360                 "Поставщик " t-doc.cli-type " " t-doc.cli-code " " t-doc.cli-name " "
     8361                 (if available bf_contract then "Договор " + bf_contract.contract-prn-code else "")
     8362                 "Нет товара от поставщика в свободной зоне на объекте."
     8363                 "Пропускаем." skip.
     8364         undo, leave gds.
     8365       end.
     8366       run gbl/d-askw.w
     8367       (input "Смена цен"
     8368       ,input "Товар " + bf_goods.artic + " " + bf_goods.prod-type + " " + string(bf_goods.prod-code) + " " + substring(bf_goods.gds-name,1,30)
     8369       ,input "|^"
     8370       ,input "Все|Выбор|Отменить"
     8371       ,input "Всем партиям свободной зоны по поставщику|"
     8372            + "Выбранным партиям из свободной зоны|"
     8373            + "Прекратить обработку товаров"
     8374       ,input 1
     8375       ,input 3
     8376       ,output varnum
     8377       ).
     8378       case varnum :
     8379         when 1 then do:
     8380           assign
     8381             varmode = "all_parts":u.
     8382         end.
     8383         when 2 then do:
     8384           assign
     8385             varmode = "chg_parts":u.
     8386         end.
     8387         when 3 then do:
     8388           assign
     8389             varlog-err = yes.
     8390           assign
     8391             varstay-lns-cnt = varlns-cnt.
     8392           do while varstay-lns-cnt <= num-entries (varnotes) on error undo, return error return-value :
     8393             find first bf_goods where recid( bf_goods ) = integer( entry( varlns-cnt, varnotes ) ) no-lock.
     8394             assign
     8395               varstay-lns-cnt = varstay-lns-cnt + 1.
     8396             put stream str-err unformatted "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " ,из списка выбранных, не обрабатывался в связи с нажатием кнопки 'Отмена'." skip.
     8397           end.
     8398           undo gds, leave cycle.
     8399         end.
     8400       end case.
     8401   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_addcorln in g#lib-trn3
     8402   ( input  recid(t-doc)
     8403    ,input  recid(bf_goods)
     8404    ,output recid-line
     8405   ) no-error.
     8406       if error-status :error then do:
     8407         message
     8408           vss-workfile vss-revision vss-description skip
     8409           "Ошибка при добавлении товара " skip
     8410           bf_goods.artic skip
     8411           bf_goods.prod-type skip
     8412           bf_goods.prod-code skip
     8413           " в документ."
     8414           return-value skip
     8415           trim( error-status :get-message( 1 ) )
     8416           view-as alert-box error.
     8417         undo, leave gds.
     8418       end.
     8419       find first bf_doc-line where recid( bf_doc-line ) = recid-line.
     8420     end.
     8421     assign
     8422       bf_doc-line.prt-OK = ?.
     8423     run local-recalc in this-procedure ( input "old":U,
     8424                                          input recid( bf_doc-line ) ) no-error.
     8425     if error-status :error then do:
     8426       message
     8427       vss-workfile vss-revision vss-description skip
     8428       "Ошибка при пересчете строки документа" skip
     8429       return-value skip
     8430       trim(error-status :get-message(1))
     8431       view-as alert-box error.
     8432       undo, leave gds.
     8433     end.
     8434     find first bf_sysconf where bf_sysconf.host-code = t-doc.host-code no-lock.
     8435     run update-line in this-procedure (   input varmode
     8436                                         , input recid( bf_doc-line )
     8437                                         , input bf_sysconf.cash-pay
     8438                                         , input ?
     8439                                         , input ?
     8440                                         , input ?
     8441                                         , input ?
     8442                                         )  no-error.
     8443     if error-status :error then do:
     8444       if return-value <> "" then do:
     8445         message
     8446           vss-workfile vss-revision vss-description skip
     8447           "Ошибка при обработке товара " skip
     8448           bf_doc-line.artic skip
     8449           bf_doc-line.prod-type skip
     8450           bf_doc-line.prod-code skip
     8451           return-value skip
     8452           trim(error-status :get-message(1))
     8453           view-as alert-box error.
     8454       end.
     8455       undo, leave gds.
     8456     end.
     8457     if available bf_doc-line then do:
     8458       run local-recalc in this-procedure ( input "update":U,
     8459                                            input recid( bf_doc-line ) ) no-error.
     8460       if error-status :error then do:
     8461         message
     8462         vss-workfile vss-revision vss-description skip
     8463         "Ошибка при пересчете строки документа" skip
     8464         return-value skip
     8465         trim( error-status :get-message( 1 ) )
     8466         view-as alert-box error.
     8467         undo, leave gds.
     8468       end.
     8469     end.
     8470   end.
     8471   end.
     8472   run ui-on in this-procedure ( input "line" ).
     8473   end.
     8474   end procedure.
     8475   procedure add-doc-inv-line:
     8476   define input parameter parrec-goods as recid no-undo.
     8477   define output parameter parrecid as recid no-undo.
     8478   define variable v-vat-pc        like ub.doc-line.vat-pc      no-undo.
     8479   define variable v-slt-pc        like ub.doc-line.slt-pc      no-undo.
     8480   define variable v-have-slt-pc   as logical                no-undo.
     8481   define variable v-host-code     like ub.sysconf.host-code    no-undo.
     8482   define variable varn-c          like ub.gds-prt.node-code no-undo.
     8483   define variable l-inv-on        as logical                no-undo.
     8484   define buffer bf_goods    for ub.goods.
     8485   define buffer bf_doc-line for ub.doc-line.
     8486   do on error undo, return error return-value :
     8487   find first bf_goods where recid( bf_goods ) = parrec-goods no-lock.
     8488   if bf_goods.gds-type = 'у':U then do:
     8489     message
     8490       vss-workfile vss-revision vss-description skip
     8491       "Услуги нельзя добавлять в данный документ" skip
     8492       return-value skip
     8493       trim( error-status :get-message( 1 ) )
     8494       view-as alert-box error.
     8495     undo, return error .
     8496   end.
     8497   find bf_doc-line where bf_doc-line.artic     = bf_goods.artic
     8498                      and bf_doc-line.prod-type = bf_goods.prod-type
     8499                      and bf_doc-line.prod-code = bf_goods.prod-code
     8500                      and bf_doc-line.doc-code  = t-doc.doc-code no-error.
     8501   if not available bf_doc-line then do:
     8502   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8504     (input  t-doc.obj-type
     8505     ,input  t-doc.obj-code
     8506     ,output v-host-code
     8507     )  .
     8508   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     8510     (input  bf_goods.gds-code
