     5317   ON CHOOSE OF b-next IN FRAME d-doc
     5318   DO:
     5319     RUN step-next in this-procedure .
     5320   END.
     5321   procedure step-next:
     5322   define variable cur-form as char no-undo.
     5323   define variable new-form as char no-undo.
     5324   define buffer new_trn-doc for ub.trn-doc  .
     5325   case t-doc.doc-type:
     5326     when 'при':U then
     5327       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     5328     when 'рас':U or when 'возврат':U or when 'спи':U then
     5329       cur-form = 'рас':U.
     5330     when 'инв':U then cur-form = 'инв':U.
     5331   end case.
     5332   if bf-handle = ? then return .
     5333   if valid-handle (br-handle) then do:
     5334     varlog = br-handle:select-next-row().
     5335     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5336     if not varlog then message "Это последний документ списка.".
     5337   end.
     5338   case new_trn-doc.doc-type:
     5339     when 'при':U then
     5340       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     5341     when 'рас':U or when 'возврат':U or when 'спи':U then
     5342       new-form = 'рас':U.
     5343     when 'инв':U then new-form = 'инв':U.
     5344   end case.
     5345   assign
     5346       pardoc-rec   = bf-handle:recid
     5347       parnext-prev = ( cur-form = new-form ) .
     5348   end procedure.
     5349   ON CHOOSE OF b-prev IN FRAME d-doc
     5350   DO:
     5351     run step-prev in this-procedure .
     5352   END.
     5353   procedure step-prev:
     5354   define variable cur-form as char no-undo.
     5355   define variable new-form as char no-undo.
     5356   define buffer new_trn-doc for ub.trn-doc  .
     5357   case t-doc.doc-type:
     5358     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     5359     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     5360     when 'инв':U then cur-form = 'инв':U.
     5361   end case.
     5362   if bf-handle = ? then return .
     5363   if valid-handle (br-handle) then do:
     5364     varlog = br-handle:select-prev-row().
     5365     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5366     if not varlog then message "Это первый документ списка.".
     5367   end.
     5368   case new_trn-doc.doc-type :
     5369     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     5370     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     5371     when 'инв':U then new-form = 'инв':U.
     5372   end case.
     5373   assign
     5374     pardoc-rec   = bf-handle:recid
     5375     parnext-prev = (cur-form = new-form)
     5376   .
     5377   end procedure.
