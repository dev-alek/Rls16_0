     1134   do on error undo, return error return-value :
     1135   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     1136   for each bf_tt-allsum on error undo, return error return-value :
     1137     delete bf_tt-allsum.
     1138   end.
     1139   assign
     1140     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     1141     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     1142   .
     1143   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1145     (output varinvprbcl
     1146     )  .
     1147     if cl_tt-clcparts.out-code = 'free-zone':U     or
     1148        cl_tt-clcparts.out-code = 'out-zone':U   or
     1149        cl_tt-clcparts.doc-type = 'акт':U then do:
     1150       assign
     1151         in-vatp-have-vat-sltcl = yes.
     1152     end.
     1153     else do:
     1154       find first in-vatp_doc-attrcl no-lock
     1155         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     1156           and in-vatp_doc-attrcl.attr-code = 'envd':U
     1157         no-error .
     1158       if not available in-vatp_doc-attrcl then do:
     1159         assign
     1160           in-vatp-have-vat-sltcl = yes.
     1161       end.
     1162       else do:
     1163            in-vatp-have-vat-sltcl = no.
     1164       end.
     1165     end.
     1166     assign
     1167      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     1168      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     1169     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     1170              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     1171     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     1172             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     1173             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     1174             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     1175             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     1176             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     1177             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
