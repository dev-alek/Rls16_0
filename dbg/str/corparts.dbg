     2875           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
     2876             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
     2877             and buf_parts.artic     = p-artic
     2878             and buf_parts.prod-type = p-prod-type
     2879             and buf_parts.prod-code = p-prod-code
     2880             and buf_parts.in-code   = p-orig-in-code
     2881             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
     2882             and buf_parts.part-code = p-orig-part-code
     2883           no-error .
