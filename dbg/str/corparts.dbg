     2907         then do:
     2908           find first buf_income_doc-line no-lock
     2909             where buf_income_doc-line.doc-code  = p-orig-in-code
     2910               and buf_income_doc-line.artic     = p-artic
     2911               and buf_income_doc-line.prod-type = p-prod-type
     2912               and buf_income_doc-line.prod-code = p-prod-code
     2913             no-error .
     2914           if not available buf_income_doc-line
     2915           then do:
     2916             message
     2917               vss-workfile vss-revision vss-description skip
     2918               vss-include-info19 skip
     2919               "Не найдена исходная строка документа прихода" skip
     2920               "Исходный документ" p-orig-in-code skip
     2921               "Артикул" p-artic p-prod-type p-prod-code skip
     2922               "Код партии" p-orig-part-code skip
     2923               view-as alert-box error .
     2924             undo, return error .
     2925           end.
     2926           assign
     2927             v-base-rate         = buf_income_trn-doc.base-rate
     2928             v-base-scale        = buf_income_trn-doc.base-scale
     2929             v-exch-rate         = buf_income_trn-doc.exch-rate
     2930             v-exch-scale        = buf_income_trn-doc.exch-scale
     2931             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
     2932             v-unit-cli          = buf_income_doc-line.unit-cli
     2933           .
     2934         end.
     2935         else do:
     2936           find first buf_goods no-lock
     2937             where buf_goods.artic     = buf_parts.artic
     2938               and buf_goods.prod-type = buf_parts.prod-type
     2939               and buf_goods.prod-code = buf_parts.prod-code
     2940             .
     2941           assign
     2942             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
     2943             v-base-scale        = 1
     2944             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
     2945             v-exch-scale        = 1
     2946             v-extended-doc-type = 'ie':U
     2947             v-unit-cli          = buf_goods.unit-cli
     2948           .
     2949         end.
     2950          if v-base-rate = ? then v-base-rate = 1.
     2951          if v-exch-rate = ? then v-exch-rate = 1.
     2952   assign
     2953     price-rubl-with-tax-loc = buf_parts.price-rubl
     2954     price-base-with-tax-loc = buf_parts.price-base
     2955   .
     2956   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2958     (output varinvprb
