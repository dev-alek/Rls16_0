     5064       DO varmvibr-cp = 1 TO EXTENT(cur-clmn-numbr-cp):
     5065         if cur-clmn-numbr-cp[varmvibr-cp] = varmvjbr-cp THEN DO:
     5066           cur-clmn-numbr-cp[varmvibr-cp] = cur-clmn-numbr-cp[varmvibr-cp] - 1.
     5067         END.
     5068       END.
     5069     END.
     5070     DO varmvibr-cp = 1 TO EXTENT(cur-clmn-numbr-cp):
     5071       if cur-clmn-numbr-cp[varmvibr-cp] = -1 THEN cur-clmn-numbr-cp[varmvibr-cp] = target-column.
     5072     END.
     5073   END PROCEDURE.
     5074   PROCEDURE ch-clmnbr-cp:
     5075     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5076     if cur-clmn-loc <= 2 then do:
     5077       return .
     5078     end.
     5079     DO varmvibr-cp = 1 TO EXTENT(cur-clmn-numbr-cp):
