     1937       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     1938       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     1939       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
