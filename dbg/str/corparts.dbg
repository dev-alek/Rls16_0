     2892             "Артикул" p-artic p-prod-type p-prod-code skip
     2893             "Код партии" p-orig-part-code skip
     2894             view-as alert-box error .
     2895           undo, return error .
     2896         end.
     2897         define variable v-base-rate         as decimal   no-undo .
     2898         define variable v-base-scale        as integer   no-undo .
     2899         define variable v-exch-rate         as decimal   no-undo .
     2900         define variable v-exch-scale        as integer   no-undo .
     2901         define variable v-extended-doc-type as character no-undo .
     2902         define variable v-unit-cli          as character no-undo .
     2903         find first buf_income_trn-doc no-lock
     2904           where buf_income_trn-doc.doc-code = p-orig-in-code
     2905           no-error .
