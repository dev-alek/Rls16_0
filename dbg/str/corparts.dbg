     1868       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     1869       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     1870       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     1871       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     1872       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     1873       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     1874       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     1875       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     1876       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     1877       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     1878       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     1879       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     1880       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     1881       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     1882       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     1883       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     1884       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     1885       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     1886       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     1887       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     1888       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     1889       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     1890       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     1891       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     1892       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     1893       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     1894       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     1895       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     1896       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     1897       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     1898       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     1899       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     1900       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     1901       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     1902   end.
     1903   create bfpc_tt-allsum.
     1904   create bfspc_tt-allsum.
     1905   case cl_tt-clcparts.purch-code :
     1906   when 1           then do:
     1907     assign
     1908       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     1909       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     1910     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1911     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1912   end.
     1913   when 4    then do:
     1914     assign
     1915       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     1916       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     1917     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1918     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1919   end.
     1920   when 3 then do:
     1921     assign
     1922       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     1923       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     1924     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1925     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1926   end.
     1927   when 2 then do:
     1928     assign
     1929       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     1930       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     1931     assign
     1932       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     1933       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     1934       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     1935       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
