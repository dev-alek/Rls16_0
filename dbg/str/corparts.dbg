     2174   end procedure.
     2175   procedure clcprtsl_calc-line :
     2176   define input  parameter parrec-line as recid no-undo.
     2177   define variable v-tax-date         as   date                     no-undo.
     2178   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2179   define variable varr-b             as   character                no-undo.
     2180   define variable varr-btype         as   character                no-undo.
     2181   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2182   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2183   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2184   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2185   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2186   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2187   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2188   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2189   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2190   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2191   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2192   define variable varexcise          like ub.price-list.excise     no-undo.
     2193   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2194   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2195   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2196   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2197   define variable v-varsum           as decimal                  no-undo.
     2198   define variable varprice-salef as decimal   no-undo .
     2199   define buffer bf_trn-doc             for ub.trn-doc.
     2200   define buffer bf_doc-line            for ub.doc-line.
     2201   define buffer bf_gds-dtl             for ub.gds-dtl.
     2202   define buffer bf_goods               for ub.goods.
     2203   define buffer bf_parts               for ub.parts.
     2204   define buffer bf_sysconf             for ub.sysconf.
     2205   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2206   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2207   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2208   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2209   define buffer buf_parts        for ub.parts.
     2210   v-calcbypart = no.
     2211   do on error undo, return error return-value :
     2212   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2214     (output varr-b
     2215     )  .
     2216     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2217     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2218     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2219                               bf_goods.prod-type = bf_doc-line.prod-type and
     2220                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2221     if bf_trn-doc.fact-date <> ?        then do:
     2222       assign v-tax-date = bf_trn-doc.fact-date.
     2223     end.
     2224     else do:
     2225       assign v-tax-date = ?.
     2226     end.
     2227   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2229     (input  bf_goods.gds-code
     2230     ,input  '1':U
     2231     ,input  v-tax-date
     2232     ,input  bf_trn-doc.host-code
     2233     ,input  bf_trn-doc.obj-type
     2234     ,input  bf_trn-doc.obj-code
     2235     ,output v-vat-pc
     2236     ) no-error .
     2237     if error-status :error
     2238     or v-vat-pc = ? then do:
     2239        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2240     end.
     2241     if bf_goods.gds-type = 'у':U or
     2242        bf_trn-doc.status_ = 'запрос':U then do:
     2243       for each bf_tt-allsum-line
     2244       on error undo, return error return-value
     2245        :
     2246         delete bf_tt-allsum-line.
     2247       end.
     2248       create bf_tt-allsum-line.
     2249       assign
     2250        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2251       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2252                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2253                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2254                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2255         assign
     2256           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2257           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2258           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2259           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2260           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2261           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2262           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2263           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2264           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2265           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2266           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2267           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2268           bf_tt-allsum-line.vat-cli-acc          =  ?
     2269           .
     2270       end.
     2271       assign
     2272         bf_tt-allsum-line.cli-qnty             =  ?
     2273         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2274         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
