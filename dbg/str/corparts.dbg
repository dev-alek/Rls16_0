     2456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2457     (input  bf_goods.gds-code
     2458     ,input  bf_gds-dtl.prt-code
     2459     ,output varb-code
     2460     ) no-error .
     2461   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2463     (input  bf_trn-doc.obj-type
     2464     ,input  bf_trn-doc.obj-code
     2465     ,input  varb-code
     2466     ,input  0
     2467     ,input  bf_trn-doc.fact-order
     2468     ,output vardoc-num
     2469     ,output varprice-sale
     2470     ,output varroad-tax
     2471     ,output varexcise
     2472     )  .
     2473             if varprice-sale = ?
     2474             then do:
     2475               assign
     2476                 varprice-sale = 0
     2477                 varroad-tax   = 0
     2478                 varexcise     = 0
     2479               .
     2480             end.
     2481             assign
     2482               varlastcur-base     = varprice-sale
     2483               varlastcur-road-tax = varroad-tax
     2484               varlastcur-excise   = varexcise
     2485               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2486               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2487               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2488               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2489             .
     2490         end.
     2491       end.
     2492       if varcur-fact-qnty = 0 then do:
     2493         assign
     2494           varcur-base      = varlastcur-base
     2495           varcur-road-tax  = varlastcur-road-tax
     2496           varcur-excise    = varlastcur-excise
     2497         .
     2498       end.
     2499       else do:
     2500         assign
     2501           varcur-base      = varcur-base      / varcur-fact-qnty
     2502           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2503           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2504         .
     2505       end.
     2506       if varcur-vat-pc = ?
     2507       then do:
     2508         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2509       end.
     2510       if varcur-slt-pc = ?
     2511       then do:
     2512         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2513       end.
     2514       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2515       assign
     2516         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2517       if varcur-cons-vat-pc = ? then do:
     2518         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2519       end.
     2520       define buffer buf_tt-clcparts for tt-clcparts .
     2521       for each buf_tt-clcparts
     2522       on error undo, return error return-value
     2523       :
     2524         delete buf_tt-clcparts.
     2525       end.
     2526       for each bf_parts no-lock
     2527         where bf_parts.out-code  = bf_doc-line.doc-code
     2528           and bf_parts.obj-type  = bf_doc-line.obj-type
     2529           and bf_parts.obj-code  = bf_doc-line.obj-code
     2530           and bf_parts.artic     = bf_doc-line.artic
     2531           and bf_parts.prod-type = bf_doc-line.prod-type
     2532           and bf_parts.prod-code = bf_doc-line.prod-code
     2533       on error undo, return error return-value
     2534       :
     2535         create buf_tt-clcparts .
     2536         buffer-copy bf_parts to buf_tt-clcparts .
     2537         if v-calcbypart = yes   then do:
     2538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2539     (buffer bf_parts
     2540     ,output v-b-pcode
     2541     ) no-error .
     2542   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2544     (input  bf_parts.obj-type
     2545     ,input  bf_parts.obj-code
     2546     ,input  v-b-pcode
     2547     ,input  0
     2548     ,input  bf_trn-doc.fact-order
     2549     ,output vardoc-num
     2550     ,output varprice-salef
     2551     ,output varroad-tax
     2552     ,output varexcise
     2553     ) no-error .
     2554             if varprice-sale = ?
     2555             then do:
     2556               assign
     2557                 varprice-salef = 0
     2558                 varroad-tax   = 0
     2559                 varexcise     = 0
     2560               .
     2561             end.
     2562             assign
     2563             part-cur-base  = varprice-salef
     2564             part-cur-road-tax  = varroad-tax
     2565             part-cur-excise = varexcise.
     2566         end.
     2567       end.
     2568       run clcprtsl_calc-ttable in this-procedure
     2569         (input yes,
     2570          input yes,
     2571          input bf_doc-line.road-tax,
     2572          input bf_doc-line.excise,
     2573          input bf_doc-line.vat-pc,
     2574          input bf_doc-line.cons-vat-pc,
     2575          input bf_doc-line.slt-pc,
     2576          input bf_trn-doc.base-rate,
     2577          input bf_trn-doc.base-scale,
     2578          input varr-b,
     2579          input varcur-base,
     2580          input varcur-road-tax,
     2581          input varcur-excise,
     2582          input varcur-vat-pc,
     2583          input varcur-cons-vat-pc,
     2584          input varcur-slt-pc
     2585          ) no-error.
     2586       if error-status:error then do:
     2587         message
     2588           vss-workfile vss-revision vss-description skip
     2589           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2590           return-value skip
     2591           trim(error-status :get-message(1))
     2592           trim(error-status :get-message(2))
     2593           trim(error-status :get-message(3))
     2594           trim(error-status :get-message(4))
     2595           trim(error-status :get-message(5)) skip
     2596           view-as alert-box error.
     2597         undo, return error .
     2598       end.
     2599     end.
     2600   end.
     2601   end.
     2602   procedure clcprtsl_calc-ttable :
     2603   define input parameter paris-doc           as   logical                 no-undo.
     2604   define input parameter paris-cur           as   logical                 no-undo.
     2605   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2606   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2607   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2608   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2609   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2610   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2611   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2612   define input parameter parr-b              as   character               no-undo.
     2613   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2614   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2615   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2616   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2617   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2618   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2619   define buffer bf_tt-allsum      for tt-allsum.
     2620   define buffer bf_tt-clcparts    for tt-clcparts.
     2621   define buffer bf_tt-allsum-line for tt-allsum-line.
     2622   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2623   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2624   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2625   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2626   define variable varexcise          like ub.price-list.excise     no-undo.
     2627   do on error undo, return error return-value :
     2628   for each bf_tt-allsum-line
     2629   on error undo, return error return-value
     2630    :
     2631     delete bf_tt-allsum-line.
     2632   end.
     2633   for each bf_tt-allsum
     2634   on error undo, return error return-value
     2635   :
     2636     delete bf_tt-allsum.
     2637   end.
     2638   for each bf_tt-clcparts
     2639   on error undo, return error return-value
     2640   :
     2641   if v-calcbypart then do:
     2642             assign
     2643             parcur-base =   bf_tt-clcparts.part-cur-base
     2644             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2645             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2646             .
     2647   end.
     2648      run clcprtsl_calc-parts in this-procedure (
     2649        input recid(bf_tt-clcparts),
     2650        input paris-doc,
     2651        input paris-cur,
     2652        input parroad-tax,
     2653        input parexcise,
     2654        input parvat-pc,
     2655        input parcons-vat-pc,
     2656        input parslt-pc,
     2657        input parbase-rate,
     2658        input parbase-scale,
     2659        input parr-b,
     2660        input parcur-base,
     2661        input parcur-road-tax,
     2662        input parcur-excise,
     2663        input parcur-vat-pc,
     2664        input parcurcons-vat-pc,
     2665        input parcurslt-pc
     2666        ) no-error.
     2667     if error-status:error then do:
     2668       message
     2669         vss-workfile vss-revision vss-description skip
     2670         vss-include-info4 skip
     2671         "Ошибка при обсчете партии" skip
     2672         "Документ партии " bf_tt-clcparts.out-code skip
     2673         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2674         return-value skip
     2675         error-status:get-message(1) skip
     2676         error-status:get-message(2) skip
     2677         error-status:get-message(3) skip
     2678         view-as alert-box error .
     2679       undo, return error .
     2680     end.
     2681     for each bf_tt-allsum on error undo, return error return-value :
     2682       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2683       if not available bf_tt-allsum-line then do:
     2684         create bf_tt-allsum-line.
     2685         assign
     2686           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2687       end.
     2688       assign
     2689         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2690         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2691         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2692         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2693         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2694         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2695         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2696         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2697         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2698         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2699         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2700         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2701         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2702         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2703         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2704         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2705         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2706         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2707         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2708         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2709         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2710         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2711         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2712         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2713         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2714         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2715         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2716         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2717         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2718         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2719         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2720         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2721         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2722         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2723         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2724         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2725         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2726         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2727         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2728         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2729         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2730         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2731         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2732         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2733         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2734         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2735         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2736         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2737         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2738         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2739         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2740         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2741         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2742         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2743         .
     2744     end.
     2745   end.
     2746   end.
     2747   end procedure.
     2748   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   define new global shared variable g#trdcalib as handle no-undo.
     2750   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2751   procedure holdprts-create-parts-supp :
     2752     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
     2753     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
     2754     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
     2755     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
     2756     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
     2757     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
     2758     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
     2759     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
     2760     define buffer buf_parent_trn-doc  for ub.trn-doc .
     2761     define buffer buf_child_trn-doc   for ub.trn-doc .
     2762     define buffer buf_parts           for ub.parts .
     2763     define buffer buf_parts-supp      for ub.parts-supp .
     2764     define buffer buf_orig_parts-supp for ub.parts-supp .
     2765     define buffer buf_income_trn-doc  for ub.trn-doc .
     2766     define buffer buf_income_doc-line for ub.doc-line .
     2767     define buffer buf_goods           for ub.goods .
     2768       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2769       define buffer   in-vatp-parts    for ub.parts   .
     2770       define buffer   in-vatp-doc      for ub.trn-doc .
     2771       define buffer   in-vatp-goods    for ub.goods   .
     2772       define buffer   in-vatp-sysconf  for ub.sysconf .
     2773       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2774       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2775       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2776       define variable varinvprb                  as   character              no-undo.
     2777       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2778       define variable cli-base-rate              as   decimal                no-undo.
     2779       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2780       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2781       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2782       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2783       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2784       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2785       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2786       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2787       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2788       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2789       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2790       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2791       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2792       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2793       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2794       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2795       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2796       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2797       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2798       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2799       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2800       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2801       define variable varinvatp-envd             as   character              no-undo.
     2802       define variable varinvatp-type             as   character              no-undo.
     2803     do
     2804     on error undo, return error return-value
     2805     :
     2806       find first buf_child_trn-doc no-lock
     2807         where buf_child_trn-doc.doc-code = p-in-code
     2808         no-error .
     2809       if not available buf_child_trn-doc
     2810       then do:
     2811         return substitute("Не найден исходный документ &1", p-in-code) .
     2812       end.
     2813       find first buf_parent_trn-doc no-lock
     2814         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
     2815         no-error .
     2816       if not available buf_parent_trn-doc
     2817       then do:
     2818         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
     2819       end.
     2820       find first buf_parts-supp exclusive-lock
     2821         where buf_parts-supp.in-code   = p-in-code
     2822           and buf_parts-supp.artic     = p-artic
     2823           and buf_parts-supp.prod-type = p-prod-type
     2824           and buf_parts-supp.prod-code = p-prod-code
     2825           and buf_parts-supp.part-code = p-part-code
     2826         no-error .
     2827       if available buf_parts-supp
     2828       then do:
     2829         message
     2830           vss-workfile vss-revision vss-description skip
     2831           vss-include-info19 skip
     2832           "Попытка повторного создания партии атрибутов" skip
     2833           "Документ прихода" p-in-code skip
     2834           "Артикул" p-artic p-prod-type p-prod-code skip
     2835           "Код партии" p-part-code skip
     2836           "Исходный код партии" p-orig-in-code skip
     2837           "Исходный код документа" p-orig-part-code skip
     2838           view-as alert-box error .
     2839         undo, return error .
     2840       end.
     2841       create buf_parts-supp .
     2842       assign
