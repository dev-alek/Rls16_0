     8590   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     8592     (input  bf_doc-line.obj-type
     8593     ,input  bf_doc-line.obj-code
     8594     ,input  bf_doc-line.artic
     8595     ,input  bf_doc-line.prod-type
     8596     ,input  bf_doc-line.prod-code
     8597     ,input  'inv-on=true'
     8598     ,output l-inv-on
     8599     ) no-error .
     8600      if error-status :error then do:
     8601        message
     8602          vss-workfile vss-revision vss-description skip
     8603          "Ошибка установки атрибута товара на объекте" skip
     8604          "Документ" bf_doc-line.doc-code skip
     8605          "Объект" bf_doc-line.obj-type bf_doc-line.obj-code skip
     8606          "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     8607          "l-new-inv-on" l-inv-on skip
     8608          view-as alert-box error .
     8609        undo, return error .
     8610      end.
     8611   end.
     8612   assign parrecid = recid( bf_doc-line ).
     8613   end.
     8614   end procedure.
     8615   procedure update-line :
     8616   define input parameter parmode         as   character          no-undo.
     8617   define input parameter parrec-line     as   recid              no-undo.
     8618   define input parameter parcash-pay     as   integer            no-undo.
     8619   define input parameter paroldvat-pc    like ub.doc-line.vat-pc no-undo.
     8620   define input parameter parvat-pc       like ub.doc-line.vat-pc no-undo.
     8621   define input parameter parpurch-list   as   character          no-undo.
     8622   define input parameter parchange-price as   logical            no-undo.
     8623   define buffer bf_doc-line    for ub.doc-line.
     8624   define buffer bf_gds-dtl     for ub.gds-dtl.
     8625   define buffer bf_goods       for ub.goods.
     8626   define buffer bf_parts       for ub.parts.
     8627   define buffer bf-free_parts  for ub.parts.
     8628   define buffer bf-orig_parts  for ub.parts.
     8629   define buffer bf-caus_parts  for ub.parts.
     8630   define buffer bf_parts_root  for ub.parts-root.
     8631   define buffer bf2_parts-root for ub.parts-root.
     8632   define buffer bf-hv_parts    for ub.parts.
     8633   define buffer bf_contract    for ub.contract.
     8634   define variable parreccaus-parts     as   recid                  no-undo.
     8635   define variable varn-c               like ub.gds-prt.node-code   no-undo.
     8636   define variable varfree-qnty         like ub.parts.fact-qnty     no-undo.
     8637   define variable vartext              as   character              no-undo.
     8638   define variable varis-rsrv           as   logical                no-undo.
     8639   define variable l-goods-twounit      as   logical                no-undo.
     8640   define variable vargds-dtlrec        as   recid                  no-undo.
     8641   define variable varhvrdtax           as   logical                no-undo.
     8642   define variable varis-ok             as   logical                no-undo.
     8643   define variable varprc-chg-upd-parts as   logical                no-undo.
     8644   define variable varno-abs-tax-rubl   like ub.doc-line.price-rubl no-undo.
     8645   define variable varslt-rubl          like ub.doc-line.price-rubl no-undo.
     8646   define variable varvat-rubl          like ub.doc-line.price-rubl no-undo.
     8647   define variable varno-tax-rubl       like ub.doc-line.price-rubl no-undo.
     8648   define variable varexch-code         like ub.trn-doc.exch-code   no-undo.
     8649   define variable varexch-rate         like ub.trn-doc.exch-rate   no-undo.
     8650   define variable varexch-scale        like ub.trn-doc.exch-scale  no-undo.
     8651   define variable prt-rec as recid no-undo.
     8652   do transaction on error undo, return error return-value :
     8653   find first bf_doc-line where recid( bf_doc-line ) = parrec-line.
     8654   find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     8655                             bf_goods.prod-type = bf_doc-line.prod-type and
     8656                             bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     8657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     8658     (input  bf_goods.prt-root
     8659     ,output varn-c
     8660     )  .
     8661   assign
     8662     varhvrdtax = hvrdtax ( recid( bf_goods ) ).
     8663   find first bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     8664                               bf_gds-dtl.artic     = bf_doc-line.artic     and
     8665                               bf_gds-dtl.prod-code = bf_doc-line.prod-code and
     8666                               bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     8667                               bf_gds-dtl.prt-code  = varn-c .
     8668   assign
     8669     vargds-dtlrec = recid( bf_gds-dtl ).
     8670   for each tt-cur-parts on error undo, return error return-value :
     8671     delete tt-cur-parts.
     8672   end.
     8673   for each tt-new-parts on error undo, return error return-value :
     8674     delete tt-new-parts.
     8675   end.
     8676   for each bf_parts where bf_parts.out-code  =  t-doc.doc-code
     8677                       and bf_parts.obj-type  =  t-doc.obj-type
     8678                       and bf_parts.obj-code  =  t-doc.obj-code
     8679                       and bf_parts.artic     =  bf_doc-line.artic
     8680                       and bf_parts.prod-type =  bf_doc-line.prod-type
     8681                       and bf_parts.prod-code =  bf_doc-line.prod-code
     8682                       and bf_parts.in-code   <> t-doc.doc-code on error undo, return error return-value :
     8683     create tt-cur-parts.
     8684     buffer-copy bf_parts to tt-cur-parts.
     8685   end.
     8686   case parmode:
     8687    when "chg_parts":u     or
     8688    when "chg_new_parts":u then do:
     8689      run str/parts-l.w
     8690        (input parparentproc
     8691        ,input t-doc.obj-type
     8692        ,input t-doc.obj-code
     8693        ,input bf_goods.gds-code
     8694        ,input bf_doc-line.doc-code
     8695        ,input 'ИЗМЕНЕНИЕ':U
     8696        ,input 'документ':U
     8697           + chr(44) + 'без-резервирования':U
     8698           + chr(44) + 'no-diff-check':U
     8699        ,input 'текущий':U
     8700        ,input 'документ':U
     8701        ,output prt-rec
     8702        ) .
     8703       for each tt-chs-parts on error undo, return error return-value :
     8704         delete tt-chs-parts.
     8705       end.
     8706       doc-parts:
     8707       for each bf_parts where bf_parts.out-code  =  t-doc.doc-code
     8708                           and bf_parts.obj-type  =  t-doc.obj-type
     8709                           and bf_parts.obj-code  =  t-doc.obj-code
     8710                           and bf_parts.artic     =  bf_doc-line.artic
     8711                           and bf_parts.prod-type =  bf_doc-line.prod-type
     8712                           and bf_parts.prod-code =  bf_doc-line.prod-code
     8713                           and bf_parts.in-code  <>  t-doc.doc-code         on error undo, return error return-value :
     8714         if parmode = "chg_new_parts":u then do:
     8715           find first tt-cur-parts where tt-cur-parts.obj-type  = bf_parts.obj-type  and
     8716                                         tt-cur-parts.obj-code  = bf_parts.obj-code  and
     8717                                         tt-cur-parts.artic     = bf_parts.artic     and
     8718                                         tt-cur-parts.prod-type = bf_parts.prod-type and
     8719                                         tt-cur-parts.prod-code = bf_parts.prod-code and
     8720                                         tt-cur-parts.in-code   = bf_parts.in-code   and
     8721                                         tt-cur-parts.out-code  = bf_parts.out-code  and
     8722                                         tt-cur-parts.part-code = bf_parts.part-code no-error.
     8723           if available tt-cur-parts                       and
     8724              tt-cur-parts.fact-qnty <= bf_parts.fact-qnty then do:
     8725             next doc-parts.
     8726           end.
     8727           create tt-chs-parts.
     8728           buffer-copy bf_parts to tt-chs-parts.
     8729           if available tt-cur-parts then do:
     8730             assign
     8731               tt-chs-parts.fact-qnty = - (bf_parts.fact-qnty - tt-cur-parts.fact-qnty).
     8732           end.
     8733           else do:
     8734             assign
     8735               tt-chs-parts.fact-qnty = - tt-chs-parts.fact-qnty.
     8736           end.
     8737         end.
     8738         else do:
     8739           create tt-chs-parts.
     8740           buffer-copy bf_parts to tt-chs-parts.
     8741           assign
     8742             tt-chs-parts.fact-qnty = - tt-chs-parts.fact-qnty.
     8743         end.
     8744       end.
     8745       find first tt-chs-parts no-error.
     8746       if available tt-chs-parts then do:
     8747         run st-exch-rate in this-procedure (output varexch-code,
     8748                                             output varexch-rate,
     8749                                             output varexch-scale,
     8750                                             output varcli-base-rate,
     8751                                             output varvat-type,
     8752                                             output varslt-type).
     8753         run str/pr-prt.w (
     8754         input  "parts":u,
     8755         input  bf_goods.gds-code,
     8756         input  t-doc.cli-type,
     8757         input  t-doc.cli-code,
     8758         input  t-doc.obj-type,
     8759         input  t-doc.obj-code,
     8760         input  ?,
     8761         input  ?,
     8762         input  ?,
     8763         input  t-doc.base-rate,
     8764         input  t-doc.base-scale,
     8765         input  varexch-code,
     8766         input  varexch-rate,
     8767         input  varexch-scale,
     8768         input  ?,
     8769         input  varhvrdtax,
     8770         input  t-doc.contract-code,
     8771         input  table tt-chs-parts,
     8772         output varprice-base,
     8773         output varsum-base,
     8774         output varprice-rubl,
     8775         output varsum-rubl,
     8776         input-output varcli-base-rate,
     8777         input-output varvat-type,
     8778         input-output varslt-type,
     8779         output varprice-cli,
     8780         output varsum-cli,
     8781         output varvat-pc,
     8782         output varvat-base,
     8783         output varsum-vat-base,
     8784         output varvat-rubl,
     8785         output varsum-vat-rubl,
     8786         output varvat-cli,
     8787         output varsum-vat-cli,
     8788         output varslt-pc,
     8789         output varslt-base,
     8790         output varsum-slt-base,
     8791         output varslt-rubl,
     8792         output varsum-slt-rubl,
     8793         output varslt-cli,
     8794         output varsum-slt-cli,
     8795         output varroad-tax-base,
     8796         output varsum-road-tax-base,
     8797         output varroad-tax-rubl,
     8798         output varsum-road-tax-rubl,
     8799         output varroad-tax-cli,
     8800         output varsum-road-tax-cli,
     8801         output vartransport-base,
     8802         output varsum-transport-base,
     8803         output vartransport-rubl,
     8804         output varsum-transport-rubl,
     8805         output varother-base,
     8806         output varsum-other-base,
     8807         output varother-rubl,
     8808         output varsum-other-rubl,
     8809         output varpurch-code,
     8810         output varis-ok) no-error.
     8811         if error-status :error then do:
     8812           message
     8813           "Ошибка при установке цен." skip
     8814           return-value skip
     8815           error-status :get-message( 1 )
     8816           view-as alert-box error.
     8817           undo, return error .
     8818         end.
     8819         if varis-ok <> yes then do:
     8820           undo, return error .
     8821         end.
     8822         assign
     8823           varprc-chg-upd-parts = yes.
     8824       end.
     8825    end.
     8826    when "all_parts":u or
     8827    when "chg_vat":u   then do:
     8828        for each tt-chs-parts on error undo, return error return-value :
     8829        delete tt-chs-parts.
     8830      end.
     8831      fp: for each bf-free_parts where bf-free_parts.host-code     = t-doc.host-code          and                                                               bf-free_parts.supp-type     = t-doc.cli-type           and                                                               bf-free_parts.supp-code     = t-doc.cli-code           and                                                               bf-free_parts.status_       = no                       and                                                               bf-free_parts.obj-type      = t-doc.obj-type           and                                                               bf-free_parts.obj-code      = t-doc.obj-code           and                                                               bf-free_parts.rsrv-free     = yes                      and                                                               bf-free_parts.out-code      = 'free-zone':U             and                                                               bf-free_parts.prod-type     = bf_doc-line.prod-type    and                                                               bf-free_parts.prod-code     = bf_doc-line.prod-code    and                                                               bf-free_parts.artic         = bf_doc-line.artic        and                                                               bf-free_parts.contract-code = t-doc.contract-code      on error undo, return error return-value :
     8832        if parmode = "chg_vat":u then do:
     8833          if lookup (string(bf-free_parts.purch-code), parpurch-list) = 0 then do:
     8834            next fp.
     8835          end.
     8836          if bf-free_parts.vat-pc <> paroldvat-pc then do:
     8837            next fp.
     8838          end.
     8839        end.
     8840        create tt-chs-parts.
     8841        buffer-copy bf-free_parts to tt-chs-parts.
     8842      end.
     8843      find first tt-chs-parts no-error.
     8844      if available tt-chs-parts then do:
     8845        run st-exch-rate in this-procedure
     8846            (output varexch-code,
     8847             output varexch-rate,
     8848             output varexch-scale,
     8849             output varcli-base-rate,
     8850             output varvat-type,
     8851             output varslt-type).
     8852      end.
     8853      if parmode <> "chg_vat":u then do:
     8854        run str/pr-prt.w (
     8855          input  "goods":u,
     8856          input  bf_goods.gds-code,
     8857          input  t-doc.cli-type,
     8858          input  t-doc.cli-code,
     8859          input  t-doc.obj-type,
     8860          input  t-doc.obj-code,
     8861          input  ?,
     8862          input  ?,
     8863          input  ?,
     8864          input  t-doc.base-rate,
     8865          input  t-doc.base-scale,
     8866          input  varexch-code,
     8867          input  varexch-rate,
     8868          input  varexch-scale,
     8869          input  ?,
     8870          input  varhvrdtax,
     8871          input  t-doc.contract-code,
     8872          input  table tt-chs-parts,
     8873          output varprice-base,
     8874          output varsum-base,
     8875          output varprice-rubl,
     8876          output varsum-rubl,
     8877          input-output varcli-base-rate,
     8878          input-output varvat-type,
     8879          input-output varslt-type,
     8880          output varprice-cli,
     8881          output varsum-cli,
     8882          output varvat-pc,
     8883          output varvat-base,
     8884          output varsum-vat-base,
     8885          output varvat-rubl,
     8886          output varsum-vat-rubl,
     8887          output varvat-cli,
     8888          output varsum-vat-cli,
     8889          output varslt-pc,
     8890          output varslt-base,
     8891          output varsum-slt-base,
     8892          output varslt-rubl,
     8893          output varsum-slt-rubl,
     8894          output varslt-cli,
     8895          output varsum-slt-cli,
     8896          output varroad-tax-base,
     8897          output varsum-road-tax-base,
     8898          output varroad-tax-rubl,
     8899          output varsum-road-tax-rubl,
