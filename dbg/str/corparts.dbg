     2855           and buf_orig_parts-supp.artic     = p-artic
     2856           and buf_orig_parts-supp.prod-type = p-prod-type
     2857           and buf_orig_parts-supp.prod-code = p-prod-code
     2858           and buf_orig_parts-supp.part-code = p-orig-part-code
     2859         no-error .
