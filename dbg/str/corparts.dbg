     2962        buf_parts.doc-type = 'акт':U then do:
     2963       assign
     2964         in-vatp-have-vat-slt = yes.
     2965     end.
     2966     else do:
     2967       find first in-vatp_doc-attr no-lock
     2968         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     2969           and in-vatp_doc-attr.attr-code = 'envd':U
     2970         no-error .
     2971       if not available in-vatp_doc-attr then do:
     2972         assign
     2973           in-vatp-have-vat-slt = yes.
     2974       end.
     2975       else do:
     2976            in-vatp-have-vat-slt = no.
     2977       end.
     2978     end.
     2979     assign
     2980      price-cli-with-tax-loc = buf_parts.price-cli
     2981      cli-base-rate          = buf_parts.cli-base-rate.
     2982     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2983              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2984     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2985             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2986             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2987             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2988             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2989             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2990             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2991       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2992     assign
     2993       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2994     assign
     2995       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2996       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2997       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2998       transport-cli-loc  = 0
     2999       other-cli-loc      = 0
     3000     .
     3001   ASSIGN
     3002             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3003       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3004   .
     3005         assign
     3006           buf_parts-supp.PS                = buf_parts.PS
     3007           buf_parts-supp.SLT-type          = buf_parts.SLT-type
     3008           buf_parts-supp.VAT-type          = buf_parts.VAT-type
     3009           buf_parts-supp.base-rate         = v-base-rate
     3010           buf_parts-supp.base-scale        = v-base-scale
     3011           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
     3012           buf_parts-supp.cst-code          = buf_parts.cst-code
     3013           buf_parts-supp.doc-qnty          = buf_parts.qnty
     3014           buf_parts-supp.exch-code         = buf_parts.exch-code
     3015           buf_parts-supp.exch-rate         = v-exch-rate
     3016           buf_parts-supp.exch-scale        = v-exch-scale
