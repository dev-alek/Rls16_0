     1959       bfpc_tt-allsum.road-tax-rubl-cur   = bf_tt-allsum.road-tax-rubl-cur   - bf_tt-allsum.road-tax-rubl-acc
     1960       bfpc_tt-allsum.excise-base-cur     = bf_tt-allsum.excise-base-cur
     1961       bfpc_tt-allsum.excise-rubl-cur     = bf_tt-allsum.excise-rubl-cur
     1962       bfpc_tt-allsum.sum-dsc-base-acc    = 0
