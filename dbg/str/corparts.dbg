     4941     br:num-locked-columns    in frame d-doc = 5
     4942     br-op:num-locked-columns in frame d-doc = 3
     4943     br-cp:num-locked-columns in frame d-doc = 1
     4944     frame d-doc:scrollable  = false
     4945          .
     4946   assign
     4947     r-reas            :tooltip in frame d-doc = "Основание (причина) создания документа. Вызов справочника"
     4948     t-doc.reason-code :tooltip in frame d-doc = "Основание (причина) создания документа. Ввод кода"
     4949     rsn-name          :tooltip in frame d-doc = "Основание (причина) создания документа"
     4950   .
     4951   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4952   DEF VAR cur-clmn-numbr-op as INT EXTENT 17 no-undo.
     4953   DEF VAR varmvibr-op       as INT no-undo.
     4954   DEF VAR varmvjbr-op       as INT no-undo.
     4955   DEF VAR varmvkbr-op       as INT no-undo.
     4956   DEF VAR varmvlbr-op       as INT no-undo.
     4957   DEF VAR move-elementbr-op as INT no-undo.
     4958   def var jjbr-op           as int no-undo.
     4959   do varmvibr-op = 1 to EXTENT(cur-clmn-numbr-op):
     4960     ASSIGN cur-clmn-numbr-op[varmvibr-op] = varmvibr-op.
     4961   END.
     4962   RUN start-mv-clmnbr-op.
     4963   PROCEDURE start-mv-clmnbr-op:
     4964   def var old-session as logical no-undo.
     4965      old-session = SESSION:IMMEDIATE-DISPLAY.
     4966      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4967      SESSION:IMMEDIATE-DISPLAY = old-session.
     4968   END.
     4969   ON ctrl-cursor-right OF BROWSE br-op do:
     4970     RUN re-move-clmnbr-op ( 4, 17).
     4971   END.
     4972   ON ctrl-cursor-left OF BROWSE br-op do:
     4973     RUN re-move-clmnbr-op (17, 4).
     4974   END.
     4975   PROCEDURE re-move-clmnbr-op:
     4976     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4977     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4978     DO varmvibr-op = 1 TO EXTENT(cur-clmn-numbr-op):
     4979       if cur-clmn-numbr-op[varmvibr-op] = source-column THEN cur-clmn-numbr-op[varmvibr-op] = -1.
     4980     END.
     4981     if br-op:MOVE-COLUMN(source-column, target-column) IN FRAME d-doc then.
     4982     if source-column > target-column THEN
     4983     DO varmvjbr-op = source-column - 1 to target-column BY -1:
     4984       DO varmvibr-op = 1 TO EXTENT(cur-clmn-numbr-op):
     4985           if cur-clmn-numbr-op[varmvibr-op] = varmvjbr-op THEN DO:
     4986             cur-clmn-numbr-op[varmvibr-op] = cur-clmn-numbr-op[varmvibr-op] + 1.
     4987           END.
     4988       END.
     4989     END.
     4990     ELSE
     4991     DO varmvjbr-op = source-column + 1 to target-column:
     4992       DO varmvibr-op = 1 TO EXTENT(cur-clmn-numbr-op):
     4993         if cur-clmn-numbr-op[varmvibr-op] = varmvjbr-op THEN DO:
     4994           cur-clmn-numbr-op[varmvibr-op] = cur-clmn-numbr-op[varmvibr-op] - 1.
     4995         END.
     4996       END.
     4997     END.
     4998     DO varmvibr-op = 1 TO EXTENT(cur-clmn-numbr-op):
     4999       if cur-clmn-numbr-op[varmvibr-op] = -1 THEN cur-clmn-numbr-op[varmvibr-op] = target-column.
     5000     END.
     5001   END PROCEDURE.
     5002   PROCEDURE ch-clmnbr-op:
     5003     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5004     if cur-clmn-loc <= 4 then do:
     5005       return .
     5006     end.
     5007     DO varmvibr-op = 1 TO EXTENT(cur-clmn-numbr-op):
     5008       if cur-clmn-numbr-op[varmvibr-op] = cur-clmn-loc THEN move-elementbr-op = varmvibr-op.
     5009     END.
     5010     RUN re-move-clmnbr-op (cur-clmn-loc, 4).
     5011   END PROCEDURE.
     5012   PROCEDURE mv-brw-defaultbr-op:
     5013   def var old-session as logical no-undo.
     5014     old-session = SESSION:IMMEDIATE-DISPLAY.
     5015     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5016     do varmvlbr-op = 4 to EXTENT(cur-clmn-numbr-op):
     5017       RUN re-move-clmnbr-op (cur-clmn-numbr-op[varmvlbr-op], varmvlbr-op).
     5018     END.
     5019     RUN start-mv-clmnbr-op.
     5020     SESSION:IMMEDIATE-DISPLAY = old-session.
     5021   END PROCEDURE.
     5022   .
     5023   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5024   DEF VAR cur-clmn-numbr-cp as INT EXTENT 15 no-undo.
