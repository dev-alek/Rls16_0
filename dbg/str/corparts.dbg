     2427   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2429     (input  bf_goods.gds-code
     2430     ,input  '1':U
     2431     ,input  bf_trn-doc.fact-date
     2432     ,input  bf_trn-doc.host-code
     2433     ,input  bf_trn-doc.obj-type
     2434     ,input  bf_trn-doc.obj-code
     2435     ,output varcur-vat-pc
     2436     ) no-error .
     2437       if varcur-vat-pc = ?
     2438       then do:
     2439         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2440       end.
     2441       if varcur-slt-pc = ?
     2442       then do:
     2443         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2444       end.
     2445       v-calcbypart = no.
     2446       if bf_doc-line.whole-send-news = integer('1':U)   then
     2447       v-calcbypart = yes.
     2448       else do:
     2449       for each bf_gds-dtl no-lock
     2450         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2451           and bf_gds-dtl.artic     = bf_doc-line.artic
     2452           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2453           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
