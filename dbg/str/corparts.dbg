      107   procedure vss-get-info :
      108     define output parameter p-vss-revision    like vss-revision    no-undo .
      109     define output parameter p-vss-author      like vss-author      no-undo .
      110     define output parameter p-vss-date        like vss-date        no-undo .
      111     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      112     define output parameter p-vss-archive     like vss-archive     no-undo .
      113     define output parameter p-vss-description like vss-description no-undo .
      114     assign
      115       p-vss-revision    = vss-revision
      116       p-vss-author      = vss-author
      117       p-vss-date        = vss-date
      118       p-vss-workfile    = vss-workfile
      119       p-vss-archive     = vss-archive
      120       p-vss-description = vss-description
      121     .
      122   end procedure.
      123   procedure vss-get-parameters :
      124     define output parameter p-vss-parameters as character no-undo .
      125   end procedure.
      126   define new global shared variable g#vssrevis-logger as handle    no-undo .
      127   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      128   define variable v-vssrevis-logger                   as handle    no-undo .
      129   procedure vss-logevent :
      130     define input  parameter p-extra-paramters as character no-undo .
      131     define variable v-vssrevis-parameters as character no-undo .
      132     do
      133     on error undo, return error return-value
      134     :
      135       if  valid-handle(v-vssrevis-logger)
      136       and v-vssrevis-logger :get-signature("logevent") <> ""
      137       then do:
      138         run vss-get-parameters in this-procedure
      139           (output v-vssrevis-parameters
      140           ).
      141         run logevent in v-vssrevis-logger
      142           (input vss-workfile
      143           ,input vss-revision
      144           ,input v-vssrevis-parameters
      145           ,input p-extra-paramters
      146           ).
      147       end.
      148     end.
      149   end procedure.
      150   assign
      151     v-vssrevis-logger = g#vssrevis-logger
      152   .
      153   if  valid-handle(v-vssrevis-logger)
      154   and v-vssrevis-logger :get-signature("logevent") <> ""
      155   then do:
      156     assign
      157       v-vssrevis-logevent = true
      158     .
      159     run vss-logevent in this-procedure (input vss-description) .
      160   end.
      161   define new global shared variable g#language as character no-undo .
      162   if g#language <> '' and g#language <> 'rus':U then do:
      163     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      164   end.
      165   define new global shared variable g#library  as handle no-undo .
      166   define new global shared variable g#library2 as handle no-undo .
      167   procedure proc-alt-shift-f2:
      168     if not ibs.th.gbl.gbl-var:rcode
      169   then
      170     run gbl\inidebug.p .
      171   end.
      172   procedure proc-alt-shift-f3:
      173     run gbl/prvssinf.p
      174       ( input this-procedure
      175       ) .
      176   end.
      177   define variable v-inform-launched as logical no-undo initial false .
      178   procedure proc-alt-shift-f4:
      179     define variable v-action as character no-undo .
      180     if v-inform-launched = false then do:
      181       assign
      182         v-inform-launched = true
      183       .
      184       run gbl/d-inform.w
      185         (  input self
      186         ,  input this-procedure
      187         , output v-action
      188         ) no-error .
      189       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      190       assign
      191         v-inform-launched = false
      192       .
      193     end.
      194   end.
      195   procedure proc-alt-f1:
      196     run gbl/corrhelp.p
      197       (input this-procedure
      198       ) .
      199   end .
      200   on alt-shift-f2 anywhere do:
      201     run proc-alt-shift-f2.
      202   end.
      203   on alt-shift-f3 anywhere do:
      204     run proc-alt-shift-f3 in this-procedure .
      205   end.
      206   on alt-shift-f4 anywhere do:
      207     run proc-alt-shift-f4 in this-procedure.
      208   end.
      209   on alt-f1 anywhere do:
      210     run proc-alt-f1 in this-procedure .
      211   end.
      212   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      213   define variable v-waitfram-action01         as character   no-undo .
      214   define variable v-waitfram-action02         as character   no-undo .
      215   define variable v-waitfram-action03         as character   no-undo .
      216   define variable mWaitFramTextBeg            as character   no-undo.
      217   define variable mWaitFramTextEnd            as character   no-undo.
      218   define variable mWaitFramView               as logical     no-undo.
      219   define variable mWaitProcEvent              as logical     no-undo init yes.
      220   define variable mWaitFramInterval           as integer     no-undo init 1 .
      221   define variable mWaitFramStop               as logical     no-undo.
      222   define variable mWaitFramStopUser           as logical     no-undo.
      223   define variable mWaitFramStopTimeOut        as logical     no-undo.
      224   define variable mWaitFramStartProc          as datetime-tz no-undo.
      225   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      226   define button B-WaitFramStop auto-end-key
      227        label "Стоп"
      228        size 10 by 1 tooltip "Остоновить процесс".
      229   define button B-viewProcInfo
      230        label "Информация"
      231        size 15 by 1 tooltip "Информация о процесс".
      232   define frame waitfram
      233     v-waitfram-action01 format "x(72)" no-label skip
      234     v-waitfram-action02 format "x(72)" no-label skip
      235     v-waitfram-action03 format "x(72)" no-label skip
      236     B-viewProcInfo
      237     B-WaitFramStop at row 4 col 30
      238     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      239     .
      240   define new global shared variable mBatchMode as logical no-undo init ?.
      241   define variable mFramBachModHandle as handle no-undo.
      242   mFramBachModHandle = frame waitfram:handle.
      243   define variable mFameOldVis as logical no-undo.
      244   define variable mVisCUrentVin as logical no-undo.
      245   if session:batch-mode
      246   then
      247      mBatchMode = yes.
      248   if mBatchMode = ? then do:
      249     mVisCUrentVin = current-window:visible.
      250     mFameOldVis = mFramBachModHandle:visible.
      251     mFramBachModHandle:visible  = yes.
      252     mBatchMode = mFramBachModHandle:visible ne yes.
      253     mFramBachModHandle:visible = mFameOldVis.
      254     current-window:visible = mVisCUrentVin.
      255   end.
      256    if  log-manager:logfile-name ne ?
      257     then DO:
      258         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      259         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      260         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      261     end.
      262   on choose of B-WaitFramStop in frame waitfram
      263   do:
      264     mWaitFramStop = yes.
      265     mWaitFramStopUser = yes.
      266   end.
      267   function waitfram-check-timeout returns logical():
      268      define variable vtime as int64 no-undo.
      269      if mWaitFramStopTimeOut
      270      then
      271         return yes.
      272      vtime = ( now - mWaitFramStartProc ) / 1000 .
      273      if     mWaitFramTimeOut ne ?
      274         and mWaitFramTimeOut ne 0
      275         and mWaitFramTimeOut lt vtime
      276      then do:
      277         mWaitFramStopTimeOut = yes.
      278      end.
      279      return mWaitFramStopTimeOut.
      280   end.
      281   procedure waitfram-hide :
      282     if not session:batch-mode
      283     then do
      284     on error undo, return error return-value
      285     :
      286       pause 0 before-hide .
      287       if not mBatchMode then
      288         hide frame waitfram .
      289     end.
      290   end procedure.
      291   procedure waitfram-show :
      292     define input  parameter p-message as character no-undo .
      293     define variable v-left-margin as integer   no-undo .
      294     if not session:batch-mode
      295     then do
      296     on error undo, return error return-value
      297     :
      298       if length(p-message) <= 70 then do:
      299         assign
      300           v-left-margin = integer((70 - length(p-message)) / 2)
      301         .
      302         assign
      303           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      304         .
      305         assign
      306           v-waitfram-action01 = " "
      307           v-waitfram-action02 = " "
      308                                    + fill(" ", v-left-margin)
      309                                    + p-message
      310           v-waitfram-action03 = " "
      311         .
      312       end.
      313       else do:
      314         define variable vRindex1 as integer no-undo.
      315         define variable vRindex2 as integer no-undo.
      316         vRindex1 = r-index(p-message," ",70).
      317         if vRindex1 = 0
      318         then
      319            vRindex1 = 70.
      320         if length(p-message)  <= vRindex1 + 70 then do:
      321           assign
      322             v-waitfram-action01 = " "
      323             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      324             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      325           .
      326         end.
      327         else do:
      328           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      329           if vRindex2 <= vRindex1
      330           then
      331              vRindex2 = vRindex1 + 70.
      332           assign
      333             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      334             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      335             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      336           .
      337         end.
      338       end.
      339       B-viewProcInfo:visible   in frame waitfram = no.
      340       B-viewProcInfo:sensitive in frame waitfram = no.
      341       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      342       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      343       if  (   mWaitFramView
      344          or  mWaitProcEvent)
      345          and not mBatchMode
      346       then
      347          display
      348             v-waitfram-action01 skip
      349             v-waitfram-action02 skip
      350             v-waitfram-action03 skip
      351          with frame waitfram .
      352     end.
      353   end procedure.
      354      procedure waitfram-show-this:
      355         define input  parameter iInterval as int64 no-undo.
      356         define variable vtime as int64 no-undo.
      357         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      358         mWaitFramInterval = iInterval.
      359         run waitfram-show (substitute("&1&2 &3&4" ,
      360                                       mWaitFramTextBeg ,
      361                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      362                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      363                                       mWaitFramTextEnd
      364                                      )
      365                           ).
      366      end.
      367      procedure WaitFramRunPause:
      368         define input  parameter iInterval as dec no-undo.
      369         define variable vStart  as datetime-tz no-undo.
      370         define variable vend    as datetime-tz no-undo.
      371         define variable vint as int64 no-undo.
      372         define variable vOk as logical no-undo.
      373         vStart = now.
      374         vend   = vStart.
      375         publish "WaitFramPause" (iInterval,output vOk).
      376         vend   =  now.
      377         vint = vend - vStart.
      378         vint = iInterval - vint / 1000.
      379         if     not mWaitFramStop
      380            and (   vint > 0
      381                 or (    not vOk
      382                     and iInterval eq ?
      383                     )
      384                 )
      385         then
      386            run waitfram-show-this (iInterval).
      387         vend   =  now.
      388         vint = vend - vStart.
      389         vint = iInterval - vint / 1000.
      390         if     not mWaitFramStop
      391            and vint > 0
      392         then do:
      393            run gbl/pause.p (vint * 1000).
      394         end.
      395         if iInterval ne ?
      396         then
      397            publish "WaitFramStop".
      398         waitfram-check-timeout().
      399      end.
      400      procedure WaitFramWaitFor:
      401         define input  parameter iInterval as dec no-undo.
      402         assign
      403            mWaitFramStartProc   = now
      404            mWaitFramStopUser    = no
      405            mWaitFramStopTimeOut = no
      406         .
      407         block-wait:
      408         do while not mWaitFramStop:
      409            run WaitFramRunPause (iInterval).
      410            if  waitfram-check-timeout()
      411            then do:
      412               leave block-wait.
      413            end.
      414         end.
      415         run waitfram-hide.
      416      end.
      417   procedure waitfram-join :
      418     define input  parameter p-line-1  as character no-undo .
      419     define input  parameter p-line-2  as character no-undo .
      420     define input  parameter p-line-3  as character no-undo .
      421     define output parameter p-message as character no-undo .
      422     do
      423     on error undo, return error return-value
      424     :
      425       assign
      426         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      427                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      428                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      429       .
      430     end.
      431   end procedure.
      432   function waitfram-join-function returns character
      433     (input p-line-1 as character
      434     ,input p-line-2 as character
      435     ,input p-line-3 as character
      436     ).
      437     define variable v-message as character no-undo .
      438     run waitfram-join in this-procedure
      439       (input  p-line-1
      440       ,input  p-line-2
      441       ,input  p-line-3
      442       ,output v-message
      443       ) .
      444     return v-message .
      445   end function .
      446   function hvrdtax return logical (input parrecid as recid):
      447   define variable varresult as logical no-undo.
      448   run hvrdtax-proc (input parrecid, output varresult).
      449   return varresult.
      450   end function.
      451   procedure hvrdtax-proc:
      452   define input  parameter parrecid  as recid   no-undo.
      453   define output parameter parresult as logical no-undo.
      454   define buffer bf_goods for ub.goods.
      455   define buffer bf_units for ub.units.
      456   define buffer rt_tax   for ub.tax.
      457   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      458   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      459   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      460   if available rt_tax and
      461       can-find(first ub.tax-units No-LOCK WHERE
      462                      ub.tax-units.tax-code = rt_tax.tax-code AND
      463                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      464                                                       else assign parresult = no.
      465   end procedure.
      466   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   function octal-to-char return character
      468   ( p-string as character ) :
      469     def var v-asc     as integer no-undo .
      470     def var v-new-asc as integer no-undo .
      471     def var ind       as integer no-undo .
      472     if length(p-string) <> 3 then do:
      473       return ? .
      474     end.
      475     assign
      476       v-asc = 0
      477     .
      478     do ind = 1 to length(p-string)
      479     :
      480       assign
      481         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      482       .
      483       if v-new-asc < 0 or v-new-asc >= 8 then do:
      484         return ? .
      485       end.
      486       assign
      487         v-asc = v-asc * 8 + v-new-asc
      488       .
      489     end.
      490     return chr(v-asc) .
      491   end function .
      492   function char-to-octal return character
      493   ( p-chr as character ) :
      494     def var v-asc    as integer   no-undo .
      495     def var ind      as integer   no-undo .
      496     def var v-string as character no-undo .
      497     if length(p-chr) <> 1 then do:
      498       return ? .
      499     end.
      500     assign
      501       v-asc    = asc(p-chr)
      502       v-string = ""
      503     .
      504     do ind = 1 to 3
      505     :
      506       assign
      507         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      508       .
      509       assign
      510         v-asc = truncate(v-asc / 8, 0)
      511       .
      512     end.
      513     return v-string .
      514   end.
      515   function str-encode return character
      516   (   p-init-string       as character
      517     , p-encode-char       as character
      518     , p-special-char-list as character
      519   ) :
      520     def var p-encode-string as character no-undo .
      521     def var ind                as integer no-undo .
      522     def var v-num-special-char as integer no-undo .
      523     def var v-special-char     as character no-undo .
      524     if p-encode-char = ?
      525     or p-encode-char = "" then do:
      526       assign
      527         p-encode-char = "~~"
      528       .
      529     end.
      530     if p-init-string = ? then do:
      531       return "?" .
      532     end.
      533     if p-init-string = "?" then do:
      534       return p-encode-char + char-to-octal("?") .
      535     end.
      536     assign
      537       v-num-special-char = length(p-special-char-list)
      538       p-encode-string    = replace(p-init-string
      539                                   ,p-encode-char
      540                                   ,p-encode-char + char-to-octal(p-encode-char)
      541                                   )
      542     .
      543     do ind = 1 to v-num-special-char
      544     :
      545       assign
      546         v-special-char = substring(p-special-char-list, ind, 1)
      547       .
      548       if v-special-char <> p-encode-char then do:
      549         assign
      550           p-encode-string = replace (p-encode-string
      551                                     ,v-special-char
      552                                     ,p-encode-char + char-to-octal(v-special-char)
      553                                     )
      554         .
      555       end.
      556     end.
      557     return p-encode-string .
      558   end.
      559   function str-decode returns character
      560     (p-init-string   as character
      561     ,p-encode-char   as character
      562     ) :
      563     def var p-decode-string as character no-undo .
      564     def var ind                       as integer no-undo .
      565     def var v-num-entries-init-string as integer no-undo .
      566     def var v-sub-phrase              as character no-undo .
      567     def var v-special-char            as character no-undo .
      568     if p-encode-char = ?
      569     or p-encode-char = "" then do:
      570       assign
      571         p-encode-char = "~~"
      572       .
      573     end.
      574     if p-init-string = "?" then do:
      575       return ? .
      576     end.
      577     assign
      578       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      579     .
      580     if v-num-entries-init-string > 1 then do:
      581       assign
      582         p-decode-string = entry(1, p-init-string, p-encode-char)
      583       .
      584       do ind = 2 to v-num-entries-init-string
      585       :
      586         assign
      587           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      588         .
      589         assign
      590           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      591         .
      592         if v-special-char <> ? then do:
      593           assign
      594             p-decode-string = p-decode-string
      595                             + v-special-char
      596                             + substring(v-sub-phrase, 4)
      597           .
      598         end.
      599         else do:
      600           assign
      601             p-decode-string = p-decode-string
      602                             + p-encode-char
      603                             + v-sub-phrase
      604           .
      605         end.
      606       end.
      607     end.
      608     else do:
      609       assign
      610         p-decode-string = p-init-string
      611       .
      612     end.
      613     return p-decode-string .
      614   end.
      615   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   procedure doc-code:
      617   define input  parameter parmode          as   character           no-undo.
      618   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      619   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      620   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      621   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      622   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      623   define variable vardb-remote     as   logical             no-undo.
      624   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      625   define variable v-delimiter as character no-undo .
      626   do
      627   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      628   :
      629   find first buf_sys-ctrl no-lock .
      630   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      631     CASE parmode:
      632       when "main":u then do:
      633         if vardb-remote then do:
      634           assign
      635             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      636         end.
      637         else do:
      638           assign
      639             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      640         end.
      641       end.
      642       when "trio" then do:
      643         assign
      644           pardoc-code = replace (parroot-doc-code, "=", "*").
      645       end.
      646       otherwise do:
      647         assign
      648         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      649         no-error
      650         .
      651         if error-status:error  then do:
      652           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      653                                         ,chr(10)
      654                                         ,parmode
      655                                         ).
      656         end.
      657         if num-entries(parmode) = 1
      658         and parmode <> "chip":U
      659         and parmode <> "chip_s":U
      660         then do:
      661           assign
      662           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      663         end.
      664         else if (lookup("chip":U, parmode) > 0
      665                  or
      666                  lookup("chip_s":U, parmode) > 0) then do:
      667           assign
      668             vartemp-doc-code = parroot-doc-code.
      669           do while true:
      670             if index (vartemp-doc-code , ".") = 0 then
      671               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      672             else
      673               vartemp-doc-code  =
      674               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      675               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      676               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      677             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      678           end.
      679           assign
      680             pardoc-code = vartemp-doc-code.
      681         end.
      682       end.
      683     end CASE.
      684     if pardoc-code = '':U
      685     or (parroot-doc-code <> '':U
      686     and pardoc-code = parroot-doc-code) then do:
      687       undo, return error substitute("Ошибка при генерации номера документа&1"
      688                                     ,chr(10)).
      689     end.
      690   end.
      691   end. // procedure/method
      692   function get-doc-code-int64 returns int64
      693     ( input p-doc-code as character ) :
      694     define variable v-ind              as integer   no-undo .
      695     define variable v-num-entries      as integer   no-undo .
      696     define variable v-doc-code-int64   as int64     no-undo .
      697     define variable v-canonic-doc-code as character no-undo .
      698     assign
      699       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      700       v-canonic-doc-code = p-doc-code
      701     .
      702     do v-ind = 1 to v-num-entries
      703     :
      704       assign
      705         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      706       .
      707     end.
      708     assign
      709       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      710     .
      711     return v-doc-code-int64 .
      712   end. // function/method
      713   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   FUNCTION title-mode RETURNS CHARACTER
      715     ( INPUT pmode as character ) :
      716   DEFINE VARIABLE ptitle-mode as character no-undo.
      717   CASE ENTRY(1, pmode) :
      718     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
      719     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
      720     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
      721   END CASE.
      722     RETURN ptitle-mode.
      723   END FUNCTION.
