     5433   procedure local-psn-chk :
     5434     define input parameter parman    as character no-undo.
     5435     define input parameter paraction as character no-undo.
     5436     if parman = "agnt" and paraction = "ret-mouse" then do:
     5437     define variable v-ref-rec41   as recid no-undo .
