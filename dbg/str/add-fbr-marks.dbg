        1   using ibs.th.str.marking.handlers.*.
        2   using ibs.th.skt.*.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Сканирование акцизных марок".
        9   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       10   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "X(65)" no-undo
      117   initial "@(#)$Workfile$ $Revision$".
      118   define temp-table temp_fbr-history no-undo like ub.fbr-history .
      119   define variable v-fbrhist-history-level     as integer      no-undo.
      120   define variable v-fbrhist-upper-obj-type    as character    no-undo.
      121   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
      122   define variable v-fbrhist-upper-code        as integer      no-undo.
      123   define variable v-fbrhist-current-obj-type  as character    no-undo.
      124   define variable v-fbrhist-current-obj-code  as integer      no-undo.
      125   define variable v-fbrhist-current-code      as integer      no-undo.
      126   define variable v-fbrhist-saved-obj-type    as character    no-undo.
      127   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
      128   define variable v-fbrhist-saved-code        as integer      no-undo.
      129   procedure fbrhist-write :
      130   define input parameter p-userid                 as character        no-undo.
      131   define input parameter p-obj-type               as character        no-undo.
      132   define input parameter p-obj-code               as integer          no-undo.
      133   define input parameter p-hst-type               as character        no-undo.
      134   define input parameter p-hst-level              as integer          no-undo.
      135   define input parameter p-procedure-name         as character        no-undo.
      136   define input parameter p-procedure-parameters   as character        no-undo.
      137   define input parameter p-doc-code               as character        no-undo.
      138   define input parameter p-doc-type               as character        no-undo.
      139   define input parameter p-status_                as character        no-undo.
      140   define input parameter p-is-free                as logical          no-undo.
      141   define input parameter p-recipe-code            as character        no-undo.
      142   define input parameter p-recipe-type            as character        no-undo.
      143   define input parameter p-gds-code               as integer          no-undo.
      144   define input parameter p-trn-type               as character        no-undo.
      145   define input parameter p-qnty                   as decimal          no-undo.
      146   define input parameter p-PS                     as character        no-undo.
      147   define input parameter p-is-error               as logical          no-undo.
      148       define variable v-today                         as date         no-undo.
      149       define variable v-obj-date                      as date         no-undo.
      150       define variable v-time                          as integer      no-undo.
      151       define variable v-host-code                     as integer      no-undo.
      152       define variable v-db-num                        as integer      no-undo.
      153       define buffer buf_temp_fbr-history       for temp_fbr-history.
      154       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
      155   do
      156   for buf_temp_fbr-history
      157     , buf_upper_temp_fbr-history
      158   on error undo, return error
      159   :
      160       if v-fbrhist-history-level = 0
      161       or v-fbrhist-history-level < p-hst-level
      162       then do:
      163           undo, return .
      164       end.
      165       if v-fbrhist-upper-code <> 0
      166       then do:
      167           find first buf_upper_temp_fbr-history no-lock
      168                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
      169                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
      170                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
      171           no-error.
      172       end.
      173   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      175     (input  p-obj-type
      176     ,input  p-obj-code
      177     ,output v-obj-date
      178     )  .
      179       run cur-time in this-procedure (
      180             output v-today
      181           , output v-time
      182       ).
      183   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      185     (input  p-obj-type
      186     ,input  p-obj-code
      187     ,output v-host-code
      188     )  .
      189   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      191     (output v-db-num
      192     )  .
      193       create buf_temp_fbr-history.
      194       assign
      195           buf_temp_fbr-history.obj-type                = p-obj-type
      196           buf_temp_fbr-history.obj-code                = p-obj-code
      197           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
      198           buf_temp_fbr-history.hst-type                = p-hst-type
      199           buf_temp_fbr-history.hst-level               = p-hst-level
      200           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
      201           buf_temp_fbr-history.procedure-name          = p-procedure-name
      202           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
      203           buf_temp_fbr-history.doc-code                = p-doc-code
      204           buf_temp_fbr-history.doc-type                = p-doc-type
      205           buf_temp_fbr-history.status_                 = p-status_
      206           buf_temp_fbr-history.is-free                 = p-is-free
      207           buf_temp_fbr-history.recipe-code             = p-recipe-code
      208           buf_temp_fbr-history.recipe-type             = p-recipe-type
      209           buf_temp_fbr-history.gds-code                = p-gds-code
      210           buf_temp_fbr-history.trn-type                = p-trn-type
      211           buf_temp_fbr-history.qnty                    = p-qnty
      212           buf_temp_fbr-history.PS                      = p-ps
      213           buf_temp_fbr-history.is-error                = p-is-error
      214           buf_temp_fbr-history.db-num                  = v-db-num
      215           buf_temp_fbr-history.user-name               = p-userid
      216           buf_temp_fbr-history.sys-date                = v-today
      217           buf_temp_fbr-history.sys-time-int            = v-time
      218           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
      219           buf_temp_fbr-history.obj-date                = v-obj-date
      220           buf_temp_fbr-history.host-code               = v-host-code
      221       .
      222       assign
      223           v-fbrhist-current-obj-type                   = p-obj-type
      224           v-fbrhist-current-obj-code                   = p-obj-code
      225           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
      226       .
      227       if available buf_upper_temp_fbr-history
      228       then do:
      229           assign
      230               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
      231                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
      232                                               + "-":U + string( buf_temp_fbr-history.obj-code )
      233                                               + "-":U + string( buf_temp_fbr-history.hst-code )
      234           .
      235       end.
      236       else do:
      237           assign
      238               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
      239                                  + "-":U + string( buf_temp_fbr-history.obj-code )
      240                                  + "-":U + string( buf_temp_fbr-history.hst-code )
      241           .
      242       end.
      243   end.
      244   end procedure.
      245   procedure fbrhist-read-conf :
      246   do
      247   on error undo, return error
      248   :
      249      define variable v-value-character as character  no-undo .
      250      define variable v-value-date      as date       no-undo .
      251      define variable v-value-decimal   as decimal    no-undo .
      252      define variable v-value-logical   as logical    no-undo .
      253      define variable v-tth             as handle     no-undo .
      254      define variable v-param-type            as character no-undo .
      255      run adm/shattri.p ( input "get":U
      256                        , input  '':u
      257                        , input  0
      258                        , input  'fbrattr':U
      259                        , input  'fbrhstlv':U
      260                        , output v-value-character
      261                        , output v-value-date
      262                        , output v-value-decimal
      263                        , output v-fbrhist-history-level
      264                        , output v-value-logical
      265                        , output v-param-type
      266                        , input-output table-handle v-tth
      267                        ) no-error .
      268      if error-status :error then do:
      269         assign
      270            v-fbrhist-history-level = 0
      271         .
      272      end.
      273   end.
      274   end procedure.
      275   procedure fbrhist-table-to-base :
      276       define buffer buf_fbr-history       for ub.fbr-history.
      277       define buffer buf_temp_fbr-history  for temp_fbr-history.
      278   do
      279   for buf_fbr-history
      280     , buf_temp_fbr-history
      281   on error undo, return error
      282   :
      283       for each buf_temp_fbr-history
      284       on error undo, return error
      285       :
      286           create buf_fbr-history.
      287           buffer-copy buf_temp_fbr-history to buf_fbr-history.
      288       end.
      289   end.
      290   end procedure.
      291   procedure fbrhist-init :
      292       define buffer buf_temp_fbr-history      for temp_fbr-history.
      293   do
      294   for buf_temp_fbr-history
      295   on error undo, return error
      296   :
      297       for each buf_temp_fbr-history
      298       :
      299           delete buf_temp_fbr-history.
      300       end.
      301       assign
      302           v-fbrhist-upper-obj-type    = ""
      303           v-fbrhist-upper-obj-code    = 0
      304           v-fbrhist-upper-code        = 0
      305           v-fbrhist-current-obj-type  = ""
      306           v-fbrhist-current-obj-code  = 0
      307           v-fbrhist-current-code      = 0
      308           v-fbrhist-saved-obj-type    = ""
      309           v-fbrhist-saved-obj-code    = 0
      310           v-fbrhist-saved-code        = 0
      311       .
      312   end.
      313   end procedure.
      314   procedure fbrhist-set-upper-code :
      315   do
      316   on error undo, return error
      317   :
      318       assign
      319           v-fbrhist-upper-obj-type    = v-fbrhist-current-obj-type
      320           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
      321           v-fbrhist-upper-code        = v-fbrhist-current-code
      322       .
      323   end.
      324   end procedure.
      325   procedure fbrhist-save-current-code :
      326   do
      327   on error undo, return error
      328   :
      329       assign
      330           v-fbrhist-saved-obj-type    = v-fbrhist-current-obj-type
      331           v-fbrhist-saved-obj-code    = v-fbrhist-current-obj-code
      332           v-fbrhist-saved-code        = v-fbrhist-current-code
      333       .
      334   end.
      335   end procedure.
