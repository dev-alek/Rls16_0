      984   procedure xmlchar-test :
      985   define input parameter p-in-string          as character        no-undo.
      986   define output parameter p-out-string-enc    as character        no-undo.
      987   define output parameter p-out-string-dec    as character        no-undo.
      988   do
      989   on error undo, return error
      990   :
      991          run xmlchar-encode in this-procedure
      992       (
      993             input p-in-string
      994           , output p-out-string-enc
      995       ).
      996          run xmlchar-decode in this-procedure
      997       (
      998             input p-out-string-enc
      999           , output p-out-string-dec
     1000       ).
     1001   end.
     1002   end .
     1003   procedure xmlchar-encode :
     1004   define input parameter p-in-string      as character        no-undo.
     1005   define output parameter p-out-string    as character        no-undo.
     1006       define variable v-position      as integer      no-undo.
     1007       define variable v-current-char  as character    no-undo.
     1008   do
     1009   on error undo, return error
     1010   :
     1011       assign
     1012           p-out-string = "":U
     1013       .
     1014       case p-in-string
     1015       :
     1016           when ?
     1017           then do:
     1018               assign
     1019                   p-out-string = "?":U
     1020               .
     1021           end.
     1022           when "?":U
     1023           then do:
     1024               assign
     1025                   p-out-string = "&#63;":U
     1026               .
     1027           end.
     1028           otherwise do:
     1029               do v-position = 1 to length( p-in-string )
     1030               :
     1031                   assign
     1032                       v-current-char = substring( p-in-string, v-position, 1 )
     1033                   .
     1034                   case v-current-char
     1035                   :
     1036                       when "&":U
     1037                       then do:
     1038                           assign
     1039                               p-out-string = p-out-string + "&amp;":U
     1040                           .
     1041                       end.
     1042                       when ">":U
     1043                       then do:
     1044                           assign
     1045                               p-out-string = p-out-string + "&gt;":U
     1046                           .
     1047                       end.
     1048                       when "<":U
     1049                       then do:
     1050                           assign
     1051                               p-out-string = p-out-string + "&lt;":U
     1052                           .
     1053                       end.
     1054                       when "'":U
     1055                       then do:
     1056                           assign
     1057                               p-out-string = p-out-string + "&apos;":U
     1058                           .
     1059                       end.
     1060                       when '"':U
     1061                       then do:
     1062                           assign
     1063                               p-out-string = p-out-string + "&quot;":U
     1064                           .
     1065                       end.
     1066                       when chr(1)
     1067                       then do:
     1068                           assign
     1069                               p-out-string = p-out-string + "":U
     1070                           .
     1071                       end.
     1072                       when chr(2)
     1073                       then do:
     1074                           assign
     1075                               p-out-string = p-out-string + "":U
     1076                           .
     1077                       end.
     1078                       when chr(3)
     1079                       then do:
     1080                           assign
     1081                               p-out-string = p-out-string + "":U
     1082                           .
     1083                       end.
     1084                       when chr(4)
     1085                       then do:
     1086                           assign
     1087                               p-out-string = p-out-string + "":U
     1088                           .
     1089                       end.
     1090                       when chr(5)
     1091                       then do:
     1092                           assign
     1093                               p-out-string = p-out-string + "":U
     1094                           .
     1095                       end.
     1096                       when chr(6)
     1097                       then do:
     1098                           assign
     1099                               p-out-string = p-out-string + "":U
     1100                           .
     1101                       end.
     1102                       when chr(7)
     1103                       then do:
     1104                           assign
     1105                               p-out-string = p-out-string + "":U
     1106                           .
     1107                       end.
     1108                       when chr(8)
     1109                       then do:
     1110                           assign
     1111                               p-out-string = p-out-string + "":U
     1112                           .
     1113                       end.
     1114                       when chr(9)
     1115                       then do:
     1116                           assign
     1117                               p-out-string = p-out-string + "":U
     1118                           .
     1119                       end.
     1120                       when chr(29)
     1121                       then do:
     1122                           assign
     1123                               p-out-string = p-out-string + "":U
     1124                           .
     1125                       end.
     1126                       when chr(10)
     1127                       then do:
     1128                           assign
     1129                               p-out-string = p-out-string + "&#10;":U
     1130                           .
     1131                       end.
     1132                       when chr(13)
     1133                       then do:
     1134                           assign
     1135                               p-out-string = p-out-string + "&#13;":U
     1136                           .
     1137                       end.
     1138                       otherwise do:
     1139                           assign
     1140                               p-out-string = p-out-string + v-current-char
     1141                           .
     1142                       end.
     1143                   end case.
     1144               end.
     1145           end.
     1146       end case.
     1147   end.
     1148   end .
     1149   procedure xmlchar-encode-1c :
     1150   define input parameter p-in-string      as character        no-undo.
     1151   define output parameter p-out-string    as character        no-undo.
     1152       define variable v-position      as integer      no-undo.
     1153       define variable v-current-char  as character    no-undo.
     1154   do
     1155   on error undo, return error
     1156   :
     1157       assign
     1158           p-out-string = "":U
     1159       .
     1160       case p-in-string
     1161       :
     1162           when ?
     1163           then do:
     1164               assign
     1165                   p-out-string = "?":U
     1166               .
     1167           end.
     1168           otherwise do:
     1169               do v-position = 1 to length( p-in-string )
     1170               :
     1171                   assign
     1172                       v-current-char = substring( p-in-string, v-position, 1 )
     1173                   .
     1174                   case v-current-char
     1175                   :
     1176                       when chr(1)
     1177                       then do:
     1178                           assign
     1179                               p-out-string = p-out-string + " ":U
     1180                           .
     1181                       end.
     1182                       when chr(2)
     1183                       then do:
     1184                           assign
     1185                               p-out-string = p-out-string + " ":U
     1186                           .
     1187                       end.
     1188                       when chr(3)
     1189                       then do:
     1190                           assign
     1191                               p-out-string = p-out-string + " ":U
     1192                           .
     1193                       end.
     1194                       when chr(4)
     1195                       then do:
     1196                           assign
     1197                               p-out-string = p-out-string + " ":U
     1198                           .
     1199                       end.
     1200                       when chr(5)
     1201                       then do:
     1202                           assign
     1203                               p-out-string = p-out-string + " ":U
     1204                           .
     1205                       end.
     1206                       when chr(6)
     1207                       then do:
     1208                           assign
     1209                               p-out-string = p-out-string + " ":U
     1210                           .
     1211                       end.
     1212                       when chr(7)
     1213                       then do:
     1214                           assign
     1215                               p-out-string = p-out-string + " ":U
     1216                           .
     1217                       end.
     1218                       when chr(8)
     1219                       then do:
     1220                           assign
     1221                               p-out-string = p-out-string + " ":U
     1222                           .
     1223                       end.
     1224                       when chr(9)
     1225                       then do:
     1226                           assign
     1227                               p-out-string = p-out-string + " ":U
     1228                           .
     1229                       end.
     1230                       when chr(29)
     1231                       then do:
     1232                           assign
     1233                               p-out-string = p-out-string + " ":U
     1234                           .
     1235                       end.
     1236                       when chr(10)
     1237                       then do:
     1238                           assign
     1239                               p-out-string = p-out-string + " ":U
     1240                           .
     1241                       end.
     1242                       when chr(13)
     1243                       then do:
     1244                           assign
     1245                               p-out-string = p-out-string + " ":U
     1246                           .
     1247                       end.
     1248                       otherwise do:
     1249                           assign
     1250                               p-out-string = p-out-string + v-current-char
     1251                           .
     1252                       end.
     1253                   end case.
     1254               end.
     1255           end.
     1256       end case.
     1257   end.
     1258   end .
     1259   procedure xmlchar-decode :
     1260   define input parameter p-in-string      as character        no-undo.
     1261   define output parameter p-out-string    as character        no-undo.
     1262       define variable v-position      as integer      no-undo.
     1263       define variable v-last-position as integer      no-undo.
     1264       define variable v-temp-integer  as integer      no-undo.
     1265       define variable v-current-char  as character    no-undo.
     1266       define variable v-next-char     as character    no-undo.
     1267       define variable v-success       as logical      no-undo.
     1268   do
     1269   on error undo, return error
     1270   :
     1271       assign
     1272           p-out-string = "":U
     1273           v-position   = 0
     1274       .
     1275       replace-cycle:
     1276       do while yes
     1277       on error undo, return error
     1278       :
     1279           assign
     1280               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1281           .
     1282           if v-last-position <= v-position
     1283           then do:
     1284               if v-position = 0
     1285               then do:
     1286                   assign
     1287                       p-out-string = p-in-string
     1288                   .
     1289               end.
     1290               else do:
     1291                   assign
     1292                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1293                   .
     1294               end.
     1295               leave replace-cycle.
     1296           end.
     1297           else do:
     1298               assign
     1299                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1300                   v-position      = v-last-position
     1301                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1302               .
     1303               if v-current-char = "#":U
     1304               then do:
     1305                   assign
     1306                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1307                   .
     1308                   if v-last-position > 0
     1309                   then do:
     1310                       run xmlchar-read-integer in this-procedure
     1311                        (
     1312                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1313                           , output v-temp-integer
     1314                           , output v-success
     1315                       ).
     1316                       if v-success = yes
     1317                       and v-temp-integer >= 1
     1318                       and v-temp-integer <= 255
     1319                       then do:
     1320                           assign
     1321                               p-out-string = p-out-string + chr( v-temp-integer )
     1322                               v-position   = v-last-position + 1
     1323                           .
     1324                       end.
     1325                       else do:
     1326                           assign
     1327                               p-out-string = p-out-string + "&":U
     1328                               v-position   = v-position   + 1
     1329                           .
     1330                       end.
     1331                   end.
     1332                   else do:
     1333                       assign
     1334                           p-out-string = p-out-string + "&":U
     1335                           v-position   = v-position   + 1
     1336                       .
     1337                   end.
     1338               end.
     1339               else do:
     1340                   case substring( p-in-string, v-position + 1, 3 )
     1341                   :
     1342                       when "lt;":U
     1343                       then do:
     1344                           assign
     1345                               p-out-string = p-out-string + "<":U
     1346                               v-position   = v-position   + 3
     1347                           .
     1348                       end.
     1349                       when "gt;":U
     1350                       then do:
     1351                           assign
     1352                               p-out-string = p-out-string + ">":U
     1353                               v-position   = v-position   + 3
     1354                           .
     1355                       end.
     1356                       otherwise do:
     1357                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1358                           then do:
     1359                               assign
     1360                                   p-out-string = p-out-string + "&":U
     1361                                   v-position   = v-position   + 4
     1362                               .
     1363                           end.
     1364                           else do:
     1365                               case substring( p-in-string, v-position + 1, 5 )
     1366                               :
     1367                                   when "quot;":U
     1368                                   then do:
     1369                                       assign
     1370                                           p-out-string = p-out-string + '"':U
     1371                                           v-position   = v-position   + 5
     1372                                       .
     1373                                   end.
     1374                                   when "apos;":U
     1375                                   then do:
     1376                                       assign
     1377                                           p-out-string = p-out-string + "'":U
     1378                                           v-position   = v-position   + 5
     1379                                       .
     1380                                   end.
     1381                                   otherwise do:
     1382                                       assign
     1383                                           p-out-string = p-out-string + "&":U
     1384                                       .
     1385                                   end.
     1386                               end case.
     1387                           end.
     1388                       end.
     1389                   end case.
     1390               end.
     1391           end.
     1392       end.
     1393   end.
     1394   end .
     1395   procedure xmlchar-read-integer :
     1396   define input parameter p-input-string      as character        no-undo.
     1397   define output parameter p-output-integer   as integer          no-undo.
     1398   define output parameter p-success       as logical          no-undo.
     1399   do
     1400   on error undo, return error
     1401   :
     1402       assign
     1403           p-output-integer = integer( p-input-string )
     1404       no-error.
     1405       if error-status :error
     1406       then do:
     1407           assign
     1408               p-success           = no
     1409               p-output-integer    = 0
     1410           .
     1411       end.
     1412       else do:
     1413           assign
     1414               p-success           = yes
     1415           .
     1416       end.
     1417   end.
     1418   end.
     1419   define variable mMRCCode  as logical    no-undo.
     1420   define variable mTypeMark as character  no-undo.
     1421   function IS-NeedMark returns logical
     1422   ( input ib-code as integer  ,
     1423     input ib-str as character ):
     1424      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1425      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1426                                    and buf_prod-bc-attr.b-str  eq ib-str
     1427                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1428        no-lock no-error.
     1429      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1430   end.
     1431   function repTegforDm return char
     1432   (iDM as char ):
     1433       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1434       define variable vteg as character no-undo.
     1435       define variable oDM as character no-undo.
     1436       define variable vi as integer no-undo.
     1437       oDM = iDm.
     1438       do vi = 1 to num-entries(vTeglist):
     1439          vTeg = entry(vi,vTeglist).
     1440          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1441       end.
     1442       return oDM.
     1443   end.
     1444   function repSpecSimbforDm return char
     1445   (iDM as char ):
     1446       define variable oDM as character no-undo.
     1447     run
     1448       xmlchar-decode(iDM, output oDM).
     1449     return repTegforDm (oDM).
     1450   end.
     1451   function CheckGtin return logical
     1452   (iGtin as char):
     1453      define variable bar_code as character no-undo.
     1454      define variable vGtin as logical no-undo init "yes".
     1455      if length(iGtin) eq 14
     1456      then do:
     1457         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1458         run str/chk-sum.p
     1459          (input-output bar_code ) no-error .
     1460         if iGtin ne  bar_code
     1461         then
     1462            vGtin = no.
     1463      end.
     1464      else
     1465         vGtin = no.
     1466      return vgtin.
     1467   end.
     1468   function repSpecSimbforXlm return char
     1469   (iDM as char ):
     1470       iDM = replace(iDM,chr(29),"").
     1471       return iDM.
     1472   end.
     1473   function getGtinByDM return char
     1474   (IDM as char):
     1475      define variable VTXT as char no-undo.
     1476      define variable vGtin as char no-undo.
     1477      vTXt = IdM.
     1478      vGtin = IDM.
     1479      if    length(vtxt) > 14
     1480      then do:
     1481         if   vtxt begins "(01)"
     1482                or vtxt begins "(02)"
     1483         then
     1484            vGtin = substring(vtxt,5,14).
     1485         else if   (vtxt begins "01"
     1486                or vtxt begins "02" )
     1487                and (   (    substring(iDm,17,2) eq "21"
     1488                         and length(vtxt) >= 21)
     1489                     or substring(iDm,17,2) eq "37"
     1490                     or substring(iDm,17,4) eq "(37)" )
     1491         then do:
     1492            vGtin = substring(vtxt,3,14).
     1493            if not checkGtin(vGtin)
     1494            then
     1495               vGtin = substring(vtxt,1,14).
     1496         end.
     1497         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1498             or length(vtxt) eq 14 + 7 + 4
     1499             or length(vtxt) eq 14 + 7
     1500         then
     1501            vGtin = substring(vtxt,1,14).
     1502      end.
     1503      if not checkGtin(vGtin)
     1504      then
     1505         vGtin = "".
     1506      return vgtin.
     1507   end.
     1508   function getGdsCodeByGtin return int
     1509   (iGtin as char):
     1510      define buffer prod-bc  for ub.prod-bc.
     1511      define buffer bar-code for ub.bar-code.
     1512      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1513      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1514      return if avail bar-code then bar-code.gds-code else ?.
     1515   end.
     1516   function getQntyCodeByGtin return decimal
     1517   (iGtin as char):
     1518      define buffer prod-bc  for ub.prod-bc.
     1519      define buffer bar-code for ub.bar-code.
     1520      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1521      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1522      return if avail bar-code then bar-code.cli-base-rate else ?.
     1523   end.
     1524   function getGdsCodeByDM return int
     1525   (iDm as char):
     1526      define variable vGtin as char no-undo.
     1527      define buffer prod-bc for ub.prod-bc.
     1528      vGtin  = getGtinByDM (IDM ).
     1529      return getGdsCodeByGtin (vGtin).
     1530   end.
     1531   function ChekTypeMarkByGds return logical
     1532   (iGds-code as integer ):
     1533      define buffer goods-attr for ub.goods-attr.
     1534      find first goods-attr where goods-attr.gds-code   = iGds-code
     1535                              and goods-attr.attr-code  = 'mark-type':U
     1536      no-lock no-error.
     1537      if available goods-attr
     1538      then do:
     1539         mTypeMark = goods-attr.attr-value.
     1540         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1541           .
     1542      end.
     1543      else
     1544         return no.
     1545   end.
     1546   function ChekTypeMarkByDm return logical
     1547   (iDM as char ):
     1548      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1549   end.
     1550   function ChekTypeMarkByGtin return logical
     1551   (iGtin as char ):
     1552      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1553   end.
     1554   function GetNextElement return character
     1555     (input iAllTeg        as logical
     1556     ,output oteg          as character
     1557     ,output otegval       as character
     1558     ,input-output pstr    as character
     1559      ):
     1560        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1561        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1562        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1563        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1564        define variable vTeg as character no-undo.
     1565        define variable vLength as integer no-undo.
     1566        define variable vi as integer no-undo.
     1567        define variable vj as integer no-undo.
     1568        define buffer code for ub.code.
     1569        find first code where Code.parent eq "MarkType"
     1570                          and Code.CodeValue   eq mTypeMark
     1571                          no-lock no-error.
     1572        if     available code
     1573           and Code.misc1 ne ""
     1574           and Code.misc1 ne ?
     1575        then do:
     1576           integer (Code.misc1) no-error.
     1577           if not error-status:error
     1578           then
     1579             entry (4,vlistleng) = Code.misc1.
     1580        end.
     1581        if iAllTeg
     1582        then
     1583           assign
     1584              vlistElem     = vlistElem    + vlistElemDop
     1585              vlistleng     = vlistleng    + vlistlengDop
     1586           .
     1587        else if mMRCCode
     1588        then
     1589           assign
     1590              vlistElem     = vlistElem    + ",(8005),8005"
     1591              vlistleng     = vlistleng    + ",000006,0006"
     1592           .
     1593       block-elem:
     1594       do vi = 1 to num-entries(vlistElem):
     1595          vTeg = entry(vi,vlistElem).
     1596          if pstr begins vTeg
     1597          then do:
     1598             if    vTeg eq "21"
     1599             then
     1600                vLength = index(pstr,chr(29)) - 2 no-error.
     1601             if vLength  <= 0
     1602             then
     1603                vLength = int(entry(vi,vlistleng)).
     1604             otegval = substring (pstr,length(vteg) + 1, vLength).
     1605             oteg = replace(replace(vteg,")",""),"(","").
     1606             vTeg = vteg + otegval.
     1607             otegval = replace(otegval,chr(29),"").
     1608             oteg = replace(replace(oteg,")",""),"(","").
     1609             pstr = substring (pstr,length(vTeg)+ 1).
     1610             vTeg = replace(vTeg,chr(29),"").
     1611             leave block-elem.
     1612          end.
     1613          else
     1614             vTeg = "".
     1615       end.
     1616       return vteg.
     1617   end.
     1618   function GetCodeIdent return character
     1619   (iDm as char):
     1620      define variable Velement   as character no-undo init "first".
     1621      define variable oCodeIdent as character no-undo.
     1622      define variable vteg as character no-undo.
     1623      define variable vtegval as character no-undo.
     1624      define variable vGtin as character no-undo.
     1625      define buffer marking for ub.marking.
     1626      for first marking no-lock where
     1627                marking.mark eq iDm
     1628            and marking.unit-ext = "LEVEL2"
     1629      :
     1630        return iDm.
     1631      end.
     1632      vGtin  = getGtinByDM (iDm ).
     1633      ChekTypeMarkByDm(idm).
     1634      if iDm begins 'tech_':U
     1635      then
     1636         oCodeIdent = iDm.
     1637      else if length(iDm) < 21
     1638      then do:
     1639         find first marking where marking.mark eq idm
     1640         no-lock no-error.
     1641         oCodeIdent = if available marking then marking.mark else  ?.
     1642      end.
     1643      else if     length(iDm) eq 29
     1644         and not iDm begins "01"
     1645         and not iDm begins "02"
     1646      then
     1647         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1648      else  if     length(iDm) >= 24
     1649               and (  iDm begins "01"
     1650                   or iDm begins "02")
     1651               and  substring(iDm,17,2) ne "21"
     1652      then do:
     1653         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1654                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1655         then
     1656            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1657         else
     1658            oCodeIdent = iDM.
     1659      end.
     1660      else  if     (   length(iDm) eq 25
     1661                    or length(iDm) eq 21)
     1662               and (not iDm begins "01"
     1663               and  not iDm begins "02")
     1664      then
     1665         oCodeIdent = substring(iDm,1,21).
     1666      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1667      then
     1668         oCodeIdent = substring(iDm,1,21).
     1669      else do while Velement ne "" and idm ne "":
     1670         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1671         oCodeIdent = oCodeIdent + Velement.
     1672      end.
     1673      return oCodeIdent.
     1674   end.
     1675   function GetTegCod return character
     1676   (icodeIdent as char, iTeg as char):
     1677      define variable Velement   as character no-undo init "first".
     1678      define variable oTeg as character no-undo init ?.
     1679      define variable vteg as character no-undo.
     1680      define variable vtegval as character no-undo.
     1681      if     ((length(icodeIdent) eq 21
     1682         and not icodeIdent begins "01"
     1683         and not icodeIdent begins "02")
     1684         or
     1685             ( length(icodeIdent) eq 25
     1686               and not icodeIdent begins "01"
     1687               and not icodeIdent begins "02"))
     1688      then do:
     1689         if iTeg eq "01" or iTeg eq "02"
     1690         then
     1691            oTeg = substring(icodeIdent,1,21).
     1692         else  if  iTeg eq "21"
     1693         then
     1694            oTeg = substring(icodeIdent,15,7).
     1695      end.
     1696      else do:
     1697         ChekTypeMarkByDm(icodeIdent).
     1698         block-teg:
     1699            do while Velement ne "" and icodeIdent ne "":
     1700            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1701            if    Velement begins iTeg
     1702               or Velement begins "(" + iTeg + ")"
     1703            then do:
     1704               oTeg = vtegval.
     1705               leave block-teg.
     1706            end.
     1707         end.
     1708      end.
     1709      return oTeg.
     1710   end.
     1711   function isOAD return logical
     1712   (icodeIdent as character):
     1713      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1714   end.
     1715   function isMark return logical
     1716   (icodeIdent as character):
     1717      define buffer buf_marking for ub.marking.
     1718      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1719             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1720   end.
     1721   function addBracketForCode return character
     1722   (icodeIdent as char):
     1723      define variable Velement   as character no-undo init "first".
     1724      define variable oTeg as character no-undo.
     1725      define variable vteg as character no-undo.
     1726      define variable vtegval as character no-undo.
     1727      define buffer marking for ub.marking.
     1728      find first marking no-lock where
     1729                 marking.mark begins icodeIdent no-error.
     1730      if    not ChekTypeMarkByDm(icodeIdent)
     1731         or length(icodeIdent) le 24
     1732         or (avail marking and marking.unit-ext = "LEVEL2")
     1733      then
     1734         oTeg = icodeIdent.
     1735      else do:
     1736         if (  icodeIdent begins "01"
     1737            or icodeIdent begins "02"
     1738            ) and CheckGtin(substring (icodeIdent,3,14))
     1739            and substring (icodeIdent,17,2) eq "21"
     1740         then do:
     1741            mMRCCode = yes.
     1742            ChekTypeMarkByDm(icodeIdent).
     1743            block-teg:
     1744            do while Velement ne "" and icodeIdent ne "":
     1745               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1746               if vteg ne ""
     1747               then
     1748                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1749            end.
     1750            mMRCCode = no.
     1751         end.
     1752         else do:
     1753            oTeg = icodeIdent.
     1754         end.
     1755      end.
     1756      return oTeg.
     1757   end.
     1758   function getlevelByCodId return int
     1759   (iCode as char):
     1760      define variable vLength as int no-undo.
     1761      define variable vLevel  as int no-undo.
     1762      if not ChekTypeMarkByDM (icode) then return ?.
     1763      vLength = length(iCode).
     1764      if    vLength eq 18
     1765         or vLength eq 20
     1766      then
     1767         Vlevel = 4.
     1768      else if vLength eq 21
     1769      then
     1770         Vlevel = 1.
     1771      else if vLength eq 25
     1772      then do:
     1773         if  iCode begins "01"
     1774         then
     1775            Vlevel = 3.
     1776         else
     1777            Vlevel = 1.
     1778      end.
     1779      else if     vLength >= 26
     1780              and vLength <= 46
     1781      then do:
     1782         if    substring(iCode,17,2) eq "11"
     1783            or substring(iCode,17,2) eq "13"
     1784            or (    substring(iCode,17,2) eq "21"
     1785                and vLength >= 33
     1786                and substring(iCode,26,4) ne "8005")
     1787         then
     1788            Vlevel = 4.
     1789         else if    vLength eq 31
     1790                 or vLength eq 38
     1791                 or vLength eq 39
     1792                 or vLength eq 45
     1793         then
     1794            Vlevel = 1.
     1795         else if    vLength eq 35
     1796                 or vLength eq 43
     1797         then
     1798            Vlevel = 3.
     1799         else
     1800            Vlevel = ?.
     1801      end.
     1802      else
     1803         Vlevel = ?.
     1804      return Vlevel.
     1805   end.
     1806   function getLevelMotpBycodid return character
     1807   (iDm as char):
     1808      define variable vLevel as integer no-undo.
     1809      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1810      vLevel = getlevelByCodId(iDm).
     1811      if    vLevel eq ?
     1812         or vLevel < 1
     1813         or vLevel > 6
     1814      then
     1815         return ?.
     1816      else
     1817         return entry(vlevel,vList).
     1818   end.
     1819   function getLevelUTDByLevelMotp return character
     1820   (iUnit as char):
     1821      define variable vLevel as integer no-undo.
     1822      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1823      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1824      vLevel = lookup(iUnit,vListMOTP).
     1825      if    vLevel eq ?
     1826         or vLevel < 1
     1827         or vLevel > 4
     1828      then
     1829         return ?.
     1830      else
     1831         return entry(vlevel,vListutd).
     1832   end.
     1833   function getLevelMotpByDM return character
     1834   (iDm as char):
     1835      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1836   end.
     1837   function getLevelUTDByCodId return character
     1838   (iDm as char):
     1839      define variable vLevel as integer no-undo.
     1840      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1841      vLevel = getlevelByCodId(iDm).
     1842      if    vLevel eq ?
     1843         or vLevel < 1
     1844         or vLevel > 4
     1845      then
     1846         return ?.
     1847      else
     1848         return entry(vlevel,vList).
     1849   end.
     1850   function getLevelUTDByDM return character
     1851   (iDm as char):
     1852      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1853   end.
     1854   define variable mNotMarkQnty as logical no-undo.
     1855   function getQntyUTDByCodId return decimal
     1856   (iDM as char):
     1857      define variable vLevel as integer no-undo.
     1858      define variable vList as character no-undo init "1,5,10,500".
     1859      define variable vGtin as character no-undo.
     1860      define variable vqnty as decimal no-undo init ?.
     1861      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1862      if vqnty eq ?
     1863      then do:
     1864         if not mNotMarkQnty
     1865         then do:
     1866            define buffer marking for ub.marking.
     1867            define variable vCodident as character no-undo.
     1868            vCodident = GetCodeIdent(idm).
     1869            find first marking where marking.mark begins vCodident no-lock no-error.
     1870            if     available marking
     1871               and marking.box-qnty ne ?
     1872            then
     1873               return marking.box-qnty.
     1874         end.
     1875         vGtin = getGtinByDm(iDM).
     1876         if ChekTypeMarkByGtin (vGtin)
     1877         then do:
     1878            vLevel = getlevelByCodId(iDM).
     1879            if     vLevel >= 1
     1880               and vLevel <= 4
     1881            then
     1882               vqnty = int(entry(vlevel,vList)).
     1883         end.
     1884         else
     1885            vqnty = getQntyCodeByGtin(vgtin).
     1886      end.
     1887      return vqnty.
     1888   end.
     1889   function getQntyUTDByDM return decimal
     1890   (iDm as char):
     1891      define variable vDM as character no-undo.
     1892      if     length (iDm) ne 25
     1893         and length (iDm) ne 29
     1894         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1895      then
     1896         vDM = substring (iDm,1,length (iDm) - 6 ).
     1897      else
     1898         vDM = substring (iDm,1,length (iDm) - 4 ).
     1899      return getQntyUTDByCodId(vDM).
     1900   end.
     1901   function getMRC4 return decimal
     1902   (iMRC as char):
     1903      define variable oMrc     as decimal no-undo init ?.
     1904      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1905      define variable vi       as integer no-undo.
     1906      define variable vfound   as integer no-undo.
     1907      define variable vposStart   as integer no-undo.
     1908      do:
     1909      OMRc = 0.
     1910      do vi = 1 to 4:
     1911         define variable vsimb as character no-undo.
     1912         vsimb = substring(iMRC,vi,1).
     1913         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1914         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1915         if vfound > 0
     1916         then
     1917            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1918         end.
     1919         OMRc = OMRc / 100.
     1920      end.
     1921      return OMRc.
     1922   end.
     1923   function getMRCByDM return decimal
     1924   (iDm as char):
     1925      define variable vMRC     as character no-undo.
     1926      define variable oMrc     as decimal no-undo init ?.
     1927      define variable Velement as character no-undo init "empty".
     1928      define variable vteg as character no-undo.
     1929      define variable vtegval as character no-undo.
     1930      if    length(idm) eq 14 + 7 + 4 + 4
     1931         or length(idm) eq 14 + 7 + 4
     1932      then do:
     1933         vMRC = substring(idm,22,4).
     1934         omrc = getMRC4(vMRC).
     1935      end.
     1936      else do:
     1937          ChekTypeMarkByDm(iDm).
     1938          block-mrc:
     1939          do while Velement ne "" and idm ne "":
     1940             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1941             if Velement begins "8005"
     1942             then do:
     1943                vMRC = substring(Velement,5,6).
     1944                leave block-mrc.
     1945             end.
     1946             else if Velement begins "(8005)"
     1947             then do:
     1948                vMRC = substring(Velement,7,6).
     1949                leave block-mrc.
     1950             end.
     1951          end.
     1952          if vMRC ne ""
     1953          then
     1954             OMRc = dec(vmrc) / 100 no-error.
     1955      end.
     1956      return OMRc.
     1957   end.
     1958   function MoveDate return Date
     1959   (idate as date,
     1960    iMonth as int64):
     1961      define variable vMonth   as int64 no-undo.
     1962      define variable vYear    as int64 no-undo.
     1963      define variable vDateNew as date  no-undo.
     1964       define variable vDay     as int64 no-undo.
     1965       vMonth = month(iDate) + iMonth.
     1966       vYear =  year(iDate).
     1967       if vMonth <= 0
     1968       then assign
     1969          vMonth = vMonth + 12
     1970           vYear  = vYear - 1
     1971       .
     1972       else if vMonth > 12
     1973       then assign
     1974          vMonth = vMonth - 12
     1975           vYear  = vYear + 1
     1976       .
     1977       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1978       do while error-status:error eq yes:
     1979          VDay = vDay + 1.
     1980          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1981       end.
     1982       if VDay > 0
     1983       then
     1984          vDateNew + 1.
     1985       return vDateNew.
     1986   end.
     1987   procedure checkEMRC:
     1988   define input  parameter iDm as character no-undo.
     1989   define output parameter vok as logical   no-undo init yes.
     1990      define variable v-value-emrc as character no-undo.
     1991      define variable v-type-emrc  as character no-undo.
     1992      define variable vDateIso     as character no-undo.
     1993      define variable vMRC         as decimal no-undo.
     1994      define variable vqnty        as decimal no-undo.
     1995      define variable vPrice       as decimal no-undo.
     1996      define variable vparent      as character no-undo.
     1997      define variable vgds-code    as integer no-undo.
     1998      define buffer code for ub.code.
     1999      vMRC = getMRCByDM(iDm).
     2000      if vMRC > 0
     2001      then do:
     2002         vgds-code = getGdsCodeByDM(iDm).
     2003         vqnty     = getQntyUTDByDM(iDm).
     2004               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2005            (
     2006             input   vgds-code
     2007            ,input   'emrc-type':U
     2008            ,output   v-value-emrc
     2009            ,output   v-type-emrc
     2010          ) no-error.
     2011          if     v-value-emrc ne ""
     2012             and v-value-emrc ne ?
     2013          then do:
     2014             vDateIso = iso-date(today).
     2015             vPrice = vMRC / vqnty.
     2016             vparent ="emc" + chr(4) + v-value-emrc.
     2017             find last code where Code.parent      eq vparent
     2018                              and Code.code        le vDateIso
     2019                              and code.status_  eq 0
     2020             no-lock no-error.
     2021             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2022             then
     2023                vOk = true .
     2024             else do:
     2025                 define variable vText      as character no-undo.
     2026                 define variable vDate      as date no-undo.
     2027                 define variable vDateLast  as character no-undo.
     2028                 define variable vDateFirst as character no-undo.
     2029                 define variable vDate3     as date no-undo.
     2030                 vdate = date(code.misc1).
     2031                 vDateLast = code.misc1.
     2032                 vDate3 = MoveDate(today, - 3 ).
     2033                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2034                                      string(vDate3  , "99/99/9999"),
     2035                                      string(vDate   , "99/99/9999")
     2036                                      ).
     2037                 vdateIso = iso-date(vdate3).
     2038                 find last code  where Code.parent      eq vparent
     2039                                   and Code.code        le vDateIso
     2040                                   and code.status_  eq 0 no-lock no-error.
     2041                 if available code
     2042                 then
     2043                    vDateIso = code.code.
     2044                 vDateFirst = vDateIso.
     2045                 vDateLast = iso-date(vdate).
     2046                 define variable vGood as logical no-undo.
     2047                 define variable vDateSale as date no-undo.
     2048                 define buffer bcode for code.
     2049                 for last code where Code.parent   eq vparent
     2050                                 and code.status_  eq 0
     2051                                 and code.code     < vDateLast
     2052                                 and code.code     >= vDateFirst
     2053                 no-lock:
     2054                    find first bcode where bCode.parent   eq vparent
     2055                                       and bcode.status_  eq 0
     2056                                       and bcode.code     > code.code no-lock no-error.
     2057                    if available bcode
     2058                    then do:
     2059                       if vPrice < dec(Code.CodeValue)
     2060                       then
     2061                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2062                                                     chr(10),
     2063                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2064                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2065                                                     ).
     2066                       else do:
     2067                          vGood = yes.
     2068                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2069                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2070                                                     chr(10),
     2071                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2072                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2073                                                     string(         vDateSale            ,"99/99/9999"),
     2074                                                     string(vDateSale - today)
     2075                                                     ).
     2076                       end.
     2077                    end.
     2078                 end.
     2079                 if vgood
     2080                 then do:
     2081                    define variable choice as integer no-undo .
     2082                    run gbl/d-askw.w (input "Уточнение"
     2083                           ,input  vText
     2084                           ,input "|"
     2085                           ,input "Принять|Вернуть"
     2086                           ,input "Принять данный товар|Вернуть товар постащику"
     2087                           ,input 1
     2088                           ,input 2
     2089                           ,output choice) no-error.
     2090                    vok = choice eq 1.
     2091                 end.
     2092                 else
     2093                    vok =false.
     2094             end.
     2095          end.
     2096      end.
     2097   end.
     2098   function addGs2Mark return character
     2099   (iMark as char):
     2100      define variable vDM   as character no-undo.
     2101      define variable vIdx  as integer   no-undo.
     2102      if index(iMark,chr(29),1) > 0
     2103      then return iMark.
     2104      if substring(iMark,26,4) = "8005" then
     2105      do:
     2106        vIdx = index(iMark,"93",26 + 4 + 5).
     2107        if vIdx > 1 then do:
     2108          vDM = substitute("&1&4&2&4&3",
     2109                           substring(iMark,1,25),
     2110                           substring(iMark,26,vIdx - 25 - 1),
     2111                           substring(iMark,vIdx),
     2112                           chr(29)) no-error.
     2113          vIdx = index(vDm,"240",vIdx + 4).
     2114          if vIdx > 0 then
     2115          do:
     2116            vDM = substitute("&1&3&2",
     2117                             substring(vDm,1,vIdx - 1),
     2118                             substring(vDm,vIdx),
     2119                             chr(29)) no-error.
     2120          end.
     2121        end.
     2122        else
     2123          vDM = substitute("&1&3&2",
     2124                           substring(iMark,1,25),
     2125                           substring(iMark,26),
     2126                           chr(29)) no-error.
     2127      end.
     2128      else if substring(iMark,32,2) = "91" then
     2129      do:
     2130        vIdx = index(iMark,"92",32).
     2131        if vIdx > 1 then
     2132          vDM = substitute("&1&4&2&4&3",
     2133                           substring(iMark,1,31),
     2134                           substring(iMark,32,vIdx - 31 - 1),
     2135                           substring(iMark,vIdx),
     2136                           chr(29)) no-error.
     2137        else
     2138          vDM = substitute("&1&3&2",
     2139                           substring(iMark,1,31),
     2140                           substring(iMark,32),
     2141                           chr(29)) no-error.
     2142      end.
     2143      else if substring(iMark,39,2) = "91" then
     2144      do:
     2145        vIdx = index(iMark,"92",38).
     2146        if vIdx > 1 then
     2147          vDM = substitute("&1&4&2&4&3",
     2148                           substring(iMark,1,38),
     2149                           substring(iMark,39,vIdx - 38 - 1),
     2150                           substring(iMark,vIdx),
     2151                           chr(29)) no-error.
     2152        else
     2153          vDM = substitute("&1&3&2",
     2154                           substring(iMark,1,38),
     2155                           substring(iMark,39),
     2156                           chr(29)) no-error.
     2157      end.
     2158      else if substring(iMark,25,2) = "93" then
     2159      do:
     2160        vIdx = index(iMark,"92",25).
     2161        if vIdx > 1 then
     2162          vDM = substitute("&1&4&2&4&3",
     2163                           substring(iMark,1,24),
     2164                           substring(iMark,25,vIdx - 24 - 1),
     2165                           substring(iMark,vIdx),
     2166                           chr(29)) no-error.
     2167        else
     2168          vIdx = index(iMark,"3103",25).
     2169          if vIdx > 0 then
     2170          vDM = substitute("&1&4&2&4&3",
     2171                           substring(iMark,1,24),
     2172                           substring(iMark,25,vIdx - 24 - 1),
     2173                           substring(iMark,vIdx),
     2174                           chr(29)) no-error.
     2175          else
     2176            vDM = substitute("&1&3&2",
     2177                             substring(iMark,1,24),
     2178                             substring(iMark,25),
     2179                             chr(29)) no-error.
     2180      end.
     2181      else if substring(iMark,32,2) = "93" then
     2182      do:
     2183        vDM = substitute("&1&3&2",
     2184              substring(iMark,1,31),
     2185              substring(iMark,32),
     2186              chr(29)) no-error.
     2187      end.
     2188      return if vDM <> "" then vDm else iMark.
     2189   end.
     2190   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2191   define variable v-waitfram-action01         as character   no-undo .
     2192   define variable v-waitfram-action02         as character   no-undo .
     2193   define variable v-waitfram-action03         as character   no-undo .
     2194   define variable mWaitFramTextBeg            as character   no-undo.
     2195   define variable mWaitFramTextEnd            as character   no-undo.
     2196   define variable mWaitFramView               as logical     no-undo.
     2197   define variable mWaitProcEvent              as logical     no-undo init yes.
     2198   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2199   define variable mWaitFramStop               as logical     no-undo.
     2200   define variable mWaitFramStopUser           as logical     no-undo.
     2201   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2202   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2203   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2204   define button B-WaitFramStop auto-end-key
     2205        label "Стоп"
     2206        size 10 by 1 tooltip "Остоновить процесс".
     2207   define button B-viewProcInfo
     2208        label "Информация"
     2209        size 15 by 1 tooltip "Информация о процесс".
     2210   define frame waitfram
     2211     v-waitfram-action01 format "x(72)" no-label skip
     2212     v-waitfram-action02 format "x(72)" no-label skip
     2213     v-waitfram-action03 format "x(72)" no-label skip
     2214     B-viewProcInfo
     2215     B-WaitFramStop at row 4 col 30
     2216     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2217     .
     2218   define new global shared variable mBatchMode as logical no-undo init ?.
     2219   define variable mFramBachModHandle as handle no-undo.
     2220   mFramBachModHandle = frame waitfram:handle.
     2221   define variable mFameOldVis as logical no-undo.
     2222   define variable mVisCUrentVin as logical no-undo.
     2223   if session:batch-mode
     2224   then
     2225      mBatchMode = yes.
     2226   if mBatchMode = ? then do:
     2227     mVisCUrentVin = current-window:visible.
     2228     mFameOldVis = mFramBachModHandle:visible.
     2229     mFramBachModHandle:visible  = yes.
     2230     mBatchMode = mFramBachModHandle:visible ne yes.
     2231     mFramBachModHandle:visible = mFameOldVis.
     2232     current-window:visible = mVisCUrentVin.
     2233   end.
     2234    if  log-manager:logfile-name ne ?
     2235     then DO:
     2236         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2237         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2238         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2239     end.
     2240   on choose of B-WaitFramStop in frame waitfram
     2241   do:
     2242     mWaitFramStop = yes.
     2243     mWaitFramStopUser = yes.
     2244   end.
     2245   function waitfram-check-timeout returns logical():
     2246      define variable vtime as int64 no-undo.
     2247      if mWaitFramStopTimeOut
     2248      then
     2249         return yes.
     2250      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2251      if     mWaitFramTimeOut ne ?
     2252         and mWaitFramTimeOut ne 0
     2253         and mWaitFramTimeOut lt vtime
     2254      then do:
     2255         mWaitFramStopTimeOut = yes.
     2256      end.
     2257      return mWaitFramStopTimeOut.
     2258   end.
     2259   procedure waitfram-hide :
     2260     if not session:batch-mode
     2261     then do
     2262     on error undo, return error return-value
     2263     :
     2264       pause 0 before-hide .
     2265       if not mBatchMode then
     2266         hide frame waitfram .
     2267     end.
     2268   end procedure.
     2269   procedure waitfram-show :
     2270     define input  parameter p-message as character no-undo .
     2271     define variable v-left-margin as integer   no-undo .
     2272     if not session:batch-mode
     2273     then do
     2274     on error undo, return error return-value
     2275     :
     2276       if length(p-message) <= 70 then do:
     2277         assign
     2278           v-left-margin = integer((70 - length(p-message)) / 2)
     2279         .
     2280         assign
     2281           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2282         .
     2283         assign
     2284           v-waitfram-action01 = " "
     2285           v-waitfram-action02 = " "
     2286                                    + fill(" ", v-left-margin)
     2287                                    + p-message
     2288           v-waitfram-action03 = " "
     2289         .
     2290       end.
     2291       else do:
     2292         define variable vRindex1 as integer no-undo.
     2293         define variable vRindex2 as integer no-undo.
     2294         vRindex1 = r-index(p-message," ",70).
     2295         if vRindex1 = 0
     2296         then
     2297            vRindex1 = 70.
     2298         if length(p-message)  <= vRindex1 + 70 then do:
     2299           assign
     2300             v-waitfram-action01 = " "
     2301             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2302             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2303           .
     2304         end.
     2305         else do:
     2306           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2307           if vRindex2 <= vRindex1
     2308           then
     2309              vRindex2 = vRindex1 + 70.
     2310           assign
     2311             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2312             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2313             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2314           .
     2315         end.
     2316       end.
     2317       B-viewProcInfo:visible   in frame waitfram = no.
     2318       B-viewProcInfo:sensitive in frame waitfram = no.
     2319       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2320       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2321       if  (   mWaitFramView
     2322          or  mWaitProcEvent)
     2323          and not mBatchMode
     2324       then
     2325          display
     2326             v-waitfram-action01 skip
     2327             v-waitfram-action02 skip
     2328             v-waitfram-action03 skip
     2329          with frame waitfram .
     2330     end.
     2331   end procedure.
     2332      procedure waitfram-show-this:
     2333         define input  parameter iInterval as int64 no-undo.
     2334         define variable vtime as int64 no-undo.
     2335         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2336         mWaitFramInterval = iInterval.
     2337         run waitfram-show (substitute("&1&2 &3&4" ,
     2338                                       mWaitFramTextBeg ,
     2339                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2340                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2341                                       mWaitFramTextEnd
     2342                                      )
     2343                           ).
     2344      end.
     2345      procedure WaitFramRunPause:
     2346         define input  parameter iInterval as dec no-undo.
     2347         define variable vStart  as datetime-tz no-undo.
     2348         define variable vend    as datetime-tz no-undo.
     2349         define variable vint as int64 no-undo.
     2350         define variable vOk as logical no-undo.
     2351         vStart = now.
     2352         vend   = vStart.
     2353         publish "WaitFramPause" (iInterval,output vOk).
     2354         vend   =  now.
     2355         vint = vend - vStart.
     2356         vint = iInterval - vint / 1000.
     2357         if     not mWaitFramStop
     2358            and (   vint > 0
     2359                 or (    not vOk
     2360                     and iInterval eq ?
     2361                     )
     2362                 )
     2363         then
     2364            run waitfram-show-this (iInterval).
     2365         vend   =  now.
     2366         vint = vend - vStart.
     2367         vint = iInterval - vint / 1000.
     2368         if     not mWaitFramStop
     2369            and vint > 0
     2370         then do:
     2371            run gbl/pause.p (vint * 1000).
     2372         end.
     2373         if iInterval ne ?
     2374         then
     2375            publish "WaitFramStop".
     2376         waitfram-check-timeout().
     2377      end.
     2378      procedure WaitFramWaitFor:
     2379         define input  parameter iInterval as dec no-undo.
     2380         assign
     2381            mWaitFramStartProc   = now
     2382            mWaitFramStopUser    = no
     2383            mWaitFramStopTimeOut = no
     2384         .
     2385         block-wait:
     2386         do while not mWaitFramStop:
     2387            run WaitFramRunPause (iInterval).
     2388            if  waitfram-check-timeout()
     2389            then do:
     2390               leave block-wait.
     2391            end.
     2392         end.
     2393         run waitfram-hide.
     2394      end.
     2395   procedure waitfram-join :
     2396     define input  parameter p-line-1  as character no-undo .
     2397     define input  parameter p-line-2  as character no-undo .
     2398     define input  parameter p-line-3  as character no-undo .
     2399     define output parameter p-message as character no-undo .
     2400     do
     2401     on error undo, return error return-value
     2402     :
     2403       assign
     2404         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2405                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2406                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2407       .
     2408     end.
     2409   end procedure.
     2410   function waitfram-join-function returns character
     2411     (input p-line-1 as character
     2412     ,input p-line-2 as character
     2413     ,input p-line-3 as character
     2414     ).
     2415     define variable v-message as character no-undo .
     2416     run waitfram-join in this-procedure
     2417       (input  p-line-1
     2418       ,input  p-line-2
     2419       ,input  p-line-3
     2420       ,output v-message
     2421       ) .
     2422     return v-message .
     2423   end function .
     2424   define temp-table tt-fbr-line no-undo
     2425     field num as integer
     2426     field gds-code as integer
     2427     field gds-name as character
     2428     field qnty as decimal
     2429     field ingr-qnty as decimal
     2430     field recipe-code like ub.recipe.recipe-code
     2431     field recipe-type like ub.recipe.recipe-type
     2432     field ingr-gds-code as integer
     2433     field unit as character
     2434     field mark-weight as decimal
     2435     field weighed as logical
     2436   .
     2437   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2438     define variable v-cntxt-db-num        as integer   no-undo .
     2439     define variable v-cntxt-userid        as character no-undo .
     2440     define variable v-cntxt-level         as character no-undo .
     2441     define variable v-cntxt-host-code-obj as integer   no-undo .
     2442     define variable v-cntxt-obj-type      as character no-undo .
     2443     define variable v-cntxt-obj-code      as integer   no-undo .
     2444     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2445     define variable v-cntxt-is-admin      as logical   no-undo .
     2446   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   function getattrUtdex returns char
     2448   (idb-num   as integer,
     2449    idoc-id   as integer,
     2450    iattrcode as character,
     2451    iExValue  as character  ):
     2452      define buffer utd-attr for utd-attr.
     2453      find first utd-attr where utd-attr.db-num eq idb-num
     2454                            and utd-attr.doc-id eq idoc-id
     2455                            and utd-attr.attr-code eq iattrcode
     2456      no-lock no-error.
     2457      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2458   end.
     2459   function getattrUtd returns char
     2460   (idb-num   as integer,
     2461    idoc-id   as integer,
     2462    iattrcode as character ):
     2463     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2464   end.
     2465   function setattrUtd returns logical
     2466   (idb-num   as integer,
     2467    idoc-id   as integer,
     2468    iattrcode as character,
     2469    iattrval  as character ):
     2470      define buffer utd-attr for utd-attr.
     2471      find first utd-attr where utd-attr.db-num eq idb-num
     2472                            and utd-attr.doc-id eq idoc-id
     2473                            and utd-attr.attr-code eq iattrcode
     2474      no-lock no-error.
     2475      if not available utd-attr
     2476      then do:
     2477         create utd-attr.
     2478         assign
     2479            utd-attr.db-num    = idb-num
     2480            utd-attr.doc-id    = idoc-id
     2481            utd-attr.attr-code = iattrcode
     2482            utd-attr.attr-value = iattrval
     2483         .
     2484      end.
     2485      else do:
     2486         if utd-attr.attr-value ne iattrval
     2487         then do:
     2488            find current utd-attr exclusive-lock no-error.
     2489            if available utd-attr
     2490            then
     2491               utd-attr.attr-value = iattrval.
     2492         end.
     2493      end.
     2494      release utd-attr.
     2495   end.
     2496   function GetAttrUtdlinesEx returns char
     2497   (idb-num   as integer,
     2498    idoc-id   as integer,
     2499    ilinenum  as integer,
     2500    iattrcode as character,
     2501    iExValue  as character  ):
     2502      define buffer utd-lines-attr for utd-lines-attr.
     2503      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2504                                  and utd-lines-attr.doc-id    eq idoc-id
     2505                                  and utd-lines-attr.lineNum   eq ilineNum
     2506                                  and utd-lines-attr.attr-code eq iattrcode
     2507      no-lock no-error.
     2508      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2509   end.
     2510   function GetAttrUtdlines returns char
     2511   (idb-num   as integer,
     2512    idoc-id   as integer,
     2513    ilinenum  as integer,
     2514    iattrcode as character ):
     2515      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2516   end.
     2517   function setattrUtdlines returns logical
     2518   (idb-num   as integer,
     2519    idoc-id   as integer,
     2520    ilinenum  as integer,
     2521    iattrcode as character,
     2522    iattrval  as character ):
     2523      define buffer utd-lines-attr for utd-lines-attr.
     2524      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2525                                  and utd-lines-attr.doc-id    eq idoc-id
     2526                                  and utd-lines-attr.lineNum   eq ilineNum
     2527                                  and utd-lines-attr.attr-code eq iattrcode
     2528      no-lock no-error.
     2529      if not available utd-lines-attr
     2530      then do:
     2531         if iattrval ne ?
     2532            and iattrval ne ""
     2533         then do:
     2534            create utd-lines-attr.
     2535            assign
     2536               utd-lines-attr.db-num    = idb-num
     2537               utd-lines-attr.doc-id    = idoc-id
     2538               utd-lines-attr.lineNum   = ilineNum
     2539               utd-lines-attr.attr-code = iattrcode
     2540               utd-lines-attr.attr-value = iattrval
     2541            .
     2542         end.
     2543      end.
     2544      else do:
     2545         if utd-lines-attr.attr-value ne iattrval
     2546         then do:
     2547            find current utd-lines-attr exclusive-lock no-error.
     2548            if available utd-lines-attr
     2549            then do:
     2550               if    iattrval eq ?
     2551                  or iattrval eq ""
     2552               then do:
     2553                  delete utd-lines-attr.
     2554               end.
     2555               else do:
     2556                  utd-lines-attr.attr-value = iattrval.
     2557               end.
     2558            end.
     2559         end.
     2560      end.
     2561      release utd-lines-attr.
     2562   end.
     2563   function GetAttrUtdMarkingLinesEx returns char
     2564   (idb-num   as integer,
     2565    idoc-id   as integer,
     2566    ilinenum  as integer,
     2567    imark     as character,
     2568    iattrcode as character,
     2569    iExValue  as character  ):
     2570      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2571      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2572                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2573                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2574                                          and utd-marking-lines-attr.mark      eq imark
     2575                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2576      no-lock no-error.
     2577      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     2578   end.
     2579   function GetAttrUtdMarkingLines returns char
     2580   (idb-num   as integer,
     2581    idoc-id   as integer,
     2582    ilinenum  as integer,
     2583    imark     as character,
     2584    iattrcode as character ):
     2585      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     2586   end.
     2587   function setattrUtdMarkingLines returns logical
     2588   (idb-num   as integer,
     2589    idoc-id   as integer,
     2590    ilinenum  as integer,
     2591    imark     as character,
     2592    iattrcode as character,
     2593    iattrval  as character ):
     2594      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2595      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2596                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2597                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2598                                          and utd-marking-lines-attr.mark      eq imark
     2599                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2600      no-lock no-error.
     2601      if not available utd-marking-lines-attr
     2602      then do:
     2603         if iattrval ne ?
     2604            and iattrval ne ""
     2605         then do:
     2606            create utd-marking-lines-attr.
     2607            assign
     2608               utd-marking-lines-attr.db-num     = idb-num
     2609               utd-marking-lines-attr.doc-id     = idoc-id
     2610               utd-marking-lines-attr.lineNum    = ilineNum
     2611               utd-marking-lines-attr.mark       = imark
     2612               utd-marking-lines-attr.attr-code  = iattrcode
     2613               utd-marking-lines-attr.attr-value = iattrval
     2614            .
     2615         end.
     2616      end.
     2617      else do:
     2618         if utd-marking-lines-attr.attr-value ne iattrval
     2619         then do:
     2620            find current utd-marking-lines-attr exclusive-lock no-error.
     2621            if available utd-marking-lines-attr
     2622            then do:
     2623               if    iattrval eq ?
     2624                  or iattrval eq ""
     2625               then do:
     2626                  delete utd-marking-lines-attr.
     2627               end.
     2628               else do:
     2629                  utd-marking-lines-attr.attr-value = iattrval.
     2630               end.
     2631            end.
     2632         end.
     2633      end.
     2634      release utd-marking-lines-attr.
     2635   end.
     2636   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2637   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2639   procedure gen-key-rec :
     2640     define input  parameter p-tbl-name    as character no-undo.
     2641     define input  parameter p-bh_tbl-name as handle    no-undo.
     2642     define output parameter p-key-rec     as character no-undo.
     2643     do
     2644     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2645     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2646     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2647     :
     2648       define variable fh               as handle    no-undo .
     2649       define variable v-ok             as logical   no-undo .
     2650       define variable v-inform         as character no-undo .
     2651       define variable v-ind            as integer   no-undo .
     2652       define variable v-idx-field-qnty as integer   no-undo .
     2653       if p-tbl-name = ?
     2654         or p-tbl-name = "":U
     2655       then do:
     2656         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info13 ).
     2657       end.
     2658       if not p-bh_tbl-name:available then do:
     2659         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info13, p-tbl-name ).
     2660       end.
     2661       assign
     2662         p-key-rec = p-tbl-name
     2663         v-inform  = p-bh_tbl-name:index-information(1)
     2664         v-ind     = 2
     2665       .
     2666       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2667       on error undo, return error
     2668       :
     2669         assign
     2670           v-inform = p-bh_tbl-name:index-information( v-ind )
     2671           v-ind    = v-ind + 1
     2672         .
     2673       end.
     2674       if v-inform = ?
     2675         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2676         or entry( 3, v-inform, ",":U ) <> "1":U
     2677       then do:
     2678         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, p-tbl-name ).
     2679       end.
     2680       else do:
     2681         assign
     2682           v-idx-field-qnty = num-entries( v-inform ) - 4
     2683         .
     2684         if v-idx-field-qnty < 2 then do:
     2685           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, p-tbl-name ).
     2686         end.
     2687         do v-ind = 1 to v-idx-field-qnty by 2
     2688         on error undo, return error
     2689         :
     2690           assign
     2691             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2692             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2693           .
     2694         end.
     2695       end.
     2696       if p-key-rec = ? then do:
     2697         assign
     2698           p-key-rec = "":U
     2699         .
     2700         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info13, p-tbl-name ).
     2701       end.
     2702     end.
     2703     return.
     2704   end procedure.
     2705   procedure gen-where-keyr-tab :
     2706     define input  parameter i-tableSerach as character no-undo.
     2707     define input  parameter i-tablekey   as character  no-undo.
     2708     define input  parameter p-key-rec    as character  no-undo.
     2709     define input  parameter p-key-handle as handle     no-undo .
     2710     define input  parameter p-db-name    as character  no-undo .
     2711     define input  parameter p-tt-handle  as handle     no-undo .
     2712     define output parameter o-Where      as character  no-undo.
     2713     do
     2714     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2715     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2716     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2717     :
     2718       define variable v-full-tbl-name  as character no-undo .
     2719       define variable bh_tbl-name      as handle    no-undo .
     2720       define variable fh_key           as handle    no-undo .
     2721       define variable fh_search        as handle    no-undo .
     2722       define variable v-field-num      as integer   no-undo .
     2723       define variable v-count-fld      as integer   no-undo .
     2724       define variable v-inform         as character no-undo .
     2725       define variable v-ind            as integer   no-undo .
     2726       define variable v-idx-field-qnty as integer   no-undo .
     2727       define variable v-field-name     as character no-undo .
     2728       define variable v-field-val      as character no-undo .
     2729       define variable v-word-link      as character no-undo .
     2730       define variable vTable           as character no-undo.
     2731       define variable bh_tbl-key       as handle    no-undo .
     2732       assign
     2733         p-key-rec = trim( p-key-rec )
     2734       .
     2735       if p-key-handle <> ? then do:
     2736         if not valid-handle(p-key-handle)
     2737            or p-key-handle:type <> "buffer"
     2738         then do:
     2739           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info13 ).
     2740         end.
     2741         if num-entries( p-key-rec, chr(3) ) > 1
     2742           or p-key-rec = ?
     2743           or p-key-rec = "":U
     2744         then do:
     2745           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info13, p-key-rec ).
     2746         end.
     2747       end.
     2748       else do:
     2749         if p-key-rec = ?
     2750           or p-key-rec = "":U
     2751         then do:
     2752           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
     2753         end.
     2754       end.
     2755       assign
     2756         vTable = entry( 1 , p-key-rec, chr(3) )
     2757       .
     2758       if p-tt-handle <> ?
     2759         and ( not valid-handle(p-tt-handle)
     2760               or p-tt-handle:type <> "buffer"
     2761             )
     2762       then do:
     2763         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info13, vTable, chr(10) ).
     2764       end.
     2765       if p-tt-handle = ? then do:
     2766         assign
     2767           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2768         .
     2769         create buffer bh_tbl-name for table v-full-tbl-name .
     2770       end.
     2771       else do:
     2772         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2773       end.
     2774       assign
     2775         v-inform = bh_tbl-name:index-information(1)
     2776         v-ind    = 2
     2777       .
     2778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2779       on error undo, return error
     2780       :
     2781         assign
     2782           v-inform = bh_tbl-name:index-information( v-ind )
     2783           v-ind    = v-ind + 1
     2784         .
     2785       end.
     2786       if v-inform = ?
     2787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2788         or entry( 3, v-inform, ",":U ) <> "1":U
     2789       then do:
     2790         delete object bh_tbl-name no-error.
     2791         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info13, vTable ).
     2792       end.
     2793       assign
     2794         v-idx-field-qnty = num-entries( v-inform ) - 4
     2795       .
     2796       if v-idx-field-qnty < 2 then do:
     2797         delete object bh_tbl-name no-error.
     2798         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, vTable ).
     2799       end.
     2800       assign
     2801         o-where     = "where":U
     2802         v-word-link = "":U
     2803         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2804         v-count-fld = 0
     2805       .
     2806       if i-tablekey ne "" and i-tablekey ne ?
     2807       then do:
     2808         assign
     2809           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2810         .
     2811         create buffer bh_tbl-key for table v-full-tbl-name .
     2812       end.
     2813       if i-tableSerach ne "" and i-tableSerach ne ?
     2814       then do:
     2815         delete object bh_tbl-name no-error.
     2816         assign
     2817           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2818         .
     2819         create buffer bh_tbl-name for table v-full-tbl-name .
     2820       end.
     2821       block_where:
     2822       do v-ind = 1 to v-idx-field-qnty by 2
     2823       on error undo, return error
     2824       :
     2825         assign
     2826           v-count-fld = v-count-fld + 1
     2827         .
     2828         if p-key-handle = ?
     2829           and v-count-fld > v-field-num
     2830         then do:
     2831           leave block_where.
     2832         end.
     2833         define variable VfieldKeyTable as handle no-undo.
     2834         assign
     2835           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2836           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2837         .
     2838         if     bh_tbl-key ne ?
     2839         then do:
     2840            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2841            if VfieldKeyTable eq ?
     2842            then next block_where.
     2843         end.
     2844         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2845         then
     2846            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2847         else
     2848            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2849         if p-key-handle = ? then do:
     2850           assign
     2851             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2852           .
     2853         end.
     2854         else do:
     2855           assign
     2856             fh_key = p-key-handle:buffer-field( v-field-name )
     2857           .
     2858           if fh_key = ?
     2859             or not valid-handle( fh_key )
     2860           then do:
     2861             delete object bh_tbl-name.
     2862             if     bh_tbl-key ne ?
     2863             then
     2864                delete object bh_tbl-key.
     2865             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info13, p-key-handle:name, v-field-name ).
     2866           end.
     2867           assign
     2868             v-field-val = fh_key:buffer-value
     2869           .
     2870         end.
     2871         if fh_search:data-type ="character":U then do:
     2872           assign
     2873             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2874             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2875             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2876             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2877             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2878             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2879             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2880             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2881             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2882             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2883             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2884             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2885             v-field-val = substitute( '"&1"', v-field-val )
     2886           .
     2887         end.
     2888         assign
     2889           o-where = substitute( "&1 &2", o-where, v-field-val )
     2890         .
     2891         if v-word-link = "":U then do:
     2892           assign
     2893             v-word-link = "and":U
     2894           .
     2895         end.
     2896       end.
     2897       delete object bh_tbl-name.
     2898       if     bh_tbl-key ne ?
     2899       then
     2900          delete object bh_tbl-key.
     2901       if p-key-handle = ?
     2902         and v-count-fld <> v-field-num
     2903       then do:
     2904         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info13, vTable ).
     2905       end.
     2906     end.
     2907   end procedure.
     2908   procedure gen-hn-keyr-tab :
     2909     define input  parameter i-tableSerach as character no-undo.
     2910     define input  parameter i-tablekey   as character no-undo.
     2911     define input  parameter p-key-rec    as character no-undo.
     2912     define input  parameter p-key-handle as handle    no-undo .
     2913     define input  parameter p-db-name    as character no-undo .
     2914     define input  parameter p-tt-handle  as handle    no-undo .
     2915     define input  parameter p-stts-lock  as integer   no-undo .
     2916     define output parameter o-hn         as handle    no-undo.
     2917     define variable v-full-tbl-name as character no-undo.
     2918     define variable v-where         as character no-undo.
     2919     define variable bh_tbl-name     as handle    no-undo.
     2920     define variable vTable          as character no-undo.
     2921     do
     2922     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2923     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2924     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2925         run gen-where-keyr-tab(i-tableSerach,
     2926                                i-tablekey,
     2927                                p-key-rec,
     2928                                p-key-handle,
     2929                                p-db-name,
     2930                                p-tt-handle,
     2931                                output v-where).
     2932         if i-tableSerach ne "" and i-tableSerach ne ?
     2933         then do:
     2934            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2935            create buffer bh_tbl-name for table v-full-tbl-name .
     2936         end.
     2937         else do:
     2938            if p-tt-handle = ? then do:
     2939               assign
     2940                  vTable = entry( 1 , p-key-rec, chr(3) )
     2941               .
     2942               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2943               create buffer bh_tbl-name for table v-full-tbl-name .
     2944            end.
     2945            else do:
     2946               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2947            end.
     2948         end.
     2949         if p-tt-handle = ? then do:
     2950            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2951         end.
     2952         else do:
     2953            bh_tbl-name:find-first( v-where ) no-error .
     2954         end.
     2955         o-hn = bh_tbl-name.
     2956      end.
     2957   end procedure.
     2958   procedure gen-hn-keyr :
     2959     define input  parameter p-key-rec    as character no-undo.
     2960     define input  parameter p-key-handle as handle    no-undo .
     2961     define input  parameter p-db-name    as character no-undo .
     2962     define input  parameter p-tt-handle  as handle    no-undo .
     2963     define input  parameter p-stts-lock  as integer   no-undo .
     2964     define output parameter o-hn         as handle    no-undo.
     2965     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2966   end.
     2967   procedure gen-row-keyr :
     2968     define input  parameter p-key-rec    as character no-undo.
     2969     define input  parameter p-key-handle as handle    no-undo .
     2970     define input  parameter p-db-name    as character no-undo .
     2971     define input  parameter p-tt-handle  as handle    no-undo .
     2972     define input  parameter p-stts-lock  as integer   no-undo .
     2973     define output parameter p-tbl-row    as rowid     no-undo.
     2974     define output parameter p-tbl-name   as character no-undo.
     2975     define variable vHn as handle no-undo.
     2976       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2977       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2978       p-tbl-name =  vHn:table.
     2979       delete object vHn no-error.
     2980     if p-tbl-row = ? then do:
     2981       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info13, p-tbl-name, p-key-rec ).
     2982     end.
     2983     else do:
     2984       return.
     2985     end.
     2986   end procedure.
     2987   procedure gen-key-fv :
     2988     define input  parameter p-key-rec    as character no-undo .
     2989     define output parameter p-field-list as character no-undo .
     2990     define output parameter p-value-list as character no-undo.
     2991     do
     2992     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2993     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2994     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2995     :
     2996       define variable v-full-tbl-name  as character no-undo .
     2997       define variable bh_tbl-name      as handle    no-undo .
     2998       define variable v-tbl-name       as character no-undo .
     2999       define variable v-field-num      as integer   no-undo .
     3000       define variable v-count-fld      as integer   no-undo .
     3001       define variable v-inform         as character no-undo .
     3002       define variable v-ind            as integer   no-undo .
     3003       define variable v-idx-field-qnty as integer   no-undo .
     3004       define variable v-delim-key      as character no-undo .
     3005       if p-key-rec = ?
     3006         or p-key-rec = "":U
     3007       then do:
     3008         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
     3009       end.
     3010       assign
     3011         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3012         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3013       .
     3014       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3015       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info13 ).
     3016       assign
     3017         v-inform = bh_tbl-name:index-information(1)
     3018         v-ind    = 2
     3019       .
     3020       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3021       on error undo, return error
     3022       :
     3023         assign
     3024           v-inform = bh_tbl-name:index-information( v-ind )
     3025           v-ind    = v-ind + 1
     3026         .
     3027       end.
     3028       if v-inform = ?
     3029         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3030         or entry( 3, v-inform, ",":U ) <> "1":U
     3031       then do:
     3032         delete object bh_tbl-name no-error.
     3033         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     3034       end.
     3035       assign
     3036         v-idx-field-qnty = num-entries( v-inform ) - 4
     3037       .
     3038       if v-idx-field-qnty < 2 then do:
     3039         delete object bh_tbl-name no-error.
     3040         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     3041       end.
     3042       assign
     3043         p-field-list = "":U
     3044         p-value-list = "":U
     3045         v-delim-key  = "":U
     3046         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3047         v-count-fld  = 0
     3048       .
     3049       block_where:
     3050       do v-ind = 1 to v-idx-field-qnty by 2
     3051       on error undo, return error
     3052       :
     3053         assign
     3054           v-count-fld = v-count-fld + 1
     3055         .
     3056         if v-count-fld > v-field-num then do:
     3057           leave block_where.
     3058         end.
     3059         assign
     3060           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3061           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3062         .
     3063         if v-ind = 1 then do:
     3064           assign
     3065             v-delim-key = chr(3)
     3066           .
     3067         end.
     3068       end.
     3069       delete object bh_tbl-name.
     3070       if v-count-fld <> v-field-num then do:
     3071         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info13, v-tbl-name ).
     3072       end.
     3073     end.
     3074   end procedure.
     3075   procedure gen-key-field :
     3076     define input  parameter p-table      as character no-undo .
     3077     define output parameter p-field-list as character no-undo .
     3078     do
     3079     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3080     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3081     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3082     :
     3083       define variable v-full-tbl-name  as character no-undo .
     3084       define variable bh_tbl-name      as handle    no-undo .
     3085       define variable v-tbl-name       as character no-undo .
     3086       define variable v-field-num      as integer   no-undo .
     3087       define variable v-count-fld      as integer   no-undo .
     3088       define variable v-inform         as character no-undo .
     3089       define variable v-ind            as integer   no-undo .
     3090       define variable v-idx-field-qnty as integer   no-undo .
     3091       define variable v-delim-key      as character no-undo .
     3092       if p-table = ?
     3093         or p-table = "":U
     3094       then do:
     3095         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info13 ).
     3096       end.
     3097       assign
     3098         v-tbl-name      = p-table
     3099         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3100       .
     3101       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3102       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info13 ).
     3103       assign
     3104         v-inform = bh_tbl-name:index-information(1)
     3105         v-ind    = 2
     3106       .
     3107       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3108       on error undo, return error
     3109       :
     3110         assign
     3111           v-inform = bh_tbl-name:index-information( v-ind )
     3112           v-ind    = v-ind + 1
     3113         .
     3114       end.
     3115       if v-inform = ?
     3116         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3117         or entry( 3, v-inform, ",":U ) <> "1":U
     3118       then do:
     3119         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     3120       end.
     3121       assign
     3122         v-idx-field-qnty = num-entries( v-inform ) - 4
     3123       .
     3124       if v-idx-field-qnty < 2 then do:
     3125         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     3126       end.
     3127       assign
     3128         p-field-list = "":U
     3129         v-delim-key  = "":U
     3130         v-count-fld  = 0
     3131       .
     3132       block_where:
     3133       do v-ind = 1 to v-idx-field-qnty by 2
     3134       on error undo, return error
     3135       :
     3136         assign
     3137           v-count-fld = v-count-fld + 1
     3138         .
     3139         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3140         if v-ind = 1 then do:
     3141           assign
     3142             v-delim-key = chr(3)
     3143           .
     3144         end.
     3145       end.
     3146       delete object bh_tbl-name.
     3147     end.
     3148   end procedure.
     3149   function AddUtdErrForTab returns logical
     3150   (idb-num         as integer ,
     3151    idoc-id         as integer ,
     3152    iTab            as character,
     3153    iObj            as handle ,
     3154    iCheckType      as character,
     3155    iCodeErr        as character,
     3156    iCheckObj       as character ):
     3157      define buffer utd-err for utd-err.
     3158      define buffer utd for utd.
     3159      find first utd where utd.db-num     eq idb-num
     3160                       and utd.doc-id     eq idoc-id
     3161                       and utd.Direction  eq 'Outbound'
     3162      no-lock no-error.
     3163      if available utd
     3164      then
     3165         return no.
     3166      define variable vRecKey as character no-undo.
     3167            run gen-key-rec (input iTab,
     3168                             input  iObj,
     3169                             output vRecKey).
     3170      find first utd-err where utd-err.db-num     eq idb-num
     3171                           and utd-err.doc-id     eq idoc-id
     3172                           and utd-err.CheckType  eq iCheckType
     3173                           and utd-err.CodeErr    eq iCodeErr
     3174                           and utd-err.CheckObj   eq iCheckObj
     3175      exclusive-lock no-error.
     3176      if not available utd-err
     3177      then do:
     3178         create utd-err.
     3179         assign
     3180            utd-err.db-num         = idb-num
     3181            utd-err.doc-id         = idoc-id
     3182            utd-err.CheckType      = iCheckType
     3183            utd-err.CodeErr        = iCodeErr
     3184            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3185            utd-err.reckey         = vRecKey
     3186            utd-err.qnty           = 1
     3187         .
     3188      end.
     3189      else
     3190         utd-err.qnty = utd-err.qnty + 1.
     3191      return utd-err.qnty eq 1.
     3192   end.
     3193   function AddUtdErr returns logical
     3194   (idb-num         as integer ,
     3195    idoc-id         as integer ,
     3196    iObj            as handle ,
     3197    iCheckType      as character,
     3198    iCodeErr        as character,
     3199    iCheckObj       as character ):
     3200      AddUtdErrForTab
     3201         (idb-num,
     3202          idoc-id,
     3203          iObj:table,
     3204          iObj,
     3205          iCheckType,
     3206          iCodeErr,
     3207          iCheckObj).
     3208   end.
     3209   function ClearUtdErrTypeCode returns logical
     3210   (idb-num         as integer,
     3211    idoc-id         as integer ,
     3212    iCheckType      as character,
     3213    iCodeErr        as character
     3214    ):
     3215      define buffer utd-err for utd-err.
     3216      if    iCheckType eq "*"
     3217         or iCheckType eq ?
     3218      then do:
     3219         if     iCodeErr ne ?
     3220            and iCodeErr ne "*"
     3221         then
     3222            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3223            view-as alert-box.
     3224         else
     3225         for each utd-err where utd-err.db-num  eq idb-num
     3226                            and utd-err.doc-id  eq idoc-id
     3227         exclusive-lock:
     3228            delete utd-err.
     3229         end.
     3230      end.
     3231      else do:
     3232         if    iCodeErr eq ?
     3233            or iCodeErr eq "*"
     3234         then do:
     3235            for each utd-err where utd-err.db-num     eq idb-num
     3236                               and utd-err.doc-id     eq idoc-id
     3237                               and utd-err.CheckType  eq iCheckType
     3238            exclusive-lock:
     3239               delete utd-err.
     3240            end.
     3241         end.
     3242         else do:
     3243            for each utd-err where utd-err.db-num     eq idb-num
     3244                               and utd-err.doc-id     eq idoc-id
     3245                               and utd-err.CheckType  eq iCheckType
     3246                               and ub.utd-err.CodeErr eq iCodeErr
     3247            exclusive-lock:
     3248               delete utd-err.
     3249            end.
     3250         end.
     3251      end.
     3252   end.
     3253   function ClearUtdErr returns logical
     3254   (idb-num         as integer,
     3255    idoc-id         as integer ,
     3256    iCheckType      as character
     3257    ):
     3258      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3259   end.
     3260   function GetMesError returns character
     3261   (itxt as character,
     3262    iobj as character ):
     3263    define variable vi as integer no-undo.
     3264    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3265       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3266    end.
     3267    return itxt.
     3268   end.
     3269   function GetTextErrorType returns character
     3270   (iCheckType as character,
     3271    iCodeErr   as character,
     3272    iChechObj  as character,
     3273    iType      as character  ):
     3274      define buffer code    for code.
     3275      define variable vError as character no-undo.
     3276      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3277                        and code.code   eq iCodeErr
     3278      no-lock no-error.
     3279      if available code
     3280      then do:
     3281         define variable vType as integer no-undo.
     3282         if code.misc3 eq "error"
     3283         then
     3284            vType = 0.
     3285         else if code.misc3 eq "warning"
     3286         then
     3287            vType = 1.
     3288         else if code.misc3 eq "Hiden"
     3289         then
     3290            vType = 2.
     3291         else
     3292            vtype = int(code.misc3) no-error.
     3293         case itype:
     3294            when "error"
     3295            then do:
     3296               if vtype eq 0
     3297               then
     3298                  vError = GetMesError(Code.CodeValue,iChechObj).
     3299            end.
     3300            when "warning"
     3301            then do:
     3302               if vtype <= 1
     3303               then
     3304                  vError = GetMesError(Code.CodeValue,iChechObj).
     3305            end.
     3306            otherwise do:
     3307               vError = GetMesError(Code.CodeValue,iChechObj).
     3308            end.
     3309         end.
     3310      end.
     3311      else
     3312         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3313      return vError.
     3314   end.
     3315   function GetTypeError returns integer
     3316   (iCheckType as character,
     3317    iCodeErr   as character):
     3318      define buffer code    for code.
     3319      define variable vType as integer no-undo.
     3320      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3321                        and code.code   eq iCodeErr
     3322      no-lock no-error.
     3323      if     not available code
     3324         and code.misc3 eq "error"
     3325      then
     3326         vType = 0.
     3327      else if code.misc3 eq "warning"
     3328      then
     3329         vType = 1.
     3330      else if code.misc3 eq "Hiden"
     3331      then
     3332         vType = 2.
     3333      else
     3334         vtype = int(code.misc3) no-error.
     3335      return vtype.
     3336   end.
     3337   function GetTextError returns character
     3338   (iCheckType as character,
     3339    iCodeErr   as character,
     3340    iChechObj  as character ):
     3341      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3342   end.
     3343   function GetErrForUtdStr returns character
     3344   (idb-num     as integer ,
     3345    idoc-id     as integer ,
     3346    iCheckType  as character
     3347    ):
     3348      define buffer utd-err for utd-err.
     3349      define buffer code    for code.
     3350      define variable vHQry as handle no-undo.
     3351      define variable vError as longchar no-undo.
     3352      define variable vErrorOne as longchar  no-undo.
     3353      define variable oError as character no-undo.
     3354      create query vHQry.
     3355      vHQry:set-buffers(buffer utd-err:handle).
     3356      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3357                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3358                               + if    iCheckType eq "*"
     3359                                    or iCheckType eq ?
     3360                                 then       ""
     3361                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3362      vHQry:query-open().
     3363      vHQry:get-first().
     3364      QRY-BLOCK:
     3365      repeat while not vHQry:query-off-end:
     3366         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3367         if     vErrorOne ne ""
     3368            and vErrorOne ne ?
     3369         then
     3370            vError = vError + ", " + vErrorOne.
     3371         vHQry:get-next().
     3372      end.
     3373      oError = substring(vError,3,4002).
     3374      return oError.
     3375   end.
     3376   function GetErrJsonForUtd returns character
     3377   (idb-num         as integer ,
     3378    idoc-id         as integer ,
     3379    iCheckType      as character
     3380    ):
     3381      define buffer utd-err for utd-err.
     3382      define variable vHQry as handle no-undo.
     3383      define variable vError as longchar no-undo.
     3384      define variable oError as character no-undo.
     3385      create query vHQry.
     3386      define variable vi as integer no-undo.
     3387      vHQry:set-buffers(buffer utd-err:handle).
     3388      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3389                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3390                               + if    iCheckType eq "*"
     3391                                    or iCheckType eq ?
     3392                                 then       ""
     3393                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3394      vHQry:query-open().
     3395      vHQry:get-first().
     3396      QRY-BLOCK:
     3397      repeat while not vHQry:query-off-end:
     3398         define variable vErrorOne as character no-undo.
     3399         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3400         if     vErrorOne ne ?
     3401            and vErrorOne ne ""
     3402         then do:
     3403            vi = vi + 1.
     3404            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3405                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3406                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3407         end.
     3408         vHQry:get-next().
     3409      end.
     3410      for first utd where utd.db-num eq idb-num
     3411                      and utd.doc-id eq idoc-id
     3412                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3413      no-lock,
     3414         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3415                                  and utd-marking-lines.doc-id eq idoc-id
     3416                                  and utd-marking-lines.doc-level eq 1
     3417      no-lock,
     3418         first marking where marking.mark eq utd-marking-lines.mark
     3419                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3420      no-lock:
     3421         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3422         if     vErrorOne ne ?
     3423            and vErrorOne ne ""
     3424         then do:
     3425            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3426                            + '","ОбъектОш":"' + marking.mark
     3427                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3428         end.
     3429      end.
     3430      if vError ne ""
     3431      then
     3432         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3433      return oError.
     3434   end.
     3435   function GetErrJsonForUtdReturn returns character
     3436   (idb-num         as integer ,
     3437    idoc-id         as integer ,
     3438    iCheckType      as character
     3439    ):
     3440      define buffer utd-err for utd-err.
     3441      define variable vHQry as handle no-undo.
     3442      define variable vError as longchar no-undo.
     3443      define variable oError as character no-undo.
     3444      define variable vi as integer no-undo.
     3445      create query vHQry.
     3446      vHQry:set-buffers(buffer utd-err:handle).
     3447      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3448                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3449                               + if    iCheckType eq "*"
     3450                                    or iCheckType eq ?
     3451                                 then       ""
     3452                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3453      vHQry:query-open().
     3454      vHQry:get-first().
     3455      QRY-BLOCK:
     3456      repeat while not vHQry:query-off-end:
     3457         define variable vErrorOne as character no-undo.
     3458         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3459         if     vErrorOne ne ?
     3460            and vErrorOne ne ""
     3461         then do:
     3462            vi = vi + 1.
     3463            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3464                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3465                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3466         end.
     3467         vHQry:get-next().
     3468      end.
     3469      if vError ne ""
     3470      then
     3471         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3472      return oError.
     3473   end.
     3474   function GetCodeTextError returns character
     3475   (iCheckType as character,
     3476    iCodeErr   as character,
     3477    iChechObj  as character,
     3478    output oCode as character,
     3479    output ovalue as character ):
     3480      define buffer code    for code.
     3481      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3482                        and code.code   eq iCodeErr
     3483      no-lock no-error.
     3484      if     available code
     3485      then do:
     3486         define variable vi as integer no-undo init ?.
     3487         vi = int(Code.misc3) no-error.
     3488         if    code.misc3 ne "error"
     3489            and vi ne 0
     3490         then
     3491            oCode = ?.
     3492         else if     Code.misc1 ne ?
     3493                 and Code.misc1 ne ""
     3494         then
     3495            assign
     3496               oCode  = GetMesError(Code.misc1,iChechObj)
     3497               ovalue = GetMesError(Code.misc2,iChechObj)
     3498            .
     3499      end.
     3500      return if oCode eq ""
     3501             then ""
     3502             else (oCode + "_" + ovalue).
     3503   end.
     3504   define temp-table TT-err no-undo
     3505     field code_ as character
     3506     field text_ as character
     3507   index code_ code_.
     3508   function GetErrTxtForUtd returns character
     3509   (idb-num         as integer ,
     3510    idoc-id         as integer ,
     3511    iCheckType      as character
     3512    ):
     3513      define buffer utd-err for utd-err.
     3514      define variable vHQry as handle no-undo.
     3515      define variable oError as character no-undo.
     3516      create query vHQry.
     3517      define variable vi as integer no-undo.
     3518      for each tt-err :
     3519         delete tt-err.
     3520      end.
     3521      vHQry:set-buffers(buffer utd-err:handle).
     3522      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3523                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3524                               + if    iCheckType eq "*"
     3525                                    or iCheckType eq ?
     3526                                 then       ""
     3527                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3528      vHQry:query-open().
     3529      vHQry:get-first().
     3530      define variable vcode as character no-undo.
     3531      define variable vvalue as character no-undo.
     3532      QRY-BLOCK:
     3533      repeat while not vHQry:query-off-end:
     3534         vi = vi + 1.
     3535         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3536         if vcode ne ?
     3537         then do:
     3538            find first tt-err where tt-err.code eq vcode
     3539            no-error.
     3540            if not available tt-err
     3541            then do:
     3542               create tt-err.
     3543               assign
     3544                  tt-err.code_ = vcode
     3545                  tt-err.text_ = vvalue
     3546               .
     3547            end.
     3548            else
     3549               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3550         end.
     3551         vHQry:get-next().
     3552      end.
     3553     find first utd where utd.db-num eq idb-num
     3554                         and utd.doc-id eq idoc-id
     3555         no-lock.
     3556      define buffer cancel_utd-lines for utd-lines.
     3557      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3558                                  and cancel_utd-lines.doc-id eq idoc-id
     3559      no-lock:
     3560         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3561         then do:
     3562            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3563                                        and utd-marking-lines.doc-id eq idoc-id
     3564                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3565            no-lock,
     3566               first marking where marking.mark eq utd-marking-lines.mark
     3567                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3568            no-lock:
     3569               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3570               find first tt-err where tt-err.code eq vcode
     3571               no-error.
     3572               if not available tt-err
     3573               then do:
     3574                  create tt-err.
     3575                  assign
     3576                     tt-err.code_ = vcode
     3577                     tt-err.text_ = vvalue
     3578                  .
     3579               end.
     3580               else
     3581                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3582            end.
     3583         end.
     3584         else do:
     3585            define variable vqnty as decimal no-undo.
     3586            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3587            if vqnty eq ? then vqnty = 0.
     3588            if vqnty ne cancel_utd-lines.Quantity
     3589            then do:
     3590               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3591               find first tt-err where tt-err.code eq vcode
     3592               no-error.
     3593               if not available tt-err
     3594               then do:
     3595                  create tt-err.
     3596                  assign
     3597                     tt-err.code_ = vcode
     3598                     tt-err.text_ = vvalue
     3599                  .
     3600               end.
     3601               else
     3602                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3603            end.
     3604         end.
     3605      end.
     3606      for each tt-err:
     3607         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3608      end.
     3609      return oError.
     3610   end.
     3611   define variable mFormatErr as character no-undo init "text".
     3612   function GetErrForUtd returns character
     3613   (idb-num         as integer ,
     3614    idoc-id         as integer ,
     3615    iType           as character
     3616    ):
     3617      if mFormatErr eq "text"
     3618      then
     3619         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3620      else do:
     3621         if itype eq "return"
     3622         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3623         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3624      end.
     3625   end.
     3626   function GetErrComText returns longchar
     3627   (icomment as character,
     3628    itext    as longchar ):
     3629       define variable vText as longchar no-undo.
     3630      if mFormatErr eq "text"
     3631      then do:
     3632         if icomment ne ""
     3633         then
     3634            icomment = substitute("comment:|&1|",icomment).
     3635         vText = icomment + itext.
     3636      end.
     3637      else do:
     3638         icomment = if icomment begins  '"'
     3639                    then icomment
     3640                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3641         vText = icomment + "," + itext.
     3642         vText = "~{" + trim(vText,",") + "~}".
     3643      end.
     3644      return vText.
     3645   end.
     3646   function CheckTypeForMarkLineType returns logical
     3647   (iObj            as handle,
     3648    iCheckType      as character,
     3649    iCodeErr        as character ,
     3650    iTypeErr        as character ):
     3651      define variable vRecKey-markLine as character no-undo.
     3652      define variable vGoodMark        as logical no-undo.
     3653      define variable vdb-num          as integer no-undo.
     3654      define variable vdoc-id          as integer no-undo.
     3655      define variable vlinenum         as integer no-undo.
     3656      define variable vErrorOne as character no-undo.
     3657      define buffer buf_utd-err for utd-err.
     3658      run gen-key-rec (input "utd-marking-lines",
     3659                       input  iObj,
     3660                       output vRecKey-markLine).
     3661      vGoodMark = yes.
     3662      vdb-num = iObj::db-num.
     3663      vdoc-id = iObj::doc-id.
     3664      vlinenum = iObj::linenum.
     3665      block-mark-err:
     3666      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3667                               and buf_utd-err.db-num = vdb-num
     3668                               and buf_utd-err.reckey = vRecKey-markLine
     3669                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3670                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3671      no-lock:
     3672         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3673         if     vErrorOne ne ?
     3674            and vErrorOne ne ""
     3675         then do:
     3676            vGoodMark = no.
     3677            leave block-mark-err.
     3678         end.
     3679      end.
     3680      return not vGoodMark.
     3681   end.
     3682   function CheckErrForMarkLineType returns logical
     3683   (iObj            as handle,
     3684    iType           as character  ):
     3685      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3686   end.
     3687   function CheckErrForMarkLine returns logical
     3688   (iObj            as handle):
     3689      return CheckErrForMarkLineType(iObj,"*").
     3690   end.
     3691   function CheckErrForLineTypeCode returns logical
     3692   (iObj                 as handle,
     3693    iCheckType           as character,
     3694    iCodeErr             as character,
     3695    iTypeErr             as character,
     3696    iOneErr              as logical):
     3697      define variable vRecKey-line     as character no-undo.
     3698      define buffer buf_utd-err for utd-err.
     3699      define variable vUtdlineError as logical no-undo.
     3700      define variable vErrorOne as character no-undo.
     3701            run gen-key-rec (input "utd-lines",
     3702                             input  iObj,
     3703                             output vRecKey-line).
     3704         define variable vdb-num as integer no-undo.
     3705         define variable vdoc-id as integer no-undo.
     3706         define variable vlinenum as integer no-undo.
     3707         vdb-num = iObj::db-num.
     3708         vdoc-id = iObj::doc-id.
     3709         vlinenum = iObj::linenum.
     3710         block-err:
     3711         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3712                                  and buf_utd-err.db-num = vdb-num
     3713                                  and buf_utd-err.reckey = vRecKey-line
     3714                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3715                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3716         no-lock:
     3717            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3718            if     vErrorOne ne ?
     3719               and vErrorOne ne ""
     3720            then do:
     3721               vUtdlineError = yes.
     3722               leave block-err.
     3723            end.
     3724         end.
     3725         if  not vUtdlineError
     3726         then do:
     3727            define variable vGoodMark as logical no-undo.
     3728            vGoodMark = yes.
     3729            block-line-err:
     3730            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3731                                         and utd-marking-lines.doc-id  eq vdoc-id
     3732                                         and utd-marking-lines.LineNum eq vLineNum
     3733            no-lock:
     3734               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3735               if     vGoodMark
     3736                  and iOneErr eq no
     3737               then
     3738                  leave block-line-err.
     3739               if     iOneErr = yes
     3740                  and not vGoodMark
     3741               then
     3742                  leave block-line-err.
     3743            end.
     3744            vUtdlineError = not vGoodMark.
     3745         end.
     3746      return vUtdlineError.
     3747   end.
     3748   function getErrForLineType returns character
     3749   (iObj            as handle,
     3750    iType           as character  ):
     3751      define variable vRecKey-line     as character no-undo.
     3752      define buffer buf_utd-err for utd-err.
     3753      define variable vUtdlineError as logical no-undo.
     3754      define variable vErrorOne as character no-undo.
     3755      define variable oError as character no-undo.
     3756            run gen-key-rec (input "utd-lines",
     3757                             input  iObj,
     3758                             output vRecKey-line).
     3759         define variable vdb-num as integer no-undo.
     3760         define variable vdoc-id as integer no-undo.
     3761         define variable vlinenum as integer no-undo.
     3762         vdb-num = iObj::db-num.
     3763         vdoc-id = iObj::doc-id.
     3764         vlinenum = iObj::linenum.
     3765         block-err:
     3766         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3767                                  and buf_utd-err.db-num = vdb-num
     3768                                  and buf_utd-err.reckey = vRecKey-line
     3769                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3770         no-lock:
     3771            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3772            if     vErrorOne ne ?
     3773               and vErrorOne ne ""
     3774            then do:
     3775               oError = oError + vErrorOne + " ".
     3776            end.
     3777         end.
     3778      return oError.
     3779   end.
     3780   function CheckErrForLineType returns logical
     3781   (iObj            as handle,
     3782    iType           as character  ):
     3783       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3784   end.
     3785   function CheckErrForLine returns logical
     3786   (iObj            as handle):
     3787      return CheckErrForLineType(iobj,"*").
     3788   end.
     3789   function CheckErrForUtd returns logical
     3790   (idb-num         as integer ,
     3791    idoc-id         as integer ):
     3792      for each utd-lines where utd-lines.db-num eq idb-num
     3793                           and utd-lines.doc-id eq idoc-id
     3794      no-lock :
     3795         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3796         then
     3797            return no.
     3798      end.
     3799      return yes.
     3800   end.
     3801   function CheckMarkUtd-28rel return logical
     3802    (input idb-num as integer,
     3803    input idoc-id as integer):
     3804    define buffer utd                   for utd.
     3805    define buffer utd-lines             for utd-lines.
     3806    define buffer utd-marking-lines     for utd-marking-lines.
     3807    define variable v-par-type as character no-undo.
     3808    define variable vgdsNoMark as logical no-undo.
     3809    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3810      define variable v-par-val  as character no-undo.
     3811      find first utd where utd.db-num eq idb-num
     3812                       and utd.doc-id eq idoc-id
     3813      no-lock no-error.
     3814      if available utd
     3815      then do:
     3816         if     utd.obj-code ne ?
     3817            and utd.obj-type ne ?
     3818         then do:
     3819            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3820            Block-utd-lines:
     3821            for each utd-lines where utd-lines.db-num eq idb-num
     3822                                 and utd-lines.doc-id eq idoc-id
     3823            no-lock:
     3824               if     utd-lines.gds-code ne ?
     3825                  and utd-lines.gds-code ne 0
     3826               then do:
     3827                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3828                       ( utd-lines.gds-code,
     3829                         'mark-type':U,
     3830                          output v-par-val,
     3831                          output v-par-type
     3832                       ).
     3833                  if     EDOParSec:IsEdo
     3834                     and EDOParSec:GetIsEDOForType(v-par-val)
     3835                  then do:
     3836                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3837                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3838                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3839                                                    and length(utd-marking-lines.mark) > 13
     3840                     no-lock no-error.
     3841                     if     avail utd-marking-lines
     3842                        and not CheckErrForLine(buffer utd-lines:handle)
     3843                     then
     3844                        leave Block-utd-lines.
     3845                  end.
     3846                  else
     3847                     vgdsNoMark = yes.
     3848               end.
     3849            end.
     3850            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3851            if vgdsNoMark then return available utd-lines . else return yes .
     3852         end.
     3853      end.
     3854      return yes.
     3855   end.
     3856   function CheckMarkUtd return logical
     3857    (input idb-num  as integer,
     3858     input idoc-id  as integer):
     3859     define buffer utd-lines             for ub.utd-lines.
     3860     block-line:
     3861     for each utd-lines where utd-lines.db-num eq idb-num
     3862                          and utd-lines.doc-id eq idoc-id
     3863     no-lock:
     3864        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3865        then
     3866           leave block-line.
     3867     end.
     3868     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3869     return available utd-lines.
     3870   end.
     3871   function CheckNotMarkUtd return logical
     3872    (input idb-num  as integer,
     3873     input idoc-id  as integer):
     3874     define buffer utd-lines             for ub.utd-lines.
     3875     for each utd-lines where utd-lines.db-num eq idb-num
     3876                          and utd-lines.doc-id eq idoc-id
     3877     no-lock:
     3878        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3879        then
     3880           return yes.
     3881     end.
     3882     return no.
     3883   end.
     3884   function CheckMarkUtdLine return logical
     3885    (input idb-num  as integer,
     3886     input idoc-id  as integer,
     3887     input iLineNum as integer):
     3888    define buffer utd                   for utd.
     3889    define buffer utd-lines             for utd-lines.
     3890    define buffer utd-marking-lines     for utd-marking-lines.
     3891    define variable v-par-type as character no-undo.
     3892    define variable vMarking        as logical no-undo.
     3893    define variable vArtic          as logical no-undo.
     3894    define variable vTransitional   as logical no-undo.
     3895    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3896      define variable v-par-val  as character no-undo.
     3897      find first utd where utd.db-num eq idb-num
     3898                       and utd.doc-id eq idoc-id
     3899      no-lock no-error.
     3900      if available utd
     3901      then do:
     3902         if     utd.obj-code ne ?
     3903            and utd.obj-type ne ?
     3904         then do:
     3905            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3906            Block-utd-lines:
     3907            for each utd-lines where utd-lines.db-num   eq idb-num
     3908                                 and utd-lines.doc-id   eq idoc-id
     3909                                 and utd-lines.LineNum  eq iLineNum
     3910            no-lock:
     3911               if     utd-lines.gds-code ne ?
     3912                  and utd-lines.gds-code ne 0
     3913               then do:
     3914                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3915                       ( utd-lines.gds-code,
     3916                         'mark-type':U,
     3917                          output v-par-val,
     3918                          output v-par-type
     3919                       ).
     3920                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3921                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3922                  if vMarking
     3923                  then do:
     3924                     block-marking:
     3925                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3926                                                    and utd-marking-lines.doc-id   eq idoc-id
     3927                                                    and utd-marking-lines.LineNum  eq iLineNum
     3928                                                    and length(utd-marking-lines.mark) > 13
     3929                     no-lock:
     3930                        if isOAD(utd-marking-lines.mark)
     3931                        then do:
     3932                           assign
     3933                              vArtic   = yes
     3934                              vMarking = no
     3935                           .
     3936                           leave block-marking.
     3937                        end.
     3938                     end.
     3939                  end.
     3940                  if vArtic
     3941                  then do:
     3942                     block-artic:
     3943                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3944                                                    and utd-marking-lines.doc-id   eq idoc-id
     3945                                                    and utd-marking-lines.LineNum  eq iLineNum
     3946                                                    and length(utd-marking-lines.mark) > 13
     3947                     no-lock:
     3948                        if isMark(utd-marking-lines.mark)
     3949                        then do:
     3950                           assign
     3951                              vArtic   = no
     3952                              vMarking = yes
     3953                           .
     3954                           leave block-artic.
     3955                        end.
     3956                     end.
     3957                  end.
     3958                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3959                  if vTransitional
     3960                  then do:
     3961                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3962                                                    and utd-marking-lines.doc-id   eq idoc-id
     3963                                                    and utd-marking-lines.LineNum  eq iLineNum
     3964                                                    and length(utd-marking-lines.mark) > 13
     3965                     no-lock no-error.
     3966                     if not available utd-marking-lines
     3967                     then assign
     3968                        vMarking = no
     3969                        vArtic   = no
     3970                     .
     3971                  end.
     3972               end.
     3973               else
     3974                  assign
     3975                     vMarking      = yes
     3976                     vArtic        = no
     3977                     vTransitional = no
     3978                  .
     3979               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3980               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3981               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3982            end.
     3983         end.
     3984      end.
     3985      return vMarking or vArtic.
     3986   end.
     3987   function getMarkUtdLine return logical
     3988    (input  idb-num  as integer,
     3989     input  idoc-id  as integer,
     3990     input  iLineNum as integer,
     3991     output oMarking        as logical,
     3992     output oArtic          as logical,
     3993     output oTransitional   as logical):
     3994     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3995     oArtic        = not oMarking
     3996            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3997     oTransitional = (oMarking or oArtic)
     3998            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3999   end.
     4000   function CheckMarking return logical
     4001    (input idb-num as integer,
     4002    input idoc-id as integer,
     4003    input iTypeErr as character ):
     4004     define variable vMarkutd as logical no-undo.
     4005     define variable vCrErr   as logical no-undo.
     4006     define buffer utd-lines         for utd-lines.
     4007     define buffer utd-marking-lines for utd-marking-lines.
     4008     define buffer marking           for marking.
     4009     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     4010      block-line:
     4011      for each utd-lines where utd-lines.db-num eq idb-num
     4012                           and utd-lines.doc-id eq idoc-id
     4013      no-lock:
     4014         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     4015         then do:
     4016            for each utd-marking-lines
     4017                     where utd-marking-lines.db-num  = utd-lines.db-num
     4018                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4019                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4020            no-lock:
     4021               if isMark(utd-marking-lines.mark)
     4022               then do:
     4023                  find first marking where marking.mark eq utd-marking-lines.mark
     4024                  no-lock no-error.
     4025                  if not available marking
     4026                  then do:
     4027                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     4028                     vCrErr = yes.
     4029                     next block-line.
     4030                  end.
     4031               end.
     4032            end.
     4033         end.
     4034      end.
     4035      return vCrErr.
     4036   end.
     4037   function CheckMarkForType return logical
     4038    (input idb-num   as integer,
     4039     input idoc-id   as integer):
     4040      define variable vMarking        as logical no-undo.
     4041      define variable vArtic          as logical no-undo.
     4042      define variable vTransitional   as logical no-undo.
     4043      define buffer utd-lines         for utd-lines.
     4044      define buffer utd-marking-lines for utd-marking-lines.
     4045      block-line:
     4046      for each utd-lines where utd-lines.db-num eq idb-num
     4047                           and utd-lines.doc-id eq idoc-id
     4048      no-lock:
     4049         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     4050                          output vMarking         , output vArtic          , output vTransitional).
     4051         for each utd-marking-lines
     4052                     where utd-marking-lines.db-num  = utd-lines.db-num
     4053                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4054                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4055         no-lock:
     4056            if length(utd-marking-lines.mark) < 14
     4057            then do:
     4058               if (vMarking or vArtic) and not vTransitional
     4059               then
     4060                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4061            end.
     4062            else if not isMark(utd-marking-lines.mark)
     4063            then do:
     4064               if vMarking
     4065               then
     4066                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4067            end.
     4068            else do:
     4069            end.
     4070         end.
     4071      end.
     4072   end.
     4073   function WeighedProd return logical
     4074      ( input p-gds-code as integer) :
     4075      define variable v-par-val  as character no-undo.
     4076      define variable v-par-type as character no-undo.
     4077              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4078               ( p-gds-code,
     4079                 'weighed-gds':U,
     4080                  output v-par-val,
     4081                  output v-par-type
     4082               ).
     4083      return logical(v-par-val).
     4084   end.
     4085   function WghProdVariable return logical
     4086       (input p-obj-type as char,
     4087        input p-obj-code as integer,
     4088        input p-gds-code as integer) :
     4089      define variable v-wgh-val  as character no-undo.
     4090      define variable v-par-val  as character no-undo.
     4091      define variable v-par-type as character no-undo.
     4092      define variable vMarking        as logical no-undo.
     4093      define variable vArtic          as logical no-undo.
     4094      define variable vTransitional   as logical no-undo.
     4095      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4096         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4097           ( p-gds-code,
     4098             'weighed-gds':U,
     4099              output v-wgh-val,
     4100              output v-par-type
     4101           ).
     4102       if logical(v-wgh-val) = yes then do:
     4103           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4104               ( p-gds-code,
     4105                 'mark-type':U,
     4106                  output v-par-val,
     4107                  output v-par-type
     4108               ).
     4109           if v-par-val <> "" then do:
     4110               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     4111               assign
     4112                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     4113                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     4114                  .
     4115           end.
     4116      end.
     4117      if v-wgh-val > "" and (vMarking or vArtic)
     4118      then return yes.
     4119      else return no.
     4120   end.
     4121   function MarkWeight return decimal
     4122      ( input p-mark as character) :
     4123      define buffer  buf_marking-attr for  ub.marking-attr.
     4124      define variable vMarkWeight as decimal no-undo.
     4125      vMarkWeight = 0.
     4126      if p-mark <> "" and p-mark <> ?
     4127      then do:
     4128          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4129                                        and buf_marking-attr.attr-code eq "weight"
     4130             no-lock no-error.
     4131          if not available buf_marking-attr
     4132          then do :
     4133            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4134                                          and buf_marking-attr.attr-code eq "weight"
     4135               no-lock no-error.
     4136          end .
     4137          if avail buf_marking-attr
     4138          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4139      end.
     4140      return vMarkWeight.
     4141   end.
     4142   define input  parameter parparentproc         as handle              no-undo .
     4143   define variable iLang           as integer   no-undo.
     4144   define variable p-value-logical as logical no-undo.
     4145   define variable p-value-character  as character no-undo.
     4146   define variable p-value-date       as date no-undo.
     4147   define variable p-value-decimal    as decimal no-undo.
     4148   define variable p-value-integer    as integer no-undo.
     4149   define variable p-param-type       as character no-undo.
     4150   define variable v-tth as handle no-undo .
     4151   define variable v-alc-code      as character no-undo .
     4152   define variable v-proc-name-err as character no-undo initial 'impmark.txt'.
     4153   define variable l-error         as logical   no-undo.
     4154   define variable v-user-action   as character no-undo.
     4155   define variable v-printed       as logical   no-undo.
     4156   define variable v-mark-short     as character no-undo.
     4157   define buffer t_doc        for ub.fbr-doc .
     4158   define buffer bf_fbr-doc   for ub.fbr-doc .
     4159   define buffer buf_marking  for ub.marking .
     4160   define buffer buf_marking-lines  for ub.marking-lines .
     4161   define buffer bf_fbr-line  for ub.fbr-line.
     4162   define buffer buf_recipe   for ub.recipe .
     4163   define buffer bf_bar-code  for ub.bar-code.
     4164   define variable v-timedelay  as integer   no-undo.
     4165   define variable v-scan-str as character no-undo.
     4166   define variable v-num-str as integer no-undo .
     4167   define variable v-manual as logical no-undo .
     4168   define variable marking    as class ibs.th.skt.ControlledClients.marking.
     4169   define stream str-err .
     4170   define stream in-stream.
     4171   DEFINE BUTTON b-cancel auto-end-key
     4172        LABEL "&Отмена"
     4173        SIZE 10 BY 1
     4174        BGCOLOR 8 .
     4175   DEFINE BUTTON b-exit AUTO-GO
     4176        LABEL "&Ввод"
     4177        SIZE 10 BY 1
     4178        BGCOLOR 8 .
     4179   DEFINE BUTTON B_mark
     4180        LABEL "Марки"
     4181        SIZE 10 BY 1.
     4182   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
     4183        VIEW-AS FILL-IN
     4184        SIZE 95 BY 1 NO-UNDO.
     4185   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     4186        VIEW-AS FILL-IN
     4187        SIZE 95 BY 1 NO-UNDO.
     4188   DEFINE QUERY br-fbr-line FOR
     4189         tt-fbr-line SCROLLING.
     4190   DEFINE BROWSE br-fbr-line
     4191     QUERY br-fbr-line DISPLAY
     4192       tt-fbr-line.num format ">>>>>9" label "Номер"
     4193       tt-fbr-line.gds-code format ">>>>>>>>>>>>>>9" label "Код"
     4194       tt-fbr-line.gds-name format "X(150)" width 40 label "Наименование"
     4195       tt-fbr-line.ingr-qnty format ">>>>>>>>>>>9.999" label "Количество"
     4196       tt-fbr-line.unit format "X(13)" label "Ед. измерения"
     4197       WITH SEPARATORS SIZE 95 BY 8.
     4198   DEFINE FRAME Dialog-Frame
     4199        "Марка для производства:" VIEW-AS TEXT
     4200             SIZE 28 BY .95 AT ROW 1.3 COL 3.4 WIDGET-ID 90
     4201        v-mark AT ROW 2.4 COL 1 COLON-ALIGNED NO-LABEL
     4202        br-fbr-line at row 3.5 col 1 COLON-ALIGNED
     4203        f-msg AT ROW 12 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 92
     4204        B_mark AT ROW 13.2 COL 1 COLON-ALIGNED WIDGET-ID 80
     4205        b-exit AT ROW 13.2 COL 12 COLON-ALIGNED
     4206        b-cancel AT ROW 13.2 COL 23 COLON-ALIGNED
     4207        SPACE(1.0) SKIP(1)
     4208       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4209            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4210            TITLE "Резервирование марок для производства"
     4211            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
     4212   ASSIGN
     4213          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4214          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4215   ASSIGN
     4216          f-msg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4217   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     4218   do:
     4219     find first tt-fbr-line no-error .
     4220     find first tt-marking-lines no-error .
     4221     if available tt-fbr-line
     4222     and available tt-marking-lines
     4223     then do :
     4224       run waitfram-show in this-procedure (input "Ждите... Идёт создание и закрытие документа производства").
     4225       run str/cr-fbr-doc-mark.p ( input parparentproc
     4226                                 , input this-procedure
     4227                                 , input table tt-fbr-line by-reference
     4228                                 , input table tt-marking-lines by-reference
     4229                                 ) .
     4230       run waitfram-hide in this-procedure .
     4231     end .
     4232     empty temp-table tt-fbr-line .
     4233   end.
     4234   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     4235   do:
     4236     for each tt-marking-lines :
     4237       find first buf_marking exclusive-lock where buf_marking.mark = tt-marking-lines.mark no-error .
     4238       if locked buf_marking
     4239       then do :
     4240       end .
     4241       if not available buf_marking
     4242       then do :
     4243         next .
     4244       end .
     4245       assign buf_marking.sts = tt-marking-lines.old-sts .
     4246     end .
     4247     empty temp-table tt-marking-lines .
     4248   end.
     4249   ON any-printable OF v-mark IN FRAME Dialog-Frame
     4250   do:
     4251     run proc-any-key.
     4252   end.
     4253   ON CHOOSE OF B_mark IN FRAME Dialog-Frame
     4254   DO:
     4255     find first tt-marking-lines no-error .
     4256     if available (tt-marking-lines) then
     4257     do:
     4258       run str/mark_browse.w (input parparentproc,
     4259         input-output table tt-marking-lines by-reference,
     4260         input 'ПРОСМОТР':U,
     4261         input "Марки по документу",
     4262         input "0",
     4263         input ""
     4264         )  .
     4265     end.
     4266   END.
     4267   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     4268   DO:
     4269       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4270       run adm/shattri.p (
     4271                  input "get":U
     4272                  ,input  v-cntxt-obj-type
     4273                  ,input  v-cntxt-obj-code
     4274                  ,input  'marking':U
     4275                  ,input  'rus-key':U
     4276                  ,output p-value-character
     4277                  ,output p-value-date
     4278                  ,output p-value-decimal
     4279                  ,output p-value-integer
     4280                  ,output p-value-logical
     4281                  ,output p-param-type
     4282                  ,input-output table-handle v-tth
     4283                  ) no-error .
     4284       IF p-value-logical = yes THEN  iLang = 68748313.
     4285       run ActivateKeyboardLayout (input iLang, input 0).
     4286     END.
     4287   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     4288   DO:
     4289       assign frame Dialog-Frame v-mark .
     4290   END.
     4291   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     4292   DO:
     4293       run save_update .
     4294   END.
     4295   ON return OF v-mark IN FRAME Dialog-Frame
     4296   DO:
     4297       run save_update .
     4298   END.
     4299   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4300     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4301   MAIN-BLOCK:
     4302   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4303     :
     4304   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4305     run mainmenu_getcntxt in parparentproc
     4306       (output v-cntxt-db-num
     4307       ,output v-cntxt-userid
     4308       ,output v-cntxt-level
     4309       ,output v-cntxt-host-code-obj
     4310       ,output v-cntxt-obj-type
     4311       ,output v-cntxt-obj-code
     4312       ,output v-cntxt-db-num-obj
     4313       ,output v-cntxt-is-admin
     4314       ) .
     4315     assign v-num-str = 0 .
     4316     marking = new ibs.th.skt.ControlledClients.marking() .
     4317     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4318     run adm/shattri.p (
     4319              input "get":U
     4320              ,input  v-cntxt-obj-type
     4321              ,input  v-cntxt-obj-code
     4322              ,input  'marking':U
     4323              ,input  'rus-key':U
     4324              ,output p-value-character
     4325              ,output p-value-date
     4326              ,output p-value-decimal
     4327              ,output p-value-integer
     4328              ,output p-value-logical
     4329              ,output p-param-type
     4330              ,input-output table-handle v-tth
     4331              ) no-error .
     4332     IF p-value-logical = yes THEN  iLang = 68748313.
     4333     run ActivateKeyboardLayout (input iLang, input 0).
     4334     RUN enable_UI.
     4335     apply "entry" to v-mark in FRAME Dialog-Frame.
     4336     enable v-mark with frame Dialog-Frame.
     4337     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     4338     then v-manual = yes.
     4339     else do:
     4340       v-manual = no .
     4341       v-mark:READ-ONLY IN FRAME Dialog-Frame = TRUE .
     4342     end.
     4343     WAIT-FOR GO OF FRAME Dialog-Frame.
     4344   END.
     4345   RUN disable_UI.
     4346   PROCEDURE ActivateKeyboardLayout external "user32":
     4347   define input parameter P1 as LONG.
     4348      define input parameter P2 as LONG.
     4349   END PROCEDURE.
     4350   PROCEDURE CrCheckMark :
     4351     define buffer buf_goods for ub.goods .
     4352     define buffer buf_recipe for ub.recipe .
     4353     define buffer buf_recipe-gds for ub.recipe-gds .
     4354     define buffer buf_marking-child for ub.marking .
     4355     define buffer buf_marking-parent for ub.marking .
     4356     define buffer buf_gds-obj for ub.gds-obj .
     4357     define variable v-par-type as character no-undo.
     4358     define variable v-par-val  as character no-undo.
     4359     define variable v-gds-code as integer no-undo .
     4360     define variable v-num-recipes as integer no-undo .
     4361     define variable v-GTIN as character no-undo .
     4362     define variable v-GTIN-qnty as decimal no-undo .
     4363     define variable v-mark-weight as decimal no-undo .
     4364     define variable v-isweighed as logical no-undo .
     4365     define variable v-mark-child-qnty as decimal no-undo .
     4366     define variable v-free-qnty as decimal no-undo .
     4367     define variable v-old-sts as integer no-undo .
     4368     define variable v-recipe-code like ub.recipe.recipe-code no-undo .
     4369     define variable v-ingr-gds-code as integer no-undo .
     4370     define variable v-koef-qnty as decimal no-undo .
     4371     define variable v-exp-date-txt as character no-undo .
     4372     define variable v-GisMTcheckStatus as integer no-undo .
     4373     define variable v-is-off-line as logical no-undo .
     4374     assign
     4375       v-mark = v-mark:screen-value in frame Dialog-Frame.
     4376     if v-mark = ""
     4377       then return.
     4378     v-mark-short = GetCodeIdent(v-mark).
     4379     if v-mark-short = "" or v-mark-short = ?
     4380     then do:
     4381       run dispmessage ("Неизвестный формат марки.").
     4382       return.
     4383     end.
     4384     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     4385     if available buf_marking
     4386     then do :
     4387       v-GTIN = getGtinByDM(buf_marking.mark) .
     4388     end .
     4389     else do :
     4390       v-GTIN = getGtinByDM(v-mark) .
     4391     end .
     4392     v-gds-code = getGdsCodeByGtin(v-GTIN) .
     4393     v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     4394     if v-gds-code = ?
     4395     then do :
     4396       run dispmessage ("Товар не найден.").
     4397       return.
     4398     end .
     4399     find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     4400     if not available buf_goods
     4401     then do :
     4402       run dispmessage ("Товар не найден.").
     4403       return.
     4404     end .
     4405     if v-GTIN-qnty = ?
     4406     or v-GTIN-qnty <= 0.0
     4407     then do :
     4408       run dispmessage ("Не установлен коэффициент для упаковки.").
     4409       return.
     4410     end .
     4411       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4412     ( buf_goods.gds-code,
     4413      'mark-type':U,
     4414      output v-par-val,
     4415      output v-par-type
     4416     ).
     4417     v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
     4418     if v-isweighed
     4419     then do :
     4420       if available buf_marking
     4421       then do :
     4422         v-mark-weight = MarkWeight(buf_marking.mark).
     4423         if v-mark-weight = 0
     4424         or v-mark-weight = ?
     4425         then do :
     4426           run dispmessage ("Марка не может быть добавлена, т.к. в БД отсутствует ее вес.").
     4427           return.
     4428         end .
     4429       end .
     4430       else do :
     4431         run dispmessage ("Марка не найдена в БД.").
     4432         return.
     4433       end .
     4434     end.
     4435     if not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     4436     and not v-isweighed
     4437     then do :
     4438       run dispmessage ("Сканирование марок данного товара для производства не требуется").
     4439       return.
     4440     end .
     4441     assign v-num-recipes = 0 .
     4442     for each buf_recipe-gds no-lock where buf_recipe-gds.artic     = buf_goods.artic
     4443                                       and buf_recipe-gds.prod-type = buf_goods.prod-type
     4444                                       and buf_recipe-gds.prod-code = buf_goods.prod-code,
     4445     each buf_recipe no-lock where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     4446                               and buf_recipe.recipe-type = 'альтернатива':U
     4447                               and buf_recipe.stts       <> 2
     4448     :
     4449       assign
     4450         v-num-recipes   = v-num-recipes + 1
     4451         v-recipe-code   = buf_recipe.recipe-code
     4452         v-ingr-gds-code = buf_recipe.gds-code
     4453         v-koef-qnty     = buf_recipe-gds.qnty
     4454       .
     4455     end .
     4456     if v-num-recipes = 0
     4457     then do :
     4458       message substitute("Для товара &1 &2 рецепт не найден. Обратитесь в офис для создания рецепта", buf_goods.gds-code, buf_goods.gds-name)
     4459       view-as alert-box .
     4460       return.
     4461     end .
     4462     if v-num-recipes <> 1
     4463     then do :
     4464       message substitute("Для товара &1 &2 найдено более одного рецепта «Альтернатива», поэтому автоматический выбор рецепта невозможен, товар не добавлен. Создайте документ производства с этим товаром вручную. Обратитесь в офис для корректировки рецептов", buf_goods.gds-code, buf_goods.gds-name)
     4465       view-as alert-box .
     4466       return.
     4467     end .
     4468     run waitfram-show in this-procedure (input "Идет проверка марки, пожалуйста, подождите..." ).
     4469     if available buf_marking
     4470     then do :
     4471       v-exp-date-txt = marking:ChekExpirationDate(v-cntxt-obj-type, v-cntxt-obj-code, buffer buf_marking).
     4472       if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     4473       and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4474       then do :
     4475         run waitfram-hide in this-procedure .
     4476         message (substitute("Операция невозможна. Статус марки – <&1>. ", objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)) + v-exp-date-txt)
     4477         view-as alert-box .
     4478         return.
     4479       end .
     4480       if v-exp-date-txt > ""
     4481       then do :
     4482         run waitfram-hide in this-procedure .
     4483         message (v-exp-date-txt)
     4484         view-as alert-box .
     4485         return .
     4486       end .
     4487     end .
     4488     else do :
     4489       create buf_marking .
     4490       assign
     4491         buf_marking.mark = v-mark-short
     4492         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     4493         buf_marking.box-qnty = v-GTIN-qnty
     4494         buf_marking.obj-type = v-cntxt-obj-type
     4495         buf_marking.obj-code = v-cntxt-obj-code
     4496         buf_marking.gds-code = buf_goods.gds-code
     4497         buf_marking.unit     = buf_goods.unit-base
     4498         buf_marking.gds-ext-id = v-GTIN
     4499       .
     4500     end .
     4501     run waitfram-hide in this-procedure .
     4502     find first tt-marking-lines where buf_marking.mark begins tt-marking-lines.mark no-error.
     4503     if available tt-marking-lines
     4504     then do :
     4505       run dispmessage ("Марка добавлена в документ ранее.").
     4506       return.
     4507     end .
     4508     if integer(v-GTIN-qnty) <> 1
     4509     then do :
     4510       assign v-mark-child-qnty = 0 .
     4511       if available buf_marking
     4512       then do :
     4513         for each buf_marking-child no-lock where buf_marking-child.mark-parent = buf_marking.mark :
     4514           v-mark-child-qnty = v-mark-child-qnty + 1 .
     4515         end .
     4516       end .
     4517       if v-mark-child-qnty <> v-GTIN-qnty
     4518       then do :
     4519         run dispmessage ("Состав групповой упаковки неизвестен, необходимо отсканировать потребительские упаковки").
     4520         return.
     4521       end .
     4522     end .
     4523     assign v-free-qnty = 0 .
     4524     find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     4525                                      and buf_gds-obj.obj-code  = v-cntxt-obj-code
     4526                                      and buf_gds-obj.artic     = buf_goods.artic
     4527                                      and buf_gds-obj.prod-type = buf_goods.prod-type
     4528                                      and buf_gds-obj.prod-code = buf_goods.prod-code
     4529                                      no-error .
     4530     if available buf_gds-obj
     4531     then do :
     4532       assign v-free-qnty = buf_gds-obj.free-qnty .
     4533     end .
     4534     find first tt-fbr-line where tt-fbr-line.gds-code = buf_goods.gds-code no-error .
     4535     if not available tt-fbr-line
     4536     then do :
     4537       assign v-num-str = v-num-str + 1 .
     4538       create tt-fbr-line .
     4539       assign
     4540         tt-fbr-line.num = v-num-str
     4541         tt-fbr-line.gds-code = buf_goods.gds-code
     4542         tt-fbr-line.gds-name = buf_goods.gds-name
     4543         tt-fbr-line.qnty = 0
     4544         tt-fbr-line.ingr-qnty = 0
     4545         tt-fbr-line.recipe-code = v-recipe-code
     4546         tt-fbr-line.recipe-type = 'альтернатива':U
     4547         tt-fbr-line.ingr-gds-code = v-ingr-gds-code
     4548         tt-fbr-line.unit = buf_goods.unit-base
     4549         tt-fbr-line.weighed = v-isweighed
     4550         tt-fbr-line.mark-weight = v-mark-weight
     4551       .
     4552     end .
     4553     if tt-fbr-line.weighed and
     4554        (tt-fbr-line.ingr-qnty + v-mark-weight) <= v-free-qnty
     4555     then do :
     4556       assign
     4557         tt-fbr-line.qnty = tt-fbr-line.qnty + (v-mark-weight * v-koef-qnty)
     4558         tt-fbr-line.ingr-qnty = tt-fbr-line.ingr-qnty + v-mark-weight
     4559       .
     4560     end .
     4561     else if (tt-fbr-line.ingr-qnty + v-GTIN-qnty) <= v-free-qnty
     4562     then do :
     4563       assign
     4564         tt-fbr-line.qnty = tt-fbr-line.qnty + (v-GTIN-qnty * v-koef-qnty)
     4565         tt-fbr-line.ingr-qnty = tt-fbr-line.ingr-qnty + v-GTIN-qnty
     4566       .
     4567     end .
     4568     else do :
     4569       if tt-fbr-line.ingr-qnty = 0
     4570       then do :
     4571         assign v-num-str = v-num-str - 1 .
     4572         delete tt-fbr-line .
     4573       end .
     4574       run dispmessage ("Марка не может быть добавлена, т.к. будут превышены книжные остатки товара").
     4575       return.
     4576     end .
     4577     find current buf_marking exclusive-lock no-error .
     4578     if locked buf_marking
     4579     then do :
     4580       if tt-fbr-line.weighed
     4581       then do :
     4582         assign tt-fbr-line.ingr-qnty = tt-fbr-line.ingr-qnty - v-mark-weight .
     4583       end .
     4584       else do :
     4585         assign tt-fbr-line.ingr-qnty = tt-fbr-line.ingr-qnty - v-GTIN-qnty .
     4586       end .
     4587       if tt-fbr-line.ingr-qnty = 0
     4588       then do :
     4589         assign v-num-str = v-num-str - 1 .
     4590         delete tt-fbr-line .
     4591       end .
     4592       run dispmessage ("Марка не может быть добавлена, т.к. с ней работает другой пользователь").
     4593       return.
     4594     end .
     4595     assign
     4596       v-old-sts = buf_marking.sts
     4597       buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4598     .
     4599     create tt-marking-lines .
     4600     assign
     4601       tt-marking-lines.mark = buf_marking.mark
     4602       tt-marking-lines.gds-code = buf_goods.gds-code
     4603       tt-marking-lines.gds-name = buf_goods.gds-name
     4604       tt-marking-lines.obj-type = v-cntxt-obj-type
     4605       tt-marking-lines.obj-code = v-cntxt-obj-code
     4606       tt-marking-lines.sts      = buf_marking.sts
     4607       tt-marking-lines.old-sts  = v-old-sts
     4608       tt-marking-lines.box-qnty = v-GTIN-qnty
     4609       tt-marking-lines.doc-level = 1
     4610       tt-marking-lines.weight = if v-isweighed then string(v-mark-weight) else ""
     4611     .
     4612     for each buf_marking-child exclusive-lock where buf_marking-child.mark-parent = buf_marking.mark :
     4613       assign
     4614         v-old-sts = buf_marking-child.sts
     4615         buf_marking-child.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4616       .
     4617       create tt-marking-lines .
     4618       assign
     4619         tt-marking-lines.mark = buf_marking-child.mark
     4620         tt-marking-lines.gds-code = buf_goods.gds-code
     4621         tt-marking-lines.gds-name = buf_goods.gds-name
     4622         tt-marking-lines.obj-type = v-cntxt-obj-type
     4623         tt-marking-lines.obj-code = v-cntxt-obj-code
     4624         tt-marking-lines.sts      = buf_marking-child.sts
     4625         tt-marking-lines.old-sts  = v-old-sts
     4626         tt-marking-lines.box-qnty = 1.0
     4627         tt-marking-lines.doc-level = 2
     4628       .
     4629     end .
     4630     for first buf_marking-parent exclusive-lock where buf_marking-parent.mark = buf_marking.mark-parent
     4631                                                   and buf_marking.mark-parent > ""
     4632     :
     4633       assign buf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4634     end .
     4635   end.
     4636   PROCEDURE disable_UI :
     4637     HIDE FRAME Dialog-Frame.
     4638   END PROCEDURE.
     4639   PROCEDURE dispmessage :
     4640   define input parameter p-str as character no-undo.
     4641     f-msg:fgcolor in frame Dialog-Frame = 12.
     4642     do:
     4643       display p-str @ f-msg with frame Dialog-Frame.
     4644     end.
     4645   END PROCEDURE.
     4646   PROCEDURE enable_UI :
     4647     DISPLAY v-mark f-msg br-fbr-line
     4648         WITH FRAME Dialog-Frame.
     4649     ENABLE v-mark B_mark b-exit b-cancel br-fbr-line
     4650         WITH FRAME Dialog-Frame.
     4651     VIEW FRAME Dialog-Frame.
     4652   END PROCEDURE.
     4653   PROCEDURE LoadKeyboardLayoutA external "user32":
     4654     define input  parameter P1 as char.
     4655     define input  parameter P2 as LONG.
     4656     define return parameter pret as LONG.
     4657   end procedure.
     4658   PROCEDURE proc-any-key :
     4659     if not v-manual
     4660       then
     4661       if v-scan-str = ""
     4662         then etime(yes).
     4663       else
     4664         if etime > 700
     4665           then v-scan-str = "".
     4666     v-scan-str = v-scan-str + last-event:label.
     4667   end.
     4668   PROCEDURE save_update :
     4669     define variable v-error      as logical   no-undo init no.
     4670     define variable l-error      as logical   no-undo init no.
     4671     define variable v-error-lang as logical   no-undo init no.
     4672     define variable ii           as integer   no-undo .
     4673     define variable chg-qnty     as integer   no-undo .
     4674     do trans:
     4675       f-msg:screen-value in frame Dialog-Frame = "" .
     4676       if v-mark:screen-value in frame Dialog-Frame = ""
     4677       then do:
     4678         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4679         v-scan-str = "".
     4680       end.
     4681       assign
     4682         v-mark = v-mark:screen-value in frame Dialog-Frame.
     4683       if v-mark = ""
     4684         then return.
     4685       run CrCheckMark.
     4686       open query br-fbr-line for each tt-fbr-line by tt-fbr-line.num INDEXED-REPOSITION .
     4687       v-mark = "".
     4688       v-mark:screen-value in frame Dialog-Frame = "".
     4689       v-mark-short = "".
     4690     end.
     4691   end procedure.
