      655   procedure lineattr-delete-flora-all :
      656     do
      657     on error undo, return error return-value
      658     :
      659       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      660       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      661       define input  parameter p-prt-code    as integer   no-undo .
      662       define buffer buf_doc-line-attr for ub.doc-line-attr .
      663       for each buf_doc-line-attr exclusive-lock
      664         where buf_doc-line-attr.doc-code  = p-doc-code
      665           and buf_doc-line-attr.gds-code  = p-gds-code
      666           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      667        :
      668         delete buf_doc-line-attr.
      669       end.
      670    end.
      671   end procedure.
      672   procedure lineattr-exist-flora-gds :
      673     do
      674     on error undo, return error return-value
      675     :
      676       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      677       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      678       define input  parameter p-prt-code    as integer   no-undo .
      679       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      680       define output parameter p-exist as logical   no-undo .
      681       define buffer buf_doc-line-attr for ub.doc-line-attr .
      682       p-exist = false .
      683       find first buf_doc-line-attr no-lock
      684         where buf_doc-line-attr.doc-code  = p-doc-code
      685           and buf_doc-line-attr.gds-code  = p-gds-code
      686           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      687         no-error .
      688       if avail buf_doc-line-attr then do:
      689         assign
      690          p-exist = true
      691         .
      692       end.
      693     end.
      694   end procedure.
      695   procedure lineattr-write-add-line-cli :
      696   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      697   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      698   define input  parameter p-cli-type      as character no-undo .
      699   define input  parameter p-cli-code      as integer   no-undo .
      700   define input  parameter p-contract-code as integer   no-undo .
      701   define input  parameter p-host-code     as integer   no-undo .
      702   define input  parameter p-exch-code     as integer   no-undo .
      703   define input  parameter p-exch-rate     as decimal   no-undo .
      704   define input  parameter p-exch-scale    as integer   no-undo .
      705   define input  parameter p-sum-cli       as decimal   no-undo .
      706   define input  parameter p-sum-vat       as decimal   no-undo .
      707   define buffer buf_doc-line-attr for ub.doc-line-attr .
      708     do
      709     on error undo, return error return-value
      710     :
      711       find first buf_doc-line-attr exclusive-lock
      712         where buf_doc-line-attr.doc-code  = p-doc-code
      713           and buf_doc-line-attr.gds-code  = p-gds-code
      714           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      715                                             chr(4) + p-cli-type +
      716                                             chr(4) + string(p-cli-code) +
      717                                             chr(4) + string(p-contract-code) +
      718                                             chr(4) + string(p-host-code)
      719         no-error .
      720       if not available buf_doc-line-attr then do:
      721         create buf_doc-line-attr .
      722         assign
      723           buf_doc-line-attr.doc-code  = p-doc-code
      724           buf_doc-line-attr.gds-code  = p-gds-code
      725           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      726                                         chr(4) + p-cli-type +
      727                                         chr(4) + string(p-cli-code) +
      728                                         chr(4) + string(p-contract-code) +
      729                                         chr(4) + string(p-host-code)
      730         .
      731       end.
      732       assign
      733         buf_doc-line-attr.attr-value =
      734         string(p-exch-code)  + chr(4) +
      735         string(p-exch-rate)  + chr(4) +
      736         string(p-exch-scale) + chr(4) +
      737         string(p-sum-cli)    + chr(4) +
      738         string(p-sum-vat)
      739         .
      740     end.
      741   end procedure.
      742   procedure lineattr-value-add-line-cli :
      743   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      744   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      745   define input   parameter p-cli-type      as character no-undo .
      746   define input   parameter p-cli-code      as integer   no-undo .
      747   define input   parameter p-contract-code as integer   no-undo .
      748   define input   parameter p-host-code     as integer   no-undo .
      749   define output  parameter p-exch-code     as integer   no-undo .
      750   define output  parameter p-exch-rate     as decimal   no-undo .
      751   define output  parameter p-exch-scale    as integer   no-undo .
      752   define output  parameter p-sum-cli       as decimal   no-undo .
      753   define output  parameter p-sum-vat       as decimal   no-undo .
      754   define buffer buf_doc-line-attr for ub.doc-line-attr .
      755     do
      756     on error undo, return error return-value
      757     :
      758       find first buf_doc-line-attr exclusive-lock
      759         where buf_doc-line-attr.doc-code  = p-doc-code
      760           and buf_doc-line-attr.gds-code  = p-gds-code
      761           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      762                                             chr(4) + p-cli-type +
      763                                             chr(4) + string(p-cli-code) +
      764                                             chr(4) + string(p-contract-code) +
      765                                             chr(4) + string(p-host-code)
      766         no-error .
      767       if available buf_doc-line-attr then do:
      768        assign
      769           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      770           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      771           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      772           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      773           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      774          .
      775        end.
      776     end.
      777   end procedure.
      778   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      779     define variable v-code as character no-undo .
      780     define variable v-type as character no-undo .
      781     define variable v-gds-code as integer   no-undo .
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      784     (input  local-doc-line.artic
      785     ,input  local-doc-line.prod-type
      786     ,input  local-doc-line.prod-code
      787     ,output v-gds-code
      788     )  .
      789     run lineattr-value (
      790         input   local-doc-line.doc-code ,
      791         input   v-gds-code              ,
      792         input   'reason-code':U ,
      793         output  v-code                  ,
      794         output  v-type ) .
      795     find first ub.trn-reason no-lock where
      796                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      797     if not available ub.trn-reason then do:
      798        return "" .
      799     end.
      800     else do:
      801        return ub.trn-reason.reason-name .
      802     end.
      803   end function.
      804   procedure lineattr-value-parts :
      805     do
      806     on error undo, return error return-value
      807     :
      808       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      809       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      810       define input  parameter p-part-code   as character no-undo .
      811       define input  parameter p_in-code     as character no-undo .
      812       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      813       define output parameter p-value       as    decimal   no-undo .
      814       define buffer buf_doc-line-attr for ub.doc-line-attr .
      815       find first buf_doc-line-attr no-lock
      816         where buf_doc-line-attr.doc-code  = p-doc-code
      817           and buf_doc-line-attr.gds-code  = p-gds-code
      818           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      819         no-error .
      820       if avail buf_doc-line-attr then do:
      821         assign
      822           p-value = decimal( buf_doc-line-attr.attr-value)
      823         .
      824       end.
      825       else do:
      826         assign
      827           p-value = 0
      828         .
      829       end.
      830     end.
      831   end procedure.
      832   procedure lineattr-write-parts :
      833     do
      834     on error undo, return error return-value
      835     :
      836       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      837       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      838       define input parameter p-part-code  as character no-undo .
      839       define input parameter p_in-code    as character no-undo .
      840       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      841       define input parameter p-value      as decimal   no-undo .
      842       define buffer buf_doc-line-attr for ub.doc-line-attr .
      843       find first buf_doc-line-attr exclusive-lock
      844         where buf_doc-line-attr.doc-code  = p-doc-code
      845           and buf_doc-line-attr.gds-code  = p-gds-code
      846           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      847         no-error .
      848       if not available buf_doc-line-attr then do:
      849         create buf_doc-line-attr .
      850         assign
      851           buf_doc-line-attr.doc-code  = p-doc-code
      852           buf_doc-line-attr.gds-code  = p-gds-code
      853           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      854         .
      855       end.
      856       assign
      857         buf_doc-line-attr.attr-value = string( p-value )
      858       .
      859     end.
