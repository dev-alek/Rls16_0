      358   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure lineattr-value :
      360     do
      361     on error undo, return error return-value
      362     :
      363       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      364       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      365       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      366       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      367       define output parameter p-type     as character no-undo .
      368       define buffer buf_doc-line-attr for ub.doc-line-attr .
      369       def var v-format         as character no-undo .
      370       def var v-fillin_width   as integer   no-undo .
      371       def var v-fillin_height  as integer   no-undo .
      372       def var v-label          as character no-undo .
      373       def var v-user-can-edit  as logical   no-undo .
      374       def var v-output-display as logical   no-undo .
      375       def var v-other          as character no-undo .
      376       run lineattr-code in this-procedure
      377         (input  p-code
      378         ,output p-type
      379         ,output v-format
      380         ,output v-fillin_width
      381         ,output v-fillin_height
      382         ,output v-label
      383         ,output v-user-can-edit
      384         ,output v-output-display
      385         ,output v-other
      386         ) no-error .
      387       if error-status :error then do:
      388         undo, return error return-value .
      389       end.
      390       find first buf_doc-line-attr no-lock
      391         where buf_doc-line-attr.doc-code  = p-doc-code
      392           and buf_doc-line-attr.gds-code  = p-gds-code
      393           and buf_doc-line-attr.attr-code = p-code
      394         no-error .
      395       if avail buf_doc-line-attr then do:
      396         assign
      397           p-value =  buf_doc-line-attr.attr-value
      398         .
      399       end.
      400       else do:
      401         assign
      402           p-value = if p-type = 'L':U then "no":U else ""
      403         .
      404       end.
      405     end.
      406   end procedure.
      407   procedure lineattr-write :
      408     do
      409     on error undo, return error return-value
      410     :
      411       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      412       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      413       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      414       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      415       define buffer buf_doc-line-attr for ub.doc-line-attr .
      416       def var v-type           as character no-undo .
      417       def var v-format         as character no-undo .
      418       def var v-fillin_width   as integer   no-undo .
      419       def var v-fillin_height  as integer   no-undo .
      420       def var v-label          as character no-undo .
      421       def var v-user-can-edit  as logical   no-undo .
      422       def var v-output-display as logical   no-undo .
      423       def var v-other          as character no-undo .
      424       run lineattr-code in this-procedure
      425         (input  p-code
      426         ,output v-type
      427         ,output v-format
      428         ,output v-fillin_width
      429         ,output v-fillin_height
      430         ,output v-label
      431         ,output v-user-can-edit
      432         ,output v-output-display
      433         ,output v-other
      434         ) no-error .
      435       if error-status :error then do:
      436         undo, return error return-value .
      437       end.
      438       find first buf_doc-line-attr exclusive-lock
      439         where buf_doc-line-attr.doc-code  = p-doc-code
      440           and buf_doc-line-attr.gds-code  = p-gds-code
      441           and buf_doc-line-attr.attr-code = p-code
      442         no-error .
      443       if not available buf_doc-line-attr then do:
      444         create buf_doc-line-attr .
      445         assign
      446           buf_doc-line-attr.doc-code  = p-doc-code
      447           buf_doc-line-attr.gds-code = p-gds-code
      448           buf_doc-line-attr.attr-code = p-code
      449         .
      450       end.
      451       assign
      452         buf_doc-line-attr.attr-value = p-value
      453       .
      454        release buf_doc-line-attr.
      455     end.
      456   end procedure.
      457   procedure lineattr-exist :
      458     do
      459     on error undo, return error return-value
      460     :
      461       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      462       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      463       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      464       define output parameter p-exist   as logical  no-undo .
      465       define buffer buf_doc-line-attr for ub.doc-line-attr .
      466       def var v-type           as character no-undo .
      467       def var v-format         as character no-undo .
      468       def var v-fillin_width   as integer   no-undo .
      469       def var v-fillin_height  as integer   no-undo .
      470       def var v-label          as character no-undo .
      471       def var v-user-can-edit  as logical   no-undo .
      472       def var v-output-display as logical   no-undo .
      473       def var v-other          as character no-undo .
      474       run lineattr-code in this-procedure
      475         (input  p-code
      476         ,output v-type
      477         ,output v-format
      478         ,output v-fillin_width
      479         ,output v-fillin_height
      480         ,output v-label
      481         ,output v-user-can-edit
      482         ,output v-output-display
      483         ,output v-other
      484         ) no-error .
      485       if error-status :error then do:
      486         undo, return error return-value .
      487       end.
      488       find first buf_doc-line-attr no-lock
      489         where buf_doc-line-attr.doc-code  = p-doc-code
      490           and buf_doc-line-attr.gds-code = p-gds-code
      491           and buf_doc-line-attr.attr-code = p-code
      492         no-error .
      493       if  available buf_doc-line-attr then do:
      494         p-exist = yes.
      495       end.
      496     end.
      497   end procedure.
      498   procedure lineattr-delete :
      499     do
      500     on error undo, return error return-value
      501     :
      502       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      503       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      504       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      505       define output parameter p-deleted  as logical no-undo.
      506       define buffer buf_doc-line-attr for ub.doc-line-attr .
      507       def var v-type           as character no-undo .
      508       def var v-format         as character no-undo .
      509       def var v-fillin_width   as integer   no-undo .
      510       def var v-fillin_height  as integer   no-undo .
      511       def var v-label          as character no-undo .
      512       def var v-user-can-edit  as logical   no-undo .
      513       def var v-output-display as logical   no-undo .
      514       def var v-other          as character no-undo .
      515       run lineattr-code in this-procedure
      516         (input  p-code
      517         ,output v-type
      518         ,output v-format
      519         ,output v-fillin_width
      520         ,output v-fillin_height
      521         ,output v-label
      522         ,output v-user-can-edit
      523         ,output v-output-display
      524         ,output v-other
      525         ) no-error .
      526       if error-status :error then do:
      527         undo, return error return-value .
      528       end.
      529       find first buf_doc-line-attr exclusive-lock
      530         where buf_doc-line-attr.doc-code  = p-doc-code
      531           and buf_doc-line-attr.gds-code  = p-gds-code
      532           and buf_doc-line-attr.attr-code = p-code
      533         no-error NO-WAIT.
      534       if not available buf_doc-line-attr then do:
      535         p-deleted = no.
      536       end.
      537       else do:
      538         delete buf_doc-line-attr.
      539         p-deleted = yes.
      540       end.
      541     end.
      542   end procedure.
      543   procedure lineattr-code :
      544     do on error undo, return error return-value
      545     :
      546       define input  parameter p-code           as character no-undo .
      547       define output parameter p-type           as character no-undo .
      548       define output parameter p-format         as character no-undo .
      549       define output parameter p-fillin_width   as integer   no-undo .
      550       define output parameter p-fillin_height  as integer   no-undo .
      551       define output parameter p-label          as character no-undo .
      552       define output parameter p-user-can-edit  as logical   no-undo .
      553       define output parameter p-output-display as logical   no-undo .
      554       define output parameter p-other          as character no-undo .
      555       case p-code :
      556               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      557               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      558               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      559               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      560               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      561               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      562               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      563               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      564               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      565               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      566               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      567         otherwise do:
      568           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      569         end.
      570       end.
      571     end.
      572   end procedure.
      573   procedure lineattr-value-flora-gds :
      574     do
      575     on error undo, return error return-value
      576     :
      577       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      578       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      579       define input  parameter p-prt-code    as integer   no-undo .
      580       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      581       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      582       define output parameter p-value       as    decimal   no-undo .
      583       define buffer buf_doc-line-attr for ub.doc-line-attr .
      584       find first buf_doc-line-attr no-lock
      585         where buf_doc-line-attr.doc-code  = p-doc-code
      586           and buf_doc-line-attr.gds-code  = p-gds-code
      587           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      588         no-error .
      589       if avail buf_doc-line-attr then do:
      590         assign
      591           p-value = decimal( buf_doc-line-attr.attr-value)
      592         .
      593       end.
      594       else do:
      595         assign
      596           p-value = 0
      597         .
      598       end.
      599     end.
      600   end procedure.
      601   procedure lineattr-write-flora-gds :
      602     do
      603     on error undo, return error return-value
      604     :
      605       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      606       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      607       define input parameter p-prt-code    as integer   no-undo .
      608       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      609       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      610       define input parameter p-value    as decimal   no-undo .
      611       define buffer buf_doc-line-attr for ub.doc-line-attr .
      612       find first buf_doc-line-attr exclusive-lock
      613         where buf_doc-line-attr.doc-code  = p-doc-code
      614           and buf_doc-line-attr.gds-code  = p-gds-code
      615           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      616         no-error .
      617       if not available buf_doc-line-attr then do:
      618         create buf_doc-line-attr .
      619         assign
      620           buf_doc-line-attr.doc-code  = p-doc-code
      621           buf_doc-line-attr.gds-code  = p-gds-code
      622           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      623         .
      624       end.
      625       assign
      626         buf_doc-line-attr.attr-value = string( p-value )
      627       .
      628     end.
      629   end procedure.
