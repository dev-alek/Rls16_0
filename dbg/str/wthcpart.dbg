     1096        FGCOLOR 4  NO-UNDO.
     1097   DEFINE VARIABLE fl-prodType AS CHARACTER FORMAT "X(256)":U
     1098        LABEL "Производитель"
     1099        VIEW-AS FILL-IN
     1100        SIZE 4.5 BY 1
     1101        FGCOLOR 4  NO-UNDO.
     1102   DEFINE VARIABLE fl-wth-code AS INTEGER FORMAT "999999999":U INITIAL 0
     1103        LABEL "Код МЦ"
     1104        VIEW-AS FILL-IN
     1105        SIZE 10.5 BY 1
     1106        FGCOLOR 4  NO-UNDO.
     1107   DEFINE VARIABLE fl-wth-name AS CHARACTER FORMAT "X(256)":U
     1108        LABEL "Название МЦ"
     1109        VIEW-AS FILL-IN
     1110        SIZE 15.5 BY 1
     1111        FGCOLOR 4  NO-UNDO.
     1112   DEFINE VARIABLE fl-wth-par AS INTEGER FORMAT "999":U INITIAL 0
     1113        LABEL "Код номинала"
     1114        VIEW-AS FILL-IN
     1115        SIZE 4.5 BY 1
     1116        FGCOLOR 4  NO-UNDO.
     1117   DEFINE VARIABLE Fn-rs-obj AS CHARACTER FORMAT "X(256)":U
     1118         VIEW-AS TEXT
     1119        SIZE 7.5 BY .67
     1120        FGCOLOR 4  NO-UNDO.
     1121   DEFINE RECTANGLE RECT-1
     1122        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1123        SIZE 97 BY 2.5.
     1124   DEFINE QUERY br-parts FOR
     1125         X_c-wth-parts SCROLLING.
     1126   DEFINE BROWSE br-parts
     1127     QUERY br-parts NO-LOCK DISPLAY
     1128         mark-string( recid(X_c-wth-parts), rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1129         substitute('&1-&2',X_c-wth-parts.ser-code,X_c-wth-parts.db-num) @ v-SerDb COLUMN-LABEL "Код серии"
     1130         if X_c-wth-parts.stts = 0 then X_c-wth-parts.fact-rangeFrom else ? COLUMN-LABEL "Диапазон с" FORMAT "->>>>>>>>9":U
     1131         if X_c-wth-parts.stts = 0 then X_c-wth-parts.fact-rangeTo else ? COLUMN-LABEL "по" FORMAT "->>>>>>>>9":U
     1132         if X_c-wth-parts.stts = 0 then X_c-wth-parts.fact-qnty else 0 FORMAT "->>>,>>>,>>9":U  COLUMN-LABEL "Количество"
     1133         get-cli-name(X_c-wth-parts.obj-type,X_c-wth-parts.obj-code )   COLUMN-LABEL "Объект"     FORMAT "X(14)":U
     1134         get-w-p-name(X_c-wth-parts.w-p-code, X_c-wth-parts.obj-type,X_c-wth-parts.obj-code) @ v-w-p-name COLUMN-LABEL "МХ"
     1135         get-wthparts-out-code(X_c-wth-parts.out-code) @ v-out-name COLUMN-LABEL "Документ\зона"
     1136         X_c-wth-parts.in-code COLUMN-LABEL "Накл. порожд." FORMAT "X(14)":U
     1137         X_c-wth-parts.price-rubl FORMAT "->>,>>>,>>9.99":U
     1138         X_c-wth-parts.price-base FORMAT "->>,>>>,>>9.99":U
     1139         X_c-wth-parts.VAT-pc FORMAT ">9.9<%":U
     1140         X_c-wth-parts.contract-code COLUMN-LABEL "Договор" FORMAT "9999999":U   WIDTH 11.5
     1141         X_c-wth-parts.doc-rangeFrom FORMAT "->,>>>,>>>,>>9":U
     1142         X_c-wth-parts.doc-rangeTo FORMAT "->,>>>,>>>,>>9":U
     1143         X_c-wth-parts.qnty-doc FORMAT "->>>,>>>,>>9":U
     1144         X_c-wth-parts.doc-code COLUMN-LABEL "Документ"
     1145         get-cli-name(X_c-wth-parts.in-obj-type,X_c-wth-parts.out-obj-code )  COLUMN-LABEL "Объект нач. приобрет."   FORMAT "X(14)":U
     1146         get-cli-name(X_c-wth-parts.supp-type,X_c-wth-parts.supp-code )    COLUMN-LABEL "Поставщик"    FORMAT "X(14)":U
     1147         get-cli-name(X_c-wth-parts.cli-type,X_c-wth-parts.cli-code )   COLUMN-LABEL "Покупатель"     FORMAT "X(14)":U
     1148         get-cli-name(X_c-wth-parts.sale-obj-type,X_c-wth-parts.sale-obj-code )  COLUMN-LABEL "Объект реализ."   FORMAT "X(14)":U
     1149         get-cli-name(X_c-wth-parts.out-obj-type,X_c-wth-parts.out-obj-code )   COLUMN-LABEL "Объект погаш."   FORMAT "X(14)":U
     1150         X_c-wth-parts.fact-date FORMAT "99/99/99":U
     1151         X_c-wth-parts.shift-date FORMAT "99/99/99":U
     1152         X_c-wth-parts.shift-num FORMAT ">9":U
     1153         X_c-wth-parts.host-code COLUMN-LABEL "Код фирмы" FORMAT ">>>>>>>>9":U
     1154         ENTRY(LOOKUP(X_c-wth-parts.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) FORMAT "X(18)":U   column-label 'Расш. тип'
     1155         X_c-wth-parts.fact-num FORMAT "->,>>>,>>9":U
     1156         X_c-wth-parts.fact-order FORMAT "9999999999999999999999.9999999999":U
     1157         X_c-wth-parts.stts FORMAT ">9":U
     1158         X_c-wth-parts.TYPE
     1159       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 15.25 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
     1160   DEFINE FRAME Dialog-Frame
     1161        b-exit AT ROW 1 COL 1 WIDGET-ID 18
     1162        b-quit AT ROW 1 COL 11 WIDGET-ID 20
     1163        B-mark AT ROW 1 COL 21 WIDGET-ID 12
     1164        B-sel AT ROW 1 COL 24 WIDGET-ID 16
     1165        b-lkp AT ROW 1 COL 34 WIDGET-ID 22
     1166        B-sch AT ROW 1 COL 80.5 WIDGET-ID 60
     1167        B-print AT ROW 1 COL 85 WIDGET-ID 14
     1168        B-Help AT ROW 1 COL 91.5 WIDGET-ID 8
     1169        br-parts AT ROW 2.75 COL 1 WIDGET-ID 200
     1170        fl-wth-code AT ROW 18.25 COL 3.5 WIDGET-ID 44
     1171        fl-wth-name AT ROW 18.25 COL 34 COLON-ALIGNED WIDGET-ID 50
     1172        fl-wth-par AT ROW 18.25 COL 67.5 COLON-ALIGNED WIDGET-ID 48
     1173        fl-par-val AT ROW 18.25 COL 91 COLON-ALIGNED WIDGET-ID 52
     1174        fl-gds AT ROW 19.25 COL 9.5 COLON-ALIGNED WIDGET-ID 58
     1175        fl-artic AT ROW 19.25 COL 34 COLON-ALIGNED WIDGET-ID 46
     1176        fl-prodType AT ROW 19.25 COL 61 COLON-ALIGNED WIDGET-ID 54
     1177        fl-ProdCode AT ROW 19.25 COL 67.5 COLON-ALIGNED NO-LABEL WIDGET-ID 56
     1178        fl-obj-name AT ROW 19.25 COL 73 COLON-ALIGNED NO-LABEL WIDGET-ID 290
     1179        Fn-rs-obj AT ROW 3 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 312
     1180        RECT-1 AT ROW 18 COL 1 WIDGET-ID 300
     1181        SPACE(0.00) SKIP(0.07)
     1182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1184            TITLE "Партии серийных МЦ" WIDGET-ID 100.
     1185   ASSIGN
     1186          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1187          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1188   ASSIGN
     1189          fl-prodType:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1191   DO:
     1192     APPLY "END-ERROR":U TO SELF.
     1193   END.
     1194   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1195   DO:
     1196   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   if lookup(self :type
     1198            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1199            ) = 0
     1200   then do:
     1201     message
     1202       "$Workfile$"
     1203       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1204       "Интерфейсный элемент" self :name  skip
     1205       "Тип" self :type  skip
     1206       "Процедура" this-procedure :file-name skip
     1207       view-as alert-box .
     1208   end.
     1209   else do:
     1210     apply "entry":u to self  .
     1211     if focus :handle <> self :handle  then do:
     1212       return no-apply .
     1213     end.
     1214   end.
     1215   END.
     1216   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1217   DO:
     1218   define variable glog as logical no-undo .
     1219   define variable rep-rec as recid no-undo .
     1220   rep-rec = recid(X_c-wth-parts).
     1221           run str/wthcprtl.w (
     1222                            input parparentproc
     1223                           ,INPUT 'ПРОСМОТР':U
     1224                           ,input rep-rec).
     1225   if rep-rec <> ? then do:
     1226     v-prt-rec = rep-rec.
     1227     RUn OpenBr in this-procedure .
     1228     apply "entry" to BR-parts in frame Dialog-Frame.
     1229   end.
     1230   else do:
     1231     apply "entry" to BR-parts in frame Dialog-Frame.
     1232     return no-apply.
     1233   end.
     1234   END.
     1235   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1236   DO:
     1237    define variable glog as logical no-undo .
     1238      if available X_c-wth-parts then do:
     1239   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   define variable v-str-recid13 as character no-undo .
     1241   define variable v-num-entry13 as integer   no-undo .
     1242   assign
     1243     v-str-recid13 = trim( string( recid( X_c-wth-parts ) , "->>>>>>>>>>>9":U ) )
     1244     v-num-entry13 = lookup( v-str-recid13 , rid-list )
     1245   .
     1246   if v-num-entry13 > 0 then do:
     1247     assign
     1248       entry( v-num-entry13, rid-list ) = "":U
     1249       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1250     .
     1251   end.
     1252   else do:
     1253     assign
     1254       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1255     .
     1256   end.
     1257        br-parts:refresh().
     1258        if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1259                glog = br-parts:select-next-row ().
     1260                apply "iteration-changed" to br-parts in frame Dialog-Frame.
     1261            end.
     1262      end.
     1263      apply "entry" to br-parts in frame Dialog-Frame.
     1264   END.
     1265   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1266   DO:
     1267    define variable doc-rec as recid no-undo .
     1268        doc-rec = recid( X_c-wth-parts ).
     1269        DO WHILE available X_c-wth-parts :
     1270              GET prev br-parts.
     1271        END.
     1272      run PrintProc in this-procedure no-error.
     1273      reposition br-parts to recid doc-rec no-error.
     1274      apply "entry" to br-parts in frame Dialog-Frame.
     1275   END.
     1276   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1277   DO:
     1278   END.
     1279   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1280   DO:
     1281     assign
     1282     tbl = 'c-wth-parts'
     1283     join-tbl = 'X_c-wth-parts'
     1284     dim = '0':U
     1285     fld = '':U
     1286     lab = '':U
     1287     spr = '':U
     1288     .
     1289     run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     1290     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1291     run fltfield-add in this-procedure('ser-code', '', '',
     1292     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1293     run fltfield-add in this-procedure('gds-code', '', '',
     1294     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1295     run fltfield-add in this-procedure('fact-rangeFrom', 'Диапазон с', '',
     1296     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1297     run fltfield-add in this-procedure('fact-rangeTo', 'Диапазон по', '',
     1298     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1299     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'obj',
     1300     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1301     run fltfield-add in this-procedure('w-p-code', '', '',
     1302     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1303     run fltfield-add in this-procedure('in-code', 'Номер порожд. док-та', '',
     1304     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1305     run fltfield-add in this-procedure('contract-code', 'Номер договора', '',
     1306     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1307     run fltfield-add in this-procedure('cli-type*cli-code', 'Покупатель', 'cli',
     1308     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1309     run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'supp',
     1310     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1311     run fltfield-add in this-procedure('sale-obj-type*sale-obj-code', 'Объект реализации', 'obj',
     1312     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1313     run fltfield-add in this-procedure('out-obj-type*out-obj-code', 'Объект погашения', 'obj',
     1314     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1315       DO on stop undo, leave:
     1316           run gbl/filter.w ( input parparentproc
     1317                            , input filter-point
     1318                            , input tbl
     1319                            , input join-tbl
     1320                            , input  fld
     1321                            , input lab
     1322                            , input spr
     1323                            , input dim).
     1324           RUN OpenBr in this-procedure .
     1325       END .
     1326   END.
     1327   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1328   DO:
     1329       if  available X_c-wth-parts AND (rid-list = ""  or
     1330           b-mark:sensitive = no)
     1331       then
     1332        rid-list = string( recid( X_c-wth-parts ) ) .
     1333   END.
     1334   ON VALUE-CHANGED OF br-parts IN FRAME Dialog-Frame
     1335   DO:
     1336     IF AVAILABLE X_c-wth-parts THEN DO WITH FRAME Dialog-Frame:
     1337         DISP X_c-wth-parts.wth-code  @ fl-wth-code
     1338              X_c-wth-parts.par-code @ fl-wth-par.
     1339         FIND FIRST b-wealth WHERE b-wealth.wth-code = X_c-wth-parts.wth-code NO-LOCK NO-ERROR.
     1340         IF AVAILABLE b-wealth THEN DISP b-wealth.wth-name @ fl-wth-name.
     1341         ELSE fl-wth-name:SCREEN-VALUE = '?':U.
     1342         FIND FIRST b-wth-par WHERE b-wth-par.wth-code =  X_c-wth-parts.wth-code AND b-wth-par.par-code = X_c-wth-parts.par-code NO-LOCK NO-ERROR.
     1343         IF AVAILABLE b-wth-par THEN DISP b-wth-par.par-val @ fl-par-val.
     1344         ELSE fl-par-val:SCREEN-VALUE = '?':U.
     1345         FIND FIRST b-goods WHERE b-goods.gds-code = X_c-wth-parts.gds-code NO-LOCK NO-ERROR.
     1346         IF AVAILABLE b-goods THEN DO: DISP b-goods.artic     @ fl-artic
     1347                                        b-goods.prod-type @ fl-prodType
     1348                                        b-goods.prod-code @ fl-prodCode
     1349                                        b-goods.gds-name  @ fl-gds.
     1350                fl-obj-name:SCREEN-VALUE = get-cli-name(b-goods.prod-type,b-goods.prod-code).
     1351         END.
     1352         ELSE   ASSIGN fl-artic:SCREEN-VALUE = '?':U
     1353                fl-prodType:SCREEN-VALUE = '?':U
     1354                fl-prodCode:SCREEN-VALUE = '?':U
     1355                fl-gds:SCREEN-VALUE = '?':U.
     1356         ENABLE b-lkp  .
     1357     END.
     1358     ELSE DO:
     1359         DISABLE b-lkp WITH FRAME Dialog-Frame.
     1360     END.
     1361   END.
     1362   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1363   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1364   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   on help of frame Dialog-Frame
     1366   do:
     1367     run gbl/app_help.p
     1368       (input this-procedure :file-name
     1369       ,input ''
     1370       ,input ?
     1371       ) no-error.
     1372     if error-status :error then do:
     1373       message
     1374         "Ошибка при вызове помощи"
     1375         error-status :get-message(1)
     1376         view-as alert-box .
     1377     end.
     1378   end.
     1379   run minbtn-set in this-procedure .
     1380   on choose of b-help in frame Dialog-Frame
     1381   do:
     1382     apply "help":u to frame Dialog-Frame .
     1383   end.
     1384   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   procedure minbtn-set :
     1386       do
     1387           on error undo, return error return-value
     1388           :
     1389           define variable ii              as integer       no-undo .
     1390           define variable fh              as widget-handle no-undo .
     1391           define variable hh              as widget-handle no-undo .
     1392           define variable v-h             as handle        extent 4 no-undo .
     1393           define variable v-name-button   as character     no-undo .
     1394           define variable v-help-old-x    as decimal       no-undo .
     1395           define variable v-help-old-y    as decimal       no-undo .
     1396           define variable v-help-old-size as decimal       no-undo .
     1397           define variable v-frame-width   as decimal       no-undo .
     1398           define variable jj              as integer       no-undo .
     1399           do
     1400               on error undo, return error
     1401               :
     1402               assign
     1403                   v-frame-width = frame Dialog-Frame:width - 0.3
     1404                   fh            = frame Dialog-Frame:first-child
     1405                   hh            = fh:first-child
     1406                   ii            = 1
     1407                   .
     1408               do while valid-handle(hh):
     1409                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1410                   do:
     1411                       case lc(hh:name) :
     1412                           when "b-help" then
     1413                               do:
     1414                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1415                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1416                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1417                                   hh:TOOLTIP = "Помощь" .
     1418                                   v-help-old-x = hh:column .
     1419                                   v-help-old-y = hh:row    .
     1420                                   v-help-old-size = hh:width .
     1421                                   hh:width-chars = 2.5 .
     1422                               end.
     1423                           when "b-print" then
     1424                               do:
     1425                                   hh:load-image("cmp/b-print.bmp":u) .
     1426                                   hh:TOOLTIP = "Печать" .
     1427                                   v-h[ii] = hh:handle .
     1428                                   ii = ii + 1 .
     1429                                   hh:width-chars = 3 .
     1430                               end.
     1431                           when "b-history" or
     1432                           when "b-hist" then
     1433                               do:
     1434                                   hh:load-image("cmp/b-hist.bmp":u) .
     1435                                   hh:TOOLTIP = "История" .
     1436                                   v-h[ii] = hh:handle .
     1437                                   ii = ii + 1 .
     1438                                   hh:width-chars = 3 .
     1439                               end.
     1440                           when "b-sch" then
     1441                               do:
     1442                                   hh:load-image("cmp/b-sch.bmp":u) .
     1443                                   hh:TOOLTIP = "Установка Фильтра" .
     1444                                   v-h[ii] = hh:handle .
     1445                                   ii = ii + 1 .
     1446                                   hh:width-chars = 3 .
     1447                               end.
     1448                           when "b-hist-user" then
     1449                               do:
     1450                                   hh:load-image("cmp/b-hist.bmp":u) .
     1451                                   hh:TOOLTIP = "История пользователя" .
     1452                                   ii = ii + 1 .
     1453                               end.
     1454                       end case.
     1455                   end.
     1456                   hh = hh:next-sibling.
     1457               end.
     1458               b-help:column = v-frame-width - b-help:width-chars.
     1459               jj = 0.
     1460               repeat ii = 4 to 1 by -1 :
     1461                   if valid-handle (v-h[ii] ) then
     1462                   do:
     1463                       jj  = jj + 1 .
     1464                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1465                       v-h[ii]:row    = v-help-old-y .
     1466                   end.
     1467               end.
     1468           end.
     1469       end.
     1470   end procedure.
     1471   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1472   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1473   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1474   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1475   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1476   define variable v-diasize-current-frame-height as decimal   no-undo .
     1477   define variable v-diasize-change-size          as logical   no-undo .
     1478   define variable v-diasize-resize-button        as handle    no-undo .
     1479   define variable v-diasize-wndmax               as logical   no-undo .
     1480   define variable v-diasize-wndstore             as logical   no-undo .
     1481   define variable v-diasize-proc-name            as character no-undo .
     1482   define variable v-diasize-browse-handle        as handle    no-undo .
     1483   define variable v-diasize-browse-number        as integer   no-undo .
     1484   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1485   define temp-table temp-diasize-handle no-undo
     1486     field handle-value  as handle
     1487     field save-position as decimal
     1488     index xpk is primary unique handle-value
     1489     .
     1490   define temp-table temp-browse-handle no-undo
     1491     field browse-type   as character
     1492     field browse-number as integer
     1493     field browse-handle as handle
     1494     field original-size as decimal
     1495     index xpk is primary unique browse-type browse-number
     1496     index xie browse-type browse-handle
     1497   .
     1498   procedure diasize_change-height :
     1499     define input  parameter p-change-value  as decimal   no-undo .
     1500     define input  parameter p-move-resize   as logical   no-undo .
     1501     define variable v-field-group-handle    as handle    no-undo .
     1502     define variable v-object-handle         as handle    no-undo .
     1503     define variable v-frame-height          as decimal   no-undo .
     1504     define variable v-frame-virtual-height  as decimal   no-undo .
     1505     define variable v-browse-height         as decimal   no-undo .
     1506     define variable v-window-height         as decimal   no-undo .
     1507     define variable v-window-virtual-height as decimal   no-undo .
     1508     define variable v-change-sign           as integer   no-undo .
     1509     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1510     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1511     if p-change-value > 0
     1512     then do:
     1513       if frame Dialog-Frame :height + p-change-value
     1514           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1515       then do:
     1516         assign
     1517           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1518                           - (frame Dialog-Frame :height-chars)
     1519         .
     1520         if p-change-value <= 0
     1521         then do:
     1522           run diasize_position-resize-button in this-procedure .
     1523           return .
     1524         end.
     1525       end.
     1526     end.
     1527     if p-change-value < 0
     1528     then do:
     1529       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1530       then do:
     1531         assign
     1532           p-change-value = v-diasize-orig-frame-height
     1533                          - (frame Dialog-Frame :height-chars)
     1534         .
     1535         if p-change-value >= 0
     1536         then do:
     1537           run diasize_position-resize-button in this-procedure .
     1538           return .
     1539         end.
     1540       end.
     1541     end.
     1542     if p-change-value >= 0
     1543     then do:
     1544       assign
     1545         v-change-sign = 1
     1546       .
     1547     end.
     1548     else do:
     1549       assign
     1550         v-change-sign = -1
     1551       .
     1552     end.
     1553     assign
     1554       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1555     .
     1556     if p-change-value = 0
     1557     then do:
     1558       run diasize_position-resize-button in this-procedure .
     1559       return .
     1560     end.
     1561     move_block:
     1562     do
     1563     on error undo move_block, retry move_block
     1564     :
     1565       if retry
     1566       then do:
     1567         do
     1568         on error undo move_block, leave move_block
     1569         :
     1570           if p-change-value > 0
     1571           then do:
     1572             for each buf_temp-diasize-handle
     1573             on error undo, next
     1574             :
     1575               assign
     1576                 v-object-handle = buf_temp-diasize-handle.handle-value
     1577               .
     1578               if v-object-handle <> v-diasize-resize-button
     1579               then do:
     1580                 assign
     1581                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1582                 .
     1583               end.
     1584             end.
     1585             assign
     1586               v-diasize-browse-handle :height = v-browse-height
     1587             .
     1588             for each buf_temp-browse-handle
     1589               where buf_temp-browse-handle.browse-type = 'height':u
     1590             on error undo, next
     1591             :
     1592               assign
     1593                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1594               .
     1595             end.
     1596             assign
     1597               frame Dialog-Frame :height = v-frame-height
     1598             .
     1599             if frame Dialog-Frame :scrollable = true
     1600             then do:
     1601               assign
     1602                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1603               .
     1604             end.
     1605             run diasize_position-resize-button in this-procedure .
     1606           end.
     1607           else do:
     1608             if frame Dialog-Frame :scrollable = true
     1609             then do:
     1610               assign
     1611                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1612               .
     1613             end.
     1614             assign
     1615               frame Dialog-Frame :height = v-frame-height
     1616             .
     1617             assign
     1618               v-diasize-browse-handle :height = v-browse-height
     1619             .
     1620             for each buf_temp-browse-handle
     1621               where buf_temp-browse-handle.browse-type = 'height':u
     1622             on error undo, next
     1623             :
     1624               assign
     1625                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1626               .
     1627             end.
     1628             for each buf_temp-diasize-handle
     1629             on error undo, next
     1630             :
     1631               assign
     1632                 v-object-handle = buf_temp-diasize-handle.handle-value
     1633               .
     1634               if v-object-handle <> v-diasize-resize-button
     1635               then do:
     1636                 assign
     1637                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1638                 .
     1639               end.
     1640             end.
     1641             run diasize_position-resize-button in this-procedure .
     1642           end.
     1643           assign
     1644             v-diasize-change-size = false
     1645           .
     1646           leave move_block .
     1647         end.
     1648       end.
     1649       assign
     1650         v-diasize-need-full-display = true
     1651       .
     1652       if v-diasize-change-size = false
     1653       then do:
     1654         assign
     1655           v-diasize-change-size = true
     1656         .
     1657       end.
     1658       else do:
     1659         return .
     1660       end.
     1661       assign
     1662         v-frame-height = frame Dialog-Frame :height
     1663         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1664         v-browse-height = v-diasize-browse-handle :height
     1665       .
     1666       for each buf_temp-browse-handle
     1667         where buf_temp-browse-handle.browse-type = 'height':u
     1668       :
     1669         assign
     1670           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1671         .
     1672       end.
     1673       for each buf_temp-diasize-handle
     1674       :
     1675         delete buf_temp-diasize-handle .
     1676       end.
     1677       assign
     1678         v-field-group-handle = frame Dialog-Frame :first-child
     1679       .
     1680       do while valid-handle(v-field-group-handle)
     1681       :
     1682         assign
     1683           v-object-handle = v-field-group-handle :first-child
     1684         .
     1685         do while valid-handle(v-object-handle)
     1686         :
     1687           if  v-object-handle <> v-diasize-browse-handle :handle
     1688           and can-query(v-object-handle, "row")
     1689           and can-query(v-object-handle, "height")
     1690           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1691           then do:
     1692             find first buf_temp-browse-handle
     1693               where buf_temp-browse-handle.browse-type   = 'height':u
     1694                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1695               no-error .
     1696             if available buf_temp-browse-handle
     1697             then do:
     1698             end.
     1699             else do:
     1700               create buf_temp-diasize-handle .
     1701               assign
     1702                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1703                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1704               .
     1705             end.
     1706           end.
     1707           assign
     1708             v-object-handle = v-object-handle :next-sibling
     1709           .
     1710         end.
     1711         assign
     1712           v-field-group-handle = v-field-group-handle :next-sibling
     1713         .
     1714       end.
     1715       do with frame Dialog-Frame
     1716       :
     1717         hide v-diasize-resize-button .
     1718         assign
     1719           v-diasize-resize-button :row    = 1
     1720           v-diasize-resize-button :column = 1
     1721         .
     1722       end.
     1723       if p-change-value > 0
     1724       then do:
     1725         if frame Dialog-Frame :scrollable = true
     1726         then do:
     1727           assign
     1728             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1729             no-error .
     1730           if error-status :error
     1731           or error-status :get-message(1) <> ""
     1732           then do:
     1733             undo move_block, retry move_block .
     1734           end.
     1735         end.
     1736         assign
     1737           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1738           no-error .
     1739         if error-status :error
     1740         or error-status :get-message(1) <> ""
     1741         then do:
     1742           undo move_block, retry move_block .
     1743         end.
     1744         assign
     1745           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1746           no-error .
     1747         if error-status :error
     1748         or error-status :get-message(1) <> ""
     1749         then do:
     1750           undo move_block, retry move_block .
     1751         end.
     1752         for each buf_temp-browse-handle
     1753           where buf_temp-browse-handle.browse-type = 'height':u
     1754         on error undo move_block, retry move_block
     1755         :
     1756           assign
     1757             buf_temp-browse-handle.browse-handle :height
     1758               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1759             no-error .
     1760           if error-status :error
     1761           or error-status :get-message(1) <> ""
     1762           then do:
     1763             undo move_block, retry move_block .
     1764           end.
     1765         end.
     1766         for each buf_temp-diasize-handle
     1767         on error undo move_block, retry move_block
     1768         :
     1769           assign
     1770             v-object-handle = buf_temp-diasize-handle.handle-value
     1771           .
     1772           if v-object-handle <> v-diasize-resize-button
     1773           then do:
     1774             assign
     1775               v-object-handle :row = v-object-handle :row + p-change-value
     1776               no-error .
     1777             if error-status :error
     1778             or error-status :get-message(1) <> ""
     1779             then do:
     1780               undo move_block, retry move_block .
     1781             end.
     1782           end.
     1783         end.
     1784       end.
     1785       else do:
     1786         for each buf_temp-diasize-handle
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             v-object-handle = buf_temp-diasize-handle.handle-value
     1791           .
     1792           if v-object-handle <> v-diasize-resize-button
     1793           then do:
     1794             assign
     1795               v-object-handle :row = v-object-handle :row + p-change-value
     1796               no-error .
     1797             if error-status :error
     1798             or error-status :get-message(1) <> ""
     1799             then do:
     1800               undo move_block, retry move_block .
     1801             end.
     1802           end.
     1803         end.
     1804         assign
     1805           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1806           no-error .
     1807         if error-status :error
     1808         or error-status :get-message(1) <> ""
     1809         then do:
     1810           undo move_block, retry move_block .
     1811         end.
     1812         for each buf_temp-browse-handle
     1813           where buf_temp-browse-handle.browse-type = 'height':u
     1814         on error undo move_block, retry move_block
     1815         :
     1816           assign
     1817             buf_temp-browse-handle.browse-handle :height
     1818               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1819             no-error .
     1820           if error-status :error
     1821           or error-status :get-message(1) <> ""
     1822           then do:
     1823             undo move_block, retry move_block .
     1824           end.
     1825         end.
     1826         assign
     1827           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1828           no-error .
     1829         if error-status :error
     1830         or error-status :get-message(1) <> ""
     1831         then do:
     1832           undo move_block, retry move_block .
     1833         end.
     1834         if frame Dialog-Frame :scrollable = true
     1835         then do:
     1836           assign
     1837             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1838             no-error .
     1839           if error-status :error
     1840           or error-status :get-message(1) <> ""
     1841           then do:
     1842             undo move_block, retry move_block .
     1843           end.
     1844         end.
     1845       end.
     1846       if p-move-resize = true
     1847       then do:
     1848         run diasize_position-resize-button in this-procedure .
     1849       end.
     1850       if v-diasize-wndstore = true
     1851       then do:
     1852         if connected("ub") = true
     1853         then do:
     1854           define variable v-cntxt-db-num        as integer   no-undo .
     1855           define variable v-cntxt-userid        as character no-undo .
     1856           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1857                                             , OUTPUT v-cntxt-userid
     1858                                             ) .
     1859           run gbl/wndsizew.p
     1860             (input  v-cntxt-db-num
     1861             ,input  v-cntxt-userid
     1862             ,input  v-diasize-proc-name
     1863             ,input  'height':u
     1864             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1865             ) .
     1866         end.
     1867       end.
     1868     end.
     1869     assign
     1870       v-diasize-change-size = false
     1871     .
     1872   end procedure.
     1873   procedure diasize_set-height :
     1874     define input  parameter p-new-height  as decimal   no-undo .
     1875     define input  parameter p-move-resize as logical   no-undo .
     1876     do
     1877     on error undo, return error return-value
     1878     :
     1879       run diasize_change-height in this-procedure
     1880         (input  (p-new-height - frame Dialog-Frame :height)
     1881         ,input  p-move-resize
     1882         ) .
     1883     end.
     1884   end procedure.
     1885   procedure diasize_change-width :
     1886     define input  parameter p-change-value as decimal   no-undo .
     1887     define input  parameter p-move-resize  as logical   no-undo .
     1888     define variable v-field-group-handle   as handle    no-undo .
     1889     define variable v-object-handle        as handle    no-undo .
     1890     define variable v-frame-width          as decimal   no-undo .
     1891     define variable v-frame-virtual-width  as decimal   no-undo .
     1892     define variable v-browse-width         as decimal   no-undo .
     1893     define variable v-window-width         as decimal   no-undo .
     1894     define variable v-window-virtual-width as decimal   no-undo .
     1895     define variable v-change-sign          as integer   no-undo .
     1896     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1897     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1898     if p-change-value > 0
     1899     then do:
     1900       if frame Dialog-Frame :width + p-change-value >
     1901           session :width-chars
     1902       then do:
     1903         assign
     1904           p-change-value = session :width-chars - frame Dialog-Frame :width
     1905         .
     1906         if p-change-value <= 0
     1907         then do:
     1908           run diasize_position-resize-button in this-procedure .
     1909           return .
     1910         end.
     1911       end.
     1912     end.
     1913     if p-change-value < 0
     1914     then do:
     1915       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1916       then do:
     1917         assign
     1918           p-change-value = v-diasize-orig-frame-width
     1919                          - frame Dialog-Frame :width
     1920         .
     1921         if p-change-value >= 0
     1922         then do:
     1923           run diasize_position-resize-button in this-procedure .
     1924           return .
     1925         end.
     1926       end.
     1927     end.
     1928     if p-change-value >= 0
     1929     then do:
     1930       assign
     1931         v-change-sign = 1
     1932       .
     1933     end.
     1934     else do:
     1935       assign
     1936         v-change-sign = -1
     1937       .
     1938     end.
     1939     assign
     1940       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1941     .
     1942     if p-change-value = 0
     1943     then do:
     1944       run diasize_position-resize-button in this-procedure .
     1945       return .
     1946     end.
     1947     move_block:
     1948     do
     1949     on error undo move_block, leave move_block
     1950     :
     1951       if retry
     1952       then do:
     1953         do
     1954         on error undo move_block, leave move_block
     1955         :
     1956           if p-change-value > 0
     1957           then do:
     1958             for each buf_temp-diasize-handle
     1959             on error undo, next
     1960             :
     1961               assign
     1962                 v-object-handle = buf_temp-diasize-handle.handle-value
     1963               .
     1964               if v-object-handle <> v-diasize-resize-button
     1965               then do:
     1966                 assign
     1967                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1968                 .
     1969               end.
     1970             end.
     1971             assign
     1972               v-diasize-browse-handle :width = v-browse-width
     1973             .
     1974             for each buf_temp-browse-handle
     1975               where buf_temp-browse-handle.browse-type = 'width':u
     1976             on error undo, next
     1977             :
     1978               assign
     1979                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1980               .
     1981             end.
     1982             assign
     1983               frame Dialog-Frame :width = v-frame-width
     1984             .
     1985             if frame Dialog-Frame :scrollable = true
     1986             then do:
     1987               assign
     1988                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1989               .
     1990             end.
     1991             run diasize_position-resize-button in this-procedure .
     1992           end.
     1993           else do:
     1994             if frame Dialog-Frame :scrollable = true
     1995             then do:
     1996               assign
     1997                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1998               .
     1999             end.
     2000             assign
     2001               frame Dialog-Frame :width = v-frame-width
     2002             .
     2003             for each buf_temp-browse-handle
     2004               where buf_temp-browse-handle.browse-type = 'width':u
     2005             on error undo, next
     2006             :
     2007               assign
     2008                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2009               .
     2010             end.
     2011             assign
     2012               v-diasize-browse-handle :width = v-browse-width
     2013             .
     2014             for each buf_temp-diasize-handle
     2015             on error undo, next
     2016             :
     2017               assign
     2018                 v-object-handle = buf_temp-diasize-handle.handle-value
     2019               .
     2020               if v-object-handle <> v-diasize-resize-button
     2021               then do:
     2022                 assign
     2023                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2024                 .
     2025               end.
     2026             end.
     2027             run diasize_position-resize-button in this-procedure .
     2028           end.
     2029           assign
     2030             v-diasize-change-size = false
     2031           .
     2032           leave move_block .
     2033         end.
     2034       end.
     2035       assign
     2036         v-diasize-need-full-display = true
     2037       .
     2038       if v-diasize-change-size = false
     2039       then do:
     2040         assign
     2041           v-diasize-change-size = true
     2042         .
     2043       end.
     2044       else do:
     2045         return .
     2046       end.
     2047       assign
     2048         v-frame-width = frame Dialog-Frame :width
     2049         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2050         v-browse-width = v-diasize-browse-handle :width
     2051       .
     2052       for each buf_temp-browse-handle
     2053         where buf_temp-browse-handle.browse-type = 'width':u
     2054       :
     2055         assign
     2056           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2057         .
     2058       end.
     2059       for each buf_temp-diasize-handle
     2060       :
     2061         delete buf_temp-diasize-handle .
     2062       end.
     2063       assign
     2064         v-field-group-handle = frame Dialog-Frame :first-child
     2065       .
     2066       do while valid-handle(v-field-group-handle)
     2067       :
     2068         assign
     2069           v-object-handle = v-field-group-handle :first-child
     2070         .
     2071         do while valid-handle(v-object-handle)
     2072         :
     2073           if  v-object-handle <> v-diasize-browse-handle :handle
     2074           and v-object-handle <> v-diasize-resize-button
     2075           and can-query(v-object-handle, "row")
     2076           and can-query(v-object-handle, "height")
     2077           and ( v-object-handle :col + v-object-handle :width
     2078                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2079               )
     2080           then do:
     2081             find first buf_temp-browse-handle
     2082               where buf_temp-browse-handle.browse-type   = 'width':u
     2083                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2084               no-error .
     2085             if available buf_temp-browse-handle
     2086             then do:
     2087             end.
     2088             else do:
     2089               create buf_temp-diasize-handle .
     2090               assign
     2091                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2092                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2093               .
     2094             end.
     2095           end.
     2096           assign
     2097             v-object-handle = v-object-handle :next-sibling
     2098           .
     2099         end.
     2100         assign
     2101           v-field-group-handle = v-field-group-handle :next-sibling
     2102         .
     2103       end.
     2104       do with frame Dialog-Frame
     2105       :
     2106         hide v-diasize-resize-button .
     2107         v-diasize-resize-button :row = 1.
     2108         v-diasize-resize-button :column = 1.
     2109       end.
     2110       if p-change-value > 0
     2111       then do:
     2112         if frame Dialog-Frame :scrollable = true
     2113         then do:
     2114           assign
     2115             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block.
     2121           end.
     2122         end.
     2123         assign
     2124           frame Dialog-Frame :width = v-frame-width + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block.
     2130         end.
     2131         assign
     2132           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2133         no-error .
     2134         if error-status :error
     2135         or error-status :get-message(1) <> ""
     2136         then do:
     2137           undo move_block, retry move_block.
     2138         end.
     2139         for each buf_temp-browse-handle
     2140           where buf_temp-browse-handle.browse-type = 'width':u
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             buf_temp-browse-handle.browse-handle :width
     2145               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2146             no-error .
     2147           if error-status :error
     2148           or error-status :get-message(1) <> ""
     2149           then do:
     2150             undo move_block, retry move_block .
     2151           end.
     2152         end.
     2153         for each buf_temp-diasize-handle
     2154         on error undo move_block, retry move_block
     2155         :
     2156           assign
     2157             v-object-handle = buf_temp-diasize-handle.handle-value
     2158           .
     2159           if v-object-handle <> v-diasize-resize-button
     2160           then do:
     2161             assign
     2162               v-object-handle :col = v-object-handle :col + p-change-value
     2163               no-error .
     2164             if error-status :error
     2165             or error-status :get-message(1) <> ""
     2166             then do:
     2167               undo move_block, retry move_block .
     2168             end.
     2169           end.
     2170         end.
     2171       end.
     2172       else do:
     2173         for each buf_temp-diasize-handle
     2174         on error undo move_block, retry move_block
     2175         :
     2176           assign
     2177             v-object-handle = buf_temp-diasize-handle.handle-value
     2178           .
     2179           if v-object-handle <> v-diasize-resize-button
     2180           then do:
     2181             assign
     2182               v-object-handle :col = v-object-handle :col + p-change-value
     2183               no-error .
     2184             if error-status :error
     2185             or error-status :get-message(1) <> ""
     2186             then do:
     2187               undo move_block, retry move_block .
     2188             end.
     2189           end.
     2190         end.
     2191         for each buf_temp-browse-handle
     2192           where buf_temp-browse-handle.browse-type = 'width':u
     2193         on error undo move_block, retry move_block
     2194         :
     2195           assign
     2196             buf_temp-browse-handle.browse-handle :width
     2197               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2198             no-error .
     2199           if error-status :error
     2200           or error-status :get-message(1) <> ""
     2201           then do:
     2202             undo move_block, retry move_block .
     2203           end.
     2204         end.
     2205         assign
     2206           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2207           no-error .
     2208         if error-status :error
     2209         or error-status :get-message(1) <> ""
     2210         then do:
     2211           undo move_block, retry move_block.
     2212         end.
     2213         assign
     2214           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2215         no-error .
     2216         if error-status :error
     2217         or error-status :get-message(1) <> ""
     2218         then do:
     2219           undo move_block, retry move_block.
     2220         end.
     2221         if frame Dialog-Frame :scrollable = true
     2222         then do:
     2223           assign
     2224             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2225           no-error .
     2226           if error-status :error
     2227           or error-status :get-message(1) <> ""
     2228           then do:
     2229             undo move_block, retry move_block.
     2230           end.
     2231         end.
     2232       end.
     2233       if p-move-resize
     2234       then do:
     2235         run diasize_position-resize-button in this-procedure .
     2236       end.
     2237       if v-diasize-wndstore = true
     2238       then do:
     2239         if connected("ub") = true
     2240         then do:
     2241           define variable v-cntxt-db-num        as integer   no-undo .
     2242           define variable v-cntxt-userid        as character no-undo .
     2243           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2244                                             , OUTPUT v-cntxt-userid
     2245                                             ) .
     2246           run gbl/wndsizew.p
     2247             (input  v-cntxt-db-num
     2248             ,input  v-cntxt-userid
     2249             ,input  v-diasize-proc-name
     2250             ,input  'width':u
     2251             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2252             ) .
     2253         end.
     2254       end.
     2255     end.
     2256     assign
     2257       v-diasize-change-size = false
     2258     .
     2259   end procedure.
     2260   procedure diasize_set-width :
     2261     define input  parameter p-new-width  as decimal   no-undo .
     2262     define input  parameter p-move-resize as logical   no-undo .
     2263     do
     2264     on error undo, return error return-value
     2265     :
     2266       run diasize_change-width in this-procedure
     2267         (input  (p-new-width - frame Dialog-Frame :width)
     2268         ,input  p-move-resize
     2269         ) .
     2270     end.
     2271   end procedure.
     2272   procedure diasize_position-resize-button :
     2273     do with frame Dialog-Frame
     2274     :
     2275       hide v-diasize-resize-button .
     2276       assign
     2277         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2278                     - 1
     2279                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2280         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2281                     - 1
     2282                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2283       .
     2284       view v-diasize-resize-button .
     2285     end.
     2286   end procedure.
     2287   on alt-right anywhere
     2288   do:
     2289     run diasize_change-width in this-procedure
     2290       (input 1
     2291       ,input true
     2292       ) .
     2293     return no-apply .
     2294   end.
     2295   on alt-left anywhere
     2296   do:
     2297     run diasize_change-width in this-procedure
     2298       (input -1
     2299       ,input true
     2300       ) .
     2301     return no-apply .
     2302   end.
     2303   on alt-down anywhere
     2304   do:
     2305     run diasize_change-height in this-procedure
     2306       (input 1
     2307       ,input true
     2308       ) .
     2309     return no-apply .
     2310   end.
     2311   on alt-up anywhere
     2312   do:
     2313     run diasize_change-height in this-procedure
     2314       (input -1
     2315       ,input true
     2316       ) .
     2317     return no-apply .
     2318   end.
     2319   on alt-enter of frame Dialog-Frame
     2320   do:
     2321     run diasize_maximize in this-procedure
     2322       (input  ?
     2323       ).
     2324     return no-apply .
     2325   end.
     2326   procedure diasize_end-move :
     2327     do
     2328     on error undo, return error return-value
     2329     :
     2330       define variable v-row-delta as decimal   no-undo .
     2331       define variable v-col-delta as decimal   no-undo .
     2332       define variable v-new-row as decimal   no-undo .
     2333       define variable v-new-col as decimal   no-undo .
     2334       assign
     2335         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2336         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2337       .
     2338       assign
     2339         v-row-delta = v-new-row - frame Dialog-Frame :height
     2340         v-col-delta = v-new-col - frame Dialog-Frame :width
     2341       .
     2342       run diasize_change-height in this-procedure
     2343         (input v-row-delta
     2344         ,input true
     2345         ) .
     2346       run diasize_change-width in this-procedure
     2347         (input v-col-delta
     2348         ,input true
     2349         ) .
     2350     end.
     2351   end procedure.
     2352   procedure diasize_maximize :
     2353     define input  parameter p-action as logical   no-undo .
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357       if p-action = ?
     2358       then do:
     2359         if v-diasize-need-maximize = true
     2360         then do:
     2361           assign
     2362             p-action = true
     2363           .
     2364         end.
     2365         else do:
     2366           assign
     2367             p-action = false
     2368           .
     2369         end.
     2370       end.
     2371       if p-action = true
     2372       then do:
     2373         run diasize_change-height in this-procedure
     2374           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2375               - frame Dialog-Frame :height-chars
     2376           ,input true
     2377           ) .
     2378         run diasize_change-width in this-procedure
     2379           (input session :width-chars
     2380               - frame Dialog-Frame :width-chars
     2381           ,input true
     2382           ) .
     2383         assign
     2384           v-diasize-need-maximize = false
     2385         .
     2386       end.
     2387       else do:
     2388         run diasize_change-width in this-procedure
     2389           (input v-diasize-orig-frame-width
     2390               - frame Dialog-Frame :width-chars
     2391           ,input true
     2392           ) .
     2393         run diasize_change-height in this-procedure
     2394           (input v-diasize-orig-frame-height
     2395               - frame Dialog-Frame :height-chars
     2396           ,input true
     2397           ) .
     2398         assign
     2399           v-diasize-need-maximize = true
     2400         .
     2401       end.
     2402     end.
     2403   end procedure.
     2404   procedure diasize_restore-orig-size :
     2405     do
     2406     on error undo, return error return-value
     2407     :
     2408       assign
     2409         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2410         v-diasize-current-frame-height = frame Dialog-Frame :height
     2411       .
     2412       run diasize_set-height in this-procedure
     2413         (input  v-diasize-orig-frame-height
     2414         ,input  true
     2415         ) .
     2416       run diasize_set-width in this-procedure
     2417         (input  v-diasize-orig-frame-width
     2418         ,input  true
     2419         ) .
     2420     end.
     2421   end procedure.
     2422   procedure diasize_restore-current-size :
     2423     do
     2424     on error undo, return error return-value
     2425     :
     2426       run diasize_set-height in this-procedure
     2427         (input  v-diasize-current-frame-height
     2428         ,input  true
     2429         ) .
     2430       run diasize_set-width in this-procedure
     2431         (input  v-diasize-current-frame-width
     2432         ,input  true
     2433         ) .
     2434     end.
     2435   end procedure.
     2436   procedure diasize_set-browse-handle :
     2437     define input  parameter p-browse-handle as handle   no-undo .
     2438     define buffer buf_temp-browse-handle for temp-browse-handle .
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       assign
     2443         v-diasize-browse-handle = p-browse-handle
     2444       .
     2445       for each buf_temp-browse-handle
     2446       on error undo, return error return-value
     2447       :
     2448         delete buf_temp-browse-handle .
     2449       end.
     2450     end.
     2451   end procedure.
     2452   procedure diasize_add_browse :
     2453     define input  parameter p-browse-type   as character no-undo .
     2454     define input  parameter p-browse-handle as handle    no-undo .
     2455     define buffer buf_temp-browse-handle for temp-browse-handle .
     2456     do
     2457     on error undo, return error return-value
     2458     :
     2459       assign
     2460         v-diasize-browse-number = v-diasize-browse-number + 1
     2461       .
     2462       create buf_temp-browse-handle .
     2463       assign
     2464         buf_temp-browse-handle.browse-type   = p-browse-type
     2465         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2466         buf_temp-browse-handle.browse-handle = p-browse-handle
     2467       .
     2468     end.
     2469   end procedure.
     2470   procedure diasize_init :
     2471     define variable v-default-value    as logical   no-undo .
     2472     define variable v-restore-saved    as logical   no-undo .
     2473     define variable v-resize-value-str as character no-undo .
     2474     do
     2475     on error undo, return error return-value
     2476     :
     2477       do with frame Dialog-Frame
     2478       :
     2479         assign
     2480           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2481           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2482           v-diasize-browse-handle     = browse br-parts :handle
     2483         .
     2484         create button v-diasize-resize-button
     2485         assign
     2486           parent        = frame Dialog-Frame :first-child
     2487           label         = "s"
     2488           height-pixels = 16
     2489           width-pixels  = 16
     2490           visible       = true
     2491           sensitive     = true
     2492           movable       = true
     2493           triggers:
     2494             on end-move persistent run diasize_end-move in this-procedure .
     2495           end triggers.
     2496         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2497         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2498         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2499         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2500         assign
     2501           v-diasize-wndmax = false
     2502         .
     2503         if connected("ub") = true
     2504         then do:
     2505           define variable v-cntxt-db-num        as integer   no-undo .
     2506           define variable v-cntxt-userid        as character no-undo .
     2507           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2508                                             , OUTPUT v-cntxt-userid
     2509                                             ) .
     2510           run gbl/wndpar_r.p
     2511             (input  v-cntxt-db-num
     2512             ,input  v-cntxt-userid
     2513             ,input  'wndmax':U
     2514             ,output v-diasize-wndmax
     2515             ,output v-default-value
     2516             ) .
     2517         end.
     2518         assign
     2519           v-diasize-wndstore = false
     2520         .
     2521         if connected("ub") = true
     2522         then do:
     2523           run gbl/wndpar_r.p
     2524             (input  v-cntxt-db-num
     2525             ,input  v-cntxt-userid
     2526             ,input  'wndstore':U
     2527             ,output v-diasize-wndstore
     2528             ,output v-default-value
     2529             ) .
     2530         end.
     2531         assign
     2532           v-diasize-proc-name = entry(1, program-name(2), '.')
     2533         .
     2534         if v-diasize-wndstore = true
     2535         then do:
     2536           assign
     2537             v-restore-saved = false
     2538           .
     2539           if connected("ub") = true
     2540           then do:
     2541             run gbl/wndsizer.p
     2542               (input  v-cntxt-db-num
     2543               ,input  v-cntxt-userid
     2544               ,input  v-diasize-proc-name
     2545               ,input  'height':u
     2546               ,output v-resize-value-str
     2547               ) .
     2548             if v-resize-value-str <> '':U
     2549             then do:
     2550               run diasize_change-height in this-procedure
     2551                 (input  integer(v-resize-value-str)
     2552                 ,input  true
     2553                 ) .
     2554               assign
     2555                 v-restore-saved = true
     2556               .
     2557             end.
     2558           end.
     2559           if connected("ub") = true
     2560           then do:
     2561             run gbl/wndsizer.p
     2562               (input  v-cntxt-db-num
     2563               ,input  v-cntxt-userid
     2564               ,input  v-diasize-proc-name
     2565               ,input  'width':u
     2566               ,output v-resize-value-str
     2567               ) .
     2568             if v-resize-value-str <> '':U
     2569             then do:
     2570               run diasize_change-width in this-procedure
     2571                 (input  integer(v-resize-value-str)
     2572                 ,input  true
     2573                 ) .
     2574               assign
     2575                 v-restore-saved = true
     2576               .
     2577             end.
     2578           end.
     2579           if v-restore-saved <> true
     2580           then do:
     2581             if v-diasize-wndmax = true
     2582             then do:
     2583               run diasize_maximize in this-procedure
     2584                 (input  true
     2585                 ) .
     2586             end.
     2587           end.
     2588         end.
     2589         else do:
     2590           if v-diasize-wndmax = true
     2591           then do:
     2592             run diasize_maximize in this-procedure
     2593               (input  true
     2594               ) .
     2595           end.
     2596         end.
     2597       end.
     2598     end.
     2599   end procedure.
     2600   procedure diasize_need-full-display :
     2601     define output parameter p-need-full-display as logical   no-undo .
     2602     do
     2603     on error undo, return error return-value
     2604     :
     2605       assign
     2606         p-need-full-display = v-diasize-need-full-display
     2607       .
     2608       assign
     2609         v-diasize-need-full-display = false
     2610       .
     2611     end.
     2612   end procedure.
     2613   procedure get-context :
     2614      define output parameter p-db-num as integer          no-undo.
     2615      define output parameter p-user-id as character        no-undo.
     2616      define variable v-login               as character    no-undo.
     2617      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2618      define buffer buf_user-login  for ub.user-login .
     2619      do
     2620      on error undo, return error
     2621      :
     2622            FIND FIRST buf_sys-ctrl no-lock.
     2623            ASSIGN
     2624               v-login = USERID("ub")
     2625               p-db-num = buf_sys-ctrl.db-num
     2626            .
     2627            FIND FIRST buf_user-login
     2628                 WHERE buf_user-login.db-num = p-db-num
     2629                   AND buf_user-login.user-login = v-login
     2630                 no-lock
     2631                 no-error
     2632                 .
     2633            IF AVAILABLE buf_user-login
     2634            THEN DO:
     2635               assign
     2636                  p-user-id = buf_user-login.user-id
     2637               .
     2638            END.
     2639      end.
     2640   end procedure.
     2641       run diasize_init in this-procedure .
     2642   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2643   procedure set-filter-name :
     2644   define input parameter p-filter-name as character no-undo .
     2645     do with frame Dialog-Frame:
     2646       if p-filter-name > "" then do:
     2647         assign
     2648           frame Dialog-Frame:title
     2649             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2650         .
     2651         assign
     2652           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2653         .
     2654       end.
     2655       else do:
     2656         assign
     2657           b-sch :tooltip = ""
     2658         .
     2659       end.
     2660     end.
     2661   end procedure.
     2662   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2663   on INS of frame Dialog-Frame anywhere do:
     2664     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2665     return no-apply.
     2666   end.
     2667   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2668   on F2 of frame Dialog-Frame anywhere do:
     2669     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2670     return no-apply.
     2671   end.
     2672   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2673   on F2 of frame Dialog-Frame anywhere do:
     2674     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2675     return no-apply.
     2676   end.
     2677   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2679     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2680     return no-apply.
     2681   end.
     2682   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   do:
     2684     br-parts :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2685   end.
     2686   CASE p-coll-point:
     2687       WHEN "document":U THEN DO:
     2688       END.
     2689       OTHERWISE DO:
     2690           message vss-workfile vss-revision vss-description skip
     2691           "Неверный вызов - p-coll-point=" p-coll-point
     2692           view-as alert-box ERROR.
     2693           return.
     2694       END.
     2695   END CASE.
     2696   if p-edit-mode = 'ПРОСМОТР':U THEN do:
     2697     MAIN-BLOCK:
     2698     DO
     2699     ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2700     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2701     :
     2702      run main-block-procedure no-error .
     2703       if error-status :error
     2704       then do:
     2705         undo MAIN-BLOCK, LEAVE MAIN-BLOCK .
     2706       end.
     2707     END.
     2708   end.
     2709   else do:
     2710         message vss-workfile vss-revision vss-description skip
     2711         "Неверный параметр вызова - p-edit-mode=" p-edit-mode
     2712         view-as alert-box error.
     2713         return.
     2714   end.
     2715   RUN disable_UI.
     2716   PROCEDURE disable_UI :
     2717     HIDE FRAME Dialog-Frame.
     2718   END PROCEDURE.
     2719   PROCEDURE enable_UI :
     2720     DISPLAY fl-wth-code fl-wth-name fl-wth-par fl-par-val fl-gds fl-artic
     2721             fl-prodType fl-ProdCode fl-obj-name Fn-rs-obj
     2722         WITH FRAME Dialog-Frame.
     2723     ENABLE b-exit b-quit B-mark B-sel b-lkp B-sch B-print B-Help RECT-1 br-parts
     2724            fl-wth-code fl-wth-name fl-wth-par fl-par-val fl-artic fl-prodType
     2725            fl-ProdCode fl-obj-name Fn-rs-obj
     2726         WITH FRAME Dialog-Frame.
     2727     VIEW FRAME Dialog-Frame.
     2728     OPEN QUERY br-parts FOR EACH X_c-wth-parts NO-LOCK INDEXED-REPOSITION.
     2729   END PROCEDURE.
     2730   PROCEDURE main-block-procedure :
     2731   if p-wth-code > 0 or p-coll-point = 'Номинал МЦ':U then do:
     2732     find first b-wealth where b-wealth.wth-code = p-wth-code no-lock no-error.
     2733     if not available b-wealth then do:
     2734       message substitute("Не найдена МЦ с кодом &1!",p-wth-code)
     2735       view-as alert-box error.
     2736       return error.
     2737     end.
     2738   end.
     2739   if p-par-code > 0 or p-coll-point = 'Номинал МЦ':U then do:
     2740     find first b-wth-par where b-wth-par.wth-code = p-wth-code
     2741                             and  b-wth-par.par-code = p-par-code
     2742     no-lock no-error.
     2743     if not available b-wth-par then do:
     2744       message substitute("Не найден номинал МЦ. Код номинала: &1, Код МЦ: &2!",p-par-code, p-wth-code)
     2745       view-as alert-box error.
     2746       return error.
     2747     end.
     2748   end.
     2749   if p-ser-code > 0 or p-coll-point = 'Серии МЦ':U then do:
     2750     find first b-wth-ser where b-wth-ser.ser-code = p-ser-code
     2751                              and b-wth-ser.db-num = p-db-num
     2752     no-lock no-error.
     2753     if not available b-wth-ser then do:
     2754       message substitute("Не найдена серия МЦ. Код серии &1-&2!",p-ser-code, p-db-num)
     2755       view-as alert-box error.
     2756       return error.
     2757     end.
     2758   end.
     2759   if p-coll-point = 'document':U then do:
     2760     if p-edit-mode = 'ПРОСМОТР':U then
     2761     FIND FIRST b-c-wth-doc WHERE b-c-wth-doc.doc-code = p-c-wth-doc NO-LOCK NO-ERROR.
     2762     ELSE FIND FIRST b-c-wth-doc WHERE b-c-wth-doc.doc-code = p-c-wth-doc exclusive-lock NO-ERROR.
     2763     if not available b-c-wth-doc then do:
     2764       message substitute("Не найден документ с номером &1!",p-c-wth-doc)
     2765       view-as alert-box error.
     2766       return error.
     2767     end.
     2768   end.
     2769   run MyEnable.
     2770   RUN openBr.
     2771   wait-for 'go' of frame    Dialog-Frame  .
     2772   END PROCEDURE.
     2773   PROCEDURE MyEnable :
     2774   br-parts:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 4 .
     2775   DEF VAR rs-list AS CHAR.
     2776   IF p-coll-point = 'document' THEN DO:
     2777       FIND FIRST b-c-wth-doc WHERE b-c-wth-doc.doc-code = p-c-wth-doc NO-LOCK NO-ERROR.
     2778   END.
     2779   ENABLE b-exit when not p-edit-mode = 'ПРОСМОТР':U
     2780       b-quit
     2781       b-lkp
     2782       br-parts
     2783       b-sch
     2784       b-print
     2785       b-help
     2786     WITH FRAME Dialog-Frame.
     2787   if p-coll-point = 'document':U then do:
     2788       if p-edit-mode = 'ПРОСМОТР':U then  do:
     2789         b-quit:label = 'Выход'.
     2790       end.
     2791   end.
     2792   else do:
     2793     b-quit:label = 'Выход'.
     2794   end.
     2795   END PROCEDURE.
     2796   PROCEDURE OpenBr :
     2797   define variable l-query-was-opened as logical no-undo .
     2798   DEF VAR zone-list AS CHAR.
     2799   DEFINE VARIABLE cur-wth-name AS CHARACTER NO-UNDO.
     2800   DEFINE VARIABLE cur-par-val AS INTEGER NO-UNDO.
     2801   DEFINE VARIABLE cur-par-unit AS CHARACTER NO-UNDO.
     2802   DEFINE VARIABLE cur-ser-name AS CHARACTER NO-UNDO.
     2803   DEFINE VARIABLE cur-wth-ext-doc-type AS character NO-UNDO.
     2804   DEFINE VARIABLE cur-wth-ext-doc-type-text AS character NO-UNDO.
     2805   DEFINE VARIABLE cur-c-wth-doc-code AS CHARACTER NO-UNDO.
     2806   zone-list = SUBSTITUTE('&1,&2,&3,&4','free-zone':U,'cli-zone':U,'put-zone':U,'out-zone':U).
     2807   IF AVAILABLE b-wealth THEN cur-wth-name = b-wealth.wth-name.
     2808   ELSE cur-wth-name = '?':U.
     2809   IF AVAILABLE b-wth-par THEN assign cur-par-val  = b-wth-par.par-val
     2810                                      cur-par-unit = b-wth-par.par-unit.
     2811   ELSE assign cur-par-val  = ?
     2812               cur-par-unit = '':U.
     2813   IF AVAILABLE b-c-wth-doc THEN do:
     2814       cur-wth-ext-doc-type = b-c-wth-doc.ext-doc-type.
     2815       cur-wth-ext-doc-type-text = ENTRY (lookup(b-c-wth-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u).
     2816       cur-c-wth-doc-code = b-c-wth-doc.doc-code.
     2817   END.
     2818   ELSE do:
     2819       cur-wth-ext-doc-type = '?':U.
     2820       cur-c-wth-doc-code = '?':U.
     2821   END.
     2822   if available b-wth-ser then  cur-ser-name = b-wth-ser.series.
     2823   run waitfram-show in this-procedure (  input "Ждите...").
     2824   define variable sort-column-phrase as character no-undo .
     2825   case sort-column-name :
     2826     when "" then do:
     2827       assign
     2828         sort-column-phrase = ""
     2829       .
     2830     end.
     2831     otherwise do:
     2832       assign
     2833         sort-column-phrase = "by " + sort-column-name
     2834       .
     2835     end.
     2836   end case.
     2837   CASE p-coll-point:
     2838       when 'document' then do:
     2839         ASSIGN frame Dialog-Frame:TITLE = substitute("Партии номинала &1 &2 МЦ &3 Документ: &4 № &5 &6 " ,cur-par-val, cur-par-unit, cur-wth-name, cur-wth-ext-doc-type-text ,cur-c-wth-doc-code, if p-edit-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else "":U).
     2840   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2841   define variable  l-disable-where-24  as logical   no-undo .
     2842   define variable  l-filter-open-24    as logical   .
     2843   define variable  flt-rec-24       as recid     no-undo .
     2844   define variable  filter-name-24      as character no-undo .
     2845   define variable  where-phrase-24     as character no-undo .
     2846   define variable  sort-phrase-24      as character no-undo .
     2847   define variable  where-phrase-rus-24 as character no-undo .
     2848   define variable  sort-phrase-rus-24  as character no-undo .
     2849     run waitfram-show in this-procedure
     2850       (input "ЖДИТЕ ..."
     2851       ).
     2852   run gbl/flt-get.p
     2853     (input filter-point
     2854     ,output flt-rec-24
     2855     ,output filter-name-24
     2856     ,output where-phrase-24
     2857     ,output sort-phrase-24
     2858     ,output where-phrase-rus-24
     2859     ,output sort-phrase-rus-24
     2860     ).
     2861       run set-filter-name in this-procedure
     2862         (INPUT filter-name-24
     2863         ) no-error .
     2864     assign
     2865       l-filter-open-24 = false
     2866     .
     2867     if flt-rec-24 <> ?
     2868       or sort-column-phrase > ""
     2869     then do:
     2870       define variable  parameter-2-24 as character no-undo .
     2871       define variable  parameter-3-24 as character no-undo .
     2872       define variable  parameter-4-24 as character no-undo .
     2873       define variable  parameter-5-24 as character no-undo .
     2874       define variable  parameter-6-24 as character no-undo .
     2875       define variable  parameter-7-24 as character no-undo .
     2876         assign
     2877         parameter-3-24 =
     2878                                 "FOR EACH X_c-wth-parts"
     2879         parameter-4-24 =
     2880           (
     2881             if (" X_c-wth-parts.wth-code = p-wth-code and X_c-wth-parts.w-p-code = p-w-p-code             and X_c-wth-parts.par-code = p-par-code and X_c-wth-parts.out-code = p-c-wth-doc " + " " + where-phrase-24) <> ""
     2882             then  substitute('
     2883                 X_c-wth-parts.wth-code = &2     and               X_c-wth-parts.w-p-code = &3     and               X_c-wth-parts.par-code = &4     and               X_c-wth-parts.out-code = &1&5&1                   '               , chr(34)
     2884                 , p-wth-code                , p-w-p-code                , p-par-code                , p-c-wth-doc               )                + " " + where-phrase-24
     2885             else "true"
     2886           )
     2887         parameter-5-24 = (" " + "" + " " + "")
     2888         parameter-6-24 = if sort-phrase-24 = ''
     2889                              then
     2890           (
     2891           " " + "  " +
     2892             " " + sort-column-phrase +
     2893           " " + " by X_c-wth-parts.fact-rangefrom "
     2894           )
     2895                              else
     2896           (
     2897           " " + "  " +
     2898             " " + sort-column-phrase +
     2899           " " + sort-phrase-24
     2900           )
     2901         parameter-7-24 =
     2902           "   "
     2903       .
     2904       do
     2905       on stop undo, leave
     2906       on error undo, leave
     2907       :
     2908         assign
     2909           l-disable-where-24 =
     2910             (" X_c-wth-parts.wth-code = p-wth-code and X_c-wth-parts.w-p-code = p-w-p-code             and X_c-wth-parts.par-code = p-par-code and X_c-wth-parts.out-code = p-c-wth-doc " + " " + where-phrase-24 = "")
     2911         .
     2912         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2913                             ,input query br-parts:handle
     2914                             ,input parameter-3-24
     2915                             ,input parameter-4-24
     2916                             ,input parameter-5-24
     2917                             ,input parameter-6-24
     2918                             ,input parameter-7-24
     2919                             )
     2920         .
     2921         assign
     2922           l-filter-open-24 = true
     2923         .
     2924       end.
     2925       if l-filter-open-24 = false then do:
     2926         message
     2927           "Ошибка при фильтрации / сортировке" skip
     2928           "Будут показаны записи без учета фильтра" skip
     2929           view-as alert-box .
     2930       end.
     2931       else do:
     2932           assign
     2933             l-query-was-opened = true
     2934           .
     2935       end.
     2936     end.
     2937     if l-filter-open-24 = false then do:
     2938       OPEN QUERY br-parts FOR EACH X_c-wth-parts
     2939         where  X_c-wth-parts.wth-code = p-wth-code and X_c-wth-parts.w-p-code = p-w-p-code             and X_c-wth-parts.par-code = p-par-code and X_c-wth-parts.out-code = p-c-wth-doc
     2940          by X_c-wth-parts.fact-rangefrom
     2941     .
     2942         assign
     2943           l-query-was-opened = true
     2944         .
     2945     end.
     2946     run waitfram-hide in this-procedure .
     2947       end.
     2948   END CASE.
     2949   if v-prt-rec <> ? then reposition br-parts to recid v-prt-rec no-error.
     2950   apply "entry" to br-parts in frame Dialog-Frame.
     2951   run waitfram-hide in this-procedure .
     2952   APPLY "VALUE-CHANGED":U to br-parts.
     2953   END PROCEDURE.
     2954   PROCEDURE PrintProc :
     2955   define variable date_string     as      char    no-undo.
     2956   define variable Line                as      char    no-undo.
     2957   define variable for-time as char.
     2958   define variable v-obj    as character    no-undo.
     2959   define variable v-cli    as character    no-undo.
     2960   DEFINE FRAME Wth-List
     2961   X_c-wth-parts.wth-code       column-label "Код МЦ"
     2962   v-SerDb                    column-label "Код серии"
     2963   X_c-wth-parts.fact-rangeFrom column-label "Диапазон с"
     2964   X_c-wth-parts.fact-rangeTo   column-label "Диапазон по"
     2965   X_c-wth-parts.par-code       column-label "Код номинала"
     2966   X_c-wth-parts.w-p-code       column-label "Код МХ"
     2967   v-obj                      column-label "Объект"
     2968   v-out-name                 column-label "Зона"
     2969   X_c-wth-parts.in-code        column-label "Накл. порожд."
     2970   v-cli                      column-label "Покупатель"  format 'x(12)'
     2971   HEADER  date_string AT 5 format "X(35)"
     2972   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     2973   Line format "X(138)" AT 1
     2974   with width 160 down stream-io use-text    .
     2975   Line = fill("-", 122).
     2976   date_string = cur-time-print() .
     2977   run prn-lib-open-stream  in this-procedure (
     2978                                                input parParentProc
     2979                                               ,input 62
     2980                                               ,input yes
     2981                                               ,input no
     2982                                               ).
     2983   PUT  STREAM PrnLibStream
     2984   SPACE(25) ( frame Dialog-Frame:title )
     2985   format "x(90)" SKIP(1) .
     2986   FORM HEADER
     2987   Line AT 1 SKIP
     2988   "Продолжение - на следующей странице" AT 30 SKIP
     2989   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     2990   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2991   FORM with FRAME Wth-List  .
     2992   run waitfram-show in this-procedure ( input "Ждите...").
     2993   GET next BR-parts.
     2994   DO WHILE available X_c-wth-parts :
     2995     Display STREAM PrnLibStream
     2996         X_c-wth-parts.wth-code
     2997         substitute('&1-&2',X_c-wth-parts.ser-code,X_c-wth-parts.db-num) @ v-SerDb
     2998         X_c-wth-parts.fact-rangeFrom
     2999         X_c-wth-parts.fact-rangeTo
     3000         X_c-wth-parts.par-code
     3001         X_c-wth-parts.w-p-code
     3002         substitute('&1 &2',X_c-wth-parts.obj-type,X_c-wth-parts.obj-code) @ v-obj
     3003         get-wthparts-out-code(X_c-wth-parts.out-code) @ v-out-name
     3004         X_c-wth-parts.in-code
     3005         substitute('&1 &2',X_c-wth-parts.cli-type,X_c-wth-parts.cli-code) @ v-cli
     3006     with FRAME Wth-List .
     3007     DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3008     GET next BR-parts.
     3009   END.
     3010   UNDERLINE  STREAM PrnLibStream
     3011       X_c-wth-parts.wth-code
     3012       v-SerDb
     3013       X_c-wth-parts.fact-rangeFrom
     3014       X_c-wth-parts.fact-rangeTo
     3015       X_c-wth-parts.par-code
     3016       X_c-wth-parts.w-p-code
     3017       v-obj
     3018       v-out-name
     3019       X_c-wth-parts.in-code
     3020       v-cli
     3021   with FRAME Wth-List .
     3022   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3023   HIDE  STREAM PrnLibStream FRAME CheckList.
     3024   output  STREAM PrnLibStream CLOSE.
     3025   run waitfram-hide in this-procedure .
     3026   run prn-lib-prn-file in this-procedure (
     3027                                             input parParentProc
     3028                                             ,input 0
     3029                                             ).
     3030   END PROCEDURE.
     3031   FUNCTION get-cli-name RETURNS CHARACTER
     3032     ( f-cli-type AS CHAR, f-cli-code as int  ) :
     3033   For FIRST b-clients WHERE b-clients.obj-type = f-cli-type AND
     3034                          b-clients.obj-code = f-cli-code NO-LOCK:
     3035     return   b-clients.obj-name.
     3036   end.
     3037   RETURN "".
     3038   END FUNCTION.
     3039   FUNCTION get-w-p-name RETURNS CHARACTER
     3040     ( vf-w-p-code AS int ,vf-obj-type as char, vf-obj-code as int ) :
     3041   if vf-w-p-code = 0 or vf-w-p-code = ? then return "":U.
     3042   for first buf_wth-place no-lock where buf_wth-place.w-p-code = vf-w-p-code
     3043                                     and buf_wth-place.obj-type = vf-obj-type
     3044                                     and buf_wth-place.obj-code = vf-obj-code:
     3045     return buf_wth-place.w-p-name.
     3046   end.
     3047   return string(vf-w-p-code).
     3048   END FUNCTION.
     3049   FUNCTION get-wthparts-out-code RETURNS CHARACTER
     3050     ( vf-out-code AS CHAR ) :
     3051   CASE vf-out-code:
     3052       WHEN 'free-zone':U   THEN RETURN 'свободно'.
     3053       WHEN 'out-zone':U THEN RETURN 'списано'.
     3054       WHEN 'put-zone':U    THEN RETURN 'погашено'.
     3055       WHEN 'cli-zone':U    THEN RETURN 'у клиента'.
     3056       WHEN 'фальшивый':U      THEN RETURN 'фальш.'.
     3057   END CASE.
     3058   RETURN vf-out-code.
     3059   END FUNCTION.
