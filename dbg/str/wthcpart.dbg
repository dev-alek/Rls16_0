     1074   DEFINE VARIABLE fl-artic AS CHARACTER FORMAT "X(16)":U INITIAL "0"
     1075        LABEL "Артикул"
     1076        VIEW-AS FILL-IN
     1077        SIZE 10.5 BY 1
