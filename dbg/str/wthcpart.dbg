     1085        VIEW-AS FILL-IN
     1086        SIZE 22 BY 1
     1087        FGCOLOR 4  NO-UNDO.
     1088   DEFINE VARIABLE fl-par-val AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1089        LABEL "Номинал"
     1090        VIEW-AS FILL-IN
     1091        SIZE 4 BY 1
     1092        FGCOLOR 4  NO-UNDO.
     1093   DEFINE VARIABLE fl-ProdCode AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1094        VIEW-AS FILL-IN
