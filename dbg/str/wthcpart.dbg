      558   procedure prn-lib-reportviewer :
      559     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      560     define input parameter p-report-name-html as character no-undo .
      561     define input parameter p-param        as character no-undo .
      562     define variable v-excel           as character no-undo init 'TRUE' .
      563     define variable v-value-character as character no-undo .
      564     define variable v-value-integer   as character no-undo .
      565     define variable v-value-date      as date      no-undo .
      566     define variable v-value-decimal   as decimal   no-undo .
      567     define variable rep-excel         as logical   no-undo .
      568     define variable excel-string      as character no-undo .
      569     define variable v-param-type      as character no-undo .
      570     define variable v-tth             as handle    no-undo .
      571     run adm/shattri.p (
      572       input "get":U
      573       ,input  ""
      574       ,input  0
      575       ,input  'report-glob':U
      576       ,input  'rep-excel':U
      577       ,output v-value-character
      578       ,output v-value-date
      579       ,output v-value-decimal
      580       ,output v-value-integer
      581       ,output rep-excel
      582       ,output v-param-type
      583       ,INPUT-OUTPUT table-handle v-tth
      584       )  .
      585     if rep-excel then v-excel = "TRUE" .
      586     else v-excel = "FALSE" .
      587     if p-param eq ""
      588     then
      589        p-param = "EXCEL:" + v-excel.
      590     else
      591        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      592     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      593   end procedure.
      594   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define variable v-waitfram-action01         as character   no-undo .
      596   define variable v-waitfram-action02         as character   no-undo .
      597   define variable v-waitfram-action03         as character   no-undo .
      598   define variable mWaitFramTextBeg            as character   no-undo.
      599   define variable mWaitFramTextEnd            as character   no-undo.
      600   define variable mWaitFramView               as logical     no-undo.
      601   define variable mWaitProcEvent              as logical     no-undo init yes.
      602   define variable mWaitFramInterval           as integer     no-undo init 1 .
      603   define variable mWaitFramStop               as logical     no-undo.
      604   define variable mWaitFramStopUser           as logical     no-undo.
      605   define variable mWaitFramStopTimeOut        as logical     no-undo.
      606   define variable mWaitFramStartProc          as datetime-tz no-undo.
      607   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      608   define button B-WaitFramStop auto-end-key
      609        label "Стоп"
      610        size 10 by 1 tooltip "Остоновить процесс".
      611   define button B-viewProcInfo
      612        label "Информация"
      613        size 15 by 1 tooltip "Информация о процесс".
      614   define frame waitfram
      615     v-waitfram-action01 format "x(72)" no-label skip
      616     v-waitfram-action02 format "x(72)" no-label skip
      617     v-waitfram-action03 format "x(72)" no-label skip
      618     B-viewProcInfo
      619     B-WaitFramStop at row 4 col 30
      620     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      621     .
      622   define new global shared variable mBatchMode as logical no-undo init ?.
      623   define variable mFramBachModHandle as handle no-undo.
      624   mFramBachModHandle = frame waitfram:handle.
      625   define variable mFameOldVis as logical no-undo.
      626   define variable mVisCUrentVin as logical no-undo.
      627   if session:batch-mode
      628   then
      629      mBatchMode = yes.
      630   if mBatchMode = ? then do:
      631     mVisCUrentVin = current-window:visible.
      632     mFameOldVis = mFramBachModHandle:visible.
      633     mFramBachModHandle:visible  = yes.
      634     mBatchMode = mFramBachModHandle:visible ne yes.
      635     mFramBachModHandle:visible = mFameOldVis.
      636     current-window:visible = mVisCUrentVin.
      637   end.
      638    if  log-manager:logfile-name ne ?
      639     then DO:
      640         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      641         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      642         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      643     end.
      644   on choose of B-WaitFramStop in frame waitfram
      645   do:
      646     mWaitFramStop = yes.
      647     mWaitFramStopUser = yes.
      648   end.
      649   function waitfram-check-timeout returns logical():
      650      define variable vtime as int64 no-undo.
      651      if mWaitFramStopTimeOut
      652      then
      653         return yes.
      654      vtime = ( now - mWaitFramStartProc ) / 1000 .
      655      if     mWaitFramTimeOut ne ?
      656         and mWaitFramTimeOut ne 0
      657         and mWaitFramTimeOut lt vtime
      658      then do:
      659         mWaitFramStopTimeOut = yes.
      660      end.
      661      return mWaitFramStopTimeOut.
      662   end.
      663   procedure waitfram-hide :
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       pause 0 before-hide .
      669       if not mBatchMode then
      670         hide frame waitfram .
      671     if     not mWaitFramView
      672        and mWaitProcEvent
      673     then
      674       process events .
      675     end.
      676   end procedure.
      677   procedure waitfram-show :
      678     define input  parameter p-message as character no-undo .
      679     define variable v-left-margin as integer   no-undo .
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       if length(p-message) <= 70 then do:
      685         assign
      686           v-left-margin = integer((70 - length(p-message)) / 2)
      687         .
      688         assign
      689           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      690         .
      691         assign
      692           v-waitfram-action01 = " "
      693           v-waitfram-action02 = " "
      694                                    + fill(" ", v-left-margin)
      695                                    + p-message
      696           v-waitfram-action03 = " "
      697         .
      698       end.
      699       else do:
      700         define variable vRindex1 as integer no-undo.
      701         define variable vRindex2 as integer no-undo.
      702         vRindex1 = r-index(p-message," ",70).
      703         if vRindex1 = 0
      704         then
      705            vRindex1 = 70.
      706         if length(p-message)  <= vRindex1 + 70 then do:
      707           assign
      708             v-waitfram-action01 = " "
      709             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      710             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      711           .
      712         end.
      713         else do:
      714           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      715           if vRindex2 <= vRindex1
      716           then
      717              vRindex2 = vRindex1 + 70.
      718           assign
      719             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      720             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      721             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      722           .
      723         end.
      724       end.
      725       B-viewProcInfo:visible   in frame waitfram = no.
      726       B-viewProcInfo:sensitive in frame waitfram = no.
      727       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       if  (   mWaitFramView
      730          or  mWaitProcEvent)
      731          and not mBatchMode
      732       then
      733          display
      734             v-waitfram-action01 skip
      735             v-waitfram-action02 skip
      736             v-waitfram-action03 skip
      737          with frame waitfram .
      738       if     mWaitFramView
      739          then do:
      740             if     mWaitFramInterval ne ?
      741                and not mBatchMode
      742             then
      743                wait-for go of frame waitfram pause mWaitFramInterval.
      744          end.
      745          else
      746             if     mWaitProcEvent
      747                and not mBatchMode
      748             then
      749                process events .
      750     end.
      751   end procedure.
      752      procedure waitfram-show-this:
      753         define input  parameter iInterval as int64 no-undo.
      754         define variable vtime as int64 no-undo.
      755         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      756         mWaitFramInterval = iInterval.
      757         run waitfram-show (substitute("&1&2 &3&4" ,
      758                                       mWaitFramTextBeg ,
      759                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      760                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      761                                       mWaitFramTextEnd
      762                                      )
      763                           ).
      764      end.
      765      procedure WaitFramRunPause:
      766         define input  parameter iInterval as dec no-undo.
      767         define variable vStart  as datetime-tz no-undo.
      768         define variable vend    as datetime-tz no-undo.
      769         define variable vint as int64 no-undo.
      770         define variable vOk as logical no-undo.
      771         vStart = now.
      772         vend   = vStart.
      773         publish "WaitFramPause" (iInterval,output vOk).
      774         vend   =  now.
      775         vint = vend - vStart.
      776         vint = iInterval - vint / 1000.
      777         if     not mWaitFramStop
      778            and (   vint > 0
      779                 or (    not vOk
      780                     and iInterval eq ?
      781                     )
      782                 )
      783         then
      784            run waitfram-show-this (iInterval).
      785         vend   =  now.
      786         vint = vend - vStart.
      787         vint = iInterval - vint / 1000.
      788         if     not mWaitFramStop
      789            and vint > 0
      790         then do:
      791            run gbl/pause.p (vint * 1000).
      792         end.
      793         if iInterval ne ?
      794         then
      795            publish "WaitFramStop".
      796         waitfram-check-timeout().
      797      end.
      798      procedure WaitFramWaitFor:
      799         define input  parameter iInterval as dec no-undo.
      800         assign
      801            mWaitFramStartProc   = now
      802            mWaitFramStopUser    = no
      803            mWaitFramStopTimeOut = no
      804         .
      805         block-wait:
      806         do while not mWaitFramStop:
      807            run WaitFramRunPause (iInterval).
      808            if  waitfram-check-timeout()
      809            then do:
      810               leave block-wait.
      811            end.
      812         end.
      813         run waitfram-hide.
      814      end.
      815   procedure waitfram-join :
      816     define input  parameter p-line-1  as character no-undo .
      817     define input  parameter p-line-2  as character no-undo .
      818     define input  parameter p-line-3  as character no-undo .
      819     define output parameter p-message as character no-undo .
      820     do
      821     on error undo, return error return-value
      822     :
      823       assign
      824         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      827       .
      828     end.
      829   end procedure.
      830   function waitfram-join-function returns character
      831     (input p-line-1 as character
      832     ,input p-line-2 as character
      833     ,input p-line-3 as character
      834     ).
      835     define variable v-message as character no-undo .
      836     run waitfram-join in this-procedure
      837       (input  p-line-1
      838       ,input  p-line-2
      839       ,input  p-line-3
      840       ,output v-message
      841       ) .
      842     return v-message .
      843   end function .
      844   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845     define variable v-cntxt-db-num        as integer   no-undo .
      846     define variable v-cntxt-userid        as character no-undo .
      847     define variable v-cntxt-level         as character no-undo .
      848     define variable v-cntxt-host-code-obj as integer   no-undo .
      849     define variable v-cntxt-obj-type      as character no-undo .
      850     define variable v-cntxt-obj-code      as integer   no-undo .
      851     define variable v-cntxt-db-num-obj    as integer   no-undo .
      852     define variable v-cntxt-is-admin      as logical   no-undo .
      853   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   FUNCTION mark-string RETURNS CHARACTER
      855     ( input p-recid as recid, input mark-list as character  ) :
      856     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      857   END FUNCTION.
      858   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      860   procedure fltopend_fltopend :
      861   define input parameter p-parent-handle as handle no-undo .
      862   define input parameter p-qh as handle no-undo .
      863   define input parameter p-flt-open-open-query  as character no-undo .
      864   define input parameter p-where-cond as character no-undo .
      865   define input parameter p-use-indFIRST-query-tail as character no-undo .
      866   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      867   define input parameter p-indexed-reposition as character no-undo .
      868     do
      869     on error undo, return error
      870     :
      871   define variable v-prepare-string as character no-undo .
      872   define variable glog as logical no-undo .
      873   assign
      874   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      875                      p-where-cond + chr(32)  +
      876                      p-use-indFIRST-query-tail + chr(32) +
      877                      p-use-ind-sort-clmn-by + chr(32) +
      878                      p-indexed-reposition
      879   .
      880   assign
      881   glog = p-qh:query-prepare(v-prepare-string) no-error .
      882   if not glog
      883   or error-status:error then do:
      884     message error-status:get-message(1) view-as alert-box .
      885     undo, return error .
      886   end.
      887   assign
      888   glog = p-qh:query-open no-error .
      889   if not glog
      890   or error-status:error then do:
      891     message error-status:get-message(1) view-as alert-box .
      892     undo, return error .
      893   end.
      894     end.
      895   end procedure.
      896   procedure fltopend_fltfindd :
      897   define input parameter p-parent-handle as handle no-undo .
      898   define input parameter p-qh as handle no-undo .
      899   define input parameter p-rowid as rowid no-undo .
      900   define input parameter p-next as logical no-undo .
      901   define input parameter p-lock as integer no-undo .
      902   define input parameter p-bh as handle no-undo .
      903   define input parameter p-where-cond as character no-undo .
      904   define input parameter p-use-index-phrase as character no-undo .
      905   define variable glog as logical no-undo .
      906   define variable v-qh as handle no-undo .
      907   define variable v-bh as handle no-undo .
      908   define variable v-recid as recid no-undo .
      909   define variable v-prepare-string as character no-undo .
      910   do
      911   on error undo, return error
      912   on stop undo, return error
      913   :
      914     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      915     create buffer v-bh for table p-bh buffer-name p-bh:name.
      916     create query v-qh.
      917     v-qh:set-buffers(v-bh).
      918     v-prepare-string = substitute("for each &1 &2 &3"
      919                                     ,v-bh:name
      920                                     ,p-where-cond
      921                                     ,p-use-index-phrase).
      922     glog = v-qh:query-prepare(v-prepare-string) no-error.
      923     if not glog then do:
      924       delete object v-qh.
      925       delete object v-bh.
      926       undo, return error .
      927     end.
      928     glog = v-qh:query-open no-error .
      929     if not glog then do:
      930       delete object v-qh.
      931       delete object v-bh.
      932       undo, return error .
      933     end.
      934     if p-next then do:
      935       v-qh:reposition-to-rowid(p-rowid) no-error .
      936       glog = v-qh:get-next( p-lock) no-error .
      937       glog = v-qh:get-next( p-lock) no-error .
      938       if not glog or v-qh:query-off-end = yes then do:
      939         glog = v-qh:get-first( p-lock) no-error .
      940       end.
      941     end.
      942     else do:
      943       glog = v-qh:get-first( p-lock) no-error .
      944     end.
      945     v-recid = v-bh:recid no-error .
      946     delete object v-qh.
      947     delete object v-bh.
      948     return string(v-recid) .
      949   end.
      950   end procedure.
      951   procedure fltopend_fltfindq :
      952   define input parameter p-parent-handle as handle no-undo .
      953   define input parameter p-qh as handle no-undo .
      954   define input parameter p-next as logical no-undo .
      955   define input parameter p-lock as integer no-undo .
      956   define input parameter p-flt-open-open-query  as character no-undo .
      957   define input parameter p-where-cond as character no-undo .
      958   define input parameter p-use-indFIRST-query-tail as character no-undo .
      959   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      960   define input parameter p-indexed-reposition as character no-undo .
      961   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      962   define variable glog as logical no-undo .
      963   define variable v-qh as handle no-undo .
      964   define variable v-bh as handle no-undo extent 18.
      965   define variable v-rowid as rowid no-undo extent 18.
      966   define variable v-ii as integer no-undo .
      967   define variable v-prepare-string as character no-undo .
      968   do
      969   on error undo, return error
      970   on stop undo, return error
      971   :
      972     create query v-qh.
      973     do v-ii = 1 to p-qh:num-buffers:
      974       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      975       assign
      976       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      977       no-error.
      978       v-qh:add-buffer(v-bh[v-ii]).
      979     end.
      980     assign
      981     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      982                       p-where-cond + chr(32)  +
      983                       p-use-indFIRST-query-tail + chr(32) +
      984                       p-use-ind-sort-clmn-by + chr(32) +
      985                       p-indexed-reposition
      986     .
      987     glog = v-qh:query-prepare( v-prepare-string) no-error .
      988     if not glog then do:
      989       delete object v-qh.
      990       do v-ii = 1 to p-qh:num-buffers:
      991         delete object v-bh[v-ii].
      992       end.
      993       undo, return error .
      994     end.
      995     glog = v-qh:query-open no-error .
      996     if not glog then do:
      997       delete object v-qh.
      998       do v-ii = 1 to p-qh:num-buffers:
      999         delete object v-bh[v-ii].
     1000       end.
     1001       undo, return error .
     1002     end.
     1003     if p-next then do:
     1004       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1005       glog = v-qh:get-next( p-lock) no-error .
     1006       glog = v-qh:get-next( p-lock) no-error .
     1007       if not glog or v-qh:query-off-end = yes then do:
     1008         glog = v-qh:get-first( p-lock) no-error .
     1009       end.
     1010     end.
     1011     else do:
     1012       glog = v-qh:get-first( p-lock) no-error .
     1013     end.
     1014     do v-ii = 1 to p-qh:num-buffers:
     1015       assign
     1016       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1017       no-error.
     1018     end.
     1019     delete object v-qh.
     1020     do v-ii = 1 to p-qh:num-buffers:
     1021       delete object v-bh[v-ii].
     1022     end.
     1023   end.
     1024   end procedure.
