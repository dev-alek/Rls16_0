      414   define  stream PrnLibStream.
      415   procedure prn-lib-prn-file :
      416     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      417     define input parameter p-DIsabledoptions as integer no-undo .
      418     define variable v-report-name as character no-undo .
      419     define variable v-user-action as character no-undo .
      420     define variable v-printed     as logical   no-undo .
      421     define variable v-exist       as logical   no-undo .
      422     do
      423       on error undo, return error
      424       :
      425       run prn-lib-get-report-name  in this-procedure (
      426         input parParentProc
      427         ,output v-report-name
      428         ).
      429   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      431     (input  v-report-name
      432     ,input  2
      433     ,output v-exist
      434     )  .
      435       if NOT v-exist then
      436       DO:
      437         Message
      438           "Нет заданий на печать ! "
      439           view-as alert-box .
      440         Return  .
      441       End.
      442       run gbl/prnfilen.w
      443         (input  ""
      444         ,input  p-DisabledOptions
      445         ,input  string(v-report-name )
      446         ,input  7
      447         ,output v-user-action
      448         ,output v-printed
      449         ) .
      450       if v-printed then
      451       do:
      452         return "YES" .
      453       end.
      454       else
      455       do:
      456         return "NO" .
      457       end.
      458     end.
      459   end procedure.
      460   procedure prn-lib-open-stream :
      461     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      462     define input parameter p-page-size    as integer no-undo .
      463     define input parameter p-is-stream    as logical no-undo .
      464     define input parameter p-append       as logical no-undo .
      465     define variable v-report-name as character no-undo .
      466     do
      467       on error undo, return error
      468       :
      469       run prn-lib-get-report-name  in this-procedure (
      470         input parParentProc
      471         ,output v-report-name
      472         ).
      473       if p-is-stream then
      474       do:
      475         if p-append then
      476         do:
      477           output stream PrnLibStream to value( v-report-name )
      478             page-size value(p-page-size) append .
      479         end.
      480         if not p-append then
      481         do:
      482           output stream PrnLibStream to value( v-report-name )
      483             page-size value(p-page-size) .
      484         end.
      485       end.
      486       if not p-is-stream then
      487       do:
      488         if p-append then
      489         do:
      490           output to value( v-report-name )
      491             page-size value(p-page-size) append .
      492         end.
      493         if not p-append then
      494         do:
      495           output to value( v-report-name )
      496             page-size value(p-page-size) .
      497         end.
      498       end.
      499     end.
      500   end procedure.
      501   procedure prn-lib-open-exp :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-is-stream    as logical no-undo .
      504     define input parameter p-is-append    as logical no-undo .
      505     define output parameter p-ReportFileName as char init "report" no-undo.
      506     define output parameter p-process as logical no-undo .
      507     define variable glog as logical no-undo .
      508     do
      509       on error undo, return error
      510       :
      511       SYSTEM-DIALOG GET-FILE p-ReportFileName
      512         TITLE      "Укажите путь"
      513         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      514         ASK-OVERWRITE
      515         CREATE-TEST-FILE
      516         SAVE-AS
      517         USE-FILENAME
      518         DEFAULT-EXTENSION "txt"
      519         UPDATE glog
      520         .
      521       if not glog then  return.
      522       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      523       if p-is-stream then
      524       do:
      525         if p-is-append then
      526         do:
      527           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      528         end.
      529         else
      530         do:
      531           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      532         end.
      533       end.
      534       else
      535       do:
      536         if p-is-append then
      537         do:
      538           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      539         end.
      540         else
      541         do:
      542           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      543         end.
      544       end.
      545       p-process = yes.
      546     end.
      547   end procedure.
      548   procedure prn-lib-get-report-name :
      549     define input parameter parParentProc  as widget-handle no-undo.
      550     define output parameter p-report-name as character no-undo .
      551     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      552   end procedure.
      553   procedure prn-lib-reportviewer-report-name :
