     3263         define buffer buf_reposition_temp-gds-prt for temp-gds-prt .
     3264         define variable v-reposition-rowid as rowid     no-undo .
     3265         find first buf_reposition_temp-gds-prt
     3266           where buf_reposition_temp-gds-prt.node-code = p-reposition-node-code
     3267           no-error .
     3268         if available buf_reposition_temp-gds-prt
     3269         then do:
     3270           assign
     3271             v-reposition-rowid = rowid(buf_reposition_temp-gds-prt)
     3272           .
     3273           reposition BROWSE-1 to rowid v-reposition-rowid no-error .
     3274           if error-status :error
     3275           then do:
     3276             reposition BROWSE-1 to row 1 .
     3277           end.
     3278         end.
     3279       end.
     3280     end.
     3281   END PROCEDURE.
     3282   PROCEDURE search-bar-code :
     3283     define input  parameter p-search-code  as character no-undo .
     3284     define input  parameter p-first-search as logical   no-undo .
     3285     define buffer buf_temp-gds-prt for temp-gds-prt .
     3286     define buffer buf_trn-doc  for ub.trn-doc .
     3287     define buffer buf_bar-code for ub.bar-code .
     3288     define buffer buf_goods    for ub.goods .
     3289     define variable v-b-code as integer   no-undo .
     3290     do
     3291     on error undo, return error return-value
     3292     :
     3293       find first buf_trn-doc no-lock
     3294         where buf_trn-doc.doc-code = p-doc-code
     3295         .
     3296       run gbl/getbcode.p
     3297         (input  parparentproc
     3298         ,input  p-search-code
     3299         ,input  buf_trn-doc.obj-type
     3300         ,input  buf_trn-doc.obj-code
     3301         ,input  true
     3302         ,output v-b-code
     3303         ) .
     3304       if v-b-code = ?
     3305       then do:
     3306         if p-first-search <> true
     3307         then do:
     3308           message
     3309             "Бар-код не найден !"
     3310             "Бар-код" p-search-code skip
     3311             view-as alert-box error .
     3312         end.
     3313         undo, return error return-value .
     3314       end.
     3315       find first buf_bar-code no-lock
     3316         where buf_bar-code.b-code = v-b-code
     3317         no-error .
     3318       if not available buf_bar-code
     3319       then do:
     3320         if p-first-search <> true
     3321         then do:
     3322           message
     3323             vss-workfile vss-revision vss-description skip
     3324             "Бар-код не найден !"
     3325             "Бар-код" v-b-code skip
     3326             view-as alert-box error .
     3327         end.
     3328         undo, return error return-value .
     3329       end.
     3330       if buf_bar-code.gds-code <> p-gds-code
     3331       then do:
     3332         if p-first-search <> true
     3333         then do:
     3334           find first buf_goods no-lock
     3335             where buf_goods.gds-code = buf_bar-code.gds-code
     3336             .
     3337           message
     3338             "Заданный бар-код принадлежит другому товару" skip
     3339             "В данном окне поиск работает только внутри бар-кодов одного товара"
     3340             "Бар-код" fi-search-b-code skip
     3341             "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     3342             buf_goods.gds-name skip
     3343             view-as alert-box information .
     3344         end.
     3345         undo, return error return-value .
     3346       end.
     3347       find first buf_temp-gds-prt
     3348         where buf_temp-gds-prt.node-code = buf_bar-code.node-code
     3349         no-error .
     3350       if available buf_temp-gds-prt
     3351       then do:
     3352         define variable v-curr-rowid as rowid no-undo .
     3353         assign
     3354           v-curr-rowid = rowid(temp-gds-prt)
     3355         .
     3356         reposition BROWSE-1 to rowid rowid(buf_temp-gds-prt) no-error .
     3357         if error-status :error
     3358         then do:
     3359           message
     3360             "Признак с указанным бар-кодом не показывается в заданных условиях выбора" skip
     3361             "Бар-код"  buf_temp-gds-prt.b-code        skip
     3362             "Признак"  buf_temp-gds-prt.prt-name      skip
     3363             "Свободно" buf_temp-gds-prt.prt-free-qnty skip
     3364             "Факт"     buf_temp-gds-prt.prt-fact-qnty skip
     3365             "Цена"     buf_temp-gds-prt.price-sale    skip
     3366             view-as alert-box information .
     3367           reposition BROWSE-1 to rowid v-curr-rowid no-error .
     3368           if error-status :error
     3369           then do:
     3370             reposition BROWSE-1 to row 1 .
     3371           end.
     3372         end.
     3373       end.
     3374       else do:
     3375         message
     3376           "Внутренняя ошибка - не найден указанный признак" skip
     3377           "Код товара" p-gds-code skip
     3378           "Задан бар-код" v-b-code skip
     3379           "Код признака" buf_bar-code.node-code skip
     3380           view-as alert-box error .
     3381       end.
     3382     end.
     3383   END PROCEDURE.
     3384   PROCEDURE show-alt :
     3385     define variable v-select-function as character no-undo .
     3386     define variable v-rec-list as character no-undo .
     3387     define buffer buf_trn-doc for ub.trn-doc .
     3388     do
     3389     on error undo, return error return-value
     3390     :
     3391       if available temp-gds-prt
     3392       then do:
     3393         find first buf_trn-doc no-lock
     3394           where buf_trn-doc.doc-code = p-doc-code
     3395           .
     3396         run gbl/d-list.w
     3397           (input "b-sel"
     3398           ,input "Просмотр"
     3399           ,input 'alt-current':u
     3400             + chr(44) + 'alt-all':u
     3401             + chr(44) + 'prod-all':u
     3402           ,input "Существующие неосновные цены"
     3403             + chr(44) + "Все неосновные коды"
     3404             + chr(44) + "Дополнительные коды"
     3405           ,input chr(44)
     3406           ,'':U
     3407           ,output v-select-function
     3408           ).
     3409         case v-select-function
     3410         :
     3411           when 'alt-current':u
     3412           then do:
     3413             run ref/alt-cds.w
     3414               (input  parparentproc
     3415               ,input  buf_trn-doc.obj-type
     3416               ,input  buf_trn-doc.obj-code
     3417               ,input  'code-current':u
     3418               ,input  p-gds-code
     3419               ,input  temp-gds-prt.b-code
     3420               ,output v-rec-list
     3421               ).
     3422           end.
     3423           when 'alt-all':u
     3424           then do:
     3425             run ref/alt-cds.w
     3426               (input  parparentproc
     3427               ,input  buf_trn-doc.obj-type
     3428               ,input  buf_trn-doc.obj-code
     3429               ,input  'code-all':u
     3430               ,input  p-gds-code
     3431               ,input  temp-gds-prt.b-code
     3432               ,output v-rec-list
     3433               ).
     3434           end.
     3435           when 'prod-all':u
     3436           then do:
     3437             run ref/prod-cds.w
     3438               (input  parparentproc
     3439               ,input  buf_trn-doc.obj-type
     3440               ,input  buf_trn-doc.obj-code
     3441               ,input  'code-all':u
     3442               ,input  p-gds-code
     3443               ,input  temp-gds-prt.b-code
     3444               ,output v-rec-list
     3445               ).
     3446           end.
     3447         end case.
     3448       end.
     3449     end.
     3450   END PROCEDURE.
     3451   PROCEDURE show-codes :
     3452     if available temp-gds-prt
     3453     then do:
     3454       run ref/alt-bc.w
     3455         (input parparentproc
     3456         ,input v-obj-type
     3457         ,input v-obj-code
     3458         ,input temp-gds-prt.b-code
     3459         ).
     3460     end.
     3461   END PROCEDURE.
     3462   PROCEDURE show-gds-arch :
     3463     define buffer buf_trn-doc for ub.trn-doc .
     3464     do
     3465     on error undo, return error return-value
     3466     :
     3467       find first buf_trn-doc no-lock
     3468         where buf_trn-doc.doc-code = p-doc-code
     3469         .
     3470       run gbl/shgdsarh.p
     3471         (INPUT PARPARENTPROC
     3472         ,input p-gds-code
     3473         ,input buf_trn-doc.obj-type
     3474         ,input buf_trn-doc.obj-code
     3475         ) .
     3476     end.
     3477   END PROCEDURE.
     3478   PROCEDURE show-input-info :
     3479     do with frame Dialog-Frame:
     3480       define buffer buf_goods for ub.goods .
     3481       define buffer buf_trn-doc for ub.trn-doc .
     3482       find first buf_goods no-lock
     3483         where buf_goods.gds-code = p-gds-code
     3484         no-error .
     3485       find first buf_trn-doc no-lock
     3486         where buf_trn-doc.doc-code = p-doc-code
     3487         no-error .
     3488       if  available buf_goods
     3489       and available buf_trn-doc
     3490       then do:
     3491         assign
     3492           fi-gds :screen-value = substitute("&1 &2 &3 &4"
     3493                                           ,buf_goods.artic
     3494                                           ,buf_goods.prod-type
     3495                                           ,buf_goods.prod-code
     3496                                           ,buf_goods.gds-name
     3497                                           )
     3498         .
     3499         assign
     3500           frame Dialog-Frame :title = substitute("Редактирование признаков. Документ &1. Товар &1 &2 &3 &4"
     3501                                                   ,buf_trn-doc.doc-code
     3502                                                   ,buf_goods.artic
     3503                                                   ,buf_goods.prod-type
     3504                                                   ,buf_goods.prod-code
     3505                                                   ,buf_goods.gds-name
     3506                                                   )
     3507         .
     3508       end.
     3509       else do:
     3510         assign
     3511           fi-gds :screen-value = ''
     3512         .
     3513         assign
     3514           frame Dialog-Frame :title = "Редактирование признаков"
     3515         .
     3516       end.
     3517       define buffer buf_clients for ub.clients .
     3518       find first buf_clients no-lock
     3519         where buf_clients.obj-type = buf_trn-doc.obj-type
     3520           and buf_clients.obj-code = buf_trn-doc.obj-code
     3521         no-error .
     3522       if available buf_clients
     3523       then do:
     3524         assign
     3525           fi-obj :screen-value = substitute('&1 &2 &3'
     3526                                   ,buf_clients.obj-type
     3527                                   ,buf_clients.obj-code
     3528                                   ,buf_clients.obj-name
     3529                                   )
     3530         .
     3531       end.
     3532     end.
     3533   END PROCEDURE.
     3534   PROCEDURE show-rest :
     3535     define buffer buf_trn-doc for ub.trn-doc .
     3536     do
     3537     on error undo, return error return-value
     3538     :
     3539       if available temp-gds-prt
     3540       then do:
     3541         find first buf_trn-doc no-lock
     3542           where buf_trn-doc.doc-code = p-doc-code
     3543           .
     3544         define variable v-host-code as integer   no-undo .
     3545   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3547     (input  buf_trn-doc.obj-type
     3548     ,input  buf_trn-doc.obj-code
     3549     ,output v-host-code
     3550     )  .
     3551         define buffer buf_goods for ub.goods .
     3552         find first buf_goods no-lock
     3553           where buf_goods.gds-code = p-gds-code
     3554           .
     3555         run rep/gds-objs.w
     3556           (input  parparentproc
     3557           ,input  buf_goods.artic
     3558           ,input  buf_goods.prod-type
     3559           ,input  buf_goods.prod-code
     3560           ,input  v-host-code
     3561           ,input  temp-gds-prt.node-code
     3562           ).
     3563       end.
     3564     end.
     3565   END PROCEDURE.
     3566   PROCEDURE show-scale :
     3567     define variable v-root-node as character no-undo .
     3568   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
     3570     (input  p-gds-code
     3571     ,output v-root-node
     3572     )  .
     3573     run str/showprop.w
     3574       (input v-root-node
     3575       ) .
     3576   END PROCEDURE.
     3577   PROCEDURE translate-filter :
     3578     define input  parameter p-filter-int  as integer   no-undo .
     3579     define output parameter p-filter-mode as character no-undo .
     3580     case p-filter-int :
     3581       when 1 then do:
     3582         assign
     3583           p-filter-mode = 'filter-b-code':u
     3584         .
     3585       end.
     3586       when 2 then do:
     3587         assign
     3588           p-filter-mode = 'filter-prt-obj':u
     3589         .
     3590       end.
     3591       when 3 then do:
     3592         assign
     3593           p-filter-mode = 'filter-not-zero':u
     3594         .
     3595       end.
     3596       when 4 then do:
     3597         assign
     3598           p-filter-mode = 'filter-doc':u
     3599         .
     3600       end.
     3601       otherwise do:
     3602         message
     3603           vss-workfile vss-revision vss-description skip
     3604           "Неизвестное значение параметра фильтрации" skip
     3605           "Параметр фильтрации" p-filter-int skip
     3606           view-as alert-box error .
     3607         undo, return error return-value .
     3608       end.
     3609     end case .
     3610   END PROCEDURE.
     3611   PROCEDURE translate-sort :
     3612     define input  parameter p-sort-int  as integer   no-undo .
     3613     define output parameter p-sort-mode as character no-undo .
     3614     case p-sort-int :
     3615       when 1 then do:
     3616         assign
     3617           p-sort-mode = 'sort-b-code':u
     3618         .
     3619       end.
     3620       when 2 then do:
     3621         assign
     3622           p-sort-mode = 'sort-sort-code':u
     3623         .
     3624       end.
     3625       when 3 then do:
     3626         assign
     3627           p-sort-mode = 'sort-tree':u
     3628         .
     3629       end.
     3630       otherwise do:
     3631         message
     3632           vss-workfile vss-revision vss-description skip
     3633           "Неизвестное значение параметра сортировки" skip
     3634           "Параметр сортировки" p-sort-int skip
     3635           view-as alert-box error .
     3636         undo, return error return-value .
     3637       end.
     3638     end case .
     3639   END PROCEDURE.
     3640   PROCEDURE tune-interface :
     3641     do
     3642     on error undo, return error return-value
     3643     :
     3644       do with frame Dialog-Frame:
     3645         if p-mode = 'ПРОСМОТР':U
     3646         then do:
     3647           assign
     3648             b-qnty :label = "Пр&осмотр"
     3649           .
     3650         end.
     3651         else do:
     3652           assign
     3653             b-qnty :label = "&Изменить"
     3654           .
     3655         end.
     3656         apply 'entry':u to browse BROWSE-1 .
     3657       end.
     3658     end.
     3659   END PROCEDURE.
     3660   PROCEDURE validate-input-parameters :
     3661     define buffer buf_goods   for ub.goods .
     3662     define buffer buf_trn-doc for ub.trn-doc .
     3663     define buffer buf_gds-dtl for ub.gds-dtl .
     3664     do
     3665     on error undo, return error return-value
     3666     :
     3667       find first buf_trn-doc no-lock
     3668         where buf_trn-doc.doc-code = p-doc-code
     3669         no-error .
     3670       if not available buf_trn-doc
     3671       then do:
     3672         message
     3673           vss-workfile vss-revision vss-description skip
     3674           "Ошибка задания входных параметров" skip
     3675           "Не найден документ" skip
     3676           "Режим" p-mode skip
     3677           "Документ" p-doc-code skip
     3678           "Код товара" p-gds-code skip
     3679           "Редактирование количеств по документу" p-update-doc skip
     3680           view-as alert-box error .
     3681         undo, return error return-value .
     3682       end.
     3683       find first buf_goods no-lock
     3684         where buf_goods.gds-code = p-gds-code
     3685         no-error .
     3686       if not available buf_goods
     3687       then do:
     3688         message
     3689           vss-workfile vss-revision vss-description skip
     3690           "Ошибка задания входных параметров" skip
     3691           "Не найден товар" skip
     3692           "Режим" p-mode skip
     3693           "Документ" p-doc-code skip
     3694           "Код товара" p-gds-code skip
     3695           "Редактирование количеств по документу" p-update-doc skip
     3696           view-as alert-box error .
     3697         undo, return error return-value .
     3698       end.
     3699       define variable v-valid-obj as logical   no-undo .
     3700   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3702     (input  buf_trn-doc.obj-type
     3703     ,input  buf_trn-doc.obj-code
     3704     ,input  'check-exist':u
     3705     ,output v-valid-obj
     3706     ) no-error .
     3707       if error-status :error
     3708       then do:
     3709         message
     3710           vss-workfile vss-revision vss-description skip
     3711           "Ошибка задания входных параметров" skip
     3712           "Не найден объект" skip
     3713           "Режим" p-mode skip
     3714           "Документ" p-doc-code skip
     3715           "Код товара" p-gds-code skip
     3716           "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
     3717           "Редактирование количеств по документу" p-update-doc skip
     3718           view-as alert-box error .
     3719         undo, return error return-value .
     3720       end.
     3721       if lookup(p-mode, 'ПРОСМОТР':U + chr(44) + 'ШКАЛА':U) = 0
     3722       then do:
     3723         message
     3724           vss-workfile vss-revision vss-description skip
     3725           "Ошибка задания входных параметров" skip
     3726           "Неизвестный режим" skip
     3727           "Режим" p-mode skip
     3728           "Документ" p-doc-code skip
     3729           "Код товара" p-gds-code skip
     3730           "Редактирование количеств по документу" p-update-doc skip
     3731           view-as alert-box error .
     3732         undo, return error return-value .
     3733       end.
     3734       if p-update-doc = ?
     3735       then do:
     3736         message
     3737           vss-workfile vss-revision vss-description skip
     3738           "Ошибка задания входных параметров" skip
     3739           "Неизвестное значение признака Редактирование количеств по документу" skip
     3740           "Режим" p-mode skip
     3741           "Документ" p-doc-code skip
     3742           "Код товара" p-gds-code skip
     3743           "Редактирование количеств по документу" p-update-doc skip
     3744           view-as alert-box error .
     3745         undo, return error return-value .
     3746       end.
     3747     end.
     3748   END PROCEDURE.
     3749   FUNCTION get-prt-name RETURNS CHARACTER
     3750     ( BUFFER buf_temp-gds-prt FOR temp-gds-prt ) :
     3751     define variable v-return-prt-name as character no-undo .
     3752     if v-sort-mode = 'sort-tree':u
     3753     then do:
     3754       assign
     3755         v-return-prt-name = fill(" ", 2 * (buf_temp-gds-prt.prt-level - 1) )+ buf_temp-gds-prt.node-name
     3756       .
     3757     end.
     3758     else do:
     3759       assign
     3760         v-return-prt-name = buf_temp-gds-prt.prt-name
     3761       .
     3762     end.
     3763     RETURN v-return-prt-name.
     3764   END FUNCTION.
