     3199   PROCEDURE print-temp-gds-prt :
     3200     define variable v-curr-rowid as rowid no-undo .
     3201     assign
     3202       v-curr-rowid = rowid(temp-gds-prt)
     3203     .
     3204     run str/prtdcxls.p
     3205       (input this-procedure :handle
     3206       ,input frame Dialog-Frame :title
     3207       ,input "Сортировка/Вид"
     3208       ,input radio-label(string(RADIO-SET-sort),   RADIO-SET-sort   :radio-buttons)
     3209       ,input "Фильтр"
     3210       ,input radio-label(string(RADIO-SET-filter), RADIO-SET-filter :radio-buttons)
     3211       ) .
     3212     reposition BROWSE-1 to rowid v-curr-rowid no-error .
     3213     if error-status :error
     3214     then do:
     3215       reposition BROWSE-1 to row 1 .
     3216     end.
     3217   END PROCEDURE.
     3218   PROCEDURE prt-doc_get-current :
     3219     define output parameter p-available     as logical   no-undo .
     3220     define output parameter p-b-code        as integer   no-undo .
     3221     define output parameter p-prt-name      as character no-undo .
     3222     define output parameter p-doc-qnty      as decimal   no-undo .
     3223     define output parameter p-fact-qnty     as decimal   no-undo .
     3224     define output parameter p-prt-free-qnty as decimal   no-undo .
     3225     define output parameter p-prt-fact-qnty as decimal   no-undo .
     3226     define output parameter p-price-base    as decimal   no-undo .
     3227     define output parameter p-price-rubl    as decimal   no-undo .
     3228     define output parameter p-price-sale    as decimal   no-undo .
     3229     if available temp-gds-prt
     3230     then do:
     3231       assign
     3232         p-available     = true
     3233         p-b-code        = temp-gds-prt.b-code
     3234         p-prt-name      = get-prt-name(buffer temp-gds-prt)
     3235         p-doc-qnty      = temp-gds-prt.doc-qnty
     3236         p-fact-qnty     = temp-gds-prt.fact-qnty
     3237         p-prt-free-qnty = temp-gds-prt.prt-free-qnty
     3238         p-prt-fact-qnty = temp-gds-prt.prt-fact-qnty
     3239         p-price-base    = temp-gds-prt.price-base
     3240         p-price-rubl    = temp-gds-prt.price-rubl
     3241         p-price-sale    = temp-gds-prt.price-sale
     3242       .
     3243     end.
     3244     else do:
     3245       assign
     3246         p-available = false
     3247       .
     3248     end.
     3249   END PROCEDURE.
     3250   PROCEDURE prt-doc_get-first :
     3251     apply "home":u to browse BROWSE-1 .
     3252   END PROCEDURE.
     3253   PROCEDURE prt-doc_get-next :
     3254     get next BROWSE-1 .
     3255   END PROCEDURE.
     3256   PROCEDURE reposition-query :
     3257     define input  parameter p-reposition-node-code as integer   no-undo .
     3258     do
     3259     on error undo, return error return-value
     3260     :
     3261       if p-reposition-node-code <> ?
