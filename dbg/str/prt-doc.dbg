     1073   ON RETURN OF fi-search-b-code IN FRAME Dialog-Frame
     1074   DO:
     1075     define variable v-find-next as logical   no-undo .
     1076     if fi-search-b-code <> input frame Dialog-Frame fi-search-b-code then do:
     1077       assign
     1078         v-find-next = false
     1079       .
     1080     end.
     1081     else do:
     1082       assign
     1083         v-find-next = true
     1084       .
     1085     end.
     1086     do with frame Dialog-Frame:
     1087       assign
     1088         fi-search-b-code
     1089       .
     1090     end.
     1091     run search-bar-code in this-procedure
     1092       (input fi-search-b-code
     1093       ,input false
     1094       ) .
     1095   END.
     1096   ON VALUE-CHANGED OF RADIO-SET-filter IN FRAME Dialog-Frame
     1097   DO:
     1098   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   if lookup(self :type
     1100            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1101            ) = 0
     1102   then do:
     1103     message
     1104       "$Workfile$"
     1105       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1106       "Интерфейсный элемент" self :name  skip
     1107       "Тип" self :type  skip
     1108       "Процедура" this-procedure :file-name skip
     1109       view-as alert-box .
     1110   end.
     1111   else do:
     1112     apply "entry":u to self  .
     1113     if focus :handle <> self :handle  then do:
     1114       return no-apply .
     1115     end.
     1116   end.
     1117     assign
     1118       radio-set-filter
     1119       .
     1120     define variable v-reposition-node-code as integer   no-undo .
     1121     if available temp-gds-prt
     1122     then do:
     1123       assign
     1124         v-reposition-node-code = temp-gds-prt.node-code
     1125       .
     1126     end.
     1127     else do:
     1128       assign
     1129         v-reposition-node-code = ?
     1130       .
     1131     end.
     1132     run translate-filter in this-procedure
     1133       (input  radio-set-filter
     1134       ,output v-filter-mode
     1135       ) .
     1136     run local-open-query in this-procedure
     1137       (input v-reposition-node-code
     1138       ) .
