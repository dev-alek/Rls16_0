      875     define variable v-create-bar-code as integer   no-undo .
      876     define variable v-is-new          as logical   no-undo .
      877     define buffer buf_bar-code for ub.bar-code .
      878     define variable v-reposition-node-code as integer   no-undo .
      879     if available temp-gds-prt
      880     then do:
      881       assign
      882         v-reposition-node-code = temp-gds-prt.node-code
      883       .
      884     end.
      885     else do:
      886       assign
      887         v-reposition-node-code = ?
      888       .
      889     end.
      890     run str/crebcprt.w
      891       (input  parparentproc
      892       ,input  p-gds-code
      893       ,input  false
      894       ,output v-create-bar-code
      895       ,output v-is-new
      896       ) .
      897     if v-is-new = true
      898     then do:
      899       assign
      900         v-need-refresh = true
      901       .
      902     end.
      903     find first buf_bar-code no-lock
      904       where buf_bar-code.b-code = v-create-bar-code
      905       no-error .
      906     if available buf_bar-code
      907     then do:
      908       assign
      909         v-reposition-node-code = buf_bar-code.node-code
      910       .
      911     end.
      912     run local-open-query in this-procedure
      913       (input v-reposition-node-code
      914       ) .
      915   END.
