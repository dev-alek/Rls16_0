     1184   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1185   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1186   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   on help of frame Dialog-Frame
     1188   do:
     1189     run gbl/app_help.p
     1190       (input this-procedure :file-name
     1191       ,input ''
     1192       ,input ?
     1193       ) no-error.
     1194     if error-status :error then do:
     1195       message
     1196         "Ошибка при вызове помощи"
     1197         error-status :get-message(1)
     1198         view-as alert-box .
     1199     end.
     1200   end.
     1201   run minbtn-set in this-procedure .
     1202   on choose of b-help in frame Dialog-Frame
     1203   do:
     1204     apply "help":u to frame Dialog-Frame .
     1205   end.
     1206   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   procedure minbtn-set :
     1208       do
     1209           on error undo, return error return-value
     1210           :
     1211           define variable ii              as integer       no-undo .
     1212           define variable fh              as widget-handle no-undo .
     1213           define variable hh              as widget-handle no-undo .
     1214           define variable v-h             as handle        extent 4 no-undo .
     1215           define variable v-name-button   as character     no-undo .
     1216           define variable v-help-old-x    as decimal       no-undo .
     1217           define variable v-help-old-y    as decimal       no-undo .
     1218           define variable v-help-old-size as decimal       no-undo .
     1219           define variable v-frame-width   as decimal       no-undo .
     1220           define variable jj              as integer       no-undo .
     1221           do
     1222               on error undo, return error
     1223               :
     1224               assign
     1225                   v-frame-width = frame Dialog-Frame:width - 0.3
     1226                   fh            = frame Dialog-Frame:first-child
     1227                   hh            = fh:first-child
     1228                   ii            = 1
     1229                   .
     1230               do while valid-handle(hh):
     1231                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1232                   do:
     1233                       case lc(hh:name) :
     1234                           when "b-help" then
     1235                               do:
     1236                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1237                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1238                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1239                                   hh:TOOLTIP = "Помощь" .
     1240                                   v-help-old-x = hh:column .
     1241                                   v-help-old-y = hh:row    .
     1242                                   v-help-old-size = hh:width .
     1243                                   hh:width-chars = 2.5 .
     1244                               end.
     1245                           when "b-print" then
     1246                               do:
     1247                                   hh:load-image("cmp/b-print.bmp":u) .
     1248                                   hh:TOOLTIP = "Печать" .
     1249                                   v-h[ii] = hh:handle .
     1250                                   ii = ii + 1 .
     1251                                   hh:width-chars = 3 .
     1252                               end.
     1253                           when "b-history" or
     1254                           when "b-hist" then
     1255                               do:
     1256                                   hh:load-image("cmp/b-hist.bmp":u) .
     1257                                   hh:TOOLTIP = "История" .
     1258                                   v-h[ii] = hh:handle .
     1259                                   ii = ii + 1 .
     1260                                   hh:width-chars = 3 .
     1261                               end.
     1262                           when "b-sch" then
     1263                               do:
     1264                                   hh:load-image("cmp/b-sch.bmp":u) .
     1265                                   hh:TOOLTIP = "Установка Фильтра" .
     1266                                   v-h[ii] = hh:handle .
     1267                                   ii = ii + 1 .
     1268                                   hh:width-chars = 3 .
     1269                               end.
     1270                           when "b-hist-user" then
     1271                               do:
     1272                                   hh:load-image("cmp/b-hist.bmp":u) .
     1273                                   hh:TOOLTIP = "История пользователя" .
     1274                                   ii = ii + 1 .
     1275                               end.
     1276                       end case.
     1277                   end.
     1278                   hh = hh:next-sibling.
     1279               end.
     1280               b-help:column = v-frame-width - b-help:width-chars.
     1281               jj = 0.
     1282               repeat ii = 4 to 1 by -1 :
     1283                   if valid-handle (v-h[ii] ) then
     1284                   do:
     1285                       jj  = jj + 1 .
     1286                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1287                       v-h[ii]:row    = v-help-old-y .
     1288                   end.
     1289               end.
     1290           end.
     1291       end.
     1292   end procedure.
     1293   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1294   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1295   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1296   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1297   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1298   define variable v-diasize-current-frame-height as decimal   no-undo .
     1299   define variable v-diasize-change-size          as logical   no-undo .
     1300   define variable v-diasize-resize-button        as handle    no-undo .
     1301   define variable v-diasize-wndmax               as logical   no-undo .
     1302   define variable v-diasize-wndstore             as logical   no-undo .
     1303   define variable v-diasize-proc-name            as character no-undo .
     1304   define variable v-diasize-browse-handle        as handle    no-undo .
     1305   define variable v-diasize-browse-number        as integer   no-undo .
     1306   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1307   define temp-table temp-diasize-handle no-undo
     1308     field handle-value  as handle
     1309     field save-position as decimal
     1310     index xpk is primary unique handle-value
     1311     .
     1312   define temp-table temp-browse-handle no-undo
     1313     field browse-type   as character
     1314     field browse-number as integer
     1315     field browse-handle as handle
     1316     field original-size as decimal
     1317     index xpk is primary unique browse-type browse-number
     1318     index xie browse-type browse-handle
     1319   .
     1320   procedure diasize_change-height :
     1321     define input  parameter p-change-value  as decimal   no-undo .
     1322     define input  parameter p-move-resize   as logical   no-undo .
     1323     define variable v-field-group-handle    as handle    no-undo .
     1324     define variable v-object-handle         as handle    no-undo .
     1325     define variable v-frame-height          as decimal   no-undo .
     1326     define variable v-frame-virtual-height  as decimal   no-undo .
     1327     define variable v-browse-height         as decimal   no-undo .
     1328     define variable v-window-height         as decimal   no-undo .
     1329     define variable v-window-virtual-height as decimal   no-undo .
     1330     define variable v-change-sign           as integer   no-undo .
     1331     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1332     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1333     if p-change-value > 0
     1334     then do:
     1335       if frame Dialog-Frame :height + p-change-value
     1336           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1337       then do:
     1338         assign
     1339           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1340                           - (frame Dialog-Frame :height-chars)
     1341         .
     1342         if p-change-value <= 0
     1343         then do:
     1344           run diasize_position-resize-button in this-procedure .
     1345           return .
     1346         end.
     1347       end.
     1348     end.
     1349     if p-change-value < 0
     1350     then do:
     1351       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1352       then do:
     1353         assign
     1354           p-change-value = v-diasize-orig-frame-height
     1355                          - (frame Dialog-Frame :height-chars)
     1356         .
     1357         if p-change-value >= 0
     1358         then do:
     1359           run diasize_position-resize-button in this-procedure .
     1360           return .
     1361         end.
     1362       end.
     1363     end.
     1364     if p-change-value >= 0
     1365     then do:
     1366       assign
     1367         v-change-sign = 1
     1368       .
     1369     end.
     1370     else do:
     1371       assign
     1372         v-change-sign = -1
     1373       .
     1374     end.
     1375     assign
     1376       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1377     .
     1378     if p-change-value = 0
     1379     then do:
     1380       run diasize_position-resize-button in this-procedure .
     1381       return .
     1382     end.
     1383     move_block:
     1384     do
     1385     on error undo move_block, retry move_block
     1386     :
     1387       if retry
     1388       then do:
     1389         do
     1390         on error undo move_block, leave move_block
     1391         :
     1392           if p-change-value > 0
     1393           then do:
     1394             for each buf_temp-diasize-handle
     1395             on error undo, next
     1396             :
     1397               assign
     1398                 v-object-handle = buf_temp-diasize-handle.handle-value
     1399               .
     1400               if v-object-handle <> v-diasize-resize-button
     1401               then do:
     1402                 assign
     1403                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1404                 .
     1405               end.
     1406             end.
     1407             assign
     1408               v-diasize-browse-handle :height = v-browse-height
     1409             .
     1410             for each buf_temp-browse-handle
     1411               where buf_temp-browse-handle.browse-type = 'height':u
     1412             on error undo, next
     1413             :
     1414               assign
     1415                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1416               .
     1417             end.
     1418             assign
     1419               frame Dialog-Frame :height = v-frame-height
     1420             .
     1421             if frame Dialog-Frame :scrollable = true
     1422             then do:
     1423               assign
     1424                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1425               .
     1426             end.
     1427             run diasize_position-resize-button in this-procedure .
     1428           end.
     1429           else do:
     1430             if frame Dialog-Frame :scrollable = true
     1431             then do:
     1432               assign
     1433                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1434               .
     1435             end.
     1436             assign
     1437               frame Dialog-Frame :height = v-frame-height
     1438             .
     1439             assign
     1440               v-diasize-browse-handle :height = v-browse-height
     1441             .
     1442             for each buf_temp-browse-handle
     1443               where buf_temp-browse-handle.browse-type = 'height':u
     1444             on error undo, next
     1445             :
     1446               assign
     1447                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1448               .
     1449             end.
     1450             for each buf_temp-diasize-handle
     1451             on error undo, next
     1452             :
     1453               assign
     1454                 v-object-handle = buf_temp-diasize-handle.handle-value
     1455               .
     1456               if v-object-handle <> v-diasize-resize-button
     1457               then do:
     1458                 assign
     1459                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1460                 .
     1461               end.
     1462             end.
     1463             run diasize_position-resize-button in this-procedure .
     1464           end.
     1465           assign
     1466             v-diasize-change-size = false
     1467           .
     1468           leave move_block .
     1469         end.
     1470       end.
     1471       assign
     1472         v-diasize-need-full-display = true
     1473       .
     1474       if v-diasize-change-size = false
     1475       then do:
     1476         assign
     1477           v-diasize-change-size = true
     1478         .
     1479       end.
     1480       else do:
     1481         return .
     1482       end.
     1483       assign
     1484         v-frame-height = frame Dialog-Frame :height
     1485         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1486         v-browse-height = v-diasize-browse-handle :height
     1487       .
     1488       for each buf_temp-browse-handle
     1489         where buf_temp-browse-handle.browse-type = 'height':u
     1490       :
     1491         assign
     1492           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1493         .
     1494       end.
     1495       for each buf_temp-diasize-handle
     1496       :
     1497         delete buf_temp-diasize-handle .
     1498       end.
     1499       assign
     1500         v-field-group-handle = frame Dialog-Frame :first-child
     1501       .
     1502       do while valid-handle(v-field-group-handle)
     1503       :
     1504         assign
     1505           v-object-handle = v-field-group-handle :first-child
     1506         .
     1507         do while valid-handle(v-object-handle)
     1508         :
     1509           if  v-object-handle <> v-diasize-browse-handle :handle
     1510           and can-query(v-object-handle, "row")
     1511           and can-query(v-object-handle, "height")
     1512           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1513           then do:
     1514             find first buf_temp-browse-handle
     1515               where buf_temp-browse-handle.browse-type   = 'height':u
     1516                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1517               no-error .
     1518             if available buf_temp-browse-handle
     1519             then do:
     1520             end.
     1521             else do:
     1522               create buf_temp-diasize-handle .
     1523               assign
     1524                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1525                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1526               .
     1527             end.
     1528           end.
     1529           assign
     1530             v-object-handle = v-object-handle :next-sibling
     1531           .
     1532         end.
     1533         assign
     1534           v-field-group-handle = v-field-group-handle :next-sibling
     1535         .
     1536       end.
     1537       do with frame Dialog-Frame
     1538       :
     1539         hide v-diasize-resize-button .
     1540         assign
     1541           v-diasize-resize-button :row    = 1
     1542           v-diasize-resize-button :column = 1
     1543         .
     1544       end.
     1545       if p-change-value > 0
     1546       then do:
     1547         if frame Dialog-Frame :scrollable = true
     1548         then do:
     1549           assign
     1550             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1551             no-error .
     1552           if error-status :error
     1553           or error-status :get-message(1) <> ""
     1554           then do:
     1555             undo move_block, retry move_block .
     1556           end.
     1557         end.
     1558         assign
     1559           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1560           no-error .
     1561         if error-status :error
     1562         or error-status :get-message(1) <> ""
     1563         then do:
     1564           undo move_block, retry move_block .
     1565         end.
     1566         assign
     1567           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1568           no-error .
     1569         if error-status :error
     1570         or error-status :get-message(1) <> ""
     1571         then do:
     1572           undo move_block, retry move_block .
     1573         end.
     1574         for each buf_temp-browse-handle
     1575           where buf_temp-browse-handle.browse-type = 'height':u
     1576         on error undo move_block, retry move_block
     1577         :
     1578           assign
     1579             buf_temp-browse-handle.browse-handle :height
     1580               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1581             no-error .
     1582           if error-status :error
     1583           or error-status :get-message(1) <> ""
     1584           then do:
     1585             undo move_block, retry move_block .
     1586           end.
     1587         end.
     1588         for each buf_temp-diasize-handle
     1589         on error undo move_block, retry move_block
     1590         :
     1591           assign
     1592             v-object-handle = buf_temp-diasize-handle.handle-value
     1593           .
     1594           if v-object-handle <> v-diasize-resize-button
     1595           then do:
     1596             assign
     1597               v-object-handle :row = v-object-handle :row + p-change-value
     1598               no-error .
     1599             if error-status :error
     1600             or error-status :get-message(1) <> ""
     1601             then do:
     1602               undo move_block, retry move_block .
     1603             end.
     1604           end.
     1605         end.
     1606       end.
     1607       else do:
     1608         for each buf_temp-diasize-handle
     1609         on error undo move_block, retry move_block
     1610         :
     1611           assign
     1612             v-object-handle = buf_temp-diasize-handle.handle-value
     1613           .
     1614           if v-object-handle <> v-diasize-resize-button
     1615           then do:
     1616             assign
     1617               v-object-handle :row = v-object-handle :row + p-change-value
     1618               no-error .
     1619             if error-status :error
     1620             or error-status :get-message(1) <> ""
     1621             then do:
     1622               undo move_block, retry move_block .
     1623             end.
     1624           end.
     1625         end.
     1626         assign
     1627           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1628           no-error .
     1629         if error-status :error
     1630         or error-status :get-message(1) <> ""
     1631         then do:
     1632           undo move_block, retry move_block .
     1633         end.
     1634         for each buf_temp-browse-handle
     1635           where buf_temp-browse-handle.browse-type = 'height':u
     1636         on error undo move_block, retry move_block
     1637         :
     1638           assign
     1639             buf_temp-browse-handle.browse-handle :height
     1640               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1641             no-error .
     1642           if error-status :error
     1643           or error-status :get-message(1) <> ""
     1644           then do:
     1645             undo move_block, retry move_block .
     1646           end.
     1647         end.
     1648         assign
     1649           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1650           no-error .
     1651         if error-status :error
     1652         or error-status :get-message(1) <> ""
     1653         then do:
     1654           undo move_block, retry move_block .
     1655         end.
     1656         if frame Dialog-Frame :scrollable = true
     1657         then do:
     1658           assign
     1659             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1660             no-error .
     1661           if error-status :error
     1662           or error-status :get-message(1) <> ""
     1663           then do:
     1664             undo move_block, retry move_block .
     1665           end.
     1666         end.
     1667       end.
     1668       if p-move-resize = true
     1669       then do:
     1670         run diasize_position-resize-button in this-procedure .
     1671       end.
     1672       if v-diasize-wndstore = true
     1673       then do:
     1674         if connected("ub") = true
     1675         then do:
     1676           define variable v-cntxt-db-num        as integer   no-undo .
     1677           define variable v-cntxt-userid        as character no-undo .
     1678           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1679                                             , OUTPUT v-cntxt-userid
     1680                                             ) .
     1681           run gbl/wndsizew.p
     1682             (input  v-cntxt-db-num
     1683             ,input  v-cntxt-userid
     1684             ,input  v-diasize-proc-name
     1685             ,input  'height':u
     1686             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1687             ) .
     1688         end.
     1689       end.
     1690     end.
     1691     assign
     1692       v-diasize-change-size = false
     1693     .
     1694   end procedure.
     1695   procedure diasize_set-height :
     1696     define input  parameter p-new-height  as decimal   no-undo .
     1697     define input  parameter p-move-resize as logical   no-undo .
     1698     do
     1699     on error undo, return error return-value
     1700     :
     1701       run diasize_change-height in this-procedure
     1702         (input  (p-new-height - frame Dialog-Frame :height)
     1703         ,input  p-move-resize
     1704         ) .
     1705     end.
     1706   end procedure.
     1707   procedure diasize_change-width :
     1708     define input  parameter p-change-value as decimal   no-undo .
     1709     define input  parameter p-move-resize  as logical   no-undo .
     1710     define variable v-field-group-handle   as handle    no-undo .
     1711     define variable v-object-handle        as handle    no-undo .
     1712     define variable v-frame-width          as decimal   no-undo .
     1713     define variable v-frame-virtual-width  as decimal   no-undo .
     1714     define variable v-browse-width         as decimal   no-undo .
     1715     define variable v-window-width         as decimal   no-undo .
     1716     define variable v-window-virtual-width as decimal   no-undo .
     1717     define variable v-change-sign          as integer   no-undo .
     1718     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1719     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1720     if p-change-value > 0
     1721     then do:
     1722       if frame Dialog-Frame :width + p-change-value >
     1723           session :width-chars
     1724       then do:
     1725         assign
     1726           p-change-value = session :width-chars - frame Dialog-Frame :width
     1727         .
     1728         if p-change-value <= 0
     1729         then do:
     1730           run diasize_position-resize-button in this-procedure .
     1731           return .
     1732         end.
     1733       end.
     1734     end.
     1735     if p-change-value < 0
     1736     then do:
     1737       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1738       then do:
     1739         assign
     1740           p-change-value = v-diasize-orig-frame-width
     1741                          - frame Dialog-Frame :width
     1742         .
     1743         if p-change-value >= 0
     1744         then do:
     1745           run diasize_position-resize-button in this-procedure .
     1746           return .
     1747         end.
     1748       end.
     1749     end.
     1750     if p-change-value >= 0
     1751     then do:
     1752       assign
     1753         v-change-sign = 1
     1754       .
     1755     end.
     1756     else do:
     1757       assign
     1758         v-change-sign = -1
     1759       .
     1760     end.
     1761     assign
     1762       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1763     .
     1764     if p-change-value = 0
     1765     then do:
     1766       run diasize_position-resize-button in this-procedure .
     1767       return .
     1768     end.
     1769     move_block:
     1770     do
     1771     on error undo move_block, leave move_block
     1772     :
     1773       if retry
     1774       then do:
     1775         do
     1776         on error undo move_block, leave move_block
     1777         :
     1778           if p-change-value > 0
     1779           then do:
     1780             for each buf_temp-diasize-handle
     1781             on error undo, next
     1782             :
     1783               assign
     1784                 v-object-handle = buf_temp-diasize-handle.handle-value
     1785               .
     1786               if v-object-handle <> v-diasize-resize-button
     1787               then do:
     1788                 assign
     1789                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1790                 .
     1791               end.
     1792             end.
     1793             assign
     1794               v-diasize-browse-handle :width = v-browse-width
     1795             .
     1796             for each buf_temp-browse-handle
     1797               where buf_temp-browse-handle.browse-type = 'width':u
     1798             on error undo, next
     1799             :
     1800               assign
     1801                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1802               .
     1803             end.
     1804             assign
     1805               frame Dialog-Frame :width = v-frame-width
     1806             .
     1807             if frame Dialog-Frame :scrollable = true
     1808             then do:
     1809               assign
     1810                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1811               .
     1812             end.
     1813             run diasize_position-resize-button in this-procedure .
     1814           end.
     1815           else do:
     1816             if frame Dialog-Frame :scrollable = true
     1817             then do:
     1818               assign
     1819                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1820               .
     1821             end.
     1822             assign
     1823               frame Dialog-Frame :width = v-frame-width
     1824             .
     1825             for each buf_temp-browse-handle
     1826               where buf_temp-browse-handle.browse-type = 'width':u
     1827             on error undo, next
     1828             :
     1829               assign
     1830                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1831               .
     1832             end.
     1833             assign
     1834               v-diasize-browse-handle :width = v-browse-width
     1835             .
     1836             for each buf_temp-diasize-handle
     1837             on error undo, next
     1838             :
     1839               assign
     1840                 v-object-handle = buf_temp-diasize-handle.handle-value
     1841               .
     1842               if v-object-handle <> v-diasize-resize-button
     1843               then do:
     1844                 assign
     1845                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1846                 .
     1847               end.
     1848             end.
     1849             run diasize_position-resize-button in this-procedure .
     1850           end.
     1851           assign
     1852             v-diasize-change-size = false
     1853           .
     1854           leave move_block .
     1855         end.
     1856       end.
     1857       assign
     1858         v-diasize-need-full-display = true
     1859       .
     1860       if v-diasize-change-size = false
     1861       then do:
     1862         assign
     1863           v-diasize-change-size = true
     1864         .
     1865       end.
     1866       else do:
     1867         return .
     1868       end.
     1869       assign
     1870         v-frame-width = frame Dialog-Frame :width
     1871         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1872         v-browse-width = v-diasize-browse-handle :width
     1873       .
     1874       for each buf_temp-browse-handle
     1875         where buf_temp-browse-handle.browse-type = 'width':u
     1876       :
     1877         assign
     1878           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1879         .
     1880       end.
     1881       for each buf_temp-diasize-handle
     1882       :
     1883         delete buf_temp-diasize-handle .
     1884       end.
     1885       assign
     1886         v-field-group-handle = frame Dialog-Frame :first-child
     1887       .
     1888       do while valid-handle(v-field-group-handle)
     1889       :
     1890         assign
     1891           v-object-handle = v-field-group-handle :first-child
     1892         .
     1893         do while valid-handle(v-object-handle)
     1894         :
     1895           if  v-object-handle <> v-diasize-browse-handle :handle
     1896           and v-object-handle <> v-diasize-resize-button
     1897           and can-query(v-object-handle, "row")
     1898           and can-query(v-object-handle, "height")
     1899           and ( v-object-handle :col + v-object-handle :width
     1900                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1901               )
     1902           then do:
     1903             find first buf_temp-browse-handle
     1904               where buf_temp-browse-handle.browse-type   = 'width':u
     1905                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1906               no-error .
     1907             if available buf_temp-browse-handle
     1908             then do:
     1909             end.
     1910             else do:
     1911               create buf_temp-diasize-handle .
     1912               assign
     1913                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1914                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1915               .
     1916             end.
     1917           end.
     1918           assign
     1919             v-object-handle = v-object-handle :next-sibling
     1920           .
     1921         end.
     1922         assign
     1923           v-field-group-handle = v-field-group-handle :next-sibling
     1924         .
     1925       end.
     1926       do with frame Dialog-Frame
     1927       :
     1928         hide v-diasize-resize-button .
     1929         v-diasize-resize-button :row = 1.
     1930         v-diasize-resize-button :column = 1.
     1931       end.
     1932       if p-change-value > 0
     1933       then do:
     1934         if frame Dialog-Frame :scrollable = true
     1935         then do:
     1936           assign
     1937             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1938             no-error .
     1939           if error-status :error
     1940           or error-status :get-message(1) <> ""
     1941           then do:
     1942             undo move_block, retry move_block.
     1943           end.
     1944         end.
     1945         assign
     1946           frame Dialog-Frame :width = v-frame-width + p-change-value
     1947           no-error .
     1948         if error-status :error
     1949         or error-status :get-message(1) <> ""
     1950         then do:
     1951           undo move_block, retry move_block.
     1952         end.
     1953         assign
     1954           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1955         no-error .
     1956         if error-status :error
     1957         or error-status :get-message(1) <> ""
     1958         then do:
     1959           undo move_block, retry move_block.
     1960         end.
     1961         for each buf_temp-browse-handle
     1962           where buf_temp-browse-handle.browse-type = 'width':u
     1963         on error undo move_block, retry move_block
     1964         :
     1965           assign
     1966             buf_temp-browse-handle.browse-handle :width
     1967               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1968             no-error .
     1969           if error-status :error
     1970           or error-status :get-message(1) <> ""
     1971           then do:
     1972             undo move_block, retry move_block .
     1973           end.
     1974         end.
     1975         for each buf_temp-diasize-handle
     1976         on error undo move_block, retry move_block
     1977         :
     1978           assign
     1979             v-object-handle = buf_temp-diasize-handle.handle-value
     1980           .
     1981           if v-object-handle <> v-diasize-resize-button
     1982           then do:
     1983             assign
     1984               v-object-handle :col = v-object-handle :col + p-change-value
     1985               no-error .
     1986             if error-status :error
     1987             or error-status :get-message(1) <> ""
     1988             then do:
     1989               undo move_block, retry move_block .
     1990             end.
     1991           end.
     1992         end.
     1993       end.
     1994       else do:
     1995         for each buf_temp-diasize-handle
     1996         on error undo move_block, retry move_block
     1997         :
     1998           assign
     1999             v-object-handle = buf_temp-diasize-handle.handle-value
     2000           .
     2001           if v-object-handle <> v-diasize-resize-button
     2002           then do:
     2003             assign
     2004               v-object-handle :col = v-object-handle :col + p-change-value
     2005               no-error .
     2006             if error-status :error
     2007             or error-status :get-message(1) <> ""
     2008             then do:
     2009               undo move_block, retry move_block .
     2010             end.
     2011           end.
     2012         end.
     2013         for each buf_temp-browse-handle
     2014           where buf_temp-browse-handle.browse-type = 'width':u
     2015         on error undo move_block, retry move_block
     2016         :
     2017           assign
     2018             buf_temp-browse-handle.browse-handle :width
     2019               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2020             no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block .
     2025           end.
     2026         end.
     2027         assign
     2028           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2029           no-error .
     2030         if error-status :error
     2031         or error-status :get-message(1) <> ""
     2032         then do:
     2033           undo move_block, retry move_block.
     2034         end.
     2035         assign
     2036           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2037         no-error .
     2038         if error-status :error
     2039         or error-status :get-message(1) <> ""
     2040         then do:
     2041           undo move_block, retry move_block.
     2042         end.
     2043         if frame Dialog-Frame :scrollable = true
     2044         then do:
     2045           assign
     2046             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2047           no-error .
     2048           if error-status :error
     2049           or error-status :get-message(1) <> ""
     2050           then do:
     2051             undo move_block, retry move_block.
     2052           end.
     2053         end.
     2054       end.
     2055       if p-move-resize
     2056       then do:
     2057         run diasize_position-resize-button in this-procedure .
     2058       end.
     2059       if v-diasize-wndstore = true
     2060       then do:
     2061         if connected("ub") = true
     2062         then do:
     2063           define variable v-cntxt-db-num        as integer   no-undo .
     2064           define variable v-cntxt-userid        as character no-undo .
     2065           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2066                                             , OUTPUT v-cntxt-userid
     2067                                             ) .
     2068           run gbl/wndsizew.p
     2069             (input  v-cntxt-db-num
     2070             ,input  v-cntxt-userid
     2071             ,input  v-diasize-proc-name
     2072             ,input  'width':u
     2073             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2074             ) .
     2075         end.
     2076       end.
     2077     end.
     2078     assign
     2079       v-diasize-change-size = false
     2080     .
     2081   end procedure.
     2082   procedure diasize_set-width :
     2083     define input  parameter p-new-width  as decimal   no-undo .
     2084     define input  parameter p-move-resize as logical   no-undo .
     2085     do
     2086     on error undo, return error return-value
     2087     :
     2088       run diasize_change-width in this-procedure
     2089         (input  (p-new-width - frame Dialog-Frame :width)
     2090         ,input  p-move-resize
     2091         ) .
     2092     end.
     2093   end procedure.
     2094   procedure diasize_position-resize-button :
     2095     do with frame Dialog-Frame
     2096     :
     2097       hide v-diasize-resize-button .
     2098       assign
     2099         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2100                     - 1
     2101                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2102         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2103                     - 1
     2104                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2105       .
     2106       view v-diasize-resize-button .
     2107     end.
     2108   end procedure.
     2109   on alt-right anywhere
     2110   do:
     2111     run diasize_change-width in this-procedure
     2112       (input 1
     2113       ,input true
     2114       ) .
     2115     return no-apply .
     2116   end.
     2117   on alt-left anywhere
     2118   do:
     2119     run diasize_change-width in this-procedure
     2120       (input -1
     2121       ,input true
     2122       ) .
     2123     return no-apply .
     2124   end.
     2125   on alt-down anywhere
     2126   do:
     2127     run diasize_change-height in this-procedure
     2128       (input 1
     2129       ,input true
     2130       ) .
     2131     return no-apply .
     2132   end.
     2133   on alt-up anywhere
     2134   do:
     2135     run diasize_change-height in this-procedure
     2136       (input -1
     2137       ,input true
     2138       ) .
     2139     return no-apply .
     2140   end.
     2141   on alt-enter of frame Dialog-Frame
     2142   do:
     2143     run diasize_maximize in this-procedure
     2144       (input  ?
     2145       ).
     2146     return no-apply .
     2147   end.
     2148   procedure diasize_end-move :
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       define variable v-row-delta as decimal   no-undo .
     2153       define variable v-col-delta as decimal   no-undo .
     2154       define variable v-new-row as decimal   no-undo .
     2155       define variable v-new-col as decimal   no-undo .
     2156       assign
     2157         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2158         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2159       .
     2160       assign
     2161         v-row-delta = v-new-row - frame Dialog-Frame :height
     2162         v-col-delta = v-new-col - frame Dialog-Frame :width
     2163       .
     2164       run diasize_change-height in this-procedure
     2165         (input v-row-delta
     2166         ,input true
     2167         ) .
     2168       run diasize_change-width in this-procedure
     2169         (input v-col-delta
     2170         ,input true
     2171         ) .
     2172     end.
     2173   end procedure.
     2174   procedure diasize_maximize :
     2175     define input  parameter p-action as logical   no-undo .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       if p-action = ?
     2180       then do:
     2181         if v-diasize-need-maximize = true
     2182         then do:
     2183           assign
     2184             p-action = true
     2185           .
     2186         end.
     2187         else do:
     2188           assign
     2189             p-action = false
     2190           .
     2191         end.
     2192       end.
     2193       if p-action = true
     2194       then do:
     2195         run diasize_change-height in this-procedure
     2196           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2197               - frame Dialog-Frame :height-chars
     2198           ,input true
     2199           ) .
     2200         run diasize_change-width in this-procedure
     2201           (input session :width-chars
     2202               - frame Dialog-Frame :width-chars
     2203           ,input true
     2204           ) .
     2205         assign
     2206           v-diasize-need-maximize = false
     2207         .
     2208       end.
     2209       else do:
     2210         run diasize_change-width in this-procedure
     2211           (input v-diasize-orig-frame-width
     2212               - frame Dialog-Frame :width-chars
     2213           ,input true
     2214           ) .
     2215         run diasize_change-height in this-procedure
     2216           (input v-diasize-orig-frame-height
     2217               - frame Dialog-Frame :height-chars
     2218           ,input true
     2219           ) .
     2220         assign
     2221           v-diasize-need-maximize = true
     2222         .
     2223       end.
     2224     end.
     2225   end procedure.
     2226   procedure diasize_restore-orig-size :
     2227     do
     2228     on error undo, return error return-value
     2229     :
     2230       assign
     2231         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2232         v-diasize-current-frame-height = frame Dialog-Frame :height
     2233       .
     2234       run diasize_set-height in this-procedure
     2235         (input  v-diasize-orig-frame-height
     2236         ,input  true
     2237         ) .
     2238       run diasize_set-width in this-procedure
     2239         (input  v-diasize-orig-frame-width
     2240         ,input  true
     2241         ) .
     2242     end.
     2243   end procedure.
     2244   procedure diasize_restore-current-size :
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       run diasize_set-height in this-procedure
     2249         (input  v-diasize-current-frame-height
     2250         ,input  true
     2251         ) .
     2252       run diasize_set-width in this-procedure
     2253         (input  v-diasize-current-frame-width
     2254         ,input  true
     2255         ) .
     2256     end.
     2257   end procedure.
     2258   procedure diasize_set-browse-handle :
     2259     define input  parameter p-browse-handle as handle   no-undo .
     2260     define buffer buf_temp-browse-handle for temp-browse-handle .
     2261     do
     2262     on error undo, return error return-value
     2263     :
     2264       assign
     2265         v-diasize-browse-handle = p-browse-handle
     2266       .
     2267       for each buf_temp-browse-handle
     2268       on error undo, return error return-value
     2269       :
     2270         delete buf_temp-browse-handle .
     2271       end.
     2272     end.
     2273   end procedure.
     2274   procedure diasize_add_browse :
     2275     define input  parameter p-browse-type   as character no-undo .
     2276     define input  parameter p-browse-handle as handle    no-undo .
     2277     define buffer buf_temp-browse-handle for temp-browse-handle .
     2278     do
     2279     on error undo, return error return-value
     2280     :
     2281       assign
     2282         v-diasize-browse-number = v-diasize-browse-number + 1
     2283       .
     2284       create buf_temp-browse-handle .
     2285       assign
     2286         buf_temp-browse-handle.browse-type   = p-browse-type
     2287         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2288         buf_temp-browse-handle.browse-handle = p-browse-handle
     2289       .
     2290     end.
     2291   end procedure.
     2292   procedure diasize_init :
     2293     define variable v-default-value    as logical   no-undo .
     2294     define variable v-restore-saved    as logical   no-undo .
     2295     define variable v-resize-value-str as character no-undo .
     2296     do
     2297     on error undo, return error return-value
     2298     :
     2299       do with frame Dialog-Frame
     2300       :
     2301         assign
     2302           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2303           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2304           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2305         .
     2306         create button v-diasize-resize-button
     2307         assign
     2308           parent        = frame Dialog-Frame :first-child
     2309           label         = "s"
     2310           height-pixels = 16
     2311           width-pixels  = 16
     2312           visible       = true
     2313           sensitive     = true
     2314           movable       = true
     2315           triggers:
     2316             on end-move persistent run diasize_end-move in this-procedure .
     2317           end triggers.
     2318         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2319         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2320         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2321         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2322         assign
     2323           v-diasize-wndmax = false
     2324         .
     2325         if connected("ub") = true
     2326         then do:
     2327           define variable v-cntxt-db-num        as integer   no-undo .
     2328           define variable v-cntxt-userid        as character no-undo .
     2329           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2330                                             , OUTPUT v-cntxt-userid
     2331                                             ) .
     2332           run gbl/wndpar_r.p
     2333             (input  v-cntxt-db-num
     2334             ,input  v-cntxt-userid
     2335             ,input  'wndmax':U
     2336             ,output v-diasize-wndmax
     2337             ,output v-default-value
     2338             ) .
     2339         end.
     2340         assign
     2341           v-diasize-wndstore = false
     2342         .
     2343         if connected("ub") = true
     2344         then do:
     2345           run gbl/wndpar_r.p
     2346             (input  v-cntxt-db-num
     2347             ,input  v-cntxt-userid
     2348             ,input  'wndstore':U
     2349             ,output v-diasize-wndstore
     2350             ,output v-default-value
     2351             ) .
     2352         end.
     2353         assign
     2354           v-diasize-proc-name = entry(1, program-name(2), '.')
     2355         .
     2356         if v-diasize-wndstore = true
     2357         then do:
     2358           assign
     2359             v-restore-saved = false
     2360           .
     2361           if connected("ub") = true
     2362           then do:
     2363             run gbl/wndsizer.p
     2364               (input  v-cntxt-db-num
     2365               ,input  v-cntxt-userid
     2366               ,input  v-diasize-proc-name
     2367               ,input  'height':u
     2368               ,output v-resize-value-str
     2369               ) .
     2370             if v-resize-value-str <> '':U
     2371             then do:
     2372               run diasize_change-height in this-procedure
     2373                 (input  integer(v-resize-value-str)
     2374                 ,input  true
     2375                 ) .
     2376               assign
     2377                 v-restore-saved = true
     2378               .
     2379             end.
     2380           end.
     2381           if connected("ub") = true
     2382           then do:
     2383             run gbl/wndsizer.p
     2384               (input  v-cntxt-db-num
     2385               ,input  v-cntxt-userid
     2386               ,input  v-diasize-proc-name
     2387               ,input  'width':u
     2388               ,output v-resize-value-str
     2389               ) .
     2390             if v-resize-value-str <> '':U
     2391             then do:
     2392               run diasize_change-width in this-procedure
     2393                 (input  integer(v-resize-value-str)
     2394                 ,input  true
     2395                 ) .
     2396               assign
     2397                 v-restore-saved = true
     2398               .
     2399             end.
     2400           end.
     2401           if v-restore-saved <> true
     2402           then do:
     2403             if v-diasize-wndmax = true
     2404             then do:
     2405               run diasize_maximize in this-procedure
     2406                 (input  true
     2407                 ) .
     2408             end.
     2409           end.
     2410         end.
     2411         else do:
     2412           if v-diasize-wndmax = true
     2413           then do:
     2414             run diasize_maximize in this-procedure
     2415               (input  true
     2416               ) .
     2417           end.
     2418         end.
     2419       end.
     2420     end.
     2421   end procedure.
     2422   procedure diasize_need-full-display :
     2423     define output parameter p-need-full-display as logical   no-undo .
     2424     do
     2425     on error undo, return error return-value
     2426     :
     2427       assign
     2428         p-need-full-display = v-diasize-need-full-display
     2429       .
     2430       assign
     2431         v-diasize-need-full-display = false
     2432       .
     2433     end.
     2434   end procedure.
     2435   procedure get-context :
     2436      define output parameter p-db-num as integer          no-undo.
     2437      define output parameter p-user-id as character        no-undo.
     2438      define variable v-login               as character    no-undo.
     2439      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2440      define buffer buf_user-login  for ub.user-login .
     2441      do
     2442      on error undo, return error
     2443      :
     2444            FIND FIRST buf_sys-ctrl no-lock.
     2445            ASSIGN
     2446               v-login = USERID("ub")
     2447               p-db-num = buf_sys-ctrl.db-num
     2448            .
     2449            FIND FIRST buf_user-login
     2450                 WHERE buf_user-login.db-num = p-db-num
     2451                   AND buf_user-login.user-login = v-login
     2452                 no-lock
     2453                 no-error
     2454                 .
     2455            IF AVAILABLE buf_user-login
     2456            THEN DO:
     2457               assign
     2458                  p-user-id = buf_user-login.user-id
     2459               .
     2460            END.
     2461      end.
     2462   end procedure.
     2463       run diasize_init in this-procedure .
     2464   on window-close of frame Dialog-Frame
     2465   do:
     2466     apply 'end-error':u to frame Dialog-Frame.
     2467   end.
     2468   on 'end-error':u of frame Dialog-Frame
     2469   do:
     2470     return no-apply .
     2471   end.
     2472   MAIN-BLOCK:
     2473   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2474      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2475     run validate-input-parameters in this-procedure .
     2476     run str/prt-mode.p
     2477       (input  p-doc-code
     2478       ,input  p-gds-code
     2479       ,input  p-update-doc
     2480       ,output v-sort-mode-int
     2481       ,output v-filter-mode-int
     2482       ,output v-can-create-gds-dtl
     2483       ) .
     2484     assign
     2485       RADIO-SET-sort   = v-sort-mode-int
     2486       RADIO-SET-filter = v-filter-mode-int
     2487     .
     2488     run translate-sort in this-procedure
     2489       (input  radio-set-sort
     2490       ,output v-sort-mode
     2491       ) .
     2492     run translate-filter in this-procedure
     2493       (input  radio-set-filter
     2494       ,output v-filter-mode
     2495       ) .
     2496     define variable v-ok as logical   no-undo .
     2497     assign
     2498       v-ok = BROWSE-1 :set-repositioned-row(5, "conditional")
     2499     .
     2500     run make-temp-table in this-procedure .
     2501     run waitfram-hide in this-procedure .
     2502     RUN enable_UI.
     2503     run show-input-info in this-procedure .
     2504     if fi-search-b-code <> ""
     2505     then do:
     2506       run search-bar-code in this-procedure
     2507         (input fi-search-b-code
     2508         ,input true
     2509         ) no-error .
     2510       if error-status :error
     2511       then do:
     2512         assign
     2513           fi-search-b-code :screen-value = ""
     2514         .
     2515         assign
     2516           fi-search-b-code
     2517         .
     2518       end.
     2519     end.
     2520     run tune-interface in this-procedure .
     2521     if p-node-code <> ?
     2522     then do:
     2523       run reposition-query in this-procedure
     2524         (input p-node-code
     2525         ) .
     2526     end.
     2527     WAIT-FOR GO OF FRAME Dialog-Frame.
     2528   END.
     2529   RUN disable_UI.
     2530   PROCEDURE disable_UI :
     2531     HIDE FRAME Dialog-Frame.
     2532   END PROCEDURE.
     2533   PROCEDURE edit-qnty :
     2534     define variable v-reposition-node-code as integer   no-undo .
     2535     define variable v-terminal-prt as logical   no-undo .
     2536     do
     2537     on error undo, return error return-value
     2538     :
     2539       if available temp-gds-prt
     2540       then do:
     2541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2542     (input  temp-gds-prt.node-code
     2543     ,input  'terminal-prt=request':u
     2544     ,output v-terminal-prt
     2545     ) no-error .
     2546         if error-status :error
     2547         then do:
     2548           message
     2549             vss-workfile vss-revision vss-description skip
     2550             "Ошибка при определении атрибута признака" skip
     2551             "Код признака" temp-gds-prt.node-code skip
     2552             view-as alert-box error .
     2553           undo, return error return-value .
     2554         end.
     2555         if v-terminal-prt = true
     2556         then do:
     2557           assign
     2558             v-reposition-node-code = temp-gds-prt.node-code
     2559           .
     2560           run str/prt-edit.p
     2561             (input  parparentproc
     2562             ,input  p-doc-code
     2563             ,input  p-gds-code
     2564             ,input  temp-gds-prt.node-code
     2565             ,input  p-mode
     2566             ) .
     2567           if p-mode <> 'ПРОСМОТР':U
     2568           then do:
     2569             run make-temp-table in this-procedure no-error .
     2570             run waitfram-hide in this-procedure .
     2571             run local-open-query in this-procedure
     2572               (input v-reposition-node-code
     2573               ) .
     2574           end.
     2575         end.
     2576         else do:
     2577           message
     2578             "Количества можно указывать только для самых подробных признаков" skip
     2579             view-as alert-box information .
     2580         end.
     2581       end.
     2582     end.
     2583   END PROCEDURE.
     2584   PROCEDURE enable_UI :
     2585     DISPLAY fi-search-b-code RADIO-SET-sort RADIO-SET-filter fi-gds-label fi-gds
     2586             fi-obj fi-obj-label fi-sort-label fi-filter-label fi-doc-qnty
     2587             fi-fact-qnty fi-prt-free-qnty fi-prt-fact-qnty
     2588         WITH FRAME Dialog-Frame.
     2589     ENABLE b-exit b-qnty b-scale b-crebcprt b-codes b-alt b-rest b-arch b-print
     2590            b-help b-refresh fi-search-b-code RADIO-SET-sort RADIO-SET-filter
     2591            BROWSE-1 fi-gds-label fi-gds fi-obj fi-obj-label fi-sort-label
     2592            fi-filter-label fi-doc-qnty fi-fact-qnty fi-prt-free-qnty
     2593            fi-prt-fact-qnty
     2594         WITH FRAME Dialog-Frame.
     2595     VIEW FRAME Dialog-Frame.
     2596     run local-open-query in this-procedure (input ? ) .
     2597   END PROCEDURE.
     2598   PROCEDURE get-sort-code :
     2599     define input  parameter p-node-code as integer   no-undo .
     2600     define output parameter p-sort-code as character no-undo .
     2601     define buffer buf_gds-prt for ub.gds-prt .
     2602     define variable v-upper-code as integer   no-undo .
     2603     define variable v-sort-code  as character no-undo .
     2604     define variable v-curr-node-sort as character no-undo .
     2605     find first buf_gds-prt no-lock
     2606       where buf_gds-prt.node-code = p-node-code
     2607       no-error .
     2608     do while true
     2609     :
     2610       assign
     2611         v-curr-node-sort = string(buf_gds-prt.prt-num, '999999999':u)
     2612       .
     2613       assign
     2614         v-upper-code = buf_gds-prt.upper-code
     2615       .
     2616       find first buf_gds-prt no-lock
     2617         where buf_gds-prt.node-code = v-upper-code
     2618         no-error .
     2619       if not available buf_gds-prt
     2620       then do:
     2621         leave .
     2622       end.
     2623       assign
     2624         v-sort-code = v-curr-node-sort  + '/' + v-sort-code
     2625       .
     2626     end.
     2627     assign
     2628       p-sort-code = v-sort-code
     2629     .
     2630   END PROCEDURE.
     2631   PROCEDURE local-open-query :
     2632     define input  parameter p-reposition-node-code as integer   no-undo .
     2633     define variable v-last-node-code as integer   no-undo .
     2634     if p-reposition-node-code <> ?
     2635     then do:
     2636       assign
     2637         v-last-node-code = p-reposition-node-code
     2638       .
     2639     end.
     2640     else do:
     2641       if available temp-gds-prt
     2642       then do:
     2643         assign
     2644           v-last-node-code = temp-gds-prt.b-code
     2645         .
     2646       end.
     2647       else do:
     2648         assign
     2649           v-last-node-code = ?
     2650         .
     2651       end.
     2652     end.
     2653     if  v-need-refresh = true
     2654     and v-filter-mode = 'filter-b-code':u
     2655     then do:
     2656       run make-temp-table in this-procedure no-error .
     2657       run waitfram-hide in this-procedure .
     2658       assign
     2659         v-need-refresh = false
     2660       .
     2661     end.
     2662     display
     2663       v-doc-qnty      @ fi-doc-qnty
     2664       v-fact-qnty     @ fi-fact-qnty
     2665       v-prt-free-qnty @ fi-prt-free-qnty
     2666       v-prt-fact-qnty @ fi-prt-fact-qnty
     2667       with frame Dialog-Frame .
     2668     case v-filter-mode :
     2669       when 'filter-b-code':u then do:
     2670         case v-sort-mode
     2671         :
     2672           when 'sort-b-code':u
     2673           then do:
     2674             open query BROWSE-1 for each temp-gds-prt
     2675               where temp-gds-prt.show-list = true
     2676               by b-code .
     2677           end.
     2678           when 'sort-sort-code':u
     2679           then do:
     2680             open query BROWSE-1 for each temp-gds-prt
     2681               where temp-gds-prt.show-list = true
     2682               by sort-code .
     2683           end.
     2684           when 'sort-tree':u
     2685           then do:
     2686             open query BROWSE-1 for each temp-gds-prt
     2687               by sort-code .
     2688           end.
     2689           otherwise do:
     2690             message
     2691               vss-workfile vss-revision vss-description skip
     2692               "Внутренняя ошибка" skip
     2693               "Неизвестное значение переменной v-sort-mode" skip
     2694               "" v-sort-mode skip
     2695               view-as alert-box error .
     2696             undo, return error return-value .
     2697           end.
     2698         end case.
     2699       end.
     2700       when 'filter-prt-obj':u then do:
     2701         case v-sort-mode
     2702         :
     2703           when 'sort-b-code':u
     2704           then do:
     2705             open query BROWSE-1 for each temp-gds-prt
     2706               where temp-gds-prt.show-prt = true
     2707                 and temp-gds-prt.show-list = true
     2708               by b-code .
     2709           end.
     2710           when 'sort-sort-code':u
     2711           then do:
     2712             open query BROWSE-1 for each temp-gds-prt
     2713               where temp-gds-prt.show-prt = true
     2714                 and temp-gds-prt.show-list = true
     2715               by sort-code .
     2716           end.
     2717           when 'sort-tree':u
     2718           then do:
     2719             open query BROWSE-1 for each temp-gds-prt
     2720               where temp-gds-prt.show-prt = true
     2721               by sort-code .
     2722           end.
     2723           otherwise do:
     2724             message
     2725               vss-workfile vss-revision vss-description skip
     2726               "Внутренняя ошибка" skip
     2727               "Неизвестное значение переменной v-sort-mode" skip
     2728               "" v-sort-mode skip
     2729               view-as alert-box error .
     2730             undo, return error return-value .
     2731           end.
     2732         end case.
     2733       end.
     2734       when 'filter-not-zero':u then do:
     2735         case v-sort-mode
     2736         :
     2737           when 'sort-b-code':u
     2738           then do:
     2739             open query BROWSE-1 for each temp-gds-prt
     2740               where temp-gds-prt.show-rest = true
     2741                 and temp-gds-prt.show-list = true
     2742               by b-code .
     2743           end.
     2744           when 'sort-sort-code':u
     2745           then do:
     2746             open query BROWSE-1 for each temp-gds-prt
     2747               where temp-gds-prt.show-rest = true
     2748                 and temp-gds-prt.show-list = true
     2749               by sort-code .
     2750           end.
     2751           when 'sort-tree':u
     2752           then do:
     2753             open query BROWSE-1 for each temp-gds-prt
     2754               where temp-gds-prt.show-rest = true
     2755               by sort-code .
     2756           end.
     2757           otherwise do:
     2758             message
     2759               vss-workfile vss-revision vss-description skip
     2760               "Внутренняя ошибка" skip
     2761               "Неизвестное значение переменной v-sort-mode" skip
     2762               "" v-sort-mode skip
     2763               view-as alert-box error .
     2764             undo, return error return-value .
     2765           end.
     2766         end case.
     2767       end.
     2768       when 'filter-doc':u then do:
     2769         case v-sort-mode
     2770         :
     2771           when 'sort-b-code':u
     2772           then do:
     2773             open query BROWSE-1 for each temp-gds-prt
     2774               where temp-gds-prt.show-doc  = true
     2775                 and temp-gds-prt.show-list = true
     2776               by b-code .
     2777           end.
     2778           when 'sort-sort-code':u
     2779           then do:
     2780             open query BROWSE-1 for each temp-gds-prt
     2781               where temp-gds-prt.show-doc  = true
     2782                 and temp-gds-prt.show-list = true
     2783               by sort-code .
     2784           end.
     2785           when 'sort-tree':u
     2786           then do:
     2787             open query BROWSE-1 for each temp-gds-prt
     2788               where temp-gds-prt.show-doc = true
     2789               by sort-code .
     2790           end.
     2791           otherwise do:
     2792             message
     2793               vss-workfile vss-revision vss-description skip
     2794               "Внутренняя ошибка" skip
     2795               "Неизвестное значение переменной v-sort-mode" skip
     2796               "" v-sort-mode skip
     2797               view-as alert-box error .
     2798             undo, return error return-value .
     2799           end.
     2800         end case.
     2801       end.
     2802       otherwise do:
     2803         message
     2804           vss-workfile vss-revision vss-description skip
     2805           "Внутренняя ошибка" skip
     2806           "Неизвестное значение переменной v-filter-mode" skip
     2807           "" v-filter-mode skip
     2808           view-as alert-box error .
     2809         undo, return error return-value .
     2810       end.
     2811     end.
     2812     if v-last-node-code <> ?
     2813     then do:
     2814       run reposition-query in this-procedure
     2815         (input v-last-node-code
     2816         ) .
     2817     end.
     2818   END PROCEDURE.
     2819   PROCEDURE make-temp-table :
     2820     define variable v-root-node as integer   no-undo .
     2821     define variable v-prt-level as integer   no-undo .
     2822     define variable v-ind       as integer   no-undo .
     2823     define variable v-node-code as integer   no-undo .
     2824     define variable v-is-new    as logical   no-undo .
     2825     define variable v-term-prt  as logical   no-undo .
     2826     define buffer buf_temp-gds-prt for temp-gds-prt .
     2827     define buffer buf_trn-doc      for ub.trn-doc .
     2828     define buffer buf_goods        for ub.goods .
     2829     define buffer buf_prt-obj      for ub.prt-obj .
     2830     define buffer buf_bar-code     for ub.bar-code .
     2831     define buffer buf_gds-prt      for ub.gds-prt .
     2832     define buffer buf_gds-dtl      for ub.gds-dtl .
     2833     do
     2834     on error undo, return error return-value
     2835     :
     2836       find first buf_trn-doc no-lock
     2837         where buf_trn-doc.doc-code = p-doc-code
     2838         .
     2839       assign
     2840       v-obj-type = buf_trn-doc.obj-type
     2841       v-obj-code = buf_trn-doc.obj-code
     2842       .
     2843       for each buf_temp-gds-prt
     2844       on error undo, return error return-value
     2845       :
     2846         delete buf_temp-gds-prt .
