        1   define input  parameter parparentproc as widget-handle no-undo.
        2   define input  parameter p-doc-code    as character no-undo .
        3   define input  parameter p-gds-code    as integer   no-undo .
        4   define input  parameter p-node-code   as integer   no-undo .
        5   define input  parameter p-mode        as character no-undo .
        6   define input  parameter p-update-doc  as logical   no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision$":U .
        8   define variable vss-author      as character no-undo initial "$Author$":U .
        9   define variable vss-date        as character no-undo initial "$Date$":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       11   define variable vss-archive     as character no-undo initial "$Archive$":U .
       12   define variable vss-description as character no-undo initial "Окно редактирования признаков товара по строке документа".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u,parparentproc,p-doc-code,p-gds-code,p-node-code,p-mode,p-update-doc)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define temp-table temp-gds-prt no-undo
      122     field b-code        as integer   format '9999999999':u       label "Осн. код"
      123     field sort-code     as character                             label "Код сортировки по признакам"
      124     field node-code     as integer
      125     field upper-code    as integer
      126     field prt-name      as character format 'x(35)':u            label "Признак"
      127     field node-name     as character format 'x(16)':u            label "Признак"
      128     field doc-qnty      as decimal   format '->>>,>>>,>>9.999':u label "По документу"
      129     field fact-qnty     as decimal   format '->>>,>>>,>>9.999':u label "Факт"
      130     field prt-free-qnty as decimal   format '->>>,>>>,>>9.999':u label "Свободно"
      131     field prt-fact-qnty as decimal   format '->>>,>>>,>>9.999':u label "Факт остаток"
      132     field price-base    as decimal   format '>>>,>>>,>>9.99':u   label "Цена документа (вал.)"
      133     field price-rubl    as decimal   format '>>>,>>>,>>9.99':u   label "Цена документа (руб.)"
      134     field price-sale    as decimal   format '>>>,>>>,>>9.99':u   label "Текущая цена"
      135     field prt-level     as integer                               label "Уровень"
      136     field show-list     as logical                               label "Структура"
      137     field show-prt      as logical                               label "Движение на объекте"
      138     field show-rest     as logical                               label "Есть остатки"
      139     field show-doc      as logical                               label "Документ"
      140     index xpk is primary unique node-code
      141     index xie1 sort-code
      142     index xie2 show-rest
      143     index xie3 show-prt
      144     index xie4 show-list
      145   .
      146   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   define variable v-waitfram-action01         as character   no-undo .
      148   define variable v-waitfram-action02         as character   no-undo .
      149   define variable v-waitfram-action03         as character   no-undo .
      150   define variable mWaitFramTextBeg            as character   no-undo.
      151   define variable mWaitFramTextEnd            as character   no-undo.
      152   define variable mWaitFramView               as logical     no-undo.
      153   define variable mWaitProcEvent              as logical     no-undo init yes.
      154   define variable mWaitFramInterval           as integer     no-undo init 1 .
      155   define variable mWaitFramStop               as logical     no-undo.
      156   define variable mWaitFramStopUser           as logical     no-undo.
      157   define variable mWaitFramStopTimeOut        as logical     no-undo.
      158   define variable mWaitFramStartProc          as datetime-tz no-undo.
      159   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      160   define button B-WaitFramStop auto-end-key
      161        label "Стоп"
      162        size 10 by 1 tooltip "Остоновить процесс".
      163   define button B-viewProcInfo
      164        label "Информация"
      165        size 15 by 1 tooltip "Информация о процесс".
      166   define frame waitfram
      167     v-waitfram-action01 format "x(72)" no-label skip
      168     v-waitfram-action02 format "x(72)" no-label skip
      169     v-waitfram-action03 format "x(72)" no-label skip
      170     B-viewProcInfo
      171     B-WaitFramStop at row 4 col 30
      172     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      173     .
      174   define new global shared variable mBatchMode as logical no-undo init ?.
      175   define variable mFramBachModHandle as handle no-undo.
      176   mFramBachModHandle = frame waitfram:handle.
      177   define variable mFameOldVis as logical no-undo.
      178   define variable mVisCUrentVin as logical no-undo.
      179   if session:batch-mode
      180   then
      181      mBatchMode = yes.
      182   if mBatchMode = ? then do:
      183     mVisCUrentVin = current-window:visible.
      184     mFameOldVis = mFramBachModHandle:visible.
      185     mFramBachModHandle:visible  = yes.
      186     mBatchMode = mFramBachModHandle:visible ne yes.
      187     mFramBachModHandle:visible = mFameOldVis.
      188     current-window:visible = mVisCUrentVin.
      189   end.
      190    if  log-manager:logfile-name ne ?
      191     then DO:
      192         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      193         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      194         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      195     end.
      196   on choose of B-WaitFramStop in frame waitfram
      197   do:
      198     mWaitFramStop = yes.
      199     mWaitFramStopUser = yes.
      200   end.
      201   function waitfram-check-timeout returns logical():
      202      define variable vtime as int64 no-undo.
      203      if mWaitFramStopTimeOut
      204      then
      205         return yes.
      206      vtime = ( now - mWaitFramStartProc ) / 1000 .
      207      if     mWaitFramTimeOut ne ?
      208         and mWaitFramTimeOut ne 0
      209         and mWaitFramTimeOut lt vtime
      210      then do:
      211         mWaitFramStopTimeOut = yes.
      212      end.
      213      return mWaitFramStopTimeOut.
      214   end.
      215   procedure waitfram-hide :
      216     if not session:batch-mode
      217     then do
      218     on error undo, return error return-value
      219     :
      220       pause 0 before-hide .
      221       if not mBatchMode then
      222         hide frame waitfram .
      223     if     not mWaitFramView
      224        and mWaitProcEvent
      225     then
      226       process events .
      227     end.
      228   end procedure.
      229   procedure waitfram-show :
      230     define input  parameter p-message as character no-undo .
      231     define variable v-left-margin as integer   no-undo .
      232     if not session:batch-mode
      233     then do
      234     on error undo, return error return-value
      235     :
      236       if length(p-message) <= 70 then do:
      237         assign
      238           v-left-margin = integer((70 - length(p-message)) / 2)
      239         .
      240         assign
      241           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      242         .
      243         assign
      244           v-waitfram-action01 = " "
      245           v-waitfram-action02 = " "
      246                                    + fill(" ", v-left-margin)
      247                                    + p-message
      248           v-waitfram-action03 = " "
      249         .
      250       end.
      251       else do:
      252         define variable vRindex1 as integer no-undo.
      253         define variable vRindex2 as integer no-undo.
      254         vRindex1 = r-index(p-message," ",70).
      255         if vRindex1 = 0
      256         then
      257            vRindex1 = 70.
      258         if length(p-message)  <= vRindex1 + 70 then do:
      259           assign
      260             v-waitfram-action01 = " "
      261             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      263           .
      264         end.
      265         else do:
      266           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      267           if vRindex2 <= vRindex1
      268           then
      269              vRindex2 = vRindex1 + 70.
      270           assign
      271             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      272             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      273             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      274           .
      275         end.
      276       end.
      277       B-viewProcInfo:visible   in frame waitfram = no.
      278       B-viewProcInfo:sensitive in frame waitfram = no.
      279       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      280       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      281       if  (   mWaitFramView
      282          or  mWaitProcEvent)
      283          and not mBatchMode
      284       then
      285          display
      286             v-waitfram-action01 skip
      287             v-waitfram-action02 skip
      288             v-waitfram-action03 skip
      289          with frame waitfram .
      290       if     mWaitFramView
      291          then do:
      292             if     mWaitFramInterval ne ?
      293                and not mBatchMode
      294             then
      295                wait-for go of frame waitfram pause mWaitFramInterval.
      296          end.
      297          else
      298             if     mWaitProcEvent
      299                and not mBatchMode
      300             then
      301                process events .
      302     end.
      303   end procedure.
      304      procedure waitfram-show-this:
      305         define input  parameter iInterval as int64 no-undo.
      306         define variable vtime as int64 no-undo.
      307         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      308         mWaitFramInterval = iInterval.
      309         run waitfram-show (substitute("&1&2 &3&4" ,
      310                                       mWaitFramTextBeg ,
      311                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      312                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      313                                       mWaitFramTextEnd
      314                                      )
      315                           ).
      316      end.
      317      procedure WaitFramRunPause:
      318         define input  parameter iInterval as dec no-undo.
      319         define variable vStart  as datetime-tz no-undo.
      320         define variable vend    as datetime-tz no-undo.
      321         define variable vint as int64 no-undo.
      322         define variable vOk as logical no-undo.
      323         vStart = now.
      324         vend   = vStart.
      325         publish "WaitFramPause" (iInterval,output vOk).
      326         vend   =  now.
      327         vint = vend - vStart.
      328         vint = iInterval - vint / 1000.
      329         if     not mWaitFramStop
      330            and (   vint > 0
      331                 or (    not vOk
      332                     and iInterval eq ?
      333                     )
      334                 )
      335         then
      336            run waitfram-show-this (iInterval).
      337         vend   =  now.
      338         vint = vend - vStart.
      339         vint = iInterval - vint / 1000.
      340         if     not mWaitFramStop
      341            and vint > 0
      342         then do:
      343            run gbl/pause.p (vint * 1000).
      344         end.
      345         if iInterval ne ?
      346         then
      347            publish "WaitFramStop".
      348         waitfram-check-timeout().
      349      end.
      350      procedure WaitFramWaitFor:
      351         define input  parameter iInterval as dec no-undo.
      352         assign
      353            mWaitFramStartProc   = now
      354            mWaitFramStopUser    = no
      355            mWaitFramStopTimeOut = no
      356         .
      357         block-wait:
      358         do while not mWaitFramStop:
      359            run WaitFramRunPause (iInterval).
      360            if  waitfram-check-timeout()
      361            then do:
      362               leave block-wait.
      363            end.
      364         end.
      365         run waitfram-hide.
      366      end.
      367   procedure waitfram-join :
      368     define input  parameter p-line-1  as character no-undo .
      369     define input  parameter p-line-2  as character no-undo .
      370     define input  parameter p-line-3  as character no-undo .
      371     define output parameter p-message as character no-undo .
      372     do
      373     on error undo, return error return-value
      374     :
      375       assign
      376         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      377                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      378                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      379       .
      380     end.
      381   end procedure.
      382   function waitfram-join-function returns character
      383     (input p-line-1 as character
      384     ,input p-line-2 as character
      385     ,input p-line-3 as character
      386     ).
      387     define variable v-message as character no-undo .
      388     run waitfram-join in this-procedure
      389       (input  p-line-1
      390       ,input  p-line-2
      391       ,input  p-line-3
      392       ,output v-message
      393       ) .
      394     return v-message .
      395   end function .
      396   function diff-list returns character (
      397     input parfirst-list  as character,
      398     input parsecond-list as character,
      399     input pardelim       as character).
      400     if pardelim = ""
      401     or pardelim = ?
      402     then do:
      403       assign
      404         pardelim = ","
      405       .
      406     end.
      407     def var ind as integer no-undo .
      408     def var v-elem as character no-undo .
      409     def var v-result-list as character no-undo init "".
      410     def var v-num-parfirst-list as integer no-undo .
      411     assign
      412       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      413     .
      414     do ind = 1 to v-num-parfirst-list
      415     :
      416       assign
      417         v-elem = entry(ind, parfirst-list, pardelim)
      418       .
      419       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      420         assign
      421           v-result-list = v-result-list
      422                         + (if v-result-list > "" then pardelim else "")
      423                         + v-elem
      424         .
      425       end.
      426     end.
      427     return v-result-list .
      428   end function.
      429   function add-list returns character (
      430    input parfirst-list  as character,
      431    input parsecond-list as character,
      432    input pardelim       as character).
      433     if pardelim = ""
      434     or pardelim = ?
      435     then do:
      436       assign
      437         pardelim = ","
      438       .
      439     end.
      440     def var ind as integer no-undo .
      441     def var v-elem as character no-undo .
      442     def var v-result-list as character no-undo init "".
      443     def var v-num-parfirst-list as integer no-undo .
      444     assign
      445       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      446     .
      447     do ind = 1 to v-num-parfirst-list
      448     :
      449       assign
      450         v-elem = entry(ind, parfirst-list, pardelim)
      451       .
      452       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      453         assign
      454           v-result-list = v-result-list
      455                         + (if v-result-list > "" then pardelim else "")
      456                         + v-elem
      457         .
      458       end.
      459     end.
      460     def var v-num-parsecond-list as integer no-undo .
      461     assign
      462       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      463     .
      464     do ind = 1 to v-num-parsecond-list
      465     :
      466       assign
      467         v-elem = entry(ind, parsecond-list, pardelim)
      468       .
      469       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      470         assign
      471           v-result-list = v-result-list
      472                         + (if v-result-list > "" then pardelim else "")
      473                         + v-elem
      474         .
      475       end.
      476     end.
      477     return v-result-list .
      478   end function.
      479   function cross-list returns character (
      480    input parfirst-list  as character,
      481    input parsecond-list as character,
      482    input pardelim       as character).
      483     if pardelim = ""
      484     or pardelim = ?
      485     then do:
      486       assign
      487         pardelim = ","
      488       .
      489     end.
      490     def var ind as integer no-undo .
      491     def var v-elem as character no-undo .
      492     def var v-result-list as character no-undo init "".
      493     def var v-num-parfirst-list as integer no-undo .
      494     assign
      495       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      496     .
      497     do ind = 1 to v-num-parfirst-list
      498     :
      499       assign
      500         v-elem = entry(ind, parfirst-list, pardelim)
      501       .
      502       if lookup(v-elem, v-result-list, pardelim) = 0
      503       and lookup(v-elem, parsecond-list, pardelim) > 0
      504       then do:
      505         assign
      506           v-result-list = v-result-list
      507                         + (if v-result-list > "" then pardelim else "")
      508                         + v-elem
      509         .
      510       end.
      511     end.
      512     return v-result-list .
      513   end function.
      514   function radio-label returns character (
      515    input par-rs-value  as character,
      516    input par-rs-radio-buttons as character)
      517    .
      518    DEFINE variable v-result-label as character no-undo.
      519    assign
      520    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      521                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      522                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      523                             ), par-rs-radio-buttons
      524                           )
      525    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      526    .
      527   return v-result-label.
      528   end function.
      529   function m-radio-label returns character (
      530    input par-rs-value  as character,
      531    input par-rs-radio-buttons as character,
      532    input par-delim as character
      533    )
      534    .
      535    DEFINE variable v-result-label as character no-undo.
      536    assign
      537    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      538                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      539                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      540                             ), par-rs-radio-buttons, par-delim
      541                           )
      542    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      543    .
      544   return v-result-label.
      545   end function.
      546   FUNCTION mixlist returns character
      547   (
      548    input parfirst-list  as character
      549    ,input parsecond-list as character
      550    ,input pardelim       as character
      551    ,input pardelim-result as character ) :
      552     if pardelim = ""
      553     or pardelim = ?
      554     then do:
      555       assign
      556         pardelim = ","
      557       .
      558     end.
      559     def var ind as integer no-undo .
      560     def var v-elem1 as character no-undo .
      561     def var v-elem2 as character no-undo .
      562     def var v-result-list as character no-undo init "".
      563     do ind = 1 to num-entries(parfirst-list, pardelim)
      564     :
      565       assign
      566         v-elem1 = entry(ind, parfirst-list, pardelim)
      567         v-elem2 = entry(ind, parsecond-list, pardelim)
      568       .
      569         assign
      570           v-result-list = v-result-list
      571                         + (if v-result-list > "" then pardelim-result else "")
      572                         + v-elem1 + pardelim-result + v-elem2
      573         .
      574     end.
      575     return v-result-list .
      576   END FUNCTION.
      577   define variable v-filter-mode        as character no-undo .
