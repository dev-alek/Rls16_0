      737        fi-prt-fact-qnty AT ROW 8.33 COL 62.13 COLON-ALIGNED
      738        SPACE(18.86) SKIP(14.13)
      739       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      740            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      741            TITLE "Признаки товара".
      742   ASSIGN
      743          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      744          FRAME Dialog-Frame:HIDDEN           = TRUE.
      745   ASSIGN
      746          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
      747   ON GO OF FRAME Dialog-Frame
      748   DO:
      749   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   if lookup(b-exit :type in frame Dialog-Frame
      751            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      752            ) = 0
      753   then do:
      754     message
      755       "$Workfile$"
      756       "Указанному интерфейсному элементу фокус не может быть передан" skip
      757       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
      758       "Тип" self :type in frame Dialog-Frame skip
      759       "Процедура" this-procedure :file-name skip
      760       view-as alert-box .
      761   end.
      762   else do:
      763     apply "entry":u to b-exit in frame Dialog-Frame .
      764     if focus :handle <> b-exit :handle in frame Dialog-Frame then do:
      765       return no-apply .
      766     end.
      767   end.
      768   END.
