        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Процент торговой наценки".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      112   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      113   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      114   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      115   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      116   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      117   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      118   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      119   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      120   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      121   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      122   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      123   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      124   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      125   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      126   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      127   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      128   define input  parameter parwith-tax    as integer no-undo.
      129   define output parameter parpc          as decimal no-undo.
      130   define output parameter parflag-return as logical no-undo.
      131   define output parameter round-base     as decimal no-undo.
      132   define output parameter round-method   as char    no-undo.
      133   DEFINE BUTTON b-cancel AUTO-END-KEY
      134        LABEL "&Отмена"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON b-help
      138        LABEL "&Помощь"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-ok AUTO-GO
      142        LABEL "&Ввод"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      146        VIEW-AS EDITOR
      147        SIZE 31.25 BY 2.33 NO-UNDO.
      148   DEFINE VARIABLE varpc AS DECIMAL FORMAT "->>>9.99%":U INITIAL 0
      149        VIEW-AS FILL-IN
      150        SIZE 8.63 BY 1.04 NO-UNDO.
      151   define variable par-pr-rndmt as character no-undo.
      152   define variable par-type     as character no-undo.
      153   define variable par-pr-rndbs as character no-undo.
      154   DEFINE FRAME Dialog-Frame
      155        b-ok AT ROW 1.17 COL 1.38
      156        b-cancel AT ROW 1.17 COL 11.75
      157        b-help AT ROW 1.17 COL 22.13
      158        EDITOR-1 AT ROW 2.46 COL 4 NO-LABEL
      159        varpc AT ROW 5.08 COL 15.5 COLON-ALIGNED NO-LABEL
      160        round-method  AT ROW 6.2 COL 13 COLON-ALIGNED LABEL "Окру&гление"
      161           format "x(15)" VIEW-AS COMBO-BOX INNER-LINES 7 LIST-ITEMS
      162           '9-окончание':U,
      163           '9-99окончание':U,
      164           'Без-дробных':U,
      165           'Произвольно':U,
      166           'Вверх':U,
      167           'Коэффициент':U,
      168           'Отключено':U
      169           SIZE 15 BY 1 bgcolor WHITE_COLOR
      170        round-base    AT ROW 7.2  COL 15 COLON-ALIGNED no-LABEL
      171           format "->>,>>9.99" VIEW-AS FILL-IN SIZE 10 BY 1 bgcolor WHITE_COLOR
      172        SPACE(13.11) SKIP(0.33)
      173       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      174            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      175            TITLE "Процент торг.наценки"
      176            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel.
      177   ASSIGN
      178          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      179          FRAME Dialog-Frame:HIDDEN           = TRUE.
      180   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      181   DO:
      182     APPLY "END-ERROR":U TO SELF.
      183   END.
      184   ON LEAVE OF round-base IN FRAME Dialog-Frame DO:
      185   if input frame Dialog-Frame round-base = 0 then do:
      186     if input frame Dialog-Frame round-method = 'Произвольно':U then
      187       message "Такое округление невозможно - деление на 0."
      188               view-as alert-box error.
      189     else
      190       message "Пересчет по нулевому коэффициенту невозможен - получится 0."
      191               view-as alert-box error.
      192   end.
      193   else
      194     assign
      195       round-base.
      196   disp round-base with frame Dialog-Frame.
      197   END.
      198   ON value-changed OF round-method IN FRAME Dialog-Frame DO:
      199   if lookup( input frame Dialog-Frame round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
      200       enable round-base with frame Dialog-Frame.
      201       disp round-base with frame Dialog-Frame.
      202     end.
      203     else
      204       hide round-base in frame Dialog-Frame.
      205   assign frame Dialog-Frame round-method.
      206   END.
      207   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      208   DO:
      209     assign parpc = input frame Dialog-Frame varpc
      210           parflag-return = yes.
      211   END.
      212   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      213   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      214   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   on help of frame Dialog-Frame
      216   do:
      217     run gbl/app_help.p
      218       (input this-procedure :file-name
      219       ,input ''
      220       ,input ?
      221       ) no-error.
      222     if error-status :error then do:
      223       message
      224         "Ошибка при вызове помощи"
      225         error-status :get-message(1)
      226         view-as alert-box .
      227     end.
      228   end.
      229   run minbtn-set in this-procedure .
      230   on choose of b-help in frame Dialog-Frame
      231   do:
      232     apply "help":u to frame Dialog-Frame .
      233   end.
      234   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   procedure minbtn-set :
      236       do
      237           on error undo, return error return-value
      238           :
      239           define variable ii              as integer       no-undo .
      240           define variable fh              as widget-handle no-undo .
      241           define variable hh              as widget-handle no-undo .
      242           define variable v-h             as handle        extent 4 no-undo .
      243           define variable v-name-button   as character     no-undo .
      244           define variable v-help-old-x    as decimal       no-undo .
      245           define variable v-help-old-y    as decimal       no-undo .
      246           define variable v-help-old-size as decimal       no-undo .
      247           define variable v-frame-width   as decimal       no-undo .
      248           define variable jj              as integer       no-undo .
      249           do
      250               on error undo, return error
      251               :
      252               assign
      253                   v-frame-width = frame Dialog-Frame:width - 0.3
      254                   fh            = frame Dialog-Frame:first-child
      255                   hh            = fh:first-child
      256                   ii            = 1
      257                   .
      258               do while valid-handle(hh):
      259                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      260                   do:
      261                       case lc(hh:name) :
      262                           when "b-help" then
      263                               do:
      264                                   hh:load-image-up("cmp/b-help.bmp":u) .
      265                                   hh:load-image-down("cmp/b-help.bmp":u) .
      266                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      267                                   hh:TOOLTIP = "Помощь" .
      268                                   v-help-old-x = hh:column .
      269                                   v-help-old-y = hh:row    .
      270                                   v-help-old-size = hh:width .
      271                                   hh:width-chars = 2.5 .
      272                               end.
      273                           when "b-print" then
      274                               do:
      275                                   hh:load-image("cmp/b-print.bmp":u) .
      276                                   hh:TOOLTIP = "Печать" .
      277                                   v-h[ii] = hh:handle .
      278                                   ii = ii + 1 .
      279                                   hh:width-chars = 3 .
      280                               end.
      281                           when "b-history" or
      282                           when "b-hist" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История" .
      286                                   v-h[ii] = hh:handle .
      287                                   ii = ii + 1 .
      288                                   hh:width-chars = 3 .
      289                               end.
      290                           when "b-sch" then
      291                               do:
      292                                   hh:load-image("cmp/b-sch.bmp":u) .
      293                                   hh:TOOLTIP = "Установка Фильтра" .
      294                                   v-h[ii] = hh:handle .
      295                                   ii = ii + 1 .
      296                                   hh:width-chars = 3 .
      297                               end.
      298                           when "b-hist-user" then
      299                               do:
      300                                   hh:load-image("cmp/b-hist.bmp":u) .
      301                                   hh:TOOLTIP = "История пользователя" .
      302                                   ii = ii + 1 .
      303                               end.
      304                       end case.
      305                   end.
      306                   hh = hh:next-sibling.
      307               end.
      308               b-help:column = v-frame-width - b-help:width-chars.
      309               jj = 0.
      310               repeat ii = 4 to 1 by -1 :
      311                   if valid-handle (v-h[ii] ) then
      312                   do:
      313                       jj  = jj + 1 .
      314                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      315                       v-h[ii]:row    = v-help-old-y .
      316                   end.
      317               end.
      318           end.
      319       end.
      320   end procedure.
      321   MAIN-BLOCK:
      322   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      323      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      324     run gbl/conf-rd.p ("pr-rndmt", 0, "", 0, "", "", "", no, output par-pr-rndmt, output par-type) no-error.
      325     run gbl/conf-rd.p ("pr-rndbs", 0, "", 0, "", "", "", no, output par-pr-rndbs, output par-type) no-error.
      326     assign
      327       round-method = par-pr-rndmt
      328       round-base   = decimal (par-pr-rndbs)
      329       no-error.
      330     case par-pr-rndmt:
      331       when "pr-round-9end" then
      332         round-method = '9-окончание':U.
      333       when "pr-round-9-99end" then
      334         round-method = '9-99окончание':U.
      335       when "pr-round-integer" then
      336         round-method = 'Без-дробных':U.
      337       when "pr-round-select" then
      338         round-method = 'Произвольно':U.
      339       when "pr-round-up" then
      340         round-method = 'Вверх':U.
      341       when "pr-round-coef" then
      342         round-method = 'Коэффициент':U.
      343       when "pr-round-off" then
      344         round-method = 'Отключено':U.
      345       otherwise
      346         round-method = 'Отключено':U.
      347     end case.
      348     case parwith-tax:
      349     when 1 then do:
      350       assign editor-1 = "Оптовый(без НП) процент наценки/скидки к учетной цене без НДС поставщика".
      351     end.
      352     when 2 then do:
      353       assign editor-1 = "Оптовый(без НП) процент наценки/скидки к учетной цене c НДС поставщика".
      354     end.
      355     when 3 then do:
      356       assign editor-1 = "Безналоговый процент наценки/скидки к учетной цене без НДС и НП поставщика".
      357     end.
      358     end case.
      359     RUN enable_UI.
      360     WAIT-FOR GO OF FRAME Dialog-Frame.
      361   END.
      362   RUN disable_UI.
      363   PROCEDURE disable_UI :
      364     HIDE FRAME Dialog-Frame.
      365   END PROCEDURE.
      366   PROCEDURE enable_UI :
      367     DISPLAY EDITOR-1 varpc
      368         WITH FRAME Dialog-Frame.
      369     ENABLE b-ok b-cancel b-help varpc
      370            round-method
      371            WITH FRAME Dialog-Frame.
      372     VIEW FRAME Dialog-Frame.
      373     if input frame Dialog-Frame round-method = "" then do:
      374       round-method = 'Отключено':U.
      375       disp round-method with frame Dialog-Frame.
      376     end.
      377     if lookup( input frame Dialog-Frame round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
      378       enable round-base with frame Dialog-Frame.
      379       disp round-base with frame Dialog-Frame.
      380     end.
      381     else
      382       hide round-base in frame Dialog-Frame.
      383   END PROCEDURE.
