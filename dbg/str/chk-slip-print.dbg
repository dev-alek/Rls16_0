        1   block-level on error undo, throw.
        2   define input parameter p-db-num as integer no-undo .
        3   define input parameter p-ID as character no-undo .
        4   define input parameter p-CheckId as character no-undo .
        5   define input parameter p-RRN as character no-undo .
        6   define input parameter p-print-type as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: 495342954825, 3030, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        9   define variable vss-date        as character no-undo init "$Date: Пт апр 29 17:03:44 2022 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: chk-slip-print.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/chk-slip-print.p $":U .
       12   define variable vss-description as character no-undo init "Печать слипов чека".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable v-slip-txt as character no-undo .
       68   define variable v-slip-txt-list as character no-undo .
       69   define variable cmd as character no-undo .
       70   define stream out-slip .
       71   define buffer chk-slip-head for ub.chk-slip-head .
       72   define buffer chk-slip-string for ub.chk-slip-string .
       73   define variable v-file-name as character no-undo.
       74   define variable vok as logical no-undo.
       75   define variable ii as integer no-undo .
       76   SYSTEM-DIALOG GET-FILE v-file-name
       77       TITLE "Сохранить как"
       78       FILTERS
       79         " Файл PDF(*.pdf) " "*.pdf",
       80         " Все файлы (*.*) " "*.*"
       81       ask-overwrite
       82       save-as
       83       use-filename
       84       update vok
       85       default-extension "pdf"
       86       .
       87   if not vok THEN do:
       88     return .
       89   end.
       90   case p-print-type :
       91     when "one"
       92     then do :
       93       v-slip-txt = "slip_" + p-ID .
       94       output stream out-slip to value(v-slip-txt) convert target "UTF-8" .
       95         for each chk-slip-string no-lock where chk-slip-string.db-num = p-db-num
       96                                            and chk-slip-string.ID = p-ID
       97                                            and chk-slip-string.CheckID = p-CheckId
       98                                            and chk-slip-string.RRN = p-RRN
       99                                            and chk-slip-string.str-num < 10000
      100                                            by chk-slip-string.str-num
      101                                            :
      102           put stream out-slip unformatted chk-slip-string.str-value skip .
      103         end .
      104       output stream out-slip close .
      105       cmd = substitute('&1 -n="&2" -o="&3"', search("exe/slip2pdf.exe"), search(v-slip-txt), v-file-name) .
      106     end .
      107     when "all"
      108     then do :
      109       v-slip-txt-list = "" .
      110       for each chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      111                                        and chk-slip-head.CheckID = p-CheckId
      112                                        :
      113         v-slip-txt = "slip_" + chk-slip-head.ID .
      114         output stream out-slip to value(v-slip-txt) convert target "UTF-8" .
      115           for each chk-slip-string no-lock where chk-slip-string.db-num = chk-slip-head.db-num
      116                                              and chk-slip-string.ID = chk-slip-head.ID
      117                                              and chk-slip-string.CheckID = chk-slip-head.CheckId
      118                                              and chk-slip-string.RRN = chk-slip-head.RRN
      119                                              and chk-slip-string.str-num < 10000
      120                                              by chk-slip-string.str-num
      121                                              :
      122             put stream out-slip unformatted chk-slip-string.str-value skip .
      123           end .
      124         output stream out-slip close .
      125         v-slip-txt-list = v-slip-txt-list + search(v-slip-txt) + "," .
      126       end .
      127       v-slip-txt-list = trim(v-slip-txt-list, ",") .
      128       cmd = substitute('&1 -n="&2" -o="&3"', search("exe/slip2pdf.exe"), v-slip-txt-list, v-file-name) .
      129     end .
      130     when "all_pay"
      131     then do :
      132       v-slip-txt-list = "" .
      133       for each chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      134                                        and chk-slip-head.CheckID = p-CheckId
      135                                        and chk-slip-head.RRN = p-RRN
      136                                        :
      137         v-slip-txt = "slip_" + chk-slip-head.ID .
      138         output stream out-slip to value(v-slip-txt) convert target "UTF-8" .
      139           for each chk-slip-string no-lock where chk-slip-string.db-num = chk-slip-head.db-num
      140                                              and chk-slip-string.ID = chk-slip-head.ID
      141                                              and chk-slip-string.CheckID = chk-slip-head.CheckId
      142                                              and chk-slip-string.RRN = chk-slip-head.RRN
      143                                              and chk-slip-string.str-num < 10000
      144                                              by chk-slip-string.str-num
      145                                              :
      146             put stream out-slip unformatted chk-slip-string.str-value skip .
      147           end .
      148         output stream out-slip close .
      149         v-slip-txt-list = v-slip-txt-list + search(v-slip-txt) + "," .
      150       end .
      151       v-slip-txt-list = trim(v-slip-txt-list, ",") .
      152       cmd = substitute('&1 -n="&2" -o="&3"', search("exe/slip2pdf.exe"), v-slip-txt-list, v-file-name) .
      153     end .
      154   end case .
      155   os-command silent value(cmd) .
      156   if p-print-type = "one"
      157   then do :
      158     os-delete value(v-slip-txt) no-error .
      159   end .
      160   else do :
      161     do ii = 1 to num-entries(v-slip-txt-list) :
      162       v-slip-txt = entry(ii, v-slip-txt-list) .
      163       os-delete value(v-slip-txt) no-error .
      164     end .
      165   end .
