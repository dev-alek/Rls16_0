        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-hndllib from propath.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Библиотека процедур для работы с атрибутами документа":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new global shared variable g#trdcalib as handle no-undo.
       69   if valid-handle( g#trdcalib ) and g#trdcalib <> this-procedure :handle then do:
       70     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 0 ) vss-description skip( 1 )
       71             "trdcalib.p: попытка повторной загрузки библиотеки" skip( 1 )
       72             g#trdcalib                     skip( 0 )
       73             g#trdcalib     :type           skip( 0 )
       74             g#trdcalib     :file-name      skip( 0 )
       75             valid-handle( g#trdcalib     ) skip( 0 )
       76             this-procedure :handle         skip( 0 )
       77             this-procedure :type           skip( 0 )
       78             this-procedure :file-name      skip( 0 )
       79             valid-handle( this-procedure ) skip( 0 )
       80     view-as alert-box error title " О Ш И Б К А  ! ! ! ".
       81     undo, return error "trdcalib.p: попытка повторной загрузки библиотеки".
       82   end.
       83   else do:
       84     assign
       85       g#trdcalib = this-procedure :handle
       86     .
       87     def var gbl-hndllibObj as class gbl-hndllib no-undo.
       88     gbl-hndllibObj = new gbl-hndllib ().
       89     gbl-hndllibObj:InitHndl("g#trdcalib", g#trdcalib).
       90     delete object gbl-hndllibObj.
       91   end.
       92   on delete of this-procedure do:
       93     assign
       94       g#trdcalib = ?
       95     .
       96     def var gbl-hndllibObj as class gbl-hndllib no-undo.
       97     gbl-hndllibObj = new gbl-hndllib ().
       98     gbl-hndllibObj:InitHndl("g#trdcalib", g#trdcalib).
       99     delete object gbl-hndllibObj.
      100   end.
      101   procedure trdcalib_tdat-val :
      102     define  input parameter p-doc-code like ub.doc-attr.doc-code   no-undo.
      103     define  input parameter p-code     like ub.doc-attr.attr-code  no-undo.
      104     define output parameter p-value    like ub.doc-attr.attr-value no-undo.
      105     define output parameter p-type     as   character              no-undo.
      106     define buffer buf_doc-attr for ub.doc-attr.
      107     define variable v-format         as character no-undo.
      108     define variable v-fillin_width   as integer   no-undo.
      109     define variable v-fillin_height  as integer   no-undo.
      110     define variable v-label          as character no-undo.
      111     define variable v-user-can-edit  as logical   no-undo.
      112     define variable v-output-display as logical   no-undo.
      113     define variable v-other          as character no-undo.
      114     define variable v-proc-attr       as character no-undo .
      115     define variable v-full-screen-val as character no-undo .
      116     define variable v-sort as integer   no-undo .
      117     do on error undo, return error return-value :
      118   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input p-code ,
      119                          output p-type ,
      120                          output v-format ,
      121                          output v-fillin_width ,
      122                          output v-fillin_height ,
      123                          output v-label ,
      124                          output v-user-can-edit ,
      125                          output v-output-display ,
      126                          output v-other  ,
      127                          output v-proc-attr ,
      128                          output v-full-screen-val ,
      129                          output v-sort
      130                          ) no-error .
      131       if error-status :error then do: undo, return error return-value. end.
      132       find first buf_doc-attr no-lock where
      133                  buf_doc-attr.doc-code  = p-doc-code and
      134                  buf_doc-attr.attr-code = p-code     no-error.
      135       assign p-value = ( if available buf_doc-attr then buf_doc-attr.attr-value else
      136                        ( if p-type = 'L':U then "no":U else "":U ) ).
      137     end.
      138   end procedure.
