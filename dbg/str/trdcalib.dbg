      298   procedure trdcalib_tdat-del :
      299     define  input parameter p-doc-code like ub.doc-attr.doc-code  no-undo.
      300     define  input parameter p-code     like ub.doc-attr.attr-code no-undo.
      301     define output parameter p-deleted  as   logical               no-undo.
      302     define buffer buf_doc-attr for ub.doc-attr.
      303     define variable v-type           as character no-undo.
      304     define variable v-format         as character no-undo.
      305     define variable v-fillin_width   as integer   no-undo.
      306     define variable v-fillin_height  as integer   no-undo.
      307     define variable v-label          as character no-undo.
      308     define variable v-user-can-edit  as logical   no-undo.
      309     define variable v-output-display as logical   no-undo.
      310     define variable v-other          as character no-undo.
      311     define variable v-proc-attr       as character no-undo .
      312     define variable v-full-screen-val as character no-undo .
      313     define variable v-sort as integer   no-undo .
      314     do on error undo, return error return-value :
      315   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input p-code ,
      316                          output v-type ,
      317                          output v-format ,
      318                          output v-fillin_width ,
      319                          output v-fillin_height ,
      320                          output v-label ,
      321                          output v-user-can-edit ,
      322                          output v-output-display ,
      323                          output v-other  ,
      324                          output v-proc-attr ,
      325                          output v-full-screen-val ,
      326                          output v-sort
      327                          ) no-error .
      328       if error-status :error then do: undo, return error return-value. end.
      329       find first buf_doc-attr exclusive-lock where
      330                  buf_doc-attr.doc-code  = p-doc-code and
      331                  buf_doc-attr.attr-code = p-code     no-error no-wait.
      332       if not available buf_doc-attr then do:
      333         assign p-deleted = no.
      334       end.
      335       else do:
      336         delete buf_doc-attr.
      337         assign p-deleted = yes.
      338       end.
      339     end.
      340   end procedure.
      341   procedure trdcalib_tdat-cod :
      342     define  input parameter p-code           as character no-undo.
      343     define output parameter p-type           as character no-undo.
      344     define output parameter p-format         as character no-undo.
      345     define output parameter p-fillin_width   as integer   no-undo.
      346     define output parameter p-fillin_height  as integer   no-undo.
      347     define output parameter p-label          as character no-undo.
      348     define output parameter p-user-can-edit  as logical   no-undo.
      349     define output parameter p-output-display as logical   no-undo.
      350     define output parameter p-other          as character no-undo.
      351     define output parameter p-proc-attr       as character no-undo.
      352     define output parameter p-full-screen-val as character no-undo.
      353     define output parameter p-sort as integer   no-undo .
      354     do on error undo, return error return-value :
      355       case p-code :
      356               when 'hold-part-code':U then do:     assign p-label          = "Номер партии для документа межфирменного перемещения"            p-type           = 'I':U             p-format         = "->>>,>>>,>>9"            p-fillin_width   = 12            p-fillin_height  = 1            p-label          = "Номер партии для документа межфирменного перемещения"            p-user-can-edit  = false            p-output-display = false            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      357               when 'dov':U then do:     assign p-label          = "Доверенность"            p-type           = 'C':U             p-format         = "x(255)"            p-fillin_width   = 70            p-fillin_height  = 3            p-label          = "Доверенность"            p-user-can-edit  = true            p-output-display = true            p-sort           = 45            p-proc-attr      = ''            p-other          = '':u . end.
      358               when 'dids':U then do:     assign p-label          = "Дата приходной накладной поставщика"            p-type           = 'T':U             p-format         = "99/99/9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Дата приходной накладной поставщика"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = 'nws':u . end.
      359               when 'nids':U then do:     assign p-label          = "Номер приходной накладной поставщика"            p-type           = 'C':U             p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Номер приходной накладной поставщика"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = 'nws':u . end.
