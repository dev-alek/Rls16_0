      177   procedure trdcalib_tdat-wrt :
      178     define input parameter p-doc-code like ub.doc-attr.doc-code   no-undo.
      179     define input parameter p-code     like ub.doc-attr.attr-code  no-undo.
      180     define input parameter p-value    like ub.doc-attr.attr-value no-undo.
      181     define buffer buf_doc-attr for ub.doc-attr.
      182     define variable v-proc-attr       as character no-undo .
      183     define variable v-full-screen-val as character no-undo .
      184     define variable v-type           as character no-undo.
      185     define variable v-format         as character no-undo.
      186     define variable v-fillin_width   as integer   no-undo.
      187     define variable v-fillin_height  as integer   no-undo.
      188     define variable v-label          as character no-undo.
      189     define variable v-user-can-edit  as logical   no-undo.
      190     define variable v-output-display as logical   no-undo.
      191     define variable v-other          as character no-undo.
      192     define variable v-sort           as integer   no-undo .
      193     do on error undo, return error return-value :
      194   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input p-code ,
      195                          output v-type ,
      196                          output v-format ,
      197                          output v-fillin_width ,
      198                          output v-fillin_height ,
      199                          output v-label ,
      200                          output v-user-can-edit ,
      201                          output v-output-display ,
      202                          output v-other  ,
      203                          output v-proc-attr ,
      204                          output v-full-screen-val ,
      205                          output v-sort
      206                          ) no-error .
      207       if error-status :error then do: undo, return error return-value. end.
      208       find first buf_doc-attr exclusive-lock where
      209                  buf_doc-attr.doc-code  = p-doc-code and
      210                  buf_doc-attr.attr-code = p-code     no-error.
      211       if not available buf_doc-attr then do:
      212         create buf_doc-attr.
      213         assign buf_doc-attr.doc-code  = p-doc-code
      214                buf_doc-attr.attr-code = p-code.
      215       end.
      216       assign buf_doc-attr.attr-value = p-value.
      217     end.
      218   end procedure.
