      464               when 'clear-ac':U then do:     assign p-label          = "Произведена зачистка АЦ перед наполнением на ГНС"            p-type           = 'L':U             p-format         = "yes/no"            p-fillin_width   = 4            p-fillin_height  = 1            p-label          = "Произведена зачистка АЦ перед наполнением на ГНС"            p-user-can-edit  = true            p-output-display = true            p-sort           = 200            p-proc-attr      = ''            p-other          = '':u . end.
      465               when 'trdcattr-is-not-close-fact-news':U then do:     assign p-label          = ""            p-type           = 'L':U             p-format         = "yes/no"            p-fillin_width   = 3            p-fillin_height  = 1            p-label          = ""            p-user-can-edit  = false            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      466               when 'trdcattr-prikaz-number':U then do:     assign p-label          = "Приказ: Номер"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Приказ: Номер"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      467               when 'trdcattr-prikaz-date':U then do:     assign p-label          = "Приказ: Дата"            p-type           = 'T':U             p-format         = "99.99.9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Приказ: Дата"            p-user-can-edit  = true            p-output-display = true            p-sort           = 102            p-proc-attr      = ''            p-other          = '':u . end.
      468               when 'trdcattr-inv-date':U then do:     assign p-label          = "Инвентаризация: Дата фактического начала"            p-type           = 'T':U             p-format         = "99.99.9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Инвентаризация: Дата фактического начала"            p-user-can-edit  = true            p-output-display = true            p-sort           = 104            p-proc-attr      = ''            p-other          = '':u . end.
      469               when 'trdcattr-fio-agent':U then do:     assign p-label          = "ФИО председателя комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО председателя комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 106            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      470               when 'trdcattr-pos-agent':U then do:     assign p-label          = "Должность председателя комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность председателя комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 108            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      471               when 'trdcattr-fio-player1':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 110            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      472               when 'trdcattr-pos-player1':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 112            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      473               when 'trdcattr-fio-player2':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 114            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      474               when 'trdcattr-pos-player2':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 116            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      475               when 'trdcattr-fio-player3':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 118            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      476               when 'trdcattr-pos-player3':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 120            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      477               when 'sugtpattr-massa-sug':U then do:     assign p-label          = "Масса слитого СУГ на промежуточных станциях АГЗС, кг"            p-type           = 'D':U             p-format         = "->,>>>,>>>,>>9.999"            p-fillin_width   = 20            p-fillin_height  = 1            p-label          = "Масса слитого СУГ на промежуточных станциях АГЗС, кг"            p-user-can-edit  = true            p-output-display = true            p-sort           = 130            p-proc-attr      = ''            p-other          = 'nws':u . end.
      478               when 'sugtpattr-teh-loss':U then do:     assign p-label          = "Технологические потери предыдущих станций, кг"            p-type           = 'D':U             p-format         = "->,>>>,>>>,>>9.999"            p-fillin_width   = 20            p-fillin_height  = 1            p-label          = "Технологические потери предыдущих станций, кг"            p-user-can-edit  = true            p-output-display = true            p-sort           = 131            p-proc-attr      = ''            p-other          = 'nws':u . end.
      479               when 'sugtpattr-err-allow':U then do:     assign p-label          = "Допустимые погрешности предыдущих станций, кг"            p-type           = 'D':U             p-format         = "->,>>>,>>>,>>9.999"            p-fillin_width   = 20            p-fillin_height  = 1            p-label          = "Допустимые погрешности предыдущих станций, кг"            p-user-can-edit  = true            p-output-display = true            p-sort           = 132            p-proc-attr      = ''            p-other          = 'nws':u . end.
      480               when 'date-income':U then do:     assign p-label          = "Дата прибытия на АЗС"            p-type           = 'T':U             p-format         = "99/99/9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Дата прибытия на АЗС"            p-user-can-edit  = true            p-output-display = true            p-sort           = 180            p-proc-attr      = ''            p-other          = '':u . end.
      481               when 'date-pasport':U then do:     assign p-label          = "Паспорт качества дата"            p-type           = 'T':U             p-format         = "99/99/9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Паспорт качества дата"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      482               when 'num-pasport':U then do:     assign p-label          = "Паспорт качества номер"            p-type           = 'C':U             p-format         = "X(20)"            p-fillin_width   = 20            p-fillin_height  = 1            p-label          = "Паспорт качества номер"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      483         otherwise do:
      484           undo, return error substitute( 'неизвестный атрибут документа "&1"', p-code ).
      485         end.
      486       end case.
      487     end.
      488   end procedure.
      489   procedure trdcalib_tdatinv-cod :
      490     define  input parameter p-code           as character no-undo.
      491     define output parameter p-type           as character no-undo.
      492     define output parameter p-format         as character no-undo.
      493     define output parameter p-fillin_width   as integer   no-undo.
      494     define output parameter p-fillin_height  as integer   no-undo.
      495     define output parameter p-label          as character no-undo.
      496     define output parameter p-user-can-edit  as logical   no-undo.
      497     define output parameter p-output-display as logical   no-undo.
      498     define output parameter p-other          as character no-undo.
      499     define output parameter p-proc-attr       as character no-undo.
      500     define output parameter p-full-screen-val as character no-undo.
      501     define output parameter p-sort as integer   no-undo .
      502     do on error undo, return error return-value :
      503       case p-code :
      504               when 'trdcattr-prikaz-number':U then do:     assign p-label          = "Приказ: Номер"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Приказ: Номер"            p-user-can-edit  = true            p-output-display = true            p-sort           = 100            p-proc-attr      = ''            p-other          = '':u . end.
      505               when 'trdcattr-prikaz-date':U then do:     assign p-label          = "Приказ: Дата"            p-type           = 'T':U             p-format         = "99.99.9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Приказ: Дата"            p-user-can-edit  = true            p-output-display = true            p-sort           = 102            p-proc-attr      = ''            p-other          = '':u . end.
      506               when 'trdcattr-inv-date':U then do:     assign p-label          = "Инвентаризация: Дата фактического начала"            p-type           = 'T':U             p-format         = "99.99.9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Инвентаризация: Дата фактического начала"            p-user-can-edit  = true            p-output-display = true            p-sort           = 104            p-proc-attr      = ''            p-other          = '':u . end.
      507               when 'trdcattr-fio-agent':U then do:     assign p-label          = "ФИО председателя комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО председателя комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 106            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      508               when 'trdcattr-pos-agent':U then do:     assign p-label          = "Должность председателя комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность председателя комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 108            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      509               when 'trdcattr-fio-player1':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 110            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      510               when 'trdcattr-pos-player1':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 112            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      511               when 'trdcattr-fio-player2':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 114            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      512               when 'trdcattr-pos-player2':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 116            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      513               when 'trdcattr-fio-player3':U then do:     assign p-label          = "ФИО участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "ФИО участника комиссии"            p-user-can-edit  = true            p-output-display = true            p-sort           = 118            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      514               when 'trdcattr-pos-player3':U then do:     assign p-label          = "Должность участника комиссии"            p-type           = 'C':U             p-format         = "X(70)"            p-fillin_width   = 70            p-fillin_height  = 1            p-label          = "Должность участника комиссии"            p-user-can-edit  = false            p-output-display = false            p-sort           = 120            p-proc-attr      = ''            p-other          = 'nws':u . p-proc-attr = "''"  .  end.
      515         otherwise do:
      516           undo, return error substitute( 'неизвестный атрибут документа "&1"', p-code ).
      517         end.
      518       end case.
      519     end.
      520   end procedure.
      521   procedure trdcalib_tdat-oth :
      522     define input parameter p-doc-code as character no-undo.
      523     define input parameter p-code     as character no-undo.
      524     define input parameter p-value    as character no-undo.
      525     define variable v-type           as character no-undo.
      526     define variable v-format         as character no-undo.
      527     define variable v-fillin_width   as integer   no-undo.
      528     define variable v-fillin_height  as integer   no-undo.
      529     define variable v-label          as character no-undo.
      530     define variable v-user-can-edit  as logical   no-undo.
      531     define variable v-output-display as logical   no-undo.
      532     define variable v-other          as character no-undo.
      533     define variable v-proc-attr       as character no-undo .
      534     define variable v-full-screen-val as character no-undo .
      535     define variable v-sort as integer   no-undo .
      536     define buffer buf_doc-attr for ub.doc-attr.
      537     define buffer nakl_trn-doc for ub.trn-doc.
      538     define buffer bf_trn-doc   for ub.trn-doc.
      539     do on error undo, return error return-value :
      540   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input p-code ,
      541                          output v-type ,
      542                          output v-format ,
      543                          output v-fillin_width ,
      544                          output v-fillin_height ,
      545                          output v-label ,
      546                          output v-user-can-edit ,
      547                          output v-output-display ,
      548                          output v-other  ,
      549                          output v-proc-attr ,
      550                          output v-full-screen-val ,
      551                          output v-sort
      552                          ) no-error .
      553       if lookup( 'rsrv-date':u, v-other ) > 0 and p-value <> "":U then do:
      554          find first bf_trn-doc exclusive-lock where
      555                     bf_trn-doc.doc-code = p-doc-code.
      556          assign bf_trn-doc.flora-order-date = date( p-value ).
      557          find first nakl_trn-doc exclusive-lock where
      558                     nakl_trn-doc.doc-code = bf_trn-doc.out-code no-error.
      559           if not error-status :error then do:
      560             assign nakl_trn-doc.flora-order-date = date( p-value ).
      561           end.
      562       end.
      563       if lookup( "postdchek":U, v-other ) > 0 and p-value <> "":U then do:
      564         find first bf_trn-doc exclusive-lock where
      565                    bf_trn-doc.doc-code = p-doc-code.
      566         assign bf_trn-doc.flora-pay-date = date( p-value ).
      567         find first nakl_trn-doc exclusive-lock where
      568                    nakl_trn-doc.doc-code = bf_trn-doc.out-code no-error.
      569         if not error-status :error then do:
      570           assign nakl_trn-doc.flora-pay-date  = date( p-value ).
      571         end.
      572       end.
      573       if lookup( "nws":U, v-other ) > 0 then do:
      574         find first bf_trn-doc no-lock where
      575                    bf_trn-doc.doc-code = p-doc-code  no-error.
      576         if available bf_trn-doc then do:
      577           find first buf_doc-attr no-lock where
      578                      buf_doc-attr.doc-code  = p-doc-code and
      579                      buf_doc-attr.attr-code = p-code     no-error.
      580           run str/callnews.p ( input "doc-attr", input ( buffer buf_doc-attr :handle ) ) no-error.
      581           if error-status :error then do:
      582             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      583                     "Невозможно маршрутизировать doc-attr для отправки в новости" skip( 0 )
      584                     "Документ:" '"' + bf_trn-doc.doc-code    + '"' skip( 0 )
      585                     "Атрибут:"  '"' + buf_doc-attr.attr-code + '"' skip( 0 )
      586                     error-status :get-message( 1 ) skip( 0 )
      587                     error-status :get-message( 2 ) skip( 0 )
      588                     error-status :get-message( 3 ) skip( 0 )
      589                     "return-value = " return-value skip( 0 )
      590             view-as alert-box error.
      591             undo, return error return-value.
      592           end.
      593         end.
      594         define buffer bf_price-doc for ub.price-doc  .
      595         find first bf_price-doc no-lock where
      596                    bf_price-doc.doc-num = p-doc-code
      597                    no-error.
      598         if available bf_price-doc then do:
      599           find first buf_doc-attr no-lock where
      600                      buf_doc-attr.doc-code  = p-doc-code and
      601                      buf_doc-attr.attr-code = p-code     no-error.
      602           run str/callnews.p ( input "doc-attr", input ( buffer buf_doc-attr :handle ) ) no-error.
      603           if error-status :error then do:
      604             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      605                     "Невозможно маршрутизировать doc-attr для отправки в новости" skip( 0 )
      606                     "Переоценка:" '"' + bf_price-doc.doc-num    + '"' skip( 0 )
      607                     "Атрибут:"  '"' + buf_doc-attr.attr-code + '"' skip( 0 )
      608                     error-status :get-message( 1 ) skip( 0 )
      609                     error-status :get-message( 2 ) skip( 0 )
      610                     error-status :get-message( 3 ) skip( 0 )
      611                     "return-value = " return-value skip( 0 )
      612             view-as alert-box error.
      613             undo, return error return-value.
      614           end.
      615         end.
      616       end.
      617     end.
      618   end procedure.
      619   procedure trdcalib_tdatinv-oth :
      620     define input parameter p-doc-code as character no-undo.
      621     define input parameter p-code     as character no-undo.
      622     define input parameter p-value    as character no-undo.
      623     define variable v-type           as character no-undo.
      624     define variable v-format         as character no-undo.
      625     define variable v-fillin_width   as integer   no-undo.
      626     define variable v-fillin_height  as integer   no-undo.
      627     define variable v-label          as character no-undo.
      628     define variable v-user-can-edit  as logical   no-undo.
      629     define variable v-output-display as logical   no-undo.
      630     define variable v-other          as character no-undo.
      631     define variable v-proc-attr       as character no-undo .
      632     define variable v-full-screen-val as character no-undo .
      633     define variable v-sort as integer   no-undo .
      634     define buffer buf_doc-attr for ub.inv-doc-attr.
      635     define buffer nakl_trn-doc for ub.trn-doc.
      636     define buffer bf_trn-doc   for ub.trn-doc.
      637     do on error undo, return error return-value :
      638   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-cod in g#trdcalib (  input p-code ,
      639                          output v-type ,
      640                          output v-format ,
      641                          output v-fillin_width ,
      642                          output v-fillin_height ,
      643                          output v-label ,
      644                          output v-user-can-edit ,
      645                          output v-output-display ,
      646                          output v-other  ,
      647                          output v-proc-attr ,
      648                          output v-full-screen-val ,
      649                          output v-sort
      650                          ) no-error .
      651       if lookup( "nws":U, v-other ) > 0 then do:
      652         find first bf_trn-doc no-lock where
      653                    bf_trn-doc.doc-code = p-doc-code  no-error.
      654         if available bf_trn-doc then do:
      655           find first buf_doc-attr no-lock where
      656                      buf_doc-attr.doc-code  = p-doc-code and
      657                      buf_doc-attr.attr-code = p-code     no-error.
      658           run str/callnews.p ( input "doc-attr", input ( buffer buf_doc-attr :handle ) ) no-error.
      659           if error-status :error then do:
      660             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      661                     "Невозможно маршрутизировать doc-attr для отправки в новости" skip( 0 )
      662                     "Документ:" '"' + bf_trn-doc.doc-code    + '"' skip( 0 )
      663                     "Атрибут:"  '"' + buf_doc-attr.attr-code + '"' skip( 0 )
      664                     error-status :get-message( 1 ) skip( 0 )
      665                     error-status :get-message( 2 ) skip( 0 )
      666                     error-status :get-message( 3 ) skip( 0 )
      667                     "return-value = " return-value skip( 0 )
      668             view-as alert-box error.
      669             undo, return error return-value.
      670           end.
      671         end.
      672         define buffer bf_price-doc for ub.price-doc  .
      673         find first bf_price-doc no-lock where
      674                    bf_price-doc.doc-num = p-doc-code
      675                    no-error.
      676         if available bf_price-doc then do:
      677           find first buf_doc-attr no-lock where
      678                      buf_doc-attr.doc-code  = p-doc-code and
      679                      buf_doc-attr.attr-code = p-code     no-error.
      680           run str/callnews.p ( input "doc-attr", input ( buffer buf_doc-attr :handle ) ) no-error.
      681           if error-status :error then do:
      682             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      683                     "Невозможно маршрутизировать doc-attr для отправки в новости" skip( 0 )
      684                     "Переоценка:" '"' + bf_price-doc.doc-num    + '"' skip( 0 )
      685                     "Атрибут:"  '"' + buf_doc-attr.attr-code + '"' skip( 0 )
      686                     error-status :get-message( 1 ) skip( 0 )
      687                     error-status :get-message( 2 ) skip( 0 )
      688                     error-status :get-message( 3 ) skip( 0 )
      689                     "return-value = " return-value skip( 0 )
      690             view-as alert-box error.
      691             undo, return error return-value.
      692           end.
      693         end.
      694       end.
      695     end.
      696   end procedure.
      697   procedure trdcalib_tdatothn :
      698     define input parameter p-doc-code as character no-undo.
      699     define input parameter p-code     as character no-undo.
      700     define variable v-type           as character no-undo.
      701     define variable v-format         as character no-undo.
      702     define variable v-fillin_width   as integer   no-undo.
      703     define variable v-fillin_height  as integer   no-undo.
      704     define variable v-label          as character no-undo.
      705     define variable v-user-can-edit  as logical   no-undo.
      706     define variable v-output-display as logical   no-undo.
      707     define variable v-other          as character no-undo.
      708     define variable v-proc-attr       as character no-undo .
      709     define variable v-full-screen-val as character no-undo .
      710     define variable v-sort as integer   no-undo .
      711     define buffer buf_doc-attr for ub.doc-attr.
      712     define buffer nakl_trn-doc for ub.trn-doc.
      713     define buffer bf_trn-doc   for ub.trn-doc.
      714     do on error undo, return error return-value :
      715         define buffer bf_price-doc for ub.price-doc  .
      716         find first bf_price-doc no-lock where
      717                    bf_price-doc.doc-num = p-doc-code
      718                    no-error.
      719         if available bf_price-doc then do:
      720           find first buf_doc-attr no-lock where
      721                      buf_doc-attr.doc-code  = p-doc-code and
      722                      buf_doc-attr.attr-code = p-code     no-error.
      723           run str/callnews.p ( input "doc-attr", input ( buffer buf_doc-attr :handle ) ) no-error.
      724           if error-status :error then do:
      725             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      726                     "Невозможно маршрутизировать doc-attr для отправки в новости" skip( 0 )
      727                     "Переоценка:" '"' + bf_price-doc.doc-num    + '"' skip( 0 )
      728                     "Атрибут:"  '"' + buf_doc-attr.attr-code + '"' skip( 0 )
      729                     error-status :get-message( 1 ) skip( 0 )
      730                     error-status :get-message( 2 ) skip( 0 )
      731                     error-status :get-message( 3 ) skip( 0 )
      732                     "return-value = " return-value skip( 0 )
      733             view-as alert-box error.
      734             undo, return error return-value.
      735           end.
      736         end.
      737     end.
      738   end procedure.
