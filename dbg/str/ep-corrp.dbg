      716   end.
      717   assign
      718     varprice-base-conscl = varprice-base-conscl / varcons-qntycl
      719     varprice-rubl-conscl = varprice-rubl-conscl / varcons-qntycl.
      720   if varprice-base-conscl = ? then do:
      721     assign
      722       varprice-base-conscl = 0.
      723   end.
      724   if varprice-rubl-conscl = ? then do:
      725     assign
      726       varprice-rubl-conscl = 0.
      727   end.
      728   assign
      729     varsum-base-factovpcl     = 0
      730     varslt-base-factovpcl     = 0
      731     varvat-base-factovpcl     = 0
      732     varvatcons-base-factovpcl = 0
      733     vardsc-base-factovpcl     = 0
      734     varsum-base-docovpcl      = 0
      735     varslt-base-docovpcl      = 0
      736     varvat-base-docovpcl      = 0
      737     varvatcons-base-docovpcl  = 0
      738     vardsc-base-docovpcl      = 0
      739     varsum-rubl-factovpcl     = 0
      740     varslt-rubl-factovpcl     = 0
      741     varvat-rubl-factovpcl     = 0
      742     varvatcons-rubl-factovpcl = 0
      743     vardsc-rubl-factovpcl     = 0
      744     varsum-rubl-docovpcl      = 0
      745     varslt-rubl-docovpcl      = 0
      746     varvat-rubl-docovpcl      = 0
      747     varvatcons-rubl-docovpcl  = 0
      748     vardsc-rubl-docovpcl      = 0.
      749   assign
      750     varis-one-gds-dtlcl = no.
      751   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      752                                        out-vatp_gds-dtlcl.artic     = parartic     and
      753                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      754                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      755   if available out-vatp_gds-dtlcl then do:
      756     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      757                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
      758                                              buf_out-vatp_gds-dtlcl.prod-type =  parprod-type               and
      759                                              buf_out-vatp_gds-dtlcl.prod-code =  parprod-code               and
      760                                              recid(buf_out-vatp_gds-dtlcl)    <> recid(out-vatp_gds-dtlcl) no-lock no-error.
      761     if not available buf_out-vatp_gds-dtlcl then do:
      762       assign
      763         varis-one-gds-dtlcl = yes.
      764     end.
      765     if varoutvprbcl = "base":u then do:
      766       assign
      767         varcurclprice-base = out-vatp_gds-dtlcl.cur-base
      768         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
      769     end.
      770     else do:
      771       assign
      772         varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
      773         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
      774     end.
      775     if varempty-scalecl    = yes or
      776        varis-one-gds-dtlcl = yes   then do:
      777       assign
      778                   price-base-with-tax-salecl    = (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)
      779           slt-base-salecl               = (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc)
      780           vat-base-buyercl              = (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl) * parvat-pc / (100 + parvat-pc)
      781           discnt-base-salecl            = out-vatp_gds-dtlcl.discnt-base
      782                   price-rubl-with-tax-salecl    = (out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl)
      783           slt-rubl-salecl               = (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc)
      784           vat-rubl-buyercl              = (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl) * parvat-pc / (100 + parvat-pc)
      785           discnt-rubl-salecl            = out-vatp_gds-dtlcl.discnt-rubl
      786           .
      787       if pardoc-type = 'инв':U then do:
