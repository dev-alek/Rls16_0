      480   do on error undo, return error return-value :
      481   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      482   for each bf_tt-allsum on error undo, return error return-value :
      483     delete bf_tt-allsum.
      484   end.
      485   assign
      486     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      487     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      488   .
      489   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      491     (output varinvprbcl
      492     )  .
      493     if cl_tt-clcparts.out-code = 'free-zone':U     or
      494        cl_tt-clcparts.out-code = 'out-zone':U   or
      495        cl_tt-clcparts.doc-type = 'акт':U then do:
      496       assign
      497         in-vatp-have-vat-sltcl = yes.
      498     end.
      499     else do:
      500       find first in-vatp_doc-attrcl no-lock
      501         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      502           and in-vatp_doc-attrcl.attr-code = 'envd':U
      503         no-error .
      504       if not available in-vatp_doc-attrcl then do:
      505         assign
      506           in-vatp-have-vat-sltcl = yes.
      507       end.
      508       else do:
      509            in-vatp-have-vat-sltcl = no.
      510       end.
      511     end.
      512     assign
      513      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      514      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      515     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      516              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      517     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      518             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      519             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      520             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      521             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      522             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      523             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      524       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      525     assign
      526       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      527     assign
      528       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      529       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      530       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      531       transport-cli-loccl  = 0
      532       other-cli-loccl      = 0
      533     .
      534   ASSIGN
      535             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      536       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      537   .
      538   if paris-doc then do:
      539     assign
      540       parartic     = cl_tt-clcparts.artic
      541       parprod-type = cl_tt-clcparts.prod-type
      542       parprod-code = cl_tt-clcparts.prod-code
      543       pardoc-type  = cl_tt-clcparts.doc-type
      544       pardoc-code  = cl_tt-clcparts.out-code
      545       parobj-type  = cl_tt-clcparts.obj-type
      546       parobj-code  = cl_tt-clcparts.obj-code.
      547   if parext-doc-type = 'ot':U or
      548      parext-doc-type = ?                 then do:
      549     assign
      550      out-vatp-have-vat-sltcl = yes.
      551   end.
      552   else do:
      553     find first out-vatp_doc-attrcl no-lock
      554       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      555         and out-vatp_doc-attrcl.attr-code = 'envd':U
      556         no-error .
      557     if not available out-vatp_doc-attrcl then do:
      558       assign
      559         out-vatp-have-vat-sltcl = yes.
      560     end.
      561     else do:
      562        out-vatp-have-vat-sltcl = no.
      563     end.
      564   end.
      565   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      566                                      out-vatp_goodscl.prod-type = parprod-type and
      567                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      568   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      570     (input  parartic
      571     ,input  parprod-type
      572     ,input  parprod-code
      573     ,output varroot-nodecl
      574     ) no-error .
      575   if error-status :error then do:
      576     message
      577       vss-workfile vss-revision vss-description skip
      578       "Ошибка при определении корневого признака товара" skip
      579       "Артикул" parartic parprod-type parprod-code skip
      580       error-status :get-message(1) skip
      581       return-value skip
      582       view-as alert-box error .
      583     undo, return error .
      584   end.
      585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      586     (input  varroot-nodecl
      587     ,input  'empty-scale=request'
      588     ,output varempty-scalecl
      589     ) no-error .
      590   if error-status :error then do:
      591     message
      592       vss-workfile vss-revision vss-description skip
      593       "Ошибка при определении атрибута признака" skip
      594       "Артикул" parartic parprod-type parprod-code skip
      595       "Признак" varroot-nodecl skip
      596       "Запрашивался атрибут" "empty-scale=request" skip
      597       error-status :get-message(1) skip
      598       return-value skip
      599       view-as alert-box error .
      600     undo, return error .
      601   end.
      602   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      604     (output varoutvprbcl
      605     )  .
      606   if varoutvprbcl = "base":u then do:
      607     assign
      608           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      609       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      610     .
      611   end.
      612   else do:
      613     assign
      614           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      615       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      616     .
      617   end.
      618   if varoutvprbcl = "rubl":u then do:
      619     assign
      620           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      621       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      622   end.
      623   else do:
      624     assign
      625           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      626       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      627   end.
      628   assign
      629     varis-cons-parts-havecl =  no.
      630   assign
      631     varfact-qntycl       = 0
      632     varcons-qntycl       = 0
      633     varprice-base-conscl = 0
      634     varprice-rubl-conscl = 0.
      635   find first out-vatp_doc-linecl where
      636              out-vatp_doc-linecl.doc-code   = pardoc-code
      637          and out-vatp_doc-linecl.artic      = parartic
      638          and out-vatp_doc-linecl.prod-type  = parprod-type
      639          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      640   if available out-vatp_doc-linecl           and
      641     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      642     assign
      643       varfact-qntycl = out-vatp_doc-linecl.fact-qnty.
      644   end.
      645   else do:
      646     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
      647                                  and out-vatp_partscl.obj-type   = parobj-type
      648                                  and out-vatp_partscl.obj-code   = parobj-code
      649                                  and out-vatp_partscl.artic      = parartic
      650                                  and out-vatp_partscl.prod-type  = parprod-type
      651                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      652       if out-vatp_partscl.purch-code = 2 then do:
      653   assign
      654     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
      655     price-base-with-tax-lococl = out-vatp_partscl.price-base
      656   .
      657   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      659     (output varinvprbocl
      660     )  .
      661     if out-vatp_partscl.out-code = 'free-zone':U     or
      662        out-vatp_partscl.out-code = 'out-zone':U   or
      663        out-vatp_partscl.doc-type = 'акт':U then do:
      664       assign
      665         in-vatp-have-vat-sltocl = yes.
      666     end.
      667     else do:
      668       find first in-vatp_doc-attrocl no-lock
      669         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
      670           and in-vatp_doc-attrocl.attr-code = 'envd':U
      671         no-error .
      672       if not available in-vatp_doc-attrocl then do:
      673         assign
      674           in-vatp-have-vat-sltocl = yes.
      675       end.
      676       else do:
      677            in-vatp-have-vat-sltocl = no.
      678       end.
      679     end.
      680     assign
      681      price-cli-with-tax-lococl = out-vatp_partscl.price-cli
      682      cli-base-rateocl          = out-vatp_partscl.cli-base-rate.
      683     ASSIGN   road-tax-base-lococl  = (if out-vatp_partscl.road-tax-base  = ? then 0 else out-vatp_partscl.road-tax-base)
      684              road-tax-rubl-lococl  = (if out-vatp_partscl.road-tax-rubl  = ? then 0 else out-vatp_partscl.road-tax-rubl).
      685     ASSIGN  transport-base-lococl = (if out-vatp_partscl.transport-base = ? then 0 else out-vatp_partscl.transport-base)
      686             transport-rubl-lococl = (if out-vatp_partscl.transport-rubl = ? then 0 else out-vatp_partscl.transport-rubl)
      687             other-base-lococl     = (if out-vatp_partscl.other-base     = ? then 0 else out-vatp_partscl.other-base)
      688             other-rubl-lococl     = (if out-vatp_partscl.other-rubl     = ? then 0 else out-vatp_partscl.other-rubl)
      689             vat-pc-lococl         = (if out-vatp_partscl.vat-pc         = ? then 0 else out-vatp_partscl.vat-pc)
      690             slt-pc-lococl         = (if out-vatp_partscl.slt-pc         = ? then 0 else out-vatp_partscl.slt-pc).
      691             ASSIGN   slt-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      692       ASSIGN   slt-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      693     assign
      694       exch-rate-cli-lococl = (out-vatp_partscl.price-rubl - transport-rubl-lococl - other-rubl-lococl - road-tax-rubl-lococl - (if out-vatp_partscl.vat-type <> 'в т. ч.':U then vat-rubl-lococl else 0) - (if out-vatp_partscl.slt-type <> 'в т. ч.':U then slt-rubl-lococl else 0)) / out-vatp_partscl.price-cli .
      695     assign
      696       slt-cli-lococl        = slt-rubl-lococl       / exch-rate-cli-lococl
      697       vat-cli-lococl        = vat-rubl-lococl       / exch-rate-cli-lococl
      698       road-tax-cli-lococl   = road-tax-rubl-lococl  / exch-rate-cli-lococl
      699       transport-cli-lococl  = 0
      700       other-cli-lococl      = 0
      701     .
      702   ASSIGN
      703             price-base-without-tax-lococl = price-base-with-tax-lococl - vat-base-lococl - slt-base-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))
      704       price-rubl-without-tax-lococl = price-rubl-with-tax-lococl - vat-rubl-lococl - slt-rubl-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))
      705   .
      706         assign
