     1809     (input  bf_trn-doc.obj-type
     1810     ,input  bf_trn-doc.obj-code
     1811     ,input  varb-code
     1812     ,input  0
     1813     ,input  bf_trn-doc.fact-order
     1814     ,output vardoc-num
     1815     ,output varprice-sale
     1816     ,output varroad-tax
     1817     ,output varexcise
     1818     )  .
     1819             if varprice-sale = ?
     1820             then do:
     1821               assign
     1822                 varprice-sale = 0
     1823                 varroad-tax   = 0
     1824                 varexcise     = 0
     1825               .
     1826             end.
     1827             assign
     1828               varlastcur-base     = varprice-sale
     1829               varlastcur-road-tax = varroad-tax
     1830               varlastcur-excise   = varexcise
     1831               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1832               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1833               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1834               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1835             .
     1836         end.
     1837       end.
     1838       if varcur-fact-qnty = 0 then do:
     1839         assign
     1840           varcur-base      = varlastcur-base
     1841           varcur-road-tax  = varlastcur-road-tax
     1842           varcur-excise    = varlastcur-excise
     1843         .
     1844       end.
     1845       else do:
     1846         assign
     1847           varcur-base      = varcur-base      / varcur-fact-qnty
     1848           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1849           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1850         .
     1851       end.
     1852       if varcur-vat-pc = ?
     1853       then do:
     1854         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1855       end.
