     1452       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1453       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1454       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1455       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1456       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1457       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1458       bfsacc_tt-allsum.vat-base-doc        = 0
     1459       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1460       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1461       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1462       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1463       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1464       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1465       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1466       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1467       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1468       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1469       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1470       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1471       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1472       bfsacc_tt-allsum.vat-base-cur        = 0
     1473       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1474       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1475       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1476       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1477       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1478       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1479       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1480       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1481       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1482       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1483       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1484       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1485       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1486       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1487       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1488       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1489       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1490       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1491       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1492       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1493       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1494       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1495       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1496       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1497       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1498       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1499       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1500       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1501       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1502       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1503       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1504       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1505       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1506       .
     1507   end.
     1508   otherwise do:
     1509     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1510                              cl_tt-clcparts.purch-code,
     1511                              cl_tt-clcparts.part-code,
     1512                              cl_tt-clcparts.out-code,
     1513                              cl_tt-clcparts.in-code,
     1514                              cl_tt-clcparts.artic,
     1515                              cl_tt-clcparts.prod-type,
     1516                              cl_tt-clcparts.prod-code).
     1517   end.
     1518   end case.
     1519   end.
     1520   end procedure.
     1521   procedure clcprtsl_calc-line :
     1522   define input  parameter parrec-line as recid no-undo.
     1523   define variable v-tax-date         as   date                     no-undo.
     1524   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1525   define variable varr-b             as   character                no-undo.
     1526   define variable varr-btype         as   character                no-undo.
     1527   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1528   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1529   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1530   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1531   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1532   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1533   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1534   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1535   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1536   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1537   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1538   define variable varexcise          like ub.price-list.excise     no-undo.
     1539   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1540   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1541   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1542   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1543   define variable v-varsum           as decimal                  no-undo.
     1544   define variable varprice-salef as decimal   no-undo .
     1545   define buffer bf_trn-doc             for ub.trn-doc.
     1546   define buffer bf_doc-line            for ub.doc-line.
     1547   define buffer bf_gds-dtl             for ub.gds-dtl.
     1548   define buffer bf_goods               for ub.goods.
     1549   define buffer bf_parts               for ub.parts.
     1550   define buffer bf_sysconf             for ub.sysconf.
     1551   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1552   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1553   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1554   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1555   define buffer buf_parts        for ub.parts.
     1556   v-calcbypart = no.
     1557   do on error undo, return error return-value :
     1558   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1560     (output varr-b
     1561     )  .
     1562     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1563     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1564     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1565                               bf_goods.prod-type = bf_doc-line.prod-type and
     1566                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1567     if bf_trn-doc.fact-date <> ?        then do:
     1568       assign v-tax-date = bf_trn-doc.fact-date.
     1569     end.
     1570     else do:
     1571       assign v-tax-date = ?.
     1572     end.
     1573   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1575     (input  bf_goods.gds-code
     1576     ,input  '1':U
     1577     ,input  v-tax-date
     1578     ,input  bf_trn-doc.host-code
     1579     ,input  bf_trn-doc.obj-type
     1580     ,input  bf_trn-doc.obj-code
     1581     ,output v-vat-pc
     1582     ) no-error .
     1583     if error-status :error
     1584     or v-vat-pc = ? then do:
     1585        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1586     end.
     1587     if bf_goods.gds-type = 'у':U or
     1588        bf_trn-doc.status_ = 'запрос':U then do:
     1589       for each bf_tt-allsum-line
     1590       on error undo, return error return-value
     1591        :
     1592         delete bf_tt-allsum-line.
     1593       end.
     1594       create bf_tt-allsum-line.
     1595       assign
     1596        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1597       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1598                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1599                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1600                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1601         assign
     1602           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1603           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1604           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1605           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1606           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1607           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1608           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1609           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1610           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1611           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1612           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1613           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1614           bf_tt-allsum-line.vat-cli-acc          =  ?
     1615           .
     1616       end.
     1617       assign
     1618         bf_tt-allsum-line.cli-qnty             =  ?
     1619         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1620         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1621         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1622         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1623         bf_tt-allsum-line.road-tax-base-doc    =  0
     1624         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1625         bf_tt-allsum-line.excise-base-doc      =  0
     1626         bf_tt-allsum-line.excise-rubl-doc      =  0
     1627         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1628         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1629         bf_tt-allsum-line.dsc-base-cur         =  0
     1630         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1631         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1632         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1633         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1634         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1635         bf_tt-allsum-line.road-tax-base-cur    =  0
     1636         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1637         bf_tt-allsum-line.excise-base-cur      =  0
     1638         bf_tt-allsum-line.excise-rubl-cur      =  0
     1639         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1640         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1641         bf_tt-allsum-line.dsc-base-acc         =  0
     1642         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1643         bf_tt-allsum-line.dsc-cli-acc          =  0
     1644         bf_tt-allsum-line.slt-base-acc         =  0
     1645         bf_tt-allsum-line.slt-rubl-acc         =  0
     1646         bf_tt-allsum-line.slt-cli-acc          =  0
     1647         bf_tt-allsum-line.road-tax-base-acc    =  0
     1648         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1649         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1650         bf_tt-allsum-line.excise-base-acc      =  0
     1651         bf_tt-allsum-line.excise-rubl-acc      =  0
     1652         bf_tt-allsum-line.excise-cli-acc       =  0
     1653         bf_tt-allsum-line.transport-base-acc   =  0
     1654         bf_tt-allsum-line.transport-rubl-acc   =  0
     1655         bf_tt-allsum-line.transport-cli-acc    =  0
     1656         bf_tt-allsum-line.other-base-acc       =  0
     1657         bf_tt-allsum-line.other-rubl-acc       =  0
     1658         bf_tt-allsum-line.other-cli-acc        =  0
     1659         .
     1660       create bfs_tt-allsum-line.
     1661       assign
     1662       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     1663       if bf_trn-doc.doc-type = 'инв':U or
     1664          bf_trn-doc.doc-type = 'при':U    or
     1665          bf_trn-doc.doc-type = 'возврат':U    then do:
     1666          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     1667       end.
     1668       else do:
     1669         assign
     1670           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     1671           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     1672           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     1673           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     1674           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     1675           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     1676           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     1677           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     1678           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     1679           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     1680           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     1681           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     1682           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     1683           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     1684           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     1685           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     1686           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     1687           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     1688           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     1689           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     1690           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     1691           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     1692           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     1693           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
