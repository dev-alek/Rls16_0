     1948   procedure clcprtsl_calc-ttable :
     1949   define input parameter paris-doc           as   logical                 no-undo.
     1950   define input parameter paris-cur           as   logical                 no-undo.
     1951   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1952   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1953   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1954   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1955   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1956   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1957   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1958   define input parameter parr-b              as   character               no-undo.
     1959   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1960   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1961   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1962   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1963   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1964   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1965   define buffer bf_tt-allsum      for tt-allsum.
     1966   define buffer bf_tt-clcparts    for tt-clcparts.
     1967   define buffer bf_tt-allsum-line for tt-allsum-line.
     1968   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1969   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1970   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1971   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1972   define variable varexcise          like ub.price-list.excise     no-undo.
     1973   do on error undo, return error return-value :
     1974   for each bf_tt-allsum-line
     1975   on error undo, return error return-value
     1976    :
     1977     delete bf_tt-allsum-line.
     1978   end.
     1979   for each bf_tt-allsum
     1980   on error undo, return error return-value
     1981   :
     1982     delete bf_tt-allsum.
     1983   end.
     1984   for each bf_tt-clcparts
     1985   on error undo, return error return-value
     1986   :
     1987   if v-calcbypart then do:
     1988             assign
     1989             parcur-base =   bf_tt-clcparts.part-cur-base
     1990             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     1991             parcur-excise =   bf_tt-clcparts.part-cur-excise
     1992             .
     1993   end.
     1994      run clcprtsl_calc-parts in this-procedure (
     1995        input recid(bf_tt-clcparts),
     1996        input paris-doc,
     1997        input paris-cur,
     1998        input parroad-tax,
     1999        input parexcise,
     2000        input parvat-pc,
     2001        input parcons-vat-pc,
     2002        input parslt-pc,
     2003        input parbase-rate,
     2004        input parbase-scale,
     2005        input parr-b,
     2006        input parcur-base,
     2007        input parcur-road-tax,
     2008        input parcur-excise,
     2009        input parcur-vat-pc,
     2010        input parcurcons-vat-pc,
     2011        input parcurslt-pc
     2012        ) no-error.
     2013     if error-status:error then do:
     2014       message
     2015         vss-workfile vss-revision vss-description skip
     2016         vss-include-info0 skip
     2017         "Ошибка при обсчете партии" skip
     2018         "Документ партии " bf_tt-clcparts.out-code skip
     2019         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2020         return-value skip
     2021         error-status:get-message(1) skip
     2022         error-status:get-message(2) skip
     2023         error-status:get-message(3) skip
     2024         view-as alert-box error .
     2025       undo, return error .
     2026     end.
     2027     for each bf_tt-allsum on error undo, return error return-value :
     2028       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2029       if not available bf_tt-allsum-line then do:
     2030         create bf_tt-allsum-line.
     2031         assign
     2032           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2033       end.
     2034       assign
     2035         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2036         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2037         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2038         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2039         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2040         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2041         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2042         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2043         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2044         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2045         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2046         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2047         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2048         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2049         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2050         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2051         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2052         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2053         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2054         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2055         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2056         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2057         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2058         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2059         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2060         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2061         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2062         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2063         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2064         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2065         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2066         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2067         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2068         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2069         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2070         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2071         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2072         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2073         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2074         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2075         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2076         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2077         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2078         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2079         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2080         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2081         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2082         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2083         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2084         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2085         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2086         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2087         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2088         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2089         .
     2090     end.
     2091   end.
     2092   end.
     2093   end procedure.
     2094   define buffer buf_doc-line for ub.doc-line  .
     2095   define buffer buf_trn-doc for ub.trn-doc    .
     2096   define buffer buf_gds-dtl for ub.gds-dtl    .
     2097   define buffer buf_parts for ub.parts  .
     2098   do
     2099   on error undo, return error return-value
     2100   :
     2101   find first buf_trn-doc exclusive-lock where
     2102              buf_trn-doc.doc-code = p-doc-code
     2103              no-error .
     2104     if  buf_trn-doc.ext-doc-type <> 'ep':U then do:
     2105       message "Это не ВОЗВРАТ ПОСТАВЩИКУ!"  view-as alert-box .
     2106       return .
     2107     end.
     2108    for each buf_doc-line exclusive-lock
     2109       where buf_doc-line.doc-code = p-doc-code
     2110    :
     2111       find first buf_parts no-lock where
     2112                  buf_parts.out-code  = p-doc-code and
     2113                  buf_parts.obj-type  = buf_trn-doc.obj-type and
     2114                  buf_parts.obj-code  = buf_trn-doc.obj-code and
     2115                  buf_parts.artic     = buf_doc-line.artic and
     2116                  buf_parts.prod-type = buf_doc-line.prod-type and
     2117                  buf_parts.prod-code = buf_doc-line.prod-code no-error .
     2118       if not available buf_parts then next .
     2119       buf_doc-line.vat-pc =  buf_parts.vat-pc.
     2120       buf_doc-line.slt-pc =  buf_parts.slt-pc.
     2121       empty temp-table tt-allsum-line.
     2122       run clcprtsl_calc-line in this-procedure (
     2123           input recid( buf_doc-line )
     2124       ).
     2125       find first tt-allsum-line
     2126            where tt-allsum-line.sum-type = 'основная_сумма':U
     2127            no-error.
     2128            assign
     2129              buf_doc-line.price-base = tt-allsum-line.sum-dsc-base-acc / buf_doc-line.fact-qnty
     2130              buf_doc-line.price-rubl = tt-allsum-line.sum-dsc-rubl-acc / buf_doc-line.fact-qnty
     2131              buf_doc-line.vat-pc = 100 / ( ( tt-allsum-line.sum-dsc-base-doc / vat-base-doc ) - 1  )
     2132            .
     2133            if buf_doc-line.vat-pc = ? then  buf_doc-line.vat-pc =  0 .
     2134       for each buf_gds-dtl exclusive-lock where
     2135               buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     2136               buf_gds-dtl.artic     = buf_doc-line.artic     and
     2137               buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     2138               buf_gds-dtl.prod-code = buf_doc-line.prod-code  :
     2139            assign
     2140              buf_gds-dtl.price-base = tt-allsum-line.sum-dsc-base-acc / buf_gds-dtl.fact-qnty
     2141              buf_gds-dtl.price-rubl = tt-allsum-line.sum-dsc-rubl-acc / buf_gds-dtl.fact-qnty
     2142            .
     2143       end.
     2144   end.
     2145   release buf_trn-doc.
     2146   find first buf_trn-doc exclusive-lock where
     2147              buf_trn-doc.doc-code = p-doc-code
     2148              no-error .
     2149   run gbl/calc-trn.p (input parparentproc, input recid(buf_trn-doc)) no-error.
     2150   end.
