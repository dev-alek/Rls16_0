      369              end.
      370              when yes then do:
      371                 run inv-perm-plus        .
      372              end.
      373              otherwise do:
      374                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      375              end.
      376            end case.
      377          end.
      378          when 'факт':U then do:
      379             run inv-fact             .
      380          end.
      381          otherwise do:
      382            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      383          end.
      384        end case.
      385      end.
      386      when 'vp':U then do:
      387        case parstatus-current:
      388          when 'накл':U then do:
      389             run peresort-wayb        .
      390          end.
      391          when 'факт':U then do:
      392             run peresort-fact        .
      393          end.
      394          otherwise do:
      395            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      396          end.
      397        end case.
      398      end.
      399      when 'ap':U then do:
      400        case parstatus-current:
      401          when 'накл':U then do:
      402            case parflag-current:
      403              when no then do:
      404                 run cp-wayb-minus        .
      405              end.
      406              otherwise do:
      407                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      408              end.
      409            end case.
      410          end.
      411          when 'факт':U then do:
