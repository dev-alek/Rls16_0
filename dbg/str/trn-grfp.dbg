        1   block-level on error undo, throw.
        2   define input  parameter pardoc-type       like ub.trn-doc.doc-type     no-undo.
        3   define input  parameter parext-doc-type   like ub.trn-doc.ext-doc-type no-undo.
        4   define input  parameter parstatus-current like ub.trn-doc.status_      no-undo.
        5   define input  parameter parflag-current   like ub.trn-doc.flag_        no-undo.
        6   define input  parameter parinternal       like ub.trn-doc.internal     no-undo.
        7   define input  parameter parmode           as   character               no-undo.
        8   define input  parameter parcur-db-num     like ub.db.db-num            no-undo.
        9   define input  parameter pardoc-db-num     like ub.trn-doc.cr-db-num    no-undo.
       10   define input  parameter parcur-db-name    like ub.db.db-name           no-undo.
       11   define input  parameter pardb-num         like ub.db.db-num            no-undo.
       12   define input  parameter pardb-name        like ub.db.db-name           no-undo.
       13   define input  parameter parobj-type       like ub.clients.obj-type     no-undo.
       14   define input  parameter parobj-code       like ub.clients.obj-code     no-undo.
       15   define input  parameter paractive         like ub.store.active         no-undo.
       16   define input  parameter parhold-gen       as   logical                 no-undo.
       17   define output parameter parstatus         like ub.trn-doc.status_      no-undo.
       18   define output parameter parflag           like ub.trn-doc.flag_        no-undo.
       19   define output parameter parcopystatus     like ub.trn-doc.status_      no-undo.
       20   define output parameter parcopyflag       like ub.trn-doc.flag_        no-undo.
       21   def var vss-revision    as character no-undo init "$Revision: 498238e333a5, 491, rls $":U .
       22   def var vss-author      as character no-undo init "$Author: SSlivenko $":U .
       23   def var vss-date        as character no-undo init "$Date: Sun Feb 28 19:23:10 2016 +0400 $":U .
       24   def var vss-workfile    as character no-undo init "$Workfile: trn-grfp.p $":U .
       25   def var vss-archive     as character no-undo init "$Archive: str/trn-grfp.p $":U .
       26   def var vss-description as character no-undo init "Стандартный граф переходов складских документов по параметрам".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45       assign
       46         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,pardoc-type,parext-doc-type,parstatus-current,parflag-current,parinternal,parmode,parcur-db-num,pardoc-db-num),substitute('&1|&2|&3|&4|&5|&6|&7':u,parcur-db-name,pardb-num,pardb-name,parobj-type,parobj-code,paractive,parhold-gen))
       47       .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define variable varmain-for-active-remote as   logical initial no no-undo.
       89   case parcur-db-num:
       90     when 0 then do:
       91       case pardb-num:
       92         when 0 then do:
       93           case paractive:
       94             when paractive = yes then do:
       95             end.
       96             otherwise do:
       97               return error substitute ("Объект базы данных &1 имеет признак пассивный. Объект определен неправильно.", pardb-num).
       98             end.
       99           end case.
      100         end.
      101         otherwise do:
      102           case paractive:
      103             when paractive = yes then do:
      104               assign varmain-for-active-remote = yes.
      105             end.
      106             otherwise do:
      107             end.
      108           end case.
      109         end.
      110       end case.
      111     end.
      112     otherwise do:
      113       case pardb-num:
      114         when 0 then do:
      115           case paractive:
      116             when paractive = yes then do:
      117               return error substitute ("Документ объекта базы данных &1. Появление этого документа на базе данных &2 является критической ошибкой.",
      118                                        pardb-num,
      119                                        parcur-db-num
      120                                        ).
      121             end.
      122             otherwise do:
      123               return error substitute ("Документ объекта базы данных &1. Появление этого документа на базе данных &2 является критической ошибкой.",
      124                                        pardb-num,
      125                                        parcur-db-num
      126                                        ).
      127             end.
      128           end case.
      129         end.
      130         otherwise do:
      131           case paractive:
      132             when paractive = yes then do:
      133               if pardb-num = parcur-db-num then do:
      134               end.
      135               else do:
      136                 return error substitute ('Документ базы данных &1. Появление этого документа в базе данных &2 является критической ошибкой.',
      137                                          pardb-num,
      138                                          parcur-db-num).
      139               end.
      140             end.
      141             otherwise do:
      142               if pardb-num = parcur-db-num then do:
      143                 return error substitute ("Объект базы данных &1 - пассивный, операции с документом невозможны.", pardb-num).
      144               end.
      145               else do:
      146                 return error substitute ('Документ базы данных &1. Появление этого документа в базе данных &2 является критической ошибкой.',
      147                                          pardb-num,
      148                                          parcur-db-num).
      149               end.
      150             end.
      151           end case.
      152         end.
      153       end case.
      154     end.
      155   end case.
      156   assign
      157     parcopystatus = ?
      158     parcopyflag   = ?.
      159   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   do on error undo, return error return-value :
      161   case parext-doc-type:
      162      when 'ie':U then do:
      163         case parstatus-current :
      164           when 'запрос':U then do:
      165              case parflag-current:
      166                when no then do:
      167                   run ext-inc-inq-minus    .
      168                end.
      169                when yes then do:
      170                   run ext-inc-inq-plus     .
      171                end.
      172                otherwise do:
      173                  return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      174                end.
      175              end case.
      176           end.
      177           when 'накл':U then do:
      178              case parflag-current:
      179                 when no then do:
      180                    run ext-inc-wayb-minus   .
      181                 end.
      182                 when yes then do:
      183                    run ext-inc-wayb-plus    .
      184                 end.
      185                 otherwise do:
      186                   return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      187                 end.
      188              end case.
      189           end.
      190           when 'факт':U then do:
      191              run ext-inc-fact         .
      192           end.
      193           otherwise do:
      194             return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      195           end.
      196         end case.
      197      end.
      198      when 'ee':U    or
      199      when 'ep':U then do:
      200         case parstatus-current :
      201           when 'запрос':U then do:
      202             case parflag-current:
      203               when no then do:
      204                  run ext-exp-inq-minus    .
      205               end.
      206               when yes then do:
      207                  run ext-exp-inq-plus     .
      208               end.
      209               otherwise do:
      210                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      211               end.
      212             end case.
      213           end.
      214           when 'накл':U then do:
      215             case parflag-current:
      216               when no then do:
      217                  run ext-exp-wayb-minus   .
      218               end.
      219               when yes then do:
      220                  run ext-exp-wayb-plus    .
      221               end.
      222               otherwise do:
      223                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      224               end.
      225             end case.
      226           end.
      227           when 'разрешен':U then do:
      228             case parflag-current:
      229               when no then do:
      230                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      231               end.
      232               when yes then do:
      233                  run ext-exp-perm-plus    .
      234               end.
      235               otherwise do:
      236                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      237               end.
      238             end case.
      239           end.
      240           when 'факт':U then do:
      241              run ext-exp-fact         .
      242           end.
      243           when 'готов':U or
      244           when 'отказ':U then do:
      245              run ext-exp-fact         .
      246           end.
      247           otherwise do:
      248             return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      249           end.
      250         end case.
      251      end.
      252      when 'we':U then do:
      253         case parstatus-current :
      254           when 'запрос':U then do:
      255             case parflag-current:
      256               when no then do:
      257                  run ext-wroff-inq-minus  .
      258               end.
      259               when yes then do:
      260                  run ext-wroff-inq-plus   .
      261               end.
      262               otherwise do:
      263                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      264               end.
      265             end case.
      266           end.
      267           when 'накл':U then do:
      268             case parflag-current:
      269               when no then do:
      270                  run ext-wroff-wayb-minus .
      271               end.
      272               when yes then do:
      273                  run ext-wroff-wayb-plus  .
      274               end.
      275               otherwise do:
      276                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      277               end.
      278             end case.
      279           end.
      280           when 'разрешен':U then do:
      281             case parflag-current:
      282               when no then do:
      283                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      284               end.
      285               when yes then do:
      286                  run ext-wroff-perm-plus  .
      287               end.
      288               otherwise do:
      289                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      290               end.
      291             end case.
      292           end.
      293           when 'факт':U then do:
      294              run ext-wroff-fact       .
      295           end.
      296           otherwise do:
      297             return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      298           end.
      299         end case.
      300      end.
      301      when 're':U then do:
      302         case parstatus-current :
      303           when 'запрос':U then do:
      304             case parflag-current:
      305               when no then do:
      306                  run ext-ret-inq-minus    .
      307               end.
      308               when yes then do:
      309                  run ext-ret-inq-plus     .
