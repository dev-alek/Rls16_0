      433          end.
      434          otherwise do:
      435            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      436          end.
      437        end case.
      438      end.
      439      when 'iv':U then do:
      440        case parstatus-current:
      441          when 'запрос':U then do:
      442            case parflag-current:
      443              when no then do:
      444                 run int-inc-inq-minus    .
      445              end.
      446              when yes then do:
      447                 run int-inc-inq-plus     .
      448              end.
      449              otherwise do:
      450                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      451              end.
      452            end case.
      453          end.
      454          when 'накл':U then do:
      455            case parflag-current:
      456              when no then do:
      457                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      458              end.
      459              when yes then do:
      460                 run int-inc-wayb-plus    .
      461              end.
      462              otherwise do:
      463                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      464              end.
      465            end case.
      466          end.
      467          when 'факт':U then do:
      468             run int-inc-fact         .
      469          end.
      470          otherwise do:
      471            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      472          end.
      473        end case.
      474      end.
      475      when 'ev':U then do:
      476        case parstatus-current:
      477          when 'запрос':U then do:
      478            case parflag-current:
      479              when no then do:
      480                 run int-exp-inq-minus    .
      481              end.
      482              when yes then do:
      483                 run int-exp-inq-plus     .
      484              end.
      485              otherwise do:
      486                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      487              end.
      488            end case.
      489          end.
      490          when 'накл':U then do:
      491            case parflag-current:
      492              when no then do:
