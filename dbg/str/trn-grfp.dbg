      528              otherwise do:
      529                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      530              end.
      531            end case.
      532          end.
      533          when 'разрешен':U then do:
      534            case parflag-current:
      535              when yes then do:
      536                 run int-ret-perm-plus    .
      537              end.
      538              otherwise do:
      539                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      540              end.
      541            end case.
      542          end.
      543          when 'факт':U then do:
      544             run int-ret-fact         .
      545          end.
      546          otherwise do:
      547            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      548          end.
      549        end case.
      550      end.
      551      when 'eo':U then do:
      552        case parstatus-current:
      553          when 'накл':U then do:
      554            case parflag-current:
      555              when no then do:
      556                 run obj-exp-wayb-minus   .
      557              end.
      558              when yes then do:
      559                 run obj-exp-wayb-plus    .
      560              end.
      561              otherwise do:
      562                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      563              end.
      564            end case.
      565          end.
      566          when 'факт':U then do:
      567             run int-exp-fact         .
      568          end.
      569          otherwise do:
      570            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      571          end.
      572        end case.
      573      end.
      574      when 'io':U then do:
      575        case parstatus-current:
      576          when 'накл':U then do:
      577             run obj-int-wayb         .
      578          end.
      579          when 'факт':U then do:
      580             run int-inc-fact         .
      581          end.
      582          otherwise do:
      583            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      584          end.
      585        end case.
      586      end.
      587      otherwise do:
      588        return error substitute ("Недопустимый расширеный тип &1.", parext-doc-type).
      589      end.
      590   end case.
      591   end.
