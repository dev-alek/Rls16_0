      500              end.
      501            end case.
      502          end.
      503          when 'разрешен':U then do:
      504            case parflag-current:
      505              when yes then do:
      506                 run int-exp-perm-plus    .
      507              end.
      508              otherwise do:
      509                return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      510              end.
      511            end case.
      512          end.
      513          when 'факт':U then do:
