      333               end.
      334               when yes then do:
      335                  run ext-ret-perm-plus    .
      336               end.
      337               otherwise do:
      338                 return error substitute ("Недопустимый тип-статус-флаг &1-&2-&3.", pardoc-type, parstatus-current, parflag-current).
      339               end.
      340             end case.
      341           end.
      342           when 'факт':U then do:
      343              run ext-ret-fact         .
      344           end.
      345           otherwise do:
      346             return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      347           end.
      348         end case.
      349      end.
      350      when 'vt':U then do:
      351        case parstatus-current:
      352          when 'накл':U then do:
      353            case parflag-current:
      354              when no then do:
      355                 run inv-wayb-minus       .
      356              end.
      357              when yes then do:
