      516          otherwise do:
      517            return error substitute ('Недопустимый тип-статус &1-&2 или недопустимое оперирование с документом.', pardoc-type, parstatus-current).
      518          end.
      519        end case.
      520      end.
      521      when 'rv':U then do:
