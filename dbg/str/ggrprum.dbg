     1297   procedure grplib-get-sort-name :
     1298   do
     1299   on error undo, return error
     1300   :
     1301   define input parameter p-node-code  as integer      no-undo.
     1302   define output parameter p-sort-name as character    no-undo.
     1303       define variable v-upper-code    as integer           no-undo.
     1304       define buffer buf_gds-grp       for ub.gds-grp.
     1305       define buffer buf_upper_gds-grp for ub.gds-grp.
     1306       find first buf_gds-grp no-lock
     1307            where buf_gds-grp.node-code = p-node-code
     1308       no-error.
     1309       if not available buf_gds-grp
     1310       then do:
     1311           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1312       end.
     1313       assign
     1314           p-sort-name  = ""
     1315           v-upper-code = 1
     1316       .
     1317       do while buf_gds-grp.upper-code <> 0
     1318       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1319       :
     1320           assign
     1321               p-sort-name  = buf_gds-grp.node-name
     1322                            + (if p-sort-name <> "" then chr(2) else "")
     1323                            + p-sort-name
     1324               v-upper-code = buf_gds-grp.upper-code
     1325           .
     1326           find first buf_gds-grp no-lock
     1327                where buf_gds-grp.node-code = v-upper-code
     1328           no-error.
     1329           if not available buf_gds-grp
     1330           then do:
     1331               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1332                                   + string( v-upper-code )
     1333                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1334           end.
     1335       end.
     1336   end.
     1337   end procedure.
     1338   define variable vss-include-info12 as character format "X(65)" no-undo
     1339   initial "@(#)$Workfile$ $Revision$".
     1340   procedure grplib-get-full-name :
     1341      define input parameter p-node-code  as integer      no-undo.
     1342      define output parameter p-full-name as character    no-undo.
     1343      do
     1344   on error undo, return error
     1345   :
     1346       define variable v-upper-code    as integer           no-undo.
     1347       define buffer buf_gds-grp       for ub.gds-grp.
     1348       define buffer buf_upper_gds-grp for ub.gds-grp.
     1349       find first buf_gds-grp no-lock
     1350            where buf_gds-grp.node-code = p-node-code
     1351       no-error.
     1352       if not available buf_gds-grp
     1353       then do:
     1354           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1355       end.
     1356       assign
     1357           p-full-name  = ""
     1358           v-upper-code = 1
     1359       .
     1360       do while buf_gds-grp.upper-code <> 0
     1361       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1362       :
     1363           assign
     1364               p-full-name  = buf_gds-grp.node-name
     1365                            + (if p-full-name <> "" then chr(47) else "")
     1366                            + p-full-name
     1367               v-upper-code = buf_gds-grp.upper-code
     1368           .
     1369           find first buf_gds-grp no-lock
     1370                where buf_gds-grp.node-code = v-upper-code
     1371           no-error.
     1372           if not available buf_gds-grp
     1373           then do:
     1374               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1375                                   + string( v-upper-code )
     1376                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1377           end.
     1378       end.
     1379       assign
     1380       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1381       .
     1382   end.
     1383   end .
     1384   procedure grplib-get-node-from-full-name :
     1385   define input parameter p-full-name as character no-undo .
     1386   define output parameter p-node-code as integer no-undo .
     1387   define variable v-ii as integer no-undo .
     1388   define variable v-upper-code as integer no-undo .
     1389   define variable v-root-code as integer no-undo .
     1390   define variable v-entry as character no-undo .
     1391   define buffer buf_gds-grp       for ub.gds-grp.
     1392   do
     1393   on error undo, return error
     1394   :
     1395     find first buf_gds-grp no-lock
     1396         where buf_gds-grp.upper-code = 0
     1397     no-error .
     1398     if not available buf_gds-grp
     1399     then do:
     1400         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1401     end.
     1402     else do:
     1403       assign
     1404       v-root-code = buf_gds-grp.node-code
     1405       .
     1406     end.
     1407     v-upper-code = v-root-code.
     1408     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1409       assign
     1410       v-entry = entry(v-ii, p-full-name, chr(47)).
     1411       if v-entry = '' then leave.
     1412       find first buf_gds-grp no-lock where
     1413                 buf_gds-grp.node-name = v-entry
     1414             and buf_gds-grp.upper-code = v-upper-code
     1415             no-error.
     1416       if not available buf_gds-grp then do:
     1417         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1418       end.
     1419       else do:
     1420         p-node-code = buf_gds-grp.node-code.
     1421         v-upper-code = buf_gds-grp.node-code.
     1422       end.
     1423     end.
     1424   end.
     1425   end .
     1426   procedure grplib-get-root-code :
     1427   do
     1428   on error undo, return error
     1429   :
     1430   define output parameter p-root-code as integer      no-undo.
     1431       define buffer buf_gds-grp       for ub.gds-grp.
     1432       find first buf_gds-grp no-lock
     1433           where buf_gds-grp.upper-code = 0
     1434       no-error .
     1435       if not available buf_gds-grp
     1436       then do:
     1437           undo, return error .
     1438       end.
     1439       else do:
     1440           assign
     1441               p-root-code = buf_gds-grp.node-code
     1442           .
     1443       end.
     1444   end.
     1445   end procedure.
     1446   procedure grplib-find-grp-by-full-name :
     1447   do
     1448   on error undo, return error
     1449   :
     1450   define input parameter p-search-name  as character    no-undo.
     1451   define input parameter p-fill-path    as logical      no-undo.
     1452   define output parameter p-found       as logical      no-undo.
     1453       define variable v-upper-code    as integer          no-undo.
     1454       define variable v-counter       as integer           no-undo.
     1455       define variable v-level         as integer           no-undo.
     1456       define variable v-full-name     as character         no-undo.
     1457       define variable v-sort-name     as character         no-undo.
     1458       define buffer buf_gds-grp       for ub.gds-grp.
     1459       assign
     1460           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1461       .
     1462       run grplib-get-root-code ( output v-upper-code ) no-error .
     1463       if error-status :error
     1464       then do:
     1465           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1466       end.
     1467       assign
     1468           v-full-name  = ""
     1469           v-level      = num-entries( p-search-name, chr(2) )
     1470       .
     1471       for each temp_grplib_found-grp
     1472       :
     1473           delete temp_grplib_found-grp.
     1474       end.
     1475       start-name-analyze:
     1476       do v-counter = 1 to v-level
     1477       :
     1478           if v-counter < v-level
     1479           then do:
     1480               find first buf_gds-grp no-lock
     1481                    where buf_gds-grp.upper-code = v-upper-code
     1482                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1483               no-error .
     1484               if not available buf_gds-grp
     1485               then do:
     1486                   assign
     1487                       v-full-name  = p-search-name
     1488                       v-sort-name  = p-search-name
     1489                   .
     1490                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1491               end.
     1492               else do:
     1493                   assign
     1494                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1495                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1496                       v-upper-code = buf_gds-grp.node-code
     1497                   .
     1498                   if p-fill-path = yes
     1499                   then do:
     1500                       create temp_grplib_found-grp.
     1501                       assign
     1502                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1503                           temp_grplib_found-grp.sort-name = v-sort-name
     1504                           temp_grplib_found-grp.node-code = v-upper-code
     1505                           temp_grplib_found-grp.level     = v-counter
     1506                       .
     1507                   end.
     1508               end.
     1509           end.
     1510           else do:
     1511               for each buf_gds-grp no-lock
     1512                  where buf_gds-grp.upper-code = v-upper-code
     1513                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1514               :
     1515                   assign
     1516                       p-found = yes
     1517                   .
     1518                   create temp_grplib_found-grp.
     1519                   assign
     1520                       temp_grplib_found-grp.full-name = v-full-name
     1521                                                           + (if v-full-name = "" then "" else chr(47) )
     1522                                                           + buf_gds-grp.node-name + chr(47)
     1523                       temp_grplib_found-grp.sort-name = v-sort-name
     1524                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1525                                                           + buf_gds-grp.node-name
     1526                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1527                       temp_grplib_found-grp.level     = v-level
     1528                   .
     1529               end.
     1530               if p-found = no
     1531               then do:
     1532                   assign
     1533                       v-full-name  = p-search-name
     1534                       v-sort-name  = p-search-name
     1535                   .
     1536                   for each temp_grplib_found-grp
     1537                   :
     1538                       delete temp_grplib_found-grp.
     1539                   end.
     1540                   assign
     1541                       p-found = no
     1542                   .
     1543               end.
     1544           end.
     1545       end.
     1546   end.
     1547   end procedure.
     1548   procedure grplib-find-all-subgroup :
     1549   do
     1550   on error undo, return error
     1551   :
     1552   define input parameter p-start-node-code    as integer      no-undo.
     1553   define input parameter p-terminal-only      as logical      no-undo.
     1554       define variable v-start-full-name   as character     no-undo.
     1555       define variable v-start-sort-name   as character     no-undo.
     1556       define variable v-not-found         as logical       no-undo.
     1557       define variable v-is-terminal       as logical       no-undo.
     1558       define buffer buf_gds-grp           for ub.gds-grp.
     1559       create temp_found-result-nodelist.
     1560       assign
     1561           temp_found-result-nodelist.node-code = p-start-node-code
     1562           temp_found-result-nodelist.processed = no
     1563       .
     1564       run grplib-get-full-name in this-procedure (
     1565             input p-start-node-code
     1566           , output v-start-full-name
     1567       ).
     1568       run grplib-get-full-name in this-procedure (
     1569             input p-start-node-code
     1570           , output v-start-sort-name
     1571       ).
     1572       process-nodes:
     1573       do while yes
     1574       :
     1575           find first temp_found-result-nodelist
     1576                where temp_found-result-nodelist.node-code = p-start-node-code
     1577           .
     1578           assign
     1579               temp_found-result-nodelist.processed = yes
     1580           .
     1581           for each buf_gds-grp no-lock
     1582              where buf_gds-grp.upper-code = p-start-node-code
     1583           on error undo, return error
     1584           :
     1585               run grplib-is-terminal in this-procedure (
     1586                     input buf_gds-grp.node-code
     1587                   , output v-is-terminal
     1588               ).
     1589               if v-is-terminal = yes
     1590               then do:
     1591                   create temp_grplib_found-grp.
     1592                   assign
     1593                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1594                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1595                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1596                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1597                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1598                       temp_grplib_found-grp.is-terminal = yes
     1599                   .
     1600               end.
     1601               else do:
     1602                   create temp_found-result-nodelist.
     1603                   assign
     1604                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1605                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1606                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1607                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1608                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1609                       temp_found-result-nodelist.processed = no
     1610                   .
     1611                   if p-terminal-only = no
     1612                   then do:
     1613                       create temp_grplib_found-grp.
     1614                       assign
     1615                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1616                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1617                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1618                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1619                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1620                           temp_grplib_found-grp.is-terminal = no
     1621                       .
     1622                   end.
     1623               end.
     1624           end.
     1625           find first temp_found-result-nodelist
     1626                where temp_found-result-nodelist.processed = no
     1627           no-error.
     1628           if not available temp_found-result-nodelist
     1629           then do:
     1630               leave process-nodes.
     1631           end.
     1632           else do:
     1633               assign
     1634                   p-start-node-code = temp_found-result-nodelist.node-code
     1635                   v-start-full-name = temp_found-result-nodelist.full-name
     1636                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1637               .
     1638           end.
     1639       end.
     1640   end.
     1641   end procedure.
     1642   procedure grplib-expand-name :
     1643   define input parameter p-start-name as character        no-undo.
     1644   define output parameter p-end-name  as character        no-undo.
     1645       define variable v-is-terminal   as logical      no-undo.
     1646       define variable v-found         as character    no-undo.
     1647       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1648   do
     1649   for buf_temp_grplib_found-grp
     1650   on error undo, return error
     1651   :
     1652       run grplib-find-grp-by-full-name in this-procedure (
     1653             input p-start-name
     1654           , input no
     1655           , output v-found
     1656       ) no-error.
     1657       run grplib-get-max-substring in this-procedure (
     1658                   input length( p-start-name )
     1659                 , output p-end-name
     1660       ) no-error .
     1661       if error-status :error
     1662       then do:
     1663           assign
     1664               p-end-name = ""
     1665           .
     1666       end.
     1667       else do:
     1668           find first temp_grplib_found-grp
     1669               where temp_grplib_found-grp.full-name = p-end-name
     1670           no-error.
     1671           if available temp_grplib_found-grp
     1672           then do:
     1673               find first buf_temp_grplib_found-grp
     1674                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1675                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1676               no-error.
     1677               if not available buf_temp_grplib_found-grp
     1678               then do:
     1679                   run grplib-is-terminal in this-procedure (
     1680                       input temp_grplib_found-grp.node-code
     1681                       , output v-is-terminal
     1682                   ).
     1683               end.
     1684           end.
     1685       end.
     1686   end.
     1687   end procedure.
     1688   procedure grplib-get-max-substring :
     1689   do
     1690   on error undo, return error
     1691   :
     1692   define input parameter p-min-substring-length   as integer      no-undo.
     1693   define output parameter p-substring             as character    no-undo.
     1694           define variable v-char-counter  as integer           no-undo.
     1695           define variable v-current-char  as character         no-undo.
     1696           define variable v-names-counter  as integer           no-undo.
     1697           define variable v-base-string   as character         no-undo.
     1698           assign
     1699               v-char-counter  = p-min-substring-length
     1700           .
     1701           find first temp_grplib_found-grp no-error.
     1702           if not available temp_grplib_found-grp
     1703           then do:
     1704               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1705           end.
     1706           else do:
     1707               assign
     1708                   v-base-string  = temp_grplib_found-grp.full-name
     1709                   v-char-counter = 0
     1710               .
     1711               counter-block:
     1712               do while yes
     1713               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1714               :
     1715                   assign
     1716                       v-char-counter  = v-char-counter + 1
     1717                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1718                       v-names-counter = 0
     1719                   .
     1720                   compare-block:
     1721                   for each temp_grplib_found-grp
     1722                   :
     1723                       assign
     1724                           v-names-counter = v-names-counter + 1
     1725                       .
     1726                       if v-names-counter = 1
     1727                       then do:
     1728                           next compare-block.
     1729                       end.
     1730                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1731                       then do:
     1732                           leave counter-block.
     1733                       end.
     1734                   end.
     1735                   if v-names-counter = 1
     1736                   then do:
     1737                       assign
     1738                           p-substring = v-base-string
     1739                       .
     1740                       return.
     1741                   end.
     1742               end.
     1743               assign
     1744                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1745               .
     1746           end.
     1747   end.
     1748   end procedure.
     1749   procedure grplib-is-terminal :
     1750   do
     1751   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1752   :
     1753   define input parameter p-node-code      as integer      no-undo.
     1754   define output parameter p-is-terminal   as logical      no-undo.
     1755       define buffer buf_gds-grp       for ub.gds-grp.
     1756       find first buf_gds-grp no-lock
     1757           where buf_gds-grp.upper-code = p-node-code
     1758       no-error .
     1759       if not available buf_gds-grp
     1760       then do:
     1761           assign
     1762               p-is-terminal = yes
     1763           .
     1764       end.
     1765       else do:
     1766           assign
     1767               p-is-terminal = no
     1768           .
     1769       end.
     1770   end.
     1771   end procedure.
     1772   procedure grplib-have-goods :
     1773   do
     1774   on error undo, return error
     1775   :
     1776   define input parameter p-node-code      as integer      no-undo.
     1777   define output parameter p-have-goods   as logical      no-undo.
     1778       define buffer buf_goods         for ub.goods.
     1779       find first buf_goods no-lock
     1780            where buf_goods.grp-code = p-node-code
     1781       no-error .
     1782       if available buf_goods
     1783       then do:
     1784           assign
     1785               p-have-goods = yes
     1786           .
     1787       end.
     1788       else do:
     1789           assign
     1790               p-have-goods = no
     1791           .
     1792       end.
     1793   end.
     1794   end procedure.
     1795   procedure grplib-find-by-substring :
     1796   do
     1797   on error undo, return error
     1798   :
     1799   define input parameter p-start-code         as integer      no-undo.
     1800   define input parameter p-full-search-string as character    no-undo.
     1801   define output parameter p-found-code        as integer      no-undo.
     1802   define output parameter p-full-name         as character    no-undo.
     1803       define variable v-start-code     as integer           no-undo.
     1804       define variable v-found          as logical  init no  no-undo.
     1805       define buffer buf_gds-grp       for ub.gds-grp.
     1806       search-grp:
     1807       for each buf_gds-grp no-lock
     1808           where buf_gds-grp.node-code > p-start-code
     1809       :
     1810           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1811           then do:
     1812               assign
     1813                   p-found-code = buf_gds-grp.node-code
     1814                   v-found      = yes
     1815               .
     1816               run grplib-get-full-name in this-procedure (
     1817                     input p-found-code
     1818                   , output p-full-name
     1819               ) no-error .
     1820               if error-status :error
     1821               then do:
     1822                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1823               end.
     1824               leave search-grp.
     1825           end.
     1826       end.
     1827       if v-found = yes
     1828       then do:
     1829       end.
     1830       else do:
     1831           assign
     1832               p-full-name  = ""
     1833               p-found-code = 0
     1834           .
     1835       end.
     1836   end.
     1837   end procedure.
     1838   procedure grplib-analyze-grp-name :
     1839   do
     1840   on error undo, return error
     1841   :
     1842   define input parameter p-grp-name       as character            no-undo.
     1843   define input parameter p-upper-code     as integer              no-undo.
     1844   define output parameter p-error-message as character init ""    no-undo.
     1845       define variable v-char-list     as character    no-undo.
     1846       define variable v-char-counter  as integer      no-undo.
     1847       define variable v-full-name     as character    no-undo.
     1848       if p-grp-name = "" then do:
     1849           assign
     1850               p-error-message = "Название группы не может быть пустым.".
     1851           .
     1852       end.
     1853       else do:
     1854           assign
     1855               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1856           .
     1857           do v-char-counter = 1 to num-entries( v-char-list )
     1858           :
     1859               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1860               then do:
     1861                   assign
     1862                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1863                   .
     1864                   return.
     1865               end.
     1866           end.
     1867           if p-upper-code > 0
     1868           then do:
     1869               run grplib-get-full-name in this-procedure (
     1870                     input p-upper-code
     1871                   , output v-full-name
     1872               ) no-error .
     1873               if error-status :error
     1874               then do:
     1875                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1876               end.
     1877               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1878               then do:
     1879                   assign
     1880                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1881                   .
     1882               end.
     1883           end.
     1884       end.
     1885   end.
     1886   end procedure.
     1887   procedure grplib-get-lvl-num :
     1888   define input parameter p-node-code  as integer      no-undo.
     1889   define output parameter p-lvl-num   as integer      no-undo.
     1890       define variable v-full-name    as character    no-undo.
     1891   do
     1892   on error undo, return error
     1893   :
     1894       run grplib-get-full-name in this-procedure (
     1895             input p-node-code
     1896           , output v-full-name
     1897       ).
     1898       assign
     1899           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1900       .
     1901       if p-lvl-num = -1
     1902       then do:
     1903           assign
     1904               p-lvl-num = 0
     1905           .
     1906       end.
     1907   end.
     1908   end procedure.
     1909   define variable v-stop-leave-status as character no-undo .
     1910   define variable v-cmd-code as integer no-undo .
     1911   define variable v-cmd-proc-handle as handle no-undo .
     1912   define variable v-command  as character no-undo .
     1913   define variable v-obj-type as character no-undo .
     1914   define variable v-obj-code as integer no-undo .
     1915   define variable v-host-code as integer   no-undo .
     1916   define variable v-base-code as integer   no-undo .
     1917   define variable v-doc-date as date no-undo .
     1918   define variable v-fact-date as date no-undo .
     1919   define variable v-curr-r-b as character no-undo .
     1920   define variable v-id as integer no-undo .
     1921   define variable v-proc-handle as handle no-undo .
     1922   define variable v-proc-name as character no-undo .
     1923   define variable v-ruleset-id as integer no-undo .
     1924   define variable v-ruleset-id-list as character no-undo extent 3.
     1925   define variable v-codex-id as integer no-undo .
     1926   define variable v-codex-in-db as integer no-undo .
     1927   define variable v-ii as integer no-undo .
     1928   define variable v-jj as integer no-undo .
     1929   define variable sign as integer no-undo .
     1930   define variable v-codex-id-list as character no-undo .
     1931   DEFINE VARIABLE v-today as date no-undo .
     1932   DEFINE VARIABLE v-time as integer no-undo .
     1933   define variable v-calc-chr as character no-undo .
     1934   define variable v-can-run as logical no-undo .
     1935   define variable v-doc-code as character no-undo .
     1936   define variable v-doc-type as character no-undo .
     1937   define variable v-process-file-name as character no-undo .
     1938   define variable v-profile-id as integer no-undo .
     1939   define variable log-file-name                as character      no-undo init "process-gds-grp.txt".
     1940   define variable v-save-int as integer no-undo .
     1941   define variable v-charkey_one as character no-undo .
     1942   define variable v-charkey_one-2 as character no-undo .
     1943   define variable v-num-dc as integer no-undo .
     1944   define variable v-is-empty as logical no-undo .
     1945   define variable v-rec-ord_ as integer no-undo .
     1946   define variable v-param-name as character no-undo .
     1947   define variable v-xsd-file as character no-undo .
     1948   define variable v-cont-handle as handle no-undo .
     1949   define buffer buf_rule-by-call for ub.rule-by-call.
     1950   define buffer buf_rule-call-param for ub.rule-call-param.
     1951   define buffer buf_temp-pers-proc  for temp-pers-proc.
     1952   define buffer buf_db for ub.db.
     1953   define buffer buf_sysconf for ub.sysconf.
     1954   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1956   define NEW SHARED temp-table temp-cmd no-undo
     1957   field cmd-code as integer
     1958   field db-list as character
     1959   index pi is unique primary
     1960   db-list
     1961   index icmd
     1962   cmd-code
     1963   .
     1964   define NEW SHARED temp-table temp-smart-route no-undo
     1965   field key-field as character
     1966   field db-num as integer
     1967   index pi is unique primary
     1968   key-field
     1969   db-num
     1970   .
     1971   define NEW SHARED temp-table temp-no-route no-undo
     1972   field rec-ord as integer
     1973   field db-num as integer
     1974   index pi is unique primary
     1975   db-num
     1976   rec-ord
     1977   index iro
     1978   rec-ord
     1979   .
     1980   define NEW SHARED temp-table temp-smart-link no-undo
     1981   field uniq-key-rec as character
     1982   field key-field as character
     1983   field rec-ord as integer
     1984   field is-smart as logical
     1985   index pi is unique primary
     1986   key-field
     1987   uniq-key-rec
     1988   rec-ord
     1989   index iu
     1990   uniq-key-rec
     1991   index iro
     1992   rec-ord
     1993   .
     1994   define NEW SHARED temp-table temp-nws-outline no-undo
     1995   like ub.nws-outline.
     1996   procedure create-smart-route :
     1997   define input parameter p-key-field as character no-undo .
     1998   define input parameter p-db-num as integer no-undo .
     1999   define buffer buf_temp-smart-route for temp-smart-route.
     2000     do
     2001     on error undo, return error
     2002     :
     2003       find first buf_temp-smart-route where
     2004                 buf_temp-smart-route.key-field = p-key-field
     2005             and buf_temp-smart-route.db-num = p-db-num no-error.
     2006       if not available buf_temp-smart-route then do:
     2007         create buf_temp-smart-route.
     2008         assign
     2009         buf_temp-smart-route.key-field = p-key-field
     2010         buf_temp-smart-route.db-num = p-db-num
     2011         .
     2012       end.
     2013     end.
     2014   end procedure.
     2015   procedure create-smart-route-link :
     2016   define input parameter p-tbl-name as character no-undo .
     2017   define input parameter p-bh_tbl-name as handle no-undo .
     2018   define input parameter p-key-field as character no-undo .
     2019   define input parameter p-rec-ord as integer no-undo .
     2020   define input parameter p-is-smart as logical no-undo .
     2021   define variable v-key-rec as character no-undo .
     2022   define buffer buf_temp-smart-link for temp-smart-link.
     2023     do
     2024     on error undo, return error
     2025     :
     2026       run gen-key-rec in this-procedure ( input p-tbl-name
     2027                                          ,input p-bh_tbl-name
     2028                                          ,output v-key-rec     ).
     2029      find first buf_temp-smart-link where
     2030                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     2031              and buf_temp-smart-link.key-field = p-key-field
     2032              and buf_temp-smart-link.rec-ord = p-rec-ord
     2033              no-error .
     2034      if not available buf_temp-smart-link then do:
     2035        create buf_temp-smart-link.
     2036        assign
     2037        buf_temp-smart-link.uniq-key-rec = v-key-rec
     2038        buf_temp-smart-link.key-field = p-key-field
     2039        buf_temp-smart-link.rec-ord = p-rec-ord
     2040        buf_temp-smart-link.is-smart = p-is-smart
     2041        .
     2042      end.
     2043     end.
     2044   end procedure.
     2045   procedure create-nws-outline :
     2046   define input parameter p-cmd-proc-handle as handle no-undo .
     2047   define input parameter p-cmd-code as integer no-undo .
     2048   define input parameter p-outline-type as character no-undo .
     2049   define input parameter p-charkey_one as character no-undo .
     2050   define input parameter p-charkey_two as character no-undo .
     2051   define input parameter p-charkey_three as character no-undo .
     2052   define input parameter p-key#_one as integer no-undo .
     2053   define input parameter p-key#_two as integer no-undo .
     2054   define input parameter p-key#_three as integer no-undo .
     2055   define variable v-no-id as integer no-undo .
     2056   define variable v-rec-ord as integer no-undo .
     2057     do
     2058     on error undo, return error return-value
     2059     :
     2060       find last temp-nws-outline use-index pi no-error .
     2061       v-no-id = (if available temp-nws-outline
     2062                  then (temp-nws-outline.no-id  + 1)
     2063                  else 1).
     2064       create temp-nws-outline.
     2065       assign
     2066       temp-nws-outline.charkeY_one = p-charkey_one
     2067       temp-nws-outline.charkeY_two = p-charkey_two
     2068       temp-nws-outline.charkeY_three = p-charkey_three
     2069       temp-nws-outline.key#_one = p-key#_one
     2070       temp-nws-outline.key#_two = p-key#_two
     2071       temp-nws-outline.key#_three = p-key#_three
     2072       temp-nws-outline.no-id = v-no-id
     2073       temp-nws-outline.outline-type = p-outline-type
     2074       .
     2075                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2076       run  create-smart-route in this-procedure (
     2077                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2078                                                  ,input -1).
     2079       run create-smart-route-link in this-procedure (
     2080                                                      input 'nws-outline':U
     2081                                                     ,input (buffer temp-nws-outline:handle)
     2082                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2083                                                     ,input v-rec-ord
     2084                                                     ,input no
     2085                                                     ).
     2086     end.
     2087   end procedure.
     2088   procedure create-no-route :
     2089   define input parameter p-rec-ord as integer no-undo .
     2090   define input parameter p-db-num as integer no-undo .
     2091   define buffer buf_temp-no-route for temp-no-route.
     2092   do
     2093   on error undo, return error
     2094   :
     2095      find first buf_temp-no-route where
     2096                 buf_temp-no-route.rec-ord = p-rec-ord
     2097              and buf_temp-no-route.db-num = p-db-num no-error .
     2098      if not available buf_temp-no-route then do:
     2099        create buf_temp-no-route.
     2100        assign
     2101        buf_temp-no-route.rec-ord = p-rec-ord
     2102        buf_temp-no-route.db-num = p-db-num
     2103        .
     2104      end.
     2105   end.
     2106   end procedure.
     2107   procedure clear-from-rec-ord :
     2108   define input parameter p-rec-ord as integer no-undo .
     2109   define buffer buf_temp-no-route for temp-no-route.
     2110   define buffer buf_temp-smart-link for temp-smart-link.
     2111   do
     2112   on error undo, return error
     2113   :
     2114   for each buf_temp-no-route where
     2115           buf_temp-no-route.rec-ord > p-rec-ord:
     2116     delete buf_temp-no-route.
     2117   end.
     2118   for each buf_temp-smart-link where
     2119           buf_temp-smart-link.rec-ord > p-rec-ord:
     2120      delete buf_temp-smart-link.
     2121   end.
     2122   end.
     2123   end procedure.
     2124   define buffer buf_temp-cmd  for temp-cmd.
     2125   define buffer buf1_temp-cmd  for temp-cmd.
     2126   define buffer buf_temp-smart-route  for temp-smart-route.
     2127   define buffer buf_temp-smart-link  for temp-smart-link.
     2128   define buffer buf_temp-nws-outline for temp-nws-outline.
     2129   define buffer buf_temp-no-route for temp-no-route.
     2130   if transaction
     2131   and p-process = 'xml-esys-import':U
     2132   then do:
     2133     message
     2134       vss-workfile vss-revision vss-description skip
     2135       substitute("Вызов процедуры в действующей транзакции недопустим") skip
     2136       view-as alert-box error .
     2137     return error substitute( "&1. Вызов процедуры в действующей транзакции недопустим", vss-workfile ) .
     2138   end.
     2139   _main:
     2140   do
     2141   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2142   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2143   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2144   :
     2145   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2147     (output v-curr-r-b
     2148     )  .
     2149     if not p-save
     2150           then do:
     2151       message
     2152       substitute("Неверное значение параметра p-save = &1,&2" +
     2153                  "в ситуации когда p-process = &3"
     2154                  , p-save
     2155                  , chr(10)
     2156                  , p-process)
     2157       view-as alert-box error .
     2158       undo _main, return error .
     2159     end.
     2160     v-save-int = (if p-save
     2161                   then 0
     2162                   else -1).
     2163     CASE p-process:
     2164       when 'batchwork-export':U
     2165       or
     2166       when 'batchwork-routing':U
     2167       then do:
     2168         if not g#auto then do:
     2169   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2170     run mainmenu_getcntxt in parparentproc
     2171       (output v-cntxt-db-num
     2172       ,output v-cntxt-userid
     2173       ,output v-cntxt-level
     2174       ,output v-cntxt-host-code-obj
     2175       ,output v-cntxt-obj-type
     2176       ,output v-cntxt-obj-code
     2177       ,output v-cntxt-db-num-obj
     2178       ,output v-cntxt-is-admin
     2179       ) .
     2180         end.
     2181         for each ggrp-list:
     2182           delete ggrp-list.
     2183         end.
     2184         if p-parent-handle:get-signature ( "gds-grp_rum-fill_cb") <> ? then do:
     2185           run gds-grp_rum-fill_cb in p-parent-handle ( input (buffer ggrp-list:handle), input (buffer temp_found-result-nodelist:handle)).
     2186         end.
     2187         run cur-time in this-procedure ( output v-today, output v-time).
     2188         assign
     2189         v-obj-type = v-cntxt-obj-type
     2190         v-obj-code = v-cntxt-obj-code
     2191         v-host-code = v-cntxt-host-code-obj
     2192         v-doc-date = v-today
     2193         v-fact-date = v-today
     2194         v-doc-code = entry(1, p-doc-code, chr(4))
     2195         v-process-file-name =  entry(2, p-doc-code, chr(4))
     2196         v-profile-id = p-profile-id
     2197         .
     2198         assign
     2199         v-codex-id-list = string(p-codex-id)
     2200         v-ruleset-id-list[1] = string(p-ruleset-id)
     2201         v-ruleset-id-list[2] = ''
     2202         .
     2203       end.
     2204       when 'xml-file-import':U then do:
     2205        run cur-time in this-procedure ( output v-today, output v-time).
     2206         assign
     2207         v-obj-type = v-cntxt-obj-type
     2208         v-obj-code = v-cntxt-obj-code
     2209         v-host-code = v-cntxt-host-code-obj
     2210         v-doc-date = v-today
     2211         v-fact-date = v-today
     2212         v-doc-code = entry(1, p-doc-code, chr(4))
     2213         v-process-file-name =  entry(2, p-doc-code, chr(4))
     2214         v-profile-id = p-profile-id
     2215         .
     2216         for each ggrp-list:
     2217           delete ggrp-list.
     2218         end.
     2219         assign
     2220         v-codex-id-list = string(p-codex-id)
     2221         v-ruleset-id-list[1] = string(p-ruleset-id)
     2222         v-ruleset-id-list[2] = ''
     2223         .
     2224       end.
     2225       when 'xml-esys-import':U then do:
     2226         run cur-time in this-procedure ( output v-today, output v-time).
     2227         assign
     2228         v-obj-type = v-cntxt-obj-type
     2229         v-obj-code = v-cntxt-obj-code
     2230         v-host-code = v-cntxt-host-code-obj
     2231         v-doc-date = v-today
     2232         v-fact-date = v-today
     2233         v-doc-code = entry(1, p-doc-code, chr(4))
     2234         v-process-file-name =  entry(2, p-doc-code, chr(4)) +
     2235                                 chr(4) + entry(3, p-doc-code, chr(4))
     2236                                 + chr(4) + entry(4, p-doc-code, chr(4))
     2237                                 + chr(4) + entry(5, p-doc-code, chr(4))
     2238         v-profile-id = p-profile-id
     2239         v-cont-handle = p-parent-handle
     2240         v-param-name = entry(6, p-doc-code, chr(4))
     2241         v-xsd-file = entry(7, p-doc-code, chr(4))
     2242         .
     2243         assign
     2244         v-codex-id-list = string(p-codex-id)
     2245         v-ruleset-id-list[1] = string(p-ruleset-id)
     2246         v-ruleset-id-list[2] = ''
     2247         .
     2248       end.
     2249       otherwise do:
     2250         undo _main, return error substitute("&1 &2 &3&4Ошибка входных параметров процедуры gds-grprum.p&4Невернoе значение p-process = &5"
     2251                                             ,vss-workfile
     2252                                             ,vss-revision
     2253                                             ,vss-description
     2254                                             ,chr(10)
     2255                                             ,p-process
     2256                                              ).
     2257       end.
     2258     END CASE.
     2259     _codex:
     2260     do v-jj = 1 to num-entries(v-codex-id-list):
     2261       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     2262       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     2263       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     2264           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     2265           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     2266         _rule-by-call:
     2267         for each buf_rule-by-call no-lock where
     2268                   buf_rule-by-call.call_id = p-uniq-key-rec
     2269             and buf_rule-by-call.can-calc = yes
     2270             and buf_rule-by-call.codex_id = v-codex-id
     2271             and buf_rule-by-call.ruleset_id = v-ruleset-id
     2272         by buf_rule-by-call.call_Id
     2273         by buf_rule-by-call.codex_id
     2274         by buf_rule-by-call.ruleset_id
     2275         by buf_rule-by-call.order_id
     2276         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2277         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2278         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     2279           if p-process = 'batchwork-export':U
     2280           or p-process = 'batchwork-routing':U
     2281           or p-process = 'xml-file-import':U
     2282           then do:
     2283             if buf_rule-by-call.profile_id <> v-profile-id then next _rule-by-call.
     2284           end.
     2285           if p-process = 'xml-esys-import':U
     2286           and buf_rule-by-call.ruleset_id = 4
     2287           then do:
     2288             find first buf_rule-call-param no-lock where
     2289                       buf_rule-call-param.call_id = buf_rule-by-call.call_id
     2290                   and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     2291                   and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     2292                   and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     2293                   and buf_rule-call-param.param-name = v-param-name
     2294                   and buf_rule-call-param.param-value-character = v-xsd-file no-error.
     2295             if not available buf_rule-call-param then next _rule-by-call.
     2296           end.
     2297           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     2298           run value(v-proc-name)  (
     2299                                                                 input parparentproc
     2300                                                               ,input this-procedure:handle
     2301                                                               ,input p-log-handle
     2302                                                               ,input v-cont-handle
     2303                                                               ,input v-codex-id
     2304                                                               ,input v-ruleset-id
     2305                                                               ,input buf_rule-by-call.call_id
     2306                                                               ,input buf_rule-by-call.order_id
     2307                                                               ,input buf_rule-by-call.rule_id
     2308                                                               ,input buf_rule-by-call.profile
     2309                                                               ,input buf_rule-by-call.is_dynamic
     2310                                                               ,input v-doc-type
     2311                                                               ,input v-host-code
     2312                                                               ,input v-obj-type
     2313                                                               ,input v-obj-code
     2314                                                               ,input v-doc-code
     2315                                                               ,input v-process-file-name
     2316                                                               ,input v-save-int
     2317                                                               ,input v-curr-r-b
     2318                                                               ,input v-cmd-proc-handle
     2319                                                               ,input 0
     2320                                                               ) no-error .
     2321           if error-status:error
     2322           then do:
     2323             undo _main, return error substitute("&1&2Ошибка при обработке групп товаров&2" +
     2324                                                 "&3&2&4"
     2325                                                 ,vss-workfile
     2326                                                 ,chr(10)
     2327                                                 , error-status:get-message(1)
     2328                                                 , return-value
     2329                                                   ).
     2330           end.
     2331           if v-stop-leave-status > '' then do:
     2332             undo _main, return error substitute("&1&2Процесс обработки групп товаров прерван&2" +
     2333                                                 "&3&2&4"
     2334                                                 ,vss-workfile
     2335                                                 ,chr(10)
     2336                                                 , error-status:get-message(1)
     2337                                                 , return-value
     2338                                                   ).
     2339           end.
     2340         end.
     2341       end.
     2342     end.
     2343   end.
     2344   procedure set-num-rec :
     2345   define input parameter p-num-rec as integer no-undo .
     2346   define input parameter p-num-rec-calc-err as integer no-undo .
     2347   define input parameter p-num-rec-value-err as integer no-undo .
     2348   define input parameter p-num-rec-ok as integer no-undo .
     2349   define input parameter p-display as logical no-undo .
     2350   define variable v-ok as logical no-undo .
     2351   do
     2352   on error undo, return error
     2353   :
     2354     if not (p-process = 'batch-card-recalc':U) then do:
     2355       return.
     2356     end.
     2357     run set-num-rec in p-parent-handle ( input p-num-rec
     2358                                         ,input p-num-rec-calc-err
     2359                                         ,input p-num-rec-value-err
     2360                                         ,input p-num-rec-ok
     2361                                         ,buffer buf_rule-by-call
     2362                                         ,input p-display
     2363                                         ).
     2364   end.
     2365   end procedure.
     2366   procedure set-stop-leave-status :
     2367   define input parameter p-stop-leave-status as character no-undo .
     2368   do
     2369   on error undo, return error
     2370   :
     2371     assign
     2372     v-stop-leave-status = p-stop-leave-status.
     2373   end.
     2374   end procedure.
