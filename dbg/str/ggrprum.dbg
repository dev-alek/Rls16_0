        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-parent-handle as handle no-undo .
        4   define input  parameter p-log-handle  as handle no-undo .
        5   define input  parameter p-process    as character no-undo .
        6   define input  parameter p-profile-id as integer   no-undo .
        7   define input  parameter p-codex-id as integer   no-undo .
        8   define input  parameter p-ruleset-id as integer   no-undo .
        9   define input  parameter p-db-num like ub.db.db-num no-undo .
       10   define input  parameter p-uniq-key-rec as character no-undo .
       11   define input  parameter p-doc-code as character no-undo .
       12   define input  parameter p-save        as logical no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":u .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
       16   define variable vss-workfile    as character no-undo init "$Workfile: ggrprum.p $":u .
       17   define variable vss-archive     as character no-undo init "$Archive: str/ggrprum.p $":u .
       18   define variable vss-description as character no-undo init "Вызов процедур RUM для обработки групп товаров" .
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37       assign
       38         p-vss-parameters = substitute('&1|&2|&3':u
       39                                 ,p-process
       40                                 ,p-db-num
       41                                 ,p-doc-code
       42                                 )
       43       .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define   shared variable g#auto as logical no-undo.
       87   define   shared variable g#news as logical no-undo.
       88   define   shared variable g#oxml as logical no-undo.
       89   define   shared variable g#esys as logical no-undo.
       90   define   shared variable g#news-source-db as integer no-undo.
       91   define   shared variable g#esys-source-esys as integer no-undo.
       92   define   shared variable g#db-num as integer   no-undo .
       93   define   shared variable g#userid as character no-undo .
       94   define   shared variable g#passwd as character no-undo .
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96     define variable v-cntxt-db-num        as integer   no-undo .
       97     define variable v-cntxt-userid        as character no-undo .
       98     define variable v-cntxt-level         as character no-undo .
       99     define variable v-cntxt-host-code-obj as integer   no-undo .
      100     define variable v-cntxt-obj-type      as character no-undo .
      101     define variable v-cntxt-obj-code      as integer   no-undo .
      102     define variable v-cntxt-db-num-obj    as integer   no-undo .
      103     define variable v-cntxt-is-admin      as logical   no-undo .
      104   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   define   temp-table temp-pers-proc no-undo
      106   field proc-name as character
      107   field vproc-handle as handle
      108   field vparent-handle as handle
      109   field user-name as character
      110   field id as integer
      111   field vpar as character
      112   field rank-to-delete as integer
      113   index pi is unique primary
      114   proc-name
      115   id
      116   index puser
      117   proc-name
      118   user-name
      119   index ppar
      120   proc-name
      121   vpar
      122   index iparent
      123   vparent-handle
      124   proc-name
      125   index iid
      126   id
      127   index ird
      128   rank-to-delete
      129   .
      130   define variable v-per-proc-num as integer no-undo .
      131   procedure perproc-create-proc :
      132   define input  parameter p-parent-handle as handle no-undo .
      133   define input  parameter p-proc-name as character no-undo .
      134   define input  parameter p-proc-handle  as handle no-undo .
      135   define input  parameter p-run        as logical no-undo .
      136   define input  parameter p-parameter as character no-undo .
      137   define input  parameter p-userid as character no-undo .
      138   define input  parameter p-rank-to-delete as integer no-undo .
      139   define output parameter p-id as integer   no-undo .
      140   define variable ii as integer   no-undo .
      141   define variable v-proc-handle as handle no-undo .
      142   define buffer buf_temp-pers-proc for temp-pers-proc.
      143   define buffer buf0_temp-pers-proc for temp-pers-proc.
      144     do
      145     on error undo, return error return-value
      146     :
      147       if v-per-proc-num > 100 then return error '>'.
      148       find first buf0_temp-pers-proc no-lock where
      149                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
      150       if not available buf0_temp-pers-proc then do:
      151         if p-run then do:
      152           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
      153           if error-status :error then undo, return error return-value .
      154         end.
      155         else v-proc-handle = p-proc-handle.
      156         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
      157         create buf_temp-pers-proc.
      158         assign
      159         buf_temp-pers-proc.proc-name = p-proc-name
      160         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
      161                                   then  0
      162                                   else buf0_temp-pers-proc.id + 1)
      163         buf_temp-pers-proc.user-name = p-userid
      164         buf_temp-pers-proc.vpar      = p-parameter
      165         buf_temp-pers-proc.vparent-handle = p-parent-handle
      166         buf_temp-pers-proc.vproc-handle = v-proc-handle
      167         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
      168         p-id = buf_temp-pers-proc.id
      169         v-per-proc-num = v-per-proc-num + 1
      170         .
      171       end.
      172       else p-id = buf0_temp-pers-proc.id.
      173     end.
      174   end procedure.
      175   procedure perproc-delete-proc-user :
      176   define input  parameter p-proc-name as character no-undo .
      177   define input  parameter p-user-name as character no-undo .
      178   define buffer buf_temp-pers-proc for temp-pers-proc.
      179     do
      180     on error undo, return error return-value
      181     :
      182        for each buf_temp-pers-proc where
      183               buf_temp-pers-proc.proc-name = p-proc-name
      184          AND  buf_temp-pers-proc.user-name = p-user-name:
      185           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      186           delete procedure buf_temp-pers-proc.vproc-handle.
      187           delete buf_temp-pers-proc.
      188           v-per-proc-num = v-per-proc-num - 1.
      189        end.
      190     end.
      191   end procedure.
      192   procedure perproc-delete-proc-id :
      193   define input  parameter p-id        as integer   no-undo .
      194   define buffer buf_temp-pers-proc for temp-pers-proc.
      195     do
      196     on error undo, return error return-value
      197     :
      198        for each buf_temp-pers-proc where
      199           buf_temp-pers-proc.id        = p-id:
      200           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      201           delete procedure buf_temp-pers-proc.vproc-handle.
      202           delete buf_temp-pers-proc.
      203           v-per-proc-num = v-per-proc-num - 1.
      204        end.
      205     end.
      206   end procedure.
      207   procedure perproc-delete-by-rank :
      208   define buffer buf_temp-pers-proc for temp-pers-proc.
      209     do
      210     on error undo, return error return-value
      211     :
      212       for each buf_temp-pers-proc where
      213       by buf_temp-pers-proc.rank-to-delete:
      214         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      215         delete procedure buf_temp-pers-proc.vproc-handle.
      216         delete buf_temp-pers-proc.
      217         v-per-proc-num = v-per-proc-num - 1.
      218       end.
      219     end.
      220   end procedure.
      221   procedure perproc-delete-proc-name-id :
      222   define input  parameter p-proc-name as character no-undo .
      223   define input  parameter p-id        as integer   no-undo .
      224   define buffer buf_temp-pers-proc for temp-pers-proc.
      225     do
      226     on error undo, return error return-value
      227     :
      228        for each buf_temp-pers-proc where
      229               buf_temp-pers-proc.proc-name = p-proc-name
      230          AND  buf_temp-pers-proc.id        = p-id:
      231           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      232           delete procedure buf_temp-pers-proc.vproc-handle.
      233           delete buf_temp-pers-proc.
      234           v-per-proc-num = v-per-proc-num - 1.
      235        end.
      236     end.
      237   end procedure.
      238   procedure perproc-delete-par :
      239   define input  parameter p-proc-name as character no-undo .
      240   define input  parameter p-parameter as character no-undo .
      241   define buffer buf_temp-pers-proc for temp-pers-proc.
      242     do
      243     on error undo, return error return-value
      244     :
      245        for each buf_temp-pers-proc where
      246               buf_temp-pers-proc.proc-name = p-proc-name
      247          AND  buf_temp-pers-proc.vpar      = p-parameter:
      248           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      249           delete procedure buf_temp-pers-proc.vproc-handle.
      250           delete buf_temp-pers-proc.
      251           v-per-proc-num = v-per-proc-num - 1.
      252        end.
      253     end.
      254   end procedure.
      255   procedure perproc-delete-from-parent :
      256   define input  parameter p-parent-handle as handle no-undo .
      257   define input  parameter p-proc-name as character no-undo .
      258   define buffer buf_temp-pers-proc for temp-pers-proc.
      259     do
      260     on error undo, return error return-value
      261     :
      262        if p-proc-name = "":u then do:
      263         for each buf_temp-pers-proc where
      264            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      265             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      266             delete procedure buf_temp-pers-proc.vproc-handle.
      267             delete buf_temp-pers-proc.
      268             v-per-proc-num = v-per-proc-num - 1.
      269         end.
      270        end.
      271        else do:
      272         for each buf_temp-pers-proc where
      273                 buf_temp-pers-proc.proc-name = p-proc-name
      274           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      275             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      276             delete procedure buf_temp-pers-proc.vproc-handle.
      277             delete buf_temp-pers-proc.
      278             v-per-proc-num = v-per-proc-num - 1.
      279         end.
      280       end.
      281     end.
      282   end procedure.
      283   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   define new global shared variable g#lib-nws as handle no-undo .
      285   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   procedure gen-key-rec :
      287     define input  parameter p-tbl-name    as character no-undo.
      288     define input  parameter p-bh_tbl-name as handle    no-undo.
      289     define output parameter p-key-rec     as character no-undo.
      290     do
      291     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      292     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      293     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      294     :
      295       define variable fh               as handle    no-undo .
      296       define variable v-ok             as logical   no-undo .
      297       define variable v-inform         as character no-undo .
      298       define variable v-ind            as integer   no-undo .
      299       define variable v-idx-field-qnty as integer   no-undo .
      300       if p-tbl-name = ?
      301         or p-tbl-name = "":U
      302       then do:
      303         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      304       end.
      305       if not p-bh_tbl-name:available then do:
      306         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      307       end.
      308       assign
      309         p-key-rec = p-tbl-name
      310         v-inform  = p-bh_tbl-name:index-information(1)
      311         v-ind     = 2
      312       .
      313       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      314       on error undo, return error
      315       :
      316         assign
      317           v-inform = p-bh_tbl-name:index-information( v-ind )
      318           v-ind    = v-ind + 1
      319         .
      320       end.
      321       if v-inform = ?
      322         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      323         or entry( 3, v-inform, ",":U ) <> "1":U
      324       then do:
      325         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      326       end.
      327       else do:
      328         assign
      329           v-idx-field-qnty = num-entries( v-inform ) - 4
      330         .
      331         if v-idx-field-qnty < 2 then do:
      332           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      333         end.
      334         do v-ind = 1 to v-idx-field-qnty by 2
      335         on error undo, return error
      336         :
      337           assign
      338             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      339             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      340           .
      341         end.
      342       end.
      343       if p-key-rec = ? then do:
      344         assign
      345           p-key-rec = "":U
      346         .
      347         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      348       end.
      349     end.
      350     return.
      351   end procedure.
      352   procedure gen-where-keyr-tab :
      353     define input  parameter i-tableSerach as character no-undo.
      354     define input  parameter i-tablekey   as character  no-undo.
      355     define input  parameter p-key-rec    as character  no-undo.
      356     define input  parameter p-key-handle as handle     no-undo .
      357     define input  parameter p-db-name    as character  no-undo .
      358     define input  parameter p-tt-handle  as handle     no-undo .
      359     define output parameter o-Where      as character  no-undo.
      360     do
      361     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      362     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      364     :
      365       define variable v-full-tbl-name  as character no-undo .
      366       define variable bh_tbl-name      as handle    no-undo .
      367       define variable fh_key           as handle    no-undo .
      368       define variable fh_search        as handle    no-undo .
      369       define variable v-field-num      as integer   no-undo .
      370       define variable v-count-fld      as integer   no-undo .
      371       define variable v-inform         as character no-undo .
      372       define variable v-ind            as integer   no-undo .
      373       define variable v-idx-field-qnty as integer   no-undo .
      374       define variable v-field-name     as character no-undo .
      375       define variable v-field-val      as character no-undo .
      376       define variable v-word-link      as character no-undo .
      377       define variable vTable           as character no-undo.
      378       define variable bh_tbl-key       as handle    no-undo .
      379       assign
      380         p-key-rec = trim( p-key-rec )
      381       .
      382       if p-key-handle <> ? then do:
      383         if not valid-handle(p-key-handle)
      384            or p-key-handle:type <> "buffer"
      385         then do:
      386           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      387         end.
      388         if num-entries( p-key-rec, chr(3) ) > 1
      389           or p-key-rec = ?
      390           or p-key-rec = "":U
      391         then do:
      392           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      393         end.
      394       end.
      395       else do:
      396         if p-key-rec = ?
      397           or p-key-rec = "":U
      398         then do:
      399           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      400         end.
      401       end.
      402       assign
      403         vTable = entry( 1 , p-key-rec, chr(3) )
      404       .
      405       if p-tt-handle <> ?
      406         and ( not valid-handle(p-tt-handle)
      407               or p-tt-handle:type <> "buffer"
      408             )
      409       then do:
      410         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      411       end.
      412       if p-tt-handle = ? then do:
      413         assign
      414           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      415         .
      416         create buffer bh_tbl-name for table v-full-tbl-name .
      417       end.
      418       else do:
      419         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      420       end.
      421       assign
      422         v-inform = bh_tbl-name:index-information(1)
      423         v-ind    = 2
      424       .
      425       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      426       on error undo, return error
      427       :
      428         assign
      429           v-inform = bh_tbl-name:index-information( v-ind )
      430           v-ind    = v-ind + 1
      431         .
      432       end.
      433       if v-inform = ?
      434         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      435         or entry( 3, v-inform, ",":U ) <> "1":U
      436       then do:
      437         delete object bh_tbl-name no-error.
      438         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      439       end.
      440       assign
      441         v-idx-field-qnty = num-entries( v-inform ) - 4
      442       .
      443       if v-idx-field-qnty < 2 then do:
      444         delete object bh_tbl-name no-error.
      445         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      446       end.
      447       assign
      448         o-where     = "where":U
      449         v-word-link = "":U
      450         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      451         v-count-fld = 0
      452       .
      453       if i-tablekey ne "" and i-tablekey ne ?
      454       then do:
      455         assign
      456           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      457         .
      458         create buffer bh_tbl-key for table v-full-tbl-name .
      459       end.
      460       if i-tableSerach ne "" and i-tableSerach ne ?
      461       then do:
      462         delete object bh_tbl-name no-error.
      463         assign
      464           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      465         .
      466         create buffer bh_tbl-name for table v-full-tbl-name .
      467       end.
      468       block_where:
      469       do v-ind = 1 to v-idx-field-qnty by 2
      470       on error undo, return error
      471       :
      472         assign
      473           v-count-fld = v-count-fld + 1
      474         .
      475         if p-key-handle = ?
      476           and v-count-fld > v-field-num
      477         then do:
      478           leave block_where.
      479         end.
      480         define variable VfieldKeyTable as handle no-undo.
      481         assign
      482           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      483           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      484         .
      485         if     bh_tbl-key ne ?
      486         then do:
      487            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      488            if VfieldKeyTable eq ?
      489            then next block_where.
      490         end.
      491         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      492         then
      493            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      494         else
      495            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      496         if p-key-handle = ? then do:
      497           assign
      498             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      499           .
      500         end.
      501         else do:
      502           assign
      503             fh_key = p-key-handle:buffer-field( v-field-name )
      504           .
      505           if fh_key = ?
      506             or not valid-handle( fh_key )
      507           then do:
      508             delete object bh_tbl-name.
      509             if     bh_tbl-key ne ?
      510             then
      511                delete object bh_tbl-key.
      512             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      513           end.
      514           assign
      515             v-field-val = fh_key:buffer-value
      516           .
      517         end.
      518         if fh_search:data-type ="character":U then do:
      519           assign
      520             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      521             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      522             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      523             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      524             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      525             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      526             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      527             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      528             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      529             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      530             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      531             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      532             v-field-val = substitute( '"&1"', v-field-val )
      533           .
      534         end.
      535         assign
      536           o-where = substitute( "&1 &2", o-where, v-field-val )
      537         .
      538         if v-word-link = "":U then do:
      539           assign
      540             v-word-link = "and":U
      541           .
      542         end.
      543       end.
      544       delete object bh_tbl-name.
      545       if     bh_tbl-key ne ?
      546       then
      547          delete object bh_tbl-key.
      548       if p-key-handle = ?
      549         and v-count-fld <> v-field-num
      550       then do:
      551         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      552       end.
      553     end.
      554   end procedure.
      555   procedure gen-hn-keyr-tab :
      556     define input  parameter i-tableSerach as character no-undo.
      557     define input  parameter i-tablekey   as character no-undo.
      558     define input  parameter p-key-rec    as character no-undo.
      559     define input  parameter p-key-handle as handle    no-undo .
      560     define input  parameter p-db-name    as character no-undo .
      561     define input  parameter p-tt-handle  as handle    no-undo .
      562     define input  parameter p-stts-lock  as integer   no-undo .
      563     define output parameter o-hn         as handle    no-undo.
      564     define variable v-full-tbl-name as character no-undo.
      565     define variable v-where         as character no-undo.
      566     define variable bh_tbl-name     as handle    no-undo.
      567     define variable vTable          as character no-undo.
      568     do
      569     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      570     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      571     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      572         run gen-where-keyr-tab(i-tableSerach,
      573                                i-tablekey,
      574                                p-key-rec,
      575                                p-key-handle,
      576                                p-db-name,
      577                                p-tt-handle,
      578                                output v-where).
      579         if i-tableSerach ne "" and i-tableSerach ne ?
      580         then do:
      581            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      582            create buffer bh_tbl-name for table v-full-tbl-name .
      583         end.
      584         else do:
      585            if p-tt-handle = ? then do:
      586               assign
      587                  vTable = entry( 1 , p-key-rec, chr(3) )
      588               .
      589               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      590               create buffer bh_tbl-name for table v-full-tbl-name .
      591            end.
      592            else do:
      593               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      594            end.
      595         end.
      596         if p-tt-handle = ? then do:
      597            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      598         end.
      599         else do:
      600            bh_tbl-name:find-first( v-where ) no-error .
      601         end.
      602         o-hn = bh_tbl-name.
      603      end.
      604   end procedure.
      605   procedure gen-hn-keyr :
      606     define input  parameter p-key-rec    as character no-undo.
      607     define input  parameter p-key-handle as handle    no-undo .
      608     define input  parameter p-db-name    as character no-undo .
      609     define input  parameter p-tt-handle  as handle    no-undo .
      610     define input  parameter p-stts-lock  as integer   no-undo .
      611     define output parameter o-hn         as handle    no-undo.
      612     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      613   end.
      614   procedure gen-row-keyr :
      615     define input  parameter p-key-rec    as character no-undo.
      616     define input  parameter p-key-handle as handle    no-undo .
      617     define input  parameter p-db-name    as character no-undo .
      618     define input  parameter p-tt-handle  as handle    no-undo .
      619     define input  parameter p-stts-lock  as integer   no-undo .
      620     define output parameter p-tbl-row    as rowid     no-undo.
      621     define output parameter p-tbl-name   as character no-undo.
      622     define variable vHn as handle no-undo.
      623       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      624       p-tbl-row = if vHn:available then vHn:rowid else ?.
      625       p-tbl-name =  vHn:table.
      626       delete object vHn no-error.
      627     if p-tbl-row = ? then do:
      628       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      629     end.
      630     else do:
      631       return.
      632     end.
      633   end procedure.
      634   procedure gen-key-fv :
      635     define input  parameter p-key-rec    as character no-undo .
      636     define output parameter p-field-list as character no-undo .
      637     define output parameter p-value-list as character no-undo.
      638     do
      639     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      640     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      641     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      642     :
      643       define variable v-full-tbl-name  as character no-undo .
      644       define variable bh_tbl-name      as handle    no-undo .
      645       define variable v-tbl-name       as character no-undo .
      646       define variable v-field-num      as integer   no-undo .
      647       define variable v-count-fld      as integer   no-undo .
      648       define variable v-inform         as character no-undo .
      649       define variable v-ind            as integer   no-undo .
      650       define variable v-idx-field-qnty as integer   no-undo .
      651       define variable v-delim-key      as character no-undo .
      652       if p-key-rec = ?
      653         or p-key-rec = "":U
      654       then do:
      655         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      656       end.
      657       assign
      658         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      659         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      660       .
      661       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      662       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      663       assign
      664         v-inform = bh_tbl-name:index-information(1)
      665         v-ind    = 2
      666       .
      667       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      668       on error undo, return error
      669       :
      670         assign
      671           v-inform = bh_tbl-name:index-information( v-ind )
      672           v-ind    = v-ind + 1
      673         .
      674       end.
      675       if v-inform = ?
      676         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      677         or entry( 3, v-inform, ",":U ) <> "1":U
      678       then do:
      679         delete object bh_tbl-name no-error.
      680         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      681       end.
      682       assign
      683         v-idx-field-qnty = num-entries( v-inform ) - 4
      684       .
      685       if v-idx-field-qnty < 2 then do:
      686         delete object bh_tbl-name no-error.
      687         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      688       end.
      689       assign
      690         p-field-list = "":U
      691         p-value-list = "":U
      692         v-delim-key  = "":U
      693         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      694         v-count-fld  = 0
      695       .
      696       block_where:
      697       do v-ind = 1 to v-idx-field-qnty by 2
      698       on error undo, return error
      699       :
      700         assign
      701           v-count-fld = v-count-fld + 1
      702         .
      703         if v-count-fld > v-field-num then do:
      704           leave block_where.
      705         end.
      706         assign
      707           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      708           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      709         .
      710         if v-ind = 1 then do:
      711           assign
      712             v-delim-key = chr(3)
      713           .
      714         end.
      715       end.
      716       delete object bh_tbl-name.
      717       if v-count-fld <> v-field-num then do:
      718         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      719       end.
      720     end.
      721   end procedure.
      722   procedure gen-key-field :
      723     define input  parameter p-table      as character no-undo .
      724     define output parameter p-field-list as character no-undo .
      725     do
      726     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      727     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      728     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      729     :
      730       define variable v-full-tbl-name  as character no-undo .
      731       define variable bh_tbl-name      as handle    no-undo .
      732       define variable v-tbl-name       as character no-undo .
      733       define variable v-field-num      as integer   no-undo .
      734       define variable v-count-fld      as integer   no-undo .
      735       define variable v-inform         as character no-undo .
      736       define variable v-ind            as integer   no-undo .
      737       define variable v-idx-field-qnty as integer   no-undo .
      738       define variable v-delim-key      as character no-undo .
      739       if p-table = ?
      740         or p-table = "":U
      741       then do:
      742         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      743       end.
      744       assign
      745         v-tbl-name      = p-table
      746         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      747       .
      748       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      749       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      750       assign
      751         v-inform = bh_tbl-name:index-information(1)
      752         v-ind    = 2
      753       .
      754       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      755       on error undo, return error
      756       :
      757         assign
      758           v-inform = bh_tbl-name:index-information( v-ind )
      759           v-ind    = v-ind + 1
      760         .
      761       end.
      762       if v-inform = ?
      763         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      764         or entry( 3, v-inform, ",":U ) <> "1":U
      765       then do:
      766         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      767       end.
      768       assign
      769         v-idx-field-qnty = num-entries( v-inform ) - 4
      770       .
      771       if v-idx-field-qnty < 2 then do:
      772         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      773       end.
      774       assign
      775         p-field-list = "":U
      776         v-delim-key  = "":U
      777         v-count-fld  = 0
      778       .
      779       block_where:
      780       do v-ind = 1 to v-idx-field-qnty by 2
      781       on error undo, return error
      782       :
      783         assign
      784           v-count-fld = v-count-fld + 1
      785         .
      786         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      787         if v-ind = 1 then do:
      788           assign
      789             v-delim-key = chr(3)
      790           .
      791         end.
      792       end.
      793       delete object bh_tbl-name.
      794     end.
      795   end procedure.
      796   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   procedure cur-time :
      798      define output parameter p-today as date      no-undo .
      799      define output parameter p-time  as integer   no-undo .
      800     do
      801     on error undo, return error
      802     :
      803       define variable v-date1 as date      no-undo .
      804       define variable v-date2 as date      no-undo .
      805       define variable v-time  as integer   no-undo .
      806       assign
      807         v-date1 = today
      808         v-time  = time
      809         v-date2 = today
      810       .
      811       if v-date1 <> v-date2
      812       then do:
      813         assign
      814           v-date1 = today
      815           v-time  = v-time
      816         .
      817       end.
      818       assign
      819         p-today = v-date1
      820         p-time  = v-time
      821       .
      822     end.
      823   end.
      824   function cur-time-date returns character
      825   :
      826     return string(today, '99/99/9999':U) .
      827   end.
      828   function cur-time-mjd returns decimal
      829   :
      830     define variable v-date as date      no-undo .
      831     define variable v-time as integer   no-undo .
      832     run cur-time in this-procedure
      833       (output v-date
      834       ,output v-time
      835       ) .
      836     return integer(v-date) - 2400002 + (v-time / 86400) .
      837   end.
      838   function cur-time-get-ending-index returns integer
      839   (input p-number as integer
      840   )
      841   :
      842     if p-number < 0
      843     or p-number = ?
      844     then do:
      845       return 1 .
      846     end.
      847     define variable v-rest as integer   no-undo .
      848     assign
      849       p-number = p-number modulo 100
      850     .
      851     if p-number < 20
      852     then do:
      853       assign
      854         v-rest = p-number
      855       .
      856     end.
      857     else do:
      858       assign
      859         v-rest = p-number modulo 10
      860       .
      861     end.
      862     case v-rest :
      863       when 1
      864       then do:
      865         return 2 .
      866       end.
      867       when 2 or
      868       when 3 or
      869       when 4
      870       then do:
      871         return 3 .
      872       end.
      873       otherwise do:
      874         return 1 .
      875       end.
      876     end case .
      877   end.
      878   procedure cur-time-mjd-to-date :
      879      define input  parameter i-mjd-diff as decimal no-undo.
      880      define output parameter o-Date     as date    no-undo.
      881      define output parameter o-Time     as integer no-undo.
      882      define variable v-day-number as integer   no-undo .
      883      if    i-mjd-diff < 0
      884         or i-mjd-diff = ?
      885      then do:
      886         return "?" .
      887      end.
      888      assign
      889         v-day-number = truncate(i-mjd-diff,0).
      890         o-Date = date(v-day-number + 2400002).
      891         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      892     .
      893   end.
      894   function cur-time-mjd-to-string returns character
      895   (input p-mjd-diff as decimal
      896   )
      897   :
      898     define variable v-day-number as integer   no-undo .
      899     define variable v-seconds    as integer   no-undo .
      900     define variable v-hour       as integer   no-undo .
      901     define variable v-min        as integer   no-undo .
      902     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      903     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      904     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      905     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      906     if p-mjd-diff < 0
      907     or p-mjd-diff = ?
      908     then do:
      909       return "?" .
      910     end.
      911     assign
      912       v-day-number = integer(truncate(p-mjd-diff,0))
      913       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      914     .
      915     if v-seconds > 86400
      916     then do:
      917       assign
      918         v-seconds = 86400 - 1
      919       .
      920     end.
      921     if v-seconds < 0
      922     then do:
      923       assign
      924         v-seconds = 0
      925       .
      926     end.
      927     assign
      928       v-hour = truncate(v-seconds / 3600, 0)
      929     .
      930     assign
      931       v-seconds = v-seconds modulo 3600
      932     .
      933     assign
      934       v-min = truncate(v-seconds / 60, 0)
      935     .
      936     assign
      937       v-seconds = v-seconds modulo 60
      938     .
      939     return
      940         (if v-day-number <> 0
      941           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      942           else ""
      943         )
      944       + (if v-day-number <> 0 or v-hour <> 0
      945           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      946           else ""
      947         )
      948       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      949           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      950           else ""
      951         )
      952       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      953       .
      954   end.
      955   function cur-time-string returns character
      956   :
      957     define variable v-date as date      no-undo .
      958     define variable v-time as integer   no-undo .
      959     run cur-time in this-procedure
      960       (output v-date
      961       ,output v-time
      962       ) .
      963     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      964   end.
      965   function cur-time-string-sec returns character
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      974   end.
      975   function cur-time-custom  returns character
      976   (input p-prefix as character
      977   ,input p-date-format as character
      978   ,input p-delimiter as character
      979   ,input p-time-format as character
      980   ,input p-suffix as character
      981   )
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return
      990       p-prefix
      991       + string(v-date, p-date-format)
      992       + p-delimiter
      993       + string(v-time, p-time-format)
      994       + p-suffix
      995       .
      996   end.
      997   function cur-time-print  returns character
      998   :
      999     define variable v-date as date      no-undo .
     1000     define variable v-time as integer   no-undo .
     1001     run cur-time in this-procedure
     1002       (output v-date
     1003       ,output v-time
     1004       ) .
     1005     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1006   end.
     1007   function cur-time-datetime returns datetime
     1008   :
     1009     define variable v-char as character no-undo .
     1010     define variable v-datetime as datetime no-undo .
     1011     v-char = cur-time-string().
     1012     v-datetime = datetime(v-char).
     1013     return  v-datetime.
     1014   end.
     1015   function cur-time-string-msec returns character
     1016   :
     1017     define variable v-date as datetime  no-undo .
     1018     v-date = now.
     1019     return string(v-date) .
     1020   end.
     1021   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   define new shared temp-table temp-hist-nws-option no-undo
     1023   like ub.hist-nws-option
     1024   .
     1025   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   FUNCTION get-region RETURNS CHARACTER
     1029     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1030     define variable par-region as character no-undo.
     1031     if parhost-code = 0 and
     1032          parobj-type = "":U and
     1033          parobj-code = 0 then do:
     1034          par-region = "Глобально".
     1035          return par-region.
     1036       end.
     1037       if parobj-type = 'орг':U then do:
     1038          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1039          return par-region.
     1040       end.
     1041       if parobj-type = 'регион':U
     1042       then do:
     1043          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1044          return par-region.
     1045       end.
     1046       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1047       return par-region.
     1048   END FUNCTION.
     1049   FUNCTION get-objregion RETURNS CHARACTER
     1050     (  input parobj-type as character, input parobj-code as integer ) :
     1051     define variable par-region as character no-undo.
     1052     if  parobj-type = "":U and
     1053         parobj-code = 0
     1054     then do:
     1055        par-region = "Глобально".
     1056     end.
     1057     else if parobj-type = 'орг':U
     1058     then do:
     1059        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1060     end.
     1061     else if parobj-type = 'регион':U
     1062     then do:
     1063        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1064     end.
     1065     else
     1066        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1067     return par-region.
     1068   END FUNCTION.
     1069   FUNCTION calldscr returns character ( input p-call-id as character):
     1070   define variable v-descr as character no-undo .
     1071   define variable v-field-list as character no-undo .
     1072   define variable v-value-list as character no-undo.
     1073   define variable v-prop-label as character no-undo .
     1074   define variable v-node-label as character no-undo .
     1075   define variable v-dt-code as integer no-undo .
     1076   define variable v-host-code as integer no-undo .
     1077   define variable v-obj-type as character no-undo .
     1078   define variable v-obj-code as integer no-undo .
     1079   define variable v-label as character no-undo .
     1080   define variable v-node-code as integer no-undo .
     1081   define buffer buf_prop-head for ub.prop-head.
     1082   define buffer buf_prop-ref for ub.prop-ref.
     1083   define buffer buf_prop-map for ub.prop-map.
     1084   run gen-key-fv in this-procedure ( input p-call-id
     1085                                     ,output v-field-list
     1086                                     ,output v-value-list) no-error .
     1087   if error-status:error then return p-call-id.
     1088   CASE entry(1, p-call-id, chr(3)):
     1089     when 'dis-card-type':U then do:
     1090       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1091                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1092                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1093                            ).
     1094     end.
     1095     when 'dis-card':U then do:
     1096       v-descr = substitute("ДК: № &1"
     1097                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1098                            ).
     1099     end.
     1100     when 'dis-card-property':U then do:
     1101       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1102       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1103       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1104       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1105       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1106       find first buf_prop-ref no-lock where
     1107                 buf_prop-ref.dt-code = v-dt-code no-error .
     1108       if available buf_prop-ref then do:
     1109         find first buf_prop-head no-lock where
     1110                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1111         v-prop-label = buf_prop-head.prop-label.
     1112         find first buf_prop-map no-lock where
     1113                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1114               and buf_prop-map.node-code = v-node-code no-error .
     1115         if available buf_prop-map then do:
     1116           v-label = buf_prop-map.node-label.
     1117         end.
     1118       end.
     1119       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1120                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1121                            ,v-prop-label
     1122                            ,v-label
     1123                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1124                            ).
     1125     end.
     1126     when 'clients':U then do:
     1127       v-descr = substitute("&1&2"
     1128                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1129                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1130                            ).
     1131     end.
     1132     when 'ext-system':U then do:
     1133       v-descr = substitute("Внешняя система &1"
     1134                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1135                            ).
     1136     end.
     1137     WHEN 'thbj-attr':U then do:
     1138       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1139       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1140       then do:
     1141         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1142           v-descr = "Операции с товарами".
     1143         end.
     1144         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1145           v-descr = "Операции с клиентами".
     1146         end.
     1147         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1148           v-descr = "Операции с группами товаров".
     1149         end.
     1150         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1151           v-descr = "Операции с группами клиентов".
     1152         end.
     1153         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1154           v-descr = "Операции с чеками на POS IBS-TH".
     1155         end.
     1156         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1157           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1158         end.
     1159         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1160           v-descr = "Операции в системе электронного документооборота".
     1161         end.
     1162         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1163           v-descr = "Операции со справочниками".
     1164         end.
     1165         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1166           v-descr = "Операции с ДНЦ и переоценками".
     1167         end.
     1168         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1169           v-descr = "Отчеты".
     1170         end.
     1171         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1172           v-descr = "Операции с заказами".
     1173         end.
     1174       end.
     1175     end.
     1176     when 'cash-desk':U then do:
     1177       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1178                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1179                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1180                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1181                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1182                            ).
     1183     end.
     1184     when 'ext-file':U then do:
     1185       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1186                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1187                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1188                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1189                            ).
     1190     end.
     1191   end case.
     1192   return v-descr.
     1193   end function.
