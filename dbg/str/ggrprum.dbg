     1283   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1284   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1285   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1286   procedure grplib-get-parameters :
     1287   define input parameter p-store-type     as character        no-undo.
     1288   define input parameter p-store-code     as integer          no-undo.
     1289   do
     1290   on error undo, return error
     1291   :
