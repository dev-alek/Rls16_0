        1   def new shared variable list-mode as char no-undo.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input  parameter parobj-type like ub.clients.obj-type no-undo.
        4   define input  parameter parobj-code like ub.clients.obj-code no-undo.
        5   define output parameter parrec-id   as recid initial ?    no-undo.
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Добавление связки резервуар-ТРК-пистолет".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   function nzpl-spl returns logical
      128   (input p-obj-type as character
      129                                   , input p-obj-code as integer):
      130   define variable v-dopi    as integer no-undo .
      131   define variable v-param-type as character no-undo .
      132   define variable v-value-character as character no-undo .
      133   define variable v-value-date as date no-undo .
      134   define variable v-value-decimal as decimal no-undo .
      135   define variable v-value-integer as integer no-undo .
      136   define variable v-value-logical as logical no-undo .
      137   define variable v-tth as handle no-undo .
      138   define variable dflt-cd as character no-undo .
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   define variable v-param-type1 as character no-undo .
      141   define variable v-value-date1 as date no-undo .
      142   define variable v-value-decimal1 as decimal no-undo .
      143   define variable v-value-integer1 as INTEGER no-undo .
      144   define variable v-value-logical1 AS LOGICAL no-undo .
      145   define variable v-tth1 as handle no-undo .
      146   run adm/shattri.p (
      147       input "get":U
      148       ,input  p-obj-type
      149       ,input  p-obj-code
      150       ,input  'cd-sending':U
      151       ,input  'dflt-cd':U
      152       ,output dflt-cd
      153       ,output v-value-date1
      154       ,output v-value-decimal1
      155       ,output v-value-integer1
      156       ,output v-value-logical1
      157       ,output v-param-type1
      158       ,INPUT-OUTPUT table-handle v-tth1
      159       ) no-error .
      160   delete object v-tth1 no-error.
      161   if dflt-cd <> 'IBM':U
      162   and dflt-cd <> 'IBM-XML':U then return no.
      163   if dflt-cd = 'IBM-XML':U then return yes.
      164   run adm/shattri.p (
      165       input "get":U
      166       ,input  p-obj-type
      167       ,input  p-obj-code
      168       ,input  'cd-type-ibm':U
      169       ,input  'ibmspool':U
      170       ,output v-value-character
      171       ,output v-value-date
      172       ,output v-value-decimal
      173       ,output v-value-integer
      174       ,output v-value-logical
      175       ,output v-param-type
      176       ,INPUT-OUTPUT table-handle v-tth
      177       ) no-error .
      178   if error-status:error then do:
      179     delete object v-tth.
      180     return no.
      181   end.
      182   delete object v-tth.
      183   assign
      184   v-dopi = v-value-integer no-error .
      185   if v-dopi >= 6 then return yes.
      186   end. // FUNCTION/method
      187   FUNCTION nzpl-two returns logical
      188                                    (input p-obj-type as character
      189                                     , input p-obj-code as integer):
      190     define variable v-nzpl-two as logical no-undo.
      191     run
      192     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      193     return v-nzpl-two.
      194   end. // FUNCTION/method
      195   procedure nzpl-two-proc :
      196   define input  parameter p-obj-type   as character no-undo.
      197   define input  parameter p-obj-code   as integer   no-undo.
      198   define output parameter varge-two-pl as logical   no-undo.
      199   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      200   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      201   //do on error undo, return error return-value :
      202   assign
      203     varge-two-pl = no.
      204   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      205                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      206                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      207     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      208                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      209                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      210                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      211                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      212                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      213     if available bf-other_pl-gds-pump then do:
      214       assign
      215         varge-two-pl = yes.
      216       leave.
      217     end.
      218   end.
      219   //end.
      220   end. // procedure/method .
      221   define variable varmes-log as logical no-undo.
      222   define variable varobj-type like ub.clients.obj-type no-undo.
      223   define variable varobj-code like ub.clients.obj-code no-undo.
      224   define variable varbuttons  as   character        no-undo.
      225   define variable varps-upd   as   logical          no-undo.
      226   procedure plpmnzav:
      227     define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      228     define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      229     define input parameter parpl-code     like ub.place.pl-code      no-undo.
      230     define input parameter parpump-code   like ub.pump.pump-code     no-undo.
      231     define input parameter parnozzle-code like ub.nozzle.nozzle-code no-undo.
      232     do
      233     on error undo, return error return-value
      234     :
      235       define buffer bf_clients              for ub.clients.
      236       define buffer bf_place                for ub.place.
      237       define buffer bf_pump                 for ub.pump.
      238       define buffer bf_nozzle               for ub.nozzle.
      239       define buffer bf_pl-pump              for ub.pl-pump.
      240       define buffer bf_pump-nozzle          for ub.pump-nozzle.
      241       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      242       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      243       define buffer bf_rvs-doc              for ub.rvs-doc.
      244       define buffer bf_icnt-doc             for ub.icnt-doc.
      245       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      246       define buffer bf-other_pl-gds-pump    for ub.pl-gds-pump.
      247   find first bf_clients where bf_clients.obj-type = parobj-type and
      248                               bf_clients.obj-code = parobj-code no-lock no-error.
      249   if not available bf_clients then
      250      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      251   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      252                            bf_pump.obj-code  = parobj-code  and
      253                            bf_pump.pump-code = parpump-code no-lock no-error.
      254   if not available bf_pump then
      255      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      256   find first bf_place where bf_place.obj-type = parobj-type and
      257                             bf_place.obj-code = parobj-code and
      258                             bf_place.pl-code  = parpl-code  no-lock no-error.
      259   if not available bf_place then return error SUBSTITUTE("Нет такого складского места &1", parpl-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      260   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      261                              bf_nozzle.obj-code    = parobj-code    and
      262                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      263   if not available bf_nozzle then
      264      return error SUBSTITUTE("Нет пистолета ТРК с номером &1", parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      265   find first bf_pl-pump where bf_pl-pump.obj-type  = parobj-type  and
      266                               bf_pl-pump.obj-code  = parobj-code  and
      267                               bf_pl-pump.pl-code   = parpl-code   and
      268                               bf_pl-pump.pump-code = parpump-code no-lock no-error.
      269   if not available bf_pl-pump then
      270      return error SUBSTITUTE("Нет записи резервуар-ТРК с номером резервуара &1 и номером ТРК &2",
      271                              parpl-code, parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      272   find first bf_pump-nozzle where bf_pump-nozzle.obj-type    = parobj-type    and
      273                                   bf_pump-nozzle.obj-code    = parobj-code    and
      274                                   bf_pump-nozzle.pump-code   = parpump-code   and
      275                                   bf_pump-nozzle.nozzle-code = parnozzle-code no-lock no-error.
      276   if not available bf_pump-nozzle then
      277      return error SUBSTITUTE("Нет записи ТРК-пистолет с номером ТРК &1 и номером пистолета &2",
      278                                                           parpump-code,
      279                                                           parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      280    find first bf_rvs-doc where bf_rvs-doc.obj-type =  parobj-type       and
      281                                bf_rvs-doc.obj-code =  parobj-code       and
      282                                bf_rvs-doc.status_  <> 'факт':U           and
      283                                bf_rvs-doc.rvs-type <> 'перед_док':U and
      284                                bf_rvs-doc.rvs-type <> 'после_док':U  and
      285                                bf_rvs-doc.rvs-type <> 'проверка':U       no-lock no-error.
      286   if available bf_rvs-doc then do:
      287      return error SUBSTITUTE("На объекте есть открытый документ сверки &1 .", bf_rvs-doc.rvs-code).
      288   end.
      289   find first bf_icnt-doc where bf_icnt-doc.obj-type  =  parobj-type and
      290                                bf_icnt-doc.obj-code  =  parobj-code and
      291                                bf_icnt-doc.status_   <> 'факт':U     no-lock no-error.
      292   if available bf_icnt-doc then do:
      293      return error SUBSTITUTE("На объекте есть открытый документ инвентаризации счетчиков ТРК &1 .", bf_icnt-doc.doc-code).
      294   end.
      295       if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      296         find first bf_pl-pump-nozzle no-lock
      297           where bf_pl-pump-nozzle.obj-type   = parobj-type
      298             and bf_pl-pump-nozzle.obj-code   = parobj-code
      299             and bf_pl-pump-nozzle.pl-code    = parpl-code
      300             and bf_pl-pump-nozzle.pump-code  = parpump-code
      301           no-error.
      302         if available bf_pl-pump-nozzle then do:
      303           return error substitute("Резервуар &1 уже связан с ТРК &2, через пистолет &3", parpl-code, parpump-code, bf_pl-pump-nozzle.nozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      304         end.
      305       end.
      306       do transaction
      307       on error undo, return error return-value
      308       :
      309         find first bf_pl-gds-pump no-lock
      310           where bf_pl-gds-pump.obj-type  = parobj-type
      311             and bf_pl-gds-pump.obj-code  = parobj-code
      312             and bf_pl-gds-pump.pl-code   = parpl-code
      313             and bf_pl-gds-pump.pump-code = parpump-code
      314           no-error.
      315         if available bf_pl-gds-pump then do:
      316           find first bf-other_pl-gds-pump no-lock
      317             where bf-other_pl-gds-pump.obj-type  = bf_pl-gds-pump.obj-type
      318               and bf-other_pl-gds-pump.obj-code  = bf_pl-gds-pump.obj-code
      319               and bf-other_pl-gds-pump.gds-code  = bf_pl-gds-pump.gds-code
      320               and bf-other_pl-gds-pump.pump-code = bf_pl-gds-pump.pump-code
      321               and bf-other_pl-gds-pump.pl-code  <> bf_pl-gds-pump.pl-code
      322             no-error.
      323           if available bf-other_pl-gds-pump then do:
      324             if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      325               find first bf-other_pl-pump-nozzle no-lock
      326                 where bf-other_pl-pump-nozzle.obj-type  = bf-other_pl-gds-pump.obj-type
      327                   and bf-other_pl-pump-nozzle.obj-code  = bf-other_pl-gds-pump.obj-code
      328                   and bf-other_pl-pump-nozzle.pl-code   = bf-other_pl-gds-pump.pl-code
      329                   and bf-other_pl-pump-nozzle.pump-code = bf-other_pl-gds-pump.pump-code
      330                 no-error.
      331               if available bf-other_pl-pump-nozzle then do:
      332                 if bf-other_pl-pump-nozzle.nozzle-code <> parnozzle-code then do:
      333                   return error substitute ("На объекте &1 &2 ТРК &3 через пистолет &4 торгует топливом с внутренним кодом &5 из резервуара &6.&7"
      334                                            + "КАСССА не возвращает номер пистолета в чеке, .&7"
      335                                            + "поэтому нельзя торговать одним и тем же топливом на одной ТРК через разные пистолеты.&7"
      336                                            , bf-other_pl-pump-nozzle.obj-type
      337                                            , bf-other_pl-pump-nozzle.obj-code
      338                                            , bf-other_pl-pump-nozzle.pump-code
      339                                            , bf-other_pl-pump-nozzle.nozzle-code
      340                                            , bf-other_pl-gds-pump.gds-code
      341                                            , bf-other_pl-gds-pump.pl-code
      342                                            , chr(10)
      343                                           ).
      344                 end.
      345               end.
      346             end.
      347             else do:
      348               find current bf_pl-gds-pump exclusive-lock.
      349               assign
      350                 bf_pl-gds-pump.status_ = 'блок':U.
      351             end.
      352           end.
      353           for each bf-other_pl-pump-nozzle where bf-other_pl-pump-nozzle.obj-type    = parobj-type
      354                                               and bf-other_pl-pump-nozzle.obj-code    = parobj-code
      355                                               and bf-other_pl-pump-nozzle.pump-code   = parpump-code
      356                                               and bf-other_pl-pump-nozzle.nozzle-code = parnozzle-code
      357                                               no-lock on error undo, return error return-value :
      358             find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  = bf-other_pl-pump-nozzle.obj-type
      359                                               and bf-other_pl-gds-pump.obj-code  = bf-other_pl-pump-nozzle.obj-code
      360                                               and bf-other_pl-gds-pump.pl-code   = bf-other_pl-pump-nozzle.pl-code
      361                                               and bf-other_pl-gds-pump.pump-code = bf-other_pl-pump-nozzle.pump-code no-lock no-error.
      362             if available bf-other_pl-gds-pump then do:
      363               if bf-other_pl-gds-pump.gds-code <> bf_pl-gds-pump.gds-code then do:
      364                 return error substitute ("На объекте &1 &2 ТРК &3 через пистолет &4 торгует топливом с внутренним кодом &5 из резервуара &6. Вы хотите торговать топливом с внутренним кодом &7. Разными видами топлива через один пистолет на одной ТРК торговать нельзя.",
      365                                           bf-other_pl-pump-nozzle.obj-type,
      366                                           bf-other_pl-pump-nozzle.obj-code,
      367                                           bf-other_pl-pump-nozzle.pump-code,
      368                                           bf-other_pl-pump-nozzle.nozzle-code,
      369                                           bf-other_pl-gds-pump.gds-code,
      370                                           bf-other_pl-gds-pump.pl-code,
      371                                           bf_pl-gds-pump.gds-code).
      372               end.
      373             end.
      374           end.
      375         end.
      376         create bf_pl-pump-nozzle.
      377         assign
      378           bf_pl-pump-nozzle.obj-type    = parobj-type
      379           bf_pl-pump-nozzle.obj-code    = parobj-code
      380           bf_pl-pump-nozzle.pl-code     = parpl-code
      381           bf_pl-pump-nozzle.pump-code   = parpump-code
      382           bf_pl-pump-nozzle.nozzle-code = parnozzle-code
      383         .
      384       end.
      385     end.
      386   end procedure.
      387   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   define new global shared variable g#attr-lib  as handle no-undo .
      389   define variable v-attr-lib-variable as handle no-undo .
      390   procedure gds-attr-name :
      391     define input  parameter p-code           as character no-undo .
      392     define output parameter p-type           as character no-undo .
      393     define output parameter p-format         as character no-undo .
      394     define output parameter p-label          as character no-undo .
      395     define output parameter p-user-can-edit  as logical   no-undo .
      396     define output parameter p-output-display as logical   no-undo .
      397     define output parameter p-other          as character no-undo .
      398     do
