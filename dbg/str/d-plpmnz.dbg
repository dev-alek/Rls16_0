      969   function is-sug returns logical
      970           (input p-gds-code as integer):
      971   define variable result as logical no-undo.
      972   define variable c-value as character no-undo.
      973   define variable c-type as character no-undo.
      974   do on error undo, return error:
      975           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      976         (input  p-gds-code
      977         ,input  'fuel-type':U
      978         ,output c-value
      979         ,output c-type) no-error.
      980   end.
      981   result = logical(c-value = 'lgas':U) no-error.
      982   return result.
      983   end function.
      984   procedure placelib_write-attr:
      985   define input  parameter p-code     like ub.place-attr.attr-code .
      986   define input  parameter p-obj-code like ub.place-attr.obj-code .
      987   define input  parameter p-obj-type like ub.place-attr.obj-type .
      988   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      989   define input  parameter p-value    like ub.place-attr.attr-value .
      990   define output parameter p-ok       as logical.
      991   define buffer buf_place-attr for ub.place-attr .
      992     do on error undo, return error return-value :
      993        p-ok = false.
      994        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      995                                                   and buf_place-attr.obj-code    = p-obj-code
      996                                                   and buf_place-attr.obj-type    = p-obj-type
      997                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      998        if not available buf_place-attr then do :
      999           create buf_place-attr.
     1000           assign
     1001             buf_place-attr.attr-code   = p-code
     1002             buf_place-attr.attr-value  = p-value
     1003             buf_place-attr.obj-code    = p-obj-code
     1004             buf_place-attr.obj-type    = p-obj-type
     1005             buf_place-attr.pl-code     = p-pl-code
     1006           .
     1007           p-ok = true.
     1008        end.
     1009        else do:
     1010           buf_place-attr.attr-value  = p-value .
     1011           p-ok = true.
     1012        end.
     1013     end.
     1014   end.
     1015   procedure placelib_get-attr:
     1016   define input  parameter  p-code     like ub.place-attr.attr-code .
     1017   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1018   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1019   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1020   define output parameter  p-value    like ub.place-attr.attr-value .
     1021   define output parameter  p-ok       as logical.
     1022   define buffer buf_place-attr for ub.place-attr .
     1023     do on error undo, return error return-value :
     1024        p-ok = false.
     1025        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1026                                                   and buf_place-attr.obj-code    = p-obj-code
     1027                                                   and buf_place-attr.obj-type    = p-obj-type
     1028                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1029        if available buf_place-attr then do :
     1030          p-value = buf_place-attr.attr-value.
     1031          p-ok = true.
     1032        end.
     1033        else do :
     1034          p-ok = false.
     1035        end.
     1036     end.
     1037   end.
     1038   procedure placelib_del-attr:
     1039   define input parameter  p-code     like ub.place-attr.attr-code .
     1040   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1041   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1042   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1043   define input parameter  p-value    like ub.place-attr.attr-value .
     1044   define output parameter p-ok       as logical.
     1045   define buffer buf_place-attr for ub.place-attr .
     1046     do on error undo, return error return-value :
     1047        p-ok = false.
     1048        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1049                                                   and buf_place-attr.obj-code    = p-obj-code
     1050                                                   and buf_place-attr.obj-type    = p-obj-type
     1051                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1052        if available buf_place-attr then do :
     1053           delete buf_place-attr.
     1054           p-ok = true.
     1055        end.
     1056     end.
     1057   end.
     1058   DEFINE BUTTON b-cancel AUTO-END-KEY
     1059        LABEL "&Отмена"
     1060        SIZE 10 BY 1
     1061        BGCOLOR 8 .
     1062   DEFINE BUTTON b-help
     1063        LABEL "Помо&щь"
     1064        SIZE 10 BY 1
     1065        BGCOLOR 8 .
     1066   DEFINE BUTTON b-nozzle
     1067        IMAGE-UP FILE "btn-down-arrow":U
     1068        IMAGE-DOWN FILE "btn-down-arrow":U
     1069        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1070        LABEL "b-nozzle"
     1071        SIZE 3 BY .88.
     1072   DEFINE BUTTON b-place
     1073        IMAGE-UP FILE "btn-down-arrow":U
     1074        IMAGE-DOWN FILE "btn-down-arrow":U
     1075        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1076        LABEL ""
     1077        SIZE 3 BY .88.
     1078   DEFINE BUTTON b-pump
     1079        IMAGE-UP FILE "btn-down-arrow":U
     1080        IMAGE-DOWN FILE "btn-down-arrow":U
     1081        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1082        LABEL ""
     1083        SIZE 3 BY .88.
     1084   DEFINE BUTTON b-save AUTO-GO
     1085        LABEL "&Ввод"
     1086        SIZE 10 BY 1
     1087        BGCOLOR 8 .
     1088   DEFINE VARIABLE varnozzle-code AS INTEGER FORMAT ">9":U INITIAL 0
     1089        LABEL "Номер пистолета ТРК"
     1090        VIEW-AS FILL-IN
     1091        SIZE 3 BY 1 NO-UNDO.
     1092   DEFINE VARIABLE varpl-code AS INTEGER FORMAT "99999999999":U INITIAL 0
     1093        LABEL "Бар-код резервуара"
     1094        VIEW-AS FILL-IN
     1095        SIZE 10.38 BY 1 NO-UNDO.
     1096   DEFINE VARIABLE varpump-code AS INTEGER FORMAT ">9":U INITIAL 0
     1097        LABEL "Номер ТРК"
     1098        VIEW-AS FILL-IN
     1099        SIZE 3 BY 1 NO-UNDO.
     1100   DEFINE FRAME Dialog-Frame
     1101        b-save AT ROW 1 COL 1
     1102        b-cancel AT ROW 1 COL 11
     1103        b-help AT ROW 1 COL 21
     1104        varpl-code AT ROW 2.54 COL 2.88
     1105        b-place AT ROW 2.67 COL 34
     1106        varpump-code AT ROW 3.92 COL 20.88 COLON-ALIGNED
     1107        b-pump AT ROW 4.04 COL 34
     1108        varnozzle-code AT ROW 5.29 COL 20.88 COLON-ALIGNED
     1109        b-nozzle AT ROW 5.29 COL 34
     1110        SPACE(0.99) SKIP(0.45)
     1111       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1112            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1113            TITLE "Добавление  резервуар-ТРК"
     1114            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
     1115   ASSIGN
     1116          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1117          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1118   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1119   DO:
     1120     APPLY "END-ERROR":U TO SELF.
     1121   END.
     1122   ON CHOOSE OF b-nozzle IN FRAME Dialog-Frame
     1123   DO:
     1124     define variable varrec-id_nozzle as recid initial ? no-undo.
     1125     define buffer bf_nozzle for ub.nozzle.
     1126     run str/nozzlerf.w
     1127       ( input  parparentproc
     1128        ,input  parobj-type
     1129        ,input  parobj-code
     1130        ,output varrec-id_nozzle
     1131       ).
     1132     if varrec-id_nozzle <> ? then do:
     1133        find first bf_nozzle where recid(bf_nozzle) = varrec-id_nozzle no-lock no-error.
     1134        if available bf_nozzle then do:
     1135           display bf_nozzle.nozzle-code @ varnozzle-code with frame Dialog-Frame.
     1136        end.
     1137     end.
     1138   END.
     1139   ON CHOOSE OF b-place IN FRAME Dialog-Frame
     1140   DO:
     1141     define variable place-list as character no-undo .
     1142     define variable v-value           as character no-undo .
     1143     define variable v-ok              as logical   no-undo .
     1144     define buffer buf_pl-gds for ub.pl-gds .
     1145     run ref/pl-list.w (
     1146                    input parparentproc
     1147                   ,input "b-sel"
     1148                   ,input parobj-type
     1149                   ,input parobj-code
     1150                   ,input 'объект':U
     1151                  , input-output place-list).
     1152     if place-list = "cancel"
     1153     then do :
     1154       return no-apply .
     1155     end .
     1156     if place-list <> '':U then do:
     1157       FIND FIRST place No-LOCK WHERE recid(place) = integer(entry(1, place-list)) NO-ERROR.
     1158       if available place
     1159       then do :
     1160         find first buf_pl-gds no-lock where buf_pl-gds.obj-type = place.obj-type
     1161                                         and buf_pl-gds.obj-code = place.obj-code
     1162                                         and buf_pl-gds.pl-code = place.pl-code
     1163                                         no-error .
     1164         if available buf_pl-gds
     1165         then do :
     1166           run placelib_get-attr  (
     1167              input "place-com-tanks"
     1168             ,input buf_pl-gds.obj-code
     1169             ,input buf_pl-gds.obj-type
     1170             ,input buf_pl-gds.pl-code
     1171             ,output v-value
     1172             ,output v-ok      )
     1173           no-error.
     1174           if v-ok
     1175           and v-value > ""
     1176           then do :
     1177             run placelib_get-attr  (
     1178                input "place-is-main"
     1179               ,input buf_pl-gds.obj-code
     1180               ,input buf_pl-gds.obj-type
     1181               ,input buf_pl-gds.pl-code
     1182               ,output v-value
     1183               ,output v-ok      )
     1184             no-error.
     1185             if v-ok
     1186             and not logical(v-value)
     1187             then do :
     1188               message 'Установить связь Резервуар-ТРК-Пистолеты можно только с резервуаром с отметкой "Главный"!' view-as alert-box .
     1189               return no-apply .
     1190             end .
     1191           end .
     1192         end .
     1193         display place.pl-code @ varpl-code with frame Dialog-Frame.
     1194       end .
     1195     end.
     1196   END.
     1197   ON CHOOSE OF b-pump IN FRAME Dialog-Frame
     1198   DO:
     1199     define variable varrec-id_pump as recid initial ? no-undo.
     1200     define buffer bf_pump for ub.pump.
     1201     run str/pumprf.w
     1202       ( input parparentproc
     1203        ,input  parobj-type
     1204        ,input  parobj-code
     1205        ,output varrec-id_pump
     1206       ).
     1207     if varrec-id_pump <> ? then do:
     1208        find first bf_pump where recid(bf_pump) = varrec-id_pump no-lock no-error.
     1209        if available bf_pump then do:
     1210           display bf_pump.pump-code @ varpump-code with frame Dialog-Frame.
     1211        end.
     1212     end.
     1213   END.
     1214   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1215   DO:
     1216   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   if lookup(self :type
     1218            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1219            ) = 0
     1220   then do:
     1221     message
     1222       "$Workfile$"
     1223       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1224       "Интерфейсный элемент" self :name  skip
     1225       "Тип" self :type  skip
     1226       "Процедура" this-procedure :file-name skip
     1227       view-as alert-box .
     1228   end.
     1229   else do:
     1230     apply "entry":u to self  .
     1231     if focus :handle <> self :handle  then do:
     1232       return no-apply .
     1233     end.
     1234   end.
     1235     assign frame Dialog-Frame
     1236       varpl-code
     1237       varpump-code
     1238       varnozzle-code
     1239     .
     1240     run plpmnzav in this-procedure
     1241       ( input parobj-type
     1242        ,input parobj-code
     1243        ,input varpl-code
     1244        ,input varpump-code
     1245        ,input varnozzle-code
     1246       ) no-error.
     1247     if error-status:error then do:
     1248   message
     1249     vss-workfile vss-revision vss-description skip
     1250     "Ошибка при создании записи резервуар-ТРК-пистолет" skip
     1251     "-----------Cистемная ошибка------------" skip
     1252     return-value skip
     1253     "------Ошибка исполнения программы------" skip
     1254     trim(error-status :get-message(1)) +
     1255     trim(error-status :get-message(2)) +
     1256     trim(error-status :get-message(3)) +
     1257     trim(error-status :get-message(4)) +
     1258     trim(error-status :get-message(5)) skip
     1259     view-as alert-box error .
     1260        return no-apply.
     1261     end.
     1262     find first ub.pl-pump-nozzle no-lock
     1263       where ub.pl-pump-nozzle.obj-type    = parobj-type
     1264         and ub.pl-pump-nozzle.obj-code    = parobj-code
     1265         and ub.pl-pump-nozzle.pl-code     = varpl-code
     1266         and ub.pl-pump-nozzle.pump-code   = varpump-code
     1267         and ub.pl-pump-nozzle.nozzle-code = varnozzle-code
     1268       .
     1269     assign
     1270       parrec-id = recid( ub.pl-pump-nozzle )
     1271     .
     1272   END.
     1273   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1274   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1275   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1276   on help of frame Dialog-Frame
     1277   do:
     1278     run gbl/app_help.p
     1279       (input this-procedure :file-name
     1280       ,input ''
     1281       ,input ?
     1282       ) no-error.
     1283     if error-status :error then do:
     1284       message
     1285         "Ошибка при вызове помощи"
     1286         error-status :get-message(1)
     1287         view-as alert-box .
     1288     end.
     1289   end.
     1290   run minbtn-set in this-procedure .
     1291   on choose of b-help in frame Dialog-Frame
     1292   do:
     1293     apply "help":u to frame Dialog-Frame .
     1294   end.
     1295   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   procedure minbtn-set :
     1297       do
     1298           on error undo, return error return-value
     1299           :
     1300           define variable ii              as integer       no-undo .
     1301           define variable fh              as widget-handle no-undo .
     1302           define variable hh              as widget-handle no-undo .
     1303           define variable v-h             as handle        extent 4 no-undo .
     1304           define variable v-name-button   as character     no-undo .
     1305           define variable v-help-old-x    as decimal       no-undo .
     1306           define variable v-help-old-y    as decimal       no-undo .
     1307           define variable v-help-old-size as decimal       no-undo .
     1308           define variable v-frame-width   as decimal       no-undo .
     1309           define variable jj              as integer       no-undo .
     1310           do
     1311               on error undo, return error
     1312               :
     1313               assign
     1314                   v-frame-width = frame Dialog-Frame:width - 0.3
     1315                   fh            = frame Dialog-Frame:first-child
     1316                   hh            = fh:first-child
     1317                   ii            = 1
     1318                   .
     1319               do while valid-handle(hh):
     1320                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1321                   do:
     1322                       case lc(hh:name) :
     1323                           when "b-help" then
     1324                               do:
     1325                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1326                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1327                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1328                                   hh:TOOLTIP = "Помощь" .
     1329                                   v-help-old-x = hh:column .
     1330                                   v-help-old-y = hh:row    .
     1331                                   v-help-old-size = hh:width .
     1332                                   hh:width-chars = 2.5 .
     1333                               end.
     1334                           when "b-print" then
     1335                               do:
     1336                                   hh:load-image("cmp/b-print.bmp":u) .
     1337                                   hh:TOOLTIP = "Печать" .
     1338                                   v-h[ii] = hh:handle .
     1339                                   ii = ii + 1 .
     1340                                   hh:width-chars = 3 .
     1341                               end.
     1342                           when "b-history" or
     1343                           when "b-hist" then
     1344                               do:
     1345                                   hh:load-image("cmp/b-hist.bmp":u) .
     1346                                   hh:TOOLTIP = "История" .
     1347                                   v-h[ii] = hh:handle .
     1348                                   ii = ii + 1 .
     1349                                   hh:width-chars = 3 .
     1350                               end.
     1351                           when "b-sch" then
     1352                               do:
     1353                                   hh:load-image("cmp/b-sch.bmp":u) .
     1354                                   hh:TOOLTIP = "Установка Фильтра" .
     1355                                   v-h[ii] = hh:handle .
     1356                                   ii = ii + 1 .
     1357                                   hh:width-chars = 3 .
     1358                               end.
     1359                           when "b-hist-user" then
     1360                               do:
     1361                                   hh:load-image("cmp/b-hist.bmp":u) .
     1362                                   hh:TOOLTIP = "История пользователя" .
     1363                                   ii = ii + 1 .
     1364                               end.
     1365                       end case.
     1366                   end.
     1367                   hh = hh:next-sibling.
     1368               end.
     1369               b-help:column = v-frame-width - b-help:width-chars.
     1370               jj = 0.
     1371               repeat ii = 4 to 1 by -1 :
     1372                   if valid-handle (v-h[ii] ) then
     1373                   do:
     1374                       jj  = jj + 1 .
     1375                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1376                       v-h[ii]:row    = v-help-old-y .
     1377                   end.
     1378               end.
     1379           end.
     1380       end.
     1381   end procedure.
     1382   MAIN-BLOCK:
     1383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1385     RUN enable_UI.
     1386     WAIT-FOR GO OF FRAME Dialog-Frame.
     1387   END.
     1388   RUN disable_UI.
     1389   PROCEDURE disable_UI :
     1390     HIDE FRAME Dialog-Frame.
     1391   END PROCEDURE.
     1392   PROCEDURE enable_UI :
     1393     DISPLAY varpl-code varpump-code varnozzle-code
     1394         WITH FRAME Dialog-Frame.
     1395     ENABLE b-save b-cancel b-help varpl-code b-place varpump-code b-pump
     1396            varnozzle-code b-nozzle
     1397         WITH FRAME Dialog-Frame.
     1398     VIEW FRAME Dialog-Frame.
     1399   END PROCEDURE.
