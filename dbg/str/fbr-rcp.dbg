        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo.
        4   define input parameter p-fbr-doc-recid  as recid            no-undo.
        5   define input parameter p-silent         as logical          no-undo .
        6   define input parameter p-recipe-code    as character        no-undo.
        7   define input parameter p-autofbr        as logical          no-undo.
        8   define input parameter p-have-store     as logical          no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: deb925b3c67c, 1358, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       11   define variable vss-date        as character no-undo init "$Date: Tue May 22 14:25:44 2018 +0300 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: fbr-rcp.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/fbr-rcp.p $":U .
       14   define variable vss-description as character no-undo init "Резервирование и расчет учетных цен товаров рецепта.".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3|&4',p-fbr-doc-recid,p-recipe-code,p-autofbr,p-have-store)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304       def var log-file-name as char no-undo.
      305       if search('fbr.log') = ?
      306       then do:
      307           assign
      308               log-file-name = ""
      309           .
      310       end.
      311       else do:
      312           assign
      313               log-file-name = 'fbr.log'
      314           .
      315       end.
      316       DEF STREAM stm-log.
      317       PROCEDURE writelog:
      318       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      319       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      320       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      321       if p-file-name <> ""
      322       then do:
      323       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      324           PUT STREAM stm-log UNFORMATTED chr(10).
      325           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      326                                           OR p-log-string = "&Line") THEN "" ELSE
      327                                           cur-time-string-sec() + " ").
      328           PUT STREAM stm-log UNFORMATTED
      329                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      330                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      331                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      332       OUTPUT STREAM stm-log CLOSE.
      333       end.
      334       END PROCEDURE.
      335   define variable v-fbr-log-file-name as character no-undo init 'fbr-rsrv-errors.txt'.
      336   define variable v-fbr-tt-log-file-name as character no-undo init 'fbr-rsrv-errors-tt.txt'.
      337   define temp-table tt-rsrv-err no-undo
      338     field artic like ub.goods.artic
      339     field gds-name like ub.goods.gds-name
      340     field rsrv-qnty like ub.gds-obj.fact-qnty
      341     field req-qnty like ub.gds-obj.fact-qnty
      342   .
      343   define stream stm.
      344       define variable v-unit-type     as character            no-undo.
      345       define variable v-alt-in-qnty   like ub.fbr-line.fact-qnty no-undo.
      346       define variable v-value-character as character  no-undo .
      347       define variable v-value-date      as date       no-undo .
      348       define variable v-value-integer   as integer    no-undo .
      349       define variable v-value-logical   as logical    no-undo .
      350       define variable v-tth             as handle     no-undo .
      351       define variable v-param-type            as character no-undo .
      352       define variable v-min-mrgn      as decimal      no-undo.
      353       define variable v-max-mrgn      as decimal      no-undo.
      354       define variable v-sum-alternative-qnty              as decimal       no-undo.
      355       define variable v-sum-write-off-qnty                as decimal       no-undo.
      356       define variable v-sum-income-qnty                   as decimal       no-undo.
      357       define variable v-sum-write-off-price-r-b           as decimal       no-undo.
      358       define variable v-sum-write-off-price-not-r-b       as decimal       no-undo.
      359       define variable v-sum-vat-write-off-price-r-b       as decimal       no-undo.
      360       define variable v-sum-vat-write-off-price-notrb     as decimal       no-undo.
      361       define variable v-count-rsrv-qnty                   as integer       no-undo.
      362       define variable v-sum-fix-cost-price-r-b            as decimal       no-undo.
      363       define variable v-sum-vat-fix-cost-price-r-b        as decimal       no-undo.
      364       define variable v-sum-input-price-sale              as decimal       no-undo.
      365       define variable v-count-input-fact-qnty             as integer       no-undo.
      366       define variable v-sum-input-price-r-b               as decimal       no-undo.
      367       define variable v-sum-vat-input-price-r-b           as decimal       no-undo.
      368       define variable v-margin                            as decimal       no-undo.
      369       define variable v-rb-is-base        as logical      no-undo.
      370       define variable v-not-reserved      as logical      no-undo.
      371       define buffer buf_zero_fbr-line  for  ub.fbr-line.
      372       define buffer buf_in_fbr-line   for  ub.fbr-line.
      373       define buffer buf_fbr-doc       for ub.fbr-doc.
      374       define buffer buf_fbr-line      for ub.fbr-line.
      375       define buffer buf_fbr-recipe        for ub.fbr-recipe.
      376       define buffer buf_goods         for ub.goods.
      377   do
      378   on error undo, return error
      379   :
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      382     (output v-rb-is-base
      383     )  .
      384      run adm/shattri.p ( input "get":U
      385                        , input  '':u
      386                        , input  0
      387                        , input  'fbrattr':U
      388                        , input  'fbr-mrgn-max':U
      389                        , output v-value-character
      390                        , output v-value-date
      391                        , output v-max-mrgn
      392                        , output v-value-integer
      393                        , output v-value-logical
      394                        , output v-param-type
      395                        , input-output table-handle v-tth
      396                        ) no-error .
      397      if error-status :error then do:
      398         assign
      399            v-max-mrgn = 0
      400         .
      401      end.
      402      run adm/shattri.p ( input "get":U
      403                        , input  '':u
      404                        , input  0
      405                        , input  'fbrattr':U
      406                        , input  'fbr-mrgn-min':U
      407                        , output v-value-character
      408                        , output v-value-date
      409                        , output v-min-mrgn
      410                        , output v-value-integer
      411                        , output v-value-logical
      412                        , output v-param-type
      413                        , input-output table-handle v-tth
      414                        ) no-error .
      415      if error-status :error then do:
      416         assign
      417            v-min-mrgn = 0
      418         .
      419      end.
      420       run writelog in this-procedure (
      421             input log-file-name
      422           , input 0
      423           , input "=====*** fbr-rcp.p ***================================================"
      424       ).
      425       find first buf_fbr-doc exclusive-lock
      426            where recid( buf_fbr-doc ) = p-fbr-doc-recid
      427       .
      428       find first buf_fbr-recipe no-lock
      429            where buf_fbr-recipe.doc-code    = buf_fbr-doc.doc-code
      430              and buf_fbr-recipe.recipe-code = p-recipe-code
      431       .
      432       run writelog in this-procedure (
      433             input log-file-name
      434           , input 0
      435           , input substitute( "Документ &1. Рецепт &2"
      436                               , buf_fbr-doc.doc-code
      437                               , p-recipe-code )
      438       ).
      439   if session :set-wait-state( "compiler" ) then.
      440       run calc-prices in this-procedure (
      441             input buf_fbr-doc.doc-code
      442           , input p-recipe-code
      443           , input v-rb-is-base
      444           , output v-unit-type
      445           , output v-sum-alternative-qnty
      446           , output v-sum-write-off-qnty
      447           , output v-sum-income-qnty
      448           , output v-sum-write-off-price-r-b
      449           , output v-sum-write-off-price-not-r-b
      450           , output v-sum-vat-write-off-price-r-b
      451           , output v-sum-vat-write-off-price-notrb
      452           , output v-count-rsrv-qnty
      453           , output v-sum-fix-cost-price-r-b
      454           , output v-sum-vat-fix-cost-price-r-b
      455           , output v-sum-input-price-sale
      456           , output v-count-input-fact-qnty
      457       ) no-error.
      458       if error-status :error
      459       then do:
      460           undo, return error return-value.
      461       end.
      462       run writelog in this-procedure (
      463             input log-file-name
      464           , input 3
      465           , input substitute( "Расчитаны суммы учетных цен:"
      466                   + chr(10) + "                           v-unit-type                      &1"
      467                   + chr(10) + "                           v-sum-alternative-qnty           &2"
      468                   + chr(10) + "                           v-sum-write-off-qnty             &3"
      469                   + chr(10) + "                           v-sum-income-qnty                &4"
      470                   + chr(10) + "                           v-sum-write-off-price-r-b        &5"
      471                   + chr(10) + "                           v-sum-write-off-price-not-r-b    &6"
      472                   + chr(10) + "                           v-sum-vat-write-off-price-r-b    &7"
      473                   + chr(10) + "                           v-sum-vat-write-off-price-notrb  &8"
      474                   + chr(10) + "                           v-count-rsrv-qnty                &9"
      475                   , string( v-unit-type                      )
      476                   , string( v-sum-alternative-qnty           )
      477                   , string( v-sum-write-off-qnty             )
      478                   , string( v-sum-income-qnty                )
      479                   , string( v-sum-write-off-price-r-b        )
      480                   , string( v-sum-write-off-price-not-r-b    )
      481                   , string( v-sum-vat-write-off-price-r-b    )
      482                   , string( v-sum-vat-write-off-price-notrb  )
      483                   , string( v-count-rsrv-qnty                ) )
      484                   + substitute(
      485                     chr(10) + "                           v-sum-fix-cost-price-r-b         &1"
      486                   + chr(10) + "                           v-sum-vat-fix-cost-price-r-b     &2"
      487                   + chr(10) + "                           v-sum-input-price-sale           &3"
      488                   + chr(10) + "                           v-count-input-fact-qnty          &4"
      489                   , string( v-sum-fix-cost-price-r-b         )
      490                   , string( v-sum-vat-fix-cost-price-r-b     )
      491                   , string( v-sum-input-price-sale           )
      492                   , string( v-count-input-fact-qnty          ) )
      493       ).
      494       if v-sum-fix-cost-price-r-b     > v-sum-write-off-price-r-b
      495       or v-sum-vat-fix-cost-price-r-b > v-sum-vat-write-off-price-r-b
      496       then do:
      497           message "Сумма в учетных ценах по фиксированным строкам больше, чем вся сумма списания."
      498                   skip(1) "Сумма приходных строк с фиксированной учетной ценой:"
      499                               v-sum-fix-cost-price-r-b
      500                   skip    "Cумма списанных товаров в учетных ценах:            "
      501                               v-sum-write-off-price-r-b
      502                   skip(1) "Сумма НДС приходных строк с фиксированной учетной ценой:"
      503                               v-sum-vat-fix-cost-price-r-b
      504                   skip    "Cумма НДС списанных товаров в учетных ценах:            "
      505                               v-sum-vat-write-off-price-r-b
      506                   skip(1) "Рецепт:" p-recipe-code
      507           view-as alert-box error.
      508   if session :set-wait-state( "" ) then.
      509           undo, return error.
      510       end.
      511       if v-count-input-fact-qnty = 0
      512       and ( v-sum-fix-cost-price-r-b     <> v-sum-write-off-price-r-b
      513          or v-sum-vat-fix-cost-price-r-b <> v-sum-vat-write-off-price-r-b )
      514       then do:
      515           message     "При всех фиксированных приходных ценах "
      516               skip    "сумма в учетных ценах по строкам прихода не равна сумме списания."
      517               skip(2) "Сумма приходных строк в учетных ценах:"
      518                       v-sum-fix-cost-price-r-b
      519               skip    "Сумма строк списания в учетных ценах: "
      520                       v-sum-write-off-price-r-b
      521               skip(2) "Сумма НДС приходных строк в учетных ценах:"
      522                       v-sum-vat-fix-cost-price-r-b
      523               skip    "Сумма НДС строк списания в учетных ценах: "
      524                       v-sum-vat-write-off-price-r-b
      525               skip    "Эти суммы должны быть равны, поскольку ВСЕ приходные цены фиксированы!"
      526               skip(1) "Рецепт:" p-recipe-code
      527           view-as alert-box error.
      528   if session :set-wait-state( "" ) then.
      529           undo, return error.
      530       end.
      531       if available buf_fbr-recipe
      532       and buf_fbr-recipe.recipe-type = 'альтернатива':U
      533       then do:
      534           run check-alternative in this-procedure (
      535                 input buf_fbr-doc.doc-code
      536               , input buf_fbr-recipe.recipe-code
      537               , input buf_fbr-recipe.artic
      538               , input buf_fbr-recipe.prod-type
      539               , input buf_fbr-recipe.prod-code
      540               , input v-alt-in-qnty
      541               , input v-sum-alternative-qnty
      542           ) no-error.
      543         if error-status:error then do:
      544           undo, return error substitute("Ошибка при проверке товаров для рецепта типа АЛЬТЕРНАТИВА:&1&2&1&3"
      545                                         , chr(10)
      546                                         , error-status:get-message(1)
      547                                         , return-value
      548           ).
      549         end.
      550       end.
      551       if  v-unit-type <> ""
      552       and v-unit-type <> "units-differ"
      553       and v-unit-type <> "not-weight"
      554       and buf_fbr-recipe.recipe-type = 'разделка':U
      555       then do:
      556           if abs( v-sum-income-qnty + v-sum-write-off-qnty )  > 0.01
      557           and ( not available buf_fbr-recipe or buf_fbr-recipe.recipe-type <> 'производство':U )
      558           then do:
      559               message     "Для весовых товаров не совпадают количества списанного и оприходованного товара."
      560                   skip(2) "Количество списанного товара:     " ( -1 * v-sum-write-off-qnty )
      561                   skip    "Количество оприходованного товара:" v-sum-income-qnty
      562                   skip(1) "Рецепт: " p-recipe-code
      563               view-as alert-box error.
      564   if session :set-wait-state( "" ) then.
      565               undo, return error.
      566           end.
      567       end.
      568       if v-count-rsrv-qnty = 0
      569       or v-count-input-fact-qnty = 0
      570       then do:
      571           message     "Среди израсходованных или произведенных товаров"
      572               skip    "нет ничего кроме отходов,"
      573               skip    "либо не заданы ингредиенты в альтернативе."
      574               skip(1) "Рецепт: " p-recipe-code
      575                   view-as alert-box error.
      576   if session :set-wait-state( "" ) then.
      577           undo, return error.
      578       end.
      579       assign
      580           v-sum-input-price-r-b       = 0
      581           v-sum-vat-input-price-r-b   = 0
      582       .
      583       run writelog in this-procedure (
      584             input log-file-name
      585           , input 1
      586           , input "Расчет сумм для строки. "
      587       ).
      588       calc-cost-for-fbr-line:
      589       for each buf_in_fbr-line exclusive-lock
      590          where buf_in_fbr-line.doc-code       = buf_fbr-doc.doc-code
      591            and buf_in_fbr-line.trn-type       = 'при':U
      592            and buf_in_fbr-line.recipe-code    = p-recipe-code
      593       on error undo, return error
      594       :
      595           run writelog in this-procedure (
      596                 input log-file-name
      597               , input 2
      598               , input "Строка товара с артикулом " + buf_in_fbr-line.artic
      599           ).
      600           if buf_in_fbr-line.rsrv-qnty = ?
      601           then do:
      602               assign
      603                   buf_in_fbr-line.price-rubl            = 0
      604                   buf_in_fbr-line.price-base            = 0
      605                   buf_in_fbr-line.price-sum-rubl        = 0
      606                   buf_in_fbr-line.price-sum-base        = 0
      607                   buf_in_fbr-line.price-sum-vat-rubl    = 0
      608                   buf_in_fbr-line.price-sum-vat-base    = 0
      609               .
      610               run writelog in this-procedure (
      611                   input log-file-name
      612                   , input 3
      613                   , input "Отходы. Учетная цена 0. "
      614               ).
      615           end.
      616           else do:
      617               if not buf_in_fbr-line.fix-cost
      618               then do:
      619                   if v-rb-is-base = yes
      620                   then do:
      621                   assign
      622                           buf_in_fbr-line.price-base            = if buf_in_fbr-line.price-sale > 0 then ( v-sum-write-off-price-r-b - v-sum-fix-cost-price-r-b )
      623                                                                       * buf_in_fbr-line.price-sale
      624                                                                       / v-sum-input-price-sale           else   ( v-sum-write-off-price-r-b - v-sum-fix-cost-price-r-b )
      625                           buf_in_fbr-line.price-sum-base        = buf_in_fbr-line.price-base * buf_in_fbr-line.fact-qnty
      626                           buf_in_fbr-line.price-sum-vat-base    = if buf_in_fbr-line.price-sale > 0 then  ( v-sum-vat-write-off-price-r-b - v-sum-vat-fix-cost-price-r-b )
      627                                                                       * buf_in_fbr-line.price-sale
      628                                                                       / v-sum-input-price-sale
      629                                                                       * buf_in_fbr-line.fact-qnty      else  ( v-sum-vat-write-off-price-r-b - v-sum-vat-fix-cost-price-r-b ) *  buf_in_fbr-line.fact-qnty
      630                       .
      631                       run writelog in this-procedure (
      632                             input log-file-name
      633                           , input 3
      634                           , input substitute( "Цены не фиксированы. В строку записаны суммы в учетных ценах: "
      635                                   + chr(10) + "                           price-sum-base       : &1"
      636                                   + chr(10) + "                           price-sum-vat-base   : &2"
      637                                   , buf_in_fbr-line.price-sum-base
      638                                   , buf_in_fbr-line.price-sum-vat-base  )
      639                       ).
      640                   end.
      641                   else do:
      642    assign
      643                           buf_in_fbr-line.price-rubl            = if buf_in_fbr-line.price-sale > 0 then ( v-sum-write-off-price-r-b - v-sum-fix-cost-price-r-b )
      644                                                                       * buf_in_fbr-line.price-sale
      645                                                                       / v-sum-input-price-sale           else  ( v-sum-write-off-price-r-b - v-sum-fix-cost-price-r-b )
      646                           buf_in_fbr-line.price-sum-rubl        = buf_in_fbr-line.price-rubl * buf_in_fbr-line.fact-qnty
      647                           buf_in_fbr-line.price-sum-vat-rubl    = if buf_in_fbr-line.price-sale > 0 then ( v-sum-vat-write-off-price-r-b - v-sum-vat-fix-cost-price-r-b )
      648                                                                       * buf_in_fbr-line.price-sale
      649                                                                       / v-sum-input-price-sale
      650                                                                       * buf_in_fbr-line.fact-qnty     else ( v-sum-vat-write-off-price-r-b - v-sum-vat-fix-cost-price-r-b )  * buf_in_fbr-line.fact-qnty
      651                                        .
      652                       run writelog in this-procedure (
      653                           input log-file-name
      654                           , input 3
      655                           , input substitute( "Цены не фиксированы. В строку записаны суммы в учетных ценах: "
      656                                   + chr(10) + "                           price-sum-rubl       : &1"
      657                                   + chr(10) + "                           price-sum-vat-rubl   : &2"
      658                                   , buf_in_fbr-line.price-sum-rubl
      659                                   , buf_in_fbr-line.price-sum-vat-rubl  )
      660                       ).
      661                   end.
      662               end.
      663               assign
      664                   buf_in_fbr-line.rsrv-qnty = buf_in_fbr-line.fact-qnty.
      665               .
      666               run writelog in this-procedure (
      667                   input log-file-name
      668                   , input 2
      669                   , input substitute( "Записано зарезервированное количество: &1"
      670                                       , string( buf_in_fbr-line.rsrv-qnty ) )
      671               ).
      672           end.
      673           assign
      674               v-sum-input-price-r-b       = v-sum-input-price-r-b
      675                                               + ( buf_in_fbr-line.fact-qnty
      676                                                   * ( if v-rb-is-base = yes then buf_in_fbr-line.price-base else buf_in_fbr-line.price-rubl ) )
      677               v-sum-vat-input-price-r-b   = v-sum-vat-input-price-r-b
      678                                               + ( if v-rb-is-base = yes then buf_in_fbr-line.price-sum-vat-base else buf_in_fbr-line.price-sum-vat-rubl )
      679           .
      680           run writelog in this-procedure (
      681               input log-file-name
      682               , input 1
      683               , input substitute( "Вычислены суммы по приходу: "
      684                       + chr(10) + "                           v-sum-input-price-r-b     :  &1"
      685                       + chr(10) + "                           v-sum-vat-input-price-r-b :  &2"
      686                       , string( v-sum-input-price-r-b )
      687                       , string( v-sum-vat-input-price-r-b  )  )
      688           ).
      689           if v-min-mrgn = 0
      690           and v-max-mrgn = 0
      691           or buf_in_fbr-line.rsrv-qnty = ?
      692           then do:
      693               next calc-cost-for-fbr-line.
      694           end.
      695           find first buf_goods no-lock
      696                where buf_goods.artic     = buf_in_fbr-line.artic
      697                  and buf_goods.prod-type = buf_in_fbr-line.prod-type
      698                  and buf_goods.prod-code = buf_in_fbr-line.prod-code
      699           no-error.
      700           if error-status :error
      701           then do:
      702               message
      703               vss-workfile vss-revision vss-description
      704               skip "Не найден товар для строки рецепта " p-recipe-code
      705               skip return-value
      706               skip trim(error-status :get-message(1))
      707                   trim(error-status :get-message(2))
      708                   trim(error-status :get-message(3))
      709               view-as alert-box error.
      710               undo, return error .
      711           end.
      712           assign
      713               v-margin = ( buf_in_fbr-line.price-sale * buf_in_fbr-line.fact-qnty
      714                           - ( if v-rb-is-base = yes then buf_in_fbr-line.price-sum-base     else buf_in_fbr-line.price-sum-rubl     )
      715                           - ( if v-rb-is-base = yes then buf_in_fbr-line.price-sum-vat-base else buf_in_fbr-line.price-sum-vat-rubl )
      716                          ) / ( ( if v-rb-is-base = yes then buf_in_fbr-line.price-sum-base     else buf_in_fbr-line.price-sum-rubl     )
      717                               + ( if v-rb-is-base = yes then buf_in_fbr-line.price-sum-vat-base else buf_in_fbr-line.price-sum-vat-rubl )
      718                              ) * 100
      719           .
      720           if v-margin < v-min-mrgn
      721           or v-margin > v-max-mrgn
      722           then do:
      723               message  "Наценка выходит за значения, определенные параметрами"
      724                   skip "минимальной и максимальной наценок для производства."
      725                   skip(1) "Товар:  " buf_goods.artic buf_goods.gds-name
      726                   skip    "Рецепт: " buf_fbr-recipe.recipe-code
      727                   skip    "Наценка:" v-margin "%"
      728                   skip(1) "В соответствии с настройкой fbr-mrgn "
      729                   skip    "минимальная наценка:  " v-min-mrgn "%"
      730                   skip    "максимальная наценка: " v-max-mrgn "%."
      731               view-as alert-box warning .
      732           end.
      733       end.
      734       calc-cost-for-fbr-line-not-r-b:
      735       for each buf_in_fbr-line exclusive-lock
      736       where buf_in_fbr-line.doc-code       = buf_fbr-doc.doc-code
      737           and buf_in_fbr-line.trn-type       = 'при':U
      738           and buf_in_fbr-line.recipe-code    = p-recipe-code
      739       on error undo, return error
      740       :
      741           if buf_in_fbr-line.rsrv-qnty = ?
      742           then do:
      743               next calc-cost-for-fbr-line-not-r-b.
      744           end.
      745           if v-rb-is-base = yes
      746           then do:
      747               assign
      748                   buf_in_fbr-line.price-rubl            = ( if v-sum-input-price-r-b = 0
      749                                                                   then 0
      750                                                                   else v-sum-write-off-price-not-r-b
      751                                                                           * buf_in_fbr-line.price-base
      752                                                                           / v-sum-input-price-r-b
      753                                                               )
      754                   buf_in_fbr-line.price-sum-rubl        = buf_in_fbr-line.price-rubl
      755                                                                   * buf_in_fbr-line.fact-qnty
      756                   buf_in_fbr-line.price-sum-vat-rubl    = ( if v-sum-vat-input-price-r-b = 0
      757                                                                   then 0
      758                                                                   else v-sum-vat-write-off-price-notrb
      759                                                                           * buf_in_fbr-line.price-sum-vat-base
      760                                                                           / v-sum-vat-input-price-r-b
      761                                                               )
      762               .
      763           end.
      764           else do:
      765               assign
      766                   buf_in_fbr-line.price-base            = ( if v-sum-input-price-r-b = 0
      767                                                                   then 0
      768                                                                   else v-sum-write-off-price-not-r-b
      769                                                                           * buf_in_fbr-line.price-rubl
      770                                                                           / v-sum-input-price-r-b
      771                                                               )
      772                   buf_in_fbr-line.price-sum-base        = buf_in_fbr-line.price-base
      773                                                                   * buf_in_fbr-line.fact-qnty
      774                   buf_in_fbr-line.price-sum-vat-base    = ( if v-sum-vat-input-price-r-b = 0
      775                                                                   then 0
      776                                                                   else v-sum-vat-write-off-price-notrb
      777                                                                           * buf_in_fbr-line.price-sum-vat-rubl
      778                                                                           / v-sum-vat-input-price-r-b
      779                                                               )
      780               .
      781           end.
      782       end.
      783       assign
      784           buf_fbr-doc.status_ = 'разрешен':U
      785       .
      786   if session :set-wait-state( "" ) then.
      787   end.
      788   procedure calc-prices :
      789   do
      790   on error undo, return error
      791   :
      792   define input parameter p-fbr-doc-doc-code                as character    no-undo.
      793   define input parameter p-recipe-code                     as character    no-undo.
      794   define input parameter p-rb-is-base                      as logical      no-undo.
      795   define output parameter p-unit-type                      as character    no-undo.
      796   define output parameter p-sum-alternative-qnty           as decimal      no-undo.
      797   define output parameter p-sum-write-off-qnty             as decimal      no-undo.
      798   define output parameter p-sum-income-qnty                as decimal      no-undo.
      799   define output parameter p-sum-write-off-price-r-b        as decimal      no-undo.
      800   define output parameter p-sum-write-off-price-not-r-b    as decimal      no-undo.
      801   define output parameter p-sum-vat-write-off-price-r-b    as decimal      no-undo.
      802   define output parameter p-sum-vat-write-off-price-notrb  as decimal      no-undo.
      803   define output parameter p-count-rsrv-qnty                as decimal      no-undo.
      804   define output parameter p-sum-fix-cost-price-r-b         as decimal      no-undo.
      805   define output parameter p-sum-vat-fix-cost-price-r-b     as decimal      no-undo.
      806   define output parameter p-sum-input-price-sale           as decimal      no-undo.
      807   define output parameter p-count-input-fact-qnty          as decimal      no-undo.
      808       define variable v-count-fix-cost    as integer      no-undo.
      809       run writelog in this-procedure (
      810             input log-file-name
      811           , input 1
      812           , input "calc-prices: Вычисление сумм по строкам списания. "
      813       ).
      814       define buffer buf_fbr-recipe        for ub.fbr-recipe.
      815       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
      816       define buffer buf_fbr-line      for ub.fbr-line.
      817       define buffer buf_comp_fbr-line for ub.fbr-line.
      818       define buffer buf_goods         for ub.goods.
      819       define buffer buf_units         for ub.units.
      820       find first buf_fbr-recipe no-lock
      821            where buf_fbr-recipe.doc-code    = p-fbr-doc-doc-code
      822              and buf_fbr-recipe.recipe-code = p-recipe-code
      823       .
      824       assign
      825           p-unit-type                         = ""
      826           p-sum-alternative-qnty              = 0
      827           p-sum-write-off-qnty                = 0
      828           p-sum-income-qnty                   = 0
      829           p-sum-write-off-price-r-b           = 0
      830           p-sum-write-off-price-not-r-b       = 0
      831           p-sum-vat-write-off-price-r-b       = 0
      832           p-sum-vat-write-off-price-notrb     = 0
      833           p-count-rsrv-qnty                   = 0
      834           v-count-fix-cost                    = 0
      835           p-sum-fix-cost-price-r-b            = 0
      836           p-sum-vat-fix-cost-price-r-b        = 0
      837           p-sum-input-price-sale              = 0
      838           p-count-input-fact-qnty             = 0
      839       .
      840       calc-prices-for-each-fbr-line:
      841       for each buf_fbr-line no-lock
      842          where buf_fbr-line.doc-code      = p-fbr-doc-doc-code
      843            and buf_fbr-line.recipe-code   = p-recipe-code
      844       on error undo, return error
      845       :
      846           run writelog in this-procedure (
      847                 input log-file-name
      848               , input 2
      849               , input substitute( "Товар с артикулом &1"
      850                                   , buf_fbr-line.artic )
      851           ).
      852           find first buf_goods no-lock
      853                where buf_goods.artic     = buf_fbr-line.artic
      854                  and buf_goods.prod-type = buf_fbr-line.prod-type
      855                  and buf_goods.prod-code = buf_fbr-line.prod-code
      856           .
      857           find first buf_units no-lock
      858                where buf_units.unit-name = buf_goods.unit-base
      859           .
      860           if buf_fbr-line.fact-qnty = ?
      861           then do:
      862   if session :set-wait-state( "" ) then.
      863             undo, return error substitute("Не указано количество товара в документе пр-ва &5.&1Рецепт:  &2&1Товар:   &3 &4"
      864                                           , chr(10)
      865                                           , buf_fbr-line.recipe-code
      866                                           , buf_fbr-line.artic
      867                                           , buf_goods.gds-name
      868                                           ,p-fbr-doc-doc-code
      869                                           ).
      870           end.
      871           if buf_fbr-recipe.recipe-type <> 'разделка':U
      872           and ( buf_fbr-recipe.artic <> buf_fbr-line.artic
      873               or buf_fbr-recipe.prod-type <> buf_fbr-line.prod-type
      874               or buf_fbr-recipe.prod-code <> buf_fbr-line.prod-code )
      875           then do:
      876               find first buf_fbr-recipe-gds no-lock
      877                    where buf_fbr-recipe-gds.doc-code      = buf_fbr-line.doc-code
      878                      and buf_fbr-recipe-gds.recipe-code   = buf_fbr-line.recipe-code
      879                      and buf_fbr-recipe-gds.prod-type     = buf_fbr-line.prod-type
      880                      and buf_fbr-recipe-gds.prod-code     = buf_fbr-line.prod-code
      881                      and buf_fbr-recipe-gds.artic         = buf_fbr-line.artic
      882               no-error.
      883               if not available buf_fbr-recipe-gds
      884               then do:
      885   if session :set-wait-state( "" ) then.
      886                   undo, return error substitute("Отсутствует строка рецепта. Расчет невозможен. Измените документ &1.&2" +
      887                                                 "Артикул: &3 &4&2Рецепт: &4"
      888                                           ,p-fbr-doc-doc-code
      889                                           , chr(10)
      890                                           , buf_goods.artic
      891                                           , buf_goods.gds-name
      892                                           , buf_fbr-line.recipe-code
      893                                           ).
      894               end.
      895               find first buf_comp_fbr-line
      896                    where buf_comp_fbr-line.doc-code     = p-fbr-doc-doc-code
      897                      and buf_comp_fbr-line.recipe-code  = p-recipe-code
      898                      and buf_comp_fbr-line.is-comp      = yes
      899               no-error.
      900               if not available buf_comp_fbr-line
      901               then do:
      902                   undo, return error substitute("&1 &2 &3&4Не найдена строка составного товара в документе пр-ва &7.&4&5&4&6"
      903                                                 ,vss-workfile
      904                                                 ,vss-revision
      905                                                 ,vss-description
      906                                                 ,chr(10)
      907                                                 , error-status:get-message(1)
      908                                                 , return-value
      909                                                 ,p-fbr-doc-doc-code
      910                                                 ).
      911               end.
      912               if buf_fbr-recipe.recipe-type = 'альтернатива':U
      913               then do:
      914                   assign
      915                       p-sum-alternative-qnty = p-sum-alternative-qnty + ( buf_fbr-line.fact-qnty * buf_fbr-recipe-gds.brutto-qnty )
      916                   .
      917               end.
      918               else do:
      919                   if round( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty * buf_fbr-recipe.qnty, 3 ) <> round( buf_comp_fbr-line.fact-qnty, 3 )
      920                   then do:
      921   if session :set-wait-state( "" ) then.
      922                     undo, return error
      923                     substitute("Не соответствуют рецепту количество ингридиента и количество составного товара&1в док-те пр-ва &7&1" +
      924                                 "Рецепт: &2&1Товар: &3 &4&1Количество ингридиента:       &5&1"  +
      925                                 "Количество составного товара: &6"
      926                                 , chr(10)
      927                                 , buf_fbr-line.recipe-code
      928                                 , buf_goods.artic
      929                                 , buf_goods.gds-name
      930                                 , buf_fbr-line.fact-qnty
      931                                 , buf_comp_fbr-line.fact-qnty
      932                                 , buf_fbr-line.doc-code
      933                                 )
      934                     .
      935                   end.
      936               end.
      937           end.
      938           if buf_goods.gds-type <> 'у':U
      939           then do:
      940               if lookup ( 'вес':U, buf_units.type ) > 0
      941               then do:
      942                   if p-unit-type = buf_units.unit-name
      943                   or p-unit-type = ""
      944                   then do:
      945                       assign
      946                           p-unit-type = buf_units.unit-name
      947                       .
      948                       if buf_fbr-line.trn-type = 'спи':U
      949                       then do:
      950                           assign
      951                               p-sum-write-off-qnty = p-sum-write-off-qnty - buf_fbr-line.fact-qnty
      952                           .
      953                       end.
      954                       else do:
      955                           assign
      956                               p-sum-income-qnty = p-sum-income-qnty + buf_fbr-line.fact-qnty
      957                           .
      958                       end.
      959                   end.
      960                   else do:
      961                       assign
      962                           p-unit-type = "units-differ"
      963                       .
      964                   end.
      965               end.
      966               else do:
      967                   assign
      968                       p-unit-type = "not-weight"
      969                   .
      970               end.
      971           end.
      972           if buf_fbr-line.rsrv-qnty = ?
      973           then do:
      974               run writelog in this-procedure (
      975                     input log-file-name
      976                   , input 3
      977                   , input "calc-prices: Строка отходов. В сумме не учитывается."
      978               ).
      979               next calc-prices-for-each-fbr-line.
      980           end.
      981           if buf_fbr-line.trn-type = 'спи':U
      982           then do:
      983               run str/fbr-gds.p (
      984                     INPUT parparentproc
      985                   , input p-fbrhist-handle
      986                   , input p-fbr-doc-recid
      987                   , input yes
      988                   , input recid( buf_goods )
      989                   , input p-autofbr
      990                   , input p-have-store
      991               ) no-error.
      992               if error-status :error
      993               then do:
      994                   if return-value = 'not-reserved' then do:
      995                     run writelog in this-procedure (
      996                       input 'fbr-rsrv-errors.txt'
      997                     , input 0
      998                     , input substitute("Не зарезервирован товар &1 &2 &3 кол-во &4 рецепт &5",
      999                         buf_fbr-line.artic,
     1000                         buf_fbr-line.prod-type,
     1001                         buf_fbr-line.prod-code,
     1002                         buf_fbr-line.fact-qnty,
     1003                         buf_fbr-line.recipe-code)
     1004                     ).
     1005                     v-not-reserved = true.
     1006                     next calc-prices-for-each-fbr-line.
     1007                   end.
     1008                   if error-status :get-message(1) <> ""
     1009                   or return-value <> "user-interrupt":U
     1010                   then do:
     1011                     if true  then do:
     1012                        run writelog in this-procedure (
     1013                                           input 'fbr-rsrv-errors.txt'
     1014                                         , input 0
     1015                                         , input substitute("&1 &2 &3&4Ошибка при резервировании товара.&4Товар:     &5 &6&4В рецепте: &7&8&9"
     1016                                                       ,vss-workfile
     1017                                                       ,vss-revision
     1018                                                       ,vss-description
     1019                                                       ,chr(10)
     1020                                                       ,buf_goods.artic
     1021                                                       ,buf_goods.gds-name
     1022                                                       ,p-recipe-code
     1023                                                       ,chr(10)
     1024                                                       ,return-value)
     1025                                                       ).
     1026                        v-not-reserved = true.
     1027                        next calc-prices-for-each-fbr-line.
     1028                     end.
     1029                     else do:
     1030                       message
     1031                       vss-workfile vss-revision vss-description
     1032                       skip "Ошибка при резервировании товара."
     1033                       skip "Товар:     " buf_goods.artic "  " buf_goods.gds-name
     1034                       skip "В рецепте: " p-recipe-code
     1035                       skip return-value
     1036                       skip trim(error-status :get-message(1))
     1037                           trim(error-status :get-message(2))
     1038                           trim(error-status :get-message(3))
     1039                       view-as alert-box error.
     1040                   end.
     1041                   end.
     1042                   undo, return error return-value.
     1043               end.
     1044               run writelog in this-procedure (
     1045                     input log-file-name
     1046                   , input 0
     1047                   , input "calc-prices: =====*** fbr-rcp.p ***=== Возврат после fbr-gds ========"
     1048               ).
     1049               if buf_fbr-line.rsrv-qnty <> buf_fbr-line.fact-qnty
     1050               then do:
     1051   if session :set-wait-state( "" ) then.
     1052                 undo, return error substitute("Не удалось зарезервировать товар. Рецепт не может быть рассчитан.&1" +
     1053                                               "Товар:     &2 &3&1В рецепте: &4"
     1054                                               , chr(10)
     1055                                               , buf_goods.artic
     1056                                               ,buf_goods.gds-name
     1057                                               ,p-recipe-code).
     1058               end.
     1059               if p-rb-is-base = yes
     1060               then do:
     1061                   run writelog in this-procedure (
     1062                         input log-file-name
     1063                       , input 3
     1064                       , input substitute( "calc-prices: Резервирование товара прошло успешно. Количество, цена и сумма НДС в строке товара: "
     1065                                   + chr(10) + "                           buf_fbr-line.rsrv-qnty            &1"
     1066                                   + chr(10) + "                           buf_fbr-line.price-base           &2"
     1067                                   + chr(10) + "                           buf_fbr-line.price-sum-vat-base   &3"
     1068                                   , string( buf_fbr-line.rsrv-qnty )
     1069                                   , string( buf_fbr-line.price-base   )
     1070                                   , string( buf_fbr-line.price-sum-vat-base   ) )
     1071                   ).
     1072               end.
     1073               else do:
     1074                   run writelog in this-procedure (
     1075                         input log-file-name
     1076                       , input 3
     1077                       , input substitute( "calc-prices: Резервирование товара прошло успешно. Количество, цена и сумма НДС в строке товара: "
     1078                                   + chr(10) + "                           buf_fbr-line.rsrv-qnty            &1"
     1079                                   + chr(10) + "                           buf_fbr-line.price-rubl           &2"
     1080                                   + chr(10) + "                           buf_fbr-line.price-sum-vat-rubl   &3"
     1081                                   , string( buf_fbr-line.rsrv-qnty )
     1082                                   , string( buf_fbr-line.price-rubl   )
     1083                                   , string( buf_fbr-line.price-sum-vat-rubl   ) )
     1084                   ).
     1085               end.
     1086               if buf_fbr-line.fact-qnty <> 0
     1087               then do:
     1088                   assign
     1089                       p-sum-write-off-price-r-b       = p-sum-write-off-price-r-b
     1090                                                       + ( buf_fbr-line.rsrv-qnty * ( if p-rb-is-base = yes then buf_fbr-line.price-base else buf_fbr-line.price-rubl ) )
     1091                       p-sum-write-off-price-not-r-b   = p-sum-write-off-price-not-r-b
     1092                                                       + ( buf_fbr-line.rsrv-qnty * ( if p-rb-is-base = yes then buf_fbr-line.price-rubl else buf_fbr-line.price-base ) )
     1093                       p-sum-vat-write-off-price-r-b   = p-sum-vat-write-off-price-r-b
     1094                                                       + ( if p-rb-is-base = yes then buf_fbr-line.price-sum-vat-base else buf_fbr-line.price-sum-vat-rubl )
     1095                       p-sum-vat-write-off-price-notrb = p-sum-vat-write-off-price-notrb
     1096                                                       + ( if p-rb-is-base = yes then buf_fbr-line.price-sum-vat-rubl else buf_fbr-line.price-sum-vat-base )
     1097                       p-count-rsrv-qnty = p-count-rsrv-qnty + 1
     1098                   .
     1099                   run writelog in this-procedure (
     1100                       input log-file-name
     1101                       , input 3
     1102                       , input substitute( "calc-prices: Вычислены суммы списания: "
     1103                               + chr(10) + "                           p-sum-write-off-price-r-b     &1"
     1104                               + chr(10) + "                           p-sum-vat-write-off-price-r-b &2"
     1105                               , string( p-sum-write-off-price-r-b )
     1106                               , string( p-sum-vat-write-off-price-r-b  ) )
     1107                   ).
     1108               end.
     1109           end.
     1110           else do:
     1111               if buf_fbr-line.fix-cost
     1112               then do:
     1113                   assign
     1114                       p-sum-fix-cost-price-r-b        = p-sum-fix-cost-price-r-b
     1115                               + ( buf_fbr-line.fact-qnty * ( if p-rb-is-base = yes then buf_fbr-line.price-base else buf_fbr-line.price-rubl ) )
     1116                       p-sum-vat-fix-cost-price-r-b    = p-sum-vat-fix-cost-price-r-b
     1117                               + ( if p-rb-is-base = yes then buf_fbr-line.price-sum-vat-base else buf_fbr-line.price-sum-vat-rubl )
     1118                       v-count-fix-cost                = v-count-fix-cost + 1
     1119                   .
     1120               end.
     1121               else do:
     1122                   assign
     1123                       p-sum-input-price-sale  = p-sum-input-price-sale
     1124                               + ( buf_fbr-line.fact-qnty * buf_fbr-line.price-sale )
     1125                       p-count-input-fact-qnty = p-count-input-fact-qnty + 1
     1126                   .
     1127               end.
     1128               assign
     1129                   v-alt-in-qnty = buf_fbr-line.fact-qnty
     1130               .
     1131               run writelog in this-procedure (
     1132                   input log-file-name
     1133                   , input 3
     1134                   , input substitute( "calc-prices: Вычислена сумма прихода в продажных ценах: "
     1135                           + chr(10) + "                           p-sum-input-price-sale     &1"
     1136                           ,  string( p-sum-input-price-sale ) )
     1137               ).
     1138           end.
     1139       end.
     1140       if v-not-reserved then
     1141         return error 'not-reserved'.
     1142   end.
     1143   end procedure.
     1144   procedure check-alternative :
     1145   do
     1146   on error undo, return error
     1147   :
     1148       define input parameter p-doc-code       as character    no-undo.
     1149       define input parameter p-recipe-code    as character    no-undo.
     1150       define input parameter p-artic          as character    no-undo.
     1151       define input parameter p-prod-type      as character    no-undo.
     1152       define input parameter p-prod-code      as integer      no-undo.
     1153       define input parameter p-income-qnty    as decimal      no-undo.
     1154       define input parameter p-write-off-qnty as decimal      no-undo.
     1155       define variable v-del-zero             as logical        no-undo.
     1156       define buffer buf_goods         for ub.goods.
     1157       define buffer buf_zero_fbr-line for ub.fbr-line.
     1158       define buffer buf_fbr-line      for ub.fbr-line.
     1159           find first buf_goods no-lock
     1160                where buf_goods.artic     = p-artic
     1161                  and buf_goods.prod-type = p-prod-type
     1162                  and buf_goods.prod-code = p-prod-code
     1163           .
     1164           if round ( p-income-qnty, 3 ) <> round ( p-write-off-qnty, 3 )
     1165           then do:
     1166   if session :set-wait-state( "" ) then.
     1167               undo, return error substitute("Док-нт пр-ва &7&1Количество оприходованного товара не равно количеству списанного.&1" +
     1168                                             "Количество оприходованного товара: &2&1"  +
     1169                                             "Количество списанного товара:     &3&1Товар: &4 &5&1Рецепт: &6"
     1170                                             , chr(10)
     1171                                             , p-income-qnty
     1172                                             ,p-write-off-qnty
     1173                                             ,buf_goods.artic
     1174                                             ,buf_goods.gds-name
     1175                                             ,buf_fbr-recipe.recipe-code
     1176                                             ,p-doc-code
     1177                                             ).
     1178           end.
     1179           for each buf_fbr-line no-lock
     1180              where buf_fbr-line.doc-code     = p-doc-code
     1181                and buf_fbr-line.is-comp      = no
     1182                and buf_fbr-line.recipe-code  = p-recipe-code
     1183                and buf_fbr-line.fact-qnty    = 0
     1184           on error undo, return error
     1185           :
     1186               find first buf_goods no-lock
     1187                    where buf_goods.artic     = buf_fbr-line.artic
     1188                      and buf_goods.prod-type = buf_fbr-line.prod-type
     1189                      and buf_goods.prod-code = buf_fbr-line.prod-code
     1190               .
     1191               if p-autofbr    = yes
     1192               then do:
     1193                   assign
     1194                       v-del-zero = yes
     1195                   .
     1196               end.
     1197               else do:
     1198                   if v-del-zero = no
     1199                   then do:
     1200                      if p-silent then do:
     1201                         v-del-zero = yes.
     1202                      end.
     1203                      else do:
     1204                       message
     1205                               "В сбалансированном рецепте альтернативы"
     1206                           skip "есть строки с количеством 0."
     1207                           skip "Необходимо либо удалить эти строки,"
     1208                           skip "либо продолжить редактирование документа."
     1209                           skip(1) "Рецепт: " p-recipe-code
     1210                           skip(1) "Удалить строки с количеством 0?"
     1211                       view-as alert-box information
     1212                       buttons yes-no
     1213                       title "Нулевые строки в рецепте альтернативы"
     1214                       update v-del-zero .
     1215                       if v-del-zero = no
     1216                       then do:
     1217                           undo, return error.
     1218                       end.
     1219                   end.
     1220               end.
     1221               end.
     1222               if v-del-zero = no
     1223               then do:
     1224                   undo, return error.
     1225               end.
     1226               else do:
     1227                   find first buf_zero_fbr-line exclusive-lock
     1228                        where recid( buf_zero_fbr-line ) = recid( buf_fbr-line )
     1229                   .
     1230                   delete buf_zero_fbr-line.
     1231               end.
     1232           end.
     1233   end.
     1234   end procedure.
