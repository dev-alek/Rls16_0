        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-unit-type-list as character no-undo .
        4   define input parameter p-gds-type-list  as character no-undo .
        5   define output parameter p-lns-cnt as integer no-undo .
        6   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   def var vss-author      as character no-undo init "$Author: expertek $":U .
        8   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   def var vss-workfile    as character no-undo init "$Workfile: gdsunitt.p $":U .
       10   def var vss-archive     as character no-undo init "$Archive: str/gdsunitt.p $":U .
       11   def var vss-description as character no-undo init "Дополняет в список товары c указанным типом единицы измерения.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define shared temp-table gds-list no-undo like ub.goods
       74     field qnty   as decimal
       75     field to-del as logical
       76     field order-num as integer
       77     field to-sel as logical
       78     field promo-code as character
       79     field ActionId  as int64
       80     field db-num as integer
       81     index art  is primary unique artic prod-type prod-code
       82     index code is         unique gds-code
       83     index oi order-num
       84     index isel to-sel
       85     .
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  shared  temp-table gds-list-hist no-undo
       88   field list-table as character
       89   field id as integer
       90   field line as integer
       91   field hist-mode as character
       92   field des as character
       93   field num-recs as integer
       94   field option_ as character
       95   field item_ as character
       96   field status_ as character
       97   field num-add as integer
       98   field num-ignored as integer
       99   field done as logical
      100   field err_ as logical
      101   field err-mes as character
      102   index pi is primary
      103   id
      104   line
      105   index isdone
      106   done
      107   .
      108   define variable lns-cnt as integer no-undo .
      109   define variable line-rec as recid no-undo .
      110   def var ind as integer no-undo .
      111   do ind = 1 to num-entries(p-unit-type-list) :
      112     def var v-unit-type as character no-undo .
      113     assign
      114       v-unit-type = entry(ind, p-unit-type-list)
      115     .
      116     if not can-do( 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U, v-unit-type) then do:
      117       message
      118         vss-workfile vss-revision vss-description skip
      119         "Неизвестный тип единицы измерения v-unit-type" skip
      120         "v-unit-type" v-unit-type skip
      121         "p-unit-type-list" p-unit-type-list skip
      122         "unit-types" 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U skip
      123         view-as alert-box error .
      124       undo, return error .
      125     end.
      126     for each ub.units no-lock
      127       where can-do( ub.units.type, v-unit-type )
      128     , each ub.goods no-lock
      129       where ub.goods.unit-base = ub.units.unit-name
      130         and can-do(p-gds-type-list, ub.goods.gds-type)
      131     :
      132   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   find gds-list
      134     where gds-list.prod-type = goods.prod-type
      135       and gds-list.prod-code = goods.prod-code
      136       and gds-list.artic     = goods.artic
      137     no-error .
      138   if available gds-list then do:
      139     assign
      140       gds-list.to-del = no
      141     .
      142   end.
      143   else do:
      144     define variable v-last2 as integer no-undo .
      145     find last gds-list use-index oi no-error.
      146     if available gds-list then do:
      147       v-last2 = gds-list.order-num .
      148     end.
      149     else do:
      150       v-last2 = 0 .
      151     end.
      152     create gds-list .
      153     buffer-copy goods to gds-list
      154     assign
      155       gds-list.to-del = no
      156       gds-list.order-num = v-last2 + 1
      157     .
      158     assign
      159       lns-cnt = lns-cnt + 1
      160       line-rec = recid (gds-list)
      161     .
      162   end.
      163       p-lns-cnt = lns-cnt.
      164     end.
      165   end.
