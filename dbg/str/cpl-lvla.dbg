        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения градуировочной таблицы по резервуару на объекте":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#library  as handle no-undo .
      113   define new global shared variable g#library2 as handle no-undo .
      114   define variable j_host-code as integer   no-undo.
      115   define variable v_host-name as character no-undo format "x(99)":U.
      116   define buffer bf_cli   for ub.clients.
      117   define buffer bf_place for ub.place.
      118   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      119   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      120   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      121   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      122   define frame fr-D-pl-level-8
      123     ub.c-pl-level.pl-code     at row 1.25 col 11.00 colon-aligned view-as fill-in size-chars 10.50 by 1.00    label "Танк"
      124     bf_place.pl-name     at row 1.25 col 24.00          view-as fill-in size-chars 61.50 by 1.00 no-label               fgcolor 4
      125     ub.c-pl-level.obj-type    at row 2.50 col 11.00 colon-aligned view-as fill-in size-chars  4.50 by 1.00    label "Объект"
      126     ub.c-pl-level.obj-code    at row 2.50 col 18.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      127       bf_cli.obj-name    at row 2.50 col 29.00          view-as fill-in size-chars 70.00 by 1.00 no-label               fgcolor 4
      128     ub.c-pl-level.pl-level    at row 3.75 col  2.50          view-as fill-in size-chars 10.50 by 1.00    label "Уровень, мм"
      129     ub.c-pl-level.pl-qnty     at row 5.00 col  5.50          view-as fill-in size-chars 13.50 by 1.00    label "Объем, л"
      130            v_host-name   at row 6.50 col  2.50          view-as fill-in size-chars 83.00 by 1.00 no-label               fgcolor 4
      131     r-rect-0             at row 8.00 col  1.50
      132       Btn_Exit           at row 8.25 col  2.50
      133       Btn_OK             at row 8.25 col 78.00
      134     b-help          at row 8.25 col 88.75
      135   with view-as dialog-box side-labels no-underline three-d scrollable
      136        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      137   assign frame fr-D-pl-level-8 :scrollable = no.
      138   on choose of Btn_OK in frame fr-D-pl-level-8 do:
      139   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   if lookup(self :type
      141            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      142            ) = 0
      143   then do:
      144     message
      145       "$Workfile$"
      146       "Указанному интерфейсному элементу фокус не может быть передан" skip
      147       "Интерфейсный элемент" self :name  skip
      148       "Тип" self :type  skip
      149       "Процедура" this-procedure :file-name skip
      150       view-as alert-box .
      151   end.
      152   else do:
      153     apply "entry":u to self  .
      154     if focus :handle <> self :handle  then do:
      155       return no-apply .
      156     end.
      157   end.
      158     apply "GO":U to frame fr-D-pl-level-8.
      159   end.
      160   on choose of Btn_Exit in frame fr-D-pl-level-8 do:
      161   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   if lookup(self :type
      163            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      164            ) = 0
      165   then do:
      166     message
      167       "$Workfile$"
      168       "Указанному интерфейсному элементу фокус не может быть передан" skip
      169       "Интерфейсный элемент" self :name  skip
      170       "Тип" self :type  skip
      171       "Процедура" this-procedure :file-name skip
      172       view-as alert-box .
      173   end.
      174   else do:
      175     apply "entry":u to self  .
      176     if focus :handle <> self :handle  then do:
      177       return no-apply .
      178     end.
      179   end.
      180   end.
      181   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   on F1 of frame fr-D-pl-level-8 anywhere do:
      183     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pl-level-8. END.
      184     return no-apply.
      185   end.
      186   if valid-handle( active-window ) and frame fr-D-pl-level-8 :parent = ? then frame fr-D-pl-level-8 :parent = active-window.
      187   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      188   on window-close of frame fr-D-pl-level-8 do: apply "END-ERROR":U to self. end.
      189   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   on help of frame fr-D-pl-level-8
      191   do:
      192     run gbl/app_help.p
      193       (input this-procedure :file-name
      194       ,input ''
      195       ,input ?
      196       ) no-error.
      197     if error-status :error then do:
      198       message
      199         "Ошибка при вызове помощи"
      200         error-status :get-message(1)
      201         view-as alert-box .
      202     end.
      203   end.
      204   run minbtn-set in this-procedure .
      205   on choose of b-help in frame fr-D-pl-level-8
      206   do:
      207     apply "help":u to frame fr-D-pl-level-8 .
      208   end.
      209   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      210   procedure minbtn-set :
      211       do
      212           on error undo, return error return-value
      213           :
      214           define variable ii              as integer       no-undo .
      215           define variable fh              as widget-handle no-undo .
      216           define variable hh              as widget-handle no-undo .
      217           define variable v-h             as handle        extent 4 no-undo .
      218           define variable v-name-button   as character     no-undo .
      219           define variable v-help-old-x    as decimal       no-undo .
      220           define variable v-help-old-y    as decimal       no-undo .
      221           define variable v-help-old-size as decimal       no-undo .
      222           define variable v-frame-width   as decimal       no-undo .
      223           define variable jj              as integer       no-undo .
      224           do
      225               on error undo, return error
      226               :
      227               assign
      228                   v-frame-width = frame fr-D-pl-level-8:width - 0.3
      229                   fh            = frame fr-D-pl-level-8:first-child
      230                   hh            = fh:first-child
      231                   ii            = 1
      232                   .
      233               do while valid-handle(hh):
      234                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      235                   do:
      236                       case lc(hh:name) :
      237                           when "b-help" then
      238                               do:
      239                                   hh:load-image-up("cmp/b-help.bmp":u) .
      240                                   hh:load-image-down("cmp/b-help.bmp":u) .
      241                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      242                                   hh:TOOLTIP = "Помощь" .
      243                                   v-help-old-x = hh:column .
      244                                   v-help-old-y = hh:row    .
      245                                   v-help-old-size = hh:width .
      246                                   hh:width-chars = 2.5 .
      247                               end.
      248                           when "b-print" then
      249                               do:
      250                                   hh:load-image("cmp/b-print.bmp":u) .
      251                                   hh:TOOLTIP = "Печать" .
      252                                   v-h[ii] = hh:handle .
      253                                   ii = ii + 1 .
      254                                   hh:width-chars = 3 .
      255                               end.
      256                           when "b-history" or
      257                           when "b-hist" then
      258                               do:
      259                                   hh:load-image("cmp/b-hist.bmp":u) .
      260                                   hh:TOOLTIP = "История" .
      261                                   v-h[ii] = hh:handle .
      262                                   ii = ii + 1 .
      263                                   hh:width-chars = 3 .
      264                               end.
      265                           when "b-sch" then
      266                               do:
      267                                   hh:load-image("cmp/b-sch.bmp":u) .
      268                                   hh:TOOLTIP = "Установка Фильтра" .
      269                                   v-h[ii] = hh:handle .
      270                                   ii = ii + 1 .
      271                                   hh:width-chars = 3 .
      272                               end.
      273                           when "b-hist-user" then
      274                               do:
      275                                   hh:load-image("cmp/b-hist.bmp":u) .
      276                                   hh:TOOLTIP = "История пользователя" .
      277                                   ii = ii + 1 .
      278                               end.
      279                       end case.
      280                   end.
      281                   hh = hh:next-sibling.
      282               end.
      283               b-help:column = v-frame-width - b-help:width-chars.
      284               jj = 0.
      285               repeat ii = 4 to 1 by -1 :
      286                   if valid-handle (v-h[ii] ) then
      287                   do:
      288                       jj  = jj + 1 .
      289                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      290                       v-h[ii]:row    = v-help-old-y .
      291                   end.
      292               end.
      293           end.
      294       end.
      295   end procedure.
      296   Main-Block:
      297   do on error   undo Main-Block, leave Main-Block
      298      on end-key undo Main-Block, leave Main-Block :
      299     if p-mode <> 'ПРОСМОТР':U then do:
      300       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      301               "Неверное значение параметра вызова p-mode:" p-mode
      302       view-as alert-box error.
      303       undo Main-Block, return error.
      304     end.
      305     find ub.c-pl-level no-lock where recid( ub.c-pl-level ) = p-rec-id no-error.
      306     if not available ub.c-pl-level then do:
      307       message "Карточка истории градуировочной таблицы не найдена!" view-as alert-box error.
      308       undo Main-Block, leave Main-Block.
      309     end.
      310     find first bf_place no-lock where
      311                bf_place.obj-type = ub.c-pl-level.obj-type and
      312                bf_place.obj-code = ub.c-pl-level.obj-code and
      313                bf_place.pl-code  = ub.c-pl-level.pl-code  no-error.
      314     find first bf_cli   no-lock where
      315                bf_cli.obj-type   = ub.c-pl-level.obj-type and
      316                bf_cli.obj-code   = ub.c-pl-level.obj-code no-error.
      317   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      319     (input  ub.c-pl-level.obj-type
      320     ,input  ub.c-pl-level.obj-code
      321     ,output j_host-code
      322     ,output v_host-name
      323     ) no-error .
      324     if error-status :error or v_host-name = ? then do: assign v_host-name = "":U. end.
      325     assign frame fr-D-pl-level-8 :title = substitute(
      326       'Карточка изменения градуировочной таблицы по резервуару &1 на объекте &2 &3 "&4" -- &5',
      327       ub.c-pl-level.pl-code,
      328       ub.c-pl-level.obj-type,
      329       ub.c-pl-level.obj-code,
      330       bf_cli.obj-name,
      331       p-mode ).
      332     display ub.c-pl-level.pl-code
      333             ub.c-pl-level.obj-type
      334             ub.c-pl-level.obj-code
      335             ub.c-pl-level.pl-level
      336             ub.c-pl-level.pl-qnty
      337                    v_host-name
      338     with frame fr-D-pl-level-8.
      339     if available bf_cli   then do: display bf_cli.obj-name  with frame fr-D-pl-level-8. end.
      340     if available bf_place then do: display bf_place.pl-name with frame fr-D-pl-level-8. end.
      341     enable  Btn_Exit b-help with frame fr-D-pl-level-8.
      342     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pl-level-8. end.
      343     wait-for go of frame fr-D-pl-level-8.
      344   end.
      345   hide frame fr-D-pl-level-8 no-pause.
