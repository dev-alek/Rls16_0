      487   procedure gds-attr-value :
      488     define input  parameter p-gds-code as integer   no-undo .
      489     define input  parameter p-code     as character no-undo .
      490     define output parameter p-value    as character no-undo .
      491     define output parameter p-type     as character no-undo .
      492     do
