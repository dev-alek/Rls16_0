      441   define new global shared variable g#attr-lib  as handle no-undo .
      442   define variable v-attr-lib-variable as handle no-undo .
      443   procedure gds-attr-name :
      444     define input  parameter p-code           as character no-undo .
      445     define output parameter p-type           as character no-undo .
      446     define output parameter p-format         as character no-undo .
      447     define output parameter p-label          as character no-undo .
      448     define output parameter p-user-can-edit  as logical   no-undo .
      449     define output parameter p-output-display as logical   no-undo .
      450     define output parameter p-other          as character no-undo .
      451     do
      452     on error undo, return error
      453     :
      454           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      455         (input  p-code
      456         ,output p-type
      457         ,output p-format
      458         ,output p-label
