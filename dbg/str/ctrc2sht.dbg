     1832     trans-close:
     1833     do on error undo Main-Block, return error return-value :
     1834       run waitfram-show in this-procedure ( input 'Закрываем документ сверки' ) .
     1835       find first  ctrl_rvs-doc exclusive-lock where
     1836           recid(  ctrl_rvs-doc ) = p-rvs-doc-rec .
     1837       find first shift_rvs-doc exclusive-lock where
     1838           recid( shift_rvs-doc ) = rec-rvs-shift .
     1839   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
     1840                         input recid( shift_rvs-doc ) ,
     1841                         input yes ) no-error .
     1842       if error-status :error then do:
     1843         run waitfram-hide in this-procedure .
     1844         undo Main-Block, return error substitute( 'Ошибка при закрытии документа сверки "&1" (закрытие).&2&3&2&4'
     1845                                                 , shift_rvs-doc.rvs-code
     1846                                                 , chr(10)
     1847                                                 , error-status :get-message( 1 )
     1848                                                 , return-value ) .
     1849       end.
     1850       find first shift_rvs-doc        no-lock where
     1851           recid( shift_rvs-doc ) = rec-rvs-shift .
     1852       find first  ctrl_rvs-doc        no-lock where
     1853           recid(  ctrl_rvs-doc ) = p-rvs-doc-rec .
     1854     end.
     1855     do on error undo Main-Block, return error return-value :
     1856       run waitfram-show in this-procedure ( input 'Закрываем документ на факт' ) .
     1857       find first  ctrl_rvs-doc exclusive-lock where
     1858           recid(  ctrl_rvs-doc ) = p-rvs-doc-rec .
     1859       find first shift_rvs-doc exclusive-lock where
     1860           recid( shift_rvs-doc ) = rec-rvs-shift .
     1861       find first bf_rvs-line no-lock where
     1862                  bf_rvs-line.rvs-code           = shift_rvs-doc.rvs-code and
     1863                  bf_rvs-line.obj-type           = shift_rvs-doc.obj-type and
     1864                  bf_rvs-line.obj-code           = shift_rvs-doc.obj-code and
     1865                  bf_rvs-line.state-measure-qnty = ?                      no-error .
     1866       define variable is-vir as logical no-undo.
     1867       define variable v-value as character no-undo.
     1868       define variable v-ok as logical no-undo.
     1869       run placelib_get-attr(input "place-virtual"
     1870                            ,input bf_rvs-line.obj-code
     1871                            ,input bf_rvs-line.obj-type
     1872                            ,input bf_rvs-line.pl-code
     1873                            ,output v-value
     1874                            ,output v-ok) no-error.
     1875       is-vir = if (v-ok and logical(v-value)) then true else false.
     1876       if available bf_rvs-line and not is-gas(bf_rvs-line.gds-code) and not is-vir then do:
     1877         run waitfram-hide in this-procedure .
     1878         undo Main-Block, return error substitute( 'Не заданы фактические остатки по товару &1.'
     1879                                                 , bf_rvs-line.gds-code ) .
     1880       end.
     1881   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
     1882                         input recid( shift_rvs-doc ) ,
     1883                         input yes ) no-error .
     1884       if error-status :error then do:
     1885         run waitfram-hide in this-procedure .
     1886         undo Main-Block, return error substitute( 'Ошибка при закрытии сверки "&1" на &2.&3&4&3&5'
     1887                                                 , shift_rvs-doc.rvs-code
     1888                                                 , 'факт':U
     1889                                                 , chr(10)
     1890                                                 , error-status :get-message( 1 )
     1891                                                 , return-value ) .
     1892       end.
     1893       find first shift_rvs-doc        no-lock where
     1894           recid( shift_rvs-doc ) = rec-rvs-shift .
     1895       release shift_rvs-doc .
     1896       find first  ctrl_rvs-doc        no-lock where
     1897           recid(  ctrl_rvs-doc ) = p-rvs-doc-rec .
     1898     end.
     1899     run waitfram-hide in this-procedure .
     1900   end.
