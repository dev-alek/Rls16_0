     1028           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1029         (input  p-gds-code
     1030         ,input  'fuel-type':U
     1031         ,output c-value
     1032         ,output c-type) no-error.
     1033   end.
     1034   result = logical(c-value = 'metan':U) no-error.
     1035   return result.
     1036   end function.
     1037   procedure placelib_write-attr:
     1038   define input  parameter p-code     like ub.place-attr.attr-code .
     1039   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1040   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1041   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1042   define input  parameter p-value    like ub.place-attr.attr-value .
     1043   define output parameter p-ok       as logical.
     1044   define buffer buf_place-attr for ub.place-attr .
     1045     do on error undo, return error return-value :
     1046        p-ok = false.
     1047        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1048                                                   and buf_place-attr.obj-code    = p-obj-code
     1049                                                   and buf_place-attr.obj-type    = p-obj-type
     1050                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1051        if not available buf_place-attr then do :
     1052           create buf_place-attr.
     1053           assign
     1054             buf_place-attr.attr-code   = p-code
     1055             buf_place-attr.attr-value  = p-value
     1056             buf_place-attr.obj-code    = p-obj-code
     1057             buf_place-attr.obj-type    = p-obj-type
     1058             buf_place-attr.pl-code     = p-pl-code
     1059           .
     1060           p-ok = true.
     1061        end.
     1062        else do:
     1063           buf_place-attr.attr-value  = p-value .
     1064           p-ok = true.
     1065        end.
     1066     end.
     1067   end.
     1068   procedure placelib_get-attr:
     1069   define input  parameter  p-code     like ub.place-attr.attr-code .
     1070   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1071   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1072   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1073   define output parameter  p-value    like ub.place-attr.attr-value .
     1074   define output parameter  p-ok       as logical.
     1075   define buffer buf_place-attr for ub.place-attr .
     1076     do on error undo, return error return-value :
     1077        p-ok = false.
     1078        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1079                                                   and buf_place-attr.obj-code    = p-obj-code
     1080                                                   and buf_place-attr.obj-type    = p-obj-type
     1081                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1082        if available buf_place-attr then do :
     1083          p-value = buf_place-attr.attr-value.
     1084          p-ok = true.
     1085        end.
     1086        else do :
     1087          p-ok = false.
     1088        end.
     1089     end.
     1090   end.
     1091   procedure placelib_del-attr:
     1092   define input parameter  p-code     like ub.place-attr.attr-code .
     1093   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1094   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1095   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1096   define input parameter  p-value    like ub.place-attr.attr-value .
     1097   define output parameter p-ok       as logical.
     1098   define buffer buf_place-attr for ub.place-attr .
     1099     do on error undo, return error return-value :
     1100        p-ok = false.
     1101        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1102                                                   and buf_place-attr.obj-code    = p-obj-code
     1103                                                   and buf_place-attr.obj-type    = p-obj-type
     1104                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1105        if available buf_place-attr then do :
     1106           delete buf_place-attr.
     1107           p-ok = true.
     1108        end.
     1109     end.
     1110   end.
     1111   define variable rec-rvs-shift as recid         no-undo .
     1112   define variable p-db-num      as integer       no-undo .
     1113   define variable p-userid      as character     no-undo .
     1114   define variable v-obj-date    as date          no-undo .
     1115   define variable r-line-shift  as recid         no-undo .
     1116   define variable r-pump-shift  as recid         no-undo .
     1117   define variable v-rvs-code    as character     no-undo .
     1118   define variable v-attr-value  as character no-undo .
     1119   define variable v-attr-type   as character no-undo .
     1120   define buffer buf_doc-attr for ub.doc-attr.
     1121   define buffer bf_rvs-doc          for ub.rvs-doc .
     1122   define buffer bf_rvs-line         for ub.rvs-line .
     1123   define buffer bf_rvs-line-pump    for ub.rvs-line-pump .
     1124   define buffer ctrl_rvs-doc        for ub.rvs-doc .
     1125   define buffer ctrl_rvs-line       for ub.rvs-line .
     1126   define buffer ctrl_rvs-line-pump  for ub.rvs-line-pump .
     1127   define buffer shift_rvs-doc       for ub.rvs-doc .
     1128   define buffer shift_rvs-line      for ub.rvs-line .
     1129   define buffer shift_rvs-line-pump for ub.rvs-line-pump .
     1130   define buffer bf_icnt-doc         for ub.icnt-doc .
     1131   define buffer bf_place            for ub.place .
     1132   define buffer bf_place-error      for ub.place .
     1133   define buffer bf_pl-gds           for ub.pl-gds .
     1134   define buffer bf_pl-pump-nozzle   for ub.pl-pump-nozzle .
     1135   define buffer buf_ctrl-rvs-line-attr   for ub.rvs-line-attr .
     1136   define buffer buf_shift-rvs-line-attr   for ub.rvs-line-attr .
     1137   define temp-table tt_pl-gds no-undo
     1138     field pl-code  like ub.pl-gds.pl-code
     1139     field gds-code like ub.pl-gds.gds-code
     1140   .
     1141   define temp-table tt_pmp-nzzl no-undo
     1142     field pl-code     like ub.pl-pump-nozzle.pl-code
     1143     field pump-code   like ub.pl-pump-nozzle.pump-code
     1144     field nozzle-code like ub.pl-pump-nozzle.nozzle-code
     1145   .
     1146     find first ctrl_rvs-doc no-lock where
     1147         recid( ctrl_rvs-doc ) = p-rvs-doc-rec no-error .
     1148     if not available ctrl_rvs-doc then do:
     1149       run waitfram-hide in this-procedure .
     1150       return error 'ОШИБКА! Не найден документ контрольной сверки.' .
     1151     end.
     1152     if can-find (first buf_doc-attr
     1153                  where ctrl_rvs-doc.rvs-code = buf_doc-attr.doc-code
     1154                    and buf_doc-attr.attr-code = "rvs-auto"
     1155                    and buf_doc-attr.attr-value = "Yes") then do:
     1156    return error substitute( 'Нельзя создать сменную сверку по автоматической!'
     1157                              ) .
     1158         end.
     1159     run str/deskshft.p
     1160       ( input parparentproc
     1161       , input no
     1162       , input ctrl_rvs-doc.obj-type
     1163       , input ctrl_rvs-doc.obj-code
     1164       , input ctrl_rvs-doc.shift-date
     1165       , input ctrl_rvs-doc.shift-num
     1166       , input ctrl_rvs-doc.shift-name
     1167       ) no-error .
     1168     if error-status :error then do:
     1169       return error substitute( '&1&2&3'
     1170                              , error-status :get-message( 1 )
     1171                              , chr(10)
     1172                              , return-value ) .
     1173     end.
     1174   Main-Block:
     1175   do on error undo Main-Block, return error return-value :
     1176     run waitfram-show in this-procedure ( input 'Создание документа сменной сверки' ) .
     1177     assign
     1178     p-db-num  = v-cntxt-db-num
     1179     p-userid  = v-cntxt-userid
     1180     .
     1181     if ctrl_rvs-doc.rvs-type <> 'контроль':U  then do:
     1182       run waitfram-hide in this-procedure .
     1183       return error substitute( 'Сверка должна иметь тип "&1", а не "&2".'
     1184                              , 'контроль':U
     1185                              , ctrl_rvs-doc.rvs-type ) .
     1186     end.
     1187     if ctrl_rvs-doc.is-full <> yes  then do:
     1188       run waitfram-hide in this-procedure .
     1189       return error 'Контрольная сверка должна быть ПОЛНОЙ.' .
     1190     end.
     1191     if ctrl_rvs-doc.status_ <> 'факт':U then do:
     1192       run waitfram-hide in this-procedure .
     1193       return error substitute( 'Cверка должна быть закрыта на "&1".'
     1194                              , 'факт':U ) .
     1195     end.
     1196     find first bf_rvs-doc no-lock where
     1197                bf_rvs-doc.obj-type =  ctrl_rvs-doc.obj-type and
     1198                bf_rvs-doc.obj-code =  ctrl_rvs-doc.obj-code and
     1199                bf_rvs-doc.status_  <> 'факт':U               and
     1200              ( bf_rvs-doc.rvs-type =  'смена':U          or
     1201                bf_rvs-doc.rvs-type =  'контроль':U )      no-error .
     1202     if available bf_rvs-doc then do:
     1203       run waitfram-hide in this-procedure .
     1204       return error substitute( 'Имеется не закрытый документ сверки "&1".'
     1205                              , bf_rvs-doc.rvs-code ) .
     1206     end.
     1207     find first bf_rvs-doc no-lock where
     1208                bf_rvs-doc.obj-type   = ctrl_rvs-doc.obj-type   and
     1209                bf_rvs-doc.obj-code   = ctrl_rvs-doc.obj-code   and
     1210                bf_rvs-doc.shift-date = ctrl_rvs-doc.shift-date and
     1211                bf_rvs-doc.shift-num  = ctrl_rvs-doc.shift-num  and
     1212                bf_rvs-doc.status_    = 'факт':U                 and
     1213                bf_rvs-doc.fact-order > ctrl_rvs-doc.fact-order and
     1214              ( bf_rvs-doc.rvs-type   = 'смена':U            or
     1215                bf_rvs-doc.rvs-type   = 'контроль':U )        no-error .
     1216     if available bf_rvs-doc then do:
     1217                   find first buf_doc-attr where  bf_rvs-doc.rvs-code = buf_doc-attr.doc-code and buf_doc-attr.attr-code = "rvs-auto" and buf_doc-attr.attr-value = "Yes" no-error.
     1218         if not available buf_doc-attr then do:
     1219       run waitfram-hide in this-procedure .
     1220       return error substitute( 'Имеется более поздний документ сверки "&1" &2.'
     1221                              , bf_rvs-doc.rvs-code
     1222                              , bf_rvs-doc.rvs-type ) .
     1223     end.
     1224     end.
     1225     find first bf_icnt-doc no-lock where
     1226                bf_icnt-doc.obj-type  = ctrl_rvs-doc.obj-type and
     1227                bf_icnt-doc.obj-code  = ctrl_rvs-doc.obj-code and
     1228                bf_icnt-doc.status_  <> 'факт':U               no-error .
     1229     if available bf_icnt-doc then do:
     1230       run waitfram-hide in this-procedure .
     1231       return error substitute( 'Имеется не закрытый документ инвентаризации счетчиков ТРК "&1".'
     1232                              , bf_icnt-doc.doc-code ) .
     1233     end.
     1234     for each bf_place  no-lock where
     1235              bf_place.obj-type = ctrl_rvs-doc.obj-type and
     1236              bf_place.obj-code = ctrl_rvs-doc.obj-code and
     1237              bf_place.status_  = ""
     1238       , each bf_pl-gds no-lock where
     1239              bf_pl-gds.obj-type = bf_place.obj-type and
     1240              bf_pl-gds.obj-code = bf_place.obj-code and
     1241              bf_pl-gds.pl-code  = bf_place.pl-code
     1242     :
     1243       if trim( bf_place.loc1 ) = '':U or
     1244                bf_place.loc1   = ?
     1245       then do:
     1246         return error substitute( 'В измеряемом резервуаре &1 задан неверный локальный номер "&2".'
     1247                                , bf_place.pl-code
     1248                                , bf_place.loc1 ) .
     1249       end.
     1250       find first bf_place-error no-lock where
     1251                  bf_place-error.obj-type =  bf_place.obj-type and
     1252                  bf_place-error.obj-code =  bf_place.obj-code and
     1253                  bf_place-error.is-meas  =  yes               and
     1254                  bf_place-error.loc1     =  bf_place.loc1     and
     1255                  bf_place-error.status_  =  ""                and
     1256           recid( bf_place-error )        <> recid( bf_place ) no-error .
     1257       if available bf_place-error then do:
     1258         return error substitute( 'В измеряемом резервуаре &1 задан локальный номер &2, установленный также в резервуаре &3.'
     1259                                , bf_place.pl-code
     1260                                , bf_place.loc1
     1261                                , bf_place-error.pl-code ) .
     1262       end.
     1263       find first tt_pl-gds where
     1264                  tt_pl-gds.pl-code  = bf_pl-gds.pl-code  and
     1265                  tt_pl-gds.gds-code = bf_pl-gds.gds-code no-error .
     1266       if available tt_pl-gds then do:
     1267         next .
     1268       end.
     1269       else do:
     1270         create tt_pl-gds.
     1271         assign
     1272                tt_pl-gds.pl-code  = bf_pl-gds.pl-code
     1273                tt_pl-gds.gds-code = bf_pl-gds.gds-code
     1274         .
     1275       end.
     1276     end.
     1277     for each bf_pl-pump-nozzle no-lock where
     1278              bf_pl-pump-nozzle.obj-type = ctrl_rvs-doc.obj-type and
     1279              bf_pl-pump-nozzle.obj-code = ctrl_rvs-doc.obj-code
     1280       , each bf_pl-gds no-lock where
     1281              bf_pl-gds.obj-type = bf_pl-pump-nozzle.obj-type and
     1282              bf_pl-gds.obj-code = bf_pl-pump-nozzle.obj-code and
     1283              bf_pl-gds.pl-code  = bf_pl-pump-nozzle.pl-code
     1284     :
     1285       find first tt_pl-gds where
     1286                  tt_pl-gds.pl-code  = bf_pl-gds.pl-code  and
     1287                  tt_pl-gds.gds-code = bf_pl-gds.gds-code no-error .
     1288       if not available tt_pl-gds then do:
     1289         return error substitute( 'Ошибка. Не найден резервуар &3 для ТРК &1, пистолет &2 (топливо &4).'
     1290                                , bf_pl-pump-nozzle.pump-code
     1291                                , bf_pl-pump-nozzle.nozzle-code
     1292                                , bf_pl-gds.pl-code
     1293                                , bf_pl-gds.gds-code ) .
     1294       end.
     1295       find first tt_pmp-nzzl where
     1296                  tt_pmp-nzzl.pl-code     = bf_pl-gds.pl-code             and
     1297                  tt_pmp-nzzl.pump-code   = bf_pl-pump-nozzle.pump-code   and
     1298                  tt_pmp-nzzl.nozzle-code = bf_pl-pump-nozzle.nozzle-code no-error .
     1299       if available tt_pmp-nzzl then do:
     1300         next .
     1301       end.
     1302       else do:
     1303         create tt_pmp-nzzl.
     1304         assign
     1305                tt_pmp-nzzl.pl-code     = bf_pl-gds.pl-code
     1306                tt_pmp-nzzl.pump-code   = bf_pl-pump-nozzle.pump-code
     1307                tt_pmp-nzzl.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     1308         .
     1309       end.
     1310     end.
     1311     trans-create:
     1312     do on error undo Main-Block, return error return-value :
     1313       find first ctrl_rvs-doc exclusive-lock where
     1314           recid( ctrl_rvs-doc ) = p-rvs-doc-rec .
     1315   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1317     (input  ctrl_rvs-doc.obj-type
     1318     ,input  ctrl_rvs-doc.obj-code
     1319     ,output v-obj-date
     1320     )  .
     1321       do on error undo, return error return-value :
     1322         create shift_rvs-doc .
     1323         assign
     1324           rec-rvs-shift = recid( shift_rvs-doc )
     1325         .
     1326         buffer-copy  ctrl_rvs-doc
     1327              except  ctrl_rvs-doc.system-qnty
     1328                      ctrl_rvs-doc.system-cli-qnty
     1329                      ctrl_rvs-doc.status_
     1330                      ctrl_rvs-doc.rvs-type
     1331                      ctrl_rvs-doc.rvs-code
     1332                      ctrl_rvs-doc.out-code
     1333                      ctrl_rvs-doc.creid
     1334                      ctrl_rvs-doc.doc-date
     1335                      ctrl_rvs-doc.fact-order
     1336                      ctrl_rvs-doc.is-full
     1337                  to shift_rvs-doc
     1338              assign shift_rvs-doc.system-qnty     = 0.0
     1339                     shift_rvs-doc.system-cli-qnty = 0.0
     1340                     shift_rvs-doc.status_         = 'новый':U
     1341                     shift_rvs-doc.rvs-type        = 'смена':U
     1342                     shift_rvs-doc.out-code        = ?
     1343                     shift_rvs-doc.creid           = p-userid
     1344                     shift_rvs-doc.doc-date        = v-obj-date
     1345                     shift_rvs-doc.is-full         = no
     1346                     shift_rvs-doc.ps              = "Создана на основе контрольной сверки № " + ctrl_rvs-doc.rvs-code + "."
     1347         .
     1348         run doc-code in this-procedure
     1349           (  input "main"
     1350           ,  input ctrl_rvs-doc.obj-type
     1351           ,  input ctrl_rvs-doc.obj-code
     1352           ,  input ?
     1353           , output v-rvs-code
     1354           ) no-error .
     1355         if error-status :error then do:
     1356           run waitfram-hide in this-procedure .
     1357           undo Main-Block, return error substitute( 'Ошибка при генерации номера документа.&1&2'
     1358                                                   , chr(10)
     1359                                                   , return-value ) .
     1360         end.
     1361         assign
     1362           shift_rvs-doc.rvs-code = v-rvs-code
     1363         .
     1364         run gbl/factdate.p
     1365           ( input        shift_rvs-doc.obj-type
     1366           , input        shift_rvs-doc.obj-code
     1367           , input-output shift_rvs-doc.fact-date
     1368           , input-output shift_rvs-doc.fact-time
     1369           , input-output shift_rvs-doc.shift-date
     1370           , input-output shift_rvs-doc.shift-num
     1371           , input-output shift_rvs-doc.shift-name
     1372           , input        no
     1373           ) no-error .
     1374         if error-status :error then do:
     1375           run waitfram-hide in this-procedure .
     1376           undo Main-Block, return error 'Ошибка при установке даты в документе (rvs-doc).' .
     1377         end.
     1378         run gbl/chk-date.p
     1379           ( input shift_rvs-doc.obj-type
     1380           , input shift_rvs-doc.obj-code
     1381           , input shift_rvs-doc.fact-date
     1382           , input shift_rvs-doc.fact-time
     1383           , input shift_rvs-doc.shift-date
     1384           , input shift_rvs-doc.shift-num
     1385           , input no
     1386           ) no-error .
     1387         if error-status :error then do:
     1388           run waitfram-hide in this-procedure .
     1389           undo Main-Block, return error substitute( 'Ошибка при проверке корректности дат. &1&2&3'
     1390                                                   , error-status :get-message( 1 )
     1391                                                   , chr(10)
     1392                                                   , return-value ) .
     1393         end.
     1394         run str/chk-rvs.p ( input recid( shift_rvs-doc ) ) no-error .
     1395         if error-status :error then do:
     1396           run waitfram-hide in this-procedure .
     1397           undo Main-Block, return error substitute( 'Ошибка документа сверки. &1&2&3'
     1398                                                   , return-value
     1399                                                   , chr(10)
     1400                                                   , error-status :get-message( 1 ) ) .
     1401         end.
     1402         for each tt_pl-gds
     1403         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1404         :
