     1557   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1558   define variable v-is-closed-shift-journal as integer no-undo .
     1559   assign
     1560   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1561                               +
     1562                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1563                               +
     1564                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1565   .
     1566   return v-is-closed-shift-journal.
     1567   END FUNCTION.
     1568   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1569   define variable v-is-first-journal as logical no-undo .
     1570   assign
     1571   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1572                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1573                     or (p-journal-num =  integer(entry(1, '17':U)))
     1574                     or (p-journal-num = integer(entry(1, '16':U)))
     1575   .
     1576   return v-is-first-journal.
     1577   END FUNCTION.
     1578   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1579   define variable v-is-petrol-journal as logical no-undo .
     1580   assign
     1581   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1582   return v-is-petrol-journal.
     1583   END FUNCTION.
     1584   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1585   define variable v-max-record-num as integer no-undo .
     1586   assign
     1587   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1588                       then 1489
     1589                       else 2340).
     1590   return v-max-record-num.
     1591   END FUNCTION.
     1592   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1593   define variable v-max-record-num as integer no-undo .
     1594   assign
     1595   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1596                       then 1489 * num-entries('30,31,32,33':U)
     1597                       else 2340 * num-entries('17':U)).
     1598   return v-max-record-num.
     1599   END FUNCTION.
     1600   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1601                                           ,input p-rec-no as integer):
     1602   define variable v-num-recs as integer no-undo .
     1603   if tekka-is-petrol-journal (p-journal-num) then do:
     1604     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1605       assign
     1606       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1607       .
     1608     end.
     1609     else do:
     1610       assign
     1611       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1612       .
     1613     end.
     1614   end.
     1615   else do:
     1616     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1617       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1618         assign
     1619         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1620         .
     1621       end.
     1622       else do:
     1623         assign
     1624         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1625         .
     1626       end.
     1627     end.
     1628     else do:
     1629       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1630         assign
     1631         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1632         .
     1633       end.
     1634       else do:
     1635         assign
     1636         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1637         .
     1638       end.
     1639     end.
     1640   end.
     1641   return v-num-recs.
     1642   END FUNCTION.
     1643   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1644                                              ,input p-is-petrol as logical
     1645                                              ,input p-is-current as logical
     1646                                              ,output p-rec-no as decimal
     1647                                              ):
     1648   define variable v-obj-num0 as integer no-undo .
     1649   define variable v-obj-num as integer no-undo .
     1650   define variable v-obj-num2 as integer no-undo .
     1651   define variable p-num-recs2 as integer no-undo .
     1652   define variable p-rec-no2 as integer no-undo .
     1653   if p-is-petrol then do:
     1654     assign
     1655     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1656     .
     1657     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1658     then
     1659     assign
     1660     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1661     p-rec-no = p-num-recs modulo 1489
     1662     .
     1663     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1664     then
     1665     assign
     1666     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1667     p-rec-no = p-num-recs modulo 1489
     1668     .
     1669   end.
     1670   else do:
     1671     assign
     1672     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1673     p-num-recs = trunc(p-num-recs, 0)
     1674     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1675     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1676     .
     1677     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1678     then
     1679     assign
     1680     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1681     p-rec-no = p-num-recs modulo 2340
     1682     .
     1683     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1684     then
     1685     assign
     1686     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1687     p-rec-no = p-num-recs modulo 2340
     1688     .
     1689     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1690     then
     1691     assign
     1692     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1693     p-rec-no2 = p-num-recs2 modulo 2978
     1694     .
     1695     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1696     then
     1697     assign
     1698     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1699     p-rec-no2 = p-num-recs2 modulo 2978
     1700     .
     1701     assign
     1702     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1703     .
     1704   end.
     1705   if v-obj-num = 0 then v-obj-num = 100.
     1706   return v-obj-num.
     1707   END FUNCTION.
     1708   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1709   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1710   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1711      if p-is-ptrl then
     1712      return integer(entry(1, '26,27,28,29':U)).
     1713      if not p-is-ptrl then
     1714      return integer(entry(1, '16':U)).
     1715   end.
     1716   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1717   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1718   return 0.
     1719   END FUNCTION.
     1720   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1721   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1722   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1723     if p-is-ptrl then
     1724     return integer(entry(1, '26,27,28,29':U)).
     1725     if not p-is-ptrl then
     1726     return integer(entry(1, '16':U)).
     1727   end.
     1728   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1729   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1730   return 0.
     1731   END FUNCTION.
     1732   PROCEDURE maria-put:
     1733   define parameter buffer buf_cash-desk for ub.cash-desk.
     1734   define input parameter p-out    as character no-undo .
     1735   define input parameter p-fname as character no-undo .
     1736   define input parameter p-by-record as logical no-undo .
     1737   define input parameter p-shift-fields as integer no-undo .
     1738   define input parameter p-binary as logical no-undo .
     1739   define input parameter p-obj-num as integer no-undo .
     1740   define input parameter p-max-records as integer no-undo .
     1741   define input parameter p-plu as integer no-undo .
     1742   define input parameter p-value as character no-undo .
     1743   define variable v-file-name as character no-undo .
     1744   define variable v-create as logical no-undo .
     1745   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1746   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1747   output stream IBMSTREAM
     1748   to value(v-file-name) append .
     1749   Put  stream IBMSTREAM unformatted
     1750   p-plu
     1751   chr(3)
     1752   p-value
     1753   skip.
     1754   output stream IBMSTREAM
     1755   close.
     1756   if not p-by-record then do:
     1757     find first buf_temp-tekka-tsk where
     1758               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1759     if not available buf_temp-tekka-tsk then do:
     1760       v-create = yes.
     1761     end.
     1762   end.
     1763   else do:
     1764     find first buf_temp-tekka-tsk where
     1765               buf_temp-tekka-tsk.filename  = v-file-name
     1766           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1767     if not available buf_temp-tekka-tsk
     1768     then do:
     1769       find first buf_temp-tekka-tsk where
     1770                 buf_temp-tekka-tsk.filename  = v-file-name
     1771             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1772       if not available buf_temp-tekka-tsk
     1773       then do:
     1774         v-create = yes.
     1775       end.
     1776     end.
     1777   end.
     1778   if v-create then do:
     1779     create buf_temp-tekka-tsk.
     1780     assign
     1781     buf_temp-tekka-tsk.filename = v-file-name
     1782     buf_temp-tekka-tsk.range    = p-plu
     1783     buf_temp-tekka-tsk.obj-num = p-obj-num
     1784     buf_temp-tekka-tsk.obj-name = '':U
     1785     buf_temp-tekka-tsk.num-records = 0
     1786     buf_temp-tekka-tsk.max-records = p-max-records
     1787     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1788     buf_temp-tekka-tsk.task-num = p-fname
     1789     buf_temp-tekka-tsk.by-record = p-by-record
     1790     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1791     buf_temp-tekka-tsk.binary = p-binary
     1792     buf_temp-tekka-tsk.send-get = 'send'
     1793     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1794     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1795     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1796     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1797                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1798                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1799                                 then 'local'
     1800                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1801     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1802     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1803     buf_temp-tekka-tsk.waiting-sek = 30
     1804     buf_temp-tekka-tsk.min-plu     = p-plu
     1805     buf_temp-tekka-tsk.max-plu     = p-plu
     1806     .
     1807   end.
     1808   assign
     1809   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1810   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1811   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1812   .
     1813   END PROCEDURE.
     1814   PROCEDURE maria-get:
     1815   define parameter buffer buf_cash-desk for ub.cash-desk.
     1816   define input parameter p-out    as character no-undo .
     1817   define input parameter p-fname as character no-undo .
     1818   define input parameter p-by-record as logical no-undo .
     1819   define input parameter p-obj-num as integer no-undo .
     1820   define input parameter p-num-fields as integer no-undo .
     1821   define input parameter p-max-records as integer no-undo .
     1822   define input parameter p-min-plu as integer no-undo .
     1823   define input parameter p-max-plu as integer no-undo .
     1824   define input parameter p-other as character no-undo .
     1825   define input parameter p-order-num as integer no-undo .
     1826   define variable v-file-name as character no-undo .
     1827   define variable v-secondary-obj-num as character no-undo .
     1828   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1829   if p-by-record then do:
     1830     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1831   end.
     1832   else do:
     1833     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1834   end.
     1835   find first buf_temp-tekka-tsk where
     1836             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1837   if not available buf_temp-tekka-tsk then do:
     1838     create buf_temp-tekka-tsk.
     1839     assign
     1840     buf_temp-tekka-tsk.filename = v-file-name
     1841     buf_temp-tekka-tsk.obj-num = p-obj-num
     1842     buf_temp-tekka-tsk.obj-name = '':U
     1843     buf_temp-tekka-tsk.max-records = p-max-records
     1844     buf_temp-tekka-tsk.num-fields = p-num-fields
     1845     buf_temp-tekka-tsk.task-num = p-fname
     1846     buf_temp-tekka-tsk.by-record = p-by-record
     1847     buf_temp-tekka-tsk.send-get = 'get'
     1848     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1849     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1850     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1851     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1852                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1853                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1854                                   then 'local'
     1855                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1856     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1857     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1858     buf_temp-tekka-tsk.waiting-sek = 30
     1859     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1860     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1861     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1862                                       and p-max-plu <> ?
     1863                                       then p-max-plu - p-min-plu + 1
     1864                                       else 0)
     1865     buf_temp-tekka-tsk.other-info = p-other
     1866     buf_temp-tekka-tsk.order-num = p-order-num
     1867     .
     1868     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1869       assign
     1870       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1871       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1872       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1873       no-error
     1874       .
     1875       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1876     end.
     1877   end.
     1878   END PROCEDURE.
     1879   PROCEDURE maria-task:
     1880   define parameter buffer buf_cash-desk for ub.cash-desk.
     1881   define input parameter p-fname as character no-undo .
     1882   define input parameter p-obj-num-list as character no-undo .
     1883   define input parameter p-parameters as character no-undo .
     1884   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1885   find first buf_temp-tekka-tsk where
     1886             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1887   if not available buf_temp-tekka-tsk then do:
     1888     create buf_temp-tekka-tsk.
     1889     assign
     1890     buf_temp-tekka-tsk.filename = ''
     1891     buf_temp-tekka-tsk.range = 1
     1892     buf_temp-tekka-tsk.obj-num = 0
     1893     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1894     buf_temp-tekka-tsk.task-num = p-fname
     1895     buf_temp-tekka-tsk.by-record = no
     1896     buf_temp-tekka-tsk.send-get = 'task'
     1897     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1898     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1899     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1900     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1901                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1902                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1903                                   then 'local'
     1904                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1905     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1906     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1907     buf_temp-tekka-tsk.waiting-sek = 30
     1908     buf_temp-tekka-tsk.other-info = p-parameters
     1909     buf_temp-tekka-tsk.order-num = 0
     1910     .
     1911   end.
     1912   END PROCEDURE.
     1913   procedure tekkatsk-verify-schema :
     1914   define input parameter p-obj-list as character no-undo .
     1915   define input parameter p-dir-path as character no-undo .
     1916   define variable v-obj-num as integer no-undo .
     1917   define variable v-obj-name as character no-undo .
     1918   define variable v-num-records as integer no-undo .
     1919   define variable v-size_ as integer no-undo .
     1920   define variable v-value as character no-undo .
     1921   define variable ii as integer no-undo .
     1922   define variable jj as integer no-undo .
     1923   define variable ii-ibs as integer no-undo .
     1924   define variable ii-tekka as integer no-undo .
     1925   define variable v-result as character no-undo .
     1926   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1927   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1928     do
     1929     on error undo, return error
     1930     :
     1931        for each buf_temp-tekka-schema:
     1932          delete buf_temp-tekka-schema.
     1933        end.
     1934        input from value('tekkasch.d').
     1935        repeat :
     1936          create buf_temp-tekka-schema.
     1937          import buf_temp-tekka-schema.
     1938          assign
     1939          buf_temp-tekka-schema.host = 'IBS'
     1940          ii = ii + 1.
     1941          .
     1942        end.
     1943        input close.
     1944        ii-ibs = ii.
     1945         _ii:
     1946         do ii = 1 to 256:
     1947           if p-obj-list = "ALL"
     1948           or lookup(string(ii), p-obj-list) > 0 then do:
     1949             assign
     1950             v-obj-num = 0
     1951             v-obj-name = ''
     1952             v-num-records = 0
     1953             v-size_ = 0
     1954             .
     1955             run alienini-getkey in this-procedure (
     1956                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1957                                                     ,input ('obj' + string(ii, '999'))
     1958                                                     ,input 'oname'
     1959                                                     ,output v-value) no-error .
     1960             if v-value = ? then next _ii.
     1961             assign
     1962             v-obj-num = ii
     1963             v-obj-name = v-value
     1964             .
     1965             run alienini-getkey in this-procedure (
     1966                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1967                                                     ,input ('obj' + string(ii, '999'))
     1968                                                     ,input 'size'
     1969                                                     ,output v-value) no-error .
     1970             assign
     1971             v-num-records = integer(v-value) no-error  .
     1972             if error-status:error
     1973             or v-num-records = 0 then next _ii.
     1974             run alienini-getkey in this-procedure (
     1975                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1976                                                     ,input 'obj' + string(ii, '999')
     1977                                                     ,input 'f000'
     1978                                                     ,output v-value) no-error .
     1979             assign
     1980             v-size_ = integer(v-value) no-error  .
     1981             if error-status:error
     1982             or v-size_ = 0 then next _ii.
     1983             _jj:
     1984             do jj = 1 to 256:
     1985               run alienini-getkey in this-procedure (
     1986                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1987                                                       ,input 'obj' + string(ii, '999')
     1988                                                       ,input 'f' + string(jj, '999')
     1989                                                       ,output v-value) no-error .
     1990               if v-value = ? then next _ii.
     1991               create buf_temp-tekka-schema.
     1992               assign
     1993               buf_temp-tekka-schema.host = 'tekka'
     1994               buf_temp-tekka-schema.obj-num = v-obj-num
     1995               buf_temp-tekka-schema.obj-name = v-obj-name
     1996               buf_temp-tekka-schema.num-records = v-num-records
     1997               buf_temp-tekka-schema.size_ = v-size_
     1998               buf_temp-tekka-schema.field-num = jj
     1999               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2000               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2001                                                  then entry(2, entry(2, v-value, '#'), ':')
     2002                                                  else '':U)
     2003               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2004               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2005               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2006                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2007               no-error
     2008               .
     2009               if error-status:error then do:
     2010                 delete buf_temp-tekka-schema.
     2011                 next _jj.
     2012               end.
     2013               run alienini-getkey in this-procedure (
     2014                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2015                                                       ,input 'obj' + string(ii, '999') + 'name'
     2016                                                       ,input 'n' + string(jj, '999')
     2017                                                       ,output v-value) no-error .
     2018               if v-value <> ? then
     2019               buf_temp-tekka-schema.field-name = v-value.
     2020             end.
     2021           end.
     2022         end.
     2023         ii-tekka = ii - 1.
     2024        if p-obj-list <> 'ALL' then do:
     2025         if ii-tekka <> ii-ibs then do:
     2026           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2027                                   , ii-ibs
     2028                                   , ii-tekka).
     2029         end.
     2030        end.
     2031        for each buf_temp-tekka-schema where
     2032               buf_temp-tekka-schema.host = 'tekka':
     2033          find first buf2_temp-tekka-schema where
     2034                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2035                AND buf2_temp-tekka-schema.host = 'ibs'
     2036                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2037          if not available buf2_temp-tekka-schema then do:
     2038           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2039                                   , buf_temp-tekka-schema.field-num
     2040                                   , buf_temp-tekka-schema.obj-num).
     2041          end.
     2042          buffer-compare buf_temp-tekka-schema
     2043          to buf2_temp-tekka-schema
     2044          save result in v-result.
     2045          if v-result <> '':U then do:
     2046           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2047                                   , buf_temp-tekka-schema.field-num
     2048                                   , buf_temp-tekka-schema.obj-num).
     2049          end.
     2050        end.
     2051     end.
     2052   end procedure.
     2053   FUNCTION set-Sx returns character (input p-string as character):
     2054   return p-string.
     2055   END FUNCTION.
     2056   FUNCTION get-Sx returns character (input p-string  as character):
     2057   return p-string.
     2058   END FUNCTION.
     2059   FUNCTION set-B returns character (input p-string  as character):
     2060   return chr(integer(p-string)).
     2061   END FUNCTION.
     2062   FUNCTION get-B returns character (input p-string  as character):
     2063   return string(asc(p-string)).
     2064   END FUNCTION.
     2065   FUNCTION set-BF returns character (input p-string  as character):
     2066   define variable v-dopi as integer no-undo .
     2067   define variable ii as integer no-undo .
     2068   do ii = 1 to 8:
     2069     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2070   end.
     2071   return chr(v-dopi).
     2072   END FUNCTION.
     2073   FUNCTION get-BF returns character (input p-string  as character):
     2074   define variable v-dopi as integer no-undo .
     2075   define variable v-dops as character no-undo .
     2076   define variable ii as integer no-undo .
     2077   v-dopi = asc(p-string).
     2078   do ii = 8 to 1 BY -1:
     2079     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2080   end.
     2081   return v-dops.
     2082   END FUNCTION.
     2083   FUNCTION set-BN returns character (input p-string  as character
     2084                                     ,input p-bin-group as character):
     2085   define variable v-dopi as integer no-undo .
     2086   define variable ii as integer no-undo .
     2087   define variable jj as integer no-undo .
     2088   define variable v-grp-nums as integer no-undo .
     2089   define variable v-dopi2 as integer no-undo .
     2090   v-grp-nums = num-entries(p-bin-group).
     2091   do jj = 0 to v-grp-nums - 1:
     2092     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2093     do ii = 1 to 8:
     2094       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2095     end.
     2096   end.
     2097   return chr(v-dopi).
     2098   END FUNCTION.
     2099   FUNCTION get-BN returns character (input p-string  as character
     2100                                     ,input p-bin-group as character):
     2101   define variable v-dopi as integer no-undo .
     2102   define variable v-dops as character no-undo .
     2103   define variable v-grp-nums as integer no-undo .
     2104   define variable ii as integer no-undo .
     2105   define variable jj as integer no-undo .
     2106   v-dopi = asc(p-string).
     2107   v-grp-nums = num-entries(p-bin-group).
     2108   do jj = 1 to v-grp-nums:
     2109   do ii = 8 to 1 BY -1:
     2110     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2111   end.
     2112   end.
     2113   return v-dops.
     2114   END FUNCTION.
     2115   procedure fill-temp-cd :
     2116   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2117   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2118   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2119   define input parameter p-clear-table as logical no-undo .
     2120   define buffer buf_temp-cd for temp-cd.
     2121   define buffer buf_cash-desk for ub.cash-desk.
     2122     do
     2123     on error undo, return error
     2124     :
     2125        if p-clear-table  then do:
     2126          for each buf_temp-cd:
     2127            delete buf_temp-cd.
     2128          end.
     2129        end.
     2130        for each buf_cash-desk no-lock where
     2131               buf_cash-desk.db-num = p-db-num
     2132           AND buf_cash-desk.obj-code = p-obj-code
     2133           and buf_cash-desk.cash-on  = yes
     2134        BREAK by buf_cash-desk.pos-type:
     2135          if first-of(buf_cash-desk.pos-type) then do:
     2136            create buf_temp-cd.
     2137            buffer-copy buf_cash-desk to buf_temp-cd.
     2138          end.
     2139        end.
     2140     end.
     2141   end procedure.
     2142   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2143   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2144   procedure cp-attr-code :
     2145     do
     2146     on error undo, return error
     2147     :
     2148       define input  parameter p-code           as character no-undo .
     2149       define output parameter p-type           as character no-undo .
     2150       define output parameter p-format         as character no-undo .
     2151       define output parameter p-label          as character no-undo .
     2152       define output parameter p-range          as integer   no-undo .
     2153       define output parameter p-user-can-edit  as logical   no-undo .
     2154       define output parameter p-output-display as logical   no-undo .
     2155       define output parameter p-other          as character no-undo .
     2156       case p-code :
     2157               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2158               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     2159               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     2160               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     2161               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2162               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2163               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2164               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2165               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2166               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2167         otherwise do:
     2168           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     2169         end.
     2170       end.
     2171     end.
     2172   end procedure.
