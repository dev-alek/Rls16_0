     2270         (input  p-code
     2271         ,output v-type
     2272         ,output v-format
     2273         ,output v-label
     2274         ,output v-range
     2275         ,output v-user-can-edit
     2276         ,output v-output-display
     2277         ,output v-other
     2278         ) no-error .
     2279       if error-status :error then do:
     2280         undo, return error return-value .
     2281       end.
     2282       find first buf_cash-pay-attr exclusive-lock
     2283         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2284           and buf_cash-pay-attr.curr-code  = p-curr-code
     2285           and buf_cash-pay-attr.host-code  = p-host-code
     2286           and buf_cash-pay-attr.obj-type   = p-obj-type
     2287           and buf_cash-pay-attr.obj-code   = p-obj-code
     2288           and buf_cash-pay-attr.attr-code = p-code
     2289         no-error .
     2290       if not available buf_cash-pay-attr then do:
     2291         create buf_cash-pay-attr .
     2292         assign
     2293         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2294         buf_cash-pay-attr.curr-code  = p-curr-code
     2295         buf_cash-pay-attr.host-code  = p-host-code
     2296         buf_cash-pay-attr.obj-type   = p-obj-type
     2297         buf_cash-pay-attr.obj-code   = p-obj-code
     2298         buf_cash-pay-attr.attr-code = p-code
     2299         .
     2300       end.
     2301       assign
     2302         buf_cash-pay-attr.attr-value = p-value
     2303       .
     2304       release buf_cash-pay-attr no-error .
     2305       if error-status:error then do:
     2306         undo, return error return-value .
     2307       end.
     2308     end.
     2309   end procedure.
