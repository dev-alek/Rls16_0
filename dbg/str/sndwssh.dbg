     2355   procedure cp-attr-delete :
     2356     do
     2357     on error undo, return error
     2358     :
     2359       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2360       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
