     2450   define variable ii     as integer      no-undo.
     2451   define variable v-prod-bc    as character    no-undo.
     2452   define buffer buf_wth-ser   for ub.wth-ser.
     2453   define buffer buf_snd-wth-gds   for ub.wth-gds.
     2454   define buffer buf_snd-wth-par   for ub.wth-par.
     2455   define buffer buf_snd-cash-pay    for ub.cash-pay.
     2456   FUNCTION pet-code RETURNS CHARACTER
     2457     ( INPUT p-gds-code AS INTEGER ) :
     2458     DEFINE VARIABLE main-b-code LIKE ub.bar-code.b-code NO-UNDO.
     2459     DEFINE VARIABLE l-is-petrol-code AS LOGICAL NO-UNDO.
     2460     DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     2461     if p-gds-code = 0 then return "":U.
     2462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2463     (input  p-gds-code
     2464     ,input  ?
     2465     ,output main-b-code
     2466     ) NO-ERROR .
     2467     IF ERROR-STATUS:ERROR THEN RETURN "":U.
     2468     FOR EACH buf_prod-bc NO-LOCK WHERE
     2469             buf_prod-bc.b-code = main-b-code:
     2470   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2472     (buffer buf_prod-bc
     2473     ,input  'petrolium=request'
     2474     ,output l-is-petrol-code
     2475     ) NO-ERROR .
     2476       IF l-is-petrol-code THEN RETURN buf_prod-bc.b-str.
     2477     END.
     2478     RETURN "".
     2479   END FUNCTION.
     2480   FIND ub.shop WHERE ub.shop.obj-code = i-obj-code NO-LOCK .
     2481   FIND ub.sysconf WHERE ub.sysconf.host-code = ub.shop.host-code NO-LOCK .
     2482   run write-log-and-file in p-log-handle (
     2483             input 1
     2484           , input log-file-name
     2485           , input 1
     2486           , input substitute("Пересылка на кассы &1&2 масок МЦ", 'маг':U, i-obj-code)
     2487                                                 ).
     2488   if v-ser-list-code = '' then do:
     2489     fe-block: for each buf_wth-ser no-lock:
     2490             find first buf_snd-wth-gds no-lock where
     2491                     buf_snd-wth-gds.wth-code = buf_wth-ser.wth-code no-error.
     2492           if not available buf_snd-wth-gds then do:
     2493           run write-log-and-file in p-log-handle (
     2494               input 1
     2495             , input log-file-name
     2496             , input 1
     2497             , input substitute("Не найдена связка с товарами для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series )
     2498                                                  ).
     2499             next fe-block.
     2500           end.
     2501           find first buf_snd-wth-par no-lock where
     2502                      buf_snd-wth-par.par-code = buf_wth-ser.par-code no-error.
     2503           if not available buf_snd-wth-par then do:
     2504           run write-log-and-file in p-log-handle (
     2505               input 1
     2506             , input log-file-name
     2507             , input 1
     2508             , input substitute("Не найден номинал &3 для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series,buf_wth-ser.par-code )
     2509                                                  ).
     2510             next fe-block.
     2511           end.
     2512           find first buf_snd-cash-pay no-lock where
     2513                      buf_snd-cash-pay.wth-code = buf_wth-ser.wth-code no-error.
     2514           if not available buf_snd-cash-pay then do:
     2515           run write-log-and-file in p-log-handle (
     2516               input 1
     2517             , input log-file-name
     2518             , input 1
     2519             , input substitute("Не найден тип платежа для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series)
     2520                                                  ).
     2521             next fe-block.
     2522           end.
     2523           v-prod-bc = pet-code(buf_snd-wth-gds.gds-code).
     2524           if v-prod-bc > '' then.
     2525           else do:
     2526             run write-log-and-file in p-log-handle (
     2527                 input 1
     2528               , input log-file-name
     2529               , input 1
     2530               , input substitute("Не определен короткий код для товара &3 (МЦ &1 серия &2) ", buf_wth-ser.wth-code, buf_wth-ser.series,buf_snd-wth-gds.gds-code)
     2531                                                   ).
     2532               next fe-block.
     2533           end.
     2534       RUN SENDING in this-procedure  no-error.
     2535       if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     2536     end.
     2537   end.
     2538   else ii-block:  DO ii = 1 to NUM-ENTRIES(v-ser-list-code):
     2539         FIND FIRST buf_wth-ser No-LOCK WHERE
     2540                   recid(buf_wth-ser) = integer(entry(ii, v-ser-list-code)) No-ERROR.
     2541         IF avail buf_wth-ser then do:
     2542           find first buf_snd-wth-gds no-lock where
     2543                     buf_snd-wth-gds.wth-code = buf_wth-ser.wth-code no-error.
     2544           if not available buf_snd-wth-gds then do:
     2545           run write-log-and-file in p-log-handle (
     2546               input 1
     2547             , input log-file-name
     2548             , input 1
     2549             , input substitute("Не найдена связка с товарами для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series )
     2550                                                  ).
     2551             next ii-block.
     2552           end.
     2553           find first buf_snd-wth-par no-lock where
     2554                      buf_snd-wth-par.par-code = buf_wth-ser.par-code no-error.
     2555           if not available buf_snd-wth-par then do:
     2556           run write-log-and-file in p-log-handle (
     2557               input 1
     2558             , input log-file-name
     2559             , input 1
     2560             , input substitute("Не найден номинал &3 для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series,buf_wth-ser.par-code )
     2561                                                  ).
     2562             next ii-block.
     2563           end.
     2564           find first buf_snd-cash-pay no-lock where
     2565                      buf_snd-cash-pay.wth-code = buf_wth-ser.wth-code no-error.
     2566           if not available buf_snd-cash-pay then do:
     2567           run write-log-and-file in p-log-handle (
     2568               input 1
     2569             , input log-file-name
     2570             , input 1
     2571             , input substitute("Не найден тип платежа для МЦ &1, серия &2 ", buf_wth-ser.wth-code, buf_wth-ser.series)
     2572                                                  ).
     2573             next ii-block.
     2574           end.
     2575           v-prod-bc = pet-code(buf_snd-wth-gds.gds-code).
     2576           if v-prod-bc > '' then.
     2577           else do:
     2578             run write-log-and-file in p-log-handle (
     2579                 input 1
     2580               , input log-file-name
     2581               , input 1
     2582               , input substitute("Не определен короткий код для товара &3 (МЦ &1 серия &2) ", buf_wth-ser.wth-code, buf_wth-ser.series,buf_snd-wth-gds.gds-code)
     2583                                                   ).
     2584               next ii-block.
     2585           end.
     2586           RUN SENDING in this-procedure  no-error.
     2587          if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     2588         end.
     2589   END.
     2590   .
     2591   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2592   PROCEDURE putc-ws.
     2593   define input parameter pos-type   as character no-undo.
     2594   define input parameter p-version  as character no-undo .
     2595   define variable v-version-dec as decimal no-undo .
     2596   define variable v-ii as integer no-undo .
     2597   CASE pos-type:
     2598     when 'IBM-XML':U  then do:
     2599       assign
     2600       v-version-dec = decimal(p-version) no-error .
     2601       if v-version-dec >= 1.05 then do:
     2602         run bgelib-tag-open in this-procedure ( input 2, input "MaskPayMeans"
     2603                                               , input substitute("ctrl='&1' tms='&2' code='&3'"
     2604                                                                 ,(if action = "U"
     2605                                                                   then "ADD":U
     2606                                                                   else "DEL":U)                                                              , OS2-time
     2607                                                                 , buf_wth-ser.db-num * 10000000 + buf_wth-ser.ser-code
     2608                                                                 )).
     2609         run bgelib-tag-put in this-procedure ( input 3, input "MPCoup"  , input buf_wth-ser.maska , input 1 ).
     2610         run bgelib-tag-put in this-procedure ( input 3, input "MPMName"  , input string(buf_wth-ser.series,"x(20)":U) , input 1 ).
     2611         run bgelib-tag-open in this-procedure ( input 3
     2612                                                 , input "MPProp"
     2613                                                 , input '':U      ).
     2614         run bgelib-tag-put in this-procedure ( input 4, input "MPAuthorize"  , input buf_wth-ser.authr , input 1 ).
     2615         run bgelib-tag-close in this-procedure ( input 3, input "MPProp").
     2616         run bgelib-tag-open in this-procedure ( input 3
     2617                                                 , input "MPMark"
     2618                                                 , input '':U      ).
     2619         run bgelib-tag-put in this-procedure ( input 4, input "MPMCode"  , input v-prod-bc , input 1 ).
     2620         run bgelib-tag-close in this-procedure ( input 3, input "MPMark").
     2621         run bgelib-tag-put in this-procedure ( input 3, input "MPCoupType"  , input 0 , input 1 ).
     2622         run bgelib-tag-put in this-procedure ( input 3, input "MPCoupValue"  , input buf_snd-wth-par.par-val , input 1 ).
     2623         run bgelib-tag-put in this-procedure ( input 3, input "MPPayCode"  , input buf_snd-cash-pay.cdpay-code , input 1 ).
     2624         if buf_wth-ser.chk-bdt = 2 then do:
     2625           run bgelib-tag-put in this-procedure ( input 3, input "MPDateStartYY"  , input substring(string(year(buf_wth-ser.beg-dt)),3,2) , input 0 ).
     2626           run bgelib-tag-put in this-procedure ( input 3, input "MPDateStartMM"  , input string(month(buf_wth-ser.beg-dt)) , input 0 ).
     2627           run bgelib-tag-put in this-procedure ( input 3, input "MPDateStartDD"  , input string(day(buf_wth-ser.beg-dt)) , input 0 ).
     2628         end.
     2629         if buf_wth-ser.chk-edt = 2 then do:
     2630           run bgelib-tag-put in this-procedure ( input 3, input "MPDateEndYY"  , input substring(string(year(buf_wth-ser.end-dt)),3,2) , input 0 ).
     2631           run bgelib-tag-put in this-procedure ( input 3, input "MPDateEndMM"  , input string(month(buf_wth-ser.end-dt)) , input 0 ).
     2632           run bgelib-tag-put in this-procedure ( input 3, input "MPDateEndDD"  , input string(day(buf_wth-ser.end-dt)) , input 0 ).
     2633         end.
     2634         run bgelib-tag-put in this-procedure ( input 3, input "MPLock"  , if buf_wth-ser.stts = 0 then 0 else 1 , input 1 ).
     2635         run bgelib-tag-close in this-procedure ( input 2, input "MaskPayMeans").
     2636      end.
     2637     end.
     2638   END CASE .
     2639   END PROCEDURE .
     2640   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2641   PROCEDURE   for-cash-cycle:
     2642   DEFINE VARIABLE fname-list as character no-undo .
     2643   DEFINE VARIABLE out-list as character no-undo .
     2644   DEFINE VARIABLE var-file-num as integer no-undo .
     2645   DEFINE VARIABLE v-dir-remote as character no-undo .
     2646   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2647   define buffer for-cash-desk for ub.cash-desk.
     2648   FOR EACH for-cash-desk NO-LOCK WHERE
     2649           for-cash-desk.db-num = g#db-num AND
     2650           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2651           for-cash-desk.obj-code = i-obj-code AND
     2652           for-cash-desk.cash-on  = yes
     2653   BREAK
     2654   BY for-cash-desk.db-num
     2655   BY for-cash-desk.obj-code
     2656   BY for-cash-desk.pos-type
     2657   BY for-cash-desk.cash-on:
     2658     run write-log-and-file in p-log-handle (
     2659           input 1
     2660         , input log-file-name
     2661         , input 1
     2662         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2663                           )
     2664                                           ).
     2665   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2666   case for-cash-desk.pos-type:
     2667       when 'IBM-XML':U or when 'Autotank':U
     2668     then do:
     2669   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2670   run xml-cd-filename in this-procedure (
     2671         input out
     2672       , output v-xml-file-name
     2673       , output v-xml-file-name-path
     2674       , output v-log-file-name
     2675       , output v-locked
     2676   ).
     2677   run write-log-and-file in p-log-handle (
     2678         input 1
     2679       , input log-file-name
     2680       , input 1
     2681       , input substitute( ("''" + " &1")
     2682                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2683                         )
     2684                                         ).
     2685   run write-log-and-file in p-log-handle (
     2686         input 1
     2687       , input log-file-name
     2688       , input 1
     2689       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2690                                         ).
     2691   assign
     2692   v-obj-list = 'маг':U + string(i-obj-code)
     2693   .
     2694   run xml-cd-write-header in this-procedure (
     2695         input v-xml-file-name
     2696       , input v-xml-file-name-path
     2697       , input 'data'
     2698       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2699       , input v-obj-list
     2700       , input (
     2701                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2702                   then (if for-cash-desk.autonomy = integer('0':U)
     2703                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2704                         else ("КМ"   )
     2705                         )
     2706                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2707                   )
     2708               )
     2709       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2710   ).
     2711   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2712   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2713     end.
     2714   END CASE.
     2715     RUN putc-ws  in this-procedure ( input for-cash-desk.pos-type
     2716                                     , input for-cash-desk.version
     2717                                     ) no-error .
     2718     if error-status:error then do:
     2719       assign
     2720       v-view-log = yes.
     2721       run write-log-and-file in p-log-handle (
     2722             input 1
     2723           , input log-file-name
     2724           , input 1
     2725           , input "!Ошибка при пересылке на кассу: " + (if return-value <> "":U then return-value else "":U)
     2726                                             ).
     2727     end.
     2728   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2729   case for-cash-desk.pos-type:
     2730       when 'IBM-XML':U or when 'Autotank':U
     2731     then do:
     2732   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2733   output stream stmxmlout close.
     2734   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2735       , input 'data'
     2736   ).
     2737   run write-log-and-file in p-log-handle (
     2738         input 1
     2739       , input log-file-name
     2740       , input 1
     2741       , input substitute( "Данные выгружены в файл &1"
     2742                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2743                         )
     2744                                          ).
     2745   if (
     2746   not (g#news or g#auto or g#esys )
     2747   or
     2748   (
     2749   for-cash-desk.pos-type = 'MAGIA-XML':U
     2750   or
     2751     (for-cash-desk.pos-type = 'IBM-XML':U
     2752   or (for-cash-desk.pos-type = 'Autotank':U
     2753     and
     2754     for-cash-desk.autonomy = integer('2':U))
     2755     )))
     2756   then do:
     2757     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2758     end.
     2759     if (for-cash-desk.pos-type = 'IBM-XML':U
     2760     and for-cash-desk.autonomy = integer('0':U))
     2761     or (for-cash-desk.pos-type = 'Autotank':U
     2762     and for-cash-desk.autonomy = integer('2':U))
     2763     then do:
     2764       run str/post-xml.p
     2765         (
     2766          input parparentproc
     2767         ,input p-parent-handle
     2768         ,input p-log-handle
     2769         ,input g#news or g#esys
     2770         ,input g#auto
     2771         ,input 'send'
     2772         ,input log-file-name
     2773         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2774         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2775         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2776         ,input 30
     2777         ,input   ( if action = 'U'
     2778                     then ('Ждите - ' + 'добавление маски МЦ ')
     2779                     else ('Ждите - ' + 'удаление маски МЦ ') ) +
     2780                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2781         ) no-error .
     2782       if error-status:error
     2783       or return-value = "error" then do:
     2784         run write-log-and-file in p-log-handle (
     2785               input 1
     2786             , input log-file-name
     2787             , input 1
     2788             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2789                                   ,for-cash-desk.obj-code
     2790                                   ,for-cash-desk.cash-num
     2791                                   , chr(10)
     2792                                   , error-status:get-message(1)
     2793                                   , return-value
     2794                               )
     2795                                               ).
     2796         assign
     2797         v-view-log = yes
     2798         .
     2799       end.
     2800     end.
     2801     if not available ub.shop then do:
     2802       find first ub.shop no-lock where
     2803                 ub.shop.obj-code = for-cash-desk.obj-code.
     2804     end.
     2805     if
     2806     not (g#news or g#esys)
     2807     then do:
     2808       run str/getxibmf.p (
     2809                       input parparentproc
     2810                     ,input p-log-handle
     2811                     ,input 'маг':U
     2812                     ,input for-cash-desk.obj-code
     2813                     ,input ub.shop.host-code
     2814                     ,input in_
     2815                     ,input spl
     2816                     ,input (in_ + sav)
     2817                     ,input for-cash-desk.pos-type
     2818                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2819                             and for-cash-desk.autonomy = integer('0':U))
     2820                             or (for-cash-desk.pos-type = 'Autotank':U
     2821                             and for-cash-desk.autonomy = integer('2':U))
     2822                             then "utf-8":U
     2823                             else "windows-1251")
     2824                     ,input log-file-name
     2825                     ,input "data":U
     2826                     ,input v-xml-file-name
     2827                     ,input-output v-view-log
     2828                     ) no-error .
     2829       if error-status:error then do:
     2830         run write-log-and-file in p-log-handle (
     2831               input 1
     2832             , input log-file-name
     2833             , input 1
     2834             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2835                                   ,for-cash-desk.obj-code
     2836                                   ,for-cash-desk.cash-num
     2837                               )
     2838                                               ).
     2839         assign
     2840         v-view-log = yes
     2841         .
     2842       end.
     2843     end.
     2844   end.
     2845   if g#news
     2846   or g#auto
     2847   or g#esys
     2848   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2849   then do:
     2850   end.
     2851     end.
     2852   END CASE.
     2853   END .
     2854   END PROCEDURE.
     2855   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2856   PROCEDURE SENDING:
     2857   DEFINE VARIABLE fq as integer no-undo .
     2858   define variable glog as logical no-undo .
     2859   FOR EACH ub.cash-desk NO-LOCK WHERE
     2860           ub.cash-desk.db-num = g#db-num AND
     2861            ub.cash-desk.obj-code = i-obj-code AND
     2862           ub.cash-desk.cash-on   AND
     2863           ub.cash-desk.pos-type = 'IBM-XML':U
     2864   BREAK
     2865   By ub.cash-desk.pos-type :
     2866     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2867   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2868   define variable dflt-cd18 as character no-undo .
     2869   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2870   define variable v-param-type19 as character no-undo .
     2871   define variable v-value-date19 as date no-undo .
     2872   define variable v-value-decimal19 as decimal no-undo .
     2873   define variable v-value-integer19 as INTEGER no-undo .
     2874   define variable v-value-logical19 AS LOGICAL no-undo .
     2875   define variable v-tth19 as handle no-undo .
     2876   run adm/shattri.p (
     2877       input "get":U
     2878       ,input  'маг':U
     2879       ,input  ub.cash-desk.obj-code
     2880       ,input  'cd-sending':U
     2881       ,input  'dflt-cd':U
     2882       ,output dflt-cd18
     2883       ,output v-value-date19
     2884       ,output v-value-decimal19
     2885       ,output v-value-integer19
     2886       ,output v-value-logical19
     2887       ,output v-param-type19
     2888       ,INPUT-OUTPUT table-handle v-tth19
     2889       ) no-error .
     2890   delete object v-tth19 no-error.
     2891   case ub.cash-desk.pos-type:
     2892       when 'IBM-XML':U or when 'Autotank':U
     2893     then do:
     2894   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2895   run str/get-inis.p (
     2896                   input 'маг':U
     2897                 , input ub.cash-desk.obj-code
     2898                 , input ub.cash-desk.pos-type
     2899                 , input cash-desk.remote
     2900                 , input "send":U
     2901                 , output out
     2902                 , output out2
     2903                 , output in_
     2904                 , output spl
     2905                 , output sav
     2906                 , output v-remote
     2907                 )  no-error .
     2908   if error-status:error then do:
     2909     run write-log-and-file in p-log-handle (
     2910           input 1
     2911         , input log-file-name
     2912         , input 1
     2913         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2914                             , ub.cash-desk.pos-type
     2915                             , ub.cash-desk.obj-code
     2916                             , chr(10)
     2917                             , error-status:get-message(1)
     2918                             , return-value )).
     2919     assign
     2920     v-view-log = yes.
     2921     return error.
     2922   end.
     2923   if ub.cash-desk.pos-type = 'IBM-XML':U
     2924   or ub.cash-desk.pos-type = 'Autotank':U
     2925   then do:
     2926     file-info:file-name = (out  + "undelivered").
     2927     if file-info:FULL-PATHNAME <> ? then do:
     2928       run str/rsndxibm.p ( input parparentproc
     2929                           ,input p-parent-handle
     2930                           ,input p-log-handle
     2931                           ,input out  + "undelivered" ) no-error.
     2932     end.
     2933   end.
     2934     end.
     2935   END CASE.
     2936       RUN for-cash-cycle in this-procedure  no-error.
     2937     END.
     2938     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2939   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   case ub.cash-desk.pos-type:
     2941   END CASE.
     2942     END.
     2943   END.
     2944   END PROCEDURE.
