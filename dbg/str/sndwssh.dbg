     1430   procedure alienini-getkey :
     1431   define input parameter i-filename as char.
     1432   define input parameter i-section as char.
     1433   define input parameter i-key as char.
     1434   define output parameter o-value as char.
     1435   define variable EntryPointer as integer no-undo.
     1436   define variable mem1 as memptr no-undo.
     1437   define variable mem2 as memptr no-undo.
     1438   define variable mem1size as integer no-undo.
     1439   define variable mem2size as integer no-undo.
     1440   define variable ii       as integer    no-undo.
     1441   define variable cbReturnSize  as integer    no-undo.
     1442   assign
     1443   set-size(mem1)  = 4000
     1444   mem1size = 4000.
     1445   if i-key = "" then EntryPointer = 0.
     1446   else do:
     1447     assign
     1448     set-size(mem2) = 128
     1449     mem2size = 128
     1450     EntryPointer = get-pointer-value(mem2)
     1451     put-string(mem2, 1) = i-key.
     1452   end.
     1453   run getprivateprofilestringA
     1454                                 (i-section,
     1455                                  EntryPointer,
     1456                                  "",
     1457                                  get-pointer-value(mem1),
     1458                                  input mem1size,
     1459                                  i-filename,
     1460                                  output cbReturnSize).
     1461   do ii = 1 to cbReturnSize:
     1462     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1463                  then o-value + ","
     1464                  else o-value + chr(get-byte(mem1, ii)).
     1465   end.
     1466     set-size(mem1) = 0.
     1467     set-size(mem2) = 0.
     1468   end procedure.
     1469   procedure alienini-putkey :
     1470   define input parameter i-filename as char.
     1471   define input parameter i-section as char.
     1472   define input parameter i-key as char.
     1473   define input parameter i-value as char.
     1474   define variable cbReturnSize as integer.
     1475   run writeprivateprofilestringA
     1476                                  (i-section,
     1477                                   i-key,
     1478                                   i-value,
     1479                                   i-filename,
     1480                                   output cbReturnSize ).
     1481   end procedure.
     1482   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1483     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1484     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1485     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1486     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1487     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1488     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1489     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1490   END PROCEDURE.
     1491   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1492     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1493     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1494     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1495     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1496     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1497   END PROCEDURE.
