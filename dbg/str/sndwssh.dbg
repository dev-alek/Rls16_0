     2197   procedure cp-attr-value :
     2198     do
     2199     on error undo, return error
     2200     :
     2201       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2202       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2203       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2204       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2205       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2206       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     2207       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     2208       define output parameter p-type        as character no-undo .
     2209       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2210       define variable v-format         as character no-undo .
     2211       define variable v-label          as character no-undo .
     2212       define variable v-range          as integer   no-undo .
     2213       define variable v-user-can-edit  as logical   no-undo .
     2214       define variable v-output-display as logical   no-undo .
     2215       define variable v-other          as character no-undo .
     2216       run cp-attr-code in this-procedure
     2217         (input  p-code
     2218         ,output p-type
     2219         ,output v-format
     2220         ,output v-label
     2221         ,output v-range
     2222         ,output v-user-can-edit
     2223         ,output v-output-display
     2224         ,output v-other
     2225         ) no-error .
     2226       if error-status :error then do:
     2227         undo, return error return-value .
     2228       end.
     2229       find first buf_cash-pay-attr no-lock
     2230         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2231           and buf_cash-pay-attr.curr-code  = p-curr-code
     2232           and buf_cash-pay-attr.host-code  = p-host-code
     2233           and buf_cash-pay-attr.obj-type   = p-obj-type
     2234           and buf_cash-pay-attr.obj-code   = p-obj-code
     2235           and buf_cash-pay-attr.attr-code  = p-code
     2236         no-error .
     2237       if avail buf_cash-pay-attr then do:
     2238         assign
     2239           p-value =  buf_cash-pay-attr.attr-value
     2240         .
     2241       end.
     2242       else do:
     2243         assign
     2244           p-value = if p-type = 'L':U then "no":U else ""
     2245         .
     2246       end.
     2247     end.
     2248   end procedure.
     2249   procedure cp-attr-write :
     2250     do
     2251     on error undo, return error
     2252     :
     2253       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2254       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2255       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2256       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2257       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2258       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2259       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2260       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2261       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2262       define variable v-type           as character no-undo .
     2263       define variable v-format         as character no-undo .
     2264       define variable v-label          as character no-undo .
     2265       define variable v-range          as integer   no-undo .
