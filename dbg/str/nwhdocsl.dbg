        1   define input-output parameter v-select-doc-type as character no-undo .
        2   define input-output parameter v-select-doc-code as character no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Выбрать документ истории документов пришедших по новостям".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define temp-table temp-doc-code no-undo
      124     field temp-doc-type as character format "X(12)" label "Тип Документа"
      125     field temp-doc-code as character format "X(14)" label "Номер"
      126     index xpk is primary temp-doc-type temp-doc-code
      127   .
      128   DEFINE BUTTON b-cancel AUTO-END-KEY
      129        LABEL "&Отмена"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON b-help
      133        LABEL "Помо&щь"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-sel AUTO-GO
      137        LABEL "&Выбор"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE QUERY BROWSE-1 FOR
      141         temp-doc-code SCROLLING.
      142   DEFINE BROWSE BROWSE-1
      143     QUERY BROWSE-1 DISPLAY
      144         temp-doc-code.temp-doc-type
      145         temp-doc-code.temp-doc-code
      146       WITH NO-ROW-MARKERS SEPARATORS SIZE 33.25 BY 14.17.
      147   DEFINE FRAME Dialog-Frame
      148        b-sel AT ROW 1 COL 1
      149        b-cancel AT ROW 1 COL 11
      150        b-help AT ROW 1 COL 21
      151        BROWSE-1 AT ROW 2.42 COL 2.88
      152        SPACE(5.49) SKIP(0.61)
      153       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      154            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      155            TITLE "Документы"
      156            DEFAULT-BUTTON b-sel.
      157   ASSIGN
      158          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      159          FRAME Dialog-Frame:HIDDEN           = TRUE.
      160   ON GO OF FRAME Dialog-Frame
      161   DO:
      162     if available temp-doc-code
      163     then do:
      164       assign
      165         v-select-doc-type = temp-doc-code.temp-doc-type
      166         v-select-doc-code = temp-doc-code.temp-doc-code
      167       .
      168     end.
      169     else do:
      170       assign
      171         v-select-doc-type = ""
      172         v-select-doc-code = ""
      173       .
      174     end.
      175   END.
      176   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      177   DO:
      178     APPLY "END-ERROR":U TO SELF.
      179   END.
      180   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      181   DO:
      182     apply 'go':u to frame Dialog-Frame .
      183   END.
      184   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      185   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      186   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   on help of frame Dialog-Frame
      188   do:
      189     run gbl/app_help.p
      190       (input this-procedure :file-name
      191       ,input ''
      192       ,input ?
      193       ) no-error.
      194     if error-status :error then do:
      195       message
      196         "Ошибка при вызове помощи"
      197         error-status :get-message(1)
      198         view-as alert-box .
      199     end.
      200   end.
      201   run minbtn-set in this-procedure .
      202   on choose of b-help in frame Dialog-Frame
      203   do:
      204     apply "help":u to frame Dialog-Frame .
      205   end.
      206   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   procedure minbtn-set :
      208       do
      209           on error undo, return error return-value
      210           :
      211           define variable ii              as integer       no-undo .
      212           define variable fh              as widget-handle no-undo .
      213           define variable hh              as widget-handle no-undo .
      214           define variable v-h             as handle        extent 4 no-undo .
      215           define variable v-name-button   as character     no-undo .
      216           define variable v-help-old-x    as decimal       no-undo .
      217           define variable v-help-old-y    as decimal       no-undo .
      218           define variable v-help-old-size as decimal       no-undo .
      219           define variable v-frame-width   as decimal       no-undo .
      220           define variable jj              as integer       no-undo .
      221           do
      222               on error undo, return error
      223               :
      224               assign
      225                   v-frame-width = frame Dialog-Frame:width - 0.3
      226                   fh            = frame Dialog-Frame:first-child
      227                   hh            = fh:first-child
      228                   ii            = 1
      229                   .
      230               do while valid-handle(hh):
      231                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      232                   do:
      233                       case lc(hh:name) :
      234                           when "b-help" then
      235                               do:
      236                                   hh:load-image-up("cmp/b-help.bmp":u) .
      237                                   hh:load-image-down("cmp/b-help.bmp":u) .
      238                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      239                                   hh:TOOLTIP = "Помощь" .
      240                                   v-help-old-x = hh:column .
      241                                   v-help-old-y = hh:row    .
      242                                   v-help-old-size = hh:width .
      243                                   hh:width-chars = 2.5 .
      244                               end.
      245                           when "b-print" then
      246                               do:
      247                                   hh:load-image("cmp/b-print.bmp":u) .
      248                                   hh:TOOLTIP = "Печать" .
      249                                   v-h[ii] = hh:handle .
      250                                   ii = ii + 1 .
      251                                   hh:width-chars = 3 .
      252                               end.
      253                           when "b-history" or
      254                           when "b-hist" then
      255                               do:
      256                                   hh:load-image("cmp/b-hist.bmp":u) .
      257                                   hh:TOOLTIP = "История" .
      258                                   v-h[ii] = hh:handle .
      259                                   ii = ii + 1 .
      260                                   hh:width-chars = 3 .
      261                               end.
      262                           when "b-sch" then
      263                               do:
      264                                   hh:load-image("cmp/b-sch.bmp":u) .
      265                                   hh:TOOLTIP = "Установка Фильтра" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-hist-user" then
      271                               do:
      272                                   hh:load-image("cmp/b-hist.bmp":u) .
      273                                   hh:TOOLTIP = "История пользователя" .
      274                                   ii = ii + 1 .
      275                               end.
      276                       end case.
      277                   end.
      278                   hh = hh:next-sibling.
      279               end.
      280               b-help:column = v-frame-width - b-help:width-chars.
      281               jj = 0.
      282               repeat ii = 4 to 1 by -1 :
      283                   if valid-handle (v-h[ii] ) then
      284                   do:
      285                       jj  = jj + 1 .
      286                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      287                       v-h[ii]:row    = v-help-old-y .
      288                   end.
      289               end.
      290           end.
      291       end.
      292   end procedure.
      293   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      294   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      295   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      296   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      297   define variable v-diasize-current-frame-width  as decimal   no-undo .
      298   define variable v-diasize-current-frame-height as decimal   no-undo .
      299   define variable v-diasize-change-size          as logical   no-undo .
      300   define variable v-diasize-resize-button        as handle    no-undo .
      301   define variable v-diasize-wndmax               as logical   no-undo .
      302   define variable v-diasize-wndstore             as logical   no-undo .
      303   define variable v-diasize-proc-name            as character no-undo .
      304   define variable v-diasize-browse-handle        as handle    no-undo .
      305   define variable v-diasize-browse-number        as integer   no-undo .
      306   define variable v-diasize-need-full-display    as logical   no-undo init false .
      307   define temp-table temp-diasize-handle no-undo
      308     field handle-value  as handle
      309     field save-position as decimal
      310     index xpk is primary unique handle-value
      311     .
      312   define temp-table temp-browse-handle no-undo
      313     field browse-type   as character
      314     field browse-number as integer
      315     field browse-handle as handle
      316     field original-size as decimal
      317     index xpk is primary unique browse-type browse-number
      318     index xie browse-type browse-handle
      319   .
      320   procedure diasize_change-height :
      321     define input  parameter p-change-value  as decimal   no-undo .
      322     define input  parameter p-move-resize   as logical   no-undo .
      323     define variable v-field-group-handle    as handle    no-undo .
      324     define variable v-object-handle         as handle    no-undo .
      325     define variable v-frame-height          as decimal   no-undo .
      326     define variable v-frame-virtual-height  as decimal   no-undo .
      327     define variable v-browse-height         as decimal   no-undo .
      328     define variable v-window-height         as decimal   no-undo .
      329     define variable v-window-virtual-height as decimal   no-undo .
      330     define variable v-change-sign           as integer   no-undo .
      331     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      332     define buffer buf_temp-browse-handle  for temp-browse-handle .
      333     if p-change-value > 0
      334     then do:
      335       if frame Dialog-Frame :height + p-change-value
      336           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      337       then do:
      338         assign
      339           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      340                           - (frame Dialog-Frame :height-chars)
      341         .
      342         if p-change-value <= 0
      343         then do:
      344           run diasize_position-resize-button in this-procedure .
      345           return .
      346         end.
      347       end.
      348     end.
      349     if p-change-value < 0
      350     then do:
      351       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      352       then do:
      353         assign
      354           p-change-value = v-diasize-orig-frame-height
      355                          - (frame Dialog-Frame :height-chars)
      356         .
      357         if p-change-value >= 0
      358         then do:
      359           run diasize_position-resize-button in this-procedure .
      360           return .
      361         end.
      362       end.
      363     end.
      364     if p-change-value >= 0
      365     then do:
      366       assign
      367         v-change-sign = 1
      368       .
      369     end.
      370     else do:
      371       assign
      372         v-change-sign = -1
      373       .
      374     end.
      375     assign
      376       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      377     .
      378     if p-change-value = 0
      379     then do:
      380       run diasize_position-resize-button in this-procedure .
      381       return .
      382     end.
      383     move_block:
      384     do
      385     on error undo move_block, retry move_block
      386     :
      387       if retry
      388       then do:
      389         do
      390         on error undo move_block, leave move_block
      391         :
      392           if p-change-value > 0
      393           then do:
      394             for each buf_temp-diasize-handle
      395             on error undo, next
      396             :
      397               assign
      398                 v-object-handle = buf_temp-diasize-handle.handle-value
      399               .
      400               if v-object-handle <> v-diasize-resize-button
      401               then do:
      402                 assign
      403                   v-object-handle :row = buf_temp-diasize-handle.save-position
      404                 .
      405               end.
      406             end.
      407             assign
      408               v-diasize-browse-handle :height = v-browse-height
      409             .
      410             for each buf_temp-browse-handle
      411               where buf_temp-browse-handle.browse-type = 'height':u
      412             on error undo, next
      413             :
      414               assign
      415                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      416               .
      417             end.
      418             assign
      419               frame Dialog-Frame :height = v-frame-height
      420             .
      421             if frame Dialog-Frame :scrollable = true
      422             then do:
      423               assign
      424                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      425               .
      426             end.
      427             run diasize_position-resize-button in this-procedure .
      428           end.
      429           else do:
      430             if frame Dialog-Frame :scrollable = true
      431             then do:
      432               assign
      433                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      434               .
      435             end.
      436             assign
      437               frame Dialog-Frame :height = v-frame-height
      438             .
      439             assign
      440               v-diasize-browse-handle :height = v-browse-height
      441             .
      442             for each buf_temp-browse-handle
      443               where buf_temp-browse-handle.browse-type = 'height':u
      444             on error undo, next
      445             :
      446               assign
      447                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      448               .
      449             end.
      450             for each buf_temp-diasize-handle
      451             on error undo, next
      452             :
      453               assign
      454                 v-object-handle = buf_temp-diasize-handle.handle-value
      455               .
      456               if v-object-handle <> v-diasize-resize-button
      457               then do:
      458                 assign
      459                   v-object-handle :row = buf_temp-diasize-handle.save-position
      460                 .
      461               end.
      462             end.
      463             run diasize_position-resize-button in this-procedure .
      464           end.
      465           assign
      466             v-diasize-change-size = false
      467           .
      468           leave move_block .
      469         end.
      470       end.
      471       assign
      472         v-diasize-need-full-display = true
      473       .
      474       if v-diasize-change-size = false
      475       then do:
      476         assign
      477           v-diasize-change-size = true
      478         .
      479       end.
      480       else do:
      481         return .
      482       end.
      483       assign
      484         v-frame-height = frame Dialog-Frame :height
      485         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      486         v-browse-height = v-diasize-browse-handle :height
      487       .
      488       for each buf_temp-browse-handle
      489         where buf_temp-browse-handle.browse-type = 'height':u
      490       :
      491         assign
      492           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      493         .
      494       end.
      495       for each buf_temp-diasize-handle
      496       :
      497         delete buf_temp-diasize-handle .
      498       end.
      499       assign
      500         v-field-group-handle = frame Dialog-Frame :first-child
      501       .
      502       do while valid-handle(v-field-group-handle)
      503       :
      504         assign
      505           v-object-handle = v-field-group-handle :first-child
      506         .
      507         do while valid-handle(v-object-handle)
      508         :
      509           if  v-object-handle <> v-diasize-browse-handle :handle
      510           and can-query(v-object-handle, "row")
      511           and can-query(v-object-handle, "height")
      512           and ( v-object-handle :row > v-diasize-browse-handle :row )
      513           then do:
      514             find first buf_temp-browse-handle
      515               where buf_temp-browse-handle.browse-type   = 'height':u
      516                 and buf_temp-browse-handle.browse-handle = v-object-handle
      517               no-error .
      518             if available buf_temp-browse-handle
      519             then do:
      520             end.
      521             else do:
      522               create buf_temp-diasize-handle .
      523               assign
      524                 buf_temp-diasize-handle.handle-value  = v-object-handle
      525                 buf_temp-diasize-handle.save-position = v-object-handle :row
      526               .
      527             end.
      528           end.
      529           assign
      530             v-object-handle = v-object-handle :next-sibling
      531           .
      532         end.
      533         assign
      534           v-field-group-handle = v-field-group-handle :next-sibling
      535         .
      536       end.
      537       do with frame Dialog-Frame
      538       :
      539         hide v-diasize-resize-button .
      540         assign
      541           v-diasize-resize-button :row    = 1
      542           v-diasize-resize-button :column = 1
      543         .
      544       end.
      545       if p-change-value > 0
      546       then do:
      547         if frame Dialog-Frame :scrollable = true
      548         then do:
      549           assign
      550             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      551             no-error .
      552           if error-status :error
      553           or error-status :get-message(1) <> ""
      554           then do:
      555             undo move_block, retry move_block .
      556           end.
      557         end.
      558         assign
      559           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      560           no-error .
      561         if error-status :error
      562         or error-status :get-message(1) <> ""
      563         then do:
      564           undo move_block, retry move_block .
      565         end.
      566         assign
      567           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      568           no-error .
      569         if error-status :error
      570         or error-status :get-message(1) <> ""
      571         then do:
      572           undo move_block, retry move_block .
      573         end.
      574         for each buf_temp-browse-handle
      575           where buf_temp-browse-handle.browse-type = 'height':u
      576         on error undo move_block, retry move_block
      577         :
      578           assign
      579             buf_temp-browse-handle.browse-handle :height
      580               = buf_temp-browse-handle.browse-handle :height + p-change-value
      581             no-error .
      582           if error-status :error
      583           or error-status :get-message(1) <> ""
      584           then do:
      585             undo move_block, retry move_block .
      586           end.
      587         end.
      588         for each buf_temp-diasize-handle
      589         on error undo move_block, retry move_block
      590         :
      591           assign
      592             v-object-handle = buf_temp-diasize-handle.handle-value
      593           .
      594           if v-object-handle <> v-diasize-resize-button
      595           then do:
      596             assign
      597               v-object-handle :row = v-object-handle :row + p-change-value
      598               no-error .
      599             if error-status :error
      600             or error-status :get-message(1) <> ""
      601             then do:
      602               undo move_block, retry move_block .
      603             end.
      604           end.
      605         end.
      606       end.
      607       else do:
      608         for each buf_temp-diasize-handle
      609         on error undo move_block, retry move_block
      610         :
      611           assign
      612             v-object-handle = buf_temp-diasize-handle.handle-value
      613           .
      614           if v-object-handle <> v-diasize-resize-button
      615           then do:
      616             assign
      617               v-object-handle :row = v-object-handle :row + p-change-value
      618               no-error .
      619             if error-status :error
      620             or error-status :get-message(1) <> ""
      621             then do:
      622               undo move_block, retry move_block .
      623             end.
      624           end.
      625         end.
      626         assign
      627           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      628           no-error .
      629         if error-status :error
      630         or error-status :get-message(1) <> ""
      631         then do:
      632           undo move_block, retry move_block .
      633         end.
      634         for each buf_temp-browse-handle
      635           where buf_temp-browse-handle.browse-type = 'height':u
      636         on error undo move_block, retry move_block
      637         :
      638           assign
      639             buf_temp-browse-handle.browse-handle :height
      640               = buf_temp-browse-handle.browse-handle :height + p-change-value
      641             no-error .
      642           if error-status :error
      643           or error-status :get-message(1) <> ""
      644           then do:
      645             undo move_block, retry move_block .
      646           end.
      647         end.
      648         assign
      649           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      650           no-error .
      651         if error-status :error
      652         or error-status :get-message(1) <> ""
      653         then do:
      654           undo move_block, retry move_block .
      655         end.
      656         if frame Dialog-Frame :scrollable = true
      657         then do:
      658           assign
      659             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      660             no-error .
      661           if error-status :error
      662           or error-status :get-message(1) <> ""
      663           then do:
      664             undo move_block, retry move_block .
      665           end.
      666         end.
      667       end.
      668       if p-move-resize = true
      669       then do:
      670         run diasize_position-resize-button in this-procedure .
      671       end.
      672       if v-diasize-wndstore = true
      673       then do:
      674         if connected("ub") = true
      675         then do:
      676           define variable v-cntxt-db-num        as integer   no-undo .
      677           define variable v-cntxt-userid        as character no-undo .
      678           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      679                                             , OUTPUT v-cntxt-userid
      680                                             ) .
      681           run gbl/wndsizew.p
      682             (input  v-cntxt-db-num
      683             ,input  v-cntxt-userid
      684             ,input  v-diasize-proc-name
      685             ,input  'height':u
      686             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      687             ) .
      688         end.
      689       end.
      690     end.
      691     assign
      692       v-diasize-change-size = false
      693     .
      694   end procedure.
      695   procedure diasize_set-height :
      696     define input  parameter p-new-height  as decimal   no-undo .
      697     define input  parameter p-move-resize as logical   no-undo .
      698     do
      699     on error undo, return error return-value
      700     :
      701       run diasize_change-height in this-procedure
      702         (input  (p-new-height - frame Dialog-Frame :height)
      703         ,input  p-move-resize
      704         ) .
      705     end.
      706   end procedure.
      707   procedure diasize_change-width :
      708     define input  parameter p-change-value as decimal   no-undo .
      709     define input  parameter p-move-resize  as logical   no-undo .
      710     define variable v-field-group-handle   as handle    no-undo .
      711     define variable v-object-handle        as handle    no-undo .
      712     define variable v-frame-width          as decimal   no-undo .
      713     define variable v-frame-virtual-width  as decimal   no-undo .
      714     define variable v-browse-width         as decimal   no-undo .
      715     define variable v-window-width         as decimal   no-undo .
      716     define variable v-window-virtual-width as decimal   no-undo .
      717     define variable v-change-sign          as integer   no-undo .
      718     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      719     define buffer buf_temp-browse-handle  for temp-browse-handle .
      720     if p-change-value > 0
      721     then do:
      722       if frame Dialog-Frame :width + p-change-value >
      723           session :width-chars
      724       then do:
      725         assign
      726           p-change-value = session :width-chars - frame Dialog-Frame :width
      727         .
      728         if p-change-value <= 0
      729         then do:
      730           run diasize_position-resize-button in this-procedure .
      731           return .
      732         end.
      733       end.
      734     end.
      735     if p-change-value < 0
      736     then do:
      737       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      738       then do:
      739         assign
      740           p-change-value = v-diasize-orig-frame-width
      741                          - frame Dialog-Frame :width
      742         .
      743         if p-change-value >= 0
      744         then do:
      745           run diasize_position-resize-button in this-procedure .
      746           return .
      747         end.
      748       end.
      749     end.
      750     if p-change-value >= 0
      751     then do:
      752       assign
      753         v-change-sign = 1
      754       .
      755     end.
      756     else do:
      757       assign
      758         v-change-sign = -1
      759       .
      760     end.
      761     assign
      762       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      763     .
      764     if p-change-value = 0
      765     then do:
      766       run diasize_position-resize-button in this-procedure .
      767       return .
      768     end.
      769     move_block:
      770     do
      771     on error undo move_block, leave move_block
      772     :
      773       if retry
      774       then do:
      775         do
      776         on error undo move_block, leave move_block
      777         :
      778           if p-change-value > 0
      779           then do:
      780             for each buf_temp-diasize-handle
      781             on error undo, next
      782             :
      783               assign
      784                 v-object-handle = buf_temp-diasize-handle.handle-value
      785               .
      786               if v-object-handle <> v-diasize-resize-button
      787               then do:
      788                 assign
      789                   v-object-handle :col = buf_temp-diasize-handle.save-position
      790                 .
      791               end.
      792             end.
      793             assign
      794               v-diasize-browse-handle :width = v-browse-width
      795             .
      796             for each buf_temp-browse-handle
      797               where buf_temp-browse-handle.browse-type = 'width':u
      798             on error undo, next
      799             :
      800               assign
      801                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      802               .
      803             end.
      804             assign
      805               frame Dialog-Frame :width = v-frame-width
      806             .
      807             if frame Dialog-Frame :scrollable = true
      808             then do:
      809               assign
      810                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      811               .
      812             end.
      813             run diasize_position-resize-button in this-procedure .
      814           end.
      815           else do:
      816             if frame Dialog-Frame :scrollable = true
      817             then do:
      818               assign
      819                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      820               .
      821             end.
      822             assign
      823               frame Dialog-Frame :width = v-frame-width
      824             .
      825             for each buf_temp-browse-handle
      826               where buf_temp-browse-handle.browse-type = 'width':u
      827             on error undo, next
      828             :
      829               assign
      830                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      831               .
      832             end.
      833             assign
      834               v-diasize-browse-handle :width = v-browse-width
      835             .
      836             for each buf_temp-diasize-handle
      837             on error undo, next
      838             :
      839               assign
      840                 v-object-handle = buf_temp-diasize-handle.handle-value
      841               .
      842               if v-object-handle <> v-diasize-resize-button
      843               then do:
      844                 assign
      845                   v-object-handle :col = buf_temp-diasize-handle.save-position
      846                 .
      847               end.
      848             end.
      849             run diasize_position-resize-button in this-procedure .
      850           end.
      851           assign
      852             v-diasize-change-size = false
      853           .
      854           leave move_block .
      855         end.
      856       end.
      857       assign
      858         v-diasize-need-full-display = true
      859       .
      860       if v-diasize-change-size = false
      861       then do:
      862         assign
      863           v-diasize-change-size = true
      864         .
      865       end.
      866       else do:
      867         return .
      868       end.
      869       assign
      870         v-frame-width = frame Dialog-Frame :width
      871         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      872         v-browse-width = v-diasize-browse-handle :width
      873       .
      874       for each buf_temp-browse-handle
      875         where buf_temp-browse-handle.browse-type = 'width':u
      876       :
      877         assign
      878           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      879         .
      880       end.
      881       for each buf_temp-diasize-handle
      882       :
      883         delete buf_temp-diasize-handle .
      884       end.
      885       assign
      886         v-field-group-handle = frame Dialog-Frame :first-child
      887       .
      888       do while valid-handle(v-field-group-handle)
      889       :
      890         assign
      891           v-object-handle = v-field-group-handle :first-child
      892         .
      893         do while valid-handle(v-object-handle)
      894         :
      895           if  v-object-handle <> v-diasize-browse-handle :handle
      896           and v-object-handle <> v-diasize-resize-button
      897           and can-query(v-object-handle, "row")
      898           and can-query(v-object-handle, "height")
      899           and ( v-object-handle :col + v-object-handle :width
      900                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      901               )
      902           then do:
      903             find first buf_temp-browse-handle
      904               where buf_temp-browse-handle.browse-type   = 'width':u
      905                 and buf_temp-browse-handle.browse-handle = v-object-handle
      906               no-error .
      907             if available buf_temp-browse-handle
      908             then do:
      909             end.
      910             else do:
      911               create buf_temp-diasize-handle .
      912               assign
      913                 buf_temp-diasize-handle.handle-value  = v-object-handle
      914                 buf_temp-diasize-handle.save-position = v-object-handle :col
      915               .
      916             end.
      917           end.
      918           assign
      919             v-object-handle = v-object-handle :next-sibling
      920           .
      921         end.
      922         assign
      923           v-field-group-handle = v-field-group-handle :next-sibling
      924         .
      925       end.
      926       do with frame Dialog-Frame
      927       :
      928         hide v-diasize-resize-button .
      929         v-diasize-resize-button :row = 1.
      930         v-diasize-resize-button :column = 1.
      931       end.
      932       if p-change-value > 0
      933       then do:
      934         if frame Dialog-Frame :scrollable = true
      935         then do:
      936           assign
      937             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      938             no-error .
      939           if error-status :error
      940           or error-status :get-message(1) <> ""
      941           then do:
      942             undo move_block, retry move_block.
      943           end.
      944         end.
      945         assign
      946           frame Dialog-Frame :width = v-frame-width + p-change-value
      947           no-error .
      948         if error-status :error
      949         or error-status :get-message(1) <> ""
      950         then do:
      951           undo move_block, retry move_block.
      952         end.
      953         assign
      954           v-diasize-browse-handle :width = v-browse-width + p-change-value
      955         no-error .
      956         if error-status :error
      957         or error-status :get-message(1) <> ""
      958         then do:
      959           undo move_block, retry move_block.
      960         end.
      961         for each buf_temp-browse-handle
      962           where buf_temp-browse-handle.browse-type = 'width':u
      963         on error undo move_block, retry move_block
      964         :
      965           assign
      966             buf_temp-browse-handle.browse-handle :width
      967               = buf_temp-browse-handle.browse-handle :width + p-change-value
      968             no-error .
      969           if error-status :error
      970           or error-status :get-message(1) <> ""
      971           then do:
      972             undo move_block, retry move_block .
      973           end.
      974         end.
      975         for each buf_temp-diasize-handle
      976         on error undo move_block, retry move_block
      977         :
      978           assign
      979             v-object-handle = buf_temp-diasize-handle.handle-value
      980           .
      981           if v-object-handle <> v-diasize-resize-button
      982           then do:
      983             assign
      984               v-object-handle :col = v-object-handle :col + p-change-value
      985               no-error .
      986             if error-status :error
      987             or error-status :get-message(1) <> ""
      988             then do:
      989               undo move_block, retry move_block .
      990             end.
      991           end.
      992         end.
      993       end.
      994       else do:
      995         for each buf_temp-diasize-handle
      996         on error undo move_block, retry move_block
      997         :
      998           assign
      999             v-object-handle = buf_temp-diasize-handle.handle-value
     1000           .
     1001           if v-object-handle <> v-diasize-resize-button
     1002           then do:
     1003             assign
     1004               v-object-handle :col = v-object-handle :col + p-change-value
     1005               no-error .
     1006             if error-status :error
     1007             or error-status :get-message(1) <> ""
     1008             then do:
     1009               undo move_block, retry move_block .
     1010             end.
     1011           end.
     1012         end.
     1013         for each buf_temp-browse-handle
     1014           where buf_temp-browse-handle.browse-type = 'width':u
     1015         on error undo move_block, retry move_block
     1016         :
     1017           assign
     1018             buf_temp-browse-handle.browse-handle :width
     1019               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1020             no-error .
     1021           if error-status :error
     1022           or error-status :get-message(1) <> ""
     1023           then do:
     1024             undo move_block, retry move_block .
     1025           end.
     1026         end.
     1027         assign
     1028           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1029           no-error .
     1030         if error-status :error
     1031         or error-status :get-message(1) <> ""
     1032         then do:
     1033           undo move_block, retry move_block.
     1034         end.
     1035         assign
     1036           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1037         no-error .
     1038         if error-status :error
     1039         or error-status :get-message(1) <> ""
     1040         then do:
     1041           undo move_block, retry move_block.
     1042         end.
     1043         if frame Dialog-Frame :scrollable = true
     1044         then do:
     1045           assign
     1046             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1047           no-error .
     1048           if error-status :error
     1049           or error-status :get-message(1) <> ""
     1050           then do:
     1051             undo move_block, retry move_block.
     1052           end.
     1053         end.
     1054       end.
     1055       if p-move-resize
     1056       then do:
     1057         run diasize_position-resize-button in this-procedure .
     1058       end.
     1059       if v-diasize-wndstore = true
     1060       then do:
     1061         if connected("ub") = true
     1062         then do:
     1063           define variable v-cntxt-db-num        as integer   no-undo .
     1064           define variable v-cntxt-userid        as character no-undo .
     1065           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1066                                             , OUTPUT v-cntxt-userid
     1067                                             ) .
     1068           run gbl/wndsizew.p
     1069             (input  v-cntxt-db-num
     1070             ,input  v-cntxt-userid
     1071             ,input  v-diasize-proc-name
     1072             ,input  'width':u
     1073             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1074             ) .
     1075         end.
     1076       end.
     1077     end.
     1078     assign
     1079       v-diasize-change-size = false
     1080     .
     1081   end procedure.
     1082   procedure diasize_set-width :
     1083     define input  parameter p-new-width  as decimal   no-undo .
     1084     define input  parameter p-move-resize as logical   no-undo .
     1085     do
     1086     on error undo, return error return-value
     1087     :
     1088       run diasize_change-width in this-procedure
     1089         (input  (p-new-width - frame Dialog-Frame :width)
     1090         ,input  p-move-resize
     1091         ) .
     1092     end.
     1093   end procedure.
     1094   procedure diasize_position-resize-button :
     1095     do with frame Dialog-Frame
     1096     :
     1097       hide v-diasize-resize-button .
     1098       assign
     1099         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1100                     - 1
     1101                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1102         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1103                     - 1
     1104                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1105       .
     1106       view v-diasize-resize-button .
     1107     end.
     1108   end procedure.
     1109   on alt-right anywhere
     1110   do:
     1111     run diasize_change-width in this-procedure
     1112       (input 1
     1113       ,input true
     1114       ) .
     1115     return no-apply .
     1116   end.
     1117   on alt-left anywhere
     1118   do:
     1119     run diasize_change-width in this-procedure
     1120       (input -1
     1121       ,input true
     1122       ) .
     1123     return no-apply .
     1124   end.
     1125   on alt-down anywhere
     1126   do:
     1127     run diasize_change-height in this-procedure
     1128       (input 1
     1129       ,input true
     1130       ) .
     1131     return no-apply .
     1132   end.
     1133   on alt-up anywhere
     1134   do:
     1135     run diasize_change-height in this-procedure
     1136       (input -1
     1137       ,input true
     1138       ) .
     1139     return no-apply .
     1140   end.
     1141   on alt-enter of frame Dialog-Frame
     1142   do:
     1143     run diasize_maximize in this-procedure
     1144       (input  ?
     1145       ).
     1146     return no-apply .
     1147   end.
     1148   procedure diasize_end-move :
     1149     do
     1150     on error undo, return error return-value
     1151     :
     1152       define variable v-row-delta as decimal   no-undo .
     1153       define variable v-col-delta as decimal   no-undo .
     1154       define variable v-new-row as decimal   no-undo .
     1155       define variable v-new-col as decimal   no-undo .
     1156       assign
     1157         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1158         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1159       .
     1160       assign
     1161         v-row-delta = v-new-row - frame Dialog-Frame :height
     1162         v-col-delta = v-new-col - frame Dialog-Frame :width
     1163       .
     1164       run diasize_change-height in this-procedure
     1165         (input v-row-delta
     1166         ,input true
     1167         ) .
     1168       run diasize_change-width in this-procedure
     1169         (input v-col-delta
     1170         ,input true
     1171         ) .
     1172     end.
     1173   end procedure.
     1174   procedure diasize_maximize :
     1175     define input  parameter p-action as logical   no-undo .
     1176     do
     1177     on error undo, return error return-value
     1178     :
     1179       if p-action = ?
     1180       then do:
     1181         if v-diasize-need-maximize = true
     1182         then do:
     1183           assign
     1184             p-action = true
     1185           .
     1186         end.
     1187         else do:
     1188           assign
     1189             p-action = false
     1190           .
     1191         end.
     1192       end.
     1193       if p-action = true
     1194       then do:
     1195         run diasize_change-height in this-procedure
     1196           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1197               - frame Dialog-Frame :height-chars
     1198           ,input true
     1199           ) .
     1200         run diasize_change-width in this-procedure
     1201           (input session :width-chars
     1202               - frame Dialog-Frame :width-chars
     1203           ,input true
     1204           ) .
     1205         assign
     1206           v-diasize-need-maximize = false
     1207         .
     1208       end.
     1209       else do:
     1210         run diasize_change-width in this-procedure
     1211           (input v-diasize-orig-frame-width
     1212               - frame Dialog-Frame :width-chars
     1213           ,input true
     1214           ) .
     1215         run diasize_change-height in this-procedure
     1216           (input v-diasize-orig-frame-height
     1217               - frame Dialog-Frame :height-chars
     1218           ,input true
     1219           ) .
     1220         assign
     1221           v-diasize-need-maximize = true
     1222         .
     1223       end.
     1224     end.
     1225   end procedure.
     1226   procedure diasize_restore-orig-size :
     1227     do
     1228     on error undo, return error return-value
     1229     :
     1230       assign
     1231         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1232         v-diasize-current-frame-height = frame Dialog-Frame :height
     1233       .
     1234       run diasize_set-height in this-procedure
     1235         (input  v-diasize-orig-frame-height
     1236         ,input  true
     1237         ) .
     1238       run diasize_set-width in this-procedure
     1239         (input  v-diasize-orig-frame-width
     1240         ,input  true
     1241         ) .
     1242     end.
     1243   end procedure.
     1244   procedure diasize_restore-current-size :
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       run diasize_set-height in this-procedure
     1249         (input  v-diasize-current-frame-height
     1250         ,input  true
     1251         ) .
     1252       run diasize_set-width in this-procedure
     1253         (input  v-diasize-current-frame-width
     1254         ,input  true
     1255         ) .
     1256     end.
     1257   end procedure.
     1258   procedure diasize_set-browse-handle :
     1259     define input  parameter p-browse-handle as handle   no-undo .
     1260     define buffer buf_temp-browse-handle for temp-browse-handle .
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       assign
     1265         v-diasize-browse-handle = p-browse-handle
     1266       .
     1267       for each buf_temp-browse-handle
     1268       on error undo, return error return-value
     1269       :
     1270         delete buf_temp-browse-handle .
     1271       end.
     1272     end.
     1273   end procedure.
     1274   procedure diasize_add_browse :
     1275     define input  parameter p-browse-type   as character no-undo .
     1276     define input  parameter p-browse-handle as handle    no-undo .
     1277     define buffer buf_temp-browse-handle for temp-browse-handle .
     1278     do
     1279     on error undo, return error return-value
     1280     :
     1281       assign
     1282         v-diasize-browse-number = v-diasize-browse-number + 1
     1283       .
     1284       create buf_temp-browse-handle .
     1285       assign
     1286         buf_temp-browse-handle.browse-type   = p-browse-type
     1287         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1288         buf_temp-browse-handle.browse-handle = p-browse-handle
     1289       .
     1290     end.
     1291   end procedure.
     1292   procedure diasize_init :
     1293     define variable v-default-value    as logical   no-undo .
     1294     define variable v-restore-saved    as logical   no-undo .
     1295     define variable v-resize-value-str as character no-undo .
     1296     do
     1297     on error undo, return error return-value
     1298     :
     1299       do with frame Dialog-Frame
     1300       :
     1301         assign
     1302           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1303           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1304           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1305         .
     1306         create button v-diasize-resize-button
     1307         assign
     1308           parent        = frame Dialog-Frame :first-child
     1309           label         = "s"
     1310           height-pixels = 16
     1311           width-pixels  = 16
     1312           visible       = true
     1313           sensitive     = true
     1314           movable       = true
     1315           triggers:
     1316             on end-move persistent run diasize_end-move in this-procedure .
     1317           end triggers.
     1318         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1319         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1320         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1321         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1322         assign
     1323           v-diasize-wndmax = false
     1324         .
     1325         if connected("ub") = true
     1326         then do:
     1327           define variable v-cntxt-db-num        as integer   no-undo .
     1328           define variable v-cntxt-userid        as character no-undo .
     1329           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1330                                             , OUTPUT v-cntxt-userid
     1331                                             ) .
     1332           run gbl/wndpar_r.p
     1333             (input  v-cntxt-db-num
     1334             ,input  v-cntxt-userid
     1335             ,input  'wndmax':U
     1336             ,output v-diasize-wndmax
     1337             ,output v-default-value
     1338             ) .
     1339         end.
     1340         assign
     1341           v-diasize-wndstore = false
     1342         .
     1343         if connected("ub") = true
     1344         then do:
     1345           run gbl/wndpar_r.p
     1346             (input  v-cntxt-db-num
     1347             ,input  v-cntxt-userid
     1348             ,input  'wndstore':U
     1349             ,output v-diasize-wndstore
     1350             ,output v-default-value
     1351             ) .
     1352         end.
     1353         assign
     1354           v-diasize-proc-name = entry(1, program-name(2), '.')
     1355         .
     1356         if v-diasize-wndstore = true
     1357         then do:
     1358           assign
     1359             v-restore-saved = false
     1360           .
     1361           if connected("ub") = true
     1362           then do:
     1363             run gbl/wndsizer.p
     1364               (input  v-cntxt-db-num
     1365               ,input  v-cntxt-userid
     1366               ,input  v-diasize-proc-name
     1367               ,input  'height':u
     1368               ,output v-resize-value-str
     1369               ) .
     1370             if v-resize-value-str <> '':U
     1371             then do:
     1372               run diasize_change-height in this-procedure
     1373                 (input  integer(v-resize-value-str)
     1374                 ,input  true
     1375                 ) .
     1376               assign
     1377                 v-restore-saved = true
     1378               .
     1379             end.
     1380           end.
     1381           if connected("ub") = true
     1382           then do:
     1383             run gbl/wndsizer.p
     1384               (input  v-cntxt-db-num
     1385               ,input  v-cntxt-userid
     1386               ,input  v-diasize-proc-name
     1387               ,input  'width':u
     1388               ,output v-resize-value-str
     1389               ) .
     1390             if v-resize-value-str <> '':U
     1391             then do:
     1392               run diasize_change-width in this-procedure
     1393                 (input  integer(v-resize-value-str)
     1394                 ,input  true
     1395                 ) .
     1396               assign
     1397                 v-restore-saved = true
     1398               .
     1399             end.
     1400           end.
     1401           if v-restore-saved <> true
     1402           then do:
     1403             if v-diasize-wndmax = true
     1404             then do:
     1405               run diasize_maximize in this-procedure
     1406                 (input  true
     1407                 ) .
     1408             end.
     1409           end.
     1410         end.
     1411         else do:
     1412           if v-diasize-wndmax = true
     1413           then do:
     1414             run diasize_maximize in this-procedure
     1415               (input  true
     1416               ) .
     1417           end.
     1418         end.
     1419       end.
     1420     end.
     1421   end procedure.
     1422   procedure diasize_need-full-display :
     1423     define output parameter p-need-full-display as logical   no-undo .
     1424     do
     1425     on error undo, return error return-value
     1426     :
     1427       assign
     1428         p-need-full-display = v-diasize-need-full-display
     1429       .
     1430       assign
     1431         v-diasize-need-full-display = false
     1432       .
     1433     end.
     1434   end procedure.
     1435   procedure get-context :
     1436      define output parameter p-db-num as integer          no-undo.
     1437      define output parameter p-user-id as character        no-undo.
     1438      define variable v-login               as character    no-undo.
     1439      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1440      define buffer buf_user-login  for ub.user-login .
     1441      do
     1442      on error undo, return error
     1443      :
     1444            FIND FIRST buf_sys-ctrl no-lock.
     1445            ASSIGN
     1446               v-login = USERID("ub")
     1447               p-db-num = buf_sys-ctrl.db-num
     1448            .
     1449            FIND FIRST buf_user-login
     1450                 WHERE buf_user-login.db-num = p-db-num
     1451                   AND buf_user-login.user-login = v-login
     1452                 no-lock
     1453                 no-error
     1454                 .
     1455            IF AVAILABLE buf_user-login
     1456            THEN DO:
     1457               assign
     1458                  p-user-id = buf_user-login.user-id
     1459               .
     1460            END.
     1461      end.
     1462   end procedure.
     1463       run diasize_init in this-procedure .
     1464   if browse BROWSE-1:set-repositioned-row(5, "CONDITIONAL" ) then .
     1465   run init-temp-table in this-procedure .
     1466   MAIN-BLOCK:
     1467   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1468      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1469     RUN enable_UI.
     1470     WAIT-FOR GO OF FRAME Dialog-Frame.
     1471   END.
     1472   RUN disable_UI.
     1473   PROCEDURE disable_UI :
     1474     HIDE FRAME Dialog-Frame.
     1475   END PROCEDURE.
     1476   PROCEDURE enable_UI :
     1477     ENABLE b-sel b-cancel b-help BROWSE-1
     1478         WITH FRAME Dialog-Frame.
     1479     VIEW FRAME Dialog-Frame.
     1480     run local-open-query in this-procedure .
     1481   END PROCEDURE.
     1482   PROCEDURE init-temp-table :
     1483     define buffer buf_nws-doc-hist for ub.nws-doc-hist .
     1484     define buffer buf_temp-doc-code for temp-doc-code .
     1485     define variable v-doc-type as character no-undo .
     1486     for each buf_nws-doc-hist
     1487     on error undo, return error return-value
     1488     :
     1489   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     1491     (input  buf_nws-doc-hist.doc-type
     1492     ,output v-doc-type
     1493     )  .
     1494       find first buf_temp-doc-code
     1495         where buf_temp-doc-code.temp-doc-type = v-doc-type
     1496           and buf_temp-doc-code.temp-doc-code = buf_nws-doc-hist.doc-code
     1497         no-error .
     1498       if not available buf_temp-doc-code
     1499       then do:
     1500         create buf_temp-doc-code .
     1501         assign
     1502           buf_temp-doc-code.temp-doc-type = v-doc-type
     1503           buf_temp-doc-code.temp-doc-code = buf_nws-doc-hist.doc-code
     1504         .
     1505       end.
     1506     end.
     1507   END PROCEDURE.
     1508   PROCEDURE local-open-query :
     1509     define variable v-reposition-rowid as rowid     no-undo .
     1510     find first temp-doc-code
     1511       where temp-doc-code.temp-doc-type = v-select-doc-type
     1512         and temp-doc-code.temp-doc-code =v-select-doc-code
     1513       no-error .
     1514     if available temp-doc-code
     1515     then do:
     1516       assign
     1517         v-reposition-rowid = rowid(temp-doc-code)
     1518       .
     1519     end.
     1520     else do:
     1521       find last temp-doc-code no-error .
     1522          if available temp-doc-code
     1523          then do:
     1524       assign
     1525         v-reposition-rowid = rowid(temp-doc-code)
     1526       .
     1527          end.
     1528          else do:
     1529       assign
     1530         v-reposition-rowid = ?
     1531       .
     1532       end.
     1533     end.
     1534     OPEN QUERY BROWSE-1 FOR EACH temp-doc-code.
     1535     if v-reposition-rowid <> ?
     1536     then do:
     1537       reposition BROWSE-1 to rowid v-reposition-rowid .
     1538     end.
     1539     apply 'entry':u to browse BROWSE-1 .
     1540   END PROCEDURE.
