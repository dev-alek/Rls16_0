        1   using ibs.th.gbl.sys.objsrv.
        2   using ibs.th.str.marking.sts.*.
        3   using ibs.th.str.marking.handlers.*.
        4   using ibs.th.str.utd.sts.*.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Сканирование акцизных марок".
       11   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       12   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "X(65)" no-undo
      128   initial "@(#)$Workfile$ $Revision$".
      129   define temp-table temp_fbr-history no-undo like ub.fbr-history .
      130   define variable v-fbrhist-history-level     as integer      no-undo.
      131   define variable v-fbrhist-upper-obj-type    as character    no-undo.
      132   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
      133   define variable v-fbrhist-upper-code        as integer      no-undo.
      134   define variable v-fbrhist-current-obj-type  as character    no-undo.
      135   define variable v-fbrhist-current-obj-code  as integer      no-undo.
      136   define variable v-fbrhist-current-code      as integer      no-undo.
      137   define variable v-fbrhist-saved-obj-type    as character    no-undo.
      138   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
      139   define variable v-fbrhist-saved-code        as integer      no-undo.
      140   procedure fbrhist-write :
      141   define input parameter p-userid                 as character        no-undo.
      142   define input parameter p-obj-type               as character        no-undo.
      143   define input parameter p-obj-code               as integer          no-undo.
      144   define input parameter p-hst-type               as character        no-undo.
      145   define input parameter p-hst-level              as integer          no-undo.
      146   define input parameter p-procedure-name         as character        no-undo.
      147   define input parameter p-procedure-parameters   as character        no-undo.
      148   define input parameter p-doc-code               as character        no-undo.
      149   define input parameter p-doc-type               as character        no-undo.
      150   define input parameter p-status_                as character        no-undo.
      151   define input parameter p-is-free                as logical          no-undo.
      152   define input parameter p-recipe-code            as character        no-undo.
      153   define input parameter p-recipe-type            as character        no-undo.
      154   define input parameter p-gds-code               as integer          no-undo.
      155   define input parameter p-trn-type               as character        no-undo.
      156   define input parameter p-qnty                   as decimal          no-undo.
      157   define input parameter p-PS                     as character        no-undo.
      158   define input parameter p-is-error               as logical          no-undo.
      159       define variable v-today                         as date         no-undo.
      160       define variable v-obj-date                      as date         no-undo.
      161       define variable v-time                          as integer      no-undo.
      162       define variable v-host-code                     as integer      no-undo.
      163       define variable v-db-num                        as integer      no-undo.
      164       define buffer buf_temp_fbr-history       for temp_fbr-history.
      165       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
      166   do
      167   for buf_temp_fbr-history
      168     , buf_upper_temp_fbr-history
      169   on error undo, return error
      170   :
      171       if v-fbrhist-history-level = 0
      172       or v-fbrhist-history-level < p-hst-level
      173       then do:
      174           undo, return .
      175       end.
      176       if v-fbrhist-upper-code <> 0
      177       then do:
      178           find first buf_upper_temp_fbr-history no-lock
      179                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
      180                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
      181                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
      182           no-error.
      183       end.
      184   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      186     (input  p-obj-type
      187     ,input  p-obj-code
      188     ,output v-obj-date
      189     )  .
      190       run cur-time in this-procedure (
      191             output v-today
      192           , output v-time
      193       ).
      194   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      196     (input  p-obj-type
      197     ,input  p-obj-code
      198     ,output v-host-code
      199     )  .
      200   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      202     (output v-db-num
      203     )  .
      204       create buf_temp_fbr-history.
      205       assign
      206           buf_temp_fbr-history.obj-type                = p-obj-type
      207           buf_temp_fbr-history.obj-code                = p-obj-code
      208           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
      209           buf_temp_fbr-history.hst-type                = p-hst-type
      210           buf_temp_fbr-history.hst-level               = p-hst-level
      211           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
      212           buf_temp_fbr-history.procedure-name          = p-procedure-name
      213           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
      214           buf_temp_fbr-history.doc-code                = p-doc-code
      215           buf_temp_fbr-history.doc-type                = p-doc-type
      216           buf_temp_fbr-history.status_                 = p-status_
      217           buf_temp_fbr-history.is-free                 = p-is-free
      218           buf_temp_fbr-history.recipe-code             = p-recipe-code
      219           buf_temp_fbr-history.recipe-type             = p-recipe-type
      220           buf_temp_fbr-history.gds-code                = p-gds-code
      221           buf_temp_fbr-history.trn-type                = p-trn-type
      222           buf_temp_fbr-history.qnty                    = p-qnty
      223           buf_temp_fbr-history.PS                      = p-ps
      224           buf_temp_fbr-history.is-error                = p-is-error
      225           buf_temp_fbr-history.db-num                  = v-db-num
      226           buf_temp_fbr-history.user-name               = p-userid
      227           buf_temp_fbr-history.sys-date                = v-today
      228           buf_temp_fbr-history.sys-time-int            = v-time
      229           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
      230           buf_temp_fbr-history.obj-date                = v-obj-date
      231           buf_temp_fbr-history.host-code               = v-host-code
      232       .
      233       assign
      234           v-fbrhist-current-obj-type                   = p-obj-type
      235           v-fbrhist-current-obj-code                   = p-obj-code
      236           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
      237       .
      238       if available buf_upper_temp_fbr-history
      239       then do:
      240           assign
      241               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
      242                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
      243                                               + "-":U + string( buf_temp_fbr-history.obj-code )
      244                                               + "-":U + string( buf_temp_fbr-history.hst-code )
      245           .
      246       end.
      247       else do:
      248           assign
      249               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
      250                                  + "-":U + string( buf_temp_fbr-history.obj-code )
      251                                  + "-":U + string( buf_temp_fbr-history.hst-code )
      252           .
      253       end.
      254   end.
      255   end procedure.
      256   procedure fbrhist-read-conf :
      257   do
      258   on error undo, return error
      259   :
      260      define variable v-value-character as character  no-undo .
      261      define variable v-value-date      as date       no-undo .
      262      define variable v-value-decimal   as decimal    no-undo .
      263      define variable v-value-logical   as logical    no-undo .
      264      define variable v-tth             as handle     no-undo .
      265      define variable v-param-type            as character no-undo .
      266      run adm/shattri.p ( input "get":U
      267                        , input  '':u
      268                        , input  0
      269                        , input  'fbrattr':U
      270                        , input  'fbrhstlv':U
      271                        , output v-value-character
      272                        , output v-value-date
      273                        , output v-value-decimal
      274                        , output v-fbrhist-history-level
      275                        , output v-value-logical
      276                        , output v-param-type
      277                        , input-output table-handle v-tth
      278                        ) no-error .
      279      if error-status :error then do:
      280         assign
      281            v-fbrhist-history-level = 0
      282         .
      283      end.
      284   end.
      285   end procedure.
      286   procedure fbrhist-table-to-base :
      287       define buffer buf_fbr-history       for ub.fbr-history.
      288       define buffer buf_temp_fbr-history  for temp_fbr-history.
      289   do
      290   for buf_fbr-history
      291     , buf_temp_fbr-history
      292   on error undo, return error
      293   :
      294       for each buf_temp_fbr-history
      295       on error undo, return error
      296       :
      297           create buf_fbr-history.
      298           buffer-copy buf_temp_fbr-history to buf_fbr-history.
      299       end.
      300   end.
      301   end procedure.
      302   procedure fbrhist-init :
      303       define buffer buf_temp_fbr-history      for temp_fbr-history.
      304   do
      305   for buf_temp_fbr-history
      306   on error undo, return error
      307   :
      308       for each buf_temp_fbr-history
      309       :
      310           delete buf_temp_fbr-history.
      311       end.
      312       assign
      313           v-fbrhist-upper-obj-type    = ""
      314           v-fbrhist-upper-obj-code    = 0
      315           v-fbrhist-upper-code        = 0
      316           v-fbrhist-current-obj-type  = ""
      317           v-fbrhist-current-obj-code  = 0
      318           v-fbrhist-current-code      = 0
      319           v-fbrhist-saved-obj-type    = ""
      320           v-fbrhist-saved-obj-code    = 0
      321           v-fbrhist-saved-code        = 0
      322       .
      323   end.
      324   end procedure.
      325   procedure fbrhist-set-upper-code :
      326   do
      327   on error undo, return error
      328   :
      329       assign
      330           v-fbrhist-upper-obj-type    = v-fbrhist-current-obj-type
      331           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
      332           v-fbrhist-upper-code        = v-fbrhist-current-code
      333       .
      334   end.
      335   end procedure.
      336   procedure fbrhist-save-current-code :
      337   do
      338   on error undo, return error
      339   :
      340       assign
      341           v-fbrhist-saved-obj-type    = v-fbrhist-current-obj-type
      342           v-fbrhist-saved-obj-code    = v-fbrhist-current-obj-code
      343           v-fbrhist-saved-code        = v-fbrhist-current-code
      344       .
      345   end.
      346   end procedure.
      347   procedure fbrhist-set-upper-from-saved-code :
      348   do
      349   on error undo, return error
      350   :
      351       assign
      352           v-fbrhist-upper-obj-type    = v-fbrhist-saved-obj-type
      353           v-fbrhist-upper-obj-code    = v-fbrhist-saved-obj-code
      354           v-fbrhist-upper-code        = v-fbrhist-saved-code
