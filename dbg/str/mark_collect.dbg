      666   procedure lineattr-delete-flora-all :
      667     do
      668     on error undo, return error return-value
      669     :
      670       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      671       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      672       define input  parameter p-prt-code    as integer   no-undo .
      673       define buffer buf_doc-line-attr for ub.doc-line-attr .
      674       for each buf_doc-line-attr exclusive-lock
      675         where buf_doc-line-attr.doc-code  = p-doc-code
      676           and buf_doc-line-attr.gds-code  = p-gds-code
      677           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      678        :
      679         delete buf_doc-line-attr.
      680       end.
      681    end.
      682   end procedure.
      683   procedure lineattr-exist-flora-gds :
      684     do
      685     on error undo, return error return-value
      686     :
      687       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      688       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      689       define input  parameter p-prt-code    as integer   no-undo .
      690       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      691       define output parameter p-exist as logical   no-undo .
      692       define buffer buf_doc-line-attr for ub.doc-line-attr .
      693       p-exist = false .
      694       find first buf_doc-line-attr no-lock
      695         where buf_doc-line-attr.doc-code  = p-doc-code
      696           and buf_doc-line-attr.gds-code  = p-gds-code
      697           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      698         no-error .
      699       if avail buf_doc-line-attr then do:
      700         assign
      701          p-exist = true
      702         .
      703       end.
      704     end.
      705   end procedure.
      706   procedure lineattr-write-add-line-cli :
      707   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      708   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      709   define input  parameter p-cli-type      as character no-undo .
      710   define input  parameter p-cli-code      as integer   no-undo .
      711   define input  parameter p-contract-code as integer   no-undo .
      712   define input  parameter p-host-code     as integer   no-undo .
      713   define input  parameter p-exch-code     as integer   no-undo .
      714   define input  parameter p-exch-rate     as decimal   no-undo .
      715   define input  parameter p-exch-scale    as integer   no-undo .
      716   define input  parameter p-sum-cli       as decimal   no-undo .
      717   define input  parameter p-sum-vat       as decimal   no-undo .
      718   define buffer buf_doc-line-attr for ub.doc-line-attr .
      719     do
      720     on error undo, return error return-value
      721     :
      722       find first buf_doc-line-attr exclusive-lock
      723         where buf_doc-line-attr.doc-code  = p-doc-code
      724           and buf_doc-line-attr.gds-code  = p-gds-code
      725           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      726                                             chr(4) + p-cli-type +
      727                                             chr(4) + string(p-cli-code) +
      728                                             chr(4) + string(p-contract-code) +
      729                                             chr(4) + string(p-host-code)
      730         no-error .
      731       if not available buf_doc-line-attr then do:
      732         create buf_doc-line-attr .
      733         assign
      734           buf_doc-line-attr.doc-code  = p-doc-code
      735           buf_doc-line-attr.gds-code  = p-gds-code
      736           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      737                                         chr(4) + p-cli-type +
      738                                         chr(4) + string(p-cli-code) +
      739                                         chr(4) + string(p-contract-code) +
      740                                         chr(4) + string(p-host-code)
      741         .
      742       end.
      743       assign
      744         buf_doc-line-attr.attr-value =
      745         string(p-exch-code)  + chr(4) +
      746         string(p-exch-rate)  + chr(4) +
      747         string(p-exch-scale) + chr(4) +
      748         string(p-sum-cli)    + chr(4) +
      749         string(p-sum-vat)
      750         .
      751     end.
      752   end procedure.
      753   procedure lineattr-value-add-line-cli :
      754   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      755   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      756   define input   parameter p-cli-type      as character no-undo .
      757   define input   parameter p-cli-code      as integer   no-undo .
      758   define input   parameter p-contract-code as integer   no-undo .
      759   define input   parameter p-host-code     as integer   no-undo .
      760   define output  parameter p-exch-code     as integer   no-undo .
      761   define output  parameter p-exch-rate     as decimal   no-undo .
      762   define output  parameter p-exch-scale    as integer   no-undo .
      763   define output  parameter p-sum-cli       as decimal   no-undo .
      764   define output  parameter p-sum-vat       as decimal   no-undo .
      765   define buffer buf_doc-line-attr for ub.doc-line-attr .
      766     do
      767     on error undo, return error return-value
      768     :
      769       find first buf_doc-line-attr exclusive-lock
      770         where buf_doc-line-attr.doc-code  = p-doc-code
      771           and buf_doc-line-attr.gds-code  = p-gds-code
      772           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      773                                             chr(4) + p-cli-type +
      774                                             chr(4) + string(p-cli-code) +
      775                                             chr(4) + string(p-contract-code) +
      776                                             chr(4) + string(p-host-code)
      777         no-error .
      778       if available buf_doc-line-attr then do:
      779        assign
      780           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      781           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      782           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      783           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      784           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      785          .
      786        end.
      787     end.
      788   end procedure.
      789   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      790     define variable v-code as character no-undo .
      791     define variable v-type as character no-undo .
      792     define variable v-gds-code as integer   no-undo .
      793   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      795     (input  local-doc-line.artic
      796     ,input  local-doc-line.prod-type
      797     ,input  local-doc-line.prod-code
      798     ,output v-gds-code
      799     )  .
      800     run lineattr-value (
      801         input   local-doc-line.doc-code ,
      802         input   v-gds-code              ,
      803         input   'reason-code':U ,
      804         output  v-code                  ,
      805         output  v-type ) .
      806     find first ub.trn-reason no-lock where
      807                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      808     if not available ub.trn-reason then do:
      809        return "" .
      810     end.
      811     else do:
      812        return ub.trn-reason.reason-name .
      813     end.
      814   end function.
      815   procedure lineattr-value-parts :
      816     do
      817     on error undo, return error return-value
      818     :
      819       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      820       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      821       define input  parameter p-part-code   as character no-undo .
      822       define input  parameter p_in-code     as character no-undo .
      823       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      824       define output parameter p-value       as    decimal   no-undo .
      825       define buffer buf_doc-line-attr for ub.doc-line-attr .
      826       find first buf_doc-line-attr no-lock
      827         where buf_doc-line-attr.doc-code  = p-doc-code
      828           and buf_doc-line-attr.gds-code  = p-gds-code
      829           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      830         no-error .
      831       if avail buf_doc-line-attr then do:
      832         assign
      833           p-value = decimal( buf_doc-line-attr.attr-value)
      834         .
      835       end.
      836       else do:
      837         assign
      838           p-value = 0
      839         .
      840       end.
      841     end.
      842   end procedure.
      843   procedure lineattr-write-parts :
      844     do
      845     on error undo, return error return-value
      846     :
      847       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      848       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      849       define input parameter p-part-code  as character no-undo .
      850       define input parameter p_in-code    as character no-undo .
      851       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      852       define input parameter p-value      as decimal   no-undo .
      853       define buffer buf_doc-line-attr for ub.doc-line-attr .
      854       find first buf_doc-line-attr exclusive-lock
      855         where buf_doc-line-attr.doc-code  = p-doc-code
      856           and buf_doc-line-attr.gds-code  = p-gds-code
      857           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      858         no-error .
      859       if not available buf_doc-line-attr then do:
      860         create buf_doc-line-attr .
      861         assign
      862           buf_doc-line-attr.doc-code  = p-doc-code
      863           buf_doc-line-attr.gds-code  = p-gds-code
      864           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      865         .
      866       end.
      867       assign
      868         buf_doc-line-attr.attr-value = string( p-value )
