     2927             "Код", "code",
     2928   "Нач.назв", "name",
     2929   "Нач.слова", "context"
     2930        SIZE 37.6 BY 1 NO-UNDO.
     2931   DEFINE VARIABLE R-error       AS INTEGER
     2932      VIEW-AS RADIO-SET HORIZONTAL
     2933      RADIO-BUTTONS
     2934      "Все", 1,
     2935      "Ошибки", 2
     2936      SIZE 22 BY 1 NO-UNDO.
     2937   DEFINE RECTANGLE R-TH
     2938        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2939        SIZE 73.6 BY 3.1 TOOLTIP "Данные ТН".
     2940   DEFINE VARIABLE is-initial-set AS LOGICAL INITIAL no
     2941        LABEL "Первоначальный сбор марок"
     2942        VIEW-AS TOGGLE-BOX
     2943        SIZE 33 BY .81 NO-UNDO.
     2944   DEFINE QUERY br-utd-lines FOR
     2945         X_utd-lines SCROLLING.
     2946   DEFINE BROWSE br-utd-lines
     2947     QUERY br-utd-lines NO-LOCK DISPLAY
     2948         X_utd-lines.LineNum FORMAT "99999":U label "Номер"
     2949         X_utd-lines.gds-code FORMAT "999999999":U label "Код товара"
     2950         X_utd-lines.GdsName FORMAT "x(128)":U label "Наименование товара" width 40
     2951         X_utd-lines.Quantity FORMAT "->>,>>9.<<<":U label "Просканировано"
     2952         X_utd-lines.free-qnty FORMAT "->>,>>9.<<<":U label "Общий остаток"
     2953         X_utd-lines.UnitCode FORMAT "x(8)":U label "Единица измерения"
     2954       WITH SEPARATORS SIZE 117 BY 8.
     2955   DEFINE FRAME Dialog-Frame
     2956        b-cancel AT ROW 1.24 COL 2
     2957        b-exit AT ROW 1.24 COL 12 WIDGET-ID 380
     2958        B_mark AT ROW 1.24 COL 109 WIDGET-ID 80
     2959        c-type AT ROW 2.43 COL 5.2 COLON-ALIGNED WIDGET-ID 240
     2960        f-num-name AT ROW 2.43 COL 53.8 NO-LABEL WIDGET-ID 328
     2961        f-num AT ROW 2.43 COL 64.6 COLON-ALIGNED NO-LABEL WIDGET-ID 284
     2962        f-date-name AT ROW 2.43 COL 81.2 NO-LABEL WIDGET-ID 330
     2963        f-date AT ROW 2.43 COL 85.2 COLON-ALIGNED NO-LABEL WIDGET-ID 286
     2964        is-initial-set AT ROW 3.86 COL 77 WIDGET-ID 344
     2965        f-obj-type-TH AT ROW 5.05 COL 7 RIGHT-ALIGNED NO-LABEL WIDGET-ID 102
     2966        f-obj-code-TH AT ROW 5.05 COL 22.8 RIGHT-ALIGNED NO-LABEL WIDGET-ID 98
     2967        r-obj-TH AT ROW 5.05 COL 23.6 WIDGET-ID 104
     2968        f-obj-name-TH AT ROW 5.05 COL 74.6 RIGHT-ALIGNED NO-LABEL WIDGET-ID 100
     2969        f-status-TH AT ROW 6.95 COL 6 NO-LABEL WIDGET-ID 336
     2970        c-status AT ROW 6.95 COL 15 COLON-ALIGNED NO-LABEL WIDGET-ID 238
     2971        f-comment AT ROW 8 COL 17 NO-LABEL WIDGET-ID 266
     2972        f-comment-name AT ROW 8.19 COL 4 NO-LABEL WIDGET-ID 340
     2973        v-mark AT ROW 11.48 COL 15 COLON-ALIGNED
     2974        a-n-c AT ROW 12.76 COL 3 NO-LABEL WIDGET-ID 272
     2975        a-n-c-name AT ROW 12.81 COL 40.2 COLON-ALIGNED NO-LABEL WIDGET-ID 278
     2976        R-error AT ROW 12.76 COL 99 NO-LABEL WIDGET-ID 372
     2977        br-utd-lines AT ROW 13.81 COL 3
     2978        f-msg AT ROW 21.95 COL 3 NO-LABEL WIDGET-ID 92
     2979        b_prov-finish AT ROW 23.14 COL 3 WIDGET-ID 70
     2980        b_del-line AT ROW 23.14 COL 39 WIDGET-ID 94
     2981        "Объект:" VIEW-AS TEXT
     2982             SIZE 12 BY .67 AT ROW 4.1 COL 4 WIDGET-ID 182
     2983        "Данные ТН:" VIEW-AS TEXT
     2984             SIZE 11 BY .67 AT ROW 3.62 COL 33.6 WIDGET-ID 180
     2985        R-TH AT ROW 3.76 COL 3 WIDGET-ID 112
     2986        SPACE(2) SKIP(1)
     2987       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2988            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2989            TITLE "Документ сбора марок"
     2990            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
     2991   function CrCheckMarkDoc return char
     2992      (v-cntxt-obj-type as char,
     2993      v-cntxt-obj-code as int,
     2994      idb-num as int,
     2995       idoc-id as int,
     2996      imark as char,
     2997       is-initial-set-p as logical
     2998      )
     2999         :
     3000     define buffer buf_marking-child for ub.marking .
     3001     define buffer buf_marking for ub.marking.
     3002     define buffer buf_marking-attr for  ub.marking-attr.
     3003     define buffer buf_marking-parent for ub.marking .
     3004     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     3005     define buffer buf_utd-marking-lines-child for ub.utd-marking-lines .
     3006     define buffer buf_utd-lines for ub.utd-lines.
     3007     define buffer buf_goods for ub.goods.
     3008     define buffer buf_gds-obj for ub.gds-obj.
     3009     define variable v-par-type as character no-undo.
     3010     define variable v-par-val  as character no-undo.
     3011     define variable v-gds-code as integer no-undo .
     3012     define variable v-num-recipes as integer no-undo .
     3013     define variable v-GTIN as character no-undo .
     3014     define variable v-GTIN-qnty as decimal no-undo .
     3015     define variable v-GTIN-child as character no-undo .
     3016     define variable v-GTIN-qnty-child as decimal no-undo .
     3017     define variable v-free-qnty as decimal no-undo .
     3018     define variable v-old-sts as integer no-undo .
     3019     define variable v-mark-short as character no-undo.
     3020     define variable v-GisMTcheckStatus as integer no-undo .
     3021     define variable v-is-off-line as logical no-undo .
     3022     define variable v-mark-weight as decimal no-undo .
     3023     define variable v-isweighed as logical no-undo .
     3024     define variable v-ok        as logical no-undo .
     3025     if imark = ""
     3026       then return "".
     3027     v-mark-short = GetCodeIdent(imark).
     3028     if v-mark-short = "" or v-mark-short = ?
     3029     then do:
     3030       return "Неизвестный формат марки.".
     3031     end.
     3032     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     3033     if available buf_marking
     3034     then do :
     3035       if buf_marking.unit-ext = "LEVEL2" then
     3036         return "Неизвестный формат марки.".
     3037       v-GTIN = getGtinByDM(buf_marking.mark) .
     3038     end .
     3039     else do :
     3040       v-GTIN = getGtinByDM(imark) .
     3041     end .
     3042     v-gds-code = getGdsCodeByGtin(v-GTIN) .
     3043     v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     3044     if v-gds-code = ?
     3045     then do :
     3046       return substitute ("Не удалось найти товар по gtin &1",v-GTIN).
     3047     end .
     3048     find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     3049     if not available buf_goods
     3050     then do :
     3051       return substitute ( "Не найден товар по коду &1.",v-gds-code ).
     3052     end .
     3053       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3054     ( buf_goods.gds-code,
     3055      'weighed-gds':U,
     3056      output v-par-val,
     3057      output v-par-type
     3058     ).
     3059     v-isweighed = logical(v-par-val) .
     3060     if v-GTIN-qnty = ?
     3061     or v-GTIN-qnty <= 0.0
     3062     then do :
     3063       return substitute ("Не установлен коэффициент для упаковки для марки &1.",imark).
     3064     end .
     3065       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3066     ( buf_goods.gds-code,
     3067      'mark-type':U,
     3068      output v-par-val,
     3069      output v-par-type
     3070     ).
     3071     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsArticForType(v-par-val)
     3072     or (not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsArticForType(v-par-val)
     3073       and not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     3074       and not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsMarkingForType(v-par-val)
     3075         )
     3076     then do :
     3077       return substitute ("Сверка марок товара &1 '&2' не требуется", buf_goods.gds-code,buf_goods.gds-name).
     3078     end .
     3079     if v-isweighed
     3080     and v-par-val > ""
     3081     and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     3082     and not available buf_marking
     3083     then do :
     3084       return "Марка не найдена в БД" .
     3085     end .
     3086     define variable v-attr-value as character no-undo.
     3087     define variable v-attr-type as character no-undo.
     3088    run gdsoattr-value in this-procedure (input   'mark-collect-type':U,
     3089                                           input   buf_goods.gds-code,
     3090                                           input   v-cntxt-obj-type,
     3091                                           input   v-cntxt-obj-code,
     3092                                           output  v-attr-value,
     3093                                           output  v-attr-type
     3094                                           ) no-error.
     3095     find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = idb-num
     3096                                                and buf_utd-marking-lines.doc-id = idoc-id
     3097                                                and buf_utd-marking-lines.mark begins v-mark-short
     3098                                                no-error.
     3099     if available buf_utd-marking-lines
     3100     then do :
     3101        return substitute ("Марка &1 добавлена в документ ранее.",imark).
     3102     end .
     3103     find first buf_utd-lines exclusive-lock where buf_utd-lines.db-num    = idb-num
     3104                                               and buf_utd-lines.doc-id    = idoc-id
     3105                                               and buf_utd-lines.gds-code  = buf_goods.gds-code
     3106                                               no-error .
     3107     if not available buf_utd-lines
     3108     then do :
     3109       if is-initial-set-p
     3110       then do :
     3111         if v-attr-value = "1"
     3112         or v-attr-value = "2"
     3113         then do :
     3114           message substitute("Для товара &1 ранее был выполнен первоначальный сбор марок, хотите произвести его повторно?", buf_goods.gds-name)
     3115           view-as alert-box question buttons yes-no update v-ok .
     3116           if not v-ok
     3117           then do :
     3118             return "" .
     3119           end .
     3120         end .
     3121           else do :
     3122           disable is-initial-set with frame Dialog-Frame .
     3123         end .
     3124       end .
     3125       else do :
     3126         if v-attr-value = ""
     3127         or v-attr-value = "0"
     3128         then do :
     3129           if vLineNum = 0
     3130           then do :
     3131             assign is-initial-set = yes .
     3132             display is-initial-set with frame Dialog-Frame .
     3133           end .
     3134           else do :
     3135             message substitute("Для товара &1 не выполнен первоначальный сбор марок, товар не может быть добавлен в документ без признака «Первоначальный сбор марок». Создайте для товара отдельный документ", buf_goods.gds-name)
     3136             view-as alert-box .
     3137             return "".
     3138           end .
     3139         end .
     3140       end .
     3141       vLineNum = vLineNum + 1.
     3142       create buf_utd-lines .
     3143       assign
     3144         buf_utd-lines.db-num    = idb-num
     3145         buf_utd-lines.doc-id    = idoc-id
     3146         buf_utd-lines.gds-code  = buf_goods.gds-code
     3147         buf_utd-lines.UnitCode  = buf_goods.unit-base
     3148         buf_utd-lines.LineNum   = vLineNum
     3149       .
     3150       assign v-free-qnty = 0 .
     3151       find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     3152                                        and buf_gds-obj.obj-code  = v-cntxt-obj-code
     3153                                        and buf_gds-obj.artic     = buf_goods.artic
     3154                                        and buf_gds-obj.prod-type = buf_goods.prod-type
     3155                                        and buf_gds-obj.prod-code = buf_goods.prod-code
     3156                                        no-error .
     3157       if available buf_gds-obj
     3158       then do :
     3159         assign v-free-qnty = buf_gds-obj.free-qnty .
     3160       end .
     3161       create tt-utd-lines .
     3162       buffer-copy buf_utd-lines to tt-utd-lines
     3163       assign
     3164         tt-utd-lines.free-qnty = v-free-qnty
     3165         tt-utd-lines.GdsName = buf_goods.gds-name
     3166       .
     3167     end .
     3168     if v-isweighed
     3169     then do :
     3170       find first buf_marking-attr where buf_marking-attr.mark      eq buf_marking.mark
     3171                                     and buf_marking-attr.attr-code eq "weight"
     3172       no-lock no-error.
     3173       if avail buf_marking-attr
     3174       then
     3175         v-mark-weight = dec(buf_marking-attr.attr-value) .
     3176       .
     3177       assign
     3178         buf_utd-lines.Quantity = buf_utd-lines.Quantity + v-mark-weight
     3179       .
     3180     end .
     3181     else do :
     3182       assign
     3183         buf_utd-lines.Quantity = buf_utd-lines.Quantity + v-GTIN-qnty
     3184       .
     3185     end .
     3186     for each buf_marking-child no-lock where buf_marking-child.mark-parent begins v-mark-short,
     3187     first buf_utd-marking-lines-child no-lock where buf_utd-marking-lines-child.mark = buf_marking-child.mark
     3188                                                 and buf_utd-marking-lines-child.db-num  = buf_utd-lines.db-num
     3189                                                 and buf_utd-marking-lines-child.doc-id  = buf_utd-lines.doc-id
     3190                                                 and buf_utd-marking-lines-child.LineNum = buf_utd-lines.LineNum
     3191     :
     3192       assign
     3193         v-GTIN-child = getGtinByDM(buf_marking-child.mark)
     3194         v-GTIN-qnty-child = getQntyCodeByGtin(v-GTIN-child)
     3195         buf_utd-lines.Quantity = buf_utd-lines.Quantity - v-GTIN-qnty-child
     3196       .
     3197     end .
     3198     find first tt-utd-lines exclusive-lock where tt-utd-lines.db-num    = buf_utd.db-num
     3199                                              and tt-utd-lines.doc-id    = buf_utd.doc-id
     3200                                              and tt-utd-lines.gds-code  = buf_goods.gds-code
     3201                                              no-error .
     3202     assign
     3203       tt-utd-lines.Quantity  = buf_utd-lines.Quantity
     3204       tt-utd-lines.qnty-mark = tt-utd-lines.qnty-mark + 1
     3205     .
     3206     if available buf_marking
     3207     then do :
     3208       create buf_utd-marking-lines .
     3209       assign
     3210         buf_utd-marking-lines.mark      = buf_marking.mark
     3211         buf_utd-marking-lines.gds-code  = buf_goods.gds-code
     3212         buf_utd-marking-lines.sts       = buf_marking.sts
     3213         buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     3214         buf_utd-marking-lines.doc-id    = idoc-id
     3215         buf_utd-marking-lines.db-num    = idb-num
     3216         buf_utd-marking-lines.doc-level = 1
     3217       .
     3218     end .
     3219     else do :
     3220       create buf_marking .
     3221       assign
     3222         buf_marking.mark = v-mark-short
     3223         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3224         buf_marking.box-qnty = v-GTIN-qnty
     3225         buf_marking.obj-type = v-cntxt-obj-type
     3226         buf_marking.obj-code = v-cntxt-obj-code
     3227         buf_marking.gds-code = buf_goods.gds-code
     3228         buf_marking.gds-ext-id = v-GTIN
     3229         buf_marking.unit-ext = (if v-GTIN-qnty = 1 then "UNIT" else if v-GTIN-qnty > 1 then "LEVEL1" else "")
     3230       .
     3231       create buf_utd-marking-lines .
     3232       assign
     3233         buf_utd-marking-lines.mark      = buf_marking.mark
     3234         buf_utd-marking-lines.gds-code  = buf_goods.gds-code
     3235         buf_utd-marking-lines.sts       = 0
     3236         buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     3237         buf_utd-marking-lines.doc-id    = idoc-id
     3238         buf_utd-marking-lines.db-num    = idb-num
     3239         buf_utd-marking-lines.doc-level = 1
     3240       .
     3241     end .
     3242     validate buf_utd-marking-lines .
     3243     return "" .
     3244   end.
     3245   ASSIGN
     3246          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3247          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3248   ASSIGN
     3249      B_mark:POPUP-MENU IN FRAME Dialog-Frame = MENU m_marks:HANDLE.
     3250   ASSIGN
     3251      b_mark:MENU-MOUSE = 1.
     3252   ASSIGN
     3253          f-msg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3254   FUNCTION CliName RETURNS CHARACTER
     3255      (input p-cli-code as integer, input p-cli-type as character) :
     3256      define variable v-cli-name as character no-undo .
     3257      find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
     3258         and buf_clients.obj-type = p-cli-type no-error .
     3259      if available (buf_clients) then v-cli-name = buf_clients.obj-name .
     3260      RETURN v-cli-name.
     3261   END FUNCTION.
     3262   FUNCTION GdsName RETURNS CHARACTER
     3263      ( input p-gds-code as integer) :
     3264      define variable v-gds-name as character no-undo .
     3265      define buffer buf_goods for ub.goods .
     3266      find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     3267      if available (buf_goods) then v-gds-name = buf_goods.gds-name .
     3268      RETURN v-gds-name.
     3269   END FUNCTION.
     3270   FUNCTION StatusTHName RETURNS CHARACTER
     3271      (input p-stsTH as integer)  .
     3272      Return Marking:GetLabel(p-stsTH) .
     3273   END FUNCTION .
     3274   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
     3275   DO:
     3276     assign a-n-c .
     3277     apply "TAB":U to self .
     3278     return no-apply .
     3279   END.
     3280   ON VALUE-CHANGED OF is-initial-set IN FRAME Dialog-Frame
     3281   DO:
     3282     assign is-initial-set .
     3283   END.
     3284   ON VALUE-CHANGED OF f-comment IN FRAME Dialog-Frame
     3285   DO:
     3286     assign f-comment .
     3287   END.
     3288   ON return OF f-comment IN FRAME Dialog-Frame
     3289   DO:
     3290     define variable v-cursor as integer no-undo .
     3291     define variable v-lines as integer no-undo .
     3292     assign f-comment .
     3293     v-cursor = f-comment:cursor-offset .
     3294     v-lines = num-entries((substring(f-comment, 1, v-cursor - 1)), chr(10)) .
     3295     f-comment = substring(f-comment, 1, v-cursor - v-lines) + chr(10) + substring(f-comment, v-cursor + 1 - v-lines) .
     3296     display f-comment with frame Dialog-Frame .
     3297     f-comment:cursor-offset = v-cursor + 2 .
     3298   END.
     3299   ON leave, return OF a-n-c-name IN FRAME Dialog-Frame
     3300   DO:
     3301     assign a-n-c-name .
     3302     assign a-n-c .
     3303     case a-n-c:
     3304        when "code" then
     3305           do:
     3306              find first X_utd-lines where X_utd-lines.gds-code = integer(a-n-c-name) no-error .
     3307              if available (X_utd-lines) then
     3308              do:
     3309                 recid_utd = recid (X_utd-lines) .
     3310                 br-utd-lines :refresh() no-error.
     3311                 reposition br-utd-lines to recid recid_utd no-error .
     3312              end.
     3313           end.
     3314        when "name" then
     3315           do:
     3316              find first X_utd-lines where (X_utd-lines.GdsName begins a-n-c-name) no-error .
     3317              if available (X_utd-lines) then
     3318              do:
     3319                 recid_utd = recid (X_utd-lines) .
     3320                 br-utd-lines :refresh() no-error.
     3321                 reposition br-utd-lines to recid recid_utd no-error .
     3322              end.
     3323           end.
     3324        when "context" then
     3325           do:
     3326              find first X_utd-lines where (X_utd-lines.GdsName MATCHES "*" + a-n-c-name + "*") no-error .
     3327              if available (X_utd-lines) then
     3328              do:
     3329                 recid_utd = recid (X_utd-lines) .
     3330                 br-utd-lines :refresh() no-error.
     3331                 reposition br-utd-lines to recid recid_utd no-error .
     3332              end.
     3333           end.
     3334     end case.
     3335     apply "TAB":U to self .
     3336     return no-apply .
     3337   END.
     3338   ON value-changed OF R-error IN FRAME Dialog-Frame
     3339   DO:
     3340     assign R-error .
     3341     if r-error = 2 then OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK where X_utd-lines.Quantity < X_utd-lines.free-qnty INDEXED-REPOSITION.                                        else OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK INDEXED-REPOSITION.
     3342   END.
     3343   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     3344   DO:
     3345     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3346     run adm/shattri.p (
     3347              input "get":U
     3348              ,input  v-cntxt-obj-type
     3349              ,input  v-cntxt-obj-code
     3350              ,input  'marking':U
     3351              ,input  'rus-key':U
     3352              ,output p-value-character
     3353              ,output p-value-date
     3354              ,output p-value-decimal
     3355              ,output p-value-integer
     3356              ,output p-value-logical
     3357              ,output p-param-type
     3358              ,input-output table-handle v-tth
     3359              ) no-error .
     3360     IF p-value-logical = yes THEN  iLang = 68748313.
     3361     run ActivateKeyboardLayout (input iLang, input 0).
     3362   END.
     3363   ON CHOOSE OF menu-item m_marks-lines
     3364   DO:
     3365     apply "entry" to br-utd-lines in frame Dialog-Frame.
     3366     if available (X_utd-lines) then
     3367     do:
     3368        recid_utd = recid(X_utd-lines) .
     3369        run temp-mark (input 1) .
     3370        if available (tt-marking-lines) then
     3371        do:
     3372           run str/mark_browse.w (input parparentproc,
     3373              input-output table tt-marking-lines by-reference,
     3374              input p-mode,
     3375              input ("Марки по: Сбор марок " + buf_utd.DocumentNumber + " по товару " + string(X_utd-lines.gds-code) + " " + GdsName(X_utd-lines.gds-code)),
     3376              input "0",
     3377              input ""
     3378              ) no-error .
     3379   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3380   do:
     3381     br-utd-lines :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3382   end.
     3383           empty temp-table tt-marking-lines .
     3384        end.
     3385        else
     3386        do:
     3387           message "Нет марок"
     3388              view-as alert-box.
     3389        end.
     3390        br-utd-lines :refresh() no-error .
     3391        apply "VALUE-CHANGED" to br-utd-lines in frame Dialog-Frame.
     3392        apply "entry" to br-utd-lines in frame Dialog-Frame.
     3393        reposition br-utd-lines to recid recid_utd no-error .
     3394     end.
     3395     else message "Нет марок"
     3396           view-as alert-box.
     3397     return no-apply .
     3398   END.
     3399   ON CHOOSE OF menu-item m_marks-utd
     3400   DO:
     3401     apply "entry" to br-utd-lines in frame Dialog-Frame.
     3402     recid_utd = recid (X_utd-lines) .
     3403     run temp-mark (input 2) .
     3404     if available (tt-marking-lines) then
     3405     do:
     3406        run str/mark_browse.w (input parparentproc,
     3407           input-output table tt-marking-lines by-reference,
     3408           input p-mode,
     3409           input "Марки по документу: Сбор марок " + buf_utd.DocumentNumber,
     3410           input "0",
     3411           input ""
     3412           ) no-error .
     3413        empty temp-table tt-marking-lines .
     3414        br-utd-lines:refresh () no-error.
     3415        apply "VALUE-CHANGED" to br-utd-lines in frame Dialog-Frame.
     3416        apply "entry" to br-utd-lines in frame Dialog-Frame.
     3417        reposition br-utd-lines to recid recid_utd no-error .
     3418     end.
     3419     else
     3420     do:
     3421        message "Нет марок по документу"
     3422           view-as alert-box.
     3423     end.
     3424   END.
     3425   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3426   do:
     3427     define buffer bf_utd-lines for ub.utd-lines .
     3428     assign
     3429       is-initial-set
     3430       f-comment
     3431     .
     3432     find first buf_utd-attr exclusive-lock where buf_utd-attr.db-num = buf_utd.db-num
     3433                                              and buf_utd-attr.doc-id = buf_utd.doc-id
     3434                                              and buf_utd-attr.attr-code = "is-initial-set"
     3435                                              no-error .
     3436     if not available buf_utd-attr
     3437     then do :
     3438       create buf_utd-attr .
     3439       assign
     3440         buf_utd-attr.db-num = buf_utd.db-num
     3441         buf_utd-attr.doc-id = buf_utd.doc-id
     3442         buf_utd-attr.attr-code = "is-initial-set"
     3443       .
     3444     end .
     3445     assign buf_utd-attr.attr-value = string(is-initial-set) .
     3446     assign buf_utd.comment = trim(f-comment) .
     3447     find first bf_utd-lines no-lock where bf_utd-lines.db-num = buf_utd.db-num
     3448                                       and bf_utd-lines.doc-id = buf_utd.doc-id
     3449                                       no-error .
     3450     if not available bf_utd-lines
     3451     then do :
     3452       message "Документ пустой. Изменения не будут сохранены" view-as alert-box .
     3453       if p-mode <> 'ПРОСМОТР':U
     3454       and available (buf_utd)
     3455       then do:
     3456         delete buf_utd .
     3457       end .
     3458     end .
     3459   end.
     3460   ON any-printable OF b_del-line IN FRAME Dialog-Frame
     3461   DO:
     3462     run proc-any-key.
     3463   END.
     3464   ON CHOOSE OF b_del-line IN FRAME Dialog-Frame
     3465   DO:
     3466     define buffer bf_utd-lines for ub.utd-lines .
     3467     define buffer bf_utd-marking-lines for ub.utd-marking-lines .
     3468     define buffer bf_marking for ub.marking .
     3469     define variable v-auto as logical no-undo .
     3470     if available X_utd-lines
     3471     then do :
     3472       for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num = X_utd-lines.db-num
     3473                                               and bf_utd-marking-lines.doc-id = X_utd-lines.doc-id
     3474                                               and bf_utd-marking-lines.LineNum = X_utd-lines.LineNum
     3475                                               and bf_utd-marking-lines.sts = 0
     3476       :
     3477         v-auto = g#auto .
     3478         g#auto = true .
     3479         for each bf_marking exclusive-lock where bf_marking.mark = bf_utd-marking-lines.mark
     3480                                              and bf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3481         :
     3482           delete bf_marking .
     3483         end.
     3484         g#auto = v-auto .
     3485       end.
     3486       find first bf_utd-lines exclusive-lock where bf_utd-lines.db-num = X_utd-lines.db-num
     3487                                                and bf_utd-lines.doc-id = X_utd-lines.doc-id
     3488                                                and bf_utd-lines.LineNum = X_utd-lines.LineNum
     3489                                                no-error .
     3490       if available bf_utd-lines
     3491       then do :
     3492         delete bf_utd-lines .
     3493       end .
     3494       vLineNum = X_utd-lines.LineNum - 1 .
     3495       delete X_utd-lines .
     3496       for each tt-utd-lines where tt-utd-lines.LineNum > vLineNum,
     3497       first bf_utd-lines exclusive-lock where bf_utd-lines.db-num = tt-utd-lines.db-num
     3498                                           and bf_utd-lines.doc-id = tt-utd-lines.doc-id
     3499                                           and bf_utd-lines.LineNum = tt-utd-lines.LineNum
     3500                                           break by tt-utd-lines.LineNum
     3501       :
     3502         for each bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.db-num = bf_utd-lines.db-num
     3503                                                        and bf_utd-marking-lines.doc-id = bf_utd-lines.doc-id
     3504                                                        and bf_utd-marking-lines.LineNum = bf_utd-lines.LineNum
     3505         :
     3506           bf_utd-marking-lines.LineNum = bf_utd-marking-lines.LineNum - 1 .
     3507         end .
     3508         tt-utd-lines.LineNum = tt-utd-lines.LineNum - 1 .
     3509         bf_utd-lines.LineNum = tt-utd-lines.LineNum .
     3510         if last-of(tt-utd-lines.LineNum)
     3511         then do :
     3512           vLineNum = tt-utd-lines.LineNum .
     3513         end .
     3514       end .
     3515       if r-error = 2 then OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK where X_utd-lines.Quantity < X_utd-lines.free-qnty INDEXED-REPOSITION.                                        else OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK INDEXED-REPOSITION.
     3516     end .
     3517     if is-initial-set
     3518     and not is-initial-set:sensitive
     3519     then do :
     3520       assign disable-set = no .
     3521       for each X_utd-lines no-lock where X_utd-lines.db-num = buf_utd.db-num
     3522                                      and X_utd-lines.doc-id = buf_utd.doc-id
     3523       :
     3524         run gdsoattr-value in this-procedure (input   'mark-collect-type':U,
     3525                                               input   X_utd-lines.gds-code,
     3526                                               input   buf_utd.obj-type,
     3527                                               input   buf_utd.obj-code,
     3528                                               output  v-attr-value,
     3529                                               output  v-attr-type
     3530                                               ) no-error.
     3531         if is-initial-set
     3532         and (v-attr-value = "" or v-attr-value = "0")
     3533         then do :
     3534           assign disable-set = yes .
     3535           leave .
     3536         end .
     3537       end .
     3538       if not disable-set then enable is-initial-set with frame Dialog-Frame .
     3539     end .
     3540   END.
     3541   ON any-printable OF b_prov-finish IN FRAME Dialog-Frame
     3542   DO:
     3543     run proc-any-key.
     3544   END.
     3545   ON CHOOSE OF b_prov-finish IN FRAME Dialog-Frame
     3546   DO:
     3547     define variable v-ok        as logical no-undo .
     3548     define buffer bf_utd-marking-lines for ub.utd-marking-lines .
     3549     define buffer bf2_utd-marking-lines for ub.utd-marking-lines .
     3550     define buffer bf_utd-lines-attr    for ub.utd-lines-attr .
     3551     define buffer bf_utd-lines         for ub.utd-lines .
     3552     define buffer bf_marking           for ub.marking .
     3553     define buffer bf_marking-parent    for ub.marking .
     3554     define variable vPawd as character no-undo.
     3555     assign
     3556       is-initial-set
     3557       f-comment
     3558     .
     3559     find first buf_utd-attr exclusive-lock where buf_utd-attr.db-num = buf_utd.db-num
     3560                                              and buf_utd-attr.doc-id = buf_utd.doc-id
     3561                                              and buf_utd-attr.attr-code = "is-initial-set"
     3562                                              no-error .
     3563     if not available buf_utd-attr
     3564     then do :
     3565       create buf_utd-attr .
     3566       assign
     3567         buf_utd-attr.db-num = buf_utd.db-num
     3568         buf_utd-attr.doc-id = buf_utd.doc-id
     3569         buf_utd-attr.attr-code = "is-initial-set"
     3570       .
     3571     end .
     3572     assign buf_utd-attr.attr-value = string(is-initial-set) .
     3573     assign buf_utd.comment = trim(f-comment) .
     3574     find first bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num = buf_utd.db-num
     3575                                               and bf_utd-marking-lines.doc-id = buf_utd.doc-id
     3576                                               no-error .
     3577     if not available (bf_utd-marking-lines)
     3578     then do:
     3579       message "Документ пустой. Завершить его обработку невозможно"
     3580         view-as alert-box.
     3581       return no-apply .
     3582     end.
     3583     v-ok = yes .
     3584     for first X_utd-lines where X_utd-lines.Quantity < X_utd-lines.free-qnty:
     3585       v-ok = no .
     3586     end.
     3587     if not v-ok
     3588     then do:
     3589       message "Документ содержит товары, по которым количество просканированных марок меньше остатков в системе (выделены красным в интерфейсе). Продолжить закрытие документа?"
     3590       view-as alert-box question buttons yes-no update v-ok .
     3591     end .
     3592     if not v-ok
     3593     then
     3594       return no-apply .
     3595     run adm\ask-pswd.w ("Введите пароль пользователя, осуществляющего закрытие сбора марок, с целью подтверждения внесенных фактических остатков марок на АЗК.",output vPawd).
     3596     if  vPawd eq ?
     3597     then
     3598       return no-apply .
     3599     If vPawd ne encode(g#passwd)
     3600     then do:
     3601       message "Введен неправильный пароль" view-as alert-box .
     3602       return no-apply .
     3603     end.
     3604     run waitfram-show in this-procedure (input "ЖДИТЕ...") .
     3605     for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num  = buf_utd.db-num
     3606                                             and bf_utd-marking-lines.doc-id  = buf_utd.doc-id
     3607                                             and bf_utd-marking-lines.site   <> "only-send",
     3608     first bf_marking no-lock where bf_marking.mark = bf_utd-marking-lines.mark
     3609     :
     3610       if bf_marking.mark-parent > ""
     3611       then do :
     3612         for first bf_marking-parent no-lock where bf_marking-parent.mark = bf_marking.mark-parent :
     3613           if bf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3614           or bf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB
     3615           then do :
     3616             if not can-find (first bf2_utd-marking-lines where bf2_utd-marking-lines.db-num  = bf_utd-marking-lines.db-num
     3617                                                            and bf2_utd-marking-lines.doc-id  = bf_utd-marking-lines.doc-id
     3618                                                            and bf2_utd-marking-lines.LineNum = bf_utd-marking-lines.LineNum
     3619                                                            and bf2_utd-marking-lines.mark    = bf_marking-parent.mark
     3620                                                            and bf2_utd-marking-lines.site   <> "only-send"
     3621                                                            no-lock)
     3622             then do :
     3623               find current bf_marking-parent exclusive-lock .
     3624               assign bf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     3625             end .
     3626           end .
     3627         end .
     3628       end .
     3629     end .
     3630     for each bf_utd-lines no-lock where bf_utd-lines.db-num = buf_utd.db-num
     3631                                     and bf_utd-lines.doc-id = buf_utd.doc-id,
     3632     first buf_goods no-lock where buf_goods.gds-code = bf_utd-lines.gds-code
     3633     :
     3634       for each bf_marking no-lock where bf_marking.gds-code = bf_utd-lines.gds-code :
     3635         if not can-find (first bf_utd-marking-lines where bf_utd-marking-lines.db-num  = bf_utd-lines.db-num
     3636                                                       and bf_utd-marking-lines.doc-id  = bf_utd-lines.doc-id
     3637                                                       and bf_utd-marking-lines.LineNum = bf_utd-lines.LineNum
     3638                                                       and bf_utd-marking-lines.mark    = bf_marking.mark
     3639                                                       and bf_utd-marking-lines.site   <> "only-send"
     3640                                                       no-lock)
     3641         and bf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3642         then do :
     3643           find current bf_marking exclusive-lock .
     3644           assign bf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB .
     3645           find first bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num  = bf_utd-lines.db-num
     3646                                                     and bf_utd-marking-lines.doc-id  = bf_utd-lines.doc-id
     3647                                                     and bf_utd-marking-lines.LineNum = bf_utd-lines.LineNum
     3648                                                     and bf_utd-marking-lines.mark    = bf_marking.mark
     3649                                                     no-error .
     3650           if not available bf_utd-marking-lines
     3651           then do :
     3652             create bf_utd-marking-lines .
     3653             assign
     3654               bf_utd-marking-lines.db-num    = bf_utd-lines.db-num
     3655               bf_utd-marking-lines.doc-id    = bf_utd-lines.doc-id
     3656               bf_utd-marking-lines.LineNum   = bf_utd-lines.LineNum
     3657               bf_utd-marking-lines.mark      = bf_marking.mark
     3658               bf_utd-marking-lines.gds-code  = bf_utd-lines.gds-code
     3659               bf_utd-marking-lines.sts       = bf_marking.sts
     3660               bf_utd-marking-lines.doc-level = 1
     3661               bf_utd-marking-lines.site      = "only-send"
     3662             .
     3663           end .
     3664         end .
     3665       end .
     3666       if is-initial-set
     3667       then do :
     3668         run gdsoattr-value in this-procedure (input   'mark-collect-type':U,
     3669                                               input   bf_utd-lines.gds-code,
     3670                                               input   buf_utd.obj-type,
     3671                                               input   buf_utd.obj-code,
     3672                                               output  v-attr-value,
     3673                                               output  v-attr-type
     3674                                               ) no-error.
     3675         if v-attr-value = ""
     3676         or v-attr-value = "0"
     3677         then do:
     3678           run gdsoattr-write (input bf_utd-lines.gds-code,
     3679                               input buf_utd.obj-type,
     3680                               input buf_utd.obj-code,
     3681                               input 'mark-collect-type':U,
     3682                               input "1"
     3683                               ).
     3684         end.
     3685       end .
     3686       else do :
     3687         run gdsoattr-write (input bf_utd-lines.gds-code,
     3688                             input buf_utd.obj-type,
     3689                             input buf_utd.obj-code,
     3690                             input 'mark-collect-type':U,
     3691                             input "2"
     3692                             ).
     3693       end .
     3694       find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     3695                                        and buf_gds-obj.obj-code  = v-cntxt-obj-code
     3696                                        and buf_gds-obj.artic     = buf_goods.artic
     3697                                        and buf_gds-obj.prod-type = buf_goods.prod-type
     3698                                        and buf_gds-obj.prod-code = buf_goods.prod-code
     3699                                        no-error .
     3700       find first X_utd-lines no-lock where bf_utd-lines.doc-id = X_utd-lines.doc-id
     3701                                        and bf_utd-lines.db-num = X_utd-lines.db-num
     3702                                        and bf_utd-lines.LineNum = X_utd-lines.LineNum
     3703                                        no-error .
     3704       find first buf_utd-lines-attr exclusive-lock where buf_utd-lines-attr.doc-id = bf_utd-lines.doc-id
     3705                                                      and buf_utd-lines-attr.db-num = bf_utd-lines.db-num
     3706                                                      and buf_utd-lines-attr.LineNum = bf_utd-lines.LineNum
     3707                                                      and buf_utd-lines-attr.attr-code = "comfimed-free-qnty"
     3708                                                      no-error .
     3709       if not available buf_utd-lines-attr
     3710       then do :
     3711         create buf_utd-lines-attr .
     3712         assign
     3713           buf_utd-lines-attr.doc-id = bf_utd-lines.doc-id
     3714           buf_utd-lines-attr.db-num = bf_utd-lines.db-num
     3715           buf_utd-lines-attr.LineNum = bf_utd-lines.LineNum
     3716           buf_utd-lines-attr.attr-code = "comfimed-free-qnty"
     3717         .
     3718       end .
     3719       if available buf_gds-obj
     3720       then do :
     3721         assign buf_utd-lines-attr.attr-value = string(buf_gds-obj.free-qnty) .
     3722       end .
     3723       else
     3724       if available X_utd-lines
     3725       then do :
     3726         assign buf_utd-lines-attr.attr-value = string(X_utd-lines.free-qnty) .
     3727       end .
     3728     end .
     3729     if is-initial-set
     3730     then do :
     3731       for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num  = buf_utd.db-num
     3732                                               and bf_utd-marking-lines.doc-id  = buf_utd.doc-id
     3733                                               and bf_utd-marking-lines.site   <> "only-send",
     3734       first bf_marking no-lock where bf_marking.mark = bf_utd-marking-lines.mark
     3735       :
     3736         if bf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB
     3737         then do :
     3738           find current bf_marking exclusive-lock .
     3739           assign bf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3740         end .
     3741       end .
     3742     end .
     3743     assign buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB .
     3744     validate buf_utd .
     3745     run waitfram-hide in this-procedure .
     3746     apply "choose" to b-exit in frame Dialog-Frame .
     3747   END.
     3748   ON VALUE-CHANGED OF c-status IN FRAME Dialog-Frame
     3749   DO:
     3750     assign c-status .
     3751     if c-type = 0 then
     3752     do:
     3753       message "Укажите тип документа"
     3754         view-as alert-box.
     3755     end.
     3756     buf_utd.sts = integer(c-status).
     3757     validate buf_utd no-error.
     3758     c-status = buf_utd.sts.
     3759     display c-status with frame Dialog-Frame .
     3760   END.
     3761   ON VALUE-CHANGED OF c-type IN FRAME Dialog-Frame
     3762   DO:
     3763     assign c-type .
     3764     if available (buf_utd) then buf_utd.EDocType = c-type .
     3765     F-msg = "                            Просканируйте марку" .
     3766     display F-msg with frame Dialog-Frame .
     3767     run enable_UI .
     3768   END.
     3769   ON leave OF f-date IN FRAME Dialog-Frame
     3770   DO:
     3771       assign f-date .
     3772       if f-num:SCREEN-VALUE <> "" and f-num:SCREEN-VALUE <> ? then do:
     3773           find first ub.utd no-lock where ub.utd.DocumentNumber = f-num
     3774               and ub.utd.DocumentDate = f-date
     3775               and (ub.utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     3776               or ub.utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB)no-error .
     3777           if AVAILABLE (ub.utd) then
     3778           do:
     3779               MESSAGE "Документ с № " + ub.utd.DocumentNumber + " от даты: " + string(ub.utd.DocumentDate) + " уже заведен в системе." skip
     3780                   VIEW-AS ALERT-BOX.
     3781               return NO-APPLY .
     3782           end.
     3783       end.
     3784       display f-date with frame Dialog-Frame .
     3785   END.
     3786   ON RETURN OF f-date IN FRAME Dialog-Frame
     3787   DO:
     3788     apply "TAB":U to self .
     3789     return no-apply .
     3790   END.
     3791   ON TAB OF f-date IN FRAME Dialog-Frame
     3792   DO:
     3793       assign f-date .
     3794       display f-date with frame Dialog-Frame .
     3795   END.
     3796   ON leave OF f-num IN FRAME Dialog-Frame
     3797   DO:
     3798       assign f-num .
     3799       if f-date:SCREEN-VALUE <> "" and f-num:SCREEN-VALUE <> "" then do:
     3800           find first ub.utd no-lock where ub.utd.DocumentNumber = f-num
     3801               and ub.utd.DocumentDate = f-date
     3802               and (ub.utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     3803               or ub.utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB)no-error .
     3804           if AVAILABLE (ub.utd) then
     3805           do:
     3806               MESSAGE "Документ с № " + ub.utd.DocumentNumber + " от даты: " + string(ub.utd.DocumentDate) + " уже заведен в системе." skip
     3807                   VIEW-AS ALERT-BOX.
     3808               return NO-APPLY .
     3809           end.
     3810       end.
     3811       display f-num with frame Dialog-Frame .
     3812   END.
     3813   ON ROW-DISPLAY OF br-utd-lines IN FRAME Dialog-Frame
     3814   DO:
     3815     if available X_utd-lines
     3816     then do :
     3817       if buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3818       then do :
     3819         find first buf_goods no-lock where buf_goods.gds-code = X_utd-lines.gds-code .
     3820         find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     3821                                          and buf_gds-obj.obj-code  = v-cntxt-obj-code
     3822                                          and buf_gds-obj.artic     = buf_goods.artic
     3823                                          and buf_gds-obj.prod-type = buf_goods.prod-type
     3824                                          and buf_gds-obj.prod-code = buf_goods.prod-code
     3825                                          no-error .
     3826         if available buf_gds-obj
     3827         then do :
     3828           if buf_gds-obj.free-qnty <> X_utd-lines.free-qnty
     3829           then do :
     3830             assign X_utd-lines.free-qnty = buf_gds-obj.free-qnty .
     3831           end .
     3832         end .
     3833       end .
     3834       if X_utd-lines.Quantity < X_utd-lines.free-qnty
     3835       then do :
     3836         assign
     3837           X_utd-lines.LineNum     :fGCOLOR in browse br-utd-lines = red_COLOR
     3838           X_utd-lines.gds-code    :fGCOLOR in browse br-utd-lines = red_COLOR
     3839           X_utd-lines.GdsName     :fGCOLOR in browse br-utd-lines = red_COLOR
     3840           X_utd-lines.UnitCode    :fGCOLOR in browse br-utd-lines = red_COLOR
     3841           X_utd-lines.Quantity    :fGCOLOR in browse br-utd-lines = red_COLOR
     3842           X_utd-lines.free-qnty   :fGCOLOR in browse br-utd-lines = red_COLOR
     3843         .
     3844       end .
     3845     end .
     3846   END .
     3847   ON value-changed OF f-num IN FRAME Dialog-Frame
     3848   DO:
     3849     assign f-num .
     3850     display f-num with frame Dialog-Frame .
     3851   END.
     3852   ON CHOOSE OF r-obj-TH IN FRAME Dialog-Frame
     3853   DO:
     3854   END.
     3855   ON any-printable OF v-mark IN FRAME Dialog-Frame
     3856   do:
     3857     run proc-any-key.
     3858   end.
     3859   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     3860   DO:
     3861       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3862       run adm/shattri.p (
     3863                  input "get":U
     3864                  ,input  v-cntxt-obj-type
     3865                  ,input  v-cntxt-obj-code
     3866                  ,input  'marking':U
     3867                  ,input  'rus-key':U
     3868                  ,output p-value-character
     3869                  ,output p-value-date
     3870                  ,output p-value-decimal
     3871                  ,output p-value-integer
     3872                  ,output p-value-logical
     3873                  ,output p-param-type
     3874                  ,input-output table-handle v-tth
     3875                  ) no-error .
     3876       IF p-value-logical = yes THEN  iLang = 68748313.
     3877       run ActivateKeyboardLayout (input iLang, input 0).
     3878     END.
     3879   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     3880   DO:
     3881       assign frame Dialog-Frame v-mark .
     3882   END.
     3883   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     3884   DO:
     3885       run save_update .
     3886   END.
     3887   ON return OF v-mark IN FRAME Dialog-Frame
     3888   DO:
     3889       run save_update .
     3890   END.
     3891   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3892   do:
     3893     APPLY "CLOSE":U TO THIS-PROCEDURE.
     3894     if p-mode = 'ДОБАВЛЕНИЕ':U and available (buf_utd) then
     3895     do:
     3896        delete buf_utd .
     3897     end.
     3898   end.
     3899   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3900     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3901   MAIN-BLOCK:
     3902   do trans ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3903     :
     3904   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3905     run mainmenu_getcntxt in parparentproc
     3906       (output v-cntxt-db-num
     3907       ,output v-cntxt-userid
     3908       ,output v-cntxt-level
     3909       ,output v-cntxt-host-code-obj
     3910       ,output v-cntxt-obj-type
     3911       ,output v-cntxt-obj-code
     3912       ,output v-cntxt-db-num-obj
     3913       ,output v-cntxt-is-admin
     3914       ) .
     3915     assign v-num-str = 0 .
     3916     Marking = ObjSrv:Env:Marking:Sts:Mark .
     3917     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3918     run adm/shattri.p (
     3919              input "get":U
     3920              ,input  v-cntxt-obj-type
     3921              ,input  v-cntxt-obj-code
     3922              ,input  'marking':U
     3923              ,input  'rus-key':U
     3924              ,output p-value-character
     3925              ,output p-value-date
     3926              ,output p-value-decimal
     3927              ,output p-value-integer
     3928              ,output p-value-logical
     3929              ,output p-param-type
     3930              ,input-output table-handle v-tth
     3931              ) no-error .
     3932     IF p-value-logical = yes THEN  iLang = 68748313.
     3933     run ActivateKeyboardLayout (input iLang, input 0).
     3934     if p-mode = 'ДОБАВЛЕНИЕ':U then
     3935     do:
     3936       if not available (buf_utd) then
     3937       do:
     3938         create buf_utd .
     3939         assign
     3940           buf_utd.DocumentDate = today
     3941           buf_utd.sts          = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3942           buf_utd.obj-code     = v-cntxt-obj-code
     3943           buf_utd.obj-type     = v-cntxt-obj-type
     3944           buf_utd.host-code    = v-cntxt-host-code-obj
     3945           buf_utd.EDocType     = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     3946         .
     3947         validate buf_utd .
     3948         assign buf_utd.DocumentNumber = string(buf_utd.doc-id) + "-" + string(v-cntxt-obj-code) + substring(v-cntxt-obj-type,1,1) .
     3949       end.
     3950     end.
     3951     else
     3952     do:
     3953       if p-mode = 'ПРОСМОТР':U then find first buf_utd no-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-error .
     3954       if p-mode = 'ИЗМЕНЕНИЕ':U then find first buf_utd exclusive-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-wait no-error .
     3955       if  error-status:error then
     3956       do:
     3957         message "Документ занят другим пользователем"
     3958         view-as alert-box.
     3959         p-mode = 'ПРОСМОТР':U .
     3960         find first buf_utd no-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-error .
     3961       end.
     3962     end.
     3963     if available (buf_utd) then
     3964     do:
     3965       assign
     3966         f-num          = buf_utd.DocumentNumber
     3967         f-date         = buf_utd.DocumentDate
     3968         c-status       = buf_utd.sts
     3969         f-obj-code-TH  = buf_utd.obj-code
     3970         f-obj-type-TH  = buf_utd.obj-type
     3971         f-obj-name-TH  = CliName(buf_utd.obj-code, buf_utd.obj-type)
     3972         c-type         = buf_utd.EDocType
     3973         f-comment      = buf_utd.comment
     3974       .
     3975       assign
     3976         frame Dialog-Frame:title = "Сбор марок_____№ " + string (buf_utd.DocumentNumber) + "_____" + p-mode
     3977       .
     3978     end .
     3979     find first buf_utd-attr no-lock where buf_utd-attr.db-num = buf_utd.db-num
     3980                                       and buf_utd-attr.doc-id = buf_utd.doc-id
     3981                                       and buf_utd-attr.attr-code = "is-initial-set"
     3982                                       no-error .
     3983     if available buf_utd-attr
     3984     then do :
     3985       assign is-initial-set = logical(buf_utd-attr.attr-value) no-error .
     3986     end .
     3987     assign vLineNum = 0 .
     3988     for each buf_utd-lines no-lock where buf_utd-lines.doc-id = buf_utd.doc-id
     3989                                      and buf_utd-lines.db-num = buf_utd.db-num,
     3990     first buf_goods no-lock where buf_goods.gds-code = buf_utd-lines.gds-code
     3991     :
     3992       assign vLineNum = max(vLineNum, buf_utd-lines.LineNum) .
     3993       find first X_utd-lines EXCLUSIVE-LOCK where buf_utd-lines.doc-id = X_utd-lines.doc-id
     3994                                               and buf_utd-lines.db-num = X_utd-lines.db-num
     3995                                               and buf_utd-lines.LineNum = X_utd-lines.LineNum
     3996                                               no-error .
     3997       buffer-copy buf_utd-lines to X_utd-lines .
     3998       assign X_utd-lines.GdsName = buf_goods.gds-name .
     3999       if buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
     4000       then do :
     4001         find first buf_utd-lines-attr no-lock where buf_utd-lines-attr.doc-id = buf_utd-lines.doc-id
     4002                                                 and buf_utd-lines-attr.db-num = buf_utd-lines.db-num
     4003                                                 and buf_utd-lines-attr.LineNum = buf_utd-lines.LineNum
     4004                                                 and buf_utd-lines-attr.attr-code = "comfimed-free-qnty"
     4005                                                 no-error .
     4006         if available buf_utd-lines-attr
     4007         then do :
     4008           assign X_utd-lines.free-qnty = decimal(buf_utd-lines-attr.attr-value) .
     4009         end .
     4010       end .
     4011       else do :
     4012         find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     4013                                          and buf_gds-obj.obj-code  = v-cntxt-obj-code
     4014                                          and buf_gds-obj.artic     = buf_goods.artic
     4015                                          and buf_gds-obj.prod-type = buf_goods.prod-type
     4016                                          and buf_gds-obj.prod-code = buf_goods.prod-code
     4017                                          no-error .
     4018         if available buf_gds-obj
     4019         then do :
     4020           assign X_utd-lines.free-qnty = buf_gds-obj.free-qnty .
     4021         end .
     4022       end .
     4023       for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     4024                                                and buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     4025                                                and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum
     4026                                                and buf_utd-marking-lines.doc-level = 1
     4027                                                and buf_utd-marking-lines.site    <> "only-send"
     4028       :
     4029         assign X_utd-lines.qnty-mark = X_utd-lines.qnty-mark + 1 .
     4030       end .
     4031       if not disable-set
     4032       then do :
     4033         run gdsoattr-value in this-procedure (input   'mark-collect-type':U,
     4034                                               input   buf_goods.gds-code,
     4035                                               input   buf_utd.obj-type,
     4036                                               input   buf_utd.obj-code,
     4037                                               output  v-attr-value,
     4038                                               output  v-attr-type
     4039                                               ) no-error.
     4040         if is-initial-set
     4041         and (v-attr-value = "" or v-attr-value = "0")
     4042         then do :
     4043           assign disable-set = yes .
     4044         end .
     4045       end .
     4046     end .
     4047     RUN enable_UI.
     4048     display
     4049       F-msg
     4050       f-num
     4051       f-date
     4052       c-type
     4053       c-status
     4054       f-obj-code-TH
     4055       f-obj-type-TH
     4056       f-obj-name-TH
     4057       f-comment
     4058       is-initial-set
     4059     with frame Dialog-Frame.
     4060     apply "entry" to v-mark in FRAME Dialog-Frame.
     4061     enable v-mark with frame Dialog-Frame.
     4062     on F9 of frame Dialog-Frame anywhere
     4063     do:
     4064       if not available X_utd-lines then  return no-apply.
     4065       find first goods no-lock where goods.gds-code = X_utd-lines.gds-code .
     4066       gds-rec = recid(goods) .
     4067       run ref/gds-form.w
     4068           (input  parParentProc
     4069           ,input  'ПРОСМОТР':U
     4070           ,input  v-cntxt-obj-type
     4071           ,input  v-cntxt-obj-code
     4072           ,input ?
     4073           ,input-output gds-rec
     4074           ).
     4075       apply "entry" to br-utd-lines in frame Dialog-Frame.
     4076       return no-apply.
     4077     end.
     4078     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     4079     then v-manual = yes.
     4080     else do:
     4081       v-manual = no .
     4082       v-mark:READ-ONLY IN FRAME Dialog-Frame = TRUE .
     4083     end.
     4084     if p-mode = 'ПРОСМОТР':U
     4085     then do :
     4086       disable v-mark b-exit b_prov-finish b_del-line is-initial-set with frame Dialog-Frame.
     4087       f-comment:read-only = yes .
     4088     end .
     4089     if disable-set then disable is-initial-set with frame Dialog-Frame.
     4090     WAIT-FOR GO OF FRAME Dialog-Frame focus v-mark .
     4091   END.
     4092   RUN disable_UI.
     4093   PROCEDURE ActivateKeyboardLayout external "user32" :
     4094   define input parameter P1 as LONG.
     4095      define input parameter P2 as LONG.
     4096   END PROCEDURE.
     4097   PROCEDURE CrCheckMark :
     4098     define variable vmes as character no-undo.
     4099     vmes = CrCheckMarkDoc(v-cntxt-obj-type, v-cntxt-obj-code,
     4100                    buf_utd.db-num, buf_utd.doc-id,
     4101                    v-mark:screen-value in frame Dialog-Frame,
     4102                    is-initial-set).
     4103      if vmes ne ""
     4104      then
     4105         run dispmessage (vmes).
     4106     end.
     4107   PROCEDURE temp-mark :
     4108      define input parameter p-id as integer no-undo .
     4109      define buffer buf_marking for ub.marking .
     4110      empty temp-table tt-marking-lines .
     4111      define variable mQuery as handle    no-undo.
     4112      define variable vqry   as character no-undo.
     4113      define variable vsite  as character no-undo.
     4114      vsite = " and buf_utd-marking-lines.site <> 'only-send'" .
     4115      create query mQuery.
     4116      mQuery:set-buffers(buffer buf_utd-marking-lines:HANDLE).
     4117      vqry = substitute("for each buf_utd-marking-lines no-lock where ~
     4118                                  buf_utd-marking-lines.db-num = &1 ~
     4119                              and buf_utd-marking-lines.doc-id = &2 "
     4120                              ,  buf_utd.db-num, buf_utd.doc-id, vsite).
     4121      if p-id = 1
     4122      then
     4123         vqry = vqry + substitute (" and buf_utd-marking-lines.LineNum = &1",X_utd-lines.LineNum).
     4124       mQuery:query-prepare(vqry + vsite).
     4125       mQuery:query-open ().
     4126       mQuery:get-first ().
     4127       do while not mQuery:query-off-end:
     4128          create tt-marking-lines .
     4129          assign
     4130             tt-marking-lines.gds-name  = GdsName(buf_utd-marking-lines.gds-code)
     4131             tt-marking-lines.stts-utd  = StatusTHName(buf_utd-marking-lines.sts)
     4132             tt-marking-lines.mark      = buf_utd-marking-lines.mark
     4133             tt-marking-lines.gds-code  = buf_utd-marking-lines.gds-code
     4134             tt-marking-lines.sts-utd   = buf_utd-marking-lines.sts
     4135             tt-marking-lines.LineNum   = buf_utd-marking-lines.LineNum
     4136             tt-marking-lines.db-num    = buf_utd-marking-lines.db-num
     4137             tt-marking-lines.doc-id    = buf_utd-marking-lines.doc-id
     4138             tt-marking-lines.doc-level = buf_utd-marking-lines.doc-level
     4139             tt-marking-lines.site      = buf_utd-marking-lines.site
     4140          .
     4141          tt-marking-lines.isMark    = IsMark(tt-marking-lines.mark).
     4142          find first utd-marking-lines-attr where utd-marking-lines-attr.doc-id    eq buf_utd-marking-lines.doc-id
     4143                                              and utd-marking-lines-attr.db-num    eq buf_utd-marking-lines.db-num
     4144                                              and utd-marking-lines-attr.LineNum   eq buf_utd-marking-lines.LineNum
     4145                                              and utd-marking-lines-attr.mark      eq buf_utd-marking-lines.mark
     4146                                              and utd-marking-lines-attr.attr-code eq "box-qnty"
     4147          no-lock no-error.
     4148          if avail utd-marking-lines-attr
     4149          then
     4150             tt-marking-lines.box-qnty = dec(utd-marking-lines-attr.attr-value).
     4151          if tt-marking-lines.isMark then
     4152          do:
     4153             for first buf_marking  where buf_marking.mark begins buf_utd-marking-lines.mark :
     4154                assign
     4155                   tt-marking-lines.sts         = buf_marking.sts
     4156                   tt-marking-lines.unit        = buf_marking.unit
     4157                   tt-marking-lines.unit-ext    = buf_marking.unit-ext
     4158                   tt-marking-lines.box-qnty    = buf_marking.box-qnty  when tt-marking-lines.box-qnty eq 0 or tt-marking-lines.box-qnty eq ?
     4159                   tt-marking-lines.mark-parent = buf_marking.mark-parent
     4160                .
     4161                tt-marking-lines.stts        = StatusTHName(buf_marking.sts).
     4162             end.
     4163          end.
     4164          else
     4165          do:
     4166             tt-marking-lines.stts-utd = StatusTHName(Marking:Checked_:KeyIntDB) .
     4167          end.
     4168         mQuery:get-next ().
     4169      end.
     4170      delete object mQuery.
     4171   END PROCEDURE.
     4172   PROCEDURE disable_UI :
     4173     HIDE FRAME Dialog-Frame.
     4174   END PROCEDURE.
     4175   PROCEDURE dispmessage :
     4176   define input parameter p-str as character no-undo.
     4177     f-msg:fgcolor in frame Dialog-Frame = 12.
     4178     do:
     4179       display p-str @ f-msg with frame Dialog-Frame.
     4180     end.
     4181   END PROCEDURE.
     4182   PROCEDURE enable_UI :
     4183     DISPLAY c-type f-num-name f-num f-date-name f-date is-initial-set
     4184             f-obj-type-TH f-obj-code-TH f-obj-name-TH f-status-TH c-status
     4185             f-comment f-comment-name v-mark a-n-c a-n-c-name
     4186             f-msg R-error
     4187         WITH FRAME Dialog-Frame.
     4188     ENABLE b-cancel b-exit B_mark
     4189            is-initial-set R-error
     4190            f-comment v-mark a-n-c a-n-c-name
     4191            br-utd-lines b_prov-finish b_del-line
     4192         WITH FRAME Dialog-Frame.
     4193     VIEW FRAME Dialog-Frame.
     4194     if r-error = 2 then OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK where X_utd-lines.Quantity < X_utd-lines.free-qnty INDEXED-REPOSITION.                                        else OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK INDEXED-REPOSITION.
     4195   END PROCEDURE.
     4196   PROCEDURE LoadKeyboardLayoutA external "user32" :
     4197   define input  parameter P1 as char.
     4198     define input  parameter P2 as LONG.
     4199     define return parameter pret as LONG.
     4200   end procedure.
     4201   PROCEDURE proc-any-key :
     4202   if not v-manual
     4203       then
     4204       if v-scan-str = ""
     4205         then etime(yes).
     4206       else
     4207         if etime > 700
     4208           then v-scan-str = "".
     4209     v-scan-str = v-scan-str + last-event:label.
     4210   end.
     4211   PROCEDURE save_update :
     4212   define variable v-error      as logical   no-undo init no.
     4213     define variable l-error      as logical   no-undo init no.
     4214     define variable v-error-lang as logical   no-undo init no.
     4215     define variable v_list    as character no-undo .
     4216     define variable ii           as integer   no-undo .
     4217     define variable chg-qnty     as integer   no-undo .
     4218     do trans:
     4219       f-msg:screen-value in frame Dialog-Frame = "" .
     4220       if v-mark:screen-value in frame Dialog-Frame = ""
     4221       then do:
     4222         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4223         v-scan-str = "".
     4224       end.
     4225       assign
     4226         v-mark = v-mark:screen-value in frame Dialog-Frame.
     4227       if v-mark = ""
     4228         then return.
     4229       assign v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
     4230       do ii = 1 to length (v-mark):
     4231         if lookup(substring(v-mark, ii, 1), v_list) > 1
     4232         then do:
     4233           message "Не корректно считана акцизная марка, перед считыванием переключите клавиатуру на английскую раскладку."
     4234           view-as alert-box.
     4235           v-mark:screen-value in frame Dialog-Frame = "" .
     4236           v-mark = "" .
     4237           return .
     4238         end.
     4239       end.
     4240       run CrCheckMark.
     4241       if r-error = 2 then OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK where X_utd-lines.Quantity < X_utd-lines.free-qnty INDEXED-REPOSITION.                                        else OPEN QUERY br-utd-lines FOR EACH X_utd-lines NO-LOCK INDEXED-REPOSITION.
     4242       v-mark = "".
     4243       v-mark:screen-value in frame Dialog-Frame = "".
     4244       v-mark-short = "".
     4245     end.
     4246   end procedure.
