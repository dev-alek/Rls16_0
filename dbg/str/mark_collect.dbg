     1013   procedure xmlchar-test :
     1014   define input parameter p-in-string          as character        no-undo.
     1015   define output parameter p-out-string-enc    as character        no-undo.
     1016   define output parameter p-out-string-dec    as character        no-undo.
     1017   do
     1018   on error undo, return error
     1019   :
     1020          run xmlchar-encode in this-procedure
     1021       (
     1022             input p-in-string
     1023           , output p-out-string-enc
     1024       ).
     1025          run xmlchar-decode in this-procedure
     1026       (
     1027             input p-out-string-enc
     1028           , output p-out-string-dec
     1029       ).
     1030   end.
     1031   end .
     1032   procedure xmlchar-encode :
     1033   define input parameter p-in-string      as character        no-undo.
     1034   define output parameter p-out-string    as character        no-undo.
     1035       define variable v-position      as integer      no-undo.
     1036       define variable v-current-char  as character    no-undo.
     1037   do
     1038   on error undo, return error
     1039   :
     1040       assign
     1041           p-out-string = "":U
     1042       .
     1043       case p-in-string
     1044       :
     1045           when ?
     1046           then do:
     1047               assign
     1048                   p-out-string = "?":U
     1049               .
     1050           end.
     1051           when "?":U
     1052           then do:
     1053               assign
     1054                   p-out-string = "&#63;":U
     1055               .
     1056           end.
     1057           otherwise do:
     1058               do v-position = 1 to length( p-in-string )
     1059               :
     1060                   assign
     1061                       v-current-char = substring( p-in-string, v-position, 1 )
     1062                   .
     1063                   case v-current-char
     1064                   :
     1065                       when "&":U
     1066                       then do:
     1067                           assign
     1068                               p-out-string = p-out-string + "&amp;":U
     1069                           .
     1070                       end.
     1071                       when ">":U
     1072                       then do:
     1073                           assign
     1074                               p-out-string = p-out-string + "&gt;":U
     1075                           .
     1076                       end.
     1077                       when "<":U
     1078                       then do:
     1079                           assign
     1080                               p-out-string = p-out-string + "&lt;":U
     1081                           .
     1082                       end.
     1083                       when "'":U
     1084                       then do:
     1085                           assign
     1086                               p-out-string = p-out-string + "&apos;":U
     1087                           .
     1088                       end.
     1089                       when '"':U
     1090                       then do:
     1091                           assign
     1092                               p-out-string = p-out-string + "&quot;":U
     1093                           .
     1094                       end.
     1095                       when chr(1)
     1096                       then do:
     1097                           assign
     1098                               p-out-string = p-out-string + "":U
     1099                           .
     1100                       end.
     1101                       when chr(2)
     1102                       then do:
     1103                           assign
     1104                               p-out-string = p-out-string + "":U
     1105                           .
     1106                       end.
     1107                       when chr(3)
     1108                       then do:
     1109                           assign
     1110                               p-out-string = p-out-string + "":U
     1111                           .
     1112                       end.
     1113                       when chr(4)
     1114                       then do:
     1115                           assign
     1116                               p-out-string = p-out-string + "":U
     1117                           .
     1118                       end.
     1119                       when chr(5)
     1120                       then do:
     1121                           assign
     1122                               p-out-string = p-out-string + "":U
     1123                           .
     1124                       end.
     1125                       when chr(6)
     1126                       then do:
     1127                           assign
     1128                               p-out-string = p-out-string + "":U
     1129                           .
     1130                       end.
     1131                       when chr(7)
     1132                       then do:
     1133                           assign
     1134                               p-out-string = p-out-string + "":U
     1135                           .
     1136                       end.
     1137                       when chr(8)
     1138                       then do:
     1139                           assign
     1140                               p-out-string = p-out-string + "":U
     1141                           .
     1142                       end.
     1143                       when chr(9)
     1144                       then do:
     1145                           assign
     1146                               p-out-string = p-out-string + "":U
     1147                           .
     1148                       end.
     1149                       when chr(29)
     1150                       then do:
     1151                           assign
     1152                               p-out-string = p-out-string + "":U
     1153                           .
     1154                       end.
     1155                       when chr(10)
     1156                       then do:
     1157                           assign
     1158                               p-out-string = p-out-string + "&#10;":U
     1159                           .
     1160                       end.
     1161                       when chr(13)
     1162                       then do:
     1163                           assign
     1164                               p-out-string = p-out-string + "&#13;":U
     1165                           .
     1166                       end.
     1167                       otherwise do:
     1168                           assign
     1169                               p-out-string = p-out-string + v-current-char
     1170                           .
     1171                       end.
     1172                   end case.
     1173               end.
     1174           end.
     1175       end case.
     1176   end.
     1177   end .
     1178   procedure xmlchar-encode-1c :
     1179   define input parameter p-in-string      as character        no-undo.
     1180   define output parameter p-out-string    as character        no-undo.
     1181       define variable v-position      as integer      no-undo.
     1182       define variable v-current-char  as character    no-undo.
     1183   do
     1184   on error undo, return error
     1185   :
     1186       assign
     1187           p-out-string = "":U
     1188       .
     1189       case p-in-string
     1190       :
     1191           when ?
     1192           then do:
     1193               assign
     1194                   p-out-string = "?":U
     1195               .
     1196           end.
     1197           otherwise do:
     1198               do v-position = 1 to length( p-in-string )
     1199               :
     1200                   assign
     1201                       v-current-char = substring( p-in-string, v-position, 1 )
     1202                   .
     1203                   case v-current-char
     1204                   :
     1205                       when chr(1)
     1206                       then do:
     1207                           assign
     1208                               p-out-string = p-out-string + " ":U
     1209                           .
     1210                       end.
     1211                       when chr(2)
     1212                       then do:
     1213                           assign
     1214                               p-out-string = p-out-string + " ":U
     1215                           .
     1216                       end.
     1217                       when chr(3)
     1218                       then do:
     1219                           assign
     1220                               p-out-string = p-out-string + " ":U
     1221                           .
     1222                       end.
     1223                       when chr(4)
     1224                       then do:
     1225                           assign
     1226                               p-out-string = p-out-string + " ":U
     1227                           .
     1228                       end.
     1229                       when chr(5)
     1230                       then do:
     1231                           assign
     1232                               p-out-string = p-out-string + " ":U
     1233                           .
     1234                       end.
     1235                       when chr(6)
     1236                       then do:
     1237                           assign
     1238                               p-out-string = p-out-string + " ":U
     1239                           .
     1240                       end.
     1241                       when chr(7)
     1242                       then do:
     1243                           assign
     1244                               p-out-string = p-out-string + " ":U
     1245                           .
     1246                       end.
     1247                       when chr(8)
     1248                       then do:
     1249                           assign
     1250                               p-out-string = p-out-string + " ":U
     1251                           .
     1252                       end.
     1253                       when chr(9)
     1254                       then do:
     1255                           assign
     1256                               p-out-string = p-out-string + " ":U
     1257                           .
     1258                       end.
     1259                       when chr(29)
     1260                       then do:
     1261                           assign
     1262                               p-out-string = p-out-string + " ":U
     1263                           .
     1264                       end.
     1265                       when chr(10)
     1266                       then do:
     1267                           assign
     1268                               p-out-string = p-out-string + " ":U
     1269                           .
     1270                       end.
     1271                       when chr(13)
     1272                       then do:
     1273                           assign
     1274                               p-out-string = p-out-string + " ":U
     1275                           .
     1276                       end.
     1277                       otherwise do:
     1278                           assign
     1279                               p-out-string = p-out-string + v-current-char
     1280                           .
     1281                       end.
     1282                   end case.
     1283               end.
     1284           end.
     1285       end case.
     1286   end.
     1287   end .
     1288   procedure xmlchar-decode :
     1289   define input parameter p-in-string      as character        no-undo.
     1290   define output parameter p-out-string    as character        no-undo.
     1291       define variable v-position      as integer      no-undo.
     1292       define variable v-last-position as integer      no-undo.
     1293       define variable v-temp-integer  as integer      no-undo.
     1294       define variable v-current-char  as character    no-undo.
     1295       define variable v-next-char     as character    no-undo.
     1296       define variable v-success       as logical      no-undo.
     1297   do
     1298   on error undo, return error
     1299   :
     1300       assign
     1301           p-out-string = "":U
     1302           v-position   = 0
     1303       .
     1304       replace-cycle:
     1305       do while yes
     1306       on error undo, return error
     1307       :
     1308           assign
     1309               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1310           .
     1311           if v-last-position <= v-position
     1312           then do:
     1313               if v-position = 0
     1314               then do:
     1315                   assign
     1316                       p-out-string = p-in-string
     1317                   .
     1318               end.
     1319               else do:
     1320                   assign
     1321                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1322                   .
     1323               end.
     1324               leave replace-cycle.
     1325           end.
     1326           else do:
     1327               assign
     1328                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1329                   v-position      = v-last-position
     1330                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1331               .
     1332               if v-current-char = "#":U
     1333               then do:
     1334                   assign
     1335                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1336                   .
     1337                   if v-last-position > 0
     1338                   then do:
     1339                       run xmlchar-read-integer in this-procedure
     1340                        (
     1341                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1342                           , output v-temp-integer
     1343                           , output v-success
     1344                       ).
     1345                       if v-success = yes
     1346                       and v-temp-integer >= 1
     1347                       and v-temp-integer <= 255
     1348                       then do:
     1349                           assign
     1350                               p-out-string = p-out-string + chr( v-temp-integer )
     1351                               v-position   = v-last-position + 1
     1352                           .
     1353                       end.
     1354                       else do:
     1355                           assign
     1356                               p-out-string = p-out-string + "&":U
     1357                               v-position   = v-position   + 1
     1358                           .
     1359                       end.
     1360                   end.
     1361                   else do:
     1362                       assign
     1363                           p-out-string = p-out-string + "&":U
     1364                           v-position   = v-position   + 1
     1365                       .
     1366                   end.
     1367               end.
     1368               else do:
     1369                   case substring( p-in-string, v-position + 1, 3 )
     1370                   :
     1371                       when "lt;":U
     1372                       then do:
     1373                           assign
     1374                               p-out-string = p-out-string + "<":U
     1375                               v-position   = v-position   + 3
     1376                           .
     1377                       end.
     1378                       when "gt;":U
     1379                       then do:
     1380                           assign
     1381                               p-out-string = p-out-string + ">":U
     1382                               v-position   = v-position   + 3
     1383                           .
     1384                       end.
     1385                       otherwise do:
     1386                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1387                           then do:
     1388                               assign
     1389                                   p-out-string = p-out-string + "&":U
     1390                                   v-position   = v-position   + 4
     1391                               .
     1392                           end.
     1393                           else do:
     1394                               case substring( p-in-string, v-position + 1, 5 )
     1395                               :
     1396                                   when "quot;":U
     1397                                   then do:
     1398                                       assign
     1399                                           p-out-string = p-out-string + '"':U
     1400                                           v-position   = v-position   + 5
     1401                                       .
     1402                                   end.
     1403                                   when "apos;":U
     1404                                   then do:
     1405                                       assign
     1406                                           p-out-string = p-out-string + "'":U
     1407                                           v-position   = v-position   + 5
     1408                                       .
     1409                                   end.
     1410                                   otherwise do:
     1411                                       assign
     1412                                           p-out-string = p-out-string + "&":U
     1413                                       .
     1414                                   end.
     1415                               end case.
     1416                           end.
     1417                       end.
     1418                   end case.
     1419               end.
     1420           end.
     1421       end.
     1422   end.
     1423   end .
     1424   procedure xmlchar-read-integer :
     1425   define input parameter p-input-string      as character        no-undo.
     1426   define output parameter p-output-integer   as integer          no-undo.
     1427   define output parameter p-success       as logical          no-undo.
     1428   do
     1429   on error undo, return error
     1430   :
     1431       assign
     1432           p-output-integer = integer( p-input-string )
     1433       no-error.
     1434       if error-status :error
     1435       then do:
     1436           assign
     1437               p-success           = no
     1438               p-output-integer    = 0
     1439           .
     1440       end.
     1441       else do:
     1442           assign
     1443               p-success           = yes
     1444           .
     1445       end.
     1446   end.
     1447   end.
     1448   define variable mMRCCode  as logical    no-undo.
     1449   define variable mTypeMark as character  no-undo.
     1450   function IS-NeedMark returns logical
     1451   ( input ib-code as integer  ,
     1452     input ib-str as character ):
     1453      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1454      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1455                                    and buf_prod-bc-attr.b-str  eq ib-str
     1456                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1457        no-lock no-error.
     1458      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1459   end.
     1460   function repTegforDm return char
     1461   (iDM as char ):
     1462       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1463       define variable vteg as character no-undo.
     1464       define variable oDM as character no-undo.
     1465       define variable vi as integer no-undo.
     1466       oDM = iDm.
     1467       do vi = 1 to num-entries(vTeglist):
     1468          vTeg = entry(vi,vTeglist).
     1469          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1470       end.
     1471       return oDM.
     1472   end.
     1473   function repSpecSimbforDm return char
     1474   (iDM as char ):
     1475       define variable oDM as character no-undo.
     1476     run
     1477       xmlchar-decode(iDM, output oDM).
     1478     return repTegforDm (oDM).
     1479   end.
     1480   function CheckGtin return logical
     1481   (iGtin as char):
     1482      define variable bar_code as character no-undo.
     1483      define variable vGtin as logical no-undo init "yes".
     1484      if length(iGtin) eq 14
     1485      then do:
     1486         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1487         run str/chk-sum.p
     1488          (input-output bar_code ) no-error .
     1489         if iGtin ne  bar_code
     1490         then
     1491            vGtin = no.
     1492      end.
     1493      else
     1494         vGtin = no.
     1495      return vgtin.
     1496   end.
     1497   function repSpecSimbforXlm return char
     1498   (iDM as char ):
     1499       iDM = replace(iDM,chr(29),"").
     1500       return iDM.
     1501   end.
     1502   function getGtinByDM return char
     1503   (IDM as char):
     1504      define variable VTXT as char no-undo.
     1505      define variable vGtin as char no-undo.
     1506      vTXt = IdM.
     1507      vGtin = IDM.
     1508      if    length(vtxt) > 14
     1509      then do:
     1510         if   vtxt begins "(01)"
     1511                or vtxt begins "(02)"
     1512         then
     1513            vGtin = substring(vtxt,5,14).
     1514         else if   (vtxt begins "01"
     1515                or vtxt begins "02" )
     1516                and (   (    substring(iDm,17,2) eq "21"
     1517                         and length(vtxt) >= 21)
     1518                     or substring(iDm,17,2) eq "37"
     1519                     or substring(iDm,17,4) eq "(37)" )
     1520         then do:
     1521            vGtin = substring(vtxt,3,14).
     1522            if not checkGtin(vGtin)
     1523            then
     1524               vGtin = substring(vtxt,1,14).
     1525         end.
     1526         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1527             or length(vtxt) eq 14 + 7 + 4
     1528             or length(vtxt) eq 14 + 7
     1529         then
     1530            vGtin = substring(vtxt,1,14).
     1531      end.
     1532      if not checkGtin(vGtin)
     1533      then
     1534         vGtin = "".
     1535      return vgtin.
     1536   end.
     1537   function getGdsCodeByGtin return int
     1538   (iGtin as char):
     1539      define buffer prod-bc  for ub.prod-bc.
     1540      define buffer bar-code for ub.bar-code.
     1541      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1542      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1543      return if avail bar-code then bar-code.gds-code else ?.
     1544   end.
     1545   function getQntyCodeByGtin return decimal
     1546   (iGtin as char):
     1547      define buffer prod-bc  for ub.prod-bc.
     1548      define buffer bar-code for ub.bar-code.
     1549      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1550      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1551      return if avail bar-code then bar-code.cli-base-rate else ?.
     1552   end.
     1553   function getGdsCodeByDM return int
     1554   (iDm as char):
     1555      define variable vGtin as char no-undo.
     1556      define buffer prod-bc for ub.prod-bc.
     1557      vGtin  = getGtinByDM (IDM ).
     1558      return getGdsCodeByGtin (vGtin).
     1559   end.
     1560   function ChekTypeMarkByGds return logical
     1561   (iGds-code as integer ):
     1562      define buffer goods-attr for ub.goods-attr.
     1563      find first goods-attr where goods-attr.gds-code   = iGds-code
     1564                              and goods-attr.attr-code  = 'mark-type':U
     1565      no-lock no-error.
     1566      if available goods-attr
     1567      then do:
     1568         mTypeMark = goods-attr.attr-value.
     1569         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1570           .
     1571      end.
     1572      else
     1573         return no.
     1574   end.
     1575   function ChekTypeMarkByDm return logical
     1576   (iDM as char ):
     1577      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1578   end.
     1579   function ChekTypeMarkByGtin return logical
     1580   (iGtin as char ):
     1581      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1582   end.
     1583   function GetNextElement return character
     1584     (input iAllTeg        as logical
     1585     ,output oteg          as character
     1586     ,output otegval       as character
     1587     ,input-output pstr    as character
     1588      ):
     1589        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1590        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1591        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1592        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1593        define variable vTeg as character no-undo.
     1594        define variable vLength as integer no-undo.
     1595        define variable vi as integer no-undo.
     1596        define variable vj as integer no-undo.
     1597        define buffer code for ub.code.
     1598        find first code where Code.parent eq "MarkType"
     1599                          and Code.CodeValue   eq mTypeMark
     1600                          no-lock no-error.
     1601        if     available code
     1602           and Code.misc1 ne ""
     1603           and Code.misc1 ne ?
     1604        then do:
     1605           integer (Code.misc1) no-error.
     1606           if not error-status:error
     1607           then
     1608             entry (4,vlistleng) = Code.misc1.
     1609        end.
     1610        if iAllTeg
     1611        then
     1612           assign
     1613              vlistElem     = vlistElem    + vlistElemDop
     1614              vlistleng     = vlistleng    + vlistlengDop
     1615           .
     1616        else if mMRCCode
     1617        then
     1618           assign
     1619              vlistElem     = vlistElem    + ",(8005),8005"
     1620              vlistleng     = vlistleng    + ",000006,0006"
     1621           .
     1622       block-elem:
     1623       do vi = 1 to num-entries(vlistElem):
     1624          vTeg = entry(vi,vlistElem).
     1625          if pstr begins vTeg
     1626          then do:
     1627             if    vTeg eq "21"
     1628             then
     1629                vLength = index(pstr,chr(29)) - 2 no-error.
     1630             if vLength  <= 0
     1631             then
     1632                vLength = int(entry(vi,vlistleng)).
     1633             otegval = substring (pstr,length(vteg) + 1, vLength).
     1634             oteg = replace(replace(vteg,")",""),"(","").
     1635             vTeg = vteg + otegval.
     1636             otegval = replace(otegval,chr(29),"").
     1637             oteg = replace(replace(oteg,")",""),"(","").
     1638             pstr = substring (pstr,length(vTeg)+ 1).
     1639             vTeg = replace(vTeg,chr(29),"").
     1640             leave block-elem.
     1641          end.
     1642          else
     1643             vTeg = "".
     1644       end.
     1645       return vteg.
     1646   end.
     1647   function GetCodeIdent return character
     1648   (iDm as char):
     1649      define variable Velement   as character no-undo init "first".
     1650      define variable oCodeIdent as character no-undo.
     1651      define variable vteg as character no-undo.
     1652      define variable vtegval as character no-undo.
     1653      define variable vGtin as character no-undo.
     1654      define buffer marking for ub.marking.
     1655      for first marking no-lock where
     1656                marking.mark eq iDm
     1657            and marking.unit-ext = "LEVEL2"
     1658      :
     1659        return iDm.
     1660      end.
     1661      vGtin  = getGtinByDM (iDm ).
     1662      ChekTypeMarkByDm(idm).
     1663      if iDm begins 'tech_':U
     1664      then
     1665         oCodeIdent = iDm.
     1666      else if length(iDm) < 21
     1667      then do:
     1668         find first marking where marking.mark eq idm
     1669         no-lock no-error.
     1670         oCodeIdent = if available marking then marking.mark else  ?.
     1671      end.
     1672      else if     length(iDm) eq 29
     1673         and not iDm begins "01"
     1674         and not iDm begins "02"
     1675      then
     1676         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1677      else  if     length(iDm) >= 24
     1678               and (  iDm begins "01"
     1679                   or iDm begins "02")
     1680               and  substring(iDm,17,2) ne "21"
     1681      then do:
     1682         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1683                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1684         then
     1685            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1686         else
     1687            oCodeIdent = iDM.
     1688      end.
     1689      else  if     (   length(iDm) eq 25
     1690                    or length(iDm) eq 21)
     1691               and (not iDm begins "01"
     1692               and  not iDm begins "02")
     1693      then
     1694         oCodeIdent = substring(iDm,1,21).
     1695      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1696      then
     1697         oCodeIdent = substring(iDm,1,21).
     1698      else do while Velement ne "" and idm ne "":
     1699         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1700         oCodeIdent = oCodeIdent + Velement.
     1701      end.
     1702      return oCodeIdent.
     1703   end.
     1704   function GetTegCod return character
     1705   (icodeIdent as char, iTeg as char):
     1706      define variable Velement   as character no-undo init "first".
     1707      define variable oTeg as character no-undo init ?.
     1708      define variable vteg as character no-undo.
     1709      define variable vtegval as character no-undo.
     1710      if     ((length(icodeIdent) eq 21
     1711         and not icodeIdent begins "01"
     1712         and not icodeIdent begins "02")
     1713         or
     1714             ( length(icodeIdent) eq 25
     1715               and not icodeIdent begins "01"
     1716               and not icodeIdent begins "02"))
     1717      then do:
     1718         if iTeg eq "01" or iTeg eq "02"
     1719         then
     1720            oTeg = substring(icodeIdent,1,21).
     1721         else  if  iTeg eq "21"
     1722         then
     1723            oTeg = substring(icodeIdent,15,7).
     1724      end.
     1725      else do:
     1726         ChekTypeMarkByDm(icodeIdent).
     1727         block-teg:
     1728            do while Velement ne "" and icodeIdent ne "":
     1729            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1730            if    Velement begins iTeg
     1731               or Velement begins "(" + iTeg + ")"
     1732            then do:
     1733               oTeg = vtegval.
     1734               leave block-teg.
     1735            end.
     1736         end.
     1737      end.
     1738      return oTeg.
     1739   end.
     1740   function isOAD return logical
     1741   (icodeIdent as character):
     1742      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1743   end.
     1744   function isMark return logical
     1745   (icodeIdent as character):
     1746      define buffer buf_marking for ub.marking.
     1747      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1748             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1749   end.
     1750   function addBracketForCode return character
     1751   (icodeIdent as char):
     1752      define variable Velement   as character no-undo init "first".
     1753      define variable oTeg as character no-undo.
     1754      define variable vteg as character no-undo.
     1755      define variable vtegval as character no-undo.
     1756      define buffer marking for ub.marking.
     1757      find first marking no-lock where
     1758                 marking.mark begins icodeIdent no-error.
     1759      if    not ChekTypeMarkByDm(icodeIdent)
     1760         or length(icodeIdent) le 24
     1761         or (avail marking and marking.unit-ext = "LEVEL2")
     1762      then
     1763         oTeg = icodeIdent.
     1764      else do:
     1765         if (  icodeIdent begins "01"
     1766            or icodeIdent begins "02"
     1767            ) and CheckGtin(substring (icodeIdent,3,14))
     1768            and substring (icodeIdent,17,2) eq "21"
     1769         then do:
     1770            mMRCCode = yes.
     1771            ChekTypeMarkByDm(icodeIdent).
     1772            block-teg:
     1773            do while Velement ne "" and icodeIdent ne "":
     1774               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1775               if vteg ne ""
     1776               then
     1777                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1778            end.
     1779            mMRCCode = no.
     1780         end.
     1781         else do:
     1782            oTeg = icodeIdent.
     1783         end.
     1784      end.
     1785      return oTeg.
     1786   end.
     1787   function getlevelByCodId return int
     1788   (iCode as char):
     1789      define variable vLength as int no-undo.
     1790      define variable vLevel  as int no-undo.
     1791      if not ChekTypeMarkByDM (icode) then return ?.
     1792      vLength = length(iCode).
     1793      if    vLength eq 18
     1794         or vLength eq 20
     1795      then
     1796         Vlevel = 4.
     1797      else if vLength eq 21
     1798      then
     1799         Vlevel = 1.
     1800      else if vLength eq 25
     1801      then do:
     1802         if  iCode begins "01"
     1803         then
     1804            Vlevel = 3.
     1805         else
     1806            Vlevel = 1.
     1807      end.
     1808      else if     vLength >= 26
     1809              and vLength <= 46
     1810      then do:
     1811         if    substring(iCode,17,2) eq "11"
     1812            or substring(iCode,17,2) eq "13"
     1813            or (    substring(iCode,17,2) eq "21"
     1814                and vLength >= 33
     1815                and substring(iCode,26,4) ne "8005")
     1816         then
     1817            Vlevel = 4.
     1818         else if    vLength eq 31
     1819                 or vLength eq 38
     1820                 or vLength eq 39
     1821                 or vLength eq 45
     1822         then
     1823            Vlevel = 1.
     1824         else if    vLength eq 35
     1825                 or vLength eq 43
     1826         then
     1827            Vlevel = 3.
     1828         else
     1829            Vlevel = ?.
     1830      end.
     1831      else
     1832         Vlevel = ?.
     1833      return Vlevel.
     1834   end.
     1835   function getLevelMotpBycodid return character
     1836   (iDm as char):
     1837      define variable vLevel as integer no-undo.
     1838      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1839      vLevel = getlevelByCodId(iDm).
     1840      if    vLevel eq ?
     1841         or vLevel < 1
     1842         or vLevel > 6
     1843      then
     1844         return ?.
     1845      else
     1846         return entry(vlevel,vList).
     1847   end.
     1848   function getLevelUTDByLevelMotp return character
     1849   (iUnit as char):
     1850      define variable vLevel as integer no-undo.
     1851      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1852      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1853      vLevel = lookup(iUnit,vListMOTP).
     1854      if    vLevel eq ?
     1855         or vLevel < 1
     1856         or vLevel > 4
     1857      then
     1858         return ?.
     1859      else
     1860         return entry(vlevel,vListutd).
     1861   end.
     1862   function getLevelMotpByDM return character
     1863   (iDm as char):
     1864      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1865   end.
     1866   function getLevelUTDByCodId return character
     1867   (iDm as char):
     1868      define variable vLevel as integer no-undo.
     1869      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1870      vLevel = getlevelByCodId(iDm).
     1871      if    vLevel eq ?
     1872         or vLevel < 1
     1873         or vLevel > 4
     1874      then
     1875         return ?.
     1876      else
     1877         return entry(vlevel,vList).
     1878   end.
     1879   function getLevelUTDByDM return character
     1880   (iDm as char):
     1881      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1882   end.
     1883   define variable mNotMarkQnty as logical no-undo.
     1884   function getQntyUTDByCodId return decimal
     1885   (iDM as char):
     1886      define variable vLevel as integer no-undo.
     1887      define variable vList as character no-undo init "1,5,10,500".
     1888      define variable vGtin as character no-undo.
     1889      define variable vqnty as decimal no-undo init ?.
     1890      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1891      if vqnty eq ?
     1892      then do:
     1893         if not mNotMarkQnty
     1894         then do:
     1895            define buffer marking for ub.marking.
     1896            define variable vCodident as character no-undo.
     1897            vCodident = GetCodeIdent(idm).
     1898            find first marking where marking.mark begins vCodident no-lock no-error.
     1899            if     available marking
     1900               and marking.box-qnty ne ?
     1901            then
     1902               return marking.box-qnty.
     1903         end.
     1904         vGtin = getGtinByDm(iDM).
     1905         if ChekTypeMarkByGtin (vGtin)
     1906         then do:
     1907            vLevel = getlevelByCodId(iDM).
     1908            if     vLevel >= 1
     1909               and vLevel <= 4
     1910            then
     1911               vqnty = int(entry(vlevel,vList)).
     1912         end.
     1913         else
     1914            vqnty = getQntyCodeByGtin(vgtin).
     1915      end.
     1916      return vqnty.
     1917   end.
     1918   function getQntyUTDByDM return decimal
     1919   (iDm as char):
     1920      define variable vDM as character no-undo.
     1921      if     length (iDm) ne 25
     1922         and length (iDm) ne 29
     1923         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1924      then
     1925         vDM = substring (iDm,1,length (iDm) - 6 ).
     1926      else
     1927         vDM = substring (iDm,1,length (iDm) - 4 ).
     1928      return getQntyUTDByCodId(vDM).
     1929   end.
     1930   function getMRC4 return decimal
     1931   (iMRC as char):
     1932      define variable oMrc     as decimal no-undo init ?.
     1933      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1934      define variable vi       as integer no-undo.
     1935      define variable vfound   as integer no-undo.
     1936      define variable vposStart   as integer no-undo.
     1937      do:
     1938      OMRc = 0.
     1939      do vi = 1 to 4:
     1940         define variable vsimb as character no-undo.
     1941         vsimb = substring(iMRC,vi,1).
     1942         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1943         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1944         if vfound > 0
     1945         then
     1946            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1947         end.
     1948         OMRc = OMRc / 100.
     1949      end.
     1950      return OMRc.
     1951   end.
     1952   function getMRCByDM return decimal
     1953   (iDm as char):
     1954      define variable vMRC     as character no-undo.
     1955      define variable oMrc     as decimal no-undo init ?.
     1956      define variable Velement as character no-undo init "empty".
     1957      define variable vteg as character no-undo.
     1958      define variable vtegval as character no-undo.
     1959      if    length(idm) eq 14 + 7 + 4 + 4
     1960         or length(idm) eq 14 + 7 + 4
     1961      then do:
     1962         vMRC = substring(idm,22,4).
     1963         omrc = getMRC4(vMRC).
     1964      end.
     1965      else do:
     1966          ChekTypeMarkByDm(iDm).
     1967          block-mrc:
     1968          do while Velement ne "" and idm ne "":
     1969             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1970             if Velement begins "8005"
     1971             then do:
     1972                vMRC = substring(Velement,5,6).
     1973                leave block-mrc.
     1974             end.
     1975             else if Velement begins "(8005)"
     1976             then do:
     1977                vMRC = substring(Velement,7,6).
     1978                leave block-mrc.
     1979             end.
     1980          end.
     1981          if vMRC ne ""
     1982          then
     1983             OMRc = dec(vmrc) / 100 no-error.
     1984      end.
     1985      return OMRc.
     1986   end.
     1987   function MoveDate return Date
     1988   (idate as date,
     1989    iMonth as int64):
     1990      define variable vMonth   as int64 no-undo.
     1991      define variable vYear    as int64 no-undo.
     1992      define variable vDateNew as date  no-undo.
     1993       define variable vDay     as int64 no-undo.
     1994       vMonth = month(iDate) + iMonth.
     1995       vYear =  year(iDate).
     1996       if vMonth <= 0
     1997       then assign
     1998          vMonth = vMonth + 12
     1999           vYear  = vYear - 1
     2000       .
     2001       else if vMonth > 12
     2002       then assign
     2003          vMonth = vMonth - 12
     2004           vYear  = vYear + 1
     2005       .
     2006       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2007       do while error-status:error eq yes:
     2008          VDay = vDay + 1.
     2009          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2010       end.
     2011       if VDay > 0
     2012       then
     2013          vDateNew + 1.
     2014       return vDateNew.
     2015   end.
     2016   procedure checkEMRC:
     2017   define input  parameter iDm as character no-undo.
     2018   define output parameter vok as logical   no-undo init yes.
     2019      define variable v-value-emrc as character no-undo.
     2020      define variable v-type-emrc  as character no-undo.
     2021      define variable vDateIso     as character no-undo.
     2022      define variable vMRC         as decimal no-undo.
     2023      define variable vqnty        as decimal no-undo.
     2024      define variable vPrice       as decimal no-undo.
     2025      define variable vparent      as character no-undo.
     2026      define variable vgds-code    as integer no-undo.
     2027      define buffer code for ub.code.
     2028      vMRC = getMRCByDM(iDm).
     2029      if vMRC > 0
     2030      then do:
     2031         vgds-code = getGdsCodeByDM(iDm).
     2032         vqnty     = getQntyUTDByDM(iDm).
     2033               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2034            (
     2035             input   vgds-code
     2036            ,input   'emrc-type':U
     2037            ,output   v-value-emrc
     2038            ,output   v-type-emrc
     2039          ) no-error.
     2040          if     v-value-emrc ne ""
     2041             and v-value-emrc ne ?
     2042          then do:
     2043             vDateIso = iso-date(today).
     2044             vPrice = vMRC / vqnty.
     2045             vparent ="emc" + chr(4) + v-value-emrc.
     2046             find last code where Code.parent      eq vparent
     2047                              and Code.code        le vDateIso
     2048                              and code.status_  eq 0
     2049             no-lock no-error.
     2050             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2051             then
     2052                vOk = true .
     2053             else do:
     2054                 define variable vText      as character no-undo.
     2055                 define variable vDate      as date no-undo.
     2056                 define variable vDateLast  as character no-undo.
     2057                 define variable vDateFirst as character no-undo.
     2058                 define variable vDate3     as date no-undo.
     2059                 vdate = date(code.misc1).
     2060                 vDateLast = code.misc1.
     2061                 vDate3 = MoveDate(today, - 3 ).
     2062                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2063                                      string(vDate3  , "99/99/9999"),
     2064                                      string(vDate   , "99/99/9999")
     2065                                      ).
     2066                 vdateIso = iso-date(vdate3).
     2067                 find last code  where Code.parent      eq vparent
     2068                                   and Code.code        le vDateIso
     2069                                   and code.status_  eq 0 no-lock no-error.
     2070                 if available code
     2071                 then
     2072                    vDateIso = code.code.
     2073                 vDateFirst = vDateIso.
     2074                 vDateLast = iso-date(vdate).
     2075                 define variable vGood as logical no-undo.
     2076                 define variable vDateSale as date no-undo.
     2077                 define buffer bcode for code.
     2078                 for last code where Code.parent   eq vparent
     2079                                 and code.status_  eq 0
     2080                                 and code.code     < vDateLast
     2081                                 and code.code     >= vDateFirst
     2082                 no-lock:
     2083                    find first bcode where bCode.parent   eq vparent
     2084                                       and bcode.status_  eq 0
     2085                                       and bcode.code     > code.code no-lock no-error.
     2086                    if available bcode
     2087                    then do:
     2088                       if vPrice < dec(Code.CodeValue)
     2089                       then
     2090                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2091                                                     chr(10),
     2092                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2093                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2094                                                     ).
     2095                       else do:
     2096                          vGood = yes.
     2097                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2098                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2099                                                     chr(10),
     2100                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2101                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2102                                                     string(         vDateSale            ,"99/99/9999"),
     2103                                                     string(vDateSale - today)
     2104                                                     ).
     2105                       end.
     2106                    end.
     2107                 end.
     2108                 if vgood
     2109                 then do:
     2110                    define variable choice as integer no-undo .
     2111                    run gbl/d-askw.w (input "Уточнение"
     2112                           ,input  vText
     2113                           ,input "|"
     2114                           ,input "Принять|Вернуть"
     2115                           ,input "Принять данный товар|Вернуть товар постащику"
     2116                           ,input 1
     2117                           ,input 2
     2118                           ,output choice) no-error.
     2119                    vok = choice eq 1.
     2120                 end.
     2121                 else
     2122                    vok =false.
     2123             end.
     2124          end.
     2125      end.
     2126   end.
     2127   function addGs2Mark return character
     2128   (iMark as char):
     2129      define variable vDM   as character no-undo.
     2130      define variable vIdx  as integer   no-undo.
     2131      if index(iMark,chr(29),1) > 0
     2132      then return iMark.
     2133      if substring(iMark,26,4) = "8005" then
     2134      do:
     2135        vIdx = index(iMark,"93",26 + 4 + 5).
     2136        if vIdx > 1 then do:
     2137          vDM = substitute("&1&4&2&4&3",
     2138                           substring(iMark,1,25),
     2139                           substring(iMark,26,vIdx - 25 - 1),
     2140                           substring(iMark,vIdx),
     2141                           chr(29)) no-error.
     2142          vIdx = index(vDm,"240",vIdx + 4).
     2143          if vIdx > 0 then
     2144          do:
     2145            vDM = substitute("&1&3&2",
     2146                             substring(vDm,1,vIdx - 1),
     2147                             substring(vDm,vIdx),
     2148                             chr(29)) no-error.
     2149          end.
     2150        end.
     2151        else
     2152          vDM = substitute("&1&3&2",
     2153                           substring(iMark,1,25),
     2154                           substring(iMark,26),
     2155                           chr(29)) no-error.
     2156      end.
     2157      else if substring(iMark,32,2) = "91" then
     2158      do:
     2159        vIdx = index(iMark,"92",32).
     2160        if vIdx > 1 then
     2161          vDM = substitute("&1&4&2&4&3",
     2162                           substring(iMark,1,31),
     2163                           substring(iMark,32,vIdx - 31 - 1),
     2164                           substring(iMark,vIdx),
     2165                           chr(29)) no-error.
     2166        else
     2167          vDM = substitute("&1&3&2",
     2168                           substring(iMark,1,31),
     2169                           substring(iMark,32),
     2170                           chr(29)) no-error.
     2171      end.
     2172      else if substring(iMark,39,2) = "91" then
     2173      do:
     2174        vIdx = index(iMark,"92",38).
     2175        if vIdx > 1 then
     2176          vDM = substitute("&1&4&2&4&3",
     2177                           substring(iMark,1,38),
     2178                           substring(iMark,39,vIdx - 38 - 1),
     2179                           substring(iMark,vIdx),
     2180                           chr(29)) no-error.
     2181        else
     2182          vDM = substitute("&1&3&2",
     2183                           substring(iMark,1,38),
     2184                           substring(iMark,39),
     2185                           chr(29)) no-error.
     2186      end.
     2187      else if substring(iMark,25,2) = "93" then
     2188      do:
     2189        vIdx = index(iMark,"92",25).
     2190        if vIdx > 1 then
     2191          vDM = substitute("&1&4&2&4&3",
     2192                           substring(iMark,1,24),
     2193                           substring(iMark,25,vIdx - 24 - 1),
     2194                           substring(iMark,vIdx),
     2195                           chr(29)) no-error.
     2196        else
     2197          vIdx = index(iMark,"3103",25).
     2198          if vIdx > 0 then
     2199          vDM = substitute("&1&4&2&4&3",
     2200                           substring(iMark,1,24),
     2201                           substring(iMark,25,vIdx - 24 - 1),
     2202                           substring(iMark,vIdx),
     2203                           chr(29)) no-error.
     2204          else
     2205            vDM = substitute("&1&3&2",
     2206                             substring(iMark,1,24),
     2207                             substring(iMark,25),
     2208                             chr(29)) no-error.
     2209      end.
     2210      else if substring(iMark,32,2) = "93" then
     2211      do:
     2212        vDM = substitute("&1&3&2",
     2213              substring(iMark,1,31),
     2214              substring(iMark,32),
     2215              chr(29)) no-error.
     2216      end.
     2217      return if vDM <> "" then vDm else iMark.
     2218   end.
     2219   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   define variable v-waitfram-action01         as character   no-undo .
     2221   define variable v-waitfram-action02         as character   no-undo .
     2222   define variable v-waitfram-action03         as character   no-undo .
     2223   define variable mWaitFramTextBeg            as character   no-undo.
     2224   define variable mWaitFramTextEnd            as character   no-undo.
     2225   define variable mWaitFramView               as logical     no-undo.
     2226   define variable mWaitProcEvent              as logical     no-undo init yes.
     2227   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2228   define variable mWaitFramStop               as logical     no-undo.
     2229   define variable mWaitFramStopUser           as logical     no-undo.
     2230   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2231   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2232   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2233   define button B-WaitFramStop auto-end-key
     2234        label "Стоп"
     2235        size 10 by 1 tooltip "Остоновить процесс".
     2236   define button B-viewProcInfo
     2237        label "Информация"
     2238        size 15 by 1 tooltip "Информация о процесс".
     2239   define frame waitfram
     2240     v-waitfram-action01 format "x(72)" no-label skip
     2241     v-waitfram-action02 format "x(72)" no-label skip
     2242     v-waitfram-action03 format "x(72)" no-label skip
     2243     B-viewProcInfo
     2244     B-WaitFramStop at row 4 col 30
     2245     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2246     .
     2247   define new global shared variable mBatchMode as logical no-undo init ?.
     2248   define variable mFramBachModHandle as handle no-undo.
     2249   mFramBachModHandle = frame waitfram:handle.
     2250   define variable mFameOldVis as logical no-undo.
     2251   define variable mVisCUrentVin as logical no-undo.
     2252   if session:batch-mode
     2253   then
     2254      mBatchMode = yes.
     2255   if mBatchMode = ? then do:
     2256     mVisCUrentVin = current-window:visible.
     2257     mFameOldVis = mFramBachModHandle:visible.
     2258     mFramBachModHandle:visible  = yes.
     2259     mBatchMode = mFramBachModHandle:visible ne yes.
     2260     mFramBachModHandle:visible = mFameOldVis.
     2261     current-window:visible = mVisCUrentVin.
     2262   end.
     2263    if  log-manager:logfile-name ne ?
     2264     then DO:
     2265         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2266         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2267         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2268     end.
     2269   on choose of B-WaitFramStop in frame waitfram
     2270   do:
     2271     mWaitFramStop = yes.
     2272     mWaitFramStopUser = yes.
     2273   end.
     2274   function waitfram-check-timeout returns logical():
     2275      define variable vtime as int64 no-undo.
     2276      if mWaitFramStopTimeOut
     2277      then
     2278         return yes.
     2279      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2280      if     mWaitFramTimeOut ne ?
     2281         and mWaitFramTimeOut ne 0
     2282         and mWaitFramTimeOut lt vtime
     2283      then do:
     2284         mWaitFramStopTimeOut = yes.
     2285      end.
     2286      return mWaitFramStopTimeOut.
     2287   end.
     2288   procedure waitfram-hide :
     2289     if not session:batch-mode
     2290     then do
     2291     on error undo, return error return-value
     2292     :
     2293       pause 0 before-hide .
     2294       if not mBatchMode then
     2295         hide frame waitfram .
     2296     end.
     2297   end procedure.
     2298   procedure waitfram-show :
     2299     define input  parameter p-message as character no-undo .
     2300     define variable v-left-margin as integer   no-undo .
     2301     if not session:batch-mode
     2302     then do
     2303     on error undo, return error return-value
     2304     :
     2305       if length(p-message) <= 70 then do:
     2306         assign
     2307           v-left-margin = integer((70 - length(p-message)) / 2)
     2308         .
     2309         assign
     2310           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2311         .
     2312         assign
     2313           v-waitfram-action01 = " "
     2314           v-waitfram-action02 = " "
     2315                                    + fill(" ", v-left-margin)
     2316                                    + p-message
     2317           v-waitfram-action03 = " "
     2318         .
     2319       end.
     2320       else do:
     2321         define variable vRindex1 as integer no-undo.
     2322         define variable vRindex2 as integer no-undo.
     2323         vRindex1 = r-index(p-message," ",70).
     2324         if vRindex1 = 0
     2325         then
     2326            vRindex1 = 70.
     2327         if length(p-message)  <= vRindex1 + 70 then do:
     2328           assign
     2329             v-waitfram-action01 = " "
     2330             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2331             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2332           .
     2333         end.
     2334         else do:
     2335           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2336           if vRindex2 <= vRindex1
     2337           then
     2338              vRindex2 = vRindex1 + 70.
     2339           assign
     2340             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2341             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2342             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2343           .
     2344         end.
     2345       end.
     2346       B-viewProcInfo:visible   in frame waitfram = no.
     2347       B-viewProcInfo:sensitive in frame waitfram = no.
     2348       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2349       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2350       if  (   mWaitFramView
     2351          or  mWaitProcEvent)
     2352          and not mBatchMode
     2353       then
     2354          display
     2355             v-waitfram-action01 skip
     2356             v-waitfram-action02 skip
     2357             v-waitfram-action03 skip
     2358          with frame waitfram .
     2359     end.
     2360   end procedure.
     2361      procedure waitfram-show-this:
     2362         define input  parameter iInterval as int64 no-undo.
     2363         define variable vtime as int64 no-undo.
     2364         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2365         mWaitFramInterval = iInterval.
     2366         run waitfram-show (substitute("&1&2 &3&4" ,
     2367                                       mWaitFramTextBeg ,
     2368                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2369                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2370                                       mWaitFramTextEnd
     2371                                      )
     2372                           ).
     2373      end.
     2374      procedure WaitFramRunPause:
     2375         define input  parameter iInterval as dec no-undo.
     2376         define variable vStart  as datetime-tz no-undo.
     2377         define variable vend    as datetime-tz no-undo.
     2378         define variable vint as int64 no-undo.
     2379         define variable vOk as logical no-undo.
     2380         vStart = now.
     2381         vend   = vStart.
     2382         publish "WaitFramPause" (iInterval,output vOk).
     2383         vend   =  now.
     2384         vint = vend - vStart.
     2385         vint = iInterval - vint / 1000.
     2386         if     not mWaitFramStop
     2387            and (   vint > 0
     2388                 or (    not vOk
     2389                     and iInterval eq ?
     2390                     )
     2391                 )
     2392         then
     2393            run waitfram-show-this (iInterval).
     2394         vend   =  now.
     2395         vint = vend - vStart.
     2396         vint = iInterval - vint / 1000.
     2397         if     not mWaitFramStop
     2398            and vint > 0
     2399         then do:
     2400            run gbl/pause.p (vint * 1000).
     2401         end.
     2402         if iInterval ne ?
     2403         then
     2404            publish "WaitFramStop".
     2405         waitfram-check-timeout().
     2406      end.
     2407      procedure WaitFramWaitFor:
     2408         define input  parameter iInterval as dec no-undo.
     2409         assign
     2410            mWaitFramStartProc   = now
     2411            mWaitFramStopUser    = no
     2412            mWaitFramStopTimeOut = no
     2413         .
     2414         block-wait:
     2415         do while not mWaitFramStop:
     2416            run WaitFramRunPause (iInterval).
     2417            if  waitfram-check-timeout()
     2418            then do:
     2419               leave block-wait.
     2420            end.
     2421         end.
     2422         run waitfram-hide.
     2423      end.
     2424   procedure waitfram-join :
     2425     define input  parameter p-line-1  as character no-undo .
     2426     define input  parameter p-line-2  as character no-undo .
     2427     define input  parameter p-line-3  as character no-undo .
     2428     define output parameter p-message as character no-undo .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432       assign
     2433         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2434                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2435                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2436       .
     2437     end.
     2438   end procedure.
     2439   function waitfram-join-function returns character
     2440     (input p-line-1 as character
     2441     ,input p-line-2 as character
     2442     ,input p-line-3 as character
     2443     ).
     2444     define variable v-message as character no-undo .
     2445     run waitfram-join in this-procedure
     2446       (input  p-line-1
     2447       ,input  p-line-2
     2448       ,input  p-line-3
     2449       ,output v-message
     2450       ) .
     2451     return v-message .
     2452   end function .
