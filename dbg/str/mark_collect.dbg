      358   procedure fbrhist-set-zero-upper-code :
      359   do
      360   on error undo, return error
      361   :
      362       assign
      363           v-fbrhist-upper-obj-type    = ""
      364           v-fbrhist-upper-obj-code    = 0
      365           v-fbrhist-upper-code        = 0
