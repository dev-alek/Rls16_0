      367   end.
      368   end procedure.
      369   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   procedure lineattr-value :
      371     do
      372     on error undo, return error return-value
      373     :
      374       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      375       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      376       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      377       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      378       define output parameter p-type     as character no-undo .
      379       define buffer buf_doc-line-attr for ub.doc-line-attr .
      380       def var v-format         as character no-undo .
      381       def var v-fillin_width   as integer   no-undo .
      382       def var v-fillin_height  as integer   no-undo .
      383       def var v-label          as character no-undo .
      384       def var v-user-can-edit  as logical   no-undo .
      385       def var v-output-display as logical   no-undo .
      386       def var v-other          as character no-undo .
      387       run lineattr-code in this-procedure
      388         (input  p-code
      389         ,output p-type
      390         ,output v-format
      391         ,output v-fillin_width
      392         ,output v-fillin_height
      393         ,output v-label
      394         ,output v-user-can-edit
      395         ,output v-output-display
      396         ,output v-other
      397         ) no-error .
      398       if error-status :error then do:
      399         undo, return error return-value .
      400       end.
      401       find first buf_doc-line-attr no-lock
      402         where buf_doc-line-attr.doc-code  = p-doc-code
      403           and buf_doc-line-attr.gds-code  = p-gds-code
      404           and buf_doc-line-attr.attr-code = p-code
      405         no-error .
      406       if avail buf_doc-line-attr then do:
      407         assign
      408           p-value =  buf_doc-line-attr.attr-value
      409         .
      410       end.
      411       else do:
      412         assign
      413           p-value = if p-type = 'L':U then "no":U else ""
      414         .
      415       end.
      416     end.
      417   end procedure.
      418   procedure lineattr-write :
      419     do
      420     on error undo, return error return-value
      421     :
      422       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      423       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      424       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      425       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      426       define buffer buf_doc-line-attr for ub.doc-line-attr .
      427       def var v-type           as character no-undo .
      428       def var v-format         as character no-undo .
      429       def var v-fillin_width   as integer   no-undo .
      430       def var v-fillin_height  as integer   no-undo .
      431       def var v-label          as character no-undo .
      432       def var v-user-can-edit  as logical   no-undo .
      433       def var v-output-display as logical   no-undo .
      434       def var v-other          as character no-undo .
      435       run lineattr-code in this-procedure
      436         (input  p-code
      437         ,output v-type
      438         ,output v-format
      439         ,output v-fillin_width
      440         ,output v-fillin_height
      441         ,output v-label
      442         ,output v-user-can-edit
      443         ,output v-output-display
      444         ,output v-other
      445         ) no-error .
      446       if error-status :error then do:
      447         undo, return error return-value .
      448       end.
      449       find first buf_doc-line-attr exclusive-lock
      450         where buf_doc-line-attr.doc-code  = p-doc-code
      451           and buf_doc-line-attr.gds-code  = p-gds-code
      452           and buf_doc-line-attr.attr-code = p-code
      453         no-error .
      454       if not available buf_doc-line-attr then do:
      455         create buf_doc-line-attr .
      456         assign
      457           buf_doc-line-attr.doc-code  = p-doc-code
      458           buf_doc-line-attr.gds-code = p-gds-code
      459           buf_doc-line-attr.attr-code = p-code
      460         .
      461       end.
      462       assign
      463         buf_doc-line-attr.attr-value = p-value
      464       .
      465        release buf_doc-line-attr.
      466     end.
      467   end procedure.
      468   procedure lineattr-exist :
      469     do
      470     on error undo, return error return-value
      471     :
      472       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      473       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      474       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      475       define output parameter p-exist   as logical  no-undo .
      476       define buffer buf_doc-line-attr for ub.doc-line-attr .
      477       def var v-type           as character no-undo .
      478       def var v-format         as character no-undo .
      479       def var v-fillin_width   as integer   no-undo .
      480       def var v-fillin_height  as integer   no-undo .
      481       def var v-label          as character no-undo .
      482       def var v-user-can-edit  as logical   no-undo .
      483       def var v-output-display as logical   no-undo .
      484       def var v-other          as character no-undo .
      485       run lineattr-code in this-procedure
      486         (input  p-code
      487         ,output v-type
      488         ,output v-format
      489         ,output v-fillin_width
      490         ,output v-fillin_height
      491         ,output v-label
      492         ,output v-user-can-edit
      493         ,output v-output-display
      494         ,output v-other
      495         ) no-error .
      496       if error-status :error then do:
      497         undo, return error return-value .
      498       end.
      499       find first buf_doc-line-attr no-lock
      500         where buf_doc-line-attr.doc-code  = p-doc-code
      501           and buf_doc-line-attr.gds-code = p-gds-code
      502           and buf_doc-line-attr.attr-code = p-code
      503         no-error .
      504       if  available buf_doc-line-attr then do:
      505         p-exist = yes.
      506       end.
      507     end.
      508   end procedure.
      509   procedure lineattr-delete :
      510     do
      511     on error undo, return error return-value
      512     :
      513       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      514       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      515       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      516       define output parameter p-deleted  as logical no-undo.
      517       define buffer buf_doc-line-attr for ub.doc-line-attr .
      518       def var v-type           as character no-undo .
      519       def var v-format         as character no-undo .
      520       def var v-fillin_width   as integer   no-undo .
      521       def var v-fillin_height  as integer   no-undo .
      522       def var v-label          as character no-undo .
      523       def var v-user-can-edit  as logical   no-undo .
      524       def var v-output-display as logical   no-undo .
      525       def var v-other          as character no-undo .
      526       run lineattr-code in this-procedure
      527         (input  p-code
      528         ,output v-type
      529         ,output v-format
      530         ,output v-fillin_width
      531         ,output v-fillin_height
      532         ,output v-label
      533         ,output v-user-can-edit
      534         ,output v-output-display
      535         ,output v-other
      536         ) no-error .
      537       if error-status :error then do:
      538         undo, return error return-value .
      539       end.
      540       find first buf_doc-line-attr exclusive-lock
      541         where buf_doc-line-attr.doc-code  = p-doc-code
      542           and buf_doc-line-attr.gds-code  = p-gds-code
      543           and buf_doc-line-attr.attr-code = p-code
      544         no-error NO-WAIT.
      545       if not available buf_doc-line-attr then do:
      546         p-deleted = no.
      547       end.
      548       else do:
      549         delete buf_doc-line-attr.
      550         p-deleted = yes.
      551       end.
      552     end.
      553   end procedure.
      554   procedure lineattr-code :
      555     do on error undo, return error return-value
      556     :
      557       define input  parameter p-code           as character no-undo .
      558       define output parameter p-type           as character no-undo .
      559       define output parameter p-format         as character no-undo .
      560       define output parameter p-fillin_width   as integer   no-undo .
      561       define output parameter p-fillin_height  as integer   no-undo .
      562       define output parameter p-label          as character no-undo .
      563       define output parameter p-user-can-edit  as logical   no-undo .
      564       define output parameter p-output-display as logical   no-undo .
      565       define output parameter p-other          as character no-undo .
      566       case p-code :
      567               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      568               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      569               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      570               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      571               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      572               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      573               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      574               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      575               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      576               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      577               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      578         otherwise do:
      579           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      580         end.
      581       end.
      582     end.
      583   end procedure.
      584   procedure lineattr-value-flora-gds :
      585     do
      586     on error undo, return error return-value
      587     :
      588       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      589       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      590       define input  parameter p-prt-code    as integer   no-undo .
      591       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      592       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      593       define output parameter p-value       as    decimal   no-undo .
      594       define buffer buf_doc-line-attr for ub.doc-line-attr .
      595       find first buf_doc-line-attr no-lock
      596         where buf_doc-line-attr.doc-code  = p-doc-code
      597           and buf_doc-line-attr.gds-code  = p-gds-code
      598           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      599         no-error .
      600       if avail buf_doc-line-attr then do:
      601         assign
      602           p-value = decimal( buf_doc-line-attr.attr-value)
      603         .
      604       end.
      605       else do:
      606         assign
      607           p-value = 0
      608         .
      609       end.
      610     end.
      611   end procedure.
      612   procedure lineattr-write-flora-gds :
      613     do
      614     on error undo, return error return-value
      615     :
      616       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      617       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      618       define input parameter p-prt-code    as integer   no-undo .
      619       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      620       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      621       define input parameter p-value    as decimal   no-undo .
      622       define buffer buf_doc-line-attr for ub.doc-line-attr .
      623       find first buf_doc-line-attr exclusive-lock
      624         where buf_doc-line-attr.doc-code  = p-doc-code
      625           and buf_doc-line-attr.gds-code  = p-gds-code
      626           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      627         no-error .
      628       if not available buf_doc-line-attr then do:
      629         create buf_doc-line-attr .
      630         assign
      631           buf_doc-line-attr.doc-code  = p-doc-code
      632           buf_doc-line-attr.gds-code  = p-gds-code
      633           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      634         .
      635       end.
      636       assign
      637         buf_doc-line-attr.attr-value = string( p-value )
      638       .
      639     end.
      640   end procedure.
      641   procedure lineattr-delete-flora-gds :
      642     do
      643     on error undo, return error return-value
      644     :
      645       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      646       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      647       define input  parameter p-prt-code    as integer   no-undo .
      648       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      649       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      650       define output parameter p-deleted  as logical no-undo.
      651       define buffer buf_doc-line-attr for ub.doc-line-attr .
      652       find first buf_doc-line-attr exclusive-lock
      653         where buf_doc-line-attr.doc-code  = p-doc-code
      654           and buf_doc-line-attr.gds-code  = p-gds-code
      655           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      656         no-error NO-WAIT.
