        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: defa58501af7, 2087, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:23:51 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: libfarhp.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/libfarhp.p $":U .
        7   define variable vss-description as character no-undo init "Внутренние процедуры для библиотеки по работы с финансовыми архивами по финдокументам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#libfarhp as handle no-undo .
       67   if valid-handle (g#libfarhp)
       68   and g#libfarhp <> this-procedure :handle
       69   and g#libfarhp :get-signature('libfarhp_calc-arh-fin-doc-an':u) <> ""
       70   then do:
       71     message
       72       vss-workfile vss-revision vss-description skip
       73       "Попытка повторной загрузки внутренних процедур библиотеки для работы с финансовыми архивами по финансовым документам" skip
       74       g#libfarhp skip
       75       g#libfarhp :type skip
       76       g#libfarhp :file-name skip
       77       valid-handle(g#libfarhp) skip
       78       this-procedure :handle skip
       79       this-procedure :type skip
       80       this-procedure :file-name skip
       81       valid-handle(this-procedure) skip
       82       view-as alert-box error .
       83     undo, return error .
       84   end.
       85   else do:
       86     assign
       87       g#libfarhp = this-procedure :handle
       88     .
       89   end.
       90   on delete of this-procedure do:
       91     assign
       92       g#libfarhp = ?
       93     .
       94   end.
       95   define stream str-err.
       96   procedure libfarhp_calc-arh-fin-doc-an :
       97   define input parameter parmode                    as   character                   no-undo.
       98   define input parameter parhost-code               like ub.fin-doc.host-code        no-undo.
       99   define input parameter parpayer-type              like ub.fin-doc.payer-type       no-undo.
      100   define input parameter parpayer-code              like ub.fin-doc.payer-code       no-undo.
      101   define input parameter parreceiver-type           like ub.fin-doc.receiver-type    no-undo.
      102   define input parameter parreceiver-code           like ub.fin-doc.receiver-code    no-undo.
      103   define input parameter parpayer-code-schet        like ub.fin-schet.code-schet     no-undo.
      104   define input parameter parreceiver-code-schet     like ub.fin-schet.code-schet     no-undo.
      105   define input parameter parfin-ext-doc-type        like ub.fin-doc.fin-ext-doc-type no-undo.
      106   define input parameter parfin-code-an-uchet       like ub.fin-doc.an-uchet-code    no-undo.
      107   define input parameter parfin-code-cel-nazn       like ub.fin-doc.cel-nazn-code    no-undo.
      108   define input parameter parfin-code-cor-acc        like ub.fin-doc.cor-acc          no-undo.
      109   define input parameter parsum-type                as   character                   no-undo.
      110   define input parameter parfact-order              like ub.fin-doc.fact-order       no-undo.
      111   define input parameter parfin-doc-code            like ub.fin-doc.fin-doc-code     no-undo.
      112   define input parameter parfact-date               like ub.fin-doc.fact-date        no-undo.
      113   define input parameter parcurr-code               like ub.fin-doc.curr-code        no-undo.
      114   define input parameter parbase-code               like ub.sysconf.base-code        no-undo.
      115   define input parameter parcurr-dog-code           like ub.contract.curr-code       no-undo.
      116   define input parameter parrel-dog-code            as   logical                     no-undo.
      117   define input parameter parsum-doc                 as   decimal                     no-undo.
      118   define input parameter parsum-rubl                as   decimal                     no-undo.
      119   define input parameter parsum-base                as   decimal                     no-undo.
      120   define input parameter parsum-contr               as   decimal                     no-undo.
      121   define input parameter parsum-vat-doc             as   decimal                     no-undo.
      122   define input parameter parsum-vat-rubl            as   decimal                     no-undo.
      123   define input parameter parsum-vat-base            as   decimal                     no-undo.
      124   define input parameter parsum-vat-contr           as   decimal                     no-undo.
      125   define input parameter parsum-slt-doc             as   decimal                     no-undo.
      126   define input parameter parsum-slt-rubl            as   decimal                     no-undo.
      127   define input parameter parsum-slt-base            as   decimal                     no-undo.
      128   define input parameter parsum-slt-contr           as   decimal                     no-undo.
      129   define buffer bfps_arh-fin-doc-an  for ub.arh-fin-doc-an.
      130   define buffer bfrs_arh-fin-doc-an  for ub.arh-fin-doc-an.
      131   define buffer rbfps_arh-fin-doc-an for ub.arh-fin-doc-an.
      132   define buffer rbfrs_arh-fin-doc-an for ub.arh-fin-doc-an.
      133   define buffer bops_arh-fin-doc-an  for ub.arh-fin-doc-an.
      134   define buffer bors_arh-fin-doc-an  for ub.arh-fin-doc-an.
      135   define buffer bdps_arh-fin-doc-an  for ub.arh-fin-doc-an.
      136   define buffer bdrs_arh-fin-doc-an  for ub.arh-fin-doc-an.
      137   define buffer bfpr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      138   define buffer bfrr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      139   define buffer rbfpr_arh-fin-doc-an for ub.arh-fin-doc-an.
      140   define buffer rbfrr_arh-fin-doc-an for ub.arh-fin-doc-an.
      141   define buffer bopr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      142   define buffer borr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      143   define buffer bdpr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      144   define buffer bdrr_arh-fin-doc-an  for ub.arh-fin-doc-an.
      145   define buffer bfpb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      146   define buffer bfrb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      147   define buffer rbfpb_arh-fin-doc-an for ub.arh-fin-doc-an.
      148   define buffer rbfrb_arh-fin-doc-an for ub.arh-fin-doc-an.
      149   define buffer bopb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      150   define buffer borb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      151   define buffer bdpb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      152   define buffer bdrb_arh-fin-doc-an  for ub.arh-fin-doc-an.
      153   define buffer bfpc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      154   define buffer bfrc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      155   define buffer rbfpc_arh-fin-doc-an for ub.arh-fin-doc-an.
      156   define buffer rbfrc_arh-fin-doc-an for ub.arh-fin-doc-an.
      157   define buffer bopc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      158   define buffer borc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      159   define buffer bdpc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      160   define buffer bdrc_arh-fin-doc-an  for ub.arh-fin-doc-an.
      161   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      162   if parmode = "close":u then do:
      163     find last bops_arh-fin-doc-an where bops_arh-fin-doc-an.host-code         = parhost-code         and
      164                                         bops_arh-fin-doc-an.cli-type          = parpayer-type        and
      165                                         bops_arh-fin-doc-an.cli-code          = parpayer-code        and
      166                                         bops_arh-fin-doc-an.code-schet        = parpayer-code-schet  and
      167                                         bops_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type  and
      168                                         bops_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet and
      169                                         bops_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn and
      170                                         bops_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc  and
      171                                         bops_arh-fin-doc-an.calc-curr-code    = parcurr-code         and
      172                                         bops_arh-fin-doc-an.sum-type          = parsum-type          and
      173                                         bops_arh-fin-doc-an.fact-order        < parfact-order        use-index pi no-error.
      174     create bfps_arh-fin-doc-an.
      175     assign
      176       bfps_arh-fin-doc-an.host-code         = parhost-code
      177       bfps_arh-fin-doc-an.cli-type          = parpayer-type
      178       bfps_arh-fin-doc-an.cli-code          = parpayer-code
      179       bfps_arh-fin-doc-an.code-schet        = parpayer-code-schet
      180       bfps_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type
      181       bfps_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet
      182       bfps_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn
      183       bfps_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc
      184       bfps_arh-fin-doc-an.calc-curr-code    = parcurr-code
      185       bfps_arh-fin-doc-an.sum-type          = parsum-type
      186       bfps_arh-fin-doc-an.cource-des        = "s":u
      187       bfps_arh-fin-doc-an.fact-order        = parfact-order
      188       bfps_arh-fin-doc-an.fin-doc-code      = parfin-doc-code
      189       bfps_arh-fin-doc-an.fact-date         = parfact-date
      190       bfps_arh-fin-doc-an.curr-code         = parcurr-code
      191       bfps_arh-fin-doc-an.income            = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.income      else 0)
      192       bfps_arh-fin-doc-an.income-vat        = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.income-vat  else 0)
      193       bfps_arh-fin-doc-an.income-slt        = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.income-slt  else 0)
      194       bfps_arh-fin-doc-an.expense           = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.expense     else 0) + parsum-doc
      195       bfps_arh-fin-doc-an.expense-vat       = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.expense-vat else 0) + parsum-vat-doc
      196       bfps_arh-fin-doc-an.expense-slt       = (if available bops_arh-fin-doc-an then bops_arh-fin-doc-an.expense-slt else 0) + parsum-slt-doc
      197     .
      198   end.
      199   else do:
      200     find first bfps_arh-fin-doc-an where bfps_arh-fin-doc-an.host-code         = parhost-code         and
      201                                          bfps_arh-fin-doc-an.cli-type          = parpayer-type        and
      202                                          bfps_arh-fin-doc-an.cli-code          = parpayer-code        and
      203                                          bfps_arh-fin-doc-an.code-schet        = parpayer-code-schet  and
      204                                          bfps_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type  and
      205                                          bfps_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet and
      206                                          bfps_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn and
      207                                          bfps_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc  and
      208                                          bfps_arh-fin-doc-an.calc-curr-code    = parcurr-code         and
      209                                          bfps_arh-fin-doc-an.sum-type          = parsum-type          and
      210                                          bfps_arh-fin-doc-an.fact-order        = parfact-order        exclusive-lock.
      211   end.
      212   for each rbfps_arh-fin-doc-an where rbfps_arh-fin-doc-an.host-code          = bfps_arh-fin-doc-an.host-code         and
      213                                       rbfps_arh-fin-doc-an.cli-type           = parpayer-type                         and
      214                                       rbfps_arh-fin-doc-an.cli-code           = parpayer-code                         and
      215                                       rbfps_arh-fin-doc-an.code-schet         = bfps_arh-fin-doc-an.code-schet        and
      216                                       rbfps_arh-fin-doc-an.fin-ext-doc-type   = bfps_arh-fin-doc-an.fin-ext-doc-type  and
      217                                       rbfps_arh-fin-doc-an.fin-code-an-uchet  = bfps_arh-fin-doc-an.fin-code-an-uchet and
      218                                       rbfps_arh-fin-doc-an.fin-code-cel-nazn  = bfps_arh-fin-doc-an.fin-code-cel-nazn and
      219                                       rbfps_arh-fin-doc-an.fin-code-cor-acc   = bfps_arh-fin-doc-an.fin-code-cor-acc  and
      220                                       rbfps_arh-fin-doc-an.calc-curr-code     = bfps_arh-fin-doc-an.calc-curr-code    and
      221                                       rbfps_arh-fin-doc-an.sum-type           = bfps_arh-fin-doc-an.sum-type          and
      222                                       rbfps_arh-fin-doc-an.fact-order         > bfps_arh-fin-doc-an.fact-order        use-index pi exclusive-lock on error undo, return error return-value :
      223     assign
      224       rbfps_arh-fin-doc-an.expense     = rbfps_arh-fin-doc-an.expense     + parsum-doc
      225       rbfps_arh-fin-doc-an.expense-vat = rbfps_arh-fin-doc-an.expense-vat + parsum-vat-doc
      226       rbfps_arh-fin-doc-an.expense-slt = rbfps_arh-fin-doc-an.expense-slt + parsum-slt-doc.
      227   end.
      228   if parmode = "close":u then do:
      229     find last bors_arh-fin-doc-an where bors_arh-fin-doc-an.host-code         = parhost-code            and
      230                                         bors_arh-fin-doc-an.cli-type          = parreceiver-type        and
      231                                         bors_arh-fin-doc-an.cli-code          = parreceiver-code        and
      232                                         bors_arh-fin-doc-an.code-schet        = parreceiver-code-schet  and
      233                                         bors_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type     and
      234                                         bors_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet    and
      235                                         bors_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn    and
      236                                         bors_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc     and
      237                                         bors_arh-fin-doc-an.calc-curr-code    = parcurr-code            and
      238                                         bors_arh-fin-doc-an.sum-type          = parsum-type             and
      239                                         bors_arh-fin-doc-an.fact-order        < parfact-order           use-index pi no-error.
      240     create bfrs_arh-fin-doc-an.
      241     assign
      242       bfrs_arh-fin-doc-an.host-code         = parhost-code
      243       bfrs_arh-fin-doc-an.cli-type          = parreceiver-type
      244       bfrs_arh-fin-doc-an.cli-code          = parreceiver-code
      245       bfrs_arh-fin-doc-an.code-schet        = parreceiver-code-schet
      246       bfrs_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type
      247       bfrs_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet
      248       bfrs_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn
      249       bfrs_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc
      250       bfrs_arh-fin-doc-an.calc-curr-code    = parcurr-code
      251       bfrs_arh-fin-doc-an.sum-type          = parsum-type
      252       bfrs_arh-fin-doc-an.cource-des        = "s":u
      253       bfrs_arh-fin-doc-an.fact-order        = parfact-order
      254       bfrs_arh-fin-doc-an.fin-doc-code      = parfin-doc-code
      255       bfrs_arh-fin-doc-an.fact-date         = parfact-date
      256       bfrs_arh-fin-doc-an.curr-code         = parcurr-code.
      257     assign
      258       bfrs_arh-fin-doc-an.expense           = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.expense     else 0)
      259       bfrs_arh-fin-doc-an.expense-vat       = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.expense-vat else 0)
      260       bfrs_arh-fin-doc-an.expense-slt       = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.expense-slt else 0)
      261       bfrs_arh-fin-doc-an.income            = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.income      else 0) + parsum-doc
      262       bfrs_arh-fin-doc-an.income-vat        = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.income-vat  else 0) + parsum-vat-doc
      263       bfrs_arh-fin-doc-an.income-slt        = (if available bors_arh-fin-doc-an then bors_arh-fin-doc-an.income-slt  else 0) + parsum-slt-doc
      264     .
      265   end.
      266   else do:
      267     find first bfrs_arh-fin-doc-an where bfrs_arh-fin-doc-an.host-code         = parhost-code            and
      268                                          bfrs_arh-fin-doc-an.cli-type          = parreceiver-type        and
      269                                          bfrs_arh-fin-doc-an.cli-code          = parreceiver-code        and
      270                                          bfrs_arh-fin-doc-an.code-schet        = parreceiver-code-schet  and
      271                                          bfrs_arh-fin-doc-an.fin-ext-doc-type  = parfin-ext-doc-type     and
      272                                          bfrs_arh-fin-doc-an.fin-code-an-uchet = parfin-code-an-uchet    and
      273                                          bfrs_arh-fin-doc-an.fin-code-cel-nazn = parfin-code-cel-nazn    and
      274                                          bfrs_arh-fin-doc-an.fin-code-cor-acc  = parfin-code-cor-acc     and
      275                                          bfrs_arh-fin-doc-an.calc-curr-code    = parcurr-code            and
      276                                          bfrs_arh-fin-doc-an.sum-type          = parsum-type             and
      277                                          bfrs_arh-fin-doc-an.fact-order        = parfact-order           exclusive-lock.
      278   end.
      279   for each rbfrs_arh-fin-doc-an where rbfrs_arh-fin-doc-an.host-code         = bfrs_arh-fin-doc-an.host-code         and
      280                                       rbfrs_arh-fin-doc-an.cli-type          = parreceiver-type                      and
      281                                       rbfrs_arh-fin-doc-an.cli-code          = parreceiver-code                      and
      282                                       rbfrs_arh-fin-doc-an.code-schet        = bfrs_arh-fin-doc-an.code-schet        and
      283                                       rbfrs_arh-fin-doc-an.fin-ext-doc-type  = bfrs_arh-fin-doc-an.fin-ext-doc-type  and
      284                                       rbfrs_arh-fin-doc-an.fin-code-an-uchet = bfrs_arh-fin-doc-an.fin-code-an-uchet and
      285                                       rbfrs_arh-fin-doc-an.fin-code-cel-nazn = bfrs_arh-fin-doc-an.fin-code-cel-nazn and
      286                                       rbfrs_arh-fin-doc-an.fin-code-cor-acc  = bfrs_arh-fin-doc-an.fin-code-cor-acc  and
      287                                       rbfrs_arh-fin-doc-an.calc-curr-code    = bfrs_arh-fin-doc-an.calc-curr-code    and
      288                                       rbfrs_arh-fin-doc-an.sum-type          = bfrs_arh-fin-doc-an.sum-type          and
      289                                       rbfrs_arh-fin-doc-an.fact-order        > bfrs_arh-fin-doc-an.fact-order        use-index pi exclusive-lock on error undo, return error return-value :
      290     assign
      291       rbfrs_arh-fin-doc-an.income     = rbfrs_arh-fin-doc-an.income     + parsum-doc
      292       rbfrs_arh-fin-doc-an.income-vat = rbfrs_arh-fin-doc-an.income-vat + parsum-vat-doc
      293       rbfrs_arh-fin-doc-an.income-slt = rbfrs_arh-fin-doc-an.income-slt + parsum-slt-doc
      294     .
