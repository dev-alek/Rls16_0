        1   define input parameter fname           as character no-undo .
        2   define input parameter mess            as character no-undo .
        3   define input parameter btn-mess-start  as character no-undo .
        4   define input parameter btn-mess-end    as character no-undo .
        5   define input parameter p-waiting       as integer   no-undo .
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Диалог ожидания удаления или появления файла".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2':u,fname,p-waiting)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define stream dirstream .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   PROCEDURE proc-read-dir :
      121   DEFINE INPUT PARAMETER p-dir-name AS CHARACTER NO-UNDO.
      122   DEFINE INPUT PARAMETER p-fn-add-mask AS CHARACTER NO-UNDO.
      123   DEFINE output PARAMETER p-elapsed-time AS INTEGER NO-UNDO.
      124   DEFINE output PARAMETER p-appear AS logical NO-UNDO.
      125   define variable v-start-time as int64   no-undo.
      126   define variable file as character no-undo.
      127   define variable path as character no-undo.
      128   define variable atr  as character no-undo.
      129   define variable v-ext-split as integer   no-undo .
      130   define variable v-ext-split-mask as integer   no-undo .
      131   define variable v-file-name-no-ext as character no-undo .
      132   define variable v-file-name-ext as character no-undo .
      133   define variable v-mask-no-ext as character no-undo .
      134   define variable v-mask-ext as character no-undo .
      135   assign
      136   v-start-time = etime.
      137   input stream DirStream from os-dir (p-dir-name) .
      138   REPEAT :
      139     import stream DirStream file path atr.
      140     if can-do( "f", atr )    then do:
      141       if file matches p-fn-add-mask then do:
      142         p-appear = yes.
      143         leave.
      144       end.
      145       assign
      146       v-ext-split = r-index(file, '.':u)
      147       v-ext-split-mask = r-index(p-fn-add-mask, '.':u)
      148       .
      149       if v-ext-split > 0 then do:
      150         assign
      151           v-file-name-no-ext = substring(file, 1, v-ext-split - 1)
      152           v-file-name-ext    = substring(file, v-ext-split + 1)
      153         .
      154       end.
      155       else do:
      156         assign
      157           v-file-name-no-ext = file
      158           v-file-name-ext    = ""
      159         .
      160       end.
      161       if v-ext-split-mask > 0 then do:
      162         assign
      163           v-mask-no-ext = substring(p-fn-add-mask, 1, v-ext-split-mask - 1)
      164           v-mask-ext    = substring(p-fn-add-mask, v-ext-split-mask + 1)
      165         .
      166       end.
      167       else do:
      168         assign
      169           v-mask-no-ext = p-fn-add-mask
      170           v-mask-ext    = ""
      171         .
      172       end.
      173       if v-file-name-no-ext matches v-mask-no-ext
      174       and v-file-name-ext matches v-mask-ext
      175       then do:
      176         p-appear = yes.
      177         leave.
      178       end.
      179     end.
      180   END.
      181   assign
      182   p-elapsed-time = etime - v-start-time.
      183   END PROCEDURE.
      184   define variable v-file-name-del as character no-undo .
      185   define variable v-dir-name as character no-undo .
      186   define variable v-fn-add-mask as character no-undo .
      187   define variable v-elapsed-time as integer no-undo .
      188   define variable v-start-dir-watch-time as int64 no-undo .
      189   define variable v-appear as logical no-undo .
      190   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      191        LABEL "Прервать ожидание"
      192        SIZE 30 BY 1.5
      193        BGCOLOR 8 .
      194   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      195        VIEW-AS EDITOR
      196        SIZE 39 BY 4.67
      197        BGCOLOR 8  NO-UNDO.
      198   DEFINE VARIABLE FI-ExecTime AS CHARACTER FORMAT "X(256)":U
      199        VIEW-AS FILL-IN
      200        SIZE 39 BY 1 NO-UNDO.
      201   DEFINE FRAME DIALOG-1
      202        EDITOR-1 AT ROW 1.13 COL 2.13 NO-LABEL
      203        FI-ExecTime AT ROW 6.13 COL 2.13 NO-LABEL
      204        Btn_Cancel AT ROW 7.79 COL 6.63
      205        SPACE(5.61) SKIP(0.45)
      206       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      207            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      208            BGCOLOR 8
      209            TITLE BGCOLOR 8 ""
      210            CANCEL-BUTTON Btn_Cancel.
      211   ASSIGN
      212          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      213   ASSIGN
      214          Btn_Cancel:HIDDEN IN FRAME DIALOG-1           = TRUE.
      215   ASSIGN
      216          EDITOR-1:READ-ONLY IN FRAME DIALOG-1        = TRUE.
      217   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      218   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      219   define variable v-exec-time as integer no-undo .
      220   on window-close OF FRAME DIALOG-1 do:
      221     apply "end-error" to frame DIALOG-1.
      222   end.
      223   on "end-error":U of frame DIALOG-1 do:
      224     if v-exec-time < p-waiting then do:
      225       return no-apply .
      226     end.
      227   end.
      228   MAIN-BLOCK:
      229   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      230      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      231     assign
      232       frame DIALOG-1 :title = mess
      233     .
      234     assign
      235     v-file-name-del = entry(1, fname, chr(4))
      236     v-dir-name      = (if num-entries(fname, chr(4)) = 3
      237                        and v-file-name-del = "":U
      238                        then entry(2, fname, chr(4))
      239                        else "":U)
      240     v-fn-add-mask = (if num-entries(fname, chr(4)) = 3
      241                      and v-file-name-del = "":U
      242                      then entry(3, fname, chr(4))
      243                      else "":U)
      244     v-fn-add-mask = (if v-dir-name <> "":U and v-fn-add-mask = "":U
      245                      then "*.*"
      246                      else v-fn-add-mask)
      247     .
      248     RUN MyEnable .
      249     define variable v-start-time as int64   no-undo .
      250     assign
      251       v-start-time = etime
      252     .
      253     do while true
      254     :
      255       assign
      256         v-exec-time = (etime - v-start-time) / 1000
      257       .
      258       assign
      259         fi-exectime :screen-value = substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))
      260       .
      261       if v-exec-time >= p-waiting then do:
      262         if v-file-name-del  <> ""
      263         or v-dir-name <> "":u
      264         then do:
      265           assign
      266             Editor-1 :screen-value = btn-mess-end
      267           .
      268           display btn_cancel with frame DIALOG-1.
      269           enable btn_cancel with frame DIALOG-1.
      270         end.
      271         if v-file-name-del  = "" then do:
      272           return .
      273         end.
      274       end.
      275       if v-file-name-del <> "" then do:
      276         if search(v-file-name-del) = ?
      277         then do:
      278           return .
      279         end.
      280       end.
      281       if v-dir-name <> "":U
      282       and v-exec-time > minimum(p-waiting / 4, 15)
      283       and (v-start-dir-watch-time = 0
      284            or
      285            (etime  - v-start-dir-watch-time) > v-elapsed-time * 10
      286           )
      287       then do:
      288         assign
      289         v-start-dir-watch-time = etime.
      290         run proc-read-dir in this-procedure (
      291                                              input v-dir-name
      292                                             ,input v-fn-add-mask
      293                                             ,output v-elapsed-time
      294                                             ,output v-appear
      295                                             ) no-error .
      296         if error-status:error then do:
      297         end.
      298         if v-appear then return.
      299       end.
      300       WAIT-FOR GO OF FRAME DIALOG-1 FOCUS Btn_cancel PAUSE 1 .
      301     end.
      302   END.
      303   RUN disable_UI.
      304   return error .
      305   PROCEDURE disable_UI :
      306     HIDE FRAME DIALOG-1.
      307   END PROCEDURE.
      308   PROCEDURE enable_UI :
      309     DISPLAY EDITOR-1 FI-ExecTime
      310         WITH FRAME DIALOG-1.
      311     ENABLE EDITOR-1 FI-ExecTime
      312         WITH FRAME DIALOG-1.
      313   END PROCEDURE.
      314   PROCEDURE MyEnable :
      315    Enable Editor-1
      316    With Frame DIALOG-1.
      317    DISPLAY
      318    Editor-1
      319    FI-ExecTime
      320    With Frame DIALOG-1.
      321    Editor-1:screen-value = btn-mess-start.
      322   END PROCEDURE.
