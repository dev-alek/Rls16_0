      545   define new shared temp-table g#customer no-undo
      546       field obj-type like ub.clients.obj-type
      547       field obj-code like ub.clients.obj-code
      548       field obj-name like ub.clients.obj-name
      549       index pi is unique primary obj-type obj-code.
      550   define new shared temp-table g#cli no-undo
