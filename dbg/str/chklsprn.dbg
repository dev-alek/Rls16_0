     3391     FIND FIRST buf_bar-code No-LOCK WHERE
     3392                 buf_bar-code.b-code = buf_chk-gds.b-code NO-ERROR.
     3393     IF AVAIL buf_bar-code then do:
     3394       FIND FIRST buf_goods NO-LOCK WHERE
     3395                   buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     3396       FIND FIRST  buf_clients NO-LOCK WHERE
     3397                   buf_clients.obj-type = buf_goods.prod-type AND
     3398                   buf_clients.obj-code = buf_goods.prod-code NO-ERROR.
     3399       FIND FIRST buf_gds-prt No-LOCK where
     3400                   buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     3401     end.
     3402     else do:
     3403       release buf_goods.
     3404       release buf_clients.
     3405       release buf_gds-prt.
     3406     end.
