     1631              sheetf.sheet-num = 1 No-ERROR.
     1632   assign
     1633   sheetf.Excel-Column-Lable =  ""
     1634   sheetf.sizes = "".
     1635   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1636   l-col-pos = 1.
     1637   Assign l-col-type="CHARACTER" l-col-len=14 l-col-format= "X(14)"     l-col-lable="Номер чека в БД".
     1638     define variable ed1 as handle no-undo.
     1639     define variable l-1 as handle no-undo.
     1640     define variable ll-1 as handle no-undo.
     1641     define variable c-for-doc-code-gds as widget-handle no-undo.
     1642      if l-col-pos > 320 then l-col-pos = 320 .
     1643     if use-column[1] = true then DO:
