      602   def
      603   new shared
      604   temp-table  obj-list no-undo
      605     field obj-type like ub.clients.obj-type
      606     field obj-code like ub.clients.obj-code
      607     field obj-name like ub.clients.obj-name
      608     field obj-id   as integer
      609     field db-num   as integer
      610     index pi is primary unique obj-id
      611     index ie1 obj-type obj-code
      612     index ie2 obj-name
      613   .
      614   procedure create_obj-list :
      615      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      616      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      617      do
      618      on error undo, return error return-value
      619      :
      620         define buffer cli-obj for ub.clients .
      621         define variable p-var as integer no-undo .
      622         define buffer buf_obj-list for obj-list .
      623         find last buf_obj-list  use-index pi no-error .
      624         if available buf_obj-list
      625         then
      626            p-var = buf_obj-list.obj-id + 1.
      627         else
      628            p-var = 1.
      629         find first cli-obj where
      630                   cli-obj.obj-type = p-obj-type
      631               and cli-obj.obj-code = p-obj-code
      632         no-lock no-error.
      633         if available cli-obj
      634         then do:
      635            create buf_obj-list.
      636            assign
      637               buf_obj-list.obj-id   = p-var
      638               buf_obj-list.obj-code = cli-obj.obj-code
      639               buf_obj-list.obj-type = cli-obj.obj-type
      640               buf_obj-list.obj-name = cli-obj.obj-name
      641               buf_obj-list.db-num   = cli-obj.db-num
      642            .
      643         end.
      644      end.
      645   end.
