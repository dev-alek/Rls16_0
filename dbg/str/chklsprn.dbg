     1107   define variable l-col-len          as integer no-undo .
     1108   define variable l-col-format       as character no-undo .
     1109   define variable l-col-lable        as character no-undo .
     1110   define variable v-dec-sep          as character no-undo init ? .
     1111   define variable v-th-sep           as character no-undo init ? .
     1112   define variable v-r-col-num        as integer no-undo .
     1113   define variable v-reg-replace      as logical no-undo .
     1114   define variable v-date-col-format  as character no-undo .
     1115   DEFINE VARIABLE last-col-num as integer no-undo.
     1116   run gbl/getlocal.p (
     1117                     output v-dec-sep
     1118                    ,output v-th-sep
     1119                    ,output v-sdate
     1120                    ,output v-shortdate
     1121                    ) no-error .
     1122   assign
     1123   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1124                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1125   .
     1126     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1127                                               INPUT p-dec-sep AS CHARACTER  ) :
     1128       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1129       IF TRIM( p-string ) = "0"                    OR
     1130          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1131          TRIM( p-string ) =       p-dec-sep + "00" OR
     1132          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1133          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1134                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1135       RETURN ( TRIM( v-string ) ).
     1136     END FUNCTION.
     1137   FUNCTION reg-output returns character( input p-string as character
     1138                                         ,input p-private-data as character
     1139                                         ,input p-replace as logical
     1140                                         ,input p-supress as logical
     1141                                         ,input p-dec-sep as character
     1142                                         ,input p-th-sep as character
     1143                                         ):
     1144   DEFINE VARIABLE v-reg-output as character no-undo .
     1145   DEFINE VARIABLE v-data-type as character no-undo .
     1146   DEFINE VARIABLE v-progress-format as character no-undo .
     1147   assign
     1148   v-progress-format = entry(1, p-private-data, chr(4))
     1149   v-data-type = entry(2, p-private-data, chr(4))
     1150   .
     1151   if p-string = ? then return chr(63).
     1152   if (v-data-type = "INTEGER"
     1153       OR v-data-type = "DECIMAL" ) THEN DO:
     1154     IF p-replace THEN DO:
     1155       assign
     1156         v-reg-output = replace( p-string
     1157                                         ,chr(44)
     1158                                         ,"":U
     1159                                       )
     1160         v-reg-output = trim(v-reg-output)
     1161       .
     1162     END.
     1163     else do:
     1164       v-reg-output = p-string.
     1165     end.
     1166     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1167     return v-reg-output.
     1168   end.
     1169     return p-string.
     1170   END FUNCTION.
     1171   procedure OpenForExcel :
     1172      define variable v-ch#ExcelApplication as com-handle no-undo .
     1173      define variable v-ch#Workbook         as com-handle no-undo .
     1174      define variable v-ch#Worksheet        as com-handle no-undo .
     1175      os-delete value( string( session:temp-directory ) +
     1176                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1177      os-delete value( string( session:temp-directory ) +
     1178                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1179      os-delete value( string( session:temp-directory ) +
     1180                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1181      if Make-Excel
     1182      then do:
     1183         output stream ForExcel to value( string( session:temp-directory +
     1184                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1185         assign
     1186            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1187            number-list = 1
     1188         .
     1189         if make-excel-com
     1190         then do:
     1191   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   if valid-handle(ch#WorkSheet) then
     1193   RELEASE OBJECT ch#WorkSheet no-error.
     1194   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   if valid-handle(ch#Workbook) then
     1196   RELEASE OBJECT ch#Workbook no-error.
     1197   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   if valid-handle(ch#ExcelApplication) then
     1199   RELEASE OBJECT ch#ExcelApplication no-error.
     1200            create "Excel.Application" ch#excelApplication connect no-error.
     1201            if error-status:error
     1202            then do :
     1203           create "Excel.Application" ch#excelApplication no-error.
     1204       if error-status :error then do:
     1205           message
     1206           "Ошибка при запуске Excel" skip
     1207           error-status :get-message(1) skip
     1208           view-as alert-box error .
     1209           undo, return error .
     1210       end.
     1211            end.
     1212            assign
     1213               num#str#  = 0.
     1214               v-ch#excelApplication  = ch#excelApplication.
     1215               v-ch#excelApplication:Interactive = false.
     1216               v-ch#excelApplication:ScreenUpdating = false.
     1217               v-ch#excelApplication:Visible = false.
     1218               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1219               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1220               v-ch#Worksheet = ch#WorkSheet.
     1221               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1222               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1223               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1224               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1225            no-error .
     1226            if error-status:error
     1227            then do:
     1228               Make-Excel-com = false .
     1229               Make-Excel = false .
     1230               output Stream  ForExcel close.
     1231               os-delete value( string( session:temp-directory ) +
     1232                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1233               os-delete value( string( session:temp-directory ) +
     1234                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1235               return.
     1236            end.
     1237         end.
     1238      end.
     1239   end.
     1240   procedure CloseForExcel :
     1241      define variable ii as integer no-undo .
     1242      define variable vsheet-num as integer no-undo.
     1243      if Make-Excel
     1244      then  do:
     1245         output Stream  ForExcel close.
     1246         os-delete value( string( session:temp-directory ) +
     1247                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1248         os-delete value( string( session:temp-directory ) +
     1249                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1250         define buffer buf_sheetf for sheetf.
     1251         find last buf_sheetf no-error .
     1252         if available buf_sheetf
     1253         then
     1254            vsheet-num = buf_sheetf.sheet-num.
     1255         if vsheet-num > 1
     1256         then do:
     1257            do ii = 2 to vsheet-num:
     1258               os-delete value( string( session:temp-directory ) +
     1259                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1260            end.
     1261         end.
