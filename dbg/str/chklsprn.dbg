     3692   FUNCTION get-chk-type RETURNS CHARACTER
     3693     ( LOC-DOC-CODE AS CHARACTER, loc-chk-type as integer, loc-is-wth as logical ) :
     3694   define buffer buf_chk-doc for ub.chk-doc.
     3695   define buffer buf_chk-gds for ub.chk-gds.
     3696   define variable v-str as character no-undo.
     3697   CASE loc-is-wth:
     3698       when yes then do:
     3699       assign
     3700       v-str = entry (lookup (string(loc-chk-type),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U)
     3701       no-error
     3702       .
     3703     end.
     3704     when no then do:
     3705         if loc-chk-type = ?
     3706         or loc-chk-type = 0
     3707         then do:
     3708           find first buf_chk-doc no-lock where
     3709                     buf_chk-doc.doc-code = loc-doc-code no-error .
     3710           if available buf_chk-doc then do:
     3711             assign
     3712             loc-chk-type = integer(if buf_chk-doc.netto >= 0
     3713                     then '1':U
     3714                     else '6':U)
     3715             .
     3716           end.
     3717           if loc-chk-type = integer('6':U) then do:
     3718             for each buf_chk-gds no-lock where
     3719                     buf_Chk-gds.doc-code = buf_chk-doc.doc-code:
     3720               if not (buf_Chk-gds.write-off-code < 0 and
     3721                       (buf_Chk-gds.write-off-code = integer('-9':U)
     3722                       or
     3723                       buf_Chk-gds.write-off-code = integer('-4':U)
     3724                       )
     3725                       )
     3726               then do:
     3727                 leave.
     3728               end.
     3729             end.
     3730           end.
     3731           if not available buf_chk-gds then
     3732           loc-chk-type = integer('96':U).
     3733         end.
     3734         assign
     3735         v-str = entry (lookup (string(loc-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     3736         no-error
     3737         .
     3738     end.
     3739   END CASE.
     3740   RETURN v-str.
     3741   END FUNCTION.
