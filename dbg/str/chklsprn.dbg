      361   define  stream PrnLibStream.
      362   procedure prn-lib-prn-file :
      363     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      364     define input parameter p-DIsabledoptions as integer no-undo .
      365     define variable v-report-name as character no-undo .
      366     define variable v-user-action as character no-undo .
      367     define variable v-printed     as logical   no-undo .
      368     define variable v-exist       as logical   no-undo .
      369     do
      370       on error undo, return error
      371       :
      372       run prn-lib-get-report-name  in this-procedure (
      373         input parParentProc
      374         ,output v-report-name
      375         ).
      376   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      378     (input  v-report-name
      379     ,input  2
      380     ,output v-exist
      381     )  .
      382       if NOT v-exist then
      383       DO:
      384         Message
      385           "Нет заданий на печать ! "
      386           view-as alert-box .
      387         Return  .
      388       End.
      389       run gbl/prnfilen.w
      390         (input  ""
      391         ,input  p-DisabledOptions
      392         ,input  string(v-report-name )
      393         ,input  7
      394         ,output v-user-action
      395         ,output v-printed
      396         ) .
      397       if v-printed then
      398       do:
      399         return "YES" .
      400       end.
      401       else
      402       do:
      403         return "NO" .
      404       end.
      405     end.
      406   end procedure.
      407   procedure prn-lib-open-stream :
      408     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      409     define input parameter p-page-size    as integer no-undo .
      410     define input parameter p-is-stream    as logical no-undo .
      411     define input parameter p-append       as logical no-undo .
      412     define variable v-report-name as character no-undo .
      413     do
      414       on error undo, return error
      415       :
      416       run prn-lib-get-report-name  in this-procedure (
      417         input parParentProc
      418         ,output v-report-name
      419         ).
      420       if p-is-stream then
      421       do:
      422         if p-append then
      423         do:
      424           output stream PrnLibStream to value( v-report-name )
      425             page-size value(p-page-size) append .
      426         end.
      427         if not p-append then
      428         do:
      429           output stream PrnLibStream to value( v-report-name )
      430             page-size value(p-page-size) .
      431         end.
      432       end.
      433       if not p-is-stream then
      434       do:
      435         if p-append then
      436         do:
      437           output to value( v-report-name )
      438             page-size value(p-page-size) append .
      439         end.
      440         if not p-append then
      441         do:
      442           output to value( v-report-name )
      443             page-size value(p-page-size) .
      444         end.
      445       end.
      446     end.
      447   end procedure.
      448   procedure prn-lib-open-exp :
      449     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      450     define input parameter p-is-stream    as logical no-undo .
      451     define input parameter p-is-append    as logical no-undo .
      452     define output parameter p-ReportFileName as char init "report" no-undo.
      453     define output parameter p-process as logical no-undo .
      454     define variable glog as logical no-undo .
      455     do
      456       on error undo, return error
      457       :
      458       SYSTEM-DIALOG GET-FILE p-ReportFileName
      459         TITLE      "Укажите путь"
      460         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      461         ASK-OVERWRITE
      462         CREATE-TEST-FILE
      463         SAVE-AS
      464         USE-FILENAME
      465         DEFAULT-EXTENSION "txt"
      466         UPDATE glog
      467         .
      468       if not glog then  return.
      469       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      470       if p-is-stream then
      471       do:
      472         if p-is-append then
      473         do:
      474           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      475         end.
      476         else
      477         do:
      478           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      479         end.
      480       end.
      481       else
      482       do:
      483         if p-is-append then
      484         do:
      485           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      486         end.
      487         else
      488         do:
      489           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      490         end.
      491       end.
      492       p-process = yes.
      493     end.
      494   end procedure.
      495   procedure prn-lib-get-report-name :
      496     define input parameter parParentProc  as widget-handle no-undo.
      497     define output parameter p-report-name as character no-undo .
      498     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      499   end procedure.
      500   procedure prn-lib-reportviewer-report-name :
      501     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      502     define input parameter p-report-name-html as character no-undo .
      503     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      504   end procedure.
      505   procedure prn-lib-reportviewer :
      506     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      507     define input parameter p-report-name-html as character no-undo .
      508     define input parameter p-param        as character no-undo .
      509     define variable v-excel           as character no-undo init 'TRUE' .
      510     define variable v-value-character as character no-undo .
      511     define variable v-value-integer   as character no-undo .
      512     define variable v-value-date      as date      no-undo .
      513     define variable v-value-decimal   as decimal   no-undo .
      514     define variable rep-excel         as logical   no-undo .
      515     define variable excel-string      as character no-undo .
      516     define variable v-param-type      as character no-undo .
      517     define variable v-tth             as handle    no-undo .
      518     run adm/shattri.p (
      519       input "get":U
      520       ,input  ""
      521       ,input  0
      522       ,input  'report-glob':U
      523       ,input  'rep-excel':U
      524       ,output v-value-character
      525       ,output v-value-date
      526       ,output v-value-decimal
      527       ,output v-value-integer
      528       ,output rep-excel
      529       ,output v-param-type
      530       ,INPUT-OUTPUT table-handle v-tth
      531       )  .
      532     if rep-excel then v-excel = "TRUE" .
      533     else v-excel = "FALSE" .
      534     if p-param eq ""
      535     then
      536        p-param = "EXCEL:" + v-excel.
      537     else
      538        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      539     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      540   end procedure.
      541   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
