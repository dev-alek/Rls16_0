     1273   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   define variable v-waitfram-action01         as character   no-undo .
     1275   define variable v-waitfram-action02         as character   no-undo .
     1276   define variable v-waitfram-action03         as character   no-undo .
     1277   define variable mWaitFramTextBeg            as character   no-undo.
     1278   define variable mWaitFramTextEnd            as character   no-undo.
     1279   define variable mWaitFramView               as logical     no-undo.
     1280   define variable mWaitProcEvent              as logical     no-undo init yes.
     1281   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1282   define variable mWaitFramStop               as logical     no-undo.
     1283   define variable mWaitFramStopUser           as logical     no-undo.
     1284   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1285   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1286   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1287   define button B-WaitFramStop auto-end-key
     1288        label "Стоп"
     1289        size 10 by 1 tooltip "Остоновить процесс".
     1290   define button B-viewProcInfo
     1291        label "Информация"
     1292        size 15 by 1 tooltip "Информация о процесс".
     1293   define frame waitfram
     1294     v-waitfram-action01 format "x(72)" no-label skip
     1295     v-waitfram-action02 format "x(72)" no-label skip
     1296     v-waitfram-action03 format "x(72)" no-label skip
     1297     B-viewProcInfo
     1298     B-WaitFramStop at row 4 col 30
     1299     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1300     .
     1301   define new global shared variable mBatchMode as logical no-undo init ?.
     1302   define variable mFramBachModHandle as handle no-undo.
     1303   mFramBachModHandle = frame waitfram:handle.
     1304   define variable mFameOldVis as logical no-undo.
     1305   define variable mVisCUrentVin as logical no-undo.
     1306   if session:batch-mode
     1307   then
     1308      mBatchMode = yes.
     1309   if mBatchMode = ? then do:
     1310     mVisCUrentVin = current-window:visible.
     1311     mFameOldVis = mFramBachModHandle:visible.
     1312     mFramBachModHandle:visible  = yes.
     1313     mBatchMode = mFramBachModHandle:visible ne yes.
     1314     mFramBachModHandle:visible = mFameOldVis.
     1315     current-window:visible = mVisCUrentVin.
     1316   end.
     1317    if  log-manager:logfile-name ne ?
     1318     then DO:
     1319         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1320         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1321         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1322     end.
     1323   on choose of B-WaitFramStop in frame waitfram
     1324   do:
     1325     mWaitFramStop = yes.
     1326     mWaitFramStopUser = yes.
     1327   end.
     1328   function waitfram-check-timeout returns logical():
     1329      define variable vtime as int64 no-undo.
     1330      if mWaitFramStopTimeOut
     1331      then
     1332         return yes.
     1333      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1334      if     mWaitFramTimeOut ne ?
     1335         and mWaitFramTimeOut ne 0
     1336         and mWaitFramTimeOut lt vtime
     1337      then do:
     1338         mWaitFramStopTimeOut = yes.
     1339      end.
     1340      return mWaitFramStopTimeOut.
     1341   end.
     1342   procedure waitfram-hide :
     1343     if not session:batch-mode
     1344     then do
     1345     on error undo, return error return-value
     1346     :
     1347       pause 0 before-hide .
     1348       if not mBatchMode then
     1349         hide frame waitfram .
     1350     if     not mWaitFramView
     1351        and mWaitProcEvent
     1352     then
     1353       process events .
     1354     end.
     1355   end procedure.
     1356   procedure waitfram-show :
     1357     define input  parameter p-message as character no-undo .
     1358     define variable v-left-margin as integer   no-undo .
     1359     if not session:batch-mode
     1360     then do
     1361     on error undo, return error return-value
     1362     :
     1363       if length(p-message) <= 70 then do:
     1364         assign
     1365           v-left-margin = integer((70 - length(p-message)) / 2)
     1366         .
     1367         assign
     1368           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1369         .
     1370         assign
     1371           v-waitfram-action01 = " "
     1372           v-waitfram-action02 = " "
     1373                                    + fill(" ", v-left-margin)
     1374                                    + p-message
     1375           v-waitfram-action03 = " "
     1376         .
     1377       end.
     1378       else do:
     1379         define variable vRindex1 as integer no-undo.
     1380         define variable vRindex2 as integer no-undo.
     1381         vRindex1 = r-index(p-message," ",70).
     1382         if vRindex1 = 0
     1383         then
     1384            vRindex1 = 70.
     1385         if length(p-message)  <= vRindex1 + 70 then do:
     1386           assign
     1387             v-waitfram-action01 = " "
     1388             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1389             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1390           .
     1391         end.
     1392         else do:
     1393           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1394           if vRindex2 <= vRindex1
     1395           then
     1396              vRindex2 = vRindex1 + 70.
     1397           assign
     1398             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1399             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1400             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1401           .
     1402         end.
     1403       end.
     1404       B-viewProcInfo:visible   in frame waitfram = no.
     1405       B-viewProcInfo:sensitive in frame waitfram = no.
     1406       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1407       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1408       if  (   mWaitFramView
     1409          or  mWaitProcEvent)
     1410          and not mBatchMode
     1411       then
     1412          display
     1413             v-waitfram-action01 skip
     1414             v-waitfram-action02 skip
     1415             v-waitfram-action03 skip
     1416          with frame waitfram .
     1417       if     mWaitFramView
     1418          then do:
     1419             if     mWaitFramInterval ne ?
     1420                and not mBatchMode
     1421             then
     1422                wait-for go of frame waitfram pause mWaitFramInterval.
     1423          end.
     1424          else
     1425             if     mWaitProcEvent
     1426                and not mBatchMode
     1427             then
     1428                process events .
     1429     end.
     1430   end procedure.
     1431      procedure waitfram-show-this:
     1432         define input  parameter iInterval as int64 no-undo.
     1433         define variable vtime as int64 no-undo.
     1434         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1435         mWaitFramInterval = iInterval.
     1436         run waitfram-show (substitute("&1&2 &3&4" ,
     1437                                       mWaitFramTextBeg ,
     1438                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1439                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1440                                       mWaitFramTextEnd
     1441                                      )
     1442                           ).
     1443      end.
     1444      procedure WaitFramRunPause:
     1445         define input  parameter iInterval as dec no-undo.
     1446         define variable vStart  as datetime-tz no-undo.
     1447         define variable vend    as datetime-tz no-undo.
     1448         define variable vint as int64 no-undo.
     1449         define variable vOk as logical no-undo.
     1450         vStart = now.
     1451         vend   = vStart.
     1452         publish "WaitFramPause" (iInterval,output vOk).
     1453         vend   =  now.
     1454         vint = vend - vStart.
     1455         vint = iInterval - vint / 1000.
     1456         if     not mWaitFramStop
     1457            and (   vint > 0
     1458                 or (    not vOk
     1459                     and iInterval eq ?
     1460                     )
     1461                 )
     1462         then
     1463            run waitfram-show-this (iInterval).
     1464         vend   =  now.
     1465         vint = vend - vStart.
     1466         vint = iInterval - vint / 1000.
     1467         if     not mWaitFramStop
     1468            and vint > 0
     1469         then do:
     1470            run gbl/pause.p (vint * 1000).
     1471         end.
     1472         if iInterval ne ?
     1473         then
     1474            publish "WaitFramStop".
     1475         waitfram-check-timeout().
     1476      end.
     1477      procedure WaitFramWaitFor:
     1478         define input  parameter iInterval as dec no-undo.
     1479         assign
     1480            mWaitFramStartProc   = now
     1481            mWaitFramStopUser    = no
     1482            mWaitFramStopTimeOut = no
     1483         .
     1484         block-wait:
     1485         do while not mWaitFramStop:
     1486            run WaitFramRunPause (iInterval).
     1487            if  waitfram-check-timeout()
     1488            then do:
     1489               leave block-wait.
     1490            end.
     1491         end.
     1492         run waitfram-hide.
     1493      end.
     1494   procedure waitfram-join :
     1495     define input  parameter p-line-1  as character no-undo .
     1496     define input  parameter p-line-2  as character no-undo .
     1497     define input  parameter p-line-3  as character no-undo .
     1498     define output parameter p-message as character no-undo .
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502       assign
     1503         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1504                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1505                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1506       .
     1507     end.
     1508   end procedure.
     1509   function waitfram-join-function returns character
     1510     (input p-line-1 as character
     1511     ,input p-line-2 as character
     1512     ,input p-line-3 as character
     1513     ).
     1514     define variable v-message as character no-undo .
     1515     run waitfram-join in this-procedure
     1516       (input  p-line-1
     1517       ,input  p-line-2
     1518       ,input  p-line-3
     1519       ,output v-message
     1520       ) .
     1521     return v-message .
     1522   end function .
     1523   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1524   define variable paycardv as character no-undo .
     1525   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
     1526   define variable kk as integer no-undo .
     1527   define variable pay-card-num as character no-undo .
     1528   define buffer buf_cash-pay for ub.cash-pay.
     1529   find first buf_cash-pay no-lock where
     1530              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
     1531          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
     1532   if not avail buf_cash-pay then return "":U.
     1533   if p-pay-card = "":u
     1534   or p-pay-card = ? then return "":U.
     1535   assign
     1536   pay-card-num = "":U
     1537   .
     1538   _kk:
     1539   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
     1540     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
     1541       assign
     1542       pay-card-num = p-pay-card
     1543       .
     1544       return pay-card-num.
     1545     end.
     1546   end.
     1547   if pay-card-num = "":u then do:
     1548     if length(p-pay-card) > 4 then
     1549     assign
     1550     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
     1551                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
     1552     .
     1553     else
     1554     return fill("*":U, length(p-pay-card)).
     1555   end.
     1556   return pay-card-num.
     1557   END FUNCTION.
     1558   if not valid-handle(my-handle) then do:
     1559     assign
     1560     my-handle = parparentproc.
     1561   end.
     1562   FUNCTION get-chk-type RETURNS CHARACTER
     1563     ( input loc-doc-code as character,
     1564       input loc-doc-type as integer,
     1565       input loc-is-wth as logical)  FORWARD.
     1566   DEFINE STREAM PrnLibStream.
     1567   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1568        VIEW-AS EDITOR
     1569        SIZE 1 BY 4 NO-UNDO.
     1570   DEFINE FRAME top-frame
     1571       t-1       AT ROW 1 COL 1 no-label
     1572       HEADER
     1573       cur-time-print() AT 5 format "x(35)"
     1574       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1575       with width 232 down stream-io use-text NO-BOX.
     1576    DEFINE FRAME Doc
     1577      with width 232 down stream-io use-text NO-BOX.
     1578   CASE pReportOption:
     1579     when "excel":U then do:
     1580       Make-excel = yes.
     1581     end.
     1582     when "":U then do:
     1583     end.
     1584   end.
     1585   assign
     1586   fill2 = fill("-", 2)
     1587   fill3 = fill("-", 3)
     1588   fill4 = fill("-", 4)
     1589   fill5 = fill("-", 5)
     1590   fill6 = fill("-", 6)
     1591   fill7 = fill("-", 7)
     1592   fill8 = fill("-", 8)
     1593   fill9 = fill("-", 9)
     1594   fill10 = fill("-", 10)
     1595   fill11 = fill("-", 11)
     1596   fill13 = fill("-", 13)
     1597   fill14 = fill("-", 14)
     1598   fill16 = fill("-", 16)
     1599   fill19 = fill("-", 19)
     1600   fill20 = fill("-", 20)
     1601   fill40 = fill("-", 40)
     1602   .
