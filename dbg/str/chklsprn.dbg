     1604   assign
     1605   use-column[1] = yes
     1606   use-column[2] = yes
     1607   use-column[3] = yes
     1608   use-column[4] = yes
     1609   use-column[5] = yes
     1610   use-column[6] = yes
     1611   use-column[7] = yes
     1612   use-column[8] = yes
     1613   use-column[9] = yes
     1614   use-column[10] = yes
     1615   use-column[11] = yes
     1616   use-column[12] = yes
     1617   use-column[13] = yes
     1618   use-column[14] = yes
     1619   use-column[15] = yes
     1620   use-column[16] = yes
     1621   use-column[17] = yes
     1622   use-column[18] = yes
     1623   use-column[19] = yes
     1624   use-column[20] = yes
     1625   use-column[21] = yes
     1626   .
     1627   FOR EACH sheetf where sheetf.sheet-num > 1:
     1628     delete sheetf.
     1629   end.
