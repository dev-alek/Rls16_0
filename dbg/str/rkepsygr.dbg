      439   procedure fbrglib-get-sort-name :
      440   do
      441   on error undo, return error
      442   :
      443   define input parameter p-obj-type   as character    no-undo.
      444   define input parameter p-obj-code   as integer      no-undo.
      445   define input parameter p-node-code  as integer      no-undo.
      446   define output parameter p-sort-name as character    no-undo.
      447       define variable v-upper-code    as integer           no-undo.
      448       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      449       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      450       find first buf_fbr-gds-grp no-lock
      451            where buf_fbr-gds-grp.obj-type  = p-obj-type
      452              and buf_fbr-gds-grp.obj-code  = p-obj-code
      453              and buf_fbr-gds-grp.node-code = p-node-code
      454       no-error.
      455       if not available buf_fbr-gds-grp
      456       then do:
      457           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      458       end.
      459       assign
      460           p-sort-name  = ""
      461           v-upper-code = 1
      462       .
      463       do while true
      464       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      465       :
      466           assign
      467               p-sort-name  = buf_fbr-gds-grp.node-name
      468                            + (if p-sort-name <> "" then chr(2) else "")
      469                            + p-sort-name
      470               v-upper-code = buf_fbr-gds-grp.upper-code
      471           .
      472           if buf_fbr-gds-grp.upper-code = 1
      473           then do:
      474               leave.
      475           end.
      476           find first buf_fbr-gds-grp no-lock
      477                where buf_fbr-gds-grp.obj-type  = p-obj-type
      478                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      479                  and buf_fbr-gds-grp.node-code = v-upper-code
      480           no-error.
      481           if not available buf_fbr-gds-grp
      482           then do:
      483               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      484                                   + string( v-upper-code )
      485                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      486           end.
      487       end.
      488   end.
      489   end procedure.
      490   procedure fbrglib-get-full-name :
      491   do
      492   on error undo, return error
      493   :
      494   define input parameter p-obj-type   as character    no-undo.
      495   define input parameter p-obj-code   as integer      no-undo.
      496   define input parameter p-node-code  as integer      no-undo.
      497   define output parameter p-full-name as character    no-undo.
      498       define variable v-upper-code    as integer           no-undo.
      499       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      500       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      501       if p-node-code = 1
      502       then do:
      503           assign
      504               p-full-name = ""
      505           .
      506       end.
      507       else do:
      508           find first buf_fbr-gds-grp no-lock
      509                where buf_fbr-gds-grp.obj-type  = p-obj-type
      510                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      511                  and buf_fbr-gds-grp.node-code = p-node-code
      512           no-error.
      513           if not available buf_fbr-gds-grp
      514           then do:
      515               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      516           end.
      517           assign
      518               p-full-name  = ""
      519               v-upper-code = 1
      520           .
      521           do while true
      522           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      523           :
      524               assign
      525                   p-full-name  = buf_fbr-gds-grp.node-name
      526                               + (if p-full-name <> "" then chr(47) else "")
      527                               + p-full-name
      528                   v-upper-code = buf_fbr-gds-grp.upper-code
      529               .
      530               if buf_fbr-gds-grp.upper-code = 1
      531               then do:
      532                   leave.
      533               end.
      534               find first buf_fbr-gds-grp no-lock
      535                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      536                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      537                      and buf_fbr-gds-grp.node-code = v-upper-code
      538               no-error.
      539               if not available buf_fbr-gds-grp
      540               then do:
      541                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      542                                       + string( v-upper-code )
      543                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      544               end.
      545           end.
      546           assign
      547               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      548           .
      549       end.
      550   end.
      551   end procedure.
      552   procedure fbrglib-get-root-code :
      553   do
      554   on error undo, return error
      555   :
      556   define output parameter p-root-code as integer      no-undo.
      557       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      558       find first buf_fbr-gds-grp no-lock
      559            where buf_fbr-gds-grp.upper-code = 0
      560       no-error .
      561       if not available buf_fbr-gds-grp
      562       then do:
      563           undo, return error .
      564       end.
      565       else do:
      566           assign
      567               p-root-code = buf_fbr-gds-grp.node-code
      568           .
      569       end.
      570   end.
      571   end procedure.
      572   procedure fbrglib-find-grp-by-full-name :
      573   do
      574   on error undo, return error
      575   :
      576   define input parameter p-obj-type     as character    no-undo.
      577   define input parameter p-obj-code     as integer      no-undo.
      578   define input parameter p-search-name  as character    no-undo.
      579   define input parameter p-fill-path    as logical      no-undo.
      580       define variable v-upper-code    as integer          no-undo.
      581       define variable v-not-found     as logical init yes no-undo.
      582       define variable v-counter       as integer           no-undo.
      583       define variable v-level         as integer           no-undo.
      584       define variable v-full-name     as character         no-undo.
      585       define variable v-sort-name     as character         no-undo.
      586       define variable v-node-name     as character      no-undo.
      587       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      588       assign
      589           p-search-name = replace( p-search-name, chr(47), chr(2) )
      590       .
      591       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      592       if error-status :error
      593       then do:
      594           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      595       end.
      596       assign
      597           v-full-name  = ""
      598           v-level      = num-entries( p-search-name, chr(2) )
      599       .
      600       for each temp_fbrglib_found-grp
      601       :
      602           delete temp_fbrglib_found-grp.
      603       end.
      604       start-name-analyze:
      605       do v-counter = 1 to v-level
      606       :
      607           if v-counter < v-level
      608           then do:
      609               assign
      610                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      611               .
      612               find first buf_fbr-gds-grp no-lock
      613                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      614                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      615                      and buf_fbr-gds-grp.upper-code = v-upper-code
      616                      and buf_fbr-gds-grp.node-name  = v-node-name
      617               no-error .
      618               if not available buf_fbr-gds-grp
      619               then do:
      620                   assign
      621                       v-full-name  = p-search-name
      622                       v-sort-name  = p-search-name
      623                   .
      624                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      625               end.
      626               else do:
      627                   assign
      628                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      629                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      630                       v-upper-code = buf_fbr-gds-grp.node-code
      631                   .
      632                   if p-fill-path = yes
      633                   then do:
      634                       create temp_fbrglib_found-grp.
      635                       assign
      636                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      637                           temp_fbrglib_found-grp.sort-name = v-sort-name
      638                           temp_fbrglib_found-grp.node-code = v-upper-code
      639                           temp_fbrglib_found-grp.level     = v-counter
      640                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      641                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      642                       .
      643                   end.
      644               end.
      645           end.
      646           else do:
      647               for each buf_fbr-gds-grp no-lock
      648                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      649                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      650                    and buf_fbr-gds-grp.upper-code = v-upper-code
      651                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      652               :
      653                   assign
      654                       v-not-found = no
      655                   .
      656                   create temp_fbrglib_found-grp.
      657                   assign
      658                       temp_fbrglib_found-grp.full-name = v-full-name
      659                                                           + (if v-full-name = "" then "" else chr(47) )
      660                                                           + buf_fbr-gds-grp.node-name + chr(47)
      661                       temp_fbrglib_found-grp.sort-name = v-sort-name
      662                                                           + ( if v-sort-name = "" then "" else chr(2) )
      663                                                           + buf_fbr-gds-grp.node-name
      664                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      665                       temp_fbrglib_found-grp.level     = v-level
      666                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      667                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      668                   .
      669               end.
      670               if v-not-found = yes
      671               then do:
      672                   assign
      673                       v-full-name  = p-search-name
      674                       v-sort-name  = p-search-name
      675                   .
      676                   for each temp_fbrglib_found-grp
      677                   :
      678                       delete temp_fbrglib_found-grp.
      679                   end.
      680                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      681               end.
      682           end.
      683       end.
      684   end.
      685   end procedure.
      686   procedure fbrglib-find-all-subgroup :
      687   do
      688   on error undo, return error
      689   :
      690   define input parameter p-start-obj-type     as character    no-undo.
      691   define input parameter p-start-obj-code     as integer      no-undo.
      692   define input parameter p-start-node-code    as integer      no-undo.
      693   define input parameter p-terminal-only      as logical      no-undo.
      694       define variable v-start-full-name   as character     no-undo.
      695       define variable v-start-sort-name   as character     no-undo.
      696       define variable v-not-found         as logical       no-undo.
      697       define variable v-is-terminal       as logical       no-undo.
      698       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      699       create temp_found-result-nodelist.
      700       assign
      701           temp_found-result-nodelist.node-code = p-start-node-code
      702           temp_found-result-nodelist.processed = no
      703       .
      704       run fbrglib-get-full-name in this-procedure (
      705             input p-start-obj-type
      706           , input p-start-obj-code
      707           , input p-start-node-code
      708           , output v-start-full-name
      709       ).
      710       run fbrglib-get-full-name in this-procedure (
      711             input p-start-obj-type
      712           , input p-start-obj-code
      713           , input p-start-node-code
      714           , output v-start-sort-name
      715       ).
      716       process-nodes:
      717       do while yes
      718       :
      719           find first temp_found-result-nodelist
      720                where temp_found-result-nodelist.node-code = p-start-node-code
      721           .
      722           assign
      723               temp_found-result-nodelist.processed = yes
      724           .
      725           for each buf_fbr-gds-grp no-lock
      726              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      727                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      728                and buf_fbr-gds-grp.upper-code = p-start-node-code
      729           on error undo, return error
      730           :
      731               run fbrglib-is-terminal in this-procedure (
      732                     input buf_fbr-gds-grp.obj-type
      733                   , input buf_fbr-gds-grp.obj-code
      734                   , input buf_fbr-gds-grp.node-code
      735                   , output v-is-terminal
      736               ).
      737               if v-is-terminal = yes
      738               then do:
      739                   create temp_fbrglib_found-grp.
      740                   assign
      741                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      742                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      743                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      744                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      745                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      746                       temp_fbrglib_found-grp.is-terminal = yes
      747                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      748                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      749                   .
      750               end.
      751               else do:
      752                   create temp_found-result-nodelist.
      753                   assign
      754                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      755                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      756                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      757                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      758                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      759                       temp_found-result-nodelist.processed = no
      760                   .
      761                   if p-terminal-only = no
      762                   then do:
      763                       create temp_fbrglib_found-grp.
      764                       assign
      765                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      766                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      767                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      768                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      769                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      770                           temp_fbrglib_found-grp.is-terminal = no
      771                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      772                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      773                       .
      774                   end.
      775               end.
      776           end.
      777           find first temp_found-result-nodelist
      778                where temp_found-result-nodelist.processed = no
      779           no-error.
      780           if not available temp_found-result-nodelist
      781           then do:
      782               leave process-nodes.
      783           end.
      784           else do:
      785               assign
      786                   p-start-node-code = temp_found-result-nodelist.node-code
      787                   v-start-full-name = temp_found-result-nodelist.full-name
      788                   v-start-sort-name = temp_found-result-nodelist.sort-name
      789               .
      790           end.
      791       end.
      792   end.
      793   end procedure.
      794   procedure fbrglib-expand-name :
      795   do
      796   on error undo, return error
      797   :
      798   define input parameter p-obj-type   as character    no-undo.
      799   define input parameter p-obj-code   as integer      no-undo.
      800   define input parameter p-start-name as character    no-undo.
      801   define output parameter p-end-name  as character    no-undo.
      802       define variable v-is-terminal     as logical           no-undo.
      803       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      804       run fbrglib-find-grp-by-full-name in this-procedure (
      805             input p-obj-type
      806           , input p-obj-code
      807           , input p-start-name
      808           , input no
      809       ) no-error.
      810       run fbrglib-get-max-substring in this-procedure (
      811              input p-obj-type
      812           ,  input p-obj-code
      813           ,  input length( p-start-name )
      814           , output p-end-name
      815       ) no-error .
      816       if error-status :error
      817       then do:
      818           assign
      819               p-end-name = ""
      820           .
      821       end.
      822       else do:
      823           find first temp_fbrglib_found-grp
      824                where temp_fbrglib_found-grp.full-name = p-end-name
      825                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      826                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      827                        no-error.
      828           if available temp_fbrglib_found-grp
      829           then do:
      830               find first buf_temp_fbrglib_found-grp
      831                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      832                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      833                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      834                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      835               no-error.
      836               if not available buf_temp_fbrglib_found-grp
      837               then do:
      838                   run fbrglib-is-terminal in this-procedure (
      839                         input p-obj-type
      840                       , input p-obj-code
      841                       , input temp_fbrglib_found-grp.node-code
      842                       , output v-is-terminal
      843                   ).
      844               end.
      845           end.
      846       end.
      847   end.
      848   end procedure.
      849   procedure fbrglib-get-max-substring :
      850   do
      851   on error undo, return error
      852   :
      853   define input parameter p-obj-type as character no-undo .
      854   define input parameter p-obj-code as integer no-undo .
      855   define input parameter p-min-substring-length   as integer      no-undo.
      856   define output parameter p-substring             as character    no-undo.
      857           define variable v-char-counter  as integer           no-undo.
      858           define variable v-current-char  as character         no-undo.
      859           define variable v-names-counter  as integer           no-undo.
      860           define variable v-base-string   as character         no-undo.
      861           assign
      862               v-char-counter  = p-min-substring-length
      863           .
      864           find first temp_fbrglib_found-grp  where
      865                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      866                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      867           no-error.
      868           if not available temp_fbrglib_found-grp
      869           then do:
      870               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      871           end.
      872           else do:
      873               assign
      874                   v-base-string = temp_fbrglib_found-grp.full-name
      875               .
      876               counter-block:
      877               do while yes
      878               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      879               :
      880                   assign
      881                       v-char-counter  = v-char-counter + 1
      882                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      883                       v-names-counter = 0
      884                   .
      885                   compare-block:
      886                   for each temp_fbrglib_found-grp
      887                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      888                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      889                   :
      890                       assign
      891                           v-names-counter = v-names-counter + 1
      892                       .
      893                       if v-names-counter = 1
      894                       then do:
      895                           next compare-block.
      896                       end.
      897                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      898                       then do:
      899                           leave counter-block.
      900                       end.
      901                   end.
      902                   if v-names-counter = 1
      903                   then do:
      904                       assign
      905                           p-substring = v-base-string
      906                       .
      907                       return.
      908                   end.
      909               end.
      910               assign
      911                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      912               .
      913           end.
      914   end.
      915   end procedure.
      916   procedure fbrglib-is-terminal :
      917   do
      918   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      919   :
      920   define input parameter p-obj-type       as character    no-undo.
      921   define input parameter p-obj-code       as integer      no-undo.
      922   define input parameter p-node-code      as integer      no-undo.
      923   define output parameter p-is-terminal   as logical      no-undo.
      924       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      925       find first buf_fbr-gds-grp no-lock
      926            where buf_fbr-gds-grp.obj-type   = p-obj-type
      927              and buf_fbr-gds-grp.obj-code   = p-obj-code
      928              and buf_fbr-gds-grp.upper-code = p-node-code
      929       no-error .
      930       if not available buf_fbr-gds-grp
      931       then do:
      932           assign
      933               p-is-terminal = yes
      934           .
      935       end.
      936       else do:
      937           assign
      938               p-is-terminal = no
      939           .
      940       end.
      941   end.
      942   end procedure.
      943   procedure fbrglib-have-goods :
      944   do
      945   on error undo, return error
      946   :
      947   define input parameter p-obj-type           as character    no-undo.
      948   define input parameter p-obj-code           as integer      no-undo.
      949   define input parameter p-node-code          as integer      no-undo.
      950   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      951       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      952       find first buf_fbr-gds-obj no-lock
      953            where buf_fbr-gds-obj.obj-type     = p-obj-type
      954              and buf_fbr-gds-obj.obj-code     = p-obj-code
      955              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      956       no-error .
      957       if available buf_fbr-gds-obj
      958       then do:
      959           assign
      960               p-have-fbr-gds-obj = yes
      961           .
      962       end.
      963       else do:
      964           assign
      965               p-have-fbr-gds-obj = no
      966           .
      967       end.
      968   end.
      969   end procedure.
      970   procedure fbrglib-find-by-substring :
      971   do
      972   on error undo, return error
      973   :
      974   define input parameter p-start-obj-type     as character    no-undo.
      975   define input parameter p-start-obj-code     as integer      no-undo.
      976   define input parameter p-start-code         as integer      no-undo.
      977   define input parameter p-full-search-string as character    no-undo.
      978   define output parameter p-found-code        as integer      no-undo.
      979   define output parameter p-full-name         as character    no-undo.
      980       define variable v-start-code     as integer           no-undo.
      981       define variable v-found          as logical  init no  no-undo.
      982       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      983       search-grp:
      984       for each buf_fbr-gds-grp no-lock
      985           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      986             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      987             and buf_fbr-gds-grp.node-code > p-start-code
      988       :
      989           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      990           then do:
      991               assign
      992                   p-found-code = buf_fbr-gds-grp.node-code
      993                   v-found      = yes
      994               .
      995               run fbrglib-get-full-name in this-procedure (
      996                     input p-start-obj-type
      997                   , input p-start-obj-code
      998                   , input p-found-code
      999                   , output p-full-name
     1000               ) no-error .
     1001               if error-status :error
     1002               then do:
     1003                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1004               end.
     1005               leave search-grp.
     1006           end.
     1007       end.
     1008       if v-found = yes
     1009       then do:
     1010       end.
     1011       else do:
     1012           assign
     1013               p-full-name  = ""
     1014               p-found-code = 0
     1015           .
     1016       end.
     1017   end.
     1018   end procedure.
     1019   procedure fbrglib-analyze-grp-name :
     1020   do
     1021   on error undo, return error
     1022   :
     1023   define input parameter p-grp-name       as character            no-undo.
     1024   define input parameter p-obj-type       as character            no-undo.
     1025   define input parameter p-obj-code       as integer              no-undo.
     1026   define input parameter p-upper-code     as integer              no-undo.
     1027   define output parameter p-error-message as character init ""    no-undo.
     1028       define variable v-char-list     as character    no-undo.
     1029       define variable v-char-counter  as integer      no-undo.
     1030       define variable v-full-name     as character    no-undo.
     1031       if p-grp-name = "" then do:
     1032           assign
     1033               p-error-message = "Название группы не может быть пустым.".
     1034           .
     1035       end.
     1036       else do:
     1037           assign
     1038               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1039           .
     1040           do v-char-counter = 1 to num-entries( v-char-list )
     1041           :
     1042               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1043               then do:
     1044                   assign
     1045                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1046                   .
     1047                   return.
     1048               end.
     1049           end.
     1050           run fbrglib-get-full-name in this-procedure (
     1051                 input p-obj-type
     1052               , input p-obj-code
     1053               , input p-upper-code
     1054               , output v-full-name
     1055           ) no-error .
     1056           if error-status :error
     1057           then do:
     1058               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1059           end.
     1060           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1061           then do:
     1062               assign
     1063                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1064               .
     1065           end.
     1066       end.
     1067   end.
     1068   end procedure.
     1069   procedure fbrglib-delete-grp :
     1070   do
     1071   on error undo, return error
     1072   :
     1073   define input parameter p-obj-type   as character    no-undo.
     1074   define input parameter p-obj-code   as integer      no-undo.
     1075   define input parameter p-node-code  as integer      no-undo.
     1076   define output parameter p-deleted   as logical      no-undo.
     1077       define variable v-have-goods    as logical        no-undo.
     1078       define variable v-yesno         as logical        no-undo.
     1079       define variable v-upper-code    as integer        no-undo.
     1080       define variable v-root-code     as integer        no-undo.
     1081       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1082       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1083       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1084       run fbrglib-get-root-code in this-procedure (
     1085           output v-root-code
     1086       ) no-error.
     1087       if error-status :error
     1088       then do:
     1089           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1090       end.
     1091       if p-node-code = v-root-code
     1092       then do:
     1093           message
     1094               "Корневую группу удалить невозможно."
     1095           view-as alert-box error.
     1096           assign
     1097               p-deleted = no
     1098           .
     1099           undo, return.
     1100       end.
     1101       find first buf_fbr-gds-grp no-lock
     1102            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1103              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1104              and buf_fbr-gds-grp.upper-code   = p-node-code
     1105       no-error.
     1106       if available buf_fbr-gds-grp
     1107       then do:
     1108           message
     1109               "Не терминальную группу удалить невозможно."
     1110           view-as alert-box error.
     1111           assign
     1112               p-deleted = no
     1113           .
     1114           undo, return.
     1115       end.
     1116       find first buf_fbr-gds-grp no-lock
     1117            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1118              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1119              and buf_fbr-gds-grp.node-code    = p-node-code
     1120       .
     1121       assign
     1122           v-upper-code = buf_fbr-gds-grp.upper-code
     1123       .
     1124       run fbrglib-have-goods in this-procedure (
     1125             input p-obj-type
     1126           , input p-obj-code
     1127           , input p-node-code
     1128           , output v-have-goods
     1129       ).
     1130       if v-have-goods = yes
     1131       then do:
     1132           find first buf_second_fbr-gds-grp no-lock
     1133                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1134                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1135                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1136                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1137           no-error.
     1138           if available buf_second_fbr-gds-grp
     1139           then do:
     1140               message
     1141                   "В группе есть товары,"
     1142                   skip "которые нельзя перенести в родительскую группу,"
     1143                   skip "потому что у родительской группы есть еще одна подгруппа."
     1144                   skip(1)
     1145                   skip "Перенесите товары в другую группу"
     1146                   skip "или удалите все остальные подгруппы родительской группы."
     1147               view-as alert-box error.
     1148               assign
     1149                   p-deleted = no
     1150               .
     1151               undo, return.
     1152           end.
     1153           message
     1154               "В группе есть товары."
     1155               skip "После удаления группы"
     1156               skip "все ее товары будут привязаны"
     1157               skip "к ее родительской группе."
     1158               skip(1)
     1159               skip "Удалить группу?"
     1160           view-as alert-box warning
     1161           buttons yes-no
     1162           title "Удаление группы"
     1163           update v-yesno
     1164           .
     1165           if v-yesno = yes
     1166           then do:
     1167               do transaction
     1168               on error undo, return error
     1169               :
     1170                   for each buf_fbr-gds-obj exclusive-lock
     1171                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1172                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1173                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1174                   on error undo, return error
     1175                   :
     1176                       assign
     1177                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1178                       .
     1179                   end.
     1180               end.
     1181               do transaction
     1182               on error undo, return error
     1183               :
     1184                   find current buf_fbr-gds-grp exclusive-lock .
     1185                   delete buf_fbr-gds-grp no-error .
     1186                   if error-status:error then do:
     1187                     undo, return error return-value .
     1188                   end.
     1189               end.
     1190           end.
     1191       end.
     1192       else do:
     1193           message
     1194               "Имя группы: " buf_fbr-gds-grp.node-name
     1195               "Код группы: " buf_fbr-gds-grp.node-code
     1196               skip(1)
     1197               skip "Удалить группу?"
     1198           view-as alert-box warning
     1199           buttons yes-no
     1200           title "Удаление группы"
     1201           update v-yesno
     1202           .
     1203           if v-yesno = yes
     1204           then do:
     1205               do transaction
     1206               on error undo, return error
     1207               :
     1208                   find current buf_fbr-gds-grp exclusive-lock .
     1209                   delete buf_fbr-gds-grp no-error.
     1210                   if error-status:error then do:
     1211                     undo, return error return-value .
     1212                   end.
     1213               end.
     1214           end.
     1215       end.
     1216   end.
     1217   end procedure.
     1218   procedure fbrglib-add-grp :
     1219   do
     1220   on error undo, return error
     1221   :
     1222   define input parameter p-obj-type       as character    no-undo.
     1223   define input parameter p-obj-code       as integer      no-undo.
     1224   define input parameter p-node-code      as integer      no-undo.
     1225   define input parameter p-interface      as logical      no-undo.
     1226   define input parameter p-node-name      as character    no-undo.
     1227   define input parameter p-out-code       as integer      no-undo.
     1228   define input parameter p-global-code    as integer      no-undo.
     1229   define output parameter p-new-node-code as integer      no-undo.
     1230   define output parameter p-cancel        as logical      no-undo.
     1231       define variable v-have-goods    as logical  no-undo.
     1232       define variable v-host-code     as integer        no-undo.
     1233       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1234       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1235       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1236       run fbrglib-have-goods in this-procedure (
     1237             input p-obj-type
     1238           , input p-obj-code
     1239           , input p-node-code
     1240           , output v-have-goods
     1241       ) no-error .
     1242       if error-status :error
     1243       then do:
     1244           message
     1245                    vss-workfile vss-revision vss-description
     1246               skip "Ошибка определения наличия товаров в группе."
     1247               skip return-value
     1248               skip trim(error-status :get-message(1))
     1249                    trim(error-status :get-message(2))
     1250                    trim(error-status :get-message(3))
     1251           view-as alert-box error.
     1252           undo, return error .
     1253       end.
     1254   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1255   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1256     (input  p-obj-type
     1257     ,input  p-obj-code
     1258     ,output v-host-code
     1259     )  .
     1260       find first buf_fbr-gds-grp no-lock where
     1261                 buf_fbr-gds-grp.upper-code = p-node-code
     1262             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1263             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1264             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1265       if available buf_fbr-gds-grp then do:
     1266           if p-node-code <> 1 then do:
     1267             find first buf_fbr-gds-grp no-lock where
     1268                       buf_fbr-gds-grp.node-code = p-node-code
     1269                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1270                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1271           end.
     1272                   message
     1273           "Для объекта" p-obj-type p-obj-code
     1274           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1275           view-as alert-box error .
     1276           undo, return error .
     1277       end.
     1278       do transaction
     1279       on error undo, return error
     1280       :
     1281           create buf_fbr-gds-grp.
     1282           assign
     1283               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1284               p-new-node-code             = buf_fbr-gds-grp.node-code
     1285               buf_fbr-gds-grp.upper-code  = p-node-code
     1286               buf_fbr-gds-grp.host-code   = v-host-code
     1287               buf_fbr-gds-grp.obj-type    = p-obj-type
     1288               buf_fbr-gds-grp.obj-code    = p-obj-code
     1289               buf_fbr-gds-grp.node-name    = ""
     1290               buf_fbr-gds-grp.out-code    = 0
     1291           .
     1292           if p-interface then do:
     1293             run ref/fbrggrpd.w (
     1294                   input parparentproc
     1295                 , input 'ИЗМЕНЕНИЕ':U
     1296                 , input p-obj-type
     1297                 , input p-obj-code
     1298                 , input buf_fbr-gds-grp.node-code
     1299                 , input buf_fbr-gds-grp.upper-code
     1300                 , input buf_fbr-gds-grp.node-name
     1301                 , input buf_fbr-gds-grp.out-code
     1302                 , output buf_fbr-gds-grp.node-name
     1303                 , output buf_fbr-gds-grp.out-code
     1304                 , output p-cancel
     1305             ).
     1306             if p-cancel = yes
     1307             then do:
     1308                 delete buf_fbr-gds-grp.
     1309                 undo, return.
     1310             end.
     1311           end.
     1312           else do:
     1313             find first bf_fbr-gds-grp no-lock
     1314                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1315                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1316                   and bf_fbr-gds-grp.out-code   = p-out-code
     1317             no-error.
     1318             assign
     1319             buf_fbr-gds-grp.node-name    = p-node-name
     1320             buf_fbr-gds-grp.global-code  = p-global-code
     1321             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1322             .
     1323           end.
     1324           if v-have-goods = yes
     1325           then do:
     1326               for each buf_fbr-gds-obj exclusive-lock
     1327                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1328                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1329                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1330               on error undo, return error
     1331               :
     1332                   assign
     1333                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1334                   .
     1335               end.
     1336           end.
     1337       end.
     1338   end.
     1339   end procedure.
     1340   do
     1341   on error undo, return error
     1342   :
     1343   FOR EACH gds-list:
     1344     DELETE gds-list.
     1345   END.
     1346   assign
     1347   ii0 = num-entries(p-rid-list)
     1348   .
     1349   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1351     (input  p-curr-obj-type
     1352     ,input  p-curr-obj-code
     1353     ,output v-host-code
     1354     )  .
     1355   _ii:
     1356   DO ii = 1 TO ii0:
     1357   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358      FIND FIRST buf_cd-plu Exclusive-lock WHERE
     1359               RECID(buf_cd-plu) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     1360      IF not AVAILABLE  buf_cd-plu  THEN do:
     1361         run write-log-and-file in p-log-handle (
     1362               input 1
     1363             , input log-file-name
     1364             , input 1
     1365             , input substitute("Не найдена или занята запись товара на кассе R-keeper c recid &1", INTEGER(ENTRY(ii, p-rid-list)))).
     1366         assign
     1367         v-view-log = yes.
     1368         next _ii.
     1369      end.
     1370      if buf_cd-plu.b-code = 0 then do:
     1371         run write-log-and-file in p-log-handle (
     1372               input 1
     1373             , input log-file-name
     1374             , input 1
     1375             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не сопоставлен товар в системе IBS TH"
     1376                                 , buf_cd-plu.plu-code
     1377                                 , buf_cd-plu.key#_one
     1378                                 , buf_cd-plu.charkey_one
     1379                                 , chr(10)
     1380                               )).
     1381         assign
     1382         v-view-log = yes.
     1383         next _ii.
     1384      end.
     1385      find first buf_bar-code no-lock where
     1386               buf_bar-code.b-code =  buf_cd-plu.b-code no-error.
     1387      if not available buf_bar-code then do:
     1388         run write-log-and-file in p-log-handle (
     1389               input 1
     1390             , input log-file-name
     1391             , input 1
     1392             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с бар-кодом &5 в системе IBS TH"
     1393                                 , buf_cd-plu.plu-code
     1394                                 , buf_cd-plu.key#_one
     1395                                 , buf_cd-plu.charkey_one
     1396                                 , chr(10)
     1397                                 , buf_cd-plu.b-code
     1398                               )).
     1399         assign
     1400         v-view-log = yes.
     1401         next _ii.
     1402      end.
     1403      find first buf_goods no-lock where
     1404               buf_goods.gds-code = buf_bar-code.gds-code  no-error no-wait.
     1405      if not available buf_goods and not locked buf_goods then do:
     1406         run write-log-and-file in p-log-handle (
     1407               input 1
     1408             , input log-file-name
     1409             , input 1
     1410             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с кодом &5 для бар-кода &6 в системе IBS TH"
     1411                                 , buf_cd-plu.plu-code
     1412                                 , buf_cd-plu.key#_one
     1413                                 , buf_cd-plu.charkey_one
     1414                                 , chr(10)
     1415                                 , buf_cd-plu.b-code
     1416                                 , buf_bar-code.gds-code
     1417                               )).
     1418         assign
     1419         v-view-log = yes.
     1420         next _ii.
     1421      end.
     1422     find first buf_fbr-gds-obj exclusive-lock where
     1423               buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     1424           AND buf_fbr-gds-obj.obj-type = p-curr-obj-type
     1425           AND buf_fbr-gds-obj.obj-code = p-curr-obj-code no-wait no-error.
     1426     if locked buf_fbr-gds-obj then do:
     1427       run write-log-and-file in p-log-handle (
     1428             input 1
     1429           , input log-file-name
     1430           , input 1
     1431           , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1432                                 " - атрибуты РЕСТОРАН для товара с кодом &5 - запись ЗАНЯТА"
     1433                               , buf_cd-plu.plu-code
     1434                               , buf_cd-plu.key#_one
     1435                               , buf_cd-plu.charkey_one
     1436                               , chr(10)
     1437                               , buf_cd-plu.b-code
     1438                             )).
     1439       assign
     1440       v-view-log = yes.
     1441       next _ii.
     1442     end.
     1443     if available buf_Fbr-gds-obj then do:
     1444       assign
     1445       v-rid = recid(buf_Fbr-gds-obj)
     1446       .
     1447     end.
     1448     find first buf_fbr-gds-grp no-lock where
     1449               buf_fbr-gds-grp.out-code = buf_cd-plu.key#_two
     1450           AND buf_fbr-gds-grp.obj-type = p-curr-obj-type
     1451           AND buf_fbr-gds-grp.obj-code = p-curr-obj-code no-error .
     1452     if not available buf_fbr-gds-grp then do:
     1453       run write-log-and-file in p-log-handle (
     1454             input 1
     1455           , input log-file-name
     1456           , input 1
     1457           , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1458                                 "- не найдена группа блюд для &5&6 с кодом на кассе =&7"
     1459                               , buf_cd-plu.plu-code
     1460                               , buf_cd-plu.key#_one
     1461                               , buf_cd-plu.charkey_one
     1462                               , chr(10)
     1463                               , p-curr-obj-type
     1464                               , p-curr-obj-code
     1465                               , buf_cd-plu.key#_two
     1466                             )).
     1467       assign
     1468       v-view-log = yes.
     1469       next _ii.
     1470     end.
     1471     if not available buf_fbr-gds-obj
     1472     or buf_fbr-gds-obj.fbr-grp-code <> buf_fbr-gds-grp.node-code then do:
     1473       run ref/fgdsobj1.p (
     1474                       input-output    v-rid
     1475                       ,input (if available buf_fbr-gds-obj then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U)
     1476                       ,input yes
     1477                       ,input buf_goods.gds-code
     1478                       ,input p-curr-obj-type
     1479                       ,input p-curr-obj-code
     1480                       ,input buf_fbr-gds-grp.node-code
     1481                       ,input (if available buf_fbr-gds-obj
     1482                             then buf_fbr-gds-obj.fbr-obj-type
     1483                             else "":U)
     1484                       ,input (if available buf_fbr-gds-obj
     1485                               then buf_fbr-gds-obj.fbr-obj-code
     1486                               else 0)
     1487                       ,input yes
     1488                       ,input (if available buf_fbr-gds-obj
     1489                               then buf_fbr-gds-obj.is-menu
     1490                               else no)
     1491                       ,input (if available buf_fbr-gds-obj
     1492                               then buf_fbr-gds-obj.is-modificator
     1493                               else no)
     1494                       ,input (if available buf_fbr-gds-obj
     1495                               then buf_fbr-gds-obj.is-null-price
     1496                               else no)
     1497                       ,input (if available buf_fbr-gds-obj
     1498                               then buf_fbr-gds-obj.is-season
     1499                               else no)
     1500                       ,input (if available buf_fbr-gds-obj
     1501                               then buf_fbr-gds-obj.is-semi-finished
     1502                               else no)
     1503                       ) no-error .
     1504       if error-status:error then do:
     1505         run write-log-and-file in p-log-handle (
     1506               input 1
     1507             , input log-file-name
     1508             , input 1
     1509             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1510                               " - не удалось синхронизировать с товар с кодом &5 по группе:&4&6 &7"
     1511                                 , buf_cd-plu.plu-code
     1512                                 , buf_cd-plu.key#_one
     1513                                 , buf_cd-plu.charkey_one
     1514                                 , chr(10)
     1515                                 , buf_cd-plu.b-code
     1516                                 , error-status:get-message(1)
     1517                                 , return-value
     1518                               )).
     1519         assign
     1520         v-view-log = yes.
     1521         next _ii.
     1522       end.
     1523     end.
     1524     buf_cd-plu.logkey_three = no.
     1525     ii-ok = ii-ok + 1.
     1526     run show-counter in p-log-handle .
     1527     run write-counter in p-log-handle (substitute("Обработано &1 блюд, из них упешно &2"
     1528                                       , ii
     1529                                       , ii-ok
     1530                                       )) no-error.
     1531     run get-stop-state in p-log-handle(output v-stop-state).
     1532     if v-stop-state then do:
     1533       run write-log-and-file in p-log-handle (
     1534             input 1
     1535           , input log-file-name
     1536           , input 1
     1537           , input substitute( "!!!Процесс прерван пользователем"
     1538                             )).
     1539       assign
     1540       v-view-log = yes.
     1541       LEAVE _II.
     1542     end.
     1543   END.
     1544   run write-log-and-file in p-log-handle (
     1545         input 1
     1546       , input log-file-name
     1547       , input 1
     1548       , input substitute( "!!!Из &1 товаров успешно по названию синхронизировано &2"
     1549                           , ii0
     1550                           , ii-ok
     1551                         )).
     1552   end.
