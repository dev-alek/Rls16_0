      176   function get-rkgTH-price returns decimal(input p-obj-type as character
      177                                          , input p-obj-code as integer
      178                                          , input p-b-code as integer
      179                                          , output p-doc-num as character):
      180   define variable v-price-sale as decimal   no-undo init ?.
      181   define variable v-road-tax   as decimal   no-undo .
      182   define variable v-excise     as decimal   no-undo .
      183   define variable v-vat-pc     as decimal   no-undo .
      184   define variable v-slt-pc     as decimal   no-undo .
      185   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
      187     (input  p-obj-type
      188     ,input  p-obj-code
      189     ,input  p-b-code
      190     ,input  0
      191     ,input  0
      192     ,output p-doc-num
      193     ,output v-price-sale
      194     ,output v-road-tax
      195     ,output v-excise
      196     ,output v-vat-pc
      197     ,output v-slt-pc
      198     ) no-error .
      199   if not error-status:error then return v-price-sale.
      200   END FUNCTION.
      201   function get-rkgTH-name returns character(input p-obj-type as character
      202                                             ,input p-obj-code as integer
      203                                             ,input p-b-code as integer
      204                                             , buffer buf_goods for ub.goods):
      205   define variable v-gds-name as character no-undo .
      206   define VARIABLE varresult   as character                no-undo.
      207   define VARIABLE vartype-bc  as character                no-undo.
      208   define VARIABLE varweight   as decimal                  no-undo.
      209   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
      210   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
      211   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
      212   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
      213   DEFINE BUFFER buf_place FOR ub.place.
      214   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
      215   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      216   (
      217    input  parparentproc
      218   ,input  STRING(p-b-code)
      219   ,input  0
      220   ,input  p-obj-type
      221   ,input  p-obj-code
      222   ,input  NO
      223   ,input  YES
      224   ,input  varscales-pref2
      225   ,input  varpgscales-pref2
      226   ,output varresult
      227   ,output vartype-bc
      228   ,output varweight
      229   ,buffer buf_bar-code
      230   ,buffer buf_prod-bc
      231   ,buffer buf_place
      232   ) no-error.
      233   if not available buf_bar-code then
      234   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      235   FIND FIRST buf_goods NO-LOCK WHERE
      236             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
      237   IF NOT AVAILABLE buf_goods THEN DO:
      238     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      239   END.
      240   else do:
      241     assign
      242     v-gds-name = buf_goods.chk-name
      243     .
      244   end.
      245   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
      246     ASSIGN
      247     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
      248   END.
      249   FIND FIRST buf_gds-prt NO-LOCK WHERE
      250             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
      251   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
      252       FIND FIRST buf_gds-prt NO-LOCK WHERE
      253                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
      254   END.
      255   ASSIGN
      256   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
      257   ASSIGN
      258   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
      259   return v-gds-name.
      260   END FUNCTION.
      261   function get-rkgTH-group returns integer(input p-obj-type as character
      262                                           , input p-obj-code  as integer
      263                                           , input p-gds-code as integer
      264                                           , output p-grp-name as character
      265                                           ):
      266   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      267   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      268   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      269           buf_fbr-gds-obj.obj-type = p-obj-type
      270       AND buf_fbr-gds-obj.obj-code = p-obj-code
      271       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      272   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      273     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
      274                                                 input p-obj-type
      275                                                 ,INPUT p-obj-code
      276                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
      277                                                 ,OUTPUT p-grp-name) NO-ERROR.
      278     return buf_fbr-gds-obj.fbr-grp-code.
      279   END.
      280   return ?.
      281   END FUNCTION.
      282   function get-rkgTH-modificator returns logical(input p-obj-type as character
      283                                           , input p-obj-code  as integer
      284                                           , input p-gds-code as integer
      285                                           , output p-is-null-price as logical
      286                                           ):
      287   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      288   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      289           buf_fbr-gds-obj.obj-type = p-obj-type
      290       AND buf_fbr-gds-obj.obj-code = p-obj-code
      291       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      292   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      293     assign
      294     p-is-null-price = buf_fbr-gds-obj.is-null-price
      295     .
      296     return buf_fbr-gds-obj.is-modificator.
      297   END.
      298   assign
      299   p-is-null-price = no.
      300   return no.
      301   END FUNCTION.
      302   function get-rkgTH-group-name returns character(input p-obj-type as character
      303                                                 , input p-obj-code  as integer
      304                                                 , input p-out-code as integer):
      305   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      306   find first buf_fbr-gds-grp no-lock where
      307             buf_fbr-gds-grp.obj-type = p-obj-type
      308         AND buf_fbr-gds-grp.obj-code = p-obj-code
      309         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      310   if not available buf_fbr-gds-grp then return ?.
      311   return buf_fbr-gds-grp.node-name.
      312   END FUNCTION.
      313   function get-rkgTH-parent returns integer(input p-obj-type as character
      314                                             , input p-obj-code  as integer
      315                                             , input p-out-code as integer):
      316   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      317   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
      318   find first buf_fbr-gds-grp no-lock where
      319             buf_fbr-gds-grp.obj-type = p-obj-type
      320         AND buf_fbr-gds-grp.obj-code = p-obj-code
      321         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      322   if not available buf_fbr-gds-grp then return ?.
      323   find first upper_fbr-gds-grp no-lock where
      324             upper_fbr-gds-grp.obj-type = p-obj-type
      325         AND upper_fbr-gds-grp.obj-code = p-obj-code
      326         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
      327   if not available upper_fbr-gds-grp then return ?.
      328   return upper_fbr-gds-grp.out-code.
      329   END FUNCTION.
      330   procedure get-rkep-full-grp-name :
      331   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      332   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
      333   define output parameter p-full-name as character    no-undo.
      334   define variable v-upper-code    as integer  no-undo.
      335   define buffer buf_cd-grp       for ub.cd-grp.
      336   define buffer buf_upper_cd-grp for ub.cd-grp.
      337   do
      338   on error undo, return error
      339   :
      340       if P-grp-code = 0
      341       then do:
      342           assign
      343               p-full-name = ""
      344           .
      345       end.
      346       else do:
      347           find first buf_cd-grp no-lock where
      348                  buf_cd-grp.obj-type = 'маг':U
      349              and buf_cd-grp.obj-code = p-obj-code
      350              and buf_cd-grp.pos-type = 'r-keeper':U
      351              and buf_cd-grp.grp-type = '':U
      352              and buf_cd-grp.grp-code = p-grp-code
      353           no-error.
      354           if not available buf_cd-grp
      355           then do:
      356               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
      357           end.
      358           assign
      359               p-full-name  = ""
      360               v-upper-code = 0
      361           .
      362           do while true
      363           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
      364           :
      365               assign
      366               p-full-name  = buf_cd-grp.grp-name
      367                           + (if p-full-name <> "" then chr(47) else "")
      368                           + p-full-name
      369               v-upper-code = buf_cd-grp.upper-grp-code
      370               .
      371               if buf_cd-grp.grp-code = 0
      372               then do:
      373                   leave.
      374               end.
      375               find first buf_cd-grp no-lock where
      376                         buf_cd-grp.obj-type = 'маг':U
      377                     and buf_cd-grp.obj-code = p-obj-code
      378                     and buf_cd-grp.pos-type = 'r-keeper':U
      379                     and buf_cd-grp.grp-type = '':U
      380                     and buf_cd-grp.grp-code = v-upper-code no-error.
      381               if not available buf_cd-grp
      382               then do:
      383                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
      384                                       + string( v-upper-code )
      385                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
      386               end.
      387           end.
      388           assign
      389               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      390           .
      391       end.
      392   end.
      393   end procedure.
      394   function get-price-id-from-int returns character ( input p-file-num as integer):
      395     return ('price-list':U + chr(32) +  string(p-file-num)).
      396   end function.
      397   define variable vss-include-info4 as character format "X(65)" no-undo
      398   initial "@(#)$Workfile$ $Revision$".
