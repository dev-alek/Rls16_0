    11474            if (      v-i-cli-qnty eq 999999999
    11475                  and v-i-cli eq 2
    11476                  and cash-gds.cli-base-rate eq 1  )
    11477               or (   v-i-cli-qnty eq 999999999
    11478                  and v-i-cli eq 1
    11479                  and cash-gds.cli-base-rate ne 1  )
    11480            then
