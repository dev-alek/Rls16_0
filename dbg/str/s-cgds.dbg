    13585         find first temp-dis-kat-file no-lock where                                                       temp-dis-kat-file.dis-kat = cash-ncr-dis-kat.dis-kat no-error.                   if not available temp-dis-kat-file then                                                create temp-dis-kat-file.                                                              assign                                                                                 temp-dis-kat-file.dis-kat   = cash-ncr-dis-kat.dis-kat                                     .                                                                                      assign                                                                                 temp-dis-kat-file.temp-file = v-temp-kat-file                                          temp-dis-kat-file.send-file = v-kat-file                                               temp-dis-kat-file.to-send   = yes.
    13586       end.
