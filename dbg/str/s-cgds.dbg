    11239           assign
    11240           temp-disc-dec = 0
    11241           temp-disc-reason = 0
    11242           temp-disc-weekday = 0
    11243           temp-disc-time-start = 0
    11244           temp-disc-time-end = 0
    11245           temp-disc-start = 12/31/1989
    11246           temp-disc-end = 12/31/9999
    11247           .
