     6139   procedure fact-order-mpl :
     6140     do
     6141     on error undo, return error return-value
     6142     :
     6143   define input  parameter p-doc-date as date     no-undo .
     6144   define input  parameter p-obj-type as character no-undo .
     6145   define input  parameter p-obj-code as integer   no-undo .
     6146   define output parameter p-fact-order as decimal   no-undo .
     6147   define variable v-fact-date            as date    no-undo .
     6148   define variable v-fact-time            as integer no-undo .
     6149   define variable v-fact-order           as decimal no-undo .
     6150   define variable v-shift-end-fact-order as decimal no-undo .
     6151   define variable v-day-end-fact-order   as decimal no-undo .
     6152   define variable l-shift-on as logical no-undo .
     6153   define variable l-date as date      no-undo .
     6154   define variable l-time as integer   no-undo .
     6155   define variable shift-date as date      no-undo .
     6156   define variable shift-num  as integer   no-undo .
     6157   define variable shift-name as character no-undo .
     6158   define variable max-fact-order as decimal   no-undo .
     6159   define buffer buf_global-state for ub.global-state  .
     6160   find first buf_global-state no-lock no-error .
     6161   if not available buf_global-state then do:
     6162      message
     6163        "Не заданы параметры ценообразования!"
     6164        view-as alert-box error
     6165      .
     6166      return error return-value .
     6167   end.
     6168     run cur-time in this-procedure
     6169     ( output v-fact-date ,
     6170       output v-fact-time  ).
     6171   if p-doc-date = ? then do:
     6172   if buf_global-state.pl-use-sys-date-time  = true then do:
     6173         run factord in this-procedure
     6174           (input  v-fact-date
     6175           ,input  v-fact-time
     6176           ,input  v-fact-time
     6177           ,input  ?
     6178           ,input  ?
     6179           ,input  false
     6180           ,output v-fact-order
     6181           ,output v-shift-end-fact-order
     6182           ,output v-day-end-fact-order
     6183           ) no-error .
     6184         if error-status :error
     6185         or v-fact-order = ?
     6186         or v-fact-order = 0 then do:
     6187           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6188         end.
     6189         p-fact-order = v-fact-order .
     6190   end.
     6191   else do:
     6192   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6194     (input  p-obj-type
     6195     ,input  p-obj-code
     6196     ,input  'shift-on=request'
     6197     ,output l-shift-on
     6198     ) no-error .
     6199         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6200         if p-doc-date <> ? then do:
     6201         end.
     6202          run gbl/factdate.p
     6203          ( input        p-obj-type  ,
     6204            input        p-obj-code  ,
     6205            input-output v-fact-date ,
     6206            input-output v-fact-time ,
     6207            input-output shift-date      ,
     6208            input-output shift-num       ,
     6209            input-output shift-name      ,
     6210            input        yes
     6211            ) no-error .
     6212         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6213         run factord in this-procedure
     6214           (input  v-fact-date
     6215           ,input  v-fact-time
     6216           ,input  v-fact-time
     6217           ,input  shift-date
     6218           ,input  shift-num
     6219           ,input  l-shift-on
     6220           ,output v-fact-order
     6221           ,output v-shift-end-fact-order
     6222           ,output v-day-end-fact-order
     6223           ) no-error .
     6224         if error-status :error
     6225         or v-fact-order = ?
     6226         or v-fact-order = 0 then do:
     6227           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6228         end.
     6229         p-fact-order = v-fact-order .
     6230   end.
     6231   end.
     6232   else do:
     6233          run gbl/factdate.p
     6234          ( input        p-obj-type  ,
     6235            input        p-obj-code  ,
     6236            input-output v-fact-date ,
     6237            input-output v-fact-time ,
     6238            input-output shift-date      ,
     6239            input-output shift-num       ,
     6240            input-output shift-name      ,
     6241            input        yes
     6242            ) no-error .
     6243         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6244         v-fact-date = p-doc-date .
     6245         run factord in this-procedure
     6246           (input  v-fact-date
     6247           ,input  v-fact-time
     6248           ,input  v-fact-time
     6249           ,input  shift-date
     6250           ,input  shift-num
     6251           ,input  l-shift-on
     6252           ,output v-fact-order
     6253           ,output v-shift-end-fact-order
     6254           ,output v-day-end-fact-order
     6255           ) no-error .
     6256         if error-status :error
     6257         or v-fact-order = ?
     6258         or v-fact-order = 0 then do:
     6259           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6260         end.
     6261         p-fact-order = v-fact-order .
     6262   end.
     6263     end.
     6264   end procedure.
