    14194                                       , input yes
    14195                                       , input 0
    14196                                       , input no
    14197                                       , input 12
    14198                                       , input 5000
    14199                                       , input v-plu
    14200                                       , input (if v-marketer-action = "U"
    14201                                                 then  string(cash-gds.b-code, "999999999")
    14202                                                 else "000000000")
    14203                                             ).
    14204         run maria-put in this-procedure (
