    11229           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
    11230           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
    11231                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
    11232                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
    11233                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
    11234                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
    11235                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
    11236                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
    11237           .
