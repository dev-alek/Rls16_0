    12671   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12672   PROCEDURE   for-cash-cycle:
    12673   DEFINE VARIABLE fname-list as character no-undo .
    12674   DEFINE VARIABLE out-list as character no-undo .
