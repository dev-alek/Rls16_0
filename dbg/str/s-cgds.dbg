      407   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      409                                                                     input  orders as integer):
      410   define variable  round-m-sum as decimal no-undo.
      411   if orders >= 0 then
      412   round-m-sum = round(mysum,orders).
      413   else
      414   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      415   return round-m-sum.
      416   END FUNCTION.
      417   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   procedure factord :
      419     define input  parameter p-fact-date            as date    no-undo .
      420     define input  parameter p-fact-time            as integer no-undo .
      421     define input  parameter p-fact-num             as integer no-undo .
      422     define input  parameter p-shift-date           as date    no-undo .
      423     define input  parameter p-shift-num            as integer no-undo .
      424     define input  parameter p-shift-on             as logical no-undo .
      425     define output parameter p-fact-order           as decimal no-undo .
      426     define output parameter p-shift-end-fact-order as decimal no-undo .
      427     define output parameter p-day-end-fact-order   as decimal no-undo .
      428     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      429     if p-fact-date = ?
      430     then do:
      431       return error "Не указана фактическая дата" .
      432     end.
      433     define variable v-fact-date-num as integer no-undo .
      434     assign
      435       v-fact-date-num = integer(p-fact-date)
      436     .
      437     if p-fact-num = ?
      438     or p-fact-num = 0
      439     then do:
      440       return error "Не задан p-fact-num " + string(p-fact-num) .
      441     end.
      442     if p-fact-num < 0
      443     then do:
      444       return error "Отрицательный fact-num " + string(p-fact-num) .
      445     end.
      446     if p-fact-num >= 100000000
      447     then do:
      448       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      449     end.
      450     if p-shift-on = true
      451     then do:
      452       if p-shift-date = ?
      453       then do:
      454         return error "Не задана дата смены" .
      455       end.
      456       if p-shift-num = ?
      457       or p-shift-num = 0
      458       then do:
      459         return error "Не задан номер смены" .
      460       end.
      461     end.
      462     else do:
      463       assign
      464         p-shift-date = p-fact-date
      465         p-shift-num  = 24
      466       .
      467     end.
      468     define variable v-shift-offset as integer no-undo .
      469     if p-shift-date = p-fact-date
      470     then do:
      471       assign
      472         v-shift-offset = 1
      473       .
      474     end.
      475     if p-shift-date < p-fact-date
      476     then do:
      477       assign
      478         v-shift-offset = 0
      479       .
      480     end.
      481     if p-shift-date > p-fact-date
      482     then do:
      483       message
      484         vss-workfile vss-revision vss-description skip
      485         "Неправильная дата закрытия смены" skip
      486         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      487         view-as alert-box error .
      488       undo, return error
      489         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      490           ,string(p-fact-date, '99/99/9999':U)
      491           ,string(p-shift-date, '99/99/9999':U)
      492           )
      493       .
      494     end.
      495     if p-shift-num < 1
      496     or p-shift-num > 24
      497     then do:
      498       message
      499         vss-workfile vss-revision vss-description skip
      500         "Неправильный номер смены" skip
      501         "p-shift-num" p-shift-num skip
      502         view-as alert-box error .
      503       undo, return error return-value .
      504     end.
      505     assign
      506       p-fact-order           = v-fact-date-num
      507                              + v-shift-offset * 0.5
      508                              + p-shift-num    * 0.02 - 0.01
      509                              + p-fact-num     * 0.0000000001
      510       p-shift-end-fact-order = v-fact-date-num
      511                              + v-shift-offset * 0.5
      512                              + p-shift-num    * 0.02
      513       p-day-end-fact-order   = v-fact-date-num
      514                              + 0.99
      515     .
      516     if p-fact-order           <= v-fact-date-num
      517     or p-shift-end-fact-order <= v-fact-date-num
      518     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      519     or p-shift-end-fact-order >= p-day-end-fact-order
      520     then do:
      521       message
      522         vss-workfile vss-revision vss-description skip
      523         "Внутренняя ошибка при генерации фактического номера" skip
      524         "p-fact-date"            p-fact-date            skip
      525         "p-fact-time"            p-fact-time            skip
      526         "p-fact-num"             p-fact-num             skip
      527         "p-shift-date"           p-shift-date           skip
      528         "p-shift-num"            p-shift-num            skip
      529         "p-shift-on"             p-shift-on             skip
      530         "p-shift-end-fact-order" p-shift-end-fact-order skip
      531         "p-day-end-fact-order"   p-day-end-fact-order   skip
      532         "v-fact-date-num"        v-fact-date-num        skip
      533         view-as alert-box error .
      534       undo, return error return-value .
      535     end.
      536   end procedure.
      537   procedure day-begin-fact-order :
      538     define input  parameter p-fact-date            as date    no-undo .
      539     define output parameter p-day-begin-fact-order as decimal no-undo .
      540     do
      541     on error undo, return error return-value
      542     :
      543       if p-fact-date = ?
      544       then do:
      545         assign
      546           p-day-begin-fact-order = 0
      547         .
      548       end.
      549       else do:
      550         assign
      551           p-day-begin-fact-order = integer(p-fact-date)
      552         .
      553       end.
      554     end.
      555   end procedure.
      556   procedure factord-max-fact-order :
      557     define output parameter p-max-fact-order as decimal   no-undo .
      558     do
      559     on error undo, return error return-value
      560     :
      561       run day-begin-fact-order in this-procedure
      562         (input  date(1, 1, 5000)
      563         ,output p-max-fact-order
      564         ) .
      565     end.
      566   end procedure.
      567   procedure factord-cut-archive :
      568     define input  parameter p-obj-type             as character no-undo .
      569     define input  parameter p-obj-code             as integer   no-undo .
      570     define input  parameter p-fact-date            as date      no-undo .
      571     define output parameter p-shift-on             as logical   no-undo .
      572     define output parameter p-shift-date           as date      no-undo .
      573     define output parameter p-shift-num            as integer   no-undo .
      574     define output parameter p-day-end-fact-order   as decimal   no-undo .
      575     define output parameter p-shift-end-fact-order as decimal   no-undo .
      576     define variable v-fact-order as decimal   no-undo .
      577     define buffer buf_shift-obj for ub.shift-obj .
      578     do
      579     on error undo, return error return-value
      580     :
      581   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      583     (input  p-obj-type
      584     ,input  p-obj-code
      585     ,input  'shift-on=request'
      586     ,output p-shift-on
      587     ) no-error .
      588       if error-status :error
      589       then do:
      590         message
      591           vss-workfile vss-revision vss-description skip
      592           "Ошибка при определении атрибута объекта" skip
      593           "Объект" p-obj-type p-obj-code skip
      594           error-status :get-message(1) skip
      595           return-value skip
      596           view-as alert-box error .
      597         undo, return error return-value .
      598       end.
      599       if p-shift-on = false
      600       then do:
      601         assign
      602           p-shift-date               = ?
      603           p-shift-num                = 0
      604         .
      605       end.
      606       else do:
      607         find first buf_shift-obj share-lock
      608           where buf_shift-obj.obj-type   = p-obj-type
      609             and buf_shift-obj.obj-code   = p-obj-code
      610             and buf_shift-obj.shift-date > p-fact-date
      611           use-index pi
      612           no-error .
      613         if not available buf_shift-obj
      614         or buf_shift-obj.status_ <> 'зкр':U
      615         then do:
      616           message
      617             vss-workfile vss-revision vss-description skip
      618             "Невозможно вычислить последнюю смену" skip
      619             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      620             "Объект" p-obj-type p-obj-code skip
      621             "Дата" p-fact-date skip
      622             view-as alert-box error .
      623           undo, return error return-value .
      624         end.
      625         find last buf_shift-obj share-lock
      626           where buf_shift-obj.obj-type = p-obj-type
      627             and buf_shift-obj.obj-code = p-obj-code
      628             and buf_shift-obj.shift-date <= p-fact-date
      629           use-index pi
      630           no-error .
      631         if available buf_shift-obj
      632         then do:
      633           if  buf_shift-obj.status_ = 'зкр':U
      634           then do:
      635             assign
      636               p-shift-date = buf_shift-obj.shift-date
      637               p-shift-num  = buf_shift-obj.shift-num
      638             .
      639           end.
      640           else do:
      641             message
      642               vss-workfile vss-revision vss-description skip
      643               "Невозможно вычислить последнюю смену" skip
      644               "Статус смены отличен от статуса" 'зкр':U skip
      645               "Объект" p-obj-type p-obj-code skip
      646               "Дата" p-fact-date skip
      647               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      648               view-as alert-box error .
      649             undo, return error return-value .
      650           end.
      651         end.
      652         else do:
      653           assign
      654             p-shift-date = p-fact-date - 1
      655             p-shift-num  = 1
      656           .
      657         end.
      658       end.
      659       run factord in this-procedure
      660         (input  p-fact-date
      661         ,input  1
      662         ,input  1
      663         ,input  p-shift-date
      664         ,input  p-shift-num
      665         ,input  p-shift-on
      666         ,output v-fact-order
      667         ,output p-shift-end-fact-order
      668         ,output p-day-end-fact-order
      669         ) no-error .
      670       if error-status :error
      671       then do:
      672         message
      673           vss-workfile vss-revision vss-description skip
      674           "Ошибка при вызове процедуры factord"
      675           error-status :get-message(1) skip
      676           return-value skip
      677           view-as alert-box error .
      678         undo, return error return-value .
      679       end.
      680     end.
      681   end procedure.
      682   procedure factord-lock-shift :
      683     define input  parameter p-obj-type  as character no-undo .
      684     define input  parameter p-obj-code  as integer   no-undo .
      685     define input  parameter p-fact-date as date      no-undo .
      686     define parameter buffer buf_shift-obj for ub.shift-obj .
      687     define variable v-shift-on      as logical   no-undo .
      688     define variable v-extra-message as character no-undo .
      689     define variable v-error as character no-undo .
      690     do
      691     on error undo, return error return-value
      692     :
      693   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      695     (input  p-obj-type
      696     ,input  p-obj-code
      697     ,input  'shift-on=request'
      698     ,output v-shift-on
      699     ) no-error .
      700       if error-status :error
      701       then do:
      702         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      703         undo, return error v-error .
      704       end.
      705       if v-shift-on = true
      706       then do:
      707         find first buf_shift-obj share-lock
      708           where buf_shift-obj.obj-type   = p-obj-type
      709             and buf_shift-obj.obj-code   = p-obj-code
      710             and buf_shift-obj.shift-date > p-fact-date
      711           use-index pi
      712           no-error .
      713         if not available buf_shift-obj
      714         or buf_shift-obj.status_ <> 'зкр':U
      715         then do:
      716           find last buf_shift-obj
      717             where buf_shift-obj.obj-type = p-obj-type
      718               and buf_shift-obj.obj-code = p-obj-code
      719               and buf_shift-obj.status_  = 'зкр':U
      720             use-index stts
      721             no-error .
      722           if available buf_shift-obj
      723           then do:
      724             assign
      725               v-extra-message =
      726                     substitute("Дата начала последеней закрытой смены на объекте &1"
      727                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      728                               )
      729             .
      730           end.
      731           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      732           undo, return error v-error .
      733         end.
      734       end.
      735     end.
      736   end procedure.
      737   procedure factord-end-day :
      738     define input  parameter p-fact-date            as date    no-undo .
      739     define output parameter p-day-end-fact-order   as decimal no-undo .
      740     do
      741     on error undo, return error return-value
      742     :
      743       if p-fact-date = ?
      744       then do:
      745         return error "Не указана фактическая дата" .
      746       end.
      747       assign
      748         p-day-end-fact-order = integer(p-fact-date) + 0.99
      749       .
      750     end.
      751   end procedure.
      752   procedure factord-to-date :
      753     define input  parameter p-fact-order as decimal no-undo .
      754     define output parameter p-fact-date  as date    no-undo .
      755     define variable v-ref-date  as date      no-undo .
      756     define variable v-ref-delta as integer   no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760       if p-fact-order = ?
      761       or p-fact-order = 0
      762       then do:
      763         return error "Не указан fact-order" .
      764       end.
      765       assign
      766         v-ref-date  = date(1, 1, 2000)
      767       .
      768       assign
      769         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      770       .
      771       assign
      772         p-fact-date = v-ref-date + v-ref-delta
      773       .
      774     end.
      775   end procedure.
      776   procedure factord-to-fact-num :
      777     define input  parameter p-fact-order as decimal no-undo .
      778     define output parameter p-fact-num   as integer no-undo .
      779     define variable v-fact-order-trunc as decimal no-undo .
      780     do
      781     on error undo, return error return-value
      782     :
      783       if p-fact-order = ?
      784       or p-fact-order = 0
      785       then do:
      786         return error "Не указан fact-order" .
      787       end.
      788       assign
      789        v-fact-order-trunc = truncate(p-fact-order, 2)
      790       .
      791       assign
      792         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      793       .
      794     end.
      795   end procedure.
      796   procedure factord-to-shift-num :
      797     define input  parameter p-fact-order as decimal no-undo .
      798     define output parameter p-shift-num   as integer no-undo .
      799     define variable  p-shift-numd  as decimal   no-undo .
      800     define variable v-fact-order-trunc as decimal no-undo .
      801     do
      802     on error undo, return error return-value
      803     :
      804       if p-fact-order = ?
      805       or p-fact-order = 0
      806       then do:
      807         return error "Не указан fact-order" .
      808       end.
      809       assign
      810        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      811       .
      812       if v-fact-order-trunc < 0.5 then do:
      813         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      814       end.
      815       assign
      816         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      817         .
      818        assign
      819         p-shift-num = truncate (p-shift-numd , 0)
      820       .
      821     end.
      822   end procedure.
      823   define new global shared variable g#lib-trn  as handle no-undo .
      824   define new global shared variable g#lib-trn2 as handle no-undo .
      825   define new global shared variable g#lib-trn3 as handle no-undo .
      826   define new global shared variable g#lib-trn4 as handle no-undo .
      827   define temp-table  tt-tax no-undo
      828     field tax-code    like ub.tax.tax-code
      829     field individual  like ub.tax.individual
      830     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      831     field rate-code   like ub.tax-rate.rate-code
      832     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      833     field tax-type    like ub.tax.tax-type
      834     field rate-value  like ub.tax-rate-value.rate-value
      835     field tax-rate-gds-rc  as recid
      836     field to-cashdesk like ub.tax.to-cashdesk
      837     index tax-code is unique primary tax-code
      838     .
      839   procedure tax-val :
      840     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      841     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      842     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      843     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      844     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      845     define input  parameter       parunits-type like ub.units.type         no-undo.
      846     define input  parameter       parrec-id     as recid                   no-undo.
      847     define input  parameter       paris-log     as logical                 no-undo.
      848     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      849     define input  parameter       vattaxcdvalue as integer                 no-undo.
      850     define input  parameter       exctaxcdvalue as integer                 no-undo.
      851     define input  parameter       only-check    as logical                 no-undo.
      852     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      853     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      854     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      855     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      856     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      857     define output parameter       parerr-mes    as character               no-undo.
      858     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      859     do
      860     on error undo, return error return-value
      861     :
      862   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      864   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      865   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      866   define variable gp-excise     like ub.price-list.excise     no-undo.
      867   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      868   define variable gp-fact-order as decimal   no-undo .
      869   define variable gp-price-sale-parts as decimal   no-undo .
      870       define buffer buf_tax          for ub.tax .
      871       define buffer buf_tax-rate     for ub.tax-rate .
      872       define buffer buf_tax-units    for ub.tax-units .
      873       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      874       define buffer buf_goods        for ub.goods .
      875       define buffer buf_bar-code     for ub.bar-code .
      876       define buffer buf_prod-bc      for ub.prod-bc .
      877       define buffer buf_units        for ub.units .
      878       define buffer buf_shop         for ub.shop .
      879       define buffer buf_store        for ub.store .
      880       define buffer buf_gds-prt      for ub.gds-prt .
      881       define buffer buf_tt-tax       for tt-tax .
      882       define variable varrate-value    as decimal   initial ? no-undo.
      883       define variable pr-list-recid    as recid     initial ? no-undo.
      884       define variable varmes           as character no-undo.
      885       define variable varfactorrtvalue as char      initial ? no-undo.
      886       define variable varfactorrttype  as char      initial ? no-undo.
      887       define variable is-petrolium     as logical no-undo.
      888       define variable is-pieces        as logical no-undo.
      889       define variable vargds-code      like ub.goods.gds-code no-undo.
      890       define variable pargds-code      like ub.goods.gds-code no-undo.
      891       define variable var-fact-order   as decimal no-undo .
      892       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      893       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      894       define variable currate-gds-rc   as recid no-undo .
      895       define variable v-today          as date no-undo .
      896       define variable v-time           as integer no-undo .
      897       for each buf_tt-tax:
      898         delete buf_tt-tax.
      899       end.
      900       run cur-time in this-procedure(output v-today, output v-time).
      901       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      902       if parartic     = ?
      903       or parprod-type = ?
      904       or parprod-code = ?
      905       or parunit-base = ?
      906       then do:
      907         find first buf_goods no-lock
      908           where recid(buf_goods) = parrec-id
      909           no-error .
      910       end.
      911       else do:
      912         find first buf_goods no-lock
      913           where buf_goods.artic = parartic
      914             and buf_goods.prod-type = parprod-type
      915             and buf_goods.prod-code = parprod-code
      916           no-error .
      917       end.
      918       if not available buf_goods then do:
      919         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      920         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      921       end.
      922       assign
      923         parartic     = buf_goods.artic
      924         parprod-type = buf_goods.prod-type
      925         parprod-code = buf_goods.prod-code
      926         parunit-base = buf_goods.unit-base
      927         pargds-code  = buf_goods.gds-code
      928       .
      929       if parunits-type = ?
      930       then do:
      931         find buf_units no-lock
      932           where buf_units.unit-name = parunit-base
      933           no-error .
      934         if not available buf_units then do:
      935           assign
      936             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      937           .
      938           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      939         end.
      940         assign
      941           parunits-type = buf_units.type
      942         .
      943       end.
      944       if parhost-code = ?
      945       or parhost-code = 0
      946       then do:
      947   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      949     (input  parobj-type
      950     ,input  abs(parobj-code)
      951     ,output parhost-code
      952     ) no-error .
      953         if error-status :error then do:
      954           assign
      955             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      956               ,string(parobj-type)
      957               ,string(parobj-code)
      958               ) + chr(10)
      959           .
      960           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      961         end.
      962       end.
      963       assign
      964         vargds-code = buf_goods.gds-code
      965       .
      966       for each buf_tax-units no-lock
      967         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      968       ,first buf_tax no-lock
      969         where buf_tax.tax-code = buf_tax-units.tax-code
      970       :
      971         find first buf_tt-tax where
      972                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      973         if not available buf_tt-tax then do:
      974           create buf_tt-tax .
      975         end.
      976         assign
      977           buf_tt-tax.tax-code = buf_tax.tax-code
      978         .
      979         if buf_tax.individual = false then do:
      980           assign
      981             currate-gds-rc = ?
      982           .
      983           _tax-rate-gds:
      984           for each buf_tax-rate-gds no-lock where
      985                   buf_tax-rate-gds.gds-code = pargds-code and
      986                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      987           first buf_tax-rate where
      988                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      989                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      990           by buf_tax-rate-gds.host-code
      991           by buf_tax-rate-gds.obj-type
      992           by buf_tax-rate-gds.obj-code
      993           by buf_tax-rate-gds.fact-order
      994           :
      995             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      996               next _tax-rate-gds.
      997             end.
      998             if buf_tax-rate-gds.host-code = 0 or
      999               ((buf_tax-rate-gds.host-code = parhost-code) or
     1000               (buf_tax-rate-gds.obj-type = parobj-type AND
     1001               buf_tax-rate-gds.obj-code = parobj-code))
     1002             then do:
     1003               assign
     1004               currate-code = buf_tax-rate.rate-code
     1005               currate-name = buf_tax-rate.rate-name
