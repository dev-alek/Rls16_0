     7689     if loc-bar-code.stts = Integer('79':U) then return.
     7690       for-price = ?.
     7691   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7693     (input  'маг':U
     7694     ,input  ub.shop.obj-code
     7695     ,input  loc-bar-code.b-code
     7696     ,input  main-b-code
     7697     ,input  0
     7698     ,output v-doc-num
     7699     ,output for-price
     7700     ,output for-road
     7701     ,output for-excise
     7702     ) no-error .
     7703       if error-status:error then do:
     7704           if g#news
     7705           or g#auto
     7706           or g#esys
     7707           then return error.
     7708           else do:
     7709               error-status:error = no.
     7710               message "Ошибка при определении цены на товар "
     7711                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7712               view-as alert-box ERROR.
     7713               return.
     7714           end.
     7715       end.
     7716       if return-value = "error" then do:
     7717           if for-price = ? then do:
     7718             return.
     7719           end.
     7720           if not g#news
     7721           and not g#auto
     7722           and not g#esys
     7723           then
     7724           message prichina view-as alert-box ERROR.
     7725           return error.
     7726       end.
     7727       else if (for-price = ? or for-price = 0) then do:
     7728         if v-is-restaurant and v-is-null-price  then do:
     7729           assign
     7730           for-price = 0.
     7731         end.
     7732         else do:
     7733           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7734                                                  ,input 'null-price':U
     7735                                                  ,output v-gds-null-price
     7736                                                  ,output v-type) no-error.
     7737           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7738           return "NEXT".
     7739         end.
     7740       end.
     7741     end.
     7742     else do:
     7743           for-price = 0.
     7744     end.
     7745   for-price = round-m( for-price , rnd-znak ).
     7746   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7747   start-paket = no.
     7748   if not avail cash-gds then do:
     7749   create cash-gds.
     7750   error-status:error = false.
     7751   end.
     7752   cash-gds.crf = cr + 1.
     7753   cr = cr + 1.
     7754   if loc-bar-code.in-code <> ''
     7755   or loc-bar-code.part-code <> ''
     7756   then do:
     7757     find first main-prt-bar-code no-lock where
     7758               main-prt-bar-code.gds-code = loc-goods.gds-code
     7759           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7760           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7761           and main-prt-bar-code.part-code = ''
     7762           and main-prt-bar-code.in-code = '' no-error.
     7763     if available main-prt-bar-code then do:
     7764       v-main-prt-b-code = main-prt-bar-code.b-code.
     7765     end.
     7766   end.
     7767   else do:
     7768     v-main-prt-b-code = loc-bar-code.b-code.
     7769   end.
     7770   find first tt-tax no-lock where
     7771              tt-tax.tax-code = vattaxcd no-error .
     7772   do iii = 1 to num-entries(mask_s-c) :
     7773     assign
     7774       v-mask-full  = trim(entry(iii, mask_s-c))
     7775       v-mask-short = entry(1, v-mask-full, "*")
     7776       loc-prod-bc  = trim(loc-prod-bc)
     7777     .
     7778     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7779       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7780   end.
     7781   define variable vBc-on as logical no-undo.
     7782   if loc-prod-bc ne ?
     7783   then do:
     7784       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7785                            and prod-bc.b-str  eq loc-prod-bc
     7786                            no-lock no-error.
     7787       if available prod-bc
     7788       then
     7789          vBc-on = prod-bc.bc-on.
     7790       else
     7791          vBc-on = yes.
     7792   end.
     7793   else
     7794      vBc-on = yes.
     7795   run gdsoattr-value in this-procedure (
     7796     'dt-seasons':U,
     7797     loc-goods.gds-code,
     7798     parobj-type,
     7799     parobj-code,
     7800     output attrValue,
     7801     output attrType
     7802   ) no-error.
     7803   if attrValue <> "" then do:
     7804     find first b-code where
     7805                b-code.parent = "DTSeasons"
     7806            and b-code.code   = attrValue
     7807          no-lock no-error.
     7808     v-main-prt-b-code = integer(b-code.code).
     7809   end.
     7810   else release b-code.
     7811   assign
     7812   cash-gds.gds-code = loc-goods.gds-code
     7813   cash-gds.artic = loc-goods.artic
     7814   cash-gds.b-code = loc-bar-code.b-code
     7815   cash-gds.main-prt-b-code = v-main-prt-b-code
     7816   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7817   cash-gds.bc-on-type = loc-bc-on-type
     7818   cash-gds.bc-on = vBc-on
     7819   cash-gds.unit-cli = loc-bar-code.unit-cli
     7820   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7821   cash-gds.std-discnt-rule = std-discnt-rule_
     7822   cash-gds.gds-namelong = loc-goods.gds-name
     7823   cash-gds.gds-name = IF nam-2str
     7824                       then if available b-code then b-code.codename else loc-goods.gds-name
     7825                       else (
     7826                             IF nam-artc
     7827                             then loc-goods.artic
     7828                             else if available b-code
     7829                                  then b-code.codename
     7830                                  else (if loc-goods.chk-name <> ""
     7831                                        then loc-goods.chk-name
     7832                                        else loc-goods.gds-name)
     7833                            )
     7834   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7835   cash-gds.unit-base = loc-goods.unit-base
     7836   cash-gds.grp-code = for-grp-code
     7837   cash-gds.fp = for-fp
     7838   cash-gds.ingredient = loc-goods.struct
     7839   cash-gds.producer = for-producer
     7840   cash-gds.producer-int = for-producer-int
     7841   cash-gds.alpha1     = loc-goods.alpha1.
     7842     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7843                                            ,input 'office-type':U
     7844                                            ,output v-oss
     7845                                            ,output v-type) no-error.
     7846   cash-gds.office-type = v-oss.
     7847     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7848                                            ,input 'type-method-calc':U
     7849                                            ,output v-oss
     7850                                            ,output v-type) no-error.
     7851   if v-oss <> "" then
     7852     assign
     7853       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7854       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7855     .
     7856   else
     7857     assign
     7858       cash-gds.CalculationMethod = 0
     7859       cash-gds.CalculationMethodRestr = 0
     7860     .
     7861   assign
     7862   cash-gds.fact-qnty = for-fact-qnty
     7863   cash-gds.okei = loc-bc-units-okei
     7864   cash-gds.kat-discnt-method = kat-discnt-method_
     7865   cash-gds.temp-discnt-method = temp-discnt-method_
     7866   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7867                                then  kat-discnt-rule_pdf
     7868                                else  kat-discnt-rule_)
     7869   cash-gds.date-discnt-rule = date-discnt-rule_
     7870   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7871   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7872   cash-gds.wgd-rule = for-wgd
     7873   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7874                           then 1
     7875                           else 0)
     7876   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7877                        or for-petrol-purse
     7878                        then (cash-gds.gds-stat + 8)
     7879                        else cash-gds.gds-stat)
     7880   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7881                       then (cash-gds.gds-stat + 16)
     7882                       else cash-gds.gds-stat
     7883   cash-gds.gds-stat = if cash-gds.fp
     7884                       then (cash-gds.gds-stat + 2)
     7885                       else cash-gds.gds-stat
     7886   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7887                       then (cash-gds.gds-stat + 128)
     7888                       else cash-gds.gds-stat
     7889   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7890   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7891                                then temp-discnt-rule_pdf
     7892                                else temp-discnt-rule_)
     7893   cash-gds.wd-rule = for-wd
     7894   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7895   cash-gds.need-auth = (if need-auth then 1 else 0)
     7896   cash-gds.price-sale =  for-price
     7897   cash-gds.unit-type = loc-units.type
     7898   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7899   cash-gds.tax-string = tax-string
     7900   cash-gds.new-good = new-good
     7901   cash-gds.rc = recid(loc-goods)
     7902   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7903   cash-gds.vat-pc = (if avail tt-tax
     7904                      then tt-tax.rate-value
     7905                      else 0)
     7906   cash-gds.vat-code = (if avail tt-tax
     7907                        then tt-tax.rate-code
     7908                        else ?)
     7909   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7910   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7911   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7912   cash-gds.fbr-grp-code = v-fbr-grp-code
     7913   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7914   cash-gds.DepartID = v-fbr-obj-code
     7915   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7916   cash-gds.node-code = loc-bar-code.node-code
     7917   cash-gds.taracode = for-taracode
     7918   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7919                            and loc-bar-code.in-code = ""
     7920                            and loc-bar-code.part-code = ""
     7921                            and cash-gds.unit-base = cash-gds.unit-cli
     7922                            then yes
     7923                            else no)
     7924   cash-gds.obj-type = parobj-type
     7925   cash-gds.obj-code = parobj-code
     7926   .
     7927   assign
     7928   cash-gds.gds-name1 =   name-2cdf(
     7929                         input name-2cd
     7930                       , input yes
     7931                       , input cod-pcod
     7932                       , input cash-gds.b-code
     7933                       , input loc-goods.gds-code
     7934                       , input loc-goods.artic
     7935                       , input loc-goods.engl-name
     7936                       , input loc-bar-code.in-code
     7937                       , input loc-bar-code.part-code
     7938                       , input parobj-type
     7939                       , input parobj-code
     7940                       , input loc-goods.alpha1
     7941                       , output v-gtd
     7942                       )
     7943   cash-gds.gtd   = v-gtd
     7944   .
     7945   vKKT = 255.
     7946   find first b-code where
     7947              b-code.parent  = "okei-kkt"
     7948          and b-code.code    = string(cash-gds.okei)
     7949          and b-code.status_ = 0
     7950   no-lock no-error.
     7951   if avail b-code then
     7952      vKKT = integer(b-code.CodeName) no-error.
     7953   if error-status:error then vKKT = 255.
     7954   cash-gds.kkt = vKKT.
     7955   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7956      run gds-attr-value in this-procedure  (
     7957                                             input cash-gds.gds-code
     7958                                            ,input 'fuel-type':U
     7959                                            ,output v-is-gas
     7960                                            ,output v-type) no-error.
     7961      run gds-attr-value in this-procedure  (
     7962                                             input cash-gds.gds-code
     7963                                            ,input 'ptrl-as-good':U
     7964                                            ,output v-ptrl-as-good
     7965                                            ,output v-type) no-error.
     7966      assign
     7967      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7968      no-error .
     7969      assign
     7970      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7971      no-error .
     7972      if cash-gds.is-gas then do:
     7973        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7974      end.
     7975   end.
     7976      run gds-attr-value in this-procedure  (
     7977                                             input cash-gds.gds-code
     7978                                            ,input 'ban-bonus':U
     7979                                            ,output v-ban-bonus
     7980                                            ,output v-type) no-error.
     7981     assign
     7982      cash-gds.wd = int(logical(v-ban-bonus))
     7983      no-error .
     7984   if how-temp-disc = 'temp-disc':U then do:
     7985     case temp-discnt-method_:
     7986       when "" then do:
     7987       end.
     7988       when "bar-code.b-code" then do:
     7989         if loc-bar-code.in-code <> ''
     7990         or loc-bar-code.part-code <> ''
     7991         then do:
     7992           disc-b-code = cash-gds.main-prt-b-code.
     7993         end.
     7994         else do:
     7995           disc-b-code = cash-gds.b-code.
     7996         end.
     7997         find first buf_temp-dis-gds-rule where
     7998                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7999             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     8000         if available buf_temp-dis-gds-rule then do:
     8001             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     8002         end.
     8003       end.
     8004       otherwise do:
     8005         cash-gds.temp-discnt-rule = 0.
     8006       end.
     8007     end.
     8008   end.
     8009   assign
     8010   cash-gds.gds-name1 =   name-2cdf(
     8011                         input name-2cd
     8012                       , input yes
     8013                       , input cod-pcod
     8014                       , input cash-gds.b-code
