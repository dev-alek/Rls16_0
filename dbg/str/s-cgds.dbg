     7262   def var vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7263   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7264   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7265   procedure create-dis-rule :
     7266   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7267   define input parameter p-tree as logical no-undo .
     7268   define buffer buf_dis-rule for ub.dis-rule.
     7269   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7270   define buffer term_dis-rule for ub.dis-rule.
     7271   define buffer term_dis-time-rule for ub.dis-time-rule.
     7272   define buffer root_cash-dis-rule for cash-dis-rule.
     7273   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7274   define buffer term_cash-dis-rule for cash-dis-rule.
     7275   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7276     do
     7277     on error undo, return error
     7278     :
     7279       find first root_cash-dis-rule no-lock where                                                         ~
     7280                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7281       if not available root_cash-dis-rule then do:
     7282         find first buf_dis-rule no-lock where
     7283                   buf_dis-rule.rule-num = p-rule-num no-error.
     7284         if available buf_dis-rule then do:
     7285           if buf_dis-rule.time-rule-num <> 0 then do:
     7286             find first buf_dis-time-rule no-lock where
     7287                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7288           end.
     7289           create root_cash-dis-rule.
     7290           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7291           if available buf_dis-time-rule then do:
     7292             find first root_cash-dis-time-rule no-lock where
     7293                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7294             if not available root_cash-dis-time-rule then do:
     7295               create root_cash-dis-time-rule.
     7296               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7297             end.
     7298           end.
     7299           else do:
     7300             assign
     7301             root_cash-dis-rule.time-rule-num = 0.
     7302           end.
     7303           if buf_dis-rule.uniq-field <> "":U then do:
     7304             for each term_dis-rule no-lock where
     7305                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7306               if term_dis-rule.time-rule-num <> 0 then do:
     7307                 find first term_dis-time-rule no-lock where
     7308                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7309               end.
     7310               create term_cash-dis-rule.
     7311               buffer-copy term_dis-rule to term_cash-dis-rule.
     7312               if term_dis-rule.time-rule-num = 0
     7313               or available term_dis-time-rule
     7314               or root_cash-dis-rule.time-rule-num = 0
     7315               then do:
     7316                 if available term_dis-time-rule then do:
     7317                   find first term_cash-dis-time-rule no-lock where
     7318                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7319                   if not available term_cash-dis-time-rule then do:
     7320                     create term_cash-dis-time-rule.
     7321                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7322                   end.
     7323                 end.
     7324               end.
     7325             end.
     7326           end.
     7327         end.
     7328       end.
     7329     end.
     7330   end procedure.
     7331   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7332   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7333   function ncr-amnt-disc returns character (
     7334     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7335   define variable v-result as character no-undo .
     7336   define variable ii as integer no-undo .
     7337   define variable v-entry as character no-undo extent 3.
     7338   for each cash-dis-rule  no-lock where
     7339         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7340     assign
     7341     ii = ii + 1
     7342     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7343                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7344     .
     7345   end.
     7346   if v-entry[2] = "":U then
     7347   assign
     7348   v-entry[2] = v-entry[1]
     7349   .
     7350   if v-entry[3] = "":U then
     7351   assign
     7352   v-entry[3] = v-entry[2]
     7353   .
     7354   assign
     7355   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7356   .
     7357   return v-result.
     7358   END FUNCTION.
     7359   function ncr-date-disc returns character (
     7360     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7361   define variable v-result as character no-undo .
     7362   define variable ii as integer no-undo .
     7363   define variable v-entry as character no-undo extent 3.
     7364   for each cash-dis-rule  no-lock where
     7365         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7366       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7367     assign
     7368     ii = ii + 1
     7369     v-entry[ii] =
     7370                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7371                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7372                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7373                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7374                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7375                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7376                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7377   end.
     7378   if v-entry[2] = "":U then
     7379   assign
     7380   v-entry[2] = v-entry[1]
     7381   .
     7382   if v-entry[3] = "":U then
     7383   assign
     7384   v-entry[3] = v-entry[2]
     7385   .
     7386   assign
     7387   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7388   .
     7389   return v-result.
     7390   END FUNCTION.
     7391   function ncr-temp-disc returns character (
     7392     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7393   define variable v-result as character no-undo .
     7394   define variable ii as integer no-undo .
     7395   define variable v-entry as character no-undo extent 3.
     7396   define variable v-dec as decimal no-undo .
     7397   define variable v-disc-price-sale as decimal no-undo .
     7398   define variable v-pdf-id as integer no-undo .
     7399   define variable v-pdf-db-num as integer no-undo .
     7400   define buffer buf_cash-dis-rule for cash-dis-rule.
     7401   find first buf_cash-dis-rule where
     7402            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7403   if not available buf_cash-dis-rule then return "":U.
     7404   if buf_cash-dis-rule.templ-rl-root <> 29
     7405   and buf_cash-dis-rule.templ-rl-root <> 86
     7406   then do:
     7407     assign
     7408     v-entry[1] =
     7409     "000"                                                   +
     7410     "0"                                                     +
     7411     "0000"                                                  +
     7412     "2359"                                                     +
     7413      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7414      .
     7415   end.
     7416   else do:
     7417     for each cash-dis-rule  no-lock where
     7418           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7419         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7420       case cash-dis-rule.value-type:
     7421         when integer('1':U) then do:
     7422           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7423         end.
     7424         when integer('12':U) then do:
     7425           find first cash-gds-discnt where
     7426                     cash-gds-discnt.b-code = cash-gds.b-code
     7427                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7428                 and cash-gds-discnt.obj-type = 'маг':U
     7429                 and cash-gds-discnt.obj-code = i-obj-code
     7430                 no-error.
     7431           if not available cash-gds-discnt then do:
     7432             v-dec = cash-gds.price-sale.
     7433           end.
     7434           else do:
     7435             assign
     7436             v-dec = cash-gds-discnt.discnt-value
     7437             .
     7438           end.
     7439         end.
     7440         otherwise do:
     7441           v-dec = cash-gds.price-sale.
     7442         end.
     7443       end case.
     7444       assign
     7445       ii = ii + 1
     7446       v-entry[ii] =
     7447                     "000"                                                   +
     7448                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7449                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7450                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7451                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7452                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7453                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7454                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7455                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7456                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7457                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7458                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7459       .
     7460   if ii = 3 then leave.
     7461     end.
     7462   end.
     7463   if v-entry[2] = "":U then
     7464   assign
     7465   v-entry[2] = v-entry[1]
     7466   .
     7467   if v-entry[3] = "":U then
     7468   assign
     7469   v-entry[3] = v-entry[2]
     7470   .
     7471   assign
     7472   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7473   .
     7474   return v-result.
     7475   END FUNCTION.
     7476   function ncr-d-rank returns character (
     7477     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7478   define variable v-result as character no-undo .
     7479   define variable ii as integer no-undo .
     7480   do ii = 1 to length(p-d-rank):
     7481     CASE substr(p-d-rank, ii, 1):
     7482       when "X":U then do:
     7483         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7484       end.
     7485       when "T":U then do:
     7486         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7487       end.
     7488       when "D":U then do:
     7489         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7490       end.
     7491     END CASE.
     7492     if v-result <> "":U then LEAVE.
     7493   end.
     7494   if v-result = "":U then v-result = chr(32).
     7495   return v-result.
     7496   END FUNCTION.
     7497   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7498       define variable v-upper-code as int no-undo.
     7499       define variable v-value as character no-undo.
     7500       define variable v-type as character no-undo.
     7501       define buffer lc_gds-grp for ub.gds-grp.
     7502       define buffer lc_goods for ub.goods.
     7503      if p-gds-code <> 0 then do:
     7504       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7505       v-upper-code = lc_goods.grp-code.
     7506       do while v-upper-code > 0 :
     7507           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7508           run ggoattr-value(
     7509             input lc_gds-grp.node-code,
     7510             input 0,
     7511             input "",
     7512             input 0,
     7513             input 'ban-sales-via-cd':U,
     7514             output v-value,
     7515             output v-type
     7516           ).
     7517          if v-value = "yes" then
     7518             return true.
     7519          else
     7520          do:
     7521             run ggoattr-value(
     7522                input lc_gds-grp.node-code,
     7523                input shop.host-code,
     7524                input "",
     7525                input 0,
     7526                input 'ban-sales-via-cd':U,
     7527                output v-value,
     7528                output v-type
     7529                ).
     7530             if v-value = "yes" then
     7531                return true.
     7532             else
     7533             do:
     7534                run ggoattr-value(
     7535                   input lc_gds-grp.node-code,
     7536                   input shop.host-code,
     7537                   input 'маг':U,
     7538                   input i-obj-code,
     7539                   input 'ban-sales-via-cd':U,
     7540                   output v-value,
     7541                   output v-type
     7542                   ).
     7543                if v-value = "yes" then
     7544                   return true.
     7545                else v-upper-code = lc_gds-grp.upper-code.
     7546             end .
     7547          end.
     7548         end.
     7549       end.
     7550   end.
     7551   FUNCTION convert-tax-code returns integer
     7552                                             ( input p-rate-code as integer
     7553                                              ,input p-cdtaxlst  as character
     7554                                             ) :
     7555   define variable jj as integer no-undo .
     7556     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7557       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7558         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7559       end.
     7560     end.
     7561   END FUNCTION.
     7562   FUNCTION convert-maria-tax-code returns character
     7563                                             ( input p-vat-rate-code as integer
     7564                                              ,input p-slt-rate-code as integer
     7565                                              ,input p-cdtaxlst  as character
     7566                                             ) :
     7567   define variable jj as integer no-undo .
     7568   define variable aa as character no-undo extent 8.
     7569   define variable v-return-value as character no-undo .
     7570     do jj = 1 to 8:
     7571       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7572         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7573           aa[jj] = '1'.
     7574         end.
     7575         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7576           aa[jj] = '1'.
     7577         end.
     7578       end.
     7579       if aa[jj] = '':U then aa[jj] = '0'.
     7580       v-return-value = aa[jj] + v-return-value.
     7581     end.
     7582   return v-return-value.
     7583   END FUNCTION.
     7584   FUNCTION convert-maria-tax-code-2 returns integer
     7585                                             ( input p-rate-code as integer
     7586                                              ,input p-cdtaxlst  as character
     7587                                             ) :
     7588   define variable jj as integer no-undo .
     7589   define variable v-return-value as integer no-undo .
     7590     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7591       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7592         return jj.
     7593       end.
     7594     end.
     7595   return 0.
     7596   END FUNCTION.
