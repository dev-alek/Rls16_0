    11211                   assign
    11212                   temp-disc-dec = 0.
    11213                 end.
    11214               end.
    11215               otherwise do:
    11216                 temp-disc-dec = 0.
    11217               end.
    11218             end case.
    11219           end.
    11220           assign
    11221           temp-disc-reason = 0
    11222           temp-disc-weekday = 0
    11223           no-error
    11224           .
    11225           assign
    11226           temp-disc-start = cash-dis-time-rule.date-from
