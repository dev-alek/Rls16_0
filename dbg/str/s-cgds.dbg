    13536             end.
    13537             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    13538           end.
    13539           if v-next then do:
    13540             ss0 = v-cd-subject-code.
    13541             put stream plucash unformatted
    13542             ss skip.
    13543             NEXT _rr2.
    13544           end.
    13545           if not v-updated-subject-dis-kat then do:
    13546             find first buf_cash-ncr-dis-kat no-lock where
    13547                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    13548                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
    13549             if not available buf_cash-ncr-dis-kat then do:
    13550               put stream plucash unformatted
    13551               ss skip.
    13552             end.
    13553           end.
    13554           ss0 = v-cd-subject-code.
    13555         end.
