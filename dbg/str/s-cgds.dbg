     1517   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1520   procedure disrules-fill-properties:
     1521   define input  parameter p-templ-rl-root as integer   no-undo .
     1522   define buffer buf_drt-prop for ub.drt-prop.
     1523   define buffer buf_temp-drt-prop for temp-drt-prop.
     1524   do
     1525   on error undo, return error return-value
     1526   :
     1527     for each buf_temp-drt-prop:
     1528       delete buf_temp-drt-prop.
     1529     end.
     1530     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1531       create buf_temp-drt-prop.
     1532       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1533     end.
     1534   end.
     1535   end procedure.
     1536   ~
     1537   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   procedure discfgru-check :
     1539   define input parameter p-table-name as character no-undo .
     1540   define input parameter p-templ-rl-root as integer no-undo .
     1541   define input parameter p-time-templ-rl-root as integer no-undo .
     1542   define input parameter p-pos-type as character no-undo .
     1543   define output parameter p-disnct-role as character no-undo .
     1544   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       find first buf_dis-cfg-rule no-lock where
     1549               buf_dis-cfg-rule.table-name = p-table-name
     1550           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1551           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1552           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1553       if not available buf_dis-cfg-rule
     1554       or p-pos-type = "":U
     1555       then do:
     1556          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1557                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1558                                  , p-templ-rl-root
     1559                                  , (if p-time-templ-rl-root = ?
     1560                                     then '':U
     1561                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1562                                     )
     1563                                  ).
     1564       end.
     1565       assign
     1566       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1567       .
     1568     end.
     1569   end procedure.
     1570   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1571   FUNCTION get-region RETURNS CHARACTER
     1572     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1573     define variable par-region as character no-undo.
     1574     if parhost-code = 0 and
     1575          parobj-type = "":U and
     1576          parobj-code = 0 then do:
     1577          par-region = "Глобально".
     1578          return par-region.
     1579       end.
     1580       if parobj-type = 'орг':U then do:
     1581          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1582          return par-region.
     1583       end.
     1584       if parobj-type = 'регион':U
     1585       then do:
     1586          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1587          return par-region.
     1588       end.
     1589       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1590       return par-region.
     1591   END FUNCTION.
     1592   FUNCTION get-objregion RETURNS CHARACTER
     1593     (  input parobj-type as character, input parobj-code as integer ) :
     1594     define variable par-region as character no-undo.
     1595     if  parobj-type = "":U and
     1596         parobj-code = 0
     1597     then do:
     1598        par-region = "Глобально".
     1599     end.
     1600     else if parobj-type = 'орг':U
     1601     then do:
     1602        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1603     end.
     1604     else if parobj-type = 'регион':U
     1605     then do:
     1606        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1607     end.
     1608     else
     1609        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1610     return par-region.
     1611   END FUNCTION.
     1612   procedure disgdsru-name :
     1613   define buffer buf_dis-rule for ub.dis-rule.
     1614   do
     1615     on error undo, return error
     1616     :
     1617     define input  parameter p-templ-rl-root  as integer no-undo .
     1618     define output parameter p-label          as character no-undo .
     1619     find first buf_dis-rule no-lock where
     1620               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1621     if available buf_dis-rule
     1622     then do:
     1623       if buf_dis-rule.rule-num > 0 then
     1624       p-label = buf_dis-rule.des.
     1625     end.
     1626     else do:
     1627       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1628     end.
     1629   end.
     1630   end procedure.
     1631   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1632   define variable v-rule-label as character no-undo .
     1633   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1634                                        ,output v-rule-label) no-error.
     1635   return v-rule-label.
     1636   end function.
     1637   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1638   define variable v-rule-label as character no-undo .
     1639   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1640   end function.
     1641   procedure disgdsru-write :
     1642     do
     1643     on error undo, return error
     1644     :
     1645       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1646       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1647       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1648       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1649       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1650       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1651       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1652       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1653       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1654       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1655       define buffer buf_dis-rule for ub.dis-rule.
     1656       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1657       define variable v-label          as character no-undo .
     1658       define variable v-discnt-role as character no-undo .
     1659       run discfgru-check in this-procedure (
     1660                                             input 'dis-gds-rule':U
     1661                                            ,input p-templ-rl-root
     1662                                            ,input p-time-templ-rl-root
     1663                                            ,input p-pos-type
     1664                                            ,output v-discnt-role
     1665                                             ) no-error .
     1666       if error-status :error then do:
     1667         undo, return error return-value .
     1668       end.
     1669       if p-discnt-role = ? then do:
     1670         p-discnt-role = v-discnt-role.
     1671       end.
     1672       if p-discnt-role <> v-discnt-role then do:
     1673         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1674                                 ,p-gds-code
     1675                                 ,p-obj-type
     1676                                 ,p-obj-code
     1677                                 ,p-pos-type
     1678                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1679                                 ,chr(10)
     1680                                 ,p-templ-rl-root
     1681                                 ,p-rule-num).
     1682       end.
     1683       if p-pos-type = ? then do:
     1684   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   define variable v-param-type24 as character no-undo .
     1686   define variable v-value-date24 as date no-undo .
     1687   define variable v-value-decimal24 as decimal no-undo .
     1688   define variable v-value-integer24 as INTEGER no-undo .
     1689   define variable v-value-logical24 AS LOGICAL no-undo .
     1690   define variable v-tth24 as handle no-undo .
     1691   run adm/shattri.p (
     1692       input "get":U
     1693       ,input  p-obj-type
     1694       ,input  p-obj-code
     1695       ,input  'cd-sending':U
     1696       ,input  'dflt-cd':U
     1697       ,output p-pos-type
     1698       ,output v-value-date24
     1699       ,output v-value-decimal24
     1700       ,output v-value-integer24
     1701       ,output v-value-logical24
     1702       ,output v-param-type24
     1703       ,INPUT-OUTPUT table-handle v-tth24
     1704       )  .
     1705   delete object v-tth24 no-error.
     1706       end.
     1707       find first buf_dis-rule no-lock where
     1708                 buf_dis-rule.rule-num = p-rule-num no-error.
     1709       if not available buf_Dis-rule then do:
     1710         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1711                                 ,p-gds-code
     1712                                 ,p-obj-type
     1713                                 ,p-obj-code
     1714                                 ,p-pos-type
     1715                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1716                                 ,chr(10)
     1717                                 ,p-rule-num).
     1718       end.
     1719       if buf_dis-rule.root <> yes then do:
     1720         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1721                                 ,p-gds-code
     1722                                 ,p-obj-type
     1723                                 ,p-obj-code
     1724                                 ,p-pos-type
     1725                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1726                                 ,chr(10)
     1727                                 ,p-rule-num).
     1728       end.
     1729       if not (p-obj-type = buf_dis-rule.obj-type
     1730           and p-obj-code = buf_dis-rule.obj-code)
     1731       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1732                and
     1733                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1734        then do:
     1735         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1736                                 ,p-gds-code
     1737                                 ,p-obj-type
     1738                                 ,p-obj-code
     1739                                 ,p-pos-type
     1740                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1741                                 ,chr(10)
     1742                                 ) +
     1743                             substitute("Правило скидки &1 определено для &2&3" +
     1744                                        "а привязка к товару для &4"
     1745                                        ,buf_dis-rule.rule-num
     1746                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1747                                        ,chr(10)
     1748                                        ,get-objregion( p-obj-type, p-obj-code)
     1749                                        ))
     1750                                 .
     1751       end.
     1752       find first buf_dis-gds-rule exclusive-lock where
     1753                  buf_dis-gds-rule.gds-code  = p-gds-code
     1754              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1755              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1756              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1757              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1758              and buf_dis-gds-rule.nonunique = p-nonunique
     1759              no-error .
     1760       if not available buf_dis-gds-rule then do:
     1761         find first buf_dis-gds-rule exclusive-lock where
     1762                   buf_dis-gds-rule.gds-code  = p-gds-code
     1763               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1764               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1765               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1766               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1767               no-error .
     1768         if available buf_Dis-gds-rule then do:
     1769           if p-nonunique = ''
     1770           and available buf_dis-gds-rule
     1771           then do:
     1772             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1773                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1774                                      , p-gds-code
     1775                                      , buf_Dis-rule.obj-type
     1776                                      , buf_Dis-rule.obj-code
     1777                                      , p-nonunique
     1778                                     ).
     1779           end.
     1780           if available buf_dis-gds-rule
     1781           and buf_dis-gds-rule.nonunique = ''
     1782           and p-nonunique <> ''then do:
     1783             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1784                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1785                                      , p-gds-code
     1786                                      , buf_Dis-rule.obj-type
     1787                                      , buf_Dis-rule.obj-code
     1788                                     ).
     1789           end.
     1790         end.
     1791         create buf_dis-gds-rule .
     1792         assign
     1793         buf_dis-gds-rule.gds-code  = p-gds-code
     1794         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1795         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1796         buf_dis-gds-rule.pos-type = p-pos-type
     1797         buf_dis-gds-rule.discnt-role = v-discnt-role
     1798         buf_dis-gds-rule.rule-num = p-rule-num
     1799         buf_dis-gds-rule.nonunique = p-nonunique
     1800         no-error
     1801         .
     1802       end.
     1803       ASSIGN
     1804       buf_dis-gds-rule.rule-num = p-rule-num
     1805       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1806       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1807       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1808       buf_dis-gds-rule.nonunique = p-nonunique
     1809       no-error.
     1810     end.
     1811   end procedure.
     1812   PROCEDURE cmp-disgdsru-write :
     1813   do
     1814   on error undo, return error
     1815   :
     1816     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1817     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1818     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1819     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1820     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1821     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1822     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1823     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1824     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1825     define variable v-rule-label          as character no-undo .
     1826     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1827     define buffer buf_dis-rule     for ub.dis-rule.
     1828     run disgdsru-name in this-procedure (
     1829                                         input  p-templ-rl-root
     1830                                         ,output v-rule-label
     1831                                         ) no-error .
     1832     if error-status :error then do:
     1833       undo, return error return-value .
     1834     end.
     1835     find first buf_tt0-dis-gds-rule exclusive-lock where
     1836                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1837             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1838             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1839             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1840             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1841             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1842             no-error .
     1843     if not available buf_tt0-dis-gds-rule then do:
     1844       create buf_tt0-dis-gds-rule .
     1845       assign
     1846       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1847       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1848       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1849       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1850       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1851       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1852       no-error
     1853       .
     1854     end.
     1855     find first buf_dis-rule no-lock where
     1856               buf_dis-rule.rule-num = p-rule-num.
     1857     ASSIGN
     1858     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1859     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1860     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1861     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1862     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1863     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1864     no-error.
     1865     release buf_tt0-dis-gds-rule no-error .
     1866     if error-status:error then do:
     1867       undo, return error return-value .
     1868     end.
     1869   end.
     1870   END PROCEDURE.
     1871   define variable vss-include-info25 as character format "X(65)" no-undo
     1872   initial "@(#)$Workfile$ $Revision$".
     1873   define variable v-bgelib-bgefmt        as character         no-undo.
