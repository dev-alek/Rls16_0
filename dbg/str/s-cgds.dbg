     1134             find FIRST buf_prod-bc where
     1135                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1136                         buf_prod-bc.bc-on = yes no-lock no-error.
     1137             if not available buf_prod-bc then do:
     1138               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1139                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
