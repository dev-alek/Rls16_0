    12569       "0010":U
    12570       "0000":U
    12571       chk_name
    12572       fill(chr(32), 4)
    12573       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12574       fill(chr(32), 8)
    12575       conf-par
    12576       replace(string( cash-gds.price-sale, "999999.99")
    12577              , ".":U, "":U
    12578              )
    12579       chr(10)
    12580       .
    12581       if pos-type = 'NCR-AS@R':U
    12582       and ncrdsc <> '0':U
    12583       and wd-option > 0
    12584       and cash-gds.std-discnt-rule > 0
    12585       then do:
