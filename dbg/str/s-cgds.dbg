    11377       find FIRST buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "gds-CommodityCode" no-error.
    11378       if available buf_goods-attr then
    11379       do:
    11380         run bgelib-tag-put in this-procedure ( input 4, input "ItemCommodityCode" , input string( buf_goods-attr.attr-value), input 1 ).
    11381       end.
    11382   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
    11383                 and buf_goods-attr.attr-code  = 'oper-serv-idd':U no-error.
    11384     if available buf_goods-attr then do:
