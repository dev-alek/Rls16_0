     8019                       , input loc-bar-code.part-code
     8020                       , input parobj-type
     8021                       , input parobj-code
     8022                       , input loc-goods.alpha1
     8023                       , output v-gtd
     8024                       )
     8025   cash-gds.gtd   = v-gtd
     8026   .
     8027   assign
     8028   cash-gds.ean-lz = ''
     8029   cash-gds.ean-rz = ''
     8030   cash-gds.code-short = ''
     8031   .
     8032   run ibm-gdsc in this-procedure (input no
     8033                                 , output cash-gds.ean-lz
     8034                                 , output cash-gds.ean-rz
     8035                                 , output cash-gds.code-short
     8036                                 ) no-error .
     8037   if new-good then new-good = not new-good.
     8038   if action = "U" then do:
     8039     if cash-gds.kat-discnt-rule <> 0
     8040     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8041     then do:
     8042       for each cash-dis-rule no-lock where
     8043             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8044       :
     8045         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8046                                             ,input 'маг':U
     8047                                             ,input i-obj-code
     8048                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8049                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8050                                             ,input ?
     8051                                             ,output v-disc-price-sale
     8052                                             ,output v-pdf-id
     8053                                             ,output v-pdf-db-num ) no-error.
     8054         if error-status:error
     8055         or v-disc-price-sale = 0
     8056         or v-disc-price-sale = ?
     8057         then do:
     8058         end.
     8059         else do:
     8060           find first  cash-gds-discnt where
     8061                     cash-gds-discnt.b-code = cash-gds.b-code
     8062                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8063                   and cash-gds-discnt.obj-type = parobj-type
     8064                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8065           if not available cash-gds-discnt then do:
     8066             find first  cash-gds-discnt where
     8067                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8068             if not available cash-gds-discnt then do:
     8069               create cash-gds-discnt.
     8070               assign
     8071               cash-gds-discnt.crf = crgd + 1.
     8072             end.
     8073             crgd = crgd + 1.
     8074             assign
     8075             cash-gds-discnt.b-code = cash-gds.b-code
     8076             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8077             cash-gds-discnt.obj-type = parobj-type
     8078             cash-gds-discnt.obj-code = parobj-code
     8079             cash-gds-discnt.discnt-value = v-disc-price-sale
     8080             .
     8081             release cash-gds-discnt.
     8082           end.
     8083         end.
     8084       end.
     8085     end.
     8086     if cash-gds.temp-discnt-rule <> 0
     8087     and how-temp-disc = 'temp-disc-pdf':U
     8088     then do:
     8089       for each cash-dis-rule no-lock where
     8090             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8091         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8092         and cash-dis-rule.is-term = yes
     8093       :
     8094         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8095                                             ,input 'маг':U
     8096                                             ,input i-obj-code
     8097                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8098                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8099                                             ,input ?
     8100                                             ,output v-disc-price-sale
     8101                                             ,output v-pdf-id
     8102                                             ,output v-pdf-db-num ) no-error.
     8103         if error-status:error
     8104         or v-disc-price-sale = 0
     8105         or v-disc-price-sale = ?
     8106         then do:
     8107         end.
     8108         else do:
     8109           find first  cash-gds-discnt where
     8110                     cash-gds-discnt.b-code = cash-gds.b-code
     8111                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8112                   and cash-gds-discnt.obj-type = parobj-type
     8113                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8114           if not available cash-gds-discnt then do:
     8115             find first  cash-gds-discnt where
     8116                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8117             if not available cash-gds-discnt then do:
     8118               create cash-gds-discnt.
     8119               assign
     8120               cash-gds-discnt.crf = crgd + 1.
     8121             end.
     8122             crgd = crgd + 1.
     8123             assign
     8124             cash-gds-discnt.b-code = cash-gds.b-code
     8125             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8126             cash-gds-discnt.obj-type = parobj-type
     8127             cash-gds-discnt.obj-code = parobj-code
     8128             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8129             release cash-gds-discnt.
     8130           end.
     8131         end.
     8132       end.
     8133     end.
     8134   end.
     8135   END PROCEDURE.
