     6655                     neos_price-all.plt-id     = vt-plt-id and
     6656                     neos_price-all.plt-db-num = vt-plt-db and
     6657                     neos_price-all.pdf-id     = vt-pdf-id and
     6658                     neos_price-all.pdf-db     = vt-pdf-db
     6659                     use-index pi no-error .
     6660            if available neos_price-all then do:
     6661             assign
     6662               p-plt-id           = tt_price-all.plt-id
     6663               p-plt-db-num       = tt_price-all.plt-db-num
     6664               p-pdf-id           = tt_price-all.pdf-id
     6665               p-pdf-db-num       = tt_price-all.pdf-db
     6666               p-sale-price-base  = neos_price-all.price-sale-base
     6667               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6668               p-road-tax-base    = neos_price-all.road-tax-base
     6669               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6670               p-excise-base      = neos_price-all.excise-base
     6671               p-excise-rubl      = neos_price-all.excise-rubl
     6672               .
     6673            end.
     6674            else do:
     6675                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6676                 if error-status :error    then do:
     6677                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6678                   return error return-value .
     6679                 end.
     6680             assign
     6681               p-plt-id           = tt_price-all.plt-id
     6682               p-plt-db-num       = tt_price-all.plt-db-num
     6683               p-pdf-id           = tt_price-all.pdf-id
     6684               p-pdf-db-num       = tt_price-all.pdf-db
     6685               p-sale-price-base  = tt_price-all.price-sale-base
     6686               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6687               p-road-tax-base    = tt_price-all.road-tax-base
     6688               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6689               p-excise-base      = tt_price-all.excise-base
     6690               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6691               .
     6692            end.
     6693        end.
     6694     end.
     6695   end.
     6696   end procedure.
     6697   procedure mpl-tpl-auto :
     6698   define input  parameter p-b-code     as integer   no-undo .
     6699   define input  parameter p-obj-type   as character no-undo .
     6700   define input  parameter p-obj-code   as integer   no-undo .
     6701   define input  parameter p-plt-id     as integer   no-undo .
     6702   define input  parameter p-plt-db-num as integer   no-undo .
     6703   define input  parameter p-fact-order as decimal   no-undo .
     6704   define output parameter p-sale-price as decimal   no-undo .
     6705   define output parameter p-pdf-id     as integer   no-undo .
     6706   define output parameter p-pdf-db-num as integer   no-undo .
     6707     do
     6708     on error undo, return error return-value
     6709     :
     6710   if p-fact-order = ? then do:
     6711     run fact-order-mpl (
     6712         input   today       ,
     6713         input   p-obj-type  ,
     6714         input   p-obj-code  ,
     6715         output  p-fact-order ) .
     6716   end.
     6717   assign
     6718     p-pdf-id      = ?
     6719     p-pdf-db-num  = ?
     6720     p-sale-price  = ?
     6721   .
     6722   define buffer buf_bar-code for ub.bar-code  .
     6723   define buffer buf_goods for ub.goods  .
     6724   find first buf_bar-code no-lock where
     6725              buf_bar-code.b-code = p-b-code
     6726              no-error .
     6727   if error-status :error then return error return-value .
     6728   find first buf_goods no-lock where
     6729              buf_goods.gds-code = buf_bar-code.gds-code
     6730              no-error .
     6731   if error-status :error then return error return-value .
     6732   define variable v-main-b-code as integer   no-undo .
     6733   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6734     (input  buf_goods.gds-code
     6735     ,input  ?
     6736     ,output v-main-b-code
     6737     )  .
     6738   define buffer buf_price-all for ub.price-all  .
     6739   for each tt_price-all : delete tt_price-all. end.
     6740       for each buf_price-all no-lock where
     6741               buf_price-all.plt-id     = p-plt-id                 and
     6742               buf_price-all.plt-db-num = p-plt-db-num             and
     6743               buf_price-all.obj-type   = p-obj-type               and
     6744               buf_price-all.obj-code   = p-obj-code               and
     6745               buf_price-all.gds-code   = buf_goods.gds-code       and
     6746             ( buf_price-all.b-code = v-main-b-code or
     6747               buf_price-all.b-code = p-b-code)    and
     6748               buf_price-all.status_    = 'акт':U         and
     6749               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6750             ( buf_price-all.fact-order-sys-to = ? or
     6751               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6752               :
     6753                 create tt_price-all .
     6754                 buffer-copy buf_price-all to tt_price-all
     6755                 assign
     6756                   tt_price-all.price-sale  = buf_price-all.price-sale
     6757                 .
     6758       end.
     6759   define variable vt-plt-id as integer   no-undo .
     6760   define variable vt-plt-db as integer   no-undo .
     6761   define variable vt-pdf-id as integer   no-undo .
     6762   define variable vt-pdf-db as integer   no-undo .
     6763   define buffer neos_price-all for tt_price-all  .
     6764   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6765       if available tt_price-all then do:
     6766        assign
     6767          vt-plt-id = tt_price-all.plt-id
     6768          vt-plt-db = tt_price-all.plt-db-num
     6769          vt-pdf-id = tt_price-all.pdf-id
     6770          vt-pdf-db = tt_price-all.pdf-db
     6771        .
     6772        if tt_price-all.b-code = p-b-code then do:
     6773             assign
     6774               p-plt-id           = tt_price-all.plt-id
     6775               p-plt-db-num       = tt_price-all.plt-db-num
     6776               p-pdf-id           = tt_price-all.pdf-id
     6777               p-pdf-db-num       = tt_price-all.pdf-db
     6778               p-sale-price       = tt_price-all.price-sale
     6779               .
     6780        end.
     6781        else do:
     6782          find first neos_price-all where
     6783                     neos_price-all.b-code     = p-b-code  and
     6784                     neos_price-all.plt-id     = vt-plt-id and
     6785                     neos_price-all.plt-db-num = vt-plt-db and
     6786                     neos_price-all.pdf-id     = vt-pdf-id and
     6787                     neos_price-all.pdf-db     = vt-pdf-db
     6788                     use-index pi no-error .
     6789            if available neos_price-all then do:
     6790             assign
     6791               p-plt-id           = tt_price-all.plt-id
     6792               p-plt-db-num       = tt_price-all.plt-db-num
     6793               p-pdf-id           = tt_price-all.pdf-id
     6794               p-pdf-db-num       = tt_price-all.pdf-db
     6795               p-sale-price       = neos_price-all.price-sale
     6796               .
     6797            end.
     6798            else do:
     6799           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6800           if error-status :error    then do:
     6801              message "Не найден бар-код" p-b-code view-as alert-box error .
     6802              return error return-value .
     6803           end.
     6804             assign
     6805               p-plt-id           = tt_price-all.plt-id
     6806               p-plt-db-num       = tt_price-all.plt-db-num
     6807               p-pdf-id           = tt_price-all.pdf-id
     6808               p-pdf-db-num       = tt_price-all.pdf-db
     6809               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6810               .
     6811            end.
     6812        end.
     6813     end.
     6814     end.
     6815   end procedure.
