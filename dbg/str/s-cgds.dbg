    11402           run bgelib-tag-put in this-procedure ( input 3, input "IMarkAlc" ,    input string(bb_goods.proof), input 1 ).
    11403           run bgelib-tag-close in this-procedure ( input 2, input "ItemMarkCode").
    11404       end.
    11405   for each buf_cash-gds no-lock where
    11406             buf_cash-gds.main-prt-b-code = cash-gds.main-prt-b-code
    11407         AND buf_cash-gds.obj-type = 'маг':U
    11408         AND buf_cash-gds.obj-code = abs(i-obj-code)
    11409             :
    11410      if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0 and buf_cash-gds.b-str = "" and ub.shop.cd-sc-base  then NEXT.
    11411      if (ub.shop.cd-loc-base = no and buf_cash-gds.is-main-code = yes) then next.
    11412      v-IBCType = 0 .
    11413      if v-mark then do:
    11414          find first buf_prod-bc no-lock where buf_prod-bc.b-code = buf_cash-gds.b-code and buf_prod-bc.bc-on-type = 'GTIN':U
    11415                                           and buf_prod-bc.b-str = buf_cash-gds.b-str no-error .
    11416          if available (buf_prod-bc) then do:
    11417          v-IBCType = 2 .
    11418          end.
    11419          else do:
    11420          find first buf_prod-bc-attr no-lock where buf_prod-bc-attr.b-code = buf_cash-gds.b-code
    11421                                 and buf_prod-bc-attr.b-str = buf_cash-gds.b-str
    11422                                 and buf_prod-bc-attr.attr-code = 'mark':U
    11423                                 no-error .
    11424          if available (buf_prod-bc-attr) and buf_prod-bc-attr.attr-value = "yes" then
    11425            v-IBCType = 1 .
    11426        end.
    11427      end.
    11428     if v-mark and buf_cash-gds.b-str = "" then v-IBCType = 1 .
    11429     find first ub.prod-bc no-lock where ub.prod-bc.b-str = buf_cash-gds.b-str and ub.prod-bc.b-str <> "" and ub.prod-bc.bc-on-type = 'GTIN':U
    11430     no-error .
    11431     define variable vBarCode1 as int no-undo.
    11432     define variable vBarCode2 as int no-undo.
    11433     if available (ub.prod-bc) then do:
    11434       if cash-gds.cli-base-rate eq 1
    11435       then do:
    11436          v-i-cli-qnty = 999999999.
    11437          for each buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11438                                     and buf_bar-code_cl.cli-base-rate ne cash-gds.cli-base-rate
    11439          no-lock:
    11440            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    11441            if v-i-cli-qnty =  buf_bar-code_cl.cli-base-rate
    11442            then
    11443               vBarCode1 = buf_bar-code_cl.b-code.
    11444          end.
    11445          if vaction = "D" and
    11446             v-i-cli-qnty = 999999999
    11447          then do:
    11448             assign
    11449                v-i-cli-qnty = cash-gds.cli-base-rate
    11450                vBarCode1 = cash-gds.main-prt-b-code
    11451                .
    11452          end.
    11453       end.
    11454       else do:
    11455          v-i-cli-qnty = 999999999.
    11456          for first buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11457                                     and buf_bar-code_cl.cli-base-rate eq 1
    11458          no-lock:
    11459            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    11460            vBarCode2 = buf_bar-code_cl.b-code.
    11461          end.
    11462          if vaction = "D" and
    11463             v-i-cli-qnty = 999999999
    11464          then do:
    11465             assign
    11466                v-i-cli-qnty = cash-gds.cli-base-rate
    11467                vBarCode2 = cash-gds.main-prt-b-code
    11468                .
    11469          end.
    11470       end.
    11471       if vGdsTabak then do:
