    11349               run bgelib-tag-close in this-procedure ( input 3, input "ItemTax").
    11350             end.
    11351           end.
    11352         end.
    11353       end.
    11354   end.
    11355   run gds-attr-value in this-procedure (
    11356                                    input cash-gds.gds-code
    11357                                   ,input 'emrc-type':U
    11358                                   ,output v-attr-emrc
    11359                                   ,output v-attr-type) no-error.
    11360   run bgelib-tag-put in this-procedure ( input 3, input "Item_EMRC"  , input v-attr-emrc , input 1 ).
    11361   vGdsTabak = if vaction = "D" then yes else no.
    11362   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
    11363                 and buf_goods-attr.attr-code  = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" no-error .
    11364       if available (buf_goods-attr)
    11365          and MarkType:GetKeyIntDB(buf_goods-attr.attr-value) > 0
    11366       then do:
