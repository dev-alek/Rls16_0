    11482            v-cli-base = string (v-i-cli,"99").
    11483            run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    11484                                                , (if vaction = "U"
    11485                                                   then (if buf_cash-gds.bc-on eq yes then "ADD":U else "DEL":U)
    11486                                                   else "DEL":U)
