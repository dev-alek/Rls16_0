    13658     end.
    13659     run write-log-and-file in p-log-handle (
    13660           input 1
    13661         , input log-file-name
    13662         , input 1
    13663         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    13664                              ,for-cash-desk.cash-num
    13665                              ,chr(10)
    13666                              ,return-value
    13667                           )
    13668                                           ).
