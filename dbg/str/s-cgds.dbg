     3052   procedure xml-cd-write-header:
     3053   do
     3054   on error undo, return error
     3055   :
     3056   define input parameter p-xml-file-name       as character    no-undo.
     3057   define input parameter p-xml-file-name-path  as character    no-undo.
     3058   define input parameter p-doc-name            as character    no-undo.
     3059   define input parameter p-version             as character    no-undo.
     3060   define input parameter p-obj-list            as character    no-undo.
     3061   define input parameter p-correspondent       as character    no-undo .
     3062   define input parameter p-write-header        as logical      no-undo .
     3063   define variable OS-time as character no-undo .
     3064   define variable id as character no-undo .
     3065   define buffer buf_db for ub.db.
     3066   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3067   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3068   assign
     3069   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3070   .
     3071   run bgelib-tag-open in this-procedure (
     3072                                        1
     3073                                       ,p-doc-name
     3074                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3075                                         ).
     3076   if p-write-header then do:
     3077     run bgelib-tag-open(2, "Header","").
     3078     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3079     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3080     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3081     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3082     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3083     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3084     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3085     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3086     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3087     run bgelib-tag-close( 2, "Header" ).
     3088   end.
     3089   output stream stmXMLOut close.
     3090   end.
     3091   end procedure.
     3092   procedure xml-cd-write-footer:
     3093   do
     3094   on error undo, return error
     3095   :
     3096   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3097   define input parameter p-xml-file-name as character    no-undo.
     3098   define input parameter p-doc-name      as character    no-undo .
     3099   define variable v-error-num     as integer           no-undo.
     3100   define variable v-md5-signature as character no-undo .
     3101   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3102   run bgelib-tag-close( 0, p-doc-name ).
     3103   put stream stmXMLOut unformatted skip.
     3104   output stream stmXMLOut close.
     3105   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3106   if v-error-num > 0
     3107   then do:
     3108      return error.
     3109   end.
     3110   if opsys = "unix"
     3111   then do:
     3112       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3113   end.
     3114   end.
     3115   end procedure.
     3116   procedure xml-cd-filename :
     3117   do
     3118   on error undo, return error
     3119   :
     3120   define input parameter  p-out               as character no-undo .
     3121   define output parameter p-xml-file-name     as character    no-undo.
     3122   define output parameter p-xml-file-name-path   as character    no-undo.
     3123   define output parameter p-log-file-name     as character    no-undo.
     3124   define output parameter p-locked            as logical      no-undo.
     3125   define variable v-out as character     no-undo.
     3126   define variable loc#log as logical no-undo .
     3127   define variable BadFlag as logical no-undo .
     3128   define variable fq as integer no-undo .
     3129   define variable v-remote as character no-undo .
     3130   assign
     3131   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3132   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3133   p-log-file-name = p-out + "actions.log"
     3134   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3135   .
     3136   end.
     3137   end procedure.
     3138   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3139   define variable v-date-str as character no-undo .
     3140   assign
     3141   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3142                string(Month(p-date), "99":U) + "-":U +
     3143                string(DAY(p-date), "99":U).
     3144   return v-date-str.
     3145   END FUNCTION.
     3146   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3147   define variable v-date-str as character no-undo .
     3148   assign
     3149   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3150                string(Month(p-date), "99":U) + "-":U +
     3151                string(DAY(p-date), "99":U) + chr(32) +
     3152                string(p-time, "HH:MM:SS").
     3153   return v-date-str.
     3154   END FUNCTION.
     3155   function string-to-date returns date ( input p-string  as character):
     3156     define variable v-date as date no-undo .
     3157     assign
     3158     v-date = date(integer(substring(p-string, 4, 2))
     3159                   ,integer(substring(p-string, 1, 2))
     3160                   ,integer(substring(p-string, 7, 4))
     3161                  ) no-error .
     3162     if error-status:error then return ?.
     3163     return v-date.
     3164   END FUNCTION.
     3165   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3166   define variable v-time as integer no-undo init ?.
     3167   define variable v-dop1 as character no-undo .
     3168   define variable v-dop2 as character no-undo .
     3169   assign
     3170   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3171   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3172   no-error .
     3173   if error-status:error then return ?.
     3174   assign
     3175   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3176             integer(entry(2, v-dop2, ";":U)) * 60 +
     3177             integer(entry(3, v-dop2, ";":U)) no-error .
     3178   return v-time.
     3179   END FUNCTION.
     3180   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3181   procedure gdcstcod_cst-code :
     3182     define input  parameter p-obj-type  as character no-undo .
     3183     define input  parameter p-obj-code  as integer   no-undo .
     3184     define input  parameter p-gds-code  as integer   no-undo .
     3185     define input  parameter p-in-code   as character no-undo .
     3186     define input  parameter p-part-code as character no-undo .
     3187     define output parameter p-cst-code  as character no-undo .
     3188     define buffer buf_goods for ub.goods .
     3189     define buffer buf_parts for ub.parts .
     3190     do
     3191     on error undo, return error return-value
     3192     :
     3193       assign
     3194         p-cst-code = ''
     3195       .
     3196       find first buf_goods no-lock
     3197         where buf_goods.gds-code = p-gds-code
     3198         no-error .
     3199       if not available buf_goods
     3200       then do:
     3201         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3202       end.
     3203       if p-in-code = ?
     3204       then do:
     3205         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3206       end.
     3207       if p-part-code = ?
     3208       then do:
     3209         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3210       end.
     3211       if p-in-code = '':u
     3212       then do:
     3213         find first buf_parts no-lock
     3214           where buf_parts.obj-type  = p-obj-type
     3215             and buf_parts.obj-code  = p-obj-code
     3216             and buf_parts.artic     = buf_goods.artic
     3217             and buf_parts.prod-type = buf_goods.prod-type
     3218             and buf_parts.prod-code = buf_goods.prod-code
     3219             and buf_parts.out-code  = 'free-zone':U
     3220             and buf_parts.status_   = false
     3221           no-error .
     3222         if available buf_parts
     3223         then do:
     3224           assign
     3225             p-cst-code = buf_parts.cst-code
     3226           .
     3227         end.
     3228       end.
     3229       else do:
     3230         find first buf_parts no-lock
     3231           where buf_parts.obj-type  = p-obj-type
     3232             and buf_parts.obj-code  = p-obj-code
     3233             and buf_parts.artic     = buf_goods.artic
     3234             and buf_parts.prod-type = buf_goods.prod-type
     3235             and buf_parts.prod-code = buf_goods.prod-code
     3236             and buf_parts.out-code  = 'free-zone':U
     3237             and buf_parts.in-code   = p-in-code
     3238             and buf_parts.part-code = p-part-code
     3239           no-error .
     3240         if available buf_parts
     3241         then do:
     3242           assign
     3243             p-cst-code = buf_parts.cst-code
     3244           .
     3245         end.
     3246       end.
     3247     end.
     3248   end procedure.
