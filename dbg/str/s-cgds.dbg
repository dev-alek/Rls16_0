    12695   define buffer for-cash-desk for ub.cash-desk.
    12696   define buffer buf_cd-plu for ub.cd-plu.
    12697   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    12698   define buffer buf_cash-gds for cash-gds.
    12699   define buffer buf_dis-rule for ub.dis-rule.
    12700   define buffer buf_place for ub.place.
    12701   define buffer buf_pl-gds for ub.pl-gds.
    12702   FOR EACH for-cash-desk NO-LOCK WHERE
    12703           for-cash-desk.db-num = g#db-num AND
    12704           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12705           for-cash-desk.obj-code = i-obj-code AND
    12706    for-cash-desk.cash-on  = yes
    12707       BREAK
    12708       BY for-cash-desk.db-num
    12709       BY for-cash-desk.obj-code
    12710       BY for-cash-desk.pos-type
    12711       BY for-cash-desk.cash-on
    12712       BY for-cash-desk.cash-num
    12713       :
    12714     if LOOKUP(ub.cash-desk.pos-type,
    12715               ('NCR-GM':U + chr(44) +
    12716                'IBM-XML':U + chr(44) +
    12717                'MAGIA-XML':U + chr(44) +
    12718                'NCR-AS@R':U  + chr(44) +
    12719                'Autotank':U
    12720                  )) > 0
    12721     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    12722     if LOOKUP(ub.cash-desk.pos-type,
    12723               'MARIA':U
    12724                  ) > 0 then do:
    12725       if for-cash-desk.autonomy = integer('2':U) then do:
    12726         assign
    12727         v-cd-list-update = for-cash-desk.addr-path
    12728         v-cd-list-delete = for-cash-desk.addr-path
    12729         .
    12730         NEXT.
    12731       end.
    12732       else do:
    12733         if v-cd-list-update = '':U then nExt.
    12734       end.
    12735     end.
