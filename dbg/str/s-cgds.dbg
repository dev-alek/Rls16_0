    11272             run bgelib-tag-put in this-procedure ( input 4, input "IQType"
    11273                                                 , input string(if cash-dis-rule.value-type = integer('2':U)
    11274                                                                 then 1
    11275                                                                 else 0)
    11276                                                   , input 1 ).
    11277             run bgelib-tag-put in this-procedure ( input 4, input "IQPayRestriction"
    11278                                                  , input string(if cash-dis-rule.templ-rl-root = 73
    11279                                                                 or cash-dis-rule.templ-rl-root = 74
    11280                                                                 then cash-dis-rule.key#_one
    11281                                                                 else 0
    11282                                                                 ),  input 1 ).
    11283         end.
    11284         run bgelib-tag-close in this-procedure ( input 3, input "ItemQtyDisc").
    11285       end.
