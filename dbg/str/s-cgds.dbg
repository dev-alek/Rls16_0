     4771   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4772   PROCEDURE cd-mrkt_plu-marketer :
     4773   define input parameter p-silence as logical no-undo .
     4774   define parameter buffer buf_cash-desk for ub.cash-desk.
     4775   define input parameter p-id as character no-undo .
     4776   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4777   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4778   define input parameter p-loc-ean as logical no-undo .
     4779   define input parameter p-is-petrolium as logical no-undo .
     4780   define input parameter p-extra as character no-undo .
     4781   define variable v-tot-gds as integer no-undo .
     4782   define variable v-max-gds as integer no-undo .
     4783   define variable v-petrol-start as integer no-undo .
     4784   define variable v-petrol-range as integer no-undo .
     4785   DEFINE VARIABLE v-today as date no-undo .
     4786   DEFINE VARIABLE v-time as integer no-undo .
     4787   define variable v-plu-type as character no-undo .
     4788   define variable v-int as integer no-undo .
     4789   define buffer  buf_cd-plu for ub.cd-plu.
     4790   define buffer  loc_cd-plu for ub.cd-plu.
     4791   define variable  ii as integer no-undo.
     4792   define variable v-mes as character no-undo .
     4793   _main:
     4794   DO ON ERROR undo, leave on stop undo, leave:
     4795     if buf_cash-desk.pos-type <> 'MARIA':U
     4796     or buf_cash-desk.cash-num <> 0 then do:
     4797       assign
     4798       v-mes =
     4799       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4800                 , buf_cash-desk.pos-type).
     4801       if not p-silence then
     4802       message
     4803       v-mes
     4804       view-as alert-box error .
     4805       return error v-mes.
     4806     end.
     4807     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4808                                     ,input 'MARIA_operative':U
     4809                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4810                                           and p-is-petrolium
     4811                                           then 'tot-petrol':U
     4812                                           else 'tot-gds':U)
     4813                                     , output v-mes).
     4814     if v-tot-gds = ? then undo _main, return error v-mes.
     4815     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4816                                     ,input 'MARIA_general':U
     4817                                     ,input 'max-gds':U
     4818                                     ,output v-mes).
     4819     if v-max-gds = ? then undo _main, return error v-mes.
     4820     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4821                                          ,input 'petrolium-range':U
     4822                                          ,input 'petrolium-range':U
     4823                                          ,output v-mes).
     4824     if v-petrol-range = ? then undo _main, return error v-mes.
     4825     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4826       assign
     4827       v-petrol-start = 1
     4828       v-max-gds = (if p-is-petrolium
     4829                    then v-petrol-range
     4830                    else v-max-gds)
     4831       v-plu-type = (if p-is-petrolium
     4832                  then 'топ':U
     4833                  else '':U)
     4834       .
     4835       if p-is-petrolium then do:
     4836         if p-id = '':U then do:
     4837           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4838                               "Невозможно привязать к кассе типа &3"
     4839                               , p-b-str
     4840                               , chr(10)
     4841                               , 'MARIA':U).
     4842           if not p-silence then
     4843           message
     4844           v-mes
     4845           view-as alert-box error .
     4846           return error v-mes.
     4847         end.
     4848         assign
     4849         v-int = integer(p-id)
     4850         no-error
     4851         .
     4852         if error-status:error
     4853         or v-int > v-petrol-range then do:
     4854           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4855                               "в диапазоны номеров резервуаров для кассы типа &4"
     4856                               , p-id
     4857                               , p-b-str
     4858                               , chr(10)
     4859                               , 'MARIA':U).
     4860           if not p-silence then
     4861           message
     4862           v-mes
     4863           view-as alert-box error .
     4864           return error v-mes.
     4865         end.
     4866       end.
     4867     end.
     4868     if buf_cash-desk.pos-type = 'MARIA':U
     4869     and p-is-petrolium then do:
     4870       find first loc_cd-plu where
     4871                loc_cd-plu.obj-type = 'маг':U
     4872            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4873            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4874            and loc_cd-plu.plu-type = 'топ':U
     4875      no-error .
     4876      if available loc_cd-plu then do:
     4877        if loc_cd-plu.b-code = p-b-code
     4878        and loc_cd-plu.b-str = p-b-str then do:
     4879           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4880                               , p-id
     4881                               , p-b-str
     4882                               , chr(10)
     4883                               ).
     4884           if not p-silence then
     4885           message
     4886           v-mes
     4887           view-as alert-box WARNING .
     4888           return v-mes.
     4889        end.
     4890        else do:
     4891           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4892                               "нельзя его привязать к топливу &2&3"
     4893                               , p-id
     4894                               , loc_cd-plu.b-str
     4895                               , chr(10)
     4896                               , p-b-str).
     4897           if not p-silence then
     4898           message
     4899           v-mes
     4900           view-as alert-box error .
     4901           return error v-mes.
     4902        end.
     4903      end.
     4904      ii = v-int.
     4905     end.
     4906     else do:
     4907       DO ii = (if p-is-petrolium
     4908               then v-petrol-start
     4909               else (if buf_cash-desk.pos-type = 'MARIA':U
     4910                    then 1
     4911                    else (if v-petrol-start = 1
     4912                           then (v-petrol-range + 1)
     4913                           else 1)
     4914                   )
     4915               )
     4916         to v-max-gds :
     4917         if not can-find (loc_cd-plu where
     4918                         loc_cd-plu.obj-type = 'маг':U
     4919                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4920                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4921                      and loc_cd-plu.plu-type = v-plu-type
     4922                      and loc_cd-plu.plu-code = ii
     4923                       )
     4924         then LEAVE .
     4925       END .
     4926     end.
     4927     if ii > v-max-gds then do:
     4928         if not p-silence then
     4929         message
     4930         substitute("Превышено максимально допустимое количество &5 &1" +
     4931                   "для касс &2 &3&4"
     4932                   , chr(10)
     4933                   , v-max-gds
     4934                   , 'маг':U
     4935                   , buf_cash-desk.obj-code
     4936                   , (if p-is-petrolium then "топлив" else "товаров")
     4937                   )
     4938         view-as alert-box ERROR .
     4939         undo, return error "max-gds":U.
     4940     end.
     4941     DO ii = (if p-is-petrolium
     4942              then v-petrol-start
     4943              else (if v-petrol-start = 1
     4944                    then (v-petrol-range + 1)
     4945                    else 1)
     4946              )
     4947        to v-max-gds :
     4948       if not can-find (loc_cd-plu where
     4949                         loc_cd-plu.obj-type = 'маг':U
     4950                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4951                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4952                      and loc_cd-plu.plu-type = v-plu-type
     4953                      and loc_cd-plu.plu-code = ii
     4954                      )
     4955       then LEAVE .
     4956     END .
     4957     if ii > v-max-gds then do:
     4958         if not p-silence then
     4959         message
     4960         substitute("Превышено максимально допустимое количество &5 &1" +
     4961                   "для касс &2 &3&4"
     4962                   , chr(10)
     4963                   , v-max-gds
     4964                   , 'маг':U
     4965                   , buf_cash-desk.obj-code
     4966                   , (if p-is-petrolium then "топлив" else "товаров")
     4967                   )
     4968         view-as alert-box ERROR .
     4969         undo, return error "max-gds":U.
     4970     end.
     4971     run cur-time in this-procedure ( output v-today, output v-time).
     4972     create buf_cd-plu.
     4973     assign
     4974     buf_cd-plu.b-code = p-b-code
     4975     buf_cd-plu.b-str = p-b-str
     4976     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4977                                         then buf_cash-desk.addr-path
     4978                                         else "U":U)
     4979     buf_cd-plu.to-send = yes
     4980     buf_cd-plu.charkey_one = "":U
     4981     buf_cd-plu.to-del = no
     4982     buf_cd-plu.plu-code = ii
     4983     buf_cd-plu.obj-type = 'маг':U
     4984     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4985     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4986     buf_cd-plu.plu-type = v-plu-type
     4987     buf_cd-plu.logkey_one = p-loc-ean
     4988     buf_cd-plu.key#_one = integer(p-extra)
     4989     .
     4990     run cd-attr-write  in this-procedure (
     4991                                           input   buf_cash-desk.db-num
     4992                                           ,input  buf_cash-desk.obj-code
     4993                                           ,input  buf_cash-desk.pos-type
     4994                                           ,input  buf_cash-desk.cash-num
     4995                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4996                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4997                                                 and p-is-petrolium
     4998                                                 then 'tot-petrol':U
     4999                                                 else 'tot-gds':U)
     5000                                           ,input ''
     5001                                           ,input ?
     5002                                           ,input 0.0
     5003                                           ,input  (v-tot-gds + 1)
     5004                                           ,input no
     5005                                          ) no-error .
     5006     if error-status:error then do:
     5007       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     5008                          ,buf_cash-desk.cash-num
     5009                          , 'маг':U
     5010                          ,buf_cash-desk.obj-code
     5011                          , chr(10)
     5012                          , error-status:get-message(1)
     5013                          , return-value
     5014                          ).
     5015       if not p-silence then
     5016       message
     5017       v-mes
     5018       view-as alert-box error .
     5019       undo _main, return error v-mes.
     5020     end.
     5021     run cd-attr-write  in this-procedure (
     5022                                           input   buf_cash-desk.db-num
     5023                                           ,input  buf_cash-desk.obj-code
     5024                                           ,input  buf_cash-desk.pos-type
     5025                                           ,input  buf_cash-desk.cash-num
     5026                                           ,input  'MARIA_operative':U
     5027                                           ,input  'to-send':U
     5028                                           ,input ''
     5029                                           ,input ?
     5030                                           ,input 0.0
     5031                                           ,input 0
     5032                                           ,input yes
     5033                                          ) no-error .
     5034     if error-status:error then do:
     5035       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5036                          ,buf_cash-desk.cash-num
     5037                          , 'маг':U
     5038                          ,buf_cash-desk.obj-code
     5039                          , chr(10)
     5040                          , error-status:get-message(1)
     5041                          , return-value
     5042                          ).
     5043       if not p-silence then
     5044       message
     5045       v-mes
     5046       view-as alert-box error .
     5047       undo _main, return error v-mes.
     5048     end.
     5049     return "":U.
     5050   end.
     5051   END PROCEDURE.
     5052   procedure cd-mrkt_update-marketer :
     5053   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5054   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5055   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5056   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5057   define input parameter p-is-petrolium as logical no-undo .
     5058   define variable v-to-send as logical no-undo .
     5059   define variable v-tot-gds as integer no-undo .
     5060   define variable v-max-plu as integer no-undo .
     5061   define buffer buf_cd-plu for ub.cd-plu.
     5062   define variable v-plu-type as character no-undo .
     5063     do
     5064     on error undo, return error
     5065     :
     5066       v-to-send = no.
     5067       v-tot-gds = 0.
     5068       assign
     5069       v-plu-type = (if p-is-petrolium
     5070                     then  'топ':U
     5071                     else '':U
     5072                 )
     5073       .
     5074       FOR EACH buf_cd-plu WHERE
     5075              buf_cd-plu.obj-type = 'маг':U
     5076         and  buf_cd-plu.obj-code = p-obj-code
     5077         and  buf_cd-plu.pos-type = p-pos-type
     5078         and  buf_cd-plu.plu-type = v-plu-type
     5079             :
     5080         if  buf_cd-plu.to-del
     5081         or  buf_cd-plu.to-send then do:
     5082           assign
     5083           v-to-send = yes.
     5084         end.
     5085         assign
     5086         v-tot-gds = v-tot-gds + 1.
     5087       end.
     5088       run cd-attr-write  in this-procedure (
     5089                                               input   p-db-num
     5090                                               ,input  p-obj-code
     5091                                               ,input  p-pos-type
     5092                                               ,input  p-cash-num
     5093                                               ,input  'MARIA_operative':U
     5094                                               ,input  (if p-pos-type = 'MARIA':U
     5095                                                        and p-is-petrolium
     5096                                                        then  'tot-petrol':U
     5097                                                        else 'tot-gds':U)
     5098                                               ,input ''
     5099                                               ,input ?
     5100                                               ,input 0.0
     5101                                               ,input v-tot-gds
     5102                                               ,input no
     5103                                                                                           ) no-error .
     5104       if error-status:error then do:
     5105           UNDO, RETURN ERROR RETURN-VALUE.
     5106       END.
     5107       run cd-attr-write  in this-procedure (
     5108                                               input   p-db-num
     5109                                               ,input  p-obj-code
     5110                                               ,input  p-pos-type
     5111                                               ,input  p-cash-num
     5112                                               ,input  'MARIA_operative':U
     5113                                               ,input  (if p-pos-type = 'MARIA':U
     5114                                                        and p-is-petrolium
     5115                                                        then  'petrol-to-send':U
     5116                                                        else 'to-send':U)
     5117                                               ,input ''
     5118                                               ,input ?
     5119                                               ,input 0.0
     5120                                               ,input 0
     5121                                               ,input v-to-send
     5122                                               ) no-error .
     5123       if error-status:error then do:
     5124           UNDO, RETURN ERROR RETURN-VALUE.
     5125       END.
     5126       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5127                buf_cd-plu.obj-type = 'маг':U
     5128            and buf_cd-plu.obj-code = p-obj-code
     5129            and buf_cd-plu.pos-type = p-pos-type
     5130            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5131       if available buf_cd-plu then do:
     5132         if v-max-plu < buf_cd-plu.plu-code
     5133         then
     5134         v-max-plu = buf_cd-plu.plu-code .
     5135       end.
     5136       else do:
     5137         v-max-plu = 0.
     5138       end.
     5139       run cd-attr-write  in this-procedure (
     5140                                             input   p-db-num
     5141                                             ,input  p-obj-code
     5142                                             ,input  p-pos-type
     5143                                             ,input  p-cash-num
     5144                                             ,input  'MARIA_operative':U
     5145                                             ,input  (if p-pos-type = 'MARIA':U
     5146                                                     and p-is-petrolium
     5147                                                     then 'max-petrol-plu':U
     5148                                                     else 'max-plu':U)
     5149                                               ,input ''
     5150                                               ,input ?
     5151                                               ,input 0.0
     5152                                               ,input v-max-plu
     5153                                               ,input no
     5154                                             ) no-error .
     5155       if error-status:error then do:
     5156           UNDO, RETURN ERROR RETURN-VALUE.
     5157       END.
     5158     end.
     5159   end procedure.
     5160   PROCEDURE cd-mrkt_clu-marketer :
     5161   define input parameter p-silence as logical no-undo .
     5162   define parameter buffer buf_cash-desk for ub.cash-desk.
     5163   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5164   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5165   define variable v-tot-cli as integer no-undo .
     5166   define variable v-max-cli as integer no-undo .
     5167   DEFINE VARIABLE v-today as date no-undo .
     5168   DEFINE VARIABLE v-time as integer no-undo .
     5169   define buffer  buf_cd-clu for ub.cd-clu.
     5170   define buffer  loc_cd-clu for ub.cd-clu.
     5171   define variable  ii as integer no-undo.
     5172   define variable v-mes as character no-undo .
     5173   _main:
     5174   DO ON ERROR undo, leave on stop undo, leave:
     5175     if buf_cash-desk.pos-type <> 'MARIA':U
     5176     or buf_cash-desk.cash-num <> 0 then do:
     5177       assign
     5178       v-mes =
     5179       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5180                 , buf_cash-desk.pos-type).
     5181       if not p-silence then
     5182       message
     5183       v-mes
     5184       view-as alert-box error .
     5185       return error v-mes.
     5186     end.
     5187     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5188                                     ,input 'MARIA_operative':U
     5189                                     ,input 'tot-cli':U
     5190                                     ,output v-mes).
     5191     if v-tot-cli = ? then undo _main, return error v-mes.
     5192     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5193                                     ,input 'MARIA_general':U
     5194                                     ,input 'max-cli':U
     5195                                     , output v-mes).
     5196     if v-max-cli = ? then undo _main, return error v-mes.
     5197     DO ii = 1
     5198        to v-max-cli :
     5199       if not can-find (loc_cd-clu where
     5200                       loc_cd-clu.obj-type = 'маг':U
     5201                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5202                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5203                   and loc_cd-clu.clu-type = '':U
     5204                   and loc_cd-clu.clu-code = ii
     5205                      )
     5206       then LEAVE .
     5207     END .
     5208     if ii > v-max-cli then do:
     5209         if not p-silence then
     5210         message
     5211         substitute("Превышено максимально допустимое количество клиентов &1" +
     5212                   "для касс &2 &3&4"
     5213                   , chr(10)
     5214                   , v-max-cli
     5215                   , 'маг':U
     5216                   , buf_cash-desk.obj-code
     5217                   )
     5218         view-as alert-box ERROR .
     5219         undo, return error "max-cli":U.
     5220     end.
     5221     run cur-time in this-procedure ( output v-today, output v-time).
     5222     create buf_cd-clu.
     5223     assign
     5224     buf_cd-clu.cli-code = p-obj-code
     5225     buf_cd-clu.cli-type = p-obj-type
     5226     buf_cd-clu.obj-type = 'маг':U
     5227     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5228     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5229     buf_cd-clu.clu-type = '':U
     5230     buf_cd-clu.to-send = yes
     5231     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5232                               then buf_cash-desk.addr-path
     5233                               else "U":U)
     5234     buf_cd-clu.clu-code = ii
     5235     .
     5236     run cd-attr-write  in this-procedure (
     5237                                           input   buf_cash-desk.db-num
     5238                                           ,input  buf_cash-desk.obj-code
     5239                                           ,input  buf_cash-desk.pos-type
     5240                                           ,input  buf_cash-desk.cash-num
     5241                                           ,input  'MARIA_operative':U
     5242                                           ,input  'tot-cli':U
     5243                                           ,input ''
     5244                                           ,input ?
     5245                                           ,input 0.0
     5246                                           ,input  (v-tot-cli + 1)
     5247                                           ,input no
     5248                                          ) no-error .
     5249     if error-status:error then do:
     5250       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5251                          ,buf_cash-desk.cash-num
     5252                          , 'маг':U
     5253                          ,buf_cash-desk.obj-code
     5254                          , chr(10)
     5255                          , error-status:get-message(1)
     5256                          , return-value
     5257                          ).
     5258       if not p-silence then
     5259       message
     5260       v-mes
     5261       view-as alert-box error .
     5262       undo _main, return error v-mes.
     5263     end.
     5264     run cd-attr-write  in this-procedure (
     5265                                           input   buf_cash-desk.db-num
     5266                                           ,input  buf_cash-desk.obj-code
     5267                                           ,input  buf_cash-desk.pos-type
     5268                                           ,input  buf_cash-desk.cash-num
     5269                                           ,input  'MARIA_operative':U
     5270                                           ,input  'cli-to-send':U
     5271                                           ,input ''
     5272                                           ,input ?
     5273                                           ,input 0.0
     5274                                           ,input 0
     5275                                           ,input yes
     5276                                          ) no-error .
     5277     if error-status:error then do:
     5278       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5279                          ,buf_cash-desk.cash-num
     5280                          , 'маг':U
     5281                          ,buf_cash-desk.obj-code
     5282                          , chr(10)
     5283                          , error-status:get-message(1)
     5284                          , return-value
     5285                          ).
     5286       if not p-silence then
     5287       message
     5288       v-mes
     5289       view-as alert-box error .
     5290       undo _main, return error v-mes.
     5291     end.
     5292     return "":U.
     5293   end.
     5294   END PROCEDURE.
     5295   procedure cd-mrkt_update-marketer-cli :
     5296   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5297   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5298   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5299   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5300   define variable v-cli-to-send as logical no-undo .
     5301   define variable v-tot-cli as integer no-undo .
     5302   define variable v-max-clu as integer no-undo .
     5303   define buffer buf_cd-clu for ub.cd-clu.
     5304   do
     5305   on error undo, return error return-value
     5306   :
     5307     v-cli-to-send = no.
     5308     v-tot-cli = 0.
     5309     FOR EACH buf_cd-clu WHERE
     5310           buf_cd-clu.obj-type = 'маг':U
     5311       and buf_cd-clu.obj-code =  p-obj-code
     5312       and buf_cd-clu.pos-type =  p-pos-type
     5313       and buf_cd-clu.clu-type =  '':U
     5314       :
     5315       if buf_cd-clu.to-del = yes then do:
     5316         assign
     5317         v-cli-to-send = yes.
     5318       end.
     5319       assign
     5320       v-tot-cli = v-tot-cli + 1.
     5321     end.
     5322     run cd-attr-write  in this-procedure (
     5323                                             input   p-db-num
     5324                                             ,input  p-obj-code
     5325                                             ,input  p-pos-type
     5326                                             ,input  p-cash-num
     5327                                             ,input  'MARIA_operative':U
     5328                                             ,input  'tot-cli':U
     5329                                             ,input ''
     5330                                             ,input ?
     5331                                             ,input 0.0
     5332                                             ,input v-tot-cli
     5333                                             ,input no
     5334                                             ) no-error .
     5335     if error-status:error then do:
     5336         UNDO, RETURN ERROR RETURN-VALUE.
     5337     END.
     5338     run cd-attr-write  in this-procedure (
     5339                                             input   p-db-num
     5340                                             ,input  p-obj-code
     5341                                             ,input  p-pos-type
     5342                                             ,input  p-cash-num
     5343                                             ,input  'MARIA_operative':U
     5344                                             ,input  'cli-to-send':U
     5345                                             ,input ''
     5346                                             ,input ?
     5347                                             ,input 0.0
     5348                                             ,input 0
     5349                                             ,input v-cli-to-send
     5350                                             ) no-error .
     5351     if error-status:error then do:
     5352         UNDO, RETURN ERROR RETURN-VALUE.
     5353     END.
     5354     FIND LAST buf_cd-clu WHERE
     5355             buf_cd-clu.obj-type = 'маг':U
     5356         and buf_cd-clu.obj-code = p-obj-code
     5357         and buf_cd-clu.pos-type = p-pos-type
     5358         and buf_cd-clu.clu-type = '':U
     5359         NO-LOCK use-index pi no-error .
     5360     if available buf_cd-clu then do:
     5361       if v-max-clu < buf_cd-clu.clu-code
     5362       then
     5363       v-max-clu = buf_cd-clu.clu-code.
     5364     end.
     5365     else do:
     5366       v-max-clu = 0.
     5367     end.
     5368     run cd-attr-write  in this-procedure (
     5369                                           input   p-db-num
     5370                                           ,input  p-obj-code
     5371                                           ,input  p-pos-type
     5372                                           ,input  p-cash-num
     5373                                           ,input  'MARIA_operative':U
     5374                                           ,input  'max-clu':U
     5375                                           ,input ''
     5376                                           ,input ?
     5377                                           ,input 0.0
     5378                                           ,input v-max-clu
     5379                                           ,input no
     5380                                           ) no-error .
     5381     if error-status:error then do:
     5382         UNDO, RETURN ERROR RETURN-VALUE.
     5383     END.
     5384   end.
     5385   end procedure.
