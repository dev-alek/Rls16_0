    13511                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    13512                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    13513                 and crf <= cr-ncr-dis-kat
    13514           by buf_cash-ncr-dis-kat.cd-subject-code
    13515           by buf_cash-ncr-dis-kat.cd-disc-string
    13516           :
    13517             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    13518             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    13519               leave  _for_rr2.
    13520             end.
    13521             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    13522               v-updated-subject-dis-kat = yes.
    13523             end.
    13524             find first  cash-ncr-save-param no-lock where
    13525                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    13526                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    13527                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    13528             if available cash-ncr-save-param then do:
