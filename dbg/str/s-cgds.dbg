    12543        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    12544        or is-sc
    12545        then "1":U
    12546        else "0":U)
    12547         (if pos-type = 'NCR-GM':U or
    12548         wd-option = 0
    12549         then   ncrdsc
    12550         else '0':U)
    12551        (if cash-gds.vat-code = ? or
    12552        cash-gds.vat-code > 7 then
    12553        "0"
    12554        else string(cash-gds.vat-code, "9"))
    12555       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12556       or (is-sc
    12557       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
