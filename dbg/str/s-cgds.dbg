     1154             end.
     1155           end.
     1156           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1157             ASSIGN
     1158             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1159                                   then integer(buf_prod-bc.b-str)
     1160                                   else buf_bar-code.b-code
     1161             buf_tt-tax.rate-value  = parroad-tax
