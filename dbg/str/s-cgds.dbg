    11202                       and cash-gds-discnt.obj-type = 'маг':U
    11203                       and cash-gds-discnt.obj-code = i-obj-code
    11204                       no-error.
    11205                 if available cash-gds-discnt then do:
    11206                   assign
    11207                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
    11208                   .
    11209                 end.
