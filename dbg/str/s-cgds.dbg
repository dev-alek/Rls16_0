     3286   procedure alienini-getkey :
     3287   define input parameter i-filename as char.
     3288   define input parameter i-section as char.
     3289   define input parameter i-key as char.
     3290   define output parameter o-value as char.
     3291   define variable EntryPointer as integer no-undo.
     3292   define variable mem1 as memptr no-undo.
     3293   define variable mem2 as memptr no-undo.
     3294   define variable mem1size as integer no-undo.
     3295   define variable mem2size as integer no-undo.
     3296   define variable ii       as integer    no-undo.
     3297   define variable cbReturnSize  as integer    no-undo.
     3298   assign
     3299   set-size(mem1)  = 4000
     3300   mem1size = 4000.
     3301   if i-key = "" then EntryPointer = 0.
     3302   else do:
     3303     assign
     3304     set-size(mem2) = 128
     3305     mem2size = 128
     3306     EntryPointer = get-pointer-value(mem2)
     3307     put-string(mem2, 1) = i-key.
     3308   end.
     3309   run getprivateprofilestringA
     3310                                 (i-section,
     3311                                  EntryPointer,
     3312                                  "",
     3313                                  get-pointer-value(mem1),
     3314                                  input mem1size,
     3315                                  i-filename,
     3316                                  output cbReturnSize).
     3317   do ii = 1 to cbReturnSize:
     3318     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3319                  then o-value + ","
     3320                  else o-value + chr(get-byte(mem1, ii)).
     3321   end.
     3322     set-size(mem1) = 0.
     3323     set-size(mem2) = 0.
     3324   end procedure.
     3325   procedure alienini-putkey :
     3326   define input parameter i-filename as char.
     3327   define input parameter i-section as char.
     3328   define input parameter i-key as char.
     3329   define input parameter i-value as char.
     3330   define variable cbReturnSize as integer.
     3331   run writeprivateprofilestringA
     3332                                  (i-section,
     3333                                   i-key,
     3334                                   i-value,
     3335                                   i-filename,
     3336                                   output cbReturnSize ).
     3337   end procedure.
     3338   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3339     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3340     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3341     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3342     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3343     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3344     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3345     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3346   END PROCEDURE.
     3347   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3348     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3349     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3350     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3351     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3352     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3353   END PROCEDURE.
     3354   define   temp-table temp-tekka-tsk no-undo
     3355   field filename      as character
     3356   field obj-num       as integer
     3357   field obj-name      as character
     3358   field num-records   as integer
     3359   field max-records   as integer
     3360   field min-plu       as integer
     3361   field max-plu       as integer
     3362   field num-fields    as integer
     3363   field task-num      as character
     3364   field by-record     as logical
     3365   field send-get      as character
     3366   field cash-num      as integer
     3367   field cash-num-char as character
     3368   field port-num      as character
     3369   field way           as character
     3370   field is-script     as logical
     3371   field pswd          as character
     3372   field waiting-sek   as integer
     3373   field other-info    as character
     3374   field order-num     as integer
     3375   field secondary     as integer
     3376   field shift-fields  as integer
     3377   field binary        as logical
     3378   field range         as integer
     3379   index pi is unique primary
     3380   filename
     3381   range
     3382   index lpi
     3383   filename
     3384   min-plu
     3385   index gpi
     3386   filename
     3387   max-plu
     3388   index iorder
     3389   order-num
     3390   .
     3391   define   temp-table temp-tekka-schema no-undo
     3392   field obj-num as integer
     3393   field obj-name as character
     3394   field field-num as integer
     3395   field field-name as character
     3396   field num-records as integer
     3397   field size_ as integer
     3398   field host as character
     3399   field progress-type as character
     3400   field custom-type as character
     3401   field start-pos as integer
     3402   field end-pos as integer
     3403   field bin-group as character
     3404   index pi is unique primary
     3405   host obj-num field-num
     3406   .
     3407   define temp-table temp-tekka-record no-undo
     3408   field obj-num as integer
     3409   field plu as integer
     3410   field body as character
     3411   field shift as integer
     3412   index pi is unique primary obj-num plu.
     3413   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3414   define variable v-is-closed-shift-journal as integer no-undo .
     3415   assign
     3416   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3417                               +
     3418                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3419                               +
     3420                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3421   .
     3422   return v-is-closed-shift-journal.
     3423   END FUNCTION.
     3424   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3425   define variable v-is-first-journal as logical no-undo .
     3426   assign
     3427   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3428                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3429                     or (p-journal-num =  integer(entry(1, '17':U)))
     3430                     or (p-journal-num = integer(entry(1, '16':U)))
     3431   .
     3432   return v-is-first-journal.
     3433   END FUNCTION.
     3434   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3435   define variable v-is-petrol-journal as logical no-undo .
     3436   assign
     3437   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3438   return v-is-petrol-journal.
     3439   END FUNCTION.
     3440   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3441   define variable v-max-record-num as integer no-undo .
     3442   assign
     3443   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3444                       then 1489
     3445                       else 2340).
     3446   return v-max-record-num.
     3447   END FUNCTION.
     3448   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3449   define variable v-max-record-num as integer no-undo .
     3450   assign
     3451   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3452                       then 1489 * num-entries('30,31,32,33':U)
     3453                       else 2340 * num-entries('17':U)).
     3454   return v-max-record-num.
     3455   END FUNCTION.
     3456   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3457                                           ,input p-rec-no as integer):
     3458   define variable v-num-recs as integer no-undo .
     3459   if tekka-is-petrol-journal (p-journal-num) then do:
     3460     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3461       assign
     3462       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3463       .
     3464     end.
     3465     else do:
     3466       assign
     3467       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3468       .
     3469     end.
     3470   end.
     3471   else do:
     3472     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3473       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3474         assign
     3475         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3476         .
     3477       end.
     3478       else do:
     3479         assign
     3480         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3481         .
     3482       end.
     3483     end.
     3484     else do:
     3485       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3486         assign
     3487         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3488         .
     3489       end.
     3490       else do:
     3491         assign
     3492         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3493         .
     3494       end.
     3495     end.
     3496   end.
     3497   return v-num-recs.
     3498   END FUNCTION.
     3499   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3500                                              ,input p-is-petrol as logical
     3501                                              ,input p-is-current as logical
     3502                                              ,output p-rec-no as decimal
     3503                                              ):
     3504   define variable v-obj-num0 as integer no-undo .
     3505   define variable v-obj-num as integer no-undo .
     3506   define variable v-obj-num2 as integer no-undo .
     3507   define variable p-num-recs2 as integer no-undo .
     3508   define variable p-rec-no2 as integer no-undo .
     3509   if p-is-petrol then do:
     3510     assign
     3511     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3512     .
     3513     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3514     then
     3515     assign
     3516     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3517     p-rec-no = p-num-recs modulo 1489
     3518     .
     3519     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3520     then
     3521     assign
     3522     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3523     p-rec-no = p-num-recs modulo 1489
     3524     .
     3525   end.
     3526   else do:
     3527     assign
     3528     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3529     p-num-recs = trunc(p-num-recs, 0)
     3530     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3531     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3532     .
     3533     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3534     then
     3535     assign
     3536     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3537     p-rec-no = p-num-recs modulo 2340
     3538     .
     3539     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3540     then
     3541     assign
     3542     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3543     p-rec-no = p-num-recs modulo 2340
     3544     .
     3545     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3546     then
     3547     assign
     3548     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3549     p-rec-no2 = p-num-recs2 modulo 2978
     3550     .
     3551     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3552     then
     3553     assign
     3554     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3555     p-rec-no2 = p-num-recs2 modulo 2978
     3556     .
     3557     assign
     3558     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3559     .
     3560   end.
     3561   if v-obj-num = 0 then v-obj-num = 100.
     3562   return v-obj-num.
     3563   END FUNCTION.
     3564   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3565   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3566   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3567      if p-is-ptrl then
     3568      return integer(entry(1, '26,27,28,29':U)).
     3569      if not p-is-ptrl then
     3570      return integer(entry(1, '16':U)).
     3571   end.
     3572   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3573   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3574   return 0.
     3575   END FUNCTION.
     3576   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3577   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3578   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3579     if p-is-ptrl then
     3580     return integer(entry(1, '26,27,28,29':U)).
     3581     if not p-is-ptrl then
     3582     return integer(entry(1, '16':U)).
     3583   end.
     3584   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3585   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3586   return 0.
     3587   END FUNCTION.
     3588   PROCEDURE maria-put:
     3589   define parameter buffer buf_cash-desk for ub.cash-desk.
     3590   define input parameter p-out    as character no-undo .
     3591   define input parameter p-fname as character no-undo .
     3592   define input parameter p-by-record as logical no-undo .
     3593   define input parameter p-shift-fields as integer no-undo .
     3594   define input parameter p-binary as logical no-undo .
     3595   define input parameter p-obj-num as integer no-undo .
     3596   define input parameter p-max-records as integer no-undo .
     3597   define input parameter p-plu as integer no-undo .
     3598   define input parameter p-value as character no-undo .
     3599   define variable v-file-name as character no-undo .
     3600   define variable v-create as logical no-undo .
     3601   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3602   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3603   output stream IBMSTREAM
     3604   to value(v-file-name) append .
     3605   Put  stream IBMSTREAM unformatted
     3606   p-plu
     3607   chr(3)
     3608   p-value
     3609   skip.
     3610   output stream IBMSTREAM
     3611   close.
     3612   if not p-by-record then do:
     3613     find first buf_temp-tekka-tsk where
     3614               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3615     if not available buf_temp-tekka-tsk then do:
     3616       v-create = yes.
     3617     end.
     3618   end.
     3619   else do:
     3620     find first buf_temp-tekka-tsk where
     3621               buf_temp-tekka-tsk.filename  = v-file-name
     3622           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3623     if not available buf_temp-tekka-tsk
     3624     then do:
     3625       find first buf_temp-tekka-tsk where
     3626                 buf_temp-tekka-tsk.filename  = v-file-name
     3627             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3628       if not available buf_temp-tekka-tsk
     3629       then do:
     3630         v-create = yes.
     3631       end.
     3632     end.
     3633   end.
     3634   if v-create then do:
     3635     create buf_temp-tekka-tsk.
     3636     assign
     3637     buf_temp-tekka-tsk.filename = v-file-name
     3638     buf_temp-tekka-tsk.range    = p-plu
     3639     buf_temp-tekka-tsk.obj-num = p-obj-num
     3640     buf_temp-tekka-tsk.obj-name = '':U
     3641     buf_temp-tekka-tsk.num-records = 0
     3642     buf_temp-tekka-tsk.max-records = p-max-records
     3643     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3644     buf_temp-tekka-tsk.task-num = p-fname
     3645     buf_temp-tekka-tsk.by-record = p-by-record
     3646     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3647     buf_temp-tekka-tsk.binary = p-binary
     3648     buf_temp-tekka-tsk.send-get = 'send'
     3649     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3650     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3651     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3652     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3653                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3654                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3655                                 then 'local'
     3656                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3657     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3658     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3659     buf_temp-tekka-tsk.waiting-sek = 30
     3660     buf_temp-tekka-tsk.min-plu     = p-plu
     3661     buf_temp-tekka-tsk.max-plu     = p-plu
     3662     .
     3663   end.
     3664   assign
     3665   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3666   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3667   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3668   .
     3669   END PROCEDURE.
     3670   PROCEDURE maria-get:
     3671   define parameter buffer buf_cash-desk for ub.cash-desk.
     3672   define input parameter p-out    as character no-undo .
     3673   define input parameter p-fname as character no-undo .
     3674   define input parameter p-by-record as logical no-undo .
     3675   define input parameter p-obj-num as integer no-undo .
     3676   define input parameter p-num-fields as integer no-undo .
     3677   define input parameter p-max-records as integer no-undo .
     3678   define input parameter p-min-plu as integer no-undo .
     3679   define input parameter p-max-plu as integer no-undo .
     3680   define input parameter p-other as character no-undo .
     3681   define input parameter p-order-num as integer no-undo .
     3682   define variable v-file-name as character no-undo .
     3683   define variable v-secondary-obj-num as character no-undo .
     3684   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3685   if p-by-record then do:
     3686     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3687   end.
     3688   else do:
     3689     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3690   end.
     3691   find first buf_temp-tekka-tsk where
     3692             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3693   if not available buf_temp-tekka-tsk then do:
     3694     create buf_temp-tekka-tsk.
     3695     assign
     3696     buf_temp-tekka-tsk.filename = v-file-name
     3697     buf_temp-tekka-tsk.obj-num = p-obj-num
     3698     buf_temp-tekka-tsk.obj-name = '':U
     3699     buf_temp-tekka-tsk.max-records = p-max-records
     3700     buf_temp-tekka-tsk.num-fields = p-num-fields
     3701     buf_temp-tekka-tsk.task-num = p-fname
     3702     buf_temp-tekka-tsk.by-record = p-by-record
     3703     buf_temp-tekka-tsk.send-get = 'get'
     3704     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3705     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3706     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3707     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3708                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3709                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3710                                   then 'local'
     3711                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3712     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3713     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3714     buf_temp-tekka-tsk.waiting-sek = 30
     3715     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3716     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3717     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3718                                       and p-max-plu <> ?
     3719                                       then p-max-plu - p-min-plu + 1
     3720                                       else 0)
     3721     buf_temp-tekka-tsk.other-info = p-other
     3722     buf_temp-tekka-tsk.order-num = p-order-num
     3723     .
     3724     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3725       assign
     3726       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3727       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3728       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3729       no-error
     3730       .
     3731       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3732     end.
     3733   end.
     3734   END PROCEDURE.
     3735   PROCEDURE maria-task:
     3736   define parameter buffer buf_cash-desk for ub.cash-desk.
     3737   define input parameter p-fname as character no-undo .
     3738   define input parameter p-obj-num-list as character no-undo .
     3739   define input parameter p-parameters as character no-undo .
     3740   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3741   find first buf_temp-tekka-tsk where
     3742             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3743   if not available buf_temp-tekka-tsk then do:
     3744     create buf_temp-tekka-tsk.
     3745     assign
     3746     buf_temp-tekka-tsk.filename = ''
     3747     buf_temp-tekka-tsk.range = 1
     3748     buf_temp-tekka-tsk.obj-num = 0
     3749     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3750     buf_temp-tekka-tsk.task-num = p-fname
     3751     buf_temp-tekka-tsk.by-record = no
     3752     buf_temp-tekka-tsk.send-get = 'task'
     3753     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3754     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3755     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3756     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3757                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3758                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3759                                   then 'local'
     3760                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3761     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3762     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3763     buf_temp-tekka-tsk.waiting-sek = 30
     3764     buf_temp-tekka-tsk.other-info = p-parameters
     3765     buf_temp-tekka-tsk.order-num = 0
     3766     .
     3767   end.
     3768   END PROCEDURE.
     3769   procedure tekkatsk-verify-schema :
     3770   define input parameter p-obj-list as character no-undo .
     3771   define input parameter p-dir-path as character no-undo .
     3772   define variable v-obj-num as integer no-undo .
     3773   define variable v-obj-name as character no-undo .
     3774   define variable v-num-records as integer no-undo .
     3775   define variable v-size_ as integer no-undo .
     3776   define variable v-value as character no-undo .
     3777   define variable ii as integer no-undo .
     3778   define variable jj as integer no-undo .
     3779   define variable ii-ibs as integer no-undo .
     3780   define variable ii-tekka as integer no-undo .
     3781   define variable v-result as character no-undo .
     3782   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3783   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3784     do
     3785     on error undo, return error
     3786     :
     3787        for each buf_temp-tekka-schema:
     3788          delete buf_temp-tekka-schema.
     3789        end.
     3790        input from value('tekkasch.d').
     3791        repeat :
     3792          create buf_temp-tekka-schema.
     3793          import buf_temp-tekka-schema.
     3794          assign
     3795          buf_temp-tekka-schema.host = 'IBS'
     3796          ii = ii + 1.
     3797          .
     3798        end.
     3799        input close.
     3800        ii-ibs = ii.
     3801         _ii:
     3802         do ii = 1 to 256:
     3803           if p-obj-list = "ALL"
     3804           or lookup(string(ii), p-obj-list) > 0 then do:
     3805             assign
     3806             v-obj-num = 0
     3807             v-obj-name = ''
     3808             v-num-records = 0
     3809             v-size_ = 0
     3810             .
     3811             run alienini-getkey in this-procedure (
     3812                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3813                                                     ,input ('obj' + string(ii, '999'))
     3814                                                     ,input 'oname'
     3815                                                     ,output v-value) no-error .
     3816             if v-value = ? then next _ii.
     3817             assign
     3818             v-obj-num = ii
     3819             v-obj-name = v-value
     3820             .
     3821             run alienini-getkey in this-procedure (
     3822                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3823                                                     ,input ('obj' + string(ii, '999'))
     3824                                                     ,input 'size'
     3825                                                     ,output v-value) no-error .
     3826             assign
     3827             v-num-records = integer(v-value) no-error  .
     3828             if error-status:error
     3829             or v-num-records = 0 then next _ii.
     3830             run alienini-getkey in this-procedure (
     3831                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3832                                                     ,input 'obj' + string(ii, '999')
     3833                                                     ,input 'f000'
     3834                                                     ,output v-value) no-error .
     3835             assign
     3836             v-size_ = integer(v-value) no-error  .
     3837             if error-status:error
     3838             or v-size_ = 0 then next _ii.
     3839             _jj:
     3840             do jj = 1 to 256:
     3841               run alienini-getkey in this-procedure (
     3842                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3843                                                       ,input 'obj' + string(ii, '999')
     3844                                                       ,input 'f' + string(jj, '999')
     3845                                                       ,output v-value) no-error .
     3846               if v-value = ? then next _ii.
     3847               create buf_temp-tekka-schema.
     3848               assign
     3849               buf_temp-tekka-schema.host = 'tekka'
     3850               buf_temp-tekka-schema.obj-num = v-obj-num
     3851               buf_temp-tekka-schema.obj-name = v-obj-name
     3852               buf_temp-tekka-schema.num-records = v-num-records
     3853               buf_temp-tekka-schema.size_ = v-size_
     3854               buf_temp-tekka-schema.field-num = jj
     3855               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3856               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3857                                                  then entry(2, entry(2, v-value, '#'), ':')
     3858                                                  else '':U)
     3859               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3860               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3861               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3862                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3863               no-error
     3864               .
     3865               if error-status:error then do:
     3866                 delete buf_temp-tekka-schema.
     3867                 next _jj.
     3868               end.
     3869               run alienini-getkey in this-procedure (
     3870                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3871                                                       ,input 'obj' + string(ii, '999') + 'name'
     3872                                                       ,input 'n' + string(jj, '999')
     3873                                                       ,output v-value) no-error .
     3874               if v-value <> ? then
     3875               buf_temp-tekka-schema.field-name = v-value.
     3876             end.
     3877           end.
     3878         end.
     3879         ii-tekka = ii - 1.
     3880        if p-obj-list <> 'ALL' then do:
     3881         if ii-tekka <> ii-ibs then do:
     3882           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3883                                   , ii-ibs
     3884                                   , ii-tekka).
     3885         end.
     3886        end.
     3887        for each buf_temp-tekka-schema where
     3888               buf_temp-tekka-schema.host = 'tekka':
     3889          find first buf2_temp-tekka-schema where
     3890                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3891                AND buf2_temp-tekka-schema.host = 'ibs'
     3892                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3893          if not available buf2_temp-tekka-schema then do:
     3894           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3895                                   , buf_temp-tekka-schema.field-num
     3896                                   , buf_temp-tekka-schema.obj-num).
     3897          end.
     3898          buffer-compare buf_temp-tekka-schema
     3899          to buf2_temp-tekka-schema
     3900          save result in v-result.
     3901          if v-result <> '':U then do:
     3902           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3903                                   , buf_temp-tekka-schema.field-num
     3904                                   , buf_temp-tekka-schema.obj-num).
     3905          end.
     3906        end.
     3907     end.
     3908   end procedure.
     3909   FUNCTION set-Sx returns character (input p-string as character):
     3910   return p-string.
     3911   END FUNCTION.
     3912   FUNCTION get-Sx returns character (input p-string  as character):
     3913   return p-string.
     3914   END FUNCTION.
     3915   FUNCTION set-B returns character (input p-string  as character):
     3916   return chr(integer(p-string)).
     3917   END FUNCTION.
     3918   FUNCTION get-B returns character (input p-string  as character):
     3919   return string(asc(p-string)).
     3920   END FUNCTION.
     3921   FUNCTION set-BF returns character (input p-string  as character):
     3922   define variable v-dopi as integer no-undo .
     3923   define variable ii as integer no-undo .
     3924   do ii = 1 to 8:
     3925     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3926   end.
     3927   return chr(v-dopi).
     3928   END FUNCTION.
     3929   FUNCTION get-BF returns character (input p-string  as character):
     3930   define variable v-dopi as integer no-undo .
     3931   define variable v-dops as character no-undo .
     3932   define variable ii as integer no-undo .
     3933   v-dopi = asc(p-string).
     3934   do ii = 8 to 1 BY -1:
     3935     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3936   end.
     3937   return v-dops.
     3938   END FUNCTION.
     3939   FUNCTION set-BN returns character (input p-string  as character
     3940                                     ,input p-bin-group as character):
     3941   define variable v-dopi as integer no-undo .
     3942   define variable ii as integer no-undo .
     3943   define variable jj as integer no-undo .
     3944   define variable v-grp-nums as integer no-undo .
     3945   define variable v-dopi2 as integer no-undo .
     3946   v-grp-nums = num-entries(p-bin-group).
     3947   do jj = 0 to v-grp-nums - 1:
     3948     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3949     do ii = 1 to 8:
     3950       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3951     end.
     3952   end.
     3953   return chr(v-dopi).
     3954   END FUNCTION.
     3955   FUNCTION get-BN returns character (input p-string  as character
     3956                                     ,input p-bin-group as character):
     3957   define variable v-dopi as integer no-undo .
     3958   define variable v-dops as character no-undo .
     3959   define variable v-grp-nums as integer no-undo .
     3960   define variable ii as integer no-undo .
     3961   define variable jj as integer no-undo .
     3962   v-dopi = asc(p-string).
     3963   v-grp-nums = num-entries(p-bin-group).
     3964   do jj = 1 to v-grp-nums:
     3965   do ii = 8 to 1 BY -1:
     3966     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3967   end.
     3968   end.
     3969   return v-dops.
     3970   END FUNCTION.
     3971   procedure fill-temp-cd :
     3972   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3973   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3974   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3975   define input parameter p-clear-table as logical no-undo .
     3976   define buffer buf_temp-cd for temp-cd.
     3977   define buffer buf_cash-desk for ub.cash-desk.
     3978     do
     3979     on error undo, return error
     3980     :
     3981        if p-clear-table  then do:
     3982          for each buf_temp-cd:
     3983            delete buf_temp-cd.
     3984          end.
     3985        end.
     3986        for each buf_cash-desk no-lock where
     3987               buf_cash-desk.db-num = p-db-num
     3988           AND buf_cash-desk.obj-code = p-obj-code
     3989           and buf_cash-desk.cash-on  = yes
     3990        BREAK by buf_cash-desk.pos-type:
     3991          if first-of(buf_cash-desk.pos-type) then do:
     3992            create buf_temp-cd.
     3993            buffer-copy buf_cash-desk to buf_temp-cd.
     3994          end.
     3995        end.
     3996     end.
     3997   end procedure.
     3998   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3999   FUNCTION name-2cdf returns character
     4000                      (  input p-name-2cd as character
     4001                       , input p-mode as logical
     4002                       , input p-cod-pcod as logical
     4003                       , input p-b-code  as integer
     4004                       , input p-gds-code as integer
     4005                       , input p-artic   as character
     4006                       , input p-engl-name  as character
     4007                       , input p-in-code as character
     4008                       , input p-part-code as character
     4009                       , input p-obj-type as character
     4010                       , input p-obj-code as integer
     4011                       , input p-alpha1 as character
     4012                       , output p-gtd as character
     4013                       ) :
     4014   define variable v-name-2cd as character no-undo .
     4015   define variable v-dop-alt-name as character no-undo.
     4016   define variable v-type as character no-undo.
     4017   define buffer buf_parts for ub.parts.
     4018   define buffer buf_code for ub.code.
     4019   if not p-mode and p-name-2cd = "PLU":U then do:
     4020     return "PLU кассы":U.
     4021   end.
     4022   if not p-mode then do:
     4023     if p-name-2cd <> "GTD":U
     4024     and  p-name-2cd <> "alpha1|gtd":U
     4025     then do:
     4026     assign
     4027     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4028   end.
     4029   end.
     4030   if p-part-code = "":U or p-cod-pcod = no then do:
     4031     run gdsoattr-value in this-procedure (
     4032       'dt-seasons':U,
     4033       p-gds-code,
     4034       p-obj-type,
     4035       p-obj-code,
     4036       output v-dop-alt-name,
     4037       output v-type
     4038     ) no-error.
     4039     if v-dop-alt-name <> "" then do:
     4040       find first buf_code where
     4041                  buf_code.parent = "DTSeasons"
     4042              and buf_code.code   = v-dop-alt-name
     4043            no-lock no-error.
     4044       if available buf_code then
     4045         assign
     4046           p-engl-name = ""
     4047           v-dop-alt-name =  buf_code.misc1
     4048         .
     4049     end.
     4050     else do:
     4051       run gdsoattr-value in this-procedure
     4052                           ( input  'dop-alt-name-o':U
     4053                            ,input  p-gds-code
     4054                            ,input  p-obj-type
     4055                            ,input  p-obj-code
     4056                            ,output v-dop-alt-name
     4057                            ,output v-type
     4058                           ) no-error .
     4059     end.
     4060     CASE p-name-2cd:
     4061       when "name" then do:
     4062         if p-mode then return p-engl-name + v-dop-alt-name.
     4063         return "Англ. название".
     4064       end.
     4065       when "code":U then do:
     4066         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4067         return "Лок. код товара"  .
     4068       end.
     4069       when "GTD":U
     4070       or
     4071       when "name-GTD":U
     4072       or
     4073       when "code-GTD":U
     4074       or
     4075       when "alpha1|gtd":U
     4076       or
     4077       when "name-alpha1|gtd":U
     4078       or
     4079       when "code-alpha1|gtd":U
     4080       then do:
     4081         if p-mode then do:
     4082           run gdcstcod_cst-code  in this-procedure (
     4083                                                       input  p-obj-type
     4084                                                       ,input  p-obj-code
     4085                                                       ,input  p-gds-code
     4086                                                       ,input  p-in-code
     4087                                                       ,input  p-part-code
     4088                                                       ,output p-gtd
     4089                                                       ) no-error .
     4090         end.
     4091         if p-name-2cd = "name-gtd":U then do:
     4092           if p-mode then return p-engl-name  + v-dop-alt-name.
     4093           return "Англ. название".
     4094         end.
     4095         if p-name-2cd = "name-alpha1|gtd":U then do:
     4096           if p-mode then return p-engl-name  + v-dop-alt-name.
     4097           return "Англ. название".
     4098         end.
     4099         if p-name-2cd = "code-GTD":U then do:
     4100           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4101           return "Лок. код товара"  .
     4102         end.
     4103         if p-name-2cd = "code-alpha1|gtd":U then do:
     4104           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4105           return "Лок. код товара"  .
     4106         end.
     4107         if p-mode then do:
     4108           if p-name-2cd = "GTD" then  return p-gtd.
     4109           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4110         end.
     4111         if p-name-2cd = "GTD" then  return "Код ГТД".
     4112         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4113       end.
     4114     END CASE.
     4115   end.
     4116   else do:
     4117     if p-name-2cd = "name-gtd":U
     4118     or p-name-2cd = "code-GTD":U
     4119     or p-name-2cd = "name-alpha1|GTD":U
     4120     or p-name-2cd = "code-alpha1|GTD":U
     4121     or p-name-2cd = "alpha1|GTD":U
     4122     then do:
     4123       if p-mode then do:
     4124         run gdcstcod_cst-code  in this-procedure (
     4125                                                      input  p-obj-type
     4126                                                     ,input  p-obj-code
     4127                                                     ,input  p-gds-code
     4128                                                     ,input  p-in-code
     4129                                                     ,input  p-part-code
     4130                                                     ,output p-gtd
     4131                                                     ) no-error .
     4132       end.
     4133       else do:
     4134         if p-name-2cd = "gtd":U then
     4135         p-gtd = "Код ГТД".
     4136         if p-name-2cd = "alpha1|Gtd":U then
     4137         p-gtd = "Страна|Код ГТД".
     4138       end.
     4139     end.
     4140     if p-mode then  return p-part-code.
     4141     return "Код партии".
     4142   end.
     4143   END FUNCTION.
     4144   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4145                                            ,input p-nam-2str as logical
     4146                                            ,input p-nam-artc as logical
     4147                                            ,input p-unit-cli-type as character
     4148                                            ,input p-unit-base as character
     4149                                            ,input p-unit-cli as character
     4150                                            ,input p-cli-base-rate as decimal
     4151                                            ,input p-artic as character
     4152                                            ,input p-f-name as character
     4153                                            ,input p-gds-name as character
     4154                                            ,input p-gds-name1 as character
     4155                                            ,output p-second-name as character):
     4156   define variable v-length as integer no-undo .
     4157   define variable nam-2str-shift as integer no-undo .
     4158   define variable chk_name as character no-undo .
     4159   assign
     4160   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4161   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4162   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4163               then 5
     4164               else v-length)
     4165   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4166   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4167   .
     4168   if p-nam-artc then do:
     4169     assign
     4170     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4171       .
     4172   end.
     4173   else  do:
     4174     assign
     4175     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4176     .
     4177   end.
     4178   if p-unit-base <> p-unit-cli then do:
     4179     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4180     assign
     4181     chk_name = string(substr(chk_name
     4182                               ,1
     4183                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4184                       "*":U +
     4185                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4186   end.
     4187   else do:
     4188     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4189   end.
     4190   if p-nam-2str then do:
     4191     assign
     4192     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4193     chk_name = substr(chk_name, 1, v-length)
     4194     .
     4195   end.
     4196   else do:
     4197     assign
     4198     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4199     p-second-name =   (chr(34) +
     4200                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4201                       + chr(34) )
     4202     .
     4203   end.
     4204   return chk_name.
     4205   end function.
     4206   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4207   procedure disrules-get-interface-form :
     4208   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4209   define output parameter p-form-name as character no-undo .
     4210   define buffer buf_temp-drt-prop for temp-drt-prop.
     4211   define buffer buf_drt-prop for ub.drt-prop.
     4212   find first buf_temp-drt-prop where
     4213             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4214         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4215         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4216   if not available buf_temp-drt-prop then do:
     4217     find first buf_drt-prop where
     4218               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4219           and buf_drt-prop.upper-prop-code = "InputForm"
     4220           and buf_drt-prop.prop-code = "FormName" no-error.
     4221     if available buf_drt-prop then do:
     4222       p-form-name = buf_drt-prop.property-value.
     4223     end.
     4224     else do:
     4225       p-form-name = "ref/dis-ruli.w".
     4226     end.
     4227   end.
     4228   else do:
     4229     p-form-name = buf_temp-drt-prop.property-value.
     4230   end.
     4231   end procedure.
