    11398           end.
    11399           find first bb_goods where bb_goods.gds-code = cash-gds.gds-code no-lock no-error .
    11400           run bgelib-tag-put in this-procedure ( input 3, input "IMarkVolume" , input string(bb_goods.ms-base), input 1 ).
