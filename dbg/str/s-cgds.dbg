      147   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   def new shared var bc-frmt as character no-undo .
      149   def new shared var bc-pfx  as character no-undo .
      150   def var bc-par-type as character no-undo .
      151       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      152       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      153           do:
      154               message "Не задан или не верно задан ТИП собственного бар-кода!"
      155                   view-as alert-box ERROR TITLE "".
      156               return error.
      157           end.
      158       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      159       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      160           do:
      161               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      162                   view-as alert-box ERROR TITLE "".
      163               return error.
      164           end.
      165   PROCEDURE gen-bc:
      166     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      167     def output parameter full-b-code     as character init ""    no-undo .
      168   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169     define variable tmp-str5  as character no-undo.
      170     define variable tmp-num5  as character no-undo.
      171     define variable i5        as integer   no-undo.
      172     define variable sum5      as integer   no-undo.
      173     define variable len-code5 as integer   no-undo.
      174     define variable varcont5  as logical   initial yes no-undo.
      175     CASE bc-frmt :
      176       WHEN "EAN13" THEN do:
      177         assign
      178           tmp-str5 = string( internal-b-code, "999999999999" )
      179         .
      180       end.
      181       WHEN "EAN8" THEN do:
      182         assign
      183           tmp-str5 = string( internal-b-code, "9999999" )
      184         .
      185       end.
      186       OTHERWISE DO:
      187           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      188           view-as alert-box error.
      189           return error.
      190       END.
      191     END CASE.
      192     if varcont5 = yes then do:
      193       if integer( substring( tmp-str5, 1, length( bc-pfx ) ) ) <> 0
      194       then do:
      195         message
      196           "Невозможно сформировать бар-код" SKIP
      197           "для товара с кодом: " internal-b-code
      198           view-as alert-box error title "подрезание кода".
      199         return error.
      200       end.
      201       else do:
      202         assign
      203           full-b-code = bc-pfx + substring( tmp-str5, length( bc-pfx ) + 1, length( tmp-str5 ) - length( bc-pfx ) )
      204           len-code5    = length( full-b-code )
      205         .
      206         define variable v-sum-char5 as character no-undo .
      207         assign
      208           sum5 = 0
      209         .
      210         do i5 = 1 to len-code5 by 2
      211         :
      212           assign
      213             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      214           .
      215           if v-sum-char5 < "0"
      216           or v-sum-char5 > "9"
      217           then do:
      218             message
      219               "Невозможно сформировать бар-код" skip
      220               "для товара с кодом: " internal-b-code skip
      221               view-as alert-box error title "подсчет контрольной суммы".
      222             return error.
      223           end.
      224           assign
      225             sum5 = sum5 + integer(v-sum-char5)
      226           .
      227         end.
      228         if varcont5 = yes then do:
      229           assign
      230             sum5 = sum5 * 3
      231           .
      232           do i5 = 2 to len-code5 by 2
      233           :
      234             assign
      235               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      236             .
      237             if v-sum-char5 < "0"
      238             or v-sum-char5 > "9"
      239             then do:
      240               message
      241                 "Невозможно сформировать бар-код" skip
      242                 "для товара с кодом: " internal-b-code skip
      243                 view-as alert-box error title "подсчет контрольной суммы".
      244               return error.
      245             end.
      246             assign
      247               sum5 = sum5 + integer(v-sum-char5)
      248             .
      249           end.
      250           if varcont5 = yes then do:
      251              if sum5 mod 10 = 0 then do:
      252                assign
      253                  full-b-code = full-b-code + '0'
      254                .
      255              end.
      256              else do:
      257                assign
      258                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      259                .
      260              end.
      261           end.
      262         end.
      263       end.
      264     end.
      265   END PROCEDURE.
