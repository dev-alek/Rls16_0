     1876   define stream stmXMLLog.
     1877   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   procedure cur-time :
     1879      define output parameter p-today as date      no-undo .
     1880      define output parameter p-time  as integer   no-undo .
     1881     do
     1882     on error undo, return error
     1883     :
     1884       define variable v-date1 as date      no-undo .
     1885       define variable v-date2 as date      no-undo .
     1886       define variable v-time  as integer   no-undo .
     1887       assign
     1888         v-date1 = today
     1889         v-time  = time
     1890         v-date2 = today
     1891       .
     1892       if v-date1 <> v-date2
     1893       then do:
     1894         assign
     1895           v-date1 = today
     1896           v-time  = v-time
     1897         .
     1898       end.
     1899       assign
     1900         p-today = v-date1
     1901         p-time  = v-time
     1902       .
     1903     end.
     1904   end.
     1905   function cur-time-date returns character
     1906   :
     1907     return string(today, '99/99/9999':U) .
     1908   end.
     1909   function cur-time-mjd returns decimal
     1910   :
     1911     define variable v-date as date      no-undo .
     1912     define variable v-time as integer   no-undo .
     1913     run cur-time in this-procedure
     1914       (output v-date
     1915       ,output v-time
     1916       ) .
     1917     return integer(v-date) - 2400002 + (v-time / 86400) .
     1918   end.
     1919   function cur-time-get-ending-index returns integer
     1920   (input p-number as integer
     1921   )
     1922   :
     1923     if p-number < 0
     1924     or p-number = ?
     1925     then do:
     1926       return 1 .
     1927     end.
     1928     define variable v-rest as integer   no-undo .
     1929     assign
     1930       p-number = p-number modulo 100
     1931     .
     1932     if p-number < 20
     1933     then do:
     1934       assign
     1935         v-rest = p-number
     1936       .
     1937     end.
     1938     else do:
     1939       assign
     1940         v-rest = p-number modulo 10
     1941       .
     1942     end.
     1943     case v-rest :
     1944       when 1
     1945       then do:
     1946         return 2 .
     1947       end.
     1948       when 2 or
     1949       when 3 or
     1950       when 4
     1951       then do:
     1952         return 3 .
     1953       end.
     1954       otherwise do:
     1955         return 1 .
     1956       end.
     1957     end case .
     1958   end.
     1959   procedure cur-time-mjd-to-date :
     1960      define input  parameter i-mjd-diff as decimal no-undo.
     1961      define output parameter o-Date     as date    no-undo.
     1962      define output parameter o-Time     as integer no-undo.
     1963      define variable v-day-number as integer   no-undo .
     1964      if    i-mjd-diff < 0
     1965         or i-mjd-diff = ?
     1966      then do:
     1967         return "?" .
     1968      end.
     1969      assign
     1970         v-day-number = truncate(i-mjd-diff,0).
     1971         o-Date = date(v-day-number + 2400002).
     1972         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1973     .
     1974   end.
     1975   function cur-time-mjd-to-string returns character
     1976   (input p-mjd-diff as decimal
     1977   )
     1978   :
     1979     define variable v-day-number as integer   no-undo .
     1980     define variable v-seconds    as integer   no-undo .
     1981     define variable v-hour       as integer   no-undo .
     1982     define variable v-min        as integer   no-undo .
     1983     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1984     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1985     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1986     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1987     if p-mjd-diff < 0
     1988     or p-mjd-diff = ?
     1989     then do:
     1990       return "?" .
     1991     end.
     1992     assign
     1993       v-day-number = integer(truncate(p-mjd-diff,0))
     1994       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1995     .
     1996     if v-seconds > 86400
     1997     then do:
     1998       assign
     1999         v-seconds = 86400 - 1
     2000       .
     2001     end.
     2002     if v-seconds < 0
     2003     then do:
     2004       assign
     2005         v-seconds = 0
     2006       .
     2007     end.
     2008     assign
     2009       v-hour = truncate(v-seconds / 3600, 0)
     2010     .
     2011     assign
     2012       v-seconds = v-seconds modulo 3600
     2013     .
     2014     assign
     2015       v-min = truncate(v-seconds / 60, 0)
     2016     .
     2017     assign
     2018       v-seconds = v-seconds modulo 60
     2019     .
     2020     return
     2021         (if v-day-number <> 0
     2022           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2023           else ""
     2024         )
     2025       + (if v-day-number <> 0 or v-hour <> 0
     2026           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2027           else ""
     2028         )
     2029       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2030           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2031           else ""
     2032         )
     2033       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2034       .
     2035   end.
     2036   function cur-time-string returns character
     2037   :
     2038     define variable v-date as date      no-undo .
     2039     define variable v-time as integer   no-undo .
     2040     run cur-time in this-procedure
     2041       (output v-date
     2042       ,output v-time
     2043       ) .
     2044     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2045   end.
     2046   function cur-time-string-sec returns character
     2047   :
     2048     define variable v-date as date      no-undo .
     2049     define variable v-time as integer   no-undo .
     2050     run cur-time in this-procedure
     2051       (output v-date
     2052       ,output v-time
     2053       ) .
     2054     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2055   end.
     2056   function cur-time-custom  returns character
     2057   (input p-prefix as character
     2058   ,input p-date-format as character
     2059   ,input p-delimiter as character
     2060   ,input p-time-format as character
     2061   ,input p-suffix as character
     2062   )
     2063   :
     2064     define variable v-date as date      no-undo .
     2065     define variable v-time as integer   no-undo .
     2066     run cur-time in this-procedure
     2067       (output v-date
     2068       ,output v-time
     2069       ) .
     2070     return
     2071       p-prefix
     2072       + string(v-date, p-date-format)
     2073       + p-delimiter
     2074       + string(v-time, p-time-format)
     2075       + p-suffix
     2076       .
     2077   end.
     2078   function cur-time-print  returns character
     2079   :
     2080     define variable v-date as date      no-undo .
     2081     define variable v-time as integer   no-undo .
     2082     run cur-time in this-procedure
     2083       (output v-date
     2084       ,output v-time
     2085       ) .
     2086     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2087   end.
     2088   function cur-time-datetime returns datetime
     2089   :
     2090     define variable v-char as character no-undo .
     2091     define variable v-datetime as datetime no-undo .
     2092     v-char = cur-time-string().
     2093     v-datetime = datetime(v-char).
     2094     return  v-datetime.
     2095   end.
     2096   function cur-time-string-msec returns character
     2097   :
     2098     define variable v-date as datetime  no-undo .
     2099     v-date = now.
     2100     return string(v-date) .
     2101   end.
     2102   define variable vss-include-info27 as character format "X(65)" no-undo
     2103   initial "@(#)$Workfile$ $Revision$".
     2104   procedure xmlchar-test :
     2105   define input parameter p-in-string          as character        no-undo.
     2106   define output parameter p-out-string-enc    as character        no-undo.
     2107   define output parameter p-out-string-dec    as character        no-undo.
     2108   do
     2109   on error undo, return error
     2110   :
     2111          run xmlchar-encode in this-procedure
     2112       (
     2113             input p-in-string
     2114           , output p-out-string-enc
     2115       ).
     2116          run xmlchar-decode in this-procedure
     2117       (
     2118             input p-out-string-enc
     2119           , output p-out-string-dec
     2120       ).
     2121   end.
     2122   end .
     2123   procedure xmlchar-encode :
     2124   define input parameter p-in-string      as character        no-undo.
     2125   define output parameter p-out-string    as character        no-undo.
     2126       define variable v-position      as integer      no-undo.
     2127       define variable v-current-char  as character    no-undo.
     2128   do
     2129   on error undo, return error
     2130   :
     2131       assign
     2132           p-out-string = "":U
     2133       .
     2134       case p-in-string
     2135       :
     2136           when ?
     2137           then do:
     2138               assign
     2139                   p-out-string = "?":U
     2140               .
     2141           end.
     2142           when "?":U
     2143           then do:
     2144               assign
     2145                   p-out-string = "&#63;":U
     2146               .
     2147           end.
     2148           otherwise do:
     2149               do v-position = 1 to length( p-in-string )
     2150               :
     2151                   assign
     2152                       v-current-char = substring( p-in-string, v-position, 1 )
     2153                   .
     2154                   case v-current-char
     2155                   :
     2156                       when "&":U
     2157                       then do:
     2158                           assign
     2159                               p-out-string = p-out-string + "&amp;":U
     2160                           .
     2161                       end.
     2162                       when ">":U
     2163                       then do:
     2164                           assign
     2165                               p-out-string = p-out-string + "&gt;":U
     2166                           .
     2167                       end.
     2168                       when "<":U
     2169                       then do:
     2170                           assign
     2171                               p-out-string = p-out-string + "&lt;":U
     2172                           .
     2173                       end.
     2174                       when "'":U
     2175                       then do:
     2176                           assign
     2177                               p-out-string = p-out-string + "&apos;":U
     2178                           .
     2179                       end.
     2180                       when '"':U
     2181                       then do:
     2182                           assign
     2183                               p-out-string = p-out-string + "&quot;":U
     2184                           .
     2185                       end.
     2186                       when chr(1)
     2187                       then do:
     2188                           assign
     2189                               p-out-string = p-out-string + "":U
     2190                           .
     2191                       end.
     2192                       when chr(2)
     2193                       then do:
     2194                           assign
     2195                               p-out-string = p-out-string + "":U
     2196                           .
     2197                       end.
     2198                       when chr(3)
     2199                       then do:
     2200                           assign
     2201                               p-out-string = p-out-string + "":U
     2202                           .
     2203                       end.
     2204                       when chr(4)
     2205                       then do:
     2206                           assign
     2207                               p-out-string = p-out-string + "":U
     2208                           .
     2209                       end.
     2210                       when chr(5)
     2211                       then do:
     2212                           assign
     2213                               p-out-string = p-out-string + "":U
     2214                           .
     2215                       end.
     2216                       when chr(6)
     2217                       then do:
     2218                           assign
     2219                               p-out-string = p-out-string + "":U
     2220                           .
     2221                       end.
     2222                       when chr(7)
     2223                       then do:
     2224                           assign
     2225                               p-out-string = p-out-string + "":U
     2226                           .
     2227                       end.
     2228                       when chr(8)
     2229                       then do:
     2230                           assign
     2231                               p-out-string = p-out-string + "":U
     2232                           .
     2233                       end.
     2234                       when chr(9)
     2235                       then do:
     2236                           assign
     2237                               p-out-string = p-out-string + "":U
     2238                           .
     2239                       end.
     2240                       when chr(29)
     2241                       then do:
     2242                           assign
     2243                               p-out-string = p-out-string + "":U
     2244                           .
     2245                       end.
     2246                       when chr(10)
     2247                       then do:
     2248                           assign
     2249                               p-out-string = p-out-string + "&#10;":U
     2250                           .
     2251                       end.
     2252                       when chr(13)
     2253                       then do:
     2254                           assign
     2255                               p-out-string = p-out-string + "&#13;":U
     2256                           .
     2257                       end.
     2258                       otherwise do:
     2259                           assign
     2260                               p-out-string = p-out-string + v-current-char
     2261                           .
     2262                       end.
     2263                   end case.
     2264               end.
     2265           end.
     2266       end case.
     2267   end.
     2268   end .
     2269   procedure xmlchar-encode-1c :
     2270   define input parameter p-in-string      as character        no-undo.
     2271   define output parameter p-out-string    as character        no-undo.
     2272       define variable v-position      as integer      no-undo.
     2273       define variable v-current-char  as character    no-undo.
     2274   do
     2275   on error undo, return error
     2276   :
     2277       assign
     2278           p-out-string = "":U
     2279       .
     2280       case p-in-string
     2281       :
     2282           when ?
     2283           then do:
     2284               assign
     2285                   p-out-string = "?":U
     2286               .
     2287           end.
     2288           otherwise do:
     2289               do v-position = 1 to length( p-in-string )
     2290               :
     2291                   assign
     2292                       v-current-char = substring( p-in-string, v-position, 1 )
     2293                   .
     2294                   case v-current-char
     2295                   :
     2296                       when chr(1)
     2297                       then do:
     2298                           assign
     2299                               p-out-string = p-out-string + " ":U
     2300                           .
     2301                       end.
     2302                       when chr(2)
     2303                       then do:
     2304                           assign
     2305                               p-out-string = p-out-string + " ":U
     2306                           .
     2307                       end.
     2308                       when chr(3)
     2309                       then do:
     2310                           assign
     2311                               p-out-string = p-out-string + " ":U
     2312                           .
     2313                       end.
     2314                       when chr(4)
     2315                       then do:
     2316                           assign
     2317                               p-out-string = p-out-string + " ":U
     2318                           .
     2319                       end.
     2320                       when chr(5)
     2321                       then do:
     2322                           assign
     2323                               p-out-string = p-out-string + " ":U
     2324                           .
     2325                       end.
     2326                       when chr(6)
     2327                       then do:
     2328                           assign
     2329                               p-out-string = p-out-string + " ":U
     2330                           .
     2331                       end.
     2332                       when chr(7)
     2333                       then do:
     2334                           assign
     2335                               p-out-string = p-out-string + " ":U
     2336                           .
     2337                       end.
     2338                       when chr(8)
     2339                       then do:
     2340                           assign
     2341                               p-out-string = p-out-string + " ":U
     2342                           .
     2343                       end.
     2344                       when chr(9)
     2345                       then do:
     2346                           assign
     2347                               p-out-string = p-out-string + " ":U
     2348                           .
     2349                       end.
     2350                       when chr(29)
     2351                       then do:
     2352                           assign
     2353                               p-out-string = p-out-string + " ":U
     2354                           .
     2355                       end.
     2356                       when chr(10)
     2357                       then do:
     2358                           assign
     2359                               p-out-string = p-out-string + " ":U
     2360                           .
     2361                       end.
     2362                       when chr(13)
     2363                       then do:
     2364                           assign
     2365                               p-out-string = p-out-string + " ":U
     2366                           .
     2367                       end.
     2368                       otherwise do:
     2369                           assign
     2370                               p-out-string = p-out-string + v-current-char
     2371                           .
     2372                       end.
     2373                   end case.
     2374               end.
     2375           end.
     2376       end case.
     2377   end.
     2378   end .
     2379   procedure xmlchar-decode :
     2380   define input parameter p-in-string      as character        no-undo.
     2381   define output parameter p-out-string    as character        no-undo.
     2382       define variable v-position      as integer      no-undo.
     2383       define variable v-last-position as integer      no-undo.
     2384       define variable v-temp-integer  as integer      no-undo.
     2385       define variable v-current-char  as character    no-undo.
     2386       define variable v-next-char     as character    no-undo.
     2387       define variable v-success       as logical      no-undo.
     2388   do
     2389   on error undo, return error
     2390   :
     2391       assign
     2392           p-out-string = "":U
     2393           v-position   = 0
     2394       .
     2395       replace-cycle:
     2396       do while yes
     2397       on error undo, return error
     2398       :
     2399           assign
     2400               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2401           .
     2402           if v-last-position <= v-position
     2403           then do:
     2404               if v-position = 0
     2405               then do:
     2406                   assign
     2407                       p-out-string = p-in-string
     2408                   .
     2409               end.
     2410               else do:
     2411                   assign
     2412                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2413                   .
     2414               end.
     2415               leave replace-cycle.
     2416           end.
     2417           else do:
     2418               assign
     2419                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2420                   v-position      = v-last-position
     2421                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2422               .
     2423               if v-current-char = "#":U
     2424               then do:
     2425                   assign
     2426                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2427                   .
     2428                   if v-last-position > 0
     2429                   then do:
     2430                       run xmlchar-read-integer in this-procedure
     2431                        (
     2432                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2433                           , output v-temp-integer
     2434                           , output v-success
     2435                       ).
     2436                       if v-success = yes
     2437                       and v-temp-integer >= 1
     2438                       and v-temp-integer <= 255
     2439                       then do:
     2440                           assign
     2441                               p-out-string = p-out-string + chr( v-temp-integer )
     2442                               v-position   = v-last-position + 1
     2443                           .
     2444                       end.
     2445                       else do:
     2446                           assign
     2447                               p-out-string = p-out-string + "&":U
     2448                               v-position   = v-position   + 1
     2449                           .
     2450                       end.
     2451                   end.
     2452                   else do:
     2453                       assign
     2454                           p-out-string = p-out-string + "&":U
     2455                           v-position   = v-position   + 1
     2456                       .
     2457                   end.
     2458               end.
     2459               else do:
     2460                   case substring( p-in-string, v-position + 1, 3 )
     2461                   :
     2462                       when "lt;":U
     2463                       then do:
     2464                           assign
     2465                               p-out-string = p-out-string + "<":U
     2466                               v-position   = v-position   + 3
     2467                           .
     2468                       end.
     2469                       when "gt;":U
     2470                       then do:
     2471                           assign
     2472                               p-out-string = p-out-string + ">":U
     2473                               v-position   = v-position   + 3
     2474                           .
     2475                       end.
     2476                       otherwise do:
     2477                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2478                           then do:
     2479                               assign
     2480                                   p-out-string = p-out-string + "&":U
     2481                                   v-position   = v-position   + 4
     2482                               .
     2483                           end.
     2484                           else do:
     2485                               case substring( p-in-string, v-position + 1, 5 )
     2486                               :
     2487                                   when "quot;":U
     2488                                   then do:
     2489                                       assign
     2490                                           p-out-string = p-out-string + '"':U
     2491                                           v-position   = v-position   + 5
     2492                                       .
     2493                                   end.
     2494                                   when "apos;":U
     2495                                   then do:
     2496                                       assign
     2497                                           p-out-string = p-out-string + "'":U
     2498                                           v-position   = v-position   + 5
     2499                                       .
     2500                                   end.
     2501                                   otherwise do:
     2502                                       assign
     2503                                           p-out-string = p-out-string + "&":U
     2504                                       .
     2505                                   end.
     2506                               end case.
     2507                           end.
     2508                       end.
     2509                   end case.
     2510               end.
     2511           end.
     2512       end.
     2513   end.
     2514   end .
     2515   procedure xmlchar-read-integer :
     2516   define input parameter p-input-string      as character        no-undo.
     2517   define output parameter p-output-integer   as integer          no-undo.
     2518   define output parameter p-success       as logical          no-undo.
     2519   do
     2520   on error undo, return error
     2521   :
     2522       assign
     2523           p-output-integer = integer( p-input-string )
     2524       no-error.
     2525       if error-status :error
     2526       then do:
     2527           assign
     2528               p-success           = no
     2529               p-output-integer    = 0
     2530           .
     2531       end.
     2532       else do:
     2533           assign
     2534               p-success           = yes
     2535           .
     2536       end.
     2537   end.
     2538   end.
     2539   define variable v-bgelib-bgeclall           as logical      no-undo.
     2540   define variable v-bgelib-bgedict            as logical      no-undo.
     2541   define temp-table temp_ext-doc-type no-undo
     2542       field edt-key               as integer
     2543       field ext-doc-type          as character
     2544       field ext-doc-type-label    as character
     2545       index pi is primary unique
     2546           edt-key
     2547   .
     2548   define temp-table temp_bgelib_goods no-undo
     2549       field gds-code as integer
     2550       index pi is primary unique
     2551           gds-code
     2552   .
     2553   define temp-table temp_bgelib_clients no-undo
     2554       field obj-type as character
     2555       field obj-code as integer
     2556       index pi is primary unique
     2557           obj-type
     2558           obj-code
     2559   .
     2560   define temp-table temp_bgelib_dis-card no-undo
     2561       field d-card as character
     2562       index pi is primary unique
     2563           d-card
     2564   .
     2565   define temp-table temp_bgelib_trn-doc no-undo
     2566       field doc-code as integer
     2567   .
     2568   procedure bgelib-tag-open:
     2569   do
     2570   on error undo, return error
     2571   :
     2572   define input parameter v-tag-level  as integer      no-undo.
     2573   define input parameter v-tag-name   as character    no-undo.
     2574   define input parameter v-tag-value  as character    no-undo.
     2575       put stream stmXMLOut unformatted
     2576           chr(10)
     2577           + fill(" ", 4 * v-tag-level)
     2578           + "<" + v-tag-name
     2579           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2580           + v-tag-value + ">"
     2581       .
     2582   end.
     2583   end procedure.
     2584   procedure bgelib-tag-put:
     2585   do
     2586   on error undo, return error
     2587   :
     2588   define input parameter v-tag-level      as integer      no-undo.
     2589   define input parameter v-tag-name       as character    no-undo.
     2590   define input parameter v-tag-value      as character    no-undo.
     2591   define input parameter v-empty-mode     as integer      no-undo.
     2592       v-tag-name = trim(v-tag-name).
     2593       if  v-empty-mode = 1
     2594       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2595       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2596       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2597       then do:
     2598           run xmlchar-encode in this-procedure (
     2599                 input v-tag-value
     2600               , output v-tag-value
     2601           ).
     2602           put stream stmXMLOut unformatted
     2603               chr(10) + fill(" ", 4 * v-tag-level)
     2604                           + '<' + v-tag-name + '>'
     2605                           + v-tag-value
     2606                           + '</' + v-tag-name + '>'
     2607           .
     2608       end.
     2609   end.
     2610   end procedure.
     2611   procedure bgelib-tag-close:
     2612   do
     2613   on error undo, return error
     2614   :
     2615   define input parameter v-tag-level as integer      no-undo.
     2616   define input parameter v-tag-name  as character    no-undo.
     2617       put stream stmXMLOut unformatted
     2618           chr(10)
     2619           + fill( " ", 4 * v-tag-level)
     2620           + '</' + v-tag-name + '>'
     2621       .
     2622   end.
     2623   end procedure.
     2624   procedure bgelib-write-log:
     2625   do
     2626   on error undo, return error
     2627   :
     2628   define input parameter v-filename   as character    no-undo.
     2629   define input parameter v-log-level  as integer      no-undo.
     2630   define input parameter v-out-string as character    no-undo.
     2631       output stream stmXMLLog to value( v-filename ) append.
     2632       put stream stmXMLLog unformatted
     2633           chr(10)
     2634       .
     2635       put stream stmXMLLog unformatted
     2636           ( if v-log-level = 0
     2637             or v-out-string = "&DLine"
     2638             or v-out-string = "&Line"
     2639             then ""
     2640             else cur-time-string-sec() + " " )
     2641       .
     2642       put stream stmXMLLog unformatted
     2643           ( if v-out-string = "&Line"
     2644             then fill( "-", 80 )
     2645             else if v-out-string = "&DLine"
     2646                  then fill( "=", 80 )
     2647                  else v-out-string )
     2648       .
     2649       output stream stmXMLLog close.
     2650   end.
     2651   end procedure.
     2652   procedure bgelib-write-edt:
     2653   do
     2654   on error undo, return error
     2655   :
     2656   define input parameter v-editor-handle    as handle       no-undo.
     2657   define input parameter v-log-level        as integer      no-undo.
     2658   define input parameter v-out-string       as character    no-undo.
     2659       if valid-handle ( v-editor-handle )
     2660       then do:
     2661           v-editor-handle :move-to-eof().
     2662           v-editor-handle :insert-string( ( if v-log-level = 0
     2663                                             or v-out-string = "&DLine"
     2664                                             or v-out-string = "&Line"
     2665                                             then ""
     2666                                             else cur-time-string-sec() + " "
     2667                                         ) ).
     2668           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2669                                             then fill( "-", 80 )
     2670                                             else if v-out-string = "&DLine" then fill("=", 80)
     2671                                             else fill( " ", v-log-level) + v-out-string
     2672                                         ) ).
     2673           v-editor-handle :insert-string( chr(10) ).
     2674       end.
     2675       process events.
     2676       output to 'bgescn.txt' append.
     2677           put unformatted
     2678               chr(10)
     2679               string( ( if v-log-level = 0
     2680                         or v-out-string = "&DLine"
     2681                         or v-out-string = "&Line"
     2682                         then ""
     2683                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2684                     ) )
     2685               string( ( if v-out-string = "&Line"
     2686                         then fill( "-", 80 )
     2687                         else if v-out-string = "&DLine"
     2688                              then fill( "=", 80 )
     2689                              else fill( " ", v-log-level ) + v-out-string
     2690                     ) )
     2691           .
     2692       output close.
     2693   end.
     2694   end procedure.
     2695   procedure bgelib-show-cnt:
     2696   do
     2697   on error undo, return error
     2698   :
     2699   define input parameter v-fillin-handle     as handle   no-undo.
     2700       if valid-handle( v-fillin-handle )
     2701       then do:
     2702           assign
     2703               v-fillin-handle :visible = true
     2704           .
     2705       end.
     2706   end.
     2707   end procedure.
     2708   procedure bgelib-hide-cnt:
     2709   do
     2710   on error undo, return error
     2711   :
     2712   define input parameter v-fillin-handle     as handle   no-undo.
     2713       if valid-handle( v-fillin-handle )
     2714       then do:
     2715           assign v-fillin-handle :visible = false.
     2716       end.
     2717   end.
     2718   end procedure.
     2719   procedure bgelib-write-cnt:
     2720   do
     2721   on error undo, return error
     2722   :
     2723   define input parameter v-fillin-handle    as handle       no-undo.
     2724   define input parameter v-fillin-string    as character    no-undo.
     2725       if valid-handle( v-fillin-handle )
     2726       then do:
     2727           assign
     2728               v-fillin-handle :SCREEN-value = v-fillin-string
     2729           .
     2730       end.
     2731   end.
     2732   end procedure.
     2733   procedure bgelib-write-header:
     2734   do
     2735   on error undo, return error
     2736   :
     2737   define input parameter p-first-file     as logical      no-undo.
     2738   define input parameter p-xml-file-name  as character    no-undo.
     2739   define input parameter p-list-file-name as character    no-undo.
     2740   define input parameter p-file-number    as integer      no-undo.
     2741   define input parameter p-have-prev      as logical      no-undo.
     2742   define input parameter p-prev-filename  as character    no-undo.
     2743   define input parameter p-obj-list       as character    no-undo.
     2744   define input parameter p-doc-type-list  as character    no-undo.
     2745   define input parameter p-parameter-list as character    no-undo.
     2746       define variable v-counter    as integer        no-undo.
     2747       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2748       put stream stmXMLOut unformatted
     2749           "<?xml version='1.0' encoding='windows-1251'?>"
     2750       .
     2751       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2752       run bgelib-tag-open( input 0, input "header", input "" ).
     2753       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2754       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2755       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2756       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2757       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2758       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2759       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2760       :
     2761           run bgelib-tag-put(
     2762                 input 1
     2763               , input entry( 2 * v-counter, p-parameter-list )
     2764               , input entry( 2 * v-counter + 1, p-parameter-list )
     2765               , input 0
     2766           ).
     2767       end.
     2768       run bgelib-tag-close( input 0, input "header" ).
     2769       output stream stmXMLOut close.
     2770       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2771       if p-first-file = yes
     2772       then do:
     2773           put stream stmXMLOut unformatted
     2774               "<?xml version='1.0' encoding='windows-1251'?>"
     2775           .
     2776           run bgelib-tag-open( input 0, input "export", input "" ).
     2777       end.
     2778       run bgelib-tag-open( input 1, input "file", input "" ).
     2779       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2780       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2781       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2782       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2783       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2784       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2785       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2786       :
     2787           run bgelib-tag-put(
     2788                 input 2
     2789               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2790               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2791               , input 0
     2792           ).
     2793       end.
     2794       run bgelib-tag-close( input 1, input "file" ).
     2795       output stream stmXMLOut close.
     2796   end.
     2797   end procedure.
     2798   procedure bgelib-write-footer:
     2799   do
     2800   on error undo, return error
     2801   :
     2802   define input parameter p-last-file      as logical      no-undo.
     2803   define input parameter p-xml-file-name  as character    no-undo.
     2804   define input parameter p-list-file-name as character    no-undo.
     2805   define input parameter p-have-next      as logical      no-undo.
     2806   define input parameter p-next-file-name as character    no-undo.
     2807       define variable v-error-num     as integer           no-undo.
     2808       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2809       if p-have-next = yes
     2810       then do:
     2811           run bgelib-tag-open( input 0, input "footer", "" ).
     2812           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2813           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2814           run bgelib-tag-close( input 0, input "footer" ).
     2815       end.
     2816       run bgelib-tag-close( input 0, input "root" ).
     2817       output stream stmXMLOut close.
     2818       run bge/os_copy.p (
     2819             input "M"
     2820           , input p-xml-file-name + "tmp"
     2821           , input p-xml-file-name + "xml"
     2822           , output v-error-num
     2823       ).
     2824       if p-last-file = yes
     2825       then do:
     2826           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2827               run bgelib-tag-close( input 0, input "export" ).
     2828           output stream stmXMLOut close.
     2829           run bge/os_copy.p (
     2830                 input "M"
     2831               , input p-list-file-name + "tmp"
     2832               , input p-list-file-name + "xml"
     2833               , output v-error-num
     2834           ).
     2835       end.
     2836   end.
     2837   end procedure.
     2838   procedure bgelib-filename :
     2839   do
     2840   on error undo, return error
     2841   :
     2842   define input parameter p-prefix             as character    no-undo.
     2843   define output parameter p-xml-file-name     as character    no-undo.
     2844   define output parameter p-log-file-name     as character    no-undo.
     2845   define output parameter p-list-file-name    as character    no-undo.
     2846       define variable v-home-dir  as character    no-undo.
     2847       define variable v-error-num as integer      no-undo.
     2848       get-key-value section "BGE" key "outdir" value v-home-dir.
     2849       if v-home-dir = ?
     2850       then do:
     2851           message
     2852             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2853             skip(1)
     2854             skip "Обратитесь к администратору."
     2855           view-as alert-box error.
     2856           undo, return error .
     2857       end.
     2858       run gbl/dir-cre.p (
     2859           input v-home-dir
     2860       ) no-error.
     2861       if error-status :error
     2862       then do:
     2863           message
     2864             skip "Неверно задан каталог экспорта."
     2865             skip(1)
     2866             skip "Обратитесь к администратору."
     2867           view-as alert-box error.
     2868           undo, return error .
     2869       end.
     2870       run bge/genfname.p (
     2871             input v-home-dir
     2872           , input p-prefix
     2873           , input ""
     2874           , input "xml"
     2875           , input "tmp"
     2876           , output p-xml-file-name
     2877       ).
     2878       assign
     2879           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2880           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2881           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2882       .
     2883   end.
     2884   end procedure.
     2885   procedure bgelib-read-config :
     2886   do
     2887   on error undo, return error
     2888   :
     2889   define variable v-par-type as character     no-undo.
     2890     define variable v-param-type      as character  no-undo .
     2891     define variable v-value-character as character  no-undo .
     2892     define variable v-value-date      as date       no-undo .
     2893     define variable v-value-decimal   as decimal    no-undo .
     2894     define variable v-value-integer   as integer    no-undo .
     2895     define variable v-value-logical   as logical    no-undo .
     2896     define variable v-tth             as handle     no-undo .
     2897       assign
     2898           v-bgelib-bgeclall = no
     2899           v-bgelib-bgedict  = no
     2900       .
     2901       run adm/shattri.p ( input "get":U
     2902                         , input  '':u
     2903                         , input  0
     2904                         , input  'bge-export':U
     2905                         , input  'bgeclall':U
     2906                         , output v-value-character
     2907                         , output v-value-date
     2908                         , output v-value-decimal
     2909                         , output v-value-integer
     2910                         , output v-value-logical
     2911                         , output v-param-type
     2912                         , input-output table-handle v-tth
     2913                         ) no-error .
     2914       if error-status :error
     2915       then do:
     2916         assign
     2917           v-bgelib-bgeclall = no
     2918         .
     2919       end.
     2920       else do:
     2921         assign
     2922           v-bgelib-bgeclall = v-value-logical
     2923         .
     2924       end.
     2925       delete object v-tth.
     2926       run adm/shattri.p ( input "get":U
     2927                         , input  '':u
     2928                         , input  0
     2929                         , input  'bge-export':U
     2930                         , input  'bgedict':U
     2931                         , output v-value-character
     2932                         , output v-value-date
     2933                         , output v-value-decimal
     2934                         , output v-value-integer
     2935                         , output v-value-logical
     2936                         , output v-param-type
     2937                         , input-output table-handle v-tth
     2938                         ) no-error .
     2939       if error-status :error
     2940       then do:
     2941         assign
     2942           v-bgelib-bgedict = no
     2943         .
     2944       end.
     2945       else do:
     2946         assign
     2947           v-bgelib-bgedict = v-value-logical
     2948         .
     2949       end.
     2950       delete object v-tth.
     2951       run adm/shattri.p ( input "get":U
     2952                         , input  '':u
     2953                         , input  0
     2954                         , input  'bge-export':U
     2955                         , input  'bgefmt':U
     2956                         , output v-value-character
     2957                         , output v-value-date
     2958                         , output v-value-decimal
     2959                         , output v-value-integer
     2960                         , output v-value-logical
     2961                         , output v-param-type
     2962                         , input-output table-handle v-tth
     2963                         ) no-error .
     2964       if error-status :error
     2965       then do:
     2966         assign
     2967           v-bgelib-bgefmt  = "xml":U
     2968         .
     2969       end.
     2970       else do:
     2971         assign
     2972           v-bgelib-bgefmt  = v-value-character
     2973         .
     2974       end.
     2975       delete object v-tth.
     2976       run adm/shattri.p ( input "get":U
     2977                         , input  '':u
     2978                         , input  0
     2979                         , input  'bge-export':U
     2980                         , input  'bgeflold':U
     2981                         , output v-value-character
     2982                         , output v-value-date
     2983                         , output v-value-decimal
     2984                         , output v-value-integer
     2985                         , output v-value-logical
     2986                         , output v-param-type
     2987                         , input-output table-handle v-tth
     2988                         ) no-error .
     2989       if error-status :error
     2990       then do:
     2991         assign
     2992           v-bgelib-bgeflold  = "old":U
     2993         .
     2994       end.
     2995       else do:
     2996         assign
     2997           v-bgelib-bgeflold  = v-value-character
     2998         .
     2999       end.
     3000       delete object v-tth.
     3001   end.
     3002   end procedure.
     3003   procedure bgelib-check-file-size :
     3004   do
     3005   on error undo, return error
     3006   :
     3007   define input parameter p-out-filename   as character    no-undo.
     3008   define output parameter p-is-big        as logical      no-undo.
     3009       define variable v-current-position    as integer        no-undo.
     3010       assign
     3011           v-current-position = seek( stmXMLOut )
     3012       .
     3013       if v-current-position / 1024 / 1024  >= 100
     3014       then do:
     3015           assign
     3016               p-is-big = yes
     3017           .
     3018       end.
     3019   end.
     3020   end procedure.
     3021   procedure bgelib-init-ext-doc-type :
     3022       define variable v-counter    as integer      no-undo.
     3023       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3024   do
     3025   for buf_temp_ext-doc-type
     3026   on error undo, return error
     3027   :
     3028       empty temp-table buf_temp_ext-doc-type.
     3029       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3030       :
     3031           create buf_temp_ext-doc-type.
     3032           assign
     3033               buf_temp_ext-doc-type.edt-key               = v-counter
     3034               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3035               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3036           .
     3037       end.
     3038   end.
     3039   end procedure.
     3040   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3041   define variable v-xml-file-name     as character            no-undo.
     3042   define variable v-xml-file-name-path as character            no-undo.
     3043   define variable v-log-file-name     as character            no-undo.
     3044   define variable v-locked            as logical              no-undo.
     3045   define variable v-log-string        as character            no-undo.
     3046   define variable v-oper-num          as integer              no-undo.
     3047   define variable v-obj-list          as character            no-undo.
     3048   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
