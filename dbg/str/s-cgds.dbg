    14212                                               then 20
    14213                                               else 21)
    14214                                       , input (if integer(v-plu) <= v-20-part1
    14215                                               then 2621
    14216                                               else 2379)
    14217                                       , input v-plu
    14218                                       , input (if v-marketer-action = 'U':U
    14219                                                 then string(convert-maria-tax-code(cash-gds.vat-code, 0  , cdtaxlst), "X(8)")
    14220                                                 else '00000000':U) + chr(4) + chk_name).
