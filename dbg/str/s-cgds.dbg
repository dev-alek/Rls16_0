    10143   procedure ibm-gdsc :
    10144   define input  parameter p-zeros         as logical no-undo .
    10145   define output parameter IBM-good-code as character no-undo .
    10146   define output parameter IBM-good-code-2 as character no-undo .
    10147   define output parameter IBM2-short      as character no-undo .
    10148   define variable v-delim as character no-undo .
    10149   define variable v-format-str-16 as character no-undo .
    10150     do
    10151     on error undo, return error
    10152     :
    10153       if p-zeros then do:
    10154         assign
    10155         v-delim = '0'
    10156         v-format-str-16 =  "9999999999999999"
    10157         .
    10158       end.
    10159       else do:
    10160         assign
    10161         v-delim = chr(32)
    10162         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10163         .
    10164       end.
    10165       if cash-gds.b-str = "" then do:
    10166         assign
    10167         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10168         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10169         or cash-gds.unit-base <> cash-gds.unit-cli
    10170         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10171         then
    10172         do:
    10173           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10174               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10175             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10176             iBM2-short = bar_code.
    10177             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10178           END.
    10179           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10180               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10181             IBM-good-code-2 = b_code.
    10182           end.
    10183         end.
    10184       end.
    10185       else do:
    10186         IBm-good-code =
    10187         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10188           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10189            or
    10190            cash-gds.bc-on-type = 'pglc':U)
    10191         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10192         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10193       end.
    10194     end.
    10195   end procedure.
    10196   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10197   procedure ncr-gdsc :
    10198   define output parameter IBM-good-code as character no-undo .
    10199   define output parameter IBM-good-code-2 as character no-undo .
    10200   define output parameter is-sc as logical no-undo .
    10201   define output parameter p-taracode-bc as character no-undo .
    10202   define variable v-taracode-bc as character no-undo .
    10203   define variable v-type as character no-undo .
    10204   define variable v-bc-buf as character no-undo .
    10205   define variable iii as integer no-undo .
    10206     do
    10207     on error undo, return error
    10208     :
    10209       if cash-gds.b-str = "" then do:
    10210         assign
    10211         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
    10212         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
    10213           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10214               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10215             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10216             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
    10217           end.
    10218           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10219               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10220             IBM-good-code-2 = b_code.
    10221           end.
    10222         end.
    10223       end.
    10224       else do:
    10225         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10226         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10227                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10228                              or
    10229                              cash-gds.bc-on-type = 'pglc':U)
    10230                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10231                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10232                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10233          if action <> "D":U then do:
    10234           is-sc = no.
    10235           find first request_prod-bc no-lock where
    10236                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10237           if not avail request_prod-bc then do :
    10238             if mask_s-c <> "" then do :
    10239               iii_ :
    10240               do iii = 1 to num-entries(mask_s-c) :
    10241                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10242                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10243                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10244                   if available request_prod-bc then leave iii_ .
    10245                 end.
    10246               end.
    10247             end.
    10248           end.
    10249           if avail request_prod-bc then do :
    10250             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10251   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10252   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10253     (buffer request_prod-bc
    10254     ,input  'scaleable=request'
    10255     ,output is-sc
    10256     ) no-error .
    10257             end.
    10258             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10259                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10260                then do:
    10261   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10262     define variable tmp-str87  as character no-undo.
    10263     define variable tmp-num87  as character no-undo.
    10264     define variable i87        as integer   no-undo.
    10265     define variable sum87      as integer   no-undo.
    10266     define variable len-code87 as integer   no-undo.
    10267     define variable varcont87  as logical   initial yes no-undo.
    10268     CASE ncrsc-frmt :
    10269       WHEN "EAN13" THEN do:
    10270         assign
    10271           tmp-str87 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10272         .
    10273       end.
    10274       WHEN "EAN8" THEN do:
    10275         assign
    10276           tmp-str87 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10277         .
    10278       end.
    10279       OTHERWISE DO:
    10280           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    10281           view-as alert-box error.
    10282           return error.
    10283       END.
    10284     END CASE.
    10285     if varcont87 = yes then do:
    10286       if integer( substring( tmp-str87, 1, length( ncrsc-pfx ) ) ) <> 0
    10287       then do:
    10288         message
    10289           "Невозможно сформировать бар-код" SKIP
    10290           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10291           view-as alert-box error title "подрезание кода".
    10292         return error.
    10293       end.
    10294       else do:
    10295         assign
    10296           IBm-good-code = ncrsc-pfx + substring( tmp-str87, length( ncrsc-pfx ) + 1, length( tmp-str87 ) - length( ncrsc-pfx ) )
    10297           len-code87    = length( IBm-good-code )
    10298         .
    10299         define variable v-sum-char87 as character no-undo .
    10300         assign
    10301           sum87 = 0
    10302         .
    10303         do i87 = 1 to len-code87 by 2
    10304         :
    10305           assign
    10306             v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10307           .
    10308           if v-sum-char87 < "0"
    10309           or v-sum-char87 > "9"
    10310           then do:
    10311             message
    10312               "Невозможно сформировать бар-код" skip
    10313               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10314               view-as alert-box error title "подсчет контрольной суммы".
    10315             return error.
    10316           end.
    10317           assign
    10318             sum87 = sum87 + integer(v-sum-char87)
    10319           .
    10320         end.
    10321         if varcont87 = yes then do:
    10322           assign
    10323             sum87 = sum87 * 3
    10324           .
    10325           do i87 = 2 to len-code87 by 2
    10326           :
    10327             assign
    10328               v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10329             .
    10330             if v-sum-char87 < "0"
    10331             or v-sum-char87 > "9"
    10332             then do:
    10333               message
    10334                 "Невозможно сформировать бар-код" skip
    10335                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10336                 view-as alert-box error title "подсчет контрольной суммы".
    10337               return error.
    10338             end.
    10339             assign
    10340               sum87 = sum87 + integer(v-sum-char87)
    10341             .
    10342           end.
    10343           if varcont87 = yes then do:
    10344              if sum87 mod 10 = 0 then do:
    10345                assign
    10346                  IBm-good-code = IBm-good-code + '0'
    10347                .
    10348              end.
    10349              else do:
    10350                assign
    10351                  IBm-good-code = IBm-good-code + string(10 - sum87 mod 10)
    10352                .
    10353              end.
    10354           end.
    10355         end.
    10356       end.
    10357     end.
    10358             end.
    10359             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10360                cash-gds.bc-on-type = 'pglc':U
    10361                then do:
    10362   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10363     define variable tmp-str88  as character no-undo.
    10364     define variable tmp-num88  as character no-undo.
    10365     define variable i88        as integer   no-undo.
    10366     define variable sum88      as integer   no-undo.
    10367     define variable len-code88 as integer   no-undo.
    10368     define variable varcont88  as logical   initial yes no-undo.
    10369     CASE ncrpg-frmt :
    10370       WHEN "EAN13" THEN do:
    10371         assign
    10372           tmp-str88 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10373         .
    10374       end.
    10375       WHEN "EAN8" THEN do:
    10376         assign
    10377           tmp-str88 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10378         .
    10379       end.
    10380       OTHERWISE DO:
    10381           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrpg-frmt " ."
    10382           view-as alert-box error.
    10383           return error.
    10384       END.
    10385     END CASE.
    10386     if varcont88 = yes then do:
    10387       if integer( substring( tmp-str88, 1, length( ncrpg-pfx ) ) ) <> 0
    10388       then do:
    10389         message
    10390           "Невозможно сформировать бар-код" SKIP
    10391           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10392           view-as alert-box error title "подрезание кода".
    10393         return error.
    10394       end.
    10395       else do:
    10396         assign
    10397           IBm-good-code = ncrpg-pfx + substring( tmp-str88, length( ncrpg-pfx ) + 1, length( tmp-str88 ) - length( ncrpg-pfx ) )
    10398           len-code88    = length( IBm-good-code )
    10399         .
    10400         define variable v-sum-char88 as character no-undo .
    10401         assign
    10402           sum88 = 0
    10403         .
    10404         do i88 = 1 to len-code88 by 2
    10405         :
    10406           assign
    10407             v-sum-char88 = substr(IBm-good-code, len-code88 - i88 + 1, 1)
    10408           .
    10409           if v-sum-char88 < "0"
    10410           or v-sum-char88 > "9"
    10411           then do:
    10412             message
    10413               "Невозможно сформировать бар-код" skip
    10414               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10415               view-as alert-box error title "подсчет контрольной суммы".
    10416             return error.
    10417           end.
    10418           assign
    10419             sum88 = sum88 + integer(v-sum-char88)
    10420           .
    10421         end.
    10422         if varcont88 = yes then do:
    10423           assign
    10424             sum88 = sum88 * 3
    10425           .
    10426           do i88 = 2 to len-code88 by 2
    10427           :
    10428             assign
    10429               v-sum-char88 = substr(IBm-good-code, len-code88 - i88 + 1, 1)
    10430             .
    10431             if v-sum-char88 < "0"
    10432             or v-sum-char88 > "9"
    10433             then do:
    10434               message
    10435                 "Невозможно сформировать бар-код" skip
    10436                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10437                 view-as alert-box error title "подсчет контрольной суммы".
    10438               return error.
    10439             end.
    10440             assign
    10441               sum88 = sum88 + integer(v-sum-char88)
    10442             .
    10443           end.
    10444           if varcont88 = yes then do:
    10445              if sum88 mod 10 = 0 then do:
    10446                assign
    10447                  IBm-good-code = IBm-good-code + '0'
    10448                .
    10449              end.
    10450              else do:
    10451                assign
    10452                  IBm-good-code = IBm-good-code + string(10 - sum88 mod 10)
    10453                .
    10454              end.
    10455           end.
    10456         end.
    10457       end.
    10458     end.
    10459             end.
    10460           end.
    10461         end.
    10462       end.
    10463       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10464       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
    10465             or
    10466             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
    10467       then do:
    10468           run bc-oattr_value in this-procedure ( input cash-gds.b-code
    10469                                               ,input 'taracode-bc':U
    10470                                               ,input 'маг':U
    10471                                               ,input i-obj-code
    10472                                               ,output v-taracode-bc
    10473                                               ,output v-type) no-error.
    10474           if not error-status:error
    10475           and v-taracode-bc <> '' then do:
    10476             is-sc = yes.
    10477             p-taracode-bc = v-taracode-bc.
    10478           end.
    10479       end.
    10480     end.
    10481   end procedure.
    10482   procedure finish-send :
    10483     do
    10484     on error undo, return error
    10485     :
    10486       if p-batch then do:
    10487         if v-view-log then
    10488         run set-view-log in p-log-handle(yes).
    10489       end.
    10490       else do:
    10491   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10492   if v-view-log
    10493   and not g#news
    10494   and not g#auto
    10495   then do:
    10496     message
    10497     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10498     "!!!Внимательно прочитайте Log-file!!"
    10499     view-as alert-box error .
    10500        define variable v-user-action90   as character no-undo .
    10501     define variable v-printed90       as logical   no-undo .
    10502     run gbl/prnfilen.w
    10503       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10504       ,input  0
    10505       ,input  (string("./":U) + log-file-name)
    10506       ,input  7
    10507       ,output v-user-action90
    10508       ,output v-printed90
    10509       ) .
    10510   end.
    10511   if v-view-log = true
    10512   and (g#news
    10513   or g#auto)
    10514   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10515   then do:
    10516      run cb_set-view-log in p-parent-handle ( input yes).
    10517   end.
    10518       end.
    10519       define variable v-save-file-name as character no-undo .
    10520       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10521       OS-APPEND value(log-file-name) value(v-save-file-name).
    10522       OS-DELETE value(log-file-name).
    10523     end.
    10524   end procedure.
    10525   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
    10526   PROCEDURE putc-gds.
    10527   define parameter buffer buf_cash-desk for ub.cash-desk.
    10528   define input parameter pos-type as char no-undo.
    10529   define input parameter p-version like ub.cash-desk.version no-undo .
    10530   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    10531   define variable ff  as  int     no-undo.
    10532   define variable gg  as  int     no-undo.
    10533   DEFINE VARIABLE second-name as character no-undo.
    10534   define variable nam-2str-shift as integer no-undo .
    10535   define variable v-length as integer no-undo .
    10536   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
    10537   define variable std-disc-dec as decimal no-undo .
    10538   define variable std-disc-reason as integer no-undo .
    10539   define variable std-disc-lim as date no-undo .
    10540   define variable temp-disc-dec as decimal no-undo .
    10541   define variable temp-disc-reason as integer no-undo .
    10542   define variable temp-disc-start as date no-undo .
    10543   define variable temp-disc-end as date no-undo .
    10544   define variable temp-disc-time-start as integer no-undo .
    10545   define variable temp-disc-time-end as integer no-undo .
    10546   define variable temp-disc-weekday as integer no-undo .
    10547   define variable v-version-dec as decimal no-undo .
    10548   define variable v-kat-num as integer no-undo .
    10549   define variable v-kat-discnt as decimal no-undo .
    10550   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
    10551   define variable IBM2-short as character no-undo .
    10552   define variable v-what-find as character no-undo .
    10553   define variable v-plu as character no-undo .
    10554   define variable v-pl-code as integer no-undo .
    10555   define variable v-marketer-action as character no-undo .
    10556   define variable v-versiond as decimal no-undo .
    10557   define variable v-b-code-to-find as logical no-undo .
    10558   define variable v-maria-discnt-value as character no-undo .
    10559   define variable v-ii as integer no-undo .
    10560   define variable v-dop as character no-undo .
    10561   define variable v-gds-rule-num as integer no-undo .
    10562   define variable v-maria-rule-num as integer no-undo .
    10563   define variable v-discreteness as character no-undo .
    10564   define variable wd-option as integer no-undo .
    10565   define variable wgd-option as integer no-undo .
    10566   define variable v-type as logical   no-undo .
    10567   define variable  s as char no-undo.
    10568   define variable articul as char no-undo.
    10569   define variable v-disc-price-sale as decimal no-undo .
    10570   define variable v-pdf-id as integer no-undo .
    10571   define variable v-pdf-db-num as integer no-undo .
    10572   define buffer buf_cash-dis-rule for cash-dis-rule .
    10573   define buffer buf_cd-plu for ub.cd-plu.
    10574   define buffer buf_dis-rule for ub.dis-rule.
    10575   define buffer buf_place for ub.place.
    10576   define buffer buf_pl-gds for ub.pl-gds.
    10577   define buffer bcash-gds for cash-gds.
    10578   define buffer buf_cash-desk-attr for cash-desk-attr.
    10579   define variable vcash-desk-stndart as logical no-undo init yes.
    10580   assign
    10581   v-version-dec = decimal(p-version)
    10582   no-error .
    10583   if buf_cash-desk.autonomy = integer('2':U)
    10584   then do:
    10585      vcash-desk-stndart = no.
    10586   end.
    10587     if buf_cash-desk.device-kind = 2 then vcash-desk-stndart = no.
    10588   define variable is-petrol   as logical   no-undo.
    10589   define variable is-pieces   as logical   no-undo.
    10590   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10591     (
    10592        input cash-gds.artic
    10593     ,  input ?
    10594     ,  input cash-gds.gds-code
    10595     , output is-petrol
    10596     , output is-pieces
    10597     ) NO-ERROR.
    10598   if     not vcash-desk-stndart
    10599      and not is-petrol
    10600   then
    10601      return.
    10602   if cash-gds.std-discnt-rule > 0 then do:
    10603     find first cash-dis-rule no-lock where
    10604               cash-dis-rule.rule-num =  cash-gds.std-discnt-rule no-error .
    10605     if available cash-dis-rule then do:
    10606       find first cash-dis-time-rule no-lock where
    10607                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10608       assign
    10609       std-disc-dec = - cash-dis-rule.discnt-value
    10610       std-disc-reason = 0
    10611       no-error
    10612       .
    10613       if available cash-dis-time-rule then do:
    10614         assign
    10615         std-disc-lim = cash-dis-time-rule.date-to
    10616         .
    10617         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
    10618         assign
    10619         std-disc-dec = 0
    10620         std-disc-reason = 0
    10621         .
    10622         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10623         assign
    10624         std-disc-dec = 0
    10625         std-disc-reason = 0
    10626         .
    10627       end.
    10628     end.
    10629   end.
    10630   if cash-gds.wd > 1 then do:
    10631     find first cash-dis-rule no-lock where
    10632               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
    10633     if available cash-dis-rule then  do:
    10634       assign
    10635       wd-option = integer(cash-dis-rule.discnt-value).
    10636     end.
    10637   end.
    10638   if cash-gds.wd = 1 then do:
    10639      wd-option = 1.
    10640   end.
    10641   if cash-gds.wgd > 0 then do:
    10642     find first cash-dis-rule no-lock where
    10643               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
    10644     if available cash-dis-rule then  do:
    10645       assign
    10646       wgd-option = integer(cash-dis-rule.discnt-value).
    10647     end.
    10648   end.
    10649   if cash-gds.temp-discnt-rule <> 0 then do:
    10650     assign
    10651     temp-disc-dec = 0
    10652     .
    10653     find first cash-dis-rule no-lock where
    10654               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
    10655     if available cash-dis-rule
    10656              and cash-dis-rule.is-term = yes then do:
    10657       if cash-dis-rule.time-rule-num > 0 then do:
    10658         find first cash-dis-time-rule no-lock where
    10659                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10660         if available cash-dis-time-rule
    10661         and cash-dis-time-rule.templ-rl-root = 50001
    10662             or
    10663             (
    10664              (
    10665               (cash-dis-time-rule.date-from < today)
    10666               or
    10667               (cash-dis-time-rule.date-from = 12/31/1989)
    10668              )
    10669             and
    10670             (
    10671              (cash-dis-time-rule.date-to >= today)
    10672              or
    10673              (cash-dis-time-rule.date-to = 12/31/1989)
    10674             )
    10675            ) then do:
    10676            temp-disc-dec = ?.
    10677         end.
    10678         else do:
    10679           assign
    10680           temp-disc-dec = 0
    10681           .
    10682         end.
    10683       end.
    10684       else do:
    10685         temp-disc-dec = ?.
    10686       end.
    10687       if temp-disc-dec = ? then do:
    10688         case cash-dis-rule.value-type:
    10689           when integer('1':U) then do:
    10690         assign
    10691         temp-disc-dec = - cash-dis-rule.discnt-value
    10692         .
    10693       end.
    10694           when integer('11':U) then do:
    10695             find first cash-gds-discnt where
    10696                       cash-gds-discnt.b-code = cash-gds.b-code
    10697                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    10698                   and cash-gds-discnt.obj-type = 'маг':U
    10699                   and cash-gds-discnt.obj-code = i-obj-code
    10700                   no-error.
    10701             if available cash-gds-discnt then do:
    10702               assign
    10703               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
    10704               .
    10705             end.
    10706             else do:
    10707              assign
    10708               temp-disc-dec = 0.
    10709             end.
    10710           end.
    10711           otherwise do:
    10712             temp-disc-dec = 0.
    10713           end.
    10714         end case.
    10715       end.
    10716     end.
    10717   end.
    10718   CASE pos-type:
    10719     when 'MAGIA-XML':U
    10720     then do:
    10721       if cash-gds.b-str <> "":U then do:
    10722         return.
    10723       end.
    10724       assign
    10725       chk_name = replace(cash-gds.gds-name, chr(34), "":U) + cash-gds.f-name
    10726       .
    10727       if cash-gds.unit-base <> cash-gds.unit-cli then
    10728       assign
    10729       chk_name = string(substr(chk_name, 1, max(33, 50 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))) +
    10730                         "*":U +
    10731                         trim(string( cash-gds.cli-base-rate ), chr(32)), "x(50)":U ).
    10732       else
    10733       chk_name = string(chk_name, "X(50)":U).
    10734       assign
    10735       second-name = replace(cash-gds.gds-namelong, chr(39), "":U)
    10736       second-name =   (chr(34) +
    10737                         TRIM(CAPS(string( replace(second-name, chr(34), "":U), "X(40)":U )))
    10738                         + chr(34) )
    10739       .
    10740       if cash-gds.unit-base <> cash-gds.unit-cli then
    10741       assign
    10742       second-name = string(substr(second-name, 1, max(23, 40 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))  ) +
    10743                         "*":U +
    10744                         trim(string(cash-gds.cli-base-rate), chr(32)), "x(40)":U ).
    10745       else
    10746       second-name = string(second-name, "X(40)":U).
    10747       if tax-cass AND cash-gds.new-good then do:
    10748           for each cash-txr No-LOCK WHERE
    10749                     cash-txr.rc = cash-gds.rc AND
    10750                     cash-txr.host-code = ub.shop.host-code AND
    10751                     cash-txr.obj-type = 'маг':U AND
    10752                     cash-txr.obj-code = ub.shop.obj-code:
    10753             run putc-13(buffer buf_cash-desk
    10754                       , input pos-type
    10755                       , input p-cash-os
    10756                       , input yes
    10757                       ).
    10758           end.
    10759       end.
    10760   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10761   define variable mi-entry as integer no-undo .
    10762   define variable v-out-code like ub.fbr-gds-grp.out-code no-undo .
    10763   define variable v-out-code-0 like ub.fbr-gds-grp.out-code no-undo .
    10764   define variable v-global-code like ub.fbr-gds-grp.global-code no-undo .
    10765   define variable v-xml-vat like ub.tax-rate-value.rate-value no-undo .
    10766   define variable v-xml-slt like ub.tax-rate-value.rate-value no-undo .
    10767   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10768   define buffer buf_tax-rate for ub.tax-rate.
