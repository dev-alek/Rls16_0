    14315                           )
    14316                                           ).
    14317     assign
    14318     v-view-log = yes
    14319     .
    14320       for each temp-cd-plu:
    14321         delete temp-cd-plu.
    14322       end.
    14323     return "error":U.
    14324   end.
    14325   else do:
    14326     for each temp-cd-plu,
    14327         first buf_cd-plu where
    14328                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    14329                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    14330                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    14331                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    14332                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    14333       if temp-cd-plu.to-del = yes
    14334       and v-del-mrkt-gds
    14335       then do:
    14336         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    14337           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    14338           assign
    14339           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    14340           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    14341           .
    14342         end.
    14343         if buf_cd-plu.charkey_one = '':U then do:
    14344           delete buf_cd-plu.
    14345           NEXT.
    14346         end.
    14347       end.
    14348       if temp-cd-plu.charkey_two = "":U
    14349       then
    14350       assign
    14351       buf_cd-plu.charkey_two = "":U
    14352       buf_cd-plu.to-send = no
    14353       .
    14354       delete temp-cd-plu.
    14355     end.
    14356   end.
    14357   end.
