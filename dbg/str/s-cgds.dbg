     7007   procedure grp-obj-notcorr-value :
     7008   do
     7009   on error undo, return error
     7010   :
     7011   define input parameter p-node-code             as integer      no-undo.
     7012   define input parameter p-obj-type              as character    no-undo.
     7013   define input parameter p-obj-code              as integer      no-undo.
     7014   define output parameter p-notcorr              as character    no-undo init ?.
     7015   define output parameter p-range-notcorr     as integer      no-undo.
     7016   define output parameter p-exists-notcorr    as logical      no-undo.
     7017   define variable v-host-code as integer      no-undo.
     7018   DEFINE VARIABLE v-found as logical no-undo .
     7019   DEFINE VARIABLE v-exists as logical no-undo .
     7020   DEFINE VARIABLE v-range as integer no-undo .
     7021   DEFINE VARIABLE jj as integer no-undo .
     7022   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7023   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7024   define buffer buf_gds-grp for ub.gds-grp.
     7025   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7026   find first buf_gds-grp no-lock where
     7027              buf_gds-grp.node-code = p-node-code no-error .
     7028   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7029     message
     7030       vss-workfile vss-revision vss-description
     7031       skip "Не удалось найти группу товаров с кодом" p-node-code
     7032       view-as alert-box error .
     7033     undo, return error .
     7034   end.
     7035   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7037     (input  p-obj-type
     7038     ,input  p-obj-code
     7039     ,output v-host-code
     7040     ) no-error .
     7041   if error-status :error
     7042   then do:
     7043       message
     7044         vss-workfile vss-revision vss-description
     7045         skip "Не удалось найти фирму объекта"
     7046         skip p-obj-type p-obj-code
     7047         skip return-value
     7048         skip trim(error-status :get-message(1))
     7049       view-as alert-box error.
     7050       undo, return error .
     7051   end.
     7052   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7053   do while v-found = no and jj < 2:
     7054     if v-range <> 3 then do:
     7055       find first buf_gds-grp-obj no-lock
     7056           where buf_gds-grp-obj.node-code = p-node-code
     7057             and buf_gds-grp-obj.host-code = v-host-code
     7058             and buf_gds-grp-obj.obj-type  = p-obj-type
     7059             and buf_gds-grp-obj.obj-code  = p-obj-code
     7060       no-error .
     7061     end.
     7062     if v-range = 3 or not available buf_gds-grp-obj
     7063     then do:
     7064        if v-range <> 2 then do:
     7065           find first buf_gds-grp-obj no-lock
     7066               where buf_gds-grp-obj.node-code = p-node-code
     7067                 and buf_gds-grp-obj.host-code = v-host-code
     7068                 and buf_gds-grp-obj.obj-type  = ""
     7069                 and buf_gds-grp-obj.obj-code  = 0
     7070           no-error .
     7071         end.
     7072         if v-range = 2 or not available buf_gds-grp-obj
     7073         then do:
     7074             if v-range <> 1 then do:
     7075               find first buf_gds-grp-obj no-lock
     7076                   where buf_gds-grp-obj.node-code = p-node-code
     7077                   and buf_gds-grp-obj.host-code = 0
     7078                   and buf_gds-grp-obj.obj-type  = ""
     7079                   and buf_gds-grp-obj.obj-code  = 0
     7080               no-error .
     7081             end.
     7082             if v-range = 1 or not available buf_gds-grp-obj
     7083             then do:
     7084                 assign
     7085                     v-exists = no
     7086                 .
     7087             end.
     7088             else do:
     7089                 assign
     7090                     v-exists = yes
     7091                     v-range = 1
     7092                 .
     7093             end.
     7094         end.
     7095         else do:
     7096             assign
     7097                 v-exists = yes
     7098                 v-range  = 2
     7099             .
     7100         end.
     7101     end.
     7102     else do:
     7103         assign
     7104             v-exists = yes
     7105             v-range  = 3
     7106         .
     7107     end.
     7108     if available buf_gds-grp-obj
     7109     then do:
     7110       find first buf_gds-grp-obj-attr no-lock
     7111         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7112           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7113           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7114           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7115           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7116         no-error .
     7117       if available buf_gds-grp-obj-attr then do:
     7118         assign
     7119           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7120         .
     7121       end.
     7122       else do:
     7123         assign
     7124           v-notcorr-value = ?
     7125         .
     7126       end.
     7127       assign
     7128       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7129                           then yes
     7130                           else p-exists-notcorr)
     7131       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7132                         then v-range
     7133                         else p-range-notcorr
     7134       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7135                         then v-notcorr-value
     7136                         else p-notcorr
     7137       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7138       jj = jj + 1
     7139       .
     7140     end.
     7141     else do:
     7142       assign
     7143       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7144       jj = jj + 1
     7145       .
     7146     end.
     7147   end.
     7148   end.
     7149   end procedure.
