    15530   PROCEDURE putc-13.
    15531   define parameter buffer buf_cash-desk for ub.cash-desk.
    15532   define input parameter pos-type as char no-undo.
    15533   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    15534   define input parameter p-call-from-goods as logical no-undo .
    15535   define variable ii as integer no-undo .
    15536   define variable v-rate-code like ub.tax-rate.rate-code no-undo .
    15537   define variable v-envd as LOGICAL no-undo .
    15538   define variable v-plu as integer no-undo .
    15539   define buffer buf_tax-rate for ub.tax-rate.
    15540   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
    15541   if cash-txr.rate-value = ?
    15542   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
    15543   then do:
    15544       run write-log-and-file in p-log-handle (
    15545             input 1
    15546           , input log-file-name
    15547           , input 1
    15548           , input substitute( "!!!Для маг &1 ставка налога &2 НЕ ОПРЕДЕЛЕНА"
    15549                               ,buf_cash-desk.obj-code
    15550                               ,cash-txr.rate-code
    15551                             )
    15552                                             ).
    15553       v-view-log = yes.
    15554       return '':U .
    15555   end.
    15556   CASE pos-type:
    15557     when 'IBM':U then do:
    15558      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
    15559         PUT stream IBMstream unformatted
    15560         '13 "'
    15561         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15562         then "D"
    15563         else string( action, "x(1)" )
    15564         '" '
    15565         cash-txr.tax-code format "9"
    15566         ' '
    15567         cash-txr.rate-code
    15568         ' '
    15569         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15570         (if cash-txr.rate-value = ?
    15571           then 0
    15572           else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15573         chr(10).
    15574       end.
    15575       else do:
    15576         _do:
    15577         do ii = 1 to num-entries(cdtaxlst, ";":U):
    15578           assign
    15579           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
    15580           no-error .
    15581           if error-status:error then do:
    15582             message
    15583             "Неверное значение настроечного параметра cdtaxlst" cdtaxlst
    15584             view-as alert-box error .
    15585             return error .
    15586           end.
    15587           find first buf_tax-rate no-lock where
    15588                     buf_tax-rate.rate-code = v-rate-code no-error .
    15589           if not available buf_tax-rate then do:
    15590             run write-log-and-file in p-log-handle (
    15591                   input 1
    15592                 , input log-file-name
    15593                 , input 1
    15594                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
    15595                                     ,buf_cash-desk.obj-code
    15596                                     ,v-rate-code
    15597                                     ,buf_Cash-desk.pos-type
    15598                                   )
    15599                                                   ).
    15600             v-view-log = yes.
    15601             return error .
    15602           end.
    15603           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
    15604             PUT stream IBMstream unformatted
    15605             '13 "'
    15606             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15607             then "D"
    15608             else string( action, "x(1)" )
    15609             '" '
    15610             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
    15611             ' '
    15612             cash-txr.rate-code
    15613             ' '
    15614             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15615             (if cash-txr.rate-value = ?
    15616             then 0
    15617             else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15618             chr(10).
    15619           end.
    15620         end.
    15621       end.
    15622     end.
    15623     when 'IBM-XML':U then do:
    15624         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
    15625                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
    15626                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
    15627          if AVAILABLE buf_tax-rate-attr then do:
    15628              v-envd = yes .
    15629          end.
    15630          else v-envd = no .
    15631       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15632                                             , input "":U).
    15633       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15634                                             , input string(cash-txr.rate-code), input 1 ).
    15635       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15636                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15637       if v-envd then do:
    15638       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15639                                             , input string(-1), input 1 ).
    15640       end.
    15641       else do:
    15642       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15643                                             , input string(if cash-txr.rate-value = ?
    15644                                                            then 0
    15645                                                            else cash-txr.rate-value), input 1 ).
    15646       end.
    15647       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15648                                             , input string(1), input 1 ).
    15649       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15650     end.
    15651     when 'MAGIA-XML':U then do:
    15652       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15653                                             , input "":U).
    15654       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15655                                             , input string(cash-txr.rate-code), input 1 ).
    15656       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15657                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15658       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15659                                             , input string(if cash-txr.rate-value = ?
    15660                                                            then 0
    15661                                                            else cash-txr.rate-value), input 1 ).
    15662       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15663                                             , input string(1), input 1 ).
    15664       run bgelib-tag-put in this-procedure ( input 4, input "TCLock"
    15665                                             , input string(if cash-txr.news-action
    15666                                                            OR cash-txr.status_ <> 'тек':U
    15667                                                            then 1
    15668                                                            else 0), input 1 ).
    15669       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15670     end.
    15671     when 'MARIA':U then do:
    15672     end.
    15673   END CASE .
    15674   END PROCEDURE .
    15675   procedure get-o-attr :
    15676   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    15677   define input parameter par-obj-code like ub.clients.obj-code no-undo .
