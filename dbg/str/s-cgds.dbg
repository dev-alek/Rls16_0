    13680                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    13681                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    13682                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    13683                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
