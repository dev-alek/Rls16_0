     6322   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6323   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6324   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6325   define buffer buf_price-all              for ub.price-all  .
     6326   define buffer buf_goods                  for ub.goods      .
     6327   define buffer buf_global-state           for ub.global-state  .
     6328   define buffer buf_buyer-group            for ub.buyer-group  .
     6329   define buffer buf_turnover-group         for ub.turnover-group  .
     6330   define buffer buf_main-code              for ub.bar-code  .
     6331   define buffer buf_bar-code               for ub.bar-code  .
     6332   define buffer buf_pay-type               for ub.pay-type  .
     6333   define buffer buf_cash-pay               for ub.cash-pay  .
     6334   define variable to-day          as date      no-undo .
     6335   define variable v-base-rate0    as decimal   no-undo .
     6336   define variable v-base-scale0   as decimal   no-undo .
     6337   define variable v-exch-rate0    as decimal   no-undo .
     6338   define variable v-exch-scale0   as decimal   no-undo .
     6339   define variable v-base-rate     as decimal   no-undo .
     6340   define variable v-base-scale    as decimal   no-undo .
     6341   define variable v-exch-rate     as decimal   no-undo .
     6342   define variable v-exch-scale    as decimal   no-undo .
     6343   define variable v-host-code     as integer   no-undo .
     6344   define variable v-curr-abbr     as character no-undo .
     6345   define variable v-grp-name      as character no-undo .
     6346   define variable v-date-1        as date      no-undo .
     6347   define variable v-date-2        as date      no-undo .
     6348   define variable v-interv        as character no-undo .
     6349   define variable v-pay-name      as character no-undo .
     6350   define variable v-cli-oborot    as decimal   no-undo .
     6351   define variable v-trn-pay-code  as integer   no-undo .
     6352   define variable v-cash-pay-curr as integer   no-undo .
     6353   define variable v-cash-pay-code as integer   no-undo .
     6354   do
     6355   on error undo, return error return-value
     6356   :
     6357   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6358   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6359   if p-fact-order = ? then do:
     6360     run fact-order-mpl (
     6361         input   today       ,
     6362         input   p-obj-type  ,
     6363         input   p-obj-code  ,
     6364         output  p-fact-order ).
     6365   end.
     6366   if p-vid-pay <> "" then do:
     6367      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6368      if available buf_pay-type
     6369         then v-trn-pay-code = buf_pay-type.obj-code.
     6370         else v-trn-pay-code =  0.
     6371   end.
     6372   else v-trn-pay-code = 0 .
     6373   if p-cash-pay-type <> "" then do:
     6374      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6375      if available buf_pay-type
     6376         then
     6377           assign
     6378             v-cash-pay-curr = buf_cash-pay.curr-code
     6379             v-cash-pay-code = buf_cash-pay.cdpay-code
     6380           .
     6381         else
     6382           assign
     6383             v-cash-pay-curr = 0
     6384             v-cash-pay-code = 0
     6385             .
     6386   end.
     6387   else
     6388     assign
     6389       v-cash-pay-curr = 0
     6390       v-cash-pay-code = 0
     6391       .
     6392   for each tt_price-all  : delete tt_price-all . end.
     6393   assign
     6394     p-plt-id             = ?
     6395     p-plt-db-num         = ?
     6396     p-pdf-id             = ?
     6397     p-pdf-db-num         = ?
     6398     p-sale-price-base    = ?
     6399     p-sale-price-rubl    = ?
     6400     v-cli-oborot         = 0
     6401   .
     6402   find first buf_global-state no-lock no-error .
     6403   if not available buf_global-state then do:
     6404      message
     6405        "Не заданы параметры ценообразования!"
     6406        view-as alert-box error
     6407      .
     6408      return error return-value .
     6409   end.
     6410   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6412     (input  p-obj-type
     6413     ,input  p-obj-code
     6414     ,output to-day
     6415     )  .
     6416   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6418     (input  p-obj-type
     6419     ,input  p-obj-code
     6420     ,output v-host-code
     6421     )  .
     6422   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6424     (input  v-host-code
     6425     ,input  to-day
     6426     ,output v-base-rate0
     6427     ,output v-base-scale0
     6428     )  .
     6429     v-cli-oborot-ALL  = 0 .
     6430     for each buf_turnover-buyer-main no-lock  where
     6431              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6432              buf_turnover-buyer-main.cli-code = p-cli-code
     6433              :
     6434              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6435     end.
     6436   for each buf_price-all no-lock where
     6437            buf_price-all.obj-type = p-obj-type and
     6438            buf_price-all.obj-code = p-obj-code and
     6439            buf_price-all.gds-code = buf_goods.gds-code and
     6440            buf_price-all.status_  = 'акт':U  and
     6441          ( p-only-b-code = false   or
     6442          ( buf_price-all.b-code = p-main-b-code or
     6443            buf_price-all.b-code = p-b-code))    and
     6444           ( p-only-b-code = true  or
     6445             buf_price-all.b-code = p-b-code)
     6446             and
     6447             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6448           ( buf_price-all.fact-order-sys-to = ? or
     6449             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6450           :
     6451            v-interv   = "" .
     6452            v-grp-name = "" .
     6453            v-pay-name = "" .
     6454            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6455            if buf_price-all.bgr-id > 0 then do:
     6456               find first buf_buyer-group no-lock where
     6457                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6458                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6459               if available buf_buyer-group then do:
     6460                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6461                  find first buf_buyer-in-buyer-group no-lock where
     6462                             buf_buyer-in-buyer-group.stts         = 0 and
     6463                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6464                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6465                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6466                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6467                             no-error .
     6468                             if not available buf_buyer-in-buyer-group then do:
     6469                                v-grp-name = "".
     6470                                next.
     6471                             end.
     6472                             v-grp-name = buf_buyer-group.name .
     6473                  end.
     6474               end.
     6475               else do:
     6476                    v-grp-name = "".
     6477                    next.
     6478               end.
     6479            end.
     6480            if buf_price-all.tog-id > 0 then do:
     6481               find first buf_turnover-group no-lock where
     6482                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6483                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6484               if available buf_turnover-group then do:
     6485                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6486                     v-cli-oborot = v-cli-oborot-all  .
     6487                     find first buf1_tnv-in-turnover-group no-lock where
     6488                                buf1_tnv-in-turnover-group.stts       =  0     and
     6489                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6490                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6491                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6492                     find first buf2_tnv-in-turnover-group no-lock where
     6493                                buf2_tnv-in-turnover-group.stts       =  0     and
     6494                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6495                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6496                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6497                     if not (available buf1_tnv-in-turnover-group and
     6498                             available buf2_tnv-in-turnover-group ) then do:
     6499                             v-grp-name = "".
     6500                             next .
     6501                     end.
     6502                     v-grp-name = buf_turnover-group.name.
     6503                  end.
     6504               end.
     6505               else do:
     6506                    v-grp-name = "".
     6507                    next.
     6508               end.
     6509            end.
     6510            if buf_price-all.plt-fix-cource-crc-base = true then
     6511               assign
     6512                 v-base-rate  = buf_price-all.pdf-base-rate
     6513                 v-base-scale = buf_price-all.pdf-base-scale
     6514               .
     6515               else
     6516               assign
     6517                 v-base-rate  = v-base-rate0
     6518                 v-base-scale = v-base-scale0
     6519               .
     6520            if buf_price-all.plt-fix-cource-crc-doc = true then
     6521               assign
     6522                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6523                 v-exch-scale = buf_price-all.pdf-exch-scale
     6524               .
     6525               else do:
     6526   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6528     (input  buf_price-all.curr-code
     6529     ,input  to-day
     6530     ,output v-exch-rate0
     6531     ,output v-exch-scale0
     6532     ,output v-curr-abbr
     6533     )  .
     6534               assign
     6535                 v-exch-rate  = v-exch-rate0
     6536                 v-exch-scale = v-exch-scale0
     6537                 .
     6538              end.
     6539              v-date-1 = date ( "" )  .
     6540              if buf_price-all.fact-order-sys-from > 0 then do:
     6541                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6542                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6543                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6544              end.
     6545              v-date-2 =  date ( "" )  .
     6546              if buf_price-all.fact-order-sys-to > 0 then do:
     6547                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6548                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6549                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6550              end.
     6551              if buf_price-all.qnty-from <> ? then do :
     6552                 if not (
     6553                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6554                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6555                 ) then do:
     6556                        v-interv = "".
     6557                        next.
     6558                 end.
     6559                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6560              end.
     6561              if buf_price-all.sum-from <> ? then do :
     6562                 if not (
     6563                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6564                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6565                 ) then do:
     6566                    v-interv = "".
     6567                    next.
     6568                 end.
     6569                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6570              end.
     6571              if buf_price-all.turnover-from <> ? then do :
     6572                 if not (
     6573                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6574                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6575                 ) then do:
     6576                    v-interv = "".
     6577                    next.
     6578                 end.
     6579                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6580              end.
     6581              if buf_price-all.use-pay-type = 1 then do :
     6582                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6583                    v-pay-name = "" .
     6584                    next.
     6585                  end.
     6586                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6587              end.
     6588              if buf_price-all.use-cash-pay = 1 then do :
     6589                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6590                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6591                   v-pay-name = "" .
     6592                   next.
     6593                 end.
     6594                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6595              end.
     6596             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6597             create tt_price-all .
     6598             buffer-copy buf_price-all to tt_price-all
     6599             assign
     6600               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6601               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6602               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6603               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6604               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6605               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6606               tt_price-all.price-sale     = buf_price-all.price-sale
     6607               tt_price-all.road-tax       = buf_price-all.road-tax
     6608               tt_price-all.excise         = buf_price-all.excise
     6609               tt_price-all.pdf-exch-rate   = v-exch-rate
     6610               tt_price-all.pdf-exch-scale  = v-exch-scale
     6611               tt_price-all.pdf-base-rate   = v-base-rate
     6612               tt_price-all.pdf-base-scale  = v-base-scale
     6613               tt_price-all.grp-name        = v-grp-name
     6614               tt_price-all.date-1          = v-date-1
     6615               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6616               tt_price-all.time-1          = buf_price-all.start-sys-time
     6617               tt_price-all.date-2          = v-date-2
     6618               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6619               tt_price-all.time-2          = buf_price-all.end-sys-time
     6620               tt_price-all.interv-name     = v-interv
     6621               tt_price-all.pay-name        = v-pay-name
     6622               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6623             .
     6624   end.
     6625   define variable vt-plt-id as integer   no-undo .
     6626   define variable vt-plt-db as integer   no-undo .
     6627   define variable vt-pdf-id as integer   no-undo .
     6628   define variable vt-pdf-db as integer   no-undo .
     6629   define buffer neos_price-all for tt_price-all  .
     6630   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6631       if available tt_price-all then do:
     6632        assign
     6633          vt-plt-id = tt_price-all.plt-id
     6634          vt-plt-db = tt_price-all.plt-db-num
     6635          vt-pdf-id = tt_price-all.pdf-id
     6636          vt-pdf-db = tt_price-all.pdf-db
     6637        .
     6638        if tt_price-all.b-code = p-b-code then do:
     6639             assign
     6640               p-plt-id           = tt_price-all.plt-id
     6641               p-plt-db-num       = tt_price-all.plt-db-num
     6642               p-pdf-id           = tt_price-all.pdf-id
     6643               p-pdf-db-num       = tt_price-all.pdf-db
     6644               p-sale-price-base  = tt_price-all.price-sale-base
     6645               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6646               p-road-tax-base    = tt_price-all.road-tax-base
     6647               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6648               p-excise-base      = tt_price-all.excise-base
     6649               p-excise-rubl      = tt_price-all.excise-rubl
     6650               .
     6651        end.
     6652        else do:
