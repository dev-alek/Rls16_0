        1   block-level on error undo, throw.
        2   define input  parameter p-parts-attr-recid as recid     no-undo .
        3   define buffer buf_parts-attr for ub.parts-attr .
        4   define button b-close
        5        label "&Выход" auto-go
        6        size 10 by 1
        7        .
        8   form b-close skip
        9     with frame a side-labels 1 column scrollable
       10     view-as dialog-box three-d size 60 by 20
       11     .
       12   form buf_parts-attr with frame a .
       13   find first buf_parts-attr no-lock
       14     where recid(buf_parts-attr) = p-parts-attr-recid
       15     no-error .
       16   if available buf_parts-attr
       17   then do:
       18     display
       19       buf_parts-attr
       20       with frame a .
       21     enable b-close with frame a .
       22     apply 'entry':u to b-close .
       23     wait-for go of frame a .
       24   end.
