      126       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "recipe-ref-num  ":U )   , input trim( "Номер по спр.рец.":U )   ).
      127       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "recipe-technique":U )   , input trim( "Технология       ":U )   ).
      128       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "recipe-template ":U )   , input trim( "Ссылка на спр.рец":U )   ).
      129       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "recipe-type     ":U )   , input trim( "Тип рецепта      ":U )   ).
      130       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "sale-factor     ":U )   , input trim( "Кратность        ":U )   ).
      131       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-code     ":U )   , input trim( "Рецепт           ":U )   ).
      132       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "artic           ":U )   , input trim( "Артикул          ":U )   ).
      133       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "prod-type       ":U )   , input trim( "Тип производителя":U )   ).
      134       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "prod-code       ":U )   , input trim( "Код производителя":U )   ).
      135       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "brutto-qnty     ":U )   , input trim( "Брутто           ":U )   ).
      136       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "gds-code        ":U )   , input trim( "Код товара       ":U )   ).
      137       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "host-code       ":U )   , input trim( "Код фирмы        ":U )   ).
      138       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "is-default      ":U )   , input trim( "Основной         ":U )   ).
      139       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "obj-code        ":U )   , input trim( "Код объекта      ":U )   ).
      140       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "obj-type        ":U )   , input trim( "Тип объекта      ":U )   ).
      141       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "portion-qnty    ":U )   , input trim( "Кол.порций       ":U )   ).
      142       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "portion-weight  ":U )   , input trim( "Вес порции       ":U )   ).
      143       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "qnty            ":U )   , input trim( "Количество       ":U )   ).
      144       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-code     ":U )   , input trim( "Номер рецепта    ":U )   ).
      145       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-design   ":U )   , input trim( "Оформление       ":U )   ).
      146       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-name     ":U )   , input trim( "Назв.рецепта     ":U )   ).
      147       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-order    ":U )   , input trim( "Порядок          ":U )   ).
      148       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-quality  ":U )   , input trim( "Показ.качества   ":U )   ).
      149       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-ref-num  ":U )   , input trim( "Номер по спр.рец.":U )   ).
      150       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-technique":U )   , input trim( "Технология       ":U )   ).
      151       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-template ":U )   , input trim( "Ссылка на спр.рец":U )   ).
      152       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "recipe-type     ":U )   , input trim( "Тип рецепта      ":U )   ).
      153       run bufcomp-set-field-param in this-procedure  ( input "c-recipe":U  , input trim( "sale-factor     ":U )   , input trim( "Кратность        ":U )   ).
      154   end.
      155   END PROCEDURE.
      156   PROCEDURE bufcomp-set-field-param :
      157   define input parameter p-table-name     as character  no-undo.
      158   define input parameter p-field-name     as character  no-undo.
      159   define input parameter p-field-label    as character  no-undo.
      160       define buffer buf_temp_bufcomp_field-param      for temp_bufcomp_field-param.
      161   do
      162   for buf_temp_bufcomp_field-param
      163   on error undo, return error
      164   :
      165       assign
      166           v-bufcomp-fpm-key = v-bufcomp-fpm-key + 1
      167       .
      168       create buf_temp_bufcomp_field-param.
      169       assign
      170           buf_temp_bufcomp_field-param.fpm-key           = v-bufcomp-fpm-key
      171           buf_temp_bufcomp_field-param.table-name        = p-table-name
      172           buf_temp_bufcomp_field-param.field-name        = p-field-name
      173           buf_temp_bufcomp_field-param.field-new-label   = p-field-label
      174       .
      175   end.
      176   END PROCEDURE.
      177   PROCEDURE bufcomp-buffer-compare :
      178   define input parameter p-old-buffer-handle  as handle           no-undo.
      179   define input parameter p-new-buffer-handle  as handle           no-undo.
      180   define input parameter p-except-field-list  as character        no-undo.
      181       define variable v-field-counter    as integer      no-undo.
      182       define variable v-old-field-handle as handle       no-undo.
      183       define variable v-new-field-handle as handle       no-undo.
      184       define buffer buf_old_temp_bufcomp_field-param      for temp_bufcomp_field-param.
      185       define buffer buf_new_temp_bufcomp_field-param      for temp_bufcomp_field-param.
      186       define buffer buf_temp_bufcomp_field-diff           for temp_bufcomp_field-diff.
      187   do
      188   for buf_old_temp_bufcomp_field-param
      189     , buf_new_temp_bufcomp_field-param
      190     , buf_temp_bufcomp_field-diff
      191   on error undo, return error
      192   :
      193       process-fields:
      194       do v-field-counter = 1 TO p-new-buffer-handle :num-fields
      195       :
      196           assign
      197               v-new-field-handle = p-new-buffer-handle :buffer-field( v-field-counter )
      198               v-old-field-handle = p-old-buffer-handle :buffer-field( v-new-field-handle :name )
      199           no-error.
      200           if not valid-handle( v-old-field-handle )
      201           or not valid-handle( v-new-field-handle )
      202           then do:
      203               next process-fields.
      204           end.
      205           if lookup( v-new-field-handle :name, p-except-field-list ) <> 0
      206           then do:
      207               next process-fields.
      208           end.
      209           else do:
      210               find first buf_old_temp_bufcomp_field-param
      211                    where buf_old_temp_bufcomp_field-param.table-name  = p-old-buffer-handle :name
      212                      and buf_old_temp_bufcomp_field-param.field-name  = v-old-field-handle :name
      213               no-error.
      214               find first buf_new_temp_bufcomp_field-param
      215                    where buf_new_temp_bufcomp_field-param.table-name  = p-new-buffer-handle :name
      216                      and buf_new_temp_bufcomp_field-param.field-name  = v-new-field-handle :name
      217               no-error.
      218               if v-new-field-handle :buffer-value <> v-old-field-handle :buffer-value
      219               then do:
      220                   assign
      221                       v-bufcomp-fdd-key = v-bufcomp-fdd-key + 1
      222                   .
      223                   create buf_temp_bufcomp_field-diff.
      224                   assign
      225                       buf_temp_bufcomp_field-diff.fdd-key     = v-bufcomp-fdd-key
      226                       buf_temp_bufcomp_field-diff.fpm-key-old = ( if available buf_old_temp_bufcomp_field-param then buf_old_temp_bufcomp_field-param.fpm-key else 0 )
      227                       buf_temp_bufcomp_field-diff.fpm-key-new = ( if available buf_new_temp_bufcomp_field-param then buf_new_temp_bufcomp_field-param.fpm-key else 0 )
      228                       buf_temp_bufcomp_field-diff.value-old   = string( v-old-field-handle :buffer-value )
      229                       buf_temp_bufcomp_field-diff.value-new   = string( v-new-field-handle :buffer-value )
      230                       buf_temp_bufcomp_field-diff.label-old = ( if available buf_old_temp_bufcomp_field-param then buf_old_temp_bufcomp_field-param.field-new-label else v-old-field-handle :label )
      231                       buf_temp_bufcomp_field-diff.label-new = ( if available buf_new_temp_bufcomp_field-param then buf_new_temp_bufcomp_field-param.field-new-label else v-new-field-handle :label )
      232                   .
      233                   case v-new-field-handle :data-type
      234                   :
      235                       when "integer":U
      236                       then do:
      237                           assign
      238                               buf_temp_bufcomp_field-diff.diff = string( integer( buf_temp_bufcomp_field-diff.value-new ) - integer( buf_temp_bufcomp_field-diff.value-old ) )
      239                           .
      240                       end.
      241                       when "decimal":U
      242                       then do:
      243                           assign
      244                               buf_temp_bufcomp_field-diff.diff = string( decimal( buf_temp_bufcomp_field-diff.value-new ) - decimal( buf_temp_bufcomp_field-diff.value-old ) )
      245                           .
      246                       end.
      247                       when "character":U
      248                       then do:
      249                           assign
      250                               buf_temp_bufcomp_field-diff.diff = string( v-old-field-handle :buffer-value ) + " | ":U + string( v-new-field-handle :buffer-value )
      251                           .
      252                       end.
      253                       when "logical":U
      254                       then do:
      255                           assign
      256                               buf_temp_bufcomp_field-diff.diff = string( v-old-field-handle :buffer-value ) + " | ":U + string( v-new-field-handle :buffer-value )
      257                           .
      258                       end.
      259                   end case.
      260               end.
      261           end.
      262       end.
      263   end.
      264   END PROCEDURE.
      265   define temp-table temp_changes no-undo
      266       field field-name as character
      267       field field-label as character
      268       field value-old as character
      269       field value-new as character
      270       index pi is primary unique
      271               field-name
      272   .
      273   FUNCTION get-recipe-fields RETURNS CHARACTER
      274     ( p-field-id as integer, p-input-integer as integer, p-input-character as character )  FORWARD.
      275   DEFINE BUTTON b-exit AUTO-GO
      276        LABEL "В&ыход"
      277        SIZE 10 BY 1
      278        BGCOLOR 8 .
      279   DEFINE BUTTON b-help
      280        LABEL "Помо&щь"
      281        SIZE 10 BY 1
      282        BGCOLOR 8 .
      283   DEFINE BUTTON bt-filter
      284        LABEL "&Фильтр"
      285        SIZE 10 BY 1.
      286   DEFINE QUERY BR-changes FOR
      287         temp_bufcomp_field-diff SCROLLING.
      288   DEFINE QUERY br-table FOR
      289         c-recipe-hist SCROLLING.
      290   DEFINE BROWSE BR-changes
      291     QUERY BR-changes DISPLAY
      292         temp_bufcomp_field-diff.label-new column-label "Изменилось" format "X(20)"
      293   temp_bufcomp_field-diff.value-old column-label "Было" format "X(36)"
      294   temp_bufcomp_field-diff.value-new column-label "Стало" format "X(36)"
      295       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 6.
      296   DEFINE BROWSE br-table
      297     QUERY br-table NO-LOCK DISPLAY
      298         get-recipe-fields( input 1, input c-recipe-hist.action, input "":U ) COLUMN-LABEL "Действие" FORMAT "X(10)":U
      299         c-recipe-hist.recipe-type COLUMN-LABEL "Тип" FORMAT "X(1)":U
      300         get-recipe-fields( input 2, input 0, input c-recipe-hist.subject ) COLUMN-LABEL "Сост/Ингр" FORMAT "X(10)":U
      301         c-recipe-hist.corr-user-name COLUMN-LABEL "Пользователь" FORMAT "X(14)":U
      302         c-recipe-hist.corr-date COLUMN-LABEL "Дата" FORMAT "99/99/9999":U
      303         get-recipe-fields( input 3, input c-recipe-hist.corr-time, input "":U ) COLUMN-LABEL "Время" FORMAT "X(5)":U
      304         c-recipe-hist.recipe-code COLUMN-LABEL "Рецепт" FORMAT "X(12)":U
      305         get-recipe-fields( input 4, input c-recipe-hist.gds-code, input "":U ) COLUMN-LABEL "Товар" FORMAT "X(20)":U
      306         c-recipe-hist.recipe-chip-num
      307       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 14.75 EXPANDABLE.
      308   DEFINE FRAME Dialog-Frame
      309        b-exit AT ROW 1 COL 1
      310        bt-filter AT ROW 1 COL 11
      311        b-help AT ROW 1 COL 89.5
      312        br-table AT ROW 2.5 COL 2
      313        BR-changes AT ROW 17.5 COL 2
      314        SPACE(0.37) SKIP(0.12)
      315       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      316            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      317            TITLE "История рецепта"
      318            DEFAULT-BUTTON b-exit.
      319   ASSIGN
      320          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      321          FRAME Dialog-Frame:HIDDEN           = TRUE.
      322   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      323   DO:
      324     APPLY "END-ERROR":U TO SELF.
      325   END.
      326   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      327   DO:
      328   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   if lookup(self :type
      330            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      331            ) = 0
      332   then do:
      333     message
      334       "$Workfile$"
      335       "Указанному интерфейсному элементу фокус не может быть передан" skip
      336       "Интерфейсный элемент" self :name  skip
      337       "Тип" self :type  skip
      338       "Процедура" this-procedure :file-name skip
      339       view-as alert-box .
      340   end.
      341   else do:
      342     apply "entry":u to self  .
      343     if focus :handle <> self :handle  then do:
      344       return no-apply .
      345     end.
      346   end.
      347   END.
      348   ON VALUE-CHANGED OF br-table IN FRAME Dialog-Frame
      349   DO:
      350       if available c-recipe-hist
      351       then do:
      352           run calc-changes in this-procedure (
      353                 input c-recipe-hist.corr-user-db-num
      354               , input c-recipe-hist.chip-num
      355           ) no-error.
      356           if error-status :error
      357           then do:
      358               message
      359                        vss-workfile vss-revision vss-description
      360                   skip(1)
      361                   skip "Ошибка вычисления изменений по истории."
      362                   skip return-value
      363                   skip trim(error-status :get-message(1))
      364                        trim(error-status :get-message(2))
      365                        trim(error-status :get-message(3))
      366               view-as alert-box error.
      367               undo, return no-apply .
      368           end.
      369           OPEN QUERY br-changes FOR EACH temp_bufcomp_field-diff.
      370       end.
      371   END.
      372   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      373   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      374   MAIN-BLOCK:
      375   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      376      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      377     RUN enable_UI.
      378     apply "value-changed" to br-table in frame Dialog-Frame .
      379     apply "entry" to b-exit.
      380     WAIT-FOR GO OF FRAME Dialog-Frame.
      381   END.
      382   RUN disable_UI.
      383   PROCEDURE calc-changes :
      384   define input parameter p-c-recipe-hist-db-num     as integer    no-undo.
      385   define input parameter p-c-recipe-hist-chip-num   as integer    no-undo.
      386       define variable v-old-recipe-handle     as handle     no-undo.
      387       define variable v-new-recipe-handle     as handle     no-undo.
      388       define variable v-find-success          as logical      no-undo.
      389       define buffer buf_temp_bufcomp_field-diff       for temp_bufcomp_field-diff.
      390       define variable v-field-list    as character    no-undo.
      391       define buffer buf_old_c-recipe      for c-recipe.
      392       define buffer buf_old_c-recipe-gds  for c-recipe-gds.
      393       define buffer buf_c-recipe-hist     for c-recipe-hist.
      394   do
      395   for buf_c-recipe-hist
      396     , buf_temp_bufcomp_field-diff
      397   on error undo, return error
      398   :
      399       for each buf_temp_bufcomp_field-diff
      400       :
      401           delete buf_temp_bufcomp_field-diff.
      402       end.
      403       find first buf_c-recipe-hist no-lock
      404            where buf_c-recipe-hist.corr-user-db-num   = p-c-recipe-hist-db-num
      405              and buf_c-recipe-hist.chip-num = p-c-recipe-hist-chip-num
      406       .
      407       if buf_c-recipe-hist.action = integer( '99':U )
      408       then do:
      409       end.
      410       else do:
      411           create buffer v-old-recipe-handle for table substitute( "c-&1":U, buf_c-recipe-hist.subject ).
      412           assign
      413               v-find-success = v-old-recipe-handle :find-first(
      414                   substitute( "where &1 = '&2' and &3 = &4 use-index pi"
      415                       , "recipe-code":U
      416                       , buf_c-recipe-hist.recipe-code
      417                       , "chip-num":U
      418                       , buf_c-recipe-hist.recipe-chip-num
      419                   ), no-lock )
      420           no-error.
      421           if v-find-success = yes
      422           then do:
      423               create buffer v-new-recipe-handle for table substitute( "c-&1":U, buf_c-recipe-hist.subject ).
      424               assign
      425                   v-find-success = v-new-recipe-handle :find-first(
      426                       substitute( "where &1 = '&2' and &3 > &4 use-index pi"
      427                           , "recipe-code":U
      428                           , buf_c-recipe-hist.recipe-code
      429                           , "chip-num":U
      430                           , buf_c-recipe-hist.recipe-chip-num
      431                       ), no-lock )
      432               no-error.
      433               if v-find-success = yes
      434               then do:
      435                   run bufcomp-buffer-compare in this-procedure (
      436                         input v-old-recipe-handle
      437                       , input v-new-recipe-handle
      438                       , input "chip-num,corr-date,corr-time,corr-user-name,v-user-db-num":U
      439                   ).
      440               end.
      441               else do:
      442                   create buffer v-new-recipe-handle for table buf_c-recipe-hist.subject.
      443                   assign
      444                       v-find-success = v-new-recipe-handle :find-first(
      445                           substitute( "where &1 = '&2' use-index pi"
      446                               , "recipe-code":U
      447                               , buf_c-recipe-hist.recipe-code
      448                           ), no-lock )
      449                   no-error.
      450                   if v-find-success = yes
      451                   then do:
      452                       run bufcomp-buffer-compare in this-procedure (
      453                               input v-old-recipe-handle
      454                           , input v-new-recipe-handle
      455                           , input "chip-num,corr-date,corr-time,corr-user-name,v-user-db-num":U
      456                       ).
      457                   end.
      458               end.
      459               delete object v-old-recipe-handle.
      460           end.
      461           else
      462           delete object v-old-recipe-handle.
      463       end.
      464   end.
      465   END PROCEDURE.
      466   PROCEDURE disable_UI :
      467     HIDE FRAME Dialog-Frame.
      468   END PROCEDURE.
      469   PROCEDURE enable_UI :
      470     ENABLE b-exit bt-filter b-help br-table BR-changes
      471         WITH FRAME Dialog-Frame.
      472     VIEW FRAME Dialog-Frame.
      473     run open-query in this-procedure.
      474   END PROCEDURE.
      475   PROCEDURE open-query :
      476       define variable v-date-min      as date       no-undo.
      477       define variable v-date-max      as date       no-undo.
      478   do
      479   on error undo, return error
      480   :
      481       assign
      482           v-date-min = ( if p-date-1 = ? then 01/01/0001 else p-date-1 )
      483           v-date-max = ( if p-date-2 = ? then 12/31/4999 else p-date-2 )
      484       .
      485       case p-mode
      486       :
      487           when 1
      488           then do:
      489               if p-userid = "":U
      490               then do:
      491                   open query br-table
      492                       for each c-recipe-hist no-lock
      493                          where c-recipe-hist.recipe-code  = p-recipe-code
      494                            and c-recipe-hist.corr-date       >= v-date-min
      495                            and c-recipe-hist.corr-date       <= v-date-max
      496                       by c-recipe-hist.chip-num descending
      497                   indexed-reposition.
      498               end.
      499               else do:
      500                   open query br-table
      501                       for each c-recipe-hist no-lock
      502                          where c-recipe-hist.recipe-code  = p-recipe-code
      503                            and c-recipe-hist.corr-user-name  = p-userid
      504                            and c-recipe-hist.corr-date       >= v-date-min
      505                            and c-recipe-hist.corr-date       <= v-date-max
      506                       by c-recipe-hist.chip-num descending
      507                   indexed-reposition.
      508               end.
      509           end.
      510           when 2
      511           then do:
      512               if p-recipe-code = "":U
      513               then do:
      514                   open query br-table
      515                       for each c-recipe-hist no-lock
      516                          where c-recipe-hist.corr-user-name  = p-userid
      517                            and c-recipe-hist.corr-date       >= v-date-min
      518                            and c-recipe-hist.corr-date       <= v-date-max
      519                       by c-recipe-hist.corr-time
      520                   indexed-reposition.
      521               end.
      522               else do:
      523                   open query br-table
      524                       for each c-recipe-hist no-lock
      525                          where c-recipe-hist.corr-user-name  = p-userid
      526                            and c-recipe-hist.recipe-code  = p-recipe-code
      527                            and c-recipe-hist.corr-date       >= v-date-min
      528                            and c-recipe-hist.corr-date       <= v-date-max
      529                       by c-recipe-hist.corr-time
      530                   indexed-reposition.
      531               end.
      532           end.
      533           when 3
      534           then do:
      535               if p-userid = "":U
      536               then do:
      537                   open query br-table
      538                       for each c-recipe-hist no-lock
      539                          where c-recipe-hist.corr-date       >= v-date-min
      540                            and c-recipe-hist.corr-date       <= v-date-max
      541                       by c-recipe-hist.corr-user-name
      542                       by c-recipe-hist.corr-time
      543                   indexed-reposition.
      544               end.
      545               else do:
      546                   open query br-table
      547                       for each c-recipe-hist no-lock
      548                          where c-recipe-hist.corr-date       >= v-date-min
      549                            and c-recipe-hist.corr-date       <= v-date-max
      550                            and c-recipe-hist.corr-user-name  = p-userid
      551                       by c-recipe-hist.corr-time
      552                   indexed-reposition.
      553               end.
      554           end.
      555           when 4
      556           then do:
      557               open query br-table
      558                   for each c-recipe-hist no-lock
      559                      where c-recipe-hist.gds-code     = p-gds-code
      560                        and c-recipe-hist.corr-date       >= v-date-min
      561                        and c-recipe-hist.corr-date       <= v-date-max
      562                   by c-recipe-hist.corr-time
      563               indexed-reposition.
      564           end.
      565       end case.
      566   end.
      567   END PROCEDURE.
      568   FUNCTION get-recipe-fields RETURNS CHARACTER
      569     ( p-field-id as integer, p-input-integer as integer, p-input-character as character ) :
      570       case p-field-id
      571       :
      572           when 1
      573           then do:
      574               case p-input-integer
      575               :
      576                   when integer( '1':U )
      577                   then do:
      578                       return 'Создание':U.
      579                   end.
      580                   when integer( '2':U )
      581                   then do:
      582                       return 'Изменение':U.
      583                   end.
      584                   when integer( '99':U )
      585                   then do:
      586                       return 'Удаление':U.
      587                   end.
      588               end case.
      589           end.
      590           when 2
      591           then do:
      592               case p-input-character
      593               :
      594                   when 'recipe':U
      595                   then do:
      596                       return "Составной".
      597                   end.
      598                   when 'recipe-gds':U
      599                   then do:
      600                       return "Ингредиент".
      601                   end.
      602               end case.
      603           end.
      604           when 3
      605           then do:
      606               return string( p-input-integer, "HH:MM":U ).
      607           end.
      608           when 4
      609           then do:
      610               define variable v-artic     as character  no-undo.
      611               define variable v-prod-type as character  no-undo.
      612               define variable v-prod-code as integer    no-undo.
      613               define variable v-gds-name  as character  no-undo.
      614   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run arptpc in g#library
      616     (input  p-input-integer
      617     ,output v-artic
      618     ,output v-prod-type
      619     ,output v-prod-code
      620     )  .
      621               return substitute( "&1 &2", v-artic, v-gds-name ).
      622           end.
      623       end case.
      624       RETURN "".
      625   END FUNCTION.
