      115       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "is-default      ":U )   , input trim( "Основной         ":U )   ).
      116       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "obj-code        ":U )   , input trim( "Код объекта      ":U )   ).
      117       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "obj-type        ":U )   , input trim( "Тип объекта      ":U )   ).
      118       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "portion-qnty    ":U )   , input trim( "Кол.порций       ":U )   ).
      119       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "portion-weight  ":U )   , input trim( "Вес порции       ":U )   ).
      120       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "qnty            ":U )   , input trim( "Количество       ":U )   ).
      121       run bufcomp-set-field-param in this-procedure  ( input "recipe":U    , input trim( "recipe-code     ":U )   , input trim( "Номер рецепта    ":U )   ).
