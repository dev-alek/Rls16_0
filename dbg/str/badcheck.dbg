     1144   run minbtn-set in this-procedure .
     1145   on choose of b-help in frame Dialog-Frame
     1146   do:
     1147     apply "help":u to frame Dialog-Frame .
     1148   end.
     1149   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   procedure minbtn-set :
     1151       do
     1152           on error undo, return error return-value
     1153           :
     1154           define variable ii              as integer       no-undo .
     1155           define variable fh              as widget-handle no-undo .
     1156           define variable hh              as widget-handle no-undo .
     1157           define variable v-h             as handle        extent 4 no-undo .
     1158           define variable v-name-button   as character     no-undo .
     1159           define variable v-help-old-x    as decimal       no-undo .
     1160           define variable v-help-old-y    as decimal       no-undo .
     1161           define variable v-help-old-size as decimal       no-undo .
     1162           define variable v-frame-width   as decimal       no-undo .
     1163           define variable jj              as integer       no-undo .
     1164           do
     1165               on error undo, return error
     1166               :
     1167               assign
     1168                   v-frame-width = frame Dialog-Frame:width - 0.3
     1169                   fh            = frame Dialog-Frame:first-child
     1170                   hh            = fh:first-child
     1171                   ii            = 1
     1172                   .
     1173               do while valid-handle(hh):
     1174                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1175                   do:
     1176                       case lc(hh:name) :
     1177                           when "b-help" then
     1178                               do:
     1179                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1180                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1181                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1182                                   hh:TOOLTIP = "Помощь" .
     1183                                   v-help-old-x = hh:column .
     1184                                   v-help-old-y = hh:row    .
     1185                                   v-help-old-size = hh:width .
     1186                                   hh:width-chars = 2.5 .
     1187                               end.
     1188                           when "b-print" then
     1189                               do:
     1190                                   hh:load-image("cmp/b-print.bmp":u) .
     1191                                   hh:TOOLTIP = "Печать" .
     1192                                   v-h[ii] = hh:handle .
     1193                                   ii = ii + 1 .
     1194                                   hh:width-chars = 3 .
     1195                               end.
     1196                           when "b-history" or
     1197                           when "b-hist" then
     1198                               do:
     1199                                   hh:load-image("cmp/b-hist.bmp":u) .
     1200                                   hh:TOOLTIP = "История" .
     1201                                   v-h[ii] = hh:handle .
     1202                                   ii = ii + 1 .
     1203                                   hh:width-chars = 3 .
     1204                               end.
     1205                           when "b-sch" then
     1206                               do:
     1207                                   hh:load-image("cmp/b-sch.bmp":u) .
     1208                                   hh:TOOLTIP = "Установка Фильтра" .
     1209                                   v-h[ii] = hh:handle .
     1210                                   ii = ii + 1 .
     1211                                   hh:width-chars = 3 .
     1212                               end.
     1213                           when "b-hist-user" then
     1214                               do:
     1215                                   hh:load-image("cmp/b-hist.bmp":u) .
     1216                                   hh:TOOLTIP = "История пользователя" .
     1217                                   ii = ii + 1 .
     1218                               end.
     1219                       end case.
     1220                   end.
     1221                   hh = hh:next-sibling.
     1222               end.
     1223               b-help:column = v-frame-width - b-help:width-chars.
     1224               jj = 0.
     1225               repeat ii = 4 to 1 by -1 :
     1226                   if valid-handle (v-h[ii] ) then
     1227                   do:
     1228                       jj  = jj + 1 .
     1229                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1230                       v-h[ii]:row    = v-help-old-y .
     1231                   end.
     1232               end.
     1233           end.
     1234       end.
     1235   end procedure.
     1236   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1237   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1238   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1239   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1240   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1241   define variable v-diasize-current-frame-height as decimal   no-undo .
     1242   define variable v-diasize-change-size          as logical   no-undo .
     1243   define variable v-diasize-resize-button        as handle    no-undo .
     1244   define variable v-diasize-wndmax               as logical   no-undo .
     1245   define variable v-diasize-wndstore             as logical   no-undo .
     1246   define variable v-diasize-proc-name            as character no-undo .
     1247   define variable v-diasize-browse-handle        as handle    no-undo .
     1248   define variable v-diasize-browse-number        as integer   no-undo .
     1249   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1250   define temp-table temp-diasize-handle no-undo
     1251     field handle-value  as handle
     1252     field save-position as decimal
     1253     index xpk is primary unique handle-value
     1254     .
     1255   define temp-table temp-browse-handle no-undo
     1256     field browse-type   as character
     1257     field browse-number as integer
     1258     field browse-handle as handle
     1259     field original-size as decimal
     1260     index xpk is primary unique browse-type browse-number
     1261     index xie browse-type browse-handle
     1262   .
     1263   procedure diasize_change-height :
     1264     define input  parameter p-change-value  as decimal   no-undo .
     1265     define input  parameter p-move-resize   as logical   no-undo .
     1266     define variable v-field-group-handle    as handle    no-undo .
     1267     define variable v-object-handle         as handle    no-undo .
     1268     define variable v-frame-height          as decimal   no-undo .
     1269     define variable v-frame-virtual-height  as decimal   no-undo .
     1270     define variable v-browse-height         as decimal   no-undo .
     1271     define variable v-window-height         as decimal   no-undo .
     1272     define variable v-window-virtual-height as decimal   no-undo .
     1273     define variable v-change-sign           as integer   no-undo .
     1274     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1275     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1276     if p-change-value > 0
     1277     then do:
     1278       if frame Dialog-Frame :height + p-change-value
     1279           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1280       then do:
     1281         assign
     1282           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1283                           - (frame Dialog-Frame :height-chars)
     1284         .
     1285         if p-change-value <= 0
     1286         then do:
     1287           run diasize_position-resize-button in this-procedure .
     1288           return .
     1289         end.
     1290       end.
     1291     end.
     1292     if p-change-value < 0
     1293     then do:
     1294       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1295       then do:
     1296         assign
     1297           p-change-value = v-diasize-orig-frame-height
     1298                          - (frame Dialog-Frame :height-chars)
     1299         .
     1300         if p-change-value >= 0
     1301         then do:
     1302           run diasize_position-resize-button in this-procedure .
     1303           return .
     1304         end.
     1305       end.
     1306     end.
     1307     if p-change-value >= 0
     1308     then do:
     1309       assign
     1310         v-change-sign = 1
     1311       .
     1312     end.
     1313     else do:
     1314       assign
     1315         v-change-sign = -1
     1316       .
     1317     end.
     1318     assign
     1319       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1320     .
     1321     if p-change-value = 0
     1322     then do:
     1323       run diasize_position-resize-button in this-procedure .
     1324       return .
     1325     end.
     1326     move_block:
     1327     do
     1328     on error undo move_block, retry move_block
     1329     :
     1330       if retry
     1331       then do:
     1332         do
     1333         on error undo move_block, leave move_block
     1334         :
     1335           if p-change-value > 0
     1336           then do:
     1337             for each buf_temp-diasize-handle
     1338             on error undo, next
     1339             :
     1340               assign
     1341                 v-object-handle = buf_temp-diasize-handle.handle-value
     1342               .
     1343               if v-object-handle <> v-diasize-resize-button
     1344               then do:
     1345                 assign
     1346                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1347                 .
     1348               end.
     1349             end.
     1350             assign
     1351               v-diasize-browse-handle :height = v-browse-height
     1352             .
     1353             for each buf_temp-browse-handle
     1354               where buf_temp-browse-handle.browse-type = 'height':u
     1355             on error undo, next
     1356             :
     1357               assign
     1358                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1359               .
     1360             end.
     1361             assign
     1362               frame Dialog-Frame :height = v-frame-height
     1363             .
     1364             if frame Dialog-Frame :scrollable = true
     1365             then do:
     1366               assign
     1367                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1368               .
     1369             end.
     1370             run diasize_position-resize-button in this-procedure .
     1371           end.
     1372           else do:
     1373             if frame Dialog-Frame :scrollable = true
     1374             then do:
     1375               assign
     1376                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1377               .
     1378             end.
     1379             assign
     1380               frame Dialog-Frame :height = v-frame-height
     1381             .
     1382             assign
     1383               v-diasize-browse-handle :height = v-browse-height
     1384             .
     1385             for each buf_temp-browse-handle
     1386               where buf_temp-browse-handle.browse-type = 'height':u
     1387             on error undo, next
     1388             :
     1389               assign
     1390                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1391               .
     1392             end.
     1393             for each buf_temp-diasize-handle
     1394             on error undo, next
     1395             :
     1396               assign
     1397                 v-object-handle = buf_temp-diasize-handle.handle-value
     1398               .
     1399               if v-object-handle <> v-diasize-resize-button
     1400               then do:
     1401                 assign
     1402                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1403                 .
     1404               end.
     1405             end.
     1406             run diasize_position-resize-button in this-procedure .
     1407           end.
     1408           assign
     1409             v-diasize-change-size = false
     1410           .
     1411           leave move_block .
     1412         end.
     1413       end.
     1414       assign
     1415         v-diasize-need-full-display = true
     1416       .
     1417       if v-diasize-change-size = false
     1418       then do:
     1419         assign
     1420           v-diasize-change-size = true
     1421         .
     1422       end.
     1423       else do:
     1424         return .
     1425       end.
     1426       assign
     1427         v-frame-height = frame Dialog-Frame :height
     1428         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1429         v-browse-height = v-diasize-browse-handle :height
     1430       .
     1431       for each buf_temp-browse-handle
     1432         where buf_temp-browse-handle.browse-type = 'height':u
     1433       :
     1434         assign
     1435           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1436         .
     1437       end.
     1438       for each buf_temp-diasize-handle
     1439       :
     1440         delete buf_temp-diasize-handle .
     1441       end.
     1442       assign
     1443         v-field-group-handle = frame Dialog-Frame :first-child
     1444       .
     1445       do while valid-handle(v-field-group-handle)
     1446       :
     1447         assign
     1448           v-object-handle = v-field-group-handle :first-child
     1449         .
     1450         do while valid-handle(v-object-handle)
     1451         :
     1452           if  v-object-handle <> v-diasize-browse-handle :handle
     1453           and can-query(v-object-handle, "row")
     1454           and can-query(v-object-handle, "height")
     1455           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1456           then do:
     1457             find first buf_temp-browse-handle
     1458               where buf_temp-browse-handle.browse-type   = 'height':u
     1459                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1460               no-error .
     1461             if available buf_temp-browse-handle
     1462             then do:
     1463             end.
     1464             else do:
     1465               create buf_temp-diasize-handle .
     1466               assign
     1467                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1468                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1469               .
     1470             end.
     1471           end.
     1472           assign
     1473             v-object-handle = v-object-handle :next-sibling
     1474           .
     1475         end.
     1476         assign
     1477           v-field-group-handle = v-field-group-handle :next-sibling
     1478         .
     1479       end.
     1480       do with frame Dialog-Frame
     1481       :
     1482         hide v-diasize-resize-button .
     1483         assign
     1484           v-diasize-resize-button :row    = 1
     1485           v-diasize-resize-button :column = 1
     1486         .
     1487       end.
     1488       if p-change-value > 0
     1489       then do:
     1490         if frame Dialog-Frame :scrollable = true
     1491         then do:
     1492           assign
     1493             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1494             no-error .
     1495           if error-status :error
     1496           or error-status :get-message(1) <> ""
     1497           then do:
     1498             undo move_block, retry move_block .
     1499           end.
     1500         end.
     1501         assign
     1502           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1503           no-error .
     1504         if error-status :error
     1505         or error-status :get-message(1) <> ""
     1506         then do:
     1507           undo move_block, retry move_block .
     1508         end.
     1509         assign
     1510           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1511           no-error .
     1512         if error-status :error
     1513         or error-status :get-message(1) <> ""
     1514         then do:
     1515           undo move_block, retry move_block .
     1516         end.
     1517         for each buf_temp-browse-handle
     1518           where buf_temp-browse-handle.browse-type = 'height':u
     1519         on error undo move_block, retry move_block
     1520         :
     1521           assign
     1522             buf_temp-browse-handle.browse-handle :height
     1523               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1524             no-error .
     1525           if error-status :error
     1526           or error-status :get-message(1) <> ""
     1527           then do:
     1528             undo move_block, retry move_block .
     1529           end.
     1530         end.
     1531         for each buf_temp-diasize-handle
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             v-object-handle = buf_temp-diasize-handle.handle-value
     1536           .
     1537           if v-object-handle <> v-diasize-resize-button
     1538           then do:
     1539             assign
     1540               v-object-handle :row = v-object-handle :row + p-change-value
     1541               no-error .
     1542             if error-status :error
     1543             or error-status :get-message(1) <> ""
     1544             then do:
     1545               undo move_block, retry move_block .
     1546             end.
     1547           end.
     1548         end.
     1549       end.
     1550       else do:
     1551         for each buf_temp-diasize-handle
     1552         on error undo move_block, retry move_block
     1553         :
     1554           assign
     1555             v-object-handle = buf_temp-diasize-handle.handle-value
     1556           .
     1557           if v-object-handle <> v-diasize-resize-button
     1558           then do:
     1559             assign
     1560               v-object-handle :row = v-object-handle :row + p-change-value
     1561               no-error .
     1562             if error-status :error
     1563             or error-status :get-message(1) <> ""
     1564             then do:
     1565               undo move_block, retry move_block .
     1566             end.
     1567           end.
     1568         end.
     1569         assign
     1570           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1571           no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block .
     1576         end.
     1577         for each buf_temp-browse-handle
     1578           where buf_temp-browse-handle.browse-type = 'height':u
     1579         on error undo move_block, retry move_block
     1580         :
     1581           assign
     1582             buf_temp-browse-handle.browse-handle :height
     1583               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1584             no-error .
     1585           if error-status :error
     1586           or error-status :get-message(1) <> ""
     1587           then do:
     1588             undo move_block, retry move_block .
     1589           end.
     1590         end.
     1591         assign
     1592           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1593           no-error .
     1594         if error-status :error
     1595         or error-status :get-message(1) <> ""
     1596         then do:
     1597           undo move_block, retry move_block .
     1598         end.
     1599         if frame Dialog-Frame :scrollable = true
     1600         then do:
     1601           assign
     1602             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1603             no-error .
     1604           if error-status :error
     1605           or error-status :get-message(1) <> ""
     1606           then do:
     1607             undo move_block, retry move_block .
     1608           end.
     1609         end.
     1610       end.
     1611       if p-move-resize = true
     1612       then do:
     1613         run diasize_position-resize-button in this-procedure .
     1614       end.
     1615       if v-diasize-wndstore = true
     1616       then do:
     1617         if connected("ub") = true
     1618         then do:
     1619           define variable v-cntxt-db-num        as integer   no-undo .
     1620           define variable v-cntxt-userid        as character no-undo .
     1621           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1622                                             , OUTPUT v-cntxt-userid
     1623                                             ) .
     1624           run gbl/wndsizew.p
     1625             (input  v-cntxt-db-num
     1626             ,input  v-cntxt-userid
     1627             ,input  v-diasize-proc-name
     1628             ,input  'height':u
     1629             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1630             ) .
     1631         end.
     1632       end.
     1633     end.
     1634     assign
     1635       v-diasize-change-size = false
     1636     .
     1637   end procedure.
     1638   procedure diasize_set-height :
     1639     define input  parameter p-new-height  as decimal   no-undo .
     1640     define input  parameter p-move-resize as logical   no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       run diasize_change-height in this-procedure
     1645         (input  (p-new-height - frame Dialog-Frame :height)
     1646         ,input  p-move-resize
     1647         ) .
     1648     end.
     1649   end procedure.
     1650   procedure diasize_change-width :
     1651     define input  parameter p-change-value as decimal   no-undo .
     1652     define input  parameter p-move-resize  as logical   no-undo .
     1653     define variable v-field-group-handle   as handle    no-undo .
     1654     define variable v-object-handle        as handle    no-undo .
     1655     define variable v-frame-width          as decimal   no-undo .
     1656     define variable v-frame-virtual-width  as decimal   no-undo .
     1657     define variable v-browse-width         as decimal   no-undo .
     1658     define variable v-window-width         as decimal   no-undo .
     1659     define variable v-window-virtual-width as decimal   no-undo .
     1660     define variable v-change-sign          as integer   no-undo .
     1661     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1662     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1663     if p-change-value > 0
     1664     then do:
     1665       if frame Dialog-Frame :width + p-change-value >
     1666           session :width-chars
     1667       then do:
     1668         assign
     1669           p-change-value = session :width-chars - frame Dialog-Frame :width
     1670         .
     1671         if p-change-value <= 0
     1672         then do:
     1673           run diasize_position-resize-button in this-procedure .
     1674           return .
     1675         end.
     1676       end.
     1677     end.
     1678     if p-change-value < 0
     1679     then do:
     1680       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1681       then do:
     1682         assign
     1683           p-change-value = v-diasize-orig-frame-width
     1684                          - frame Dialog-Frame :width
     1685         .
     1686         if p-change-value >= 0
     1687         then do:
     1688           run diasize_position-resize-button in this-procedure .
     1689           return .
     1690         end.
     1691       end.
     1692     end.
     1693     if p-change-value >= 0
     1694     then do:
     1695       assign
     1696         v-change-sign = 1
     1697       .
     1698     end.
     1699     else do:
     1700       assign
     1701         v-change-sign = -1
     1702       .
     1703     end.
     1704     assign
     1705       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1706     .
     1707     if p-change-value = 0
     1708     then do:
     1709       run diasize_position-resize-button in this-procedure .
     1710       return .
     1711     end.
     1712     move_block:
     1713     do
     1714     on error undo move_block, leave move_block
     1715     :
     1716       if retry
     1717       then do:
     1718         do
     1719         on error undo move_block, leave move_block
     1720         :
     1721           if p-change-value > 0
     1722           then do:
     1723             for each buf_temp-diasize-handle
     1724             on error undo, next
     1725             :
     1726               assign
     1727                 v-object-handle = buf_temp-diasize-handle.handle-value
     1728               .
     1729               if v-object-handle <> v-diasize-resize-button
     1730               then do:
     1731                 assign
     1732                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1733                 .
     1734               end.
     1735             end.
     1736             assign
     1737               v-diasize-browse-handle :width = v-browse-width
     1738             .
     1739             for each buf_temp-browse-handle
     1740               where buf_temp-browse-handle.browse-type = 'width':u
     1741             on error undo, next
     1742             :
     1743               assign
     1744                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1745               .
     1746             end.
     1747             assign
     1748               frame Dialog-Frame :width = v-frame-width
     1749             .
     1750             if frame Dialog-Frame :scrollable = true
     1751             then do:
     1752               assign
     1753                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1754               .
     1755             end.
     1756             run diasize_position-resize-button in this-procedure .
     1757           end.
     1758           else do:
     1759             if frame Dialog-Frame :scrollable = true
     1760             then do:
     1761               assign
     1762                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1763               .
     1764             end.
     1765             assign
     1766               frame Dialog-Frame :width = v-frame-width
     1767             .
     1768             for each buf_temp-browse-handle
     1769               where buf_temp-browse-handle.browse-type = 'width':u
     1770             on error undo, next
     1771             :
     1772               assign
     1773                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1774               .
     1775             end.
     1776             assign
     1777               v-diasize-browse-handle :width = v-browse-width
     1778             .
     1779             for each buf_temp-diasize-handle
     1780             on error undo, next
     1781             :
     1782               assign
     1783                 v-object-handle = buf_temp-diasize-handle.handle-value
     1784               .
     1785               if v-object-handle <> v-diasize-resize-button
     1786               then do:
     1787                 assign
     1788                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1789                 .
     1790               end.
     1791             end.
     1792             run diasize_position-resize-button in this-procedure .
     1793           end.
     1794           assign
     1795             v-diasize-change-size = false
     1796           .
     1797           leave move_block .
     1798         end.
     1799       end.
     1800       assign
     1801         v-diasize-need-full-display = true
     1802       .
     1803       if v-diasize-change-size = false
     1804       then do:
     1805         assign
     1806           v-diasize-change-size = true
     1807         .
     1808       end.
     1809       else do:
     1810         return .
     1811       end.
     1812       assign
     1813         v-frame-width = frame Dialog-Frame :width
     1814         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1815         v-browse-width = v-diasize-browse-handle :width
     1816       .
     1817       for each buf_temp-browse-handle
     1818         where buf_temp-browse-handle.browse-type = 'width':u
     1819       :
     1820         assign
     1821           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1822         .
     1823       end.
     1824       for each buf_temp-diasize-handle
     1825       :
     1826         delete buf_temp-diasize-handle .
     1827       end.
     1828       assign
     1829         v-field-group-handle = frame Dialog-Frame :first-child
     1830       .
     1831       do while valid-handle(v-field-group-handle)
     1832       :
     1833         assign
     1834           v-object-handle = v-field-group-handle :first-child
     1835         .
     1836         do while valid-handle(v-object-handle)
     1837         :
     1838           if  v-object-handle <> v-diasize-browse-handle :handle
     1839           and v-object-handle <> v-diasize-resize-button
     1840           and can-query(v-object-handle, "row")
     1841           and can-query(v-object-handle, "height")
     1842           and ( v-object-handle :col + v-object-handle :width
     1843                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1844               )
     1845           then do:
     1846             find first buf_temp-browse-handle
     1847               where buf_temp-browse-handle.browse-type   = 'width':u
     1848                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1849               no-error .
     1850             if available buf_temp-browse-handle
     1851             then do:
     1852             end.
     1853             else do:
     1854               create buf_temp-diasize-handle .
     1855               assign
     1856                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1857                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1858               .
     1859             end.
     1860           end.
     1861           assign
     1862             v-object-handle = v-object-handle :next-sibling
     1863           .
     1864         end.
     1865         assign
     1866           v-field-group-handle = v-field-group-handle :next-sibling
     1867         .
     1868       end.
     1869       do with frame Dialog-Frame
     1870       :
     1871         hide v-diasize-resize-button .
     1872         v-diasize-resize-button :row = 1.
     1873         v-diasize-resize-button :column = 1.
     1874       end.
     1875       if p-change-value > 0
     1876       then do:
     1877         if frame Dialog-Frame :scrollable = true
     1878         then do:
     1879           assign
     1880             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1881             no-error .
     1882           if error-status :error
     1883           or error-status :get-message(1) <> ""
     1884           then do:
     1885             undo move_block, retry move_block.
     1886           end.
     1887         end.
     1888         assign
     1889           frame Dialog-Frame :width = v-frame-width + p-change-value
     1890           no-error .
     1891         if error-status :error
     1892         or error-status :get-message(1) <> ""
     1893         then do:
     1894           undo move_block, retry move_block.
     1895         end.
     1896         assign
     1897           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1898         no-error .
     1899         if error-status :error
     1900         or error-status :get-message(1) <> ""
     1901         then do:
     1902           undo move_block, retry move_block.
     1903         end.
     1904         for each buf_temp-browse-handle
     1905           where buf_temp-browse-handle.browse-type = 'width':u
     1906         on error undo move_block, retry move_block
     1907         :
     1908           assign
     1909             buf_temp-browse-handle.browse-handle :width
     1910               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1911             no-error .
     1912           if error-status :error
     1913           or error-status :get-message(1) <> ""
     1914           then do:
     1915             undo move_block, retry move_block .
     1916           end.
     1917         end.
     1918         for each buf_temp-diasize-handle
     1919         on error undo move_block, retry move_block
     1920         :
     1921           assign
     1922             v-object-handle = buf_temp-diasize-handle.handle-value
     1923           .
     1924           if v-object-handle <> v-diasize-resize-button
     1925           then do:
     1926             assign
     1927               v-object-handle :col = v-object-handle :col + p-change-value
     1928               no-error .
     1929             if error-status :error
     1930             or error-status :get-message(1) <> ""
     1931             then do:
     1932               undo move_block, retry move_block .
     1933             end.
     1934           end.
     1935         end.
     1936       end.
     1937       else do:
     1938         for each buf_temp-diasize-handle
     1939         on error undo move_block, retry move_block
     1940         :
     1941           assign
     1942             v-object-handle = buf_temp-diasize-handle.handle-value
     1943           .
     1944           if v-object-handle <> v-diasize-resize-button
     1945           then do:
     1946             assign
     1947               v-object-handle :col = v-object-handle :col + p-change-value
     1948               no-error .
     1949             if error-status :error
     1950             or error-status :get-message(1) <> ""
     1951             then do:
     1952               undo move_block, retry move_block .
     1953             end.
     1954           end.
     1955         end.
     1956         for each buf_temp-browse-handle
     1957           where buf_temp-browse-handle.browse-type = 'width':u
     1958         on error undo move_block, retry move_block
     1959         :
     1960           assign
     1961             buf_temp-browse-handle.browse-handle :width
     1962               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1963             no-error .
     1964           if error-status :error
     1965           or error-status :get-message(1) <> ""
     1966           then do:
     1967             undo move_block, retry move_block .
     1968           end.
     1969         end.
     1970         assign
     1971           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1972           no-error .
     1973         if error-status :error
     1974         or error-status :get-message(1) <> ""
     1975         then do:
     1976           undo move_block, retry move_block.
     1977         end.
     1978         assign
     1979           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1980         no-error .
     1981         if error-status :error
     1982         or error-status :get-message(1) <> ""
     1983         then do:
     1984           undo move_block, retry move_block.
     1985         end.
     1986         if frame Dialog-Frame :scrollable = true
     1987         then do:
     1988           assign
     1989             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1990           no-error .
     1991           if error-status :error
     1992           or error-status :get-message(1) <> ""
     1993           then do:
     1994             undo move_block, retry move_block.
     1995           end.
     1996         end.
     1997       end.
     1998       if p-move-resize
     1999       then do:
     2000         run diasize_position-resize-button in this-procedure .
     2001       end.
     2002       if v-diasize-wndstore = true
     2003       then do:
     2004         if connected("ub") = true
     2005         then do:
     2006           define variable v-cntxt-db-num        as integer   no-undo .
     2007           define variable v-cntxt-userid        as character no-undo .
     2008           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2009                                             , OUTPUT v-cntxt-userid
     2010                                             ) .
     2011           run gbl/wndsizew.p
     2012             (input  v-cntxt-db-num
     2013             ,input  v-cntxt-userid
     2014             ,input  v-diasize-proc-name
     2015             ,input  'width':u
     2016             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2017             ) .
     2018         end.
     2019       end.
     2020     end.
     2021     assign
     2022       v-diasize-change-size = false
     2023     .
     2024   end procedure.
     2025   procedure diasize_set-width :
     2026     define input  parameter p-new-width  as decimal   no-undo .
     2027     define input  parameter p-move-resize as logical   no-undo .
     2028     do
     2029     on error undo, return error return-value
     2030     :
     2031       run diasize_change-width in this-procedure
     2032         (input  (p-new-width - frame Dialog-Frame :width)
     2033         ,input  p-move-resize
     2034         ) .
     2035     end.
     2036   end procedure.
     2037   procedure diasize_position-resize-button :
     2038     do with frame Dialog-Frame
     2039     :
     2040       hide v-diasize-resize-button .
     2041       assign
     2042         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2043                     - 1
     2044                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2045         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2046                     - 1
     2047                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2048       .
     2049       view v-diasize-resize-button .
     2050     end.
     2051   end procedure.
     2052   on alt-right anywhere
     2053   do:
     2054     run diasize_change-width in this-procedure
     2055       (input 1
     2056       ,input true
     2057       ) .
     2058     return no-apply .
     2059   end.
     2060   on alt-left anywhere
     2061   do:
     2062     run diasize_change-width in this-procedure
     2063       (input -1
     2064       ,input true
     2065       ) .
     2066     return no-apply .
     2067   end.
     2068   on alt-down anywhere
     2069   do:
     2070     run diasize_change-height in this-procedure
     2071       (input 1
     2072       ,input true
     2073       ) .
     2074     return no-apply .
     2075   end.
     2076   on alt-up anywhere
     2077   do:
     2078     run diasize_change-height in this-procedure
     2079       (input -1
     2080       ,input true
     2081       ) .
     2082     return no-apply .
     2083   end.
     2084   on alt-enter of frame Dialog-Frame
     2085   do:
     2086     run diasize_maximize in this-procedure
     2087       (input  ?
     2088       ).
     2089     return no-apply .
     2090   end.
     2091   procedure diasize_end-move :
     2092     do
     2093     on error undo, return error return-value
     2094     :
     2095       define variable v-row-delta as decimal   no-undo .
     2096       define variable v-col-delta as decimal   no-undo .
     2097       define variable v-new-row as decimal   no-undo .
     2098       define variable v-new-col as decimal   no-undo .
     2099       assign
     2100         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2101         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2102       .
     2103       assign
     2104         v-row-delta = v-new-row - frame Dialog-Frame :height
     2105         v-col-delta = v-new-col - frame Dialog-Frame :width
     2106       .
     2107       run diasize_change-height in this-procedure
     2108         (input v-row-delta
     2109         ,input true
     2110         ) .
     2111       run diasize_change-width in this-procedure
     2112         (input v-col-delta
     2113         ,input true
     2114         ) .
     2115     end.
     2116   end procedure.
     2117   procedure diasize_maximize :
     2118     define input  parameter p-action as logical   no-undo .
     2119     do
     2120     on error undo, return error return-value
     2121     :
     2122       if p-action = ?
     2123       then do:
     2124         if v-diasize-need-maximize = true
     2125         then do:
     2126           assign
     2127             p-action = true
     2128           .
     2129         end.
     2130         else do:
     2131           assign
     2132             p-action = false
     2133           .
     2134         end.
     2135       end.
     2136       if p-action = true
     2137       then do:
     2138         run diasize_change-height in this-procedure
     2139           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2140               - frame Dialog-Frame :height-chars
     2141           ,input true
     2142           ) .
     2143         run diasize_change-width in this-procedure
     2144           (input session :width-chars
     2145               - frame Dialog-Frame :width-chars
     2146           ,input true
     2147           ) .
     2148         assign
     2149           v-diasize-need-maximize = false
     2150         .
     2151       end.
     2152       else do:
     2153         run diasize_change-width in this-procedure
     2154           (input v-diasize-orig-frame-width
     2155               - frame Dialog-Frame :width-chars
     2156           ,input true
     2157           ) .
     2158         run diasize_change-height in this-procedure
     2159           (input v-diasize-orig-frame-height
     2160               - frame Dialog-Frame :height-chars
     2161           ,input true
     2162           ) .
     2163         assign
     2164           v-diasize-need-maximize = true
     2165         .
     2166       end.
     2167     end.
     2168   end procedure.
     2169   procedure diasize_restore-orig-size :
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       assign
     2174         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2175         v-diasize-current-frame-height = frame Dialog-Frame :height
     2176       .
     2177       run diasize_set-height in this-procedure
     2178         (input  v-diasize-orig-frame-height
     2179         ,input  true
     2180         ) .
     2181       run diasize_set-width in this-procedure
     2182         (input  v-diasize-orig-frame-width
     2183         ,input  true
     2184         ) .
     2185     end.
     2186   end procedure.
     2187   procedure diasize_restore-current-size :
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       run diasize_set-height in this-procedure
     2192         (input  v-diasize-current-frame-height
     2193         ,input  true
     2194         ) .
     2195       run diasize_set-width in this-procedure
     2196         (input  v-diasize-current-frame-width
     2197         ,input  true
     2198         ) .
     2199     end.
     2200   end procedure.
     2201   procedure diasize_set-browse-handle :
     2202     define input  parameter p-browse-handle as handle   no-undo .
     2203     define buffer buf_temp-browse-handle for temp-browse-handle .
     2204     do
     2205     on error undo, return error return-value
     2206     :
     2207       assign
     2208         v-diasize-browse-handle = p-browse-handle
     2209       .
     2210       for each buf_temp-browse-handle
     2211       on error undo, return error return-value
     2212       :
     2213         delete buf_temp-browse-handle .
     2214       end.
     2215     end.
     2216   end procedure.
     2217   procedure diasize_add_browse :
     2218     define input  parameter p-browse-type   as character no-undo .
     2219     define input  parameter p-browse-handle as handle    no-undo .
     2220     define buffer buf_temp-browse-handle for temp-browse-handle .
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       assign
     2225         v-diasize-browse-number = v-diasize-browse-number + 1
     2226       .
     2227       create buf_temp-browse-handle .
     2228       assign
     2229         buf_temp-browse-handle.browse-type   = p-browse-type
     2230         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2231         buf_temp-browse-handle.browse-handle = p-browse-handle
     2232       .
     2233     end.
     2234   end procedure.
     2235   procedure diasize_init :
     2236     define variable v-default-value    as logical   no-undo .
     2237     define variable v-restore-saved    as logical   no-undo .
     2238     define variable v-resize-value-str as character no-undo .
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242       do with frame Dialog-Frame
     2243       :
     2244         assign
     2245           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2246           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2247           v-diasize-browse-handle     = browse BR-nc :handle
     2248         .
     2249         create button v-diasize-resize-button
     2250         assign
     2251           parent        = frame Dialog-Frame :first-child
     2252           label         = "s"
     2253           height-pixels = 16
     2254           width-pixels  = 16
     2255           visible       = true
     2256           sensitive     = true
     2257           movable       = true
     2258           triggers:
     2259             on end-move persistent run diasize_end-move in this-procedure .
     2260           end triggers.
     2261         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2262         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2263         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2264         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2265         assign
     2266           v-diasize-wndmax = false
     2267         .
     2268         if connected("ub") = true
     2269         then do:
     2270           define variable v-cntxt-db-num        as integer   no-undo .
     2271           define variable v-cntxt-userid        as character no-undo .
     2272           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2273                                             , OUTPUT v-cntxt-userid
     2274                                             ) .
     2275           run gbl/wndpar_r.p
     2276             (input  v-cntxt-db-num
     2277             ,input  v-cntxt-userid
     2278             ,input  'wndmax':U
     2279             ,output v-diasize-wndmax
     2280             ,output v-default-value
     2281             ) .
     2282         end.
     2283         assign
     2284           v-diasize-wndstore = false
     2285         .
     2286         if connected("ub") = true
     2287         then do:
     2288           run gbl/wndpar_r.p
     2289             (input  v-cntxt-db-num
     2290             ,input  v-cntxt-userid
     2291             ,input  'wndstore':U
     2292             ,output v-diasize-wndstore
     2293             ,output v-default-value
     2294             ) .
     2295         end.
     2296         assign
     2297           v-diasize-proc-name = entry(1, program-name(2), '.')
     2298         .
     2299         if v-diasize-wndstore = true
     2300         then do:
     2301           assign
     2302             v-restore-saved = false
     2303           .
     2304           if connected("ub") = true
     2305           then do:
     2306             run gbl/wndsizer.p
     2307               (input  v-cntxt-db-num
     2308               ,input  v-cntxt-userid
     2309               ,input  v-diasize-proc-name
     2310               ,input  'height':u
     2311               ,output v-resize-value-str
     2312               ) .
     2313             if v-resize-value-str <> '':U
     2314             then do:
     2315               run diasize_change-height in this-procedure
     2316                 (input  integer(v-resize-value-str)
     2317                 ,input  true
     2318                 ) .
     2319               assign
     2320                 v-restore-saved = true
     2321               .
     2322             end.
     2323           end.
     2324           if connected("ub") = true
     2325           then do:
     2326             run gbl/wndsizer.p
     2327               (input  v-cntxt-db-num
     2328               ,input  v-cntxt-userid
     2329               ,input  v-diasize-proc-name
     2330               ,input  'width':u
     2331               ,output v-resize-value-str
     2332               ) .
     2333             if v-resize-value-str <> '':U
     2334             then do:
     2335               run diasize_change-width in this-procedure
     2336                 (input  integer(v-resize-value-str)
     2337                 ,input  true
     2338                 ) .
     2339               assign
     2340                 v-restore-saved = true
     2341               .
     2342             end.
     2343           end.
     2344           if v-restore-saved <> true
     2345           then do:
     2346             if v-diasize-wndmax = true
     2347             then do:
     2348               run diasize_maximize in this-procedure
     2349                 (input  true
     2350                 ) .
     2351             end.
     2352           end.
     2353         end.
     2354         else do:
     2355           if v-diasize-wndmax = true
     2356           then do:
     2357             run diasize_maximize in this-procedure
     2358               (input  true
     2359               ) .
     2360           end.
     2361         end.
     2362       end.
     2363     end.
     2364   end procedure.
     2365   procedure diasize_need-full-display :
     2366     define output parameter p-need-full-display as logical   no-undo .
     2367     do
     2368     on error undo, return error return-value
     2369     :
     2370       assign
     2371         p-need-full-display = v-diasize-need-full-display
     2372       .
     2373       assign
     2374         v-diasize-need-full-display = false
     2375       .
     2376     end.
     2377   end procedure.
     2378   procedure get-context :
     2379      define output parameter p-db-num as integer          no-undo.
     2380      define output parameter p-user-id as character        no-undo.
     2381      define variable v-login               as character    no-undo.
     2382      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2383      define buffer buf_user-login  for ub.user-login .
     2384      do
     2385      on error undo, return error
     2386      :
     2387            FIND FIRST buf_sys-ctrl no-lock.
     2388            ASSIGN
     2389               v-login = USERID("ub")
     2390               p-db-num = buf_sys-ctrl.db-num
     2391            .
     2392            FIND FIRST buf_user-login
     2393                 WHERE buf_user-login.db-num = p-db-num
     2394                   AND buf_user-login.user-login = v-login
     2395                 no-lock
     2396                 no-error
     2397                 .
     2398            IF AVAILABLE buf_user-login
     2399            THEN DO:
     2400               assign
     2401                  p-user-id = buf_user-login.user-id
     2402               .
     2403            END.
     2404      end.
     2405   end procedure.
     2406       run diasize_init in this-procedure .
     2407   MAIN-BLOCK:
     2408   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2409      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2410   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2411     run mainmenu_getcntxt in parparentproc
     2412       (output v-cntxt-db-num
     2413       ,output v-cntxt-userid
     2414       ,output v-cntxt-level
     2415       ,output v-cntxt-host-code-obj
     2416       ,output v-cntxt-obj-type
     2417       ,output v-cntxt-obj-code
     2418       ,output v-cntxt-db-num-obj
     2419       ,output v-cntxt-is-admin
     2420       ) .
     2421   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2422   on F9 of frame Dialog-Frame anywhere do:
     2423     run get-good.
     2424     if gds-rec = ? then
     2425       return no-apply.
     2426     run ref/gds-form.w ( input parparentproc
     2427                         ,input 'ПРОСМОТР':U
     2428                         ,input ?
     2429                         ,input ?
     2430                         ,input ?
     2431                         ,input-output gds-rec).
     2432     apply "entry" to br-nc in frame Dialog-Frame.
     2433     return no-apply.
     2434   end.
     2435   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2436   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2437     (output v-curr-r-b
     2438     )  .
     2439     RUN fill-table IN THIS-PROCEDURE NO-ERROR.
     2440     IF NOT CAN-FIND (FIRST nc) THEN DO:
     2441         message
     2442         "Не найдено чеков, по которым цена чека отличается от цены документа!"
     2443         view-as alert-box.
     2444         RETURN.
     2445     END.
     2446     RUN enable_UI.
     2447     RUN MyEnable.
     2448     WAIT-FOR GO OF FRAME Dialog-Frame.
     2449   END.
     2450   RUN disable_UI.
     2451   PROCEDURE disable_UI :
     2452     HIDE FRAME Dialog-Frame.
     2453   END PROCEDURE.
     2454   PROCEDURE enable_UI :
     2455     DISPLAY pr-name
     2456         WITH FRAME Dialog-Frame.
     2457     ENABLE B-exit b-lkp b-print B-help BR-nc pr-name
     2458         WITH FRAME Dialog-Frame.
     2459     VIEW FRAME Dialog-Frame.
     2460     OPEN QUERY BR-nc FOR EACH nc NO-LOCK INDEXED-REPOSITION.
     2461   END PROCEDURE.
     2462   PROCEDURE fill-table :
     2463   define buffer b-goods for ub.goods.
     2464   define buffer b-gds-dtl for ub.gds-dtl.
     2465   define variable for-price as decimal no-undo.
     2466   define variable for-qnty as decimal no-undo.
     2467   define variable for-artic like ub.goods.artic no-undo.
     2468   define variable for-prod-type like ub.goods.prod-type no-undo.
     2469   define variable for-prod-code like ub.goods.prod-code no-undo.
     2470   define variable for-node-code like ub.bar-code.node-code no-undo.
     2471   define variable for-prt-root like ub.goods.prt-root no-undo.
     2472   define variable for-gds-name like ub.goods.gds-name no-undo.
     2473   define variable for-gds-code like ub.goods.gds-code no-undo.
     2474   define variable v-doc-kind as character no-undo .
     2475   define variable v-create as logical no-undo .
     2476   define variable v-dopi as integer no-undo .
     2477   define buffer buf_chk-doc for ub.chk-doc.
     2478   DEFINE BUFFER buf-bar   FOR ub.bar-code.
     2479   define buffer buf_temp-sale-price for temp-sale-price.
     2480   define buffer buf_sale-doc for ub.sale-doc.
     2481   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2483   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2484   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2485   define variable gp-excise     like ub.price-list.excise     no-undo.
     2486   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2487   define variable gp-fact-order as decimal   no-undo .
     2488   define variable gp-price-sale-parts as decimal   no-undo .
     2489   run waitfram-show in this-procedure ( input "Ждите...").
     2490   FOR EACH nc:
     2491     DELETE nc.
     2492   END.
     2493   _chkgds:
     2494   FOR EACH ub.chk-gds NO-LOCK WHERE
     2495            ub.chk-gds.out-code = ink-doc.inkas-code break by ub.chk-gds.b-code:
     2496     IF FIRST-OF(ub.chk-gds.b-code) then do:
     2497       for each buf_temp-sale-price :
     2498         delete buf_temp-sale-price.
     2499       end.
     2500       FIND FIRST buf-bar WHERE buf-bar.b-code = ub.chk-gds.b-code NO-LOCK .
     2501       FIND FIRST b-goods WHERE b-goods.gds-code = buf-bar.gds-code No-LOCK.
     2502       assign
     2503       for-gds-code = b-goods.gds-code
     2504       for-artic = b-goods.artic
     2505       for-prod-type = b-goods.prod-type
     2506       for-prod-code = b-goods.prod-code
     2507       for-node-code = buf-bar.node-code
     2508       for-gds-name = b-goods.gds-name
     2509       .
     2510       if NOT (prcl-spl OR ink-doc.status_ = 'факт':U) then do:
     2511   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   gp-fact-order = 0 .
     2513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2514     (input  for-gds-code
     2515     ,input  for-node-code
     2516     ,output gp-b-code
     2517     ) no-error .
     2518   if error-status:error then do:
     2519     message
     2520       error-status :get-message(1) skip
     2521       return-value skip
     2522       view-as alert-box error .
     2523     return error.
     2524   end.
     2525   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2527     (input  ink-doc.obj-type
     2528     ,input  ink-doc.obj-code
     2529     ,input  gp-b-code
     2530     ,input  0
     2531     ,input  gp-fact-order
     2532     ,output gp-doc-num
     2533     ,output gp-price-sale
     2534     ,output gp-road-tax
     2535     ,output gp-excise
     2536     ) no-error .
     2537   if error-status:error then do:
     2538     return error.
     2539   end.
     2540   gp-price-sale-parts = gp-price-sale.
     2541   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2542   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     2543     (input  ink-doc.obj-type
     2544     ,input  ink-doc.obj-code
     2545     ,input  gp-b-code
     2546     ,input  0
     2547     ,input  gp-fact-order
     2548     ,output gp-doc-num
     2549     ,output gp-price-sale-parts
     2550     ,output gp-road-tax
     2551     ,output gp-excise
     2552     ) no-error .
     2553   if error-status:error then do:
     2554     return error.
     2555   end.
     2556   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     2557       gp-price-sale = gp-price-sale-parts.
     2558    end.
     2559         if error-status:error then
     2560         assign
     2561         gp-price-sale = 0
     2562         for-price = 0
     2563         .
     2564         else
     2565         assign
     2566         for-price = gp-price-sale
     2567         .
     2568       end.
     2569       for each buf_sale-doc where
     2570               buf_sale-doc.inkas-code = ink-doc.inkas-code
     2571           and buf_sale-doc.order > 0 :
     2572         FIND FIRST b-gds-dtl WHERE
     2573                       b-gds-dtl.doc-code = buf_sale-doc.doc-code
     2574                  AND  b-gds-dtl.artic = b-goods.artic
     2575                  AND  b-gds-dtl.prod-code = b-goods.prod-code
     2576                  AND  b-gds-dtl.prod-type = b-goods.prod-type
     2577                  AND  b-gds-dtl.prt-code = buf-bar.node-code NO-ERROR .
     2578         IF NOT available b-gds-dtl  then NEXT _chkgds.
     2579         create buf_temp-sale-price.
     2580         assign
     2581         buf_temp-sale-price.price-r-b  = (if v-curr-r-b = 'base':U
     2582                                           then b-gds-dtl.price-base
     2583                                           else b-gds-dtl.price-rubl)
     2584         buf_temp-sale-price.doc-kind = buf_sale-doc.doc-kind
     2585         buf_temp-sale-price.doc-code = buf_sale-doc.doc-code
     2586         buf_temp-sale-price.fact-qnty = b-gds-dtl.fact-qnty
     2587         .
     2588       end.
     2589     end.
     2590     v-create = no.
     2591     assign
     2592     v-dopi = num-entries(chk-gds.line-type, chr(4))
     2593     no-error .
     2594     if not error-status:error
     2595     and v-dopi = 2
     2596     then do:
     2597       v-doc-kind = entry(1, entry(2, chk-gds.line-type, chr(4))).
     2598     end.
     2599     else do:
     2600       find first buf_chk-doc no-lock where
     2601               buf_chk-doc.doc-code = chk-gds.doc-code.
     2602       if buf_chk-doc.netto >= 0 then do:
     2603         v-doc-kind = 'es':U.
     2604       end.
     2605       else do:
     2606         v-doc-kind = 'rs':U.
     2607       end.
     2608     end.
     2609     find first buf_temp-sale-price where
     2610               buf_temp-sale-price.doc-kind = v-doc-kind
     2611           and buf_temp-sale-price.chr-office = entry(2, chk-gds.line-type, chr(4)) no-error.
     2612     if not available buf_temp-sale-price then nEXT _chkgds.
     2613     if NOT (prcl-spl OR ink-doc.status_ = 'факт':U)  then do:
     2614       if chk-gds.price-base <> for-price then v-create = yes.
     2615     end.
     2616     else do:
     2617       if chk-gds.price-base <> buf_temp-sale-price.price-r-b then v-create = yes.
     2618     end.
     2619     if v-create then do:
     2620       find first buf_chk-doc no-lock where
     2621               buf_chk-doc.doc-code = chk-gds.doc-code.
     2622       CREATE nc.
     2623       assign
     2624       nc.doc-code = buf_temp-sale-price.doc-code
     2625       nc.b-code = chk-gds.b-code
     2626       nc.artic = for-artic
     2627       nc.prod-type = for-prod-type
     2628       nc.prod-code = for-prod-code
     2629       nc.prt-code = for-node-code
     2630       nc.gds-name = for-gds-name
     2631       nc.chk-code = buf_chk-doc.doc-code
     2632       nc.cashier = buf_chk-doc.cashier
     2633       nc.price-r-b = buf_temp-sale-price.price-r-b
     2634       nc.price-chk  = chk-gds.price-base
     2635       nc.chk-qnty = chk-gds.doc-qnty
     2636       nc.fact-qnty = buf_temp-sale-price.fact-qnty
     2637       nc.discnt =  chk-gds.discnt
     2638       nc.chk-num =  buf_chk-doc.chk-num
     2639       nc.pay-desk = buf_chk-doc.pay-desk
     2640       .
     2641     end.
     2642   END.
     2643   run waitfram-hide in this-procedure .
     2644   END PROCEDURE.
     2645   PROCEDURE get-good :
     2646   DEFINE BUFFER buf_goods for ub.goods.
     2647   IF NOT AVAILABLE nc THEN gds-rec = ?.
     2648   gds-rec = ?.
     2649   FIND FIRST buf_goods NO-LOCK WHERE
     2650             buf_goods.artic = nc.artic
     2651      AND    buf_goods.prod-type = nc.prod-type
     2652       AND   buf_goods.prod-code = nc.prod-code NO-ERROR.
     2653   IF AVAILABLE buf_goods THEN DO:
     2654       gds-rec = RECID(buf_goods).
     2655   END.
     2656   END PROCEDURE.
     2657   PROCEDURE MyEnable :
     2658   IF p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2659     ENABLE b-del with frame Dialog-Frame.
     2660   end.
     2661   frame Dialog-Frame:title = frame Dialog-Frame:title + substitute(" - отчет о продаже N &1", ink-doc.inkas-code).
     2662   APPLY "ENTRY" to br-nc.
     2663   APPLY "VALUE-CHANGED" to br-nc.
     2664   END PROCEDURE.
     2665   PROCEDURE OpenBr :
     2666     OPEN QUERY BR-nc FOR EACH nc NO-LOCK INDEXED-REPOSITION.
     2667   END PROCEDURE.
     2668   PROCEDURE PrintProc :
     2669   define variable  date_string     as      char    no-undo.
     2670   define variable Line                as      char    no-undo.
     2671   define variable v-header-base-curr as character no-undo .
     2672   define variable v-base-code like ub.sysconf.base-code no-undo .
     2673   define buffer buf_inkas for ub.inkas.
     2674   define buffer buf_currency for ub.currency.
     2675   if v-curr-r-b = 'base':U then do:
     2676     find first buf_inkas no-lock where buf_inkas.inkas-code = ink-doc.inkas-code.
     2677   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2679     (input  buf_inkas.host-code
     2680     ,output v-base-code
     2681     )  .
     2682     find first buf_currency no-lock where
     2683             buf_currency.curr-code = v-base-code.
     2684     assign
     2685     v-header-base-curr = string( "( Б.Вал. - " + caps( buf_Currency.curr-abbr ) + " )" )
     2686     .
     2687   end.
     2688   DEFINE FRAME Chk-List
     2689   nc.b-code COLUMN-LABEL "Бар-код"
     2690   nc.artic COLUMN-LABEL "Артикул"
     2691   nc.gds-name FORMAT "X(30)"
     2692   nc.price-r-b COLUMN-LABEL "Цена док-та" FORMAT ">>>,>>9.99"
     2693   nc.price-chk COLUMN-LABEL "Цена чека" FORMAT ">>>,>>9.99"
     2694   nc.discnt COLUMN-LABEL "Скидка чека" FORMAT "->>,>>9.99"
     2695   nc.chk-qnty COLUMN-LABEL "Кол-во в чеке"
     2696   nc.fact-qnty COLUMN-LABEL "Кол-во док-та"
     2697   nc.chk-code COLUMN-LABEL "Код чека" FORMAT "x(20)"
     2698   nc.cashier COLUMN-LABEL "Кассир" FORMAT ">>9"
     2699   nc.chk-num COLUMN-LABEL "N по кассе" FORMAT "-99999"
     2700   nc.pay-desk
     2701   nc.doc-code COLUMN-LABEL "Док-т"
     2702   HEADER  date_string AT 5 format "X(35)"
     2703   v-header-base-curr        format "X(20)" AT 42
     2704   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     2705   Line format "X(177)" AT 1
     2706   with width 232 down stream-io use-text    .
     2707   Line = fill("-", 177).
     2708   date_string = cur-time-print() .
     2709   run prn-lib-open-stream  in this-procedure (
     2710                                                input parParentProc
     2711                                               ,input 43
     2712                                               ,input yes
     2713                                               ,input no
     2714                                               ).
     2715   PUT  STREAM PrnLibStream
     2716   SPACE(25) ( frame Dialog-Frame:title )
     2717   format "x(90)" SKIP(1) .
     2718   FORM HEADER
     2719           Line format "X(177)" AT 1 SKIP
     2720           "Продолжение - на следующей странице" AT 30 SKIP
     2721           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2722   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2723   FORM with FRAME Chk-List  .
     2724   run waitfram-show in this-procedure ("Ждите...").
     2725   GET next br-nc.
     2726   DO WHILE available nc :
     2727     Display STREAM PrnLibStream
     2728     nc.b-code
     2729     nc.artic
     2730     nc.gds-name
     2731     nc.price-r-b
     2732     nc.price-chk
     2733     nc.discnt
     2734     nc.chk-qnty
     2735     nc.fact-qnty
     2736     nc.chk-code
     2737     nc.cashier
     2738     nc.chk-num
     2739     nc.pay-desk
     2740     nc.doc-code
     2741     with FRAME Chk-List .
     2742     DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     2743     GET next br-nc.
     2744   END.
     2745   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2746   HIDE  STREAM PrnLibStream FRAME CheckList.
     2747   output  STREAM PrnLibStream CLOSE.
     2748   run waitfram-hide in this-procedure .
     2749   run prn-lib-prn-file in this-procedure (
     2750                                             input parParentProc
     2751                                             ,input 8
     2752                                             ).
     2753   END PROCEDURE.
