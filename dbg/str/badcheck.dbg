     1014       else do:
     1015           if avail nc then do:
     1016           FIND FIRST c-doc No-LOCK WHERE c-doc.doc-code = nc.chk-code NO-ERROR.
     1017           if NOT available c-doc then do:
     1018               message "Неправильно выбран чек." view-as alert-box ERROR.
     1019               return no-apply.
     1020           end.
     1021           run str/checkp.p (input parparentproc, c-doc.doc-code).
     1022           print-type = "".
     1023           end.
     1024           else do:
     1025           end.
     1026       end.
     1027   END.
     1028   ON VALUE-CHANGED OF BR-nc IN FRAME Dialog-Frame
     1029   DO:
     1030     FIND FIRST ub.clients No-LOCK WHERE ub.clients.obj-type = nc.prod-type AND
     1031                                      ub.clients.obj-code = nc.prod-code No-ERROR.
     1032       if avail ub.clients then do:
