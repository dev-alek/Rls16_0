     1037     FIND FIRST ub.goods No-LOCK WHERE ub.goods.artic = nc.artic AND
     1038                                    ub.goods.prod-type = nc.prod-type AND
     1039                                    ub.goods.prod-code = nc.prod-code No-ERROR.
     1040   END.
     1041   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1042   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1043   ASSIGN b-PRINT:POPUP-MENU IN FRAME Dialog-Frame = MENU m-print:HANDLE.
     1044   ASSIGN b-print:MENU-MOUSE = 1.
     1045   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   DEF VAR cur-clmn-numbr-nc as INT EXTENT 13 no-undo.
     1047   DEF VAR varmvibr-nc       as INT no-undo.
     1048   DEF VAR varmvjbr-nc       as INT no-undo.
     1049   DEF VAR varmvkbr-nc       as INT no-undo.
     1050   DEF VAR varmvlbr-nc       as INT no-undo.
     1051   DEF VAR move-elementbr-nc as INT no-undo.
     1052   def var jjbr-nc           as int no-undo.
     1053   do varmvibr-nc = 1 to EXTENT(cur-clmn-numbr-nc):
     1054     ASSIGN cur-clmn-numbr-nc[varmvibr-nc] = varmvibr-nc.
     1055   END.
     1056   RUN start-mv-clmnbr-nc.
     1057   PROCEDURE start-mv-clmnbr-nc:
     1058   def var old-session as logical no-undo.
     1059      old-session = SESSION:IMMEDIATE-DISPLAY.
     1060      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1061      SESSION:IMMEDIATE-DISPLAY = old-session.
     1062   END.
     1063   ON ctrl-cursor-right OF BROWSE br-nc do:
     1064     RUN re-move-clmnbr-nc ( 4, 13).
     1065   END.
     1066   ON ctrl-cursor-left OF BROWSE br-nc do:
     1067     RUN re-move-clmnbr-nc (13, 4).
     1068   END.
     1069   PROCEDURE re-move-clmnbr-nc:
     1070     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1071     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1072     DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
     1073       if cur-clmn-numbr-nc[varmvibr-nc] = source-column THEN cur-clmn-numbr-nc[varmvibr-nc] = -1.
     1074     END.
     1075     if br-nc:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     1076     if source-column > target-column THEN
     1077     DO varmvjbr-nc = source-column - 1 to target-column BY -1:
     1078       DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
     1079           if cur-clmn-numbr-nc[varmvibr-nc] = varmvjbr-nc THEN DO:
     1080             cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-numbr-nc[varmvibr-nc] + 1.
     1081           END.
     1082       END.
     1083     END.
     1084     ELSE
     1085     DO varmvjbr-nc = source-column + 1 to target-column:
     1086       DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
     1087         if cur-clmn-numbr-nc[varmvibr-nc] = varmvjbr-nc THEN DO:
     1088           cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-numbr-nc[varmvibr-nc] - 1.
     1089         END.
     1090       END.
     1091     END.
     1092     DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
     1093       if cur-clmn-numbr-nc[varmvibr-nc] = -1 THEN cur-clmn-numbr-nc[varmvibr-nc] = target-column.
     1094     END.
     1095   END PROCEDURE.
     1096   PROCEDURE ch-clmnbr-nc:
     1097     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1098     if cur-clmn-loc <= 4 then do:
     1099       return .
     1100     end.
     1101     DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
     1102       if cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-loc THEN move-elementbr-nc = varmvibr-nc.
     1103     END.
     1104     RUN re-move-clmnbr-nc (cur-clmn-loc, 4).
     1105   END PROCEDURE.
     1106   PROCEDURE mv-brw-defaultbr-nc:
     1107   def var old-session as logical no-undo.
     1108     old-session = SESSION:IMMEDIATE-DISPLAY.
     1109     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1110     do varmvlbr-nc = 4 to EXTENT(cur-clmn-numbr-nc):
     1111       RUN re-move-clmnbr-nc (cur-clmn-numbr-nc[varmvlbr-nc], varmvlbr-nc).
     1112     END.
     1113     RUN start-mv-clmnbr-nc.
     1114     SESSION:IMMEDIATE-DISPLAY = old-session.
     1115   END PROCEDURE.
     1116   .
     1117   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1118   do:
     1119     BR-nc :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1120   end.
