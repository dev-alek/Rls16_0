      894   END.
      895   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      896   DO:
      897   define variable glog as logical no-undo .
      898   defINE varIABLE for-chk-code like ub.chk-doc.doc-code.
      899   define buffer DELETE_CHK-DOC for UB.CHK-DOC.
      900   if avail nc then do:
      901       FIND FIRST ub.chk-doc No-LOCK WHERE ub.chk-doc.doc-code = nc.chk-code No-ERROR.
      902       if not avail ub.chk-doc then do:
      903           message "Неправильно выбран чек." view-as alert-box ERROR.
      904           return no-apply.
      905       end.
      906   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   do:
      908     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      909       (input  v-cntxt-db-num
      910       ,input  v-cntxt-userid
      911       ,input  0
      912       ,input  'actn_receipts_deletion':U
      913       ,input  'object':U
      914       ,input  ink-doc.host-code
      915       ,input  ink-doc.obj-type
      916       ,input  ink-doc.obj-code
      917       ,input  0
      918       ,input  0
      919       ,input  0
      920       ,input  true
      921       ,output glog
      922       )  .
      923   end.
      924       if NOT gLog then   return no-apply.
      925       if chk-doc.out-code <> ? then do:
      926         assign
      927         for-chk-code = chk-doc.doc-code
      928         .
      929         DO TRANSACTION:
      930             FIND DELETE_chk-doc where recid (DELETE_chk-doc) = RECID(CHK-DOC).
      931             run str/excl-chk.p (input parparentproc,  input v-curr-r-b, buffer DELETE_chk-doc) no-error.
      932             IF NOT ERROR-STATUS:ERROR THEN DO:
      933                 for each nc no-lock where nc.chk-code = for-chk-code:
      934                     delete nc.
      935                 end.
      936             END.
      937         END.
      938         if error-status:error then do:
