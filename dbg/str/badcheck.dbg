      533     .
      534   define new global shared variable mBatchMode as logical no-undo init ?.
      535   define variable mFramBachModHandle as handle no-undo.
      536   mFramBachModHandle = frame waitfram:handle.
      537   define variable mFameOldVis as logical no-undo.
      538   define variable mVisCUrentVin as logical no-undo.
      539   if session:batch-mode
      540   then
      541      mBatchMode = yes.
      542   if mBatchMode = ? then do:
      543     mVisCUrentVin = current-window:visible.
      544     mFameOldVis = mFramBachModHandle:visible.
      545     mFramBachModHandle:visible  = yes.
      546     mBatchMode = mFramBachModHandle:visible ne yes.
      547     mFramBachModHandle:visible = mFameOldVis.
      548     current-window:visible = mVisCUrentVin.
      549   end.
      550    if  log-manager:logfile-name ne ?
      551     then DO:
      552         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      553         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      554         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      555     end.
      556   on choose of B-WaitFramStop in frame waitfram
      557   do:
      558     mWaitFramStop = yes.
      559     mWaitFramStopUser = yes.
      560   end.
      561   function waitfram-check-timeout returns logical():
      562      define variable vtime as int64 no-undo.
      563      if mWaitFramStopTimeOut
      564      then
      565         return yes.
      566      vtime = ( now - mWaitFramStartProc ) / 1000 .
      567      if     mWaitFramTimeOut ne ?
      568         and mWaitFramTimeOut ne 0
      569         and mWaitFramTimeOut lt vtime
      570      then do:
      571         mWaitFramStopTimeOut = yes.
      572      end.
      573      return mWaitFramStopTimeOut.
      574   end.
      575   procedure waitfram-hide :
      576     if not session:batch-mode
      577     then do
      578     on error undo, return error return-value
      579     :
      580       pause 0 before-hide .
      581       if not mBatchMode then
      582         hide frame waitfram .
      583     if     not mWaitFramView
      584        and mWaitProcEvent
      585     then
      586       process events .
      587     end.
      588   end procedure.
      589   procedure waitfram-show :
      590     define input  parameter p-message as character no-undo .
      591     define variable v-left-margin as integer   no-undo .
      592     if not session:batch-mode
      593     then do
      594     on error undo, return error return-value
      595     :
      596       if length(p-message) <= 70 then do:
      597         assign
      598           v-left-margin = integer((70 - length(p-message)) / 2)
      599         .
      600         assign
      601           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      602         .
      603         assign
      604           v-waitfram-action01 = " "
      605           v-waitfram-action02 = " "
      606                                    + fill(" ", v-left-margin)
      607                                    + p-message
      608           v-waitfram-action03 = " "
      609         .
      610       end.
      611       else do:
      612         define variable vRindex1 as integer no-undo.
      613         define variable vRindex2 as integer no-undo.
      614         vRindex1 = r-index(p-message," ",70).
      615         if vRindex1 = 0
      616         then
      617            vRindex1 = 70.
      618         if length(p-message)  <= vRindex1 + 70 then do:
      619           assign
      620             v-waitfram-action01 = " "
      621             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      622             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      623           .
      624         end.
      625         else do:
      626           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      627           if vRindex2 <= vRindex1
      628           then
      629              vRindex2 = vRindex1 + 70.
      630           assign
      631             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      632             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      633             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      634           .
      635         end.
      636       end.
      637       B-viewProcInfo:visible   in frame waitfram = no.
      638       B-viewProcInfo:sensitive in frame waitfram = no.
      639       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      640       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      641       if  (   mWaitFramView
      642          or  mWaitProcEvent)
      643          and not mBatchMode
      644       then
      645          display
      646             v-waitfram-action01 skip
      647             v-waitfram-action02 skip
      648             v-waitfram-action03 skip
      649          with frame waitfram .
      650       if     mWaitFramView
      651          then do:
      652             if     mWaitFramInterval ne ?
      653                and not mBatchMode
      654             then
      655                wait-for go of frame waitfram pause mWaitFramInterval.
      656          end.
      657          else
      658             if     mWaitProcEvent
      659                and not mBatchMode
      660             then
      661                process events .
      662     end.
      663   end procedure.
      664      procedure waitfram-show-this:
      665         define input  parameter iInterval as int64 no-undo.
      666         define variable vtime as int64 no-undo.
      667         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      668         mWaitFramInterval = iInterval.
      669         run waitfram-show (substitute("&1&2 &3&4" ,
      670                                       mWaitFramTextBeg ,
      671                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      672                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      673                                       mWaitFramTextEnd
      674                                      )
      675                           ).
      676      end.
      677      procedure WaitFramRunPause:
      678         define input  parameter iInterval as dec no-undo.
      679         define variable vStart  as datetime-tz no-undo.
      680         define variable vend    as datetime-tz no-undo.
      681         define variable vint as int64 no-undo.
      682         define variable vOk as logical no-undo.
      683         vStart = now.
      684         vend   = vStart.
      685         publish "WaitFramPause" (iInterval,output vOk).
      686         vend   =  now.
      687         vint = vend - vStart.
      688         vint = iInterval - vint / 1000.
      689         if     not mWaitFramStop
      690            and (   vint > 0
      691                 or (    not vOk
      692                     and iInterval eq ?
      693                     )
      694                 )
      695         then
      696            run waitfram-show-this (iInterval).
      697         vend   =  now.
      698         vint = vend - vStart.
      699         vint = iInterval - vint / 1000.
      700         if     not mWaitFramStop
      701            and vint > 0
      702         then do:
      703            run gbl/pause.p (vint * 1000).
      704         end.
      705         if iInterval ne ?
      706         then
      707            publish "WaitFramStop".
      708         waitfram-check-timeout().
      709      end.
      710      procedure WaitFramWaitFor:
      711         define input  parameter iInterval as dec no-undo.
      712         assign
      713            mWaitFramStartProc   = now
      714            mWaitFramStopUser    = no
      715            mWaitFramStopTimeOut = no
      716         .
      717         block-wait:
      718         do while not mWaitFramStop:
      719            run WaitFramRunPause (iInterval).
      720            if  waitfram-check-timeout()
      721            then do:
      722               leave block-wait.
      723            end.
      724         end.
      725         run waitfram-hide.
      726      end.
      727   procedure waitfram-join :
      728     define input  parameter p-line-1  as character no-undo .
      729     define input  parameter p-line-2  as character no-undo .
      730     define input  parameter p-line-3  as character no-undo .
      731     define output parameter p-message as character no-undo .
      732     do
      733     on error undo, return error return-value
      734     :
      735       assign
      736         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      737                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      738                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      739       .
      740     end.
      741   end procedure.
      742   function waitfram-join-function returns character
      743     (input p-line-1 as character
      744     ,input p-line-2 as character
      745     ,input p-line-3 as character
      746     ).
      747     define variable v-message as character no-undo .
      748     run waitfram-join in this-procedure
      749       (input  p-line-1
      750       ,input  p-line-2
      751       ,input  p-line-3
      752       ,output v-message
      753       ) .
      754     return v-message .
      755   end function .
      756   procedure proc-alt-shift-f2:
      757     if not ibs.th.gbl.gbl-var:rcode
      758   then
      759     run gbl\inidebug.p .
      760   end.
      761   procedure proc-alt-shift-f3:
      762     run gbl/prvssinf.p
      763       ( input this-procedure
      764       ) .
      765   end.
      766   define variable v-inform-launched as logical no-undo initial false .
      767   procedure proc-alt-shift-f4:
      768     define variable v-action as character no-undo .
      769     if v-inform-launched = false then do:
      770       assign
      771         v-inform-launched = true
      772       .
      773       run gbl/d-inform.w
      774         (  input self
      775         ,  input this-procedure
      776         , output v-action
      777         ) no-error .
      778       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      779       assign
      780         v-inform-launched = false
      781       .
      782     end.
      783   end.
      784   procedure proc-alt-f1:
      785     run gbl/corrhelp.p
      786       (input this-procedure
      787       ) .
      788   end .
      789   on alt-shift-f2 anywhere do:
      790     run proc-alt-shift-f2.
      791   end.
      792   on alt-shift-f3 anywhere do:
      793     run proc-alt-shift-f3 in this-procedure .
      794   end.
      795   on alt-shift-f4 anywhere do:
      796     run proc-alt-shift-f4 in this-procedure.
      797   end.
      798   on alt-f1 anywhere do:
      799     run proc-alt-f1 in this-procedure .
      800   end.
