      940             substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
      941                     ,chk-doc.doc-code
      942                     ,chk-doc.out-code
      943                     , chr(10)
      944                     ,error-status:get-message(1)
      945                     ,return-value
      946                     )
      947             view-as alert-box ERROR.
      948             return no-apply.
      949         end.
      950         else do:
      951             for-return = yes.
      952         end.
      953         RUN OpenBr.
      954         return no-apply.
      955       end.
      956     end.
      957     else do:
      958         message "Неправильно выбран чек." view-as alert-box ERROR.
      959         return no-apply.
      960     end.
      961   END.
      962   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
