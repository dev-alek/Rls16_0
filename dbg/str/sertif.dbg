      512   procedure prn-lib-reportviewer :
      513     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      514     define input parameter p-report-name-html as character no-undo .
      515     define input parameter p-param        as character no-undo .
      516     define variable v-excel           as character no-undo init 'TRUE' .
      517     define variable v-value-character as character no-undo .
      518     define variable v-value-integer   as character no-undo .
      519     define variable v-value-date      as date      no-undo .
      520     define variable v-value-decimal   as decimal   no-undo .
      521     define variable rep-excel         as logical   no-undo .
      522     define variable excel-string      as character no-undo .
      523     define variable v-param-type      as character no-undo .
      524     define variable v-tth             as handle    no-undo .
      525     run adm/shattri.p (
      526       input "get":U
      527       ,input  ""
      528       ,input  0
      529       ,input  'report-glob':U
      530       ,input  'rep-excel':U
      531       ,output v-value-character
      532       ,output v-value-date
      533       ,output v-value-decimal
      534       ,output v-value-integer
      535       ,output rep-excel
      536       ,output v-param-type
      537       ,INPUT-OUTPUT table-handle v-tth
      538       )  .
      539     if rep-excel then v-excel = "TRUE" .
      540     else v-excel = "FALSE" .
      541     if p-param eq ""
      542     then
      543        p-param = "EXCEL:" + v-excel.
      544     else
      545        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      546     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      547   end procedure.
