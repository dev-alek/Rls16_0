      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define  stream PrnLibStream.
      369   procedure prn-lib-prn-file :
      370     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      371     define input parameter p-DIsabledoptions as integer no-undo .
      372     define variable v-report-name as character no-undo .
      373     define variable v-user-action as character no-undo .
      374     define variable v-printed     as logical   no-undo .
      375     define variable v-exist       as logical   no-undo .
      376     do
      377       on error undo, return error
      378       :
      379       run prn-lib-get-report-name  in this-procedure (
      380         input parParentProc
      381         ,output v-report-name
      382         ).
      383   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      385     (input  v-report-name
      386     ,input  2
      387     ,output v-exist
      388     )  .
      389       if NOT v-exist then
      390       DO:
      391         Message
      392           "Нет заданий на печать ! "
      393           view-as alert-box .
      394         Return  .
      395       End.
      396       run gbl/prnfilen.w
      397         (input  ""
      398         ,input  p-DisabledOptions
      399         ,input  string(v-report-name )
      400         ,input  7
      401         ,output v-user-action
      402         ,output v-printed
      403         ) .
      404       if v-printed then
      405       do:
      406         return "YES" .
      407       end.
      408       else
      409       do:
      410         return "NO" .
      411       end.
      412     end.
      413   end procedure.
      414   procedure prn-lib-open-stream :
      415     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      416     define input parameter p-page-size    as integer no-undo .
      417     define input parameter p-is-stream    as logical no-undo .
      418     define input parameter p-append       as logical no-undo .
      419     define variable v-report-name as character no-undo .
      420     do
      421       on error undo, return error
      422       :
      423       run prn-lib-get-report-name  in this-procedure (
      424         input parParentProc
      425         ,output v-report-name
      426         ).
      427       if p-is-stream then
      428       do:
      429         if p-append then
      430         do:
      431           output stream PrnLibStream to value( v-report-name )
      432             page-size value(p-page-size) append .
      433         end.
      434         if not p-append then
      435         do:
      436           output stream PrnLibStream to value( v-report-name )
      437             page-size value(p-page-size) .
      438         end.
      439       end.
      440       if not p-is-stream then
      441       do:
      442         if p-append then
      443         do:
      444           output to value( v-report-name )
      445             page-size value(p-page-size) append .
      446         end.
      447         if not p-append then
      448         do:
      449           output to value( v-report-name )
      450             page-size value(p-page-size) .
      451         end.
      452       end.
      453     end.
      454   end procedure.
      455   procedure prn-lib-open-exp :
      456     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      457     define input parameter p-is-stream    as logical no-undo .
      458     define input parameter p-is-append    as logical no-undo .
      459     define output parameter p-ReportFileName as char init "report" no-undo.
      460     define output parameter p-process as logical no-undo .
      461     define variable glog as logical no-undo .
      462     do
      463       on error undo, return error
      464       :
      465       SYSTEM-DIALOG GET-FILE p-ReportFileName
      466         TITLE      "Укажите путь"
      467         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      468         ASK-OVERWRITE
      469         CREATE-TEST-FILE
      470         SAVE-AS
      471         USE-FILENAME
      472         DEFAULT-EXTENSION "txt"
      473         UPDATE glog
      474         .
      475       if not glog then  return.
      476       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      477       if p-is-stream then
      478       do:
      479         if p-is-append then
      480         do:
      481           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      482         end.
      483         else
      484         do:
      485           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      486         end.
      487       end.
      488       else
      489       do:
      490         if p-is-append then
      491         do:
      492           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      493         end.
      494         else
      495         do:
      496           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      497         end.
      498       end.
      499       p-process = yes.
      500     end.
      501   end procedure.
      502   procedure prn-lib-get-report-name :
      503     define input parameter parParentProc  as widget-handle no-undo.
      504     define output parameter p-report-name as character no-undo .
      505     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      506   end procedure.
      507   procedure prn-lib-reportviewer-report-name :
      508     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      509     define input parameter p-report-name-html as character no-undo .
      510     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
