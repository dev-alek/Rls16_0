      577   define variable mFramBachModHandle as handle no-undo.
      578   mFramBachModHandle = frame waitfram:handle.
      579   define variable mFameOldVis as logical no-undo.
      580   define variable mVisCUrentVin as logical no-undo.
      581   if session:batch-mode
      582   then
      583      mBatchMode = yes.
      584   if mBatchMode = ? then do:
      585     mVisCUrentVin = current-window:visible.
      586     mFameOldVis = mFramBachModHandle:visible.
      587     mFramBachModHandle:visible  = yes.
      588     mBatchMode = mFramBachModHandle:visible ne yes.
      589     mFramBachModHandle:visible = mFameOldVis.
      590     current-window:visible = mVisCUrentVin.
      591   end.
      592    if  log-manager:logfile-name ne ?
      593     then DO:
      594         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      595         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      596         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      597     end.
      598   on choose of B-WaitFramStop in frame waitfram
      599   do:
      600     mWaitFramStop = yes.
      601     mWaitFramStopUser = yes.
      602   end.
      603   function waitfram-check-timeout returns logical():
      604      define variable vtime as int64 no-undo.
      605      if mWaitFramStopTimeOut
      606      then
      607         return yes.
      608      vtime = ( now - mWaitFramStartProc ) / 1000 .
      609      if     mWaitFramTimeOut ne ?
      610         and mWaitFramTimeOut ne 0
      611         and mWaitFramTimeOut lt vtime
      612      then do:
      613         mWaitFramStopTimeOut = yes.
      614      end.
      615      return mWaitFramStopTimeOut.
      616   end.
      617   procedure waitfram-hide :
      618     if not session:batch-mode
      619     then do
      620     on error undo, return error return-value
      621     :
      622       pause 0 before-hide .
      623       if not mBatchMode then
      624         hide frame waitfram .
      625     if     not mWaitFramView
      626        and mWaitProcEvent
      627     then
      628       process events .
      629     end.
      630   end procedure.
      631   procedure waitfram-show :
      632     define input  parameter p-message as character no-undo .
      633     define variable v-left-margin as integer   no-undo .
      634     if not session:batch-mode
      635     then do
      636     on error undo, return error return-value
      637     :
      638       if length(p-message) <= 70 then do:
      639         assign
      640           v-left-margin = integer((70 - length(p-message)) / 2)
      641         .
      642         assign
      643           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      644         .
      645         assign
      646           v-waitfram-action01 = " "
      647           v-waitfram-action02 = " "
      648                                    + fill(" ", v-left-margin)
      649                                    + p-message
      650           v-waitfram-action03 = " "
      651         .
      652       end.
      653       else do:
      654         define variable vRindex1 as integer no-undo.
      655         define variable vRindex2 as integer no-undo.
      656         vRindex1 = r-index(p-message," ",70).
      657         if vRindex1 = 0
      658         then
      659            vRindex1 = 70.
      660         if length(p-message)  <= vRindex1 + 70 then do:
      661           assign
      662             v-waitfram-action01 = " "
      663             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      665           .
      666         end.
      667         else do:
      668           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      669           if vRindex2 <= vRindex1
      670           then
      671              vRindex2 = vRindex1 + 70.
      672           assign
      673             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      674             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      675             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      676           .
      677         end.
      678       end.
      679       B-viewProcInfo:visible   in frame waitfram = no.
      680       B-viewProcInfo:sensitive in frame waitfram = no.
      681       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      682       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      683       if  (   mWaitFramView
      684          or  mWaitProcEvent)
      685          and not mBatchMode
      686       then
      687          display
      688             v-waitfram-action01 skip
      689             v-waitfram-action02 skip
      690             v-waitfram-action03 skip
      691          with frame waitfram .
      692       if     mWaitFramView
      693          then do:
      694             if     mWaitFramInterval ne ?
      695                and not mBatchMode
      696             then
      697                wait-for go of frame waitfram pause mWaitFramInterval.
      698          end.
      699          else
      700             if     mWaitProcEvent
      701                and not mBatchMode
      702             then
      703                process events .
      704     end.
      705   end procedure.
      706      procedure waitfram-show-this:
      707         define input  parameter iInterval as int64 no-undo.
      708         define variable vtime as int64 no-undo.
      709         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      710         mWaitFramInterval = iInterval.
      711         run waitfram-show (substitute("&1&2 &3&4" ,
      712                                       mWaitFramTextBeg ,
      713                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      714                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      715                                       mWaitFramTextEnd
      716                                      )
      717                           ).
      718      end.
      719      procedure WaitFramRunPause:
      720         define input  parameter iInterval as dec no-undo.
      721         define variable vStart  as datetime-tz no-undo.
      722         define variable vend    as datetime-tz no-undo.
      723         define variable vint as int64 no-undo.
      724         define variable vOk as logical no-undo.
      725         vStart = now.
      726         vend   = vStart.
      727         publish "WaitFramPause" (iInterval,output vOk).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and (   vint > 0
      733                 or (    not vOk
      734                     and iInterval eq ?
      735                     )
      736                 )
      737         then
      738            run waitfram-show-this (iInterval).
      739         vend   =  now.
      740         vint = vend - vStart.
      741         vint = iInterval - vint / 1000.
      742         if     not mWaitFramStop
      743            and vint > 0
      744         then do:
      745            run gbl/pause.p (vint * 1000).
      746         end.
      747         if iInterval ne ?
      748         then
      749            publish "WaitFramStop".
      750         waitfram-check-timeout().
      751      end.
      752      procedure WaitFramWaitFor:
      753         define input  parameter iInterval as dec no-undo.
      754         assign
      755            mWaitFramStartProc   = now
      756            mWaitFramStopUser    = no
      757            mWaitFramStopTimeOut = no
      758         .
      759         block-wait:
      760         do while not mWaitFramStop:
      761            run WaitFramRunPause (iInterval).
      762            if  waitfram-check-timeout()
      763            then do:
      764               leave block-wait.
      765            end.
      766         end.
      767         run waitfram-hide.
      768      end.
      769   procedure waitfram-join :
      770     define input  parameter p-line-1  as character no-undo .
      771     define input  parameter p-line-2  as character no-undo .
      772     define input  parameter p-line-3  as character no-undo .
      773     define output parameter p-message as character no-undo .
      774     do
      775     on error undo, return error return-value
      776     :
      777       assign
      778         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      779                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      780                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      781       .
      782     end.
      783   end procedure.
      784   function waitfram-join-function returns character
      785     (input p-line-1 as character
      786     ,input p-line-2 as character
      787     ,input p-line-3 as character
      788     ).
      789     define variable v-message as character no-undo .
      790     run waitfram-join in this-procedure
      791       (input  p-line-1
      792       ,input  p-line-2
      793       ,input  p-line-3
      794       ,output v-message
      795       ) .
      796     return v-message .
      797   end function .
      798   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   FUNCTION mark-string RETURNS CHARACTER
      800     ( input p-recid as recid, input mark-list as character  ) :
      801     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      802   END FUNCTION.
      803   define variable log-res     as log       no-undo.
      804   define variable rr          as recid     no-undo.
      805   define variable v_type      as char      no-undo.
      806   define variable v-is-deploy as logical   no-undo .
      807   define variable v-rid-list  as character no-undo .
      808   define variable v-sertif    as character no-undo .
      809   DEFINE BUTTON b-exit AUTO-GO
      810        LABEL "&Выход ":L
      811        SIZE 10 BY 1.
      812   DEFINE BUTTON b-mark
      813        LABEL "&*":L
      814        SIZE 3 BY 1.
      815   DEFINE BUTTON b-sel AUTO-GO
      816        LABEL "Вы&бор ":L
      817        SIZE 10 BY 1.
      818   DEFINE QUERY br-sertif FOR
      819         buf_sertif SCROLLING.
      820   DEFINE BROWSE br-sertif
      821     QUERY br-sertif NO-LOCK DISPLAY
      822     mark-string(recid(buf_sertif), v-sertif) COLUMN-LABEL "*" FORMAT "X(1)":U
      823     buf_sertif.BeginDate COLUMN-LABEL "Дата начала" FORMAT "99.99.9999":U
      824     buf_sertif.EndDate COLUMN-LABEL "Дата окончания" FORMAT "99.99.9999":U
      825     buf_sertif.Name_ COLUMN-LABEL "Наименование" FORMAT "X(30)":U
      826     buf_sertif.SerialNumber COLUMN-LABEL "Серийный номер" FORMAT "X(30)":U
      827       WITH SEPARATORS SIZE 96.5 BY 14.75 fit-last-column.
      828   DEFINE FRAME d-sertif
      829        b-exit AT ROW 1 COL 1
      830        b-mark AT ROW 1 COL 11
      831        b-sel AT ROW 1 COL 14
      832        br-sertif AT ROW 3 COL 1.5
      833        SPACE(0.37) SKIP(0.82)
      834       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      835            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      836            TITLE "Сертификаты":L.
      837   ASSIGN
      838          FRAME d-sertif:SCROLLABLE       = FALSE.
      839   ON GO OF FRAME d-sertif
      840   DO:
      841       p-rid-list = v-rid-list.
      842     END.
      843   ON CHOOSE OF b-mark IN FRAME d-sertif
      844   DO:
      845       define variable g-log as logical no-undo.
      846       if available buf_sertif then
      847       do:
      848         v-sertif = buf_sertif.SerialNumber .
      849   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   define variable v-str-recid8 as character no-undo .
      851   define variable v-num-entry8 as integer   no-undo .
      852   assign
      853     v-str-recid8 = trim( string( recid( buf_sertif ) , "->>>>>>>>>>>9":U ) )
      854     v-num-entry8 = lookup( v-str-recid8 , v-sertif )
      855   .
      856   if v-num-entry8 > 0 then do:
      857     assign
      858       entry( v-num-entry8, v-sertif ) = "":U
      859       v-sertif = trim( replace( v-sertif , chr(44) + chr(44) , chr(44) ) , chr(44) )
      860     .
      861   end.
      862   else do:
      863     assign
      864       v-sertif = v-sertif + ( if v-sertif = "":U then "":U else chr(44) ) + v-str-recid8
      865     .
      866   end.
      867         v-rid-list = string( buf_sertif.SerialNumber ) .
      868         g-log = br-sertif:refresh() .
      869         if last-event:function <> "mouse-select-dblclick" then
      870         do:
      871           g-log = br-sertif:select-next-row ().
      872           apply "value-changed" to br-sertif in frame d-sertif.
      873         end.
      874       end.
      875       apply "entry" to br-sertif in frame d-sertif.
      876     END.
      877   ON CHOOSE OF b-sel IN FRAME d-sertif
      878   DO:
      879       if ( available buf_sertif )
      880         AND ( v-rid-list = "" or b-mark:sensitive = no ) then
      881         v-rid-list = string( buf_sertif.SerialNumber ) .
      882     END.
      883   ON DEFAULT-ACTION OF br-sertif IN FRAME d-sertif
      884   DO:
      885       case yes:
      886         when  b-sel:sensitive THEN
      887           apply "CHOOSE":U to b-sel.
      888       end case.
      889     END.
      890   ON INSERT-MODE OF br-sertif IN FRAME d-sertif
      891   DO:
      892       if b-mark:sensitive in frame d-sertif then
      893         APPLY "CHOOSE" to b-mark.
      894       else
      895       do:
      896         if b-sel:sensitive in frame d-sertif then
      897           APPLY "CHOOSE" to b-sel.
      898       end.
      899     END.
      900   ON RETURN OF br-sertif IN FRAME d-sertif
      901   DO:
      902       apply "DEFAULT-ACTION":U to self.
      903     END.
      904   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sertif:PARENT eq ?
      905     THEN FRAME d-sertif:PARENT = ACTIVE-WINDOW.
      906   ON WINDOW-CLOSE OF FRAME d-sertif
      907     APPLY "END-ERROR":U TO SELF.
      908   MAIN-BLOCK:
      909   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      910     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      911   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      912     run mainmenu_getcntxt in parparentproc
      913       (output v-cntxt-db-num
      914       ,output v-cntxt-userid
      915       ,output v-cntxt-level
      916       ,output v-cntxt-host-code-obj
      917       ,output v-cntxt-obj-type
      918       ,output v-cntxt-obj-code
      919       ,output v-cntxt-db-num-obj
      920       ,output v-cntxt-is-admin
      921       ) .
      922     run init-temp .
      923     run enable_UI in this-procedure .
      924     if p-rid-list eq "" then
      925     WAIT-FOR GO OF FRAME d-sertif focus br-sertif.
      926   END.
      927   run disable_UI in this-procedure .
      928   PROCEDURE disable_UI :
      929     HIDE FRAME d-sertif.
      930   END PROCEDURE.
      931   PROCEDURE enable_UI :
      932     ENABLE
      933       br-sertif
      934       b-exit
      935       b-sel
      936       WITH FRAME d-sertif.
      937     disable
      938       b-mark
      939     with frame d-sertif .
      940     OPEN QUERY br-sertif FOR EACH buf_sertif NO-LOCK     BY buf_sertif.BeginDate.
      941     if available buf_sertif
      942       then log-res  = br-sertif:select-focused-row( ).
      943   END PROCEDURE.
      944   PROCEDURE init-temp :
      945   define variable vCertificates     as component-handle no-undo.
      946   define variable vCertificate     as component-handle no-undo.
      947   define variable mDiadocApi as component-handle no-undo.
      948   define variable vCertificateName  as component-handle no-undo .
      949   define variable vi as integer no-undo.
      950   create "Diadoc.DiadocClient":U mDiadocApi no-error.
      951   if mDiadocApi eq ?
      952   then do:
      953      message "Не установлена библиотека Диадок" skip error-status:get-message(1)
      954      view-as alert-box.
      955      return.
      956   end.
      957      vCertificates = mDiadocApi:GetPersonalCertificates(true).
      958      if vCertificates:count = 1 then do:
      959        v-rid-list = vCertificates:GetItem(0):SerialNumber .
      960        apply "GO" to FRAME d-sertif .
      961      end.
      962      else do:
      963      do vi = 1 to  vCertificates:count:
      964         vCertificate = vCertificates:GetItem(vi - 1).
      965         create tt-sertif .
      966         tt-sertif.Name_ = vCertificate:name .
      967         tt-sertif.BeginDate = vCertificate:begindate .
      968         tt-sertif.EndDate = vCertificate:enddate .
      969         tt-sertif.OrganizationName = vCertificate:OrganizationName .
      970         tt-sertif.SerialNumber = vCertificate:SerialNumber .
      971         tt-sertif.Thumbprint  = vCertificate:Thumbprint .
      972      end.
      973      end.
      974      OPEN QUERY br-sertif FOR EACH buf_sertif NO-LOCK     BY buf_sertif.BeginDate.
      975   END PROCEDURE.
