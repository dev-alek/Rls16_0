        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-cre-db-num as integer   no-undo .
        4   define input  parameter p-task-type  as character no-undo .
        5   define input  parameter p-task-num   as integer   no-undo .
        6   define input  parameter p-db-num     as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: 190dc748139a, 1744, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 14 12:46:21 2019 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: suz-shd.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/suz-shd.p $":U .
       12   define variable vss-description as character no-undo init "АвтоРасчет отчетов )".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = 'substitute(&1|&2,p-db-num,p-task-type)'
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable g#auto-pid           as integer   no-undo .
       76   define  shared variable conn-par             as character no-undo .
       77   define  shared variable g#auto-user-id       as character no-undo .
       78   define  shared variable g#auto-user-login    as character no-undo .
       79   define  shared variable g#auto-user-password as character no-undo .
       80   define  shared variable v-socket             as logical   no-undo .
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  shared variable auto-window-h     as handle    no-undo .
       83   define  shared variable auto-log-msg-h    as handle    no-undo .
       84   define  shared variable hand-log-msg-h    as handle    no-undo .
       85   define  shared variable log-file-name     as character no-undo initial ? .
       86   define  shared variable add-log-file-name as character no-undo initial ? .
       87   define  shared variable writelogvalue     as character no-undo initial ? .
       88   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   define stream LogStream .
      314   define variable mNoTime as logical no-undo.
      315   procedure write-to-log-notime :
      316     define input param i-str as character no-undo .
      317     mNoTime = yes.
      318     run write-to-log (i-str).
      319     mNoTime = no.
      320   end.
      321   procedure write-to-log :
      322     define input param p-str as character no-undo .
      323     do
      324     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      325     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      326     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      327     :
      328       define variable log-res        as logical   no-undo .
      329       define variable v-jj           as integer   no-undo .
      330       if    mNoTime
      331          or writelogvalue eq "AsyncProc"
      332       then
      333          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      334       else
      335          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      336       if auto-log-msg-h <> ? then do:
      337         log-res = auto-log-msg-h:move-to-eof( ) .
      338         log-res = auto-log-msg-h:insert-string( p-str ).
      339       end.
      340       if hand-log-msg-h <> ? then do:
      341         log-res = hand-log-msg-h:move-to-eof( ) .
      342         log-res = hand-log-msg-h:insert-string( p-str ).
      343       end.
      344       assign
      345         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      346         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      347         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      348       .
      349       if add-log-file-name <> ? then do:
      350         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      351           run gbl/fileapnd.p
      352             ( input entry(v-jj, add-log-file-name, chr(1) )
      353             ,input p-str
      354             ,input 20
      355             ) no-error .
      356           if error-status:error then do:
      357             return error return-value .
      358           end.
      359         end.
      360       end.
      361       if writelogvalue eq "AsyncProc"
      362       then do:
      363          p-str = trim(p-str, (chr(13) + chr(10)) )
      364       .
      365          Publish "WriteLogAsunc" (p-str,yes).
      366       end.
      367       else if writelogvalue <> "yes" then do:
      368         run gbl/fileapnd.p
      369           ( input log-file-name
      370           ,input p-str
      371           ,input 20
      372           ) no-error .
      373         if error-status:error then do:
      374           return error return-value .
      375         end.
      376       end.
      377     end.
      378   end procedure.
      379   procedure write-to-screen :
      380     define input param p-str as character no-undo .
      381     do
      382     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      383     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      384     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      385     :
      386       define variable log-res as logical no-undo.
      387       assign
      388         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      389       .
      390       if auto-log-msg-h <> ?
      391       then do:
      392         log-res = auto-log-msg-h:move-to-eof( ) .
      393         log-res = auto-log-msg-h:insert-string( p-str ).
      394       end.
      395       if hand-log-msg-h <> ?
      396       then do:
      397         log-res = hand-log-msg-h:move-to-eof( ) .
      398         log-res = hand-log-msg-h:insert-string( p-str ).
      399       end.
      400     end.
      401   end procedure.
      402   procedure send-msg-to-email :
      403     define input  parameter p-subject      as character no-undo .
      404     define input  parameter p-text-err     as character no-undo .
      405     define input  parameter p-attach-files as character no-undo .
      406     do
      407     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      408     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      409     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      410     :
      411       define variable v-tth             as handle    no-undo .
      412       define variable v-value-character as character no-undo .
      413       define variable v-value-date      as date      no-undo .
      414       define variable v-value-decimal   as decimal   no-undo .
      415       define variable v-value-integer   as integer   no-undo .
      416       define variable v-value-logical   as logical   no-undo .
      417       define variable v-param-type      as character no-undo .
      418       define variable v-email       as character no-undo .
      419       define variable v-tmp-str     as character no-undo .
      420       define variable v-tmp1-str    as character no-undo .
      421       define variable v-ind         as integer   no-undo .
      422       define variable v-num-entries as integer   no-undo .
      423       delete object v-tth no-error.
      424       run adm/shattri.p
      425         ( input "get":U
      426          ,input  "":U
      427          ,input  0
      428          ,input  'auto-task':U
      429          ,input  'send-msg-to-email':U
      430          ,output v-value-character
      431          ,output v-value-date
      432          ,output v-value-decimal
      433          ,output v-value-integer
      434          ,output v-value-logical
      435          ,output v-param-type
      436          ,input-output table-handle v-tth
      437         ) no-error .
      438       if not error-status :error  then do:
      439         assign
      440           v-tmp-str = v-value-character
      441         .
      442       end.
      443       delete object v-tth no-error.
      444       assign
      445         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      446         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      447         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      448         v-num-entries = num-entries( v-tmp-str, chr(44) )
      449         v-email       = "":U
      450       .
      451       do v-ind = 1 to v-num-entries
      452       :
      453         assign
      454           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      455         .
      456         if trim( v-tmp1-str ) <> "":U then do:
      457           if v-email = "":U then do:
      458             assign
      459               v-email = v-tmp1-str
      460             .
      461           end.
      462           else do:
      463             assign
      464               v-email = v-email + chr(44) + v-tmp1-str
      465             .
      466           end.
      467         end.
      468       end.
      469       if v-email <> "":U then do:
      470         run gbl/sendmail.p
      471           ( input v-email
      472           , input p-subject
      473           , input p-text-err
      474           , input p-attach-files
      475           ) no-error .
      476         if error-status :error
      477           or return-value <> "":U
      478         then do:
      479           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      480         end.
      481       end.
      482     end.
      483   end procedure.
      484   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      485   define variable v-loc-counter as integer no-undo .
      486   define variable v-counter-visible as logical no-undo .
      487   define variable v-view-log as logical no-undo .
      488   define stream auto2dia.
      489   PROCEDURE write-log-and-file :
      490   do
      491   on error undo, return error
      492   :
      493     define input parameter p-tab-position   as integer   no-undo.
      494     define input parameter p-file-name      as character no-undo .
      495     define input parameter p-log-level      as integer   no-undo .
      496     define input parameter p-log-string     AS CHARacter NO-UNDO.
      497     define variable v-jj as integer   no-undo .
      498     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      499     if p-file-name <> '':U then do:
      500       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      501         run  auto2dia-writefile in this-procedure (
      502                                         input entry(v-jj, p-file-name, chr(1))
      503                                         ,input p-log-level
      504                                         ,input (p-log-string + chr(10))
      505                                       ) no-error .
      506       end.
      507     end.
      508     if writelogvalue eq "AsyncProc"
      509     then
      510        run write-to-log in this-procedure( p-log-string) .
      511   end.
      512   END PROCEDURE.
      513   PROCEDURE get-title :
      514   do
      515   on error undo, return error
      516   :
      517   define output parameter p-title     as character    no-undo.
      518   end.
      519   END PROCEDURE.
      520   PROCEDURE set-title :
      521   do
      522   on error undo, return error
      523   :
      524   define input parameter p-title     as character    no-undo.
      525   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      526   end.
      527   END PROCEDURE.
      528   PROCEDURE get-counter-value :
      529   do
      530   on error undo, return error
      531   :
      532   define output parameter p-counter     as integer    no-undo.
      533       assign
      534       p-counter  = v-loc-counter
      535       .
      536   end.
      537   END PROCEDURE.
      538   PROCEDURE set-counter-value :
      539   do
      540   on error undo, return error
      541   :
      542   define input parameter p-counter     as integer    no-undo.
      543       assign
      544       v-loc-counter = p-counter
      545       .
      546   end.
      547   END PROCEDURE.
      548   PROCEDURE show-counter :
      549   do
      550   on error undo, return error
      551   :
      552       assign
      553       v-counter-visible = true
      554       .
      555       process events.
      556   end.
      557   END PROCEDURE.
      558   PROCEDURE hide-counter :
      559   do
      560   on error undo, return error
      561   :
      562       assign
      563       v-counter-visible = false
      564       .
      565       run hide-message in parparentproc .
      566       process events.
      567   end.
      568   END PROCEDURE.
      569   PROCEDURE write-counter :
      570   do
      571   on error undo, return error
      572   :
      573   define input parameter p-counter-string     as character    no-undo.
      574   if v-counter-visible then
      575   run write-message in parparentproc ( input p-counter-string) .
      576   process events.
      577   end.
      578   END PROCEDURE.
      579   PROCEDURE get-stop-state :
      580   do
      581   on error undo, return error
      582   :
      583   define output parameter p-stop-state    as logical      no-undo.
      584   end.
      585   END PROCEDURE.
      586   PROCEDURE set-view-log :
      587   do
      588   on error undo, return error
      589   :
      590   define input parameter p-view-log     as logical    no-undo.
      591       assign
      592       v-view-log = p-view-log
      593       .
      594   end.
      595   END PROCEDURE.
      596   PROCEDURE get-view-log :
      597   do
      598   on error undo, return error
      599   :
      600   define output parameter p-view-log     as logical    no-undo.
      601       assign
      602       p-view-log = v-view-log
      603       .
      604   end.
      605   END PROCEDURE.
      606   PROCEDURE write-log :
      607   do
      608   on error undo, return error
      609   :
      610   define input parameter p-tab-position   as integer      no-undo.
      611   define input parameter p-log-string     as character    no-undo.
      612   run write-to-log in this-procedure( input ( fill( chr(32), 2  * p-tab-position)  +
      613                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      614                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      615                                       ELSE p-log-string))).
      616   end.
      617   END PROCEDURE.
      618   procedure writelog :
      619   do
      620   on error undo, return error
      621   :
      622   define input parameter p-file-name AS CHAR     NO-UNDO.
      623   define input parameter p-log-level AS INTEGER  NO-UNDO.
      624   define input parameter p-log-string  AS CHAR     NO-UNDO.
      625     if p-file-name <> "" then
      626     run  auto2dia-Writefile in this-procedure (
      627                                       input p-file-name
      628                                     ,input p-log-level
      629                                     ,input p-log-string
      630                                   ) no-error .
      631      process events.
      632   end.
      633   end procedure.
      634   PROCEDURE auto2dia-writefile:
      635     define input parameter sFileName AS CHAR     NO-UNDO.
      636     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      637     define input parameter sToWrite  AS CHAR     NO-UNDO.
      638     define variable v-SlashPos  as integer no-undo .
      639     define variable v-lDirName  as character no-undo .
      640     define variable v-lDirName2 as character no-undo .
      641     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      642     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      643     FILE-INFO:FILE-NAME = v-lDirName .
      644     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      645     if v-lDirName2 <> ? then do :
      646   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      647       PUT STREAM auto2dia UNFORMATTED chr(10).
      648       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      649                                         OR sToWrite = "&Line") THEN "" ELSE
      650                                         cur-time-string-sec() + " ").
      651       PUT STREAM auto2dia UNFORMATTED
      652               (IF sToWrite = "&Line" THEN FILL("-", 80)
      653                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      654                ELSE sToWrite).
      655   OUTPUT STREAM auto2dia CLOSE.
      656     end .
      657   END PROCEDURE.
      658   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      659   define temp-table temp-schedule-free no-undo
      660   field free-id as character
      661   field free-task-name as character
      662   field proc-run-name as character
      663   field proc-param-edit-name as character
      664   field conf-param as character
      665   field is-gbd as logical
      666   field is-ubd as logical
      667   field enable-concurrent-0 as logical
      668   field enable-concurrent-db as logical
      669   field other-info as character
      670   field enc-key as character
      671   field is-rum as logical
      672   index pi is unique primary
      673   free-id.
      674   procedure schedule-attr-name :
      675   do
      676     on error undo, return error
      677     :
      678     define input  parameter p-code           as character no-undo .
      679     define output parameter p-type           as character no-undo .
      680     define output parameter p-format         as character no-undo .
      681     define output parameter p-label          as character no-undo .
      682     define output parameter p-user-can-edit  as logical   no-undo .
      683     define output parameter p-output-display as logical   no-undo .
      684     define output parameter p-other          as character no-undo .
      685       if index(p-code, chr(4)) > 0 then do:
      686         p-code = entry(1, p-code, chr(4)).
      687       end.
      688       case p-code :
      689               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      690               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      691               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      692               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      693               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      694               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      695               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      696               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      697               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      698         otherwise do:
      699           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      700         end.
      701       end.
      702     end.
      703   end procedure.
      704   procedure schedule-attr-tooltip :
      705   do
      706     on error undo, return error
      707     :
      708       define input  parameter p-code    as character no-undo .
      709       define output parameter p-tooltip as character no-undo .
      710       define output parameter p-label   as character no-undo .
      711       if index(p-code, chr(4)) > 0 then do:
      712         p-code = entry(1, p-code, chr(4)).
      713       end.
      714       case p-code :
      715               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      716               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      717               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      718               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      719               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      720               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      721               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      722               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      723               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      724         otherwise do:
      725               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      726         end.
      727       end.
      728     end.
      729   end procedure.
      730   procedure schedule-attr-value :
      731   do
      732   on error undo, return error return-value
      733   :
      734   define input parameter  p-cre-db-num as integer    no-undo.
      735   define input parameter  p-task-type  as character  no-undo.
      736   define input parameter  p-task-num   as integer    no-undo.
      737   define input parameter  p-code       as character  no-undo.
      738   define output parameter p-value      as character  no-undo.
      739   define output parameter p-type       as character  no-undo.
      740       define variable v-format         as character no-undo .
      741       define variable v-label          as character no-undo .
      742       define variable v-user-can-edit  as logical   no-undo .
      743       define variable v-output-display as logical   no-undo .
      744       define variable v-other          as character no-undo .
      745       define buffer buf_schedule-attr for ub.schedule-attr.
      746       run schedule-attr-name in this-procedure (
      747             input  p-code
      748           , output p-type
      749           , output v-format
      750           , output v-label
      751           , output v-user-can-edit
      752           , output v-output-display
      753           , output v-other
      754       ) no-error .
      755       if error-status :error
      756       then do:
      757           undo, return error return-value .
      758       end.
      759       if p-code begins ('schd-free-id':U + chr(4))
      760       and entry(2, p-code, chr(4)) = '':U then do:
      761         find first buf_schedule-attr no-lock
      762             where buf_schedule-attr.cre-db-num = p-cre-db-num
      763               and buf_schedule-attr.task-type  = p-task-type
      764               and buf_schedule-attr.task-num   = p-task-num
      765               and buf_schedule-attr.attr-code  begins p-code
      766         no-error .
      767       end.
      768       else do:
      769         find first buf_schedule-attr no-lock
      770             where buf_schedule-attr.cre-db-num = p-cre-db-num
      771               and buf_schedule-attr.task-type  = p-task-type
      772               and buf_schedule-attr.task-num   = p-task-num
      773               and buf_schedule-attr.attr-code  = p-code
      774         no-error .
      775       end.
      776       if available buf_schedule-attr
      777       then do:
      778           assign
      779               p-value = buf_schedule-attr.attr-value
      780           .
      781       end.
      782       else do:
      783         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      784            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      785         end.
      786         else do:
      787           assign
      788               p-value = if p-type = 'L':U then "no":U else ""
      789           .
      790         end.
      791       end.
      792   end.
      793   end procedure.
      794   procedure schedule-attr-write :
      795   do
      796   on error undo, return error
      797   :
      798   define input parameter p-cre-db-num  as integer   no-undo.
      799   define input parameter p-task-type   as character no-undo.
      800   define input parameter p-task-num    as integer   no-undo.
      801   define input parameter p-code        as character no-undo.
      802   define input parameter p-value       as character no-undo.
      803       define variable v-type              as character                no-undo.
      804       define variable v-format            as character                no-undo.
      805       define variable v-label             as character                no-undo.
      806       define variable v-user-can-edit     as logical                  no-undo.
      807       define variable v-output-display    as logical                  no-undo.
      808       define variable v-other             as character                no-undo.
      809       define buffer buf_schedule-attr for ub.schedule-attr .
      810       run schedule-attr-name in this-procedure (
      811             input  p-code
      812           , output v-type
      813           , output v-format
      814           , output v-label
      815           , output v-user-can-edit
      816           , output v-output-display
      817           , output v-other
      818       ) no-error.
      819       if error-status :error
      820       then do:
      821           undo, return error return-value.
      822       end.
      823       find first buf_schedule-attr exclusive-lock
      824            where buf_schedule-attr.cre-db-num = p-cre-db-num
      825              and buf_schedule-attr.task-type  = p-task-type
      826              and buf_schedule-attr.task-num   = p-task-num
      827              and buf_schedule-attr.attr-code  = p-code
      828       no-error.
      829       if not available buf_schedule-attr
      830       then do:
      831           create buf_schedule-attr.
      832           assign
      833             buf_schedule-attr.cre-db-num = p-cre-db-num
      834             buf_schedule-attr.task-type  = p-task-type
      835             buf_schedule-attr.task-num   = p-task-num
      836             buf_schedule-attr.attr-code  = p-code
      837             buf_schedule-attr.attr-value = p-value
      838           .
      839       end.
      840       else do:
      841           assign
      842               buf_schedule-attr.attr-value = p-value
      843           .
      844       end.
      845   end.
      846   end procedure.
      847   procedure schedule-attr-delete :
      848   do
      849   on error undo, return error
      850   :
      851   define input  parameter p-cre-db-num  as integer   no-undo.
      852   define input  parameter p-task-type   as character no-undo.
      853   define input  parameter p-task-num    as integer   no-undo.
      854   define input  parameter p-code        as character no-undo.
      855   define output parameter p-deleted     as logical   no-undo.
      856       define buffer buf_schedule-attr for ub.schedule-attr .
      857       define variable v-type              as character                no-undo.
      858       define variable v-format            as character                no-undo.
      859       define variable v-label             as character                no-undo.
      860       define variable v-user-can-edit     as logical                  no-undo.
      861       define variable v-output-display    as logical                  no-undo.
      862       define variable v-other             as character                no-undo.
      863       run schedule-attr-name in this-procedure (
      864             input p-code
      865           , output v-type
      866           , output v-format
      867           , output v-label
      868           , output v-user-can-edit
      869           , output v-output-display
      870           , output v-other
      871       ) no-error .
      872       if error-status :error
      873       then do:
      874           undo, return error return-value .
      875       end.
      876       find first buf_schedule-attr exclusive-lock
      877            where buf_schedule-attr.cre-db-num = p-cre-db-num
      878              and buf_schedule-attr.task-type  = p-task-type
      879              and buf_schedule-attr.task-num   = p-task-num
      880              and buf_schedule-attr.attr-code  = p-code
      881       no-error.
      882       if not available buf_schedule-attr
      883       then do:
      884           assign
      885               p-deleted = no
      886           .
      887       end.
      888       else do:
      889           delete buf_schedule-attr.
      890           assign
      891               p-deleted = yes
      892           .
      893       end.
      894   end.
      895   end procedure.
      896   procedure schedule-attr-news :
      897   do
      898   on error undo, return error
      899   :
      900       define input  parameter p-code           as character no-undo .
      901       define output parameter p-news           as logical   no-undo .
      902       if index(p-code, chr(4)) > 0 then do:
      903         p-code = entry(1, p-code, chr(4)).
      904       end.
      905       case p-code :
      906               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      907               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      908               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      909               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      910               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      911               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      912               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      913               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      914               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      915         otherwise do:
      916           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      917         end.
      918       end.
      919   end.
      920   end procedure.
      921   procedure schedule-attr-extract-logical :
      922   do
      923   on error undo, return error
      924   :
      925   define input  parameter p-parameter-number   as integer      no-undo.
      926   define input  parameter p-parameter-list     as character    no-undo.
      927   define output parameter p-parameter-value   as logical      no-undo.
      928       if num-entries( p-parameter-list ) > p-parameter-number - 1
      929       then do:
      930           assign
      931               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      932           .
      933       end.
      934       else do:
      935           assign
      936               p-parameter-value   = no
      937           .
      938       end.
      939   end.
      940   end procedure.
      941   procedure schedule-attr-get-free-id :
      942   do
      943   on error undo, return error return-value
      944   :
      945     define input  parameter p-cre-db-num  as integer   no-undo.
      946     define input  parameter p-task-type   as character no-undo.
      947     define input  parameter p-task-num    as integer   no-undo.
      948     define output parameter p-free-id     as character no-undo.
      949     define buffer buf_schedule-attr for ub.schedule-attr.
      950     find first buf_schedule-attr no-lock
      951         where buf_schedule-attr.cre-db-num = p-cre-db-num
      952           and buf_schedule-attr.task-type  = p-task-type
      953           and buf_schedule-attr.task-num   = p-task-num
      954           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      955     no-error .
      956     if available buf_schedule-attr then
      957     assign
      958     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      959     no-error
      960     .
      961   end.
      962   end procedure.
      963   procedure schedule-attr-get-free-props :
      964     define input parameter p-free-id as character no-undo .
      965     define output parameter p-value as character no-undo .
      966     define buffer buf_temp-schedule-free for temp-schedule-free.
      967     do
      968     on error undo, return error return-value
      969     :
      970       find first buf_temp-schedule-free no-lock no-error .
      971       if not available buf_temp-schedule-free then do:
      972         run schedule-attr-fill-free-props in this-procedure .
      973       end.
      974       find first buf_temp-schedule-free where
      975               buf_temp-schedule-free.free-id = p-free-id no-error.
      976       if available buf_temp-schedule-free then do:
      977         assign
      978         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      979                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      980                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      981                   buf_temp-schedule-free.conf-param           + chr(4) +
      982                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      983                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      984                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      985                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      986                   buf_temp-schedule-free.other-info
      987         .
      988       end.
      989       else do:
      990        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      991                              "id произвольной задачи - &5"
      992                              ,vss-workfile
      993                              ,vss-revision
      994                              ,vss-description
      995                              ,chr(10)
      996                              ,p-free-id).
      997       end.
      998     end.
      999   end procedure.
     1000   procedure schedule-attr-is-rum-free-id :
     1001   define input parameter p-free-id as character no-undo .
     1002   define output parameter p-is-rum as logical no-undo .
     1003   define buffer buf_temp-schedule-free for temp-schedule-free.
     1004   do
     1005   on error undo, return error
     1006   :
     1007       find first buf_temp-schedule-free no-lock no-error .
     1008       if not available buf_temp-schedule-free then do:
     1009         run schedule-attr-fill-free-props in this-procedure .
     1010       end.
     1011       find first buf_temp-schedule-free where
     1012               buf_temp-schedule-free.free-id = p-free-id no-error.
     1013       if available buf_temp-schedule-free
     1014       and buf_temp-schedule-free.is-rum
     1015       then do:
     1016         p-is-rum = yes.
     1017       end.
     1018   end.
     1019   end procedure.
     1020   procedure schedule-attr-fill-free-props :
     1021   define variable v-path                    as character                no-undo .
     1022   DEFINE VARIABLE v-full-path               as character                no-undo .
     1023   DEFINE VARIABLE v-file-name               as character                no-undo .
     1024   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1025   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1026   define buffer buf_temp-schedule-free for temp-schedule-free.
     1027   define variable v-answer as logical no-undo .
     1028     do
     1029     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1030                                           ,vss-workfile
     1031                                           ,vss-revision
     1032                                           ,vss-description
     1033                                           ,chr(10)
     1034                                           ,error-status:get-message(1) )
     1035     :
     1036       run gbl/filename.p (
     1037                       input 'cmp/shd-free.d'
     1038                     ,output v-full-path
     1039                     ,output v-path
     1040                     ,output v-file-name
     1041                     ,output v-file-name-no-ext
     1042                     ,output v-file-name-ext
     1043                     ) .
     1044       input from value(v-full-path).
     1045       repeat :
     1046         create buf_temp-schedule-free.
     1047         import buf_temp-schedule-free.
     1048       END.
     1049       input close.
     1050       _ff:
     1051       for each buf_temp-schedule-free :
     1052         if buf_temp-schedule-free.free-id = '':U then do:
     1053            delete buf_temp-schedule-free.
     1054            next _ff.
     1055          end.
     1056          run schedule-attr-check-enc in this-procedure (
     1057                                                       input  buf_temp-schedule-free.free-id
     1058                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1059                                                               buf_temp-schedule-free.proc-param-edit-name +
     1060                                                               buf_temp-schedule-free.conf-param +
     1061                                                               string(buf_temp-schedule-free.is-gbd) +
     1062                                                               string(buf_temp-schedule-free.is-ubd) +
     1063                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1064                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1065                                                               string(buf_temp-schedule-free.other-info)
     1066                                                               )
     1067                                                       ,input  buf_temp-schedule-free.enc-key
     1068                                                       ,output v-answer    ) no-error .
     1069          if error-status:error
     1070          or not v-answer then delete buf_temp-schedule-free.
     1071        end.
     1072     end.
     1073   end procedure.
     1074   Function schedule-attr-reverse returns character (str as character).
     1075      define variable rev_incl_s as character init "" no-undo .
     1076      define variable rev_incl_i as integer no-undo .
     1077      define variable rev_incl_l as integer no-undo .
     1078      rev_incl_l = length(str).
     1079      do rev_incl_i = 1 to rev_incl_l:
     1080         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1081      end.
     1082      return rev_incl_s.
     1083   end.
     1084   procedure schedule-attr-check-enc.
     1085     define input  parameter p-free-id   as character no-undo .
     1086     define input  parameter p-value     as character no-undo .
     1087     define input  parameter p-enc-value as character no-undo .
     1088     define output parameter p-answer    as logical   no-undo .
     1089     define variable tmp         as character no-undo .
     1090     define variable v-enc-value as character no-undo .
     1091     assign
     1092     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1093     .
     1094     run schedule-attr-pswd-enc in this-procedure
     1095       ( input tmp
     1096        ,output v-enc-value
     1097       ) no-error .
     1098     if error-status:error then do:
     1099       message
     1100         vss-workfile vss-revision vss-description skip
     1101         "Ошибка при вызове процедуры pswd-enc" skip
     1102         return-value skip
     1103         error-status :get-message(1) skip
     1104         view-as alert-box error .
     1105       undo, return error .
     1106     end.
     1107     if v-enc-value = p-enc-value then do:
     1108       assign
     1109         p-answer = true
     1110       .
     1111     end.
     1112     else do:
     1113       assign
     1114         p-answer = false
     1115       .
     1116     end.
     1117   end.
     1118   procedure schedule-attr-conf-enc.
     1119     define input  parameter p-free-id   as character no-undo .
     1120     define input  parameter p-value     as character no-undo .
     1121     define output parameter p-enc-value as character no-undo .
     1122     define variable tmp         as character no-undo .
     1123     assign
     1124       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1125     .
     1126     run schedule-attr-pswd-enc in this-procedure
     1127       ( input tmp
     1128        ,output p-enc-value
     1129       ) no-error .
     1130     if error-status:error then do:
     1131       message
     1132         vss-workfile vss-revision vss-description skip
     1133         "Ошибка при вызове процедуры pswd-enc" skip
     1134         return-value skip
     1135         error-status :get-message(1) skip
     1136         view-as alert-box error .
     1137       undo, return error .
     1138     end.
     1139   end procedure.
     1140   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   procedure schedule-attr-pswd-enc :
     1142     define input parameter  pswd     as character no-undo .
     1143     define output parameter enc-pswd as character no-undo .
     1144     do
     1145     on error undo, return error return-value
     1146     :
     1147       assign
     1148         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1149       .
     1150     end.
     1151   end procedure.
     1152   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   procedure gen-key-rec :
     1154     define input  parameter p-tbl-name    as character no-undo.
     1155     define input  parameter p-bh_tbl-name as handle    no-undo.
     1156     define output parameter p-key-rec     as character no-undo.
     1157     do
     1158     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1159     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1160     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1161     :
     1162       define variable fh               as handle    no-undo .
     1163       define variable v-ok             as logical   no-undo .
     1164       define variable v-inform         as character no-undo .
     1165       define variable v-ind            as integer   no-undo .
     1166       define variable v-idx-field-qnty as integer   no-undo .
     1167       if p-tbl-name = ?
     1168         or p-tbl-name = "":U
     1169       then do:
     1170         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
     1171       end.
     1172       if not p-bh_tbl-name:available then do:
     1173         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
     1174       end.
     1175       assign
     1176         p-key-rec = p-tbl-name
     1177         v-inform  = p-bh_tbl-name:index-information(1)
     1178         v-ind     = 2
     1179       .
     1180       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1181       on error undo, return error
     1182       :
     1183         assign
     1184           v-inform = p-bh_tbl-name:index-information( v-ind )
     1185           v-ind    = v-ind + 1
     1186         .
     1187       end.
     1188       if v-inform = ?
     1189         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1190         or entry( 3, v-inform, ",":U ) <> "1":U
     1191       then do:
     1192         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
     1193       end.
     1194       else do:
     1195         assign
     1196           v-idx-field-qnty = num-entries( v-inform ) - 4
     1197         .
     1198         if v-idx-field-qnty < 2 then do:
     1199           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
     1200         end.
     1201         do v-ind = 1 to v-idx-field-qnty by 2
     1202         on error undo, return error
     1203         :
     1204           assign
     1205             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1206             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1207           .
     1208         end.
     1209       end.
     1210       if p-key-rec = ? then do:
     1211         assign
     1212           p-key-rec = "":U
     1213         .
     1214         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
     1215       end.
     1216     end.
     1217     return.
     1218   end procedure.
     1219   procedure gen-where-keyr-tab :
     1220     define input  parameter i-tableSerach as character no-undo.
     1221     define input  parameter i-tablekey   as character  no-undo.
     1222     define input  parameter p-key-rec    as character  no-undo.
     1223     define input  parameter p-key-handle as handle     no-undo .
     1224     define input  parameter p-db-name    as character  no-undo .
     1225     define input  parameter p-tt-handle  as handle     no-undo .
     1226     define output parameter o-Where      as character  no-undo.
     1227     do
     1228     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1229     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1230     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1231     :
     1232       define variable v-full-tbl-name  as character no-undo .
     1233       define variable bh_tbl-name      as handle    no-undo .
     1234       define variable fh_key           as handle    no-undo .
     1235       define variable fh_search        as handle    no-undo .
     1236       define variable v-field-num      as integer   no-undo .
     1237       define variable v-count-fld      as integer   no-undo .
     1238       define variable v-inform         as character no-undo .
     1239       define variable v-ind            as integer   no-undo .
     1240       define variable v-idx-field-qnty as integer   no-undo .
     1241       define variable v-field-name     as character no-undo .
     1242       define variable v-field-val      as character no-undo .
     1243       define variable v-word-link      as character no-undo .
     1244       define variable vTable           as character no-undo.
     1245       define variable bh_tbl-key       as handle    no-undo .
     1246       assign
     1247         p-key-rec = trim( p-key-rec )
     1248       .
     1249       if p-key-handle <> ? then do:
     1250         if not valid-handle(p-key-handle)
     1251            or p-key-handle:type <> "buffer"
     1252         then do:
     1253           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
     1254         end.
     1255         if num-entries( p-key-rec, chr(3) ) > 1
     1256           or p-key-rec = ?
     1257           or p-key-rec = "":U
     1258         then do:
     1259           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
     1260         end.
     1261       end.
     1262       else do:
     1263         if p-key-rec = ?
     1264           or p-key-rec = "":U
     1265         then do:
     1266           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1267         end.
     1268       end.
     1269       assign
     1270         vTable = entry( 1 , p-key-rec, chr(3) )
     1271       .
     1272       if p-tt-handle <> ?
     1273         and ( not valid-handle(p-tt-handle)
     1274               or p-tt-handle:type <> "buffer"
     1275             )
     1276       then do:
     1277         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
     1278       end.
     1279       if p-tt-handle = ? then do:
     1280         assign
     1281           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1282         .
     1283         create buffer bh_tbl-name for table v-full-tbl-name .
     1284       end.
     1285       else do:
     1286         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1287       end.
     1288       assign
     1289         v-inform = bh_tbl-name:index-information(1)
     1290         v-ind    = 2
     1291       .
     1292       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1293       on error undo, return error
     1294       :
     1295         assign
     1296           v-inform = bh_tbl-name:index-information( v-ind )
     1297           v-ind    = v-ind + 1
     1298         .
     1299       end.
     1300       if v-inform = ?
     1301         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1302         or entry( 3, v-inform, ",":U ) <> "1":U
     1303       then do:
     1304         delete object bh_tbl-name no-error.
     1305         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
     1306       end.
     1307       assign
     1308         v-idx-field-qnty = num-entries( v-inform ) - 4
     1309       .
     1310       if v-idx-field-qnty < 2 then do:
     1311         delete object bh_tbl-name no-error.
     1312         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
     1313       end.
     1314       assign
     1315         o-where     = "where":U
     1316         v-word-link = "":U
     1317         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1318         v-count-fld = 0
     1319       .
     1320       if i-tablekey ne "" and i-tablekey ne ?
     1321       then do:
     1322         assign
     1323           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1324         .
     1325         create buffer bh_tbl-key for table v-full-tbl-name .
     1326       end.
     1327       if i-tableSerach ne "" and i-tableSerach ne ?
     1328       then do:
     1329         delete object bh_tbl-name no-error.
     1330         assign
     1331           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1332         .
     1333         create buffer bh_tbl-name for table v-full-tbl-name .
     1334       end.
     1335       block_where:
     1336       do v-ind = 1 to v-idx-field-qnty by 2
     1337       on error undo, return error
     1338       :
     1339         assign
     1340           v-count-fld = v-count-fld + 1
     1341         .
     1342         if p-key-handle = ?
     1343           and v-count-fld > v-field-num
     1344         then do:
     1345           leave block_where.
     1346         end.
     1347         define variable VfieldKeyTable as handle no-undo.
     1348         assign
     1349           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1350           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1351         .
     1352         if     bh_tbl-key ne ?
     1353         then do:
     1354            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1355            if VfieldKeyTable eq ?
     1356            then next block_where.
     1357         end.
     1358         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1359         then
     1360            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1361         else
     1362            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1363         if p-key-handle = ? then do:
     1364           assign
     1365             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1366           .
     1367         end.
     1368         else do:
     1369           assign
     1370             fh_key = p-key-handle:buffer-field( v-field-name )
     1371           .
     1372           if fh_key = ?
     1373             or not valid-handle( fh_key )
     1374           then do:
     1375             delete object bh_tbl-name.
     1376             if     bh_tbl-key ne ?
     1377             then
     1378                delete object bh_tbl-key.
     1379             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
     1380           end.
     1381           assign
     1382             v-field-val = fh_key:buffer-value
     1383           .
     1384         end.
     1385         if fh_search:data-type ="character":U then do:
     1386           assign
     1387             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1388             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1389             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1390             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1391             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1392             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1393             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1394             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1395             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1396             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1397             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1398             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1399             v-field-val = substitute( '"&1"', v-field-val )
     1400           .
     1401         end.
     1402         assign
     1403           o-where = substitute( "&1 &2", o-where, v-field-val )
     1404         .
     1405         if v-word-link = "":U then do:
     1406           assign
     1407             v-word-link = "and":U
     1408           .
     1409         end.
     1410       end.
     1411       delete object bh_tbl-name.
     1412       if     bh_tbl-key ne ?
     1413       then
     1414          delete object bh_tbl-key.
     1415       if p-key-handle = ?
     1416         and v-count-fld <> v-field-num
     1417       then do:
     1418         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
     1419       end.
     1420     end.
     1421   end procedure.
     1422   procedure gen-hn-keyr-tab :
     1423     define input  parameter i-tableSerach as character no-undo.
     1424     define input  parameter i-tablekey   as character no-undo.
     1425     define input  parameter p-key-rec    as character no-undo.
     1426     define input  parameter p-key-handle as handle    no-undo .
     1427     define input  parameter p-db-name    as character no-undo .
     1428     define input  parameter p-tt-handle  as handle    no-undo .
     1429     define input  parameter p-stts-lock  as integer   no-undo .
     1430     define output parameter o-hn         as handle    no-undo.
     1431     define variable v-full-tbl-name as character no-undo.
     1432     define variable v-where         as character no-undo.
     1433     define variable bh_tbl-name     as handle    no-undo.
     1434     define variable vTable          as character no-undo.
     1435     do
     1436     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1437     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1438     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1439         run gen-where-keyr-tab(i-tableSerach,
     1440                                i-tablekey,
     1441                                p-key-rec,
     1442                                p-key-handle,
     1443                                p-db-name,
     1444                                p-tt-handle,
     1445                                output v-where).
     1446         if i-tableSerach ne "" and i-tableSerach ne ?
     1447         then do:
     1448            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1449            create buffer bh_tbl-name for table v-full-tbl-name .
     1450         end.
     1451         else do:
     1452            if p-tt-handle = ? then do:
     1453               assign
     1454                  vTable = entry( 1 , p-key-rec, chr(3) )
     1455               .
     1456               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1457               create buffer bh_tbl-name for table v-full-tbl-name .
     1458            end.
     1459            else do:
     1460               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1461            end.
     1462         end.
     1463         if p-tt-handle = ? then do:
     1464            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1465         end.
     1466         else do:
     1467            bh_tbl-name:find-first( v-where ) no-error .
     1468         end.
     1469         o-hn = bh_tbl-name.
     1470      end.
     1471   end procedure.
     1472   procedure gen-hn-keyr :
     1473     define input  parameter p-key-rec    as character no-undo.
     1474     define input  parameter p-key-handle as handle    no-undo .
     1475     define input  parameter p-db-name    as character no-undo .
     1476     define input  parameter p-tt-handle  as handle    no-undo .
     1477     define input  parameter p-stts-lock  as integer   no-undo .
     1478     define output parameter o-hn         as handle    no-undo.
     1479     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1480   end.
     1481   procedure gen-row-keyr :
     1482     define input  parameter p-key-rec    as character no-undo.
     1483     define input  parameter p-key-handle as handle    no-undo .
     1484     define input  parameter p-db-name    as character no-undo .
     1485     define input  parameter p-tt-handle  as handle    no-undo .
     1486     define input  parameter p-stts-lock  as integer   no-undo .
     1487     define output parameter p-tbl-row    as rowid     no-undo.
     1488     define output parameter p-tbl-name   as character no-undo.
     1489     define variable vHn as handle no-undo.
     1490       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1491       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1492       p-tbl-name =  vHn:table.
     1493       delete object vHn no-error.
     1494     if p-tbl-row = ? then do:
     1495       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
     1496     end.
     1497     else do:
     1498       return.
     1499     end.
     1500   end procedure.
     1501   procedure gen-key-fv :
     1502     define input  parameter p-key-rec    as character no-undo .
     1503     define output parameter p-field-list as character no-undo .
     1504     define output parameter p-value-list as character no-undo.
     1505     do
     1506     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1507     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1508     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1509     :
     1510       define variable v-full-tbl-name  as character no-undo .
     1511       define variable bh_tbl-name      as handle    no-undo .
     1512       define variable v-tbl-name       as character no-undo .
     1513       define variable v-field-num      as integer   no-undo .
     1514       define variable v-count-fld      as integer   no-undo .
     1515       define variable v-inform         as character no-undo .
     1516       define variable v-ind            as integer   no-undo .
     1517       define variable v-idx-field-qnty as integer   no-undo .
     1518       define variable v-delim-key      as character no-undo .
     1519       if p-key-rec = ?
     1520         or p-key-rec = "":U
     1521       then do:
     1522         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1523       end.
     1524       assign
     1525         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1526         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1527       .
     1528       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1529       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
     1530       assign
     1531         v-inform = bh_tbl-name:index-information(1)
     1532         v-ind    = 2
     1533       .
     1534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1535       on error undo, return error
     1536       :
     1537         assign
     1538           v-inform = bh_tbl-name:index-information( v-ind )
     1539           v-ind    = v-ind + 1
     1540         .
     1541       end.
     1542       if v-inform = ?
     1543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1544         or entry( 3, v-inform, ",":U ) <> "1":U
     1545       then do:
     1546         delete object bh_tbl-name no-error.
     1547         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1548       end.
     1549       assign
     1550         v-idx-field-qnty = num-entries( v-inform ) - 4
     1551       .
     1552       if v-idx-field-qnty < 2 then do:
     1553         delete object bh_tbl-name no-error.
     1554         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1555       end.
     1556       assign
     1557         p-field-list = "":U
     1558         p-value-list = "":U
     1559         v-delim-key  = "":U
     1560         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1561         v-count-fld  = 0
     1562       .
     1563       block_where:
     1564       do v-ind = 1 to v-idx-field-qnty by 2
     1565       on error undo, return error
     1566       :
     1567         assign
     1568           v-count-fld = v-count-fld + 1
     1569         .
     1570         if v-count-fld > v-field-num then do:
     1571           leave block_where.
     1572         end.
     1573         assign
     1574           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1575           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1576         .
     1577         if v-ind = 1 then do:
     1578           assign
     1579             v-delim-key = chr(3)
     1580           .
     1581         end.
     1582       end.
     1583       delete object bh_tbl-name.
     1584       if v-count-fld <> v-field-num then do:
     1585         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1586       end.
     1587     end.
     1588   end procedure.
     1589   procedure gen-key-field :
     1590     define input  parameter p-table      as character no-undo .
     1591     define output parameter p-field-list as character no-undo .
     1592     do
     1593     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1594     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1595     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1596     :
     1597       define variable v-full-tbl-name  as character no-undo .
     1598       define variable bh_tbl-name      as handle    no-undo .
     1599       define variable v-tbl-name       as character no-undo .
     1600       define variable v-field-num      as integer   no-undo .
     1601       define variable v-count-fld      as integer   no-undo .
     1602       define variable v-inform         as character no-undo .
     1603       define variable v-ind            as integer   no-undo .
     1604       define variable v-idx-field-qnty as integer   no-undo .
     1605       define variable v-delim-key      as character no-undo .
     1606       if p-table = ?
     1607         or p-table = "":U
     1608       then do:
     1609         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1610       end.
     1611       assign
     1612         v-tbl-name      = p-table
     1613         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1614       .
     1615       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1616       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1617       assign
     1618         v-inform = bh_tbl-name:index-information(1)
     1619         v-ind    = 2
     1620       .
     1621       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1622       on error undo, return error
     1623       :
     1624         assign
     1625           v-inform = bh_tbl-name:index-information( v-ind )
     1626           v-ind    = v-ind + 1
     1627         .
     1628       end.
     1629       if v-inform = ?
     1630         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1631         or entry( 3, v-inform, ",":U ) <> "1":U
     1632       then do:
     1633         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1634       end.
     1635       assign
     1636         v-idx-field-qnty = num-entries( v-inform ) - 4
     1637       .
     1638       if v-idx-field-qnty < 2 then do:
     1639         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1640       end.
     1641       assign
     1642         p-field-list = "":U
     1643         v-delim-key  = "":U
     1644         v-count-fld  = 0
     1645       .
     1646       block_where:
     1647       do v-ind = 1 to v-idx-field-qnty by 2
     1648       on error undo, return error
     1649       :
     1650         assign
     1651           v-count-fld = v-count-fld + 1
     1652         .
     1653         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1654         if v-ind = 1 then do:
     1655           assign
     1656             v-delim-key = chr(3)
     1657           .
     1658         end.
     1659       end.
     1660       delete object bh_tbl-name.
     1661     end.
     1662   end procedure.
     1663   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1664     define variable v-cntxt-db-num        as integer   no-undo .
     1665     define variable v-cntxt-userid        as character no-undo .
     1666     define variable v-cntxt-level         as character no-undo .
     1667     define variable v-cntxt-host-code-obj as integer   no-undo .
     1668     define variable v-cntxt-obj-type      as character no-undo .
     1669     define variable v-cntxt-obj-code      as integer   no-undo .
     1670     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1671     define variable v-cntxt-is-admin      as logical   no-undo .
     1672   do
     1673   on error undo, return error return-value
     1674   :
     1675     define variable v-ind as integer   no-undo .
     1676     run gbl/set-gbl.p
     1677       (input  true
     1678       ,input  g#auto-user-id
     1679       ,input  g#auto-user-password
     1680       ) no-error .
     1681     if error-status :error
     1682     then do:
     1683       run write-to-log in this-procedure
     1684         ( vss-workfile + chr(32)
     1685         + "Ошибка при инициализации переменных g#..." + chr(10)
     1686         + error-status :get-message(error-status :num-messages) + chr(10)
     1687         + return-value
     1688         ) .
     1689       return error return-value .
     1690     end.
     1691     define variable v-param-list as character no-undo .
     1692     define variable v-rp-by-call-uniq-key-rec as character no-undo .
     1693     define variable v-uniq-key-rec as character no-undo .
     1694     define variable v-param-type as character no-undo .
     1695     define variable v-dirs as character no-undo .
     1696     define buffer buf_schedule for ub.schedule.
     1697     define buffer lck_schedule-attr for ub.schedule-attr.
     1698     run adm/lockshda.p (
     1699                           input p-cre-db-num
     1700                          ,input p-task-type
     1701                          ,input p-task-num
     1702                          ,input 'schedule-param-list':U
     1703                          ,buffer lck_schedule-attr).
     1704     if error-status :error = yes
     1705     then do:
     1706       run write-to-log( vss-workfile + chr(32)
     1707                       + "Другая сессия уже работает с этим расписанием..." + chr(10)
     1708                       + error-status:get-message(error-status:num-messages)
     1709                       + return-value
     1710                       ) .
     1711       return .
     1712     end.
     1713     find first buf_schedule no-lock where
     1714               buf_schedule.cre-db-num = p-cre-db-num
     1715            and buf_schedule.task-type = p-task-type
     1716            and buf_schedule.task-num = p-task-num no-error.
     1717     run schedule-attr-value in this-procedure
     1718       (input  p-cre-db-num
     1719       ,input  p-task-type
     1720       ,input  p-task-num
     1721       ,input  'schedule-param-list':U
     1722       ,output v-dirs
     1723       ,output v-param-type
     1724       ) .
     1725     if available buf_schedule
     1726     then do :
     1727       run gen-key-rec in this-procedure (
     1728                                         input  'schedule':U
     1729                                       ,input (buffer buf_schedule:handle)
     1730                                       ,output v-uniq-key-rec).
     1731     end.
     1732     else do :
     1733       find last buf_schedule no-lock where
     1734               buf_schedule.cre-db-num = p-cre-db-num
     1735            and buf_schedule.task-type = p-task-type no-error.
     1736       if available buf_schedule
     1737       then do :
     1738         run gen-key-rec in this-procedure (
     1739                                           input  'schedule':U
     1740                                         ,input (buffer buf_schedule:handle)
     1741                                         ,output v-uniq-key-rec).
     1742       end.
     1743       else do :
     1744         v-uniq-key-rec = "schedule" + chr(3) + string(p-cre-db-num) + chr(3) + p-task-type + chr(3) + string(p-task-num) .
     1745       end.
     1746     end.
     1747     run get-db-num in parparentproc ( output v-cntxt-db-num).
     1748     run rep/reprum.p
     1749       (
     1750         input parparentproc
     1751       ,input this-procedure
     1752       ,input this-procedure
     1753       ,input 'batchwork':U
     1754       ,input 0
     1755       ,input 22
     1756       ,input 1
     1757       ,input 0
     1758       ,input v-cntxt-db-num
     1759       ,input v-uniq-key-rec
     1760       ,input  ( string(dynamic-next-value( "next-rep-num":U, "ubflt":U ), "9999999999") + chr(4) +
     1761                 string(p-task-num) + chr(4) +
     1762                 v-dirs )
     1763       ,input yes
     1764       ) no-error .
     1765     run trg/bt_clr.p .
     1766   end.
