        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Пересылка объектов системы КМ-ру IBM-пускальник".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define NEW SHARED temp-table cash-obj no-undo
       83   field km-objcode  as integer
       84   field km-objname as character
       85   field km-objtype as integer
       86   field on-addr like ub.cash-desk.addr-path
       87   field off-addr like ub.cash-desk.addr-path
       88   field shop-nums as character
       89   field obj-lock as integer
       90   field firm-name as character
       91   field jur-address as character
       92   field post-address as character
       93   field INN as character
       94   field KPP as character
       95   index pi is unique primary
       96   km-objtype km-objcode km-objname
       97   .
       98   define variable vss-include-info1 as character format "X(65)" no-undo
       99   initial "@(#)$Workfile$ $Revision$".
      100   define variable v-fmtcli-name          as character    no-undo.
      101   define variable v-fmtcli-engl-name     as character    no-undo.
      102   define variable v-fmtcli-addres        as character    no-undo.
      103   define variable v-fmtcli-post-addres   as character    no-undo.
      104   define variable v-fmtcli-full-addres   as character    no-undo.
      105   define variable v-fmtcli-phone         as character    no-undo.
      106   define variable v-fmtcli-inn           as character    no-undo.
      107   define variable v-fmtcli-kpp           as character    no-undo.
      108   define variable v-fmtcli-okpo          as character    no-undo.
      109   define variable v-fmtcli-country       as character    no-undo.
      110   define variable v-fmtcli-city          as character    no-undo.
      111   define variable v-fmtcli-index         as character    no-undo.
      112   define variable v-fmtcli-schet-exists  as logical      no-undo.
      113   define variable v-fmtcli-bank-exists   as logical      no-undo.
      114   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      115   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      116   define variable v-fmtcli-bank-bik      as character    no-undo.
      117   define variable v-fmtcli-bank-name     as character    no-undo.
      118   define variable v-fmtcli-bank-addres   as character    no-undo.
      119   define variable v-fmtcli-bank-city     as character    no-undo.
      120   procedure fmtcli-get-bank :
      121   define input parameter p-host-code      as integer          no-undo.
      122   define input parameter p-obj-type       as character        no-undo.
      123   define input parameter p-obj-code       as integer          no-undo.
      124   define input parameter p-curr-code      as integer          no-undo.
      125       define buffer buf_fin-schet     for ub.fin-schet.
      126       define buffer buf_fin-bank      for ub.fin-bank.
      127   do
      128   for buf_fin-schet
      129     , buf_fin-bank
      130   on error undo, return error
      131   :
      132       assign
      133           v-fmtcli-schet-exists       = no
      134           v-fmtcli-bank-exists        = no
      135           v-fmtcli-bank-r-schet       = "":U
      136           v-fmtcli-bank-c-schet       = "":U
      137           v-fmtcli-bank-bik           = "":U
      138           v-fmtcli-bank-name          = "":U
      139           v-fmtcli-bank-addres        = "":U
      140           v-fmtcli-bank-city          = "":U
      141       .
      142       search-for-schet:
      143       for each buf_fin-schet no-lock
      144          where buf_fin-schet.host-code = p-host-code
      145            and buf_fin-schet.cli-type  = p-obj-type
      146            and buf_fin-schet.cli-code  = p-obj-code
      147            and buf_fin-schet.curr-code = p-curr-code
      148       on error undo, return error
      149       :
      150           if buf_fin-schet.status_   = 'удал':U
      151           then do:
      152           end.
      153           else do:
      154               assign
      155                   v-fmtcli-schet-exists   = yes
      156                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      157                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      158               .
      159               find first buf_fin-bank no-lock
      160                    where buf_fin-bank.host-code = p-host-code
      161                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      162               no-error.
      163               if available buf_fin-bank
      164               then do:
      165                   assign
      166                       v-fmtcli-bank-exists      = yes
      167                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      168                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      169                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      170                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      171                   .
      172               end.
      173               else do:
      174                   assign
      175                       v-fmtcli-bank-exists    = no
      176                       v-fmtcli-bank-bik       = "":U
      177                       v-fmtcli-bank-name      = "":U
      178                       v-fmtcli-bank-addres    = "":U
      179                       v-fmtcli-bank-city      = "":U
      180                   .
      181               end.
      182               leave search-for-schet.
      183           end.
      184       end.
      185   end.
      186   end procedure.
      187   procedure fmtcli-get-client :
      188   define input parameter p-obj-type       as character    no-undo.
      189   define input parameter p-obj-code       as integer      no-undo.
      190       define variable v-temp-fmtcli-address      as character     no-undo.
      191       define variable v-num-country-city    as integer      no-undo.
      192       define buffer buf_clients   for ub.clients.
      193       define buffer buf_firm      for ub.firm.
      194       define buffer buf_store     for ub.store.
      195       define buffer buf_shop      for ub.shop.
      196       define buffer buf_person    for ub.person.
      197   do
      198   for buf_clients
      199     , buf_firm
      200     , buf_store
      201     , buf_shop
      202     , buf_person
      203   on error undo, return error
      204   :
      205       assign
      206           v-fmtcli-name           = "":U
      207           v-fmtcli-addres         = "":U
      208           v-fmtcli-post-addres    = "":U
      209           v-fmtcli-full-addres    = "":U
      210           v-fmtcli-phone          = "":U
      211           v-fmtcli-inn            = "":U
      212           v-fmtcli-kpp            = "":U
      213           v-fmtcli-okpo           = "":U
      214           v-fmtcli-city           = "":U
      215           v-fmtcli-index          = "":U
      216           v-fmtcli-country        = "":U
      217       .
      218       find first buf_clients no-lock
      219            where buf_clients.obj-type = p-obj-type
      220              and buf_clients.obj-code = p-obj-code
      221       .
      222       assign
      223           v-fmtcli-name = buf_clients.obj-name
      224       .
      225       case buf_clients.obj-type:
      226          when 'орг':U
      227          then do:
      228               find first buf_firm no-lock
      229                    where buf_firm.firm-code = buf_clients.obj-code
      230                    no-error
      231               .
      232               if available buf_firm
      233               then do:
      234                   assign
      235                       v-num-country-city = num-entries( buf_firm.city )
      236                       v-fmtcli-engl-name = buf_firm.engl-name
      237                   .
      238                   if v-num-country-city > 0
      239                   then do:
      240                       assign
      241                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      242                       .
      243                   end.
      244                   if v-num-country-city > 1
      245                   then do:
      246                       assign
      247                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      248                       .
      249                   end.
      250                   run fmtcli-concatenate-strings in this-procedure (
      251                         input v-fmtcli-full-addres
      252                       , input v-fmtcli-country
      253                       , input ", ":U
      254                       , input 50
      255                       , output v-fmtcli-full-addres
      256                   ).
      257                   run fmtcli-concatenate-strings in this-procedure (
      258                         input v-fmtcli-full-addres
      259                       , input v-fmtcli-city
      260                       , input ", ":U
      261                       , input 50
      262                       , output v-fmtcli-full-addres
      263                   ).
      264                   run fmtcli-concatenate-strings in this-procedure (
      265                         input v-fmtcli-full-addres
      266                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      267                       , input ", ":U
      268                       , input 50
      269                       , output v-fmtcli-full-addres
      270                   ).
      271                   run fmtcli-concatenate-strings in this-procedure (
      272                         input v-fmtcli-post-addres
      273                       , input v-fmtcli-country
      274                       , input ", ":U
      275                       , input 50
      276                       , output v-fmtcli-post-addres
      277                   ).
      278                   run fmtcli-concatenate-strings in this-procedure (
      279                         input v-fmtcli-post-addres
      280                       , input v-fmtcli-city
      281                       , input ", ":U
      282                       , input 50
      283                       , output v-fmtcli-post-addres
      284                   ).
      285                   run fmtcli-concatenate-strings in this-procedure (
      286                         input v-fmtcli-post-addres
      287                       , input string( buf_firm.ind )
      288                       , input ", ":U
      289                       , input 50
      290                       , output v-fmtcli-post-addres
      291                   ).
      292                   run fmtcli-concatenate-strings in this-procedure (
      293                         input substring( buf_firm.addres1, 1, 50 )
      294                       , input buf_firm.addres2
      295                       , input " ":U
      296                       , input 50
      297                       , output v-temp-fmtcli-address
      298                   ).
      299                   run fmtcli-concatenate-strings in this-procedure (
      300                         input v-temp-fmtcli-address
      301                       , input substring( buf_firm.addres1, 51, 50 )
      302                       , input " ":U
      303                       , input 50
      304                       , output v-temp-fmtcli-address
      305                   ).
      306                   run fmtcli-concatenate-strings in this-procedure (
      307                         input v-temp-fmtcli-address
      308                       , input substring( buf_firm.addres1, 101, 50 )
      309                       , input " ":U
      310                       , input 50
      311                       , output v-temp-fmtcli-address
      312                   ).
      313                   assign
      314                       v-fmtcli-addres = v-temp-fmtcli-address
      315                   .
      316                   if buf_firm.addres1 <> ?
      317                   then do:
      318                       run fmtcli-concatenate-strings in this-procedure (
      319                             input v-fmtcli-full-addres
      320                           , input v-fmtcli-addres
      321                           , input ", ":U
      322                           , input 0
      323                           , output v-fmtcli-full-addres
      324                       ).
      325                   end.
      326                   run fmtcli-concatenate-strings in this-procedure (
      327                         input substring( buf_firm.post-addr1, 1, 50 )
      328                       , input buf_firm.post-addr2
      329                       , input " ":U
      330                       , input 50
      331                       , output v-fmtcli-post-addres
      332                   ).
      333                   run fmtcli-concatenate-strings in this-procedure (
      334                         input v-fmtcli-post-addres
      335                       , input substring( buf_firm.post-addr1, 51, 50 )
      336                       , input " ":U
      337                       , input 50
      338                       , output v-fmtcli-post-addres
      339                   ).
      340                   run fmtcli-concatenate-strings in this-procedure (
      341                         input v-fmtcli-post-addres
      342                       , input substring( buf_firm.post-addr1, 101, 50 )
      343                       , input " ":U
      344                       , input 50
      345                       , output v-fmtcli-post-addres
      346                   ).
      347                   assign
      348                       v-fmtcli-phone         = buf_firm.phone
      349                       v-fmtcli-inn           = buf_firm.inn
      350                       v-fmtcli-kpp           = buf_firm.kpp
      351                       v-fmtcli-okpo          = buf_firm.okpo
      352                       v-fmtcli-index         = string( buf_firm.ind )
      353                   .
      354               end.
      355          end.
      356          when 'маг':U
      357          then do:
      358               find first buf_shop no-lock
      359                    where buf_shop.obj-code = buf_clients.obj-code
      360               .
      361               if available buf_shop
      362               then do:
      363                   run fmtcli-concatenate-strings in this-procedure (
      364                         input buf_shop.addres1
      365                       , input buf_shop.addres2
      366                       , input " ":U
      367                       , input 50
      368                       , output v-fmtcli-addres
      369                   ).
      370                   assign
      371                       v-fmtcli-full-addres = v-fmtcli-addres
      372                       v-fmtcli-post-addres = v-fmtcli-addres
      373                       v-fmtcli-phone       = buf_shop.phone
      374                       v-fmtcli-inn         = "":U
      375                       v-fmtcli-kpp         = "":U
      376                       v-fmtcli-okpo        = "":U
      377                       v-fmtcli-city        = "":U
      378                       v-fmtcli-index       = "":U
      379                   .
      380               end.
      381          end.
      382          when 'скл':U
      383          then do:
      384               find first buf_store no-lock
      385                    where buf_store.obj-code = buf_clients.obj-code
      386               .
      387               if available buf_store
      388               then do:
      389                   run fmtcli-concatenate-strings in this-procedure (
      390                         input buf_store.addres1
      391                       , input buf_store.addres2
      392                       , input " ":U
      393                       , input 50
      394                       , output v-fmtcli-addres
      395                   ).
      396                   assign
      397                       v-fmtcli-full-addres = v-fmtcli-addres
      398                       v-fmtcli-phone       = buf_store.phone
      399                       v-fmtcli-inn         = "":U
      400                       v-fmtcli-kpp         = "":U
      401                       v-fmtcli-okpo        = "":U
      402                       v-fmtcli-city        = "":U
      403                       v-fmtcli-index       = "":U
      404                   .
      405               end.
      406          end.
      407          when 'чел':U
      408          then do:
      409               find first buf_person no-lock
      410                    where buf_person.psn-code = buf_clients.obj-code
      411               .
      412               if available buf_person
      413               then do:
      414                   run fmtcli-concatenate-strings in this-procedure (
      415                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      416                                 then "":U
      417                                 else string( buf_person.ind, "999999")
      418                                 )
      419                       , input buf_person.city
      420                       , input ", ":U
      421                       , input 0
      422                       , output v-fmtcli-full-addres
      423                   ).
      424                   assign
      425                       v-fmtcli-addres = buf_person.address
      426                   .
      427                   run fmtcli-concatenate-strings in this-procedure (
      428                         input v-fmtcli-full-addres
      429                       , input v-fmtcli-addres
      430                       , input ", ":U
      431                       , input 0
      432                       , output v-fmtcli-full-addres
      433                   ).
      434                   assign
      435                       v-fmtcli-phone     = buf_person.phone1
      436                       v-fmtcli-inn       = buf_person.inn
      437                       v-fmtcli-kpp       = buf_person.kpp
      438                       v-fmtcli-okpo      = buf_person.okpo
      439                       v-fmtcli-city      = buf_person.city
      440                       v-fmtcli-index     = string( buf_person.ind )
      441                   .
      442               end.
      443          end.
      444       end case.
      445   end.
      446   end procedure.
      447   procedure fmtcli-concatenate-strings :
      448   define input parameter p-string-1       as character        no-undo.
      449   define input parameter p-string-2       as character        no-undo.
      450   define input parameter p-delimiter      as character        no-undo.
      451   define input parameter p-length         as integer          no-undo.
      452   define output parameter p-out-string    as character        no-undo.
      453   do
      454   on error undo, return error
      455   :
      456       assign
      457           p-out-string = ( if p-string-1 = ?
      458                            then "":U
      459                            else trim( p-string-1 ) )
      460       .
      461       assign
      462           p-out-string = p-out-string
      463                        + ( if p-out-string = "":U
      464                            or length( p-out-string ) = p-length
      465                            or p-string-2 = ?
      466                            or trim( p-string-2 ) = "":U
      467                            then "":U
      468                            else p-delimiter )
      469                        + ( if p-string-2 = ?
      470                            or trim( p-string-2 ) = "":U
      471                            then "":U
      472                            else trim( p-string-2 ) )
      473       .
      474   end.
      475   end procedure.
      476   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477     define variable v-cntxt-db-num        as integer   no-undo .
      478     define variable v-cntxt-userid        as character no-undo .
      479     define variable v-cntxt-level         as character no-undo .
      480     define variable v-cntxt-host-code-obj as integer   no-undo .
      481     define variable v-cntxt-obj-type      as character no-undo .
      482     define variable v-cntxt-obj-code      as integer   no-undo .
      483     define variable v-cntxt-db-num-obj    as integer   no-undo .
      484     define variable v-cntxt-is-admin      as logical   no-undo .
      485   define variable  p-db-num like ub.db.db-num no-undo .
      486   define variable p-obj-type like ub.clients.obj-type no-undo .
      487   define variable p-obj-code like ub.clients.obj-code no-undo .
      488   define variable action     as character no-undo .
      489   define variable log-file-name as character no-undo init "send-cd.txt".
      490   define variable v-view-log as logical no-undo .
      491   define variable callpoint as character no-undo.
      492   define variable glog as logical no-undo .
      493   define buffer buf_shop for ub.shop.
      494   define buffer buf_clients for ub.clients.
      495   define buffer buf_cash-desk for ub.cash-desk.
      496   define buffer bfcdm_cash-desk for ub.cash-desk.
      497   assign
      498   p-db-num = integer(entry(1, p-parameter, chr(4)))
      499   p-obj-code = integer(entry(2, p-parameter, chr(4)))
      500   action     = entry(3, p-parameter, chr(4))
      501   no-error
      502   .
      503   if error-status:error then do:
      504     run write-log-and-file in p-log-handle (
      505           input 1
      506         , input log-file-name
      507         , input 1
      508         , input substitute("Ошибка входных параметров &1:&2&3"
      509                            , p-parameter
      510                            , chr(10)
      511                            , error-status:get-message(1)
      512                            )).
      513     v-view-log = yes.
      514     undo, return error .
      515   end .
      516   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517     run mainmenu_getcntxt in parparentproc
      518       (output v-cntxt-db-num
      519       ,output v-cntxt-userid
      520       ,output v-cntxt-level
      521       ,output v-cntxt-host-code-obj
      522       ,output v-cntxt-obj-type
      523       ,output v-cntxt-obj-code
      524       ,output v-cntxt-db-num-obj
      525       ,output v-cntxt-is-admin
      526       ) .
      527   assign
      528   callpoint = action.
      529   action = if action = "R" then "U" else action.
      530   for each cash-obj:
      531       delete cash-obj.
      532   end.
      533   FIND FIRST ub.cash-desk NO-LOCK WHERE
      534              ub.cash-desk.db-num = g#db-num
      535          AND ub.cash-desk.pos-type = 'IBM-XML':U
      536          AND ub.cash-desk.autonomy = integer('2':U)  No-error.
      537   IF not avail(ub.cash-desk) then do:
      538     if callpoint <> "R" then do:
      539         run write-log-and-file in p-log-handle (
      540               input 1
      541             , input log-file-name
      542             , input 1
      543             , input substitute( "!!!&1 объектов БД реализуется только для кассового менеджера IBM"
      544                                 , (if action = "U" then "Передача" else "Удаление")
      545                               )
      546                                               ).
      547        return.
      548     end.
      549   end.
      550   if callpoint = "R"
      551   then do:
      552     glog = yes.
      553   end.
      554   else do:
      555     define variable v-host-code as integer   no-undo .
      556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      558     (input  p-obj-type
      559     ,input  p-obj-code
      560     ,output v-host-code
      561     )  .
      562   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   do:
      564     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      565       (input  v-cntxt-db-num
      566       ,input  v-cntxt-userid
      567       ,input  0
      568       ,input  'actn_cashdesk-reference_update':U
      569       ,input  'object':U
      570       ,input  v-host-code
      571       ,input  p-obj-type
      572       ,input  p-obj-code
      573       ,input  0
      574       ,input  0
      575       ,input  0
      576       ,input  true
      577       ,output glog
      578       )  .
      579   end.
      580   end.
      581   if NOT glog then return .
      582   glog = yes.
      583   run write-log-and-file in p-log-handle (
      584         input 1
      585       , input log-file-name
      586       , input 1
      587       , input substitute("&1 магазина &2: пересылка всех имеющихся в БД объектов"
      588                         , (if action = "U" then "Пересылка на кассы" else "Удаление с касс" )
      589                         , p-obj-code)
      590       ).
      591   run write-log-and-file in p-log-handle (
      592           input 1
      593         , input log-file-name
      594         , input 1
      595         , input substitute("Подготовка данных")
      596                                         ).
      597     find first cash-obj where
      598              cash-obj.km-objtype = 0
      599          AND  cash-obj.km-objcode = g#db-num
      600          AND cash-obj.km-objname = "БД" + string(g#db-num)
      601            no-error .
      602     if not available cash-obj then do:
      603       create cash-obj.
      604       assign
      605       cash-obj.km-objcode = g#db-num
      606       cash-obj.km-objtype = 0
      607       cash-obj.km-objname = "БД" + string(g#db-num)
      608       cash-obj.on-addr    = "":U
      609       cash-obj.off-addr   = "":U
      610       cash-obj.shop-nums  = "":U
      611       cash-obj.obj-lock   = 0
      612       .
      613       for each bfcdm_cash-desk no-lock where
      614               bfcdm_cash-desk.db-num = g#db-num
      615         AND  bfcdm_cash-desk.pos-type = 'IBM-XML':U
      616         AND  bfcdm_cash-desk.autonomy = integer('2':U)
      617         :
      618           assign
      619           cash-obj.shop-nums = cash-obj.shop-nums
      620                               + (if cash-obj.shop-nums = "":u then "":U else chr(44))
      621                               + string(bfcdm_cash-desk.obj-code)
      622           .
      623       end.
      624     end.
      625     find first cash-obj where
      626              cash-obj.km-objtype = 2
      627          AND  cash-obj.km-objcode = 0
      628          AND cash-obj.km-objname = "КМ"
      629            no-error .
      630     if not available cash-obj then do:
      631       create cash-obj.
      632       assign
      633       cash-obj.km-objcode = 0
      634       cash-obj.km-objtype = 2
      635       cash-obj.km-objname = "КМ"
      636       cash-obj.on-addr    = "":U
      637       cash-obj.off-addr   = "":U
      638       cash-obj.shop-nums  = "":U
      639       cash-obj.obj-lock   = 0
      640       .
      641      for each bfcdm_cash-desk no-lock where
      642               bfcdm_cash-desk.db-num = g#db-num
      643         AND  bfcdm_cash-desk.pos-type = 'IBM-XML':U
      644         AND  bfcdm_cash-desk.autonomy = integer('2':U)
      645         :
      646           assign
      647           cash-obj.shop-nums = cash-obj.shop-nums
      648                               + (if cash-obj.shop-nums = "":u then "":U else chr(44))
      649                               + string(bfcdm_cash-desk.obj-code)
      650           .
      651      end.
      652    end.
      653   _for:
      654   for each buf_clients no-lock where
      655             buf_clients.db-num = g#db-num
      656         AND buf_clients.obj-type = 'маг':U:
      657     find first buf_shop no-lock where
      658                 buf_shop.obj-code = buf_clients.obj-code no-error .
      659     if not available buf_shop then next _for.
      660     FIND FIRST cash-desk NO-LOCK WHERE
      661              cash-desk.db-num = g#db-num
      662          AND cash-desk.pos-type = 'IBM-XML':U
      663          AND cash-desk.autonomy = integer('1':U)
      664          AND cash-desk.is-del   = no
      665          AND cash-desk.obj-code  = buf_clients.obj-code
      666          No-error.
      667     if not available cash-desk then next _for.
      668     find first cash-obj where
      669              cash-obj.km-objtype = 1
      670          AND  cash-obj.km-objcode = buf_clients.obj-code no-error .
      671     if not available cash-obj then do:
      672       run fmtcli-get-client in this-procedure
      673                                     (
      674                                      input 'орг':U
      675                                     ,input buf_clients.host-code
      676                                     ).
      677       create cash-obj.
      678       assign
      679       cash-obj.km-objcode = buf_clients.obj-code
      680       cash-obj.km-objtype = 1
      681       cash-obj.km-objname = buf_clients.obj-type + string(buf_clients.obj-code)
      682       cash-obj.on-addr    = "":U
      683       cash-obj.off-addr   = "":U
      684       cash-obj.shop-nums  = string(buf_clients.obj-code)
      685       cash-obj.obj-lock   = buf_clients.stts
      686       cash-obj.firm-name  = v-fmtcli-name
      687       cash-obj.jur-address = v-fmtcli-addres
      688       cash-obj.post-address = v-fmtcli-post-addres
      689       cash-obj.INN         = v-fmtcli-INN
      690       cash-obj.KPP         = v-fmtcli-KPP
      691       .
      692     end.
      693     for each buf_cash-desk no-lock where
      694                 buf_cash-desk.db-num = g#db-num
      695             AND buf_cash-desk.obj-code = buf_shop.obj-code
      696             AND buf_cash-desk.pos-type = 'IBM-XML':U:
      697       if buf_cash-desk.autonomy = integer('0':U) then next.
      698       if buf_cash-desk.autonomy = integer('2':U) then next.
      699       find first cash-obj where
      700               cash-obj.km-objtype = (if buf_cash-desk.autonomy = integer('2':U) then 2 else 3)
      701           AND  cash-obj.km-objcode = buf_cash-desk.cash-num no-error .
      702       if not available cash-obj then do:
      703         create cash-obj.
      704         assign
      705         cash-obj.km-objcode = buf_cash-desk.cash-num
      706         cash-obj.km-objtype = (if buf_cash-desk.autonomy = integer('2':U) then 2 else 3)
      707         cash-obj.km-objname = (if buf_cash-desk.autonomy = integer('2':U)
      708                                then "КМ"
      709                                else ("маг" + string(buf_cash-desk.obj-code) + "_касса" + string(buf_cash-desk.cash-num))
      710                                )
      711         cash-obj.on-addr    = (if buf_cash-desk.autonomy = integer('2':U)
      712                               then buf_cash-desk.addr-path
      713                               else (entry(1, buf_cash-desk.addr-path, chr(4))
      714                                     + "://":U
      715                                     + entry(2, buf_cash-desk.addr-path, chr(4))
      716                                    )
      717                               )
      718         cash-obj.off-addr   = (if buf_cash-desk.autonomy = integer('2':U)
      719                               then buf_cash-desk.addr-path
      720                               else (entry(1, buf_cash-desk.addr-path, chr(4))
      721                                     + "://":U
      722                                     + entry(2, buf_cash-desk.addr-path, chr(4))
      723                                    )
      724                               )
      725         cash-obj.shop-nums  = if buf_cash-desk.autonomy = integer('1':U)
      726                               then  string(buf_cash-desk.obj-code)
      727                               else "":U
      728         cash-obj.obj-lock   = if ((action = "U":U or callpoint = "R":U) and buf_cash-desk.cash-on )
      729                               then 0
      730                               else 1
      731         .
      732         if buf_cash-desk.autonomy = integer('2':U) then do:
      733           for each bfcdm_cash-desk no-lock where
      734                   bfcdm_cash-desk.db-num = g#db-num
      735             AND  bfcdm_cash-desk.pos-type = 'IBM-XML':U
      736             AND  bfcdm_cash-desk.autonomy = integer('2':U)
      737             AND  bfcdm_cash-desk.cash-on = yes
      738             :
      739              assign
      740              cash-obj.shop-nums = cash-obj.shop-nums
      741                                   + (if cash-obj.shop-nums = "":u then "":U else chr(44))
      742                                   + string(bfcdm_cash-desk.obj-code)
      743              .
      744           end.
      745         end.
      746       end.
      747     end.
      748   end.
      749   if can-find(first cash-obj ) then do:
      750     run str/send-obj.p (
      751                       input parparentproc
      752                     ,input this-procedure
      753                     ,input p-log-handle
      754                     ,input (string(g#db-num) + chr(4) +
      755                             string(p-obj-code) + chr(4) +
      756                             action)) no-error.
      757     if not error-status:error then do:
      758       run write-log-and-file in p-log-handle (
      759             input 1
      760           , input log-file-name
      761           , input 1
      762           , input substitute("&1 маг&2 &3"
      763                               , (if action = "U"
      764                                 then "Передача объектов БД на кассы"
      765                                 else "Удаление объектов БД с касс")
      766                               , p-obj-code
      767                               , (if action = "U"
      768                                 then "проведена"
      769                                 else "проведено")
      770                               )
      771                                           ).
      772     end.
      773     else do:
      774       assign
      775       v-view-log = yes
      776       .
      777     end.
      778   end.
      779   else do:
      780       run write-log-and-file in p-log-handle (
      781             input 1
      782           , input log-file-name
      783           , input 1
      784           , input substitute("Не найдено информации по объектам БД для передачи на кассы маг&1")
      785                               , p-obj-code
      786                                           ).
      787   end.
      788     finally :
      789   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   if v-view-log
      791   and not g#news
      792   and not g#auto
      793   then do:
      794     message
      795     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      796     "!!!Внимательно прочитайте Log-file!!"
      797     view-as alert-box error .
      798        define variable v-user-action7   as character no-undo .
      799     define variable v-printed7       as logical   no-undo .
      800     run gbl/prnfilen.w
      801       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      802       ,input  0
      803       ,input  (string("./":U) + log-file-name)
      804       ,input  7
      805       ,output v-user-action7
      806       ,output v-printed7
      807       ) .
      808   end.
      809   if v-view-log = true
      810   and (g#news
      811   or g#auto)
      812   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      813   then do:
      814      run cb_set-view-log in p-parent-handle ( input yes).
      815   end.
      816       run write-log-and-file in p-log-handle (
      817           input 1
      818         , input log-file-name
      819         , input 1
      820         , input substitute("&1", chr(10))
      821       ).
      822       define variable v-save-file-name as character no-undo .
      823       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
      824       OS-APPEND value(log-file-name) value(v-save-file-name).
      825       OS-DELETE value(log-file-name).
      826     end finally .
