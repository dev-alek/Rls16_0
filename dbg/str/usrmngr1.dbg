     2103   PROCEDURE fill-temp-menu-group :
     2104   do
     2105   on error undo, return error
     2106   :
     2107   define buffer buf_tt-work-place    for tt-work-place.
     2108   define buffer buf_user-menu-group   for user-menu-group.
     2109   define buffer buf_menu-group        for menu-group.
     2110   define variable v-sel-host-count    as integer      no-undo.
     2111   IF AVAILABLE br_tt-work-place then do:
     2112      find first buf_tt-work-place
     2113            where buf_tt-work-place.selected = TRUE
     2114            no-lock
     2115            no-error
     2116            .
     2117      if NOT available buf_tt-work-place then do:
     2118            empty temp-table tt-menu-group.
     2119         FOR EACH  buf_user-menu-group
     2120               WHERE (buf_user-menu-group.db-num    = p-db-num
     2121                  AND buf_user-menu-group.user-id   = p-user-id
     2122                  AND buf_user-menu-group.menu-group-context = br_tt-work-place.context
     2123                  AND buf_user-menu-group.menu-group-context = 'firm':U
     2124                  AND buf_user-menu-group.host-code = br_tt-work-place.wp-host)
     2125                  OR
     2126                      (buf_user-menu-group.db-num    = p-db-num
     2127                  AND buf_user-menu-group.user-id   = p-user-id
     2128                  AND buf_user-menu-group.menu-group-context   = br_tt-work-place.context
     2129                  AND buf_user-menu-group.menu-group-context = 'object':U
     2130                  AND buf_user-menu-group.obj-type = br_tt-work-place.wp-type
     2131                  AND buf_user-menu-group.obj-code = br_tt-work-place.wp-code)
     2132            NO-LOCK
     2133            ,
     2134            FIRST buf_menu-group
     2135            WHERE buf_menu-group.menu-code       = buf_user-menu-group.menu-code
     2136              AND buf_menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     2137            NO-LOCK
     2138            :
     2139            create tt-menu-group.
     2140            assign
     2141               tt-menu-group.menu-group-code          = buf_user-menu-group.menu-group-code
     2142               tt-menu-group.menu-group-name          = buf_menu-group.menu-group-name
     2143               tt-menu-group.menu-group-description   = buf_menu-group.menu-group-description
     2144               tt-menu-group.sel-color                = 0
     2145            .
     2146         END.
     2147      END.
     2148      else do:
     2149        empty temp-table tt-menu-group.
     2150        assign
     2151           v-sel-host-count = 0
     2152        .
     2153        for each  buf_tt-work-place
     2154            where buf_tt-work-place.selected = TRUE
     2155        :
     2156           assign
     2157              v-sel-host-count = v-sel-host-count + 1
     2158           .
     2159        end.
     2160        for each  buf_tt-work-place
     2161            where buf_tt-work-place.selected = TRUE
     2162        :
     2163            FOR  EACH buf_user-menu-group
     2164               WHERE (buf_user-menu-group.db-num    = p-db-num
     2165                  AND buf_user-menu-group.user-id   = p-user-id
     2166                  AND buf_user-menu-group.menu-group-context = buf_tt-work-place.context
     2167                  AND buf_user-menu-group.menu-group-context = 'firm':U
     2168                  AND buf_user-menu-group.host-code = buf_tt-work-place.wp-host)
     2169                  OR
     2170                      (buf_user-menu-group.db-num    = p-db-num
     2171                  AND buf_user-menu-group.user-id   = p-user-id
     2172                  AND buf_user-menu-group.menu-group-context   = buf_tt-work-place.context
     2173                  AND buf_user-menu-group.menu-group-context = 'object':U
     2174                  AND buf_user-menu-group.obj-type = buf_tt-work-place.wp-type
     2175                  AND buf_user-menu-group.obj-code = buf_tt-work-place.wp-code)
     2176               NO-LOCK
     2177               ,
     2178               FIRST buf_menu-group
     2179               WHERE buf_menu-group.menu-code     = buf_user-menu-group.menu-code
     2180               AND buf_menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     2181               NO-LOCK
     2182               :
     2183               find first tt-menu-group
     2184                  where tt-menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     2185                  no-error
     2186                  .
     2187               IF NOT AVAILABLE tt-menu-group then do:
     2188                  create tt-menu-group.
     2189                  assign
     2190                     tt-menu-group.menu-group-code          = buf_user-menu-group.menu-group-code
     2191                     tt-menu-group.menu-group-name          = buf_menu-group.menu-group-name
     2192                     tt-menu-group.sel-color                = v-sel-host-count
     2193                     tt-menu-group.menu-group-description   = buf_menu-group.menu-group-description
     2194                  .
     2195               end.
     2196               assign
     2197                  tt-menu-group.sel-color = tt-menu-group.sel-color - 1
     2198               .
     2199            END.
     2200        end.
     2201     end.
     2202   end.
     2203   end.
     2204   END PROCEDURE.
     2205   PROCEDURE fill-wp :
     2206   DEFINE BUFFER buf_user-obj  FOR user-obj.
     2207   DEFINE BUFFER buf_user-host FOR user-host.
     2208   DEFINE BUFFER buf_clients   FOR clients.
     2209   do
     2210   on error undo, return error
     2211   :
     2212      IF p-obj-type = 'орг':U THEN DO:
     2213         FOR EACH  buf_user-host
     2214            WHERE buf_user-host.db-num  = p-db-num
     2215               AND buf_user-host.USER-ID = p-user-id
     2216               and buf_user-host.host-code = p-obj-code
     2217            NO-LOCK
     2218            :
     2219            FIND FIRST buf_clients
     2220                  WHERE buf_clients.obj-code = buf_user-host.host-code
     2221                  AND buf_clients.obj-type = 'орг':U
     2222                  NO-LOCK
     2223               .
     2224            CREATE br_tt-work-place.
     2225            ASSIGN
     2226               br_tt-work-place.wp-code = buf_clients.obj-code
     2227               br_tt-work-place.wp-type = buf_clients.obj-type
     2228               br_tt-work-place.wp-host = buf_clients.obj-code
     2229               br_tt-work-place.db-num  = buf_clients.db-num
     2230               br_tt-work-place.context = 'firm':U
     2231               br_tt-work-place.wp-name = buf_clients.obj-name
     2232            .
     2233         END.
     2234      end.
     2235      else do:
     2236         FOR EACH  buf_user-obj
     2237             WHERE buf_user-obj.db-num  = p-db-num
     2238               AND buf_user-obj.USER-ID = p-user-id
     2239               and buf_user-obj.obj-type = p-obj-type
     2240               and buf_user-obj.obj-code = p-obj-code
     2241            NO-LOCK
     2242            :
     2243            FIND FIRST buf_clients
     2244                 WHERE buf_clients.obj-code = buf_user-obj.obj-code
     2245                   AND buf_clients.obj-type = buf_user-obj.obj-type
     2246                 NO-LOCK
     2247                .
     2248            IF  buf_clients.db-num <> p-db-num
     2249            and p-db-num <> 0
     2250            then do:
     2251               message
     2252                  Substitute( "Объект &1&2 &3 не относится к текущей БД"
     2253                            , buf_clients.obj-type
     2254                            , buf_clients.obj-code
     2255                            , buf_clients.obj-name
     2256                            )
     2257                  skip "Меню изменять нельзя"
     2258               view-as alert-box information.
     2259               return.
     2260            end.
     2261            CREATE br_tt-work-place.
     2262            ASSIGN
     2263               br_tt-work-place.wp-code = buf_clients.obj-code
     2264               br_tt-work-place.wp-type = buf_clients.obj-type
     2265               br_tt-work-place.wp-host = buf_clients.host-code
     2266               br_tt-work-place.db-num  = buf_clients.db-num
     2267               br_tt-work-place.context = 'object':U
     2268               br_tt-work-place.wp-name = buf_clients.obj-name
     2269            .
     2270         END.
     2271      end.
     2272   end.
     2273   END PROCEDURE.
     2274   PROCEDURE local-open-query :
     2275   define variable v-ok    as logical      no-undo.
     2276      do
     2277      on error undo, return error return-value
     2278      :
     2279         RUN fill-temp-menu-group IN THIS-PROCEDURE.
     2280         open query BROWSE-menu
     2281         for each  br_tt-menu-group
     2282               no-lock
     2283            indexed-reposition .
     2284      end.
     2285   END PROCEDURE.
     2286   PROCEDURE local-open-query-wp :
     2287     do
     2288     on error undo, return error return-value
     2289     :
     2290     end.
     2291   END PROCEDURE.
     2292   PROCEDURE procedure-user-menu-group-add :
     2293     DEFINE PARAMETER BUFFER buf_tt-work-place FOR tt-work-place.
     2294     define variable v-update-data               as logical   no-undo .
     2295     define variable v-output-menu-code          as integer   no-undo .
     2296     define variable v-output-menu-group-code    as integer   no-undo .
     2297     define variable v-output-menu-group-context as character no-undo .
     2298     define variable v-output-host-code          as integer   no-undo .
     2299     define variable v-output-obj-type           as character no-undo .
     2300     define variable v-output-obj-code           as integer   no-undo .
     2301     define variable v-user-menu-group-code      as integer   no-undo .
     2302     define buffer buf_user-menu-group for ub.user-menu-group .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306          case buf_tt-work-place.wp-type :
     2307          when 'орг':U THEN DO:
     2308               FIND FIRST buf_user-menu-group
     2309                    WHERE buf_user-menu-group.db-num          = p-db-num
     2310                      AND buf_user-menu-group.user-id         = p-user-id
     2311                      AND buf_user-menu-group.menu-group-code = br_menu-group.menu-group-code
     2312                      AND buf_user-menu-group.host-code       = buf_tt-work-place.wp-code
     2313                      and buf_user-menu-group.menu-group-context = 'firm':U
     2314                    EXCLUSIVE-LOCK
     2315                    NO-ERROR
     2316                    .
     2317               IF AVAILABLE buf_user-menu-group THEN DO:
     2318                  DELETE buf_user-menu-group.
     2319               END.
     2320               ELSE DO:
     2321                  ASSIGN
     2322                     v-user-menu-group-code = next-value(s-user-menu-group)
     2323                  .
     2324                  CREATE buf_user-menu-group .
     2325                  ASSIGN
     2326                     buf_user-menu-group.db-num               = p-db-num
     2327                     buf_user-menu-group.user-id              = p-user-id
     2328                     buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     2329                     buf_user-menu-group.menu-code            = br_menu-group.menu-code
     2330                     buf_user-menu-group.menu-group-code      = br_menu-group.menu-group-code
     2331                     buf_user-menu-group.menu-group-id        = br_menu-group.menu-group-id
     2332                     buf_user-menu-group.menu-group-context   = 'firm':U
     2333                     buf_user-menu-group.host-code            = buf_tt-work-place.wp-code
     2334                     buf_user-menu-group.obj-type             = '':U
     2335                     buf_user-menu-group.obj-code             = 0
     2336                  .
     2337               END.
     2338          END.
     2339          when 'маг':U OR
     2340          when 'скл':U then DO:
     2341               FIND FIRST buf_user-menu-group
     2342                    WHERE buf_user-menu-group.db-num          = p-db-num
     2343                      AND buf_user-menu-group.user-id         = p-user-id
     2344                      AND buf_user-menu-group.menu-group-code = br_menu-group.menu-group-code
     2345                      AND buf_user-menu-group.obj-code        = buf_tt-work-place.wp-code
     2346                      AND buf_user-menu-group.obj-type        = buf_tt-work-place.wp-type
     2347                      and buf_user-menu-group.menu-group-context = 'object':U
     2348                    EXCLUSIVE-LOCK
     2349                    NO-ERROR
     2350                    .
     2351               IF AVAILABLE buf_user-menu-group THEN DO:
     2352                  DELETE buf_user-menu-group.
     2353               END.
     2354               ELSE DO:
     2355                  ASSIGN
     2356                     v-user-menu-group-code = next-value(s-user-menu-group)
     2357                  .
     2358   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2360     (input  buf_tt-work-place.wp-type
     2361     ,input  buf_tt-work-place.wp-code
     2362     ,output v-output-host-code
     2363     )  .
     2364                  CREATE buf_user-menu-group .
     2365                  ASSIGN
     2366                     buf_user-menu-group.db-num               = p-db-num
     2367                     buf_user-menu-group.user-id              = p-user-id
     2368                     buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     2369                     buf_user-menu-group.menu-code            = br_menu-group.menu-code
     2370                     buf_user-menu-group.menu-group-code      = br_menu-group.menu-group-code
     2371                     buf_user-menu-group.menu-group-id        = br_menu-group.menu-group-id
     2372                     buf_user-menu-group.menu-group-context   = 'object':U
     2373                     buf_user-menu-group.host-code            = v-output-host-code
     2374                     buf_user-menu-group.obj-type             = buf_tt-work-place.wp-type
     2375                     buf_user-menu-group.obj-code             = buf_tt-work-place.wp-code
     2376                  .
     2377               END.
     2378          END.
     2379          otherwise do:
     2380               FIND FIRST buf_user-menu-group
     2381                    WHERE buf_user-menu-group.db-num             = p-db-num
     2382                      AND buf_user-menu-group.user-id            = p-user-id
     2383                      AND buf_user-menu-group.menu-group-code    = br_menu-group.menu-group-code
     2384                      and buf_user-menu-group.menu-group-context = 'global':U
     2385                    EXCLUSIVE-LOCK
     2386                    NO-ERROR
     2387                    .
     2388               IF AVAILABLE buf_user-menu-group THEN DO:
     2389                  DELETE buf_user-menu-group.
     2390               END.
     2391               ELSE DO:
     2392                  ASSIGN
     2393                     v-user-menu-group-code = next-value(s-user-menu-group)
     2394                  .
     2395                  CREATE buf_user-menu-group .
     2396                  ASSIGN
     2397                     buf_user-menu-group.db-num               = p-db-num
     2398                     buf_user-menu-group.user-id              = p-user-id
     2399                     buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     2400                     buf_user-menu-group.menu-code            = br_menu-group.menu-code
     2401                     buf_user-menu-group.menu-group-code      = br_menu-group.menu-group-code
     2402                     buf_user-menu-group.menu-group-id        = br_menu-group.menu-group-id
     2403                     buf_user-menu-group.menu-group-context   = 'global':U
     2404                     buf_user-menu-group.host-code            = 0
     2405                     buf_user-menu-group.obj-type             = '':U
     2406                     buf_user-menu-group.obj-code             = 0
     2407                  .
     2408               END.
     2409          end.
     2410          end case.
     2411     END.
     2412   END PROCEDURE.
     2413   PROCEDURE refresh-query :
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       run local-open-query in this-procedure .
     2418     end.
     2419   END PROCEDURE.
