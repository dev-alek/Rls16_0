     2539   PROCEDURE user-menu-group-del :
     2540     DEFINE PARAMETER BUFFER buf_tt-work-place FOR tt-work-place.
     2541     define variable v-update-data               as logical   no-undo .
     2542     define variable v-output-menu-code          as integer   no-undo .
     2543     define variable v-output-menu-group-code    as integer   no-undo .
     2544     define variable v-output-menu-group-context as character no-undo .
     2545     define variable v-output-host-code          as integer   no-undo .
     2546     define variable v-output-obj-type           as character no-undo .
     2547     define variable v-output-obj-code           as integer   no-undo .
     2548     define variable v-user-menu-group-code      as integer   no-undo .
     2549     define buffer buf_user-menu-group for ub.user-menu-group .
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553          case buf_tt-work-place.wp-type :
     2554          WHEN 'орг':U THEN DO:
     2555               FIND FIRST buf_user-menu-group
     2556                    WHERE buf_user-menu-group.db-num          = p-db-num
     2557                      AND buf_user-menu-group.user-id         = p-user-id
     2558                      AND buf_user-menu-group.menu-group-code = br_menu-group.menu-group-code
     2559                      AND buf_user-menu-group.host-code       = buf_tt-work-place.wp-code
     2560                      and buf_user-menu-group.menu-group-context = 'firm':U
     2561                    EXCLUSIVE-LOCK
     2562                    NO-ERROR
     2563                    .
     2564               IF AVAILABLE buf_user-menu-group THEN DO:
     2565                  DELETE buf_user-menu-group.
     2566               END.
     2567          END.
     2568          when 'маг':U OR
     2569          when 'скл':U then DO:
     2570               FIND FIRST buf_user-menu-group
     2571                    WHERE buf_user-menu-group.db-num          = p-db-num
     2572                      AND buf_user-menu-group.user-id         = p-user-id
     2573                      AND buf_user-menu-group.menu-group-code = br_menu-group.menu-group-code
     2574                      AND buf_user-menu-group.obj-code        = buf_tt-work-place.wp-code
     2575                      AND buf_user-menu-group.obj-type        = buf_tt-work-place.wp-type
     2576                      and buf_user-menu-group.menu-group-context = 'object':U
     2577                    EXCLUSIVE-LOCK
     2578                    NO-ERROR
     2579                    .
     2580               IF AVAILABLE buf_user-menu-group THEN DO:
     2581                  DELETE buf_user-menu-group.
     2582               END.
     2583          END.
     2584          otherwise do:
     2585               FIND FIRST buf_user-menu-group
     2586                    WHERE buf_user-menu-group.db-num          = p-db-num
     2587                      AND buf_user-menu-group.user-id         = p-user-id
     2588                      AND buf_user-menu-group.menu-group-code = br_menu-group.menu-group-code
     2589                      and buf_user-menu-group.menu-group-context = 'global':U
     2590                    EXCLUSIVE-LOCK
     2591                    NO-ERROR
     2592                    .
     2593               IF AVAILABLE buf_user-menu-group THEN DO:
     2594                  DELETE buf_user-menu-group.
     2595               END.
     2596          end.
     2597          end case.
     2598     END.
     2599   END PROCEDURE.
     2600   FUNCTION check-user-menu-group RETURNS logical
     2601      ( BUFFER buf_menu-group FOR menu-group ) :
     2602      define variable v-return-value as logical no-undo .
     2603      IF AVAILABLE br_tt-work-place THEN DO:
     2604         case br_tt-work-place.wp-type:
     2605         when 'орг':U THEN DO:
     2606            v-return-value =  CAN-FIND( FIRST user-menu-group
     2607                                        WHERE user-menu-group.db-num          = p-db-num
     2608                                          AND user-menu-group.user-id         = p-user-id
     2609                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2610                                          AND user-menu-group.host-code       = br_tt-work-place.wp-code
     2611                                          AND user-menu-group.menu-group-context   = 'firm':U
     2612                                          ).
     2613         END.
     2614         when 'маг':U OR
     2615         WHEN 'скл':U THEN DO:
     2616            v-return-value =  CAN-FIND( FIRST user-menu-group
     2617                                        WHERE user-menu-group.db-num          = p-db-num
     2618                                          AND user-menu-group.user-id         = p-user-id
     2619                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2620                                          AND user-menu-group.obj-code        = br_tt-work-place.wp-code
     2621                                          AND user-menu-group.obj-type        = br_tt-work-place.wp-type
     2622                                          AND user-menu-group.menu-group-context   = 'object':U
     2623                                          ).
     2624         END.
     2625         otherwise do:
     2626            v-return-value =  CAN-FIND( FIRST user-menu-group
     2627                                        WHERE user-menu-group.db-num          = p-db-num
     2628                                          AND user-menu-group.user-id         = p-user-id
     2629                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2630                                          AND user-menu-group.menu-group-context   = 'global':U
     2631                                          ).
     2632         end.
     2633         end case.
     2634      END.
     2635      return v-return-value .
     2636   END FUNCTION.
     2637   FUNCTION get-context-name RETURNS CHARACTER
     2638     (BUFFER buf_user-menu-group FOR user-menu-group ) :
     2639     define variable v-return-value as character no-undo .
     2640     run procedure-get-context-name in this-procedure
     2641       (input  buf_user-menu-group.menu-group-context
     2642       ,input  buf_user-menu-group.host-code
     2643       ,input  buf_user-menu-group.obj-type
     2644       ,input  buf_user-menu-group.obj-code
     2645       ,output v-return-value
     2646       ) .
     2647     return v-return-value .
     2648   END FUNCTION.
     2649   FUNCTION get-menu-group-name RETURNS CHARACTER
     2650     ( BUFFER buf_user-menu-group FOR user-menu-group ) :
     2651     define variable v-return-value as character no-undo .
     2652     run procedure-get-menu-group-name in this-procedure
     2653       (input  buf_user-menu-group.menu-code
     2654       ,input  buf_user-menu-group.menu-group-code
     2655       ,input  buf_user-menu-group.menu-group-id
     2656       ,output v-return-value
     2657       ) .
     2658     return v-return-value .
     2659   END FUNCTION.
