      263   DEFINE BUTTON b-chg-menu
      264        LABEL "&Изменить"
      265        SIZE 10 BY 1.
      266   DEFINE BUTTON b-exit AUTO-GO
      267        LABEL "&Выход"
      268        SIZE 10 BY 1
      269        BGCOLOR 8 .
      270   DEFINE BUTTON b-help
      271        LABEL "Помо&щь"
      272        SIZE 10 BY 1
      273        BGCOLOR 8 .
      274   DEFINE VARIABLE fi-db AS INTEGER FORMAT ">>>>9":U INITIAL 0
      275        LABEL "БД"
      276         VIEW-AS TEXT
      277        SIZE 10.38 BY .67
      278        FGCOLOR 4  NO-UNDO.
      279   DEFINE QUERY BROWSE-menu FOR
      280         br_tt-menu-group SCROLLING.
      281   DEFINE BROWSE BROWSE-menu
      282     QUERY BROWSE-menu NO-LOCK DISPLAY
      283         br_tt-menu-group.menu-group-name FORMAT "X(32)":U
      284         br_tt-menu-group.menu-group-description FORMAT "X(42)":U
      285       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.5 BY 15 FIT-LAST-COLUMN.
      286   DEFINE FRAME Dialog-Frame
      287        b-exit AT ROW 1 COL 1
      288        b-chg-menu AT ROW 1 COL 11 WIDGET-ID 28
      289        b-help AT ROW 1 COL 71
      290        BROWSE-menu AT ROW 2.25 COL 1.5 WIDGET-ID 400
      291        fi-db AT ROW 1.25 COL 27 COLON-ALIGNED WIDGET-ID 2
      292        SPACE(42.11) SKIP(15.53)
      293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      295            TITLE "Группы меню для пользователя"
      296            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      297   ASSIGN
      298          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      299          FRAME Dialog-Frame:HIDDEN           = TRUE.
      300   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      301   DO:
      302     APPLY "END-ERROR":U TO SELF.
      303   END.
      304   ON CHOOSE OF b-chg-menu IN FRAME Dialog-Frame
      305   DO:
      306      IF  AVAILABLE br_tt-work-place
      307      then do:
      308         run change-menu in this-procedure .
      309         RUN refresh-query IN THIS-PROCEDURE.
      310      end.
      311   END.
      312   ON ROW-DISPLAY OF BROWSE-menu IN FRAME Dialog-Frame
      313   DO:
      314     IF br_tt-menu-group.sel-color > 0
      315     then do:
      316        assign
      317         br_tt-menu-group.menu-group-name:bgcolor in browse BROWSE-menu = GRAY_COLOR
      318         br_tt-menu-group.menu-group-description:bgcolor in browse BROWSE-menu = GRAY_COLOR
      319        .
      320     end.
      321   END.
      322   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      323   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      324   define  buffer buf_tt-work-place for tt-work-place .
      325   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   on help of frame Dialog-Frame
      327   do:
      328     run gbl/app_help.p
      329       (input this-procedure :file-name
      330       ,input ''
      331       ,input ?
      332       ) no-error.
      333     if error-status :error then do:
      334       message
      335         "Ошибка при вызове помощи"
      336         error-status :get-message(1)
      337         view-as alert-box .
      338     end.
      339   end.
      340   run minbtn-set in this-procedure .
      341   on choose of b-help in frame Dialog-Frame
      342   do:
      343     apply "help":u to frame Dialog-Frame .
      344   end.
      345   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   procedure minbtn-set :
      347       do
      348           on error undo, return error return-value
      349           :
      350           define variable ii              as integer       no-undo .
      351           define variable fh              as widget-handle no-undo .
      352           define variable hh              as widget-handle no-undo .
      353           define variable v-h             as handle        extent 4 no-undo .
      354           define variable v-name-button   as character     no-undo .
      355           define variable v-help-old-x    as decimal       no-undo .
      356           define variable v-help-old-y    as decimal       no-undo .
      357           define variable v-help-old-size as decimal       no-undo .
      358           define variable v-frame-width   as decimal       no-undo .
      359           define variable jj              as integer       no-undo .
      360           do
      361               on error undo, return error
      362               :
      363               assign
      364                   v-frame-width = frame Dialog-Frame:width - 0.3
      365                   fh            = frame Dialog-Frame:first-child
      366                   hh            = fh:first-child
      367                   ii            = 1
      368                   .
      369               do while valid-handle(hh):
      370                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      371                   do:
      372                       case lc(hh:name) :
      373                           when "b-help" then
      374                               do:
      375                                   hh:load-image-up("cmp/b-help.bmp":u) .
      376                                   hh:load-image-down("cmp/b-help.bmp":u) .
      377                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      378                                   hh:TOOLTIP = "Помощь" .
      379                                   v-help-old-x = hh:column .
      380                                   v-help-old-y = hh:row    .
      381                                   v-help-old-size = hh:width .
      382                                   hh:width-chars = 2.5 .
      383                               end.
      384                           when "b-print" then
      385                               do:
      386                                   hh:load-image("cmp/b-print.bmp":u) .
      387                                   hh:TOOLTIP = "Печать" .
      388                                   v-h[ii] = hh:handle .
      389                                   ii = ii + 1 .
      390                                   hh:width-chars = 3 .
      391                               end.
      392                           when "b-history" or
      393                           when "b-hist" then
      394                               do:
      395                                   hh:load-image("cmp/b-hist.bmp":u) .
      396                                   hh:TOOLTIP = "История" .
      397                                   v-h[ii] = hh:handle .
      398                                   ii = ii + 1 .
      399                                   hh:width-chars = 3 .
      400                               end.
      401                           when "b-sch" then
      402                               do:
      403                                   hh:load-image("cmp/b-sch.bmp":u) .
      404                                   hh:TOOLTIP = "Установка Фильтра" .
      405                                   v-h[ii] = hh:handle .
      406                                   ii = ii + 1 .
      407                                   hh:width-chars = 3 .
      408                               end.
      409                           when "b-hist-user" then
      410                               do:
      411                                   hh:load-image("cmp/b-hist.bmp":u) .
      412                                   hh:TOOLTIP = "История пользователя" .
      413                                   ii = ii + 1 .
      414                               end.
      415                       end case.
      416                   end.
      417                   hh = hh:next-sibling.
      418               end.
      419               b-help:column = v-frame-width - b-help:width-chars.
      420               jj = 0.
      421               repeat ii = 4 to 1 by -1 :
      422                   if valid-handle (v-h[ii] ) then
      423                   do:
      424                       jj  = jj + 1 .
      425                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      426                       v-h[ii]:row    = v-help-old-y .
      427                   end.
      428               end.
      429           end.
      430       end.
      431   end procedure.
      432   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      433   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      434   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      435   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      436   define variable v-diasize-current-frame-width  as decimal   no-undo .
      437   define variable v-diasize-current-frame-height as decimal   no-undo .
      438   define variable v-diasize-change-size          as logical   no-undo .
      439   define variable v-diasize-resize-button        as handle    no-undo .
      440   define variable v-diasize-wndmax               as logical   no-undo .
      441   define variable v-diasize-wndstore             as logical   no-undo .
      442   define variable v-diasize-proc-name            as character no-undo .
      443   define variable v-diasize-browse-handle        as handle    no-undo .
      444   define variable v-diasize-browse-number        as integer   no-undo .
      445   define variable v-diasize-need-full-display    as logical   no-undo init false .
      446   define temp-table temp-diasize-handle no-undo
      447     field handle-value  as handle
      448     field save-position as decimal
      449     index xpk is primary unique handle-value
      450     .
      451   define temp-table temp-browse-handle no-undo
      452     field browse-type   as character
