      105   define variable v-inform-launched as logical no-undo initial false .
      106   procedure proc-alt-shift-f4:
      107     define variable v-action as character no-undo .
      108     if v-inform-launched = false then do:
      109       assign
      110         v-inform-launched = true
      111       .
      112       run gbl/d-inform.w
      113         (  input self
      114         ,  input this-procedure
      115         , output v-action
      116         ) no-error .
      117       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
