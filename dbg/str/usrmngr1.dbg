      185   procedure twowin_add-item :
      186   define input parameter p-ext-key   as character        no-undo.
      187   define input parameter p-item-name as character        no-undo.
      188   define input parameter p-item-desc as character        no-undo.
      189   define input parameter p-selected  as logical          no-undo.
      190       define buffer buf_temp_twowin_items        for temp_twowin_items.
      191   do
      192   for buf_temp_twowin_items
      193   on error undo, return error
      194   :
      195       assign
      196           v-twowin1-itm-key = v-twowin1-itm-key + 1
      197       .
      198       create temp_twowin_items.
      199       assign
      200           temp_twowin_items.itm-key      = v-twowin1-itm-key
      201           temp_twowin_items.itmExtKey    = p-ext-key
      202           temp_twowin_items.itmName      = p-item-name
      203           temp_twowin_items.itmDesc      = p-item-desc
      204           temp_twowin_items.itmSelected  = p-selected
      205           temp_twowin_items.selLeft      = no
      206           temp_twowin_items.selRight     = no
      207       .
      208   end.
      209   end procedure.
