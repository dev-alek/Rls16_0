      455     field original-size as decimal
      456     index xpk is primary unique browse-type browse-number
      457     index xie browse-type browse-handle
      458   .
      459   procedure diasize_change-height :
      460     define input  parameter p-change-value  as decimal   no-undo .
      461     define input  parameter p-move-resize   as logical   no-undo .
      462     define variable v-field-group-handle    as handle    no-undo .
      463     define variable v-object-handle         as handle    no-undo .
      464     define variable v-frame-height          as decimal   no-undo .
      465     define variable v-frame-virtual-height  as decimal   no-undo .
      466     define variable v-browse-height         as decimal   no-undo .
      467     define variable v-window-height         as decimal   no-undo .
      468     define variable v-window-virtual-height as decimal   no-undo .
      469     define variable v-change-sign           as integer   no-undo .
      470     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      471     define buffer buf_temp-browse-handle  for temp-browse-handle .
      472     if p-change-value > 0
      473     then do:
      474       if frame Dialog-Frame :height + p-change-value
      475           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      476       then do:
      477         assign
      478           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      479                           - (frame Dialog-Frame :height-chars)
      480         .
      481         if p-change-value <= 0
      482         then do:
      483           run diasize_position-resize-button in this-procedure .
      484           return .
      485         end.
      486       end.
      487     end.
      488     if p-change-value < 0
      489     then do:
      490       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      491       then do:
      492         assign
      493           p-change-value = v-diasize-orig-frame-height
      494                          - (frame Dialog-Frame :height-chars)
      495         .
      496         if p-change-value >= 0
      497         then do:
      498           run diasize_position-resize-button in this-procedure .
      499           return .
      500         end.
      501       end.
      502     end.
      503     if p-change-value >= 0
      504     then do:
      505       assign
