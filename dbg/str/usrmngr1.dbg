     1154         on error undo move_block, retry move_block
     1155         :
     1156           assign
     1157             buf_temp-browse-handle.browse-handle :width
     1158               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1159             no-error .
     1160           if error-status :error
     1161           or error-status :get-message(1) <> ""
     1162           then do:
     1163             undo move_block, retry move_block .
     1164           end.
     1165         end.
     1166         assign
     1167           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1168           no-error .
     1169         if error-status :error
     1170         or error-status :get-message(1) <> ""
     1171         then do:
     1172           undo move_block, retry move_block.
     1173         end.
     1174         assign
     1175           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1176         no-error .
     1177         if error-status :error
     1178         or error-status :get-message(1) <> ""
     1179         then do:
     1180           undo move_block, retry move_block.
     1181         end.
     1182         if frame Dialog-Frame :scrollable = true
     1183         then do:
     1184           assign
     1185             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1186           no-error .
     1187           if error-status :error
     1188           or error-status :get-message(1) <> ""
     1189           then do:
     1190             undo move_block, retry move_block.
     1191           end.
     1192         end.
     1193       end.
     1194       if p-move-resize
     1195       then do:
     1196         run diasize_position-resize-button in this-procedure .
     1197       end.
     1198       if v-diasize-wndstore = true
     1199       then do:
     1200         if connected("ub") = true
     1201         then do:
     1202           define variable v-cntxt-db-num        as integer   no-undo .
     1203           define variable v-cntxt-userid        as character no-undo .
     1204           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1205                                             , OUTPUT v-cntxt-userid
     1206                                             ) .
     1207           run gbl/wndsizew.p
     1208             (input  v-cntxt-db-num
     1209             ,input  v-cntxt-userid
     1210             ,input  v-diasize-proc-name
     1211             ,input  'width':u
     1212             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1213             ) .
     1214         end.
     1215       end.
     1216     end.
     1217     assign
     1218       v-diasize-change-size = false
     1219     .
     1220   end procedure.
     1221   procedure diasize_set-width :
     1222     define input  parameter p-new-width  as decimal   no-undo .
     1223     define input  parameter p-move-resize as logical   no-undo .
     1224     do
     1225     on error undo, return error return-value
     1226     :
     1227       run diasize_change-width in this-procedure
     1228         (input  (p-new-width - frame Dialog-Frame :width)
     1229         ,input  p-move-resize
     1230         ) .
     1231     end.
     1232   end procedure.
     1233   procedure diasize_position-resize-button :
     1234     do with frame Dialog-Frame
     1235     :
     1236       hide v-diasize-resize-button .
     1237       assign
     1238         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1239                     - 1
     1240                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1241         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1242                     - 1
     1243                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1244       .
     1245       view v-diasize-resize-button .
     1246     end.
     1247   end procedure.
     1248   on alt-right anywhere
     1249   do:
     1250     run diasize_change-width in this-procedure
     1251       (input 1
     1252       ,input true
     1253       ) .
     1254     return no-apply .
     1255   end.
     1256   on alt-left anywhere
     1257   do:
     1258     run diasize_change-width in this-procedure
     1259       (input -1
     1260       ,input true
     1261       ) .
     1262     return no-apply .
     1263   end.
     1264   on alt-down anywhere
     1265   do:
     1266     run diasize_change-height in this-procedure
     1267       (input 1
     1268       ,input true
     1269       ) .
     1270     return no-apply .
     1271   end.
     1272   on alt-up anywhere
     1273   do:
     1274     run diasize_change-height in this-procedure
     1275       (input -1
     1276       ,input true
     1277       ) .
     1278     return no-apply .
     1279   end.
     1280   on alt-enter of frame Dialog-Frame
     1281   do:
     1282     run diasize_maximize in this-procedure
     1283       (input  ?
     1284       ).
     1285     return no-apply .
     1286   end.
     1287   procedure diasize_end-move :
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       define variable v-row-delta as decimal   no-undo .
     1292       define variable v-col-delta as decimal   no-undo .
     1293       define variable v-new-row as decimal   no-undo .
     1294       define variable v-new-col as decimal   no-undo .
     1295       assign
     1296         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1297         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1298       .
     1299       assign
     1300         v-row-delta = v-new-row - frame Dialog-Frame :height
     1301         v-col-delta = v-new-col - frame Dialog-Frame :width
     1302       .
     1303       run diasize_change-height in this-procedure
     1304         (input v-row-delta
     1305         ,input true
     1306         ) .
     1307       run diasize_change-width in this-procedure
     1308         (input v-col-delta
     1309         ,input true
     1310         ) .
     1311     end.
     1312   end procedure.
     1313   procedure diasize_maximize :
     1314     define input  parameter p-action as logical   no-undo .
     1315     do
     1316     on error undo, return error return-value
     1317     :
     1318       if p-action = ?
     1319       then do:
     1320         if v-diasize-need-maximize = true
     1321         then do:
     1322           assign
     1323             p-action = true
     1324           .
     1325         end.
     1326         else do:
     1327           assign
     1328             p-action = false
     1329           .
     1330         end.
     1331       end.
     1332       if p-action = true
     1333       then do:
     1334         run diasize_change-height in this-procedure
     1335           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1336               - frame Dialog-Frame :height-chars
     1337           ,input true
     1338           ) .
     1339         run diasize_change-width in this-procedure
     1340           (input session :width-chars
     1341               - frame Dialog-Frame :width-chars
     1342           ,input true
     1343           ) .
     1344         assign
     1345           v-diasize-need-maximize = false
     1346         .
     1347       end.
     1348       else do:
     1349         run diasize_change-width in this-procedure
     1350           (input v-diasize-orig-frame-width
     1351               - frame Dialog-Frame :width-chars
     1352           ,input true
     1353           ) .
     1354         run diasize_change-height in this-procedure
     1355           (input v-diasize-orig-frame-height
     1356               - frame Dialog-Frame :height-chars
     1357           ,input true
     1358           ) .
     1359         assign
     1360           v-diasize-need-maximize = true
     1361         .
     1362       end.
     1363     end.
     1364   end procedure.
     1365   procedure diasize_restore-orig-size :
     1366     do
     1367     on error undo, return error return-value
     1368     :
     1369       assign
     1370         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1371         v-diasize-current-frame-height = frame Dialog-Frame :height
     1372       .
     1373       run diasize_set-height in this-procedure
     1374         (input  v-diasize-orig-frame-height
     1375         ,input  true
     1376         ) .
     1377       run diasize_set-width in this-procedure
     1378         (input  v-diasize-orig-frame-width
     1379         ,input  true
     1380         ) .
     1381     end.
     1382   end procedure.
     1383   procedure diasize_restore-current-size :
     1384     do
     1385     on error undo, return error return-value
     1386     :
     1387       run diasize_set-height in this-procedure
     1388         (input  v-diasize-current-frame-height
     1389         ,input  true
     1390         ) .
     1391       run diasize_set-width in this-procedure
     1392         (input  v-diasize-current-frame-width
     1393         ,input  true
     1394         ) .
     1395     end.
     1396   end procedure.
     1397   procedure diasize_set-browse-handle :
     1398     define input  parameter p-browse-handle as handle   no-undo .
     1399     define buffer buf_temp-browse-handle for temp-browse-handle .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       assign
     1404         v-diasize-browse-handle = p-browse-handle
     1405       .
     1406       for each buf_temp-browse-handle
     1407       on error undo, return error return-value
     1408       :
     1409         delete buf_temp-browse-handle .
     1410       end.
     1411     end.
     1412   end procedure.
     1413   procedure diasize_add_browse :
     1414     define input  parameter p-browse-type   as character no-undo .
     1415     define input  parameter p-browse-handle as handle    no-undo .
     1416     define buffer buf_temp-browse-handle for temp-browse-handle .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       assign
     1421         v-diasize-browse-number = v-diasize-browse-number + 1
     1422       .
     1423       create buf_temp-browse-handle .
     1424       assign
     1425         buf_temp-browse-handle.browse-type   = p-browse-type
     1426         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1427         buf_temp-browse-handle.browse-handle = p-browse-handle
     1428       .
     1429     end.
     1430   end procedure.
     1431   procedure diasize_init :
     1432     define variable v-default-value    as logical   no-undo .
     1433     define variable v-restore-saved    as logical   no-undo .
     1434     define variable v-resize-value-str as character no-undo .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       do with frame Dialog-Frame
     1439       :
     1440         assign
     1441           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1442           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1443           v-diasize-browse-handle     = browse BROWSE-menu :handle
     1444         .
     1445         create button v-diasize-resize-button
     1446         assign
     1447           parent        = frame Dialog-Frame :first-child
     1448           label         = "s"
     1449           height-pixels = 16
     1450           width-pixels  = 16
     1451           visible       = true
     1452           sensitive     = true
     1453           movable       = true
     1454           triggers:
     1455             on end-move persistent run diasize_end-move in this-procedure .
     1456           end triggers.
     1457         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1458         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1459         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1460         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1461         assign
     1462           v-diasize-wndmax = false
     1463         .
     1464         if connected("ub") = true
     1465         then do:
     1466           define variable v-cntxt-db-num        as integer   no-undo .
     1467           define variable v-cntxt-userid        as character no-undo .
     1468           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1469                                             , OUTPUT v-cntxt-userid
     1470                                             ) .
     1471           run gbl/wndpar_r.p
     1472             (input  v-cntxt-db-num
     1473             ,input  v-cntxt-userid
     1474             ,input  'wndmax':U
     1475             ,output v-diasize-wndmax
     1476             ,output v-default-value
     1477             ) .
     1478         end.
     1479         assign
     1480           v-diasize-wndstore = false
     1481         .
     1482         if connected("ub") = true
     1483         then do:
     1484           run gbl/wndpar_r.p
     1485             (input  v-cntxt-db-num
     1486             ,input  v-cntxt-userid
     1487             ,input  'wndstore':U
     1488             ,output v-diasize-wndstore
     1489             ,output v-default-value
     1490             ) .
     1491         end.
     1492         assign
     1493           v-diasize-proc-name = entry(1, program-name(2), '.')
     1494         .
     1495         if v-diasize-wndstore = true
     1496         then do:
     1497           assign
     1498             v-restore-saved = false
     1499           .
     1500           if connected("ub") = true
     1501           then do:
     1502             run gbl/wndsizer.p
     1503               (input  v-cntxt-db-num
     1504               ,input  v-cntxt-userid
     1505               ,input  v-diasize-proc-name
     1506               ,input  'height':u
     1507               ,output v-resize-value-str
     1508               ) .
     1509             if v-resize-value-str <> '':U
     1510             then do:
     1511               run diasize_change-height in this-procedure
     1512                 (input  integer(v-resize-value-str)
     1513                 ,input  true
     1514                 ) .
     1515               assign
     1516                 v-restore-saved = true
     1517               .
     1518             end.
     1519           end.
     1520           if connected("ub") = true
     1521           then do:
     1522             run gbl/wndsizer.p
     1523               (input  v-cntxt-db-num
     1524               ,input  v-cntxt-userid
     1525               ,input  v-diasize-proc-name
     1526               ,input  'width':u
     1527               ,output v-resize-value-str
     1528               ) .
     1529             if v-resize-value-str <> '':U
     1530             then do:
     1531               run diasize_change-width in this-procedure
     1532                 (input  integer(v-resize-value-str)
     1533                 ,input  true
     1534                 ) .
     1535               assign
     1536                 v-restore-saved = true
     1537               .
     1538             end.
     1539           end.
     1540           if v-restore-saved <> true
     1541           then do:
     1542             if v-diasize-wndmax = true
     1543             then do:
     1544               run diasize_maximize in this-procedure
     1545                 (input  true
     1546                 ) .
     1547             end.
     1548           end.
     1549         end.
     1550         else do:
     1551           if v-diasize-wndmax = true
     1552           then do:
     1553             run diasize_maximize in this-procedure
     1554               (input  true
     1555               ) .
     1556           end.
     1557         end.
     1558       end.
     1559     end.
     1560   end procedure.
     1561   procedure diasize_need-full-display :
     1562     define output parameter p-need-full-display as logical   no-undo .
     1563     do
     1564     on error undo, return error return-value
     1565     :
     1566       assign
     1567         p-need-full-display = v-diasize-need-full-display
     1568       .
     1569       assign
     1570         v-diasize-need-full-display = false
     1571       .
     1572     end.
     1573   end procedure.
     1574   procedure get-context :
     1575      define output parameter p-db-num as integer          no-undo.
     1576      define output parameter p-user-id as character        no-undo.
     1577      define variable v-login               as character    no-undo.
     1578      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1579      define buffer buf_user-login  for ub.user-login .
     1580      do
     1581      on error undo, return error
     1582      :
     1583            FIND FIRST buf_sys-ctrl no-lock.
     1584            ASSIGN
     1585               v-login = USERID("ub")
     1586               p-db-num = buf_sys-ctrl.db-num
     1587            .
     1588            FIND FIRST buf_user-login
     1589                 WHERE buf_user-login.db-num = p-db-num
     1590                   AND buf_user-login.user-login = v-login
     1591                 no-lock
     1592                 no-error
     1593                 .
     1594            IF AVAILABLE buf_user-login
     1595            THEN DO:
     1596               assign
     1597                  p-user-id = buf_user-login.user-id
     1598               .
     1599            END.
     1600      end.
     1601   end procedure.
     1602       run diasize_init in this-procedure .
     1603   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1604     run mainmenu_getcntxt in parparentproc
     1605       (output v-cntxt-db-num
     1606       ,output v-cntxt-userid
     1607       ,output v-cntxt-level
     1608       ,output v-cntxt-host-code-obj
     1609       ,output v-cntxt-obj-type
     1610       ,output v-cntxt-obj-code
     1611       ,output v-cntxt-db-num-obj
     1612       ,output v-cntxt-is-admin
     1613       ) .
     1614   MAIN-BLOCK:
     1615   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1616      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1617          ASSIGN
     1618           FRAME Dialog-Frame:TITLE = SUBSTITUTE ( "Меню пользователя &1 для &2"
     1619                                                 , usrnickf( p-user-id )
     1620                                                 , IF p-obj-type = 'орг':U
     1621                                                   THEN Substitute("фирмы &1", p-obj-code)
     1622                                                   ELSE Substitute(" &1 &2", p-obj-type, p-obj-code)
     1623                                                 )
     1624        .
     1625      FIND FIRST buf_user-login
     1626           where buf_user-login.db-num  = p-db-num
     1627             and buf_user-login.user-id = p-user-id
     1628           no-lock
     1629           no-error
     1630           .
     1631      if not available buf_user-login then do:
     1632         message "У пользователя не задан логин."
     1633            skip "Выбор меню невозможен."
     1634         view-as alert-box information.
     1635         return error "У пользователя не задан логин.".
     1636      end.
     1637      ASSIGN
     1638         fi-db         = p-db-num
     1639      .
     1640      RUN fill-wp IN THIS-PROCEDURE.
     1641      RUN enable_UI.
     1642      RUN post_enable_UI.
     1643      IF NOT CAN-FIND (FIRST buf_tt-work-place NO-LOCK) THEN DO:
     1644         return .
     1645      END.
     1646      WAIT-FOR GO OF FRAME Dialog-Frame.
     1647   END.
     1648   RUN disable_UI.
     1649   PROCEDURE change-menu :
     1650   define buffer buf_user-menu-group         for user-menu-group.
     1651   define buffer buf_menu-group              for menu-group.
     1652   define buffer buf_tt-work-place           for tt-work-place.
     1653   define buffer buf_tt-menu-group    for tt-menu-group.
     1654   define variable v-menu-group-code    as integer      no-undo.
     1655   define variable v-ok                 as logical      no-undo.
     1656   define variable v-accepted    as logical      no-undo.
     1657   define variable v-changed    as logical      no-undo.
     1658   define variable v-user-menu-group-code    as integer      no-undo.
     1659   define variable v-menu-group-available    as logical      no-undo.
     1660   define variable v-obj-type    as character    no-undo.
     1661   define variable v-obj-code    as integer      no-undo.
     1662   define variable v-context     as character    no-undo.
     1663   do for buf_user-menu-group
     1664      on error undo, return no-apply
     1665      :
     1666      find first buf_tt-work-place
     1667           where buf_tt-work-place.selected = TRUE
     1668         no-error
     1669         .
     1670      if available buf_tt-work-place then do:
     1671         define variable v-list-host   as character    no-undo.
     1672         define variable v-ccc         as integer      no-undo.
     1673         assign
     1674            v-ccc = 0
     1675         .
     1676         FOR EACH buf_tt-work-place
     1677               where buf_tt-work-place.selected = TRUE
     1678         :
     1679            assign
     1680               v-list-host = SUBSTITUTE("&1&2&3&4 &5"
     1681                                          , v-list-host
     1682                                          , (if v-list-host = "":U then "":U else chr(10))
     1683                                          , buf_tt-work-place.wp-code
     1684                                          , buf_tt-work-place.wp-type
     1685                                          , buf_tt-work-place.wp-name
     1686                                          )
     1687               v-ccc = v-ccc + 1
     1688            .
     1689            IF v-ccc = 1 THEN DO:
     1690               assign
     1691                  v-obj-type = buf_tt-work-place.wp-type
     1692                  v-obj-code = buf_tt-work-place.wp-code
     1693                  v-context  = buf_tt-work-place.context
     1694               .
     1695            end.
     1696            IF buf_tt-work-place.context = 'object':U THEN DO:
     1697               assign
     1698                  v-obj-type = buf_tt-work-place.wp-type
     1699                  v-obj-code = buf_tt-work-place.wp-code
     1700                  v-context  = buf_tt-work-place.context
     1701               .
     1702            END.
     1703         END.
     1704      end.
     1705      else do:
     1706         assign
     1707            v-obj-type = br_tt-work-place.wp-type
     1708            v-obj-code = br_tt-work-place.wp-code
     1709            v-context  = br_tt-work-place.context
     1710         .
     1711      end.
     1712      run twowin_clear in this-procedure.
     1713      FOR EACH  buf_menu-group
     1714          NO-LOCK
     1715          on error undo, return error
     1716          :
     1717            assign
     1718               v-ok  = FALSE
     1719            .
     1720   define variable vss-include-info9 as character format "X(65)" no-undo
     1721   initial "@(#)$Workfile$ $Revision$".
     1722   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkmngr in g#library2
     1723     (input  buf_menu-group.menu-group-id
     1724     ,input  v-context
     1725     ,input  v-obj-type
     1726     ,input  v-obj-code
     1727     ,input  p-db-num
     1728     ,output v-ok
     1729     ) no-error .
     1730            IF NOT v-ok THEN DO:
     1731               NEXT.
     1732            end.
     1733            FIND FIRST buf_tt-menu-group
     1734            where buf_tt-menu-group.menu-group-code    = buf_menu-group.menu-group-code
     1735            no-lock
     1736            no-error
     1737            .
     1738            run twowin_add-item in this-procedure
     1739               ( input string( buf_menu-group.menu-group-code  )
     1740               , input buf_menu-group.menu-group-name
     1741               , input buf_menu-group.menu-group-description
