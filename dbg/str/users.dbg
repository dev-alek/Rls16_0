     3634           and v-cntxt-db-num = 0
     3635           then do:
     3636               assign
     3637                   cb-db = v-users-last-cb-db
     3638               .
     3639               display
     3640                   cb-db
     3641               with frame Dialog-Frame .
     3642           end.
