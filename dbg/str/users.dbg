     2793       define variable v-mobile-phone-number       as character    no-undo.
     2794       define variable v-company                   as character    no-undo.
     2795       define variable v-department                as character    no-undo.
     2796       define variable v-position                  as character    no-undo.
     2797       define variable v-room                      as character    no-undo.
     2798       define variable v-e-mail                    as character    no-undo.
     2799       define variable v-internal-phone-number     as character    no-undo.
     2800       define variable v-PS                        as character    no-undo.
     2801       define variable v-adm-Ubd                   as logical      no-undo init ?.
     2802       define variable v-adm-gbd                   as logical      no-undo init ?.
     2803       define variable v-superAdm                  as logical      no-undo.
     2804       define variable v-TabUserAdm                as handle       no-undo.
     2805       define variable v-accepted                  as logical      no-undo.
