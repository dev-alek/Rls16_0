     3676   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3677     run mainmenu_getcntxt in parparentproc
     3678       (output v-cntxt-db-num
     3679       ,output v-cntxt-userid
     3680       ,output v-cntxt-level
     3681       ,output v-cntxt-host-code-obj
     3682       ,output v-cntxt-obj-type
     3683       ,output v-cntxt-obj-code
     3684       ,output v-cntxt-db-num-obj
     3685       ,output v-cntxt-is-admin
     3686       ) .
     3687   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3688   do:
     3689     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3690       (input  v-cntxt-db-num
     3691       ,input  v-cntxt-userid
     3692       ,input  0
     3693       ,input  'actn_users-lookup':U
     3694       ,input  'global':U
     3695       ,input  0
     3696       ,input  '':U
     3697       ,input  0
     3698       ,input  0
     3699       ,input  0
     3700       ,input  0
     3701       ,input  false
     3702       ,output v-ok
     3703       )  .
     3704   end.
     3705       IF NOT v-ok then do:
     3706          message
     3707            "У вас нет прав на просмотр информации о пользователях"
     3708          view-as alert-box information.
     3709          return.
     3710       end.
     3711   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3712   on help of frame Dialog-Frame
     3713   do:
     3714     run gbl/app_help.p
     3715       (input this-procedure :file-name
     3716       ,input ''
     3717       ,input ?
     3718       ) no-error.
     3719     if error-status :error then do:
     3720       message
     3721         "Ошибка при вызове помощи"
     3722         error-status :get-message(1)
     3723         view-as alert-box .
     3724     end.
     3725   end.
     3726   run minbtn-set in this-procedure .
     3727   on choose of b-help in frame Dialog-Frame
     3728   do:
     3729     apply "help":u to frame Dialog-Frame .
     3730   end.
     3731   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3732   procedure minbtn-set :
     3733       do
     3734           on error undo, return error return-value
     3735           :
     3736           define variable ii              as integer       no-undo .
     3737           define variable fh              as widget-handle no-undo .
     3738           define variable hh              as widget-handle no-undo .
     3739           define variable v-h             as handle        extent 4 no-undo .
     3740           define variable v-name-button   as character     no-undo .
     3741           define variable v-help-old-x    as decimal       no-undo .
     3742           define variable v-help-old-y    as decimal       no-undo .
     3743           define variable v-help-old-size as decimal       no-undo .
     3744           define variable v-frame-width   as decimal       no-undo .
     3745           define variable jj              as integer       no-undo .
     3746           do
     3747               on error undo, return error
     3748               :
     3749               assign
     3750                   v-frame-width = frame Dialog-Frame:width - 0.3
     3751                   fh            = frame Dialog-Frame:first-child
     3752                   hh            = fh:first-child
     3753                   ii            = 1
     3754                   .
     3755               do while valid-handle(hh):
     3756                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3757                   do:
     3758                       case lc(hh:name) :
     3759                           when "b-help" then
     3760                               do:
     3761                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3762                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3763                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3764                                   hh:TOOLTIP = "Помощь" .
     3765                                   v-help-old-x = hh:column .
     3766                                   v-help-old-y = hh:row    .
     3767                                   v-help-old-size = hh:width .
     3768                                   hh:width-chars = 2.5 .
     3769                               end.
     3770                           when "b-print" then
     3771                               do:
     3772                                   hh:load-image("cmp/b-print.bmp":u) .
     3773                                   hh:TOOLTIP = "Печать" .
     3774                                   v-h[ii] = hh:handle .
     3775                                   ii = ii + 1 .
     3776                                   hh:width-chars = 3 .
     3777                               end.
     3778                           when "b-history" or
     3779                           when "b-hist" then
     3780                               do:
     3781                                   hh:load-image("cmp/b-hist.bmp":u) .
     3782                                   hh:TOOLTIP = "История" .
     3783                                   v-h[ii] = hh:handle .
     3784                                   ii = ii + 1 .
     3785                                   hh:width-chars = 3 .
     3786                               end.
     3787                           when "b-sch" then
     3788                               do:
     3789                                   hh:load-image("cmp/b-sch.bmp":u) .
     3790                                   hh:TOOLTIP = "Установка Фильтра" .
     3791                                   v-h[ii] = hh:handle .
     3792                                   ii = ii + 1 .
     3793                                   hh:width-chars = 3 .
     3794                               end.
     3795                           when "b-hist-user" then
     3796                               do:
     3797                                   hh:load-image("cmp/b-hist.bmp":u) .
     3798                                   hh:TOOLTIP = "История пользователя" .
     3799                                   ii = ii + 1 .
     3800                               end.
     3801                       end case.
     3802                   end.
     3803                   hh = hh:next-sibling.
     3804               end.
     3805               b-help:column = v-frame-width - b-help:width-chars.
     3806               jj = 0.
     3807               repeat ii = 4 to 1 by -1 :
     3808                   if valid-handle (v-h[ii] ) then
     3809                   do:
     3810                       jj  = jj + 1 .
     3811                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3812                       v-h[ii]:row    = v-help-old-y .
     3813                   end.
     3814               end.
     3815           end.
     3816       end.
     3817   end procedure.
     3818   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3819   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3820   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3821   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3822   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3823   define variable v-diasize-current-frame-height as decimal   no-undo .
     3824   define variable v-diasize-change-size          as logical   no-undo .
