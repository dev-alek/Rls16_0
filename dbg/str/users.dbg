     1089   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   procedure cur-time :
     1091      define output parameter p-today as date      no-undo .
     1092      define output parameter p-time  as integer   no-undo .
     1093     do
     1094     on error undo, return error
     1095     :
     1096       define variable v-date1 as date      no-undo .
     1097       define variable v-date2 as date      no-undo .
     1098       define variable v-time  as integer   no-undo .
     1099       assign
     1100         v-date1 = today
     1101         v-time  = time
     1102         v-date2 = today
     1103       .
     1104       if v-date1 <> v-date2
     1105       then do:
     1106         assign
     1107           v-date1 = today
     1108           v-time  = v-time
     1109         .
     1110       end.
     1111       assign
     1112         p-today = v-date1
     1113         p-time  = v-time
     1114       .
     1115     end.
     1116   end.
     1117   function cur-time-date returns character
     1118   :
     1119     return string(today, '99/99/9999':U) .
     1120   end.
     1121   function cur-time-mjd returns decimal
     1122   :
     1123     define variable v-date as date      no-undo .
     1124     define variable v-time as integer   no-undo .
     1125     run cur-time in this-procedure
     1126       (output v-date
     1127       ,output v-time
     1128       ) .
     1129     return integer(v-date) - 2400002 + (v-time / 86400) .
     1130   end.
     1131   function cur-time-get-ending-index returns integer
     1132   (input p-number as integer
     1133   )
     1134   :
     1135     if p-number < 0
     1136     or p-number = ?
     1137     then do:
     1138       return 1 .
     1139     end.
     1140     define variable v-rest as integer   no-undo .
     1141     assign
     1142       p-number = p-number modulo 100
     1143     .
     1144     if p-number < 20
     1145     then do:
     1146       assign
     1147         v-rest = p-number
     1148       .
     1149     end.
     1150     else do:
     1151       assign
     1152         v-rest = p-number modulo 10
     1153       .
     1154     end.
     1155     case v-rest :
     1156       when 1
     1157       then do:
     1158         return 2 .
     1159       end.
     1160       when 2 or
     1161       when 3 or
     1162       when 4
     1163       then do:
     1164         return 3 .
     1165       end.
     1166       otherwise do:
     1167         return 1 .
     1168       end.
     1169     end case .
     1170   end.
     1171   procedure cur-time-mjd-to-date :
     1172      define input  parameter i-mjd-diff as decimal no-undo.
     1173      define output parameter o-Date     as date    no-undo.
     1174      define output parameter o-Time     as integer no-undo.
     1175      define variable v-day-number as integer   no-undo .
     1176      if    i-mjd-diff < 0
     1177         or i-mjd-diff = ?
     1178      then do:
     1179         return "?" .
     1180      end.
     1181      assign
     1182         v-day-number = truncate(i-mjd-diff,0).
     1183         o-Date = date(v-day-number + 2400002).
     1184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1185     .
     1186   end.
     1187   function cur-time-mjd-to-string returns character
     1188   (input p-mjd-diff as decimal
     1189   )
     1190   :
     1191     define variable v-day-number as integer   no-undo .
     1192     define variable v-seconds    as integer   no-undo .
     1193     define variable v-hour       as integer   no-undo .
     1194     define variable v-min        as integer   no-undo .
     1195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1199     if p-mjd-diff < 0
     1200     or p-mjd-diff = ?
     1201     then do:
     1202       return "?" .
     1203     end.
     1204     assign
     1205       v-day-number = integer(truncate(p-mjd-diff,0))
     1206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1207     .
     1208     if v-seconds > 86400
     1209     then do:
     1210       assign
     1211         v-seconds = 86400 - 1
     1212       .
     1213     end.
     1214     if v-seconds < 0
     1215     then do:
     1216       assign
     1217         v-seconds = 0
     1218       .
     1219     end.
     1220     assign
     1221       v-hour = truncate(v-seconds / 3600, 0)
     1222     .
     1223     assign
     1224       v-seconds = v-seconds modulo 3600
     1225     .
     1226     assign
     1227       v-min = truncate(v-seconds / 60, 0)
     1228     .
     1229     assign
     1230       v-seconds = v-seconds modulo 60
     1231     .
     1232     return
     1233         (if v-day-number <> 0
     1234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1235           else ""
     1236         )
     1237       + (if v-day-number <> 0 or v-hour <> 0
     1238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1239           else ""
     1240         )
     1241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1243           else ""
     1244         )
     1245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1246       .
     1247   end.
     1248   function cur-time-string returns character
     1249   :
     1250     define variable v-date as date      no-undo .
     1251     define variable v-time as integer   no-undo .
     1252     run cur-time in this-procedure
     1253       (output v-date
     1254       ,output v-time
     1255       ) .
     1256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1257   end.
     1258   function cur-time-string-sec returns character
     1259   :
     1260     define variable v-date as date      no-undo .
     1261     define variable v-time as integer   no-undo .
     1262     run cur-time in this-procedure
     1263       (output v-date
     1264       ,output v-time
     1265       ) .
     1266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1267   end.
     1268   function cur-time-custom  returns character
     1269   (input p-prefix as character
     1270   ,input p-date-format as character
     1271   ,input p-delimiter as character
     1272   ,input p-time-format as character
     1273   ,input p-suffix as character
     1274   )
     1275   :
     1276     define variable v-date as date      no-undo .
     1277     define variable v-time as integer   no-undo .
     1278     run cur-time in this-procedure
     1279       (output v-date
     1280       ,output v-time
     1281       ) .
     1282     return
     1283       p-prefix
     1284       + string(v-date, p-date-format)
     1285       + p-delimiter
     1286       + string(v-time, p-time-format)
     1287       + p-suffix
     1288       .
     1289   end.
     1290   function cur-time-print  returns character
     1291   :
     1292     define variable v-date as date      no-undo .
     1293     define variable v-time as integer   no-undo .
     1294     run cur-time in this-procedure
     1295       (output v-date
     1296       ,output v-time
     1297       ) .
     1298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1299   end.
     1300   function cur-time-datetime returns datetime
     1301   :
     1302     define variable v-char as character no-undo .
     1303     define variable v-datetime as datetime no-undo .
     1304     v-char = cur-time-string().
     1305     v-datetime = datetime(v-char).
     1306     return  v-datetime.
     1307   end.
     1308   function cur-time-string-msec returns character
     1309   :
     1310     define variable v-date as datetime  no-undo .
     1311     v-date = now.
     1312     return string(v-date) .
     1313   end.
     1314   function get-user-login returns character
     1315     ( p-user-id as character ) :
     1316     define variable v-user-login as character no-undo .
     1317     run procedure-get-user-login in this-procedure (
     1318         input p-user-id
     1319       , output v-user-login
     1320     ) .
     1321     return v-user-login .
     1322   end function.
     1323   procedure procedure-get-user-login :
     1324   define input  parameter p-user-id    as character no-undo .
     1325   define output parameter p-user-login as character no-undo .
     1326       define buffer buf_user-login for ub.user-login .
     1327   do
     1328   for buf_user-login
     1329   on error undo, return error return-value
     1330   :
     1331       assign
     1332           p-user-login = "":U
     1333       .
     1334       for each buf_user-login no-lock
     1335          where buf_user-login.user-id = p-user-id
     1336       by buf_user-login.db-num
     1337       :
     1338           assign
     1339               p-user-login = substitute( "&1&2&3"
     1340                                   , p-user-login
     1341                                   , ( if p-user-login = "":U then "":U else ",":U )
     1342                                   , buf_user-login.db-num )
     1343           .
     1344       end.
     1345   end.
     1346   end procedure.
     1347   function get-work-status returns character
     1348     ( p-user-id as character ) :
     1349       define variable v-work-status as character no-undo .
     1350       run procedure-get-work-status in this-procedure (
     1351           input p-user-id
     1352         , output v-work-status
     1353       ) .
     1354       return v-work-status .
     1355   end function.
     1356   procedure procedure-get-work-status :
     1357   define input  parameter p-user-id     as character no-undo .
     1358   define output parameter p-work-status as character no-undo .
     1359       define buffer buf_user-login for ub.user-login .
     1360   do
     1361   for buf_user-login
     1362   on error undo, return error return-value
     1363   :
     1364       if p-user-id = v-cntxt-userid
     1365       then do:
     1366           assign
     1367               p-work-status = "*":U
     1368           .
     1369       end.
     1370       else do:
     1371           find first buf_user-login exclusive-lock
     1372                where buf_user-login.db-num    = v-cntxt-db-num
     1373                  and buf_user-login.user-id   = p-user-id
     1374           no-error no-wait .
     1375           if not available buf_user-login
     1376           then do:
     1377               if locked buf_user-login
     1378               then do:
     1379               assign
     1380                   p-work-status = "+":U
     1381               .
     1382               end.
     1383               else do:
     1384               assign
     1385                   p-work-status = "":U
     1386               .
     1387               end.
     1388           end.
     1389           else do:
     1390               assign
     1391                   p-work-status = "":U
     1392               .
     1393           end.
     1394       end.
     1395   end.
     1396   end procedure.
     1397   procedure SetAttrUserId:
     1398      define input  parameter iDb-num      as integer   no-undo.
     1399      define input  parameter iUserId      as character no-undo.
     1400      define input  parameter iAttrCode    as character no-undo.
     1401      define input  parameter iAttrValue   as character no-undo.
     1402      define buffer user-login-attr  for ub.user-login-attr .
     1403      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1404                                   and user-login-attr.user-id   eq iuserid
     1405                                   and user-login-attr.attr-code eq iAttrCode
     1406      exclusive-lock no-error.
     1407      if     not available user-login-attr
     1408         and iAttrValue ne ?
     1409      then do:
     1410         create user-login-attr.
     1411         assign
     1412            user-login-attr.db-num     = idb-num
     1413            user-login-attr.user-id    = iuserid
     1414            user-login-attr.attr-code  = iAttrCode
     1415         .
     1416      end.
     1417      if iAttrValue eq ?
     1418      then do:
     1419         if available ub.user-login-attr
     1420         then
     1421            delete ub.user-login-attr.
     1422      end.
     1423      else
     1424         user-login-attr.attr-value = iAttrValue.
     1425   end procedure.
     1426   function GetAttrUserId returns character (
     1427      input iDb-num      as integer  ,
     1428      input iUserId      as character,
     1429      input iAttrCode    as character):
     1430      define buffer user-login-attr  for ub.user-login-attr .
     1431      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1432                                   and user-login-attr.user-id   eq iuserid
     1433                                   and user-login-attr.attr-code eq iAttrCode
     1434      no-lock no-error.
     1435      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
     1436   end function.
     1437   procedure getAccountSetting :
     1438      define input  parameter i-user-id  as character no-undo.
     1439      define output parameter o-adm-Ubd  as logical no-undo init ?.
     1440      define output parameter v-adm-GBD  as logical no-undo.
     1441      define output parameter o-superAdm as logical no-undo.
     1442      define input-output parameter table for UserDbAdm .
     1443      define variable v-adm-Ubd-int as integer no-undo.
     1444      define buffer user-login for ub.user-login.
     1445      define buffer db         for ub.db.
     1446      define buffer user-account-attr for ub.user-account-attr.
     1447      find first user-login where user-login.db-num  eq 0
     1448                              and user-login.user-id eq i-user-id
     1449      no-lock no-error.
     1450      if available user-login
     1451      then
     1452         v-adm-gbd = user-login.user-administrator.
     1453      else
     1454         v-adm-gbd = ?.
     1455      for each userDbAdm:
     1456         delete userDbAdm.
     1457      end.
     1458      block-db:
     1459      for each db where db.db-num ne 0 no-lock:
     1460         if G#db-num ne 0
     1461            and G#db-num ne db.db-num
     1462         then
     1463            next block-db.
     1464         create UserDbAdm.
     1465         UserDbAdm.db-num = ub.db.db-num.
     1466         find first user-login where user-login.db-num  eq db.db-num
     1467                                 and user-login.user-id eq i-user-id
     1468         no-lock no-error.
     1469         if not available user-login
     1470         then
     1471            v-adm-Ubd-int = 2.
     1472         else if user-login.status_ eq 1
     1473         then do:
     1474            v-adm-Ubd-int = 2.
     1475             UserDbAdm.db-block = yes.
     1476             UserDbAdm.db-usr   = yes.
     1477         end.
     1478         else if user-login.user-administrator
     1479         then do:
     1480            UserDbAdm.db-adm = yes.
     1481            UserDbAdm.db-usr = yes.
     1482            if v-adm-Ubd-int eq 0
     1483            then
     1484               v-adm-Ubd-int = 1.
     1485            else if v-adm-Ubd-int eq 3
     1486            then do:
     1487               v-adm-Ubd-int = 2.
     1488            end.
     1489         end.
     1490         else do:
     1491            if available ub.user-login
     1492            then
     1493               UserDbAdm.db-usr = yes.
     1494            if v-adm-Ubd-int eq 0
     1495            then
     1496               v-adm-Ubd-int = 3.
     1497            else if v-adm-Ubd-int eq 1
     1498            then do:
     1499               v-adm-Ubd-int = 2.
     1500            end.
     1501         end.
     1502      end.
     1503      if  v-adm-Ubd-int eq 1
     1504      then
     1505         o-adm-Ubd = true.
     1506      else if v-adm-Ubd-int eq 3
     1507      then
     1508         o-adm-Ubd = false.
     1509      find first user-account-attr where user-account-attr.user-id  eq i-user-id
     1510                                     and user-account-attr.attr-code  eq "superADm"
     1511      no-lock no-error.
     1512      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
     1513   end.
     1514   function check_alphanumeric returns character (
     1515   input ipwd as character ,
     1516   input itype as character ):
     1517      define variable vCharEng as character no-undo
     1518      init "abcdefghijklmnopqrstuvwxyz".
     1519      define variable vCharRus as character no-undo
     1520      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
     1521      define variable vi as integer no-undo.
     1522      define variable vdigitFl as logical no-undo.
     1523      define variable vCharEngFl as logical no-undo.
     1524      define variable vCharRusFl as logical no-undo.
     1525      define variable vCharSpeFl as logical no-undo.
     1526      define variable vTextNew as character no-undo.
     1527      define variable vTextOld as character no-undo.
     1528      vTextNew = ipwd.
     1529      vTextOld = vTextNew.
     1530      do vi = 0 to 9:
     1531         vTextNew = replace(vTextNew,string (vi),"").
     1532      end.
     1533      if length(vTextOld) ne length(vTextNew)
     1534      then
     1535         vdigitFL = yes.
     1536      vTextOld = vTextNew.
     1537      do vi = 1 to length(vCharEng):
     1538         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
     1539      end.
     1540      if length(vTextOld) ne length(vTextNew)
     1541      then
     1542         vCharEngFl = yes.
     1543      vTextOld = vTextNew.
     1544      do vi = 1 to length(vCharRus):
     1545         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
     1546      end.
     1547      if length(vTextOld) ne length(vTextNew)
     1548      then
     1549         vCharEngFl = yes.
     1550      if length(vTextNew) > 0
     1551      then
     1552         vCharSpeFl = yes.
     1553      define variable vReturn as character no-undo.
     1554      assign
     1555         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
     1556         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
     1557         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
     1558         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
     1559         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
     1560      .
     1561      vReturn = substring (vReturn,3) no-error.
     1562      return vReturn.
     1563   end.
     1564   procedure SaveLastPWD:
     1565      define input  parameter iDb-num as integer   no-undo.
     1566      define input  parameter iUserId as character no-undo.
     1567      define input  parameter IPWD    as character no-undo.
     1568      define buffer user-login-attr  for ub.user-login-attr .
     1569      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1570                                   and user-login-attr.user-id   eq iuserid
     1571                                   and user-login-attr.attr-code eq "LastPWD"
     1572      exclusive-lock no-error.
     1573      if not available user-login-attr
     1574      then do:
     1575         create user-login-attr.
     1576         assign
     1577            user-login-attr.db-num     = idb-num
     1578            user-login-attr.user-id    = iuserid
     1579            user-login-attr.attr-code  = "LastPWD"
     1580            user-login-attr.attr-value = ipwd
     1581         .
     1582      end.
     1583      else do:
     1584         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1585         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1586         then
     1587            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1588      end.
     1589   end procedure.
     1590   function  CheckLastPWD returns character  (
     1591      input  iDb-num    as integer  ,
     1592      input  iUserId    as character,
     1593      input  IPWD       as character,
     1594      input  Iadm       as logical ) :
     1595      define buffer user-login       for ub.user-login .
     1596      define buffer user-login-attr  for ub.user-login-attr .
     1597      define variable vError as character  no-undo.
     1598      define variable v-obyznumbukv as logical no-undo .
     1599      define variable v-minparol as integer no-undo .
     1600      define variable v-tth as handle no-undo .
     1601      define variable VadmSuff as character no-undo.
     1602      define variable v-param-type as character no-undo .
     1603      define variable v-value-character as character no-undo .
     1604      define variable v-value-date as date no-undo .
     1605      define variable v-value-decimal as decimal no-undo .
     1606      define variable v-value-integer as integer no-undo .
     1607      define variable v-value-logical as logical no-undo .
     1608      find first user-login where user-login.db-num    eq idb-num
     1609                              and user-login.user-id   eq iUserId
     1610      no-lock no-error.
     1611      if Iadm
     1612      then
     1613         VadmSuff = 'Adm':U.
     1614      run adm/shattri.p (
     1615           input "get":U
     1616           ,input  '':U
     1617           ,input  0
     1618           ,input  'staff':U
     1619           ,input  'minparol':U + VadmSuff
     1620           ,output v-value-character
     1621           ,output v-value-date
     1622           ,output v-value-decimal
     1623           ,output v-minparol
     1624           ,output v-value-logical
     1625           ,output v-param-type
     1626           ,input-output table-handle v-tth
     1627           )  .
     1628       if v-minparol <> 0  then do:
     1629          if length(ipwd) < v-minparol
     1630           then do:
     1631              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1632           end.
     1633       end.
     1634       run adm/shattri.p (
     1635           input "get":U
     1636           ,input  '':U
     1637           ,input  0
     1638           ,input  'staff':U
     1639           ,input  'obyznumbukv':U + VadmSuff
     1640           ,output v-value-character
     1641           ,output v-value-date
     1642           ,output v-value-decimal
     1643           ,output v-value-integer
     1644           ,output v-obyznumbukv
     1645           ,output v-param-type
     1646           ,input-output table-handle v-tth
     1647           )  .
     1648      if v-obyznumbukv = true
     1649      then do:
     1650         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1651         then do:
     1652            vError = vError + (if vError eq "" then "" else ", " )
     1653                   + "В пароле должны содержаться буквы и цифры".
     1654         end.
     1655      end.
     1656      define variable v-encode-value as character no-undo.
     1657      define variable v-Lastpaswd    as integer no-undo.
     1658      run adm/pswd-enc.p
     1659         (input  encode(ipwd)
     1660         ,output v-encode-value
     1661         ).
     1662      v-encode-value = encode(v-encode-value).
     1663      run adm/shattri.p (
     1664           input "get":U
     1665           ,input  '':U
     1666           ,input  0
     1667           ,input  'staff':U
     1668           ,input  'LastPaswd':U + VadmSuff
     1669           ,output v-value-character
     1670           ,output v-value-date
     1671           ,output v-value-decimal
     1672           ,output v-Lastpaswd
     1673           ,output v-value-logical
     1674           ,output v-param-type
     1675           ,input-output table-handle v-tth
     1676           )  .
     1677      if v-Lastpaswd ne 0
     1678      then do:
     1679         define variable vLastPwd as character no-undo.
     1680         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1681         if vLastPwd ne ?
     1682         then do:
     1683            define variable Vi as integer no-undo.
     1684            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1685            if     vi ne 0
     1686               and vi le v-Lastpaswd
     1687            then
     1688               vError = vError + (if vError eq "" then "" else ", " )
     1689                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1690         end.
     1691      end.
     1692      delete object v-tth.
     1693      return vError.
     1694   end function.
     1695   procedure availOneAdm:
     1696      define input-output parameter table for UserDbAdm.
     1697      define output parameter oAdm as logical no-undo.
     1698      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1699      oadm = available UserDbAdm.
     1700   end.
     1701   procedure update-user-login:
     1702      define input  parameter i-db-num     as integer          no-undo.
     1703      define input  parameter i-user-id    as character        no-undo.
     1704      define input  parameter i-user-login as character no-undo.
     1705      define input  parameter i-max-discnt as decimal no-undo.
     1706      define input  parameter i-quest-print as logical no-undo.
     1707      define input  parameter i-encoded-pass as character no-undo.
     1708      define input  parameter i-nextcon as logical no-undo.
     1709      define input  parameter i-user-administrator as logical no-undo.
     1710      define input  parameter i-Manual     as logical no-undo.
     1711      define input  parameter i-adm-gbd as logical no-undo.
     1712      define input  parameter i-adm-ubd as logical no-undo.
     1713      define input-output parameter table for UserDbAdm.
     1714      define buffer buf_user-login        for user-login.
     1715      do
     1716   for buf_user-login
     1717   on error undo, return error
     1718   :
     1719           if     i-Manual
     1720              and G#db-num eq 0
     1721           then do:
     1722              if     i-adm-gbd ne ?
     1723              then do:
     1724                 do transaction
     1725                 on error undo, return error return-value
     1726                 :
     1727                     find first buf_user-login where buf_user-login.db-num             eq 0
     1728                                                 and buf_user-login.user-login         eq i-user-login
     1729                                                 and buf_user-login.status_            eq 0
     1730                                                 and buf_user-login.user-id            ne i-user-id
     1731                     no-lock no-error.
     1732                     if available buf_user-login
     1733                     then
     1734                        undo, return error "Уже есть такой логин в ГБД".
     1735                     find first buf_user-login where buf_user-login.db-num             = 0
     1736                                                 and buf_user-login.user-id            = i-user-id
     1737                     exclusive-lock no-error.
     1738                     if not available buf_user-login
     1739                     then do:
     1740                        create buf_user-login .
     1741                        assign
     1742                            buf_user-login.db-num             = 0
     1743                            buf_user-login.user-id            = i-user-id
     1744                            buf_user-login.status_            = 0
     1745                        .
     1746                     end.
     1747                     assign
     1748                         buf_user-login.user-login         = i-user-login
     1749                         buf_user-login.user-administrator = i-adm-gbd
     1750                         buf_user-login.max-discnt         = i-max-discnt
     1751                         buf_user-login.quest-print        = i-quest-print
     1752                         buf_user-login.user-password-encoded = i-encoded-pass
     1753                     .
     1754                     if i-nextcon ne ?
     1755                     then do:
     1756                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1757                     end.
     1758                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1759                     if error-status:error
     1760                     then
     1761                        return error return-value.
     1762                 end.
     1763              end.
     1764              else do transaction on error undo, return error return-value:
     1765                  find first buf_user-login where buf_user-login.db-num             = 0
     1766                                              and buf_user-login.user-id            = i-user-id
     1767                  exclusive-lock no-error.
     1768                  if available buf_user-login
     1769                  then
     1770                     delete buf_user-login.
     1771              end.
     1772              if     i-adm-ubd ne ?
     1773              then do:
     1774                 do transaction
     1775                 on error undo, return error return-value
     1776                 :
     1777                     define variable vDbError as character no-undo.
     1778                     block-db:
     1779                     for each db where db.db-num ne 0
     1780                     no-lock:
     1781                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1782                                                    and buf_user-login.user-login         eq i-user-login
     1783                                                    and buf_user-login.status_            eq 0
     1784                                                    and buf_user-login.user-id            ne i-user-id
     1785                        no-lock no-error.
     1786                        if available buf_user-login
     1787                        then do:
     1788                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1789                           next block-db.
     1790                        end.
     1791                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1792                                                    and buf_user-login.user-id            = i-user-id
     1793                        exclusive-lock no-error.
     1794                        if not available buf_user-login
     1795                        then do:
     1796                           create buf_user-login .
     1797                           assign
     1798                               buf_user-login.db-num             = db.db-num
     1799                               buf_user-login.user-id            = i-user-id
     1800                               buf_user-login.status_            = 0
     1801                               buf_user-login.user-password-encoded = i-encoded-pass
     1802                           .
     1803                        end.
     1804                        assign
     1805                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1806                            buf_user-login.user-login         = i-user-login
     1807                            buf_user-login.user-administrator = i-adm-ubd
     1808                            buf_user-login.max-discnt         = i-max-discnt
     1809                            buf_user-login.quest-print        = i-quest-print
     1810                        .
     1811                        if i-nextcon ne ?
     1812                        then do:
     1813                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1814                        end.
     1815                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1816                        if error-status:error
     1817                        then
     1818                           return error return-value.
     1819                    end.
     1820                    if vDbError ne ""
     1821                    then
     1822                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1823                 end.
     1824              end.
     1825              else do:
     1826                 do transaction
     1827                 on error undo, return error return-value
     1828                 :
     1829                     block-UserDb:
     1830                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1831                     no-lock:
     1832                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1833                                                    and buf_user-login.user-login         eq i-user-login
     1834                                                    and buf_user-login.status_            eq 0
     1835                                                    and buf_user-login.user-id            ne i-user-id
     1836                        no-lock no-error.
     1837                        if available buf_user-login and UserDbAdm.db-usr
     1838                        then do:
     1839                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1840                           next block-UserDb.
     1841                        end.
     1842                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1843                                                    and buf_user-login.user-id            = i-user-id
     1844                        exclusive-lock no-error.
     1845                        if UserDbAdm.db-usr
     1846                        then do:
     1847                           if not available buf_user-login
     1848                           then do:
     1849                              create buf_user-login .
     1850                              assign
     1851                                  buf_user-login.db-num             = UserDbAdm.db-num
     1852                                  buf_user-login.user-id            = i-user-id
     1853                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1854                                  buf_user-login.user-password-encoded = i-encoded-pass
     1855                              .
     1856                           end.
     1857                           assign
     1858                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1859                               buf_user-login.user-login         = i-user-login
     1860                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1861                               buf_user-login.max-discnt         = i-max-discnt
     1862                               buf_user-login.quest-print        = i-quest-print
     1863                           .
     1864                           if i-nextcon ne ?
     1865                           then do:
     1866                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1867                           end.
     1868                           if UserDbAdm.db-adm
     1869                           then do:
     1870                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1871                              if error-status:error
     1872                              then
     1873                                 undo, return error return-value.
     1874                           end.
     1875                       end.
     1876                       else do:
     1877                          if available buf_user-login
     1878                          then do:
     1879                             define variable vok as logical no-undo.
     1880                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1881                             if not vok
     1882                             then
     1883                                undo, return error return-value.
     1884                          end.
     1885                       end.
     1886                    end.
     1887                     if vDbError ne ""
     1888                     then
     1889                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1890                 end.
     1891              end.
     1892           end.
     1893           else do transaction
     1894           on error undo, return error return-value
     1895           :
     1896              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1897                                          and buf_user-login.user-id            = i-user-id
     1898              exclusive-lock no-error.
     1899              if not available buf_user-login
     1900              then do:
     1901                 create buf_user-login .
     1902                 assign
     1903                    buf_user-login.db-num             = i-db-num
     1904                    buf_user-login.user-id            = i-user-id
     1905                    buf_user-login.status_            = 0
     1906                 .
     1907              end.
     1908              assign
     1909                   buf_user-login.user-login         = i-user-login
     1910                   buf_user-login.user-administrator = i-user-administrator
     1911                   buf_user-login.max-discnt         = i-max-discnt
     1912                   buf_user-login.quest-print        = i-quest-print
     1913                   buf_user-login.user-password-encoded = i-encoded-pass
     1914               .
     1915               if i-user-administrator
     1916               then
     1917                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1918               if i-nextcon ne ?
     1919               then do:
     1920                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1921               end.
     1922           end.
     1923       end.
     1924   end procedure.
     1925   procedure addobj:
     1926      define input  parameter i-db-num as integer no-undo.
     1927      define input  parameter i-user-id as character no-undo.
     1928      define buffer buf_user-obj     for ub.user-obj.
     1929      define buffer buf_clients      for ub.clients.
     1930      if i-db-num <> 0 then do:
     1931          for each buf_clients
     1932              where buf_clients.db-num = i-db-num
     1933              and ( buf_clients.obj-type = 'маг':U
     1934                 or buf_clients.obj-type = 'скл':U
     1935                  )
     1936              no-lock:
     1937             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1938                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1939                                     and buf_user-obj.user-id      = i-user-id
     1940                                     and buf_user-obj.db-num       = i-db-num
     1941                                   no-lock)
     1942                                   then next.
     1943             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1944          end.
     1945       end.
     1946       else do:
     1947          for each buf_clients
     1948              where
     1949                  ( buf_clients.obj-type = 'маг':U
     1950                 or buf_clients.obj-type = 'скл':U
     1951                  )
     1952              no-lock:
     1953             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1954                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1955                                     and buf_user-obj.user-id      = i-user-id
     1956                                     and buf_user-obj.db-num       = i-db-num
     1957                                   no-lock)
     1958                                   then next.
     1959             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1960          end.
     1961       end.
     1962   end.
     1963   procedure enbl-obj :
     1964      define input  parameter i-db-num  as integer   no-undo.
     1965      define input  parameter i-user-id as character no-undo.
     1966      define input  parameter i-type    as character no-undo.
     1967      define input  parameter i-code    as integer   no-undo.
     1968       define variable v-host-code    as integer      no-undo.
     1969       define variable v-host-name    as character    no-undo.
     1970       define variable v-base-code    as integer      no-undo.
     1971       define buffer buf_user-obj      for ub.user-obj.
     1972       define buffer buf_user-host     for ub.user-host.
     1973       define buffer buf_clients       for ub.clients.
     1974   do
     1975   for buf_user-obj
     1976     , buf_user-host
     1977     , buf_clients
     1978   on error undo, return error
     1979   :
     1980       find first buf_user-obj exclusive-lock
     1981            where buf_user-obj.db-num    = i-db-num
     1982              and buf_user-obj.user-id   = i-user-id
     1983              and buf_user-obj.obj-type  = i-type
     1984              and buf_user-obj.obj-code  = i-code
     1985       no-error.
     1986       if not available buf_user-obj
     1987       then do:
     1988           find first buf_clients no-lock
     1989                where buf_clients.obj-type = i-type
     1990                  and buf_clients.obj-code = i-code
     1991           .
     1992   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1994     (input  i-type
     1995     ,input  i-code
     1996     ,output v-host-code
     1997     ,output v-host-name
     1998     )  .
     1999   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2001     (input  v-host-code
     2002     ,output v-base-code
     2003     )  .
     2004           create buf_user-obj.
     2005           assign
     2006               buf_user-obj.db-num    = i-db-num
     2007               buf_user-obj.user-id   = i-user-id
     2008               buf_user-obj.obj-type  = i-type
     2009               buf_user-obj.obj-code  = i-code
     2010               buf_user-obj.host-code = v-host-code
     2011           .
     2012           find first buf_user-host exclusive-lock
     2013                where buf_user-host.db-num    = i-db-num
     2014                  and buf_user-host.user-id   = i-user-id
     2015                  and buf_user-host.host-code = v-host-code
     2016           no-error.
     2017           if not available buf_user-host
     2018           then do:
     2019               create buf_user-host.
     2020               assign
     2021                   buf_user-host.db-num    = i-db-num
     2022                   buf_user-host.user-id   = i-user-id
     2023                   buf_user-host.host-code = v-host-code
     2024               .
     2025           end.
     2026      end.
     2027   end.
     2028   end procedure.
     2029   procedure can-edit-login :
     2030     define input  parameter p-db-num   as integer   no-undo .
     2031     define output parameter p-can-edit as logical   no-undo .
     2032     define buffer buf_db for ub.db .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       find first buf_db no-lock
     2037            where buf_db.db-num = p-db-num
     2038       no-error.
     2039       if not available buf_db
     2040       then do:
     2041         message
     2042           vss-workfile vss-revision vss-description
     2043           skip "Внутренняя ошибка"
     2044           skip "Неизвестный номер БД" p-db-num
     2045           skip view-as alert-box error .
     2046         undo, return error return-value .
     2047       end.
     2048       assign
     2049         p-can-edit = ( p-db-num = v-cntxt-db-num
     2050                       or
     2051                       buf_db.db-key = '':U
     2052                       or v-cntxt-db-num = 0
     2053                      )
     2054       .
     2055     end.
     2056   end procedure.
     2057   procedure procedure-user-login-change-password :
     2058      define input  parameter p-db-num         as integer          no-undo.
     2059      define input  parameter p-user-id        as character        no-undo.
     2060      define input  parameter iChange          as logical          no-undo.
     2061      define variable v-can-edit         as logical   no-undo .
     2062      define variable v-encoded-pass     as character no-undo .
     2063      define variable v-encoded-pass-old as character no-undo .
     2064      define variable v-nextcon          as logical   no-undo .
     2065      define variable VadmSuff           as character no-undo.
     2066      define variable vChange as logical no-undo.
     2067      define variable v-param-type as character no-undo .
     2068      define variable v-value-character as character no-undo .
     2069      define variable v-value-date as date no-undo .
     2070      define variable v-value-decimal as decimal no-undo .
     2071      define variable v-value-integer as integer no-undo .
     2072      define variable v-value-logical as logical no-undo .
     2073      define variable v-tth           as handle  no-undo .
     2074      define buffer buf_lock_user-login for user-login.
     2075      define buffer buf_init_user-account for user-account.
     2076      do:
     2077         find first buf_lock_user-login no-lock
     2078                 where buf_lock_user-login.db-num  = p-db-num
     2079                   and buf_lock_user-login.user-id = p-user-id
     2080         no-error.
     2081         if not available buf_lock_user-login then do:
     2082            message
     2083               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     2084               view-as alert-box error .
     2085               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     2086         end.
     2087         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     2088         if vChange
     2089         then do trans:
     2090            run can-edit-login in this-procedure
     2091                 (input  p-db-num
     2092                 ,output v-can-edit
     2093                 ) .
     2094               if v-can-edit <> true
     2095               then do:
     2096                 message
     2097                   "Нельзя редактировать логин пользователя для базы" p-db-num skip
     2098                   view-as alert-box error .
     2099                 undo, return error return-value .
     2100               end.
     2101            if get-work-status( p-user-id ) = '+':u
     2102            then do:
     2103               message
     2104                   "Нельзя редактировать пароль работающего пользователя" skip
     2105                  view-as alert-box error .
     2106                    undo, return error "Нельзя редактировать пароль работающего пользователя" .
     2107            end.
     2108         end.
     2109         if     available buf_lock_user-login
     2110            and buf_lock_user-login.user-administrator
     2111         then
     2112            VadmSuff = 'Adm':U.
     2113         define variable v-TimeAvail as integer no-undo.
     2114         define variable v-DateChg   as date    no-undo.
     2115         define variable v-Time      as integer no-undo.
     2116         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     2117         run adm/shattri.p (
     2118              input "get":U
     2119              ,input  '':U
     2120              ,input  0
     2121              ,input  'staff':U
     2122              ,input  'TimeBlock':U + VadmSuff
     2123              ,output v-value-character
     2124              ,output v-value-date
     2125              ,output v-value-decimal
     2126              ,output v-TimeAvail
     2127              ,output v-value-logical
     2128              ,output v-param-type
     2129              ,input-output table-handle v-tth
     2130              )  .
     2131         if     not iChange
     2132            and v-TimeAvail ne 0
     2133            and v-DateChg + v-TimeAvail < today
     2134         then do:
     2135            do trans:
     2136               find current buf_lock_user-login exclusive-lock.
     2137               buf_lock_user-login.status_ = 1.
     2138            end.
     2139            return error "Ваша учетная запись заблокирована." .
     2140         end.
     2141         run adm/shattri.p (
     2142              input "get":U
     2143              ,input  '':U
     2144              ,input  0
     2145              ,input  'staff':U
     2146              ,input  'TimeAvail':U + VadmSuff
     2147              ,output v-value-character
     2148              ,output v-value-date
     2149              ,output v-value-decimal
     2150              ,output v-TimeAvail
     2151              ,output v-value-logical
     2152              ,output v-param-type
     2153              ,input-output table-handle v-tth
     2154              )  .
     2155         delete object v-tth.
     2156         define variable vfl as logical no-undo.
     2157         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     2158         if    vfl eq yes
     2159            or (     v-TimeAvail ne 0
     2160                 and v-DateChg + v-TimeAvail < today)
     2161            or iChange
     2162         then do:
     2163             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     2164             no-lock.
     2165             assign
     2166             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     2167             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     2168             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     2169                v-encoded-pass = v-encoded-pass-old.
     2170                run adm/chg-pswd.w ( input  this-procedure
     2171                                   , input  p-db-num
     2172                                   , input  buf_lock_user-login.user-id
     2173                                   , input  buf_lock_user-login.user-login
     2174                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     2175                                                                   , buf_init_user-account.first-name
     2176                                                                   , buf_init_user-account.second-name
     2177                                          )
     2178                                   , input  iChange
     2179                                   , input  yes
     2180                                   , input  buf_lock_user-login.user-password-encoded
     2181                                   , input  yes
     2182                                   , input  buf_lock_user-login.user-administrator
     2183                                   , output v-encoded-pass
     2184                                   , output v-nextcon
     2185                                   ) no-error .
     2186               if error-status :error
     2187               then do:
     2188                 message
     2189                    vss-workfile vss-revision vss-description skip
     2190                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     2191                    error-status :get-message(1) skip
     2192                    return-value skip
     2193                    view-as alert-box error .
     2194                 undo, return error return-value .
     2195                end.
     2196                if    v-encoded-pass = v-encoded-pass-old
     2197                then do:
     2198                    message
     2199                       vss-workfile vss-revision vss-description skip
     2200                       "Старый пароль и новый равны. Смените пароль.":U skip
     2201                       error-status :get-message(1) skip
     2202                       return-value skip
     2203                       view-as alert-box error .
     2204                end.
     2205                else if v-encoded-pass eq ?
     2206                then do:
     2207                   message  "Отказ от смены пароля. Работа дальше не возможна"
     2208                   view-as alert-box error.
     2209                   return error "Отказ от смены пароля. Работа дальше не возможна".
     2210                end.
     2211             end.
     2212             if v-encoded-pass <> ? then
     2213             do trans:
     2214                find current buf_lock_user-login
     2215                      exclusive-lock
     2216                   .
     2217                assign
     2218                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     2219                .
     2220                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     2221                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     2222                release buf_lock_user-login .
     2223                message
     2224                   "Пароль успешно изменен"
     2225                   view-as alert-box information
     2226                .
     2227             end.
     2228          end.
     2229      end.
     2230   end procedure.
     2231   procedure procedure-user-login-delete :
     2232      define input  parameter i-db-num     as integer          no-undo.
     2233      define input  parameter i-user-id    as character        no-undo.
     2234      define output parameter o-deleted   as logical          no-undo.
     2235      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     2236   end.
     2237   procedure procedure-user-login-delete-question :
     2238   define input  parameter i-db-num     as integer          no-undo.
     2239   define input  parameter i-user-id    as character        no-undo.
     2240   define input  parameter i-question as logical no-undo.
     2241   define output parameter o-deleted   as logical          no-undo.
     2242     define variable v-can-edit as logical   no-undo .
     2243       define buffer buf_user-login         for user-login .
     2244       define buffer buf_user-account       for user-account.
     2245       define buffer buf_init_user-account  for user-account.
     2246   do
     2247   for buf_user-login
     2248     , buf_user-account
     2249   on error undo, return error return-value
     2250   :
     2251       assign
     2252           o-deleted = no
     2253       .
     2254       find first buf_init_user-account no-lock
     2255            where buf_init_user-account.user-id = i-user-id
     2256           .
     2257       if available buf_init_user-account
     2258       then do:
     2259         do transaction
     2260         on error undo, return error return-value
     2261         :
     2262           run can-edit-login in this-procedure (
     2263                 input  i-db-num
     2264               , output v-can-edit
     2265           ).
     2266           if v-can-edit <> true
     2267           then do:
     2268             message
     2269               "Нельзя удалять логин пользователя для базы" i-db-num
     2270             view-as alert-box error .
     2271             undo, return error return-value .
     2272           end.
     2273           find first buf_user-login exclusive-lock
     2274                where buf_user-login.db-num  = i-db-num
     2275                  and buf_user-login.user-id = i-user-id
     2276           no-error no-wait.
     2277           if not available buf_user-login
     2278           then do:
     2279             if locked( buf_user-login )
     2280             then do:
     2281               find first buf_user-login no-lock
     2282                    where buf_user-login.db-num  = i-db-num
     2283                      and buf_user-login.user-id = i-user-id
     2284               .
     2285               message
     2286                 "Удаление логина невозможно" skip
     2287                 "Пользователь в данный момент работает в системе" skip
     2288                 "БД" i-db-num skip
     2289                 "Идентификатор" i-user-id skip
     2290                 "Псевдоним"                    buf_init_user-account.nik skip
     2291                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     2292                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     2293                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     2294                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     2295                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     2296                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     2297                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     2298                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     2299                 view-as alert-box error .
     2300             end.
     2301             else do:
     2302               message
     2303                 "У пользователя нет логина" skip
     2304                 "БД" i-db-num skip
     2305                 "Идентификатор" i-user-id skip
     2306                 "Удаление невозможно" skip
     2307                 view-as alert-box error .
     2308             end.
     2309             undo, return error return-value .
     2310           end.
     2311           if  buf_user-login.user-id = v-cntxt-userid
     2312           and buf_user-login.db-num  = v-cntxt-db-num
     2313           then do:
     2314             message
     2315               "Нельзя удалять текущий логин" skip
     2316               "БД"  buf_user-login.db-num skip
     2317               "Идентификатор" buf_user-login.user-id skip
     2318               view-as alert-box error .
     2319             undo, return error return-value .
     2320           end.
     2321           define variable v-ok as logical   no-undo .
     2322           if not i-question
     2323           then
     2324              v-ok = yes.
     2325           else do:
     2326              find first buf_user-account no-lock
     2327                   where buf_user-account.user-id = buf_user-login.user-id
     2328              .
     2329              message
     2330                "Удаление логина пользователя"
     2331                skip "Идентификатор" buf_user-account.user-id
     2332                skip "Псевдоним"    buf_user-account.nik
     2333                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     2334                skip "Логин для базы данных" buf_user-login.db-num
     2335                skip "Логин" buf_user-login.user-login
     2336                skip (1)
     2337                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     2338                skip (1)
     2339                "Продолжить?"
     2340              view-as alert-box question
     2341              buttons yes-no
     2342              update v-ok .
     2343           end.
     2344           if v-ok = yes
     2345           then do:
     2346               run str/usrlog03.p (
     2347                     input buf_user-login.db-num
     2348                   , input buf_user-login.user-id
     2349               ).
     2350               assign
     2351                   o-deleted = yes
     2352               .
     2353           end.
     2354         end.
     2355       end.
     2356     end.
     2357   end procedure.
     2358   define variable v-users-name-filter     as character    no-undo.
     2359   define variable v-users-login-filter    as character    no-undo.
     2360   define variable v-filter-yes            as logical      no-undo.
     2361   define variable v-user-login            as logical      no-undo.
     2362   define variable v-users-user-login      as logical      no-undo.
     2363   define variable v-users-work-status     as character    no-undo.
     2364   define variable v-users-last-cb-db      as integer      no-undo.
     2365   define variable v-ok                    as logical      no-undo.
     2366   define variable v-users-set-rowid       as logical      no-undo.
     2367   define variable v-users-current-rowid   as rowid        no-undo.
     2368   define variable v-users-current-focus   as integer      no-undo.
     2369   define variable v-only-lookup           as logical      no-undo.
     2370   define variable v-rowid-login           as rowid        no-undo.
     2371   define variable mSuperAdm               as logical no-undo.
     2372   define buffer buf_init_user-account      for user-account.
     2373   define buffer buf_init_user-login        for user-login.
     2374   define stream out-stream.
     2375   define stream OutStr-html.
     2376   define variable p-report-id               as integer              no-undo .
     2377   define variable v-report-name-html        as CHARACTER            no-undo .
     2378   define variable v-report-name-html-list   as CHARACTER            no-undo .
     2379     define temp-table tt-user-login no-undo
     2380       field users-id   like ub.user-login.user-id
     2381       field nik        like ub.user-account.nik
     2382       field db-num     like ub.user-login.db-num
     2383       field user-login like ub.user-login.user-login
     2384       field last-login-mjd like ub.user-login.last-login-mjd
     2385       field last-name  as character
     2386     .
     2387   define buffer buf_global-state      for ub.global-state .
     2388   define buffer buf_global-state-attr for ub.global-state-attr .
     2389   define variable v-action-gbl    as logical      no-undo .
     2390   FUNCTION get-person-name RETURNS CHARACTER
     2391     ( p-psn-code as integer )  FORWARD.
     2392   DEFINE MENU POPUP-MENU-b-print
     2393          MENU-ITEM m_b-print-prava LABEL "Список прав пользователей"
     2394          MENU-ITEM m_b-print-user LABEL "Пользователь"
     2395          MENU-ITEM m_b-print-list LABEL "Список пользователей"
     2396          MENU-ITEM last-pwd LABEL "Отчет о смене паролей "
     2397          MENU-ITEM adm-bd LABEL "Пользователи с правами администраторов БД"
     2398   .
     2399   DEFINE BUTTON b-add
     2400        LABEL "&Добавить"
     2401        SIZE 10 BY 1.
     2402   DEFINE BUTTON b-add-2
     2403        LABEL "&Добавить"
     2404        SIZE 10 BY 1.
     2405   DEFINE BUTTON b-chg
     2406        LABEL "&Изменить"
     2407        SIZE 10 BY 1.
     2408   DEFINE BUTTON b-chg-2
     2409        LABEL "&Изменить"
     2410        SIZE 10 BY 1.
     2411   DEFINE BUTTON b-copy
     2412        LABEL "&Копировать"
     2413        SIZE 10.5 BY 1.
     2414   DEFINE BUTTON b-del
     2415        LABEL "&Удалить"
     2416        SIZE 10 BY 1.
     2417   DEFINE BUTTON b-del-2
     2418        LABEL "&Удалить"
     2419        SIZE 10 BY 1.
     2420   DEFINE BUTTON b-dup
     2421        LABEL "&Копия"
     2422        SIZE 10 BY 1.
     2423   DEFINE BUTTON b-exit AUTO-GO
     2424        LABEL "В&ыход"
     2425        SIZE 10 BY 1
     2426        BGCOLOR 8 .
     2427   DEFINE BUTTON b-filter
     2428        LABEL "Ф&Поиск"
     2429        SIZE 10 BY 1 TOOLTIP "Поиск с фильтрацией по фамилии, имени пользователя, псевдониму и логину".
     2430   DEFINE BUTTON b-help
     2431        LABEL "Помо&щь"
     2432        SIZE 3 BY 1
     2433        BGCOLOR 8 .
     2434   DEFINE BUTTON b-hist
     2435        LABEL "Ис&тория"
     2436        SIZE 3 BY 1.
     2437   DEFINE BUTTON b-hist-user
     2438        LABEL "Ис&тория"
     2439        SIZE 3 BY 1.
     2440   DEFINE BUTTON b-print
     2441        LABEL "Печать"
     2442        SIZE 3 BY 1.
     2443   DEFINE BUTTON b-userhist
     2444        LABEL "&История"
     2445        SIZE 10 BY 1.
     2446   DEFINE BUTTON bt-firm
     2447        LABEL "Фирмы"
     2448        SIZE 10 BY 1.
     2449   DEFINE BUTTON bt-menu
     2450        LABEL "Меню"
     2451        SIZE 10 BY 1.
     2452   DEFINE BUTTON bt-object
     2453        LABEL "Объекты"
     2454        SIZE 10 BY 1.
     2455   DEFINE BUTTON bt-password
     2456        LABEL "&Пароль"
     2457        SIZE 10 BY 1.
     2458   DEFINE BUTTON bt-role
     2459        LABEL "Права"
     2460        SIZE 10 BY 1.
     2461   DEFINE VARIABLE cb-db AS INTEGER FORMAT "->>>>9":U INITIAL -1
     2462        LABEL "БД"
     2463        VIEW-AS COMBO-BOX INNER-LINES 15
     2464        LIST-ITEM-PAIRS "0",1
     2465        DROP-DOWN-LIST
     2466        SIZE 20 BY 1 TOOLTIP "База данных, в которой у пользователя есть логин" NO-UNDO.
     2467   DEFINE VARIABLE ed-login-object AS CHARACTER
     2468        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-VERTICAL
     2469        SIZE 50 BY 12.25
     2470        FGCOLOR 4  NO-UNDO.
     2471   DEFINE VARIABLE ed-user-info AS CHARACTER
     2472        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2473        SIZE 56.5 BY 3.5
     2474        FGCOLOR 4  NO-UNDO.
     2475   DEFINE VARIABLE fi-filter-comment AS CHARACTER FORMAT "X(256)":U
     2476        VIEW-AS FILL-IN
     2477        SIZE 24.5 BY 1 NO-UNDO.
     2478   DEFINE VARIABLE rs-scope AS INTEGER
     2479        VIEW-AS RADIO-SET HORIZONTAL
     2480        RADIO-BUTTONS
     2481             "Тек", 1,
     2482   "Все", 2,
     2483   "Удал", 3
     2484        SIZE 18 BY .75
     2485        FGCOLOR 4  NO-UNDO.
     2486   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
     2487        LABEL ""
     2488        VIEW-AS TOGGLE-BOX
     2489        SIZE 2.63 BY .79 NO-UNDO.
     2490   DEFINE QUERY br-login FOR
     2491         buf_init_user-login SCROLLING.
     2492   DEFINE QUERY br-user FOR
     2493         buf_init_user-account,
     2494         temp_filter-fields SCROLLING.
     2495   DEFINE BROWSE br-login
     2496     QUERY br-login NO-LOCK DISPLAY
     2497         buf_init_user-login.db-num FORMAT ">>>>9":U column-label " БД"
     2498         buf_init_user-login.user-login COLUMN-LABEL " Логин" FORMAT "X(12)":U
     2499               WIDTH 19.5
     2500         buf_init_user-login.max-discnt FORMAT ">>9.99":U WIDTH 20.75 column-label "Макс.скидка"
     2501       WITH NO-ROW-MARKERS SEPARATORS SIZE 50 BY 6.75 FIT-LAST-COLUMN.
     2502   DEFINE BROWSE br-user
     2503     QUERY br-user NO-LOCK DISPLAY
     2504         buf_init_user-account.nik COLUMN-LABEL " Псевдоним"  FORMAT "X(10)":U
     2505         buf_init_user-account.last-name COLUMN-LABEL " Фамилия"  FORMAT "X(24)":U
     2506         buf_init_user-account.first-name COLUMN-LABEL " Имя" FORMAT "X(12)":U
     2507         get-user-login( buf_init_user-account.user-id ) @ v-users-user-login COLUMN-LABEL " БД" FORMAT "X(9)":U
     2508         buf_init_user-account.user-id COLUMN-LABEL " ID"  FORMAT "X(8)":U
     2509         get-person-name( buf_init_user-account.psn-code ) COLUMN-LABEL " Физ. лицо"  FORMAT "X(40)":U
     2510       WITH NO-ROW-MARKERS SEPARATORS SIZE 56.5 BY 16.75 FIT-LAST-COLUMN.
     2511   DEFINE FRAME Dialog-Frame
     2512        b-exit AT ROW 1 COL 1.5
     2513        cb-db AT ROW 1 COL 13.88 COLON-ALIGNED WIDGET-ID 40
     2514        b-filter AT ROW 1 COL 54.63 WIDGET-ID 26
     2515        fi-filter-comment AT ROW 1 COL 63.13 COLON-ALIGNED NO-LABEL WIDGET-ID 20 NO-TAB-STOP
     2516        tb-filter AT ROW 1 COL 96.38 WIDGET-ID 60
     2517        b-hist AT ROW 1 COL 98.88 WIDGET-ID 64
     2518        b-print AT ROW 1 COL 101.75 WIDGET-ID 62
     2519        b-help AT ROW 1 COL 104.75
     2520        rs-scope AT ROW 1.25 COL 36.5 NO-LABEL WIDGET-ID 42
     2521        b-add AT ROW 2.25 COL 1.5 WIDGET-ID 2
     2522        b-chg AT ROW 2.25 COL 11.5 WIDGET-ID 4
     2523        b-dup AT ROW 2.25 COL 21.5 WIDGET-ID 58
     2524        b-del AT ROW 2.25 COL 31.5 WIDGET-ID 6
     2525        b-userhist AT ROW 2.25 COL 41.5 WIDGET-ID 62
     2526        b-hist-user AT ROW 2.25 COL 51.5 WIDGET-ID 64
     2527        b-add-2 AT ROW 2.25 COL 58.5 WIDGET-ID 28
     2528        b-copy AT ROW 2.25 COL 68.38 WIDGET-ID 66
     2529        b-chg-2 AT ROW 2.25 COL 78.75 WIDGET-ID 30
     2530        b-del-2 AT ROW 2.25 COL 88.63 WIDGET-ID 32
     2531        bt-password AT ROW 2.25 COL 98.5 WIDGET-ID 56
     2532        br-user AT ROW 3.25 COL 1.5 WIDGET-ID 200
     2533        br-login AT ROW 3.25 COL 58.5 WIDGET-ID 300
     2534        bt-object AT ROW 10 COL 58.5 WIDGET-ID 48
     2535        bt-firm AT ROW 10 COL 68.5 WIDGET-ID 52
     2536        bt-role AT ROW 10 COL 78.5 WIDGET-ID 50
     2537        bt-menu AT ROW 10 COL 88.5 WIDGET-ID 54
     2538        ed-login-object AT ROW 11.25 COL 58.5 NO-LABEL WIDGET-ID 36
     2539        ed-user-info AT ROW 20 COL 1.5 NO-LABEL WIDGET-ID 34
     2540        SPACE(50.99) SKIP(0.12)
     2541       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2542            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2543            TITLE "Пользователи"
     2544            DEFAULT-BUTTON b-exit WIDGET-ID 100.
     2545   ASSIGN
     2546          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2547          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2548   ASSIGN
     2549          b-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-print:HANDLE.
     2550   ASSIGN b-print :MENU-MOUSE = 1.
     2551   ASSIGN
     2552          ed-login-object:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2553   ASSIGN
     2554          ed-user-info:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2555   ASSIGN
     2556          fi-filter-comment:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2557   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2558   DO:
     2559     APPLY "END-ERROR":U TO SELF.
     2560   END.
     2561   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2562   DO:
     2563       define variable v-user-id                   as character    no-undo.
     2564       define variable v-last-name                 as character    no-undo.
     2565       define variable v-first-name                as character    no-undo.
     2566       define variable v-second-name               as character    no-undo.
     2567       define variable v-nik                       as character    no-undo.
     2568       define variable v-phone-number              as character    no-undo.
     2569       define variable v-mobile-phone-number       as character    no-undo.
     2570       define variable v-company                   as character    no-undo.
     2571       define variable v-department                as character    no-undo.
     2572       define variable v-position                  as character    no-undo.
     2573       define variable v-room                      as character    no-undo.
     2574       define variable v-e-mail                    as character    no-undo.
     2575       define variable v-internal-phone-number     as character    no-undo.
     2576       define variable v-PS                        as character    no-undo.
     2577       define variable v-accepted                  as logical      no-undo.
     2578       define variable v-created                   as logical      no-undo.
     2579       define variable v-psn-code                  as integer      no-undo.
     2580       define variable v-adm-Ubd                   as logical      no-undo.
     2581       define variable v-adm-gbd                   as logical      no-undo.
     2582       define variable v-superAdm                  as logical      no-undo.
     2583       define variable v-TabUserAdm                as handle       no-undo.
     2584       define buffer buf_user-account      for user-account.
     2585       define buffer buf_user-login        for user-login.
     2586       run getAccountSetting (input  ?,
     2587                                 output v-adm-Ubd,
     2588                                 output v-adm-gbd,
     2589                                 output v-superAdm,
     2590                                 input-output table-handle v-TabUserAdm).
     2591       run str/user.w (
     2592             input parparentproc
     2593           , input this-procedure
     2594           , input 'ДОБАВЛЕНИЕ':U
     2595           , input "< Новый >"
     2596           , input "":U
     2597           , input "":U
     2598           , input "":U
     2599           , input "":U
     2600           , input "":U
     2601           , input "":U
     2602           , input "":U
     2603           , input "":U
     2604           , input "":U
     2605           , input "":U
     2606           , input "":U
     2607           , input "":U
     2608           , input "":U
     2609           , input ?
     2610           , input ?
     2611           , input no
     2612           , input ?
     2613           , input-output table-handle v-TabUserAdm
     2614           , output v-last-name
     2615           , output v-first-name
     2616           , output v-second-name
     2617           , output v-nik
     2618           , output v-phone-number
     2619           , output v-mobile-phone-number
     2620           , output v-company
     2621           , output v-department
     2622           , output v-position
     2623           , output v-room
     2624           , output v-e-mail
     2625           , output v-internal-phone-number
     2626           , output v-PS
     2627           , output v-psn-code
     2628           , output v-adm-gbd
     2629           , output v-superAdm
     2630           , output v-adm-Ubd
     2631           , output v-accepted
     2632       ) no-error.
     2633       if error-status :error
     2634       then do:
     2635           message
     2636                       vss-workfile vss-revision vss-description
     2637               skip(1)
     2638               skip "Ошибка редактирования пользователя."
     2639               skip return-value
     2640               skip trim( error-status :get-message( 1 ) )
     2641                       trim( error-status :get-message( 2 ) )
     2642                       trim( error-status :get-message( 3 ) )
     2643           view-as alert-box error.
     2644           undo, return no-apply.
     2645       end.
     2646       if v-accepted = yes
     2647       then do:
     2648           run str/usracc01.p (
     2649                 input 'ДОБАВЛЕНИЕ':U
     2650               , input v-cntxt-db-num
     2651               , input "":U
     2652               , input v-last-name
     2653               , input v-first-name
     2654               , input v-second-name
     2655               , input v-nik
     2656               , input v-phone-number
     2657               , input v-mobile-phone-number
     2658               , input v-company
     2659               , input v-department
     2660               , input v-position
     2661               , input v-room
     2662               , input v-e-mail
     2663               , input v-internal-phone-number
     2664               , input v-PS
     2665               , input v-psn-code
     2666               , input v-superAdm
     2667               , output v-user-id
     2668           ) no-error.
     2669           if error-status :error
     2670           then do:
     2671               message
     2672                           vss-workfile vss-revision vss-description
     2673                   skip(1)
     2674                   skip "Ошибка изменения данных пользователя."
     2675                   skip return-value
     2676                   skip trim( error-status :get-message( 1 ) )
     2677                           trim( error-status :get-message( 2 ) )
     2678                           trim( error-status :get-message( 3 ) )
     2679               view-as alert-box error.
     2680               undo, return no-apply.
     2681           end.
     2682           define variable v-yesno    as logical      no-undo.
     2683           if mSuperadm
     2684           then
     2685              v-yesno = yes.
     2686           else do:
     2687              message
     2688                       "Создать логин для нового пользователя?"
     2689              view-as alert-box question
     2690              buttons yes-no
     2691              title "Создание логина"
     2692              update v-yesno .
     2693           end.
     2694           if v-yesno = yes
     2695           then do:
     2696               run procedure-user-login-create in this-procedure (
     2697                     input "'ДОБАВЛЕНИЕ':U"
     2698                   , input if mSuperadm then ? else v-cntxt-db-num
     2699                   , input v-user-id
     2700                   , input v-adm-gbd
     2701                   , input v-adm-Ubd
     2702                   , input v-TabUserAdm
     2703                   , output v-created
     2704               ) no-error.
     2705               if error-status :error
     2706               then do:
     2707                   message
     2708                           vss-workfile vss-revision vss-description
     2709                       skip(1)
     2710                       skip "Ошибка создания логина пользователя."
     2711                       skip return-value
     2712                       skip trim( error-status :get-message( 1 ) )
     2713                           trim( error-status :get-message( 2 ) )
     2714                           trim( error-status :get-message( 3 ) )
     2715                   view-as alert-box error.
     2716                   undo, return no-apply.
     2717               end.
     2718           end.
     2719           else do:
     2720               if v-cntxt-db-num = 0
     2721               then do:
     2722                   assign
     2723                       cb-db = -1
     2724                   .
     2725                   display
     2726                       cb-db
     2727                   with frame Dialog-Frame.
     2728               end.
     2729           end.
     2730           run assign-field-filter-mark in this-procedure (
     2731                 input v-users-name-filter
     2732               , input v-users-login-filter
     2733           ).
     2734           run open-query in this-procedure ( input this-procedure ).
     2735           find first buf_user-account no-lock
     2736                where buf_user-account.user-id = v-user-id
     2737           .
     2738           run manage-fields in this-procedure.
     2739           if v-created = yes
     2740           then do:
     2741               find first buf_user-login no-lock
     2742                    where buf_user-login.user-id  = v-user-id
     2743               no-error.
     2744               if available buf_user-login
     2745               then
     2746                  reposition br-login to rowid rowid( buf_user-login ) no-error.
     2747           end.
     2748           apply "entry":U to br-user.
     2749       end.
     2750   END.
     2751   ON CHOOSE OF b-add-2 IN FRAME Dialog-Frame
     2752   DO:
     2753       define variable v-created               as logical      no-undo.
     2754       if available buf_init_user-account
     2755       then do:
     2756           run procedure-user-login-create in this-procedure (
     2757                 input "add"
     2758               , input v-cntxt-db-num
     2759               , input buf_init_user-account.user-id
     2760               , input ?
     2761               , input ?
     2762               , input ?
     2763               , output v-created
     2764           ) no-error.
     2765           if error-status :error
     2766           then do:
     2767               message
     2768                        vss-workfile vss-revision vss-description
     2769                   skip(1)
     2770                   skip "Ошибка создания логина пользователя."
     2771                   skip return-value
     2772                   skip trim( error-status :get-message( 1 ) )
     2773                        trim( error-status :get-message( 2 ) )
     2774                        trim( error-status :get-message( 3 ) )
