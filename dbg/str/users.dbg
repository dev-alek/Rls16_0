     4371                 .
     4372               end.
     4373             end.
     4374             run diasize_position-resize-button in this-procedure .
     4375           end.
     4376           assign
     4377             v-diasize-change-size = false
     4378           .
     4379           leave move_block .
     4380         end.
     4381       end.
     4382       assign
     4383         v-diasize-need-full-display = true
     4384       .
     4385       if v-diasize-change-size = false
     4386       then do:
     4387         assign
     4388           v-diasize-change-size = true
     4389         .
     4390       end.
     4391       else do:
     4392         return .
     4393       end.
     4394       assign
     4395         v-frame-width = frame Dialog-Frame :width
     4396         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4397         v-browse-width = v-diasize-browse-handle :width
     4398       .
     4399       for each buf_temp-browse-handle
     4400         where buf_temp-browse-handle.browse-type = 'width':u
     4401       :
     4402         assign
     4403           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4404         .
     4405       end.
     4406       for each buf_temp-diasize-handle
     4407       :
     4408         delete buf_temp-diasize-handle .
     4409       end.
     4410       assign
     4411         v-field-group-handle = frame Dialog-Frame :first-child
     4412       .
     4413       do while valid-handle(v-field-group-handle)
     4414       :
     4415         assign
     4416           v-object-handle = v-field-group-handle :first-child
     4417         .
     4418         do while valid-handle(v-object-handle)
     4419         :
     4420           if  v-object-handle <> v-diasize-browse-handle :handle
     4421           and v-object-handle <> v-diasize-resize-button
     4422           and can-query(v-object-handle, "row")
     4423           and can-query(v-object-handle, "height")
     4424           and ( v-object-handle :col + v-object-handle :width
     4425                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4426               )
     4427           then do:
     4428             find first buf_temp-browse-handle
     4429               where buf_temp-browse-handle.browse-type   = 'width':u
     4430                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4431               no-error .
     4432             if available buf_temp-browse-handle
     4433             then do:
     4434             end.
     4435             else do:
     4436               create buf_temp-diasize-handle .
     4437               assign
     4438                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4439                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4440               .
     4441             end.
     4442           end.
     4443           assign
     4444             v-object-handle = v-object-handle :next-sibling
     4445           .
     4446         end.
     4447         assign
     4448           v-field-group-handle = v-field-group-handle :next-sibling
     4449         .
     4450       end.
     4451       do with frame Dialog-Frame
     4452       :
     4453         hide v-diasize-resize-button .
     4454         v-diasize-resize-button :row = 1.
     4455         v-diasize-resize-button :column = 1.
     4456       end.
     4457       if p-change-value > 0
     4458       then do:
     4459         if frame Dialog-Frame :scrollable = true
     4460         then do:
     4461           assign
     4462             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4463             no-error .
     4464           if error-status :error
     4465           or error-status :get-message(1) <> ""
     4466           then do:
     4467             undo move_block, retry move_block.
     4468           end.
     4469         end.
     4470         assign
     4471           frame Dialog-Frame :width = v-frame-width + p-change-value
     4472           no-error .
     4473         if error-status :error
     4474         or error-status :get-message(1) <> ""
     4475         then do:
     4476           undo move_block, retry move_block.
     4477         end.
     4478         assign
     4479           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4480         no-error .
     4481         if error-status :error
     4482         or error-status :get-message(1) <> ""
     4483         then do:
     4484           undo move_block, retry move_block.
     4485         end.
     4486         for each buf_temp-browse-handle
     4487           where buf_temp-browse-handle.browse-type = 'width':u
     4488         on error undo move_block, retry move_block
     4489         :
     4490           assign
     4491             buf_temp-browse-handle.browse-handle :width
     4492               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4493             no-error .
     4494           if error-status :error
     4495           or error-status :get-message(1) <> ""
     4496           then do:
     4497             undo move_block, retry move_block .
     4498           end.
     4499         end.
     4500         for each buf_temp-diasize-handle
     4501         on error undo move_block, retry move_block
     4502         :
     4503           assign
     4504             v-object-handle = buf_temp-diasize-handle.handle-value
     4505           .
     4506           if v-object-handle <> v-diasize-resize-button
     4507           then do:
     4508             assign
     4509               v-object-handle :col = v-object-handle :col + p-change-value
     4510               no-error .
     4511             if error-status :error
     4512             or error-status :get-message(1) <> ""
     4513             then do:
     4514               undo move_block, retry move_block .
     4515             end.
     4516           end.
     4517         end.
     4518       end.
     4519       else do:
     4520         for each buf_temp-diasize-handle
     4521         on error undo move_block, retry move_block
     4522         :
     4523           assign
     4524             v-object-handle = buf_temp-diasize-handle.handle-value
     4525           .
     4526           if v-object-handle <> v-diasize-resize-button
     4527           then do:
     4528             assign
     4529               v-object-handle :col = v-object-handle :col + p-change-value
     4530               no-error .
     4531             if error-status :error
     4532             or error-status :get-message(1) <> ""
     4533             then do:
     4534               undo move_block, retry move_block .
     4535             end.
     4536           end.
     4537         end.
     4538         for each buf_temp-browse-handle
     4539           where buf_temp-browse-handle.browse-type = 'width':u
     4540         on error undo move_block, retry move_block
     4541         :
     4542           assign
     4543             buf_temp-browse-handle.browse-handle :width
     4544               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4545             no-error .
     4546           if error-status :error
     4547           or error-status :get-message(1) <> ""
     4548           then do:
     4549             undo move_block, retry move_block .
     4550           end.
     4551         end.
     4552         assign
     4553           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4554           no-error .
     4555         if error-status :error
     4556         or error-status :get-message(1) <> ""
     4557         then do:
     4558           undo move_block, retry move_block.
     4559         end.
     4560         assign
     4561           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4562         no-error .
     4563         if error-status :error
     4564         or error-status :get-message(1) <> ""
     4565         then do:
     4566           undo move_block, retry move_block.
     4567         end.
     4568         if frame Dialog-Frame :scrollable = true
     4569         then do:
     4570           assign
     4571             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4572           no-error .
     4573           if error-status :error
     4574           or error-status :get-message(1) <> ""
     4575           then do:
     4576             undo move_block, retry move_block.
     4577           end.
     4578         end.
     4579       end.
     4580       if p-move-resize
     4581       then do:
     4582         run diasize_position-resize-button in this-procedure .
     4583       end.
     4584       if v-diasize-wndstore = true
     4585       then do:
     4586         if connected("ub") = true
     4587         then do:
     4588           define variable v-cntxt-db-num        as integer   no-undo .
     4589           define variable v-cntxt-userid        as character no-undo .
     4590           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4591                                             , OUTPUT v-cntxt-userid
     4592                                             ) .
     4593           run gbl/wndsizew.p
     4594             (input  v-cntxt-db-num
     4595             ,input  v-cntxt-userid
     4596             ,input  v-diasize-proc-name
     4597             ,input  'width':u
     4598             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4599             ) .
     4600         end.
     4601       end.
     4602     end.
     4603     assign
     4604       v-diasize-change-size = false
     4605     .
     4606   end procedure.
     4607   procedure diasize_set-width :
     4608     define input  parameter p-new-width  as decimal   no-undo .
     4609     define input  parameter p-move-resize as logical   no-undo .
     4610     do
     4611     on error undo, return error return-value
     4612     :
     4613       run diasize_change-width in this-procedure
     4614         (input  (p-new-width - frame Dialog-Frame :width)
     4615         ,input  p-move-resize
     4616         ) .
     4617     end.
     4618   end procedure.
     4619   procedure diasize_position-resize-button :
     4620     do with frame Dialog-Frame
     4621     :
     4622       hide v-diasize-resize-button .
     4623       assign
     4624         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4625                     - 1
     4626                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4627         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4628                     - 1
     4629                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4630       .
     4631       view v-diasize-resize-button .
     4632     end.
     4633   end procedure.
     4634   on alt-right anywhere
     4635   do:
     4636     run diasize_change-width in this-procedure
     4637       (input 1
     4638       ,input true
     4639       ) .
     4640     return no-apply .
     4641   end.
     4642   on alt-left anywhere
     4643   do:
     4644     run diasize_change-width in this-procedure
     4645       (input -1
     4646       ,input true
     4647       ) .
     4648     return no-apply .
     4649   end.
     4650   on alt-down anywhere
     4651   do:
     4652     run diasize_change-height in this-procedure
     4653       (input 1
     4654       ,input true
     4655       ) .
     4656     return no-apply .
     4657   end.
     4658   on alt-up anywhere
     4659   do:
     4660     run diasize_change-height in this-procedure
     4661       (input -1
     4662       ,input true
     4663       ) .
     4664     return no-apply .
     4665   end.
     4666   on alt-enter of frame Dialog-Frame
     4667   do:
     4668     run diasize_maximize in this-procedure
     4669       (input  ?
     4670       ).
     4671     return no-apply .
     4672   end.
     4673   procedure diasize_end-move :
     4674     do
     4675     on error undo, return error return-value
     4676     :
     4677       define variable v-row-delta as decimal   no-undo .
     4678       define variable v-col-delta as decimal   no-undo .
     4679       define variable v-new-row as decimal   no-undo .
     4680       define variable v-new-col as decimal   no-undo .
     4681       assign
     4682         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4683         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4684       .
     4685       assign
     4686         v-row-delta = v-new-row - frame Dialog-Frame :height
     4687         v-col-delta = v-new-col - frame Dialog-Frame :width
     4688       .
     4689       run diasize_change-height in this-procedure
     4690         (input v-row-delta
     4691         ,input true
     4692         ) .
     4693       run diasize_change-width in this-procedure
     4694         (input v-col-delta
     4695         ,input true
     4696         ) .
     4697     end.
     4698   end procedure.
     4699   procedure diasize_maximize :
     4700     define input  parameter p-action as logical   no-undo .
     4701     do
     4702     on error undo, return error return-value
     4703     :
     4704       if p-action = ?
     4705       then do:
     4706         if v-diasize-need-maximize = true
     4707         then do:
     4708           assign
     4709             p-action = true
     4710           .
     4711         end.
     4712         else do:
     4713           assign
     4714             p-action = false
     4715           .
     4716         end.
     4717       end.
     4718       if p-action = true
     4719       then do:
     4720         run diasize_change-height in this-procedure
     4721           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4722               - frame Dialog-Frame :height-chars
     4723           ,input true
     4724           ) .
     4725         run diasize_change-width in this-procedure
     4726           (input session :width-chars
     4727               - frame Dialog-Frame :width-chars
     4728           ,input true
     4729           ) .
     4730         assign
     4731           v-diasize-need-maximize = false
     4732         .
     4733       end.
     4734       else do:
     4735         run diasize_change-width in this-procedure
     4736           (input v-diasize-orig-frame-width
     4737               - frame Dialog-Frame :width-chars
     4738           ,input true
     4739           ) .
     4740         run diasize_change-height in this-procedure
     4741           (input v-diasize-orig-frame-height
     4742               - frame Dialog-Frame :height-chars
     4743           ,input true
     4744           ) .
     4745         assign
     4746           v-diasize-need-maximize = true
     4747         .
     4748       end.
     4749     end.
     4750   end procedure.
     4751   procedure diasize_restore-orig-size :
     4752     do
     4753     on error undo, return error return-value
     4754     :
     4755       assign
     4756         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4757         v-diasize-current-frame-height = frame Dialog-Frame :height
     4758       .
     4759       run diasize_set-height in this-procedure
     4760         (input  v-diasize-orig-frame-height
     4761         ,input  true
     4762         ) .
     4763       run diasize_set-width in this-procedure
     4764         (input  v-diasize-orig-frame-width
     4765         ,input  true
     4766         ) .
     4767     end.
     4768   end procedure.
     4769   procedure diasize_restore-current-size :
     4770     do
     4771     on error undo, return error return-value
     4772     :
     4773       run diasize_set-height in this-procedure
     4774         (input  v-diasize-current-frame-height
     4775         ,input  true
     4776         ) .
     4777       run diasize_set-width in this-procedure
     4778         (input  v-diasize-current-frame-width
     4779         ,input  true
     4780         ) .
     4781     end.
     4782   end procedure.
     4783   procedure diasize_set-browse-handle :
     4784     define input  parameter p-browse-handle as handle   no-undo .
     4785     define buffer buf_temp-browse-handle for temp-browse-handle .
     4786     do
     4787     on error undo, return error return-value
     4788     :
     4789       assign
     4790         v-diasize-browse-handle = p-browse-handle
     4791       .
     4792       for each buf_temp-browse-handle
     4793       on error undo, return error return-value
     4794       :
     4795         delete buf_temp-browse-handle .
     4796       end.
     4797     end.
     4798   end procedure.
     4799   procedure diasize_add_browse :
     4800     define input  parameter p-browse-type   as character no-undo .
     4801     define input  parameter p-browse-handle as handle    no-undo .
     4802     define buffer buf_temp-browse-handle for temp-browse-handle .
     4803     do
     4804     on error undo, return error return-value
     4805     :
     4806       assign
     4807         v-diasize-browse-number = v-diasize-browse-number + 1
     4808       .
     4809       create buf_temp-browse-handle .
     4810       assign
     4811         buf_temp-browse-handle.browse-type   = p-browse-type
     4812         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4813         buf_temp-browse-handle.browse-handle = p-browse-handle
     4814       .
     4815     end.
     4816   end procedure.
     4817   procedure diasize_init :
     4818     define variable v-default-value    as logical   no-undo .
     4819     define variable v-restore-saved    as logical   no-undo .
     4820     define variable v-resize-value-str as character no-undo .
     4821     do
     4822     on error undo, return error return-value
     4823     :
     4824       do with frame Dialog-Frame
     4825       :
     4826         assign
     4827           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4828           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4829           v-diasize-browse-handle     = browse br-login :handle
     4830         .
     4831         create button v-diasize-resize-button
     4832         assign
     4833           parent        = frame Dialog-Frame :first-child
     4834           label         = "s"
     4835           height-pixels = 16
     4836           width-pixels  = 16
     4837           visible       = true
     4838           sensitive     = true
     4839           movable       = true
     4840           triggers:
     4841             on end-move persistent run diasize_end-move in this-procedure .
     4842           end triggers.
     4843         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4844         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4845         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4846         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4847         assign
     4848           v-diasize-wndmax = false
     4849         .
     4850         if connected("ub") = true
     4851         then do:
     4852           define variable v-cntxt-db-num        as integer   no-undo .
     4853           define variable v-cntxt-userid        as character no-undo .
     4854           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4855                                             , OUTPUT v-cntxt-userid
     4856                                             ) .
     4857           run gbl/wndpar_r.p
     4858             (input  v-cntxt-db-num
     4859             ,input  v-cntxt-userid
     4860             ,input  'wndmax':U
     4861             ,output v-diasize-wndmax
     4862             ,output v-default-value
     4863             ) .
     4864         end.
     4865         assign
     4866           v-diasize-wndstore = false
     4867         .
     4868         if connected("ub") = true
     4869         then do:
     4870           run gbl/wndpar_r.p
     4871             (input  v-cntxt-db-num
     4872             ,input  v-cntxt-userid
     4873             ,input  'wndstore':U
     4874             ,output v-diasize-wndstore
     4875             ,output v-default-value
     4876             ) .
     4877         end.
     4878         assign
     4879           v-diasize-proc-name = entry(1, program-name(2), '.')
     4880         .
     4881         if v-diasize-wndstore = true
     4882         then do:
     4883           assign
     4884             v-restore-saved = false
     4885           .
     4886           if connected("ub") = true
     4887           then do:
     4888             run gbl/wndsizer.p
     4889               (input  v-cntxt-db-num
     4890               ,input  v-cntxt-userid
     4891               ,input  v-diasize-proc-name
     4892               ,input  'height':u
     4893               ,output v-resize-value-str
     4894               ) .
     4895             if v-resize-value-str <> '':U
     4896             then do:
     4897               run diasize_change-height in this-procedure
     4898                 (input  integer(v-resize-value-str)
     4899                 ,input  true
     4900                 ) .
     4901               assign
     4902                 v-restore-saved = true
     4903               .
     4904             end.
     4905           end.
     4906           if connected("ub") = true
     4907           then do:
     4908             run gbl/wndsizer.p
     4909               (input  v-cntxt-db-num
     4910               ,input  v-cntxt-userid
     4911               ,input  v-diasize-proc-name
     4912               ,input  'width':u
     4913               ,output v-resize-value-str
     4914               ) .
     4915             if v-resize-value-str <> '':U
     4916             then do:
     4917               run diasize_change-width in this-procedure
     4918                 (input  integer(v-resize-value-str)
     4919                 ,input  true
     4920                 ) .
     4921               assign
     4922                 v-restore-saved = true
     4923               .
     4924             end.
     4925           end.
     4926           if v-restore-saved <> true
     4927           then do:
     4928             if v-diasize-wndmax = true
     4929             then do:
     4930               run diasize_maximize in this-procedure
     4931                 (input  true
     4932                 ) .
     4933             end.
     4934           end.
     4935         end.
     4936         else do:
     4937           if v-diasize-wndmax = true
     4938           then do:
     4939             run diasize_maximize in this-procedure
     4940               (input  true
     4941               ) .
     4942           end.
     4943         end.
     4944       end.
     4945     end.
     4946   end procedure.
     4947   procedure diasize_need-full-display :
     4948     define output parameter p-need-full-display as logical   no-undo .
     4949     do
     4950     on error undo, return error return-value
     4951     :
     4952       assign
     4953         p-need-full-display = v-diasize-need-full-display
     4954       .
     4955       assign
     4956         v-diasize-need-full-display = false
     4957       .
     4958     end.
     4959   end procedure.
     4960   procedure get-context :
     4961      define output parameter p-db-num as integer          no-undo.
     4962      define output parameter p-user-id as character        no-undo.
     4963      define variable v-login               as character    no-undo.
     4964      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4965      define buffer buf_user-login  for ub.user-login .
     4966      do
     4967      on error undo, return error
     4968      :
     4969            FIND FIRST buf_sys-ctrl no-lock.
     4970            ASSIGN
     4971               v-login = USERID("ub")
     4972               p-db-num = buf_sys-ctrl.db-num
     4973            .
     4974            FIND FIRST buf_user-login
     4975                 WHERE buf_user-login.db-num = p-db-num
     4976                   AND buf_user-login.user-login = v-login
     4977                 no-lock
     4978                 no-error
     4979                 .
     4980            IF AVAILABLE buf_user-login
     4981            THEN DO:
     4982               assign
     4983                  p-user-id = buf_user-login.user-id
     4984               .
     4985            END.
     4986      end.
     4987   end procedure.
     4988       run diasize_init in this-procedure .
     4989   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4990   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     4991     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     4992     return no-apply.
     4993   end.
     4994   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4995   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4996   MAIN-BLOCK:
     4997   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4998      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4999       run init-fields in this-procedure .
     5000       RUN enable_UI.
     5001       run manage-fields in this-procedure .
     5002       disable
     5003           tb-filter
     5004       with frame Dialog-Frame.
     5005     WAIT-FOR GO OF FRAME Dialog-Frame.
     5006   END.
     5007   RUN disable_UI.
     5008   PROCEDURE assign-field-filter-mark :
     5009   define input parameter p-name-filter    as character        no-undo.
     5010   define input parameter p-login-filter    as character        no-undo.
     5011       define buffer buf_user-account          for user-account.
     5012       define buffer buf_user-login            for user-login.
     5013       define buffer buf_temp_filter-fields    for temp_filter-fields.
     5014   do
     5015   for buf_user-account
     5016     , buf_user-login
     5017     , buf_temp_filter-fields
     5018   on error undo, return error
     5019   :
     5020       for each buf_user-account no-lock
     5021       :
     5022           find first buf_temp_filter-fields
     5023                where buf_temp_filter-fields.user-id = buf_user-account.user-id
     5024           no-error.
     5025           if not available buf_temp_filter-fields
     5026           then do:
     5027               create buf_temp_filter-fields.
     5028               assign
     5029                   buf_temp_filter-fields.user-id              = buf_user-account.user-id
     5030               .
     5031           end.
     5032           assign
     5033               buf_temp_filter-fields.fld-record-visible = yes
     5034           .
     5035           if cb-db >= 0
     5036           then do:
     5037               find first buf_user-login no-lock
     5038                    where buf_user-login.user-id = buf_user-account.user-id
     5039                      and buf_user-login.db-num  = cb-db
     5040               no-error.
     5041               if not available buf_user-login
     5042               then do:
     5043                   assign
     5044                       buf_temp_filter-fields.fld-record-visible = no
     5045                   .
     5046               end.
     5047           end.
     5048       end.
     5049   end.
     5050   END PROCEDURE.
     5051   PROCEDURE disable_UI :
     5052     HIDE FRAME Dialog-Frame.
     5053   END PROCEDURE.
     5054   PROCEDURE duplicate-user :
     5055   define input parameter p-user-id    as character        no-undo.
     5056   define input parameter p-db-num     as integer          no-undo.
     5057   define output parameter p-rowid     as rowid            no-undo.
     5058   define output parameter p-success   as logical          no-undo.
     5059       define variable v-new-name      as character    no-undo.
     5060       define variable v-new-nick      as character    no-undo.
     5061       define variable v-new-login     as character    no-undo.
     5062       define variable v-success       as logical      no-undo.
     5063       define variable v-user-rowid    as rowid        no-undo.
     5064       define variable v-next-user-id as character no-undo .
     5065       define variable v-user-menu-group-code    as integer      no-undo.
     5066       define variable v-user-login-role-code    as integer      no-undo.
     5067       define buffer buf_user-account              for user-account .
     5068       define buffer buf_user-login                for user-login .
     5069       define buffer buf_user-obj                  for user-obj .
     5070       define buffer buf_user-host                 for user-host .
     5071       define buffer buf_user-menu-group           for user-menu-group .
     5072       define buffer buf_user-login-action-role    for user-login-action-role .
     5073       define buffer new_user-account              for user-account .
     5074       define buffer new_user-login                for user-login .
     5075       define buffer new_user-obj                  for user-obj .
     5076       define buffer new_user-host                 for user-host .
     5077       define buffer new_user-menu-group           for user-menu-group .
     5078       define buffer new_user-login-action-role    for user-login-action-role .
     5079   do
     5080   for buf_user-account
     5081     , buf_user-login
     5082     , buf_user-obj
     5083     , buf_user-host
     5084     , buf_user-menu-group
     5085     , buf_user-login-action-role
     5086     , new_user-account
     5087     , new_user-login
     5088     , new_user-obj
     5089     , new_user-host
     5090     , new_user-menu-group
     5091     , new_user-login-action-role
     5092   on error undo, return error
     5093   :
     5094       find first buf_user-account exclusive-lock
     5095            where buf_user-account.user-id = p-user-id
     5096       no-error.
     5097       if not available buf_user-account
     5098       then do:
     5099           message
     5100               "Запись пользователя редактируется администратором."
     5101               skip (1)
     5102               skip "Повторите операцию через некоторое время."
     5103           view-as alert-box warning.
     5104           undo, return error .
     5105       end.
     5106       assign
     5107           v-user-rowid = rowid( buf_user-account )
     5108       .
     5109       find first buf_user-account share-lock
     5110            where buf_user-account.user-id = p-user-id
     5111       .
     5112       run get-new-name in this-procedure (
     5113             input p-user-id
     5114           , input p-db-num
     5115           , output v-new-name
     5116           , output v-new-nick
     5117           , output v-new-login
     5118           , output v-success
     5119       ) no-error.
     5120       if error-status :error
     5121       then do:
     5122           message
     5123                       vss-workfile vss-revision vss-description
     5124               skip(1)
     5125               skip "Ошибка выбора имени нового"
     5126               skip "пользователя для копирования."
     5127               skip return-value
     5128               skip trim( error-status :get-message( 1 ) )
     5129                       trim( error-status :get-message( 2 ) )
     5130                       trim( error-status :get-message( 3 ) )
     5131           view-as alert-box error.
     5132           undo, return error.
     5133       end.
     5134       if v-success = no
     5135       then do:
     5136           message
     5137               "Не удалось создать копию"
     5138               skip "пользователя и логина"
     5139               skip "в текущей базе данных"
     5140           view-as alert-box warning
     5141           title "Копирование пользователя".
     5142           undo, return .
     5143       end.
     5144       message
     5145                   "Текущий пользователь и его логин"
     5146           skip "для текущей базы данных"
     5147           skip "с правами в текущей базе данных"
     5148           skip "будут скопированы как:"
     5149           skip (1)
     5150           skip substitute( "Фамилия:      &1", v-new-name  )
     5151           skip substitute( "Псевдоним:    &1", v-new-nick  )
     5152           skip substitute( "Логин (БД&1): &2", v-cntxt-db-num, v-new-login )
     5153           skip (1)
     5154           skip "Копировать пользователя?"
     5155           view-as alert-box question
     5156           buttons yes-no
     5157           title "Копирование пользователя"
     5158           update v-ok.
     5159       if v-ok = yes
     5160       then do:
     5161   if session :set-wait-state( "compiler" ) then.
     5162           assign
     5163                   v-next-user-id  = substitute( "&1-&2":U
     5164                                           , p-db-num
     5165                                           , next-value( s-user-id ) )
     5166           .
     5167           find first new_user-account exclusive-lock
     5168                where new_user-account.user-id = v-next-user-id
     5169           no-error.
     5170           if available new_user-account
     5171           then do:
     5172                   undo, return error substitute( "Ошибка при создании пользователя (buf_init_user-account).&1Попытка создания записи с существующим кодом.&1.Код записи: &2"
     5173                                                       , chr(10)
     5174                                                       , v-next-user-id  ).
     5175           end.
     5176           create new_user-account .
     5177           assign
     5178                   new_user-account.user-id   = v-next-user-id
     5179                   new_user-account.last-name = v-new-name
     5180                   new_user-account.nik       = v-new-nick
     5181           .
     5182           buffer-copy buf_user-account
     5183               except user-id last-name nik
     5184                   to new_user-account
     5185                   .
     5186           if v-new-login <> "":U
     5187           then do:
     5188               find first buf_user-login no-lock
     5189                    where buf_user-login.user-id = p-user-id
     5190                      and buf_user-login.db-num  = p-db-num
     5191               no-error
     5192               .
     5193               if not available buf_user-login
     5194               then do:
     5195                   message
     5196                       "Логин пользователя редактируется администратором."
     5197                       skip (1)
     5198                       skip substitute( "Пользователь: &1", buf_user-account.nik )
     5199                       skip substitute( "БД:           &1", p-db-num             )
     5200                       skip (1)
     5201                       skip "Повторите операцию через некоторое время."
     5202                   view-as alert-box warning.
     5203                   undo, return error .
     5204               end.
     5205               create new_user-login.
     5206               buffer-copy buf_user-login
     5207                   except user-id db-num user-login  user-administrator
     5208                       to new_user-login
     5209               assign
     5210                       new_user-login.user-login       = v-new-login
     5211                       new_user-login.user-id          = v-next-user-id
     5212                       new_user-login.db-num           = p-db-num
     5213               .
     5214               FOR EACH  buf_user-obj no-lock
     5215                   where buf_user-obj.db-num  = buf_user-login.db-num
     5216                       and buf_user-obj.user-id = buf_user-login.user-id
     5217               :
     5218                   create new_user-obj.
     5219                   assign
     5220                       new_user-obj.user-id  = v-next-user-id
     5221                       new_user-obj.db-num   = p-db-num
     5222                       new_user-obj.obj-type = buf_user-obj.obj-type
     5223                       new_user-obj.obj-code = buf_user-obj.obj-code
     5224                   .
     5225                   buffer-copy buf_user-obj
     5226                   except db-num user-id obj-type obj-code
     5227                           to new_user-obj
     5228                           .
     5229               end.
     5230               FOR EACH buf_user-host
     5231                  where buf_user-host.db-num  = buf_user-login.db-num
     5232                    and buf_user-host.user-id = buf_user-login.user-id
     5233                   no-lock
     5234                   :
     5235                       create new_user-host.
     5236                       assign
     5237                           new_user-host.user-id   = v-next-user-id
     5238                           new_user-host.db-num    = p-db-num
     5239                           new_user-host.host-code = buf_user-host.host-code
     5240                       .
     5241                       buffer-copy buf_user-host
     5242                       except db-num user-id host-code
     5243                               to new_user-host
     5244                               .
     5245               end.
     5246               FOR EACH  buf_user-menu-group
     5247                   where buf_user-menu-group.db-num  = buf_user-login.db-num
     5248                       and buf_user-menu-group.user-id = buf_user-login.user-id
     5249                   no-lock
     5250                   :
     5251                       assign
     5252                       v-user-menu-group-code = next-value(s-user-menu-group)
     5253                       .
     5254                       create new_user-menu-group.
     5255                       assign
     5256                           new_user-menu-group.user-id  = v-next-user-id
     5257                           new_user-menu-group.db-num   = p-db-num
     5258                           new_user-menu-group.user-menu-group-code = v-user-menu-group-code
     5259                       .
     5260                       buffer-copy buf_user-menu-group
     5261                           except db-num user-id user-menu-group-code
     5262                               to new_user-menu-group
     5263                               .
     5264               end.
     5265               FOR EACH  buf_user-login-action-role
     5266                   where buf_user-login-action-role.db-num  = buf_user-login.db-num
     5267                       and buf_user-login-action-role.user-id = buf_user-login.user-id
     5268                   no-lock
     5269                   :
     5270                       assign
     5271                       v-user-login-role-code = next-value(s-user-login-action-role)
     5272                       .
     5273                       create new_user-login-action-role.
     5274                       assign
     5275                       new_user-login-action-role.user-id  = v-next-user-id
     5276                       new_user-login-action-role.db-num   = p-db-num
     5277                       new_user-login-action-role.user-login-role-code = v-user-login-role-code
     5278                       .
     5279                       buffer-copy buf_user-login-action-role
     5280                       except db-num user-id user-login-role-code
     5281                               to new_user-login-action-role
     5282                               .
     5283               end.
     5284           end.
     5285   if session :set-wait-state( "" ) then.
     5286           assign
     5287               p-rowid     = rowid( new_user-account )
     5288               p-success   = yes
     5289           .
     5290      end.
     5291   end.
     5292   END PROCEDURE.
     5293   PROCEDURE enable_UI :
     5294     DISPLAY cb-db fi-filter-comment tb-filter rs-scope ed-login-object
     5295             ed-user-info
     5296         WITH FRAME Dialog-Frame.
     5297     ENABLE b-exit cb-db b-filter fi-filter-comment tb-filter b-hist b-print b-help
     5298            rs-scope b-add b-chg b-dup b-del b-userhist b-hist-user b-add-2
     5299            b-chg-2 b-del-2 bt-password br-user br-login bt-object bt-firm bt-role
     5300            bt-menu ed-login-object ed-user-info
     5301         WITH FRAME Dialog-Frame.
     5302     VIEW FRAME Dialog-Frame.
     5303     run open-query-login in this-procedure.    run open-query in this-procedure ( input this-procedure ).
     5304   END PROCEDURE.
     5305   PROCEDURE get-new-name :
     5306   define input parameter p-user-id        as character        no-undo.
     5307   define input parameter p-db-num         as integer          no-undo.
     5308   define output parameter p-new-name      as character        no-undo.
     5309   define output parameter p-new-nick      as character        no-undo.
     5310   define output parameter p-new-login     as character        no-undo.
     5311   define output parameter p-success       as logical          no-undo.
     5312       define variable v-counter           as integer      no-undo.
     5313       define variable v-ini-login         as character    no-undo.
     5314       define variable v-ini-name          as character    no-undo.
     5315       define variable v-ini-nick          as character    no-undo.
     5316       define buffer buf_user-account      for user-account.
     5317       define buffer buf_nick_user-account for user-account.
     5318       define buffer buf_user-login        for user-login.
     5319   do
     5320   for buf_user-account
     5321     , buf_nick_user-account
     5322     , buf_user-login
     5323   on error undo, return error
     5324   :
     5325       find first buf_user-account no-lock
     5326            where buf_user-account.user-id = p-user-id
     5327       .
     5328       assign
     5329           v-ini-name  = buf_user-account.last-name
     5330           v-ini-nick  = buf_user-account.nik
     5331           p-new-name  = substitute( "Копия_&1", buf_user-account.last-name )
     5332           p-new-nick  = substitute( "Копия_&1", buf_user-account.nik       )
     5333       .
     5334       find first buf_user-login no-lock
     5335            where buf_user-login.db-num    = p-db-num
     5336              and buf_user-login.user-id   = buf_user-account.user-id
     5337       no-error.
     5338       if not available buf_user-login
     5339       then do:
     5340           assign
     5341               v-ini-login = "":U
     5342               p-new-login = "":U
     5343           .
     5344       end.
     5345       else do:
     5346           assign
     5347               v-ini-login = buf_user-login.user-login
     5348               p-new-login = substitute( "Копия_&1", buf_user-login.user-login )
     5349           .
     5350       end.
     5351       assign
     5352           v-counter        = 1
     5353       .
     5354       find first buf_user-account no-lock
     5355            where buf_user-account.last-name = p-new-name
     5356       no-error.
     5357       find first buf_nick_user-account no-lock
     5358            where buf_nick_user-account.last-name = p-new-nick
     5359       no-error.
     5360       if p-new-login <> "":U
     5361       then do:
     5362           find first buf_user-login no-lock
     5363                where buf_user-login.user-login  = p-new-login
     5364           no-error.
     5365       end.
     5366       do
     5367       while available buf_user-account
     5368       or available buf_nick_user-account
     5369       or ( p-new-login <> "":U and available buf_user-login )
     5370       :
     5371           assign
     5372               v-counter           = v-counter + 1
     5373               p-new-name     = substitute( "Копия(&1)_&2", v-counter, v-ini-name  )
     5374               p-new-nick     = substitute( "Копия(&1)_&2", v-counter, v-ini-nick  )
     5375               p-new-login    = substitute( "Копия(&1)_&2", v-counter, v-ini-login )
     5376           .
     5377           find first buf_user-account no-lock
     5378                where buf_user-account.last-name = p-new-name
     5379           no-error.
     5380           find first buf_nick_user-account no-lock
     5381                where buf_nick_user-account.last-name = p-new-nick
     5382           no-error.
     5383           if p-new-login <> "":U
     5384           then do:
     5385               find first buf_user-login no-lock
     5386                    where buf_user-login.user-login  = p-new-login
     5387               no-error.
     5388           end.
     5389       end.
     5390       assign
     5391           p-success   = yes
     5392       .
     5393   end.
     5394   END PROCEDURE.
     5395   PROCEDURE assign-filter-mark :
     5396   define input parameter p-name-filter    as character        no-undo.
     5397   define input parameter p-login-filter    as character        no-undo.
     5398       define buffer buf_user-account          for user-account.
     5399       define buffer buf_user-login            for user-login.
     5400       define buffer buf_temp_filter-fields    for temp_filter-fields.
     5401   do
     5402   for buf_user-account
     5403     , buf_user-login
     5404     , buf_temp_filter-fields
     5405   on error undo, return error
     5406   :
     5407       for each buf_user-account no-lock
     5408       :
     5409           find first buf_temp_filter-fields
     5410                where buf_temp_filter-fields.user-id = buf_user-account.user-id
     5411           no-error.
     5412           if not available buf_temp_filter-fields
     5413           then do:
     5414               create buf_temp_filter-fields.
     5415               assign
     5416                   buf_temp_filter-fields.user-id              = buf_user-account.user-id
     5417                   buf_temp_filter-fields.flt-record-visible   = no
     5418               .
     5419           end.
     5420           if ( p-name-filter = "":U and p-login-filter = "":U )
     5421           or index( buf_user-account.last-name,  p-name-filter ) <> 0
     5422           or index( buf_user-account.first-name, p-name-filter ) <> 0
     5423           then do:
     5424               assign
     5425                   buf_temp_filter-fields.flt-record-visible = yes
     5426               .
     5427           end.
     5428           else do:
     5429               assign
     5430                   buf_temp_filter-fields.flt-record-visible = no
     5431               .
     5432               search-in-login:
     5433               for each buf_user-login no-lock
     5434                  where buf_user-login.user-id = buf_user-account.user-id
     5435               :
     5436                   if index( buf_user-login.user-login, p-login-filter ) <> 0
     5437                   then do:
     5438                       assign
     5439                           buf_temp_filter-fields.flt-record-visible = yes
     5440                       .
     5441                   end.
     5442                   leave search-in-login.
     5443               end.
     5444           end.
     5445       end.
     5446   end.
     5447   END PROCEDURE.
     5448   PROCEDURE get-saved-position :
     5449       define variable v-current-rowid-string      as character    no-undo.
     5450       define variable v-current-focus-string      as character    no-undo.
     5451       define variable v-current-db-string         as character    no-undo.
     5452       define variable v-current-status-string     as character    no-undo.
     5453       define variable v-void-logical              as logical      no-undo.
     5454       define variable v-void-character            as character    no-undo.
     5455   do
     5456   on error undo, return error
     5457   :
     5458      run uf-get (
     5459           input 'users-1':U
     5460         , input  v-cntxt-userid
     5461         , output v-current-status-string
     5462         , output v-current-db-string
     5463         , output v-void-logical
     5464         , output v-void-logical
     5465         , output v-void-logical
     5466         , output v-void-logical
     5467      ) .
     5468      run uf-get (
     5469              input 'users-2':U
     5470            , input  v-cntxt-userid
     5471            , output v-current-focus-string
     5472            , output v-current-rowid-string
     5473            , output v-void-logical
     5474            , output v-void-logical
     5475            , output v-void-logical
     5476            , output v-void-logical
     5477      ) .
     5478      assign
     5479         cb-db                   = IF v-current-db-string <> "":U       THEN integer(  v-current-db-string     ) ELSE cb-db
     5480         rs-scope                = IF v-current-status-string <> "":U   THEN integer(  v-current-status-string ) ELSE rs-scope
     5481         v-users-current-rowid   = IF v-current-rowid-string <> "":U    THEN to-rowid( v-current-rowid-string  ) ELSE v-users-current-rowid
     5482         v-users-current-focus   = IF v-current-focus-string <> "":U    THEN integer(  v-current-focus-string  ) ELSE 1
     5483      .
     5484      IF cb-db = ?
     5485      THEN DO:
     5486         ASSIGN
     5487            cb-db = v-cntxt-db-num
     5488         .
     5489      END.
     5490      IF rs-scope = ?
     5491      THEN DO:
     5492         ASSIGN
     5493            rs-scope    = 1
     5494         .
     5495      END.
     5496   end.
     5497   END PROCEDURE.
     5498   PROCEDURE get-user-fields :
     5499   define input parameter p-user-id                as character        no-undo.
     5500   define output parameter p-last-name             as character        no-undo.
     5501   define output parameter p-first-name            as character        no-undo.
     5502   define output parameter p-second-name           as character        no-undo.
     5503   define output parameter p-nik                   as character        no-undo.
     5504   define output parameter p-phone-number          as character        no-undo.
     5505   define output parameter p-mobile-phone-number   as character        no-undo.
     5506   define output parameter p-company               as character        no-undo.
     5507   define output parameter p-department            as character        no-undo.
     5508   define output parameter p-room                  as character        no-undo.
     5509   define output parameter p-e-mail                as character        no-undo.
     5510   define output parameter p-internal-phone-number as character        no-undo.
     5511   define output parameter p-PS                    as character        no-undo.
     5512       define buffer buf_user-account      for user-account.
     5513   do
     5514   for buf_user-account
     5515   on error undo, return error
     5516   :
     5517       find first buf_user-account no-lock
     5518            where buf_user-account.user-id = p-user-id
     5519       no-error.
     5520       if available buf_user-account
     5521       then do:
     5522           assign
     5523               p-last-name             = buf_user-account.last-name
     5524               p-first-name            = buf_user-account.first-name
     5525               p-second-name           = buf_user-account.second-name
     5526               p-nik                   = buf_user-account.nik
     5527               p-phone-number          = buf_user-account.phone-number
     5528               p-mobile-phone-number   = buf_user-account.mobile-phone-number
     5529               p-company               = buf_user-account.company
     5530               p-department            = buf_user-account.department
     5531               p-room                  = buf_user-account.room
     5532               p-e-mail                = buf_user-account.e-mail
     5533               p-internal-phone-number = buf_user-account.internal-phone-number
     5534               p-PS                    = buf_user-account.PS
     5535           .
     5536       end.
     5537       else do:
     5538           assign
     5539               p-last-name             = "":U
     5540               p-first-name            = "":U
     5541               p-second-name           = "":U
     5542               p-nik                   = "":U
     5543               p-phone-number          = "":U
     5544               p-mobile-phone-number   = "":U
     5545               p-company               = "":U
     5546               p-department            = "":U
     5547               p-room                  = "":U
     5548               p-e-mail                = "":U
     5549               p-internal-phone-number = "":U
     5550               p-PS                    = "":U
     5551           .
     5552       end.
     5553   end.
     5554   END PROCEDURE.
     5555   PROCEDURE init-fields :
     5556       define buffer buf_db                    for db.
     5557       define buffer buf_user-account          for user-account.
     5558       define buffer buf_temp_filter-fields    for temp_filter-fields.
     5559   do
     5560   with frame Dialog-Frame
     5561   on error undo, return error
     5562   :
     5563       assign
     5564           cb-db :delimiter        = chr(4)
     5565           rs-scope    = 1
     5566           cb-db :list-item-pairs = substitute( "&2&1&3"
     5567                                       , chr(4)
     5568                                       , "< Все >"
     5569                                       , -1 )
     5570       .
     5571       if v-cntxt-db-num > 0
     5572       then do:
     5573         for each buf_db
     5574             where buf_db.db-num = v-cntxt-db-num
     5575             no-lock
     5576         on error undo, return error
     5577         :
     5578            assign
     5579                  cb-db :list-item-pairs = substitute ( "&2&1&4 &3&1&4"
     5580                                                      , chr(4)
     5581                                                      , cb-db :list-item-pairs
     5582                                                      , buf_db.db-name
     5583                                                      , buf_db.db-num
     5584                                                      )
     5585            .
     5586         end.
     5587       end.
     5588       else do:
     5589         for each buf_db no-lock
     5590         on error undo, return error
     5591         :
     5592            assign
     5593                  cb-db :list-item-pairs = substitute ( "&2&1&4 &3&1&4"
     5594                                                      , chr(4)
     5595                                                      , cb-db :list-item-pairs
     5596                                                      , buf_db.db-name
     5597                                                      , buf_db.db-num
     5598                                                      )
     5599            .
     5600         end.
     5601       end.
     5602       assign
     5603          cb-db = v-cntxt-db-num
     5604       .
     5605       assign
     5606           v-users-name-filter = "":U
     5607           v-users-login-filter = "":U
     5608           v-users-set-rowid    = yes
     5609       .
     5610       run get-saved-position in this-procedure.
     5611       run assign-field-filter-mark in this-procedure (
     5612             input v-users-name-filter
     5613           , input v-users-login-filter
     5614       ).
     5615       find first user-account-attr where user-account-attr.user-id    eq g#userid
     5616                                      and user-account-attr.attr-code  eq "superadm"
     5617       no-lock no-error.
     5618       if     available user-account-attr
     5619          and logical(user-account-attr.attr-value) eq yes
     5620       then
     5621          mSuperAdm = yes.
     5622   end.
     5623   END PROCEDURE.
     5624   PROCEDURE manage-fields :
     5625   define buffer user-login for user-login.
     5626   do
     5627   with frame Dialog-Frame
     5628   on error undo, return error
     5629   :
     5630       run open-query-login in this-procedure.
     5631       run manage-fields-login in this-procedure .
     5632       define variable vflag as logical no-undo.
     5633       if   available buf_init_user-account
     5634         and buf_init_user-account.user-id eq g#userid
     5635          or mSuperAdm
     5636       then
     5637          vflag = yes.
     5638       else do:
     5639          find first user-login where user-login.user-id eq buf_init_user-account.user-id
     5640                                  and user-login.status_ eq buf_init_user-account.status_
     5641                                  and user-login.user-administrator no-lock no-error.
     5642          vflag = not available user-login.
     5643       end.
     5644       b-chg:sensitive = vflag.
     5645       b-dup:sensitive = true.
     5646       b-del:sensitive = vflag.
     5647       assign
     5648           ed-user-info = "":U
     5649       .
     5650       if available buf_init_user-account
     5651       then do:
     5652           assign
     5653               ed-user-info = trim( substitute( "&1&2&3"
     5654                                   , buf_init_user-account.phone-number
     5655                                   , ( if buf_init_user-account.phone-number = "":U then "":U else ", " )
     5656                                   , buf_init_user-account.mobile-phone-number
     5657                                   ), ", " )
     5658           .
     5659           assign
     5660               ed-user-info = trim( substitute( "&1&2&3"
     5661                                   , ed-user-info
     5662                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5663                                   , buf_init_user-account.company
     5664                                   ), ", " )
     5665           .
     5666           assign
     5667               ed-user-info = trim( substitute( "&1&2&3"
     5668                                   , ed-user-info
     5669                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5670                                   , buf_init_user-account.department
     5671                                   ), ", " )
     5672           .
     5673           assign
     5674               ed-user-info = trim( substitute( "&1&2&3"
     5675                                   , ed-user-info
     5676                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5677                                   , buf_init_user-account.position
     5678                                   ), ", " )
     5679           .
     5680           assign
     5681               ed-user-info = trim( substitute( "&1&2&3"
     5682                                   , ed-user-info
     5683                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5684                                   , buf_init_user-account.room
     5685                                   ), ", " )
     5686           .
     5687           assign
     5688               ed-user-info = trim( substitute( "&1&2&3"
     5689                                   , ed-user-info
     5690                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5691                                   , buf_init_user-account.e-mail
     5692                                   ), ", " )
     5693           .
     5694           assign
     5695               ed-user-info = trim( substitute( "&1&2&3"
     5696                                   , ed-user-info
     5697                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5698                                   , buf_init_user-account.internal-phone-number
     5699                                   ), ", " )
     5700           .
     5701           assign
     5702               ed-user-info = trim( substitute( "&1&2&3"
     5703                                   , ed-user-info
     5704                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5705                                   , buf_init_user-account.internal-phone-number
     5706                                   ), ", " )
     5707           .
     5708           assign
     5709               ed-user-info = trim( substitute( "&1&2&3"
     5710                                   , ed-user-info
     5711                                   , ( if ed-user-info  = "":U then "":U else ", " )
     5712                                   , buf_init_user-account.PS
     5713                                   ), ", " )
     5714           .
     5715           b-del:label = if    not avail buf_init_user-account
     5716                            or buf_init_user-account.status_ eq 0
     5717                         then "Удалить"
     5718                         else "Вост.".
     5719       end.
     5720       display
     5721           ed-user-info
     5722       .
     5723   end.
     5724   END PROCEDURE.
     5725   PROCEDURE manage-fields-login :
     5726       define variable v-host-code    as integer      no-undo.
     5727       define buffer buf_temp_user-login-obj   for temp_user-login-obj.
     5728       define buffer buf_user-obj              for user-obj.
     5729       define buffer buf_user-host             for user-host.
     5730       define buffer buf_clients               for clients.
     5731       define buffer buf_user-login            for user-login.
     5732   do
     5733   for buf_temp_user-login-obj
     5734     , buf_user-obj
     5735     , buf_user-host
     5736     , buf_clients
     5737     , buf_user-login
     5738   with frame Dialog-Frame
     5739   on error undo, return error
     5740   :
     5741       if cb-db > 0
     5742       and available buf_init_user-account
     5743       then do:
     5744           find first buf_init_user-login no-lock
     5745                where buf_init_user-login.db-num  = cb-db
     5746                  and buf_init_user-login.user-id = buf_init_user-account.user-id
     5747           no-error.
     5748           if available buf_init_user-login
     5749           then do:
     5750               reposition br-login to rowid rowid( buf_init_user-login ) no-error.
     5751               apply "value-changed" to br-login.
     5752           end.
     5753       end.
     5754       assign
     5755           ed-login-object = "":U
     5756       .
     5757       b-del-2:label = if    not avail buf_init_user-login
     5758                          or buf_init_user-login.status_ eq 0
     5759                     then "Удалить"
     5760                     else "Вост.".
     5761       empty temp-table buf_temp_user-login-obj.
     5762       if available buf_init_user-login
     5763       then do:
     5764           for each buf_user-obj no-lock
     5765              where buf_user-obj.db-num  = buf_init_user-login.db-num
     5766                and buf_user-obj.user-id = buf_init_user-login.user-id
     5767           :
     5768               find first buf_temp_user-login-obj
     5769                    where buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5770                      and buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5771                      and buf_temp_user-login-obj.obj-type    = buf_user-obj.obj-type
     5772                      and buf_temp_user-login-obj.obj-code    = buf_user-obj.obj-code
     5773               no-error.
     5774               if not available buf_temp_user-login-obj
     5775               then do:
     5776                   find first buf_clients no-lock
     5777                        where buf_clients.obj-type = buf_user-obj.obj-type
     5778                          and buf_clients.obj-code = buf_user-obj.obj-code
     5779                   .
     5780                   create buf_temp_user-login-obj.
     5781                   assign
     5782                       buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5783                       buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5784                       buf_temp_user-login-obj.obj-type    = buf_clients.obj-type
     5785                       buf_temp_user-login-obj.obj-code    = buf_clients.obj-code
     5786                       buf_temp_user-login-obj.host-code   = buf_clients.host-code
     5787                       buf_temp_user-login-obj.obj-name    = substitute( "  &1", buf_clients.obj-name )
     5788                   .
     5789                   assign
     5790                       v-host-code = buf_temp_user-login-obj.host-code
     5791                   .
     5792                   find first buf_temp_user-login-obj
     5793                        where buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5794                          and buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5795                          and buf_temp_user-login-obj.obj-type    = " ":U
     5796                          and buf_temp_user-login-obj.obj-code    = v-host-code
     5797                   no-error.
     5798                   if not available buf_temp_user-login-obj
     5799                   then do:
     5800                       find first buf_clients no-lock
     5801                            where buf_clients.obj-type = 'орг':U
     5802                              and buf_clients.obj-code = v-host-code
     5803                       .
     5804                       create buf_temp_user-login-obj.
     5805                       assign
     5806                           buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5807                           buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5808                           buf_temp_user-login-obj.obj-type    = " ":U
     5809                           buf_temp_user-login-obj.obj-code    = buf_clients.obj-code
     5810                           buf_temp_user-login-obj.host-code   = buf_clients.obj-code
     5811                           buf_temp_user-login-obj.obj-name    = substitute( "&1", buf_clients.obj-name )
     5812                       .
     5813                   end.
     5814               end.
     5815           end.
     5816           for each buf_user-host no-lock
     5817              where buf_user-host.db-num  = buf_init_user-login.db-num
     5818                and buf_user-host.user-id = buf_init_user-login.user-id
     5819           :
     5820               find first buf_temp_user-login-obj
     5821                    where buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5822                      and buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5823                      and buf_temp_user-login-obj.obj-type    = " ":U
     5824                      and buf_temp_user-login-obj.obj-code    = buf_user-host.host-code
     5825               no-error.
     5826               if not available buf_temp_user-login-obj
     5827               then do:
     5828                   find first buf_clients no-lock
     5829                        where buf_clients.obj-type = 'орг':U
     5830                          and buf_clients.obj-code = buf_user-host.host-code
     5831                   .
     5832                   create buf_temp_user-login-obj.
     5833                   assign
     5834                       buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5835                       buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5836                       buf_temp_user-login-obj.obj-type    = " ":U
     5837                       buf_temp_user-login-obj.obj-code    = buf_clients.obj-code
     5838                       buf_temp_user-login-obj.host-code   = buf_clients.obj-code
     5839                       buf_temp_user-login-obj.obj-name    = substitute( "&1", buf_clients.obj-name )
     5840                   .
     5841               end.
     5842           end.
     5843           for each buf_temp_user-login-obj
     5844              where buf_temp_user-login-obj.db-num      = buf_init_user-login.db-num
     5845                and buf_temp_user-login-obj.user-id     = buf_init_user-login.user-id
     5846           by buf_temp_user-login-obj.host-code
     5847           by buf_temp_user-login-obj.obj-type
     5848           on error undo, return error
     5849           :
     5850               assign
     5851                   ed-login-object = substitute( "&1&2&3"
     5852                                           , ed-login-object
     5853                                           , ( if ed-login-object = "":U then "":U else chr(10) )
     5854                                           , buf_temp_user-login-obj.obj-name )
     5855               .
     5856           end.
     5857           define variable v-have-login    as logical      no-undo.
     5858           assign
     5859               v-have-login = no
     5860           .
     5861           if buf_init_user-login.db-num = v-cntxt-db-num
     5862           then do:
     5863               assign
     5864                   v-have-login = yes
     5865               .
     5866           end.
     5867           else do:
     5868               search-cur-db-login:
     5869               for each buf_user-login no-lock
     5870                  where buf_user-login.user-id = buf_init_user-login.user-id
     5871               on error undo, return error
     5872               :
     5873                   if buf_user-login.db-num = v-cntxt-db-num
     5874                   then do:
     5875                       assign
     5876                           v-have-login = yes
     5877                       .
     5878                       undo search-cur-db-login, leave search-cur-db-login.
     5879                   end.
     5880               end.
     5881           end.
     5882              FIND FIRST buf_global-state
     5883           NO-LOCK
     5884           .
     5885           FIND FIRST buf_global-state-attr
     5886         WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
     5887            AND buf_global-state-attr.attr-code = "action-gbl"
     5888         NO-LOCK
     5889         NO-error
     5890         .
     5891      IF AVAILABLE buf_global-state-attr
     5892      THEN DO:
     5893        if buf_global-state-attr.attr-value = "yes" then v-action-gbl = yes .
     5894      END.
     5895           if v-have-login = yes and v-cntxt-db-num <> 0
     5896           then do:
     5897               disable
     5898                   b-add-2
     5899                   b-copy
     5900               .
     5901           end.
     5902           else do:
     5903           if v-action-gbl then do:
     5904               enable
     5905                   b-copy
     5906               .
     5907           end.
     5908               enable
     5909                   b-add-2
     5910               .
     5911           end.
     5912           if buf_init_user-login.db-num = v-cntxt-db-num or v-cntxt-db-num = 0
     5913           then do:
     5914              define variable vflag as logical no-undo.
     5915              vflag = mSuperAdm or  not buf_init_user-login.user-administrator or buf_init_user-login.user-id eq g#userid.
     5916                   b-chg-2:sensitive = vflag.
     5917                   b-del-2:sensitive = vflag.
     5918                   bt-password:sensitive = vflag.
     5919                   bt-object:sensitive = vflag.
     5920                   bt-firm:sensitive = vflag.
     5921                   bt-role:sensitive = vflag.
     5922                   bt-menu:sensitive = vflag.
     5923                   if v-cntxt-db-num = 0
     5924                   then
     5925                      b-copy:sensitive = vflag.
     5926           end.
     5927           else do:
     5928               disable
     5929                   b-copy
     5930                   b-chg-2
     5931                   b-del-2
     5932                   bt-password
     5933                   bt-object
     5934                   bt-firm
     5935                   bt-role
     5936                   bt-menu
     5937               .
     5938           end.
     5939       end.
     5940       else do:
     5941           if v-action-gbl then do:
     5942               enable
     5943                   b-copy
     5944               .
     5945           end.
     5946           enable
     5947               b-add-2
     5948           .
     5949           disable
     5950               b-copy
     5951               b-chg-2
     5952               b-del-2
     5953               bt-password
     5954               bt-object
     5955               bt-firm
     5956               bt-role
     5957               bt-menu
     5958           .
     5959       end.
     5960   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5961   do:
     5962     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5963       (input  v-cntxt-db-num
     5964       ,input  v-cntxt-userid
     5965       ,input  0
     5966       ,input  'actn_users-update':U
     5967       ,input  'global':U
     5968       ,input  0
     5969       ,input  '':U
     5970       ,input  0
     5971       ,input  0
     5972       ,input  0
     5973       ,input  0
     5974       ,input  FALSE
     5975       ,output v-ok
     5976       )  .
     5977   end.
     5978       if v-ok = FALSE
     5979       then do:
     5980           disable
     5981               b-add
     5982               b-chg
     5983               b-del
     5984               b-add-2
     5985               b-chg-2
     5986               b-del-2
     5987               bt-password
     5988               b-dup
     5989           .
     5990           assign
     5991               v-only-lookup = TRUE
     5992           .
     5993       end.
     5994       display
     5995           ed-login-object
     5996       .
     5997   end.
     5998   END PROCEDURE.
     5999   PROCEDURE open-query :
     6000       define input parameter p-proc-handle    as handle           no-undo.
     6001   do
     6002   with frame Dialog-Frame
     6003   on error undo, return error
     6004   :
     6005       if v-users-set-rowid = no
     6006       and available buf_init_user-account
     6007       then do:
     6008           assign
     6009               v-users-current-rowid = rowid( buf_init_user-account )
     6010               v-users-current-focus = br-user :focused-row in frame Dialog-Frame
     6011           .
     6012       end.
     6013       else do:
     6014           assign
     6015               v-users-set-rowid = no
     6016           .
     6017       end.
     6018       if fi-filter-comment = "":U
     6019       or tb-filter = no
     6020       then do:
     6021           assign
     6022               fi-filter-comment :bgcolor = GREY_COLOR
     6023           .
     6024       end.
     6025       else do:
     6026           assign
     6027               fi-filter-comment :bgcolor = RED_COLOR
     6028           .
     6029       end.
     6030       case rs-scope
     6031       :
     6032           when 1
     6033           then do:
     6034               OPEN QUERY br-user
     6035                   FOR EACH buf_init_user-account no-lock
     6036                      where buf_init_user-account.status_ <> 1
     6037                    , first temp_filter-fields
     6038                      where temp_filter-fields.user-id   = buf_init_user-account.user-id
     6039                        and temp_filter-fields.fld-record-visible = yes
     6040                        and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6041                         by buf_init_user-account.last-name
     6042                         by buf_init_user-account.first-name
     6043                         by buf_init_user-account.second-name
     6044               .
     6045           end.
     6046           when 2
     6047           then do:
     6048               OPEN QUERY br-user
     6049                   FOR EACH buf_init_user-account no-lock
     6050                    , first temp_filter-fields
     6051                      where temp_filter-fields.user-id   = buf_init_user-account.user-id
     6052                        and temp_filter-fields.fld-record-visible = yes
     6053                        and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6054                         by buf_init_user-account.last-name
     6055                         by buf_init_user-account.first-name
     6056                         by buf_init_user-account.second-name
     6057               .
     6058           end.
     6059           when 3
     6060           then do:
     6061               OPEN QUERY br-user
     6062                   FOR EACH buf_init_user-account no-lock
     6063                      where buf_init_user-account.status_ = 1
     6064                    , first temp_filter-fields
     6065                      where temp_filter-fields.user-id   = buf_init_user-account.user-id
     6066                        and temp_filter-fields.fld-record-visible = yes
     6067                        and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6068                         by buf_init_user-account.last-name
     6069                         by buf_init_user-account.first-name
     6070                         by buf_init_user-account.second-name
     6071               .
     6072           end.
     6073       end case.
     6074       if v-users-current-focus > 0
     6075       then do:
     6076           br-user :set-repositioned-row( v-users-current-focus, "ALWAYS") in frame Dialog-Frame.
     6077       end.
     6078       reposition br-user to rowid v-users-current-rowid no-error.
     6079       if error-status :error
     6080       then do:
     6081           query br-user :handle :get-first( no-lock ).
     6082           reposition br-user to rowid rowid( buf_init_user-account ) no-error.
     6083       end.
     6084       apply "entry" to br-user.
     6085   end.
     6086   END PROCEDURE.
     6087   PROCEDURE open-query-login :
     6088   do
     6089   on error undo, return error
     6090   :
     6091       if available buf_init_user-account
     6092       then do:
     6093           OPEN QUERY br-login
     6094               FOR EACH buf_init_user-login NO-LOCK
     6095                  where buf_init_user-login.user-id = buf_init_user-account.user-id
     6096               by buf_init_user-login.db-num
     6097           INDEXED-REPOSITION.
     6098       end.
     6099       else do:
     6100           OPEN QUERY br-login
     6101               FOR EACH buf_init_user-login NO-LOCK
     6102                  where buf_init_user-login.user-id = "":U
     6103               by buf_init_user-login.db-num
     6104           INDEXED-REPOSITION.
     6105       end.
     6106   end.
     6107   END PROCEDURE.
     6108   PROCEDURE person-user :
     6109   define input parameter  p-rec-user-account as recid            no-undo.
     6110   define output parameter p-ok               as logical          no-undo.
     6111   do
     6112   on error undo, return error
     6113   :
     6114      define buffer buf_user-account      for ub.user-account .
     6115      define buffer buf_clients     for ub.clients .
     6116      define variable recid-person as character no-undo.
     6117      FIND FIRST buf_user-account
     6118           WHERE RECID(buf_user-account) = p-rec-user-account
     6119           NO-LOCK
     6120           .
     6121      IF AVAILABLE buf_user-account
     6122      AND buf_user-account.psn-code <> 0
     6123      AND buf_user-account.psn-code <> ?
     6124      THEN DO:
     6125         FIND FIRST buf_clients
     6126              WHERE buf_clients.obj-code = buf_user-account.psn-code
     6127                and buf_clients.obj-type = 'чел':U
     6128              no-lock
     6129              no-error
     6130              .
     6131         IF AVAILABLE buf_clients
     6132         THEN DO:
     6133            ASSIGN
     6134              recid-person = string( recid( buf_clients ) )
     6135            .
     6136         END.
     6137      END.
     6138      run ref/cli-all.w ( input parparentproc
     6139                        , input "b-sel"
     6140                        , input 'чел':U
     6141                        , input 'все':U
     6142                        , input 'текущие':U
     6143                        , input ?
     6144                        , input ",,,,,,NO,,"
     6145                        , input "lock-cli-type":U
     6146                        , output recid-person
     6147                        ) .
     6148      IF recid-person <> "":U
     6149      THEN DO:
     6150         FIND FIRST buf_clients
     6151              WHERE RECID(buf_clients) = INTEGER(ENTRY(1, recid-person))
     6152              no-lock
     6153              no-error
     6154              .
     6155         IF AVAILABLE buf_clients
     6156         AND buf_user-account.psn-code <> buf_clients.obj-code
     6157         THEN DO TRANSACTION:
     6158            FIND CURRENT buf_user-account
     6159                 EXCLUSIVE-LOCK
     6160                 .
     6161            ASSIGN
     6162               buf_user-account.psn-code = buf_clients.obj-code
     6163               p-ok = yes
     6164            .
     6165            FIND CURRENT buf_user-account
     6166                 NO-LOCK
     6167                 .
     6168         END.
     6169      END.
     6170      ELSE DO:
     6171         IF buf_user-account.psn-code <> ?
     6172         THEN DO TRANSACTION:
     6173            FIND CURRENT buf_user-account
     6174                 EXCLUSIVE-LOCK
     6175                 .
     6176            ASSIGN
     6177               buf_user-account.psn-code = ?
     6178               p-ok = yes
     6179            .
     6180            FIND CURRENT buf_user-account
     6181                 NO-LOCK
     6182                 .
     6183         END.
     6184      END.
     6185      RELEASE buf_user-account.
     6186   end.
     6187   END PROCEDURE.
     6188   PROCEDURE proc-print-list :
     6189     define buffer buf_user-login for ub.user-login .
     6190     define buffer buf_user-account for ub.user-account .
     6191     define VARIABLE v-last-name as character no-undo.
     6192     define VARIABLE v-last-name1 as character no-undo.
     6193     define VARIABLE v-last-name2 as character no-undo.
     6194     define buffer buf_temp_filter-fields    for temp_filter-fields.
     6195   do
     6196   on error undo, return error
     6197   :
     6198     output stream OutStr-html to value(v-report-name-html-list) convert target 'UTF-8' .
     6199     put stream OutStr-html unformatted
     6200       substitute(
     6201       '<!doctype html>
     6202               <html>
     6203                 <head>
     6204                 <meta charset="UTF-8">
     6205                     <!-- Стили документа -->
     6206                 <style>
     6207                      table ~{
     6208                          border-collapse: collapse;
     6209                          width: 900px; 
     6210                      ~}
     6211                      tbody td, th ~{
     6212                          border: 1px solid black;
     6213                          border-collapse: collapse;
     6214                    
     6215                      ~}
     6216             
     6217                 </style>
     6218                 </head>
     6219                   <body>
     6220                     <table orientation="landscape" name="list-users" fit_to_page="true">  <!-- таблица, в которой содержится весь отчет -->
     6221                       <thead>  <!-- Шапка отчета -->
     6222                       <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     6223                         <tr class="set_columns">
     6224                           <td style="width:50px"></td>
     6225                           <td style="width:200px"></td>
     6226                           <td style="width:200px"></td>
     6227                           <td style="width:50px"></td>
     6228                           <td style="width:200px"></td>
     6229                           <td style="width:200px"></td>
     6230                         </tr>
     6231                         <tr>
     6232                           <td colspan="6" style="font-size:16px;font-weight:bold; text-align: center;">Список пользователей</td>
     6233                         </tr>
     6234                       </thead>
     6235                       <tbody> <!-- Здесь начинается таблица отчета -->
     6236                         <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
     6237                           <th style="text-align: center;">ID</th>
     6238                           <th style="text-align: center;">ФИО</th>
     6239                           <th style="text-align: center;">Псевдоним</th>
     6240                           <th style="text-align: center;">Номер БД</th>
     6241                           <th style="text-align: center;">Логин</th>
     6242                           <th style="text-align: center;">Дата/время последнего входа</th>
     6243                         </tr>'
     6244       , chr(123), chr(125)
     6245       ).
     6246   if cb-db <> -1 then do:
     6247       case rs-scope
     6248           :
     6249           when 1 then do:
     6250               message   temp_filter-fields.user-id view-as alert-box.
     6251               FOR EACH buf_init_user-login where temp_filter-fields.user-id =  buf_init_user-login.user-id
     6252                and buf_init_user-account.status_ <> 1
     6253                NO-LOCK:
     6254                 assign
     6255                 v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6256                   create tt-user-login .
     6257                   assign
     6258                   tt-user-login.db-num         = buf_init_user-login.db-num
     6259                   tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6260                   tt-user-login.nik            = buf_init_user-account.nik
     6261                   tt-user-login.user-login     = buf_init_user-login.user-login
     6262                   tt-user-login.users-id       = buf_init_user-login.user-id
     6263                   tt-user-login.last-name      = v-last-name
     6264                   .
     6265               END.
     6266           end.
     6267           when 2 then do:
     6268               FOR EACH buf_init_user-account :
     6269                   FOR EACH  buf_init_user-login where  buf_init_user-account.user-id = buf_init_user-login.user-id
     6270                      AND buf_init_user-login.db-num = cb-db
     6271                      AND temp_filter-fields.fld-record-visible = yes
     6272                      and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6273                         NO-LOCK :
     6274                         assign
     6275                         v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6276                         create tt-user-login .
     6277                         assign
     6278                         tt-user-login.db-num         = buf_init_user-login.db-num
     6279                         tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6280                         tt-user-login.nik            = buf_init_user-account.nik
     6281                         tt-user-login.user-login     = buf_init_user-login.user-login
     6282                         tt-user-login.users-id       = buf_init_user-login.user-id
     6283                         tt-user-login.last-name      = v-last-name
     6284                         .
     6285                       END.
     6286               end.
     6287           end.
     6288           when 3  then do:
     6289               FOR EACH buf_init_user-account WHERE buf_init_user-account.status_ <> 1 no-lock:
     6290                   FOR EACH  buf_init_user-login where  buf_init_user-account.user-id = buf_init_user-login.user-id
     6291                   AND buf_init_user-login.db-num = cb-db
     6292                   AND temp_filter-fields.fld-record-visible = yes
     6293                   and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6294                       NO-LOCK BY buf_init_user-account.nik :
     6295                   assign
     6296                       v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6297                       create tt-user-login .
     6298                       assign
     6299                       tt-user-login.db-num         = buf_init_user-login.db-num
     6300                       tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6301                       tt-user-login.nik            = buf_init_user-account.nik
     6302                       tt-user-login.user-login     = buf_init_user-login.user-login
     6303                       tt-user-login.users-id       = buf_init_user-login.user-id
     6304                       tt-user-login.last-name      = v-last-name
     6305                       .
     6306                       END.
     6307               END.
     6308           end.
     6309       end case.
     6310   END.
     6311    if cb-db = -1 then do:
     6312      FOR EACH buf_init_user-account
     6313         no-lock:
     6314         case rs-scope :
     6315           when 1 then do:
     6316               FOR EACH buf_init_user-login where buf_init_user-account.status_ <> 1
     6317               and buf_init_user-account.user-id = buf_init_user-login.user-id
     6318               and temp_filter-fields.user-id   = buf_init_user-account.user-id
     6319               and temp_filter-fields.fld-record-visible = yes
     6320               and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6321               no-lock:
     6322               assign
     6323               v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6324               create tt-user-login .
     6325               assign
     6326               tt-user-login.db-num         = buf_init_user-login.db-num
     6327               tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6328               tt-user-login.nik            = buf_init_user-account.nik
     6329               tt-user-login.user-login     = buf_init_user-login.user-login
     6330               tt-user-login.users-id       = buf_init_user-login.user-id
     6331               tt-user-login.last-name      = v-last-name
     6332               .
     6333               end.
     6334           end.
     6335           when 2 then do:
     6336               FOR EACH buf_init_user-login where buf_init_user-account.user-id = buf_init_user-login.user-id
     6337                   and temp_filter-fields.fld-record-visible = yes
     6338                   and ( temp_filter-fields.flt-record-visible = yes or tb-filter = no )
     6339                   NO-LOCK:
     6340                   assign
     6341                   v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6342                   create tt-user-login .
     6343                   assign
     6344                   tt-user-login.db-num         = buf_init_user-login.db-num
     6345                   tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6346                   tt-user-login.nik            = buf_init_user-account.nik
     6347                   tt-user-login.user-login     = buf_init_user-login.user-login
     6348                   tt-user-login.users-id       = buf_init_user-login.user-id
     6349                   tt-user-login.last-name      = v-last-name
     6350                   .
     6351               end.
     6352           end.
     6353           when 3  then do:
     6354               FOR EACH buf_init_user-login where buf_init_user-account.status_ = 1
     6355                 and buf_init_user-account.user-id = buf_init_user-login.user-id
     6356                 and temp_filter-fields.user-id   = buf_init_user-account.user-id
     6357                 NO-LOCK:
     6358                    assign
     6359                    v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6360                    create tt-user-login .
     6361                    assign
     6362                     tt-user-login.db-num         = buf_init_user-login.db-num
     6363                     tt-user-login.last-login-mjd = buf_init_user-login.last-login-mjd
     6364                     tt-user-login.nik            = buf_init_user-account.nik
     6365                     tt-user-login.user-login     = buf_init_user-login.user-login
     6366                     tt-user-login.users-id       = buf_init_user-login.user-id
     6367                     tt-user-login.last-name      = v-last-name
     6368                    .
     6369               end.
     6370           end.
     6371         end case.
     6372       end.
     6373   END.
     6374     run prn-lib-reportviewer-report-name in this-procedure (
     6375       input parParentProc
     6376       ,input v-report-name-html-list
     6377       ).
     6378     for each tt-user-login no-lock:
     6379                     put stream OutStr-html unformatted
     6380                     substitute(
     6381                     '<tr>
     6382                               <td>&1</td>
     6383                               <td>&2</td>
     6384                               <td>&3</td>
     6385                               <td>&4</td>
     6386                               <td>&5</td>
     6387                               <td>&6</td>
     6388                      </tr>'
     6389                     ,tt-user-login.users-id
     6390                     ,tt-user-login.last-name
     6391                     ,tt-user-login.nik
     6392                     ,string(tt-user-login.db-num)
     6393                     ,tt-user-login.user-login
     6394                     ,if tt-user-login.last-login-mjd <> 0 then string(sys-time_mjd-to-loc-str-func(tt-user-login.last-login-mjd)) else ""
     6395                     ).
     6396             end.
     6397            output stream OutStr-html close.
     6398   END.
     6399   EMPTY TEMP-TABLE tt-user-login .
     6400   END PROCEDURE.
     6401   PROCEDURE proc-print-prava :
     6402     define buffer buf_user-login-action-role for ub.user-login-action-role .
     6403     define buffer buf_action-role-item       for ub.action-role-item .
     6404     define buffer buf_action-item            for ub.action-item .
     6405     define buffer buf_action-role            for ub.action-role .
     6406     define VARIABLE v-first as LOGICAL no-undo .
     6407     define VARIABLE v-ok2 as LOGICAL no-undo .
     6408     define VARIABLE ii      as integer no-undo .
     6409     define VARIABLE jj      as integer no-undo .
     6410     define VARIABLE v-action-role-context as character no-undo .
     6411     define VARIABLE v-last-name as character no-undo.
     6412     define VARIABLE v-last-name1 as character no-undo.
     6413     define VARIABLE v-last-name2 as character no-undo.
     6414   do
     6415   on error undo, return error
     6416   :
     6417     output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     6418     put stream OutStr-html unformatted
     6419       substitute(
     6420       '<!doctype html>
     6421               <html>
     6422                 <head>
     6423                 <meta charset="UTF-8">
     6424                     <!-- Стили документа -->
     6425                 <style>
     6426                      table ~{
     6427                          border-collapse: collapse;
     6428                          width: 850px; 
     6429                      ~}
     6430                      tbody td, th ~{
     6431                          border: 1px solid black;
     6432                          border-collapse: collapse;
     6433                    height: 14px;
     6434                      ~}
     6435             
     6436                 </style>
     6437                 </head>
     6438                   <body>
     6439                     <table orientation="landscape" name="list_users" fit_to_page="true">  <!-- таблица, в которой содержится весь отчет -->
     6440                       <thead>  <!-- Шапка отчета -->
     6441                       <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     6442                         <tr class="set_columns">
     6443                           <td style="width:200px"></td>
     6444                           <td style="width:200px"></td>
     6445                           <td style="width:50px"></td>
     6446                           <td style="width:200px"></td>
     6447                           <td style="width:200px"></td>
     6448                         </tr>
     6449                         <tr>
     6450                           <td colspan="5" style="font-size:16px;font-weight:bold; text-align: center;">Список прав пользователей</td>
     6451                         </tr>
     6452                       </thead>
     6453                       <tbody> <!-- Здесь начинается таблица отчета -->
     6454                         <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
     6455                           <th style="text-align: center;">ФИО</th>
     6456                           <th style="text-align: center;">Псевдоним</th>
     6457                           <th style="text-align: center;">БД</th>
     6458                           <th style="text-align: center;">Привязка</th>
     6459                           <th style="text-align: center;">Группа</th>
     6460                         </tr>'
     6461       , chr(123), chr(125)
     6462       ).
     6463     get first br-user.
     6464     do while available buf_init_user-account:
     6465     assign ii = 0
     6466            jj = 0
     6467            v-first = no.
     6468            v-last-name = buf_init_user-account.last-name + ' ' + buf_init_user-account.first-name + ' ' + buf_init_user-account.second-name .
     6469         for each buf_init_user-login where buf_init_user-login.user-id = buf_init_user-account.user-id:
     6470             assign v-first = yes
     6471                    v-ok2 = no.
     6472             FOR EACH buf_user-login-action-role
     6473               WHERE buf_user-login-action-role.action-head-code    = 0
     6474               AND buf_user-login-action-role.user-id             = buf_init_user-login.user-id
     6475               NO-LOCK:
     6476                 if not v-action-gbl and buf_user-login-action-role.db-num              <> buf_init_user-login.db-num then next .
     6477                 find FIRST buf_action-role
     6478                   WHERE buf_action-role.action-head-code    = 0
     6479                   AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
     6480                   AND (buf_action-role.db-num              = buf_init_user-login.db-num OR buf_action-role.db-num = 0)
     6481                   AND (buf_init_user-login.db-num          = cb-db or string(cb-db) = '-1')
     6482                   NO-LOCK no-error.
     6483                   if AVAILABLE buf_action-role then do:
     6484                   assign
     6485                     ii = ii + 1
     6486                     jj = jj + 1
     6487                     v-ok2 = yes .
     6488                     if buf_user-login-action-role.action-role-context = 'global':U then do:
     6489                     assign v-action-role-context = "Без привязки". end.
     6490                     if buf_user-login-action-role.action-role-context = 'firm':U then do:
     6491                     assign v-action-role-context = SUBSTITUTE("Фирма &1", string(buf_user-login-action-role.host-code)). end.
     6492                     if buf_user-login-action-role.action-role-context = 'object':U then do:
     6493                     assign v-action-role-context = SUBSTITUTE("&1 &2", buf_user-login-action-role.obj-type, buf_user-login-action-role.obj-code).
     6494                     end.
     6495                   put stream OutStr-html unformatted
     6496                     substitute(
     6497                     '<tr>
     6498                               <td>&1</td>
     6499                               <td>&2</td>
     6500                               <td>&3</td>
     6501                               <td>&4</td>
     6502                               <td>&5</td>
     6503                      </tr>'
     6504                     ,
     6505                     if ii > 1 or jj > 1 then "" else string(v-last-name),
     6506                     if ii > 1 or jj > 1 then "" else string(buf_init_user-account.nik),
     6507                     if ii > 1 or jj > 1 then "" else string(buf_init_user-login.db-num),
     6508                     string(v-action-role-context),
     6509                     string(buf_action-role.action-role-name)
     6510                     ).
     6511                     end.
     6512                     else
     6513                     if (buf_init_user-login.db-num          = cb-db or string(cb-db) = '-1') then do:
     6514                     put stream OutStr-html unformatted
     6515                             substitute(
     6516                             '<tr>
     6517                                       <td>&1</td>
     6518                                       <td>&2</td>
     6519                                       <td>&3</td>
     6520                                       <td></td>
     6521                                       <td></td>
     6522                              </tr>'
     6523                             ,
     6524                             if ii > 1 or jj > 1 then "" else string(v-last-name),
     6525                             if ii > 1 or jj > 1 then "" else string(buf_init_user-account.nik),
     6526                             if ii > 1 or jj > 1 then "" else string(buf_init_user-login.db-num)
     6527                             ).
     6528                     end.
     6529             end.
     6530             if v-ok2 = no and (buf_init_user-login.db-num = cb-db or string(cb-db) = '-1') then
     6531             do:
     6532               put stream OutStr-html unformatted
     6533                 substitute(
     6534                 '<tr>
     6535                                               <td>&1</td>
     6536                                               <td>&2</td>
     6537                                               <td>&3</td>
     6538                                               <td></td>
     6539                                               <td></td>
     6540                       </tr>'
     6541                 ,
     6542                 (v-last-name),
     6543                 (buf_init_user-account.nik),
     6544                 (buf_init_user-login.db-num)
     6545                 ).
     6546             end.
     6547         end.
     6548         if v-first = no then do:
     6549         put stream OutStr-html unformatted
     6550           substitute(
     6551           '<tr>
     6552                 <td>&1</td>
     6553                 <td>&2</td>
     6554                 <td></td>
     6555                 <td></td>
     6556                 <td></td>
     6557           </tr>'
     6558           ,
     6559           (v-last-name),
     6560           (buf_init_user-account.nik)
     6561           ).
     6562         end.
     6563       get next br-user.
     6564     end.
     6565            output stream OutStr-html close.
     6566     run prn-lib-reportviewer-report-name in this-procedure (
     6567       input parParentProc
     6568       ,input v-report-name-html
     6569       ).
     6570   end.
     6571   END PROCEDURE.
     6572   PROCEDURE procedure-get-person-name :
     6573   define input  parameter p-psn-code    as integer   no-undo .
     6574   define output parameter p-person-name as character no-undo .
     6575   define buffer buf_person      for ub.person .
     6576   define buffer buf_clients     for ub.clients .
     6577   do
     6578   on error undo, return error return-value
     6579   :
     6580       assign
     6581           p-person-name = "":U
     6582       .
     6583       IF p-psn-code = ?
     6584       THEN DO:
     6585           assign
     6586               p-person-name = "Нет привязки к физическому лицу"
     6587           .
     6588       END.
     6589       ELSE DO:
     6590         FIND FIRST buf_person
     6591              WHERE buf_person.psn-code = p-psn-code
     6592              no-lock
     6593              no-error
     6594              .
     6595         FIND FIRST buf_clients
     6596              WHERE buf_clients.obj-type = 'чел':U
     6597                AND buf_clients.obj-code = p-psn-code
     6598              no-lock
     6599              no-error
     6600              .
     6601         IF AVAILABLE buf_person
     6602         THEN DO:
     6603            assign
     6604                  p-person-name = SUBSTITUTE ( "&1 &2&3&4&5"
     6605                                             , buf_clients.obj-name
     6606                                             , IF buf_person.name1 <>"":U THEN SUBSTRING(buf_person.name1, 1, 1) ELSE "":U
     6607                                             , IF buf_person.name1 <>"":U THEN ". " ELSE "":U
     6608                                             , IF buf_person.name2 <>"":U THEN SUBSTRING(buf_person.name2, 1, 1) ELSE "":U
     6609                                             , IF buf_person.name2 <>"":U THEN ". " ELSE "":U
     6610                                             )
     6611            .
     6612         END.
     6613         ELSE DO:
     6614           assign
     6615               p-person-name = SUBSTITUTE("Потеряна привязка к физ. лицу (&1)", p-psn-code)
     6616           .
     6617         END.
     6618       END.
     6619   end.
     6620   END PROCEDURE.
     6621   PROCEDURE procedure-user-login-action-role :
     6622   define input parameter p-db-num         as integer          no-undo.
     6623   define input parameter p-user-id        as character        no-undo.
     6624       define variable v-user-adm as logical   no-undo .
     6625   do
     6626   on error undo, return error
     6627   :
     6628   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6629   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run user-adm in g#library2
     6630     (input  p-db-num
     6631     ,input  p-user-id
     6632     ,output v-user-adm
     6633     )  .
     6634       if v-user-adm
     6635       then do:
     6636            message "Пользователь - администратор. Ему доступны ВСЕ права." skip
     6637                    "Добавление новых никак не скажется на его работе. Продолжить?" skip
     6638                    view-as alert-box
     6639                    buttons yes-no
     6640                    update v-yes as logical
     6641                    .
     6642            if v-yes = yes
     6643            then do:
     6644               run str/useractn.w (
     6645                     input parparentproc
     6646                   , input buf_init_user-account.user-id
     6647                   , input p-db-num
     6648               ).
     6649            end.
     6650       end.
     6651       else do:
     6652           run str/useractn.w (
     6653                 input parparentproc
     6654               , input buf_init_user-account.user-id
     6655               , input p-db-num
     6656           ).
     6657       end.
     6658   end.
     6659   END PROCEDURE.
     6660   PROCEDURE procedure-user-login-copy :
     6661   define input parameter p-db-num         as integer          no-undo.
     6662   define input parameter p-user-id        as character        no-undo.
     6663     define variable v-can-edit as logical   no-undo .
     6664     define buffer buf_user-account    for user-account.
     6665     define buffer buf_user-login      for ub.user-login .
     6666   do
     6667   for buf_user-account
     6668     , buf_user-login
     6669   on error undo, return error return-value
     6670   :
     6671     find first buf_user-account no-lock
     6672       where buf_user-account.user-id = p-user-id
     6673       no-error.
     6674     if available (buf_user-account) then
     6675     do:
     6676       if buf_user-account.status_ = 1 then
     6677       do:
     6678         message "Пользователь удален. Копирование логина невозможно"
     6679           view-as alert-box.
     6680         return no-apply .
     6681       end.
     6682     end.
     6683       do transaction
     6684       on error undo, return error return-value
     6685       :
     6686           find first buf_user-login exclusive-lock
     6687                where buf_user-login.db-num  = p-db-num
     6688                  and buf_user-login.user-id = p-user-id
     6689           no-error no-wait.
     6690           if not available buf_user-login
     6691           then do:
     6692               if locked( buf_user-login )
     6693               then do:
     6694                   find first buf_user-login no-lock
     6695                        where buf_user-login.db-num  = p-db-num
     6696                          and buf_user-login.user-id = p-user-id
     6697                   .
     6698                   find first buf_user-account no-lock
     6699                        where buf_user-account.user-id = p-user-id
     6700                   .
     6701                   message
     6702                       "Редактирование логина невозможно" skip
     6703                       "Пользователь в данный момент работает в системе" skip
     6704                       "БД" p-db-num skip
     6705                       "Идентификатор" p-user-id skip
     6706                       "Псевдоним"                    buf_user-account.nik skip
     6707                       "Имя пользователя"             buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name skip
     6708                       "Компьютер"                    buf_user-login.last-login-computer-name skip
     6709                       "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     6710                       "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     6711                       "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     6712                       "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     6713                       "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     6714                       "Дата и время входа в систему" sys-time_mjd-to-loc-str-func(buf_user-login.last-login-mjd) skip
     6715                   view-as alert-box error .
     6716               end.
     6717               else do:
     6718                   message
     6719                       "Редактирование логина невозможно" skip
     6720                       "У пользователя нет логина" skip
     6721                       "БД" p-db-num skip
     6722                       "Идентификатор" buf_init_user-account.user-id skip
     6723                   view-as alert-box error .
     6724               end.
     6725               undo, return error return-value .
     6726           end.
     6727       end.
     6728       define variable v-update-data        as logical   no-undo .
     6729       define variable v-user-login         as character no-undo .
     6730       define variable v-user-administrator as logical   no-undo .
     6731       define variable v-max-discnt         as decimal   no-undo .
     6732       define variable v-quest-print        as logical   no-undo .
     6733       define variable v-tmp-dbnum          as integer   no-undo .
     6734       define variable v-list-db            as character no-undo .
     6735       define variable v-success            as logical   no-undo .
     6736       v-tmp-dbnum = buf_user-login.db-num.
     6737       run str/usrloged2.w (
     6738             input parparentproc
     6739           , input 'ИЗМЕНЕНИЕ':U
     6740           , input-output v-tmp-dbnum
     6741           , input buf_user-login.user-id
     6742           , input buf_user-login.user-login
     6743           , input buf_user-login.user-administrator
     6744           , input buf_user-login.max-discnt
     6745           , input buf_user-login.quest-print
     6746           , output v-list-db
     6747           , output v-update-data
     6748           , output v-user-login
     6749           , output v-user-administrator
     6750           , output v-max-discnt
     6751           , output v-quest-print
     6752       ) .
     6753       if v-list-db = "" then
     6754          return.
     6755              run str/copy-login.p (
     6756                 input buf_user-login.user-id
     6757               , input v-user-login
     6758               , input p-db-num
     6759               , input v-list-db
     6760               , output v-success
     6761           ) no-error.
     6762           if error-status :error
     6763           then do:
     6764               message
     6765                           vss-workfile vss-revision vss-description
     6766                   skip(1)
     6767                   skip "Ошибка копирования логина."
     6768                   skip return-value
     6769                   skip trim( error-status :get-message( 1 ) )
     6770                           trim( error-status :get-message( 2 ) )
     6771                           trim( error-status :get-message( 3 ) )
     6772               view-as alert-box error.
     6773               undo, return no-apply.
     6774           end.
     6775   end.
     6776   END PROCEDURE.
     6777   PROCEDURE procedure-user-login-create :
     6778   define input  parameter iMode       as character no-undo.
     6779   define input  parameter p-db-num     as integer          no-undo.
     6780   define input  parameter p-user-id    as character        no-undo.
     6781   define input  parameter i-adm-gbd    as logical no-undo.
     6782   define input  parameter i-adm-ubd    as logical no-undo.
     6783   define input  parameter i-TabUserAdm as handle no-undo.
     6784   define output parameter p-created    as logical          no-undo.
     6785       define variable v-update-data           as logical      no-undo .
     6786       define variable v-user-login            as character    no-undo .
     6787       define variable v-user-administrator    as logical      no-undo .
     6788       define variable v-max-discnt            as decimal      no-undo .
     6789       define variable v-quest-print           as logical      no-undo .
     6790       define variable v-encoded-pass          as character    no-undo .
     6791       define variable v-nextcon               as logical      no-undo init ? .
     6792       define buffer buf_user-account      for user-account.
     6793       define buffer buf_user-login        for user-login  .
     6794       if imode eq 'ИЗМЕНЕНИЕ':U
     6795       then do:
     6796          find first buf_user-login where  buf_user-login.user-id            = p-user-id
     6797                                      and  buf_user-login.db-num             = p-db-num
     6798          no-lock no-error.
     6799          if available buf_user-login
     6800          then do:
     6801             assign
     6802                v-user-login         = buf_user-login.user-login
     6803                v-user-administrator = buf_user-login.user-administrator
     6804                v-max-discnt         = buf_user-login.max-discnt
     6805                v-quest-print        = buf_user-login.quest-print
     6806                v-encoded-pass       = buf_user-login.user-password-encoded
     6807             .
     6808             find first user-login-attr where user-login-attr.db-num    = buf_user-login.db-num
     6809                                          and user-login-attr.user-id   = buf_user-login.user-id
     6810                                          and user-login-attr.attr-code = "ChangPwdNextConect"
     6811             no-lock no-error.
     6812             v-nextcon = if available user-login-attr then logical(user-login-attr.attr-value) else ? no-error.
     6813             p-created            = i-adm-gbd ne ? or i-adm-ubd ne ? or i-TabUserAdm ne ?.
     6814          end.
     6815          else do:
     6816             find first buf_user-login where  buf_user-login.user-id            = p-user-id
     6817             no-lock no-error.
     6818             if available buf_user-login
     6819             then do:
     6820                assign
     6821                   v-user-login         = buf_user-login.user-login
     6822                   v-max-discnt         = buf_user-login.max-discnt
     6823                   v-quest-print        = buf_user-login.quest-print
     6824                   v-encoded-pass       = buf_user-login.user-password-encoded
     6825                .
     6826                find first user-login-attr where user-login-attr.db-num    = buf_user-login.db-num
     6827                                             and user-login-attr.user-id   = buf_user-login.user-id
     6828                                             and user-login-attr.attr-code = "ChangPwdNextConect"
     6829                no-lock no-error.
     6830                v-nextcon = if available user-login-attr then logical(user-login-attr.attr-value) else ? no-error.
     6831                p-created            = i-adm-gbd ne ? or i-adm-ubd ne ? or i-TabUserAdm ne ?.
     6832            end.
     6833            else do:
     6834               p-db-num = ?.
     6835               run str/usrloged.w (
     6836                      input parparentproc
     6837                    , input 'ИЗМЕНЕНИЕ':U
     6838                    , input-output p-db-num
     6839                    , input p-user-id
     6840                    , input "":U
     6841                    , input false
     6842                    , input 0
     6843                    , input true
     6844                    , output p-created
     6845                    , output v-user-login
     6846                    , output v-user-administrator
     6847                    , output v-max-discnt
     6848                    , output v-quest-print
     6849                ) .
     6850                imode = "'ДОБАВЛЕНИЕ':U".
     6851             end.
     6852          end.
     6853       end.
     6854       else
     6855          run str/usrloged.w (
     6856                input parparentproc
     6857              , input 'ИЗМЕНЕНИЕ':U
     6858              , input-output p-db-num
     6859              , input p-user-id
     6860              , input "":U
     6861              , input false
     6862              , input 0
     6863              , input true
     6864              , output p-created
     6865              , output v-user-login
     6866              , output v-user-administrator
     6867              , output v-max-discnt
     6868              , output v-quest-print
     6869          ) .
     6870       if p-created = yes
     6871       then do:
     6872          if imode ne 'ИЗМЕНЕНИЕ':U
     6873          then do:
     6874             set-correct-password:
     6875             do while yes
     6876             :
     6877                find first buf_user-account no-lock
     6878                     where buf_user-account.user-id = p-user-id
     6879                .
     6880                define variable voneadm as logical no-undo.
     6881                run availOneAdm(input-output table-handle i-TabUserAdm, output voneadm).
     6882                run adm/chg-pswd.w (
     6883                      input parparentproc
     6884                      , input p-db-num
     6885                      , input p-user-id
     6886                      , input v-user-login
     6887                      , input substitute('&1 &2 &3':U,  buf_user-account.last-name
     6888                                                      , buf_user-account.first-name
     6889                                                      , buf_user-account.second-name
     6890                              )
     6891                      , input yes
     6892                      , input yes
     6893                      , input ""
     6894                      , no
     6895                      , i-adm-gbd or i-adm-ubd or voneadm
     6896                      , output v-encoded-pass
     6897                      , output v-nextcon
     6898                ) no-error .
     6899                if error-status :error
     6900                then do:
     6901                   message
     6902                      vss-workfile vss-revision vss-description
     6903                          skip(1)
     6904                          skip "Ошибка при назначении пароля"
     6905                          skip return-value
     6906                          skip trim( error-status :get-message( 1 ) )
     6907                              trim( error-status :get-message( 2 ) )
     6908                              trim( error-status :get-message( 3 ) )
     6909                   view-as alert-box error.
     6910                   undo, return error.
     6911                end.
     6912                if    v-encoded-pass = "":U
     6913                   or v-encoded-pass = ?
     6914                then do:
     6915                   message
     6916                          "Пароль пользователя не может быть пустым."
     6917                          skip "Введите пароль."
     6918                   view-as alert-box warning
     6919                       title "Ввод пароля".
     6920                end.
     6921                else do:
     6922                   leave set-correct-password.
     6923                end.
     6924             end.
     6925          end.
     6926          run update-user-login(p-db-num
     6927                               ,p-user-id
     6928                               ,v-user-login
     6929                               ,v-max-discnt
     6930                               ,v-quest-print
     6931                               ,v-encoded-pass
     6932                               ,v-nextcon
     6933                               ,v-user-administrator
     6934                               ,mSuperAdm and imode ne "add"
     6935                               ,i-adm-gbd
     6936                               ,i-adm-ubd
     6937                               ,input-output table-handle i-TabUserAdm) no-error.
     6938          if error-status:error
     6939          then do:
     6940             message return-value
     6941             view-as alert-box.
     6942             return error.
     6943          end.
     6944       end.
     6945   END PROCEDURE.
     6946   PROCEDURE procedure-user-login-edit :
     6947   define input parameter p-db-num         as integer          no-undo.
     6948   define input parameter p-user-id        as character        no-undo.
     6949     define variable v-can-edit as logical   no-undo .
     6950     define buffer buf_user-account    for user-account.
     6951     define buffer buf_user-login      for ub.user-login .
     6952   do
     6953   for buf_user-account
     6954     , buf_user-login
     6955   on error undo, return error return-value
     6956   :
     6957       run can-edit-login in this-procedure (
     6958             input p-db-num
     6959           , output v-can-edit
     6960       ) .
     6961       if v-can-edit <> true
     6962       then do:
     6963           message
     6964               "Нельзя редактировать логин пользователя для базы" p-db-num
     6965           view-as alert-box error .
     6966           undo, return error return-value .
     6967       end.
     6968       do :
     6969           find first buf_user-login exclusive-lock
     6970                where buf_user-login.db-num  = p-db-num
     6971                  and buf_user-login.user-id = p-user-id
     6972           no-error no-wait.
     6973           if not available buf_user-login
     6974           then do:
     6975               if locked( buf_user-login )
     6976               then do:
     6977                   find first buf_user-login no-lock
     6978                        where buf_user-login.db-num  = p-db-num
     6979                          and buf_user-login.user-id = p-user-id
     6980                   .
     6981                   find first buf_user-account no-lock
     6982                        where buf_user-account.user-id = p-user-id
     6983                   .
     6984                   message
     6985                       "Редактирование логина невозможно" skip
     6986                       "Пользователь в данный момент работает в системе" skip
     6987                       "БД" p-db-num skip
     6988                       "Идентификатор" p-user-id skip
     6989                       "Псевдоним"                    buf_user-account.nik skip
     6990                       "Имя пользователя"             buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name skip
     6991                       "Компьютер"                    buf_user-login.last-login-computer-name skip
     6992                       "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     6993                       "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     6994                       "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     6995                       "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     6996                       "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     6997                       "Дата и время входа в систему" sys-time_mjd-to-loc-str-func(buf_user-login.last-login-mjd) skip
     6998                   view-as alert-box error .
     6999               end.
     7000               else do:
     7001                   message
     7002                       "Редактирование логина невозможно" skip
     7003                       "У пользователя нет логина" skip
     7004                       "БД" p-db-num skip
     7005                       "Идентификатор" buf_init_user-account.user-id skip
     7006                   view-as alert-box error .
     7007               end.
     7008               undo, return error return-value .
     7009           end.
     7010       end.
     7011       define variable v-update-data        as logical   no-undo .
     7012       define variable v-user-login         as character no-undo .
     7013       define variable v-user-administrator as logical   no-undo .
     7014       define variable v-max-discnt         as decimal   no-undo .
     7015       define variable v-quest-print        as logical   no-undo .
     7016       define variable v-tmp-dbnum          as integer   no-undo .
     7017       v-tmp-dbnum = buf_user-login.db-num.
     7018       run str/usrloged.w (
     7019             input parparentproc
     7020           , input 'ИЗМЕНЕНИЕ':U
     7021           , input-output v-tmp-dbnum
     7022           , input buf_user-login.user-id
     7023           , input buf_user-login.user-login
     7024           , input buf_user-login.user-administrator
     7025           , input buf_user-login.max-discnt
     7026           , input buf_user-login.quest-print
     7027           , output v-update-data
     7028           , output v-user-login
     7029           , output v-user-administrator
     7030           , output v-max-discnt
     7031           , output v-quest-print
     7032        ) .
     7033       if v-tmp-dbnum = ? then
     7034          return.
     7035       assign
     7036           buf_user-login.db-num = v-tmp-dbnum
     7037           p-db-num = buf_user-login.db-num.
     7038       if v-update-data = true
     7039       then do:
     7040               find first buf_user-login exclusive-lock
     7041                    where buf_user-login.db-num  = p-db-num
     7042                      and buf_user-login.user-id = p-user-id
     7043               .
     7044               assign
     7045               buf_user-login.user-login         = v-user-login
     7046               buf_user-login.user-administrator = v-user-administrator
     7047               buf_user-login.max-discnt         = v-max-discnt
     7048               buf_user-login.quest-print        = v-quest-print
     7049               .
     7050           end.
     7051       end.
     7052   END PROCEDURE.
     7053   PROCEDURE procedure-user-login-menu-group :
     7054   define input parameter p-db-num         as integer          no-undo.
     7055   define input parameter p-user-id        as character        no-undo.
     7056       define variable v-can-edit as logical   no-undo .
     7057       define variable v-user-adm as logical   no-undo .
     7058       define buffer buf_user-login    for ub.user-login .
     7059       define buffer buf_user-account  for user-account.
     7060   do
     7061   for buf_user-login
     7062   on error undo, return error
     7063   :
     7064   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7065   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run user-adm in g#library2
     7066     (input  p-db-num
     7067     ,input  p-user-id
     7068     ,output v-user-adm
     7069     )  .
     7070         if v-user-adm = yes
     7071         then do:
     7072            message "Пользователь - администратор. Ему доступны ВСЕ группы меню." skip
     7073                    "Добавление новых никак не скажется на его работе. Продолжить?" skip
     7074                    view-as alert-box
     7075                    buttons yes-no
     7076                    update v-yes as logical
     7077                    .
     7078            if v-yes = no
     7079            then do:
     7080               return.
     7081            end.
     7082         end.
     7083         do transaction
     7084         on error undo, return error return-value
     7085         :
     7086           find first buf_user-login exclusive-lock
     7087                where buf_user-login.db-num  = p-db-num
     7088                  and buf_user-login.user-id = p-user-id
     7089           no-error no-wait.
     7090           if not available buf_user-login
     7091           then do:
     7092             if locked( buf_user-login )
     7093             then do:
     7094                   find first buf_user-login no-lock
     7095                        where buf_user-login.db-num  = p-db-num
     7096                          and buf_user-login.user-id = p-user-id
     7097                   .
     7098                   find first buf_user-account no-lock
     7099                        where buf_user-account.user-id = p-user-id
     7100                   .
     7101                   message
     7102                   "Редактирование логина невозможно" skip
     7103                   "Пользователь в данный момент работает в системе" skip
     7104                   "БД" p-db-num skip
     7105                   "Идентификатор"                p-user-id skip
     7106                   "Псевдоним"                    buf_user-account.nik skip
     7107                   "Имя пользователя"             buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name skip
     7108                   "Компьютер"                    buf_user-login.last-login-computer-name skip
     7109                   "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     7110                   "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     7111                   "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     7112                   "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     7113                   "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     7114                   "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     7115                   view-as alert-box error .
     7116             end.
     7117             else do:
     7118               message
     7119                 "Редактирование логина невозможно" skip
     7120                 "У пользователя нет логина" skip
     7121                 "БД" p-db-num skip
     7122                 "Идентификатор" p-user-id skip
     7123                 view-as alert-box error .
     7124             end.
     7125             undo, return error return-value .
     7126           end.
     7127         end.
     7128         run str/usrmngr.w (
     7129             input parparentproc
     7130           , input p-db-num
     7131           , input p-user-id
     7132           , input 0
     7133         ) no-error .
     7134         if error-status :error
     7135         then do:
     7136           message
     7137             vss-workfile vss-revision vss-description skip
     7138             "Ошибка при вызове процедуры" 'str/usrmngr.w':U skip
     7139             error-status :get-message(1) skip
     7140             return-value skip
     7141             view-as alert-box error .
     7142           undo, return error return-value .
     7143         end.
     7144   end.
     7145   END PROCEDURE.
     7146   PROCEDURE procedure-user-login-user-host :
     7147   define input parameter p-db-num         as integer          no-undo.
     7148   define input parameter p-user-id        as character        no-undo.
     7149     define variable v-current-host-code    as integer      no-undo.
     7150     define variable v-user-select      as logical   no-undo .
     7151     DEFINE VARIABLE v-List-select-host-code AS CHARACTER NO-UNDO INITIAL "".
     7152   do
     7153   on error undo, return error
     7154   :
     7155       run gbl/userhsts.w
     7156         (input  parparentproc
     7157         ,input  this-procedure :handle
     7158         ,input  p-db-num
     7159         ,input  p-user-id
     7160         ,input  v-cntxt-host-code-obj
     7161         ,input  IF v-only-lookup THEN "":U ELSE "b-add"
     7162         ,output v-user-select
     7163         ,output v-current-host-code
     7164         ,OUTPUT v-List-Select-host-code
     7165         ) .
     7166   end.
     7167   END PROCEDURE.
     7168   PROCEDURE procedure-user-login-user-obj :
     7169   define input parameter p-db-num         as integer          no-undo.
     7170   define input parameter p-user-id        as character        no-undo.
     7171       define variable v-user-select        as logical   no-undo .
     7172       define variable v-select-obj-type    as character no-undo .
     7173       define variable v-select-obj-code    as integer   no-undo .
     7174   do
     7175   on error undo, return error
     7176   :
     7177       run gbl/userobjs.w (
     7178             input parparentproc
     7179           , input this-procedure :handle
     7180           , input p-db-num
     7181           , input p-user-id
     7182           , input v-cntxt-host-code-obj
     7183           , input v-cntxt-obj-type
     7184           , input v-cntxt-obj-code
     7185           , input IF v-only-lookup THEN "":U ELSE "b-add":U
     7186           , output v-user-select
     7187           , output v-select-obj-type
     7188           , output v-select-obj-code
     7189         ).
     7190   end.
     7191   END PROCEDURE.
     7192   PROCEDURE save-position :
     7193       define variable v-current-rowid    as rowid        no-undo.
     7194       define variable v-current-focus    as integer      no-undo.
     7195   do
     7196   with frame Dialog-Frame
     7197   on error undo, return error
     7198   :
     7199       if available buf_init_user-account
     7200       then do:
     7201           assign
     7202               v-current-rowid = rowid( buf_init_user-account )
     7203               v-current-focus = br-user :focused-row in frame Dialog-Frame
     7204           .
     7205           run uf-set (
     7206                 input 'users-1':U
     7207               , input v-cntxt-userid
     7208               , input string( rs-scope )
     7209               , input string( cb-db )
     7210               , input no
     7211               , input no
     7212               , input no
     7213               , input no
     7214           ) .
     7215           run uf-set (
     7216                 input 'users-2':U
     7217               , input v-cntxt-userid
     7218               , input string( v-current-focus )
     7219               , input string( v-current-rowid )
     7220               , input no
     7221               , input no
     7222               , input no
     7223               , input no
     7224           ) .
     7225       end.
     7226   end.
     7227   END PROCEDURE.
     7228   FUNCTION get-person-name RETURNS CHARACTER
     7229     ( p-psn-code as integer ) :
     7230     define variable v-person-name as character no-undo .
     7231     run procedure-get-person-name in this-procedure (
     7232         input p-psn-code
     7233       , output v-person-name
     7234     ) .
     7235     return v-person-name .
     7236   END FUNCTION.
