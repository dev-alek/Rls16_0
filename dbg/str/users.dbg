     3843     index xie browse-type browse-handle
     3844   .
     3845   procedure diasize_change-height :
     3846     define input  parameter p-change-value  as decimal   no-undo .
     3847     define input  parameter p-move-resize   as logical   no-undo .
     3848     define variable v-field-group-handle    as handle    no-undo .
     3849     define variable v-object-handle         as handle    no-undo .
     3850     define variable v-frame-height          as decimal   no-undo .
     3851     define variable v-frame-virtual-height  as decimal   no-undo .
     3852     define variable v-browse-height         as decimal   no-undo .
     3853     define variable v-window-height         as decimal   no-undo .
     3854     define variable v-window-virtual-height as decimal   no-undo .
     3855     define variable v-change-sign           as integer   no-undo .
     3856     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3857     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3858     if p-change-value > 0
     3859     then do:
     3860       if frame Dialog-Frame :height + p-change-value
     3861           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3862       then do:
     3863         assign
     3864           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3865                           - (frame Dialog-Frame :height-chars)
     3866         .
     3867         if p-change-value <= 0
     3868         then do:
     3869           run diasize_position-resize-button in this-procedure .
     3870           return .
     3871         end.
     3872       end.
     3873     end.
     3874     if p-change-value < 0
     3875     then do:
     3876       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3877       then do:
     3878         assign
     3879           p-change-value = v-diasize-orig-frame-height
     3880                          - (frame Dialog-Frame :height-chars)
     3881         .
     3882         if p-change-value >= 0
     3883         then do:
     3884           run diasize_position-resize-button in this-procedure .
     3885           return .
     3886         end.
     3887       end.
     3888     end.
     3889     if p-change-value >= 0
     3890     then do:
     3891       assign
     3892         v-change-sign = 1
     3893       .
     3894     end.
     3895     else do:
     3896       assign
     3897         v-change-sign = -1
     3898       .
     3899     end.
     3900     assign
     3901       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3902     .
     3903     if p-change-value = 0
     3904     then do:
     3905       run diasize_position-resize-button in this-procedure .
     3906       return .
     3907     end.
     3908     move_block:
     3909     do
     3910     on error undo move_block, retry move_block
     3911     :
     3912       if retry
     3913       then do:
     3914         do
     3915         on error undo move_block, leave move_block
     3916         :
     3917           if p-change-value > 0
     3918           then do:
     3919             for each buf_temp-diasize-handle
     3920             on error undo, next
     3921             :
     3922               assign
     3923                 v-object-handle = buf_temp-diasize-handle.handle-value
     3924               .
     3925               if v-object-handle <> v-diasize-resize-button
     3926               then do:
     3927                 assign
     3928                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3929                 .
     3930               end.
     3931             end.
     3932             assign
     3933               v-diasize-browse-handle :height = v-browse-height
     3934             .
     3935             for each buf_temp-browse-handle
     3936               where buf_temp-browse-handle.browse-type = 'height':u
     3937             on error undo, next
     3938             :
     3939               assign
     3940                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3941               .
     3942             end.
     3943             assign
     3944               frame Dialog-Frame :height = v-frame-height
     3945             .
     3946             if frame Dialog-Frame :scrollable = true
     3947             then do:
     3948               assign
     3949                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3950               .
     3951             end.
     3952             run diasize_position-resize-button in this-procedure .
     3953           end.
     3954           else do:
     3955             if frame Dialog-Frame :scrollable = true
     3956             then do:
     3957               assign
     3958                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3959               .
     3960             end.
     3961             assign
     3962               frame Dialog-Frame :height = v-frame-height
     3963             .
     3964             assign
     3965               v-diasize-browse-handle :height = v-browse-height
     3966             .
     3967             for each buf_temp-browse-handle
     3968               where buf_temp-browse-handle.browse-type = 'height':u
     3969             on error undo, next
     3970             :
     3971               assign
     3972                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3973               .
     3974             end.
     3975             for each buf_temp-diasize-handle
     3976             on error undo, next
     3977             :
     3978               assign
     3979                 v-object-handle = buf_temp-diasize-handle.handle-value
     3980               .
     3981               if v-object-handle <> v-diasize-resize-button
     3982               then do:
     3983                 assign
     3984                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3985                 .
     3986               end.
     3987             end.
     3988             run diasize_position-resize-button in this-procedure .
     3989           end.
     3990           assign
     3991             v-diasize-change-size = false
     3992           .
     3993           leave move_block .
     3994         end.
     3995       end.
     3996       assign
     3997         v-diasize-need-full-display = true
     3998       .
     3999       if v-diasize-change-size = false
     4000       then do:
     4001         assign
     4002           v-diasize-change-size = true
     4003         .
     4004       end.
     4005       else do:
     4006         return .
     4007       end.
     4008       assign
     4009         v-frame-height = frame Dialog-Frame :height
     4010         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4011         v-browse-height = v-diasize-browse-handle :height
     4012       .
     4013       for each buf_temp-browse-handle
     4014         where buf_temp-browse-handle.browse-type = 'height':u
     4015       :
     4016         assign
     4017           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4018         .
     4019       end.
     4020       for each buf_temp-diasize-handle
     4021       :
     4022         delete buf_temp-diasize-handle .
     4023       end.
     4024       assign
     4025         v-field-group-handle = frame Dialog-Frame :first-child
     4026       .
     4027       do while valid-handle(v-field-group-handle)
     4028       :
     4029         assign
     4030           v-object-handle = v-field-group-handle :first-child
     4031         .
     4032         do while valid-handle(v-object-handle)
     4033         :
     4034           if  v-object-handle <> v-diasize-browse-handle :handle
     4035           and can-query(v-object-handle, "row")
     4036           and can-query(v-object-handle, "height")
     4037           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4038           then do:
     4039             find first buf_temp-browse-handle
     4040               where buf_temp-browse-handle.browse-type   = 'height':u
     4041                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4042               no-error .
     4043             if available buf_temp-browse-handle
     4044             then do:
     4045             end.
     4046             else do:
     4047               create buf_temp-diasize-handle .
     4048               assign
     4049                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4050                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4051               .
     4052             end.
     4053           end.
     4054           assign
     4055             v-object-handle = v-object-handle :next-sibling
     4056           .
     4057         end.
     4058         assign
     4059           v-field-group-handle = v-field-group-handle :next-sibling
     4060         .
     4061       end.
     4062       do with frame Dialog-Frame
     4063       :
     4064         hide v-diasize-resize-button .
     4065         assign
     4066           v-diasize-resize-button :row    = 1
     4067           v-diasize-resize-button :column = 1
     4068         .
     4069       end.
     4070       if p-change-value > 0
     4071       then do:
     4072         if frame Dialog-Frame :scrollable = true
     4073         then do:
     4074           assign
     4075             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4076             no-error .
     4077           if error-status :error
     4078           or error-status :get-message(1) <> ""
     4079           then do:
     4080             undo move_block, retry move_block .
     4081           end.
     4082         end.
     4083         assign
     4084           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4085           no-error .
     4086         if error-status :error
     4087         or error-status :get-message(1) <> ""
     4088         then do:
     4089           undo move_block, retry move_block .
     4090         end.
     4091         assign
     4092           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4093           no-error .
     4094         if error-status :error
     4095         or error-status :get-message(1) <> ""
     4096         then do:
     4097           undo move_block, retry move_block .
     4098         end.
     4099         for each buf_temp-browse-handle
     4100           where buf_temp-browse-handle.browse-type = 'height':u
     4101         on error undo move_block, retry move_block
     4102         :
     4103           assign
     4104             buf_temp-browse-handle.browse-handle :height
     4105               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4106             no-error .
     4107           if error-status :error
     4108           or error-status :get-message(1) <> ""
     4109           then do:
     4110             undo move_block, retry move_block .
     4111           end.
     4112         end.
     4113         for each buf_temp-diasize-handle
     4114         on error undo move_block, retry move_block
     4115         :
     4116           assign
     4117             v-object-handle = buf_temp-diasize-handle.handle-value
     4118           .
     4119           if v-object-handle <> v-diasize-resize-button
     4120           then do:
     4121             assign
     4122               v-object-handle :row = v-object-handle :row + p-change-value
     4123               no-error .
     4124             if error-status :error
     4125             or error-status :get-message(1) <> ""
     4126             then do:
     4127               undo move_block, retry move_block .
     4128             end.
     4129           end.
     4130         end.
     4131       end.
     4132       else do:
     4133         for each buf_temp-diasize-handle
     4134         on error undo move_block, retry move_block
     4135         :
     4136           assign
     4137             v-object-handle = buf_temp-diasize-handle.handle-value
     4138           .
     4139           if v-object-handle <> v-diasize-resize-button
     4140           then do:
     4141             assign
     4142               v-object-handle :row = v-object-handle :row + p-change-value
     4143               no-error .
     4144             if error-status :error
     4145             or error-status :get-message(1) <> ""
     4146             then do:
     4147               undo move_block, retry move_block .
     4148             end.
     4149           end.
     4150         end.
     4151         assign
     4152           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4153           no-error .
     4154         if error-status :error
     4155         or error-status :get-message(1) <> ""
     4156         then do:
     4157           undo move_block, retry move_block .
     4158         end.
     4159         for each buf_temp-browse-handle
     4160           where buf_temp-browse-handle.browse-type = 'height':u
     4161         on error undo move_block, retry move_block
     4162         :
     4163           assign
     4164             buf_temp-browse-handle.browse-handle :height
     4165               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4166             no-error .
     4167           if error-status :error
     4168           or error-status :get-message(1) <> ""
     4169           then do:
     4170             undo move_block, retry move_block .
     4171           end.
     4172         end.
     4173         assign
     4174           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4175           no-error .
     4176         if error-status :error
     4177         or error-status :get-message(1) <> ""
     4178         then do:
     4179           undo move_block, retry move_block .
     4180         end.
     4181         if frame Dialog-Frame :scrollable = true
     4182         then do:
     4183           assign
     4184             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4185             no-error .
     4186           if error-status :error
     4187           or error-status :get-message(1) <> ""
     4188           then do:
     4189             undo move_block, retry move_block .
     4190           end.
     4191         end.
     4192       end.
     4193       if p-move-resize = true
     4194       then do:
     4195         run diasize_position-resize-button in this-procedure .
     4196       end.
     4197       if v-diasize-wndstore = true
     4198       then do:
     4199         if connected("ub") = true
     4200         then do:
     4201           define variable v-cntxt-db-num        as integer   no-undo .
     4202           define variable v-cntxt-userid        as character no-undo .
     4203           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4204                                             , OUTPUT v-cntxt-userid
     4205                                             ) .
     4206           run gbl/wndsizew.p
     4207             (input  v-cntxt-db-num
     4208             ,input  v-cntxt-userid
     4209             ,input  v-diasize-proc-name
     4210             ,input  'height':u
     4211             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4212             ) .
     4213         end.
     4214       end.
     4215     end.
     4216     assign
     4217       v-diasize-change-size = false
     4218     .
     4219   end procedure.
     4220   procedure diasize_set-height :
     4221     define input  parameter p-new-height  as decimal   no-undo .
     4222     define input  parameter p-move-resize as logical   no-undo .
     4223     do
     4224     on error undo, return error return-value
     4225     :
     4226       run diasize_change-height in this-procedure
     4227         (input  (p-new-height - frame Dialog-Frame :height)
     4228         ,input  p-move-resize
     4229         ) .
     4230     end.
     4231   end procedure.
     4232   procedure diasize_change-width :
     4233     define input  parameter p-change-value as decimal   no-undo .
     4234     define input  parameter p-move-resize  as logical   no-undo .
     4235     define variable v-field-group-handle   as handle    no-undo .
     4236     define variable v-object-handle        as handle    no-undo .
     4237     define variable v-frame-width          as decimal   no-undo .
     4238     define variable v-frame-virtual-width  as decimal   no-undo .
     4239     define variable v-browse-width         as decimal   no-undo .
     4240     define variable v-window-width         as decimal   no-undo .
     4241     define variable v-window-virtual-width as decimal   no-undo .
     4242     define variable v-change-sign          as integer   no-undo .
     4243     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4244     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4245     if p-change-value > 0
     4246     then do:
     4247       if frame Dialog-Frame :width + p-change-value >
     4248           session :width-chars
     4249       then do:
     4250         assign
     4251           p-change-value = session :width-chars - frame Dialog-Frame :width
     4252         .
     4253         if p-change-value <= 0
     4254         then do:
     4255           run diasize_position-resize-button in this-procedure .
     4256           return .
     4257         end.
     4258       end.
     4259     end.
     4260     if p-change-value < 0
     4261     then do:
     4262       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4263       then do:
     4264         assign
     4265           p-change-value = v-diasize-orig-frame-width
     4266                          - frame Dialog-Frame :width
     4267         .
     4268         if p-change-value >= 0
     4269         then do:
     4270           run diasize_position-resize-button in this-procedure .
     4271           return .
     4272         end.
     4273       end.
     4274     end.
     4275     if p-change-value >= 0
     4276     then do:
     4277       assign
     4278         v-change-sign = 1
     4279       .
     4280     end.
     4281     else do:
     4282       assign
     4283         v-change-sign = -1
     4284       .
     4285     end.
     4286     assign
     4287       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4288     .
     4289     if p-change-value = 0
     4290     then do:
     4291       run diasize_position-resize-button in this-procedure .
     4292       return .
     4293     end.
     4294     move_block:
     4295     do
     4296     on error undo move_block, leave move_block
     4297     :
     4298       if retry
     4299       then do:
     4300         do
     4301         on error undo move_block, leave move_block
     4302         :
     4303           if p-change-value > 0
     4304           then do:
     4305             for each buf_temp-diasize-handle
     4306             on error undo, next
     4307             :
     4308               assign
     4309                 v-object-handle = buf_temp-diasize-handle.handle-value
     4310               .
     4311               if v-object-handle <> v-diasize-resize-button
     4312               then do:
     4313                 assign
     4314                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4315                 .
     4316               end.
     4317             end.
     4318             assign
     4319               v-diasize-browse-handle :width = v-browse-width
     4320             .
     4321             for each buf_temp-browse-handle
     4322               where buf_temp-browse-handle.browse-type = 'width':u
     4323             on error undo, next
     4324             :
     4325               assign
     4326                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4327               .
     4328             end.
     4329             assign
     4330               frame Dialog-Frame :width = v-frame-width
     4331             .
     4332             if frame Dialog-Frame :scrollable = true
     4333             then do:
     4334               assign
     4335                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4336               .
     4337             end.
     4338             run diasize_position-resize-button in this-procedure .
     4339           end.
     4340           else do:
     4341             if frame Dialog-Frame :scrollable = true
     4342             then do:
     4343               assign
     4344                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4345               .
     4346             end.
     4347             assign
     4348               frame Dialog-Frame :width = v-frame-width
     4349             .
     4350             for each buf_temp-browse-handle
     4351               where buf_temp-browse-handle.browse-type = 'width':u
     4352             on error undo, next
     4353             :
     4354               assign
     4355                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4356               .
     4357             end.
     4358             assign
     4359               v-diasize-browse-handle :width = v-browse-width
     4360             .
     4361             for each buf_temp-diasize-handle
     4362             on error undo, next
     4363             :
     4364               assign
     4365                 v-object-handle = buf_temp-diasize-handle.handle-value
     4366               .
     4367               if v-object-handle <> v-diasize-resize-button
     4368               then do:
