      732               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      733               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      734                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      735               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      736         otherwise do:
      737           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      738         end.
      739       end CASE.
      740     end.
      741   end procedure.
      742   procedure uf-get :
      743     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      744     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      745     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      746     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      747     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      748     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      749     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      750     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      751     do
      752     on error undo, return error
      753     :
      754       define buffer buf_usr-flt for ubflt.usr-flt .
      755       define variable v-use-List_     as logical   no-undo .
      756       define variable v-type-List_     as character no-undo .
      757       define variable v-format-List_   as character no-undo .
      758       define variable v-use-Naim      as logical   no-undo .
      759       define variable v-type-Naim      as character no-undo .
      760       define variable v-format-Naim    as character no-undo .
      761       define variable v-use-print-graft as logical   no-undo .
      762       define variable v-use-sort-gr     as logical   no-undo .
      763       define variable v-use-type-price  as logical   no-undo .
      764       define variable v-use-type-val    as logical   no-undo .
      765       define variable v-label          as character no-undo .
      766       define variable v-tooltip        as character no-undo .
      767       define variable v-user-can-edit  as logical   no-undo .
      768       define variable v-output-display as logical   no-undo .
      769       define variable v-other          as character no-undo .
      770       run uf-name in this-procedure
      771          (input  entry(1, p-code, chr(4))
      772         ,output v-use-List_
      773         ,output v-type-List_
      774         ,output v-format-List_
      775         ,output v-use-Naim
      776         ,output v-type-Naim
      777         ,output v-format-Naim
      778         ,output v-use-print-graft
      779         ,output v-use-sort-gr
      780         ,output v-use-type-price
      781         ,output v-use-type-val
      782         ,output v-label
      783         ,output v-tooltip
      784         ,output v-user-can-edit
      785         ,output v-output-display
      786         ,output v-other
      787         ) no-error .
      788       if error-status :error then do:
      789         undo, return error return-value .
      790       end.
      791       find first buf_usr-flt no-lock where
      792                  buf_usr-flt.Call-point     = p-code AND
      793                  buf_usr-flt.user-name       = p-user-name
      794         no-error .
      795       if avail buf_usr-flt then do:
      796         assign
      797         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      798         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      799         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      800         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      801         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      802         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      803         .
      804       end.
      805       else do:
      806         assign
      807         p-List_        = (if v-use-List_       then "":U                    else ?)
      808         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      809         p-print-graft  = (if v-use-print-graft then no                      else ?)
      810         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      811         p-type-price   = (if v-use-type-price  then no                      else ?)
      812         p-type-val     = (if v-use-List_       then no                      else ?)
      813         .
      814       end.
      815     end.
      816   end procedure.
      817   procedure uf-set :
      818     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      819     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      820     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      821     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      822     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      823     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      824     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      825     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      826     do
      827     on error undo, return error
      828     :
      829       define buffer buf_usr-flt for ubflt.usr-flt .
      830       define variable v-use-List_     as logical   no-undo .
      831       define variable v-type-List_     as character no-undo .
      832       define variable v-format-List_   as character no-undo .
      833       define variable v-use-Naim      as logical   no-undo .
      834       define variable v-type-Naim      as character no-undo .
      835       define variable v-format-Naim    as character no-undo .
      836       define variable v-use-print-graft as logical   no-undo .
      837       define variable v-use-sort-gr   as logical   no-undo .
      838       define variable v-use-type-price as logical   no-undo .
      839       define variable v-use-type-val  as logical   no-undo .
      840       define variable v-tooltip        as character no-undo .
      841       define variable v-label          as character no-undo .
      842       define variable v-user-can-edit  as logical   no-undo .
      843       define variable v-output-display as logical   no-undo .
      844       define variable v-other          as character no-undo .
      845       run uf-name in this-procedure
      846         (input  entry(1, p-code, chr(4))
      847         ,output v-use-List_
      848         ,output v-type-List_
      849         ,output v-format-List_
      850         ,output v-use-Naim
      851         ,output v-type-Naim
      852         ,output v-format-Naim
      853         ,output v-use-print-graft
      854         ,output v-use-sort-gr
      855         ,output v-use-type-price
      856         ,output v-use-type-val
      857         ,output v-label
      858         ,output v-tooltip
      859         ,output v-user-can-edit
      860         ,output v-output-display
      861         ,output v-other
      862         ) no-error .
      863       if error-status :error then do:
      864         undo, return error return-value .
      865       end.
      866       find first buf_usr-flt where
      867                  buf_usr-flt.Call-point     = p-code AND
      868                  buf_usr-flt.user-name       = p-user-name
      869         no-error .
      870       if not avail buf_usr-flt then do:
      871           create buf_usr-flt .
      872           assign
      873           buf_usr-flt.call-point = p-code
      874           buf_usr-flt.user-name  = p-user-name
      875           .
      876       end.
      877       if avail buf_usr-flt then do:
      878        assign
      879        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      880        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      881        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      882        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      883        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      884        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      885       .
      886       release buf_usr-flt.
      887       end.
      888       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      889     end.
      890   end procedure.
      891   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   define  stream PrnLibStream.
      893   procedure prn-lib-prn-file :
      894     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      895     define input parameter p-DIsabledoptions as integer no-undo .
      896     define variable v-report-name as character no-undo .
      897     define variable v-user-action as character no-undo .
      898     define variable v-printed     as logical   no-undo .
      899     define variable v-exist       as logical   no-undo .
      900     do
      901       on error undo, return error
      902       :
      903       run prn-lib-get-report-name  in this-procedure (
      904         input parParentProc
      905         ,output v-report-name
      906         ).
      907   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      909     (input  v-report-name
      910     ,input  2
      911     ,output v-exist
      912     )  .
      913       if NOT v-exist then
      914       DO:
      915         Message
      916           "Нет заданий на печать ! "
      917           view-as alert-box .
      918         Return  .
      919       End.
      920       run gbl/prnfilen.w
      921         (input  ""
      922         ,input  p-DisabledOptions
      923         ,input  string(v-report-name )
      924         ,input  7
      925         ,output v-user-action
      926         ,output v-printed
      927         ) .
      928       if v-printed then
      929       do:
      930         return "YES" .
      931       end.
      932       else
      933       do:
      934         return "NO" .
      935       end.
      936     end.
      937   end procedure.
      938   procedure prn-lib-open-stream :
      939     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      940     define input parameter p-page-size    as integer no-undo .
      941     define input parameter p-is-stream    as logical no-undo .
      942     define input parameter p-append       as logical no-undo .
      943     define variable v-report-name as character no-undo .
      944     do
      945       on error undo, return error
      946       :
      947       run prn-lib-get-report-name  in this-procedure (
      948         input parParentProc
      949         ,output v-report-name
      950         ).
      951       if p-is-stream then
      952       do:
      953         if p-append then
      954         do:
      955           output stream PrnLibStream to value( v-report-name )
      956             page-size value(p-page-size) append .
      957         end.
      958         if not p-append then
      959         do:
      960           output stream PrnLibStream to value( v-report-name )
      961             page-size value(p-page-size) .
      962         end.
      963       end.
      964       if not p-is-stream then
      965       do:
      966         if p-append then
      967         do:
      968           output to value( v-report-name )
      969             page-size value(p-page-size) append .
      970         end.
      971         if not p-append then
      972         do:
      973           output to value( v-report-name )
      974             page-size value(p-page-size) .
      975         end.
      976       end.
      977     end.
      978   end procedure.
      979   procedure prn-lib-open-exp :
      980     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      981     define input parameter p-is-stream    as logical no-undo .
      982     define input parameter p-is-append    as logical no-undo .
      983     define output parameter p-ReportFileName as char init "report" no-undo.
      984     define output parameter p-process as logical no-undo .
      985     define variable glog as logical no-undo .
      986     do
      987       on error undo, return error
      988       :
      989       SYSTEM-DIALOG GET-FILE p-ReportFileName
      990         TITLE      "Укажите путь"
      991         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      992         ASK-OVERWRITE
      993         CREATE-TEST-FILE
      994         SAVE-AS
      995         USE-FILENAME
      996         DEFAULT-EXTENSION "txt"
      997         UPDATE glog
      998         .
      999       if not glog then  return.
     1000       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1001       if p-is-stream then
     1002       do:
     1003         if p-is-append then
     1004         do:
     1005           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1006         end.
     1007         else
     1008         do:
     1009           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1010         end.
     1011       end.
     1012       else
     1013       do:
     1014         if p-is-append then
     1015         do:
     1016           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1017         end.
     1018         else
     1019         do:
     1020           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1021         end.
     1022       end.
     1023       p-process = yes.
     1024     end.
     1025   end procedure.
     1026   procedure prn-lib-get-report-name :
     1027     define input parameter parParentProc  as widget-handle no-undo.
     1028     define output parameter p-report-name as character no-undo .
     1029     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1030   end procedure.
     1031   procedure prn-lib-reportviewer-report-name :
     1032     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1033     define input parameter p-report-name-html as character no-undo .
     1034     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1035   end procedure.
     1036   procedure prn-lib-reportviewer :
     1037     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1038     define input parameter p-report-name-html as character no-undo .
     1039     define input parameter p-param        as character no-undo .
     1040     define variable v-excel           as character no-undo init 'TRUE' .
     1041     define variable v-value-character as character no-undo .
     1042     define variable v-value-integer   as character no-undo .
     1043     define variable v-value-date      as date      no-undo .
     1044     define variable v-value-decimal   as decimal   no-undo .
     1045     define variable rep-excel         as logical   no-undo .
     1046     define variable excel-string      as character no-undo .
     1047     define variable v-param-type      as character no-undo .
     1048     define variable v-tth             as handle    no-undo .
     1049     run adm/shattri.p (
     1050       input "get":U
     1051       ,input  ""
     1052       ,input  0
     1053       ,input  'report-glob':U
     1054       ,input  'rep-excel':U
     1055       ,output v-value-character
     1056       ,output v-value-date
     1057       ,output v-value-decimal
     1058       ,output v-value-integer
     1059       ,output rep-excel
     1060       ,output v-param-type
     1061       ,INPUT-OUTPUT table-handle v-tth
     1062       )  .
     1063     if rep-excel then v-excel = "TRUE" .
     1064     else v-excel = "FALSE" .
     1065     if p-param eq ""
     1066     then
     1067        p-param = "EXCEL:" + v-excel.
     1068     else
     1069        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1070     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1071   end procedure.
