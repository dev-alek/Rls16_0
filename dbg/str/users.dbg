     2811                                 output v-adm-Ubd,
     2812                                 output v-adm-gbd,
     2813                                 output v-superAdm,
     2814                                 input-output table-handle v-TabUserAdm).
     2815          run str/user.w (
     2816                 input parparentproc
     2817               , input this-procedure
     2818               , input 'ИЗМЕНЕНИЕ':U
     2819               , input buf_init_user-account.user-id
     2820               , input buf_init_user-account.last-name
     2821               , input buf_init_user-account.first-name
     2822               , input buf_init_user-account.second-name
     2823               , input buf_init_user-account.nik
     2824               , input buf_init_user-account.phone-number
     2825               , input buf_init_user-account.mobile-phone-number
     2826               , input buf_init_user-account.company
     2827               , input buf_init_user-account.department
     2828               , input buf_init_user-account.position
     2829               , input buf_init_user-account.room
     2830               , input buf_init_user-account.e-mail
     2831               , input buf_init_user-account.internal-phone-number
     2832               , input buf_init_user-account.PS
     2833               , INPUT buf_init_user-account.psn-code
     2834               , input v-adm-gbd
     2835               , input v-superAdm
     2836               , input v-adm-Ubd
     2837               , input-output table-handle v-TabUserAdm
     2838               , output v-last-name
     2839               , output v-first-name
     2840               , output v-second-name
     2841               , output v-nik
     2842               , output v-phone-number
     2843               , output v-mobile-phone-number
     2844               , output v-company
     2845               , output v-department
     2846               , output v-position
     2847               , output v-room
     2848               , output v-e-mail
     2849               , output v-internal-phone-number
     2850               , output v-PS
     2851               , output v-psn-code
     2852               , output v-adm-gbd
     2853               , output v-superAdm
     2854               , output v-adm-Ubd
     2855               , output v-accepted
     2856           ) no-error.
     2857           if error-status :error
     2858           then do:
     2859               message
     2860                           vss-workfile vss-revision vss-description
     2861                   skip(1)
     2862                   skip "Ошибка редактирования пользователя."
     2863                   skip return-value
     2864                   skip trim( error-status :get-message( 1 ) )
     2865                           trim( error-status :get-message( 2 ) )
     2866                           trim( error-status :get-message( 3 ) )
     2867               view-as alert-box error.
     2868               undo, return no-apply.
     2869           end.
     2870           if v-accepted = yes
     2871           then do:
     2872               run str/usracc01.p (
     2873                     input 'ИЗМЕНЕНИЕ':U
     2874                   , input v-cntxt-db-num
     2875                   , input buf_init_user-account.user-id
     2876                   , input v-last-name
     2877                   , input v-first-name
     2878                   , input v-second-name
     2879                   , input v-nik
     2880                   , input v-phone-number
     2881                   , input v-mobile-phone-number
     2882                   , input v-company
     2883                   , input v-department
     2884                   , input v-position
     2885                   , input v-room
     2886                   , input v-e-mail
     2887                   , input v-internal-phone-number
     2888                   , input v-PS
     2889                   , input v-psn-code
     2890                   , input v-superAdm
     2891                   , output v-user-id
     2892               ) no-error.
     2893               if error-status :error
     2894               then do:
     2895                   message
     2896                            vss-workfile vss-revision vss-description
     2897                       skip(1)
     2898                       skip "Ошибка изменения данных пользователя."
     2899                       skip return-value
     2900                       skip trim( error-status :get-message( 1 ) )
     2901                            trim( error-status :get-message( 2 ) )
     2902                            trim( error-status :get-message( 3 ) )
     2903                   view-as alert-box error.
     2904                   undo, return no-apply.
     2905               end.
     2906               define variable v-created as logical no-undo.
     2907               run procedure-user-login-create in this-procedure (
     2908                     input 'ИЗМЕНЕНИЕ':U
     2909                   , input v-cntxt-db-num
     2910                   , input buf_init_user-account.user-id
     2911                   , input v-adm-gbd
     2912                   , input v-adm-Ubd
     2913                   , input v-TabUserAdm
     2914                   , output v-created
     2915               ) no-error.
     2916               if error-status :error
     2917               then do:
     2918                   message
     2919                           vss-workfile vss-revision vss-description
     2920                       skip(1)
     2921                       skip "Ошибка создания логина пользователя."
     2922                       skip return-value
     2923                       skip trim( error-status :get-message( 1 ) )
     2924                           trim( error-status :get-message( 2 ) )
     2925                           trim( error-status :get-message( 3 ) )
     2926                   view-as alert-box error.
     2927                   undo, return no-apply.
     2928               end.
     2929               run assign-field-filter-mark in this-procedure (
     2930                     input v-users-name-filter
     2931                   , input v-users-login-filter
     2932               ).
     2933               run manage-fields in this-procedure .
     2934               br-user :refresh().
     2935           end.
     2936       end.
     2937   END.
