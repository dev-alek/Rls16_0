      107   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108     define variable v-cntxt-db-num        as integer   no-undo .
      109     define variable v-cntxt-userid        as character no-undo .
      110     define variable v-cntxt-level         as character no-undo .
      111     define variable v-cntxt-host-code-obj as integer   no-undo .
      112     define variable v-cntxt-obj-type      as character no-undo .
      113     define variable v-cntxt-obj-code      as integer   no-undo .
      114     define variable v-cntxt-db-num-obj    as integer   no-undo .
