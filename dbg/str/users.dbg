     2983   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2984   DO:
     2985       if available buf_init_user-account
     2986       then do:
     2987           if buf_init_user-account.user-id = v-cntxt-userid
     2988           then do:
     2989               message
     2990                        "Невозможно удалить текущего пользователя"
     2991                   skip "Идентификатор пользователя" buf_init_user-account.user-id
     2992                   view-as alert-box error .
     2993               undo, return no-apply.
     2994           end.
     2995           if  buf_init_user-account.status_ eq 0
     2996           then do:
     2997              define variable v-ok as logical   no-undo .
     2998              message
     2999                       "После удаления пользователь"
     3000                  skip "не сможет работать в системе"
     3001                  skip (1)
     3002                  skip "Псевдоним:" buf_init_user-account.nik skip
     3003                  skip "Имя:      " buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name
     3004                  skip (1)
     3005                  skip "Удалить пользователя?"
     3006              view-as alert-box question
     3007              buttons yes-no
     3008              title substitute( "Удаление пользователя '&1'", buf_init_user-account.nik )
     3009              update v-ok.
     3010              if v-ok = yes
     3011              then do:
     3012                  run str/usracc03.p (
     3013                        input buf_init_user-account.user-id
     3014                      , input v-cntxt-db-num
     3015                  ) no-error .
     3016                  if error-status :error
     3017                  then do:
     3018                      message
     3019                              vss-workfile vss-revision vss-description
     3020                          skip(1)
     3021                          skip "Ошибка удаления пользователя."
     3022                          skip return-value
     3023                          skip trim( error-status :get-message( 1 ) )
     3024                              trim( error-status :get-message( 2 ) )
     3025                              trim( error-status :get-message( 3 ) )
     3026                      view-as alert-box error.
     3027                      undo, return no-apply.
     3028                  end.
     3029                  run open-query in this-procedure ( input this-procedure ).
     3030                  run manage-fields in this-procedure .
     3031              end.
     3032           end.
     3033           else do:
     3034              run str/usracc02.p (
     3035                        input buf_init_user-account.user-id
     3036               ) no-error .
     3037               if error-status :error
     3038               then do:
     3039                   message
     3040                           vss-workfile vss-revision vss-description
     3041                       skip(1)
     3042                       skip "Ошибка удаления пользователя."
     3043                       skip return-value
     3044                       skip trim( error-status :get-message( 1 ) )
     3045                           trim( error-status :get-message( 2 ) )
     3046                           trim( error-status :get-message( 3 ) )
     3047                   view-as alert-box error.
     3048                   undo, return no-apply.
     3049               end.
     3050               run open-query in this-procedure ( input this-procedure ).
     3051               run manage-fields in this-procedure .
     3052           end.
     3053       end.
     3054   END.
     3055   ON CHOOSE OF b-del-2 IN FRAME Dialog-Frame
     3056   DO:
     3057       define variable v-deleted    as logical      no-undo.
     3058       if available buf_init_user-login
     3059       then do:
     3060           if  buf_init_user-login.status_ eq 0
     3061           then do:
     3062           run procedure-user-login-delete in this-procedure (
     3063                 input buf_init_user-login.db-num
     3064               , input buf_init_user-login.user-id
     3065               , output v-deleted
     3066           ) no-error .
     3067           if error-status :error
     3068           then do:
     3069               message
     3070                   vss-workfile vss-revision vss-description
     3071                   skip "Ошибка при вызове процедуры удаления логина пользователя"
     3072                   skip error-status :get-message(1)
     3073                   skip return-value
     3074               view-as alert-box error .
     3075               undo, return no-apply .
     3076           end.
     3077           end.
     3078           else do transaction
     3079              on error undo, return:
     3080              define buffer buf_user-login for ub.user-login .
     3081              find first buf_user-login exclusive-lock
     3082                   where buf_user-login.db-num  = buf_init_user-login.db-num
     3083                     and buf_user-login.user-id = buf_init_user-login.user-id
     3084              no-error .
     3085              buf_user-login.status_ = 0.
     3086              v-deleted = yes.
     3087           end.
     3088           if v-deleted = yes
     3089           then do:
     3090               run open-query-login in this-procedure.
     3091               run manage-fields-login in this-procedure .
     3092           end.
     3093       end.
     3094   END.
