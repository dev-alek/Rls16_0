     3133   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3134   DO:
     3135   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3136   if lookup(self :type
     3137            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3138            ) = 0
     3139   then do:
     3140     message
     3141       "$Workfile$"
     3142       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3143       "Интерфейсный элемент" self :name  skip
     3144       "Тип" self :type  skip
     3145       "Процедура" this-procedure :file-name skip
     3146       view-as alert-box .
     3147   end.
     3148   else do:
     3149     apply "entry":u to self  .
     3150     if focus :handle <> self :handle  then do:
     3151       return no-apply .
     3152     end.
     3153   end.
     3154   run save-position in this-procedure .
     3155   END.
     3156   ON CHOOSE OF b-filter IN FRAME Dialog-Frame
     3157   DO:
     3158       define variable v-accepted      as logical      no-undo.
     3159       run str/usersf.w (
     3160             input parparentproc
     3161           , input v-users-name-filter
     3162           , input v-users-login-filter
     3163           , output v-users-name-filter
     3164           , output v-users-login-filter
     3165           , output fi-filter-comment
     3166           , output v-accepted
     3167       ) no-error.
     3168       if error-status :error
     3169       then do:
     3170           message
     3171                    vss-workfile vss-revision vss-description
     3172               skip(1)
     3173               skip "Ошибка изменения фильтра."
     3174               skip return-value
     3175               skip trim( error-status :get-message( 1 ) )
     3176                    trim( error-status :get-message( 2 ) )
     3177                    trim( error-status :get-message( 3 ) )
     3178           view-as alert-box error.
     3179           undo, return no-apply.
     3180       end.
     3181       if v-accepted = yes
     3182       then do:
     3183           if fi-filter-comment = "":U
     3184           then do:
     3185               assign
     3186                   tb-filter = no
     3187               .
     3188               disable
     3189                   tb-filter
     3190               with frame Dialog-Frame .
     3191           end.
     3192           else do:
     3193               if available buf_init_user-account
     3194               then do:
     3195                   assign
     3196                       v-users-current-rowid = rowid( buf_init_user-account )
     3197                       v-users-current-focus = br-user :focused-row in frame Dialog-Frame
     3198                   .
     3199               end.
     3200               assign
     3201                   tb-filter = yes
     3202               .
     3203               run assign-filter-mark in this-procedure (
     3204                     input v-users-name-filter
     3205                   , input v-users-login-filter
     3206               ).
     3207               enable
     3208                   tb-filter
     3209               with frame Dialog-Frame .
     3210           end.
     3211           display
     3212               fi-filter-comment
     3213               tb-filter
     3214           with frame Dialog-Frame.
     3215           run open-query in this-procedure ( input this-procedure ).
     3216           run manage-fields in this-procedure .
     3217           run open-query-login in this-procedure.
     3218           run manage-fields-login in this-procedure .
     3219       end.
     3220   END.
