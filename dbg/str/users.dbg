     3644       assign
     3645           rs-scope
     3646       .
     3647       if rs-scope <> 1
     3648       and v-cntxt-db-num = 0
     3649       then do:
     3650           assign
     3651               cb-db = -1
     3652           .
     3653           display
     3654               cb-db
     3655           with frame Dialog-Frame .
     3656       end.
     3657       run assign-field-filter-mark in this-procedure (
     3658             input v-users-name-filter
     3659           , input v-users-login-filter
     3660       ).
     3661       run open-query in this-procedure ( input this-procedure ).
     3662       run manage-fields in this-procedure.
     3663       if not error-status :error
     3664       then do:
     3665           apply "value-changed":U to br-user.
     3666       end.
     3667   END.
