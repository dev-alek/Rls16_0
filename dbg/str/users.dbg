      642   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      643   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      644   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      645   procedure uf-name :
      646     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      647     define output parameter p-use-List_     as logical   no-undo .
      648     define output parameter p-type-List_     as character no-undo .
      649     define output parameter p-format-List_   as character no-undo .
      650     define output parameter p-use-Naim      as logical   no-undo .
      651     define output parameter p-type-Naim      as character no-undo .
      652     define output parameter p-format-Naim    as character no-undo .
      653     define output parameter p-use-print-graft as logical   no-undo .
      654     define output parameter p-use-sort-gr   as logical   no-undo .
      655     define output parameter p-use-type-price as logical   no-undo .
      656     define output parameter p-use-type-val  as logical   no-undo .
      657     define output parameter p-label          as character no-undo .
      658     define output parameter p-tooltip        as character no-undo .
      659     define output parameter p-user-can-edit  as logical   no-undo .
      660     define output parameter p-output-display as logical   no-undo .
      661     define output parameter p-other          as character no-undo .
      662     do
