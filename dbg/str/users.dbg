     3829   define variable v-diasize-browse-handle        as handle    no-undo .
     3830   define variable v-diasize-browse-number        as integer   no-undo .
     3831   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3832   define temp-table temp-diasize-handle no-undo
     3833     field handle-value  as handle
     3834     field save-position as decimal
     3835     index xpk is primary unique handle-value
     3836     .
     3837   define temp-table temp-browse-handle no-undo
     3838     field browse-type   as character
     3839     field browse-number as integer
