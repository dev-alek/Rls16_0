     2785   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2786   DO:
     2787       define variable v-user-id                   as character    no-undo.
     2788       define variable v-last-name                 as character    no-undo.
     2789       define variable v-first-name                as character    no-undo.
     2790       define variable v-second-name               as character    no-undo.
