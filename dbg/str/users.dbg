      592   procedure proc-alt-shift-f2:
      593     if not ibs.th.gbl.gbl-var:rcode
      594   then
      595     run gbl\inidebug.p .
      596   end.
      597   procedure proc-alt-shift-f3:
      598     run gbl/prvssinf.p
      599       ( input this-procedure
      600       ) .
      601   end.
      602   define variable v-inform-launched as logical no-undo initial false .
      603   procedure proc-alt-shift-f4:
      604     define variable v-action as character no-undo .
      605     if v-inform-launched = false then do:
      606       assign
      607         v-inform-launched = true
      608       .
      609       run gbl/d-inform.w
      610         (  input self
      611         ,  input this-procedure
      612         , output v-action
      613         ) no-error .
      614       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      615       assign
      616         v-inform-launched = false
      617       .
      618     end.
      619   end.
      620   procedure proc-alt-f1:
      621     run gbl/corrhelp.p
      622       (input this-procedure
      623       ) .
      624   end .
      625   on alt-shift-f2 anywhere do:
      626     run proc-alt-shift-f2.
      627   end.
      628   on alt-shift-f3 anywhere do:
      629     run proc-alt-shift-f3 in this-procedure .
      630   end.
      631   on alt-shift-f4 anywhere do:
      632     run proc-alt-shift-f4 in this-procedure.
      633   end.
      634   on alt-f1 anywhere do:
      635     run proc-alt-f1 in this-procedure .
      636   end.
      637   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
