     3352   ON ROW-DISPLAY OF br-user IN FRAME Dialog-Frame
     3353   DO:
     3354       define variable v-work-status as character no-undo .
     3355       if available buf_init_user-account
     3356       then do:
     3357           if buf_init_user-account.status_ = 1
     3358           then do:
     3359               assign
     3360                   buf_init_user-account.nik        :bgcolor in browse br-user = gray_color
     3361                   buf_init_user-account.last-name  :bgcolor in browse br-user = gray_color
     3362                   buf_init_user-account.first-name :bgcolor in browse br-user = gray_color
     3363                   v-users-user-login      :bgcolor in browse br-user = gray_color
     3364                   buf_init_user-account.user-id    :bgcolor in browse br-user = gray_color
     3365               .
     3366           end.
     3367           else do:
     3368               assign
     3369                   buf_init_user-account.nik        :bgcolor in browse br-user = WHITE_COLOR
     3370                   buf_init_user-account.last-name  :bgcolor in browse br-user = WHITE_COLOR
     3371                   buf_init_user-account.first-name :bgcolor in browse br-user = WHITE_COLOR
     3372                   v-users-user-login      :bgcolor in browse br-user = WHITE_COLOR
     3373                   buf_init_user-account.user-id    :bgcolor in browse br-user = WHITE_COLOR
     3374               .
     3375           end.
     3376           run procedure-get-work-status in this-procedure (
     3377                 input buf_init_user-account.user-id
     3378               , output v-work-status
     3379           ).
     3380           case v-work-status
     3381           :
     3382               when "+":U
     3383               then do:
     3384                   assign
     3385                       buf_init_user-account.nik        :fgcolor in browse br-user = CYAN_COLOR
     3386                       buf_init_user-account.last-name  :fgcolor in browse br-user = CYAN_COLOR
     3387                       buf_init_user-account.first-name :fgcolor in browse br-user = CYAN_COLOR
     3388                       v-users-user-login      :fgcolor in browse br-user = CYAN_COLOR
     3389                       buf_init_user-account.user-id    :fgcolor in browse br-user = CYAN_COLOR
     3390                   .
     3391               end.
     3392               when "*":U
     3393               then do:
     3394                   assign
     3395                       buf_init_user-account.nik        :fgcolor in browse br-user = BLUE_COLOR
     3396                       buf_init_user-account.last-name  :fgcolor in browse br-user = BLUE_COLOR
     3397                       buf_init_user-account.first-name :fgcolor in browse br-user = BLUE_COLOR
     3398                       v-users-user-login      :fgcolor in browse br-user = BLUE_COLOR
     3399                       buf_init_user-account.user-id    :fgcolor in browse br-user = BLUE_COLOR
     3400                   .
     3401               end.
     3402               otherwise do:
     3403               end.
     3404           end case.
     3405       end.
     3406   END.
