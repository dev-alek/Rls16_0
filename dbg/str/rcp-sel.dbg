        1   define input parameter parparentproc        as handle           no-undo.
        2   define input parameter p-input-gds-code     as integer          no-undo.
        3   define input parameter p-input-trn-type     as character        no-undo.
        4   define output parameter p-recipe-code       as character        no-undo.
        5   define output parameter p-is-integration    as logical          no-undo.
        6   define output parameter p-cancel            as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Выбор рецепта для производства товара.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     define variable v-cntxt-db-num        as integer   no-undo .
      129     define variable v-cntxt-userid        as character no-undo .
      130     define variable v-cntxt-level         as character no-undo .
      131     define variable v-cntxt-host-code-obj as integer   no-undo .
      132     define variable v-cntxt-obj-type      as character no-undo .
      133     define variable v-cntxt-obj-code      as integer   no-undo .
      134     define variable v-cntxt-db-num-obj    as integer   no-undo .
      135     define variable v-cntxt-is-admin      as logical   no-undo .
      136   define temp-table temp_recipe no-undo like recipe
      137   .
      138   define variable v-exit-enabled    as logical      no-undo.
      139   DEFINE BUTTON b-exit
      140        LABEL "&Выход"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON b-help
      144        LABEL "Помощ&ь"
      145        SIZE 10 BY 1
      146        BGCOLOR 8 .
      147   DEFINE BUTTON b-sel
      148        LABEL "&Выбор"
      149        SIZE 10 BY 1
      150        BGCOLOR 8 .
      151   DEFINE BUTTON b-view
      152        LABEL "&Просмотр"
      153        SIZE 10 BY 1
      154        BGCOLOR 8 .
      155   DEFINE QUERY BROWSE-1 FOR
      156         temp_recipe SCROLLING.
      157   DEFINE BROWSE BROWSE-1
      158     QUERY BROWSE-1 SHARE-LOCK NO-WAIT DISPLAY
      159         temp_recipe.recipe-code format "X(10)" label "Номер"
      160         temp_recipe.recipe-name format "X(40)" label "Наименование рецепта"
      161         temp_recipe.recipe-type format "X(15)" label "Тип рецепта"
      162       WITH NO-ROW-MARKERS SEPARATORS SIZE 70 BY 17.71.
      163   DEFINE FRAME Dialog-Frame
      164        b-exit AT ROW 1.17 COL 2
      165        b-sel AT ROW 1.17 COL 12
      166        b-view AT ROW 1.17 COL 22
      167        b-help AT ROW 1.17 COL 62.13
      168        BROWSE-1 AT ROW 2.38 COL 2.13
      169        SPACE(0.99) SKIP(0.28)
      170       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      171            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      172            TITLE "Выбор рецепта для товара"
      173            DEFAULT-BUTTON b-sel.
      174   ASSIGN
      175          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      176          FRAME Dialog-Frame:HIDDEN           = TRUE.
      177   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      178   DO:
      179       if v-exit-enabled = yes
      180       then do:
      181           APPLY "END-ERROR":U TO SELF.
      182       end.
      183   END.
      184   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      185   DO:
      186       assign
      187           p-cancel = yes
      188           v-exit-enabled = yes
      189       .
      190       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      191   END.
      192   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      193   DO:
      194       assign
      195           v-exit-enabled  = yes
      196           p-recipe-code   = temp_recipe.recipe-code
      197       .
      198       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      199   END.
      200   ON CHOOSE OF b-view IN FRAME Dialog-Frame
      201   DO:
      202       run view-recipe in this-procedure (
      203           input temp_recipe.recipe-code
      204       ).
      205       apply "entry" to browse-1.
      206   END.
      207   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   on help of frame Dialog-Frame
      209   do:
      210     run gbl/app_help.p
      211       (input this-procedure :file-name
      212       ,input ''
      213       ,input ?
      214       ) no-error.
      215     if error-status :error then do:
      216       message
      217         "Ошибка при вызове помощи"
      218         error-status :get-message(1)
      219         view-as alert-box .
      220     end.
      221   end.
      222   run minbtn-set in this-procedure .
      223   on choose of b-help in frame Dialog-Frame
      224   do:
      225     apply "help":u to frame Dialog-Frame .
      226   end.
      227   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   procedure minbtn-set :
      229       do
      230           on error undo, return error return-value
      231           :
      232           define variable ii              as integer       no-undo .
      233           define variable fh              as widget-handle no-undo .
      234           define variable hh              as widget-handle no-undo .
      235           define variable v-h             as handle        extent 4 no-undo .
      236           define variable v-name-button   as character     no-undo .
      237           define variable v-help-old-x    as decimal       no-undo .
      238           define variable v-help-old-y    as decimal       no-undo .
      239           define variable v-help-old-size as decimal       no-undo .
      240           define variable v-frame-width   as decimal       no-undo .
      241           define variable jj              as integer       no-undo .
      242           do
      243               on error undo, return error
      244               :
      245               assign
      246                   v-frame-width = frame Dialog-Frame:width - 0.3
      247                   fh            = frame Dialog-Frame:first-child
      248                   hh            = fh:first-child
      249                   ii            = 1
      250                   .
      251               do while valid-handle(hh):
      252                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      253                   do:
      254                       case lc(hh:name) :
      255                           when "b-help" then
      256                               do:
      257                                   hh:load-image-up("cmp/b-help.bmp":u) .
      258                                   hh:load-image-down("cmp/b-help.bmp":u) .
      259                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      260                                   hh:TOOLTIP = "Помощь" .
      261                                   v-help-old-x = hh:column .
      262                                   v-help-old-y = hh:row    .
      263                                   v-help-old-size = hh:width .
      264                                   hh:width-chars = 2.5 .
      265                               end.
      266                           when "b-print" then
      267                               do:
      268                                   hh:load-image("cmp/b-print.bmp":u) .
      269                                   hh:TOOLTIP = "Печать" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-history" or
      275                           when "b-hist" then
      276                               do:
      277                                   hh:load-image("cmp/b-hist.bmp":u) .
      278                                   hh:TOOLTIP = "История" .
      279                                   v-h[ii] = hh:handle .
      280                                   ii = ii + 1 .
      281                                   hh:width-chars = 3 .
      282                               end.
      283                           when "b-sch" then
      284                               do:
      285                                   hh:load-image("cmp/b-sch.bmp":u) .
      286                                   hh:TOOLTIP = "Установка Фильтра" .
      287                                   v-h[ii] = hh:handle .
      288                                   ii = ii + 1 .
      289                                   hh:width-chars = 3 .
      290                               end.
      291                           when "b-hist-user" then
      292                               do:
      293                                   hh:load-image("cmp/b-hist.bmp":u) .
      294                                   hh:TOOLTIP = "История пользователя" .
      295                                   ii = ii + 1 .
      296                               end.
      297                       end case.
      298                   end.
      299                   hh = hh:next-sibling.
      300               end.
      301               b-help:column = v-frame-width - b-help:width-chars.
      302               jj = 0.
      303               repeat ii = 4 to 1 by -1 :
      304                   if valid-handle (v-h[ii] ) then
      305                   do:
      306                       jj  = jj + 1 .
      307                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      308                       v-h[ii]:row    = v-help-old-y .
      309                   end.
      310               end.
      311           end.
      312       end.
      313   end procedure.
      314   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      315   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      316   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      317   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      318   define variable v-diasize-current-frame-width  as decimal   no-undo .
      319   define variable v-diasize-current-frame-height as decimal   no-undo .
      320   define variable v-diasize-change-size          as logical   no-undo .
      321   define variable v-diasize-resize-button        as handle    no-undo .
      322   define variable v-diasize-wndmax               as logical   no-undo .
      323   define variable v-diasize-wndstore             as logical   no-undo .
      324   define variable v-diasize-proc-name            as character no-undo .
      325   define variable v-diasize-browse-handle        as handle    no-undo .
      326   define variable v-diasize-browse-number        as integer   no-undo .
      327   define variable v-diasize-need-full-display    as logical   no-undo init false .
      328   define temp-table temp-diasize-handle no-undo
      329     field handle-value  as handle
      330     field save-position as decimal
      331     index xpk is primary unique handle-value
      332     .
      333   define temp-table temp-browse-handle no-undo
      334     field browse-type   as character
      335     field browse-number as integer
      336     field browse-handle as handle
      337     field original-size as decimal
      338     index xpk is primary unique browse-type browse-number
      339     index xie browse-type browse-handle
      340   .
      341   procedure diasize_change-height :
      342     define input  parameter p-change-value  as decimal   no-undo .
      343     define input  parameter p-move-resize   as logical   no-undo .
      344     define variable v-field-group-handle    as handle    no-undo .
      345     define variable v-object-handle         as handle    no-undo .
      346     define variable v-frame-height          as decimal   no-undo .
      347     define variable v-frame-virtual-height  as decimal   no-undo .
      348     define variable v-browse-height         as decimal   no-undo .
      349     define variable v-window-height         as decimal   no-undo .
      350     define variable v-window-virtual-height as decimal   no-undo .
      351     define variable v-change-sign           as integer   no-undo .
      352     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      353     define buffer buf_temp-browse-handle  for temp-browse-handle .
      354     if p-change-value > 0
      355     then do:
      356       if frame Dialog-Frame :height + p-change-value
      357           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      358       then do:
      359         assign
      360           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      361                           - (frame Dialog-Frame :height-chars)
      362         .
      363         if p-change-value <= 0
      364         then do:
      365           run diasize_position-resize-button in this-procedure .
      366           return .
      367         end.
      368       end.
      369     end.
      370     if p-change-value < 0
      371     then do:
      372       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      373       then do:
      374         assign
      375           p-change-value = v-diasize-orig-frame-height
      376                          - (frame Dialog-Frame :height-chars)
      377         .
      378         if p-change-value >= 0
      379         then do:
      380           run diasize_position-resize-button in this-procedure .
      381           return .
      382         end.
      383       end.
      384     end.
      385     if p-change-value >= 0
      386     then do:
      387       assign
      388         v-change-sign = 1
      389       .
      390     end.
      391     else do:
      392       assign
      393         v-change-sign = -1
      394       .
      395     end.
      396     assign
      397       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      398     .
      399     if p-change-value = 0
      400     then do:
      401       run diasize_position-resize-button in this-procedure .
      402       return .
      403     end.
      404     move_block:
      405     do
      406     on error undo move_block, retry move_block
      407     :
      408       if retry
      409       then do:
      410         do
      411         on error undo move_block, leave move_block
      412         :
      413           if p-change-value > 0
      414           then do:
      415             for each buf_temp-diasize-handle
      416             on error undo, next
      417             :
      418               assign
      419                 v-object-handle = buf_temp-diasize-handle.handle-value
      420               .
      421               if v-object-handle <> v-diasize-resize-button
      422               then do:
      423                 assign
      424                   v-object-handle :row = buf_temp-diasize-handle.save-position
      425                 .
      426               end.
      427             end.
      428             assign
      429               v-diasize-browse-handle :height = v-browse-height
      430             .
      431             for each buf_temp-browse-handle
      432               where buf_temp-browse-handle.browse-type = 'height':u
      433             on error undo, next
      434             :
      435               assign
      436                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      437               .
      438             end.
      439             assign
      440               frame Dialog-Frame :height = v-frame-height
      441             .
      442             if frame Dialog-Frame :scrollable = true
      443             then do:
      444               assign
      445                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      446               .
      447             end.
      448             run diasize_position-resize-button in this-procedure .
      449           end.
      450           else do:
      451             if frame Dialog-Frame :scrollable = true
      452             then do:
      453               assign
      454                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      455               .
      456             end.
      457             assign
      458               frame Dialog-Frame :height = v-frame-height
      459             .
      460             assign
      461               v-diasize-browse-handle :height = v-browse-height
      462             .
      463             for each buf_temp-browse-handle
      464               where buf_temp-browse-handle.browse-type = 'height':u
      465             on error undo, next
      466             :
      467               assign
      468                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      469               .
      470             end.
      471             for each buf_temp-diasize-handle
      472             on error undo, next
      473             :
      474               assign
      475                 v-object-handle = buf_temp-diasize-handle.handle-value
      476               .
      477               if v-object-handle <> v-diasize-resize-button
      478               then do:
      479                 assign
      480                   v-object-handle :row = buf_temp-diasize-handle.save-position
      481                 .
      482               end.
      483             end.
      484             run diasize_position-resize-button in this-procedure .
      485           end.
      486           assign
      487             v-diasize-change-size = false
      488           .
      489           leave move_block .
      490         end.
      491       end.
      492       assign
      493         v-diasize-need-full-display = true
      494       .
      495       if v-diasize-change-size = false
      496       then do:
      497         assign
      498           v-diasize-change-size = true
      499         .
      500       end.
      501       else do:
      502         return .
      503       end.
      504       assign
      505         v-frame-height = frame Dialog-Frame :height
      506         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      507         v-browse-height = v-diasize-browse-handle :height
      508       .
      509       for each buf_temp-browse-handle
      510         where buf_temp-browse-handle.browse-type = 'height':u
      511       :
      512         assign
      513           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      514         .
      515       end.
      516       for each buf_temp-diasize-handle
      517       :
      518         delete buf_temp-diasize-handle .
      519       end.
      520       assign
      521         v-field-group-handle = frame Dialog-Frame :first-child
      522       .
      523       do while valid-handle(v-field-group-handle)
      524       :
      525         assign
      526           v-object-handle = v-field-group-handle :first-child
      527         .
      528         do while valid-handle(v-object-handle)
      529         :
      530           if  v-object-handle <> v-diasize-browse-handle :handle
      531           and can-query(v-object-handle, "row")
      532           and can-query(v-object-handle, "height")
      533           and ( v-object-handle :row > v-diasize-browse-handle :row )
      534           then do:
      535             find first buf_temp-browse-handle
      536               where buf_temp-browse-handle.browse-type   = 'height':u
      537                 and buf_temp-browse-handle.browse-handle = v-object-handle
      538               no-error .
      539             if available buf_temp-browse-handle
      540             then do:
      541             end.
      542             else do:
      543               create buf_temp-diasize-handle .
      544               assign
      545                 buf_temp-diasize-handle.handle-value  = v-object-handle
      546                 buf_temp-diasize-handle.save-position = v-object-handle :row
      547               .
      548             end.
      549           end.
      550           assign
      551             v-object-handle = v-object-handle :next-sibling
      552           .
      553         end.
      554         assign
      555           v-field-group-handle = v-field-group-handle :next-sibling
      556         .
      557       end.
      558       do with frame Dialog-Frame
      559       :
      560         hide v-diasize-resize-button .
      561         assign
      562           v-diasize-resize-button :row    = 1
      563           v-diasize-resize-button :column = 1
      564         .
      565       end.
      566       if p-change-value > 0
      567       then do:
      568         if frame Dialog-Frame :scrollable = true
      569         then do:
      570           assign
      571             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      572             no-error .
      573           if error-status :error
      574           or error-status :get-message(1) <> ""
      575           then do:
      576             undo move_block, retry move_block .
      577           end.
      578         end.
      579         assign
      580           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      581           no-error .
      582         if error-status :error
      583         or error-status :get-message(1) <> ""
      584         then do:
      585           undo move_block, retry move_block .
      586         end.
      587         assign
      588           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      589           no-error .
      590         if error-status :error
      591         or error-status :get-message(1) <> ""
      592         then do:
      593           undo move_block, retry move_block .
      594         end.
      595         for each buf_temp-browse-handle
      596           where buf_temp-browse-handle.browse-type = 'height':u
      597         on error undo move_block, retry move_block
      598         :
      599           assign
      600             buf_temp-browse-handle.browse-handle :height
      601               = buf_temp-browse-handle.browse-handle :height + p-change-value
      602             no-error .
      603           if error-status :error
      604           or error-status :get-message(1) <> ""
      605           then do:
      606             undo move_block, retry move_block .
      607           end.
      608         end.
      609         for each buf_temp-diasize-handle
      610         on error undo move_block, retry move_block
      611         :
      612           assign
      613             v-object-handle = buf_temp-diasize-handle.handle-value
      614           .
      615           if v-object-handle <> v-diasize-resize-button
      616           then do:
      617             assign
      618               v-object-handle :row = v-object-handle :row + p-change-value
      619               no-error .
      620             if error-status :error
      621             or error-status :get-message(1) <> ""
      622             then do:
      623               undo move_block, retry move_block .
      624             end.
      625           end.
      626         end.
      627       end.
      628       else do:
      629         for each buf_temp-diasize-handle
      630         on error undo move_block, retry move_block
      631         :
      632           assign
      633             v-object-handle = buf_temp-diasize-handle.handle-value
      634           .
      635           if v-object-handle <> v-diasize-resize-button
      636           then do:
      637             assign
      638               v-object-handle :row = v-object-handle :row + p-change-value
      639               no-error .
      640             if error-status :error
      641             or error-status :get-message(1) <> ""
      642             then do:
      643               undo move_block, retry move_block .
      644             end.
      645           end.
      646         end.
      647         assign
      648           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      649           no-error .
      650         if error-status :error
      651         or error-status :get-message(1) <> ""
      652         then do:
      653           undo move_block, retry move_block .
      654         end.
      655         for each buf_temp-browse-handle
      656           where buf_temp-browse-handle.browse-type = 'height':u
      657         on error undo move_block, retry move_block
      658         :
      659           assign
      660             buf_temp-browse-handle.browse-handle :height
      661               = buf_temp-browse-handle.browse-handle :height + p-change-value
      662             no-error .
      663           if error-status :error
      664           or error-status :get-message(1) <> ""
      665           then do:
      666             undo move_block, retry move_block .
      667           end.
      668         end.
      669         assign
      670           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      671           no-error .
      672         if error-status :error
      673         or error-status :get-message(1) <> ""
      674         then do:
      675           undo move_block, retry move_block .
      676         end.
      677         if frame Dialog-Frame :scrollable = true
      678         then do:
      679           assign
      680             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      681             no-error .
      682           if error-status :error
      683           or error-status :get-message(1) <> ""
      684           then do:
      685             undo move_block, retry move_block .
      686           end.
      687         end.
      688       end.
      689       if p-move-resize = true
      690       then do:
      691         run diasize_position-resize-button in this-procedure .
      692       end.
      693       if v-diasize-wndstore = true
      694       then do:
      695         if connected("ub") = true
      696         then do:
      697           define variable v-cntxt-db-num        as integer   no-undo .
      698           define variable v-cntxt-userid        as character no-undo .
      699           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      700                                             , OUTPUT v-cntxt-userid
      701                                             ) .
      702           run gbl/wndsizew.p
      703             (input  v-cntxt-db-num
      704             ,input  v-cntxt-userid
      705             ,input  v-diasize-proc-name
      706             ,input  'height':u
      707             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      708             ) .
      709         end.
      710       end.
      711     end.
      712     assign
      713       v-diasize-change-size = false
      714     .
      715   end procedure.
      716   procedure diasize_set-height :
      717     define input  parameter p-new-height  as decimal   no-undo .
      718     define input  parameter p-move-resize as logical   no-undo .
      719     do
      720     on error undo, return error return-value
      721     :
      722       run diasize_change-height in this-procedure
      723         (input  (p-new-height - frame Dialog-Frame :height)
      724         ,input  p-move-resize
      725         ) .
      726     end.
      727   end procedure.
      728   procedure diasize_change-width :
      729     define input  parameter p-change-value as decimal   no-undo .
      730     define input  parameter p-move-resize  as logical   no-undo .
      731     define variable v-field-group-handle   as handle    no-undo .
      732     define variable v-object-handle        as handle    no-undo .
      733     define variable v-frame-width          as decimal   no-undo .
      734     define variable v-frame-virtual-width  as decimal   no-undo .
      735     define variable v-browse-width         as decimal   no-undo .
      736     define variable v-window-width         as decimal   no-undo .
      737     define variable v-window-virtual-width as decimal   no-undo .
      738     define variable v-change-sign          as integer   no-undo .
      739     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      740     define buffer buf_temp-browse-handle  for temp-browse-handle .
      741     if p-change-value > 0
      742     then do:
      743       if frame Dialog-Frame :width + p-change-value >
      744           session :width-chars
      745       then do:
      746         assign
      747           p-change-value = session :width-chars - frame Dialog-Frame :width
      748         .
      749         if p-change-value <= 0
      750         then do:
      751           run diasize_position-resize-button in this-procedure .
      752           return .
      753         end.
      754       end.
      755     end.
      756     if p-change-value < 0
      757     then do:
      758       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      759       then do:
      760         assign
      761           p-change-value = v-diasize-orig-frame-width
      762                          - frame Dialog-Frame :width
      763         .
      764         if p-change-value >= 0
      765         then do:
      766           run diasize_position-resize-button in this-procedure .
      767           return .
      768         end.
      769       end.
      770     end.
      771     if p-change-value >= 0
      772     then do:
      773       assign
      774         v-change-sign = 1
      775       .
      776     end.
      777     else do:
      778       assign
      779         v-change-sign = -1
      780       .
      781     end.
      782     assign
      783       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      784     .
      785     if p-change-value = 0
      786     then do:
      787       run diasize_position-resize-button in this-procedure .
      788       return .
      789     end.
      790     move_block:
      791     do
      792     on error undo move_block, leave move_block
      793     :
      794       if retry
      795       then do:
      796         do
      797         on error undo move_block, leave move_block
      798         :
      799           if p-change-value > 0
      800           then do:
      801             for each buf_temp-diasize-handle
      802             on error undo, next
      803             :
      804               assign
      805                 v-object-handle = buf_temp-diasize-handle.handle-value
      806               .
      807               if v-object-handle <> v-diasize-resize-button
      808               then do:
      809                 assign
      810                   v-object-handle :col = buf_temp-diasize-handle.save-position
      811                 .
      812               end.
      813             end.
      814             assign
      815               v-diasize-browse-handle :width = v-browse-width
      816             .
      817             for each buf_temp-browse-handle
      818               where buf_temp-browse-handle.browse-type = 'width':u
      819             on error undo, next
      820             :
      821               assign
      822                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      823               .
      824             end.
      825             assign
      826               frame Dialog-Frame :width = v-frame-width
      827             .
      828             if frame Dialog-Frame :scrollable = true
      829             then do:
      830               assign
      831                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      832               .
      833             end.
      834             run diasize_position-resize-button in this-procedure .
      835           end.
      836           else do:
      837             if frame Dialog-Frame :scrollable = true
      838             then do:
      839               assign
      840                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      841               .
      842             end.
      843             assign
      844               frame Dialog-Frame :width = v-frame-width
      845             .
      846             for each buf_temp-browse-handle
      847               where buf_temp-browse-handle.browse-type = 'width':u
      848             on error undo, next
      849             :
      850               assign
      851                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      852               .
      853             end.
      854             assign
      855               v-diasize-browse-handle :width = v-browse-width
      856             .
      857             for each buf_temp-diasize-handle
      858             on error undo, next
      859             :
      860               assign
      861                 v-object-handle = buf_temp-diasize-handle.handle-value
      862               .
      863               if v-object-handle <> v-diasize-resize-button
      864               then do:
      865                 assign
      866                   v-object-handle :col = buf_temp-diasize-handle.save-position
      867                 .
      868               end.
      869             end.
      870             run diasize_position-resize-button in this-procedure .
      871           end.
      872           assign
      873             v-diasize-change-size = false
      874           .
      875           leave move_block .
      876         end.
      877       end.
      878       assign
      879         v-diasize-need-full-display = true
      880       .
      881       if v-diasize-change-size = false
      882       then do:
      883         assign
      884           v-diasize-change-size = true
      885         .
      886       end.
      887       else do:
      888         return .
      889       end.
      890       assign
      891         v-frame-width = frame Dialog-Frame :width
      892         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      893         v-browse-width = v-diasize-browse-handle :width
      894       .
      895       for each buf_temp-browse-handle
      896         where buf_temp-browse-handle.browse-type = 'width':u
      897       :
      898         assign
      899           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      900         .
      901       end.
      902       for each buf_temp-diasize-handle
      903       :
      904         delete buf_temp-diasize-handle .
      905       end.
      906       assign
      907         v-field-group-handle = frame Dialog-Frame :first-child
      908       .
      909       do while valid-handle(v-field-group-handle)
      910       :
      911         assign
      912           v-object-handle = v-field-group-handle :first-child
      913         .
      914         do while valid-handle(v-object-handle)
      915         :
      916           if  v-object-handle <> v-diasize-browse-handle :handle
      917           and v-object-handle <> v-diasize-resize-button
      918           and can-query(v-object-handle, "row")
      919           and can-query(v-object-handle, "height")
      920           and ( v-object-handle :col + v-object-handle :width
      921                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      922               )
      923           then do:
      924             find first buf_temp-browse-handle
      925               where buf_temp-browse-handle.browse-type   = 'width':u
      926                 and buf_temp-browse-handle.browse-handle = v-object-handle
      927               no-error .
      928             if available buf_temp-browse-handle
      929             then do:
      930             end.
      931             else do:
      932               create buf_temp-diasize-handle .
      933               assign
      934                 buf_temp-diasize-handle.handle-value  = v-object-handle
      935                 buf_temp-diasize-handle.save-position = v-object-handle :col
      936               .
      937             end.
      938           end.
      939           assign
      940             v-object-handle = v-object-handle :next-sibling
      941           .
      942         end.
      943         assign
      944           v-field-group-handle = v-field-group-handle :next-sibling
      945         .
      946       end.
      947       do with frame Dialog-Frame
      948       :
      949         hide v-diasize-resize-button .
      950         v-diasize-resize-button :row = 1.
      951         v-diasize-resize-button :column = 1.
      952       end.
      953       if p-change-value > 0
      954       then do:
      955         if frame Dialog-Frame :scrollable = true
      956         then do:
      957           assign
      958             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      959             no-error .
      960           if error-status :error
      961           or error-status :get-message(1) <> ""
      962           then do:
      963             undo move_block, retry move_block.
      964           end.
      965         end.
      966         assign
      967           frame Dialog-Frame :width = v-frame-width + p-change-value
      968           no-error .
      969         if error-status :error
      970         or error-status :get-message(1) <> ""
      971         then do:
      972           undo move_block, retry move_block.
      973         end.
      974         assign
      975           v-diasize-browse-handle :width = v-browse-width + p-change-value
      976         no-error .
      977         if error-status :error
      978         or error-status :get-message(1) <> ""
      979         then do:
      980           undo move_block, retry move_block.
      981         end.
      982         for each buf_temp-browse-handle
      983           where buf_temp-browse-handle.browse-type = 'width':u
      984         on error undo move_block, retry move_block
      985         :
      986           assign
      987             buf_temp-browse-handle.browse-handle :width
      988               = buf_temp-browse-handle.browse-handle :width + p-change-value
      989             no-error .
      990           if error-status :error
      991           or error-status :get-message(1) <> ""
      992           then do:
      993             undo move_block, retry move_block .
      994           end.
      995         end.
      996         for each buf_temp-diasize-handle
      997         on error undo move_block, retry move_block
      998         :
      999           assign
     1000             v-object-handle = buf_temp-diasize-handle.handle-value
     1001           .
     1002           if v-object-handle <> v-diasize-resize-button
     1003           then do:
     1004             assign
     1005               v-object-handle :col = v-object-handle :col + p-change-value
     1006               no-error .
     1007             if error-status :error
     1008             or error-status :get-message(1) <> ""
     1009             then do:
     1010               undo move_block, retry move_block .
     1011             end.
     1012           end.
     1013         end.
     1014       end.
     1015       else do:
     1016         for each buf_temp-diasize-handle
     1017         on error undo move_block, retry move_block
     1018         :
     1019           assign
     1020             v-object-handle = buf_temp-diasize-handle.handle-value
     1021           .
     1022           if v-object-handle <> v-diasize-resize-button
     1023           then do:
     1024             assign
     1025               v-object-handle :col = v-object-handle :col + p-change-value
     1026               no-error .
     1027             if error-status :error
     1028             or error-status :get-message(1) <> ""
     1029             then do:
     1030               undo move_block, retry move_block .
     1031             end.
     1032           end.
     1033         end.
     1034         for each buf_temp-browse-handle
     1035           where buf_temp-browse-handle.browse-type = 'width':u
     1036         on error undo move_block, retry move_block
     1037         :
     1038           assign
     1039             buf_temp-browse-handle.browse-handle :width
     1040               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1041             no-error .
     1042           if error-status :error
     1043           or error-status :get-message(1) <> ""
     1044           then do:
     1045             undo move_block, retry move_block .
     1046           end.
     1047         end.
     1048         assign
     1049           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1050           no-error .
     1051         if error-status :error
     1052         or error-status :get-message(1) <> ""
     1053         then do:
     1054           undo move_block, retry move_block.
     1055         end.
     1056         assign
     1057           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1058         no-error .
     1059         if error-status :error
     1060         or error-status :get-message(1) <> ""
     1061         then do:
     1062           undo move_block, retry move_block.
     1063         end.
     1064         if frame Dialog-Frame :scrollable = true
     1065         then do:
     1066           assign
     1067             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1068           no-error .
     1069           if error-status :error
     1070           or error-status :get-message(1) <> ""
     1071           then do:
     1072             undo move_block, retry move_block.
     1073           end.
     1074         end.
     1075       end.
     1076       if p-move-resize
     1077       then do:
     1078         run diasize_position-resize-button in this-procedure .
     1079       end.
     1080       if v-diasize-wndstore = true
     1081       then do:
     1082         if connected("ub") = true
     1083         then do:
     1084           define variable v-cntxt-db-num        as integer   no-undo .
     1085           define variable v-cntxt-userid        as character no-undo .
     1086           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1087                                             , OUTPUT v-cntxt-userid
     1088                                             ) .
     1089           run gbl/wndsizew.p
     1090             (input  v-cntxt-db-num
     1091             ,input  v-cntxt-userid
     1092             ,input  v-diasize-proc-name
     1093             ,input  'width':u
     1094             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1095             ) .
     1096         end.
     1097       end.
     1098     end.
     1099     assign
     1100       v-diasize-change-size = false
     1101     .
     1102   end procedure.
     1103   procedure diasize_set-width :
     1104     define input  parameter p-new-width  as decimal   no-undo .
     1105     define input  parameter p-move-resize as logical   no-undo .
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       run diasize_change-width in this-procedure
     1110         (input  (p-new-width - frame Dialog-Frame :width)
     1111         ,input  p-move-resize
     1112         ) .
     1113     end.
     1114   end procedure.
     1115   procedure diasize_position-resize-button :
     1116     do with frame Dialog-Frame
     1117     :
     1118       hide v-diasize-resize-button .
     1119       assign
     1120         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1121                     - 1
     1122                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1123         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1124                     - 1
     1125                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1126       .
     1127       view v-diasize-resize-button .
     1128     end.
     1129   end procedure.
     1130   on alt-right anywhere
     1131   do:
     1132     run diasize_change-width in this-procedure
     1133       (input 1
     1134       ,input true
     1135       ) .
     1136     return no-apply .
     1137   end.
     1138   on alt-left anywhere
     1139   do:
     1140     run diasize_change-width in this-procedure
     1141       (input -1
     1142       ,input true
     1143       ) .
     1144     return no-apply .
     1145   end.
     1146   on alt-down anywhere
     1147   do:
     1148     run diasize_change-height in this-procedure
     1149       (input 1
     1150       ,input true
     1151       ) .
     1152     return no-apply .
     1153   end.
     1154   on alt-up anywhere
     1155   do:
     1156     run diasize_change-height in this-procedure
     1157       (input -1
     1158       ,input true
     1159       ) .
     1160     return no-apply .
     1161   end.
     1162   on alt-enter of frame Dialog-Frame
     1163   do:
     1164     run diasize_maximize in this-procedure
     1165       (input  ?
     1166       ).
     1167     return no-apply .
     1168   end.
     1169   procedure diasize_end-move :
     1170     do
     1171     on error undo, return error return-value
     1172     :
     1173       define variable v-row-delta as decimal   no-undo .
     1174       define variable v-col-delta as decimal   no-undo .
     1175       define variable v-new-row as decimal   no-undo .
     1176       define variable v-new-col as decimal   no-undo .
     1177       assign
     1178         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1179         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1180       .
     1181       assign
     1182         v-row-delta = v-new-row - frame Dialog-Frame :height
     1183         v-col-delta = v-new-col - frame Dialog-Frame :width
     1184       .
     1185       run diasize_change-height in this-procedure
     1186         (input v-row-delta
     1187         ,input true
     1188         ) .
     1189       run diasize_change-width in this-procedure
     1190         (input v-col-delta
     1191         ,input true
     1192         ) .
     1193     end.
     1194   end procedure.
     1195   procedure diasize_maximize :
     1196     define input  parameter p-action as logical   no-undo .
     1197     do
     1198     on error undo, return error return-value
     1199     :
     1200       if p-action = ?
     1201       then do:
     1202         if v-diasize-need-maximize = true
     1203         then do:
     1204           assign
     1205             p-action = true
     1206           .
     1207         end.
     1208         else do:
     1209           assign
     1210             p-action = false
     1211           .
     1212         end.
     1213       end.
     1214       if p-action = true
     1215       then do:
     1216         run diasize_change-height in this-procedure
     1217           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1218               - frame Dialog-Frame :height-chars
     1219           ,input true
     1220           ) .
     1221         run diasize_change-width in this-procedure
     1222           (input session :width-chars
     1223               - frame Dialog-Frame :width-chars
     1224           ,input true
     1225           ) .
     1226         assign
     1227           v-diasize-need-maximize = false
     1228         .
     1229       end.
     1230       else do:
     1231         run diasize_change-width in this-procedure
     1232           (input v-diasize-orig-frame-width
     1233               - frame Dialog-Frame :width-chars
     1234           ,input true
     1235           ) .
     1236         run diasize_change-height in this-procedure
     1237           (input v-diasize-orig-frame-height
     1238               - frame Dialog-Frame :height-chars
     1239           ,input true
     1240           ) .
     1241         assign
     1242           v-diasize-need-maximize = true
     1243         .
     1244       end.
     1245     end.
     1246   end procedure.
     1247   procedure diasize_restore-orig-size :
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       assign
     1252         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1253         v-diasize-current-frame-height = frame Dialog-Frame :height
     1254       .
     1255       run diasize_set-height in this-procedure
     1256         (input  v-diasize-orig-frame-height
     1257         ,input  true
     1258         ) .
     1259       run diasize_set-width in this-procedure
     1260         (input  v-diasize-orig-frame-width
     1261         ,input  true
     1262         ) .
     1263     end.
     1264   end procedure.
     1265   procedure diasize_restore-current-size :
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       run diasize_set-height in this-procedure
     1270         (input  v-diasize-current-frame-height
     1271         ,input  true
     1272         ) .
     1273       run diasize_set-width in this-procedure
     1274         (input  v-diasize-current-frame-width
     1275         ,input  true
     1276         ) .
     1277     end.
     1278   end procedure.
     1279   procedure diasize_set-browse-handle :
     1280     define input  parameter p-browse-handle as handle   no-undo .
     1281     define buffer buf_temp-browse-handle for temp-browse-handle .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       assign
     1286         v-diasize-browse-handle = p-browse-handle
     1287       .
     1288       for each buf_temp-browse-handle
     1289       on error undo, return error return-value
     1290       :
     1291         delete buf_temp-browse-handle .
     1292       end.
     1293     end.
     1294   end procedure.
     1295   procedure diasize_add_browse :
     1296     define input  parameter p-browse-type   as character no-undo .
     1297     define input  parameter p-browse-handle as handle    no-undo .
     1298     define buffer buf_temp-browse-handle for temp-browse-handle .
     1299     do
     1300     on error undo, return error return-value
     1301     :
     1302       assign
     1303         v-diasize-browse-number = v-diasize-browse-number + 1
     1304       .
     1305       create buf_temp-browse-handle .
     1306       assign
     1307         buf_temp-browse-handle.browse-type   = p-browse-type
     1308         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1309         buf_temp-browse-handle.browse-handle = p-browse-handle
     1310       .
     1311     end.
     1312   end procedure.
     1313   procedure diasize_init :
     1314     define variable v-default-value    as logical   no-undo .
     1315     define variable v-restore-saved    as logical   no-undo .
     1316     define variable v-resize-value-str as character no-undo .
     1317     do
     1318     on error undo, return error return-value
     1319     :
     1320       do with frame Dialog-Frame
     1321       :
     1322         assign
     1323           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1324           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1325           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1326         .
     1327         create button v-diasize-resize-button
     1328         assign
     1329           parent        = frame Dialog-Frame :first-child
     1330           label         = "s"
     1331           height-pixels = 16
     1332           width-pixels  = 16
     1333           visible       = true
     1334           sensitive     = true
     1335           movable       = true
     1336           triggers:
     1337             on end-move persistent run diasize_end-move in this-procedure .
     1338           end triggers.
     1339         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1340         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1341         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1342         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1343         assign
     1344           v-diasize-wndmax = false
     1345         .
     1346         if connected("ub") = true
     1347         then do:
     1348           define variable v-cntxt-db-num        as integer   no-undo .
     1349           define variable v-cntxt-userid        as character no-undo .
     1350           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1351                                             , OUTPUT v-cntxt-userid
     1352                                             ) .
     1353           run gbl/wndpar_r.p
     1354             (input  v-cntxt-db-num
     1355             ,input  v-cntxt-userid
     1356             ,input  'wndmax':U
     1357             ,output v-diasize-wndmax
     1358             ,output v-default-value
     1359             ) .
     1360         end.
     1361         assign
     1362           v-diasize-wndstore = false
     1363         .
     1364         if connected("ub") = true
     1365         then do:
     1366           run gbl/wndpar_r.p
     1367             (input  v-cntxt-db-num
     1368             ,input  v-cntxt-userid
     1369             ,input  'wndstore':U
     1370             ,output v-diasize-wndstore
     1371             ,output v-default-value
     1372             ) .
     1373         end.
     1374         assign
     1375           v-diasize-proc-name = entry(1, program-name(2), '.')
     1376         .
     1377         if v-diasize-wndstore = true
     1378         then do:
     1379           assign
     1380             v-restore-saved = false
     1381           .
     1382           if connected("ub") = true
     1383           then do:
     1384             run gbl/wndsizer.p
     1385               (input  v-cntxt-db-num
     1386               ,input  v-cntxt-userid
     1387               ,input  v-diasize-proc-name
     1388               ,input  'height':u
     1389               ,output v-resize-value-str
     1390               ) .
     1391             if v-resize-value-str <> '':U
     1392             then do:
     1393               run diasize_change-height in this-procedure
     1394                 (input  integer(v-resize-value-str)
     1395                 ,input  true
     1396                 ) .
     1397               assign
     1398                 v-restore-saved = true
     1399               .
     1400             end.
     1401           end.
     1402           if connected("ub") = true
     1403           then do:
     1404             run gbl/wndsizer.p
     1405               (input  v-cntxt-db-num
     1406               ,input  v-cntxt-userid
     1407               ,input  v-diasize-proc-name
     1408               ,input  'width':u
     1409               ,output v-resize-value-str
     1410               ) .
     1411             if v-resize-value-str <> '':U
     1412             then do:
     1413               run diasize_change-width in this-procedure
     1414                 (input  integer(v-resize-value-str)
     1415                 ,input  true
     1416                 ) .
     1417               assign
     1418                 v-restore-saved = true
     1419               .
     1420             end.
     1421           end.
     1422           if v-restore-saved <> true
     1423           then do:
     1424             if v-diasize-wndmax = true
     1425             then do:
     1426               run diasize_maximize in this-procedure
     1427                 (input  true
     1428                 ) .
     1429             end.
     1430           end.
     1431         end.
     1432         else do:
     1433           if v-diasize-wndmax = true
     1434           then do:
     1435             run diasize_maximize in this-procedure
     1436               (input  true
     1437               ) .
     1438           end.
     1439         end.
     1440       end.
     1441     end.
     1442   end procedure.
     1443   procedure diasize_need-full-display :
     1444     define output parameter p-need-full-display as logical   no-undo .
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448       assign
     1449         p-need-full-display = v-diasize-need-full-display
     1450       .
     1451       assign
     1452         v-diasize-need-full-display = false
     1453       .
     1454     end.
     1455   end procedure.
     1456   procedure get-context :
     1457      define output parameter p-db-num as integer          no-undo.
     1458      define output parameter p-user-id as character        no-undo.
     1459      define variable v-login               as character    no-undo.
     1460      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1461      define buffer buf_user-login  for ub.user-login .
     1462      do
     1463      on error undo, return error
     1464      :
     1465            FIND FIRST buf_sys-ctrl no-lock.
     1466            ASSIGN
     1467               v-login = USERID("ub")
     1468               p-db-num = buf_sys-ctrl.db-num
     1469            .
     1470            FIND FIRST buf_user-login
     1471                 WHERE buf_user-login.db-num = p-db-num
     1472                   AND buf_user-login.user-login = v-login
     1473                 no-lock
     1474                 no-error
     1475                 .
     1476            IF AVAILABLE buf_user-login
     1477            THEN DO:
     1478               assign
     1479                  p-user-id = buf_user-login.user-id
     1480               .
     1481            END.
     1482      end.
     1483   end procedure.
     1484       run diasize_init in this-procedure .
     1485   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1486   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1487   MAIN-BLOCK:
     1488   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1489      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1490       run init-fields in this-procedure .
     1491       RUN enable_UI.
     1492       apply "entry" to browse-1.
     1493       WAIT-FOR GO OF FRAME Dialog-Frame.
     1494   END.
     1495   RUN disable_UI.
     1496   PROCEDURE disable_UI :
     1497     HIDE FRAME Dialog-Frame.
     1498   END PROCEDURE.
     1499   PROCEDURE enable_UI :
     1500     ENABLE b-exit b-sel b-view b-help BROWSE-1
     1501         WITH FRAME Dialog-Frame.
     1502     VIEW FRAME Dialog-Frame.
     1503     OPEN QUERY BROWSE-1 FOR EACH temp_recipe.
     1504   END PROCEDURE.
     1505   PROCEDURE init-fields :
     1506   do
     1507   on error undo, return error
     1508   :
     1509       define buffer buf_recipe        for recipe.
     1510       define buffer buf_recipe-gds    for recipe-gds.
     1511       define buffer buf_goods         for goods.
     1512       define buffer buf_comp_goods    for goods.
     1513   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514     run mainmenu_getcntxt in parparentproc
     1515       (output v-cntxt-db-num
     1516       ,output v-cntxt-userid
     1517       ,output v-cntxt-level
     1518       ,output v-cntxt-host-code-obj
     1519       ,output v-cntxt-obj-type
     1520       ,output v-cntxt-obj-code
     1521       ,output v-cntxt-db-num-obj
     1522       ,output v-cntxt-is-admin
     1523       ) .
     1524       find first buf_goods no-lock
     1525            where buf_goods.gds-code = p-input-gds-code
     1526       .
     1527       assign
     1528           frame Dialog-Frame :title =
     1529               "Выбор рецепта для товара. Код: " + string( buf_goods.gds-code )
     1530               + " Арт: " + string( buf_goods.artic )
     1531               + " Имя: " + string( buf_goods.gds-name )
     1532       .
     1533       for each buf_recipe no-lock
     1534          where buf_recipe.artic       = buf_goods.artic
     1535            and buf_recipe.prod-type   = buf_goods.prod-type
     1536            and buf_recipe.prod-code   = buf_goods.prod-code
     1537       :
     1538           case p-input-trn-type
     1539           :
     1540               when 'при':U
     1541               then do:
     1542                   if buf_recipe.recipe-type = 'производство':U
     1543                   or buf_recipe.recipe-type = 'комплектация':U
     1544                   or buf_recipe.recipe-type = 'альтернатива':U
     1545                   or buf_recipe.recipe-type = 'топливо':U
     1546                   then do:
     1547                       assign
     1548                           p-is-integration = yes
     1549                       .
     1550                       find first temp_recipe
     1551                            where temp_recipe.artic     = buf_recipe.artic
     1552                              and temp_recipe.prod-type = buf_recipe.prod-type
     1553                              and temp_recipe.prod-code = buf_recipe.prod-code
     1554                       no-error.
     1555                       if not available temp_recipe
     1556                       then do:
     1557                           create temp_recipe.
     1558                           assign
     1559                               temp_recipe.recipe-code = buf_recipe.recipe-code
     1560                               temp_recipe.recipe-name = buf_recipe.recipe-name
     1561                               temp_recipe.recipe-type = buf_recipe.recipe-type
     1562                               temp_recipe.artic       = buf_recipe.artic
     1563                               temp_recipe.prod-type   = buf_recipe.prod-type
     1564                               temp_recipe.prod-code   = buf_recipe.prod-code
     1565                               temp_recipe.gds-code    = buf_goods.gds-code
     1566                           .
     1567                       end.
     1568                   end.
     1569               end.
     1570               when 'спи':U
     1571               then do:
     1572                   if buf_recipe.recipe-type = 'разделка':U
     1573                   or buf_recipe.recipe-type = 'комплектация':U
     1574                   then do:
     1575                       assign
     1576                           p-is-integration = no
     1577                       .
     1578                       find first temp_recipe
     1579                            where temp_recipe.artic     = buf_recipe.artic
     1580                              and temp_recipe.prod-type = buf_recipe.prod-type
     1581                              and temp_recipe.prod-code = buf_recipe.prod-code
     1582                       no-error.
     1583                       if not available temp_recipe
     1584                       then do:
     1585                           create temp_recipe.
     1586                           assign
     1587                               temp_recipe.recipe-code = buf_recipe.recipe-code
     1588                               temp_recipe.recipe-name = buf_recipe.recipe-name
     1589                               temp_recipe.recipe-type = buf_recipe.recipe-type
     1590                               temp_recipe.artic       = buf_recipe.artic
     1591                               temp_recipe.prod-type   = buf_recipe.prod-type
     1592                               temp_recipe.prod-code   = buf_recipe.prod-code
     1593                               temp_recipe.gds-code    = buf_goods.gds-code
     1594                           .
     1595                       end.
     1596                   end.
     1597               end.
     1598           end case.
     1599       end.
     1600       for each buf_recipe-gds no-lock
     1601          where buf_recipe-gds.artic       = buf_goods.artic
     1602            and buf_recipe-gds.prod-type   = buf_goods.prod-type
     1603            and buf_recipe-gds.prod-code   = buf_goods.prod-code
     1604       :
     1605           find first buf_recipe no-lock
     1606                where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     1607           .
     1608           case p-input-trn-type
     1609           :
     1610               when 'при':U
     1611               then do:
     1612                   if buf_recipe.recipe-type = 'разделка':U
     1613                   or buf_recipe.recipe-type = 'комплектация':U
     1614                   then do:
     1615                       assign
     1616                           p-is-integration = no
     1617                       .
     1618                       find first temp_recipe
     1619                            where temp_recipe.artic     = buf_recipe.artic
     1620                              and temp_recipe.prod-type = buf_recipe.prod-type
     1621                              and temp_recipe.prod-code = buf_recipe.prod-code
     1622                       no-error.
     1623                       if not available temp_recipe
     1624                       then do:
     1625                           find first buf_comp_goods no-lock
     1626                                where buf_comp_goods.artic     = buf_recipe.artic
     1627                                  and buf_comp_goods.prod-type = buf_recipe.prod-type
     1628                                  and buf_comp_goods.prod-code = buf_recipe.prod-code
     1629                           .
     1630                           create temp_recipe.
     1631                           assign
     1632                               temp_recipe.recipe-code = buf_recipe.recipe-code
     1633                               temp_recipe.recipe-name = buf_recipe.recipe-name
     1634                               temp_recipe.recipe-type = buf_recipe.recipe-type
     1635                               temp_recipe.artic       = buf_recipe.artic
     1636                               temp_recipe.prod-type   = buf_recipe.prod-type
     1637                               temp_recipe.prod-code   = buf_recipe.prod-code
     1638                               temp_recipe.gds-code    = buf_comp_goods.gds-code
     1639                           .
     1640                       end.
     1641                   end.
     1642               end.
     1643               when 'спи':U
     1644               then do:
     1645                   if buf_recipe.recipe-type = 'производство':U
     1646                   or buf_recipe.recipe-type = 'комплектация':U
     1647                   or buf_recipe.recipe-type = 'альтернатива':U
     1648                   or buf_recipe.recipe-type = 'топливо':U
     1649                   then do:
     1650                       assign
     1651                           p-is-integration = yes
     1652                       .
     1653                       find first temp_recipe
     1654                            where temp_recipe.artic     = buf_recipe.artic
     1655                              and temp_recipe.prod-type = buf_recipe.prod-type
     1656                              and temp_recipe.prod-code = buf_recipe.prod-code
     1657                       no-error.
     1658                       if not available temp_recipe
     1659                       then do:
     1660                           find first buf_comp_goods no-lock
     1661                                where buf_comp_goods.artic     = buf_recipe.artic
     1662                                  and buf_comp_goods.prod-type = buf_recipe.prod-type
     1663                                  and buf_comp_goods.prod-code = buf_recipe.prod-code
     1664                           .
     1665                           create temp_recipe.
     1666                           assign
     1667                               temp_recipe.recipe-code = buf_recipe.recipe-code
     1668                               temp_recipe.recipe-name = buf_recipe.recipe-name
     1669                               temp_recipe.recipe-type = buf_recipe.recipe-type
     1670                               temp_recipe.artic       = buf_recipe.artic
     1671                               temp_recipe.prod-type   = buf_recipe.prod-type
     1672                               temp_recipe.prod-code   = buf_recipe.prod-code
     1673                               temp_recipe.gds-code    = buf_comp_goods.gds-code
     1674                           .
     1675                       end.
     1676                   end.
     1677               end.
     1678           end case.
     1679       end.
     1680   end.
     1681   END PROCEDURE.
     1682   PROCEDURE view-recipe :
     1683   do
     1684   on error undo, return error
     1685   :
     1686   define input parameter p-recipe-code   as character     no-undo.
     1687       define variable v-recipe-recid      as recid     no-undo.
     1688       define variable v-new-recipe-code   as character    no-undo.
     1689       define buffer buf_goods     for goods.
     1690       define buffer buf_recipe    for recipe.
     1691       find first buf_recipe no-lock
     1692            where buf_recipe.recipe-code = p-recipe-code
     1693       no-error.
     1694       if available buf_recipe
     1695       then do:
     1696           find first buf_goods no-lock
     1697                where buf_goods.artic      = buf_recipe.artic
     1698                  and buf_goods.prod-type  = buf_recipe.prod-type
     1699                  and buf_goods.prod-code  = buf_recipe.prod-code
     1700           .
     1701           assign
     1702               v-recipe-recid = recid( buf_recipe )
     1703           .
     1704           run ref/recipe.w (
     1705                 input parparentproc
     1706               , input 'ПРОСМОТР':U
     1707               , input recid( buf_goods )
     1708               , input "":U
     1709               , input buf_recipe.recipe-code
     1710               , input v-cntxt-host-code-obj
     1711               , input v-cntxt-obj-type
     1712               , input v-cntxt-obj-code
     1713               , input no
     1714               , input no
     1715               , output v-new-recipe-code
     1716           ).
     1717       end.
     1718   end.
     1719   END PROCEDURE.
