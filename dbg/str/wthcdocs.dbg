     4468   PROCEDURE proc-b-print :
     4469   DEFINE INPUT PARAMETER loc-option as character no-undo.
     4470   define variable glog as logical no-undo .
     4471   if loc-option = '':U then return error.
     4472   define variable vss-include-info47 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4473   do:
     4474     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4475       (input  v-cntxt-db-num
     4476       ,input  v-cntxt-userid
     4477       ,input  0
     4478       ,input  'actn_wth-doc_print':U
     4479       ,input  'object':U
     4480       ,input  parhost-code
     4481       ,input  parobj-type
     4482       ,input  parobj-code
     4483       ,input  0
     4484       ,input  0
     4485       ,input  0
     4486       ,input  true
     4487       ,output glog
     4488       )  .
     4489   end.
     4490   IF glog <> YES
     4491   THEN DO:
     4492   RETURN ERROR.
     4493   END.
     4494   CASE loc-option:
     4495   when 'ONE':U then do:
     4496     CASE X_c-wth-doc.doc-type :
     4497       WHEN 'при':U    OR
     4498       WHEN 'рас':U   OR
     4499       WHEN 'спи':U THEN DO:
     4500       run rep/r-wcdoc.p ( input parparentproc, INPUT RECID(X_c-wth-doc ) ) no-error.
     4501     END.
     4502     WHEN 'инв':U THEN DO:
     4503       run rep/r-wcinv.p ( input parparentproc, INPUT RECID( X_c-wth-doc ) ) no-error.
     4504     END.
     4505     END CASE.
     4506   end.
     4507   when 'LIST':U then do:
     4508       run proc-print-list in this-procedure no-error.
     4509   end.
     4510   end case.
     4511   loc-option = ''.
     4512   END PROCEDURE.
