     4583   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4584   Filter-Block:
     4585   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4586     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4587     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4588   run gbl/filter.w ( INPUT parparentproc
     4589                , INPUT (filter-point + chr(4) +
     4590                         filter-label +  chr(4) +
     4591                         string(yes))
     4592                , INPUT tbl
     4593                , INPUT join-tbl
     4594                , INPUT fld
     4595                , INPUT lab
     4596                , INPUT spr
     4597                , INPUT dim ).
     4598   RUN OpenBr in this-procedure ( input  yes, input no, input '':U).
     4599   END.
     4600   END PROCEDURE.
     4601   PROCEDURE proc-find-code :
     4602   define input parameter par-next as logical no-undo.
     4603   define input parameter pardoc-code like ub.wth-doc.doc-code no-undo.
     4604   display
     4605   "  /  /":U @ sch-date
     4606   "  /  /":U @ sch-fact
     4607   with frame Dialog-Frame.
     4608   assign
     4609   pardoc-code = chr(34) + pardoc-code + chr(34).
     4610   run OpenBr in this-procedure
     4611     (input false
     4612     ,input par-next
     4613     ,input substitute("and X_c-wth-doc.doc-code   begins &1 "
     4614       , pardoc-code)
     4615     ).
     4616   apply "entry":u to sch-code in frame Dialog-Frame .
     4617   END PROCEDURE.
     4618   PROCEDURE proc-find-date :
     4619   define input parameter par-next as logical no-undo.
     4620   define input parameter par-date like ub.c-wth-doc.doc-date no-undo.
     4621   define input parameter parwhat-date as character no-undo.
     4622   define variable var-datechr as character no-undo.
     4623   display
     4624   '':U @ sch-code
     4625   with frame Dialog-Frame.
     4626   assign
     4627   var-datechr = string(day(par-date)) + chr(47) +
     4628                 string(month(par-date)) + chr(47) +
     4629                 string(year(par-date)).
     4630   case parwhat-date:
     4631     when "doc-date":U then do:
     4632       display
     4633       "  /  /":U @ sch-fact
     4634       with frame Dialog-Frame.
     4635       run OpenBr in this-procedure
     4636       (input false
     4637       ,input true
     4638       ,input substitute("and X_c-wth-doc.doc-date = &1 "
     4639         , var-datechr)
     4640       ).
     4641       apply "entry":u to sch-date in frame Dialog-Frame.
     4642     end.
     4643     when "fact-date":U then do:
     4644       display
     4645       "  /  /":U @ sch-date
     4646       with frame Dialog-Frame.
     4647       run OpenBr in this-procedure
     4648         (input false
     4649         ,input true
     4650         ,input substitute("and X_c-wth-doc.fact-date = &1 "
     4651         , var-datechr)
     4652         ).
     4653       apply "entry":u to sch-fact in frame Dialog-Frame.
     4654     end.
     4655   END.
     4656   END PROCEDURE.
     4657   PROCEDURE proc-print-list :
     4658   DEFINE VARIABLE vardoc-rec as recid no-undo.
     4659   DEFINE VARIABLE for-doc-date as character no-undo.
     4660   DEFINE VARIABLE for-shift-date as character no-undo.
     4661   DEFINE VARIABLE for-obj as character no-undo.
     4662   define variable accum-count as integer.
     4663   define variable accum-doc-sum as decimal.
     4664   define variable accum-fact-sum as decimal.
     4665   define variable date_string     as      char    no-undo.
     4666   define variable loc-v_operator  as   char    no-undo.
     4667   define variable loc-v_deliver as      char    no-undo.
     4668   define variable loc-v_receiver as      char    no-undo.
     4669   define variable v-header-base-curr as character no-undo .
     4670   define variable v-shift-name-num as character no-undo.
     4671   define variable v-curr-r-b as character no-undo .
     4672   define variable glog as logical no-undo .
     4673   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4675     (output v-curr-r-b
     4676     )  .
     4677   if v-curr-r-b = 'base':U then do:
     4678     assign
     4679     v-header-base-curr = string( "( Б.Вал. - " + caps( v-r-b-abbr ) + " )" )
     4680     .
     4681   end.
     4682   define variable Line as character  no-undo.
     4683   define buffer buf-oper for ub.clients.
     4684   define buffer buf-deliver for ub.clients.
     4685   define buffer buf-receiver for ub.clients.
     4686   DEFINE FRAME wth-list
     4687   X_c-wth-doc.doc-type COLUMN-LABEL "Т" FORMAT "X(1)"
     4688   X_c-wth-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     4689   X_c-wth-doc.doc-code
     4690   for-doc-date  COLUMN-LABEL "Дата" FORMAT "X(5)"
     4691   X_c-wth-doc.fact-date
     4692   v-shift-name-num  COLUMN-LABEL "N см." FORMAT "X(6)"
     4693   for-shift-date  COLUMN-LABEL "Смена" FORMAT "X(5)"
     4694   X_c-wth-doc.inter_ COLUMN-LABEL "В"
     4695   X_c-wth-doc.exter_ COLUMN-LABEL "Ш"
     4696   X_c-wth-doc.cli-name FORMAT "X(26)"
     4697   for-obj COLUMN-LABEL "Объект" FORMAT "X(9)"
     4698   X_c-wth-doc.doc-sum COLUMN-LABEL "Сумма по док-ту"
     4699   X_c-wth-doc.fact-sum
     4700   X_c-wth-doc.source-ref COLUMN-LABEL "На документ"
     4701   X_c-wth-doc.acc-date COLUMN-LABEL "Проводка"
     4702   X_c-wth-doc.bge-date COLUMN-LABEL "Внеш.пров."
     4703   loc-v_operator COLUMN-LABEL "Исп" FORMAT "X(8)"
     4704   loc-v_deliver  COLUMN-LABEL "Передал" FORMAT "X(8)"
     4705   loc-v_receiver  COLUMN-LABEL "Получил" FORMAT "X(8)"
     4706   X_c-wth-doc.creid  COLUMN-LABEL "Опер" FORMAT "X(8)"
     4707   HEADER  date_string AT 5 format "X(35)"
     4708   v-header-base-curr        format "X(20)" AT 42
     4709   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4710   Line format "X(198)" AT 1
     4711   with width 232 down stream-io use-text    .
     4712   if b-sch:tooltip in frame Dialog-Frame = '' then do:
     4713       message "В списке не установлен фильтр" SKIP
     4714                     "Печать списка может занять длительное время" SKIP
     4715                     "Продолжать?"
     4716       view-as alert-box QUESTION buttons YES-NO update glog.
     4717       if not glog then return.
     4718   end.
     4719   Line = fill("-", 198).
     4720   date_string = cur-time-print() .
     4721   run prn-lib-open-stream  in this-procedure (
     4722                                                input parParentProc
     4723                                               ,input 43
     4724                                               ,input yes
     4725                                               ,input no
     4726                                               ).
     4727   PUT  STREAM PrnLibStream
     4728   SPACE(25) ( frame Dialog-Frame:title )
     4729   format "x(90)" SKIP(1) .
     4730   FORM HEADER
     4731   Line format "X(198)" AT 1 SKIP
     4732   "Продолжение - на следующей странице" AT 30 SKIP
     4733   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4734   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4735   FORM with FRAME wth-list  .
     4736   run waitfram-show in this-procedure ( input "Ждите...").
     4737   vardoc-rec = recid(X_c-wth-doc).
     4738   DO WHILE available X_c-wth-doc :
     4739     GET prev br-docs.
     4740   END.
     4741   GET next br-docs.
     4742    DO WHILE available X_c-wth-doc :
     4743           FIND buf-oper NO-LOCK WHERE
     4744                   buf-oper.obj-type = 'чел':U AND
     4745                   buf-oper.obj-code = X_c-wth-doc.operator NO-ERROR.
     4746           FIND buf-deliver NO-LOCK WHERE
     4747                   buf-deliver.obj-type = 'чел':U AND
     4748                   buf-deliver.obj-code = X_c-wth-doc.deliver NO-ERROR.
     4749           FIND buf-receiver NO-LOCK WHERE
     4750                   buf-receiver.obj-type = 'чел':U AND
     4751                   buf-receiver.obj-code = X_c-wth-doc.receiver NO-ERROR.
     4752           assign
     4753           loc-v_operator = ( IF AVAIL buf-oper THEN buf-oper.obj-name ELSE "":U ).
     4754           loc-v_deliver = ( IF AVAIL buf-deliver THEN buf-deliver.obj-name ELSE "":U ).
     4755           loc-v_receiver = ( IF AVAIL buf-receiver THEN buf-receiver.obj-name ELSE "":U )
     4756           .
     4757     Display STREAM PrnLibStream
     4758       X_c-wth-doc.doc-type
     4759       X_c-wth-doc.status_
     4760       X_c-wth-doc.doc-code
     4761       (substring ((string (X_c-wth-doc.doc-date)), 1, 5)) @ for-doc-date
     4762       X_c-wth-doc.fact-date
     4763       shift-name-no-err(buffer X_c-wth-doc)  @ v-shift-name-num
     4764       (substring ((string (X_c-wth-doc.shift-date)), 1, 5)) @ for-shift-date
     4765       X_c-wth-doc.inter_
     4766       X_c-wth-doc.exter_
     4767       X_c-wth-doc.cli-name
     4768       (trim (X_c-wth-doc.obj-type) + " " + string (X_c-wth-doc.obj-code, ">>>>9")) @ for-obj
     4769       X_c-wth-doc.doc-sum
     4770       X_c-wth-doc.fact-sum
     4771       X_c-wth-doc.source-ref
     4772       X_c-wth-doc.acc-date
     4773       X_c-wth-doc.bge-date
     4774       loc-v_operator
     4775        loc-v_deliver
     4776       loc-v_receiver
     4777       X_c-wth-doc.creid
     4778     with FRAME wth-list .
     4779     DOWN STREAM PrnLibStream 1
     4780     with FRAME wth-list  .
     4781     assign
     4782     accum-count = accum-count + 1
     4783     accum-doc-sum = accum-doc-sum + X_c-wth-doc.doc-sum
     4784       accum-fact-sum = accum-fact-sum + X_c-wth-doc.fact-sum
     4785       .
     4786     GET next br-docs.
     4787     END.
     4788     UNDERLINE  STREAM PrnLibStream
     4789       X_c-wth-doc.doc-type
     4790       X_c-wth-doc.status_
     4791       X_c-wth-doc.doc-code
     4792       for-doc-date
     4793       X_c-wth-doc.fact-date
     4794       v-shift-name-num
     4795       for-shift-date
     4796       X_c-wth-doc.inter_
     4797       X_c-wth-doc.exter_
     4798       X_c-wth-doc.cli-name
     4799       for-obj
     4800       X_c-wth-doc.doc-sum
     4801       X_c-wth-doc.fact-sum
     4802       X_c-wth-doc.source-ref
     4803       X_c-wth-doc.acc-date
     4804       X_c-wth-doc.bge-date
     4805           loc-v_operator
     4806           loc-v_deliver
     4807           loc-v_receiver
     4808       X_c-wth-doc.creid
     4809     with FRAME wth-list .
     4810     DISPLAY STREAM PrnLibStream
     4811     ("ИТОГО" + chr(32) + string(accum-count))  @ X_c-wth-doc.doc-code
     4812    accum-doc-sum @ X_c-wth-doc.doc-sum
     4813     accum-fact-sum @ X_c-wth-doc.fact-sum
     4814     with frame wth-list.
     4815   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4816   HIDE  STREAM PrnLibStream FRAME wth-List.
     4817   output  STREAM PrnLibStream CLOSE.
     4818   REPOSITION br-docs to recid vardoc-rec no-error.
     4819   APPLY "entry" to br-docs.
     4820   run waitfram-hide in this-procedure .
     4821   run prn-lib-prn-file in this-procedure (
     4822                                             input parParentProc
     4823                                             ,input 8
     4824                                             ).
     4825   END PROCEDURE.
     4826   PROCEDURE reposition-c-wth-doc :
     4827   define input  parameter p-direction   as character no-undo .
     4828   define output parameter p-wth-doc-recid as recid no-undo .
     4829     case p-direction :
     4830       when "first":U
     4831       then do:
     4832         get first br-docs.
     4833       end.
     4834       when "last":U
     4835       then do:
     4836         get last br-docs.
     4837       end.
     4838       when "prev":U
     4839       then do:
     4840         get prev br-docs.
     4841         if not available X_c-wth-doc then do:
     4842           message
     4843           "Это первый документ списка"
     4844           view-as alert-box.
     4845         end.
     4846       end.
     4847       when "next":U
     4848       then do:
     4849         get next br-docs.
     4850         if not available X_c-wth-doc then do:
     4851           message
     4852           "Это последний документ списка"
     4853           view-as alert-box.
     4854         end.
     4855       end.
     4856     end case .
     4857     assign
     4858     p-wth-doc-recid = recid(X_c-wth-doc)
     4859     .
     4860     run reposition-query in this-procedure
     4861       (input p-wth-doc-recid
     4862       ).
     4863   END PROCEDURE.
     4864   PROCEDURE reposition-query :
     4865   define input parameter p-recid as recid no-undo .
     4866     if p-recid <> ?
     4867     then do:
     4868       reposition br-docs to recid p-recid no-error.
     4869     end.
     4870     do with frame Dialog-Frame:
     4871       apply "entry":u to browse BR-docs .
     4872       apply "VALUE-CHANGED":u to browse BR-docs .
     4873     end.
     4874   END PROCEDURE.
