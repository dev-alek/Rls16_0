      890   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      892   procedure fltopend_fltopend :
      893   define input parameter p-parent-handle as handle no-undo .
      894   define input parameter p-qh as handle no-undo .
      895   define input parameter p-flt-open-open-query  as character no-undo .
      896   define input parameter p-where-cond as character no-undo .
      897   define input parameter p-use-indFIRST-query-tail as character no-undo .
      898   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      899   define input parameter p-indexed-reposition as character no-undo .
      900     do
      901     on error undo, return error
      902     :
      903   define variable v-prepare-string as character no-undo .
      904   define variable glog as logical no-undo .
      905   assign
      906   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      907                      p-where-cond + chr(32)  +
      908                      p-use-indFIRST-query-tail + chr(32) +
      909                      p-use-ind-sort-clmn-by + chr(32) +
      910                      p-indexed-reposition
      911   .
      912   assign
      913   glog = p-qh:query-prepare(v-prepare-string) no-error .
      914   if not glog
      915   or error-status:error then do:
      916     message error-status:get-message(1) view-as alert-box .
      917     undo, return error .
      918   end.
      919   assign
      920   glog = p-qh:query-open no-error .
      921   if not glog
      922   or error-status:error then do:
      923     message error-status:get-message(1) view-as alert-box .
      924     undo, return error .
      925   end.
      926     end.
      927   end procedure.
      928   procedure fltopend_fltfindd :
      929   define input parameter p-parent-handle as handle no-undo .
      930   define input parameter p-qh as handle no-undo .
      931   define input parameter p-rowid as rowid no-undo .
      932   define input parameter p-next as logical no-undo .
      933   define input parameter p-lock as integer no-undo .
      934   define input parameter p-bh as handle no-undo .
      935   define input parameter p-where-cond as character no-undo .
      936   define input parameter p-use-index-phrase as character no-undo .
      937   define variable glog as logical no-undo .
      938   define variable v-qh as handle no-undo .
      939   define variable v-bh as handle no-undo .
      940   define variable v-recid as recid no-undo .
      941   define variable v-prepare-string as character no-undo .
      942   do
      943   on error undo, return error
      944   on stop undo, return error
      945   :
      946     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      947     create buffer v-bh for table p-bh buffer-name p-bh:name.
      948     create query v-qh.
      949     v-qh:set-buffers(v-bh).
      950     v-prepare-string = substitute("for each &1 &2 &3"
      951                                     ,v-bh:name
      952                                     ,p-where-cond
      953                                     ,p-use-index-phrase).
      954     glog = v-qh:query-prepare(v-prepare-string) no-error.
      955     if not glog then do:
      956       delete object v-qh.
      957       delete object v-bh.
      958       undo, return error .
      959     end.
      960     glog = v-qh:query-open no-error .
      961     if not glog then do:
      962       delete object v-qh.
      963       delete object v-bh.
      964       undo, return error .
      965     end.
      966     if p-next then do:
      967       v-qh:reposition-to-rowid(p-rowid) no-error .
      968       glog = v-qh:get-next( p-lock) no-error .
      969       glog = v-qh:get-next( p-lock) no-error .
      970       if not glog or v-qh:query-off-end = yes then do:
      971         glog = v-qh:get-first( p-lock) no-error .
      972       end.
      973     end.
      974     else do:
      975       glog = v-qh:get-first( p-lock) no-error .
      976     end.
      977     v-recid = v-bh:recid no-error .
      978     delete object v-qh.
      979     delete object v-bh.
      980     return string(v-recid) .
      981   end.
      982   end procedure.
      983   procedure fltopend_fltfindq :
      984   define input parameter p-parent-handle as handle no-undo .
      985   define input parameter p-qh as handle no-undo .
      986   define input parameter p-next as logical no-undo .
      987   define input parameter p-lock as integer no-undo .
      988   define input parameter p-flt-open-open-query  as character no-undo .
      989   define input parameter p-where-cond as character no-undo .
      990   define input parameter p-use-indFIRST-query-tail as character no-undo .
      991   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      992   define input parameter p-indexed-reposition as character no-undo .
      993   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      994   define variable glog as logical no-undo .
      995   define variable v-qh as handle no-undo .
      996   define variable v-bh as handle no-undo extent 18.
      997   define variable v-rowid as rowid no-undo extent 18.
      998   define variable v-ii as integer no-undo .
      999   define variable v-prepare-string as character no-undo .
     1000   do
     1001   on error undo, return error
     1002   on stop undo, return error
     1003   :
     1004     create query v-qh.
     1005     do v-ii = 1 to p-qh:num-buffers:
     1006       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1007       assign
     1008       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1009       no-error.
     1010       v-qh:add-buffer(v-bh[v-ii]).
     1011     end.
     1012     assign
     1013     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1014                       p-where-cond + chr(32)  +
     1015                       p-use-indFIRST-query-tail + chr(32) +
     1016                       p-use-ind-sort-clmn-by + chr(32) +
     1017                       p-indexed-reposition
     1018     .
     1019     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1020     if not glog then do:
     1021       delete object v-qh.
     1022       do v-ii = 1 to p-qh:num-buffers:
     1023         delete object v-bh[v-ii].
     1024       end.
     1025       undo, return error .
     1026     end.
     1027     glog = v-qh:query-open no-error .
     1028     if not glog then do:
     1029       delete object v-qh.
     1030       do v-ii = 1 to p-qh:num-buffers:
     1031         delete object v-bh[v-ii].
     1032       end.
     1033       undo, return error .
     1034     end.
     1035     if p-next then do:
     1036       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1037       glog = v-qh:get-next( p-lock) no-error .
     1038       glog = v-qh:get-next( p-lock) no-error .
     1039       if not glog or v-qh:query-off-end = yes then do:
     1040         glog = v-qh:get-first( p-lock) no-error .
     1041       end.
     1042     end.
     1043     else do:
     1044       glog = v-qh:get-first( p-lock) no-error .
     1045     end.
     1046     do v-ii = 1 to p-qh:num-buffers:
     1047       assign
     1048       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1049       no-error.
     1050     end.
     1051     delete object v-qh.
     1052     do v-ii = 1 to p-qh:num-buffers:
     1053       delete object v-bh[v-ii].
     1054     end.
     1055   end.
     1056   end procedure.
     1057   define variable filter-label as character no-undo init "История док-тов МЦ" .
     1058   define variable filter-label0 as character no-undo init "История док-тов МЦ" .
     1059   define variable filter-point0 as character no-undo init "wthcdocs" .
     1060   define variable filter-point as character no-undo init "wthcdocs" .
     1061   define variable sort-column-name as character no-undo .
     1062   define variable v-rid-list as character no-undo .
     1063   define variable vcli-name like ub.clients.obj-name no-undo.
     1064   define variable vhost-name like ub.clients.obj-name no-undo.
     1065   define variable print-option as character no-undo.
     1066   define variable v-r-b-abbr like ub.currency.curr-abbr no-undo .
     1067   define variable add-option as character no-undo.
     1068   define variable v-doc-rec as recid no-undo .
     1069   define buffer buf_cli for ub.clients.
     1070   define buffer buf_obj for ub.clients .
     1071   define buffer buf_wth-doc for ub.wth-doc.
     1072   DEFINE MENU MENU-B-print
     1073          MENU-ITEM m_one          LABEL "Документ"
     1074          MENU-ITEM m_list         LABEL "Список"        .
     1075   DEFINE BUTTON B-Help
     1076        LABEL "Помо&щь"
     1077        SIZE 3 BY 1
     1078        BGCOLOR 8 .
     1079   DEFINE BUTTON b-lkp
     1080        LABEL "&Просм"
     1081        SIZE 10 BY 1.
     1082   DEFINE BUTTON B-mark
     1083        LABEL "&*"
     1084        SIZE 3 BY 1.
     1085   DEFINE BUTTON B-print
     1086        LABEL "Пе&чать"
     1087        SIZE 3 BY 1.
     1088   DEFINE BUTTON b-quit AUTO-GO
     1089        LABEL "&Выход"
     1090        SIZE 8 BY 1
     1091        BGCOLOR 8 .
     1092   DEFINE BUTTON B-sch
     1093        LABEL "&Фильтр"
     1094        SIZE 3 BY 1.
     1095   DEFINE BUTTON B-sel AUTO-GO
     1096        LABEL "Вы&бор"
     1097        SIZE 10 BY 1.
     1098   DEFINE VARIABLE ED-notes AS CHARACTER
     1099        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1100        SIZE 98 BY 2
     1101        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1102   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1103         VIEW-AS TEXT
     1104        SIZE 6 BY 1
     1105        FGCOLOR 4  NO-UNDO.
     1106   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(14)":U
     1107        LABEL "номеру"
     1108        VIEW-AS FILL-IN
     1109        SIZE 12.5 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1110   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1111        LABEL "дате"
     1112        VIEW-AS FILL-IN
     1113        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1114   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999":U
     1115        LABEL "дате факт"
     1116        VIEW-AS FILL-IN
     1117        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1118   DEFINE VARIABLE sch-num AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1119        VIEW-AS FILL-IN
     1120        SIZE 12 BY 1
     1121        FGCOLOR 4  NO-UNDO.
     1122   DEFINE VARIABLE v_creid AS CHARACTER FORMAT "X(256)":U
     1123        LABEL "Опер"
     1124         VIEW-AS TEXT
     1125        SIZE 14 BY .71
     1126        FGCOLOR 4  NO-UNDO.
     1127   DEFINE VARIABLE v_deliver AS CHARACTER FORMAT "X(256)":U
     1128        LABEL "Передал"
     1129         VIEW-AS TEXT
     1130        SIZE 14 BY .71
     1131        FGCOLOR 4  NO-UNDO.
     1132   DEFINE VARIABLE v_operator AS CHARACTER FORMAT "X(256)":U
     1133        LABEL "Исп"
     1134         VIEW-AS TEXT
     1135        SIZE 14 BY .71
     1136        FGCOLOR 4  NO-UNDO.
     1137   DEFINE VARIABLE v_receiver AS CHARACTER FORMAT "X(256)":U
     1138        LABEL "Получил"
     1139         VIEW-AS TEXT
     1140        SIZE 14 BY .79
     1141        FGCOLOR 4  NO-UNDO.
     1142   DEFINE QUERY BR-docs FOR
     1143         X_c-wth-doc SCROLLING.
     1144   DEFINE BROWSE BR-docs
     1145     QUERY BR-docs NO-LOCK DISPLAY
     1146         mark-string( recid(X_c-wth-doc), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1147   X_c-wth-doc.doc-type COLUMN-LABEL "Т" FORMAT "X(1)":U
     1148   X_c-wth-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)":U
     1149   X_c-wth-doc.doc-code FORMAT "X(14)":U
     1150   X_c-wth-doc.fact-date FORMAT "99/99/99":U
     1151   shift-name-no-err (buffer X_c-wth-doc) COLUMN-LABEL "№" FORMAT "X(6)":U
     1152   (substring ((string (X_c-wth-doc.doc-date)), 1, 5)) COLUMN-LABEL "Дата" FORMAT "X(5)":U
     1153   X_c-wth-doc.inter_ COLUMN-LABEL "В" FORMAT "+/":U
     1154   X_c-wth-doc.exter_ COLUMN-LABEL "Ш" FORMAT "+/":U
     1155   X_c-wth-doc.auto-fill COLUMN-LABEL "А" FORMAT "+/":U
     1156   X_c-wth-doc.cli-name FORMAT "X(27)":U
     1157   X_c-wth-doc.doc-sum COLUMN-LABEL "Сумма по док-ту" FORMAT "->,>>>,>>>,>>9.99":U
     1158   (substring ((string (X_c-wth-doc.shift-date)), 1, 5)) COLUMN-LABEL "Смена" FORMAT "X(5)":U
     1159   X_c-wth-doc.fact-sum FORMAT "->,>>>,>>>,>>9.99":U
     1160   X_c-wth-doc.acc-date COLUMN-LABEL "Проводка" FORMAT "99/99/99":U
     1161   X_c-wth-doc.bge-date COLUMN-LABEL "Внеш.пров." FORMAT "99/99/99":U
     1162   (trim (X_c-wth-doc.obj-type) + " " + string (X_c-wth-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1163   X_c-wth-doc.source-type + chr(32) + X_c-wth-doc.source-ref COLUMN-LABEL "На документ" FORMAT "X(26)":U
     1164   usrfulnf(X_c-wth-doc.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1165   X_c-wth-doc.corr-date COLUMN-LABEL "Дата измен" FORMAT "99/99/9999":U
     1166   string(X_c-wth-doc.corr-time, "HH:mm:ss") COLUMN-LABEL "Время измен." FORMAT "X(8)":U
     1167   ENABLE
     1168   X_c-wth-doc.bge-date
     1169       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.
     1170   DEFINE FRAME Dialog-Frame
     1171        b-quit AT ROW 1 COL 1.13
     1172        B-mark AT ROW 1 COL 9
     1173        B-sel AT ROW 1 COL 18
     1174        b-lkp AT ROW 1 COL 38
     1175        B-print AT ROW 1 COL 89
     1176        B-sch AT ROW 1 COL 92
     1177        B-Help AT ROW 1 COL 95
     1178        BR-docs AT ROW 2.5 COL 1.13
     1179        ED-notes AT ROW 19.92 COL 1 NO-LABEL
     1180        sch-code AT ROW 22.54 COL 17.63 COLON-ALIGNED
     1181        sch-date AT ROW 22.54 COL 40.75 COLON-ALIGNED
     1182        sch-fact AT ROW 22.58 COL 65.63 COLON-ALIGNED
     1183        sch-num AT ROW 22.58 COL 80.63 COLON-ALIGNED NO-LABEL
     1184        mark-num AT ROW 1 COL 10 COLON-ALIGNED NO-LABEL
     1185        v_operator AT ROW 18.88 COL 4 COLON-ALIGNED
     1186        v_deliver AT ROW 18.88 COL 29 COLON-ALIGNED
     1187        v_receiver AT ROW 18.88 COL 54 COLON-ALIGNED
     1188        v_creid AT ROW 18.92 COL 79 COLON-ALIGNED
     1189        "ПОИСК ПО" VIEW-AS TEXT
     1190             SIZE 9.25 BY 1 AT ROW 22.54 COL 1.5
     1191             FGCOLOR 4
     1192        SPACE(88.38) SKIP(0.06)
     1193       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1194            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1195            TITLE "История документов МЦ"
     1196            DEFAULT-BUTTON b-lkp.
     1197   ASSIGN
     1198          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1199          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1200   ASSIGN
     1201          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1202   ON GO OF FRAME Dialog-Frame
     1203   DO:
     1204     p-rid-list = v-rid-list.
     1205   END.
     1206   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1207   DO:
     1208     APPLY "END-ERROR":U TO SELF.
     1209   END.
     1210   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1211   DO:
     1212     define variable glog as logical no-undo .
     1213     define variable v-doc-rec as recid no-undo .
     1214     define variable next-prev as character no-undo .
     1215     IF NOT AVAIL X_c-wth-doc THEN RETURN NO-apply.
     1216   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   do:
     1218     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1219       (input  v-cntxt-db-num
     1220       ,input  v-cntxt-userid
     1221       ,input  0
     1222       ,input  'actn_wth-doc_lookup':U
     1223       ,input  'object':U
     1224       ,input  parhost-code
     1225       ,input  parobj-type
     1226       ,input  parobj-code
     1227       ,input  0
     1228       ,input  0
     1229       ,input  0
     1230       ,input  true
     1231       ,output glog
     1232       )  .
     1233   end.
     1234     IF glog <> YES THEN DO:
     1235       RETURN NO-APPLY.
     1236     END.
     1237     ASSIGN
     1238     v-doc-rec = RECID( X_c-wth-doc )
     1239     next-prev = '':U
     1240     .
     1241     DO WHILE next-prev = '':U:
     1242         if NOT available X_c-wth-doc then do:
     1243           message "Неправильно выбран документ МЦ." view-as alert-box ERROR.
     1244           return no-apply.
     1245         end.
     1246       CASE X_c-wth-doc.doc-type :
     1247         WHEN 'при':U OR
     1248         WHEN 'рас':U OR
     1249         WHEN 'спи':U THEN DO:
     1250             run str/wthcinc.w (  input parparentproc
     1251                             ,INPUT 'ПРОСМОТР':U
     1252                             ,INPUT X_c-wth-doc.host-code
     1253                             ,INPUT X_c-wth-doc.obj-type
     1254                             ,INPUT X_c-wth-doc.obj-code
     1255                             ,INPUT X_c-wth-doc.cli-type
     1256                             ,INPUT X_c-wth-doc.cli-code
     1257                             ,INPUT X_c-wth-doc.doc-type
     1258                             ,INPUT X_c-wth-doc.auto-fill
     1259                             ,input-output v-doc-rec
     1260                             ,input this-procedure:handle
     1261                             ,input-output next-prev
     1262                             ).
     1263         END.
     1264         WHEN 'инв':U THEN DO:
     1265             run str/wthcinv.w ( input parparentproc
     1266                             ,INPUT 'ПРОСМОТР':U
     1267                             ,INPUT X_c-wth-doc.host-code
     1268                             ,INPUT X_c-wth-doc.obj-type
     1269                             ,INPUT X_c-wth-doc.obj-code
     1270                             ,INPUT X_c-wth-doc.cli-type
     1271                             ,INPUT X_c-wth-doc.cli-code
     1272                             ,INPUT X_c-wth-doc.auto-fill
     1273                             ,input-output v-doc-rec
     1274                             ,input this-procedure:handle
     1275                             ,input-output next-prev
     1276                             ).
     1277         END.
     1278       END CASE.
     1279    END.
     1280    RUN OpenBr in this-procedure ( input  yes, input no, input '':U).
     1281    reposition br-docs to recid v-doc-rec no-error.
     1282    APPLY "ENTRY":U  TO br-docs IN FRAME Dialog-Frame.
     1283    APPLY "VALUE-CHANGED":U TO br-docs IN FRAME Dialog-Frame.
     1284   END.
     1285   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1286   DO:
     1287   define variable glog as logical no-undo .
     1288     if available X_c-wth-doc then do:
     1289   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   define variable v-str-recid17 as character no-undo .
     1291   define variable v-num-entry17 as integer   no-undo .
     1292   assign
     1293     v-str-recid17 = trim( string( recid( X_c-wth-doc ) , "->>>>>>>>>>>9":U ) )
     1294     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1295   .
     1296   if v-num-entry17 > 0 then do:
     1297     assign
     1298       entry( v-num-entry17, v-rid-list ) = "":U
     1299       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1300     .
     1301   end.
     1302   else do:
     1303     assign
     1304       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1305     .
     1306   end.
     1307       glog = br-docs:refresh() .
     1308       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1309           glog = br-docs:select-next-row ().
     1310           apply "iteration-changed" to br-docs in frame Dialog-Frame.
     1311       end.
     1312       if num-entries( v-rid-list ) = 0
     1313       then
     1314           hide mark-num in frame Dialog-Frame.
     1315       else
     1316           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1317     end.
     1318     apply "entry" to br-docs in frame Dialog-Frame.
     1319   END.
     1320   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1321   DO:
     1322     if not avail X_c-wth-doc then return no-apply.
     1323     if print-option = '':U then do:
     1324           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1325     end.
     1326     if print-option = '':U then return no-apply.
     1327     run proc-b-print in this-procedure ( input print-option) no-error.
     1328     if error-status:error then do:
     1329       print-option = '':U.
     1330       return no-apply.
     1331     end.
     1332     APPLY "ENTRY" to br-docs.
     1333   END.
     1334   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1335   DO:
     1336   run proc-b-sch in this-procedure no-error.
     1337   if error-status:error then return no-apply.
     1338   END.
     1339   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1340   DO:
     1341         if ( available X_c-wth-doc ) AND ( v-rid-list = "" ) then
     1342       v-rid-list = string( recid( X_c-wth-doc ) ) .
     1343   END.
     1344   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1345   DO:
     1346      sch-code:screen-value = sch-code:screen-value + last-event:label.
     1347       apply "entry" to sch-code in frame Dialog-Frame.
     1348   apply "end" to sch-code in frame Dialog-Frame.
     1349   END.
     1350   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1351   DO:
     1352      if b-mark:sensitive in frame Dialog-Frame then
     1353     APPLY "CHOOSE" to b-mark.
     1354   END.
     1355   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1356   DO:
     1357     if b-mark:sensitive in frame Dialog-Frame then
     1358     APPLY "CHOOSE" to b-mark.
     1359       else do:
     1360         if b-sel:sensitive in frame Dialog-Frame then
     1361         APPLY "CHOOSE" to b-sel.
     1362       end.
     1363   END.
     1364   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1365   or MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME Dialog-Frame DO:
     1366     apply "choose" to b-lkp in frame Dialog-Frame.
     1367       return no-apply.
     1368   END.
     1369   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1370   DO:
     1371       define buffer buf-oper for ub.clients.
     1372       define buffer buf-deliver for ub.clients.
     1373       define buffer buf-receiver for ub.clients.
     1374         if available X_c-wth-doc then do:
     1375           FIND buf-oper NO-LOCK WHERE
     1376                   buf-oper.obj-type = 'чел':U AND
     1377                   buf-oper.obj-code = X_c-wth-doc.operator NO-ERROR.
     1378           FIND buf-deliver NO-LOCK WHERE
     1379                   buf-deliver.obj-type = 'чел':U AND
     1380                   buf-deliver.obj-code = X_c-wth-doc.deliver NO-ERROR.
     1381           FIND buf-receiver NO-LOCK WHERE
     1382                   buf-receiver.obj-type = 'чел':U AND
     1383                   buf-receiver.obj-code = X_c-wth-doc.receiver NO-ERROR.
     1384           assign
     1385           ed-notes = X_c-wth-doc.PS
     1386           v_operator = ( IF AVAIL buf-oper THEN buf-oper.obj-name ELSE "":U ).
     1387           v_deliver = ( IF AVAIL buf-deliver THEN buf-deliver.obj-name ELSE "":U ).
     1388           v_receiver = ( IF AVAIL buf-receiver THEN buf-receiver.obj-name ELSE "":U ).
     1389           .
     1390   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1392     (input  X_c-wth-doc.creid
     1393     ,output v_creid
     1394     )  .
     1395       end.
     1396       else do:
     1397           assign
     1398           ed-notes = '':U
     1399           v_operator = '':U
     1400           v_deliver = '':U
     1401           v_receiver = '':U
     1402           v_creid = '':U
     1403           .
     1404       end.
     1405       display
     1406       ed-notes
     1407       v_creid
     1408       v_deliver
     1409       v_operator
     1410       v_receiver
     1411       with frame Dialog-Frame.
     1412   END.
     1413   ON CHOOSE OF MENU-ITEM m_list
     1414   DO:
     1415    assign
     1416     print-option = 'LIST':U.
     1417     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     1418   END.
     1419   ON CHOOSE OF MENU-ITEM m_one
     1420   DO:
     1421    assign
     1422     print-option = 'ONE':U.
     1423     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1424   END.
     1425   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1426   DO:
     1427      run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1428     if error-status:error then return no-apply.
     1429   END.
     1430   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1431   DO:
     1432      run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1433     if error-status:error then return no-apply.
     1434   END.
     1435   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1436   DO:
     1437      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     1438     if error-status:error then return no-apply.
     1439   END.
     1440   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1441   DO:
     1442       run proc-find-date in  this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     1443     if error-status:error then return no-apply.
     1444   END.
     1445   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     1446   DO:
     1447      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1448     if error-status:error then return no-apply.
     1449   END.
     1450   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     1451   DO:
     1452     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1453     if error-status:error then return no-apply.
     1454   END.
     1455   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1456   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1457   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   on help of frame Dialog-Frame
     1459   do:
     1460     run gbl/app_help.p
     1461       (input this-procedure :file-name
     1462       ,input ''
     1463       ,input ?
     1464       ) no-error.
     1465     if error-status :error then do:
     1466       message
     1467         "Ошибка при вызове помощи"
     1468         error-status :get-message(1)
     1469         view-as alert-box .
     1470     end.
     1471   end.
     1472   run minbtn-set in this-procedure .
     1473   on choose of b-help in frame Dialog-Frame
     1474   do:
     1475     apply "help":u to frame Dialog-Frame .
     1476   end.
     1477   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   procedure minbtn-set :
     1479       do
     1480           on error undo, return error return-value
     1481           :
     1482           define variable ii              as integer       no-undo .
     1483           define variable fh              as widget-handle no-undo .
     1484           define variable hh              as widget-handle no-undo .
     1485           define variable v-h             as handle        extent 4 no-undo .
     1486           define variable v-name-button   as character     no-undo .
     1487           define variable v-help-old-x    as decimal       no-undo .
     1488           define variable v-help-old-y    as decimal       no-undo .
     1489           define variable v-help-old-size as decimal       no-undo .
     1490           define variable v-frame-width   as decimal       no-undo .
     1491           define variable jj              as integer       no-undo .
     1492           do
     1493               on error undo, return error
     1494               :
     1495               assign
     1496                   v-frame-width = frame Dialog-Frame:width - 0.3
     1497                   fh            = frame Dialog-Frame:first-child
     1498                   hh            = fh:first-child
     1499                   ii            = 1
     1500                   .
     1501               do while valid-handle(hh):
     1502                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1503                   do:
     1504                       case lc(hh:name) :
     1505                           when "b-help" then
     1506                               do:
     1507                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1508                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1509                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1510                                   hh:TOOLTIP = "Помощь" .
     1511                                   v-help-old-x = hh:column .
     1512                                   v-help-old-y = hh:row    .
     1513                                   v-help-old-size = hh:width .
     1514                                   hh:width-chars = 2.5 .
     1515                               end.
     1516                           when "b-print" then
     1517                               do:
     1518                                   hh:load-image("cmp/b-print.bmp":u) .
     1519                                   hh:TOOLTIP = "Печать" .
     1520                                   v-h[ii] = hh:handle .
     1521                                   ii = ii + 1 .
     1522                                   hh:width-chars = 3 .
     1523                               end.
     1524                           when "b-history" or
     1525                           when "b-hist" then
     1526                               do:
     1527                                   hh:load-image("cmp/b-hist.bmp":u) .
     1528                                   hh:TOOLTIP = "История" .
     1529                                   v-h[ii] = hh:handle .
     1530                                   ii = ii + 1 .
     1531                                   hh:width-chars = 3 .
     1532                               end.
     1533                           when "b-sch" then
     1534                               do:
     1535                                   hh:load-image("cmp/b-sch.bmp":u) .
     1536                                   hh:TOOLTIP = "Установка Фильтра" .
     1537                                   v-h[ii] = hh:handle .
     1538                                   ii = ii + 1 .
     1539                                   hh:width-chars = 3 .
     1540                               end.
     1541                           when "b-hist-user" then
     1542                               do:
     1543                                   hh:load-image("cmp/b-hist.bmp":u) .
     1544                                   hh:TOOLTIP = "История пользователя" .
     1545                                   ii = ii + 1 .
     1546                               end.
     1547                       end case.
     1548                   end.
     1549                   hh = hh:next-sibling.
     1550               end.
     1551               b-help:column = v-frame-width - b-help:width-chars.
     1552               jj = 0.
     1553               repeat ii = 4 to 1 by -1 :
     1554                   if valid-handle (v-h[ii] ) then
     1555                   do:
     1556                       jj  = jj + 1 .
     1557                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1558                       v-h[ii]:row    = v-help-old-y .
     1559                   end.
     1560               end.
     1561           end.
     1562       end.
     1563   end procedure.
     1564   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1565   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1566   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1567   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1568   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1569   define variable v-diasize-current-frame-height as decimal   no-undo .
     1570   define variable v-diasize-change-size          as logical   no-undo .
     1571   define variable v-diasize-resize-button        as handle    no-undo .
     1572   define variable v-diasize-wndmax               as logical   no-undo .
     1573   define variable v-diasize-wndstore             as logical   no-undo .
     1574   define variable v-diasize-proc-name            as character no-undo .
     1575   define variable v-diasize-browse-handle        as handle    no-undo .
     1576   define variable v-diasize-browse-number        as integer   no-undo .
     1577   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1578   define temp-table temp-diasize-handle no-undo
     1579     field handle-value  as handle
     1580     field save-position as decimal
     1581     index xpk is primary unique handle-value
     1582     .
     1583   define temp-table temp-browse-handle no-undo
     1584     field browse-type   as character
     1585     field browse-number as integer
     1586     field browse-handle as handle
     1587     field original-size as decimal
     1588     index xpk is primary unique browse-type browse-number
     1589     index xie browse-type browse-handle
     1590   .
     1591   procedure diasize_change-height :
     1592     define input  parameter p-change-value  as decimal   no-undo .
     1593     define input  parameter p-move-resize   as logical   no-undo .
     1594     define variable v-field-group-handle    as handle    no-undo .
     1595     define variable v-object-handle         as handle    no-undo .
     1596     define variable v-frame-height          as decimal   no-undo .
     1597     define variable v-frame-virtual-height  as decimal   no-undo .
     1598     define variable v-browse-height         as decimal   no-undo .
     1599     define variable v-window-height         as decimal   no-undo .
     1600     define variable v-window-virtual-height as decimal   no-undo .
     1601     define variable v-change-sign           as integer   no-undo .
     1602     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1603     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1604     if p-change-value > 0
     1605     then do:
     1606       if frame Dialog-Frame :height + p-change-value
     1607           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1608       then do:
     1609         assign
     1610           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1611                           - (frame Dialog-Frame :height-chars)
     1612         .
     1613         if p-change-value <= 0
     1614         then do:
     1615           run diasize_position-resize-button in this-procedure .
     1616           return .
     1617         end.
     1618       end.
     1619     end.
     1620     if p-change-value < 0
     1621     then do:
     1622       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1623       then do:
     1624         assign
     1625           p-change-value = v-diasize-orig-frame-height
     1626                          - (frame Dialog-Frame :height-chars)
     1627         .
     1628         if p-change-value >= 0
     1629         then do:
     1630           run diasize_position-resize-button in this-procedure .
     1631           return .
     1632         end.
     1633       end.
     1634     end.
     1635     if p-change-value >= 0
     1636     then do:
     1637       assign
     1638         v-change-sign = 1
     1639       .
     1640     end.
     1641     else do:
     1642       assign
     1643         v-change-sign = -1
     1644       .
     1645     end.
     1646     assign
     1647       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1648     .
     1649     if p-change-value = 0
     1650     then do:
     1651       run diasize_position-resize-button in this-procedure .
     1652       return .
     1653     end.
     1654     move_block:
     1655     do
     1656     on error undo move_block, retry move_block
     1657     :
     1658       if retry
     1659       then do:
     1660         do
     1661         on error undo move_block, leave move_block
     1662         :
     1663           if p-change-value > 0
     1664           then do:
     1665             for each buf_temp-diasize-handle
     1666             on error undo, next
     1667             :
     1668               assign
     1669                 v-object-handle = buf_temp-diasize-handle.handle-value
     1670               .
     1671               if v-object-handle <> v-diasize-resize-button
     1672               then do:
     1673                 assign
     1674                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1675                 .
     1676               end.
     1677             end.
     1678             assign
     1679               v-diasize-browse-handle :height = v-browse-height
     1680             .
     1681             for each buf_temp-browse-handle
     1682               where buf_temp-browse-handle.browse-type = 'height':u
     1683             on error undo, next
     1684             :
     1685               assign
     1686                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1687               .
     1688             end.
     1689             assign
     1690               frame Dialog-Frame :height = v-frame-height
     1691             .
     1692             if frame Dialog-Frame :scrollable = true
     1693             then do:
     1694               assign
     1695                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1696               .
     1697             end.
     1698             run diasize_position-resize-button in this-procedure .
     1699           end.
     1700           else do:
     1701             if frame Dialog-Frame :scrollable = true
     1702             then do:
     1703               assign
     1704                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1705               .
     1706             end.
     1707             assign
     1708               frame Dialog-Frame :height = v-frame-height
     1709             .
     1710             assign
     1711               v-diasize-browse-handle :height = v-browse-height
     1712             .
     1713             for each buf_temp-browse-handle
     1714               where buf_temp-browse-handle.browse-type = 'height':u
     1715             on error undo, next
     1716             :
     1717               assign
     1718                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1719               .
     1720             end.
     1721             for each buf_temp-diasize-handle
     1722             on error undo, next
     1723             :
     1724               assign
     1725                 v-object-handle = buf_temp-diasize-handle.handle-value
     1726               .
     1727               if v-object-handle <> v-diasize-resize-button
     1728               then do:
     1729                 assign
     1730                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1731                 .
     1732               end.
     1733             end.
     1734             run diasize_position-resize-button in this-procedure .
     1735           end.
     1736           assign
     1737             v-diasize-change-size = false
     1738           .
     1739           leave move_block .
     1740         end.
     1741       end.
     1742       assign
     1743         v-diasize-need-full-display = true
     1744       .
     1745       if v-diasize-change-size = false
     1746       then do:
     1747         assign
     1748           v-diasize-change-size = true
     1749         .
     1750       end.
     1751       else do:
     1752         return .
     1753       end.
     1754       assign
     1755         v-frame-height = frame Dialog-Frame :height
     1756         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1757         v-browse-height = v-diasize-browse-handle :height
     1758       .
     1759       for each buf_temp-browse-handle
     1760         where buf_temp-browse-handle.browse-type = 'height':u
     1761       :
     1762         assign
     1763           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1764         .
     1765       end.
     1766       for each buf_temp-diasize-handle
     1767       :
     1768         delete buf_temp-diasize-handle .
     1769       end.
     1770       assign
     1771         v-field-group-handle = frame Dialog-Frame :first-child
     1772       .
     1773       do while valid-handle(v-field-group-handle)
     1774       :
     1775         assign
     1776           v-object-handle = v-field-group-handle :first-child
     1777         .
     1778         do while valid-handle(v-object-handle)
     1779         :
     1780           if  v-object-handle <> v-diasize-browse-handle :handle
     1781           and can-query(v-object-handle, "row")
     1782           and can-query(v-object-handle, "height")
     1783           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1784           then do:
     1785             find first buf_temp-browse-handle
     1786               where buf_temp-browse-handle.browse-type   = 'height':u
     1787                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1788               no-error .
     1789             if available buf_temp-browse-handle
     1790             then do:
     1791             end.
     1792             else do:
     1793               create buf_temp-diasize-handle .
     1794               assign
     1795                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1796                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1797               .
     1798             end.
     1799           end.
     1800           assign
     1801             v-object-handle = v-object-handle :next-sibling
     1802           .
     1803         end.
     1804         assign
     1805           v-field-group-handle = v-field-group-handle :next-sibling
     1806         .
     1807       end.
     1808       do with frame Dialog-Frame
     1809       :
     1810         hide v-diasize-resize-button .
     1811         assign
     1812           v-diasize-resize-button :row    = 1
     1813           v-diasize-resize-button :column = 1
     1814         .
     1815       end.
     1816       if p-change-value > 0
     1817       then do:
     1818         if frame Dialog-Frame :scrollable = true
     1819         then do:
     1820           assign
     1821             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1822             no-error .
     1823           if error-status :error
     1824           or error-status :get-message(1) <> ""
     1825           then do:
     1826             undo move_block, retry move_block .
     1827           end.
     1828         end.
     1829         assign
     1830           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1831           no-error .
     1832         if error-status :error
     1833         or error-status :get-message(1) <> ""
     1834         then do:
     1835           undo move_block, retry move_block .
     1836         end.
     1837         assign
     1838           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1839           no-error .
     1840         if error-status :error
     1841         or error-status :get-message(1) <> ""
     1842         then do:
     1843           undo move_block, retry move_block .
     1844         end.
     1845         for each buf_temp-browse-handle
     1846           where buf_temp-browse-handle.browse-type = 'height':u
     1847         on error undo move_block, retry move_block
     1848         :
     1849           assign
     1850             buf_temp-browse-handle.browse-handle :height
     1851               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1852             no-error .
     1853           if error-status :error
     1854           or error-status :get-message(1) <> ""
     1855           then do:
     1856             undo move_block, retry move_block .
     1857           end.
     1858         end.
     1859         for each buf_temp-diasize-handle
     1860         on error undo move_block, retry move_block
     1861         :
     1862           assign
     1863             v-object-handle = buf_temp-diasize-handle.handle-value
     1864           .
     1865           if v-object-handle <> v-diasize-resize-button
     1866           then do:
     1867             assign
     1868               v-object-handle :row = v-object-handle :row + p-change-value
     1869               no-error .
     1870             if error-status :error
     1871             or error-status :get-message(1) <> ""
     1872             then do:
     1873               undo move_block, retry move_block .
     1874             end.
     1875           end.
     1876         end.
     1877       end.
     1878       else do:
     1879         for each buf_temp-diasize-handle
     1880         on error undo move_block, retry move_block
     1881         :
     1882           assign
     1883             v-object-handle = buf_temp-diasize-handle.handle-value
     1884           .
     1885           if v-object-handle <> v-diasize-resize-button
     1886           then do:
     1887             assign
     1888               v-object-handle :row = v-object-handle :row + p-change-value
     1889               no-error .
     1890             if error-status :error
     1891             or error-status :get-message(1) <> ""
     1892             then do:
     1893               undo move_block, retry move_block .
     1894             end.
     1895           end.
     1896         end.
     1897         assign
     1898           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1899           no-error .
     1900         if error-status :error
     1901         or error-status :get-message(1) <> ""
     1902         then do:
     1903           undo move_block, retry move_block .
     1904         end.
     1905         for each buf_temp-browse-handle
     1906           where buf_temp-browse-handle.browse-type = 'height':u
     1907         on error undo move_block, retry move_block
     1908         :
     1909           assign
     1910             buf_temp-browse-handle.browse-handle :height
     1911               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1912             no-error .
     1913           if error-status :error
     1914           or error-status :get-message(1) <> ""
     1915           then do:
     1916             undo move_block, retry move_block .
     1917           end.
     1918         end.
     1919         assign
     1920           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1921           no-error .
     1922         if error-status :error
     1923         or error-status :get-message(1) <> ""
     1924         then do:
     1925           undo move_block, retry move_block .
     1926         end.
     1927         if frame Dialog-Frame :scrollable = true
     1928         then do:
     1929           assign
     1930             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1931             no-error .
     1932           if error-status :error
     1933           or error-status :get-message(1) <> ""
     1934           then do:
     1935             undo move_block, retry move_block .
     1936           end.
     1937         end.
     1938       end.
     1939       if p-move-resize = true
     1940       then do:
     1941         run diasize_position-resize-button in this-procedure .
     1942       end.
     1943       if v-diasize-wndstore = true
     1944       then do:
     1945         if connected("ub") = true
     1946         then do:
     1947           define variable v-cntxt-db-num        as integer   no-undo .
     1948           define variable v-cntxt-userid        as character no-undo .
     1949           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1950                                             , OUTPUT v-cntxt-userid
     1951                                             ) .
     1952           run gbl/wndsizew.p
     1953             (input  v-cntxt-db-num
     1954             ,input  v-cntxt-userid
     1955             ,input  v-diasize-proc-name
     1956             ,input  'height':u
     1957             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1958             ) .
     1959         end.
     1960       end.
     1961     end.
     1962     assign
     1963       v-diasize-change-size = false
     1964     .
     1965   end procedure.
     1966   procedure diasize_set-height :
     1967     define input  parameter p-new-height  as decimal   no-undo .
     1968     define input  parameter p-move-resize as logical   no-undo .
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       run diasize_change-height in this-procedure
     1973         (input  (p-new-height - frame Dialog-Frame :height)
     1974         ,input  p-move-resize
     1975         ) .
     1976     end.
     1977   end procedure.
     1978   procedure diasize_change-width :
     1979     define input  parameter p-change-value as decimal   no-undo .
     1980     define input  parameter p-move-resize  as logical   no-undo .
     1981     define variable v-field-group-handle   as handle    no-undo .
     1982     define variable v-object-handle        as handle    no-undo .
     1983     define variable v-frame-width          as decimal   no-undo .
     1984     define variable v-frame-virtual-width  as decimal   no-undo .
     1985     define variable v-browse-width         as decimal   no-undo .
     1986     define variable v-window-width         as decimal   no-undo .
     1987     define variable v-window-virtual-width as decimal   no-undo .
     1988     define variable v-change-sign          as integer   no-undo .
     1989     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1990     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1991     if p-change-value > 0
     1992     then do:
     1993       if frame Dialog-Frame :width + p-change-value >
     1994           session :width-chars
     1995       then do:
     1996         assign
     1997           p-change-value = session :width-chars - frame Dialog-Frame :width
     1998         .
     1999         if p-change-value <= 0
     2000         then do:
     2001           run diasize_position-resize-button in this-procedure .
     2002           return .
     2003         end.
     2004       end.
     2005     end.
     2006     if p-change-value < 0
     2007     then do:
     2008       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2009       then do:
     2010         assign
     2011           p-change-value = v-diasize-orig-frame-width
     2012                          - frame Dialog-Frame :width
     2013         .
     2014         if p-change-value >= 0
     2015         then do:
     2016           run diasize_position-resize-button in this-procedure .
     2017           return .
     2018         end.
     2019       end.
     2020     end.
     2021     if p-change-value >= 0
     2022     then do:
     2023       assign
     2024         v-change-sign = 1
     2025       .
     2026     end.
     2027     else do:
     2028       assign
     2029         v-change-sign = -1
     2030       .
     2031     end.
     2032     assign
     2033       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2034     .
     2035     if p-change-value = 0
     2036     then do:
     2037       run diasize_position-resize-button in this-procedure .
     2038       return .
     2039     end.
     2040     move_block:
     2041     do
     2042     on error undo move_block, leave move_block
     2043     :
     2044       if retry
     2045       then do:
     2046         do
     2047         on error undo move_block, leave move_block
     2048         :
     2049           if p-change-value > 0
     2050           then do:
     2051             for each buf_temp-diasize-handle
     2052             on error undo, next
     2053             :
     2054               assign
     2055                 v-object-handle = buf_temp-diasize-handle.handle-value
     2056               .
     2057               if v-object-handle <> v-diasize-resize-button
     2058               then do:
     2059                 assign
     2060                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2061                 .
     2062               end.
     2063             end.
     2064             assign
     2065               v-diasize-browse-handle :width = v-browse-width
     2066             .
     2067             for each buf_temp-browse-handle
     2068               where buf_temp-browse-handle.browse-type = 'width':u
     2069             on error undo, next
     2070             :
     2071               assign
     2072                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2073               .
     2074             end.
     2075             assign
     2076               frame Dialog-Frame :width = v-frame-width
     2077             .
     2078             if frame Dialog-Frame :scrollable = true
     2079             then do:
     2080               assign
     2081                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2082               .
     2083             end.
     2084             run diasize_position-resize-button in this-procedure .
     2085           end.
     2086           else do:
     2087             if frame Dialog-Frame :scrollable = true
     2088             then do:
     2089               assign
     2090                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2091               .
     2092             end.
     2093             assign
     2094               frame Dialog-Frame :width = v-frame-width
     2095             .
     2096             for each buf_temp-browse-handle
     2097               where buf_temp-browse-handle.browse-type = 'width':u
     2098             on error undo, next
     2099             :
     2100               assign
     2101                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2102               .
     2103             end.
     2104             assign
     2105               v-diasize-browse-handle :width = v-browse-width
     2106             .
     2107             for each buf_temp-diasize-handle
     2108             on error undo, next
     2109             :
     2110               assign
     2111                 v-object-handle = buf_temp-diasize-handle.handle-value
     2112               .
     2113               if v-object-handle <> v-diasize-resize-button
     2114               then do:
     2115                 assign
     2116                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2117                 .
     2118               end.
     2119             end.
     2120             run diasize_position-resize-button in this-procedure .
     2121           end.
     2122           assign
     2123             v-diasize-change-size = false
     2124           .
     2125           leave move_block .
     2126         end.
     2127       end.
     2128       assign
     2129         v-diasize-need-full-display = true
     2130       .
     2131       if v-diasize-change-size = false
     2132       then do:
     2133         assign
     2134           v-diasize-change-size = true
     2135         .
     2136       end.
     2137       else do:
     2138         return .
     2139       end.
     2140       assign
     2141         v-frame-width = frame Dialog-Frame :width
     2142         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2143         v-browse-width = v-diasize-browse-handle :width
     2144       .
     2145       for each buf_temp-browse-handle
     2146         where buf_temp-browse-handle.browse-type = 'width':u
     2147       :
     2148         assign
     2149           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2150         .
     2151       end.
     2152       for each buf_temp-diasize-handle
     2153       :
     2154         delete buf_temp-diasize-handle .
     2155       end.
     2156       assign
     2157         v-field-group-handle = frame Dialog-Frame :first-child
     2158       .
     2159       do while valid-handle(v-field-group-handle)
     2160       :
     2161         assign
     2162           v-object-handle = v-field-group-handle :first-child
     2163         .
     2164         do while valid-handle(v-object-handle)
     2165         :
     2166           if  v-object-handle <> v-diasize-browse-handle :handle
     2167           and v-object-handle <> v-diasize-resize-button
     2168           and can-query(v-object-handle, "row")
     2169           and can-query(v-object-handle, "height")
     2170           and ( v-object-handle :col + v-object-handle :width
     2171                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2172               )
     2173           then do:
     2174             find first buf_temp-browse-handle
     2175               where buf_temp-browse-handle.browse-type   = 'width':u
     2176                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2177               no-error .
     2178             if available buf_temp-browse-handle
     2179             then do:
     2180             end.
     2181             else do:
     2182               create buf_temp-diasize-handle .
     2183               assign
     2184                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2185                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2186               .
     2187             end.
     2188           end.
     2189           assign
     2190             v-object-handle = v-object-handle :next-sibling
     2191           .
     2192         end.
     2193         assign
     2194           v-field-group-handle = v-field-group-handle :next-sibling
     2195         .
     2196       end.
     2197       do with frame Dialog-Frame
     2198       :
     2199         hide v-diasize-resize-button .
     2200         v-diasize-resize-button :row = 1.
     2201         v-diasize-resize-button :column = 1.
     2202       end.
     2203       if p-change-value > 0
     2204       then do:
     2205         if frame Dialog-Frame :scrollable = true
     2206         then do:
     2207           assign
     2208             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2209             no-error .
     2210           if error-status :error
     2211           or error-status :get-message(1) <> ""
     2212           then do:
     2213             undo move_block, retry move_block.
     2214           end.
     2215         end.
     2216         assign
     2217           frame Dialog-Frame :width = v-frame-width + p-change-value
     2218           no-error .
     2219         if error-status :error
     2220         or error-status :get-message(1) <> ""
     2221         then do:
     2222           undo move_block, retry move_block.
     2223         end.
     2224         assign
     2225           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2226         no-error .
     2227         if error-status :error
     2228         or error-status :get-message(1) <> ""
     2229         then do:
     2230           undo move_block, retry move_block.
     2231         end.
     2232         for each buf_temp-browse-handle
     2233           where buf_temp-browse-handle.browse-type = 'width':u
     2234         on error undo move_block, retry move_block
     2235         :
     2236           assign
     2237             buf_temp-browse-handle.browse-handle :width
     2238               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2239             no-error .
     2240           if error-status :error
     2241           or error-status :get-message(1) <> ""
     2242           then do:
     2243             undo move_block, retry move_block .
     2244           end.
     2245         end.
     2246         for each buf_temp-diasize-handle
     2247         on error undo move_block, retry move_block
     2248         :
     2249           assign
     2250             v-object-handle = buf_temp-diasize-handle.handle-value
     2251           .
     2252           if v-object-handle <> v-diasize-resize-button
     2253           then do:
     2254             assign
     2255               v-object-handle :col = v-object-handle :col + p-change-value
     2256               no-error .
     2257             if error-status :error
     2258             or error-status :get-message(1) <> ""
     2259             then do:
     2260               undo move_block, retry move_block .
     2261             end.
     2262           end.
     2263         end.
     2264       end.
     2265       else do:
     2266         for each buf_temp-diasize-handle
     2267         on error undo move_block, retry move_block
     2268         :
     2269           assign
     2270             v-object-handle = buf_temp-diasize-handle.handle-value
     2271           .
     2272           if v-object-handle <> v-diasize-resize-button
     2273           then do:
     2274             assign
     2275               v-object-handle :col = v-object-handle :col + p-change-value
     2276               no-error .
     2277             if error-status :error
     2278             or error-status :get-message(1) <> ""
     2279             then do:
     2280               undo move_block, retry move_block .
     2281             end.
     2282           end.
     2283         end.
     2284         for each buf_temp-browse-handle
     2285           where buf_temp-browse-handle.browse-type = 'width':u
     2286         on error undo move_block, retry move_block
     2287         :
     2288           assign
     2289             buf_temp-browse-handle.browse-handle :width
     2290               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2291             no-error .
     2292           if error-status :error
     2293           or error-status :get-message(1) <> ""
     2294           then do:
     2295             undo move_block, retry move_block .
     2296           end.
     2297         end.
     2298         assign
     2299           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2300           no-error .
     2301         if error-status :error
     2302         or error-status :get-message(1) <> ""
     2303         then do:
     2304           undo move_block, retry move_block.
     2305         end.
     2306         assign
     2307           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2308         no-error .
     2309         if error-status :error
     2310         or error-status :get-message(1) <> ""
     2311         then do:
     2312           undo move_block, retry move_block.
     2313         end.
     2314         if frame Dialog-Frame :scrollable = true
     2315         then do:
     2316           assign
     2317             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2318           no-error .
     2319           if error-status :error
     2320           or error-status :get-message(1) <> ""
     2321           then do:
     2322             undo move_block, retry move_block.
     2323           end.
     2324         end.
     2325       end.
     2326       if p-move-resize
     2327       then do:
     2328         run diasize_position-resize-button in this-procedure .
     2329       end.
     2330       if v-diasize-wndstore = true
     2331       then do:
     2332         if connected("ub") = true
     2333         then do:
     2334           define variable v-cntxt-db-num        as integer   no-undo .
     2335           define variable v-cntxt-userid        as character no-undo .
     2336           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2337                                             , OUTPUT v-cntxt-userid
     2338                                             ) .
     2339           run gbl/wndsizew.p
     2340             (input  v-cntxt-db-num
     2341             ,input  v-cntxt-userid
     2342             ,input  v-diasize-proc-name
     2343             ,input  'width':u
     2344             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2345             ) .
     2346         end.
     2347       end.
     2348     end.
     2349     assign
     2350       v-diasize-change-size = false
     2351     .
     2352   end procedure.
     2353   procedure diasize_set-width :
     2354     define input  parameter p-new-width  as decimal   no-undo .
     2355     define input  parameter p-move-resize as logical   no-undo .
     2356     do
     2357     on error undo, return error return-value
     2358     :
     2359       run diasize_change-width in this-procedure
     2360         (input  (p-new-width - frame Dialog-Frame :width)
     2361         ,input  p-move-resize
     2362         ) .
     2363     end.
     2364   end procedure.
     2365   procedure diasize_position-resize-button :
     2366     do with frame Dialog-Frame
     2367     :
     2368       hide v-diasize-resize-button .
     2369       assign
     2370         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2371                     - 1
     2372                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2373         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2374                     - 1
     2375                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2376       .
     2377       view v-diasize-resize-button .
     2378     end.
     2379   end procedure.
     2380   on alt-right anywhere
     2381   do:
     2382     run diasize_change-width in this-procedure
     2383       (input 1
     2384       ,input true
     2385       ) .
     2386     return no-apply .
     2387   end.
     2388   on alt-left anywhere
     2389   do:
     2390     run diasize_change-width in this-procedure
     2391       (input -1
     2392       ,input true
     2393       ) .
     2394     return no-apply .
     2395   end.
     2396   on alt-down anywhere
     2397   do:
     2398     run diasize_change-height in this-procedure
     2399       (input 1
     2400       ,input true
     2401       ) .
     2402     return no-apply .
     2403   end.
     2404   on alt-up anywhere
     2405   do:
     2406     run diasize_change-height in this-procedure
     2407       (input -1
     2408       ,input true
     2409       ) .
     2410     return no-apply .
     2411   end.
     2412   on alt-enter of frame Dialog-Frame
     2413   do:
     2414     run diasize_maximize in this-procedure
     2415       (input  ?
     2416       ).
     2417     return no-apply .
     2418   end.
     2419   procedure diasize_end-move :
     2420     do
     2421     on error undo, return error return-value
     2422     :
     2423       define variable v-row-delta as decimal   no-undo .
     2424       define variable v-col-delta as decimal   no-undo .
     2425       define variable v-new-row as decimal   no-undo .
     2426       define variable v-new-col as decimal   no-undo .
     2427       assign
     2428         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2429         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2430       .
     2431       assign
     2432         v-row-delta = v-new-row - frame Dialog-Frame :height
     2433         v-col-delta = v-new-col - frame Dialog-Frame :width
     2434       .
     2435       run diasize_change-height in this-procedure
     2436         (input v-row-delta
     2437         ,input true
     2438         ) .
     2439       run diasize_change-width in this-procedure
     2440         (input v-col-delta
     2441         ,input true
     2442         ) .
     2443     end.
     2444   end procedure.
     2445   procedure diasize_maximize :
     2446     define input  parameter p-action as logical   no-undo .
     2447     do
     2448     on error undo, return error return-value
     2449     :
     2450       if p-action = ?
     2451       then do:
     2452         if v-diasize-need-maximize = true
     2453         then do:
     2454           assign
     2455             p-action = true
     2456           .
     2457         end.
     2458         else do:
     2459           assign
     2460             p-action = false
     2461           .
     2462         end.
     2463       end.
     2464       if p-action = true
     2465       then do:
     2466         run diasize_change-height in this-procedure
     2467           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2468               - frame Dialog-Frame :height-chars
     2469           ,input true
     2470           ) .
     2471         run diasize_change-width in this-procedure
     2472           (input session :width-chars
     2473               - frame Dialog-Frame :width-chars
     2474           ,input true
     2475           ) .
     2476         assign
     2477           v-diasize-need-maximize = false
     2478         .
     2479       end.
     2480       else do:
     2481         run diasize_change-width in this-procedure
     2482           (input v-diasize-orig-frame-width
     2483               - frame Dialog-Frame :width-chars
     2484           ,input true
     2485           ) .
     2486         run diasize_change-height in this-procedure
     2487           (input v-diasize-orig-frame-height
     2488               - frame Dialog-Frame :height-chars
     2489           ,input true
     2490           ) .
     2491         assign
     2492           v-diasize-need-maximize = true
     2493         .
     2494       end.
     2495     end.
     2496   end procedure.
     2497   procedure diasize_restore-orig-size :
     2498     do
     2499     on error undo, return error return-value
     2500     :
     2501       assign
     2502         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2503         v-diasize-current-frame-height = frame Dialog-Frame :height
     2504       .
     2505       run diasize_set-height in this-procedure
     2506         (input  v-diasize-orig-frame-height
     2507         ,input  true
     2508         ) .
     2509       run diasize_set-width in this-procedure
     2510         (input  v-diasize-orig-frame-width
     2511         ,input  true
     2512         ) .
     2513     end.
     2514   end procedure.
     2515   procedure diasize_restore-current-size :
     2516     do
     2517     on error undo, return error return-value
     2518     :
     2519       run diasize_set-height in this-procedure
     2520         (input  v-diasize-current-frame-height
     2521         ,input  true
     2522         ) .
     2523       run diasize_set-width in this-procedure
     2524         (input  v-diasize-current-frame-width
     2525         ,input  true
     2526         ) .
     2527     end.
     2528   end procedure.
     2529   procedure diasize_set-browse-handle :
     2530     define input  parameter p-browse-handle as handle   no-undo .
     2531     define buffer buf_temp-browse-handle for temp-browse-handle .
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       assign
     2536         v-diasize-browse-handle = p-browse-handle
     2537       .
     2538       for each buf_temp-browse-handle
     2539       on error undo, return error return-value
     2540       :
     2541         delete buf_temp-browse-handle .
     2542       end.
     2543     end.
     2544   end procedure.
     2545   procedure diasize_add_browse :
     2546     define input  parameter p-browse-type   as character no-undo .
     2547     define input  parameter p-browse-handle as handle    no-undo .
     2548     define buffer buf_temp-browse-handle for temp-browse-handle .
     2549     do
     2550     on error undo, return error return-value
     2551     :
     2552       assign
     2553         v-diasize-browse-number = v-diasize-browse-number + 1
     2554       .
     2555       create buf_temp-browse-handle .
     2556       assign
     2557         buf_temp-browse-handle.browse-type   = p-browse-type
     2558         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2559         buf_temp-browse-handle.browse-handle = p-browse-handle
     2560       .
     2561     end.
     2562   end procedure.
     2563   procedure diasize_init :
     2564     define variable v-default-value    as logical   no-undo .
     2565     define variable v-restore-saved    as logical   no-undo .
     2566     define variable v-resize-value-str as character no-undo .
     2567     do
     2568     on error undo, return error return-value
     2569     :
     2570       do with frame Dialog-Frame
     2571       :
     2572         assign
     2573           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2574           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2575           v-diasize-browse-handle     = browse BR-docs :handle
     2576         .
     2577         create button v-diasize-resize-button
     2578         assign
     2579           parent        = frame Dialog-Frame :first-child
     2580           label         = "s"
     2581           height-pixels = 16
     2582           width-pixels  = 16
     2583           visible       = true
     2584           sensitive     = true
     2585           movable       = true
     2586           triggers:
     2587             on end-move persistent run diasize_end-move in this-procedure .
     2588           end triggers.
     2589         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2590         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2591         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2592         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2593         assign
     2594           v-diasize-wndmax = false
     2595         .
     2596         if connected("ub") = true
     2597         then do:
     2598           define variable v-cntxt-db-num        as integer   no-undo .
     2599           define variable v-cntxt-userid        as character no-undo .
     2600           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2601                                             , OUTPUT v-cntxt-userid
     2602                                             ) .
     2603           run gbl/wndpar_r.p
     2604             (input  v-cntxt-db-num
     2605             ,input  v-cntxt-userid
     2606             ,input  'wndmax':U
     2607             ,output v-diasize-wndmax
     2608             ,output v-default-value
     2609             ) .
     2610         end.
     2611         assign
     2612           v-diasize-wndstore = false
     2613         .
     2614         if connected("ub") = true
     2615         then do:
     2616           run gbl/wndpar_r.p
     2617             (input  v-cntxt-db-num
     2618             ,input  v-cntxt-userid
     2619             ,input  'wndstore':U
     2620             ,output v-diasize-wndstore
     2621             ,output v-default-value
     2622             ) .
     2623         end.
     2624         assign
     2625           v-diasize-proc-name = entry(1, program-name(2), '.')
     2626         .
     2627         if v-diasize-wndstore = true
     2628         then do:
     2629           assign
     2630             v-restore-saved = false
     2631           .
     2632           if connected("ub") = true
     2633           then do:
     2634             run gbl/wndsizer.p
     2635               (input  v-cntxt-db-num
     2636               ,input  v-cntxt-userid
     2637               ,input  v-diasize-proc-name
     2638               ,input  'height':u
     2639               ,output v-resize-value-str
     2640               ) .
     2641             if v-resize-value-str <> '':U
     2642             then do:
     2643               run diasize_change-height in this-procedure
     2644                 (input  integer(v-resize-value-str)
     2645                 ,input  true
     2646                 ) .
     2647               assign
     2648                 v-restore-saved = true
     2649               .
     2650             end.
     2651           end.
     2652           if connected("ub") = true
     2653           then do:
     2654             run gbl/wndsizer.p
     2655               (input  v-cntxt-db-num
     2656               ,input  v-cntxt-userid
     2657               ,input  v-diasize-proc-name
     2658               ,input  'width':u
     2659               ,output v-resize-value-str
     2660               ) .
     2661             if v-resize-value-str <> '':U
     2662             then do:
     2663               run diasize_change-width in this-procedure
     2664                 (input  integer(v-resize-value-str)
     2665                 ,input  true
     2666                 ) .
     2667               assign
     2668                 v-restore-saved = true
     2669               .
     2670             end.
     2671           end.
     2672           if v-restore-saved <> true
     2673           then do:
     2674             if v-diasize-wndmax = true
     2675             then do:
     2676               run diasize_maximize in this-procedure
     2677                 (input  true
     2678                 ) .
     2679             end.
     2680           end.
     2681         end.
     2682         else do:
     2683           if v-diasize-wndmax = true
     2684           then do:
     2685             run diasize_maximize in this-procedure
     2686               (input  true
     2687               ) .
     2688           end.
     2689         end.
     2690       end.
     2691     end.
     2692   end procedure.
     2693   procedure diasize_need-full-display :
     2694     define output parameter p-need-full-display as logical   no-undo .
     2695     do
     2696     on error undo, return error return-value
     2697     :
     2698       assign
     2699         p-need-full-display = v-diasize-need-full-display
     2700       .
     2701       assign
     2702         v-diasize-need-full-display = false
     2703       .
     2704     end.
     2705   end procedure.
     2706   procedure get-context :
     2707      define output parameter p-db-num as integer          no-undo.
     2708      define output parameter p-user-id as character        no-undo.
     2709      define variable v-login               as character    no-undo.
     2710      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2711      define buffer buf_user-login  for ub.user-login .
     2712      do
     2713      on error undo, return error
     2714      :
     2715            FIND FIRST buf_sys-ctrl no-lock.
     2716            ASSIGN
     2717               v-login = USERID("ub")
     2718               p-db-num = buf_sys-ctrl.db-num
     2719            .
     2720            FIND FIRST buf_user-login
     2721                 WHERE buf_user-login.db-num = p-db-num
     2722                   AND buf_user-login.user-login = v-login
     2723                 no-lock
     2724                 no-error
     2725                 .
     2726            IF AVAILABLE buf_user-login
     2727            THEN DO:
     2728               assign
     2729                  p-user-id = buf_user-login.user-id
