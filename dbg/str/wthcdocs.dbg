     3073   PROCEDURE OpenBr :
     3074   define input  parameter p-open-query     as logical   no-undo .
     3075   define input  parameter p-find-next      as logical   no-undo .
     3076   define input  parameter p-find-condition as character no-undo .
     3077   define variable l-query-was-opened as logical no-undo .
     3078   define variable title0 as character no-undo.
     3079   title0 = "История документов МЦ".
     3080   define variable sort-column-phrase as character no-undo .
     3081   case sort-column-name :
     3082   when "" then do:
     3083   assign
     3084     sort-column-phrase = ""
     3085   .
     3086   end.
     3087   otherwise do:
     3088   assign
     3089     sort-column-phrase = "by " + sort-column-name
     3090   .
     3091   end.
     3092   end case.
     3093   define variable l-open-query as logical   no-undo .
     3094   filter-point = filter-point0 + par-mode.
     3095   CASE par-mode :
     3096   WHEN 'one'      THEN DO:
     3097     if p-open-query then do:
     3098       ASSIGN
     3099       frame Dialog-Frame:TITLE = title0 + " Документ № " + p-doc-code.
     3100     end.
     3101     filter-label = substitute("&1 Один документ", filter-label0)
     3102     .
     3103   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3104   define variable  l-disable-where-34  as logical   no-undo .
     3105   define variable  l-filter-open-34    as logical   .
     3106   define variable  flt-rec-34       as recid     no-undo .
     3107   define variable  filter-name-34      as character no-undo .
     3108   define variable  where-phrase-34     as character no-undo .
     3109   define variable  sort-phrase-34      as character no-undo .
     3110   define variable  where-phrase-rus-34 as character no-undo .
     3111   define variable  sort-phrase-rus-34  as character no-undo .
     3112     run waitfram-show in this-procedure
     3113       (input "ЖДИТЕ ..."
     3114       ).
     3115   run gbl/flt-get.p
     3116     (input filter-point
     3117     ,output flt-rec-34
     3118     ,output filter-name-34
     3119     ,output where-phrase-34
     3120     ,output sort-phrase-34
     3121     ,output where-phrase-rus-34
     3122     ,output sort-phrase-rus-34
     3123     ).
     3124   if p-open-query then do:
     3125       run set-filter-name in this-procedure
     3126         (INPUT filter-name-34
     3127         ) no-error .
     3128     assign
     3129       l-filter-open-34 = false
     3130     .
     3131     if flt-rec-34 <> ?
     3132       or sort-column-phrase > ""
     3133     then do:
     3134       define variable  parameter-2-34 as character no-undo .
     3135       define variable  parameter-3-34 as character no-undo .
     3136       define variable  parameter-4-34 as character no-undo .
     3137       define variable  parameter-5-34 as character no-undo .
     3138       define variable  parameter-6-34 as character no-undo .
     3139       define variable  parameter-7-34 as character no-undo .
     3140         assign
     3141         parameter-3-34 =
     3142                                 "FOR EACH X_c-wth-doc"
     3143         parameter-4-34 =
     3144           (
     3145             if (" X_c-wth-doc.doc-code = p-doc-code " + " " + where-phrase-34) <> ""
     3146             then  substitute('X_c-wth-doc.doc-code = &1&2&1', chr(34), p-doc-code ) + " " + where-phrase-34
     3147             else "true"
     3148           )
     3149         parameter-5-34 = (" " + "" + " " + "")
     3150         parameter-6-34 = if sort-phrase-34 = ''
     3151                              then
     3152           (
     3153           " " + " by X_c-wth-doc.corr-user-db-num by X_c-wth-doc.chip-num descending " +
     3154             " " + sort-column-phrase +
     3155           " " + "  "
     3156           )
     3157                              else
