      362   define  stream PrnLibStream.
      363   procedure prn-lib-prn-file :
      364     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      365     define input parameter p-DIsabledoptions as integer no-undo .
      366     define variable v-report-name as character no-undo .
      367     define variable v-user-action as character no-undo .
      368     define variable v-printed     as logical   no-undo .
      369     define variable v-exist       as logical   no-undo .
      370     do
      371       on error undo, return error
      372       :
      373       run prn-lib-get-report-name  in this-procedure (
      374         input parParentProc
      375         ,output v-report-name
      376         ).
      377   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      379     (input  v-report-name
      380     ,input  2
      381     ,output v-exist
      382     )  .
      383       if NOT v-exist then
      384       DO:
      385         Message
      386           "Нет заданий на печать ! "
      387           view-as alert-box .
      388         Return  .
      389       End.
      390       run gbl/prnfilen.w
      391         (input  ""
      392         ,input  p-DisabledOptions
      393         ,input  string(v-report-name )
      394         ,input  7
      395         ,output v-user-action
      396         ,output v-printed
      397         ) .
      398       if v-printed then
      399       do:
      400         return "YES" .
      401       end.
      402       else
      403       do:
      404         return "NO" .
      405       end.
      406     end.
      407   end procedure.
      408   procedure prn-lib-open-stream :
      409     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      410     define input parameter p-page-size    as integer no-undo .
      411     define input parameter p-is-stream    as logical no-undo .
      412     define input parameter p-append       as logical no-undo .
      413     define variable v-report-name as character no-undo .
      414     do
      415       on error undo, return error
      416       :
      417       run prn-lib-get-report-name  in this-procedure (
      418         input parParentProc
      419         ,output v-report-name
      420         ).
      421       if p-is-stream then
      422       do:
      423         if p-append then
      424         do:
      425           output stream PrnLibStream to value( v-report-name )
      426             page-size value(p-page-size) append .
      427         end.
      428         if not p-append then
      429         do:
      430           output stream PrnLibStream to value( v-report-name )
      431             page-size value(p-page-size) .
      432         end.
      433       end.
      434       if not p-is-stream then
      435       do:
      436         if p-append then
      437         do:
      438           output to value( v-report-name )
      439             page-size value(p-page-size) append .
      440         end.
      441         if not p-append then
      442         do:
      443           output to value( v-report-name )
      444             page-size value(p-page-size) .
      445         end.
      446       end.
      447     end.
      448   end procedure.
      449   procedure prn-lib-open-exp :
      450     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      451     define input parameter p-is-stream    as logical no-undo .
      452     define input parameter p-is-append    as logical no-undo .
      453     define output parameter p-ReportFileName as char init "report" no-undo.
      454     define output parameter p-process as logical no-undo .
      455     define variable glog as logical no-undo .
      456     do
      457       on error undo, return error
      458       :
      459       SYSTEM-DIALOG GET-FILE p-ReportFileName
      460         TITLE      "Укажите путь"
      461         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      462         ASK-OVERWRITE
      463         CREATE-TEST-FILE
      464         SAVE-AS
      465         USE-FILENAME
      466         DEFAULT-EXTENSION "txt"
      467         UPDATE glog
      468         .
      469       if not glog then  return.
      470       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      471       if p-is-stream then
      472       do:
      473         if p-is-append then
      474         do:
      475           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      476         end.
      477         else
      478         do:
      479           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      480         end.
      481       end.
      482       else
      483       do:
      484         if p-is-append then
      485         do:
      486           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      487         end.
      488         else
      489         do:
      490           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      491         end.
      492       end.
      493       p-process = yes.
      494     end.
      495   end procedure.
      496   procedure prn-lib-get-report-name :
      497     define input parameter parParentProc  as widget-handle no-undo.
      498     define output parameter p-report-name as character no-undo .
      499     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      500   end procedure.
      501   procedure prn-lib-reportviewer-report-name :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-report-name-html as character no-undo .
      504     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      505   end procedure.
      506   procedure prn-lib-reportviewer :
      507     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      508     define input parameter p-report-name-html as character no-undo .
      509     define input parameter p-param        as character no-undo .
      510     define variable v-excel           as character no-undo init 'TRUE' .
      511     define variable v-value-character as character no-undo .
      512     define variable v-value-integer   as character no-undo .
      513     define variable v-value-date      as date      no-undo .
      514     define variable v-value-decimal   as decimal   no-undo .
      515     define variable rep-excel         as logical   no-undo .
      516     define variable excel-string      as character no-undo .
      517     define variable v-param-type      as character no-undo .
      518     define variable v-tth             as handle    no-undo .
      519     run adm/shattri.p (
      520       input "get":U
      521       ,input  ""
      522       ,input  0
      523       ,input  'report-glob':U
      524       ,input  'rep-excel':U
      525       ,output v-value-character
      526       ,output v-value-date
      527       ,output v-value-decimal
      528       ,output v-value-integer
      529       ,output rep-excel
      530       ,output v-param-type
      531       ,INPUT-OUTPUT table-handle v-tth
      532       )  .
      533     if rep-excel then v-excel = "TRUE" .
      534     else v-excel = "FALSE" .
      535     if p-param eq ""
      536     then
      537        p-param = "EXCEL:" + v-excel.
      538     else
      539        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      540     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      541   end procedure.
      542   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   procedure fltfield-clear :
      544     define output parameter loc-fld as character no-undo.
      545     define output parameter loc-lab as character no-undo .
      546     define output parameter loc-spr as character no-undo .
      547     define output parameter loc-dim as character no-undo .
      548     assign
      549       loc-fld = ""
      550       loc-lab = ""
      551       loc-spr = ""
      552       loc-dim = "0"
      553     .
      554   end procedure .
      555   procedure fltfield-add :
      556     define input        parameter par-fld as character no-undo.
      557     define input        parameter par-lab as character no-undo .
      558     define input        parameter par-spr as character no-undo .
      559     define input-output parameter loc-fld as character no-undo.
      560     define input-output parameter loc-lab as character no-undo .
      561     define input-output parameter loc-spr as character no-undo .
      562     define input-output parameter loc-dim as character no-undo .
      563     do
      564     on error undo, return error
      565     :
      566       assign
      567       loc-fld = if loc-dim = '0'
      568                 then par-fld
      569                 else (loc-fld + chr(44) + par-fld)
      570       loc-lab = if loc-dim = '0'
      571                 then par-lab
      572                 else (loc-lab + chr(44) + par-lab)
      573       loc-spr = if loc-dim = '0'
      574                 then par-spr
      575                 else (loc-spr + chr(44) + par-spr)
      576       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      577                 string(integer(if num-entries(loc-dim) > 1
      578                               then entry(2, loc-dim)
      579                               else entry(1, loc-dim)
      580                               ) + 1)
      581       no-error
      582       .
      583     end.
      584   end procedure.
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   define variable v-waitfram-action01         as character   no-undo .
      587   define variable v-waitfram-action02         as character   no-undo .
      588   define variable v-waitfram-action03         as character   no-undo .
      589   define variable mWaitFramTextBeg            as character   no-undo.
      590   define variable mWaitFramTextEnd            as character   no-undo.
      591   define variable mWaitFramView               as logical     no-undo.
      592   define variable mWaitProcEvent              as logical     no-undo init yes.
      593   define variable mWaitFramInterval           as integer     no-undo init 1 .
      594   define variable mWaitFramStop               as logical     no-undo.
      595   define variable mWaitFramStopUser           as logical     no-undo.
      596   define variable mWaitFramStopTimeOut        as logical     no-undo.
      597   define variable mWaitFramStartProc          as datetime-tz no-undo.
      598   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      599   define button B-WaitFramStop auto-end-key
      600        label "Стоп"
      601        size 10 by 1 tooltip "Остоновить процесс".
      602   define button B-viewProcInfo
      603        label "Информация"
      604        size 15 by 1 tooltip "Информация о процесс".
      605   define frame waitfram
      606     v-waitfram-action01 format "x(72)" no-label skip
      607     v-waitfram-action02 format "x(72)" no-label skip
      608     v-waitfram-action03 format "x(72)" no-label skip
      609     B-viewProcInfo
      610     B-WaitFramStop at row 4 col 30
      611     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      612     .
      613   define new global shared variable mBatchMode as logical no-undo init ?.
      614   define variable mFramBachModHandle as handle no-undo.
      615   mFramBachModHandle = frame waitfram:handle.
      616   define variable mFameOldVis as logical no-undo.
      617   define variable mVisCUrentVin as logical no-undo.
      618   if session:batch-mode
      619   then
      620      mBatchMode = yes.
      621   if mBatchMode = ? then do:
      622     mVisCUrentVin = current-window:visible.
      623     mFameOldVis = mFramBachModHandle:visible.
      624     mFramBachModHandle:visible  = yes.
      625     mBatchMode = mFramBachModHandle:visible ne yes.
      626     mFramBachModHandle:visible = mFameOldVis.
      627     current-window:visible = mVisCUrentVin.
      628   end.
      629    if  log-manager:logfile-name ne ?
      630     then DO:
      631         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      632         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      633         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      634     end.
      635   on choose of B-WaitFramStop in frame waitfram
      636   do:
      637     mWaitFramStop = yes.
      638     mWaitFramStopUser = yes.
      639   end.
      640   function waitfram-check-timeout returns logical():
      641      define variable vtime as int64 no-undo.
      642      if mWaitFramStopTimeOut
      643      then
      644         return yes.
      645      vtime = ( now - mWaitFramStartProc ) / 1000 .
      646      if     mWaitFramTimeOut ne ?
      647         and mWaitFramTimeOut ne 0
      648         and mWaitFramTimeOut lt vtime
      649      then do:
      650         mWaitFramStopTimeOut = yes.
      651      end.
      652      return mWaitFramStopTimeOut.
      653   end.
      654   procedure waitfram-hide :
      655     if not session:batch-mode
      656     then do
      657     on error undo, return error return-value
      658     :
      659       pause 0 before-hide .
      660       if not mBatchMode then
      661         hide frame waitfram .
      662     if     not mWaitFramView
      663        and mWaitProcEvent
      664     then
      665       process events .
      666     end.
      667   end procedure.
      668   procedure waitfram-show :
      669     define input  parameter p-message as character no-undo .
      670     define variable v-left-margin as integer   no-undo .
      671     if not session:batch-mode
      672     then do
      673     on error undo, return error return-value
      674     :
      675       if length(p-message) <= 70 then do:
      676         assign
      677           v-left-margin = integer((70 - length(p-message)) / 2)
      678         .
      679         assign
      680           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      681         .
      682         assign
      683           v-waitfram-action01 = " "
      684           v-waitfram-action02 = " "
      685                                    + fill(" ", v-left-margin)
      686                                    + p-message
      687           v-waitfram-action03 = " "
      688         .
      689       end.
      690       else do:
      691         define variable vRindex1 as integer no-undo.
      692         define variable vRindex2 as integer no-undo.
      693         vRindex1 = r-index(p-message," ",70).
      694         if vRindex1 = 0
      695         then
      696            vRindex1 = 70.
      697         if length(p-message)  <= vRindex1 + 70 then do:
      698           assign
      699             v-waitfram-action01 = " "
      700             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      701             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      702           .
      703         end.
      704         else do:
      705           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      706           if vRindex2 <= vRindex1
      707           then
      708              vRindex2 = vRindex1 + 70.
      709           assign
      710             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      711             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      712             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      713           .
      714         end.
      715       end.
      716       B-viewProcInfo:visible   in frame waitfram = no.
      717       B-viewProcInfo:sensitive in frame waitfram = no.
      718       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      719       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      720       if  (   mWaitFramView
      721          or  mWaitProcEvent)
      722          and not mBatchMode
      723       then
      724          display
      725             v-waitfram-action01 skip
      726             v-waitfram-action02 skip
      727             v-waitfram-action03 skip
      728          with frame waitfram .
      729       if     mWaitFramView
      730          then do:
      731             if     mWaitFramInterval ne ?
      732                and not mBatchMode
      733             then
      734                wait-for go of frame waitfram pause mWaitFramInterval.
      735          end.
      736          else
      737             if     mWaitProcEvent
      738                and not mBatchMode
      739             then
      740                process events .
      741     end.
      742   end procedure.
      743      procedure waitfram-show-this:
      744         define input  parameter iInterval as int64 no-undo.
      745         define variable vtime as int64 no-undo.
      746         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      747         mWaitFramInterval = iInterval.
      748         run waitfram-show (substitute("&1&2 &3&4" ,
      749                                       mWaitFramTextBeg ,
      750                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      751                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      752                                       mWaitFramTextEnd
      753                                      )
      754                           ).
      755      end.
      756      procedure WaitFramRunPause:
      757         define input  parameter iInterval as dec no-undo.
      758         define variable vStart  as datetime-tz no-undo.
      759         define variable vend    as datetime-tz no-undo.
      760         define variable vint as int64 no-undo.
      761         define variable vOk as logical no-undo.
      762         vStart = now.
      763         vend   = vStart.
      764         publish "WaitFramPause" (iInterval,output vOk).
      765         vend   =  now.
      766         vint = vend - vStart.
      767         vint = iInterval - vint / 1000.
      768         if     not mWaitFramStop
      769            and (   vint > 0
      770                 or (    not vOk
      771                     and iInterval eq ?
      772                     )
      773                 )
      774         then
      775            run waitfram-show-this (iInterval).
      776         vend   =  now.
      777         vint = vend - vStart.
      778         vint = iInterval - vint / 1000.
      779         if     not mWaitFramStop
      780            and vint > 0
      781         then do:
      782            run gbl/pause.p (vint * 1000).
      783         end.
      784         if iInterval ne ?
      785         then
      786            publish "WaitFramStop".
      787         waitfram-check-timeout().
      788      end.
      789      procedure WaitFramWaitFor:
      790         define input  parameter iInterval as dec no-undo.
      791         assign
      792            mWaitFramStartProc   = now
      793            mWaitFramStopUser    = no
      794            mWaitFramStopTimeOut = no
      795         .
      796         block-wait:
      797         do while not mWaitFramStop:
      798            run WaitFramRunPause (iInterval).
      799            if  waitfram-check-timeout()
      800            then do:
      801               leave block-wait.
      802            end.
      803         end.
      804         run waitfram-hide.
      805      end.
      806   procedure waitfram-join :
      807     define input  parameter p-line-1  as character no-undo .
      808     define input  parameter p-line-2  as character no-undo .
      809     define input  parameter p-line-3  as character no-undo .
      810     define output parameter p-message as character no-undo .
      811     do
      812     on error undo, return error return-value
      813     :
      814       assign
      815         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      816                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      817                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      818       .
      819     end.
      820   end procedure.
      821   function waitfram-join-function returns character
      822     (input p-line-1 as character
      823     ,input p-line-2 as character
      824     ,input p-line-3 as character
      825     ).
      826     define variable v-message as character no-undo .
      827     run waitfram-join in this-procedure
      828       (input  p-line-1
      829       ,input  p-line-2
      830       ,input  p-line-3
      831       ,output v-message
      832       ) .
      833     return v-message .
      834   end function .
