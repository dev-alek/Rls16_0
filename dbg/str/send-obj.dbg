     1454   procedure alienini-getkey :
     1455   define input parameter i-filename as char.
     1456   define input parameter i-section as char.
     1457   define input parameter i-key as char.
     1458   define output parameter o-value as char.
     1459   define variable EntryPointer as integer no-undo.
     1460   define variable mem1 as memptr no-undo.
     1461   define variable mem2 as memptr no-undo.
     1462   define variable mem1size as integer no-undo.
     1463   define variable mem2size as integer no-undo.
     1464   define variable ii       as integer    no-undo.
     1465   define variable cbReturnSize  as integer    no-undo.
     1466   assign
     1467   set-size(mem1)  = 4000
     1468   mem1size = 4000.
     1469   if i-key = "" then EntryPointer = 0.
     1470   else do:
     1471     assign
     1472     set-size(mem2) = 128
     1473     mem2size = 128
     1474     EntryPointer = get-pointer-value(mem2)
     1475     put-string(mem2, 1) = i-key.
     1476   end.
     1477   run getprivateprofilestringA
     1478                                 (i-section,
     1479                                  EntryPointer,
     1480                                  "",
     1481                                  get-pointer-value(mem1),
     1482                                  input mem1size,
     1483                                  i-filename,
     1484                                  output cbReturnSize).
     1485   do ii = 1 to cbReturnSize:
     1486     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1487                  then o-value + ","
     1488                  else o-value + chr(get-byte(mem1, ii)).
     1489   end.
     1490     set-size(mem1) = 0.
     1491     set-size(mem2) = 0.
     1492   end procedure.
     1493   procedure alienini-putkey :
     1494   define input parameter i-filename as char.
     1495   define input parameter i-section as char.
     1496   define input parameter i-key as char.
     1497   define input parameter i-value as char.
     1498   define variable cbReturnSize as integer.
     1499   run writeprivateprofilestringA
     1500                                  (i-section,
     1501                                   i-key,
     1502                                   i-value,
     1503                                   i-filename,
     1504                                   output cbReturnSize ).
     1505   end procedure.
     1506   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1507     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1508     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1509     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1510     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1511     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1512     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1513     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1514   END PROCEDURE.
     1515   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1516     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1517     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1518     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1519     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1520     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1521   END PROCEDURE.
