     1581   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1582   define variable v-is-closed-shift-journal as integer no-undo .
     1583   assign
     1584   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1585                               +
     1586                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1587                               +
     1588                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1589   .
     1590   return v-is-closed-shift-journal.
     1591   END FUNCTION.
     1592   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1593   define variable v-is-first-journal as logical no-undo .
     1594   assign
     1595   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1596                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1597                     or (p-journal-num =  integer(entry(1, '17':U)))
     1598                     or (p-journal-num = integer(entry(1, '16':U)))
     1599   .
     1600   return v-is-first-journal.
     1601   END FUNCTION.
     1602   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1603   define variable v-is-petrol-journal as logical no-undo .
     1604   assign
     1605   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1606   return v-is-petrol-journal.
     1607   END FUNCTION.
     1608   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1609   define variable v-max-record-num as integer no-undo .
     1610   assign
     1611   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1612                       then 1489
     1613                       else 2340).
     1614   return v-max-record-num.
     1615   END FUNCTION.
     1616   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1617   define variable v-max-record-num as integer no-undo .
     1618   assign
     1619   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1620                       then 1489 * num-entries('30,31,32,33':U)
     1621                       else 2340 * num-entries('17':U)).
     1622   return v-max-record-num.
     1623   END FUNCTION.
     1624   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1625                                           ,input p-rec-no as integer):
     1626   define variable v-num-recs as integer no-undo .
     1627   if tekka-is-petrol-journal (p-journal-num) then do:
     1628     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1629       assign
     1630       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1631       .
     1632     end.
     1633     else do:
     1634       assign
     1635       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1636       .
     1637     end.
     1638   end.
     1639   else do:
     1640     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1641       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1642         assign
     1643         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1644         .
     1645       end.
     1646       else do:
     1647         assign
     1648         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1649         .
     1650       end.
     1651     end.
     1652     else do:
     1653       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1654         assign
     1655         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1656         .
     1657       end.
     1658       else do:
     1659         assign
     1660         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1661         .
     1662       end.
     1663     end.
     1664   end.
     1665   return v-num-recs.
     1666   END FUNCTION.
     1667   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1668                                              ,input p-is-petrol as logical
     1669                                              ,input p-is-current as logical
     1670                                              ,output p-rec-no as decimal
     1671                                              ):
     1672   define variable v-obj-num0 as integer no-undo .
     1673   define variable v-obj-num as integer no-undo .
     1674   define variable v-obj-num2 as integer no-undo .
     1675   define variable p-num-recs2 as integer no-undo .
     1676   define variable p-rec-no2 as integer no-undo .
     1677   if p-is-petrol then do:
     1678     assign
     1679     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1680     .
     1681     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1682     then
     1683     assign
     1684     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1685     p-rec-no = p-num-recs modulo 1489
     1686     .
     1687     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1688     then
     1689     assign
     1690     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1691     p-rec-no = p-num-recs modulo 1489
     1692     .
     1693   end.
     1694   else do:
     1695     assign
     1696     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1697     p-num-recs = trunc(p-num-recs, 0)
     1698     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1699     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1700     .
     1701     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1702     then
     1703     assign
     1704     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1705     p-rec-no = p-num-recs modulo 2340
     1706     .
     1707     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1708     then
     1709     assign
     1710     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1711     p-rec-no = p-num-recs modulo 2340
     1712     .
     1713     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1714     then
     1715     assign
     1716     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1717     p-rec-no2 = p-num-recs2 modulo 2978
     1718     .
     1719     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1720     then
     1721     assign
     1722     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1723     p-rec-no2 = p-num-recs2 modulo 2978
     1724     .
     1725     assign
     1726     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1727     .
     1728   end.
     1729   if v-obj-num = 0 then v-obj-num = 100.
     1730   return v-obj-num.
     1731   END FUNCTION.
     1732   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1733   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1734   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1735      if p-is-ptrl then
     1736      return integer(entry(1, '26,27,28,29':U)).
     1737      if not p-is-ptrl then
     1738      return integer(entry(1, '16':U)).
     1739   end.
     1740   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1741   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1742   return 0.
     1743   END FUNCTION.
     1744   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1745   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1746   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1747     if p-is-ptrl then
     1748     return integer(entry(1, '26,27,28,29':U)).
     1749     if not p-is-ptrl then
     1750     return integer(entry(1, '16':U)).
     1751   end.
     1752   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1753   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1754   return 0.
     1755   END FUNCTION.
     1756   PROCEDURE maria-put:
     1757   define parameter buffer buf_cash-desk for ub.cash-desk.
     1758   define input parameter p-out    as character no-undo .
     1759   define input parameter p-fname as character no-undo .
     1760   define input parameter p-by-record as logical no-undo .
     1761   define input parameter p-shift-fields as integer no-undo .
     1762   define input parameter p-binary as logical no-undo .
     1763   define input parameter p-obj-num as integer no-undo .
     1764   define input parameter p-max-records as integer no-undo .
     1765   define input parameter p-plu as integer no-undo .
     1766   define input parameter p-value as character no-undo .
     1767   define variable v-file-name as character no-undo .
     1768   define variable v-create as logical no-undo .
     1769   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1770   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1771   output stream IBMSTREAM
     1772   to value(v-file-name) append .
     1773   Put  stream IBMSTREAM unformatted
     1774   p-plu
     1775   chr(3)
     1776   p-value
     1777   skip.
     1778   output stream IBMSTREAM
     1779   close.
     1780   if not p-by-record then do:
     1781     find first buf_temp-tekka-tsk where
     1782               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1783     if not available buf_temp-tekka-tsk then do:
     1784       v-create = yes.
     1785     end.
     1786   end.
     1787   else do:
     1788     find first buf_temp-tekka-tsk where
     1789               buf_temp-tekka-tsk.filename  = v-file-name
     1790           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1791     if not available buf_temp-tekka-tsk
     1792     then do:
     1793       find first buf_temp-tekka-tsk where
     1794                 buf_temp-tekka-tsk.filename  = v-file-name
     1795             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1796       if not available buf_temp-tekka-tsk
     1797       then do:
     1798         v-create = yes.
     1799       end.
     1800     end.
     1801   end.
     1802   if v-create then do:
     1803     create buf_temp-tekka-tsk.
     1804     assign
     1805     buf_temp-tekka-tsk.filename = v-file-name
     1806     buf_temp-tekka-tsk.range    = p-plu
     1807     buf_temp-tekka-tsk.obj-num = p-obj-num
     1808     buf_temp-tekka-tsk.obj-name = '':U
     1809     buf_temp-tekka-tsk.num-records = 0
     1810     buf_temp-tekka-tsk.max-records = p-max-records
     1811     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1812     buf_temp-tekka-tsk.task-num = p-fname
     1813     buf_temp-tekka-tsk.by-record = p-by-record
     1814     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1815     buf_temp-tekka-tsk.binary = p-binary
     1816     buf_temp-tekka-tsk.send-get = 'send'
     1817     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1818     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1819     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1820     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1821                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1822                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1823                                 then 'local'
     1824                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1825     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1826     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1827     buf_temp-tekka-tsk.waiting-sek = 30
     1828     buf_temp-tekka-tsk.min-plu     = p-plu
     1829     buf_temp-tekka-tsk.max-plu     = p-plu
     1830     .
     1831   end.
     1832   assign
     1833   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1834   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1835   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1836   .
     1837   END PROCEDURE.
     1838   PROCEDURE maria-get:
     1839   define parameter buffer buf_cash-desk for ub.cash-desk.
     1840   define input parameter p-out    as character no-undo .
     1841   define input parameter p-fname as character no-undo .
     1842   define input parameter p-by-record as logical no-undo .
     1843   define input parameter p-obj-num as integer no-undo .
     1844   define input parameter p-num-fields as integer no-undo .
     1845   define input parameter p-max-records as integer no-undo .
     1846   define input parameter p-min-plu as integer no-undo .
     1847   define input parameter p-max-plu as integer no-undo .
     1848   define input parameter p-other as character no-undo .
     1849   define input parameter p-order-num as integer no-undo .
     1850   define variable v-file-name as character no-undo .
     1851   define variable v-secondary-obj-num as character no-undo .
     1852   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1853   if p-by-record then do:
     1854     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1855   end.
     1856   else do:
     1857     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1858   end.
     1859   find first buf_temp-tekka-tsk where
     1860             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1861   if not available buf_temp-tekka-tsk then do:
     1862     create buf_temp-tekka-tsk.
     1863     assign
     1864     buf_temp-tekka-tsk.filename = v-file-name
     1865     buf_temp-tekka-tsk.obj-num = p-obj-num
     1866     buf_temp-tekka-tsk.obj-name = '':U
     1867     buf_temp-tekka-tsk.max-records = p-max-records
     1868     buf_temp-tekka-tsk.num-fields = p-num-fields
     1869     buf_temp-tekka-tsk.task-num = p-fname
     1870     buf_temp-tekka-tsk.by-record = p-by-record
     1871     buf_temp-tekka-tsk.send-get = 'get'
     1872     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1873     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1874     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1875     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1876                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1877                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1878                                   then 'local'
     1879                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1880     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1881     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1882     buf_temp-tekka-tsk.waiting-sek = 30
     1883     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1884     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1885     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1886                                       and p-max-plu <> ?
     1887                                       then p-max-plu - p-min-plu + 1
     1888                                       else 0)
     1889     buf_temp-tekka-tsk.other-info = p-other
     1890     buf_temp-tekka-tsk.order-num = p-order-num
     1891     .
     1892     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1893       assign
     1894       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1895       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1896       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1897       no-error
     1898       .
     1899       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1900     end.
     1901   end.
     1902   END PROCEDURE.
     1903   PROCEDURE maria-task:
     1904   define parameter buffer buf_cash-desk for ub.cash-desk.
     1905   define input parameter p-fname as character no-undo .
     1906   define input parameter p-obj-num-list as character no-undo .
     1907   define input parameter p-parameters as character no-undo .
     1908   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1909   find first buf_temp-tekka-tsk where
     1910             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1911   if not available buf_temp-tekka-tsk then do:
     1912     create buf_temp-tekka-tsk.
     1913     assign
     1914     buf_temp-tekka-tsk.filename = ''
     1915     buf_temp-tekka-tsk.range = 1
     1916     buf_temp-tekka-tsk.obj-num = 0
     1917     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1918     buf_temp-tekka-tsk.task-num = p-fname
     1919     buf_temp-tekka-tsk.by-record = no
     1920     buf_temp-tekka-tsk.send-get = 'task'
     1921     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1922     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1923     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1924     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1925                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1926                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1927                                   then 'local'
     1928                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1929     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1930     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1931     buf_temp-tekka-tsk.waiting-sek = 30
     1932     buf_temp-tekka-tsk.other-info = p-parameters
     1933     buf_temp-tekka-tsk.order-num = 0
     1934     .
     1935   end.
     1936   END PROCEDURE.
     1937   procedure tekkatsk-verify-schema :
     1938   define input parameter p-obj-list as character no-undo .
     1939   define input parameter p-dir-path as character no-undo .
     1940   define variable v-obj-num as integer no-undo .
     1941   define variable v-obj-name as character no-undo .
     1942   define variable v-num-records as integer no-undo .
     1943   define variable v-size_ as integer no-undo .
     1944   define variable v-value as character no-undo .
     1945   define variable ii as integer no-undo .
     1946   define variable jj as integer no-undo .
     1947   define variable ii-ibs as integer no-undo .
     1948   define variable ii-tekka as integer no-undo .
     1949   define variable v-result as character no-undo .
     1950   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1951   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1952     do
     1953     on error undo, return error
     1954     :
     1955        for each buf_temp-tekka-schema:
     1956          delete buf_temp-tekka-schema.
     1957        end.
     1958        input from value('tekkasch.d').
     1959        repeat :
     1960          create buf_temp-tekka-schema.
     1961          import buf_temp-tekka-schema.
     1962          assign
     1963          buf_temp-tekka-schema.host = 'IBS'
     1964          ii = ii + 1.
     1965          .
     1966        end.
     1967        input close.
     1968        ii-ibs = ii.
     1969         _ii:
     1970         do ii = 1 to 256:
     1971           if p-obj-list = "ALL"
     1972           or lookup(string(ii), p-obj-list) > 0 then do:
     1973             assign
     1974             v-obj-num = 0
     1975             v-obj-name = ''
     1976             v-num-records = 0
     1977             v-size_ = 0
     1978             .
     1979             run alienini-getkey in this-procedure (
     1980                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1981                                                     ,input ('obj' + string(ii, '999'))
     1982                                                     ,input 'oname'
     1983                                                     ,output v-value) no-error .
     1984             if v-value = ? then next _ii.
     1985             assign
     1986             v-obj-num = ii
     1987             v-obj-name = v-value
     1988             .
     1989             run alienini-getkey in this-procedure (
     1990                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1991                                                     ,input ('obj' + string(ii, '999'))
     1992                                                     ,input 'size'
     1993                                                     ,output v-value) no-error .
     1994             assign
     1995             v-num-records = integer(v-value) no-error  .
     1996             if error-status:error
     1997             or v-num-records = 0 then next _ii.
     1998             run alienini-getkey in this-procedure (
     1999                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2000                                                     ,input 'obj' + string(ii, '999')
     2001                                                     ,input 'f000'
     2002                                                     ,output v-value) no-error .
     2003             assign
     2004             v-size_ = integer(v-value) no-error  .
     2005             if error-status:error
     2006             or v-size_ = 0 then next _ii.
     2007             _jj:
     2008             do jj = 1 to 256:
     2009               run alienini-getkey in this-procedure (
     2010                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2011                                                       ,input 'obj' + string(ii, '999')
     2012                                                       ,input 'f' + string(jj, '999')
     2013                                                       ,output v-value) no-error .
     2014               if v-value = ? then next _ii.
     2015               create buf_temp-tekka-schema.
     2016               assign
     2017               buf_temp-tekka-schema.host = 'tekka'
     2018               buf_temp-tekka-schema.obj-num = v-obj-num
     2019               buf_temp-tekka-schema.obj-name = v-obj-name
     2020               buf_temp-tekka-schema.num-records = v-num-records
     2021               buf_temp-tekka-schema.size_ = v-size_
     2022               buf_temp-tekka-schema.field-num = jj
     2023               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2024               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2025                                                  then entry(2, entry(2, v-value, '#'), ':')
     2026                                                  else '':U)
     2027               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2028               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2029               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2030                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2031               no-error
     2032               .
     2033               if error-status:error then do:
     2034                 delete buf_temp-tekka-schema.
     2035                 next _jj.
     2036               end.
     2037               run alienini-getkey in this-procedure (
     2038                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2039                                                       ,input 'obj' + string(ii, '999') + 'name'
     2040                                                       ,input 'n' + string(jj, '999')
     2041                                                       ,output v-value) no-error .
     2042               if v-value <> ? then
     2043               buf_temp-tekka-schema.field-name = v-value.
     2044             end.
     2045           end.
     2046         end.
     2047         ii-tekka = ii - 1.
     2048        if p-obj-list <> 'ALL' then do:
     2049         if ii-tekka <> ii-ibs then do:
     2050           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2051                                   , ii-ibs
     2052                                   , ii-tekka).
     2053         end.
     2054        end.
     2055        for each buf_temp-tekka-schema where
     2056               buf_temp-tekka-schema.host = 'tekka':
     2057          find first buf2_temp-tekka-schema where
     2058                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2059                AND buf2_temp-tekka-schema.host = 'ibs'
     2060                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2061          if not available buf2_temp-tekka-schema then do:
     2062           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2063                                   , buf_temp-tekka-schema.field-num
     2064                                   , buf_temp-tekka-schema.obj-num).
     2065          end.
     2066          buffer-compare buf_temp-tekka-schema
     2067          to buf2_temp-tekka-schema
     2068          save result in v-result.
     2069          if v-result <> '':U then do:
     2070           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2071                                   , buf_temp-tekka-schema.field-num
     2072                                   , buf_temp-tekka-schema.obj-num).
     2073          end.
     2074        end.
     2075     end.
     2076   end procedure.
     2077   FUNCTION set-Sx returns character (input p-string as character):
     2078   return p-string.
     2079   END FUNCTION.
     2080   FUNCTION get-Sx returns character (input p-string  as character):
     2081   return p-string.
     2082   END FUNCTION.
     2083   FUNCTION set-B returns character (input p-string  as character):
     2084   return chr(integer(p-string)).
     2085   END FUNCTION.
     2086   FUNCTION get-B returns character (input p-string  as character):
     2087   return string(asc(p-string)).
     2088   END FUNCTION.
     2089   FUNCTION set-BF returns character (input p-string  as character):
     2090   define variable v-dopi as integer no-undo .
     2091   define variable ii as integer no-undo .
     2092   do ii = 1 to 8:
     2093     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2094   end.
     2095   return chr(v-dopi).
     2096   END FUNCTION.
     2097   FUNCTION get-BF returns character (input p-string  as character):
     2098   define variable v-dopi as integer no-undo .
     2099   define variable v-dops as character no-undo .
     2100   define variable ii as integer no-undo .
     2101   v-dopi = asc(p-string).
     2102   do ii = 8 to 1 BY -1:
     2103     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2104   end.
     2105   return v-dops.
     2106   END FUNCTION.
     2107   FUNCTION set-BN returns character (input p-string  as character
     2108                                     ,input p-bin-group as character):
     2109   define variable v-dopi as integer no-undo .
     2110   define variable ii as integer no-undo .
     2111   define variable jj as integer no-undo .
     2112   define variable v-grp-nums as integer no-undo .
     2113   define variable v-dopi2 as integer no-undo .
     2114   v-grp-nums = num-entries(p-bin-group).
     2115   do jj = 0 to v-grp-nums - 1:
     2116     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2117     do ii = 1 to 8:
     2118       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2119     end.
     2120   end.
     2121   return chr(v-dopi).
     2122   END FUNCTION.
     2123   FUNCTION get-BN returns character (input p-string  as character
     2124                                     ,input p-bin-group as character):
     2125   define variable v-dopi as integer no-undo .
     2126   define variable v-dops as character no-undo .
     2127   define variable v-grp-nums as integer no-undo .
     2128   define variable ii as integer no-undo .
     2129   define variable jj as integer no-undo .
     2130   v-dopi = asc(p-string).
     2131   v-grp-nums = num-entries(p-bin-group).
     2132   do jj = 1 to v-grp-nums:
     2133   do ii = 8 to 1 BY -1:
     2134     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2135   end.
     2136   end.
     2137   return v-dops.
     2138   END FUNCTION.
     2139   procedure fill-temp-cd :
     2140   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2141   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2142   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2143   define input parameter p-clear-table as logical no-undo .
     2144   define buffer buf_temp-cd for temp-cd.
     2145   define buffer buf_cash-desk for ub.cash-desk.
     2146     do
     2147     on error undo, return error
     2148     :
     2149        if p-clear-table  then do:
     2150          for each buf_temp-cd:
     2151            delete buf_temp-cd.
     2152          end.
     2153        end.
     2154        for each buf_cash-desk no-lock where
     2155               buf_cash-desk.db-num = p-db-num
     2156           AND buf_cash-desk.obj-code = p-obj-code
     2157           and buf_cash-desk.cash-on  = yes
     2158        BREAK by buf_cash-desk.pos-type:
     2159          if first-of(buf_cash-desk.pos-type) then do:
     2160            create buf_temp-cd.
     2161            buffer-copy buf_cash-desk to buf_temp-cd.
     2162          end.
     2163        end.
     2164     end.
     2165   end procedure.
     2166   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2167   PROCEDURE putc-dept.
     2168   define input parameter pos-type as char no-undo.
     2169   define variable ii as integer no-undo .
     2170   CASE pos-type:
     2171     when 'IBM-XML':U then do:
     2172        for each cash-obj no-lock
     2173        break
     2174        by cash-obj.km-objtype
     2175        by cash-obj.km-objcode
     2176        by cash-obj.km-objname
     2177        :
     2178         if first-of(cash-obj.km-objname) then do:
     2179           run bgelib-tag-open in this-procedure ( input 2, input "Object"
     2180                                                 , input substitute("ctrl='&1' tms='&2'"
     2181                                                                   , (if action = "U"
     2182                                                                       then "ADD":U
     2183                                                                       else "DEL":U)
     2184                                                                     ,OS2-time
     2185                                                                   )).
     2186           run bgelib-tag-put in this-procedure ( input 3, input "ObjName"
     2187                                               , input cash-obj.km-objname, input 1 ).
     2188           run bgelib-tag-put in this-procedure ( input 3, input "ObjType":U
     2189                                               , input string(cash-obj.km-objtype), input 1 ).
     2190           run bgelib-tag-put in this-procedure ( input 3, input "ObjOnAddr":U
     2191                                               , input cash-obj.on-addr, input 1 ).
     2192           run bgelib-tag-put in this-procedure ( input 3, input "ObjOffAddr":U
     2193                                               , input cash-obj.off-addr, input 1 ).
     2194           do ii = 1 to num-entries (cash-obj.shop-nums):
     2195             run bgelib-tag-open in this-procedure ( input 3, input "ObjShop":U
     2196                                                 , input "":U).
     2197             run bgelib-tag-put in this-procedure ( input 4, input "OSNum":U
     2198                                                 , input entry(ii, cash-obj.shop-nums), input 1 ).
     2199             run bgelib-tag-close in this-procedure ( input 3, input "ObjShop").
     2200           end.
     2201           if cash-obj.km-objtype = 1 then do:
     2202             run bgelib-tag-open in this-procedure ( input 3, input "ObjParam":U
     2203                                                   , input "":U).
     2204             run bgelib-tag-put in this-procedure ( input 4, input "OPName":U
     2205                                                   , input "firm-name", input 1 ).
     2206             run bgelib-tag-put in this-procedure ( input 4, input "OPValue":U
     2207                                                   , input cash-obj.firm-name, input 1 ).
     2208             run bgelib-tag-close in this-procedure ( input 3, input "ObjParam").
     2209             run bgelib-tag-open in this-procedure ( input 3, input "ObjParam":U
     2210                                                   , input "":U).
     2211             run bgelib-tag-put in this-procedure ( input 4, input "OPName":U
     2212                                                   , input "jur-address", input 1 ).
     2213             run bgelib-tag-put in this-procedure ( input 4, input "OPValue":U
     2214                                                   , input cash-obj.jur-address, input 1 ).
     2215             run bgelib-tag-close in this-procedure ( input 3, input "ObjParam").
     2216             run bgelib-tag-open in this-procedure ( input 3, input "ObjParam":U
     2217                                                   , input "":U).
     2218             run bgelib-tag-put in this-procedure ( input 4, input "OPName":U
     2219                                                   , input "post-address", input 1 ).
     2220             run bgelib-tag-put in this-procedure ( input 4, input "OPValue":U
     2221                                                   , input cash-obj.post-address, input 1 ).
     2222             run bgelib-tag-close in this-procedure ( input 3, input "ObjParam").
     2223             run bgelib-tag-open in this-procedure ( input 3, input "ObjParam":U
     2224                                                   , input "":U).
     2225             run bgelib-tag-put in this-procedure ( input 4, input "OPName":U
     2226                                                   , input "INN", input 1 ).
     2227             run bgelib-tag-put in this-procedure ( input 4, input "OPValue":U
     2228                                                   , input cash-obj.INN, input 1 ).
     2229             run bgelib-tag-close in this-procedure ( input 3, input "ObjParam").
     2230             run bgelib-tag-open in this-procedure ( input 3, input "ObjParam":U
     2231                                                   , input "":U).
     2232             run bgelib-tag-put in this-procedure ( input 4, input "OPName":U
     2233                                                   , input "KPP", input 1 ).
     2234             run bgelib-tag-put in this-procedure ( input 4, input "OPValue":U
     2235                                                   , input cash-obj.KPP, input 1 ).
     2236             run bgelib-tag-close in this-procedure ( input 3, input "ObjParam").
     2237           end.
     2238           run bgelib-tag-put in this-procedure ( input 3, input "ObjLock":U
     2239                                                 , input string(cash-obj.obj-lock), input 1 ).
     2240           run bgelib-tag-close in this-procedure ( input 2, input "Object").
     2241          end.
     2242        end.
     2243     end.
     2244   END CASE .
     2245   END PROCEDURE .
     2246   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2247   PROCEDURE   for-cash-cycle:
     2248   define buffer for-cash-desk for ub.cash-desk.
     2249   define variable v-first  as logical no-undo .
     2250     FOR EACH for-cash-desk NO-LOCK WHERE
     2251             for-cash-desk.db-num = g#db-num AND
     2252             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2253             for-cash-desk.cash-on  = yes
     2254       BREAK
     2255       BY for-cash-desk.db-num
     2256       BY for-cash-desk.pos-type
     2257       BY for-cash-desk.cash-on
     2258       :
     2259       if ub.cash-desk.pos-type <> 'IBM-XML':U or
     2260       for-cash-desk.autonomy <> integer('2':U)
     2261       or v-first
     2262       then NEXT.
     2263       assign
     2264       v-first = yes
     2265       .
     2266       run write-log-and-file in p-log-handle (
     2267             input 1
     2268           , input log-file-name
     2269           , input 1
     2270           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2271                                                         ).
     2272   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2273   case for-cash-desk.pos-type:
     2274       when 'IBM-XML':U or when 'Autotank':U
     2275     then do:
     2276   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2277   run xml-cd-filename in this-procedure (
     2278         input out
     2279       , output v-xml-file-name
     2280       , output v-xml-file-name-path
     2281       , output v-log-file-name
     2282       , output v-locked
     2283   ).
     2284   run write-log-and-file in p-log-handle (
     2285         input 1
     2286       , input log-file-name
     2287       , input 1
     2288       , input substitute( ("'Пересылка данных по объектам БД'" + " &1")
     2289                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2290                         )
     2291                                         ).
     2292   run write-log-and-file in p-log-handle (
     2293         input 1
     2294       , input log-file-name
     2295       , input 1
     2296       , input substitute( "................с параметрами: ... БД: &1", g#db-num )
     2297                                         ).
     2298   assign
     2299   v-obj-list = "БД" + string(g#db-num)
     2300   .
     2301   run xml-cd-write-header in this-procedure (
     2302         input v-xml-file-name
     2303       , input v-xml-file-name-path
     2304       , input (if for-cash-desk.pos-type = 'IBM-XML':U
     2305                then "setup"
     2306                else "data")
     2307       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2308       , input v-obj-list
     2309       , input (
     2310                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2311                   then (if for-cash-desk.autonomy = integer('0':U)
     2312                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2313                         else ("КМ"    )
     2314                         )
     2315                   else ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2316                   )
     2317               )
     2318       , input yes
     2319   ).
     2320   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2321   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2322     end.
     2323   END CASE.
     2324       RUN putc-dept( for-cash-desk.pos-type ).
     2325   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2326   case for-cash-desk.pos-type:
     2327       when 'IBM-XML':U or when 'Autotank':U
     2328     then do:
     2329   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2330   output stream stmxmlout close.
     2331   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2332       , input (if for-cash-desk.pos-type = 'IBM-XML':U
     2333                then "setup"
     2334                else "data")
     2335   ).
     2336   run write-log-and-file in p-log-handle (
     2337         input 1
     2338       , input log-file-name
     2339       , input 1
     2340       , input substitute( "Данные выгружены в файл &1"
     2341                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2342                         )
     2343                                          ).
     2344   if (
     2345   not (g#news or g#auto or g#esys )
     2346   or
     2347   (
     2348   for-cash-desk.pos-type = 'MAGIA-XML':U
     2349   or
     2350     (for-cash-desk.pos-type = 'IBM-XML':U
     2351   or (for-cash-desk.pos-type = 'Autotank':U
     2352     and
     2353     for-cash-desk.autonomy = integer('2':U))
     2354     )))
     2355   then do:
     2356     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2357     end.
     2358     if (for-cash-desk.pos-type = 'IBM-XML':U
     2359     and for-cash-desk.autonomy = integer('0':U))
     2360     or (for-cash-desk.pos-type = 'Autotank':U
     2361     and for-cash-desk.autonomy = integer('2':U))
     2362     then do:
     2363       run str/post-xml.p
     2364         (
     2365          input parparentproc
     2366         ,input p-parent-handle
     2367         ,input p-log-handle
     2368         ,input g#news or g#esys
     2369         ,input g#auto
     2370         ,input 'send'
     2371         ,input log-file-name
     2372         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2373         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2374         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2375         ,input 30
     2376         ,input   ( if action = 'U'
     2377                     then ('Ждите - ' + 'добавление данных по объектам БД')
     2378                     else ('Ждите - ' + 'удаление данных по объектам БД') ) +
     2379                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2380         ) no-error .
     2381       if error-status:error
     2382       or return-value = "error" then do:
     2383         run write-log-and-file in p-log-handle (
     2384               input 1
     2385             , input log-file-name
     2386             , input 1
     2387             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2388                                   ,for-cash-desk.obj-code
     2389                                   ,for-cash-desk.cash-num
     2390                                   , chr(10)
     2391                                   , error-status:get-message(1)
     2392                                   , return-value
     2393                               )
     2394                                               ).
     2395         assign
     2396         v-view-log = yes
     2397         .
     2398       end.
     2399     end.
     2400     if not available ub.shop then do:
     2401       find first ub.shop no-lock where
     2402                 ub.shop.obj-code = for-cash-desk.obj-code.
     2403     end.
     2404     if
     2405     not (g#news or g#esys)
     2406     then do:
     2407       run str/getxibmf.p (
     2408                       input parparentproc
     2409                     ,input p-log-handle
     2410                     ,input 'маг':U
     2411                     ,input for-cash-desk.obj-code
     2412                     ,input ub.shop.host-code
     2413                     ,input in_
     2414                     ,input spl
     2415                     ,input (in_ + sav)
     2416                     ,input for-cash-desk.pos-type
     2417                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2418                             and for-cash-desk.autonomy = integer('0':U))
     2419                             or (for-cash-desk.pos-type = 'Autotank':U
     2420                             and for-cash-desk.autonomy = integer('2':U))
     2421                             then "utf-8":U
     2422                             else "windows-1251")
     2423                     ,input log-file-name
     2424                     ,input "data":U
     2425                     ,input v-xml-file-name
     2426                     ,input-output v-view-log
     2427                     ) no-error .
     2428       if error-status:error then do:
     2429         run write-log-and-file in p-log-handle (
     2430               input 1
     2431             , input log-file-name
     2432             , input 1
     2433             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2434                                   ,for-cash-desk.obj-code
     2435                                   ,for-cash-desk.cash-num
     2436                               )
     2437                                               ).
     2438         assign
     2439         v-view-log = yes
     2440         .
     2441       end.
     2442     end.
     2443   end.
     2444   if g#news
     2445   or g#auto
     2446   or g#esys
     2447   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2448   then do:
     2449   end.
     2450     end.
     2451   END CASE.
     2452     END .
     2453   END PROCEDURE.
     2454   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   PROCEDURE SENDING:
     2456   DEFINE VARIABLE fq as integer no-undo .
     2457   FOR EACH ub.cash-desk NO-LOCK WHERE
     2458           ub.cash-desk.db-num = g#db-num AND
     2459           ub.cash-desk.cash-on = yes
     2460   BREAK
     2461   By ub.cash-desk.db-num
     2462   By ub.cash-desk.pos-type
     2463   By ub.cash-desk.autonomy:
     2464     if ub.cash-desk.pos-type <> 'IBM-XML':U then NEXT.
     2465     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2466   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2467   define variable dflt-cd16 as character no-undo .
     2468   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2469   define variable v-param-type17 as character no-undo .
     2470   define variable v-value-date17 as date no-undo .
     2471   define variable v-value-decimal17 as decimal no-undo .
     2472   define variable v-value-integer17 as INTEGER no-undo .
     2473   define variable v-value-logical17 AS LOGICAL no-undo .
     2474   define variable v-tth17 as handle no-undo .
     2475   run adm/shattri.p (
     2476       input "get":U
     2477       ,input  'маг':U
     2478       ,input  ub.cash-desk.obj-code
     2479       ,input  'cd-sending':U
     2480       ,input  'dflt-cd':U
     2481       ,output dflt-cd16
     2482       ,output v-value-date17
     2483       ,output v-value-decimal17
     2484       ,output v-value-integer17
     2485       ,output v-value-logical17
     2486       ,output v-param-type17
     2487       ,INPUT-OUTPUT table-handle v-tth17
     2488       ) no-error .
     2489   delete object v-tth17 no-error.
     2490   case ub.cash-desk.pos-type:
     2491       when 'IBM-XML':U or when 'Autotank':U
     2492     then do:
     2493   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   run str/get-inis.p (
     2495                   input 'маг':U
     2496                 , input ub.cash-desk.obj-code
     2497                 , input ub.cash-desk.pos-type
     2498                 , input cash-desk.remote
     2499                 , input "send":U
     2500                 , output out
     2501                 , output out2
     2502                 , output in_
     2503                 , output spl
     2504                 , output sav
     2505                 , output v-remote
     2506                 )  no-error .
     2507   if error-status:error then do:
     2508     run write-log-and-file in p-log-handle (
     2509           input 1
     2510         , input log-file-name
     2511         , input 1
     2512         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2513                             , ub.cash-desk.pos-type
     2514                             , ub.cash-desk.obj-code
     2515                             , chr(10)
     2516                             , error-status:get-message(1)
     2517                             , return-value )).
     2518     assign
     2519     v-view-log = yes.
     2520     return error.
     2521   end.
     2522   if ub.cash-desk.pos-type = 'IBM-XML':U
     2523   or ub.cash-desk.pos-type = 'Autotank':U
     2524   then do:
     2525     file-info:file-name = (out  + "undelivered").
     2526     if file-info:FULL-PATHNAME <> ? then do:
     2527       run str/rsndxibm.p ( input parparentproc
     2528                           ,input p-parent-handle
     2529                           ,input p-log-handle
     2530                           ,input out  + "undelivered" ) no-error.
     2531     end.
     2532   end.
     2533     end.
     2534   END CASE.
     2535       RUN for-cash-cycle no-error.
     2536     END.
     2537     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2538   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   case ub.cash-desk.pos-type:
     2540   END CASE.
     2541     END.
     2542   END.
     2543   END PROCEDURE.
     2544   run write-log-and-file in p-log-handle (
     2545         input 1
     2546       , input log-file-name
     2547       , input 1
     2548       , input substitute("Пересылка на кассы &1 БД &2 информации по объектам БД", 'IBM-XML':U, p-db-num)
     2549                                             ).
     2550   RUN SENDING no-error.
     2551   if error-status:error then do:
     2552     run write-log-and-file in p-log-handle (
     2553           input 1
     2554         , input log-file-name
     2555         , input 1
     2556         , input substitute( "!!!Ошибки при отсылке информации по объектам БД на кассы  БД &1"
     2557                            , p-db-num
     2558                           )
     2559                                           ).
     2560     assign
     2561     v-view-log = yes
     2562     .
     2563   end.
     2564   if v-view-log then return error .
