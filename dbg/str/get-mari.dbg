     2304   FUNCTION convert-discount returns integer
     2305                                             ( input p-disc-reason as integer
     2306                                             , input p-disc-type  as integer
     2307                                             , input p-line-type as integer) :
     2308   define variable v-disc-type as integer no-undo .
     2309   if p-line-type = integer('1':U)
     2310   or p-line-type = integer('0':U)
     2311   then do:
     2312     if p-disc-type = 0
     2313     or p-disc-type = 1
     2314     or p-disc-type = 2
     2315     then do:
     2316       if p-disc-reason <> 0 then
     2317       p-disc-type = p-disc-reason
     2318       .
     2319     end.
     2320   end.
     2321   if p-line-type = integer('3':U)
     2322   or p-line-type = integer('2':U) then do:
     2323     if p-disc-type = 101
     2324     or p-disc-type = 102
     2325     then do:
     2326       if p-disc-reason <> 0 then
     2327       p-disc-type = p-disc-reason
     2328       .
     2329     end.
     2330   end.
     2331   if p-disc-reason <> 0 then do:
     2332     CASE p-disc-reason:
     2333       when 0 then do:
     2334         return integer('0':U).
     2335       end.
     2336       when 1 then do:
     2337         return integer('11':U).
     2338       end.
     2339       when 2 then do:
     2340         return integer('1':U).
     2341       end.
     2342       when 3 or when 15 then do:
     2343         return integer('7':U).
     2344       end.
     2345       when 4 then do:
     2346         return integer('4':U).
     2347       end.
     2348       when 5 then do:
     2349         return integer('12':U).
     2350       end.
     2351       when 6 then do:
     2352         return integer('3':U).
     2353       end.
     2354       when 7 then do:
     2355         return integer('13':U).
     2356       end.
     2357       when 8
     2358       or
     2359       when 9
     2360       or
     2361       when 10
     2362       then do:
     2363         return integer('20':U).
     2364       end.
     2365       when 11
     2366       then do:
     2367         return integer('21':U).
     2368       end.
     2369       when 13
     2370       then do:
     2371         return integer('22':U).
     2372       end.
     2373       when 16 then do:
     2374         return integer('23':U).
     2375       end.
     2376     END CASE.
     2377   end.
     2378   CASE p-disc-type:
     2379     when 0 then do:
     2380       return integer('0':U).
     2381     end.
     2382     when 1 then do:
     2383       return integer('13':U).
     2384     end.
     2385     when 2 then do:
     2386       return integer('2':U).
     2387     end.
     2388     when 3 then do:
     2389       return integer('4':U).
     2390     end.
     2391     when 4 then do:
     2392       return integer('12':U).
     2393     end.
     2394     when 5 then do:
     2395       return integer('1':U).
     2396     end.
     2397     when 6 then do:
     2398       return integer('3':U).
     2399     end.
     2400     when 7 then do:
     2401       return integer('14':U).
     2402     end.
     2403     when 8 then do:
     2404       return integer('15':U).
     2405     end.
     2406     when 9 then do:
     2407       return integer('16':U).
     2408     end.
     2409     when 101 then do:
     2410       return integer('13':U).
     2411     end.
     2412     when 102 then do:
     2413       return integer('5':U).
     2414     end.
     2415     when 103 then do:
     2416       return integer('1':U).
     2417     end.
     2418     when 104 then do:
     2419       return integer('5':U).
     2420     end.
     2421     when 105 then do:
     2422       return integer('1':U).
     2423     end.
     2424     when 106 then do:
     2425       return integer('1':U).
     2426     end.
     2427   END CASE.
     2428   END FUNCTION.
     2429   run get-general-parameters in this-procedure .
     2430   procedure get-general-parameters :
