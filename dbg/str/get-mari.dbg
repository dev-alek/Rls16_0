     2462   FUNCTION convert-pay-code returns integer (input p-spool-pay-code as integer
     2463                                             , output p-curr-code as integer
     2464                                                ):
     2465   define variable v-cdpay-code like ub.cash-pay.cdpay-code no-undo .
     2466   define variable ii as integer no-undo .
     2467   define variable v-entry as character no-undo .
     2468   p-curr-code = ?.
     2469   _do:
     2470   do ii = 1 to num-entries(mariapayg, ';'):
     2471     v-entry = entry(ii, mariapayg, ';').
     2472     if v-entry begins substitute("&1/", p-spool-pay-code) then do:
     2473        assign
     2474        v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47))))
     2475        p-curr-code =  integer(entry(2, entry(2, v-entry, chr(47))))
     2476        no-error
     2477        .
     2478        leave _do.
     2479     end.
     2480   end.
     2481   if p-curr-code = ? then
     2482   assign
     2483   p-curr-code = 0
     2484   v-cdpay-code = 0
     2485   .
     2486   return v-cdpay-code.
     2487   END FUNCTION.
     2488   FUNCTION convert-pet-pay-code returns integer (input p-spool-pay-code as integer
     2489                                                , input p-emitent-code as integer
     2490                                                , input p-petrol-card as character
     2491                                                , output p-curr-code as integer
     2492                                                ):
     2493   define variable v-cdpay-code like ub.cash-pay.cdpay-code no-undo .
     2494   define variable ii as integer no-undo .
     2495   define variable v-entry as character no-undo .
     2496   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     2497   p-curr-code = ?.
     2498   if p-petrol-card <> '':U then do:
     2499     p-petrol-card = string(integer(p-petrol-card)).
     2500     for each buf_cash-pay-attr no-lock where
     2501             buf_cash-pay-attr.attr-code = 'paycard-all-prefix':U:
     2502       do ii = 1 to num-entries(buf_cash-pay-attr.attr-value):
     2503          if p-petrol-card begins string(decimal(entry(ii, buf_cash-pay-attr.attr-value))) then do:
     2504             assign
     2505             v-cdpay-code = buf_cash-pay-attr.cdpay-code
     2506             p-curr-code = buf_caSH-PAY-ATTR.CURR-CODE
     2507             .
     2508             LEAVE.
     2509          end.
     2510       end.
     2511     end.
     2512   end.
     2513   else do:
     2514     _do:
     2515     do ii = 1 to num-entries(mariapayp, ';'):
     2516       v-entry = entry(ii, mariapayp, ';').
     2517       if v-entry begins substitute("&1,&2/", p-spool-pay-code, p-emitent-code) then do:
     2518         assign
     2519         v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47))))
     2520         p-curr-code =  integer(entry(2, entry(2, v-entry, chr(47))))
     2521         no-error
     2522         .
     2523         leave _do.
     2524       end.
     2525     end.
     2526   end.
     2527   if p-curr-code = ? then
     2528   assign
     2529   p-curr-code = 0
     2530   v-cdpay-code = 0
     2531   .
     2532   return v-cdpay-code.
     2533   END FUNCTION.
     2534   FUNCTION convert-chk-type returns integer( input p-spool-chk-type as character):
     2535   define variable v-chk-type like ub.chk-doc.chk-type no-undo .
     2536   CASE p-spool-chk-type:
     2537     when '001':U then do:
     2538        v-chk-type = integer('1':U).
     2539     end.
     2540     when '002':U  then do:
     2541        v-chk-type = integer('6':U).
     2542     end.
     2543   END CASE.
     2544   return v-chk-type.
     2545   END FUNCTION.
     2546   FUNCTION convert-pet-chk-type returns integer( input p-spool-chk-type as character):
     2547   define variable v-chk-type like ub.chk-doc.chk-type no-undo .
     2548   CASE p-spool-chk-type:
     2549     when '001':U
     2550     or
     2551     when '002':U  then do:
     2552        v-chk-type = integer('1':U).
     2553     end.
     2554     when '003':U then do:
     2555        v-chk-type = integer('6':U).
     2556     end.
     2557     when '004':U then do:
     2558        v-chk-type = integer('17':U).
     2559     end.
     2560     when '005':U then do:
     2561        v-chk-type = integer('15':U).
     2562     end.
     2563   END CASE.
     2564   return v-chk-type.
     2565   END FUNCTION.
     2566   RUN get-mari-c in this-procedure ( input file_ ) no-error .
     2567   if error-status:error then do:
     2568       run write-log-and-file in p-log-handle (
     2569             input 1
     2570           , input log-file-name
     2571           , input 1
     2572           , input substitute( "!!!Ошибка при обработке файла &1: &2"
     2573                               , file_
     2574                               , return-value
     2575                             )
     2576                                             ).
     2577     assign
     2578     p-view-log = yes
     2579     .
     2580     undo, return "error":U.
     2581   end.
     2582   PROCEDURE get-mari-c.
     2583   define input parameter filename as char no-undo.
     2584   define variable rr as integer no-undo .
     2585   define variable v-l as integer no-undo .
     2586   define variable v-check-es as logical no-undo .
     2587   define buffer buf_cash-desk for ub.cash-desk.
     2588   run gbl/filename.p (
     2589                   input filename
     2590                  ,output v-full-path
     2591                  ,output v-path
     2592                  ,output v-file-name
     2593                  ,output v-file-name-no-ext
     2594                  ,output v-file-name-ext
     2595                  ) no-error .
     2596   if error-status:error then do:
     2597     assign
     2598     p-view-log = yes
     2599     .
     2600     run write-log-and-file in p-log-handle (
     2601           input 1
     2602         , input log-file-name
     2603         , input 1
     2604         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении полного пути файлу: &2"
     2605                             , filename
     2606                             , return-value
     2607                           )
     2608                                     ).
     2609     return "error":U.
     2610   end.
     2611   if index('16-42,17-43,':U, string(integer(v-file-name-ext)) + '-') > 0 then do:
     2612     assign
     2613     v-file-name-ext = substring('16-42,17-43,':U, index('16-42,17-43,':U, string(integer(v-file-name-ext)) + '-'))
     2614     v-file-name-ext = entry(2, v-file-name-ext, '-')
     2615     v-file-name-ext = entry(1, v-file-name-ext)
     2616     .
     2617     filename2 = v-path + chr(47) + v-file-name-no-ext + '.' + string(integer(v-file-name-ext), '999').
     2618     if search( filename2) <> ? then do:
     2619        v-two-files = yes.
     2620     end.
     2621   end.
     2622   run get-mar-parameters in this-procedure ( input v-file-name-ext) no-error.
     2623   if error-status:error then do:
     2624     assign
     2625     p-view-log = yes
     2626     .
     2627     run write-log-and-file in p-log-handle (
     2628           input 1
     2629         , input log-file-name
     2630         , input 1
     2631         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении значений настроечных параметров: &2"
     2632                             , filename
     2633                             , return-value
     2634                           )
     2635                                           ).
     2636     undo, return "error":U.
     2637   end.
     2638   error-status:error = FALSE.
     2639   do rr = 1 to (if v-two-files then 2 else 1):
     2640     if rr = 1 then do:
     2641       input stream ChkStream from value( filename ).
     2642     end.
     2643     if rr = 2 then do:
     2644       input stream ChkStream from value( filename2 ).
     2645     end.
     2646     _repeat:
     2647     REPEAT :
     2648       import stream ChkStream unformatted ss.
     2649       assign
     2650       var-file-line-num = var-file-line-num + 1
     2651       .
     2652       if var-file-line-num modulo 100 = 0 then do:
     2653         run show-counter in p-log-handle .
     2654         run write-counter in p-log-handle ( substitute("Файл &1: предварительно прочитано строк &2", filename, var-file-line-num)).
     2655       end.
     2656       if ss = '':U
     2657       or ss = ? then next _repeat.
     2658       assign
     2659       v-first-check-in-jo = (v-jour-no <> integer(entry(1, ss, chr(3))))
     2660       v-jour-no = integer(entry(1, ss, chr(3)))
     2661       v-rec-no = integer(entry(2, ss, chr(3)))
     2662       ss = entry(3, ss, chr(3))
     2663       no-error
     2664       .
     2665       if error-status:error then do:
     2666         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2667       end.
     2668       if v-first-check-in-jo then do:
     2669         assign
     2670         v-first-journal = tekka-is-first-journal (v-jour-no)
     2671         .
     2672       end.
     2673       find first tt-ss where
     2674                   tt-ss.jour-no = v-jour-no
     2675               and tt-ss.rec-no = v-rec-no no-error .
     2676       if not available tt-ss then do:
     2677         create tt-ss.
     2678         assign
     2679         tt-ss.jour-no = v-jour-no
     2680         tt-ss.rec-no = v-rec-no
     2681         tt-ss.is-head = (rr = 1)
     2682         tt-ss.first-check = (v-first-journal and tt-ss.rec-no = 1)
     2683         .
     2684         if ss begins 'close-shift=' then do:
     2685           tt-ss.is-shift  = yes.
     2686         end.
     2687         if ss begins 'tekka-date-time=' then do:
     2688           run tekka-date-time in this-procedure ( input entry(2, ss, '=':U), input entry(3, ss, '=':U )) no-error .
     2689           delete tt-ss.
     2690           next _repeat.
     2691         end.
     2692         DO ii = 1 to num-entries(ss, chr(4)):
     2693           v-check-es = no.
     2694           tt-ss.n-entry[ii] = entry(ii, ss, chr(4)) .
     2695           if tt-ss.is-shift = no then do:
     2696             if v-petrol-mode then do:
     2697               if ii = 9 then do:
     2698                 assign
     2699                 tt-ss.chk-num = integer(tt-ss.n-entry[ii])
     2700                 no-error
     2701                 .
     2702                 v-check-es = yes.
     2703               end.
     2704               if ii = 5 then do:
     2705                 assign
     2706                 tt-ss.z-count = integer(tt-ss.n-entry[ii])
     2707                 tt-ss.hundred = (if tt-ss.z-count = 0 or tt-ss.z-count = 100 then yes else no)
     2708                 tt-ss.z-count = (if tt-ss.hundred then 11 else tt-ss.z-count)
     2709                 no-error
     2710                 .
     2711                 v-check-es = yes.
     2712               end.
     2713             end.
     2714             else do:
     2715               if (rr = 1 and ii = (7 + 0) )
     2716               or (rr = 2 and ii = 3 )
     2717               then do:
     2718                 assign
     2719                 tt-ss.chk-num = integer(tt-ss.n-entry[ii])
     2720                 no-error
     2721                 .
     2722                 v-check-es = yes.
     2723               end.
     2724               if (rr = 1 and ii = 1 )
     2725               then do:
     2726                 assign
     2727                 tt-ss.z-count = integer(tt-ss.n-entry[ii])
     2728                 tt-ss.hundred = (if tt-ss.z-count = 0 or tt-ss.z-count = 100 then yes else no)
     2729                 tt-ss.z-count = (if tt-ss.hundred then 11 else tt-ss.z-count)
     2730                 no-error
     2731                 .
     2732                 v-check-es = yes.
     2733               end.
     2734             end.
     2735             if v-check-es = yes
     2736             and error-status:error then do:
     2737               if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2738             end.
     2739           end.
     2740         END.
     2741         tt-ss.num-fields = ii - 1.
     2742       end.
     2743     end.
     2744     input stream ChkStream close.
     2745   end.
     2746   if v-petrol-mode then do:
     2747     _tt-ss1:
     2748     for each tt-ss:
     2749       if tt-ss.is-shift then do:
     2750         run proc-shift in this-procedure ( buffer tt-ss, input tt-ss.num-fields ) no-error .
     2751         next _tt-ss1.
     2752       end.
     2753       else do:
     2754         run proc-petrol-str in this-procedure no-error .
     2755         run proc-end in this-procedure no-error .
     2756       end.
     2757     end.
     2758   end.
     2759   else do:
     2760     _tt-ss2:
     2761     for each tt-ss where
     2762             tt-ss.is-head = yes:
     2763       if tt-ss.is-shift then do:
     2764         run proc-shift in this-procedure ( buffer tt-ss, input tt-ss.num-fields ) no-error .
     2765       end.
     2766       else do:
     2767         v-l = 0.
     2768         _v-l:
     2769         for  each buf_tt-ss where
     2770              buf_tt-ss.is-head = no
     2771           and buf_tt-ss.chk-num = tt-ss.chk-num:
     2772           assign
     2773           v-jour-no2 = buf_tt-ss.jour-no
     2774           v-rec-no2 = buf_tt-ss.rec-no
     2775           v-l = v-l + 1
     2776           .
     2777           run proc-str in this-procedure ( input (v-l = 1)) no-error .
     2778           if exist then leave _v-l.
     2779         end.
     2780         if not exist then do:
     2781           run proc-end in this-procedure no-error .
     2782         end.
     2783           run process-maria-attr in this-procedure ( input (tekka-num-recs(tt-ss.jour-no, tt-ss.rec-no) +
     2784                                                             tekka-num-recs(v-jour-no2, v-rec-no2) / 10000) ).
     2785       end.
     2786     end.
     2787   END .
     2788   for each temp-cash-desk:
     2789     find first buf_cash-desk no-lock where
     2790               buf_cash-desk.db-num = g#db-num
     2791           AND buf_cash-desk.obj-code = p-obj-code
     2792           AND buf_cash-desk.pos-type = 'MARIA':U
     2793           AND buf_cash-desk.cash-num = temp-cash-desk.cash-num no-error .
     2794     if available buf_cash-desk then do:
     2795       run cd-attr-write in this-procedure (
     2796                                              input g#db-num
     2797                                             ,input p-obj-code
     2798                                             ,input 'MARIA':U
     2799                                             ,input temp-cash-desk.cash-num
     2800                                             ,input 'MARIA_operative':U
     2801                                             ,input 'last-check-maria':U
     2802                                             ,input (cd-attr-CD-DatetoString (temp-cash-desk.last-date)  + chr(32) +
     2803                                                     string(temp-cash-desk.last-z-count) + chr(32) +
     2804                                                     string(temp-cash-desk.last-num-recs) + chr(32) +
     2805                                                     cd-attr-CD-DatetoString (temp-cash-desk.last-p-date)  + chr(32) +
     2806                                                     string(temp-cash-desk.last-p-z-count) + chr(32) +
     2807                                                     string(temp-cash-desk.last-p-num-recs) )
     2808                                           ,input ?
     2809                                           ,input 0.0
     2810                                           ,input 0
     2811                                           ,input no
     2812                                                     ) no-error .
     2813       if error-status:error then
     2814       message
     2815       error-status:get-message(1) return-value
     2816       view-as alert-box .
     2817     end.
     2818   end.
     2819   END PROCEDURE.
     2820   procedure proc-end :
     2821     do
     2822     on error undo, return error
     2823     :
     2824        get-chkc_context.ll = lll.
     2825   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2826   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     2827     (input  buffer get-chkc_context:handle
     2828     ,input  'ДОБАВЛЕНИЕ':U
     2829     ,input  ''
     2830     ,input  yes
     2831     ,input  yes
     2832     ,input  ?
     2833     ,input  lng-sub-d
     2834     ,input  sub-d
     2835     ,input  var-discnt-id
     2836     ,input-output prev-code
     2837       ) no-error .
     2838        assign
     2839        prev-code = "":U
     2840        p-view-log = (p-view-log or get-chkc_context.view-log)
     2841        lll = get-chkc_context.ll
     2842        .
     2843     end.
     2844   end procedure.
     2845   procedure proc-str :
     2846   define input parameter p-check-start as logical no-undo .
     2847   DEFINE VARIABLE pre-pay-type as character no-undo .
     2848   DEFINE VARIABLE cur-pay-type as character no-undo .
     2849   DEFINE VARIABLE TotSum-Value as decimal no-undo .
     2850   define variable v-year as integer no-undo .
     2851   DEFINE VARIABLE v-today as date no-undo .
     2852   DEFINE VARIABLE v-time as integer no-undo .
     2853   define variable v-clu_ as integer no-undo .
     2854   define variable v-discnt-dir as integer no-undo .
     2855   define variable pay-type2 as character no-undo .
     2856   define variable pay_code2 as integer no-undo .
     2857   define variable curr_code2 as integer no-undo .
     2858   define variable tot_sum2 as decimal no-undo .
     2859   define variable pp as integer no-undo .
     2860   define variable discnt-from-check-prim as decimal no-undo .
     2861   define variable file_ as character no-undo .
     2862   define buffer buf_shift-cash for ub.shift-cash.
     2863   do
     2864   on error undo, return error return-value
     2865   :
     2866     if p-check-start then do:
     2867       assign
     2868       gbl-type = tt-ss.n-entry[3]
     2869       .
     2870       if lookup (gbl-type, accept-types) = 0 then do:
     2871         assign
     2872         exist = yes
     2873         .
     2874         return.
     2875       end.
     2876       assign
     2877       v-is-petrol-check = no
     2878       chk-date_ = 01/01/1990
     2879       chk-time_ = 0
     2880       shift-date_ = chk-date_
     2881       shift-num_ = 0
     2882       shift-name_ = ''
     2883       shop-code = 0
     2884       shop-type = "":U
     2885       sales-man_ = 0
     2886       v-flag-card = no
     2887       cashier_ = 0
     2888       pay-desk_ = 0
     2889       z-num_ = 0
     2890       cash-rate_ = 0
     2891       d-card_ = "":U
     2892       d-mask_ = "":U
     2893       cli-type_ = "":U
     2894       cli-code_ = 0
     2895       tot-d-pcnt = 0
     2896       doc-num_ = "":U
     2897       v-end-of-check = no
     2898       exist = no
     2899       .
     2900       run cur-time in this-procedure ( output v-today, output v-time).
     2901       assign
     2902       v-year    = (if int( substr( tt-ss.n-entry[6 + 0 ], 1, 3 ) ) = month(v-today)
     2903                     then year(v-today)
     2904                     else year(v-today) - 1)
     2905       chk-date_ = date(
     2906                           int( substr( tt-ss.n-entry[6 + 0 ], 1, 3 ) ),
     2907                           int( substr( tt-ss.n-entry[6 + 0 ], 4, 2 ) ),
     2908                           int( v-year)
     2909                           )
     2910       chk-time_ =  int( substr( tt-ss.n-entry[5 + 0 ], 1, 3 ) ) * 3600 +
     2911                    int( substr( tt-ss.n-entry[5 + 0 ], 4, 2 ) ) * 60
     2912       shop-code = p-obj-code
     2913       shop-type = p-obj-type
     2914       chk-num_ = tt-ss.chk-num
     2915       sales-man_ = 0
     2916       cashier_ = integer( tt-ss.n-entry[2] )
     2917       pay-desk_ = p-cash-num
     2918       z-num_ =  tt-ss.z-count
     2919       cash-rate_ = 1
     2920       d-card_   = '':U
     2921       v-clu_ = 0
     2922       cli-type_ =  '':U
     2923       cli-code_ = 0
     2924       shift-num_ =  z-num_
     2925       shift-name_ = string(shift-num_)
     2926       shift-num_ = if get-chkc_context.shift-on then 0 else shift-num_
     2927       doc-num_ = '':U
     2928       chk-type_ = convert-chk-type(gbl-type)
     2929       pay-type = substring(tt-ss.n-entry[4], 1, 3)
     2930       pay_code = convert-pay-code(input integer(pay-type), output curr_code)
     2931       pay-type2 = (if 0 = 1
     2932                    then tt-ss.n-entry[5]
     2933                    else substring(tt-ss.n-entry[4], 4, 3))
     2934       pay_code2 = (if pay-type2 <> '000':U
     2935                   then convert-pay-code(input integer(pay-type2), output curr_code2)
     2936                   else 0)
     2937       tot_sum  = integer(tt-ss.n-entry[8 + 0]) / 100
     2938       tot_sum2  = integer(tt-ss.n-entry[9 + 0]) / 100
     2939       pay-card_ = tt-ss.n-entry[10 + 0] + tt-ss.n-entry[11 + 0]
     2940       no-error .
     2941       .
     2942       if error-status:error then do:
     2943         var-file-line-num = tt-ss.rec-no.
     2944         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2945       end.
     2946       if tt-ss.first-check then do:
     2947         v-shift-date = chk-date_.
     2948       end.
     2949       else do:
     2950         if tt-ss.z-count <> prev-z-count then do:
     2951           find first buf_shift-cash  no-lock where
     2952                     buf_shift-cash.obj-type = p-obj-type
     2953                 and buf_shift-cash.obj-code = p-obj-code
     2954                 and buf_shift-cash.cash-num = p-cash-num
     2955                 and buf_shift-cash.shift-date >= (chk-date_ - 1)
     2956                 and buf_shift-cash.z-num = (if tt-ss.hundred then 100 else tt-ss.z-count) no-error.
     2957           if available buf_shift-cash then do:
     2958             v-shift-date = buf_shift-cash.shift-date.
     2959           end.
     2960           else do:
     2961             run write-log-and-file in p-log-handle (
     2962                     input 1
     2963                   , input log-file-name
     2964                   , input 1
     2965                   , input substitute( "!!!Ошибка при обработке данных с кассы &1: Невозможно получить дату смены с № &2"
     2966                                       , p-cash-num
     2967                                       , tt-ss.z-count
     2968                                     )
     2969                                                     ).
     2970             assign
     2971             p-view-log = yes
     2972             .
     2973           end.
     2974         end.
     2975         prev-z-count = tt-ss.z-count.
     2976       end.
     2977       assign
     2978       shift-date_ = if cas-shft
     2979                     then v-shift-date
     2980                     else chk-date_
     2981       .
     2982       assign
     2983       for-chk-type = ""
     2984       exist = yes
     2985       .
     2986       FIND  ub.chk-doc where
     2987             ub.chk-doc.obj-type = shop-type and
     2988             ub.chk-doc.obj-code = shop-code and
     2989             ub.chk-doc.chk-date = chk-date_ and
     2990             ub.chk-doc.pay-desk = pay-desk_ and
     2991             ub.chk-doc.chk-time = chk-time_ and
     2992             ub.chk-doc.chk-num = chk-num_ and
     2993             ub.chk-doc.sales-man = sales-man_ NO-ERROR NO-WAIT.
     2994       IF (NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc)
     2995       then do:
     2996         CREATE ub.chk-doc.
     2997         assign
     2998         lll = lll + 1
     2999         exist = no
     3000         lng = 0
     3001         lnp = 0
     3002         cr = 0
     3003         sub-d = 0
     3004         var-discnt-id = 0
     3005         lng-sub-d = 0
     3006         netto-for-sub-d = 0
     3007         v-rec-no-start-check = v-rec-no
     3008         ub.chk-doc.pay-desk = p-cash-num
     3009         ub.chk-doc.chk-num = chk-num_
     3010         ub.chk-doc.obj-type = p-obj-type
     3011         ub.chk-doc.obj-code = p-obj-code
     3012         ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     3013                             then string(next-value(s-chk, ub))
     3014                             else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     3015         ub.chk-doc.office = ?
     3016         for-chk-type = ""
     3017         prev-code = ub.chk-doc.doc-code
     3018         ub.chk-doc.sales-man = sales-man_
     3019         ub.chk-doc.chk-date = chk-date_
     3020         ub.chk-doc.chk-time = chk-time_
     3021         ub.chk-doc.shift-date = ub.chk-doc.chk-date
     3022         ub.chk-doc.src-shift-date = ub.chk-doc.shift-date
     3023         ub.chk-doc.cash-rate = 1
     3024         ub.chk-doc.cash-scale = 1
     3025         ub.chk-doc.z-number = z-num_
     3026         ub.chk-doc.correct = yes
     3027         ub.chk-doc.d-pcnt = 0
     3028         ub.chk-doc.src-d-pcnt = 0
     3029         ub.chk-doc.shift-num = (if cas-shft then shift-num_ else 0)
     3030         ub.chk-doc.cashier = cashier_
     3031         ub.chk-doc.chk-type = chk-type_
     3032         ub.chk-doc.correct = yes
     3033         ub.CHK-DOC.discnt = 0
     3034         ub.chk-doc.src-d-card =  d-card_
     3035         ub.chk-doc.src-d-pcnt = 0
     3036         ub.chk-doc.src-shift-date = (if cas-shft then shift-date_ else chk-date_)
     3037         ub.chk-doc.cash-rate = 1
     3038         ub.chk-doc.cash-scale = 1
     3039         ub.chk-doc.z-number = z-num_
     3040         ub.chk-doc.doc-num = doc-num_ + (if shift-name_ <> '':U
     3041                                         then (chr(4) + shift-name_)
     3042                                         else '':U)
     3043         ub.chk-doc.correct = yes
     3044         .
     3045       end.
     3046       else do:
     3047         assign
     3048         exist = yes
     3049         .
     3050         return.
     3051       end.
     3052     end.
     3053     assign
     3054     v-discnt-dir = (if substring(buf_tt-ss.n-entry[1], 1, 3) = '001' then 1 else - 1)
     3055     bc-buf = left-trim(buf_tt-ss.n-entry[4], '0')
     3056     curr-string-qnty = integer(buf_tt-ss.n-entry[5]) / 10000 * (if chk-type_ = integer('6':U) then -1 else 1)
     3057     Sum-from-check = integer(buf_tt-ss.n-entry[7]) / 100  * (if chk-type_ = integer('6':U) then -1 else 1)
     3058     price-from-check =  abs(sum-from-check / curr-string-qnty)
     3059     discnt-from-check = integer(buf_tt-ss.n-entry[6]) / 100 * (if chk-type_ = integer('6':U) then -1 else 1) * v-discnt-dir
     3060     discnt-from-check-prim = discnt-from-check / abs(curr-string-qnty) * (if chk-doc.chk-type = integer('6':U)
     3061                                                                           then - 1
     3062                                                                           else 1)
     3063     no-error .
     3064     if error-status:error then do:
     3065        var-file-line-num = buf_tt-ss.rec-no.
     3066        file_ = filename2.
     3067       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     3068     end.
     3069     IF not AVAILABLE ub.CHK-GDS
     3070       or NOT (ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3071               AND ub.chk-gds.src-code = bc-buf)
     3072       or NOT (ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3073           AND ub.chk-gds.src-code = bc-buf
     3074           AND pre-pay-type = cur-pay-type
     3075           AND round(ub.chk-gds.src-discnt, 2) = round(discnt-from-check / curr-string-qnty, 2)
     3076           )
     3077       or not (ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3078               and ub.chk-gds.line-num = tt-ss.rec-no - v-rec-no-start-check + 1)
     3079       or not ub.chk-gds.src-price = price-from-check
     3080         then do:
     3081       CREATE ub.chk-gds.
     3082       assign
     3083       lng = lng + 1
     3084       ub.chk-gds.doc-code = chk-doc.doc-code
     3085       ub.chk-gds.line-num = lng
     3086       ub.chk-gds.chk-date = chk-doc.chk-date
     3087       pre-pay-type = cur-pay-type
     3088       ub.chk-gds.b-code =  0
     3089       ub.chk-gds.grp-code = 0
     3090       ub.chk-gds.src-code = bc-buf
     3091       ub.chk-gds.is-error = no
     3092       ub.chk-gds.discnt = 0
     3093       ub.chk-gds.time-oper = chk-doc.chk-time
     3094       ub.chk-gds.src-qnty = 0
     3095       ub.chk-gds.doc-qnty = 0
     3096       ub.chk-gds.src-price = price-from-check
     3097       ub.chk-gds.src-sum = 0
     3098       ub.chk-gds.src-qnty = curr-string-qnty
     3099       ub.chk-gds.src-discnt = discnt-from-check-prim
     3100       ub.chk-gds.pass-gds = 0
     3101       ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     3102                           then (ub.chk-gds.src-qnty >= 0)
     3103                           else (ub.chk-gds.src-qnty <= 0)
     3104                           )
     3105       ub.chk-gds.line-type =  "":U
     3106       .
     3107     end.
     3108     else do:
     3109       assign
     3110       ub.chk-gds.src-discnt = (ub.chk-gds.src-discnt * abs(ub.chk-gds.src-qnty) + discnt-from-check-prim * abs(curr-string-qnty)) / abs( chk-gds.src-qnty + curr-string-qnty)
     3111       ub.chk-gds.src-qnty = ub.chk-gds.src-qnty + curr-string-qnty
     3112       .
     3113     end.
     3114     assign
     3115     ub.chk-gds.src-sum = ub.chk-gds.src-sum + sum-from-check
     3116     .
     3117     if ub.chk-gds.src-discnt <> 0 then do:
     3118       create ub.chk-discnt.
     3119       assign
     3120       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     3121       ub.chk-discnt.record-type = 0
     3122       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     3123       ub.chk-discnt.line-num = ub.chk-gds.line-num
     3124       ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     3125       ub.chk-discnt.line-type = integer('1':U)
     3126       ub.chk-discnt.line-sign =  (ub.chk-gds.src-qnty >= 0 ) NE (ub.chk-gds.src-discnt > 0 )
     3127       ub.chk-discnt.pass-discnt = integer('0':U)
     3128       ub.chk-discnt.value-type = integer('0':U)
     3129       ub.chk-discnt.discnt-type = integer('0':U)
     3130       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     3131       ub.chk-discnt.discnt-value-abs = ub.chk-gds.src-discnt
     3132       ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     3133       ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     3134       ub.chk-discnt.discnt-value-pcnt = if ub.chk-gds.src-sum <> 0 then
     3135                                       ub.chk-gds.src-discnt / ub.chk-gds.src-sum * 100
     3136                                       else 0
     3137       ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     3138       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     3139       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     3140       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     3141       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     3142       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     3143       var-discnt-id = var-discnt-id + 1
     3144       .
     3145     end.
     3146     if p-check-start then do:
     3147       do pp = 1 to (if pay_code2 > 0 then 2 else 1):
     3148         if pp = 2 then do:
     3149           assign
     3150           pay_code = pay_code2
     3151           curr_code = curr_code2
     3152           tot_sum = tot_sum2
     3153           .
     3154         end.
     3155         FIND ub.chk-pay where
     3156                 ub.chk-pay.doc-code = ub.chk-doc.doc-code AND
     3157                 ub.chk-pay.curr-code = curr_code AND
     3158                 ub.chk-pay.pay-code = pay_code      NO-ERROR.
     3159         if NOT available ub.chk-pay then do:
     3160           CREATE ub.chk-pay.
     3161           assign
     3162           lnp = lnp + 1
     3163           ub.chk-pay.doc-code = ub.chk-doc.doc-code
     3164           ub.chk-pay.line-num = lnp
     3165           ub.chk-pay.chk-date = ub.chk-doc.chk-date
     3166           ub.chk-pay.obj-code = p-obj-code
     3167           ub.chk-pay.obj-type = p-obj-type
     3168           ub.chk-pay.pay-code = pay_code
     3169           ub.chk-pay.pay-card = pay-card_
     3170           ub.chk-pay.curr-code = curr_code
     3171           ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + tot_sum * (if chk-type_ = integer('6':U) then -1 else 1)
     3172           ub.chk-pay.time-oper = ub.chk-doc.chk-time
     3173           ub.chk-pay.line-type = "":U
     3174           ub.chk-pay.line-sign =  (if ub.chk-doc.chk-type = integer('1':U)
     3175                                 then (ub.chk-pay.tot-sum >= 0)
     3176                                 else (ub.chk-pay.tot-sum <= 0)
     3177                                 )
     3178           ub.chk-pay.cash-rate = 1
     3179           ub.chk-pay.bank-rate = 1
     3180           ub.chk-pay.bank-scale = 1
     3181           ub.chk-pay.pass-pay  = 0
     3182           ub.chk-pay.is-error = no
     3183           .
     3184         end.
     3185         else do:
     3186           assign
     3187           ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + tot_sum * (if chk-type_ = integer('6':U) then -1 else 1)
     3188           .
     3189         end.
     3190       end.
     3191     end.
     3192   end.
     3193   end procedure.
     3194   procedure proc-petrol-str :
     3195   DEFINE VARIABLE pre-pay-type as character no-undo .
     3196   DEFINE VARIABLE cur-pay-type as character no-undo .
     3197   DEFINE VARIABLE TotSum-Value as decimal no-undo .
     3198   define variable v-year as integer no-undo .
     3199   DEFINE VARIABLE v-today as date no-undo .
     3200   DEFINE VARIABLE v-time as integer no-undo .
     3201   define variable v-clu_ as integer no-undo .
     3202   define variable v-discnt-dir as integer no-undo .
     3203   define variable bc-buf-int as integer no-undo .
     3204   define variable v-emitent as integer no-undo .
     3205   define variable discnt-from-check-prim as decimal no-undo .
     3206   define variable v-petrol-plus as logical no-undo .
     3207   define variable v-forma-opl as integer no-undo .
     3208   define buffer buf_cd-plu for ub.cd-plu.
     3209   define buffer buf_cd-clu for ub.cd-clu.
     3210   define buffer buf_shift-cash for ub.shift-cash.
     3211   do
     3212   on error undo, return error
     3213   :
     3214     assign
     3215     gbl-type = substring(tt-ss.n-entry[1], 7, 3)
     3216     .
     3217     if can-do(accept-types,  gbl-type ) then do:
     3218       assign
     3219       v-is-petrol-check = no
     3220       chk-date_ = 01/01/1990
     3221       chk-time_ = 0
     3222       shift-date_ = chk-date_
     3223       shift-num_ = 0
     3224       shift-name_ = ''
     3225       shop-code = 0
     3226       shop-type = "":U
     3227       sales-man_ = 0
     3228       v-flag-card = no
     3229       cashier_ = 0
     3230       pay-desk_ = 0
     3231       z-num_ = 0
     3232       cash-rate_ = 0
     3233       d-card_ = "":U
     3234       d-mask_ = "":U
     3235       cli-type_ = "":U
     3236       cli-code_ = 0
     3237       tot-d-pcnt = 0
     3238       doc-num_ = "":U
     3239       v-end-of-check = no
     3240       exist = no
     3241       .
     3242       run cur-time in this-procedure ( output v-today, output v-time).
     3243       assign
     3244       v-discnt-dir = (if substring(tt-ss.n-entry[1], 1, 3) = '001' then 1 else - 1)
     3245       chk-type_ = convert-pet-chk-type(gbl-type)
     3246       v-year    = (if int( substr( tt-ss.n-entry[8], 1, 3 ) ) = month(v-today)
     3247                     then year(v-today)
     3248                     else year(v-today) - 1)
     3249       chk-date_ = date(
     3250                           int( substr( tt-ss.n-entry[8], 1, 3 ) ),
     3251                           int( substr( tt-ss.n-entry[8], 4, 2 ) ),
     3252                           int( v-year)
     3253                           )
     3254       chk-time_ =  int( substr( tt-ss.n-entry[7], 1, 3 ) ) * 3600 + int( substr( tt-ss.n-entry[7], 4, 2 ) ) * 60
     3255       shift-date_ = if get-chkc_context.cas-shft
     3256                     then v-shift-date
     3257                     else chk-date_
     3258       shop-code = p-obj-code
     3259       shop-type = p-obj-type
     3260       chk-num_ = tt-ss.chk-num
     3261       sales-man_ = 0
     3262       cashier_ = integer( trim( tt-ss.n-entry[6] ) )
     3263       pay-desk_ = p-cash-num
     3264       z-num_ =  tt-ss.z-count
     3265       cash-rate_ = 1
     3266       pay-card_   = tt-ss.n-entry[15] + tt-ss.n-entry[16]
     3267       pay-card_ = (if trim(pay-card_, '0') = '':U then '':U else pay-card_)
     3268       v-forma-opl = integer(substring(tt-ss.n-entry[2], 3))
     3269       v-petrol-plus = if ((v-forma-opl = 0 or v-forma-opl = 1)
     3270                       AND
     3271                       integer(substring(tt-ss.n-entry[3], 4, 3)) = 20
     3272                       and
     3273                       (integer(substring(tt-ss.n-entry[1], 4, 3)) = 1 or integer(substring(tt-ss.n-entry[1], 4, 3)) = 2)
     3274                       )
     3275                       then yes
     3276                       else no
     3277       v-clu_ = (if v-forma-opl <> 255
     3278                 and not v-petrol-plus
     3279                 then (v-forma-opl + 1)
     3280                 else 0)
     3281       shift-num_ =  z-num_
     3282       shift-name_ = string(shift-num_)
     3283       shift-num_ = if get-chkc_context.shift-on then 0 else shift-num_
     3284       doc-num_ = tt-ss.n-entry[10]
     3285       bc-buf = substring(tt-ss.n-entry[3], 1, 3)
     3286       bc-buf-int = integer(bc-buf)
     3287       price-from-check =  integer( tt-ss.n-entry[12]) / 100
     3288       curr-string-qnty = integer(tt-ss.n-entry[11]) / 100 * (if chk-type_ = integer('6':U) then -1 else 1)
     3289       Sum-from-check = integer(tt-ss.n-entry[14]) / 100 * (if chk-type_ = integer('6':U) then -1 else 1)
     3290       discnt-from-check     = integer(tt-ss.n-entry[13]) / 100 * (if chk-type_ = integer('6':U) then -1 else 1) * v-discnt-dir
     3291       discnt-from-check-prim =  discnt-from-check / abs(curr-string-qnty) * (if chk-type_ = integer('6':U)
     3292                                                                               then - 1
     3293                                                                               else 1)
     3294       pay-type = substring(tt-ss.n-entry[1], 4, 3)
     3295       v-emitent = integer(substring(tt-ss.n-entry[3], 4, 3))
     3296           v-emitent = (if v-emitent = 31 then 0 else v-emitent)
     3297       pay_code = (if chk-type_ = integer('17':U)
     3298                   or chk-type_ = integer('15':U)
     3299                   then 0
     3300                   else convert-pet-pay-code(input integer(pay-type)
     3301                                     , input v-emitent
     3302                                     , input (if v-petrol-plus then pay-card_ else '':U)
     3303                                     , output curr_code))
     3304       pump_ = integer(substring(tt-ss.n-entry[4], 1, 3)) + 1
     3305       nozzle_ = integer(substring(tt-ss.n-entry[4], 4, 3)) + 1
     3306       no-error .
     3307       if error-status:error then do:
     3308         var-file-line-num = tt-ss.rec-no.
     3309         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     3310       end.
     3311       if tt-ss.first-check then do:
     3312         v-shift-date = chk-date_.
     3313       end.
     3314       else do:
     3315         if tt-ss.z-count <> prev-z-count then do:
     3316           find first buf_shift-cash  no-lock where
     3317                     buf_shift-cash.obj-type = p-obj-type
     3318                 and buf_shift-cash.obj-code = p-obj-code
     3319                 and buf_shift-cash.cash-num = p-cash-num
     3320                 and buf_shift-cash.shift-date >= (chk-date_ - 1)
     3321                 and buf_shift-cash.z-num = (if tt-ss.hundred then 100 else tt-ss.z-count) no-error.
     3322           if available buf_shift-cash then do:
     3323             v-shift-date = buf_shift-cash.shift-date.
     3324           end.
     3325           else do:
     3326             run write-log-and-file in p-log-handle (
     3327                     input 1
     3328                   , input log-file-name
     3329                   , input 1
     3330                   , input substitute( "!!!Ошибка при обработке данных с кассы &1: Невозможно получить дату смены с № &2"
     3331                                       , p-cash-num
     3332                                       , tt-ss.z-count
     3333                                     )
     3334                                                     ).
     3335             assign
     3336             p-view-log = yes
     3337             .
     3338           end.
     3339         end.
     3340         prev-z-count = tt-ss.z-count.
     3341       end.
     3342       assign
     3343       shift-date_ = if cas-shft
     3344                     then v-shift-date
     3345                     else chk-date_
     3346       .
     3347       find first buf_cd-plu no-lock where
     3348              buf_cd-plu.obj-type = p-obj-type
     3349          and buf_cd-plu.obj-code = p-obj-code
     3350          and buf_cd-plu.pos-type = 'MARIA':U
     3351          and buf_cd-plu.plu-type = 'топ':U
     3352          and buf_cd-plu.plu-code = (bc-buf-int + 1)  no-error .
     3353       if not available buf_cd-plu then do:
     3354         assign
     3355         bc-buf = chr(4) + bc-buf.
     3356       end.
     3357       else do:
     3358         assign
     3359         bc-buf = string(buf_cd-plu.b-str) + chr(4) + string(bc-buf-int + 1, '99999':U).
     3360       end.
     3361       if v-clu_ <> 0 then do:
     3362         find first buf_cd-clu no-lock where
     3363                  buf_cd-clu.obj-type = p-obj-type
     3364              and buf_cd-clu.obj-code = p-obj-code
     3365              and buf_cd-clu.pos-type = 'MARIA':U
     3366              and buf_cd-clu.clu-type = '':U
     3367              and buf_cd-clu.clu-code = v-clu_
     3368         no-error .
     3369         if not available buf_cd-clu then do:
     3370           assign
     3371           cli-type_ = '':U
     3372           cli-code_ = 0
     3373           .
     3374         end.
     3375         else do:
     3376           assign
     3377           cli-type_ = buf_cd-clu.cli-type
     3378           cli-code_ = buf_cd-clu.cli-code
     3379           d-card_   =  ('K':U + string(if cli-type_ = 'орг':U then 1 else 0) + string(cli-code_, '999999999'))
     3380           .
     3381         end.
     3382       end.
     3383     end.
     3384     else do:
     3385       assign
     3386       exist = yes
     3387       .
     3388       return.
     3389     end.
     3390     if can-do( accept-types , gbl-type ) then do:
     3391       assign
     3392       for-chk-type = ""
     3393       exist = yes
     3394       .
     3395       FIND  ub.chk-doc where
     3396             ub.chk-doc.obj-type = shop-type and
     3397             ub.chk-doc.obj-code = shop-code and
     3398             ub.chk-doc.chk-date = chk-date_ and
     3399             ub.chk-doc.pay-desk = pay-desk_ and
     3400             ub.chk-doc.chk-time = chk-time_ and
     3401             ub.chk-doc.chk-num = chk-num_ and
     3402             ub.chk-doc.sales-man = sales-man_ NO-ERROR NO-WAIT.
     3403       IF (NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc)
     3404       then do:
     3405           run proc-end in this-procedure .
     3406           CREATE ub.chk-doc.
     3407           assign
     3408           lll = lll + 1
     3409           exist = no
     3410           lng = 0
     3411           lnp = 0
     3412           cr = 0
     3413           sub-d = 0
     3414           var-discnt-id = 0
     3415           lng-sub-d = 0
     3416           netto-for-sub-d = 0
     3417           v-rec-no-start-check = v-rec-no
     3418           ub.chk-doc.pay-desk = pay-desk_
     3419           ub.chk-doc.chk-num = chk-num_
     3420           ub.chk-doc.obj-type = p-obj-type
     3421           ub.chk-doc.obj-code = p-obj-code
     3422           ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     3423                               then string(next-value(s-chk, ub))
     3424                               else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     3425           ub.chk-doc.office = ?
     3426           for-chk-type = ""
     3427           prev-code = ub.chk-doc.doc-code
     3428           ub.chk-doc.sales-man = sales-man_
     3429           ub.chk-doc.chk-date = chk-date_
     3430           ub.chk-doc.chk-time = chk-time_
     3431           ub.chk-doc.shift-date = ub.chk-doc.chk-date
     3432           ub.chk-doc.src-shift-date = ub.chk-doc.shift-date
     3433           ub.chk-doc.cash-rate = 1
     3434           ub.chk-doc.cash-scale = 1
     3435           ub.chk-doc.z-number = z-num_
     3436           ub.chk-doc.correct = yes
     3437           ub.chk-doc.d-pcnt = 0
     3438           ub.chk-doc.src-d-pcnt = 0
     3439           ub.chk-doc.shift-num = (if cas-shft then shift-num_ else 0)
     3440           ub.chk-doc.cashier = cashier_
     3441           ub.chk-doc.chk-type = chk-type_
     3442           ub.chk-doc.correct = yes
     3443           ub.CHK-DOC.discnt = 0
     3444           ub.chk-doc.src-d-card =  d-card_
     3445           ub.chk-doc.src-d-pcnt = - tot-d-pcnt
     3446           ub.chk-doc.src-shift-date = (if cas-shft then shift-date_ else chk-date_)
     3447           ub.chk-doc.cash-rate = 1
     3448           ub.chk-doc.cash-scale = 1
     3449           ub.chk-doc.z-number = z-num_
     3450           ub.chk-doc.doc-num = doc-num_ + (if shift-name_ <> '':U
     3451                                           then (chr(4) + shift-name_)
     3452                                           else '':U)
     3453           v-is-petrol-check = lookup(string(ub.chk-doc.chk-type) , '14,15,16,17,36':U) > 0
     3454           ub.chk-doc.correct = yes
     3455           .
     3456         end.
     3457         else do:
     3458           assign
     3459           exist = yes
     3460           .
     3461           return.
     3462         end.
     3463         IF not AVAILABLE ub.CHK-GDS
     3464           or NOT (ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3465                   AND ub.chk-gds.src-code = bc-buf)
     3466           or NOT (ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3467               AND ub.chk-gds.src-code = bc-buf
     3468               AND pre-pay-type = cur-pay-type
     3469               AND ub.chk-gds.pump = pump_ + 1000 * nozzle_
     3470               )
     3471               then do:
     3472           CREATE ub.chk-gds.
     3473           assign
     3474           lng = lng + 1
     3475           ub.chk-gds.doc-code = ub.chk-doc.doc-code
     3476           ub.chk-gds.line-num = lng
     3477           ub.chk-gds.chk-date = ub.chk-doc.chk-date
     3478           pre-pay-type = cur-pay-type
     3479           ub.chk-gds.b-code =  0
     3480           ub.chk-gds.grp-code = 0
     3481           ub.chk-gds.src-code = bc-buf
     3482           ub.chk-gds.is-error = no
     3483           ub.chk-gds.discnt = 0
     3484           ub.chk-gds.time-oper = ub.chk-doc.chk-time
     3485           ub.chk-gds.src-qnty = 0
     3486           ub.chk-gds.doc-qnty = 0
     3487           ub.chk-gds.src-price = price-from-check
     3488           ub.chk-gds.src-sum = 0
     3489           ub.chk-gds.src-qnty = curr-string-qnty
     3490           ub.chk-gds.src-discnt = discnt-from-check-prim
     3491           ub.chk-gds.pass-gds = 0
     3492           ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     3493                               then (ub.chk-gds.src-qnty >= 0)
     3494                               else (ub.chk-gds.src-qnty <= 0)
     3495                               )
     3496           ub.chk-gds.line-type =  "":U
     3497           ub.chk-gds.pump = pump_ + 1000 * nozzle_
     3498           .
     3499         end.
     3500         else do:
     3501           assign
     3502           ub.chk-gds.src-discnt = (ub.chk-gds.src-discnt * abs(ub.chk-gds.src-qnty) + discnt-from-check-prim * abs(curr-string-qnty)) / abs( chk-gds.src-qnty + curr-string-qnty)
     3503           ub.chk-gds.src-qnty = ub.chk-gds.src-qnty + curr-string-qnty
     3504           .
     3505         end.
     3506         assign
     3507         ub.chk-gds.src-sum = ub.chk-gds.src-sum + sum-from-check
     3508         .
     3509         if ub.chk-gds.src-discnt <> 0 then do:
     3510           create ub.chk-discnt.
     3511           assign
     3512           ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     3513           ub.chk-discnt.record-type = 0
     3514           ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     3515           ub.chk-discnt.line-num = ub.chk-gds.line-num
     3516           ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     3517           ub.chk-discnt.line-type = integer('1':U)
     3518           ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     3519           ub.chk-discnt.pass-discnt = integer('0':U)
     3520           ub.chk-discnt.value-type = integer('0':U)
     3521           ub.chk-discnt.discnt-type = integer('0':U)
     3522           ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     3523           ub.chk-discnt.discnt-value-abs = ub.chk-gds.src-discnt
     3524           ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     3525           ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     3526           ub.chk-discnt.discnt-value-pcnt = if ub.chk-gds.src-sum <> 0 then
     3527                                           ub.chk-gds.src-discnt / ub.chk-gds.src-sum * 100
     3528                                           else 0
     3529           ub.chk-discnt.object-line-num = chk-gds.line-num
     3530           ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     3531           ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     3532           ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     3533           ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     3534           ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     3535           var-discnt-id = var-discnt-id + 1
     3536           .
     3537         end.
     3538         if not (chk-type_ = integer('17':U)
     3539                or chk-type_ = integer('15':U)) then do:
     3540           FIND ub.chk-pay where
     3541                 ub.chk-pay.doc-code = ub.chk-doc.doc-code AND
     3542                 ub.chk-pay.curr-code = curr_code AND
     3543                 ub.chk-pay.pay-code = pay_code      NO-ERROR.
     3544           if NOT available ub.chk-pay
     3545           or ub.chk-pay.pay-card <> pay-card_
     3546           then do:
     3547             CREATE ub.chk-pay.
     3548             assign
     3549             lnp = lnp + 1
     3550             ub.chk-pay.doc-code = ub.chk-doc.doc-code
     3551             ub.chk-pay.line-num = lnp
     3552             ub.chk-pay.chk-date = ub.chk-doc.chk-date
     3553             ub.chk-pay.obj-code = p-obj-code
     3554             ub.chk-pay.obj-type = p-obj-type
     3555             ub.chk-pay.pay-code = pay_code
     3556             ub.chk-pay.curr-code = curr_code
     3557             ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + sum-from-check - discnt-from-check
     3558             ub.chk-pay.time-oper = ub.chk-doc.chk-time
     3559             ub.chk-pay.line-type = "":U
     3560             ub.chk-pay.line-sign =  (if ub.chk-doc.chk-type = integer('1':U)
     3561                                   then (ub.chk-pay.tot-sum >= 0)
     3562                                   else (ub.chk-pay.tot-sum <= 0)
     3563                                   )
     3564             ub.chk-pay.pay-card = pay-card_
     3565             ub.chk-pay.cash-rate = 1
     3566             ub.chk-pay.bank-rate = 1
     3567             ub.chk-pay.bank-scale = 1
     3568             ub.chk-pay.pass-pay  = 0
     3569             ub.chk-pay.is-error = no
     3570             .
     3571           end.
     3572           else do:
     3573             assign
     3574             ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + sum-from-check - discnt-from-check
     3575             .
     3576           end.
     3577         end.
     3578       end.
     3579   end.
     3580   end procedure.
     3581   PROCEDURE get-mar-parameters:
     3582   define input parameter p-read-object as character no-undo .
     3583   define variable v-param-type as character no-undo .
     3584   define variable v-value-character as character no-undo .
     3585   define variable v-value-date as date no-undo .
     3586   define variable v-value-decimal as decimal no-undo .
     3587   define variable v-value-integer as INTEGER no-undo .
     3588   define variable v-value-logical AS LOGICAL no-undo .
     3589   define variable v-tth as handle no-undo .
     3590   if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     3591     run write-log-and-file in p-log-handle (
     3592           input 1
     3593         , input log-file-name
     3594         , input 1
     3595         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен, а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо."
     3596                            , get-chkc_context.obj-type
     3597                            , get-chkc_context.obj-code
     3598                             )).
     3599     assign
     3600     p-view-log = yes
     3601     .
     3602     undo, return "error":U.
     3603   end.
     3604   if get-chkc_context.t-shft > 0 and get-chkc_context.shift-on = yes then do:
     3605     run write-log-and-file in p-log-handle (
     3606           input 1
     3607         , input log-file-name
     3608         , input 1
     3609         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен,&3" +
     3610                             "а настройка СМЕЩЕННЫЕ СМЕНЫ НА КАССЕ&3" +
     3611                             "(АРМ Администратор - Справочники - Магазины - Параметры - время начала пересменки)&3" +
     3612                             "включена - это недопустимо."
     3613                            , get-chkc_context.obj-type
     3614                            , get-chkc_context.obj-code
     3615                            , chr(10)
     3616                             )).
     3617     assign
     3618     p-view-log = yes
     3619     .
     3620     undo, return "error":U.
     3621   end.
     3622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3623     (input  'is-ptrl'
     3624     ,input  0
     3625     ,input  '':U
     3626     ,input  0
     3627     ,input  '':U
     3628     ,input  '':U
     3629     ,input  '':U
     3630     ,input  NO
     3631     ,output conf-par
     3632     ,output par-type
     3633     ) NO-ERROR .
     3634   assign
     3635   is-ptrl = logical(conf-par) no-error .
     3636   if is-wth = yes then do:
     3637   end.
     3638   if LOOKUP(left-trim(p-read-object, '0'), '26,27,28,29,30,31,32,33') > 0 then do:
     3639     accept-types =  "001,002,003":U.
     3640     if is-ptrl
     3641     and ptrl-check then
     3642     assign
     3643     accept-types = accept-types + ",004,005":U.
     3644     assign
     3645     v-petrol-mode = yes.
     3646   end.
     3647   if LOOKUP(left-trim(p-read-object, '0'), '42,43') > 0 then do:
     3648     accept-types =  "001,002,003":U.
     3649   end.
     3650   run adm/shattri.p (
     3651         input "get":U
     3652         ,input  'маг':U
     3653         ,input  p-obj-code
     3654         ,input  'cd-type-maria':U
     3655         ,input  'mariapayg':U
     3656         ,output v-value-character
     3657         ,output v-value-date
     3658         ,output v-value-decimal
     3659         ,output v-value-integer
     3660         ,output v-value-logical
     3661         ,output v-param-type
     3662         ,INPUT-OUTPUT table-handle v-tth
     3663         ) no-error .
     3664   IF not error-status:error then do:
     3665     mariapayg = v-value-character.
     3666     delete object v-tth.
     3667   end.
     3668   else do:
     3669     delete object v-tth.
     3670     return error return-value .
     3671   end.
     3672   run adm/shattri.p (
     3673         input "get":U
     3674         ,input  'маг':U
     3675         ,input  p-obj-code
     3676         ,input  'cd-type-maria':U
     3677         ,input  'mariapayp':U
     3678         ,output v-value-character
     3679         ,output v-value-date
     3680         ,output v-value-decimal
     3681         ,output v-value-integer
     3682         ,output v-value-logical
     3683         ,output v-param-type
     3684         ,INPUT-OUTPUT table-handle v-tth
     3685         ) no-error .
     3686   IF not error-status:error then do:
     3687     mariapayp = v-value-character.
     3688     delete object v-tth.
     3689   end.
     3690   else do:
     3691     delete object v-tth.
     3692     return error return-value .
     3693   end.
     3694   END PROCEDURE.
     3695   procedure process-maria-attr :
     3696   define input parameter p-num-recs as decimal no-undo .
     3697   define variable v-last-date as date no-undo .
     3698   define variable v-last-z-count as integer no-undo .
     3699   define variable v-last-num-recs as integer no-undo .
     3700   define variable v-p-last-date as date no-undo .
     3701   define variable v-p-last-z-count as integer no-undo .
     3702   define variable v-p-last-num-recs as integer no-undo .
     3703   define variable v-old as character no-undo .
     3704   define variable v-new as character no-undo .
     3705   define variable v-new-rel-z-count as integer no-undo .
     3706   define variable v-old-rel-z-count as integer no-undo .
     3707     do
     3708     on error undo, return error
     3709     :
     3710     find first temp-cash-desk where
     3711              temp-cash-desk.cash-num = pay-desk_ no-error.
     3712     if not available temp-cash-desk then do:
     3713       run get-last-check-maria in this-procedure (
     3714                                                               input g#db-num
     3715                                                               ,input p-obj-code
     3716                                                               ,input pay-desk_
     3717                                                               ,output v-last-date
     3718                                                               ,output v-last-z-count
     3719                                                               ,output v-last-num-recs
     3720                                                               ,output v-p-last-date
     3721                                                               ,output v-p-last-z-count
     3722                                                               ,output v-p-last-num-recs
     3723                                                               ) no-error.
     3724       create temp-cash-desk.
     3725       assign
     3726       temp-cash-desk.cash-num = pay-desk_
     3727       temp-cash-desk.last-date = v-last-date
     3728       temp-cash-desk.last-z-count = v-last-z-count
     3729       temp-cash-desk.last-num-recs = v-last-num-recs
     3730       temp-cash-desk.last-p-date = v-p-last-date
     3731       temp-cash-desk.last-p-z-count = v-p-last-z-count
     3732       temp-cash-desk.last-p-num-recs = v-p-last-num-recs
     3733       .
     3734     end.
     3735     assign
     3736     v-old = string(year(temp-cash-desk.last-date), "9999") +
     3737             string(month(temp-cash-desk.last-date), "99") +
     3738             string(day(temp-cash-desk.last-date), "99") +
     3739             string(temp-cash-desk.last-z-count, "99999") +
     3740             string(temp-cash-desk.last-num-recs, "9999.9999") +
     3741             string(year(temp-cash-desk.last-p-date), "9999") +
     3742             string(month(temp-cash-desk.last-p-date), "99") +
     3743             string(day(temp-cash-desk.last-p-date), "99") +
     3744             string(temp-cash-desk.last-p-z-count, "99999") +
     3745             string(temp-cash-desk.last-p-num-recs, "9999")
     3746     .
     3747     if v-petrol-mode then do:
     3748       assign
     3749       v-new = string(year(temp-cash-desk.last-date), "9999") +
     3750               string(month(temp-cash-desk.last-date), "99") +
     3751               string(day(temp-cash-desk.last-date), "99") +
     3752               string(temp-cash-desk.last-z-count, "99999") +
     3753               string(temp-cash-desk.last-num-recs, "9999.9999") +
     3754               (if chk-date_ <> 01/01/1990 then
     3755               (string(year(chk-date_), "9999") +
     3756               string(month(chk-date_), "99") +
     3757               string(day(chk-date_), "99"))
     3758               else
     3759               (string(year(temp-cash-desk.last-p-date), "9999") +
     3760               string(month(temp-cash-desk.last-p-date), "99") +
     3761               string(day(temp-cash-desk.last-p-date), "99")))  +
     3762               string((if v-hundred and z-num_ = 11 then 100 else  z-num_), "99999") +
     3763               string(p-num-recs, "9999")
     3764       .
     3765     end.
     3766     else do:
     3767       assign
     3768       v-new = (if chk-date_ <> 01/01/1990 then
     3769               (string(year(chk-date_), "9999") +
     3770               string(month(chk-date_), "99") +
     3771               string(day(chk-date_), "99"))
     3772               else
     3773               (string(year(temp-cash-desk.last-date), "9999") +
     3774               string(month(temp-cash-desk.last-date), "99") +
     3775               string(day(temp-cash-desk.last-date), "99")))  +
     3776               string((if v-hundred and z-num_ = 11 then 100 else  z-num_), "99999") +
     3777               string(p-num-recs, "9999.9999") +
     3778               string(year(temp-cash-desk.last-p-date), "9999") +
     3779               string(month(temp-cash-desk.last-p-date), "99") +
     3780               string(day(temp-cash-desk.last-p-date), "99") +
     3781               string(temp-cash-desk.last-p-z-count, "99999") +
     3782               string(temp-cash-desk.last-p-num-recs, "9999")
     3783               .
     3784     end.
     3785     if v-new > v-old then do:
     3786       if v-petrol-mode then do:
     3787         assign
     3788         temp-cash-desk.last-p-date      = (if chk-date_ <> 01/01/1990 then chk-date_ else temp-cash-desk.last-p-date)
     3789         temp-cash-desk.last-p-z-count   = (if v-hundred and z-num_ = 11 then 100 else  z-num_)
     3790         temp-cash-desk.last-p-num-recs  = p-num-recs
     3791         .
     3792       end.
     3793       else do:
     3794         assign
     3795         temp-cash-desk.last-date     = (if chk-date_ <> 01/01/1990 then chk-date_ else temp-cash-desk.last-date)
     3796         temp-cash-desk.last-z-count  = (if v-hundred and z-num_ = 11 then 100 else  z-num_)
     3797         temp-cash-desk.last-num-recs = p-num-recs
     3798         .
     3799       end.
     3800     end.
     3801     end.
     3802   end procedure.
     3803   procedure proc-shift :
     3804   define parameter buffer buf_tt-ss for tt-ss.
     3805   define input parameter p-ii as integer no-undo .
     3806   define variable shift-info as character no-undo .
     3807     do
     3808     on error undo, return error return-value
     3809     :
     3810       assign
     3811       pay-desk_ = p-cash-num
     3812       z-num_ = integer(entry(2, buf_tt-ss.n-entry[1], '=':U))
     3813       no-error .
     3814       if error-status:error then do:
     3815         var-file-line-num = tt-ss.rec-no.
     3816         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     3817       end.
     3818       assign
     3819       chk-date_ = 01/01/1990
     3820       .
     3821       if p-ii > 2 then do:
     3822         assign
     3823         shift-num_ = z-num_ modulo 100
     3824         v-hundred = (if shift-num_ = 0
     3825                      or shift-num_ = 100 then yes else no)
     3826         shift-num_ = (if shift-num_ = 0
     3827                      or shift-num_ = 100 then 11 else shift-num_)
     3828         shift-date_ = date(
     3829                           int( substr( buf_tt-ss.n-entry[2], 6, 2 ) ),
     3830                           int( substr( buf_tt-ss.n-entry[2], 8, 2 ) ),
     3831                           int( substr( buf_tt-ss.n-entry[2], 2, 4  ) )
     3832                           )
     3833         shift-open-time_ = int( substr( buf_tt-ss.n-entry[3], 1, 7 ) ) * 3600 + int( substr( buf_tt-ss.n-entry[4], 8, 2 ) ) * 60
     3834         chk-date_ = date(
     3835                           int( substr( buf_tt-ss.n-entry[4], 6, 2 ) ),
     3836                           int( substr( buf_tt-ss.n-entry[4], 8, 2 ) ),
     3837                           int( substr( buf_tt-ss.n-entry[4], 2, 4 ) )
     3838                           )
     3839         chk-time_ =  int( substr( buf_tt-ss.n-entry[5], 1, 7 ) ) * 3600 + int( substr( buf_tt-ss.n-entry[5], 8, 2 ) ) * 60
     3840         no-error
     3841         .
     3842         if error-status:error then do:
     3843           var-file-line-num = buf_tt-ss.rec-no.
     3844           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     3845         end.
     3846       end.
     3847       if get-chkc_context.cas-shft then do:
     3848         if current-pay-desk <> pay-desk_
     3849         or NOT (current-cas-shift-name =  shift-name_
     3850             AND current-cas-shift-date = shift-date_)
     3851         OR not avail buf_shift-cash then do:
     3852   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3853   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_get-cash-shift in g#libchkvl
     3854     (input  buffer get-chkc_context:handle
     3855     ,buffer buf_shift-cash
     3856     ,input  pay-desk_
     3857     ,input  shift-date_
     3858     ,input  shift-name_
     3859     ,input z-num_
     3860     ,input chk-date_
     3861     ,input chk-time_
     3862     ,input shift-open-time_
     3863       ) no-error .
     3864           if available buf_shift-cash then do:
     3865             assign
     3866             current-pay-desk = buf_shift-cash.cash-num
     3867             current-cas-shift-name = buf_shift-cash.shift-name
     3868             current-cas-shift-date = buf_shift-cash.shift-date
     3869             .
     3870           end.
     3871           else do:
     3872             current-pay-desk = -1.
     3873           end.
     3874         end.
     3875       end.
     3876       assign
     3877       pay-desk_ = p-cash-num
     3878       z-num_ = z-num_ + 1
     3879       z-num_ = (if z-num_ = 101 then  1 else z-num_)
     3880       .
     3881       run process-maria-attr in this-procedure ( input 0.0).
     3882     end.
     3883   end procedure.
     3884   procedure tekka-date-time  :
     3885   define input parameter p-tekka-date-time as character no-undo .
     3886   define input parameter p-cash-num as character no-undo .
     3887     do
     3888     on error undo, return error return-value
     3889     :
     3890   define variable v-date as date.
     3891   define variable v-time as integer no-undo .
     3892   define variable v-type as character no-undo .
     3893   define variable v-date-time-info as character no-undo .
     3894   define variable v-value-date as date no-undo .
     3895   define variable v-value-decimal as decimal no-undo .
     3896   define variable v-value-integer as integer no-undo .
     3897   define variable v-value-logical as logical no-undo .
     3898   define variable v-cd-date-time-info as character no-undo .
     3899   assign
     3900   v-date =  date(
     3901             int( substr( p-tekka-date-time, 6, 2 ) ),
     3902             int( substr( p-tekka-date-time, 8, 2 ) ),
     3903             int( substr( p-tekka-date-time, 2, 4 ) )
     3904               )
     3905   v-time =  int( substr( p-tekka-date-time, 16, 2 ) ) * 3600 +
     3906             int( substr( p-tekka-date-time, 18, 2 ) ) * 60
     3907   no-error .
     3908   if error-status:error then return error.
     3909   assign
     3910   v-cd-date-time-info = string(YEAR(v-date), "9999":U) + "-":U +
     3911                string(Month(v-date), "99":U) + "-":U +
     3912                string(DAY(v-date), "99":U) +
     3913                chr(32)  +  string(v-time, "HH:MM:SS":U).
     3914     run cd-attr-value in this-procedure (
     3915                                                             input g#db-num
     3916                                                             ,input p-obj-code
     3917                                                             ,input 'MARIA':U
     3918                                                             ,input integer(p-cash-num)
     3919                                                             ,input 'MARIA_operative':U
     3920                                                             ,input 'data-actuality':U
     3921                                                             ,output v-date-time-info
     3922                                                             ,output v-value-date
     3923                                                             ,output v-value-decimal
     3924                                                             ,output v-value-integer
     3925                                                             ,output v-value-logical
     3926                                                             ,output v-type
     3927                                                             ) no-error.
     3928     if v-date-time-info < v-cd-date-time-info then do:
     3929       run cd-attr-write in this-procedure (
     3930                                             input g#db-num
     3931                                             ,input p-obj-code
     3932                                             ,input 'MARIA':U
     3933                                             ,input integer(p-cash-num)
     3934                                             ,input 'MARIA_operative':U
     3935                                             ,input 'data-actuality':U
     3936                                             ,input v-cd-date-time-info
     3937                                             ,input ?
     3938                                             ,input 0.0
     3939                                             ,input 0
     3940                                             ,input no
     3941                                             ).
     3942     end.
     3943   end.
     3944   end procedure.
