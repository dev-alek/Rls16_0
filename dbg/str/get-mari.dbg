      673   procedure get-last-check-date-time :
      674       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      675       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      676       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      677       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      678       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      679       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      680       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      681       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      682       define variable v-character as character no-undo .
      683       define variable v-date      as date      no-undo .
      684       define variable v-decimal   as decimal   no-undo .
      685       define variable v-integer   as integer   no-undo .
      686       define variable v-logical   as logical   no-undo .
      687       define variable v-attr-type as character no-undo .
      688       define buffer buf_chk-doc     for ub.chk-doc.
      689       define buffer buf_c-cash-desk for ub.c-cash-desk.
      690       do
      691           on error undo, return error
      692           :
      693           run cd-attr-value in this-procedure (
      694               input g#db-num
      695               ,input p-obj-code
      696               ,input p-pos-type
      697               ,input p-cash-num
      698               ,input 'MAGIA-XML_operative':U
      699               ,input 'last-check-date-time':U
      700               ,output v-character
      701               ,output v-date
      702               ,output v-decimal
      703               ,output v-integer
      704               ,output v-logical
      705               ,output v-attr-type     ) no-error.
      706           if v-character = "":U
      707               or v-character = ?
      708               then
      709           do:
      710               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      711                   buf_c-cash-desk.db-num = g#db-num
      712                   AND buf_c-cash-desk.pos-type = p-pos-type
      713                   AND buf_c-cash-desk.cash-num = p-cash-num
      714                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      715                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      716               if available buf_c-cash-desk then
      717               do:
      718                   assign
      719                       p-date = buf_c-cash-desk.corr-date
      720                       p-time = buf_c-cash-desk.corr-time
      721                       .
      722               end.
      723               else
      724               do:
      725                   find first buf_chk-doc no-lock where
      726                       buf_chk-doc.obj-type = 'маг':U
      727                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      728                   if not available buf_chk-doc then
      729                   do:
      730                       return error.
      731                   end.
      732                   assign
      733                       p-date = buf_chk-doc.chk-date - 1
      734                       p-time = buf_chk-doc.chk-time
      735                       .
      736               end.
      737           end.
      738           else
      739           do:
      740               assign
      741                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      742           no-error .
      743               if error-status:error then return error .
      744           end.
      745       end.
      746   end procedure.
      747   procedure get-last-check-params :
      748       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      749       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      750       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      751       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      752       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      753       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      754       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      755       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      756       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      757       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      758       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      759       define variable v-character as character no-undo .
      760       define variable v-date      as date      no-undo .
      761       define variable v-decimal   as decimal   no-undo .
      762       define variable v-integer   as integer   no-undo .
      763       define variable v-logical   as logical   no-undo .
      764       define variable v-attr-type as character no-undo .
      765       define buffer buf_chk-doc     for ub.chk-doc.
      766       define buffer buf_c-cash-desk for ub.c-cash-desk.
      767       do
      768           on error undo, return error
      769           :
      770           run cd-attr-value in this-procedure (
      771               input g#db-num
      772               ,input p-obj-code
      773               ,input p-pos-type
      774               ,input p-cash-num
      775               ,input if p-pos-type eq 'IBM-XML':U
      776               then 'IBM-XML_operative':U
      777               else 'AUTOTANK_operative':U
      778               ,input if p-pos-type = 'IBM-XML':U
      779               then 'last-check-params':U
      780               else 'last-check-params':U
      781               ,output v-character
      782               ,output v-date
      783               ,output v-decimal
      784               ,output v-integer
      785               ,output v-logical
      786               ,output v-attr-type     ) no-error.
      787           if v-character = "":U
      788               or v-character = ?
      789               then
      790           do:
      791               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      792                   buf_c-cash-desk.db-num = g#db-num
      793                   AND buf_c-cash-desk.pos-type = p-pos-type
      794                   AND buf_c-cash-desk.cash-num = p-cash-num
      795                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      796                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      797               if available buf_c-cash-desk then
      798               do:
      799                   assign
      800                       p-date = buf_c-cash-desk.corr-date
      801                       p-time = buf_c-cash-desk.corr-time
      802                       .
      803               end.
      804               else
      805               do:
      806                   find first buf_chk-doc no-lock where
      807                       buf_chk-doc.obj-type = 'маг':U
      808                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      809                   if not available buf_chk-doc then
      810                   do:
      811                       return error.
      812                   end.
      813                   assign
      814                       p-date      = buf_chk-doc.chk-date - 1
      815                       p-time      = buf_chk-doc.chk-time
      816                       p-shift-num = buf_chk-doc.shift-num
      817                       p-z-count   = buf_chk-doc.z-number
      818                       p-chk-num   = buf_chk-doc.chk-num
      819                       .
      820               end.
      821           end.
      822           else
      823           do:
      824               assign
      825                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      826                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      827                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      828                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      829                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      830                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      831           no-error .
      832               if error-status:error then return error .
      833           end.
      834       end.
      835   end procedure.
      836   procedure get-last-report-params :
      837       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      838       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      839       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      840       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      841       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      842       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      843       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      844       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      845       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      846       define variable v-character as character no-undo .
      847       define variable v-date      as date      no-undo .
      848       define variable v-decimal   as decimal   no-undo .
      849       define variable v-integer   as integer   no-undo .
      850       define variable v-logical   as logical   no-undo .
      851       define variable v-date1     as character no-undo .
      852       define variable v-date2     as character no-undo .
      853       define variable v-attr-type as character no-undo .
      854       define buffer buf_chk-slip-head for ub.chk-slip-head.
      855       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      856       do
      857           on error undo, return error
      858           :
      859           run cd-attr-value in this-procedure (
      860               input g#db-num
      861               ,input p-obj-code
      862               ,input p-pos-type
      863               ,input p-cash-num
      864               ,input if p-pos-type eq 'IBM-XML':U
      865               then 'IBM-XML_operative':U
      866               else 'AUTOTANK_operative':U
      867               ,input if p-pos-type = 'IBM-XML':U
      868               then 'last-report-params':U
      869               else 'last-report-params':U
      870               ,output v-character
      871               ,output v-date
      872               ,output v-decimal
      873               ,output v-integer
      874               ,output v-logical
      875               ,output v-attr-type     ) no-error.
      876           if v-character = "":U
      877               or v-character = ?
      878               then
      879           do:
      880               find last buf_chk-slip-head no-lock where
      881                   buf_chk-slip-head.obj-code = p-obj-code
      882                   and buf_chk-slip-head.cash-num = p-cash-num
      883                   and buf_chk-slip-head.db-num = p-db-num
      884                   and buf_chk-slip-head.is-report = 1 no-error.
      885               if not available buf_chk-slip-head then
      886               do:
      887                   return error.
      888               end.
      889               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      890               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      891                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      892                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      893                   + " " + entry(1,v-date2,".") .
      894               assign
      895                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      896                   p-shift-num = buf_chk-slip-head.CashShiftNum
      897                   .
      898           end.
      899           else
      900           do:
      901               assign
      902                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      903                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      904                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      905           no-error .
      906               if error-status:error then return error .
      907           end.
      908       end.
      909   end procedure.
      910   procedure get-last-check-maria :
      911       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      912       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      913       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      914       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      915       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      916       define output parameter p-num-recs as integer no-undo .
      917       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      918       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      919       define output parameter p-p-num-recs as integer no-undo .
      920       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      921       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      922       define variable v-character as character no-undo .
      923       define variable v-date      as date      no-undo .
      924       define variable v-decimal   as decimal   no-undo .
      925       define variable v-integer   as integer   no-undo .
      926       define variable v-logical   as logical   no-undo .
      927       define variable v-attr-type as character no-undo .
      928       define buffer buf_chk-doc     for ub.chk-doc.
      929       define buffer buf_c-cash-desk for ub.c-cash-desk.
      930       do
      931           on error undo, return error
      932           :
      933           run cd-attr-value in this-procedure (
      934               input p-db-num
      935               ,input p-obj-code
      936               ,input 'MARIA':U
      937               ,input p-cash-num
      938               ,input 'MARIA_operative':U
      939               ,input 'last-check-maria':U
      940               ,output v-character
      941               ,output v-date
      942               ,output v-decimal
      943               ,output v-integer
      944               ,output v-logical
      945               ,output v-attr-type     ) no-error.
      946           if v-character = "":U
      947               or v-character = ?
      948               then
      949           do:
      950               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      951                   buf_c-cash-desk.db-num = p-db-num
      952                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      953                   AND buf_c-cash-desk.cash-num = p-cash-num
      954                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      955                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      956               if available buf_c-cash-desk then
      957               do:
      958                   assign
      959                       p-date   = buf_c-cash-desk.corr-date
      960                       p-p-date = buf_c-cash-desk.corr-date
      961                       .
      962               end.
      963               else
      964               do:
      965                   find first buf_chk-doc no-lock where
      966                       buf_chk-doc.obj-type = 'маг':U
      967                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      968                   if not available buf_chk-doc then
      969                   do:
      970                       assign
      971                           p-date       = 01/01/1990
      972                           p-z-count    = 1
      973                           p-num-recs   = 0
      974                           p-p-date     = 01/01/1990
      975                           p-p-z-count  = 1
      976                           p-p-num-recs = 0
      977                           .
      978                   end.
      979                   assign
      980                       p-date       = buf_chk-doc.chk-date - 1
      981                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      982                       p-num-recs   = 0
      983                       p-p-date     = buf_chk-doc.chk-date - 1
      984                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      985                       p-p-num-recs = 0
      986                       .
      987               end.
      988           end.
      989           else
      990           do:
      991               assign
      992                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      993                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      994                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      995                         )
      996                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      997                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      998                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      999                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
     1000                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
     1001                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
     1002                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1003                         )
     1004                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1005                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1006                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1007                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1008           no-error .
     1009               if error-status:error then return error .
     1010           end.
     1011       end.
     1012   end procedure.
