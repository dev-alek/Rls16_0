     1214   procedure alienini-getkey :
     1215   define input parameter i-filename as char.
     1216   define input parameter i-section as char.
     1217   define input parameter i-key as char.
     1218   define output parameter o-value as char.
     1219   define variable EntryPointer as integer no-undo.
     1220   define variable mem1 as memptr no-undo.
     1221   define variable mem2 as memptr no-undo.
     1222   define variable mem1size as integer no-undo.
     1223   define variable mem2size as integer no-undo.
     1224   define variable ii       as integer    no-undo.
     1225   define variable cbReturnSize  as integer    no-undo.
     1226   assign
     1227   set-size(mem1)  = 4000
     1228   mem1size = 4000.
     1229   if i-key = "" then EntryPointer = 0.
     1230   else do:
     1231     assign
     1232     set-size(mem2) = 128
     1233     mem2size = 128
     1234     EntryPointer = get-pointer-value(mem2)
     1235     put-string(mem2, 1) = i-key.
     1236   end.
     1237   run getprivateprofilestringA
     1238                                 (i-section,
     1239                                  EntryPointer,
     1240                                  "",
     1241                                  get-pointer-value(mem1),
     1242                                  input mem1size,
     1243                                  i-filename,
     1244                                  output cbReturnSize).
     1245   do ii = 1 to cbReturnSize:
     1246     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1247                  then o-value + ","
     1248                  else o-value + chr(get-byte(mem1, ii)).
     1249   end.
     1250     set-size(mem1) = 0.
     1251     set-size(mem2) = 0.
     1252   end procedure.
     1253   procedure alienini-putkey :
     1254   define input parameter i-filename as char.
     1255   define input parameter i-section as char.
     1256   define input parameter i-key as char.
     1257   define input parameter i-value as char.
     1258   define variable cbReturnSize as integer.
     1259   run writeprivateprofilestringA
     1260                                  (i-section,
     1261                                   i-key,
     1262                                   i-value,
     1263                                   i-filename,
     1264                                   output cbReturnSize ).
     1265   end procedure.
     1266   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1267     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1268     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1269     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1270     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1271     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1272     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1273     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1274   END PROCEDURE.
     1275   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1276     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1277     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1278     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1279     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1280     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1281   END PROCEDURE.
     1282   define  temp-table temp-tekka-tsk no-undo
     1283   field filename      as character
     1284   field obj-num       as integer
     1285   field obj-name      as character
     1286   field num-records   as integer
     1287   field max-records   as integer
     1288   field min-plu       as integer
     1289   field max-plu       as integer
     1290   field num-fields    as integer
     1291   field task-num      as character
     1292   field by-record     as logical
     1293   field send-get      as character
     1294   field cash-num      as integer
     1295   field cash-num-char as character
     1296   field port-num      as character
     1297   field way           as character
     1298   field is-script     as logical
     1299   field pswd          as character
     1300   field waiting-sek   as integer
     1301   field other-info    as character
     1302   field order-num     as integer
     1303   field secondary     as integer
     1304   field shift-fields  as integer
     1305   field binary        as logical
     1306   field range         as integer
     1307   index pi is unique primary
     1308   filename
     1309   range
     1310   index lpi
     1311   filename
     1312   min-plu
     1313   index gpi
     1314   filename
     1315   max-plu
     1316   index iorder
     1317   order-num
     1318   .
     1319   define  temp-table temp-tekka-schema no-undo
     1320   field obj-num as integer
     1321   field obj-name as character
     1322   field field-num as integer
     1323   field field-name as character
     1324   field num-records as integer
     1325   field size_ as integer
     1326   field host as character
     1327   field progress-type as character
     1328   field custom-type as character
     1329   field start-pos as integer
     1330   field end-pos as integer
     1331   field bin-group as character
     1332   index pi is unique primary
     1333   host obj-num field-num
     1334   .
     1335   define temp-table temp-tekka-record no-undo
     1336   field obj-num as integer
     1337   field plu as integer
     1338   field body as character
     1339   field shift as integer
     1340   index pi is unique primary obj-num plu.
     1341   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1342   define variable v-is-closed-shift-journal as integer no-undo .
     1343   assign
     1344   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1345                               +
     1346                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1347                               +
     1348                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1349   .
     1350   return v-is-closed-shift-journal.
     1351   END FUNCTION.
     1352   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1353   define variable v-is-first-journal as logical no-undo .
     1354   assign
     1355   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1356                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1357                     or (p-journal-num =  integer(entry(1, '17':U)))
     1358                     or (p-journal-num = integer(entry(1, '16':U)))
     1359   .
     1360   return v-is-first-journal.
     1361   END FUNCTION.
     1362   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1363   define variable v-is-petrol-journal as logical no-undo .
     1364   assign
     1365   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1366   return v-is-petrol-journal.
     1367   END FUNCTION.
     1368   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1369   define variable v-max-record-num as integer no-undo .
     1370   assign
     1371   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1372                       then 1489
     1373                       else 2340).
     1374   return v-max-record-num.
     1375   END FUNCTION.
     1376   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1377   define variable v-max-record-num as integer no-undo .
     1378   assign
     1379   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1380                       then 1489 * num-entries('30,31,32,33':U)
     1381                       else 2340 * num-entries('17':U)).
     1382   return v-max-record-num.
     1383   END FUNCTION.
     1384   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1385                                           ,input p-rec-no as integer):
     1386   define variable v-num-recs as integer no-undo .
     1387   if tekka-is-petrol-journal (p-journal-num) then do:
     1388     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1389       assign
     1390       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1391       .
     1392     end.
     1393     else do:
     1394       assign
     1395       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1396       .
     1397     end.
     1398   end.
     1399   else do:
     1400     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1401       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1402         assign
     1403         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1404         .
     1405       end.
     1406       else do:
     1407         assign
     1408         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1409         .
     1410       end.
     1411     end.
     1412     else do:
     1413       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1414         assign
     1415         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1416         .
     1417       end.
     1418       else do:
     1419         assign
     1420         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1421         .
     1422       end.
     1423     end.
     1424   end.
     1425   return v-num-recs.
     1426   END FUNCTION.
     1427   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1428                                              ,input p-is-petrol as logical
     1429                                              ,input p-is-current as logical
     1430                                              ,output p-rec-no as decimal
     1431                                              ):
     1432   define variable v-obj-num0 as integer no-undo .
     1433   define variable v-obj-num as integer no-undo .
     1434   define variable v-obj-num2 as integer no-undo .
     1435   define variable p-num-recs2 as integer no-undo .
     1436   define variable p-rec-no2 as integer no-undo .
     1437   if p-is-petrol then do:
     1438     assign
     1439     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1440     .
     1441     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1442     then
     1443     assign
     1444     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1445     p-rec-no = p-num-recs modulo 1489
     1446     .
     1447     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1448     then
     1449     assign
     1450     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1451     p-rec-no = p-num-recs modulo 1489
     1452     .
     1453   end.
     1454   else do:
     1455     assign
     1456     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1457     p-num-recs = trunc(p-num-recs, 0)
     1458     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1459     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1460     .
     1461     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1462     then
     1463     assign
     1464     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1465     p-rec-no = p-num-recs modulo 2340
     1466     .
     1467     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1468     then
     1469     assign
     1470     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1471     p-rec-no = p-num-recs modulo 2340
     1472     .
     1473     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1474     then
     1475     assign
     1476     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1477     p-rec-no2 = p-num-recs2 modulo 2978
     1478     .
     1479     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1480     then
     1481     assign
     1482     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1483     p-rec-no2 = p-num-recs2 modulo 2978
     1484     .
     1485     assign
     1486     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1487     .
     1488   end.
     1489   if v-obj-num = 0 then v-obj-num = 100.
     1490   return v-obj-num.
     1491   END FUNCTION.
     1492   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1493   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1494   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1495      if p-is-ptrl then
     1496      return integer(entry(1, '26,27,28,29':U)).
     1497      if not p-is-ptrl then
     1498      return integer(entry(1, '16':U)).
     1499   end.
     1500   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1501   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1502   return 0.
     1503   END FUNCTION.
     1504   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1505   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1506   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1507     if p-is-ptrl then
     1508     return integer(entry(1, '26,27,28,29':U)).
     1509     if not p-is-ptrl then
     1510     return integer(entry(1, '16':U)).
     1511   end.
     1512   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1513   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1514   return 0.
     1515   END FUNCTION.
     1516   procedure tekkatsk-verify-schema :
     1517   define input parameter p-obj-list as character no-undo .
     1518   define input parameter p-dir-path as character no-undo .
     1519   define variable v-obj-num as integer no-undo .
     1520   define variable v-obj-name as character no-undo .
     1521   define variable v-num-records as integer no-undo .
     1522   define variable v-size_ as integer no-undo .
     1523   define variable v-value as character no-undo .
     1524   define variable ii as integer no-undo .
     1525   define variable jj as integer no-undo .
     1526   define variable ii-ibs as integer no-undo .
     1527   define variable ii-tekka as integer no-undo .
     1528   define variable v-result as character no-undo .
     1529   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1530   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1531     do
     1532     on error undo, return error
     1533     :
     1534        for each buf_temp-tekka-schema:
     1535          delete buf_temp-tekka-schema.
     1536        end.
     1537        input from value('tekkasch.d').
     1538        repeat :
     1539          create buf_temp-tekka-schema.
     1540          import buf_temp-tekka-schema.
     1541          assign
     1542          buf_temp-tekka-schema.host = 'IBS'
     1543          ii = ii + 1.
     1544          .
     1545        end.
     1546        input close.
     1547        ii-ibs = ii.
     1548         _ii:
     1549         do ii = 1 to 256:
     1550           if p-obj-list = "ALL"
     1551           or lookup(string(ii), p-obj-list) > 0 then do:
     1552             assign
     1553             v-obj-num = 0
     1554             v-obj-name = ''
     1555             v-num-records = 0
     1556             v-size_ = 0
     1557             .
     1558             run alienini-getkey in this-procedure (
     1559                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1560                                                     ,input ('obj' + string(ii, '999'))
     1561                                                     ,input 'oname'
     1562                                                     ,output v-value) no-error .
     1563             if v-value = ? then next _ii.
     1564             assign
     1565             v-obj-num = ii
     1566             v-obj-name = v-value
     1567             .
     1568             run alienini-getkey in this-procedure (
     1569                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1570                                                     ,input ('obj' + string(ii, '999'))
     1571                                                     ,input 'size'
     1572                                                     ,output v-value) no-error .
     1573             assign
     1574             v-num-records = integer(v-value) no-error  .
     1575             if error-status:error
     1576             or v-num-records = 0 then next _ii.
     1577             run alienini-getkey in this-procedure (
     1578                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1579                                                     ,input 'obj' + string(ii, '999')
     1580                                                     ,input 'f000'
     1581                                                     ,output v-value) no-error .
     1582             assign
     1583             v-size_ = integer(v-value) no-error  .
     1584             if error-status:error
     1585             or v-size_ = 0 then next _ii.
     1586             _jj:
     1587             do jj = 1 to 256:
     1588               run alienini-getkey in this-procedure (
     1589                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1590                                                       ,input 'obj' + string(ii, '999')
     1591                                                       ,input 'f' + string(jj, '999')
     1592                                                       ,output v-value) no-error .
     1593               if v-value = ? then next _ii.
     1594               create buf_temp-tekka-schema.
     1595               assign
     1596               buf_temp-tekka-schema.host = 'tekka'
     1597               buf_temp-tekka-schema.obj-num = v-obj-num
     1598               buf_temp-tekka-schema.obj-name = v-obj-name
     1599               buf_temp-tekka-schema.num-records = v-num-records
     1600               buf_temp-tekka-schema.size_ = v-size_
     1601               buf_temp-tekka-schema.field-num = jj
     1602               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     1603               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     1604                                                  then entry(2, entry(2, v-value, '#'), ':')
     1605                                                  else '':U)
     1606               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     1607               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     1608               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     1609                                                           , 'C,I,I,I,D,D,D,D,D':U)
     1610               no-error
     1611               .
     1612               if error-status:error then do:
     1613                 delete buf_temp-tekka-schema.
     1614                 next _jj.
     1615               end.
     1616               run alienini-getkey in this-procedure (
     1617                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1618                                                       ,input 'obj' + string(ii, '999') + 'name'
     1619                                                       ,input 'n' + string(jj, '999')
     1620                                                       ,output v-value) no-error .
     1621               if v-value <> ? then
     1622               buf_temp-tekka-schema.field-name = v-value.
     1623             end.
     1624           end.
     1625         end.
     1626         ii-tekka = ii - 1.
     1627        if p-obj-list <> 'ALL' then do:
     1628         if ii-tekka <> ii-ibs then do:
     1629           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     1630                                   , ii-ibs
     1631                                   , ii-tekka).
     1632         end.
     1633        end.
     1634        for each buf_temp-tekka-schema where
     1635               buf_temp-tekka-schema.host = 'tekka':
     1636          find first buf2_temp-tekka-schema where
     1637                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     1638                AND buf2_temp-tekka-schema.host = 'ibs'
     1639                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     1640          if not available buf2_temp-tekka-schema then do:
     1641           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     1642                                   , buf_temp-tekka-schema.field-num
     1643                                   , buf_temp-tekka-schema.obj-num).
     1644          end.
     1645          buffer-compare buf_temp-tekka-schema
     1646          to buf2_temp-tekka-schema
     1647          save result in v-result.
     1648          if v-result <> '':U then do:
     1649           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     1650                                   , buf_temp-tekka-schema.field-num
     1651                                   , buf_temp-tekka-schema.obj-num).
     1652          end.
     1653        end.
     1654     end.
     1655   end procedure.
     1656   FUNCTION set-Sx returns character (input p-string as character):
     1657   return p-string.
     1658   END FUNCTION.
     1659   FUNCTION get-Sx returns character (input p-string  as character):
     1660   return p-string.
     1661   END FUNCTION.
     1662   FUNCTION set-B returns character (input p-string  as character):
     1663   return chr(integer(p-string)).
     1664   END FUNCTION.
     1665   FUNCTION get-B returns character (input p-string  as character):
     1666   return string(asc(p-string)).
     1667   END FUNCTION.
     1668   FUNCTION set-BF returns character (input p-string  as character):
     1669   define variable v-dopi as integer no-undo .
     1670   define variable ii as integer no-undo .
     1671   do ii = 1 to 8:
     1672     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1673   end.
     1674   return chr(v-dopi).
     1675   END FUNCTION.
     1676   FUNCTION get-BF returns character (input p-string  as character):
     1677   define variable v-dopi as integer no-undo .
     1678   define variable v-dops as character no-undo .
     1679   define variable ii as integer no-undo .
     1680   v-dopi = asc(p-string).
     1681   do ii = 8 to 1 BY -1:
     1682     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1683   end.
     1684   return v-dops.
     1685   END FUNCTION.
     1686   FUNCTION set-BN returns character (input p-string  as character
     1687                                     ,input p-bin-group as character):
     1688   define variable v-dopi as integer no-undo .
     1689   define variable ii as integer no-undo .
     1690   define variable jj as integer no-undo .
     1691   define variable v-grp-nums as integer no-undo .
     1692   define variable v-dopi2 as integer no-undo .
     1693   v-grp-nums = num-entries(p-bin-group).
     1694   do jj = 0 to v-grp-nums - 1:
     1695     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     1696     do ii = 1 to 8:
     1697       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1698     end.
     1699   end.
     1700   return chr(v-dopi).
     1701   END FUNCTION.
     1702   FUNCTION get-BN returns character (input p-string  as character
     1703                                     ,input p-bin-group as character):
     1704   define variable v-dopi as integer no-undo .
     1705   define variable v-dops as character no-undo .
     1706   define variable v-grp-nums as integer no-undo .
     1707   define variable ii as integer no-undo .
     1708   define variable jj as integer no-undo .
     1709   v-dopi = asc(p-string).
     1710   v-grp-nums = num-entries(p-bin-group).
     1711   do jj = 1 to v-grp-nums:
     1712   do ii = 8 to 1 BY -1:
     1713     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1714   end.
     1715   end.
     1716   return v-dops.
     1717   END FUNCTION.
     1718   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   procedure cur-time :
     1721      define output parameter p-today as date      no-undo .
     1722      define output parameter p-time  as integer   no-undo .
     1723     do
     1724     on error undo, return error
     1725     :
     1726       define variable v-date1 as date      no-undo .
     1727       define variable v-date2 as date      no-undo .
     1728       define variable v-time  as integer   no-undo .
     1729       assign
     1730         v-date1 = today
     1731         v-time  = time
     1732         v-date2 = today
     1733       .
     1734       if v-date1 <> v-date2
     1735       then do:
     1736         assign
     1737           v-date1 = today
     1738           v-time  = v-time
     1739         .
     1740       end.
     1741       assign
     1742         p-today = v-date1
     1743         p-time  = v-time
     1744       .
     1745     end.
     1746   end.
     1747   function cur-time-date returns character
     1748   :
     1749     return string(today, '99/99/9999':U) .
     1750   end.
     1751   function cur-time-mjd returns decimal
     1752   :
     1753     define variable v-date as date      no-undo .
     1754     define variable v-time as integer   no-undo .
     1755     run cur-time in this-procedure
     1756       (output v-date
     1757       ,output v-time
     1758       ) .
     1759     return integer(v-date) - 2400002 + (v-time / 86400) .
     1760   end.
     1761   function cur-time-get-ending-index returns integer
     1762   (input p-number as integer
     1763   )
     1764   :
     1765     if p-number < 0
     1766     or p-number = ?
     1767     then do:
     1768       return 1 .
     1769     end.
     1770     define variable v-rest as integer   no-undo .
     1771     assign
     1772       p-number = p-number modulo 100
     1773     .
     1774     if p-number < 20
     1775     then do:
     1776       assign
     1777         v-rest = p-number
     1778       .
     1779     end.
     1780     else do:
     1781       assign
     1782         v-rest = p-number modulo 10
     1783       .
     1784     end.
     1785     case v-rest :
     1786       when 1
     1787       then do:
     1788         return 2 .
     1789       end.
     1790       when 2 or
     1791       when 3 or
     1792       when 4
     1793       then do:
     1794         return 3 .
     1795       end.
     1796       otherwise do:
     1797         return 1 .
     1798       end.
     1799     end case .
     1800   end.
     1801   procedure cur-time-mjd-to-date :
     1802      define input  parameter i-mjd-diff as decimal no-undo.
     1803      define output parameter o-Date     as date    no-undo.
     1804      define output parameter o-Time     as integer no-undo.
     1805      define variable v-day-number as integer   no-undo .
     1806      if    i-mjd-diff < 0
     1807         or i-mjd-diff = ?
     1808      then do:
     1809         return "?" .
     1810      end.
     1811      assign
     1812         v-day-number = truncate(i-mjd-diff,0).
     1813         o-Date = date(v-day-number + 2400002).
     1814         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1815     .
     1816   end.
     1817   function cur-time-mjd-to-string returns character
     1818   (input p-mjd-diff as decimal
     1819   )
     1820   :
     1821     define variable v-day-number as integer   no-undo .
     1822     define variable v-seconds    as integer   no-undo .
     1823     define variable v-hour       as integer   no-undo .
     1824     define variable v-min        as integer   no-undo .
     1825     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1826     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1827     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1828     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1829     if p-mjd-diff < 0
     1830     or p-mjd-diff = ?
     1831     then do:
     1832       return "?" .
     1833     end.
     1834     assign
     1835       v-day-number = integer(truncate(p-mjd-diff,0))
     1836       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1837     .
     1838     if v-seconds > 86400
     1839     then do:
     1840       assign
     1841         v-seconds = 86400 - 1
     1842       .
     1843     end.
     1844     if v-seconds < 0
     1845     then do:
     1846       assign
     1847         v-seconds = 0
     1848       .
     1849     end.
     1850     assign
     1851       v-hour = truncate(v-seconds / 3600, 0)
     1852     .
     1853     assign
     1854       v-seconds = v-seconds modulo 3600
     1855     .
     1856     assign
     1857       v-min = truncate(v-seconds / 60, 0)
     1858     .
     1859     assign
     1860       v-seconds = v-seconds modulo 60
     1861     .
     1862     return
     1863         (if v-day-number <> 0
     1864           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1865           else ""
     1866         )
     1867       + (if v-day-number <> 0 or v-hour <> 0
     1868           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1869           else ""
     1870         )
     1871       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1872           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1873           else ""
     1874         )
     1875       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1876       .
     1877   end.
     1878   function cur-time-string returns character
     1879   :
     1880     define variable v-date as date      no-undo .
     1881     define variable v-time as integer   no-undo .
     1882     run cur-time in this-procedure
     1883       (output v-date
     1884       ,output v-time
     1885       ) .
     1886     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1887   end.
     1888   function cur-time-string-sec returns character
     1889   :
     1890     define variable v-date as date      no-undo .
     1891     define variable v-time as integer   no-undo .
     1892     run cur-time in this-procedure
     1893       (output v-date
     1894       ,output v-time
     1895       ) .
     1896     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1897   end.
     1898   function cur-time-custom  returns character
     1899   (input p-prefix as character
     1900   ,input p-date-format as character
     1901   ,input p-delimiter as character
     1902   ,input p-time-format as character
     1903   ,input p-suffix as character
     1904   )
     1905   :
     1906     define variable v-date as date      no-undo .
     1907     define variable v-time as integer   no-undo .
     1908     run cur-time in this-procedure
     1909       (output v-date
     1910       ,output v-time
     1911       ) .
     1912     return
     1913       p-prefix
     1914       + string(v-date, p-date-format)
     1915       + p-delimiter
     1916       + string(v-time, p-time-format)
     1917       + p-suffix
     1918       .
     1919   end.
     1920   function cur-time-print  returns character
     1921   :
     1922     define variable v-date as date      no-undo .
     1923     define variable v-time as integer   no-undo .
     1924     run cur-time in this-procedure
     1925       (output v-date
     1926       ,output v-time
     1927       ) .
     1928     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1929   end.
     1930   function cur-time-datetime returns datetime
     1931   :
     1932     define variable v-char as character no-undo .
     1933     define variable v-datetime as datetime no-undo .
     1934     v-char = cur-time-string().
     1935     v-datetime = datetime(v-char).
     1936     return  v-datetime.
     1937   end.
     1938   function cur-time-string-msec returns character
     1939   :
     1940     define variable v-date as datetime  no-undo .
     1941     v-date = now.
     1942     return string(v-date) .
     1943   end.
     1944   procedure cp-attr-code :
     1945     do
     1946     on error undo, return error
     1947     :
     1948       define input  parameter p-code           as character no-undo .
     1949       define output parameter p-type           as character no-undo .
     1950       define output parameter p-format         as character no-undo .
     1951       define output parameter p-label          as character no-undo .
     1952       define output parameter p-range          as integer   no-undo .
     1953       define output parameter p-user-can-edit  as logical   no-undo .
     1954       define output parameter p-output-display as logical   no-undo .
     1955       define output parameter p-other          as character no-undo .
     1956       case p-code :
     1957               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1958               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1959               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1960               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1961               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1962               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1963               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1964               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1965               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1966               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1967         otherwise do:
     1968           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1969         end.
     1970       end.
     1971     end.
     1972   end procedure.
     1973   procedure cp-attr-tooltip :
     1974     do
     1975     on error undo, return error
     1976     :
     1977       define input  parameter p-code    as character no-undo .
     1978       define output parameter p-tooltip as character no-undo .
     1979       define output parameter p-label   as character no-undo .
     1980       case p-code :
     1981               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1982               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1983               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1984               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1985               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1986               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1987               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1988               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1989               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1990               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1991         otherwise do:
     1992           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1993         end.
     1994       end.
     1995     end.
     1996   end procedure.
     1997   procedure cp-attr-value :
     1998     do
     1999     on error undo, return error
     2000     :
     2001       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2002       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2003       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2004       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2005       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2006       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     2007       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     2008       define output parameter p-type        as character no-undo .
     2009       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2010       define variable v-format         as character no-undo .
     2011       define variable v-label          as character no-undo .
     2012       define variable v-range          as integer   no-undo .
     2013       define variable v-user-can-edit  as logical   no-undo .
     2014       define variable v-output-display as logical   no-undo .
     2015       define variable v-other          as character no-undo .
     2016       run cp-attr-code in this-procedure
     2017         (input  p-code
     2018         ,output p-type
     2019         ,output v-format
     2020         ,output v-label
     2021         ,output v-range
     2022         ,output v-user-can-edit
     2023         ,output v-output-display
     2024         ,output v-other
     2025         ) no-error .
     2026       if error-status :error then do:
     2027         undo, return error return-value .
     2028       end.
     2029       find first buf_cash-pay-attr no-lock
     2030         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2031           and buf_cash-pay-attr.curr-code  = p-curr-code
     2032           and buf_cash-pay-attr.host-code  = p-host-code
     2033           and buf_cash-pay-attr.obj-type   = p-obj-type
     2034           and buf_cash-pay-attr.obj-code   = p-obj-code
     2035           and buf_cash-pay-attr.attr-code  = p-code
     2036         no-error .
     2037       if avail buf_cash-pay-attr then do:
     2038         assign
     2039           p-value =  buf_cash-pay-attr.attr-value
     2040         .
     2041       end.
     2042       else do:
     2043         assign
     2044           p-value = if p-type = 'L':U then "no":U else ""
     2045         .
     2046       end.
     2047     end.
     2048   end procedure.
     2049   procedure cp-attr-write :
     2050     do
     2051     on error undo, return error
     2052     :
     2053       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2054       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2055       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2056       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2057       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2058       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2059       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2060       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2061       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2062       define variable v-type           as character no-undo .
     2063       define variable v-format         as character no-undo .
     2064       define variable v-label          as character no-undo .
     2065       define variable v-range          as integer   no-undo .
     2066       define variable v-user-can-edit  as logical   no-undo .
     2067       define variable v-output-display as logical   no-undo .
     2068       define variable v-other          as character no-undo .
     2069       run cp-attr-code in this-procedure
     2070         (input  p-code
     2071         ,output v-type
     2072         ,output v-format
     2073         ,output v-label
     2074         ,output v-range
     2075         ,output v-user-can-edit
     2076         ,output v-output-display
     2077         ,output v-other
     2078         ) no-error .
     2079       if error-status :error then do:
     2080         undo, return error return-value .
     2081       end.
     2082       find first buf_cash-pay-attr exclusive-lock
     2083         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2084           and buf_cash-pay-attr.curr-code  = p-curr-code
     2085           and buf_cash-pay-attr.host-code  = p-host-code
     2086           and buf_cash-pay-attr.obj-type   = p-obj-type
     2087           and buf_cash-pay-attr.obj-code   = p-obj-code
     2088           and buf_cash-pay-attr.attr-code = p-code
     2089         no-error .
     2090       if not available buf_cash-pay-attr then do:
     2091         create buf_cash-pay-attr .
     2092         assign
     2093         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2094         buf_cash-pay-attr.curr-code  = p-curr-code
     2095         buf_cash-pay-attr.host-code  = p-host-code
     2096         buf_cash-pay-attr.obj-type   = p-obj-type
     2097         buf_cash-pay-attr.obj-code   = p-obj-code
     2098         buf_cash-pay-attr.attr-code = p-code
     2099         .
     2100       end.
     2101       assign
     2102         buf_cash-pay-attr.attr-value = p-value
     2103       .
     2104       release buf_cash-pay-attr no-error .
     2105       if error-status:error then do:
     2106         undo, return error return-value .
     2107       end.
     2108     end.
     2109   end procedure.
     2110   procedure cp-attr-exist :
