     2213       case p-code :
     2214               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     2215               when 'grp-code':U then do:     assign     p-news = true.   end.
     2216               when 'is-use':U then do:     assign     p-news = true.   end.
     2217               when 'dop-doc':U then do:     assign     p-news = true.   end.
     2218               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     2219               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     2220               when 'form_km3':U then do:     assign     p-news = false.   end.
     2221               when 'bal_malina':U then do:     assign     p-news = false.   end.
     2222               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     2223               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     2224         otherwise do:
