     2154   end procedure.
     2155   procedure cp-attr-delete :
     2156     do
     2157     on error undo, return error
     2158     :
     2159       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2160       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2161       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2162       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2163       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2164       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2165       define output parameter p-deleted  as logical no-undo.
     2166       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2167       define variable v-type           as character no-undo .
     2168       define variable v-format         as character no-undo .
     2169       define variable v-label          as character no-undo .
     2170       define variable v-range          as integer   no-undo .
     2171       define variable v-user-can-edit  as logical   no-undo .
     2172       define variable v-output-display as logical   no-undo .
     2173       define variable v-other          as character no-undo .
     2174       run cp-attr-code in this-procedure
     2175         (input  p-code
     2176         ,output v-type
     2177         ,output v-format
     2178         ,output v-label
     2179         ,output v-range
     2180         ,output v-user-can-edit
     2181         ,output v-output-display
     2182         ,output v-other
     2183         ) no-error .
     2184       if error-status :error then do:
     2185         undo, return error return-value .
     2186       end.
     2187       find first buf_cash-pay-attr exclusive-lock
     2188         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2189           and buf_cash-pay-attr.curr-code  = p-curr-code
     2190           and buf_cash-pay-attr.host-code  = p-host-code
     2191           and buf_cash-pay-attr.obj-type   = p-obj-type
     2192           and buf_cash-pay-attr.obj-code   = p-obj-code
     2193           and buf_cash-pay-attr.attr-code = p-code
     2194         no-error NO-WAIT.
     2195       if not available buf_cash-pay-attr then do:
     2196         p-deleted = no.
     2197       end.
     2198       else do:
     2199         delete buf_cash-pay-attr no-error .
     2200         if error-status:error then do:
     2201           undo, return error return-value .
     2202         end.
     2203         p-deleted = yes.
     2204       end.
     2205     end.
     2206   end procedure.
     2207   procedure cp-attr-news :
     2208     do
     2209     on error undo, return error
     2210     :
     2211       define input  parameter p-code           as character no-undo .
