        1   define input parameter p-fbrhist-handle     as widget-handle    no-undo.
        2   define input parameter p-line-mode          as character        no-undo.
        3   define input parameter p-fbr-doc-doc-code   as character        no-undo.
        4   define input parameter p-fbr-line-recid     as recid            no-undo.
        5   define input parameter p-mark-qnty          as decimal          no-undo.
        6   define output parameter p-cancel            as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Работа со строкой составного товара в производстве".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define buffer f-doc for fbr-doc.
      128   DEFINE BUTTON b-exit AUTO-GO
      129        LABEL "&Ввод "
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON b-help
      133        LABEL "Помо&щь"
      134        SIZE 3 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE VARIABLE avail-qnty AS DECIMAL FORMAT "->>>,>>9.999":U INITIAL 0
      141        LABEL "Допустимо"
      142        VIEW-AS FILL-IN
      143        SIZE 14 BY 1.08
      144        FGCOLOR 4  NO-UNDO.
      145   DEFINE RECTANGLE RECT-1
      146        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      147        SIZE 75 BY 3.13.
      148   DEFINE RECTANGLE RECT-2
      149        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      150        SIZE 75 BY 2.04.
      151   DEFINE FRAME d-fbr-line
      152        b-help AT ROW 1 COL 73.5
      153        b-exit AT ROW 1.13 COL 1.63
      154        b-quit AT ROW 1.13 COL 11.88
      155        ub.fbr-line.artic AT ROW 3.54 COL 16.25 COLON-ALIGNED
      156             LABEL "Артикул"
      157             VIEW-AS FILL-IN
      158             SIZE 15 BY 1.08
      159        ub.goods.gds-name AT ROW 3.58 COL 31.13 COLON-ALIGNED NO-LABEL
      160             VIEW-AS FILL-IN
      161             SIZE 42.5 BY 1.08
      162             FGCOLOR 4
      163        ub.fbr-line.prod-code AT ROW 4.71 COL 16.25 COLON-ALIGNED
      164             LABEL "Производитель"
      165             VIEW-AS FILL-IN
      166             SIZE 8.38 BY 1.08
      167        ub.fbr-line.prod-type AT ROW 4.71 COL 24.75 COLON-ALIGNED NO-LABEL
      168             VIEW-AS FILL-IN
      169             SIZE 6.25 BY 1.08
      170        ub.clients.obj-name AT ROW 4.75 COL 31.13 COLON-ALIGNED NO-LABEL
      171             VIEW-AS FILL-IN
      172             SIZE 42.63 BY 1.08
      173             FGCOLOR 4
      174        ub.fbr-line.recipe-code AT ROW 6.96 COL 16.38 COLON-ALIGNED
      175             LABEL "Рецепт"
      176             VIEW-AS FILL-IN
      177             SIZE 11 BY 1.08
      178        ub.recipe.recipe-name AT ROW 6.96 COL 27.25 COLON-ALIGNED NO-LABEL
      179             VIEW-AS FILL-IN
      180             SIZE 46.63 BY 1.08
      181             FGCOLOR 4
      182        ub.fbr-line.fact-qnty AT ROW 9.58 COL 16.63 COLON-ALIGNED
      183             LABEL "&Количество" FORMAT ">>,>>>,>>9.999"
      184             VIEW-AS FILL-IN
      185             SIZE 11 BY 1.08
      186        ub.goods.unit-base AT ROW 9.58 COL 27.5 COLON-ALIGNED HELP
      187             "" NO-LABEL
      188             VIEW-AS FILL-IN
      189             SIZE 6 BY 1.08
      190             FGCOLOR 4
      191        avail-qnty AT ROW 9.58 COL 45 COLON-ALIGNED
      192        ub.fbr-line.price-sale AT ROW 11.13 COL 45.25 COLON-ALIGNED HELP
      193             ""
      194             LABEL "&Цена продажи" FORMAT ">>>,>>>,>>9.99"
      195             VIEW-AS FILL-IN
      196             SIZE 19.25 BY 1.08
      197        ub.fbr-line.price-base AT ROW 13.08 COL 45.25 COLON-ALIGNED HELP
      198             ""
      199             LABEL "Учет. цена (&баз.вал)" FORMAT ">>>,>>>,>>9.9999999999"
      200             VIEW-AS FILL-IN
      201             SIZE 19.25 BY 1.08
      202        ub.fbr-line.price-rubl AT ROW 14.29 COL 45.25 COLON-ALIGNED HELP
      203             ""
      204             LABEL "Учет. цена " FORMAT ">>>,>>>,>>9.9999999999"
      205             VIEW-AS FILL-IN
      206             SIZE 19.25 BY 1.08
      207        RECT-2 AT ROW 6.58 COL 2
      208        RECT-1 AT ROW 3.13 COL 2
      209        SPACE(0.74) SKIP(10.15)
      210       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      211            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      212            TITLE ""
      213            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      214   ASSIGN
      215          FRAME d-fbr-line:SCROLLABLE       = FALSE
      216          FRAME d-fbr-line:HIDDEN           = TRUE.
      217   ON WINDOW-CLOSE OF FRAME d-fbr-line
      218   DO:
      219     APPLY "END-ERROR":U TO SELF.
      220   END.
      221   ON CHOOSE OF b-exit IN FRAME d-fbr-line
      222   DO:
      223   def buffer b-fbr-line for fbr-line.
      224       if input frame d-fbr-line fbr-line.fact-qnty <= 0
      225       then do:
      226           message
      227               "Количество товара введено неверно."
      228               skip(1) "Введите количество или отмените добавление товара."
      229           view-as alert-box information
      230           title "Неверное количество".
      231           undo, return no-apply.
      232       end.
      233       else do:
      234           assign
      235               fbr-line.fact-qnty
      236           .
      237           if input frame d-fbr-line fbr-line.price-sale <> fbr-line.price-sale
      238           and f-doc.status_ = 'новый':U
      239           then do:
      240               for each b-fbr-line
      241                  where b-fbr-line.doc-code  = f-doc.doc-code
      242                    and b-fbr-line.artic     = fbr-line.artic
      243                    and b-fbr-line.prod-type = fbr-line.prod-type
      244                    and b-fbr-line.prod-code = fbr-line.prod-code
      245               on error undo, return no-apply
      246               :
      247                       assign
      248                           b-fbr-line.price-sale = input frame d-fbr-line fbr-line.price-sale
      249                           b-fbr-line.is-calc = yes
      250                       .
      251               end.
      252           end.
      253       end.
      254   END.
      255   ON CHOOSE OF b-quit IN FRAME d-fbr-line
      256   DO:
      257       assign
      258           p-cancel = yes
      259       .
      260   END.
      261   ON RETURN OF ub.fbr-line.fact-qnty IN FRAME d-fbr-line
      262   DO:
      263     apply "choose" to b-exit in frame d-fbr-line.
      264     return no-apply.
      265   END.
      266   ON RETURN OF ub.fbr-line.price-base IN FRAME d-fbr-line
      267   DO:
      268     apply "entry" to fbr-line.price-rubl in frame d-fbr-line.
      269     return no-apply.
      270   END.
      271   ON RETURN OF ub.fbr-line.price-rubl IN FRAME d-fbr-line
      272   DO:
      273     apply "entry" to b-exit in frame d-fbr-line.
      274     return no-apply.
      275   END.
      276   ON RETURN OF ub.fbr-line.price-sale IN FRAME d-fbr-line
      277   DO:
      278     apply "entry" to b-exit in frame d-fbr-line.
      279     return no-apply.
      280   END.
      281   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-fbr-line:PARENT eq ?
      282   THEN FRAME d-fbr-line:PARENT = ACTIVE-WINDOW.
      283   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   on help of frame d-fbr-line
      285   do:
      286     run gbl/app_help.p
      287       (input this-procedure :file-name
      288       ,input ''
      289       ,input ?
      290       ) no-error.
      291     if error-status :error then do:
      292       message
      293         "Ошибка при вызове помощи"
      294         error-status :get-message(1)
      295         view-as alert-box .
      296     end.
      297   end.
      298   run minbtn-set in this-procedure .
      299   on choose of b-help in frame d-fbr-line
      300   do:
      301     apply "help":u to frame d-fbr-line .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure minbtn-set :
      305       do
      306           on error undo, return error return-value
      307           :
      308           define variable ii              as integer       no-undo .
      309           define variable fh              as widget-handle no-undo .
      310           define variable hh              as widget-handle no-undo .
      311           define variable v-h             as handle        extent 4 no-undo .
      312           define variable v-name-button   as character     no-undo .
      313           define variable v-help-old-x    as decimal       no-undo .
      314           define variable v-help-old-y    as decimal       no-undo .
      315           define variable v-help-old-size as decimal       no-undo .
      316           define variable v-frame-width   as decimal       no-undo .
      317           define variable jj              as integer       no-undo .
      318           do
      319               on error undo, return error
      320               :
      321               assign
      322                   v-frame-width = frame d-fbr-line:width - 0.3
      323                   fh            = frame d-fbr-line:first-child
      324                   hh            = fh:first-child
      325                   ii            = 1
      326                   .
      327               do while valid-handle(hh):
      328                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      329                   do:
      330                       case lc(hh:name) :
      331                           when "b-help" then
      332                               do:
      333                                   hh:load-image-up("cmp/b-help.bmp":u) .
      334                                   hh:load-image-down("cmp/b-help.bmp":u) .
      335                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      336                                   hh:TOOLTIP = "Помощь" .
      337                                   v-help-old-x = hh:column .
      338                                   v-help-old-y = hh:row    .
      339                                   v-help-old-size = hh:width .
      340                                   hh:width-chars = 2.5 .
      341                               end.
      342                           when "b-print" then
      343                               do:
      344                                   hh:load-image("cmp/b-print.bmp":u) .
      345                                   hh:TOOLTIP = "Печать" .
      346                                   v-h[ii] = hh:handle .
      347                                   ii = ii + 1 .
      348                                   hh:width-chars = 3 .
      349                               end.
      350                           when "b-history" or
      351                           when "b-hist" then
      352                               do:
      353                                   hh:load-image("cmp/b-hist.bmp":u) .
      354                                   hh:TOOLTIP = "История" .
      355                                   v-h[ii] = hh:handle .
      356                                   ii = ii + 1 .
      357                                   hh:width-chars = 3 .
      358                               end.
      359                           when "b-sch" then
      360                               do:
      361                                   hh:load-image("cmp/b-sch.bmp":u) .
      362                                   hh:TOOLTIP = "Установка Фильтра" .
      363                                   v-h[ii] = hh:handle .
      364                                   ii = ii + 1 .
      365                                   hh:width-chars = 3 .
      366                               end.
      367                           when "b-hist-user" then
      368                               do:
      369                                   hh:load-image("cmp/b-hist.bmp":u) .
      370                                   hh:TOOLTIP = "История пользователя" .
      371                                   ii = ii + 1 .
      372                               end.
      373                       end case.
      374                   end.
      375                   hh = hh:next-sibling.
      376               end.
      377               b-help:column = v-frame-width - b-help:width-chars.
      378               jj = 0.
      379               repeat ii = 4 to 1 by -1 :
      380                   if valid-handle (v-h[ii] ) then
      381                   do:
      382                       jj  = jj + 1 .
      383                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      384                       v-h[ii]:row    = v-help-old-y .
      385                   end.
      386               end.
      387           end.
      388       end.
      389   end procedure.
      390   MAIN-BLOCK:
      391   DO
      392   ON ERROR UNDO MAIN-BLOCK, return error
      393   :
      394        fbr-line.price-rubl:label = "Учет. цена (руб)" .
      395       VIEW FRAME d-fbr-line.
      396       find first f-doc no-lock
      397            where f-doc.doc-code = p-fbr-doc-doc-code
      398       .
      399       frame d-fbr-line :title = "Производство № " + f-doc.doc-code + "       "
      400                                       + f-doc.status_ + "      - " + p-line-mode .
      401       enable
      402           b-quit
      403           b-help
      404       with frame d-fbr-line.
      405       if p-line-mode = 'ПРОСМОТР':U
      406       then do:
      407           find first fbr-line no-lock
      408               where recid( fbr-line ) = p-fbr-line-recid
      409           .
      410       end.
      411       else do:
      412           find first fbr-line exclusive-lock
      413               where recid( fbr-line ) = p-fbr-line-recid
      414           .
      415       end.
      416       if fbr-line.recipe-code <> ""
      417       then do:
      418           find first recipe no-lock
      419               where recipe.recipe-code = fbr-line.recipe-code
      420           .
      421       end.
      422       find first goods no-lock
      423            where goods.artic     = fbr-line.artic
      424              and goods.prod-type = fbr-line.prod-type
      425              and goods.prod-code = fbr-line.prod-code
      426       .
      427       find first clients no-lock
      428            where clients.obj-code = goods.prod-code
      429              and clients.obj-type = goods.prod-type
      430       .
      431       if available recipe
      432       then do:
      433           display
      434               recipe.recipe-code @ fbr-line.recipe-code
      435               recipe.recipe-name
      436           with frame d-fbr-line.
      437       end.
      438       display
      439           goods.artic     @ fbr-line.artic
      440           goods.prod-code @ fbr-line.prod-code
      441           goods.prod-type @ fbr-line.prod-type
      442           fbr-line.fact-qnty
      443           fbr-line.price-sale
      444           goods.gds-name
      445           clients.obj-name
      446           goods.unit-base
      447       with frame d-fbr-line.
      448       if f-doc.status_ = 'новый':U
      449       then do:
      450           hide
      451               fbr-line.price-base
      452               fbr-line.price-rubl
      453           in frame d-fbr-line.
      454       end.
      455       else do:
      456           display
      457               fbr-line.price-base
      458               fbr-line.price-rubl
      459           with frame d-fbr-line.
      460       end.
      461       if f-doc.status_ = 'факт':U
      462       or not available recipe
      463       then do:
      464           hide avail-qnty in frame d-fbr-line.
      465       end.
      466       else do:
      467           run str/fbr-avl.p (
      468                 input f-doc.doc-code
      469               , input recipe.recipe-code
      470               , input fbr-line.trn-type
      471               , output avail-qnty
      472           ) no-error.
      473           if error-status :error
      474           then do:
      475               message
      476                        vss-workfile vss-revision vss-description
      477                   skip "Ошибка при вычислении необходимого количества."
      478                   skip return-value
      479                   skip trim(error-status :get-message(1))
      480                        trim(error-status :get-message(2))
      481                        trim(error-status :get-message(3))
      482               view-as alert-box error.
      483               undo, return error .
      484           end.
      485           display avail-qnty with frame d-fbr-line.
      486       end.
      487       if p-line-mode = 'ПРОСМОТР':U
      488       then do:
      489           wait-for go of frame d-fbr-line focus b-quit.
      490       end.
      491       else do:
      492           enable
      493               b-exit
      494               fbr-line.fact-qnty
      495               fbr-line.price-sale
      496           with frame d-fbr-line.
      497           if p-mark-qnty <> ?
      498           then do :
      499             assign fbr-line.fact-qnty = p-mark-qnty .
      500             display fbr-line.fact-qnty with frame d-fbr-line.
      501             disable fbr-line.fact-qnty with frame d-fbr-line.
      502           end .
      503           wait-for go of frame d-fbr-line focus fbr-line.fact-qnty.
      504       end.
      505   END.
      506   RUN disable_UI.
      507   PROCEDURE disable_UI :
      508     HIDE FRAME d-fbr-line.
      509   END PROCEDURE.
      510   PROCEDURE enable_UI :
      511     DISPLAY avail-qnty
      512         WITH FRAME d-fbr-line.
      513     IF AVAILABLE ub.clients THEN
      514       DISPLAY ub.clients.obj-name
      515         WITH FRAME d-fbr-line.
      516     IF AVAILABLE ub.fbr-line THEN
      517       DISPLAY ub.fbr-line.artic ub.fbr-line.prod-code ub.fbr-line.prod-type
      518             ub.fbr-line.recipe-code ub.fbr-line.fact-qnty ub.fbr-line.price-sale
      519             ub.fbr-line.price-base ub.fbr-line.price-rubl
      520         WITH FRAME d-fbr-line.
      521     IF AVAILABLE ub.goods THEN
      522       DISPLAY ub.goods.gds-name ub.goods.unit-base
      523         WITH FRAME d-fbr-line.
      524     IF AVAILABLE ub.recipe THEN
      525       DISPLAY ub.recipe.recipe-name
      526         WITH FRAME d-fbr-line.
      527     ENABLE b-help b-exit RECT-2 RECT-1 b-quit ub.fbr-line.price-sale
      528         WITH FRAME d-fbr-line.
      529     VIEW FRAME d-fbr-line.
      530   END PROCEDURE.
