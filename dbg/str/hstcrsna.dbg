        1   define input        parameter p-parent-proc as widget-handle no-undo.
        2   define input        parameter p-mode        as character     no-undo.
        3   define input-output parameter p-rec-id      as recid         no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения основания (причины) создания документа по фирме":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define buffer buf_cli for ub.clients.
      114   define buffer buf_rsn for ub.trn-reason.
      115   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      116   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      117   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      118   define variable v-ext-doc-name as character no-undo format "x(256)":U label "Расширенный тип документа".
      119   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      120   define frame fr-D-pump-8
      121     ub.c-trn-reason-host.host-code   at row 1.25 col  3.00 view-as fill-in    size-chars 10.00 by 1.00    label "Фирма"   format ">>>>>>>>>":U
      122     buf_cli.obj-name     at row 1.25 col 20.25 view-as fill-in    size-chars 79.50 by 1.00 no-label fgcolor 4 format "x(256)":U
      123     v-ext-doc-name       at row 2.50 col  3.00 view-as fill-in    size-chars 69.75 by 1.00          fgcolor 4
      124     ub.c-trn-reason-host.hold-doc    at row 3.75 col  3.00 view-as toggle-box size-chars  96.50 by 1.00
      125     ub.c-trn-reason-host.reason-code at row 5.00 col  3.00 view-as fill-in    size-chars 11.50 by 1.00    label "Причина" format ">>>>>>>>>>":U
      126     buf_rsn.reason-name  at row 5.00 col 24.25 view-as fill-in    size-chars 75.50 by 1.00 no-label fgcolor 4 format "x(256)":U
      127     r-rect-0             at row 6.50 col  1.50
      128       Btn_Exit           at row 6.75 col  2.50
      129       Btn_OK             at row 6.75 col 78.00
      130     b-help          at row 6.75 col 88.75
      131   with view-as dialog-box side-labels no-underline three-d scrollable
      132        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      133   assign frame fr-D-pump-8 :scrollable = no.
      134   on choose of Btn_OK in frame fr-D-pump-8 do:
      135   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   if lookup(self :type
      137            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      138            ) = 0
      139   then do:
      140     message
      141       "$Workfile$"
      142       "Указанному интерфейсному элементу фокус не может быть передан" skip
      143       "Интерфейсный элемент" self :name  skip
      144       "Тип" self :type  skip
      145       "Процедура" this-procedure :file-name skip
      146       view-as alert-box .
      147   end.
      148   else do:
      149     apply "entry":u to self  .
      150     if focus :handle <> self :handle  then do:
      151       return no-apply .
      152     end.
      153   end.
      154     apply "GO":U to frame fr-D-pump-8.
      155   end.
      156   on choose of Btn_Exit in frame fr-D-pump-8 do:
      157   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   if lookup(self :type
      159            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      160            ) = 0
      161   then do:
      162     message
      163       "$Workfile$"
      164       "Указанному интерфейсному элементу фокус не может быть передан" skip
      165       "Интерфейсный элемент" self :name  skip
      166       "Тип" self :type  skip
      167       "Процедура" this-procedure :file-name skip
      168       view-as alert-box .
      169   end.
      170   else do:
      171     apply "entry":u to self  .
      172     if focus :handle <> self :handle  then do:
      173       return no-apply .
      174     end.
      175   end.
      176   end.
      177   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   on F1 of frame fr-D-pump-8 anywhere do:
      179     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      180     return no-apply.
      181   end.
      182   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      183   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      184   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      185   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   on help of frame fr-D-pump-8
      187   do:
      188     run gbl/app_help.p
      189       (input this-procedure :file-name
      190       ,input ''
      191       ,input ?
      192       ) no-error.
      193     if error-status :error then do:
      194       message
      195         "Ошибка при вызове помощи"
      196         error-status :get-message(1)
      197         view-as alert-box .
      198     end.
      199   end.
      200   run minbtn-set in this-procedure .
      201   on choose of b-help in frame fr-D-pump-8
      202   do:
      203     apply "help":u to frame fr-D-pump-8 .
      204   end.
      205   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   procedure minbtn-set :
      207       do
      208           on error undo, return error return-value
      209           :
      210           define variable ii              as integer       no-undo .
      211           define variable fh              as widget-handle no-undo .
      212           define variable hh              as widget-handle no-undo .
      213           define variable v-h             as handle        extent 4 no-undo .
      214           define variable v-name-button   as character     no-undo .
      215           define variable v-help-old-x    as decimal       no-undo .
      216           define variable v-help-old-y    as decimal       no-undo .
      217           define variable v-help-old-size as decimal       no-undo .
      218           define variable v-frame-width   as decimal       no-undo .
      219           define variable jj              as integer       no-undo .
      220           do
      221               on error undo, return error
      222               :
      223               assign
      224                   v-frame-width = frame fr-D-pump-8:width - 0.3
      225                   fh            = frame fr-D-pump-8:first-child
      226                   hh            = fh:first-child
      227                   ii            = 1
      228                   .
      229               do while valid-handle(hh):
      230                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      231                   do:
      232                       case lc(hh:name) :
      233                           when "b-help" then
      234                               do:
      235                                   hh:load-image-up("cmp/b-help.bmp":u) .
      236                                   hh:load-image-down("cmp/b-help.bmp":u) .
      237                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      238                                   hh:TOOLTIP = "Помощь" .
      239                                   v-help-old-x = hh:column .
      240                                   v-help-old-y = hh:row    .
      241                                   v-help-old-size = hh:width .
      242                                   hh:width-chars = 2.5 .
      243                               end.
      244                           when "b-print" then
      245                               do:
      246                                   hh:load-image("cmp/b-print.bmp":u) .
      247                                   hh:TOOLTIP = "Печать" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-history" or
      253                           when "b-hist" then
      254                               do:
      255                                   hh:load-image("cmp/b-hist.bmp":u) .
      256                                   hh:TOOLTIP = "История" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-sch" then
      262                               do:
      263                                   hh:load-image("cmp/b-sch.bmp":u) .
      264                                   hh:TOOLTIP = "Установка Фильтра" .
      265                                   v-h[ii] = hh:handle .
      266                                   ii = ii + 1 .
      267                                   hh:width-chars = 3 .
      268                               end.
      269                           when "b-hist-user" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История пользователя" .
      273                                   ii = ii + 1 .
      274                               end.
      275                       end case.
      276                   end.
      277                   hh = hh:next-sibling.
      278               end.
      279               b-help:column = v-frame-width - b-help:width-chars.
      280               jj = 0.
      281               repeat ii = 4 to 1 by -1 :
      282                   if valid-handle (v-h[ii] ) then
      283                   do:
      284                       jj  = jj + 1 .
      285                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      286                       v-h[ii]:row    = v-help-old-y .
      287                   end.
      288               end.
      289           end.
      290       end.
      291   end procedure.
      292   Main-Block:
      293   do on error   undo Main-Block, leave Main-Block
      294      on end-key undo Main-Block, leave Main-Block :
      295     if p-mode <> 'ПРОСМОТР':U then do:
      296       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      297               "Неверное значение параметра вызова p-mode:" p-mode
      298       view-as alert-box error.
      299       undo Main-Block, return error.
      300     end.
      301     find ub.c-trn-reason-host no-lock where recid( ub.c-trn-reason-host ) = p-rec-id no-error.
      302     if not available ub.c-trn-reason-host then do:
      303       message "Карточка истории не найдена!" view-as alert-box error.
      304       undo Main-Block, leave Main-Block.
      305     end.
      306     find first buf_cli no-lock where
      307                buf_cli.obj-type = 'орг':U             and
      308                buf_cli.obj-code = ub.c-trn-reason-host.host-code no-error.
      309     assign v-ext-doc-name = entry( lookup( ub.c-trn-reason-host.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ).
      310     find first buf_rsn no-lock where
      311                buf_rsn.reason-code = ub.c-trn-reason-host.reason-code no-error.
      312     assign frame fr-D-pump-8 :title = "Код основания (причины) создания документа по умолчанию на объекте".
      313     display ub.c-trn-reason-host.host-code
      314             buf_cli.obj-name
      315             v-ext-doc-name
      316             ub.c-trn-reason-host.hold-doc
      317             ub.c-trn-reason-host.reason-code
      318             buf_rsn.reason-name
      319     with frame fr-D-pump-8.
      320     enable Btn_Exit b-help with frame fr-D-pump-8.
      321     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      322     wait-for go of frame fr-D-pump-8.
      323   end.
      324   hide frame fr-D-pump-8 no-pause.
