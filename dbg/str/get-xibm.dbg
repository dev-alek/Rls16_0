     6067                       buf_chk-doc.discnt = 0
     6068                       buf_chk-doc.d-pcnt = 0
     6069                       buf_chk-doc.src-d-pcnt = 0
     6070                       buf_chk-doc.doc-qnty = 0
     6071                       buf_chk-doc.src-tot-doc = 0
     6072                       buf_chk-doc.src-d-mask = ''
     6073                       buf_chk-doc.d-mask = ''
     6074                       buf_chk-doc.d-card = ''
     6075                       buf_chk-doc.src-d-card = ''
     6076                       buf_chk-doc.src-cli-type = ?
     6077                       buf_chk-doc.src-cli-code = ?
     6078                       buf_chk-doc.cli-type = ?
     6079                       buf_chk-doc.cli-code = ?
     6080                       buf_chk-doc.doc-num2 = ?
     6081                       buf_chk-doc.out-2-code = ?
     6082                       no-error
     6083                       .
     6084                   if error-status:error then do:
     6085                       assign
     6086                           buf_chk-doc.correct = no
     6087                           .
     6088                   end.
     6089                   if vCHNumberKKT ne ""
     6090                   then do:
     6091                       create buf_chk-doc-attr.
     6092                       assign
     6093                           buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6094                           buf_chk-doc-attr.attr-code  = "CHNumberKKT"
     6095                           buf_chk-doc-attr.attr-value = vCHNumberKKT
     6096                           .
     6097                   end.
     6098                   if v-id > "" then do:
     6099                       create buf_chk-doc-attr.
     6100                       assign
     6101                           buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6102                           buf_chk-doc-attr.attr-code  = "CheckId"
     6103                           buf_chk-doc-attr.attr-value = v-id
     6104                           .
