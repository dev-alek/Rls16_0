     9959   procedure proc-cfiscal :
     9960       define input parameter loc-exist as logical no-undo .
     9961       define variable v-field-name as character no-undo .
     9962       define variable v-datatype as character no-undo .
     9963       define variable v-int-trans-type as integer no-undo .
     9964       define buffer buf_temp-temp for temp-temp.
     9965       define buffer buf_cd-trans for tt-cd-trans .
     9966       defin buffer buf_chk-doc for tt-chk-doc.
     9967       defin buffer buf_chk-pay for tt-chk-pay.
     9968       do
     9969           on error undo, return error
     9970               :
     9971           if not loc-exist then do:
     9972               assign
     9973                   tot_sum = 0
     9974                   z-num_ = 0
     9975                   .
     9976               find first buf_chk-doc no-error.
     9977               for each buf_temp-temp where
     9978                   buf_temp-temp.record-name = "CFiscal":U
     9979                       AND buf_temp-temp.id = v-id:
     9980                   v-field-name = ''.
     9981                   CASE buf_temp-temp.field-name:
     9982                       when "CFSalesAccum" then do:
     9983                           assign
     9984                               v-field-name = "deckey_one"
     9985                               v-datatype = 'decimal':U
     9986                               v-int-trans-type = integer('15':U)
     9987                               tot_sum = decimal(buf_temp-temp.field-value)
     9988                               no-error .
     9989                       end.
     9990                       when "CFRetAccum" then do:
     9991                           assign
     9992                               v-field-name = "deckey_one"
     9993                               v-datatype = 'decimal':U
     9994                               v-int-trans-type = integer('16':U)
     9995                               no-error .
     9996                       end.
     9997                       when "CFZCount" then do:
     9998                           assign
     9999                               v-field-name = "key#_one"
    10000                               v-datatype = 'integer':U
    10001                               v-int-trans-type = integer('9':U)
    10002                               z-num_ = integer(buf_temp-temp.field-value)
    10003                               no-error .
    10004                       end.
    10005                       when "CFSerial" then do:
    10006                           assign
    10007                               v-field-name = "charkey_one"
    10008                               v-datatype = 'character':U
    10009                               v-int-trans-type = integer('5':U)
    10010                               no-error .
    10011                       end.
    10012                       when "CFRegNum" then do:
    10013                           assign
    10014                               v-field-name = "charkey_one"
    10015                               v-datatype = 'character':U
    10016                               v-int-trans-type = integer('6':U)
    10017                               no-error .
    10018                       end.
    10019                       when "CFOwner" then do:
    10020                           assign
    10021                               v-field-name = "charkey_one"
    10022                               v-datatype = 'character':U
    10023                               v-int-trans-type = integer('7':U)
    10024                               no-error .
    10025                       end.
    10026                       when "CFEKLZSerial" then do:
    10027                           assign
    10028                               v-field-name = "charkey_one"
    10029                               v-datatype = 'character':U
    10030                               v-int-trans-type = integer('8':U)
    10031                               no-error .
    10032                       end.
    10033                       when "CFDate" then do:
    10034                           assign
    10035                               v-field-name = "charkey_one"
    10036                               v-datatype = 'character':U
    10037                               v-int-trans-type = integer('10':U)
    10038                               no-error .
    10039                       end.
    10040                       when "CFXCount" then do:
    10041                           assign
    10042                               v-field-name = "key#_one"
    10043                               v-datatype = 'integer':U
    10044                               v-int-trans-type = integer('11':U)
    10045                               no-error .
    10046                       end.
    10047                       when "CFEJCount" then do:
    10048                           assign
    10049                               v-field-name = "key#_one"
    10050                               v-datatype = 'integer':U
    10051                               v-int-trans-type = integer('12':U)
    10052                               no-error .
    10053                       end.
    10054                       when "CFCash" then do:
    10055                           assign
    10056                               v-field-name = "deckey_one"
    10057                               v-datatype = 'decimal':U
    10058                               v-int-trans-type = integer('13':U)
    10059                               no-error .
    10060                       end.
    10061                       when "CFDocCount" then do:
    10062                           assign
    10063                               v-field-name = "key#_one"
    10064                               v-datatype = 'integer':U
    10065                               v-int-trans-type = integer('14':U)
    10066                               no-error .
    10067                       end.
    10068                       otherwise do:
    10069                           error-status:error = no.
    10070                       end.
    10071                   END CASE.
    10072                   if error-status:error then do:
    10073                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
    10074                   end.
    10075                   if v-field-name > '' then do:
    10076                       find first buf_cd-trans share-lock where
    10077                           buf_cd-trans.trans-type = v-int-trans-type
    10078                           and buf_cd-trans.obj-type = shop-type
    10079                           and buf_cd-trans.obj-code = shop-code
    10080                           and buf_cd-trans.chk-date = chk-date_
    10081                           and buf_cd-trans.chk-time = chk-time_
    10082                           and buf_cd-trans.pay-desk = buf_chk-doc.pay-desk
    10083                           and buf_cd-trans.chk-id = v-id
    10084                           no-error.
    10085                       if not available buf_cd-trans then do:
    10086                           create buf_cd-trans.
    10087                           assign
    10088                               buf_cd-trans.db-num   = g#db-num
    10089                               buf_cd-trans.trans-id = next-value(s-cd-trans, ub)
    10090                               buf_cd-trans.trans-type = v-int-trans-type
    10091                               buf_cd-trans.obj-type = shop-type
    10092                               buf_cd-trans.obj-code = shop-code
    10093                               buf_cd-trans.chk-date = chk-date_
    10094                               buf_cd-trans.chk-time = chk-time_
    10095                               buf_cd-trans.chk-id = v-id
    10096                               buf_cd-trans.z-number = buf_chk-doc.z-number
    10097                               buf_cd-trans.doc-code = buf_chk-doc.doc-code
    10098                               buf_cd-trans.src-shift-date = buf_chk-doc.src-shift-date
    10099                               buf_cd-trans.src-shift-name = buf_chk-doc.src-shift-name
    10100                               buf_cd-trans.pay-desk = buf_chk-doc.pay-desk
    10101                               buf_cd-trans.chk-num = buf_chk-doc.chk-num
    10102                               .
    10103                       end.
    10104                       assign
    10105                           buf_cd-trans.doc-code = buf_chk-doc.doc-code
    10106                           .
    10107                       case v-datatype:
    10108                           when 'character':U then do:
    10109                               buffer buf_cd-trans:handle:buffer-field(v-field-name):buffer-value = string(buf_temp-temp.field-value)
    10110                                   no-error .
    10111                           end.
    10112                           when 'date':U then do:
    10113                               buffer buf_cd-trans:handle:buffer-field(v-field-name):buffer-value = date(buf_temp-temp.field-value)
    10114                                   no-error .
    10115                           end.
    10116                           when 'decimal':U then do:
    10117                               buffer buf_cd-trans:handle:buffer-field(v-field-name):buffer-value = decimal(buf_temp-temp.field-value)
    10118                                   no-error .
    10119                           end.
    10120                           when 'integer':U then do:
    10121                               buffer buf_cd-trans:handle:buffer-field(v-field-name):buffer-value = integer(buf_temp-temp.field-value)
    10122                                   no-error .
    10123                           end.
    10124                           when 'logical':U then do:
    10125                               buffer buf_cd-trans:handle:buffer-field(v-field-name):buffer-value = logical(buf_temp-temp.field-value)
    10126                                   no-error .
    10127                           end.
    10128                       end.
    10129                       if error-status:error then do:
    10130                           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
    10131                       end.
    10132                   end.
    10133                   delete buf_temp-temp.
    10134               end.
    10135               FIND buf_chk-pay WHERE
    10136                    buf_chk-pay.doc-code = buf_chk-doc.doc-code
    10137                   AND buf_chk-pay.curr-code = 0
    10138                   AND buf_chk-pay.pay-code = 0
    10139                   NO-ERROR.
    10140               if NOT available buf_chk-pay
    10141               then  do:
    10142                   create buf_chk-pay.
    10143                   assign
    10144                       lnp = lnp + 1
    10145                       buf_chk-pay.doc-code = buf_chk-doc.doc-code
    10146                       buf_chk-pay.line-num = lnp
    10147                       buf_chk-pay.chk-date = buf_chk-doc.chk-date
    10148                       buf_chk-pay.obj-code = shop-code
    10149                       buf_chk-pay.obj-type = shop-type
    10150                       buf_chk-pay.tot-rubl = 0
    10151                       buf_chk-pay.tot-sum = 0
    10152                       buf_chk-pay.tot-base = 0
    10153                       buf_chk-pay.pay-code = 0
    10154                       buf_chk-pay.curr-code = 0
    10155                       buf_chk-pay.time-oper = buf_chk-doc.chk-time
    10156                       buf_chk-pay.cash-rate = buf_chk-doc.cash-rate
    10157                       buf_chk-pay.bank-rate = 1
    10158                       buf_chk-pay.bank-scale = 1
    10159                       buf_chk-pay.pass-pay =  0
    10160                       buf_chk-pay.pay-card = '':U
    10161                       buf_chk-pay.line-type = "":U
    10162                       buf_chk-pay.line-sign = yes
    10163                       buf_chk-pay.is-error = no
    10164                       buf_chk-doc.z-number = ( if z-num_ < buf_chk-doc.z-number
    10165                       and z-num_ > 0
    10166                       then z-num_ else buf_chk-doc.z-number)
    10167                       .
    10168               end.
    10169               assign
    10170                   buf_chk-pay.tot-sum = buf_chk-pay.tot-sum + tot_sum
    10171                   .
    10172           end.
    10173       end.
    10174   end procedure.
    10175   procedure proc-cfreg :
    10176       define variable v-cfrtype as character no-undo .
    10177       define variable v-cframount as decimal no-undo .
    10178       define variable v-cfrcount as integer no-undo .
    10179       define buffer buf_temp-temp for temp-temp.
    10180       define buffer buf_cd-trans for tt-cd-trans.
    10181       define buffer buf_chk-doc for tt-chk-doc.
    10182       do
    10183           on error undo, return error
    10184               :
    10185           for each buf_temp-temp where
    10186               buf_temp-temp.record-name = "CFReg":U
    10187                   AND buf_temp-temp.id = v-id:
    10188               CASE buf_temp-temp.field-name:
    10189                   when "CFRType" then do:
    10190                       assign
    10191                           v-cfrtype = buf_temp-temp.field-value
    10192                           no-error
    10193                           .
    10194                   end.
    10195                   when "CFRCount" then do:
    10196                       assign
    10197                           v-cfrcount = integer(buf_temp-temp.field-value)
    10198                           no-error
    10199                           .
    10200                   end.
    10201                   when "CFRAmount" then do:
    10202                       assign
    10203                           v-cframount = decimal(buf_temp-temp.field-value)
    10204                           no-error
    10205                           .
    10206                   end.
    10207                   otherwise do:
    10208                       error-status:error = no.
    10209                   end.
    10210               END CASE.
    10211               if error-status:error then do:
    10212                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
    10213               end.
    10214               delete buf_temp-temp.
    10215           end.
    10216           find first buf_chk-doc no-error.
    10217           find first buf_cd-trans share-lock where
    10218               buf_cd-trans.trans-type = integer('17':U)
    10219               and buf_cd-trans.obj-type = shop-type
    10220               and buf_cd-trans.charkey_one = v-cfrtype
    10221               and buf_cd-trans.obj-code = shop-code
    10222               and buf_cd-trans.chk-date = chk-date_
    10223               and buf_cd-trans.chk-time = chk-time_
    10224               and buf_cd-trans.chk-id = v-id
    10225               and buf_cd-trans.doc-code = buf_chk-doc.doc-code
    10226               no-error.
    10227           if not available buf_cd-trans then do:
    10228               create buf_cd-trans.
    10229               assign
    10230                   buf_cd-trans.db-num   = g#db-num
    10231                   buf_cd-trans.trans-id = next-value(s-cd-trans, ub)
    10232                   buf_cd-trans.trans-type = integer('17':U)
    10233                   buf_cd-trans.obj-type = shop-type
    10234                   buf_cd-trans.obj-code = shop-code
    10235                   buf_cd-trans.chk-date = chk-date_
    10236                   buf_cd-trans.chk-time = chk-time_
    10237                   buf_cd-trans.chk-id = v-id
    10238                   buf_cd-trans.z-number = buf_chk-doc.z-number
    10239                   buf_cd-trans.doc-code = buf_chk-doc.doc-code
    10240                   buf_cd-trans.src-shift-date = buf_chk-doc.src-shift-date
    10241                   buf_cd-trans.src-shift-name = buf_chk-doc.src-shift-name
    10242                   buf_cd-trans.pay-desk = buf_chk-doc.pay-desk
    10243                   buf_cd-trans.chk-num = buf_chk-doc.chk-num
    10244                   buf_cd-trans.chk-num = buf_chk-doc.chk-num
    10245                   buf_cd-trans.charkey_one = v-cfrtype
    10246                   buf_cd-trans.key#_one = v-cfrcount
    10247                   buf_cd-trans.deckey_one = v-cframount
    10248                   .
    10249           end.
    10250       end.
    10251   end procedure.
    10252   procedure proc-promo :
    10253       define variable  Promo-Id        as char no-undo .
    10254       define variable  promo-count     as integer no-undo .
    10255       define variable  promo-misc      as character no-undo .
    10256       define buffer buf_temp-temp for temp-temp .
    10257       define buffer buf_chk-gds for tt-chk-gds.
    10258       define buffer buf_chk-doc for tt-chk-doc.
    10259       define buffer buf_chk-discnt for tt-chk-discnt.
    10260       define buffer buf_chk-discnt-attr for tt-chk-discnt-attr.
    10261       define variable local-netto-for-sub-d as decimal no-undo .
    10262       do
    10263           on error undo, return error
    10264               :
    10265           if not exist then do:
    10266               for each buf_temp-temp where
    10267                   buf_temp-temp.record-name = "CPromo":U
    10268                       AND buf_temp-temp.id = v-id:
    10269                   CASE buf_temp-temp.field-name:
    10270                       when "cPromoId":U then do:
    10271                           assign
    10272                               Promo-Id = buf_temp-temp.field-value
    10273                               no-error .
    10274                       end.
    10275                       when "cPromoCount":U then do:
    10276                           assign
    10277                               promo-count = integer(buf_temp-temp.field-value)
    10278                               no-error .
    10279                       end.
    10280                       when "cPromoMisc":U then do:
    10281                           assign
    10282                               promo-misc = buf_temp-temp.field-value
    10283                               no-error .
    10284                       end.
    10285                       otherwise do:
    10286                           error-status:error = no.
    10287                       end.
    10288                   END CASE.
    10289                   if error-status:error then do:
    10290                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
    10291                   end.
    10292                   delete buf_temp-temp.
    10293               end.
    10294               FIND FIRST buf_chk-doc NO-ERROR.
    10295               find first buf_chk-discnt-attr exclusive-lock where
    10296                   buf_chk-discnt-attr.doc-code = buf_chk-doc.doc-code and
    10297                   buf_chk-discnt-attr.record-type = 5 and
    10298                   buf_chk-discnt-attr.line-num = 0 and
    10299                   buf_chk-discnt-attr.attr-code = "promo-id" and
    10300                   buf_chk-discnt-attr.attr-value = Promo-Id no-error .
    10301               if not available (buf_chk-discnt-attr) then
    10302               do:
    10303                   create buf_chk-discnt-attr .
    10304                   assign
    10305                       buf_chk-discnt-attr.doc-code        = buf_chk-doc.doc-code
    10306                       buf_chk-discnt-attr.record-type     = 5
    10307                       buf_chk-discnt-attr.line-num        = 0
    10308                       buf_chk-discnt-attr.discnt-id       = (var-discnt-id + 1)
    10309                       buf_chk-discnt-attr.object-line-num = 0
    10310                       buf_chk-discnt-attr.attr-code       = "promo-id"
    10311                       buf_chk-discnt-attr.attr-value      = Promo-Id
    10312                       var-discnt-id                      = var-discnt-id + 1.
    10313                   .
    10314               end.
    10315               find first buf_chk-discnt exclusive-lock where
    10316                          buf_chk-discnt.doc-code = buf_chk-discnt-attr.doc-code
    10317                      and buf_chk-discnt.record-type = buf_chk-discnt-attr.record-type
    10318                      and buf_chk-discnt.discnt-id = buf_chk-discnt-attr.discnt-id no-error.
    10319               if available buf_chk-discnt then
    10320               do:
    10321                   buf_chk-discnt.object-sum = buf_chk-discnt.object-sum + promo-count.
    10322               end.
    10323               else do:
    10324                   create buf_chk-discnt.
    10325                   assign
    10326                       buf_chk-discnt.doc-code = buf_chk-doc.doc-code
    10327                       buf_chk-discnt.record-type = buf_chk-discnt-attr.record-type
    10328                       buf_chk-discnt.promo-id = Promo-Id
    10329                       buf_chk-discnt.line-num = 0
    10330                       buf_chk-discnt.object-sum = promo-count
    10331                       buf_chk-discnt.discnt-id =  buf_chk-discnt-attr.discnt-id
    10332                       buf_chk-discnt.object-line-num = 0
    10333                       buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
    10334                       buf_chk-discnt.obj-code = buf_chk-doc.obj-code
    10335                       buf_chk-discnt.obj-type = buf_chk-doc.obj-type
    10336                       buf_chk-discnt.chk-date = buf_chk-doc.chk-date
    10337                       buf_chk-discnt.shift-date = buf_chk-doc.shift-date
    10338                       buf_chk-discnt.shift-num = buf_chk-doc.shift-num
    10339                       buf_chk-discnt.chk-time = buf_chk-doc.chk-time
    10340                       .
    10341                   var-discnt-id = var-discnt-id + 1.
    10342               end.
    10343           end.
    10344       end.
    10345   end procedure.
