     1891   define output parameter p-out-string    as character        no-undo.
     1892       define variable v-position      as integer      no-undo.
     1893       define variable v-current-char  as character    no-undo.
     1894   do
     1895   on error undo, return error
     1896   :
     1897       assign
     1898           p-out-string = "":U
     1899       .
     1900       case p-in-string
     1901       :
     1902           when ?
