     4056   procedure get-xml-ibm-c-buff-or-file.
     4057      define input parameter p-Type as character  no-undo.
     4058      define input parameter p-str  as longchar   no-undo.
     4059      define variable hParser as handle no-undo.
     4060      mtagbeg = 0.
     4061      mtagend = 0.
     4062   run get-ibm-parameters in this-procedure no-error.
     4063   if error-status:error then do:
     4064     assign
     4065     p-view-log = yes
     4066     .
     4067     run write-log-and-file in p-log-handle (
     4068           input 1
     4069         , input log-file-name
     4070         , input 1
     4071         , input substitute( "!!!При обработке данных от кассы произошла ошибка при получении значений настроечных параметров: &1"
     4072                             , return-value
     4073                           )
     4074                                           ).
     4075     undo, return .
     4076   end.
     4077      create sax-reader hParser.
     4078      if p-Type eq "file"
     4079      then
     4080         hParser:set-input-source(p-Type, string(p-str)).
     4081      else do:
     4082         if p-Type = "longchar"
     4083         then do:
     4084            define variable vmemptr as memptr no-undo.
     4085            copy-lob p-str to vmemptr.
     4086            hParser:set-input-source("memptr", vmemptr).
     4087         end.
     4088         else
     4089            hParser:set-input-source(p-Type, p-str).
     4090      end.
     4091      hParser:sax-parse () no-error.
     4092      if error-status:error then do:
     4093         delete object hParser.
     4094         if error-status:num-messages > 0
     4095         then do:
     4096             run write-log-and-file in p-log-handle (
     4097              input 1
     4098            , input log-file-name
     4099            , input 1
     4100            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 &2"
     4101                                , ErrorMessage
     4102                                , return-value
     4103                              )
     4104                                        ).
     4105             return error error-status:get-message(1).
     4106         end.
     4107         else do:
     4108              return error return-value.
     4109         end.
     4110      end.
     4111      delete object hParser.
     4112      if ErrorMessage <> ""
     4113      then do:
     4114         run write-log-and-file in p-log-handle (
     4115              input 1
     4116            , input log-file-name
     4117            , input 1
     4118            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 "
     4119                                , ErrorMessage
     4120                              )
     4121                                        ).
     4122         return error ErrorMessage .
     4123      end.
     4124   DO TRANSACTION:
     4125     run proc-end in this-procedure no-error .
     4126   END.
     4127   assign
     4128   error-status:error = false.
     4129   define buffer buf_cash-desk for ub.cash-desk.
     4130   for each temp-cash-desk:
     4131     find first buf_cash-desk no-lock where
     4132               buf_cash-desk.db-num = g#db-num
     4133           AND buf_cash-desk.obj-code = p-obj-code
     4134           AND buf_cash-desk.pos-type = p-pos-type
     4135           AND buf_cash-desk.cash-num = temp-cash-desk.cash-num no-error .
     4136     if available buf_cash-desk then do:
     4137       run cd-attr-write in this-procedure (
     4138                                             input g#db-num
     4139                                            ,input p-obj-code
     4140                                           ,input p-pos-type
     4141                                           ,input temp-cash-desk.cash-num
     4142                                           ,input (if buf_cash-desk.pos-type = 'IBM-XML':U
     4143                                                   then 'IBM-XML_operative':U
     4144                                                   else if  buf_cash-desk.pos-type = 'Autotank':U
     4145                                                   then 'AUTOTANK_operative':U
     4146                                                   else 'MAGIA-XML_operative':U)
     4147                                           ,input (if buf_cash-desk.pos-type = 'IBM-XML':U
     4148                                                   then 'last-check-params':U
     4149                                                   else if  buf_cash-desk.pos-type = 'Autotank':U
     4150                                                   then 'last-check-params':U
     4151                                                   else 'last-check-date-time':U
     4152                                                  )
     4153                                           ,input (cd-attr-CD-DatetoString (temp-cash-desk.last-date) + chr(32)  +  string(temp-cash-desk.last-time, "HH:MM:SS":U)
     4154                                                +  (if buf_cash-desk.pos-type = 'IBM-XML':U
     4155                                                    or buf_cash-desk.pos-type = 'Autotank':U
     4156                                                  then (chr(32) + string(temp-cash-desk.last-shift-num) +
     4157                                                         chr(32) + string(temp-cash-desk.last-z-count) +
     4158                                                         chr(32) + string(temp-cash-desk.last-chk-num))
     4159                                                  else  "":U)
     4160                                                  )
     4161                                           ,input ?
     4162                                           ,input 0.0
     4163                                           ,input 0
     4164                                           ,input no
     4165                                           ) no-error.
     4166     end.
     4167   end.
     4168   end.
     4169   procedure StartDocument:
     4170   end procedure.
     4171   procedure StartElement:
     4172      define input parameter namespaceURI as character.
     4173      define input parameter localName    as character.
     4174      define input parameter qname        as character.
     4175      define input parameter ihAttributes as handle.
     4176      define variable v-attr-num    as integer   no-undo.
     4177      define variable v-temp-string as character no-undo.
     4178      do v-attr-num = 1 to ihAttributes:num-items:
     4179         v-temp-string = substitute ('&1 &2="&3"',
     4180                                     v-temp-string,
     4181                                     ihAttributes:get-qname-by-index(v-attr-num),
     4182                                     ihAttributes:get-value-by-index(v-attr-num)).
     4183      end.
     4184      v-temp-string = trim(v-temp-string).
     4185        mtagbeg =  mtagbeg + 1.
     4186       run run-callback-procedure in this-procedure (
     4187                         input this-procedure:handle
     4188                       , input "call-all":U
     4189                       , input "tag-start"
     4190                       , input qname
     4191                       , input v-temp-string
     4192                   ).
     4193   end procedure.
     4194   define variable mcurrentContent as character no-undo.
     4195   procedure Characters:
     4196       define input parameter charData as memptr.
     4197       define input parameter numChars as integer.
     4198       define variable mcurrentContent as character no-undo.
     4199       mcurrentContent = get-string(charData, 1, get-size(charData)).
     4200       run run-callback-procedure in this-procedure (
     4201                         input this-procedure:handle
     4202                       , input "call-all":U
     4203                       , input "text"
     4204                       , input ""
     4205                       , input mcurrentContent
     4206                   ).
     4207   end procedure.
     4208   procedure EndElement:
     4209   define input parameter name_     as character.
     4210   define input parameter localName as character.
     4211   define input parameter qName     as character.
     4212       if qname = "ErrorMessage" then do:
     4213         ErrorMessage = mcurrentContent.
     4214         self:stop-parsing ().
     4215       end.
     4216       mtagend = mtagend + 1.
     4217       if mtagend mod 100 = 0 or qName eq "check"
     4218       then do:
     4219         run show-counter in p-log-handle .
     4220         run write-counter in p-log-handle (substitute("Прочитано открытых тегов &1 из них закрытых &2", mtagbeg, mtagend)).
     4221       end.
     4222       run run-callback-procedure in this-procedure (
     4223                         input this-procedure:handle
     4224                       , input "call-all":U
     4225                       , input "tag-end"
     4226                       , input qname
     4227                       , input ""
     4228                   ).
     4229   end procedure.
     4230   procedure EndDocument:
     4231       run hide-counter in p-log-handle .
     4232       mOk = true.
     4233   end procedure.
     4234   procedure Warning:
     4235       define input parameter ErrMessage as character no-undo.
     4236       message "The following WARNING was generated:~n" + ErrMessage
     4237           view-as alert-box information buttons ok.
     4238   end procedure.
     4239   procedure Error:
     4240       define input parameter ErrMessage as character no-undo.
     4241       mOk = false.
     4242       message "The following NONFATAL ERROR was generated:~n" + ErrMessage
     4243           view-as alert-box information buttons ok.
     4244   end procedure.
     4245   procedure FatalError:
     4246       define input parameter ErrMessage as character no-undo.
     4247       mOk = false.
     4248       return error "The following FATAL ERROR was generated:~n" + ErrMessage.
     4249   end procedure.
     4250   PROCEDURE get-xml-ibm-c.
     4251   define input parameter p-filename as char no-undo.
     4252   define variable v-new-filename-full     as character         no-undo.
     4253   define variable v-xml-buffer as character no-undo.
     4254   define variable v-my-string as character no-undo .
     4255   define variable v-read-char as character no-undo .
     4256   define buffer buf_cash-desk for ub.cash-desk.
     4257   run get-ibm-parameters in this-procedure no-error.
     4258   if error-status:error then do:
     4259     assign
     4260     p-view-log = yes
     4261     .
     4262     run write-log-and-file in p-log-handle (
     4263           input 1
     4264         , input log-file-name
     4265         , input 1
     4266         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении значений настроечных параметров: &2"
     4267                             , p-filename
     4268                             , return-value
     4269                           )
     4270                                           ).
     4271     undo, return .
     4272   end.
     4273   error-status:error = FALSE.
     4274   run gbl/fileapnd.p
     4275     ( input p-filename
     4276      ,input ""
     4277      ,input 5
     4278     ) no-error .
     4279   if error-status:error then do:
     4280      run write-log-and-file in p-log-handle (
     4281          input 1
     4282        , input log-file-name
     4283        , input 1
     4284        , input return-value
     4285        ).
     4286      assign
     4287         p-view-log = yes
     4288         .
     4289      undo, return.
     4290   end.
     4291   if p-encoding = "utf-8":U  then  do:
     4292     input stream ChkStream from value( p-filename ) convert source "utf-8".
     4293   end.
     4294   else do:
     4295     input stream ChkStream from value( p-filename ) .
     4296   end.
     4297   _repeat:
     4298   REPEAT :
     4299     if v-exit-processing then leave _repeat.
     4300     _line:
     4301     DO TRANSACTION:
     4302       import stream Chkstream unformatted  v-xml-buffer  .
     4303       if v-xml-buffer = "":U then do:
     4304         NEXT _repeat.
     4305       end.
     4306       assign
     4307       var-file-line-num = var-file-line-num + 1
     4308       .
     4309       if left-trim(v-xml-buffer)  begins "<?xml":U then do:
     4310         assign
     4311         v-encoding = cb-xmlparse-get-attr(
     4312                                 input this-procedure:handle
     4313                                ,input "xml":U
     4314                                ,input trim(v-xml-buffer, "?>")
     4315                                ,input "encoding":U
     4316                                ,input yes)
     4317        .
     4318        if v-encoding <> p-encoding
     4319        then do:
     4320           run write-log-and-file in p-log-handle (
     4321                 input 1
     4322               , input log-file-name
     4323               , input 1
     4324               , input substitute( "!!!Ошибка чтения файла &1: кодировка НЕ &2"
     4325                                   , p-filename
     4326                                   , p-encoding
     4327                                 )
     4328                                               ).
     4329         assign
     4330         p-view-log = yes
     4331         .
     4332         undo, return .
     4333        end.
     4334       end.
     4335       run xmlvalid in this-procedure (
     4336             input this-procedure:handle
     4337           , input v-xml-buffer
     4338           , input 'fatal':u
     4339       ) no-error .
     4340       if error-status:error  then do:
     4341           run write-log-and-file in p-log-handle (
     4342                 input 1
     4343               , input log-file-name
     4344               , input 1
     4345               , input substitute( "!!!Ошибка импорта файла &1: &2"
     4346                                   , p-filename
     4347                                   , return-value
     4348                                 )
     4349                                               ).
     4350         assign
     4351         p-view-log = yes
     4352         .
     4353         undo, return .
     4354       end.
     4355       if v-cd-fatal-error then do:
     4356         run write-log-and-file in p-log-handle (
     4357               input 1
     4358             , input log-file-name
     4359             , input 1
     4360             , input substitute( "!!!Файл &1 строка &2 фатальные ошибки: &3 - импорт прекращен"
     4361                                 , p-filename
     4362                                 , var-file-line-num
     4363                                 , v-cd-fatal-message
     4364                               )
     4365                                             ).
     4366         assign
     4367         p-view-log = yes
     4368         .
     4369         undo, return.
     4370       end.
     4371       if var-file-line-num modulo 100 = 0 then do:
     4372         run show-counter in p-log-handle .
     4373         run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", p-filename, var-file-line-num)).
     4374       end.
     4375     END .
     4376   end.
     4377   DO TRANSACTION:
     4378     run proc-end in this-procedure no-error .
     4379   END.
     4380   assign
     4381   error-status:error = false.
     4382   input stream ChkStream close.
     4383   for each temp-cash-desk:
     4384     find first buf_cash-desk no-lock where
     4385               buf_cash-desk.db-num = g#db-num
     4386           AND buf_cash-desk.obj-code = p-obj-code
     4387           AND buf_cash-desk.pos-type = p-pos-type
     4388           AND buf_cash-desk.cash-num = temp-cash-desk.cash-num no-error .
     4389     if available buf_cash-desk then do:
     4390     run cd-attr-write in this-procedure (
     4391                                             input g#db-num
     4392                                            ,input p-obj-code
     4393                                           ,input p-pos-type
     4394                                           ,input temp-cash-desk.cash-num
     4395                                           ,input (if buf_cash-desk.pos-type = 'IBM-XML':U
     4396                                                   then 'IBM-XML_operative':U
     4397                                                   else if  buf_cash-desk.pos-type = 'Autotank':U
     4398                                                   then 'AUTOTANK_operative':U
     4399                                                   else 'MAGIA-XML_operative':U)
     4400                                           ,input (if buf_cash-desk.pos-type = 'IBM-XML':U
     4401                                                   then 'last-check-params':U
     4402                                                   else if  buf_cash-desk.pos-type = 'Autotank':U
     4403                                                   then 'last-check-params':U
     4404                                                   else 'last-check-date-time':U
     4405                                                  )
     4406                                           ,input (cd-attr-CD-DatetoString (temp-cash-desk.last-date) + chr(32)  +  string(temp-cash-desk.last-time, "HH:MM:SS":U)
     4407                                                +  (if buf_cash-desk.pos-type = 'IBM-XML':U
     4408                                                    or buf_cash-desk.pos-type = 'Autotank':U
     4409                                                  then (chr(32) + string(temp-cash-desk.last-shift-num) +
     4410                                                         chr(32) + string(temp-cash-desk.last-z-count) +
     4411                                                         chr(32) + string(temp-cash-desk.last-chk-num))
     4412                                                  else  "":U)
     4413                                                  )
     4414                                           ,input ?
     4415                                           ,input 0.0
     4416                                           ,input 0
     4417                                           ,input no
     4418                                           ) no-error.
     4419   end.
     4420   end.
     4421   END PROCEDURE.
     4422   procedure cb-xmlparse-tag-start-Header :
     4423   do
     4424   on error undo, return error
     4425   :
     4426     assign
     4427         v-mail-parameters-start = yes
     4428     .
     4429   end.
     4430   end procedure.
     4431   procedure cb-xmlparse-tag-end-Header :
     4432   do
     4433   on error undo, return error
     4434   :
     4435     assign
     4436         v-mail-parameters-start = no
     4437     .
     4438   end.
     4439   end procedure.
     4440   procedure cb-xmlparse-tag-start-spool :
     4441   define input parameter p-parameter as character no-undo .
     4442   define variable v-file-type as character no-undo .
     4443   define variable v-adresat as character no-undo .
     4444   define variable v-FO-version as character no-undo .
     4445   define variable v-OptVersion as character no-undo .
     4446   define variable v-OptVersion1 as character no-undo .
     4447   define variable v-OptVersion2 as character no-undo .
     4448   define variable v-OptVersion3 as character no-undo .
     4449   define variable v-OptVersion4 as character no-undo .
     4450   define variable v-OptVer      as character no-undo .
     4451   define variable v-old-fo-version as character no-undo .
     4452   define variable v-pay-desk as integer no-undo .
     4453   define variable v-dop as character no-undo .
     4454   define buffer cash-desk for ub.cash-desk.
     4455   define variable v-date as date no-undo .
     4456   define variable v-decimal as decimal no-undo .
     4457   define variable v-integer as integer no-undo .
     4458   define variable v-logical as logical no-undo .
     4459   define variable v-err-message as character no-undo .
     4460   do
     4461   on error undo, return error
     4462   :
     4463     if v-is-spool-file = no then do:
     4464       IF INDEX(p-parameter,"OptVersion") > 0 THEN v-OptVer = 'OptVer'.
     4465       assign
     4466       v-file-type = cb-xmlparse-get-attr(
     4467                                 input this-procedure:handle
     4468                                ,input p-spool-or-data
     4469                                ,input p-parameter
     4470                                ,input "type":U
     4471                                ,input yes)
     4472       v-adresat =  cb-xmlparse-get-attr(
     4473                                 input this-procedure:handle
     4474                                ,input p-spool-or-data
     4475                                ,input p-parameter
     4476                                ,input "to":U
     4477                                ,input no)
     4478       v-pos-version =  cb-xmlparse-get-attr(
     4479                                 input this-procedure:handle
     4480                                ,input p-spool-or-data
     4481                                ,input p-parameter
     4482                                ,input "version":U
     4483                                ,input no)
     4484       v-FO-version =  cb-xmlparse-get-attr(
     4485                                 input this-procedure:handle
     4486                                ,input p-spool-or-data
     4487                                ,input p-parameter
     4488                                ,input "release":U
     4489                                ,input no)
     4490       v-from =  cb-xmlparse-get-attr(
     4491                                 input this-procedure:handle
     4492                                ,input p-spool-or-data
     4493                                ,input p-parameter
     4494                                ,input "from":U
     4495                                ,input no)
     4496       v-OptVersion =  cb-xmlparse-get-attr(
     4497                                 input this-procedure:handle
     4498                                ,input p-spool-or-data
     4499                                ,input p-parameter
     4500                                ,input "OptVersion":U
     4501                                ,input no)
     4502       v-OptVersion1 =  cb-xmlparse-get-attr(
     4503                                 input this-procedure:handle
     4504                                ,input p-spool-or-data
     4505                                ,input p-parameter
     4506                                ,input "OptVersion1":U
     4507                                ,input no)
     4508       v-OptVersion2 =  cb-xmlparse-get-attr(
     4509                                 input this-procedure:handle
     4510                                ,input p-spool-or-data
     4511                                ,input p-parameter
     4512                                ,input "OptVersion2":U
     4513                                ,input no)
     4514       v-OptVersion3 =  cb-xmlparse-get-attr(
     4515                                 input this-procedure:handle
     4516                                ,input p-spool-or-data
     4517                                ,input p-parameter
     4518                                ,input "OptVersion3":U
     4519                                ,input no)
     4520       v-OptVersion4 =  cb-xmlparse-get-attr(
     4521                                 input this-procedure:handle
     4522                                ,input p-spool-or-data
     4523                                ,input p-parameter
     4524                                ,input "OptVersion4":U
     4525                                ,input no)
     4526       .
     4527       if v-file-type = "REPLY":U AND
     4528       (v-adresat begins ('маг':U + string(p-obj-code))
     4529       )
     4530       then do:
     4531         assign
     4532         v-is-spool-file = yes
     4533         .
     4534         if v-from begins ('маг':U + string(p-obj-code) + "_" + "касса") then do:
     4535           v-pay-desk = ?.
     4536           v-pay-desk = integer(replace(v-from, ('маг':U + string(p-obj-code) + "_" + "касса"), "")) no-error.
     4537           assign
     4538              m-head-db-num    = ?
     4539              m-head-obj-code  = ?
     4540              m-head-pos-type  = ?
     4541              m-head-cash-num  = ?
     4542           .
     4543           find first cash-desk where
     4544                            cash-desk.db-num = g#db-num
     4545                        and cash-desk.obj-code = p-obj-code
     4546                        and cash-desk.cash-num = v-pay-desk
     4547           no-lock no-error.
     4548           if available cash-desk
     4549           then do transaction :
     4550              assign
     4551                 m-head-db-num    = cash-desk.db-num
     4552                 m-head-obj-code  = cash-desk.obj-code
     4553                 m-head-pos-type  = cash-desk.pos-type
     4554                 m-head-cash-num  = cash-desk.cash-num
     4555              .
     4556             if p-pos-type = 'IBM-XML':U then
     4557             do:
     4558               run cd-attr-write in this-procedure (
     4559                 input cash-desk.db-num
     4560                 ,input cash-desk.obj-code
     4561                 ,input cash-desk.pos-type
     4562                 ,input cash-desk.cash-num
     4563                 ,input  (if p-pos-type = 'IBM-XML':U
     4564                 then 'IBM-XML_operative':U
     4565                 else 'AUTOTANK_operative':U)
     4566                 ,input 'last-date-polls':U
     4567                 ,input string (today,"99.99.9999")
     4568                 ,input ?
     4569                 ,input 0
     4570                 ,input 0
     4571                 ,input no
     4572                 ) .
     4573               run cd-attr-write in this-procedure (
     4574                 input cash-desk.db-num
     4575                 ,input cash-desk.obj-code
     4576                 ,input cash-desk.pos-type
     4577                 ,input cash-desk.cash-num
     4578                 ,input  (if p-pos-type = 'IBM-XML':U
     4579                 then 'IBM-XML_operative':U
     4580                 else 'AUTOTANK_operative':U)
     4581                 ,input 'last-time-polls':U
     4582                 ,input string (time,"HH:MM:SS")
     4583                 ,input ?
     4584                 ,input 0
     4585                 ,input 0
     4586                 ,input no
     4587                 ) .
     4588             end.
     4589             IF v-OptVer = 'OptVer' THEN DO:
     4590               v-OptVer = "".
     4591               IF v-OptVersion  <> ? THEN v-OptVer = TRIM(v-OptVersion," ").
     4592               IF v-OptVersion1 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion1," ")) .
     4593               IF v-OptVersion2 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion2," ")) .
     4594               IF v-OptVersion3 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion3," ")) .
     4595               IF v-OptVersion4 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion4," ")) .
     4596               v-OptVer = TRIM(v-OptVer,",").
     4597                   IF v-OptVer = "" THEN v-OptVer = "?" .
     4598                       run cd-attr-write in this-procedure (
     4599                                                      input cash-desk.db-num
     4600                                                     ,input cash-desk.obj-code
     4601                                                     ,input cash-desk.pos-type
     4602                                                     ,input cash-desk.cash-num
     4603                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     4604                                                              then 'IBM-XML_operative':U
     4605                                                              else 'AUTOTANK_operative':U)
     4606                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     4607                                                          then 'OptVer':U
     4608                                                          else 'OptVer':U)
     4609                                                     ,input v-OptVer
     4610                                                     ,input no
     4611                                                     ,input no
     4612                                                     ,input no
     4613                                                     ,input no
     4614                                                     ) no-error.
     4615                  v-OptVer = '' .
     4616              END.
     4617             if error-status:error then do :
     4618                 v-err-message = return-value .
     4619                 run write-log-and-file in p-log-handle (
     4620               input 1
     4621             , input log-file-name
     4622             , input 1
     4623             , input v-err-message
     4624                                             ).
     4625                 p-view-log = yes .
     4626               end .
     4627              run cd-attr-value in this-procedure (
     4628                                                  input cash-desk.db-num
     4629                                                 ,input cash-desk.obj-code
     4630                                                 ,input cash-desk.pos-type
     4631                                                 ,input cash-desk.cash-num
     4632                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     4633                                                         then 'IBM-XML_operative':U
     4634                                                         else 'AUTOTANK_operative':U)
     4635                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     4636                                                          then 'fo-version':U
     4637                                                          else 'fo-version':U)
     4638                                                 ,output v-old-fo-version
     4639                                                 ,output v-date
     4640                                                 ,output v-decimal
     4641                                                 ,output v-integer
     4642                                                 ,output v-logical
     4643                                                 ,output v-dop) no-error.
     4644              if     v-old-fo-version <> v-fo-version
     4645                 and v-FO-version <> ?
     4646              then do:
     4647                 run cd-attr-write in this-procedure (
     4648                                                      input cash-desk.db-num
     4649                                                     ,input cash-desk.obj-code
     4650                                                     ,input cash-desk.pos-type
     4651                                                     ,input cash-desk.cash-num
     4652                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     4653                                                              then 'IBM-XML_operative':U
     4654                                                              else 'AUTOTANK_operative':U)
     4655                                                     ,input (if cash-desk.pos-type = 'IBM-XML':U
     4656                                                             then 'fo-version':U
     4657                                                             else 'fo-version':U)
     4658                                                     ,input v-fo-version
     4659                                                     ,input ?
     4660                                                     ,input 0
     4661                                                     ,input 0
     4662                                                     ,input no
     4663                                                     ) no-error.
     4664               if error-status:error then do :
     4665                 v-err-message = return-value .
     4666                 run write-log-and-file in p-log-handle (
     4667               input 1
     4668             , input log-file-name
     4669             , input 1
     4670             , input v-err-message
     4671                                             ).
     4672                 p-view-log = yes .
     4673               end .
     4674             end.
     4675           end.
     4676         end.
     4677       end.
     4678       else do:
     4679         run write-log-and-file in p-log-handle (
     4680               input 1
     4681             , input log-file-name
     4682             , input 1
     4683             , input substitute( "!!!В директории приема файлов обнаружен файл с неизвестным адресатом: &1 и/или неизвестного типа: &2"
     4684                                 , v-adresat
     4685                                 , v-file-type
     4686                               )
     4687                                             ).
     4688         assign
     4689         p-view-log = yes
     4690         v-exit-processing = yes
     4691         .
     4692       end.
     4693     end.
     4694     else do:
     4695         run write-log-and-file in p-log-handle (
     4696               input 1
     4697             , input log-file-name
     4698             , input 1
     4699             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>", p-spool-or-data
     4700                               )
     4701                                             ).
     4702         assign
     4703         p-view-log = yes
     4704         .
     4705     end.
     4706   end.
     4707   end procedure.
     4708   procedure cb-xmlparse-tag-start-config :
     4709   define input parameter p-parameter as character no-undo .
     4710     run cb-xmlparse-tag-start-spool in this-procedure ( input p-parameter) no-error.
     4711     if error-status:error then return error return-value .
     4712   end procedure.
     4713   procedure cb-xmlparse-tag-start-control :
     4714   define input parameter p-parameter as character no-undo .
     4715     run cb-xmlparse-tag-start-spool in this-procedure ( input p-parameter) no-error.
     4716     if error-status:error then return error return-value .
     4717   end procedure.
     4718   procedure cb-xmlparse-tag-end-spool :
     4719   define input parameter p-parameter as character no-undo .
     4720   do
     4721   on error undo, return error
     4722   :
     4723     assign
     4724     v-is-spool-file = no
     4725     .
     4726     end.
     4727   end procedure.
     4728   procedure cb-xmlparse-tag-end-config :
     4729   define input parameter p-parameter as character no-undo .
     4730   run cb-xmlparse-tag-end-spool  in this-procedure ( input p-parameter) no-error.
     4731   if error-status:error then return error return-value .
     4732   end procedure.
     4733   procedure cb-xmlparse-tag-end-control :
     4734   define input parameter p-parameter as character no-undo .
     4735   run cb-xmlparse-tag-end-spool  in this-procedure ( input p-parameter) no-error.
     4736   if error-status:error then return error return-value .
     4737   end procedure.
     4738   procedure cb-xmlparse-tag-start-data :
     4739   define input parameter p-parameter as character no-undo .
     4740   do
     4741   on error undo, return error
     4742   :
     4743     if v-is-spool-file = yes then do:
     4744         run write-log-and-file in p-log-handle (
     4745               input 1
     4746             , input log-file-name
     4747             , input 1
     4748             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>",
     4749    "data":U
     4750                              )
     4751                                             ).
     4752         assign
     4753         p-view-log = yes
     4754         .
     4755     end.
     4756     else do:
     4757       assign
     4758       v-exit-processing = yes
     4759       .
     4760     end.
     4761   end.
     4762   end procedure.
     4763   procedure cb-xmlparse-tag-end-data :
     4764   define input parameter p-parameter as character no-undo .
     4765   do
     4766   on error undo, return error
     4767   :
     4768   end.
     4769   end procedure.
     4770   procedure cb-xmlparse-tag-start-error:
     4771   define input parameter p-parameter as character no-undo .
     4772   run cb-xmlparse-tag-start-err in this-procedure ( input p-parameter)  .
     4773   end procedure .
     4774   procedure cb-xmlparse-tag-end-error :
     4775   define input parameter p-parameter as character no-undo .
     4776   run cb-xmlparse-tag-end-err in this-procedure ( input p-parameter)  .
     4777   end procedure .
     4778   procedure cb-xmlparse-tag-end-ErrorMessage :
     4779   define input parameter p-parameter as character no-undo .
     4780   assign
     4781   v-ErrorMessage = v-xmlvalid-tag-value
     4782   .
     4783   if p-pos-type = 'IBM-XML':U
     4784   or p-pos-type = 'Autotank':U
     4785   then do:
     4786       run write-log-and-file in p-log-handle (
     4787             input 1
     4788           , input log-file-name
     4789           , input 1
     4790           , input substitute( "!!!&1"
     4791                               ,v-ErrorMessage
     4792                             )
     4793                                           ).
     4794       assign
     4795       p-view-log = yes
     4796       .
     4797   end.
     4798   end procedure .
     4799   procedure cb-xmlparse-tag-end-ErrorSeverity :
     4800   define input parameter p-parameter as character no-undo .
     4801   assign
     4802   v-Errorseverity = integer(v-xmlvalid-tag-value)
     4803   no-error
     4804   .
     4805   if p-pos-type = 'IBM-XML':U
     4806   or p-pos-type = 'Autotank':U
     4807   then do:
     4808       run write-log-and-file in p-log-handle (
     4809             input 1
     4810           , input log-file-name
     4811           , input 1
     4812           , input substitute( "!!!&1"
     4813                             , (if v-errorseverity = 0
     4814                                 then "Информация"
     4815                                 else (if v-Errorseverity = 1
     4816                                       then "Предупреждение"
     4817                                       else "Ошибка"
     4818                                       )
     4819                                 ))
     4820                                 ).
     4821       assign
     4822       p-view-log = yes
     4823       .
     4824   end.
     4825   end procedure .
     4826   procedure cb-xmlparse-tag-start-err:
     4827   define input parameter p-parameter as character no-undo .
     4828   do
     4829   on error undo, return error
     4830   :
     4831     if v-is-spool-file
     4832     then do:
     4833       assign
     4834       v-start-err = v-start-err + 1
     4835       v-num-errors = v-num-errors + 1
     4836       v-errormessage = '':U
     4837       v-errorseverity = 0
     4838       v-errornum = '':U
     4839       .
     4840       if p-pos-type = 'MAGIA-XML':U then do:
     4841         assign
     4842         v-ErrorMessage = cb-xmlparse-get-attr(
     4843                                   input this-procedure:handle
     4844                                 ,input p-spool-or-data
     4845                                 ,input p-parameter
     4846                                 ,input "ErrorMessage":U
     4847                                 ,input yes)
     4848         v-ErrorNum =  cb-xmlparse-get-attr(
     4849                                   input this-procedure:handle
     4850                                 ,input p-spool-or-data
     4851                                 ,input p-parameter
     4852                                 ,input "Error":U
     4853                                 ,input no)
     4854         v-ErrorSeverity =  integer(cb-xmlparse-get-attr(
     4855                                   input this-procedure:handle
     4856                                 ,input p-spool-or-data
     4857                                 ,input p-parameter
     4858                                 ,input "ErrorSeverity":U
     4859                                 ,input no))
     4860         no-error
     4861         .
     4862         run write-log-and-file in p-log-handle (
     4863               input 1
     4864             , input log-file-name
     4865             , input 1
     4866             , input substitute( "!!!&1: &2 &3                   Код &4"
     4867                                 , (if v-errorseverity = 0
     4868                                   then "Информация"
     4869                                   else (if v-Errorseverity = 1
     4870                                         then "Предупреждение"
     4871                                         else "Ошибка"
     4872                                         )
     4873                                   )
     4874                                 , v-ErrorMessage
     4875                                 , chr(10)
     4876                                 , v-ErrorNum
     4877                               )
     4878                                             ).
     4879         assign
     4880         p-view-log = yes
     4881         .
     4882       end.
     4883     end.
     4884     else do:
     4885         run write-log-and-file in p-log-handle (
     4886               input 1
     4887             , input log-file-name
     4888             , input 1
     4889             , input substitute( "!!!Нарушение протокола обмена : тэг Err", p-spool-or-data
     4890                               )
     4891                                             ).
     4892         assign
     4893         p-view-log = yes
     4894         .
     4895     end.
     4896   end.
     4897   end procedure.
     4898   procedure cb-xmlparse-tag-end-err :
     4899   define input parameter p-parameter as character no-undo .
     4900   do
     4901   on error undo, return error
     4902   :
     4903     if p-pos-type = 'MAGIA-XML':U then do:
     4904       if v-start-err =  1 then do:
     4905         assign
     4906         v-start-err = 0
     4907         .
     4908       end.
     4909       else do:
     4910         assign
     4911         v-start-err = v-start-err - 1
     4912         .
     4913       end.
     4914     end.
     4915     if p-pos-type = 'IBM-XML':U
     4916     or p-pos-type = 'Autotank':U
     4917     then do:
     4918       assign
     4919       v-errornum = v-xmlvalid-tag-value
     4920       no-error .
     4921       run write-log-and-file in p-log-handle (
     4922             input 1
     4923           , input log-file-name
     4924           , input 1
     4925           , input substitute( "!!!           Код &1"
     4926                               , v-ErrorNum  )
     4927                                           ).
     4928       assign
     4929       p-view-log = yes
     4930       .
     4931     end.
     4932   end.
     4933   end procedure.
     4934   PROCEDURE fill-doc-property :
     4935   do
     4936   on error undo, return error
     4937   :
     4938   define input parameter p-tag-name   as character    no-undo.
     4939   define input parameter p-tag-value  as character    no-undo.
     4940   define buffer buf_db for ub.db.
     4941   if v-mail-parameters-start = yes
     4942   then do:
     4943     CASE p-tag-name:
     4944       when "DocumentName":U
     4945       then do:
     4946         if p-tag-value = p-spool-or-data then do:
     4947         end.
     4948         else do:
     4949         end.
     4950       end.
     4951       when "DateFormat":U
     4952       then do:
     4953         assign
     4954         v-date-format = p-tag-value
     4955         .
     4956       end.
     4957       when "DocumentVersion":U
     4958       then do:
     4959         assign
     4960         v-version = p-tag-value
     4961         .
     4962       end.
     4963       when "DecimalSeparator":U
     4964       then do:
     4965         assign
     4966         v-dec-sep = p-tag-value
     4967         .
     4968       end.
     4969       when "objList":U then do:
     4970       end.
     4971       when "dbEncKey":U then do:
     4972         assign
     4973         v-db-key-enc = p-tag-value
     4974         .
     4975         find first buf_db where buf_db.db-num = g#db-num no-lock.
     4976         if buf_db.db-key-enc = v-db-key-enc then do:
     4977           return error
     4978           substitute("Кодир. значение ключа БД-приемника &1 совпадает с кодир. значением ключа БД-источника &2&3- импорт данных со своей БД на свою БД невозможен"
     4979                      , buf_Db.db-key-enc
     4980                      , v-db-key-enc
     4981                      , chr(10)).
     4982         end.
     4983       end.
     4984     end case.
     4985   end.
     4986   end.
     4987   end PROCEDURE.
     4988   procedure create-temp-table-record :
     4989   define input parameter p-record-name as character no-undo .
     4990   define input parameter p-field-name as character no-undo .
     4991   define input parameter p-field-value as character no-undo .
     4992     do
     4993     on error undo, return error
     4994     :
     4995       if p-record-name = "Param" or p-record-name = "FuelPump" then do:
     4996       find first temp-param where
     4997                  temp-param.cr = cri + 1 no-error .
     4998       if not avail temp-param then do:
     4999         create
     5000         temp-param.
     5001         assign
     5002         temp-param.cr = cri + 1
     5003         .
     5004       end.
     5005       assign
     5006       temp-param.record-name = p-record-name
     5007       temp-param.field-name  = p-field-name
     5008       temp-param.field-value = p-field-value
     5009       temp-param.desk        = m-head-cash-num
     5010       temp-param.key-name    = v-key
     5011       temp-param.group-name  = v-group
     5012       cri                   = cri + 1
     5013       .
     5014       end.
     5015       else do:
     5016       find first temp-temp where
     5017                  temp-temp.cr = cri + 1 no-error .
     5018       if not avail temp-temp then do:
     5019         create
     5020         temp-temp.
     5021         assign
     5022         temp-temp.cr = cri + 1
     5023         .
     5024       end.
     5025       assign
     5026       temp-temp.record-name = p-record-name
     5027       temp-temp.field-name  = p-field-name
     5028       temp-temp.field-value = p-field-value
     5029       temp-temp.id          = v-id
     5030       temp-temp.ctime       = v-time
     5031       cri                   = cri + 1
     5032       .
     5033       end.
     5034     end.
     5035   end procedure.
     5036   define TEMP-TABLE tt-chk-doc      LIKE ub.chk-doc.
