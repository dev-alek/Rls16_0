     3443   procedure create-temp-ivs-ibs-line :
     3444   define input parameter ret-item as character no-undo .
     3445   define input parameter wro-item as character no-undo .
     3446   define input parameter ret-chk as character no-undo .
     3447   define input parameter wro-chk as character no-undo .
     3448   define input parameter ret-ord as character no-undo .
     3449   define input parameter wro-ord as character no-undo .
     3450   define variable ii as integer no-undo .
     3451   DEFINE VARIABLE v-full-path               as character                no-undo .
     3452   DEFINE VARIABLE v-file-name               as character                no-undo .
     3453   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     3454   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     3455   define buffer buf_temp-ivs-ibs for temp-ivs-ibs.
     3456   define buffer buf2_temp-ivs-ibs for temp-ivs-ibs.
     3457     do
     3458     on error undo, return error return-value
     3459     :
     3460   run gbl/filename.p (
     3461                   input 'cmp/ivs-ibs.d'
     3462                  ,output v-full-path
     3463                  ,output v-path
     3464                  ,output v-file-name
     3465                  ,output v-file-name-no-ext
     3466                  ,output v-file-name-ext
     3467                  ) no-error .
     3468       input from value(v-full-path).
     3469       repeat:
     3470         create buf_temp-ivs-ibs.
     3471         import buf_temp-ivs-ibs.
     3472       END.
     3473       input close.
     3474       _n:
     3475       for each buf_temp-ivs-ibs:
     3476         if buf_temp-ivs-ibs.chtype = '':U then do:
     3477           delete buf_temp-ivs-ibs.
     3478           next _n.
     3479         end.
     3480         assign
     3481         buf_temp-ivs-ibs.rcpt-type-1 = replace(buf_temp-ivs-ibs.rcpt-type-1, 'rcpt-sale', '1':U)
     3482         buf_temp-ivs-ibs.rcpt-type-2 = replace(buf_temp-ivs-ibs.rcpt-type-2, 'rcpt-sale', '1':U)
     3483         buf_temp-ivs-ibs.rcpt-type-1 = replace(buf_temp-ivs-ibs.rcpt-type-1, 'rcpt-return-write-off', '96':U)
     3484         buf_temp-ivs-ibs.rcpt-type-2 = replace(buf_temp-ivs-ibs.rcpt-type-2, 'rcpt-return-write-off', '96':U)
     3485         buf_temp-ivs-ibs.rcpt-type-1 = replace(buf_temp-ivs-ibs.rcpt-type-1, 'rcpt-return', '6':U)
     3486         buf_temp-ivs-ibs.rcpt-type-2 = replace(buf_temp-ivs-ibs.rcpt-type-2, 'rcpt-return', '6':U)
     3487         buf_temp-ivs-ibs.rcpt-type-1 = replace(buf_temp-ivs-ibs.rcpt-type-1, 'rcpt-write-off', '69':U)
     3488         buf_temp-ivs-ibs.rcpt-type-2 = replace(buf_temp-ivs-ibs.rcpt-type-2, 'rcpt-write-off', '69':U)
     3489         buf_temp-ivs-ibs.rcpt-type-1 = replace(buf_temp-ivs-ibs.rcpt-type-1, 'rcpt-annu', '8':U)
     3490         buf_temp-ivs-ibs.rcpt-type-2 = replace(buf_temp-ivs-ibs.rcpt-type-2, 'rcpt-annu', '8':U)
     3491         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-without-payment', '1':U)
     3492         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-without-payment', '1':U)
     3493         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-r-modificator-wp', '3':U)
     3494         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-r-modificator-wp', '3':U)
     3495         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-r-modificator', '2':U)
     3496         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-r-modificator', '2':U)
     3497         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-cancell-item', '-6':U)
     3498         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-cancell-item', '-6':U)
     3499         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-cancell-all', '-9':U)
     3500         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-cancell-all', '-9':U)
     3501         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator-ci', '-3':U)
     3502         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator-ci', '-3':U)
     3503         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator-ca', '-4':U)
     3504         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator-ca', '-4':U)
     3505         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator', '-2':U)
     3506         buf_temp-ivs-ibs.wro-code = replace(buf_temp-ivs-ibs.wro-code, 'wro-v-modificator', '-2':U)
     3507         .
     3508         if buf_temp-ivs-ibs.cancelcode = 'ret-item':U then do:
     3509           do ii = 1 to num-entries(ret-item, ';'):
     3510             create
     3511             buf2_temp-ivs-ibs.
     3512             buffer-copy buf_temp-ivs-ibs to
     3513             buf2_temp-ivs-ibs
     3514             assign
     3515             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, ret-item, ';':U)).
     3516           end.
     3517            delete buf_temp-ivs-ibs.
     3518            next _n.
     3519         end.
     3520         if buf_temp-ivs-ibs.cancelcode = 'wro-item':U then do:
     3521           do ii = 1 to num-entries(wro-item, ';'):
     3522             create
     3523             buf2_temp-ivs-ibs.
     3524             buffer-copy buf_temp-ivs-ibs to
     3525             buf2_temp-ivs-ibs
     3526             assign
     3527             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, wro-item, ';':U)).
     3528           end.
     3529           delete buf_temp-ivs-ibs.
     3530           next _n.
     3531         end.
     3532         if buf_temp-ivs-ibs.cancelcode = 'ret-chk':U then do:
     3533           do ii = 1 to num-entries(ret-chk, ';'):
     3534             create
     3535             buf2_temp-ivs-ibs.
     3536             buffer-copy buf_temp-ivs-ibs to
     3537             buf2_temp-ivs-ibs
     3538             assign
     3539             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, ret-chk, ';':U)).
     3540           end.
     3541           delete buf_temp-ivs-ibs.
     3542           next _n.
     3543         end.
     3544         if buf_temp-ivs-ibs.cancelcode = 'wro-chk':U then do:
     3545           do ii = 1 to num-entries(wro-chk, ';'):
     3546             create
     3547             buf2_temp-ivs-ibs.
     3548             buffer-copy buf_temp-ivs-ibs to
     3549             buf2_temp-ivs-ibs
     3550             assign
     3551             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, wro-chk, ';':U)).
     3552           end.
     3553           delete buf_temp-ivs-ibs.
     3554           next _n.
     3555         end.
     3556         if buf_temp-ivs-ibs.cancelcode = 'ret-ord':U then do:
     3557           do ii = 1 to num-entries(ret-ord, ';'):
     3558             create
     3559             buf2_temp-ivs-ibs.
     3560             buffer-copy buf_temp-ivs-ibs to
     3561             buf2_temp-ivs-ibs
     3562             assign
     3563             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, ret-ord, ';':U)).
     3564           end.
     3565           delete buf_temp-ivs-ibs.
     3566           next _n.
     3567         end.
     3568         if buf_temp-ivs-ibs.cancelcode = 'wro-ord':U then do:
     3569           do ii = 1 to num-entries(wro-ord, ';'):
     3570             create
     3571             buf2_temp-ivs-ibs.
     3572             buffer-copy buf_temp-ivs-ibs to
     3573             buf2_temp-ivs-ibs
     3574             assign
     3575             buf2_temp-ivs-ibs.cancelcode = entry(1, entry(ii, wro-ord, ';':U)).
     3576           end.
     3577            delete buf_temp-ivs-ibs.
     3578            next _n.
     3579         end.
     3580         end.
     3581       end.
     3582   end procedure.
