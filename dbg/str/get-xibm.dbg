     1999   procedure xmlchar-decode :
     2000   define input parameter p-in-string      as character        no-undo.
     2001   define output parameter p-out-string    as character        no-undo.
     2002       define variable v-position      as integer      no-undo.
     2003       define variable v-last-position as integer      no-undo.
     2004       define variable v-temp-integer  as integer      no-undo.
     2005       define variable v-current-char  as character    no-undo.
     2006       define variable v-next-char     as character    no-undo.
     2007       define variable v-success       as logical      no-undo.
     2008   do
     2009   on error undo, return error
     2010   :
     2011       assign
     2012           p-out-string = "":U
     2013           v-position   = 0
     2014       .
     2015       replace-cycle:
     2016       do while yes
     2017       on error undo, return error
     2018       :
     2019           assign
     2020               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2021           .
     2022           if v-last-position <= v-position
     2023           then do:
     2024               if v-position = 0
     2025               then do:
     2026                   assign
     2027                       p-out-string = p-in-string
     2028                   .
     2029               end.
     2030               else do:
     2031                   assign
     2032                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2033                   .
     2034               end.
     2035               leave replace-cycle.
     2036           end.
     2037           else do:
     2038               assign
     2039                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2040                   v-position      = v-last-position
     2041                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2042               .
     2043               if v-current-char = "#":U
     2044               then do:
     2045                   assign
     2046                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2047                   .
     2048                   if v-last-position > 0
     2049                   then do:
     2050                       run xmlchar-read-integer in this-procedure
     2051                        (
     2052                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2053                           , output v-temp-integer
     2054                           , output v-success
     2055                       ).
     2056                       if v-success = yes
     2057                       and v-temp-integer >= 1
     2058                       and v-temp-integer <= 255
     2059                       then do:
     2060                           assign
     2061                               p-out-string = p-out-string + chr( v-temp-integer )
     2062                               v-position   = v-last-position + 1
     2063                           .
     2064                       end.
     2065                       else do:
     2066                           assign
     2067                               p-out-string = p-out-string + "&":U
     2068                               v-position   = v-position   + 1
     2069                           .
     2070                       end.
     2071                   end.
     2072                   else do:
     2073                       assign
     2074                           p-out-string = p-out-string + "&":U
     2075                           v-position   = v-position   + 1
     2076                       .
     2077                   end.
     2078               end.
     2079               else do:
     2080                   case substring( p-in-string, v-position + 1, 3 )
     2081                   :
     2082                       when "lt;":U
     2083                       then do:
     2084                           assign
     2085                               p-out-string = p-out-string + "<":U
     2086                               v-position   = v-position   + 3
     2087                           .
     2088                       end.
     2089                       when "gt;":U
     2090                       then do:
     2091                           assign
     2092                               p-out-string = p-out-string + ">":U
     2093                               v-position   = v-position   + 3
     2094                           .
     2095                       end.
     2096                       otherwise do:
     2097                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2098                           then do:
     2099                               assign
     2100                                   p-out-string = p-out-string + "&":U
     2101                                   v-position   = v-position   + 4
     2102                               .
     2103                           end.
     2104                           else do:
     2105                               case substring( p-in-string, v-position + 1, 5 )
     2106                               :
     2107                                   when "quot;":U
     2108                                   then do:
     2109                                       assign
     2110                                           p-out-string = p-out-string + '"':U
     2111                                           v-position   = v-position   + 5
     2112                                       .
     2113                                   end.
     2114                                   when "apos;":U
     2115                                   then do:
     2116                                       assign
     2117                                           p-out-string = p-out-string + "'":U
     2118                                           v-position   = v-position   + 5
     2119                                       .
     2120                                   end.
     2121                                   otherwise do:
     2122                                       assign
     2123                                           p-out-string = p-out-string + "&":U
     2124                                       .
     2125                                   end.
     2126                               end case.
     2127                           end.
     2128                       end.
     2129                   end case.
     2130               end.
     2131           end.
     2132       end.
     2133   end.
     2134   end .
     2135   procedure xmlchar-read-integer :
     2136   define input parameter p-input-string      as character        no-undo.
     2137   define output parameter p-output-integer   as integer          no-undo.
     2138   define output parameter p-success       as logical          no-undo.
     2139   do
     2140   on error undo, return error
     2141   :
     2142       assign
     2143           p-output-integer = integer( p-input-string )
     2144       no-error.
     2145       if error-status :error
     2146       then do:
     2147           assign
     2148               p-success           = no
     2149               p-output-integer    = 0
     2150           .
     2151       end.
     2152       else do:
     2153           assign
     2154               p-success           = yes
     2155           .
     2156       end.
     2157   end.
     2158   end.
     2159   define variable vss-include-info9 as character format "X(65)" no-undo
     2160   initial "@(#)$Workfile$ $Revision$".
     2161   define temp-table temp_xmlparse-attrs no-undo
     2162   field field-name as character
     2163   field attr-code as character
     2164   field attr-value as character
     2165   index pi is unique primary
     2166   field-name attr-code
     2167   .
     2168   procedure xmlparse :
     2169   define input parameter p-handle         as handle           no-undo.
     2170   define input parameter p-XML-buffer     as character        no-undo.
     2171   define input parameter p-call-mode      as character        no-undo.
     2172       define variable v-procedure-type        as character    no-undo.
     2173       define variable v-procedure-name        as character    no-undo.
     2174       define variable v-temp-string           as character    no-undo.
     2175       define variable v-current-position      as integer      no-undo.
     2176       define variable v-end-position          as integer      no-undo.
     2177       define variable v-text-position         as integer      no-undo.
     2178       define variable v-input-buffer-length   as integer      no-undo.
     2179       define variable v-handle                as handle       no-undo.
     2180       define variable v-call-mode             as character    no-undo.
     2181       define variable v-proc-type             as character    no-undo.
     2182       define variable v-proc-name             as character    no-undo.
     2183       define variable v-decode-string         as character    no-undo.
     2184   do
     2185   on error undo, return error
     2186   :
     2187       if not valid-handle( p-handle )
     2188       then do:
     2189           return.
     2190       end.
     2191       assign
     2192           v-end-position          = 1
     2193           v-current-position      = 1
     2194           v-input-buffer-length   = length( p-XML-buffer )
     2195       .
     2196       do
     2197       while v-end-position < v-input-buffer-length
     2198       :
     2199           assign
     2200               v-current-position = index( p-XML-buffer, "<":U, v-end-position )
     2201           .
     2202           if v-current-position = 0
     2203           then do:
     2204               assign
     2205                   v-decode-string = substring( p-XML-buffer, v-end-position )
     2206               .
     2207               run xmlchar-decode in this-procedure (
     2208                     input v-decode-string
     2209                   , output v-temp-string
     2210               ).
     2211               assign
     2212                   v-handle     = p-handle
     2213                   v-call-mode  = p-call-mode
     2214                   v-proc-type  = 'text':U
     2215                   v-proc-name  = '':U
     2216               .
     2217               run run-callback-procedure in this-procedure (
     2218                     input v-handle
     2219                   , input v-call-mode
     2220                   , input v-proc-type
     2221                   , input v-proc-name
     2222                   , input v-temp-string
     2223               ).
     2224               assign
     2225                   v-end-position = v-input-buffer-length
     2226               .
     2227           end.
     2228           else do:
     2229               if v-current-position > v-end-position
     2230               then do:
     2231                   assign
     2232                       v-decode-string = substring( p-XML-buffer, v-end-position, v-current-position - v-end-position )
     2233                   .
     2234                   run xmlchar-decode in this-procedure (
     2235                         input v-decode-string
     2236                       , output v-temp-string
     2237                   ).
     2238                   assign
     2239                       v-end-position = v-current-position
     2240                   .
     2241                   assign
     2242                       v-handle     = p-handle
     2243                       v-call-mode  = p-call-mode
     2244                       v-proc-type  = 'text':U
     2245                       v-proc-name  = '':U
     2246                   .
     2247                   run run-callback-procedure in this-procedure (
     2248                         input v-handle
     2249                       , input v-call-mode
     2250                       , input v-proc-type
     2251                       , input v-proc-name
     2252                       , input v-temp-string
     2253                   ).
     2254               end.
     2255               assign
     2256                   v-decode-string = substring( p-XML-buffer, v-end-position + 1, 1 )
     2257               .
     2258               if v-decode-string = "/":U
     2259               then do:
     2260                   assign
     2261                       v-procedure-type    = "tag-end":U
     2262                       v-end-position      = v-current-position + 1
     2263                   .
     2264               end.
     2265               else do:
     2266                   assign
     2267                       v-procedure-type    = "tag-start":U
     2268                       v-end-position      = v-current-position
     2269                   .
     2270               end.
     2271               assign
     2272                   v-current-position  = index(p-XML-buffer, "/>":U, v-end-position)
     2273               .
     2274               if v-current-position <= v-end-position
     2275               then do:
     2276                   assign
     2277                       v-current-position  = index(p-XML-buffer, ">":U, v-end-position)
     2278                   .
     2279               end.
     2280               assign
     2281                   v-end-position      = v-end-position + 1
     2282               .
     2283               if v-current-position <= v-end-position
     2284               then do:
     2285                   run run-cb-xmlparse-error in this-procedure
     2286                                           (   input p-handle
     2287                                           ,   input 'Ошибка: знак < без завершающего > на той же строке'
     2288                                           ).
     2289                   assign
     2290                       v-temp-string   = "<":U + substring(p-XML-buffer, v-end-position)
     2291                       v-end-position  = v-input-buffer-length
     2292                   .
     2293                   assign
     2294                       v-handle     = p-handle
     2295                       v-call-mode  = p-call-mode
     2296                       v-proc-type  = 'text':U
     2297                       v-proc-name  = '':U
     2298                   .
     2299                   run run-callback-procedure in this-procedure (
     2300                         input v-handle
     2301                       , input v-call-mode
     2302                       , input v-proc-type
     2303                       , input v-proc-name
     2304                       , input v-temp-string
     2305                   ).
     2306               end.
     2307               else do:
     2308                   assign
     2309                       v-temp-string   = trim( substring(      p-XML-buffer
     2310                                                           ,   v-end-position
     2311                                                           ,   v-current-position - v-end-position
     2312                                             )          )
     2313                       v-text-position = index( v-temp-string, " ":U )
     2314                   .
     2315                   if v-text-position <> 0
     2316                   then do:
     2317                       assign
     2318                           v-procedure-name    =   trim( substring(      v-temp-string
     2319                                                                       ,   1
     2320                                                                       ,   v-text-position
     2321                                                         )          )
     2322                           v-temp-string       =   trim( substring(    v-temp-string
     2323                                                                   ,   v-text-position + 1
     2324                                                       )          )
     2325                       .
     2326                   end.
     2327                   else do:
     2328                       assign
     2329                           v-procedure-name    =   v-temp-string
     2330                           v-temp-string       =   "":U
     2331                       .
     2332                   end.
     2333                   assign
     2334                       v-end-position      = v-current-position + 1
     2335                   .
     2336                   assign
     2337                       v-handle          = p-handle
     2338                       v-call-mode       = p-call-mode
     2339                   .
     2340                   run run-callback-procedure in this-procedure (
     2341                         input v-handle
     2342                       , input v-call-mode
     2343                       , input v-procedure-type
     2344                       , input v-procedure-name
     2345                       , input v-temp-string
     2346                   ).
     2347               end.
     2348           end.
     2349       end.
     2350   end.
     2351   end procedure.
     2352   procedure run-callback-procedure :
     2353   define input parameter p-handle             as handle           no-undo.
     2354   define input parameter p-call-mode          as character        no-undo.
     2355   define input parameter p-procedure-type     as character        no-undo.
     2356   define input parameter p-procedure-name     as character        no-undo.
     2357   define input parameter p-param-value        as character        no-undo.
     2358       define variable v-data-type         as character            no-undo.
     2359       define variable v-data-value        as character            no-undo.
     2360       define variable v-procedure-name    as character            no-undo.
     2361       define variable v-procedure-exists  as logical      no-undo.
     2362   do
     2363   on error undo, return error
     2364   :
     2365       if p-call-mode = "call-all":U
     2366       or p-call-mode = "call-named":U
     2367       then do:
     2368           case p-procedure-type :
     2369               when "text":U
     2370               then do:
     2371                   assign
     2372                       v-procedure-name = "cb-xmlparse-text":U
     2373                   .
     2374               end.
     2375               when "tag-end":U
     2376               then do:
     2377                   assign
     2378                       v-procedure-name = "cb-xmlparse-tag-end-":U + p-procedure-name
     2379                   .
     2380               end.
     2381               when "tag-start":U
     2382               then do:
     2383                   assign
     2384                       v-procedure-name = "cb-xmlparse-tag-start-":U + p-procedure-name
     2385                   .
     2386               end.
     2387               otherwise do:
     2388                   assign
     2389                       v-procedure-name = p-procedure-name
     2390                   .
     2391               end.
     2392           end case.
     2393           if p-handle :get-signature( v-procedure-name ) = "":U
     2394           then do:
     2395               assign
     2396                   v-procedure-exists = no
     2397               .
     2398           end.
     2399           else do:
     2400               assign
     2401                   v-procedure-exists = yes
     2402               .
     2403           end.
     2404           if v-procedure-exists = yes
     2405           then do:
     2406               run value(v-procedure-name) in p-handle (input p-param-value) no-error.
     2407               if error-status :error
     2408               then do:
     2409                   run run-cb-xmlparse-error in this-procedure (
     2410                       input p-handle
     2411                       , input "Ошибка при вызове программы " + v-procedure-name
     2412                   ).
     2413               end.
     2414           end.
     2415       end.
     2416       if ( p-call-mode = "call-all":U
     2417           and v-procedure-exists <> yes )
     2418       or p-call-mode = "call-unnamed":U
     2419       then do:
     2420           case p-procedure-type :
     2421               when 'text':U
     2422               then do:
     2423                   assign
     2424                       v-data-type     = 'text':U
     2425                       v-data-value    = p-param-value
     2426                   .
     2427               end.
     2428               when 'tag-end':U
     2429               then do:
     2430                   assign
     2431                       v-data-type     = 'tag-end':U
     2432                       v-data-value    = p-procedure-name
     2433                   .
     2434               end.
     2435               when 'tag-start':U
     2436               then do:
     2437                   assign
     2438                       v-data-type     = 'tag-start':U
     2439                       v-data-value    = p-procedure-name
     2440                   .
     2441               end.
     2442               otherwise do:
     2443                   assign
     2444                       v-data-type     = 'text':U
     2445                       v-data-value    = p-procedure-name
     2446                   .
     2447               end.
     2448           end case.
     2449           run run-cb-xmlparse-procedure-not-found in this-procedure (
     2450                 input p-handle
     2451               , input v-data-type
     2452               , input v-data-value
     2453               , input p-param-value
     2454           ).
     2455       end.
     2456   end.
     2457   end procedure.
     2458   procedure run-cb-xmlparse-error :
     2459   do
     2460   on error undo, return error
     2461   :
     2462       def input parameter p-handle            as handle no-undo.
     2463       def input parameter p-error-message as char no-undo.
     2464       if lookup("cb-xmlparse-error", p-handle :internal-entries) > 0
     2465       then do:
     2466           run cb-xmlparse-error in p-handle  (input p-error-message).
     2467       end.
     2468   end.
     2469   end procedure.
     2470   procedure run-cb-xmlparse-procedure-not-found :
     2471   do
     2472   on error undo, return error
     2473   :
     2474       def input parameter p-handle            as handle no-undo.
     2475       def input parameter p-data-type         as char no-undo.
     2476       def input parameter p-data-value        as char no-undo.
     2477       def input parameter p-param-value       as char no-undo.
     2478       if lookup("cb-xmlparse-procedure-not-found", p-handle :internal-entries) > 0
     2479       then do:
     2480           run cb-xmlparse-procedure-not-found in p-handle    (   input p-data-type
     2481                                                             , input p-data-value
     2482                                                             , input p-param-value
     2483                                                           ) no-error.
     2484           if error-status :error
     2485           then do:
     2486               run run-cb-xmlparse-error in this-procedure
     2487                                       (   input p-handle
     2488                                       ,   input "Ошибка при вызове программы cb-xmlparse-procedure-not-found"
     2489                                       ).
     2490           end.
     2491       end.
     2492       else do:
     2493           run run-cb-xmlparse-error in this-procedure
     2494                                   (   input p-handle
     2495                                   ,   input "Ошибка: Не определена программа cb-xmlparse-procedure-not-found"
     2496                                   ).
     2497       end.
     2498   end.
     2499   end procedure.
     2500   procedure cb-xmlparse-attributes :
     2501   define input  parameter p-handle            as handle no-undo.
     2502   define input  parameter p-field-name        as character no-undo .
     2503   define input  parameter p-field-value       as character no-undo .
     2504   define variable ii as integer no-undo init 1.
     2505   define variable v-input-buffer-length   as integer no-undo.
     2506   define variable v-dc as logical no-undo .
     2507   define variable v-sc as logical no-undo .
     2508   define variable v-eq as logical no-undo .
     2509   define variable v-char as character no-undo .
     2510   define variable v-code as character no-undo .
     2511   define variable v-value as character no-undo .
     2512   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
     2513     do
     2514     on error undo, return error
     2515     :
     2516       if index(p-field-value, '>':U) > 0 then do:
     2517         run run-cb-xmlparse-error in this-procedure
     2518                                 (   input p-handle
     2519                                 ,   input substitute("Ошибка: тэг &1 содержит другие тэги", p-field-name)
     2520                                 ).
     2521       end.
     2522       assign
     2523       p-field-value = trim(p-field-value)
     2524       .
     2525       for each buf_temp_xmlparse-attrs where
     2526               buf_temp_xmlparse-attrs.field-name = p-field-name:
     2527         delete buf_temp_xmlparse-attrs.
     2528       end.
     2529       assign
     2530       v-input-buffer-length = length( p-field-value )
     2531       .
     2532       do while ii <= v-input-buffer-length:
     2533         assign
     2534         v-char = substr(p-field-value, ii, 1)
     2535         ii = ii + 1
     2536         .
     2537         CASE v-char:
     2538           when "=":U then do:
     2539             if v-eq
     2540             and not v-dc
     2541             and not v-sc then do:
     2542               return error.
     2543             end.
     2544             assign
     2545             v-eq = yes
     2546             .
     2547           end.
     2548           when chr(34) then do:
     2549           if v-eq then
     2550           assign
     2551           v-dc = not(v-dc)
     2552           .
     2553           else return error.
     2554           end.
     2555           when chr(39) then do:
     2556           if v-eq then
     2557           assign
     2558           v-sc = not(v-sc)
     2559           .
     2560           else return error.
     2561           end.
     2562           when chr(32) then do:
     2563             if not v-dc
     2564             and not v-sc
     2565             then do:
     2566               assign
     2567               v-sc = no
     2568               v-dc = no
     2569               v-eq = no
     2570               .
     2571               create buf_temp_xmlparse-attrs.
     2572               assign
     2573               buf_temp_xmlparse-attrs.field-name = p-field-name
     2574               buf_temp_xmlparse-attrs.attr-code  = v-code
     2575               buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     2576               v-code = "":U
     2577               v-value = "":U
     2578               .
     2579             end.
     2580           end.
     2581         END CASE.
     2582         if not v-eq
     2583         then do:
     2584           if not v-char = chr(32) then
     2585           assign
     2586           v-code = v-code + v-char
     2587           .
     2588         end.
     2589         else do:
     2590           if v-char <> "=":U
     2591           then
     2592           assign
     2593           v-value = v-value + v-char
     2594           .
     2595         end.
     2596       end.
     2597       if v-code <> "":U then do:
     2598         create buf_temp_xmlparse-attrs.
     2599         assign
     2600         buf_temp_xmlparse-attrs.field-name = p-field-name
     2601         buf_temp_xmlparse-attrs.attr-code  = v-code
     2602         buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     2603         .
     2604       end.
     2605     end.
     2606   end procedure.
     2607   FUNCTION cb-xmlparse-get-attr returns character (
     2608         input p-handle        as handle
     2609       , input p-field-name    as character
     2610       , input p-field-value   as character
     2611       , input p-attr-code     as character
     2612       , input p-reparse       as logical
     2613   ) :
     2614   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
     2615     do
     2616     on error undo, return error
     2617     :
     2618       if p-reparse then do:
     2619         run cb-xmlparse-attributes in this-procedure (
     2620                                                       input p-handle
     2621                                                     , input p-field-name
     2622                                                     , input p-field-value) no-error .
     2623         if error-status:error then return ? .
     2624       end.
     2625       find first buf_temp_xmlparse-attrs no-lock where
     2626                 buf_temp_xmlparse-attrs.field-name = p-field-name
     2627             AND buf_temp_xmlparse-attrs.attr-code   = p-attr-code no-error .
     2628       if not avail buf_temp_xmlparse-attrs then return ?.
     2629       return buf_temp_xmlparse-attrs.attr-value.
     2630     end.
     2631   end FUNCTION.
     2632   FUNCTION cb-xmlparse-get-date returns date (
     2633                                               input p-string as character):
     2634   define variable v-date as date.
     2635   if index(p-string, "-":U) = 0
     2636   or NOT (length(p-string) = 10
     2637           or
     2638           length(p-string) = 19)
     2639   then return error.
     2640   assign
     2641   v-date =  date(
     2642             int( substr( p-string, 6, 2 ) ) ,
     2643             int( substr( p-string, 9, 2 ) ),
     2644             int( substr( p-string, 1, 4 ) )
     2645               )
     2646   no-error .
     2647   if error-status:error then return error.
     2648   return v-date.
     2649   END FUNCTION.
     2650   FUNCTION cb-xmlparse-get-time returns integer (input p-string as character):
     2651   define variable v-time as integer no-undo .
     2652   define variable v-shift as integer no-undo .
     2653   if index(p-string, ":":U) = 0
     2654   or not (
     2655           length(p-string) = 19
     2656           or
     2657           length(p-string) = 8
     2658           )
     2659   then return error.
     2660   if length(p-string) = 19 then v-shift = 11.
     2661   assign
     2662   v-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     2663             int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     2664             int( substr( p-string, v-shift + 7, 2) )
     2665   no-error .
     2666   if error-status:error then return error.
     2667   return v-time.
     2668   END FUNCTION.
     2669   define variable vss-include-info10 as character format "X(65)" no-undo
     2670   initial "@(#)$Workfile$ $Revision$".
     2671   define variable v-xmlvalid-error-mode       as character    no-undo.
     2672   define variable v-xmlvalid-tag-value        as character    no-undo.
     2673   define variable v-xmlvalid-current-level    as integer      no-undo.
     2674   define variable v-xmlvalid-in-tag           as logical      no-undo.
     2675   define variable v-xmlvalid-read-vartype     as logical      no-undo.
     2676   define temp-table temp_xmlvalid-taglist no-undo
     2677       field level-num as integer
     2678       field tag-name  as character
     2679       index lv  is primary unique level-num
     2680   .
     2681   define temp-table temp_xmlvalid-field-types no-undo
     2682       field field-name as character
     2683       field field-type as character
     2684       index fn is primary unique field-name
     2685   .
     2686   procedure xmlvalid :
     2687     do
     2688     on error undo, return error
     2689     :
     2690       def input parameter p-handle                as handle   no-undo.
     2691       def input parameter p-buffer-string         as char     no-undo.
     2692       def input parameter p-xmlvalid-error-mode   as char     no-undo.
     2693       assign
     2694           v-xmlvalid-error-mode   = p-xmlvalid-error-mode
     2695       .
     2696       run xmlparse in this-procedure (
     2697                 input p-handle
     2698               , input p-buffer-string
     2699               , input "call-all":U
     2700       ).
     2701     end.
     2702   end procedure.
     2703   procedure cb-xmlparse-tag-start-varType :
     2704   do
     2705   on error undo, return error
     2706   :
     2707   define input parameter p-param as character    no-undo.
     2708       assign
     2709           v-xmlvalid-read-vartype = yes
     2710       .
     2711       run cb-xmlparse-procedure-not-found in this-procedure (
     2712             input "tag-start":U
     2713           , input "varType":U
     2714           , input p-param
     2715       ).
     2716   end.
     2717   end procedure.
     2718   procedure cb-xmlparse-tag-end-varType :
     2719   do
     2720   on error undo, return error
     2721   :
     2722   define input parameter p-param as character    no-undo.
     2723       assign
     2724           v-xmlvalid-read-vartype = no
     2725       .
     2726       define variable v-vartype-list     as character         no-undo.
     2727       for each temp_xmlvalid-field-types
     2728       :
     2729           if index( "character,integer,decimal,date,logical", temp_xmlvalid-field-types.field-type ) = 0
     2730           then do:
     2731               run run-cb-xmlvalid-error  in this-procedure
     2732                                           (     input this-procedure :handle
     2733                                               , input "Замечание: Тип переменной в секции varType определен неверно. "
     2734                                                       + "Тэг " + temp_xmlvalid-field-types.field-name
     2735                                                       + " не будет проверен на соответствие типу данных"
     2736                                           ).
     2737               delete temp_xmlvalid-field-types.
     2738           end.
     2739           else do:
     2740                                           assign
     2741                                               v-vartype-list = v-vartype-list + temp_xmlvalid-field-types.field-name
     2742                                               + temp_xmlvalid-field-types.field-type + chr(10)
     2743                                           .
     2744           end.
     2745       end.
     2746       run cb-xmlparse-procedure-not-found in this-procedure (
     2747                                           input "tag-end":U
     2748                                           , input "varType":U
     2749                                           , input p-param
     2750                                                           ).
     2751   end.
     2752   end procedure.
     2753   procedure cb-xmlparse-procedure-not-found :
     2754   do
     2755   on error undo, return error
     2756   :
     2757   def input parameter p-tag-type      as char no-undo.
     2758   def input parameter p-tag-value     as char no-undo.
     2759   def input parameter p-param-value   as char no-undo.
     2760   def buffer buf_temp_xmlvalid-taglist for temp_xmlvalid-taglist.
     2761   def var v-found    as logical  no-undo.
     2762   if p-tag-type = "tag-start"
     2763   then do:
     2764       assign
     2765           v-xmlvalid-current-level = v-xmlvalid-current-level + 1
     2766           v-xmlvalid-in-tag        = yes
     2767       .
     2768       find first temp_xmlvalid-taglist
     2769            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     2770       no-error.
     2771       if not available temp_xmlvalid-taglist
     2772       then do:
     2773           create temp_xmlvalid-taglist.
     2774           assign
     2775               temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     2776           .
     2777       end.
     2778       assign
     2779           temp_xmlvalid-taglist.tag-name = p-tag-value
     2780           v-xmlvalid-tag-value = ""
     2781       .
     2782       if v-xmlvalid-read-vartype = yes and p-tag-value <> "varType":U
     2783       then do:
     2784           find first temp_xmlvalid-field-types
     2785                where temp_xmlvalid-field-types.field-name = p-tag-value
     2786           no-error.
     2787           if available temp_xmlvalid-field-types
     2788           then do:
     2789               run run-cb-xmlvalid-error  in this-procedure
     2790                                           (     input this-procedure :handle
     2791                                               , input "Замечание: Тип переменной в секции varType определен повторно"
     2792                                           ).
     2793           end.
     2794           else do:
     2795               create temp_xmlvalid-field-types.
     2796               assign
     2797                   temp_xmlvalid-field-types.field-name = p-tag-value
     2798               .
     2799           end.
     2800       end.
     2801   end.
     2802   if p-tag-type = "tag-end"
     2803   then do:
     2804       find first temp_xmlvalid-taglist
     2805            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     2806              and temp_xmlvalid-taglist.tag-name  = p-tag-value
     2807       no-error.
     2808       if available temp_xmlvalid-taglist
     2809       then do:
     2810           assign
     2811               v-xmlvalid-current-level = v-xmlvalid-current-level - 1
     2812               v-xmlvalid-in-tag        = no
     2813           .
     2814       end.
     2815       else do:
     2816           if v-xmlvalid-error-mode = 'fatal'
     2817           then do:
     2818               run run-cb-xmlvalid-error  in this-procedure
     2819                                           (     input this-procedure :handle
     2820                                               , input "Ошибка: Попытка закрыть не открытый тэг"
     2821                                           ).
     2822           end.
     2823           else do:
     2824               find first temp_xmlvalid-taglist
     2825                    where temp_xmlvalid-taglist.tag-name = p-tag-value
     2826               no-error.
     2827               if not available temp_xmlvalid-taglist
     2828               then do:
     2829                   assign
     2830                       v-xmlvalid-tag-value = v-xmlvalid-tag-value + "</" + p-tag-value + ">" + chr(10)
     2831                   .
     2832               end.
     2833               else do:
     2834                   for each buf_temp_xmlvalid-taglist
     2835                      where buf_temp_xmlvalid-taglist.level-num > temp_xmlvalid-taglist.level-num
     2836                   :
     2837                       assign
     2838                           v-xmlvalid-tag-value = "<" + buf_temp_xmlvalid-taglist.tag-name + ">" + chr(10) + v-xmlvalid-tag-value
     2839                           v-xmlvalid-current-level = temp_xmlvalid-taglist.level-num - 1
     2840                       .
     2841                   end.
     2842               end.
     2843           end.
     2844       end.
     2845   end.
     2846   if p-tag-type = "text"
     2847   then do:
     2848       if v-xmlvalid-read-vartype = yes
     2849       then do:
     2850           if available temp_xmlvalid-field-types
     2851           then do:
     2852               assign
     2853                   temp_xmlvalid-field-types.field-type = v-xmlvalid-tag-value
     2854               .
     2855           end.
     2856       end.
     2857       else do:
     2858           find first temp_xmlvalid-field-types
     2859               where temp_xmlvalid-field-types.field-name = temp_xmlvalid-taglist.tag-name
     2860           no-error.
     2861           if available temp_xmlvalid-field-types
     2862           then do:
     2863           end.
     2864           else do:
     2865           end.
     2866       end.
     2867       assign
     2868           v-xmlvalid-tag-value = v-xmlvalid-tag-value + p-tag-value
     2869       .
     2870   end.
     2871   run run-cb-xmlvalid-procedure-not-found in this-procedure
     2872                                           (     input this-procedure :handle
     2873                                               , input p-tag-type
     2874                                               , input p-tag-value
     2875                                               , input p-param-value
     2876                                           ).
     2877   end.
     2878   end procedure.
     2879   procedure run-cb-xmlvalid-procedure-not-found :
     2880   do
     2881   on error undo, return error
     2882   :
     2883       def input parameter p-handle            as handle   no-undo.
     2884       def input parameter p-data-type         as char     no-undo.
     2885       def input parameter p-data-value        as char     no-undo.
     2886       def input parameter p-param-value       as char     no-undo.
     2887       if lookup("cb-xmlvalid-procedure-not-found", p-handle :internal-entries) > 0
     2888       then do:
     2889           run cb-xmlvalid-procedure-not-found in p-handle (   input p-data-type
     2890                                                             , input p-data-value
     2891                                                             , input p-param-value
     2892                                                           ) no-error.
     2893           if error-status :error
     2894           then do:
     2895               run run-cb-xmlvalid-error in this-procedure
     2896                                       (   input p-handle
     2897                                       ,   input "Ошибка при вызове программы cb-xmlvalid-procedure-not-found"
     2898                                       ).
     2899           end.
     2900       end.
     2901       else do:
     2902           run run-cb-xmlvalid-error in this-procedure
     2903                                   (   input p-handle
     2904                                   ,   input "Ошибка: Не определена программа cb-xmlvalid-procedure-not-found"
     2905                                   ).
     2906       end.
     2907   end.
     2908   end procedure.
     2909   procedure run-cb-xmlvalid-error :
     2910   do
     2911   on error undo, return error
     2912   :
     2913       def input parameter p-handle            as handle no-undo.
     2914       def input parameter p-error-message as char no-undo.
     2915       if lookup("cb-xmlvalid-error", p-handle :internal-entries) > 0
     2916       then do:
     2917           run cb-xmlvalid-error in p-handle  (input p-error-message).
     2918       end.
     2919   end.
     2920   end procedure.
     2921   procedure run-cb-xmlvalid-procedure :
     2922   do
     2923   on error undo, return error
     2924   :
     2925   def input parameter p-handle            as handle no-undo.
     2926   def input parameter p-procedure-name    as char no-undo.
     2927   def var v-data-type     as char no-undo.
     2928   def var v-data-value    as char no-undo.
     2929   def var v-param-value   as char no-undo.
     2930       if lookup( p-procedure-name, p-handle :internal-entries) > 0
     2931       then do:
     2932           run value(p-procedure-name) in p-handle no-error.
     2933           if error-status :error
     2934           then do:
     2935               run run-cb-xmlvalid-error in this-procedure
     2936                                       (   input p-handle
     2937                                       ,   input "Ошибка при вызове программы " + p-procedure-name
     2938                                       ).
     2939           end.
     2940       end.
     2941       else do:
     2942           if substring(p-procedure-name, 1, 20) = "cb-xmlvalid-tag-end-"
     2943           then do:
     2944               assign
     2945                   v-data-type     = "tag-end"
     2946                   v-data-value    = substring(p-procedure-name, 21)
     2947               .
     2948           end.
     2949           else do:
     2950               if substring(p-procedure-name, 1, 22) = "cb-xmlvalid-tag-start-"
     2951               then do:
     2952                   assign
     2953                       v-data-type     = "tag-start"
     2954                       v-data-value    = substring(p-procedure-name, 23)
     2955                   .
     2956               end.
     2957               else do:
     2958                   assign
     2959                       v-data-type     = "text"
     2960                       v-data-value    = p-procedure-name
     2961                   .
     2962               end.
     2963           end.
     2964           run run-cb-xmlvalid-procedure-not-found in this-procedure
     2965                                                  (   input p-handle
     2966                                                     , input v-data-type
     2967                                                     , input v-data-value
     2968                                                     , input v-param-value
     2969                                                   ).
     2970       end.
     2971   end.
     2972   end procedure.
     2973   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2974   procedure chkdocat-name :
     2975   do
     2976     on error undo, return error return-value
     2977     :
     2978     define input  parameter p-code           as character no-undo .
     2979     define output parameter p-type           as character no-undo .
     2980     define output parameter p-format         as character no-undo .
     2981     define output parameter p-label          as character no-undo .
     2982     define output parameter p-user-can-edit  as logical   no-undo .
     2983     define output parameter p-output-display as logical   no-undo .
     2984     define output parameter p-other          as character no-undo .
     2985       case p-code :
     2986               when 'lock':U then do:     assign     p-label = "Блокировка атрибутов на изменение"     p-type = 'L':U      p-format = "yes/no"     p-label = "Блокировка атрибутов на изменение"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     2987               when 'out-code-2':U then do:     assign     p-label = "Номер док-та, использующего чек"     p-type = 'C':U      p-format = "X(14)"     p-label = "Номер док-та, использующего чек"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     2988               when 'qr-alchol':U then do:     assign     p-label = "Qr-коды от ЕГАИС по алкоголю (кроме пива)"     p-type = 'C':U      p-format = "X(64)"     p-label = "Qr-коды от ЕГАИС по алкоголю (кроме пива)"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2989               when '':U then do:     assign     p-label = "Qr-коды от ЕГАИС по пиву)"     p-type = 'C':U      p-format = "X(64)"     p-label = "Qr-коды от ЕГАИС по пиву)"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2990         otherwise do:
     2991           undo, return error substitute("неизвестный атрибут чека &1", p-code ).
     2992         end.
     2993       end.
     2994     end.
     2995   end procedure.
     2996   procedure chkdocat-tooltip :
     2997   do
     2998     on error undo, return error return-value
     2999     :
     3000       define input  parameter p-code    as character no-undo .
