     1211   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   procedure gen-key-rec :
     1213     define input  parameter p-tbl-name    as character no-undo.
     1214     define input  parameter p-bh_tbl-name as handle    no-undo.
     1215     define output parameter p-key-rec     as character no-undo.
     1216     do
     1217     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1218     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1219     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1220     :
     1221       define variable fh               as handle    no-undo .
     1222       define variable v-ok             as logical   no-undo .
     1223       define variable v-inform         as character no-undo .
     1224       define variable v-ind            as integer   no-undo .
     1225       define variable v-idx-field-qnty as integer   no-undo .
     1226       if p-tbl-name = ?
     1227         or p-tbl-name = "":U
     1228       then do:
     1229         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1230       end.
     1231       if not p-bh_tbl-name:available then do:
     1232         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1233       end.
     1234       assign
     1235         p-key-rec = p-tbl-name
     1236         v-inform  = p-bh_tbl-name:index-information(1)
     1237         v-ind     = 2
     1238       .
     1239       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1240       on error undo, return error
     1241       :
     1242         assign
     1243           v-inform = p-bh_tbl-name:index-information( v-ind )
     1244           v-ind    = v-ind + 1
     1245         .
     1246       end.
     1247       if v-inform = ?
     1248         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1249         or entry( 3, v-inform, ",":U ) <> "1":U
     1250       then do:
     1251         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1252       end.
     1253       else do:
     1254         assign
     1255           v-idx-field-qnty = num-entries( v-inform ) - 4
     1256         .
     1257         if v-idx-field-qnty < 2 then do:
     1258           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1259         end.
     1260         do v-ind = 1 to v-idx-field-qnty by 2
     1261         on error undo, return error
     1262         :
     1263           assign
     1264             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1265             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1266           .
     1267         end.
     1268       end.
     1269       if p-key-rec = ? then do:
     1270         assign
     1271           p-key-rec = "":U
     1272         .
     1273         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1274       end.
     1275     end.
     1276     return.
     1277   end procedure.
     1278   procedure gen-where-keyr-tab :
     1279     define input  parameter i-tableSerach as character no-undo.
     1280     define input  parameter i-tablekey   as character  no-undo.
     1281     define input  parameter p-key-rec    as character  no-undo.
     1282     define input  parameter p-key-handle as handle     no-undo .
     1283     define input  parameter p-db-name    as character  no-undo .
     1284     define input  parameter p-tt-handle  as handle     no-undo .
     1285     define output parameter o-Where      as character  no-undo.
     1286     do
     1287     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1288     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1289     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1290     :
     1291       define variable v-full-tbl-name  as character no-undo .
     1292       define variable bh_tbl-name      as handle    no-undo .
     1293       define variable fh_key           as handle    no-undo .
     1294       define variable fh_search        as handle    no-undo .
     1295       define variable v-field-num      as integer   no-undo .
     1296       define variable v-count-fld      as integer   no-undo .
     1297       define variable v-inform         as character no-undo .
     1298       define variable v-ind            as integer   no-undo .
     1299       define variable v-idx-field-qnty as integer   no-undo .
     1300       define variable v-field-name     as character no-undo .
     1301       define variable v-field-val      as character no-undo .
     1302       define variable v-word-link      as character no-undo .
     1303       define variable vTable           as character no-undo.
     1304       define variable bh_tbl-key       as handle    no-undo .
     1305       assign
     1306         p-key-rec = trim( p-key-rec )
     1307       .
     1308       if p-key-handle <> ? then do:
     1309         if not valid-handle(p-key-handle)
     1310            or p-key-handle:type <> "buffer"
     1311         then do:
     1312           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1313         end.
     1314         if num-entries( p-key-rec, chr(3) ) > 1
     1315           or p-key-rec = ?
     1316           or p-key-rec = "":U
     1317         then do:
     1318           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1319         end.
     1320       end.
     1321       else do:
     1322         if p-key-rec = ?
     1323           or p-key-rec = "":U
     1324         then do:
     1325           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1326         end.
     1327       end.
     1328       assign
     1329         vTable = entry( 1 , p-key-rec, chr(3) )
     1330       .
     1331       if p-tt-handle <> ?
     1332         and ( not valid-handle(p-tt-handle)
     1333               or p-tt-handle:type <> "buffer"
     1334             )
     1335       then do:
     1336         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1337       end.
     1338       if p-tt-handle = ? then do:
     1339         assign
     1340           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1341         .
     1342         create buffer bh_tbl-name for table v-full-tbl-name .
     1343       end.
     1344       else do:
     1345         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1346       end.
     1347       assign
     1348         v-inform = bh_tbl-name:index-information(1)
     1349         v-ind    = 2
     1350       .
     1351       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1352       on error undo, return error
     1353       :
     1354         assign
     1355           v-inform = bh_tbl-name:index-information( v-ind )
     1356           v-ind    = v-ind + 1
     1357         .
     1358       end.
     1359       if v-inform = ?
     1360         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1361         or entry( 3, v-inform, ",":U ) <> "1":U
     1362       then do:
     1363         delete object bh_tbl-name no-error.
     1364         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1365       end.
     1366       assign
     1367         v-idx-field-qnty = num-entries( v-inform ) - 4
     1368       .
     1369       if v-idx-field-qnty < 2 then do:
     1370         delete object bh_tbl-name no-error.
     1371         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1372       end.
     1373       assign
     1374         o-where     = "where":U
     1375         v-word-link = "":U
     1376         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1377         v-count-fld = 0
     1378       .
     1379       if i-tablekey ne "" and i-tablekey ne ?
     1380       then do:
     1381         assign
     1382           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1383         .
     1384         create buffer bh_tbl-key for table v-full-tbl-name .
     1385       end.
     1386       if i-tableSerach ne "" and i-tableSerach ne ?
     1387       then do:
     1388         delete object bh_tbl-name no-error.
     1389         assign
     1390           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1391         .
     1392         create buffer bh_tbl-name for table v-full-tbl-name .
     1393       end.
     1394       block_where:
     1395       do v-ind = 1 to v-idx-field-qnty by 2
     1396       on error undo, return error
     1397       :
     1398         assign
     1399           v-count-fld = v-count-fld + 1
     1400         .
     1401         if p-key-handle = ?
     1402           and v-count-fld > v-field-num
     1403         then do:
     1404           leave block_where.
     1405         end.
     1406         define variable VfieldKeyTable as handle no-undo.
     1407         assign
     1408           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1409           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1410         .
     1411         if     bh_tbl-key ne ?
     1412         then do:
     1413            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1414            if VfieldKeyTable eq ?
     1415            then next block_where.
     1416         end.
     1417         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1418         then
     1419            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1420         else
     1421            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1422         if p-key-handle = ? then do:
     1423           assign
     1424             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1425           .
     1426         end.
     1427         else do:
     1428           assign
     1429             fh_key = p-key-handle:buffer-field( v-field-name )
     1430           .
     1431           if fh_key = ?
     1432             or not valid-handle( fh_key )
     1433           then do:
     1434             delete object bh_tbl-name.
     1435             if     bh_tbl-key ne ?
     1436             then
     1437                delete object bh_tbl-key.
     1438             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1439           end.
     1440           assign
     1441             v-field-val = fh_key:buffer-value
     1442           .
     1443         end.
     1444         if fh_search:data-type ="character":U then do:
     1445           assign
     1446             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1447             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1448             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1449             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1450             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1451             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1452             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1453             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1454             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1455             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1456             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1457             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1458             v-field-val = substitute( '"&1"', v-field-val )
     1459           .
     1460         end.
     1461         assign
     1462           o-where = substitute( "&1 &2", o-where, v-field-val )
     1463         .
     1464         if v-word-link = "":U then do:
     1465           assign
     1466             v-word-link = "and":U
     1467           .
     1468         end.
     1469       end.
     1470       delete object bh_tbl-name.
     1471       if     bh_tbl-key ne ?
     1472       then
     1473          delete object bh_tbl-key.
     1474       if p-key-handle = ?
     1475         and v-count-fld <> v-field-num
     1476       then do:
     1477         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1478       end.
     1479     end.
     1480   end procedure.
     1481   procedure gen-hn-keyr-tab :
     1482     define input  parameter i-tableSerach as character no-undo.
     1483     define input  parameter i-tablekey   as character no-undo.
     1484     define input  parameter p-key-rec    as character no-undo.
     1485     define input  parameter p-key-handle as handle    no-undo .
     1486     define input  parameter p-db-name    as character no-undo .
     1487     define input  parameter p-tt-handle  as handle    no-undo .
     1488     define input  parameter p-stts-lock  as integer   no-undo .
     1489     define output parameter o-hn         as handle    no-undo.
     1490     define variable v-full-tbl-name as character no-undo.
     1491     define variable v-where         as character no-undo.
     1492     define variable bh_tbl-name     as handle    no-undo.
     1493     define variable vTable          as character no-undo.
     1494     do
     1495     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1496     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1497     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1498         run gen-where-keyr-tab(i-tableSerach,
     1499                                i-tablekey,
     1500                                p-key-rec,
     1501                                p-key-handle,
     1502                                p-db-name,
     1503                                p-tt-handle,
     1504                                output v-where).
     1505         if i-tableSerach ne "" and i-tableSerach ne ?
     1506         then do:
     1507            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1508            create buffer bh_tbl-name for table v-full-tbl-name .
     1509         end.
     1510         else do:
     1511            if p-tt-handle = ? then do:
     1512               assign
     1513                  vTable = entry( 1 , p-key-rec, chr(3) )
     1514               .
     1515               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1516               create buffer bh_tbl-name for table v-full-tbl-name .
     1517            end.
     1518            else do:
     1519               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1520            end.
     1521         end.
     1522         if p-tt-handle = ? then do:
     1523            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1524         end.
     1525         else do:
     1526            bh_tbl-name:find-first( v-where ) no-error .
     1527         end.
     1528         o-hn = bh_tbl-name.
     1529      end.
     1530   end procedure.
     1531   procedure gen-hn-keyr :
     1532     define input  parameter p-key-rec    as character no-undo.
     1533     define input  parameter p-key-handle as handle    no-undo .
     1534     define input  parameter p-db-name    as character no-undo .
     1535     define input  parameter p-tt-handle  as handle    no-undo .
     1536     define input  parameter p-stts-lock  as integer   no-undo .
     1537     define output parameter o-hn         as handle    no-undo.
     1538     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1539   end.
     1540   procedure gen-row-keyr :
     1541     define input  parameter p-key-rec    as character no-undo.
     1542     define input  parameter p-key-handle as handle    no-undo .
     1543     define input  parameter p-db-name    as character no-undo .
     1544     define input  parameter p-tt-handle  as handle    no-undo .
     1545     define input  parameter p-stts-lock  as integer   no-undo .
     1546     define output parameter p-tbl-row    as rowid     no-undo.
     1547     define output parameter p-tbl-name   as character no-undo.
     1548     define variable vHn as handle no-undo.
     1549       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1550       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1551       p-tbl-name =  vHn:table.
     1552       delete object vHn no-error.
     1553     if p-tbl-row = ? then do:
     1554       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1555     end.
     1556     else do:
     1557       return.
     1558     end.
     1559   end procedure.
     1560   procedure gen-key-fv :
     1561     define input  parameter p-key-rec    as character no-undo .
     1562     define output parameter p-field-list as character no-undo .
     1563     define output parameter p-value-list as character no-undo.
     1564     do
     1565     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1566     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1567     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1568     :
     1569       define variable v-full-tbl-name  as character no-undo .
     1570       define variable bh_tbl-name      as handle    no-undo .
     1571       define variable v-tbl-name       as character no-undo .
     1572       define variable v-field-num      as integer   no-undo .
     1573       define variable v-count-fld      as integer   no-undo .
     1574       define variable v-inform         as character no-undo .
     1575       define variable v-ind            as integer   no-undo .
     1576       define variable v-idx-field-qnty as integer   no-undo .
     1577       define variable v-delim-key      as character no-undo .
     1578       if p-key-rec = ?
     1579         or p-key-rec = "":U
     1580       then do:
     1581         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1582       end.
     1583       assign
     1584         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1585         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1586       .
     1587       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1588       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1589       assign
     1590         v-inform = bh_tbl-name:index-information(1)
     1591         v-ind    = 2
     1592       .
     1593       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1594       on error undo, return error
     1595       :
     1596         assign
     1597           v-inform = bh_tbl-name:index-information( v-ind )
     1598           v-ind    = v-ind + 1
     1599         .
     1600       end.
     1601       if v-inform = ?
     1602         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1603         or entry( 3, v-inform, ",":U ) <> "1":U
     1604       then do:
     1605         delete object bh_tbl-name no-error.
     1606         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1607       end.
     1608       assign
     1609         v-idx-field-qnty = num-entries( v-inform ) - 4
     1610       .
     1611       if v-idx-field-qnty < 2 then do:
     1612         delete object bh_tbl-name no-error.
     1613         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1614       end.
     1615       assign
     1616         p-field-list = "":U
     1617         p-value-list = "":U
     1618         v-delim-key  = "":U
     1619         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1620         v-count-fld  = 0
     1621       .
     1622       block_where:
     1623       do v-ind = 1 to v-idx-field-qnty by 2
     1624       on error undo, return error
     1625       :
     1626         assign
     1627           v-count-fld = v-count-fld + 1
     1628         .
     1629         if v-count-fld > v-field-num then do:
     1630           leave block_where.
     1631         end.
     1632         assign
     1633           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1634           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1635         .
     1636         if v-ind = 1 then do:
     1637           assign
     1638             v-delim-key = chr(3)
     1639           .
     1640         end.
     1641       end.
     1642       delete object bh_tbl-name.
     1643       if v-count-fld <> v-field-num then do:
     1644         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1645       end.
     1646     end.
     1647   end procedure.
     1648   procedure gen-key-field :
     1649     define input  parameter p-table      as character no-undo .
     1650     define output parameter p-field-list as character no-undo .
     1651     do
     1652     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1653     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1654     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1655     :
     1656       define variable v-full-tbl-name  as character no-undo .
     1657       define variable bh_tbl-name      as handle    no-undo .
     1658       define variable v-tbl-name       as character no-undo .
     1659       define variable v-field-num      as integer   no-undo .
     1660       define variable v-count-fld      as integer   no-undo .
     1661       define variable v-inform         as character no-undo .
     1662       define variable v-ind            as integer   no-undo .
     1663       define variable v-idx-field-qnty as integer   no-undo .
     1664       define variable v-delim-key      as character no-undo .
     1665       if p-table = ?
     1666         or p-table = "":U
     1667       then do:
     1668         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1669       end.
     1670       assign
     1671         v-tbl-name      = p-table
     1672         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1673       .
     1674       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1675       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1676       assign
     1677         v-inform = bh_tbl-name:index-information(1)
     1678         v-ind    = 2
     1679       .
     1680       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1681       on error undo, return error
     1682       :
     1683         assign
     1684           v-inform = bh_tbl-name:index-information( v-ind )
     1685           v-ind    = v-ind + 1
     1686         .
     1687       end.
     1688       if v-inform = ?
     1689         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1690         or entry( 3, v-inform, ",":U ) <> "1":U
     1691       then do:
     1692         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1693       end.
     1694       assign
     1695         v-idx-field-qnty = num-entries( v-inform ) - 4
     1696       .
     1697       if v-idx-field-qnty < 2 then do:
     1698         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1699       end.
     1700       assign
     1701         p-field-list = "":U
     1702         v-delim-key  = "":U
     1703         v-count-fld  = 0
     1704       .
     1705       block_where:
     1706       do v-ind = 1 to v-idx-field-qnty by 2
     1707       on error undo, return error
     1708       :
     1709         assign
     1710           v-count-fld = v-count-fld + 1
     1711         .
     1712         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1713         if v-ind = 1 then do:
     1714           assign
     1715             v-delim-key = chr(3)
     1716           .
     1717         end.
     1718       end.
     1719       delete object bh_tbl-name.
     1720     end.
     1721   end procedure.
     1722   define variable vss-include-info8 as character format "X(65)" no-undo
     1723   initial "@(#)$Workfile$ $Revision$".
     1724   procedure xmlchar-test :
     1725   define input parameter p-in-string          as character        no-undo.
     1726   define output parameter p-out-string-enc    as character        no-undo.
     1727   define output parameter p-out-string-dec    as character        no-undo.
     1728   do
     1729   on error undo, return error
     1730   :
     1731          run xmlchar-encode in this-procedure
     1732       (
     1733             input p-in-string
     1734           , output p-out-string-enc
     1735       ).
     1736          run xmlchar-decode in this-procedure
     1737       (
     1738             input p-out-string-enc
     1739           , output p-out-string-dec
     1740       ).
     1741   end.
     1742   end .
     1743   procedure xmlchar-encode :
     1744   define input parameter p-in-string      as character        no-undo.
     1745   define output parameter p-out-string    as character        no-undo.
     1746       define variable v-position      as integer      no-undo.
     1747       define variable v-current-char  as character    no-undo.
     1748   do
     1749   on error undo, return error
     1750   :
     1751       assign
     1752           p-out-string = "":U
     1753       .
     1754       case p-in-string
     1755       :
     1756           when ?
     1757           then do:
     1758               assign
     1759                   p-out-string = "?":U
     1760               .
     1761           end.
     1762           when "?":U
     1763           then do:
     1764               assign
     1765                   p-out-string = "&#63;":U
     1766               .
     1767           end.
     1768           otherwise do:
     1769               do v-position = 1 to length( p-in-string )
     1770               :
     1771                   assign
     1772                       v-current-char = substring( p-in-string, v-position, 1 )
     1773                   .
     1774                   case v-current-char
     1775                   :
     1776                       when "&":U
     1777                       then do:
     1778                           assign
     1779                               p-out-string = p-out-string + "&amp;":U
     1780                           .
     1781                       end.
     1782                       when ">":U
     1783                       then do:
     1784                           assign
     1785                               p-out-string = p-out-string + "&gt;":U
     1786                           .
     1787                       end.
     1788                       when "<":U
     1789                       then do:
     1790                           assign
     1791                               p-out-string = p-out-string + "&lt;":U
     1792                           .
     1793                       end.
     1794                       when "'":U
     1795                       then do:
     1796                           assign
     1797                               p-out-string = p-out-string + "&apos;":U
     1798                           .
     1799                       end.
     1800                       when '"':U
     1801                       then do:
     1802                           assign
     1803                               p-out-string = p-out-string + "&quot;":U
     1804                           .
     1805                       end.
     1806                       when chr(1)
     1807                       then do:
     1808                           assign
     1809                               p-out-string = p-out-string + "":U
     1810                           .
     1811                       end.
     1812                       when chr(2)
     1813                       then do:
     1814                           assign
     1815                               p-out-string = p-out-string + "":U
     1816                           .
     1817                       end.
     1818                       when chr(3)
     1819                       then do:
     1820                           assign
     1821                               p-out-string = p-out-string + "":U
     1822                           .
     1823                       end.
     1824                       when chr(4)
     1825                       then do:
     1826                           assign
     1827                               p-out-string = p-out-string + "":U
     1828                           .
     1829                       end.
     1830                       when chr(5)
     1831                       then do:
     1832                           assign
     1833                               p-out-string = p-out-string + "":U
     1834                           .
     1835                       end.
     1836                       when chr(6)
     1837                       then do:
     1838                           assign
     1839                               p-out-string = p-out-string + "":U
     1840                           .
     1841                       end.
     1842                       when chr(7)
     1843                       then do:
     1844                           assign
     1845                               p-out-string = p-out-string + "":U
     1846                           .
     1847                       end.
     1848                       when chr(8)
     1849                       then do:
     1850                           assign
     1851                               p-out-string = p-out-string + "":U
     1852                           .
     1853                       end.
     1854                       when chr(9)
     1855                       then do:
     1856                           assign
     1857                               p-out-string = p-out-string + "":U
     1858                           .
     1859                       end.
     1860                       when chr(29)
     1861                       then do:
     1862                           assign
     1863                               p-out-string = p-out-string + "":U
     1864                           .
     1865                       end.
     1866                       when chr(10)
     1867                       then do:
     1868                           assign
     1869                               p-out-string = p-out-string + "&#10;":U
     1870                           .
     1871                       end.
     1872                       when chr(13)
     1873                       then do:
     1874                           assign
     1875                               p-out-string = p-out-string + "&#13;":U
     1876                           .
     1877                       end.
     1878                       otherwise do:
     1879                           assign
     1880                               p-out-string = p-out-string + v-current-char
     1881                           .
     1882                       end.
     1883                   end case.
     1884               end.
     1885           end.
     1886       end case.
     1887   end.
     1888   end .
     1889   procedure xmlchar-encode-1c :
