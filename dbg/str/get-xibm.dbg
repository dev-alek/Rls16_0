     1935                       then do:
     1936                           assign
     1937                               p-out-string = p-out-string + " ":U
     1938                           .
     1939                       end.
     1940                       when chr(5)
     1941                       then do:
     1942                           assign
     1943                               p-out-string = p-out-string + " ":U
     1944                           .
     1945                       end.
     1946                       when chr(6)
     1947                       then do:
     1948                           assign
     1949                               p-out-string = p-out-string + " ":U
     1950                           .
     1951                       end.
     1952                       when chr(7)
     1953                       then do:
     1954                           assign
     1955                               p-out-string = p-out-string + " ":U
     1956                           .
     1957                       end.
     1958                       when chr(8)
     1959                       then do:
     1960                           assign
     1961                               p-out-string = p-out-string + " ":U
     1962                           .
     1963                       end.
     1964                       when chr(9)
     1965                       then do:
     1966                           assign
     1967                               p-out-string = p-out-string + " ":U
     1968                           .
     1969                       end.
