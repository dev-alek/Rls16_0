     5047   define TEMP-TABLE tt-cd-trans LIKE ub.cd-trans.
     5048   DEFINE VARIABLE doc-code-txt AS CHARACTER NO-UNDO.
     5049   FUNCTION fdecimal returns decimal
     5050       ( input p-str-value as character
     5051           ) :
     5052       define variable v-dec as decimal no-undo .
     5053       CASE v-dec-sep:
     5054           when chr(44) then do:
     5055               assign
     5056                   v-dec = decimal(replace(p-str-value, chr(44), ".":U))
     5057                   no-error
     5058                   .
     5059           end.
     5060           when ".":U then do:
     5061               assign
     5062                   v-dec = decimal(p-str-value)
     5063                   no-error
     5064                   .
     5065           end.
     5066           otherwise  do:
     5067               assign
     5068                   v-dec = ?
     5069                   .
     5070           end.
     5071       END CASE.
     5072       return v-dec.
     5073   END FUNCTION.
     5074   FUNCTION convert-pay-code returns integer
     5075       ( input p-pos-type as character
     5076       ,input p-pos-pay-code as integer
     5077       ,output p-curr-code as integer
     5078           ) :
     5079       define variable v-pay-code as integer no-undo .
     5080       define variable v-ii as integer no-undo .
     5081       define variable v-entry as character no-undo .
     5082       define buffer buf_currency for ub.currency.
     5083       define buffer buf_cash-pay for ub.cash-pay.
     5084       case p-pos-type:
     5085           when 'Autotank':U then do:
     5086               do v-ii = 1 to num-entries(autotank-pay-list, ";"):
     5087                   v-entry = entry(v-ii, autotank-pay-list, ";").
     5088                   if entry(1, entry(1, v-entry, chr(47)), chr(44)) = string(p-pos-pay-code) then do:
     5089                       assign
     5090                           v-pay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     5091                           p-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     5092                           .
     5093                       return v-pay-code.
     5094                   end.
     5095               end.
     5096               return v-pay-code.
     5097           end.
     5098           when 'MAGIA-XML':U then do:
     5099               if p-pos-pay-code < 1000 then do:
     5100                   if p-pos-pay-code = 1 then do:
     5101                       assign
     5102                           p-curr-code = 0
     5103                           .
     5104                       return p-pos-pay-code.
     5105                   end.
     5106                   find first buf_currency no-lock where
     5107                       buf_currency.okv-code = p-pos-pay-code no-error .
     5108                   if not avail buf_currency then do:
     5109                       assign
     5110                           p-curr-code = - 1
     5111                           .
     5112                       return (- 1).
     5113                   end.
     5114                   assign
     5115                       p-curr-code = buf_currency.curr-code
     5116                       .
     5117                   return 1.
     5118               end.
     5119               else do:
     5120                   assign
     5121                       v-pay-code = p-pos-pay-code - 10000
     5122                       .
     5123                   find buf_cash-pay no-lock where
     5124                       buf_cash-pay.cdpay-code = v-pay-code no-error .
     5125                   if not available buf_cash-pay then do:
     5126                       assign
     5127                           p-curr-code = - 1
     5128                           .
     5129                       return (- 1).
     5130                   end.
     5131                   assign
     5132                       p-curr-code = buf_cash-pay.curr-code
     5133                       .
     5134                   return buf_cash-pay.cdpay-code.
     5135               end.
     5136           end.
     5137       end case.
     5138   END FUNCTION.
     5139   assign
     5140       shop-type = p-obj-type
     5141       shop-code = p-obj-code
     5142       .
     5143   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5144   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5145   FUNCTION convert-discount returns integer
     5146                                             ( input p-disc-reason as integer
     5147                                             , input p-disc-type  as integer
     5148                                             , input p-line-type as integer) :
     5149   define variable v-disc-type as integer no-undo .
     5150   if p-line-type = integer('1':U)
     5151   or p-line-type = integer('0':U)
     5152   then do:
     5153     if p-disc-type = 0
     5154     or p-disc-type = 1
     5155     or p-disc-type = 2
     5156     then do:
     5157       if p-disc-reason <> 0 then
     5158       p-disc-type = p-disc-reason
     5159       .
     5160     end.
     5161   end.
     5162   if p-line-type = integer('3':U)
     5163   or p-line-type = integer('2':U) then do:
     5164     if p-disc-type = 101
     5165     or p-disc-type = 102
     5166     then do:
     5167       if p-disc-reason <> 0 then
     5168       p-disc-type = p-disc-reason
     5169       .
     5170     end.
     5171   end.
     5172   if p-disc-reason <> 0 then do:
     5173     CASE p-disc-reason:
     5174       when 0 then do:
     5175         return integer('0':U).
     5176       end.
     5177       when 1 then do:
     5178         return integer('11':U).
     5179       end.
     5180       when 2 then do:
     5181         return integer('1':U).
     5182       end.
     5183       when 3 or when 15 then do:
     5184         return integer('7':U).
     5185       end.
     5186       when 4 then do:
     5187         return integer('4':U).
     5188       end.
     5189       when 5 then do:
     5190         return integer('12':U).
     5191       end.
     5192       when 6 then do:
     5193         return integer('3':U).
     5194       end.
     5195       when 7 then do:
     5196         return integer('13':U).
     5197       end.
     5198       when 8
     5199       or
     5200       when 9
     5201       or
     5202       when 10
     5203       then do:
     5204         return integer('20':U).
     5205       end.
     5206       when 11
     5207       then do:
     5208         return integer('21':U).
     5209       end.
     5210       when 13
     5211       then do:
     5212         return integer('22':U).
     5213       end.
     5214       when 16 then do:
     5215         return integer('23':U).
     5216       end.
     5217     END CASE.
     5218   end.
     5219   CASE p-disc-type:
     5220     when 0 then do:
     5221       return integer('0':U).
     5222     end.
     5223     when 1 then do:
     5224       return integer('13':U).
     5225     end.
     5226     when 2 then do:
     5227       return integer('2':U).
     5228     end.
     5229     when 3 then do:
     5230       return integer('4':U).
     5231     end.
     5232     when 4 then do:
     5233       return integer('12':U).
     5234     end.
     5235     when 5 then do:
     5236       return integer('1':U).
     5237     end.
     5238     when 6 then do:
     5239       return integer('3':U).
     5240     end.
     5241     when 7 then do:
     5242       return integer('14':U).
     5243     end.
     5244     when 8 then do:
     5245       return integer('15':U).
     5246     end.
     5247     when 9 then do:
     5248       return integer('16':U).
     5249     end.
     5250     when 101 then do:
     5251       return integer('13':U).
     5252     end.
     5253     when 102 then do:
     5254       return integer('5':U).
     5255     end.
     5256     when 103 then do:
     5257       return integer('1':U).
     5258     end.
     5259     when 104 then do:
     5260       return integer('5':U).
     5261     end.
     5262     when 105 then do:
     5263       return integer('1':U).
     5264     end.
     5265     when 106 then do:
     5266       return integer('1':U).
     5267     end.
     5268   END CASE.
     5269   END FUNCTION.
     5270   run get-general-parameters in this-procedure .
     5271   procedure get-general-parameters :
     5272   define buffer buf_get-chkc_context for get-chkc_context.
     5273   do
     5274   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5275   :
     5276     for each buf_get-chkc_context:
     5277       delete buf_get-chkc_context.
     5278     end.
     5279     create buf_get-chkc_context.
     5280   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5281   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     5282     (input  p-obj-type
     5283     ,input  p-obj-code
     5284     ,input  buffer buf_get-chkc_context:handle
     5285     ) no-error .
     5286     if error-status:error then do:
     5287       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     5288                                      , chr(10)
     5289                                      , error-status:get-message(1)
     5290                                      , return-value ).
     5291     end.
     5292     find first buf_get-chkc_context.
     5293     assign
     5294     buf_get-chkc_context.parparentproc = parparentproc
     5295     buf_get-chkc_context.p-log-handle = p-log-handle
     5296     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     5297     .
     5298     release buf_get-chkc_context.
     5299     find first get-chkc_context.
     5300   end.
     5301   end procedure.
     5302   get-chkc_context.pos-type = p-pos-type.
     5303   process events.
     5304   if p-spool-or-data begins "readbuffer" + chr(4)
     5305   then do:
     5306       assign
     5307           p-second-mode = entry(2, p-spool-or-data, chr(4) )
     5308           p-spool-or-data = ""
     5309           .
     5310       output to answerblock.txt .
     5311       export file_ .
     5312       output close .
     5313       RUN get-xml-ibm-c-buff-or-file(input "longchar",input file_) no-error .
     5314       if error-status :error
     5315       then do:
     5316           run write-log-and-file in p-log-handle (
     5317               input 1
     5318               , input log-file-name
     5319               , input 1
     5320               , input substitute( "!!!Ошибка при обработке ответа &1"
     5321               , return-value
     5322               )
     5323               ).
     5324           assign
     5325               p-view-log = yes
     5326               .
     5327           undo, return .
     5328       end.
     5329   end.
     5330   else do:
     5331       assign
     5332           p-second-mode   = p-spool-or-data
     5333           p-spool-or-data = ""
     5334           .
     5335       RUN get-xml-ibm-c-buff-or-file(input "file",input file_) no-error .
     5336       if error-status :error
     5337       then do:
     5338           run write-log-and-file in p-log-handle (
     5339               input 1
     5340               , input log-file-name
     5341               , input 1
     5342               , input substitute( "!!!Ошибка при обработке файла &1: &2"
     5343               , file_
     5344               , return-value
     5345               )
     5346               ).
     5347           assign
