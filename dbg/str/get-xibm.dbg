     7487   end procedure.
     7488   procedure proc-end-chk :
     7489    DO on error undo, return error :
     7490       FIND FIRST tt-chk-doc NO-ERROR.
     7491       IF AVAILABLE tt-chk-doc THEN DO:
     7492          FIND FIRST ub.chk-doc WHERE
     7493                     ub.chk-doc.chk-id    = tt-chk-doc.chk-id
     7494                 AND ub.chk-doc.obj-code  = tt-chk-doc.obj-code
     7495                 AND ub.chk-doc.obj-type  = tt-chk-doc.obj-type
     7496                 AND ub.chk-doc.chk-date  = tt-chk-doc.chk-date
     7497                 AND ub.chk-doc.chk-time  = tt-chk-doc.chk-time
     7498                 AND ub.chk-doc.pay-desk  = tt-chk-doc.pay-desk
     7499                 AND ub.chk-doc.chk-num   = tt-chk-doc.chk-num
     7500                 AND ub.chk-doc.sales-man = tt-chk-doc.sales-man
     7501                 NO-LOCK  NO-ERROR.
     7502          IF NOT AVAILABLE ub.chk-doc THEN DO:
     7503             lll = lll + 1 .
     7504             CREATE ub.chk-doc.
     7505             buffer-copy tt-chk-doc to ub.chk-doc.
     7506             FOR EACH tt-chk-doc-attr WHERE tt-chk-doc-attr.doc-code = tt-chk-doc.doc-code :
     7507                CREATE ub.chk-doc-attr.
     7508                buffer-copy tt-chk-doc-attr to ub.chk-doc-attr.
     7509             END.
     7510             FOR EACH tt-chk-gds WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code :
     7511                CREATE ub.chk-gds.
     7512                buffer-copy tt-chk-gds to ub.chk-gds.
     7513                FOR EACH tt-chk-gds-attr WHERE tt-chk-gds-attr.doc-code = tt-chk-doc.doc-code
     7514                                           AND tt-chk-gds-attr.line-num = tt-chk-gds.line-num :
     7515                   CREATE ub.chk-gds-attr.
     7516                   buffer-copy tt-chk-gds-attr to ub.chk-gds-attr.
     7517                END.
     7518                FOR EACH tt-chk-gds-pay WHERE tt-chk-gds-pay.doc-code = tt-chk-doc.doc-code
     7519                                          AND tt-chk-gds-pay.b-code = tt-chk-gds.b-code :
     7520                   CREATE ub.chk-gds-pay.
     7521                   buffer-copy tt-chk-gds-pay to ub.chk-gds-pay.
     7522                END.
     7523             END.
     7524             FOR EACH tt-chk-pay :
     7525                CREATE ub.chk-pay.
     7526                buffer-copy tt-chk-pay to ub.chk-pay.
     7527                FOR EACH tt-chk-pay-attr  WHERE tt-chk-pay-attr.doc-code = tt-chk-pay.doc-code
     7528                                            AND tt-chk-pay-attr.line-num = tt-chk-pay.line-num :
     7529                   CREATE ub.chk-pay-attr.
     7530                   buffer-copy tt-chk-pay-attr to ub.chk-pay-attr.
     7531                END.
     7532             END.
     7533             FOR EACH tt-chk-discnt WHERE tt-chk-doc.doc-code = tt-chk-discnt.doc-code:
     7534                 CREATE ub.chk-discnt.
     7535                 buffer-copy tt-chk-discnt to ub.chk-discnt.
     7536                 FOR EACH tt-chk-discnt-attr WHERE tt-chk-discnt-attr.doc-code = tt-chk-discnt.doc-code
     7537                                             AND   tt-chk-discnt-attr.line-num = tt-chk-discnt.line-num
     7538                                             AND   tt-chk-discnt-attr.discnt-id = tt-chk-discnt.discnt-id
     7539                                             :
     7540                    FIND FIRST ub.chk-discnt-attr   WHERE
     7541                               ub.chk-discnt-attr.doc-code         = tt-chk-discnt-attr.doc-code
     7542                           AND ub.chk-discnt-attr.line-num         = tt-chk-discnt-attr.line-num
     7543                           AND ub.chk-discnt-attr.record-type      = tt-chk-discnt-attr.record-type
     7544                           AND ub.chk-discnt-attr.discnt-id        = tt-chk-discnt-attr.discnt-id
     7545                           AND ub.chk-discnt-attr.object-line-num  = tt-chk-discnt-attr.object-line-num
     7546                           AND ub.chk-discnt-attr.attr-code        = tt-chk-discnt-attr.attr-code
     7547                           AND ub.chk-discnt-attr.attr-value       = tt-chk-discnt-attr.attr-value
     7548                           AND ub.chk-discnt-attr.out-code         = tt-chk-discnt-attr.out-code
     7549                     NO-ERROR .
     7550                     IF NOT AVAILABLE ub.chk-discnt-attr THEN DO:
     7551                        CREATE  ub.chk-discnt-attr .
     7552                        buffer-copy tt-chk-discnt-attr to ub.chk-discnt-attr.
     7553                     END.
     7554                 END.
     7555             END.
     7556             FOR EACH tt-cd-trans:
     7557                 find first ub.cd-trans no-lock where
     7558                            ub.cd-trans.db-num = tt-cd-trans.db-num
     7559                        and ub.cd-trans.trans-id = tt-cd-trans.trans-id
     7560                        no-error.
     7561                 if not available ub.cd-trans then do:
     7562                   create ub.cd-trans.
     7563                   buffer-copy tt-cd-trans to ub.cd-trans.
     7564                 end.
     7565             end.
     7566             FOR EACH  tt-bar-code:
     7567                CREATE ub.bar-code.
     7568                buffer-copy tt-bar-code to ub.bar-code.
     7569             END.
     7570             FOR EACH  tt-marking-chk:
     7571                find first ub.marking-chk exclusive-lock where
     7572                           ub.marking-chk.mark      = tt-marking-chk.mark
     7573                       and ub.marking-chk.doc-code  = tt-marking-chk.doc-code
     7574                       and ub.marking-chk.line-num  = tt-marking-chk.line-num
     7575                       no-error .
     7576                if not available ub.marking-chk
     7577                then
     7578                CREATE ub.marking-chk.
     7579                buffer-copy tt-marking-chk to ub.marking-chk.
     7580             END.
     7581          END.
     7582          EMPTY TEMP-TABLE     tt-chk-doc.
     7583          EMPTY TEMP-TABLE     tt-chk-doc-attr.
     7584          EMPTY TEMP-TABLE     tt-chk-gds.
     7585          EMPTY TEMP-TABLE     tt-chk-gds-attr.
     7586          EMPTY TEMP-TABLE     tt-chk-gds-pay.
     7587          EMPTY TEMP-TABLE     tt-chk-pay.
     7588          EMPTY TEMP-TABLE     tt-chk-pay-attr.
     7589          EMPTY TEMP-TABLE     tt-chk-discnt.
     7590          EMPTY TEMP-TABLE     tt-chk-discnt-attr.
     7591          EMPTY TEMP-TABLE     tt-bar-code.
     7592          EMPTY TEMP-TABLE     tt-marking-chk.
     7593          EMPTY TEMP-TABLE     tt-cd-trans.
     7594       END.
     7595    END.
     7596   end procedure.
     7597   procedure proc-inv :
     7598       define variable i-code_ as character no-undo .
     7599       define variable i-qnty_ as decimal no-undo .
     7600       define variable i-place_ as integer no-undo .
     7601       define variable lng-spl as integer no-undo .
     7602       define variable v-line-type as character no-undo .
     7603       define buffer buf_chk-gds for tt-chk-gds.
     7604       define buffer buf_temp-temp for temp-temp.
     7605       define buffer buf_chk-doc for tt-chk-doc.
     7606       do
     7607           on error undo, return error return-value
     7608               :
     7609           if not exist then do:
     7610               if get-chkc_context.is-cdinv = yes then do:
     7611                   for each buf_temp-temp where
     7612                       buf_temp-temp.record-name = "Invent":U
     7613                           AND buf_temp-temp.id = v-id:
     7614                       CASE buf_temp-temp.field-name:
     7615                           when "ICode":U then do:
     7616                               assign
     7617                                   i-code_ = buf_temp-temp.field-value
     7618                                   no-error .
     7619                           end.
     7620                           when "IQty":U then do:
     7621                               assign
     7622                                   i-qnty_ = fdecimal(buf_temp-temp.field-value)
     7623                                   no-error .
     7624                           end.
     7625                           when "IPlace":U then do:
     7626                               assign
     7627                                   i-place_ = integer(buf_temp-temp.field-value)
     7628                                   no-error .
     7629                           end.
     7630                           when "IString":U then do:
     7631                               assign
     7632                                   lng-spl = integer(buf_temp-temp.field-value)
     7633                                   no-error .
     7634                           end.
     7635                           otherwise do:
     7636                               error-status:error = no.
     7637                           end.
     7638                       END CASE.
     7639                       if error-status:error then do:
     7640                           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     7641                       end.
     7642                       delete buf_temp-temp.
     7643                   end.
     7644               end.
     7645               assign
     7646                   time-oper_ =  (if p-pos-type = 'MAGIA-XML':U
     7647                   then (v-time modulo 86400)
     7648                   else string-IS0-8601-to-sec(v-time-char))
     7649                   no-error
     7650                   .
     7651               FIND FIRST buf_chk-doc NO-ERROR.
     7652               CREATE buf_chk-gds.
     7653               assign
     7654                   buf_chk-gds.doc-code = buf_chk-doc.doc-code
     7655                   lng = lng + 1
     7656                   buf_chk-gds.line-num = (if lng-spl = 0 then - lng else lng-spl)
     7657                   buf_chk-gds.grp-code = 0
     7658                   buf_chk-gds.chk-date = buf_chk-doc.chk-date
     7659                   buf_chk-gds.src-code = i-code_
     7660                   buf_chk-gds.src-qnty = i-qnty_
     7661                   buf_chk-gds.src-discnt = 0
     7662                   buf_chk-gds.src-price = 0
     7663                   buf_chk-gds.doc-qnty = 0
     7664                   buf_chk-gds.price-service = 0
     7665                   buf_chk-gds.time-oper = time-oper_
     7666                   buf_chk-gds.is-error = no
     7667                   buf_chk-gds.doc-qnty = 0
     7668                   buf_chk-gds.pump = 0
     7669                   buf_chk-gds.road-tax = 0
     7670                   buf_chk-gds.line-sign = buf_chk-gds.src-qnty >= 0
     7671                   buf_chk-gds.line-type =  '':U
     7672                   .
     7673           end.
     7674       end.
     7675   end procedure.
     7676   procedure proc-bonus :
     7677       define variable  bonus-obj_         as integer no-undo .
     7678       define variable  bonus-trans-id_    as integer no-undo .
     7679       define variable  bonus-card-no      as character no-undo .
     7680       define variable  bonus-curr-code_   as integer no-undo .
     7681       define variable  bonus-qty_         as decimal no-undo .
     7682       define variable  bonus-reason_      as integer no-undo .
     7683       define variable  bonus-type-chr_    as character no-undo .
     7684       define variable  bonus-string       as integer no-undo .
     7685       define variable  bonus-src-code_    as decimal no-undo .
     7686       define variable  bonus-src-code-chr as character no-undo .
     7687       define variable  bonus-relation     as character no-undo .
     7688       define variable  i-bonus-relation   as integer   no-undo .
     7689       define variable  dt-season          as integer   no-undo .
     7690       define buffer buf_temp-temp for temp-temp .
     7691       define buffer buf_chk-gds for tt-chk-gds.
     7692       define buffer buf_chk-doc for tt-chk-doc.
     7693       define buffer buf_chk-discnt for tt-chk-discnt.
     7694       define buffer buf_chk-discnt-attr for tt-chk-discnt-attr.
     7695       define variable local-netto-for-sub-d as decimal no-undo .
     7696       do
     7697           on error undo, return error
     7698               :
     7699           if not exist then do:
     7700               for each buf_temp-temp where
     7701                   buf_temp-temp.record-name = "BonusAdd":U
     7702                       AND buf_temp-temp.id = v-id:
     7703                   CASE buf_temp-temp.field-name:
     7704                       when "BAString":U then do:
     7705                           assign
     7706                               bonus-string = integer(buf_temp-temp.field-value)
     7707                               no-error .
     7708                       end.
     7709                       when "BAobj":U then do:
     7710                           assign
     7711                               bonus-obj_ = integer(buf_temp-temp.field-value)
     7712                               no-error .
     7713                       end.
     7714                       when "BATransID":U then do:
     7715                           assign
     7716                               bonus-trans-id_ = integer(buf_temp-temp.field-value)
     7717                               no-error .
     7718                       end.
     7719                       when "BACurr":U then do:
     7720                           assign
     7721                               bonus-curr-code_ = integer(buf_temp-temp.field-value)
     7722                               no-error .
     7723                       end.
     7724                       when "BAReason":U then do:
     7725                           assign
     7726                               bonus-reason_ = integer(buf_temp-temp.field-value)
     7727                               no-error .
     7728                       end.
     7729                       when "Ltype":U then do:
     7730                           assign
     7731                               bonus-type-chr_ = buf_temp-temp.field-value
     7732                               no-error .
     7733                       end.
     7734                       when "BAQty":U then do:
     7735                           assign
     7736                               bonus-qty_ = fdecimal(buf_temp-temp.field-value) / 100
     7737                               no-error .
     7738                       end.
     7739                       when "BACardNo":U then do:
     7740                           assign
     7741                               bonus-card-no = buf_temp-temp.field-value
     7742                               no-error .
     7743                       end.
     7744                       when "BARelation":U then do:
     7745                           assign
     7746                               bonus-relation = buf_temp-temp.field-value
     7747                               no-error .
     7748                       end.
     7749                       otherwise do:
     7750                           error-status:error = no.
     7751                       end.
     7752                   END CASE.
     7753                   if error-status:error then do:
     7754                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     7755                   end.
     7756                   delete buf_temp-temp.
     7757               end.
     7758               FIND FIRST buf_chk-doc NO-ERROR.
     7759               FIND FIRST buf_chk-gds NO-ERROR.
     7760               create buf_chk-discnt.
     7761               assign
     7762                   buf_chk-discnt.doc-code = buf_chk-doc.doc-code.
     7763                   buf_chk-discnt.record-type = 4.
     7764                   buf_chk-discnt.line-num = buf_chk-gds.line-num.
     7765                   buf_chk-discnt.discnt-id = (if bonus-trans-id_ = 0 then buf_chk-discnt.line-num else bonus-trans-id_).
     7766                   buf_chk-discnt.time-oper = buf_chk-gds.time-oper.
     7767                   buf_chk-discnt.line-type = (if bonus-type-chr_ = 'I' or bonus-type-chr_ = '0'
     7768                   then integer('1':U)
     7769                   else (if bonus-type-chr_ = 'T'
     7770                   then integer('2':U)
     7771                   else integer('0':U)
     7772                   )
     7773                   ).
     7774                   buf_chk-discnt.pass-discnt = bonus-obj_.
     7775                   buf_chk-discnt.value-type = integer('5':U).
     7776                   buf_chk-discnt.src-d-card = bonus-card-no .
     7777                   buf_chk-discnt.d-card = bonus-card-no .
     7778                   buf_chk-discnt.discnt-value-abs = bonus-qty_.
     7779                   buf_chk-discnt.discnt-value-pcnt = (if buf_chk-discnt.line-type = integer('1':U)
     7780                   then bonus-src-code_
     7781                   else 0).
     7782                   buf_chk-discnt.discnt-type = bonus-reason_.
     7783                   buf_chk-discnt.kateg = (if bonus-curr-code_ > 0
     7784                   then bonus-curr-code_
     7785                   else (if bonus-curr-code_ = kassa-rub-code
     7786                   then 0
     7787                   else -1 )
     7788                   ).
     7789                   buf_chk-discnt.object-line-num = (if bonus-string <= 0
     7790                   then bonus-string
     7791                   else buf_chk-gds.line-num).
     7792                   buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk.
     7793                   buf_chk-discnt.obj-code = buf_chk-doc.obj-code.
     7794                   buf_chk-discnt.obj-type = buf_chk-doc.obj-type.
     7795                   buf_chk-discnt.chk-date = buf_chk-doc.chk-date.
     7796                   buf_chk-discnt.chk-time = buf_chk-doc.chk-time.
     7797               if bonus-relation <> "" then do:
     7798                   dt-season = 0.
     7799                   i-bonus-relation = integer(bonus-relation) no-error.
     7800                   if not error-status:error then
     7801                   do:
     7802                       run gds-attr_check-code-dt-seasons in this-procedure
     7803                           (i-bonus-relation, shop-type, shop-code, output i-bonus-relation,output dt-season).
     7804                       bonus-relation = string(i-bonus-relation).
     7805                   end.
     7806                   find first buf_chk-discnt-attr EXCLUSIVE-LOCK where buf_chk-discnt-attr.attr-code = "RRN-bonus"
     7807                       and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     7808                       and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     7809                       and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     7810                       and buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num no-error .
     7811                   if AVAILABLE buf_chk-discnt-attr then do:
     7812                       buf_chk-discnt-attr.attr-value = bonus-relation .
     7813                   end.
     7814                   else do:
     7815                       create buf_chk-discnt-attr .
     7816                       assign
     7817                           buf_chk-discnt-attr.attr-code = "RRN-bonus"
     7818                           buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     7819                           buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     7820                           buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     7821                           buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     7822                           buf_chk-discnt-attr.attr-value = bonus-relation
     7823                           .
     7824                   end.
     7825                   if dt-season <> 0 then do:
     7826                       find first buf_chk-discnt-attr EXCLUSIVE-LOCK where buf_chk-discnt-attr.attr-code = "SeasonDT"
     7827                           and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     7828                           and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     7829                           and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     7830                           and buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num no-error .
     7831                       if AVAILABLE buf_chk-discnt-attr then do:
     7832                           buf_chk-discnt-attr.attr-value = string(dt-season) .
     7833                       end.
     7834                       else do:
     7835                           create buf_chk-discnt-attr .
     7836                           assign
     7837                               buf_chk-discnt-attr.attr-code = "SeasonDT"
     7838                               buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     7839                               buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     7840                               buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     7841                               buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     7842                               buf_chk-discnt-attr.attr-value = string(dt-season)
     7843                               .
     7844                       end.
     7845                   end.
     7846               end.
     7847               if buf_chk-discnt.line-type = integer('1':U) then do:
     7848                   if available buf_chk-gds
     7849                   and (bonus-src-code-chr = buf_chk-gds.src-code
     7850                   or bonus-string  = buf_chk-gds.line-num ) then do:
     7851                   end.
     7852                   else do:
     7853                       for each buf_chk-gds no-lock where
     7854                           buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     7855                           if buf_chk-gds.src-code = bonus-src-code-chr then do:
     7856                               buf_chk-discnt.object-line-num = buf_chk-gds.line-num.
     7857                               leave.
     7858                           end.
     7859                       end.
     7860                   end.
     7861               end.
     7862               if buf_chk-discnt.line-type = integer('2':U)
     7863               and available buf_chk-gds
     7864               and buf_chk-discnt.object-line-num = buf_chk-gds.line-num then do:
     7865                   assign
     7866                       buf_chk-discnt.object-sum = local-netto-for-sub-d
     7867                       buf_chk-discnt.discnt-value-pcnt = (if local-netto-for-sub-d <> 0
     7868                       and (buf_chk-discnt.kateg = - 1
     7869                       or buf_chk-discnt.kateg <> - 1
     7870                       and (
     7871                       (buf_chk-discnt.kateg = 0
     7872                       and v-curr-r-b = 'rubl':U
     7873                       )
     7874                       or
     7875                       (buf_chk-discnt.kateg = v-base-code
     7876                       and v-curr-r-b = 'base':U)
     7877                       ))
     7878                       then bonus-qty_ / chk-gds.src-sum
     7879                       else buf_chk-discnt.discnt-value-pcnt)
     7880                       .
     7881               end.
     7882           end.
     7883       end.
     7884   end procedure.
     7885   procedure proc-disc :
     7886       define variable lnd-spl as integer no-undo .
     7887       define buffer buf_temp-temp for temp-temp .
     7888       define variable disc-sum_ as decimal no-undo .
     7889       define variable disc-pcnt_ as decimal no-undo .
     7890       define variable disc-reason_ as integer no-undo .
     7891       define variable disc-vtype_ as integer no-undo .
     7892       define variable disc-type_ as integer no-undo .
     7893       define variable disc-mode_ as character no-undo .
     7894       define variable disc-promo-id_ as character no-undo .
     7895       define variable disc-sign_ as logical no-undo .
     7896       define variable local-netto-for-sub-d as decimal no-undo .
     7897       define buffer buf_chk-gds for tt-chk-gds.
     7898       define buffer buf2_chk-gds for tt-chk-gds.
     7899       define buffer buf_chk-gds-attr for tt-chk-gds-attr.
     7900       define buffer buf2_chk-gds-attr for tt-chk-gds-attr.
     7901       define buffer buf_chk-doc for tt-chk-doc.
     7902       define buffer buf_chk-discnt for tt-chk-discnt.
     7903       define buffer buf2_chk-discnt for tt-chk-discnt.
     7904       define buffer buf_chk-discnt-attr for tt-chk-discnt-attr.
     7905       define variable disc-gds-reason as int no-undo .
     7906       do
     7907           on error undo, return error
     7908               :
     7909               FIND FIRST buf_chk-doc NO-ERROR.
     7910           if not exist then do:
     7911               if  buf_chk-doc.chk-type = integer('8':U) then return.
     7912               for each buf_temp-temp where
     7913                   buf_temp-temp.record-name = "CDisc":U
     7914                       AND buf_temp-temp.id = v-id:
     7915                   CASE buf_temp-temp.field-name:
     7916                       when "CDSum":U then do:
     7917                           assign
     7918                               disc-sum_ = fdecimal(buf_temp-temp.field-value)
     7919                               no-error .
     7920                       end.
     7921                       when "CDPersent":U then do:
     7922                           assign
     7923                               disc-pcnt_ = fdecimal(buf_temp-temp.field-value)
     7924                               no-error .
     7925                       end.
     7926                       when "CDString":U then do:
     7927                           assign
     7928                               lnd-spl = integer(buf_temp-temp.field-value)
     7929                               no-error .
     7930                       end.
     7931                       when "CDReason":U then do:
     7932                           assign
     7933                               disc-reason_ = integer(buf_temp-temp.field-value)
     7934                               no-error .
     7935                       end.
     7936                       when "CDRank":U then do:
     7937                           assign
     7938                               disc-type_ = integer(buf_temp-temp.field-value)
     7939                               no-error .
     7940                       end.
     7941                       when "CDType":U then do:
     7942                           assign
     7943                               disc-sign_ = if integer(buf_temp-temp.field-value) = 1
     7944                               or integer(buf_temp-temp.field-value) = 3
     7945                               then no
     7946                               else yes
     7947                               no-error .
     7948                       end.
     7949                       when "CDVType":U then do:
     7950                           assign
     7951                               disc-vtype_ = (if buf_temp-temp.field-value = "P":U
     7952                               then integer('1':U)
     7953                               else (if buf_temp-temp.field-value = "A":U
     7954                               then integer('2':U)
     7955                               else (if buf_temp-temp.field-value = "G":U
     7956                               then integer('14':U)
     7957                               else integer('0':U)
     7958                               )
     7959                               )
     7960                               )
     7961                               no-error .
     7962                       end.
     7963                       when "CDMode":U then do:
     7964                           assign
     7965                               disc-mode_ = buf_temp-temp.field-value
     7966                               no-error .
     7967                       end.
     7968                       when "CDCard":U then do:
     7969                           assign
     7970                               disc-d-card = buf_temp-temp.field-value
     7971                               no-error .
     7972                       end.
     7973                       when "CDDoc":U then do:
     7974                           assign
     7975                               disc-gds-reason = int(buf_temp-temp.field-value)
     7976                               no-error .
     7977                           error-status:error = no.
     7978                       end.
     7979                       otherwise do:
     7980                           error-status:error = no.
     7981                       end.
     7982                   END CASE.
     7983                   if error-status:error then do:
     7984                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     7985                   end.
     7986                   delete buf_temp-temp.
     7987               end.
     7988               if disc-mode_ = "B":U  then return.
     7989               if disc-mode_ <> 'T':U then do:
     7990                   find first buf_chk-gds where
     7991                       buf_chk-gds.doc-code = buf_chk-doc.doc-code
     7992                       AND buf_chk-gds.line-num = lnd-spl no-error .
     7993                   if disc-mode_ = 'I':U then do:
     7994                       if not Available buf_chk-gds then do:
     7995                           assign
     7996                               p-view-log = yes.
     7997                           run write-log-and-file in p-log-handle (
     7998                               input 1
     7999                               , input log-file-name
     8000                               , input 1
     8001                               , input substitute( "!!!Несуществующая строка чека &1 для скидки:&2" +
     8002                               "номер чека на кассе &5 касса &6"
     8003                               , lnd-spl
     8004                               , chr(10)
     8005                               , chk-num_
     8006                               , pay-desk_
     8007                               )).
     8008                           return.
     8009                       end.
     8010                       if disc-reason_ = 15  then do:
     8011                           find first buf_chk-gds-attr
     8012                               where buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     8013                               and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     8014                               and buf_chk-gds-attr.attr-code = "CSPromo"
     8015                               and can-do("1,6", buf_chk-gds-attr.attr-value)
     8016                               no-error.
     8017                           if avail buf_chk-gds-attr
     8018                           then do:
     8019                              find first buf2_chk-gds-attr
     8020                                   where buf2_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     8021                                     and buf2_chk-gds-attr.attr-code = "CSPromo"
     8022                                     and can-do("2,4,5", buf2_chk-gds-attr.attr-value)
     8023                               no-error.
     8024                              if avail buf2_chk-gds-attr
     8025                              then do:
     8026                                 find first buf2_chk-gds
     8027                                      where buf2_chk-gds.doc-code  = buf2_chk-gds.doc-code
     8028                                        and buf2_chk-gds.line-num  = buf2_chk-gds-attr.line-num
     8029                                        no-error.
     8030                                 if avail buf2_chk-gds then
     8031                                    disc-sum_ = disc-sum_ + buf2_chk-gds.src-sum.
     8032                              end.
     8033                              find first buf2_chk-gds-attr exclusive-lock where
     8034                                         buf2_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     8035                                     and buf2_chk-gds-attr.line-num = buf_chk-gds.line-num
     8036                                     and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     8037                                     no-wait no-error.
     8038                              if locked buf2_chk-gds-attr then .
     8039                              else do:
     8040                                 if not available buf2_chk-gds-attr
     8041                                 then
     8042                                 create buf2_chk-gds-attr.
     8043                                 assign
     8044                                    buf2_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     8045                                    buf2_chk-gds-attr.line-num = buf_chk-gds.line-num
     8046                                    buf2_chk-gds-attr.attr-code = "CSPromoSum"
     8047                                    buf2_chk-gds-attr.attr-value =  string(-1 * disc-sum_)
     8048                                    .
     8049                                 disc-sum_ = 0.
     8050                                 disc-pcnt_ = 0.
     8051                              end.
     8052                           end.
     8053                       end.
     8054                   end.
     8055                   else if not (disc-mode_ = 'C':U or disc-mode_ = 'P':U) then do:
     8056                       assign
     8057                           p-view-log = yes.
     8058                       run write-log-and-file in p-log-handle (
     8059                           input 1
     8060                           , input log-file-name
     8061                           , input 1
     8062                           , input substitute( "!!!Неопределенный тип скидки с № строки &1 в чеке:&2" +
     8063                           "номер чека на кассе &3 касса &4&2" +
     8064                           "скидка не будет обработана"
     8065                           , lnd-spl
     8066                           , chr(10)
     8067                           , chk-num_
     8068                           , pay-desk_
     8069                           )).
     8070                       return.
     8071                   end.
     8072               end.
     8073               if disc-mode_ = "T":U
     8074               and lng > lnd-spl
     8075               and (p-pos-type = 'IBM-XML':U
     8076               or
     8077               p-pos-type = 'Autotank':U
     8078               )
     8079               then do:
     8080                   for each buf_chk-gds no-lock where
     8081                       buf_chk-gds.doc-code = buf_chk-doc.doc-code
     8082                           and buf_chk-gds.line-num <= lnd-spl:
     8083                       if buf_chk-doc.chk-type = integer('17':U) then do:
     8084                           assign
     8085                               local-netto-for-sub-d = local-netto-for-sub-d + (if v-is-petrol-check then 0
     8086                               else (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     8087                               .
     8088                       end.
     8089                       else  do:
     8090                           assign
     8091                               local-netto-for-sub-d = local-netto-for-sub-d + (if (buf_chk-gds.write-off-code = ?
     8092                               or buf_chk-gds.write-off-code <= 0)
     8093                               and not v-is-petrol-check
     8094                               then
     8095                               ((buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     8096                               else 0)
     8097                               .
     8098                       end.
     8099                   end.
     8100               end.
     8101               else do:
     8102                   local-netto-for-sub-d = netto-for-sub-d.
     8103               end.
     8104               if disc-reason_ = 15 then do:
     8105                   disc-promo-id_ = disc-d-card.
     8106                   disc-d-card  = '':U.
     8107               end.
     8108               create buf_chk-discnt.
     8109               assign
     8110                   buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     8111                   buf_chk-discnt.record-type = if disc-mode_ = "C":U then 10 else 0
     8112                   buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     8113                   buf_chk-discnt.time-oper = v-time
     8114                   buf_chk-discnt.line-type = (if disc-mode_ = "I":U
     8115                   then integer('1':U)
     8116                   else (if disc-mode_ = "T":U or (disc-mode_ = "P":U and disc-reason_ = 16)
     8117                   then integer('2':U)
     8118                   else integer('0':U)
     8119                   )
     8120                   )
     8121                   kriv3 = (if disc-mode_ = "T"
     8122                   and p-pos-type = 'IBM-XML':U
     8123                   then yes
     8124                   else kriv3 )
     8125                   buf_chk-discnt.line-sign =   disc-sign_
     8126                   buf_chk-discnt.pass-discnt = integer('0':U)
     8127                   buf_chk-discnt.value-type = if disc-vtype_ = 0
     8128                   then integer('0':U)
     8129                   else disc-vtype_
     8130                   buf_chk-discnt.src-d-card = (if available buf_chk-gds
     8131                   then buf_chk-gds.src-d-card
     8132                   else (if available buf_chk-gds
     8133                   then buf_chk-gds.src-d-card
     8134                   else '')
     8135                   )
     8136                   buf_chk-discnt.d-card = (if available buf_chk-gds
     8137                   then  buf_chk-gds.d-card
     8138                   else (if available buf_chk-gds
     8139                   then buf_chk-gds.d-card
     8140                   else '')
     8141                   )
     8142                   buf_chk-discnt.d-card = (if disc-d-card = "" or disc-d-card = ? then buf_chk-discnt.d-card else disc-d-card)
     8143                   buf_chk-discnt.discnt-value-abs = - disc-sum_
     8144                   buf_chk-discnt.discnt-value-pcnt = (if p-pos-type = 'IBM-XML':U then (- disc-pcnt_) else disc-pcnt_)
     8145                   buf_chk-discnt.object-line-num = lnd-spl
     8146                   buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     8147                   buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     8148                   buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     8149                   buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     8150                   buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     8151                   buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     8152                   buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     8153                   buf_chk-discnt.object-qnty = (if buf_chk-discnt.line-type = integer('2':U)
     8154                   or not available buf_chk-gds
     8155                   then accum-src-for-sub-d
     8156                   else buf_chk-gds.src-qnty)
     8157                   buf_chk-discnt.object-sum = (if buf_chk-discnt.line-type = integer('2':U)
     8158                   or not available buf_chk-gds
     8159                   then  local-netto-for-sub-d
     8160                   else buf_chk-gds.src-sum)
     8161                   var-discnt-id = var-discnt-id + 1
     8162                   sub-d = (if buf_chk-discnt.line-type = integer('2':U) then (sub-d - disc-sum_) else sub-d)
     8163                   buf_chk-discnt.promo-id = disc-promo-id_
     8164                   buf_chk-discnt.templ-rl-root = disc-gds-reason
     8165                   .
     8166               if buf_chk-discnt.line-type = integer('2':U) then do:
     8167                   buf_chk-discnt.line-num = (if p-pos-type = 'IBM-XML':U
     8168                       then lnd-spl
     8169                       else (if available buf_chk-gds then buf_chk-gds.line-num else 0)
     8170                       ).
     8171               end.
     8172               else do:
     8173                   buf_chk-discnt.line-num = (if p-pos-type = 'IBM-XML':U
     8174                       then lnd-spl
     8175                       else (if available buf_chk-gds then buf_chk-gds.line-num else 0)
     8176                       ).
     8177               end.
     8178               if disc-promo-id_ <> "" then do:
     8179                   create buf_chk-discnt-attr .
     8180                   assign
     8181                       buf_chk-discnt-attr.attr-code = "promo-id"
     8182                       buf_chk-discnt-attr.attr-value = disc-promo-id_
     8183                       buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     8184                       buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     8185                       buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     8186                       buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     8187                       buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     8188                       .
     8189               end.
     8190               if disc-gds-reason <> ? then do:
     8191                   create buf_chk-discnt-attr .
     8192                   assign
     8193                       buf_chk-discnt-attr.attr-code = "gds-reason"
     8194                       buf_chk-discnt-attr.attr-value = string(disc-gds-reason)
     8195                       buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     8196                       buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     8197                       buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     8198                       buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     8199                       buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     8200                       .
     8201               end.
     8202               if buf_chk-discnt.record-type <> 10
     8203               then netto-for-sub-d =  netto-for-sub-d - buf_chk-discnt.discnt-value-abs
     8204                   .
     8205               if available buf_chk-gds  and buf_chk-discnt.record-type <> 10 then
     8206               do:
     8207                 if buf_chk-discnt.line-type <> integer('2':U)
     8208                   and buf_chk-discnt.value-type = integer('1':U)
     8209                   and buf_chk-discnt.discnt-value-pcnt = 100
     8210                 then do:
     8211                    buf_chk-gds.src-discnt = buf_chk-gds.src-price.
     8212                 end.
     8213                 else if buf_chk-discnt.line-type <> integer('2':U)
     8214                 then do:
     8215                    buf_chk-gds.src-discnt = buf_chk-gds.src-discnt + buf_chk-discnt.discnt-value-abs / buf_chk-gds.src-qnty.
     8216                 end.
     8217               end.
     8218               assign
     8219                   buf_chk-discnt.discnt-type = if disc-reason_ > 0 or disc-type_ > 0
     8220                   then convert-discount(disc-reason_, disc-type_, buf_chk-discnt.line-type)
     8221                   else integer('0':U)
     8222                   .
     8223               if buf_chk-discnt.record-type = 10 then buf_chk-discnt.rank = disc-type_.
     8224               if kriv3 = yes
     8225               and disc-mode_ = "I" then do:
     8226                   for each buf2_chk-discnt where
     8227                       buf2_chk-discnt.doc-code = buf_chk-discnt.doc-code
     8228                           AND buf2_chk-discnt.line-type = integer('2':U)
     8229                           and buf2_chk-discnt.line-num >= buf_chk-discnt.object-line-num:
     8230                       assign
     8231                           buf2_chk-discnt.object-sum = buf2_chk-discnt.object-sum - buf_chk-discnt.discnt-value-abs.
     8232                   end.
     8233               end.
     8234           end.
     8235           assign
     8236               disc-d-card = "".
     8237       end.
     8238   end procedure.
     8239   procedure proc-magia-discnt :
     8240       define input parameter p-d-pcnt as decimal no-undo .
     8241       define input parameter p-d-sum as decimal no-undo .
     8242       define input parameter p-type as integer no-undo .
     8243       do
     8244           on error undo, return error
     8245               :
     8246           create ub.chk-discnt.
     8247           assign
     8248               ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     8249               ub.chk-discnt.record-type = 0
     8250               ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     8251               ub.chk-discnt.line-num = ub.chk-gds.line-num
     8252               ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     8253               ub.chk-discnt.line-type = integer('1':U)
     8254               ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     8255               ub.chk-discnt.pass-discnt = integer('0':U)
     8256               ub.chk-discnt.value-type = integer('0':U)
     8257               ub.chk-discnt.discnt-type = p-type
     8258               ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     8259               ub.chk-discnt.discnt-value-abs = (if p-d-sum <> 0
     8260               then p-d-sum
     8261               else 0)
     8262               ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     8263               ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     8264               ub.chk-discnt.discnt-value-pcnt =
     8265               if ub.chk-gds.src-sum <> 0 and p-d-pcnt <> 0
     8266               then  p-d-pcnt
     8267               else (if ub.chk-gds.src-sum <> 0
     8268               then ub.chk-discnt.discnt-value-abs / ub.chk-gds.src-sum * 100
     8269               else 0)
     8270               ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     8271               ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     8272               ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     8273               ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     8274               ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     8275               ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     8276               ub.chk-gds.src-discnt =   ub.chk-gds.src-discnt + ub.chk-discnt.discnt-value-abs / ub.chk-gds.src-qnty
     8277               var-discnt-id = var-discnt-id + 1
     8278               .
     8279       end.
     8280   end procedure.
     8281   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile: getxibm3.i $ $Revision: cd82ba7bd738, 2912, rls $".
     8282   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8283   function  gettegjson returns character
     8284   (istr  as char,
     8285    iteg  as char):
     8286       define variable vpos as integer no-undo.
     8287      istr = left-trim (istr,"~{") .
     8288      iteg = '"' + iteg + '"'  .
     8289      vpos = index (istr,iteg) + 1.
     8290      if vpos eq 1
     8291      then
     8292         return "".
     8293      istr = trim(substring (istr,vpos + length(iteg))).
     8294      if istr begins '"'
     8295      then return trim(right-trim(entry(1,istr),"~}"),'"').
     8296      else do:
     8297         define variable vbeg as integer no-undo.
     8298         define variable vbegpos as integer no-undo  init 1.
     8299         define variable vend as integer no-undo.
     8300         define variable vCol as integer no-undo.
     8301         vbeg  = index (istr,"~{",vbegpos).
     8302         vend  = index (istr,"~}",vbegpos).
     8303         if vbeg < vend
     8304         then do:
     8305            vCol = 1.
     8306            vbegpos = vbeg + 1.
     8307            block-str:
     8308            do while vCol > 0:
     8309               vbeg  = index (istr,"~{",vbegpos).
     8310               vend  = index (istr,"~}",vbegpos).
     8311               if vbeg < vend
     8312                  and vbeg  ne 0
     8313               then assign
     8314                  vbegpos = vbeg + 1
     8315                  vcol    = vcol + 1
     8316               .
     8317               else do:
     8318                  if vend eq 0
     8319                  then
     8320                     leave block-str.
     8321                  assign
     8322                     vbegpos = vend + 1
     8323                     vcol    = vcol - 1
     8324                  .
     8325               end.
     8326            end.
     8327            if vcol eq 0
     8328            then do:
     8329               istr = substring(istr,1,vbegpos - 1).
     8330               return istr.
     8331            end.
     8332         end.
     8333         else
     8334         return istr.
     8335      end.
     8336   end.
     8337   procedure proc-03 :
     8338   define input parameter par-mode as integer no-undo .
     8339   define input parameter loc-exist as logical no-undo .
     8340   define variable lnp-spl as integer no-undo .
     8341   define buffer buf_temp-temp for temp-temp.
     8342   define buffer buf_chk-doc for tt-chk-doc.
     8343   define buffer buf_chk-doc-attr for tt-chk-doc-attr.
     8344   define buffer buf_chk-pay for tt-chk-pay.
     8345   define buffer buf_chk-pay-attr for tt-chk-pay-attr.
     8346   define variable i-cpdoc      as int no-undo.
     8347   define variable c-attr-code   as character no-undo.
     8348   define variable c-attr-value  as character no-undo.
     8349   define variable vCPAgreement  as character no-undo.
     8350   define variable vCPWithdrawal as character no-undo.
     8351   define variable vsbpstat as character no-undo.
     8352   define variable vsbprrn as character no-undo.
     8353   define variable vqrpay  as character no-undo.
     8354     _proc-03:
     8355     do
     8356     on error undo, return error
     8357     :
     8358       if not loc-exist then do:
     8359         pay-card_ = "".
     8360         for each buf_temp-temp where
     8361                 buf_temp-temp.record-name = "CPay":U
     8362           and buf_temp-temp.id = v-id:
     8363           CASE buf_temp-temp.field-name:
     8364             when "CPCode":U then do:
     8365               if p-pos-type = 'IBM-XML':U
     8366               then do:
     8367                 if integer(buf_temp-temp.field-value) = ibm-ccm then do:
     8368                      assign pay_code = 1
     8369                      c-attr-code  = "IBM-CCM".
     8370                      c-attr-value = 'yes'.
     8371                 end.
     8372                 else assign pay_code = integer(buf_temp-temp.field-value)      no-error .
     8373               end.
     8374               else do:
     8375                 assign
     8376                 pay_code = convert-pay-code(p-pos-type, integer(buf_temp-temp.field-value), output curr_code)
     8377                 no-error .
     8378               end.
     8379             end.
     8380             when "CPCurr":U then do:
     8381               if p-pos-type = 'IBM-XML':U
     8382               then
     8383               assign
     8384               curr_code = if kassa-rub-code = integer(buf_temp-temp.field-value)
     8385                           then 0
     8386                           else integer(buf_temp-temp.field-value)
     8387               no-error .
     8388               if p-pos-type = 'Autotank':U then do:
     8389                 assign
     8390                 curr_code = 0 no-error.
     8391               end.
     8392             end.
     8393             when "CPTotal":U then do:
     8394               assign
     8395               tot_sum = fdecimal(buf_temp-temp.field-value)
     8396               no-error .
     8397             end.
     8398             when "CPCard":U then do:
     8399               assign
     8400               pay-card_ = trim(buf_temp-temp.field-value)
     8401               no-error .
     8402             end.
     8403             when "CPRate":U then do:
     8404               assign
     8405               cass-rate = fdecimal(buf_temp-temp.field-value)
     8406               rate-por = 0
     8407               no-error .
     8408             end.
     8409             when "CPCBR":U then do:
     8410               assign
     8411               bank-rate_ = fdecimal(buf_temp-temp.field-value)
     8412               no-error .
     8413             end.
     8414             when "CPMCBR":U then do:
     8415               assign
     8416               bank-scale_ = integer(buf_temp-temp.field-value)
     8417               no-error .
     8418             end.
     8419             when "CPString":U then do:
     8420               assign
     8421               lnp-spl = integer(buf_temp-temp.field-value)
     8422               no-error .
     8423             end.
     8424             when "CPSHandCard":u then do:
     8425               assign
     8426               pass-pay_ =   (if integer(buf_temp-temp.field-value) = 1
     8427                             then 1
     8428                             else 0)
     8429               no-error .
     8430             end.
     8431             when "CPDOC":U then do:
     8432               do i-cpdoc = 1 to num-entries(buf_temp-temp.field-value,',':U):
     8433                   if num-entries(entry(i-cpdoc,buf_temp-temp.field-value),'=':U) >= 2 then do:
     8434                       c-attr-code  = entry(1,entry(i-cpdoc,buf_temp-temp.field-value,','),'=':U).
     8435                       c-attr-value = entry(2,entry(i-cpdoc,buf_temp-temp.field-value,','),'=':U).
     8436                   end.
     8437                 else do:
     8438                       c-attr-code  = "CPDOC".
     8439                       c-attr-value = entry(i-cpdoc,buf_temp-temp.field-value,',').
     8440                 end.
     8441               end.
     8442             end.
     8443             when "CPAgreement" then do:
     8444                vCPAgreement = buf_temp-temp.field-value.
     8445             end.
     8446             when "CPMisc" then do:
     8447                vsbpstat = gettegjson(buf_temp-temp.field-value,"SBpStat").
     8448                vsbprrn  = gettegjson(buf_temp-temp.field-value,"SBPRRN").
     8449                vqrpay   = gettegjson(buf_temp-temp.field-value,"QRPay").
     8450             end.
     8451             when "CPWithdrawal" then do:
     8452                vCPWithdrawal = buf_temp-temp.field-value.
     8453             end.
     8454             otherwise do:
     8455               error-status:error = no.
     8456             end.
     8457           END CASE.
     8458           if error-status:error then do:
     8459             if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     8460           end.
     8461           delete buf_temp-temp.
     8462         end.
     8463         assign
     8464         time-oper_ =  v-time
     8465         no-error
     8466         .
     8467         if error-status:error then do:
     8468           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     8469         end.
     8470         find first buf_chk-doc NO-ERROR.
     8471         find first buf_chk-pay-attr where
     8472               buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8473           and buf_chk-pay-attr.line-num   = lnp-spl
     8474           and buf_chk-pay-attr.attr-code  = 'RTA_RefundExport' no-error.
     8475         if available buf_chk-pay-attr then do:
     8476           assign
     8477             buf_chk-pay-attr.attr-value = buf_chk-pay-attr.attr-value + c-attr-value
     8478             no-error.
     8479           leave _proc-03.
     8480         end.
     8481         CASE par-mode:
     8482           when 0
     8483           or when 1
     8484           then do:
     8485             FIND buf_chk-pay WHERE
     8486                   buf_chk-pay.doc-code = buf_chk-doc.doc-code
     8487               AND buf_chk-pay.curr-code = curr_code
     8488               AND buf_chk-pay.pay-code = pay_code
     8489               and buf_chk-pay.line-num = lnp-spl
     8490               NO-ERROR.
     8491             if NOT available buf_chk-pay
     8492             then  do:
     8493               CREATE buf_chk-pay .
     8494               assign
     8495               buf_chk-pay.doc-code = buf_chk-doc.doc-code
     8496               buf_chk-pay.line-num = lnp-spl
     8497               buf_chk-pay.chk-date = buf_chk-doc.chk-date
     8498               buf_chk-pay.obj-code = shop-code
     8499               buf_chk-pay.obj-type = shop-type
     8500               buf_chk-pay.tot-rubl = 0
     8501               buf_chk-pay.tot-sum  = 0
     8502               buf_chk-pay.tot-base = 0
     8503               buf_chk-pay.pay-code = pay_code
     8504               buf_chk-pay.curr-code = curr_code
     8505               buf_chk-pay.time-oper = time-oper_
     8506               cass-rate = cass-rate * exp( 10, int( rate-por ) )
     8507               buf_chk-pay.cash-rate = cass-rate
     8508               buf_chk-pay.bank-rate = bank-rate_
     8509               buf_chk-pay.bank-scale = bank-scale_
     8510               buf_chk-pay.pass-pay  = pass-pay_
     8511               buf_chk-pay.pay-card  = pay-card_
     8512               buf_chk-pay.line-type = "":U
     8513               buf_chk-pay.line-sign = (if buf_chk-doc.chk-type = integer('1':U)
     8514                                   then (buf_chk-pay.tot-sum >= 0)
     8515                                   else (buf_chk-pay.tot-sum <= 0)
     8516                                   )
     8517               buf_chk-pay.is-error = no
     8518               .
     8519               assign
     8520                 pay-card_ = "".
     8521               if not (c-attr-code = "" or c-attr-code = ?) then do:
     8522                 create buf_chk-pay-attr.
     8523                 assign
     8524                 buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8525                 buf_chk-pay-attr.line-num   = lnp-spl
     8526                 buf_chk-pay-attr.attr-code  = c-attr-code
     8527                 buf_chk-pay-attr.attr-value = c-attr-value
     8528                 no-error.
     8529               end.
     8530               if vCPAgreement ne "" and vCPAgreement ne ?
     8531               then do:
     8532                 create buf_chk-pay-attr.
     8533                 assign
     8534                 buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8535                 buf_chk-pay-attr.line-num   = lnp-spl
     8536                 buf_chk-pay-attr.attr-code  = "CPAgreement"
     8537                 buf_chk-pay-attr.attr-value = vCPAgreement
     8538                 no-error.
     8539               end.
     8540               if vsbpstat ne "" and vsbpstat ne ?
     8541               then do:
     8542                  create buf_chk-pay-attr.
     8543                  assign
     8544                  buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8545                  buf_chk-pay-attr.line-num   = lnp-spl
     8546                  buf_chk-pay-attr.attr-code  = "SBPStat"
     8547                  buf_chk-pay-attr.attr-value = vsbpstat
     8548                  no-error.
     8549               end.
     8550               if vsbprrn ne "" and vsbprrn ne ?
     8551               then do:
     8552                  create buf_chk-pay-attr.
     8553                  assign
     8554                  buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8555                  buf_chk-pay-attr.line-num   = lnp-spl
     8556                  buf_chk-pay-attr.attr-code  = "SBPRRN"
     8557                  buf_chk-pay-attr.attr-value = vsbprrn
     8558                  no-error.
     8559               end.
     8560               if vqrpay ne "" and vqrpay ne ?
     8561               then do:
     8562                  create buf_chk-pay-attr.
     8563                  assign
     8564                  buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8565                  buf_chk-pay-attr.line-num   = lnp-spl
     8566                  buf_chk-pay-attr.attr-code  = "QRPay"
     8567                  buf_chk-pay-attr.attr-value = vqrpay
     8568                  no-error.
     8569               end.
     8570               if vCPWithdrawal ne "" and vCPWithdrawal ne ? and dec(vCPWithdrawal) ne 0
     8571               then do:
     8572                 create buf_chk-pay-attr.
     8573                 assign
     8574                 buf_chk-pay-attr.doc-code   = buf_chk-doc.doc-code
     8575                 buf_chk-pay-attr.line-num   = lnp-spl
     8576                 buf_chk-pay-attr.attr-code  = "CPWithdrawal"
     8577                 buf_chk-pay-attr.attr-value = left-trim(string (dec(vCPWithdrawal),">>>>>>>>>>>9.99") )
     8578                 no-error.
     8579               end.
     8580             end.
     8581             assign
     8582             buf_chk-pay.tot-sum = buf_chk-pay.tot-sum + tot_sum
     8583             .
     8584           end.
     8585         END CASE.
     8586       end.
     8587     end.
     8588   end procedure.
     8589   procedure proc-cash :
     8590   define input parameter loc-exist as logical no-undo .
     8591   define variable par-val_ as decimal no-undo .
     8592   define variable lnp-spl as integer no-undo .
     8593   define variable tot_rubl as decimal no-undo .
     8594   define variable tot_base as decimal no-undo .
     8595   define buffer buf_temp-temp for temp-temp.
     8596   define buffer buf_chk-doc for ub.chk-doc.
     8597   define buffer buf_chk-pay for ub.chk-pay.
     8598     do
     8599     on error undo, return error
     8600     :
     8601       if not loc-exist then do:
     8602         for each buf_temp-temp where
     8603                 buf_temp-temp.record-name = "Cash":U
     8604           AND buf_temp-temp.id = v-id:
     8605           CASE buf_temp-temp.field-name:
     8606             when "CSValue":U then do:
     8607               assign
     8608               tot_sum = fdecimal(buf_temp-temp.field-value)
     8609               no-error .
     8610             end.
     8611             when "CCCode":U then do:
     8612               assign
     8613               curr_code = if kassa-rub-code = integer(buf_temp-temp.field-value)
     8614                           then 0
     8615                           else integer(buf_temp-temp.field-value)
     8616               no-error .
     8617             end.
     8618             when "CAMount":U then do:
     8619               assign
     8620               curr-string-qnty = fdecimal(buf_temp-temp.field-value)
     8621               no-error .
     8622             end.
     8623             when "CValue":u then do:
     8624               assign
     8625               par-val_ =   fdecimal(buf_temp-temp.field-value)
     8626               no-error .
     8627             end.
     8628             when "CPString":u then do:
     8629               assign
     8630               lnc =   integer(buf_temp-temp.field-value)
     8631               no-error .
     8632             end.
     8633             when "CString":u then do:
     8634               assign
     8635               lnp-spl =   integer(buf_temp-temp.field-value)
     8636               no-error .
     8637             end.
     8638             when "CPayCode":U then do:
     8639               if p-pos-type = 'IBM-XML':U
     8640               or p-pos-type = 'Autotank':U
     8641               then do:
     8642                 assign
     8643                 pay_code = integer(buf_temp-temp.field-value)
     8644                 no-error .
     8645               end.
     8646             end.
     8647             when "CCCode":U then do:
     8648               if p-pos-type = 'IBM-XML':U
     8649               or p-pos-type = 'Autotank':U
     8650               then
     8651               assign
     8652               curr_code = if kassa-rub-code = integer(buf_temp-temp.field-value)
     8653                           then 0
     8654                           else integer(buf_temp-temp.field-value)
     8655               no-error .
     8656             end.
     8657             when "CRate":U then do:
     8658               assign
     8659               rate-por = 0
     8660               cass-rate = fdecimal(buf_temp-temp.field-value)
     8661               no-error .
     8662             end.
     8663             when "CSBase" then do:
     8664               assign
     8665               tot_base = fdecimal(buf_temp-temp.field-value)
     8666               no-error .
     8667             end.
     8668             when "CSNat" then do:
     8669               assign
     8670               tot_rubl = fdecimal(buf_temp-temp.field-value)
     8671               no-error .
     8672             end.
     8673             otherwise do:
     8674               error-status:error = no.
     8675             end.
     8676           END CASE.
     8677           if error-status:error then do:
     8678             if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     8679           end.
     8680           delete buf_temp-temp.
     8681         end.
     8682         assign
     8683         time-oper_ =  v-time
     8684         no-error
     8685         .
     8686         find first buf_chk-doc no-error.
     8687         if par-val_ = 0
     8688         and buf_chk-doc.chk-type = integer('7':U) then do:
     8689         end.
     8690         else do:
     8691         FIND buf_chk-pay WHERE
     8692               buf_chk-pay.doc-code = buf_chk-doc.doc-code
     8693           AND buf_chk-pay.curr-code = curr_code
     8694           AND buf_chk-pay.pay-code = pay_code
     8695           and buf_chk-pay.line-num = lnp-spl
     8696           and buf_chk-pay.src-val = par-val_
     8697           NO-ERROR.
     8698         if NOT available buf_chk-pay then  do:
     8699           CREATE buf_chk-pay .
     8700           assign
     8701           buf_chk-pay.doc-code = buf_chk-doc.doc-code
     8702           buf_chk-pay.line-num = lnp-spl
     8703           buf_chk-pay.chk-date = buf_chk-doc.chk-date
     8704           buf_chk-pay.obj-code = shop-code
     8705           buf_chk-pay.obj-type = shop-type
     8706           buf_chk-pay.tot-rubl = 0
     8707           buf_chk-pay.tot-sum = 0
     8708           buf_chk-pay.tot-base = 0
     8709           buf_chk-pay.pay-code = pay_code
     8710           buf_chk-pay.curr-code = curr_code
     8711           buf_chk-pay.time-oper = time-oper_
     8712           cass-rate = cass-rate * exp( 10, int( rate-por ) )
     8713           buf_chk-pay.cash-rate = cass-rate
     8714           buf_chk-pay.bank-rate = 1
     8715           buf_chk-pay.bank-scale = 1
     8716           buf_chk-pay.pass-pay = 1
     8717           buf_chk-pay.pay-card = ''
     8718           buf_chk-pay.line-type = "":U
     8719           buf_chk-pay.line-sign = (if buf_chk-doc.chk-type = integer('2':U)
     8720                                 or buf_chk-doc.chk-type =  integer('5':U
     8721                                 )
     8722                               then (buf_chk-pay.tot-sum <= 0)
     8723                               else (buf_chk-pay.tot-sum >= 0)
     8724                               )
     8725           buf_chk-pay.is-error = no
     8726           .
     8727         end.
     8728         assign
     8729         buf_chk-pay.tot-sum = buf_chk-pay.tot-sum + (if par-val_ = 0
     8730                                        then tot_sum
     8731                                        else 0)
     8732         .
     8733         if par-val_ > 0
     8734         or curr-string-qnty <> 0 then do:
     8735           assign
     8736           buf_chk-pay.src-qnty = curr-string-qnty
     8737           buf_chk-pay.src-val  = par-val_
     8738           buf_chk-pay.tot-sum = par-val_ * curr-string-qnty
     8739           .
     8740         end.
     8741         end.
     8742       end.
     8743     end.
     8744   end procedure.
     8745   procedure cb-xmlparse-tag-start-check :
     8746       define input parameter p-parameter as character no-undo .
     8747       do
     8748           on error undo, return error
     8749               :
     8750           if v-is-spool-file
     8751           and
     8752           v-start-check = 0 then do:
     8753               assign
     8754                   v-start-check = v-start-check + 1
     8755                   .
     8756           end.
     8757           else do:
     8758               if v-is-spool-file then do:
     8759                   run write-log-and-file in p-log-handle (
     8760                       input 1
     8761                       , input log-file-name
     8762                       , input 1
     8763                       , input substitute( "!!!Тэг Check не закрыт - чек не завершен перед строкой &1", var-file-line-num)).
     8764                   assign
     8765                       p-view-log = yes
     8766                       .
     8767               end.
     8768           end.
     8769       end.
     8770   end procedure.
     8771   procedure cb-xmlparse-tag-end-check :
     8772       define input parameter p-parameter as character no-undo .
     8773       do
     8774           on error undo, return error
     8775               :
     8776           if v-start-check =  1 then do:
     8777               assign
     8778                   v-start-check = 0
     8779                   .
     8780               run proc-end-chk in this-procedure no-error .
     8781               run proc-end in this-procedure no-error .
     8782           end.
     8783           else do:
     8784               assign
     8785                   v-start-check = v-start-check - 1
     8786                   .
     8787           end.
     8788       end.
     8789   end procedure.
     8790   PROCEDURE cb-xmlvalid-procedure-not-found :
     8791       do
     8792           on error undo, return error
     8793               :
     8794           define input parameter p-type       as character    no-undo.
     8795           define input parameter p-value      as character    no-undo.
     8796           define input parameter p-parameters as character    no-undo.
     8797           define variable v-id-loc as character no-undo .
     8798           define variable v-time-loc as integer no-undo .
     8799           define variable v-time-loc-char as character no-undo .
     8800           define variable v-group-loc as character no-undo .
     8801           define variable v-key-char as character no-undo .
     8802           define buffer first_temp-temp for temp-temp.
     8803           define buffer slave_temp-temp for temp-temp.
     8804           define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     8805           define buffer buf_chk-pay-attr for tt-chk-pay-attr.
     8806           define buffer buf_chk-pay for tt-chk-pay.
     8807           case p-type
     8808               :
     8809               when "tag-end" then do:
     8810                   CASE p-value:
     8811                       when "CHead":U then do:
     8812                           if v-start-check = 1 then
     8813                               run proc-00 in this-procedure no-error .
     8814                       end.
     8815                       when "CACHistory":U then do:
     8816                           run proc-ach in this-procedure ( input exist) no-error .
     8817                       end.
     8818                       when "CBarCode":U then do:
     8819                           CBCType_= 0.
     8820                           CBCString_ = 0.
     8821                           CBCBarcode_ = "".
     8822                           if v-start-check = 1 then
     8823                               run proc-02-gds in this-procedure no-error .
     8824                       end.
     8825                       when "CAuthorization":U then do:
     8826                           AuthType_ = 0.
     8827                           qr-alchol_ = "".
     8828                           if v-start-check = 1 then
     8829                               run proc-CAuthorization in this-procedure no-error .
     8830                       end.
     8831                       when "ACHData":U then do:
     8832                           run proc-ach-data in this-procedure no-error.
     8833                       end.
     8834                       when "ACHExp":U then do:
     8835                           run proc-ach-exp in this-procedure no-error.
     8836                       end.
     8837                       when "CFReg":U then do:
     8838                           if get-chkc_context.z-check then do:
     8839                               run proc-cfreg in this-procedure no-error.
     8840                           end.
     8841                           else do:
     8842                               error-status:error = no.
     8843                           end.
     8844                       end.
     8845                       when "CSale":U then do:
     8846                           if v-start-check = 1 then
     8847                           CASE gbl-type:
     8848                               when "1" or
     8849                               when "6" or
     8850                               when "8" or
     8851                               when "14" or
     8852                               when "15" or
     8853                               when "16" or
     8854                               when "17" or
     8855                               when "36" or
     8856                               when "43" or
     8857                               when "44"
     8858                               then do:
     8859                                   run proc-01-gds in this-procedure no-error .
     8860                               end.
     8861                               when "4" then do:
     8862                                   run proc-01-wth in this-procedure no-error .
     8863                               end.
     8864                               otherwise do:
     8865                               end.
     8866                           END CASE.
     8867                       end.
     8868                       when "CPay":U then do:
     8869                           if v-start-check = 1 then
     8870                           do:
     8871                               run proc-03 in this-procedure (input (if gbl-type = "4" then 1 else 0)
     8872                                   , input (if gbl-type = "4" then mc-exist else exist)
     8873                                   ) no-error .
     8874                               if p-pos-type = 'Autotank':U and autotank-sum-return < 0  then
     8875                               do:
     8876                                   run create-temp-table-record( input v-record-name, input "CPCode", input  "0")  .
     8877                                   run create-temp-table-record( input v-record-name, input "CPTotal", input  string(autotank-sum-return))  .
     8878                                   run create-temp-table-record( input v-record-name, input "CPString", input  "2")  .
     8879                                   run proc-03 in this-procedure (input (if gbl-type = "4" then 1 else 0)
     8880                                       , input (if gbl-type = "4" then mc-exist else exist)
     8881                                       ) no-error .
     8882                                   find first buf_chk-pay no-error.
     8883                                   if available buf_chk-pay
     8884                                   then do:
     8885                                       create buf_chk-pay-attr.
     8886                                       assign buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     8887                                           buf_chk-pay-attr.line-num = 2
     8888                                           buf_chk-pay-attr.attr-code = "autotank-sum-return"
     8889                                           buf_chk-pay-attr.attr-value = string(autotank-sum-return)
     8890                                           autotank-sum-return = 0
     8891                                           .
     8892                                   end.
     8893                               end .
     8894                           end .
     8895                       end.
     8896                       when "BonusAdd":U then do:
     8897                           if v-start-check = 1 then
     8898                               run proc-bonus in this-procedure no-error .
     8899                       end.
     8900                       when "CPromo":U then do:
     8901                           if v-start-check = 1 then
     8902                               run proc-promo in this-procedure no-error .
     8903                       end.
     8904                       when "CDisc":U then do:
     8905                           if v-start-check = 1 then
     8906                               run proc-disc in this-procedure no-error .
     8907                       end.
     8908                       when "Param":U then do:
     8909                           run proc-Parameter in this-procedure no-error .
     8910                       end.
     8911                       when "FuelPump":U then do:
     8912                           run proc-FuelPump in this-procedure no-error .
     8913                       end.
     8914                       when "Invent":U then do:
     8915                           if v-start-check = 1 then
     8916                               run proc-inv in this-procedure no-error .
     8917                       end.
     8918                       when "Cash":U then do:
     8919                           if v-start-check = 1 then
     8920                               run proc-cash in this-procedure (input mc-exist) no-error .
     8921                       end.
     8922                       when "CFiscal":U then do:
     8923                           if v-start-check = 1 then do:
     8924                               if get-chkc_context.z-check then do:
     8925                                   run proc-cfiscal in this-procedure ( input exist) no-error .
     8926                               end.
     8927                               else do:
     8928                                   error-status:error = no.
     8929                               end.
     8930                           end.
     8931                       end.
     8932                       when "Advance":U then do:
     8933                       end.
     8934                       when "DocumentName":U
     8935                       or
     8936                       when "DateFormat":U
     8937                       or
     8938                       when "DocumentVersion":U
     8939                       or
     8940                       when "objList":U then do:
     8941                           run fill-doc-property in this-procedure (
     8942                               input p-value
     8943                               , input v-xmlvalid-tag-value
     8944                               ) no-error .
     8945                           if error-status :error
     8946                           then do:
     8947                               assign
     8948                                   p-view-log = yes
     8949                                   .
     8950                               run write-log-and-file in p-log-handle (
     8951                                   input 1
     8952                                   , input log-file-name
     8953                                   , input 1
     8954                                   , input substitute( "!!!При обработке файла &1 произошла ошибка при чтении свойств документа XML: &2"
     8955                                   , file_
     8956                                   , return-value
     8957                                   )
     8958                                   ).
     8959                               assign
     8960                                   p-view-log = yes
     8961                                   .
     8962                               return "error":U.
     8963                           end.
     8964                       end.
     8965                       otherwise do:
     8966                           run create-temp-table-record( input v-record-name, input p-value, input  v-xmlvalid-tag-value) no-error .
     8967                           if error-status :error
     8968                           then do:
     8969                               run write-log-and-file in p-log-handle (
     8970                                   input 1
     8971                                   , input log-file-name
     8972                                   , input 1
     8973                                   , input substitute( "!!!При обработке файла &1 произошла ошибка при чтении записей документа XML: &2"
     8974                                   , file_
     8975                                   , return-value
     8976                                   )
     8977                                   ).
     8978                               assign
     8979                                   p-view-log = yes
     8980                                   .
     8981                               return "error":U.
     8982                           end.
     8983                       end.
     8984                   end CASE.
     8985               end.
     8986               when "tag-start" then do:
     8987                   CASE p-value:
     8988                       when "CHead":U
     8989                       or
     8990                       when "CBarCode":U
     8991                       or
     8992                       when "CAuthorization":U
     8993                       or
     8994                       when "CSale":U
     8995                       or
     8996                       when "CPay":U
     8997                       or
     8998                       when "CDisc":U
     8999                       or
     9000                       when "BonusAdd":U
     9001                       or
     9002                       when "CPromo":U
     9003                       or
     9004                       when "BonusAdd":U
     9005                       or
     9006                       when "Invent":U
     9007                       or
     9008                       when "Cash":U
     9009                       or
     9010                       when "Advance":U
     9011                       or
     9012                       when "CACHistory"
     9013                       or
     9014                       when "ACHData"
     9015                       or
     9016                       when "ACHExp"
     9017                       or
     9018                       when "CFReg"
     9019                       or
     9020                       when "CFiscal"
     9021                       then do:
     9022                           if p-value = "CACHistory" then do:
     9023                               define buffer buf_achd for achd.
     9024                               define buffer buf_ache for ache.
     9025                               for each buf_achd:
     9026                                   delete buf_achd.
     9027                               end.
     9028                               for each buf_ache:
     9029                                   delete buf_ache.
     9030                               end.
     9031                           end.
     9032                           if v-start-check = 1 then do:
     9033                               assign
     9034                                   v-record-name = p-value
     9035                                   .
     9036                               if  not (p-value = "ACHData"
     9037                               or
     9038                               p-value = "ACHExp"
     9039                               or
     9040                               p-value = "CFReg"
     9041                               ) then do:
     9042                                   assign
     9043                                       CRI = 0
     9044                                       CRAI = 0
     9045                                       .
     9046                                   assign
     9047                                       v-id-loc = ?
     9048                                       v-time-loc = ?
     9049                                       v-time-loc-char = ?
     9050                                       v-id-loc = cb-xmlparse-get-attr(
     9051                                       input this-procedure:handle
     9052                                       ,input p-value
     9053                                       ,input p-parameters
     9054                                       ,input "id":U
     9055                                       ,input yes)
     9056                                       v-time-loc-char = cb-xmlparse-get-attr(
     9057                                       input this-procedure:handle
     9058                                       ,input p-value
     9059                                       ,input p-parameters
     9060                                       ,input "time":U
     9061                                       ,input no)
     9062                                       v-time-loc   = if p-pos-type = 'MAGIA-XML':U then integer(v-time-loc-char) else v-time-loc
     9063                                       no-error
     9064                                       .
     9065                               end.
     9066                               if (p-value <> "CHead":U
     9067                               and
     9068                               v-id-loc <> v-id
     9069                               and p-value <> "ACHData" and p-value <> "ACHExp" and p-value <> "CFReg"
     9070                               ) then do:
     9071                                   assign
     9072                                       v-start-check = v-start-check - 1
     9073                                       .
     9074                                   run write-log-and-file in p-log-handle (
     9075                                       input 1
     9076                                       , input log-file-name
     9077                                       , input 1
     9078                                       , input substitute( "!!!Тэг &1 - атрибут id=&2 не равен соответствующему атрибуту тэга Check - нарушен порядок данных"
     9079                                       ,p-value
     9080                                       ,v-id-loc
     9081                                       )
     9082                                       ).
     9083                                   assign
     9084                                       v-cd-fatal-error = yes
     9085                                       v-cd-fatal-message = "нарушение протокола обмена"
     9086                                       p-view-log = yes
     9087                                       .
     9088                                   return "error".
     9089                               end.
     9090                               if  (v-id-loc = ?
     9091                               and
     9092                               not (p-value = "ACHData"
     9093                               or
     9094                               p-value = "ACHExp"
     9095                               or
     9096                               p-value = "CFReg"
     9097                               )
     9098                               )
     9099                               or (v-time-loc-char = ?
     9100                               and p-value = "CHead":U)
     9101                               then do:
     9102                                   assign
     9103                                       v-start-check = v-start-check - 1
     9104                                       .
     9105                                   run write-log-and-file in p-log-handle (
     9106                                       input 1
     9107                                       , input log-file-name
     9108                                       , input 1
     9109                                       , input substitute( "!!!Тэг &1 - отсутствует необходимый атрибут &2"
     9110                                       , p-value
     9111                                       , (if v-id-loc = ? then "id" else "time")
     9112                                       )
     9113                                       ).
     9114                                   assign
     9115                                       v-cd-fatal-error = yes
     9116                                       v-cd-fatal-message = "нарушение протокола обмена"
     9117                                       p-view-log = yes
     9118                                       .
     9119                                   return "error".
     9120                               end.
     9121                               else do:
     9122                                   if
     9123                                   not (p-value = "ACHData"
     9124                                   or
     9125                                   p-value = "ACHExp"
     9126                                   or
     9127                                   p-value = "CFReg"
     9128                                   )
     9129                                   then
     9130                                       assign
     9131                                           v-id = v-id-loc
     9132                                           v-time = v-time-loc
     9133                                           v-time-char = v-time-loc-char
     9134                                           .
     9135                               end.
     9136                           end.
     9137                       end.
     9138                       when "FuelPump":U then do:
     9139                           assign
     9140                               v-record-name = p-value
     9141                               CRI = 0
     9142                               CRAI = 0
     9143                               .
     9144                           assign
     9145                               v-key-char = ?
     9146                               v-group-loc = ? .
     9147                           v-group-loc = cb-xmlparse-get-attr(
     9148                               input this-procedure:handle
     9149                               ,input p-value
     9150                               ,input p-parameters
     9151                               ,input "code":U
     9152                               ,input yes) .
     9153                           v-key-char = cb-xmlparse-get-attr(
     9154                               input this-procedure:handle
     9155                               ,input p-value
     9156                               ,input p-parameters
     9157                               ,input "ctrl":U
     9158                               ,input no) .
     9159                           if v-group-loc = ?
     9160                           or v-key-char = ?
     9161                           then do:
     9162                               assign
     9163                                   v-start-check = v-start-check - 1
     9164                                   .
     9165                               run write-log-and-file in p-log-handle (
     9166                                   input 1
     9167                                   , input log-file-name
     9168                                   , input 1
     9169                                   , input substitute( "!!!Тэг &1 - отсутствует необходимый атрибут &2"
     9170                                   , p-value
     9171                                   , (if v-group-loc = ? then "code" else "ctrl")
     9172                                   )
     9173                                   ).
     9174                               assign
     9175                                   v-cd-fatal-error = yes
     9176                                   v-cd-fatal-message = "нарушение протокола обмена"
     9177                                   p-view-log = yes
     9178                                   .
     9179                               return "error".
     9180                           end.
     9181                           else do:
     9182                               assign
     9183                                   v-group = v-group-loc
     9184                                   v-key = v-key-char
     9185                                   .
     9186                           end.
     9187                       end.
     9188                       when "Param":U
     9189                       then do:
     9190                           assign
     9191                               v-record-name = p-value
     9192                               CRI = 0
     9193                               CRAI = 0
     9194                               .
     9195                           assign
     9196                               v-key-char = ?
     9197                               v-group-loc = ? .
     9198                           v-group-loc = cb-xmlparse-get-attr(
     9199                               input this-procedure:handle
     9200                               ,input p-value
     9201                               ,input p-parameters
     9202                               ,input "group":U
     9203                               ,input yes) .
     9204                           v-key-char = cb-xmlparse-get-attr(
     9205                               input this-procedure:handle
     9206                               ,input p-value
     9207                               ,input p-parameters
     9208                               ,input "key":U
     9209                               ,input no) .
     9210                           if v-group-loc = ?
     9211                           or v-key-char = ?
     9212                           then do:
     9213                               assign
     9214                                   v-start-check = v-start-check - 1
     9215                                   .
     9216                               run write-log-and-file in p-log-handle (
     9217                                   input 1
     9218                                   , input log-file-name
     9219                                   , input 1
     9220                                   , input substitute( "!!!Тэг &1 - отсутствует необходимый атрибут &2"
     9221                                   , p-value
     9222                                   , (if v-group-loc = ? then "group" else "key")
     9223                                   )
     9224                                   ).
     9225                               assign
     9226                                   v-cd-fatal-error = yes
     9227                                   v-cd-fatal-message = "нарушение протокола обмена"
     9228                                   p-view-log = yes
     9229                                   .
     9230                               return "error".
     9231                           end.
     9232                           else do:
     9233                               assign
     9234                                   v-group = v-group-loc
     9235                                   v-key = v-key-char
     9236                                   .
     9237                           end.
     9238                       end.
     9239                       otherwise do:
     9240                           error-status:error = no.
     9241                       end.
     9242                   END CASE.
     9243               end.
     9244               when "text"
     9245               then do:
     9246               end.
     9247               otherwise do:
     9248               end.
     9249           end case.
     9250       end.
     9251   END PROCEDURE.
     9252   procedure proc-create-return-write-off :
     9253       define input parameter p-doc-code like ub.chk-doc.doc-code no-undo .
     9254       define input parameter p-chk-type like ub.chk-doc.chk-type no-undo .
     9255       define input  parameter p-write-off-code-2 like ub.chk-gds.write-off-code  no-undo .
     9256       define output parameter p-doc-code2 like ub.chk-doc.doc-code no-undo .
     9257       define output parameter p-netto-sum as decimal no-undo .
     9258       define buffer buf_chk-doc for ub.chk-doc.
     9259       define buffer first_chk-doc for ub.chk-doc.
     9260       define buffer buf_chk-gds for ub.chk-gds.
     9261       define buffer buf_chk-pay for ub.chk-pay.
     9262       define buffer buf_chk-discnt for ub.chk-discnt.
     9263       do
     9264           on error undo, return error
     9265               :
     9266           find first first_chk-doc where first_chk-doc.doc-code = p-doc-code no-lock no-error.
     9267           if not available first_chk-doc then do:
     9268               return.
     9269           end.
     9270           FIND  buf_chk-doc where
     9271               buf_chk-doc.obj-type = first_chk-doc.obj-type and
     9272               buf_chk-doc.obj-code = first_chk-doc.obj-code  and
     9273               buf_chk-doc.chk-date = first_chk-doc.chk-date and
     9274               buf_chk-doc.pay-desk = first_chk-doc.pay-desk and
     9275               buf_chk-doc.chk-time = first_chk-doc.chk-time and
     9276               buf_chk-doc.chk-num =  first_chk-doc.chk-num and
     9277               buf_chk-doc.sales-man = first_chk-doc.sales-man and
     9278               buf_chk-doc.chk-type = p-chk-type   NO-ERROR NO-WAIT.
     9279           IF NOT AVAIL buf_chk-doc AND NOT LOCKED buf_chk-doc  AND NOT AMBIGUOUS buf_chk-doc then do:
     9280               CREATE buf_chk-doc .
     9281               assign
     9282                   lll = lll + 1
     9283                   buf_chk-doc.chk-date = first_chk-doc.chk-date
     9284                   buf_chk-doc.chk-time = first_chk-doc.chk-time
     9285                   buf_chk-doc.chk-num = first_chk-doc.chk-num
     9286                   buf_chk-doc.sales-man = first_chk-doc.sales-man
     9287                   buf_chk-doc.pay-desk = first_chk-doc.pay-desk
     9288                   buf_chk-doc.cashier = first_chk-doc.cashier
     9289                   buf_chk-doc.office = first_chk-doc.office
     9290                   buf_chk-doc.obj-type = first_chk-doc.obj-type
     9291                   buf_chk-doc.obj-code = first_chk-doc.obj-code
     9292                   buf_chk-doc.tot-doc =  0
     9293                   buf_chk-doc.discnt = 0
     9294                   p-doc-code2 = (if get-chkc_context.db-num = 0
     9295                   then string(next-value(s-chk, ub ))
     9296                   else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     9297                   buf_chk-doc.doc-code = p-doc-code2
     9298                   buf_chk-doc.netto = 0
     9299                   p-netto-sum = - first_chk-doc.netto
     9300                   buf_chk-doc.shift-date = first_chk-doc.shift-date
     9301                   buf_chk-doc.shift-num = first_chk-doc.shift-num
     9302                   buf_chk-doc.src-d-card = first_chk-doc.src-d-card
     9303                   buf_chk-doc.src-shift-date = first_chk-doc.src-shift-date
     9304                   buf_chk-doc.cash-rate = first_chk-doc.cash-rate
     9305                   buf_chk-doc.cash-scale = first_chk-doc.cash-scale
     9306                   buf_chk-doc.z-number = first_chk-doc.z-number
     9307                   buf_chk-doc.correct = first_chk-doc.correct
     9308                   buf_chk-doc.chk-type = p-chk-type
     9309                   buf_chk-doc.src-d-pcnt = first_chk-doc.src-d-pcnt
     9310                   .
     9311               FOR EACH ub.chk-pay WHERE
     9312                   ub.chk-pay.doc-code = first_chk-doc.doc-code :
     9313                   BUFFER-COPY ub.chk-pay TO buf_chk-pay
     9314                       assign
     9315                       buf_chk-pay.tot-sum = - ub.chk-pay.tot-sum
     9316                       buf_chk-pay.tot-rubl = - ub.chk-pay.tot-rubl
     9317                       buf_chk-pay.tot-base = - ub.chk-pay.tot-base
     9318                       buf_chk-pay.doc-code = buf_chk-doc.doc-code
     9319                       .
     9320               END.
     9321               assign
     9322                   netto-for-sub-d = 0
     9323                   accum-src-for-sub-d = 0
     9324                   .
     9325               FOR EACH ub.chk-gds WHERE
     9326                   ub.chk-gds.doc-code = first_chk-doc.doc-code :
     9327                   find first temp-ivs-ibs-line where
     9328                       temp-ivs-ibs-line.line-num = abs(chk-gds.line-num) no-error .
     9329                   BUFFER-COPY ub.chk-gds TO buf_chk-gds
     9330                       assign
     9331                       buf_chk-gds.src-qnty = (if available temp-ivs-ibs-line
     9332                       then (if temp-ivs-ibs-line.qnty-sign[2] = 0
     9333                       then 0
     9334                       else  - ub.chk-gds.src-qnty)
     9335                       else - ub.chk-gds.src-qnty)
     9336                       buf_chk-gds.src-sum = - (if temp-ivs-ibs-line.qnty-sign[2] = 0
     9337                       then 0
     9338                       else  ub.chk-gds.src-sum)
     9339                       buf_chk-gds.doc-code = buf_chk-doc.doc-code
     9340                       buf_chk-gds.write-off-code = (if available temp-ivs-ibs-line
     9341                       then integer(temp-ivs-ibs-line.wro-code[2])
     9342                       else p-write-off-code-2)
     9343                       netto-for-sub-d = netto-for-sub-d + if temp-ivs-ibs-line.return-line
     9344                       or buf_chk-gds.doc-qnty = 0
     9345                       then 0
     9346                       else (
     9347                       (if buf_chk-gds.write-off-code = ?
     9348                       or buf_chk-gds.write-off-code <= 0
     9349                       then
     9350                       ((buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     9351                       else 0)
     9352                       )
     9353                       accum-src-for-sub-d = accum-src-for-sub-d + (if temp-ivs-ibs-line.return-line then 0 else buf_chk-gds.src-qnty)
     9354                       .
     9355               END.
     9356               var-discnt-id = 0.
     9357               FOR EACH ub.chk-discnt WHERE
     9358                   ub.chk-discnt.doc-code = first_chk-doc.doc-code
     9359                       AND ub.chk-discnt.record-type = 0:
     9360                   BUFFER-COPY ub.chk-discnt TO buf_chk-discnt
     9361                       assign
     9362                       buf_chk-discnt.discnt-value-abs = - ub.chk-discnt.discnt-value-abs
     9363                       buf_chk-discnt.discnt-value-pcnt = - ub.chk-discnt.discnt-value-pcnt
     9364                       buf_chk-discnt.object-qnty = - ub.chk-discnt.object-qnty
     9365                       buf_chk-discnt.object-sum = - ub.chk-discnt.object-sum
     9366                       buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     9367                       var-discnt-id = (if buf_chk-discnt.discnt-id > var-discnt-id
     9368                       then buf_chk-discnt.discnt-id
     9369                       else var-discnt-id)
     9370                       .
     9371               END.
     9372           end.
     9373       end.
     9374   end procedure.
     9375   procedure proc-netto-2 :
     9376       define input parameter p-doc-code like ub.chk-doc.doc-code no-undo .
     9377       define input parameter p-doc-code2 like ub.chk-doc.doc-code no-undo .
     9378       define output parameter p-netto-sum as decimal no-undo .
     9379       define buffer buf1_chk-doc for ub.chk-doc.
     9380       define buffer buf_chk-doc for ub.chk-doc.
     9381       do
     9382           on error undo, return error
     9383               :
     9384           find first buf1_chk-doc where buf1_chk-doc.doc-code = p-doc-code no-lock no-error.
     9385           if not available buf1_chk-doc then do:
     9386               return.
     9387           end.
     9388           find first buf_chk-doc where buf_chk-doc.doc-code = p-doc-code2 no-error.
     9389           if not available buf_chk-doc then do:
     9390               return.
     9391           end.
     9392           assign
     9393               buf_chk-doc.netto = - buf1_chk-doc.netto
     9394               p-netto-sum = buf_chk-doc.netto.
     9395           .
     9396       end.
     9397   end procedure.
     9398   procedure recalc-write-off :
     9399       define parameter buffer buf_chk-doc for ub.chk-doc.
     9400       define input  parameter p-old-gbl-type as character no-undo .
     9401       define input  parameter p-gbl-type as character no-undo .
     9402       define variable old-chk-type as integer   no-undo extent 2.
     9403       define variable old-create-return-write-off as logical   no-undo .
     9404       define variable old-return-line as logical   no-undo .
     9405       define variable v-step as integer   no-undo .
     9406       define variable v-is-modificator as logical   no-undo .
     9407       define buffer find_chk-doc for ub.chk-doc.
     9408       define buffer buf_chk-gds for ub.chk-gds.
     9409       define buffer return_chk-gds for ub.chk-gds.
     9410       define buffer buf_temp-ivs-ibs-line for temp-ivs-ibs-line.
     9411       do
     9412           on error undo, return error return-value
     9413               :
     9414           assign
     9415               gbl-type = p-gbl-type.
     9416           for each temp-ivs-ibs where
     9417               temp-ivs-ibs.chtype = gbl-type
     9418                   AND temp-ivs-ibs.positive-num-chk = (chk-num_ > 0)
     9419                   AND temp-ivs-ibs.positive-netto-sum = (netto-sum_ > 0)
     9420                   and temp-ivs-ibs.main-record = yes:
     9421               if temp-ivs-ibs.step_ = 1 then do:
     9422                   assign
     9423                       old-chk-type[1] = v-chk-type[1]
     9424                       v-chk-type[1] = integer(temp-ivs-ibs.rcpt-type-1).
     9425                   v-step = temp-ivs-ibs.step.
     9426               end.
     9427               if temp-ivs-ibs.step_ = 2 then do:
     9428                   assign
     9429                       old-chk-type[2] = v-chk-type[2]
     9430                       v-chk-type[2] = integer(temp-ivs-ibs.rcpt-type-1)
     9431                       old-create-return-write-off = v-create-return-write-off
     9432                       v-create-return-write-off = temp-ivs-ibs.create-return-write-off
     9433                       v-write-off-code-2 = integer(temp-ivs-ibs.wro-code)
     9434                       v-step = temp-ivs-ibs.step.
     9435                   .
     9436               end.
     9437               if v-step = 2
     9438               or (old-chk-type[v-step] <> v-chk-type[v-step]
     9439               and v-step = 1)
     9440               then do:
     9441                   FIND  find_chk-doc no-lock where
     9442                       find_chk-doc.obj-type = shop-type and
     9443                       find_chk-doc.obj-code = shop-code and
     9444                       find_chk-doc.chk-date = chk-date_ and
     9445                       find_chk-doc.pay-desk = pay-desk_ and
     9446                       find_chk-doc.chk-time = chk-time_ and
     9447                       find_chk-doc.chk-num = chk-num_ and
     9448                       find_chk-doc.chk-type = integer(v-chk-type[v-step])
     9449                       NO-ERROR NO-WAIT.
     9450                   if available find_chk-doc
     9451                   then do:
     9452                       if v-step <> 1
     9453                       or find_chk-doc.doc-code <> buf_chk-doc.doc-code then
     9454                           v-to-delete[v-step] = yes.
     9455                   end.
     9456                   else do:
     9457                       v-to-delete[v-step] = no.
     9458                   end.
     9459               end.
     9460           end.
     9461           if v-to-delete[1] = yes then return.
     9462           assign
     9463               sub-d = 0
     9464               var-discnt-id = 0
     9465               lng-sub-d = 0
     9466               netto-for-sub-d = 0
     9467               accum-src-for-sub-d = 0
     9468               buf_chk-doc.chk-type = v-chk-type[1]
     9469               .
     9470           for each buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     9471               if buf_chk-gds.line-num < 0 then next.
     9472                           v-is-modificator = (lookup (string(buf_chk-gds.write-off-code),  '2,-2,3,-3,-4':U) > 0).
     9473               do v-step = 1 to (if v-create-return-write-off then 2 else 1):
     9474                   find first buf_temp-ivs-ibs-line where
     9475                       buf_temp-ivs-ibs-line.line-num = abs(buf_chk-gds.line-num).
     9476                   find first temp-ivs-ibs where
     9477                       temp-ivs-ibs.chtype = gbl-type
     9478                       AND temp-ivs-ibs.cstype = buf_temp-ivs-ibs-line.cstype
     9479                       and temp-ivs-ibs.cancelcode = buf_temp-ivs-ibs-line.cancelcode
     9480                       and temp-ivs-ibs.positive-num-chk = (buf_chk-doc.chk-num > 0)
     9481                       and temp-ivs-ibs.positive-netto-sum = (netto-sum_ > 0)
     9482                       and temp-ivs-ibs.modificator = buf_temp-ivs-ibs-line.modificator
     9483                       and (v-is-modificator = no or temp-ivs-ibs.modificator-np = buf_temp-ivs-ibs-line.modificator-np)
     9484                       and temp-ivs-ibs.step_ = v-step no-error .
     9485                   if available temp-ivs-ibs then do:
     9486                       if v-step  = 1 then do:
     9487                           assign
     9488                               temp-ivs-ibs-line.chtype = temp-ivs-ibs.chtype
     9489                               temp-ivs-ibs-line.create-return-write-off =  temp-ivs-ibs.create-return-write-off
     9490                               old-return-line = buf_temp-ivs-ibs-line.return-line
     9491                               temp-ivs-ibs-line.return-line = temp-ivs-ibs.return-line
     9492                               temp-ivs-ibs-line.rcpt-type-1                        = temp-ivs-ibs.rcpt-type-1
     9493                               temp-ivs-ibs-line.wro-code[v-step]                   = temp-ivs-ibs.wro-code
     9494                               temp-ivs-ibs-line.qnty-sign[v-step]                  = temp-ivs-ibs.qnty-sign
     9495                               .
     9496                       end.
     9497                       if v-step = 2
     9498                       and available buf_temp-ivs-ibs-line
     9499                       and available temp-ivs-ibs then do:
     9500                           assign
     9501                               buf_temp-ivs-ibs-line.rcpt-type-2                        = temp-ivs-ibs.rcpt-type-1
     9502                               buf_temp-ivs-ibs-line.wro-code[v-step]                   = temp-ivs-ibs.wro-code
     9503                               buf_temp-ivs-ibs-line.qnty-sign[v-step]                  = temp-ivs-ibs.qnty-sign
     9504                               .
     9505                       end.
     9506                   end.
     9507               end.
     9508               if old-return-line = no
     9509               and buf_temp-ivs-ibs-line.return-line = no then do:
     9510                   find first return_chk-gds where
     9511                       return_chk-gds.doc-code = buf_chk-doc.doc-code
     9512                       AND return_chk-gds.line-num = - buf_chk-gds.line-num no-error .
     9513                   if available return_chk-gds then delete return_chk-gds.
     9514               end.
     9515               assign
     9516                   buf_chk-gds.write-off-code = integer(buf_temp-ivs-ibs-line.wro-code[1])
     9517                   netto-for-sub-d = netto-for-sub-d + if buf_temp-ivs-ibs-line.return-line
     9518                   then 0
     9519                   else (
     9520                   (if buf_chk-gds.write-off-code = ?
     9521                   or buf_chk-gds.write-off-code <= 0
     9522                   then
     9523                   ((buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     9524                   else 0)
     9525                   )
     9526                   accum-src-for-sub-d = accum-src-for-sub-d + (if buf_temp-ivs-ibs-line.return-line then 0 else buf_chk-gds.src-qnty)
     9527                   .
     9528               if old-return-line  = no
     9529               and buf_temp-ivs-ibs-line.return-line = yes then do:
     9530                   create return_chk-gds.
     9531                   buffer-copy buf_chk-gds to return_chk-gds
     9532                       assign
     9533                       return_chk-gds.src-sum   = - buf_chk-gds.src-sum
     9534                       return_chk-gds.src-qnty  = - buf_chk-gds.src-qnty
     9535                       return_chk-gds.src-discnt = - buf_chk-gds.src-discnt
     9536                       return_chk-gds.doc-qnty = - buf_chk-gds.doc-qnty
     9537                       return_chk-gds.line-sign = (not buf_chk-gds.line-sign)
     9538                       return_chk-gds.line-num = - buf_chk-gds.line-num
     9539                       .
     9540                   return.
     9541               end.
     9542           end.
     9543       end.
     9544   end procedure.
     9545   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9546   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9547   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9548   procedure proc-ach-data :
     9549       define variable num_ as integer no-undo .
     9550       define variable loc-shop-code as integer no-undo .
     9551       define variable trans-num_ as integer no-undo .
     9552       define buffer buf_temp-temp for temp-temp.
     9553       define buffer buf_achd for achd.
     9554       do
     9555           on error undo, return error
     9556               :
     9557           assign
     9558               chk-date_ = ?
     9559               chk-time_ = 0
     9560               pay-desk_ = 0
     9561               bc-buf = ""
     9562               pump_ = 0
     9563               nozzle_ = 0
     9564               curr-string-qnty = 0
     9565               .
     9566           for each buf_temp-temp where
     9567               buf_temp-temp.record-name = "ACHData":U
     9568                   AND buf_temp-temp.id = v-id:
     9569               CASE buf_temp-temp.field-name:
     9570                   when "ACHDNum":U then do:
     9571                       assign
     9572                           num_ =  integer( buf_temp-temp.field-value)
     9573                           no-error .
     9574                   end.
     9575                   when "ACHDDate":U then do:
     9576                       assign
     9577                           chk-date_ =  cb-xmlparse-get-date( buf_temp-temp.field-value)
     9578                           chk-time_ =  cb-xmlparse-get-time( buf_temp-temp.field-value)
     9579                           no-error .
     9580                   end.
     9581                   when "ACHDShop" then do:
     9582                       assign
     9583                           loc-shop-code = integer(buf_temp-temp.field-value)
     9584                           no-error.
     9585                   end.
     9586                   when "ACHDCashNum" then do:
     9587                       assign
     9588                           pay-desk_ = integer(buf_temp-temp.field-value)
     9589                           no-error .
     9590                   end.
     9591                   when "ACHDCode" then do:
     9592                       assign
     9593                           bc-buf = buf_temp-temp.field-value
     9594                           no-error .
     9595                   end.
     9596                   when "ACHDTRNum" then do:
     9597                       assign
     9598                           trans-num_ = integer(buf_temp-temp.field-value)
     9599                           no-error .
     9600                   end.
     9601                   when "ACHDTRK" then do:
     9602                       assign
     9603                           pump_ = integer(buf_temp-temp.field-value)
     9604                           no-error .
     9605                   end.
     9606                   when "ACHDNozzle" then do:
     9607                       assign
     9608                           nozzle_ = integer(buf_temp-temp.field-value)
     9609                           no-error .
     9610                   end.
     9611                   when "ACHDVol" then do:
     9612                       assign
     9613                           curr-string-qnty = decimal(buf_temp-temp.field-value)
     9614                           no-error .
     9615                   end.
     9616                   otherwise do:
     9617                       error-status:error = no.
     9618                   end.
     9619               END CASE.
     9620               if error-status:error then do:
     9621                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     9622               end.
     9623               delete buf_temp-temp.
     9624           end.
     9625           find first buf_achd where
     9626               buf_achd.num = num_ no-error.
     9627           if not available buf_achd then do:
     9628               create buf_achd.
     9629               assign
     9630                   buf_achd.num = num_.
     9631           end.
     9632           assign
     9633               buf_achd.chk-date = chk-date_
     9634               buf_achd.chk-time = chk-time_
     9635               buf_achd.obj-type = 'маг':U
     9636               buf_achd.obj-code = loc-shop-code
     9637               buf_achd.pay-desk = pay-desk_
     9638               buf_achd.src-code = bc-buf
     9639               buf_achd.pump = pump_
     9640               buf_achd.nozzle-code = nozzle_
     9641               buf_achd.src-qnty = curr-string-qnty
     9642               buf_achd.trans-num = trans-num_
     9643               .
     9644       end.
     9645   end procedure.
     9646   procedure proc-ach-exp :
     9647       define variable bc-buf_e as character no-undo .
     9648       define variable total-exp as decimal no-undo .
     9649       define variable month-exp as decimal no-undo .
     9650       define variable day-exp as decimal no-undo .
     9651       define variable chk-date_el as date no-undo .
     9652       define variable chk-time_el as integer no-undo .
     9653       define buffer buf_temp-temp for temp-temp.
     9654       define buffer buf_ache for ache.
     9655       do
     9656           on error undo, return error
     9657               :
     9658           for each buf_temp-temp where
     9659               buf_temp-temp.record-name = "ACHExp":U
     9660                   AND buf_temp-temp.id = v-id:
     9661               CASE buf_temp-temp.field-name:
     9662                   when "ACHECode" then do:
     9663                       assign
     9664                           bc-buf_e = buf_temp-temp.field-value
     9665                           no-error
     9666                           .
     9667                   end.
     9668                   when "ACHEExp" then do:
     9669                       assign
     9670                           total-exp = decimal(buf_temp-temp.field-value)
     9671                           no-error
     9672                           .
     9673                   end.
     9674                   when "ACHEMonthExp" then do:
     9675                       assign
     9676                           month-exp = decimal(buf_temp-temp.field-value)
     9677                           no-error
     9678                           .
     9679                   end.
     9680                   when "ACHEDayExp" then do:
     9681                       assign
     9682                           day-exp = decimal(buf_temp-temp.field-value)
     9683                           no-error
     9684                           .
     9685                   end.
     9686                   when "ACHELastDate" then do:
     9687                       assign
     9688                           chk-date_el =  cb-xmlparse-get-date( buf_temp-temp.field-value)
     9689                           chk-time_el =  cb-xmlparse-get-time( buf_temp-temp.field-value)
     9690                           no-error .
     9691                   end.
     9692                   otherwise do:
     9693                       error-status:error = no.
     9694                   end.
     9695               END CASE.
     9696               if error-status:error then do:
     9697                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     9698               end.
     9699               delete buf_temp-temp.
     9700           end.
     9701           find first buf_ache where
     9702               buf_ache.src-code = bc-buf_e no-error.
     9703           if not available buf_ache then do:
     9704               create buf_ache.
     9705               assign
     9706                   buf_ache.src-code = bc-buf_e
     9707                   .
     9708           end.
     9709           assign
     9710               buf_ache.chk-date = chk-date_el
     9711               buf_ache.chk-time = chk-time_el
     9712               buf_ache.total-exp = total-exp
     9713               buf_ache.month-exp = month-exp
     9714               buf_ache.day-exp = day-exp
     9715               .
     9716       end.
     9717   end procedure.
     9718   procedure proc-ach :
     9719       define input parameter loc-exist as logical no-undo .
     9720       define variable status-int as integer no-undo .
     9721       define variable error-code-int as integer no-undo .
     9722       define variable error-code-char as character no-undo .
     9723       define variable curr-string-qnty-2 as decimal no-undo .
     9724       define variable ret-flag-log as logical no-undo .
     9725       define variable trans-num_ as integer no-undo .
     9726       define variable dur-int as integer no-undo .
     9727       define variable bc-buf_e as character no-undo .
     9728       define variable total-exp as decimal no-undo .
     9729       define variable month-exp as decimal no-undo .
     9730       define variable day-exp as decimal no-undo .
     9731       define variable chk-date_el as date no-undo .
     9732       define variable chk-time_el as integer no-undo .
     9733       define variable v-ach-id as character no-undo .
     9734       define buffer buf_temp-temp for temp-temp.
     9735       define buffer buf_cd-trans for tt-cd-trans.
     9736       define buffer buf2_cd-trans for tt-cd-trans.
     9737       define buffer buf3_cd-trans for tt-cd-trans.
     9738       define buffer buf_chk-doc for tt-chk-doc.
     9739       define buffer buf_achd for achd.
     9740       define buffer buf_ache for ache.
     9741       do
     9742           on error undo, return error
     9743               :
     9744           assign
     9745               bc-buf = ""
     9746               price-from-check = 0
     9747               curr-string-qnty = 0
     9748               chk-id_ = ""
     9749               d-card_ = ""
     9750               pump_ = 0
     9751               v-ach-id = ''
     9752               .
     9753           if loc-exist then return.
     9754           find first buf_chk-doc no-error.
     9755           for each buf_temp-temp where
     9756               buf_temp-temp.record-name = "CACHistory":U
     9757                   AND buf_temp-temp.id = v-id:
     9758               CASE buf_temp-temp.field-name:
     9759                   when "CACHDate":U then do:
     9760                       assign
     9761                           chk-date_ =  cb-xmlparse-get-date( buf_temp-temp.field-value)
     9762                           chk-time_ =  cb-xmlparse-get-time( buf_temp-temp.field-value)
     9763                           no-error .
     9764                   end.
     9765                   when "CACHCardNum" then do:
     9766                       assign
     9767                           d-card_ = buf_temp-temp.field-value
     9768                           no-error.
     9769                   end.
     9770                   when "CACHStatus" then do:
     9771                       assign
     9772                           status-int = integer(buf_temp-temp.field-value)
     9773                           no-error .
     9774                   end.
     9775                   when "CACHErrCode" then do:
     9776                       assign
     9777                           error-code-int = integer(buf_temp-temp.field-value)
     9778                           no-error .
     9779                   end.
     9780                   when "CACHErrMess" then do:
     9781                       assign
     9782                           error-code-char = buf_temp-temp.field-value
     9783                           no-error .
     9784                   end.
     9785                   when "CACHTRKNum" then do:
     9786                       assign
     9787                           pump_ = integer(buf_temp-temp.field-value)
     9788                           no-error .
     9789                   end.
     9790                   when "CACHCode" then do:
     9791                       assign
     9792                           bc-buf = buf_temp-temp.field-value
     9793                           no-error .
     9794                   end.
     9795                   when "CACHOrderVol" then do:
     9796                       assign
     9797                           curr-string-qnty = decimal(buf_temp-temp.field-value)
     9798                           no-error .
     9799                   end.
     9800                   when "CACHTakeVol" then do:
     9801                       assign
     9802                           curr-string-qnty-2 = decimal(buf_temp-temp.field-value)
     9803                           no-error .
     9804                   end.
     9805                   when "CACHRet" then do:
     9806                       assign
     9807                           ret-flag-log = logical(buf_temp-temp.field-value)
     9808                           no-error .
     9809                   end.
     9810                   when "CACHTranzNum" then do:
     9811                       assign
     9812                           trans-num_ = integer(buf_temp-temp.field-value)
     9813                           no-error .
     9814                   end.
     9815                   when "CACHTime" then do:
     9816                       assign
     9817                           dur-int = integer(buf_temp-temp.field-value)
     9818                           no-error .
     9819                   end.
     9820                   when "CACHPrice" then do:
     9821                       assign
     9822                           price-from-check = decimal(buf_temp-temp.field-value)
     9823                           no-error .
     9824                   end.
     9825                   when "CACHCheckID" then do:
     9826                       assign
     9827                           chk-id_ = buf_temp-temp.field-value
     9828                           no-error .
     9829                   end.
     9830                   when "CACHistoryID" then do:
     9831                       assign
     9832                           v-ach-id = buf_temp-temp.field-value
     9833                           no-error .
     9834                   end.
     9835                   otherwise do:
     9836                       error-status:error = no.
     9837                   end.
     9838               END CASE.
     9839               if error-status:error then do:
     9840                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     9841               end.
     9842               delete buf_temp-temp.
     9843           end.
     9844           find first buf_cd-trans share-lock where
     9845               buf_cd-trans.trans-id-chr = v-ach-id
     9846               and buf_cd-trans.trans-type  = integer('40':U)
     9847               and buf_cd-trans.obj-type = shop-type
     9848               and buf_cd-trans.obj-code = shop-code
     9849               and buf_cd-trans.chk-date = chk-date_
     9850               and buf_cd-trans.chk-time = chk-time_
     9851               no-error.
     9852           if not available buf_cd-trans then do:
     9853               create buf_cd-trans.
     9854               assign
     9855                   buf_cd-trans.db-num   = g#db-num
     9856                   buf_cd-trans.trans-id = next-value(s-cd-trans, ub)
     9857                   buf_cd-trans.trans-type  = integer('40':U)
     9858                   buf_cd-trans.obj-type = shop-type
     9859                   buf_cd-trans.obj-code = shop-code
     9860                   buf_cd-trans.trans-id-chr = v-ach-id
     9861                   buf_cd-trans.chk-date = chk-date_
     9862                   buf_cd-trans.chk-time = chk-time_
     9863                   .
     9864           end.
     9865           assign
     9866               buf_cd-trans.src-shift-date = buf_chk-doc.src-shift-date
     9867               buf_cd-trans.src-shift-name = buf_chk-doc.src-shift-name
     9868               buf_cd-trans.pay-desk = buf_chk-doc.pay-desk
     9869               buf_cd-trans.chk-id = chk-id_
     9870               buf_cd-trans.charkey_one = d-card_
     9871               buf_cd-trans.charkey_two = bc-buf
     9872               buf_cd-trans.charkey_three = error-code-char
     9873               buf_cd-trans.deckey_one = curr-string-qnty
     9874               buf_cd-trans.deckey_two = curr-string-qnty-2
     9875               buf_cd-trans.deckey_three = price-from-check
     9876               buf_cd-trans.key#_one = status-int
     9877               buf_cd-trans.key#_two = error-code-int
     9878               buf_cd-trans.key#_three = trans-num_
     9879               buf_cd-trans.key#_four = dur-int
     9880               buf_cd-trans.key#_five = pump_
     9881               buf_cd-trans.logkey_one = ret-flag-log
     9882               .
     9883           for each buf_ache:
     9884               find first buf2_cd-trans share-lock where
     9885                   buf2_cd-trans.trans-id-chr = v-ach-id
     9886                   and buf2_cd-trans.trans-type  = integer('41':U)
     9887                   and buf2_cd-trans.obj-type = shop-type
     9888                   and buf2_cd-trans.obj-code = shop-code
     9889                   and buf2_cd-trans.charkey_two = buf_ache.src-code
     9890                   no-error.
     9891               if not available buf2_cd-trans then do:
     9892                   create buf2_cd-trans.
     9893                   assign
     9894                       buf2_cd-trans.db-num   = g#db-num
     9895                       buf2_cd-trans.trans-id = next-value(s-cd-trans, ub)
     9896                       buf2_cd-trans.trans-type  = integer('41':U)
     9897                       buf2_cd-trans.obj-type = shop-type
     9898                       buf2_cd-trans.obj-code = shop-code
     9899                       buf2_cd-trans.trans-id-chr = v-ach-id
     9900                       buf2_cd-trans.charkey_two = buf_ache.src-code
     9901                       .
     9902               end.
     9903               assign
     9904                   buf2_cd-trans.charkey_one = d-card_
     9905                   buf2_cd-trans.deckey_one = buf_ache.total-exp
     9906                   buf2_cd-trans.deckey_two = buf_ache.month-exp
     9907                   buf2_cd-trans.deckey_three = buf_ache.day-exp
     9908                   buf2_cd-trans.chk-date = buf_ache.chk-date
     9909                   buf2_cd-trans.chk-time = buf_ache.chk-time
     9910                   .
     9911           end.
     9912           for each buf_achd:
     9913               find first buf2_cd-trans share-lock where
     9914                   buf2_cd-trans.trans-id-chr = v-ach-id
     9915                   and buf2_cd-trans.trans-type  = integer('42':U)
     9916                   and buf2_cd-trans.obj-type = buf_achd.obj-type
     9917                   and buf2_cd-trans.obj-code = buf_achd.obj-code
     9918                   and buf2_cd-trans.chk-date = buf_achd.chk-date
     9919                   and buf2_cd-trans.chk-time = buf_achd.chk-time
     9920                   and buf2_cd-trans.key#_one = buf_achd.num
     9921                   no-error.
     9922               if not available buf2_cd-trans then do:
     9923                   create buf2_cd-trans.
     9924                   assign
     9925                       buf2_cd-trans.db-num   = g#db-num
     9926                       buf2_cd-trans.trans-id = next-value(s-cd-trans, ub)
     9927                       buf2_cd-trans.trans-type  = integer('42':U)
     9928                       buf2_cd-trans.trans-id-chr = v-ach-id
     9929                       buf2_cd-trans.obj-type = buf_achd.obj-type
     9930                       buf2_cd-trans.obj-code = buf_achd.obj-code
     9931                       buf2_cd-trans.chk-date = buf_achd.chk-date
     9932                       buf2_cd-trans.chk-time = buf_achd.chk-time
     9933                       buf2_cd-trans.key#_one = buf_achd.num
     9934                       buf2_cd-trans.pay-desk = buf_achd.pay-desk
     9935                       buf2_cd-trans.charkey_one = d-card
     9936                       buf2_cd-trans.charkey_two = buf_achd.src-code
     9937                       buf2_cd-trans.key#_five = buf_achd.pump
     9938                       buf2_cd-trans.key#_four = buf_achd.nozzle-code
     9939                       buf2_cd-trans.key#_three = buf_achd.trans-num
     9940                       buf2_cd-trans.deckey_one = buf_achd.src-qnty
     9941                       .
     9942               end.
     9943           end.
     9944       end.
     9945   end procedure.
     9946   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9947   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9948   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9949   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
