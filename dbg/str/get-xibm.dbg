     6375                   create buf_chk-doc-attr.
     6376                   assign
     6377                   buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6378                   buf_chk-doc-attr.attr-code  = "CHFlag1"
     6379                   buf_chk-doc-attr.attr-value = vCHFlag1
     6380                   .
     6381                   end.
     6382                   if buf_chk-doc.chk-type = integer('43':U) or buf_chk-doc.chk-type = integer('44':U)
     6383                   then do :
     6384                   assign
     6385                   buf_chk-doc.tot-doc = brutto-sum_
     6386                   buf_chk-doc.netto   = netto-sum_
     6387                   .
     6388                   end.
     6389                   prev-code = buf_chk-doc.doc-code.
     6390                   if v-chk-type[1] = integer('8':U)
     6391                   then do:
     6392                   assign
     6393                   netto-sum_ = 0
     6394                   .
     6395                   end.
     6396               end.
     6397           end.
     6398       end.
     6399   end procedure .
     6400   procedure proc-Parameter :
     6401       define buffer buf_temp-param for temp-param.
     6402       define buffer buf_chk-doc for tt-chk-doc.
     6403       define buffer buf_shift-obj for ub.shift-obj.
     6404       define variable v-ffd-version as character no-undo .
     6405       define variable v-KKT_SCHEMA as character no-undo .
     6406       do
     6407           on error undo, return error
     6408               :
     6409           for each buf_temp-param where
     6410               buf_temp-param.record-name = "Param":U
     6411                   AND buf_temp-param.desk = m-head-cash-num
     6412                   and buf_temp-param.field-name = "ParamValue":
     6413               run cd-attr-write in this-procedure (        m-head-db-num
     6414                   ,m-head-obj-code
     6415                   ,m-head-pos-type
     6416                   ,m-head-cash-num
     6417                   ,input  (if p-pos-type = 'IBM-XML':U
     6418                   then 'IBM-XML_operative':U
     6419                   else 'AUTOTANK_operative':U)
     6420                   ,input buf_temp-param.key-name
     6421                   ,input buf_temp-param.field-value
     6422                   ,input ?
     6423                   ,input 0
     6424                   ,input 0
     6425                   ,input no
     6426                   ) no-error.
     6427               if error-status:error then do:
     6428                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     6429               end.
     6430           end.
     6431       END.
     6432   end procedure.
     6433   procedure proc-FuelPump :
     6434       define buffer buf_temp-param     for temp-param.
     6435       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     6436       define buffer buf_pl-gds-pump    for ub.pl-gds-pump.
     6437       do
     6438           on error undo, return error
     6439               :
     6440           if v-key = "READ" then
     6441           do:
     6442               for each buf_pl-pump-nozzle where
     6443                   buf_pl-pump-nozzle.obj-type = p-obj-type
     6444                       AND buf_pl-pump-nozzle.obj-code = p-obj-code
     6445                       and buf_pl-pump-nozzle.pump-code = integer(v-group) no-lock,
     6446                       each buf_pl-gds-pump exclusive-lock where buf_pl-gds-pump.obj-code = buf_pl-pump-nozzle.obj-code and
     6447                       buf_pl-gds-pump.obj-type = buf_pl-pump-nozzle.obj-type and
     6448                       buf_pl-gds-pump.pump-code = buf_pl-pump-nozzle.pump-code and
     6449                       buf_pl-gds-pump.pl-code = buf_pl-pump-nozzle.pl-code:
     6450                   find first buf_temp-param where
     6451                       buf_temp-param.record-name = "FuelPump":U
     6452                       AND buf_temp-param.desk = m-head-cash-num
     6453                       and buf_temp-param.key-name = "READ"
     6454                       and buf_temp-param.field-name = "FPFNzl"
     6455                       and buf_temp-param.group-name = v-group
     6456                       and buf_pl-pump-nozzle.nozzle-code = integer(buf_temp-param.field-value) no-error .
     6457               end.
     6458           END.
     6459       end.
     6460   end procedure.
     6461   procedure proc-CAuthorization :
     6462       define buffer buf_temp-temp for temp-temp.
     6463       define buffer buf_chk-doc for tt-chk-doc.
     6464       define buffer buf_shift-obj for ub.shift-obj.
     6465       do
     6466           on error undo, return error
     6467               :
     6468           assign
     6469               AuthType_ = 0
     6470               qr-alchol_ = "":u
     6471               no-error
     6472               .
     6473           _buf_temp:
     6474           for each buf_temp-temp no-lock where
     6475               buf_temp-temp.record-name = "CAuthorization":U
     6476                   AND buf_temp-temp.id = v-id:
     6477               CASE buf_temp-temp.field-name:
     6478                   when "CAuthType":U then do:
     6479                       assign
     6480                           AuthType_ = fdecimal(buf_temp-temp.field-value)
     6481                           no-error .
     6482                   end.
     6483                   when "CAuthUrl":U then do:
     6484                       run xmlchar-decode in this-procedure (
     6485                           input trim(buf_temp-temp.field-value)
     6486                           , output qr-alchol_
     6487                           ) no-error.
     6488                   end.
     6489                   otherwise do:
     6490                       error-status:error = no.
     6491                   end.
     6492               END CASE.
     6493               if error-status:error then do:
     6494                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     6495               end.
     6496           END.
     6497           define variable v-value as character no-undo .
     6498           define variable v-type  as character no-undo .
     6499           find first buf_chk-doc no-error.
     6500           if AuthType_ = 2 then do:
     6501               run chkdocat-write IN THIS-PROCEDURE(
     6502                   input buf_chk-doc.doc-code
     6503                   ,INPUT "qr-alchol-pv"
     6504                   ,INPUT qr-alchol_ ) NO-ERROR.
     6505           end.
     6506           if AuthType_ <> 2 and AuthType_ <> 0 then do:
     6507               run chkdocat-write IN THIS-PROCEDURE(
     6508                   input buf_chk-doc.doc-code
     6509                   ,INPUT "qr-alchol"
     6510                   ,INPUT qr-alchol_ ) NO-ERROR.
     6511           end.
     6512       end.
     6513   end procedure.
     6514   procedure proc-01-gds :
     6515       DEFINE VARIABLE no-add-price as logical no-undo .
     6516       define variable vCSTValue as decimal no-undo.
     6517       define variable vCSTaxValue as decimal no-undo.
     6518       define variable lng-spl as integer no-undo .
     6519       define variable depart-id_ as integer no-undo .
     6520       define variable v-d-pcnt-categ as decimal no-undo .
     6521       define variable v-d-sum-categ as decimal no-undo .
     6522       define variable v-d-pcnt-time as decimal no-undo .
     6523       define variable v-d-sum-time as decimal no-undo .
     6524       define variable v-d-pcnt-qnty as decimal no-undo .
     6525       define variable v-d-sum-qnty as decimal no-undo .
     6526       define variable v-d-pcnt-manual as decimal no-undo .
     6527       define variable v-d-sum-manual as decimal no-undo .
     6528       define variable write-off-reason-code_ as integer no-undo .
     6529       define variable v-is-modificator as logical no-undo .
     6530       define variable D-CARD2_ as character no-undo .
     6531       define variable v-step as integer   no-undo .
     6532       define variable v-line-type as character no-undo .
     6533       define variable v-dt-season as integer no-undo .
     6534       define variable v-VAT-pc like ub.chk-gds.VAT-pc no-undo .
     6535       define variable v-promo as integer no-undo .
     6536       define variable v-promo-sum as decimal no-undo .
     6537       define buffer buf_chk-gds for tt-chk-gds.
     6538       define buffer buf2_chk-gds for tt-chk-gds.
     6539       define buffer buf_chk-gds-attr for tt-chk-gds-attr.
     6540       define buffer buf_bar-code for ub.bar-code .
     6541       define buffer buf_temp-temp for temp-temp.
     6542       define buffer buf_chk-doc for tt-chk-doc.
     6543       define buffer buf_sum-grp for tt-sum-grp.
     6544       do
     6545           on error undo, return error
     6546               :
     6547           assign
     6548               d-card_ = "":U
     6549               d-mask_ = "":U
     6550               cli-type_ = "":U
     6551               cli-code_ = 0
     6552               b-c = 0
     6553               nozzle_ = 0
     6554               place_ = 0
     6555               pump_ = 0
     6556               .
     6557           if not exist
     6558           or (v-to-delete[1] = yes
     6559           and
     6560           v-to-delete[2] = no)
     6561           then  do:
     6562               for each buf_temp-temp where
     6563                   buf_temp-temp.record-name = "CSale":U
     6564                       AND buf_temp-temp.id = v-id:
     6565                   CASE buf_temp-temp.field-name:
     6566                       when "CSType":U then do:
     6567                           assign
     6568                               cstype_ = integer(buf_temp-temp.field-value)
     6569                               no-error .
     6570                       end.
     6571                       when "CSCode":U then do:
     6572                           assign
     6573                               bc-buf = buf_temp-temp.field-value
     6574                               no-error
     6575                               .
     6576                       end.
     6577                       when "CSLocal":U then do:
     6578                           integer(buf_temp-temp.field-value) no-error .
     6579                           if error-status:error = no then
     6580                           do:
     6581                               assign
     6582                                   b-c = integer(buf_temp-temp.field-value)
     6583                                   .
     6584                           end.
     6585                       end.
     6586                       when "CSPriceOrig":u then do:
     6587                           assign
     6588                               price-old = dec(buf_temp-temp.field-value)
     6589                               no-error
     6590                               .
     6591                       end.
     6592                       when "CSPrice":u then do:
     6593                           assign
     6594                               price-from-check = dec(buf_temp-temp.field-value)
     6595                               no-error
     6596                               .
     6597                       end.
     6598                       when "CSQty":u then do:
     6599                           assign
     6600                               curr-string-qnty = dec(buf_temp-temp.field-value)
     6601                               no-error
     6602                               .
     6603                       end.
     6604                       when "CSTrk":u then do:
     6605                           assign
     6606                               pump_ = int(buf_temp-temp.field-value)
     6607                               no-error
     6608                               .
     6609                       end.
     6610                       when "CSSaleman":U or
     6611                       when "CSGarcon":U then do:
     6612                           assign
     6613                               sales-man_ = int(buf_temp-temp.field-value)
     6614                               no-error .
     6615                       end.
     6616                       when "CSCCard":U then do:
     6617                           assign
     6618                               d-card2_ = buf_temp-temp.field-value
     6619                               no-error .
     6620                       end.
     6621                       when "CSCNum":U then do:
     6622                           assign
     6623                               d-card_ = buf_temp-temp.field-value
     6624                               no-error .
     6625                       end.
     6626                       when "CSCMask":U then do:
     6627                           assign
     6628                               d-mask_ = buf_temp-temp.field-value
     6629                               no-error .
     6630                       end.
     6631                       when "CSCCode":U then do:
     6632                           assign
     6633                               cli-code_ = integer(buf_temp-temp.field-value)
     6634                               cli-type_ = if cli-code_ > 9999999999 then 'орг':U else 'чел':U
     6635                               no-error .
     6636                       end.
     6637                       when "CSString":U then do:
     6638                           assign
     6639                               lng-spl = integer(buf_temp-temp.field-value)
     6640                               no-error .
     6641                       end.
     6642                       when "CSTotal":u then do:
     6643                           assign
     6644                               sum-from-check = fdecimal(buf_temp-temp.field-value)
     6645                               no-error .
     6646                       end.
     6647                       when "CSTValue":U then do:
     6648                           assign
     6649                               cstValue = fdecimal(buf_temp-temp.field-value)
     6650                               vCSTValue = fdecimal (buf_temp-temp.field-value)
     6651                               no-error .
     6652                       end.
     6653                       when "CSTCode":U then do:
     6654                           run xmlchar-decode in this-procedure (
     6655                               input trim(buf_temp-temp.field-value)
     6656                               , output cstCode
     6657                               ) no-error.
     6658                       end.
     6659                       when "CSSNoTotal":U then do:
     6660                           if p-pos-type <> 'MAGIA-XML':U then
     6661                               assign
     6662                               no-add-price = if integer(buf_temp-temp.field-value) = 1
     6663                               then yes
     6664                                   else no
     6665                                   no-error .
     6666                               else do:
     6667                                   assign
     6668                                       error-status:error = no.
     6669                               end.
     6670                       end.
     6671                       when "CSTValue":U then do:
     6672                           assign
     6673                               vCSTValue = decimal (buf_temp-temp.field-value)
     6674                               no-error .
     6675                       end.
     6676                       when "CSTTaxValue":U then do:
     6677                           assign
     6678                               vCSTaxValue = decimal (buf_temp-temp.field-value)
     6679                               no-error .
     6680                       end.
     6681                       when "CSSHandCode":u then do:
     6682                           assign
     6683                               pass-gds_ =   (if integer(buf_temp-temp.field-value) = 1
     6684                               then 1
     6685                               else 0)
     6686                               no-error .
     6687                       end.
     6688                       when "CSGcode":U then do:
     6689                           if p-pos-type = 'MAGIA-XML':U then do:
     6690                               assign
     6691                                   depart-id_ = integer(buf_temp-temp.field-value)
     6692                                   no-error .
     6693                           end.
     6694                           else do:
     6695                               if buf_temp-temp.field-value <> string(0) then do:
     6696                                   If cstype_ = 37 then v-oss-code =  buf_temp-temp.field-value.
     6697                                   else do:
     6698                                       for each buf_sum-grp where string (buf_sum-grp.grp-code) = buf_temp-temp.field-value:
     6699                                           find first ub.goods-attr where ub.goods-attr.gds-code = buf_sum-grp.code-2
     6700                                               and ub.goods-attr.attr-code = 'office-type':U and ub.goods-attr.attr-value = 'oss-pay':U no-error.
     6701                                           if available ub.goods-attr
     6702                                           then assign v-oss-code = bc-buf.
     6703                                       end.
     6704                                       assign
     6705                                           bc-buf = buf_temp-temp.field-value
     6706                                           v-line-type = 'grp'
     6707                                           no-error
     6708                                           .
     6709                                   end.
     6710                               end.
     6711                               else do:
     6712                                   assign
     6713                                       error-status:error = no.
     6714                               end.
     6715                           end.
     6716                       end.
     6717                       when "CSDiscnt1Pcnt":U then do:
     6718                           assign
     6719                               v-d-pcnt-categ = fdecimal(buf_temp-temp.field-value)
     6720                               no-error .
     6721                       end.
     6722                       when "CSDiscnt1Sum":U then do:
     6723                           assign
     6724                               v-d-sum-categ = fdecimal(buf_temp-temp.field-value)
     6725                               no-error .
     6726                       end.
     6727                       when "CSDiscnt2Pcnt":U then do:
     6728                           assign
     6729                               v-d-pcnt-time = fdecimal(buf_temp-temp.field-value)
     6730                               no-error .
     6731                       end.
     6732                       when "CSDiscnt2Sum":U then do:
     6733                           assign
     6734                               v-d-sum-time = fdecimal(buf_temp-temp.field-value)
     6735                               no-error .
     6736                       end.
     6737                       when "CSDiscnt3Pcnt":U then do:
     6738                           assign
     6739                               v-d-pcnt-qnty = fdecimal(buf_temp-temp.field-value)
     6740                               no-error .
     6741                       end.
     6742                       when "CSDiscnt3Sum":U then do:
     6743                           assign
     6744                               v-d-sum-qnty = fdecimal(buf_temp-temp.field-value)
     6745                               no-error .
     6746                       end.
     6747                       when "CSDiscnt4Pcnt":U then do:
     6748                           assign
     6749                               v-d-pcnt-manual = fdecimal(buf_temp-temp.field-value)
     6750                               no-error .
     6751                       end.
     6752                       when "CSDiscnt4Sum":U then do:
     6753                           assign
     6754                               v-d-sum-manual = fdecimal(buf_temp-temp.field-value)
     6755                               no-error .
     6756                       end.
     6757                       when "CSSModificator":U then do:
     6758                           assign
     6759                               v-is-modificator = if integer(buf_temp-temp.field-value) = 1
     6760                               then yes
     6761                               else no
     6762                               no-error .
     6763                       end.
     6764                       when "CSSModificatorNullPrice":U then do:
     6765                           assign
     6766                               no-add-price = if integer(buf_temp-temp.field-value) = 1
     6767                               then yes
     6768                               else no
     6769                               no-error .
     6770                       end.
     6771                       when "CSSCancelCode":U then do:
     6772                           assign
     6773                               write-off-reason-code_ = integer(buf_temp-temp.field-value)
     6774                               no-error
     6775                               .
     6776                       end.
     6777                       when "CSNozzle":U then do:
     6778                           assign
     6779                               nozzle_ = integer(buf_temp-temp.field-value)
     6780                               no-error .
     6781                       end.
     6782                       when "CSTank":U then do:
     6783                           assign
     6784                               place_ = integer(buf_temp-temp.field-value)
     6785                               no-error .
     6786                       end.
     6787                       when "CSTankCode":U then do:
     6788                           assign
     6789                               pl-code_ = integer(buf_temp-temp.field-value)
     6790                               no-error .
     6791                       end.
     6792                       when "CHBrutto":U then do:
     6793                           assign
     6794                               v-src-tot-doc = decimal(buf_temp-temp.field-value)
     6795                               no-error .
     6796                       end.
     6797                       when "CSPromo":U then do:
     6798                           assign
     6799                               v-promo = decimal(buf_temp-temp.field-value)
     6800                               no-error .
     6801                       end.
     6802                       otherwise do:
     6803                           error-status:error = no.
     6804                       end.
     6805                   END CASE.
     6806                   if error-status:error then do:
     6807                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     6808                   end.
     6809                   if (p-pos-type = 'IBM-XML':U
     6810                   or p-pos-type = 'Autotank':U)
     6811                   and  LOOKUP(string(cstype_), "6,7,8":U) > 0
     6812                   and not get-chkc_context.ibmgroup
     6813                   then return.
     6814                   delete buf_temp-temp.
     6815               end.
     6816               if error-status:error then do:
     6817                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     6818               end.
     6819               if v-promo = 1 then do:
     6820                   sum-from-check = Round(price-from-check * curr-string-qnty,2).
     6821               end.
     6822               if cstype_ = 18 then do:
     6823               FIND FIRST buf_chk-doc.
     6824                   assign
     6825                       d-card_ = (if d-card_ = ""
     6826                       and d-mask_ <> ""
     6827                       then d-mask_
     6828                       else d-card_)
     6829                       buf_chk-doc.src-d-card       = (if d-card_ = "":U
     6830                       or buf_chk-doc.src-d-card = d-card_
     6831                       then buf_chk-doc.src-d-card
     6832                       else (if not v-flag-card
     6833                       and (buf_chk-doc.src-d-card = ? or tt-chk-doc.src-d-card = "":U)
     6834                       then d-card_
     6835                       else d-card_
     6836                       )
     6837                       )
     6838                       buf_chk-doc.src-cli-type   = (if cli-type_ = "":U
     6839                       or buf_chk-doc.src-cli-type = cli-type_
     6840                       then buf_chk-doc.src-cli-type
     6841                       else (if not v-flag-card
     6842                       and (buf_chk-doc.src-cli-type = ? or buf_chk-doc.src-cli-type = "":U)
     6843                       then cli-type_
     6844                       else ?)
     6845                       )
     6846                       buf_chk-doc.src-cli-code   = (if cli-code_ = 0
     6847                       or buf_chk-doc.src-cli-code = cli-code_
     6848                       then buf_chk-doc.src-cli-code
     6849                       else (if not v-flag-card
     6850                       and (buf_chk-doc.src-cli-code = ? or buf_chk-doc.src-cli-code = 0)
     6851                       then cli-code_
     6852                       else ?)
     6853                       )
     6854                       buf_chk-doc.d-card = if d-CARD2_ <> "":U then d-CARD2_ else buf_chk-doc.d-card
     6855                       v-flag-card         = (if not v-flag-card  and d-card_ <> "":U
     6856                       then yes
     6857                       else v-flag-card)
     6858                       .
     6859                   return.
     6860               end.
     6861               assign
     6862                   time-oper_ =  (if p-pos-type = 'MAGIA-XML':U
     6863                   then (v-time modulo 86400)
     6864                   else string-IS0-8601-to-sec(v-time-char))
     6865                   no-error
     6866                   .
     6867               if p-pos-type = 'MAGIA-XML':U
     6868               then do:
     6869                   if gbl-type = "8"
     6870                   and cstype_ = 6
     6871                   and lookup(string(write-off-reason-code_), ret-chk) > 0 then do:
     6872                       run recalc-write-off in this-procedure(buffer tt-chk-doc, input gbl-type, input "6").
     6873                       if v-to-delete[1] = yes
     6874                       and v-to-delete[2] = yes then do:
     6875                           assign
     6876                               v-to-delete[1] = no
     6877                               v-to-delete[2] = no
     6878                               .
     6879                           return.
     6880                       end.
     6881                   end.
     6882                   do v-step = 1 to (if v-create-return-write-off then 2 else 1):
     6883                       if v-is-modificator = ? then
     6884                           v-is-modificator = no.
     6885                       if v-is-modificator
     6886                       and not no-add-price then v-is-modificator = no.
     6887                       find first temp-ivs-ibs where
     6888                           temp-ivs-ibs.chtype = gbl-type
     6889                           AND temp-ivs-ibs.cstype = string(cstype_)
     6890                           and temp-ivs-ibs.cancelcode = string(write-off-reason-code_)
     6891                           and temp-ivs-ibs.positive-num-chk = (chk-num_ > 0)
     6892                           and temp-ivs-ibs.positive-netto-sum = (netto-sum_ >= 0)
     6893                           and temp-ivs-ibs.modificator = v-is-modificator
     6894                           and (v-is-modificator = no or temp-ivs-ibs.modificator-np = no-add-price)
     6895                           and temp-ivs-ibs.step_ = v-step no-error .
     6896                       if not available temp-ivs-ibs then do:
     6897                           assign
     6898                               exist = yes.
     6899                           run write-log-and-file in p-log-handle (
     6900                               input 1
     6901                               , input log-file-name
     6902                               , input 1
     6903                               , input substitute( "!!!Неизвестный тип строки чека:&1" +
     6904                               "код типа чека &2 код типа строки чека &3 код списания &4&1" +
     6905                               "&7&1" +
     6906                               "номер чека на кассе &5 касса &6"
     6907                               , chr(10)
     6908                               , gbl-type
     6909                               , cstype_
     6910                               , write-off-reason-code_
     6911                               , chk-num_
     6912                               , pay-desk_
     6913                               , (if v-is-modificator
     6914                               then ('модификатор' + chr(32) + (if no-add-price
     6915                               then 'без цены'
     6916                               else '':U))
     6917                               else '')
     6918                               )
     6919                               ).
     6920                           assign
     6921                               p-view-log = yes
     6922                               .
     6923                           return.
     6924                       end.
     6925                       if available temp-ivs-ibs then do:
     6926                           if v-step = 1 then
     6927                               create
     6928                                   temp-ivs-ibs-line
     6929                                   .
     6930                           if v-step  = 1 then do:
     6931                               assign
     6932                                   temp-ivs-ibs-line.chtype = temp-ivs-ibs.chtype
     6933                                   temp-ivs-ibs-line.cstype = temp-ivs-ibs.cstype
     6934                                   temp-ivs-ibs-line.cancelcode = temp-ivs-ibs.cancelcode
     6935                                   temp-ivs-ibs-line.modificator = temp-ivs-ibs.modificator
     6936                                   temp-ivs-ibs-line.modificator-np = temp-ivs-ibs.modificator-np
     6937                                   temp-ivs-ibs-line.create-return-write-off =  temp-ivs-ibs.create-return-write-off
     6938                                   temp-ivs-ibs-line.return-line = temp-ivs-ibs.return-line
     6939                                   temp-ivs-ibs-line.line-num = (if lng-spl = 0 then - lng else lng-spl)
     6940                                   temp-ivs-ibs-line.rcpt-type-1                        = temp-ivs-ibs.rcpt-type-1
     6941                                   temp-ivs-ibs-line.wro-code[v-step]                   = temp-ivs-ibs.wro-code
     6942                                   temp-ivs-ibs-line.qnty-sign[v-step]                  = temp-ivs-ibs.qnty-sign
     6943                                   temp-ivs-ibs-line.step_[v-step]                      = temp-ivs-ibs.step_
     6944                                   .
     6945                           end.
     6946                           if v-step = 2
     6947                           and available temp-ivs-ibs-line
     6948                           and available temp-ivs-ibs then do:
     6949                               assign
     6950                                   temp-ivs-ibs-line.rcpt-type-2                        = temp-ivs-ibs.rcpt-type-2
     6951                                   temp-ivs-ibs-line.wro-code[v-step]                   = temp-ivs-ibs.wro-code
     6952                                   temp-ivs-ibs-line.qnty-sign[v-step]                  = temp-ivs-ibs.qnty-sign
     6953                                   temp-ivs-ibs-line.step_[v-step]                      = temp-ivs-ibs.step_
     6954                                   .
     6955                           end.
     6956                       end.
     6957                   end.
     6958               end.
     6959               if v-to-delete[1] = yes then return.
     6960               if (p-pos-type = 'IBM-XML':U
     6961               or p-pos-type = 'Autotank':U)
     6962               and v-line-type = 'grp':U
     6963               and get-chkc_context.ibmgroup
     6964               and can-find(first buf_sum-grp)
     6965               and gbl-type <> "43" and gbl-type <> "44"
     6966               then do:
     6967                   find first buf_sum-grp no-lock where
     6968                       buf_sum-grp.grp-code = integer(bc-buf)
     6969                       no-error .
     6970                   if not available buf_sum-grp then do:
     6971                       assign
     6972                           bc-buf = chr(4) + bc-buf.
     6973                   end.
     6974                   else do:
     6975                       assign
     6976                           bc-buf = string(buf_sum-grp.code-2) + chr(4) + bc-buf.
     6977                   end.
     6978                   v-line-type = '':U.
     6979                   assign
     6980                       curr-string-qnty = sum-from-check
     6981                       price-from-check = 1
     6982                       .
     6983               end.
     6984               if p-pos-type = 'Autotank':U and lng-spl = 2 then
     6985               do:
     6986                   if sum-from-check > 0 then
     6987                   do:
     6988                       assign
     6989                           autotank-sum-return = - sum-from-check
     6990                           netto-sum_ = netto-sum_ + autotank-sum-return
     6991                           .
     6992                   end.
     6993                   return .
     6994               end.
     6995               If cstype_ = 37 and (p-pos-type = 'IBM-XML':U OR p-pos-type = 'Autotank':U) then for first ub.goods-attr no-lock where ub.goods-attr.gds-code = int(bc-buf)
     6996                   and ub.goods-attr.attr-code = 'office-type':U and ub.goods-attr.attr-value = 'oss-pay':U:
     6997                   assign
     6998                       curr-string-qnty = sum-from-check
     6999                       price-from-check = 1.
     7000               end.
     7001               run gds-attr_check-code-dt-seasons in this-procedure
     7002                   (b-c, shop-type, shop-code, output b-c,output v-dt-season).
     7003               FIND FIRST buf_chk-doc NO-ERROR.
     7004               CREATE buf_chk-gds.
     7005               assign
     7006                   buf_chk-gds.doc-code = buf_chk-doc.doc-code
     7007                   lng = lng + 1
     7008                   buf_chk-gds.line-num = (if lng-spl = 0 then - lng else lng-spl)
     7009                   buf_chk-gds.grp-code = 0
     7010                   buf_chk-gds.chk-date = buf_chk-doc.chk-date
     7011                   buf_chk-gds.b-code = b-c
     7012                   buf_chk-gds.src-code = bc-buf
     7013                   buf_chk-gds.src-price = price-from-check
     7014                   buf_chk-gds.src-sum   = sum-from-check
     7015                   buf_chk-gds.src-qnty = curr-string-qnty
     7016                   buf_chk-gds.src-discnt = 0
     7017                   buf_chk-gds.doc-qnty = 0
     7018                   buf_chk-gds.price-service = 0
     7019                   buf_chk-gds.time-oper = time-oper_
     7020                   buf_chk-gds.pass-gds = pass-gds_
     7021                   buf_chk-gds.is-error = NO
     7022                   buf_chk-gds.doc-qnty = 0
     7023                   buf_chk-gds.pump = (if pump_ > 0 then pump_ else 0)
     7024                   buf_chk-gds.nozzle = (if nozzle_ > 0 then nozzle_ else 0)
     7025                   buf_chk-gds.loc1 = (if place_ > 0 then string(place_) else '':U)
     7026                   buf_chk-gds.src-pl-code = (if pl-code_ > 0 then pl-code_ else 0)
     7027                   buf_chk-gds.road-tax = road-tax_
     7028                   buf_chk-gds.line-sign = (if buf_chk-doc.chk-type = integer('1':U)
     7029                   then (buf_chk-gds.src-qnty >= 0)
     7030                   else (buf_chk-gds.src-qnty <= 0)
     7031                   )
     7032                   buf_chk-gds.line-type = v-line-type
     7033                   buf_chk-gds.src-d-card = (if d-card_ <> "":U then d-card_ else ?)
     7034                   buf_chk-gds.src-d-mask = (if d-mask_ <> "":U then d-mask_ else ?)
     7035                   buf_chk-gds.src-cli-type = (if cli-type_ = "":u then ? else cli-type_)
     7036                   buf_chk-gds.src-cli-code = (if cli-code_ = 0 then ? else cli-code_)
     7037                   buf_chk-gds.d-card = if d-CARD2_ <> "":U then d-CARD2_ else buf_chk-gds.d-card
     7038                   buf_chk-doc.src-d-card       = (if d-card_ = "":U
     7039                   or buf_chk-doc.src-d-card = d-card_
     7040                   then buf_chk-doc.src-d-card
     7041                   else (if not v-flag-card
     7042                   and (buf_chk-doc.src-d-card = ? or buf_chk-doc.src-d-card = "":U)
     7043                   then d-card_
     7044                   else d-card_
     7045                   )
     7046                   )
     7047                   buf_chk-doc.src-d-mask       = (if d-mask_ = "":U
     7048                   or buf_chk-doc.src-d-mask = d-mask_
     7049                   then buf_chk-doc.src-d-mask
     7050                   else (if not v-flag-card
     7051                   and (buf_chk-doc.src-d-mask = ? or buf_chk-doc.src-d-mask = "":U)
     7052                   then d-mask_
     7053                   else "-0":U
     7054                   )
     7055                   )
     7056                   buf_chk-doc.src-cli-type   = (if cli-type_ = "":U
     7057                   or buf_chk-doc.src-cli-type = cli-type_
     7058                   then buf_chk-doc.src-cli-type
     7059                   else (if not v-flag-card
     7060                   and (buf_chk-doc.src-cli-type = ? or buf_chk-doc.src-cli-type = "":U)
     7061                   then cli-type_
     7062                   else ?)
     7063                   )
     7064                   buf_chk-doc.src-cli-code   = (if cli-code_ = 0
     7065                   or buf_chk-doc.src-cli-code = cli-code_
     7066                   then buf_chk-doc.src-cli-code
     7067                   else (if not v-flag-card
     7068                   and (buf_chk-doc.src-cli-code = ? or buf_chk-doc.src-cli-code = 0)
     7069                   then cli-code_
     7070                   else ?)
     7071                   ) .
     7072                   buf_chk-doc.d-card = if d-CARD2_ <> "":U then d-CARD2_ else buf_chk-doc.d-card .
     7073                   v-flag-card         = (if not v-flag-card  and d-card_ <> "":U
     7074                   then yes
     7075                   else v-flag-card) .
     7076                   buf_chk-gds.depart-id = depart-id_ .
     7077                   buf_chk-gds.sales-man  = sales-man_ .
     7078                   buf_chk-doc.sales-man = (if not v-flag-salesman
     7079                   and
     7080                   (
     7081                   buf_chk-doc.sales-man = 0
     7082                   or buf_chk-doc.sales-man = sales-man_
     7083                   or sales-man_ = 0
     7084                   )
     7085                   then sales-man_
     7086                   else 0) .
     7087                   buf_chk-doc.sales-man = (if buf_chk-doc.sales-man = ? then 0 else buf_chk-doc.sales-man) .
     7088                   v-flag-salesman   = (if not v-flag-salesman
     7089                   and (sales-man_ <> 0 and sales-man_ <> buf_chk-doc.sales-man)
     7090                   then yes
     7091                   else v-flag-salesman) .
     7092                   buf_chk-doc.src-tot-doc = v-src-tot-doc .
     7093                   buf_chk-gds.VAT-pc = vCSTaxValue  .
     7094                   buf_chk-gds.VAT-sum-rubl = vCSTValue .
     7095               if p-pos-type = 'Autotank':U
     7096               and buf_chk-gds.VAT-pc = 0
     7097               and buf_chk-gds.VAT-sum-rubl = 0
     7098               then do:
     7099                   for first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code :
     7100   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7102     (input  buf_bar-code.gds-code
     7103     ,input  '1':U
     7104     ,input  ?
     7105     ,input  p-host-code
     7106     ,input  p-obj-type
     7107     ,input  p-obj-code
     7108     ,output v-VAT-pc
     7109     ) no-error .
     7110                       buf_chk-gds.VAT-pc = v-VAT-pc .
     7111                       buf_chk-gds.VAT-sum-rubl = (( buf_chk-gds.src-price *  buf_chk-gds.VAT-pc)/(100 +  buf_chk-gds.VAT-pc)) *  buf_chk-gds.src-qnty .
     7112                   end .
     7113               end .
     7114               // run proc-01-tax in this-procedure (output ub.chk-gds.VAT-pc, output ub.chk-gds.VAT-sum-rubl).
     7115               if v-oss-code <> "" then do:
     7116                   case p-pos-type:
     7117                       when 'Autotank':U then do:
     7118                           find first buf_ext-classif where buf_ext-classif.CharKey_One = v-oss-code no-error.
     7119                           if available buf_ext-classif then do:
     7120                               assign
     7121                                   v-oss-code = string (buf_ext-classif.Key#_One)
     7122                                   .
     7123                           end.
     7124                       end.
     7125                   end case.
     7126                   create buf_chk-gds-attr.
     7127                   assign
     7128                       buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7129                       buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7130                       buf_chk-gds-attr.attr-code = "oss-code"
     7131                       buf_chk-gds-attr.attr-value =  v-oss-code
     7132                       .
     7133                   v-oss-code = "".
     7134               end.
     7135               if v-dt-season <> 0 then do:
     7136                   create buf_chk-gds-attr.
     7137                   assign
     7138                       buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7139                       buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7140                       buf_chk-gds-attr.attr-code = "SeasonDT"
     7141                       buf_chk-gds-attr.attr-value =  string(v-dt-season)
     7142                       .
     7143               end.
     7144               create buf_chk-gds-attr.
     7145               assign
     7146                   buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7147                   buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7148                   buf_chk-gds-attr.attr-code = "cstype"
     7149                   buf_chk-gds-attr.attr-value =  string(cstype_)
     7150                   .
     7151               if price-old <> 0 then do:
     7152                   create buf_chk-gds-attr.
     7153                   assign
     7154                       buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7155                       buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7156                       buf_chk-gds-attr.attr-code = "CSPriceOrig"
     7157                       buf_chk-gds-attr.attr-value =  string(price-old)
     7158                       .
     7159               end.
     7160               if p-pos-type = 'IBM-XML':U
     7161               or p-pos-type = 'Autotank':U
     7162               then do:
     7163                   if buf_chk-doc.chk-type = integer('43':U) or buf_chk-doc.chk-type = integer('44':U)
     7164                   then do :
     7165                       buf_chk-gds.road-tax = cstValue .
     7166                       buf_chk-gds.depart-type = cstCode .
     7167                   end.
     7168                   if buf_chk-doc.chk-type = integer('17':U) then do:
     7169                       assign
     7170                           buf_chk-gds.write-off-code =  integer('17':U)
     7171                           netto-for-sub-d = netto-for-sub-d + (if v-is-petrol-check then 0
     7172                           else (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     7173                           .
     7174                   end.
     7175                   else  do:
     7176                       assign
     7177                           buf_chk-gds.write-off-code = (if no-add-price
     7178                           then (if lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0
     7179                           then integer('1':U)
     7180                           else integer('-6':U)
     7181                           )
     7182                           else 0
     7183                           )
     7184                           netto-for-sub-d = netto-for-sub-d + (if (buf_chk-gds.write-off-code = ?
     7185                           or buf_chk-gds.write-off-code <= 0)
     7186                           and not v-is-petrol-check
     7187                           then
     7188                           ((buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     7189                           else 0)
     7190                           accum-src-for-sub-d = accum-src-for-sub-d + buf_chk-gds.src-qnty
     7191                           .
     7192                   end.
     7193                   buf_chk-doc.doc-num2 = doc-num2_.
     7194               end.
     7195               else do:
     7196                   assign
     7197                       buf_chk-gds.write-off-code = integer(temp-ivs-ibs-line.wro-code[1])
     7198                       netto-for-sub-d = netto-for-sub-d + if temp-ivs-ibs-line.return-line
     7199                       then 0
     7200                       else (
     7201                       (if buf_chk-gds.write-off-code = ?
     7202                       or buf_chk-gds.write-off-code <= 0
     7203                       then
     7204                       ((buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty)
     7205                       else 0)
     7206                       )
     7207                       accum-src-for-sub-d = accum-src-for-sub-d + (if temp-ivs-ibs-line.return-line then 0 else buf_chk-gds.src-qnty)
     7208                       .
     7209                   release temp-ivs-ibs-line.
     7210                   if v-d-pcnt-categ <> 0 or
     7211                   v-d-sum-categ <> 0 then do:
     7212                       run proc-magia-discnt in this-procedure (v-d-pcnt-categ, v-d-sum-categ, integer('12':U)) no-error .
     7213                   end.
     7214                   if v-d-pcnt-time <> 0 or
     7215                   v-d-sum-time <> 0 then do:
     7216                       run proc-magia-discnt in this-procedure (v-d-pcnt-time, v-d-sum-time, integer('3':U)) no-error .
     7217                   end.
     7218                   if v-d-pcnt-qnty <> 0 or
     7219                   v-d-sum-qnty <> 0 then do:
     7220                       run proc-magia-discnt in this-procedure (v-d-pcnt-qnty, v-d-sum-qnty, integer('4':U)) no-error .
     7221                   end.
     7222                   if v-d-pcnt-manual <> 0 or
     7223                   v-d-sum-manual <> 0 then do:
     7224                       run proc-magia-discnt in this-procedure (v-d-pcnt-manual, v-d-sum-manual, integer('13':U)) no-error .
     7225                   end.
     7226               end.
     7227               if v-promo <> 0 then do:
     7228                   find first buf_chk-gds-attr exclusive-lock where
     7229                              buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7230                          and buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7231                          and buf_chk-gds-attr.attr-code = "CSPromo"
     7232                   no-wait no-error.
     7233                   if locked buf_chk-gds-attr then .
     7234                   else do:
     7235                      if not available buf_chk-gds-attr
     7236                      then
     7237                      create buf_chk-gds-attr.
     7238                      assign
     7239                         buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     7240                         buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     7241                         buf_chk-gds-attr.attr-code = "CSPromo"
     7242                         buf_chk-gds-attr.attr-value =  string(v-promo)
     7243                         .
     7244                   end.
     7245               end.
     7246           end.
     7247       end.
     7248   end procedure.
     7249   procedure proc-02-gds :
     7250       define variable v-attr-code as character no-undo .
     7251       define buffer buf_chk-doc for tt-chk-doc.
     7252       define buffer buf_chk-gds for tt-chk-gds.
     7253       define buffer buf_chk-gds-attr for tt-chk-gds-attr.
     7254       define buffer buf_temp-temp for temp-temp.
     7255       define buffer buf_tt-sum-grp for tt-sum-grp.
     7256       define buffer buf_marking-chk for tt-marking-chk .
     7257       do
     7258           on error undo, return error
     7259               :
     7260           for each buf_temp-temp where
     7261               buf_temp-temp.record-name = "CBarCode":U
     7262                   AND buf_temp-temp.id = v-id:
     7263               CASE buf_temp-temp.field-name:
     7264                   when "CBCType":U then do:
     7265                       CBCType_ = fdecimal(buf_temp-temp.field-value) no-error .
     7266                   end.
     7267                   when "CBCString":U then do:
     7268                       CBCString_ = fdecimal(buf_temp-temp.field-value) no-error .
     7269                   end.
     7270                   when "CBCBarcode":U then do:
     7271                       run xmlchar-decode in this-procedure (
     7272                           input trim(buf_temp-temp.field-value)
     7273                           , output CBCBarcode_
     7274                           ) no-error.
     7275                   end.
     7276                   otherwise do:
     7277                       error-status:error = no.
     7278                   end.
     7279               END CASE.
     7280               if error-status:error then do:
     7281                   if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     7282               end.
     7283           end.
     7284           if error-status:error then do:
     7285               if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     7286           end.
     7287           if CBCType_ <> 0 and
     7288           (not exist
     7289           or (v-to-delete[1] = yes
     7290           and
     7291           v-to-delete[2] = no))
     7292           then do:
     7293               if CBCType_ = 32768 then do :
     7294                   v-attr-code = "agent-gd-code":U .
     7295               end .
     7296               else
     7297                   if CBCType_ = 65536
     7298                   or CBCType_ = 65537
     7299                   then do :
     7300                       v-attr-code = "tobacco-mark":U .
     7301                   end .
     7302               else do :
     7303                   v-attr-code = "mark-code":U .
     7304               end .
     7305               if v-attr-code = "tobacco-mark" AND CBCBarcode_ = ""
     7306               then do :
     7307                  assign  p-view-log = yes  .
     7308                   run write-log-and-file in p-log-handle (
     7309                   input 1
     7310                   , input log-file-name
     7311                   , input 1
     7312                   , input substitute("Ошибка при загрузке чека &1. Не заполнен тег CBCBarcode", chk-num_ )
     7313                   ).
     7314               end.
     7315               FIND FIRST buf_chk-doc NO-ERROR.
     7316               if v-attr-code = "tobacco-mark"
     7317               then do :
     7318                   if CBCBarcode_ <> "" then do :
     7319                   find first buf_marking-chk exclusive-lock where buf_marking-chk.mark      = CBCBarcode_
     7320                       and buf_marking-chk.doc-code  = buf_chk-doc.doc-code
     7321                       and buf_marking-chk.line-num  = CBCString_
     7322                       no-error .
     7323                   if not available buf_marking-chk
     7324                   then do :
     7325                       create buf_marking-chk .
     7326                       assign
     7327                           buf_marking-chk.mark      = CBCBarcode_
     7328                           buf_marking-chk.doc-code  = buf_chk-doc.doc-code
     7329                           buf_marking-chk.line-num  = CBCString_
     7330                           .
     7331                   end .
     7332                   assign
     7333                       buf_marking-chk.date-modify = today
     7334                       buf_marking-chk.time-modify = time
     7335                       .
     7336                   end .
     7337               end .
     7338               else do :
     7339                   find first buf_chk-gds-attr
     7340                       where buf_chk-gds-attr.doc-code  = buf_chk-doc.doc-code
     7341                       and buf_chk-gds-attr.line-num  = CBCString_
     7342                       and buf_chk-gds-attr.attr-code = v-attr-code no-error.
     7343                   if available buf_chk-gds-attr then do:
     7344                       CBCBarcode_ = buf_chk-gds-attr.attr-value + "," + CBCBarcode_ .
     7345                       buf_chk-gds-attr.attr-value =  CBCBarcode_ .
     7346                   end.
     7347                   else do:
     7348                       create buf_chk-gds-attr.
     7349                       assign
     7350                           buf_chk-gds-attr.doc-code = buf_chk-doc.doc-code
     7351                           buf_chk-gds-attr.line-num = CBCString_
     7352                           buf_chk-gds-attr.attr-code = v-attr-code
     7353                           buf_chk-gds-attr.attr-value =  CBCBarcode_
     7354                           .
     7355                   end.
     7356               end .
     7357           end.
     7358           CBCType_ = 0.
     7359       end.
     7360   end procedure.
     7361   procedure proc-13 :
     7362       do
     7363           on error undo, return error
     7364               :
     7365           if get-chkc_context.cas-shft then do:
     7366               if current-pay-desk <> pay-desk_
     7367               or NOT (current-cas-shift-name =  shift-name_
     7368               AND current-cas-shift-date = shift-date_)
     7369               OR not avail buf_shift-cash then do:
     7370   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
