     6141                   if vCHFiscalDocNumber > 0 then do:
     6142                       create buf_chk-doc-attr.
     6143                       assign
     6144                           buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6145                           buf_chk-doc-attr.attr-code  = "CHFiscalDocNumber"
     6146                           buf_chk-doc-attr.attr-value = string(vCHFiscalDocNumber)
     6147                           .
     6148                   end.
     6149                   mc-prev-code = buf_chk-doc.doc-code.
     6150               end.
     6151               else
     6152                   mc-curr-chk-type = 0 .
     6153               return.
     6154           end.
     6155           if lookup(gbl-type, accept-types) > 0
     6156           or (p-pos-type = 'MAGIA-XML':U and integer(gbl-type) = 8)
     6157           then do:
     6158               assign
     6159                   for-chk-type = ""
     6160                   exist = yes
     6161                   v-create-return-write-off = no
     6162                   v-is-without-payment = no
     6163                   v-to-delete[1] = no
     6164                   v-to-delete[2] = no
     6165                   .
     6166               FIND  buf_chk-doc where
     6167                   buf_chk-doc.obj-type = shop-type and
     6168                   buf_chk-doc.obj-code = shop-code and
     6169                   buf_chk-doc.chk-date = chk-date_ and
     6170                   buf_chk-doc.pay-desk = pay-desk_ and
     6171                   buf_chk-doc.chk-time = chk-time_ and
     6172                   buf_chk-doc.chk-num = chk-num_ and
     6173                   (p-pos-type = 'MAGIA-XML':U
     6174                   or buf_chk-doc.cashier = cashier_
     6175                   ) NO-ERROR NO-WAIT.
     6176               IF NOT AVAILABLE buf_chk-doc
     6177               AND NOT LOCKED buf_chk-doc
     6178               AND NOT AMBIGUOUS buf_chk-doc
     6179               or (p-pos-type = 'MAGIA-XML':U
     6180               AND
     6181               (AVAILABLE buf_chk-doc
     6182               and
     6183               NOT AMBIGUOUS buf_chk-doc)
     6184               )  then do:
     6185                   v-chk-type[1] = integer(gbl-type).
     6186                   if p-pos-type = 'MAGIA-XML':U then do:
     6187                       for each temp-ivs-ibs where
     6188                           temp-ivs-ibs.chtype = gbl-type
     6189                               AND temp-ivs-ibs.positive-num-chk = (chk-num_ > 0)
     6190                               AND temp-ivs-ibs.positive-netto-sum = ((netto-sum_ > 0) or (netto-sum_ = 0  and chk-num_ < 0))
     6191                               and temp-ivs-ibs.main-record = yes:
     6192                           if temp-ivs-ibs.step_ = 1 then v-chk-type[1] = integer(temp-ivs-ibs.rcpt-type-1).
     6193                           if temp-ivs-ibs.step_ = 2 then do:
     6194                               assign
     6195                                   v-chk-type[2] = integer(temp-ivs-ibs.rcpt-type-1)
     6196                                   v-create-return-write-off = temp-ivs-ibs.create-return-write-off
     6197                                   v-write-off-code-2 = integer(temp-ivs-ibs.wro-code)
     6198                                   .
     6199                           end.
     6200                       end.
     6201                       if v-chk-type[1] = 0 then do:
     6202                           assign
     6203                               exist = yes.
     6204                           run write-log-and-file in p-log-handle (
     6205                               input 1
     6206                               , input log-file-name
     6207                               , input 1
     6208                               , input substitute( "!!!Неизвестный тип чека:&1" +
     6209                               "код типа чека &2 сумма нетто &3 номер чека на кассе &4 касса &5"
     6210                               , chr(10)
     6211                               , gbl-type
     6212                               , netto-sum_
     6213                               , chk-num_
     6214                               , pay-desk_
     6215                               )
     6216                               ).
     6217                           assign
     6218                               p-view-log = yes
     6219                               .
     6220                           return.
     6221                       end.
     6222                       if AMBIGUOUS buf_chk-doc
     6223                       or available buf_chk-doc then do:
     6224                           if v-chk-type[2] = 0 then return.
     6225                           do v-step = 2 to 1 by -1:
     6226                               FIND  buf_chk-doc no-lock where
     6227                                   buf_chk-doc.obj-type = shop-type and
     6228                                   buf_chk-doc.obj-code = shop-code and
     6229                                   buf_chk-doc.chk-date = chk-date_ and
     6230                                   buf_chk-doc.pay-desk = pay-desk_ and
     6231                                   buf_chk-doc.chk-time = chk-time_ and
     6232                                   buf_chk-doc.chk-num = chk-num_ and
     6233                                   buf_chk-doc.chk-type = integer(v-chk-type[v-step])
     6234                                   NO-ERROR NO-WAIT.
     6235                               if available buf_chk-doc then do:
     6236                                   assign
     6237                                       v-to-delete[v-step] = yes
     6238                                       .
     6239                                   if v-step = 1 then do:
     6240                                       prev-code = buf_chk-doc.doc-code.
     6241                                   end.
     6242                               end.
     6243                           end.
     6244                           if v-to-delete[1] = yes
     6245                           and v-to-delete[2] = yes then return.
     6246                           if v-create-return-write-off
     6247                           and v-to-delete[1]
     6248                           and not v-to-delete[2]
     6249                           then do:
     6250                               exist = yes.
     6251                               return.
     6252                           end.
     6253                       end.
     6254                       else do:
     6255                       end.
     6256                   end.
     6257                   for each temp-ivs-ibs-line:
     6258                       delete temp-ivs-ibs-line.
     6259                   end.
     6260                   assign
     6261                       exist = NO.
     6262                   create buf_chk-doc.
     6263                   assign
     6264                       buf_chk-doc.office = ?
     6265                       v-to-delete[1] = NO
     6266                       v-to-delete[1] = NO
     6267                       kriv3 = NO
     6268                       lng = 0
     6269                       lnp = 0
     6270                       lnc = 0
     6271                       sub-d = 0
     6272                       var-discnt-id = 0
     6273                       lng-sub-d = 0
     6274                       netto-for-sub-d = 0
     6275                       accum-src-for-sub-d = 0
     6276                       buf_chk-doc.chk-id = v-id
     6277                       buf_chk-doc.obj-code = shop-code
     6278                       buf_chk-doc.obj-type = shop-type
     6279                       buf_chk-doc.doc-code = (if get-chkc_context.db-num = 0
     6280                       then string(next-value(s-chk, ub ))
     6281                       else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     6282                       buf_chk-doc.chk-num =  chk-num_
     6283                       buf_chk-doc.chk-date = chk-date_
     6284                       buf_chk-doc.chk-time = chk-time_
     6285                       buf_chk-doc.sales-man = (if sales-man_ = ? then 0 else sales-man_)
     6286                       buf_chk-doc.pay-desk = pay-desk_
     6287                       buf_chk-doc.cashier = cashier_
     6288                       buf_chk-doc.discnt = 0
     6289                       buf_chk-doc.src-d-card =  (if d-card_ <> "":U then d-card_ else ?)
     6290                       buf_chk-doc.src-d-pcnt = - tot-d-pcnt
     6291                       buf_chk-doc.src-cli-type = (if cli-type_ = "":u then ? else cli-type_)
     6292                       buf_chk-doc.src-cli-code = (if cli-code_ = 0    then ? else cli-code_)
     6293                       buf_chk-doc.src-shift-date = (if is-shift-date then shift-date_ else chk-date_)
     6294                       shift-name_ = if cas-shft then string(shift-num_) else '':U
     6295                       shift-num_ = if get-chkc_context.shift-on then 0 else shift-num_
     6296                       buf_chk-doc.shift-num = shift-num_
     6297                       buf_chk-doc.src-shift-name = shift-name_
     6298                       buf_chk-doc.shift-name = shift-name_
     6299                       buf_chk-doc.cash-rate = cash-rate_
     6300                       buf_chk-doc.cash-scale = 1
     6301                       buf_chk-doc.z-number = z-num_
     6302                       buf_chk-doc.doc-num = doc-num_
     6303                       buf_chk-doc.chk-type = v-chk-type[1]
     6304                       buf_chk-doc.out-code = if buf_chk-doc.chk-type eq 13 or buf_chk-doc.chk-type eq 40 then 'смена':U else buf_chk-doc.out-code
     6305                       buf_chk-doc.prev-chk-type = int(prev-gbl-type)
     6306                       v-is-petrol-check = lookup(string(v-chk-type[1]) , '14,15,16,17,36':U) > 0
     6307                       buf_chk-doc.correct = YES
     6308                       no-error
     6309                       .
     6310                   if error-status:error then do:
     6311                       buf_chk-doc.correct = no.
     6312                   end.
