     3005               when 'out-code-2':U then do:     assign     p-tooltip = "Номер док-та, использующего чек (кроме продажи)"     p-label = "Номер док-та, использующего чек" .   end.
     3006               when 'qr-alchol':U then do:     assign     p-tooltip = "Qr-коды от ЕГАИС по алкоголю, (кроме пива)"     p-label = "Qr-коды от ЕГАИС по алкоголю (кроме пива)" .   end.
     3007               when '':U then do:     assign     p-tooltip = "Qr-коды от ЕГАИС по пиву"     p-label = "Qr-коды от ЕГАИС по пиву)" .   end.
     3008         otherwise do:
