      672   procedure get-last-check-date-time :
      673       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      674       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      675       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      676       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      677       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      678       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      679       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      680       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      681       define variable v-character as character no-undo .
      682       define variable v-date      as date      no-undo .
      683       define variable v-decimal   as decimal   no-undo .
      684       define variable v-integer   as integer   no-undo .
      685       define variable v-logical   as logical   no-undo .
      686       define variable v-attr-type as character no-undo .
      687       define buffer buf_chk-doc     for ub.chk-doc.
      688       define buffer buf_c-cash-desk for ub.c-cash-desk.
      689       do
      690           on error undo, return error
      691           :
      692           run cd-attr-value in this-procedure (
      693               input g#db-num
      694               ,input p-obj-code
      695               ,input p-pos-type
      696               ,input p-cash-num
      697               ,input 'MAGIA-XML_operative':U
      698               ,input 'last-check-date-time':U
      699               ,output v-character
      700               ,output v-date
      701               ,output v-decimal
      702               ,output v-integer
      703               ,output v-logical
      704               ,output v-attr-type     ) no-error.
      705           if v-character = "":U
      706               or v-character = ?
      707               then
      708           do:
      709               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      710                   buf_c-cash-desk.db-num = g#db-num
      711                   AND buf_c-cash-desk.pos-type = p-pos-type
      712                   AND buf_c-cash-desk.cash-num = p-cash-num
      713                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      714                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      715               if available buf_c-cash-desk then
      716               do:
      717                   assign
      718                       p-date = buf_c-cash-desk.corr-date
      719                       p-time = buf_c-cash-desk.corr-time
      720                       .
      721               end.
      722               else
      723               do:
      724                   find first buf_chk-doc no-lock where
      725                       buf_chk-doc.obj-type = 'маг':U
      726                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      727                   if not available buf_chk-doc then
      728                   do:
      729                       return error.
      730                   end.
      731                   assign
      732                       p-date = buf_chk-doc.chk-date - 1
      733                       p-time = buf_chk-doc.chk-time
      734                       .
      735               end.
      736           end.
      737           else
      738           do:
      739               assign
      740                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      741           no-error .
      742               if error-status:error then return error .
      743           end.
      744       end.
      745   end procedure.
      746   procedure get-last-check-params :
      747       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      748       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      749       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      750       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      751       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      752       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      753       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      754       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      755       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      756       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      757       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      758       define variable v-character as character no-undo .
      759       define variable v-date      as date      no-undo .
      760       define variable v-decimal   as decimal   no-undo .
      761       define variable v-integer   as integer   no-undo .
      762       define variable v-logical   as logical   no-undo .
      763       define variable v-attr-type as character no-undo .
      764       define buffer buf_chk-doc     for ub.chk-doc.
      765       define buffer buf_c-cash-desk for ub.c-cash-desk.
      766       do
      767           on error undo, return error
      768           :
      769           run cd-attr-value in this-procedure (
      770               input g#db-num
      771               ,input p-obj-code
      772               ,input p-pos-type
      773               ,input p-cash-num
      774               ,input if p-pos-type eq 'IBM-XML':U
      775               then 'IBM-XML_operative':U
      776               else 'AUTOTANK_operative':U
      777               ,input if p-pos-type = 'IBM-XML':U
      778               then 'last-check-params':U
      779               else 'last-check-params':U
      780               ,output v-character
      781               ,output v-date
      782               ,output v-decimal
      783               ,output v-integer
      784               ,output v-logical
      785               ,output v-attr-type     ) no-error.
      786           if v-character = "":U
      787               or v-character = ?
      788               then
      789           do:
      790               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      791                   buf_c-cash-desk.db-num = g#db-num
      792                   AND buf_c-cash-desk.pos-type = p-pos-type
      793                   AND buf_c-cash-desk.cash-num = p-cash-num
      794                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      795                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      796               if available buf_c-cash-desk then
      797               do:
      798                   assign
      799                       p-date = buf_c-cash-desk.corr-date
      800                       p-time = buf_c-cash-desk.corr-time
      801                       .
      802               end.
      803               else
      804               do:
      805                   find first buf_chk-doc no-lock where
      806                       buf_chk-doc.obj-type = 'маг':U
      807                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      808                   if not available buf_chk-doc then
      809                   do:
      810                       return error.
      811                   end.
      812                   assign
      813                       p-date      = buf_chk-doc.chk-date - 1
      814                       p-time      = buf_chk-doc.chk-time
      815                       p-shift-num = buf_chk-doc.shift-num
      816                       p-z-count   = buf_chk-doc.z-number
      817                       p-chk-num   = buf_chk-doc.chk-num
      818                       .
      819               end.
      820           end.
      821           else
      822           do:
      823               assign
      824                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      825                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      826                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      827                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      828                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      829                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      830           no-error .
      831               if error-status:error then return error .
      832           end.
      833       end.
      834   end procedure.
      835   procedure get-last-report-params :
      836       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      837       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      838       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      839       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      840       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      841       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      842       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      843       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      844       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      845       define variable v-character as character no-undo .
      846       define variable v-date      as date      no-undo .
      847       define variable v-decimal   as decimal   no-undo .
      848       define variable v-integer   as integer   no-undo .
      849       define variable v-logical   as logical   no-undo .
      850       define variable v-date1     as character no-undo .
      851       define variable v-date2     as character no-undo .
      852       define variable v-attr-type as character no-undo .
      853       define buffer buf_chk-slip-head for ub.chk-slip-head.
      854       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      855       do
      856           on error undo, return error
      857           :
      858           run cd-attr-value in this-procedure (
      859               input g#db-num
      860               ,input p-obj-code
      861               ,input p-pos-type
      862               ,input p-cash-num
      863               ,input if p-pos-type eq 'IBM-XML':U
      864               then 'IBM-XML_operative':U
      865               else 'AUTOTANK_operative':U
      866               ,input if p-pos-type = 'IBM-XML':U
      867               then 'last-report-params':U
      868               else 'last-report-params':U
      869               ,output v-character
      870               ,output v-date
      871               ,output v-decimal
      872               ,output v-integer
      873               ,output v-logical
      874               ,output v-attr-type     ) no-error.
      875           if v-character = "":U
      876               or v-character = ?
      877               then
      878           do:
      879               find last buf_chk-slip-head no-lock where
      880                   buf_chk-slip-head.obj-code = p-obj-code
      881                   and buf_chk-slip-head.cash-num = p-cash-num
      882                   and buf_chk-slip-head.db-num = p-db-num
      883                   and buf_chk-slip-head.is-report = 1 no-error.
      884               if not available buf_chk-slip-head then
      885               do:
      886                   return error.
      887               end.
      888               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      889               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      890                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      891                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      892                   + " " + entry(1,v-date2,".") .
      893               assign
      894                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      895                   p-shift-num = buf_chk-slip-head.CashShiftNum
      896                   .
      897           end.
      898           else
      899           do:
      900               assign
      901                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      902                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      903                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      904           no-error .
      905               if error-status:error then return error .
      906           end.
      907       end.
      908   end procedure.
      909   procedure get-last-check-maria :
      910       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      911       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      912       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      913       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      914       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      915       define output parameter p-num-recs as integer no-undo .
      916       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      917       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      918       define output parameter p-p-num-recs as integer no-undo .
      919       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      920       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      921       define variable v-character as character no-undo .
      922       define variable v-date      as date      no-undo .
      923       define variable v-decimal   as decimal   no-undo .
      924       define variable v-integer   as integer   no-undo .
      925       define variable v-logical   as logical   no-undo .
      926       define variable v-attr-type as character no-undo .
      927       define buffer buf_chk-doc     for ub.chk-doc.
      928       define buffer buf_c-cash-desk for ub.c-cash-desk.
      929       do
      930           on error undo, return error
      931           :
      932           run cd-attr-value in this-procedure (
      933               input p-db-num
      934               ,input p-obj-code
      935               ,input 'MARIA':U
      936               ,input p-cash-num
      937               ,input 'MARIA_operative':U
      938               ,input 'last-check-maria':U
      939               ,output v-character
      940               ,output v-date
      941               ,output v-decimal
      942               ,output v-integer
      943               ,output v-logical
      944               ,output v-attr-type     ) no-error.
      945           if v-character = "":U
      946               or v-character = ?
      947               then
      948           do:
      949               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      950                   buf_c-cash-desk.db-num = p-db-num
      951                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      952                   AND buf_c-cash-desk.cash-num = p-cash-num
      953                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      954                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      955               if available buf_c-cash-desk then
      956               do:
      957                   assign
      958                       p-date   = buf_c-cash-desk.corr-date
      959                       p-p-date = buf_c-cash-desk.corr-date
      960                       .
      961               end.
      962               else
      963               do:
      964                   find first buf_chk-doc no-lock where
      965                       buf_chk-doc.obj-type = 'маг':U
      966                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      967                   if not available buf_chk-doc then
      968                   do:
      969                       assign
      970                           p-date       = 01/01/1990
      971                           p-z-count    = 1
      972                           p-num-recs   = 0
      973                           p-p-date     = 01/01/1990
      974                           p-p-z-count  = 1
      975                           p-p-num-recs = 0
      976                           .
      977                   end.
      978                   assign
      979                       p-date       = buf_chk-doc.chk-date - 1
      980                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      981                       p-num-recs   = 0
      982                       p-p-date     = buf_chk-doc.chk-date - 1
      983                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      984                       p-p-num-recs = 0
      985                       .
      986               end.
      987           end.
      988           else
      989           do:
      990               assign
      991                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      992                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      993                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      994                         )
      995                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      996                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      997                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      998                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      999                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
     1000                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
     1001                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1002                         )
     1003                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1004                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1005                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1006                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1007           no-error .
     1008               if error-status:error then return error .
     1009           end.
     1010       end.
     1011   end procedure.
