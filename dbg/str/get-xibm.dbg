     5352   end.
     5353   define variable v-rowid as rowid no-undo .
     5354   define variable v-tbl-name as character no-undo .
     5355   define buffer locked_cash-desk for ub.cash-desk.
     5356   p-second-mode = trim(p-second-mode,chr(4)).
     5357   if entry(1, p-second-mode) = "version" then do:
     5358       do transaction:
     5359           run gen-row-keyr in this-procedure
     5360               ( input  replace(p-second-mode, "version,", "")
     5361               ,input ?
     5362               ,input "ub":U
     5363               ,input ?
     5364               ,input share-lock
     5365               ,output v-rowid
     5366               ,output v-tbl-name
     5367               ) no-error .
     5368           find first locked_cash-desk share-lock where
     5369               rowid(locked_cash-desk) = v-rowid.
     5370           if v-from <> substitute('&1&2_касса&3', 'маг':U, locked_cash-desk.obj-code, locked_cash-desk.cash-num) then do:
     5371               run write-log-and-file in p-log-handle (
     5372                   input 1
     5373                   , input log-file-name
     5374                   , input 1
     5375                   , input substitute("!!!ОШИБКА! Запрашивалась версия ПО &1&2_касса&3, а получена версия ПО для &4."
     5376                   , 'маг':U
     5377                   , locked_cash-desk.obj-code
     5378                   , locked_cash-desk.cash-num
     5379                   , v-from
     5380                   )).
     5381               p-view-log = yes .
     5382           end.
     5383           else if locked_cash-desk.version <> v-pos-version then do:
     5384               assign
     5385                   locked_cash-desk.version = v-pos-version
     5386                   .
     5387               release locked_cash-desk no-error .
     5388               if not error-status:error then do:
     5389                   run write-log-and-file in p-log-handle (
     5390                       input 1
     5391                       , input log-file-name
     5392                       , input 1
     5393                       , input substitute("Изменена версия ПО для &1. Версия ПО принимается равной &2."
     5394                       , v-from
     5395                       , v-pos-version
     5396                       )).
     5397               end.
     5398           end.
     5399       end.
     5400   end.
     5401   PROCEDURE get-ibm-parameters:
     5402       define variable ret-item as character no-undo .
     5403       define variable wro-item as character no-undo .
     5404       define variable wro-chk as character no-undo .
     5405       define variable ret-ord as character no-undo .
     5406       define variable wro-ord as character no-undo .
     5407       define variable ii as integer no-undo .
     5408       define variable v-param-type as character no-undo .
     5409       define variable v-value-character as character no-undo .
     5410       define variable v-value-date as date no-undo .
     5411       define variable v-value-decimal as decimal no-undo .
     5412       define variable v-value-integer as INTEGER no-undo .
     5413       define variable v-value-logical AS LOGICAL no-undo .
     5414       define variable v-tth as handle no-undo .
     5415       assign
     5416           v-tth = buffer thbjattr_thbj-attr:table-handle .
     5417       define buffer buf_tt-sum-grp for tt-sum-grp.
     5418       if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     5419           run write-log-and-file in p-log-handle (
     5420               input 1
     5421               , input log-file-name
     5422               , input 1
     5423               , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен, а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо."
     5424               , get-chkc_context.obj-type
     5425               , get-chkc_context.obj-code
     5426               )).
     5427           assign
     5428               p-view-log = yes
     5429               .
     5430           undo, return .
     5431       end.
     5432       get-chkc_context.ibmgroup = ibmgroup.
     5433       if get-chkc_context.t-shft > 0 and get-chkc_context.shift-on = yes then do:
     5434           run write-log-and-file in p-log-handle (
     5435               input 1
     5436               , input log-file-name
     5437               , input 1
     5438               , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен,&3" +
     5439               "а настройка СМЕЩЕННЫЕ СМЕНЫ НА КАССЕ&3" +
     5440               "(АРМ Администратор - Справочники - Магазины - Параметры - время начала пересменки)&3" +
     5441               "включена - это недопустимо."
     5442               , get-chkc_context.obj-type
     5443               , get-chkc_context.obj-code
     5444               , chr(10)
     5445               )).
     5446           assign
     5447               p-view-log = yes
     5448               .
     5449           undo, return .
     5450       end.
     5451       if get-chkc_context.is-wth = yes then do:
     5452           accept-types =  "1,2,3,4,5,6,7,13,40,43,44":U.
     5453       end.
     5454       else do:
     5455           accept-types =  "1,6,13,40,43,44":U.
     5456       end.
     5457       dflt-cd = p-pos-type.
     5458       get-chkc_context.pos-type = p-pos-type.
     5459       if get-chkc_context.is-ptrl
     5460       and get-chkc_context.ptrl-check then
     5461           assign
     5462               accept-types = accept-types + ",14,15,16,17":U.
     5463       if is-ptrl and ptrl-check
     5464       and (p-pos-type = 'IBM-XML':U or p-pos-type = 'Autotank':U)
     5465       then
     5466           assign
     5467               accept-types = accept-types + ",36":U.
     5468       if p-pos-type = 'MAGIA-XML':U
     5469       or get-chkc_context.annu-check then
     5470           assign
     5471               accept-types = accept-types + ",8":U
     5472               .
     5473       if get-chkc_context.z-check then
     5474           assign
     5475               accept-types = accept-types + ",12":U
     5476               .
     5477       if get-chkc_context.is-cdinv then accept-types = accept-types + ",11":U.
     5478       if p-pos-type = 'MAGIA-XML':U then do:
     5479           for each thbjattr_thbj-attr:
     5480               delete thbjattr_thbj-attr.
     5481           end.
     5482           run adm/shattri.p (
     5483               input "get":U
     5484               ,input  p-obj-type
     5485               ,input  p-obj-code
     5486               ,input  'cd-type-magia-xml':U
     5487               ,input  '':U
     5488               ,output v-value-character
     5489               ,output v-value-date
     5490               ,output v-value-decimal
     5491               ,output v-value-integer
     5492               ,output v-value-logical
     5493               ,output v-param-type
     5494               ,INPUT-OUTPUT table-handle v-tth
     5495               ) no-error .
     5496           IF error-status:error then do:
     5497               run write-log-and-file in p-log-handle (
     5498                   input 1
     5499                   , input log-file-name
     5500                   , input 1
     5501                   , input  substitute(
     5502                   "Не удалось получить настройки для  POS типа &1 для маг&2"
     5503                   , 'MAGIA-XML':U
     5504                   , p-obj-code)
     5505                   ).
     5506               assign
     5507                   v-cd-fatal-error = yes
     5508                   v-cd-fatal-message = "неверные настройки"
     5509                   p-view-log = yes
     5510                   .
     5511               return "error".
     5512           end.
     5513           for each thbjattr_thbj-attr where
     5514               thbjattr_thbj-attr.obj-type = p-obj-type
     5515                   and thbjattr_thbj-attr.obj-code = p-obj-code
     5516                   and thbjattr_thbj-attr.upper-prop-code =  'cd-type-magia-xml':U
     5517                   on error undo, return error :
     5518               case thbjattr_thbj-attr.prop-code :
     5519                   when 'ret-item':U then do:
     5520                       assign
     5521                           ret-item = thbjattr_thbj-attr.property-value-character.
     5522                   end.
     5523                   when 'wro-item':U then do:
     5524                       assign
     5525                           wro-item = thbjattr_thbj-attr.property-value-character.
     5526                   end.
     5527                   when 'wro-chk':U then do:
     5528                       assign
     5529                           wro-chk = thbjattr_thbj-attr.property-value-character.
     5530                   end.
     5531                   when 'ret-chk':U then do:
     5532                       assign
     5533                           ret-chk = thbjattr_thbj-attr.property-value-character.
     5534                   end.
     5535                   when 'wro-ord':U then do:
     5536                       assign
     5537                           wro-ord = thbjattr_thbj-attr.property-value-character.
     5538                   end.
     5539                   when 'ret-ord':U then do:
     5540                       assign
     5541                           ret-ord = thbjattr_thbj-attr.property-value-character.
     5542                   end.
     5543               end case.
     5544           end.
     5545           run create-temp-ivs-ibs-line in this-procedure (
     5546               input ret-item
     5547               ,input wro-item
     5548               ,input ret-chk
     5549               ,input wro-chk
     5550               ,input ret-ord
     5551               ,input wro-ord ) .
     5552       end.
     5553       if p-pos-type = 'IBM-XML':U then do :
     5554           run adm/shattri.p (
     5555               input "get":U
     5556               ,input  p-obj-type
     5557               ,input  p-obj-code
     5558               ,input  'cd-type-IBM-XML':U
     5559               ,input  'ibm-ccm':U
     5560               ,output v-value-character
     5561               ,output v-value-date
     5562               ,output v-value-decimal
     5563               ,output v-value-integer
     5564               ,output v-value-logical
     5565               ,output v-param-type
     5566               ,INPUT-OUTPUT table-handle v-tth
     5567               ) no-error .
     5568           IF not error-status:error then do:
     5569               delete object v-tth.
     5570               ibm-ccm = v-value-integer.
     5571           end.
     5572           else do:
     5573               ibm-ccm = ?.
     5574               delete object v-tth.
     5575               return error return-value .
     5576           end.
     5577       end.
     5578       if (p-pos-type = 'IBM-XML':U or p-pos-type = 'Autotank':U) and get-chkc_context.ibmgroup then do:
     5579           for each buf_tt-sum-grp:
     5580               delete buf_tt-sum-grp.
     5581           end.
     5582           do ii = 1 to num-entries(specgrp, ';'):
     5583               create buf_tt-sum-grp.
     5584               assign
     5585                   buf_tt-sum-grp.grp-code = integer(entry(1, entry(ii, specgrp, ';'), '-':U))
     5586                   buf_tt-sum-grp.code-2 = integer(entry(2, entry(ii, specgrp, ';'), '-':U))
     5587                   no-error
     5588                   .
     5589               if error-status:error then do:
     5590                   delete buf_tt-sum-grp.
     5591               end.
     5592           end.
     5593       end.
     5594       if p-pos-type = 'Autotank':U then do:
     5595           for each thbjattr_thbj-attr:
     5596               delete thbjattr_thbj-attr.
     5597           end.
     5598           run adm/shattri.p (
     5599               input "get":U
     5600               ,input  p-obj-type
     5601               ,input  p-obj-code
     5602               ,input  'cd-type-autotank':U
     5603               ,input  '':U
     5604               ,output v-value-character
     5605               ,output v-value-date
     5606               ,output v-value-decimal
     5607               ,output v-value-integer
     5608               ,output v-value-logical
     5609               ,output v-param-type
     5610               ,INPUT-OUTPUT table-handle v-tth
     5611               ) no-error .
     5612           IF error-status:error then do:
     5613               run write-log-and-file in p-log-handle (
     5614                   input 1
     5615                   , input log-file-name
     5616                   , input 1
     5617                   , input  substitute(
     5618                   "Не удалось получить настройки для  POS типа &1 для маг&2"
     5619                   , 'MAGIA-XML':U
     5620                   , p-obj-code)
     5621                   ).
     5622               assign
     5623                   v-cd-fatal-error = yes
     5624                   v-cd-fatal-message = "неверные настройки"
     5625                   p-view-log = yes
     5626                   .
     5627               return "error".
     5628           end.
     5629           for each thbjattr_thbj-attr where
     5630               thbjattr_thbj-attr.obj-type = p-obj-type
     5631                   and thbjattr_thbj-attr.obj-code = p-obj-code
     5632                   and thbjattr_thbj-attr.upper-prop-code =  'cd-type-autotank':U
     5633                   on error undo, return error :
     5634               case thbjattr_thbj-attr.prop-code :
     5635                   when 'cash-pay-list':U then do:
     5636                       assign
     5637                           autotank-pay-list = thbjattr_thbj-attr.property-value-character.
     5638                   end.
     5639               end case.
     5640           end.
     5641       end.
     5642   END PROCEDURE.
     5643   procedure proc-00 :
     5644       define variable is-shift-date as logical no-undo .
     5645       define variable prev-code2 like ub.chk-doc.doc-code no-undo .
     5646       define variable netto-sum2_ as decimal no-undo .
     5647       define variable iexist as integer no-undo .
     5648       define variable v-new as character no-undo .
     5649       define variable v-old as character no-undo .
     5650       define variable v-step as integer   no-undo .
     5651       define buffer buf_temp-temp for temp-temp.
     5652       define buffer buf_chk-doc for tt-chk-doc.
     5653       define buffer buf_chk-doc-attr for tt-chk-doc-attr.
     5654       define buffer buf_tt-chk-pay for tt-chk-pay.
     5655       define variable vCHFlag1           as character no-undo.
     5656       define variable vCHNumberKKT       as character no-undo.
     5657       define variable vCHMgrKey          as character no-undo.
     5658       define variable vCHNumberFN        as character no-undo.
     5659       define variable vCHFiscalDocSign   as character no-undo .
     5660       define variable vCHFiscalDocNumber as integer no-undo .
     5661       do
     5662           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5663               :
     5664           find first buf_temp-temp no-lock where
     5665               buf_temp-temp.record-name = "CHead"
     5666               AND buf_temp-temp.field-name = "CHType"
     5667               AND buf_temp-temp.id = v-id
     5668               no-error .
     5669           if not available buf_temp-temp then do:
     5670               assign
     5671                   v-start-check = 0
     5672                   .
     5673               return.
     5674           end.
     5675           assign
     5676               prev-gbl-type = ''
     5677               gbl-type = string(integer(buf_temp-temp.field-value))
     5678               no-error .
     5679           if error-status:error then do:
     5680               if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     5681           end.
     5682           if can-do(accept-types,  gbl-type ) then do:
     5683               assign
     5684                   chk-date_ = 01/01/1990
     5685                   chk-time_ = 0
     5686                   shift-date_ = chk-date_
     5687                   shift-num_ = 0
     5688                   shift-name_ = ''
     5689                   shift-open-time_ = 0
     5690                   shop-code = p-obj-code
     5691                   shop-type = 'маг':U
     5692                   sales-man_ = 0
     5693                   cashier_ = 0
     5694                   pay-desk_ = 0
     5695                   z-num_ = 0
     5696                   cash-rate_ = 0
     5697                   d-card_ = "":U
     5698                   d-mask_ = "":U
     5699                   tot-d-pcnt = 0
     5700                   doc-num_ = "":U
     5701                   doc-num2_ = "":U
     5702                   chk-num_ = 0
     5703                   netto-sum_ = 0
     5704                   AuthType_ = 0
     5705                   qr-alchol_ = "":u
     5706                   brutto-sum_ = 0
     5707                   v-flag-salesman  = no
     5708                   v-flag-card = no
     5709                   d-mask_ = "":U
     5710                   cli-type_ = "":U
     5711                   v-oss-code = "":U
     5712                   price-old = 0
     5713                   cli-code_ = 0
     5714                   v-chk-type[1] = 0
     5715                   v-chk-type[2] = 0
     5716                   v-is-petrol-check = no
     5717                   cstCode = ""
     5718                   cstValue = 0
     5719                   spool-date_ = ?
     5720                   spool-time_ = ?
     5721                   vCHMgrKey = ""
     5722                   vCHNumberKKT = ""
     5723                   vCHFlag1    = ""
     5724                   no-error
     5725                   .
     5726               _buf_temp:
     5727               for each buf_temp-temp no-lock where
     5728                   buf_temp-temp.record-name = "CHead":U
     5729                       AND buf_temp-temp.id = v-id:
     5730                   CASE buf_temp-temp.field-name:
     5731                       when "CHMode":U then do:
     5732                           assign
     5733                               iexist = int(buf_temp-temp.field-value)
     5734                               no-error .
     5735                           if not error-status:error
     5736                           and (not (iexist = 1
     5737                           or
     5738                           (iexist = 2 and get-chkc_context.annu-check)
     5739                           ))
     5740                           then do:
     5741                               assign
     5742                                   exist = yes
     5743                                   mc-exist = yes
     5744                                   .
     5745                               return .
     5746                           end.
     5747                           if iexist = 2 then do:
     5748                               assign
     5749                                   prev-gbl-type = gbl-type
     5750                                   gbl-type = '8'.
     5751                           end.
     5752                       end.
     5753                       when "CHNum":U then do:
     5754                           assign
     5755                               chk-num_ = integer(buf_temp-temp.field-value)
     5756                               no-error .
     5757                       end.
     5758                       when "CHDate":U then do:
     5759                           assign
     5760                               chk-date_ =  cb-xmlparse-get-date( buf_temp-temp.field-value)
     5761                               chk-time_ =  cb-xmlparse-get-time( buf_temp-temp.field-value)
     5762                               spool-date_ = cb-xmlparse-get-date( v-time-char)
     5763                               spool-time_ = cb-xmlparse-get-time( v-time-char)
     5764                               no-error .
     5765                       end.
     5766                       when "CHShop":U then do:
     5767                           assign
     5768                               shop-code = if get-chkc_context.hnum
     5769                               then int(buf_temp-temp.field-value)
     5770                               else shop-code
     5771                               shop-type = 'маг':U
     5772                               no-error .
     5773                       end.
     5774                       when "CHCashNum":U then do:
     5775                           assign
     5776                               pay-desk_ = int(buf_temp-temp.field-value)
     5777                               no-error
     5778                               .
     5779                       end.
     5780                       when "CHCashier":U then do:
     5781                           assign
     5782                               cashier_ = int(buf_temp-temp.field-value)
     5783                               no-error
     5784                               .
     5785                       end.
     5786                       when "CHZcount":U then do:
     5787                           assign
     5788                               z-num_ = integer(buf_temp-temp.field-value)
     5789                               no-error
     5790                               .
     5791                       end.
     5792                       when "CHSBeg":U then do:
     5793                           assign
     5794                               shift-date_ = cb-xmlparse-get-date(buf_temp-temp.field-value)
     5795                               is-shift-date = yes
     5796                               shift-open-time_ = cb-xmlparse-get-time( buf_temp-temp.field-value)
     5797                               no-error .
     5798                       end.
     5799                       when "CHSNum":U then do:
     5800                           assign
     5801                               shift-name_ = buf_temp-temp.field-value
     5802                               shift-num_ = integer(buf_temp-temp.field-value)
     5803                               no-error
     5804                               .
     5805                       end.
     5806                       when "CHRate":U then do:
     5807                           assign
     5808                               cash-rate_ = fdecimal(buf_temp-temp.field-value)
     5809                               no-error
     5810                               .
     5811                       end.
     5812                       when "CHDoc":U then do:
     5813                           run xmlchar-decode in this-procedure (
     5814                               input trim(buf_temp-temp.field-value)
     5815                               , output doc-num_
     5816                               ) no-error.
     5817                       end.
     5818                       when "CHBrutto":U then do:
     5819                           assign
     5820                               brutto-sum_ = fdecimal(buf_temp-temp.field-value)
     5821                               no-error .
     5822                       end.
     5823                       when "CHNetto":U then do:
     5824                           assign
     5825                               netto-sum_ = fdecimal(buf_temp-temp.field-value)
     5826                               no-error .
     5827                       end.
     5828                       when "CAuthorization":U then do:
     5829                           CASE buf_temp-temp.field-name:
     5830                               when "CAuthType mes":U then do:
     5831                                   assign
     5832                                       AuthType_ = fdecimal(buf_temp-temp.field-value)
     5833                                       no-error .
     5834                               end.
     5835                               when "CAuthUrl mes":U then do:
     5836                                   run xmlchar-decode in this-procedure (
     5837                                       input trim(buf_temp-temp.field-value)
     5838                                       , output qr-alchol_
     5839                                       ) no-error.
     5840                               end.
     5841                           end case.
     5842                       end.
     5843                       when "CSClient":U then do:
     5844                           if p-pos-type = 'MAGIA-XML':U then
     5845                               assign
     5846                               cli-code_ = integer(buf_temp-temp.field-value)
     5847                               cli-type_ = if cli-code_ > 9999999999 then 'орг':U else 'чел':U
     5848                                   no-error .
     5849                       end.
     5850                       when "CSCCardN":U then do:
     5851                           if p-pos-type = 'MAGIA-XML':U then
     5852                               assign
     5853                               d-card_ = (if buf_temp-temp.field-value = "0" then "":u else buf_temp-temp.field-value)
     5854                                   no-error .
     5855                       end.
     5856                       when "CHAgreement":U then do:
     5857                           if p-pos-type = 'IBM-XML':U OR p-pos-type = 'Autotank':U then
     5858                               assign
     5859                               doc-num2_ = (if buf_temp-temp.field-value = "0" then "":u else buf_temp-temp.field-value)
     5860                                   no-error .
     5861                       end.
     5862                       when "CHNumberKKT":U then do:
     5863                           vCHNumberKKT = buf_temp-temp.field-value no-error .
     5864                       end.
     5865                       when "CHNumberFN":U then do:
     5866                           vCHNumberFN = buf_temp-temp.field-value no-error .
     5867                       end.
     5868                       when "CHFiscalDocSign":U then do :
     5869                           vCHFiscalDocSign = buf_temp-temp.field-value no-error .
     5870                       end .
     5871                       when "CHFiscalDocNumber":U then do :
     5872                           vCHFiscalDocNumber = integer(buf_temp-temp.field-value) no-error .
     5873                       end .
     5874                       when "CHMgrKey":U then do :
     5875                           vCHMgrKey = buf_temp-temp.field-value no-error .
     5876                       end .
     5877                       when "CHFlag1":U then do:
     5878                           vCHFlag1 = buf_temp-temp.field-value no-error .
     5879                       end.
     5880                       otherwise do:
     5881                           error-status:error = no.
     5882                       end.
     5883                   END CASE.
     5884                   if error-status:error then do:
     5885                       if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     5886                   end.
     5887               END.
     5888           end.
     5889           else do:
     5890               assign
     5891                   exist = yes
     5892                   mc-exist = yes
     5893                   .
     5894               return.
     5895           end.
     5896           if cas-shft then . else assign
     5897               shift-date_      = chk-date_
     5898               shift-num_       = 0
     5899               shift-open-time_ = 0
     5900               .
     5901           find first ub.cash-desk no-lock where
     5902               ub.cash-desk.cash-num = pay-desk_
     5903               AND ub.cash-desk.obj-code = p-obj-code no-error.
     5904           If not available  ub.cash-desk
     5905           then do:
     5906               assign
     5907                   p-view-log = yes
     5908                   .
     5909               run write-log-and-file in p-log-handle (
     5910                   input 1
     5911                   , input log-file-name
     5912                   , input 1
     5913                   , input substitute( "!!!При обработке файла произошла ошибка. На объекте &1 нет кассы с номером &2", p-obj-code, pay-desk_
     5914                   )
     5915                   ).
     5916               undo, return .
     5917           end.
     5918           If available  ub.cash-desk and  ub.cash-desk.pos-type = p-pos-type then.
     5919           else do:
     5920               p-pos-type =  ub.cash-desk.pos-type.
     5921               run get-ibm-parameters in this-procedure no-error.
     5922               if error-status:error then do:
     5923                   assign
     5924                       p-view-log = yes
     5925                       .
     5926                   run write-log-and-file in p-log-handle (
     5927                       input 1
     5928                       , input log-file-name
     5929                       , input 1
     5930                       , input substitute( "!!!При обработке файла &1 произошла ошибка при получении значений настроечных параметров"
     5931                       )
     5932                       ).
     5933                   undo, return .
     5934               end.
     5935           end.
     5936           find first temp-cash-desk where
     5937               temp-cash-desk.cash-num = (if p-pos-type = 'Autotank':U then 0 else pay-desk_) no-error.
     5938           if not available temp-cash-desk then do:
     5939               if p-pos-type = 'MAGIA-XML':U then
     5940                   run get-last-check-date-time in this-procedure (
     5941                       input g#db-num
     5942                       ,input p-obj-code
     5943                       ,input p-pos-type
     5944                       ,input pay-desk_
     5945                       ,output v-last-date
     5946                       ,output v-last-time) no-error.
     5947               else
     5948                   run get-last-check-params in this-procedure (
     5949                   input g#db-num
     5950                   ,input p-obj-code
     5951                   ,input p-pos-type
     5952                   ,input (if p-pos-type = 'Autotank':U then 0 else pay-desk_)
     5953                       ,output v-last-date
     5954                       ,output v-last-time
     5955                       ,output v-last-shift-num
     5956                       ,output v-last-z-count
     5957                       ,output v-last-chk-num
     5958                       ) no-error.
     5959               create temp-cash-desk.
     5960               assign
     5961                   temp-cash-desk.cash-num = (if p-pos-type = 'Autotank':U then 0 else pay-desk_)
     5962                   temp-cash-desk.last-date = v-last-date
     5963                   temp-cash-desk.last-time = v-last-time
     5964                   temp-cash-desk.last-shift-num = v-last-shift-num
     5965                   temp-cash-desk.last-z-count = v-last-z-count
     5966                   temp-cash-desk.last-chk-num = v-last-chk-num
     5967                   .
     5968           end.
     5969           assign
     5970               v-old = string(year(temp-cash-desk.last-date), "9999") +
     5971               string(month(temp-cash-desk.last-date), "99") +
     5972               string(day(temp-cash-desk.last-date), "99") +
     5973               string(temp-cash-desk.last-time, "HH:MM:SS") +
     5974               string(temp-cash-desk.last-shift-num, "99") +
     5975               string(temp-cash-desk.last-z-count, "99999") +
     5976               string(temp-cash-desk.last-chk-num, "-999999999")
     5977               .
     5978           assign
     5979               v-eff-date = if p-pos-type = 'Autotank':U then spool-date_ else chk-date_
     5980               v-eff-time = if p-pos-type = 'Autotank':U then spool-time_ else chk-time_
     5981               .
     5982           define variable vTimestring as character no-undo.
     5983           Vtimestring = string(v-eff-time, "HH:MM:SS").
     5984           entry(1,Vtimestring,":") = string(int(entry(1,Vtimestring,":")) - 1,"99") no-error.
     5985           if    vTimestring begins "?"
     5986           or error-status:error
     5987           then do:
     5988               entry(1,Vtimestring,":") = "00".
     5989               v-eff-date = v-eff-date - 1.
     5990           end.
     5991           else
     5992               v-eff-time = v-eff-time - 1 * 60 * 60.
     5993           assign
     5994               v-new = string(year(v-eff-date), "9999") +
     5995               string(month(v-eff-date), "99") +
     5996               string(day(v-eff-date), "99") +
     5997               Vtimestring +
     5998               string(integer(shift-name_), "99") +
     5999               string(z-num_, "99999") +
     6000               string(chk-num_, "-999999999")
     6001               .
     6002           if v-new > v-old then do:
     6003               assign
     6004                   temp-cash-desk.last-date       = v-eff-date
     6005                   temp-cash-desk.last-time       = v-eff-time
     6006                   temp-cash-desk.last-shift-num  = integer(shift-name_)
     6007                   temp-cash-desk.last-z-count    = z-num_
     6008                   temp-cash-desk.last-chk-num    = chk-num_
     6009                   .
     6010           end.
     6011           run  proc-shift-open.
     6012           if can-do("13":U,  gbl-type) then do:
     6013               run proc-13 in this-procedure no-error .
     6014           end.
     6015           if get-chkc_context.is-wth and can-do("2,3,4,5,7":U ,  gbl-type) then do:
     6016               assign
     6017                   mc-for-chk-type = ""
     6018                   mc-exist = yes
     6019                   .
     6020               FIND  ub.chk-doc where
     6021                   ub.chk-doc.obj-type = shop-type and
     6022                   ub.chk-doc.obj-code = shop-code and
     6023                   ub.chk-doc.chk-date = chk-date_ and
     6024                   ub.chk-doc.pay-desk = pay-desk_ and
     6025                   ub.chk-doc.chk-time = chk-time_ and
     6026                   ub.chk-doc.chk-num  = chk-num_ and
     6027                   ub.chk-doc.sales-man = sales-man_
     6028                   NO-LOCK NO-ERROR.
     6029               IF NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc then do:
     6030                   assign
     6031                       mc-exist = NO .
     6032                   CREATE buf_chk-doc.
     6033                   assign
     6034                       buf_chk-doc.chk-type = 0
     6035                       buf_chk-doc.office = ?
     6036                       lng = 0
     6037                       lnp = 0
     6038                       lnc = 0
     6039                       var-discnt-id = 0
     6040                       buf_chk-doc.chk-id = v-id
     6041                       buf_chk-doc.correct = yes
     6042                       buf_chk-doc.obj-code = shop-code
     6043                       buf_chk-doc.obj-type = shop-type
     6044                       buf_chk-doc.doc-code = (if get-chkc_context.db-num = 0
     6045                       then string(next-value(s-chk, ub ))
     6046                       else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     6047                       buf_chk-doc.chk-num = chk-num_
     6048                       buf_chk-doc.chk-date = chk-date_
     6049                       buf_chk-doc.chk-time = chk-time_
     6050                       buf_chk-doc.sales-man = (if sales-man_ = ? then 0 else sales-man_)
     6051                       buf_chk-doc.pay-desk = pay-desk_
     6052                       buf_chk-doc.cashier = cashier_
     6053                       buf_chk-doc.src-shift-date = shift-date_
     6054                       shift-name_ = if cas-shft then string(shift-num_) else '':U
     6055                       shift-num_ = if get-chkc_context.shift-on then 0 else shift-num_
     6056                       buf_chk-doc.shift-num = shift-num_
     6057                       buf_chk-doc.src-shift-name = shift-name_
     6058                       buf_chk-doc.shift-name = shift-name_
     6059                       buf_chk-doc.z-number = z-num_
     6060                       buf_chk-doc.chk-type = int(gbl-type)
     6061                       buf_chk-doc.prev-chk-type = int(prev-gbl-type)
     6062                       buf_chk-doc.cash-rate = cash-rate_
     6063                       buf_chk-doc.cash-scale = 1
     6064                       buf_chk-doc.doc-num = doc-num_
