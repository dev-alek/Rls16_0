     6316                       assign
     6317                           buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6318                           buf_chk-doc-attr.attr-code  = "CHFlag1S"
     6319                           buf_chk-doc-attr.attr-value = 'no'
     6320                           .
     6321                   end.
     6322                   if vCHNumberKKT ne ""
     6323                   then do:
     6324                       create buf_chk-doc-attr.
     6325                       assign
     6326                           buf_chk-doc-attr.doc-code   = buf_chk-doc.doc-code
     6327                           buf_chk-doc-attr.attr-code  = "CHNumberKKT"
     6328                           buf_chk-doc-attr.attr-value = vCHNumberKKT
     6329                           .
