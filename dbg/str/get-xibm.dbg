     3014   procedure chkdocat-value :
     3015    do
     3016     on error undo, return error
     3017     :
     3018       define input  parameter p-doc-code like ub.chk-doc-attr.doc-code   no-undo .
     3019       define input  parameter p-code     like ub.chk-doc-attr.attr-code  no-undo .
     3020       define output parameter p-value    like ub.chk-doc-attr.attr-value no-undo .
     3021       define output parameter p-type     as character no-undo .
     3022       define buffer buf_chk-doc-attr for ub.chk-doc-attr .
     3023       define variable v-format         as character no-undo .
     3024       define variable v-label          as character no-undo .
     3025       define variable v-user-can-edit  as logical   no-undo .
     3026       define variable v-output-display as logical   no-undo .
     3027       define variable v-other          as character no-undo .
     3028       run chkdocat-name in this-procedure
     3029         (input  p-code
     3030         ,output p-type
     3031         ,output v-format
     3032         ,output v-label
     3033         ,output v-user-can-edit
     3034         ,output v-output-display
     3035         ,output v-other
     3036         ) no-error .
     3037       if error-status :error then do:
     3038         undo, return error return-value .
     3039       end.
     3040       find first buf_chk-doc-attr no-lock where
     3041                  buf_chk-doc-attr.doc-code  = p-doc-code AND
     3042                  buf_chk-doc-attr.attr-code = p-code
     3043         no-error .
     3044       if avail buf_chk-doc-attr then do:
     3045         assign
     3046           p-value =  buf_chk-doc-attr.attr-value
     3047         .
     3048       end.
     3049       else do:
     3050         assign
     3051           p-value = if p-type = 'L':U then "no":U else ""
     3052         .
     3053       end.
     3054     end.
     3055   end procedure.
     3056   procedure chkdocat-write :
     3057     do
     3058     on error undo, return error
     3059     :
     3060       define input parameter p-doc-code like ub.chk-doc-attr.doc-code   no-undo .
     3061       define input parameter p-code     like ub.chk-doc-attr.attr-code  no-undo .
     3062       define input parameter p-value    like ub.chk-doc-attr.attr-value no-undo .
     3063       define buffer buf_chk-doc-attr for ub.chk-doc-attr .
     3064       define buffer lock_chk-doc-attr for ub.chk-doc-attr .
     3065       define variable v-type           as character no-undo .
     3066       define variable v-format         as character no-undo .
     3067       define variable v-label          as character no-undo .
     3068       define variable v-user-can-edit  as logical   no-undo .
     3069       define variable v-output-display as logical   no-undo .
     3070       define variable v-other          as character no-undo .
     3071       run chkdocat-name in this-procedure
     3072         (input  p-code
     3073         ,output v-type
     3074         ,output v-format
     3075         ,output v-label
     3076         ,output v-user-can-edit
     3077         ,output v-output-display
     3078         ,output v-other
     3079         ) no-error .
     3080       if error-status :error then do:
     3081         undo, return error return-value .
     3082       end.
     3083       find first buf_chk-doc-attr exclusive-lock where
     3084                  buf_chk-doc-attr.doc-code  = p-doc-code AND
     3085                  buf_chk-doc-attr.attr-code = p-code no-error .
     3086       if not available buf_chk-doc-attr then do:
     3087         create buf_chk-doc-attr .
     3088         assign
     3089           buf_chk-doc-attr.doc-code  = p-doc-code
     3090           buf_chk-doc-attr.attr-code = p-code
     3091           buf_chk-doc-attr.attr-value = p-value no-error
     3092         .
     3093       end.
     3094       ELSE
     3095       ASSIGN
     3096       buf_chk-doc-attr.attr-value = p-value no-error.
     3097     end.
     3098   end procedure.
     3099   procedure chkdocat-exist :
