     3171   define stream stmXMLOut.
     3172   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3173   define variable v-xml-file-name     as character            no-undo.
     3174   define variable v-xml-file-name-path as character            no-undo.
     3175   define variable v-log-file-name     as character            no-undo.
     3176   define variable v-locked            as logical              no-undo.
     3177   define variable v-log-string        as character            no-undo.
     3178   define variable v-oper-num          as integer              no-undo.
     3179   define variable v-obj-list          as character            no-undo.
     3180   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3181   DEF VAR intRep      AS INT NO-UNDO.
     3182   define variable hEDT             AS HANDLE NO-UNDO.
     3183   define variable hCNT             AS HANDLE NO-UNDO.
     3184   procedure xml-cd-write-header:
     3185   do
     3186   on error undo, return error
     3187   :
     3188   define input parameter p-xml-file-name       as character    no-undo.
     3189   define input parameter p-xml-file-name-path  as character    no-undo.
     3190   define input parameter p-doc-name            as character    no-undo.
     3191   define input parameter p-version             as character    no-undo.
     3192   define input parameter p-obj-list            as character    no-undo.
     3193   define input parameter p-correspondent       as character    no-undo .
     3194   define input parameter p-write-header        as logical      no-undo .
     3195   define variable OS-time as character no-undo .
     3196   define variable id as character no-undo .
     3197   define buffer buf_db for ub.db.
     3198   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3199   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3200   assign
     3201   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3202   .
     3203   run bgelib-tag-open in this-procedure (
     3204                                        1
     3205                                       ,p-doc-name
     3206                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3207                                         ).
     3208   if p-write-header then do:
     3209     run bgelib-tag-open(2, "Header","").
     3210     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3211     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3212     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3213     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3214     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3215     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3216     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3217     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3218     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3219     run bgelib-tag-close( 2, "Header" ).
     3220   end.
     3221   output stream stmXMLOut close.
     3222   end.
     3223   end procedure.
     3224   procedure xml-cd-write-footer:
     3225   do
     3226   on error undo, return error
     3227   :
     3228   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3229   define input parameter p-xml-file-name as character    no-undo.
     3230   define input parameter p-doc-name      as character    no-undo .
     3231   define variable v-error-num     as integer           no-undo.
     3232   define variable v-md5-signature as character no-undo .
     3233   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3234   run bgelib-tag-close( 0, p-doc-name ).
     3235   put stream stmXMLOut unformatted skip.
     3236   output stream stmXMLOut close.
     3237   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3238   if v-error-num > 0
     3239   then do:
     3240      return error.
     3241   end.
     3242   if opsys = "unix"
     3243   then do:
     3244       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3245   end.
     3246   end.
     3247   end procedure.
     3248   procedure xml-cd-filename :
     3249   do
     3250   on error undo, return error
     3251   :
     3252   define input parameter  p-out               as character no-undo .
     3253   define output parameter p-xml-file-name     as character    no-undo.
     3254   define output parameter p-xml-file-name-path   as character    no-undo.
     3255   define output parameter p-log-file-name     as character    no-undo.
     3256   define output parameter p-locked            as logical      no-undo.
     3257   define variable v-out as character     no-undo.
     3258   define variable loc#log as logical no-undo .
     3259   define variable BadFlag as logical no-undo .
     3260   define variable fq as integer no-undo .
     3261   define variable v-remote as character no-undo .
     3262   assign
     3263   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3264   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3265   p-log-file-name = p-out + "actions.log"
     3266   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3267   .
     3268   end.
     3269   end procedure.
     3270   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3271   define variable v-date-str as character no-undo .
     3272   assign
     3273   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3274                string(Month(p-date), "99":U) + "-":U +
     3275                string(DAY(p-date), "99":U).
     3276   return v-date-str.
     3277   END FUNCTION.
     3278   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3279   define variable v-date-str as character no-undo .
     3280   assign
     3281   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3282                string(Month(p-date), "99":U) + "-":U +
     3283                string(DAY(p-date), "99":U) + chr(32) +
     3284                string(p-time, "HH:MM:SS").
     3285   return v-date-str.
     3286   END FUNCTION.
     3287   function string-to-date returns date ( input p-string  as character):
     3288     define variable v-date as date no-undo .
     3289     assign
     3290     v-date = date(integer(substring(p-string, 4, 2))
     3291                   ,integer(substring(p-string, 1, 2))
     3292                   ,integer(substring(p-string, 7, 4))
     3293                  ) no-error .
     3294     if error-status:error then return ?.
     3295     return v-date.
     3296   END FUNCTION.
     3297   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3298   define variable v-time as integer no-undo init ?.
     3299   define variable v-dop1 as character no-undo .
     3300   define variable v-dop2 as character no-undo .
     3301   assign
     3302   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3303   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3304   no-error .
     3305   if error-status:error then return ?.
     3306   assign
     3307   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3308             integer(entry(2, v-dop2, ";":U)) * 60 +
     3309             integer(entry(3, v-dop2, ";":U)) no-error .
     3310   return v-time.
     3311   END FUNCTION.
     3312   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3313   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     3314   def var vl_bin as char no-undo init "".
     3315   if vl_int < 0 OR vl_int = ? then return ?.
     3316   do while vl_int > 0:
     3317     assign
     3318     vl_bin = (if vl_int modulo 2 = 0
     3319                 then "0":U
     3320                 else "1":U) + vl_bin
     3321     vl_int = truncate(vl_int / 2,0).
     3322   end.
     3323   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     3324   END FUNCTION.
     3325   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     3326                                    input vl_binm as character):
     3327   DEFINE VARIABLE vl_bin as character no-undo.
     3328   DEFINE VARIABLE ii as integer no-undo.
     3329   DEFINE VARIABLE ii-len as integer no-undo.
     3330   DEFINE VARIABLE ii-lenm as integer no-undo.
     3331   DEFINE VARIABLE mchar as character no-undo.
     3332   DEFINE VARIABLE ichar as character no-undo.
     3333   if vl_binm = ? then return ?.
     3334   vl_bin = CIntBinS(vl_int).
     3335   if vl_bin = ? then return ?.
     3336   assign
     3337   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     3338   ii-lenm = LENGTH(vl_binm)
     3339   ii-len = LENGTH(vl_bin) - ii-lenm
     3340   .
     3341   if II-LENM > 32 THEN RETURN ?.
     3342   DO II = 1 to II-LENm:
     3343     assign
     3344     mchar = SUBSTR(vl_binm, ii, 1)
     3345     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     3346     .
     3347     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     3348     IF ichar <> mchar AND mchar <> "X":U then return no.
     3349   END.
     3350   return yes.
     3351   END FUNCTION.
