     1971                       then do:
     1972                           assign
     1973                               p-out-string = p-out-string + " ":U
     1974                           .
     1975                       end.
     1976                       when chr(10)
     1977                       then do:
     1978                           assign
     1979                               p-out-string = p-out-string + " ":U
     1980                           .
