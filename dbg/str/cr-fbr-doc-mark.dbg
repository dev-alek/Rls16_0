      145   procedure vss-get-info :
      146     define output parameter p-vss-revision    like vss-revision    no-undo .
      147     define output parameter p-vss-author      like vss-author      no-undo .
      148     define output parameter p-vss-date        like vss-date        no-undo .
      149     define output parameter p-vss-workfile    like vss-workfile    no-undo .
