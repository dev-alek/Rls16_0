     7781   procedure grp-obj-notcorr-value :
     7782   do
     7783   on error undo, return error
     7784   :
     7785   define input parameter p-node-code             as integer      no-undo.
     7786   define input parameter p-obj-type              as character    no-undo.
     7787   define input parameter p-obj-code              as integer      no-undo.
     7788   define output parameter p-notcorr              as character    no-undo init ?.
     7789   define output parameter p-range-notcorr     as integer      no-undo.
     7790   define output parameter p-exists-notcorr    as logical      no-undo.
     7791   define variable v-host-code as integer      no-undo.
     7792   DEFINE VARIABLE v-found as logical no-undo .
     7793   DEFINE VARIABLE v-exists as logical no-undo .
     7794   DEFINE VARIABLE v-range as integer no-undo .
     7795   DEFINE VARIABLE jj as integer no-undo .
     7796   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7797   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7798   define buffer buf_gds-grp for ub.gds-grp.
     7799   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7800   find first buf_gds-grp no-lock where
     7801              buf_gds-grp.node-code = p-node-code no-error .
     7802   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7803     message
     7804       vss-workfile vss-revision vss-description
     7805       skip "Не удалось найти группу товаров с кодом" p-node-code
     7806       view-as alert-box error .
     7807     undo, return error .
     7808   end.
     7809   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7811     (input  p-obj-type
     7812     ,input  p-obj-code
     7813     ,output v-host-code
     7814     ) no-error .
     7815   if error-status :error
     7816   then do:
     7817       message
     7818         vss-workfile vss-revision vss-description
     7819         skip "Не удалось найти фирму объекта"
     7820         skip p-obj-type p-obj-code
     7821         skip return-value
     7822         skip trim(error-status :get-message(1))
     7823       view-as alert-box error.
     7824       undo, return error .
     7825   end.
     7826   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7827   do while v-found = no and jj < 2:
     7828     if v-range <> 3 then do:
     7829       find first buf_gds-grp-obj no-lock
     7830           where buf_gds-grp-obj.node-code = p-node-code
     7831             and buf_gds-grp-obj.host-code = v-host-code
     7832             and buf_gds-grp-obj.obj-type  = p-obj-type
     7833             and buf_gds-grp-obj.obj-code  = p-obj-code
     7834       no-error .
     7835     end.
     7836     if v-range = 3 or not available buf_gds-grp-obj
     7837     then do:
     7838        if v-range <> 2 then do:
     7839           find first buf_gds-grp-obj no-lock
     7840               where buf_gds-grp-obj.node-code = p-node-code
     7841                 and buf_gds-grp-obj.host-code = v-host-code
     7842                 and buf_gds-grp-obj.obj-type  = ""
     7843                 and buf_gds-grp-obj.obj-code  = 0
     7844           no-error .
     7845         end.
     7846         if v-range = 2 or not available buf_gds-grp-obj
     7847         then do:
     7848             if v-range <> 1 then do:
     7849               find first buf_gds-grp-obj no-lock
     7850                   where buf_gds-grp-obj.node-code = p-node-code
     7851                   and buf_gds-grp-obj.host-code = 0
     7852                   and buf_gds-grp-obj.obj-type  = ""
     7853                   and buf_gds-grp-obj.obj-code  = 0
     7854               no-error .
     7855             end.
     7856             if v-range = 1 or not available buf_gds-grp-obj
     7857             then do:
     7858                 assign
     7859                     v-exists = no
     7860                 .
     7861             end.
     7862             else do:
     7863                 assign
     7864                     v-exists = yes
     7865                     v-range = 1
     7866                 .
     7867             end.
     7868         end.
     7869         else do:
     7870             assign
     7871                 v-exists = yes
     7872                 v-range  = 2
     7873             .
     7874         end.
     7875     end.
     7876     else do:
     7877         assign
     7878             v-exists = yes
     7879             v-range  = 3
     7880         .
     7881     end.
     7882     if available buf_gds-grp-obj
     7883     then do:
     7884       find first buf_gds-grp-obj-attr no-lock
     7885         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7886           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7887           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7888           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7889           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7890         no-error .
     7891       if available buf_gds-grp-obj-attr then do:
     7892         assign
     7893           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7894         .
     7895       end.
     7896       else do:
     7897         assign
     7898           v-notcorr-value = ?
     7899         .
     7900       end.
     7901       assign
     7902       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7903                           then yes
     7904                           else p-exists-notcorr)
     7905       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7906                         then v-range
     7907                         else p-range-notcorr
     7908       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7909                         then v-notcorr-value
     7910                         else p-notcorr
     7911       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7912       jj = jj + 1
     7913       .
     7914     end.
     7915     else do:
     7916       assign
     7917       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7918       jj = jj + 1
     7919       .
     7920     end.
     7921   end.
     7922   end.
     7923   end procedure.
     7924   define buffer buf_goods for ub.goods .
     7925   define buffer buf_fbr-doc for ub.fbr-doc .
     7926   define buffer buf_fbr-line for ub.fbr-line .
     7927   define buffer buf_marking-lines for ub.marking-lines .
     7928   define buffer buf_marking for ub.marking .
     7929   define variable v-fbr-doc-code            as character no-undo .
     7930   define variable v-fbr-doc-recid           as recid no-undo .
     7931   define variable v-same-good               as logical   no-undo.
     7932   define variable v-same-good-old-qnty      as decimal   no-undo.
     7933   define variable v-reserved                as logical   no-undo.
     7934   do :
     7935   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7936     run mainmenu_getcntxt in parparentproc
     7937       (output v-cntxt-db-num
     7938       ,output v-cntxt-userid
     7939       ,output v-cntxt-level
     7940       ,output v-cntxt-host-code-obj
     7941       ,output v-cntxt-obj-type
     7942       ,output v-cntxt-obj-code
     7943       ,output v-cntxt-db-num-obj
     7944       ,output v-cntxt-is-admin
     7945       ) .
     7946     run fbrlib_create-fbr-doc ( input v-cntxt-obj-type
     7947                                ,input v-cntxt-obj-code
     7948                                ,input v-cntxt-userid
     7949                                ,output v-fbr-doc-code
     7950                                ,output v-fbr-doc-recid)
     7951     no-error.
     7952     if error-status:error then
     7953     do:
     7954       undo, return error substitute("Ошибка при создании нового документа производства:&1&2&1&3"
     7955           , chr(10)
     7956           , error-status:get-message(1)
     7957           , return-value ).
     7958     end.
     7959     for each tt-fbr-line,
     7960     first buf_goods no-lock where buf_goods.gds-code = tt-fbr-line.ingr-gds-code
     7961     :
     7962       run create-initial-temp-goods in this-procedure (
     7963           input v-fbr-doc-code
     7964         , input buf_goods.artic
     7965         , input buf_goods.prod-type
     7966         , input buf_goods.prod-code
     7967         , input 'при':U
     7968         , input tt-fbr-line.recipe-type
     7969         , input tt-fbr-line.recipe-code
     7970         , input tt-fbr-line.qnty
     7971         , output v-same-good
     7972         , output v-same-good-old-qnty
     7973       ).
     7974       run calc-not-calculated-goods in this-procedure (
     7975           input parparentproc
     7976         , input p-fbrhist-handle
     7977         , input v-fbr-doc-code
     7978         , input v-same-good
     7979         , input v-same-good-old-qnty
     7980         , input no
     7981         , input no
     7982         , input v-cntxt-obj-type
     7983         , input v-cntxt-obj-code
     7984         , input yes
     7985         , input yes
     7986       ).
     7987     end .
     7988     find first buf_fbr-doc no-lock where recid(buf_fbr-doc) = v-fbr-doc-recid .
     7989     for each buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     7990                                     and not buf_fbr-line.is-comp,
     7991     first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     7992                               and buf_goods.prod-type = buf_fbr-line.prod-type
     7993                               and buf_goods.prod-code = buf_fbr-line.prod-code
     7994     :
     7995       for each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code :
     7996         create buf_marking-lines .
     7997         assign
     7998           buf_marking-lines.mark      = tt-marking-lines.mark
     7999           buf_marking-lines.obj-type  = tt-marking-lines.obj-type
     8000           buf_marking-lines.obj-code  = tt-marking-lines.obj-code
     8001           buf_marking-lines.gds-code  = tt-marking-lines.gds-code
     8002           buf_marking-lines.doc-level = tt-marking-lines.doc-level
     8003           buf_marking-lines.in-code   = "manufacturing"
     8004           buf_marking-lines.out-code  = buf_fbr-doc.doc-code
     8005           buf_marking-lines.part-code = buf_fbr-line.recipe-code
     8006           buf_marking-lines.prt-code  = 0
     8007         .
     8008       end .
     8009     end .
     8010     run str/fbr-rsrv.p (
     8011          input parparentproc
     8012        , input ?
     8013        , input v-fbr-doc-recid
     8014        , input yes
     8015        , input yes
     8016        , input yes
     8017        , input no
     8018        , output v-reserved
     8019        ) no-error.
     8020     if error-status :error
     8021     or v-reserved = no
     8022     then do:
     8023       message "Ошибка при резервировании товаров для производства. Документ не закрыт!" view-as alert-box .
     8024       return .
     8025     end .
     8026     run str/fbr-fact.p ( input parparentproc
     8027                        , input v-fbr-doc-recid
     8028                        , input no
     8029                        ) no-error.
     8030     if error-status :error
     8031     then do:
     8032       message "Не удалось закрыть документ производства!" view-as alert-box .
     8033       return .
     8034     end .
     8035   end .
