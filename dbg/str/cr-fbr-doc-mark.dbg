      139   define variable vss-revision    as character no-undo initial "$Revision$":U .
      140   define variable vss-author      as character no-undo initial "$Author$":U .
      141   define variable vss-date        as character no-undo initial "$Date$":U .
      142   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
