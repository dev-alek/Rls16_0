     5214           end case .
     5215           if v-have-rights = no
     5216           then do:
     5217               message
     5218                   "Недостаточно прав для производства."
     5219                   skip(1) "Обратитесь к администратору."
     5220                   skip(1) return-value
     5221               view-as alert-box information.
     5222               run clear-temp-tables in this-procedure .
     5223               undo, return error.
     5224           end.
     5225           find first buf_fbr-line no-lock
     5226                where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     5227                  and buf_fbr-line.is-comp     = yes
     5228                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5229           no-error.
     5230           if available buf_fbr-line
     5231           then do:
     5232               define buffer buf_change_fbr-line      for ub.fbr-line.
     5233               run writelog in this-procedure ( log-file-name, 3, "В документе уже есть выбранный рецепт." ).
     5234               if buf_start_temp_goods-qnty.need-qnty = ?
     5235               and v-is-manual-input = yes
     5236               then do:
     5237                   define variable v-old-fact-qnty  as decimal       no-undo.
     5238                   define variable v-old-price-sale as decimal       no-undo.
     5239                   assign
     5240                       v-old-fact-qnty  = buf_fbr-line.fact-qnty
     5241                       v-old-price-sale = buf_fbr-line.price-sale
     5242                   .
     5243                   run str/fbr-line.w (
     5244                         input p-fbrhist-handle
     5245                       , input buf_fbr-doc.status_
     5246                       , input p-fbr-doc-doc-code
     5247                       , input recid( buf_fbr-line )
     5248                       , input ?
     5249                       , output v-cancel
     5250                   ).
     5251                   if error-status :error
     5252                   or v-cancel = yes
     5253                   then do:
     5254                       find first buf_change_fbr-line exclusive-lock
     5255                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5256                              and buf_change_fbr-line.is-comp     = yes
     5257                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5258                       .
     5259                       message
     5260                                vss-workfile vss-revision vss-description
     5261                           skip "Ошибка изменения строки."
     5262                           skip return-value
     5263                           skip trim(error-status :get-message(1))
     5264                                trim(error-status :get-message(2))
     5265                                trim(error-status :get-message(3))
     5266                           skip buf_change_fbr-line.fact-qnty
     5267                       view-as alert-box error.
     5268                       assign
     5269                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5270                           buf_change_fbr-line.price-sale = v-old-price-sale
     5271                       .
     5272                       run clear-temp-tables in this-procedure.
     5273                       return.
     5274                   end.
     5275                   if buf_fbr-line.fact-qnty <= v-old-fact-qnty
     5276                   then do:
     5277                       define variable v-gds-name    as character    no-undo.
     5278   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     5280     (input  buf_fbr-line.artic
     5281     ,input  buf_fbr-line.prod-type
     5282     ,input  buf_fbr-line.prod-code
     5283     ,output v-gds-name
     5284     )  .
     5285                       message
     5286                                "Для производства товаров документа необходимо"
     5287                           skip "большее количество товара, чем было добавлено."
     5288                           skip "Количество товара в документе будет восстановлено."
     5289                           skip(1)
     5290                           skip "Товар: " buf_fbr-line.artic v-gds-name
     5291                           skip "Количество в строке документа производства:" v-old-fact-qnty
     5292                           skip "Новое количество:" buf_fbr-line.fact-qnty
     5293                       view-as alert-box information
     5294                       title "Изменение строки документа производства".
     5295                       find first buf_change_fbr-line exclusive-lock
     5296                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5297                              and buf_change_fbr-line.is-comp     = yes
     5298                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5299                       .
     5300                       assign
     5301                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5302                           buf_change_fbr-line.price-sale = v-old-price-sale
     5303                       .
     5304                       delete buf_start_temp_goods-qnty.
     5305                   end.
     5306                   else do:
     5307                       find first buf_change_fbr-line exclusive-lock
     5308                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5309                              and buf_change_fbr-line.is-comp     = yes
     5310                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5311                       .
     5312                       assign
     5313                           buf_start_temp_goods-qnty.need-qnty  = buf_fbr-line.fact-qnty
     5314                           buf_start_temp_goods-qnty.calculated = no
     5315                           buf_change_fbr-line.fact-qnty     = 0
     5316                       .
     5317                   end.
     5318                   run test-temp-tables in this-procedure ( "Товар добавлять не надо - параметр fbr-frcp=yes, но введенное в диалоге количество меньше необходимого." ).
     5319                   find first buf_start_temp_goods-qnty
     5320                        where buf_start_temp_goods-qnty.calculated = no
     5321                   no-error.
     5322                   next calc-not-calculated-goods.
     5323               end.
     5324               else do:
     5325                   find first buf_change_fbr-line exclusive-lock
     5326                        where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5327                          and buf_change_fbr-line.is-comp     = yes
     5328                          and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5329                   .
     5330                   assign
     5331                       buf_start_temp_goods-qnty.need-qnty  = buf_start_temp_goods-qnty.need-qnty + buf_fbr-line.fact-qnty
     5332                       buf_change_fbr-line.fact-qnty        = buf_start_temp_goods-qnty.need-qnty
     5333                   .
     5334                   if buf_start_temp_goods-qnty.recipe-code <> "":U
     5335                   then do:
     5336                       assign
     5337                           buf_start_temp_goods-qnty.calculated = no
     5338                       .
     5339                   end.
     5340               end.
     5341               run writelog in this-procedure ( log-file-name, 3, substitute( "Изменена рассчитанная строка документа. Новое количество &1", buf_fbr-line.fact-qnty ) ).
     5342           end.
     5343           run fbrlib-get-trn-type in this-procedure (
     5344                 input buf_fbr-recipe.recipe-code
     5345               , input recid( buf_goods )
     5346               , input ( if buf_start_temp_goods-qnty.trn-type = ?
     5347                         then ?
     5348                         else ( if buf_start_temp_goods-qnty.trn-type = 'при':U
     5349                                then yes
     5350                                else no ) )
     5351               , output v-is-comp
     5352               , output v-trn-type
     5353           ).
     5354           assign
     5355               buf_start_temp_goods-qnty.trn-type = v-trn-type
     5356           .
     5357           run str/fbr-crln.p (
     5358                 input p-mainmenu-handle
     5359               , input recid( buf_fbr-doc )
     5360               , input recid( buf_goods )
     5361               , input buf_fbr-recipe.recipe-code
     5362               , input v-trn-type
     5363               , input v-is-comp
     5364               , input yes
     5365               , input buf_fbr-doc.obj-type
     5366               , input buf_fbr-doc.obj-code
     5367               , output v-fbr-line-recid
     5368           ).
     5369           if buf_start_temp_goods-qnty.need-qnty = ?
     5370           then do:
     5371               find first tt-marking-lines no-error .
     5372               if available tt-marking-lines
     5373               then do :
     5374                 assign v-mark-qnty = 0 .
     5375                 for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5376                 first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5377                                           and buf_goods.prod-type = buf_fbr-line.prod-type
     5378                                           and buf_goods.prod-code = buf_fbr-line.prod-code,
     5379                 each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5380                 :
     5381                   assign v-mark-qnty = v-mark-qnty + tt-marking-lines.box-qnty .
     5382                 end .
     5383               end .
     5384               run str/fbr-line.w (
     5385                     input p-fbrhist-handle
     5386                   , input buf_fbr-doc.status_
     5387                   , input p-fbr-doc-doc-code
     5388                   , input v-fbr-line-recid
     5389                   , input v-mark-qnty
     5390                   , output v-cancel
     5391               ) no-error.
     5392               if error-status :error
     5393               or v-cancel = yes
     5394               then do:
     5395                   find first buf_fbr-line exclusive-lock
     5396                        where recid( buf_fbr-line ) = v-fbr-line-recid
     5397                   .
     5398                   for first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5399                                             and buf_goods.prod-type = buf_fbr-line.prod-type
     5400                                             and buf_goods.prod-code = buf_fbr-line.prod-code,
     5401                   each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5402                   :
     5403                     for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5404                       assign
     5405                         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5406                       .
     5407                     end .
     5408                   end .
     5409                   delete buf_fbr-line.
     5410                   run clear-temp-tables in this-procedure.
     5411                   return.
     5412               end.
     5413               for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5414               first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5415                                         and buf_goods.prod-type = buf_fbr-line.prod-type
     5416                                         and buf_goods.prod-code = buf_fbr-line.prod-code,
     5417               each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5418               :
     5419                 create buf_marking-lines .
     5420                 assign
     5421                   buf_marking-lines.mark      = tt-marking-lines.mark
     5422                   buf_marking-lines.obj-type  = buf_fbr-doc.obj-type
     5423                   buf_marking-lines.obj-code  = buf_fbr-doc.obj-code
     5424                   buf_marking-lines.gds-code  = buf_goods.gds-code
     5425                   buf_marking-lines.in-code   = "manufacturing"
     5426                   buf_marking-lines.out-code  = buf_fbr-line.doc-code
     5427                   buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5428                   buf_marking-lines.prt-code  = 0
     5429                   buf_marking-lines.doc-level = 1
     5430                 .
     5431               end .
     5432               find first buf_fbr-line exclusive-lock
     5433                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5434               .
     5435               if p-same-good = yes
     5436               then do:
     5437                   if p-autofbr = yes
     5438                   then do:
     5439                       assign
     5440                           v-yesno = yes
     5441                       .
     5442                   end.
     5443                   else do:
     5444                       message
     5445                                "Товар уже есть в документе."
     5446                           skip "Вы можете добавить введенное количество в строку документа,"
     5447                           skip "изменить количество в документе на введенное"
     5448                           skip "или отменить добавление товара, оставив рецепт без изменений"
     5449                           skip(1)
     5450                           skip "Артикул товара:        " buf_start_temp_goods-qnty.artic
     5451                           skip "Количество в документе:" p-same-good-old-qnty
     5452                           skip(1)
     5453                           skip "Добавить в строку?"
     5454                       view-as alert-box question
     5455                       buttons yes-no-cancel
     5456                       title "Добавление товара"
     5457                       update v-yesno.
     5458                       if v-yesno = ?
     5459                       then do:
     5460                           assign
     5461                               buf_start_temp_goods-qnty.need-qnty   = p-same-good-old-qnty
     5462                               buf_start_temp_goods-qnty.calculated  = yes
     5463                           .
     5464                           run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Расчитанная строка документа оставлена без изменений. Количество &1", buf_start_temp_goods-qnty.need-qnty ) ).
     5465                           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5466                           find first buf_start_temp_goods-qnty
     5467                                where buf_start_temp_goods-qnty.calculated = no
     5468                           no-error.
     5469                           next calc-not-calculated-goods.
     5470                       end.
     5471                   end.
     5472                   assign
     5473                       buf_start_temp_goods-qnty.calculated  = no
     5474                   .
     5475                   if v-yesno = yes
     5476                   then do:
     5477                       assign
     5478                           buf_fbr-line.fact-qnty = buf_fbr-line.fact-qnty + p-same-good-old-qnty
     5479                       .
     5480                   end.
     5481                   run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Количество в рассчитанной строке документа изменено на &1", buf_fbr-line.fact-qnty ) ).
     5482               end.
     5483               assign
     5484                   buf_start_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5485                   buf_start_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5486                   buf_start_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5487               .
     5488           end.
     5489           run writelog in this-procedure ( log-file-name, 2, "Идем по ингредиентам товара." ).
     5490           for each buf_fbr-recipe-gds no-lock
     5491              where buf_fbr-recipe-gds.doc-code    = buf_fbr-recipe.doc-code
     5492                and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     5493           on error undo, return error
     5494           :
     5495               find first buf_goods no-lock
     5496                    where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5497                      and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5498                      and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5499               .
     5500               assign
     5501                   v-is-comp = no
     5502                   v-trn-type = ( if buf_start_temp_goods-qnty.trn-type = 'при':U then 'спи':U else 'при':U )
     5503               .
     5504               run str/fbr-crln.p (
     5505                     input p-mainmenu-handle
     5506                   , input recid( buf_fbr-doc )
     5507                   , input recid( buf_goods )
     5508                   , input buf_fbr-recipe.recipe-code
     5509                   , input v-trn-type
     5510                   , input v-is-comp
     5511                   , input yes
     5512                   , input buf_fbr-doc.obj-type
     5513                   , input buf_fbr-doc.obj-code
     5514                   , output v-fbr-line-recid
     5515               ).
     5516               find first buf_fbr-line no-lock
     5517                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5518               .
     5519               run writelog in this-procedure ( log-file-name, 3, substitute( "Создана строка ингредиента с артикулом '&1'", buf_fbr-line.artic ) ).
     5520           end.
     5521           run writelog in this-procedure ( log-file-name, 2, substitute( "Упорядочивание рецептов. Идем по рецептам с последнего." ) ).
     5522           run fbrlib-put-in-order-recipe in this-procedure (
     5523               input buf_fbr-doc.doc-code
     5524           ) no-error.
     5525           if error-status :error
     5526           then do:
     5527               for each buf_del_temp_goods-qnty
     5528               :
     5529                   delete buf_del_temp_goods-qnty.
     5530               end.
     5531               undo, return error.
     5532           end.
     5533           find last temp_recipe-order.
     5534           calc-all-recipes:
     5535           do while available temp_recipe-order
     5536           :
     5537               run writelog in this-procedure ( log-file-name, 3, substitute( "Обработка рецепта номер: &1", temp_recipe-order.recipe-code ) ).
     5538               find first buf_comp_fbr-line exclusive-lock
     5539                    where buf_comp_fbr-line.doc-code    = p-fbr-doc-doc-code
     5540                      and buf_comp_fbr-line.is-comp     = yes
     5541                      and buf_comp_fbr-line.recipe-code = temp_recipe-order.recipe-code
     5542               .
     5543               find first buf_temp_goods-qnty
     5544                    where buf_temp_goods-qnty.artic        = buf_comp_fbr-line.artic
     5545                      and buf_temp_goods-qnty.prod-type    = buf_comp_fbr-line.prod-type
     5546                      and buf_temp_goods-qnty.prod-code    = buf_comp_fbr-line.prod-code
     5547                      and buf_temp_goods-qnty.recipe-code  = buf_comp_fbr-line.recipe-code
     5548               no-error.
     5549               if not available buf_temp_goods-qnty
     5550               or buf_temp_goods-qnty.calculated = no
     5551               then do:
     5552                   run writelog in this-procedure ( log-file-name, 4, "Товар рецепта не рассчитан. Рассчитываем." ).
     5553                   if available buf_temp_goods-qnty
     5554                   and buf_temp_goods-qnty.need-qnty <> buf_comp_fbr-line.fact-qnty
     5555                   then do:
     5556                       assign
     5557                           buf_comp_fbr-line.fact-qnty = buf_temp_goods-qnty.need-qnty
     5558                       .
     5559                       run writelog in this-procedure ( log-file-name, 5, substitute( "Прописываем количество в строку составного товара: &1", buf_comp_fbr-line.fact-qnty  ) ).
     5560                   end.
     5561                   run str/fbr-qnty.p (
     5562                         input p-mainmenu-handle
     5563                       , input p-fbrhist-handle
     5564                       , input recid( buf_fbr-doc )
     5565                       , input recid( buf_comp_fbr-line )
     5566                       , input no
     5567                       , input "ingr"
     5568                       , input no
     5569                       , input p-price-sale-obj-type
     5570                       , input p-price-sale-obj-code
     5571                       , input yes
     5572                       , input p-autofbr
     5573                       , input p-have-store
     5574                       , output v-need-goods
     5575                       , output v-need-goods-list
     5576                       , output v-need-goods-qnty-list
     5577                   ).
     5578                   if p-add-childs  = yes
     5579                   and v-need-goods = yes
     5580                   then do:
     5581                       do v-counter = 1 to num-entries( v-need-goods-list ) / 2
     5582                       :
     5583                           run add-new-recipe in this-procedure (
     5584                                 input p-mainmenu-handle
     5585                               , input buf_fbr-doc.doc-code
     5586                               , input entry( 2 * v-counter, v-need-goods-list )
     5587                               , input integer( entry( 2 * v-counter - 1 , v-need-goods-list ) )
     5588                               , input decimal( entry( v-counter, v-need-goods-qnty-list ) )
     5589                               , input p-autofbr
     5590                               , input p-have-store
     5591                           ).
     5592                       end.
     5593                       leave calc-all-recipes.
     5594                   end.
     5595               end.
     5596               find prev temp_recipe-order no-error.
     5597           end.
     5598           assign
     5599               buf_start_temp_goods-qnty.calculated = yes
     5600           .
     5601           if buf_start_temp_goods-qnty.recipe-type = 'разделка':U
     5602           or ( buf_start_temp_goods-qnty.recipe-type = 'комплектация':U
     5603                and buf_start_temp_goods-qnty.trn-type = 'спи':U )
     5604           then do:
     5605               run fill-temp-dressing-ingr in this-procedure (
     5606                     input buf_fbr-doc.doc-code
     5607                   , input buf_start_temp_goods-qnty.recipe-code
     5608               ).
     5609           end.
     5610           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5611           find first buf_start_temp_goods-qnty
     5612                where buf_start_temp_goods-qnty.calculated = no
     5613           no-error.
     5614       end.
     5615   end.
     5616   END PROCEDURE.
     5617   PROCEDURE clear-temp-tables :
     5618   do
     5619   on error undo, return error
     5620   :
     5621       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5622       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5623       for each buf_temp_goods-qnty
     5624       on error undo, return error
     5625       :
     5626           delete buf_temp_goods-qnty.
     5627       end.
     5628       for each buf_temp_dressing-ingr
     5629       on error undo, return error
     5630       :
     5631           delete buf_temp_dressing-ingr.
     5632       end.
     5633   end.
     5634   END PROCEDURE.
     5635   PROCEDURE copy-recipe-in-doc :
     5636   define input parameter p-doc-code       as character             no-undo.
     5637   define input parameter p-recipe-code    as character             no-undo.
     5638   define input parameter p-obj-date       as date                  no-undo.
     5639   define input parameter p-obj-type       like ub.clients.obj-type no-undo.
     5640   define input parameter p-obj-code       like ub.clients.obj-code no-undo.
     5641       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5642       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5643       define buffer buf_recipe            for ub.recipe.
     5644       define buffer buf_recipe-gds        for ub.recipe-gds.
     5645   do
     5646   for buf_fbr-recipe
     5647     , buf_fbr-recipe-gds
     5648     , buf_recipe
     5649     , buf_recipe-gds
     5650   on error undo, return error return-value
     5651   :
     5652   find first buf_recipe no-lock
     5653        where buf_recipe.recipe-code = p-recipe-code
     5654   .
     5655   find first buf_fbr-recipe exclusive-lock
     5656        where buf_fbr-recipe.doc-code      = p-doc-code
     5657          and buf_fbr-recipe.recipe-code   = p-recipe-code
     5658   no-error.
     5659   if not available buf_fbr-recipe
     5660   then do:
     5661     create buf_fbr-recipe.
     5662     assign
     5663       buf_fbr-recipe.doc-code     = p-doc-code
     5664       buf_fbr-recipe.recipe-code  = p-recipe-code
     5665       buf_fbr-recipe.recipe-type  = buf_recipe.recipe-type
     5666     .
     5667     for each buf_recipe-gds exclusive-lock
     5668        where buf_recipe-gds.recipe-code = p-recipe-code
     5669     on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     5670           run fbrlib_create-fbr-recipe-gds in this-procedure (
     5671                 input p-doc-code
     5672               , input buf_recipe-gds.recipe-code
     5673               , input buf_recipe-gds.prod-type
     5674               , input buf_recipe-gds.prod-code
     5675               , input buf_recipe-gds.artic
     5676               , input buf_recipe-gds.gds-code
     5677               , input buf_recipe-gds.is-waste
     5678               , input buf_recipe-gds.proc-number
     5679               , input p-obj-date
     5680               , input p-obj-type
     5681               , input p-obj-code
     5682               , input buf_recipe-gds.calc-method
     5683               , input buf_recipe-gds.coeff-waste
     5684               , input buf_recipe-gds.qnty
     5685               , input buf_recipe-gds.brutto-qnty
     5686         ) no-error.
     5687         if error-status:error
     5688         then do:
     5689               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     5690         end.
     5691     end.
     5692     buffer-copy buf_recipe to buf_fbr-recipe.
     5693   end.
     5694   end.
     5695   END PROCEDURE.
     5696   PROCEDURE fill-temp-dressing-ingr :
     5697   do
     5698   on error undo, return error
     5699   :
     5700   define input parameter p-doc-code       as character    no-undo.
     5701   define input parameter p-recipe-code    as character    no-undo.
     5702       define variable v-free-qnty     as decimal       no-undo.
     5703       define buffer buf_fbr-doc               for ub.fbr-doc.
     5704       define buffer buf_c_fbr-line            for ub.fbr-line.
     5705       define buffer buf_i_fbr-line            for ub.fbr-line.
     5706       define buffer buf_i_other_fbr-line      for ub.fbr-line.
     5707       define buffer buf_goods                 for ub.goods.
     5708       define buffer buf_recipe                for ub.fbr-recipe.
     5709       define buffer buf_recipe-gds            for ub.fbr-recipe-gds.
     5710       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5711       find first buf_fbr-doc no-lock
     5712            where buf_fbr-doc.doc-code = p-doc-code
     5713       .
     5714       find first buf_recipe no-lock
     5715            where buf_recipe.doc-code    = p-doc-code
     5716              and buf_recipe.recipe-code = p-recipe-code
     5717       .
     5718       find first buf_c_fbr-line no-lock
     5719            where buf_c_fbr-line.doc-code    = p-doc-code
     5720              and buf_c_fbr-line.is-comp     = yes
     5721              and buf_c_fbr-line.recipe-code = p-recipe-code
     5722       .
     5723       if buf_recipe.recipe-type <> 'разделка':U
     5724       and ( buf_recipe.recipe-type <> 'комплектация':U
     5725            or buf_c_fbr-line.trn-type <> 'спи':U )
     5726       then do:
     5727           message
     5728                    vss-workfile vss-revision vss-description
     5729               skip "Процедура fill-temp-dressing-ingr применима только к рецептам разделки и разукомплектации."
     5730               skip return-value
     5731           view-as alert-box error.
     5732           undo, return error .
     5733       end.
     5734       for each buf_temp_dressing-ingr
     5735       :
     5736           delete buf_temp_dressing-ingr.
     5737       end.
     5738       for each buf_i_fbr-line no-lock
     5739          where buf_i_fbr-line.doc-code    = p-doc-code
     5740            and buf_i_fbr-line.is-comp     = no
     5741            and buf_i_fbr-line.recipe-code = p-recipe-code
     5742       on error undo, return error
     5743       :
     5744           find first buf_goods no-lock
     5745                where buf_goods.artic      = buf_i_fbr-line.artic
     5746                  and buf_goods.prod-type  = buf_i_fbr-line.prod-type
     5747                  and buf_goods.prod-code  = buf_i_fbr-line.prod-code
     5748           .
     5749           find first buf_temp_dressing-ingr
     5750                where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5751                  and buf_temp_dressing-ingr.gds-code    = buf_goods.gds-code
     5752           no-error.
     5753           if not available buf_temp_dressing-ingr
     5754           then do:
     5755               create buf_temp_dressing-ingr.
     5756               assign
     5757                   buf_temp_dressing-ingr.recipe-code  = p-recipe-code
     5758                   buf_temp_dressing-ingr.gds-code     = buf_goods.gds-code
     5759                   buf_temp_dressing-ingr.used-qnty    = 0
     5760                   buf_temp_dressing-ingr.line-qnty    = 0
     5761                   buf_temp_dressing-ingr.recipe-qnty  = 0
     5762               .
     5763           end.
     5764           run fbrrest-get-free-qnty in this-procedure (
     5765                 input buf_fbr-doc.obj-type
     5766               , input buf_fbr-doc.obj-code
     5767               , input buf_goods.gds-code
     5768               , input no
     5769               , output v-free-qnty
     5770           ).
     5771           find first buf_recipe-gds no-lock
     5772                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5773                  and buf_recipe-gds.recipe-code = p-recipe-code
     5774                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5775                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5776                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5777           .
     5778           for each buf_i_other_fbr-line no-lock
     5779              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5780                and buf_i_other_fbr-line.is-comp     = no
     5781                and buf_i_other_fbr-line.recipe-code <> p-recipe-code
     5782                and buf_i_other_fbr-line.artic       = buf_i_fbr-line.artic
     5783                and buf_i_other_fbr-line.prod-type   = buf_i_fbr-line.prod-type
     5784                and buf_i_other_fbr-line.prod-code   = buf_i_fbr-line.prod-code
     5785           :
     5786               assign
     5787                   buf_temp_dressing-ingr.line-qnty    = buf_temp_dressing-ingr.line-qnty
     5788                                                           + buf_i_other_fbr-line.fact-qnty
     5789               .
     5790           end.
     5791           if available buf_temp_dressing-ingr
     5792           then do:
     5793               assign
     5794                   buf_temp_dressing-ingr.used-qnty = buf_temp_dressing-ingr.line-qnty - v-free-qnty
     5795               .
     5796           end.
     5797       end.
     5798       for each buf_temp_dressing-ingr
     5799          where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5800       :
     5801           find first buf_goods no-lock
     5802                where buf_goods.gds-code = buf_temp_dressing-ingr.gds-code
     5803           .
     5804           for each buf_i_other_fbr-line no-lock
     5805              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5806                and buf_i_other_fbr-line.is-comp     = no
     5807                and buf_i_other_fbr-line.recipe-code = buf_temp_dressing-ingr.recipe-code
     5808                and buf_i_other_fbr-line.artic       = buf_goods.artic
     5809                and buf_i_other_fbr-line.prod-type   = buf_goods.prod-type
     5810                and buf_i_other_fbr-line.prod-code   = buf_goods.prod-code
     5811           on error undo, return error
     5812           :
     5813               assign
     5814                   buf_temp_dressing-ingr.recipe-qnty = buf_temp_dressing-ingr.recipe-qnty
     5815                                                       + buf_i_other_fbr-line.fact-qnty
     5816               .
     5817           end.
     5818       end.
     5819   end.
     5820   END PROCEDURE.
     5821   PROCEDURE test-temp-tables :
     5822       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5823       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5824   do
     5825   on error undo, return error
     5826   :
     5827   define input parameter p-title  as character    no-undo.
     5828   define variable v-str               as character        no-undo.
     5829       assign
     5830           v-str = p-title + " temp_goods-qnty:"
     5831       .
     5832       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5833       for each buf_temp_goods-qnty
     5834       on error undo, return error
     5835       :
     5836           assign
     5837               v-str   = string( buf_temp_goods-qnty.gds-code )
     5838                       + "   " + ( if buf_temp_goods-qnty.recipe-type = ? then "?" else string( buf_temp_goods-qnty.recipe-type ) )
     5839                       + "   " + ( if buf_temp_goods-qnty.recipe-code = ? then "?" else string( buf_temp_goods-qnty.recipe-code ) )
     5840                       + "   " + ( if buf_temp_goods-qnty.trn-type = ?    then "?" else string( buf_temp_goods-qnty.trn-type ) )
     5841                       + "   " + ( if buf_temp_goods-qnty.need-qnty = ?   then "?" else string( buf_temp_goods-qnty.need-qnty ) )
     5842                       + "   " + string( buf_temp_goods-qnty.calculated )
     5843           .
     5844           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5845       end.
     5846       assign
     5847           v-str = "        temp_dressing-ingr:"
     5848       .
     5849       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5850       for each buf_temp_dressing-ingr
     5851       on error undo, return error
     5852       :
     5853           assign
     5854               v-str   = string( buf_temp_dressing-ingr.recipe-code  )
     5855                       + "   " + string( buf_temp_dressing-ingr.gds-code )
     5856                       + "   " + ( if buf_temp_dressing-ingr.line-qnty = ?   then "?" else string( buf_temp_dressing-ingr.line-qnty ) )
     5857                       + "   " + ( if buf_temp_dressing-ingr.used-qnty = ?   then "?" else string( buf_temp_dressing-ingr.used-qnty ) )
     5858                       + "   " + ( if buf_temp_dressing-ingr.recipe-qnty = ? then "?" else string( buf_temp_dressing-ingr.recipe-qnty ) )
     5859           .
     5860           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5861       end.
     5862   end.
     5863   END PROCEDURE.
     5864   PROCEDURE add-new-recipe :
     5865   do
     5866   on error undo, return error
     5867   :
     5868   define input parameter p-mainmenu-handle    as handle           no-undo.
     5869   define input parameter p-doc-code           as character        no-undo.
     5870   define input parameter p-trn-type           as character        no-undo.
     5871   define input parameter p-gds-code           as integer          no-undo.
     5872   define input parameter p-need-qnty          as decimal          no-undo.
     5873   define input parameter p-autofbr            as logical          no-undo.
     5874   define input parameter p-have-store         as logical          no-undo.
     5875       define variable v-comp-gds-code         as integer          no-undo.
     5876       define variable v-comp-trn-type         as character        no-undo.
     5877       define variable v-comp-need-qnty        as decimal          no-undo.
     5878       define variable v-comp-recipe-type      as character        no-undo.
     5879       define variable v-comp-recipe-code      as character        no-undo.
     5880       define variable v-comp-recipe-found     as logical          no-undo.
     5881       define variable v-ext-comp-recipe-type  as character        no-undo.
     5882       define variable v-no-add-good           as logical          no-undo.
     5883       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5884       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     5885       define buffer buf_goods                 for ub.goods.
     5886       define buffer buf_fbr-line              for ub.fbr-line.
     5887       define buffer buf_fbr-doc               for ub.fbr-doc.
     5888       define variable v-value          as character no-undo .
     5889       define variable v-type           as character no-undo .
     5890       define variable v-attr-value     as character no-undo .
     5891       define variable v-attr-value-rec as character no-undo .
     5892       define variable v-attr-type      as character no-undo .
     5893       define variable v-ban-recipes as logical no-undo .
     5894       define variable v-ban-altr    as logical no-undo .
     5895       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     5896       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     5897       find first buf_fbr-doc no-lock
     5898            where buf_fbr-doc.doc-code = p-doc-code
     5899       .
     5900       run extend-noweight-gds-qnty in this-procedure (
     5901             input p-gds-code
     5902           , input p-need-qnty
     5903           , output p-need-qnty
     5904       ).
     5905       run select-recipe in this-procedure (
     5906             input p-mainmenu-handle
     5907           , input buf_fbr-doc.obj-type
     5908           , input buf_fbr-doc.obj-code
     5909           , input p-gds-code
     5910           , input p-trn-type
     5911           , input p-need-qnty
     5912           , input p-autofbr
     5913           , input p-have-store
     5914           , output v-comp-gds-code
     5915           , output v-comp-trn-type
     5916           , output v-comp-need-qnty
     5917           , output v-comp-recipe-type
     5918           , output v-comp-recipe-code
     5919           , output v-comp-recipe-found
     5920           , output v-no-add-good
     5921       ) no-error.
     5922       if not error-status :error
     5923       and v-comp-recipe-found = yes
     5924       and v-no-add-good       = no
     5925       then do:
     5926           find first buf_goods no-lock
     5927                where buf_goods.gds-code = v-comp-gds-code
     5928           .
     5929           assign
     5930               v-ext-comp-recipe-type = v-comp-recipe-type
     5931           .
     5932           if v-comp-recipe-type = 'комплектация':U
     5933           and v-comp-trn-type   = 'спи':U
     5934           then do:
     5935               assign
     5936                   v-ext-comp-recipe-type = 'разделка':U
     5937               .
     5938           end.
     5939           case v-ext-comp-recipe-type
     5940           :
     5941               when 'разделка':U
     5942               then do:
     5943                   find first buf_temp_goods-qnty
     5944                        where buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5945                          and buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5946                   no-error.
     5947                   if not available buf_temp_goods-qnty
     5948                   then do:
     5949                       create buf_temp_goods-qnty.
     5950                       assign
     5951                           buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5952                           buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     5953                           buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5954                           buf_temp_goods-qnty.artic       = buf_goods.artic
     5955                           buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     5956                           buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     5957                           buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     5958                           buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     5959                           buf_temp_goods-qnty.calculated  = no
     5960                       .
     5961                   end.
     5962                   else do:
     5963                       find first buf_goods no-lock
     5964                            where buf_goods.gds-code = p-gds-code
     5965                       .
     5966                       find first buf_fbr-line no-lock
     5967                            where buf_fbr-line.doc-code    = p-doc-code
     5968                              and buf_fbr-line.trn-type    = p-trn-type
     5969                              and buf_fbr-line.recipe-code = v-comp-recipe-code
     5970                              and buf_fbr-line.artic       = buf_goods.artic
     5971                              and buf_fbr-line.prod-type   = buf_goods.prod-type
     5972                              and buf_fbr-line.prod-code   = buf_goods.prod-code
     5973                       no-error.
     5974                       if available buf_fbr-line
     5975                       then do:
     5976                           define variable v-line-qnty             as decimal   no-undo.
     5977                           define variable v-used-qnty             as decimal   no-undo.
     5978                           define variable v-free-qnty             as decimal   no-undo.
     5979                           define variable v-recipe-qnty           as decimal   no-undo.
     5980                           define variable v-comp-fbr-line-recid   as recid     no-undo.
     5981                           run get-temp_dressing-ingr-used-qnty in this-procedure (
     5982                                 input v-comp-recipe-code
     5983                               , input p-gds-code
     5984                               , output v-line-qnty
     5985                               , output v-used-qnty
     5986                               , output v-recipe-qnty
     5987                           ).
     5988                           run fbrrest-get-free-qnty in this-procedure (
     5989                                 input buf_fbr-doc.obj-type
     5990                               , input buf_fbr-doc.obj-code
     5991                               , input p-gds-code
     5992                               , input p-autofbr
     5993                               , output v-free-qnty
     5994                           ).
     5995                           assign
     5996                               p-need-qnty = p-need-qnty + v-recipe-qnty
     5997                           .
     5998                           run calc-comp-from-ingr in this-procedure (
     5999                                 input recid( buf_fbr-line )
     6000                               , input p-need-qnty
     6001                               , output v-comp-fbr-line-recid
     6002                               , output v-comp-need-qnty
     6003                           ) .
     6004                       end.
     6005                       assign
     6006                           buf_temp_goods-qnty.need-qnty   = maximum( buf_temp_goods-qnty.need-qnty, v-comp-need-qnty )
     6007                           buf_temp_goods-qnty.calculated  = no
     6008                       .
     6009                   end.
     6010               end.
     6011               otherwise do:
     6012         if v-ban-altr or v-ban-recipes then
     6013         do:
     6014             if v-ext-comp-recipe-type = 'производство':U and v-ban-recipes then
     6015             do:
     6016                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6017                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6018                      , input  'mark-type':U
     6019                      , output v-attr-value
     6020                      , output v-attr-type
     6021                      ) no-error .
     6022                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6023                   do:
     6024                      message "Рецепт производства " + v-comp-recipe-code + " содержит маркированный товар."
     6025                         view-as alert-box.
     6026                      return .
     6027                   end.
     6028                end.
     6029             end.
     6030             if v-ext-comp-recipe-type = 'альтернатива':U and v-ban-altr then
     6031             do:
     6032                if not check-ban-sales-via-cd(buf_goods.gds-code) then
     6033                do:
     6034                  message "Рецепт альтернатива " + v-comp-recipe-code + " входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     6035                    view-as alert-box.
     6036                  return .
     6037                end.
     6038             end.
     6039             if v-ext-comp-recipe-type = 'комплектация':U and v-ban-recipes then
     6040             do:
     6041                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6042                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6043                      , input  'mark-type':U
     6044                      , output v-attr-value
     6045                      , output v-attr-type
     6046                      ) no-error .
     6047                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6048                   do:
     6049                      run gds-attr-value in this-procedure  ( input  p-gds-code
     6050                         , input  'mark-type':U
     6051                         , output v-attr-value-rec
     6052                         , output v-attr-type
     6053                         ) no-error .
     6054                      if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     6055                      do:
     6056                         message "Рецепт комплектации " + v-comp-recipe-code + " должен быть маркированным"
     6057                            view-as alert-box.
     6058                         return .
     6059                      end.
     6060                      else leave.
     6061                   end.
     6062                end.
     6063             end.
     6064         end.
     6065                   find first buf_temp_goods-qnty
     6066                        where buf_temp_goods-qnty.gds-code = p-gds-code
     6067                          and buf_temp_goods-qnty.trn-type = p-trn-type
     6068                   no-error.
     6069                   if available buf_temp_goods-qnty
     6070                   then do:
     6071                       assign
     6072                           buf_temp_goods-qnty.need-qnty  = buf_temp_goods-qnty.need-qnty + p-need-qnty
     6073                       .
     6074                       if buf_temp_goods-qnty.recipe-code <> ""
     6075                       then do:
     6076                           assign
     6077                               buf_temp_goods-qnty.calculated = no
     6078                           .
     6079                       end.
     6080                       run writelog in this-procedure ( log-file-name, 5, substitute( "Раскрутка ингредиетнов: добавляем товар '&1' к уже рассчитанному: &2", buf_temp_goods-qnty.artic, buf_temp_goods-qnty.need-qnty  ) ).
     6081                   end.
     6082                   else do:
     6083                       find first buf_temp_goods-qnty
     6084                            where buf_temp_goods-qnty.gds-code = v-comp-gds-code
     6085                              and buf_temp_goods-qnty.trn-type = v-comp-trn-type
     6086                       no-error.
     6087                       if not available buf_temp_goods-qnty
     6088                       then do:
     6089                           create buf_temp_goods-qnty.
     6090                           find first buf_goods no-lock
     6091                                where buf_goods.gds-code = v-comp-gds-code
     6092                           .
     6093                           assign
     6094                               buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6095                               buf_temp_goods-qnty.artic       = buf_goods.artic
     6096                               buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6097                               buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6098                               buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6099                               buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6100                               buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6101                               buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6102                               buf_temp_goods-qnty.calculated  = no
     6103                           .
     6104                           run writelog in this-procedure ( log-file-name, 5, "Раскрутка ингредиентов: добавляем товар как не рассчитанный." ).
     6105                       end.
     6106                   end.
     6107               end.
     6108           end case.
     6109           if available buf_temp_goods-qnty
     6110           then do:
     6111               run extend-noweight-gds-qnty in this-procedure (
     6112                     input buf_temp_goods-qnty.gds-code
     6113                   , input buf_temp_goods-qnty.need-qnty
     6114                   , output buf_temp_goods-qnty.need-qnty
     6115               ).
     6116           end.
     6117           find first buf_goods no-lock
     6118                where buf_goods.gds-code = v-comp-gds-code
     6119           .
     6120           if v-ext-comp-recipe-type = 'разделка':U
     6121           then do:
     6122               find first buf_fbr-line exclusive-lock
     6123                   where buf_fbr-line.doc-code    = p-doc-code
     6124                   and buf_fbr-line.trn-type    = v-comp-trn-type
     6125                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6126                   and buf_fbr-line.artic       = buf_goods.artic
     6127                   and buf_fbr-line.prod-type   = buf_goods.prod-type
     6128                   and buf_fbr-line.prod-code   = buf_goods.prod-code
     6129               no-error.
     6130               if available buf_fbr-line
     6131               then do:
     6132                   assign
     6133                       buf_fbr-line.fact-qnty = 0
     6134                   .
     6135               end.
     6136           end.
     6137           else do:
     6138               for each buf_fbr-line exclusive-lock
     6139               where buf_fbr-line.doc-code    = p-doc-code
     6140                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6141               on error undo, return error
     6142               :
     6143                   delete buf_fbr-line.
     6144               end.
     6145           end.
     6146       end.
     6147   end.
     6148   END PROCEDURE.
     6149   PROCEDURE extend-noweight-gds-qnty :
     6150   do
     6151   on error undo, return error
     6152   :
     6153   define input parameter p-gds-code   as integer      no-undo.
     6154   define input parameter p-in-qnty    as decimal      no-undo.
     6155   define output parameter p-out-qnty  as decimal      no-undo.
     6156       define buffer buf_goods                 for ub.goods.
     6157       define buffer buf_units                 for ub.units.
     6158       find first buf_goods no-lock
     6159            where buf_goods.gds-code = p-gds-code
     6160       .
     6161       find first buf_units no-lock
     6162            where buf_units.unit-name = buf_goods.unit-base
     6163       .
     6164       assign
     6165           p-out-qnty = p-in-qnty
     6166       .
     6167       if not ( lookup( 'вес':U, buf_units.type ) > 0
     6168                or lookup ('дро':U, buf_units.type) > 0 )
     6169       then do:
     6170           if p-out-qnty <> truncate( p-out-qnty, 0 )
     6171           then do:
     6172               assign
     6173                   p-out-qnty = truncate( p-out-qnty, 0 ) + 1
     6174               .
     6175           end.
     6176       end.
     6177   end.
     6178   END PROCEDURE.
     6179   PROCEDURE select-recipe :
     6180   do
     6181   on error undo, return error
     6182   :
     6183   define input parameter p-mainmenu-handle    as handle           no-undo.
     6184   define input parameter p-obj-type           as character        no-undo.
     6185   define input parameter p-obj-code           as integer          no-undo.
     6186   define input parameter p-gds-code           as integer          no-undo.
     6187   define input parameter p-trn-type           as character        no-undo.
     6188   define input parameter p-gds-qnty           as decimal          no-undo.
     6189   define input parameter p-autofbr            as logical          no-undo.
     6190   define input parameter p-have-store         as logical          no-undo.
     6191   define output parameter p-out-gds-code      as integer          no-undo.
     6192   define output parameter p-out-trn-type      as character        no-undo.
     6193   define output parameter p-out-gds-qnty      as decimal          no-undo.
     6194   define output parameter p-out-recipe-type   as character        no-undo.
     6195   define output parameter p-out-recipe-code   as character        no-undo.
     6196   define output parameter p-recipe-found      as logical          no-undo.
     6197   define output parameter p-no-need-good      as logical          no-undo.
     6198   define variable v-host-code             as integer      no-undo.
     6199   define variable v-value-character as character  no-undo .
     6200   define variable v-value-date      as date       no-undo .
     6201   define variable v-value-decimal   as decimal    no-undo .
     6202   define variable v-value-integer   as integer    no-undo .
     6203   define variable v-value-logical   as logical    no-undo .
     6204   define variable v-tth             as handle     no-undo .
     6205   define variable v-param-type            as character no-undo .
     6206   define variable v-type                  as character    no-undo.
     6207   define variable v-recipe-type           as character    no-undo.
     6208   define variable v-recipe-list           as character    no-undo.
     6209   define variable v-is-comp               as logical      no-undo.
     6210   define variable v-is-integration        as logical      no-undo.
     6211   define variable v-cancel                as logical      no-undo.
     6212   define variable v-yesno                 as logical      no-undo.
     6213   define variable v-default-recipe-code   as character    no-undo.
     6214       define buffer buf_recipe            for ub.recipe.
     6215       define buffer buf_goods             for ub.goods.
     6216       define buffer buf_selected_recipe   for ub.recipe.
     6217       define buffer buf_recipe-gds        for ub.recipe-gds.
     6218       define buffer buf_ingr_goods        for ub.goods.
     6219       run writelog in this-procedure (
     6220           input log-file-name
     6221           , input 0
     6222           , input "******** select-recipe ***************************************"
     6223       ).
     6224       find first buf_goods no-lock
     6225            where buf_goods.gds-code = p-gds-code
     6226       .
     6227       if p-trn-type = ?
     6228       then do:
     6229           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     6230           undo, return error.
     6231       end.
     6232   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6234     (input  p-obj-type
     6235     ,input  p-obj-code
     6236     ,output v-host-code
     6237     )  .
     6238       run adm/shattri.p ( input "get":U
     6239                         , input  '':u
     6240                         , input  0
     6241                         , input  'fbrattr':U
     6242                         , input  'fbr-frcp':U
     6243                         , output v-value-character
     6244                         , output v-value-date
     6245                         , output v-value-decimal
     6246                         , output v-value-integer
     6247                         , output v-value-logical
     6248                         , output v-param-type
     6249                         , input-output table-handle v-tth
     6250                         ) no-error .
     6251       if error-status :error then do:
     6252          assign
     6253             v-value-logical = FALSE
     6254          .
     6255       end.
     6256       run writelog in this-procedure (
     6257             input log-file-name
     6258           , input 1
     6259           , input substitute( "fbr-frcp = '&1'", v-value-logical )
     6260       ).
     6261       assign
     6262           p-out-recipe-type = ?
     6263           p-out-recipe-code = ?
     6264           v-recipe-type = ?
     6265       .
     6266       run fbrlib-get-obj-recipe in this-procedure (
     6267             input p-obj-type
     6268           , input p-obj-code
     6269           , input p-gds-code
     6270           , output v-default-recipe-code
     6271       ).
     6272       comp-recipe:
     6273       for each buf_recipe no-lock
     6274          where ( buf_recipe.obj-type = p-obj-type
     6275              and buf_recipe.obj-code = p-obj-code
     6276              and buf_recipe.artic     = buf_goods.artic
     6277              and buf_recipe.prod-type = buf_goods.prod-type
     6278              and buf_recipe.prod-code = buf_goods.prod-code
     6279              and buf_recipe.stts      <> 2
     6280             )
     6281             or ( buf_recipe.obj-type = ""
     6282              and buf_recipe.obj-code = 0
     6283              and buf_recipe.artic     = buf_goods.artic
     6284              and buf_recipe.prod-type = buf_goods.prod-type
     6285              and buf_recipe.prod-code = buf_goods.prod-code
     6286              and buf_recipe.stts      <> 2
     6287             )
     6288       :
     6289           if  ( p-autofbr = yes or v-value-logical = yes ) and buf_recipe.recipe-code <> v-default-recipe-code
     6290           then do:
     6291               undo comp-recipe, next comp-recipe.
     6292           end.
     6293           run writelog in this-procedure (
     6294                 input log-file-name
     6295               , input 3
     6296               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6297           ).
     6298           if p-autofbr = yes
     6299           and buf_recipe.recipe-type <> 'производство':U
     6300           and buf_recipe.recipe-type <> 'альтернатива':U
     6301           and buf_recipe.recipe-type <> 'комплектация':U
     6302           and buf_recipe.recipe-type <> 'комплектация':U
     6303           then do:
     6304               next comp-recipe.
     6305           end.
     6306           if p-trn-type = 'при':U
     6307           and buf_recipe.recipe-type = 'разделка':U
     6308           then do:
     6309               run writelog in this-procedure (
     6310                     input log-file-name
     6311                   , input 4
     6312                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     6313               ).
     6314               next comp-recipe.
     6315           end.
     6316           if p-trn-type = 'спи':U
     6317           and buf_recipe.recipe-type <> 'разделка':U
     6318           and buf_recipe.recipe-type <> 'комплектация':U
     6319           then do:
     6320               run writelog in this-procedure (
     6321                     input log-file-name
     6322                   , input 4
     6323                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     6324               ).
     6325               next comp-recipe.
     6326           end.
     6327           if v-recipe-type = ?
     6328           then do:
     6329               assign
     6330                   p-out-recipe-type = buf_recipe.recipe-type
     6331                   p-out-recipe-code = buf_recipe.recipe-code
     6332                   v-recipe-type = "recipe"
     6333                   v-is-integration = yes
     6334               .
     6335               run writelog in this-procedure (
     6336                     input log-file-name
     6337                   , input 4
     6338                   , input "Найден первый подходящий рецепт для составного"
     6339               ).
     6340               if v-value-logical
     6341               then do:
     6342                   run writelog in this-procedure (
     6343                       input log-file-name
     6344                       , input 4
     6345                       , input "Включен параметр fbr-frcp. Больше рецепт не ищем"
     6346                   ).
     6347                   leave comp-recipe.
     6348               end.
     6349               if p-autofbr = yes
     6350               then do:
     6351                   run writelog in this-procedure (
     6352                         input log-file-name
     6353                       , input 4
     6354                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     6355                   ).
     6356                   leave comp-recipe.
     6357               end.
     6358           end.
     6359           else do:
     6360               run writelog in this-procedure (
     6361                     input log-file-name
     6362                   , input 4
     6363                   , input "Найден еще один подходящий рецепт"
     6364               ).
     6365               assign
     6366                   v-yesno = ?
     6367                   p-no-need-good = yes
     6368               .
     6369               do while v-yesno = ?
     6370               and p-no-need-good = yes
     6371               :
     6372                   run ref/rcp-all.w (
     6373                         input p-mainmenu-handle
     6374                       , input "b-sel"
     6375                       , input 'все':U
     6376                       , input recid( buf_goods )
     6377                       , input p-obj-type
     6378                       , input p-obj-code
     6379                       , output v-recipe-list
     6380                   ) no-error.
     6381                   if error-status :error
     6382                   or v-recipe-list = ""
     6383                   then do:
     6384                       message
     6385                           "Отменить добавление товара?"
     6386                           skip(1)
     6387                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     6388                           skip(1)
     6389                           skip "Yes - отменить добавление текущего товара"
     6390                           skip "No  - отменить добавление товаров"
     6391                           skip "Cancel - вернуться к выбору рецептов"
     6392                       view-as alert-box question
     6393                       buttons yes-no-cancel
     6394                       title "Отмена"
     6395                       update v-yesno
     6396                       .
     6397                   end.
     6398                   else do:
     6399                       assign
     6400                           p-no-need-good = no
     6401                       .
     6402                   end.
     6403               end.
     6404               if p-no-need-good = yes
     6405               then do:
     6406                   if v-yesno = no
     6407                   then do:
     6408                       undo, return error .
     6409                   end.
     6410                   else do:
     6411                       return.
     6412                   end.
     6413               end.
     6414               find first buf_selected_recipe no-lock
     6415                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     6416               no-error.
     6417               if not available buf_selected_recipe
     6418               then do:
     6419                   assign
     6420                       p-out-recipe-type = ?
     6421                       p-out-recipe-code = ?
     6422                       v-is-integration  = ?
     6423                   .
     6424               end.
     6425               else do:
     6426                   assign
     6427                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     6428                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     6429                       v-recipe-type       = "recipe"
     6430                       v-is-integration    = yes
     6431                   .
     6432                   leave comp-recipe.
     6433               end.
     6434           end.
     6435       end.
     6436       if v-recipe-type = ?
     6437       and p-autofbr = no
     6438       then do:
     6439           run writelog in this-procedure (
     6440                 input log-file-name
     6441               , input 3
     6442               , input "Поиск товара среди ингредиентов рецептов."
     6443           ).
     6444           search-recipe-gds:
     6445           for each buf_recipe-gds
     6446              where buf_recipe-gds.artic       = buf_goods.artic
     6447                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6448                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6449           :
     6450               find first buf_recipe no-lock
     6451                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     6452                      and buf_recipe.obj-type    = p-obj-type
     6453                      and buf_recipe.obj-code    = p-obj-code
     6454                    no-error
     6455               .
     6456               if not available buf_recipe then next search-recipe-gds.
     6457               find buf_ingr_goods no-lock
     6458                   where buf_ingr_goods.gds-code = buf_recipe.gds-code
     6459               .
     6460               if buf_ingr_goods.stts <> 0 then do:
     6461                   run writelog in this-procedure (
     6462                         input log-file-name
     6463                       , input 3
     6464                       , input subst("Рецепт &1 на товар &2 не подходит т.к. товар удален", buf_recipe.recipe-code, buf_ingr_goods.gds-code)
     6465                   ).
     6466                   next search-recipe-gds.
     6467               end.
     6468               run writelog in this-procedure (
     6469                     input log-file-name
     6470                   , input 3
     6471                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6472               ).
     6473               if p-trn-type = 'при':U
     6474               and buf_recipe.recipe-type <> 'разделка':U
     6475               and buf_recipe.recipe-type <> 'комплектация':U
     6476               then do:
     6477                   run writelog in this-procedure (
     6478                         input log-file-name
     6479                       , input 3
     6480                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     6481                   ).
     6482                   next search-recipe-gds.
     6483               end.
     6484               if p-trn-type = 'спи':U
     6485               and buf_recipe.recipe-type = 'разделка':U
     6486               then do:
     6487                   run writelog in this-procedure (
     6488                         input log-file-name
     6489                       , input 3
     6490                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     6491                   ).
     6492                   next search-recipe-gds.
     6493               end.
     6494               if v-recipe-type = ?
     6495               then do:
     6496                   assign
     6497                       p-out-recipe-type   = buf_recipe.recipe-type
     6498                       p-out-recipe-code   = buf_recipe.recipe-code
     6499                       v-recipe-type       = "recipe-gds"
     6500                       v-is-integration    = no
     6501                   .
     6502                   if v-value-logical
     6503                   then do:
     6504                       leave search-recipe-gds.
     6505                   end.
     6506               end.
     6507               else do:
     6508                   assign
     6509                       p-out-recipe-type = ?
     6510                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     6511                       v-is-integration  = ?
     6512                   .
     6513               end.
     6514           end.
     6515       end.
     6516       if p-out-recipe-type = ?
     6517       and p-out-recipe-code = ?
     6518       then do:
     6519           assign
     6520               p-recipe-found = no
     6521           .
     6522       end.
     6523       else do:
     6524           if p-out-recipe-type = ?
     6525           then do:
     6526               define variable v-recipe-recid-list as character     no-undo.
     6527               run str/rcp-sel.w (
     6528                     input p-mainmenu-handle
     6529                   , input buf_goods.gds-code
     6530                   , input 'при':U
     6531                   , output p-out-recipe-code
     6532                   , output v-is-integration
     6533                   , output v-cancel
     6534               ) .
     6535               if v-cancel = yes
     6536               then do:
     6537                   assign
     6538                       p-recipe-found = no
     6539                       p-no-need-good = yes
     6540                   .
     6541                   return.
     6542               end.
     6543           end.
     6544           assign
     6545               p-recipe-found = yes
     6546           .
     6547           find first buf_recipe no-lock
     6548                where buf_recipe.recipe-code = p-out-recipe-code
     6549           .
     6550           find first buf_goods no-lock
     6551                where buf_goods.artic      = buf_recipe.artic
     6552                  and buf_goods.prod-type  = buf_recipe.prod-type
     6553                  and buf_goods.prod-code  = buf_recipe.prod-code
     6554           .
     6555           assign
     6556               p-out-recipe-type   = buf_recipe.recipe-type
     6557               p-out-gds-code      = buf_goods.gds-code
     6558           .
     6559           run fbrlib-get-trn-type in this-procedure (
     6560                 input buf_recipe.recipe-code
     6561               , input recid( buf_goods )
     6562               , input v-is-integration
     6563               , output v-is-comp
     6564               , output p-out-trn-type
     6565           ).
     6566           run writelog in this-procedure (
     6567                 input log-file-name
     6568               , input 1
     6569               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     6570                                   , p-out-recipe-code
     6571                                   , v-is-comp
     6572                                   , buf_goods.artic
     6573                                   , buf_goods.gds-name
     6574                                   , p-out-trn-type )
     6575           ).
     6576           if p-out-gds-code <> p-gds-code
     6577           then do:
     6578               run writelog in this-procedure (
     6579                     input log-file-name
     6580                   , input 1
     6581                   , input "Необходимый товар является ингредиентом"
     6582               ).
     6583               find first buf_goods no-lock
     6584                    where buf_goods.gds-code = p-gds-code
     6585               .
     6586               find first buf_recipe-gds no-lock
     6587                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     6588                      and buf_recipe-gds.artic       = buf_goods.artic
     6589                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6590                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6591               .
     6592               if buf_recipe-gds.brutto-qnty = ?
     6593               or buf_recipe-gds.brutto-qnty = 0
     6594               then do:
     6595                   message
     6596                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     6597                       skip "Продолжение расчета документа невозможно."
     6598                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     6599                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     6600                   view-as alert-box error.
     6601                   undo, return error .
     6602               end.
     6603               assign
     6604                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     6605                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     6606               .
     6607               run writelog in this-procedure (
     6608                   input log-file-name
     6609                   , input 1
     6610                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     6611                                       , p-gds-qnty
     6612                                       , p-out-gds-qnty
     6613                                       , p-out-recipe-code
     6614                                       , p-out-trn-type )
     6615               ).
     6616           end.
     6617           else do:
     6618               assign
     6619                   p-out-gds-qnty = p-gds-qnty
     6620                   p-out-trn-type = p-trn-type
     6621               .
     6622               run writelog in this-procedure (
     6623                     input log-file-name
     6624                   , input 1
     6625                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     6626                                       , p-out-gds-qnty
     6627                                       , p-out-recipe-code
     6628                                       , p-out-trn-type )
     6629               ).
     6630           end.
     6631       end.
     6632   end.
     6633   END PROCEDURE.
     6634   define variable vss-include-info51 as character format "X(65)" no-undo
     6635   initial "@(#)$Workfile$ $Revision$".
     6636   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6637   define new global shared variable g#trdcalib as handle no-undo.
     6638   define variable vss-include-info53 as character format "X(65)" no-undo
     6639   initial "@(#)$Workfile$ $Revision$".
     6640   procedure fbrattr-write :
     6641     define input parameter p-doc-type       as character        no-undo.
     6642     define input parameter p-doc-code       as character        no-undo.
     6643     define input parameter p-attr-code      as character        no-undo.
     6644     define input parameter p-attr-value     as character        no-undo.
     6645     do
     6646     on error undo, return error
     6647     :
     6648   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input substitute('&1-&2',p-doc-type,p-doc-code) ,
     6649                          input p-attr-code ,
     6650                          input p-attr-value )  .
     6651     end.
     6652   end procedure.
     6653   procedure fbrattr-value :
     6654     define  input parameter p-doc-type      as character        no-undo.
     6655     define  input parameter p-doc-code      as character        no-undo.
     6656     define  input parameter p-attr-code     as character        no-undo.
     6657     define output parameter p-attr-value    as character        no-undo.
     6658     define variable v-par-value     as character    no-undo.
     6659     define variable v-par-type      as character    no-undo.
     6660     define buffer buf_clients       for ub.clients.
     6661     do
     6662     for buf_clients
     6663     on error undo, return error
     6664     :
     6665   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input substitute('&1-&2',p-doc-type,p-doc-code) ,
     6666                           input p-attr-code ,
     6667                          output p-attr-value ,
     6668                          output v-par-type )  .
     6669     end.
     6670   end procedure.
     6671   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6672   define new global shared variable g#attr-lib  as handle no-undo .
     6673   define variable v-attr-lib-variable as handle no-undo .
     6674   procedure gds-attr-name :
     6675     define input  parameter p-code           as character no-undo .
     6676     define output parameter p-type           as character no-undo .
     6677     define output parameter p-format         as character no-undo .
     6678     define output parameter p-label          as character no-undo .
     6679     define output parameter p-user-can-edit  as logical   no-undo .
     6680     define output parameter p-output-display as logical   no-undo .
     6681     define output parameter p-other          as character no-undo .
     6682     do
     6683     on error undo, return error
     6684     :
     6685           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     6686         (input  p-code
     6687         ,output p-type
     6688         ,output p-format
     6689         ,output p-label
     6690         ,output p-user-can-edit
     6691         ,output p-output-display
     6692         ,output p-other
     6693         ) no-error .
     6694       if error-status :error
     6695       then do:
     6696         undo, return error return-value .
     6697       end.
     6698     end.
     6699   end procedure.
