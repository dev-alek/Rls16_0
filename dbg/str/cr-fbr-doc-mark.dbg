     6722     define output parameter p-type     as character no-undo .
     6723     do
     6724     on error undo, return error
     6725     :
     6726           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6727         (input  p-gds-code
     6728         ,input  p-code
     6729         ,output p-value
     6730         ,output p-type
     6731         ) no-error .
     6732       if error-status :error
     6733       then do:
     6734         undo, return error return-value .
     6735       end.
     6736     end.
     6737   end procedure.
     6738   procedure gds-attr-write :
     6739     define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     6740     define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     6741     define input parameter p-value    like ub.goods-attr.attr-value no-undo .
     6742     do
     6743     on error undo, return error
     6744     :
     6745           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-write in g#attr-lib
     6746         (input  p-gds-code
     6747         ,input  p-code
     6748         ,input  p-value
     6749         ) no-error .
     6750       if error-status :error
     6751       then do:
     6752         undo, return error return-value .
     6753       end.
     6754     end.
     6755   end procedure.
     6756   procedure gds-attr-exist :
