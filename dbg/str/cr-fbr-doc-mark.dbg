     6758     define input  parameter p-code     like ub.goods-attr.attr-code  no-undo .
     6759     define output parameter p-exist    as logical no-undo .
     6760     do
     6761     on error undo, return error
     6762     :
     6763           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-exist in g#attr-lib
     6764         (input  p-gds-code
