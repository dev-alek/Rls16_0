     1535   procedure fbrlib_get-default-pay-code :
     1536   define input parameter p-obj-type   as character        no-undo.
     1537   define input parameter p-obj-code   as integer          no-undo.
     1538   define output parameter p-pay-code  as integer          no-undo.
     1539   define variable v-host-code as integer no-undo .
     1540   define buffer buf_shop          for ub.shop.
     1541   define buffer buf_store         for ub.store.
     1542   define buffer buf_sysconf       for ub.sysconf.
     1543   do
     1544   for buf_shop
     1545     , buf_store
     1546     , buf_sysconf
     1547   on error undo, return error
     1548   :
     1549     case p-obj-type  :
     1550       when 'маг':U then do:
     1551           find first buf_shop no-lock
     1552                 where buf_shop.obj-code = p-obj-code
     1553           no-error.
     1554           if available buf_shop
     1555           then do:
     1556               assign
     1557                   p-pay-code = buf_shop.fbr-pay
     1558               .
     1559           end.
     1560       end.
     1561       when 'скл':U then do:
     1562           find first buf_store no-lock
     1563                 where buf_store.obj-code = p-obj-code
     1564           no-error.
     1565           if available buf_store
     1566           then do:
     1567               assign
     1568                   p-pay-code = buf_store.fbr-pay
     1569               .
     1570           end.
     1571       end.
     1572     end case.
     1573     if p-pay-code = ?
     1574     or p-pay-code = 0
     1575     then do:
     1576   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1578     (input  p-obj-type
     1579     ,input  p-obj-code
     1580     ,output v-host-code
     1581     )  .
     1582         find first buf_sysconf no-lock
     1583               where buf_sysconf.host-code = v-host-code
     1584         no-error.
     1585         if available buf_sysconf
     1586         then do:
     1587             assign
     1588                 p-pay-code = buf_sysconf.fbr-pay
     1589             .
     1590         end.
     1591     end.
     1592     if p-pay-code = ?
     1593     or p-pay-code = 0
     1594     then do:
     1595   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1597     (input  p-obj-type
     1598     ,input  p-obj-code
     1599     ,output p-pay-code
     1600     )  .
     1601     end.
     1602   end.
     1603   end procedure.
     1604   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1605   do
     1606   on error undo, return error
     1607   :
     1608   define input parameter p-fbr-doc-code as character    no-undo.
     1609       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1610       define variable v-gds-name      as character    no-undo.
     1611       define buffer buf_fbr-doc               for ub.fbr-doc.
     1612       define buffer buf_fbr-line              for ub.fbr-line.
     1613       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1614       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1615       find first buf_fbr-doc no-lock
     1616            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1617       .
     1618       for each buf_temp_fbrlib_recipe
     1619       :
     1620           delete buf_temp_fbrlib_recipe.
     1621       end.
     1622       for each buf_fbr-line no-lock
     1623          where buf_fbr-line.doc-code = p-fbr-doc-code
     1624       :
     1625           find first buf_temp_fbrlib_recipe
     1626                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1627           no-error.
     1628           if not available buf_temp_fbrlib_recipe
     1629           then do:
     1630               create buf_temp_fbrlib_recipe.
     1631               assign
     1632                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1633                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1634               .
     1635           end.
     1636       end.
     1637       for each buf_temp_fbrlib_recipe
     1638       :
     1639           assign
     1640               buf_temp_fbrlib_recipe.count-income                = 0
     1641               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1642               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1643               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1644               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1645               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1646               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1647               buf_temp_fbrlib_recipe.count-write-off             = 0
     1648               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1649               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1650               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1651               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1652               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1653               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1654           .
     1655           for each buf_fbr-line no-lock
     1656              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1657                and buf_fbr-line.trn-type     = 'при':U
     1658                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1659           :
     1660               if ( buf_fbr-line.price-base   = ?
     1661                   or buf_fbr-line.price-rubl = ?
     1662                   or buf_fbr-line.price-base <= 0
     1663                   or buf_fbr-line.price-rubl <= 0 )
     1664               and buf_fbr-line.fact-qnty <> 0
     1665               and buf_fbr-line.rsrv-qnty <> ?
     1666               and buf_fbr-doc.is-free    = no
     1667               then do:
     1668   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1670     (input  buf_fbr-line.artic
     1671     ,input  buf_fbr-line.prod-type
     1672     ,input  buf_fbr-line.prod-code
     1673     ,output v-gds-name
     1674     ) no-error .
     1675                   if error-status :error
     1676                   then do:
     1677                       assign
     1678                           v-gds-name = ""
     1679                       .
     1680                   end.
     1681                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1682                                                 ,vss-description
     1683                                                 ,buf_fbr-doc.doc-code
     1684                                                 ,chr(10)
     1685                                                 ,buf_fbr-line.recipe-code
     1686                                                 ,buf_fbr-line.artic
     1687                                                 ,v-gds-name).
     1688               end.
     1689               assign
     1690                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1691                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1692                                                                   + buf_fbr-line.fact-qnty
     1693                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1694                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1695               .
     1696               if buf_fbr-line.is-waste = no
     1697               then do:
     1698                   assign
     1699                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1700                                                                       + buf_fbr-line.price-sum-base
     1701                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1702                                                                       + buf_fbr-line.price-sum-rubl
     1703                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1704                                                                       + buf_fbr-line.price-sum-vat-base
     1705                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1706                                                                       + buf_fbr-line.price-sum-vat-rubl
     1707                   .
     1708               end.
     1709           end.
     1710           for each buf_fbr-line no-lock
     1711              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1712                and buf_fbr-line.trn-type     = 'спи':U
     1713                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1714           :
     1715               if ( buf_fbr-line.price-base   = ?
     1716                   or buf_fbr-line.price-rubl = ?
     1717                   or buf_fbr-line.price-base <= 0
     1718                   or buf_fbr-line.price-rubl <= 0 )
     1719               and buf_fbr-line.fact-qnty <> 0
     1720               and buf_fbr-line.rsrv-qnty <> ?
     1721               and buf_fbr-doc.is-free    = no
     1722               and buf_fbr-doc.status_    = 'разрешен':U
     1723               then do:
     1724   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1725   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1726     (input  buf_fbr-line.artic
     1727     ,input  buf_fbr-line.prod-type
     1728     ,input  buf_fbr-line.prod-code
     1729     ,output v-gds-name
     1730     ) no-error .
     1731                   if error-status :error
     1732                   then do:
     1733                       assign
     1734                           v-gds-name = ""
     1735                       .
     1736                   end.
     1737                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1738                                                 ,vss-description
     1739                                                 ,buf_fbr-doc.doc-code
     1740                                                 ,chr(10)
     1741                                                 ,buf_fbr-line.recipe-code
     1742                                                 ,buf_fbr-line.artic
     1743                                                 ,v-gds-name).
     1744               end.
     1745               assign
     1746                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1747                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1748                                                                   + buf_fbr-line.fact-qnty
     1749                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1750                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1751               .
     1752               if buf_fbr-line.is-waste = no
     1753               then do:
     1754                   assign
     1755                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1756                                                                       + buf_fbr-line.price-sum-base
     1757                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1758                                                                       + buf_fbr-line.price-sum-rubl
     1759                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1760                                                                       + buf_fbr-line.price-sum-vat-base
     1761                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1762                                                                       + buf_fbr-line.price-sum-vat-rubl
     1763                   .
     1764               end.
     1765           end.
     1766           if buf_fbr-doc.status_    = 'разрешен':U
     1767           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1768           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1769           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1770           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1771               )
     1772           then do:
     1773            undo, return error
     1774               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1775                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1776                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1777                           "Сумма в &9.&4&7&4&4&8&2"
     1778                          , buf_fbr-doc.doc-code
     1779                          , chr(10)
     1780                          , buf_temp_fbrlib_recipe.recipe-code
     1781                          , chr(9)
     1782                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1783                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1784                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1785                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1786                          , "руб"
     1787                          )
     1788              +
     1789              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1790                         "НДС в &7.&1&5&1&1&6&4"
     1791                        ,  chr(9)
     1792                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1793                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1794                        ,chr(10)
     1795                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1796                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1797                        ,"руб"
     1798                        )       .
     1799           end.
     1800       end.
     1801   end.
     1802   end procedure.
     1803   procedure fbrlib-fill-sum-fbr-doc :
     1804   do
     1805   on error undo, return error
     1806   :
     1807   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1808   define input parameter p-mode           as character    no-undo.
     1809       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1810       define buffer buf_fbr-doc           for ub.fbr-doc.
     1811       define buffer buf_fbr-line          for ub.fbr-line.
     1812       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1813       define variable v-in-count          as integer       no-undo.
     1814       define variable v-out-count         as integer       no-undo.
     1815       find first buf_fbr-doc exclusive-lock
     1816            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1817       .
     1818       find first buf_temp_fbrlib_recipe no-error.
     1819       if not available buf_temp_fbrlib_recipe
     1820       then do:
     1821           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1822               input buf_fbr-doc.doc-code
     1823           ) no-error.
     1824           if error-status :error
     1825           then do:
     1826               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1827                                              , vss-description
     1828                                              , chr(10)
     1829                                              , error-status:get-message(1)
     1830                                              , return-value ).
     1831           end.
     1832       end.
     1833       assign
     1834           v-in-count                  = 0
     1835           buf_fbr-doc.in-qnty         = 0
     1836           buf_fbr-doc.in-sale         = 0
     1837           buf_fbr-doc.in-base         = 0
     1838           buf_fbr-doc.in-rubl         = 0
     1839           buf_fbr-doc.in-vat-base     = 0
     1840           buf_fbr-doc.in-vat-rubl     = 0
     1841           v-out-count                 = 0
     1842           buf_fbr-doc.out-qnty        = 0
     1843           buf_fbr-doc.out-sale        = 0
     1844           buf_fbr-doc.out-base        = 0
     1845           buf_fbr-doc.out-rubl        = 0
     1846           buf_fbr-doc.out-vat-base    = 0
     1847           buf_fbr-doc.out-vat-rubl    = 0
     1848       .
     1849       for each buf_temp_fbrlib_recipe
     1850       :
     1851           assign
     1852               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1853               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1854               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1855               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1856               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1857               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1858               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1859               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1860               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1861               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1862               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1863               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1864               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1865               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1866           .
     1867       end.
     1868       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1869       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1870       or p-mode <> 'факт':U
     1871       then do:
     1872           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1873           then do:
     1874               assign
     1875                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1876                                   + string( v-out-count, ">>>,>>9" )
     1877                                   + chr(10) + "Строк исходных товаров : "
     1878                                   + string( v-in-count, ">>>,>>9" )
     1879               .
     1880           end.
     1881       end.
     1882       else do:
     1883         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1884                                       "Сумма списанных товаров в &3 - &4&2" +
     1885                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1886                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1887                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1888                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1889                                       , buf_fbr-doc.doc-code
     1890                                       , chr(10)
     1891                                       , "рублях"
     1892                                       , round( buf_fbr-doc.out-rubl, 2 )
     1893                                       , round( buf_fbr-doc.in-rubl,  2 )
     1894                                       , round( buf_fbr-doc.in-rubl,  2 )
     1895                                       , round( buf_fbr-doc.out-base, 2 )
     1896                                       , round( buf_fbr-doc.in-base,  2 )).
     1897       end.
     1898   end.
     1899   end procedure.
     1900   procedure fbrlib-calc-prices :
     1901   do
     1902   on error undo, return error
     1903   :
     1904   define input parameter p-fbr-line-recid as recid        no-undo.
     1905   define input parameter p-price-obj-type as character    no-undo.
     1906   define input parameter p-price-obj-code as integer      no-undo.
     1907   define output parameter p-current-price as decimal      no-undo.
     1908       define variable v-void          as decimal       no-undo.
     1909       define variable v-void-char     as character     no-undo.
     1910       define variable v-gds-code      as integer       no-undo.
     1911       define variable v-b-code        as integer       no-undo.
     1912       define buffer buf_fbr-doc   for ub.fbr-doc.
     1913       define buffer buf_fbr-line  for ub.fbr-line.
     1914       define buffer buf_gds-prt   for ub.gds-prt.
     1915       define buffer buf_bar-code  for ub.bar-code.
     1916       find first buf_fbr-line no-lock
     1917           where recid( buf_fbr-line ) = p-fbr-line-recid
     1918       .
     1919   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1921     (input  buf_fbr-line.artic
     1922     ,input  buf_fbr-line.prod-type
     1923     ,input  buf_fbr-line.prod-code
     1924     ,output v-gds-code
     1925     ) no-error .
     1926       if error-status :error
     1927       then do:
     1928         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1929                                         ,vss-workfile
     1930                                         ,vss-revision
     1931                                         ,vss-description
     1932                                         ,chr(10)
     1933                                         , error-status:get-message(1)
     1934                                         , return-value
     1935                                         , buf_fbr-line.artic
     1936                                         ).
     1937       end.
     1938   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1939     (input  v-gds-code
     1940     ,input  ?
     1941     ,output v-b-code
     1942     ) no-error .
     1943       if error-status :error
     1944       then do:
     1945         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1946                                         ,vss-workfile
     1947                                         ,vss-revision
     1948                                         ,vss-description
     1949                                         ,chr(10)
     1950                                         , error-status:get-message(1)
     1951                                         , return-value
     1952                                         , v-gds-code
     1953                                         ).
     1954       end.
     1955       if buf_fbr-line.is-calc = no
     1956       then do:
     1957   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1959     (input  p-price-obj-type
     1960     ,input  p-price-obj-code
     1961     ,input  v-b-code
     1962     ,input  0
     1963     ,input  0
     1964     ,output v-void-char
     1965     ,output p-current-price
     1966     ,output v-void
     1967     ,output v-void
     1968     ) no-error .
     1969           if error-status :error
     1970           then do:
     1971             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1972                                             ,vss-workfile
     1973                                             ,vss-revision
     1974                                             ,vss-description
     1975                                             ,chr(10)
     1976                                             , error-status:get-message(1)
     1977                                             , return-value
     1978                                             , v-gds-code
     1979                                             ).
     1980           end.
     1981       end.
     1982       else do:
     1983           assign
     1984               p-current-price = buf_fbr-line.price-sale
     1985           .
     1986       end.
     1987   end.
     1988   end procedure.
     1989   procedure fbrlib-put-in-order-recipe :
     1990   do
     1991   on error undo, return error
     1992   :
     1993   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1994       define variable v-recipe-counter    as integer          no-undo.
     1995       define variable v-recipe-amount     as integer init 0   no-undo.
     1996       define variable v-child-counter     as integer          no-undo.
     1997       define variable v-is-call-cycle     as logical          no-undo.
     1998       define variable v-str as character     no-undo.
     1999       define buffer buf_in_fbr-line       for ub.fbr-line.
     2000       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2001       define buffer buf_fbr-line          for ub.fbr-line.
     2002       define buffer buf_recipe-gds        for ub.recipe-gds.
     2003       define buffer buf_recipe            for ub.recipe.
     2004       for each temp_recipe-childs-qnty
     2005       :
     2006           delete temp_recipe-childs-qnty.
     2007       end.
     2008       for each temp_recipe-childs
     2009       :
     2010           delete temp_recipe-childs.
     2011       end.
     2012       for each temp_recipe-order
     2013       :
     2014           delete temp_recipe-order.
     2015       end.
     2016       for each buf_fbr-line no-lock
     2017          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2018       on error undo, return error
     2019       :
     2020           find first temp_recipe-childs-qnty
     2021                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2022           no-error.
     2023           if not available temp_recipe-childs-qnty
     2024           then do:
     2025               create temp_recipe-childs-qnty.
     2026               assign
     2027                   v-recipe-amount                     = v-recipe-amount + 1
     2028                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2029                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2030                   temp_recipe-childs-qnty.childs-qnty = 0
     2031                   v-child-counter                     = 0
     2032               .
     2033           end.
     2034       end.
     2035       for each buf_in_fbr-line no-lock
     2036          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2037            and buf_in_fbr-line.trn-type = 'спи':U
     2038       on error undo, return error
     2039       :
     2040           for each buf_dress_fbr-line no-lock
     2041              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2042                and buf_dress_fbr-line.trn-type    = 'при':U
     2043                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2044                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2045                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2046           on error undo, return error
     2047           :
     2048               find first buf_recipe no-lock
     2049                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2050               .
     2051               if buf_in_fbr-line.is-comp = yes
     2052               then do:
     2053                   find last temp_recipe-childs-qnty
     2054                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2055                   .
     2056                   assign
     2057                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2058                   .
     2059                   create temp_recipe-childs.
     2060                   assign
     2061                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2062                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2063                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2064                   .
     2065               end.
     2066               else do:
     2067               end.
     2068           end.
     2069       end.
     2070       for each buf_in_fbr-line no-lock
     2071          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2072            and buf_in_fbr-line.trn-type = 'при':U
     2073       on error undo, return error
     2074       :
     2075           find first buf_recipe no-lock
     2076                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2077           no-error.
     2078           if buf_in_fbr-line.is-comp = no
     2079           then do:
     2080           end.
     2081           else do:
     2082               for each buf_recipe-gds no-lock
     2083               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2084               :
     2085                   for each buf_fbr-line no-lock
     2086                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2087                       and buf_fbr-line.trn-type    = 'при':U
     2088                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2089                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2090                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2091                   on error undo, return error
     2092                   :
     2093                       find first buf_recipe no-lock
     2094                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2095                       .
     2096                       if buf_recipe.recipe-type = 'разделка':U
     2097                       then do:
     2098                       end.
     2099                       else do:
     2100                           find last temp_recipe-childs-qnty
     2101                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2102                           .
     2103                           assign
     2104                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2105                           .
     2106                           create temp_recipe-childs.
     2107                           assign
     2108                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2109                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2110                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2111                           .
     2112                       end.
     2113                   end.
     2114               end.
     2115           end.
     2116       end.
     2117       for each temp_recipe-order
     2118       on error undo, return error
     2119       :
     2120           delete temp_recipe-order.
     2121       end.
     2122       assign
     2123           v-fbrlib-recipe-order = 0
     2124       .
     2125       do v-recipe-counter = 1 to v-recipe-amount
     2126       on error undo, return error
     2127       :
     2128           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2129                 input v-recipe-counter
     2130               , input 0
     2131               , output v-is-call-cycle
     2132           ).
     2133           if v-is-call-cycle = yes
     2134           then do:
     2135               message
     2136                       "Достигнут максимальный уровень вложенности рецептов."
     2137                   skip(1)
     2138                   skip "Невозможно упорядочить рецепты."
     2139                   skip(1)
     2140                   skip "Необходимо изменить структуру рецептов,"
     2141                   skip "используемых при формировании"
     2142                   skip "данного документа производства."
     2143               view-as alert-box error
     2144               title "Невозможно рассчитать документ производства".
     2145               for each temp_recipe-childs-qnty
     2146               :
     2147                   delete temp_recipe-childs-qnty.
     2148               end.
     2149               for each temp_recipe-childs
     2150               :
     2151                   delete temp_recipe-childs.
     2152               end.
     2153               for each temp_recipe-order
     2154               :
     2155                   delete temp_recipe-order.
     2156               end.
     2157               for each temp_recipe-order
     2158               on error undo, return error
     2159               :
     2160                   delete temp_recipe-order.
     2161               end.
     2162               for each temp_fbrlib_recipe
     2163               on error undo, return error
     2164               :
     2165                   delete temp_recipe-order.
     2166               end.
     2167               undo, return error.
     2168           end.
     2169       end.
     2170   end.
     2171   end procedure.
     2172   procedure fbrlib-add-recipe-in-tmp-order :
     2173   do
     2174   on error undo, return error
     2175   :
     2176   define input parameter p-order              as integer      no-undo.
     2177   define input parameter p-call-counter       as integer      no-undo.
     2178   define output parameter p-is-call-cycle     as logical      no-undo.
     2179       define variable v-nodes-counter     as integer       no-undo.
     2180       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2181       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2182       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2183       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2184       assign
     2185           p-call-counter = p-call-counter + 1
     2186       .
     2187       if p-call-counter > 50
     2188       then do:
     2189           assign
     2190               p-is-call-cycle = yes
     2191           .
     2192       end.
     2193       else do:
     2194           find first buf_temp_recipe-childs-qnty
     2195                where buf_temp_recipe-childs-qnty.order = p-order
     2196           .
     2197           find first buf_temp_recipe-order
     2198                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2199           no-error.
     2200           if not available buf_temp_recipe-order
     2201           then do:
     2202               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2203               :
     2204                   find first buf_temp_recipe-childs
     2205                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2206                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2207                   .
     2208                   find first buf_c_temp_recipe-childs-qnty
     2209                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2210                   .
     2211                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2212                         input buf_c_temp_recipe-childs-qnty.order
     2213                       , input p-call-counter
     2214                       , output p-is-call-cycle
     2215                   ).
     2216                   if p-is-call-cycle = yes
     2217                   then do:
     2218                       return.
     2219                   end.
     2220               end.
     2221               assign
     2222                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2223               .
     2224               create buf_temp_recipe-order.
     2225               assign
     2226                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2227                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2228               .
     2229           end.
     2230       end.
     2231   end.
     2232   end procedure.
     2233   procedure fbrlib-get-trn-type :
     2234   define input parameter p-recipe-code    as character    no-undo.
     2235   define input parameter p-goods-recid    as recid        no-undo.
     2236   define input parameter p-is-integration as logical      no-undo.
     2237   define output parameter p-is-comp       as logical      no-undo.
     2238   define output parameter p-trn-type      as character    no-undo.
     2239   define buffer buf_recipe    for ub.recipe.
     2240   define buffer buf_goods     for ub.goods.
     2241   do
     2242   for buf_recipe
     2243     , buf_goods
     2244   on error undo, return error
     2245   :
     2246       find first buf_goods no-lock
     2247            where recid( buf_goods ) = p-goods-recid
     2248       .
     2249       find first buf_recipe no-lock
     2250            where buf_recipe.recipe-code = p-recipe-code
     2251       no-error.
     2252       if not available buf_recipe
     2253       then do:
     2254           assign
     2255               p-is-comp = no
     2256               p-trn-type = "":U
     2257           .
     2258           undo, return.
     2259       end.
     2260       if  buf_recipe.artic        = buf_goods.artic
     2261       and buf_recipe.prod-type    = buf_goods.prod-type
     2262       and buf_recipe.prod-code    = buf_goods.prod-code
     2263       then do:
     2264           assign
     2265               p-is-comp = yes
     2266           .
     2267       end.
     2268       else do:
     2269           assign
     2270               p-is-comp = no
     2271           .
     2272       end.
     2273       case buf_recipe.recipe-type
     2274       :
     2275           when 'производство':U
     2276           then do:
     2277               if p-is-comp = yes
     2278               then do:
     2279                   assign
     2280                       p-trn-type = 'при':U
     2281                   .
     2282               end.
     2283               else do:
     2284                   assign
     2285                       p-trn-type = 'спи':U
     2286                   .
     2287               end.
     2288           end.
     2289           when 'альтернатива':U
     2290           then do:
     2291               if p-is-comp = yes
     2292               then do:
     2293                   assign
     2294                       p-trn-type = 'при':U
     2295                   .
     2296               end.
     2297               else do:
     2298                   assign
     2299                       p-trn-type = 'спи':U
     2300                   .
     2301               end.
     2302           end.
     2303           when 'разделка':U
     2304           then do:
     2305               if p-is-comp = no
     2306               then do:
     2307                   assign
     2308                       p-trn-type = 'при':U
     2309                   .
     2310               end.
     2311               else do:
     2312                   assign
     2313                       p-trn-type = 'спи':U
     2314                   .
     2315               end.
     2316           end.
     2317           when 'комплектация':U
     2318           then do:
     2319               if p-is-integration = ?
     2320               then do:
     2321                   message
     2322                       "Выберите тип операции по рецепту комплектации:"
     2323                       skip (2) "YES - комплектация"
     2324                       skip     "NO - разукомплектация"
     2325                   view-as alert-box question
     2326                   buttons YES-NO
     2327                   update p-is-integration.
     2328               end.
     2329               if p-is-integration = yes
     2330               then do:
     2331                   if p-is-comp = yes
     2332                   then do:
     2333                       assign
     2334                           p-trn-type = 'при':U
     2335                       .
     2336                   end.
     2337                   else do:
     2338                       assign
     2339                           p-trn-type = 'спи':U
     2340                       .
     2341                   end.
     2342               end.
     2343               else do:
     2344                   if p-is-comp = yes
     2345                   then do:
     2346                       assign
     2347                           p-trn-type = 'спи':U
     2348                       .
     2349                   end.
     2350                   else do:
     2351                       assign
     2352                           p-trn-type = 'при':U
     2353                       .
     2354                   end.
     2355               end.
     2356           end.
     2357       end case.
     2358   end.
     2359   end procedure.
     2360   procedure fbrlib-get-mark :
     2361   define input parameter p-recipe-code    as character    no-undo.
     2362   define output parameter p-mark          as logical    no-undo.
     2363   define buffer buf_goods-attr     for ub.goods-attr.
     2364   define buffer buf_recipe-gds for ub.recipe-gds .
     2365       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2366            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2367                                               buf_goods-attr.attr-code = 'mark-type':U:
     2368            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2369               p-mark = true .
     2370               return .
     2371            end.
     2372       end.
     2373   end procedure.
     2374   procedure fbrlib-check-temp-tables :
     2375   do
     2376   on error undo, return error
     2377   :
     2378   define input parameter p-title  as character    no-undo.
     2379       define variable v-str               as character        no-undo.
     2380       assign
     2381           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2382       .
     2383       for each temp_recipe-childs-qnty
     2384       on error undo, return error
     2385       :
     2386           assign
     2387               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2388                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2389                       + "   " + string( temp_recipe-childs-qnty.order )
     2390                       + chr(10)
     2391           .
     2392       end.
     2393       assign
     2394           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2395       .
     2396       for each temp_recipe-childs
     2397       on error undo, return error
     2398       :
     2399           assign
     2400               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2401                       + "   " + string( temp_recipe-childs.child-code )
     2402                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2403                       + chr(10)
     2404           .
     2405       end.
     2406       assign
     2407           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2408       .
     2409       for each temp_recipe-order
     2410       on error undo, return error
     2411       :
     2412           assign
     2413               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2414                       + "   " + string( temp_recipe-order.order )
     2415                       + chr(10)
     2416           .
     2417       end.
     2418       assign
     2419           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2420       .
     2421       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2422       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2423       for each temp_fbrlib_recipe
     2424       on error undo, return error
     2425       :
     2426           assign
     2427               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2428                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2429                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2430                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2431                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2432                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2433                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2434                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2435                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2436                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2437                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2438                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2439                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2440                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2441                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2442                       + chr(10)
     2443           .
     2444           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2445       end.
     2446   end.
     2447   end procedure.
     2448   procedure fbrlib-s-coeff-value :
     2449   define input  parameter p-gds-code    as integer        no-undo.
     2450   define input  parameter p-date        as date           no-undo.
     2451   define input  parameter p-obj-type    as character      no-undo.
     2452   define input  parameter p-obj-code    as integer        no-undo.
     2453   define output parameter p-coeff-value as decimal        no-undo.
     2454   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2455       define variable v-date          as date         no-undo.
     2456       define variable v-host-code     as integer      no-undo.
     2457       define buffer buf_goods       for ub.goods.
     2458       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2459       define buffer buf_clients     for ub.clients.
     2460       define buffer buf_s-coeff     for ub.s-coeff.
     2461   do
     2462   for buf_goods
     2463     , buf_fbr-gds-obj
     2464     , buf_clients
     2465     , buf_s-coeff
     2466   on error undo, return error return-value
     2467   :
     2468       find first buf_goods no-lock
     2469            where buf_goods.gds-code = p-gds-code
     2470       no-error .
     2471       if not available buf_goods
     2472       then do:
     2473          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2474       end.
     2475       find first buf_clients no-lock
     2476            where buf_clients.obj-type = p-obj-type
     2477              and buf_clients.obj-code = p-obj-code
     2478       no-error.
     2479       if not available buf_clients
     2480       then do:
     2481          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2482       end.
     2483       assign
     2484           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2485       .
     2486       find first buf_fbr-gds-obj no-lock
     2487            where buf_fbr-gds-obj.gds-code = p-gds-code
     2488              and buf_fbr-gds-obj.obj-type = p-obj-type
     2489              and buf_fbr-gds-obj.obj-code = p-obj-code
     2490       no-error.
     2491       if not available buf_fbr-gds-obj
     2492       or buf_fbr-gds-obj.is-season = no
     2493       then do:
     2494           assign
     2495               p-coeff-value = 0
     2496           .
     2497           return.
     2498       end.
     2499   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2501     (input  p-obj-type
     2502     ,input  p-obj-code
     2503     ,output v-host-code
     2504     )  .
     2505       find last buf_s-coeff no-lock
     2506           where buf_s-coeff.gds-code = p-gds-code
     2507             and buf_s-coeff.host-code = v-host-code
     2508             and buf_s-coeff.obj-type = p-obj-type
     2509             and buf_s-coeff.obj-code = p-obj-code
     2510             and buf_s-coeff.s-date <= v-date
     2511       no-error.
     2512       if available buf_s-coeff
     2513       then do:
     2514           assign
     2515               p-coeff-value = buf_s-coeff.coeff-value
     2516           .
     2517           return.
     2518       end.
     2519       find last buf_s-coeff no-lock
     2520           where buf_s-coeff.gds-code = p-gds-code
     2521             and buf_s-coeff.host-code = v-host-code
     2522             and buf_s-coeff.obj-type = "":U
     2523             and buf_s-coeff.obj-code = 0
     2524             and buf_s-coeff.s-date <= v-date
     2525       no-error.
     2526       if available buf_s-coeff
     2527       then do:
     2528           assign
     2529               p-coeff-value = buf_s-coeff.coeff-value
     2530           .
     2531           return.
     2532       end.
     2533       find last buf_s-coeff no-lock
     2534           where buf_s-coeff.gds-code = p-gds-code
     2535             and buf_s-coeff.host-code = 0
     2536             and buf_s-coeff.obj-type = "":U
     2537             and buf_s-coeff.obj-code = 0
     2538             and buf_s-coeff.s-date <= v-date
     2539       no-error.
     2540       if available buf_s-coeff
     2541       then do:
     2542           assign
     2543               p-coeff-value = buf_s-coeff.coeff-value
     2544           .
     2545       end.
     2546       else do:
     2547           assign
     2548               p-coeff-value = 0
     2549           .
     2550       end.
     2551   end.
     2552   end procedure.
     2553   procedure fbrlib_create-fbr-recipe-gds :
     2554   define input parameter p-doc-code         as character      no-undo.
     2555   define input parameter p-recipe-code      as character      no-undo.
     2556   define input parameter p-prod-type        as character      no-undo.
     2557   define input parameter p-prod-code        as integer        no-undo.
     2558   define input parameter p-artic            as character      no-undo.
     2559   define input parameter p-gds-code         as integer        no-undo.
     2560   define input parameter p-is-waste         as logical        no-undo.
     2561   define input parameter p-proc-number      as integer        no-undo.
     2562   define input parameter p-obj-date         as date           no-undo.
     2563   define input parameter p-obj-type         as character      no-undo.
     2564   define input parameter p-obj-code         as integer        no-undo.
     2565   define input parameter p-calc-method      as decimal        no-undo.
     2566   define input parameter p-coeff-waste      as decimal        no-undo.
     2567   define input parameter p-orig-qnty        as decimal        no-undo.
     2568   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2569       define variable v-coeff-season  as decimal      no-undo.
     2570       define variable v-void-decimal  as decimal      no-undo.
     2571       define variable v-void-integer  as integer      no-undo.
     2572       define variable v-recipe-type   as character    no-undo.
     2573       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2574       define buffer buf_goods             for ub.goods.
     2575       define buffer buf_recipe            for ub.recipe.
     2576   do
     2577   for buf_fbr-recipe-gds
     2578     , buf_recipe
     2579     , buf_goods
     2580   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2581   :
     2582       find first buf_fbr-recipe-gds exclusive-lock
     2583            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2584              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2585              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2586              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2587              and buf_fbr-recipe-gds.artic       = p-artic
     2588       no-error.
     2589       if not available buf_fbr-recipe-gds
     2590       then do:
     2591           create buf_fbr-recipe-gds.
     2592           assign
     2593               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2594               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2595               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2596               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2597               buf_fbr-recipe-gds.artic              = p-artic
     2598               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2599               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2600               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2601               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2602               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2603           .
     2604           find first buf_goods no-lock
     2605                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2606                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2607                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2608           .
     2609           run fbrlib-s-coeff-value in this-procedure (
     2610                 input buf_goods.gds-code
     2611               , input p-obj-date
     2612               , input p-obj-type
     2613               , input p-obj-code
     2614               , output v-coeff-season
     2615           ) no-error.
     2616           if error-status:error
     2617           then do:
     2618               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2619           end.
     2620           assign
     2621               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2622               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2623               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2624           .
     2625           run fbrlib-get-recipe-type in this-procedure (
     2626                 input buf_fbr-recipe-gds.doc-code
     2627               , input buf_fbr-recipe-gds.recipe-code
     2628               , output v-recipe-type
     2629           ).
     2630           if v-recipe-type <> 'производство':U
     2631           then do:
     2632               assign
     2633                   buf_fbr-recipe-gds.coeff-value  = 0
     2634                   buf_fbr-recipe-gds.coeff-waste  = 0
     2635                   buf_fbr-recipe-gds.calc-method  = 1
     2636                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2637               .
     2638           end.
     2639           else do:
     2640               run fbrlib-calc-brutto in this-procedure (
     2641                     input v-recipe-type
     2642                   , input buf_fbr-recipe-gds.qnty
     2643                   , input buf_fbr-recipe-gds.coeff-value
     2644                   , input buf_fbr-recipe-gds.coeff-waste
     2645                   , input 0
     2646                   , input 3
     2647                   , output v-void-decimal
     2648                   , output v-void-decimal
     2649                   , output buf_fbr-recipe-gds.brutto-qnty
     2650                   , output v-void-integer
     2651               ).
     2652               assign
     2653                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2654               .
     2655               run fbrlib-calc-brutto in this-procedure (
     2656                     input v-recipe-type
     2657                   , input buf_fbr-recipe-gds.qnty
     2658                   , input buf_fbr-recipe-gds.coeff-value
     2659                   , input buf_fbr-recipe-gds.coeff-waste
     2660                   , input buf_fbr-recipe-gds.brutto-qnty
     2661                   , input buf_fbr-recipe-gds.calc-method
     2662                   , output buf_fbr-recipe-gds.qnty
     2663                   , output v-void-decimal
     2664                   , output v-void-decimal
     2665                   , output v-void-integer
     2666               ).
     2667           end.
     2668       end.
     2669   end.
     2670   end procedure.
     2671   procedure fbrlib-set-default-recipe :
     2672   define input parameter p-obj-type   as character    no-undo.
     2673   define input parameter p-obj-code   as integer      no-undo.
     2674   define input parameter p-gds-code   as integer      no-undo.
     2675       define variable v-artic             as character    no-undo.
     2676       define variable v-prod-type         as character    no-undo.
     2677       define variable v-prod-code         as character    no-undo.
     2678       define variable v-recipe-code       as character    no-undo.
     2679       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2680       define variable v-recipe-found      as logical      no-undo.
     2681       define buffer buf_recipe        for ub.recipe.
     2682       define buffer buf_other_recipe  for ub.recipe.
     2683       define buffer buf_goods         for ub.goods.
     2684       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2685   do
     2686   for buf_recipe
     2687     , buf_goods
     2688     , buf_fbr-gds-obj
     2689   on error undo, return error
     2690   :
     2691       find first buf_goods no-lock
     2692            where buf_goods.gds-code = p-gds-code
     2693       .
     2694       run fbrlib-get-obj-recipe in this-procedure (
     2695             input p-obj-type
     2696           , input p-obj-code
     2697           , input p-gds-code
     2698           , output v-recipe-code
     2699       ).
     2700       if v-recipe-code <> ""
     2701       then do:
     2702           find first buf_recipe no-lock
     2703               where buf_recipe.recipe-code = v-recipe-code
     2704           no-error.
     2705           if not available buf_recipe
     2706           then do:
     2707               assign
     2708                   v-recipe-code = ""
     2709               .
     2710           end.
     2711       end.
     2712       if v-recipe-code = ""
     2713       then do:
     2714           find first buf_fbr-gds-obj exclusive-lock
     2715                where buf_fbr-gds-obj.obj-type = p-obj-type
     2716                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2717                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2718           no-error.
     2719           if not available buf_fbr-gds-obj
     2720           then do:
     2721               run ref/fgdsobj1.p (
     2722                     input-output v-fbr-gds-obj-recid
     2723                   , input 'ДОБАВЛЕНИЕ':U
     2724                   , input no
     2725                   , input p-gds-code
     2726                   , input p-obj-type
     2727                   , input p-obj-code
     2728                   , input 0
     2729                   , input ""
     2730                   , input 0
     2731                   , input no
     2732                   , input no
     2733                   , input no
     2734                   , input no
     2735                   , input no
     2736                   , input no
     2737               ) no-error.
     2738               if error-status:error
     2739               then do:
     2740                   message
     2741                           vss-workfile vss-revision vss-description
     2742                       skip "Ошибка изменения атрибутов товара на объекте"
     2743                       skip return-value
     2744                       skip trim(error-status :get-message(1))
     2745                               trim(error-status :get-message(2))
     2746                               trim(error-status :get-message(3))
     2747                   view-as alert-box error.
     2748                   undo, return error .
     2749               end.
     2750               find first buf_fbr-gds-obj exclusive-lock
     2751                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2752               .
     2753           end.
     2754           assign
     2755               v-recipe-found = no
     2756           .
     2757           for first buf_recipe no-lock
     2758               where buf_recipe.obj-type    = p-obj-type
     2759                 and buf_recipe.obj-code    = p-obj-code
     2760                 and buf_recipe.artic       = buf_goods.artic
     2761                 and buf_recipe.prod-type   = buf_goods.prod-type
     2762                 and buf_recipe.prod-code   = buf_goods.prod-code
     2763                 and buf_recipe.recipe-type = 'производство':U
     2764                 or (
     2765                     buf_recipe.obj-type    = ""
     2766                 and buf_recipe.obj-code    = 0
     2767                 and buf_recipe.artic       = buf_goods.artic
     2768                 and buf_recipe.prod-type   = buf_goods.prod-type
     2769                 and buf_recipe.prod-code   = buf_goods.prod-code
     2770                 and buf_recipe.recipe-type = 'производство':U
     2771                     )
     2772           :
     2773               assign
     2774                   v-recipe-found = yes
     2775                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2776               .
     2777           end.
     2778           if v-recipe-found = no
     2779           then do:
     2780               for first buf_recipe no-lock
     2781                   where buf_recipe.obj-type    = p-obj-type
     2782                     and buf_recipe.obj-code    = p-obj-code
     2783                     and buf_recipe.artic       = buf_goods.artic
     2784                     and buf_recipe.prod-type   = buf_goods.prod-type
     2785                     and buf_recipe.prod-code   = buf_goods.prod-code
     2786                     and buf_recipe.recipe-type <> 'альтернатива':U
     2787                     or (
     2788                         buf_recipe.obj-type    = ""
     2789                     and buf_recipe.obj-code    = 0
     2790                     and buf_recipe.artic       = buf_goods.artic
     2791                     and buf_recipe.prod-type   = buf_goods.prod-type
     2792                     and buf_recipe.prod-code   = buf_goods.prod-code
     2793                     and buf_recipe.recipe-type <> 'альтернатива':U
     2794                         )
     2795               :
     2796                   assign
     2797                       v-recipe-found = yes
     2798                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2799                   .
     2800               end.
     2801               if v-recipe-found = no
     2802               then do:
     2803                   for first buf_recipe no-lock
     2804                       where buf_recipe.obj-type    = p-obj-type
     2805                         and buf_recipe.obj-code    = p-obj-code
     2806                         and buf_recipe.artic       = buf_goods.artic
     2807                         and buf_recipe.prod-type   = buf_goods.prod-type
     2808                         and buf_recipe.prod-code   = buf_goods.prod-code
     2809                         or (
     2810                             buf_recipe.obj-type    = ""
     2811                         and buf_recipe.obj-code    = 0
     2812                         and buf_recipe.artic       = buf_goods.artic
     2813                         and buf_recipe.prod-type   = buf_goods.prod-type
     2814                         and buf_recipe.prod-code   = buf_goods.prod-code
     2815                             )
     2816                   :
     2817                       assign
     2818                           v-recipe-found = yes
     2819                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2820                       .
     2821                   end.
     2822                   if v-recipe-found = no
     2823                   then do:
     2824                       assign
     2825                           buf_fbr-gds-obj.default-recipe-code = ""
     2826                       .
     2827                   end.
     2828               end.
     2829           end.
     2830       end.
     2831   end.
     2832   end procedure.
     2833   procedure fbrlib-get-obj-recipe :
     2834   define input parameter p-obj-type       as character    no-undo.
     2835   define input parameter p-obj-code       as integer      no-undo.
     2836   define input parameter p-gds-code       as integer      no-undo.
     2837   define output parameter p-recipe-code   as character    no-undo.
     2838       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2839   do
     2840   for buf_fbr-gds-obj
     2841   on error undo, return error
     2842   :
     2843       find first buf_fbr-gds-obj no-lock
     2844            where buf_fbr-gds-obj.obj-type = p-obj-type
     2845              and buf_fbr-gds-obj.obj-code = p-obj-code
     2846              and buf_fbr-gds-obj.gds-code = p-gds-code
     2847       no-error.
     2848       if available buf_fbr-gds-obj
     2849       then do:
     2850           assign
     2851               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2852           .
     2853       end.
     2854       else do:
     2855           assign
     2856               p-recipe-code = ""
     2857           .
     2858       end.
     2859   end.
     2860   end procedure.
     2861   procedure fbrlib-create-or-update-recipe-gds :
     2862   define input parameter p-recipe-code    as character        no-undo.
     2863   define input parameter p-gds-code       as integer          no-undo.
     2864   define input parameter p-is-waste       as logical          no-undo.
     2865   define input parameter p-qnty           as decimal          no-undo.
     2866   define input parameter p-proc-number    as integer          no-undo.
     2867   define input parameter p-nws-self       as logical          no-undo.
     2868       define variable v-max-proc-num  as integer      no-undo.
     2869       define variable v-recipe-type   as character    no-undo.
     2870       define buffer buf_goods             for ub.goods.
     2871       define buffer buf_recipe-gds        for ub.recipe-gds.
     2872       define buffer buf_recipe            for ub.recipe.
     2873       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2874   do
     2875   for buf_goods
     2876     , buf_recipe-gds
     2877     , buf_recipe
     2878     , buf_proc_recipe-gds
     2879   on error undo, return error
     2880   :
     2881       find first buf_recipe no-lock
     2882            where buf_recipe.recipe-code = p-recipe-code
     2883       .
     2884       find first buf_goods no-lock
     2885            where buf_goods.gds-code = p-gds-code
     2886       .
     2887       find first buf_recipe-gds
     2888            where buf_recipe-gds.recipe-code = p-recipe-code
     2889              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2890              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2891              and buf_recipe-gds.artic       = buf_goods.artic
     2892       no-error.
     2893       if not available buf_recipe-gds
     2894       then do:
     2895           create buf_recipe-gds.
     2896           assign
     2897               buf_recipe-gds.recipe-code = p-recipe-code
     2898               buf_recipe-gds.gds-code    = p-gds-code
     2899               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2900               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2901               buf_recipe-gds.artic       = buf_goods.artic
     2902           .
     2903           assign
     2904               buf_recipe-gds.is-waste    = no
     2905               buf_recipe-gds.qnty        = 0
     2906               buf_recipe-gds.coeff-waste = 0
     2907               buf_recipe-gds.brutto-qnty = 0
     2908               buf_recipe-gds.proc-number = 0
     2909               buf_recipe-gds.nws-self    = no
     2910           .
     2911       end.
     2912       assign
     2913           buf_recipe-gds.is-waste    = p-is-waste
     2914       .
     2915       run fbrlib-get-recipe-type in this-procedure (
     2916             input "":U
     2917           , input buf_recipe-gds.recipe-code
     2918           , output v-recipe-type
     2919       ).
     2920       if v-recipe-type <> 'производство':U
     2921       then do:
     2922           assign
     2923               buf_recipe-gds.calc-method = 1
     2924               buf_recipe-gds.qnty        = p-qnty
     2925               buf_recipe-gds.brutto-qnty = p-qnty
     2926               buf_recipe-gds.coeff-waste = 0
     2927           .
     2928       end.
     2929       else do:
     2930           assign
     2931               buf_recipe-gds.calc-method = 1
     2932               buf_recipe-gds.brutto-qnty = p-qnty
     2933           .
     2934           run fbrlib-calc-brutto in this-procedure (
     2935                 input v-recipe-type
     2936               , input 0
     2937               , input 0
     2938               , input buf_recipe-gds.coeff-waste
     2939               , input buf_recipe-gds.brutto-qnty
     2940               , input 1
     2941               , output buf_recipe-gds.qnty
     2942               , output buf_recipe-gds.coeff-waste
     2943               , output buf_recipe-gds.brutto-qnty
     2944               , output buf_recipe-gds.calc-method
     2945           ).
     2946       end.
     2947       assign
     2948           buf_recipe-gds.nws-self    = p-nws-self
     2949       .
     2950       if buf_recipe.recipe-type = 'альтернатива':U
     2951       and buf_recipe-gds.proc-number <> 0
     2952       then do:
     2953       end.
     2954       else do:
     2955           if p-proc-number <> 0
     2956           then do:
     2957               assign
     2958                   buf_recipe-gds.proc-number = p-proc-number
     2959               .
     2960           end.
     2961           else do:
     2962               assign
     2963                   v-max-proc-num = 0
     2964               .
     2965               for each buf_proc_recipe-gds no-lock
     2966                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2967               :
     2968                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2969                   then do:
     2970                       assign
     2971                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2972                       .
     2973                   end.
     2974               end.
     2975               assign
     2976                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2977               .
     2978           end.
     2979       end.
     2980   end.
     2981   end procedure.
     2982   PROCEDURE fbrlib-create-or-update-recipe :
     2983   define input parameter p-mode               as character    no-undo.
     2984   define input parameter p-obj-type           as character    no-undo.
     2985   define input parameter p-obj-code           as integer      no-undo.
     2986   define input parameter p-recipe-code        as character    no-undo.
     2987   define input parameter p-recipe-type        as character    no-undo.
     2988   define input parameter p-gds-code           as integer      no-undo.
     2989   define input parameter p-name               as character    no-undo.
     2990   define input parameter p-design             as character    no-undo.
     2991   define input parameter p-order              as integer      no-undo.
     2992   define input parameter p-quality            as character    no-undo.
     2993   define input parameter p-ref-num            as character    no-undo.
     2994   define input parameter p-technique          as character    no-undo.
     2995   define input parameter p-template           as character    no-undo.
     2996   define input parameter p-qnty               as decimal      no-undo.
     2997   define input parameter p-portion-qnty       as integer      no-undo.
     2998   define input parameter p-portion-weight     as decimal      no-undo.
     2999   define output parameter p-new-recipe-code   as character    no-undo.
     3000       define variable v-host-code         as integer      no-undo.
     3001       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3002       define buffer buf_recipe    for ub.recipe.
     3003       define buffer buf_goods     for ub.goods.
     3004   do
     3005   for buf_recipe
     3006     , buf_goods
     3007   on error undo, return error
     3008   :
     3009       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3010       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3011       then do:
     3012           message
     3013               skip "Ошибка задания типа операции для создания или измения рецепта."
     3014               skip (1)
     3015               skip "Задан тип операции:" p-mode
     3016           view-as alert-box error.
     3017           undo, return error .
     3018       end.
     3019       if p-recipe-code = ""
     3020       then do:
     3021   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3023     (input  p-obj-type
     3024     ,input  p-obj-code
     3025     ,output v-host-code
     3026     )  .
     3027           find first buf_goods no-lock
     3028                where buf_goods.gds-code = p-gds-code
     3029           .
     3030           create buf_recipe .
     3031           run fbrcode-gen-recipe-code in this-procedure (
     3032                 input p-obj-type
     3033               , input p-obj-code
     3034               , output buf_recipe.recipe-code
     3035           ).
     3036           assign
     3037               buf_recipe.artic               = buf_goods.artic
     3038               buf_recipe.prod-type           = buf_goods.prod-type
     3039               buf_recipe.prod-code           = buf_goods.prod-code
     3040               buf_recipe.recipe-type         = p-recipe-type
     3041               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3042               buf_recipe.gds-code            = p-gds-code
     3043               buf_recipe.host-code           = v-host-code
     3044               buf_recipe.obj-type            = p-obj-type
     3045               buf_recipe.obj-code            = p-obj-code
     3046               buf_recipe.recipe-design       = ""
     3047               buf_recipe.recipe-order        = 0
     3048               buf_recipe.recipe-quality      = ""
     3049               buf_recipe.recipe-ref-num      = ""
     3050               buf_recipe.recipe-technique    = ""
     3051               buf_recipe.recipe-template     = ""
     3052               buf_recipe.qnty                = 1.0
     3053               buf_recipe.portion-qnty        = 1
     3054               buf_recipe.portion-weight      = 0
     3055           .
     3056       end.
     3057       if p-name <> ""
     3058       then do:
     3059           assign
     3060               buf_recipe.recipe-name = p-name
     3061           .
     3062       end.
     3063       assign
     3064           buf_recipe.recipe-design       = p-design
     3065           buf_recipe.recipe-order        = p-order
     3066           buf_recipe.recipe-quality      = p-quality
     3067           buf_recipe.recipe-ref-num      = p-ref-num
     3068           buf_recipe.recipe-technique    = p-technique
     3069           buf_recipe.recipe-template     = p-template
     3070           buf_recipe.qnty                = p-qnty
     3071           buf_recipe.portion-qnty        = p-portion-qnty
     3072           buf_recipe.portion-weight      = p-portion-weight
     3073       .
     3074       assign
     3075           p-new-recipe-code = buf_recipe.recipe-code
     3076       .
     3077       run fbrlib-set-default-recipe in this-procedure (
     3078             input p-obj-type
     3079           , input p-obj-code
     3080           , input buf_goods.gds-code
     3081       ).
     3082   end.
     3083   END PROCEDURE.
     3084   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3085   define input parameter parparentproc-handle as widget-handle no-undo .
     3086   define input parameter p-doc-code   as character no-undo.
     3087   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3088       define variable v-shift-on      as logical      no-undo.
     3089       define variable v-shift-date    as date         no-undo.
     3090       define variable v-shift-num     as integer      no-undo.
     3091       define variable v-shift-name    as character    no-undo.
     3092       define variable v-obj-date      as date         no-undo.
     3093       define variable v-chip-num      as integer      no-undo.
     3094       define buffer buf_fbr-doc       for ub.fbr-doc.
     3095       define buffer buf_fbr-line      for ub.fbr-line.
     3096       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3097       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3098       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3099       define buffer buf_marking-lines for ub.marking-lines .
     3100       define buffer buf_marking       for ub.marking .
     3101       define buffer buf_goods         for ub.goods .
     3102   do
     3103   for buf_fbr-doc
     3104     , buf_fbr-line
     3105     , buf_c-fbr-doc
     3106     , buf_fbr-recipe
     3107     , buf_fbr-recipe-gds
     3108     , buf_goods
     3109     , buf_marking
     3110     , buf_marking-lines
     3111   on error undo, return error
     3112   :
     3113   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3114     define variable v-cntxt-db-num        as integer   no-undo .
     3115     define variable v-cntxt-userid        as character no-undo .
     3116     define variable v-cntxt-level         as character no-undo .
     3117     define variable v-cntxt-host-code-obj as integer   no-undo .
     3118     define variable v-cntxt-obj-type      as character no-undo .
     3119     define variable v-cntxt-obj-code      as integer   no-undo .
     3120     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3121     define variable v-cntxt-is-admin      as logical   no-undo .
     3122   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123     run mainmenu_getcntxt in parparentproc-handle
     3124       (output v-cntxt-db-num
     3125       ,output v-cntxt-userid
     3126       ,output v-cntxt-level
     3127       ,output v-cntxt-host-code-obj
     3128       ,output v-cntxt-obj-type
     3129       ,output v-cntxt-obj-code
     3130       ,output v-cntxt-db-num-obj
     3131       ,output v-cntxt-is-admin
     3132       ) .
     3133       if search ("delfbr.err") <> ?
     3134       then do:
     3135           os-delete "delfbr.err".
     3136       end.
     3137     _del-block:
     3138       do transaction
     3139     on error undo _del-block, return error return-value
     3140     on endkey undo _del-block , return error return-value
     3141     on stop undo _del-block , return error return-value
     3142       :
     3143           find first buf_fbr-doc exclusive-lock
     3144                where buf_fbr-doc.doc-code = p-doc-code
     3145           no-error.
     3146           if not available buf_fbr-doc
     3147           then do:
     3148         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3149                                           ,vss-workfile
     3150                                           ,vss-revision
     3151                                           ,vss-description
     3152                                           ,chr(10)
     3153                                           , p-doc-code).
     3154           end.
     3155           run fbrlib-delete-fact-trn-doc in this-procedure (
     3156               input parparentproc-handle
     3157              ,input p-doc-code
     3158              ,input 'при':U
     3159              ,input p-chip-num
     3160              ,output v-chip-num
     3161           ) no-error.
     3162           if error-status :error
     3163           then do:
     3164               run fbrlib-print-del-error-message in this-procedure .
     3165         undo _del-block, return error.
     3166           end.
     3167           assign
     3168           p-chip-num = (if p-chip-num = ?
     3169                         then v-chip-num
     3170                         else p-chip-num).
     3171           run fbrlib-delete-fact-trn-doc in this-procedure (
     3172               input parparentproc-handle
     3173              ,input p-doc-code
     3174              ,input 'рас':U
     3175              ,input p-chip-num
     3176              ,output v-chip-num
     3177           ) no-error.
     3178           if error-status :error
     3179           then do:
     3180               run fbrlib-print-del-error-message in this-procedure .
     3181         undo _del-block, return error.
     3182           end.
     3183           run fbrlib-delete-fact-trn-doc in this-procedure (
     3184               input parparentproc-handle
     3185              ,input p-doc-code
     3186              ,input 'спи':U
     3187              ,input p-chip-num
     3188              ,output v-chip-num
     3189           ) no-error.
     3190           if error-status :error
     3191           then do:
     3192               run fbrlib-print-del-error-message in this-procedure .
     3193         undo _del-block, return error.
     3194           end.
     3195           create buf_c-fbr-doc.
     3196           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3197   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3199     (input  buf_fbr-doc.obj-type
     3200     ,input  buf_fbr-doc.obj-code
     3201     ,output v-obj-date
     3202     ) no-error .
     3203           if error-status :error
     3204           or v-obj-date = ?
     3205           then do:
     3206         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3207           end.
     3208   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3209   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3210     (input  buf_fbr-doc.obj-type
     3211     ,input  buf_fbr-doc.obj-code
     3212     ,input  'shift-on=request'
     3213     ,output v-shift-on
     3214     )  .
     3215           if v-shift-on
     3216           then do:
     3217   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3219     (input  buf_fbr-doc.obj-type
     3220     ,input  buf_fbr-doc.obj-code
     3221     ,output v-shift-date
     3222     ,output v-shift-num
     3223     ,output v-shift-name
     3224     ) no-error .
     3225               if error-status :error
     3226               then do:
     3227           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3228               end.
     3229           end.
     3230           else do:
     3231               assign
     3232                   v-shift-date = ?
     3233                   v-shift-num  = ?
     3234                   v-shift-name = ?
     3235               .
     3236           end.
     3237           define variable v-today       as date         no-undo.
     3238           define variable v-time        as integer      no-undo.
     3239           run cur-time in this-procedure (
     3240                 output v-today
     3241               , output v-time
     3242           ).
     3243           assign
     3244               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3245               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3246               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3247               buf_c-fbr-doc.corr-date        = v-today
     3248               buf_c-fbr-doc.corr-time        = v-time
     3249               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3250               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3251               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3252               buf_c-fbr-doc.is-del           = yes
     3253           .
     3254           assign
     3255               buf_fbr-doc.is-del = yes
     3256           .
     3257           for each buf_fbr-line exclusive-lock
     3258              where buf_fbr-line.doc-code = p-doc-code
     3259       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3260       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3261       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3262           :
     3263               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3264                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3265                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3266               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3267                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3268                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3269                                                       and buf_marking-lines.in-code  = "manufacturing"
     3270                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3271                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3272                                                       and buf_marking-lines.prt-code = 0
     3273               :
     3274                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3275                   assign
     3276                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3277                   .
     3278                 end .
     3279                 delete buf_marking-lines.
     3280               end .
     3281               delete buf_fbr-line.
     3282           end.
     3283           for each buf_fbr-recipe exclusive-lock
     3284              where buf_fbr-recipe.doc-code = p-doc-code
     3285       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3286       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3287       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3288           :
     3289               delete buf_fbr-recipe.
     3290           end.
     3291           for each buf_fbr-recipe-gds exclusive-lock
     3292              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3293       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3294       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3295       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3296           :
     3297               delete buf_fbr-recipe-gds.
     3298           end.
     3299           delete buf_fbr-doc.
     3300       end.
     3301   end.
     3302   END PROCEDURE.
     3303   PROCEDURE fbrlib-del-trn-doc :
     3304   do
     3305   on error undo, return error
     3306   :
     3307   define input parameter parparentproc        as widget-handle no-undo .
     3308   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3309   define input parameter p-trn-doc-type       as character    no-undo.
     3310   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3311   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3312       define variable v-trn-doc-doc-code  as character     no-undo.
     3313       define buffer buf_trn-doc       for ub.trn-doc.
     3314   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3315     define variable v-cntxt-db-num        as integer   no-undo .
     3316     define variable v-cntxt-userid        as character no-undo .
     3317     define variable v-cntxt-level         as character no-undo .
     3318     define variable v-cntxt-host-code-obj as integer   no-undo .
     3319     define variable v-cntxt-obj-type      as character no-undo .
     3320     define variable v-cntxt-obj-code      as integer   no-undo .
     3321     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3322     define variable v-cntxt-is-admin      as logical   no-undo .
     3323   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3324     run mainmenu_getcntxt in parparentproc
     3325       (output v-cntxt-db-num
     3326       ,output v-cntxt-userid
     3327       ,output v-cntxt-level
     3328       ,output v-cntxt-host-code-obj
     3329       ,output v-cntxt-obj-type
     3330       ,output v-cntxt-obj-code
     3331       ,output v-cntxt-db-num-obj
     3332       ,output v-cntxt-is-admin
     3333       ) .
     3334       run fbrcode-trn-doc in this-procedure (
     3335             input 'производство':U
     3336           , input p-fbr-doc-doc-code
     3337           , input p-trn-doc-type
     3338           , output v-trn-doc-doc-code
     3339       ).
     3340       find first buf_trn-doc no-lock
     3341            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3342       no-error.
     3343       if available buf_trn-doc
     3344       then do:
     3345           run str/del-doc.p (
     3346                 input parparentproc
     3347               , input buf_trn-doc.doc-code
     3348               , input v-cntxt-db-num
     3349               , input "del-doc.err"
     3350               , input ?
     3351               , input p-fbr-doc-doc-code
     3352               , input v-cntxt-userid
     3353               , input 0
     3354               , input p-phchip-num
     3355               , output p-chip-num
     3356           ) no-error.
     3357           if error-status :error
     3358           then do:
     3359             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3360                                           ,v-trn-doc-doc-code
     3361                                           ,p-fbr-doc-doc-code
     3362                                           , chr(10)
     3363                                           , error-status:get-message(1)
     3364                                           , return-value ).
     3365           end.
     3366       end.
     3367   end.
     3368   END PROCEDURE.
     3369   PROCEDURE fbrlib-delete-fact-trn-doc :
     3370   define input parameter parparentproc    as widget-handle    no-undo.
     3371   define input parameter p-fbr-doc-code   as character        no-undo.
     3372   define input parameter p-doc-type       as character    no-undo.
     3373   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3374   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3375       define variable v-doc-code          as character        no-undo.
     3376       define variable v-ext-doc-type      as character        no-undo.
     3377       define variable v-trn-doc-recid     as recid            no-undo.
     3378       define variable varchip-code        as integer          no-undo.
     3379       define variable varchip-code2       as integer          no-undo.
     3380       define variable v-chip-counter      as integer          no-undo.
     3381       define buffer buf_trn-doc       for ub.trn-doc.
     3382       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3383       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3384   do
     3385   for buf_trn-doc
     3386     , buf_pri_trn-doc
     3387     , buf_cons_trn-doc
     3388   on error undo, return error
     3389   :
     3390   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3391     define variable v-cntxt-db-num        as integer   no-undo .
     3392     define variable v-cntxt-userid        as character no-undo .
     3393     define variable v-cntxt-level         as character no-undo .
     3394     define variable v-cntxt-host-code-obj as integer   no-undo .
     3395     define variable v-cntxt-obj-type      as character no-undo .
     3396     define variable v-cntxt-obj-code      as integer   no-undo .
     3397     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3398     define variable v-cntxt-is-admin      as logical   no-undo .
     3399   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3400     run mainmenu_getcntxt in parparentproc
     3401       (output v-cntxt-db-num
     3402       ,output v-cntxt-userid
     3403       ,output v-cntxt-level
     3404       ,output v-cntxt-host-code-obj
     3405       ,output v-cntxt-obj-type
     3406       ,output v-cntxt-obj-code
     3407       ,output v-cntxt-db-num-obj
     3408       ,output v-cntxt-is-admin
     3409       ) .
     3410       run fbrcode-trn-doc in this-procedure (
     3411             input 'производство':U
     3412           , input p-fbr-doc-code
     3413           , input p-doc-type
     3414           , output v-doc-code
     3415       ).
     3416       find first buf_trn-doc no-lock
     3417            where buf_trn-doc.doc-code = v-doc-code
     3418       no-error.
     3419       if not available buf_trn-doc
     3420       then do:
     3421           if p-doc-type <> 'спи':U
     3422           then do:
     3423               message
     3424                   "Не найден документ '" p-doc-type "'"
     3425                   "по документу производства " p-fbr-doc-code
     3426               view-as alert-box.
     3427               undo, return error.
     3428           end.
     3429           else do:
     3430           end.
     3431       end.
     3432       else do:
     3433           assign
     3434               v-trn-doc-recid = recid( buf_trn-doc )
     3435               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3436           .
     3437           if v-ext-doc-type = 'ev':U
     3438           then do:
     3439               find first buf_pri_trn-doc no-lock
     3440                    where buf_pri_trn-doc.out-code     = v-doc-code
     3441                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3442               no-error.
     3443               if available buf_pri_trn-doc
     3444               then do:
     3445                   run str/del-doc.p (
     3446                         input parparentproc
     3447                       , input buf_pri_trn-doc.doc-code
     3448                       , input v-cntxt-db-num
     3449                       , input "delfbr.err"
     3450                       , input ?
     3451                       , input p-fbr-doc-code
     3452                       , input v-cntxt-userid
     3453                       , input 0
     3454                       , input (if p-ph-chip-num <> ?
     3455                               then p-ph-chip-num
     3456                               else (if varchip-code <> 0
     3457                                   then varchip-code
     3458                                   else ?)
     3459                               )
     3460                       , output varchip-code2
     3461                   ) no-error.
     3462                   if error-status :error
     3463                   then do:
     3464                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3465                                                   ,buf_pri_trn-doc.doc-code
     3466                                                   ,p-fbr-doc-code
     3467                                                   , chr(10)
     3468                                                   , error-status:get-message(1)
     3469                                                   , return-value ).
     3470                   end.
     3471               end.
     3472           end.
     3473           define buffer buf_out_trn-doc       for ub.trn-doc.
     3474           if p-doc-type = 'при':U
     3475           then do:
     3476               assign
     3477                   v-chip-counter = 0
     3478               .
     3479               for each buf_out_trn-doc exclusive-lock
     3480                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3481               on error undo, return error
     3482               :
     3483                   assign
     3484                       v-chip-counter = v-chip-counter + 1
     3485                   .
     3486                   if v-chip-counter > 1
     3487                   then do:
     3488                       assign
     3489                           varchip-code = varchip-code2
     3490                       .
     3491                   end.
     3492                   run str/del-doc.p (
     3493                         input parparentproc
     3494                       , input buf_out_trn-doc.doc-code
     3495                       , input v-cntxt-db-num
     3496                       , input "delfbr.err"
     3497                       , input ?
     3498                       , input p-fbr-doc-code
     3499                       , input v-cntxt-userid
     3500                       , input 0
     3501                       , input (if p-ph-chip-num <> ?
     3502                               then p-ph-chip-num
     3503                               else (if varchip-code <> 0
     3504                                   then varchip-code
     3505                                   else ?)
     3506                               )
     3507                       , output varchip-code2
     3508                   ) no-error.
     3509                   if error-status :error
     3510                   then do:
     3511                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3512                                                   ,buf_out_trn-doc.doc-code
     3513                                                   ,buf_trn-doc.doc-code
     3514                                                   ,p-fbr-doc-code
     3515                                                   , chr(10)
     3516                                                   , error-status:get-message(1)
     3517                                                   , return-value ).
     3518                   end.
     3519               end.
     3520           end.
     3521           run str/del-doc.p (
     3522                 input parparentproc
     3523               , input buf_trn-doc.doc-code
     3524               , input v-cntxt-db-num
     3525               , input "delfbr.err"
     3526               , input ?
     3527               , input p-fbr-doc-code
     3528               , input v-cntxt-userid
     3529               , input 0
     3530               , input (if p-ph-chip-num <> ?
     3531                        then p-ph-chip-num
     3532                        else (if varchip-code <> 0
     3533                              then varchip-code
     3534                              else ?)
     3535                        )
     3536               , output varchip-code2
     3537           ) no-error.
     3538           if error-status :error
     3539           then do:
     3540               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3541                                             ,buf_trn-doc.doc-code
     3542                                             ,p-fbr-doc-code
     3543                                             , chr(10)
     3544                                             , error-status:get-message(1)
     3545                                             , return-value ).
     3546           end.
     3547           if p-doc-type = 'рас':U
     3548           or p-doc-type = 'спи':U
     3549           then do:
     3550               assign
     3551                   v-chip-counter = 0
     3552               .
     3553               for each buf_cons_trn-doc no-lock
     3554                  where buf_cons_trn-doc.out-code      = v-doc-code
     3555                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3556               :
     3557                   assign
     3558                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3559                       v-chip-counter = v-chip-counter + 1
     3560                   .
     3561                   assign
     3562                   varchip-code = if v-chip-counter = 2
     3563                                  then varchip-code2
     3564                                  else varchip-code.
     3565                   run str/del-doc.p (
     3566                         input parparentproc
     3567                       , input buf_cons_trn-doc.doc-code
     3568                       , input v-cntxt-db-num
     3569                       , input "delfbr.err"
     3570                       , input ?
     3571                       , input ?
     3572                       , input v-cntxt-userid
     3573                       , input 0
     3574                       , input (if p-ph-chip-num <> ?
     3575                                then p-ph-chip-num
     3576                                else ( if v-chip-counter = 1
     3577                                       then ?
     3578                                       else varchip-code )
     3579                                )
     3580                       , output varchip-code2
     3581                   ) no-error.
     3582                   if error-status :error
     3583                   then do:
     3584                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3585                                                     ,buf_cons_trn-doc.doc-code
     3586                                                     ,p-fbr-doc-code
     3587                                                     , chr(10)
     3588                                                     , error-status:get-message(1)
     3589                                                     , return-value ).
     3590                   end.
     3591                   assign
     3592                       p-chip-num = varchip-code2
     3593                   .
     3594               end.
     3595           end.
     3596           assign
     3597               p-chip-num = varchip-code2
     3598           .
     3599       end.
     3600   end.
     3601   END PROCEDURE.
     3602   PROCEDURE fbrlib-print-del-error-message :
     3603   do
     3604   on error undo, return error
     3605   :
     3606       define variable v-user-action   as character    no-undo.
     3607       define variable v-printed       as logical      no-undo.
     3608       message
     3609           vss-workfile vss-revision vss-description
     3610           skip "Ошибка при удалении документа."
     3611           skip return-value
     3612           skip trim(error-status :get-message(1))
     3613           skip trim(error-status :get-message(2))
     3614           skip trim(error-status :get-message(3))
     3615       view-as alert-box error.
     3616       if search ("delfbr.err") <> ?
     3617       then do:
     3618         run gbl/prnfilen.w
     3619           (input  "Ошибки при удалении документа производства"
     3620           ,input  0
     3621           ,input  "delfbr.err"
     3622           ,input  7
     3623           ,output v-user-action
     3624           ,output v-printed
     3625           ).
     3626       end.
     3627   end.
     3628   END PROCEDURE.
     3629   procedure fbrlib-calc-brutto :
     3630   define input parameter p-recipe-type        as character        no-undo.
     3631   define input parameter p-netto              as decimal          no-undo.
     3632   define input parameter p-coeff-value        as decimal          no-undo.
     3633   define input parameter p-coeff-waste        as decimal          no-undo.
     3634   define input parameter p-brutto             as decimal          no-undo.
     3635   define input parameter p-calc-method        as integer          no-undo.
     3636   define output parameter p-new-netto         as decimal          no-undo.
     3637   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3638   define output parameter p-new-brutto        as decimal          no-undo.
     3639   define output parameter p-new-calc-method   as integer          no-undo.
     3640   do
     3641   on error undo, return error
     3642   :
     3643       if p-recipe-type <> 'производство':U
     3644       then do:
     3645           assign
     3646               p-new-coeff-waste = 0
     3647               p-new-calc-method = 1
     3648               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3649               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3650           .
     3651       end.
     3652       else do:
     3653           assign
     3654               p-new-calc-method = p-calc-method
     3655           .
     3656           if p-coeff-waste = 0
     3657           then do:
     3658               assign
     3659                   p-coeff-value = 0
     3660               .
     3661           end.
     3662           case p-calc-method
     3663           :
     3664               when 1
     3665               then do:
     3666                   assign
     3667                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3668                       p-new-coeff-waste   = p-coeff-waste
     3669                       p-new-brutto        = p-brutto
     3670                   .
     3671               end.
     3672               when 2
     3673               then do:
     3674                   assign
     3675                       p-new-netto         = p-netto
     3676                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3677                       p-new-brutto        = p-brutto
     3678                   .
     3679               end.
     3680               when 3
     3681               then do:
     3682                   assign
     3683                       p-new-netto         = p-netto
     3684                       p-new-coeff-waste   = p-coeff-waste
     3685                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3686                   .
     3687               end.
     3688               otherwise do:
     3689                   define variable v-yesno    as logical      no-undo.
     3690                   assign
     3691                       v-yesno = yes
     3692                   .
     3693                   message
     3694                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3695                       skip "Значение метода должно быть 1, 2 или 3."
     3696                       skip(1)
     3697                       skip "Заданное значение:" p-calc-method
     3698                       skip(1)
     3699                       skip "Установить значение метода расчета 1"
     3700                       skip "(расчет нетто по брутто и проценту потерь)?"
     3701                   view-as alert-box warning
     3702                   buttons yes-no
     3703                   title "Неверное значение метода пересчета в строках документа-производства"
     3704                   update v-yesno
     3705                   .
     3706                   if v-yesno = yes
     3707                   then do:
     3708                       assign
     3709                           p-new-calc-method   = 1
     3710                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3711                           p-new-coeff-waste   = p-coeff-waste
     3712                           p-new-brutto        = p-brutto
     3713                       .
     3714                   end.
     3715                   else do:
     3716                       message
     3717                               vss-workfile vss-revision vss-description
     3718                           skip(1)
     3719                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3720                           skip return-value
     3721                           skip trim(error-status :get-message(1))
     3722                               trim(error-status :get-message(2))
     3723                               trim(error-status :get-message(3))
     3724                       view-as alert-box error
     3725                       title "Неверное значение метода расчета"
     3726                       .
     3727                       undo, return error .
     3728                   end.
     3729               end.
     3730           end case.
     3731       end.
     3732   end.
     3733   end procedure.
     3734   procedure fbrlib-check-brutto :
     3735   define input parameter p-recipe-type        as character        no-undo.
     3736   define input parameter p-netto              as decimal          no-undo.
     3737   define input parameter p-coeff-value        as decimal          no-undo.
     3738   define input parameter p-coeff-waste        as decimal          no-undo.
     3739   define input parameter p-brutto             as decimal          no-undo.
     3740   define input parameter p-calc-method        as integer          no-undo.
     3741   define output parameter p-error-message     as character        no-undo.
     3742   define output parameter p-not-good          as logical          no-undo.
     3743   do
     3744   on error undo, return error
     3745   :
     3746       if p-recipe-type <> 'производство':U
     3747       then do:
     3748           if p-netto <> p-brutto
     3749           or p-coeff-waste <> 0
     3750           then do:
     3751               assign
     3752                   p-not-good      = yes
     3753                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3754                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3755               .
     3756           end.
     3757       end.
     3758       else do:
     3759           if p-coeff-waste = 0
     3760           then do:
     3761               assign
     3762                   p-coeff-value = 0
     3763               .
     3764           end.
     3765           case p-calc-method
     3766           :
     3767               when 1
     3768               then do:
     3769                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3770                   then do:
     3771                       assign
     3772                           p-not-good      = yes
     3773                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3774                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3775                       .
     3776                   end.
     3777               end.
     3778               when 2
     3779               then do:
     3780                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3781                   then do:
     3782                       assign
     3783                           p-not-good      = yes
     3784                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3785                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3786                       .
     3787                   end.
     3788               end.
     3789               when 3
     3790               then do:
     3791                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3792                   then do:
     3793                       assign
     3794                           p-not-good      = yes
     3795                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3796                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3797                       .
     3798                   end.
     3799               end.
     3800               otherwise do:
     3801                   assign
     3802                       p-not-good      = yes
     3803                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3804                   .
     3805               end.
     3806           end case.
     3807       end.
     3808   end.
     3809   end procedure.
     3810   procedure fbrlib-check-fbr-recipe :
     3811   define input parameter p-doc-code       as character        no-undo.
     3812   define input parameter p-recipe-code    as character        no-undo.
     3813   define output parameter p-is-correct    as logical          no-undo.
     3814       define variable v-comp-factor    as decimal      no-undo.
     3815       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3816       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3817       define buffer buf_fbr-line          for ub.fbr-line.
     3818   do
     3819   for buf_fbr-recipe
     3820     , buf_fbr-recipe-gds
     3821     , buf_fbr-line
     3822   on error undo, return error
     3823   :
     3824       assign
     3825           p-is-correct = yes
     3826       .
     3827       find first buf_fbr-recipe no-lock
     3828            where buf_fbr-recipe.doc-code    = p-doc-code
     3829              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3830       .
     3831       if not available buf_fbr-recipe then do:
     3832         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3833       end.
     3834       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3835       then do:
     3836       end.
     3837       else do:
     3838           find first buf_fbr-line no-lock
     3839                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3840                  and buf_fbr-line.is-comp     = yes
     3841                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3842                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3843                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3844                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3845           .
     3846           assign
     3847               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3848           .
     3849           recipe-line-cycle:
     3850           for each buf_fbr-recipe-gds no-lock
     3851              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3852                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3853           on error undo, return error
     3854           :
     3855               find first buf_fbr-line no-lock
     3856                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3857                      and buf_fbr-line.is-comp     = no
     3858                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3859                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3860                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3861                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3862               .
     3863               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3864               then do:
     3865                   assign
     3866                       p-is-correct = no
     3867                   .
     3868                   leave recipe-line-cycle.
     3869               end.
     3870           end.
     3871       end.
     3872   end.
     3873   end procedure.
     3874   procedure fbrlib-get-recipe-type :
     3875   define input parameter p-fbr-doc-code   as character        no-undo.
     3876   define input parameter p-recipe-code    as character        no-undo.
     3877   define output parameter p-recipe-type   as character        no-undo.
     3878       define buffer buf_recipe        for ub.recipe.
     3879       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3880   do
     3881   for buf_recipe
     3882     , buf_fbr-recipe
     3883   on error undo, return error
     3884   :
     3885       if p-fbr-doc-code = ""
     3886       then do:
     3887           find first buf_recipe no-lock
     3888                where buf_recipe.recipe-code = p-recipe-code
     3889           no-error.
     3890           if available buf_recipe
     3891           then do:
     3892               assign
     3893                   p-recipe-type = buf_recipe.recipe-type
     3894               .
     3895           end.
     3896           else do:
     3897               assign
     3898                   p-recipe-type = "":U
     3899               .
     3900           end.
     3901       end.
     3902       else do:
     3903           find first buf_fbr-recipe no-lock
     3904                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3905                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3906           no-error.
     3907           if available buf_fbr-recipe
     3908           then do:
     3909               assign
     3910                   p-recipe-type = buf_fbr-recipe.recipe-type
     3911               .
     3912           end.
     3913           else do:
     3914               assign
     3915                   p-recipe-type = "":U
     3916               .
     3917           end.
     3918       end.
     3919   end.
     3920   end procedure.
     3921   PROCEDURE calc-comp-from-ingr :
     3922   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3923   define input parameter p-fact-qnty                          as decimal      no-undo.
     3924   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3925   define output parameter p-comp-qnty                         as decimal      no-undo.
     3926       define variable v-ingr-qnty     as decimal       no-undo.
     3927       define buffer buf_i_fbr-line    for ub.fbr-line.
     3928       define buffer buf_fbr-line      for ub.fbr-line.
     3929       define buffer buf_recipe        for ub.fbr-recipe.
     3930       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3931   do
     3932   for buf_i_fbr-line
     3933     , buf_fbr-line
     3934     , buf_recipe
     3935     , buf_recipe-gds
     3936   on error undo, return error
     3937   :
     3938       find first buf_i_fbr-line no-lock
     3939            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3940       .
     3941       find first buf_recipe no-lock
     3942            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3943              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3944       no-error.
     3945       if not available buf_recipe
     3946       then do:
     3947           message
     3948                   vss-workfile vss-revision vss-description
     3949               skip "В строке производства не указан рецепт."
     3950               skip "Невозможно рассчитать количество составного товара."
     3951               skip return-value
     3952               skip trim(error-status :get-message(1))
     3953                   trim(error-status :get-message(2))
     3954                   trim(error-status :get-message(3))
     3955           view-as alert-box error.
     3956           undo, return error .
     3957       end.
     3958       if buf_recipe.recipe-type = 'альтернатива':U
     3959       then do:
     3960           for each buf_fbr-line no-lock
     3961              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3962                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3963                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3964           on error undo, return error
     3965           :
     3966               find first buf_recipe-gds no-lock
     3967                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3968                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3969                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3970                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3971                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3972               .
     3973               assign
     3974                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3975               .
     3976           end.
     3977           assign
     3978               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3979           .
     3980       end.
     3981       else do:
     3982           find first buf_recipe-gds no-lock
     3983                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3984                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3985                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3986                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3987                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3988           .
     3989           assign
     3990               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3991           .
     3992       end.
     3993       find first buf_fbr-line no-lock
     3994            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3995              and buf_fbr-line.is-comp     = yes
     3996              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3997       .
     3998       assign
     3999           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4000       .
     4001   end.
     4002   END PROCEDURE.
     4003   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4004   define input parameter p-recipe-code    as character    no-undo.
     4005   define input parameter p-gds-code       as integer      no-undo.
     4006   define output parameter p-line-qnty     as decimal      no-undo.
     4007   define output parameter p-used-qnty     as decimal      no-undo.
     4008   define output parameter p-recipe-qnty   as decimal      no-undo.
     4009       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4010   do
     4011   for buf_temp_dressing-ingr
     4012   on error undo, return error
     4013   :
     4014       find first buf_temp_dressing-ingr no-lock
     4015            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4016              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4017       no-error.
     4018       if available buf_temp_dressing-ingr
     4019       then do:
     4020           assign
     4021               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4022               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4023               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4024           .
     4025       end.
     4026       else do:
     4027           assign
     4028               p-line-qnty     = 0
     4029               p-used-qnty     = 0
     4030               p-recipe-qnty   = 0
     4031           .
     4032       end.
     4033   end.
     4034   END PROCEDURE.
     4035   PROCEDURE fbrlib_adjust-recipe :
     4036   do
     4037   on error undo, return error
     4038   :
     4039   define input parameter parparentproc as widget-handle no-undo .
     4040   define input parameter p-fbrhist-handle as handle no-undo .
     4041   define input parameter p-doc-code       as character    no-undo.
     4042   define input parameter p-recipe-code    as character    no-undo.
     4043   define input parameter p-price-sale-obj-type as character no-undo .
     4044   define input parameter p-price-sale-obj-code as integer no-undo .
     4045       define variable v-recipe-qnty       as decimal      no-undo.
     4046       define variable v-comp-qnty         as decimal      no-undo.
     4047       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4048       define variable v-ingr-qnty         as decimal      no-undo.
     4049       define variable v-qnty              as decimal      no-undo.
     4050       define variable v-coeff-waste       as decimal      no-undo.
     4051       define variable v-brutto-qnty       as decimal      no-undo.
     4052       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4053       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4054       define buffer buf_fbr-line          for ub.fbr-line.
     4055       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4056       find first buf_fbr-recipe no-lock
     4057            where buf_fbr-recipe.doc-code      = p-doc-code
     4058              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4059       .
     4060       assign
     4061           v-recipe-qnty = buf_fbr-recipe.qnty
     4062       .
     4063       find first buf_fbr-line no-lock
     4064            where buf_fbr-line.doc-code    = p-doc-code
     4065              and buf_fbr-line.is-comp     = yes
     4066              and buf_fbr-line.recipe-code = p-recipe-code
     4067       .
     4068       assign
     4069           v-comp-qnty = buf_fbr-line.fact-qnty
     4070       .
     4071       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4072       then do:
     4073       end.
     4074       else do:
     4075           for each buf_fbr-recipe-gds no-lock
     4076              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4077                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4078           on error undo, return error
     4079           :
     4080               find first buf_fbr-line no-lock
     4081                    where buf_fbr-line.doc-code    = p-doc-code
     4082                      and buf_fbr-line.is-comp     = no
     4083                      and buf_fbr-line.recipe-code = p-recipe-code
     4084                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4085                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4086                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4087               .
     4088               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4089               then do:
     4090                   do transaction
     4091                   on error undo, return error
     4092                   :
     4093                       find first buf_el_fbr-recipe-gds exclusive-lock
     4094                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4095                       .
     4096                       assign
     4097                           buf_el_fbr-recipe-gds.calc-method   = 1
     4098                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4099                       .
     4100                       run fbrlib-calc-brutto in this-procedure (
     4101                             input buf_fbr-recipe.recipe-type
     4102                           , input 0
     4103                           , input buf_el_fbr-recipe-gds.coeff-value
     4104                           , input buf_el_fbr-recipe-gds.coeff-waste
     4105                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4106                           , input 1
     4107                           , output buf_el_fbr-recipe-gds.qnty
     4108                           , output buf_el_fbr-recipe-gds.coeff-waste
     4109                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4110                           , output buf_el_fbr-recipe-gds.calc-method
     4111                       ).
     4112                   end.
     4113               end.
     4114           end.
     4115           run fbrlib_adjust-doc-lines in this-procedure (
     4116                 input parparentproc
     4117               , input p-fbrhist-handle
     4118               , input p-doc-code
     4119               , input p-recipe-code
     4120               , input p-price-sale-obj-type
     4121               , input p-price-sale-obj-code
     4122           ).
     4123       end.
     4124   end.
     4125   END PROCEDURE.
     4126   PROCEDURE fbrlib_adjust-doc-lines :
     4127   define input parameter parparentproc as widget-handle no-undo .
     4128   define input parameter p-fbrhist-handle as handle no-undo .
     4129   define input parameter p-doc-code       as character    no-undo.
     4130   define input parameter p-recipe-code    as character    no-undo.
     4131   define input parameter p-price-sale-obj-type as character no-undo .
     4132   define input parameter p-price-sale-obj-code as integer no-undo .
     4133   define variable v-comp-qnty         as decimal      no-undo.
     4134   define variable v-trn-type          as character    no-undo.
     4135   define variable v-ingr-qnty         as decimal      no-undo.
     4136   define variable v-recipe-qnty       as decimal      no-undo.
     4137   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4138   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4139   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4140   define buffer buf_fbr-line          for ub.fbr-line.
     4141   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4142   define buffer buf_goods             for ub.goods.
     4143   define buffer buf_fbr-doc           for ub.fbr-doc.
     4144   do
     4145   for buf_fbr-recipe
     4146     , buf_fbr-recipe-gds
     4147     , buf_fbr-line
     4148     , buf_coeff_fbr-line
     4149     , buf_goods
     4150     , buf_fbr-doc
     4151   on error undo, return error
     4152   :
     4153       find first buf_fbr-line no-lock
     4154            where buf_fbr-line.doc-code      = p-doc-code
     4155              and buf_fbr-line.is-comp       = yes
     4156              and buf_fbr-line.recipe-code   = p-recipe-code
     4157       .
     4158       find first buf_fbr-doc no-lock
     4159            where buf_fbr-doc.doc-code      = p-doc-code
     4160       .
     4161       assign
     4162           v-comp-qnty = buf_fbr-line.fact-qnty
     4163           v-trn-type  = buf_fbr-line.trn-type
     4164       .
     4165       find first buf_fbr-recipe no-lock
     4166            where buf_fbr-recipe.doc-code    = p-doc-code
     4167              and buf_fbr-recipe.recipe-code = p-recipe-code
     4168       .
     4169       assign
     4170       v-recipe-qnty = buf_fbr-recipe.qnty
     4171       .
     4172       do transaction
     4173       on error undo, return error
     4174       :
     4175           for each buf_fbr-recipe-gds no-lock
     4176              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4177                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4178           on error undo, return error
     4179           :
     4180               find first buf_fbr-line no-lock
     4181                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4182                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4183                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4184                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4185                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4186               no-error.
     4187               if not available buf_fbr-line
     4188               then do:
     4189                   find first buf_goods no-lock
     4190                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4191                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4192                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4193                   .
     4194                   run str/fbr-crln.p (
     4195                         input parparentproc
     4196                       , input recid( buf_fbr-doc )
     4197                       , input recid( buf_goods )
     4198                       , input buf_fbr-recipe-gds.recipe-code
     4199                       , input v-trn-type
     4200                       , input no
     4201                       , input no
     4202                       , input buf_fbr-doc.obj-type
     4203                       , input buf_fbr-doc.obj-code
     4204                       , output v-fbr-v-fbr-doc-line-recid
     4205                   ).
     4206                   find first buf_fbr-line no-lock
     4207                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4208                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4209                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4210                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4211                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4212                   no-error.
     4213                   if not available buf_fbr-line
     4214                   then do:
     4215                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4216                                                      , p-doc-code
     4217                                                      , buf_fbr-recipe-gds.artic
     4218                                                      , buf_fbr-recipe-gds.prod-type
     4219                                                      , buf_fbr-recipe-gds.prod-code).
     4220                   end.
     4221               end.
     4222               find first buf_coeff_fbr-line exclusive-lock
     4223                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4224               .
     4225               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4226               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4227               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4228               then do:
     4229                   assign
     4230                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4231                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4232                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4233                   .
     4234               end.
     4235           end.
     4236       end.
     4237       define variable v-need-goods    as logical       no-undo.
     4238       define variable v-need-goods-list       as character     no-undo.
     4239       define variable v-need-goods-qnty-list  as character     no-undo.
     4240       find first buf_fbr-line no-lock
     4241            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4242              and buf_fbr-line.is-comp     = yes
     4243              and buf_fbr-line.recipe-code = p-recipe-code
     4244       .
     4245       run str/fbr-qnty.p (
     4246             input parparentproc
     4247           , input p-fbrhist-handle
     4248           , input recid( buf_fbr-doc )
     4249           , input recid( buf_fbr-line )
     4250           , input no
     4251           , input "ingr"
     4252           , input no
     4253           , input p-price-sale-obj-type
     4254           , input p-price-sale-obj-code
     4255           , input no
     4256           , input no
     4257           , input no
     4258           , output v-need-goods
     4259           , output v-need-goods-list
     4260           , output v-need-goods-qnty-list
     4261       ).
     4262   end.
     4263   END PROCEDURE.
     4264   procedure fbrlib_check-before-close :
     4265   define input parameter p-doc-code as character no-undo .
     4266   define variable same-sale as decimal no-undo .
     4267   define variable is-waste as logical no-undo .
     4268   define variable fix-price as logical no-undo .
     4269   define buffer buf_fbr-doc for ub.fbr-doc.
     4270   define buffer buf_fbr-line for ub.fbr-line.
     4271   define buffer buf_goods for ub.goods.
     4272   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4273   do
     4274   on error undo, return error
     4275   :
     4276     for each buf_fbr-line no-lock
     4277         where buf_fbr-line.doc-code = p-doc-code
     4278       , each buf_goods no-lock
     4279         where buf_goods.artic     = buf_fbr-line.artic
     4280           and buf_goods.prod-type = buf_fbr-line.prod-type
     4281           and buf_goods.prod-code = buf_fbr-line.prod-code
     4282     break by buf_fbr-line.prod-type
     4283           by buf_fbr-line.prod-code
     4284           by buf_fbr-line.artic
     4285     :
     4286       if first-of (buf_fbr-line.artic)
     4287       then do:
     4288         assign
     4289         same-sale = buf_fbr-line.price-sale
     4290         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4291         fix-price = buf_fbr-line.is-calc
     4292         .
     4293       end.
     4294       if same-sale <> buf_fbr-line.price-sale
     4295       then do:
     4296           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4297                                         ,p-doc-code
     4298                                         ,buf_goods.artic
     4299                                         ,buf_goods.gds-name
     4300                                         ,chr(10)).
     4301       end.
     4302       if fix-price <> buf_fbr-line.is-calc then do:
     4303           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4304                                         ,p-doc-code
     4305                                         ,buf_goods.artic
     4306                                         ,buf_goods.gds-name
     4307                                         ,chr(10)).
     4308       end.
     4309       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4310       then do:
     4311         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4312                                         ,p-doc-code
     4313                                         ,buf_goods.artic
     4314                                         ,buf_goods.gds-name
     4315                                         ,chr(10)).
     4316       end.
     4317       if buf_fbr-line.rsrv-qnty <> ?
     4318       and buf_goods.gds-type <> 'у':U
     4319       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4320       and buf_fbr-line.fact-qnty <> 0
     4321       then do:
     4322         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4323           if  can-find(first buf_fbr-gds-obj no-lock where
     4324                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4325               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4326               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4327               and buf_fbr-gds-obj.is-null-price  )  then .
     4328                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4329                                         ,p-doc-code
     4330                                         ,buf_goods.artic
     4331                                         ,buf_goods.gds-name
     4332                                         ,chr(10)
     4333                                         ,buf_fbr-line.recipe-code
     4334                                         ).
     4335         end.
     4336         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4337                                         ,p-doc-code
     4338                                         ,buf_goods.artic
     4339                                         ,buf_goods.gds-name
     4340                                         ,chr(10)
     4341                                         ,buf_fbr-line.recipe-code
     4342                                         ).
     4343       end.
     4344     end.
     4345   end.
     4346   end procedure.
     4347   define variable vss-include-info35 as character format "X(65)" no-undo
     4348   initial "@(#)$Workfile$ $Revision$".
     4349   procedure fbrpln-create-line :
     4350   define input parameter p-doc-code       as character    no-undo.
     4351   define input parameter p-gds-code       as integer      no-undo.
     4352   define input parameter p-recipe-code    as character    no-undo.
     4353   define input parameter p-fbr-obj-type   as character    no-undo.
     4354   define input parameter p-fbr-obj-code   as integer      no-undo.
     4355   define input parameter p-silence        as logical      no-undo.
     4356   define input parameter p-qnty           as decimal      no-undo.
     4357       define buffer buf_fbr-pln       for fbr-pln.
     4358       define buffer buf_fbr-pln-line  for fbr-pln-line.
     4359       define buffer buf_goods         for goods.
     4360   do
     4361   for buf_fbr-pln
     4362     , buf_fbr-pln-line
     4363     , buf_goods
     4364   on error undo, return error
     4365   :
     4366       find first buf_fbr-pln no-lock
     4367            where buf_fbr-pln.doc-code = p-doc-code
     4368       .
     4369       if buf_fbr-pln.status_ <> 'новый':U
     4370       then do:
     4371           if p-silence = no
     4372           then do:
     4373               message
     4374                   skip "Добавить строки можно только"
     4375                   skip "в документ в статусе 'новый'"
     4376               view-as alert-box error.
     4377           end.
     4378           undo, return error .
     4379       end.
     4380       find first buf_goods no-lock
     4381            where buf_goods.gds-code = p-gds-code
     4382       .
     4383       if p-recipe-code <> ""
     4384       and p-fbr-obj-type = ""
     4385       and p-fbr-obj-code = 0
     4386       then do:
     4387           if p-silence = no
     4388           then do:
     4389               message
     4390                   skip "Не задан объект для производства товара с рецептом."
     4391                   skip "Товар: " buf_goods.artic buf_goods.gds-name
     4392                   skip(1)
     4393                   skip "Товар не может быть включен в план-меню."
     4394               view-as alert-box error.
     4395           end.
     4396           undo, return error .
     4397       end.
     4398       do transaction
     4399       on error undo, return error
     4400       :
     4401           create buf_fbr-pln-line.
     4402           assign
     4403               buf_fbr-pln-line.doc-code       = p-doc-code
     4404               buf_fbr-pln-line.gds-code       = p-gds-code
     4405               buf_fbr-pln-line.recipe-code    = p-recipe-code
     4406               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
     4407               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
     4408               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
     4409               buf_fbr-pln-line.fact-qnty      = p-qnty
     4410               buf_fbr-pln-line.artic          = buf_goods.artic
     4411               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
     4412               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
     4413               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
     4414               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
     4415               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
     4416           .
     4417       end.
     4418   end.
     4419   end procedure.
     4420   procedure fbrpln-create-doc :
     4421   define input parameter p-obj-type   as character    no-undo.
     4422   define input parameter p-obj-code   as integer      no-undo.
     4423   define input parameter p-doc-type   as character    no-undo.
     4424   define input parameter p-db-remote  as logical          no-undo.
     4425   define input parameter p-userid     as character        no-undo.
     4426   define output parameter p-doc-code  as character    no-undo.
     4427       define variable v-today     as date           no-undo.
     4428       define variable v-time      as integer        no-undo.
     4429       define variable v-host-code as integer        no-undo.
     4430       define variable v-doc-code  as character      no-undo.
     4431       define buffer buf_fbr-pln       for fbr-pln.
     4432   do
     4433   for buf_fbr-pln
     4434   on error undo, return error
     4435   :
     4436       run cur-time in this-procedure (
     4437             output v-today
     4438           , output v-time
     4439       ).
     4440   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4442     (input  p-obj-type
     4443     ,input  p-obj-code
     4444     ,output v-host-code
     4445     )  .
     4446       run fbrpln-doc-code (
     4447             input p-obj-type
     4448           , input p-obj-code
     4449           , input p-db-remote
     4450           , output v-doc-code
     4451       ).
     4452       create buf_fbr-pln.
     4453       assign
     4454           buf_fbr-pln.doc-code        = v-doc-code
     4455           buf_fbr-pln.doc-type        = p-doc-type
     4456           buf_fbr-pln.obj-type        = p-obj-type
     4457           buf_fbr-pln.obj-code        = p-obj-code
     4458           buf_fbr-pln.doc-date        = v-today
     4459           buf_fbr-pln.creid           = p-userid
     4460           buf_fbr-pln.PS              = ""
     4461           buf_fbr-pln.fact-date       = ?
     4462           buf_fbr-pln.fact-time       = ?
     4463           buf_fbr-pln.fact-num        = 0
     4464           buf_fbr-pln.fact-order      = 0
     4465           buf_fbr-pln.host-code       = v-host-code
     4466           buf_fbr-pln.status_         = 'новый':U
     4467           buf_fbr-pln.sys-date        = v-today
     4468           buf_fbr-pln.sys-time-int    = v-time
     4469           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
     4470           buf_fbr-pln.user-name       = p-userid
     4471       .
     4472       assign
     4473           p-doc-code = buf_fbr-pln.doc-code
     4474       .
     4475   end.
     4476   end procedure.
     4477   procedure fbrpln-create-fbr-doc :
     4478   define input parameter p-obj-type       as character        no-undo.
     4479   define input parameter p-obj-code       as integer          no-undo.
     4480   define input parameter p-pln-doc-code   as character        no-undo.
     4481   define input parameter p-db-remote      as logical          no-undo.
     4482   define input parameter p-userid         as character        no-undo.
     4483   define output parameter p-doc-code      as character        no-undo.
     4484       define variable v-today         as date             no-undo.
     4485       define variable v-host-code     as integer          no-undo.
     4486       define variable v-base-code     as integer          no-undo.
     4487       define buffer buf_curr-accnt    for curr-accnt.
     4488       define buffer buf_fbr-doc       for fbr-doc.
     4489       define buffer buf_fbr-pln       for fbr-pln.
     4490   do
     4491   for buf_curr-accnt
     4492     , buf_fbr-doc
     4493     , buf_fbr-pln
     4494   on error undo, return error
     4495   :
     4496   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4498     (input  p-obj-type
     4499     ,input  p-obj-code
     4500     ,output v-today
     4501     )  .
     4502   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4504     (input  p-obj-type
     4505     ,input  p-obj-code
     4506     ,output v-host-code
     4507     )  .
     4508   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4510     (input  v-host-code
     4511     ,output v-base-code
     4512     )  .
     4513       find last buf_curr-accnt no-lock
     4514           where buf_curr-accnt.curr-code = v-base-code
     4515             and buf_curr-accnt.exch-date <= v-today
     4516       use-index pi
     4517       no-error.
     4518       if not available buf_curr-accnt
     4519       then do:
     4520           message
     4521               "На дату" v-today "неизвестен курс базовой валюты."
     4522           view-as alert-box error.
     4523           undo, return error.
     4524       end.
     4525       run doc-code in this-procedure (
     4526             input  "main"
     4527           , input  p-obj-type
     4528           , input  p-obj-code
     4529           , input  ?
     4530           , output p-doc-code
     4531       ) no-error.
     4532       if error-status:error
     4533       then do:
     4534           message
     4535               "Ошибка при генерации номера документа производства."
     4536               skip return-value
     4537               skip trim(error-status :get-message(1))
     4538                       trim(error-status :get-message(2))
     4539                       trim(error-status :get-message(3))
     4540           view-as alert-box error.
     4541           return error.
     4542       end.
     4543       run trg/chkdocnm.p (
     4544             input p-doc-code
     4545           , input "fbr-doc"
     4546           , input "?"
     4547       ) no-error.
     4548       if error-status:error
     4549       then do:
     4550           message
     4551                       vss-workfile vss-revision vss-description
     4552               skip "Ошибка при проверке номера для нового документа."
     4553               skip return-value
     4554               skip trim(error-status :get-message(1))
     4555                       trim(error-status :get-message(2))
     4556                       trim(error-status :get-message(3))
     4557           view-as alert-box error.
     4558           undo, return error .
     4559       end.
     4560       create buf_fbr-doc.
     4561       assign
     4562           buf_fbr-doc.doc-code  = p-doc-code
     4563           buf_fbr-doc.creid     = p-userid
     4564           buf_fbr-doc.doc-date  = v-today
     4565           buf_fbr-doc.doc-type  = 'производство':U
     4566           buf_fbr-doc.host-code = v-host-code
     4567           buf_fbr-doc.obj-type  = p-obj-type
     4568           buf_fbr-doc.obj-code  = p-obj-code
     4569           buf_fbr-doc.PS        = "@"
     4570           buf_fbr-doc.status_   = 'новый':U
     4571           buf_fbr-doc.out-code  = p-pln-doc-code
     4572       .
     4573   end.
     4574   end procedure.
     4575   procedure fbrpln-doc-code :
     4576   define input parameter p-obj-type   as character    no-undo.
     4577   define input parameter p-obj-code   as integer      no-undo.
     4578   define input parameter p-db-remote  as logical      no-undo.
     4579   define output parameter p-doc-code  as character    no-undo.
     4580   do
     4581   on error undo, return error
     4582   :
     4583       if p-db-remote = yes
     4584       then do:
     4585           assign
     4586               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
     4587                           + "-"
     4588                           + trim( string( p-obj-code, ">>>>9" ) )
     4589                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     4590           .
     4591       end.
     4592       else do:
     4593           assign
     4594               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
     4595           .
     4596       end.
     4597   end.
     4598   end procedure.
     4599   define variable vss-include-info40 as character format "X(65)" no-undo
     4600   initial "@(#)$Workfile$ $Revision$".
     4601   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4602   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     4603       define variable v-upper-code as int no-undo.
     4604       define variable v-value as character no-undo.
     4605       define variable v-type as character no-undo.
     4606       define buffer lc_gds-grp for ub.gds-grp.
     4607       define buffer lc_goods for ub.goods.
     4608      if p-gds-code <> 0 then do:
     4609       find first lc_goods where lc_goods.gds-code = p-gds-code.
     4610       v-upper-code = lc_goods.grp-code.
     4611       do while v-upper-code > 0 :
     4612           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4613           run ggoattr-value(
     4614             input lc_gds-grp.node-code,
     4615             input 0,
     4616             input "",
     4617             input 0,
     4618             input 'ban-sales-via-cd':U,
     4619             output v-value,
     4620             output v-type
     4621           ).
     4622          if v-value = "yes" then
     4623             return true.
     4624          else
     4625          do:
     4626             run ggoattr-value(
     4627                input lc_gds-grp.node-code,
     4628                input v-cntxt-host-code-obj,
     4629                input "",
     4630                input 0,
     4631                input 'ban-sales-via-cd':U,
     4632                output v-value,
     4633                output v-type
     4634                ).
     4635             if v-value = "yes" then
     4636                return true.
     4637             else
     4638             do:
     4639                run ggoattr-value(
     4640                   input lc_gds-grp.node-code,
     4641                   input v-cntxt-host-code-obj,
     4642                   input v-cntxt-obj-type,
     4643                   input v-cntxt-obj-code,
     4644                   input 'ban-sales-via-cd':U,
     4645                   output v-value,
     4646                   output v-type
     4647                   ).
     4648                if v-value = "yes" then
     4649                   return true.
     4650                else v-upper-code = lc_gds-grp.upper-code.
     4651             end .
     4652          end.
     4653         end.
     4654       end.
     4655       if v-value = "" or logical(v-value) = false then return false .
     4656   end.
     4657   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     4658       define variable v-upper-code as int no-undo.
     4659       define variable v-value as character no-undo.
     4660       define variable v-type as character no-undo.
     4661       define buffer lc_gds-grp for ub.gds-grp.
     4662       define buffer lc_goods for ub.goods.
     4663       v-upper-code = p-grp-code.
     4664       do while v-upper-code > 0 :
     4665           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4666           run ggoattr-value(
     4667             input lc_gds-grp.node-code,
     4668             input 0,
     4669             input "",
     4670             input 0,
     4671             input 'ban-sales-via-cd':U,
     4672             output v-value,
     4673             output v-type
     4674           ).
     4675          if v-value = "yes" then
     4676             return true.
     4677          else
     4678          do:
     4679             run ggoattr-value(
     4680                input lc_gds-grp.node-code,
     4681                input v-cntxt-host-code-obj,
     4682                input "",
     4683                input 0,
     4684                input 'ban-sales-via-cd':U,
     4685                output v-value,
     4686                output v-type
     4687                ).
     4688             if v-value = "yes" then
     4689                return true.
     4690             else
     4691             do:
     4692                run ggoattr-value(
     4693                   input lc_gds-grp.node-code,
     4694                   input v-cntxt-host-code-obj,
     4695                   input v-cntxt-obj-type,
     4696                   input v-cntxt-obj-code,
     4697                   input 'ban-sales-via-cd':U,
     4698                   output v-value,
     4699                   output v-type
     4700                   ).
     4701                if v-value = "yes" then
     4702                   return true.
     4703                else v-upper-code = lc_gds-grp.upper-code.
     4704             end .
     4705          end.
     4706         end.
     4707   end.
     4708   define temp-table temp_goods-qnty no-undo
     4709       field gds-code      as integer
     4710       field artic         as character
     4711       field prod-type     as character
     4712       field prod-code     as integer
     4713       field recipe-type   as character
     4714       field recipe-code   as character
     4715       field trn-type      as character
     4716       field need-qnty     as decimal
     4717       field calculated    as logical
     4718       index pi is primary unique gds-code recipe-code
     4719       index cl calculated
     4720   .
     4721   PROCEDURE create-initial-temp-goods :
     4722   do
     4723   on error undo, return error
     4724   :
     4725   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4726   define input parameter p-artic              as character    no-undo.
     4727   define input parameter p-prod-type          as character    no-undo.
     4728   define input parameter p-prod-code          as integer      no-undo.
     4729   define input parameter p-trn-type           as character    no-undo.
     4730   define input parameter p-recipe-type        as character    no-undo.
     4731   define input parameter p-recipe-code        as character    no-undo.
     4732   define input parameter p-need-qnty          as decimal      no-undo.
     4733   define output parameter p-same-good             as logical      no-undo.
     4734   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     4735       define variable v-gds-code    as integer      no-undo.
     4736       define buffer buf_fbr-doc               for ub.fbr-doc.
     4737       define buffer buf_fbr-line              for ub.fbr-line.
     4738       define buffer buf_recipe                for ub.fbr-recipe.
     4739       define buffer buf_obj_recipe            for ub.recipe.
     4740       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4741       run clear-temp-tables in this-procedure.
     4742   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4744     (input  p-artic
     4745     ,input  p-prod-type
     4746     ,input  p-prod-code
     4747     ,output v-gds-code
     4748     )  .
     4749       create buf_temp_goods-qnty.
     4750       assign
     4751           buf_temp_goods-qnty.gds-code    = v-gds-code
     4752           buf_temp_goods-qnty.artic       = p-artic
     4753           buf_temp_goods-qnty.prod-type   = p-prod-type
     4754           buf_temp_goods-qnty.prod-code   = p-prod-code
     4755           buf_temp_goods-qnty.trn-type    = p-trn-type
     4756           buf_temp_goods-qnty.recipe-type = p-recipe-type
     4757           buf_temp_goods-qnty.recipe-code = p-recipe-code
     4758           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     4759           buf_temp_goods-qnty.calculated  = no
     4760       .
     4761       assign
     4762           p-same-good                 = no
     4763           p-same-good-old-qnty        = 0
     4764       .
     4765       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     4766       for each buf_fbr-line no-lock
     4767          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4768            and buf_fbr-line.is-comp  = yes
     4769       on error undo, return error
     4770       :
     4771           find first buf_temp_goods-qnty
     4772                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     4773                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     4774                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     4775           no-error.
     4776           if available buf_temp_goods-qnty
     4777           then do:
     4778               assign
     4779                   p-same-good                 = yes
     4780                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     4781                   buf_temp_goods-qnty.calculated  = no
     4782               .
     4783           end.
     4784           else do:
     4785               define variable v-recipe-type   as character     no-undo.
     4786               run copy-recipe-in-doc in this-procedure (
     4787                     input p-fbr-doc-doc-code
     4788                   , input buf_fbr-line.recipe-code
     4789                   , input buf_fbr-doc.doc-date
     4790                   , input buf_fbr-doc.obj-type
     4791                   , input buf_fbr-doc.obj-code
     4792               ).
     4793               find first buf_recipe no-lock
     4794                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     4795                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     4796               no-error.
     4797               if available buf_recipe
     4798               then do:
     4799                   assign
     4800                       v-recipe-type = buf_recipe.recipe-type
     4801                   .
     4802                   if v-recipe-type = 'разделка':U
     4803                   or ( v-recipe-type = 'комплектация':U
     4804                       and buf_fbr-line.trn-type = 'спи':U )
     4805                   then do:
     4806                       run fill-temp-dressing-ingr in this-procedure (
     4807                             input buf_fbr-line.doc-code
     4808                           , input buf_recipe.recipe-code
     4809                       ).
     4810                   end.
     4811               end.
     4812               else do:
     4813                   assign
     4814                       v-recipe-type = ?
     4815                   .
     4816               end.
     4817   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4818   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4819     (input  buf_fbr-line.artic
     4820     ,input  buf_fbr-line.prod-type
     4821     ,input  buf_fbr-line.prod-code
     4822     ,output v-gds-code
     4823     )  .
     4824               create buf_temp_goods-qnty.
     4825               assign
     4826                   buf_temp_goods-qnty.gds-code    = v-gds-code
     4827                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     4828                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     4829                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     4830                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     4831                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     4832                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     4833                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     4834                   buf_temp_goods-qnty.calculated  = yes
     4835               .
     4836           end.
     4837       end.
     4838   end.
     4839   END PROCEDURE.
     4840   PROCEDURE calc-not-calculated-goods :
     4841   do
     4842   on error undo, return error
     4843   :
     4844   define input parameter p-mainmenu-handle        as handle           no-undo.
     4845   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     4846   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     4847   define input parameter p-same-good              as logical          no-undo.
     4848   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     4849   define input parameter p-always-select-recipe   as logical          no-undo.
     4850   define input parameter p-add-childs             as logical          no-undo.
     4851   define input parameter p-price-sale-obj-type    as character        no-undo.
     4852   define input parameter p-price-sale-obj-code    as integer          no-undo.
     4853   define input parameter p-autofbr                as logical          no-undo.
     4854   define input parameter p-have-store             as logical          no-undo.
     4855       define variable v-counter               as integer       no-undo.
     4856       define variable v-recipe-type           as character     no-undo.
     4857       define variable v-recipe-code           as character     no-undo.
     4858       define variable v-recipe-found          as logical       no-undo.
     4859       define variable v-gds-code              as integer       no-undo.
     4860       define variable v-yesno                 as logical       no-undo.
     4861       define variable v-fbr-line-recid        as recid         no-undo.
     4862       define variable v-recipe-recid-list     as character     no-undo.
     4863       define variable v-need-goods            as logical       no-undo.
     4864       define variable v-need-goods-list       as character     no-undo.
     4865       define variable v-need-goods-qnty-list  as character     no-undo.
     4866       define variable v-have-rights           as logical       no-undo.
     4867       define variable v-trn-type              as character     no-undo.
     4868       define variable v-is-comp               as logical       no-undo.
     4869       define variable v-host-code             as integer       no-undo.
     4870       define variable v-is-manual-input       as logical       no-undo.
     4871       define variable v-add-good              as logical       no-undo.
     4872       define variable v-cancel                as logical       no-undo.
     4873       define variable v-value          as character no-undo .
     4874       define variable v-type           as character no-undo .
     4875       define variable v-attr-value     as character no-undo .
     4876       define variable v-attr-value-rec as character no-undo .
     4877       define variable v-attr-type      as character no-undo .
     4878       define variable v-mark-qnty      as decimal no-undo init ? .
     4879       define buffer buf_obj_recipe            for recipe.
     4880       define buffer buf_obj_recipe-gds        for recipe-gds.
     4881       define buffer buf_fbr-recipe            for fbr-recipe.
     4882       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     4883       define buffer buf_goods                 for goods.
     4884       define buffer buf_fbr-doc               for fbr-doc.
     4885       define buffer buf_fbr-line              for fbr-line.
     4886       define buffer buf_comp_fbr-line         for fbr-line.
     4887       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4888       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     4889       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     4890       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     4891       define buffer buf_marking-lines         for ub.marking-lines .
     4892       define buffer buf_marking               for ub.marking .
     4893      define variable v-ban-recipes as logical no-undo .
     4894      define variable v-ban-altr    as logical no-undo .
     4895      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     4896      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     4897       find first buf_fbr-doc no-lock
     4898            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4899       .
     4900       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     4901       find first buf_start_temp_goods-qnty
     4902            where buf_start_temp_goods-qnty.calculated = no
     4903       no-error.
     4904       calc-not-calculated-goods:
     4905       do while available buf_start_temp_goods-qnty
     4906       :
     4907           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     4908           find first buf_goods no-lock
     4909                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     4910           .
     4911           if buf_start_temp_goods-qnty.recipe-code = ?
     4912           then do:
     4913               assign
     4914                   v-is-manual-input = yes
     4915               .
     4916           end.
     4917           else do:
     4918               assign
     4919                   v-is-manual-input = no
     4920               .
     4921           end.
     4922           if buf_start_temp_goods-qnty.recipe-code = ?
     4923           or p-always-select-recipe = yes
     4924           then do:
     4925               assign
     4926                   v-yesno     = ?
     4927                   v-add-good  = no
     4928               .
     4929               do while v-yesno = ?
     4930               and v-add-good = no
     4931               :
     4932                   run ref/rcp-all.w (
     4933                         input p-mainmenu-handle
     4934                       , input "b-add,b-sel"
     4935                       , input 'все':U
     4936                       , input recid( buf_goods )
     4937                       , input buf_fbr-doc.obj-type
     4938                       , input buf_fbr-doc.obj-code
     4939                       , output v-recipe-recid-list
     4940                   ) no-error.
     4941                   if error-status :error
     4942                   or v-recipe-recid-list = ""
     4943                   then do:
     4944                       message
     4945                           "Отменить добавление товара?"
     4946                           skip(1)
     4947                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     4948                           skip(1)
     4949                           skip "Yes - отменить добавление текущего товара"
     4950                           skip "No  - отменить добавление всех товаров списка"
     4951                           skip "Cancel - вернуться к выбору рецепта"
     4952                       view-as alert-box question
     4953                       buttons yes-no-cancel
     4954                       title "Отмена"
     4955                       update v-yesno
     4956                       .
     4957                   end.
     4958                   else do:
     4959         if v-ban-altr or v-ban-recipes then
     4960         do:
     4961            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     4962               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     4963               do:
     4964                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4965                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4966                        , input  'mark-type':U
     4967                        , output v-attr-value
     4968                        , output v-attr-type
     4969                        ) no-error .
     4970                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4971                     do:
     4972                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     4973                           view-as alert-box.
     4974                        return .
     4975                     end.
     4976                  end.
     4977               end.
     4978               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     4979               do:
     4980                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     4981                  do:
     4982                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     4983                        view-as alert-box.
     4984                     return .
     4985                  end.
     4986               end.
     4987               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     4988               do:
     4989                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4990                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4991                        , input  'mark-type':U
     4992                        , output v-attr-value
     4993                        , output v-attr-type
     4994                        ) no-error .
     4995                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4996                     do:
     4997                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     4998                           , input  'mark-type':U
     4999                           , output v-attr-value-rec
     5000                           , output v-attr-type
     5001                           ) no-error .
     5002                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     5003                        do:
     5004                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     5005                              view-as alert-box.
     5006                           return .
     5007                        end.
     5008                        else leave.
     5009                     end.
     5010                  end.
     5011               end.
     5012            end.
     5013         end.
     5014                       assign
     5015                           v-add-good = yes
     5016                       .
     5017                   end.
     5018               end.
     5019               if v-add-good = no
     5020               then do:
     5021                   if v-yesno = yes
     5022                   then do:
     5023                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5024                       :
     5025                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5026                           assign
     5027                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5028                           .
     5029                         end .
     5030                         delete tt-marking-lines .
     5031                       end .
     5032                       delete buf_start_temp_goods-qnty.
     5033                       find first buf_start_temp_goods-qnty
     5034                               where buf_start_temp_goods-qnty.calculated = no
     5035                       no-error.
     5036                       next calc-not-calculated-goods.
     5037                   end.
     5038                   else do:
     5039                       undo, return error .
     5040                   end.
     5041               end.
     5042               find first buf_obj_recipe no-lock
     5043                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
     5044               no-error.
     5045               if not available buf_obj_recipe
     5046               then do:
     5047                   if p-always-select-recipe = yes
     5048                   then do:
     5049                       assign
     5050                           buf_start_temp_goods-qnty.calculated = yes
     5051                       .
     5052                       find first buf_start_temp_goods-qnty
     5053                            where buf_start_temp_goods-qnty.calculated = no
     5054                       no-error.
     5055                       next calc-not-calculated-goods.
     5056                   end.
     5057                   else do:
     5058                       message
     5059                           "Неверно выбран рецепт для товара."
     5060                       view-as alert-box information.
     5061                       undo, return error .
     5062                   end.
     5063               end.
     5064               else do:
     5065                   run copy-recipe-in-doc in this-procedure (
     5066                         input buf_fbr-doc.doc-code
     5067                       , input buf_obj_recipe.recipe-code
     5068                       , input buf_fbr-doc.doc-date
     5069                       , input buf_fbr-doc.obj-type
     5070                       , input buf_fbr-doc.obj-code
     5071                   ).
     5072                   find first buf_fbr-recipe no-lock
     5073                        where buf_fbr-recipe.doc-code    = p-fbr-doc-doc-code
     5074                          and buf_fbr-recipe.recipe-code = buf_obj_recipe.recipe-code
     5075                   .
     5076                   assign
     5077                       buf_start_temp_goods-qnty.recipe-code = buf_fbr-recipe.recipe-code
     5078                       buf_start_temp_goods-qnty.recipe-type = buf_fbr-recipe.recipe-type
     5079                   .
     5080               end.
     5081               run writelog in this-procedure ( log-file-name, 3, substitute( "В диалоге выбран рецепт номер &1", buf_start_temp_goods-qnty.recipe-code ) ).
     5082           end.
     5083           else do:
     5084               run copy-recipe-in-doc in this-procedure (
     5085                     input p-fbr-doc-doc-code
     5086                   , input buf_start_temp_goods-qnty.recipe-code
     5087                   , input buf_fbr-doc.doc-date
     5088                   , input buf_fbr-doc.obj-type
     5089                   , input buf_fbr-doc.obj-code
     5090               ).
