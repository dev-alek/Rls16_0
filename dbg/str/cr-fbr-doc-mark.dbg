     6776     define input  parameter p-code     like ub.goods-attr.attr-code  no-undo .
     6777     define output parameter p-deleted  as logical no-undo .
     6778     do
     6779     on error undo, return error
     6780     :
     6781           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-delete in g#attr-lib
     6782         (input  p-gds-code
