     5205               message
     5206                 vss-workfile vss-revision vss-description skip
     5207                 "Неизвестный тип рецепта производства" skip
     5208                 "Тип рецепта" buf_fbr-recipe.recipe-type skip
     5209                 "Документ производства" buf_fbr-recipe.doc-code skip
     5210                 "Код рецепта" buf_fbr-recipe.recipe-code skip
