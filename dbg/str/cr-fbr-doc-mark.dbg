      161   procedure vss-get-parameters :
      162     define output parameter p-vss-parameters as character no-undo .
      163   end procedure.
      164   define new global shared variable g#vssrevis-logger as handle    no-undo .
      165   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      166   define variable v-vssrevis-logger                   as handle    no-undo .
      167   procedure vss-logevent :
      168     define input  parameter p-extra-paramters as character no-undo .
      169     define variable v-vssrevis-parameters as character no-undo .
      170     do
      171     on error undo, return error return-value
      172     :
      173       if  valid-handle(v-vssrevis-logger)
      174       and v-vssrevis-logger :get-signature("logevent") <> ""
      175       then do:
      176         run vss-get-parameters in this-procedure
      177           (output v-vssrevis-parameters
      178           ).
      179         run logevent in v-vssrevis-logger
      180           (input vss-workfile
      181           ,input vss-revision
      182           ,input v-vssrevis-parameters
      183           ,input p-extra-paramters
      184           ).
      185       end.
      186     end.
      187   end procedure.
      188   assign
      189     v-vssrevis-logger = g#vssrevis-logger
      190   .
      191   if  valid-handle(v-vssrevis-logger)
      192   and v-vssrevis-logger :get-signature("logevent") <> ""
      193   then do:
      194     assign
      195       v-vssrevis-logevent = true
      196     .
      197     run vss-logevent in this-procedure (input vss-description) .
      198   end.
      199   define new global shared variable g#language as character no-undo .
      200   if g#language <> '' and g#language <> 'rus':U then do:
      201     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      202   end.
      203   define new global shared variable g#library  as handle no-undo .
      204   define new global shared variable g#library2 as handle no-undo .
      205   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   procedure cur-time :
      207      define output parameter p-today as date      no-undo .
      208      define output parameter p-time  as integer   no-undo .
      209     do
      210     on error undo, return error
      211     :
      212       define variable v-date1 as date      no-undo .
      213       define variable v-date2 as date      no-undo .
      214       define variable v-time  as integer   no-undo .
      215       assign
      216         v-date1 = today
      217         v-time  = time
      218         v-date2 = today
      219       .
      220       if v-date1 <> v-date2
      221       then do:
      222         assign
      223           v-date1 = today
      224           v-time  = v-time
      225         .
      226       end.
      227       assign
      228         p-today = v-date1
      229         p-time  = v-time
      230       .
      231     end.
      232   end.
      233   function cur-time-date returns character
      234   :
      235     return string(today, '99/99/9999':U) .
      236   end.
      237   function cur-time-mjd returns decimal
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return integer(v-date) - 2400002 + (v-time / 86400) .
      246   end.
      247   function cur-time-get-ending-index returns integer
      248   (input p-number as integer
      249   )
      250   :
      251     if p-number < 0
      252     or p-number = ?
      253     then do:
      254       return 1 .
      255     end.
      256     define variable v-rest as integer   no-undo .
      257     assign
      258       p-number = p-number modulo 100
      259     .
      260     if p-number < 20
      261     then do:
      262       assign
      263         v-rest = p-number
      264       .
      265     end.
      266     else do:
      267       assign
      268         v-rest = p-number modulo 10
      269       .
      270     end.
      271     case v-rest :
      272       when 1
      273       then do:
      274         return 2 .
      275       end.
      276       when 2 or
      277       when 3 or
      278       when 4
      279       then do:
      280         return 3 .
      281       end.
      282       otherwise do:
      283         return 1 .
      284       end.
      285     end case .
      286   end.
      287   procedure cur-time-mjd-to-date :
      288      define input  parameter i-mjd-diff as decimal no-undo.
      289      define output parameter o-Date     as date    no-undo.
      290      define output parameter o-Time     as integer no-undo.
      291      define variable v-day-number as integer   no-undo .
      292      if    i-mjd-diff < 0
      293         or i-mjd-diff = ?
      294      then do:
      295         return "?" .
      296      end.
      297      assign
      298         v-day-number = truncate(i-mjd-diff,0).
      299         o-Date = date(v-day-number + 2400002).
      300         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      301     .
      302   end.
      303   function cur-time-mjd-to-string returns character
      304   (input p-mjd-diff as decimal
      305   )
      306   :
      307     define variable v-day-number as integer   no-undo .
      308     define variable v-seconds    as integer   no-undo .
      309     define variable v-hour       as integer   no-undo .
      310     define variable v-min        as integer   no-undo .
      311     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      312     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      313     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      314     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      315     if p-mjd-diff < 0
      316     or p-mjd-diff = ?
      317     then do:
      318       return "?" .
      319     end.
      320     assign
      321       v-day-number = integer(truncate(p-mjd-diff,0))
      322       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      323     .
      324     if v-seconds > 86400
      325     then do:
      326       assign
      327         v-seconds = 86400 - 1
      328       .
      329     end.
      330     if v-seconds < 0
      331     then do:
      332       assign
      333         v-seconds = 0
      334       .
      335     end.
      336     assign
      337       v-hour = truncate(v-seconds / 3600, 0)
      338     .
      339     assign
      340       v-seconds = v-seconds modulo 3600
      341     .
      342     assign
      343       v-min = truncate(v-seconds / 60, 0)
      344     .
      345     assign
      346       v-seconds = v-seconds modulo 60
      347     .
      348     return
      349         (if v-day-number <> 0
      350           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      351           else ""
      352         )
      353       + (if v-day-number <> 0 or v-hour <> 0
      354           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      355           else ""
      356         )
      357       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      358           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      359           else ""
      360         )
      361       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      362       .
      363   end.
      364   function cur-time-string returns character
      365   :
      366     define variable v-date as date      no-undo .
      367     define variable v-time as integer   no-undo .
      368     run cur-time in this-procedure
      369       (output v-date
      370       ,output v-time
      371       ) .
      372     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      373   end.
      374   function cur-time-string-sec returns character
      375   :
      376     define variable v-date as date      no-undo .
      377     define variable v-time as integer   no-undo .
      378     run cur-time in this-procedure
      379       (output v-date
      380       ,output v-time
      381       ) .
      382     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      383   end.
      384   function cur-time-custom  returns character
      385   (input p-prefix as character
      386   ,input p-date-format as character
      387   ,input p-delimiter as character
      388   ,input p-time-format as character
      389   ,input p-suffix as character
      390   )
      391   :
      392     define variable v-date as date      no-undo .
      393     define variable v-time as integer   no-undo .
      394     run cur-time in this-procedure
      395       (output v-date
      396       ,output v-time
      397       ) .
      398     return
      399       p-prefix
      400       + string(v-date, p-date-format)
      401       + p-delimiter
      402       + string(v-time, p-time-format)
      403       + p-suffix
      404       .
      405   end.
      406   function cur-time-print  returns character
      407   :
      408     define variable v-date as date      no-undo .
      409     define variable v-time as integer   no-undo .
      410     run cur-time in this-procedure
      411       (output v-date
      412       ,output v-time
      413       ) .
      414     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      415   end.
      416   function cur-time-datetime returns datetime
      417   :
      418     define variable v-char as character no-undo .
      419     define variable v-datetime as datetime no-undo .
      420     v-char = cur-time-string().
      421     v-datetime = datetime(v-char).
      422     return  v-datetime.
      423   end.
      424   function cur-time-string-msec returns character
      425   :
      426     define variable v-date as datetime  no-undo .
      427     v-date = now.
      428     return string(v-date) .
      429   end.
      430   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   procedure doc-code:
      432   define input  parameter parmode          as   character           no-undo.
      433   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      434   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      435   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      436   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      437   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      438   define variable vardb-remote     as   logical             no-undo.
      439   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      440   define variable v-delimiter as character no-undo .
      441   do
      442   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      443   :
      444   find first buf_sys-ctrl no-lock .
      445   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      446     CASE parmode:
      447       when "main":u then do:
      448         if vardb-remote then do:
      449           assign
      450             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      451         end.
      452         else do:
      453           assign
      454             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      455         end.
      456       end.
      457       when "trio" then do:
      458         assign
      459           pardoc-code = replace (parroot-doc-code, "=", "*").
      460       end.
      461       otherwise do:
      462         assign
      463         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      464         no-error
      465         .
      466         if error-status:error  then do:
      467           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      468                                         ,chr(10)
      469                                         ,parmode
      470                                         ).
      471         end.
      472         if num-entries(parmode) = 1
      473         and parmode <> "chip":U
      474         and parmode <> "chip_s":U
      475         then do:
      476           assign
      477           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      478         end.
      479         else if (lookup("chip":U, parmode) > 0
      480                  or
      481                  lookup("chip_s":U, parmode) > 0) then do:
      482           assign
      483             vartemp-doc-code = parroot-doc-code.
      484           do while true:
      485             if index (vartemp-doc-code , ".") = 0 then
      486               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      487             else
      488               vartemp-doc-code  =
      489               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      490               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      491               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      492             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      493           end.
      494           assign
      495             pardoc-code = vartemp-doc-code.
      496         end.
      497       end.
      498     end CASE.
      499     if pardoc-code = '':U
      500     or (parroot-doc-code <> '':U
      501     and pardoc-code = parroot-doc-code) then do:
      502       undo, return error substitute("Ошибка при генерации номера документа&1"
      503                                     ,chr(10)).
      504     end.
      505   end.
      506   end. // procedure/method
      507   function get-doc-code-int64 returns int64
      508     ( input p-doc-code as character ) :
      509     define variable v-ind              as integer   no-undo .
      510     define variable v-num-entries      as integer   no-undo .
      511     define variable v-doc-code-int64   as int64     no-undo .
      512     define variable v-canonic-doc-code as character no-undo .
      513     assign
      514       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      515       v-canonic-doc-code = p-doc-code
      516     .
      517     do v-ind = 1 to v-num-entries
      518     :
      519       assign
      520         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      521       .
      522     end.
      523     assign
      524       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      525     .
      526     return v-doc-code-int64 .
      527   end. // function/method
      528   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      530   procedure partslib-clear-temp-parts :
      531     define buffer buf_temp-parts for temp-parts .
      532     do
      533     on error undo, return error
      534     :
      535       for each buf_temp-parts
      536       on error undo, return error
      537       :
      538         delete buf_temp-parts .
      539       end.
      540     end.
      541   end procedure.
      542   procedure partslib-create-temp-parts :
      543     define parameter buffer buf_parts       for ub.parts .
      544     define parameter buffer buf_temp-parts  for temp-parts .
      545     define input  parameter p-goods-twounit as logical   no-undo .
      546     define variable v-base-part-code as character no-undo .
      547     do
      548     on error undo, return error
      549     :
      550       if p-goods-twounit = true
      551       then do:
      552         assign
      553           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      554         .
      555       end.
      556       else do:
      557         assign
      558           v-base-part-code = buf_parts.part-code
      559         .
      560       end.
      561       find first buf_temp-parts exclusive-lock
      562         where buf_temp-parts.obj-type  = buf_parts.obj-type
      563           and buf_temp-parts.obj-code  = buf_parts.obj-code
      564           and buf_temp-parts.artic     = buf_parts.artic
      565           and buf_temp-parts.prod-type = buf_parts.prod-type
      566           and buf_temp-parts.prod-code = buf_parts.prod-code
      567           and buf_temp-parts.in-code   = buf_parts.in-code
      568           and buf_temp-parts.out-code  = 'free-zone':U
      569           and buf_temp-parts.part-code = v-base-part-code
      570         no-error.
      571       if not available buf_temp-parts
      572       then do:
      573         create buf_temp-parts .
      574         buffer-copy buf_parts to buf_temp-parts
      575         assign
      576           buf_temp-parts.out-code  = 'free-zone':U
      577           buf_temp-parts.part-code = v-base-part-code
      578           buf_temp-parts.rsrv-free = yes
      579           buf_temp-parts.status_   = no
      580           buf_temp-parts.qnty      = 0
      581           buf_temp-parts.fact-qnty = 0
      582           buf_temp-parts.real-qnty = 0
      583           buf_temp-parts.cli-qnty  = 0
      584         .
      585       end.
      586     end.
      587   end procedure.
      588   procedure partslib-init-temp-parts :
      589     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      590     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      591     define input parameter p-artic           like ub.parts.artic     no-undo .
      592     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      593     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      594     define buffer buf_parts      for ub.parts .
      595     define buffer buf_temp-parts for temp-parts .
      596     define variable v-goods-twounit    as logical   no-undo .
      597     do
      598     on error undo, return error
      599     :
      600   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      602     (input  p-artic
      603     ,input  p-prod-type
      604     ,input  p-prod-code
      605     ,input  'twounit=request':u
      606     ,output v-goods-twounit
      607     ) no-error .
      608       if error-status :error
      609       then do:
      610         message
      611           vss-workfile vss-revision vss-description skip
      612           vss-include-info2 skip
      613           "Ошибка при определении атрибута товара" skip
      614           "Артикул" p-artic p-prod-type p-prod-code skip
      615           "twounit=request" skip
      616           error-status :get-message(1) skip
      617           return-value skip
      618           view-as alert-box error .
      619         undo, return error return-value .
      620       end.
      621       run partslib-clear-temp-parts in this-procedure .
      622       for each buf_parts
      623         where buf_parts.obj-type  = p-obj-type
      624           and buf_parts.obj-code  = p-obj-code
      625           and buf_parts.artic     = p-artic
      626           and buf_parts.prod-type = p-prod-type
      627           and buf_parts.prod-code = p-prod-code
      628           and buf_parts.rsrv-free = yes
      629           and buf_parts.status_   = no
      630           and buf_parts.in-code   <> buf_parts.out-code
      631       on error undo, return error
      632       :
      633         run partslib-create-temp-parts in this-procedure
      634           (buffer buf_parts
      635           ,buffer buf_temp-parts
      636           ,input  v-goods-twounit
      637           ) .
      638         define variable v-parts-qnty          as decimal   no-undo .
      639         define variable v-parts-cli-qnty      as decimal   no-undo .
      640         define variable v-parts-free-qnty     as decimal   no-undo .
      641         define variable v-parts-free-cli-qnty as decimal   no-undo .
      642         if buf_parts.out-code = 'free-zone':U
      643         then do:
      644           assign
      645             v-parts-qnty          = buf_parts.qnty
      646             v-parts-cli-qnty      = buf_parts.cli-qnty
      647             v-parts-free-qnty     = buf_parts.qnty
      648             v-parts-free-cli-qnty = buf_parts.cli-qnty
      649           .
      650         end.
      651         else do:
      652           assign
      653             v-parts-qnty          = abs(buf_parts.qnty)
      654             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      655             v-parts-free-qnty     = 0
      656             v-parts-free-cli-qnty = 0
      657           .
      658         end.
      659         assign
      660           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      661           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      662           buf_temp-parts.real-qnty     = 0
      663           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      664           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      665           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      666         .
      667       end.
      668     end.
      669   end procedure.
      670   procedure partslib-init-temp-parts-by-factord :
      671     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      672     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      673     define input parameter p-artic              like ub.parts.artic     no-undo .
      674     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      675     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      676     define input parameter p-fact-order         as decimal   no-undo .
      677     define input parameter p-include-fact-order as logical   no-undo .
      678     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      679     define buffer buf_gds-obj  for ub.gds-obj .
      680     do
      681     on error undo, return error
      682     :
      683       do transaction
      684       on error undo, return error
      685       :
      686   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      688     (input  p-obj-type
      689     ,input  p-obj-code
      690     ,input  p-artic
      691     ,input  p-prod-type
      692     ,input  p-prod-code
      693     ,buffer buf_gds-obj
      694     ) no-error .
      695         if error-status :error
      696         then do:
      697           message
      698             vss-workfile vss-revision vss-description skip
      699             vss-include-info2 skip
      700             "Невозможно найти товар на объекте" skip
      701             "Объект" p-obj-type p-obj-code skip
      702             "Артикул" p-artic p-prod-type p-prod-code skip
      703             error-status :get-message(1) skip
      704             return-value skip
      705             view-as alert-box error .
      706           undo, return error .
      707         end.
      708         find current buf_gds-obj exclusive-lock .
      709       end.
      710       run partslib-init-temp-parts in this-procedure
      711         (input p-obj-type
      712         ,input p-obj-code
      713         ,input p-artic
      714         ,input p-prod-type
      715         ,input p-prod-code
      716         ) no-error .
      717       if error-status :error
      718       then do:
      719         message
      720           vss-workfile vss-revision vss-description skip
      721           vss-include-info2 skip
      722           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      723           "Объект" p-obj-type p-obj-code skip
      724           "Артикул" p-artic p-prod-type p-prod-code skip
      725           "p-fact-order" p-fact-order skip
      726           view-as alert-box error .
      727         undo, return error .
      728       end.
      729       if p-include-fact-order = true
      730       then do:
      731         assign
      732           p-fact-order = p-fact-order - 0.0000000001
      733         .
      734       end.
      735       define variable v-max-fact-order as character no-undo .
      736       run factord-max-fact-order in this-procedure
      737         (output v-max-fact-order
      738         ) no-error .
      739       if error-status :error
      740       then do:
      741         message
      742           vss-workfile vss-revision vss-description skip
      743           vss-include-info2 skip
      744           "Ошибка при вызове процедуры factord-max-fact-order" skip
      745           "Объект" p-obj-type p-obj-code skip
      746           "Артикул" p-artic p-prod-type p-prod-code skip
      747           "p-fact-order" p-fact-order skip
      748           view-as alert-box error .
      749         undo, return error .
      750       end.
      751       run partslib-update-by-factord in this-procedure
      752         (input p-obj-type
      753         ,input p-obj-code
      754         ,input p-artic
      755         ,input p-prod-type
      756         ,input p-prod-code
      757         ,input p-fact-order
      758         ,input v-max-fact-order
      759         ,input false
      760         ) no-error .
      761       if error-status :error
      762       then do:
      763         message
      764           vss-workfile vss-revision vss-description skip
      765           vss-include-info2 skip
      766           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      767           "Объект" p-obj-type p-obj-code skip
      768           "Артикул" p-artic p-prod-type p-prod-code skip
      769           "p-fact-order" p-fact-order skip
      770           "v-max-fact-order" v-max-fact-order skip
      771           view-as alert-box error .
      772         undo, return error .
      773       end.
      774     end.
      775   end procedure.
      776   procedure partslib-update-by-factord :
      777     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      778     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      779     define input parameter p-artic              like ub.parts.artic     no-undo .
      780     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      781     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      782     define input parameter p-start-fact-order   as decimal   no-undo .
      783     define input parameter p-end-fact-order     as decimal   no-undo .
      784     define input parameter p-lock-gds-obj       as logical   no-undo .
      785     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      786     define buffer buf_gds-obj  for ub.gds-obj .
      787     define buffer buf_doc-line for ub.doc-line .
      788     define variable v-total-parts-qnty as decimal   no-undo .
      789     define variable v-goods-gds-goods  as logical   no-undo .
      790     define variable v-goods-twounit    as logical   no-undo .
      791     do
      792     on error undo, return error
      793     :
      794       if p-start-fact-order > p-end-fact-order
      795       then do:
      796         message
      797           vss-workfile vss-revision vss-description skip
      798           vss-include-info2 skip
      799           "Ошибка задания входных параметров" skip
      800           "Начало интервала превышает конец интервала" skip
      801           "Объект" p-obj-type p-obj-code skip
      802           "Артикул" p-artic p-prod-type p-prod-code skip
      803           "p-start-fact-order" p-start-fact-order skip
      804           "p-end-fact-order"   p-end-fact-order skip
      805           view-as alert-box error .
      806         undo, return error .
      807       end.
      808       if p-lock-gds-obj = true
      809       then do:
      810         do transaction
      811         on error undo, return error
      812         :
      813   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      815     (input  p-obj-type
      816     ,input  p-obj-code
      817     ,input  p-artic
      818     ,input  p-prod-type
      819     ,input  p-prod-code
      820     ,buffer buf_gds-obj
      821     ) no-error .
      822           if error-status :error
      823           then do:
      824             message
      825               vss-workfile vss-revision vss-description skip
      826               vss-include-info2 skip
      827               "Невозможно найти gds-obj" skip
      828               error-status :get-message(1) skip
      829               return-value skip
      830               view-as alert-box error .
      831             undo, return error .
      832           end.
      833           find current buf_gds-obj exclusive-lock .
      834         end.
      835       end.
      836   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      838     (input  p-artic
      839     ,input  p-prod-type
      840     ,input  p-prod-code
      841     ,input  'gds-goods=request':u
      842     ,output v-goods-gds-goods
      843     ) no-error .
      844       if error-status :error
      845       then do:
      846         message
      847           vss-workfile vss-revision vss-description skip
      848           vss-include-info2 skip
      849           "Ошибка при определении атрибута товара" skip
      850           "Артикул" p-artic p-prod-type p-prod-code skip
      851           "gds-goods=request" skip
      852           error-status :get-message(1) skip
      853           return-value skip
      854           view-as alert-box error .
      855         undo, return error return-value .
      856       end.
      857   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      859     (input  p-artic
      860     ,input  p-prod-type
      861     ,input  p-prod-code
      862     ,input  'twounit=request':u
      863     ,output v-goods-twounit
      864     ) no-error .
      865       if error-status :error
      866       then do:
      867         message
      868           vss-workfile vss-revision vss-description skip
      869           vss-include-info2 skip
      870           "Ошибка при определении атрибута товара" skip
      871           "Артикул" p-artic p-prod-type p-prod-code skip
      872           "twounit=request" skip
      873           error-status :get-message(1) skip
      874           return-value skip
      875           view-as alert-box error .
      876         undo, return error return-value .
      877       end.
      878       for each buf_doc-line no-lock
      879         where buf_doc-line.obj-type   = p-obj-type
      880           and buf_doc-line.obj-code   = p-obj-code
      881           and buf_doc-line.artic      = p-artic
      882           and buf_doc-line.prod-type  = p-prod-type
      883           and buf_doc-line.prod-code  = p-prod-code
      884           and buf_doc-line.status_    = 'факт':U
      885           and buf_doc-line.fact-order > p-start-fact-order
      886           and buf_doc-line.fact-order <= p-end-fact-order
      887       on error undo, return error
      888       :
      889         run partslib-process-document in this-procedure
      890           (input  buf_doc-line.doc-code
      891           ,input  p-obj-type
      892           ,input  p-obj-code
      893           ,input  p-artic
      894           ,input  p-prod-type
      895           ,input  p-prod-code
      896           ,input  v-goods-gds-goods
      897           ,input  v-goods-twounit
      898           ,output v-total-parts-qnty
      899           ) no-error .
      900         if error-status :error
      901         then do:
      902           message
      903             vss-workfile vss-revision vss-description skip
      904             vss-include-info2 skip
      905             "Ошибка при вызове процедуры partslib-process-document" skip
      906             "Документ" buf_doc-line.doc-code skip
      907             "Объект" p-obj-type p-obj-code skip
      908             "Артикул" p-artic p-prod-type p-prod-code skip
      909             "p-start-fact-order" p-start-fact-order skip
      910             "p-end-fact-order" p-end-fact-order skip
      911             error-status :get-message(1) skip
      912             return-value skip
      913             view-as alert-box error .
      914           undo, return error return-value .
      915         end.
      916       end.
      917     end.
      918   end procedure.
      919   procedure partslib-process-document :
      920     define input  parameter p-doc-code         as character no-undo .
      921     define input  parameter p-obj-type         as character no-undo .
      922     define input  parameter p-obj-code         as integer   no-undo .
      923     define input  parameter p-artic            as character no-undo .
      924     define input  parameter p-prod-type        as character no-undo .
      925     define input  parameter p-prod-code        as integer   no-undo .
      926     define input  parameter p-goods-gds-goods  as logical   no-undo .
      927     define input  parameter p-goods-twounit    as logical   no-undo .
      928     define output parameter p-total-parts-qnty as decimal   no-undo .
      929     define variable v-parts-sign as integer   no-undo .
      930     define buffer buf_trn-doc    for ub.trn-doc .
      931     define buffer buf_doc-line   for ub.doc-line .
      932     define buffer buf_parts      for ub.parts .
      933     define buffer buf_temp-parts for temp-parts .
      934     do
      935     on error undo, return error return-value
      936     :
      937       find first buf_trn-doc no-lock
      938         where buf_trn-doc.doc-code = p-doc-code
      939         no-error .
      940       if not available buf_trn-doc
      941       then do:
      942         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      943                                      ,p-doc-code
      944                                      ) .
      945       end.
      946       case buf_trn-doc.doc-type
      947       :
      948         when 'при':U or
      949         when 'возврат':U or
      950         when 'инв':U
      951         then do:
      952           assign
      953             v-parts-sign = -1
      954           .
      955         end.
      956         when 'рас':U or
      957         when 'спи':U
      958         then do:
      959           assign
      960             v-parts-sign = 1
      961           .
      962         end.
      963         otherwise do:
      964           undo, return error substitute("Неизвестный тип документа &1"
      965                                       ,buf_trn-doc.doc-type
      966                                       ) .
      967         end.
      968       end.
      969       find first buf_doc-line no-lock
      970         where buf_doc-line.doc-code  = p-doc-code
      971           and buf_doc-line.artic     = p-artic
      972           and buf_doc-line.prod-type = p-prod-type
      973           and buf_doc-line.prod-code = p-prod-code
      974         no-error .
      975       if not available buf_doc-line
      976       then do:
      977         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      978                                      ,p-doc-code
      979                                      ,artic
      980                                      ,prod-type
      981                                      ,prod-code
      982                                      ) .
      983       end.
      984       assign
      985         p-total-parts-qnty = 0
      986       .
      987       if p-goods-gds-goods = true
      988       then do:
      989         for each buf_parts no-lock
      990           where buf_parts.out-code  = p-doc-code
      991             and buf_parts.obj-type  = p-obj-type
      992             and buf_parts.obj-code  = p-obj-code
      993             and buf_parts.artic     = p-artic
      994             and buf_parts.prod-type = p-prod-type
      995             and buf_parts.prod-code = p-prod-code
      996         on error undo, return error
      997         :
      998           run partslib-create-temp-parts in this-procedure
      999             (buffer buf_parts
     1000             ,buffer buf_temp-parts
     1001             ,input  p-goods-twounit
     1002             ) .
     1003           assign
     1004             p-total-parts-qnty        = p-total-parts-qnty
     1005                                       + v-parts-sign * buf_parts.fact-qnty
     1006             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1007                                       + v-parts-sign * buf_parts.fact-qnty
     1008             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1009                                       + v-parts-sign * buf_parts.fact-qnty
     1010             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1011                                       + v-parts-sign * buf_parts.cli-qnty
     1012           .
     1013           if buf_temp-parts.qnty = 0
     1014           then do:
     1015             delete buf_temp-parts .
     1016           end.
     1017         end.
     1018       end.
     1019       else do:
     1020         assign
     1021           p-total-parts-qnty = p-total-parts-qnty
     1022                              + v-parts-sign * buf_doc-line.fact-qnty
     1023         .
     1024       end.
     1025     end.
     1026   end procedure.
     1027   procedure partslib-init-temp-parts-by-date :
     1028     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1029     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1030     define input parameter p-artic           like ub.parts.artic     no-undo .
     1031     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1032     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1033     define input parameter p-fact-date       as date      no-undo .
     1034     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1035     do
     1036     on error undo, return error
     1037     :
     1038       define variable v-fact-order                as decimal   no-undo .
     1039       define variable v-shift-end-fact-order      as decimal   no-undo .
     1040       define variable v-day-end-fact-order        as decimal   no-undo .
     1041       run factord in this-procedure
     1042         (input  p-fact-date
     1043         ,input  1
     1044         ,input  1
     1045         ,input  ?
     1046         ,input  0
     1047         ,input  false
     1048         ,output v-fact-order
     1049         ,output v-shift-end-fact-order
     1050         ,output v-day-end-fact-order
     1051         ) no-error .
     1052       if error-status :error
     1053       then do:
     1054         message
     1055           vss-workfile vss-revision vss-description skip
     1056           vss-include-info2 skip
     1057           "Ошибка при определении момента времени, на который требуется остаток" skip
     1058           "Объект" p-obj-type p-obj-code skip
     1059           "Артикул" p-artic p-prod-type p-prod-code skip
     1060           "Дата" p-fact-date skip
     1061           view-as alert-box error .
     1062         undo, return error .
     1063       end.
     1064       run partslib-init-temp-parts-by-factord in this-procedure
     1065         (input p-obj-type
     1066         ,input p-obj-code
     1067         ,input p-artic
     1068         ,input p-prod-type
     1069         ,input p-prod-code
     1070         ,input v-day-end-fact-order
     1071         ,input false
     1072         ) no-error .
     1073       if error-status :error
     1074       then do:
     1075         message
     1076           vss-workfile vss-revision vss-description skip
     1077           vss-include-info2 skip
     1078           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1079           "Объект" p-obj-type p-obj-code skip
     1080           "Артикул" p-artic p-prod-type p-prod-code skip
     1081           "Дата" p-fact-date skip
     1082           view-as alert-box error .
     1083         undo, return error .
     1084       end.
     1085     end.
     1086   end procedure.
     1087   procedure partslib-calc-cost :
     1088     define output parameter p-fact-qnty      as decimal   no-undo .
     1089     define output parameter p-vat-pc         as decimal   no-undo .
     1090     define output parameter p-slt-pc         as decimal   no-undo .
     1091     define output parameter p-sum-base       as decimal   no-undo .
     1092     define output parameter p-sum-rubl       as decimal   no-undo .
     1093     define output parameter p-vat-base       as decimal   no-undo .
     1094     define output parameter p-vat-rubl       as decimal   no-undo .
     1095     define output parameter p-slt-base       as decimal   no-undo .
     1096     define output parameter p-slt-rubl       as decimal   no-undo .
     1097     define output parameter p-road-tax-base  as decimal   no-undo .
     1098     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1099     define output parameter p-transport-base as decimal   no-undo .
     1100     define output parameter p-transport-rubl as decimal   no-undo .
     1101     define output parameter p-other-base     as decimal   no-undo .
     1102     define output parameter p-other-rubl     as decimal   no-undo .
     1103     define output parameter p-excise-base    as decimal   no-undo .
     1104     define output parameter p-excise-rubl    as decimal   no-undo .
     1105     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       define buffer buf_temp-parts for temp-parts .
     1110       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1111       define buffer   in-vatp-parts    for ub.parts   .
     1112       define buffer   in-vatp-doc      for ub.trn-doc .
     1113       define buffer   in-vatp-goods    for ub.goods   .
     1114       define buffer   in-vatp-sysconf  for ub.sysconf .
     1115       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1116       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1117       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1118       define variable varinvprb                  as   character              no-undo.
     1119       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1120       define variable cli-base-rate              as   decimal                no-undo.
     1121       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1122       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1123       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1124       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1125       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1126       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1127       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1128       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1129       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1130       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1131       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1132       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1133       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1134       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1135       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1136       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1137       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1138       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1139       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1140       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1141       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1142       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1143       define variable varinvatp-envd             as   character              no-undo.
     1144       define variable varinvatp-type             as   character              no-undo.
     1145       for each buf_temp-parts
     1146       on error undo, return error
     1147       :
     1148   assign
     1149     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1150     price-base-with-tax-loc = buf_temp-parts.price-base
     1151   .
     1152   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1154     (output varinvprb
     1155     )  .
     1156     if buf_temp-parts.out-code = 'free-zone':U     or
     1157        buf_temp-parts.out-code = 'out-zone':U   or
     1158        buf_temp-parts.doc-type = 'акт':U then do:
     1159       assign
     1160         in-vatp-have-vat-slt = yes.
     1161     end.
     1162     else do:
     1163       find first in-vatp_doc-attr no-lock
     1164         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1165           and in-vatp_doc-attr.attr-code = 'envd':U
     1166         no-error .
     1167       if not available in-vatp_doc-attr then do:
     1168         assign
     1169           in-vatp-have-vat-slt = yes.
     1170       end.
     1171       else do:
     1172            in-vatp-have-vat-slt = no.
     1173       end.
     1174     end.
     1175     assign
     1176      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1177      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1178     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1179              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1180     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1181             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1182             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1183             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1184             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1185             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1186             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1187       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1188     assign
     1189       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1190     assign
     1191       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1192       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1193       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1194       transport-cli-loc  = 0
     1195       other-cli-loc      = 0
     1196     .
     1197   ASSIGN
     1198             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1199       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1200   .
     1201         assign
     1202           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1203           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1204           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1205           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1206           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1207           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1208           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1209           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1210           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1211           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1212           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1213           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1214           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1215           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1216           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1217           p-excise-base    = p-excise-base    + 0
     1218           p-excise-rubl    = p-excise-rubl    + 0
     1219         .
     1220       end.
     1221       if p-fact-qnty      = ?
     1222       or p-sum-base       = ?
     1223       or p-sum-rubl       = ?
     1224       or p-vat-base       = ?
     1225       or p-vat-rubl       = ?
     1226       or p-slt-base       = ?
     1227       or p-slt-rubl       = ?
     1228       or p-road-tax-base  = ?
     1229       or p-road-tax-rubl  = ?
     1230       or p-transport-base = ?
     1231       or p-transport-rubl = ?
     1232       or p-other-base     = ?
     1233       or p-other-rubl     = ?
     1234       or p-excise-base    = ?
     1235       or p-excise-rubl    = ?
     1236       then do:
     1237         message
     1238           vss-workfile vss-revision vss-description skip
     1239           vss-include-info2 skip
     1240           "Программа in-vatp.i вернула неопределенные значения" skip
     1241           "p-fact-qnty"      p-fact-qnty      skip
     1242           "p-sum-base"       p-sum-base       skip
     1243           "p-sum-rubl"       p-sum-rubl       skip
     1244           "p-vat-base"       p-vat-base       skip
     1245           "p-vat-rubl"       p-vat-rubl       skip
     1246           "p-slt-base"       p-slt-base       skip
     1247           "p-slt-rubl"       p-slt-rubl       skip
     1248           "p-road-tax-base"  p-road-tax-base  skip
     1249           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1250           "p-transport-base" p-transport-base skip
     1251           "p-transport-rubl" p-transport-rubl skip
     1252           "p-other-base"     p-other-base     skip
     1253           "p-other-rubl"     p-other-rubl     skip
     1254           "p-excise-base"    p-excise-base    skip
     1255           "p-excise-rubl"    p-excise-rubl    skip
     1256           view-as alert-box error .
     1257         undo, return error .
     1258       end.
     1259     end.
     1260   end procedure.
     1261   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262       def var log-file-name as char no-undo.
     1263       if search('fbr-mark.log') = ?
     1264       then do:
     1265           assign
     1266               log-file-name = ""
     1267           .
     1268       end.
     1269       else do:
     1270           assign
     1271               log-file-name = 'fbr-mark.log'
     1272           .
     1273       end.
     1274       DEF STREAM stm-log.
     1275       PROCEDURE writelog:
     1276       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     1277       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     1278       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     1279       if p-file-name <> ""
     1280       then do:
     1281       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     1282           PUT STREAM stm-log UNFORMATTED chr(10).
     1283           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     1284                                           OR p-log-string = "&Line") THEN "" ELSE
     1285                                           cur-time-string-sec() + " ").
     1286           PUT STREAM stm-log UNFORMATTED
     1287                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     1288                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1289                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     1290       OUTPUT STREAM stm-log CLOSE.
     1291       end.
     1292       END PROCEDURE.
     1293   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294     define variable v-cntxt-db-num        as integer   no-undo .
     1295     define variable v-cntxt-userid        as character no-undo .
     1296     define variable v-cntxt-level         as character no-undo .
     1297     define variable v-cntxt-host-code-obj as integer   no-undo .
     1298     define variable v-cntxt-obj-type      as character no-undo .
     1299     define variable v-cntxt-obj-code      as integer   no-undo .
     1300     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1301     define variable v-cntxt-is-admin      as logical   no-undo .
     1302   procedure fbrrest-get-free-qnty :
     1303   do
     1304   on error undo, return error
     1305   :
     1306   define input parameter p-obj-type       as character            no-undo.
     1307   define input parameter p-obj-code       as integer              no-undo.
     1308   define input parameter p-gds-code       as integer              no-undo.
     1309   define input parameter p-autofbr        as logical              no-undo.
     1310   define output parameter p-avail-qnty    as decimal              no-undo.
     1311       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     1312       define variable v-free-qnty as decimal       no-undo.
     1313       define buffer buf_goods         for ub.goods.
     1314       define buffer buf_gds-obj       for ub.gds-obj.
     1315       define buffer buf_temp-parts    for temp-parts.
     1316       find first buf_goods no-lock
     1317            where buf_goods.gds-code = p-gds-code
     1318       .
     1319       assign
     1320           p-avail-qnty = 0
     1321       .
     1322       run partslib-init-temp-parts in this-procedure (
     1323             input p-obj-type
     1324           , input p-obj-code
     1325           , input buf_goods.artic
     1326           , input buf_goods.prod-type
     1327           , input buf_goods.prod-code
     1328       ).
     1329       assign
     1330           v-free-qnty = 0
     1331       .
     1332       for each buf_temp-parts
     1333       on error undo, return error
     1334       :
     1335           if buf_temp-parts.qnty > 0
     1336           then do:
     1337               assign
     1338                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     1339               .
     1340           end.
     1341       end.
     1342       assign
     1343           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     1344       .
     1345   end.
     1346   end procedure.
     1347   procedure fbrrest-get-catering-object :
     1348   do
     1349   on error undo, return error
     1350   :
     1351   define input parameter p-obj-code            as integer      no-undo.
     1352   define output parameter p-catering-obj-type  as character    no-undo.
     1353   define output parameter p-catering-obj-code  as integer      no-undo.
     1354       define buffer buf_shop              for ub.shop.
     1355       find first buf_shop no-lock
     1356            where buf_shop.obj-code = p-obj-code
     1357       .
     1358       assign
     1359           p-catering-obj-type = buf_shop.kitchen-store-type
     1360           p-catering-obj-code = buf_shop.kitchen-store-code
     1361       .
     1362   end.
     1363   end procedure.
     1364   define variable vss-include-info11 as character format "X(65)" no-undo
     1365   initial "@(#)$Workfile$ $Revision$".
     1366   define temp-table temp_fbrlib_recipe no-undo
     1367       field recipe-code                   as character
     1368       field fbr-doc-code                  as character
     1369       field income-goods-doc-code         as character
     1370       field count-income                  as integer
     1371       field qnty-income                   as decimal
     1372       field sum-income-sale               as decimal
     1373       field sum-income-cost-base          as decimal
     1374       field sum-income-cost-rubl          as decimal
     1375       field sum-income-vat-cost-base      as decimal
     1376       field sum-income-vat-cost-rubl      as decimal
     1377       field write-off-goods-doc-code      as character
     1378       field write-off-office-doc-code     as character
     1379       field count-write-off               as integer
     1380       field qnty-write-off                as decimal
     1381       field sum-write-off-sale            as decimal
     1382       field sum-write-off-cost-base       as decimal
     1383       field sum-write-off-cost-rubl       as decimal
     1384       field sum-write-off-vat-cost-base   as decimal
     1385       field sum-write-off-vat-cost-rubl   as decimal
     1386   index pi is primary unique recipe-code
     1387   index income income-goods-doc-code
     1388   index wogds write-off-goods-doc-code
     1389   index wooff write-off-office-doc-code
     1390   .
     1391   define temp-table temp_dressing-ingr no-undo
     1392       field recipe-code   as character
     1393       field gds-code      as integer
     1394       field line-qnty     as decimal
     1395       field used-qnty     as decimal
     1396       field recipe-qnty   as decimal
     1397       index pi is primary unique recipe-code gds-code
     1398   .
     1399   define temp-table temp_recipe-order no-undo
     1400       field recipe-code   as character
     1401       field order         as integer
     1402       index pi is primary unique order
     1403   .
     1404   define temp-table temp_recipe-childs-qnty no-undo
     1405       field recipe-code   as character
     1406       field childs-qnty   as integer
     1407       field order         as integer
     1408       index pi is primary unique recipe-code
     1409   .
     1410   define temp-table temp_recipe-childs no-undo
     1411       field recipe-code       as character
     1412       field child-code        as integer
     1413       field child-recipe-code as character
     1414       index pi is primary unique recipe-code child-code
     1415   .
     1416   define variable v-fbrlib-recipe-order               as integer  no-undo.
