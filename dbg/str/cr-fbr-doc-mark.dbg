     6792   procedure gds-attr-news :
     6793     define input  parameter p-code           as character no-undo .
     6794     define output parameter p-news           as logical   no-undo .
     6795     do
     6796     on error undo, return error
     6797     :
     6798           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-news in g#attr-lib
     6799         (input  p-code
     6800         ,output p-news
     6801         ) no-error .
     6802       if error-status :error
     6803       then do:
     6804         undo, return error return-value .
