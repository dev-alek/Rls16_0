       99   define   shared variable g#passwd as character no-undo .
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   procedure cur-time :
      102      define output parameter p-today as date      no-undo .
      103      define output parameter p-time  as integer   no-undo .
      104     do
      105     on error undo, return error
      106     :
      107       define variable v-date1 as date      no-undo .
      108       define variable v-date2 as date      no-undo .
      109       define variable v-time  as integer   no-undo .
      110       assign
      111         v-date1 = today
      112         v-time  = time
      113         v-date2 = today
      114       .
      115       if v-date1 <> v-date2
      116       then do:
      117         assign
      118           v-date1 = today
      119           v-time  = v-time
      120         .
      121       end.
      122       assign
      123         p-today = v-date1
      124         p-time  = v-time
      125       .
      126     end.
      127   end.
      128   function cur-time-date returns character
      129   :
      130     return string(today, '99/99/9999':U) .
      131   end.
      132   function cur-time-mjd returns decimal
      133   :
      134     define variable v-date as date      no-undo .
      135     define variable v-time as integer   no-undo .
      136     run cur-time in this-procedure
      137       (output v-date
      138       ,output v-time
      139       ) .
      140     return integer(v-date) - 2400002 + (v-time / 86400) .
      141   end.
      142   function cur-time-get-ending-index returns integer
      143   (input p-number as integer
      144   )
      145   :
      146     if p-number < 0
      147     or p-number = ?
      148     then do:
      149       return 1 .
      150     end.
      151     define variable v-rest as integer   no-undo .
      152     assign
      153       p-number = p-number modulo 100
      154     .
      155     if p-number < 20
      156     then do:
      157       assign
      158         v-rest = p-number
      159       .
      160     end.
      161     else do:
      162       assign
      163         v-rest = p-number modulo 10
      164       .
      165     end.
      166     case v-rest :
      167       when 1
      168       then do:
      169         return 2 .
      170       end.
      171       when 2 or
      172       when 3 or
      173       when 4
      174       then do:
      175         return 3 .
      176       end.
      177       otherwise do:
      178         return 1 .
      179       end.
      180     end case .
      181   end.
      182   procedure cur-time-mjd-to-date :
      183      define input  parameter i-mjd-diff as decimal no-undo.
      184      define output parameter o-Date     as date    no-undo.
      185      define output parameter o-Time     as integer no-undo.
      186      define variable v-day-number as integer   no-undo .
      187      if    i-mjd-diff < 0
      188         or i-mjd-diff = ?
      189      then do:
      190         return "?" .
      191      end.
      192      assign
      193         v-day-number = truncate(i-mjd-diff,0).
      194         o-Date = date(v-day-number + 2400002).
      195         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197   end.
      198   function cur-time-mjd-to-string returns character
      199   (input p-mjd-diff as decimal
      200   )
      201   :
      202     define variable v-day-number as integer   no-undo .
      203     define variable v-seconds    as integer   no-undo .
      204     define variable v-hour       as integer   no-undo .
      205     define variable v-min        as integer   no-undo .
      206     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      207     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      208     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      209     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      210     if p-mjd-diff < 0
      211     or p-mjd-diff = ?
      212     then do:
      213       return "?" .
      214     end.
      215     assign
      216       v-day-number = integer(truncate(p-mjd-diff,0))
      217       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219     if v-seconds > 86400
      220     then do:
      221       assign
      222         v-seconds = 86400 - 1
      223       .
      224     end.
      225     if v-seconds < 0
      226     then do:
      227       assign
      228         v-seconds = 0
      229       .
      230     end.
      231     assign
      232       v-hour = truncate(v-seconds / 3600, 0)
      233     .
      234     assign
      235       v-seconds = v-seconds modulo 3600
      236     .
      237     assign
      238       v-min = truncate(v-seconds / 60, 0)
      239     .
      240     assign
      241       v-seconds = v-seconds modulo 60
      242     .
      243     return
      244         (if v-day-number <> 0
      245           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0
      249           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      250           else ""
      251         )
      252       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      253           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      254           else ""
      255         )
      256       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      257       .
      258   end.
      259   function cur-time-string returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      268   end.
      269   function cur-time-string-sec returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      278   end.
      279   function cur-time-custom  returns character
      280   (input p-prefix as character
      281   ,input p-date-format as character
      282   ,input p-delimiter as character
      283   ,input p-time-format as character
      284   ,input p-suffix as character
      285   )
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return
      294       p-prefix
      295       + string(v-date, p-date-format)
      296       + p-delimiter
      297       + string(v-time, p-time-format)
      298       + p-suffix
      299       .
      300   end.
      301   function cur-time-print  returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      310   end.
      311   function cur-time-datetime returns datetime
      312   :
      313     define variable v-char as character no-undo .
      314     define variable v-datetime as datetime no-undo .
      315     v-char = cur-time-string().
      316     v-datetime = datetime(v-char).
      317     return  v-datetime.
      318   end.
      319   function cur-time-string-msec returns character
      320   :
      321     define variable v-date as datetime  no-undo .
      322     v-date = now.
      323     return string(v-date) .
      324   end.
      325   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   define temp-table tt-wth-doc no-undo like ub.wth-doc.
      327   procedure wth-doch_write-wth-doc-history :
      328   define parameter buffer buf_wth-doc for tt-wth-doc.
      329   define input parameter p-doc-code  like ub.wth-doc.doc-code no-undo .
      330   define input parameter p-host-code like ub.wth-doc.host-code no-undo .
      331   define input parameter p-obj-type  like ub.wth-doc.obj-type no-undo .
      332   define input parameter p-obj-code  like ub.wth-doc.obj-code no-undo .
      333   define variable v-date as date no-undo .
      334   define variable v-time as integer no-undo .
      335   define variable v-message as character no-undo .
      336   define variable varobj-date as date no-undo .
      337   define variable varshift-date as date no-undo .
      338   define variable varshift-num as integer no-undo .
      339   define variable varshift-name as character no-undo.
      340   define variable l-shift-on as logical no-undo .
      341   define variable v-create-hist as logical no-undo .
      342   define variable v-result as character no-undo .
      343   define buffer buf_c-wth-doc for ub.c-wth-doc.
      344   define buffer buf_c-wth-line for ub.c-wth-line.
      345   define buffer buf_c-wth-dtl for ub.c-wth-dtl.
      346   define buffer prev_c-wth-line for ub.c-wth-line.
      347   define buffer prev_c-wth-dtl for ub.c-wth-dtl.
      348   do
      349   on error undo, return error return-value
      350   :
      351     run cur-time in this-procedure(output v-date, output v-time).
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      354     (input  p-obj-type
      355     ,input  p-obj-code
      356     ,output varobj-date
      357     ) no-error .
      358     if error-status :error
      359     or varobj-date = ?
      360     then do:
      361      v-message = substitute("Нет текущей даты на объекте документа МЦ &1 &2&3&4&5 &6"
      362                   , buf_wth-doc.doc-code
      363                   , p-obj-type
      364                   , p-obj-code
      365                   , chr(10)
      366                   , error-status:get-message(1)
      367                   , return-value
      368                   ).
      369       undo, return error v-message.
      370     end.
      371   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      373     (input  p-obj-type
      374     ,input  p-obj-code
      375     ,input  'shift-on=request'
      376     ,output l-shift-on
      377     )  .
      378     if l-shift-on then do:
      379   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      381     (input  p-obj-type
      382     ,input  p-obj-code
      383     ,output varshift-date
      384     ,output varshift-num
      385     ,output varshift-name
      386     ) no-error .
      387     end.
      388     else do:
      389       assign
      390         varshift-date = ?
      391         varshift-num  = ?
      392         varshift-name = ?
      393       .
      394     end.
      395     create buf_c-wth-doc.
      396     buffer-copy buf_wth-doc to buf_c-wth-doc
      397     assign
      398     buf_c-wth-doc.doc-code           = p-doc-code
      399     buf_c-wth-doc.obj-type           = p-obj-type
      400     buf_c-wth-doc.obj-code           = p-obj-code
      401     buf_c-wth-doc.host-code          = p-host-code
      402     buf_c-wth-doc.chip-num           = next-value (s-corr-chip, ub)
      403     buf_c-wth-doc.corr-time          = v-time
      404     buf_c-wth-doc.corr-user-db-num   = g#db-num
      405     buf_c-wth-doc.corr-user-name     = g#userid
      406     buf_c-wth-doc.corr-date          = varobj-date
      407     buf_c-wth-doc.corr-inkas-code    = "":U
      408     buf_c-wth-doc.corr-shift-date    = varshift-date
      409     buf_c-wth-doc.corr-shift-num     = varshift-num
      410     buf_c-wth-doc.corr-shift-name    = varshift-name
      411     buf_c-wth-doc.real-corr-date     = v-date
      412     .
      413     for each ub.wth-line where
      414             ub.wth-line.doc-code = buf_wth-doc.doc-code:
      415       create buf_c-wth-line.
      416       buffer-copy ub.wth-line to buf_c-wth-line
      417       assign
      418       buf_c-wth-line.chip-num           = buf_c-wth-doc.chip-num
      419       buf_c-wth-line.corr-user-db-num   = buf_c-wth-doc.corr-user-db-num
      420       .
      421     end.
      422     for each ub.wth-dtl where
      423             ub.wth-dtl.doc-code = buf_wth-doc.doc-code:
      424       create buf_c-wth-dtl.
      425       buffer-copy ub.wth-dtl to buf_c-wth-dtl
      426       assign
      427       buf_c-wth-dtl.chip-num           = buf_c-wth-doc.chip-num
      428       buf_c-wth-dtl.corr-user-db-num   = buf_c-wth-doc.corr-user-db-num
      429       .
      430     end.
      431       release buf_c-wth-doc.
      432   end.
      433   end procedure.
      434   DEFINE VARIABLE loc#log as logical no-undo .
      435   define variable v-mes     as character no-undo .
      436   define variable v-file    as logical no-undo .
      437   DEFINE VARIABLE var-entry as character no-undo .
      438   DEFINE VARIABLE parcli-type like ub.wth-doc.cli-type no-undo .
      439   DEFINE VARIABLE parcli-code like ub.wth-doc.cli-code no-undo .
      440   DEFINE VARIABLE l-shift-on as logical no-undo .
      441   DEFINE VARIABLE f-date     AS DATE NO-UNDO.
      442   DEFINE VARIABLE f-time     AS INT  NO-UNDO.
      443   DEFINE VARIABLE s-date     AS DATE NO-UNDO.
      444   DEFINE VARIABLE s-num      AS INT  NO-UNDO.
      445   DEFINE VARIABLE s-name     AS CHAR NO-UNDO.
      446   DEFINE VARIABLE varcli-name like ub.clients.obj-name no-undo .
      447   define buffer buf_c-wth-doc for ub.c-wth-doc.
      448   DEF TEMP-TABLE t_t-plc NO-UNDO
      449     FIELD w-p-code LIKE ub.wth-place.w-p-code
      450     FIELD w-p-name LIKE ub.wth-place.w-p-name
      451     INDEX t_t-pi   IS   PRIMARY UNIQUE w-p-code
      452   .
      453   _main:
      454   do
      455   on error undo, return error
      456   :
      457     assign
      458     parcli-type = 'орг':U
      459     parcli-code = parhost-code
      460     .
      461     if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
      462       message
      463       vss-workfile vss-revision vss-description skip
      464       "Неверный параметр вызова par-mode" par-mode
      465       view-as alert-box ERROR.
      466       return error '':U.
      467     end.
      468     if par-status_ = 'факт':U then do:
      469       message
      470       vss-workfile vss-revision vss-description skip
      471       "Неверный параметр вызова par-status_" par-status_
      472       view-as alert-box ERROR.
      473       return error '':U.
      474     end.
      475     if can-find(FIRST ub.wth-doc where
      476                       ub.wth-doc.doc-code = pardoc-code and
      477                     recid(wth-doc) <> par-rid) then do:
      478       message
      479       vss-workfile vss-revision vss-description skip
      480       "Неверный параметр вызова par-rid" par-rid skip
      481       " и/или pardoc-code " pardoc-code
      482       view-as alert-box ERROR.
      483       return error '':U.
      484     end.
      485     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      486       run gbl/factdate.p (
      487                         INPUT        parobj-type,
      488                         INPUT        parobj-code,
      489                         INPUT-OUTPUT f-date,
      490                         INPUT-OUTPUT f-time,
      491                         INPUT-OUTPUT s-date,
      492                         INPUT-OUTPUT s-num,
      493                         INPUT-OUTPUT s-name,
      494                         INPUT        (not p-silent)
      495                           ) NO-ERROR.
      496         IF ERROR-STATUS:ERROR THEN DO:
      497           undo _main, return error return-value .
      498         END.
      499     end.
      500     run trg/wth-inv2.p (
      501                     input yes,
      502                     input pardoc-code,
      503                     input parhost-code,
      504                     input parobj-type,
      505                     input parobj-code,
      506                     input par-operator,
      507                     input par-deliver,
      508                     input par-receiver,
      509                     input par-inv-prs4,
      510                     input par-inv-prs5,
      511                     input parauto-fill,
      512                     input parlines-exist,
      513                     input no,
      514                     output varcli-name) no-error.
      515     if error-status:error then do:
      516       undo _main, return error return-value.
      517     end.
      518     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      519   define variable l-in-ov5 as logical no-undo .
      520   define variable v-date5 as date no-undo .
      521   define variable v-time5 as integer no-undo .
      522   run cur-time in this-procedure(output v-date5, output v-time5).
      523   CREATE ub.wth-doc.
      524   ASSIGN
      525     ub.wth-doc.host-code = parhost-code
      526     ub.wth-doc.doc-code  = TRIM( STRING( NEXT-VALUE( s-wth-doc, ub), ">>>>>>>>>9":U ) ) + "-" + TRIM( STRING( parobj-code, ">>>>>>>>9":U ) ) +                   SUBSTR( parobj-type, ( IF g#language = "RUS" THEN 1 ELSE 2 ), 1 )
      527      ub.wth-doc.doc-type  = 'инв':U
      528     ub.wth-doc.ext-doc-type  = 'iy':U
      529     ub.wth-doc.inter_    = if  lookup(ub.wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
      530     ub.wth-doc.exter_    = if  lookup(ub.wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
      531     ub.wth-doc.status_   = 'накл':U
      532     ub.wth-doc.obj-type  = parobj-type
      533     ub.wth-doc.obj-code  = parobj-code
      534     ub.wth-doc.creid     = g#userid
      535     ub.wth-doc.credate   = v-date5
      536   .
      537   if ub.wth-doc.doc-type = 'инв':U or lookup(ub.wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
      538      or ub.wth-doc.doc-type = 'декл':U then do:
      539     assign
      540       ub.wth-doc.cli-type  = 'орг':U
      541       ub.wth-doc.cli-code  = parhost-code
      542       .
      543   end.
      544   else if ub.wth-doc.ext-doc-type = 'ps':U then do:
      545     assign
      546     ub.wth-doc.cli-type  = parobj-type
      547     ub.wth-doc.cli-code  = parobj-code
      548     .
      549   end.
      550   else if ub.wth-doc.inter_  = yes
      551   then do:
      552     assign
      553     ub.wth-doc.cli-type  = parobj-type
      554     ub.wth-doc.cli-code  = parobj-code
      555     .
      556   end.
      557   else if ub.wth-doc.exter_  = yes
      558   then do:
      559     assign
      560     ub.wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
      561     ub.wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
      562     .
      563   end.
      564   else assign
      565       ub.wth-doc.cli-type  = parobj-type
      566       ub.wth-doc.cli-code  = 0
      567   .
      568       assign
      569       par-rid = recid(ub.wth-doc)
      570       .
      571     end.
      572     else do:
      573       FIND FIRST ub.wth-doc EXCLUSIVE-LOCK WHERE
      574                 recid(ub.wth-doc) = par-rid NO-WAIT NO-ERROR.
      575       if locked ub.wth-doc then do:
      576         v-mes = substitute( "Документ занят"
      577                             ).
      578         run err-mess(input-output v-mes).
      579         var-entry = "":U.
      580         undo _main, return error (if p-silent then v-mes else var-entry).
      581       end.
      582       if not avail ub.wth-doc then do:
      583         v-mes = substitute( "Не найден документ МЦ"
      584                             ).
      585         run err-mess(input-output v-mes).
      586         var-entry = "":U.
      587         undo _main, return error (if p-silent then v-mes else var-entry).
      588       end.
      589       if ub.wth-doc.status_ <> par-status_ then do:
      590         v-mes = substitute( "Неверный вызов - с изменением статуса документа МЦ с &1 на &2"
      591                             ,ub.wth-doc.status_
      592                             , par-status_
      593                             ).
      594         run err-mess(input-output v-mes).
      595         var-entry = "":U.
      596         undo _main, return error (if p-silent then v-mes else var-entry).
      597       end.
      598       if ub.wth-doc.auto-fill <> parauto-fill then do:
      599         v-mes = substitute( "Неверный вызов - с изменением типа заполнения документа МЦ"
      600                             ).
      601         run err-mess(input-output v-mes).
      602         var-entry = "":U.
      603         undo _main, return error (if p-silent then v-mes else var-entry).
      604       end.
      605       if ub.wth-doc.status_ <> 'накл':U then dO:
      606         if ub.wth-doc.doc-code <> pardoc-code OR
      607           ub.wth-doc.host-code <> parhost-code OR
      608           ub.wth-doc.obj-type <> parobj-type OR
      609           ub.wth-doc.obj-code <> parobj-code OR
      610           ub.wth-doc.doc-date <> pardoc-date OR
      611           ub.wth-doc.shift-date <> parshift-date OR
      612           ub.wth-doc.shift-num <> parshift-num OR
      613           ub.wth-doc.shift-name <> parshift-name OR
      614           ub.wth-doc.bef-sum <> parbef-sum
      615           then do:
      616           v-mes = substitute( "Документ МЦ имеет статус &1 возможно изменить только сумму факт, примечание&2" +
      617                               "и состав инвентаризационной комиссии"
      618                             , ub.wth-doc.status_
      619                               ).
      620           run err-mess(input-output v-mes).
      621           var-entry = "":U.
      622           undo _main, return error (if p-silent then v-mes else var-entry).
      623         end.
      624       end.
      625       create tt-wth-doc.
      626       buffer-copy ub.wth-doc to tt-wth-doc.
      627     end.
      628     assign
      629     ub.wth-doc.cli-name = varcli-name
      630     ub.wth-doc.doc-code = (if par-mode = 'ДОБАВЛЕНИЕ':U then ub.wth-doc.doc-code else pardoc-code)
      631     ub.wth-doc.host-code = parhost-code
      632     ub.wth-doc.obj-type = parobj-type
      633     ub.wth-doc.obj-code = parobj-code
      634     ub.wth-doc.cli-type = 'орг':U
      635     ub.wth-doc.cli-code = parcli-code
      636     ub.wth-doc.doc-date = pardoc-date
      637     ub.wth-doc.fact-date = parfact-date
      638     ub.wth-doc.shift-date = parshift-date
      639     ub.wth-doc.shift-num = parshift-num
      640     ub.wth-doc.shift-name = parshift-name
      641     ub.wth-doc.operator = par-operator
      642     ub.wth-doc.deliver = par-deliver
      643     ub.wth-doc.receiver = par-receiver
      644     ub.wth-doc.inv-prs4 = par-inv-prs4
      645     ub.wth-doc.inv-prs5 = par-inv-prs5
      646     ub.wth-doc.doc-type = 'инв':U
      647     ub.wth-doc.auto-fill = parauto-fill
      648     ub.wth-doc.exter_ = yes
      649     ub.wth-doc.inter_ = no
      650     ub.wth-doc.PS = par-PS
      651     ub.wth-doc.status_ = par-status_
      652     ub.wth-doc.ext-doc-type = 'iy':U
      653     .
      654     release ub.wth-doc no-error.
      655     if error-status:error then do:
      656         v-mes = substitute("Ошибка при сохранении документа&1&2 &3", chr(10), error-status:get-message(1), return-value ).
      657         run err-mess(input-output v-mes).
      658         var-entry = "":U.
      659         undo _main, return error (if p-silent then v-mes else var-entry).
      660     end.
      661     find last buf_c-wth-doc no-lock where
      662               buf_c-wth-doc.doc-code = pardoc-code
      663           AND  buf_c-wth-doc.corr-user-db-num = g#db-num no-error.
      664     if (not par-mode = 'ДОБАВЛЕНИЕ':U and tt-wth-doc.creid <> g#userid
      665     and not available buf_c-wth-doc)
      666     or (available buf_c-wth-doc
      667     and buf_c-wth-doc.corr-user-name <> g#userid)
      668     then do:
      669       run wth-doch_write-wth-doc-history in this-procedure (
      670                                                               buffer tt-wth-doc
      671                                                               ,input pardoc-code
      672                                                               ,input parhost-code
      673                                                               ,input parobj-type
      674                                                               ,input parobj-code) no-error .
      675       if error-status:error then do:
      676         v-mes = error-status:get-message(1) .
      677         run err-mess(input-output v-mes).
      678         undo _main, return error v-mes.
      679       end.
      680     end.
      681     return '':U.
      682   end.
      683   PROCEDURE err-mess:
      684     DEFINE INPUT-output PARAMETER p-mes as character No-UNDO.
      685     p-mes = substitute("Документ МЦ №&1: &2&3&4&5", pardoc-code, parobj-type, parobj-code, chr(10), p-mes).
      686     if not p-silent then
      687     message
      688     p-mes
      689     view-as alert-box error .
      690   END PROCEDURE.
