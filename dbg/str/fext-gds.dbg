      331   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   procedure gen-key-rec :
      334     define input  parameter p-tbl-name    as character no-undo.
      335     define input  parameter p-bh_tbl-name as handle    no-undo.
      336     define output parameter p-key-rec     as character no-undo.
      337     do
      338     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      339     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      340     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      341     :
      342       define variable fh               as handle    no-undo .
      343       define variable v-ok             as logical   no-undo .
      344       define variable v-inform         as character no-undo .
      345       define variable v-ind            as integer   no-undo .
      346       define variable v-idx-field-qnty as integer   no-undo .
      347       if p-tbl-name = ?
      348         or p-tbl-name = "":U
      349       then do:
      350         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      351       end.
      352       if not p-bh_tbl-name:available then do:
      353         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      354       end.
      355       assign
      356         p-key-rec = p-tbl-name
      357         v-inform  = p-bh_tbl-name:index-information(1)
      358         v-ind     = 2
      359       .
      360       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      361       on error undo, return error
      362       :
      363         assign
      364           v-inform = p-bh_tbl-name:index-information( v-ind )
      365           v-ind    = v-ind + 1
      366         .
      367       end.
      368       if v-inform = ?
      369         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      370         or entry( 3, v-inform, ",":U ) <> "1":U
      371       then do:
      372         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      373       end.
      374       else do:
      375         assign
      376           v-idx-field-qnty = num-entries( v-inform ) - 4
      377         .
      378         if v-idx-field-qnty < 2 then do:
      379           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      380         end.
      381         do v-ind = 1 to v-idx-field-qnty by 2
      382         on error undo, return error
      383         :
      384           assign
      385             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      386             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      387           .
      388         end.
      389       end.
      390       if p-key-rec = ? then do:
      391         assign
      392           p-key-rec = "":U
      393         .
      394         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      395       end.
      396     end.
      397     return.
      398   end procedure.
      399   procedure gen-where-keyr-tab :
      400     define input  parameter i-tableSerach as character no-undo.
      401     define input  parameter i-tablekey   as character  no-undo.
      402     define input  parameter p-key-rec    as character  no-undo.
      403     define input  parameter p-key-handle as handle     no-undo .
      404     define input  parameter p-db-name    as character  no-undo .
      405     define input  parameter p-tt-handle  as handle     no-undo .
      406     define output parameter o-Where      as character  no-undo.
      407     do
      408     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      409     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      410     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      411     :
      412       define variable v-full-tbl-name  as character no-undo .
      413       define variable bh_tbl-name      as handle    no-undo .
      414       define variable fh_key           as handle    no-undo .
      415       define variable fh_search        as handle    no-undo .
      416       define variable v-field-num      as integer   no-undo .
      417       define variable v-count-fld      as integer   no-undo .
      418       define variable v-inform         as character no-undo .
      419       define variable v-ind            as integer   no-undo .
      420       define variable v-idx-field-qnty as integer   no-undo .
      421       define variable v-field-name     as character no-undo .
      422       define variable v-field-val      as character no-undo .
      423       define variable v-word-link      as character no-undo .
      424       define variable vTable           as character no-undo.
      425       define variable bh_tbl-key       as handle    no-undo .
      426       assign
      427         p-key-rec = trim( p-key-rec )
      428       .
      429       if p-key-handle <> ? then do:
      430         if not valid-handle(p-key-handle)
      431            or p-key-handle:type <> "buffer"
      432         then do:
      433           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      434         end.
      435         if num-entries( p-key-rec, chr(3) ) > 1
      436           or p-key-rec = ?
      437           or p-key-rec = "":U
      438         then do:
      439           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      440         end.
      441       end.
      442       else do:
      443         if p-key-rec = ?
      444           or p-key-rec = "":U
      445         then do:
      446           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      447         end.
      448       end.
      449       assign
      450         vTable = entry( 1 , p-key-rec, chr(3) )
      451       .
      452       if p-tt-handle <> ?
      453         and ( not valid-handle(p-tt-handle)
      454               or p-tt-handle:type <> "buffer"
      455             )
      456       then do:
      457         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      458       end.
      459       if p-tt-handle = ? then do:
      460         assign
      461           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      462         .
      463         create buffer bh_tbl-name for table v-full-tbl-name .
      464       end.
      465       else do:
      466         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      467       end.
      468       assign
      469         v-inform = bh_tbl-name:index-information(1)
      470         v-ind    = 2
      471       .
      472       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      473       on error undo, return error
      474       :
      475         assign
      476           v-inform = bh_tbl-name:index-information( v-ind )
      477           v-ind    = v-ind + 1
      478         .
      479       end.
      480       if v-inform = ?
      481         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      482         or entry( 3, v-inform, ",":U ) <> "1":U
      483       then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      486       end.
      487       assign
      488         v-idx-field-qnty = num-entries( v-inform ) - 4
      489       .
      490       if v-idx-field-qnty < 2 then do:
      491         delete object bh_tbl-name no-error.
      492         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      493       end.
      494       assign
      495         o-where     = "where":U
      496         v-word-link = "":U
      497         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      498         v-count-fld = 0
      499       .
      500       if i-tablekey ne "" and i-tablekey ne ?
      501       then do:
      502         assign
      503           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      504         .
      505         create buffer bh_tbl-key for table v-full-tbl-name .
      506       end.
      507       if i-tableSerach ne "" and i-tableSerach ne ?
      508       then do:
      509         delete object bh_tbl-name no-error.
      510         assign
      511           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      512         .
      513         create buffer bh_tbl-name for table v-full-tbl-name .
      514       end.
      515       block_where:
      516       do v-ind = 1 to v-idx-field-qnty by 2
      517       on error undo, return error
      518       :
      519         assign
      520           v-count-fld = v-count-fld + 1
      521         .
      522         if p-key-handle = ?
      523           and v-count-fld > v-field-num
      524         then do:
      525           leave block_where.
      526         end.
      527         define variable VfieldKeyTable as handle no-undo.
      528         assign
      529           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      530           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      531         .
      532         if     bh_tbl-key ne ?
      533         then do:
      534            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      535            if VfieldKeyTable eq ?
      536            then next block_where.
      537         end.
      538         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      539         then
      540            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      541         else
      542            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      543         if p-key-handle = ? then do:
      544           assign
      545             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      546           .
      547         end.
      548         else do:
      549           assign
      550             fh_key = p-key-handle:buffer-field( v-field-name )
      551           .
      552           if fh_key = ?
      553             or not valid-handle( fh_key )
      554           then do:
      555             delete object bh_tbl-name.
      556             if     bh_tbl-key ne ?
      557             then
      558                delete object bh_tbl-key.
      559             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      560           end.
      561           assign
      562             v-field-val = fh_key:buffer-value
      563           .
      564         end.
      565         if fh_search:data-type ="character":U then do:
      566           assign
      567             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      568             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      569             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      570             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      571             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      572             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      573             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      574             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      575             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      576             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      577             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      578             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      579             v-field-val = substitute( '"&1"', v-field-val )
      580           .
      581         end.
      582         assign
      583           o-where = substitute( "&1 &2", o-where, v-field-val )
      584         .
      585         if v-word-link = "":U then do:
      586           assign
      587             v-word-link = "and":U
      588           .
      589         end.
      590       end.
      591       delete object bh_tbl-name.
      592       if     bh_tbl-key ne ?
      593       then
      594          delete object bh_tbl-key.
      595       if p-key-handle = ?
      596         and v-count-fld <> v-field-num
      597       then do:
      598         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      599       end.
      600     end.
      601   end procedure.
      602   procedure gen-hn-keyr-tab :
      603     define input  parameter i-tableSerach as character no-undo.
      604     define input  parameter i-tablekey   as character no-undo.
      605     define input  parameter p-key-rec    as character no-undo.
      606     define input  parameter p-key-handle as handle    no-undo .
      607     define input  parameter p-db-name    as character no-undo .
      608     define input  parameter p-tt-handle  as handle    no-undo .
      609     define input  parameter p-stts-lock  as integer   no-undo .
      610     define output parameter o-hn         as handle    no-undo.
      611     define variable v-full-tbl-name as character no-undo.
      612     define variable v-where         as character no-undo.
      613     define variable bh_tbl-name     as handle    no-undo.
      614     define variable vTable          as character no-undo.
      615     do
      616     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      617     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      618     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      619         run gen-where-keyr-tab(i-tableSerach,
      620                                i-tablekey,
      621                                p-key-rec,
      622                                p-key-handle,
      623                                p-db-name,
      624                                p-tt-handle,
      625                                output v-where).
      626         if i-tableSerach ne "" and i-tableSerach ne ?
      627         then do:
      628            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      629            create buffer bh_tbl-name for table v-full-tbl-name .
      630         end.
      631         else do:
      632            if p-tt-handle = ? then do:
      633               assign
      634                  vTable = entry( 1 , p-key-rec, chr(3) )
      635               .
      636               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      637               create buffer bh_tbl-name for table v-full-tbl-name .
      638            end.
      639            else do:
      640               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      641            end.
      642         end.
      643         if p-tt-handle = ? then do:
      644            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      645         end.
      646         else do:
      647            bh_tbl-name:find-first( v-where ) no-error .
      648         end.
      649         o-hn = bh_tbl-name.
      650      end.
      651   end procedure.
      652   procedure gen-hn-keyr :
      653     define input  parameter p-key-rec    as character no-undo.
      654     define input  parameter p-key-handle as handle    no-undo .
      655     define input  parameter p-db-name    as character no-undo .
      656     define input  parameter p-tt-handle  as handle    no-undo .
      657     define input  parameter p-stts-lock  as integer   no-undo .
      658     define output parameter o-hn         as handle    no-undo.
      659     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      660   end.
      661   procedure gen-row-keyr :
      662     define input  parameter p-key-rec    as character no-undo.
      663     define input  parameter p-key-handle as handle    no-undo .
      664     define input  parameter p-db-name    as character no-undo .
      665     define input  parameter p-tt-handle  as handle    no-undo .
      666     define input  parameter p-stts-lock  as integer   no-undo .
      667     define output parameter p-tbl-row    as rowid     no-undo.
      668     define output parameter p-tbl-name   as character no-undo.
      669     define variable vHn as handle no-undo.
      670       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      671       p-tbl-row = if vHn:available then vHn:rowid else ?.
      672       p-tbl-name =  vHn:table.
      673       delete object vHn no-error.
      674     if p-tbl-row = ? then do:
      675       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      676     end.
      677     else do:
      678       return.
      679     end.
      680   end procedure.
      681   procedure gen-key-fv :
      682     define input  parameter p-key-rec    as character no-undo .
      683     define output parameter p-field-list as character no-undo .
      684     define output parameter p-value-list as character no-undo.
      685     do
      686     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      687     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      688     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      689     :
      690       define variable v-full-tbl-name  as character no-undo .
      691       define variable bh_tbl-name      as handle    no-undo .
      692       define variable v-tbl-name       as character no-undo .
      693       define variable v-field-num      as integer   no-undo .
      694       define variable v-count-fld      as integer   no-undo .
      695       define variable v-inform         as character no-undo .
      696       define variable v-ind            as integer   no-undo .
      697       define variable v-idx-field-qnty as integer   no-undo .
      698       define variable v-delim-key      as character no-undo .
      699       if p-key-rec = ?
      700         or p-key-rec = "":U
      701       then do:
      702         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      703       end.
      704       assign
      705         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      706         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      707       .
      708       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      709       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      710       assign
      711         v-inform = bh_tbl-name:index-information(1)
      712         v-ind    = 2
      713       .
      714       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      715       on error undo, return error
      716       :
      717         assign
      718           v-inform = bh_tbl-name:index-information( v-ind )
      719           v-ind    = v-ind + 1
      720         .
      721       end.
      722       if v-inform = ?
      723         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      724         or entry( 3, v-inform, ",":U ) <> "1":U
      725       then do:
      726         delete object bh_tbl-name no-error.
      727         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      728       end.
      729       assign
      730         v-idx-field-qnty = num-entries( v-inform ) - 4
      731       .
      732       if v-idx-field-qnty < 2 then do:
      733         delete object bh_tbl-name no-error.
      734         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      735       end.
      736       assign
      737         p-field-list = "":U
      738         p-value-list = "":U
      739         v-delim-key  = "":U
      740         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      741         v-count-fld  = 0
      742       .
      743       block_where:
      744       do v-ind = 1 to v-idx-field-qnty by 2
      745       on error undo, return error
      746       :
      747         assign
      748           v-count-fld = v-count-fld + 1
      749         .
      750         if v-count-fld > v-field-num then do:
      751           leave block_where.
      752         end.
      753         assign
      754           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      755           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      756         .
      757         if v-ind = 1 then do:
      758           assign
      759             v-delim-key = chr(3)
      760           .
      761         end.
      762       end.
      763       delete object bh_tbl-name.
      764       if v-count-fld <> v-field-num then do:
      765         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      766       end.
      767     end.
      768   end procedure.
      769   procedure gen-key-field :
      770     define input  parameter p-table      as character no-undo .
      771     define output parameter p-field-list as character no-undo .
      772     do
      773     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      774     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      775     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      776     :
      777       define variable v-full-tbl-name  as character no-undo .
      778       define variable bh_tbl-name      as handle    no-undo .
      779       define variable v-tbl-name       as character no-undo .
      780       define variable v-field-num      as integer   no-undo .
      781       define variable v-count-fld      as integer   no-undo .
      782       define variable v-inform         as character no-undo .
      783       define variable v-ind            as integer   no-undo .
      784       define variable v-idx-field-qnty as integer   no-undo .
      785       define variable v-delim-key      as character no-undo .
      786       if p-table = ?
      787         or p-table = "":U
      788       then do:
      789         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      790       end.
      791       assign
      792         v-tbl-name      = p-table
      793         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      794       .
      795       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      796       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      797       assign
      798         v-inform = bh_tbl-name:index-information(1)
      799         v-ind    = 2
      800       .
      801       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      802       on error undo, return error
      803       :
      804         assign
      805           v-inform = bh_tbl-name:index-information( v-ind )
      806           v-ind    = v-ind + 1
      807         .
      808       end.
      809       if v-inform = ?
      810         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      811         or entry( 3, v-inform, ",":U ) <> "1":U
      812       then do:
      813         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      814       end.
      815       assign
      816         v-idx-field-qnty = num-entries( v-inform ) - 4
      817       .
      818       if v-idx-field-qnty < 2 then do:
      819         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      820       end.
      821       assign
      822         p-field-list = "":U
      823         v-delim-key  = "":U
      824         v-count-fld  = 0
      825       .
      826       block_where:
      827       do v-ind = 1 to v-idx-field-qnty by 2
      828       on error undo, return error
      829       :
      830         assign
      831           v-count-fld = v-count-fld + 1
      832         .
      833         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      834         if v-ind = 1 then do:
      835           assign
      836             v-delim-key = chr(3)
      837           .
      838         end.
      839       end.
      840       delete object bh_tbl-name.
      841     end.
      842   end procedure.
      843   procedure create-gds-list-flt-hist :
      844   define input parameter p-mode as character no-undo .
      845   define input-output parameter p-seq as integer no-undo .
      846   define input parameter p-line as integer no-undo .
      847   define variable p-list-table as character no-undo .
      848   define input parameter p-hist-mode as character no-undo .
      849   define input parameter p-des as character no-undo .
      850   define input parameter p-num-recs as integer no-undo .
      851   define input parameter p-option as character no-undo .
      852   define input parameter p-status_ as character no-undo .
      853   define input parameter p-item as character no-undo .
      854   define input parameter p-tbl-name as character no-undo .
      855   define input parameter p-bh_tbl-name as handle no-undo .
      856   define variable v-num-add as integer no-undo .
      857   define variable v-num-ignored as integer no-undo .
      858   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
      859     do
      860     on error undo, return error
      861     :
      862       CASE p-mode:
      863         when 'title' then do:
      864           find first buf_gds-list-flt-hist where
      865                      buf_gds-list-flt-hist.id = 0   no-error.
      866           if not available buf_gds-list-flt-hist then do:
      867             create buf_gds-list-flt-hist.
      868             assign
      869             buf_gds-list-flt-hist.id = 0
      870             buf_gds-list-flt-hist.line = 0
      871             buf_gds-list-flt-hist.list-table = '':U
      872             .
      873           end.
      874           assign
      875           buf_gds-list-flt-hist.des =  p-des
      876           buf_gds-list-flt-hist.num-recs = p-num-recs
      877           buf_gds-list-flt-hist.option_  = p-option
      878           buf_gds-list-flt-hist.item_ = p-item
      879           .
      880         end.
      881         when 'ДОБАВЛЕНИЕ':U then do:
      882           if p-option begins 'single' then do:
      883             CASE p-hist-mode:
      884               when '+':U then do:
      885                 assign
      886                 v-num-add = 1
      887                 v-num-ignored  = 0
      888                 .
      889               end.
      890               when '-':U then do:
      891                 assign
      892                 v-num-add = 1
      893                 v-num-ignored  = 0
      894                 .
      895               end.
      896               when '*':U then do:
      897                 assign
      898                 v-num-add = p-num-recs - 1
      899                 p-num-recs = 1
      900                 v-num-ignored  = 0
      901                 .
      902               end.
      903             END CASE.
      904           end.
      905           create buf_gds-list-flt-hist.
      906           assign
      907           buf_gds-list-flt-hist.id = p-seq
      908           buf_gds-list-flt-hist.list-table = p-list-table
      909            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      910           buf_gds-list-flt-hist.des =  p-des
      911           buf_gds-list-flt-hist.line = p-line
      912           buf_gds-list-flt-hist.num-recs = p-num-recs
      913           buf_gds-list-flt-hist.option_  = p-option
      914           buf_gds-list-flt-hist.item_ = p-item
      915           buf_gds-list-flt-hist.hist-mode =  p-hist-mode
      916           buf_gds-list-flt-hist.status_ =  p-status_
      917           buf_gds-list-flt-hist.num-add = v-num-add
      918           buf_gds-list-flt-hist.num-ignored = v-num-ignored
      919           .
      920         end.
      921         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      922           find first buf_gds-list-flt-hist where
      923                     buf_gds-list-flt-hist.id = p-seq
      924                 and buf_gds-list-flt-hist.line = p-line no-error .
      925           if  available buf_gds-list-flt-hist then do:
      926             assign
      927             buf_gds-list-flt-hist.des =  p-des
      928             buf_gds-list-flt-hist.num-recs = p-num-recs
      929             buf_gds-list-flt-hist.option_  = p-option
      930             buf_gds-list-flt-hist.item_ = p-item
      931             buf_gds-list-flt-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      932                                        then p-list-table
      933                                        else buf_gds-list-flt-hist.list-table)
      934             .
      935           end.
      936         end.
      937         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      938           find first buf_gds-list-flt-hist where
      939                     buf_gds-list-flt-hist.id = p-seq
      940                 and buf_gds-list-flt-hist.line = p-line  no-error .
      941           if available buf_gds-list-flt-hist then do:
      942             assign
      943             buf_gds-list-flt-hist.hist-mode =  p-hist-mode
      944             buf_gds-list-flt-hist.num-recs  = (if buf_gds-list-flt-hist.line = 0 then p-num-recs else buf_gds-list-flt-hist.num-recs)
      945             buf_gds-list-flt-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      946                                        then p-list-table
      947                                        else buf_gds-list-flt-hist.list-table)
      948             .
      949           end.
      950         end.
      951       END CASE.
      952       if p-tbl-name <> "":U
      953       and valid-handle(p-bh_tbl-name)
      954       then do:
      955         run gen-key-rec  in this-procedure (
      956                                               input  p-tbl-name
      957                                              ,input  p-bh_tbl-name
      958                                              ,output p-item) no-error .
      959         if not error-status:error then do:
      960           assign
      961           buf_gds-list-flt-hist.item_ = p-item
      962           .
      963         end.
      964         else do:
      965           assign
      966           buf_gds-list-flt-hist.item_ = "!ERROR"
      967           .
      968         end.
      969       end.
      970     end.
      971   end procedure.
      972   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      973   case p-hist-mode:
      974     when '+':U then
      975       return  'ДОБАВЛЕНИЕ':U.
      976     when '-':U then
      977       return  'удаление':U.
      978     when '*':U then
      979       return  'ОСТАВИТЬ':U.
      980   end CASE.
      981   END FUNCTION.
      982   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      983   case p-line-mode:
      984     when 'ДОБАВЛЕНИЕ':U then
      985       return  "+".
      986     when 'удаление':U then
      987       return  "-".
      988     when 'ОСТАВИТЬ':U then
      989       return  "*".
      990   end CASE.
      991   END FUNCTION.
      992   procedure proc-write-filter-expression :
      993   define input parameter p-filter-expression as character no-undo .
      994   define variable v-ii as integer no-undo .
      995   output to value(string(g#report-num) + ".whr").
      996   put .
      997   if num-entries(p-filter-expression) > 0 then do:
      998      put unformatted 'and ('.
      999      do v-ii = 1 to num-entries(p-filter-expression):
     1000        put unformatted entry(v-ii, p-filter-expression) skip.
     1001      end.
     1002      put unformatted ')'.
     1003   end.
     1004   output close.
     1005   end procedure.
     1006   procedure proc-write-filter-expression-var :
     1007   define input parameter p-filter-expression as character no-undo .
     1008   define output parameter p-string as character no-undo .
     1009   define variable v-ii as integer no-undo .
     1010   if num-entries(p-filter-expression) > 0 then do:
     1011      p-string = 'and ('.
     1012      do v-ii = 1 to num-entries(p-filter-expression):
     1013        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1014      end.
     1015      p-string = p-string + ')'.
     1016   end.
     1017   end procedure.
     1018   define new global shared variable g#libbcrcn as handle no-undo .
     1019   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1020   define variable v-waitfram-action01         as character   no-undo .
     1021   define variable v-waitfram-action02         as character   no-undo .
     1022   define variable v-waitfram-action03         as character   no-undo .
     1023   define variable mWaitFramTextBeg            as character   no-undo.
     1024   define variable mWaitFramTextEnd            as character   no-undo.
     1025   define variable mWaitFramView               as logical     no-undo.
     1026   define variable mWaitProcEvent              as logical     no-undo init yes.
     1027   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1028   define variable mWaitFramStop               as logical     no-undo.
     1029   define variable mWaitFramStopUser           as logical     no-undo.
     1030   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1031   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1032   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1033   define button B-WaitFramStop auto-end-key
     1034        label "Стоп"
     1035        size 10 by 1 tooltip "Остоновить процесс".
     1036   define button B-viewProcInfo
     1037        label "Информация"
     1038        size 15 by 1 tooltip "Информация о процесс".
     1039   define frame waitfram
     1040     v-waitfram-action01 format "x(72)" no-label skip
     1041     v-waitfram-action02 format "x(72)" no-label skip
     1042     v-waitfram-action03 format "x(72)" no-label skip
     1043     B-viewProcInfo
     1044     B-WaitFramStop at row 4 col 30
     1045     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1046     .
     1047   define new global shared variable mBatchMode as logical no-undo init ?.
     1048   define variable mFramBachModHandle as handle no-undo.
     1049   mFramBachModHandle = frame waitfram:handle.
     1050   define variable mFameOldVis as logical no-undo.
     1051   define variable mVisCUrentVin as logical no-undo.
     1052   if session:batch-mode
     1053   then
     1054      mBatchMode = yes.
     1055   if mBatchMode = ? then do:
     1056     mVisCUrentVin = current-window:visible.
     1057     mFameOldVis = mFramBachModHandle:visible.
     1058     mFramBachModHandle:visible  = yes.
     1059     mBatchMode = mFramBachModHandle:visible ne yes.
     1060     mFramBachModHandle:visible = mFameOldVis.
     1061     current-window:visible = mVisCUrentVin.
     1062   end.
     1063    if  log-manager:logfile-name ne ?
     1064     then DO:
     1065         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1066         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1067         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1068     end.
     1069   on choose of B-WaitFramStop in frame waitfram
     1070   do:
     1071     mWaitFramStop = yes.
     1072     mWaitFramStopUser = yes.
     1073   end.
     1074   function waitfram-check-timeout returns logical():
     1075      define variable vtime as int64 no-undo.
     1076      if mWaitFramStopTimeOut
     1077      then
     1078         return yes.
     1079      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1080      if     mWaitFramTimeOut ne ?
     1081         and mWaitFramTimeOut ne 0
     1082         and mWaitFramTimeOut lt vtime
     1083      then do:
     1084         mWaitFramStopTimeOut = yes.
     1085      end.
     1086      return mWaitFramStopTimeOut.
     1087   end.
     1088   procedure waitfram-hide :
     1089     if not session:batch-mode
     1090     then do
     1091     on error undo, return error return-value
     1092     :
     1093       pause 0 before-hide .
     1094       if not mBatchMode then
     1095         hide frame waitfram .
     1096     if     not mWaitFramView
     1097        and mWaitProcEvent
     1098     then
     1099       process events .
     1100     end.
     1101   end procedure.
     1102   procedure waitfram-show :
     1103     define input  parameter p-message as character no-undo .
     1104     define variable v-left-margin as integer   no-undo .
     1105     if not session:batch-mode
     1106     then do
     1107     on error undo, return error return-value
     1108     :
     1109       if length(p-message) <= 70 then do:
     1110         assign
     1111           v-left-margin = integer((70 - length(p-message)) / 2)
     1112         .
     1113         assign
     1114           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1115         .
     1116         assign
     1117           v-waitfram-action01 = " "
     1118           v-waitfram-action02 = " "
     1119                                    + fill(" ", v-left-margin)
     1120                                    + p-message
     1121           v-waitfram-action03 = " "
     1122         .
     1123       end.
     1124       else do:
     1125         define variable vRindex1 as integer no-undo.
     1126         define variable vRindex2 as integer no-undo.
     1127         vRindex1 = r-index(p-message," ",70).
     1128         if vRindex1 = 0
     1129         then
     1130            vRindex1 = 70.
     1131         if length(p-message)  <= vRindex1 + 70 then do:
     1132           assign
     1133             v-waitfram-action01 = " "
     1134             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1135             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1136           .
     1137         end.
     1138         else do:
     1139           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1140           if vRindex2 <= vRindex1
     1141           then
     1142              vRindex2 = vRindex1 + 70.
     1143           assign
     1144             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1145             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1146             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1147           .
     1148         end.
     1149       end.
     1150       B-viewProcInfo:visible   in frame waitfram = no.
     1151       B-viewProcInfo:sensitive in frame waitfram = no.
     1152       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1153       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1154       if  (   mWaitFramView
     1155          or  mWaitProcEvent)
     1156          and not mBatchMode
     1157       then
     1158          display
     1159             v-waitfram-action01 skip
     1160             v-waitfram-action02 skip
     1161             v-waitfram-action03 skip
     1162          with frame waitfram .
     1163       if     mWaitFramView
     1164          then do:
     1165             if     mWaitFramInterval ne ?
     1166                and not mBatchMode
     1167             then
     1168                wait-for go of frame waitfram pause mWaitFramInterval.
     1169          end.
     1170          else
     1171             if     mWaitProcEvent
     1172                and not mBatchMode
     1173             then
     1174                process events .
     1175     end.
     1176   end procedure.
     1177      procedure waitfram-show-this:
     1178         define input  parameter iInterval as int64 no-undo.
     1179         define variable vtime as int64 no-undo.
     1180         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1181         mWaitFramInterval = iInterval.
     1182         run waitfram-show (substitute("&1&2 &3&4" ,
     1183                                       mWaitFramTextBeg ,
     1184                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1185                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1186                                       mWaitFramTextEnd
     1187                                      )
     1188                           ).
     1189      end.
     1190      procedure WaitFramRunPause:
     1191         define input  parameter iInterval as dec no-undo.
     1192         define variable vStart  as datetime-tz no-undo.
     1193         define variable vend    as datetime-tz no-undo.
     1194         define variable vint as int64 no-undo.
     1195         define variable vOk as logical no-undo.
     1196         vStart = now.
     1197         vend   = vStart.
     1198         publish "WaitFramPause" (iInterval,output vOk).
     1199         vend   =  now.
     1200         vint = vend - vStart.
     1201         vint = iInterval - vint / 1000.
     1202         if     not mWaitFramStop
     1203            and (   vint > 0
     1204                 or (    not vOk
     1205                     and iInterval eq ?
     1206                     )
     1207                 )
     1208         then
     1209            run waitfram-show-this (iInterval).
     1210         vend   =  now.
     1211         vint = vend - vStart.
     1212         vint = iInterval - vint / 1000.
     1213         if     not mWaitFramStop
     1214            and vint > 0
     1215         then do:
     1216            run gbl/pause.p (vint * 1000).
     1217         end.
     1218         if iInterval ne ?
     1219         then
     1220            publish "WaitFramStop".
     1221         waitfram-check-timeout().
     1222      end.
     1223      procedure WaitFramWaitFor:
     1224         define input  parameter iInterval as dec no-undo.
     1225         assign
     1226            mWaitFramStartProc   = now
     1227            mWaitFramStopUser    = no
     1228            mWaitFramStopTimeOut = no
     1229         .
     1230         block-wait:
     1231         do while not mWaitFramStop:
     1232            run WaitFramRunPause (iInterval).
     1233            if  waitfram-check-timeout()
     1234            then do:
     1235               leave block-wait.
     1236            end.
     1237         end.
     1238         run waitfram-hide.
     1239      end.
     1240   procedure waitfram-join :
     1241     define input  parameter p-line-1  as character no-undo .
     1242     define input  parameter p-line-2  as character no-undo .
     1243     define input  parameter p-line-3  as character no-undo .
     1244     define output parameter p-message as character no-undo .
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       assign
     1249         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1250                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1251                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1252       .
     1253     end.
     1254   end procedure.
     1255   function waitfram-join-function returns character
     1256     (input p-line-1 as character
     1257     ,input p-line-2 as character
     1258     ,input p-line-3 as character
     1259     ).
     1260     define variable v-message as character no-undo .
     1261     run waitfram-join in this-procedure
     1262       (input  p-line-1
     1263       ,input  p-line-2
     1264       ,input  p-line-3
     1265       ,output v-message
     1266       ) .
     1267     return v-message .
     1268   end function .
     1269   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   procedure cur-time :
     1271      define output parameter p-today as date      no-undo .
     1272      define output parameter p-time  as integer   no-undo .
     1273     do
     1274     on error undo, return error
     1275     :
     1276       define variable v-date1 as date      no-undo .
     1277       define variable v-date2 as date      no-undo .
     1278       define variable v-time  as integer   no-undo .
     1279       assign
     1280         v-date1 = today
     1281         v-time  = time
     1282         v-date2 = today
     1283       .
     1284       if v-date1 <> v-date2
     1285       then do:
     1286         assign
     1287           v-date1 = today
     1288           v-time  = v-time
     1289         .
     1290       end.
     1291       assign
     1292         p-today = v-date1
     1293         p-time  = v-time
     1294       .
     1295     end.
     1296   end.
     1297   function cur-time-date returns character
     1298   :
     1299     return string(today, '99/99/9999':U) .
     1300   end.
     1301   function cur-time-mjd returns decimal
     1302   :
     1303     define variable v-date as date      no-undo .
     1304     define variable v-time as integer   no-undo .
     1305     run cur-time in this-procedure
     1306       (output v-date
     1307       ,output v-time
     1308       ) .
     1309     return integer(v-date) - 2400002 + (v-time / 86400) .
     1310   end.
     1311   function cur-time-get-ending-index returns integer
     1312   (input p-number as integer
     1313   )
     1314   :
     1315     if p-number < 0
     1316     or p-number = ?
     1317     then do:
     1318       return 1 .
     1319     end.
     1320     define variable v-rest as integer   no-undo .
     1321     assign
     1322       p-number = p-number modulo 100
     1323     .
     1324     if p-number < 20
     1325     then do:
     1326       assign
     1327         v-rest = p-number
     1328       .
     1329     end.
     1330     else do:
     1331       assign
     1332         v-rest = p-number modulo 10
     1333       .
     1334     end.
     1335     case v-rest :
     1336       when 1
     1337       then do:
     1338         return 2 .
     1339       end.
     1340       when 2 or
     1341       when 3 or
     1342       when 4
     1343       then do:
     1344         return 3 .
     1345       end.
     1346       otherwise do:
     1347         return 1 .
     1348       end.
     1349     end case .
     1350   end.
     1351   procedure cur-time-mjd-to-date :
     1352      define input  parameter i-mjd-diff as decimal no-undo.
     1353      define output parameter o-Date     as date    no-undo.
     1354      define output parameter o-Time     as integer no-undo.
     1355      define variable v-day-number as integer   no-undo .
     1356      if    i-mjd-diff < 0
     1357         or i-mjd-diff = ?
     1358      then do:
     1359         return "?" .
     1360      end.
     1361      assign
     1362         v-day-number = truncate(i-mjd-diff,0).
     1363         o-Date = date(v-day-number + 2400002).
     1364         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1365     .
     1366   end.
     1367   function cur-time-mjd-to-string returns character
     1368   (input p-mjd-diff as decimal
     1369   )
     1370   :
     1371     define variable v-day-number as integer   no-undo .
     1372     define variable v-seconds    as integer   no-undo .
     1373     define variable v-hour       as integer   no-undo .
     1374     define variable v-min        as integer   no-undo .
     1375     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1376     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1377     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1378     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1379     if p-mjd-diff < 0
     1380     or p-mjd-diff = ?
     1381     then do:
     1382       return "?" .
     1383     end.
     1384     assign
     1385       v-day-number = integer(truncate(p-mjd-diff,0))
     1386       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1387     .
     1388     if v-seconds > 86400
     1389     then do:
     1390       assign
     1391         v-seconds = 86400 - 1
     1392       .
     1393     end.
     1394     if v-seconds < 0
     1395     then do:
     1396       assign
     1397         v-seconds = 0
     1398       .
     1399     end.
     1400     assign
     1401       v-hour = truncate(v-seconds / 3600, 0)
     1402     .
     1403     assign
     1404       v-seconds = v-seconds modulo 3600
     1405     .
     1406     assign
     1407       v-min = truncate(v-seconds / 60, 0)
     1408     .
     1409     assign
     1410       v-seconds = v-seconds modulo 60
     1411     .
     1412     return
     1413         (if v-day-number <> 0
     1414           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1415           else ""
     1416         )
     1417       + (if v-day-number <> 0 or v-hour <> 0
     1418           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1419           else ""
     1420         )
     1421       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1422           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1423           else ""
     1424         )
     1425       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1426       .
     1427   end.
     1428   function cur-time-string returns character
     1429   :
     1430     define variable v-date as date      no-undo .
     1431     define variable v-time as integer   no-undo .
     1432     run cur-time in this-procedure
     1433       (output v-date
     1434       ,output v-time
     1435       ) .
     1436     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1437   end.
     1438   function cur-time-string-sec returns character
     1439   :
     1440     define variable v-date as date      no-undo .
     1441     define variable v-time as integer   no-undo .
     1442     run cur-time in this-procedure
     1443       (output v-date
     1444       ,output v-time
     1445       ) .
     1446     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1447   end.
     1448   function cur-time-custom  returns character
     1449   (input p-prefix as character
     1450   ,input p-date-format as character
     1451   ,input p-delimiter as character
     1452   ,input p-time-format as character
     1453   ,input p-suffix as character
     1454   )
     1455   :
     1456     define variable v-date as date      no-undo .
     1457     define variable v-time as integer   no-undo .
     1458     run cur-time in this-procedure
     1459       (output v-date
     1460       ,output v-time
     1461       ) .
     1462     return
     1463       p-prefix
     1464       + string(v-date, p-date-format)
     1465       + p-delimiter
     1466       + string(v-time, p-time-format)
     1467       + p-suffix
     1468       .
     1469   end.
     1470   function cur-time-print  returns character
     1471   :
     1472     define variable v-date as date      no-undo .
     1473     define variable v-time as integer   no-undo .
     1474     run cur-time in this-procedure
     1475       (output v-date
     1476       ,output v-time
     1477       ) .
     1478     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1479   end.
     1480   function cur-time-datetime returns datetime
     1481   :
     1482     define variable v-char as character no-undo .
     1483     define variable v-datetime as datetime no-undo .
     1484     v-char = cur-time-string().
     1485     v-datetime = datetime(v-char).
     1486     return  v-datetime.
     1487   end.
     1488   function cur-time-string-msec returns character
     1489   :
     1490     define variable v-date as datetime  no-undo .
     1491     v-date = now.
     1492     return string(v-date) .
     1493   end.
     1494   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1495     define variable v-cntxt-db-num        as integer   no-undo .
     1496     define variable v-cntxt-userid        as character no-undo .
     1497     define variable v-cntxt-level         as character no-undo .
     1498     define variable v-cntxt-host-code-obj as integer   no-undo .
     1499     define variable v-cntxt-obj-type      as character no-undo .
