    10842   PROCEDURE trig-fbr :
    10843   define input parameter p-method as character no-undo .
    10844   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10845   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10846   DEFINE VARIABLE vlabel               as character           no-undo .
    10847   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10848   DEFINE VARIABLE v-fbr-list           as character           no-undo .
    10849   define variable v-grp-recid          as recid               no-undo .
    10850   define variable v-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo.
    10851   define variable glog as logical no-undo .
    10852   define variable v-item               as character           no-undo .
    10853   define variable v-fbr-obj-type       like ub.fbr-gds-obj.obj-type no-undo .
    10854   define variable v-fbr-obj-code       like ub.fbr-gds-obj.obj-code no-undo .
    10855   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10856   if p-method = "fbr-gds-obj-val" then do:
    10857     assign
    10858     v-attr-code = ""
    10859     vattr-codes = "is-cd,is-menu,is-null-price,is-modificator,is-season,is-semi-finished,fbr-grp-code,fbr-obj-code"
    10860     vattr-labels = "Отправлять на кассу РЕСТОРАНА,Является блюдом меню,Без цены,Модификатор блюда,Применять сезонный коэффициент," +
    10861                   "Является полуфабрикатом,Группа меню,Кухня"
    10862     vvalue = ""
    10863     .
    10864     run gbl/d-list.w ( input "b-sel":U
    10865                       ,input "Выберите атрибут"
    10866                       ,input vattr-codes
    10867                       ,input vattr-labels
    10868                       ,input chr(44)
    10869                       ,input "":U
    10870                       ,output v-attr-code).
    10871     if v-attr-code = "" then do:
    10872       return error.
    10873     end.
    10874     assign
    10875     vlabel =  entry(lookup(v-attr-code, vattr-codes) ,vattr-labels)
    10876     glog = yes.
    10877   end.
    10878   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10879   run userobjs_select-one in this-procedure
    10880     (input  parparentproc
    10881     ,input  v-cntxt-db-num
    10882     ,input  v-cntxt-userid
    10883     ,input  v-cntxt-host-code-obj
    10884     ,input  v-cntxt-obj-type
    10885     ,input  v-cntxt-obj-code
    10886     ,output v-user-select
    10887     ,output v-sel-obj-type
    10888     ,output v-sel-obj-code
    10889     )  .
    10890     if not v-user-select then do:
    10891       return error.
    10892     end.
    10893   if p-method = "fbr-gds-obj-val" then do:
    10894     CASE v-attr-code:
    10895       when "fbr-grp-code" then do:
    10896           run ref/fbrggrp.w (
    10897                   input ?
    10898                 ,input v-sel-obj-type
    10899                 ,input v-sel-obj-code
    10900                 ,input "b-sel"
    10901                 ,input-output v-grp-recid
    10902             ).
    10903         if v-grp-recid = ? then return error.
    10904         FIND FIRST buf_fbr-gds-grp no-lock where
    10905                 recid(buf_fbr-gds-grp) = v-grp-recid No-ERROR.
    10906         if not avail buf_fbr-gds-grp then return error.
    10907         assign
    10908         vvalue = string(buf_fbr-gds-grp.node-code)
    10909         vlabel = vlabel + " = ":U + buf_fbr-gds-grp.node-name
    10910         .
    10911       end.
    10912       when "fbr-obj-code" then do:
    10913         message
    10914         "Выберите объект-КУХНЮ для товара объекта" v-sel-obj-type v-sel-obj-code
    10915         view-as alert-box.
    10916   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10917   run userobjs_select-one in this-procedure
    10918     (input  parparentproc
    10919     ,input  v-cntxt-db-num
    10920     ,input  v-cntxt-userid
    10921     ,input  v-cntxt-host-code-obj
    10922     ,input  v-cntxt-obj-type
    10923     ,input  v-cntxt-obj-code
    10924     ,output v-user-select
    10925     ,output v-fbr-obj-type
    10926     ,output v-fbr-obj-code
    10927     )  .
    10928         assign
    10929         vvalue = string(v-fbr-obj-code)
    10930         .
    10931       end.
    10932       otherwise do:
    10933         assign
    10934         vvalue = "yes":U
    10935         .
    10936         run gbl/d-prompt.w (
    10937           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10938         + 'text1=':u + vlabel + '\':u
    10939         + 'format=yes/no' + '\':u
    10940         + 'type=logical' + '\':u
    10941         + 'fillin_row=2\':u
    10942         + 'fillin_col=4\':u
    10943         + 'fillin_width=20\':u
    10944         + 'fillin_height=1\':u
    10945         + 'max-chars=70\':u
    10946         + 'readonly=no\':u
    10947         , input-output vvalue
    10948         ).
    10949         if return-value = 'false':U then do:
    10950           return error.
    10951         end.
    10952       end.
    10953     END CASE.
    10954     assign
    10955     dsp-rs = substitute("Товары объекта &1&2 с атрибутом РЕСТОРАН &3 =&4&5&5"
    10956                          ,  v-sel-obj-type, v-sel-obj-code, vlabel, vvalue
    10957                          , chr(10)
    10958                          , stat-line(rs-status)
    10959                          )
    10960     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    10961     .
    10962   end.
    10963   else do:
    10964     assign
    10965     dsp-rs = substitute("Товары объекта &1&2, имеющие атрибут РЕСТОРАН&3&4"
    10966                        ,  v-sel-obj-type
    10967                         , v-sel-obj-code
    10968                          , chr(10)
    10969                          , stat-line(rs-status)
    10970                        )
    10971      v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3)
    10972      .
    10973   end.
    10974     message
    10975     dsp-rs skip
    10976     view-as alert-box question buttons OK-Cancel update glog.
    10977   if not glog then do:
    10978     return error.
    10979   end.
    10980   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10981                                       , input-output v-seq
    10982                                       , input 0
    10983                                       , input '':U
    10984                                       , input dsp-rs
    10985                                       , input tot-lns
    10986                                       , input rs-list-method
    10987                                       , input rs-status
    10988                                       , input v-item
    10989                                       , input '':U
    10990                                       , input ?
    10991                                       ).
    10992   END PROCEDURE.
    10993   PROCEDURE proc-scales-gds :
    10994   define input parameter rs-list-method as character no-undo .
    10995   define variable v-ref-list as character no-undo .
    10996   define variable v-rid-list as character no-undo .
    10997   define variable glog as logical no-undo .
    10998   define variable v-message as character no-undo .
    10999   define variable v-item as character no-undo .
    11000   define buffer buf_scales for ub.scales.
    11001   glog = yes.
    11002   CASE rs-list-method:
    11003     when "scales-gds":U then do:
    11004       assign
    11005       v-message = substitute("Все товары на весах на объекте&1&2", chr(10), stat-line(rs-status))
    11006       .
    11007     end.
    11008     when "scales-gds-num":U then do:
    11009       assign
    11010       v-message = substitute("Товары на одних весах на объекте &1&2", chr(10), stat-line(rs-status))
    11011       .
    11012     end.
    11013   END CASE.
    11014   message
    11015   v-message
    11016   view-as alert-box question buttons OK-Cancel update glog.
    11017   if not glog then do:
    11018     return error.
    11019   end.
    11020   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11021   run userobjs_select-one in this-procedure
    11022     (input  parparentproc
    11023     ,input  v-cntxt-db-num
    11024     ,input  v-cntxt-userid
    11025     ,input  v-cntxt-host-code-obj
    11026     ,input  v-cntxt-obj-type
    11027     ,input  v-cntxt-obj-code
    11028     ,output v-user-select
    11029     ,output v-sel-obj-type
    11030     ,output v-sel-obj-code
    11031     )  .
    11032   if not v-user-select then do:
    11033     return error.
    11034   end.
    11035   if rs-list-method = "scales-gds-num" then do:
    11036     run ref/scales.w ( input parparentproc
    11037                       ,input v-sel-obj-type
    11038                       ,input v-sel-obj-code
    11039                       ,input "b-sel"
    11040                       ,input 'db':U
    11041                       ,output v-rid-list).
    11042     if v-rid-list = '':U then do:
    11043       return error.
    11044     end.
    11045     find first buf_scales no-lock where
    11046               recid(buf_scales) = integer(v-rid-list).
    11047   end.
    11048   CASE rs-list-method:
    11049     when "scales-gds":U then do:
    11050       assign
    11051       dsp-rs = substitute("ВСЕ товары на весах на объекте &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11052       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11053       .
    11054     end.
    11055     when "scales-gds-num":U then do:
    11056       assign
    11057       dsp-rs = substitute("Товары на весах &1 на объекте &2&3 &4", buf_scales.scales-num, v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11058       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(buf_scales.scales-num)
    11059       .
    11060     end.
    11061   END CASE.
    11062   v-no-hist = 0.
    11063   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
