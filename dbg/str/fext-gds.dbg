     4184   run prn-lib-open-stream  in this-procedure (
     4185                                                input parParentProc
     4186                                               ,input 43
     4187                                               ,input yes
     4188                                               ,input no
     4189                                               ).
     4190   find first buf_gds-list-flt-hist no-lock where buf_gds-list-flt-hist.id = 0 no-error .
     4191   PUT  STREAM PrnLibStream unformatted
     4192   SPACE(25) "История создания списка товаров "
     4193   (if available buf_gds-list-flt-hist
     4194   then buf_gds-list-flt-hist.des
     4195   else "БЕЗЫМЯННЫЙ") skip(0)
     4196   space(25) cur-time-print() skip(1)
     4197   .
     4198   put stream PrnLibStream unformatted
     4199   string("№", "X(9)") chr(32)
     4200   string("Действие", "X(9)") chr(32)
     4201   string("записей", "X(9)") chr(32)
     4202   string(" = итого", "X(12)") chr(32)
     4203   string("Множество", "X(155)")
     4204   skip(0)
     4205   fill('-':U, 9) chr(32)
     4206   fill('-':U, 9) chr(32)
     4207   fill('-':U, 9) chr(32)
     4208   fill('-':U, 12) chr(32)
     4209   fill('-':U, 155)
     4210   skip(0)
     4211   .
     4212   for each buf_gds-list-flt-hist where buf_gds-list-flt-hist.id > 0
     4213   by buf_gds-list-flt-hist.id
     4214   :
     4215     put stream PrnLibStream unformatted
     4216     (if buf_gds-list-flt-hist.line = 0
     4217      then string(buf_gds-list-flt-hist.id, ">>>>>>>>9")
     4218      else fill(chr(32) , 9)
     4219     )  chr(32)
     4220     (if buf_gds-list-flt-hist.item_ <> '':U
     4221      then string(buf_gds-list-flt-hist.hist-mode, "X(8)")
     4222      else fill( chr(32), 8)) chr(32)
     4223     string(buf_gds-list-flt-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4224     string(buf_gds-list-flt-hist.num-recs, ">>>>>>>>9")  chr(32)
     4225     string(buf_gds-list-flt-hist.des, "X(155)") skip.
     4226   end.
     4227   output stream prnlibstream close.
