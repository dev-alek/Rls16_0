     4361   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4362   procedure minbtn-set :
     4363       do
     4364           on error undo, return error return-value
     4365           :
     4366           define variable ii              as integer       no-undo .
     4367           define variable fh              as widget-handle no-undo .
     4368           define variable hh              as widget-handle no-undo .
     4369           define variable v-h             as handle        extent 4 no-undo .
     4370           define variable v-name-button   as character     no-undo .
     4371           define variable v-help-old-x    as decimal       no-undo .
     4372           define variable v-help-old-y    as decimal       no-undo .
     4373           define variable v-help-old-size as decimal       no-undo .
     4374           define variable v-frame-width   as decimal       no-undo .
     4375           define variable jj              as integer       no-undo .
     4376           do
     4377               on error undo, return error
     4378               :
     4379               assign
     4380                   v-frame-width = frame Dialog-Frame:width - 0.3
     4381                   fh            = frame Dialog-Frame:first-child
     4382                   hh            = fh:first-child
     4383                   ii            = 1
     4384                   .
     4385               do while valid-handle(hh):
     4386                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4387                   do:
     4388                       case lc(hh:name) :
     4389                           when "b-help" then
     4390                               do:
     4391                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4392                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4393                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4394                                   hh:TOOLTIP = "Помощь" .
     4395                                   v-help-old-x = hh:column .
     4396                                   v-help-old-y = hh:row    .
     4397                                   v-help-old-size = hh:width .
     4398                                   hh:width-chars = 2.5 .
     4399                               end.
     4400                           when "b-print" then
     4401                               do:
     4402                                   hh:load-image("cmp/b-print.bmp":u) .
     4403                                   hh:TOOLTIP = "Печать" .
     4404                                   v-h[ii] = hh:handle .
     4405                                   ii = ii + 1 .
     4406                                   hh:width-chars = 3 .
     4407                               end.
     4408                           when "b-history" or
     4409                           when "b-hist" then
     4410                               do:
     4411                                   hh:load-image("cmp/b-hist.bmp":u) .
     4412                                   hh:TOOLTIP = "История" .
     4413                                   v-h[ii] = hh:handle .
     4414                                   ii = ii + 1 .
     4415                                   hh:width-chars = 3 .
     4416                               end.
     4417                           when "b-sch" then
     4418                               do:
     4419                                   hh:load-image("cmp/b-sch.bmp":u) .
     4420                                   hh:TOOLTIP = "Установка Фильтра" .
     4421                                   v-h[ii] = hh:handle .
     4422                                   ii = ii + 1 .
     4423                                   hh:width-chars = 3 .
     4424                               end.
     4425                           when "b-hist-user" then
     4426                               do:
     4427                                   hh:load-image("cmp/b-hist.bmp":u) .
     4428                                   hh:TOOLTIP = "История пользователя" .
     4429                                   ii = ii + 1 .
     4430                               end.
     4431                       end case.
     4432                   end.
     4433                   hh = hh:next-sibling.
     4434               end.
     4435               b-help:column = v-frame-width - b-help:width-chars.
     4436               jj = 0.
     4437               repeat ii = 4 to 1 by -1 :
     4438                   if valid-handle (v-h[ii] ) then
     4439                   do:
     4440                       jj  = jj + 1 .
     4441                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4442                       v-h[ii]:row    = v-help-old-y .
     4443                   end.
     4444               end.
     4445           end.
     4446       end.
     4447   end procedure.
     4448   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4449   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4450   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4451   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4452   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4453   define variable v-diasize-current-frame-height as decimal   no-undo .
     4454   define variable v-diasize-change-size          as logical   no-undo .
     4455   define variable v-diasize-resize-button        as handle    no-undo .
     4456   define variable v-diasize-wndmax               as logical   no-undo .
     4457   define variable v-diasize-wndstore             as logical   no-undo .
     4458   define variable v-diasize-proc-name            as character no-undo .
     4459   define variable v-diasize-browse-handle        as handle    no-undo .
     4460   define variable v-diasize-browse-number        as integer   no-undo .
     4461   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4462   define temp-table temp-diasize-handle no-undo
     4463     field handle-value  as handle
     4464     field save-position as decimal
     4465     index xpk is primary unique handle-value
     4466     .
     4467   define temp-table temp-browse-handle no-undo
     4468     field browse-type   as character
     4469     field browse-number as integer
     4470     field browse-handle as handle
     4471     field original-size as decimal
     4472     index xpk is primary unique browse-type browse-number
     4473     index xie browse-type browse-handle
     4474   .
     4475   procedure diasize_change-height :
     4476     define input  parameter p-change-value  as decimal   no-undo .
     4477     define input  parameter p-move-resize   as logical   no-undo .
     4478     define variable v-field-group-handle    as handle    no-undo .
     4479     define variable v-object-handle         as handle    no-undo .
     4480     define variable v-frame-height          as decimal   no-undo .
     4481     define variable v-frame-virtual-height  as decimal   no-undo .
     4482     define variable v-browse-height         as decimal   no-undo .
     4483     define variable v-window-height         as decimal   no-undo .
     4484     define variable v-window-virtual-height as decimal   no-undo .
     4485     define variable v-change-sign           as integer   no-undo .
     4486     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4487     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4488     if p-change-value > 0
     4489     then do:
     4490       if frame Dialog-Frame :height + p-change-value
     4491           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4492       then do:
     4493         assign
     4494           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4495                           - (frame Dialog-Frame :height-chars)
     4496         .
     4497         if p-change-value <= 0
     4498         then do:
     4499           run diasize_position-resize-button in this-procedure .
     4500           return .
     4501         end.
     4502       end.
     4503     end.
     4504     if p-change-value < 0
     4505     then do:
     4506       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4507       then do:
     4508         assign
     4509           p-change-value = v-diasize-orig-frame-height
     4510                          - (frame Dialog-Frame :height-chars)
     4511         .
     4512         if p-change-value >= 0
     4513         then do:
     4514           run diasize_position-resize-button in this-procedure .
     4515           return .
     4516         end.
     4517       end.
     4518     end.
     4519     if p-change-value >= 0
     4520     then do:
     4521       assign
     4522         v-change-sign = 1
     4523       .
     4524     end.
     4525     else do:
     4526       assign
     4527         v-change-sign = -1
     4528       .
     4529     end.
     4530     assign
     4531       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4532     .
     4533     if p-change-value = 0
     4534     then do:
     4535       run diasize_position-resize-button in this-procedure .
     4536       return .
     4537     end.
     4538     move_block:
     4539     do
     4540     on error undo move_block, retry move_block
     4541     :
     4542       if retry
     4543       then do:
     4544         do
     4545         on error undo move_block, leave move_block
     4546         :
     4547           if p-change-value > 0
