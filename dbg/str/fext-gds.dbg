     3295   define variable vss-include-info22 as character format "X(65)" no-undo
     3296   initial "@(#)$Workfile$ $Revision$".
     3297   procedure grplib-get-full-name :
     3298      define input parameter p-node-code  as integer      no-undo.
     3299      define output parameter p-full-name as character    no-undo.
     3300      do
     3301   on error undo, return error
     3302   :
     3303       define variable v-upper-code    as integer           no-undo.
     3304       define buffer buf_gds-grp       for ub.gds-grp.
     3305       define buffer buf_upper_gds-grp for ub.gds-grp.
     3306       find first buf_gds-grp no-lock
     3307            where buf_gds-grp.node-code = p-node-code
     3308       no-error.
     3309       if not available buf_gds-grp
     3310       then do:
     3311           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3312       end.
     3313       assign
     3314           p-full-name  = ""
     3315           v-upper-code = 1
     3316       .
     3317       do while buf_gds-grp.upper-code <> 0
     3318       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3319       :
     3320           assign
     3321               p-full-name  = buf_gds-grp.node-name
     3322                            + (if p-full-name <> "" then chr(47) else "")
     3323                            + p-full-name
     3324               v-upper-code = buf_gds-grp.upper-code
     3325           .
     3326           find first buf_gds-grp no-lock
     3327                where buf_gds-grp.node-code = v-upper-code
     3328           no-error.
     3329           if not available buf_gds-grp
     3330           then do:
     3331               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3332                                   + string( v-upper-code )
     3333                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3334           end.
     3335       end.
     3336       assign
     3337       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3338       .
     3339   end.
     3340   end .
     3341   procedure grplib-get-node-from-full-name :
     3342   define input parameter p-full-name as character no-undo .
     3343   define output parameter p-node-code as integer no-undo .
     3344   define variable v-ii as integer no-undo .
     3345   define variable v-upper-code as integer no-undo .
     3346   define variable v-root-code as integer no-undo .
     3347   define variable v-entry as character no-undo .
     3348   define buffer buf_gds-grp       for ub.gds-grp.
     3349   do
     3350   on error undo, return error
     3351   :
     3352     find first buf_gds-grp no-lock
     3353         where buf_gds-grp.upper-code = 0
     3354     no-error .
     3355     if not available buf_gds-grp
     3356     then do:
     3357         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3358     end.
     3359     else do:
     3360       assign
     3361       v-root-code = buf_gds-grp.node-code
     3362       .
     3363     end.
     3364     v-upper-code = v-root-code.
     3365     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3366       assign
     3367       v-entry = entry(v-ii, p-full-name, chr(47)).
     3368       if v-entry = '' then leave.
     3369       find first buf_gds-grp no-lock where
     3370                 buf_gds-grp.node-name = v-entry
     3371             and buf_gds-grp.upper-code = v-upper-code
     3372             no-error.
     3373       if not available buf_gds-grp then do:
     3374         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3375       end.
     3376       else do:
     3377         p-node-code = buf_gds-grp.node-code.
     3378         v-upper-code = buf_gds-grp.node-code.
     3379       end.
     3380     end.
     3381   end.
     3382   end .
     3383   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3384   procedure cli-grplib-get-full-name :
     3385      define input parameter  p-node-code  as integer      no-undo.
     3386      define output parameter p-full-name as character    no-undo.
     3387   do
     3388   on error undo, return error
     3389   :
     3390       define variable v-upper-code    as integer           no-undo.
     3391       define buffer buf_cli-grp       for ub.cli-grp.
     3392       define buffer buf_upper_cli-grp for ub.cli-grp.
     3393       find first buf_cli-grp no-lock
     3394            where buf_cli-grp.node-code = p-node-code
     3395       no-error.
     3396       if not available buf_cli-grp
     3397       then do:
     3398           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     3399       end.
     3400       assign
     3401           p-full-name  = ""
     3402           v-upper-code = 1
     3403       .
     3404       do while buf_cli-grp.upper-code <> 0
     3405       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3406       :
     3407           assign
     3408               p-full-name  = buf_cli-grp.node-name
     3409                            + (if p-full-name <> "" then chr(47) else "")
     3410                            + p-full-name
     3411               v-upper-code = buf_cli-grp.upper-code
     3412           .
     3413           find first buf_cli-grp no-lock
     3414                where buf_cli-grp.node-code = v-upper-code
     3415           no-error.
     3416           if not available buf_cli-grp
     3417           then do:
     3418               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     3419                                   + string( v-upper-code )
     3420                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3421           end.
     3422       end.
     3423       assign
     3424       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3425       .
     3426   end.
     3427   end .
     3428   procedure cgrplib-get-node-from-full-name :
     3429   define input parameter p-full-name as character no-undo .
     3430   define output parameter p-node-code as integer no-undo .
     3431   define variable v-ii as integer no-undo .
     3432   define variable v-upper-code as integer no-undo .
     3433   define variable v-root-code as integer no-undo .
     3434   define variable v-entry as character no-undo .
     3435   define buffer buf_cli-grp       for ub.cli-grp.
     3436   do
     3437   on error undo, return error
     3438   :
     3439     find first buf_cli-grp no-lock
     3440         where buf_cli-grp.upper-code = 0
     3441     no-error .
     3442     if not available buf_cli-grp
     3443     then do:
     3444         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     3445     end.
     3446     else do:
     3447       assign
     3448       v-root-code = buf_cli-grp.node-code
     3449       .
     3450     end.
     3451     v-upper-code = v-root-code.
     3452     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3453       assign
     3454       v-entry = entry(v-ii, p-full-name, chr(47)).
     3455       if v-entry = '' then leave.
     3456       find first buf_cli-grp no-lock where
     3457                 buf_cli-grp.node-name = v-entry
     3458             and buf_cli-grp.upper-code = v-upper-code
     3459             no-error.
     3460       if not available buf_cli-grp then do:
     3461         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3462       end.
     3463       else do:
     3464         p-node-code = buf_cli-grp.node-code.
     3465         v-upper-code = buf_cli-grp.node-code.
     3466       end.
     3467     end.
     3468   end.
     3469   end .
