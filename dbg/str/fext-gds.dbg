     3672       ub.gds-prt.node-name at row 22 col 40 colon-aligned label "Шкала" fgcolor 4
     3673       ub.bar-code.b-code   at row 22 col 60 colon-aligned label "Код" format "9999999999" fgcolor 4
     3674       SPACE(0) SKIP(0)
