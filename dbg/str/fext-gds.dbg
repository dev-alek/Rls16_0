     1694   procedure userobjs_clear :
     1695     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1696     do
     1697     on error undo, return error return-value
     1698     :
     1699       for each buf_userobjs_temp-user-obj
     1700       on error undo, return error return-value
     1701       :
     1702         delete buf_userobjs_temp-user-obj .
     1703       end.
     1704     end.
     1705   end .
     1706   procedure userobjs_object-count :
     1707     define output parameter p-total-count as integer   no-undo .
     1708     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       assign
     1713         p-total-count = 0
     1714       .
     1715       for each buf_userobjs_temp-user-obj
     1716       on error undo, return error return-value
     1717       :
     1718         assign
     1719           p-total-count = p-total-count + 1
     1720         .
     1721       end.
     1722     end.
     1723   end.
     1724   procedure userobjs_append :
     1725      define input  parameter p-obj-type as character no-undo .
     1726      define input  parameter p-obj-code as integer   no-undo .
     1727     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1728     do
     1729     on error undo, return error return-value
     1730     :
     1731       find first buf_userobjs_temp-user-obj
     1732         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1733           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1734         no-error .
     1735       if not available buf_userobjs_temp-user-obj
     1736       then do:
     1737         create buf_userobjs_temp-user-obj .
     1738         assign
     1739           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1740           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1741         .
     1742       end.
     1743     end.
     1744   end.
     1745   procedure userobjs_object-exist :
     1746     define output parameter p-object-exist as logical   no-undo .
     1747     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1748     do
     1749     on error undo, return error return-value
     1750     :
     1751       find first buf_userobjs_temp-user-obj
     1752         no-error .
     1753       if not available buf_userobjs_temp-user-obj
     1754       then do:
     1755         assign
     1756           p-object-exist = false
     1757         .
     1758       end.
     1759       else do:
     1760         assign
     1761           p-object-exist = true
     1762         .
     1763       end.
     1764     end.
     1765   end.
     1766   procedure userobjs_transfer :
     1767     define input  parameter p-callback-handle as handle no-undo .
     1768     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1769     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1770     do
     1771     on error undo, return error return-value
     1772     :
     1773       if valid-handle(p-callback-handle) <> true
     1774       then do:
     1775         message
     1776           vss-workfile vss-revision vss-description skip
     1777           "Ошибка задания входных параметров" skip
     1778           "Неизвестный указатель на процедуру" skip
     1779           view-as alert-box error .
     1780         undo, return error return-value .
     1781       end.
     1782       if p-callback-handle :get-signature("userobjs_append") = ""
     1783       then do:
     1784         message
     1785           vss-workfile vss-revision vss-description skip
     1786           "Ошибка задания входных параметров" skip
     1787           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1788                     ,p-callback-handle :file-name
     1789                     ) skip
     1790           view-as alert-box error .
     1791         undo, return error return-value .
     1792       end.
     1793       for each buf_userobjs_temp-user-obj
     1794       on error undo, return error return-value
     1795       :
     1796         run userobjs_append in p-callback-handle
     1797           (input  buf_userobjs_temp-user-obj.obj-type
     1798           ,input  buf_userobjs_temp-user-obj.obj-code
     1799           ) .
     1800       end.
     1801     end.
     1802   end procedure.
