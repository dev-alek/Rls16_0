     8082             assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8083           end.
     8084         end.
     8085       end.
     8086     end.
     8087     when "doc-list"
     8088     or
     8089     when "prod-list"
     8090     or
     8091     when "supp-list"
     8092     or
     8093     when "cli-list"
     8094     or
     8095     when "scaner"
     8096     or
     8097     when "file"
     8098     or
     8099     when "clob-data"
     8100     then do:
     8101       run proc-file-list-methods in this-procedure(input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id). .
     8102     end.
     8103     when "deleted" then do:
     8104       find first buf_gds-list-flt-hist where
     8105                 buf_gds-list-flt-hist.id = p-id.
     8106       for each ub.goods where ub.goods.stts > 0 no-lock:
     8107         run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     8108       end.
     8109       assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8110     end.
     8111     when "filter" then do:
     8112       define variable v-filter-var as character no-undo .
     8113       find first buf_gds-list-flt-hist where
     8114                buf_gds-list-flt-hist.id = p-id
     8115            AND buf_gds-list-flt-hist.item_ <> '':U .
     8116       run proc-write-filter-expression-var in this-procedure ( input buf_gds-list-flt-hist.item_, output v-filter-var ).
     8117         run gbl/gdf-fill.p (
     8118                        input "Формирование списка по фильтру (без учета сортировки)"
     8119                      , input rs-list-method
     8120                      , input rs-status
     8121                      , input line-mode
     8122                      , input v-filter-var
     8123                      , output lns-cnt
     8124                      , output line-rec
     8125                      ) .
     8126        assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8127     end.
     8128       when "no-recipe-gds":U then do:
     8129        for each buf_gds-list-flt-hist where
     8130                buf_gds-list-flt-hist.id = p-id
     8131           and  buf_gds-list-flt-hist.item_ <> '':U:
     8132         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-flt-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8133         grp-path = "".
     8134         find first gds-grp no-lock where rowid(gds-grp) = v-rowid.
     8135         run grplib-get-full-name in this-procedure (gds-grp.node-code, output grp-path).
     8136         goods:
     8137         for each goods where goods.grp-name begins grp-path no-lock,
     8138             each recipe no-lock where recipe.artic = ub.goods.artic
     8139                           and recipe.prod-type = ub.goods.prod-type
     8140                           and recipe.prod-code = ub.goods.prod-code :
     8141             for each recipe-gds where recipe-gds.recipe-code = recipe.recipe-code no-lock:
     8142             if can-find(first gds-obj no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8143                                     and gds-obj.obj-code = v-cntxt-obj-code
     8144                                     and gds-obj.gds-code = recipe-gds.gds-code
     8145                                     and gds-obj.fact-qnty > 0) then.
     8146             else do:
     8147                   run ex-gds  in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8148                   next goods.
     8149               end.
     8150             end.
     8151         end.
     8152         assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8153        end.
     8154     end.
     8155     when "move-date":U then do:
     8156         find first buf_gds-list-flt-hist where
     8157             buf_gds-list-flt-hist.id = p-id
     8158         AND buf_gds-list-flt-hist.item_ <> '':U .
     8159         for each gds-obj  no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8160                                     and gds-obj.obj-code = v-cntxt-obj-code
     8161                                     and gds-obj.last-doc >= date(buf_gds-list-flt-hist.item_):
     8162             for first goods no-lock where
     8163                   goods.artic = ub.gds-obj.artic
     8164               and goods.prod-type = ub.gds-obj.prod-type
     8165               and goods.prod-code = ub.gds-obj.prod-code:
     8166               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8167               assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8168             end.
     8169         end.
     8170     end.
     8171   end.
     8172   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8173   if session:set-wait-state( "" )  then .
     8174   case line-mode :
     8175     when 'ДОБАВЛЕНИЕ':U then do:
     8176       tot-lns = tot-lns + lns-cnt.
     8177       if not p-from-macro or p-step then
     8178       message
     8179       "Добавлено строк :" lns-cnt skip(0)
     8180       string(if lns-ignore <> 0
     8181       then ("Проигнорировано строк :" + string(lns-ignore))
     8182       else "":U)
     8183       .
     8184     end.
     8185     when 'удаление':U then do:
     8186       tot-lns = tot-lns - lns-cnt.
     8187       if not p-from-macro or p-step then
     8188       message
     8189       "Удалено строк :" lns-cnt skip(0)
     8190       string(if lns-ignore <> 0
     8191       then ("Проигнорировано строк :" + string(lns-ignore))
     8192       else "":U)
     8193       .
     8194     end.
     8195   end.
     8196   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on in this-procedure.
     8197   end.
     8198   END PROCEDURE.
     8199   PROCEDURE write-hist :
     8200   define input parameter p-from-macro as logical no-undo .
     8201   define input parameter rs-list-method as character no-undo .
     8202   define input parameter rs-status as character no-undo .
     8203   define input parameter line-mode as character no-undo .
     8204   define variable v-ii as integer no-undo .
     8205   define variable v-temp-seq as integer no-undo .
     8206   if rs-list-method = "single" then do:
     8207     if v-no-hist < 0 then do:
     8208       run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8209                                           , input-output v-seq
     8210                                           , input 0
     8211                                           , input get-hist-mode(line-mode)
     8212                                           , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list-flt.gds-code, gds-list-flt.artic, gds-list-flt.prod-type, gds-list-flt.prod-code, gds-list-flt.gds-name)
     8213                                           , input tot-lns
     8214                                           , input rs-list-method
     8215                                           , input rs-status
     8216                                           , input ('goods':U + chr(3) + string(gds-list-flt.gds-code))
     8217                                           , input '':U
     8218                                           , input ?
     8219                                           ).
     8220     end.
     8221     else do:
     8222       v-temp-seq = v-seq - 1.
     8223       do v-ii = 0 to v-no-hist:
     8224         run create-gds-list-flt-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8225                                             , input-output v-temp-seq
     8226                                             , input v-ii
     8227                                             , input get-hist-mode(line-mode)
     8228                                             , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list-flt.gds-code, gds-list-flt.artic, gds-list-flt.prod-type, gds-list-flt.prod-code, gds-list-flt.gds-name)
     8229                                             , input tot-lns
     8230                                             , input '':U
     8231                                             , input '':U
     8232                                             , input ('goods':U + chr(3) + string(gds-list-flt.gds-code))
     8233                                             , input '':U
     8234                                             , input ?
     8235                                             ).
     8236       end.
     8237     end.
     8238   end.
     8239   else do:
     8240     v-temp-seq = v-seq - 1.
     8241     do v-ii = 0 to v-no-hist:
     8242       run create-gds-list-flt-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8243                                           , input-output  v-temp-seq
     8244                                           , input v-ii
     8245                                           , input get-hist-mode(line-mode)
     8246                                           , input '':U
     8247                                           , input tot-lns
     8248                                           , input rs-list-method
     8249                                           , input '':U
     8250                                           , input '':U
     8251                                           , input '':U
     8252                                           , input ?
     8253                                           ).
     8254     end.
     8255   end.
     8256   END PROCEDURE.
     8257   procedure list_inf-local:
     8258   define variable glog as logical no-undo .
     8259   for each tt-goods:
     8260     delete tt-goods.
     8261   end.
     8262   for each tt-clients:
     8263     delete tt-clients.
     8264   end.
     8265   for each gds-list-flt:
     8266   find ub.goods where ub.goods.artic     = gds-list-flt.artic     and
     8267                   ub.goods.prod-type = gds-list-flt.prod-type and
     8268                   ub.goods.prod-code = gds-list-flt.prod-code no-lock.
     8269       create tt-goods.
     8270       buffer-copy ub.goods to tt-goods.
     8271   end.
     8272   create tt-clients.
     8273   assign tt-clients.obj-type = p-curr-obj-type
     8274         tt-clients.obj-code = p-curr-obj-code.
     8275   define variable vss-include-info58 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8276   do:
     8277     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8278       (input  v-cntxt-db-num
     8279       ,input  v-cntxt-userid
     8280       ,input  0
     8281       ,input  'actn_reference_archive':U
     8282       ,input  'global':U
     8283       ,input  0
     8284       ,input  '':U
     8285       ,input  0
     8286       ,input  0
     8287       ,input  0
     8288       ,input  0
     8289       ,input  true
     8290       ,output glog
     8291       )  .
     8292   end.
     8293   if glog then run arc/gds_inf.w
     8294   (input  parparentproc
     8295   ,input  v-cntxt-obj-type
     8296   ,input  v-cntxt-obj-code ).
     8297   end procedure.
     8298   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8299   DEFINE VARIABLE var-stat-line as character no-undo .
     8300   CASE p-status-chr:
     8301     when 'все':U then do:
     8302       assign
     8303       var-stat-line = "(текущие и неактивные товары)"
     8304       .
     8305     end.
     8306     when 'текущие':U then do:
     8307       assign
     8308       var-stat-line = "(текущие товары)"
     8309       .
     8310     end.
     8311     when 'удаленные':U then do:
     8312       assign
     8313       var-stat-line = "(неактивные товары)"
     8314       .
     8315     end.
     8316   END CASE.
     8317   return var-stat-line .
     8318   END.
     8319   procedure proc-vc-rs-list-method :
     8320   define variable v-operation as integer no-undo .
     8321   define variable glog as logical no-undo .
     8322   define variable ii as integer no-undo .
     8323   define variable v-recs as integer no-undo .
     8324   define variable v-line as integer no-undo .
     8325   define variable v-item as character no-undo .
     8326   define variable v-tbl-name as character no-undo .
     8327   define variable v-bh as handle no-undo .
     8328   define variable v-tot-lns as integer no-undo .
     8329   define variable v-grp-rec as recid no-undo .
     8330   define variable v-ref-rec as recid no-undo .
     8331   define variable v-dopstr as character no-undo .
     8332   define variable v-input-output as character no-undo .
     8333   define variable v-doc-rec as recid no-undo .
     8334   define variable v-temp-seq as integer no-undo .
     8335   define variable v-message as character no-undo .
     8336   define variable grp-path as character no-undo .
     8337   define variable v-rid-list as character no-undo .
     8338   define variable v-uniq-key-rec as character no-undo .
     8339   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     8340   define buffer buf_clob-bind for ub.clob-bind.
     8341   do
     8342   on error undo, return error
     8343   :
     8344     v-no-hist = - 1.
     8345     if temp-list.fvalue = "single" then
     8346     run UI-on in this-procedure.
     8347     else do:
     8348       v-no-hist = 0.
     8349       case rs-list-method:
     8350         when "all" then do:
     8351           glog = yes.
     8352           message "Все товары из справочника товаров"
     8353           skip stat-line(rs-status)
     8354           view-as alert-box question buttons OK-Cancel update glog.
     8355           if not glog then do:
     8356             run UI-on in this-procedure.
     8357             return error .
     8358           end.
     8359           v-no-hist = 1.
     8360           run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8361                                               , input-output v-seq
     8362                                               , input 0
     8363                                               , input '':U
     8364                                               , input substitute('Все товары &1', stat-line(rs-status))
     8365                                               , input tot-lns
     8366                                               , input rs-list-method
     8367                                               , input rs-status
     8368                                               , input 'all':U
     8369                                               , input '':U
     8370                                               , input ?
     8371                                               ).
     8372         end.
     8373         when "gds-grp" or
     8374         when "goods" or
     8375         when "gds-obj":U or
     8376         when "gds-obj-fact":U or
     8377         when "gds-obj-free":U or
     8378         when "no-recipe-gds":U
     8379         then do:
     8380           if rs-list-method = "gds-grp" or rs-list-method = "no-recipe-gds" then do:
     8381             glog = yes.
     8382             message "1 или несколько групп товаров"
     8383             skip stat-line(rs-status)
     8384             view-as alert-box question buttons OK-Cancel update glog.
     8385             if not glog then do:
     8386               run UI-on in this-procedure.
     8387               return error.
     8388             end.
     8389             grp-list = "".
     8390             ref-list = "".
     8391             run ref/gds-grp.w (input parparentproc
     8392                           ,input "b-sel,b-mark"
     8393                           ,input p-curr-obj-type
     8394                           ,input p-curr-obj-code
     8395                           ,input-output grp-list).
     8396           end.
     8397           else do:
     8398             glog = yes.
     8399             message "1 или несколько произвольных товаров из справочника."
     8400             skip stat-line(rs-status)
     8401             view-as alert-box question buttons OK-Cancel update glog.
     8402             if not glog then do:
     8403               run UI-on in this-procedure.
     8404               return error.
     8405             end.
     8406             run ref/gds-ref.p ( parparentproc
     8407                             ,"b-sel,b-mark,b-add"
     8408                             ,?
     8409                             ,?
     8410                             ,(if rs-list-method = "goods"
     8411                               then 'все':U
     8412                               else (if rs-list-method = "gds-obj":U
     8413                                     then 'объект':U
     8414                                     else (if rs-list-method = "gds-obj-fact":U
     8415                                           then 'факт':U
     8416                                           else (if rs-list-method = "gds-obj-free":U
     8417                                                 then 'свободно':U
     8418                                                 else ?
     8419                                                 )
     8420                                           )
     8421                                     )
     8422                             )
     8423                             ,?
     8424                             ,?
     8425                             ,?
     8426                             ,?
     8427                             ,p-curr-obj-type
     8428                             ,p-curr-obj-code
     8429                             ,?
     8430                             , output ref-list).
     8431             grp-list = ?.
     8432           end.
     8433           if grp-list <> ? and
     8434           grp-list <> "" then do:
     8435             v-recs = num-entries (grp-list).
     8436             do num-rec = 0 to v-recs:
     8437               if v-recs = 1 then do:
     8438                 num-rec = 1 .
     8439               end.
     8440               if num-rec > 0 then do:
     8441                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8442                 find ub.gds-grp where recid (ub.gds-grp) = v-grp-rec no-lock.
     8443                 run grplib-get-full-name in this-procedure (ub.gds-grp.node-code, output grp-path).
     8444               end.
     8445               if v-recs = 1 then do:
     8446                 assign
     8447                 v-temp-seq = v-seq
     8448                 v-line     = 0
     8449                 dsp-rs = substitute("Группа : &1 &3", grp-path, stat-line(rs-status))
     8450                 v-item     = '':U
     8451                 v-tbl-name = 'gds-grp':U
     8452                 v-bh       = buffer ub.gds-grp:handle
     8453                 v-tot-lns = tot-lns
     8454                 .
     8455               end.
     8456               else do:
     8457                 if num-rec = 0 then do:
     8458                   assign
     8459                   v-temp-seq = v-seq
     8460                   v-line     = 0
     8461                   dsp-rs = substitute("Группы : &1", stat-line(rs-status))
     8462                   v-item     = '':U
     8463                   v-tbl-name = '':U
     8464                   v-bh       = ?
     8465                   v-tot-lns = tot-lns
     8466                   .
     8467                 end.
     8468                 else do:
     8469                   assign
     8470                   v-temp-seq = v-seq - 1
     8471                   v-line     = num-rec
     8472                   dsp-rs = substitute("&1", grp-path)
     8473                   v-item     = '':U
     8474                   v-tbl-name = 'gds-grp':U
     8475                   v-bh       = buffer ub.gds-grp:handle
     8476                   v-tot-lns = tot-lns + num-rec
     8477                   .
     8478                 end.
     8479               end.
     8480               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8481               run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8482                                                   , input-output v-temp-seq
     8483                                                   , input v-line
     8484                                                   , input '':U
     8485                                                   , input dsp-rs
     8486                                                   , input v-tot-lns
     8487                                                   , input rs-list-method
     8488                                                   , input rs-status
     8489                                                   , input v-item
     8490                                                   , input v-tbl-name
     8491                                                   , input v-bh
     8492                                                   ).
     8493               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8494             end.
     8495           end.
     8496           else if ref-list <> "" then do:
     8497             v-recs = num-entries (ref-list).
     8498             do num-rec = 0 to v-recs:
     8499               if v-recs = 1 then do:
     8500                 num-rec = 1 .
     8501               end.
     8502               if num-rec > 0 then do:
     8503                 v-ref-rec = integer (entry (num-rec, ref-list)).
     8504                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
