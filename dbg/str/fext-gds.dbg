    11261   PROCEDURE trig-dis-gds-rule :
    11262   define variable v-rid-list as character no-undo .
    11263   define variable v-pos-type as character no-undo .
    11264   define variable v-templ-rl-root as integer no-undo .
    11265   define variable v-time-templ-rl-root as integer no-undo .
    11266   define variable v-cfg-nonunique as character no-undo .
    11267   define variable v-nonunique as character no-undo .
    11268   define variable v-discnt-role as character no-undo .
    11269   define variable v-obj-type as character no-undo .
    11270   define variable v-obj-code as integer no-undo .
    11271   define variable r-b-code as integer no-undo .
    11272   define variable v-sts as integer no-undo .
    11273   define variable glog as logical no-undo .
    11274   define variable v-mode as character no-undo .
    11275   define variable v-item as character no-undo .
    11276   define variable v-rule-num as integer no-undo .
    11277   define variable dflt-cd as character no-undo .
    11278   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    11279   define buffer buf_dis-rule for ub.dis-rule.
    11280   if v-cntxt-obj-type = 'скл':U then do:
    11281     dflt-cd = '-':U.
    11282   end.
    11283   else do:
    11284   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11285   define variable v-param-type73 as character no-undo .
    11286   define variable v-value-date73 as date no-undo .
    11287   define variable v-value-decimal73 as decimal no-undo .
    11288   define variable v-value-integer73 as INTEGER no-undo .
    11289   define variable v-value-logical73 AS LOGICAL no-undo .
    11290   define variable v-tth73 as handle no-undo .
    11291   run adm/shattri.p (
    11292       input "get":U
    11293       ,input  v-cntxt-obj-type
    11294       ,input  v-cntxt-obj-code
    11295       ,input  'cd-sending':U
    11296       ,input  'dflt-cd':U
    11297       ,output dflt-cd
    11298       ,output v-value-date73
    11299       ,output v-value-decimal73
    11300       ,output v-value-integer73
    11301       ,output v-value-logical73
    11302       ,output v-param-type73
    11303       ,INPUT-OUTPUT table-handle v-tth73
    11304       )  .
    11305   delete object v-tth73 no-error.
    11306     assign
    11307     v-pos-type = dflt-cd + chr(44) + '-':U + chr(44) + 'bo':U.
    11308   end.
    11309   run ref/dis-pos.w ( INPUT parparentproc
    11310                       ,INPUT "b-sel":U
    11311                       ,INPUT (if rs-list-method = "dis-gds-rule"
    11312                              then "cd-type-list-without-template-pos"
    11313                              else "cd-type-list")
    11314                       ,INPUT 1
    11315                       ,INPUT 1
    11316                       ,INPUT 1
    11317                       ,input 'dis-gds-rule':U
    11318                       ,input '':U
    11319                       ,input ?
    11320                       ,INPUT v-pos-type
    11321                       ,input '':U
    11322                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
    11323   IF ERROR-STATUS:ERROR
    11324   OR v-rid-list = '':U THEN DO:
    11325     RETURN.
    11326   END.
    11327   FIND FIRST buf_dis-cfg-rule NO-LOCK where
    11328             recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
    11329   assign
    11330   v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
    11331   v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
    11332   V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
    11333   v-discnt-role = buf_dis-cfg-rule.discnt-role
    11334   .
    11335   if rs-list-method = "dis-gds-rule" then do:
    11336     message
    11337     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) skip
    11338     stat-line(rs-status)
    11339     view-as alert-box question buttons OK-Cancel update glog.
    11340   end.
    11341   else do:
    11342     message
    11343     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) "и определенным номером правила скидки" skip
    11344     stat-line(rs-status)
    11345     view-as alert-box question buttons OK-Cancel update glog.
    11346   end.
    11347   if not glog then do:
    11348     return error.
    11349   end.
    11350   if (buf_dis-cfg-rule.has-global +
    11351       buf_dis-cfg-rule.has-host +
    11352       buf_dis-cfg-rule.has-obj) > 1 then do:
    11353     define variable v-sel-vals as character no-undo .
    11354     define variable v-sel-labels as character no-undo .
    11355     define variable var-region as character no-undo .
    11356     assign
    11357     v-sel-vals = v-sel-vals +
    11358                   (if buf_dis-cfg-rule.has-global = 1
    11359                   then (fill(chr(32), 3)  + string(0) + chr(4) )
    11360                   else "":U)
    11361     v-sel-labels = v-sel-labels +
    11362                   (if buf_dis-cfg-rule.has-global  = 1
    11363                   then ("Глобально" + chr(4) )
    11364                   else "":U)
    11365     .
    11366     assign
    11367     v-sel-vals = v-sel-vals +
    11368                   (if buf_dis-cfg-rule.has-host = 1
    11369                   then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(4) )
    11370                   else "":U)
    11371     v-sel-labels = v-sel-labels +
    11372                   (if buf_dis-cfg-rule.has-host = 1
    11373                   then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(4) )
    11374                   else "":U)
    11375     .
    11376     assign
    11377     v-sel-vals = v-sel-vals +
    11378                   (if buf_dis-cfg-rule.has-obj = 1
    11379                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11380                   else "":U)
    11381     v-sel-labels = v-sel-labels +
    11382                   (if buf_dis-cfg-rule.has-obj = 1
    11383                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11384                   else "":U)
    11385     .
    11386     run gbl/d-list.w (
    11387                         input "b-sel":U
    11388                         ,input "Выберите область действия"
    11389                         ,input v-sel-vals
    11390                         ,input v-sel-labels
    11391                         ,input chr(4)
    11392                         ,input "":U
    11393                         ,output var-region) no-error.
    11394     if error-status:error then do:
    11395       return error.
    11396     end.
    11397     assign
    11398     v-obj-type = substring(var-region, 1, 3)
    11399     v-obj-code = integer(substring(var-region, 4))
    11400     v-sel-obj-type = v-obj-type
    11401     v-sel-obj-code = v-obj-code
    11402     .
    11403   end.
    11404   else do:
    11405     if buf_dis-cfg-rule.has-obj = 1 then do:
    11406   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11407   run userobjs_select-one in this-procedure
    11408     (input  parparentproc
    11409     ,input  v-cntxt-db-num
    11410     ,input  v-cntxt-userid
    11411     ,input  v-cntxt-host-code-obj
    11412     ,input  v-cntxt-obj-type
    11413     ,input  v-cntxt-obj-code
    11414     ,output v-user-select
    11415     ,output v-sel-obj-type
    11416     ,output v-sel-obj-code
    11417     )  .
    11418       if not v-user-select then do:
    11419         return error.
    11420       end.
    11421       assign
    11422       v-obj-type = v-sel-obj-type
    11423       v-obj-code = v-sel-obj-code
    11424       .
    11425     end.
    11426     if buf_dis-cfg-rule.has-host = 1 then do:
    11427       define variable v-host-code as integer no-undo .
    11428       assign
    11429       v-obj-type = 'орг':U
    11430       v-obj-code = v-cntxt-host-code-obj
    11431       .
    11432     end.
    11433     if buf_dis-cfg-rule.has-glob = 1 then do:
    11434       assign
    11435       v-obj-type = '':U
    11436       v-obj-code = 0
    11437       .
    11438     end.
    11439   end.
    11440   if rs-list-method = "dis-gds-rule" then do:
    11441     assign
    11442     dsp-rs = substitute("ВСЕ товары с установленным типом скидки &1 &2"
    11443                       , get-objregion(v-obj-type, v-obj-code), stat-line(rs-status))
    11444     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-discnt-role   .
    11445   end.
    11446   else do:
    11447     v-mode = (if v-obj-type = 'маг':U
    11448               or v-obj-type = 'скл':U
    11449               then "upper-rule-num-object":u
    11450               else ('dis-gds-rule':U + "=" + v-discnt-role)).
    11451     run ref/dis-ruls.w (
    11452                  input parparentproc
    11453                 ,input 0
    11454                 ,input v-obj-type
    11455                 ,input v-obj-code
    11456                 ,input "b-add,b-sel":U
    11457                 ,input v-mode
    11458                 ,input v-templ-rl-root
    11459                 ,input v-time-templ-rl-root
    11460                 ,input r-b-code
    11461                 ,input-output v-sts
    11462                 ,input-output v-rid-list ) no-error .
    11463     if v-rid-list = '':u then do:
    11464       return error.
    11465     end.
    11466     find first buf_dis-rule no-lock where
    11467              recid(buf_dis-rule) = integer(v-rid-list) no-error.
    11468     if available buf_dis-rule then do:
    11469     assign
    11470     dsp-rs = substitute("ВСЕ товары с установленным типом скидки: &1, № правила &2 &3"
    11471                         ,get-objregion(v-obj-type, v-obj-code)
    11472                         ,v-rule-num
    11473                         ,stat-line(rs-status))
    11474     v-item = v-sel-obj-type + chr(3) +
    11475               string(v-sel-obj-code) + chr(3) +
    11476                 v-discnt-role + chr(3) + string(buf_dis-rule.rule-num)
    11477     .
    11478   end.
    11479     else do:
    11480       message
    11481       substitute("Не найдено провило скидки с recid &1", v-rid-list)
    11482       view-as alert-box error .
    11483       return error.
    11484     end.
    11485   end.
    11486   v-no-hist = 0.
    11487   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11488                                       , input-output v-seq
    11489                                       , input 0
    11490                                       , input '':U
    11491                                       , input dsp-rs
    11492                                       , input tot-lns
    11493                                       , input rs-list-method
    11494                                       , input rs-status
    11495                                       , input v-item
    11496                                       , input '':U
    11497                                       , input ?
    11498                                       ).
    11499   END PROCEDURE.
    11500   procedure proc-scn-tsd :
    11501   define variable glog as logical no-undo .
    11502   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    11503     do
    11504     on error undo, return error
    11505     :
    11506     run str/diallog.w (parparentproc
    11507                 , this-procedure
    11508                 , 'str/rsendtsd.p':U
    11509                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code))
    11510                 , no
    11511                 , '':U
    11512                 , 'Пересылка товаров на ТСД') no-error .
    11513     end.
    11514   end procedure.
    11515   procedure proc-macros :
    11516   define variable glog as logical no-undo .
    11517   define variable v-option as integer no-undo .
    11518   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    11519   define buffer buf_macro-list-hist for macro-list-hist.
    11520   if can-find(first macro-list-hist) then do:
    11521     run gbl/d-askw.w ( input "Сохранение макроса"
    11522                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    11523                   ,input "|"
    11524                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    11525                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    11526                   ,input 1
    11527                   ,input 3
    11528                   ,output v-option).
    11529     if v-option = 3 then return no-apply.
    11530     v-option = 1.
    11531   end.
    11532   else do:
    11533     message
    11534     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    11535     view-as alert-box question buttons yes-no update glog.
    11536     v-option = 2.
    11537     if not glog then do:
    11538       return no-apply.
    11539     end.
    11540   end.
    11541     do
    11542     on error undo, return error
    11543     :
    11544     assign
    11545       f-name = "default.gdm"
    11546       glog = yes
    11547       .
    11548     system-dialog get-file f-name
    11549       filters "Макрос создания списка товара *.gdm" "*.gdm"
    11550       ask-overwrite
    11551       save-as
    11552       use-filename
    11553       update glog
    11554       default-extension "gdm".
    11555     if not glog then do:
    11556       apply "entry" to br-list in frame Dialog-Frame.
    11557       return no-apply.
    11558     end.
    11559     run waitfram-show in this-procedure ("Сохранение макроса формирования списка товара.    ЖДИТЕ...").
    11560     output stream PrnLibStream to value (f-name).
    11561     case v-option:
    11562       when 1 then do:
    11563         for each buf_macro-list-hist:
    11564           export stream PrnLibStream
    11565           buf_macro-list-hist.
    11566         end.
    11567       end.
    11568       when 2 then do:
    11569     for each buf_gds-list-flt-hist:
    11570         export stream PrnLibStream
    11571         buf_gds-list-flt-hist.
    11572     end.
    11573       end.
    11574     end case.
    11575     output stream PrnLibStream close.
    11576     run waitfram-hide in this-procedure .
    11577     end.
    11578   end procedure.
    11579   PROCEDURE trig-tax-rate-value :
    11580   define input parameter p-rs-list-method as character no-undo .
    11581   define output parameter p-date as date no-undo .
    11582   DEFINE VARIABLE v-codes          as character           no-undo.
    11583   DEFINE VARIABLE v-labels         as character           no-undo.
    11584   DEFINE VARIABLE v-type           as character           no-undo.
    11585   DEFINE VARIABLE v-format         as character           no-undo.
    11586   DEFINE VARIABLE v-values         as character           no-undo.
    11587   DEFINE VARIABLE v-code-output    as character           no-undo.
    11588   DEFINE VARIABLE v-value-output   as character           no-undo.
    11589   define variable vlabel           as character           no-undo .
    11590   define variable v-date-chr       as character           no-undo .
    11591   DEFINE VARIABLE v-time           as integer             no-undo .
    11592   DEFINE VARIABLE v-ref-list           as character           no-undo .
    11593   DEFINE VARIABLE jj                   as integer             no-undo .
    11594   define variable glog as logical no-undo .
    11595   assign
    11596   v-attr-code = ""
    11597   vvalue = ""
    11598   v-codes = '1':U + chr(4) + '2':U
    11599   v-labels = "НДС" + chr(4) +  "НП"
    11600   v-values = "0" + chr(4) + "0"
    11601   v-format = ">9.99":U + chr(4) + ">9.99":U
    11602   v-type = 'D':U + chr(4) + 'D':U
    11603   .
    11604   run gbl/d-listv.w (
    11605                  "b-mark,b-sel":U
    11606                 ,"Выберите налоги"
    11607                 , v-codes
    11608                 , v-labels
    11609                 , v-values
    11610                 , v-format
    11611                 , v-type
    11612                 , chr(4)
    11613                 , "":U
    11614                 , output v-attr-code
    11615                 , output vvalue
    11616                 ).
    11617   if v-attr-code = "" then do:
    11618     return error.
    11619   end.
    11620   do jj = 1 to num-entries(v-attr-code, chr(4)):
    11621     assign
    11622     vlabel = vlabel + entry(LOOKUP(entry(jj, v-attr-code, chr(4)), v-codes, chr(4)), v-labels, chr(4)) + "=":U + entry(jj, vvalue, chr(4)) + chr(10)
    11623     .
    11624   end.
    11625   run cur-time in this-procedure(output p-date, output v-time).
    11626   assign
    11627   v-date-chr = string(p-date, "99/99/9999":U)
    11628   .
    11629   run gbl/d-prompt.w (
    11630     'title=':u + "Введите дату значения налогов" + '\':u
    11631   + 'text1=':u + "Дата" + '\':u
    11632   + 'format=' + "99/99/9999" + '\':u
    11633   + 'type=' + 'T':U + '\':u
    11634   + 'fillin_row=2\':u
    11635   + 'fillin_col=4\':u
    11636   + 'fillin_width=20\':u
    11637   + 'fillin_height=1\':u
    11638   + 'max-chars=70\':u
    11639   + 'readonly=no' + '\':u
    11640   , input-output v-date-chr
    11641   ).
    11642   if return-value = 'false':u then return error.
    11643   assign
    11644   p-date = date( integer(substr(v-date-chr, 4, 2))
    11645                 ,integer(substr(v-date-chr, 1, 2))
    11646                 ,integer(substr(v-date-chr, 7, 4))
    11647                )
    11648   no-error .
    11649   if error-status:error then return error.
    11650   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11651   run userobjs_select-one in this-procedure
    11652     (input  parparentproc
    11653     ,input  v-cntxt-db-num
    11654     ,input  v-cntxt-userid
    11655     ,input  v-cntxt-host-code-obj
    11656     ,input  v-cntxt-obj-type
    11657     ,input  v-cntxt-obj-code
    11658     ,output v-user-select
    11659     ,output v-sel-obj-type
    11660     ,output v-sel-obj-code
    11661     )  .
    11662   if not v-user-select then do:
    11663     return error.
    11664   end.
    11665   glog = yes.
    11666   if p-rs-list-method = "tax-rate-value":U then do:
    11667     message
    11668     "Все товары с заданными значениями налогов на объекте на дату" v-date-chr skip
    11669     vlabel skip
    11670     stat-line(rs-status)
    11671     view-as alert-box question buttons OK-Cancel update glog.
    11672   end.
    11673   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11674     message
    11675     "Товары объекта с заданными значениями налогов на объекте на дату" v-date-chr skip
    11676     vlabel skip
    11677     stat-line(rs-status)
    11678     view-as alert-box question buttons OK-Cancel update glog.
    11679   end.
    11680   if not glog then do:
    11681     return error.
    11682   end.
    11683   if p-rs-list-method = "tax-rate-value":U then do:
    11684     dsp-rs = substitute("ВСЕ товары с заданными значениями налогов на объекте &1 на дату &2 &3", vlabel, p-date, stat-line(rs-status)).
    11685   end.
    11686   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11687     dsp-rs = substitute("Товары объекта &1 с заданными значениями налогов на объекте &2 на дату &3 &4", vlabel, vlabel, p-date, stat-line(rs-status)).
    11688   end.
    11689   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11690                                       , input-output v-seq
    11691                                       , input 0
    11692                                       , input '':U
    11693                                       , input dsp-rs
    11694                                       , input tot-lns
    11695                                       , input rs-list-method
    11696                                       , input rs-status
    11697                                       , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) +
    11698                                               string(p-date, "99/99/9999") + chr(3) + v-attr-code + chr(3) + vvalue
    11699                                       , input '':U
    11700                                       , input ?
    11701                                       ).
    11702   END PROCEDURE.
    11703   procedure proc-b-add :
    11704   define input parameter p-from-macro as logical no-undo .
    11705   define input parameter p-rowid as rowid no-undo .
    11706   define input parameter rs-list-method as character no-undo .
    11707   define input parameter rs-status as character no-undo .
    11708     do
    11709     on error undo, return error
    11710     :
    11711     line-mode = 'ДОБАВЛЕНИЕ':U.
    11712     if rs-list-method = "single" then do:
    11713        v-no-hist = - 1.
    11714       if p-from-macro then do:
    11715         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
    11716       end.
    11717       else do:
    11718         run ref/gds-ref.p ( parparentproc
    11719                         ,"b-sel,b-add"
    11720                         ,?
    11721                         ,?
    11722                         ,?
    11723                         ,?
    11724                         ,?
    11725                         ,?
    11726                         ,?
    11727                         ,p-curr-obj-type
    11728                         ,p-curr-obj-code
    11729                         ,?
    11730                         , output ref-list).
    11731         apply "entry" to br-list in frame Dialog-Frame.
    11732         if ref-list = "" then
    11733           return no-apply.
    11734         find ub.goods where recid (ub.goods) = integer (ref-list) no-lock.
    11735       end.
    11736       if available goods then do:
    11737         run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    11738         tot-lns = tot-lns + 1.
    11739         run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11740       end.
    11741       else do:
    11742         return error "Нет в БД такого товара".
    11743       end.
    11744       run UI-on  in this-procedure.
    11745     end.
    11746     else
    11747       run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11748     end.
    11749   end procedure.
    11750   procedure proc-b-del :
    11751   define input parameter p-from-macro as logical no-undo .
    11752   define input parameter p-rowid as rowid no-undo .
    11753   define input parameter rs-list-method as character no-undo .
    11754   define input parameter rs-status as character no-undo .
    11755   define variable v-rep-rec as recid no-undo .
    11756   define variable glog as logical no-undo .
    11757     do
    11758     on error undo, return error
    11759     :
    11760       line-mode = 'удаление':U.
    11761       if rs-list-method = "single" then do:
    11762         v-no-hist = - 1.
    11763         if p-from-macro then do:
    11764           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11765           if not available ub.goods then return error "Нет в БД такого товара".
    11766           find first gds-list-flt where gds-list-flt.gds-code = ub.goods.gds-code no-error.
    11767         end.
    11768         if available gds-list-flt then do:
    11769           line-rec = recid (gds-list-flt).
    11770           get next br-list.
    11771           if available gds-list-flt then v-rep-rec = recid (gds-list-flt).
    11772           else do:
    11773             reposition br-list to recid line-rec no-error.
    11774             get prev br-list.
    11775             if available gds-list-flt then v-rep-rec = recid (gds-list-flt).
    11776           end.
    11777           reposition br-list to recid line-rec no-error.
    11778           tot-lns = tot-lns - 1.
    11779           run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11780           delete gds-list-flt.
    11781           line-rec = v-rep-rec.
    11782           run UI-on in this-procedure.
    11783         end.
    11784         else do:
    11785           return error "Нет в списке товаров такого товара".
    11786         end.
    11787       end.
    11788       else do:
    11789         glog = no.
    11790         message "Удалить товары ПО заданному УСЛОВИЮ ?   Вы уверены ?"
    11791         view-as alert-box question buttons OK-Cancel update glog.
    11792         if not glog then
    11793           return no-apply.
    11794         run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11795       end.
    11796     end.
    11797   end procedure.
    11798   procedure proc-b-rest :
    11799   define input parameter p-from-macro as logical no-undo .
    11800   define input parameter p-rowid as rowid no-undo .
    11801   define input parameter rs-list-method as character no-undo .
    11802   define input parameter rs-status as character no-undo .
    11803   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    11804   define variable glog as logical no-undo .
    11805     do
    11806     on error undo, return error
    11807     :
    11808       line-mode = 'ОСТАВИТЬ':U.
    11809       if rs-list-method = "single" then do:
    11810         v-no-hist = - 1.
    11811         if p-from-macro then do:
    11812           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11813           if not available ub.goods then return error substitute("Нет в БД такого товара").
    11814           find first gds-list-flt where gds-list-flt.gds-code = ub.goods.gds-code no-error.
    11815         end.
    11816         if available gds-list-flt then do:
    11817           if p-from-macro then do:
    11818             glog = yes.
    11819           end.
    11820           else do:
    11821             glog = no.
    11822             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11823             view-as alert-box question buttons OK-Cancel update glog.
    11824             if not glog then return error.
    11825           end.
    11826           line-rec = recid (gds-list-flt).
    11827           v-seq = 1.
    11828           for each buf_gds-list-flt-hist:
    11829             delete buf_gds-list-flt-hist.
    11830           end.
    11831           run write-hist  in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11832           for each gds-list-flt:
    11833             if line-rec <> recid (gds-list-flt) then delete gds-list-flt.
    11834           end.
    11835           assign
    11836           tot-lns = 1
    11837           .
    11838           run UI-on  in this-procedure.
    11839         end.
    11840         else do:
    11841           return error substitute("Нет в списке такого товара").
    11842         end.
    11843       end.
    11844       else do:
    11845         glog = no.
    11846         if not p-from-macro then do:
    11847           message "Оставить товары ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11848           view-as alert-box question buttons OK-Cancel update glog.
    11849           if not glog then
    11850             return no-apply.
    11851         end.
    11852         assign
    11853         lns-cnt = 0
    11854         lns-ignore = 0
    11855         .
    11856         run rs-do  in this-procedure ( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11857         for each gds-list-flt:
    11858           if gds-list-flt.to-del = ? then do:
    11859             assign
    11860             gds-list-flt.to-del = no
    11861             .
    11862           end.
    11863           else do:
    11864             delete gds-list-flt.
    11865           end.
    11866         end.
    11867         tot-lns = lns-cnt.
    11868         run UI-on  in this-procedure.
    11869         message
    11870         "Оставлено строк :" lns-cnt skip(0)
    11871         string(if lns-ignore <> 0
    11872         then ("Проигнорировано строк :" + string(lns-ignore))
    11873         else "":U)
    11874         .
    11875       end.
    11876     end.
    11877   end procedure.
    11878   procedure proc-b-obj :
    11879     define input parameter p-mode as character no-undo .
    11880     define buffer buf_clients  for ub.clients.
    11881     do
    11882     on error undo, return error
    11883     :
    11884       if p-mode = "change":U then do:
    11885   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11886   run userobjs_select-one in this-procedure
    11887     (input  parparentproc
    11888     ,input  v-cntxt-db-num
    11889     ,input  v-cntxt-userid
    11890     ,input  v-cntxt-host-code-obj
    11891     ,input  v-cntxt-obj-type
    11892     ,input  v-cntxt-obj-code
    11893     ,output v-user-select
    11894     ,output v-sel-obj-type
    11895     ,output v-sel-obj-code
    11896     )  .
    11897       end.
    11898       if v-user-select then do:
    11899         find first buf_clients no-lock where
    11900                    buf_clients.obj-type = v-sel-obj-type
    11901                and buf_clients.obj-code = v-sel-obj-code no-error.
    11902         if not available buf_clients then do: return error. end.
    11903         assign
    11904           p-curr-obj-type = buf_clients.obj-type
    11905           p-curr-obj-code = buf_clients.obj-code
    11906           p-curr-host-code = buf_clients.host-code
    11907           v-obj-type = buf_clients.obj-type
    11908           v-obj-code = buf_clients.obj-code
    11909           v-obj-name = buf_clients.obj-name
    11910         .
    11911         if lookup(bttns, "hide") = 0 then do:
    11912           display
    11913           v-obj-name
    11914           v-obj-type
    11915           v-obj-code
    11916           with frame Dialog-Frame.
    11917         end.
    11918       end.
    11919     end.
    11920   end procedure.
    11921   procedure proc-file-list-methods :
    11922   define input parameter p-from-macro as logical no-undo .
    11923   define input parameter rs-list-method as character no-undo .
    11924   define input parameter rs-status as character no-undo .
    11925   define input parameter line-mode as character no-undo .
    11926   define input parameter p-id      as integer no-undo .
    11927   define variable ss as character no-undo .
    11928   define variable b-c as integer no-undo.
    11929   define variable imp-type like ub.goods.prod-type no-undo.
    11930   define variable imp-code like ub.goods.prod-code no-undo.
    11931   define variable imp-art like ub.goods.artic no-undo.
    11932   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
    11933   define variable imp-doc-type as character no-undo.
    11934   define variable scan-qnty as dec no-undo.
    11935   define variable bc-qnty as dec no-undo.
    11936   define variable varresult   as character         no-undo.
    11937   define variable vartype-bc  as character         no-undo.
    11938   define variable varweight   as decimal           no-undo.
    11939   define variable v-full-path        as character no-undo .
    11940   define variable v-path             as character no-undo .
    11941   define variable v-file-name        as character no-undo .
    11942   define variable v-file-name-no-ext as character no-undo .
    11943   define variable v-file-name-ext    as character no-undo .
    11944   define variable v-num-add          as integer no-undo .
    11945   define variable v-num-ignored      as integer no-undo .
    11946   define variable v-tbl-row          as rowid no-undo .
    11947   define variable v-tbl-name         as character no-undo .
    11948   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    11949   define buffer buf_clob-data for ub.clob-data.
    11950   define buffer buf_clob-bind for ub.clob-bind.
    11951   do
    11952   on error undo, return error
    11953   :
    11954   find first buf_gds-list-flt-hist where
    11955             buf_gds-list-flt-hist.id = p-id
    11956         AND buf_gds-list-flt-hist.item_ <> '':U .
    11957   if rs-list-method = "clob-data" then do:
    11958     run gen-row-keyr in this-procedure (
    11959      input  buf_gds-list-flt-hist.item_
    11960     ,input  ?
    11961     ,input  "ub"
    11962     ,input  ?
    11963     ,input NO-LOCK
    11964     ,output v-tbl-row
    11965     ,output v-tbl-name  ) no-error.
    11966     if error-status :error then do:
    11967       message
    11968       "Ошибка при поиске хранимого файла"
    11969       view-as alert-box error.
    11970       return error.
    11971     end.
    11972     find first buf_clob-bind no-lock where
    11973               rowid(buf_clob-bind) = v-tbl-row .
    11974     find first buf_clob-data no-lock where
    11975               buf_clob-data.db-num = buf_clob-bind.db-num
    11976           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
    11977     if error-status :error then do:
    11978       message
    11979       "Ошибка при пополучении хранимого файла"
    11980       view-as alert-box error.
    11981       return error.
    11982     end.
    11983     run gbl/_tmpfile.p ( input ""
    11984                   ,input "tmp"
    11985                   ,output v-file-name) .
    11986     copy-lob from object buf_clob-data.cdata
    11987     to file v-file-name.
    11988   end.
    11989   run gbl/filename.p
    11990       (input  (if rs-list-method = "clob-data" then v-file-name else buf_gds-list-flt-hist.item_  )
    11991     ,output v-full-path
    11992     ,output v-path
    11993     ,output v-file-name
    11994     ,output v-file-name-no-ext
    11995     ,output v-file-name-ext
    11996     ) no-error .
    11997     if error-status:error then do: end. else do:
    11998     input stream sout from value (v-full-path).
    11999     CASE rs-list-method:
    12000       when "doc-list" then do:
    12001         repeat:
    12002           import stream sout imp-doc-code imp-doc-type no-error.
    12003           if imp-doc-type = 'переоценка':U then do:
    12004             find first ub.price-doc No-LOCK WHERE
    12005                       ub.price-doc.doc-num = imp-doc-code No-ERROR.
    12006             if avail(ub.price-doc) then do:
    12007               FOR EACH ub.price-list No-LOCK WHERE
    12008                       ub.price-list.doc-num = ub.price-doc.doc-num,
    12009                   FIRST ub.goods No-LOCK WHERE
    12010                         ub.goods.artic = ub.price-list.artic AND
    12011                         ub.goods.prod-type = ub.price-list.prod-type AND
    12012                         ub.goods.prod-code = ub.price-list.prod-code:
    12013                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12014                 if available gds-list-flt and
    12015                   gds-list-flt.artic = ub.goods.artic and
    12016                   gds-list-flt.prod-type = ub.goods.prod-type and
    12017                   gds-list-flt.prod-code = ub.goods.prod-code then
    12018                   gds-list-flt.qnty = scan-qnty.
    12019               END.
    12020             end.
    12021           end.
    12022           else do:
    12023             find first ub.trn-doc NO-LOCK where
    12024                       ub.trn-doc.doc-code = imp-doc-code No-ERROR.
    12025             if avail(ub.trn-doc) then do:
    12026               FOR EACH ub.doc-line NO-LOCK where
    12027                       ub.doc-line.doc-code = ub.trn-doc.doc-code,
    12028                   FIRST ub.goods where ub.goods.artic = ub.doc-line.artic
    12029                               and ub.goods.prod-type = ub.doc-line.prod-type
    12030                               and ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK:
    12031                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12032                 if available gds-list-flt and
    12033                   gds-list-flt.artic = ub.goods.artic and
    12034                   gds-list-flt.prod-type = ub.goods.prod-type and
    12035                   gds-list-flt.prod-code = ub.goods.prod-code then
    12036                   gds-list-flt.qnty = scan-qnty.
    12037               end.
    12038             end.
    12039           end.
    12040         end.
    12041       end.
    12042       when "prod-list" then do:
    12043         repeat:
    12044           import stream sout imp-type imp-code no-error.
    12045           for each ub.goods where ub.goods.prod-type = imp-type
    12046                       and ub.goods.prod-code = imp-code no-lock:
    12047             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12048           end.
    12049         end.
    12050       end.
    12051       when "supp-list" then do:
    12052         repeat:
    12053           import stream sout imp-type imp-code no-error.
    12054           for each ub.cli-gds where ub.cli-gds.cli-type = imp-type
    12055                               and ub.cli-gds.cli-code = imp-code
    12056                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
    12057                 first ub.goods where ub.goods.artic = ub.cli-gds.artic
    12058                             and ub.goods.prod-type = ub.cli-gds.prod-type
    12059                             and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
    12060             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12061           end.
    12062         end.
    12063       end.
    12064       when "cli-list" then do:
    12065         input stream sout from value (f-cli-name).
    12066         repeat:
    12067           import stream sout imp-type imp-code no-error.
    12068           for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
    12069                             and ub.trn-doc.cli-code = imp-code no-lock:
    12070             for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
    12071                 first ub.goods where ub.goods.artic = ub.doc-line.artic
    12072                               and ub.goods.prod-type = ub.doc-line.prod-type
    12073                               and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
    12074               run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12075             end.
    12076           end.
    12077         end.
    12078       end.
    12079       when "file"
    12080       or when "clob-data"
    12081       then do:
    12082         repeat:
    12083           import stream sout imp-type imp-code imp-art scan-qnty no-error.
    12084           find ub.goods where ub.goods.prod-type = imp-type
    12085                       and ub.goods.prod-code = imp-code
    12086                       and ub.goods.artic     = imp-art no-lock no-error.
    12087           if available ub.goods then run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12088           if available ub.goods and  available gds-list-flt and
    12089             gds-list-flt.artic = ub.goods.artic and
    12090             gds-list-flt.prod-type = ub.goods.prod-type and
    12091             gds-list-flt.prod-code = ub.goods.prod-code then
    12092             gds-list-flt.qnty = scan-qnty.
    12093         end.
    12094         if rs-list-method = "clob-data" then do:
    12095           os-delete value(v-full-path) .
    12096         end.
    12097       end.
    12098       when "scaner" then do:
    12099         repeat:
    12100           import stream sout unformatted ss.
    12101           ss = trim (ss).
    12102           if ss = "" then next.
    12103           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
    12104             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
    12105             else next.
    12106           assign
    12107             scan-qnty = dec (entry (2, ss))
    12108             ss = trim (entry (1, ss)).
    12109   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12110   (
    12111    input  parparentproc
    12112   ,input  ss
    12113   ,input  ?
    12114   ,input  p-curr-obj-type
    12115   ,input  p-curr-obj-code
    12116   ,input  yes
    12117   ,input  no
    12118   ,input  varscales-pref
    12119   ,input  varpgscales-pref
    12120   ,output varresult
    12121   ,output vartype-bc
    12122   ,output varweight
    12123   ,buffer ub.bar-code
    12124   ,buffer ub.prod-bc
    12125   ,buffer ub.place
    12126   ) no-error.
    12127           if not available ub.bar-code then next.
    12128           bc-qnty = ub.bar-code.cli-base-rate.
    12129           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
    12130           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12131           if available gds-list-flt and
    12132             gds-list-flt.artic = ub.goods.artic and
    12133             gds-list-flt.prod-type = ub.goods.prod-type and
    12134             gds-list-flt.prod-code = ub.goods.prod-code then
    12135             gds-list-flt.qnty = gds-list-flt.qnty + scan-qnty * bc-qnty.
    12136         end.
    12137       end.
    12138     END CASE.
    12139     input stream sout close.
    12140     assign                                                           buf_gds-list-flt-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-flt-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-flt-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-flt-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
    12141     end.
    12142   end.
    12143   end procedure.
    12144   procedure analysis:
    12145   define input  parameter p-method as character no-undo .
    12146   define variable glog as logical   no-undo .
    12147   define variable v-run as character no-undo .
    12148   define variable an-option as character no-undo .
    12149   define variable v-tbl-name as character no-undo .
    12150   define variable v-bh as handle no-undo .
    12151   define variable v-recs as integer   no-undo .
    12152   define variable v-temp-seq as integer   no-undo .
    12153   define variable v-line as integer   no-undo .
    12154   define variable v-item as character no-undo .
    12155   define variable v-tot-lns as integer   no-undo .
    12156   do
    12157   on error undo, return error return-value
    12158   :
    12159     glog = yes.
    12160     CASE p-method:
    12161       when "abcxyz":U then do:
    12162         assign
    12163         dsp-rs = substitute("Товары ABC/XYZ анализа.&1&2",  stat-line(rs-status))
    12164         v-run = 'ref/abcxyzv.w':U
    12165         an-option = "abcxyz"
    12166         v-tbl-name = 'abcxyz-analysis':U
    12167         v-bh       = buffer ub.abcxyz-analysis:handle
    12168         .
    12169       end.
    12170       when "abc-analysis":U then do:
    12171         assign
    12172         dsp-rs = substitute("Товары ABC анализа.&1&2",  stat-line(rs-status))
    12173         v-run = 'ref/abcanal.w':U
    12174         an-option = "abc"
    12175         v-tbl-name = 'abc-analysis':U
    12176         v-bh       = buffer ub.abc-analysis:Handle
    12177         .
    12178       end.
    12179       when "xyz-analysis":U then do:
    12180         assign
    12181         dsp-rs = substitute("Товары XYZ анализа.&1&2",  stat-line(rs-status))
    12182         v-run = 'ref/xyzanal.w':U
    12183         an-option = "xyz"
    12184         v-tbl-name = 'xyz-analysis':U
    12185         v-bh       = buffer ub.xyz-analysis:Handle
    12186         .
    12187       end.
    12188     END CASE.
    12189     message
    12190     dsp-rs
    12191     view-as alert-box question buttons OK-Cancel update glog.
    12192     if not glog then do:
    12193       run UI-on  in this-procedure.
    12194       return error.
    12195     end.
    12196     run value(v-run)(parparentproc,"b-sel":U, output ref-list).
    12197     if ref-list <> "" then run ref/togabc.w (input an-option, output list-abcxyz).
    12198     if ref-list = "" or list-abcxyz = "" then do:
    12199       run UI-on in this-procedure.
    12200       return error.
    12201     end.
    12202     if num-entries(ref-list) = 1 then do:
    12203       CASE rs-list-method:
    12204         when "abcxyz":U then do:
    12205           find abcxyz-analysis where recid (abcxyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12206           dsp-rs = substitute("ABCXYZ Анализ : &1&2&3"
    12207                               ,abcxyz-analysis.abcx-name
    12208                               , chr(10)
    12209                               , stat-line(rs-status)
    12210                               ).
    12211         end.
    12212         when "abc-analysis":U then do:
    12213           find abc-analysis where recid (abc-analysis) = integer(entry(1, ref-list)) no-lock.
    12214           dsp-rs = substitute("ABC Анализ : &1&2&3"
    12215                               ,abc-analysis.abc-name
    12216                               , chr(10)
    12217                               , stat-line(rs-status)
    12218                               ).
    12219         end.
    12220         when "xyz-analysis":U then do:
    12221           find xyz-analysis where recid (xyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12222           dsp-rs = substitute("XYZ Анализ : &1&2&3"
    12223                               ,xyz-analysis.xyz-name
    12224                               ,chr(10)
    12225                               ,stat-line(rs-status)
    12226                               ).
    12227         end.
    12228       end CASE.
    12229       v-recs = num-entries(list-abcxyz).
    12230       do num-rec = 0 to v-recs:
    12231         if num-rec = 0 then do:
    12232           assign
    12233           v-temp-seq = v-seq
    12234           v-line     = 0
    12235           v-item     = '':U
    12236           v-tot-lns = tot-lns
    12237           .
    12238         end.
    12239         else do:
    12240           assign
    12241           v-temp-seq = v-seq - 1
    12242           v-line     = num-rec
    12243           dsp-rs = substitute("Группа &1", entry(num-rec, list-abcxyz))
    12244           v-item     = entry(num-rec, list-abcxyz)
    12245           v-tbl-name = '':U
    12246           v-bh       = ?
    12247           v-tot-lns = tot-lns + num-rec
    12248           .
    12249         end.
    12250         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12251         run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12252                                             , input-output v-temp-seq
    12253                                             , input v-line
    12254                                             , input '':U
    12255                                             , input dsp-rs
    12256                                             , input v-tot-lns
    12257                                             , input rs-list-method
    12258                                             , input rs-status
    12259                                             , input v-item
    12260                                             , input v-tbl-name
    12261                                             , input v-bh
    12262                                             ).
    12263         if num-rec = 0 then v-seq  = v-temp-seq.
    12264       end.
    12265     end.
    12266   end.
    12267   end procedure.
    12268   procedure collection :
    12269   define input  parameter p-method as character no-undo .
    12270   define variable glog as logical   no-undo .
    12271   define variable v-run as character no-undo .
    12272   define variable an-option as character no-undo .
    12273   define variable v-tbl-name as character no-undo .
    12274   define variable v-bh as handle no-undo .
    12275   define variable v-recs as integer   no-undo .
    12276   define variable v-temp-seq as integer   no-undo .
    12277   define variable v-line as integer   no-undo .
    12278   define variable v-item as character no-undo .
    12279   define variable v-tot-lns as integer   no-undo .
    12280   do
    12281   on error undo, return error return-value
    12282   :
    12283     glog = yes.
    12284     CASE p-method:
    12285       when "collection":U then do:
    12286         assign
    12287         dsp-rs = substitute("Товары по коллекции.&1&2",  stat-line(rs-status))
    12288         v-run = 'ref/collec.w':U
    12289         an-option = "sea"
    12290         v-tbl-name = 'season'
    12291         v-bh       = buffer ub.season:Handle
    12292         .
    12293       end.
    12294     END CASE.
    12295     message
    12296     dsp-rs
    12297     view-as alert-box question buttons OK-Cancel update glog.
    12298     if not glog then do:
    12299       run UI-on.
    12300       return error.
    12301     end.
    12302     run value(v-run) (parParentProc, "b-sel":U, output ref-list).
    12303     if ref-list = "" then do:
    12304       run UI-on.
    12305       return error.
    12306     end.
    12307     if num-entries(ref-list) = 1 then do:
    12308       CASE rs-list-method:
    12309         when "collection":U then do:
    12310           find ub.season where recid (ub.season) = integer(entry(1, ref-list)) no-lock.
    12311           dsp-rs = substitute("Коллекция : &1&2&3"
    12312                               ,ub.season.sea-name
    12313                               , chr(10)
    12314                               , stat-line(rs-status)
    12315                               ).
    12316         end.
    12317       end CASE.
    12318       v-recs = num-entries(ref-list).
    12319       do num-rec = 0 to v-recs:
    12320         if num-rec = 0 then do:
    12321           assign
    12322           v-temp-seq = v-seq
    12323           v-line     = 0
    12324           v-item     = '':U
    12325           v-tot-lns = tot-lns
    12326           .
    12327         end.
    12328         else do:
    12329           assign
    12330           v-temp-seq = v-seq - 1
    12331           v-line     = num-rec
    12332           v-item     = entry(num-rec, ref-list)
    12333           v-tbl-name = '':U
    12334           v-bh       = ?
    12335           v-tot-lns = tot-lns + num-rec
    12336           .
    12337         end.
    12338         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12339         run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12340                                             , input-output v-temp-seq
    12341                                             , input v-line
    12342                                             , input '':U
    12343                                             , input dsp-rs
    12344                                             , input v-tot-lns
    12345                                             , input rs-list-method
    12346                                             , input rs-status
    12347                                             , input v-item
    12348                                             , input v-tbl-name
    12349                                             , input v-bh
    12350                                             ).
    12351         if num-rec = 0 then v-seq  = v-temp-seq.
    12352       end.
    12353     end.
    12354   end.
    12355   end procedure.
    12356   procedure object-options :
    12357   define input  parameter p-method as character no-undo .
    12358   define variable glog as logical   no-undo .
    12359   define variable v-message as character no-undo .
    12360   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    12361   define buffer buf_user-obj for ub.user-obj.
    12362   do
    12363   on error undo, return error return-value
    12364   :
    12365     glog = yes.
    12366     case p-method:
    12367       when "object" then do:
    12368         assign
    12369         v-message = substitute("Все товары из справочника товаров по объекту.&1&2"
    12370                                 , chr(10)
    12371                                 , stat-line(rs-status))
    12372         dsp-rs    = "Все товары по объекту : &1 &2"
    12373         .
    12374       end.
    12375       when "available"  then do:
    12376           assign
    12377           v-message = substitute("Все товары, остаток которых на объекте > 0.&1&2"
    12378                                 , chr(10)
    12379                                 , stat-line(rs-status))
    12380           dsp-rs =   "ВСЕ товары, имеющиеся в наличии на/в &1 &2"
    12381           .
    12382       end.
    12383       when "neg-rest" then do:
    12384           assign
    12385           v-message = substitute("Все товары с отрицательными остатками на объекте.&1&2"
    12386                                 , chr(10)
    12387                                 , stat-line(rs-status))
    12388           dsp-rs     = "ВСЕ товары с отрицательными остатками на/в &1 &2"
    12389           .
    12390       end.
    12391       when "neg-part" then do:
    12392           assign
    12393           v-message = substitute("Все товары, имеющие отрицательные партии на объекте (остаток при этом может быть любым).&1&2"
    12394                                 , chr(10)
    12395                                 , stat-line(rs-status))
    12396           dsp-rs    = "ВСЕ товары с отрицательными партиями на/в &1 &2"
    12397           .
    12398       end.
    12399       when "neg-part-free" then do:
    12400           assign
    12401           v-message = substitute("Все товары, имеющие отрицательные партии в свободной зоне на объекте (остаток при этом может быть любым).&1&2"
    12402                                 , chr(10)
    12403                                 , stat-line(rs-status))
    12404           dsp-rs    = "ВСЕ товары с отрицательными партиями в свободной зоне на/в &1 &2"
    12405           .
    12406       end.
    12407       when "neg-prt" then do:
    12408           assign
    12409           v-message = substitute("Все товары с признаками с отрицательными остатками по признакам на объекте.&1&2"
    12410                                 , chr(10)
    12411                                 , stat-line(rs-status))
    12412           dsp-rs    =  "ВСЕ товары с признаками с отриц. ост. по признаку на/в &1 &2"
    12413           .
    12414       end.
    12415       when "nul-rest" then do:
    12416           assign
    12417           v-message = substitute("Все товары с нулевыми остатками на объекте.&1&2"
    12418                                 , chr(10)
    12419                                 , stat-line(rs-status))
    12420           dsp-rs     = "ВСЕ товары с нулевыми остатками на/в &1 &2"
    12421           .
    12422       end.
    12423       when  "input" then do:
    12424         assign
    12425         v-message = substitute("Все товары, когда либо бывшие (или имеющиеся сейчас) на объекте.&1&2"
    12426                                 , chr(10)
    12427                                 , stat-line(rs-status))
    12428         dsp-rs = "ВСЕ товары, проходившие когда-либо по &1 &2"
    12429         .
    12430       end.
    12431       when "with-price" then do:
    12432         assign
    12433         v-message = substitute("Все товары на объекте, имеющие продажную цену > 0 .&1&2"
    12434                                 , chr(10)
    12435                                 , stat-line(rs-status))
    12436         dsp-rs     = "ВСЕ товары, имеющие цену > 0 по &1 &2"
    12437         .
    12438       end.
    12439       when "ov-req" then do:
    12440         assign
    12441         v-message = substitute("Товары, которые нельзя расходовать с объекта без переоценки&1" +
    12442                               "(попадающие под действие настройки, требующей переоценки после&1" +
    12443                               "любого прихода на объект).&1&2"
    12444                                 , chr(10)
    12445                                 , stat-line(rs-status))
    12446         dsp-rs = "Товары, по которым требуется переоценка после ПРИХОДА на/в &1 &2 "
    12447         .
    12448       end.
    12449       WHEN "inv-req" then do:
    12450         assign
    12451         v-message = substitute("Товары, количество по которым изменялось со времени последней&1" +
    12452                                 "инвентаризации на объекте (своей для каждого товара).&1&2"
    12453                                 , chr(10)
    12454                                 , stat-line(rs-status))
    12455         dsp-rs = "Товары, по которым были ОБОРОТЫ после ИНВЕНТАРИЗАЦИИ на/в &1 &2"
    12456         .
    12457       end.
    12458       when "etalon" then do:
    12459         ASSIGN
    12460         v-message = substitute("Все товары из справочника товаров по ТЕКУЩЕМУ объекту, цены по которым&1" +
    12461                                 "НЕ совпадают с ценами на выбранном ЭТАЛОННОМ объекте&1" +
    12462                                 "(только при условии, что цена есть на том и другом объектах).&1&2"
    12463                                 , chr(10)
    12464                                 , stat-line(rs-status))
    12465         dsp-rs = "Цены на/в &1 &2, не совпадающие с ценами на &3 &4"
    12466         .
    12467       end.
    12468     END CASE.
    12469     message v-message
    12470     view-as alert-box question buttons OK-Cancel update glog.
    12471     if not glog then do:
    12472       run UI-on  in this-procedure.
    12473       return error.
    12474     end.
    12475       ref-list = "":U.
    12476   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12477   run userobjs_select-one in this-procedure
    12478     (input  parparentproc
    12479     ,input  v-cntxt-db-num
    12480     ,input  v-cntxt-userid
    12481     ,input  v-cntxt-host-code-obj
    12482     ,input  v-cntxt-obj-type
    12483     ,input  v-cntxt-obj-code
    12484     ,output v-user-select
    12485     ,output v-sel-obj-type
    12486     ,output v-sel-obj-code
    12487     )  .
    12488                            if not v-user-select then do:     run UI-on in this-procedure .     return no-apply.   end.
    12489       find first buf_user-obj no-lock where
    12490                 buf_user-obj.obj-type = v-sel-obj-type
    12491             and buf_user-obj.obj-code = v-sel-obj-code
    12492             AND buf_user-obj.db-num = v-cntxt-db-num
    12493             AND buf_user-obj.user-id = v-cntxt-userid  no-error .
    12494       if not available buf_user-obj then do:
    12495         run ui-on in this-procedure .
    12496         return error.
    12497       end.
    12498       if p-method = "etalon"
    12499       and p-curr-obj-type = v-sel-obj-type
    12500       and p-curr-obj-code = v-sel-obj-code then do:
    12501         message "Бессмысленно сравнивать цены для одного и того же объекта.".
    12502         run UI-on  in this-procedure.
    12503         return error.
    12504       end.
    12505       if p-method = "etalon":U then do:
    12506         assign
    12507         dsp-rs = replace(dsp-rs, "&1", p-curr-obj-type)
    12508         dsp-rs = replace(dsp-rs, "&2", string(p-curr-obj-code))
    12509         dsp-rs = replace(dsp-rs, "&3", v-sel-obj-type)
    12510         dsp-rs = replace(dsp-rs, "&4", string(v-sel-obj-code))
    12511         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12512         .
    12513       end.
    12514       else do:
    12515         assign
    12516         dsp-rs = replace(dsp-rs, "&1", v-sel-obj-type)
    12517         dsp-rs = replace(dsp-rs, "&2", string(v-sel-obj-code))
    12518         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12519         .
    12520       end.
    12521       run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12522                                           , input-output v-seq
    12523                                           , input 0
    12524                                           , input '':U
    12525                                           , input dsp-rs
    12526                                           , input tot-lns
    12527                                           , input p-method
    12528                                           , input rs-status
    12529                                           , input '':U
    12530                                           , input 'user-obj':U
    12531                                           , input buffer buf_user-obj:handle
    12532                                           ).
    12533   end.
    12534   end procedure.
    12535   PROCEDURE reposition-goods :
    12536   define input  parameter p-direction   as character no-undo .
    12537   define output parameter p-recid as recid no-undo .
    12538   define buffer buf_goods for ub.goods.
    12539   case p-direction :
    12540     when "first":U
    12541     then do:
    12542       get first br-list.
    12543     end.
    12544     when "last":U
    12545     then do:
    12546       get last br-list.
    12547     end.
    12548     when "prev":U
    12549     then do:
    12550       get prev br-list.
    12551       if not available gds-list-flt then do:
    12552         message
    12553         "Это первый товар списка"
    12554         view-as alert-box.
    12555       end.
    12556     end.
    12557     when "next":U
    12558     then do:
    12559       get next br-list.
    12560       if not available gds-list-flt then do:
    12561         message
    12562         "Это последний товар списка"
    12563         view-as alert-box.
    12564       end.
    12565     end.
    12566   end case .
    12567   find first buf_goods no-lock where
    12568           buf_goods.gds-code = gds-list-flt.gds-code no-error.
    12569   if available gds-list-flt then do:
    12570     assign
    12571     p-recid = recid(buf_goods)
    12572     .
    12573   end.
    12574   run reposition-query in this-procedure
    12575     (input recid(gds-list-flt)
    12576     ).
    12577   END PROCEDURE.
    12578   PROCEDURE reposition-query :
    12579   define input parameter p-recid as recid no-undo .
    12580   if p-recid <> ?
    12581   then do:
    12582     reposition br-list to recid p-recid no-error.
    12583   end.
    12584   do with frame Dialog-Frame:
    12585     apply "entry":u to browse br-list .
    12586     apply "VALUE-CHANGED":u to browse br-list .
    12587   end.
    12588   END PROCEDURE.
    12589   procedure cb_fill-lob-res-list :
    12590   define input  parameter p-full-path as character no-undo .
    12591   output to value (p-full-path).
    12592   for each gds-list-flt:
    12593     export gds-list-flt.prod-type
    12594           gds-list-flt.prod-code
    12595           gds-list-flt.artic
    12596           gds-list-flt.qnty
    12597           .
    12598   end.
    12599   output close.
    12600   end procedure.
    12601   procedure cb_fill-lob-res-list-macro :
    12602   define input  parameter p-full-path as character no-undo .
    12603   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
    12604   output to value (p-full-path).
    12605   for each buf_gds-list-flt-hist:
    12606       export
    12607       buf_gds-list-flt-hist.
    12608   end.
    12609   output close.
    12610   end procedure.
    12611   procedure cb_get-next-gds-by-gds-code :
    12612   define input parameter p-gds-code as integer no-undo .
    12613   define input parameter p-bh as handle no-undo .
    12614   define buffer buf_gds-list for gds-list-flt.
    12615   find first buf_gds-list no-lock where
    12616             buf_gds-list.gds-code > p-gds-code no-error.
    12617   if available buf_gds-list then do:
    12618     p-bh:buffer-create().
    12619     p-bh:buffer-copy(buffer buf_gds-list:handle).
    12620   end.
    12621   else do:
    12622   end.
    12623   end procedure.
    12624   procedure m-gds-save-db-proc :
    12625   define variable v-rid-list as character no-undo .
    12626   run ref/clobbnds.w ( input parparentproc
    12627                       ,input this-procedure:handle
    12628                       ,input 'b-add'
    12629                       ,input "uniq-key-rec"
    12630                       ,input 'ИЗМЕНЕНИЕ':U
    12631                       ,input 'list':U
    12632                       ,input 'gds-list'
    12633                       ,input -1
    12634                       ,input-output v-rid-list) no-error.
    12635   end procedure.
    12636   procedure m-macros-save-db-proc :
    12637   define variable v-rid-list as character no-undo .
    12638   run ref/clobbnds.w ( input parparentproc
    12639                       ,input this-procedure:handle
    12640                       ,input 'b-add'
    12641                       ,input "uniq-key-rec"
    12642                       ,input 'ИЗМЕНЕНИЕ':U
    12643                       ,input 'list-macro':U
    12644                       ,input 'gds-list'
    12645                       ,input -1
    12646                       ,input-output v-rid-list) no-error.
    12647   end procedure.
    12648   procedure grplib-get-full-name-alc-type :
    12649   do
    12650   on error undo, return error
    12651   :
    12652   define input parameter p-node-code  as integer      no-undo.
    12653   define output parameter p-full-name as character    no-undo.
    12654       define buffer buf_alc-type       for ub.alc-type.
    12655       find first buf_alc-type no-lock
    12656            where buf_alc-type.alc-type-inner-code = p-node-code
    12657       no-error.
    12658       if not available buf_alc-type
    12659       then do:
    12660           undo, return error "grplib-get-full-name-alc-type: Не найден вид алкогольной продукции с кодом " + string( p-node-code ).
    12661       end.
    12662       assign
    12663       p-full-name = buf_alc-type.alc-type-name
    12664       .
    12665   end.
    12666   end procedure.
