     4873     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4874     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4875     if p-change-value > 0
     4876     then do:
     4877       if frame Dialog-Frame :width + p-change-value >
     4878           session :width-chars
     4879       then do:
     4880         assign
     4881           p-change-value = session :width-chars - frame Dialog-Frame :width
     4882         .
     4883         if p-change-value <= 0
     4884         then do:
     4885           run diasize_position-resize-button in this-procedure .
     4886           return .
     4887         end.
     4888       end.
     4889     end.
     4890     if p-change-value < 0
     4891     then do:
     4892       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4893       then do:
     4894         assign
     4895           p-change-value = v-diasize-orig-frame-width
     4896                          - frame Dialog-Frame :width
     4897         .
     4898         if p-change-value >= 0
     4899         then do:
     4900           run diasize_position-resize-button in this-procedure .
     4901           return .
     4902         end.
     4903       end.
     4904     end.
     4905     if p-change-value >= 0
     4906     then do:
     4907       assign
     4908         v-change-sign = 1
     4909       .
     4910     end.
     4911     else do:
     4912       assign
     4913         v-change-sign = -1
     4914       .
     4915     end.
     4916     assign
     4917       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4918     .
     4919     if p-change-value = 0
     4920     then do:
     4921       run diasize_position-resize-button in this-procedure .
     4922       return .
     4923     end.
