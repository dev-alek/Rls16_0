       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       68   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       69   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       70   ASSIGN
       71      v-S_CONTRACT                = "Contract":U
       72      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       73      v-DELIM_CHR_3               = ","
       74      .
       75   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
       76   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
       77   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       78   FUNCTION Can-Find-Spec RETURN LOGICAL (
       79      INPUT iHost-Code    AS INTEGER,
       80      INPUT iContract-Num AS INTEGER,
       81      INPUT iGds-Code     AS INTEGER ):
       82      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
       83      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
       84      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
       85      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       86      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
       87      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
       88          INPUT  iHost-Code,
       89          INPUT  iContract-Num,
       90          OUTPUT iTmp-Extent3
       91          ).
       92      IF iTmp-Extent3[1] = 2 THEN DO:
       93         ASSIGN
       94            iTmp-Host-Code      = iTmp-Extent3[2]
       95            iTmp-Contract-Num   = iTmp-Extent3[3]
       96            .
       97      END. ELSE DO:
       98         ASSIGN
       99            iTmp-Host-Code      = iHost-Code
      100            iTmp-Contract-Num   = iContract-Num
      101            .
      102      END.
      103      IF iGds-Code = ? THEN DO:
      104         ASSIGN
      105            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      106                                  buf_Spec.Host-Code     = iTmp-Host-Code
      107                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      108                           ).
      109      END. ELSE DO:
      110            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      111                                  buf_Spec.Host-Code     = iTmp-Host-Code
      112                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      113                              AND buf_Spec.Gds-Code      = iGds-Code
      114                            ).
      115      END.
      116      RETURN (lRet).
      117   END FUNCTION.
      118   PROCEDURE MS-Contract-EXTENT-3:
      119      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      120      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      121      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      122      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      123      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      124      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      125      FIND FIRST buf_Cont-2 WHERE
      126                 buf_Cont-2.Host-Code      = i-Host-Code
      127             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      128           NO-LOCK NO-ERROR.
      129      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      130         RETURN.
      131      END.
      132      FOR FIRST buf_Ext-Classif WHERE
      133                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      134           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      135                                               STRING(i-Contract-code)
      136           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      137          NO-LOCK,
      138          EACH buf_Cont WHERE
      139               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      140           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      141          NO-LOCK:
      142          ASSIGN
      143             i-Ret[1] = 1
      144             i-Ret[2] = buf_Cont.Host-code
      145             i-Ret[3] = buf_Cont.Contract-code
      146             .
      147          LEAVE.
      148      END.
      149      IF i-Ret[1] <> 1 THEN DO:
      150         FOR FIRST buf_Ext-Classif WHERE
      151                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      152              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      153                                                  STRING(i-Contract-code)
      154              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      155             NO-LOCK,
      156             EACH buf_Cont WHERE
      157                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      158              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      159             NO-LOCK:
      160             ASSIGN
      161                i-Ret[1] = 2
      162                i-Ret[2] = buf_Cont.Host-code
      163                i-Ret[3] = buf_Cont.Contract-code
      164                .
      165             LEAVE.
      166         END.
      167      END.
      168      RETURN.
      169   END PROCEDURE.
