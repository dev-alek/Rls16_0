    10416       .
    10417       find last buf_gds-list-flt-hist no-lock where
    10418                 buf_gds-list-flt-hist.id = (v-seq - 1)
    10419           and  buf_gds-list-flt-hist.line = 0 no-error .
    10420       DISPLAY
    10421       (if available buf_gds-list-flt-hist
    10422       then buf_gds-list-flt-hist.des
    10423       else '') @ dsp-rs
    10424       with frame Dialog-Frame.
    10425       if tot-lns = 0
    10426       and not p-keep-query
    10427       then do:
    10428         run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
    10429       end.
    10430     end.
    10431   end.
    10432   end procedure.
    10433   PROCEDURE trig-attr :
    10434   define input parameter p-attr-table as character no-undo .
    10435   define input parameter p-list       as character no-undo .
    10436   DEFINE VARIABLE ii as integer no-undo .
    10437   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10438   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10439   DEFINE VARIABLE vtooltip             as character           no-undo.
    10440   DEFINE VARIABLE vlabel               as character           no-undo .
    10441   DEFINE VARIABLE vtype                as character           no-undo .
    10442   DEFINE VARIABLE vformat              as character           no-undo .
    10443   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
    10444   DEFINE VARIABLE voutput-display      as logical             no-undo .
    10445   DEFINE VARIABLE vother               as character           no-undo .
    10446   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10447   DEFINE VARIABLE jj                   as integer             no-undo .
    10448   DEFINE VARIABLE v-spr                as character           no-undo .
    10449   DEFINE VARIABLE v-spr-param          as character           no-undo .
    10450   DEFINE VARIABLE v-setted             as logical             no-undo .
    10451   define variable v-init               as character           no-undo .
    10452   define variable v-item               as character           no-undo .
    10453   define variable glog as logical no-undo .
    10454   define variable v-list               as character           no-undo .
    10455   assign
    10456   v-attr-code = ""
    10457   vattr-codes = ""
    10458   vattr-labels = ""
    10459   vvalue = ""
    10460   .
    10461   DO ii = 1 to num-entries ( p-list):
    10462       CASE p-attr-table:
    10463         when "gds-obj-attr" then do:
    10464           run gdsoattr-name  in this-procedure (
    10465                                                 input entry(ii, p-list)
    10466                                                 ,output vtype
    10467                                                 ,output vformat
    10468                                                 ,output vlabel
    10469                                                 ,output vuser-can-edit
    10470                                                 ,output voutput-display
    10471                                                 ,output vother) no-error.
    10472         end.
    10473         when "gds-host-attr" then do:
    10474           v-list = 'no-envd,':u.
    10475           run gdshattr-name in this-procedure (
    10476                                                 input entry(ii, p-list)
    10477                                               ,output vtype
    10478                                               ,output vformat
    10479                                               ,output vlabel
    10480                                               ,output vuser-can-edit
    10481                                               ,output voutput-display
    10482                                               ,output vother) no-error.
    10483         end.
    10484         WHEN "goods-attr" then do:
    10485           run gds-attr-name in this-procedure (
    10486                                                 input entry(ii, p-list)
    10487                                                 ,output vtype
    10488                                                 ,output vformat
    10489                                                 ,output vlabel
    10490                                                 ,output vuser-can-edit
    10491                                                 ,output voutput-display
    10492                                                 ,output vother) no-error.
    10493         end.
    10494       END CASE.
    10495       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
    10496           assign
    10497           vattr-codes = vattr-codes + chr(4) + entry(ii, p-list)
    10498           vattr-labels = vattr-labels + chr(4) + vlabel
    10499           .
    10500       end.
    10501   end.
    10502   run gbl/d-list.w ( input "b-sel":U
    10503                     ,input "Выберите атрибут"
    10504                     ,input vattr-codes
    10505                     ,input vattr-labels
    10506                     ,input chr(4)
    10507                     ,input "":U
    10508                     ,output v-attr-code).
    10509   if v-attr-code = "" then do:
    10510     return error.
    10511   end.
    10512   glog = yes.
    10513   CASE rs-list-method:
    10514     when "gds-obj-attr":U then do:
    10515       run gdsoattr-tooltip  in this-procedure( input v-attr-code,
    10516                            output vtooltip,
    10517                            output vlabel).
    10518       message
    10519       "Все товары с установленным атрибутом на объекте" vlabel skip
    10520       stat-line(rs-status)
    10521       view-as alert-box question buttons OK-Cancel update glog.
    10522       if not glog then do:
    10523         return error.
    10524       end.
    10525   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10526   run userobjs_select-one in this-procedure
    10527     (input  parparentproc
    10528     ,input  v-cntxt-db-num
    10529     ,input  v-cntxt-userid
    10530     ,input  v-cntxt-host-code-obj
    10531     ,input  v-cntxt-obj-type
    10532     ,input  v-cntxt-obj-code
    10533     ,output v-user-select
    10534     ,output v-sel-obj-type
    10535     ,output v-sel-obj-code
    10536     )  .
    10537       if not v-user-select then do:
    10538         return error.
    10539       end.
    10540       assign
    10541       dsp-rs = substitute("ВСЕ товары с установленным атрибутом на объекте &1 &2", vlabel, stat-line(rs-status))
    10542       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code
    10543       .
    10544     end.
    10545     when "gds-obj-attr-val":U then do:
    10546       run gdsoattr-name  in this-procedure (
    10547                            input v-attr-code,
    10548                            output vtype,
    10549                            output vformat,
    10550                            output vlabel,
    10551                            output vuser-can-edit,
    10552                            output voutput-display,
    10553                            output vother).
    10554       do jj = 1 to num-entries(vother, chr(47)):
    10555         if entry(1, entry(jj, vother, chr(47)), "=":U) = "init":U then do:
    10556           assign
    10557           v-init = string(entry(2, entry(jj, vother, chr(47)), "=":U))
    10558           .
    10559         end.
    10560       end.
