     1503   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1504   define  stream PrnLibStream.
     1505   procedure prn-lib-prn-file :
     1506     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1507     define input parameter p-DIsabledoptions as integer no-undo .
     1508     define variable v-report-name as character no-undo .
     1509     define variable v-user-action as character no-undo .
     1510     define variable v-printed     as logical   no-undo .
     1511     define variable v-exist       as logical   no-undo .
     1512     do
     1513       on error undo, return error
     1514       :
     1515       run prn-lib-get-report-name  in this-procedure (
     1516         input parParentProc
     1517         ,output v-report-name
     1518         ).
     1519   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1520   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1521     (input  v-report-name
     1522     ,input  2
     1523     ,output v-exist
     1524     )  .
     1525       if NOT v-exist then
     1526       DO:
     1527         Message
     1528           "Нет заданий на печать ! "
     1529           view-as alert-box .
     1530         Return  .
     1531       End.
     1532       run gbl/prnfilen.w
     1533         (input  ""
     1534         ,input  p-DisabledOptions
     1535         ,input  string(v-report-name )
     1536         ,input  7
     1537         ,output v-user-action
     1538         ,output v-printed
     1539         ) .
     1540       if v-printed then
     1541       do:
     1542         return "YES" .
     1543       end.
     1544       else
     1545       do:
     1546         return "NO" .
     1547       end.
     1548     end.
     1549   end procedure.
     1550   procedure prn-lib-open-stream :
     1551     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1552     define input parameter p-page-size    as integer no-undo .
     1553     define input parameter p-is-stream    as logical no-undo .
     1554     define input parameter p-append       as logical no-undo .
     1555     define variable v-report-name as character no-undo .
     1556     do
     1557       on error undo, return error
     1558       :
     1559       run prn-lib-get-report-name  in this-procedure (
     1560         input parParentProc
     1561         ,output v-report-name
     1562         ).
     1563       if p-is-stream then
     1564       do:
     1565         if p-append then
     1566         do:
     1567           output stream PrnLibStream to value( v-report-name )
     1568             page-size value(p-page-size) append .
     1569         end.
     1570         if not p-append then
     1571         do:
     1572           output stream PrnLibStream to value( v-report-name )
     1573             page-size value(p-page-size) .
     1574         end.
     1575       end.
     1576       if not p-is-stream then
     1577       do:
     1578         if p-append then
     1579         do:
     1580           output to value( v-report-name )
     1581             page-size value(p-page-size) append .
     1582         end.
     1583         if not p-append then
     1584         do:
     1585           output to value( v-report-name )
     1586             page-size value(p-page-size) .
     1587         end.
     1588       end.
     1589     end.
     1590   end procedure.
     1591   procedure prn-lib-open-exp :
     1592     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1593     define input parameter p-is-stream    as logical no-undo .
     1594     define input parameter p-is-append    as logical no-undo .
     1595     define output parameter p-ReportFileName as char init "report" no-undo.
     1596     define output parameter p-process as logical no-undo .
     1597     define variable glog as logical no-undo .
     1598     do
     1599       on error undo, return error
     1600       :
     1601       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1602         TITLE      "Укажите путь"
     1603         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1604         ASK-OVERWRITE
     1605         CREATE-TEST-FILE
     1606         SAVE-AS
     1607         USE-FILENAME
     1608         DEFAULT-EXTENSION "txt"
     1609         UPDATE glog
     1610         .
     1611       if not glog then  return.
     1612       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1613       if p-is-stream then
     1614       do:
     1615         if p-is-append then
     1616         do:
     1617           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1618         end.
     1619         else
     1620         do:
     1621           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1622         end.
     1623       end.
     1624       else
     1625       do:
     1626         if p-is-append then
     1627         do:
     1628           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1629         end.
     1630         else
     1631         do:
     1632           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1633         end.
     1634       end.
     1635       p-process = yes.
     1636     end.
     1637   end procedure.
     1638   procedure prn-lib-get-report-name :
