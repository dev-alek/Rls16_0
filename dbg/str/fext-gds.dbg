     4124   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4125     assign
     4126     frame Dialog-Frame
     4127     loc-name.
     4128       if last-event:label = "Ctrl-J" then
     4129         find next l-gds-list-flt where
     4130                   can-find (ub.goods where ub.goods.artic = l-gds-list-flt.artic and
     4131                   ub.goods.prod-type = l-gds-list-flt.prod-type and
     4132                   ub.goods.prod-code = l-gds-list-flt.prod-code and
     4133                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4134       else
     4135         find first l-gds-list-flt where
     4136                   can-find (ub.goods where ub.goods.artic = l-gds-list-flt.artic and
     4137                   ub.goods.prod-type = l-gds-list-flt.prod-type and
     4138                   ub.goods.prod-code = l-gds-list-flt.prod-code and
     4139                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4140       if available l-gds-list-flt then do:
     4141         line-rec = recid (l-gds-list-flt).
     4142         reposition br-list to recid line-rec no-error.
     4143       end.
     4144       else do:
     4145         message "Строка не найдена."
     4146                 view-as alert-box error.
     4147       end.
     4148     apply "entry" to loc-name in frame Dialog-Frame.
     4149   END PROCEDURE.
     4150   on value-changed of br-list in frame Dialog-Frame do:
     4151   if not available gds-list-flt or recid (gds-list-flt) <> line-rec then do:
