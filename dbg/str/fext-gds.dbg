     7149       run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-flt-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
     7150        run find-user-obj-rowid in this-procedure ( input v-rowid, input v-no-context, output v-user-obj-type, output v-user-obj-code ).
     7151         for each ub.gds-obj where ub.gds-obj.obj-type = v-user-obj-type
