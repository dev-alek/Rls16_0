     3732   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3733   define variable glog as logical no-undo .
     3734   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3735   if lookup(b-save :type in frame Dialog-Frame
     3736            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3737            ) = 0
     3738   then do:
     3739     message
     3740       "$Workfile$"
     3741       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3742       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3743       "Тип" self :type in frame Dialog-Frame skip
     3744       "Процедура" this-procedure :file-name skip
     3745       view-as alert-box .
     3746   end.
     3747   else do:
     3748     apply "entry":u to b-save in frame Dialog-Frame .
     3749     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3750       return no-apply .
     3751     end.
     3752   end.
     3753     assign
     3754       f-name = "default.gds"
     3755       glog = yes
     3756       .
     3757     system-dialog get-file f-name
     3758       filters "Списки товаров *.gds" "*.gds"
     3759       ask-overwrite
     3760       save-as
     3761       use-filename
     3762       update glog
     3763       default-extension "gds".
     3764     if not glog then do:
     3765       apply "entry" to br-list in frame Dialog-Frame.
     3766       return no-apply.
     3767     end.
     3768     output to value (f-name).
     3769     for each gds-list-flt:
     3770       export gds-list-flt.prod-type
     3771             gds-list-flt.prod-code
     3772             gds-list-flt.artic
     3773             gds-list-flt.qnty
     3774             .
     3775     end.
     3776     output close.
     3777   END.
