     5975   procedure proc-b-macro :
     5976   define input parameter p-option as character no-undo .
     5977   define variable glog as logical no-undo .
     5978   define variable v-id as integer no-undo .
     5979   define variable v-result as character no-undo .
     5980   define variable v-des as character no-undo .
     5981   define variable v-hist-mode as character no-undo .
     5982   define variable v-file as logical no-undo .
     5983   define variable v-full-path        as character no-undo .
     5984   define variable v-path             as character no-undo .
     5985   define variable v-file-name        as character no-undo .
     5986   define variable v-file-name-no-ext as character no-undo .
     5987   define variable v-file-name-ext    as character no-undo .
     5988   define variable v-rid-list as character no-undo .
     5989   define variable v-ok as logical no-undo .
     5990   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     5991   define buffer buf_clob-bind for ub.clob-bind.
     5992   define buffer buf_clob-data for ub.clob-data.
     5993   do
     5994   on error undo, return error
     5995   :
     5996     if v-macro-is-running then do:
     5997     end.
     5998     else do:
     5999       glog = yes.
     6000       if an-listp-start-macro-id >= 1 then do:
     6001         case p-option:
     6002           when "file" then do:
     6003         message
     6004         "Согласно командам формирования списка из записанного макроса"
     6005         view-as alert-box question buttons OK-Cancel update glog.
     6006           end.
     6007           when "lob" then do:
     6008             message
     6009             "Нелья!"
     6010             view-as alert-box question buttons OK-Cancel update glog.
     6011             run ui-on in this-procedure .
     6012             return error.
     6013           end.
     6014         end case.
     6015         if not glog then do:
     6016           run ui-on in this-procedure .
     6017           return error.
     6018         end.
     6019         if an-listp-end-macro-id = ? then do:
     6020           assign
     6021           an-listp-end-macro-id  = v-seq.
     6022           for each macro-list-hist:
     6023             delete macro-list-hist.
     6024           end.
     6025           for each buf_gds-list-flt-hist where
     6026                   buf_gds-list-flt-hist.id >=  an-listp-start-macro-id
     6027             and  buf_gds-list-flt-hist.id <=  an-listp-end-macro-id:
     6028             create macro-list-hist.
     6029             buffer-copy buf_gds-list-flt-hist
     6030             except id num-recs num-add num-ignored
     6031             to macro-list-hist
     6032             assign
     6033             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6034             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6035             macro-list-hist.done = no
     6036             .
     6037           end.
     6038         end.
     6039         else do:
     6040           find last macro-list-hist no-error.
     6041           if available macro-list-hist then do:
     6042             v-id = macro-list-hist.id.
     6043           end.
     6044         end.
     6045       end.
     6046       else do:
     6047         case p-option:
     6048           when "file" then do:
     6049         message
     6050         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6051         view-as alert-box question buttons OK-Cancel update glog.
     6052         if not glog then do:
     6053           run ui-on in this-procedure .
     6054           return error.
     6055         end.
     6056         system-dialog get-file f-name
     6057           filters "Макрос формирования списка *.gdm" "*.gdm"
     6058           title "Выберите файл макроса"
     6059           INITIAL-DIR "."
     6060           return-to-start-dir
     6061           must-exist
     6062           update glog
     6063           default-extension "gdm".
     6064         if not glog then do:
     6065           run ui-on in this-procedure .
     6066           return error.
     6067         end.
     6068           end.
     6069           when "lob" then do:
     6070             message
     6071             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6072             view-as alert-box question buttons OK-Cancel update glog.
     6073             if not glog then do:
     6074               run ui-on in this-procedure .
     6075               return error.
     6076             end.
     6077             run ref/clobbnds.w ( input parparentproc
     6078                                 ,input this-procedure:handle
     6079                                 ,input 'b-sel'
     6080                                 ,input "uniq-key-rec"
     6081                                 ,input ""
     6082                                 ,input 'list-macro':U
     6083                                 ,input 'gds-list'
     6084                                 ,input -1
     6085                                 ,input-output v-rid-list) no-error.
     6086             if v-rid-list = '' then do:
     6087               run ui-on in this-procedure.
     6088               return error.
     6089             end.
     6090             find first buf_clob-bind no-lock where
     6091                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6092             if not available buf_clob-bind then do:
     6093               message
     6094               "Не найдена ссылка на макрос, сохраненный в БД!"
     6095               view-as alert-box error .
     6096               run ui-on in this-procedure .
     6097               return error.
     6098             end.
     6099             find first buf_clob-data no-lock where
     6100                       buf_clob-data.db-num = buf_clob-bind.db-num
     6101                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6102             if not available buf_clob-data then do:
     6103               message
     6104               "Не найдена ссылка на макрос, сохраненный в БД!"
     6105               view-as alert-box error .
     6106               run ui-on in this-procedure .
     6107               return error.
     6108             end.
     6109             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6110               message
     6111               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6112                         , buf_clob-data.db-num
     6113                         , chr(10))
     6114              view-as alert-box question buttons yes-no update v-ok.
     6115              if not v-ok then do:
     6116                 run ui-on in this-procedure .
     6117                 return error.
     6118              end.
     6119             end.
     6120             run gbl/_tmpfile.p ( input ""
     6121                           ,input "tmp"
     6122                           ,output v-file-name) .
     6123             copy-lob from object buf_clob-data.cdata
     6124             to file f-name.
     6125             run gbl/filename.p
     6126               (input  v-file-name
     6127               ,output f-name
     6128               ,output v-path
     6129               ,output v-file-name
     6130               ,output v-file-name-no-ext
     6131               ,output v-file-name-ext
     6132               ) no-error .
     6133             if error-status:error then do:
     6134             end.
     6135           end.
     6136         end case.
     6137         for each macro-list-hist:
     6138           delete macro-list-hist.
     6139         end.
     6140         input stream sout from value (f-name).
     6141         _macro:
     6142         repeat:
     6143           create macro-list-hist.
     6144           import stream sout macro-list-hist no-error.
     6145           if error-status:error then do:
     6146               undo _macro, next _macro.
     6147           end.
     6148           assign
     6149           macro-list-hist.num-rec = 0
     6150           macro-list-hist.num-add = 0
     6151           macro-list-hist.num-ignored = 0
     6152           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6153           macro-list-hist.done = no
     6154           .
     6155         end.
     6156         find first macro-list-hist where
     6157                 macro-list-hist.id = 0.
     6158         delete macro-list-hist.
     6159         input stream sout close.
     6160         If p-option = "lob" then do:
     6161          os-delete value(f-name).
     6162         end.
     6163         v-file = yes.
     6164       end.
     6165       an-listp-macros-label-id = v-seq.
     6166       run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6167                                           , input-output v-seq
     6168                                           , input 0
     6169                                           , input '>':U
     6170                                           , input (if v-file
     6171                                                   then substitute("Файл макроса : &1", f-name)
     6172                                                   else substitute("Записанный макрос")
     6173                                                   )
     6174                                           , input tot-lns
     6175                                           , input 'macro':U
     6176                                           , input '':U
     6177                                           , input (if v-file then f-name else '':U)
     6178                                           , input '':U
     6179                                           , input ?
     6180                                           ).
     6181     end.
     6182     disable
     6183     b-record
     6184     b-macro
     6185     with frame Dialog-Frame .
     6186     hide
     6187     b-record in frame Dialog-Frame .
     6188     enable
     6189     b-clear-macro with frame Dialog-Frame .
     6190     v-macro-is-running = yes.
     6191     run str/listmcro.w (input parparentproc
     6192                   ,input this-procedure:handle
     6193                   ,input "Макрос формирования списка товаров" + chr(4) + "gdm"
     6194                   ,input "b-play,b-step"
     6195                   ,input-output v-current-step
     6196                   ,input v-id
     6197                   ,output v-result) no-error .
     6198     if error-status:error
     6199     or v-result = "b-stop"
     6200     or v-result = 'end':U
     6201     then do:
     6202       for each macro-list-hist:
     6203         delete macro-list-hist.
     6204       end.
     6205       assign
     6206       an-listp-start-macro-id = ?
     6207       an-listp-end-macro-id = ?
     6208       an-listp-macros-label-id = 0
     6209       .
     6210       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6211       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6212       if v-result = 'b-stop' then do:
     6213         assign
     6214         v-hist-mode = '[]':U
     6215         v-des = "Выполнение макроса прекращено пользователем"
     6216         .
     6217         hide
     6218         b-clear-macro
     6219         b-stop
     6220         in frame Dialog-Frame .
     6221         enable
     6222         b-record
     6223         with frame Dialog-Frame .
     6224       end.
     6225       if v-result = 'end' then do:
     6226         assign
     6227         v-hist-mode = '<':U
     6228         v-des = "Выполнение макроса завершено"
     6229         .
     6230         hide
     6231         b-clear-macro
     6232         b-stop
     6233         in frame Dialog-Frame .
     6234         enable
     6235         b-record
     6236         with frame Dialog-Frame .
     6237       end.
     6238       if error-status:error then do:
     6239         assign
     6240         v-hist-mode = 'E':U
     6241         v-des = "Выполнение макроса прекращено из-за ошибки"
     6242         .
     6243       end.
     6244       run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6245                                           , input-output v-seq
     6246                                           , input 0
     6247                                           , input v-hist-mode
     6248                                           , input v-des
     6249                                           , input tot-lns
     6250                                           , input 'macro':U
     6251                                           , input '':U
     6252                                           , input f-name
     6253                                           , input '':U
     6254                                           , input ?
     6255                                           ) no-error .
     6256       assign
     6257       v-macro-is-running = no
     6258       v-current-step = 0
     6259       .
     6260     end.
     6261     enable
     6262     b-macro
     6263     with frame Dialog-Frame .
     6264   end.
     6265   end procedure.
     6266   procedure proc-create-macro-list-hist :
     6267   define input parameter p-list-table as character no-undo .
     6268   define input parameter p-id as integer           no-undo .
     6269   define input parameter p-line as integer         no-undo .
     6270   define input parameter p-hist-mode as character  no-undo .
     6271   define input parameter p-des as character        no-undo .
     6272   define input parameter p-option_ as character    no-undo .
     6273   define input parameter p-item_ as character      no-undo .
     6274   define input parameter p-status_ as character    no-undo .
     6275   define buffer buf_macro-list-hist for macro-list-hist.
     6276   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6277     do
     6278     on error undo, return error return-value
     6279     :
     6280       create buf_macro-list-hist.
     6281       assign
     6282       buf_macro-list-hist.list-table = p-list-table
     6283       buf_macro-list-hist.id         = p-id
     6284       buf_macro-list-hist.line       = p-line
     6285       buf_macro-list-hist.hist-mode  = p-hist-mode
     6286       buf_macro-list-hist.des        = p-des
     6287       buf_macro-list-hist.option_    = p-option_
     6288       buf_macro-list-hist.item_      = p-item_
     6289       buf_macro-list-hist.status_    = p-status_
     6290       .
     6291       if p-keep-query then do:
     6292         create buf_keep-macro-list-hist.
     6293         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6294       end.
     6295     end.
     6296   end procedure.
     6297   procedure proc-macro-play :
     6298   define input parameter p-id as integer no-undo .
     6299   define input parameter p-step as logical no-undo .
     6300   define input parameter p-max-id as integer no-undo .
     6301   define variable v-id as integer no-undo .
     6302   define variable v-rowid   as rowid no-undo .
     6303   define variable v-tbl-name as character no-undo .
     6304   define variable v-old-seq as integer no-undo .
     6305   define variable v-current-id as integer no-undo .
     6306   define variable v-temp-seq as integer no-undo .
     6307   define variable v-rs-do-error as logical no-undo .
     6308   define  buffer buf_macro-list-hist for macro-list-hist.
     6309   define  buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     6310   do
     6311   on error undo, return error return-value
     6312   :
     6313     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6314       assign
     6315       v-current-id = v-current-id + 1
     6316       v-id = macro-list-hist.id.
     6317       CASE entry(1, macro-list-hist.option_, chr(4)):
     6318         when 'macro':U
     6319         or
     6320         when 'title':U
     6321         or
     6322         when 'start':U
     6323         then do:
     6324         end.
     6325         when 'clear':U then do:
     6326           for each gds-list-flt:
     6327             delete gds-list-flt.
     6328           end.
     6329           for each gds-list-flt-hist where gds-list-flt-hist.id > an-listp-macros-label-id:
     6330             delete gds-list-flt-hist.
     6331           end.
     6332           tot-lns = 0.
     6333           v-seq = an-listp-macros-label-id + 1.
     6334           v-no-hist = 0.
     6335           create buf_gds-list-flt-hist.
     6336           buffer-copy macro-list-hist
     6337           to buf_gds-list-flt-hist
     6338           assign buf_gds-list-flt-hist.id = v-seq
     6339           v-temp-seq = v-seq
     6340           v-seq = v-seq + 1
     6341           v-no-hist = v-no-hist + 1
     6342           .
     6343           run ui-on in this-procedure .
     6344         end.
     6345         when 'single' then do:
     6346            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6347                                                 ,input ?
     6348                                                 ,input 'ub'
     6349                                                 ,input ?
     6350                                                 ,input no-lock
     6351                                                 ,output v-rowid
     6352                                                 ,output v-tbl-name) no-error .
     6353           if not error-status:error then do:
     6354             CASE macro-list-hist.hist-mode:
     6355               when '+':U then do:
     6356                 run proc-b-add in this-procedure(input yes
     6357                                                 ,input v-rowid
     6358                                                 ,input macro-list-hist.option_
     6359                                                 ,input macro-list-hist.status_) no-error .
     6360               end.
     6361               when '-':U then do:
     6362                 run proc-b-del in this-procedure(input yes
     6363                                                 ,input v-rowid
     6364                                                 ,input macro-list-hist.option_
     6365                                                 ,input macro-list-hist.status_) no-error .
     6366               end.
     6367               when '*':U then do:
     6368                 run proc-b-rest in this-procedure(input yes
     6369                                                  ,input v-rowid
     6370                                                  ,input macro-list-hist.option_
     6371                                                  ,input macro-list-hist.status_) no-error .
     6372               end.
     6373             END.
     6374             if error-status:error then do:
     6375                 return ("error" + chr(4) + return-value) .
     6376             end.
     6377             find first  buf_gds-list-flt-hist where
     6378                     buf_gds-list-flt-hist.id = v-seq - 1 no-error .
     6379             if available buf_gds-list-flt-hist then
     6380             assign
     6381             macro-list-hist.num-recs = buf_gds-list-flt-hist.num-recs
     6382             macro-list-hist.num-add = buf_gds-list-flt-hist.num-add
     6383             macro-list-hist.num-ignored = buf_gds-list-flt-hist.num-ignored
     6384             .
     6385           end.
     6386           else do:
     6387             return ("error" + chr(4) + return-value).
     6388           end.
     6389         end.
     6390         otherwise do:
     6391           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6392           or lookup(macro-list-hist.option_, '':U) > 0
     6393           then do:
     6394             if macro-list-hist.line = 0 then do:
     6395               v-no-hist = 0.
     6396               for each buf_macro-list-hist where
     6397                       buf_macro-list-hist.id = v-id:
     6398                 create buf_gds-list-flt-hist.
     6399                 buffer-copy buf_macro-list-hist
     6400                 except id  num-recs num-add num-ignored done
     6401                 to buf_gds-list-flt-hist
     6402                 assign
     6403                 buf_gds-list-flt-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6404                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6405                 v-seq = (if buf_macro-list-hist.line = 0
     6406                         then (v-seq + 1)
     6407                         else v-seq)
     6408                 v-no-hist = v-no-hist + 1
     6409                 .
     6410               end.
     6411               if v-no-hist = 1 then v-no-hist = 0.
     6412               run rs-do in this-procedure (input yes
     6413                                         , input p-step
     6414                                         , input macro-list-hist.option_
     6415                                         , input macro-list-hist.status_
     6416                                         , input get-line-mode(macro-list-hist.hist-mode)
     6417                                         , input v-temp-seq
     6418                                         ) no-error .
     6419               if error-status:error then do:
     6420                 assign
     6421                 v-rs-do-error = yes.
     6422               end.
     6423               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6424                 run proc-b-rest-2 in this-procedure .
     6425                 run ui-on in this-procedure .
     6426               end.
     6427               for each buf_gds-list-flt-hist where
     6428                       buf_gds-list-flt-hist.id = v-temp-seq,
     6429                  first buf_macro-list-hist where
     6430                       buf_macro-list-hist.id = v-id
     6431                   AND buf_macro-list-hist.line = buf_gds-list-flt-hist.line:
     6432                  assign
     6433                  buf_macro-list-hist.num-recs = buf_gds-list-flt-hist.num-recs
     6434                  buf_macro-list-hist.num-add = buf_gds-list-flt-hist.num-add
     6435                  buf_macro-list-hist.num-ignored = buf_gds-list-flt-hist.num-ignored
     6436                  .
     6437               end.
     6438               if v-rs-do-error then do:
     6439                 run ui-on in this-procedure .
     6440                 return ("error" + chr(4) + return-value).
     6441               end.
     6442               v-id = macro-list-hist.id.
     6443             end.
     6444           end.
     6445         end.
     6446       END CASE.
     6447     end.
     6448   end.
     6449   end procedure.
     6450   procedure proc-b-rest-2 :
     6451     do
     6452     on error undo, return error
     6453     :
     6454       for each gds-list-flt:
     6455         if gds-list-flt.to-del = ? then do:
     6456           assign
     6457           gds-list-flt.to-del = no
     6458           .
     6459         end.
     6460         else do:
     6461           delete gds-list-flt.
     6462         end.
     6463       end.
     6464       tot-lns = lns-cnt.
     6465     end.
     6466   end procedure.
     6467   PROCEDURE proc-expand :
     6468   define input parameter p-shift as integer no-undo .
     6469   define input parameter p-from as integer no-undo .
     6470   define input parameter p-to as integer no-undo .
     6471   define input parameter p-forcer-name as character no-undo .
     6472   define variable fh as widget-handle no-undo .
     6473   define variable hh as widget-handle no-undo .
     6474   define variable lh as widget-handle no-undo .
     6475   define variable ii as INTEGER no-undo .
     6476   ASSIGN
     6477   fh = frame Dialog-Frame:first-child
     6478   hh = fh:first-child
     6479   .
     6480   CASE v-expand:
     6481     WHEN YES THEN DO:
     6482       ASSIGN
     6483       v-expand = NO.
     6484       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6485         ASSIGN
     6486         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6487         hh:ROW          = (hh:ROW - p-shift).
     6488         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6489       END.
     6490     END.
     6491     WHEN NO THEN DO:
     6492       v-expand = YES.
     6493       v-downed = ''.
     6494       _do:
     6495       do while valid-handle(hh):
     6496         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6497          AND hh:ROW >= p-from
     6498          AND hh:ROW <= p-to
     6499          and lookup(hh:name, p-forcer-name) = 0
     6500          THEN DO:
     6501           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6502           hh:ROW          = (hh:ROW + p-shift).
     6503           ASSIGN
     6504           v-downed = v-downed + chr(44) + STRING(hh).
     6505           IF hh:TYPE = "fill-in"
     6506           AND valid-handle(hh:side-label-handle) THEN dO:
     6507             assign
     6508             lh = hh:SIDE-LABEL-HANDLE
     6509             lh:ROW = lh:ROW + p-shift
     6510             v-downed = v-downed + chr(44) + STRING(lh)
     6511             .
     6512            END.
     6513          END.
     6514          hh = hh:next-sibling.
     6515       END.
     6516       v-downed = trim(v-downed, chr(44)).
     6517     END.
     6518   END CASE.
     6519   END PROCEDURE.
     6520   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     6521   DO:
     6522   define variable glog as logical no-undo .
     6523   define buffer buf_gds-list-flt for gds-list-flt.
     6524   if available gds-list-flt then   do:
     6525     find first buf_gds-list-flt where
     6526              recid(buf_gds-list-flt) = recid(gds-list-flt).
     6527     assign
     6528     buf_gds-list-flt.to-sel = not (buf_gds-list-flt.to-sel).
     6529     glog = br-list:refresh().
     6530     if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK,RETURN":U) = 0  then  do:
     6531        glog = br-list:select-next-row ().
     6532        APPLY "VALUE-CHANGED" to br-list.
     6533     end.
     6534   end.
     6535   APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6536   END.
     6537   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     6538   DO:
     6539   define buffer buf_gds-list-flt for gds-list-flt.
     6540   if not available gds-list-flt then return no-apply.
     6541   find first buf_gds-list-flt where
     6542             recid(buf_gds-list-flt) = recid(gds-list-flt).
     6543   assign
     6544   buf_gds-list-flt.to-sel = not (buf_gds-list-flt.to-sel)
     6545   .
     6546   APPLY "CHOOSE" to b-exit.
     6547   END.
     6548   if lookup(bttns, "hide") = 0 then do:
     6549     run diasize_add_browse in this-procedure
     6550       (input  'height':u
     6551       ,input  browse BR-option :handle
     6552       ) .
     6553     run diasize_init in this-procedure .
     6554   end.
     6555   define variable v-ok as logical   no-undo .
     6556   assign
     6557     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6558   .
     6559   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     6560   MAIN-BLOCK:
     6561   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6562     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6563   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6564   define variable varscales-pref-type43 as character no-undo.
     6565   varscales-pref  = ?.
     6566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
