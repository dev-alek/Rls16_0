     1945   procedure fltfield-clear :
     1946     define output parameter loc-fld as character no-undo.
     1947     define output parameter loc-lab as character no-undo .
     1948     define output parameter loc-spr as character no-undo .
     1949     define output parameter loc-dim as character no-undo .
     1950     assign
     1951       loc-fld = ""
     1952       loc-lab = ""
     1953       loc-spr = ""
     1954       loc-dim = "0"
     1955     .
     1956   end procedure .
     1957   procedure fltfield-add :
     1958     define input        parameter par-fld as character no-undo.
     1959     define input        parameter par-lab as character no-undo .
     1960     define input        parameter par-spr as character no-undo .
     1961     define input-output parameter loc-fld as character no-undo.
     1962     define input-output parameter loc-lab as character no-undo .
     1963     define input-output parameter loc-spr as character no-undo .
     1964     define input-output parameter loc-dim as character no-undo .
     1965     do
     1966     on error undo, return error
     1967     :
     1968       assign
     1969       loc-fld = if loc-dim = '0'
     1970                 then par-fld
     1971                 else (loc-fld + chr(44) + par-fld)
     1972       loc-lab = if loc-dim = '0'
     1973                 then par-lab
     1974                 else (loc-lab + chr(44) + par-lab)
     1975       loc-spr = if loc-dim = '0'
     1976                 then par-spr
     1977                 else (loc-spr + chr(44) + par-spr)
     1978       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1979                 string(integer(if num-entries(loc-dim) > 1
     1980                               then entry(2, loc-dim)
     1981                               else entry(1, loc-dim)
     1982                               ) + 1)
     1983       no-error
     1984       .
     1985     end.
     1986   end procedure.
