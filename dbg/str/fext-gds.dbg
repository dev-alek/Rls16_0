     5161             if error-status :error
     5162             or error-status :get-message(1) <> ""
     5163             then do:
     5164               undo move_block, retry move_block .
     5165             end.
     5166           end.
     5167         end.
     5168         for each buf_temp-browse-handle
     5169           where buf_temp-browse-handle.browse-type = 'width':u
     5170         on error undo move_block, retry move_block
     5171         :
     5172           assign
     5173             buf_temp-browse-handle.browse-handle :width
     5174               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5175             no-error .
     5176           if error-status :error
     5177           or error-status :get-message(1) <> ""
     5178           then do:
     5179             undo move_block, retry move_block .
     5180           end.
     5181         end.
     5182         assign
     5183           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5184           no-error .
     5185         if error-status :error
     5186         or error-status :get-message(1) <> ""
     5187         then do:
     5188           undo move_block, retry move_block.
     5189         end.
     5190         assign
     5191           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5192         no-error .
     5193         if error-status :error
     5194         or error-status :get-message(1) <> ""
     5195         then do:
     5196           undo move_block, retry move_block.
     5197         end.
     5198         if frame Dialog-Frame :scrollable = true
     5199         then do:
     5200           assign
     5201             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5202           no-error .
     5203           if error-status :error
     5204           or error-status :get-message(1) <> ""
     5205           then do:
     5206             undo move_block, retry move_block.
     5207           end.
     5208         end.
     5209       end.
     5210       if p-move-resize
     5211       then do:
     5212         run diasize_position-resize-button in this-procedure .
     5213       end.
     5214       if v-diasize-wndstore = true
     5215       then do:
     5216         if connected("ub") = true
     5217         then do:
     5218           define variable v-cntxt-db-num        as integer   no-undo .
     5219           define variable v-cntxt-userid        as character no-undo .
     5220           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5221                                             , OUTPUT v-cntxt-userid
     5222                                             ) .
     5223           run gbl/wndsizew.p
     5224             (input  v-cntxt-db-num
     5225             ,input  v-cntxt-userid
     5226             ,input  v-diasize-proc-name
     5227             ,input  'width':u
     5228             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5229             ) .
     5230         end.
     5231       end.
     5232     end.
     5233     assign
     5234       v-diasize-change-size = false
     5235     .
     5236   end procedure.
     5237   procedure diasize_set-width :
     5238     define input  parameter p-new-width  as decimal   no-undo .
     5239     define input  parameter p-move-resize as logical   no-undo .
     5240     do
     5241     on error undo, return error return-value
     5242     :
     5243       run diasize_change-width in this-procedure
     5244         (input  (p-new-width - frame Dialog-Frame :width)
     5245         ,input  p-move-resize
     5246         ) .
     5247     end.
     5248   end procedure.
     5249   procedure diasize_position-resize-button :
     5250     do with frame Dialog-Frame
     5251     :
     5252       hide v-diasize-resize-button .
     5253       assign
     5254         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5255                     - 1
     5256                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5257         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5258                     - 1
     5259                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5260       .
     5261       view v-diasize-resize-button .
     5262     end.
     5263   end procedure.
     5264   on alt-right anywhere
     5265   do:
     5266     run diasize_change-width in this-procedure
     5267       (input 1
     5268       ,input true
     5269       ) .
     5270     return no-apply .
     5271   end.
     5272   on alt-left anywhere
     5273   do:
     5274     run diasize_change-width in this-procedure
     5275       (input -1
     5276       ,input true
     5277       ) .
     5278     return no-apply .
     5279   end.
     5280   on alt-down anywhere
     5281   do:
     5282     run diasize_change-height in this-procedure
     5283       (input 1
     5284       ,input true
     5285       ) .
     5286     return no-apply .
     5287   end.
     5288   on alt-up anywhere
     5289   do:
     5290     run diasize_change-height in this-procedure
     5291       (input -1
     5292       ,input true
     5293       ) .
     5294     return no-apply .
     5295   end.
     5296   on alt-enter of frame Dialog-Frame
     5297   do:
     5298     run diasize_maximize in this-procedure
     5299       (input  ?
     5300       ).
     5301     return no-apply .
     5302   end.
     5303   procedure diasize_end-move :
     5304     do
     5305     on error undo, return error return-value
     5306     :
     5307       define variable v-row-delta as decimal   no-undo .
     5308       define variable v-col-delta as decimal   no-undo .
     5309       define variable v-new-row as decimal   no-undo .
     5310       define variable v-new-col as decimal   no-undo .
     5311       assign
     5312         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5313         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5314       .
     5315       assign
     5316         v-row-delta = v-new-row - frame Dialog-Frame :height
     5317         v-col-delta = v-new-col - frame Dialog-Frame :width
     5318       .
     5319       run diasize_change-height in this-procedure
     5320         (input v-row-delta
     5321         ,input true
     5322         ) .
     5323       run diasize_change-width in this-procedure
     5324         (input v-col-delta
     5325         ,input true
     5326         ) .
     5327     end.
     5328   end procedure.
     5329   procedure diasize_maximize :
     5330     define input  parameter p-action as logical   no-undo .
     5331     do
     5332     on error undo, return error return-value
     5333     :
     5334       if p-action = ?
     5335       then do:
     5336         if v-diasize-need-maximize = true
     5337         then do:
     5338           assign
     5339             p-action = true
     5340           .
     5341         end.
     5342         else do:
     5343           assign
     5344             p-action = false
     5345           .
     5346         end.
     5347       end.
     5348       if p-action = true
     5349       then do:
     5350         run diasize_change-height in this-procedure
     5351           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5352               - frame Dialog-Frame :height-chars
     5353           ,input true
     5354           ) .
     5355         run diasize_change-width in this-procedure
     5356           (input session :width-chars
     5357               - frame Dialog-Frame :width-chars
     5358           ,input true
     5359           ) .
     5360         assign
     5361           v-diasize-need-maximize = false
     5362         .
     5363       end.
     5364       else do:
     5365         run diasize_change-width in this-procedure
     5366           (input v-diasize-orig-frame-width
     5367               - frame Dialog-Frame :width-chars
     5368           ,input true
     5369           ) .
     5370         run diasize_change-height in this-procedure
     5371           (input v-diasize-orig-frame-height
     5372               - frame Dialog-Frame :height-chars
     5373           ,input true
     5374           ) .
     5375         assign
     5376           v-diasize-need-maximize = true
     5377         .
     5378       end.
     5379     end.
     5380   end procedure.
     5381   procedure diasize_restore-orig-size :
     5382     do
     5383     on error undo, return error return-value
     5384     :
     5385       assign
     5386         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5387         v-diasize-current-frame-height = frame Dialog-Frame :height
     5388       .
     5389       run diasize_set-height in this-procedure
     5390         (input  v-diasize-orig-frame-height
     5391         ,input  true
     5392         ) .
     5393       run diasize_set-width in this-procedure
     5394         (input  v-diasize-orig-frame-width
     5395         ,input  true
     5396         ) .
     5397     end.
     5398   end procedure.
     5399   procedure diasize_restore-current-size :
     5400     do
     5401     on error undo, return error return-value
     5402     :
     5403       run diasize_set-height in this-procedure
     5404         (input  v-diasize-current-frame-height
     5405         ,input  true
     5406         ) .
     5407       run diasize_set-width in this-procedure
     5408         (input  v-diasize-current-frame-width
     5409         ,input  true
     5410         ) .
     5411     end.
     5412   end procedure.
     5413   procedure diasize_set-browse-handle :
     5414     define input  parameter p-browse-handle as handle   no-undo .
     5415     define buffer buf_temp-browse-handle for temp-browse-handle .
     5416     do
     5417     on error undo, return error return-value
     5418     :
     5419       assign
     5420         v-diasize-browse-handle = p-browse-handle
     5421       .
     5422       for each buf_temp-browse-handle
     5423       on error undo, return error return-value
     5424       :
     5425         delete buf_temp-browse-handle .
     5426       end.
     5427     end.
     5428   end procedure.
     5429   procedure diasize_add_browse :
     5430     define input  parameter p-browse-type   as character no-undo .
     5431     define input  parameter p-browse-handle as handle    no-undo .
     5432     define buffer buf_temp-browse-handle for temp-browse-handle .
     5433     do
     5434     on error undo, return error return-value
     5435     :
     5436       assign
     5437         v-diasize-browse-number = v-diasize-browse-number + 1
     5438       .
     5439       create buf_temp-browse-handle .
     5440       assign
     5441         buf_temp-browse-handle.browse-type   = p-browse-type
     5442         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5443         buf_temp-browse-handle.browse-handle = p-browse-handle
     5444       .
     5445     end.
     5446   end procedure.
     5447   procedure diasize_init :
     5448     define variable v-default-value    as logical   no-undo .
     5449     define variable v-restore-saved    as logical   no-undo .
     5450     define variable v-resize-value-str as character no-undo .
     5451     do
     5452     on error undo, return error return-value
     5453     :
     5454       do with frame Dialog-Frame
     5455       :
     5456         assign
     5457           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5458           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5459           v-diasize-browse-handle     = browse br-list :handle
     5460         .
     5461         create button v-diasize-resize-button
     5462         assign
     5463           parent        = frame Dialog-Frame :first-child
     5464           label         = "s"
     5465           height-pixels = 16
     5466           width-pixels  = 16
     5467           visible       = true
     5468           sensitive     = true
     5469           movable       = true
     5470           triggers:
     5471             on end-move persistent run diasize_end-move in this-procedure .
     5472           end triggers.
     5473         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5474         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5475         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5476         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5477         assign
     5478           v-diasize-wndmax = false
     5479         .
     5480         if connected("ub") = true
     5481         then do:
     5482           define variable v-cntxt-db-num        as integer   no-undo .
     5483           define variable v-cntxt-userid        as character no-undo .
     5484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5485                                             , OUTPUT v-cntxt-userid
     5486                                             ) .
     5487           run gbl/wndpar_r.p
     5488             (input  v-cntxt-db-num
     5489             ,input  v-cntxt-userid
     5490             ,input  'wndmax':U
     5491             ,output v-diasize-wndmax
     5492             ,output v-default-value
     5493             ) .
     5494         end.
     5495         assign
     5496           v-diasize-wndstore = false
     5497         .
     5498         if connected("ub") = true
     5499         then do:
     5500           run gbl/wndpar_r.p
     5501             (input  v-cntxt-db-num
     5502             ,input  v-cntxt-userid
     5503             ,input  'wndstore':U
     5504             ,output v-diasize-wndstore
     5505             ,output v-default-value
     5506             ) .
     5507         end.
     5508         assign
     5509           v-diasize-proc-name = entry(1, program-name(2), '.')
     5510         .
     5511         if v-diasize-wndstore = true
     5512         then do:
     5513           assign
     5514             v-restore-saved = false
     5515           .
     5516           if connected("ub") = true
     5517           then do:
     5518             run gbl/wndsizer.p
     5519               (input  v-cntxt-db-num
     5520               ,input  v-cntxt-userid
     5521               ,input  v-diasize-proc-name
     5522               ,input  'height':u
     5523               ,output v-resize-value-str
     5524               ) .
     5525             if v-resize-value-str <> '':U
     5526             then do:
     5527               run diasize_change-height in this-procedure
     5528                 (input  integer(v-resize-value-str)
     5529                 ,input  true
     5530                 ) .
     5531               assign
     5532                 v-restore-saved = true
     5533               .
     5534             end.
     5535           end.
     5536           if connected("ub") = true
     5537           then do:
     5538             run gbl/wndsizer.p
     5539               (input  v-cntxt-db-num
     5540               ,input  v-cntxt-userid
     5541               ,input  v-diasize-proc-name
     5542               ,input  'width':u
     5543               ,output v-resize-value-str
     5544               ) .
     5545             if v-resize-value-str <> '':U
     5546             then do:
     5547               run diasize_change-width in this-procedure
     5548                 (input  integer(v-resize-value-str)
     5549                 ,input  true
     5550                 ) .
     5551               assign
     5552                 v-restore-saved = true
     5553               .
     5554             end.
     5555           end.
     5556           if v-restore-saved <> true
     5557           then do:
     5558             if v-diasize-wndmax = true
     5559             then do:
     5560               run diasize_maximize in this-procedure
     5561                 (input  true
     5562                 ) .
     5563             end.
     5564           end.
     5565         end.
     5566         else do:
     5567           if v-diasize-wndmax = true
     5568           then do:
     5569             run diasize_maximize in this-procedure
     5570               (input  true
     5571               ) .
     5572           end.
     5573         end.
     5574       end.
     5575     end.
     5576   end procedure.
     5577   procedure diasize_need-full-display :
     5578     define output parameter p-need-full-display as logical   no-undo .
     5579     do
     5580     on error undo, return error return-value
     5581     :
     5582       assign
     5583         p-need-full-display = v-diasize-need-full-display
     5584       .
     5585       assign
     5586         v-diasize-need-full-display = false
     5587       .
     5588     end.
     5589   end procedure.
     5590   procedure get-context :
     5591      define output parameter p-db-num as integer          no-undo.
     5592      define output parameter p-user-id as character        no-undo.
     5593      define variable v-login               as character    no-undo.
     5594      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5595      define buffer buf_user-login  for ub.user-login .
     5596      do
     5597      on error undo, return error
     5598      :
     5599            FIND FIRST buf_sys-ctrl no-lock.
     5600            ASSIGN
     5601               v-login = USERID("ub")
     5602               p-db-num = buf_sys-ctrl.db-num
     5603            .
     5604            FIND FIRST buf_user-login
     5605                 WHERE buf_user-login.db-num = p-db-num
     5606                   AND buf_user-login.user-login = v-login
     5607                 no-lock
     5608                 no-error
     5609                 .
     5610            IF AVAILABLE buf_user-login
     5611            THEN DO:
     5612               assign
     5613                  p-user-id = buf_user-login.user-id
     5614               .
     5615            END.
     5616      end.
     5617   end procedure.
     5618   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5619   def var vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5620   define variable v-no-context as logical no-undo .
     5621   define variable v-user-obj-type as character no-undo .
     5622   define variable v-user-obj-code as integer no-undo .
     5623   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5624                                            , input p-no-context as logical ):
     5625   define variable v-uniq-key-rec as character no-undo .
     5626   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5627     v-uniq-key-rec = 'clients':U + chr(3) +
     5628                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5629                     entry(5, p-uniq-key-rec, chr(3)).
     5630   end.
     5631   else do:
     5632     v-uniq-key-rec = p-uniq-key-rec.
     5633     case entry(1, p-uniq-key-rec, chr(3)):
     5634        when 'user-obj':U then do:
     5635          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5636          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5637        end.
     5638     end case.
     5639   end.
     5640   return v-uniq-key-rec.
     5641   end function.
     5642   procedure find-user-obj-rowid :
     5643   define input parameter p-rowid as rowid no-undo .
     5644   define input parameter p-no-context as logical no-undo .
     5645   define output parameter p-user-obj-type as character no-undo .
     5646   define output parameter p-user-obj-code as integer no-undo .
     5647   define buffer user-obj_clients for ub.clients.
     5648   define buffer user-obj_user-obj for ub.user-obj .
     5649   if p-no-context then do:
     5650     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5651     assign
     5652     p-user-obj-type = user-obj_clients.obj-type
     5653     p-user-obj-code = user-obj_clients.obj-code.
     5654   end.
     5655   else do:
     5656     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5657     if not available user-obj_user-obj then do:
     5658       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5659     end.
     5660     assign
     5661     p-user-obj-type = user-obj_user-obj.obj-type
     5662     p-user-obj-code = user-obj_user-obj.obj-code.
     5663   end.
     5664   end procedure.
     5665   define variable an-listp-start-macro-id as integer no-undo init ?.
     5666   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5667   define variable an-listp-macros-label-id as integer   no-undo .
     5668   define variable v-macro-is-running as logical no-undo .
     5669   define variable v-current-step as integer no-undo .
     5670   define variable v-expand as logical no-undo .
     5671   define variable v-downed as character no-undo .
     5672   define variable p-title as character no-undo .
     5673   define variable bttns as character no-undo .
     5674   define variable p-keep-query as logical no-undo .
     5675   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5676   define     temp-table keep-macro-list-hist no-undo
     5677   field list-table as character
     5678   field id as integer
     5679   field line as integer
     5680   field hist-mode as character
     5681   field des as character
     5682   field num-recs as integer
     5683   field option_ as character
     5684   field item_ as character
     5685   field status_ as character
     5686   field num-add as integer
     5687   field num-ignored as integer
     5688   field done as logical
     5689   field err_ as logical
     5690   field err-mes as character
     5691   index pi is primary
     5692   id
     5693   line
     5694   index isdone
     5695   done
     5696   .
     5697   procedure assign-nums :
     5698   define input-output parameter p-num-add as integer no-undo .
     5699   define input-output parameter p-num-rec as integer no-undo .
     5700   define input-output parameter p-num-ignored as integer no-undo .
     5701   define input parameter p-line-mode as character no-undo .
     5702   assign
     5703   p-num-add  = lns-cnt - v-num-add
     5704   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5705                             then (tot-lns + p-num-add)
     5706                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5707   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5708   p-num-ignored = lns-ignore  - v-num-ignored
     5709   v-num-add             = lns-cnt
     5710   v-num-ignored         = lns-ignore
     5711   .
     5712   END PROCEDURE.
     5713   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5714   or INSERT-MODE of br-list
     5715   DO:
     5716   define variable glog as logical no-undo .
     5717   define buffer buf-gds-list-flt-hist for gds-list-flt-hist.
     5718   define buffer buf_macro-list-hist for macro-list-hist.
     5719   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5720    if p-keep-query then do:
     5721       glog = no.
     5722       message "Реинициализация списка. Вы уверены ?"
     5723               view-as alert-box question buttons OK-Cancel update glog.
     5724       if not glog then return no-apply.
     5725       if session:set-wait-state( "COMPILER" )  then .
     5726       for each gds-list-flt:
     5727         delete gds-list-flt.
     5728       end.
     5729       if session:set-wait-state( "" )  then .
     5730       tot-lns = 0.
     5731       v-seq = 1.
     5732       for each buf-gds-list-flt-hist:
     5733         delete buf-gds-list-flt-hist.
     5734       end.
     5735      for each buf_keep-macro-list-hist:
     5736        create buf_macro-list-hist.
     5737      end.
     5738      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5739      run create-gds-list-flt-hist in this-procedure (
     5740                                             input 'ДОБАВЛЕНИЕ':U
     5741                                           , input-output v-seq
     5742                                           , input 0
     5743                                           , input '0':U
     5744                                           , input "# Реинициализация списка."
     5745                                           , input 0
     5746                                           , input "init"
     5747                                           , input '':U
     5748                                           , input '':U
     5749                                           , input '':U
     5750                                           , input ?
     5751                                           ).
     5752       display
     5753       tot-lns @ f-tot-lns
     5754       ? @ ub.clients.obj-name
     5755       ? @ ub.gds-prt.node-name
     5756       ? @ ub.bar-code.b-code
     5757       with frame Dialog-Frame.
     5758       run ui-on in this-procedure .
     5759    end.
     5760    else do:
     5761      assign rs-list-method = "single".
     5762      run proc-b-add in this-procedure(input no
     5763                                     ,input ?
     5764                                     ,input rs-list-method
     5765                                     ,input rs-status)  no-error .
     5766     if error-status:error then return no-apply.
     5767   end.
     5768   END.
     5769   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5770   or DELETE-CHARACTER of br-list
     5771   DO:
     5772     if not available gds-list-flt then return no-apply.
     5773     assign rs-list-method = "single".
     5774       run proc-b-del in this-procedure(
     5775                                                  input no
     5776                                                 ,input ?
     5777                                                 ,input rs-list-method
     5778                                                 ,input rs-status) no-error .
     5779     if error-status:error then return no-apply.
     5780   END.
     5781   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5782   DO:
     5783   if not available gds-list-flt then return no-apply.
     5784     assign rs-list-method = "single".
     5785    run proc-b-rest in this-procedure(
     5786                                                   input no
     5787                                                  ,input ?
     5788                                                  ,input rs-list-method
     5789                                                  ,input rs-status) no-error .
     5790     if error-status:error then return no-apply.
     5791   END.
     5792   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5793     assign
     5794     macro-play-option = 'file':U.
     5795     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5796   end.
     5797   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5798     assign
     5799     macro-play-option = 'lob':U.
     5800     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5801   end.
     5802   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5803   DO:
     5804   if macro-play-option = '':U then do:
     5805         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5806   end.
     5807   if macro-play-option = '':U then return no-apply.
     5808   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5809   if error-status:error then return no-apply.
     5810   END.
     5811   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5812   DO:
     5813   define variable glog as logical no-undo .
     5814   message
     5815   "Начать запись макроса формирования списка?"
     5816   view-as alert-box QUESTION buttons yes-no update glog.
     5817   if not glog then return no-apply.
     5818   assign
     5819   an-listp-start-macro-id = v-seq
     5820   an-listp-end-macro-id = ?
     5821   .
     5822     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     5823     menu-item m-macro-lob:sensitive in menu m-play = no.
     5824   disable
     5825   b-record with frame Dialog-Frame .
     5826   hide
     5827   b-record
     5828   b-macro
     5829   in frame Dialog-Frame .
     5830   enable
     5831   b-stop with frame Dialog-Frame .
     5832   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5833                                       , input-output v-seq
     5834                                       , input 0
     5835                                       , input 'o':U
     5836                                       , input "Начата запись макроса формирования списка"
     5837                                       , input tot-lns
     5838                                       , input 'macro':U
     5839                                       , input '':U
     5840                                       , input '':U
     5841                                       , input '':U
     5842                                       , input ?
     5843                                       ).
     5844   END.
     5845   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5846   DO:
     5847   define variable glog as logical no-undo .
     5848   define variable v-id as integer no-undo .
     5849   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     5850   message
     5851   "Закончить запись макроса формирования списка?"
     5852   view-as alert-box QUESTION buttons yes-no update glog.
     5853   if not glog then return no-apply.
     5854   assign
     5855   an-listp-end-macro-id = v-seq.
     5856   disable
     5857   b-stop with frame Dialog-Frame .
     5858   hide
     5859   b-stop in frame Dialog-Frame .
     5860   enable
     5861   b-record
     5862   b-macro
     5863   with frame Dialog-Frame .
     5864   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5865                                       , input-output v-seq
     5866                                       , input 0
     5867                                       , input '[]':U
     5868                                       , input "Закончена запись макроса формирования списка"
     5869                                       , input tot-lns
     5870                                       , input 'macro':U
     5871                                       , input '':U
     5872                                       , input '':U
     5873                                       , input '':U
     5874                                       , input ?
     5875                                       ).
     5876   for each macro-list-hist:
     5877     delete macro-list-hist.
     5878   end.
     5879   for each buf_gds-list-flt-hist where
     5880           buf_gds-list-flt-hist.id >=  an-listp-start-macro-id
     5881     and  buf_gds-list-flt-hist.id <=  an-listp-end-macro-id:
     5882     create macro-list-hist.
     5883     buffer-copy buf_gds-list-flt-hist
     5884     except id num-recs num-add num-ignored
     5885     to macro-list-hist
     5886     assign
     5887     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5888     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5889     .
     5890   end.
     5891   END.
     5892   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5893   DO:
     5894   disable
     5895   b-clear-macro with frame Dialog-Frame .
     5896   assign
     5897   an-listp-start-macro-id = ?
     5898   an-listp-end-macro-id = ?
     5899   an-listp-macros-label-id = 0
     5900   .
     5901   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5902   for each macro-list-hist:
     5903     delete macro-list-hist.
     5904   end.
     5905   hide
     5906   b-clear-macro in frame Dialog-Frame .
     5907   enable
     5908   b-record
     5909   b-macro
     5910   with frame Dialog-Frame .
     5911   END.
     5912   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5913   DO:
     5914     assign
     5915     Rs-list-method = temp-list.fvalue
     5916     .
     5917     run proc-vc-rs-list-method in this-procedure no-error .
     5918     if error-status:error then return no-apply.
     5919   END.
     5920   PROCEDURE get-operation :
     5921   define input parameter p-message as character no-undo .
     5922   define output parameter p-operation as integer no-undo .
     5923     do
     5924     on error undo, return error
     5925     :
     5926       run gbl/d-askw.w (
     5927                     input "Выбор операции над заданным списком"
     5928                    ,input (p-message + chr(10) +
     5929                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5930                    ,input "|"
     5931                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5932                            "Удалить" + "|" +
     5933                            "Оставить" + "|" +
     5934                            "Отказ")
     5935                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5936                           "Удалить полученный список из уже имеющегося" + "|" +
     5937                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5938                           "Ничего не делать")
     5939                    ,input  (if p-keep-query then 2 else 1)
     5940                    ,input  4
     5941                    ,output p-operation).
     5942      if p-operation = 4 then do:
     5943         return error .
     5944      end.
     5945     end.
     5946   END PROCEDURE.
