     6760   HIDE FRAME Dialog-Frame.
     6761   PROCEDURE UI-on:
     6762   define variable v-recid0 as recid no-undo.
     6763   define variable v-start as logical no-undo .
     6764   define buffer buf_temp-list for temp-list.
     6765   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     6766     find first buf_gds-list-flt-hist where buf_gds-list-flt-hist.id = 0 no-error.
     6767     if available buf_gds-list-flt-hist then
     6768     assign
     6769     frame Dialog-Frame:title = substitute("СПИСОК  ТОВАРОВ &1",  string(buf_gds-list-flt-hist.des, "X(60)"))
     6770     .
     6771     if tot-lns = ? then do:
     6772       v-start = yes.
     6773       for each l-gds-list-flt :
     6774         accumulate l-gds-list-flt.artic (count).
     6775       end.
     6776       tot-lns = (accum count l-gds-list-flt.artic).
     6777       if tot-lns > 0 then do:
     6778         find last  buf_gds-list-flt-hist no-error .
     6779         v-seq = (if available buf_gds-list-flt-hist then buf_gds-list-flt-hist.id else 0)  + 1.
     6780         run create-gds-list-flt-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6781                                              , input-output v-seq
     6782                                              , input 0
     6783                                              , input 'S':U
     6784                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6785                                              , input tot-lns
     6786                                              , input "start":U
     6787                                              , input '':U
     6788                                              , input '':U
     6789                                              , input '':U
     6790                                              , input ?
     6791                                              ).
     6792       end.
     6793       else do:
     6794         line-mode = 'ДОБАВЛЕНИЕ':U.
     6795         for each buf_gds-list-flt-hist:
     6796           delete buf_gds-list-flt-hist.
     6797         end.
     6798         v-seq = 1.
     6799         run create-gds-list-flt-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6800                                              , input-output v-seq
     6801                                              , input 0
     6802                                              , input '':U
     6803                                              , input "# Исходный список товаров пуст."
     6804                                              , input tot-lns
     6805                                              , input 'start':U
     6806                                              , input '':U
     6807                                              , input '':U
     6808                                              , input '':U
     6809                                              , input ?
     6810                                              ).
     6811       end.
     6812     end.
     6813     hide loc-art in frame Dialog-Frame loc-name loc-code in frame Dialog-Frame.
     6814     assign
     6815     loc-art = ""
     6816     RS-list-method = "single"
     6817     .
     6818     find first buf_temp-list no-lock where
     6819                buf_temp-list.fvalue = rs-list-method.
     6820     assign
     6821     v-recid0 = recid(buf_temp-list).
     6822     open query br-option for each temp-list no-lock .
     6823     if v-seq > 1 then
     6824     find last buf_gds-list-flt-hist no-lock where
     6825               buf_gds-list-flt-hist.id = (v-seq - 1)
     6826          and  buf_gds-list-flt-hist.line = 0 no-error .
     6827     DISPLAY br-option
     6828     (if available buf_gds-list-flt-hist
     6829     then buf_gds-list-flt-hist.des
     6830     else '') @ dsp-rs
     6831     RS-Status WITH FRAME Dialog-Frame.
     6832     ENABLE
     6833     b-macro  when v-start
     6834     b-record when v-start
     6835     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6836     if v-start then do:
     6837       hide
     6838       b-sel
     6839       b-mark
     6840       b-stop
     6841       b-clear-macro
     6842       in frame Dialog-Frame.
     6843       if lookup("b-sel", bttns) > 0
     6844       or lookup("b-mark", bttns) > 0
     6845       then do:
     6846         gds-list-flt.to-sel:visible in browse br-list = yes.
     6847       end.
     6848       else do:
     6849         gds-list-flt.to-sel:visible in browse br-list = no.
     6850       end.
     6851       if bttns <> '':U then do:
     6852         run proc-expand in this-procedure ( input 1, input b-sel:row, input br-list:row, input "b-sel,b-mark").
     6853       end.
     6854     end.
     6855     v-start = no.
     6856     if is-tsd = no then do:
     6857       menu-item m-scn-save:sensitive in menu m-save = no.
     6858     end.
     6859     reposition br-option to recid v-recid0.
     6860     if tot-lns > 0 then do:
     6861       Enable b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6862       b-mark when lookup("b-mark", bttns) > 0
     6863       b-sel  when lookup("b-sel", bttns) > 0
     6864       WITH FRAME Dialog-Frame.
     6865     end.
     6866     else do:
     6867       DISABLE b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6868       b-mark b-sel
     6869       WITH FRAME Dialog-Frame.
     6870     end.
     6871     open query br-list for each gds-list-flt no-lock indexed-reposition.
     6872     if line-rec <> ? then
     6873       reposition br-list to recid line-rec no-error.
     6874     apply "entry" to br-list in frame Dialog-Frame.
     6875     if available gds-list-flt then do:     find ub.clients where ub.clients.obj-type = gds-list-flt.prod-type                    and ub.clients.obj-code = gds-list-flt.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list-flt.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list-flt.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list-flt.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     6876   END PROCEDURE.
     6877   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6878   PROCEDURE ex-gds :
     6879       define parameter buffer buf_goods for ub.goods.
     6880       define input parameter rs-list-method as character no-undo .
     6881       define input parameter rs-status as character no-undo .
     6882       define input parameter line-mode as character no-undo .
     6883       if rs-list-method = "single":U or
     6884           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
     6885           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
     6886       do:
     6887           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
     6888           do:
     6889               if rs-list-method = "tsd":U then
     6890               do:
     6891                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6892                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6893                       find first gds-list-flt where gds-list-flt.artic = buf_goods.artic
     6894                           and gds-list-flt.prod-type = buf_goods.prod-type
     6895                           and gds-list-flt.prod-code = buf_goods.prod-code no-error.
     6896                       if available gds-list-flt then
     6897                       do:
     6898                           if line-mode = 'удаление':U then
     6899                           do:
     6900                               lns-cnt = lns-cnt + 1.
     6901                               delete gds-list-flt.
     6902                           end.
     6903                           else
     6904                           do:
     6905                               if gds-list-flt.to-del = ? then.
     6906                               else
     6907                               do:
     6908                                   lns-cnt = lns-cnt + 1.
     6909                                   gds-list-flt.to-del = ?.
     6910                               end.
     6911                           end.
     6912                       end.
     6913                   end.
     6914               end.
     6915               else
     6916               do:
     6917                   find first gds-list-flt where gds-list-flt.artic = buf_goods.artic
     6918                       and gds-list-flt.prod-type = buf_goods.prod-type
     6919                       and gds-list-flt.prod-code = buf_goods.prod-code no-error.
     6920                   if available gds-list-flt then
     6921                   do:
     6922                       if line-mode = 'удаление':U then
     6923                       do:
     6924                           lns-cnt = lns-cnt + 1.
     6925                           delete gds-list-flt.
     6926                       end.
     6927                       else
     6928                       do:
     6929                           if gds-list-flt.to-del = ? then.
     6930                           else
     6931                           do:
     6932                               lns-cnt = lns-cnt + 1.
     6933                               gds-list-flt.to-del = ?.
     6934                           end.
     6935                       end.
     6936                   end.
     6937               end.
     6938           end.
     6939           else
     6940               if line-mode = 'ДОБАВЛЕНИЕ':U then
     6941               do:
     6942   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6943   find gds-list-flt
     6944     where gds-list-flt.prod-type = buf_goods.prod-type
     6945       and gds-list-flt.prod-code = buf_goods.prod-code
     6946       and gds-list-flt.artic     = buf_goods.artic
     6947     no-error .
     6948   if available gds-list-flt then do:
     6949     assign
     6950       gds-list-flt.to-del = no
     6951     .
     6952   end.
     6953   else do:
     6954     define variable v-last49 as integer no-undo .
     6955     find last gds-list-flt use-index oi no-error.
     6956     if available gds-list-flt then do:
     6957       v-last49 = gds-list-flt.order-num .
     6958     end.
     6959     else do:
     6960       v-last49 = 0 .
     6961     end.
     6962     create gds-list-flt .
     6963     buffer-copy buf_goods to gds-list-flt
     6964     assign
     6965       gds-list-flt.to-del = no
     6966       gds-list-flt.order-num = v-last49 + 1
     6967     .
     6968     assign
     6969       lns-cnt = lns-cnt + 1
     6970       line-rec = recid (gds-list-flt)
     6971     .
     6972   end.
     6973                   if rs-list-method = "tsd":U  then
     6974                   do:
     6975                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6976                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6977                           find first gds-list-flt where gds-list-flt.gds-code = buf_goods.gds-code no-error.
     6978                           if available gds-list-flt then
     6979                           do:
     6980                               gds-list-flt.qnty = decimal(ub.Code.CodeValue) .
     6981                           end.
     6982                       end.
     6983                   end.
     6984               end.
     6985           if lns-cnt modulo 25 = 0 then
     6986               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     6987       end.
     6988       else
     6989           assign
     6990               lns-ignore = lns-ignore + 1
     6991               .
     6992   end.
     6993   PROCEDURE rs-do:
     6994   define input parameter p-from-macro as logical no-undo .
     6995   define input parameter p-step as logical no-undo .
     6996   define input parameter rs-list-method as character no-undo .
     6997   define input parameter rs-status as character no-undo .
     6998   define input parameter line-mode as character no-undo .
     6999   define input parameter p-id      as integer no-undo .
     7000   define variable grp-path like ub.goods.grp-name no-undo.
     7001   define variable another-price like ub.price-list.price-sale no-undo.
     7002   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7003   define variable v-rowid   as rowid no-undo .
     7004   define variable v-tbl-name as character no-undo .
     7005   define variable v-discnt-role as character no-undo .
     7006   define variable v-nonunique as character no-undo .
     7007   define variable vvalue-int as integer no-undo .
     7008   define variable glog as logical no-undo .
     7009   define variable v-date-chr as character no-undo .
     7010   define variable v-date as date no-undo .
     7011   define buffer buf_gds-list-flt-hist for gds-list-flt-hist.
     7012   define buffer buf_user-obj for ub.user-obj.
     7013   define buffer buf_units for ub.units.
     7014   define buffer buf_parts for ub.parts.
     7015   do
     7016   on error undo, return error return-value
     7017   :
     7018   assign
     7019   lns-cnt = 0
     7020   lns-ignore = 0
     7021   v-num-add     = 0
     7022   v-num-ignored = 0
     7023   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7024   .
     7025   run write-hist in this-procedure ( input p-from-macro
     7026                                     ,input rs-list-method
     7027                                     ,input rs-status
     7028                                     ,input line-mode).
     7029   if session:set-wait-state( "COMPILER" )  then .
