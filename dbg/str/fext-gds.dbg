    10392         CASE v-operation:
    10393           when 1 then do:
    10394             run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
    10395           end.
    10396           when 2 then do:
    10397             run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ) no-error  .
    10398           end.
    10399           when 3 then do:
    10400             run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
    10401           end.
    10402           otherwise do:
    10403             assign
    10404             dsp-rs = "":U.
