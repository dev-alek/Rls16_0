     3989   PROCEDURE proc-valchg-a-n-c:
     3990     case input frame Dialog-Frame a-n-c :
     3991       when "art" then do:
     3992         apply "entry" to br-list in frame Dialog-Frame.
     3993         hide loc-name loc-code
     3994         in frame Dialog-Frame.
     3995         loc-art = "".
     3996       end.
     3997       when "name" then do:
     3998         enable loc-name with frame Dialog-Frame.
     3999         disp loc-name with frame Dialog-Frame.
     4000         hide loc-art loc-code
     4001         in frame Dialog-Frame.
     4002         apply "entry" to loc-name in frame Dialog-Frame.
     4003       end.
     4004       when "code"
     4005    or when "DataMatrix" then
     4006       do:
     4007         enable loc-code with frame Dialog-Frame.
     4008         disp loc-code with frame Dialog-Frame.
     4009         hide loc-art loc-name
     4010         in frame Dialog-Frame.
     4011         apply "entry" to loc-code in frame Dialog-Frame.
     4012       end.
     4013     end CASE.
     4014   END PROCEDURE.
     4015   PROCEDURE proc-any-printable-br-list :
     4016     if input frame Dialog-Frame a-n-c = "art" then do:
     4017       if last-event:label = " " and
     4018          loc-art = "" then
     4019       return error.
     4020       find first l-gds-list-flt where
     4021                   l-gds-list-flt.artic begins (loc-art + last-event:label)
     4022                  no-lock no-error.
     4023       if available l-gds-list-flt then do:
     4024         loc-art = loc-art + last-event:label.
     4025         disp loc-art with frame Dialog-Frame.
     4026         line-rec = recid (l-gds-list-flt).
     4027         reposition br-list to recid line-rec no-error.
     4028       end.
     4029     end.
     4030   END PROCEDURE.
     4031   PROCEDURE proc-backspace-br-list:
     4032     if input frame Dialog-Frame a-n-c = "art" then do:
     4033       if loc-art = "" then
     4034         return error.
     4035       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4036       find first l-gds-list-flt where
     4037                   l-gds-list-flt.artic begins loc-art
     4038                  no-lock.
     4039       disp loc-art with frame Dialog-Frame.
     4040       line-rec = recid (l-gds-list-flt).
     4041       reposition br-list to recid line-rec no-error.
     4042     end.
     4043   END PROCEDURE.
     4044   PROCEDURE proc-mouse-dbl-click-loc-code:
     4045   def var str-code as integer no-undo.
     4046   define variable varresult   as character         no-undo.
     4047   define variable vartype-bc  as character         no-undo.
     4048   define variable varweight   as decimal           no-undo.
     4049   define buffer l-goods for ub.goods.
     4050   define buffer l-bar-code for ub.bar-code.
     4051   define buffer buf_bar-code for ub.bar-code .
     4052   define buffer buf_prod-bc for ub.prod-bc.
     4053   define buffer buf_place for ub.place.
     4054     assign
     4055     frame Dialog-Frame
     4056     loc-code
     4057     a-n-c.
     4058     if a-n-c = "datamatrix"
     4059     then do:
     4060   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4061   (
     4062    input  parparentproc
     4063   ,input  loc-code
     4064   ,input  ?
     4065   ,input  p-curr-obj-type
     4066   ,input  p-curr-obj-code
     4067   ,input  yes
     4068   ,input  no
     4069   ,input  varscales-pref31
     4070   ,input  varpgscales-pref31
     4071   ,output varresult
     4072   ,output vartype-bc
     4073   ,output varweight
     4074   ,buffer buf_bar-code
     4075   ,buffer buf_prod-bc
     4076   ,buffer buf_place
     4077   ) no-error.
     4078        if varresult eq "prod-bc"
     4079        then
