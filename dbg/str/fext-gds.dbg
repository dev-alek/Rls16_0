    11130       dsp-rs = substitute("Партии свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    11131       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    11132       .
    11133     end.
    11134   END CASE.
    11135   v-no-hist = 0.
    11136   run create-gds-list-flt-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
