      231   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   FUNCTION get-region RETURNS CHARACTER
      233     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      234     define variable par-region as character no-undo.
      235     if parhost-code = 0 and
      236          parobj-type = "":U and
      237          parobj-code = 0 then do:
      238          par-region = "Глобально".
      239          return par-region.
      240       end.
      241       if parobj-type = 'орг':U then do:
      242          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      243          return par-region.
      244       end.
      245       if parobj-type = 'регион':U
      246       then do:
      247          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      248          return par-region.
      249       end.
      250       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      251       return par-region.
      252   END FUNCTION.
      253   FUNCTION get-objregion RETURNS CHARACTER
      254     (  input parobj-type as character, input parobj-code as integer ) :
      255     define variable par-region as character no-undo.
      256     if  parobj-type = "":U and
      257         parobj-code = 0
      258     then do:
      259        par-region = "Глобально".
      260     end.
      261     else if parobj-type = 'орг':U
      262     then do:
      263        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      264     end.
      265     else if parobj-type = 'регион':U
      266     then do:
      267        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      268     end.
      269     else
      270        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      271     return par-region.
      272   END FUNCTION.
