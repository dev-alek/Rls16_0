     1648   procedure prn-lib-reportviewer :
     1649     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1650     define input parameter p-report-name-html as character no-undo .
     1651     define input parameter p-param        as character no-undo .
     1652     define variable v-excel           as character no-undo init 'TRUE' .
     1653     define variable v-value-character as character no-undo .
     1654     define variable v-value-integer   as character no-undo .
     1655     define variable v-value-date      as date      no-undo .
     1656     define variable v-value-decimal   as decimal   no-undo .
     1657     define variable rep-excel         as logical   no-undo .
     1658     define variable excel-string      as character no-undo .
     1659     define variable v-param-type      as character no-undo .
     1660     define variable v-tth             as handle    no-undo .
     1661     run adm/shattri.p (
     1662       input "get":U
     1663       ,input  ""
     1664       ,input  0
     1665       ,input  'report-glob':U
     1666       ,input  'rep-excel':U
     1667       ,output v-value-character
     1668       ,output v-value-date
     1669       ,output v-value-decimal
     1670       ,output v-value-integer
     1671       ,output rep-excel
     1672       ,output v-param-type
     1673       ,INPUT-OUTPUT table-handle v-tth
     1674       )  .
     1675     if rep-excel then v-excel = "TRUE" .
     1676     else v-excel = "FALSE" .
     1677     if p-param eq ""
     1678     then
     1679        p-param = "EXCEL:" + v-excel.
     1680     else
     1681        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1682     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1683   end procedure.
