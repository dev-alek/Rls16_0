    11118       + 'fillin_col=4\':u
    11119       + 'fillin_width=20\':u
    11120       + 'fillin_height=1\':u
    11121       + 'max-chars=70\':u
    11122       + 'readonly=' +  'no':u + '\':u)
    11123       , input-output v-value-integer
    11124       , output v-ok
    11125           ).
    11126   if not v-ok then return error.
    11127   CASE rs-list-method:
