        1   define input  parameter paruser-id   as character no-undo .
        2   define input  parameter parl-type    as character no-undo .
        3   define output parameter parobj-type  as character no-undo .
        4   define output parameter parobj-code  as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Выбор объекта для экрана покупателя".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define temp-table userobjs_temp-user-obj no-undo
      118     field obj-type as character
      119     field obj-code as integer
      120     index xpk is primary unique obj-type obj-code
      121     .
      122   procedure userobjs_clear :
      123     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      124     do
      125     on error undo, return error return-value
      126     :
      127       for each buf_userobjs_temp-user-obj
      128       on error undo, return error return-value
      129       :
      130         delete buf_userobjs_temp-user-obj .
      131       end.
      132     end.
      133   end .
      134   procedure userobjs_object-count :
      135     define output parameter p-total-count as integer   no-undo .
      136     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      137     do
      138     on error undo, return error return-value
      139     :
      140       assign
      141         p-total-count = 0
      142       .
      143       for each buf_userobjs_temp-user-obj
      144       on error undo, return error return-value
      145       :
      146         assign
      147           p-total-count = p-total-count + 1
      148         .
      149       end.
      150     end.
      151   end.
      152   procedure userobjs_append :
      153      define input  parameter p-obj-type as character no-undo .
      154      define input  parameter p-obj-code as integer   no-undo .
      155     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      156     do
      157     on error undo, return error return-value
      158     :
      159       find first buf_userobjs_temp-user-obj
      160         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      161           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      162         no-error .
      163       if not available buf_userobjs_temp-user-obj
      164       then do:
      165         create buf_userobjs_temp-user-obj .
      166         assign
      167           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      168           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      169         .
      170       end.
      171     end.
      172   end.
      173   procedure userobjs_object-exist :
      174     define output parameter p-object-exist as logical   no-undo .
      175     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      176     do
      177     on error undo, return error return-value
      178     :
      179       find first buf_userobjs_temp-user-obj
      180         no-error .
      181       if not available buf_userobjs_temp-user-obj
      182       then do:
      183         assign
      184           p-object-exist = false
      185         .
      186       end.
      187       else do:
      188         assign
      189           p-object-exist = true
      190         .
      191       end.
      192     end.
      193   end.
      194   procedure userobjs_transfer :
      195     define input  parameter p-callback-handle as handle no-undo .
      196     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      197     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      198     do
      199     on error undo, return error return-value
      200     :
      201       if valid-handle(p-callback-handle) <> true
      202       then do:
      203         message
      204           vss-workfile vss-revision vss-description skip
      205           "Ошибка задания входных параметров" skip
      206           "Неизвестный указатель на процедуру" skip
      207           view-as alert-box error .
      208         undo, return error return-value .
      209       end.
      210       if p-callback-handle :get-signature("userobjs_append") = ""
      211       then do:
      212         message
      213           vss-workfile vss-revision vss-description skip
      214           "Ошибка задания входных параметров" skip
      215           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      216                     ,p-callback-handle :file-name
      217                     ) skip
      218           view-as alert-box error .
      219         undo, return error return-value .
      220       end.
      221       for each buf_userobjs_temp-user-obj
      222       on error undo, return error return-value
      223       :
      224         run userobjs_append in p-callback-handle
      225           (input  buf_userobjs_temp-user-obj.obj-type
      226           ,input  buf_userobjs_temp-user-obj.obj-code
      227           ) .
      228       end.
      229     end.
      230   end procedure.
      231   procedure userobjs_select-one :
      232      define input  parameter parparentproc     as widget-handle no-undo .
      233      define input  parameter p-db-num          as integer   no-undo .
      234      define input  parameter p-user-id         as character no-undo .
      235      define input  parameter p-host-code-obj   as integer   no-undo .
      236      define input  parameter p-obj-type        as character no-undo .
      237      define input  parameter p-obj-code        as integer   no-undo .
      238      define output parameter p-user-select     as logical   no-undo .
      239      define output parameter p-select-obj-type as character no-undo .
      240      define output parameter p-select-obj-code as character no-undo .
      241     do
      242     on error undo, return error return-value
      243     :
      244       run gbl/userobjs.w
      245         (input  parparentproc
      246         ,input  this-procedure :handle
      247         ,input  p-db-num
      248         ,input  p-user-id
      249         ,input  p-host-code-obj
      250         ,input  p-obj-type
      251         ,input  p-obj-code
      252         ,INPUT  "b-sel"
      253         ,output p-user-select
      254         ,output p-select-obj-type
      255         ,output p-select-obj-code
      256         ) .
      257     end.
      258   end.
      259   procedure userobjs_select-many :
      260     define input  parameter parparentproc   as widget-handle no-undo .
      261     define input  parameter p-db-num        as integer   no-undo .
      262     define input  parameter p-user-id       as character no-undo .
      263     define input  parameter p-host-code-obj as integer   no-undo .
      264     define input  parameter p-obj-type      as character no-undo .
      265     define input  parameter p-obj-code      as integer   no-undo .
      266     define output parameter p-user-select   as logical   no-undo .
      267     define variable v-select-obj-type as character no-undo .
      268     define variable v-select-obj-code as integer   no-undo .
      269     do
      270     on error undo, return error return-value
      271     :
      272       run gbl/userobjs.w
      273         (input  parparentproc
      274         ,input  this-procedure :handle
      275         ,input  p-db-num
      276         ,input  p-user-id
      277         ,input  p-host-code-obj
      278         ,input  p-obj-type
      279         ,input  p-obj-code
      280         ,INPUT  "b-sel,b-mark"
      281         ,output p-user-select
      282         ,output v-select-obj-type
      283         ,output v-select-obj-code
      284         ) .
      285     end.
      286   end.
      287   procedure thobjs :
      288      define input        parameter parparentproc     as widget-handle no-undo .
      289      define input        parameter i-bttns           as character     no-undo .
      290      define input        parameter i-list-mode       as character     no-undo.
      291      define input        parameter i-obj-type        as character     no-undo.
      292      define input        parameter i-db-num          as integer       no-undo.
      293      define input        parameter i-host-code       as integer       no-undo.
      294      define input-output parameter p-rid-list        as character     no-undo .
      295   run ref/thobjs.p
      296           ( input parparentproc
      297            ,input  this-procedure :handle
      298           , input i-bttns
      299           , input i-list-mode
      300           , input i-obj-type
      301           , input i-db-num
      302           , input i-host-code
      303           , input-output p-rid-list ) no-error .
      304   end.
      305   define new  shared variable g#auto as logical no-undo.
      306   define new  shared variable g#news as logical no-undo.
      307   define new  shared variable g#oxml as logical no-undo.
      308   define new  shared variable g#esys as logical no-undo.
      309   define new  shared variable g#news-source-db as integer no-undo.
      310   define new  shared variable g#esys-source-esys as integer no-undo.
      311   define new  shared variable g#db-num as integer   no-undo .
      312   define new  shared variable g#userid as character no-undo .
      313   define new  shared variable g#passwd as character no-undo .
      314   DEFINE BUTTON b-cancel AUTO-END-KEY
      315        LABEL "&Отмена"
      316        SIZE 10 BY 1
      317        BGCOLOR 8 .
      318   DEFINE BUTTON b-choice AUTO-GO
      319        LABEL "&Выбор"
      320        SIZE 10 BY 1
      321        BGCOLOR 8 .
      322   DEFINE BUTTON b-help
      323        LABEL "Помо&щь"
      324        SIZE 10 BY 1
      325        BGCOLOR 8 .
      326   DEFINE BUTTON r-obj
      327        IMAGE-UP FILE "btn-down-arrow":U
      328        IMAGE-DOWN FILE "btn-down-arrow":U
      329        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      330        LABEL ""
      331        SIZE 3 BY .88.
      332   DEFINE VARIABLE varobj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      333        LABEL "Объект"
      334        VIEW-AS FILL-IN
      335        SIZE 10 BY 1 NO-UNDO.
      336   DEFINE VARIABLE varobj-name AS CHARACTER FORMAT "X(30)":U
      337         VIEW-AS TEXT
      338        SIZE 31 BY .67 NO-UNDO.
      339   DEFINE VARIABLE varobj-type AS CHARACTER FORMAT "X(3)":U
      340        VIEW-AS FILL-IN
      341        SIZE 4 BY 1 NO-UNDO.
      342   DEFINE FRAME Dialog-Frame
      343        b-choice AT ROW 1 COL 1
      344        b-cancel AT ROW 1 COL 11
      345        b-help AT ROW 1 COL 21
      346        varobj-code AT ROW 2.58 COL 2
      347        varobj-type AT ROW 2.58 COL 18.88 COLON-ALIGNED NO-LABEL
      348        r-obj AT ROW 2.67 COL 28.88
      349        varobj-name AT ROW 3.96 COL 1.5 NO-LABEL
      350        SPACE(0.62) SKIP(0.28)
      351       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      352            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      353            TITLE "Выбор объекта"
      354            DEFAULT-BUTTON b-choice CANCEL-BUTTON b-cancel.
      355   ASSIGN
      356          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      357          FRAME Dialog-Frame:HIDDEN           = TRUE.
      358   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      359   DO:
      360     APPLY "END-ERROR":U TO SELF.
      361   END.
      362   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      363   DO:
      364     assign
      365       parobj-type = ?
      366       parobj-code = ?.
      367   END.
      368   ON CHOOSE OF b-choice IN FRAME Dialog-Frame
      369   DO:
      370    define buffer buf_clients for ub.clients.
      371    assign
      372      frame Dialog-Frame varobj-type varobj-code.
      373    find first buf_clients where buf_clients.obj-type = varobj-type and
      374                                buf_clients.obj-code = varobj-code no-lock no-error.
      375    if not available buf_clients then do:
      376      message "Нет такого клиента." view-as alert-box.
      377      return no-apply.
      378    end.
      379    if lookup (varobj-type, parl-type) = 0 then do:
      380      message "Недопустимый тип выбранного объекта: " varobj-type skip
      381              "Допустимые типы: " parl-type skip
      382              view-as alert-box.
      383      return no-apply.
      384    end.
      385    assign
      386      parobj-type = varobj-type
      387      parobj-code = varobj-code
      388    .
      389   END.
      390   ON CHOOSE OF r-obj IN FRAME Dialog-Frame
      391   DO:
      392     define buffer buf_clients for ub.clients.
      393     define variable v-db-num as integer   no-undo .
      394     define variable v-current-host-code as integer   no-undo .
      395     define variable v-current-obj-type  as character no-undo .
      396     define variable v-current-obj-code  as integer   no-undo .
      397     define variable v-obj-type          as character no-undo .
      398     define variable v-obj-code          as integer   no-undo .
      399     define variable v-user-select       as logical   no-undo .
      400   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      402     (output v-db-num
      403     )  .
      404     assign
      405       frame Dialog-Frame
      406       varobj-code
      407       varobj-type
      408     .
      409     find buf_clients no-lock
      410       where buf_clients.obj-type = varobj-type
      411         and buf_clients.obj-code = varobj-code
      412       no-error .
      413     if available buf_clients
      414     then do:
      415       assign
      416         v-current-host-code = buf_clients.host-code
      417         v-current-obj-type  = buf_clients.obj-type
      418         v-current-obj-code  = buf_clients.obj-code
      419       .
      420     end.
      421     else do:
      422       assign
      423         v-current-host-code = 0
      424         v-current-obj-type  = '':U
      425         v-current-obj-code  = 0
      426       .
      427     end.
      428   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   run userobjs_select-one in this-procedure
      430     (input  this-procedure :handle
      431     ,input  v-db-num
      432     ,input  paruser-id
      433     ,input  v-current-host-code
      434     ,input  v-current-obj-type
      435     ,input  v-current-obj-code
      436     ,output v-user-select
      437     ,output v-obj-type
      438     ,output v-obj-code
      439     )  .
      440     if v-user-select = true
      441     then do:
      442       find buf_clients no-lock
      443         where buf_clients.obj-type = v-obj-type
      444           and buf_clients.obj-code = v-obj-code
      445         .
      446       disp buf_clients.obj-code @ varobj-code
      447           buf_clients.obj-type  @ varobj-type
      448           buf_clients.obj-name  @ varobj-name with frame Dialog-Frame.
      449     end.
      450   END.
      451   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      452   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      453   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   on help of frame Dialog-Frame
      455   do:
      456     run gbl/app_help.p
      457       (input this-procedure :file-name
      458       ,input ''
      459       ,input ?
      460       ) no-error.
      461     if error-status :error then do:
      462       message
      463         "Ошибка при вызове помощи"
      464         error-status :get-message(1)
      465         view-as alert-box .
      466     end.
      467   end.
      468   run minbtn-set in this-procedure .
      469   on choose of b-help in frame Dialog-Frame
      470   do:
      471     apply "help":u to frame Dialog-Frame .
      472   end.
      473   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   procedure minbtn-set :
      475       do
      476           on error undo, return error return-value
      477           :
      478           define variable ii              as integer       no-undo .
      479           define variable fh              as widget-handle no-undo .
      480           define variable hh              as widget-handle no-undo .
      481           define variable v-h             as handle        extent 4 no-undo .
      482           define variable v-name-button   as character     no-undo .
      483           define variable v-help-old-x    as decimal       no-undo .
      484           define variable v-help-old-y    as decimal       no-undo .
      485           define variable v-help-old-size as decimal       no-undo .
      486           define variable v-frame-width   as decimal       no-undo .
      487           define variable jj              as integer       no-undo .
      488           do
      489               on error undo, return error
      490               :
      491               assign
      492                   v-frame-width = frame Dialog-Frame:width - 0.3
      493                   fh            = frame Dialog-Frame:first-child
      494                   hh            = fh:first-child
      495                   ii            = 1
      496                   .
      497               do while valid-handle(hh):
      498                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      499                   do:
      500                       case lc(hh:name) :
      501                           when "b-help" then
      502                               do:
      503                                   hh:load-image-up("cmp/b-help.bmp":u) .
      504                                   hh:load-image-down("cmp/b-help.bmp":u) .
      505                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      506                                   hh:TOOLTIP = "Помощь" .
      507                                   v-help-old-x = hh:column .
      508                                   v-help-old-y = hh:row    .
      509                                   v-help-old-size = hh:width .
      510                                   hh:width-chars = 2.5 .
      511                               end.
      512                           when "b-print" then
      513                               do:
      514                                   hh:load-image("cmp/b-print.bmp":u) .
      515                                   hh:TOOLTIP = "Печать" .
      516                                   v-h[ii] = hh:handle .
      517                                   ii = ii + 1 .
      518                                   hh:width-chars = 3 .
      519                               end.
      520                           when "b-history" or
      521                           when "b-hist" then
      522                               do:
      523                                   hh:load-image("cmp/b-hist.bmp":u) .
      524                                   hh:TOOLTIP = "История" .
      525                                   v-h[ii] = hh:handle .
      526                                   ii = ii + 1 .
      527                                   hh:width-chars = 3 .
      528                               end.
      529                           when "b-sch" then
      530                               do:
      531                                   hh:load-image("cmp/b-sch.bmp":u) .
      532                                   hh:TOOLTIP = "Установка Фильтра" .
      533                                   v-h[ii] = hh:handle .
      534                                   ii = ii + 1 .
      535                                   hh:width-chars = 3 .
      536                               end.
      537                           when "b-hist-user" then
      538                               do:
      539                                   hh:load-image("cmp/b-hist.bmp":u) .
      540                                   hh:TOOLTIP = "История пользователя" .
      541                                   ii = ii + 1 .
      542                               end.
      543                       end case.
      544                   end.
      545                   hh = hh:next-sibling.
      546               end.
      547               b-help:column = v-frame-width - b-help:width-chars.
      548               jj = 0.
      549               repeat ii = 4 to 1 by -1 :
      550                   if valid-handle (v-h[ii] ) then
      551                   do:
      552                       jj  = jj + 1 .
      553                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      554                       v-h[ii]:row    = v-help-old-y .
      555                   end.
      556               end.
      557           end.
      558       end.
      559   end procedure.
      560   MAIN-BLOCK:
      561   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      562      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      563     run gbl/set-gbl.p
      564       (input false
      565       ,input paruser-id
      566       ,input ""
      567       ) no-error .
      568     if error-status :error
      569     then do:
      570       message
      571         vss-workfile vss-revision vss-description skip
      572         "Ошибка при установке глобальных переменных" skip
      573         error-status :get-message(1) skip
      574         return-value skip
      575         view-as alert-box error .
      576       return .
      577     end.
      578     RUN enable_UI .
      579     WAIT-FOR GO OF FRAME Dialog-Frame.
      580   END.
      581   RUN disable_UI.
      582   PROCEDURE disable_UI :
      583     HIDE FRAME Dialog-Frame.
      584   END PROCEDURE.
      585   PROCEDURE enable_UI :
      586     DISPLAY varobj-code varobj-type varobj-name
      587         WITH FRAME Dialog-Frame.
      588     ENABLE b-choice b-cancel b-help varobj-code varobj-type r-obj
      589         WITH FRAME Dialog-Frame.
      590     VIEW FRAME Dialog-Frame.
      591   END PROCEDURE.
      592   PROCEDURE mainmenu_getcntxt :
      593     define output parameter p-cntxt-db-num        as integer   no-undo .
      594     define output parameter p-cntxt-user-id       as character no-undo .
      595     define output parameter p-cntxt-level         as character no-undo .
      596     define output parameter p-cntxt-host-code-obj as integer   no-undo .
      597     define output parameter p-cntxt-obj-type      as character no-undo .
      598     define output parameter p-cntxt-obj-code      as integer   no-undo .
      599     define output parameter p-cntxt-db-num-obj    as integer   no-undo .
      600     define output parameter p-cntxt-is-admin      as logical   no-undo .
      601     define variable v-db-num     as integer   no-undo .
      602     define variable v-host-code  as integer   no-undo .
      603     define variable v-db-num-obj as integer   no-undo .
      604     do
      605     on error undo, return error
      606     :
      607   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      609     (output v-db-num
      610     )  .
      611       if  varobj-type = '':U
      612       and varobj-code = 0
      613       then do:
      614         assign
      615           p-cntxt-db-num        = v-db-num
      616           p-cntxt-user-id       = paruser-id
      617           p-cntxt-level         = 'global':U
      618           p-cntxt-host-code-obj = 0
      619           p-cntxt-obj-type      = '':U
      620           p-cntxt-obj-code      = 0
      621           p-cntxt-db-num-obj    = ?
      622         .
      623       end.
      624       else do:
      625   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      627     (input  varobj-type
      628     ,input  varobj-code
      629     ,output v-host-code
      630     )  .
      631   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      633     (input  varobj-type
      634     ,input  varobj-code
      635     ,output v-db-num-obj
      636     )  .
      637         assign
      638           p-cntxt-db-num        = v-db-num
      639           p-cntxt-user-id       = paruser-id
      640           p-cntxt-level         = 'object':U
      641           p-cntxt-host-code-obj = v-host-code
      642           p-cntxt-obj-type      = varobj-type
      643           p-cntxt-obj-code      = varobj-code
      644           p-cntxt-db-num-obj    = v-db-num-obj
      645         .
      646       end.
      647     end.
      648   END PROCEDURE.
      649   PROCEDURE get-userid :
      650     do
      651     on error undo, return error
      652     :
      653       define output parameter p-userid  as character no-undo .
      654       assign
      655         p-userid = paruser-id
      656       .
      657     end.
      658   END PROCEDURE.
