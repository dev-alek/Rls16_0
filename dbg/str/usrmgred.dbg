      439        SIZE 9.5 BY .67
      440        FGCOLOR 4  NO-UNDO.
      441   DEFINE VARIABLE rs-cntxt-level AS INTEGER
      442        VIEW-AS RADIO-SET VERTICAL
      443        RADIO-BUTTONS
      444             "Без фирмы, объекта", 1,
      445   "Только фирма", 2,
      446   "Фирма и объект", 3
      447        SIZE 22 BY 7.5
      448        FGCOLOR 4  NO-UNDO.
      449   DEFINE FRAME Dialog-Frame
      450        b-exit AT ROW 1 COL 1 WIDGET-ID 2
      451        b-quit AT ROW 1 COL 11 WIDGET-ID 4
      452        b-help AT ROW 1 COL 61
      453        cb-menu-group-id AT ROW 2.5 COL 1 COLON-ALIGNED NO-LABEL
      454        rs-cntxt-level AT ROW 4.25 COL 3 NO-LABEL
      455        r-sel-host AT ROW 7.63 COL 51.13
      456        r-sel-obj AT ROW 10.13 COL 51.25
      457        fi-host-label AT ROW 7.75 COL 24 COLON-ALIGNED NO-LABEL
      458        fi-host-name AT ROW 7.75 COL 32.5 COLON-ALIGNED NO-LABEL
      459        fi-host-description AT ROW 8.79 COL 32.5 COLON-ALIGNED NO-LABEL
      460        fi-obj-label AT ROW 10.25 COL 24 COLON-ALIGNED NO-LABEL
      461        fi-obj-name AT ROW 10.25 COL 32.5 COLON-ALIGNED NO-LABEL
      462        fi-obj-description AT ROW 11.29 COL 32.5 COLON-ALIGNED NO-LABEL
      463        SPACE(0.74) SKIP(0.74)
      464       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      465            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      466            TITLE "Выбор фирмы, объекта".
      467   ASSIGN
      468          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      469          FRAME Dialog-Frame:HIDDEN           = TRUE.
      470   ON GO OF FRAME Dialog-Frame
      471   DO:
      472     run select-context in this-procedure
      473       no-error .
      474     if error-status :error then do:
      475       return no-apply .
      476     end.
      477   END.
      478   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      479   DO:
      480     APPLY "END-ERROR":U TO SELF.
      481   END.
      482   ON VALUE-CHANGED OF cb-menu-group-id IN FRAME Dialog-Frame
      483   DO:
      484     assign
      485       cb-menu-group-id
      486       .
      487     run change-menu-group-id in this-procedure .
      488   END.
      489   ON CHOOSE OF r-sel-host IN FRAME Dialog-Frame
      490   DO:
      491   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   if lookup(self :type
      493            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      494            ) = 0
      495   then do:
      496     message
      497       "$Workfile$"
      498       "Указанному интерфейсному элементу фокус не может быть передан" skip
      499       "Интерфейсный элемент" self :name  skip
      500       "Тип" self :type  skip
      501       "Процедура" this-procedure :file-name skip
      502       view-as alert-box .
      503   end.
      504   else do:
      505     apply "entry":u to self  .
      506     if focus :handle <> self :handle  then do:
      507       return no-apply .
      508     end.
      509   end.
      510     run proc-sel-host in this-procedure .
      511   END.
      512   ON CHOOSE OF r-sel-obj IN FRAME Dialog-Frame
      513   DO:
      514   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   if lookup(self :type
      516            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      517            ) = 0
      518   then do:
      519     message
      520       "$Workfile$"
      521       "Указанному интерфейсному элементу фокус не может быть передан" skip
      522       "Интерфейсный элемент" self :name  skip
      523       "Тип" self :type  skip
      524       "Процедура" this-procedure :file-name skip
      525       view-as alert-box .
      526   end.
      527   else do:
      528     apply "entry":u to self  .
      529     if focus :handle <> self :handle  then do:
      530       return no-apply .
      531     end.
      532   end.
      533     run proc-sel-obj in this-procedure .
      534   END.
      535   ON VALUE-CHANGED OF rs-cntxt-level IN FRAME Dialog-Frame
      536   DO:
      537     assign
      538       rs-cntxt-level
      539     .
      540     run update-cntxt-level in this-procedure .
      541   END.
      542   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      543   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      544   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   on help of frame Dialog-Frame
      546   do:
      547     run gbl/app_help.p
      548       (input this-procedure :file-name
      549       ,input ''
      550       ,input ?
      551       ) no-error.
      552     if error-status :error then do:
      553       message
      554         "Ошибка при вызове помощи"
      555         error-status :get-message(1)
      556         view-as alert-box .
      557     end.
      558   end.
      559   run minbtn-set in this-procedure .
      560   on choose of b-help in frame Dialog-Frame
      561   do:
      562     apply "help":u to frame Dialog-Frame .
      563   end.
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure minbtn-set :
      566       do
      567           on error undo, return error return-value
      568           :
      569           define variable ii              as integer       no-undo .
      570           define variable fh              as widget-handle no-undo .
      571           define variable hh              as widget-handle no-undo .
      572           define variable v-h             as handle        extent 4 no-undo .
      573           define variable v-name-button   as character     no-undo .
      574           define variable v-help-old-x    as decimal       no-undo .
      575           define variable v-help-old-y    as decimal       no-undo .
      576           define variable v-help-old-size as decimal       no-undo .
      577           define variable v-frame-width   as decimal       no-undo .
      578           define variable jj              as integer       no-undo .
      579           do
      580               on error undo, return error
      581               :
      582               assign
      583                   v-frame-width = frame Dialog-Frame:width - 0.3
      584                   fh            = frame Dialog-Frame:first-child
      585                   hh            = fh:first-child
      586                   ii            = 1
      587                   .
      588               do while valid-handle(hh):
      589                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      590                   do:
      591                       case lc(hh:name) :
      592                           when "b-help" then
      593                               do:
      594                                   hh:load-image-up("cmp/b-help.bmp":u) .
      595                                   hh:load-image-down("cmp/b-help.bmp":u) .
      596                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      597                                   hh:TOOLTIP = "Помощь" .
      598                                   v-help-old-x = hh:column .
      599                                   v-help-old-y = hh:row    .
      600                                   v-help-old-size = hh:width .
      601                                   hh:width-chars = 2.5 .
      602                               end.
      603                           when "b-print" then
      604                               do:
      605                                   hh:load-image("cmp/b-print.bmp":u) .
      606                                   hh:TOOLTIP = "Печать" .
      607                                   v-h[ii] = hh:handle .
      608                                   ii = ii + 1 .
      609                                   hh:width-chars = 3 .
      610                               end.
      611                           when "b-history" or
      612                           when "b-hist" then
      613                               do:
      614                                   hh:load-image("cmp/b-hist.bmp":u) .
      615                                   hh:TOOLTIP = "История" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-sch" then
      621                               do:
      622                                   hh:load-image("cmp/b-sch.bmp":u) .
      623                                   hh:TOOLTIP = "Установка Фильтра" .
      624                                   v-h[ii] = hh:handle .
      625                                   ii = ii + 1 .
      626                                   hh:width-chars = 3 .
      627                               end.
      628                           when "b-hist-user" then
      629                               do:
      630                                   hh:load-image("cmp/b-hist.bmp":u) .
      631                                   hh:TOOLTIP = "История пользователя" .
      632                                   ii = ii + 1 .
      633                               end.
      634                       end case.
      635                   end.
      636                   hh = hh:next-sibling.
      637               end.
      638               b-help:column = v-frame-width - b-help:width-chars.
      639               jj = 0.
      640               repeat ii = 4 to 1 by -1 :
      641                   if valid-handle (v-h[ii] ) then
      642                   do:
      643                       jj  = jj + 1 .
      644                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      645                       v-h[ii]:row    = v-help-old-y .
      646                   end.
      647               end.
      648           end.
      649       end.
      650   end procedure.
      651   assign
      652     v-select-menu-group-context = p-menu-group-context
      653     v-select-host-code          = p-host-code
      654     v-select-obj-type           = p-obj-type
      655     v-select-obj-code           = p-obj-code
      656   .
      657   MAIN-BLOCK:
      658   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      659      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      660   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     run mainmenu_getcntxt in parparentproc
      662       (output v-cntxt-db-num
      663       ,output v-cntxt-userid
      664       ,output v-cntxt-level
      665       ,output v-cntxt-host-code-obj
      666       ,output v-cntxt-obj-type
      667       ,output v-cntxt-obj-code
      668       ,output v-cntxt-db-num-obj
      669       ,output v-cntxt-is-admin
      670       ) .
      671     RUN enable_UI.
      672     run get-default-context in this-procedure .
      673     WAIT-FOR GO OF FRAME Dialog-Frame.
      674   END.
      675   RUN disable_UI.
      676   PROCEDURE change-menu-group-id :
      677     do
      678     on error undo, return error return-value
      679     :
      680       define buffer buf_temp-menu-group-id for temp-menu-group-id .
      681       find first buf_temp-menu-group-id
      682         where buf_temp-menu-group-id.item-value = cb-menu-group-id
      683         .
      684       assign
      685         v-select-menu-group-code = integer(buf_temp-menu-group-id.menu-group-id)
      686       .
      687     end.
      688   END PROCEDURE.
      689   PROCEDURE disable_UI :
      690     HIDE FRAME Dialog-Frame.
      691   END PROCEDURE.
      692   PROCEDURE enable_UI :
      693     DISPLAY cb-menu-group-id rs-cntxt-level fi-host-label fi-host-name
      694             fi-host-description fi-obj-label fi-obj-name fi-obj-description
      695         WITH FRAME Dialog-Frame.
      696     ENABLE b-exit b-quit b-help cb-menu-group-id rs-cntxt-level r-sel-host
      697            r-sel-obj fi-host-label fi-host-name fi-host-description fi-obj-label
      698            fi-obj-name fi-obj-description
      699         WITH FRAME Dialog-Frame.
      700     VIEW FRAME Dialog-Frame.
      701   END PROCEDURE.
      702   PROCEDURE fill-menu-group-list :
      703     define variable v-local-number as integer   no-undo .
      704     define variable v-menu-name    as character no-undo .
      705     define buffer buf_menu-group for ub.menu-group .
      706     define buffer buf_temp-menu-group-id for temp-menu-group-id .
      707     do
      708     on error undo, return error return-value
      709     :
      710       assign
      711         v-local-number = 0
      712       .
      713       for each buf_temp-menu-group-id
      714       on error undo, return error return-value
      715       :
      716         delete buf_temp-menu-group-id .
      717       end.
      718       for each buf_menu-group
      719         where buf_menu-group.menu-code = p-menu-code
      720       on error undo, return error return-value
      721       :
      722         assign
      723           v-local-number = v-local-number + 1
      724         .
      725         assign
      726           v-menu-name = replace(buf_menu-group.menu-group-name, ',':U, '':U)
      727           v-menu-name = replace(v-menu-name, '&':U, '':U)
      728         .
      729         create buf_temp-menu-group-id .
      730         assign
      731           buf_temp-menu-group-id.menu-group-id  = string(buf_menu-group.menu-group-code)
      732           buf_temp-menu-group-id.item-value     = v-menu-name
      733         .
      734       end.
      735     end.
      736   END PROCEDURE.
      737   PROCEDURE get-default-context :
      738     define buffer buf_temp-menu-group-id for temp-menu-group-id .
      739     do
      740     on error undo, return error return-value
      741     :
      742       assign
      743         fi-host-name        = '':U
      744         fi-host-description = '':U
      745         fi-obj-name         = '':U
      746         fi-obj-description  = '':U
      747       .
      748       case v-select-menu-group-context
      749       :
      750         when 'global':U
      751         then do:
      752           assign
      753             rs-cntxt-level = 1
      754           .
      755           hide
      756             fi-host-name        in frame Dialog-Frame
      757             fi-host-description in frame Dialog-Frame
      758             r-sel-host          in frame Dialog-Frame
      759             fi-obj-name         in frame Dialog-Frame
      760             fi-obj-description  in frame Dialog-Frame
      761             r-sel-obj           in frame Dialog-Frame
      762             .
      763           display
      764             rs-cntxt-level
      765             with frame Dialog-Frame .
      766         end.
      767         when 'firm':U
      768         then do:
      769           assign
      770             rs-cntxt-level = 2
      771           .
      772           run set-host-variables in this-procedure
      773             (input  'орг':U
      774             ,input  v-select-host-code
      775             ) .
      776           hide
      777             fi-obj-name        in frame Dialog-Frame
      778             fi-obj-description in frame Dialog-Frame
      779             r-sel-obj          in frame Dialog-Frame
      780             .
      781           display
      782             rs-cntxt-level
      783             fi-host-name fi-host-description r-sel-host
      784             with frame Dialog-Frame .
      785           enable
      786             r-sel-host
      787             with frame Dialog-Frame .
      788         end.
      789         when 'object':U
      790         then do:
      791           assign
      792             rs-cntxt-level = 3
      793           .
      794           run set-host-variables in this-procedure
      795             (input  'орг':U
      796             ,input  v-select-host-code
      797             ) .
      798           run set-obj-variables in this-procedure
      799             (input  v-select-obj-type
      800             ,input  v-select-obj-code
      801             ).
      802           display
      803             rs-cntxt-level
      804             fi-host-name fi-host-description r-sel-host
      805             fi-obj-name fi-obj-description r-sel-obj
      806             with frame Dialog-Frame .
      807           enable
      808             r-sel-host
      809             r-sel-obj
      810             with frame Dialog-Frame .
      811         end.
      812         otherwise do:
      813           message
      814             vss-workfile vss-revision vss-description skip
      815             "Неизвестное значение конектста" skip
      816             "Значение контекста" v-select-menu-group-context skip
      817             view-as alert-box error .
      818           undo, return error return-value .
      819         end.
      820       end case .
      821       run fill-menu-group-list in this-procedure .
      822       run update-cb-menu-group-id-list-items in this-procedure .
      823     end.
      824   END PROCEDURE.
      825   PROCEDURE proc-sel-host :
      826     define variable v-user-select      as logical   no-undo .
      827     define variable v-choose-host-code as integer   no-undo .
      828     do
      829     on error undo, return error return-value
      830     :
      831       if  v-user-select      = true
      832       and v-select-host-code <> v-choose-host-code
      833       then do:
      834         assign
      835           v-select-host-code = v-choose-host-code
      836           v-select-obj-type  = '':U
      837           v-select-obj-code  = 0
      838         .
      839         run set-host-variables in this-procedure
      840           (input  'орг':U
      841           ,input  v-select-host-code
      842           ) .
      843         run set-obj-variables in this-procedure
      844           (input  v-select-obj-type
      845           ,input  v-select-obj-code
      846           ) .
      847         display
      848           fi-host-name
      849           fi-host-description
      850           fi-obj-name
      851           fi-obj-description
      852           with frame Dialog-Frame .
      853       end.
      854     end.
      855   END PROCEDURE.
      856   PROCEDURE proc-sel-obj :
      857     define variable v-rid-list as character no-undo .
      858     define buffer buf_clients for ub.clients .
      859     do
      860     on error undo, return error return-value
      861     :
      862       run ref/cli-all.w
      863         (input  parparentproc
      864         ,input  'b-sel':U
      865         ,input  (if v-cntxt-db-num = 0 then 'объект':U else "db":U)
      866         ,input  'все':U
      867         ,input  'текущие':U
      868         ,input  ?
      869         ,input  ',,,,,,NO,,'
      870         ,input  'lock-cli-type':U
      871         ,output v-rid-list
      872         ).
      873      if v-rid-list = '':U
      874      then do:
      875        return.
      876      end.
      877      else do:
      878       find first buf_clients no-lock
      879         where recid(buf_clients) = integer(entry(1, v-rid-list)).
      880         assign
      881           v-select-obj-type = buf_clients.obj-type
      882           v-select-obj-code = buf_clients.obj-code
      883         .
      884   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      886     (input  v-select-obj-type
      887     ,input  v-select-obj-code
      888     ,output v-select-host-code
      889     )  .
      890         run set-host-variables in this-procedure
      891           (input  'орг':U
      892           ,input  v-select-host-code
      893           ) .
      894         run set-obj-variables in this-procedure
      895           (input  v-select-obj-type
      896           ,input  v-select-obj-code
      897           ) .
      898         display
      899           fi-host-name
      900           fi-host-description
      901           fi-obj-name
      902           fi-obj-description
      903           with frame Dialog-Frame .
      904      end.
      905     end.
      906   END PROCEDURE.
      907   PROCEDURE select-context :
      908     do
      909     on error undo, return error return-value
      910     :
      911       case rs-cntxt-level
      912       :
      913         when 1
      914         then do:
      915           assign
      916             p-output-menu-group-context  = 'global':U
      917             p-output-host-code           = 0
      918             p-output-obj-type            = '':u
      919             p-output-obj-code            = 0
      920           .
      921         end.
      922         when 2
      923         then do:
      924           if v-select-host-code = 0
      925           then do:
      926             message
      927               "Не задана фирма" skip
      928               view-as alert-box error .
      929             run proc-sel-host in this-procedure .
      930             undo, return error return-value .
      931           end.
      932           assign
      933             p-output-menu-group-context = 'firm':U
      934             p-output-host-code          = v-select-host-code
      935             p-output-obj-type           = '':u
      936             p-output-obj-code           = 0
      937           .
      938         end.
      939         when 3
      940         then do:
      941           if v-select-host-code = 0
      942           then do:
      943             message
      944               "Не задана фирма" skip
      945               view-as alert-box error .
      946             run proc-sel-host in this-procedure .
      947             undo, return error return-value .
      948           end.
      949           if v-select-obj-type = '':U
      950           or v-select-obj-code = 0
      951           then do:
      952             message
      953               "Не задан объект" skip
      954               view-as alert-box error .
      955             run proc-sel-obj in this-procedure .
      956             undo, return error return-value .
      957           end.
      958           assign
      959             p-output-menu-group-context = 'object':U
      960             p-output-host-code          = v-select-host-code
      961             p-output-obj-type           = v-select-obj-type
      962             p-output-obj-code           = v-select-obj-code
      963           .
      964         end.
      965         otherwise do:
      966           message
      967             vss-workfile vss-revision vss-description skip
      968             "Неизвестное значение переменной rs-cntxt-level" skip
      969             "rs-cntxt-level" rs-cntxt-level skip
      970             view-as alert-box error .
      971           undo, return error return-value .
      972         end.
      973       end.
      974       assign
      975         p-output-menu-code       = p-menu-code
      976         p-output-menu-group-code = v-select-menu-group-code
      977       .
      978       assign
      979         p-update-data = true
      980       .
      981     end.
      982   END PROCEDURE.
      983   PROCEDURE set-host-state :
      984     define input  parameter p-host-show as logical   no-undo .
      985     do
      986     on error undo, return error return-value
      987     :
      988       do with frame Dialog-Frame
      989       :
      990         if p-host-show = true
      991         then do:
      992           assign
      993             fi-host-label       :visible   = true
      994             fi-host-name        :visible   = true
      995             fi-host-description :visible   = true
      996             r-sel-host          :visible   = true
      997             r-sel-host          :sensitive = true
      998           .
      999         end.
     1000         else do:
     1001           assign
     1002             fi-host-label       :visible   = false
     1003             fi-host-name        :visible   = false
     1004             fi-host-description :visible   = false
     1005             r-sel-host          :sensitive = false
     1006             r-sel-host          :visible   = false
     1007           .
     1008         end.
     1009       end.
     1010     end.
     1011   END PROCEDURE.
     1012   PROCEDURE set-host-variables :
     1013     define input  parameter p-obj-type as character no-undo .
     1014     define input  parameter p-obj-code as integer   no-undo .
     1015     define buffer buf_clients for ub.clients .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       find first buf_clients no-lock
     1020         where buf_clients.obj-type = p-obj-type
     1021           and buf_clients.obj-code = p-obj-code
     1022         no-error .
     1023       if available buf_clients
     1024       then do:
     1025         assign
     1026           fi-host-name        = substitute('&1 &2':U
     1027                                           ,buf_clients.obj-type
     1028                                           ,buf_clients.obj-code
     1029                                           )
     1030           fi-host-description = buf_clients.obj-name
     1031         .
     1032       end.
     1033     end.
     1034   END PROCEDURE.
     1035   PROCEDURE set-obj-state :
     1036     define input  parameter p-obj-show as logical   no-undo .
     1037     do
     1038     on error undo, return error return-value
     1039     :
     1040       do with frame Dialog-Frame
     1041       :
     1042         if p-obj-show = true
     1043         then do:
     1044           assign
     1045             fi-obj-label       :visible   = true
     1046             fi-obj-name        :visible   = true
     1047             fi-obj-description :visible   = true
     1048             r-sel-obj          :visible   = true
     1049             r-sel-obj          :sensitive = true
     1050           .
     1051         end.
     1052         else do:
     1053           assign
     1054             fi-obj-label       :visible   = false
     1055             fi-obj-name        :visible   = false
     1056             fi-obj-description :visible   = false
     1057             r-sel-obj          :sensitive = false
     1058             r-sel-obj          :visible   = false
     1059           .
     1060         end.
     1061       end.
     1062     end.
     1063   END PROCEDURE.
     1064   PROCEDURE set-obj-variables :
     1065     define input  parameter p-obj-type as character no-undo .
     1066     define input  parameter p-obj-code as integer   no-undo .
     1067     define buffer buf_clients for ub.clients .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       find first buf_clients no-lock
     1072         where buf_clients.obj-type = p-obj-type
     1073           and buf_clients.obj-code = p-obj-code
     1074         no-error .
     1075       if available buf_clients
     1076       then do:
     1077         assign
     1078           fi-obj-name        = substitute('&1 &2':U
     1079                                           ,buf_clients.obj-type
     1080                                           ,buf_clients.obj-code
     1081                                           )
     1082           fi-obj-description = buf_clients.obj-name
     1083         .
     1084       end.
     1085       else do:
     1086         assign
     1087           fi-obj-name        = '':U
     1088           fi-obj-description = '':U
     1089         .
     1090       end.
     1091     end.
     1092   END PROCEDURE.
     1093   PROCEDURE update-cb-menu-group-id-list-items :
     1094     define variable v-list-items as character no-undo .
     1095     define buffer buf_temp-menu-group-id for temp-menu-group-id .
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099       assign
     1100         v-list-items = '':U
     1101       .
     1102       for each buf_temp-menu-group-id
     1103       :
     1104         assign
     1105           v-list-items = v-list-items
     1106                        + (if v-list-items <> '':U then ',':U else '':U)
     1107                        + buf_temp-menu-group-id.item-value
     1108         .
     1109       end.
     1110       do with frame Dialog-Frame
     1111       :
     1112         assign
     1113           cb-menu-group-id :list-items = v-list-items
     1114         .
     1115         if v-list-items <> '':U
     1116         then do:
     1117           find first buf_temp-menu-group-id
     1118             where buf_temp-menu-group-id.menu-group-id = string(p-menu-group-code)
     1119             no-error .
     1120           if available buf_temp-menu-group-id
     1121           then do:
     1122             assign
     1123               v-select-menu-group-code = integer(buf_temp-menu-group-id.menu-group-id)
     1124               cb-menu-group-id         = buf_temp-menu-group-id.item-value
     1125             .
     1126           end.
     1127           else do:
     1128             assign
     1129               cb-menu-group-id = entry(1, cb-menu-group-id :list-items)
     1130             .
     1131             run change-menu-group-id in this-procedure .
     1132           end.
     1133           display
     1134             cb-menu-group-id
     1135             with frame Dialog-Frame .
     1136         end.
     1137       end.
     1138     end.
     1139   END PROCEDURE.
     1140   PROCEDURE update-cntxt-level :
     1141     define variable v-host-show as logical   no-undo .
     1142     define variable v-obj-show  as logical   no-undo .
     1143     do
     1144     on error undo, return error return-value
     1145     :
     1146       case rs-cntxt-level
     1147       :
     1148         when 1
     1149         then do:
     1150           assign
     1151             v-host-show = false
     1152             v-obj-show  = false
     1153           .
     1154         end.
     1155         when 2
     1156         then do:
     1157           assign
     1158             v-host-show = true
     1159             v-obj-show  = false
     1160           .
     1161         end.
     1162         when 3
     1163         then do:
     1164           assign
     1165             v-host-show = true
     1166             v-obj-show  = true
     1167           .
     1168         end.
     1169         otherwise do:
     1170           message
     1171             vss-workfile vss-revision vss-description skip
     1172             "Неизвестное значение переменной контекста" skip
     1173             "rs-cntxt-level" rs-cntxt-level skip
     1174             view-as alert-box error .
     1175           undo, return error return-value .
     1176         end.
     1177       end case .
     1178       run set-host-state in this-procedure
     1179         (input  v-host-show
     1180         ) .
     1181       run set-obj-state in this-procedure
     1182         (input  v-obj-show
     1183         ) .
     1184       case rs-cntxt-level
     1185       :
     1186         when 1
     1187         then do:
     1188         end.
     1189         when 2
     1190         then do:
     1191           if v-select-host-code = 0
     1192           then do:
     1193             run proc-sel-host in this-procedure .
     1194           end.
     1195         end.
     1196         when 3
     1197         then do:
     1198           if v-select-obj-type = '':U
     1199           or v-select-obj-code = 0
     1200           then do:
     1201             run proc-sel-obj in this-procedure .
     1202           end.
     1203         end.
     1204         otherwise do:
     1205           message
     1206             vss-workfile vss-revision vss-description skip
     1207             "Неизвестное значение переменной контекста" skip
     1208             "rs-cntxt-level" rs-cntxt-level skip
     1209             view-as alert-box error .
     1210           undo, return error return-value .
     1211         end.
     1212       end case .
     1213     end.
     1214   END PROCEDURE.
