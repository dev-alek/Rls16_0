        1   define input  parameter parparentproc               as widget-handle no-undo .
        2   define input  parameter p-db-num                    as integer   no-undo .
        3   define input  parameter p-user-id                   as character no-undo .
        4   define input  parameter p-menu-code                 as integer   no-undo .
        5   define input  parameter p-menu-group-code           as integer   no-undo .
        6   define input  parameter p-menu-group-context        as character no-undo .
        7   define input  parameter p-host-code                 as integer   no-undo .
        8   define input  parameter p-obj-type                  as character no-undo .
        9   define input  parameter p-obj-code                  as integer   no-undo .
       10   define output parameter p-update-data               as logical   no-undo .
       11   define output parameter p-output-menu-code          as integer   no-undo .
       12   define output parameter p-output-menu-group-code    as integer   no-undo .
       13   define output parameter p-output-menu-group-context as character no-undo .
       14   define output parameter p-output-host-code          as integer   no-undo .
       15   define output parameter p-output-obj-type           as character no-undo .
       16   define output parameter p-output-obj-code           as integer   no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Редактирование пользовательской группы меню".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define new global shared variable g#library  as handle no-undo .
      127   define new global shared variable g#library2 as handle no-undo .
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define variable v-waitfram-action01         as character   no-undo .
      130   define variable v-waitfram-action02         as character   no-undo .
      131   define variable v-waitfram-action03         as character   no-undo .
      132   define variable mWaitFramTextBeg            as character   no-undo.
      133   define variable mWaitFramTextEnd            as character   no-undo.
      134   define variable mWaitFramView               as logical     no-undo.
      135   define variable mWaitProcEvent              as logical     no-undo init yes.
      136   define variable mWaitFramInterval           as integer     no-undo init 1 .
      137   define variable mWaitFramStop               as logical     no-undo.
      138   define variable mWaitFramStopUser           as logical     no-undo.
      139   define variable mWaitFramStopTimeOut        as logical     no-undo.
      140   define variable mWaitFramStartProc          as datetime-tz no-undo.
      141   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      142   define button B-WaitFramStop auto-end-key
      143        label "Стоп"
      144        size 10 by 1 tooltip "Остоновить процесс".
      145   define button B-viewProcInfo
      146        label "Информация"
      147        size 15 by 1 tooltip "Информация о процесс".
      148   define frame waitfram
      149     v-waitfram-action01 format "x(72)" no-label skip
      150     v-waitfram-action02 format "x(72)" no-label skip
      151     v-waitfram-action03 format "x(72)" no-label skip
      152     B-viewProcInfo
      153     B-WaitFramStop at row 4 col 30
      154     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      155     .
      156   define new global shared variable mBatchMode as logical no-undo init ?.
      157   define variable mFramBachModHandle as handle no-undo.
      158   mFramBachModHandle = frame waitfram:handle.
      159   define variable mFameOldVis as logical no-undo.
      160   define variable mVisCUrentVin as logical no-undo.
      161   if session:batch-mode
      162   then
      163      mBatchMode = yes.
      164   if mBatchMode = ? then do:
      165     mVisCUrentVin = current-window:visible.
      166     mFameOldVis = mFramBachModHandle:visible.
      167     mFramBachModHandle:visible  = yes.
      168     mBatchMode = mFramBachModHandle:visible ne yes.
      169     mFramBachModHandle:visible = mFameOldVis.
      170     current-window:visible = mVisCUrentVin.
      171   end.
      172    if  log-manager:logfile-name ne ?
      173     then DO:
      174         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      175         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      176         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      177     end.
      178   on choose of B-WaitFramStop in frame waitfram
      179   do:
      180     mWaitFramStop = yes.
      181     mWaitFramStopUser = yes.
      182   end.
      183   function waitfram-check-timeout returns logical():
      184      define variable vtime as int64 no-undo.
      185      if mWaitFramStopTimeOut
      186      then
      187         return yes.
      188      vtime = ( now - mWaitFramStartProc ) / 1000 .
      189      if     mWaitFramTimeOut ne ?
      190         and mWaitFramTimeOut ne 0
      191         and mWaitFramTimeOut lt vtime
      192      then do:
      193         mWaitFramStopTimeOut = yes.
      194      end.
      195      return mWaitFramStopTimeOut.
      196   end.
      197   procedure waitfram-hide :
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       pause 0 before-hide .
      203       if not mBatchMode then
      204         hide frame waitfram .
      205     if     not mWaitFramView
      206        and mWaitProcEvent
      207     then
      208       process events .
      209     end.
      210   end procedure.
      211   procedure waitfram-show :
      212     define input  parameter p-message as character no-undo .
      213     define variable v-left-margin as integer   no-undo .
      214     if not session:batch-mode
      215     then do
      216     on error undo, return error return-value
      217     :
      218       if length(p-message) <= 70 then do:
      219         assign
      220           v-left-margin = integer((70 - length(p-message)) / 2)
      221         .
      222         assign
      223           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      224         .
      225         assign
      226           v-waitfram-action01 = " "
      227           v-waitfram-action02 = " "
      228                                    + fill(" ", v-left-margin)
      229                                    + p-message
      230           v-waitfram-action03 = " "
      231         .
      232       end.
      233       else do:
      234         define variable vRindex1 as integer no-undo.
      235         define variable vRindex2 as integer no-undo.
      236         vRindex1 = r-index(p-message," ",70).
      237         if vRindex1 = 0
      238         then
      239            vRindex1 = 70.
      240         if length(p-message)  <= vRindex1 + 70 then do:
      241           assign
      242             v-waitfram-action01 = " "
      243             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      244             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      245           .
      246         end.
      247         else do:
      248           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      249           if vRindex2 <= vRindex1
      250           then
      251              vRindex2 = vRindex1 + 70.
      252           assign
      253             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      255             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      256           .
      257         end.
      258       end.
      259       B-viewProcInfo:visible   in frame waitfram = no.
      260       B-viewProcInfo:sensitive in frame waitfram = no.
      261       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       if  (   mWaitFramView
      264          or  mWaitProcEvent)
      265          and not mBatchMode
      266       then
      267          display
      268             v-waitfram-action01 skip
      269             v-waitfram-action02 skip
      270             v-waitfram-action03 skip
      271          with frame waitfram .
      272       if     mWaitFramView
      273          then do:
      274             if     mWaitFramInterval ne ?
      275                and not mBatchMode
      276             then
      277                wait-for go of frame waitfram pause mWaitFramInterval.
      278          end.
      279          else
      280             if     mWaitProcEvent
      281                and not mBatchMode
      282             then
      283                process events .
      284     end.
      285   end procedure.
      286      procedure waitfram-show-this:
      287         define input  parameter iInterval as int64 no-undo.
      288         define variable vtime as int64 no-undo.
      289         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      290         mWaitFramInterval = iInterval.
      291         run waitfram-show (substitute("&1&2 &3&4" ,
      292                                       mWaitFramTextBeg ,
      293                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      294                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      295                                       mWaitFramTextEnd
      296                                      )
      297                           ).
      298      end.
      299      procedure WaitFramRunPause:
      300         define input  parameter iInterval as dec no-undo.
      301         define variable vStart  as datetime-tz no-undo.
      302         define variable vend    as datetime-tz no-undo.
      303         define variable vint as int64 no-undo.
      304         define variable vOk as logical no-undo.
      305         vStart = now.
      306         vend   = vStart.
      307         publish "WaitFramPause" (iInterval,output vOk).
      308         vend   =  now.
      309         vint = vend - vStart.
      310         vint = iInterval - vint / 1000.
      311         if     not mWaitFramStop
      312            and (   vint > 0
      313                 or (    not vOk
      314                     and iInterval eq ?
      315                     )
      316                 )
      317         then
      318            run waitfram-show-this (iInterval).
      319         vend   =  now.
      320         vint = vend - vStart.
      321         vint = iInterval - vint / 1000.
      322         if     not mWaitFramStop
      323            and vint > 0
      324         then do:
      325            run gbl/pause.p (vint * 1000).
      326         end.
      327         if iInterval ne ?
      328         then
      329            publish "WaitFramStop".
      330         waitfram-check-timeout().
      331      end.
      332      procedure WaitFramWaitFor:
      333         define input  parameter iInterval as dec no-undo.
      334         assign
      335            mWaitFramStartProc   = now
      336            mWaitFramStopUser    = no
      337            mWaitFramStopTimeOut = no
      338         .
      339         block-wait:
      340         do while not mWaitFramStop:
      341            run WaitFramRunPause (iInterval).
      342            if  waitfram-check-timeout()
      343            then do:
      344               leave block-wait.
      345            end.
      346         end.
      347         run waitfram-hide.
      348      end.
      349   procedure waitfram-join :
      350     define input  parameter p-line-1  as character no-undo .
      351     define input  parameter p-line-2  as character no-undo .
      352     define input  parameter p-line-3  as character no-undo .
      353     define output parameter p-message as character no-undo .
      354     do
      355     on error undo, return error return-value
      356     :
      357       assign
      358         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      361       .
      362     end.
      363   end procedure.
      364   function waitfram-join-function returns character
      365     (input p-line-1 as character
      366     ,input p-line-2 as character
      367     ,input p-line-3 as character
      368     ).
      369     define variable v-message as character no-undo .
      370     run waitfram-join in this-procedure
      371       (input  p-line-1
      372       ,input  p-line-2
      373       ,input  p-line-3
      374       ,output v-message
      375       ) .
      376     return v-message .
      377   end function .
      378   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379     define variable v-cntxt-db-num        as integer   no-undo .
      380     define variable v-cntxt-userid        as character no-undo .
      381     define variable v-cntxt-level         as character no-undo .
      382     define variable v-cntxt-host-code-obj as integer   no-undo .
      383     define variable v-cntxt-obj-type      as character no-undo .
      384     define variable v-cntxt-obj-code      as integer   no-undo .
      385     define variable v-cntxt-db-num-obj    as integer   no-undo .
      386     define variable v-cntxt-is-admin      as logical   no-undo .
      387   define variable v-select-menu-group-code    as integer   no-undo .
      388   define variable v-select-menu-group-context as character no-undo .
      389   define variable v-select-host-code          as integer   no-undo .
      390   define variable v-select-obj-type           as character no-undo .
      391   define variable v-select-obj-code           as integer   no-undo .
      392   define temp-table temp-menu-group-id no-undo
      393     field menu-group-id as character
      394     field item-value    as character
      395     index xpk is primary unique menu-group-id
      396     index xie1 item-value
      397     .
      398   DEFINE BUTTON b-exit AUTO-GO
      399        LABEL "&Ввод"
      400        SIZE 10 BY 1.
      401   DEFINE BUTTON b-help
      402        LABEL "Помо&щь"
      403        SIZE 10 BY 1
      404        BGCOLOR 8 .
      405   DEFINE BUTTON b-quit AUTO-END-KEY
      406        LABEL "&Отмена"
      407        SIZE 10 BY 1.
      408   DEFINE BUTTON r-sel-host
      409        LABEL "Выбор фирмы"
      410        SIZE 19.5 BY .88 TOOLTIP "Выбор фирмы".
      411   DEFINE BUTTON r-sel-obj
      412        LABEL "Выбор объекта"
      413        SIZE 19.5 BY .88 TOOLTIP "Выбор объекта".
      414   DEFINE VARIABLE cb-menu-group-id AS CHARACTER FORMAT "X(256)":U
      415        VIEW-AS COMBO-BOX INNER-LINES 15
      416        LIST-ITEMS "Item 1"
      417        DROP-DOWN-LIST
      418        SIZE 52 BY 1 NO-UNDO.
      419   DEFINE VARIABLE fi-host-description AS CHARACTER FORMAT "X(256)":U
      420         VIEW-AS TEXT
      421        SIZE 36.25 BY .67
      422        FGCOLOR 4  NO-UNDO.
      423   DEFINE VARIABLE fi-host-label AS CHARACTER FORMAT "X(256)":U INITIAL "Фирма:"
      424         VIEW-AS TEXT
      425        SIZE 8 BY .67 NO-UNDO.
      426   DEFINE VARIABLE fi-host-name AS CHARACTER FORMAT "X(256)":U
      427         VIEW-AS TEXT
      428        SIZE 9.5 BY .67
      429        FGCOLOR 4  NO-UNDO.
      430   DEFINE VARIABLE fi-obj-description AS CHARACTER FORMAT "X(256)":U
      431         VIEW-AS TEXT
      432        SIZE 36.25 BY .67
      433        FGCOLOR 4  NO-UNDO.
      434   DEFINE VARIABLE fi-obj-label AS CHARACTER FORMAT "X(256)":U INITIAL "Объект:"
      435         VIEW-AS TEXT
      436        SIZE 8.5 BY .67 NO-UNDO.
