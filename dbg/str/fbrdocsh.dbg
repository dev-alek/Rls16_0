       35   .
       36   define variable v-fbrdocsh-fbf-key    as integer      no-undo.
       37   define variable v-fbrdocsh-fbl-key    as integer      no-undo.
       38   define variable v-fbrdocsh-fbh-key    as integer      no-undo.
       39   define input parameter parparentproc    as widget-handle    no-undo.
       40   define input parameter p-fbr-doc-code   as character        no-undo.
       41   define variable vss-revision    as character no-undo init "$Revision$":U .
       42   define variable vss-author      as character no-undo init "$Author$":U .
       43   define variable vss-date        as character no-undo init "$Date$":U .
       44   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       45   define variable vss-archive     as character no-undo init "$Archive$":U .
       46   define variable vss-description as character no-undo init "Окно истории документа производства".
       47   procedure vss-get-info :
       48     define output parameter p-vss-revision    like vss-revision    no-undo .
       49     define output parameter p-vss-author      like vss-author      no-undo .
       50     define output parameter p-vss-date        like vss-date        no-undo .
       51     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       52     define output parameter p-vss-archive     like vss-archive     no-undo .
       53     define output parameter p-vss-description like vss-description no-undo .
       54     assign
       55       p-vss-revision    = vss-revision
       56       p-vss-author      = vss-author
       57       p-vss-date        = vss-date
       58       p-vss-workfile    = vss-workfile
       59       p-vss-archive     = vss-archive
       60       p-vss-description = vss-description
       61     .
       62   end procedure.
       63   procedure vss-get-parameters :
       64     define output parameter p-vss-parameters as character no-undo .
       65   end procedure.
       66   define new global shared variable g#vssrevis-logger as handle    no-undo .
       67   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       68   define variable v-vssrevis-logger                   as handle    no-undo .
       69   procedure vss-logevent :
       70     define input  parameter p-extra-paramters as character no-undo .
       71     define variable v-vssrevis-parameters as character no-undo .
       72     do
       73     on error undo, return error return-value
       74     :
       75       if  valid-handle(v-vssrevis-logger)
       76       and v-vssrevis-logger :get-signature("logevent") <> ""
       77       then do:
       78         run vss-get-parameters in this-procedure
       79           (output v-vssrevis-parameters
       80           ).
       81         run logevent in v-vssrevis-logger
       82           (input vss-workfile
       83           ,input vss-revision
       84           ,input v-vssrevis-parameters
       85           ,input p-extra-paramters
       86           ).
       87       end.
       88     end.
       89   end procedure.
       90   assign
       91     v-vssrevis-logger = g#vssrevis-logger
       92   .
       93   if  valid-handle(v-vssrevis-logger)
       94   and v-vssrevis-logger :get-signature("logevent") <> ""
       95   then do:
       96     assign
       97       v-vssrevis-logevent = true
       98     .
       99     run vss-logevent in this-procedure (input vss-description) .
      100   end.
      101   define new global shared variable g#language as character no-undo .
      102   if g#language <> '' and g#language <> 'rus':U then do:
      103     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      104   end.
      105   define new global shared variable g#library  as handle no-undo .
      106   define new global shared variable g#library2 as handle no-undo .
      107   define variable vss-include-info0 as character format "X(65)" no-undo
      108   initial "@(#)$Workfile$ $Revision$".
      109   procedure schemlib-get-index-fields :
      110   define input parameter p-table-name     as character        no-undo.
      111   define output parameter p-field-list    as character        no-undo.
      112       define variable v-table-handle          as handle       no-undo.
      113       define variable v-field-handle          as handle       no-undo.
      114       define variable v-index-info            as character    no-undo.
      115       define variable v-counter               as integer      no-undo.
      116       define variable v-index-fields-amount   as integer      no-undo.
      117   do
      118   on error undo, return error
      119   :
      120       if p-table-name = ?
      121       or p-table-name = "":U
      122       then do:
      123           return error substitute( "&1 (get-index-fields). Ошибка задания входных параметров. Задано пустое имя таблицы.", vss-workfile ).
      124       end.
      125       create buffer v-table-handle for table p-table-name no-error.
      126       if error-status :error
      127       then do:
      128           return error substitute( "&1 (get-index-fields). Ошибка задания входных параметров. Неверно задано имя таблицы '&2'.", vss-workfile, p-table-name ).
      129       end.
      130       assign
      131           v-counter       = 1
      132           v-index-info    = v-table-handle :index-information( v-counter )
      133       .
      134       do while v-index-info <> ?
      135       and entry( 3, v-index-info ) <> "1":U
      136       on error undo, return error
      137       :
      138           assign
      139               v-counter       = v-counter + 1
      140               v-index-info    = v-table-handle :index-information( v-counter )
      141           .
      142       end.
      143       if v-index-info = ?
      144       or LC( entry( 1, v-index-info ) ) = "default":U
      145       or entry( 3, v-index-info ) <> "1":U
      146       then do:
      147           return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-table-name ).
      148       end.
      149       else do:
      150           assign
      151               v-index-fields-amount = num-entries( v-index-info ) - 4
      152               p-field-list          = "":U
      153           .
      154           if v-index-fields-amount < 2
      155           then do:
      156               return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-index-info, p-table-name ).
      157           end.
      158           do v-counter = 1 to v-index-fields-amount by 2
      159           on error undo, return error
      160           :
      161               assign
      162                   v-field-handle  = v-table-handle :buffer-field( entry( 4 + v-counter, v-index-info ) ).
      163               .
      164               assign
      165                   p-field-list    = substitute( "&1&2&3":U
      166                                       , p-field-list
      167                                       , ( if p-field-list = "":U then "":U else ",":U )
      168                                       , v-field-handle :name
      169                                       )
      170               .
      171           end.
      172       end.
      173   end.
      174   end procedure.
      175   procedure schemlib-set-buffer :
      176   define input parameter p-table-name     as character        no-undo.
      177   define input parameter p-field-list     as character        no-undo.
      178   define input parameter p-value-list     as character        no-undo.
      179   define output parameter p-buffer-handle as handle           no-undo.
      180       define variable v-query-handle      as handle       no-undo.
      181       define variable v-query-string      as character    no-undo.
      182       define variable v-field-handle      as handle       no-undo.
      183       define variable v-field-name        as character    no-undo.
      184       define variable v-field-value       as character    no-undo.
      185       define variable v-field-counter     as integer      no-undo.
      186       define variable v-counter           as integer      no-undo.
      187       define variable v-field-type        as character    no-undo.
      188   do
      189   on error undo, return error
      190   :
      191       assign
      192           v-field-counter = num-entries( p-field-list )
      193       .
      194       if v-field-counter <> num-entries( p-value-list )
      195       then do:
      196           undo, return error substitute( "schemlib-set-buffer. Указан список значений '&1', не соответствующий списку полей '&2'."
      197                       , p-value-list
      198                       , p-field-list ).
      199       end.
      200       create buffer p-buffer-handle for table p-table-name.
      201       create query v-query-handle.
      202       v-query-handle :set-buffers( p-buffer-handle ).
      203       assign
      204           v-query-string  = substitute( "for each &1 no-lock":U, p-table-name )
      205       .
      206       do v-counter = 1 to v-field-counter
      207       on error undo, return error
      208       :
      209           assign
      210               v-field-name  = entry( v-counter, p-field-list )
      211               v-field-value = entry( v-counter, p-value-list )
      212           .
      213           assign
      214               v-field-handle = p-buffer-handle :buffer-field( v-field-name )
      215           .
      216           if not valid-handle( v-field-handle )
      217           then do:
      218               undo, return error substitute( "schemlib-set-buffer. Не найдено поле '&1' в таблице '&2'."
      219                       , v-field-name
      220                       , p-table-name ).
      221           end.
      222           assign
      223               v-field-type = v-field-handle :data-type
      224           .
      225           assign
      226               v-query-string  = substitute( "&1&2&3.&4=&5&6&5":U
      227                   , v-query-string
      228                   , ( if v-counter = 1 then " where ":U else " and ":U )
      229                   , p-table-name
      230                   , v-field-name
      231                   , ( if v-field-type = "character":U then '"':U else "":U )
      232                   , v-field-value
      233                   )
      234           .
      235       end.
      236       v-query-handle :query-prepare( v-query-string ).
      237       v-query-handle :query-open.
      238       v-query-handle :get-first( no-lock ).
      239       delete object v-query-handle.
      240   end.
      241   end procedure.
      242   FUNCTION get-nik RETURNS CHARACTER
      243     ( input p-userid as character )  FORWARD.
      244   DEFINE BUTTON b-cancel AUTO-END-KEY
      245        LABEL "&Отмена"
      246        SIZE 10 BY 1
      247        BGCOLOR 8 .
      248   DEFINE BUTTON b-exit AUTO-GO
      249        LABEL "В&ыход"
      250        SIZE 10 BY 1
      251        BGCOLOR 8 .
      252   DEFINE BUTTON b-help
      253        LABEL "Помо&щь"
      254        SIZE 10 BY 1
      255        BGCOLOR 8 .
      256   DEFINE QUERY br-lines FOR
      257         temp_fbr-history-line SCROLLING.
      258   DEFINE QUERY br-table FOR
      259         temp_fbr-history SCROLLING.
      260   DEFINE BROWSE br-lines
      261     QUERY br-lines NO-LOCK DISPLAY
      262         temp_fbr-history-line.fblLabel     FORMAT "X(40)":U column-label "Поле"
      263         temp_fbr-history-line.fblOldValue  FORMAT "X(40)":U column-label "Старое значение"
      264         temp_fbr-history-line.fblNewValue  FORMAT "X(40)":U column-label "Значение после изменения"
      265         temp_fbr-history-line.fblFieldName FORMAT "X(20)":U column-label "Имя поля"
      266         temp_fbr-history-line.fblType      FORMAT "X(20)":U column-label "Тип поля"
      267       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6.13 FIT-LAST-COLUMN.
      268   DEFINE BROWSE br-table
      269     QUERY br-table NO-LOCK DISPLAY
      270         temp_fbr-history.fbhType    format "X(10)" label "Тип"
      271       temp_fbr-history.fbhAction  format "X(10)" label "Действие"
      272       temp_fbr-history.fbhDate    format "X(10)" label "ДатаКорр"
      273       temp_fbr-history.fbhTime    format "X(10)" label "ВремяКорр"
      274       temp_fbr-history.fbhUser    format "X(30)" label "Пользователь"
      275       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14.75 FIT-LAST-COLUMN.
      276   DEFINE FRAME Dialog-Frame
      277        b-exit AT ROW 1 COL 1
      278        b-cancel AT ROW 1 COL 11
      279        b-help AT ROW 1 COL 89.5
      280        br-table AT ROW 2.5 COL 1.5 WIDGET-ID 200
      281        br-lines AT ROW 17.5 COL 1 WIDGET-ID 300
      282        SPACE(0.37) SKIP(0.00)
      283       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      284            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      285            TITLE "История документа производства"
      286            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel WIDGET-ID 100.
      287   ASSIGN
      288          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      289          FRAME Dialog-Frame:HIDDEN           = TRUE.
      290   ASSIGN
      291          br-lines:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
      292   ASSIGN
      293          br-table:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
      294   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      295   DO:
      296     APPLY "END-ERROR":U TO SELF.
      297   END.
      298   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      299   DO:
      300   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   if lookup(self :type
      302            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      303            ) = 0
      304   then do:
      305     message
      306       "$Workfile$"
      307       "Указанному интерфейсному элементу фокус не может быть передан" skip
      308       "Интерфейсный элемент" self :name  skip
      309       "Тип" self :type  skip
      310       "Процедура" this-procedure :file-name skip
      311       view-as alert-box .
      312   end.
      313   else do:
      314     apply "entry":u to self  .
      315     if focus :handle <> self :handle  then do:
      316       return no-apply .
      317     end.
      318   end.
      319   END.
      320   ON VALUE-CHANGED OF br-table IN FRAME Dialog-Frame
      321   DO:
      322       if available temp_fbr-history
      323       then do:
      324           run manage-fields in this-procedure (
      325               input temp_fbr-history.fbh-key
      326           ).
      327       end.
      328       run local-open-query-line in this-procedure. .
      329   END.
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   on help of frame Dialog-Frame
      332   do:
      333     run gbl/app_help.p
      334       (input this-procedure :file-name
      335       ,input ''
      336       ,input ?
      337       ) no-error.
      338     if error-status :error then do:
      339       message
      340         "Ошибка при вызове помощи"
      341         error-status :get-message(1)
      342         view-as alert-box .
      343     end.
      344   end.
      345   run minbtn-set in this-procedure .
      346   on choose of b-help in frame Dialog-Frame
      347   do:
      348     apply "help":u to frame Dialog-Frame .
      349   end.
      350   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   procedure minbtn-set :
      352       do
      353           on error undo, return error return-value
      354           :
      355           define variable ii              as integer       no-undo .
      356           define variable fh              as widget-handle no-undo .
      357           define variable hh              as widget-handle no-undo .
      358           define variable v-h             as handle        extent 4 no-undo .
      359           define variable v-name-button   as character     no-undo .
      360           define variable v-help-old-x    as decimal       no-undo .
      361           define variable v-help-old-y    as decimal       no-undo .
      362           define variable v-help-old-size as decimal       no-undo .
      363           define variable v-frame-width   as decimal       no-undo .
      364           define variable jj              as integer       no-undo .
      365           do
      366               on error undo, return error
      367               :
      368               assign
      369                   v-frame-width = frame Dialog-Frame:width - 0.3
      370                   fh            = frame Dialog-Frame:first-child
      371                   hh            = fh:first-child
      372                   ii            = 1
      373                   .
      374               do while valid-handle(hh):
      375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      376                   do:
      377                       case lc(hh:name) :
      378                           when "b-help" then
      379                               do:
      380                                   hh:load-image-up("cmp/b-help.bmp":u) .
      381                                   hh:load-image-down("cmp/b-help.bmp":u) .
      382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      383                                   hh:TOOLTIP = "Помощь" .
      384                                   v-help-old-x = hh:column .
      385                                   v-help-old-y = hh:row    .
      386                                   v-help-old-size = hh:width .
      387                                   hh:width-chars = 2.5 .
      388                               end.
      389                           when "b-print" then
      390                               do:
      391                                   hh:load-image("cmp/b-print.bmp":u) .
      392                                   hh:TOOLTIP = "Печать" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-history" or
      398                           when "b-hist" then
      399                               do:
      400                                   hh:load-image("cmp/b-hist.bmp":u) .
      401                                   hh:TOOLTIP = "История" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-sch" then
      407                               do:
      408                                   hh:load-image("cmp/b-sch.bmp":u) .
      409                                   hh:TOOLTIP = "Установка Фильтра" .
      410                                   v-h[ii] = hh:handle .
      411                                   ii = ii + 1 .
      412                                   hh:width-chars = 3 .
      413                               end.
      414                           when "b-hist-user" then
      415                               do:
      416                                   hh:load-image("cmp/b-hist.bmp":u) .
      417                                   hh:TOOLTIP = "История пользователя" .
      418                                   ii = ii + 1 .
      419                               end.
      420                       end case.
      421                   end.
      422                   hh = hh:next-sibling.
      423               end.
      424               b-help:column = v-frame-width - b-help:width-chars.
      425               jj = 0.
      426               repeat ii = 4 to 1 by -1 :
      427                   if valid-handle (v-h[ii] ) then
      428                   do:
      429                       jj  = jj + 1 .
      430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      431                       v-h[ii]:row    = v-help-old-y .
      432                   end.
      433               end.
      434           end.
      435       end.
      436   end procedure.
      437   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      438   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      439   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      440   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      441   define variable v-diasize-current-frame-width  as decimal   no-undo .
      442   define variable v-diasize-current-frame-height as decimal   no-undo .
      443   define variable v-diasize-change-size          as logical   no-undo .
      444   define variable v-diasize-resize-button        as handle    no-undo .
      445   define variable v-diasize-wndmax               as logical   no-undo .
      446   define variable v-diasize-wndstore             as logical   no-undo .
      447   define variable v-diasize-proc-name            as character no-undo .
      448   define variable v-diasize-browse-handle        as handle    no-undo .
      449   define variable v-diasize-browse-number        as integer   no-undo .
      450   define variable v-diasize-need-full-display    as logical   no-undo init false .
      451   define temp-table temp-diasize-handle no-undo
      452     field handle-value  as handle
      453     field save-position as decimal
      454     index xpk is primary unique handle-value
      455     .
      456   define temp-table temp-browse-handle no-undo
      457     field browse-type   as character
      458     field browse-number as integer
      459     field browse-handle as handle
      460     field original-size as decimal
      461     index xpk is primary unique browse-type browse-number
      462     index xie browse-type browse-handle
      463   .
      464   procedure diasize_change-height :
      465     define input  parameter p-change-value  as decimal   no-undo .
      466     define input  parameter p-move-resize   as logical   no-undo .
      467     define variable v-field-group-handle    as handle    no-undo .
      468     define variable v-object-handle         as handle    no-undo .
      469     define variable v-frame-height          as decimal   no-undo .
      470     define variable v-frame-virtual-height  as decimal   no-undo .
      471     define variable v-browse-height         as decimal   no-undo .
      472     define variable v-window-height         as decimal   no-undo .
      473     define variable v-window-virtual-height as decimal   no-undo .
      474     define variable v-change-sign           as integer   no-undo .
      475     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      476     define buffer buf_temp-browse-handle  for temp-browse-handle .
      477     if p-change-value > 0
      478     then do:
      479       if frame Dialog-Frame :height + p-change-value
      480           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      481       then do:
      482         assign
      483           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      484                           - (frame Dialog-Frame :height-chars)
      485         .
      486         if p-change-value <= 0
      487         then do:
      488           run diasize_position-resize-button in this-procedure .
      489           return .
      490         end.
      491       end.
      492     end.
      493     if p-change-value < 0
      494     then do:
      495       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      496       then do:
      497         assign
      498           p-change-value = v-diasize-orig-frame-height
      499                          - (frame Dialog-Frame :height-chars)
      500         .
      501         if p-change-value >= 0
      502         then do:
      503           run diasize_position-resize-button in this-procedure .
      504           return .
      505         end.
      506       end.
      507     end.
      508     if p-change-value >= 0
      509     then do:
      510       assign
      511         v-change-sign = 1
      512       .
      513     end.
      514     else do:
      515       assign
      516         v-change-sign = -1
      517       .
      518     end.
      519     assign
      520       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      521     .
      522     if p-change-value = 0
      523     then do:
      524       run diasize_position-resize-button in this-procedure .
