      861     define variable v-change-sign          as integer   no-undo .
      862     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      863     define buffer buf_temp-browse-handle  for temp-browse-handle .
      864     if p-change-value > 0
      865     then do:
      866       if frame Dialog-Frame :width + p-change-value >
      867           session :width-chars
      868       then do:
      869         assign
      870           p-change-value = session :width-chars - frame Dialog-Frame :width
      871         .
      872         if p-change-value <= 0
      873         then do:
      874           run diasize_position-resize-button in this-procedure .
      875           return .
      876         end.
      877       end.
      878     end.
      879     if p-change-value < 0
      880     then do:
      881       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      882       then do:
      883         assign
      884           p-change-value = v-diasize-orig-frame-width
      885                          - frame Dialog-Frame :width
      886         .
      887         if p-change-value >= 0
      888         then do:
      889           run diasize_position-resize-button in this-procedure .
      890           return .
      891         end.
      892       end.
      893     end.
      894     if p-change-value >= 0
      895     then do:
      896       assign
      897         v-change-sign = 1
      898       .
      899     end.
      900     else do:
      901       assign
      902         v-change-sign = -1
      903       .
      904     end.
      905     assign
      906       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      907     .
      908     if p-change-value = 0
      909     then do:
      910       run diasize_position-resize-button in this-procedure .
      911       return .
      912     end.
