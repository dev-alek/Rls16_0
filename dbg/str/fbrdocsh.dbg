     1164             no-error .
     1165           if error-status :error
     1166           or error-status :get-message(1) <> ""
     1167           then do:
     1168             undo move_block, retry move_block .
     1169           end.
     1170         end.
     1171         assign
     1172           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1173           no-error .
     1174         if error-status :error
     1175         or error-status :get-message(1) <> ""
     1176         then do:
     1177           undo move_block, retry move_block.
     1178         end.
     1179         assign
     1180           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1181         no-error .
     1182         if error-status :error
     1183         or error-status :get-message(1) <> ""
     1184         then do:
     1185           undo move_block, retry move_block.
     1186         end.
     1187         if frame Dialog-Frame :scrollable = true
     1188         then do:
     1189           assign
     1190             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1191           no-error .
     1192           if error-status :error
     1193           or error-status :get-message(1) <> ""
     1194           then do:
     1195             undo move_block, retry move_block.
     1196           end.
     1197         end.
     1198       end.
     1199       if p-move-resize
     1200       then do:
     1201         run diasize_position-resize-button in this-procedure .
     1202       end.
     1203       if v-diasize-wndstore = true
     1204       then do:
     1205         if connected("ub") = true
     1206         then do:
     1207           define variable v-cntxt-db-num        as integer   no-undo .
     1208           define variable v-cntxt-userid        as character no-undo .
     1209           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1210                                             , OUTPUT v-cntxt-userid
     1211                                             ) .
     1212           run gbl/wndsizew.p
     1213             (input  v-cntxt-db-num
     1214             ,input  v-cntxt-userid
     1215             ,input  v-diasize-proc-name
     1216             ,input  'width':u
     1217             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1218             ) .
     1219         end.
     1220       end.
     1221     end.
     1222     assign
     1223       v-diasize-change-size = false
     1224     .
     1225   end procedure.
     1226   procedure diasize_set-width :
     1227     define input  parameter p-new-width  as decimal   no-undo .
     1228     define input  parameter p-move-resize as logical   no-undo .
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232       run diasize_change-width in this-procedure
     1233         (input  (p-new-width - frame Dialog-Frame :width)
     1234         ,input  p-move-resize
     1235         ) .
     1236     end.
     1237   end procedure.
     1238   procedure diasize_position-resize-button :
     1239     do with frame Dialog-Frame
     1240     :
     1241       hide v-diasize-resize-button .
     1242       assign
     1243         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1244                     - 1
     1245                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1246         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1247                     - 1
     1248                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1249       .
     1250       view v-diasize-resize-button .
     1251     end.
     1252   end procedure.
     1253   on alt-right anywhere
     1254   do:
     1255     run diasize_change-width in this-procedure
     1256       (input 1
     1257       ,input true
     1258       ) .
     1259     return no-apply .
     1260   end.
     1261   on alt-left anywhere
     1262   do:
     1263     run diasize_change-width in this-procedure
     1264       (input -1
     1265       ,input true
     1266       ) .
     1267     return no-apply .
     1268   end.
     1269   on alt-down anywhere
     1270   do:
     1271     run diasize_change-height in this-procedure
     1272       (input 1
     1273       ,input true
     1274       ) .
     1275     return no-apply .
     1276   end.
     1277   on alt-up anywhere
     1278   do:
     1279     run diasize_change-height in this-procedure
     1280       (input -1
     1281       ,input true
     1282       ) .
     1283     return no-apply .
     1284   end.
     1285   on alt-enter of frame Dialog-Frame
     1286   do:
     1287     run diasize_maximize in this-procedure
     1288       (input  ?
     1289       ).
     1290     return no-apply .
     1291   end.
     1292   procedure diasize_end-move :
     1293     do
     1294     on error undo, return error return-value
     1295     :
     1296       define variable v-row-delta as decimal   no-undo .
     1297       define variable v-col-delta as decimal   no-undo .
     1298       define variable v-new-row as decimal   no-undo .
     1299       define variable v-new-col as decimal   no-undo .
     1300       assign
     1301         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1302         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1303       .
     1304       assign
     1305         v-row-delta = v-new-row - frame Dialog-Frame :height
     1306         v-col-delta = v-new-col - frame Dialog-Frame :width
     1307       .
     1308       run diasize_change-height in this-procedure
     1309         (input v-row-delta
     1310         ,input true
     1311         ) .
     1312       run diasize_change-width in this-procedure
     1313         (input v-col-delta
     1314         ,input true
     1315         ) .
     1316     end.
     1317   end procedure.
     1318   procedure diasize_maximize :
     1319     define input  parameter p-action as logical   no-undo .
     1320     do
     1321     on error undo, return error return-value
     1322     :
     1323       if p-action = ?
     1324       then do:
     1325         if v-diasize-need-maximize = true
     1326         then do:
     1327           assign
     1328             p-action = true
     1329           .
     1330         end.
     1331         else do:
     1332           assign
     1333             p-action = false
     1334           .
     1335         end.
     1336       end.
     1337       if p-action = true
     1338       then do:
     1339         run diasize_change-height in this-procedure
     1340           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1341               - frame Dialog-Frame :height-chars
     1342           ,input true
     1343           ) .
     1344         run diasize_change-width in this-procedure
     1345           (input session :width-chars
     1346               - frame Dialog-Frame :width-chars
     1347           ,input true
     1348           ) .
     1349         assign
     1350           v-diasize-need-maximize = false
     1351         .
     1352       end.
     1353       else do:
     1354         run diasize_change-width in this-procedure
     1355           (input v-diasize-orig-frame-width
     1356               - frame Dialog-Frame :width-chars
     1357           ,input true
     1358           ) .
     1359         run diasize_change-height in this-procedure
     1360           (input v-diasize-orig-frame-height
     1361               - frame Dialog-Frame :height-chars
     1362           ,input true
     1363           ) .
     1364         assign
     1365           v-diasize-need-maximize = true
     1366         .
     1367       end.
     1368     end.
     1369   end procedure.
     1370   procedure diasize_restore-orig-size :
     1371     do
     1372     on error undo, return error return-value
     1373     :
     1374       assign
     1375         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1376         v-diasize-current-frame-height = frame Dialog-Frame :height
     1377       .
     1378       run diasize_set-height in this-procedure
     1379         (input  v-diasize-orig-frame-height
     1380         ,input  true
     1381         ) .
     1382       run diasize_set-width in this-procedure
     1383         (input  v-diasize-orig-frame-width
     1384         ,input  true
     1385         ) .
     1386     end.
     1387   end procedure.
     1388   procedure diasize_restore-current-size :
     1389     do
     1390     on error undo, return error return-value
     1391     :
     1392       run diasize_set-height in this-procedure
     1393         (input  v-diasize-current-frame-height
     1394         ,input  true
     1395         ) .
     1396       run diasize_set-width in this-procedure
     1397         (input  v-diasize-current-frame-width
     1398         ,input  true
     1399         ) .
     1400     end.
     1401   end procedure.
     1402   procedure diasize_set-browse-handle :
     1403     define input  parameter p-browse-handle as handle   no-undo .
     1404     define buffer buf_temp-browse-handle for temp-browse-handle .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       assign
     1409         v-diasize-browse-handle = p-browse-handle
     1410       .
     1411       for each buf_temp-browse-handle
     1412       on error undo, return error return-value
     1413       :
     1414         delete buf_temp-browse-handle .
     1415       end.
     1416     end.
     1417   end procedure.
     1418   procedure diasize_add_browse :
     1419     define input  parameter p-browse-type   as character no-undo .
     1420     define input  parameter p-browse-handle as handle    no-undo .
     1421     define buffer buf_temp-browse-handle for temp-browse-handle .
     1422     do
     1423     on error undo, return error return-value
     1424     :
     1425       assign
     1426         v-diasize-browse-number = v-diasize-browse-number + 1
     1427       .
     1428       create buf_temp-browse-handle .
     1429       assign
     1430         buf_temp-browse-handle.browse-type   = p-browse-type
     1431         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1432         buf_temp-browse-handle.browse-handle = p-browse-handle
     1433       .
     1434     end.
     1435   end procedure.
     1436   procedure diasize_init :
     1437     define variable v-default-value    as logical   no-undo .
     1438     define variable v-restore-saved    as logical   no-undo .
     1439     define variable v-resize-value-str as character no-undo .
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443       do with frame Dialog-Frame
     1444       :
     1445         assign
     1446           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1447           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1448           v-diasize-browse-handle     = browse br-lines :handle
     1449         .
     1450         create button v-diasize-resize-button
     1451         assign
     1452           parent        = frame Dialog-Frame :first-child
     1453           label         = "s"
     1454           height-pixels = 16
     1455           width-pixels  = 16
     1456           visible       = true
     1457           sensitive     = true
     1458           movable       = true
     1459           triggers:
     1460             on end-move persistent run diasize_end-move in this-procedure .
     1461           end triggers.
     1462         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1463         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1464         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1465         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1466         assign
     1467           v-diasize-wndmax = false
     1468         .
     1469         if connected("ub") = true
     1470         then do:
     1471           define variable v-cntxt-db-num        as integer   no-undo .
     1472           define variable v-cntxt-userid        as character no-undo .
     1473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1474                                             , OUTPUT v-cntxt-userid
     1475                                             ) .
     1476           run gbl/wndpar_r.p
     1477             (input  v-cntxt-db-num
     1478             ,input  v-cntxt-userid
     1479             ,input  'wndmax':U
     1480             ,output v-diasize-wndmax
     1481             ,output v-default-value
     1482             ) .
     1483         end.
     1484         assign
     1485           v-diasize-wndstore = false
     1486         .
     1487         if connected("ub") = true
     1488         then do:
     1489           run gbl/wndpar_r.p
     1490             (input  v-cntxt-db-num
     1491             ,input  v-cntxt-userid
     1492             ,input  'wndstore':U
     1493             ,output v-diasize-wndstore
     1494             ,output v-default-value
     1495             ) .
     1496         end.
     1497         assign
     1498           v-diasize-proc-name = entry(1, program-name(2), '.')
     1499         .
     1500         if v-diasize-wndstore = true
     1501         then do:
     1502           assign
     1503             v-restore-saved = false
     1504           .
     1505           if connected("ub") = true
     1506           then do:
     1507             run gbl/wndsizer.p
     1508               (input  v-cntxt-db-num
     1509               ,input  v-cntxt-userid
     1510               ,input  v-diasize-proc-name
     1511               ,input  'height':u
     1512               ,output v-resize-value-str
     1513               ) .
     1514             if v-resize-value-str <> '':U
     1515             then do:
     1516               run diasize_change-height in this-procedure
     1517                 (input  integer(v-resize-value-str)
     1518                 ,input  true
     1519                 ) .
     1520               assign
     1521                 v-restore-saved = true
     1522               .
     1523             end.
     1524           end.
     1525           if connected("ub") = true
     1526           then do:
     1527             run gbl/wndsizer.p
     1528               (input  v-cntxt-db-num
     1529               ,input  v-cntxt-userid
     1530               ,input  v-diasize-proc-name
     1531               ,input  'width':u
     1532               ,output v-resize-value-str
     1533               ) .
     1534             if v-resize-value-str <> '':U
     1535             then do:
     1536               run diasize_change-width in this-procedure
     1537                 (input  integer(v-resize-value-str)
     1538                 ,input  true
     1539                 ) .
     1540               assign
     1541                 v-restore-saved = true
     1542               .
     1543             end.
     1544           end.
     1545           if v-restore-saved <> true
     1546           then do:
     1547             if v-diasize-wndmax = true
     1548             then do:
     1549               run diasize_maximize in this-procedure
     1550                 (input  true
     1551                 ) .
     1552             end.
     1553           end.
     1554         end.
     1555         else do:
     1556           if v-diasize-wndmax = true
     1557           then do:
     1558             run diasize_maximize in this-procedure
     1559               (input  true
     1560               ) .
     1561           end.
     1562         end.
     1563       end.
     1564     end.
     1565   end procedure.
     1566   procedure diasize_need-full-display :
     1567     define output parameter p-need-full-display as logical   no-undo .
     1568     do
     1569     on error undo, return error return-value
     1570     :
     1571       assign
     1572         p-need-full-display = v-diasize-need-full-display
     1573       .
     1574       assign
     1575         v-diasize-need-full-display = false
     1576       .
     1577     end.
     1578   end procedure.
     1579   procedure get-context :
     1580      define output parameter p-db-num as integer          no-undo.
     1581      define output parameter p-user-id as character        no-undo.
     1582      define variable v-login               as character    no-undo.
     1583      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1584      define buffer buf_user-login  for ub.user-login .
     1585      do
     1586      on error undo, return error
     1587      :
     1588            FIND FIRST buf_sys-ctrl no-lock.
     1589            ASSIGN
     1590               v-login = USERID("ub")
     1591               p-db-num = buf_sys-ctrl.db-num
     1592            .
     1593            FIND FIRST buf_user-login
     1594                 WHERE buf_user-login.db-num = p-db-num
     1595                   AND buf_user-login.user-login = v-login
     1596                 no-lock
     1597                 no-error
     1598                 .
     1599            IF AVAILABLE buf_user-login
     1600            THEN DO:
     1601               assign
     1602                  p-user-id = buf_user-login.user-id
     1603               .
     1604            END.
     1605      end.
     1606   end procedure.
     1607       run diasize_init in this-procedure .
     1608   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1609   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1610   MAIN-BLOCK:
     1611   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1612      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1613       run init-fields in this-procedure .
     1614       RUN enable_UI.
     1615       apply "entry":U to br-table.
     1616       run local-open-query-line in this-procedure. .
     1617       WAIT-FOR GO OF FRAME Dialog-Frame.
     1618   END.
     1619   RUN disable_UI.
     1620   PROCEDURE create-field-exception :
     1621   define input parameter p-name     as character        no-undo.
     1622   define input parameter p-label    as character        no-undo.
     1623   define input parameter p-format   as character        no-undo.
     1624   define input parameter p-visible  as logical          no-undo.
     1625       define buffer buf_temp_fbr-history-fields       for temp_fbr-history-fields.
     1626   do
     1627   for buf_temp_fbr-history-fields
     1628   on error undo, return error
     1629   :
     1630       assign
     1631           v-fbrdocsh-fbf-key = v-fbrdocsh-fbf-key + 1
     1632       .
     1633       create buf_temp_fbr-history-fields.
     1634       assign
     1635           buf_temp_fbr-history-fields.fbf-key     = v-fbrdocsh-fbf-key
     1636           buf_temp_fbr-history-fields.fbfName     = p-name
     1637           buf_temp_fbr-history-fields.fbfLabel    = p-label
     1638           buf_temp_fbr-history-fields.fbfFormat   = p-format
     1639           buf_temp_fbr-history-fields.fbfVisible  = p-visible
     1640       .
     1641   end.
     1642   END PROCEDURE.
     1643   PROCEDURE disable_UI :
     1644     HIDE FRAME Dialog-Frame.
     1645   END PROCEDURE.
     1646   PROCEDURE enable_UI :
     1647     ENABLE b-exit b-cancel b-help br-table br-lines
     1648         WITH FRAME Dialog-Frame.
     1649     VIEW FRAME Dialog-Frame.
     1650     run local-open-query-line in this-procedure. .    run local-open-query in this-procedure. .
     1651   END PROCEDURE.
     1652   PROCEDURE init-fields :
     1653       define variable v-buffer-handle     as handle       no-undo.
     1654       define variable v-old-buffer-handle as handle       no-undo.
     1655       define variable v-counter           as integer      no-undo.
     1656       define variable v-num-fields        as integer      no-undo.
     1657       define variable v-field-handle      as handle       no-undo.
     1658       define variable v-query-handle      as handle       no-undo.
     1659       define variable v-query             as character    no-undo.
     1660       define variable v-changes           as character    no-undo.
     1661       define buffer buf_temp_fbr-history          for temp_fbr-history.
     1662       define buffer buf_temp_fbr-history-line     for temp_fbr-history-line.
     1663       define buffer buf_temp_fbr-history-fields   for temp_fbr-history-fields.
     1664   do
     1665   for buf_temp_fbr-history
     1666     , buf_temp_fbr-history-line
     1667     , buf_temp_fbr-history-fields
     1668   on error undo, return error
     1669   :
     1670       run create-field-exception in this-procedure ( input "pay-code":U       , input "Код оплаты"    , input "":U        , input yes ).
     1671       run create-field-exception in this-procedure ( input "sys-time-int":U   , input "Время(целое)"  , input "":U        , input no  ).
     1672       run create-field-exception in this-procedure ( input "corr-time":U      , input "":U            , input "HH:MM:SS":U, input yes  ).
     1673       create buffer v-buffer-handle       for table "c-fbr-doc":U buffer-name "buf_c-fbr-doc":U .
     1674       create buffer v-old-buffer-handle   for table "c-fbr-doc":U buffer-name "buf_new_c-fbr-doc":U .
     1675       assign
     1676           v-num-fields = v-buffer-handle :num-fields
     1677       .
     1678       create query v-query-handle .
     1679       v-query-handle :set-buffers( v-buffer-handle ).
     1680       assign
     1681           v-query     = substitute( "for each buf_c-fbr-doc where buf_c-fbr-doc.doc-code = '&1'"
     1682                                   , p-fbr-doc-code )
     1683       .
     1684       v-query-handle :query-prepare( v-query ).
     1685       v-query-handle :query-open.
     1686       v-query-handle :get-first.
     1687       if v-query-handle :query-off-end = no
     1688       then do:
     1689           assign
     1690               v-fbrdocsh-fbh-key              = v-fbrdocsh-fbh-key + 1
     1691           .
     1692           create buf_temp_fbr-history.
     1693           assign
     1694               buf_temp_fbr-history.fbh-key    = v-fbrdocsh-fbh-key
     1695               buf_temp_fbr-history.fbhType    = "Документ"
     1696               buf_temp_fbr-history.fbhAction  = "Создание"
     1697               buf_temp_fbr-history.fbhDate    = string( v-buffer-handle :buffer-field ( "corr-date":U )       :buffer-value, "99.99.9999":U )
     1698               buf_temp_fbr-history.fbhTime    = string( v-buffer-handle :buffer-field ( "corr-time":U )       :buffer-value, "HH:MM":U      )
     1699               buf_temp_fbr-history.fbhUser    = v-buffer-handle         :buffer-field ( "corr-user-name":U )  :buffer-value
     1700           .
     1701           do v-counter = 1 to v-num-fields
     1702           on error undo, return error substitute( "&1. &2", vss-workfile, error-status :get-message ( 1 ) )
     1703           :
     1704               assign
     1705                   v-fbrdocsh-fbl-key              = v-fbrdocsh-fbl-key + 1
     1706               .
     1707               create buf_temp_fbr-history-line.
     1708               assign
     1709                   buf_temp_fbr-history-line.fbl-key       = v-fbrdocsh-fbl-key
     1710                   buf_temp_fbr-history-line.fbh-key       = buf_temp_fbr-history.fbh-key
     1711                   buf_temp_fbr-history-line.fblLabel      = v-buffer-handle :buffer-field( v-counter ) :label
     1712                   buf_temp_fbr-history-line.fblOldValue   = "":U
     1713                   buf_temp_fbr-history-line.fblNewValue   = string( v-buffer-handle :buffer-field( v-counter ) :buffer-value )
     1714                   buf_temp_fbr-history-line.fblFieldName  = v-buffer-handle :buffer-field( v-counter ) :name
     1715                   buf_temp_fbr-history-line.fblVisible    = yes
     1716                   buf_temp_fbr-history-line.fblType       = v-buffer-handle :buffer-field( v-counter ) :data-type
     1717               .
     1718               find first buf_temp_fbr-history-fields
     1719                    where buf_temp_fbr-history-fields.fbfName = buf_temp_fbr-history-line.fblFieldName
     1720               no-error.
     1721               if available buf_temp_fbr-history-fields
     1722               then do:
     1723                   if buf_temp_fbr-history-fields.fbfFormat <> "":U
     1724                   then do:
     1725                       assign
     1726                           buf_temp_fbr-history-line.fblNewValue      = string( v-buffer-handle :buffer-field( v-counter ) :buffer-value, buf_temp_fbr-history-fields.fbfFormat )
     1727                       .
     1728                   end.
     1729                   if buf_temp_fbr-history-fields.fbfLabel <> "":U
     1730                   then do:
     1731                       assign
     1732                           buf_temp_fbr-history-line.fblLabel      = buf_temp_fbr-history-fields.fbfLabel
     1733                       .
     1734                   end.
     1735                   assign
     1736                       buf_temp_fbr-history-line.fblVisible    = buf_temp_fbr-history-fields.fbfVisible
     1737                   .
     1738               end.
     1739           end.
     1740           calc-changes:
     1741           do
     1742           while yes
     1743           on error undo, return error
     1744           :
     1745               run schemlib-set-buffer in this-procedure (
     1746                     input "c-fbr-doc":U
     1747                   , input "doc-code,corr-user-db-num,chip-num":U
     1748                   , input substitute( "&1,&2,&3"
     1749                                       , v-buffer-handle :buffer-field( "doc-code":U ) :buffer-value
     1750                                       , v-buffer-handle :buffer-field( "corr-user-db-num":U ) :buffer-value
     1751                                       , v-buffer-handle :buffer-field( "chip-num":U ) :buffer-value
     1752                                       )
     1753                   , output v-old-buffer-handle
     1754               ).
     1755               v-query-handle :get-next( no-lock ).
     1756               if v-query-handle :query-off-end = yes
     1757               then do:
     1758                   undo calc-changes, leave calc-changes.
     1759               end.
     1760               else do:
     1761                   assign
     1762                       v-fbrdocsh-fbh-key              = v-fbrdocsh-fbh-key + 1
     1763                   .
     1764                   create buf_temp_fbr-history.
     1765                   assign
     1766                       buf_temp_fbr-history.fbh-key    = v-fbrdocsh-fbh-key
     1767                       buf_temp_fbr-history.fbhType    = "Документ"
     1768                       buf_temp_fbr-history.fbhAction  = "Изменение"
     1769                       buf_temp_fbr-history.fbhDate    = string( v-old-buffer-handle :buffer-field ( "corr-date":U )       :buffer-value, "99.99.9999":U )
     1770                       buf_temp_fbr-history.fbhTime    = string( v-old-buffer-handle :buffer-field ( "corr-time":U )       :buffer-value, "HH:MM":U      )
     1771                       buf_temp_fbr-history.fbhUser    = v-old-buffer-handle         :buffer-field ( "corr-user-name":U )  :buffer-value
     1772                   .
     1773                   do v-counter = 1 to v-num-fields
     1774                   on error undo, return error substitute( "&1. &2", vss-workfile, error-status :get-message ( 1 ) )
     1775                   :
     1776                       assign
     1777                           v-field-handle = v-buffer-handle :buffer-field( v-counter )
     1778                       .
     1779                       if v-field-handle :buffer-value <> v-old-buffer-handle :buffer-field ( v-counter ) :buffer-value
     1780                       then do:
     1781                           assign
     1782                               v-fbrdocsh-fbl-key              = v-fbrdocsh-fbl-key + 1
     1783                           .
     1784                           create buf_temp_fbr-history-line.
     1785                           assign
     1786                               buf_temp_fbr-history-line.fbl-key       = v-fbrdocsh-fbl-key
     1787                               buf_temp_fbr-history-line.fbh-key       = buf_temp_fbr-history.fbh-key
     1788                               buf_temp_fbr-history-line.fblLabel      = v-buffer-handle :buffer-field( v-counter ) :label
     1789                               buf_temp_fbr-history-line.fblOldValue   = string( v-old-buffer-handle :buffer-field ( v-counter ) :buffer-value )
     1790                               buf_temp_fbr-history-line.fblNewValue   = string( v-field-handle :buffer-value )
     1791                               buf_temp_fbr-history-line.fblFieldName  = v-buffer-handle :buffer-field( v-counter ) :name
     1792                               buf_temp_fbr-history-line.fblType       = v-buffer-handle :buffer-field( v-counter ) :data-type
     1793                               buf_temp_fbr-history-line.fblVisible    = yes
     1794                           .
     1795                           find first buf_temp_fbr-history-fields
     1796                                where buf_temp_fbr-history-fields.fbfName = buf_temp_fbr-history-line.fblFieldName
     1797                           no-error.
     1798                           if available buf_temp_fbr-history-fields
     1799                           then do:
     1800                               if buf_temp_fbr-history-fields.fbfFormat <> "":U
     1801                               then do:
     1802                                   assign
     1803                                       buf_temp_fbr-history-line.fblOldValue      = string( v-old-buffer-handle :buffer-field ( v-counter ) :buffer-value  , buf_temp_fbr-history-fields.fbfFormat )
     1804                                       buf_temp_fbr-history-line.fblNewValue      = string( v-field-handle :buffer-value                                   , buf_temp_fbr-history-fields.fbfFormat )
     1805                                   .
     1806                               end.
     1807                               if buf_temp_fbr-history-fields.fbfLabel <> "":U
     1808                               then do:
     1809                                   assign
     1810                                       buf_temp_fbr-history-line.fblLabel      = buf_temp_fbr-history-fields.fbfLabel
     1811                                   .
     1812                               end.
     1813                               assign
     1814                                   buf_temp_fbr-history-line.fblVisible    = buf_temp_fbr-history-fields.fbfVisible
     1815                               .
     1816                           end.
     1817                       end.
     1818                   end.
     1819               end.
     1820           end.
     1821       end.
     1822   end.
     1823   END PROCEDURE.
     1824   PROCEDURE local-open-query :
     1825   do
     1826   on error undo, return error
     1827   :
     1828       open query br-table
     1829         for each temp_fbr-history no-lock
     1830       .
     1831   end.
     1832   END PROCEDURE.
     1833   PROCEDURE local-open-query-line :
     1834   do
     1835   on error undo, return error
     1836   :
     1837       if available temp_fbr-history
     1838       then do:
     1839           open query br-lines
     1840               for each temp_fbr-history-line no-lock
     1841                  where temp_fbr-history-line.fbh-key     = temp_fbr-history.fbh-key
     1842                    and temp_fbr-history-line.fblVisible  = yes
     1843           .
     1844       end.
     1845       else do:
     1846           open query br-lines
     1847               for each temp_fbr-history-line no-lock
     1848                  where temp_fbr-history-line.fbh-key = 0
     1849                    and temp_fbr-history-line.fblVisible  = yes
     1850           .
     1851       end.
     1852   end.
     1853   END PROCEDURE.
     1854   PROCEDURE manage-fields :
     1855   define input parameter p-fbh-key as integer          no-undo.
     1856   do
     1857   on error undo, return error
     1858   :
     1859   end.
     1860   END PROCEDURE.
     1861   FUNCTION get-nik RETURNS CHARACTER
     1862     ( input p-userid as character ) :
     1863       define variable v-nik    as character    no-undo.
     1864   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     1866     (input  p-userid
     1867     ,output v-nik
     1868     )  .
     1869     RETURN v-nik.
     1870   END FUNCTION.
