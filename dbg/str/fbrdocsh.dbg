      839   procedure diasize_set-height :
      840     define input  parameter p-new-height  as decimal   no-undo .
      841     define input  parameter p-move-resize as logical   no-undo .
      842     do
      843     on error undo, return error return-value
      844     :
      845       run diasize_change-height in this-procedure
      846         (input  (p-new-height - frame Dialog-Frame :height)
      847         ,input  p-move-resize
      848         ) .
      849     end.
      850   end procedure.
      851   procedure diasize_change-width :
      852     define input  parameter p-change-value as decimal   no-undo .
      853     define input  parameter p-move-resize  as logical   no-undo .
      854     define variable v-field-group-handle   as handle    no-undo .
