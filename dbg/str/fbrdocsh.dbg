       22           fbl-key
       23       index visible
       24           fbh-key
       25           fblVisible
       26   .
       27   define temp-table temp_fbr-history-fields no-undo
       28       field fbf-key       as integer
       29       field fbfName       as character
       30       field fbfLabel      as character
       31       field fbfFormat     as character
       32       field fbfVisible    as logical
