        1   define temp-table temp_fbr-history  no-undo
        2       field fbh-key       as integer
        3       field fbhType       as character
        4       field fbhAction     as character
        5       field fbhDate       as character
        6       field fbhTime       as character
        7       field fbhUser       as character
        8       field fbhChangeList as character
        9       index pi is primary unique
       10           fbh-key
       11   .
       12   define temp-table temp_fbr-history-line no-undo
       13       field fbl-key       as integer
       14       field fbh-key       as integer
       15       field fblLabel      as character
       16       field fblOldValue   as character
       17       field fblNewValue   as character
       18       field fblFieldName  as character
       19       field fblType       as character
