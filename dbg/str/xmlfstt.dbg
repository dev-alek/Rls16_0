      260         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSumRubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.sum-rubl))) + v-suffix ) .
      261         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSumBase', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.sum-base))) + v-suffix ) .
      262         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineCodeOperation', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.fin-ext-doc-type))) + v-suffix ) .
      263         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineDatePay', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.pay-date, '99.99.9999':U))) + v-suffix ) .
      264         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineDocCode', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.prn-doc-code))) + v-suffix ) .
      265         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineCorrAccount', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.rp-c-schet))) + v-suffix ) .
      266         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineComment', xml-doc_ReplaceSpecSymbols(string(buf_fin-statement-line.ps))) + v-suffix ) .
      267         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'statementLine') + chr(10))).
      268   end.
      269   if paroutput-file = ?  or
      270      paroutput-file = "" then do:
      271      run write-string in this-procedure
      272        (input '</root>':u + chr(10)).
      273   end.
      274   else do:
      275     if p-last-document then do:
      276       run write-string in this-procedure
      277         (input '</root>':u + chr(10)).
      278     end.
      279   end.
      280   output stream fin-sttm-out close.
      281   if paroutput-file = ?  or
      282      paroutput-file = "" then do:
      283     if search ("./" + "fs":U + string(p-sttm-code) + ".xml") <> ? then do:
      284        os-delete value ("./" + "fs":U + string(p-sttm-code) + ".xml").
      285     end.
      286     os-copy value ("./" + "fs":U + string(p-sttm-code) + ".tmp") value ("./" + "fs":U + string(p-sttm-code) + ".xml").
      287     os-delete value ("./" + "fs":U +  string(p-sttm-code) + ".tmp").
      288     run gbl/filename.p (
      289                     input "./" + "fs":U + string(p-sttm-code) + ".xml"
      290                     ,output paroutput-file
      291                     ,output v-path
      292                     ,output v-file-name
      293                     ,output v-file-name-no-ext
      294                     ,output v-file-name-ext
      295                     ) no-error .
      296   end.
      297   procedure write-string :
      298    define input parameter parstring as character no-undo.
      299    put stream fin-sttm-out unformatted parstring.
      300   end.
