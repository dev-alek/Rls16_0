      536   procedure prn-lib-reportviewer :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-report-name-html as character no-undo .
      539     define input parameter p-param        as character no-undo .
      540     define variable v-excel           as character no-undo init 'TRUE' .
      541     define variable v-value-character as character no-undo .
      542     define variable v-value-integer   as character no-undo .
      543     define variable v-value-date      as date      no-undo .
      544     define variable v-value-decimal   as decimal   no-undo .
      545     define variable rep-excel         as logical   no-undo .
      546     define variable excel-string      as character no-undo .
      547     define variable v-param-type      as character no-undo .
      548     define variable v-tth             as handle    no-undo .
      549     run adm/shattri.p (
      550       input "get":U
      551       ,input  ""
      552       ,input  0
      553       ,input  'report-glob':U
      554       ,input  'rep-excel':U
      555       ,output v-value-character
      556       ,output v-value-date
      557       ,output v-value-decimal
      558       ,output v-value-integer
      559       ,output rep-excel
      560       ,output v-param-type
      561       ,INPUT-OUTPUT table-handle v-tth
      562       )  .
      563     if rep-excel then v-excel = "TRUE" .
      564     else v-excel = "FALSE" .
      565     if p-param eq ""
      566     then
      567        p-param = "EXCEL:" + v-excel.
      568     else
      569        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      570     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      571   end procedure.
      572   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure fltfield-clear :
      574     define output parameter loc-fld as character no-undo.
      575     define output parameter loc-lab as character no-undo .
      576     define output parameter loc-spr as character no-undo .
      577     define output parameter loc-dim as character no-undo .
      578     assign
      579       loc-fld = ""
      580       loc-lab = ""
      581       loc-spr = ""
      582       loc-dim = "0"
      583     .
      584   end procedure .
      585   procedure fltfield-add :
      586     define input        parameter par-fld as character no-undo.
      587     define input        parameter par-lab as character no-undo .
      588     define input        parameter par-spr as character no-undo .
      589     define input-output parameter loc-fld as character no-undo.
      590     define input-output parameter loc-lab as character no-undo .
      591     define input-output parameter loc-spr as character no-undo .
      592     define input-output parameter loc-dim as character no-undo .
      593     do
      594     on error undo, return error
      595     :
      596       assign
      597       loc-fld = if loc-dim = '0'
      598                 then par-fld
      599                 else (loc-fld + chr(44) + par-fld)
      600       loc-lab = if loc-dim = '0'
      601                 then par-lab
      602                 else (loc-lab + chr(44) + par-lab)
      603       loc-spr = if loc-dim = '0'
      604                 then par-spr
      605                 else (loc-spr + chr(44) + par-spr)
      606       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      607                 string(integer(if num-entries(loc-dim) > 1
      608                               then entry(2, loc-dim)
      609                               else entry(1, loc-dim)
      610                               ) + 1)
      611       no-error
      612       .
      613     end.
      614   end procedure.
      615   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   define variable v-waitfram-action01         as character   no-undo .
      617   define variable v-waitfram-action02         as character   no-undo .
      618   define variable v-waitfram-action03         as character   no-undo .
      619   define variable mWaitFramTextBeg            as character   no-undo.
      620   define variable mWaitFramTextEnd            as character   no-undo.
      621   define variable mWaitFramView               as logical     no-undo.
      622   define variable mWaitProcEvent              as logical     no-undo init yes.
      623   define variable mWaitFramInterval           as integer     no-undo init 1 .
      624   define variable mWaitFramStop               as logical     no-undo.
      625   define variable mWaitFramStopUser           as logical     no-undo.
      626   define variable mWaitFramStopTimeOut        as logical     no-undo.
      627   define variable mWaitFramStartProc          as datetime-tz no-undo.
      628   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      629   define button B-WaitFramStop auto-end-key
      630        label "Стоп"
      631        size 10 by 1 tooltip "Остоновить процесс".
      632   define button B-viewProcInfo
      633        label "Информация"
      634        size 15 by 1 tooltip "Информация о процесс".
      635   define frame waitfram
      636     v-waitfram-action01 format "x(72)" no-label skip
      637     v-waitfram-action02 format "x(72)" no-label skip
      638     v-waitfram-action03 format "x(72)" no-label skip
      639     B-viewProcInfo
      640     B-WaitFramStop at row 4 col 30
      641     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      642     .
      643   define new global shared variable mBatchMode as logical no-undo init ?.
      644   define variable mFramBachModHandle as handle no-undo.
      645   mFramBachModHandle = frame waitfram:handle.
      646   define variable mFameOldVis as logical no-undo.
      647   define variable mVisCUrentVin as logical no-undo.
      648   if session:batch-mode
      649   then
      650      mBatchMode = yes.
      651   if mBatchMode = ? then do:
      652     mVisCUrentVin = current-window:visible.
      653     mFameOldVis = mFramBachModHandle:visible.
      654     mFramBachModHandle:visible  = yes.
      655     mBatchMode = mFramBachModHandle:visible ne yes.
      656     mFramBachModHandle:visible = mFameOldVis.
      657     current-window:visible = mVisCUrentVin.
      658   end.
      659    if  log-manager:logfile-name ne ?
      660     then DO:
      661         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      662         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      663         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      664     end.
      665   on choose of B-WaitFramStop in frame waitfram
      666   do:
      667     mWaitFramStop = yes.
      668     mWaitFramStopUser = yes.
      669   end.
      670   function waitfram-check-timeout returns logical():
      671      define variable vtime as int64 no-undo.
      672      if mWaitFramStopTimeOut
      673      then
      674         return yes.
      675      vtime = ( now - mWaitFramStartProc ) / 1000 .
      676      if     mWaitFramTimeOut ne ?
      677         and mWaitFramTimeOut ne 0
      678         and mWaitFramTimeOut lt vtime
      679      then do:
      680         mWaitFramStopTimeOut = yes.
      681      end.
      682      return mWaitFramStopTimeOut.
      683   end.
      684   procedure waitfram-hide :
      685     if not session:batch-mode
      686     then do
      687     on error undo, return error return-value
      688     :
      689       pause 0 before-hide .
      690       if not mBatchMode then
      691         hide frame waitfram .
      692     if     not mWaitFramView
      693        and mWaitProcEvent
      694     then
      695       process events .
      696     end.
      697   end procedure.
      698   procedure waitfram-show :
      699     define input  parameter p-message as character no-undo .
      700     define variable v-left-margin as integer   no-undo .
      701     if not session:batch-mode
      702     then do
      703     on error undo, return error return-value
      704     :
      705       if length(p-message) <= 70 then do:
      706         assign
      707           v-left-margin = integer((70 - length(p-message)) / 2)
      708         .
      709         assign
      710           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      711         .
      712         assign
      713           v-waitfram-action01 = " "
      714           v-waitfram-action02 = " "
      715                                    + fill(" ", v-left-margin)
      716                                    + p-message
      717           v-waitfram-action03 = " "
      718         .
      719       end.
      720       else do:
      721         define variable vRindex1 as integer no-undo.
      722         define variable vRindex2 as integer no-undo.
      723         vRindex1 = r-index(p-message," ",70).
      724         if vRindex1 = 0
      725         then
      726            vRindex1 = 70.
      727         if length(p-message)  <= vRindex1 + 70 then do:
      728           assign
      729             v-waitfram-action01 = " "
      730             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      731             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      732           .
      733         end.
      734         else do:
      735           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      736           if vRindex2 <= vRindex1
      737           then
      738              vRindex2 = vRindex1 + 70.
      739           assign
      740             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      741             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      742             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      743           .
      744         end.
      745       end.
      746       B-viewProcInfo:visible   in frame waitfram = no.
      747       B-viewProcInfo:sensitive in frame waitfram = no.
      748       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      749       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      750       if  (   mWaitFramView
      751          or  mWaitProcEvent)
      752          and not mBatchMode
      753       then
      754          display
      755             v-waitfram-action01 skip
      756             v-waitfram-action02 skip
      757             v-waitfram-action03 skip
      758          with frame waitfram .
      759       if     mWaitFramView
      760          then do:
      761             if     mWaitFramInterval ne ?
      762                and not mBatchMode
      763             then
      764                wait-for go of frame waitfram pause mWaitFramInterval.
      765          end.
      766          else
      767             if     mWaitProcEvent
      768                and not mBatchMode
      769             then
      770                process events .
      771     end.
      772   end procedure.
      773      procedure waitfram-show-this:
      774         define input  parameter iInterval as int64 no-undo.
      775         define variable vtime as int64 no-undo.
      776         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      777         mWaitFramInterval = iInterval.
      778         run waitfram-show (substitute("&1&2 &3&4" ,
      779                                       mWaitFramTextBeg ,
      780                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      781                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      782                                       mWaitFramTextEnd
      783                                      )
      784                           ).
      785      end.
      786      procedure WaitFramRunPause:
      787         define input  parameter iInterval as dec no-undo.
      788         define variable vStart  as datetime-tz no-undo.
      789         define variable vend    as datetime-tz no-undo.
      790         define variable vint as int64 no-undo.
      791         define variable vOk as logical no-undo.
      792         vStart = now.
      793         vend   = vStart.
      794         publish "WaitFramPause" (iInterval,output vOk).
      795         vend   =  now.
      796         vint = vend - vStart.
      797         vint = iInterval - vint / 1000.
      798         if     not mWaitFramStop
      799            and (   vint > 0
      800                 or (    not vOk
      801                     and iInterval eq ?
      802                     )
      803                 )
      804         then
      805            run waitfram-show-this (iInterval).
      806         vend   =  now.
      807         vint = vend - vStart.
      808         vint = iInterval - vint / 1000.
      809         if     not mWaitFramStop
      810            and vint > 0
      811         then do:
      812            run gbl/pause.p (vint * 1000).
      813         end.
      814         if iInterval ne ?
      815         then
      816            publish "WaitFramStop".
      817         waitfram-check-timeout().
      818      end.
      819      procedure WaitFramWaitFor:
      820         define input  parameter iInterval as dec no-undo.
      821         assign
      822            mWaitFramStartProc   = now
      823            mWaitFramStopUser    = no
      824            mWaitFramStopTimeOut = no
      825         .
      826         block-wait:
      827         do while not mWaitFramStop:
      828            run WaitFramRunPause (iInterval).
      829            if  waitfram-check-timeout()
      830            then do:
      831               leave block-wait.
      832            end.
      833         end.
      834         run waitfram-hide.
      835      end.
      836   procedure waitfram-join :
      837     define input  parameter p-line-1  as character no-undo .
      838     define input  parameter p-line-2  as character no-undo .
      839     define input  parameter p-line-3  as character no-undo .
      840     define output parameter p-message as character no-undo .
      841     do
      842     on error undo, return error return-value
      843     :
      844       assign
      845         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      846                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      847                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      848       .
      849     end.
      850   end procedure.
      851   function waitfram-join-function returns character
      852     (input p-line-1 as character
      853     ,input p-line-2 as character
      854     ,input p-line-3 as character
      855     ).
      856     define variable v-message as character no-undo .
      857     run waitfram-join in this-procedure
      858       (input  p-line-1
      859       ,input  p-line-2
      860       ,input  p-line-3
      861       ,output v-message
      862       ) .
      863     return v-message .
      864   end function .
      865   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866     define variable v-cntxt-db-num        as integer   no-undo .
      867     define variable v-cntxt-userid        as character no-undo .
      868     define variable v-cntxt-level         as character no-undo .
      869     define variable v-cntxt-host-code-obj as integer   no-undo .
      870     define variable v-cntxt-obj-type      as character no-undo .
      871     define variable v-cntxt-obj-code      as integer   no-undo .
      872     define variable v-cntxt-db-num-obj    as integer   no-undo .
      873     define variable v-cntxt-is-admin      as logical   no-undo .
      874   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   FUNCTION mark-string RETURNS CHARACTER
      876     ( input p-recid as recid, input mark-list as character  ) :
      877     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      878   END FUNCTION.
      879   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   function usrfulnf returns character ( input p-user-id as character):
      881   define variable v-user-name as character no-undo .
      882   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      884     (input  p-user-id
      885     ,output v-user-name
      886     ) no-error .
      887   if error-status:error
      888   or v-user-name = ""
      889   then do:
      890     return p-user-id.
      891   end.
      892   else do:
      893     return v-user-name.
      894   end.
      895   end function.
      896   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      898   procedure fltopend_fltopend :
      899   define input parameter p-parent-handle as handle no-undo .
      900   define input parameter p-qh as handle no-undo .
      901   define input parameter p-flt-open-open-query  as character no-undo .
      902   define input parameter p-where-cond as character no-undo .
      903   define input parameter p-use-indFIRST-query-tail as character no-undo .
      904   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      905   define input parameter p-indexed-reposition as character no-undo .
      906     do
      907     on error undo, return error
      908     :
      909   define variable v-prepare-string as character no-undo .
      910   define variable glog as logical no-undo .
      911   assign
      912   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      913                      p-where-cond + chr(32)  +
      914                      p-use-indFIRST-query-tail + chr(32) +
      915                      p-use-ind-sort-clmn-by + chr(32) +
      916                      p-indexed-reposition
      917   .
      918   assign
      919   glog = p-qh:query-prepare(v-prepare-string) no-error .
      920   if not glog
      921   or error-status:error then do:
      922     message error-status:get-message(1) view-as alert-box .
      923     undo, return error .
      924   end.
      925   assign
      926   glog = p-qh:query-open no-error .
      927   if not glog
      928   or error-status:error then do:
      929     message error-status:get-message(1) view-as alert-box .
      930     undo, return error .
      931   end.
      932     end.
      933   end procedure.
      934   procedure fltopend_fltfindd :
      935   define input parameter p-parent-handle as handle no-undo .
      936   define input parameter p-qh as handle no-undo .
      937   define input parameter p-rowid as rowid no-undo .
      938   define input parameter p-next as logical no-undo .
      939   define input parameter p-lock as integer no-undo .
      940   define input parameter p-bh as handle no-undo .
      941   define input parameter p-where-cond as character no-undo .
      942   define input parameter p-use-index-phrase as character no-undo .
      943   define variable glog as logical no-undo .
      944   define variable v-qh as handle no-undo .
      945   define variable v-bh as handle no-undo .
      946   define variable v-recid as recid no-undo .
      947   define variable v-prepare-string as character no-undo .
      948   do
      949   on error undo, return error
      950   on stop undo, return error
      951   :
      952     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      953     create buffer v-bh for table p-bh buffer-name p-bh:name.
      954     create query v-qh.
      955     v-qh:set-buffers(v-bh).
      956     v-prepare-string = substitute("for each &1 &2 &3"
      957                                     ,v-bh:name
      958                                     ,p-where-cond
      959                                     ,p-use-index-phrase).
      960     glog = v-qh:query-prepare(v-prepare-string) no-error.
      961     if not glog then do:
      962       delete object v-qh.
      963       delete object v-bh.
      964       undo, return error .
      965     end.
      966     glog = v-qh:query-open no-error .
      967     if not glog then do:
      968       delete object v-qh.
      969       delete object v-bh.
      970       undo, return error .
      971     end.
      972     if p-next then do:
      973       v-qh:reposition-to-rowid(p-rowid) no-error .
      974       glog = v-qh:get-next( p-lock) no-error .
      975       glog = v-qh:get-next( p-lock) no-error .
      976       if not glog or v-qh:query-off-end = yes then do:
      977         glog = v-qh:get-first( p-lock) no-error .
      978       end.
      979     end.
      980     else do:
      981       glog = v-qh:get-first( p-lock) no-error .
      982     end.
      983     v-recid = v-bh:recid no-error .
      984     delete object v-qh.
      985     delete object v-bh.
      986     return string(v-recid) .
      987   end.
      988   end procedure.
      989   procedure fltopend_fltfindq :
      990   define input parameter p-parent-handle as handle no-undo .
      991   define input parameter p-qh as handle no-undo .
      992   define input parameter p-next as logical no-undo .
      993   define input parameter p-lock as integer no-undo .
      994   define input parameter p-flt-open-open-query  as character no-undo .
      995   define input parameter p-where-cond as character no-undo .
      996   define input parameter p-use-indFIRST-query-tail as character no-undo .
      997   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      998   define input parameter p-indexed-reposition as character no-undo .
      999   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1000   define variable glog as logical no-undo .
     1001   define variable v-qh as handle no-undo .
     1002   define variable v-bh as handle no-undo extent 18.
     1003   define variable v-rowid as rowid no-undo extent 18.
     1004   define variable v-ii as integer no-undo .
     1005   define variable v-prepare-string as character no-undo .
     1006   do
     1007   on error undo, return error
     1008   on stop undo, return error
     1009   :
     1010     create query v-qh.
     1011     do v-ii = 1 to p-qh:num-buffers:
     1012       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1013       assign
     1014       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1015       no-error.
     1016       v-qh:add-buffer(v-bh[v-ii]).
     1017     end.
     1018     assign
     1019     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1020                       p-where-cond + chr(32)  +
     1021                       p-use-indFIRST-query-tail + chr(32) +
     1022                       p-use-ind-sort-clmn-by + chr(32) +
     1023                       p-indexed-reposition
     1024     .
     1025     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1026     if not glog then do:
     1027       delete object v-qh.
     1028       do v-ii = 1 to p-qh:num-buffers:
     1029         delete object v-bh[v-ii].
     1030       end.
     1031       undo, return error .
     1032     end.
     1033     glog = v-qh:query-open no-error .
     1034     if not glog then do:
     1035       delete object v-qh.
     1036       do v-ii = 1 to p-qh:num-buffers:
     1037         delete object v-bh[v-ii].
     1038       end.
     1039       undo, return error .
     1040     end.
     1041     if p-next then do:
     1042       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1043       glog = v-qh:get-next( p-lock) no-error .
     1044       glog = v-qh:get-next( p-lock) no-error .
     1045       if not glog or v-qh:query-off-end = yes then do:
     1046         glog = v-qh:get-first( p-lock) no-error .
     1047       end.
     1048     end.
     1049     else do:
     1050       glog = v-qh:get-first( p-lock) no-error .
     1051     end.
     1052     do v-ii = 1 to p-qh:num-buffers:
     1053       assign
     1054       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1055       no-error.
     1056     end.
     1057     delete object v-qh.
     1058     do v-ii = 1 to p-qh:num-buffers:
     1059       delete object v-bh[v-ii].
     1060     end.
     1061   end.
     1062   end procedure.
     1063   DEFINE BUTTON B-Help
     1064        LABEL "Помо&щь"
     1065        SIZE 3 BY 1
     1066        BGCOLOR 8 .
     1067   DEFINE BUTTON b-lkp
     1068        LABEL "&Просм"
     1069        SIZE 10 BY 1.
     1070   DEFINE BUTTON B-print
     1071        LABEL "Пе&чать"
     1072        SIZE 3 BY 1.
     1073   DEFINE BUTTON b-quit AUTO-GO
     1074        LABEL "&Выход"
     1075        SIZE 8 BY 1
     1076        BGCOLOR 8 .
     1077   DEFINE BUTTON B-sch
     1078        LABEL "&Фильтр"
     1079        SIZE 3 BY 1.
     1080   DEFINE VARIABLE FILL-IN-data AS DATE FORMAT "99/99/9999":U
     1081        LABEL "дата удаления"
     1082        VIEW-AS FILL-IN
     1083        SIZE 12.8 BY .95 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1084   DEFINE VARIABLE FILL-IN-doc-code AS CHARACTER FORMAT "X(256)":U
     1085        LABEL "нач. номера документа"
     1086        VIEW-AS FILL-IN
     1087        SIZE 40 BY .95 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1088   DEFINE QUERY BR-c-fin-doc FOR
     1089         buf_c-fin-doc SCROLLING.
     1090   DEFINE BROWSE BR-c-fin-doc
     1091     QUERY BR-c-fin-doc DISPLAY
     1092         buf_c-fin-doc.fin-doc-type                                         FORMAT "X(3)":U
     1093         buf_c-fin-doc.prn-doc-code                                         FORMAT "X(14)":U
     1094         buf_c-fin-doc.fin-doc-code               COLUMN-LABEL "Вн.N"       FORMAT "99999999":U
     1095         buf_c-fin-doc.doc-date                                             FORMAT "99/99/9999":U
     1096         buf_c-fin-doc.fact-date                  COLUMN-LABEL "Дата факт"  FORMAT "99/99/9999":U
     1097         buf_c-fin-doc.corr-date                  COLUMN-LABEL "Дата удал." FORMAT "99/99/9999":U
     1098         string(buf_c-fin-doc.corr-time, "hh:mm") COLUMN-LABEL "Время"      FORMAT "X(5)":U
     1099         usrfulnf(buf_c-fin-doc.corr-user-name)   COLUMN-LABEL "Удалил"     FORMAT "X(14)":U
     1100         buf_c-fin-doc.sum-doc                                              FORMAT ">>,>>>,>>>,>>9.99":U
     1101         buf_c-fin-doc.receiver-name              COLUMN-LABEL "Получатель" FORMAT "X(25)":U
     1102         buf_c-fin-doc.receiver-type + string(buf_c-fin-doc.receiver-code) COLUMN-LABEL "Получатель" FORMAT "X(7)":U
     1103         buf_c-fin-doc.payer-name                 COLUMN-LABEL "Плательщик" FORMAT "X(25)":U
     1104         buf_c-fin-doc.payer-type + string(buf_c-fin-doc.payer-code) COLUMN-LABEL "Плательщик" FORMAT "X(7)":U
     1105       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 16.67.
     1106   DEFINE FRAME Dialog-Frame
     1107        b-quit AT ROW 1 COL 1.2 WIDGET-ID 10
     1108        b-lkp AT ROW 1 COL 38 WIDGET-ID 4
     1109        B-print AT ROW 1 COL 89 WIDGET-ID 8
     1110        B-sch AT ROW 1 COL 92 WIDGET-ID 12
     1111        B-Help AT ROW 1 COL 95 WIDGET-ID 18
     1112        BR-c-fin-doc AT ROW 2.43 COL 2 WIDGET-ID 200
     1113        FILL-IN-data AT ROW 19.81 COL 17 COLON-ALIGNED WIDGET-ID 16
     1114        FILL-IN-doc-code AT ROW 19.81 COL 56 COLON-ALIGNED WIDGET-ID 14
     1115        SPACE(0.99) SKIP(0.33)
     1116       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1117            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1118            TITLE "Удаленные финансовые документы" WIDGET-ID 100.
     1119   ASSIGN
     1120          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1121          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1122   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1123   DO:
     1124   if not available buf_c-fin-doc then return no-apply.
     1125   run proc_lookup in this-procedure.
     1126   apply "ENTRY" to br-c-fin-doc.
     1127   if error-status:error then do:
     1128     return no-apply.
     1129   end.
     1130   END.
     1131   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1132   DO:
     1133     run proc-b-print in this-procedure no-error.
     1134     if error-status:error then do:
     1135       return no-apply.
     1136     end.
     1137     APPLY "ENTRY" to BR-c-fin-doc.
     1138   END.
     1139   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1140   DO:
     1141     run proc-b-sch in this-procedure no-error.
     1142     if error-status:error then return no-apply.
     1143     apply "ENTRY" to br-c-fin-doc.
     1144   END.
     1145   ON MOUSE-SELECT-DBLCLICK OF BR-c-fin-doc IN FRAME Dialog-Frame
     1146   or RETURN OF BR-c-fin-doc IN FRAME Dialog-Frame
     1147   DO:
     1148     apply "choose" to b-lkp in frame Dialog-Frame.
     1149     apply "ENTRY" to br-c-fin-doc.
     1150     return no-apply.
     1151   END.
     1152   ON CTRL-J OF FILL-IN-data IN FRAME Dialog-Frame
     1153   DO:
     1154       find next buf_c-fin-doc where (buf_c-fin-doc.host-code = p-curr-host-code) and (buf_c-fin-doc.is-del = yes) and buf_c-fin-doc.corr-date = date(FILL-IN-data:screen-value) no-error.
     1155       if available buf_c-fin-doc
     1156       then
     1157       reposition BR-c-fin-doc to rowid rowid(buf_c-fin-doc).
     1158   END.
     1159   ON RETURN OF FILL-IN-data IN FRAME Dialog-Frame
     1160   DO:
     1161       find first buf_c-fin-doc where (buf_c-fin-doc.host-code = p-curr-host-code) and (buf_c-fin-doc.is-del = yes) and buf_c-fin-doc.corr-date = date(FILL-IN-data:screen-value) no-error.
     1162       if available buf_c-fin-doc
     1163       then
     1164       reposition BR-c-fin-doc to rowid rowid(buf_c-fin-doc).
     1165   END.
     1166   ON CTRL-J OF FILL-IN-doc-code IN FRAME Dialog-Frame
     1167   DO:
     1168       find next buf_c-fin-doc where (buf_c-fin-doc.host-code = p-curr-host-code) and (buf_c-fin-doc.is-del = yes) and buf_c-fin-doc.prn-doc-code begins FILL-IN-doc-code:screen-value no-error.
     1169       if available buf_c-fin-doc
     1170       then
     1171       reposition BR-c-fin-doc to rowid rowid(buf_c-fin-doc).
     1172   END.
     1173   ON RETURN OF FILL-IN-doc-code IN FRAME Dialog-Frame
     1174   DO:
     1175       find first buf_c-fin-doc where (buf_c-fin-doc.host-code = p-curr-host-code) and (buf_c-fin-doc.is-del = yes) and buf_c-fin-doc.prn-doc-code begins FILL-IN-doc-code:screen-value no-error.
     1176       if available buf_c-fin-doc
     1177       then
     1178       reposition BR-c-fin-doc to rowid rowid(buf_c-fin-doc).
     1179   END.
     1180   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1181   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1182   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   on help of frame Dialog-Frame
     1184   do:
     1185     run gbl/app_help.p
     1186       (input this-procedure :file-name
     1187       ,input ''
     1188       ,input ?
     1189       ) no-error.
     1190     if error-status :error then do:
     1191       message
     1192         "Ошибка при вызове помощи"
     1193         error-status :get-message(1)
     1194         view-as alert-box .
     1195     end.
     1196   end.
     1197   run minbtn-set in this-procedure .
     1198   on choose of b-help in frame Dialog-Frame
     1199   do:
     1200     apply "help":u to frame Dialog-Frame .
     1201   end.
     1202   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   procedure minbtn-set :
     1204       do
     1205           on error undo, return error return-value
     1206           :
     1207           define variable ii              as integer       no-undo .
     1208           define variable fh              as widget-handle no-undo .
     1209           define variable hh              as widget-handle no-undo .
     1210           define variable v-h             as handle        extent 4 no-undo .
     1211           define variable v-name-button   as character     no-undo .
     1212           define variable v-help-old-x    as decimal       no-undo .
     1213           define variable v-help-old-y    as decimal       no-undo .
     1214           define variable v-help-old-size as decimal       no-undo .
     1215           define variable v-frame-width   as decimal       no-undo .
     1216           define variable jj              as integer       no-undo .
     1217           do
     1218               on error undo, return error
     1219               :
     1220               assign
     1221                   v-frame-width = frame Dialog-Frame:width - 0.3
     1222                   fh            = frame Dialog-Frame:first-child
     1223                   hh            = fh:first-child
     1224                   ii            = 1
     1225                   .
     1226               do while valid-handle(hh):
     1227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1228                   do:
     1229                       case lc(hh:name) :
     1230                           when "b-help" then
     1231                               do:
     1232                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1233                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1235                                   hh:TOOLTIP = "Помощь" .
     1236                                   v-help-old-x = hh:column .
     1237                                   v-help-old-y = hh:row    .
     1238                                   v-help-old-size = hh:width .
     1239                                   hh:width-chars = 2.5 .
     1240                               end.
     1241                           when "b-print" then
     1242                               do:
     1243                                   hh:load-image("cmp/b-print.bmp":u) .
     1244                                   hh:TOOLTIP = "Печать" .
     1245                                   v-h[ii] = hh:handle .
     1246                                   ii = ii + 1 .
     1247                                   hh:width-chars = 3 .
     1248                               end.
     1249                           when "b-history" or
     1250                           when "b-hist" then
     1251                               do:
     1252                                   hh:load-image("cmp/b-hist.bmp":u) .
     1253                                   hh:TOOLTIP = "История" .
     1254                                   v-h[ii] = hh:handle .
     1255                                   ii = ii + 1 .
     1256                                   hh:width-chars = 3 .
     1257                               end.
     1258                           when "b-sch" then
     1259                               do:
     1260                                   hh:load-image("cmp/b-sch.bmp":u) .
     1261                                   hh:TOOLTIP = "Установка Фильтра" .
     1262                                   v-h[ii] = hh:handle .
     1263                                   ii = ii + 1 .
     1264                                   hh:width-chars = 3 .
     1265                               end.
     1266                           when "b-hist-user" then
     1267                               do:
     1268                                   hh:load-image("cmp/b-hist.bmp":u) .
     1269                                   hh:TOOLTIP = "История пользователя" .
     1270                                   ii = ii + 1 .
     1271                               end.
     1272                       end case.
     1273                   end.
     1274                   hh = hh:next-sibling.
     1275               end.
     1276               b-help:column = v-frame-width - b-help:width-chars.
     1277               jj = 0.
     1278               repeat ii = 4 to 1 by -1 :
     1279                   if valid-handle (v-h[ii] ) then
     1280                   do:
     1281                       jj  = jj + 1 .
     1282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1283                       v-h[ii]:row    = v-help-old-y .
     1284                   end.
     1285               end.
     1286           end.
     1287       end.
     1288   end procedure.
     1289   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1290   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1291   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1292   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1293   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1294   define variable v-diasize-current-frame-height as decimal   no-undo .
     1295   define variable v-diasize-change-size          as logical   no-undo .
     1296   define variable v-diasize-resize-button        as handle    no-undo .
     1297   define variable v-diasize-wndmax               as logical   no-undo .
     1298   define variable v-diasize-wndstore             as logical   no-undo .
     1299   define variable v-diasize-proc-name            as character no-undo .
     1300   define variable v-diasize-browse-handle        as handle    no-undo .
     1301   define variable v-diasize-browse-number        as integer   no-undo .
     1302   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1303   define temp-table temp-diasize-handle no-undo
     1304     field handle-value  as handle
     1305     field save-position as decimal
     1306     index xpk is primary unique handle-value
     1307     .
     1308   define temp-table temp-browse-handle no-undo
     1309     field browse-type   as character
     1310     field browse-number as integer
     1311     field browse-handle as handle
     1312     field original-size as decimal
     1313     index xpk is primary unique browse-type browse-number
     1314     index xie browse-type browse-handle
     1315   .
     1316   procedure diasize_change-height :
     1317     define input  parameter p-change-value  as decimal   no-undo .
     1318     define input  parameter p-move-resize   as logical   no-undo .
     1319     define variable v-field-group-handle    as handle    no-undo .
     1320     define variable v-object-handle         as handle    no-undo .
     1321     define variable v-frame-height          as decimal   no-undo .
     1322     define variable v-frame-virtual-height  as decimal   no-undo .
     1323     define variable v-browse-height         as decimal   no-undo .
     1324     define variable v-window-height         as decimal   no-undo .
     1325     define variable v-window-virtual-height as decimal   no-undo .
     1326     define variable v-change-sign           as integer   no-undo .
     1327     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1328     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1329     if p-change-value > 0
     1330     then do:
     1331       if frame Dialog-Frame :height + p-change-value
     1332           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1333       then do:
     1334         assign
     1335           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1336                           - (frame Dialog-Frame :height-chars)
     1337         .
     1338         if p-change-value <= 0
     1339         then do:
     1340           run diasize_position-resize-button in this-procedure .
     1341           return .
     1342         end.
     1343       end.
     1344     end.
     1345     if p-change-value < 0
     1346     then do:
     1347       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1348       then do:
     1349         assign
     1350           p-change-value = v-diasize-orig-frame-height
     1351                          - (frame Dialog-Frame :height-chars)
     1352         .
     1353         if p-change-value >= 0
     1354         then do:
     1355           run diasize_position-resize-button in this-procedure .
     1356           return .
     1357         end.
     1358       end.
     1359     end.
     1360     if p-change-value >= 0
     1361     then do:
     1362       assign
     1363         v-change-sign = 1
     1364       .
     1365     end.
     1366     else do:
     1367       assign
     1368         v-change-sign = -1
     1369       .
     1370     end.
     1371     assign
     1372       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1373     .
     1374     if p-change-value = 0
     1375     then do:
     1376       run diasize_position-resize-button in this-procedure .
     1377       return .
     1378     end.
     1379     move_block:
     1380     do
     1381     on error undo move_block, retry move_block
     1382     :
     1383       if retry
     1384       then do:
     1385         do
     1386         on error undo move_block, leave move_block
     1387         :
     1388           if p-change-value > 0
     1389           then do:
     1390             for each buf_temp-diasize-handle
     1391             on error undo, next
     1392             :
     1393               assign
     1394                 v-object-handle = buf_temp-diasize-handle.handle-value
     1395               .
     1396               if v-object-handle <> v-diasize-resize-button
     1397               then do:
     1398                 assign
     1399                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1400                 .
     1401               end.
     1402             end.
     1403             assign
     1404               v-diasize-browse-handle :height = v-browse-height
     1405             .
     1406             for each buf_temp-browse-handle
     1407               where buf_temp-browse-handle.browse-type = 'height':u
     1408             on error undo, next
     1409             :
     1410               assign
     1411                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1412               .
     1413             end.
     1414             assign
     1415               frame Dialog-Frame :height = v-frame-height
     1416             .
     1417             if frame Dialog-Frame :scrollable = true
     1418             then do:
     1419               assign
     1420                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1421               .
     1422             end.
     1423             run diasize_position-resize-button in this-procedure .
     1424           end.
     1425           else do:
     1426             if frame Dialog-Frame :scrollable = true
     1427             then do:
     1428               assign
     1429                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1430               .
     1431             end.
     1432             assign
     1433               frame Dialog-Frame :height = v-frame-height
     1434             .
     1435             assign
     1436               v-diasize-browse-handle :height = v-browse-height
     1437             .
     1438             for each buf_temp-browse-handle
     1439               where buf_temp-browse-handle.browse-type = 'height':u
     1440             on error undo, next
     1441             :
     1442               assign
     1443                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1444               .
     1445             end.
     1446             for each buf_temp-diasize-handle
     1447             on error undo, next
     1448             :
     1449               assign
     1450                 v-object-handle = buf_temp-diasize-handle.handle-value
     1451               .
     1452               if v-object-handle <> v-diasize-resize-button
     1453               then do:
     1454                 assign
     1455                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1456                 .
     1457               end.
     1458             end.
     1459             run diasize_position-resize-button in this-procedure .
     1460           end.
     1461           assign
     1462             v-diasize-change-size = false
     1463           .
     1464           leave move_block .
     1465         end.
     1466       end.
     1467       assign
     1468         v-diasize-need-full-display = true
     1469       .
     1470       if v-diasize-change-size = false
     1471       then do:
     1472         assign
     1473           v-diasize-change-size = true
     1474         .
     1475       end.
     1476       else do:
     1477         return .
     1478       end.
     1479       assign
     1480         v-frame-height = frame Dialog-Frame :height
     1481         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1482         v-browse-height = v-diasize-browse-handle :height
     1483       .
     1484       for each buf_temp-browse-handle
     1485         where buf_temp-browse-handle.browse-type = 'height':u
     1486       :
     1487         assign
     1488           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1489         .
     1490       end.
     1491       for each buf_temp-diasize-handle
     1492       :
     1493         delete buf_temp-diasize-handle .
     1494       end.
     1495       assign
     1496         v-field-group-handle = frame Dialog-Frame :first-child
     1497       .
     1498       do while valid-handle(v-field-group-handle)
     1499       :
     1500         assign
     1501           v-object-handle = v-field-group-handle :first-child
     1502         .
     1503         do while valid-handle(v-object-handle)
     1504         :
     1505           if  v-object-handle <> v-diasize-browse-handle :handle
     1506           and can-query(v-object-handle, "row")
     1507           and can-query(v-object-handle, "height")
     1508           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1509           then do:
     1510             find first buf_temp-browse-handle
     1511               where buf_temp-browse-handle.browse-type   = 'height':u
     1512                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1513               no-error .
     1514             if available buf_temp-browse-handle
     1515             then do:
     1516             end.
     1517             else do:
     1518               create buf_temp-diasize-handle .
     1519               assign
     1520                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1521                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1522               .
     1523             end.
     1524           end.
     1525           assign
     1526             v-object-handle = v-object-handle :next-sibling
     1527           .
     1528         end.
     1529         assign
     1530           v-field-group-handle = v-field-group-handle :next-sibling
     1531         .
     1532       end.
     1533       do with frame Dialog-Frame
     1534       :
     1535         hide v-diasize-resize-button .
     1536         assign
     1537           v-diasize-resize-button :row    = 1
     1538           v-diasize-resize-button :column = 1
     1539         .
     1540       end.
     1541       if p-change-value > 0
     1542       then do:
     1543         if frame Dialog-Frame :scrollable = true
     1544         then do:
     1545           assign
     1546             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1547             no-error .
     1548           if error-status :error
     1549           or error-status :get-message(1) <> ""
     1550           then do:
     1551             undo move_block, retry move_block .
     1552           end.
     1553         end.
     1554         assign
     1555           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1556           no-error .
     1557         if error-status :error
     1558         or error-status :get-message(1) <> ""
     1559         then do:
     1560           undo move_block, retry move_block .
     1561         end.
     1562         assign
     1563           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1564           no-error .
     1565         if error-status :error
     1566         or error-status :get-message(1) <> ""
     1567         then do:
     1568           undo move_block, retry move_block .
     1569         end.
     1570         for each buf_temp-browse-handle
     1571           where buf_temp-browse-handle.browse-type = 'height':u
     1572         on error undo move_block, retry move_block
     1573         :
     1574           assign
     1575             buf_temp-browse-handle.browse-handle :height
     1576               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1577             no-error .
     1578           if error-status :error
     1579           or error-status :get-message(1) <> ""
     1580           then do:
     1581             undo move_block, retry move_block .
     1582           end.
     1583         end.
     1584         for each buf_temp-diasize-handle
     1585         on error undo move_block, retry move_block
     1586         :
     1587           assign
     1588             v-object-handle = buf_temp-diasize-handle.handle-value
     1589           .
     1590           if v-object-handle <> v-diasize-resize-button
     1591           then do:
     1592             assign
     1593               v-object-handle :row = v-object-handle :row + p-change-value
     1594               no-error .
     1595             if error-status :error
     1596             or error-status :get-message(1) <> ""
     1597             then do:
     1598               undo move_block, retry move_block .
     1599             end.
     1600           end.
     1601         end.
     1602       end.
     1603       else do:
     1604         for each buf_temp-diasize-handle
     1605         on error undo move_block, retry move_block
     1606         :
     1607           assign
     1608             v-object-handle = buf_temp-diasize-handle.handle-value
     1609           .
     1610           if v-object-handle <> v-diasize-resize-button
     1611           then do:
     1612             assign
     1613               v-object-handle :row = v-object-handle :row + p-change-value
     1614               no-error .
     1615             if error-status :error
     1616             or error-status :get-message(1) <> ""
     1617             then do:
     1618               undo move_block, retry move_block .
     1619             end.
     1620           end.
     1621         end.
     1622         assign
     1623           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1624           no-error .
     1625         if error-status :error
     1626         or error-status :get-message(1) <> ""
     1627         then do:
     1628           undo move_block, retry move_block .
     1629         end.
     1630         for each buf_temp-browse-handle
     1631           where buf_temp-browse-handle.browse-type = 'height':u
     1632         on error undo move_block, retry move_block
     1633         :
     1634           assign
     1635             buf_temp-browse-handle.browse-handle :height
     1636               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1637             no-error .
     1638           if error-status :error
     1639           or error-status :get-message(1) <> ""
     1640           then do:
     1641             undo move_block, retry move_block .
     1642           end.
     1643         end.
     1644         assign
     1645           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1646           no-error .
     1647         if error-status :error
     1648         or error-status :get-message(1) <> ""
     1649         then do:
     1650           undo move_block, retry move_block .
     1651         end.
     1652         if frame Dialog-Frame :scrollable = true
     1653         then do:
     1654           assign
     1655             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1656             no-error .
     1657           if error-status :error
     1658           or error-status :get-message(1) <> ""
     1659           then do:
     1660             undo move_block, retry move_block .
     1661           end.
     1662         end.
     1663       end.
     1664       if p-move-resize = true
     1665       then do:
     1666         run diasize_position-resize-button in this-procedure .
     1667       end.
     1668       if v-diasize-wndstore = true
     1669       then do:
     1670         if connected("ub") = true
     1671         then do:
     1672           define variable v-cntxt-db-num        as integer   no-undo .
     1673           define variable v-cntxt-userid        as character no-undo .
     1674           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1675                                             , OUTPUT v-cntxt-userid
     1676                                             ) .
     1677           run gbl/wndsizew.p
     1678             (input  v-cntxt-db-num
     1679             ,input  v-cntxt-userid
     1680             ,input  v-diasize-proc-name
     1681             ,input  'height':u
     1682             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1683             ) .
     1684         end.
     1685       end.
     1686     end.
     1687     assign
     1688       v-diasize-change-size = false
     1689     .
     1690   end procedure.
     1691   procedure diasize_set-height :
     1692     define input  parameter p-new-height  as decimal   no-undo .
     1693     define input  parameter p-move-resize as logical   no-undo .
     1694     do
     1695     on error undo, return error return-value
     1696     :
     1697       run diasize_change-height in this-procedure
     1698         (input  (p-new-height - frame Dialog-Frame :height)
     1699         ,input  p-move-resize
     1700         ) .
     1701     end.
     1702   end procedure.
     1703   procedure diasize_change-width :
     1704     define input  parameter p-change-value as decimal   no-undo .
     1705     define input  parameter p-move-resize  as logical   no-undo .
     1706     define variable v-field-group-handle   as handle    no-undo .
     1707     define variable v-object-handle        as handle    no-undo .
     1708     define variable v-frame-width          as decimal   no-undo .
     1709     define variable v-frame-virtual-width  as decimal   no-undo .
     1710     define variable v-browse-width         as decimal   no-undo .
     1711     define variable v-window-width         as decimal   no-undo .
     1712     define variable v-window-virtual-width as decimal   no-undo .
     1713     define variable v-change-sign          as integer   no-undo .
     1714     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1715     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1716     if p-change-value > 0
     1717     then do:
     1718       if frame Dialog-Frame :width + p-change-value >
     1719           session :width-chars
     1720       then do:
     1721         assign
     1722           p-change-value = session :width-chars - frame Dialog-Frame :width
     1723         .
     1724         if p-change-value <= 0
     1725         then do:
     1726           run diasize_position-resize-button in this-procedure .
     1727           return .
     1728         end.
     1729       end.
     1730     end.
     1731     if p-change-value < 0
     1732     then do:
     1733       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1734       then do:
     1735         assign
     1736           p-change-value = v-diasize-orig-frame-width
     1737                          - frame Dialog-Frame :width
     1738         .
     1739         if p-change-value >= 0
     1740         then do:
     1741           run diasize_position-resize-button in this-procedure .
     1742           return .
     1743         end.
     1744       end.
     1745     end.
     1746     if p-change-value >= 0
     1747     then do:
     1748       assign
     1749         v-change-sign = 1
     1750       .
     1751     end.
     1752     else do:
     1753       assign
     1754         v-change-sign = -1
     1755       .
     1756     end.
     1757     assign
     1758       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1759     .
     1760     if p-change-value = 0
     1761     then do:
     1762       run diasize_position-resize-button in this-procedure .
     1763       return .
     1764     end.
     1765     move_block:
     1766     do
     1767     on error undo move_block, leave move_block
     1768     :
     1769       if retry
     1770       then do:
     1771         do
     1772         on error undo move_block, leave move_block
     1773         :
     1774           if p-change-value > 0
     1775           then do:
     1776             for each buf_temp-diasize-handle
     1777             on error undo, next
     1778             :
     1779               assign
     1780                 v-object-handle = buf_temp-diasize-handle.handle-value
     1781               .
     1782               if v-object-handle <> v-diasize-resize-button
     1783               then do:
     1784                 assign
     1785                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1786                 .
     1787               end.
     1788             end.
     1789             assign
     1790               v-diasize-browse-handle :width = v-browse-width
     1791             .
     1792             for each buf_temp-browse-handle
     1793               where buf_temp-browse-handle.browse-type = 'width':u
     1794             on error undo, next
     1795             :
     1796               assign
     1797                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1798               .
     1799             end.
     1800             assign
     1801               frame Dialog-Frame :width = v-frame-width
     1802             .
     1803             if frame Dialog-Frame :scrollable = true
     1804             then do:
     1805               assign
     1806                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1807               .
     1808             end.
     1809             run diasize_position-resize-button in this-procedure .
     1810           end.
     1811           else do:
     1812             if frame Dialog-Frame :scrollable = true
     1813             then do:
     1814               assign
     1815                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1816               .
     1817             end.
     1818             assign
     1819               frame Dialog-Frame :width = v-frame-width
     1820             .
     1821             for each buf_temp-browse-handle
     1822               where buf_temp-browse-handle.browse-type = 'width':u
     1823             on error undo, next
     1824             :
     1825               assign
     1826                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1827               .
     1828             end.
     1829             assign
     1830               v-diasize-browse-handle :width = v-browse-width
     1831             .
     1832             for each buf_temp-diasize-handle
     1833             on error undo, next
     1834             :
     1835               assign
     1836                 v-object-handle = buf_temp-diasize-handle.handle-value
     1837               .
     1838               if v-object-handle <> v-diasize-resize-button
     1839               then do:
     1840                 assign
     1841                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1842                 .
     1843               end.
     1844             end.
     1845             run diasize_position-resize-button in this-procedure .
     1846           end.
     1847           assign
     1848             v-diasize-change-size = false
     1849           .
     1850           leave move_block .
     1851         end.
     1852       end.
     1853       assign
     1854         v-diasize-need-full-display = true
     1855       .
     1856       if v-diasize-change-size = false
     1857       then do:
     1858         assign
     1859           v-diasize-change-size = true
     1860         .
     1861       end.
     1862       else do:
     1863         return .
     1864       end.
     1865       assign
     1866         v-frame-width = frame Dialog-Frame :width
     1867         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1868         v-browse-width = v-diasize-browse-handle :width
     1869       .
     1870       for each buf_temp-browse-handle
     1871         where buf_temp-browse-handle.browse-type = 'width':u
     1872       :
     1873         assign
     1874           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1875         .
     1876       end.
     1877       for each buf_temp-diasize-handle
     1878       :
     1879         delete buf_temp-diasize-handle .
     1880       end.
     1881       assign
     1882         v-field-group-handle = frame Dialog-Frame :first-child
     1883       .
     1884       do while valid-handle(v-field-group-handle)
     1885       :
     1886         assign
     1887           v-object-handle = v-field-group-handle :first-child
     1888         .
     1889         do while valid-handle(v-object-handle)
     1890         :
     1891           if  v-object-handle <> v-diasize-browse-handle :handle
     1892           and v-object-handle <> v-diasize-resize-button
     1893           and can-query(v-object-handle, "row")
     1894           and can-query(v-object-handle, "height")
     1895           and ( v-object-handle :col + v-object-handle :width
     1896                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1897               )
     1898           then do:
     1899             find first buf_temp-browse-handle
     1900               where buf_temp-browse-handle.browse-type   = 'width':u
     1901                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1902               no-error .
     1903             if available buf_temp-browse-handle
     1904             then do:
     1905             end.
     1906             else do:
     1907               create buf_temp-diasize-handle .
     1908               assign
     1909                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1910                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1911               .
     1912             end.
     1913           end.
     1914           assign
     1915             v-object-handle = v-object-handle :next-sibling
     1916           .
     1917         end.
     1918         assign
     1919           v-field-group-handle = v-field-group-handle :next-sibling
     1920         .
     1921       end.
     1922       do with frame Dialog-Frame
     1923       :
     1924         hide v-diasize-resize-button .
     1925         v-diasize-resize-button :row = 1.
     1926         v-diasize-resize-button :column = 1.
     1927       end.
     1928       if p-change-value > 0
     1929       then do:
     1930         if frame Dialog-Frame :scrollable = true
     1931         then do:
     1932           assign
     1933             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1934             no-error .
     1935           if error-status :error
     1936           or error-status :get-message(1) <> ""
     1937           then do:
     1938             undo move_block, retry move_block.
     1939           end.
     1940         end.
     1941         assign
     1942           frame Dialog-Frame :width = v-frame-width + p-change-value
     1943           no-error .
     1944         if error-status :error
     1945         or error-status :get-message(1) <> ""
     1946         then do:
     1947           undo move_block, retry move_block.
     1948         end.
     1949         assign
     1950           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1951         no-error .
     1952         if error-status :error
     1953         or error-status :get-message(1) <> ""
     1954         then do:
     1955           undo move_block, retry move_block.
     1956         end.
     1957         for each buf_temp-browse-handle
     1958           where buf_temp-browse-handle.browse-type = 'width':u
     1959         on error undo move_block, retry move_block
     1960         :
     1961           assign
     1962             buf_temp-browse-handle.browse-handle :width
     1963               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1964             no-error .
     1965           if error-status :error
     1966           or error-status :get-message(1) <> ""
     1967           then do:
     1968             undo move_block, retry move_block .
     1969           end.
     1970         end.
     1971         for each buf_temp-diasize-handle
     1972         on error undo move_block, retry move_block
     1973         :
     1974           assign
     1975             v-object-handle = buf_temp-diasize-handle.handle-value
     1976           .
     1977           if v-object-handle <> v-diasize-resize-button
     1978           then do:
     1979             assign
     1980               v-object-handle :col = v-object-handle :col + p-change-value
     1981               no-error .
     1982             if error-status :error
     1983             or error-status :get-message(1) <> ""
     1984             then do:
     1985               undo move_block, retry move_block .
     1986             end.
     1987           end.
     1988         end.
     1989       end.
     1990       else do:
     1991         for each buf_temp-diasize-handle
     1992         on error undo move_block, retry move_block
     1993         :
     1994           assign
     1995             v-object-handle = buf_temp-diasize-handle.handle-value
     1996           .
     1997           if v-object-handle <> v-diasize-resize-button
     1998           then do:
     1999             assign
     2000               v-object-handle :col = v-object-handle :col + p-change-value
     2001               no-error .
     2002             if error-status :error
     2003             or error-status :get-message(1) <> ""
     2004             then do:
     2005               undo move_block, retry move_block .
     2006             end.
     2007           end.
     2008         end.
     2009         for each buf_temp-browse-handle
     2010           where buf_temp-browse-handle.browse-type = 'width':u
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             buf_temp-browse-handle.browse-handle :width
     2015               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2016             no-error .
     2017           if error-status :error
     2018           or error-status :get-message(1) <> ""
     2019           then do:
     2020             undo move_block, retry move_block .
     2021           end.
     2022         end.
     2023         assign
     2024           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2025           no-error .
     2026         if error-status :error
     2027         or error-status :get-message(1) <> ""
     2028         then do:
     2029           undo move_block, retry move_block.
     2030         end.
     2031         assign
     2032           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2033         no-error .
     2034         if error-status :error
     2035         or error-status :get-message(1) <> ""
     2036         then do:
     2037           undo move_block, retry move_block.
     2038         end.
     2039         if frame Dialog-Frame :scrollable = true
     2040         then do:
     2041           assign
     2042             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2043           no-error .
     2044           if error-status :error
     2045           or error-status :get-message(1) <> ""
     2046           then do:
     2047             undo move_block, retry move_block.
     2048           end.
     2049         end.
     2050       end.
     2051       if p-move-resize
     2052       then do:
     2053         run diasize_position-resize-button in this-procedure .
     2054       end.
     2055       if v-diasize-wndstore = true
     2056       then do:
     2057         if connected("ub") = true
     2058         then do:
     2059           define variable v-cntxt-db-num        as integer   no-undo .
     2060           define variable v-cntxt-userid        as character no-undo .
     2061           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2062                                             , OUTPUT v-cntxt-userid
     2063                                             ) .
     2064           run gbl/wndsizew.p
     2065             (input  v-cntxt-db-num
     2066             ,input  v-cntxt-userid
     2067             ,input  v-diasize-proc-name
     2068             ,input  'width':u
     2069             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2070             ) .
     2071         end.
     2072       end.
     2073     end.
     2074     assign
     2075       v-diasize-change-size = false
     2076     .
     2077   end procedure.
     2078   procedure diasize_set-width :
     2079     define input  parameter p-new-width  as decimal   no-undo .
     2080     define input  parameter p-move-resize as logical   no-undo .
     2081     do
     2082     on error undo, return error return-value
     2083     :
     2084       run diasize_change-width in this-procedure
     2085         (input  (p-new-width - frame Dialog-Frame :width)
     2086         ,input  p-move-resize
     2087         ) .
     2088     end.
     2089   end procedure.
     2090   procedure diasize_position-resize-button :
     2091     do with frame Dialog-Frame
     2092     :
     2093       hide v-diasize-resize-button .
     2094       assign
     2095         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2096                     - 1
     2097                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2098         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2099                     - 1
     2100                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2101       .
     2102       view v-diasize-resize-button .
     2103     end.
     2104   end procedure.
     2105   on alt-right anywhere
     2106   do:
     2107     run diasize_change-width in this-procedure
     2108       (input 1
     2109       ,input true
     2110       ) .
     2111     return no-apply .
     2112   end.
     2113   on alt-left anywhere
     2114   do:
     2115     run diasize_change-width in this-procedure
     2116       (input -1
     2117       ,input true
     2118       ) .
     2119     return no-apply .
     2120   end.
     2121   on alt-down anywhere
     2122   do:
     2123     run diasize_change-height in this-procedure
     2124       (input 1
     2125       ,input true
     2126       ) .
     2127     return no-apply .
     2128   end.
     2129   on alt-up anywhere
     2130   do:
     2131     run diasize_change-height in this-procedure
     2132       (input -1
     2133       ,input true
     2134       ) .
     2135     return no-apply .
     2136   end.
     2137   on alt-enter of frame Dialog-Frame
     2138   do:
     2139     run diasize_maximize in this-procedure
     2140       (input  ?
     2141       ).
     2142     return no-apply .
     2143   end.
     2144   procedure diasize_end-move :
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       define variable v-row-delta as decimal   no-undo .
     2149       define variable v-col-delta as decimal   no-undo .
     2150       define variable v-new-row as decimal   no-undo .
     2151       define variable v-new-col as decimal   no-undo .
     2152       assign
     2153         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2154         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2155       .
     2156       assign
     2157         v-row-delta = v-new-row - frame Dialog-Frame :height
     2158         v-col-delta = v-new-col - frame Dialog-Frame :width
     2159       .
     2160       run diasize_change-height in this-procedure
     2161         (input v-row-delta
     2162         ,input true
     2163         ) .
     2164       run diasize_change-width in this-procedure
     2165         (input v-col-delta
     2166         ,input true
     2167         ) .
     2168     end.
     2169   end procedure.
     2170   procedure diasize_maximize :
     2171     define input  parameter p-action as logical   no-undo .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       if p-action = ?
     2176       then do:
     2177         if v-diasize-need-maximize = true
     2178         then do:
     2179           assign
     2180             p-action = true
     2181           .
     2182         end.
     2183         else do:
     2184           assign
     2185             p-action = false
     2186           .
     2187         end.
     2188       end.
     2189       if p-action = true
     2190       then do:
     2191         run diasize_change-height in this-procedure
     2192           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2193               - frame Dialog-Frame :height-chars
     2194           ,input true
     2195           ) .
     2196         run diasize_change-width in this-procedure
     2197           (input session :width-chars
     2198               - frame Dialog-Frame :width-chars
     2199           ,input true
     2200           ) .
     2201         assign
     2202           v-diasize-need-maximize = false
     2203         .
     2204       end.
     2205       else do:
     2206         run diasize_change-width in this-procedure
     2207           (input v-diasize-orig-frame-width
     2208               - frame Dialog-Frame :width-chars
     2209           ,input true
     2210           ) .
     2211         run diasize_change-height in this-procedure
     2212           (input v-diasize-orig-frame-height
     2213               - frame Dialog-Frame :height-chars
     2214           ,input true
     2215           ) .
     2216         assign
     2217           v-diasize-need-maximize = true
     2218         .
     2219       end.
     2220     end.
     2221   end procedure.
     2222   procedure diasize_restore-orig-size :
     2223     do
     2224     on error undo, return error return-value
     2225     :
     2226       assign
     2227         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2228         v-diasize-current-frame-height = frame Dialog-Frame :height
     2229       .
     2230       run diasize_set-height in this-procedure
     2231         (input  v-diasize-orig-frame-height
     2232         ,input  true
     2233         ) .
     2234       run diasize_set-width in this-procedure
     2235         (input  v-diasize-orig-frame-width
     2236         ,input  true
     2237         ) .
     2238     end.
     2239   end procedure.
     2240   procedure diasize_restore-current-size :
     2241     do
     2242     on error undo, return error return-value
     2243     :
     2244       run diasize_set-height in this-procedure
     2245         (input  v-diasize-current-frame-height
     2246         ,input  true
     2247         ) .
     2248       run diasize_set-width in this-procedure
     2249         (input  v-diasize-current-frame-width
     2250         ,input  true
     2251         ) .
     2252     end.
     2253   end procedure.
     2254   procedure diasize_set-browse-handle :
     2255     define input  parameter p-browse-handle as handle   no-undo .
     2256     define buffer buf_temp-browse-handle for temp-browse-handle .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       assign
     2261         v-diasize-browse-handle = p-browse-handle
     2262       .
     2263       for each buf_temp-browse-handle
     2264       on error undo, return error return-value
     2265       :
     2266         delete buf_temp-browse-handle .
     2267       end.
     2268     end.
     2269   end procedure.
     2270   procedure diasize_add_browse :
     2271     define input  parameter p-browse-type   as character no-undo .
     2272     define input  parameter p-browse-handle as handle    no-undo .
     2273     define buffer buf_temp-browse-handle for temp-browse-handle .
     2274     do
     2275     on error undo, return error return-value
     2276     :
     2277       assign
     2278         v-diasize-browse-number = v-diasize-browse-number + 1
     2279       .
     2280       create buf_temp-browse-handle .
     2281       assign
     2282         buf_temp-browse-handle.browse-type   = p-browse-type
     2283         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2284         buf_temp-browse-handle.browse-handle = p-browse-handle
     2285       .
     2286     end.
     2287   end procedure.
     2288   procedure diasize_init :
     2289     define variable v-default-value    as logical   no-undo .
     2290     define variable v-restore-saved    as logical   no-undo .
     2291     define variable v-resize-value-str as character no-undo .
     2292     do
     2293     on error undo, return error return-value
     2294     :
     2295       do with frame Dialog-Frame
     2296       :
     2297         assign
     2298           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2299           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2300           v-diasize-browse-handle     = browse BR-c-fin-doc :handle
     2301         .
     2302         create button v-diasize-resize-button
     2303         assign
     2304           parent        = frame Dialog-Frame :first-child
     2305           label         = "s"
     2306           height-pixels = 16
     2307           width-pixels  = 16
     2308           visible       = true
     2309           sensitive     = true
     2310           movable       = true
     2311           triggers:
     2312             on end-move persistent run diasize_end-move in this-procedure .
     2313           end triggers.
     2314         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2315         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2316         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2317         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2318         assign
     2319           v-diasize-wndmax = false
     2320         .
     2321         if connected("ub") = true
     2322         then do:
     2323           define variable v-cntxt-db-num        as integer   no-undo .
     2324           define variable v-cntxt-userid        as character no-undo .
     2325           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2326                                             , OUTPUT v-cntxt-userid
     2327                                             ) .
     2328           run gbl/wndpar_r.p
     2329             (input  v-cntxt-db-num
     2330             ,input  v-cntxt-userid
     2331             ,input  'wndmax':U
     2332             ,output v-diasize-wndmax
     2333             ,output v-default-value
     2334             ) .
     2335         end.
     2336         assign
     2337           v-diasize-wndstore = false
     2338         .
     2339         if connected("ub") = true
     2340         then do:
     2341           run gbl/wndpar_r.p
     2342             (input  v-cntxt-db-num
     2343             ,input  v-cntxt-userid
     2344             ,input  'wndstore':U
     2345             ,output v-diasize-wndstore
     2346             ,output v-default-value
     2347             ) .
     2348         end.
     2349         assign
     2350           v-diasize-proc-name = entry(1, program-name(2), '.')
     2351         .
     2352         if v-diasize-wndstore = true
     2353         then do:
     2354           assign
     2355             v-restore-saved = false
     2356           .
     2357           if connected("ub") = true
     2358           then do:
     2359             run gbl/wndsizer.p
     2360               (input  v-cntxt-db-num
     2361               ,input  v-cntxt-userid
     2362               ,input  v-diasize-proc-name
     2363               ,input  'height':u
     2364               ,output v-resize-value-str
     2365               ) .
     2366             if v-resize-value-str <> '':U
     2367             then do:
     2368               run diasize_change-height in this-procedure
     2369                 (input  integer(v-resize-value-str)
     2370                 ,input  true
     2371                 ) .
     2372               assign
     2373                 v-restore-saved = true
     2374               .
     2375             end.
     2376           end.
     2377           if connected("ub") = true
     2378           then do:
     2379             run gbl/wndsizer.p
     2380               (input  v-cntxt-db-num
     2381               ,input  v-cntxt-userid
     2382               ,input  v-diasize-proc-name
     2383               ,input  'width':u
     2384               ,output v-resize-value-str
     2385               ) .
     2386             if v-resize-value-str <> '':U
     2387             then do:
     2388               run diasize_change-width in this-procedure
     2389                 (input  integer(v-resize-value-str)
     2390                 ,input  true
     2391                 ) .
     2392               assign
     2393                 v-restore-saved = true
     2394               .
     2395             end.
     2396           end.
     2397           if v-restore-saved <> true
     2398           then do:
     2399             if v-diasize-wndmax = true
     2400             then do:
     2401               run diasize_maximize in this-procedure
     2402                 (input  true
     2403                 ) .
     2404             end.
     2405           end.
     2406         end.
     2407         else do:
     2408           if v-diasize-wndmax = true
     2409           then do:
     2410             run diasize_maximize in this-procedure
     2411               (input  true
     2412               ) .
     2413           end.
     2414         end.
     2415       end.
     2416     end.
     2417   end procedure.
     2418   procedure diasize_need-full-display :
     2419     define output parameter p-need-full-display as logical   no-undo .
     2420     do
     2421     on error undo, return error return-value
     2422     :
     2423       assign
     2424         p-need-full-display = v-diasize-need-full-display
     2425       .
     2426       assign
     2427         v-diasize-need-full-display = false
     2428       .
     2429     end.
     2430   end procedure.
     2431   procedure get-context :
     2432      define output parameter p-db-num as integer          no-undo.
     2433      define output parameter p-user-id as character        no-undo.
     2434      define variable v-login               as character    no-undo.
     2435      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2436      define buffer buf_user-login  for ub.user-login .
     2437      do
     2438      on error undo, return error
     2439      :
     2440            FIND FIRST buf_sys-ctrl no-lock.
     2441            ASSIGN
     2442               v-login = USERID("ub")
     2443               p-db-num = buf_sys-ctrl.db-num
     2444            .
     2445            FIND FIRST buf_user-login
     2446                 WHERE buf_user-login.db-num = p-db-num
     2447                   AND buf_user-login.user-login = v-login
     2448                 no-lock
     2449                 no-error
     2450                 .
     2451            IF AVAILABLE buf_user-login
     2452            THEN DO:
     2453               assign
     2454                  p-user-id = buf_user-login.user-id
     2455               .
     2456            END.
     2457      end.
     2458   end procedure.
     2459   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   on f5 of frame Dialog-Frame anywhere
     2461   do:
     2462     v-doc-rec = recid(buf_c-fin-doc). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-c-fin-doc to recid v-doc-rec no-error. v-doc-rec = ?.
     2463       apply "VALUE-CHANGED" to BR-c-fin-doc.
     2464   end.
     2465   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2466   procedure set-filter-name :
     2467   define input parameter p-filter-name as character no-undo .
     2468     do with frame Dialog-Frame:
     2469       if p-filter-name > "" then do:
     2470         assign
     2471           frame Dialog-Frame:title
     2472             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2473         .
     2474         assign
     2475           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2476         .
     2477       end.
     2478       else do:
     2479         assign
     2480           b-sch :tooltip = ""
     2481         .
     2482       end.
     2483     end.
     2484   end procedure.
     2485   MAIN-BLOCK:
     2486   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2487      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2488   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489     run mainmenu_getcntxt in parparentproc
     2490       (output v-cntxt-db-num
     2491       ,output v-cntxt-userid
     2492       ,output v-cntxt-level
     2493       ,output v-cntxt-host-code-obj
     2494       ,output v-cntxt-obj-type
     2495       ,output v-cntxt-obj-code
     2496       ,output v-cntxt-db-num-obj
     2497       ,output v-cntxt-is-admin
     2498       ) .
     2499     RUN enable_UI.
     2500     RUN OpenBR in this-procedure ( input yes, input no, input '':U).
     2501     WAIT-FOR GO OF FRAME Dialog-Frame.
     2502   END.
     2503   RUN disable_UI.
     2504   PROCEDURE disable_UI :
     2505     HIDE FRAME Dialog-Frame.
     2506   END PROCEDURE.
     2507   PROCEDURE enable_UI :
     2508     DISPLAY FILL-IN-data FILL-IN-doc-code
     2509         WITH FRAME Dialog-Frame.
     2510     ENABLE b-quit b-lkp B-print B-sch B-Help BR-c-fin-doc FILL-IN-data
     2511            FILL-IN-doc-code
     2512         WITH FRAME Dialog-Frame.
     2513     VIEW FRAME Dialog-Frame.
     2514     OPEN QUERY BR-c-fin-doc FOR EACH buf_c-fin-doc where (buf_c-fin-doc.host-code = p-curr-host-code) and (buf_c-fin-doc.is-del = yes) by buf_c-fin-doc.corr-date descending.
     2515   END PROCEDURE.
     2516   PROCEDURE OpenBr :
     2517   define input  parameter p-open-query     as logical   no-undo .
     2518   define input  parameter p-find-next      as logical   no-undo .
     2519   define input  parameter p-find-condition as character no-undo .
     2520   define variable title0 as character no-undo.
     2521   define variable v-filter-name as character no-undo .
     2522   title0 = frame Dialog-Frame:TITLE.
     2523   define variable l-query-was-opened as logical no-undo .
     2524   run waitfram-show in this-procedure ("Ждите...").
     2525   define variable sort-column-phrase as character no-undo .
     2526   define variable l-open-query as logical   no-undo .
     2527   filter-point = filter-point0.
     2528       if p-open-query then do:
     2529       end.
     2530       filter-label = substitute("&1", filter-label0).
     2531   if p-open-query then do:
     2532      for first buf_clients where buf_clients.obj-type = "орг" and buf_clients.obj-code = p-host-code :
     2533       frame Dialog-Frame:TITLE  = "Удаленные финансовые документы" + chr(32) + substitute(" Фирма: (&1) &2", p-host-code, buf_clients.obj-name).
     2534     end.
     2535       filter-label = substitute("&1 Удаленные в статусе ФАКТ", filter-label0)
     2536                                         .
     2537   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2538   define variable  l-disable-where-20  as logical   no-undo .
     2539   define variable  l-filter-open-20    as logical   .
     2540   define variable  flt-rec-20       as recid     no-undo .
     2541   define variable  filter-name-20      as character no-undo .
     2542   define variable  where-phrase-20     as character no-undo .
     2543   define variable  sort-phrase-20      as character no-undo .
     2544   define variable  where-phrase-rus-20 as character no-undo .
     2545   define variable  sort-phrase-rus-20  as character no-undo .
     2546     run waitfram-show in this-procedure
     2547       (input "ЖДИТЕ ..."
     2548       ).
     2549   run gbl/flt-get.p
     2550     (input filter-point
     2551     ,output flt-rec-20
     2552     ,output filter-name-20
     2553     ,output where-phrase-20
     2554     ,output sort-phrase-20
     2555     ,output where-phrase-rus-20
     2556     ,output sort-phrase-rus-20
     2557     ).
     2558   if p-open-query then do:
     2559       run set-filter-name in this-procedure
     2560         (INPUT filter-name-20
     2561         ) no-error .
     2562     assign
     2563       l-filter-open-20 = false
     2564     .
     2565     if flt-rec-20 <> ?
     2566       or sort-column-phrase > ""
     2567     then do:
     2568       define variable  parameter-2-20 as character no-undo .
     2569       define variable  parameter-3-20 as character no-undo .
     2570       define variable  parameter-4-20 as character no-undo .
     2571       define variable  parameter-5-20 as character no-undo .
     2572       define variable  parameter-6-20 as character no-undo .
     2573       define variable  parameter-7-20 as character no-undo .
     2574         assign
     2575         parameter-3-20 =
     2576                                 "FOR EACH buf_c-fin-doc"
     2577         parameter-4-20 =
     2578           (
     2579             if (" buf_c-fin-doc.host-code = p-host-code AND buf_c-fin-doc.is-del = yes " + " " + where-phrase-20) <> ""
     2580             then  substitute('buf_c-fin-doc.host-code = &1 AND buf_c-fin-doc.is-del = yes ', p-host-code) + " " + where-phrase-20
     2581             else "true"
     2582           )
     2583         parameter-5-20 = (" " + "" + " " + "")
     2584         parameter-6-20 = if sort-phrase-20 = ''
     2585                              then
     2586           (
     2587           " " + "  " +
     2588             " " + sort-column-phrase +
     2589           " " + " by buf_c-fin-doc.corr-date descending "
     2590           )
     2591                              else
     2592           (
     2593           " " + "  " +
     2594             " " + sort-column-phrase +
     2595           " " + sort-phrase-20
     2596           )
     2597         parameter-7-20 =
     2598           " indexed-reposition  "
     2599       .
     2600       do
     2601       on stop undo, leave
     2602       on error undo, leave
     2603       :
     2604         assign
     2605           l-disable-where-20 =
     2606             (" buf_c-fin-doc.host-code = p-host-code AND buf_c-fin-doc.is-del = yes " + " " + where-phrase-20 = "")
     2607         .
     2608         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2609                             ,input QUERY br-c-fin-doc:handle
     2610                             ,input parameter-3-20
     2611                             ,input parameter-4-20
     2612                             ,input parameter-5-20
     2613                             ,input parameter-6-20
     2614                             ,input parameter-7-20
     2615                             )
     2616         .
     2617         assign
     2618           l-filter-open-20 = true
     2619         .
     2620       end.
     2621       if l-filter-open-20 = false then do:
     2622         message
     2623           "Ошибка при фильтрации / сортировке" skip
     2624           "Будут показаны записи без учета фильтра" skip
     2625           view-as alert-box .
     2626       end.
     2627       else do:
     2628           assign
     2629             l-query-was-opened = true
     2630           .
     2631       end.
     2632     end.
     2633     if l-filter-open-20 = false then do:
     2634       OPEN QUERY br-c-fin-doc FOR EACH buf_c-fin-doc
     2635         where  buf_c-fin-doc.host-code = p-host-code AND buf_c-fin-doc.is-del = yes
     2636          by buf_c-fin-doc.corr-date descending
     2637         indexed-reposition
     2638     .
     2639         assign
     2640           l-query-was-opened = true
     2641         .
     2642     end.
     2643   end.
     2644   else do:
     2645     assign
     2646       v-doc-rec = recid( buf_c-fin-doc )
     2647     .
     2648     do
     2649     on stop undo, leave
     2650     on error undo, leave
     2651     :
     2652       if QUERY br-c-fin-doc:handle:get-buffer-handle(1) = (buffer buf_c-fin-doc:handle) then do:
     2653         assign
     2654         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     2655         parameter-4-20 =
     2656           "where ":u +  substitute('buf_c-fin-doc.host-code = &1 AND buf_c-fin-doc.is-del = yes ', p-host-code) + " ":u + where-phrase-20 + " ":u + p-find-condition + " " + ""
     2657         parameter-5-20 = "  "
     2658       .
     2659         run fltopend_fltfindd in this-procedure  (
     2660                             input this-procedure:handle
     2661                             ,input QUERY br-c-fin-doc:handle
     2662                             ,input rowid(buf_c-fin-doc)
     2663                             ,input logical(parameter-2-20)
     2664                             ,input no-lock
     2665                             ,input (buffer buf_c-fin-doc:handle)
     2666                             ,input parameter-4-20
     2667                             ,input parameter-5-20
     2668                             ) no-error.
     2669         .
     2670         assign
     2671           v-doc-rec = integer(return-value)
     2672           v-fltopend-rowid[1] = ?
     2673         .
     2674       end.
     2675       else do:
     2676         assign
     2677         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     2678         parameter-3-20 =  "FOR EACH buf_c-fin-doc"
     2679         parameter-4-20 =
     2680           (
     2681             if (" buf_c-fin-doc.host-code = p-host-code AND buf_c-fin-doc.is-del = yes " + " " + where-phrase-20) <> ""
     2682             then  substitute('buf_c-fin-doc.host-code = &1 AND buf_c-fin-doc.is-del = yes ', p-host-code) + " " + where-phrase-20
     2683             else "true"
     2684           )
     2685         parameter-5-20 = (" " + "" + " " + "" + " " + p-find-condition)
     2686         parameter-6-20 = if sort-phrase-20 = ''
     2687                              then
     2688           (
     2689           " " + "  " +
     2690             " " + sort-column-phrase +
     2691           " " + " by buf_c-fin-doc.corr-date descending "
     2692           )
     2693                              else
     2694           (
     2695           " " + "  " +
     2696             " " + sort-column-phrase +
     2697           " " + sort-phrase-20
     2698           )
     2699         parameter-7-20 =
     2700           " indexed-reposition  "
     2701       .
     2702         run fltopend_fltfindq in this-procedure  (
     2703                             input this-procedure:handle
     2704                             ,input QUERY br-c-fin-doc:handle
     2705                             ,input logical(parameter-2-20)
     2706                             ,input no-lock
     2707                             ,input parameter-3-20
     2708                             ,input parameter-4-20
     2709                             ,input parameter-5-20
     2710                             ,input parameter-6-20
     2711                             ,input parameter-7-20
     2712                             ,output v-fltopend-rowid
     2713                             ) no-error.
     2714         .
     2715         v-doc-rec = ?.
     2716       end.
     2717       assign
     2718         l-query-was-opened = true
     2719       .
     2720     end.
     2721   end.
     2722     run waitfram-hide in this-procedure .
     2723   end.
     2724   if not p-open-query and v-doc-rec <> ? then
     2725   reposition br-c-fin-doc to recid v-doc-rec no-error.
     2726   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2727   query br-c-fin-doc:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     2728   run waitfram-hide in this-procedure .
     2729   apply "VALUE-CHANGED" to br-c-fin-doc in frame Dialog-Frame.
     2730   apply "ENTRY" to br-c-fin-doc.
     2731   end procedure.
     2732   PROCEDURE proc-b-print :
     2733       run proc-print-list no-error.
     2734   end procedure.
     2735   PROCEDURE proc-b-sch :
     2736   assign
     2737     tbl = 'c-fin-doc'
     2738     join-tbl = 'buf_c-fin-doc'
     2739     fld = ""
     2740     lab = ""
     2741     spr = ""
     2742     dim = '0'.
     2743   run fltfield-add in this-procedure('fin-doc-type', 'Тип', '',
     2744   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2745   run fltfield-add in this-procedure('prn-doc-code', 'Номер', '',
     2746   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2747   run fltfield-add in this-procedure('fin-doc-code ', 'Вн. №', '',
     2748   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2749   run fltfield-add in this-procedure('doc-date', 'Дата док-та', '',
     2750   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2751   run fltfield-add in this-procedure('fact-date', 'Дата факт', '',
     2752   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2753   run fltfield-add in this-procedure('corr-date', 'Дата удал.', '',
     2754   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2755   run fltfield-add in this-procedure('corr-time', 'Время', '',
     2756   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2757   run fltfield-add in this-procedure('corr-user-name', 'Удалил', '',
     2758   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2759   run fltfield-add in this-procedure('sum-doc', 'Сумма', '',
     2760   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2761   run fltfield-add in this-procedure('receiver-name', 'Получатель', '',
     2762   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2763   run fltfield-add in this-procedure('payer-name', 'Плательщик', '',
     2764   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2765   Filter-Block:
     2766   do on stop     undo Filter-Block, leave Filter-Block
     2767       on error   undo Filter-Block, leave Filter-Block
     2768       on end-key undo Filter-Block, leave Filter-Block :
     2769     run gbl/filter.w ( input parparentproc
     2770                      , input (filter-point + chr(4) + filter-label)
     2771                      , input tbl
     2772                      , input join-tbl
     2773                      , input fld
     2774                      , input lab
     2775                      , input spr
     2776                      , input dim ).
     2777     run OpenBr in this-procedure ( input yes, input no, input '':U).
     2778   end.
     2779   end procedure.
     2780   PROCEDURE proc-print-list :
     2781   define variable v-doc-rec        as recid     no-undo.
     2782   define variable accum-count      as integer   no-undo.
     2783   define variable date_string      as character no-undo.
     2784   define variable c-Line           as character no-undo.
     2785   define variable c-corr-time      as character no-undo.
     2786   define variable c-corr-user-name as character no-undo.
     2787   define variable c-receiver       as character no-undo .
     2788   define variable c-payer          as character no-undo .
     2789   define frame c-fin-doc-list
     2790         buf_c-fin-doc.fin-doc-type                                         format "X(4)":U
     2791         buf_c-fin-doc.prn-doc-code                                         format "X(16)":U
     2792         buf_c-fin-doc.fin-doc-code               column-label "Вн.N"       format "999999999":U
     2793         buf_c-fin-doc.doc-date                                             format "99/99/9999":U
     2794         buf_c-fin-doc.fact-date                  column-label "Дата факт"  format "99/99/9999":U
     2795         buf_c-fin-doc.corr-date                  column-label "Дата удал." format "99/99/9999":U
     2796         c-corr-time                              column-label "Время"      format "X(5)":U
     2797         c-corr-user-name                         column-label "Удалил"     format "X(16)":U
     2798         buf_c-fin-doc.sum-doc                                              format ">>,>>>,>>>,>>9.99":U
     2799         buf_c-fin-doc.receiver-name              column-label "Получатель" format "X(25)":U
     2800         c-receiver                               column-label ""           format "X(7)":U
     2801         buf_c-fin-doc.payer-name                 column-label "Плательщик" format "X(25)":U
     2802         c-payer                                  column-label ""           format "X(7)":U
     2803   header  date_string at 5 format "X(35)"
     2804       string( "Страница " ) format "X(9)" at 115 page-number(PrnLibStream) at 125 format ">>9" skip
     2805       c-Line format "X(178)" at 1
     2806       with width 232 down stream-io use-text    .
     2807       c-Line = fill("-", 198).
     2808       date_string = cur-time-print() .
     2809   run prn-lib-open-stream  in this-procedure (
     2810                                                input parParentProc
     2811                                               ,input 43
     2812                                               ,input yes
     2813                                               ,input no
     2814                                               ).
     2815   put stream PrnLibStream
     2816       space(25) ( frame Dialog-Frame:title )
     2817       format "x(90)" skip(1) .
     2818       form header
     2819       c-Line format "X(178)" at 1 skip
     2820       "Продолжение - на следующей странице" at 30 skip
     2821       with frame BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2822       view  stream PrnLibStream frame BottomFrame .
     2823   form with frame c-fin-doc-list.
     2824   run waitfram-show in this-procedure ("Ждите...").
     2825   v-doc-rec = recid(buf_c-fin-doc).
     2826   do while available buf_c-fin-doc :
     2827     get prev BR-c-fin-doc.
     2828   end.
     2829   get next BR-c-fin-doc.
     2830   do while available buf_c-fin-doc :
     2831       c-corr-time = string(buf_c-fin-doc.corr-time, "hh:mm").
     2832       c-corr-user-name = usrfulnf(buf_c-fin-doc.corr-user-name).
     2833       c-receiver = buf_c-fin-doc.receiver-type + string(buf_c-fin-doc.receiver-code).
     2834       c-payer = buf_c-fin-doc.payer-type + string(buf_c-fin-doc.payer-code).
     2835       display stream PrnLibStream
     2836           buf_c-fin-doc.fin-doc-type
     2837           buf_c-fin-doc.prn-doc-code
     2838           buf_c-fin-doc.fin-doc-code
     2839           buf_c-fin-doc.doc-date
     2840           buf_c-fin-doc.fact-date
     2841           buf_c-fin-doc.corr-date
     2842           c-corr-time
     2843           c-corr-user-name
     2844           buf_c-fin-doc.sum-doc
     2845           buf_c-fin-doc.receiver-name
     2846           c-receiver
     2847           buf_c-fin-doc.payer-name
     2848           c-payer
     2849           with frame c-fin-doc-list.
     2850       down stream PrnLibStream 1
     2851           with frame c-fin-doc-list.
     2852     assign accum-count = accum-count + 1.
     2853     get next BR-c-fin-doc.
     2854   end.
     2855   underline stream PrnLibStream
     2856           buf_c-fin-doc.fin-doc-type
     2857           buf_c-fin-doc.prn-doc-code
     2858           buf_c-fin-doc.fin-doc-code
     2859           buf_c-fin-doc.doc-date
     2860           buf_c-fin-doc.fact-date
     2861           buf_c-fin-doc.corr-date
     2862           c-corr-time
     2863           c-corr-user-name
     2864           buf_c-fin-doc.sum-doc
     2865           buf_c-fin-doc.receiver-name
     2866           c-receiver
     2867           buf_c-fin-doc.payer-name
     2868           c-payer
     2869         with frame c-fin-doc-list.
     2870   display stream PrnLibStream
     2871       "ИТОГО" @ buf_c-fin-doc.fin-doc-type
     2872       accum-count @ buf_c-fin-doc.prn-doc-code
     2873       with frame c-fin-doc-list.
     2874   hide  stream PrnLibStream frame BottomFrame.
     2875   hide  stream PrnLibStream frame c-fin-doc-list.
     2876   output  STREAM PrnLibStream CLOSE.
     2877   reposition BR-c-fin-doc to recid v-doc-rec no-error.
     2878   APPLY "entry" to br-c-fin-doc.
     2879   run waitfram-hide in this-procedure .
     2880   run prn-lib-prn-file in this-procedure (
     2881                                             input parParentProc
     2882                                             ,input 8
     2883                                             ).
     2884   end procedure.
     2885   PROCEDURE proc_lookup :
     2886   define variable loc#log     as logical no-undo.
     2887   define variable loc-doc-rec as recid   no-undo .
     2888   define variable lock-obj    as logical no-undo .
     2889   do:
     2890   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2891   do:
     2892     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2893       (input  v-cntxt-db-num
     2894       ,input  v-cntxt-userid
     2895       ,input  0
     2896       ,input  'actn_fin-doc_lookup':U
     2897       ,input  'firm':U
     2898       ,input  p-curr-host-code
     2899       ,input  '':U
     2900       ,input  0
     2901       ,input  0
     2902       ,input  0
     2903       ,input  0
     2904       ,input  true
     2905       ,output loc#log
     2906       )  .
     2907   end.
     2908   end.
     2909   if not loc#log then return error.
     2910   case p-mode:
     2911     when 'объект':U
     2912     or when "type-object"
     2913     or when "type-stat-object"
     2914     then do:
     2915       assign
     2916       lock-obj = yes
     2917       .
     2918     end.
     2919   end.
     2920   assign
     2921   loc-doc-rec = recid(buf_c-fin-doc).
     2922     case buf_c-fin-doc.fin-doc-type:
     2923       when 'пко':U then do:
     2924               run ref/fncdoci1.w
     2925                             (
     2926                                input parParentProc
     2927                               ,input p-curr-host-code
     2928                               ,input 'ПРОСМОТР':U
     2929                               ,input buf_c-fin-doc.host-code
     2930                               ,input buf_c-fin-doc.fin-doc-code
     2931                               ,input buf_c-fin-doc.fin-ext-doc-type
     2932                               ,input-output loc-doc-rec
     2933                                           )
     2934               .
     2935       end.
     2936       when 'рко':U then do:
     2937               run ref/fncdoci2.w
     2938                             (
     2939                                input parParentProc
     2940                               ,input p-curr-host-code
     2941                               ,input 'ПРОСМОТР':U
     2942                               ,input buf_c-fin-doc.host-code
     2943                               ,input buf_c-fin-doc.fin-doc-code
     2944                               ,input buf_c-fin-doc.fin-ext-doc-type
     2945                               ,input-output loc-doc-rec
     2946                                           )
     2947               .
     2948       end.
     2949       when 'ппп':U then do:
     2950               run ref/fncdoci3.w
     2951                             (
     2952                                input parParentProc
     2953                               ,input p-curr-host-code
     2954                               ,input 'ПРОСМОТР':U
     2955                               ,input buf_c-fin-doc.host-code
     2956                               ,input buf_c-fin-doc.fin-doc-code
     2957                               ,input buf_c-fin-doc.fin-ext-doc-type
     2958                               ,input-output loc-doc-rec
     2959                                           )
     2960               .
     2961       end.
     2962       when 'рпп':U then do:
     2963               run ref/fncdoci4.w
     2964                             (
     2965                                input parParentProc
     2966                               ,input p-curr-host-code
     2967                               ,input 'ПРОСМОТР':U
     2968                               ,input buf_c-fin-doc.host-code
     2969                               ,input buf_c-fin-doc.fin-doc-code
     2970                               ,input buf_c-fin-doc.fin-ext-doc-type
     2971                               ,input-output loc-doc-rec
     2972                                           )
     2973               .
     2974       end.
     2975       when 'апп':U then do:
     2976               run ref/fncdoci5.w
     2977                             (
     2978                                input parParentProc
     2979                               ,input p-curr-host-code
     2980                               ,input 'ПРОСМОТР':U
     2981                               ,input buf_c-fin-doc.host-code
     2982                               ,input buf_c-fin-doc.fin-doc-code
     2983                               ,input buf_c-fin-doc.fin-ext-doc-type
     2984                               ,input-output loc-doc-rec
     2985                                           )
     2986               .
     2987       end.
     2988       when 'апр':U then do:
     2989               run ref/fncdoci6.w
     2990                             (
     2991                                input parParentProc
     2992                               ,input p-curr-host-code
     2993                               ,input 'ПРОСМОТР':U
     2994                               ,input buf_c-fin-doc.host-code
     2995                               ,input buf_c-fin-doc.fin-doc-code
     2996                               ,input buf_c-fin-doc.fin-ext-doc-type
     2997                               ,input-output loc-doc-rec
     2998                                           )
     2999               .
     3000       end.
     3001   end case.
     3002   if error-status:error then do:
     3003     undo, return error .
     3004   end.
     3005   end procedure.
