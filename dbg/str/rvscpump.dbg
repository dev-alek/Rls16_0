        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Просмотр записи истории изменения строки сверки ТРК":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer buf_goods for ub.goods.
      113   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      114   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      115   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      116   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      117   define frame fr-D-rvs-line-8
      118     ub.c-rvs-line-pump.meas-el-cnt   at row  1.25 col 25.25 colon-aligned label "Измер. электр. счетчика"  view-as fill-in size-chars 23.00 by 1.00
      119     ub.c-rvs-line-pump.state-el-cnt  at row  1.25 col 74.75 colon-aligned label "Показ. электр. счетчика"  view-as fill-in size-chars 23.00 by 1.00
      120     ub.c-rvs-line-pump.meas-am-cnt   at row  2.50 col 25.25 colon-aligned label "Сумма по измер."          view-as fill-in size-chars 23.00 by 1.00
      121     ub.c-rvs-line-pump.state-am-cnt  at row  2.50 col 74.75 colon-aligned label "Сумма по показ."          view-as fill-in size-chars 23.00 by 1.00
      122     ub.c-rvs-line-pump.meas-cf-cnt   at row  3.75 col 25.25 colon-aligned label "Кол-во наливов по измер." view-as fill-in size-chars 19.00 by 1.00
      123     ub.c-rvs-line-pump.state-cf-cnt  at row  3.75 col 74.75 colon-aligned label "Кол-во наливов по показ." view-as fill-in size-chars 19.00 by 1.00
      124     ub.c-rvs-line-pump.meas-mh-cnt   at row  5.00 col 25.25 colon-aligned label "Измер. мех. счетчика"     view-as fill-in size-chars 23.00 by 1.00
      125     ub.c-rvs-line-pump.state-mh-cnt  at row  5.00 col 74.75 colon-aligned label "Показ. мех. счетчика"     view-as fill-in size-chars 23.00 by 1.00
      126     ub.c-rvs-line-pump.meas-mh-qnty  at row  6.25 col 25.25 colon-aligned label "Измер. оборот"            view-as fill-in size-chars 17.00 by 1.00
      127     ub.c-rvs-line-pump.state-mh-qnty at row  6.25 col 74.75 colon-aligned                                  view-as fill-in size-chars 17.00 by 1.00
      128     ub.c-rvs-line-pump.meas-am-qnty  at row  7.50 col 25.25 colon-aligned label "Измер. сумма оборота"     view-as fill-in size-chars 16.00 by 1.00
      129     ub.c-rvs-line-pump.state-am-qnty at row  7.50 col 74.75 colon-aligned                                  view-as fill-in size-chars 16.00 by 1.00
      130     ub.c-rvs-line-pump.meas-cf-qnty  at row  8.75 col 25.25 colon-aligned label "Измер. кол-во наливов"    view-as fill-in size-chars 11.00 by 1.00
      131     ub.c-rvs-line-pump.state-cf-qnty at row  8.75 col 74.75 colon-aligned label "Факт кол-во наливов"      view-as fill-in size-chars 11.00 by 1.00
      132     r-rect-0               at row 10.25 col  1.50
      133       Btn_Exit             at row 10.50 col  2.50
      134       Btn_OK               at row 10.50 col 78.00
      135     b-help            at row 10.50 col 88.75
      136   with view-as dialog-box side-labels no-underline three-d scrollable
      137        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      138   assign frame fr-D-rvs-line-8 :scrollable = no.
      139   on choose of Btn_OK in frame fr-D-rvs-line-8 do:
      140   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   if lookup(self :type
      142            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      143            ) = 0
      144   then do:
      145     message
      146       "$Workfile$"
      147       "Указанному интерфейсному элементу фокус не может быть передан" skip
      148       "Интерфейсный элемент" self :name  skip
      149       "Тип" self :type  skip
      150       "Процедура" this-procedure :file-name skip
      151       view-as alert-box .
      152   end.
      153   else do:
      154     apply "entry":u to self  .
      155     if focus :handle <> self :handle  then do:
      156       return no-apply .
      157     end.
      158   end.
      159     apply "GO":U to frame fr-D-rvs-line-8.
      160   end.
      161   on choose of Btn_Exit in frame fr-D-rvs-line-8 do:
      162   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   if lookup(self :type
      164            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      165            ) = 0
      166   then do:
      167     message
      168       "$Workfile$"
      169       "Указанному интерфейсному элементу фокус не может быть передан" skip
      170       "Интерфейсный элемент" self :name  skip
      171       "Тип" self :type  skip
      172       "Процедура" this-procedure :file-name skip
      173       view-as alert-box .
      174   end.
      175   else do:
      176     apply "entry":u to self  .
      177     if focus :handle <> self :handle  then do:
      178       return no-apply .
      179     end.
      180   end.
      181   end.
      182   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on F1 of frame fr-D-rvs-line-8 anywhere do:
      184     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-rvs-line-8. END.
      185     return no-apply.
      186   end.
      187   if valid-handle( active-window ) and frame fr-D-rvs-line-8 :parent = ? then frame fr-D-rvs-line-8 :parent = active-window.
      188   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      189   on window-close of frame fr-D-rvs-line-8 do: apply "END-ERROR":U to self. end.
      190   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   on help of frame fr-D-rvs-line-8
      192   do:
      193     run gbl/app_help.p
      194       (input this-procedure :file-name
      195       ,input ''
      196       ,input ?
      197       ) no-error.
      198     if error-status :error then do:
      199       message
      200         "Ошибка при вызове помощи"
      201         error-status :get-message(1)
      202         view-as alert-box .
      203     end.
      204   end.
      205   run minbtn-set in this-procedure .
      206   on choose of b-help in frame fr-D-rvs-line-8
      207   do:
      208     apply "help":u to frame fr-D-rvs-line-8 .
      209   end.
      210   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   procedure minbtn-set :
      212       do
      213           on error undo, return error return-value
      214           :
      215           define variable ii              as integer       no-undo .
      216           define variable fh              as widget-handle no-undo .
      217           define variable hh              as widget-handle no-undo .
      218           define variable v-h             as handle        extent 4 no-undo .
      219           define variable v-name-button   as character     no-undo .
      220           define variable v-help-old-x    as decimal       no-undo .
      221           define variable v-help-old-y    as decimal       no-undo .
      222           define variable v-help-old-size as decimal       no-undo .
      223           define variable v-frame-width   as decimal       no-undo .
      224           define variable jj              as integer       no-undo .
      225           do
      226               on error undo, return error
      227               :
      228               assign
      229                   v-frame-width = frame fr-D-rvs-line-8:width - 0.3
      230                   fh            = frame fr-D-rvs-line-8:first-child
      231                   hh            = fh:first-child
      232                   ii            = 1
      233                   .
      234               do while valid-handle(hh):
      235                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      236                   do:
      237                       case lc(hh:name) :
      238                           when "b-help" then
      239                               do:
      240                                   hh:load-image-up("cmp/b-help.bmp":u) .
      241                                   hh:load-image-down("cmp/b-help.bmp":u) .
      242                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      243                                   hh:TOOLTIP = "Помощь" .
      244                                   v-help-old-x = hh:column .
      245                                   v-help-old-y = hh:row    .
      246                                   v-help-old-size = hh:width .
      247                                   hh:width-chars = 2.5 .
      248                               end.
      249                           when "b-print" then
      250                               do:
      251                                   hh:load-image("cmp/b-print.bmp":u) .
      252                                   hh:TOOLTIP = "Печать" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-history" or
      258                           when "b-hist" then
      259                               do:
      260                                   hh:load-image("cmp/b-hist.bmp":u) .
      261                                   hh:TOOLTIP = "История" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-sch" then
      267                               do:
      268                                   hh:load-image("cmp/b-sch.bmp":u) .
      269                                   hh:TOOLTIP = "Установка Фильтра" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-hist-user" then
      275                               do:
      276                                   hh:load-image("cmp/b-hist.bmp":u) .
      277                                   hh:TOOLTIP = "История пользователя" .
      278                                   ii = ii + 1 .
      279                               end.
      280                       end case.
      281                   end.
      282                   hh = hh:next-sibling.
      283               end.
      284               b-help:column = v-frame-width - b-help:width-chars.
      285               jj = 0.
      286               repeat ii = 4 to 1 by -1 :
      287                   if valid-handle (v-h[ii] ) then
      288                   do:
      289                       jj  = jj + 1 .
      290                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      291                       v-h[ii]:row    = v-help-old-y .
      292                   end.
      293               end.
      294           end.
      295       end.
      296   end procedure.
      297   Main-Block:
      298   do on error   undo Main-Block, leave Main-Block
      299      on end-key undo Main-Block, leave Main-Block :
      300     if p-mode <> 'ПРОСМОТР':U then do:
      301       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      302               "Неверное значение параметра вызова p-mode:" p-mode
      303       view-as alert-box error.
      304       undo Main-Block, return error.
      305     end.
      306     find ub.c-rvs-line-pump no-lock where recid( ub.c-rvs-line-pump ) = p-rec-id no-error.
      307     if not available ub.c-rvs-line-pump then do:
      308       message "Карточка истории строки сверки не найдена!" view-as alert-box error.
      309       undo Main-Block, leave Main-Block.
      310     end.
      311     find first buf_goods no-lock where buf_goods.gds-code = ub.c-rvs-line-pump.gds-code.
      312     assign frame fr-D-rvs-line-8 :title = 'Карточка истории изменения строки сверки  # '  + ub.c-rvs-line-pump.rvs-code +
      313                                         ' товар '      + buf_goods.artic                + ' ':U             +
      314                                                                  buf_goods.prod-type    + ' ':U             +
      315                                                          string( buf_goods.prod-code  ) +
      316                                         ' скл. место ' + string( ub.c-rvs-line-pump.pl-code     ) +
      317                                         ' ТРК '        + string( ub.c-rvs-line-pump.pump-code   ) +
      318                                         ' пистолет '   + string( ub.c-rvs-line-pump.nozzle-code ) + '  --  '          + p-mode.
      319     display ub.c-rvs-line-pump.meas-el-cnt  ub.c-rvs-line-pump.state-el-cnt
      320             ub.c-rvs-line-pump.meas-am-cnt  ub.c-rvs-line-pump.state-am-cnt
      321             ub.c-rvs-line-pump.meas-cf-cnt  ub.c-rvs-line-pump.state-cf-cnt
      322             ub.c-rvs-line-pump.meas-mh-cnt  ub.c-rvs-line-pump.state-mh-cnt
      323             ub.c-rvs-line-pump.meas-mh-qnty ub.c-rvs-line-pump.state-mh-qnty
      324             ub.c-rvs-line-pump.meas-am-qnty ub.c-rvs-line-pump.state-am-qnty
      325             ub.c-rvs-line-pump.meas-cf-qnty ub.c-rvs-line-pump.state-cf-qnty
      326     with frame fr-D-rvs-line-8.
      327     enable Btn_Exit b-help with frame fr-D-rvs-line-8.
      328     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-rvs-line-8. end.
      329     wait-for go of frame fr-D-rvs-line-8.
      330   end.
      331   hide frame fr-D-rvs-line-8 no-pause.
