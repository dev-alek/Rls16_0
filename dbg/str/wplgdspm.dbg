        1   DEFINE BUFFER X_goods FOR ub.goods.
        2   DEFINE BUFFER X_pl-gds-pump FOR ub.pl-gds-pump.
        3   DEFINE BUFFER X_pl-pump-nozzle FOR ub.pl-pump-nozzle.
        4   DEFINE BUFFER X_place FOR ub.place.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter parobj-type like ub.clients.obj-type no-undo.
        7   define input parameter parobj-code like ub.clients.obj-code no-undo.
        8   define input parameter parbutton   as   character           no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Товар из резервуара на ТРК".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define new global shared variable g#library  as handle no-undo .
      119   define new global shared variable g#library2 as handle no-undo .
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   function nzpl-spl returns logical
      122   (input p-obj-type as character
      123                                   , input p-obj-code as integer):
      124   define variable v-dopi    as integer no-undo .
      125   define variable v-param-type as character no-undo .
      126   define variable v-value-character as character no-undo .
      127   define variable v-value-date as date no-undo .
      128   define variable v-value-decimal as decimal no-undo .
      129   define variable v-value-integer as integer no-undo .
      130   define variable v-value-logical as logical no-undo .
      131   define variable v-tth as handle no-undo .
      132   define variable dflt-cd as character no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable v-param-type1 as character no-undo .
      135   define variable v-value-date1 as date no-undo .
      136   define variable v-value-decimal1 as decimal no-undo .
      137   define variable v-value-integer1 as INTEGER no-undo .
      138   define variable v-value-logical1 AS LOGICAL no-undo .
      139   define variable v-tth1 as handle no-undo .
      140   run adm/shattri.p (
      141       input "get":U
      142       ,input  p-obj-type
      143       ,input  p-obj-code
      144       ,input  'cd-sending':U
      145       ,input  'dflt-cd':U
      146       ,output dflt-cd
      147       ,output v-value-date1
      148       ,output v-value-decimal1
      149       ,output v-value-integer1
      150       ,output v-value-logical1
      151       ,output v-param-type1
      152       ,INPUT-OUTPUT table-handle v-tth1
      153       ) no-error .
      154   delete object v-tth1 no-error.
      155   if dflt-cd <> 'IBM':U
      156   and dflt-cd <> 'IBM-XML':U then return no.
      157   if dflt-cd = 'IBM-XML':U then return yes.
      158   run adm/shattri.p (
      159       input "get":U
      160       ,input  p-obj-type
      161       ,input  p-obj-code
      162       ,input  'cd-type-ibm':U
      163       ,input  'ibmspool':U
      164       ,output v-value-character
      165       ,output v-value-date
      166       ,output v-value-decimal
      167       ,output v-value-integer
      168       ,output v-value-logical
      169       ,output v-param-type
      170       ,INPUT-OUTPUT table-handle v-tth
      171       ) no-error .
      172   if error-status:error then do:
      173     delete object v-tth.
      174     return no.
      175   end.
      176   delete object v-tth.
      177   assign
      178   v-dopi = v-value-integer no-error .
      179   if v-dopi >= 6 then return yes.
      180   end. // FUNCTION/method
      181   FUNCTION nzpl-two returns logical
      182                                    (input p-obj-type as character
      183                                     , input p-obj-code as integer):
      184     define variable v-nzpl-two as logical no-undo.
      185     run
      186     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      187     return v-nzpl-two.
      188   end. // FUNCTION/method
      189   procedure nzpl-two-proc :
      190   define input  parameter p-obj-type   as character no-undo.
      191   define input  parameter p-obj-code   as integer   no-undo.
      192   define output parameter varge-two-pl as logical   no-undo.
      193   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      194   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      195   //do on error undo, return error return-value :
      196   assign
      197     varge-two-pl = no.
      198   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      199                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      200                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      201     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      202                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      203                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      204                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      205                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      206                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      207     if available bf-other_pl-gds-pump then do:
      208       assign
      209         varge-two-pl = yes.
      210       leave.
      211     end.
      212   end.
      213   //end.
      214   end. // procedure/method .
      215   procedure cplgdspm :
      216     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      217     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      218     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      219     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      220     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      221     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      222       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      223       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      224       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      225       define buffer bf-place                for ub.place.
      226       if parstatus = 'тек':U then do:
      227         for each bf_pl-gds-pump no-lock
      228           where bf_pl-gds-pump.obj-type  =  parobj-type
      229             and bf_pl-gds-pump.obj-code  =  parobj-code
      230             and bf_pl-gds-pump.gds-code  =  pargds-code
      231             and bf_pl-gds-pump.pump-code =  parpump-code
      232             and bf_pl-gds-pump.pl-code   <> parpl-code
      233             and bf_pl-gds-pump.status_   =  'тек':U
      234         on error undo, return error
      235         :
      236           find first place where
      237                      place.obj-type = parobj-type
      238                  and place.obj-code = parobj-code
      239                  and place.pl-code  = parpl-code
      240                no-lock no-error.
      241           find first bf-place where
      242                      bf-place.obj-type = parobj-type
      243                  and bf-place.obj-code = parobj-code
      244                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      245                no-lock no-error.
      246           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      247             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      248                                        ,parobj-type
      249                                        ,parobj-code
      250                                        ,if available place then place.loc1 else string(parpl-code)
      251                                        ,pargds-code
      252                                        ,parpump-code
      253                                        ,parstatus
      254                                        ,chr(10)
      255                                       )
      256                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      257                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      258                                     ).
      259           end.
      260           else do:
      261             find first bf_pl-pump-nozzle no-lock
      262               where bf_pl-pump-nozzle.obj-type  = parobj-type
      263                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      264                 and bf_pl-pump-nozzle.pump-code = parpump-code
      265                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      266               no-error.
      267             if available bf_pl-pump-nozzle then do:
      268               find first bf-other_pl-pump-nozzle no-lock
      269                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      270                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      271                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      272                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      273                 no-error.
      274               if available bf-other_pl-pump-nozzle
      275                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      276               then do:
      277                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      278                                          ,parobj-type
      279                                          ,parobj-code
      280                                          ,if available place then place.loc1 else string(parpl-code)
      281                                          ,pargds-code
      282                                          ,parpump-code
      283                                          ,parstatus
      284                                          ,chr(10)
      285                                        )
      286                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      287                                           ,bf_pl-gds-pump.obj-type
      288                                           ,bf_pl-gds-pump.obj-code
      289                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      290                                           ,bf_pl-gds-pump.status_
      291                                         ).
      292               end.
      293             end.
      294           end.
      295         end.
      296       end.
      297   end . // procedure/method
      298   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299     define variable v-cntxt-db-num        as integer   no-undo .
      300     define variable v-cntxt-userid        as character no-undo .
      301     define variable v-cntxt-level         as character no-undo .
      302     define variable v-cntxt-host-code-obj as integer   no-undo .
      303     define variable v-cntxt-obj-type      as character no-undo .
      304     define variable v-cntxt-obj-code      as integer   no-undo .
      305     define variable v-cntxt-db-num-obj    as integer   no-undo .
      306     define variable v-cntxt-is-admin      as logical   no-undo .
      307   define variable varlog as logical no-undo.
      308   define variable gds-rec as recid no-undo .
      309   define variable v-doc-rec as recid no-undo .
      310   DEFINE BUTTON b-block
      311        LABEL "&Блок-вать"
      312        SIZE 10 BY 1 TOOLTIP "Установить статут <Блокированный>".
      313   DEFINE BUTTON b-cur
      314        LABEL "&Текущий"
      315        SIZE 10 BY 1 TOOLTIP "Установить статут <Текущий>".
      316   DEFINE BUTTON b-exit AUTO-GO
      317        LABEL "&Выход"
      318        SIZE 10 BY 1
      319        BGCOLOR 8 .
      320   DEFINE BUTTON b-help
      321        LABEL "&Помощь"
      322        SIZE 3 BY 1
      323        BGCOLOR 8 .
      324   DEFINE BUTTON B-hist
      325        LABEL "Ис&тория"
      326        SIZE 3 BY 1.
      327   DEFINE QUERY b-plgdspm FOR
      328         X_pl-gds-pump,
      329         X_goods,
      330         X_place,
      331         X_pl-pump-nozzle SCROLLING.
      332   DEFINE BROWSE b-plgdspm
      333     QUERY b-plgdspm NO-LOCK DISPLAY
      334         X_pl-gds-pump.pump-code FORMAT ">9":U
      335   X_pl-pump-nozzle.nozzle-code FORMAT ">9":U
      336   X_goods.artic FORMAT "X(16)":U
      337   X_goods.gds-code FORMAT "9999999999":U
      338   X_goods.gds-name FORMAT "X(10)":U
      339   X_place.loc1 COLUMN-LABEL "Резервуар" FORMAT "X(8)":U
      340   X_pl-gds-pump.status_ FORMAT "X(8)":U
      341   X_place.pl-code COLUMN-LABEL "Код резервуара" FORMAT "999999999":U
      342   X_place.pl-name COLUMN-LABEL "Название резервуара"
      343   X_goods.prod-code FORMAT ">>>>>>>>9":U
      344   X_goods.prod-type COLUMN-LABEL "товара" FORMAT "X(3)":U
      345       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.43.
      346   DEFINE FRAME Dialog-Frame
      347        b-exit AT ROW 1 COL 2
      348        b-cur AT ROW 1 COL 12
      349        b-block AT ROW 1 COL 22
      350        B-hist AT ROW 1 COL 92
      351        b-help AT ROW 1 COL 95
      352        b-plgdspm AT ROW 2.43 COL 1
      353        SPACE(0.29) SKIP(0.26)
      354       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      355            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      356            TITLE "Товар из резервуара на ТРК"
      357            DEFAULT-BUTTON b-exit.
      358   ASSIGN
      359          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      360          FRAME Dialog-Frame:HIDDEN           = TRUE.
      361   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      362   DO:
      363     APPLY "END-ERROR":U TO SELF.
      364   END.
      365   ON CHOOSE OF b-block IN FRAME Dialog-Frame
      366   DO:
      367     if available X_pl-gds-pump then do:
      368       run local-stts in this-procedure
      369         ( input 'блок':U
      370         ).
      371     end.
      372   END.
      373   ON CHOOSE OF b-cur IN FRAME Dialog-Frame
      374   DO:
      375     if available X_pl-gds-pump then do:
      376       run local-stts in this-procedure
      377         ( input 'тек':U
      378         ).
      379     end.
      380   END.
      381   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      382   DO:
      383        DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      384      IF AVAILABLE X_pl-gds-pump  THEN DO:
      385           run ref/cplchist.w (
      386                          INPUT parParentProc
      387                        , input parobj-type
      388                        , input parobj-code
      389                        , input "":U
      390                        , input "subject":U
      391                        , input X_pl-gds-pump.obj-type
      392                        , input X_pl-gds-pump.obj-code
      393                        , input X_pl-gds-pump.pl-code
      394                        , input X_pl-gds-pump.gds-code
      395                        , input X_pl-gds-pump.pump-code
      396                        , input 0
      397                        , input 'pl-gds-pump':U
      398                        , input-output v-rid-list
      399                        ) no-error .
      400      END.
      401   END.
      402   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      403   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   on help of frame Dialog-Frame
      406   do:
      407     run gbl/app_help.p
      408       (input this-procedure :file-name
      409       ,input ''
      410       ,input ?
      411       ) no-error.
      412     if error-status :error then do:
      413       message
      414         "Ошибка при вызове помощи"
      415         error-status :get-message(1)
      416         view-as alert-box .
      417     end.
      418   end.
      419   run minbtn-set in this-procedure .
      420   on choose of b-help in frame Dialog-Frame
      421   do:
      422     apply "help":u to frame Dialog-Frame .
      423   end.
      424   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   procedure minbtn-set :
      426       do
      427           on error undo, return error return-value
      428           :
      429           define variable ii              as integer       no-undo .
      430           define variable fh              as widget-handle no-undo .
      431           define variable hh              as widget-handle no-undo .
      432           define variable v-h             as handle        extent 4 no-undo .
      433           define variable v-name-button   as character     no-undo .
      434           define variable v-help-old-x    as decimal       no-undo .
      435           define variable v-help-old-y    as decimal       no-undo .
      436           define variable v-help-old-size as decimal       no-undo .
      437           define variable v-frame-width   as decimal       no-undo .
      438           define variable jj              as integer       no-undo .
      439           do
      440               on error undo, return error
      441               :
      442               assign
      443                   v-frame-width = frame Dialog-Frame:width - 0.3
      444                   fh            = frame Dialog-Frame:first-child
      445                   hh            = fh:first-child
      446                   ii            = 1
      447                   .
      448               do while valid-handle(hh):
      449                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      450                   do:
      451                       case lc(hh:name) :
      452                           when "b-help" then
      453                               do:
      454                                   hh:load-image-up("cmp/b-help.bmp":u) .
      455                                   hh:load-image-down("cmp/b-help.bmp":u) .
      456                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      457                                   hh:TOOLTIP = "Помощь" .
      458                                   v-help-old-x = hh:column .
      459                                   v-help-old-y = hh:row    .
      460                                   v-help-old-size = hh:width .
      461                                   hh:width-chars = 2.5 .
      462                               end.
      463                           when "b-print" then
      464                               do:
      465                                   hh:load-image("cmp/b-print.bmp":u) .
      466                                   hh:TOOLTIP = "Печать" .
      467                                   v-h[ii] = hh:handle .
      468                                   ii = ii + 1 .
      469                                   hh:width-chars = 3 .
      470                               end.
      471                           when "b-history" or
      472                           when "b-hist" then
      473                               do:
      474                                   hh:load-image("cmp/b-hist.bmp":u) .
      475                                   hh:TOOLTIP = "История" .
      476                                   v-h[ii] = hh:handle .
      477                                   ii = ii + 1 .
      478                                   hh:width-chars = 3 .
      479                               end.
      480                           when "b-sch" then
      481                               do:
      482                                   hh:load-image("cmp/b-sch.bmp":u) .
      483                                   hh:TOOLTIP = "Установка Фильтра" .
      484                                   v-h[ii] = hh:handle .
      485                                   ii = ii + 1 .
      486                                   hh:width-chars = 3 .
      487                               end.
      488                           when "b-hist-user" then
      489                               do:
      490                                   hh:load-image("cmp/b-hist.bmp":u) .
      491                                   hh:TOOLTIP = "История пользователя" .
      492                                   ii = ii + 1 .
      493                               end.
      494                       end case.
      495                   end.
      496                   hh = hh:next-sibling.
      497               end.
      498               b-help:column = v-frame-width - b-help:width-chars.
      499               jj = 0.
      500               repeat ii = 4 to 1 by -1 :
      501                   if valid-handle (v-h[ii] ) then
      502                   do:
      503                       jj  = jj + 1 .
      504                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      505                       v-h[ii]:row    = v-help-old-y .
      506                   end.
      507               end.
      508           end.
      509       end.
      510   end procedure.
      511   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      512   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      513   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      514   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      515   define variable v-diasize-current-frame-width  as decimal   no-undo .
      516   define variable v-diasize-current-frame-height as decimal   no-undo .
      517   define variable v-diasize-change-size          as logical   no-undo .
      518   define variable v-diasize-resize-button        as handle    no-undo .
      519   define variable v-diasize-wndmax               as logical   no-undo .
      520   define variable v-diasize-wndstore             as logical   no-undo .
      521   define variable v-diasize-proc-name            as character no-undo .
      522   define variable v-diasize-browse-handle        as handle    no-undo .
      523   define variable v-diasize-browse-number        as integer   no-undo .
      524   define variable v-diasize-need-full-display    as logical   no-undo init false .
      525   define temp-table temp-diasize-handle no-undo
      526     field handle-value  as handle
      527     field save-position as decimal
      528     index xpk is primary unique handle-value
      529     .
      530   define temp-table temp-browse-handle no-undo
      531     field browse-type   as character
      532     field browse-number as integer
      533     field browse-handle as handle
      534     field original-size as decimal
      535     index xpk is primary unique browse-type browse-number
      536     index xie browse-type browse-handle
      537   .
      538   procedure diasize_change-height :
      539     define input  parameter p-change-value  as decimal   no-undo .
      540     define input  parameter p-move-resize   as logical   no-undo .
      541     define variable v-field-group-handle    as handle    no-undo .
      542     define variable v-object-handle         as handle    no-undo .
      543     define variable v-frame-height          as decimal   no-undo .
      544     define variable v-frame-virtual-height  as decimal   no-undo .
      545     define variable v-browse-height         as decimal   no-undo .
      546     define variable v-window-height         as decimal   no-undo .
      547     define variable v-window-virtual-height as decimal   no-undo .
      548     define variable v-change-sign           as integer   no-undo .
      549     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      550     define buffer buf_temp-browse-handle  for temp-browse-handle .
      551     if p-change-value > 0
      552     then do:
      553       if frame Dialog-Frame :height + p-change-value
      554           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      555       then do:
      556         assign
      557           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      558                           - (frame Dialog-Frame :height-chars)
      559         .
      560         if p-change-value <= 0
      561         then do:
      562           run diasize_position-resize-button in this-procedure .
      563           return .
      564         end.
      565       end.
      566     end.
      567     if p-change-value < 0
      568     then do:
      569       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      570       then do:
      571         assign
      572           p-change-value = v-diasize-orig-frame-height
      573                          - (frame Dialog-Frame :height-chars)
      574         .
      575         if p-change-value >= 0
      576         then do:
      577           run diasize_position-resize-button in this-procedure .
      578           return .
      579         end.
      580       end.
      581     end.
      582     if p-change-value >= 0
      583     then do:
      584       assign
      585         v-change-sign = 1
      586       .
      587     end.
      588     else do:
      589       assign
      590         v-change-sign = -1
      591       .
      592     end.
      593     assign
      594       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      595     .
      596     if p-change-value = 0
      597     then do:
      598       run diasize_position-resize-button in this-procedure .
      599       return .
      600     end.
      601     move_block:
      602     do
      603     on error undo move_block, retry move_block
      604     :
      605       if retry
      606       then do:
      607         do
      608         on error undo move_block, leave move_block
      609         :
      610           if p-change-value > 0
      611           then do:
      612             for each buf_temp-diasize-handle
      613             on error undo, next
      614             :
      615               assign
      616                 v-object-handle = buf_temp-diasize-handle.handle-value
      617               .
      618               if v-object-handle <> v-diasize-resize-button
      619               then do:
      620                 assign
      621                   v-object-handle :row = buf_temp-diasize-handle.save-position
      622                 .
      623               end.
      624             end.
      625             assign
      626               v-diasize-browse-handle :height = v-browse-height
      627             .
      628             for each buf_temp-browse-handle
      629               where buf_temp-browse-handle.browse-type = 'height':u
      630             on error undo, next
      631             :
      632               assign
      633                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      634               .
      635             end.
      636             assign
      637               frame Dialog-Frame :height = v-frame-height
      638             .
      639             if frame Dialog-Frame :scrollable = true
      640             then do:
      641               assign
      642                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      643               .
      644             end.
      645             run diasize_position-resize-button in this-procedure .
      646           end.
      647           else do:
      648             if frame Dialog-Frame :scrollable = true
      649             then do:
      650               assign
      651                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      652               .
      653             end.
      654             assign
      655               frame Dialog-Frame :height = v-frame-height
      656             .
      657             assign
      658               v-diasize-browse-handle :height = v-browse-height
      659             .
      660             for each buf_temp-browse-handle
      661               where buf_temp-browse-handle.browse-type = 'height':u
      662             on error undo, next
      663             :
      664               assign
      665                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      666               .
      667             end.
      668             for each buf_temp-diasize-handle
      669             on error undo, next
      670             :
      671               assign
      672                 v-object-handle = buf_temp-diasize-handle.handle-value
      673               .
      674               if v-object-handle <> v-diasize-resize-button
      675               then do:
      676                 assign
      677                   v-object-handle :row = buf_temp-diasize-handle.save-position
      678                 .
      679               end.
      680             end.
      681             run diasize_position-resize-button in this-procedure .
      682           end.
      683           assign
      684             v-diasize-change-size = false
      685           .
      686           leave move_block .
      687         end.
      688       end.
      689       assign
      690         v-diasize-need-full-display = true
      691       .
      692       if v-diasize-change-size = false
      693       then do:
      694         assign
      695           v-diasize-change-size = true
      696         .
      697       end.
      698       else do:
      699         return .
      700       end.
      701       assign
      702         v-frame-height = frame Dialog-Frame :height
      703         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      704         v-browse-height = v-diasize-browse-handle :height
      705       .
      706       for each buf_temp-browse-handle
      707         where buf_temp-browse-handle.browse-type = 'height':u
      708       :
      709         assign
      710           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      711         .
      712       end.
      713       for each buf_temp-diasize-handle
      714       :
      715         delete buf_temp-diasize-handle .
      716       end.
      717       assign
      718         v-field-group-handle = frame Dialog-Frame :first-child
      719       .
      720       do while valid-handle(v-field-group-handle)
      721       :
      722         assign
      723           v-object-handle = v-field-group-handle :first-child
      724         .
      725         do while valid-handle(v-object-handle)
      726         :
      727           if  v-object-handle <> v-diasize-browse-handle :handle
      728           and can-query(v-object-handle, "row")
      729           and can-query(v-object-handle, "height")
      730           and ( v-object-handle :row > v-diasize-browse-handle :row )
      731           then do:
      732             find first buf_temp-browse-handle
      733               where buf_temp-browse-handle.browse-type   = 'height':u
      734                 and buf_temp-browse-handle.browse-handle = v-object-handle
      735               no-error .
      736             if available buf_temp-browse-handle
      737             then do:
      738             end.
      739             else do:
      740               create buf_temp-diasize-handle .
      741               assign
      742                 buf_temp-diasize-handle.handle-value  = v-object-handle
      743                 buf_temp-diasize-handle.save-position = v-object-handle :row
      744               .
      745             end.
      746           end.
      747           assign
      748             v-object-handle = v-object-handle :next-sibling
      749           .
      750         end.
      751         assign
      752           v-field-group-handle = v-field-group-handle :next-sibling
      753         .
      754       end.
      755       do with frame Dialog-Frame
      756       :
      757         hide v-diasize-resize-button .
      758         assign
      759           v-diasize-resize-button :row    = 1
      760           v-diasize-resize-button :column = 1
      761         .
      762       end.
      763       if p-change-value > 0
      764       then do:
      765         if frame Dialog-Frame :scrollable = true
      766         then do:
      767           assign
      768             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      769             no-error .
      770           if error-status :error
      771           or error-status :get-message(1) <> ""
      772           then do:
      773             undo move_block, retry move_block .
      774           end.
      775         end.
      776         assign
      777           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      778           no-error .
      779         if error-status :error
      780         or error-status :get-message(1) <> ""
      781         then do:
      782           undo move_block, retry move_block .
      783         end.
      784         assign
      785           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      786           no-error .
      787         if error-status :error
      788         or error-status :get-message(1) <> ""
      789         then do:
      790           undo move_block, retry move_block .
      791         end.
      792         for each buf_temp-browse-handle
      793           where buf_temp-browse-handle.browse-type = 'height':u
      794         on error undo move_block, retry move_block
      795         :
      796           assign
      797             buf_temp-browse-handle.browse-handle :height
      798               = buf_temp-browse-handle.browse-handle :height + p-change-value
      799             no-error .
      800           if error-status :error
      801           or error-status :get-message(1) <> ""
      802           then do:
      803             undo move_block, retry move_block .
      804           end.
      805         end.
      806         for each buf_temp-diasize-handle
      807         on error undo move_block, retry move_block
      808         :
      809           assign
      810             v-object-handle = buf_temp-diasize-handle.handle-value
      811           .
      812           if v-object-handle <> v-diasize-resize-button
      813           then do:
      814             assign
      815               v-object-handle :row = v-object-handle :row + p-change-value
      816               no-error .
      817             if error-status :error
      818             or error-status :get-message(1) <> ""
      819             then do:
      820               undo move_block, retry move_block .
      821             end.
      822           end.
      823         end.
      824       end.
      825       else do:
      826         for each buf_temp-diasize-handle
      827         on error undo move_block, retry move_block
      828         :
      829           assign
      830             v-object-handle = buf_temp-diasize-handle.handle-value
      831           .
      832           if v-object-handle <> v-diasize-resize-button
      833           then do:
      834             assign
      835               v-object-handle :row = v-object-handle :row + p-change-value
      836               no-error .
      837             if error-status :error
      838             or error-status :get-message(1) <> ""
      839             then do:
      840               undo move_block, retry move_block .
      841             end.
      842           end.
      843         end.
      844         assign
      845           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      846           no-error .
      847         if error-status :error
      848         or error-status :get-message(1) <> ""
      849         then do:
      850           undo move_block, retry move_block .
      851         end.
      852         for each buf_temp-browse-handle
      853           where buf_temp-browse-handle.browse-type = 'height':u
      854         on error undo move_block, retry move_block
      855         :
      856           assign
      857             buf_temp-browse-handle.browse-handle :height
      858               = buf_temp-browse-handle.browse-handle :height + p-change-value
      859             no-error .
      860           if error-status :error
      861           or error-status :get-message(1) <> ""
      862           then do:
      863             undo move_block, retry move_block .
      864           end.
      865         end.
      866         assign
      867           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      868           no-error .
      869         if error-status :error
      870         or error-status :get-message(1) <> ""
      871         then do:
      872           undo move_block, retry move_block .
      873         end.
      874         if frame Dialog-Frame :scrollable = true
      875         then do:
      876           assign
      877             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      878             no-error .
      879           if error-status :error
      880           or error-status :get-message(1) <> ""
      881           then do:
      882             undo move_block, retry move_block .
      883           end.
      884         end.
      885       end.
      886       if p-move-resize = true
      887       then do:
      888         run diasize_position-resize-button in this-procedure .
      889       end.
      890       if v-diasize-wndstore = true
      891       then do:
      892         if connected("ub") = true
      893         then do:
      894           define variable v-cntxt-db-num        as integer   no-undo .
      895           define variable v-cntxt-userid        as character no-undo .
      896           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      897                                             , OUTPUT v-cntxt-userid
      898                                             ) .
      899           run gbl/wndsizew.p
      900             (input  v-cntxt-db-num
      901             ,input  v-cntxt-userid
      902             ,input  v-diasize-proc-name
      903             ,input  'height':u
      904             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      905             ) .
      906         end.
      907       end.
      908     end.
      909     assign
      910       v-diasize-change-size = false
      911     .
      912   end procedure.
      913   procedure diasize_set-height :
      914     define input  parameter p-new-height  as decimal   no-undo .
      915     define input  parameter p-move-resize as logical   no-undo .
      916     do
      917     on error undo, return error return-value
      918     :
      919       run diasize_change-height in this-procedure
      920         (input  (p-new-height - frame Dialog-Frame :height)
      921         ,input  p-move-resize
      922         ) .
      923     end.
      924   end procedure.
      925   procedure diasize_change-width :
      926     define input  parameter p-change-value as decimal   no-undo .
      927     define input  parameter p-move-resize  as logical   no-undo .
      928     define variable v-field-group-handle   as handle    no-undo .
      929     define variable v-object-handle        as handle    no-undo .
      930     define variable v-frame-width          as decimal   no-undo .
      931     define variable v-frame-virtual-width  as decimal   no-undo .
      932     define variable v-browse-width         as decimal   no-undo .
      933     define variable v-window-width         as decimal   no-undo .
      934     define variable v-window-virtual-width as decimal   no-undo .
      935     define variable v-change-sign          as integer   no-undo .
      936     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      937     define buffer buf_temp-browse-handle  for temp-browse-handle .
      938     if p-change-value > 0
      939     then do:
      940       if frame Dialog-Frame :width + p-change-value >
      941           session :width-chars
      942       then do:
      943         assign
      944           p-change-value = session :width-chars - frame Dialog-Frame :width
      945         .
      946         if p-change-value <= 0
      947         then do:
      948           run diasize_position-resize-button in this-procedure .
      949           return .
      950         end.
      951       end.
      952     end.
      953     if p-change-value < 0
      954     then do:
      955       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      956       then do:
      957         assign
      958           p-change-value = v-diasize-orig-frame-width
      959                          - frame Dialog-Frame :width
      960         .
      961         if p-change-value >= 0
      962         then do:
      963           run diasize_position-resize-button in this-procedure .
      964           return .
      965         end.
      966       end.
      967     end.
      968     if p-change-value >= 0
      969     then do:
      970       assign
      971         v-change-sign = 1
      972       .
      973     end.
      974     else do:
      975       assign
      976         v-change-sign = -1
      977       .
      978     end.
      979     assign
      980       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      981     .
      982     if p-change-value = 0
      983     then do:
      984       run diasize_position-resize-button in this-procedure .
      985       return .
      986     end.
      987     move_block:
      988     do
      989     on error undo move_block, leave move_block
      990     :
      991       if retry
      992       then do:
      993         do
      994         on error undo move_block, leave move_block
      995         :
      996           if p-change-value > 0
      997           then do:
      998             for each buf_temp-diasize-handle
      999             on error undo, next
     1000             :
     1001               assign
     1002                 v-object-handle = buf_temp-diasize-handle.handle-value
     1003               .
     1004               if v-object-handle <> v-diasize-resize-button
     1005               then do:
     1006                 assign
     1007                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1008                 .
     1009               end.
     1010             end.
     1011             assign
     1012               v-diasize-browse-handle :width = v-browse-width
     1013             .
     1014             for each buf_temp-browse-handle
     1015               where buf_temp-browse-handle.browse-type = 'width':u
     1016             on error undo, next
     1017             :
     1018               assign
     1019                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1020               .
     1021             end.
     1022             assign
     1023               frame Dialog-Frame :width = v-frame-width
     1024             .
     1025             if frame Dialog-Frame :scrollable = true
     1026             then do:
     1027               assign
     1028                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1029               .
     1030             end.
     1031             run diasize_position-resize-button in this-procedure .
     1032           end.
     1033           else do:
     1034             if frame Dialog-Frame :scrollable = true
     1035             then do:
     1036               assign
     1037                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1038               .
     1039             end.
     1040             assign
     1041               frame Dialog-Frame :width = v-frame-width
     1042             .
     1043             for each buf_temp-browse-handle
     1044               where buf_temp-browse-handle.browse-type = 'width':u
     1045             on error undo, next
     1046             :
     1047               assign
     1048                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1049               .
     1050             end.
     1051             assign
     1052               v-diasize-browse-handle :width = v-browse-width
     1053             .
     1054             for each buf_temp-diasize-handle
     1055             on error undo, next
     1056             :
     1057               assign
     1058                 v-object-handle = buf_temp-diasize-handle.handle-value
     1059               .
     1060               if v-object-handle <> v-diasize-resize-button
     1061               then do:
     1062                 assign
     1063                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1064                 .
     1065               end.
     1066             end.
     1067             run diasize_position-resize-button in this-procedure .
     1068           end.
     1069           assign
     1070             v-diasize-change-size = false
     1071           .
     1072           leave move_block .
     1073         end.
     1074       end.
     1075       assign
     1076         v-diasize-need-full-display = true
     1077       .
     1078       if v-diasize-change-size = false
     1079       then do:
     1080         assign
     1081           v-diasize-change-size = true
     1082         .
     1083       end.
     1084       else do:
     1085         return .
     1086       end.
     1087       assign
     1088         v-frame-width = frame Dialog-Frame :width
     1089         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1090         v-browse-width = v-diasize-browse-handle :width
     1091       .
     1092       for each buf_temp-browse-handle
     1093         where buf_temp-browse-handle.browse-type = 'width':u
     1094       :
     1095         assign
     1096           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1097         .
     1098       end.
     1099       for each buf_temp-diasize-handle
     1100       :
     1101         delete buf_temp-diasize-handle .
     1102       end.
     1103       assign
     1104         v-field-group-handle = frame Dialog-Frame :first-child
     1105       .
     1106       do while valid-handle(v-field-group-handle)
     1107       :
     1108         assign
     1109           v-object-handle = v-field-group-handle :first-child
     1110         .
     1111         do while valid-handle(v-object-handle)
     1112         :
     1113           if  v-object-handle <> v-diasize-browse-handle :handle
     1114           and v-object-handle <> v-diasize-resize-button
     1115           and can-query(v-object-handle, "row")
     1116           and can-query(v-object-handle, "height")
     1117           and ( v-object-handle :col + v-object-handle :width
     1118                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1119               )
     1120           then do:
     1121             find first buf_temp-browse-handle
     1122               where buf_temp-browse-handle.browse-type   = 'width':u
     1123                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1124               no-error .
     1125             if available buf_temp-browse-handle
     1126             then do:
     1127             end.
     1128             else do:
     1129               create buf_temp-diasize-handle .
     1130               assign
     1131                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1132                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1133               .
     1134             end.
     1135           end.
     1136           assign
     1137             v-object-handle = v-object-handle :next-sibling
     1138           .
     1139         end.
     1140         assign
     1141           v-field-group-handle = v-field-group-handle :next-sibling
     1142         .
     1143       end.
     1144       do with frame Dialog-Frame
     1145       :
     1146         hide v-diasize-resize-button .
     1147         v-diasize-resize-button :row = 1.
     1148         v-diasize-resize-button :column = 1.
     1149       end.
     1150       if p-change-value > 0
     1151       then do:
     1152         if frame Dialog-Frame :scrollable = true
     1153         then do:
     1154           assign
     1155             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1156             no-error .
     1157           if error-status :error
     1158           or error-status :get-message(1) <> ""
     1159           then do:
     1160             undo move_block, retry move_block.
     1161           end.
     1162         end.
     1163         assign
     1164           frame Dialog-Frame :width = v-frame-width + p-change-value
     1165           no-error .
     1166         if error-status :error
     1167         or error-status :get-message(1) <> ""
     1168         then do:
     1169           undo move_block, retry move_block.
     1170         end.
     1171         assign
     1172           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1173         no-error .
     1174         if error-status :error
     1175         or error-status :get-message(1) <> ""
     1176         then do:
     1177           undo move_block, retry move_block.
     1178         end.
     1179         for each buf_temp-browse-handle
     1180           where buf_temp-browse-handle.browse-type = 'width':u
     1181         on error undo move_block, retry move_block
     1182         :
     1183           assign
     1184             buf_temp-browse-handle.browse-handle :width
     1185               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1186             no-error .
     1187           if error-status :error
     1188           or error-status :get-message(1) <> ""
     1189           then do:
     1190             undo move_block, retry move_block .
     1191           end.
     1192         end.
     1193         for each buf_temp-diasize-handle
     1194         on error undo move_block, retry move_block
     1195         :
     1196           assign
     1197             v-object-handle = buf_temp-diasize-handle.handle-value
     1198           .
     1199           if v-object-handle <> v-diasize-resize-button
     1200           then do:
     1201             assign
     1202               v-object-handle :col = v-object-handle :col + p-change-value
     1203               no-error .
     1204             if error-status :error
     1205             or error-status :get-message(1) <> ""
     1206             then do:
     1207               undo move_block, retry move_block .
     1208             end.
     1209           end.
     1210         end.
     1211       end.
     1212       else do:
     1213         for each buf_temp-diasize-handle
     1214         on error undo move_block, retry move_block
     1215         :
     1216           assign
     1217             v-object-handle = buf_temp-diasize-handle.handle-value
     1218           .
     1219           if v-object-handle <> v-diasize-resize-button
     1220           then do:
     1221             assign
     1222               v-object-handle :col = v-object-handle :col + p-change-value
     1223               no-error .
     1224             if error-status :error
     1225             or error-status :get-message(1) <> ""
     1226             then do:
     1227               undo move_block, retry move_block .
     1228             end.
     1229           end.
     1230         end.
     1231         for each buf_temp-browse-handle
     1232           where buf_temp-browse-handle.browse-type = 'width':u
     1233         on error undo move_block, retry move_block
     1234         :
     1235           assign
     1236             buf_temp-browse-handle.browse-handle :width
     1237               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1238             no-error .
     1239           if error-status :error
     1240           or error-status :get-message(1) <> ""
     1241           then do:
     1242             undo move_block, retry move_block .
     1243           end.
     1244         end.
     1245         assign
     1246           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1247           no-error .
     1248         if error-status :error
     1249         or error-status :get-message(1) <> ""
     1250         then do:
     1251           undo move_block, retry move_block.
     1252         end.
     1253         assign
     1254           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1255         no-error .
     1256         if error-status :error
     1257         or error-status :get-message(1) <> ""
     1258         then do:
     1259           undo move_block, retry move_block.
     1260         end.
     1261         if frame Dialog-Frame :scrollable = true
     1262         then do:
     1263           assign
     1264             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1265           no-error .
     1266           if error-status :error
     1267           or error-status :get-message(1) <> ""
     1268           then do:
     1269             undo move_block, retry move_block.
     1270           end.
     1271         end.
     1272       end.
     1273       if p-move-resize
     1274       then do:
     1275         run diasize_position-resize-button in this-procedure .
     1276       end.
     1277       if v-diasize-wndstore = true
     1278       then do:
     1279         if connected("ub") = true
     1280         then do:
     1281           define variable v-cntxt-db-num        as integer   no-undo .
     1282           define variable v-cntxt-userid        as character no-undo .
     1283           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1284                                             , OUTPUT v-cntxt-userid
     1285                                             ) .
     1286           run gbl/wndsizew.p
     1287             (input  v-cntxt-db-num
     1288             ,input  v-cntxt-userid
     1289             ,input  v-diasize-proc-name
     1290             ,input  'width':u
     1291             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1292             ) .
     1293         end.
     1294       end.
     1295     end.
     1296     assign
     1297       v-diasize-change-size = false
     1298     .
     1299   end procedure.
     1300   procedure diasize_set-width :
     1301     define input  parameter p-new-width  as decimal   no-undo .
     1302     define input  parameter p-move-resize as logical   no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       run diasize_change-width in this-procedure
     1307         (input  (p-new-width - frame Dialog-Frame :width)
     1308         ,input  p-move-resize
     1309         ) .
     1310     end.
     1311   end procedure.
     1312   procedure diasize_position-resize-button :
     1313     do with frame Dialog-Frame
     1314     :
     1315       hide v-diasize-resize-button .
     1316       assign
     1317         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1318                     - 1
     1319                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1320         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1321                     - 1
     1322                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1323       .
     1324       view v-diasize-resize-button .
     1325     end.
     1326   end procedure.
     1327   on alt-right anywhere
     1328   do:
     1329     run diasize_change-width in this-procedure
     1330       (input 1
     1331       ,input true
     1332       ) .
     1333     return no-apply .
     1334   end.
     1335   on alt-left anywhere
     1336   do:
     1337     run diasize_change-width in this-procedure
     1338       (input -1
     1339       ,input true
     1340       ) .
     1341     return no-apply .
     1342   end.
     1343   on alt-down anywhere
     1344   do:
     1345     run diasize_change-height in this-procedure
     1346       (input 1
     1347       ,input true
     1348       ) .
     1349     return no-apply .
     1350   end.
     1351   on alt-up anywhere
     1352   do:
     1353     run diasize_change-height in this-procedure
     1354       (input -1
     1355       ,input true
     1356       ) .
     1357     return no-apply .
     1358   end.
     1359   on alt-enter of frame Dialog-Frame
     1360   do:
     1361     run diasize_maximize in this-procedure
     1362       (input  ?
     1363       ).
     1364     return no-apply .
     1365   end.
     1366   procedure diasize_end-move :
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       define variable v-row-delta as decimal   no-undo .
     1371       define variable v-col-delta as decimal   no-undo .
     1372       define variable v-new-row as decimal   no-undo .
     1373       define variable v-new-col as decimal   no-undo .
     1374       assign
     1375         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1376         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1377       .
     1378       assign
     1379         v-row-delta = v-new-row - frame Dialog-Frame :height
     1380         v-col-delta = v-new-col - frame Dialog-Frame :width
     1381       .
     1382       run diasize_change-height in this-procedure
     1383         (input v-row-delta
     1384         ,input true
     1385         ) .
     1386       run diasize_change-width in this-procedure
     1387         (input v-col-delta
     1388         ,input true
     1389         ) .
     1390     end.
     1391   end procedure.
     1392   procedure diasize_maximize :
     1393     define input  parameter p-action as logical   no-undo .
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       if p-action = ?
     1398       then do:
     1399         if v-diasize-need-maximize = true
     1400         then do:
     1401           assign
     1402             p-action = true
     1403           .
     1404         end.
     1405         else do:
     1406           assign
     1407             p-action = false
     1408           .
     1409         end.
     1410       end.
     1411       if p-action = true
     1412       then do:
     1413         run diasize_change-height in this-procedure
     1414           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1415               - frame Dialog-Frame :height-chars
     1416           ,input true
     1417           ) .
     1418         run diasize_change-width in this-procedure
     1419           (input session :width-chars
     1420               - frame Dialog-Frame :width-chars
     1421           ,input true
     1422           ) .
     1423         assign
     1424           v-diasize-need-maximize = false
     1425         .
     1426       end.
     1427       else do:
     1428         run diasize_change-width in this-procedure
     1429           (input v-diasize-orig-frame-width
     1430               - frame Dialog-Frame :width-chars
     1431           ,input true
     1432           ) .
     1433         run diasize_change-height in this-procedure
     1434           (input v-diasize-orig-frame-height
     1435               - frame Dialog-Frame :height-chars
     1436           ,input true
     1437           ) .
     1438         assign
     1439           v-diasize-need-maximize = true
     1440         .
     1441       end.
     1442     end.
     1443   end procedure.
     1444   procedure diasize_restore-orig-size :
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448       assign
     1449         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1450         v-diasize-current-frame-height = frame Dialog-Frame :height
     1451       .
     1452       run diasize_set-height in this-procedure
     1453         (input  v-diasize-orig-frame-height
     1454         ,input  true
     1455         ) .
     1456       run diasize_set-width in this-procedure
     1457         (input  v-diasize-orig-frame-width
     1458         ,input  true
     1459         ) .
     1460     end.
     1461   end procedure.
     1462   procedure diasize_restore-current-size :
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       run diasize_set-height in this-procedure
     1467         (input  v-diasize-current-frame-height
     1468         ,input  true
     1469         ) .
     1470       run diasize_set-width in this-procedure
     1471         (input  v-diasize-current-frame-width
     1472         ,input  true
     1473         ) .
     1474     end.
     1475   end procedure.
     1476   procedure diasize_set-browse-handle :
     1477     define input  parameter p-browse-handle as handle   no-undo .
     1478     define buffer buf_temp-browse-handle for temp-browse-handle .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       assign
     1483         v-diasize-browse-handle = p-browse-handle
     1484       .
     1485       for each buf_temp-browse-handle
     1486       on error undo, return error return-value
     1487       :
     1488         delete buf_temp-browse-handle .
     1489       end.
     1490     end.
     1491   end procedure.
     1492   procedure diasize_add_browse :
     1493     define input  parameter p-browse-type   as character no-undo .
     1494     define input  parameter p-browse-handle as handle    no-undo .
     1495     define buffer buf_temp-browse-handle for temp-browse-handle .
     1496     do
     1497     on error undo, return error return-value
     1498     :
     1499       assign
     1500         v-diasize-browse-number = v-diasize-browse-number + 1
     1501       .
     1502       create buf_temp-browse-handle .
     1503       assign
     1504         buf_temp-browse-handle.browse-type   = p-browse-type
     1505         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1506         buf_temp-browse-handle.browse-handle = p-browse-handle
     1507       .
     1508     end.
     1509   end procedure.
     1510   procedure diasize_init :
     1511     define variable v-default-value    as logical   no-undo .
     1512     define variable v-restore-saved    as logical   no-undo .
     1513     define variable v-resize-value-str as character no-undo .
     1514     do
     1515     on error undo, return error return-value
     1516     :
     1517       do with frame Dialog-Frame
     1518       :
     1519         assign
     1520           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1521           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1522           v-diasize-browse-handle     = browse b-plgdspm :handle
     1523         .
     1524         create button v-diasize-resize-button
     1525         assign
     1526           parent        = frame Dialog-Frame :first-child
     1527           label         = "s"
     1528           height-pixels = 16
     1529           width-pixels  = 16
     1530           visible       = true
     1531           sensitive     = true
     1532           movable       = true
     1533           triggers:
     1534             on end-move persistent run diasize_end-move in this-procedure .
     1535           end triggers.
     1536         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1537         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1538         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1539         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1540         assign
     1541           v-diasize-wndmax = false
     1542         .
     1543         if connected("ub") = true
     1544         then do:
     1545           define variable v-cntxt-db-num        as integer   no-undo .
     1546           define variable v-cntxt-userid        as character no-undo .
     1547           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1548                                             , OUTPUT v-cntxt-userid
     1549                                             ) .
     1550           run gbl/wndpar_r.p
     1551             (input  v-cntxt-db-num
     1552             ,input  v-cntxt-userid
     1553             ,input  'wndmax':U
     1554             ,output v-diasize-wndmax
     1555             ,output v-default-value
     1556             ) .
     1557         end.
     1558         assign
     1559           v-diasize-wndstore = false
     1560         .
     1561         if connected("ub") = true
     1562         then do:
     1563           run gbl/wndpar_r.p
     1564             (input  v-cntxt-db-num
     1565             ,input  v-cntxt-userid
     1566             ,input  'wndstore':U
     1567             ,output v-diasize-wndstore
     1568             ,output v-default-value
     1569             ) .
     1570         end.
     1571         assign
     1572           v-diasize-proc-name = entry(1, program-name(2), '.')
     1573         .
     1574         if v-diasize-wndstore = true
     1575         then do:
     1576           assign
     1577             v-restore-saved = false
     1578           .
     1579           if connected("ub") = true
     1580           then do:
     1581             run gbl/wndsizer.p
     1582               (input  v-cntxt-db-num
     1583               ,input  v-cntxt-userid
     1584               ,input  v-diasize-proc-name
     1585               ,input  'height':u
     1586               ,output v-resize-value-str
     1587               ) .
     1588             if v-resize-value-str <> '':U
     1589             then do:
     1590               run diasize_change-height in this-procedure
     1591                 (input  integer(v-resize-value-str)
     1592                 ,input  true
     1593                 ) .
     1594               assign
     1595                 v-restore-saved = true
     1596               .
     1597             end.
     1598           end.
     1599           if connected("ub") = true
     1600           then do:
     1601             run gbl/wndsizer.p
     1602               (input  v-cntxt-db-num
     1603               ,input  v-cntxt-userid
     1604               ,input  v-diasize-proc-name
     1605               ,input  'width':u
     1606               ,output v-resize-value-str
     1607               ) .
     1608             if v-resize-value-str <> '':U
     1609             then do:
     1610               run diasize_change-width in this-procedure
     1611                 (input  integer(v-resize-value-str)
     1612                 ,input  true
     1613                 ) .
     1614               assign
     1615                 v-restore-saved = true
     1616               .
     1617             end.
     1618           end.
     1619           if v-restore-saved <> true
     1620           then do:
     1621             if v-diasize-wndmax = true
     1622             then do:
     1623               run diasize_maximize in this-procedure
     1624                 (input  true
     1625                 ) .
     1626             end.
     1627           end.
     1628         end.
     1629         else do:
     1630           if v-diasize-wndmax = true
     1631           then do:
     1632             run diasize_maximize in this-procedure
     1633               (input  true
     1634               ) .
     1635           end.
     1636         end.
     1637       end.
     1638     end.
     1639   end procedure.
     1640   procedure diasize_need-full-display :
     1641     define output parameter p-need-full-display as logical   no-undo .
     1642     do
     1643     on error undo, return error return-value
     1644     :
     1645       assign
     1646         p-need-full-display = v-diasize-need-full-display
     1647       .
     1648       assign
     1649         v-diasize-need-full-display = false
     1650       .
     1651     end.
     1652   end procedure.
     1653   procedure get-context :
     1654      define output parameter p-db-num as integer          no-undo.
     1655      define output parameter p-user-id as character        no-undo.
     1656      define variable v-login               as character    no-undo.
     1657      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1658      define buffer buf_user-login  for ub.user-login .
     1659      do
     1660      on error undo, return error
     1661      :
     1662            FIND FIRST buf_sys-ctrl no-lock.
     1663            ASSIGN
     1664               v-login = USERID("ub")
     1665               p-db-num = buf_sys-ctrl.db-num
     1666            .
     1667            FIND FIRST buf_user-login
     1668                 WHERE buf_user-login.db-num = p-db-num
     1669                   AND buf_user-login.user-login = v-login
     1670                 no-lock
     1671                 no-error
     1672                 .
     1673            IF AVAILABLE buf_user-login
     1674            THEN DO:
     1675               assign
     1676                  p-user-id = buf_user-login.user-id
     1677               .
     1678            END.
     1679      end.
     1680   end procedure.
     1681       run diasize_init in this-procedure .
     1682   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   on F9 of frame Dialog-Frame anywhere do:
     1684     if not available ub.goods then
     1685       return no-apply.
     1686     gds-rec = recid (ub.goods).
     1687     run ref/gds-form.w ( input parparentproc
     1688                         ,input 'ПРОСМОТР':U
     1689                         ,input ?
     1690                         ,input ?
     1691                         ,input ?
     1692                         ,input-output gds-rec).
     1693     apply "entry" to b-plgdspm in frame Dialog-Frame.
     1694     return no-apply.
     1695   end.
     1696   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   do:
     1698     b-plgdspm :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1699   end.
     1700   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   on f5 of frame Dialog-Frame anywhere
     1702   do:
     1703      if available X_pl-gds-pump then v-doc-rec = recid(X_pl-gds-pump). OPEN QUERY b-plgdspm FOR EACH X_pl-gds-pump       WHERE X_pl-gds-pump.obj-type = parobj-type  AND X_pl-gds-pump.obj-code = parobj-code NO-LOCK,              EACH X_goods WHERE X_goods.gds-code = X_pl-gds-pump.gds-code NO-LOCK,              EACH X_place WHERE X_place.pl-code = X_pl-gds-pump.pl-code NO-LOCK,              EACH X_pl-pump-nozzle WHERE X_pl-pump-nozzle.obj-type = X_pl-gds-pump.obj-type   AND X_pl-pump-nozzle.obj-code = X_pl-gds-pump.obj-code   AND X_pl-pump-nozzle.pl-code = X_pl-gds-pump.pl-code   AND X_pl-pump-nozzle.pump-code = X_pl-gds-pump.pump-code OUTER-JOIN NO-LOCK     BY X_pl-gds-pump.obj-type      BY X_pl-gds-pump.obj-code       BY X_pl-pump-nozzle.pump-code        BY X_pl-pump-nozzle.nozzle-code.   reposition b-plgdspm to recid v-doc-rec no-error. apply 'ENTRY' to b-plgdspm.
     1704       apply "VALUE-CHANGED" to b-plgdspm.
     1705   end.
     1706   MAIN-BLOCK:
     1707   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1708      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1709   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1710     run mainmenu_getcntxt in parparentproc
     1711       (output v-cntxt-db-num
     1712       ,output v-cntxt-userid
     1713       ,output v-cntxt-level
     1714       ,output v-cntxt-host-code-obj
     1715       ,output v-cntxt-obj-type
     1716       ,output v-cntxt-obj-code
     1717       ,output v-cntxt-db-num-obj
     1718       ,output v-cntxt-is-admin
     1719       ) .
     1720     RUN enable_UI.
     1721     if v-cntxt-db-num <> v-cntxt-db-num-obj then do:
     1722       assign
     1723         b-block :sensitive in frame Dialog-Frame = no
     1724         b-cur :sensitive in frame Dialog-Frame = no
     1725       .
     1726     end.
     1727     WAIT-FOR GO OF FRAME Dialog-Frame.
     1728   END.
     1729   RUN disable_UI.
     1730   PROCEDURE disable_UI :
     1731     HIDE FRAME Dialog-Frame.
     1732   END PROCEDURE.
     1733   PROCEDURE enable_UI :
     1734     ENABLE b-exit b-cur b-block B-hist b-help b-plgdspm
     1735         WITH FRAME Dialog-Frame.
     1736     VIEW FRAME Dialog-Frame.
     1737     OPEN QUERY b-plgdspm FOR EACH X_pl-gds-pump       WHERE X_pl-gds-pump.obj-type = parobj-type  AND X_pl-gds-pump.obj-code = parobj-code NO-LOCK,              EACH X_goods WHERE X_goods.gds-code = X_pl-gds-pump.gds-code NO-LOCK,              EACH X_place WHERE X_place.pl-code = X_pl-gds-pump.pl-code NO-LOCK,              EACH X_pl-pump-nozzle WHERE X_pl-pump-nozzle.obj-type = X_pl-gds-pump.obj-type   AND X_pl-pump-nozzle.obj-code = X_pl-gds-pump.obj-code   AND X_pl-pump-nozzle.pl-code = X_pl-gds-pump.pl-code   AND X_pl-pump-nozzle.pump-code = X_pl-gds-pump.pump-code OUTER-JOIN NO-LOCK     BY X_pl-gds-pump.obj-type      BY X_pl-gds-pump.obj-code       BY X_pl-pump-nozzle.pump-code        BY X_pl-pump-nozzle.nozzle-code.
     1738   END PROCEDURE.
     1739   PROCEDURE local-stts :
     1740   define input  parameter p-stts as character no-undo .
     1741     define variable varrecid as recid no-undo.
     1742     define variable v-host-code as integer   no-undo .
     1743     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1744     do transaction
     1745     on error undo, retry
     1746     :
     1747       if retry then do:
     1748         message
     1749           vss-workfile vss-revision vss-description skip(1)
     1750           substitute( "Ошибка при приcвоении статуса <&1>!", p-stts ) skip
     1751           return-value skip
     1752           error-status :get-message(1)
     1753           view-as alert-box error.
     1754         undo, return error .
     1755       end.
     1756       find first buf_pl-gds-pump exclusive-lock where
     1757                recid(buf_pl-gds-pump) = recid(X_pl-gds-pump).
     1758       if buf_pl-gds-pump.status_ = p-stts then do:
     1759         message
     1760           substitute( "Запись уже имеет статус <&1>.", p-stts )
     1761           view-as alert-box information
     1762         .
     1763         undo, return error .
     1764       end.
     1765   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1766   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1767     (input  parobj-type
     1768     ,input  parobj-code
     1769     ,output v-host-code
     1770     )  .
     1771   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1772   do:
     1773     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1774       (input  v-cntxt-db-num
     1775       ,input  v-cntxt-userid
     1776       ,input  0
     1777       ,input  'actn_plgdspm-sts_work':U
     1778       ,input  'object':U
     1779       ,input  v-host-code
     1780       ,input  parobj-type
     1781       ,input  parobj-code
     1782       ,input  0
     1783       ,input  0
     1784       ,input  0
     1785       ,input  true
     1786       ,output varlog
     1787       )  .
     1788   end.
     1789       if not varlog then do:
     1790         undo, return error .
     1791       end.
     1792       assign
     1793         buf_pl-gds-pump.status_ = p-stts
     1794       .
     1795       if p-stts = 'тек':U then do:
     1796         run cplgdspm in this-procedure
     1797           ( input buf_pl-gds-pump.obj-type
     1798            ,input buf_pl-gds-pump.obj-code
     1799            ,input buf_pl-gds-pump.pl-code
     1800            ,input buf_pl-gds-pump.gds-code
     1801            ,input buf_pl-gds-pump.pump-code
     1802            ,input p-stts
     1803           ).
     1804       end.
     1805     end.
     1806     assign
     1807       varrecid = recid(X_pl-gds-pump)
     1808     .
     1809     OPEN QUERY b-plgdspm FOR EACH X_pl-gds-pump       WHERE X_pl-gds-pump.obj-type = parobj-type  AND X_pl-gds-pump.obj-code = parobj-code NO-LOCK,              EACH X_goods WHERE X_goods.gds-code = X_pl-gds-pump.gds-code NO-LOCK,              EACH X_place WHERE X_place.pl-code = X_pl-gds-pump.pl-code NO-LOCK,              EACH X_pl-pump-nozzle WHERE X_pl-pump-nozzle.obj-type = X_pl-gds-pump.obj-type   AND X_pl-pump-nozzle.obj-code = X_pl-gds-pump.obj-code   AND X_pl-pump-nozzle.pl-code = X_pl-gds-pump.pl-code   AND X_pl-pump-nozzle.pump-code = X_pl-gds-pump.pump-code OUTER-JOIN NO-LOCK     BY X_pl-gds-pump.obj-type      BY X_pl-gds-pump.obj-code       BY X_pl-pump-nozzle.pump-code        BY X_pl-pump-nozzle.nozzle-code.
     1810     reposition b-plgdspm to recid varrecid.
     1811   end procedure.
