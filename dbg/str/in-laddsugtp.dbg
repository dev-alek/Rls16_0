      725     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      726       define variable v-answ as logical no-undo .
      727       if ( p-unit-base-cli-eq = true
      728            and p-density = 1.0
      729          )
      730         or ( p-unit-base-cli-eq = false
      731              and p-density <> ?
      732              and p-density > 0.0
      733              and p-density < 1.0
      734            )
      735       then do:
      736         assign
      737           v-answ = true
      738         .
      739       end.
      740       else do:
      741         assign
      742           v-answ = false
      743         .
      744       end.
      745       return v-answ.
      746     end function.
      747   FUNCTION getNunHoses RETURNS INTEGER
      748     (  )  FORWARD.
      749   DEFINE BUTTON b-help
      750        LABEL "&Помощь"
      751        SIZE 10 BY 1
      752        BGCOLOR 8 .
      753   DEFINE BUTTON b-quit AUTO-END-KEY
      754        LABEL "&Отмена"
      755        SIZE 10 BY 1
      756        BGCOLOR 8 .
      757   DEFINE BUTTON b-save AUTO-GO
      758        LABEL "&Ввод"
      759        SIZE 10 BY 1
      760        BGCOLOR 8 .
      761   DEFINE VARIABLE f-err-allow AS DECIMAL FORMAT "->>>,>>>,>>9.999":U INITIAL ?
      762        LABEL "Допустимые погрешности всех не финальных сливов"
      763        VIEW-AS FILL-IN
      764        SIZE 14 BY 1 NO-UNDO.
      765   DEFINE VARIABLE f-massa-sug AS DECIMAL FORMAT "->>>,>>>,>>9.999":U INITIAL ?
      766        LABEL "Суммарная масса всех не финальных сливов СУГ"
      767        VIEW-AS FILL-IN
      768        SIZE 14 BY 1 NO-UNDO.
      769   DEFINE VARIABLE f-teh-loss AS DECIMAL FORMAT "->>>,>>>,>>9.999":U INITIAL ?
      770        LABEL "Технологические потери всех не финальных сливов"
      771        VIEW-AS FILL-IN
      772        SIZE 14 BY 1 NO-UNDO.
      773   DEFINE VARIABLE f-num-hoses AS INTEGER FORMAT ">>9":U INITIAL 0
      774        LABEL "Кол-во подключений рукавов"
      775        VIEW-AS FILL-IN
      776        SIZE 14 BY 1 NO-UNDO.
      777   DEFINE FRAME Dialog-Frame
      778        b-save AT ROW 1 COL 2.2
      779        b-quit AT ROW 1 COL 12.2
      780        b-help AT ROW 1 COL 66
      781        f-massa-sug AT ROW 2.43 COL 57 COLON-ALIGNED WIDGET-ID 152
      782        f-teh-loss AT ROW 3.62 COL 57 COLON-ALIGNED WIDGET-ID 154
      783        f-err-allow AT ROW 4.81 COL 57 COLON-ALIGNED WIDGET-ID 156
      784        f-num-hoses AT ROW 6 COL 57 COLON-ALIGNED WIDGET-ID 158
      785        "кг" VIEW-AS TEXT
      786             SIZE 3.2 BY .62 AT ROW 5 COL 73.8 WIDGET-ID 164
      787        "кг" VIEW-AS TEXT
      788             SIZE 3.2 BY .62 AT ROW 3.81 COL 73.8 WIDGET-ID 162
      789        "кг" VIEW-AS TEXT
      790             SIZE 4.2 BY .62 AT ROW 2.62 COL 73.8 WIDGET-ID 160
      791        SPACE(0.99) SKIP(5.13)
      792       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      793            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      794            TITLE "Расчет технологических потерь"
      795            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
      796   ASSIGN
      797          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      798          FRAME Dialog-Frame:HIDDEN           = TRUE.
      799   ON GO OF FRAME Dialog-Frame
      800   DO:
      801     if p-mode <> 'ПРОСМОТР':U then
      802     do:
      803       assign frame Dialog-Frame
      804         f-massa-sug
      805         f-teh-loss
      806         f-err-allow
      807       .
      808       if f-massa-sug = ? or
      809          f-teh-loss  = ? or
      810          f-err-allow = ? then
      811       do:
      812         message "Данные не заполнены. Сохранение невозможно."
      813           view-as alert-box error title "Ошибка".
      814         return no-apply.
      815       end.
      816       run save-attr.
      817     end.
      818   END.
      819   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      820   DO:
      821     APPLY "END-ERROR":U TO SELF.
      822   END.
      823   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      824   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      825   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   on help of frame Dialog-Frame
      827   do:
      828     run gbl/app_help.p
      829       (input this-procedure :file-name
      830       ,input ''
      831       ,input ?
      832       ) no-error.
      833     if error-status :error then do:
      834       message
      835         "Ошибка при вызове помощи"
      836         error-status :get-message(1)
      837         view-as alert-box .
      838     end.
      839   end.
      840   run minbtn-set in this-procedure .
      841   on choose of b-help in frame Dialog-Frame
      842   do:
      843     apply "help":u to frame Dialog-Frame .
      844   end.
      845   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   procedure minbtn-set :
      847       do
      848           on error undo, return error return-value
      849           :
      850           define variable ii              as integer       no-undo .
      851           define variable fh              as widget-handle no-undo .
      852           define variable hh              as widget-handle no-undo .
      853           define variable v-h             as handle        extent 4 no-undo .
      854           define variable v-name-button   as character     no-undo .
      855           define variable v-help-old-x    as decimal       no-undo .
      856           define variable v-help-old-y    as decimal       no-undo .
      857           define variable v-help-old-size as decimal       no-undo .
      858           define variable v-frame-width   as decimal       no-undo .
      859           define variable jj              as integer       no-undo .
      860           do
      861               on error undo, return error
      862               :
      863               assign
      864                   v-frame-width = frame Dialog-Frame:width - 0.3
      865                   fh            = frame Dialog-Frame:first-child
      866                   hh            = fh:first-child
      867                   ii            = 1
      868                   .
      869               do while valid-handle(hh):
      870                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      871                   do:
      872                       case lc(hh:name) :
      873                           when "b-help" then
      874                               do:
      875                                   hh:load-image-up("cmp/b-help.bmp":u) .
      876                                   hh:load-image-down("cmp/b-help.bmp":u) .
      877                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      878                                   hh:TOOLTIP = "Помощь" .
      879                                   v-help-old-x = hh:column .
      880                                   v-help-old-y = hh:row    .
      881                                   v-help-old-size = hh:width .
      882                                   hh:width-chars = 2.5 .
      883                               end.
      884                           when "b-print" then
      885                               do:
      886                                   hh:load-image("cmp/b-print.bmp":u) .
      887                                   hh:TOOLTIP = "Печать" .
      888                                   v-h[ii] = hh:handle .
      889                                   ii = ii + 1 .
      890                                   hh:width-chars = 3 .
      891                               end.
      892                           when "b-history" or
      893                           when "b-hist" then
      894                               do:
      895                                   hh:load-image("cmp/b-hist.bmp":u) .
      896                                   hh:TOOLTIP = "История" .
      897                                   v-h[ii] = hh:handle .
      898                                   ii = ii + 1 .
      899                                   hh:width-chars = 3 .
      900                               end.
      901                           when "b-sch" then
      902                               do:
      903                                   hh:load-image("cmp/b-sch.bmp":u) .
      904                                   hh:TOOLTIP = "Установка Фильтра" .
      905                                   v-h[ii] = hh:handle .
      906                                   ii = ii + 1 .
      907                                   hh:width-chars = 3 .
      908                               end.
      909                           when "b-hist-user" then
      910                               do:
      911                                   hh:load-image("cmp/b-hist.bmp":u) .
      912                                   hh:TOOLTIP = "История пользователя" .
      913                                   ii = ii + 1 .
      914                               end.
      915                       end case.
      916                   end.
      917                   hh = hh:next-sibling.
      918               end.
      919               b-help:column = v-frame-width - b-help:width-chars.
      920               jj = 0.
      921               repeat ii = 4 to 1 by -1 :
      922                   if valid-handle (v-h[ii] ) then
      923                   do:
      924                       jj  = jj + 1 .
      925                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      926                       v-h[ii]:row    = v-help-old-y .
      927                   end.
      928               end.
      929           end.
      930       end.
      931   end procedure.
      932   MAIN-BLOCK:
      933   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      934      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      935     define buffer buf_doc-attr for ub.doc-attr.
      936   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      937                           input 'sugtpattr-massa-sug':U ,
      938                          output varvalue ,
      939                          output vartype ) no-error .
      940     f-massa-sug = if varvalue = "" then ? else dec(varvalue).
      941   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      942                           input 'sugtpattr-teh-loss':U ,
      943                          output varvalue ,
      944                          output vartype ) no-error .
      945     f-teh-loss = if varvalue = "" then ? else dec(varvalue).
      946   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      947                           input 'sugtpattr-err-allow':U ,
      948                          output varvalue ,
      949                          output vartype ) no-error .
      950     f-err-allow = if varvalue = "" then ? else dec(varvalue).
      951     f-num-hoses = getNunHoses().
      952     RUN enable_UI.
      953     if p-mode = 'ПРОСМОТР':U then
      954     disable
      955       f-massa-sug
      956       f-teh-loss
      957       f-err-allow
      958       with frame Dialog-Frame
      959     .
      960     WAIT-FOR GO OF FRAME Dialog-Frame.
      961   END.
      962   RUN disable_UI.
      963   PROCEDURE disable_UI :
      964     HIDE FRAME Dialog-Frame.
      965   END PROCEDURE.
      966   PROCEDURE enable_UI :
      967     DISPLAY f-massa-sug f-teh-loss f-err-allow f-num-hoses
      968         WITH FRAME Dialog-Frame.
      969     ENABLE b-save b-quit b-help f-massa-sug f-teh-loss f-err-allow
      970         WITH FRAME Dialog-Frame.
      971     VIEW FRAME Dialog-Frame.
      972   END PROCEDURE.
      973   PROCEDURE proc1 :
      974   END PROCEDURE.
      975   PROCEDURE proc2 :
      976   END PROCEDURE.
      977   PROCEDURE save-attr :
      978     define variable v-attr-value as character no-undo.
      979     define buffer buf_doc-attr for ub.doc-attr.
      980     do transaction:
      981       _LABEL_FOR:
      982       for each tt-upd-attr-fuel no-lock:
      983         v-attr-value = ? .
      984         case tt-upd-attr-fuel.code:
      985           when 'sugtpattr-massa-sug':U then
      986             v-attr-value = string(f-massa-sug).
      987           when 'sugtpattr-teh-loss':U then
      988             v-attr-value = string(f-teh-loss).
      989           when 'sugtpattr-err-allow':U then
      990             v-attr-value = string(f-err-allow).
      991           otherwise
      992             next _LABEL_FOR.
      993         end case.
      994         find first buf_doc-attr
      995           where buf_doc-attr.doc-code  = p-doc-code
      996             and buf_doc-attr.attr-code = tt-upd-attr-fuel.code
      997           no-error .
      998         if v-attr-value <> ?
      999         then do:
     1000           if not available buf_doc-attr
     1001               then do:
     1002                 create buf_doc-attr.
     1003                 assign
     1004                   buf_doc-attr.doc-code   = p-doc-code
     1005                   buf_doc-attr.attr-code = tt-upd-attr-fuel.code.
     1006               end.
     1007   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf_doc-attr.doc-code ,
     1008                          input buf_doc-attr.attr-code ,
     1009                          input v-attr-value ) no-error .
     1010           if error-status :error then do:
     1011               message "Ошибка при сохранении атрибута." view-as alert-box.
     1012               undo, return no-apply.
     1013           end.
     1014         end.
     1015         else do:
     1016           if available buf_doc-attr then delete buf_doc-attr.
     1017         end.
     1018       end.
     1019     end.
     1020   END PROCEDURE.
     1021   FUNCTION getNunHoses RETURNS INTEGER
     1022     (  ) :
     1023     define variable vGateValve as character no-undo.
     1024     define variable vOk        as logical   no-undo.
     1025     define variable vNumHoses  as integer   no-undo init 0.
     1026     define buffer buf_doc-pl        for ub.doc-pl.
     1027     define buffer buf_place         for ub.place.
     1028     define buffer buf_doc-line      for ub.doc-line.
     1029     define buffer buf_goods         for ub.goods.
     1030     define buffer buf_doc-line-attr for ub.doc-line-attr.
     1031     find first buf_doc-pl where
     1032                buf_doc-pl.out-code = p-doc-code
     1033          no-lock no-error.
     1034     if avail buf_doc-pl then
     1035       find first buf_place where
     1036                  buf_place.obj-type = buf_doc-pl.obj-type
     1037              and buf_place.obj-code = buf_doc-pl.obj-code
     1038              and buf_place.pl-code  = buf_doc-pl.pl-code
     1039              no-lock no-error.
     1040     if avail buf_place then do:
     1041         run placelib_get-attr  (
     1042           input "place-gate-valve"
     1043          ,input buf_place.obj-code
     1044          ,input buf_place.obj-type
     1045          ,input buf_place.pl-code
     1046          ,output vGateValve
     1047          ,output vOk
     1048         ) no-error.
     1049        if not vOk or not logical(vGateValve) then
     1050          vNumHoses = 1.
     1051        else do:
     1052          for first buf_doc-line where
     1053                    buf_doc-line.doc-code = p-doc-code
     1054              no-lock,
     1055              first buf_goods where
     1056                    buf_goods.artic     =  buf_doc-line.artic
     1057                and buf_goods.prod-code =  buf_doc-line.prod-code
     1058                and buf_goods.prod-type =  buf_doc-line.prod-type
     1059              no-lock,
     1060              first buf_doc-line-attr where
     1061                    buf_doc-line-attr.doc-code  = p-doc-code
     1062                and buf_doc-line-attr.gds-code  = buf_goods.gds-code
     1063                and buf_doc-line-attr.attr-code = "connect-hoses"
     1064              no-lock:
     1065            vNumHoses = if buf_doc-line-attr.attr-value = "yes" then 1 else 0.
     1066          end.
     1067        end.
     1068     end.
     1069     RETURN vNumHoses.
     1070   END FUNCTION.
