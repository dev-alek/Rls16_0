      154     .
      155   procedure placelib_write-attr:
      156   define input  parameter p-code     like ub.place-attr.attr-code .
      157   define input  parameter p-obj-code like ub.place-attr.obj-code .
      158   define input  parameter p-obj-type like ub.place-attr.obj-type .
      159   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      160   define input  parameter p-value    like ub.place-attr.attr-value .
      161   define output parameter p-ok       as logical.
      162   define buffer buf_place-attr for ub.place-attr .
      163     do on error undo, return error return-value :
      164        p-ok = false.
      165        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      166                                                   and buf_place-attr.obj-code    = p-obj-code
      167                                                   and buf_place-attr.obj-type    = p-obj-type
      168                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      169        if not available buf_place-attr then do :
      170           create buf_place-attr.
      171           assign
      172             buf_place-attr.attr-code   = p-code
      173             buf_place-attr.attr-value  = p-value
      174             buf_place-attr.obj-code    = p-obj-code
      175             buf_place-attr.obj-type    = p-obj-type
      176             buf_place-attr.pl-code     = p-pl-code
      177           .
      178           p-ok = true.
      179        end.
      180        else do:
      181           buf_place-attr.attr-value  = p-value .
      182           p-ok = true.
      183        end.
      184     end.
      185   end.
      186   procedure placelib_get-attr:
      187   define input  parameter  p-code     like ub.place-attr.attr-code .
      188   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      189   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      190   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      191   define output parameter  p-value    like ub.place-attr.attr-value .
      192   define output parameter  p-ok       as logical.
      193   define buffer buf_place-attr for ub.place-attr .
      194     do on error undo, return error return-value :
      195        p-ok = false.
      196        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      197                                                   and buf_place-attr.obj-code    = p-obj-code
      198                                                   and buf_place-attr.obj-type    = p-obj-type
      199                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      200        if available buf_place-attr then do :
      201          p-value = buf_place-attr.attr-value.
      202          p-ok = true.
      203        end.
      204        else do :
      205          p-ok = false.
      206        end.
      207     end.
      208   end.
      209   procedure placelib_del-attr:
      210   define input parameter  p-code     like ub.place-attr.attr-code .
      211   define input parameter  p-obj-code like ub.place-attr.obj-code .
      212   define input parameter  p-obj-type like ub.place-attr.obj-type .
      213   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      214   define input parameter  p-value    like ub.place-attr.attr-value .
      215   define output parameter p-ok       as logical.
      216   define buffer buf_place-attr for ub.place-attr .
      217     do on error undo, return error return-value :
      218        p-ok = false.
      219        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      220                                                   and buf_place-attr.obj-code    = p-obj-code
      221                                                   and buf_place-attr.obj-type    = p-obj-type
      222                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      223        if available buf_place-attr then do :
      224           delete buf_place-attr.
      225           p-ok = true.
      226        end.
      227     end.
      228   end.
      229   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   procedure cur-time :
      231      define output parameter p-today as date      no-undo .
      232      define output parameter p-time  as integer   no-undo .
      233     do
      234     on error undo, return error
      235     :
      236       define variable v-date1 as date      no-undo .
      237       define variable v-date2 as date      no-undo .
      238       define variable v-time  as integer   no-undo .
      239       assign
      240         v-date1 = today
      241         v-time  = time
      242         v-date2 = today
      243       .
      244       if v-date1 <> v-date2
      245       then do:
      246         assign
      247           v-date1 = today
      248           v-time  = v-time
      249         .
      250       end.
      251       assign
      252         p-today = v-date1
      253         p-time  = v-time
      254       .
      255     end.
      256   end.
      257   function cur-time-date returns character
      258   :
      259     return string(today, '99/99/9999':U) .
      260   end.
      261   function cur-time-mjd returns decimal
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return integer(v-date) - 2400002 + (v-time / 86400) .
      270   end.
      271   function cur-time-get-ending-index returns integer
      272   (input p-number as integer
      273   )
      274   :
      275     if p-number < 0
      276     or p-number = ?
      277     then do:
      278       return 1 .
      279     end.
      280     define variable v-rest as integer   no-undo .
      281     assign
      282       p-number = p-number modulo 100
      283     .
      284     if p-number < 20
      285     then do:
      286       assign
      287         v-rest = p-number
      288       .
      289     end.
      290     else do:
      291       assign
      292         v-rest = p-number modulo 10
      293       .
      294     end.
      295     case v-rest :
      296       when 1
      297       then do:
      298         return 2 .
      299       end.
      300       when 2 or
      301       when 3 or
      302       when 4
      303       then do:
      304         return 3 .
      305       end.
      306       otherwise do:
      307         return 1 .
      308       end.
      309     end case .
      310   end.
      311   procedure cur-time-mjd-to-date :
      312      define input  parameter i-mjd-diff as decimal no-undo.
      313      define output parameter o-Date     as date    no-undo.
      314      define output parameter o-Time     as integer no-undo.
      315      define variable v-day-number as integer   no-undo .
      316      if    i-mjd-diff < 0
      317         or i-mjd-diff = ?
      318      then do:
      319         return "?" .
      320      end.
      321      assign
      322         v-day-number = truncate(i-mjd-diff,0).
      323         o-Date = date(v-day-number + 2400002).
      324         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      325     .
      326   end.
      327   function cur-time-mjd-to-string returns character
      328   (input p-mjd-diff as decimal
      329   )
      330   :
      331     define variable v-day-number as integer   no-undo .
      332     define variable v-seconds    as integer   no-undo .
      333     define variable v-hour       as integer   no-undo .
      334     define variable v-min        as integer   no-undo .
      335     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      336     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      337     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      338     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      339     if p-mjd-diff < 0
      340     or p-mjd-diff = ?
      341     then do:
      342       return "?" .
      343     end.
      344     assign
      345       v-day-number = integer(truncate(p-mjd-diff,0))
      346       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      347     .
      348     if v-seconds > 86400
      349     then do:
      350       assign
      351         v-seconds = 86400 - 1
      352       .
      353     end.
      354     if v-seconds < 0
      355     then do:
      356       assign
      357         v-seconds = 0
      358       .
      359     end.
      360     assign
      361       v-hour = truncate(v-seconds / 3600, 0)
      362     .
      363     assign
      364       v-seconds = v-seconds modulo 3600
      365     .
      366     assign
      367       v-min = truncate(v-seconds / 60, 0)
      368     .
      369     assign
      370       v-seconds = v-seconds modulo 60
      371     .
      372     return
      373         (if v-day-number <> 0
      374           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      375           else ""
      376         )
      377       + (if v-day-number <> 0 or v-hour <> 0
      378           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      379           else ""
      380         )
      381       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      382           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      383           else ""
      384         )
      385       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      386       .
      387   end.
      388   function cur-time-string returns character
      389   :
      390     define variable v-date as date      no-undo .
      391     define variable v-time as integer   no-undo .
      392     run cur-time in this-procedure
      393       (output v-date
      394       ,output v-time
      395       ) .
      396     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      397   end.
      398   function cur-time-string-sec returns character
      399   :
      400     define variable v-date as date      no-undo .
      401     define variable v-time as integer   no-undo .
      402     run cur-time in this-procedure
      403       (output v-date
      404       ,output v-time
      405       ) .
      406     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      407   end.
      408   function cur-time-custom  returns character
      409   (input p-prefix as character
      410   ,input p-date-format as character
      411   ,input p-delimiter as character
      412   ,input p-time-format as character
      413   ,input p-suffix as character
      414   )
      415   :
      416     define variable v-date as date      no-undo .
      417     define variable v-time as integer   no-undo .
      418     run cur-time in this-procedure
      419       (output v-date
      420       ,output v-time
      421       ) .
      422     return
      423       p-prefix
      424       + string(v-date, p-date-format)
      425       + p-delimiter
      426       + string(v-time, p-time-format)
      427       + p-suffix
      428       .
      429   end.
      430   function cur-time-print  returns character
      431   :
      432     define variable v-date as date      no-undo .
      433     define variable v-time as integer   no-undo .
      434     run cur-time in this-procedure
      435       (output v-date
      436       ,output v-time
      437       ) .
      438     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      439   end.
      440   function cur-time-datetime returns datetime
      441   :
      442     define variable v-char as character no-undo .
      443     define variable v-datetime as datetime no-undo .
      444     v-char = cur-time-string().
      445     v-datetime = datetime(v-char).
      446     return  v-datetime.
      447   end.
      448   function cur-time-string-msec returns character
      449   :
      450     define variable v-date as datetime  no-undo .
      451     v-date = now.
      452     return string(v-date) .
      453   end.
      454   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      457   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      458   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      459   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      460   define variable ptrlprop-autopump      as logical   no-undo initial false .
      461   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      462   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      463   define variable ptrlprop-olddens       as logical   no-undo initial false .
      464   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      465   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      466   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      467   define variable ptrlprop-algoincome as integer no-undo init 0.
      468   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      469   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      470   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      471   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      472   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      473   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      474   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      475   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      476   define variable ptrlprop-block-nozzle as logical no-undo init false.
      477   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      478   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      479   procedure get-ptrl-prop :
      480     define input  parameter p-obj-type as character no-undo .
      481     define input  parameter p-obj-code as integer   no-undo .
      482     do
      483     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      484     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      485     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      486     :
      487       define variable par-type          as character no-undo.
      488       define variable v-value-character as character no-undo .
      489       define variable v-value-date      as date      no-undo .
      490       define variable v-value-decimal   as decimal   no-undo .
      491       define variable v-value-integer   as integer   no-undo .
      492       define variable v-value-logical   as logical   no-undo .
      493       for each thbjattr_thbj-attr
      494       :
      495         delete thbjattr_thbj-attr .
      496       end.
      497       run adm/shattri.p
      498         ( input "get":U
      499         , input p-obj-type
      500         , input p-obj-code
      501         , input 'petrol':U
      502         , input  ""
      503         , output v-value-character
      504         , output v-value-date
      505         , output v-value-decimal
      506         , output v-value-integer
      507         , output v-value-logical
      508         , output par-type
      509         , input-output table thbjattr_thbj-attr
      510         ) no-error .
      511       for each thbjattr_thbj-attr
      512       on error undo, return error return-value
      513       :
      514         case thbjattr_thbj-attr.prop-code :
      515           when 'denstclc':U then do:
      516             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      517               assign
      518                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      519               .
      520             end.
      521           end.
      522           when 'expptrl':U then do:
      523             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      524               and thbjattr_thbj-attr.prop-value-type = 'character':U
      525             then do:
      526               assign
      527                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      528               .
      529             end.
      530           end.
      531           when 'inpptrl':U then do:
      532             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      533               and thbjattr_thbj-attr.prop-value-type = 'character':U
      534             then do:
      535               assign
      536                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      537               .
      538             end.
      539           end.
      540           when 'autopump':U then do:
      541             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      542               assign
      543                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      544               .
      545             end.
      546           end.
      547           when 'rvsnmter':U then do:
      548             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      549               assign
      550                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      551               .
      552             end.
      553           end.
      554           when 'avtinvpm':U then do:
      555             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      556               assign
      557                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      558               .
      559             end.
      560           end.
      561           when 'invclipt':U then do:
      562             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      563               assign
      564                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      565               .
      566             end.
      567           end.
      568           when 'olddens':U then do:
      569             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      570               assign
      571                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      572               .
      573             end.
      574           end.
      575           when 'algrvspt':U then do:
      576             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      577               assign
      578                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      579               .
      580             end.
      581           end.
      582           when 'temp-for-pomi':U then do:
      583             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      584               assign
      585                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      586               .
      587             end.
      588           end.
      589           when 'algoincome':U then do:
      590             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      591               assign
      592                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      593               .
      594             end.
      595           end.
      596           when 'mand-choice-autocar':U then do:
      597             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      598               assign
      599                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      600               .
      601             end.
      602           end.
      603           when 'block-nozzle':U then do:
      604             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      605               assign
      606                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      607               .
      608             end.
      609           end.
      610           when 'timeout-block-nozzle':U then do:
      611             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      612               assign
      613                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      614               .
      615             end.
      616           end.
      617           when 'Delta-mass-horiz':U then do:
      618             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      619               assign
      620                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      621               .
      622             end.
      623           end.
      624           when 'Delta-mass-vert':U then do:
      625             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      626               assign
      627                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      628               .
      629             end.
      630           end.
      631           when 'calc-free-vol':U then do:
      632             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      633               assign
      634                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      635               .
      636             end.
      637           end.
      638           when 'calc-free-vol-sug':U then do:
      639             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      640               assign
      641                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      642               .
      643             end.
      644           end.
      645           when 'trn-reas-sug':U then do:
      646             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      647               assign
      648                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      649               .
      650             end.
      651           end.
      652                 when 'rvd-own-nb':U then do:
      653             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      654               assign
      655                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      656               .
      657             end.
      658           end.
      659           when 'qr-scan-time':U then do:
      660             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      661               assign
      662                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      663               .
      664             end.
      665           end.
      666           when 'autopump-skip-time':U then do:
      667             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      668               assign
      669                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      670               .
      671             end.
      672           end.
      673         end case.
      674         delete thbjattr_thbj-attr .
      675       end.
      676     end.
      677     return .
      678   end procedure.
      679   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
