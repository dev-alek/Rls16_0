     2049         end.
     2050         assign
     2051           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2052         no-error .
     2053         if error-status :error
     2054         or error-status :get-message(1) <> ""
     2055         then do:
     2056           undo move_block, retry move_block.
     2057         end.
     2058         if frame Dialog-Frame :scrollable = true
     2059         then do:
     2060           assign
     2061             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2062           no-error .
     2063           if error-status :error
     2064           or error-status :get-message(1) <> ""
     2065           then do:
     2066             undo move_block, retry move_block.
     2067           end.
     2068         end.
     2069       end.
     2070       if p-move-resize
     2071       then do:
     2072         run diasize_position-resize-button in this-procedure .
     2073       end.
     2074       if v-diasize-wndstore = true
     2075       then do:
     2076         if connected("ub") = true
     2077         then do:
     2078           define variable v-cntxt-db-num        as integer   no-undo .
     2079           define variable v-cntxt-userid        as character no-undo .
     2080           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2081                                             , OUTPUT v-cntxt-userid
     2082                                             ) .
     2083           run gbl/wndsizew.p
     2084             (input  v-cntxt-db-num
     2085             ,input  v-cntxt-userid
     2086             ,input  v-diasize-proc-name
     2087             ,input  'width':u
     2088             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2089             ) .
     2090         end.
     2091       end.
     2092     end.
     2093     assign
     2094       v-diasize-change-size = false
     2095     .
     2096   end procedure.
     2097   procedure diasize_set-width :
     2098     define input  parameter p-new-width  as decimal   no-undo .
     2099     define input  parameter p-move-resize as logical   no-undo .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       run diasize_change-width in this-procedure
     2104         (input  (p-new-width - frame Dialog-Frame :width)
     2105         ,input  p-move-resize
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_position-resize-button :
     2110     do with frame Dialog-Frame
     2111     :
     2112       hide v-diasize-resize-button .
     2113       assign
     2114         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2115                     - 1
     2116                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2117         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2118                     - 1
     2119                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2120       .
     2121       view v-diasize-resize-button .
     2122     end.
     2123   end procedure.
     2124   on alt-right anywhere
     2125   do:
     2126     run diasize_change-width in this-procedure
     2127       (input 1
     2128       ,input true
     2129       ) .
     2130     return no-apply .
     2131   end.
     2132   on alt-left anywhere
     2133   do:
     2134     run diasize_change-width in this-procedure
     2135       (input -1
     2136       ,input true
     2137       ) .
     2138     return no-apply .
     2139   end.
     2140   on alt-down anywhere
     2141   do:
     2142     run diasize_change-height in this-procedure
     2143       (input 1
     2144       ,input true
     2145       ) .
     2146     return no-apply .
     2147   end.
     2148   on alt-up anywhere
     2149   do:
     2150     run diasize_change-height in this-procedure
     2151       (input -1
     2152       ,input true
     2153       ) .
     2154     return no-apply .
     2155   end.
     2156   on alt-enter of frame Dialog-Frame
     2157   do:
     2158     run diasize_maximize in this-procedure
     2159       (input  ?
     2160       ).
     2161     return no-apply .
     2162   end.
     2163   procedure diasize_end-move :
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       define variable v-row-delta as decimal   no-undo .
     2168       define variable v-col-delta as decimal   no-undo .
     2169       define variable v-new-row as decimal   no-undo .
     2170       define variable v-new-col as decimal   no-undo .
     2171       assign
     2172         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2173         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2174       .
     2175       assign
     2176         v-row-delta = v-new-row - frame Dialog-Frame :height
     2177         v-col-delta = v-new-col - frame Dialog-Frame :width
     2178       .
     2179       run diasize_change-height in this-procedure
     2180         (input v-row-delta
     2181         ,input true
     2182         ) .
     2183       run diasize_change-width in this-procedure
     2184         (input v-col-delta
     2185         ,input true
     2186         ) .
     2187     end.
     2188   end procedure.
     2189   procedure diasize_maximize :
     2190     define input  parameter p-action as logical   no-undo .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       if p-action = ?
     2195       then do:
     2196         if v-diasize-need-maximize = true
     2197         then do:
     2198           assign
     2199             p-action = true
     2200           .
     2201         end.
     2202         else do:
     2203           assign
     2204             p-action = false
     2205           .
     2206         end.
     2207       end.
     2208       if p-action = true
     2209       then do:
     2210         run diasize_change-height in this-procedure
     2211           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2212               - frame Dialog-Frame :height-chars
     2213           ,input true
     2214           ) .
     2215         run diasize_change-width in this-procedure
     2216           (input session :width-chars
     2217               - frame Dialog-Frame :width-chars
     2218           ,input true
     2219           ) .
     2220         assign
     2221           v-diasize-need-maximize = false
     2222         .
     2223       end.
     2224       else do:
     2225         run diasize_change-width in this-procedure
     2226           (input v-diasize-orig-frame-width
     2227               - frame Dialog-Frame :width-chars
     2228           ,input true
     2229           ) .
     2230         run diasize_change-height in this-procedure
     2231           (input v-diasize-orig-frame-height
     2232               - frame Dialog-Frame :height-chars
     2233           ,input true
     2234           ) .
     2235         assign
     2236           v-diasize-need-maximize = true
     2237         .
     2238       end.
     2239     end.
     2240   end procedure.
     2241   procedure diasize_restore-orig-size :
     2242     do
     2243     on error undo, return error return-value
     2244     :
     2245       assign
     2246         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2247         v-diasize-current-frame-height = frame Dialog-Frame :height
     2248       .
     2249       run diasize_set-height in this-procedure
     2250         (input  v-diasize-orig-frame-height
     2251         ,input  true
     2252         ) .
     2253       run diasize_set-width in this-procedure
     2254         (input  v-diasize-orig-frame-width
     2255         ,input  true
     2256         ) .
     2257     end.
     2258   end procedure.
     2259   procedure diasize_restore-current-size :
     2260     do
     2261     on error undo, return error return-value
     2262     :
     2263       run diasize_set-height in this-procedure
     2264         (input  v-diasize-current-frame-height
     2265         ,input  true
     2266         ) .
     2267       run diasize_set-width in this-procedure
     2268         (input  v-diasize-current-frame-width
     2269         ,input  true
     2270         ) .
     2271     end.
     2272   end procedure.
     2273   procedure diasize_set-browse-handle :
     2274     define input  parameter p-browse-handle as handle   no-undo .
     2275     define buffer buf_temp-browse-handle for temp-browse-handle .
     2276     do
     2277     on error undo, return error return-value
     2278     :
     2279       assign
     2280         v-diasize-browse-handle = p-browse-handle
     2281       .
     2282       for each buf_temp-browse-handle
     2283       on error undo, return error return-value
     2284       :
     2285         delete buf_temp-browse-handle .
     2286       end.
     2287     end.
     2288   end procedure.
     2289   procedure diasize_add_browse :
     2290     define input  parameter p-browse-type   as character no-undo .
     2291     define input  parameter p-browse-handle as handle    no-undo .
     2292     define buffer buf_temp-browse-handle for temp-browse-handle .
     2293     do
     2294     on error undo, return error return-value
     2295     :
     2296       assign
     2297         v-diasize-browse-number = v-diasize-browse-number + 1
     2298       .
     2299       create buf_temp-browse-handle .
     2300       assign
     2301         buf_temp-browse-handle.browse-type   = p-browse-type
     2302         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2303         buf_temp-browse-handle.browse-handle = p-browse-handle
     2304       .
     2305     end.
     2306   end procedure.
     2307   procedure diasize_init :
     2308     define variable v-default-value    as logical   no-undo .
     2309     define variable v-restore-saved    as logical   no-undo .
     2310     define variable v-resize-value-str as character no-undo .
     2311     do
     2312     on error undo, return error return-value
     2313     :
     2314       do with frame Dialog-Frame
     2315       :
     2316         assign
     2317           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2318           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2319           v-diasize-browse-handle     = browse BR-Slave :handle
     2320         .
     2321         create button v-diasize-resize-button
     2322         assign
     2323           parent        = frame Dialog-Frame :first-child
     2324           label         = "s"
     2325           height-pixels = 16
     2326           width-pixels  = 16
     2327           visible       = true
     2328           sensitive     = true
     2329           movable       = true
     2330           triggers:
     2331             on end-move persistent run diasize_end-move in this-procedure .
     2332           end triggers.
     2333         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2334         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2335         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2336         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2337         assign
     2338           v-diasize-wndmax = false
     2339         .
     2340         if connected("ub") = true
     2341         then do:
     2342           define variable v-cntxt-db-num        as integer   no-undo .
     2343           define variable v-cntxt-userid        as character no-undo .
     2344           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2345                                             , OUTPUT v-cntxt-userid
     2346                                             ) .
     2347           run gbl/wndpar_r.p
     2348             (input  v-cntxt-db-num
     2349             ,input  v-cntxt-userid
     2350             ,input  'wndmax':U
     2351             ,output v-diasize-wndmax
     2352             ,output v-default-value
     2353             ) .
     2354         end.
     2355         assign
     2356           v-diasize-wndstore = false
     2357         .
     2358         if connected("ub") = true
     2359         then do:
     2360           run gbl/wndpar_r.p
     2361             (input  v-cntxt-db-num
     2362             ,input  v-cntxt-userid
     2363             ,input  'wndstore':U
     2364             ,output v-diasize-wndstore
     2365             ,output v-default-value
     2366             ) .
     2367         end.
     2368         assign
     2369           v-diasize-proc-name = entry(1, program-name(2), '.')
     2370         .
     2371         if v-diasize-wndstore = true
     2372         then do:
     2373           assign
     2374             v-restore-saved = false
     2375           .
     2376           if connected("ub") = true
     2377           then do:
     2378             run gbl/wndsizer.p
     2379               (input  v-cntxt-db-num
     2380               ,input  v-cntxt-userid
     2381               ,input  v-diasize-proc-name
     2382               ,input  'height':u
     2383               ,output v-resize-value-str
     2384               ) .
     2385             if v-resize-value-str <> '':U
     2386             then do:
     2387               run diasize_change-height in this-procedure
     2388                 (input  integer(v-resize-value-str)
     2389                 ,input  true
     2390                 ) .
     2391               assign
     2392                 v-restore-saved = true
     2393               .
     2394             end.
     2395           end.
     2396           if connected("ub") = true
     2397           then do:
     2398             run gbl/wndsizer.p
     2399               (input  v-cntxt-db-num
     2400               ,input  v-cntxt-userid
     2401               ,input  v-diasize-proc-name
     2402               ,input  'width':u
     2403               ,output v-resize-value-str
     2404               ) .
     2405             if v-resize-value-str <> '':U
     2406             then do:
     2407               run diasize_change-width in this-procedure
     2408                 (input  integer(v-resize-value-str)
     2409                 ,input  true
     2410                 ) .
     2411               assign
     2412                 v-restore-saved = true
     2413               .
     2414             end.
     2415           end.
     2416           if v-restore-saved <> true
     2417           then do:
     2418             if v-diasize-wndmax = true
     2419             then do:
     2420               run diasize_maximize in this-procedure
     2421                 (input  true
     2422                 ) .
     2423             end.
     2424           end.
     2425         end.
     2426         else do:
     2427           if v-diasize-wndmax = true
     2428           then do:
     2429             run diasize_maximize in this-procedure
     2430               (input  true
     2431               ) .
     2432           end.
     2433         end.
     2434       end.
     2435     end.
     2436   end procedure.
     2437   procedure diasize_need-full-display :
     2438     define output parameter p-need-full-display as logical   no-undo .
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       assign
     2443         p-need-full-display = v-diasize-need-full-display
     2444       .
     2445       assign
     2446         v-diasize-need-full-display = false
     2447       .
     2448     end.
     2449   end procedure.
     2450   procedure get-context :
     2451      define output parameter p-db-num as integer          no-undo.
     2452      define output parameter p-user-id as character        no-undo.
     2453      define variable v-login               as character    no-undo.
     2454      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2455      define buffer buf_user-login  for ub.user-login .
     2456      do
     2457      on error undo, return error
     2458      :
     2459            FIND FIRST buf_sys-ctrl no-lock.
     2460            ASSIGN
     2461               v-login = USERID("ub")
     2462               p-db-num = buf_sys-ctrl.db-num
     2463            .
     2464            FIND FIRST buf_user-login
     2465                 WHERE buf_user-login.db-num = p-db-num
     2466                   AND buf_user-login.user-login = v-login
     2467                 no-lock
     2468                 no-error
     2469                 .
     2470            IF AVAILABLE buf_user-login
     2471            THEN DO:
     2472               assign
     2473                  p-user-id = buf_user-login.user-id
     2474               .
     2475            END.
     2476      end.
     2477   end procedure.
     2478       run diasize_init in this-procedure .
     2479   ASSIGN
     2480      FRAME Dialog-Frame:TITLE =
     2481            "Подчиненные договоры для договора: " + buf_M-Contract.contract-prn-code + " " +
     2482            "Фирма: " + buf_M-Contract.own-name.
     2483   MAIN-BLOCK:
     2484   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2485      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2486     RUN enable_UI.
     2487     WAIT-FOR GO OF FRAME Dialog-Frame.
     2488   END.
     2489   RUN disable_UI.
     2490   PROCEDURE BR-Slave-Reposition :
     2491   DEFINE INPUT PARAMETER iNumFirm AS INTEGER NO-UNDO.
     2492   DEFINE INPUT PARAMETER cBegNumContract AS CHARACTER NO-UNDO.
     2493   DEFINE INPUT PARAMETER lFirst AS LOGICAL NO-UNDO.
     2494   DEFINE OUTPUT PARAMETER iRecId AS RECID NO-UNDO INITIAL ?.
     2495   DEFINE VARIABLE lFound AS LOGICAL NO-UNDO INITIAL FALSE.
     2496   IF iNumFirm = 0 AND cBegNumContract = "" THEN DO:
     2497      MESSAGE
     2498          "Введите номер фирмы или начало номера договора ! "
     2499          VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2500      RETURN.
     2501   END.
     2502   IF lFirst  THEN DO:
     2503      REPEAT:
     2504         GET PREV Br-Slave.
     2505         IF QUERY-OFF-END("BR-slave")
     2506            THEN LEAVE.
     2507      END.
     2508   END.
     2509   GET NEXT Br-Slave.
     2510   Label-repeat:
     2511   REPEAT:
     2512      IF QUERY-OFF-END("BR-slave") THEN DO:
     2513         LEAVE LABEL-repeat.
     2514      END.
     2515      IF iNumFirm <> 0  THEN DO:
     2516         IF iNumFirm = buf_S-Contract.Host-code  THEN DO:
     2517            ASSIGN
     2518               lFound = TRUE.
     2519            LEAVE Label-repeat.
     2520         END.
     2521      END. ELSE DO:
     2522         IF buf_S-Contract.Contract-prn-code BEGINS cBegNumContract THEN DO:
     2523            ASSIGN
     2524               lFound = TRUE.
     2525            LEAVE Label-repeat.
     2526         END.
     2527      END.
     2528      GET NEXT Br-slave.
     2529   END.
     2530   IF lFound THEN  DO:
     2531      REPOSITION Br-Slave
     2532         TO ROWID
     2533         ROWID(buf_Ext-Classif),
     2534         ROWID(buf_S-Contract)
     2535         NO-ERROR.
     2536      IF ERROR-STATUS:ERROR THEN DO:
     2537         MESSAGE PROGRAM-NAME(1) SKIP
     2538            ERROR-STATUS:GET-MESSAGE(1) SKIP
     2539            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2540      END.
     2541   END.
     2542   RETURN.
     2543   END PROCEDURE.
     2544   PROCEDURE disable_UI :
     2545     HIDE FRAME Dialog-Frame.
     2546   END PROCEDURE.
     2547   PROCEDURE enable_UI :
     2548     DISPLAY iSchNumFirm cSchBegNumCont
     2549         WITH FRAME Dialog-Frame.
     2550     ENABLE b-Quit b-Add b-Lkp b-Del b-Copy B-print b-hist B-Help BR-Slave iSchNumFirm
     2551            cSchBegNumCont
     2552         WITH FRAME Dialog-Frame.
     2553     VIEW FRAME Dialog-Frame.
     2554     RUN Open-Query-Br-Slave IN THIS-PROCEDURE.   .
     2555   END PROCEDURE.
     2556   PROCEDURE Open-Query-Br-Slave :
     2557   OPEN QUERY Br-Slave
     2558        FOR EACH buf_Ext-Classif WHERE
     2559                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2560            AND  buf_Ext-Classif.CharKey_One  = STRING(buf_M-Contract.Host-code) + v-DELIM_CHR_3 +
     2561                                                STRING(buf_M-Contract.contract-code)
     2562            AND  buf_Ext-classif.db-num       = buf_M-Contract.Db-num
     2563        NO-LOCK,
     2564        EACH buf_S-contract WHERE
     2565                 buf_S-Contract.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2566            AND  buf_S-Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2567        NO-LOCK
     2568        INDEXED-REPOSITION.
     2569   END PROCEDURE.
