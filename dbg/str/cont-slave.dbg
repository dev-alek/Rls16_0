     1529             find first buf_temp-browse-handle
     1530               where buf_temp-browse-handle.browse-type   = 'height':u
     1531                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1532               no-error .
     1533             if available buf_temp-browse-handle
     1534             then do:
     1535             end.
