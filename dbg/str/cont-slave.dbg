     1490       then do:
     1491         assign
     1492           v-diasize-change-size = true
     1493         .
     1494       end.
     1495       else do:
     1496         return .
     1497       end.
     1498       assign
     1499         v-frame-height = frame Dialog-Frame :height
     1500         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1501         v-browse-height = v-diasize-browse-handle :height
     1502       .
