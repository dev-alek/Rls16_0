     1195   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1196   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1197   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1199     (output v-db-num
     1200     )  .
     1201   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   on help of frame Dialog-Frame
     1203   do:
     1204     run gbl/app_help.p
     1205       (input this-procedure :file-name
     1206       ,input ''
     1207       ,input ?
     1208       ) no-error.
     1209     if error-status :error then do:
     1210       message
     1211         "Ошибка при вызове помощи"
     1212         error-status :get-message(1)
     1213         view-as alert-box .
     1214     end.
     1215   end.
     1216   run minbtn-set in this-procedure .
     1217   on choose of b-help in frame Dialog-Frame
     1218   do:
     1219     apply "help":u to frame Dialog-Frame .
     1220   end.
     1221   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1222   procedure minbtn-set :
     1223       do
     1224           on error undo, return error return-value
     1225           :
     1226           define variable ii              as integer       no-undo .
     1227           define variable fh              as widget-handle no-undo .
     1228           define variable hh              as widget-handle no-undo .
     1229           define variable v-h             as handle        extent 4 no-undo .
     1230           define variable v-name-button   as character     no-undo .
     1231           define variable v-help-old-x    as decimal       no-undo .
     1232           define variable v-help-old-y    as decimal       no-undo .
     1233           define variable v-help-old-size as decimal       no-undo .
     1234           define variable v-frame-width   as decimal       no-undo .
     1235           define variable jj              as integer       no-undo .
     1236           do
     1237               on error undo, return error
     1238               :
     1239               assign
     1240                   v-frame-width = frame Dialog-Frame:width - 0.3
     1241                   fh            = frame Dialog-Frame:first-child
     1242                   hh            = fh:first-child
     1243                   ii            = 1
     1244                   .
     1245               do while valid-handle(hh):
     1246                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1247                   do:
     1248                       case lc(hh:name) :
     1249                           when "b-help" then
     1250                               do:
     1251                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1252                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1253                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1254                                   hh:TOOLTIP = "Помощь" .
     1255                                   v-help-old-x = hh:column .
     1256                                   v-help-old-y = hh:row    .
     1257                                   v-help-old-size = hh:width .
     1258                                   hh:width-chars = 2.5 .
     1259                               end.
     1260                           when "b-print" then
     1261                               do:
     1262                                   hh:load-image("cmp/b-print.bmp":u) .
     1263                                   hh:TOOLTIP = "Печать" .
     1264                                   v-h[ii] = hh:handle .
     1265                                   ii = ii + 1 .
     1266                                   hh:width-chars = 3 .
     1267                               end.
     1268                           when "b-history" or
     1269                           when "b-hist" then
     1270                               do:
     1271                                   hh:load-image("cmp/b-hist.bmp":u) .
     1272                                   hh:TOOLTIP = "История" .
     1273                                   v-h[ii] = hh:handle .
     1274                                   ii = ii + 1 .
     1275                                   hh:width-chars = 3 .
     1276                               end.
     1277                           when "b-sch" then
     1278                               do:
     1279                                   hh:load-image("cmp/b-sch.bmp":u) .
     1280                                   hh:TOOLTIP = "Установка Фильтра" .
     1281                                   v-h[ii] = hh:handle .
     1282                                   ii = ii + 1 .
     1283                                   hh:width-chars = 3 .
     1284                               end.
     1285                           when "b-hist-user" then
     1286                               do:
     1287                                   hh:load-image("cmp/b-hist.bmp":u) .
     1288                                   hh:TOOLTIP = "История пользователя" .
     1289                                   ii = ii + 1 .
     1290                               end.
     1291                       end case.
     1292                   end.
     1293                   hh = hh:next-sibling.
     1294               end.
     1295               b-help:column = v-frame-width - b-help:width-chars.
     1296               jj = 0.
     1297               repeat ii = 4 to 1 by -1 :
     1298                   if valid-handle (v-h[ii] ) then
     1299                   do:
     1300                       jj  = jj + 1 .
     1301                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1302                       v-h[ii]:row    = v-help-old-y .
     1303                   end.
     1304               end.
     1305           end.
     1306       end.
     1307   end procedure.
     1308   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1309   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1310   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1311   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1312   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1313   define variable v-diasize-current-frame-height as decimal   no-undo .
     1314   define variable v-diasize-change-size          as logical   no-undo .
     1315   define variable v-diasize-resize-button        as handle    no-undo .
     1316   define variable v-diasize-wndmax               as logical   no-undo .
     1317   define variable v-diasize-wndstore             as logical   no-undo .
     1318   define variable v-diasize-proc-name            as character no-undo .
     1319   define variable v-diasize-browse-handle        as handle    no-undo .
     1320   define variable v-diasize-browse-number        as integer   no-undo .
     1321   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1322   define temp-table temp-diasize-handle no-undo
     1323     field handle-value  as handle
     1324     field save-position as decimal
     1325     index xpk is primary unique handle-value
     1326     .
     1327   define temp-table temp-browse-handle no-undo
     1328     field browse-type   as character
     1329     field browse-number as integer
     1330     field browse-handle as handle
     1331     field original-size as decimal
     1332     index xpk is primary unique browse-type browse-number
     1333     index xie browse-type browse-handle
     1334   .
     1335   procedure diasize_change-height :
     1336     define input  parameter p-change-value  as decimal   no-undo .
     1337     define input  parameter p-move-resize   as logical   no-undo .
     1338     define variable v-field-group-handle    as handle    no-undo .
     1339     define variable v-object-handle         as handle    no-undo .
     1340     define variable v-frame-height          as decimal   no-undo .
     1341     define variable v-frame-virtual-height  as decimal   no-undo .
     1342     define variable v-browse-height         as decimal   no-undo .
     1343     define variable v-window-height         as decimal   no-undo .
     1344     define variable v-window-virtual-height as decimal   no-undo .
     1345     define variable v-change-sign           as integer   no-undo .
     1346     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1347     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1348     if p-change-value > 0
     1349     then do:
     1350       if frame Dialog-Frame :height + p-change-value
     1351           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1352       then do:
     1353         assign
     1354           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1355                           - (frame Dialog-Frame :height-chars)
     1356         .
     1357         if p-change-value <= 0
     1358         then do:
     1359           run diasize_position-resize-button in this-procedure .
     1360           return .
     1361         end.
     1362       end.
     1363     end.
     1364     if p-change-value < 0
     1365     then do:
     1366       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1367       then do:
     1368         assign
     1369           p-change-value = v-diasize-orig-frame-height
     1370                          - (frame Dialog-Frame :height-chars)
     1371         .
     1372         if p-change-value >= 0
     1373         then do:
     1374           run diasize_position-resize-button in this-procedure .
     1375           return .
     1376         end.
     1377       end.
     1378     end.
     1379     if p-change-value >= 0
     1380     then do:
     1381       assign
     1382         v-change-sign = 1
     1383       .
     1384     end.
     1385     else do:
     1386       assign
     1387         v-change-sign = -1
     1388       .
     1389     end.
     1390     assign
     1391       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1392     .
     1393     if p-change-value = 0
     1394     then do:
     1395       run diasize_position-resize-button in this-procedure .
     1396       return .
     1397     end.
     1398     move_block:
     1399     do
     1400     on error undo move_block, retry move_block
     1401     :
     1402       if retry
     1403       then do:
     1404         do
     1405         on error undo move_block, leave move_block
     1406         :
     1407           if p-change-value > 0
     1408           then do:
     1409             for each buf_temp-diasize-handle
     1410             on error undo, next
     1411             :
     1412               assign
     1413                 v-object-handle = buf_temp-diasize-handle.handle-value
     1414               .
     1415               if v-object-handle <> v-diasize-resize-button
     1416               then do:
     1417                 assign
     1418                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1419                 .
     1420               end.
     1421             end.
     1422             assign
     1423               v-diasize-browse-handle :height = v-browse-height
     1424             .
     1425             for each buf_temp-browse-handle
     1426               where buf_temp-browse-handle.browse-type = 'height':u
     1427             on error undo, next
     1428             :
     1429               assign
     1430                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1431               .
