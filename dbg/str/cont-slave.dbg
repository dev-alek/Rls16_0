      276   define new global shared variable g#library  as handle no-undo .
      277   define new global shared variable g#library2 as handle no-undo .
      278   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      279     define variable v-cntxt-db-num        as integer   no-undo .
      280     define variable v-cntxt-userid        as character no-undo .
      281     define variable v-cntxt-level         as character no-undo .
      282     define variable v-cntxt-host-code-obj as integer   no-undo .
      283     define variable v-cntxt-obj-type      as character no-undo .
      284     define variable v-cntxt-obj-code      as integer   no-undo .
      285     define variable v-cntxt-db-num-obj    as integer   no-undo .
      286     define variable v-cntxt-is-admin      as logical   no-undo .
      287   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288     run mainmenu_getcntxt in parparentproc
      289       (output v-cntxt-db-num
      290       ,output v-cntxt-userid
      291       ,output v-cntxt-level
      292       ,output v-cntxt-host-code-obj
      293       ,output v-cntxt-obj-type
      294       ,output v-cntxt-obj-code
      295       ,output v-cntxt-db-num-obj
      296       ,output v-cntxt-is-admin
      297       ) .
      298   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      301   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      302   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      303   ASSIGN
      304      v-S_CONTRACT                = "Contract":U
      305      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      306      v-DELIM_CHR_3               = ","
      307      .
      308   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      309   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      310   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      311   FUNCTION Can-Find-Spec RETURN LOGICAL (
      312      INPUT iHost-Code    AS INTEGER,
      313      INPUT iContract-Num AS INTEGER,
      314      INPUT iGds-Code     AS INTEGER ):
      315      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      316      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      317      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      318      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      319      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      320      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      321          INPUT  iHost-Code,
      322          INPUT  iContract-Num,
      323          OUTPUT iTmp-Extent3
      324          ).
      325      IF iTmp-Extent3[1] = 2 THEN DO:
      326         ASSIGN
      327            iTmp-Host-Code      = iTmp-Extent3[2]
      328            iTmp-Contract-Num   = iTmp-Extent3[3]
      329            .
      330      END. ELSE DO:
      331         ASSIGN
      332            iTmp-Host-Code      = iHost-Code
      333            iTmp-Contract-Num   = iContract-Num
      334            .
      335      END.
      336      IF iGds-Code = ? THEN DO:
      337         ASSIGN
      338            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      339                                  buf_Spec.Host-Code     = iTmp-Host-Code
      340                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      341                           ).
      342      END. ELSE DO:
      343            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      344                                  buf_Spec.Host-Code     = iTmp-Host-Code
      345                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      346                              AND buf_Spec.Gds-Code      = iGds-Code
      347                            ).
      348      END.
      349      RETURN (lRet).
      350   END FUNCTION.
      351   PROCEDURE MS-Contract-EXTENT-3:
      352      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      353      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      354      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      355      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      356      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      357      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      358      FIND FIRST buf_Cont-2 WHERE
      359                 buf_Cont-2.Host-Code      = i-Host-Code
      360             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      361           NO-LOCK NO-ERROR.
      362      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      363         RETURN.
      364      END.
      365      FOR FIRST buf_Ext-Classif WHERE
      366                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      367           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      368                                               STRING(i-Contract-code)
      369           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      370          NO-LOCK,
      371          EACH buf_Cont WHERE
      372               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      373           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      374          NO-LOCK:
      375          ASSIGN
      376             i-Ret[1] = 1
      377             i-Ret[2] = buf_Cont.Host-code
      378             i-Ret[3] = buf_Cont.Contract-code
      379             .
      380          LEAVE.
      381      END.
      382      IF i-Ret[1] <> 1 THEN DO:
      383         FOR FIRST buf_Ext-Classif WHERE
      384                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      385              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      386                                                  STRING(i-Contract-code)
      387              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      388             NO-LOCK,
      389             EACH buf_Cont WHERE
      390                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      391              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      392             NO-LOCK:
      393             ASSIGN
      394                i-Ret[1] = 2
      395                i-Ret[2] = buf_Cont.Host-code
      396                i-Ret[3] = buf_Cont.Contract-code
      397                .
      398             LEAVE.
      399         END.
      400      END.
      401      RETURN.
      402   END PROCEDURE.
      403   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
      405   FUNCTION Get-Contract-Attr RETURN CHARACTER(
      406            INPUT iHost-Code AS INTEGER,
      407            INPUT iContract-Code  AS INTEGER,
      408            INPUT cAttr-code      AS CHARACTER):
      409      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
      410      FIND FIRST buf_Contract-Attr WHERE
      411                 buf_Contract-Attr.Host-code     = iHost-Code
      412             AND buf_Contract-Attr.Contract-code = iContract-Code
      413             AND buf_Contract-Attr.Attr-code     = cAttr-code
      414           NO-LOCK NO-ERROR.
      415      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
      416   END FUNCTION.
      417   PROCEDURE Modify-Contract-Attr:
      418      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
      419      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
      420      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
      421      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
      422      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
      423      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
      424      Tran:
      425      DO TRANSACTION
      426         ON ENDKEY UNDO Tran, RETRY Tran
      427         ON ERROR  UNDO Tran, RETRY Tran
      428         ON QUIT   UNDO Tran, RETRY Tran
      429         ON STOP   UNDO Tran, RETRY Tran:
      430         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      431         FIND FIRST buf_Contract-Attr WHERE
      432                    buf_Contract-Attr.Host-Code      = iHost-Code
      433                AND buf_Contract-Attr.Contract-Code  = iContract-Code
      434                AND buf_Contract-Attr.Attr-code      = cAttr-code
      435              NO-LOCK NO-ERROR.
      436         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
      437            CREATE buf_Contract-Attr NO-ERROR.
      438            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      439         END. ELSE DO:
      440            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
      441            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      442         END.
      443         ASSIGN
      444            buf_Contract-Attr.Host-Code      = iHost-Code
      445            buf_Contract-Attr.Contract-Code  = iContract-Code
      446            buf_Contract-Attr.Attr-code      = cAttr-code
      447            buf_Contract-Attr.Attr-value     = cAttr-value
      448            NO-ERROR.
      449         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      450         RELEASE buf_Contract-Attr NO-ERROR.
      451         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      452      END.
      453      RETURN.
      454   END PROCEDURE.
      455   PROCEDURE Create-Contract-Attr:
      456      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
      457      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
      458      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
      459      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
      460      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
      461      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
      462      Tran:
      463      DO TRANSACTION
      464         ON ENDKEY UNDO Tran, RETRY Tran
      465         ON ERROR  UNDO Tran, RETRY Tran
      466         ON QUIT   UNDO Tran, RETRY Tran
      467         ON STOP   UNDO Tran, RETRY Tran:
      468         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      469         CREATE buf_Contract-Attr NO-ERROR.
      470         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      471         ASSIGN
      472            buf_Contract-Attr.Host-Code      = iHost-Code
      473            buf_Contract-Attr.Contract-Code  = iContract-Code
      474            buf_Contract-Attr.Attr-code      = cAttr-code
      475            buf_Contract-Attr.Attr-value     = cAttr-value
      476            NO-ERROR.
      477         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      478         RELEASE buf_Contract-Attr NO-ERROR.
      479         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      480      END.
      481      RETURN.
      482   END PROCEDURE.
      483   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
      484   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
      485   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
      486   PROCEDURE Delete-Contract-Specif:
      487      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
      488      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      489      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
      490      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
      491      Tran:
      492      DO TRANSACTION
      493         ON ENDKEY UNDO Tran, RETRY Tran
      494         ON ERROR  UNDO Tran, RETRY Tran
      495         ON QUIT   UNDO Tran, RETRY Tran
      496         ON STOP   UNDO Tran, RETRY Tran:
      497         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      498         FOR EACH buf_Specif-Attr WHERE
      499                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
      500              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
      501             EXCLUSIVE-LOCK:
      502             DELETE buf_Specif-Attr NO-ERROR.
      503             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      504         END.
      505         FOR EACH buf_Specif WHERE
      506                  buf_Specif.Host-code     = buf_Contract.Host-code
      507              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
      508             EXCLUSIVE-LOCK:
      509             DELETE buf_Specif NO-ERROR.
      510            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      511         END.
      512      END.
      513      RETURN.
      514   END PROCEDURE.
      515   PROCEDURE Modify-Slave-Contract:
      516      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
      517      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      518      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      519      DEFINE BUFFER buf_Slave FOR ub.Contract.
      520      Tran:
      521      DO TRANSACTION
      522         ON ENDKEY UNDO Tran, RETRY Tran
      523         ON ERROR  UNDO Tran, RETRY Tran
      524         ON QUIT   UNDO Tran, RETRY Tran
      525         ON STOP   UNDO Tran, RETRY Tran:
      526         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      527         FOR EACH buf_Ext-Classif WHERE
      528                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
      529              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      530              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
      531             NO-LOCK,
      532             FIRST buf_Slave WHERE
      533                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      534               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      535             EXCLUSIVE-LOCK:
      536             BUFFER-COPY
      537               buf_Master
      538             EXCEPT
      539               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
      540             TO buf_Slave
      541             NO-ERROR.
      542             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      543             RELEASE buf_Slave NO-ERROR.
      544             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      545         END.
      546      END.
      547      RETURN.
      548   END PROCEDURE.
      549   PROCEDURE Change-Stat-Slave-Contract:
      550      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
      551      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
      552      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      553      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      554      DEFINE BUFFER buf_Slave FOR ub.Contract.
      555      Tran:
      556      DO TRANSACTION
      557         ON ENDKEY UNDO Tran, RETRY Tran
      558         ON ERROR  UNDO Tran, RETRY Tran
      559         ON QUIT   UNDO Tran, RETRY Tran
      560         ON STOP   UNDO Tran, RETRY Tran:
      561         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      562         FOR EACH buf_Ext-Classif WHERE
      563                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
      564              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      565              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
      566             NO-LOCK,
      567             FIRST buf_Slave WHERE
      568                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      569               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      570             EXCLUSIVE-LOCK:
      571             ASSIGN
      572                buf_Slave.Status_ = cStatus
      573                NO-ERROR.
      574             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      575             RELEASE buf_Slave NO-ERROR.
      576             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      577         END.
      578      END.
      579      RETURN.
      580   END PROCEDURE.
      581   PROCEDURE Delete-Ref-Master-Slave:
      582      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
      583      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
      584      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      585      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      586      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
      587         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
      588         RETURN.
      589      END.
      590      Tran:
      591      FOR FIRST buf_Ext-Classif WHERE
      592                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      593            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      594            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
      595            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
      596          EXCLUSIVE-LOCK
      597          TRANSACTION
      598          ON ENDKEY UNDO Tran, RETRY Tran
      599          ON ERROR  UNDO Tran, RETRY Tran
      600          ON QUIT   UNDO Tran, RETRY Tran
      601          ON STOP   UNDO Tran, RETRY Tran:
      602          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      603          DELETE buf_Ext-Classif NO-ERROR.
      604          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      605      END.
      606      RETURN.
      607   END PROCEDURE.
      608   PROCEDURE Create-Ref-Master-Slave:
      609      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
      610      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
      611      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
      612      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      613      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
      614      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
      615         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
      616         RETURN.
      617      END.
      618      RUN gen-key-rec IN THIS-PROCEDURE(
      619          INPUT  v-S_CONTRACT,
      620          INPUT  BUFFER buf_Master:HANDLE,
      621          OUTPUT cKeyRec
      622          ) NO-ERROR.
      623      IF ERROR-STATUS:ERROR THEN DO:
      624         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
      625         RETURN.
      626      END.
      627      Tran:
      628      DO TRANSACTION
      629         ON ENDKEY UNDO Tran, RETRY Tran
      630         ON ERROR  UNDO Tran, RETRY Tran
      631         ON QUIT   UNDO Tran, RETRY Tran
      632         ON STOP   UNDO Tran, RETRY Tran:
      633         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      634         CREATE buf_Ext-Classif NO-ERROR.
      635         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      636         ASSIGN
      637            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
      638            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
      639            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      640            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
      641            buf_Ext-Classif.DB-num          = buf_Master.Db-num
      642            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
      643            NO-ERROR.
      644         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      645         RELEASE buf_Ext-Classif NO-ERROR.
      646         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      647      END.
      648      RETURN.
      649   END PROCEDURE.
      650   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
      651                                 i-Host-Code AS INTEGER,
      652                                 i-Contract-Code AS INTEGER):
      653      DEFINE BUFFER buf_Contract FOR ub.Contract.
      654      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
      655      FIND FIRST buf_Contract WHERE
      656                 buf_Contract.Host-Code      = i-Host-Code
      657             AND buf_Contract.Contract-code  = i-Contract-Code
      658           NO-LOCK NO-ERROR.
      659      IF AVAILABLE buf_Contract THEN DO:
      660         ASSIGN
      661            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
      662      END.
      663      RETURN (iRet).
      664   END FUNCTION.
      665   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
      666      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      667      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      668      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
      669      FOR FIRST buf_Ext-Classif WHERE
      670                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      671           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
      672                                               STRING(buf_Contract.contract-code)
      673           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
      674          NO-LOCK,
      675          EACH buf_Cont WHERE
      676               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      677           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      678          NO-LOCK:
      679          ASSIGN
      680             iRet = 1.
      681          LEAVE.
      682      END.
      683      IF iRet <> 1 THEN DO:
      684         FOR FIRST buf_Ext-Classif WHERE
      685                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      686              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
      687                                                  STRING(buf_Contract.contract-code)
      688              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
      689             NO-LOCK,
      690             EACH buf_Cont WHERE
      691                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      692              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      693             NO-LOCK:
      694             ASSIGN
      695                iRet = 2.
      696             LEAVE.
      697         END.
      698      END.
      699      RETURN (iRet).
      700   END FUNCTION.
      701   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
      702      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      703      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      704      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
      705      FOR FIRST buf_Ext-Classif WHERE
      706                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      707           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
      708                                               STRING(buf_Contract.contract-code)
      709           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
      710          NO-LOCK,
      711          EACH buf_Cont WHERE
      712               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      713           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      714          NO-LOCK:
      715          ASSIGN
      716             cRet = "+".
      717          LEAVE.
      718      END.
      719      IF cRet = "" THEN DO:
      720         FOR FIRST buf_Ext-Classif WHERE
      721                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      722              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
      723                                                  STRING(buf_Contract.contract-code)
      724              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
      725             NO-LOCK,
      726             EACH buf_Cont WHERE
      727                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      728              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      729             NO-LOCK:
      730             ASSIGN
      731                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
      732             LEAVE.
      733         END.
      734      END.
      735      RETURN (cRet).
      736   END FUNCTION.
      737   FUNCTION Is-MS-Contract RETURN LOGICAL(
      738            BUFFER buf_Master FOR ub.Contract,
      739            BUFFER buf_Slave  FOR ub.Contract):
      740      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      741      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
      742                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
      743                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      744                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
      745                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
      746                    NO-LOCK).
      747   END FUNCTION.
      748   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
      749            BUFFER buf_Master FOR ub.Contract,
      750            INPUT iSlave-Host-Code AS INTEGER
      751            ):
      752      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
      753      DEFINE BUFFER buf_Contract    FOR ub.Contract.
      754      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
      755      FIND FIRST buf_Ext-Classif WHERE
      756                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
      757             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
      758             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
      759             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
      760           NO-LOCK NO-ERROR.
      761      IF AVAILABLE buf_Ext-Classif THEN DO:
      762         IF CAN-FIND (FIRST buf_Contract WHERE
      763                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      764                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      765                       NO-LOCK) THEN DO:
      766            ASSIGN
      767               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
      768         END. ELSE DO:
      769            ASSIGN
      770               cRet = "ERROR:" + "Ошибка связи мастер договора " +
      771                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
      772                      "c Host-code=" + STRING(iSlave-Host-Code).
      773         END.
      774      END.
      775      RETURN (cRet).
      776   END FUNCTION.
      777   DEFINE BUFFER buf_S-Contract  FOR ub.Contract.
      778   DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      779   DEFINE VARIABLE iRecId AS RECID NO-UNDO INITIAL ?.
      780   DEFINE BUTTON b-Add
      781        LABEL "&Добавить"
      782        SIZE 11.5 BY 1.13
      783        BGCOLOR 8 .
      784   DEFINE BUTTON b-Del
      785        LABEL "&Удалить"
      786        SIZE 11.5 BY 1.13
      787        BGCOLOR 8 .
      788   DEFINE BUTTON b-Copy
      789        LABEL "&Копировать"
      790        SIZE 11.5 BY 1.13
      791        BGCOLOR 8
      792        TOOLTIP "Добавить договоры с копированием списка подчиненных фирм" .
      793   DEFINE BUTTON B-Help
      794        LABEL "Помо&щь"
      795        SIZE 3 BY 1
      796        BGCOLOR 8 .
      797   DEFINE BUTTON b-hist
      798        LABEL "Ис&тория"
      799        SIZE 3 BY 1.
      800   DEFINE BUTTON b-Lkp
      801        LABEL "&Просмотр"
      802        SIZE 11.5 BY 1.13
      803        BGCOLOR 8 .
      804   DEFINE BUTTON B-print
      805        LABEL "&Печать"
      806        SIZE 3 BY 1.
      807   DEFINE BUTTON b-Quit
      808        LABEL "&Выход"
      809        SIZE 12.5 BY 1.13
      810        BGCOLOR 8 .
      811   DEFINE VARIABLE cSchBegNumCont AS CHARACTER FORMAT "X(256)":U
      812        LABEL "Начало номера договора"
      813        VIEW-AS FILL-IN
      814        SIZE 14 BY 1 NO-UNDO.
      815   DEFINE VARIABLE iSchNumFirm AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      816        LABEL "Номер фирмы"
      817        VIEW-AS FILL-IN
      818        SIZE 14 BY 1 NO-UNDO.
      819   DEFINE QUERY BR-Slave FOR
      820         buf_Ext-Classif,
      821         buf_S-contract SCROLLING.
      822   DEFINE BROWSE BR-Slave
      823     QUERY BR-Slave DISPLAY
      824         buf_S-Contract.host-code            COLUMN-LABEL "Номер!фирмы"     FORMAT ">>>>>>9"
      825    buf_S-Contract.own-name             COLUMN-LABEL "Название фирмы"  FORMAT "x(30)"
      826    buf_S-Contract.contract-prn-code    COLUMN-LABEL "Номер!договора"  FORMAT "x(15)"
      827    buf_S-Contract.contract-name        COLUMN-LABEL "Заголовок"       FORMAT "x(30)"
      828    buf_S-Contract.contract-date        COLUMN-LABEL "Дата!договора"   FORMAT "99/99/9999"
      829       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 16.5 ROW-HEIGHT-CHARS .75 FIT-LAST-COLUMN.
      830   DEFINE FRAME Dialog-Frame
      831        b-Quit AT ROW 1 COL 1
      832        b-Add AT ROW 1 COL 30.5
      833        b-Lkp AT ROW 1 COL 42.0 WIDGET-ID 8
      834        b-Del AT ROW 1 COL 53.5
      835        b-Copy AT ROW 1 COL 65
      836        B-print AT ROW 1 COL 91.5 WIDGET-ID 2
      837        b-hist AT ROW 1 COL 94.5 WIDGET-ID 4
      838        B-Help AT ROW 1 COL 97.5 WIDGET-ID 6
      839        BR-Slave AT ROW 3.25 COL 2 WIDGET-ID 200
      840        iSchNumFirm AT ROW 20 COL 24 COLON-ALIGNED WIDGET-ID 12
      841        cSchBegNumCont AT ROW 20 COL 67 COLON-ALIGNED WIDGET-ID 14
      842        "Поиск:" VIEW-AS TEXT
      843             SIZE 8 BY .92 AT ROW 20 COL 2 WIDGET-ID 10
      844             FGCOLOR 4
      845        SPACE(91.24) SKIP(0.32)
      846       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      847            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      848            TITLE "Подчиненные договоры"
      849            DEFAULT-BUTTON b-Quit WIDGET-ID 100.
      850   ASSIGN
      851          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      852          FRAME Dialog-Frame:HIDDEN           = TRUE.
      853   ON ENTRY OF FRAME Dialog-Frame
      854   DO:
      855      IF buf_M-contract.status_ = 'зкр':U  THEN DO:
      856         ASSIGN
      857            b-Add:SENSITIVE = FALSE
      858            b-Del:SENSITIVE = FALSE
      859            b-Copy:SENSITIVE = FALSE
      860            .
      861      END.
      862   END.
      863   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      864   DO:
      865     APPLY "END-ERROR":U TO SELF.
      866   END.
      867   ON CHOOSE OF b-Add IN FRAME Dialog-Frame
      868   DO:
      869   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   if lookup(self :type
      871            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      872            ) = 0
      873   then do:
      874     message
      875       "$Workfile$"
      876       "Указанному интерфейсному элементу фокус не может быть передан" skip
      877       "Интерфейсный элемент" self :name  skip
      878       "Тип" self :type  skip
      879       "Процедура" this-procedure :file-name skip
      880       view-as alert-box .
      881   end.
      882   else do:
      883     apply "entry":u to self  .
      884     if focus :handle <> self :handle  then do:
      885       return no-apply .
      886     end.
      887   end.
      888     DEFINE VARIABLE v-user-id                AS CHARACTER  NO-UNDO.
      889     DEFINE VARIABLE v-curr-host-code         AS INTEGER    NO-UNDO.
      890     DEFINE VARIABLE v-user-select            AS LOGICAL    NO-UNDO.
      891     DEFINE VARIABLE v-select-host-code       AS INTEGER    NO-UNDO.
      892     DEFINE VARIABLE v-List-select-host-code  AS CHARACTER  NO-UNDO INITIAL "".
      893   run gbl/userhsts.w
      894         (input  parparentproc
      895         ,input  THIS-PROCEDURE:HANDLE
      896         ,input  v-cntxt-db-num
      897         ,input  v-cntxt-userid
      898         ,input  v-cntxt-host-code-obj
      899         ,input  "b-sel,b-mark"
      900         ,output v-user-select
      901         ,output v-select-host-code
      902         ,OUTPUT v-List-select-host-code
      903         ) .
      904     IF v-User-Select <> TRUE THEN DO:
      905        RETURN NO-APPLY.
      906     END. ELSE DO:
      907        RUN str/cont-slave-run.p (
      908            INPUT parParentProc,
      909            INPUT THIS-PROCEDURE:HANDLE,
      910            BUFFER buf_M-Contract,
      911            BUFFER buf_S-Contract,
      912            "add",
      913            INPUT v-List-select-host-code,
      914            OUTPUT v-cError
      915            ).
      916        IF v-cError <> "" THEN DO:
      917           MESSAGE
      918               PROGRAM-NAME(1) SKIP
      919               v-cError SKIP
      920               VIEW-AS ALERT-BOX INFO BUTTONS OK.
      921           RETURN NO-APPLY.
      922        END. ELSE DO:
      923            RUN Open-Query-Br-Slave IN THIS-PROCEDURE.
      924            RETURN NO-APPLY.
      925        END.
      926     END.
      927   END.
      928   ON CHOOSE OF b-Copy IN FRAME Dialog-Frame
      929   DO:
      930      define variable p-rid-list as character no-undo.
      931      define variable iTmp       as integer   no-undo initial 0.
      932      define variable v-List-select-host-code  as character  no-undo initial "".
      933      define buffer buf_M1-contract for ub.contract.
      934   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      935   if lookup(self :type
      936            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      937            ) = 0
      938   then do:
      939     message
      940       "$Workfile$"
      941       "Указанному интерфейсному элементу фокус не может быть передан" skip
      942       "Интерфейсный элемент" self :name  skip
      943       "Тип" self :type  skip
      944       "Процедура" this-procedure :file-name skip
      945       view-as alert-box .
      946   end.
      947   else do:
      948     apply "entry":u to self  .
      949     if focus :handle <> self :handle  then do:
      950       return no-apply .
      951     end.
      952   end.
      953      run str/cont-all.w (
      954         input   parparentproc  ,
      955         input   v-cntxt-host-code-obj     ,
      956         input   "b-sel"         ,
      957         input   "firm-curr|1"      ,
      958         input   ?               ,
      959         input   ?               ,
      960         input   ?               ,
      961         input   ?               ,
      962         input   "current"       ,
      963         input   "all"       ,
      964         input-output p-rid-list )
      965         .
      966         find first buf_M1-contract no-lock where recid(buf_M1-contract) = integer(p-rid-list) no-error.
      967         if available buf_M1-contract then do :
      968           iTmp = Is-MS-Contract-Int (BUFFER buf_M1-contract).
      969           if iTmp <> 1 then do:
      970              message
      971              "Выбранный договор не является мастер договором."   skip
      972              "Копирование списка подчиненных фирм невозможно."
      973              view-as alert-box information.
      974           end.
      975           else do :
      976             FOR EACH buf_Ext-Classif WHERE
      977                       buf_Ext-Classif.Classif-name = v-S_CONTRACT
      978                 AND  buf_Ext-Classif.CharKey_One  = STRING(buf_M1-contract.Host-code) + v-DELIM_CHR_3 +
      979                                                     STRING(buf_M1-contract.contract-code)
      980                 AND  buf_Ext-classif.db-num       = buf_M1-contract.Db-num
      981             NO-LOCK,
      982             EACH buf_S-contract WHERE
      983                       buf_S-Contract.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      984                 AND  buf_S-Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      985             NO-LOCK :
      986                if v-List-select-host-code = "" then v-List-select-host-code = string(buf_S-Contract.Host-code).
      987                                                else v-List-select-host-code = v-List-select-host-code + "," + string(buf_S-Contract.Host-code).
      988             END.
      989             release buf_S-contract.
      990             RUN str/cont-slave-run.p (
      991                 INPUT parParentProc,
      992                 INPUT THIS-PROCEDURE:HANDLE,
      993                 BUFFER buf_M-Contract,
      994                 BUFFER buf_S-Contract,
      995                 "add",
      996                 INPUT v-List-select-host-code,
      997                 OUTPUT v-cError
      998                 ).
      999             IF v-cError <> "" THEN DO:
     1000                 MESSAGE
     1001                     PROGRAM-NAME(1) SKIP
     1002                     v-cError SKIP
     1003                     VIEW-AS ALERT-BOX INFO BUTTONS OK.
     1004                 RETURN NO-APPLY.
     1005             END. ELSE DO:
     1006                 RUN Open-Query-Br-Slave IN THIS-PROCEDURE.
     1007                 RETURN NO-APPLY.
     1008             END.
     1009           end.
     1010         end.
     1011   END.
