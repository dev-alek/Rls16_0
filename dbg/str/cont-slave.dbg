     1563         then do:
     1564           assign
     1565             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1566             no-error .
     1567           if error-status :error
     1568           or error-status :get-message(1) <> ""
     1569           then do:
     1570             undo move_block, retry move_block .
     1571           end.
     1572         end.
