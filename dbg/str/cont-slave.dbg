     1710   procedure diasize_set-height :
     1711     define input  parameter p-new-height  as decimal   no-undo .
     1712     define input  parameter p-move-resize as logical   no-undo .
     1713     do
     1714     on error undo, return error return-value
     1715     :
     1716       run diasize_change-height in this-procedure
     1717         (input  (p-new-height - frame Dialog-Frame :height)
     1718         ,input  p-move-resize
     1719         ) .
     1720     end.
     1721   end procedure.
     1722   procedure diasize_change-width :
     1723     define input  parameter p-change-value as decimal   no-undo .
     1724     define input  parameter p-move-resize  as logical   no-undo .
     1725     define variable v-field-group-handle   as handle    no-undo .
     1726     define variable v-object-handle        as handle    no-undo .
     1727     define variable v-frame-width          as decimal   no-undo .
     1728     define variable v-frame-virtual-width  as decimal   no-undo .
     1729     define variable v-browse-width         as decimal   no-undo .
     1730     define variable v-window-width         as decimal   no-undo .
     1731     define variable v-window-virtual-width as decimal   no-undo .
     1732     define variable v-change-sign          as integer   no-undo .
     1733     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1734     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1735     if p-change-value > 0
     1736     then do:
     1737       if frame Dialog-Frame :width + p-change-value >
     1738           session :width-chars
     1739       then do:
     1740         assign
     1741           p-change-value = session :width-chars - frame Dialog-Frame :width
     1742         .
     1743         if p-change-value <= 0
     1744         then do:
     1745           run diasize_position-resize-button in this-procedure .
     1746           return .
     1747         end.
     1748       end.
     1749     end.
     1750     if p-change-value < 0
     1751     then do:
     1752       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1753       then do:
     1754         assign
     1755           p-change-value = v-diasize-orig-frame-width
     1756                          - frame Dialog-Frame :width
     1757         .
     1758         if p-change-value >= 0
     1759         then do:
     1760           run diasize_position-resize-button in this-procedure .
     1761           return .
     1762         end.
     1763       end.
     1764     end.
     1765     if p-change-value >= 0
     1766     then do:
     1767       assign
     1768         v-change-sign = 1
     1769       .
     1770     end.
     1771     else do:
     1772       assign
     1773         v-change-sign = -1
     1774       .
     1775     end.
     1776     assign
     1777       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1778     .
     1779     if p-change-value = 0
     1780     then do:
     1781       run diasize_position-resize-button in this-procedure .
     1782       return .
     1783     end.
     1784     move_block:
     1785     do
     1786     on error undo move_block, leave move_block
     1787     :
     1788       if retry
     1789       then do:
     1790         do
