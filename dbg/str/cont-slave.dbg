        1   define variable vss-revision    as character no-undo init "$Revision$":u .
        2   define variable vss-author      as character no-undo init "$Author$":u .
        3   define variable vss-date        as character no-undo init "$Date$":u .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        5   define variable vss-archive     as character no-undo init "$Archive$":u .
        6   define variable vss-description as character no-undo init "$Интерфейс подчиненных договоров":U.
        7   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   define input  parameter bttns          as char      no-undo .
        9   define input  parameter ref-mode       as character no-undo .
       10   define input  parameter p-host-code    as integer   no-undo .
       11   DEFINE PARAMETER BUFFER buf_M-Contract FOR ub.Contract.
       12   DEFINE OUTPUT PARAMETER v-cError       as CHARACTER NO-UNDO INITIAL "" .
       13   DEFINE VARIABLE v-db-num  AS INTEGER NO-UNDO.
       14   DEFINE VARIABLE v-ret AS LOGICAL NO-UNDO.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define temp-table userhsts_temp-user-host no-undo
      120     field host-code as integer
      121     index xpk is primary unique host-code
      122     .
      123   procedure userhsts_clear :
      124     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      125     do
      126     on error undo, return error return-value
      127     :
      128       for each buf_userhsts_temp-user-host
      129       on error undo, return error return-value
      130       :
      131         delete buf_userhsts_temp-user-host .
      132       end.
      133     end.
      134   end procedure.
      135   procedure userhsts_object-count :
      136     define output parameter p-total-count as integer   no-undo .
      137     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      138     do
      139     on error undo, return error return-value
      140     :
      141       assign
      142         p-total-count = 0
      143       .
      144       for each buf_userhsts_temp-user-host
      145       on error undo, return error return-value
      146       :
      147         assign
      148           p-total-count = p-total-count + 1
      149         .
      150       end.
      151     end.
      152   end procedure.
      153   procedure userhsts_append :
      154     define input  parameter p-host-code as integer   no-undo .
      155     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      156     do
      157     on error undo, return error return-value
      158     :
      159       find first buf_userhsts_temp-user-host
      160         where buf_userhsts_temp-user-host.host-code = p-host-code
      161         no-error .
      162       if not available buf_userhsts_temp-user-host
      163       then do:
      164         create buf_userhsts_temp-user-host .
      165         assign
      166           buf_userhsts_temp-user-host.host-code = p-host-code
      167         .
      168       end.
      169     end.
      170   end procedure.
      171   procedure userhsts_object-exist :
      172     define output parameter p-object-exist as logical   no-undo .
      173     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      174     do
      175     on error undo, return error return-value
      176     :
      177       find first buf_userhsts_temp-user-host
      178         no-error .
      179       if not available buf_userhsts_temp-user-host
      180       then do:
      181         assign
      182           p-object-exist = false
      183         .
      184       end.
      185       else do:
      186         assign
      187           p-object-exist = true
      188         .
      189       end.
      190     end.
      191   end procedure.
      192   procedure userhsts_transfer :
      193     define input  parameter p-callback-handle as handle no-undo .
      194     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      195     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      196     do
      197     on error undo, return error return-value
      198     :
      199       if valid-handle(p-callback-handle) <> true
      200       then do:
      201         message
      202           vss-workfile vss-revision vss-description skip
      203           "Ошибка задания входных параметров" skip
      204           "Неизвестный указатель на процедуру" skip
      205           view-as alert-box error .
      206         undo, return error return-value .
      207       end.
      208       if p-callback-handle :get-signature("userhsts_append") = ""
      209       then do:
      210         message
      211           vss-workfile vss-revision vss-description skip
      212           "Ошибка задания входных параметров" skip
      213           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      214                     ,p-callback-handle :file-name
      215                     ) skip
      216           view-as alert-box error .
      217         undo, return error return-value .
      218       end.
      219       for each buf_userhsts_temp-user-host
      220       on error undo, return error return-value
      221       :
      222         run userhsts_append in p-callback-handle
      223           (input  buf_userhsts_temp-user-host.host-code
      224           ) .
      225       end.
      226     end.
      227   end procedure.
