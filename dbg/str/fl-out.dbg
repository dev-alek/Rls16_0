      678   procedure lineattr-delete :
      679     do
      680     on error undo, return error return-value
      681     :
      682       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      683       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      684       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      685       define output parameter p-deleted  as logical no-undo.
      686       define buffer buf_doc-line-attr for ub.doc-line-attr .
      687       def var v-type           as character no-undo .
      688       def var v-format         as character no-undo .
      689       def var v-fillin_width   as integer   no-undo .
      690       def var v-fillin_height  as integer   no-undo .
      691       def var v-label          as character no-undo .
      692       def var v-user-can-edit  as logical   no-undo .
      693       def var v-output-display as logical   no-undo .
      694       def var v-other          as character no-undo .
      695       run lineattr-code in this-procedure
      696         (input  p-code
      697         ,output v-type
      698         ,output v-format
      699         ,output v-fillin_width
      700         ,output v-fillin_height
      701         ,output v-label
      702         ,output v-user-can-edit
      703         ,output v-output-display
      704         ,output v-other
      705         ) no-error .
      706       if error-status :error then do:
      707         undo, return error return-value .
      708       end.
      709       find first buf_doc-line-attr exclusive-lock
      710         where buf_doc-line-attr.doc-code  = p-doc-code
      711           and buf_doc-line-attr.gds-code  = p-gds-code
      712           and buf_doc-line-attr.attr-code = p-code
      713         no-error NO-WAIT.
      714       if not available buf_doc-line-attr then do:
      715         p-deleted = no.
      716       end.
      717       else do:
      718         delete buf_doc-line-attr.
      719         p-deleted = yes.
      720       end.
      721     end.
      722   end procedure.
      723   procedure lineattr-code :
      724     do on error undo, return error return-value
      725     :
      726       define input  parameter p-code           as character no-undo .
      727       define output parameter p-type           as character no-undo .
      728       define output parameter p-format         as character no-undo .
      729       define output parameter p-fillin_width   as integer   no-undo .
      730       define output parameter p-fillin_height  as integer   no-undo .
      731       define output parameter p-label          as character no-undo .
      732       define output parameter p-user-can-edit  as logical   no-undo .
      733       define output parameter p-output-display as logical   no-undo .
      734       define output parameter p-other          as character no-undo .
      735       case p-code :
      736               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      737               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      738               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      739               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      740               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      741               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      742               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      743               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      744               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      745               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      746               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      747         otherwise do:
      748           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      749         end.
      750       end.
      751     end.
      752   end procedure.
      753   procedure lineattr-value-flora-gds :
      754     do
      755     on error undo, return error return-value
      756     :
      757       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      758       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      759       define input  parameter p-prt-code    as integer   no-undo .
      760       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      761       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      762       define output parameter p-value       as    decimal   no-undo .
      763       define buffer buf_doc-line-attr for ub.doc-line-attr .
      764       find first buf_doc-line-attr no-lock
      765         where buf_doc-line-attr.doc-code  = p-doc-code
      766           and buf_doc-line-attr.gds-code  = p-gds-code
      767           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      768         no-error .
      769       if avail buf_doc-line-attr then do:
      770         assign
      771           p-value = decimal( buf_doc-line-attr.attr-value)
      772         .
      773       end.
      774       else do:
      775         assign
      776           p-value = 0
      777         .
      778       end.
      779     end.
      780   end procedure.
      781   procedure lineattr-write-flora-gds :
      782     do
      783     on error undo, return error return-value
      784     :
      785       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      786       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      787       define input parameter p-prt-code    as integer   no-undo .
      788       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      789       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      790       define input parameter p-value    as decimal   no-undo .
      791       define buffer buf_doc-line-attr for ub.doc-line-attr .
      792       find first buf_doc-line-attr exclusive-lock
      793         where buf_doc-line-attr.doc-code  = p-doc-code
      794           and buf_doc-line-attr.gds-code  = p-gds-code
      795           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      796         no-error .
      797       if not available buf_doc-line-attr then do:
      798         create buf_doc-line-attr .
      799         assign
      800           buf_doc-line-attr.doc-code  = p-doc-code
      801           buf_doc-line-attr.gds-code  = p-gds-code
      802           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      803         .
      804       end.
      805       assign
      806         buf_doc-line-attr.attr-value = string( p-value )
      807       .
      808     end.
      809   end procedure.
      810   procedure lineattr-delete-flora-gds :
      811     do
      812     on error undo, return error return-value
      813     :
      814       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      815       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      816       define input  parameter p-prt-code    as integer   no-undo .
      817       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      818       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      819       define output parameter p-deleted  as logical no-undo.
      820       define buffer buf_doc-line-attr for ub.doc-line-attr .
      821       find first buf_doc-line-attr exclusive-lock
      822         where buf_doc-line-attr.doc-code  = p-doc-code
      823           and buf_doc-line-attr.gds-code  = p-gds-code
      824           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      825         no-error NO-WAIT.
      826       if not available buf_doc-line-attr then do:
      827         p-deleted = no.
      828       end.
      829       else do:
      830         delete buf_doc-line-attr.
      831         p-deleted = yes.
      832       end.
      833     end.
      834   end procedure.
      835   procedure lineattr-delete-flora-all :
      836     do
      837     on error undo, return error return-value
      838     :
      839       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      840       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      841       define input  parameter p-prt-code    as integer   no-undo .
      842       define buffer buf_doc-line-attr for ub.doc-line-attr .
      843       for each buf_doc-line-attr exclusive-lock
      844         where buf_doc-line-attr.doc-code  = p-doc-code
      845           and buf_doc-line-attr.gds-code  = p-gds-code
      846           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      847        :
      848         delete buf_doc-line-attr.
      849       end.
      850    end.
      851   end procedure.
      852   procedure lineattr-exist-flora-gds :
      853     do
      854     on error undo, return error return-value
      855     :
      856       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      857       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      858       define input  parameter p-prt-code    as integer   no-undo .
      859       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      860       define output parameter p-exist as logical   no-undo .
      861       define buffer buf_doc-line-attr for ub.doc-line-attr .
      862       p-exist = false .
      863       find first buf_doc-line-attr no-lock
      864         where buf_doc-line-attr.doc-code  = p-doc-code
      865           and buf_doc-line-attr.gds-code  = p-gds-code
      866           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      867         no-error .
      868       if avail buf_doc-line-attr then do:
      869         assign
      870          p-exist = true
      871         .
      872       end.
      873     end.
      874   end procedure.
      875   procedure lineattr-write-add-line-cli :
      876   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      877   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      878   define input  parameter p-cli-type      as character no-undo .
      879   define input  parameter p-cli-code      as integer   no-undo .
      880   define input  parameter p-contract-code as integer   no-undo .
      881   define input  parameter p-host-code     as integer   no-undo .
      882   define input  parameter p-exch-code     as integer   no-undo .
      883   define input  parameter p-exch-rate     as decimal   no-undo .
      884   define input  parameter p-exch-scale    as integer   no-undo .
      885   define input  parameter p-sum-cli       as decimal   no-undo .
      886   define input  parameter p-sum-vat       as decimal   no-undo .
      887   define buffer buf_doc-line-attr for ub.doc-line-attr .
      888     do
      889     on error undo, return error return-value
      890     :
      891       find first buf_doc-line-attr exclusive-lock
      892         where buf_doc-line-attr.doc-code  = p-doc-code
      893           and buf_doc-line-attr.gds-code  = p-gds-code
      894           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      895                                             chr(4) + p-cli-type +
      896                                             chr(4) + string(p-cli-code) +
      897                                             chr(4) + string(p-contract-code) +
      898                                             chr(4) + string(p-host-code)
      899         no-error .
      900       if not available buf_doc-line-attr then do:
      901         create buf_doc-line-attr .
      902         assign
      903           buf_doc-line-attr.doc-code  = p-doc-code
      904           buf_doc-line-attr.gds-code  = p-gds-code
      905           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      906                                         chr(4) + p-cli-type +
      907                                         chr(4) + string(p-cli-code) +
      908                                         chr(4) + string(p-contract-code) +
      909                                         chr(4) + string(p-host-code)
      910         .
      911       end.
      912       assign
      913         buf_doc-line-attr.attr-value =
      914         string(p-exch-code)  + chr(4) +
      915         string(p-exch-rate)  + chr(4) +
      916         string(p-exch-scale) + chr(4) +
      917         string(p-sum-cli)    + chr(4) +
      918         string(p-sum-vat)
      919         .
      920     end.
      921   end procedure.
      922   procedure lineattr-value-add-line-cli :
      923   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      924   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      925   define input   parameter p-cli-type      as character no-undo .
      926   define input   parameter p-cli-code      as integer   no-undo .
      927   define input   parameter p-contract-code as integer   no-undo .
      928   define input   parameter p-host-code     as integer   no-undo .
      929   define output  parameter p-exch-code     as integer   no-undo .
      930   define output  parameter p-exch-rate     as decimal   no-undo .
      931   define output  parameter p-exch-scale    as integer   no-undo .
      932   define output  parameter p-sum-cli       as decimal   no-undo .
      933   define output  parameter p-sum-vat       as decimal   no-undo .
      934   define buffer buf_doc-line-attr for ub.doc-line-attr .
      935     do
      936     on error undo, return error return-value
      937     :
      938       find first buf_doc-line-attr exclusive-lock
      939         where buf_doc-line-attr.doc-code  = p-doc-code
      940           and buf_doc-line-attr.gds-code  = p-gds-code
      941           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      942                                             chr(4) + p-cli-type +
      943                                             chr(4) + string(p-cli-code) +
      944                                             chr(4) + string(p-contract-code) +
      945                                             chr(4) + string(p-host-code)
      946         no-error .
      947       if available buf_doc-line-attr then do:
      948        assign
      949           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      950           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      951           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      952           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      953           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      954          .
      955        end.
      956     end.
      957   end procedure.
      958   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      959     define variable v-code as character no-undo .
      960     define variable v-type as character no-undo .
      961     define variable v-gds-code as integer   no-undo .
      962   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      964     (input  local-doc-line.artic
      965     ,input  local-doc-line.prod-type
      966     ,input  local-doc-line.prod-code
      967     ,output v-gds-code
      968     )  .
      969     run lineattr-value (
      970         input   local-doc-line.doc-code ,
      971         input   v-gds-code              ,
      972         input   'reason-code':U ,
      973         output  v-code                  ,
      974         output  v-type ) .
      975     find first ub.trn-reason no-lock where
      976                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      977     if not available ub.trn-reason then do:
      978        return "" .
      979     end.
      980     else do:
      981        return ub.trn-reason.reason-name .
      982     end.
      983   end function.
      984   procedure lineattr-value-parts :
      985     do
      986     on error undo, return error return-value
      987     :
      988       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      989       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      990       define input  parameter p-part-code   as character no-undo .
      991       define input  parameter p_in-code     as character no-undo .
      992       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      993       define output parameter p-value       as    decimal   no-undo .
      994       define buffer buf_doc-line-attr for ub.doc-line-attr .
      995       find first buf_doc-line-attr no-lock
      996         where buf_doc-line-attr.doc-code  = p-doc-code
      997           and buf_doc-line-attr.gds-code  = p-gds-code
      998           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      999         no-error .
     1000       if avail buf_doc-line-attr then do:
     1001         assign
     1002           p-value = decimal( buf_doc-line-attr.attr-value)
     1003         .
     1004       end.
     1005       else do:
     1006         assign
     1007           p-value = 0
     1008         .
     1009       end.
     1010     end.
     1011   end procedure.
     1012   procedure lineattr-write-parts :
     1013     do
     1014     on error undo, return error return-value
     1015     :
     1016       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1017       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1018       define input parameter p-part-code  as character no-undo .
     1019       define input parameter p_in-code    as character no-undo .
     1020       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     1021       define input parameter p-value      as decimal   no-undo .
     1022       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1023       find first buf_doc-line-attr exclusive-lock
     1024         where buf_doc-line-attr.doc-code  = p-doc-code
     1025           and buf_doc-line-attr.gds-code  = p-gds-code
     1026           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1027         no-error .
     1028       if not available buf_doc-line-attr then do:
     1029         create buf_doc-line-attr .
     1030         assign
     1031           buf_doc-line-attr.doc-code  = p-doc-code
     1032           buf_doc-line-attr.gds-code  = p-gds-code
     1033           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1034         .
     1035       end.
     1036       assign
     1037         buf_doc-line-attr.attr-value = string( p-value )
     1038       .
     1039     end.
     1040   end procedure.
     1041   procedure proc-alt-shift-f2:
     1042     if not ibs.th.gbl.gbl-var:rcode
     1043   then
     1044     run gbl\inidebug.p .
     1045   end.
     1046   procedure proc-alt-shift-f3:
     1047     run gbl/prvssinf.p
     1048       ( input this-procedure
     1049       ) .
     1050   end.
     1051   define variable v-inform-launched as logical no-undo initial false .
     1052   procedure proc-alt-shift-f4:
     1053     define variable v-action as character no-undo .
     1054     if v-inform-launched = false then do:
     1055       assign
     1056         v-inform-launched = true
     1057       .
     1058       run gbl/d-inform.w
     1059         (  input self
     1060         ,  input this-procedure
     1061         , output v-action
     1062         ) no-error .
     1063       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1064       assign
     1065         v-inform-launched = false
     1066       .
     1067     end.
     1068   end.
     1069   procedure proc-alt-f1:
     1070     run gbl/corrhelp.p
     1071       (input this-procedure
     1072       ) .
     1073   end .
     1074   on alt-shift-f2 anywhere do:
     1075     run proc-alt-shift-f2.
     1076   end.
     1077   on alt-shift-f3 anywhere do:
     1078     run proc-alt-shift-f3 in this-procedure .
     1079   end.
     1080   on alt-shift-f4 anywhere do:
     1081     run proc-alt-shift-f4 in this-procedure.
     1082   end.
     1083   on alt-f1 anywhere do:
     1084     run proc-alt-f1 in this-procedure .
     1085   end.
     1086   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087     define variable v-cntxt-db-num        as integer   no-undo .
     1088     define variable v-cntxt-userid        as character no-undo .
     1089     define variable v-cntxt-level         as character no-undo .
     1090     define variable v-cntxt-host-code-obj as integer   no-undo .
     1091     define variable v-cntxt-obj-type      as character no-undo .
     1092     define variable v-cntxt-obj-code      as integer   no-undo .
     1093     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1094     define variable v-cntxt-is-admin      as logical   no-undo .
     1095   define variable g#host-name  as character no-undo .
     1096   define variable g#host-code  as integer   no-undo .
     1097   define variable store-type   as character no-undo .
     1098   define variable store-code   as integer   no-undo .
     1099   define variable g#log        as logical   no-undo .
     1100   define variable g#report-num as integer   no-undo .
     1101   define variable g#rsrv-time  as decimal   no-undo .
     1102   define variable g#db-remote  as logical   no-undo .
     1103   define buffer buf_sysconf    for ub.sysconf  .
     1104   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105     run mainmenu_getcntxt in parparentproc
     1106       (output v-cntxt-db-num
     1107       ,output v-cntxt-userid
     1108       ,output v-cntxt-level
     1109       ,output v-cntxt-host-code-obj
     1110       ,output v-cntxt-obj-type
     1111       ,output v-cntxt-obj-code
     1112       ,output v-cntxt-db-num-obj
     1113       ,output v-cntxt-is-admin
     1114       ) .
     1115   assign
     1116     store-type    = v-cntxt-obj-type
     1117     store-code    = v-cntxt-obj-code
     1118     g#db-remote   = (v-cntxt-db-num <> 0)
     1119   .
     1120   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1122     (input  store-type
     1123     ,input  store-code
     1124     ,output g#host-code
     1125     ,output g#host-name
     1126     )  .
     1127   run get-report-num  in parParentProc ( output g#report-num ).
     1128   find first buf_sysconf no-lock where buf_sysconf.host-code = g#host-code .
     1129       assign
     1130         g#rsrv-time = buf_sysconf.rsrv-time
     1131       .
     1132   define variable v-today     as date                 no-undo.
     1133   define variable chg-qnty    like gds-dtl.doc-qnty   no-undo.
     1134   define buffer t-doc for trn-doc.
     1135   define buffer t-doc-attr for doc-attr.
     1136   define buffer n-d for trn-doc.
     1137   define buffer n-l for doc-line.
     1138   define buffer n-l-attr for doc-line-attr.
     1139   define buffer n-g for gds-dtl.
     1140   define variable  v-price-base like gds-dtl.price-base no-undo .
     1141   define variable  v-price-rubl like gds-dtl.price-rubl no-undo .
     1142   define variable  v-nabor as logical   no-undo init false .
     1143   find t-doc where t-doc.doc-code = trn-code.
     1144   if not (can-do ('спи,возврат':U, t-doc.doc-type) and not t-doc.internal or t-doc.doc-type = 'рас':U) then do:
     1145     message "Документ №" t-doc.doc-code skip
     1146             "По документу данного типа резервирование невозможно.".
     1147     return error.
     1148   end.
     1149   if t-doc.status_ <> 'запрос':U then do:
     1150     message "Документ №" t-doc.doc-code skip
     1151             "По документу с данным статусом резервирование невозможно.".
     1152     return error.
     1153   end.
     1154   req1:
     1155   do on stop undo req1, return error on error undo req1, return error :
     1156     assign
     1157       t-doc.status_ = 'накл':U
     1158       t-doc.flag_ = no.
     1159     create n-d.
     1160   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1162     (input  store-type
     1163     ,input  store-code
     1164     ,output v-today
     1165     )  .
     1166     run doc-code in this-procedure
     1167     (input  "flora",
     1168      input  store-type,
     1169      input  store-code,
     1170      input  t-doc.doc-code,
     1171      output n-d.doc-code ) no-error.
     1172     if error-status:error then do:
     1173       message "Ошибка при генерации номера документа." return-value
     1174       view-as alert-box error.
     1175       undo req1, return error.
     1176     end.
     1177     buffer-copy t-doc except doc-code flora-order-date creid to n-d
     1178     assign
     1179       n-d.status_    = 'готов':U
     1180       n-d.flag_      = true
     1181       .
     1182     for each doc-line-attr where doc-line-attr.doc-code = t-doc.doc-code
     1183          on stop undo req1, return error on error undo req1, return error :
     1184       create n-l-attr.
     1185       buffer-copy doc-line-attr to n-l-attr
     1186       assign
     1187         n-l-attr.doc-code  = n-d.doc-code
     1188         .
     1189     end.
     1190     for each doc-attr where doc-attr.doc-code = t-doc.doc-code
     1191          on stop undo req1, return error on error undo req1, return error :
     1192       create t-doc-attr.
     1193       buffer-copy doc-attr to t-doc-attr
     1194       assign
     1195         t-doc-attr.doc-code  = n-d.doc-code
     1196         .
     1197     end.
     1198     for each doc-line where doc-line.doc-code = t-doc.doc-code
     1199          on stop undo req1, return error on error undo req1, return error :
     1200      find first goods where goods.artic     = doc-line.artic
     1201                         and goods.prod-type = doc-line.prod-type
     1202                         and goods.prod-code = doc-line.prod-code no-lock.
     1203      run ver-gds-grp-nabor (input goods.gds-code , output v-nabor ) .
     1204      if v-nabor = false  then do:
     1205        undo req1, return error "Нельзя в заказ на исполнение на стадии запр включать товар " + doc-line.artic + " " + goods.gds-name.
     1206      end.
     1207      else do:
     1208       define variable v-ex as logical   no-undo init false .
     1209       run lineattr-exist (
     1210           input  doc-line.doc-code ,
     1211           input  goods.gds-code    ,
     1212           input  'flora_ps':U ,
     1213           output  v-ex                ).
     1214       if v-ex = false then do:
     1215           run lineattr-write (
     1216               input  doc-line.doc-code ,
     1217               input  goods.gds-code    ,
     1218               input  'flora_ps':U ,
     1219               input  ""                ).
     1220           run lineattr-write (
     1221               input  n-d.doc-code,
     1222               input  goods.gds-code    ,
     1223               input  'flora_ps':U ,
     1224               input  ""                ).
     1225       end.
     1226      end.
     1227       create n-l.
     1228       buffer-copy doc-line to n-l
     1229       assign
     1230         n-l.doc-code  = n-d.doc-code
     1231         .
     1232           for each gds-dtl where gds-dtl.doc-code  = t-doc.doc-code
     1233                             and gds-dtl.prod-code = doc-line.prod-code
     1234                             and gds-dtl.prod-type = doc-line.prod-type
     1235                             and gds-dtl.artic     = doc-line.artic
     1236           on stop undo req1, return error on error undo req1, return error :
     1237             create n-g.
     1238             buffer-copy gds-dtl to n-g
     1239             assign
     1240               n-g.doc-code = n-d.doc-code
     1241               chg-qnty     = gds-dtl.doc-qnty
     1242               .
     1243             v-price-base = gds-dtl.price-base .
     1244             v-price-rubl = gds-dtl.price-rubl .
     1245             run trg/rsrv-dtl.p
     1246               (input parParentProc
     1247               , input 'reserv':U
     1248               + ",":U + 'no-msg-create':U
     1249               + ",":U + 'negative-check':U + '=':U + '1':U
     1250               , buffer gds-dtl
     1251               , input-output chg-qnty
     1252               , input-output v-price-base
     1253               , input-output v-price-rubl
     1254               ,   -1
     1255               , ""
     1256               ) no-error.
     1257             if error-status:error then do:
     1258               undo req1, return error.
     1259             end.
     1260           end.
     1261     end.
     1262     assign
     1263      t-doc.out-code   = n-d.doc-code
     1264      t-doc.PS         = t-doc.PS + "  Накладная на набор "
     1265      t-doc.rsrv-date  = today + g#rsrv-time
     1266     .
     1267   end.
