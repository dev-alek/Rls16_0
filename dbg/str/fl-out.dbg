        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  as widget-handle no-undo.
        3   define input  parameter trn-code       like ub.trn-doc.doc-code no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: 5baf537283c9, 2487, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        6   define variable vss-date        as character no-undo init "$Date: Пт июн 26 16:47:04 2020 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: fl-out.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/fl-out.p $":U .
        9   define variable vss-description as character no-undo init "Переведение запроса в накладную с без резервированиея товара и запросом ГОТОВ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
       76   define variable gp-price-sale like ub.price-list.price-sale no-undo.
       77   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
       78   define variable gp-excise     like ub.price-list.excise     no-undo.
       79   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
       80   define variable gp-fact-order as decimal   no-undo .
       81   define variable gp-price-sale-parts as decimal   no-undo .
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure doc-code:
       84   define input  parameter parmode          as   character           no-undo.
       85   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       86   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       87   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       88   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       89   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       90   define variable vardb-remote     as   logical             no-undo.
       91   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       92   define variable v-delimiter as character no-undo .
       93   do
       94   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       95   :
       96   find first buf_sys-ctrl no-lock .
       97   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       98     CASE parmode:
       99       when "main":u then do:
      100         if vardb-remote then do:
      101           assign
      102             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      103         end.
      104         else do:
      105           assign
      106             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      107         end.
      108       end.
      109       when "trio" then do:
      110         assign
      111           pardoc-code = replace (parroot-doc-code, "=", "*").
      112       end.
      113       otherwise do:
      114         assign
      115         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      116         no-error
      117         .
      118         if error-status:error  then do:
      119           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      120                                         ,chr(10)
      121                                         ,parmode
      122                                         ).
      123         end.
      124         if num-entries(parmode) = 1
      125         and parmode <> "chip":U
      126         and parmode <> "chip_s":U
      127         then do:
      128           assign
      129           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      130         end.
      131         else if (lookup("chip":U, parmode) > 0
      132                  or
      133                  lookup("chip_s":U, parmode) > 0) then do:
      134           assign
      135             vartemp-doc-code = parroot-doc-code.
      136           do while true:
      137             if index (vartemp-doc-code , ".") = 0 then
      138               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      139             else
      140               vartemp-doc-code  =
      141               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      142               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      143               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      144             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      145           end.
      146           assign
      147             pardoc-code = vartemp-doc-code.
      148         end.
      149       end.
      150     end CASE.
      151     if pardoc-code = '':U
      152     or (parroot-doc-code <> '':U
      153     and pardoc-code = parroot-doc-code) then do:
      154       undo, return error substitute("Ошибка при генерации номера документа&1"
      155                                     ,chr(10)).
      156     end.
      157   end.
      158   end. // procedure/method
      159   function get-doc-code-int64 returns int64
      160     ( input p-doc-code as character ) :
      161     define variable v-ind              as integer   no-undo .
      162     define variable v-num-entries      as integer   no-undo .
      163     define variable v-doc-code-int64   as int64     no-undo .
      164     define variable v-canonic-doc-code as character no-undo .
      165     assign
      166       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      167       v-canonic-doc-code = p-doc-code
      168     .
      169     do v-ind = 1 to v-num-entries
      170     :
      171       assign
      172         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      173       .
      174     end.
      175     assign
      176       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      177     .
      178     return v-doc-code-int64 .
      179   end. // function/method
      180   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
