      217   procedure grp-attr-name :
      218   do
      219     on error undo, return error
      220     :
      221     define input  parameter p-code           as character no-undo .
      222     define output parameter p-type           as character no-undo .
      223     define output parameter p-format         as character no-undo .
      224     define output parameter p-label          as character no-undo .
      225     define output parameter p-user-can-edit  as logical   no-undo .
      226     define output parameter p-output-display as logical   no-undo .
      227     define output parameter p-other          as character no-undo .
      228       case p-code :
      229               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      230         otherwise do:
      231           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      232         end.
      233       end.
      234     end.
      235   end procedure.
      236   procedure grp-attr-tooltip :
      237   do
      238     on error undo, return error
      239     :
      240       define input  parameter p-code    as character no-undo .
      241       define output parameter p-tooltip as character no-undo .
      242       define output parameter p-label   as character no-undo .
      243       case p-code :
      244               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      245         otherwise do:
      246               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      247         end.
      248       end.
      249     end.
      250   end procedure.
      251   procedure grp-attr-value :
      252   do
      253   on error undo, return error
      254   :
      255   define input  parameter p-node-code   as integer    no-undo.
      256   define input  parameter p-code        as character  no-undo.
      257   define input  parameter p-host-code   as integer    no-undo.
      258   define input  parameter p-obj-type    as character  no-undo.
      259   define input  parameter p-obj-code    as integer    no-undo.
      260   define output parameter p-value       as character  no-undo.
      261   define output parameter p-type        as character  no-undo.
      262       define variable v-format         as character no-undo .
      263       define variable v-label          as character no-undo .
      264       define variable v-user-can-edit  as logical   no-undo .
      265       define variable v-output-display as logical   no-undo .
      266       define variable v-other          as character no-undo .
      267       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      268       run grp-attr-name in this-procedure (
      269             input  p-code
      270           , output p-type
      271           , output v-format
      272           , output v-label
      273           , output v-user-can-edit
      274           , output v-output-display
      275           , output v-other
      276       ) no-error .
      277       if error-status :error
      278       then do:
      279           undo, return error return-value .
      280       end.
      281       find first buf_gds-grp-attr no-lock
      282            where buf_gds-grp-attr.node-code = p-node-code
      283              and buf_gds-grp-attr.attr-code = p-code
      284              and buf_gds-grp-attr.host-code = p-host-code
      285              and buf_gds-grp-attr.obj-type  = p-obj-type
      286              and buf_gds-grp-attr.obj-code  = p-obj-code
      287       no-error .
      288       if available buf_gds-grp-attr
      289       then do:
      290           assign
      291               p-value = buf_gds-grp-attr.attr-value
      292           .
      293       end.
      294       else do:
      295           assign
      296               p-value = if p-type = 'L':U then "no":U else ""
      297           .
      298       end.
      299   end.
      300   end procedure.
      301   procedure grp-attr-write :
      302   do
      303   on error undo, return error
      304   :
      305   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      306   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      307   define input parameter p-host-code  as integer                          no-undo.
      308   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      309   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      310   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      311       define variable v-type              as character                no-undo.
      312       define variable v-format            as character                no-undo.
      313       define variable v-label             as character                no-undo.
      314       define variable v-user-can-edit     as logical                  no-undo.
      315       define variable v-output-display    as logical                  no-undo.
      316       define variable v-other             as character                no-undo.
      317       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      318       run grp-attr-name in this-procedure (
      319                         input  p-code
      320                       , output v-type
      321                       , output v-format
      322                       , output v-label
      323                       , output v-user-can-edit
      324                       , output v-output-display
      325                       , output v-other
      326       ) no-error.
      327       if error-status :error
      328       then do:
      329           undo, return error return-value.
      330       end.
      331       find first buf_gds-grp-attr exclusive-lock
      332            where buf_gds-grp-attr.node-code  = p-node-code
      333              and buf_gds-grp-attr.attr-code  = p-code
      334              and buf_gds-grp-attr.host-code  = p-host-code
      335              and buf_gds-grp-attr.obj-type   = p-obj-type
      336              and buf_gds-grp-attr.obj-code   = p-obj-code
      337       no-error.
      338       if not available buf_gds-grp-attr
      339       then do:
      340           create buf_gds-grp-attr.
      341           assign
      342                   buf_gds-grp-attr.node-code  = p-node-code
      343                   buf_gds-grp-attr.attr-code  = p-code
      344                   buf_gds-grp-attr.host-code  = p-host-code
      345                   buf_gds-grp-attr.obj-type   = p-obj-type
      346                   buf_gds-grp-attr.obj-code   = p-obj-code
      347                   buf_gds-grp-attr.attr-value = p-value
      348           .
      349       end.
      350       else do:
      351           assign
      352               buf_gds-grp-attr.attr-value = p-value
      353           .
      354       end.
      355   end.
      356   end procedure.
      357   procedure grp-attr-delete :
      358   do
      359   on error undo, return error
      360   :
      361   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      362   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      363   define input parameter p-host-code  as integer                      no-undo.
      364   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      365   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      366   define output parameter p-deleted   as logical                      no-undo.
      367       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      368       define variable v-type              as character                no-undo.
      369       define variable v-format            as character                no-undo.
      370       define variable v-label             as character                no-undo.
      371       define variable v-user-can-edit     as logical                  no-undo.
      372       define variable v-output-display    as logical                  no-undo.
      373       define variable v-other             as character                no-undo.
      374       run grp-attr-name in this-procedure
      375       ( input  p-code
      376       , output v-type
      377       , output v-format
      378       , output v-label
      379       , output v-user-can-edit
      380       , output v-output-display
      381       , output v-other
      382       ) no-error .
      383       if error-status :error then do:
      384           undo, return error return-value .
      385       end.
      386       find first buf_gds-grp-attr exclusive-lock
      387            where buf_gds-grp-attr.node-code  = p-node-code
      388              and buf_gds-grp-attr.attr-code  = p-code
      389              and buf_gds-grp-attr.host-code  = p-host-code
      390              and buf_gds-grp-attr.obj-type   = p-obj-type
      391              and buf_gds-grp-attr.obj-code   = p-obj-code
      392       no-error.
      393       if not available buf_gds-grp-attr
      394       then do:
      395           assign
      396               p-deleted = no
      397           .
      398       end.
      399       else do:
      400          delete buf_gds-grp-attr.
      401          assign
      402               p-deleted = yes
      403           .
      404       end.
      405   end.
      406   end procedure.
      407   procedure grp-attr-news :
      408   do
      409   on error undo, return error
      410   :
      411       define input  parameter p-code           as character no-undo .
      412       define output parameter p-news           as logical   no-undo .
      413       case p-code :
      414               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      415         otherwise do:
      416           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      417         end.
      418       end.
      419   end.
      420   end procedure.
      421   procedure grp-attr-obj-value :
      422   do
      423   on error undo, return error
      424   :
      425   define input parameter p-node-code as integer      no-undo.
      426   define input parameter p-obj-type  as character    no-undo.
      427   define input parameter p-obj-code  as integer      no-undo.
      428   define input parameter p-attr-code as character    no-undo .
      429   define output parameter p-attr-value     as character   no-undo.
      430   define output parameter p-range     as integer      no-undo.
      431   define output parameter p-exists    as logical      no-undo.
      432   define variable v-host-code as integer      no-undo.
      433   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      435     (input  p-obj-type
      436     ,input  p-obj-code
      437     ,output v-host-code
      438     ) no-error .
      439   if error-status :error
      440   then do:
      441       message
      442         vss-workfile vss-revision vss-description
      443         skip "Не удалось найти фирму объекта"
      444         skip p-obj-type p-obj-code
      445         skip return-value
      446         skip trim(error-status :get-message(1))
      447              trim(error-status :get-message(2))
      448              trim(error-status :get-message(3))
      449              trim(error-status :get-message(4))
      450              trim(error-status :get-message(5))
      451       view-as alert-box error.
      452       undo, return error .
      453   end.
      454   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      455   find first buf_gds-grp-attr no-lock
      456        where buf_gds-grp-attr.node-code = p-node-code
      457          and buf_gds-grp-attr.attr-code = p-attr-code
      458          and buf_gds-grp-attr.host-code = v-host-code
      459          and buf_gds-grp-attr.obj-type  = p-obj-type
      460          and buf_gds-grp-attr.obj-code  = p-obj-code
      461   no-error .
      462   if not available buf_gds-grp-attr
      463   then do:
      464       find first buf_gds-grp-attr no-lock
      465            where buf_gds-grp-attr.node-code = p-node-code
      466              and buf_gds-grp-attr.attr-code = p-attr-code
      467              and buf_gds-grp-attr.host-code = v-host-code
      468              and buf_gds-grp-attr.obj-type  = ""
      469              and buf_gds-grp-attr.obj-code  = 0
      470       no-error .
      471       if not available buf_gds-grp-attr
      472       then do:
      473           find first buf_gds-grp-attr no-lock
      474               where buf_gds-grp-attr.node-code = p-node-code
      475               and buf_gds-grp-attr.attr-code = p-attr-code
      476               and buf_gds-grp-attr.host-code = 0
      477               and buf_gds-grp-attr.obj-type  = ""
      478               and buf_gds-grp-attr.obj-code  = 0
      479           no-error .
      480           if not available buf_gds-grp-attr
      481           then do:
      482               assign
      483                   p-exists = no
      484               .
      485           end.
      486           else do:
      487               assign
      488                   p-exists = yes
      489                   p-range  = 1
      490               .
      491           end.
      492       end.
      493       else do:
      494           assign
      495               p-exists = yes
      496               p-range  = 2
      497           .
      498       end.
      499   end.
      500   else do:
      501       assign
      502           p-exists = yes
      503           p-range  = 3
      504       .
      505   end.
      506   if available buf_gds-grp-attr
      507   then do:
      508     assign
      509     p-attr-value = buf_gds-grp-attr.attr-value
      510     .
      511   end.
      512   end.
      513   end procedure.
      514   procedure ver-gds-grp-nabor :
      515   do
      516   on error undo, return error return-value
      517   :
      518   define input  parameter p-gds-code as integer   no-undo .
      519   define output parameter p-nabor as logical   no-undo .
      520   define buffer buf_goods for ub.goods.
      521   p-nabor = false .
      522   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      523   if error-status :error then return error .
      524   define variable v-value       as character  no-undo.
      525   define variable v-type        as character  no-undo.
      526     run grp-attr-value (
      527        input   buf_goods.grp-code
      528       ,input   'gds-grp-nabor':U
      529       ,input   0
      530       ,input   ""
      531       ,input   0
      532       ,output  v-value
      533       ,output  v-type       ) no-error .
      534       if error-status :error then return error .
      535     if v-value = "yes" then p-nabor = true  .
      536   end.
      537   end procedure.
      538   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   procedure lineattr-value :
      540     do
      541     on error undo, return error return-value
      542     :
      543       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      544       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      545       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      546       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      547       define output parameter p-type     as character no-undo .
      548       define buffer buf_doc-line-attr for ub.doc-line-attr .
      549       def var v-format         as character no-undo .
      550       def var v-fillin_width   as integer   no-undo .
      551       def var v-fillin_height  as integer   no-undo .
      552       def var v-label          as character no-undo .
      553       def var v-user-can-edit  as logical   no-undo .
      554       def var v-output-display as logical   no-undo .
      555       def var v-other          as character no-undo .
      556       run lineattr-code in this-procedure
      557         (input  p-code
      558         ,output p-type
      559         ,output v-format
      560         ,output v-fillin_width
      561         ,output v-fillin_height
      562         ,output v-label
      563         ,output v-user-can-edit
      564         ,output v-output-display
      565         ,output v-other
      566         ) no-error .
      567       if error-status :error then do:
      568         undo, return error return-value .
      569       end.
      570       find first buf_doc-line-attr no-lock
      571         where buf_doc-line-attr.doc-code  = p-doc-code
      572           and buf_doc-line-attr.gds-code  = p-gds-code
      573           and buf_doc-line-attr.attr-code = p-code
      574         no-error .
      575       if avail buf_doc-line-attr then do:
      576         assign
      577           p-value =  buf_doc-line-attr.attr-value
      578         .
      579       end.
      580       else do:
      581         assign
      582           p-value = if p-type = 'L':U then "no":U else ""
      583         .
      584       end.
      585     end.
      586   end procedure.
      587   procedure lineattr-write :
      588     do
      589     on error undo, return error return-value
      590     :
      591       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      592       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      593       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      594       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      595       define buffer buf_doc-line-attr for ub.doc-line-attr .
      596       def var v-type           as character no-undo .
      597       def var v-format         as character no-undo .
      598       def var v-fillin_width   as integer   no-undo .
      599       def var v-fillin_height  as integer   no-undo .
      600       def var v-label          as character no-undo .
      601       def var v-user-can-edit  as logical   no-undo .
      602       def var v-output-display as logical   no-undo .
      603       def var v-other          as character no-undo .
      604       run lineattr-code in this-procedure
      605         (input  p-code
      606         ,output v-type
      607         ,output v-format
      608         ,output v-fillin_width
      609         ,output v-fillin_height
      610         ,output v-label
      611         ,output v-user-can-edit
      612         ,output v-output-display
      613         ,output v-other
      614         ) no-error .
      615       if error-status :error then do:
      616         undo, return error return-value .
      617       end.
      618       find first buf_doc-line-attr exclusive-lock
      619         where buf_doc-line-attr.doc-code  = p-doc-code
      620           and buf_doc-line-attr.gds-code  = p-gds-code
      621           and buf_doc-line-attr.attr-code = p-code
      622         no-error .
      623       if not available buf_doc-line-attr then do:
      624         create buf_doc-line-attr .
      625         assign
      626           buf_doc-line-attr.doc-code  = p-doc-code
      627           buf_doc-line-attr.gds-code = p-gds-code
      628           buf_doc-line-attr.attr-code = p-code
      629         .
      630       end.
      631       assign
      632         buf_doc-line-attr.attr-value = p-value
      633       .
      634        release buf_doc-line-attr.
      635     end.
      636   end procedure.
