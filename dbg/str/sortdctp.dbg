        1   block-level on error undo, throw.
        2   DEFINE INPUT-OUTPUT PARAMETER prid-list as character no-undo.
        3   define input parameter p-del-docs as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: sortdctp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/sortdctp.p $":U .
        9   define variable vss-description as character no-undo init "Сортировка recid документов в порядке знаков количеств ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define   temp-table doc-list no-undo
       81   field doc-date   like ub.trn-doc.doc-date
       82   field doc-code   like ub.trn-doc.doc-code
       83   field obj-type   like ub.trn-doc.obj-type
       84   field obj-code   like ub.trn-doc.obj-code
       85   field fact-num   like ub.trn-doc.fact-num
       86   field fact-date  like ub.trn-doc.fact-date
       87   field shift-date like ub.trn-doc.shift-date
       88   field shift-num  like ub.trn-doc.shift-num
       89   field shift-name like ub.trn-doc.shift-name
       90   field fact-order as decimal
       91   field is-trn-doc as logical
       92   field is-del as logical
       93   field doc-type   like ub.trn-doc.doc-type
       94   field ext-doc-type   like ub.trn-doc.ext-doc-type
       95   field sel-order  as integer
       96   field znak       as integer
       97   field to-del     as logical
       98   field is-archive-exist as logical
       99   index xpk is primary unique doc-code doc-type
      100   index xfact fact-num
      101   index xfact-date fact-date
      102   index sel-order sel-order
      103   index znak-order znak sel-order
      104   index isdel is-del
      105   .
      106   define buffer inkas_trn-doc for ub.trn-doc .
      107   define buffer c-inkas_trn-doc for ub.c-trn-doc .
      108   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   define    temp-table doc-list-hist no-undo
      110   field list-table as character
      111   field id as integer
      112   field line as integer
      113   field hist-mode as character
      114   field des as character
      115   field num-recs as integer
      116   field option_ as character
      117   field item_ as character
      118   field status_ as character
      119   field num-add as integer
      120   field num-ignored as integer
      121   field done as logical
      122   field err_ as logical
      123   field err-mes as character
      124   index pi is primary
      125   id
      126   line
      127   index isdone
      128   done
      129   .
      130   DEFINE VARIABLE ii as integer no-undo.
      131   case p-del-docs:
      132     when no then do:
      133   DO ii = 1 to num-entries(prid-list):
      134     FIND FIRST ub.trn-doc No-LOCK WHERE
      135                recid(ub.trn-doc) = integer(entry(ii, prid-list)) No-ERROR.
      136     if not avail ub.trn-doc then NEXT.
      137     create doc-list.
      138     assign
      139     doc-list.sel-order = ii
      140     doc-list.doc-code = string(recid(ub.trn-doc))
      141     doc-list.znak = if can-do ('рас,спи':U, ub.trn-doc.doc-type) then -1 else 1
      142     .
      143   END.
      144     end.
      145     when yes then do:
      146       DO ii = 1 to num-entries(prid-list):
      147         FIND FIRST ub.c-trn-doc No-LOCK WHERE
      148                   recid(ub.c-trn-doc) = integer(entry(ii, prid-list)) No-ERROR.
      149         if not avail ub.c-trn-doc then NEXT.
      150         create doc-list.
      151         assign
      152         doc-list.sel-order = ii
      153         doc-list.doc-code = string(recid(ub.c-trn-doc))
      154         doc-list.znak = if can-do ('рас,спи':U, ub.c-trn-doc.doc-type) then -1 else 1
      155         .
      156       END.
      157     end.
      158   end case.
      159   prid-list = "".
      160   FOR EACH doc-list use-index xpk:
      161     assign
      162     prid-list = prid-list + (if prid-list = "" then "" else chr(44)) +
      163                 doc-list.doc-code.
      164   end.
