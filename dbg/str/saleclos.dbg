     7328                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     7329                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     7330                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7331                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7332                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7333                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7334                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7335                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7336                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7337                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7338                         .
     7339         end.
     7340         ASSIGN
     7341           road-tax-base-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7342           road-tax-rubl-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7343           transport-base-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7344           transport-rubl-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7345           other-base-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7346           other-rubl-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     7347                                           vat-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     7348           slt-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     7349                   vat-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     7350           slt-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     7351           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     7352           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     7353         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     7354         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     7355         if transport-base-loc = ? then transport-base-loc = 0.
     7356         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     7357         if other-base-loc     = ? then other-base-loc     = 0.
     7358         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     7359         assign
     7360           transport-cli-loc      = 0
     7361           other-cli-loc          = 0
     7362           road-tax-cli-loc       = ?
     7363           vat-cli-loc            = ?
     7364           slt-cli-loc            = ?
     7365           price-cli-with-tax-loc = ?.
     7366      end.
     7367   ASSIGN
     7368             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7369       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7370   .
     7371           assign
     7372           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U then road-tax-rubl-loc else road-tax-base-loc).
     7373         end.
     7374         if rz then do:
     7375           if b-trn-doc.print-rubl
     7376           then assign
     7377             loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     7378             loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     7379             loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     7380                                      then 0
     7381                                      else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     7382           else
     7383           assign
     7384           loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     7385           loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     7386           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     7387                                    then 0
     7388                                    else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base ).
     7389         end.
     7390       end.
     7391       if chg-qnty = res-qnty
     7392       then parts-ok = yes.
     7393       else parts-ok = no.
     7394       release loc-gds-dtl.
     7395       if no-partion-qnty = 0 then return.
     7396     end.
     7397     if not cashparts or no-partion-qnty <> 0 or NOT cashplace OR no-place-qnty <> 0 then do:
     7398     if cashplace then no-partion-qnty = no-place-qnty.
     7399     _gdsdtl:
     7400     FOR EACH loc-gds-dtl WHERE
     7401             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     7402             loc-gds-dtl.artic = b-doc-line.artic AND
     7403             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     7404             loc-gds-dtl.prod-code = b-doc-line.prod-code
     7405             EXCLUSIVE-LOCK ON ERROR UNDO, NEXT:
     7406       IF rz AND loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then NEXT.
     7407       IF not rz AND loc-gds-dtl.doc-qnty = 0 AND v-is-own then NEXT.
     7408       IF NOT (rgds-dtl = ?) then do:
     7409         if NOT recid(loc-gds-dtl) = rgds-dtl THEN NEXT.
     7410         assign
     7411         r-prt-code = loc-gds-dtl.prt-code.
     7412       end.
     7413   if ( num_rec modulo 10 ) = 0 then
     7414   run write-counter in p-log-handle (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res)).
     7415       assign
     7416       res-qnty = if cashparts
     7417                   then (if rz
     7418                         then no-partion-qnty
     7419                         else (if r-qnty = ?
     7420                               then (- loc-gds-dtl.doc-qnty)
     7421                               else no-partion-qnty)
     7422                         )
     7423                   else (if rz
     7424                         then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     7425                         else (if r-qnty = ?
     7426                               then (- loc-gds-dtl.doc-qnty)
     7427                               else r-qnty
     7428                               )
     7429                         )
     7430       chg-qnty = res-qnty
     7431       cost-base = 0
     7432       cost-rubl = 0 .
     7433       if not v-is-own and rz then do:
     7434         find first buf_tt0-gds-dtl no-lock where
     7435                   buf_tt0-gds-dtl.artic     = loc-gds-dtl.artic
     7436               AND buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     7437               AND buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     7438               AND buf_tt0-gds-dtl.prt-code = loc-gds-dtl.prt-code no-error .
     7439         if available buf_tt0-gds-dtl then do:
     7440           assign
     7441           chg-qnty = chg-qnty - buf_tt0-gds-dtl.doc-qnty.
     7442         end.
     7443       end.
     7444       if not v-is-own and not rz and chg-qnty = 0 then
     7445       assign
     7446       v-to-reserv = no
     7447       .
     7448       if not v-is-own
     7449       and rz
     7450       and (available buf_tt0-gds-dtl and (buf_tt0-gds-dtl.doc-qnty + loc-gds-dtl.doc-qnty) = loc-gds-dtl.fact-qnty)
     7451       then
     7452       assign
     7453       v-to-reserv = no
     7454       .
     7455       if p-auto-fbr-on
     7456       then do :
     7457         find first goods no-lock where goods.artic = loc-gds-dtl.artic
     7458                                    and goods.prod-type = loc-gds-dtl.prod-type
     7459                                    and goods.prod-code = loc-gds-dtl.prod-code
     7460                                    .
     7461         if b-trn-doc.ext-doc-type =  'rs':U
     7462         then do :
     7463           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = replace(loc-gds-dtl.doc-code, "=", "-")
     7464                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     7465                                                no-error .
     7466           if available buf_doc-fbr-gds
     7467           then do :
     7468             if buf_doc-fbr-gds.fact-qnty > 0
     7469             then do :
     7470               assign
     7471                 v-to-reserv = no
     7472               .
     7473             end.
     7474             else do :
     7475               chg-qnty = if res-qnty >= 0 then abs(buf_doc-fbr-gds.fact-qnty) else buf_doc-fbr-gds.fact-qnty.
     7476             end.
     7477           end.
     7478         end.
     7479         if b-trn-doc.ext-doc-type =  'es':U
     7480         then do :
     7481           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = loc-gds-dtl.doc-code
     7482                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     7483                                                no-error .
     7484           if available buf_doc-fbr-gds
     7485           then do :
     7486             if buf_doc-fbr-gds.fact-qnty >= 0
     7487             then do :
     7488               chg-qnty = if res-qnty >= 0 then buf_doc-fbr-gds.fact-qnty else - buf_doc-fbr-gds.fact-qnty .
     7489             end.
     7490             else do :
     7491               assign
     7492                 v-to-reserv = no
     7493               .
     7494             end.
     7495           end.
     7496         end.
     7497       end.
     7498       if v-to-reserv and chg-qnty <> 0 then do:
     7499         if b-trn-doc.status_ = 'нередакт':U
     7500         or b-trn-doc.flag <> no
     7501         then do:
     7502           assign
     7503           v-return-status =  b-trn-doc.status_
     7504           v-return-flag = b-trn-doc.flag
     7505           b-trn-doc.status_ = 'накл':U
     7506           b-trn-doc.flag = no
     7507           v-return-st-fl = yes
     7508           .
     7509         end.
     7510         if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     7511         then do :
     7512           if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     7513         end.
     7514         run trg/rsrv-dtl.p (
     7515                          input parparentproc
     7516                         ,input rsrv-option
     7517                         ,buffer loc-gds-dtl
     7518                         ,input-output chg-qnty
     7519                         ,input-output cost-base
     7520                         ,input-output cost-rubl
     7521                         , -1
     7522                         , "" ) no-error.
     7523         if error-status:error then  do:
     7524   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input return-value                                       ).
     7525           v-return-st-fl = no.
     7526           undo _gdsdtl, NEXT.
     7527         end.
     7528       if v-return-st-fl then do:
     7529         assign
     7530         b-trn-doc.status_ = v-return-status
     7531         b-trn-doc.flag = v-return-flag
     7532         v-return-st-fl = no
     7533         .
     7534       end.
     7535   if chg-qnty <> res-qnty and not available buf_doc-fbr-gds then do:
     7536       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input return-value                                       ).
     7537   end.
     7538         if cashfbr then do:
     7539           assign
     7540           fbr-qnty = chg-qnty
     7541           .
     7542           _fbr:
     7543           for each loc-doc-fbr-gds where
     7544                   loc-doc-fbr-gds.gds-code = gdscode:
     7545             assign
     7546             fbr-chg-qnty = min(loc-doc-fbr-gds.fact-qnty - loc-doc-fbr-gds.doc-qnty, fbr-qnty)
     7547             fbr-qnty = fbr-qnty - fbr-chg-qnty
     7548             loc-doc-fbr-gds.doc-qnty = loc-doc-fbr-gds.doc-qnty + fbr-chg-qnty
     7549             .
     7550             if fbr-qnty = 0 then do:
     7551                 leave _fbR.
     7552             end.
     7553           end.
     7554         end.
     7555         assign
     7556         loc-gds-dtl.doc-qnty = loc-gds-dtl.doc-qnty + chg-qnty
     7557         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
     7558         buf_sale-doc.doc-qnty = buf_sale-doc.doc-qnty  + chg-qnty
     7559         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     7560         .
     7561         if available buf_doc-fbr-gds
     7562         then do :
     7563           if rz then do :
     7564             if buf_doc-fbr-gds.fact-qnty > 0
     7565             then do :
     7566               if loc-gds-dtl.doc-qnty = buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     7567             end.
     7568             else
     7569             if buf_doc-fbr-gds.fact-qnty < 0
     7570             then do :
     7571               if loc-gds-dtl.doc-qnty = - buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     7572             end.
     7573             else do :
     7574               if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     7575             end.
     7576           end.
     7577           else do :
     7578             if loc-gds-dtl.doc-qnty = 0 then assign num_rec_res = num_rec_res + 1 .
     7579           end.
     7580         end.
     7581         else do :
