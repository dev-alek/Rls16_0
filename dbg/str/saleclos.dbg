     2200   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2201   FUNCTION set-inkas-PS returns character(    input p-ps as character,
     2202                                               input p-chk-amount as integer,
     2203                                               input p-gds-amount as integer,
     2204                                               input p-line-out as integer,
     2205                                               input p-dtl-out as integer,
     2206                                               input p-line-ret as integer,
     2207                                               input p-dtl-ret as integer,
     2208                                               input p-nf-chk-amount as integer,
     2209                                               input p-nf-gds-amount as integer,
     2210                                               input p-ps-where-rus as character
     2211                                               ):
     2212   define variable v-ps as character no-undo .
     2213   define variable v-other as character no-undo .
     2214   v-other = p-ps.
     2215   entry(1, v-other, "@") = ''.
     2216   v-other = trim(v-other, "@").
     2217   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
     2218                       , chr(4)
     2219                       , p-chk-amount
     2220                       , p-gds-amount
     2221                       , p-line-out
     2222                       , p-dtl-out
     2223                       , p-line-ret
     2224                       , p-dtl-ret).
     2225   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
     2226                               , p-nf-chk-amount
     2227                               , chr(4)
     2228                               , p-nf-gds-amount
     2229                               , p-ps-where-rus
     2230                               , v-other)
     2231                       .
     2232   return v-ps.
     2233   END FUNCTION.
     2234   FUNCTION set-inkas-PS-simple returns character(
     2235                                               input p-chk-amount as integer,
     2236                                               input p-gds-amount as integer,
     2237                                               input p-line-out as integer,
     2238                                               input p-dtl-out as integer,
     2239                                               input p-line-ret as integer,
     2240                                               input p-dtl-ret as integer,
     2241                                               input p-nf-chk-amount as integer,
     2242                                               input p-nf-gds-amount as integer
     2243                                               ):
     2244   define variable v-ps as character no-undo .
     2245   define variable v-str1 as character no-undo .
     2246   assign
     2247     v-ps = fill( chr(32) +  chr(4), 9).
     2248     v-str1 = ENTRY(1, v-PS, chr(4)).
     2249     entry(2, v-str1, chr(32))  = string(p-chk-amount).
     2250     ENTRY(1, v-PS, chr(4)) = v-str1.
     2251     v-str1 = ENTRY(2, v-PS, chr(4)).
     2252     entry(2, v-str1, chr(32))  = string(p-gds-amount).
     2253     ENTRY(2, v-PS, chr(4)) = v-str1.
     2254     v-str1 = ENTRY(3, v-PS, chr(4)).
     2255     entry(2, v-str1, chr(32))  = string(p-line-out).
     2256     ENTRY(3, v-PS, chr(4)) = v-str1.
     2257     v-str1 = ENTRY(4, v-PS, chr(4)).
     2258     entry(2, v-str1, chr(32))  = string(p-dtl-out).
     2259     ENTRY(4, v-PS, chr(4)) = v-str1.
     2260     v-str1 = ENTRY(5, v-PS, chr(4)).
     2261     entry(2, v-str1, chr(32))  = string(p-line-ret).
     2262     ENTRY(5, v-PS, chr(4)) = v-str1.
     2263     v-str1 = ENTRY(6, v-PS, chr(4)).
     2264     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
     2265     ENTRY(5, v-PS, chr(4)) = v-str1.
     2266     v-str1 = ENTRY(7, v-PS, chr(4)).
     2267     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
     2268     ENTRY(5, v-PS, chr(4)) = v-str1.
     2269     v-str1 = ENTRY(8, v-PS, chr(4)).
     2270     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
     2271     ENTRY(5, v-PS, chr(4)) = v-str1.
     2272   return v-ps.
     2273   END FUNCTION.
     2274   FUNCTION get-inkas-nf-PS-simple returns logical (
     2275                                                input p-ps as character
     2276                                               ,output p-gds-amount as integer
     2277                                               ,output p-nf-gds-amount as integer
     2278                                               ):
     2279   if num-entries(p-ps, chr(4)) >= 8 then do:
     2280     assign
     2281     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
     2282     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
     2283     no-error .
     2284   end.
     2285   return not error-status:error .
     2286   END FUNCTION.
     2287   PROCEDURE get-inkas-PS:
     2288   define parameter buffer buf_inkas for ub.inkas.
     2289   define output parameter p-chk-amount as integer no-undo .
     2290   define output parameter p-gds-amount as integer no-undo .
     2291   define output parameter p-line-out as integer no-undo .
     2292   define output parameter p-dtl-out as integer no-undo .
     2293   define output parameter p-line-ret as integer no-undo .
     2294   define output parameter p-dtl-ret as integer no-undo .
     2295   define output parameter p-nf-chk-amount as integer no-undo .
     2296   define output parameter p-nf-gds-amount as integer no-undo .
     2297   define output parameter p-ps-where-rus as character no-undo .
     2298   define variable v-gds-amount as integer no-undo .
     2299   define variable v-nf-gds-amount as integer no-undo .
     2300   define buffer buf_sale-doc for ub.sale-doc.
     2301   for each buf_sale-doc no-lock where
     2302           buf_sale-doc.inkas-code = buf_inkas.inkas-code
     2303       and buf_sale-doc.order > 0:
     2304     assign
     2305     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
     2306                                    or buf_sale-doc.doc-kind = 'trf':U
     2307                                    then buf_sale-doc.gds-amount
     2308                                    else 0)
     2309     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
     2310                                 and buf_sale-doc.dir = 1
     2311                                 then buf_sale-doc.tot-lines
     2312                                 else 0)
     2313     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
     2314                             and buf_sale-doc.dir = 1
     2315                             then buf_sale-doc.tot-dtl
     2316                             else 0)
     2317     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
     2318                                 and buf_sale-doc.dir = -1
     2319                                 then buf_sale-doc.tot-lines
     2320                                 else 0)
     2321     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
     2322                              and buf_sale-doc.dir = -1
     2323                             then buf_sale-doc.tot-dtl
     2324                             else 0)
     2325     .
     2326   end.
     2327   if get-inkas-nf-PS-simple( input buf_inkas.ps
     2328                             ,output v-gds-amount
     2329                             ,output v-nf-gds-amount) then do:
     2330     assign
     2331     p-gds-amount = v-gds-amount
     2332     p-nf-gds-amount = v-nf-gds-amount
     2333     .
     2334   end.
     2335   assign
     2336   p-ps-where-rus = buf_inkas.sale-filter-rus
     2337   p-nf-chk-amount = buf_inkas.num-chk-nf
     2338   p-chk-amount = buf_inkas.num-chk
     2339   .
     2340   END PROCEDURE.
     2341   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2342   define SHARED temp-table tt0-info no-undo
     2343   field doc-code   like ub.trn-doc.doc-code
     2344   field artic      like ub.doc-line.artic
     2345   field prod-type  like ub.doc-line.prod-type
     2346   field prod-code  like ub.doc-line.prod-code
     2347   field prt-code  like ub.gds-dtl.prt-code
     2348   field obj-type   like ub.doc-line.obj-type
     2349   field obj-code   like ub.doc-line.obj-code
     2350   field error-message as character
     2351   field a-to-res as decimal
     2352   field was-res as decimal
     2353   field to-res as decimal
     2354   field is-res as decimal
     2355   field o-was-res as decimal
     2356   field o-to-res as decimal
     2357   field o-is-res as decimal
     2358   index pi is unique primary
     2359   obj-type
     2360   obj-code
     2361   artic
     2362   prod-type
     2363   prod-code
     2364   index iartic
     2365   artic
     2366   prod-type
     2367   prod-code
     2368   .
     2369   define SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
     2370   define SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     2371   define SHARED temp-table tt0-parts    no-undo like ub.parts.
     2372   define SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
     2373   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     2374   define variable v-ps as character no-undo .
     2375   assign
     2376   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     2377                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     2378                     , buf_sale-doc.out-code
     2379                     , buf_sale-doc.obj-type
     2380                     , buf_sale-doc.obj-code
     2381                     , chr(4)
     2382                     , buf_sale-doc.tot-lines
     2383                     , buf_sale-doc.tot-dtl
     2384                     ).
     2385   return v-Ps.
     2386   END FUNCTION.
     2387   procedure create-tt0-doc-line-gds-dtl :
     2388   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     2389   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     2390   define input parameter p-ext-doc-type        as character no-undo .
     2391   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     2392   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     2393   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     2394   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     2395   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     2396   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     2397   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     2398   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     2399   define parameter buffer b-doc-line           for ub.doc-line.
     2400   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     2401   define parameter buffer buf_sale-doc for ub.sale-doc.
     2402   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     2403   define buffer other_doc-line for ub.doc-line.
     2404   define buffer other_gds-dtl for ub.gds-dtl.
     2405     do
     2406     on error undo, return error return-value
     2407     :
     2408       find first tt0-doc-line where
     2409                 tt0-doc-line.obj-type = p-proprietor-obj-type
     2410             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     2411             AND tt0-doc-line.prod-type = p-prod-type
     2412             AND tt0-doc-line.prod-code = p-prod-code
     2413             AND tt0-doc-line.artic     = p-artic
     2414             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     2415             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     2416       if not available tt0-doc-line then do:
     2417         create tt0-doc-line.
     2418         buffer-copy b-doc-line
     2419         except
     2420         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     2421         to tt0-doc-line
     2422         assign
     2423         tt0-doc-line.status_ = 'нередакт':U
     2424         tt0-doc-line.ext-doc-type = p-ext-doc-type
     2425         tt0-doc-line.obj-type = p-proprietor-obj-type
     2426         tt0-doc-line.obj-code = p-proprietor-obj-code
     2427         tt0-doc-line.doc-code = p-doc-code
     2428         .
     2429       end.
     2430       if p-doc-code <> "":U then do:
     2431         find first other_doc-line no-lock where
     2432                 other_doc-line.doc-code = p-doc-code
     2433             AND  other_doc-line.artic    = p-artic
     2434             AND  other_doc-line.prod-type = p-prod-type
     2435             AND  other_doc-line.prod-code = p-prod-code no-error .
     2436         if available other_doc-line then do:
     2437           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     2438           assign
     2439           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     2440           .
     2441         end.
     2442         else do:
     2443           assign
     2444           tt0-doc-line.doc-code = '':U
     2445           .
     2446         end.
     2447       end.
     2448       find first tt0-gds-dtl where
     2449               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     2450           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     2451           AND tt0-gds-dtl.prod-type = p-prod-type
     2452           AND tt0-gds-dtl.prod-code = p-prod-code
     2453           AND tt0-gds-dtl.artic     = p-artic
     2454           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     2455       if not available tt0-gds-dtl then do:
     2456         create tt0-gds-dtl.
     2457         buffer-copy b-gds-dtl
     2458         except
     2459         obj-type obj-code doc-code doc-qnty fact-qnty
     2460         to tt0-gds-dtl
     2461         assign
     2462         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     2463         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     2464         tt0-gds-dtl.doc-code = p-doc-code
     2465         .
     2466       end.
     2467       if p-doc-code <> "":U then do:
     2468           find first other_gds-dtl no-lock where
     2469                   other_gds-dtl.doc-code = p-doc-code
     2470               AND  other_gds-dtl.artic    = p-artic
     2471               AND  other_gds-dtl.prod-type    = p-prod-type
     2472               AND  other_gds-dtl.prod-code    = p-prod-code
     2473               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     2474           if available other_gds-dtl then do:
     2475             assign
     2476             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     2477             .
     2478           end.
     2479           else do:
     2480             assign
     2481             tt0-gds-dtl.doc-code = '':U
     2482             .
     2483           end.
     2484       end.
     2485       assign
     2486       old-qnty = tt0-gds-dtl.doc-qnty
     2487       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     2488       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     2489       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     2490       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     2491       .
     2492     end.
     2493   end procedure.
     2494   procedure fill-tt-tpsi-table :
     2495   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     2496   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     2497   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     2498   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     2499   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     2500   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     2501   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     2502   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     2503   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     2504   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     2505   define buffer buf_goods for ub.goods.
     2506   define buffer buf_doc-line for ub.doc-line.
     2507   define buffer buf_gds-dtl for ub.gds-dtl.
     2508   define buffer buf_sale-doc for ub.sale-doc.
     2509     do
     2510     on error undo, return error
     2511     :
     2512       _doc-line:
     2513       for each buf_Doc-line no-lock where
     2514             buf_doc-line.doc-code = p-doc-code,
     2515         first buf_goods no-lock where
     2516             buf_goods.artic = buf_doc-line.artic
     2517        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     2518        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     2519           each buf_gds-dtl no-lock where
     2520             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     2521         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     2522         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2523         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     2524         assign
     2525         v-ext-doc-type = "":U.
     2526         run tpsi-preselect-gds-proprietor in this-procedure (
     2527                                                     input buf_goods.gds-code
     2528                                                   ,input g#db-num
     2529                                                   ,output v-proprietor-host-code
     2530                                                   ,output v-proprietor-obj-type
     2531                                                   ,output v-proprietor-obj-code ) no-error .
     2532         if v-proprietor-host-code = p-host-code then do:
     2533           assign
     2534           v-ext-doc-type = 'ev':U .
     2535         end.
     2536         else do:
     2537           assign
     2538           v-ext-doc-type =  'ee':U .
     2539         end.
     2540         if  (v-proprietor-obj-type = p-obj-type
     2541         AND v-proprietor-obj-code = p-obj-code)
     2542         OR (v-proprietor-obj-type = "":U
     2543         AND v-proprietor-obj-code = 0)
     2544         OR v-proprietor-obj-code = ?
     2545         then next _doc-line.
     2546         find first buf_sale-doc no-lock where
     2547                   buf_sale-doc.inkas-code = p-doc-code
     2548              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     2549              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     2550              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     2551              no-error .
     2552         run create-tt0-doc-line-gds-dtl  in this-procedure (
     2553                                                              input v-proprietor-obj-type
     2554                                                             ,input v-proprietor-obj-code
     2555                                                             ,input v-ext-doc-type
     2556                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     2557                                                             ,input buf_doc-line.artic
     2558                                                             ,input buf_Doc-line.prod-type
     2559                                                             ,input buf_doc-line.prod-code
     2560                                                             ,input buf_gds-dtl.prt-code
     2561                                                             ,input 0
     2562                                                             ,output v-was-gds-dtl-fact-qnty
     2563                                                             ,output v-gds-dtl-fact-qnty
     2564                                                             ,buffer buf_doc-line
     2565                                                             ,buffer buf_gds-dtl
     2566                                                             ,buffer buf_sale-doc
     2567                                                           ).
     2568       end.
     2569     end.
     2570   end procedure.
     2571   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2573   procedure get-alias-type-price-obj :
     2574   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     2575   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     2576   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     2577   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     2578   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     2579   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     2580   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     2581   define output parameter p-alias-type-price as character no-undo .
     2582   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     2583   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     2584   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     2585   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     2586   define variable v-mediat-objf               as character no-undo .
     2587   define variable v-param-type as character no-undo .
     2588   define variable v-value-character as character no-undo .
     2589   define variable v-value-date as date no-undo .
     2590   define variable v-value-decimal as decimal no-undo .
     2591   define variable v-value-integer as INTEGER no-undo .
     2592   define variable v-value-logical AS LOGICAL no-undo .
     2593   define variable v-tth as handle no-undo .
     2594   assign
     2595   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2596   define buffer buf_trn-doc for ub.trn-doc.
     2597     _main:
     2598     do
     2599     on error undo, return error return-value
     2600     :
     2601       run adm/shattri.p (
     2602         input "get":U
     2603         ,input  p-prop-obj-type
     2604         ,input  p-prop-obj-code
     2605         ,input  'alias-tpsi':U
     2606         ,input  '':U
     2607         ,output v-value-character
     2608         ,output v-value-date
     2609         ,output v-value-decimal
     2610         ,output v-value-integer
     2611         ,output v-value-logical
     2612         ,output v-param-type
     2613         ,INPUT-OUTPUT table-handle v-tth
     2614         ) no-error .
     2615       if error-status:error
     2616       then do:
     2617         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     2618                                 , p-prop-obj-type
     2619                                 , p-prop-obj-code).
     2620       end.
     2621       find first thbjattr_thbj-attr where
     2622                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     2623             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     2624             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     2625             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     2626       if not available thbjattr_thbj-attr
     2627       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     2628         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     2629                                 , p-prop-obj-type
     2630                                 , p-prop-obj-code).
     2631       end.
     2632       assign
     2633       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     2634       if p-prop-host-code = p-host-code
     2635       and (p-alias-type-price = '':U
     2636       or   p-alias-type-price <> '5':U)
     2637       then  do:
     2638         assign
     2639         p-ext-doc-type = 'ev':U
     2640         p-price-obj-type = p-obj-type
     2641         p-price-obj-code = p-obj-code
     2642         p-alias-type-price = '3':U
     2643         .
     2644       end.
     2645       else do:
     2646         if p-prop-host-code = p-host-code  then do:
     2647           assign
     2648           p-ext-doc-type = 'ev':U
     2649           p-price-obj-type = p-obj-type
     2650           p-price-obj-code = p-obj-code
     2651           .
     2652         end.
     2653         else do:
     2654           assign
     2655           p-ext-doc-type = 'ee':U.
     2656           assign
     2657           v-mediat-obj-type = "":U
     2658           v-mediat-obj-code = 0
     2659           v-mediat-objf = "":U
     2660           .
     2661           if p-alias-type-price = '4':U then do:
     2662             find first thbjattr_thbj-attr where
     2663                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     2664                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     2665                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     2666                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     2667             if not available thbjattr_thbj-attr
     2668             or thbjattr_thbj-attr.property-value-character = "":U then do:
     2669               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     2670                                       , p-prop-obj-type
     2671                                       , p-prop-obj-code).
     2672             end.
     2673             assign
     2674             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     2675             v-mediat-obj-type = entry(1, v-mediat-objf)
     2676             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     2677             no-error
     2678             .
     2679             if error-status:error then do:
     2680               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     2681                                       , p-prop-obj-type
     2682                                       , p-prop-obj-code).
     2683             end.
     2684           end.
     2685           CASE p-alias-type-price:
     2686             when '1':U then do:
     2687               assign
     2688               p-price-obj-type = p-prop-obj-type
     2689               p-price-obj-code = p-prop-obj-code
     2690               .
     2691             end.
     2692             when '2':U then do:
     2693               assign
     2694               p-price-obj-type = p-prop-obj-type
     2695               p-price-obj-code = p-prop-obj-code
     2696               .
     2697             end.
     2698             when '3':U
     2699             or
     2700             when '5':U
     2701             then do:
     2702               assign
     2703               p-price-obj-type = p-obj-type
     2704               p-price-obj-code = p-obj-code
     2705               .
     2706             end.
     2707             when '4':U then do:
     2708               assign
     2709               p-price-obj-type = v-mediat-obj-type
     2710               p-price-obj-code = v-mediat-obj-code
     2711               .
     2712             end.
     2713           END CASE.
     2714         end.
     2715       end.
     2716     end.
     2717   end procedure.
     2718   procedure write-tt0-info:
     2719   define input parameter p-artic as character no-undo .
     2720   define input parameter p-prod-type as character no-undo .
     2721   define input parameter p-prod-code as integer no-undo .
     2722   define input parameter p-prt-code as integer no-undo .
     2723   define input parameter p-obj-type as character no-undo .
     2724   define input parameter p-obj-code as integer no-undo .
     2725   define input parameter p-doc-code as character no-undo .
     2726   define input parameter p-from-tpsi as logical no-undo .
     2727   define input parameter p-all-qnty as decimal no-undo .
     2728   define input parameter p-was-res as decimal no-undo .
     2729   define input parameter p-to-res as decimal no-undo .
     2730   define input parameter p-is-res as decimal no-undo .
     2731   define input parameter p-o-was-res as decimal no-undo .
     2732   define input parameter p-o-to-res as decimal no-undo .
     2733   define input parameter p-o-is-res as decimal no-undo .
     2734   define input parameter p-mess   as character no-undo .
     2735   define buffer buf_tt0-info for tt0-info.
     2736     do
     2737     on error undo, return error return-value
     2738     :
     2739       find first buf_tt0-info where
     2740                buf_tt0-info.artic = p-artic
     2741            and buf_tt0-info.prod-type = p-prod-type
     2742            and buf_tt0-info.prod-code = p-prod-code
     2743            and buf_tt0-info.prt-code = p-prt-code
     2744            no-error .
     2745       if not available buf_tt0-info then do:
     2746         create buf_tt0-info.
     2747         assign
     2748         buf_tt0-info.artic = p-artic
     2749         buf_tt0-info.prod-type = p-prod-type
     2750         buf_tt0-info.prod-code = p-prod-code
     2751         buf_tt0-info.prt-code  = p-prt-code
     2752         buf_tt0-info.obj-type  = p-obj-type
     2753         buf_tt0-info.obj-code  = p-obj-code
     2754         buf_tt0-info.a-to-res  = ?
     2755         buf_tt0-info.to-res    = ?
     2756         buf_tt0-info.was-res   = ?
     2757         buf_tt0-info.o-was-res = ?
     2758         buf_tt0-info.o-to-res  = ?
     2759         buf_tt0-info.o-is-res  = ?
     2760         buf_tt0-info.is-res    = ?
     2761         .
     2762       end.
     2763       assign
     2764       buf_tt0-info.a-to-res  =
     2765                                 (if buf_tt0-info.a-to-res <> ?
     2766                                 and p-all-qnty = ?
     2767                                 then buf_tt0-info.a-to-res
     2768                                 else p-all-qnty)
     2769       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     2770                                 and p-was-res = ?
     2771                                 then buf_tt0-info.was-res
     2772                                 else p-was-res)
     2773       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     2774                                 and p-to-res = ?
     2775                                 then buf_tt0-info.to-res
     2776                                 else p-to-res)
     2777       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     2778                                 and p-is-res = ?
     2779                                 then buf_tt0-info.is-res
     2780                                 else p-is-res)
     2781       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     2782                                 and p-o-was-res = ?
     2783                                 then buf_tt0-info.o-was-res
     2784                                 else p-o-was-res)
     2785       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     2786                                 and p-o-to-res = ?
     2787                                 then buf_tt0-info.o-to-res
     2788                                 else p-o-to-res)
     2789       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     2790                                 and p-o-is-res = ?
     2791                                 then buf_tt0-info.o-is-res
     2792                                 else p-o-is-res)
     2793       .
     2794       assign
     2795       buf_tt0-info.doc-code  = p-doc-code
     2796       buf_tt0-info.error-message   = p-mess
     2797       .
     2798     end.
     2799   end procedure.
     2800   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2801   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     2802   define variable v-ps as character no-undo .
     2803   if available buf_sale-doc then
     2804   assign
     2805   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     2806                       , chr(4)
     2807                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     2808                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     2809                       , buf_sale-doc.chk-amount
     2810                       , buf_sale-doc.gds-amount
     2811                       , buf_sale-doc.tot-lines
     2812                       , buf_sale-doc.tot-dtl
     2813                       ).
     2814   else  do:
     2815   assign
     2816   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     2817                       , chr(4)
     2818                       , '':U
     2819                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     2820                       , 0
     2821                       , 0
     2822                       , 0
     2823                       , 0
     2824                       ).
     2825   end.
     2826   return v-ps.
     2827   END FUNCTION.
     2828   FUNCTION get-sale-doc-kind returns character (
     2829                                                input p-doc-kind as character
     2830                                              , input p-ext-doc-type as character
     2831                                              , output p-order as integer
     2832                                              , output p-msign as integer
     2833                                              , output p-main as logical
     2834                                              , output p-in-inkas as logical
     2835                                              , output p-dir_ as integer
     2836                                              ):
     2837   define variable v-doc-kind as character no-undo.
     2838   define variable v-type as character no-undo .
     2839   define variable v-value as character no-undo .
     2840   CASE p-doc-kind:
     2841     when 'es':U then do:
     2842       assign
     2843       p-order = 100
     2844       p-msign = 1
     2845       p-main = yes
     2846       p-in-inkas = yes
     2847       p-dir_ = 1
     2848       .
     2849       return p-ext-doc-type.
     2850     end.
     2851     when  'rs':U then do:
     2852       assign
     2853       p-order = 200
     2854       p-msign = - 1
     2855       p-main = no
     2856       p-in-inkas = yes
     2857       p-dir_ = - 1
     2858       .
     2859       return p-ext-doc-type.
     2860     end.
     2861     when 'rwo':U then do:
     2862       assign
     2863       p-msign = - 1
     2864       p-main = no
     2865       p-in-inkas = no
     2866       p-order = 300
     2867       p-dir_ = 1
     2868       .
     2869       return 'rwo':U.
     2870     end.
     2871     when 'trf':U then do:
     2872       assign
     2873       p-msign = 1
     2874       p-main = no
     2875       p-in-inkas = no
     2876       p-order = 400
     2877       p-dir_ = 1
     2878       .
     2879       return 'trf':U.
     2880     end.
     2881     when 'swo':U then do:
     2882      assign
     2883      p-msign = 1
     2884      p-main = no
     2885      p-in-inkas = no
     2886      p-order =  500
     2887      p-dir_ = 1
     2888      .
     2889      return 'swo':U.
     2890    end.
     2891    when 'vir':U then do:
     2892      assign
     2893      p-msign = 1
     2894      p-main = no
     2895      p-in-inkas = no
     2896      p-order = 600
     2897      p-dir_ = 1
     2898      .
     2899      return 'vir':U.
     2900    end.
     2901    when 'itr':U then do:
     2902      assign
     2903      p-msign = 1
     2904      p-main = no
     2905      p-in-inkas = no
     2906      p-order = -1
     2907      p-dir_ = -1
     2908      .
     2909     return 'itr':U.
     2910    end.
     2911    when 'ngs':U then do:
     2912      assign
     2913      p-msign = 1
     2914      p-main = no
     2915      p-in-inkas = no
     2916      p-order = 700
     2917      p-dir_ = 1
     2918      .
     2919      return 'ngs':U.
     2920    end.
     2921    when 'rgs':U then do:
     2922      assign
     2923      p-msign = -1
     2924      p-main = no
     2925      p-in-inkas = no
     2926      p-order = 701
     2927      p-dir_ = -1
     2928      .
     2929      return 'rgs':U.
     2930    end.
     2931    otherwise do:
     2932       assign
     2933       p-msign = 1
     2934       p-main = no
     2935       p-in-inkas = no
     2936       p-order = -1.
     2937       return p-ext-doc-type.
     2938     end.
     2939   END CASE.
     2940   END FUNCTION.
     2941   procedure saledoc-create :
     2942   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     2943   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     2944   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     2945   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     2946   define input parameter p-doc-kind as character no-undo .
     2947   define input parameter p-office as character no-undo .
     2948   define input parameter p-tpsidoc as logical no-undo .
     2949   define input parameter p-alias-type-price as character no-undo .
     2950   define input parameter p-price-obj-type as character no-undo .
     2951   define input parameter p-price-obj-code as integer no-undo .
     2952   define parameter buffer buf_trn-doc for ub.trn-doc.
     2953   define variable v-order as integer no-undo.
     2954   define variable v-main as logical no-undo .
     2955   define variable v-in-inkas as logical no-undo .
     2956   define variable v-msign as integer no-undo .
     2957   define variable v-dir_ as integer no-undo .
     2958   define variable v-trn-doc-code as character no-undo .
     2959   define buffer buf_sale-doc for ub.sale-doc.
     2960   main-block:
     2961   do
     2962   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2963   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2964   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2965   :
     2966      if available buf_trn-doc then do:
     2967        v-trn-doc-code = buf_trn-doc.doc-code.
     2968      end.
     2969      find first buf_sale-doc where
     2970               buf_sale-doc.inkas-code = p-inkas-code
     2971           and buf_sale-doc.doc-kind = p-doc-kind
     2972           and buf_sale-doc.chr-office = p-office
     2973           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     2974           no-error .
     2975      if not available buf_sale-doc  then do:
     2976         create buf_sale-doc.
     2977         assign
     2978         buf_sale-doc.inkas-code = p-inkas-code
     2979         buf_sale-doc.storage =  'trn-doc':U
     2980         buf_sale-doc.host-code = p-host-code
     2981         buf_sale-doc.obj-type = p-obj-type
     2982         buf_sale-doc.obj-code = p-obj-code
     2983         buf_sale-doc.doc-kind  = p-doc-kind
     2984         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     2985         buf_sale-doc.chr-office = p-office
     2986         buf_sale-doc.doc-code = v-trn-doc-code
     2987         .
     2988      end.
     2989      if available buf_trn-doc then
     2990      buffer-copy buf_trn-doc
     2991      to buf_sale-doc
     2992      .
     2993     assign
     2994     buf_sale-doc.doc-kind = get-sale-doc-kind (
     2995                                                input p-doc-kind
     2996                                               ,input buf_sale-doc.ext-doc-type
     2997                                               ,output v-order
     2998                                               ,output v-msign
     2999                                               ,output v-main
     3000                                               ,output v-in-inkas
     3001                                               ,output v-dir_).
     3002     assign
     3003     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     3004     buf_sale-doc.main-doc = v-main
     3005     buf_sale-doc.in-inkas = v-in-inkas
     3006     buf_sale-doc.msign = v-msign
     3007     buf_sale-doc.dir = v-dir_
     3008     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     3009     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     3010     buf_sale-doc.poss-wro-codes = '':U
     3011     buf_sale-doc.chr-office = p-office
     3012     buf_sale-doc.tpsidoc = p-tpsidoc
     3013     buf_sale-doc.alias-type-price = p-alias-type-price
     3014     buf_sale-doc.price-obj-type = (if p-tpsidoc
     3015                                    then p-price-obj-type
     3016                                    else '':U)
     3017     buf_sale-doc.price-obj-code = (if p-tpsidoc
     3018                                    then p-price-obj-code
     3019                                    else 0)
     3020     .
     3021     assign
     3022     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     3023     no-error.
     3024   end.
     3025   END.
     3026   procedure fbr-saledoc-create :
     3027   define input parameter p-inkas-code as character no-undo .
     3028   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     3029   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     3030   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     3031   define buffer buf_fbr-doc for ub.fbr-doc.
     3032   define buffer buf_trn-doc for ub.trn-doc.
     3033   define buffer buf_sale-doc for ub.sale-doc.
     3034   define buffer buf2_sale-doc for ub.sale-doc.
     3035   define buffer buf2_trn-doc for ub.trn-doc.
     3036   define buffer buf_doc-line for ub.doc-line.
     3037   define buffer buf_gds-dtl for ub.gds-dtl.
     3038   define buffer buf_chk-gds for ub.chk-gds.
     3039   define buffer buf_chk-doc for ub.chk-doc.
     3040   do
     3041   on error undo, return error
     3042   :
     3043     for each buf_fbr-doc no-lock where
     3044           buf_fbr-doc.out-code = p-inkas-code:
     3045       for each buf_trn-doc no-lock where
     3046             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     3047       by buf_trn-doc.fact-order
     3048       on error undo, return error:
     3049         if buf_trn-doc.ext-doc-type = 'em':U
     3050         or buf_trn-doc.ext-doc-type = 'im':U
     3051         or buf_trn-doc.ext-doc-type = 'wm':U
     3052         or buf_trn-doc.ext-doc-type = 'ev':U
     3053         or buf_trn-doc.ext-doc-type = 'iv':U
     3054         then do:
     3055           find first buf_sale-doc where
     3056                   buf_sale-doc.inkas-code = p-inkas-code
     3057               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     3058               AND buf_sale-doc.storage  = 'trn-doc':U
     3059                   no-error .
     3060           if not available buf_sale-doc then do:
     3061           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     3062           end.
     3063           if buf_trn-doc.ext-doc-type = 'im':U then do:
     3064             assign
     3065             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     3066             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     3067             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     3068             .
     3069           end.
     3070           for each buf2_trn-doc no-lock where
     3071                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     3072             find first buf2_sale-doc where
     3073                     buf2_sale-doc.inkas-code = p-inkas-code
     3074                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     3075                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     3076             if not available buf2_sale-doc then do:
     3077               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     3078             end.
     3079           end.
     3080         end.
     3081       end.
     3082       find first buf_sale-doc where
     3083                 buf_sale-doc.inkas-code = p-inkas-code
     3084             AND buf_sale-doc.storage = 'fbr-doc':U
     3085             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     3086       if not available buf_sale-doc then do:
     3087         create buf_sale-doc.
     3088         assign
     3089         buf_sale-doc.storage       =  'fbr-doc':U
     3090         buf_sale-doc.doc-type      = 'производство':U
     3091         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     3092         buf_sale-doc.ext-doc-type  = 'производство':U
     3093         buf_sale-doc.doc-kind      = 'производство':U
     3094         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     3095         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     3096         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     3097         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     3098         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     3099         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     3100         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     3101         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     3102         buf_sale-doc.fbrsale       = yes
     3103         buf_sale-doc.inkas-code    = p-inkas-code
     3104         .
     3105       end.
     3106     end.
     3107   end.
     3108   end procedure.
     3109   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3110   procedure gdsoattr-name :
     3111     define input  parameter p-code           as character no-undo .
     3112     define output parameter p-type           as character no-undo .
     3113     define output parameter p-format         as character no-undo .
     3114     define output parameter p-label          as character no-undo .
     3115     define output parameter p-user-can-edit  as logical   no-undo .
     3116     define output parameter p-output-display as logical   no-undo .
     3117     define output parameter p-other          as character no-undo .
     3118     do
     3119     on error undo, return error
     3120     :
     3121           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     3122         (input  p-code
     3123         ,output p-type
     3124         ,output p-format
     3125         ,output p-label
     3126         ,output p-user-can-edit
     3127         ,output p-output-display
     3128         ,output p-other
     3129         ) no-error .
     3130       if error-status :error
     3131       then do:
     3132         undo, return error return-value .
     3133       end.
     3134     end.
     3135   end.
     3136   procedure gdsoattr-tooltip :
     3137     define input  parameter p-code    as character no-undo .
     3138     define output parameter p-tooltip as character no-undo .
     3139     define output parameter p-label   as character no-undo .
     3140     do
