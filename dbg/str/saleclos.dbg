     8282   define variable v-value-character as character no-undo .
     8283   define variable v-value-date as date no-undo .
     8284   define variable v-value-decimal as decimal no-undo .
     8285   define variable v-value-integer as INTEGER no-undo .
     8286   define variable v-value-logical AS LOGICAL no-undo .
     8287   define variable v-param-type as character no-undo .
     8288   define variable v-found as decimal no-undo.
