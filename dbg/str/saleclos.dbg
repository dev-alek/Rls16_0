      738   function cross-list returns logical (
      739     input parfirst-stream  as character,
      740     input parsecond-stream as character,
      741     input pardelim         as character).
      742     if pardelim = ""
      743     or pardelim = ?
      744     then do:
      745       assign
      746         pardelim = ","
      747       .
      748     end.
      749     define variable vari            as integer no-undo .
      750     define variable varresult-cross as logical no-undo .
      751     assign
      752       varresult-cross = no
      753     .
      754     def var v-num-parfirst-stream as integer no-undo .
      755     assign
      756       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      757     .
      758     do vari = 1 to v-num-parfirst-stream
      759     :
      760       if lookup(entry(vari, parfirst-stream, pardelim)
      761                ,parsecond-stream
      762                ,pardelim
      763                ) > 0 then do:
      764         assign
      765           varresult-cross = yes
      766         .
      767         leave.
      768       end.
      769     end.
      770     return varresult-cross .
      771   end function.
      772   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      773   function octal-to-char return character
      774   ( p-string as character ) :
      775     def var v-asc     as integer no-undo .
      776     def var v-new-asc as integer no-undo .
      777     def var ind       as integer no-undo .
      778     if length(p-string) <> 3 then do:
      779       return ? .
      780     end.
      781     assign
      782       v-asc = 0
      783     .
      784     do ind = 1 to length(p-string)
      785     :
      786       assign
      787         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      788       .
      789       if v-new-asc < 0 or v-new-asc >= 8 then do:
      790         return ? .
      791       end.
      792       assign
      793         v-asc = v-asc * 8 + v-new-asc
      794       .
      795     end.
      796     return chr(v-asc) .
      797   end function .
      798   function char-to-octal return character
      799   ( p-chr as character ) :
      800     def var v-asc    as integer   no-undo .
      801     def var ind      as integer   no-undo .
      802     def var v-string as character no-undo .
      803     if length(p-chr) <> 1 then do:
      804       return ? .
      805     end.
      806     assign
      807       v-asc    = asc(p-chr)
      808       v-string = ""
      809     .
      810     do ind = 1 to 3
      811     :
      812       assign
      813         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      814       .
      815       assign
      816         v-asc = truncate(v-asc / 8, 0)
      817       .
      818     end.
      819     return v-string .
      820   end.
      821   function str-encode return character
      822   (   p-init-string       as character
      823     , p-encode-char       as character
      824     , p-special-char-list as character
      825   ) :
      826     def var p-encode-string as character no-undo .
      827     def var ind                as integer no-undo .
      828     def var v-num-special-char as integer no-undo .
      829     def var v-special-char     as character no-undo .
      830     if p-encode-char = ?
      831     or p-encode-char = "" then do:
      832       assign
      833         p-encode-char = "~~"
      834       .
      835     end.
      836     if p-init-string = ? then do:
      837       return "?" .
      838     end.
      839     if p-init-string = "?" then do:
      840       return p-encode-char + char-to-octal("?") .
      841     end.
      842     assign
      843       v-num-special-char = length(p-special-char-list)
      844       p-encode-string    = replace(p-init-string
      845                                   ,p-encode-char
      846                                   ,p-encode-char + char-to-octal(p-encode-char)
      847                                   )
      848     .
      849     do ind = 1 to v-num-special-char
      850     :
      851       assign
      852         v-special-char = substring(p-special-char-list, ind, 1)
      853       .
      854       if v-special-char <> p-encode-char then do:
      855         assign
      856           p-encode-string = replace (p-encode-string
      857                                     ,v-special-char
      858                                     ,p-encode-char + char-to-octal(v-special-char)
      859                                     )
      860         .
      861       end.
      862     end.
      863     return p-encode-string .
      864   end.
      865   function str-decode returns character
      866     (p-init-string   as character
      867     ,p-encode-char   as character
      868     ) :
      869     def var p-decode-string as character no-undo .
      870     def var ind                       as integer no-undo .
      871     def var v-num-entries-init-string as integer no-undo .
      872     def var v-sub-phrase              as character no-undo .
      873     def var v-special-char            as character no-undo .
      874     if p-encode-char = ?
      875     or p-encode-char = "" then do:
      876       assign
      877         p-encode-char = "~~"
      878       .
      879     end.
      880     if p-init-string = "?" then do:
      881       return ? .
      882     end.
      883     assign
      884       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      885     .
      886     if v-num-entries-init-string > 1 then do:
      887       assign
      888         p-decode-string = entry(1, p-init-string, p-encode-char)
      889       .
      890       do ind = 2 to v-num-entries-init-string
      891       :
      892         assign
      893           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      894         .
      895         assign
      896           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      897         .
      898         if v-special-char <> ? then do:
      899           assign
      900             p-decode-string = p-decode-string
      901                             + v-special-char
      902                             + substring(v-sub-phrase, 4)
      903           .
      904         end.
      905         else do:
      906           assign
      907             p-decode-string = p-decode-string
      908                             + p-encode-char
      909                             + v-sub-phrase
      910           .
      911         end.
      912       end.
      913     end.
      914     else do:
      915       assign
      916         p-decode-string = p-init-string
      917       .
      918     end.
      919     return p-decode-string .
      920   end.
      921   function is-gas returns logical
      922           (input p-gds-code as integer):
      923   define variable result as logical no-undo.
      924   define variable c-value as character no-undo.
      925   define variable c-type as character no-undo.
      926   do on error undo, return error:
      927           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      928         (input  p-gds-code
      929         ,input  'fuel-type':U
      930         ,output c-value
      931         ,output c-type) no-error.
      932   end.
      933   result = logical(c-value = 'metan':U) no-error.
      934   return result.
      935   end function.
      936   define new global shared variable g#libbcrcn as handle no-undo .
      937   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   define variable v-waitfram-action01         as character   no-undo .
      939   define variable v-waitfram-action02         as character   no-undo .
      940   define variable v-waitfram-action03         as character   no-undo .
      941   define variable mWaitFramTextBeg            as character   no-undo.
      942   define variable mWaitFramTextEnd            as character   no-undo.
      943   define variable mWaitFramView               as logical     no-undo.
      944   define variable mWaitProcEvent              as logical     no-undo init yes.
      945   define variable mWaitFramInterval           as integer     no-undo init 1 .
      946   define variable mWaitFramStop               as logical     no-undo.
      947   define variable mWaitFramStopUser           as logical     no-undo.
      948   define variable mWaitFramStopTimeOut        as logical     no-undo.
      949   define variable mWaitFramStartProc          as datetime-tz no-undo.
      950   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      951   define button B-WaitFramStop auto-end-key
      952        label "Стоп"
      953        size 10 by 1 tooltip "Остоновить процесс".
      954   define button B-viewProcInfo
      955        label "Информация"
      956        size 15 by 1 tooltip "Информация о процесс".
      957   define frame waitfram
      958     v-waitfram-action01 format "x(72)" no-label skip
      959     v-waitfram-action02 format "x(72)" no-label skip
      960     v-waitfram-action03 format "x(72)" no-label skip
      961     B-viewProcInfo
      962     B-WaitFramStop at row 4 col 30
      963     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      964     .
      965   define new global shared variable mBatchMode as logical no-undo init ?.
      966   define variable mFramBachModHandle as handle no-undo.
      967   mFramBachModHandle = frame waitfram:handle.
      968   define variable mFameOldVis as logical no-undo.
      969   define variable mVisCUrentVin as logical no-undo.
      970   if session:batch-mode
      971   then
      972      mBatchMode = yes.
      973   if mBatchMode = ? then do:
      974     mVisCUrentVin = current-window:visible.
      975     mFameOldVis = mFramBachModHandle:visible.
      976     mFramBachModHandle:visible  = yes.
      977     mBatchMode = mFramBachModHandle:visible ne yes.
      978     mFramBachModHandle:visible = mFameOldVis.
      979     current-window:visible = mVisCUrentVin.
      980   end.
      981    if  log-manager:logfile-name ne ?
      982     then DO:
      983         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      984         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      985         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      986     end.
      987   on choose of B-WaitFramStop in frame waitfram
      988   do:
      989     mWaitFramStop = yes.
      990     mWaitFramStopUser = yes.
      991   end.
      992   function waitfram-check-timeout returns logical():
      993      define variable vtime as int64 no-undo.
      994      if mWaitFramStopTimeOut
      995      then
      996         return yes.
      997      vtime = ( now - mWaitFramStartProc ) / 1000 .
      998      if     mWaitFramTimeOut ne ?
      999         and mWaitFramTimeOut ne 0
     1000         and mWaitFramTimeOut lt vtime
     1001      then do:
     1002         mWaitFramStopTimeOut = yes.
     1003      end.
     1004      return mWaitFramStopTimeOut.
     1005   end.
     1006   procedure waitfram-hide :
     1007     if not session:batch-mode
     1008     then do
     1009     on error undo, return error return-value
     1010     :
     1011       pause 0 before-hide .
     1012       if not mBatchMode then
     1013         hide frame waitfram .
     1014     if     not mWaitFramView
     1015        and mWaitProcEvent
     1016     then
     1017       process events .
     1018     end.
     1019   end procedure.
     1020   procedure waitfram-show :
     1021     define input  parameter p-message as character no-undo .
     1022     define variable v-left-margin as integer   no-undo .
     1023     if not session:batch-mode
     1024     then do
     1025     on error undo, return error return-value
     1026     :
     1027       if length(p-message) <= 70 then do:
     1028         assign
     1029           v-left-margin = integer((70 - length(p-message)) / 2)
     1030         .
     1031         assign
     1032           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1033         .
     1034         assign
     1035           v-waitfram-action01 = " "
     1036           v-waitfram-action02 = " "
     1037                                    + fill(" ", v-left-margin)
     1038                                    + p-message
     1039           v-waitfram-action03 = " "
     1040         .
     1041       end.
     1042       else do:
     1043         define variable vRindex1 as integer no-undo.
     1044         define variable vRindex2 as integer no-undo.
     1045         vRindex1 = r-index(p-message," ",70).
     1046         if vRindex1 = 0
     1047         then
     1048            vRindex1 = 70.
     1049         if length(p-message)  <= vRindex1 + 70 then do:
     1050           assign
     1051             v-waitfram-action01 = " "
     1052             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1053             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1054           .
     1055         end.
     1056         else do:
     1057           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1058           if vRindex2 <= vRindex1
     1059           then
     1060              vRindex2 = vRindex1 + 70.
     1061           assign
     1062             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1063             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1064             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1065           .
     1066         end.
     1067       end.
     1068       B-viewProcInfo:visible   in frame waitfram = no.
     1069       B-viewProcInfo:sensitive in frame waitfram = no.
     1070       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1071       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1072       if  (   mWaitFramView
     1073          or  mWaitProcEvent)
     1074          and not mBatchMode
     1075       then
     1076          display
     1077             v-waitfram-action01 skip
     1078             v-waitfram-action02 skip
     1079             v-waitfram-action03 skip
     1080          with frame waitfram .
     1081       if     mWaitFramView
     1082          then do:
     1083             if     mWaitFramInterval ne ?
     1084                and not mBatchMode
     1085             then
     1086                wait-for go of frame waitfram pause mWaitFramInterval.
     1087          end.
     1088          else
     1089             if     mWaitProcEvent
     1090                and not mBatchMode
     1091             then
     1092                process events .
     1093     end.
     1094   end procedure.
     1095      procedure waitfram-show-this:
     1096         define input  parameter iInterval as int64 no-undo.
     1097         define variable vtime as int64 no-undo.
     1098         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1099         mWaitFramInterval = iInterval.
     1100         run waitfram-show (substitute("&1&2 &3&4" ,
     1101                                       mWaitFramTextBeg ,
     1102                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1103                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1104                                       mWaitFramTextEnd
     1105                                      )
     1106                           ).
     1107      end.
     1108      procedure WaitFramRunPause:
     1109         define input  parameter iInterval as dec no-undo.
     1110         define variable vStart  as datetime-tz no-undo.
     1111         define variable vend    as datetime-tz no-undo.
     1112         define variable vint as int64 no-undo.
     1113         define variable vOk as logical no-undo.
     1114         vStart = now.
     1115         vend   = vStart.
     1116         publish "WaitFramPause" (iInterval,output vOk).
     1117         vend   =  now.
     1118         vint = vend - vStart.
     1119         vint = iInterval - vint / 1000.
     1120         if     not mWaitFramStop
     1121            and (   vint > 0
     1122                 or (    not vOk
     1123                     and iInterval eq ?
     1124                     )
     1125                 )
     1126         then
     1127            run waitfram-show-this (iInterval).
     1128         vend   =  now.
     1129         vint = vend - vStart.
     1130         vint = iInterval - vint / 1000.
     1131         if     not mWaitFramStop
     1132            and vint > 0
     1133         then do:
     1134            run gbl/pause.p (vint * 1000).
     1135         end.
     1136         if iInterval ne ?
     1137         then
     1138            publish "WaitFramStop".
     1139         waitfram-check-timeout().
     1140      end.
     1141      procedure WaitFramWaitFor:
     1142         define input  parameter iInterval as dec no-undo.
     1143         assign
     1144            mWaitFramStartProc   = now
     1145            mWaitFramStopUser    = no
     1146            mWaitFramStopTimeOut = no
     1147         .
     1148         block-wait:
     1149         do while not mWaitFramStop:
     1150            run WaitFramRunPause (iInterval).
     1151            if  waitfram-check-timeout()
     1152            then do:
     1153               leave block-wait.
     1154            end.
     1155         end.
     1156         run waitfram-hide.
     1157      end.
     1158   procedure waitfram-join :
     1159     define input  parameter p-line-1  as character no-undo .
     1160     define input  parameter p-line-2  as character no-undo .
     1161     define input  parameter p-line-3  as character no-undo .
     1162     define output parameter p-message as character no-undo .
     1163     do
     1164     on error undo, return error return-value
     1165     :
     1166       assign
     1167         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1168                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1169                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1170       .
     1171     end.
     1172   end procedure.
     1173   function waitfram-join-function returns character
     1174     (input p-line-1 as character
     1175     ,input p-line-2 as character
     1176     ,input p-line-3 as character
     1177     ).
     1178     define variable v-message as character no-undo .
     1179     run waitfram-join in this-procedure
     1180       (input  p-line-1
     1181       ,input  p-line-2
     1182       ,input  p-line-3
     1183       ,output v-message
     1184       ) .
     1185     return v-message .
     1186   end function .
     1187   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   procedure cur-time :
     1189      define output parameter p-today as date      no-undo .
     1190      define output parameter p-time  as integer   no-undo .
     1191     do
     1192     on error undo, return error
     1193     :
     1194       define variable v-date1 as date      no-undo .
     1195       define variable v-date2 as date      no-undo .
     1196       define variable v-time  as integer   no-undo .
     1197       assign
     1198         v-date1 = today
     1199         v-time  = time
     1200         v-date2 = today
     1201       .
     1202       if v-date1 <> v-date2
     1203       then do:
     1204         assign
     1205           v-date1 = today
     1206           v-time  = v-time
     1207         .
     1208       end.
     1209       assign
     1210         p-today = v-date1
     1211         p-time  = v-time
     1212       .
     1213     end.
     1214   end.
     1215   function cur-time-date returns character
     1216   :
     1217     return string(today, '99/99/9999':U) .
     1218   end.
     1219   function cur-time-mjd returns decimal
     1220   :
     1221     define variable v-date as date      no-undo .
     1222     define variable v-time as integer   no-undo .
     1223     run cur-time in this-procedure
     1224       (output v-date
     1225       ,output v-time
     1226       ) .
     1227     return integer(v-date) - 2400002 + (v-time / 86400) .
     1228   end.
     1229   function cur-time-get-ending-index returns integer
     1230   (input p-number as integer
     1231   )
     1232   :
     1233     if p-number < 0
     1234     or p-number = ?
     1235     then do:
     1236       return 1 .
     1237     end.
     1238     define variable v-rest as integer   no-undo .
     1239     assign
     1240       p-number = p-number modulo 100
     1241     .
     1242     if p-number < 20
     1243     then do:
     1244       assign
     1245         v-rest = p-number
     1246       .
     1247     end.
     1248     else do:
     1249       assign
     1250         v-rest = p-number modulo 10
     1251       .
     1252     end.
     1253     case v-rest :
     1254       when 1
     1255       then do:
     1256         return 2 .
     1257       end.
     1258       when 2 or
     1259       when 3 or
     1260       when 4
     1261       then do:
     1262         return 3 .
     1263       end.
     1264       otherwise do:
     1265         return 1 .
     1266       end.
     1267     end case .
     1268   end.
     1269   procedure cur-time-mjd-to-date :
     1270      define input  parameter i-mjd-diff as decimal no-undo.
     1271      define output parameter o-Date     as date    no-undo.
     1272      define output parameter o-Time     as integer no-undo.
     1273      define variable v-day-number as integer   no-undo .
     1274      if    i-mjd-diff < 0
     1275         or i-mjd-diff = ?
     1276      then do:
     1277         return "?" .
     1278      end.
     1279      assign
     1280         v-day-number = truncate(i-mjd-diff,0).
     1281         o-Date = date(v-day-number + 2400002).
     1282         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1283     .
     1284   end.
     1285   function cur-time-mjd-to-string returns character
     1286   (input p-mjd-diff as decimal
     1287   )
     1288   :
     1289     define variable v-day-number as integer   no-undo .
     1290     define variable v-seconds    as integer   no-undo .
     1291     define variable v-hour       as integer   no-undo .
     1292     define variable v-min        as integer   no-undo .
     1293     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1294     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1295     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1296     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1297     if p-mjd-diff < 0
     1298     or p-mjd-diff = ?
     1299     then do:
     1300       return "?" .
     1301     end.
     1302     assign
     1303       v-day-number = integer(truncate(p-mjd-diff,0))
     1304       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1305     .
     1306     if v-seconds > 86400
     1307     then do:
     1308       assign
     1309         v-seconds = 86400 - 1
     1310       .
     1311     end.
     1312     if v-seconds < 0
     1313     then do:
     1314       assign
     1315         v-seconds = 0
     1316       .
     1317     end.
     1318     assign
     1319       v-hour = truncate(v-seconds / 3600, 0)
     1320     .
     1321     assign
     1322       v-seconds = v-seconds modulo 3600
     1323     .
     1324     assign
     1325       v-min = truncate(v-seconds / 60, 0)
     1326     .
     1327     assign
     1328       v-seconds = v-seconds modulo 60
     1329     .
     1330     return
     1331         (if v-day-number <> 0
     1332           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1333           else ""
     1334         )
     1335       + (if v-day-number <> 0 or v-hour <> 0
     1336           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1337           else ""
     1338         )
     1339       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1340           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1341           else ""
     1342         )
     1343       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1344       .
     1345   end.
     1346   function cur-time-string returns character
     1347   :
     1348     define variable v-date as date      no-undo .
     1349     define variable v-time as integer   no-undo .
     1350     run cur-time in this-procedure
     1351       (output v-date
     1352       ,output v-time
     1353       ) .
     1354     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1355   end.
     1356   function cur-time-string-sec returns character
     1357   :
     1358     define variable v-date as date      no-undo .
     1359     define variable v-time as integer   no-undo .
     1360     run cur-time in this-procedure
     1361       (output v-date
     1362       ,output v-time
     1363       ) .
     1364     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1365   end.
     1366   function cur-time-custom  returns character
     1367   (input p-prefix as character
     1368   ,input p-date-format as character
     1369   ,input p-delimiter as character
     1370   ,input p-time-format as character
     1371   ,input p-suffix as character
     1372   )
     1373   :
     1374     define variable v-date as date      no-undo .
     1375     define variable v-time as integer   no-undo .
     1376     run cur-time in this-procedure
     1377       (output v-date
     1378       ,output v-time
     1379       ) .
     1380     return
     1381       p-prefix
     1382       + string(v-date, p-date-format)
     1383       + p-delimiter
     1384       + string(v-time, p-time-format)
     1385       + p-suffix
     1386       .
     1387   end.
     1388   function cur-time-print  returns character
     1389   :
     1390     define variable v-date as date      no-undo .
     1391     define variable v-time as integer   no-undo .
     1392     run cur-time in this-procedure
     1393       (output v-date
     1394       ,output v-time
     1395       ) .
     1396     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1397   end.
     1398   function cur-time-datetime returns datetime
     1399   :
     1400     define variable v-char as character no-undo .
     1401     define variable v-datetime as datetime no-undo .
     1402     v-char = cur-time-string().
     1403     v-datetime = datetime(v-char).
     1404     return  v-datetime.
     1405   end.
     1406   function cur-time-string-msec returns character
     1407   :
     1408     define variable v-date as datetime  no-undo .
     1409     v-date = now.
     1410     return string(v-date) .
     1411   end.
     1412   define variable vss-include-info6 as character format "X(65)" no-undo
     1413   initial "@(#)$Workfile$ $Revision$".
     1414   define temp-table temp_fbr-history no-undo like ub.fbr-history .
     1415   define variable v-fbrhist-history-level     as integer      no-undo.
     1416   define variable v-fbrhist-upper-obj-type    as character    no-undo.
     1417   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
     1418   define variable v-fbrhist-upper-code        as integer      no-undo.
     1419   define variable v-fbrhist-current-obj-type  as character    no-undo.
     1420   define variable v-fbrhist-current-obj-code  as integer      no-undo.
     1421   define variable v-fbrhist-current-code      as integer      no-undo.
     1422   define variable v-fbrhist-saved-obj-type    as character    no-undo.
     1423   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
     1424   define variable v-fbrhist-saved-code        as integer      no-undo.
     1425   procedure fbrhist-write :
     1426   define input parameter p-userid                 as character        no-undo.
     1427   define input parameter p-obj-type               as character        no-undo.
     1428   define input parameter p-obj-code               as integer          no-undo.
     1429   define input parameter p-hst-type               as character        no-undo.
     1430   define input parameter p-hst-level              as integer          no-undo.
     1431   define input parameter p-procedure-name         as character        no-undo.
     1432   define input parameter p-procedure-parameters   as character        no-undo.
     1433   define input parameter p-doc-code               as character        no-undo.
     1434   define input parameter p-doc-type               as character        no-undo.
     1435   define input parameter p-status_                as character        no-undo.
     1436   define input parameter p-is-free                as logical          no-undo.
     1437   define input parameter p-recipe-code            as character        no-undo.
     1438   define input parameter p-recipe-type            as character        no-undo.
     1439   define input parameter p-gds-code               as integer          no-undo.
     1440   define input parameter p-trn-type               as character        no-undo.
     1441   define input parameter p-qnty                   as decimal          no-undo.
     1442   define input parameter p-PS                     as character        no-undo.
     1443   define input parameter p-is-error               as logical          no-undo.
     1444       define variable v-today                         as date         no-undo.
     1445       define variable v-obj-date                      as date         no-undo.
     1446       define variable v-time                          as integer      no-undo.
     1447       define variable v-host-code                     as integer      no-undo.
     1448       define variable v-db-num                        as integer      no-undo.
     1449       define buffer buf_temp_fbr-history       for temp_fbr-history.
     1450       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
     1451   do
     1452   for buf_temp_fbr-history
     1453     , buf_upper_temp_fbr-history
     1454   on error undo, return error
     1455   :
     1456       if v-fbrhist-history-level = 0
     1457       or v-fbrhist-history-level < p-hst-level
     1458       then do:
     1459           undo, return .
     1460       end.
     1461       if v-fbrhist-upper-code <> 0
     1462       then do:
     1463           find first buf_upper_temp_fbr-history no-lock
     1464                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
     1465                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
     1466                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
     1467           no-error.
     1468       end.
     1469   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1471     (input  p-obj-type
     1472     ,input  p-obj-code
     1473     ,output v-obj-date
     1474     )  .
     1475       run cur-time in this-procedure (
     1476             output v-today
     1477           , output v-time
     1478       ).
     1479   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1481     (input  p-obj-type
     1482     ,input  p-obj-code
     1483     ,output v-host-code
     1484     )  .
     1485   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1487     (output v-db-num
     1488     )  .
     1489       create buf_temp_fbr-history.
     1490       assign
     1491           buf_temp_fbr-history.obj-type                = p-obj-type
     1492           buf_temp_fbr-history.obj-code                = p-obj-code
     1493           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
     1494           buf_temp_fbr-history.hst-type                = p-hst-type
     1495           buf_temp_fbr-history.hst-level               = p-hst-level
     1496           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
     1497           buf_temp_fbr-history.procedure-name          = p-procedure-name
     1498           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
     1499           buf_temp_fbr-history.doc-code                = p-doc-code
     1500           buf_temp_fbr-history.doc-type                = p-doc-type
     1501           buf_temp_fbr-history.status_                 = p-status_
     1502           buf_temp_fbr-history.is-free                 = p-is-free
     1503           buf_temp_fbr-history.recipe-code             = p-recipe-code
     1504           buf_temp_fbr-history.recipe-type             = p-recipe-type
     1505           buf_temp_fbr-history.gds-code                = p-gds-code
     1506           buf_temp_fbr-history.trn-type                = p-trn-type
     1507           buf_temp_fbr-history.qnty                    = p-qnty
     1508           buf_temp_fbr-history.PS                      = p-ps
     1509           buf_temp_fbr-history.is-error                = p-is-error
     1510           buf_temp_fbr-history.db-num                  = v-db-num
     1511           buf_temp_fbr-history.user-name               = p-userid
     1512           buf_temp_fbr-history.sys-date                = v-today
     1513           buf_temp_fbr-history.sys-time-int            = v-time
     1514           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
     1515           buf_temp_fbr-history.obj-date                = v-obj-date
     1516           buf_temp_fbr-history.host-code               = v-host-code
     1517       .
     1518       assign
     1519           v-fbrhist-current-obj-type                   = p-obj-type
     1520           v-fbrhist-current-obj-code                   = p-obj-code
     1521           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
     1522       .
     1523       if available buf_upper_temp_fbr-history
     1524       then do:
     1525           assign
     1526               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
     1527                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
     1528                                               + "-":U + string( buf_temp_fbr-history.obj-code )
     1529                                               + "-":U + string( buf_temp_fbr-history.hst-code )
     1530           .
     1531       end.
     1532       else do:
     1533           assign
     1534               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
     1535                                  + "-":U + string( buf_temp_fbr-history.obj-code )
     1536                                  + "-":U + string( buf_temp_fbr-history.hst-code )
     1537           .
     1538       end.
     1539   end.
     1540   end procedure.
     1541   procedure fbrhist-read-conf :
     1542   do
     1543   on error undo, return error
     1544   :
     1545      define variable v-value-character as character  no-undo .
     1546      define variable v-value-date      as date       no-undo .
     1547      define variable v-value-decimal   as decimal    no-undo .
     1548      define variable v-value-logical   as logical    no-undo .
     1549      define variable v-tth             as handle     no-undo .
     1550      define variable v-param-type            as character no-undo .
     1551      run adm/shattri.p ( input "get":U
     1552                        , input  '':u
     1553                        , input  0
     1554                        , input  'fbrattr':U
     1555                        , input  'fbrhstlv':U
     1556                        , output v-value-character
     1557                        , output v-value-date
     1558                        , output v-value-decimal
     1559                        , output v-fbrhist-history-level
     1560                        , output v-value-logical
     1561                        , output v-param-type
     1562                        , input-output table-handle v-tth
     1563                        ) no-error .
     1564      if error-status :error then do:
     1565         assign
     1566            v-fbrhist-history-level = 0
     1567         .
     1568      end.
     1569   end.
     1570   end procedure.
     1571   procedure fbrhist-table-to-base :
     1572       define buffer buf_fbr-history       for ub.fbr-history.
     1573       define buffer buf_temp_fbr-history  for temp_fbr-history.
     1574   do
     1575   for buf_fbr-history
     1576     , buf_temp_fbr-history
     1577   on error undo, return error
     1578   :
     1579       for each buf_temp_fbr-history
     1580       on error undo, return error
     1581       :
     1582           create buf_fbr-history.
     1583           buffer-copy buf_temp_fbr-history to buf_fbr-history.
     1584       end.
     1585   end.
     1586   end procedure.
     1587   procedure fbrhist-init :
     1588       define buffer buf_temp_fbr-history      for temp_fbr-history.
     1589   do
     1590   for buf_temp_fbr-history
     1591   on error undo, return error
     1592   :
     1593       for each buf_temp_fbr-history
     1594       :
     1595           delete buf_temp_fbr-history.
     1596       end.
     1597       assign
     1598           v-fbrhist-upper-obj-type    = ""
     1599           v-fbrhist-upper-obj-code    = 0
     1600           v-fbrhist-upper-code        = 0
     1601           v-fbrhist-current-obj-type  = ""
     1602           v-fbrhist-current-obj-code  = 0
     1603           v-fbrhist-current-code      = 0
     1604           v-fbrhist-saved-obj-type    = ""
     1605           v-fbrhist-saved-obj-code    = 0
     1606           v-fbrhist-saved-code        = 0
     1607       .
     1608   end.
     1609   end procedure.
     1610   procedure fbrhist-set-upper-code :
     1611   do
     1612   on error undo, return error
     1613   :
     1614       assign
     1615           v-fbrhist-upper-obj-type    = v-fbrhist-current-obj-type
     1616           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
     1617           v-fbrhist-upper-code        = v-fbrhist-current-code
     1618       .
     1619   end.
     1620   end procedure.
     1621   procedure fbrhist-save-current-code :
     1622   do
     1623   on error undo, return error
     1624   :
     1625       assign
     1626           v-fbrhist-saved-obj-type    = v-fbrhist-current-obj-type
     1627           v-fbrhist-saved-obj-code    = v-fbrhist-current-obj-code
     1628           v-fbrhist-saved-code        = v-fbrhist-current-code
     1629       .
     1630   end.
     1631   end procedure.
     1632   procedure fbrhist-set-upper-from-saved-code :
     1633   do
     1634   on error undo, return error
     1635   :
     1636       assign
     1637           v-fbrhist-upper-obj-type    = v-fbrhist-saved-obj-type
     1638           v-fbrhist-upper-obj-code    = v-fbrhist-saved-obj-code
     1639           v-fbrhist-upper-code        = v-fbrhist-saved-code
     1640       .
     1641   end.
     1642   end procedure.
     1643   procedure fbrhist-set-zero-upper-code :
     1644   do
     1645   on error undo, return error
     1646   :
     1647       assign
     1648           v-fbrhist-upper-obj-type    = ""
     1649           v-fbrhist-upper-obj-code    = 0
     1650           v-fbrhist-upper-code        = 0
     1651       .
     1652   end.
     1653   end procedure.
     1654   define new global shared variable g#libtfarh as handle no-undo .
     1655   define variable vss-include-info10 as character format "X(65)" no-undo
     1656   initial "@(#)$Workfile$ $Revision$".
     1657   define temp-table temp_fbrcode-doc-code no-undo
     1658       field rec-type      as character
     1659       field doc-code      as character
     1660       field obj-type      as character
     1661       field obj-code      as integer
     1662       field cli-type      as character
     1663       field cli-code      as integer
     1664       field ext-doc-type  as character
     1665       field doc-type      as character
     1666       field order         as integer
     1667       index pi is primary unique rec-type doc-code
     1668       index od order
     1669   .
     1670   procedure fbrcode-gen-recipe-code :
     1671   do
     1672   on error undo, return error
     1673   :
     1674   define input parameter p-obj-type           as character    no-undo.
     1675   define input parameter p-obj-code           as integer      no-undo.
     1676   define output parameter p-recipe-code       as character    no-undo.
     1677       assign
     1678           p-recipe-code   = string( next-value( s-recipe, ub ) )
     1679                               + "-"
     1680                               + trim( string( p-obj-code, ">>>>9" ) )
     1681                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1682       .
     1683   end.
     1684   end procedure.
     1685   procedure fbrcode-is-from-object :
     1686   do
     1687   on error undo, return error
     1688   :
     1689   define input parameter p-doc-code           as character    no-undo.
     1690   define input parameter p-obj-type           as character    no-undo.
     1691   define input parameter p-obj-code           as integer      no-undo.
     1692   define output parameter p-is-from-object    as logical      no-undo.
     1693       if num-entries( p-doc-code, "-" ) < 2
     1694       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
     1695                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1696       then do:
     1697           assign
     1698               p-is-from-object = no
     1699           .
     1700       end.
     1701       else do:
     1702           assign
     1703               p-is-from-object = yes
     1704           .
     1705       end.
     1706   end.
     1707   end procedure.
     1708   procedure fbrcode-trn-doc :
     1709   do
     1710   on error undo, return error
     1711   :
     1712       define input parameter p-out-doc-type       as character    no-undo.
     1713       define input parameter p-out-code           as character    no-undo.
     1714       define input parameter p-trn-doc-out-type   as character    no-undo.
     1715       define output parameter p-trn-doc-doc-code  as character   no-undo.
     1716       case p-out-doc-type:
     1717           when 'производство':U
     1718           then do:
     1719               case p-trn-doc-out-type :
     1720                   when 'рас':U
     1721                   then do:
     1722                       assign
     1723                           p-trn-doc-doc-code = p-out-code
     1724                       .
     1725                   end.
     1726                   when 'при':U
     1727                   then do:
     1728                       assign
     1729                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
     1730                       .
     1731                   end.
     1732                   when 'спи':U
     1733                   then do:
     1734                       assign
     1735                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
     1736                       .
     1737                   end.
     1738                   otherwise do:
     1739                       assign
     1740                           p-trn-doc-doc-code = ""
     1741                       .
     1742                       undo, return error "Не может быть обработан тип складского документа '"
     1743                                           + p-trn-doc-out-type + "' во входных параметрах".
     1744                   end.
     1745               end case.
     1746           end.
     1747           otherwise do:
     1748               assign
     1749                   p-trn-doc-doc-code = ""
     1750               .
     1751               undo, return error "Не может быть обработан тип внешнего документа '"
     1752                                   + p-out-doc-type + "' во входных параметрах".
     1753           end.
     1754       end case.
     1755   end.
     1756   end procedure.
     1757   procedure fbrcode-fill-fbr-by-sale-or-pln :
     1758   define input parameter p-main-doc-code      as character        no-undo.
     1759       define variable v-order    as integer      no-undo.
     1760       define buffer buf_fbr-doc               for ub.fbr-doc.
     1761       define buffer buf_trn-doc               for ub.trn-doc.
     1762       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1763   do
     1764   for buf_fbr-doc
     1765     , buf_trn-doc
     1766     , buf_temp_fbrcode-doc-code
     1767   on error undo, return error
     1768   :
     1769       for each buf_temp_fbrcode-doc-code
     1770       on error undo, return error
     1771       :
     1772           delete buf_temp_fbrcode-doc-code.
     1773       end.
     1774       assign
     1775           v-order = 0
     1776       .
     1777       for each buf_fbr-doc no-lock
     1778          where buf_fbr-doc.out-code = p-main-doc-code
     1779       on error undo, return error
     1780       :
     1781           create buf_temp_fbrcode-doc-code.
     1782           assign
     1783               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
     1784               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
     1785               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
     1786               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
     1787               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
     1788               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
     1789               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
     1790               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
     1791           .
     1792           for each buf_trn-doc no-lock
     1793              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1794           by buf_trn-doc.fact-order
     1795           on error undo, return error
     1796           :
     1797               if buf_trn-doc.ext-doc-type = 'em':U
     1798               or buf_trn-doc.ext-doc-type = 'im':U
     1799               or buf_trn-doc.ext-doc-type = 'wm':U
     1800               or buf_trn-doc.ext-doc-type = 'ev':U
     1801               then do:
     1802                   assign
     1803                       v-order = v-order + 1
     1804                   .
     1805                   create buf_temp_fbrcode-doc-code.
     1806                   assign
     1807                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1808                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
     1809                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1810                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1811                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1812                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1813                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1814                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1815                       buf_temp_fbrcode-doc-code.order         = v-order
     1816                   .
     1817               end.
     1818           end.
     1819           assign
     1820               v-order  = v-order + 1
     1821           .
     1822           find first buf_temp_fbrcode-doc-code
     1823                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
     1824                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
     1825           .
     1826           assign
     1827               buf_temp_fbrcode-doc-code.order = v-order
     1828           .
     1829       end.
     1830       for each buf_trn-doc no-lock
     1831          where buf_trn-doc.out-code = p-main-doc-code
     1832       by buf_trn-doc.fact-order
     1833       on error undo, return error
     1834       :
     1835           assign
     1836               v-order = v-order + 1
     1837           .
     1838           create buf_temp_fbrcode-doc-code.
     1839           assign
     1840               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1841               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
     1842               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1843               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1844               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1845               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1846               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1847               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1848               buf_temp_fbrcode-doc-code.order         = v-order
     1849           .
     1850       end.
     1851   end.
     1852   end procedure.
     1853   procedure fbrcode-get-final-doc :
     1854   define input parameter p-main-doc-code      as character        no-undo.
     1855   define output parameter p-income-doc-code   as character        no-undo.
     1856       define variable v-main-obj-type    as character    no-undo.
     1857       define variable v-main-obj-code    as integer      no-undo.
     1858       define buffer buf_trn-doc               for ub.trn-doc.
     1859       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1860   do
     1861   for buf_trn-doc
     1862   on error undo, return error
     1863   :
     1864       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     1865           input p-main-doc-code
     1866       ).
     1867       find first buf_trn-doc no-lock
     1868            where buf_trn-doc.doc-code = p-main-doc-code
     1869       .
     1870       assign
     1871           v-main-obj-type = buf_trn-doc.obj-type
     1872           v-main-obj-code = buf_trn-doc.obj-code
     1873       .
     1874       find first buf_temp_fbrcode-doc-code
     1875            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
     1876              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
     1877              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
     1878       no-error.
     1879       if available buf_temp_fbrcode-doc-code
     1880       then do:
     1881           find first buf_trn-doc no-lock
     1882                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
     1883                  and buf_trn-doc.ext-doc-type = 'iv':U
     1884           .
     1885           assign
     1886               p-income-doc-code = buf_trn-doc.doc-code
     1887           .
     1888       end.
     1889       else do:
     1890           find first buf_temp_fbrcode-doc-code
     1891                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
     1892                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
     1893                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
     1894           no-error.
     1895           if available buf_temp_fbrcode-doc-code
     1896           then do:
     1897               assign
     1898                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
     1899               .
     1900           end.
     1901           else do:
     1902               assign
     1903                   p-income-doc-code = "":U
     1904               .
     1905           end.
     1906       end.
     1907   end.
     1908   end procedure.
