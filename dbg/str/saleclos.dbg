     8818                                           output v-root-node,
     8819                                           buffer buf_trn-doc,
     8820                                           buffer spis_doc-line,
     8821                                           buffer buf-new_trn-doc).
     8822                     run RSRV-line in this-procedure (input 1,
     8823                                                      input no,
     8824                                                      input no,
     8825                                                      input yes,
     8826                                                      input no,
     8827                                                      input v-new_doc-code,
     8828                                                      input no,
     8829                                                      input no,
     8830                                                      input yes,
     8831                                                      input buf_goods.gds-code,
     8832                                                      input v-root-node,
