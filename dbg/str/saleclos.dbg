     8709                                                          input yes,
     8710                                                          input buf_goods.gds-code,
     8711                                                          input v-root-node,
     8712                                                          output v-run-tpsi-line,
     8713                                                          buffer spis_doc-line,
     8714                                                          buffer buf_spis-doc,
     8715                                                          buffer spis_sale-doc).
     8716                       end.
     8717                       find first buf_spis-doc exclusive-lock where buf_spis-doc.doc-code = replace(buf_trn-doc.doc-code, "-", "`") no-error.
     8718                       find first spis_sale-doc exclusive-lock where spis_sale-doc.inkas-code = p-inkas-code
     8719                                                                 and spis_sale-doc.doc-kind =  'swo':U
     8720                                                                 no-error .
     8721                       find first spis_doc-line exclusive-lock where spis_doc-line.doc-code  = replace(buf_doc-line.doc-code, "-", "`")
     8722                                                                 and spis_doc-line.artic     = buf_doc-line.artic
     8723                                                                 and spis_doc-line.prod-type = buf_doc-line.prod-type
     8724                                                                 and spis_doc-line.prod-code = buf_doc-line.prod-code
     8725                                                                 no-error .
     8726                       if available buf_spis-doc
     8727                       and available spis_sale-doc
     8728                       and available spis_doc-line
     8729                       then do :
     8730                         run RSRV-line in this-procedure (input 1,
     8731                                                          input no,
     8732                                                          input no,
     8733                                                          input yes,
     8734                                                          input no,
     8735                                                          input v-new_doc-code,
     8736                                                          input no,
     8737                                                          input no,
     8738                                                          input yes,
     8739                                                          input buf_goods.gds-code,
     8740                                                          input v-root-node,
     8741                                                          output v-run-tpsi-line,
     8742                                                          buffer spis_doc-line,
     8743                                                          buffer buf_spis-doc,
     8744                                                          buffer spis_sale-doc).
     8745                       end.
     8746                       v-gas-income-created = v-gas-income-created + "," + string(buf_goods.gds-code) .
     8747                   end.
     8748               end.
     8749               for each spis_doc-line exclusive-lock where spis_doc-line.doc-code  = replace(buf_trn-doc.doc-code, "-", "^") :
     8750                 find first buf_goods where buf_goods.prod-code = spis_doc-line.prod-code
     8751                                        and buf_goods.prod-type = spis_doc-line.prod-type
     8752                                        and buf_goods.artic = spis_doc-line.artic no-lock.
     8753                 if is-gas(buf_goods.gds-code)
     8754                 and not can-do(v-gas-income-created, string(buf_goods.gds-code))
     8755                 then do:
     8756                   find first buf_spis-doc exclusive-lock where buf_spis-doc.doc-code = replace(buf_trn-doc.doc-code, "-", "^") no-error.
     8757                   find first spis_sale-doc exclusive-lock where spis_sale-doc.inkas-code = p-inkas-code
     8758                                                             and spis_sale-doc.doc-kind =  'trf':U
     8759                                                             no-error .
     8760                   if available buf_spis-doc
     8761                   and available spis_sale-doc
     8762                   then do :
     8763                     run str/gas-autosl.p (input parparentproc,
     8764                                           input p-log-handle,
     8765                                           input log-file-name,
     8766                                           input p-auto,
     8767                                           input p-inkas-code,
     8768                                           input v-curr-r-b,
     8769                                           input v-gas-cli-type,
     8770                                           input v-gas-cli-code,
     8771                                           output v-new_doc-code,
     8772                                           output v-root-node,
     8773                                           buffer buf_trn-doc,
     8774                                           buffer spis_doc-line,
     8775                                           buffer buf-new_trn-doc).
     8776                     run RSRV-line in this-procedure (input 1,
     8777                                                      input no,
     8778                                                      input no,
     8779                                                      input yes,
     8780                                                      input no,
     8781                                                      input v-new_doc-code,
     8782                                                      input no,
     8783                                                      input no,
     8784                                                      input yes,
     8785                                                      input buf_goods.gds-code,
     8786                                                      input v-root-node,
     8787                                                      output v-run-tpsi-line,
     8788                                                      buffer spis_doc-line,
     8789                                                      buffer buf_spis-doc,
     8790                                                      buffer spis_sale-doc).
     8791                     v-gas-income-created = v-gas-income-created + "," + string(buf_goods.gds-code) .
     8792                   end.
     8793                 end.
     8794               end.
     8795               for each spis_doc-line exclusive-lock where spis_doc-line.doc-code  = replace(buf_trn-doc.doc-code, "-", "`") :
     8796                 find first buf_goods where buf_goods.prod-code = spis_doc-line.prod-code
     8797                                        and buf_goods.prod-type = spis_doc-line.prod-type
     8798                                        and buf_goods.artic = spis_doc-line.artic no-lock.
     8799                 if is-gas(buf_goods.gds-code)
     8800                 and not can-do(v-gas-income-created, string(buf_goods.gds-code))
     8801                 then do:
     8802                   find first buf_spis-doc exclusive-lock where buf_spis-doc.doc-code = replace(buf_trn-doc.doc-code, "-", "`") no-error.
     8803                   find first spis_sale-doc exclusive-lock where spis_sale-doc.inkas-code = p-inkas-code
     8804                                                             and spis_sale-doc.doc-kind =  'swo':U
     8805                                                             no-error .
     8806                   if available buf_spis-doc
     8807                   and available spis_sale-doc
     8808                   then do :
     8809                     run str/gas-autosl.p (input parparentproc,
     8810                                           input p-log-handle,
     8811                                           input log-file-name,
     8812                                           input p-auto,
     8813                                           input p-inkas-code,
     8814                                           input v-curr-r-b,
