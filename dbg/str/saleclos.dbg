     8834                                                      buffer spis_doc-line,
     8835                                                      buffer buf_spis-doc,
     8836                                                      buffer spis_sale-doc).
     8837                     v-gas-income-created = v-gas-income-created + "," + string(buf_goods.gds-code) .
     8838                   end.
     8839                 end.
     8840               end.
     8841           end.
     8842       end.
     8843       RUN button-close in this-procedure (
     8844                                                buffer buf_trn-doc
     8845                                               ,buffer buf_ret-doc
     8846                                               ,input p-is-tpsi-obj
     8847                                               ,input auto-fbr
     8848                                               ,input neg-tpsi-weight
     8849                                               ,input neg-tpsi-qnty
     8850                                               ,input neg-tpsi-oper
     8851                                               ,Output b-close-enabled).
     8852       IF NOT b-close-enabled
     8853       and not v-is-inquiry
     8854       then do:
     8855         undo f-close, return error substitute("Не все товары зарезервированы, закрытие невозможно!"
     8856                               ).
     8857       end.
     8858       IF NOT b-close-enabled
     8859       and v-is-inquiry
     8860       then do:
     8861         undo f-close, return error substitute("Некоторые товары зарезервированы, закрытие невозможно!"
     8862                               ).
     8863       end.
     8864       if not v-is-inquiry then do:
     8865         do while ii < 2:
     8866           RUN neg-rests in this-procedure (
     8867                       input yes
     8868                     , input buf_inkas.status_
     8869                     , input buf_inkas.inkas-code
     8870                     , input 'ИЗМЕНЕНИЕ':U
     8871                     , input p-is-catering
     8872                     , input p-is-tpsi-obj
     8873                     , input neg-tpsi-weight
     8874                     , input neg-tpsi-qnty
     8875                     , input neg-tpsi-oper
     8876                     ).
     8877           _dtl-rests:
     8878           for each dtl-rests no-LOCK:
     8879             if NOT dtl-rests.ok
     8880             or (ii = 0 AND dtl-rests.fbr > 0 and auto-fbr)
     8881             or (ii = 0 AND dtl-rests.prop > 0 and p-is-tpsi-obj)
     8882             then do:
     8883               if (not auto-fbr or dtl-rests.fbr = 0)
     8884               AND (not p-is-tpsi-obj or dtl-rests.prop = 0)
     8885               then do:
     8886                 assign
     8887                 my-mes =  substitute("В результате данной продажи&1" +
     8888                                       "на текущем объекте (&2&3)&1" +
     8889                                       "появятся недопустимые ОТРИЦАТЕЛЬНЫE ОСТАТКИ&1" +
     8890                                       "по товару  с артикулом : &4&1" +
     8891                                       "производителя : &5&1" +
     8892                                       "&6&1" +
     8893                                       (if p-auto = 0 then "Закрытие продажи невозможнo !" else "":U)
     8894                             , chr(10)
     8895                             , buf_inkas.obj-type
     8896                             , buf_inkas.obj-code
     8897                             , dtl-rests.artic
     8898                             , (trim( dtl-rests.prod-type ) + " " + string(dtl-rests.prod-code))
     8899                             ,  (if dtl-rests.b-code > 0
     8900                               then ("по коду : " + string( dtl-rests.b-code, ">>>>>>>>>9" ))
     8901                               else "")
     8902                             ).
     8903                 if p-auto = 0 then do:
     8904                   undo f-close,  return error my-mes.
     8905                 end.
     8906                 else do:
     8907                   assign
     8908                   v-is-neg-rests = yes.
     8909                     run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input my-mes                                       ).
     8910                 end.
     8911               end.
     8912               else do:
     8913                 assign
     8914                 force-auto-fbr = ( auto-fbr and dtl-rests.fbr > 0)
     8915                 force-tpsi-obj = ( p-is-tpsi-obj and dtl-rests.prop > 0)
     8916                 .
     8917                 if (force-auto-fbr and force-tpsi-obj)
     8918                 or (force-auto-fbr and not p-is-tpsi-obj)
     8919                 or (force-tpsi-obj and not auto-fbr)
     8920                 then
     8921                 LEAVE _dtl-rests.
     8922               end.
     8923             end.
     8924           end.
     8925           if p-auto > 0
     8926           and v-is-neg-rests then do:
     8927                     run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Закрытие продажи невозможно"                                       ).
     8928             undo f-close,  return error my-mes.
     8929           end.
     8930           if force-tpsi-obj and ii = 0 then do:
     8931             run write-log-and-file in p-log-handle (
     8932                   input 1
     8933                 , input log-file-name
     8934                 , input 1
     8935                 , input substitute("Автоматическое перемещение товаров в пределах ТПСИ,&1 необходимых для резервирования в продаже &2"
     8936                                 , chr(10))
     8937                                   ).
     8938             run str/tpsisale.p (
     8939                           input parparentproc
     8940                           ,input p-parent-handle
     8941                           ,input p-log-handle
     8942                           ,input (string(buf_inkas.host-code) + chr(4) +
     8943                                   buf_Inkas.obj-type + chr(4) +
     8944                                   string(buf_inkas.obj-code) + chr(4) +
     8945                                   buf_inkas.inkas-code + chr(4) +
     8946                                   log-file-name
     8947                                   )
     8948                           ) no-error .
     8949             if error-status:error then do:
     8950               undo f-close, return error  substitute(("Ошибка при попытке перемещения товаров, необходимых для резервирования в продаже &1:&2&3 &4" +
     8951                                       "Закрытие продажи невозможнo !")
     8952                                       , buf_inkas.inkas-code
     8953                                       , chr(10)
     8954                                       , error-status:get-message(1)
     8955                                       , return-value ).
     8956             end.
     8957             ASSIGN
     8958             FROM-MENU = NO
     8959             .
     8960             run b-res-proc in this-procedure (
     8961                                               buffer buf_inkas
     8962                                             , buffer buf_trn-doc
     8963                                             , buffer buf_ret-doc
     8964                                             , input yes
     8965                                             , input auto-close
     8966                                             , input yes
     8967                                             , input rest-dish
     8968                                             , input v-fbr-income-doc-code
     8969                                             , input p-is-tpsi-obj
     8970                                             , input rest-tpsi) no-error.
     8971             if error-status:error or return-value = "error" then do:
     8972               undo f-close, return error  substitute("Ошибка при попытке резервирования товаров, перемещенных для данной продажи:&1&2 &3" +
     8973                                       "Закрытие продажи невозможнo !"
     8974                                       , chr(10)
     8975                                       , error-status:get-message(1)
     8976                                       , return-value
     8977                                         ).
     8978             end.
     8979             if not force-auto-fbr then
     8980             assign
     8981             ii = ii + 1
     8982             .
     8983           end.
     8984           if force-auto-fbr and ii = 0 then do:
     8985             run write-log-and-file in p-log-handle (
     8986                   input 1
     8987                 , input log-file-name
     8988                 , input 1
     8989                 , input substitute("Автоматическое производство товаров, необходимых для резервирования в продаже &1", buf_inkas.inkas-code
     8990                                   , chr(10))
     8991                                   ).
     8992             run str/fbrsale.p (
     8993                           input parparentproc
     8994                           ,input this-procedure
     8995                           ,input p-log-handle
     8996                           ,input (buf_inkas.inkas-code + chr(4) +
     8997                                   (if rest-dish then "yes" else "no") + chr(4) +
     8998                                   (if rest-ingr then "yes" else "no")
     8999                                   )
     9000                         ) no-error .
     9001             if error-status:error then do:
     9002               undo f-close, return error substitute(("Ошибка при попытке производства товаров, необходимых для резервирования в продаже &1:&2&3 &4" +
     9003                                       "Закрытие продажи невозможнo !")
     9004                                       , buf_inkas.inkas-code
     9005                                       , chr(10)
     9006                                       , error-status:get-message(1)
     9007                                       , return-value ).
     9008             end.
     9009             if not rest-dish then do:
     9010               run fbrcode-get-final-doc in  this-procedure (
     9011                                                             input buf_inkas.inkas-code
     9012                                                             ,output v-fbr-income-doc-code
     9013                                                             ) no-error .
     9014               if error-status:error then do:
     9015                 undo f-close, return error substitute("Ошибка при получении кода документа ВН товаров, произведенных для резервирования в продаже:&1&2 &3"
     9016                                       , chr(10)
     9017                                       , error-status:get-message(1)
     9018                                       , return-value ).
     9019               end.
     9020             end.
     9021             ASSIGN
     9022             FROM-MENU = NO
     9023             .
     9024             run b-res-proc in this-procedure (
     9025                                                 buffer buf_Inkas
     9026                                               , buffer buf_trn-doc
     9027                                               , buffer buf_ret-doc
     9028                                               , input yes
     9029                                               , input auto-close
     9030                                               , input yes
     9031                                               , input rest-dish
     9032                                               , input v-fbr-income-doc-code
     9033                                               , input p-is-tpsi-obj
     9034                                               , input rest-tpsi) no-error.
     9035             if error-status:error or return-value = "error" then do:
     9036               undo f-close, return error  substitute("Ошибка при попытке резервирования товаров, произведенных для данной продажи&1" +
     9037                                       "Закрытие продажи невозможнo !"
     9038                                       ,chr(10)).
     9039             end.
     9040             else do:
     9041               run fbr-saledoc-create in this-procedure ( input buf_inkas.inkas-code).
     9042             end.
     9043           end.
     9044           assign
     9045           ii = ii + 1
     9046           .
     9047         end.
     9048       end.
     9049       FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_inkas ) .
     9050       FIND FIRST locked_trn-doc WHERE locked_trn-doc.doc-code = buf_inkas.inkas-code .
     9051       assign
     9052       locked_inkas.is-auto-close = (p-auto >= 2)
     9053       locked_inkas.auto-fbr   = force-auto-fbr
     9054       locked_Inkas.rest-dish  = rest-dish
     9055       locked_Inkas.rest-ingr  = rest-ingr
     9056       locked_inkas.auto-tpsi  = force-tpsi-obj
     9057       locked_inkas.rest-tpsi  = rest-tpsi
     9058       locked_Inkas.auto-comp  = auto-comp
     9059       .
     9060       if l-shift-on then do:
     9061   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     9063     (input  locked_inkas.obj-type
     9064     ,input  locked_inkas.obj-code
     9065     ,output v-shift-date
     9066     ,output v-shift-num
     9067     ,output v-shift-name
     9068     ) no-error .
     9069         if error-status:error
     9070         or not (v-shift-date = locked_inkas.shift-date
     9071                 and
     9072                 v-shift-num = locked_inkas.shift-num) then do:
     9073           find first buf_shift-obj no-lock where
     9074                     buf_shift-obj.obj-type = locked_inkas.obj-type
     9075                 and buf_shift-obj.obj-code = locked_inkas.obj-code
     9076                 and buf_shift-obj.shift-date = locked_inkas.shift-date
     9077                 and buf_shift-obj.shift-num = locked_inkas.shift-num no-error.
     9078           if not available buf_shift-obj then do:
     9079               undo f-close, return error  substitute("Не найдена смена с пор.№ &1 от &2 для &3&4&5" +
     9080                                                     "Закрытие продажи невозможнo !"
     9081                                                      ,locked_inkas.shift-num
     9082                                                      ,locked_inkas.shift-date
     9083                                                      ,locked_inkas.obj-type
     9084                                                      ,locked_inkas.obj-code
     9085                                                      ,chr(10)).
     9086           end.
     9087           if buf_shift-obj.status_ <> 'зкр':U then do:
     9088               undo f-close, return error  substitute("Смена с пор.№ &1 от &2 для &3&4 имеет статус &5&6" +
     9089                                                     "Закрытие продажи невозможнo !"
     9090                                                      ,locked_inkas.shift-num
     9091                                                      ,locked_inkas.shift-date
     9092                                                      ,locked_inkas.obj-type
     9093                                                      ,locked_inkas.obj-code
     9094                                                      ,locked_inkas.status_
     9095                                                      ,chr(10)).
     9096           end.
