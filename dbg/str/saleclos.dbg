     7293             road-tax-rubl-loc = b-doc-line.road-tax
     7294             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     7295         end.
     7296         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     7297         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     7298         assign
     7299           road-tax-cli-loc = ?.
     7300         ASSIGN
     7301           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     7302           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     7303           transport-cli-loc  = 0
