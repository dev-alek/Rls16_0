     3446   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3447   procedure tpsi-gds-fill-tpsi-obj-table :
     3448   define input parameter p-db-num like ub.db.db-num no-undo .
     3449   define variable v-is-tpsi-obj as logical no-undo .
     3450   define buffer buf_clients for ub.clients.
     3451     do
     3452     on error undo, return error return-value
     3453     :
     3454       for each temp-tpsi-clients :
     3455         delete temp-tpsi-clients.
     3456       end.
     3457       _clients:
     3458       for each buf_clients no-lock where
     3459             buf_clients.db-num = p-db-num:
     3460         assign
     3461         v-is-tpsi-obj = no.
     3462         run gbl/tpsi-obj.p (
     3463                         input buf_clients.obj-type
     3464                       ,input buf_clients.obj-code
     3465                       ,output v-is-tpsi-obj) .
     3466         if not v-is-tpsi-obj then NEXT _clients.
     3467         create temp-tpsi-clients.
     3468         buffer-copy
     3469         buf_clients to
     3470         temp-tpsi-clients.
     3471       end.
     3472     end.
     3473   end procedure.
     3474   procedure tpsi-gds-proprietor :
     3475   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3476   define input parameter p-db-num   like ub.db.db-num      no-undo .
     3477   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     3478   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     3479   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     3480   define variable v-is-tpsi-obj as logical no-undo .
     3481   do
     3482   on error undo, return error return-value
     3483   :
     3484       define buffer buf_clients for ub.clients.
     3485       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     3486       assign
     3487       p-proprietor-obj-type = "":U
     3488       p-proprietor-obj-code = ?
     3489       p-proprietor-host-code = ?
     3490       .
     3491       _gds-obj-attr:
     3492       for each buf_clients no-lock where
     3493               buf_clients.db-num = p-db-num,
     3494         each buf_gds-obj-attr no-lock where
     3495             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     3496         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     3497         AND buf_gds-obj-attr.gds-code = p-gds-code
     3498         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     3499         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     3500           assign
     3501           v-is-tpsi-obj = no.
     3502           run gbl/tpsi-obj.p (
     3503                           input buf_gds-obj-attr.obj-type
     3504                         ,input buf_gds-obj-attr.obj-code
     3505                         ,output v-is-tpsi-obj) .
     3506           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     3507           assign
     3508           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     3509           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     3510           p-proprietor-host-code = buf_clients.host-code
     3511           .
     3512           LEAVE.
     3513         end.
     3514       end.
     3515   end.
     3516   end procedure.
     3517   procedure tpsi-preselect-gds-proprietor :
     3518   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3519   define input parameter p-db-num   like ub.db.db-num      no-undo .
     3520   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     3521   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     3522   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     3523   do
     3524   on error undo, return error return-value
     3525   :
     3526       define buffer buf_clients for ub.clients.
     3527       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     3528       assign
     3529       p-proprietor-obj-type = "":U
     3530       p-proprietor-obj-code = ?
     3531       p-proprietor-host-code = ?
     3532       .
     3533       _gds-obj-attr:
     3534       for each temp-tpsi-clients no-lock where
     3535               temp-tpsi-clients.db-num = p-db-num,
     3536         each buf_gds-obj-attr no-lock where
     3537             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
     3538         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
     3539         AND buf_gds-obj-attr.gds-code = p-gds-code
     3540         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     3541         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     3542           assign
     3543           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     3544           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     3545           p-proprietor-host-code = temp-tpsi-clients.host-code
     3546           .
     3547           LEAVE.
     3548         end.
     3549       end.
     3550   end.
     3551   end procedure.
     3552   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3553   define shared temp-table dtl-rests-mark no-undo
     3554   field artic like ub.gds-dtl.artic
     3555   field prod-type like ub.gds-dtl.prod-type
     3556   field prod-code like ub.gds-dtl.prod-code
     3557   index   pi  is primary
     3558   artic
     3559   prod-type
     3560   prod-code
     3561   .
     3562   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3563   DEFINE new SHARED temp-table dtl-rests no-undo
     3564   field b-code like ub.bar-code.b-code
     3565   field artic like ub.gds-dtl.artic
     3566   field prod-type like ub.gds-dtl.prod-type
     3567   field prod-code like ub.gds-dtl.prod-code
     3568   field gds-code like ub.goods.gds-code
     3569   field prt-code like ub.gds-dtl.prt-code
     3570   field unit-base like ub.goods.unit-base
     3571   field rest-fact-qnty as decimal
     3572   field maybe-qnty as decimal
     3573   field prt-qnty as decimal
     3574   field free-qnty as decimal
     3575   field need-qnty as decimal
     3576   field gds-name like ub.goods.gds-name
     3577   field OK as logical column-label "ОК"
     3578   FIELD fbr as integer
     3579   field prop as integer
     3580   field is-neg-tpsi-oper as logical
     3581   field weight as logical
     3582   field is-neg-tpsi-qnty as logical
     3583   field is-neg-tpsi-weight as logical
     3584   field ok-prop as logical
     3585   field is-neg-rest as logical
     3586   field to-view as logical
     3587   index   pi  is primary
     3588   gds-code
     3589   prt-code ASCENDING
     3590   index   bc
     3591   b-code ASCENDING
     3592   index ifbr fbr
     3593   index iprop prop
     3594   index iok ok
     3595   index iokprop ok-prop
     3596   index iview to-view
     3597   .
     3598   define new global shared variable g#lib-farh as handle no-undo .
     3599   define new global shared variable g#lib-trn  as handle no-undo .
     3600   define new global shared variable g#lib-trn2 as handle no-undo .
     3601   define new global shared variable g#lib-trn3 as handle no-undo .
     3602   define new global shared variable g#lib-trn4 as handle no-undo .
     3603   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3604   define temp-table temp-goods no-undo
     3605   field doc-code like ub.chk-gds.doc-code
     3606   field line-num like ub.chk-gds.line-num
     3607   field object-sum like ub.chk-discnt.object-sum
