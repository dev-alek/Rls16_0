    10140                          )
    10141           b-gds-dtl.fact-qnty = b-gds-dtl.fact-qnty - cvp
    10142           br-gds-dtl.fact-qnty = br-gds-dtl.fact-qnty - cvp
    10143           br-doc-line.fact-qnty = br-doc-line.fact-qnty - cvp
    10144           b-doc-line.fact-qnty = b-doc-line.fact-qnty - cvp
    10145           qnty-compense = qnty-compense + cvp
    10146           qnty-compense-abs = qnty-compense-abs + abs(cvp)
    10147           no-error .
    10148           if (v-curr-r-b = 'base':U and b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
    10149           OR (v-curr-r-b = 'rubl':U and b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
    10150           then do:
    10151             if v-curr-r-b = 'base':U then do:
    10152               assign
    10153               br-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty <> 0
    10154                                         then (br-gds-dtl.price-base - ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base) +
    10155                                                                      tsall )  / br-gds-dtl.fact-qnty )
    10156                                         else br-gds-dtl.discnt-base )
    10157               b-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
    10158                                         then (b-gds-dtl.price-base - ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
    10159                                                                      tsall ) / b-gds-dtl.fact-qnty  )
    10160                                         else b-gds-dtl.discnt-base )
    10161               br-gds-dtl.discnt-rubl =  br-gds-dtl.discnt-BASE * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
    10162               b-gds-dtl.discnt-rubl =   b-gds-dtl.discnt-BASE * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
    10163               .
    10164             end.
    10165             else do:
    10166               assign
    10167               br-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty <> 0
    10168                                         then (br-gds-dtl.price-rubl -
    10169                                                                     ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl) +
    10170                                                                    tsall )  / br-gds-dtl.fact-qnty
    10171                                                                      )
    10172                                        else br-gds-dtl.discnt-rubl
    10173                                        )
    10174               b-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
    10175                                        then (b-gds-dtl.price-rubl -
    10176                                                                  ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
    10177                                                                tsall ) / b-gds-dtl.fact-qnty
    10178                                              )
    10179                                       else b-gds-dtl.discnt-rubl
    10180                                       )
    10181               br-gds-dtl.discnt-base =  br-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
    10182               b-gds-dtl.discnt-base =   b-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
    10183               .
    10184             end.
    10185         end.
    10186         release b-gds-dtl.
    10187         release br-gds-dtl.
    10188       end.
    10189       IF lookup('2ед':U, buf_units.type) = 0 then do:
    10190         for each b-gds-dtl where
    10191                  b-gds-dtl.doc-code = buf_ret-doc.doc-code AND
    10192                  b-gds-dtl.artic = b-doc-line.artic AND
    10193                  b-gds-dtl.prod-type = b-doc-line.prod-type AND
    10194                  b-gds-dtl.prod-code = b-doc-line.prod-code:
    10195             find first br-gds-dtl where
    10196                        br-gds-dtl.doc-code = buf_trn-doc.doc-code AND
    10197                        br-gds-dtl.artic = b-gds-dtl.artic AND
    10198                        br-gds-dtl.prod-type = b-gds-dtl.prod-type AND
    10199                        br-gds-dtl.prod-code = b-gds-dtl.prod-code AND
    10200                        br-gds-dtl.prt-code = b-gds-dtl.prt-code NO-ERROR.
    10201             find first brw-gds-dtl where
    10202                        brw-gds-dtl.doc-code = v-return-write-off-code AND
    10203                        brw-gds-dtl.artic = b-gds-dtl.artic AND
    10204                        brw-gds-dtl.prod-type = b-gds-dtl.prod-type AND
    10205                        brw-gds-dtl.prod-code = b-gds-dtl.prod-code AND
    10206                        brw-gds-dtl.prt-code = b-gds-dtl.prt-code NO-ERROR.
    10207             IF AVAILABLE br-gds-dtl then do:
    10208                 if b-gds-dtl.doc-qnty = b-gds-dtl.fact-qnty AND br-gds-dtl.doc-qnty = br-gds-dtl.fact-qnty then NEXT _docline.
    10209                 if (v-curr-r-b = 'base':U and br-gds-dtl.price-base <> b-gds-dtl.price-base)
    10210                 OR (v-curr-r-b = 'rubl':U and br-gds-dtl.price-rubl <> b-gds-dtl.price-rubl)
    10211                 then NEXT _docline.
    10212                 assign
    10213                 cv = MAXIMUM(b-gds-dtl.fact-qnty - b-gds-dtl.doc-qnty - (if available brw-gds-dtl then brw-gds-dtl.fact-qnty else 0)
    10214                            , br-gds-dtl.fact-qnty - br-gds-dtl.doc-qnty)
    10215                 cv = if b-gds-dtl.fact-qnty < cv then b-gds-dtl.fact-qnty else cv
    10216                 cv = if (br-gds-dtl.fact-qnty  - (if available brw-gds-dtl then brw-gds-dtl.fact-qnty else 0)) < cv
    10217                      then br-gds-dtl.fact-qnty
    10218                      else cv
    10219                 cv = MINIMUM(cv, old-doc-line-fact-qnty-r - (saled-by-place-r + saled-by-parts-r))
    10220                 cv = MINIMUM(cv, old-doc-line-fact-qnty-v - (saled-by-place-v + saled-by-parts-v) -
    10221                                  (old-doc-line-fact-qnty-rw - (saled-by-place-rw + saled-by-parts-rw))
    10222                              )
    10223                 unresv = cv - (b-gds-dtl.fact-qnty - b-gds-dtl.doc-qnty)
    10224                 unresr = cv - (br-gds-dtl.fact-qnty - br-gds-dtl.doc-qnty)
    10225                 .
    10226                 if
    10227                 b-gds-dtl.fact-qnty - cv = 0 AND
    10228                 br-gds-dtl.fact-qnty - cv = 0 AND
    10229                 ((v-curr-r-b = 'base':U and b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
    10230                 OR
    10231                  (v-curr-r-b = 'rubl':U and b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
    10232                 )
    10233                  then do:
    10234                     if cv > 1 then
    10235                     assign
    10236                     cv = cv - 1
    10237                     unresv = unresv - 1
    10238                     unresr = unresr - 1
    10239                     .
    10240                     else NEXT _docline.
    10241                 end.
    10242                 if unresv > 0 then do:
    10243                     assign
    10244                     rdoc-line = recid (b-doc-line)
    10245                     rgds-dtl = recid(b-gds-dtl)
    10246                     r-qnty =  - unresv
    10247                     r-b-code = ?
    10248                     r-doc-prts-qnty = ?
    10249                     r-or-v = 'rs':U
    10250                     r-office = 'т':U
    10251                     from-menu = yes.
    10252                     run b-unres-proc in this-procedure (
    10253                                           buffer buf_inkas
    10254                                         , buffer buf_trn-doc
    10255                                         , buffer buf_ret-doc
    10256                                         , input p-is-tpsi-obj
    10257                                         , input yes) no-error.
    10258                     if error-status:error then do:
    10259                       undo _docline, return error.
    10260                     end.
    10261                 end.
    10262                 if unresr > 0 then do:
    10263                     assign
    10264                     rdoc-line = recid (br-doc-line)
    10265                     rgds-dtl = recid(br-gds-dtl)
    10266                     r-qnty =  - unresr
    10267                     r-b-code = ?
    10268                     r-doc-prts-qnty = ?
    10269                     r-or-v = 'es':U
    10270                     r-office = 'т':U
    10271                     from-menu = yes.
    10272                     run b-unres-proc in this-procedure (
    10273                                           buffer buf_inkas
    10274                                         , buffer buf_trn-doc
    10275                                         , buffer buf_ret-doc
    10276                                         , input p-is-tpsi-obj
    10277                                         , input yes) no-error.
    10278                     if error-status:error then do:
    10279                       undo _docline, return error.
    10280                     end.
    10281                 end.
    10282                 assign
    10283                 tsall = (if v-curr-r-b = 'base':U
    10284                          then (br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
    10285                                b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base))
    10286                          else (br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
    10287                                b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl))
    10288                          )
    10289                 b-gds-dtl.fact-qnty = b-gds-dtl.fact-qnty - cv
    10290                 br-gds-dtl.fact-qnty = br-gds-dtl.fact-qnty - cv
    10291                 br-doc-line.fact-qnty = br-doc-line.fact-qnty - cv
    10292                 b-doc-line.fact-qnty = b-doc-line.fact-qnty - cv
    10293                 qnty-compense = qnty-compense + cv
    10294                 qnty-compense-abs = qnty-compense-abs + abs(cv)
    10295                 .
    10296                 if (v-curr-r-b = 'base':U and b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
    10297                 OR (v-curr-r-b = 'rubl':U and b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
    10298                   then do:
    10299                 if v-curr-r-b = 'base':U then do:
    10300                   assign
    10301                   br-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty <> 0
    10302                                             then (br-gds-dtl.price-base - ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base) +
    10303                                                                            tsall )  / br-gds-dtl.fact-qnty )
    10304                                             else br-gds-dtl.discnt-base )
    10305                   br-gds-dtl.discnt-rubl = br-gds-dtl.discnt-base * (buf_trn-doc.base-rate / buf_trn-doc.base-scale )
    10306                   b-gds-dtl.discnt-rubl =  b-gds-dtl.discnt-base * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
    10307                   .
    10308                 end.
    10309                 else do:
    10310                   assign
    10311                   br-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty <> 0
    10312                                             then (br-gds-dtl.price-rubl - ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl) +
    10313                                                                           tsall )  / br-gds-dtl.fact-qnty )
    10314                                             else br-gds-dtl.discnt-rubl )
    10315                   b-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
    10316                                            then (b-gds-dtl.price-rubl -  ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
    10317                                                                           tsall ) / b-gds-dtl.fact-qnty )
    10318                                           else b-gds-dtl.discnt-rubl)
    10319                   br-gds-dtl.discnt-base = br-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
    10320                   b-gds-dtl.discnt-base =  b-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
    10321                   .
    10322                 end.
    10323               end.
    10324             end.
    10325         end.
    10326       end.
    10327       if is-gas(b-goods.gds-code) then v-gas-compensed = true .
    10328   end.
    10329   FIND FIRST b-doc where b-doc.doc-code = buf_trn-doc.doc-code No-ERROR.
    10330   assign
    10331   b-doc.fact-qnty = b-doc.fact-qnty - qnty-compense.
    10332   FIND FIRST b-doc where b-doc.doc-code = buf_ret-doc.doc-code No-ERROR.
    10333   if available b-doc then do:
    10334     assign
    10335     b-doc.fact-qnty = b-doc.fact-qnty - qnty-compense
    10336     .
    10337   end.
    10338   if qnty-compense-abs <> 0 then
    10339   note-compense = chr(10) + "Проведено компенсирование расхода/возврата".
    10340   run waitfram-hide in this-procedure .
    10341   if p-auto = 0 then do:
    10342     run UI-on in p-parent-handle.
    10343     run ui-2 in p-parent-handle.
    10344   end.
    10345   END PROCEDURE.
    10346   PROCEDURE INKAS-CLOSING:
    10347   define input parameter p-back-date as logical no-undo .
    10348   define input parameter p-is-inquiry as logical no-undo .
    10349   define parameter buffer locked_inkas for ub.inkas.
    10350   define variable for-netto as  decimal no-undo.
    10351   define variable for-write-off as  decimal no-undo.
    10352   define variable ps-where-rus as character no-undo .
    10353   define variable v-rec-id as recid no-undo .
    10354   define variable line-out as integer no-undo.
    10355   define variable line-ret as integer no-undo.
    10356   define variable dtl-out as integer no-undo.
    10357   define variable dtl-ret as integer no-undo.
    10358   define variable gds-amount  as integer .
    10359   define variable chk-amount  as integer .
    10360   define variable nf-gds-amount  as integer .
    10361   define variable nf-chk-amount  as integer .
    10362   define variable varminus-parts as logical   no-undo .
    10363   define variable varminus-parts-type as character no-undo .
    10364   define variable v-sale-sum as decimal no-undo .
    10365   define variable v-discnt-sum as decimal no-undo .
    10366   define variable v-curr-tot-dtl  as integer no-undo .
    10367   define variable v-curr-tot-lines as integer no-undo .
    10368   define variable v-ps-label as character no-undo .
    10369   define variable v-note-compense as character no-undo .
    10370   define variable v-exch-rate as decimal no-undo .
    10371   define variable v-dont-touch as logical no-undo .
    10372   define variable v-doc-ii as integer no-undo .
    10373   define variable v-chr-office-ii as integer no-undo .
    10374   define variable v-docs-sum as character no-undo .
    10375   define variable current-netto as decimal no-undo .
    10376   define variable current-write-off as decimal no-undo .
    10377   define variable varchip-code as integer   no-undo .
    10378   define variable varchip-code2 as integer   no-undo .
    10379   define variable v-gds-amount as integer no-undo .
    10380   DEFINE VARIABLE v-today as date no-undo .
    10381   DEFINE VARIABLE v-time as integer no-undo .
    10382   define variable v-attr-value as character no-undo .
    10383   define variable v-type as character no-undo .
    10384   define variable v-run-tpsi-line as logical no-undo .
    10385   define variable v-is-petrol as logical   no-undo .
    10386   define variable v-is-pieces as logical   no-undo .
    10387   define variable chk-prs  as   logical no-undo.
    10388   define variable v-param-type as character no-undo .
    10389   define variable v-value-character as date no-undo .
    10390   define variable v-value-date as date no-undo .
    10391   define variable v-value-decimal as decimal no-undo .
    10392   define variable v-value-integer as INTEGER no-undo .
    10393   define variable v-tth as handle no-undo .
    10394   define buffer buf_clients for ub.clients.
    10395   define buffer buf_goods for ub.goods.
    10396   define buffer buf_sale-doc for ub.sale-doc.
    10397   define buffer locked_trn-doc for ub.trn-doc.
    10398   define buffer buf_doc-line for ub.doc-line.
    10399   define buffer upd_doc-line for ub.doc-line.
    10400   define buffer buf_gds-dtl  for ub.gds-dtl.
    10401   define buffer buf-in for ub.trn-doc.
    10402   define buffer buf_chk-doc for ub.chk-doc .
    10403   define buffer buf_inkas-pay for ub.inkas-pay.
    10404   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
    10405   define buffer buf_doc-fbr-gds for ub.doc-fbr-gds .
    10406   _main:
    10407   DO ON ERROR undo _main, return error:
    10408       run get-inkas-ps in this-procedure (
    10409                                           buffer locked_inkas
    10410                                         , output chk-amount
    10411                                         , output gds-amount
    10412                                         , output line-out
    10413                                         , output dtl-out
    10414                                         , output line-ret
    10415                                         , output dtl-ret
    10416                                         , output nf-chk-amount
    10417                                         , output nf-gds-amount
    10418                                         , output ps-where-rus
    10419                                         ).
    10420     run adm/shattri.p (
    10421         input "get":U
    10422         ,input ''
    10423         ,input 0
    10424         ,input 'nakl-glob':U
    10425         ,input 'chk-prs':U
    10426         ,output v-value-character
    10427         ,output v-value-date
    10428         ,output v-value-decimal
    10429         ,output v-value-integer
    10430         ,output chk-prs
    10431         ,output v-param-type
    10432         ,INPUT-OUTPUT table-handle v-tth
    10433         ) no-error .
    10434     delete object v-tth no-error.
    10435     for each buf_sale-doc where
    10436             buf_sale-doc.inkas-code = locked_inkas.inkas-code
    10437          and buf_sale-doc.order > 0
    10438     by buf_sale-doc.order
    10439     :
    10440       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Считаем итоги по док-ту &1 (&2 &3) ...", buf_sale-doc.doc-code, entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.chr-office)                                       ).
    10441       find first locked_trn-doc where
    10442                 locked_trn-doc.doc-code = buf_sale-doc.doc-code.
    10443       if chk-prs = yes then do:
    10444         find first buf_clients where buf_clients.obj-type = 'чел':U          and
    10445                                     buf_clients.obj-code = locked_trn-doc.boss no-lock no-error.
    10446         if not available buf_clients then do:
    10447           undo _main, return error substitute("Не указан или неправильный менеджер в &1", locked_trn-doc.doc-code).
    10448         end.
    10449         find first buf_clients where buf_clients.obj-type = 'чел':U          and
    10450                                     buf_clients.obj-code = locked_trn-doc.agnt no-lock no-error.
    10451         if not available buf_clients then do:
    10452             undo _main, return error substitute("Не указан или неправильный исполнитель в &1", locked_trn-doc.doc-code).
    10453         end.
    10454       end.
    10455       run gbl/calc-trn.p ( input parparentproc, input recid(locked_trn-doc)).
    10456       if buf_sale-doc.doc-kind = 'trf':U or buf_sale-doc.doc-kind = 'vir':U
    10457           or buf_sale-doc.doc-kind = 'none' or ( buf_sale-doc.doc-kind = 'swo':U) then do:
    10458       end.
    10459       else do:
    10460         if buf_sale-doc.in-inkas then
    10461         assign
    10462         current-netto = if v-curr-r-b = 'rubl':U
    10463                     then locked_trn-doc.tot-sale - locked_trn-doc.discnt-rubl
    10464                     else locked_trn-doc.tot-fact - locked_trn-doc.tot-calc
    10465         for-netto = for-netto + current-netto * buf_sale-doc.dir
    10466         v-docs-sum = v-docs-sum + (if v-docs-sum = '':U then '':U else chr(10)) +
    10467                               substitute("&1 = &2"
    10468                                 , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
    10469                                 , current-netto
    10470                               ).
    10471               .
    10472         if buf_sale-doc.doc-type = 'спи':U then do:
    10473         assign
    10474         current-write-off = if v-curr-r-b = 'rubl':U
    10475                     then locked_trn-doc.tot-sale - locked_trn-doc.discnt-rubl
    10476                     else locked_trn-doc.tot-fact - locked_trn-doc.tot-calc
    10477         for-write-off = for-write-off + current-write-off
    10478         v-docs-sum = v-docs-sum + (if v-docs-sum = '':U then '':U else chr(10)) +
    10479                               substitute("&1 = &2"
    10480                                 , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
    10481                                 , current-write-off
    10482                               ).
    10483       end.
    10484       end.
    10485     end.
    10486     if abs(locked_inkas.netto - (for-netto  - (locked_inkas.sub-discnt - for-write-off))) > 0.015
    10487     then do:
    10488       undo _main, return error substitute("Невозможно закрыть продажу&1" +
    10489                               "Несовпадение суммы нетто по продаже и накладным &2&1" +
    10490                               "Сумма выручки по продаже - &3&1" +
    10491                               "Сумма списания - &4&1" +
    10492                              "Суммы по накладным (с учетом направления движения товара) - &5:&1&6"
    10493                             , chr(10)
    10494                             , abs(locked_inkas.netto - (for-netto - (locked_inkas.sub-discnt - for-write-off)))
    10495                             , locked_inkas.netto
    10496                             , locked_inkas.sub-discnt
    10497                             , (for-netto  - (locked_inkas.sub-discnt - for-write-off))
    10498                             , v-docs-sum
    10499                             ).
    10500     end.
    10501     run cur-time in this-procedure ( output v-today, output v-time).
    10502     locked_inkas.PS = ''.
    10503     _v-doc-ii:
    10504       do v-doc-ii = 1 to num-entries('es,rs,rwo,trf,swo,ngs,rgs,vir':U)
    10505       on error undo _main, return error:
    10506         do v-chr-office-ii = 1 to 2
    10507         on error undo _main, return error:
    10508           find first buf_sale-doc where
    10509                   buf_sale-doc.inkas-code = locked_inkas.inkas-code
    10510               and  buf_sale-doc.order = v-doc-ii * 100  + (if v-chr-office-ii = 1 then 0 else 5) no-error .
    10511           if available buf_sale-doc  then do:
    10512             find first locked_trn-doc where locked_trn-doc.doc-code = buf_sale-doc.doc-code.
    10513             if not (buf_sale-doc.doc-kind = 'es':U
    10514                    and
    10515                    buf_sale-doc.chr-office = 'т':U
    10516                    )
    10517             then do:
    10518               if (if v-curr-r-b = 'base':U
    10519                 then locked_trn-doc.tot-fact
    10520                 else  locked_trn-doc.tot-sale) = 0
    10521               and not can-find(first ub.doc-line no-lock where ub.doc-line.doc-code = locked_trn-doc.doc-code) then do:
    10522                 assign
    10523                 locked_trn-doc.status_ = 'накл':U.
    10524                 run str/del-doc.p (
    10525                     input  parparentproc,
    10526                     input  locked_trn-doc.doc-code,
    10527                     input  g#db-num,
    10528                     input  "del-doc.err",
    10529                     input  ?,
    10530                     input  ?,
    10531                     input  g#userid,
    10532                     input  '0',
    10533                     input  varchip-code,
    10534                     output varchip-code2)
    10535                     no-error.
    10536                 if error-status :error then do:
    10537                     undo _main, return error  substitute("Ошибка при удалении ПУСТОГО документа &1 &2 &3 по продаже &4&5&6&5&7" +
    10538                                           "Закрытие продажи невозможнo !"
    10539                                           , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
    10540                                           , buf_sale-doc.chr-office
    10541                                           , buf_sale-doc.doc-code
    10542                                           , p-inkas-code
    10543                                           ,chr(10)
    10544                                           , error-status:get-message(1)
    10545                                           , return-value
    10546                                           ).
    10547                 end.
    10548                 delete buf_sale-doc.
    10549               end.
    10550             end.
    10551           end.
    10552           if available buf_sale-doc  then do:
    10553             find first locked_trn-doc where locked_trn-doc.doc-code = buf_sale-doc.doc-code.
    10554             if not (buf_sale-doc.doc-kind = 'es':U
    10555                     and
    10556                     buf_sale-doc.chr-office = 'т':U)
    10557             then do:
    10558               if (if v-curr-r-b = 'base':U
    10559                 then locked_trn-doc.tot-fact
    10560                 else  locked_trn-doc.tot-sale) = 0
    10561               and not can-find(first doc-line no-lock where doc-line.doc-code = locked_trn-doc.doc-code) then do:
    10562                 assign
    10563                 locked_trn-doc.status_ = 'накл':U.
    10564                 run str/del-doc.p (
    10565                     input  parparentproc,
    10566                     input  locked_trn-doc.doc-code,
    10567                     input  g#db-num,
    10568                     input  "del-doc.err",
    10569                     input  ?,
    10570                     input  ?,
    10571                     input  g#userid,
    10572                     input  '0',
    10573                     input  varchip-code,
    10574                     output varchip-code2)
    10575                     no-error.
    10576                 if error-status :error then do:
    10577                     undo _main, return error  substitute("Ошибка при удалении ПУСТОГО документа &1 &2 &3 по продаже &4&5&6&5&7" +
    10578                                           "Закрытие продажи невозможнo !"
    10579                                           , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
    10580                                           , buf_sale-doc.chr-office
    10581                                           , buf_sale-doc.doc-code
    10582                                           , p-inkas-code
    10583                                           ,chr(10)
    10584                                           , error-status:get-message(1)
    10585                                           , return-value
    10586                                           ).
    10587                 end.
    10588                 delete buf_sale-doc.
    10589               end.
    10590             end.
    10591           end.
    10592           if not available buf_sale-doc then do:
    10593                   assign
    10594             v-curr-tot-dtl = 0
    10595             v-curr-tot-lines = 0
    10596             v-ps-label = entry (lookup (entry(v-doc-ii, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U), 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
    10597             v-sale-sum = 0
    10598             v-discnt-sum = 0
    10599             .
    10600           end.
    10601           else do:
    10602                       for each buf_doc-line no-lock where
    10603                     buf_Doc-line.doc-code = buf_sale-doc.doc-code
    10604             on error undo _main, return error :
    10605               find first goods no-lock where goods.artic = buf_doc-line.artic
    10606                                          and goods.prod-type = buf_doc-line.prod-type
    10607                                          and goods.prod-code = buf_doc-line.prod-code
    10608                                          .
    10609               RUN gds-attr-value (
    10610                                   INPUT goods.gds-code,
    10611                                   INPUT 'mark-type':U,
    10612                                   OUTPUT v-attr-value,
    10613                                   OUTPUT v-type
    10614                                   ).
    10615               if v-attr-value > ""
    10616               and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
    10617               and buf_doc-line.doc-qnty <> buf_doc-line.fact-qnty
    10618               and (buf_sale-doc.doc-kind = 'rs':U or buf_sale-doc.doc-kind = 'es':U)
    10619               then do:
    10620                 find first upd_doc-line exclusive-lock where rowid(upd_doc-line) = rowid(buf_doc-line) .
    10621                 FIND FIRST gds-prt NO-LOCK WHERE
    10622                           gds-prt.upper-code = goods.prt-root NO-ERROR.
    10623                 if buf_sale-doc.doc-kind = 'es':U
    10624                 then do :
    10625                   run RSRV-line in this-procedure (
    10626                         input 1,
    10627                         input no,
    10628                         input no ,
    10629                         input no,
    10630                         input no,
    10631                         input "",
    10632                         input no,
    10633                         input no,
    10634                         input yes,
    10635                         input goods.gds-code,
    10636                         input (if available gds-prt then gds-prt.node-code else ?),
    10637                         output v-run-tpsi-line,
    10638                         buffer upd_doc-line,
    10639                         buffer buf_trn-doc,
    10640                         buffer buf_sale-doc
    10641                         ) no-error.
    10642                 end .
    10643                 else do :
    10644                   run RSRV-line in this-procedure (
    10645                         input -1,
    10646                         input no,
    10647                         input no ,
    10648                         input no,
    10649                         input no,
    10650                         input "",
    10651                         input no,
    10652                         input no,
    10653                         input yes,
    10654                         input goods.gds-code,
    10655                         input (if available gds-prt then gds-prt.node-code else ?),
    10656                         output v-run-tpsi-line,
    10657                         buffer upd_doc-line,
    10658                         buffer buf_ret-doc,
    10659                         buffer buf_sale-doc
    10660                         ) no-error.
    10661                 end .
