     5664   end.
     5665   for each chk-doc no-lock where chk-doc.out-code = p-inkas-code :
     5666     if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next .
     5667     find first chk-gds no-lock where chk-gds.doc-code = chk-doc.doc-code no-error.
