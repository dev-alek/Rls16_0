     8415     ,output par-type
     8416     ) no-error .
     8417     if not error-status :error
     8418     and par-type = 'L':U then do:
     8419        assign
     8420        v-is-ptrl = logical(conf-par)
     8421        no-error
     8422        .
     8423     end.
     8424     run fbrhist-read-conf in this-procedure .
     8425     if p-auto < 2 then do:
     8426       if NOT auto-close then do:
     8427         if p-auto = 0 and NOT b-mail-pressed  then do:
     8428           glog = no.
     8429           message
     8430           "В течение данного сеанса работы с продажей вы не докачивали новые чеки!" skip
     8431           "Вы уверены, что хотите закрыть продажу?"
     8432           view-as alert-box WARNING  buttons YES-NO update glog.
     8433           if not glog then return error.
     8434         end.
     8435       end.
     8436       if NOT auto-close
     8437       or p-auto = 1 then do:
     8438         run str/chk-inf.p (
     8439                    input parparentproc
     8440                   ,input buf_inkas.host-code
     8441                   ,input buf_inkas.obj-type
     8442                   ,input buf_inkas.obj-code
     8443                   ,input no
     8444                   ,input yes
     8445                   ,input recid(buf_inkas)
     8446                   ,output v-notes
     8447                   ,output not-all-saled-chk
     8448                   ,output not-all-normal-chk
     8449                   ,output not-all-inkas-closed
     8450                    ).
     8451         run gbl/d-askw.w
     8452         (input substitute("Закрытие отчета о продаже&1",
     8453                           ( if g#db-num > 0 then " и отправка его в офис" else "" )
     8454                         )
     8455         ,input v-notes
     8456         ,input "|^"
     8457         ,input "Закрыть|Не закрывать"
     8458         ,input "Закрытый отчет нельзя исправить|"
     8459             +  "Проверить документ еще раз"
     8460         ,input 1
     8461         ,input 2
     8462         ,output case-num
     8463         ).
     8464         if case-num = 2 then do:
     8465           return error.
     8466         end.
     8467       end.
     8468     end.
     8469   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8471     (input  buf_inkas.obj-type
     8472     ,input  buf_inkas.obj-code
     8473     ,input  'shift-on=request'
     8474     ,output l-shift-on
     8475     )  .
     8476     if not l-shift-on then do:
     8477       run adm/shattri.p (
     8478           input "get":U
     8479           ,input buf_inkas.obj-type
     8480           ,input buf_inkas.obj-code
     8481           ,input  'autosale':U
     8482           ,input  'close-day-period':U
     8483           ,output v-value-character
     8484           ,output v-value-date
     8485           ,output v-value-decimal
     8486           ,output v-value-integer
     8487           ,output v-close-day-period
     8488           ,output v-param-type
     8489           ,INPUT-OUTPUT table-handle v-tth
     8490           ) no-error .
     8491       delete object v-tth no-error.
     8492     end.
     8493     if v-close-day-period then do:
     8494       define variable v-continue as logical no-undo .
     8495       run str/salechpe.p ( input parparentproc
     8496                           ,input p-log-handle
     8497                           ,input p-auto
     8498                           ,input buf_inkas.inkas-code
     8499                           ,output v-continue
     8500                           ) no-error.
     8501       if not v-continue then do:
     8502         return error ''.
     8503       end.
     8504     end.
     8505     glog = no.
     8506     RUN Inv-chk in this-procedure  (
     8507                   input buf_inkas.inkas-code
     8508                 , input v-curr-r-b
     8509                 , buffer buf_inkas
     8510                 , buffer buf_trn-doc
     8511                 , input ?
     8512                 , input ?
     8513                 , input ? ) no-error .
     8514     IF error-status:error  then undo, return error return-value .
     8515     run fbrhist-init in this-procedure.
     8516     assign
     8517     BadTrans = no
     8518     compensed = no
     8519     .
     8520     if p-auto <> 0 then do:
     8521       if can-find(first tpsi_sale-doc where
     8522                        tpsi_sale-doc.inkas-code = buf_inkas.inkas-code
     8523                    and tpsi_sale-doc.tpsidoc = yes )
     8524       then p-is-tpsi-obj = yes.
     8525       if p-is-tpsi-obj then do:
     8526         run tpsi-gds-fill-tpsi-obj-table in this-procedure (input v-db-num) no-error .
     8527         if error-status:error then do:
     8528         undo, return error
     8529           substitute("Ошибки при заполнении врем. таблицы объектов-членов ТПСИ на БД &1:&2&3 &4"
     8530                     , v-db-num
     8531                     , chr(10)
     8532                     , error-status:get-message(1)
     8533                     , return-value ).
     8534         end.
     8535       end.
     8536       if (p-is-tpsi-obj)
     8537       and not v-is-inquiry
     8538       then do:
     8539   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Ждите.. получение информации по резервированию ЧУЖИХ товаров"                                       ).
     8540         run fill-tt-tpsi-table  in this-procedure (
     8541                                                       buf_inkas.inkas-code
     8542                                                     , buf_Inkas.host-code
     8543                                                     , buf_inkas.obj-type
     8544                                                     , buf_Inkas.obj-code).
     8545         run waitfram-hide in this-procedure .
     8546       end.
     8547     end.
     8548     f-close:
     8549     DO  on ERROR undo, return error return-value
     8550         on STOP undo, return error return-value :
     8551       if auto-fbr
     8552       then do :
     8553         doc-fbr-gds_ :
     8554         for each bf_doc-fbr-gds no-lock where bf_doc-fbr-gds.out-code = p-inkas-code,
     8555           first buf_goods no-lock where buf_goods.gds-code = bf_doc-fbr-gds.gds-code,
     8556           first out-dtl no-lock where out-dtl.doc-code  = bf_doc-fbr-gds.out-code
     8557                                   and out-dtl.artic     = buf_goods.artic
     8558                                   and out-dtl.prod-type = buf_goods.prod-type
     8559                                   and out-dtl.prod-code = buf_goods.prod-code
     8560         :
     8561           if out-dtl.doc-qnty <> out-dtl.fact-qnty
     8562           then do :
     8563             find first ret-dtl no-lock where ret-dtl.doc-code  = replace(out-dtl.doc-code, "-", "=")
     8564                                          and ret-dtl.artic     = out-dtl.artic
     8565                                          and ret-dtl.prod-type = out-dtl.prod-type
     8566                                          and ret-dtl.prod-code = out-dtl.prod-code
     8567                                          and ret-dtl.prt-code  = out-dtl.prt-code
     8568                                          no-error .
     8569             if available ret-dtl
     8570             and ret-dtl.fact-qnty > 0
     8571             and ret-dtl.fact-qnty = ret-dtl.doc-qnty
     8572             then do :
     8573               find first buf_doc-line no-lock where buf_doc-line.doc-code   = ret-dtl.doc-code
     8574                                                 and buf_doc-line.artic      = ret-dtl.artic
     8575                                                 and buf_doc-line.prod-type  = ret-dtl.prod-type
     8576                                                 and buf_doc-line.prod-code  = ret-dtl.prod-code
     8577                                                 no-error .
     8578               if available buf_doc-line
     8579               then do :
     8580                 assign
     8581                   rdoc-line = recid (buf_doc-line)
     8582                   rgds-dtl = recid(ret-dtl)
     8583                   r-qnty =  - ret-dtl.fact-qnty
     8584                   r-b-code = ?
     8585                   r-or-v = 'rs':U
     8586                   r-office = 'т':U
     8587                   from-menu = yes
     8588                 .
     8589                 run b-unres-proc in this-procedure (
     8590                                       buffer buf_inkas
     8591                                     , buffer buf_trn-doc
     8592                                     , buffer buf_ret-doc
     8593                                     , input p-is-tpsi-obj
     8594                                     , input yes) no-error.
     8595                 if error-status:error then do:
     8596                   undo doc-fbr-gds_, return error.
     8597                 end.
     8598               end .
     8599             end .
     8600           end .
     8601         end .
     8602       end .
     8603       if auto-comp
     8604       and not v-is-inquiry
     8605       and can-find(first ub.sale-doc where
     8606                         ub.sale-doc.inkas-code = p-inkas-code
     8607                      and ub.sale-doc.doc-kind = 'rs':U
     8608                      and ub.sale-doc.chr-office = 'т':U
     8609                      )
     8610       then do:
     8611           RUN compense in this-procedure ( input p-inkas-code
     8612                                           ,input p-is-tpsi-obj
     8613                                           ,input rest-tpsi) no-error.
     8614          if error-status:error then undo f-close, return error.
     8615          compensed = yes.
     8616       end.
     8617       run set-compensed in p-parent-handle(input compensed) no-error .
     8618       run compense-tabak in this-procedure (input p-inkas-code) no-error .
     8619       if error-status:error then undo f-close, return error.
     8620       v-gas-income-created = "" .
     8621       if buf_trn-doc.ext-doc-type = 'es':U then do:
     8622           run thbjattr_value in this-procedure (input v-obj-type
     8623                                                ,input v-obj-code
     8624                                                ,input 'autosale':U
     8625                                                ,input 'sale-add':U
     8626                                                ,output v-value-character
     8627                                                ,output v-value-date
     8628                                                ,output v-value-decimal
     8629                                                ,output v-value-integer
     8630                                                ,output v-value-logical
     8631                                                ,output v-param-type
     8632                                                ,output v-found) no-error.
     8633           assign
     8634           v-gas-cli-type = ""
     8635           v-gas-cli-code = 0.
     8636           jj:
     8637           do jj = 1 to num-entries(v-value-character, ';':U):
     8638               v-entry = entry(jj, v-value-character, ';':U).
     8639               if entry(1, v-entry) = 'ngs':U and integer(entry(3, v-entry)) > 0 then do:
     8640                   assign
     8641                   v-gas-cli-type = entry(2, v-entry)
     8642                   v-gas-cli-code = integer(entry(3, v-entry)).
     8643                   leave jj.
     8644               end.
     8645           end.
     8646           if v-gas-cli-code > 0 then do:
     8647               for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code:
     8648                   find first buf_goods where buf_goods.prod-code = buf_doc-line.prod-code
     8649                                          and buf_goods.prod-type = buf_doc-line.prod-type
     8650                                          and buf_goods.artic = buf_doc-line.artic no-lock.
     8651                   if is-gas(buf_goods.gds-code) then do:
     8652                       find first buf_sale-doc where buf_sale-doc.inkas-code = p-inkas-code.
     8653                       run str/gas-autosl.p (input parparentproc,
     8654                                             input p-log-handle,
     8655                                             input log-file-name,
     8656                                             input p-auto,
     8657                                             input p-inkas-code,
     8658                                             input v-curr-r-b,
     8659                                             input v-gas-cli-type,
     8660                                             input v-gas-cli-code,
