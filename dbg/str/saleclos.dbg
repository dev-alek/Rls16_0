     9363   end procedure.
     9364   procedure compense-tabak :
     9365     define input parameter p-inkas-code as character no-undo .
     9366     define variable cv as decimal no-undo.
     9367     define variable unresv as decimal no-undo.
     9368     define variable unresr as decimal no-undo.
     9369     define buffer b-goods for goods.
     9370     define buffer b-gds-dtl for gds-dtl.
     9371     define buffer brw-gds-dtl for gds-dtl.
     9372     define buffer br-gds-dtl for gds-dtl.
     9373     define buffer b-doc-line for doc-line.
     9374     define buffer br-doc-line for doc-line.
     9375     define buffer brw-doc-line for doc-line.
     9376     define buffer b-doc for trn-doc.
     9377     define buffer b-doc-prts for doc-prts.
     9378     define buffer brw-doc-prts for doc-prts.
     9379     define buffer b-doc-pl for doc-pl.
     9380     define buffer brw-doc-pl for doc-pl.
     9381     define buffer b-gds-prt for gds-prt.
     9382     define variable qnty-compense as decimal no-undo.
     9383     define variable qnty-compense-abs as decimal no-undo.
     9384     define variable tsall as decimal no-undo.
     9385     define variable v-type as character no-undo .
     9386     define variable v-attr-value as character no-undo .
     9387     define variable vCodeIdent as character no-undo .
     9388     define buffer buf_marking for ub.marking .
     9389     define buffer buf_gds-prt for ub.gds-prt.
     9390     define buffer buf_doc-prts  for ub.doc-prts.
     9391     define buffer buf_sale-doc for ub.sale-doc.
     9392     define buffer b_marking-chk for ub.marking-chk .
     9393     define buffer br_marking-chk for ub.marking-chk .
     9394     define buffer b_chk-doc for ub.chk-doc .
     9395     define buffer br_chk-doc for ub.chk-doc .
     9396     define buffer b_chk-gds for ub.chk-gds .
     9397     define buffer br_chk-gds for ub.chk-gds .
     9398     find first buf_sale-doc NO-lock where
     9399               buf_Sale-doc.inkas-code = p-inkas-code
     9400           and buf_sale-doc.doc-kind = 'rs':U no-error .
     9401     if not available buf_sale-doc then return.
     9402       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проведем компенсацию незарезервированных маркированных товаров"                                       ).
     9403     _docline:
     9404     for each br-doc-line where
     9405            br-doc-line.doc-code = buf_ret-doc.doc-code
     9406     on error  undo _docline, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     9407     on stop   undo _docline, return error substitute( "&1. stop", vss-workfile )
     9408     on endkey undo _docline, return error substitute( "&1. endkey", vss-workfile )
     9409     :
     9410       assign
     9411         cv = 0
     9412       .
     9413       FIND FIRST b-doc-line where
     9414                  b-doc-line.artic = br-doc-line.artic AND
     9415                  b-doc-line.prod-type = br-doc-line.prod-type AND
     9416                  b-doc-line.prod-code = br-doc-line.prod-code and
     9417                  b-doc-line.doc-code = buf_trn-doc.doc-code NO-ERROR.
     9418       IF NOT AVAILABLE b-doc-line then NEXT _docline.
     9419       if b-doc-line.doc-qnty = b-doc-line.fact-qnty then next _docline .
     9420       find first goods no-lock where goods.artic = br-doc-line.artic
     9421                                  and goods.prod-type = br-doc-line.prod-type
     9422                                  and goods.prod-code = br-doc-line.prod-code
     9423                                  .
     9424       RUN gds-attr-value (
     9425                           INPUT goods.gds-code,
     9426                           INPUT 'mark-type':U,
     9427                           OUTPUT v-attr-value,
     9428                           OUTPUT v-type
     9429                           ).
     9430       if v-attr-value > ""
     9431       and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(b-doc-line.obj-type, b-doc-line.obj-code):GetIsMarkingForType(v-attr-value)
     9432       then do :
     9433         find first bar-code no-lock where bar-code.gds-code = goods.gds-code
     9434                                       and bar-code.unit-cli = b-doc-line.unit-cli
     9435                                       no-error .
     9436         if available bar-code
     9437         then do :
     9438           for each b_chk-doc no-lock where b_chk-doc.out-code = b-doc-line.doc-code
     9439                                        and b_chk-doc.chk-type = integer ('1':U)
     9440                                        :
     9441             for each b_chk-gds no-lock where b_chk-gds.doc-code = b_chk-doc.doc-code
     9442                                          and b_chk-gds.b-code = bar-code.b-code
     9443                                          and b_chk-gds.doc-qnty < 0 :
     9444               for each b_marking-chk exclusive-lock where b_marking-chk.doc-code = b_chk-gds.doc-code
     9445                                                        and b_marking-chk.line-num = b_chk-gds.line-num
     9446                                                        and b_marking-chk.sts = 0
     9447                                                        :
     9448                 for first br_marking-chk exclusive-lock where br_marking-chk.mark = b_marking-chk.mark
     9449                                                           and br_marking-chk.doc-code = b_marking-chk.doc-code
     9450                                                           and br_marking-chk.line-num <> b_marking-chk.line-num
     9451                                                           and br_marking-chk.sts = 0,
     9452                 first br_chk-gds no-lock where br_chk-gds.doc-code = b_chk-gds.doc-code
     9453                                            and br_chk-gds.line-num = br_marking-chk.line-num
     9454                                            and br_chk-gds.doc-qnty = - b_chk-gds.doc-qnty
     9455                                            :
     9456                   assign
     9457                     b_marking-chk.sts = 2
     9458                     br_marking-chk.sts = 2
     9459                   .
     9460                 end .
     9461               end .
     9462             end .
     9463           end .
     9464           for each br_chk-doc no-lock where br_chk-doc.out-code = b-doc-line.doc-code
     9465                                         and br_chk-doc.chk-type = integer ('6':U)
     9466                                          :
     9467             for each br_chk-gds no-lock where br_chk-gds.doc-code = br_chk-doc.doc-code
     9468                                           and br_chk-gds.b-code = bar-code.b-code:
     9469               mark_ :
     9470               for each br_marking-chk exclusive-lock where br_marking-chk.doc-code = br_chk-gds.doc-code
     9471                                                        and br_marking-chk.line-num = br_chk-gds.line-num
     9472                                                        and br_marking-chk.sts = 0
     9473                                                        :
     9474                 for each b_chk-doc no-lock where b_chk-doc.out-code = b-doc-line.doc-code
     9475                                              and b_chk-doc.chk-type = integer ('1':U),
     9476                 each b_chk-gds no-lock where b_chk-gds.doc-code = b_chk-doc.doc-code
     9477                                          and b_chk-gds.b-code = bar-code.b-code,
     9478                 first b_marking-chk exclusive-lock where b_marking-chk.mark = br_marking-chk.mark
     9479                                                      and b_marking-chk.doc-code = b_chk-gds.doc-code
     9480                                                      and b_marking-chk.line-num = b_chk-gds.line-num
     9481                                                      and b_marking-chk.sts = 0
     9482                                                      and rowid(b_marking-chk) <> rowid(br_marking-chk)
     9483                                                      :
     9484                   assign vCodeIdent = GetCodeIdent(b_marking-chk.mark) .
     9485                   find first buf_marking no-lock where buf_marking.mark begins vCodeIdent no-error .
     9486                   if not available buf_marking then next .
     9487                   assign
     9488                     b_marking-chk.sts = 2
     9489                     br_marking-chk.sts = 2
     9490                     cv = cv + buf_marking.box-qnty
     9491                   .
     9492                   next mark_ .
     9493                 end .
     9494               end .
     9495             end .
     9496           end .
     9497         end .
     9498         FIND FIRST buf_gds-prt NO-LOCK WHERE
     9499                    buf_gds-prt.upper-code = goods.prt-root NO-ERROR.
     9500         FIND FIRST b-gds-dtl where
     9501                     b-gds-dtl.doc-code = buf_ret-doc.doc-code AND
     9502                     b-gds-dtl.artic = b-doc-line.artic AND
     9503                     b-gds-dtl.prod-type = b-doc-line.prod-type AND
     9504                     b-gds-dtl.prod-code = b-doc-line.prod-code AND
     9505                     b-gds-dtl.prt-code = buf_gds-prt.node-code No-ERROR.
     9506         FIND FIRST br-gds-dtl where
     9507                     br-gds-dtl.doc-code = buf_trn-doc.doc-code AND
     9508                     br-gds-dtl.artic = br-doc-line.artic AND
     9509                     br-gds-dtl.prod-type = br-doc-line.prod-type AND
     9510                     br-gds-dtl.prod-code = br-doc-line.prod-code AND
     9511                     br-gds-dtl.prt-code = buf_gds-prt.node-code  No-ERROR.
     9512         assign
     9513           tsall =  if v-curr-r-b = 'base':U
     9514                    then  (br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
     9515                           b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base)
     9516                          )
     9517                    else   (br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
     9518                           b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl)
     9519                          )
     9520           b-gds-dtl.fact-qnty = b-gds-dtl.fact-qnty - cv
     9521           br-gds-dtl.fact-qnty = br-gds-dtl.fact-qnty - cv
     9522           br-doc-line.fact-qnty = br-doc-line.fact-qnty - cv
     9523           b-doc-line.fact-qnty = b-doc-line.fact-qnty - cv
     9524           qnty-compense = qnty-compense + cv
     9525           qnty-compense-abs = qnty-compense-abs + abs(cv)
     9526         .
     9527         if (v-curr-r-b = 'base':U and b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
     9528         OR (v-curr-r-b = 'rubl':U and b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
     9529         then do:
     9530           if v-curr-r-b = 'base':U then do:
     9531             assign
     9532             br-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty <> 0
     9533                                       then (br-gds-dtl.price-base - ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base) +
     9534                                                                    tsall )  / br-gds-dtl.fact-qnty )
     9535                                       else br-gds-dtl.discnt-base )
     9536             b-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
     9537                                       then (b-gds-dtl.price-base - ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
     9538                                                                    tsall ) / b-gds-dtl.fact-qnty  )
     9539                                       else b-gds-dtl.discnt-base )
     9540             br-gds-dtl.discnt-rubl =  br-gds-dtl.discnt-BASE * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9541             b-gds-dtl.discnt-rubl =   b-gds-dtl.discnt-BASE * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9542             .
     9543           end.
     9544           else do:
     9545             assign
     9546             br-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty <> 0
     9547                                       then (br-gds-dtl.price-rubl -
     9548                                                                   ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl) +
     9549                                                                  tsall )  / br-gds-dtl.fact-qnty
     9550                                                                    )
     9551                                      else br-gds-dtl.discnt-rubl
     9552                                      )
     9553             b-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
     9554                                      then (b-gds-dtl.price-rubl -
     9555                                                                ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
     9556                                                              tsall ) / b-gds-dtl.fact-qnty
     9557                                            )
     9558                                     else b-gds-dtl.discnt-rubl
     9559                                     )
     9560             br-gds-dtl.discnt-base =  br-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     9561             b-gds-dtl.discnt-base =   b-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     9562             .
     9563           end.
     9564         end.
     9565         release b-gds-dtl.
     9566         release br-gds-dtl.
     9567       end .
     9568     end .
     9569     FIND FIRST b-doc where b-doc.doc-code = buf_trn-doc.doc-code No-ERROR.
     9570       assign
     9571         b-doc.fact-qnty = b-doc.fact-qnty - qnty-compense
     9572       .
     9573     FIND FIRST b-doc where b-doc.doc-code = buf_ret-doc.doc-code No-ERROR.
     9574     if available b-doc then do:
     9575       assign
     9576         b-doc.fact-qnty = b-doc.fact-qnty - qnty-compense
     9577       .
     9578     end.
     9579     run waitfram-hide in this-procedure .
     9580     if p-auto = 0 then do:
     9581       run UI-on in p-parent-handle.
     9582       run ui-2 in p-parent-handle.
     9583     end.
     9584   end procedure .
     9585   PROCEDURE compense:
     9586   define input parameter p-inkas-code as character no-undo .
     9587   define input parameter p-is-tpsi-obj  as logical no-undo .
     9588   define input parameter p-rest-tpsi as logical no-undo .
     9589   define variable cv as decimal no-undo.
     9590   define variable cvp as decimal no-undo.
     9591   define variable cvpl as decimal no-undo.
     9592   define variable res-parts as decimal.
     9593   define variable res-places as decimal.
     9594   define variable unresv as decimal no-undo.
     9595   define variable unresr as decimal no-undo.
     9596   define buffer b-goods for ub.goods.
     9597   define buffer b-gds-dtl for ub.gds-dtl.
     9598   define buffer brw-gds-dtl for ub.gds-dtl.
     9599   define buffer br-gds-dtl for ub.gds-dtl.
     9600   define buffer b-doc-line for ub.doc-line.
     9601   define buffer br-doc-line for ub.doc-line.
     9602   define buffer brw-doc-line for ub.doc-line.
     9603   define buffer b-doc for ub.trn-doc.
     9604   define buffer b-doc-prts for ub.doc-prts.
     9605   define buffer brw-doc-prts for ub.doc-prts.
     9606   define buffer b-doc-pl for ub.doc-pl.
     9607   define buffer brw-doc-pl for ub.doc-pl.
     9608   define buffer b-gds-prt for ub.gds-prt.
     9609   define variable qnty-compense as decimal no-undo.
     9610   define variable qnty-compense-abs as decimal no-undo.
     9611   define variable tsall as decimal no-undo.
     9612   define variable old-doc-line-fact-qnty-r as decimal no-undo.
     9613   define variable old-doc-line-fact-qnty-v as decimal no-undo.
     9614   define variable old-doc-line-fact-qnty-rw as decimal no-undo.
     9615   define variable saled-by-place-r as decimal no-undo.
     9616   define variable saled-by-parts-r as decimal no-undo.
     9617   define variable saled-by-place-v as decimal no-undo.
     9618   define variable saled-by-parts-v as decimal no-undo.
     9619   define variable saled-by-place-rw as decimal no-undo.
     9620   define variable saled-by-parts-rw as decimal no-undo.
     9621   define variable v-retur-write-off-code as character no-undo .
     9622   define variable v-type as character no-undo .
     9623   define variable v-return-write-off-code like ub.trn-doc.doc-code no-undo .
     9624   define variable v-attr-value as character no-undo .
     9625   define buffer b-temp-prts for temp-prts.
     9626   define buffer b-temp-pl for temp-pl.
     9627   define buffer buf_units for ub.units.
     9628   define buffer buf_gds-prt for ub.gds-prt.
     9629   define buffer buf_doc-pl  for ub.doc-pl.
     9630   define buffer buf_doc-prts  for ub.doc-prts.
     9631   define buffer buf_sale-doc for ub.sale-doc.
     9632   assign
     9633   note-compense = ""
     9634   .
     9635   find first buf_sale-doc NO-lock where
     9636             buf_Sale-doc.inkas-code = p-inkas-code
     9637         and buf_sale-doc.doc-kind = 'rs':U no-error .
     9638   if not available buf_sale-doc then return.
     9639   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проведем компенсацию незарезервированных расходов-возвратов..."                                       ).
     9640   find first buf_sale-doc NO-lock where
     9641             buf_sale-doc.inkas-code = p-inkas-code
     9642         and buf_sale-doc.doc-kind = 'rwo':U no-error .
     9643   if available buf_sale-doc then
     9644   v-return-write-off-code = buf_sale-doc.doc-code.
     9645   _docline:
     9646   for each b-doc-line where
     9647          b-doc-line.doc-code = buf_ret-doc.doc-code
     9648   on error  undo _docline, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     9649   on stop   undo _docline, return error substitute( "&1. stop", vss-workfile )
     9650   on endkey undo _docline, return error substitute( "&1. endkey", vss-workfile )
     9651   :
     9652       assign
     9653       cv = 0
     9654       cashparts = no
     9655       cashplace = no
     9656       cashfbr   = no
     9657       old-doc-line-fact-qnty-v = b-doc-line.fact-qnty
     9658       .
     9659       FIND FIRST br-doc-line where
     9660                  br-doc-line.artic = b-doc-line.artic AND
     9661                  br-doc-line.prod-type = b-doc-line.prod-type AND
     9662                  br-doc-line.prod-code = b-doc-line.prod-code AND
     9663                  br-doc-line.doc-code = buf_trn-doc.doc-code NO-ERROR.
     9664       IF NOT AVAILABLE br-doc-line then NEXT _docline.
     9665       find first goods no-lock where goods.artic = br-doc-line.artic
     9666                                  and goods.prod-type = br-doc-line.prod-type
     9667                                  and goods.prod-code = br-doc-line.prod-code
     9668                                  .
     9669       RUN gds-attr-value (
     9670                           INPUT goods.gds-code,
     9671                           INPUT 'mark-type':U,
     9672                           OUTPUT v-attr-value,
     9673                           OUTPUT v-type
     9674                           ).
     9675       if v-attr-value > ""
     9676       and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(br-doc-line.obj-type, br-doc-line.obj-code):GetIsMarkingForType(v-attr-value)
     9677       then do :
     9678         next _docline .
     9679       end .
     9680       FIND FIRST brw-doc-line where
     9681                  brw-doc-line.artic = b-doc-line.artic AND
     9682                  brw-doc-line.prod-type = b-doc-line.prod-type AND
     9683                  brw-doc-line.prod-code = b-doc-line.prod-code AND
     9684                  brw-doc-line.doc-code = v-return-write-off-code NO-ERROR.
     9685       assign
     9686       old-doc-line-fact-qnty-r = br-doc-line.fact-qnty
     9687       old-doc-line-fact-qnty-v = b-doc-line.fact-qnty
     9688       old-doc-line-fact-qnty-rw = (if available brw-doc-line then brw-doc-line.fact-qnty else 0)
     9689       saled-by-place-v = 0
     9690       saled-by-place-r = 0
     9691       saled-by-place-rw = 0
     9692       saled-by-parts-v = 0
     9693       saled-by-parts-r = 0
     9694       saled-by-parts-rw = 0
     9695       .
     9696       find first b-goods where
     9697                  b-goods.artic = b-doc-line.artic AND
     9698                  b-goods.prod-type = b-doc-line.prod-type AND
     9699                  b-goods.prod-code = b-doc-line.prod-code NO-ERROR.
     9700       IF NOT AVAILABLE b-goods then NEXT _docline.
     9701       if is-gas(b-goods.gds-code) then v-gas-compensed = false .
     9702       FIND FIRST buf_units NO-LOCK WHERE
     9703                  buf_units.unit-name = b-goods.unit-base No-ERROR.
     9704       IF NOT AVAILABLE buf_units then NEXT _docline.
     9705       if can-find(first ub.doc-fbr-gds no-lOCK where
     9706                         ub.doc-fbr-gds.gds-code = b-goods.gds-code AND
     9707                         ub.doc-fbr-gds.out-code = buf_ret-doc.doc-code)
     9708         or
     9709          can-find(first ub.doc-fbr-gds no-lOCK where
     9710                         ub.doc-fbr-gds.gds-code = b-goods.gds-code AND
     9711                         ub.doc-fbr-gds.out-code = buf_trn-doc.doc-code)
     9712                         then do:
     9713         NEXT _docline.
     9714       end.
     9715       if can-find(first ub.doc-pl No-LOCK WHERE
     9716                         ub.doc-pl.gds-code = b-goods.gds-code AND
     9717                         ub.doc-pl.out-code = buf_ret-doc.doc-code) then do:
     9718           FIND FIRST buf_gds-prt NO-LOCK WHERE
     9719                      buf_gds-prt.upper-code = b-goods.prt-root NO-ERROR.
     9720           assign
     9721           cashplace = yes
     9722           cvpl = 0
     9723           .
     9724           for each temp-pl:
     9725             delete temp-pl.
     9726           end.
     9727           for each b-doc-pl NO-LOCK WHERE
     9728                    b-doc-pl.gds-code = b-goods.gds-code AND
     9729                    b-doc-pl.out-code = buf_ret-doc.doc-code:
     9730             saled-by-place-v = saled-by-place-v + b-doc-pl.fact-qnty.
     9731             find first brw-doc-pl no-lock where
     9732                    brw-doc-pl.gds-code = b-goods.gds-code
     9733               AND  brw-doc-pl.pl-code = b-doc-pl.pl-code
     9734               AND brw-doc-pl.out-code = v-return-write-off-code no-error .
     9735             if available brw-doc-pl then do:
     9736               saled-by-place-rw = saled-by-place-rw + brw-doc-pl.fact-qnty.
     9737             end.
     9738             create
     9739             temp-pl.
     9740             assign
     9741             temp-pl.is-out = -1
     9742             temp-pl.pl-code = if b-doc-pl.pl-code <> ?
     9743                                   then b-doc-pl.pl-code
     9744                                   else -1
     9745             temp-pl.doc-qnty = b-doc-pl.doc-qnty
     9746             temp-pl.fact-qnty = b-doc-pl.fact-qnty - (if available brw-doc-pl
     9747                                                       then brw-doc-pl.fact-qnty
     9748                                                       else 0)
     9749             .
     9750           end.
     9751           for each buf_doc-pl NO-LOCK WHERE
     9752                    buf_doc-pl.gds-code = b-goods.gds-code AND
     9753                    buf_doc-pl.out-code = buf_trn-doc.doc-code:
     9754                    saled-by-place-r = saled-by-place-r + buf_doc-pl.fact-qnty.
     9755             create
     9756             temp-pl.
     9757             assign
     9758             temp-pl.is-out = 1
     9759             temp-pl.pl-code = if buf_doc-pl.pl-code <> ?
     9760                                   then buf_doc-pl.pl-code
     9761                                   else -1
     9762             temp-pl.doc-qnty = buf_doc-pl.doc-qnty
     9763             temp-pl.fact-qnty = buf_doc-pl.fact-qnty
     9764             .
     9765           end.
     9766           for each b-temp-pl  WHERE
     9767                    b-temp-pl.is-out = -1:
     9768               find first temp-pl WHERE
     9769                          temp-pl.pl-code = b-temp-pl.pl-code AND
     9770                          temp-pl.is-out  = 1 No-ERROR.
     9771               if not available temp-pl or
     9772                 (temp-pl.fact-qnty = temp-pl.doc-qnty AND b-temp-pl.fact-qnty = b-temp-pl.doc-qnty) then
     9773               NEXT.
     9774               assign
     9775               res-places = MAXIMUM(b-temp-pl.fact-qnty - b-temp-pl.doc-qnty , temp-pl.fact-qnty - temp-pl.doc-qnty)
     9776               res-places = if b-temp-pl.fact-qnty < res-places then b-temp-pl.fact-qnty else res-places
     9777               res-places = if temp-pl.fact-qnty < res-places then temp-pl.fact-qnty else res-places
     9778               unresv = res-places - (b-temp-pl.fact-qnty - b-temp-pl.doc-qnty)
     9779               unresr = res-places - (temp-pl.fact-qnty - temp-pl.doc-qnty)
     9780               b-temp-pl.new-fact-qnty = b-temp-pl.fact-qnty - res-places
     9781               temp-pl.new-fact-qnty = temp-pl.fact-qnty - res-places
     9782               cvpl = cvpl + res-places
     9783               .
     9784               FIND FIRST b-gds-dtl where
     9785                           b-gds-dtl.doc-code = buf_ret-doc.doc-code AND
     9786                         b-gds-dtl.artic = b-doc-line.artic AND
     9787                         b-gds-dtl.prod-type = b-doc-line.prod-type AND
     9788                         b-gds-dtl.prod-code = b-doc-line.prod-code AND
     9789                         b-gds-dtl.prt-code = buf_gds-prt.node-code No-ERROR.
     9790               FIND FIRST br-gds-dtl where
     9791                           br-gds-dtl.doc-code = buf_trn-doc.doc-code AND
     9792                           br-gds-dtl.artic = br-doc-line.artic AND
     9793                           br-gds-dtl.prod-type = br-doc-line.prod-type AND
     9794                           br-gds-dtl.prod-code = br-doc-line.prod-code AND
     9795                           br-gds-dtl.prt-code = buf_gds-prt.node-code No-ERROR.
     9796               if unresv > 0 or unresr > 0 then do:
     9797                   if (v-curr-r-b = 'base':U and  (br-gds-dtl.price-base <> b-gds-dtl.price-base))
     9798                   OR (v-curr-r-b = 'rubl':U and  (br-gds-dtl.price-rubl <> b-gds-dtl.price-rubl))
     9799                   then NEXT _docline.
     9800                   if
     9801                   b-gds-dtl.fact-qnty - cvpl = 0 AND
     9802                   br-gds-dtl.fact-qnty - cvpl = 0 AND
     9803                   ((v-curr-r-b = 'base':U and  b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
     9804                    OR
     9805                    (v-curr-r-b = 'rubl':U and  b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
     9806                   )
     9807                    then do:
     9808                       if cvpl > 1 then
     9809                       assign
     9810                       cvpl = cvpl - 1
     9811                       unresv = unresv - 1
     9812                       unresr = unresr - 1
     9813                       b-temp-pl.new-fact-qnty = b-temp-pl.new-fact-qnty + 1
     9814                       temp-pl.new-fact-qnty = temp-pl.new-fact-qnty + 1
     9815                       .
     9816                       else NEXT _docline.
     9817                   end.
     9818                   assign
     9819                   rdoc-line = recid (b-doc-line)
     9820                   rgds-dtl = recid(b-gds-dtl)
     9821                   r-qnty = - unresv
     9822                   r-b-code = ?
     9823                   r-pl-code = if b-temp-pl.pl-code = - 1 then ? else b-temp-pl.pl-code
     9824                   r-or-v = 'rs':U
     9825                   r-office = 'т':U
     9826                   from-menu = yes.
     9827                   if unresv > 0 then do:
     9828                       run b-unres-proc in this-procedure (
     9829                                         buffer buf_inkas
     9830                                       , buffer buf_trn-doc
     9831                                       , buffer buf_ret-doc
     9832                                       , input  p-is-tpsi-obj
     9833                                       , input yes) no-error.
     9834                       if error-status:error then do:
     9835                         undo _docline, return error.
     9836                       end.
     9837                   end.
     9838               end.
     9839               if unresr > 0 then do:
     9840                   assign
     9841                   rdoc-line = recid (br-doc-line)
     9842                   rgds-dtl = recid(br-gds-dtl)
     9843                   r-qnty = - unresr
     9844                   r-b-code = ?
     9845                   r-doc-prts-qnty = ?
     9846                   r-pl-code = if temp-pl.pl-code = - 1 then ? else temp-pl.pl-code
     9847                   r-or-v = 'es':U
     9848                   r-office = 'т':U
     9849                   from-menu = yes.
     9850                   run b-unres-proc in this-procedure (
     9851                                         buffer buf_inkas
     9852                                       , buffer buf_trn-doc
     9853                                       , buffer buf_ret-doc
     9854                                       , input p-is-tpsi-obj
     9855                                       , input yes) no-error.
     9856                   if error-status:error then do:
     9857                     undo _docline, return error.
     9858                   end.
     9859               end.
     9860           end.
     9861           if cvpl <> 0 then do:
     9862               for each temp-pl,
     9863                   first ub.doc-pl where
     9864                         ub.doc-pl.out-code = (if temp-pl.is-out = 1
     9865                                               then br-gds-dtl.doc-code
     9866                                               else b-gds-dtl.doc-code)
     9867                     and ub.doc-pl.gds-code = b-goods.gds-code
     9868                     and ub.doc-pl.pl-code = temp-pl.pl-code
     9869                on error  undo _docline, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     9870                on stop   undo _docline, return error substitute( "&1. stop", vss-workfile )
     9871                on endkey undo _docline, return error substitute( "&1. endkey", vss-workfile )
     9872                :
     9873                 assign
     9874                 ub.doc-pl.cli-fact-qnty = temp-pl.new-fact-qnty * ub.doc-pl.cli-fact-qnty / ub.doc-pl.fact-qnty
     9875                 ub.doc-pl.fact-qnty = temp-pl.new-fact-qnty
     9876                 .
     9877               end.
     9878               assign
     9879               tsall = (if v-curr-r-b = 'base':U
     9880                         then (br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
     9881                               b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base))
     9882                          else (br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
     9883                               b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl))
     9884                        )
     9885               b-gds-dtl.fact-qnty = b-gds-dtl.fact-qnty - cvpl
     9886               br-gds-dtl.fact-qnty = br-gds-dtl.fact-qnty - cvpl
     9887               br-doc-line.fact-qnty = br-doc-line.fact-qnty - cvpl
     9888               b-doc-line.fact-qnty = b-doc-line.fact-qnty - cvpl
     9889               qnty-compense = qnty-compense + cvpl
     9890               qnty-compense-abs = qnty-compense-abs + abs(cvpl)
     9891               no-error .
     9892               if (v-curr-r-b = 'base':U and b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
     9893               OR (v-curr-r-b = 'rubl':U and b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
     9894               then do:
     9895               if v-curr-r-b = 'base':U
     9896               then do:
     9897                assign
     9898                br-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty <> 0
     9899                                          then (br-gds-dtl.price-base - ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base) +
     9900                                                                                    tsall )  / br-gds-dtl.fact-qnty
     9901                                               )
     9902                                          else br-gds-dtl.discnt-base
     9903                                          )
     9904                b-gds-dtl.discnt-base = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
     9905                                         then (b-gds-dtl.price-base -  ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
     9906                                                tsall ) / b-gds-dtl.fact-qnty
     9907                                              )
     9908                                         else b-gds-dtl.discnt-base
     9909                                         )
     9910                br-gds-dtl.discnt-rubl = br-gds-dtl.discnt-base * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9911                b-gds-dtl.discnt-rubl = b-gds-dtl.discnt-base * (buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9912                .
     9913               end.
     9914               else do:
     9915                 assign
     9916                 br-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty <> 0
     9917                                          then (br-gds-dtl.price-rubl -
     9918                                                                       ( b-gds-dtl.fact-qnty * (b-gds-dtl.price-rubl - b-gds-dtl.discnt-rubl) +
     9919                                                                       tsall )  / br-gds-dtl.fact-qnty
     9920                                               )
     9921                                          else br-gds-dtl.discnt-rubl
     9922                                          )
     9923                b-gds-dtl.discnt-rubl = (if br-gds-dtl.fact-qnty = 0 and b-gds-dtl.fact-qnty <> 0
     9924                                         then (b-gds-dtl.price-rubl -
     9925                                                                     ( br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
     9926                                                                       tsall ) / b-gds-dtl.fact-qnty
     9927                                               )
     9928                                         else b-gds-dtl.discnt-rubl
     9929                                         )
     9930                 br-gds-dtl.discnt-base = br-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     9931                 b-gds-dtl.discnt-base = b-gds-dtl.discnt-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     9932               end.
     9933             end.
     9934             release b-gds-dtl.
     9935             release br-gds-dtl.
     9936           end.
     9937       end.
     9938       if NOT cashplace AND can-find(first ub.doc-prts No-LOCK WHERE
     9939                                           ub.doc-prts.gds-code = b-goods.gds-code AND
     9940                                           ub.doc-prts.out-code = buf_ret-doc.doc-code) then do:
     9941           FIND FIRST buf_gds-prt NO-LOCK WHERE
     9942                    buf_gds-prt.upper-code = b-goods.prt-root NO-ERROR.
     9943           assign
     9944           cashparts = yes
     9945           cvp = 0
     9946           .
     9947           for each temp-prts:
     9948             delete temp-prts.
     9949           end.
     9950           for each b-doc-prts NO-LOCK WHERE
     9951                    b-doc-prts.gds-code = b-goods.gds-code AND
     9952                    b-doc-prts.out-code = buf_ret-doc.doc-code:
     9953                    saled-by-parts-v = saled-by-parts-v + b-doc-prts.fact-qnty.
     9954             find first brw-doc-prts no-lock where
     9955                       brw-doc-prts.gds-code = b-goods.gds-code
     9956                  AND  brw-doc-prts.out-code = v-return-write-off-code
     9957                  AND  brw-doc-prts.b-code = b-doc-prts.b-code no-error .
     9958             if available brw-doc-prts then do:
     9959               saled-by-parts-rw = saled-by-parts-rw + brw-doc-prts.fact-qnty.
     9960             end.
     9961             create
     9962             temp-prts.
     9963             assign
     9964             temp-prts.is-out = -1
     9965             temp-prts.b-code = if b-doc-prts.b-code <> ?
     9966                                   then b-doc-prts.b-code
     9967                                   else -1
     9968             temp-prts.doc-qnty = b-doc-prts.doc-qnty
     9969             temp-prts.fact-qnty = b-doc-prts.fact-qnty - (if available brw-doc-prts
     9970                                                           then brw-doc-prts.fact-qnty
     9971                                                           else 0)
     9972             temp-prts.rc = string(recid(b-doc-prts))
     9973             temp-prts.twounit = IF lookup('2ед':U, buf_units.type) > 0 AND
     9974                                    lookup('дро':U, buf_units.type) > 0 then yes
     9975                                    else no
     9976             .
     9977           end.
     9978           for each buf_doc-prts NO-LOCK WHERE
     9979                    buf_doc-prts.gds-code = b-goods.gds-code AND
     9980                    buf_doc-prts.out-code = buf_trn-doc.doc-code:
     9981                    saled-by-parts-r = saled-by-parts-r + buf_doc-prts.fact-qnty.
     9982             create
     9983             temp-prts.
     9984             assign
     9985             temp-prts.is-out = 1
     9986             temp-prts.b-code = if buf_doc-prts.b-code <> ?
     9987                                   then buf_doc-prts.b-code
     9988                                   else -1
     9989             temp-prts.doc-qnty = buf_doc-prts.doc-qnty
     9990             temp-prts.fact-qnty = buf_doc-prts.fact-qnty
     9991             temp-prts.rc = string(recid(buf_doc-prts))
     9992             temp-prts.twounit = IF lookup('2ед':U, buf_units.type) > 0 AND
     9993                                    lookup('дро':U, buf_units.type) > 0 then yes
     9994                                    else no
     9995             .
     9996           end.
     9997           FOR EACH b-temp-prts WHERE
     9998                    b-temp-prts.is-out = -1 AND
     9999                    b-temp-prts.compensed = no use-index qnty:
    10000               if b-temp-prts.twounit then do:
    10001                 FOR EACH temp-prts WHERE
    10002                          temp-prts.is-out = 1 AND
    10003                          temp-prts.b-code = b-temp-prts.b-code AND
    10004                          temp-prts.fact-qnty = b-temp-prts.fact-qnty AND
    10005                          temp-prts.compensed = no use-index qnty:
    10006                     IF (temp-prts.fact-qnty = temp-prts.doc-qnty AND b-temp-prts.fact-qnty = b-temp-prts.doc-qnty) then
    10007                     NEXT.
    10008                     LEAVE.
    10009                 END.
    10010               end.
    10011               ELSE do:
    10012                 find first temp-prts WHERE
    10013                            temp-prts.b-code = b-temp-prts.b-code AND
    10014                            temp-prts.is-out = 1 No-ERROR.
    10015               END.
    10016               if not available temp-prts or
    10017                 (temp-prts.fact-qnty = temp-prts.doc-qnty AND b-temp-prts.fact-qnty = b-temp-prts.doc-qnty) then
    10018               NEXT.
    10019               assign
    10020               res-parts = MAXIMUM(b-temp-prts.fact-qnty - b-temp-prts.doc-qnty , temp-prts.fact-qnty - temp-prts.doc-qnty)
    10021               res-parts = if b-temp-prts.fact-qnty < res-parts then b-temp-prts.fact-qnty else res-parts
    10022               res-parts = if temp-prts.fact-qnty < res-parts then temp-prts.fact-qnty else res-parts
    10023               unresv = res-parts - (b-temp-prts.fact-qnty - b-temp-prts.doc-qnty)
    10024               unresr = res-parts - (temp-prts.fact-qnty - temp-prts.doc-qnty)
    10025               b-temp-prts.new-fact-qnty = b-temp-prts.fact-qnty - res-parts
    10026               temp-prts.new-fact-qnty = temp-prts.fact-qnty - res-parts
    10027               cvp = cvp + res-parts
    10028               .
    10029               IF b-temp-prts.twounit and res-parts > 0 then DO:
    10030                 assign
    10031                 temp-prts.compensed = yes
    10032                 .
    10033               end.
    10034               FIND FIRST b-gds-dtl where
    10035                           b-gds-dtl.doc-code = buf_ret-doc.doc-code AND
    10036                           b-gds-dtl.artic = b-doc-line.artic AND
    10037                           b-gds-dtl.prod-type = b-doc-line.prod-type AND
    10038                           b-gds-dtl.prod-code = b-doc-line.prod-code AND
    10039                           b-gds-dtl.prt-code = buf_gds-prt.node-code No-ERROR.
    10040               FIND FIRST br-gds-dtl where
    10041                           br-gds-dtl.doc-code = buf_trn-doc.doc-code AND
    10042                           br-gds-dtl.artic = br-doc-line.artic AND
    10043                           br-gds-dtl.prod-type = br-doc-line.prod-type AND
    10044                           br-gds-dtl.prod-code = br-doc-line.prod-code AND
    10045                           br-gds-dtl.prt-code = buf_gds-prt.node-code  No-ERROR.
    10046               if unresv > 0 or unresr > 0 then do:
    10047                   if
    10048                   b-gds-dtl.fact-qnty - cvp = 0 AND
    10049                   br-gds-dtl.fact-qnty - cvp = 0 AND
    10050                   (
    10051                   (v-curr-r-b = 'base':U and  b-gds-dtl.discnt-base <> br-gds-dtl.discnt-base)
    10052                   OR
    10053                   (v-curr-r-b = 'rubl':U and  b-gds-dtl.discnt-rubl <> br-gds-dtl.discnt-rubl)
    10054                   )
    10055                   then do:
    10056                       if cvp > 1 AND b-temp-prts.twounit <> yes then
    10057                       assign
    10058                       cvp = cvp - 1
    10059                       unresv = unresv - 1
    10060                       unresr = unresr - 1
    10061                       b-temp-prts.new-fact-qnty = b-temp-prts.new-fact-qnty + 1
    10062                       temp-prts.new-fact-qnty = temp-prts.new-fact-qnty + 1
    10063                       .
    10064                       else do:
    10065                         temp-prts.compensed = no.
    10066                         NEXT _docline.
    10067                       end.
    10068                   end.
    10069                   assign
    10070                   rdoc-line = recid (b-doc-line)
    10071                   rgds-dtl = recid(b-gds-dtl)
    10072                   r-qnty = - unresv
    10073                   r-b-code = if b-temp-prts.b-code = - 1 then ? else b-temp-prts.b-code
    10074                   r-doc-prts-qnty = (if lookup('2ед':U, buf_units.type) > 0 AND
    10075                                         lookup('дро':U, buf_units.type) > 0
    10076                                      then b-temp-prts.fact-qnty
    10077                                      else ?
    10078                                      )
    10079                   r-pl-code = ?
    10080                   r-or-v = 'rs':U
    10081                   r-office = 'т':U
    10082                   from-menu = yes.
    10083                   if unresv > 0 then do:
    10084                       run b-unres-proc in this-procedure (
    10085                                         buffer buf_inkas
    10086                                       , buffer buf_trn-doc
    10087                                       , buffer buf_ret-doc
    10088                                       , input p-is-tpsi-obj
    10089                                       , input yes) no-error.
    10090                       if error-status:error then do:
    10091                         undo _docline, return error.
    10092                       end.
    10093                   end.
    10094               end.
    10095               if unresr > 0 then do:
    10096                   assign
    10097                   rdoc-line = recid (br-doc-line)
    10098                   rgds-dtl = recid(br-gds-dtl)
    10099                   r-qnty = - unresr
    10100                   r-b-code = if temp-prts.b-code = - 1 then ? else temp-prts.b-code
    10101                   r-doc-prts-qnty = (if lookup('2ед':U, buf_units.type) > 0 AND
    10102                                         lookup('дро':U, buf_units.type) > 0
    10103                                      then temp-prts.fact-qnty
    10104                                      else ?
    10105                                      )
    10106                   r-pl-code = ?
    10107                   r-or-v = 'es':U
    10108                   r-office = 'т':U
    10109                   from-menu = yes.
    10110                   run b-unres-proc in this-procedure (
    10111                                         buffer buf_inkas
    10112                                       , buffer buf_trn-doc
    10113                                       , buffer buf_ret-doc
    10114                                       , input p-is-tpsi-obj
    10115                                       , input yes) no-error.
    10116                   if error-status:error then do:
    10117                     undo _docline, return error.
    10118                   end.
    10119               end.
    10120           end.
    10121           if cvp = 0 then NEXT _docline.
    10122           for each temp-prts,
    10123               first ub.doc-prts where
    10124                     recid(ub.doc-prts) = integer(temp-prts.rc)
    10125           on error  undo _docline, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10126           on stop   undo _docline, return error substitute( "&1. stop", vss-workfile )
    10127           on endkey undo _docline, return error substitute( "&1. endkey", vss-workfile )
    10128           :
    10129             assign
    10130             ub.doc-prts.fact-qnty = temp-prts.new-fact-qnty
    10131             .
    10132           end.
    10133           assign
    10134           tsall =  if v-curr-r-b = 'base':U
    10135                    then  (br-gds-dtl.fact-qnty * (br-gds-dtl.price-base - br-gds-dtl.discnt-base) -
    10136                           b-gds-dtl.fact-qnty * (b-gds-dtl.price-base - b-gds-dtl.discnt-base)
    10137                          )
    10138                    else   (br-gds-dtl.fact-qnty * (br-gds-dtl.price-rubl - br-gds-dtl.discnt-rubl) -
