     9200               v-prichina =  substitute("В результате данной продажи&1" +
     9201                                     "на текущем объекте (&2&3)&1" +
     9202                                     "появятся недопустимые ОТРИЦАТЕЛЬНЫE ОСТАТКИ&1" +
