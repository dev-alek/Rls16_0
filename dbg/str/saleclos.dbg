     3610   line-num.
     3611   define temp-table temp-chk-doc no-undo
     3612   field orig-doc-code like ub.chk-doc.doc-code
     3613   field doc-code like ub.chk-doc.doc-code
     3614   field obj-type like ub.chk-doc.obj-type
     3615   field obj-code like ub.chk-doc.obj-code
     3616   field netto    like ub.chk-doc.netto
     3617   index pi is unique primary
     3618   doc-code
     3619   index idoc-code orig-doc-code
     3620   .
     3621   procedure chksplin :
     3622   define parameter buffer buf_chk-doc for ub.chk-doc.
     3623   define input  parameter p-d-card-mode   as integer no-undo .
     3624   define output parameter p-nf-gds-amount as integer no-undo .
     3625   DEFINE VARIABLE current-line-num like ub.chk-discnt.line-num no-undo .
     3626   DEFINE VARIABLE current-line-num-bonus like ub.chk-discnt.line-num no-undo .
     3627   define variable v-proprietor-host-code as integer no-undo .
     3628   define variable v-proprietor-obj-code as integer no-undo .
     3629   define variable v-proprietor-obj-type as character no-undo .
     3630   define variable v-gran as integer no-undo .
     3631   define variable v-new-doc-code as character no-undo .
     3632   define variable v-ratio as decimal no-undo .
     3633   define variable v-ratio-bonus as decimal no-undo .
     3634   define variable v-object-sum as decimal no-undo .
     3635   define variable v-object-sum-bonus as decimal no-undo .
     3636   define variable v-object-sump as decimal no-undo .
     3637   define variable v-object-sump-bonus as decimal no-undo .
     3638   define variable v-num-docs  as integer no-undo .
     3639   define variable v-ii as integer no-undo .
     3640   define buffer bufp_chk-doc for ub.chk-doc.
     3641   define buffer buf_chk-gds for ub.chk-gds.
     3642   define buffer bufp_chk-gds for ub.chk-gds.
     3643   define buffer buf_chk-pay for ub.chk-pay.
     3644   define buffer bufp_chk-pay for ub.chk-pay.
     3645   define buffer buf_chk-discnt for ub.chk-discnt.
     3646   define buffer bufp_chk-discnt for ub.chk-discnt.
     3647   define buffer buf_bar-code for ub.bar-code.
     3648   define buffer bufp_temp-goods for temp-goods.
     3649   _main:
     3650   do
     3651   on error undo, return error return-value
     3652   :
     3653     if not buf_chk-doc.office = 'т':U
     3654     and not buf_chk-doc.office = 'у':U then do:
     3655        return substitute("чек &1 не может быть разбит на по отделам(магазинам)&2имеются ошибки в чеке&3"
     3656                         ,buf_chk-doc.doc-code
     3657                         ,chr(10)
     3658                         ,buf_chk-doc.office).
     3659     end.
     3660     for each buf_chk-gds where
     3661             buf_chk-gds.doc-code = buf_chk-doc.doc-code
     3662     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3663     :
     3664       find first buf_bar-code no-lock where
     3665                 buf_bar-code.b-code = buf_chk-gds.b-code no-error .
     3666       if not available buf_bar-code then do:
     3667         undo _main, return error substitute("Не найден бар-код &1&2строка &3 чек &4 дата &5 касса &6 № на кассе&7"
     3668                                             , buf_chk-gds.b-code
     3669                                             , chr(10)
     3670                                             , buf_chk-gds.line-num
     3671                                             , buf_chk-doc.doc-code
     3672                                             , buf_Chk-doc.chk-date
     3673                                             , buf_chk-doc.pay-desk
     3674                                             , buf_chk-doc.chk-num).
     3675       end.
     3676       run tpsi-gds-proprietor in this-procedure (
     3677                                                   input buf_bar-code.gds-code
     3678                                                 ,input g#db-num
     3679                                                 ,output v-proprietor-host-code
     3680                                                 ,output v-proprietor-obj-type
     3681                                                 ,output v-proprietor-obj-code ) no-error.
     3682       if error-status:error then do:
     3683         undo _main, return error (substitute("Ошибка при получении принадлежности товара с кодом &1&2строка &3 чек &4 дата &5 касса &6 № на кассе&7&2"
     3684                                             , buf_bar-code.gds-code
     3685                                             , chr(10)
     3686                                             , buf_chk-gds.line-num
     3687                                             , buf_chk-doc.doc-code
     3688                                             , buf_Chk-doc.chk-date
     3689                                             , buf_chk-doc.pay-desk
     3690                                             , buf_chk-doc.chk-num) +
     3691                                   substitute("&1&2&3&2"
     3692                                               , error-status:get-message(1)
     3693                                               , chr(10)
     3694                                               , return-value ))
     3695                                             .
     3696       end.
     3697       if v-proprietor-obj-code = 0
     3698       or v-proprietor-obj-code = ?
     3699       then do:
     3700         assign
     3701         v-proprietor-obj-type = buf_chk-doc.obj-type
     3702         v-proprietor-obj-code = buf_chk-doc.obj-code
     3703         .
     3704   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3705   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3706     (input  v-proprietor-obj-type
     3707     ,input  v-proprietor-obj-code
     3708     ,output v-proprietor-host-code
     3709     )  .
     3710       end.
     3711       assign
     3712       v-gran = 0
     3713       v-gran = if r-index(buf_chk-gds.doc-code, '-':U) > 0
     3714                then r-index(buf_chk-gds.doc-code, '-':U)
     3715                else 0
     3716       v-new-doc-code = (if v-gran > 0
     3717                        then substring(buf_chk-gds.doc-code, 1, v-gran - 1)
     3718                        else buf_chk-gds.doc-code) + '>' + string(v-proprietor-obj-code).
     3719       find first temp-chk-doc where
     3720                 temp-chk-doc.doc-code = v-new-doc-code
     3721             and temp-chk-doc.obj-type = v-proprietor-obj-type
     3722             and temp-chk-doc.obj-code = v-proprietor-obj-code no-error .
     3723       if not available temp-chk-doc then do:
     3724         create temp-chk-doc.
     3725         assign
     3726         temp-chk-doc.orig-doc-code = buf_chk-doc.doc-code
     3727         temp-chk-doc.doc-code = v-new-doc-code
     3728         temp-chk-doc.obj-type = v-proprietor-obj-type
     3729         temp-chk-doc.obj-code = v-proprietor-obj-code
     3730         v-num-docs            = v-num-docs + 1
     3731         .
     3732         create bufp_chk-doc.
     3733         buffer-copy buf_chk-doc
     3734         except
     3735         obj-type obj-code doc-code
     3736         netto tot-doc discnt sub-discnt out-code
     3737         d-card src-d-card cli-type src-cli-type cli-code src-cli-code
     3738         to bufp_chk-doc
     3739         assign
     3740         bufp_chk-doc.doc-code = v-new-doc-code
     3741         bufp_chk-doc.obj-type = v-proprietor-obj-type
     3742         bufp_chk-doc.obj-code = v-proprietor-obj-code
     3743         bufp_chk-doc.PS = buf_chk-doc.ps + "@":U + "split":U
     3744         .
     3745         if p-d-card-mode = 2
     3746         or p-d-card-mode = 3
     3747         then do:
     3748           assign
     3749           bufp_chk-doc.d-card       = buf_chk-doc.d-card
     3750           bufp_chk-doc.src-d-card   = buf_chk-doc.src-d-card
     3751           bufp_chk-doc.cli-type     = buf_chk-doc.cli-type
     3752           bufp_chk-doc.src-cli-type = buf_chk-doc.src-cli-type
     3753           bufp_chk-doc.cli-code     = buf_chk-doc.cli-code
     3754           bufp_chk-doc.src-cli-code = buf_chk-doc.src-cli-code
     3755           .
     3756         end.
     3757       end.
     3758       else do:
     3759         find first bufp_chk-doc where
     3760                   bufp_chk-doc.doc-code = v-new-doc-code
     3761               and bufp_chk-doc.obj-type = v-proprietor-obj-type
     3762               and bufp_chk-doc.obj-code = v-proprietor-obj-code no-error .
     3763       end.
     3764       create bufp_chk-gds .
     3765       create temp-goods.
     3766       create bufp_temp-goods.
     3767       buffer-copy buf_chk-gds
     3768       except doc-code out-code
     3769       d-card src-d-card cli-type src-cli-type cli-code src-cli-code
     3770       to bufp_chk-gds
     3771       assign
     3772       bufp_chk-gds.doc-code = v-new-doc-code
     3773       bufp_chk-doc.netto    = bufp_chk-doc.netto + (bufp_chk-gds.price-base - bufp_chk-gds.discnt ) * bufp_chk-gds.doc-qnty
     3774       temp-chk-doc.netto    = bufp_chk-doc.netto
     3775       bufp_chk-doc.tot-doc  = bufp_chk-doc.tot-doc + bufp_chk-gds.price-base * bufp_chk-gds.doc-qnty
     3776       bufp_chk-doc.discnt   = bufp_chk-doc.discnt + bufp_chk-gds.discnt * bufp_chk-gds.doc-qnty
     3777       bufp_chk-doc.sub-discnt   = bufp_chk-doc.sub-discnt +  (if bufp_chk-gds.write-off-code <> 0
     3778                                                           and bufp_chk-gds.write-off-code <> ?
     3779                                                           then ((if bufp_chk-gds.write-off-code > 0 then 1 else - 1) *
     3780                                                                   bufp_chk-gds.src-qnty * (bufp_chk-gds.src-price - bufp_chk-gds.src-discnt)
     3781                                                                 )
     3782                                                           else 0)
     3783       temp-goods.line-num    = buf_chk-gds.line-num
     3784       temp-goods.doc-code    = buf_chk-gds.doc-code
     3785       temp-goods.object-sum  = buf_chk-gds.src-price * buf_chk-gds.src-qnty
     3786       bufp_temp-goods.line-num    = buf_chk-gds.line-num
     3787       bufp_temp-goods.doc-code    = bufp_chk-gds.doc-code
     3788       bufp_temp-goods.object-sum  = bufp_chk-gds.src-price * bufp_chk-gds.src-qnty
     3789       .
     3790       if p-d-card-mode = 2
     3791       or p-d-card-mode = 3
     3792       then do:
     3793         assign
     3794         bufp_chk-gds.d-card       = buf_chk-gds.d-card
     3795         bufp_chk-gds.src-d-card   = buf_chk-gds.src-d-card
     3796         bufp_chk-gds.cli-type     = buf_chk-gds.cli-type
     3797         bufp_chk-gds.src-cli-type = buf_chk-gds.src-cli-type
     3798         bufp_chk-gds.cli-code     = buf_chk-gds.cli-code
     3799         bufp_chk-gds.src-cli-code = buf_chk-gds.src-cli-code
     3800         .
     3801       end.
     3802       if p-d-card-mode = 2 then do:
     3803         assign
     3804         buf_chk-gds.d-card       = '':U
     3805         buf_chk-gds.src-d-card   = '':U
     3806         buf_chk-gds.cli-type     = '':U
     3807         buf_chk-gds.src-cli-type = '':U
     3808         buf_chk-gds.cli-code     = 0
     3809         buf_chk-gds.src-cli-code = 0
     3810         .
     3811       end.
     3812       release bufP_chk-doc.
     3813       release bufp_chk-gds.
     3814       release temp-chk-doc.
     3815       p-nf-gds-amount = p-nf-gds-amount + 1.
     3816     end.
     3817     for each buf_chk-pay where
     3818                 buf_chk-pay.doc-code = buf_chk-doc.doc-code,
     3819       each temp-chk-doc where temp-chk-doc.orig-doc-code = buf_chk-doc.doc-code
     3820     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3821       :
     3822       v-ratio = temp-chk-doc.netto / buf_chk-doc.netto.
     3823       if v-ratio <> 0 then do:
     3824         find first bufP_chk-pay where
     3825                   bufp_chk-pay.doc-code = temp-chk-doc.doc-code
     3826             and  bufp_chk-pay.line-num = buf_chk-pay.line-num no-error.
     3827         if not available bufp_chk-pay then do:
     3828           create bufp_chk-pay.
     3829           buffer-copy buf_chk-pay
     3830           except doc-code obj-type obj-code tot-sum tot-rubl tot-base out-code
     3831           to
     3832           bufp_chk-pay
     3833           assign
     3834           bufp_chk-pay.doc-code = temp-chk-doc.doc-code
     3835           bufp_chk-pay.obj-type = temp-chk-doc.obj-type
     3836           bufp_chk-pay.obj-code = temp-chk-doc.obj-code
     3837           bufp_chk-pay.tot-sum =  buf_chk-pay.tot-sum  * v-ratio
     3838           bufp_chk-pay.tot-rubl =  buf_chk-pay.tot-rubl * v-ratio
     3839           bufp_chk-pay.tot-base =  buf_chk-pay.tot-base  * v-ratio
     3840           .
     3841         end.
     3842       end.
     3843     end.
     3844     for each bufp_chk-doc where
     3845            bufp_chk-doc.doc-code begins (buf_chk-doc.doc-code + '>')
     3846     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3847     :
     3848       assign
     3849       current-line-num = 0
     3850       current-line-num-bonus = 0
     3851       v-object-sum  = 0
     3852       v-object-sump = 0
     3853       v-ii = v-ii + 1
     3854       .
     3855       _buf_chk-discnt:
     3856       for each buf_chk-discnt where
     3857                 buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     3858       by buf_chk-discnt.line-num
     3859       by buf_chk-discnt.discnt-id
     3860       by abs(buf_chk-discnt.object-line-num)
     3861       by buf_chk-discnt.object-line-num
     3862       on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3863       :
     3864         CASE buf_chk-discnt.record-type:
     3865           when 0 then do:
     3866             for each temp-goods no-lock where
     3867                     abs(temp-goods.line-num) > abs(current-line-num)
     3868                 and abs(temp-goods.line-num) <= abs(buf_chk-discnt.line-num):
     3869               assign
     3870               v-object-sum = v-object-sum + temp-goods.object-sum
     3871               .
     3872               if temp-goods.doc-code = bufp_chk-doc.doc-code
     3873               then do:
     3874                 assign
     3875                 v-object-sump = v-object-sump + temp-goods.object-sum
     3876                 .
     3877               end.
     3878             end.
     3879             assign
     3880             v-ratio = v-object-sump / v-object-sum
     3881             .
     3882             assign
     3883             current-line-num = buf_chk-discnt.line-num
     3884             .
     3885             if buf_chk-discnt.line-type = integer('1':U)
     3886             and can-find(first temp-goods where
     3887                                 temp-goods.doc-code = bufp_chk-doc.doc-code
     3888                             and temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
     3889               create bufp_chk-discnt.
     3890               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     3891               assign
     3892               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     3893               .
     3894             end.
     3895             else do:
     3896               create bufp_chk-discnt.
     3897               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     3898               assign
     3899               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     3900               .
     3901               CASE buf_chk-discnt.line-type:
     3902                 when integer('2':U)
     3903                 or
     3904                 when integer('3':U) then do:
     3905                   assign
     3906                   bufp_chk-discnt.object-sum = v-ratio * buf_chk-discnt.object-sum
     3907                   bufp_chk-discnt.discnt-value-abs = v-ratio * buf_chk-discnt.discnt-value-abs
     3908                   bufp_chk-discnt.discnt-value-pcnt =  if bufp_chk-discnt.object-sum <> 0
     3909                                                       then bufp_chk-discnt.discnt-value-abs / bufp_chk-discnt.object-sum * 100
     3910                                                       else 0
     3911                   .
     3912                 end.
     3913                 when integer('4':U)
     3914                 or
     3915                 when integer('5':U) then do:
     3916                   assign
     3917                   bufp_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * bufp_chk-doc.netto / buf_chk-doc.netto
     3918                   bufp_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * bufp_chk-doc.netto / buf_chk-doc.netto
     3919                   bufp_chk-discnt.discnt-value-pcnt =  if bufp_chk-discnt.object-sum <> 0
     3920                                                         then bufp_chk-discnt.discnt-value-abs / bufp_chk-discnt.object-sum * 100
     3921                                                         else 0
     3922                   .
     3923                 end.
     3924               END CASE.
     3925             end.
     3926           end.
     3927           when 1
     3928           or
     3929           when 2
     3930           then do:
     3931             if can-find(first temp-goods where
     3932                               temp-goods.doc-code = bufp_chk-doc.doc-code
     3933                           and temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
     3934               create bufp_chk-discnt.
     3935               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     3936               assign
     3937               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     3938               .
     3939             end.
     3940           end.
     3941           when 4 then do:
     3942             for each temp-goods no-lock where
     3943                     abs(temp-goods.line-num) > abs(current-line-num-bonus)
     3944                 and abs(temp-goods.line-num) <= abs(buf_chk-discnt.line-num):
     3945               assign
     3946               v-object-sum-bonus = v-object-sum-bonus + temp-goods.object-sum
     3947               .
     3948               if temp-goods.doc-code = bufp_chk-doc.doc-code
     3949               then do:
     3950                 assign
     3951                 v-object-sump-bonus = v-object-sump-bonus + temp-goods.object-sum
     3952                 .
     3953               end.
     3954             end.
     3955             assign
     3956             v-ratio-bonus = v-object-sump-bonus / v-object-sum-bonus
     3957             .
     3958             assign
     3959             current-line-num-bonus = buf_chk-discnt.line-num
     3960             .
     3961             if buf_chk-discnt.line-type = integer('1':U)
     3962             and can-find(first temp-goods where
     3963                                 temp-goods.doc-code = bufp_chk-doc.doc-code
     3964                             and temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
     3965               create bufp_chk-discnt.
     3966               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     3967               assign
     3968               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     3969               .
     3970             end.
     3971             else do:
     3972               create bufp_chk-discnt.
     3973               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     3974               assign
     3975               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     3976               .
     3977               CASE buf_chk-discnt.line-type:
     3978                 when integer('2':U)
     3979                 or
     3980                 when integer('3':U) then do:
     3981                   assign
     3982                   bufp_chk-discnt.object-sum = v-ratio-bonus * buf_chk-discnt.object-sum
     3983                   bufp_chk-discnt.discnt-value-abs = v-ratio-bonus * buf_chk-discnt.discnt-value-abs
     3984                   bufp_chk-discnt.discnt-value-pcnt =  if bufp_chk-discnt.object-sum <> 0
     3985                                                       then bufp_chk-discnt.discnt-value-abs / bufp_chk-discnt.object-sum * 100
     3986                                                       else 0
     3987                   .
     3988                 end.
     3989                 when integer('4':U)
     3990                 or
     3991                 when integer('5':U) then do:
     3992                   assign
     3993                   bufp_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * bufp_chk-doc.netto / buf_chk-doc.netto
     3994                   bufp_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * bufp_chk-doc.netto / buf_chk-doc.netto
     3995                   bufp_chk-discnt.discnt-value-pcnt =  if bufp_chk-discnt.object-sum <> 0
     3996                                                         then bufp_chk-discnt.discnt-value-abs / bufp_chk-discnt.object-sum * 100
     3997                                                         else 0
     3998                   .
     3999                 end.
     4000               END CASE.
     4001             end.
     4002           end.
     4003           when 5  then do:
     4004             if can-find(first temp-goods where
     4005                               temp-goods.doc-code = bufp_chk-doc.doc-code
     4006                           and temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
     4007               create bufp_chk-discnt.
     4008               buffer-copy buf_chk-discnt except doc-code out-code to bufp_chk-discnt
     4009               assign
     4010               bufp_chk-discnt.doc-code = bufp_chk-doc.doc-code
     4011               .
     4012             end.
     4013           end.
     4014         END CASE.
     4015         if available bufp_chk-discnt then do:
     4016           if p-d-card-mode = 2
     4017           or p-d-card-mode = 3
     4018           then do:
     4019             assign
     4020             bufp_chk-discnt.d-card       = buf_chk-discnt.d-card
     4021             bufp_chk-discnt.src-d-card   = buf_chk-discnt.src-d-card
     4022             .
     4023           end.
     4024           if p-d-card-mode = 2
     4025           and v-ii = v-num-docs
     4026           then do:
     4027             assign
     4028             buf_chk-discnt.d-card       = '':U
     4029             buf_chk-discnt.src-d-card   = '':U
     4030             .
     4031           end.
     4032         end.
     4033       end.
     4034     end.
     4035     if p-d-card-mode = 2 then do:
     4036       assign
     4037       buf_chk-doc.d-card       = '':U
     4038       buf_chk-doc.src-d-card   = '':U
     4039       buf_chk-doc.cli-type     = '':U
     4040       buf_chk-doc.src-cli-type = '':U
     4041       buf_chk-doc.cli-code     = 0
     4042       buf_chk-doc.src-cli-code = 0
     4043       .
     4044     end.
     4045     assign
     4046     buf_chk-doc.chk-type = (if buf_chk-doc.chk-type > 0 and buf_chk-doc.chk-type < 100
     4047                            then (buf_chk-doc.chk-type + 100)
     4048                            else buf_chk-doc.chk-type)
     4049     .
     4050     return ''.
     4051   end.
     4052   end procedure.
