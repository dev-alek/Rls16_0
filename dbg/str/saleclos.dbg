     7041      find first in-vatp-goods where in-vatp-goods.artic     = b-doc-line.artic     and
     7042                                        in-vatp-goods.prod-type = b-doc-line.prod-type and
     7043                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     7044      if (not b-trn-doc.internal and
     7045              b-trn-doc.doc-type = 'при':U) or
     7046         in-vatp-goods.gds-type = 'у':U then do:
