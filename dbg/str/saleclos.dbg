    11290                                                   ,input 0.0
    11291                                                   ,input 0
    11292                                                   ,input no
    11293                                                 ) .
    11294         end.
    11295     end.
    11296   END.
    11297   run waitfram-hide in this-procedure .
    11298   END PROCEDURE.
