     6955                         ,buffer loc-gds-dtl
     6956                         ,input-output new-pl-qnty
     6957                         ,input-output cost-base
     6958                         ,input-output cost-rubl
     6959                         ,-1
     6960                         ,"") no-error.
     6961         if error-status :error then do:
     6962           assign
     6963           v-err-msg = substitute( "Ошибка при резервировании.&1&2"
     6964                                 , chr(10)
     6965                                 , return-value
     6966                                 )
     6967           .
     6968         end.
     6969         else do:
     6970           if new-pl-qnty <> loc-doc-pl.doc-qnty then do:
     6971             assign
     6972             v-err-msg = substitute( "Не удалось зарезервировать все запрошенное количество.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     6973                                   , chr(10)
     6974                                   , loc-doc-pl.doc-qnty - old-pl-qnty
     6975                                   , new-pl-qnty - old-pl-qnty
     6976                                   )
     6977             .
     6978           end.
     6979         end.
     6980         if v-err-msg <> "":U then do:
     6981   if not is-gas(gdscode)
     6982   then do :
     6983   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input v-err-msg                                       ).
     6984   end.
     6985           v-return-st-fl = no.
     6986           undo _docpl, NEXT.
     6987         end.
     6988       end.
     6989       if v-return-st-fl then do:
     6990         assign
     6991         b-trn-doc.status_ = v-return-status
     6992         b-trn-doc.flag = v-return-flag
     6993         v-return-st-fl = no
     6994         .
     6995       end.
     6996   if pl-chg-qnty <> new-pl-qnty - old-pl-qnty then do:
     6997       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input return-value                                       ).
     6998   end.
     6999       assign
     7000       chg-qnty = chg-qnty + pl-chg-qnty
     7001       .
     7002     END.
     7003     if v-qnty <> 0.0
     7004       and v-cli-qnty <> 0.0
