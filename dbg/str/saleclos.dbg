     8259                     "SHIFT_NUM_DOC=" + (if string(buf_inkas.shift-num) = ? then '' else string(buf_inkas.shift-num)) + (if string(buf_inkas.shift-date) = ? then '' else string(buf_inkas.shift-date, "99999999")) + chr(4) +
