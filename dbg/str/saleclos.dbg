     8378               buf_cash-pay.cdpay-code = buf_sysconf.credit-pay no-error.
     8379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8380     (input  'iscredit'
     8381     ,input  0
     8382     ,input  ''
     8383     ,input  0
     8384     ,input  ''
     8385     ,input  ''
     8386     ,input  ''
     8387     ,input  no
     8388     ,output conf-par
     8389     ,output par-type
     8390     ) no-error .
     8391     if error-status:error
     8392     or not available buf_cash-pay
     8393     or buf_cash-pay.is-credit = no
     8394     or conf-par <> "yes"
     8395     then do:
     8396         assign
     8397         cre-pay = 0
     8398         .
     8399     end.
     8400     else do:
     8401       assign
     8402       cre-pay = buf_sysconf.credit-pay
     8403       .
     8404     end.
     8405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8406     (input  'is-ptrl'
     8407     ,input  ''
     8408     ,input  ''
     8409     ,input  0
     8410     ,input  ''
     8411     ,input  ''
     8412     ,input  ''
     8413     ,input  no
