     6913                         ,buffer loc-gds-dtl
     6914                         ,input-output old-pl-qnty
     6915                         ,input-output cost-base
     6916                         ,input-output cost-rubl
     6917                         ,-1, "" ) no-error.
     6918         if error-status :error then do:
     6919           assign
     6920           v-err-msg = substitute( "Ошибка при разрезервировании.&1&2"
     6921                                  , chr(10)
     6922                                  , return-value
     6923                                 )
     6924           .
     6925         end.
     6926         else do:
     6927           if old-pl-qnty <> (- loc-doc-pl.doc-qnty) then do:
     6928             assign
     6929             v-err-msg = substitute( "Не удалось снять резервы по ранее зарезервированному количеству.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     6930                                   , chr(10)
     6931                                   , (- loc-doc-pl.doc-qnty)
     6932                                   , old-pl-qnty
     6933                                   )
     6934             .
     6935           end.
     6936         end.
     6937         if v-err-msg <> "":U then do:
     6938   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input v-err-msg                                       ).
     6939           v-return-st-fl = no.
     6940           undo _docpl, NEXT.
     6941         end.
     6942       end.
     6943       assign
     6944       loc-doc-pl.doc-qnty     = loc-doc-pl.doc-qnty     + pl-chg-qnty
     6945       loc-doc-pl.cli-doc-qnty = loc-doc-pl.cli-doc-qnty + pl-chg-cli-qnty
     6946       loc-doc-pl.cli-qnty     = loc-doc-pl.cli-doc-qnty
     6947       new-pl-qnty             = loc-doc-pl.doc-qnty
     6948       v-qnty                  = v-qnty + pl-chg-qnty
     6949       v-cli-qnty              = v-cli-qnty + pl-chg-cli-qnty
     6950       .
     6951       if new-pl-qnty <> 0.0 then do:
     6952         run trg/rsrv-dtl.p (
     6953                         input parparentproc
