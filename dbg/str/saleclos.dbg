     8682                                                        input v-root-node,
     8683                                                        output v-run-tpsi-line,
     8684                                                        buffer buf_doc-line,
     8685                                                        buffer buf_trn-doc,
     8686                                                        buffer buf_sale-doc).
     8687                       find current buf_trn-doc no-lock .
     8688                       find first buf_spis-doc exclusive-lock where buf_spis-doc.doc-code = replace(buf_trn-doc.doc-code, "-", "^") no-error.
     8689                       find first spis_sale-doc exclusive-lock where spis_sale-doc.inkas-code = p-inkas-code
     8690                                                                 and spis_sale-doc.doc-kind =  'trf':U
     8691                                                                 no-error .
     8692                       find first spis_doc-line exclusive-lock where spis_doc-line.doc-code  = replace(buf_doc-line.doc-code, "-", "^")
     8693                                                                 and spis_doc-line.artic     = buf_doc-line.artic
     8694                                                                 and spis_doc-line.prod-type = buf_doc-line.prod-type
     8695                                                                 and spis_doc-line.prod-code = buf_doc-line.prod-code
     8696                                                                 no-error .
     8697                       if available buf_spis-doc
     8698                       and available spis_sale-doc
     8699                       and available spis_doc-line
     8700                       then do :
     8701                         run RSRV-line in this-procedure (input 1,
     8702                                                          input no,
     8703                                                          input no,
     8704                                                          input yes,
     8705                                                          input no,
     8706                                                          input v-new_doc-code,
     8707                                                          input no,
