     9208                                     "последовательных возвратов и расходов."
     9209                           , chr(10)
     9210                           , buf_inkas.obj-type
     9211                           , buf_inkas.obj-code
     9212                           , dtl-rests.artic
     9213                           , (trim( dtl-rests.prod-type ) + " " + string(dtl-rests.prod-code))
     9214                           ,  (if dtl-rests.b-code > 0
     9215                             then ("по коду : " + string( dtl-rests.b-code, ">>>>>>>>>9" ))
     9216                             else "")
     9217                           ).
     9218                 BadTrans = TRUE .
     9219             END.
     9220             LEAVE.
     9221           END.
     9222         if BadTrans then do:
     9223             run waitfram-hide in this-procedure .
     9224             UNDO f-close, return error v-prichina.
     9225         end.
     9226     end.
     9227     if not v-is-inquiry then do:
     9228       run write-log-and-file in p-log-handle (
     9229             input 1
     9230           , input log-file-name
     9231           , input 1
     9232           , input substitute("Создание накладных МЦ...")
     9233                             ).
