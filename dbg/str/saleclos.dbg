     7050             road-tax-rubl-loc = b-doc-line.road-tax * b-trn-doc.base-rate / b-trn-doc.base-scale.
     7051         end.
     7052         else do:
     7053           ASSIGN
     7054             road-tax-rubl-loc = b-doc-line.road-tax
     7055             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     7056         end.
     7057         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     7058         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     7059         assign
     7060           road-tax-cli-loc = ?.
     7061         ASSIGN
     7062           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     7063           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     7064           transport-cli-loc  = 0
     7065           other-base-loc     = (if b-doc-line.other-base     = ? then 0 else b-doc-line.other-base)
     7066           other-rubl-loc     = (if b-doc-line.other-rubl     = ? then 0 else b-doc-line.other-rubl)
     7067           other-cli-loc      = 0
