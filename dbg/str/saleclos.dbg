     8294   define buffer buf_shift-obj for ub.shift-obj.
     8295   define buffer tpsi_sale-doc for ub.sale-doc.
     8296   define buffer buf_goods for ub.goods.
     8297   define buffer buf_doc-line for ub.doc-line.
     8298   define buffer spis_doc-line for ub.doc-line.
     8299   define buffer buf_sale-doc for ub.sale-doc.
     8300   define buffer spis_sale-doc for ub.sale-doc.
     8301   define buffer bf_doc-fbr-gds for ub.doc-fbr-gds .
     8302   define buffer out-dtl   for ub.gds-dtl.
     8303   define buffer ret-dtl   for ub.gds-dtl.
     8304   do
     8305   on error undo, return error return-value
     8306   :
     8307     find first buf_inkas exclusive-lock
     8308          where buf_inkas.inkas-code = p-inkas-code no-error no-wait.
     8309     if locked buf_inkas then do:
     8310       if p-auto < 2 then return error substitute("Отчет о продаже №&1 занят", p-inkas-code).
     8311                     else return "":U.
     8312     end.
     8313     if NOT available buf_inkas then do:
     8314       return error substitute("Не найден отчет о продаже №&1", p-inkas-code).
     8315     end.
     8316     if p-auto = 2 and buf_inkas.status_ <> 'нередакт':U then do:
     8317       return "":U.
     8318     end.
     8319     if p-auto < 2 then do:
     8320       if not (buf_inkas.status_ = 'новый':U or buf_inkas.status_ = 'нередакт':U) then do:
     8321         return error substitute("Отчет о продаже №&1 имеет статус &2", buf_inkas.inkas-code, buf_inkas.status_).
     8322       end.
     8323   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8324   do:
     8325     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8326       (input  g#db-num
     8327       ,input  g#userid
     8328       ,input  0
     8329       ,input  'actn_sale_fact':U
