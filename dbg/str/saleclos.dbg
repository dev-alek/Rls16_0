     4344   procedure xmlchar-test :
     4345   define input parameter p-in-string          as character        no-undo.
     4346   define output parameter p-out-string-enc    as character        no-undo.
     4347   define output parameter p-out-string-dec    as character        no-undo.
     4348   do
     4349   on error undo, return error
     4350   :
     4351          run xmlchar-encode in this-procedure
     4352       (
     4353             input p-in-string
     4354           , output p-out-string-enc
     4355       ).
     4356          run xmlchar-decode in this-procedure
     4357       (
     4358             input p-out-string-enc
     4359           , output p-out-string-dec
     4360       ).
     4361   end.
     4362   end .
     4363   procedure xmlchar-encode :
     4364   define input parameter p-in-string      as character        no-undo.
     4365   define output parameter p-out-string    as character        no-undo.
     4366       define variable v-position      as integer      no-undo.
     4367       define variable v-current-char  as character    no-undo.
     4368   do
     4369   on error undo, return error
     4370   :
     4371       assign
     4372           p-out-string = "":U
     4373       .
     4374       case p-in-string
     4375       :
     4376           when ?
     4377           then do:
     4378               assign
     4379                   p-out-string = "?":U
     4380               .
     4381           end.
     4382           when "?":U
     4383           then do:
     4384               assign
     4385                   p-out-string = "&#63;":U
     4386               .
     4387           end.
     4388           otherwise do:
     4389               do v-position = 1 to length( p-in-string )
     4390               :
     4391                   assign
     4392                       v-current-char = substring( p-in-string, v-position, 1 )
     4393                   .
     4394                   case v-current-char
     4395                   :
     4396                       when "&":U
     4397                       then do:
     4398                           assign
     4399                               p-out-string = p-out-string + "&amp;":U
     4400                           .
     4401                       end.
     4402                       when ">":U
     4403                       then do:
     4404                           assign
     4405                               p-out-string = p-out-string + "&gt;":U
     4406                           .
     4407                       end.
     4408                       when "<":U
     4409                       then do:
     4410                           assign
     4411                               p-out-string = p-out-string + "&lt;":U
     4412                           .
     4413                       end.
     4414                       when "'":U
     4415                       then do:
     4416                           assign
     4417                               p-out-string = p-out-string + "&apos;":U
     4418                           .
     4419                       end.
     4420                       when '"':U
     4421                       then do:
     4422                           assign
     4423                               p-out-string = p-out-string + "&quot;":U
     4424                           .
     4425                       end.
     4426                       when chr(1)
     4427                       then do:
     4428                           assign
     4429                               p-out-string = p-out-string + "":U
     4430                           .
     4431                       end.
     4432                       when chr(2)
     4433                       then do:
     4434                           assign
     4435                               p-out-string = p-out-string + "":U
     4436                           .
     4437                       end.
     4438                       when chr(3)
     4439                       then do:
     4440                           assign
     4441                               p-out-string = p-out-string + "":U
     4442                           .
     4443                       end.
     4444                       when chr(4)
     4445                       then do:
     4446                           assign
     4447                               p-out-string = p-out-string + "":U
     4448                           .
     4449                       end.
     4450                       when chr(5)
     4451                       then do:
     4452                           assign
     4453                               p-out-string = p-out-string + "":U
     4454                           .
     4455                       end.
     4456                       when chr(6)
     4457                       then do:
     4458                           assign
     4459                               p-out-string = p-out-string + "":U
     4460                           .
     4461                       end.
     4462                       when chr(7)
     4463                       then do:
     4464                           assign
     4465                               p-out-string = p-out-string + "":U
     4466                           .
     4467                       end.
     4468                       when chr(8)
     4469                       then do:
     4470                           assign
     4471                               p-out-string = p-out-string + "":U
     4472                           .
     4473                       end.
     4474                       when chr(9)
     4475                       then do:
     4476                           assign
     4477                               p-out-string = p-out-string + "":U
     4478                           .
     4479                       end.
     4480                       when chr(29)
     4481                       then do:
     4482                           assign
     4483                               p-out-string = p-out-string + "":U
     4484                           .
     4485                       end.
     4486                       when chr(10)
     4487                       then do:
     4488                           assign
     4489                               p-out-string = p-out-string + "&#10;":U
     4490                           .
     4491                       end.
     4492                       when chr(13)
     4493                       then do:
     4494                           assign
     4495                               p-out-string = p-out-string + "&#13;":U
     4496                           .
     4497                       end.
     4498                       otherwise do:
     4499                           assign
     4500                               p-out-string = p-out-string + v-current-char
     4501                           .
     4502                       end.
     4503                   end case.
     4504               end.
     4505           end.
     4506       end case.
     4507   end.
     4508   end .
     4509   procedure xmlchar-encode-1c :
     4510   define input parameter p-in-string      as character        no-undo.
     4511   define output parameter p-out-string    as character        no-undo.
     4512       define variable v-position      as integer      no-undo.
     4513       define variable v-current-char  as character    no-undo.
     4514   do
     4515   on error undo, return error
     4516   :
     4517       assign
     4518           p-out-string = "":U
     4519       .
     4520       case p-in-string
     4521       :
     4522           when ?
     4523           then do:
     4524               assign
     4525                   p-out-string = "?":U
     4526               .
     4527           end.
     4528           otherwise do:
     4529               do v-position = 1 to length( p-in-string )
     4530               :
     4531                   assign
     4532                       v-current-char = substring( p-in-string, v-position, 1 )
     4533                   .
     4534                   case v-current-char
     4535                   :
     4536                       when chr(1)
     4537                       then do:
     4538                           assign
     4539                               p-out-string = p-out-string + " ":U
     4540                           .
     4541                       end.
     4542                       when chr(2)
     4543                       then do:
     4544                           assign
     4545                               p-out-string = p-out-string + " ":U
     4546                           .
     4547                       end.
     4548                       when chr(3)
     4549                       then do:
     4550                           assign
     4551                               p-out-string = p-out-string + " ":U
     4552                           .
     4553                       end.
     4554                       when chr(4)
     4555                       then do:
     4556                           assign
     4557                               p-out-string = p-out-string + " ":U
     4558                           .
     4559                       end.
     4560                       when chr(5)
     4561                       then do:
     4562                           assign
     4563                               p-out-string = p-out-string + " ":U
     4564                           .
     4565                       end.
     4566                       when chr(6)
     4567                       then do:
     4568                           assign
     4569                               p-out-string = p-out-string + " ":U
     4570                           .
     4571                       end.
     4572                       when chr(7)
     4573                       then do:
     4574                           assign
     4575                               p-out-string = p-out-string + " ":U
     4576                           .
     4577                       end.
     4578                       when chr(8)
     4579                       then do:
     4580                           assign
     4581                               p-out-string = p-out-string + " ":U
     4582                           .
     4583                       end.
     4584                       when chr(9)
     4585                       then do:
     4586                           assign
     4587                               p-out-string = p-out-string + " ":U
     4588                           .
     4589                       end.
     4590                       when chr(29)
     4591                       then do:
     4592                           assign
     4593                               p-out-string = p-out-string + " ":U
     4594                           .
     4595                       end.
     4596                       when chr(10)
     4597                       then do:
     4598                           assign
     4599                               p-out-string = p-out-string + " ":U
     4600                           .
     4601                       end.
     4602                       when chr(13)
     4603                       then do:
     4604                           assign
     4605                               p-out-string = p-out-string + " ":U
     4606                           .
     4607                       end.
     4608                       otherwise do:
     4609                           assign
     4610                               p-out-string = p-out-string + v-current-char
     4611                           .
     4612                       end.
     4613                   end case.
     4614               end.
     4615           end.
     4616       end case.
     4617   end.
     4618   end .
     4619   procedure xmlchar-decode :
     4620   define input parameter p-in-string      as character        no-undo.
     4621   define output parameter p-out-string    as character        no-undo.
     4622       define variable v-position      as integer      no-undo.
     4623       define variable v-last-position as integer      no-undo.
     4624       define variable v-temp-integer  as integer      no-undo.
     4625       define variable v-current-char  as character    no-undo.
     4626       define variable v-next-char     as character    no-undo.
     4627       define variable v-success       as logical      no-undo.
     4628   do
     4629   on error undo, return error
     4630   :
     4631       assign
     4632           p-out-string = "":U
     4633           v-position   = 0
     4634       .
     4635       replace-cycle:
     4636       do while yes
     4637       on error undo, return error
     4638       :
     4639           assign
     4640               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4641           .
     4642           if v-last-position <= v-position
     4643           then do:
     4644               if v-position = 0
     4645               then do:
     4646                   assign
     4647                       p-out-string = p-in-string
     4648                   .
     4649               end.
     4650               else do:
     4651                   assign
     4652                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4653                   .
     4654               end.
     4655               leave replace-cycle.
     4656           end.
     4657           else do:
     4658               assign
     4659                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4660                   v-position      = v-last-position
     4661                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4662               .
     4663               if v-current-char = "#":U
     4664               then do:
     4665                   assign
     4666                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4667                   .
     4668                   if v-last-position > 0
     4669                   then do:
     4670                       run xmlchar-read-integer in this-procedure
     4671                        (
     4672                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4673                           , output v-temp-integer
     4674                           , output v-success
     4675                       ).
     4676                       if v-success = yes
     4677                       and v-temp-integer >= 1
     4678                       and v-temp-integer <= 255
     4679                       then do:
     4680                           assign
     4681                               p-out-string = p-out-string + chr( v-temp-integer )
     4682                               v-position   = v-last-position + 1
     4683                           .
     4684                       end.
     4685                       else do:
     4686                           assign
     4687                               p-out-string = p-out-string + "&":U
     4688                               v-position   = v-position   + 1
     4689                           .
     4690                       end.
     4691                   end.
     4692                   else do:
     4693                       assign
     4694                           p-out-string = p-out-string + "&":U
     4695                           v-position   = v-position   + 1
     4696                       .
     4697                   end.
     4698               end.
     4699               else do:
     4700                   case substring( p-in-string, v-position + 1, 3 )
     4701                   :
     4702                       when "lt;":U
     4703                       then do:
     4704                           assign
     4705                               p-out-string = p-out-string + "<":U
     4706                               v-position   = v-position   + 3
     4707                           .
     4708                       end.
     4709                       when "gt;":U
     4710                       then do:
     4711                           assign
     4712                               p-out-string = p-out-string + ">":U
     4713                               v-position   = v-position   + 3
     4714                           .
     4715                       end.
     4716                       otherwise do:
     4717                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4718                           then do:
     4719                               assign
     4720                                   p-out-string = p-out-string + "&":U
     4721                                   v-position   = v-position   + 4
     4722                               .
     4723                           end.
     4724                           else do:
     4725                               case substring( p-in-string, v-position + 1, 5 )
     4726                               :
     4727                                   when "quot;":U
     4728                                   then do:
     4729                                       assign
     4730                                           p-out-string = p-out-string + '"':U
     4731                                           v-position   = v-position   + 5
     4732                                       .
     4733                                   end.
     4734                                   when "apos;":U
     4735                                   then do:
     4736                                       assign
     4737                                           p-out-string = p-out-string + "'":U
     4738                                           v-position   = v-position   + 5
     4739                                       .
     4740                                   end.
     4741                                   otherwise do:
     4742                                       assign
     4743                                           p-out-string = p-out-string + "&":U
     4744                                       .
     4745                                   end.
     4746                               end case.
     4747                           end.
     4748                       end.
     4749                   end case.
     4750               end.
     4751           end.
     4752       end.
     4753   end.
     4754   end .
     4755   procedure xmlchar-read-integer :
     4756   define input parameter p-input-string      as character        no-undo.
     4757   define output parameter p-output-integer   as integer          no-undo.
     4758   define output parameter p-success       as logical          no-undo.
     4759   do
     4760   on error undo, return error
     4761   :
     4762       assign
     4763           p-output-integer = integer( p-input-string )
     4764       no-error.
     4765       if error-status :error
     4766       then do:
     4767           assign
     4768               p-success           = no
     4769               p-output-integer    = 0
     4770           .
     4771       end.
     4772       else do:
     4773           assign
     4774               p-success           = yes
     4775           .
     4776       end.
     4777   end.
     4778   end.
     4779   define variable mMRCCode  as logical    no-undo.
     4780   define variable mTypeMark as character  no-undo.
     4781   function IS-NeedMark returns logical
     4782   ( input ib-code as integer  ,
     4783     input ib-str as character ):
     4784      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4785      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4786                                    and buf_prod-bc-attr.b-str  eq ib-str
     4787                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4788        no-lock no-error.
     4789      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4790   end.
     4791   function repTegforDm return char
     4792   (iDM as char ):
     4793       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4794       define variable vteg as character no-undo.
     4795       define variable oDM as character no-undo.
     4796       define variable vi as integer no-undo.
     4797       oDM = iDm.
     4798       do vi = 1 to num-entries(vTeglist):
     4799          vTeg = entry(vi,vTeglist).
     4800          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4801       end.
     4802       return oDM.
     4803   end.
     4804   function repSpecSimbforDm return char
     4805   (iDM as char ):
     4806       define variable oDM as character no-undo.
     4807     run
     4808       xmlchar-decode(iDM, output oDM).
     4809     return repTegforDm (oDM).
     4810   end.
     4811   function CheckGtin return logical
     4812   (iGtin as char):
     4813      define variable bar_code as character no-undo.
     4814      define variable vGtin as logical no-undo init "yes".
     4815      if length(iGtin) eq 14
     4816      then do:
     4817         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4818         run str/chk-sum.p
     4819          (input-output bar_code ) no-error .
     4820         if iGtin ne  bar_code
     4821         then
     4822            vGtin = no.
     4823      end.
     4824      else
     4825         vGtin = no.
     4826      return vgtin.
     4827   end.
     4828   function repSpecSimbforXlm return char
     4829   (iDM as char ):
     4830       iDM = replace(iDM,chr(29),"").
     4831       return iDM.
     4832   end.
     4833   function getGtinByDM return char
     4834   (IDM as char):
     4835      define variable VTXT as char no-undo.
     4836      define variable vGtin as char no-undo.
     4837      vTXt = IdM.
     4838      vGtin = IDM.
     4839      if    length(vtxt) > 14
     4840      then do:
     4841         if   vtxt begins "(01)"
     4842                or vtxt begins "(02)"
     4843         then
     4844            vGtin = substring(vtxt,5,14).
     4845         else if   (vtxt begins "01"
     4846                or vtxt begins "02" )
     4847                and (   (    substring(iDm,17,2) eq "21"
     4848                         and length(vtxt) >= 21)
     4849                     or substring(iDm,17,2) eq "37"
     4850                     or substring(iDm,17,4) eq "(37)" )
     4851         then do:
     4852            vGtin = substring(vtxt,3,14).
     4853            if not checkGtin(vGtin)
     4854            then
     4855               vGtin = substring(vtxt,1,14).
     4856         end.
     4857         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4858             or length(vtxt) eq 14 + 7 + 4
     4859             or length(vtxt) eq 14 + 7
     4860         then
     4861            vGtin = substring(vtxt,1,14).
     4862      end.
     4863      if not checkGtin(vGtin)
     4864      then
     4865         vGtin = "".
     4866      return vgtin.
     4867   end.
     4868   function getGdsCodeByGtin return int
     4869   (iGtin as char):
     4870      define buffer prod-bc  for ub.prod-bc.
     4871      define buffer bar-code for ub.bar-code.
     4872      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4873      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4874      return if avail bar-code then bar-code.gds-code else ?.
     4875   end.
     4876   function getQntyCodeByGtin return decimal
     4877   (iGtin as char):
     4878      define buffer prod-bc  for ub.prod-bc.
     4879      define buffer bar-code for ub.bar-code.
     4880      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4881      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4882      return if avail bar-code then bar-code.cli-base-rate else ?.
     4883   end.
     4884   function getGdsCodeByDM return int
     4885   (iDm as char):
     4886      define variable vGtin as char no-undo.
     4887      define buffer prod-bc for ub.prod-bc.
     4888      vGtin  = getGtinByDM (IDM ).
     4889      return getGdsCodeByGtin (vGtin).
     4890   end.
     4891   function ChekTypeMarkByGds return logical
     4892   (iGds-code as integer ):
     4893      define buffer goods-attr for ub.goods-attr.
     4894      find first goods-attr where goods-attr.gds-code   = iGds-code
     4895                              and goods-attr.attr-code  = 'mark-type':U
     4896      no-lock no-error.
     4897      if available goods-attr
     4898      then do:
     4899         mTypeMark = goods-attr.attr-value.
     4900         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4901           .
     4902      end.
     4903      else
     4904         return no.
     4905   end.
     4906   function ChekTypeMarkByDm return logical
     4907   (iDM as char ):
     4908      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4909   end.
     4910   function ChekTypeMarkByGtin return logical
     4911   (iGtin as char ):
     4912      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4913   end.
     4914   function GetNextElement return character
     4915     (input iAllTeg        as logical
     4916     ,output oteg          as character
     4917     ,output otegval       as character
     4918     ,input-output pstr    as character
     4919      ):
     4920        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4921        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4922        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4923        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4924        define variable vTeg as character no-undo.
     4925        define variable vLength as integer no-undo.
     4926        define variable vi as integer no-undo.
     4927        define variable vj as integer no-undo.
     4928        define buffer code for ub.code.
     4929        find first code where Code.parent eq "MarkType"
     4930                          and Code.CodeValue   eq mTypeMark
     4931                          no-lock no-error.
     4932        if     available code
     4933           and Code.misc1 ne ""
     4934           and Code.misc1 ne ?
     4935        then do:
     4936           integer (Code.misc1) no-error.
     4937           if not error-status:error
     4938           then
     4939             entry (4,vlistleng) = Code.misc1.
     4940        end.
     4941        if iAllTeg
     4942        then
     4943           assign
     4944              vlistElem     = vlistElem    + vlistElemDop
     4945              vlistleng     = vlistleng    + vlistlengDop
     4946           .
     4947        else if mMRCCode
     4948        then
     4949           assign
     4950              vlistElem     = vlistElem    + ",(8005),8005"
     4951              vlistleng     = vlistleng    + ",000006,0006"
     4952           .
     4953       block-elem:
     4954       do vi = 1 to num-entries(vlistElem):
     4955          vTeg = entry(vi,vlistElem).
     4956          if pstr begins vTeg
     4957          then do:
     4958             if    vTeg eq "21"
     4959             then
     4960                vLength = index(pstr,chr(29)) - 2 no-error.
     4961             if vLength  <= 0
     4962             then
     4963                vLength = int(entry(vi,vlistleng)).
     4964             otegval = substring (pstr,length(vteg) + 1, vLength).
     4965             oteg = replace(replace(vteg,")",""),"(","").
     4966             vTeg = vteg + otegval.
     4967             otegval = replace(otegval,chr(29),"").
     4968             oteg = replace(replace(oteg,")",""),"(","").
     4969             pstr = substring (pstr,length(vTeg)+ 1).
     4970             vTeg = replace(vTeg,chr(29),"").
     4971             leave block-elem.
     4972          end.
     4973          else
     4974             vTeg = "".
     4975       end.
     4976       return vteg.
     4977   end.
     4978   function GetCodeIdent return character
     4979   (iDm as char):
     4980      define variable Velement   as character no-undo init "first".
     4981      define variable oCodeIdent as character no-undo.
     4982      define variable vteg as character no-undo.
     4983      define variable vtegval as character no-undo.
     4984      define variable vGtin as character no-undo.
     4985      define buffer marking for ub.marking.
     4986      for first marking no-lock where
     4987                marking.mark eq iDm
     4988            and marking.unit-ext = "LEVEL2"
     4989      :
     4990        return iDm.
     4991      end.
     4992      vGtin  = getGtinByDM (iDm ).
     4993      ChekTypeMarkByDm(idm).
     4994      if iDm begins 'tech_':U
     4995      then
     4996         oCodeIdent = iDm.
     4997      else if length(iDm) < 21
     4998      then do:
     4999         find first marking where marking.mark eq idm
     5000         no-lock no-error.
     5001         oCodeIdent = if available marking then marking.mark else  ?.
     5002      end.
     5003      else if     length(iDm) eq 29
     5004         and not iDm begins "01"
     5005         and not iDm begins "02"
     5006      then
     5007         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5008      else  if     length(iDm) >= 24
     5009               and (  iDm begins "01"
     5010                   or iDm begins "02")
     5011               and  substring(iDm,17,2) ne "21"
     5012      then do:
     5013         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5014                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5015         then
     5016            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5017         else
     5018            oCodeIdent = iDM.
     5019      end.
     5020      else  if     (   length(iDm) eq 25
     5021                    or length(iDm) eq 21)
     5022               and (not iDm begins "01"
     5023               and  not iDm begins "02")
     5024      then
     5025         oCodeIdent = substring(iDm,1,21).
     5026      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5027      then
     5028         oCodeIdent = substring(iDm,1,21).
     5029      else do while Velement ne "" and idm ne "":
     5030         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5031         oCodeIdent = oCodeIdent + Velement.
     5032      end.
     5033      return oCodeIdent.
     5034   end.
     5035   function GetTegCod return character
     5036   (icodeIdent as char, iTeg as char):
     5037      define variable Velement   as character no-undo init "first".
     5038      define variable oTeg as character no-undo init ?.
     5039      define variable vteg as character no-undo.
     5040      define variable vtegval as character no-undo.
     5041      if     ((length(icodeIdent) eq 21
     5042         and not icodeIdent begins "01"
     5043         and not icodeIdent begins "02")
     5044         or
     5045             ( length(icodeIdent) eq 25
     5046               and not icodeIdent begins "01"
     5047               and not icodeIdent begins "02"))
     5048      then do:
     5049         if iTeg eq "01" or iTeg eq "02"
     5050         then
     5051            oTeg = substring(icodeIdent,1,21).
     5052         else  if  iTeg eq "21"
     5053         then
     5054            oTeg = substring(icodeIdent,15,7).
     5055      end.
     5056      else do:
     5057         ChekTypeMarkByDm(icodeIdent).
     5058         block-teg:
     5059            do while Velement ne "" and icodeIdent ne "":
     5060            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5061            if    Velement begins iTeg
     5062               or Velement begins "(" + iTeg + ")"
     5063            then do:
     5064               oTeg = vtegval.
     5065               leave block-teg.
     5066            end.
     5067         end.
     5068      end.
     5069      return oTeg.
     5070   end.
     5071   function isOAD return logical
     5072   (icodeIdent as character):
     5073      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5074   end.
     5075   function isMark return logical
     5076   (icodeIdent as character):
     5077      define buffer buf_marking for ub.marking.
     5078      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5079             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5080   end.
     5081   function addBracketForCode return character
     5082   (icodeIdent as char):
     5083      define variable Velement   as character no-undo init "first".
     5084      define variable oTeg as character no-undo.
     5085      define variable vteg as character no-undo.
     5086      define variable vtegval as character no-undo.
     5087      define buffer marking for ub.marking.
     5088      find first marking no-lock where
     5089                 marking.mark begins icodeIdent no-error.
     5090      if    not ChekTypeMarkByDm(icodeIdent)
     5091         or length(icodeIdent) le 24
     5092         or (avail marking and marking.unit-ext = "LEVEL2")
     5093      then
     5094         oTeg = icodeIdent.
     5095      else do:
     5096         if (  icodeIdent begins "01"
     5097            or icodeIdent begins "02"
     5098            ) and CheckGtin(substring (icodeIdent,3,14))
     5099            and substring (icodeIdent,17,2) eq "21"
     5100         then do:
     5101            mMRCCode = yes.
     5102            ChekTypeMarkByDm(icodeIdent).
     5103            block-teg:
     5104            do while Velement ne "" and icodeIdent ne "":
     5105               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5106               if vteg ne ""
     5107               then
     5108                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5109            end.
     5110            mMRCCode = no.
     5111         end.
     5112         else do:
     5113            oTeg = icodeIdent.
     5114         end.
     5115      end.
     5116      return oTeg.
     5117   end.
     5118   function getlevelByCodId return int
     5119   (iCode as char):
     5120      define variable vLength as int no-undo.
     5121      define variable vLevel  as int no-undo.
     5122      if not ChekTypeMarkByDM (icode) then return ?.
     5123      vLength = length(iCode).
     5124      if    vLength eq 18
     5125         or vLength eq 20
     5126      then
     5127         Vlevel = 4.
     5128      else if vLength eq 21
     5129      then
     5130         Vlevel = 1.
     5131      else if vLength eq 25
     5132      then do:
     5133         if  iCode begins "01"
     5134         then
     5135            Vlevel = 3.
     5136         else
     5137            Vlevel = 1.
     5138      end.
     5139      else if     vLength >= 26
     5140              and vLength <= 46
     5141      then do:
     5142         if    substring(iCode,17,2) eq "11"
     5143            or substring(iCode,17,2) eq "13"
     5144            or (    substring(iCode,17,2) eq "21"
     5145                and vLength >= 33
     5146                and substring(iCode,26,4) ne "8005")
     5147         then
     5148            Vlevel = 4.
     5149         else if    vLength eq 31
     5150                 or vLength eq 38
     5151                 or vLength eq 39
     5152                 or vLength eq 45
     5153         then
     5154            Vlevel = 1.
     5155         else if    vLength eq 35
     5156                 or vLength eq 43
     5157         then
     5158            Vlevel = 3.
     5159         else
     5160            Vlevel = ?.
     5161      end.
     5162      else
     5163         Vlevel = ?.
     5164      return Vlevel.
     5165   end.
     5166   function getLevelMotpBycodid return character
     5167   (iDm as char):
     5168      define variable vLevel as integer no-undo.
     5169      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5170      vLevel = getlevelByCodId(iDm).
     5171      if    vLevel eq ?
     5172         or vLevel < 1
     5173         or vLevel > 6
     5174      then
     5175         return ?.
     5176      else
     5177         return entry(vlevel,vList).
     5178   end.
     5179   function getLevelUTDByLevelMotp return character
     5180   (iUnit as char):
     5181      define variable vLevel as integer no-undo.
     5182      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5183      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5184      vLevel = lookup(iUnit,vListMOTP).
     5185      if    vLevel eq ?
     5186         or vLevel < 1
     5187         or vLevel > 4
     5188      then
     5189         return ?.
     5190      else
     5191         return entry(vlevel,vListutd).
     5192   end.
     5193   function getLevelMotpByDM return character
     5194   (iDm as char):
     5195      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5196   end.
     5197   function getLevelUTDByCodId return character
     5198   (iDm as char):
     5199      define variable vLevel as integer no-undo.
     5200      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5201      vLevel = getlevelByCodId(iDm).
     5202      if    vLevel eq ?
     5203         or vLevel < 1
     5204         or vLevel > 4
     5205      then
     5206         return ?.
     5207      else
     5208         return entry(vlevel,vList).
     5209   end.
     5210   function getLevelUTDByDM return character
     5211   (iDm as char):
     5212      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5213   end.
     5214   define variable mNotMarkQnty as logical no-undo.
     5215   function getQntyUTDByCodId return decimal
     5216   (iDM as char):
     5217      define variable vLevel as integer no-undo.
     5218      define variable vList as character no-undo init "1,5,10,500".
     5219      define variable vGtin as character no-undo.
     5220      define variable vqnty as decimal no-undo init ?.
     5221      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5222      if vqnty eq ?
     5223      then do:
     5224         if not mNotMarkQnty
     5225         then do:
     5226            define buffer marking for ub.marking.
     5227            define variable vCodident as character no-undo.
     5228            vCodident = GetCodeIdent(idm).
     5229            find first marking where marking.mark begins vCodident no-lock no-error.
     5230            if     available marking
     5231               and marking.box-qnty ne ?
     5232            then
     5233               return marking.box-qnty.
     5234         end.
     5235         vGtin = getGtinByDm(iDM).
     5236         if ChekTypeMarkByGtin (vGtin)
     5237         then do:
     5238            vLevel = getlevelByCodId(iDM).
     5239            if     vLevel >= 1
     5240               and vLevel <= 4
     5241            then
     5242               vqnty = int(entry(vlevel,vList)).
     5243         end.
     5244         else
     5245            vqnty = getQntyCodeByGtin(vgtin).
     5246      end.
     5247      return vqnty.
     5248   end.
     5249   function getQntyUTDByDM return decimal
     5250   (iDm as char):
     5251      define variable vDM as character no-undo.
     5252      if     length (iDm) ne 25
     5253         and length (iDm) ne 29
     5254         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5255      then
     5256         vDM = substring (iDm,1,length (iDm) - 6 ).
     5257      else
     5258         vDM = substring (iDm,1,length (iDm) - 4 ).
     5259      return getQntyUTDByCodId(vDM).
     5260   end.
     5261   function getMRC4 return decimal
     5262   (iMRC as char):
     5263      define variable oMrc     as decimal no-undo init ?.
     5264      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5265      define variable vi       as integer no-undo.
     5266      define variable vfound   as integer no-undo.
     5267      define variable vposStart   as integer no-undo.
     5268      do:
     5269      OMRc = 0.
     5270      do vi = 1 to 4:
     5271         define variable vsimb as character no-undo.
     5272         vsimb = substring(iMRC,vi,1).
     5273         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5274         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5275         if vfound > 0
     5276         then
     5277            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5278         end.
     5279         OMRc = OMRc / 100.
     5280      end.
     5281      return OMRc.
     5282   end.
     5283   function getMRCByDM return decimal
     5284   (iDm as char):
     5285      define variable vMRC     as character no-undo.
     5286      define variable oMrc     as decimal no-undo init ?.
     5287      define variable Velement as character no-undo init "empty".
     5288      define variable vteg as character no-undo.
     5289      define variable vtegval as character no-undo.
     5290      if    length(idm) eq 14 + 7 + 4 + 4
     5291         or length(idm) eq 14 + 7 + 4
     5292      then do:
     5293         vMRC = substring(idm,22,4).
     5294         omrc = getMRC4(vMRC).
     5295      end.
     5296      else do:
     5297          ChekTypeMarkByDm(iDm).
     5298          block-mrc:
     5299          do while Velement ne "" and idm ne "":
     5300             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5301             if Velement begins "8005"
     5302             then do:
     5303                vMRC = substring(Velement,5,6).
     5304                leave block-mrc.
     5305             end.
     5306             else if Velement begins "(8005)"
     5307             then do:
     5308                vMRC = substring(Velement,7,6).
     5309                leave block-mrc.
     5310             end.
     5311          end.
     5312          if vMRC ne ""
     5313          then
     5314             OMRc = dec(vmrc) / 100 no-error.
     5315      end.
     5316      return OMRc.
     5317   end.
     5318   function MoveDate return Date
     5319   (idate as date,
     5320    iMonth as int64):
     5321      define variable vMonth   as int64 no-undo.
     5322      define variable vYear    as int64 no-undo.
     5323      define variable vDateNew as date  no-undo.
     5324       define variable vDay     as int64 no-undo.
     5325       vMonth = month(iDate) + iMonth.
     5326       vYear =  year(iDate).
     5327       if vMonth <= 0
     5328       then assign
     5329          vMonth = vMonth + 12
     5330           vYear  = vYear - 1
     5331       .
     5332       else if vMonth > 12
     5333       then assign
     5334          vMonth = vMonth - 12
     5335           vYear  = vYear + 1
     5336       .
     5337       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5338       do while error-status:error eq yes:
     5339          VDay = vDay + 1.
     5340          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5341       end.
     5342       if VDay > 0
     5343       then
     5344          vDateNew + 1.
     5345       return vDateNew.
     5346   end.
     5347   procedure checkEMRC:
     5348   define input  parameter iDm as character no-undo.
     5349   define output parameter vok as logical   no-undo init yes.
     5350      define variable v-value-emrc as character no-undo.
     5351      define variable v-type-emrc  as character no-undo.
     5352      define variable vDateIso     as character no-undo.
     5353      define variable vMRC         as decimal no-undo.
     5354      define variable vqnty        as decimal no-undo.
     5355      define variable vPrice       as decimal no-undo.
     5356      define variable vparent      as character no-undo.
     5357      define variable vgds-code    as integer no-undo.
     5358      define buffer code for ub.code.
     5359      vMRC = getMRCByDM(iDm).
     5360      if vMRC > 0
     5361      then do:
     5362         vgds-code = getGdsCodeByDM(iDm).
     5363         vqnty     = getQntyUTDByDM(iDm).
     5364               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5365            (
     5366             input   vgds-code
     5367            ,input   'emrc-type':U
     5368            ,output   v-value-emrc
     5369            ,output   v-type-emrc
     5370          ) no-error.
     5371          if     v-value-emrc ne ""
     5372             and v-value-emrc ne ?
     5373          then do:
     5374             vDateIso = iso-date(today).
     5375             vPrice = vMRC / vqnty.
     5376             vparent ="emc" + chr(4) + v-value-emrc.
     5377             find last code where Code.parent      eq vparent
     5378                              and Code.code        le vDateIso
     5379                              and code.status_  eq 0
     5380             no-lock no-error.
     5381             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5382             then
     5383                vOk = true .
     5384             else do:
     5385                 define variable vText      as character no-undo.
     5386                 define variable vDate      as date no-undo.
     5387                 define variable vDateLast  as character no-undo.
     5388                 define variable vDateFirst as character no-undo.
     5389                 define variable vDate3     as date no-undo.
     5390                 vdate = date(code.misc1).
     5391                 vDateLast = code.misc1.
     5392                 vDate3 = MoveDate(today, - 3 ).
     5393                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5394                                      string(vDate3  , "99/99/9999"),
     5395                                      string(vDate   , "99/99/9999")
     5396                                      ).
     5397                 vdateIso = iso-date(vdate3).
     5398                 find last code  where Code.parent      eq vparent
     5399                                   and Code.code        le vDateIso
     5400                                   and code.status_  eq 0 no-lock no-error.
     5401                 if available code
     5402                 then
     5403                    vDateIso = code.code.
     5404                 vDateFirst = vDateIso.
     5405                 vDateLast = iso-date(vdate).
     5406                 define variable vGood as logical no-undo.
     5407                 define variable vDateSale as date no-undo.
     5408                 define buffer bcode for code.
     5409                 for last code where Code.parent   eq vparent
     5410                                 and code.status_  eq 0
     5411                                 and code.code     < vDateLast
     5412                                 and code.code     >= vDateFirst
     5413                 no-lock:
     5414                    find first bcode where bCode.parent   eq vparent
     5415                                       and bcode.status_  eq 0
     5416                                       and bcode.code     > code.code no-lock no-error.
     5417                    if available bcode
     5418                    then do:
     5419                       if vPrice < dec(Code.CodeValue)
     5420                       then
     5421                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5422                                                     chr(10),
     5423                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5424                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5425                                                     ).
     5426                       else do:
     5427                          vGood = yes.
     5428                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5429                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5430                                                     chr(10),
     5431                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5432                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5433                                                     string(         vDateSale            ,"99/99/9999"),
     5434                                                     string(vDateSale - today)
     5435                                                     ).
     5436                       end.
     5437                    end.
     5438                 end.
     5439                 if vgood
     5440                 then do:
     5441                    define variable choice as integer no-undo .
     5442                    run gbl/d-askw.w (input "Уточнение"
     5443                           ,input  vText
     5444                           ,input "|"
     5445                           ,input "Принять|Вернуть"
     5446                           ,input "Принять данный товар|Вернуть товар постащику"
     5447                           ,input 1
     5448                           ,input 2
     5449                           ,output choice) no-error.
     5450                    vok = choice eq 1.
     5451                 end.
     5452                 else
     5453                    vok =false.
     5454             end.
     5455          end.
     5456      end.
     5457   end.
     5458   function addGs2Mark return character
     5459   (iMark as char):
     5460      define variable vDM   as character no-undo.
     5461      define variable vIdx  as integer   no-undo.
     5462      if index(iMark,chr(29),1) > 0
     5463      then return iMark.
     5464      if substring(iMark,26,4) = "8005" then
     5465      do:
     5466        vIdx = index(iMark,"93",26 + 4 + 5).
     5467        if vIdx > 1 then do:
     5468          vDM = substitute("&1&4&2&4&3",
     5469                           substring(iMark,1,25),
     5470                           substring(iMark,26,vIdx - 25 - 1),
     5471                           substring(iMark,vIdx),
     5472                           chr(29)) no-error.
     5473          vIdx = index(vDm,"240",vIdx + 4).
     5474          if vIdx > 0 then
     5475          do:
     5476            vDM = substitute("&1&3&2",
     5477                             substring(vDm,1,vIdx - 1),
     5478                             substring(vDm,vIdx),
     5479                             chr(29)) no-error.
     5480          end.
     5481        end.
     5482        else
     5483          vDM = substitute("&1&3&2",
     5484                           substring(iMark,1,25),
     5485                           substring(iMark,26),
     5486                           chr(29)) no-error.
     5487      end.
     5488      else if substring(iMark,32,2) = "91" then
     5489      do:
     5490        vIdx = index(iMark,"92",32).
     5491        if vIdx > 1 then
     5492          vDM = substitute("&1&4&2&4&3",
     5493                           substring(iMark,1,31),
     5494                           substring(iMark,32,vIdx - 31 - 1),
     5495                           substring(iMark,vIdx),
     5496                           chr(29)) no-error.
     5497        else
     5498          vDM = substitute("&1&3&2",
     5499                           substring(iMark,1,31),
     5500                           substring(iMark,32),
     5501                           chr(29)) no-error.
     5502      end.
     5503      else if substring(iMark,39,2) = "91" then
     5504      do:
     5505        vIdx = index(iMark,"92",38).
     5506        if vIdx > 1 then
     5507          vDM = substitute("&1&4&2&4&3",
     5508                           substring(iMark,1,38),
     5509                           substring(iMark,39,vIdx - 38 - 1),
     5510                           substring(iMark,vIdx),
     5511                           chr(29)) no-error.
     5512        else
     5513          vDM = substitute("&1&3&2",
     5514                           substring(iMark,1,38),
     5515                           substring(iMark,39),
     5516                           chr(29)) no-error.
     5517      end.
     5518      else if substring(iMark,25,2) = "93" then
     5519      do:
     5520        vIdx = index(iMark,"92",25).
     5521        if vIdx > 1 then
     5522          vDM = substitute("&1&4&2&4&3",
     5523                           substring(iMark,1,24),
     5524                           substring(iMark,25,vIdx - 24 - 1),
     5525                           substring(iMark,vIdx),
     5526                           chr(29)) no-error.
     5527        else
     5528          vIdx = index(iMark,"3103",25).
     5529          if vIdx > 0 then
     5530          vDM = substitute("&1&4&2&4&3",
     5531                           substring(iMark,1,24),
     5532                           substring(iMark,25,vIdx - 24 - 1),
     5533                           substring(iMark,vIdx),
     5534                           chr(29)) no-error.
     5535          else
     5536            vDM = substitute("&1&3&2",
     5537                             substring(iMark,1,24),
     5538                             substring(iMark,25),
     5539                             chr(29)) no-error.
     5540      end.
     5541      else if substring(iMark,32,2) = "93" then
     5542      do:
     5543        vDM = substitute("&1&3&2",
     5544              substring(iMark,1,31),
     5545              substring(iMark,32),
     5546              chr(29)) no-error.
     5547      end.
     5548      return if vDM <> "" then vDm else iMark.
     5549   end.
