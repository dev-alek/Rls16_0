     8218                     "FactDate=" + (if string(buf_inkas.fact-date) = ? then '' else string(buf_inkas.fact-date)) + chr(4) +
     8219                     "DocType=" + "Продажа" + chr(4) +
     8220                     "SHIFT_NUM_DOC=" + (if string(buf_inkas.shift-num) = ? then '' else string(buf_inkas.shift-num)) + (if string(buf_inkas.shift-date) = ? then '' else string(buf_inkas.shift-date, "99999999")) + chr(4) +
     8221                     "SHIFT_NUM=" + (if string(varobj-shift-num) = ? then '' else string(varobj-shift-num)) + (if string(varobj-shift-date) = ? then '' else string(varobj-shift-date, "99999999")) + chr(4) +
     8222                     "Status=" + string(buf_inkas.status_) + chr(4) +
     8223                     "RESULT=1" + chr(4) +
     8224                     "Description=" + v-mess no-error.
     8225       run trg/userlog.p (
     8226             input 'update':U
     8227           , input 'c-inkas':U
     8228           , input ( buffer ub.c-inkas:handle )
     8229           , input v-vid-action
     8230           , input v-vid-param
     8231       ) no-error.
     8232     end.
     8233   end.
     8234   else do:
     8235     find first buf_inkas no-lock where
     8236                   buf_inkas.inkas-code = p-inkas-code no-error.
     8237     find first buf_trn-doc no-lock where
     8238       buf_trn-doc.doc-code = p-inkas-code no-error.
     8239     find last ub.c-inkas no-lock where ub.c-inkas.inkas-code = buf_inkas.inkas-code and ub.c-inkas.corr-user-db-num = v-db-num no-error.
     8240     if available (buf_inkas) and available (ub.c-inkas )
     8241     then do:
     8242       find first bf_clients no-lock where bf_clients.obj-type = 'чел':U and  bf_clients.obj-code = buf_trn-doc.boss no-error.
     8243   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     8245     (input  buf_inkas.obj-type
