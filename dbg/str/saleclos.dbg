     6647   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     6648   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     6649   define variable v-is-own                    as logical no-undo .
     6650   define variable v-to-reserv                 as logical no-undo .
     6651   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     6652   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     6653   define variable v-was-gds-dtl-doc-qnty      like ub.gds-dtl.fact-qnty no-undo .
     6654   define variable v-return-st-fl              as logical no-undo .
     6655   define variable v-return-status             like ub.trn-doc.status_ no-undo .
     6656   define variable v-return-flag               like ub.trn-doc.flag    no-undo .
     6657   define variable v-dop-sale-negative-check   as character no-undo .
     6658   define variable v-nc-option                 as character no-undo .
     6659   define variable current-rgds-dtl            as recid no-undo .
     6660   define variable v-qnty                      as decimal no-undo .
     6661   define variable v-cli-qnty                  as decimal no-undo .
     6662   define variable v-err-msg                   as character no-undo .
     6663   define buffer tpsi_sale-doc for ub.sale-doc.
     6664   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     6665       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6666       define buffer   in-vatp-parts    for ub.parts   .
     6667       define buffer   in-vatp-doc      for ub.trn-doc .
     6668       define buffer   in-vatp-goods    for ub.goods   .
     6669       define buffer   in-vatp-sysconf  for ub.sysconf .
     6670       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6671       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6672       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6673       define variable varinvprb                  as   character              no-undo.
     6674       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6675       define variable cli-base-rate              as   decimal                no-undo.
     6676       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6677       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6678       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6679       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6680       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6681       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6682       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6683       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6684       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6685       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6686       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6687       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6688       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6689       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6690       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6691       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6692       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6693       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6694       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6695       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6696       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6697       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6698       define variable varinvatp-envd             as   character              no-undo.
     6699       define variable varinvatp-type             as   character              no-undo.
     6700   define buffer buf_dtl-rests for dtl-rests.
     6701   if buf_sale-doc.in-inkas = no
     6702   and not can-find(first dtl-rests no-lock where dtl-rests.gds-code = gdscode) then do:
     6703      v-dop-sale-negative-check = ',' + 'negative-check':U + "=1".
     6704   end.
     6705   if not p-rsrv-prop-goods
     6706   AND (p-tpsi-obj
     6707   and p-r-v = 1
     6708   and not cashplace
     6709   and not cashparts
     6710   and not b-trn-doc.office)
     6711   then do:
     6712     run tpsi-gds-proprietor in this-procedure (
     6713                                                 input gdscode
     6714                                                ,input g#db-num
     6715                                                ,output v-proprietor-host-code
     6716                                                ,output v-proprietor-obj-type
     6717                                                ,output v-proprietor-obj-code ) no-error .
     6718     if error-status:error then do:
     6719       num_rec = num_rec + 1.
     6720       undo, return error substitute("Ошибки при проверке атрибута товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 на БД &2:&3&4 &5"
     6721                                     ,gdscode
     6722                                     ,g#db-num
     6723                                     , chr(10)
     6724                                     , error-status:get-message(1)
     6725                                     , return-value
     6726                                     ).
     6727     end.
     6728     if (v-proprietor-obj-type = "":U
     6729         and
     6730         v-proprietor-obj-code = 0)
     6731     or v-proprietor-obj-code = ?
     6732         then do:
     6733       num_rec = num_rec + 1.
     6734       undo, return error substitute("Не установлен атрибут товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 ни для одного объекта БД &2"
     6735                                     ,gdscode
     6736                                     ,g#db-num
     6737                                     ).
     6738     end.
     6739     if (v-proprietor-obj-type = b-trn-doc.obj-type
     6740     and v-proprietor-obj-code = b-trn-doc.obj-code)
     6741     then do:
     6742       assign
     6743       v-is-own = yes
     6744       .
     6745     end.
     6746     else do:
     6747       assign
     6748       p-run-tpsi = yes.
     6749       if v-proprietor-host-code = v-host-code then do:
     6750         assign
     6751         v-ext-doc-type = 'ev':U .
     6752       end.
     6753       else do:
     6754         assign
     6755         v-ext-doc-type =  'ee':U .
     6756       end.
     6757       find first tpsi_sale-doc no-lock where
     6758                 tpsi_sale-doc.inkas-code = buf_sale-doc.inkas-code
     6759             and tpsi_sale-doc.tpsidoc = yes
     6760             and tpsi_sale-doc.obj-type = v-proprietor-obj-type
     6761             AND tpsi_sale-doc.obj-code = v-proprietor-obj-code
     6762             AND tpsi_sale-doc.ext-doc-type = v-ext-doc-type  no-error .
     6763      end.
     6764   end.
     6765   else v-is-own = yes.
     6766   if v-is-own then do:
     6767     assign
     6768     v-to-reserv = yes
     6769      rsrv-option =  (if (rgds-dtl = ?) and not p-auto-fbr
     6770                     then 'reserv':U  + ',' + 'no-msg-no-chk-acta-cr':U
     6771                     else 'reserv':U
     6772                     )
     6773     + v-dop-sale-negative-check
     6774     .
     6775     if cashfbr and p-auto-fbr-on and rz and not p-auto-fbr then return.
     6776     if p-tpsi-obj
     6777     and p-rsrv-prop-goods = yes then do:
     6778       find first buf_dtl-rests no-lock where
     6779                 buf_dtl-rests.gds-code = gdscode no-error .
     6780       if available buf_dtl-rests
     6781       and buf_dtl-rests.prop > 0
     6782       and buf_dtl-rests.ok-prop then do:
     6783         assign
     6784         v-nc-option = "=1":U.
     6785         assign
     6786         rsrv-option = rsrv-option + ',' + 'negative-check':U + v-nc-option
     6787         .
     6788       end.
     6789     end.
     6790   end.
     6791   else do:
     6792     assign
     6793     cashfbr = no.
     6794     if p-rest-tpsi or rz = no then do:
     6795       assign
     6796       v-nc-option = "=2":U.
     6797       assign
     6798       v-to-reserv = yes
     6799       rsrv-option =  'reserv':U  + ',' + 'no-msg-no-chk-acta-cr':U + ',' + 'negative-check':U + v-nc-option
     6800       .
     6801       if p-rest-tpsi then do:
     6802         assign
     6803         rsrv-option = rsrv-option + ',' + 'sale-negative-check-on':u
     6804         .
     6805       end.
     6806     end.
     6807   end.
     6808   if cashfbr
     6809   and (not p-rest-dish)
     6810   and p-auto-fbr-on and rz
     6811   and p-fbr-income-doc-code <> "":U
     6812   then do:
     6813     _parts:
     6814     for each buf_parts no-lock
     6815         where buf_parts.obj-type  = b-trn-doc.obj-type
     6816           and buf_parts.obj-code  = b-trn-doc.obj-code
     6817           and buf_parts.prod-type = b-doc-line.prod-type
     6818           and buf_parts.prod-code = b-doc-line.prod-code
     6819           and buf_parts.artic     = b-doc-line.artic
     6820           and buf_parts.status_   = yes
     6821           and buf_parts.out-code  = p-fbr-income-doc-code
     6822     on error undo, return error return-value
     6823       :
     6824       assign
     6825       rsrv-option = 'reserv':U
     6826                       + "," + 'rsrv-single-part':U
     6827                       + "," + 'rsrv-in-code':U   + "=":u + str-encode ( buf_parts.in-code  ,  "", ",=":u )
     6828                       + "," + 'rsrv-part-code':U + "=":u + str-encode ( buf_parts.part-code,  "", ",=":u )
     6829       rsrv-option = rsrv-option  + ',' + 'no-msg-no-chk-acta-cr':U
     6830       .
     6831       leave _parts.
     6832     end.
     6833   end.
     6834   if cashplace then do:
     6835     FIND FIRST loc-gds-dtl WHERE
     6836             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     6837             loc-gds-dtl.artic = b-doc-line.artic AND
     6838             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     6839             loc-gds-dtl.prod-code = b-doc-line.prod-code AND
     6840             loc-gds-dtl.prt-code = nodecode
     6841             EXCLUSIVE-LOCK NO-ERROR.
     6842     IF rz  and loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then LEAVE.
     6843     IF NOT rz and loc-gds-dtl.doc-qnty = 0 then LEAVE.
     6844     IF NOT (rgds-dtl = ?) AND NOT recid(loc-gds-dtl) = rgds-dtl THEN LEAVE.
     6845     if ( num_rec modulo 10 ) = 0 then
     6846   run write-counter in p-log-handle (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res)).
     6847     if rz then
     6848     find first buf_tt0-gds-dtl no-lock where
     6849               buf_tt0-gds-dtl.artic = loc-gds-dtl.artic
     6850          AND  buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     6851          AND  buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     6852          AND  buf_tt0-gds-dtl.prt-code  = loc-gds-dtl.prt-code no-error .
     6853     assign
     6854     chg-qnty   = 0.0
     6855     res-qnty   = 0.0
     6856     cost-base  = 0.0
     6857     cost-rubl  = 0.0
     6858     v-qnty     = 0.0
     6859     v-cli-qnty = 0.0
     6860     gds-dtl-res-qnty = if rz
     6861                       then ((loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty) + (if available buf_tt0-gds-dtl
     6862                                                                               then (buf_tt0-gds-dtl.fact-qnty - buf_tt0-gds-dtl.doc-qnty)
     6863                                                                               else 0))
     6864                       else (if r-qnty = ?
     6865                             then (- loc-gds-dtl.doc-qnty)
     6866                             else r-qnty)
     6867     .
     6868     _docpl:
     6869     FOR EACH loc-doc-pl where
     6870               loc-doc-pl.gds-code = gdscode AND
     6871               loc-doc-pl.out-code = b-doc-line.doc-code ON ERROR UNDO, NEXT:
     6872       assign
     6873       v-qnty                  = v-qnty + loc-doc-pl.doc-qnty
     6874       v-cli-qnty              = v-cli-qnty + loc-doc-pl.cli-doc-qnty
     6875       .
     6876       if rz and loc-doc-pl.fact-qnty <= loc-doc-pl.doc-qnty then NEXT.
     6877       if not rz and loc-doc-pl.doc-qnty = 0 then NEXT.
     6878       if NOT r-pl-code = ? AND r-pl-code <> loc-doc-pl.pl-code then NEXT.
     6879       assign
     6880       v-err-msg       = "":U
     6881       pl-chg-qnty     = (if rz then loc-doc-pl.fact-qnty     else 0.0 ) - loc-doc-pl.doc-qnty
     6882       pl-chg-cli-qnty = (if rz then loc-doc-pl.cli-fact-qnty else 0.0 ) - loc-doc-pl.cli-doc-qnty
     6883       res-qnty = res-qnty + pl-chg-qnty
     6884       no-partion-qnty = gds-dtl-res-qnty - res-qnty
     6885       cost-base = 0
     6886       cost-rubl = 0
     6887       rsrv-option-place = rsrv-option + "," + 'plcode':U + "=" + string(loc-doc-pl.pl-code)
     6888      rsrv-option  = rsrv-option  + ',' + 'no-msg-no-chk-acta-cr':U
     6889                                  + ',' + 'negative-check':U + "=1"
     6890       .
     6891       if b-trn-doc.status_ = 'нередакт':U
     6892       or b-trn-doc.flag <> no
     6893       then do:
     6894         assign
     6895         v-return-status =  b-trn-doc.status_
     6896         v-return-flag = b-trn-doc.flag
     6897         b-trn-doc.status_ = 'накл':U
     6898         b-trn-doc.flag = no
     6899         v-return-st-fl = yes
     6900         .
     6901       end.
     6902       if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     6903       then do :
     6904         if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     6905       end.
     6906       assign
     6907         old-pl-qnty = (- loc-doc-pl.doc-qnty)
     6908       .
