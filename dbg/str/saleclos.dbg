     5698       ,input  7
     5699       ,output v-user-action29
     5700       ,output v-printed29
     5701       ) .
     5702   end.
     5703   if v-view-log = true
     5704   and (g#news
     5705   or g#auto)
     5706   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5707   then do:
     5708      run cb_set-view-log in p-parent-handle ( input yes).
     5709   end.
     5710   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     5711     OS-DELETE value(string("./":U) + 'saleclos.log').
     5712   end.
     5713                           return "error":U.                  end.
     5714     end.
     5715   end.
     5716   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5717   PROCEDURE INV-CHK:
     5718   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     5719   define input parameter v-curr-r-b   as character no-undo .
     5720   define parameter buffer buf_inkas   for ub.inkas.
     5721   define parameter buffer buf_trn-doc for ub.trn-doc.
     5722   define input parameter r-or-v as character no-undo .
     5723   define input parameter r-office as character no-undo .
     5724   define input parameter rdoc-line as recid no-undo .
     5725   define variable accum-inkas-pay-tot-r-b as decimal no-undo.
     5726   define variable accum-inkas-pay-desk-tot-r-b as decimal no-undo.
     5727   define variable l-inv-on as logical no-undo .
     5728   define variable v-in-inv as logical no-undo .
     5729   define variable v-inkas-qnty-r as decimal no-undo .
     5730   define variable v-inkas-qnty-v as decimal no-undo .
     5731   define buffer buf_doc-line for ub.doc-line.
     5732   define buffer buf_goods    for ub.goods.
     5733   define buffer buf_inkas-pay for ub.inkas-pay.
     5734   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     5735   define buffer buf_sale-doc for ub.sale-doc.
     5736   if buf_trn-doc.status_ = 'запрос':U then do:
     5737   end.
     5738   else do:
     5739       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка товаров продажи на присутствие в незакрытой инвентаризации..."                                       ).
     5740     _buf_sale-doc:
     5741     for each buf_sale-doc where
     5742             buf_sale-doc.inkas-code = p-inkas-code
     5743         and buf_sale-doc.order > 0
     5744       on error undo _buf_sale-doc, next _buf_sale-doc:
     5745       if buf_sale-doc.in-inkas = yes
     5746       and buf_sale-doc.dir = 1 then do:
     5747          assign
     5748          v-inkas-qnty-r = v-inkas-qnty-r + buf_sale-doc.fact-qnty.
     5749       end.
     5750       if buf_sale-doc.in-inkas = yes
     5751       and buf_sale-doc.dir = -1 then do:
     5752          assign
     5753          v-inkas-qnty-v = v-inkas-qnty-v + buf_sale-doc.fact-qnty.
     5754       end.
     5755       if buf_sale-doc.doc-kind = 'rwo':U then next _buf_sale-doc.
     5756       if r-or-v <> ?
     5757       and (buf_sale-doc.doc-kind <> r-or-v
     5758            or
     5759            buf_sale-doc.chr-office <> r-office
     5760             ) then NEXT _buf_sale-doc.
     5761       _buf_doc-line:
     5762       FOR EACH buf_doc-line WHERE
     5763               buf_doc-line.doc-code = buf_sale-doc.doc-code
     5764           AND (rdoc-line = ? or recid(buf_doc-line) = rdoc-line) NO-LOCK :
     5765   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5766   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     5767     (input  buf_doc-line.obj-type
     5768     ,input  buf_doc-line.obj-code
     5769     ,input  buf_doc-line.artic
     5770     ,input  buf_doc-line.prod-type
     5771     ,input  buf_doc-line.prod-code
     5772     ,input  'inv-on=request'
     5773     ,output l-inv-on
     5774     ) no-error .
     5775         if error-status :error then do:
     5776           undo, return error substitute("&1 &2 &3 Ошибка получения признака товара на объекте:&4&5 &6"
     5777                                         ,vss-workfile
     5778                                         ,vss-revision
     5779                                         ,vss-description
     5780                                         , chr(10)
     5781                                         , error-status:error
     5782                                         , return-value
     5783                                           ).
     5784         end.
     5785         if l-inv-on then do:
     5786           FIND FIRST buf_goods WHERE
     5787                     buf_doc-line.prod-type = buf_goods.prod-type
     5788                 and buf_doc-line.prod-code = buf_goods.prod-code
     5789                 and buf_doc-line.artic = buf_goods.artic NO-LOCK .
     5790           run waitfram-hide in this-procedure .
     5791             run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Артикул :&1 &2- товар в инвентаризации.&3&3" +                   (if p-auto = 0 then "Резервирование и/или закрытие отчета невозможно" else "":U)                                   ,buf_doc-line.artic                                                            ,buf_goods.gds-name                                                            , chr(10))                                       ).
     5792           if p-auto = 0 then do:
     5793             undo, return error.
     5794           end.
     5795           else do:
     5796             assign
     5797             v-in-inv = yes
     5798             .
     5799           end.
     5800         end.
     5801       END.
     5802     end.
     5803     if v-in-inv then do:
     5804           undo,  return error substitute("Имеются товары в инвентаризации.&2&2Закрытие отчета невозможно."
     5805                                   , chr(10)).
     5806     end.
     5807     run waitfram-hide in this-procedure .
     5808   end.
     5809   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Сравнение сумм по товарам и выручке......"                                       ).
     5810   assign
     5811   accum-inkas-pay-tot-r-b = 0
     5812   .
     5813   FOR EACH buf_inkas-pay WHERE
     5814            buf_inkas-pay.inkas-code = buf_inkas.inkas-code NO-LOCK
     5815   :
     5816     accum-inkas-pay-tot-r-b = accum-inkas-pay-tot-r-b + (if v-curr-r-b = 'base':U
     5817                                                          then buf_inkas-pay.tot-base
     5818                                                          else buf_inkas-pay.tot-rubl)
     5819                                                          .
     5820     accum-inkas-pay-desk-tot-r-b = 0.
     5821     FOR EACH buf_inkas-pay-desk WHERE
     5822              buf_inkas-pay-desk.inkas-code = buf_inkas.inkas-code AND
     5823              buf_inkas-pay-desk.pay-code   = buf_inkas-pay.pay-code AND
     5824              buf_inkas-pay-desk.curr-code  = buf_inkas-pay.curr-code NO-LOCK
     5825     :
     5826         accum-inkas-pay-desk-tot-r-b = accum-inkas-pay-desk-tot-r-b +
     5827                                        (if v-curr-r-b = 'base':U
     5828                                         then buf_inkas-pay-desk.tot-base
     5829                                         else buf_inkas-pay-desk.tot-rubl).
     5830     END .
     5831     if (v-curr-r-b = 'base':U and abs( buf_inkas-pay.tot-base -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     5832     OR (v-curr-r-b = 'rubl':U and abs( buf_inkas-pay.tot-rubl -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     5833     then do:
     5834       run waitfram-hide in this-procedure .
     5835       undo, return error substitute("&1 Ошибка оплат по чекам&2По оплатам &3&2По оплатам по кассе &4"
     5836                               , vss-description
     5837                               , chr(10)
     5838                               , (if v-curr-r-b = 'base':U then buf_inkas-pay.tot-base else buf_inkas-pay.tot-rubl )
     5839                               , accum-inkas-pay-desk-tot-r-b).
     5840     end.
     5841   END .
     5842   if abs( buf_inkas.netto -  accum-inkas-pay-tot-r-b ) > 0.015 then do:
     5843     run waitfram-hide in this-procedure .
     5844     undo, return error substitute("&1 Ошибка оплат по чекам&2По отчету &3&2По оплатам &4"
     5845                             , vss-description
     5846                             , chr(10)
     5847                             , buf_inkas.netto
     5848                             , accum-inkas-pay-tot-r-b).
     5849   end.
     5850   if buf_inkas.qnty <> v-inkas-qnty-r - v-inkas-qnty-v then do:
     5851     run waitfram-hide in this-procedure .
     5852     undo, return error substitute("&1 Несоответствие накладных и документа продажи&2" +
     5853                              "Количество товара в продаже &3&2"  +
     5854                              "Количество товара в расходной накладной &4&2" +
     5855                              "Количество товара в возвратной накладной &5&2"
     5856                              ,vss-description
     5857                              , chr(10)
     5858                              , buf_inkas.qnty
     5859                              , v-inkas-qnty-r
     5860                              , v-inkas-qnty-v).
     5861   end.
     5862   run waitfram-hide in this-procedure .
     5863   END PROCEDURE.
     5864   PROCEDURE neg-rests:
     5865   define input parameter from-close as logical.
     5866   define input parameter p-status_ like ub.inkas.status_ no-undo .
     5867   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     5868   define input parameter p-mode       as character no-undo .
     5869   define input parameter p-is-catering as logical no-undo .
     5870   define input parameter p-is-tpsi-obj  as logical no-undo .
     5871   define input parameter p-neg-tpsi-weight as logical no-undo .
     5872   define input parameter p-neg-tpsi-qnty as decimal no-undo .
     5873   define input parameter p-neg-tpsi-oper as logical no-undo .
     5874   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка возможности появления недопустимых отрицательных остатков..."                                       ).
     5875   if not p-mode = 'ПРОСМОТР':U then do:
     5876     run str/dtlrests.p (
     5877                    input p-inkas-code
     5878                   ,input from-close
     5879                   ,input "all":U
     5880                   ,input no
     5881                   ,input p-is-catering
     5882                   ,input p-is-tpsi-obj
     5883                   ,input p-neg-tpsi-weight
     5884                   ,input p-neg-tpsi-qnty
     5885                   ,input p-neg-tpsi-oper
     5886                   ).
     5887     if not from-close then do:
     5888       for each dtl-rests :
     5889         if p-status_ <> 'факт':U
     5890         and p-mode = 'ИЗМЕНЕНИЕ':U
     5891         and p-is-tpsi-obj
     5892         and dtl-rests.is-neg-tpsi-oper then do:
     5893           find first dtl-rests-mark where
     5894                     dtl-rests-mark.artic = dtl-rests.artic
     5895                 and dtl-rests-mark.prod-type = dtl-rests.prod-type
     5896                 and dtl-rests-mark.prod-code = dtl-rests.prod-code no-error .
     5897           if not available dtl-rests-mark then do:
     5898             create dtl-rests-mark.
     5899             buffer-copy dtl-rests to dtl-rests-mark.
     5900             release dtl-rests-mark.
     5901           end.
     5902         end.
     5903         if dtl-rests.OK then delete dtl-rests.
     5904       end.
     5905     end.
     5906   end.
     5907   run waitfram-hide in this-procedure .
     5908   END PROCEDURE.
     5909   PROCEDURE b-res-proc:
     5910   define parameter buffer buf_inkas for ub.inkas.
     5911   define parameter buffer buf_trn-doc for ub.trn-doc.
     5912   define parameter buffer buf_ret-doc for ub.trn-doc.
     5913   define input parameter p-auto-fbr as logical no-undo .
     5914   define input parameter auto-close as logical no-undo .
     5915   define input parameter p-rsrv-prop-goods as logical no-undo .
     5916   define input parameter p-rest-dish as logical no-undo .
     5917   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     5918   define input parameter p-is-tpsi-obj as logical no-undo .
     5919   define input parameter p-rest-tpsi as logical no-undo .
     5920   define buffer locked_trn-doc for ub.trn-doc.
     5921   define buffer locked_inkas for ub.inkas.
     5922   define buffer buf_sale-doc for ub.sale-doc.
     5923   define variable glog as logical no-undo .
     5924   do
     5925   on error undo, return error return-value
     5926   :
     5927     if buf_trn-doc.status_ = 'запрос':U then return.
     5928     assign
     5929     rdoc-line = ?
     5930     rgds-dtl = ?
     5931     r-or-v = (if r-or-v = 'rwo':U then r-or-v else ?)
     5932     r-office = ?
     5933     r-qnty = ?
     5934     r-b-code = ?
     5935     r-pl-code = ?
     5936     r-doc-prts-qnty = ?
     5937     .
     5938     from-menu = no.
     5939     assign
     5940     num_resv = 0
     5941     num_resv_res = 0
     5942     num_rec = 0
     5943     num_rec_res = 0
     5944     .
     5945     if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     5946       undo, return error substitute("&1 Отчет о продаже пуст. Резервирование невозможно.", vss-description).
     5947     end.
     5948     FIND FIRST locked_trn-doc WHERE
     5949             locked_trn-doc.doc-code = buf_inkas.inkas-code NO-LOCK .
     5950     glog = no.
     5951     RUN Inv-chk in this-procedure  (input buf_Inkas.inkas-code
     5952                                   , input v-curr-r-b
     5953                                   , buffer buf_inkas
     5954                                   , buffer buf_trn-doc
     5955                                   , input r-or-v
     5956                                   , input r-office
     5957                                   , input rdoc-line) no-error .
     5958     IF error-status:error  then do:
     5959         undo, return error substitute("&1 Были ошибки при проверке документов на возможность резервирования:&2&3&2&4"
     5960                                 , vss-description
     5961                                 , chr(10)
     5962                                 , error-status:get-message(1)
     5963                                 , return-value).
     5964     end.
     5965     BadTrans = FALSE .
     5966     FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     5967     FIND FIRST locked_trn-doc WHERE
     5968               locked_trn-doc.doc-code = buf_inkas.inkas-code .
     5969     assign
     5970     locked_inkas.is-auto-rsrv = (p-auto >= 2)
     5971     .
     5972     RUN RESERV in this-procedure (
     5973                buffer locked_inkas
     5974               ,buffer locked_trn-doc
     5975               ,input p-auto-fbr
     5976               ,input p-rsrv-prop-goods
     5977               ,input p-rest-dish
     5978               ,input p-fbr-income-doc-code
     5979               ,input p-is-tpsi-obj
     5980               ,input p-rest-tpsi) no-error.
     5981     IF error-status:error  then do:
     5982         undo, return error substitute("&1 Были ошибки при резервировании:&2&3 &4"
     5983                                 , vss-description
     5984                                 , chr(10)
     5985                                 , error-status:get-message(1)
     5986                                 , return-value).
     5987     end.
     5988     IF num_resv = 0  then do:
     5989       if NOT auto-close
     5990       and not p-auto-fbr
     5991       then do:
     5992           undo, return substitute("&1 Не найдено товара для резервирования." , vss-description).
     5993       end.
     5994     end.
     5995     if p-auto-fbr then do:
     5996       assign
     5997       error-status:error = no
     5998       .
     5999     end.
     6000   end.
     6001   END PROCEDURE.
     6002   PROCEDURE b-unres-proc:
     6003   define parameter buffer buf_inkas for ub.inkas.
     6004   define parameter buffer buf_trn-doc for ub.trn-doc.
     6005   define parameter buffer buf_ret-doc for ub.trn-doc.
     6006   define input parameter p-is-tpsi-obj  as logical no-undo .
     6007   define input parameter p-from-compense as logical no-undo .
     6008   define variable glog as logical no-undo .
     6009   define buffer locked_inkas for ub.inkas.
     6010   define buffer locked_trn-doc for ub.trn-doc.
     6011   if buf_trn-doc.status_ = 'запрос':U then return.
     6012   if not p-from-compense then
     6013   assign
     6014   rdoc-line = ?
     6015   rgds-dtl = ?
     6016   r-or-v = ?
     6017   r-office = ?
     6018   r-qnty = ?
     6019   .
     6020   assign
     6021   num_resv = 0
     6022   num_resv_res = 0
     6023   num_rec = 0
     6024   num_rec_res = 0
     6025   .
     6026   if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     6027     undo, return error substitute("&1 Отчет о продаже пуст. Снять резервы невозможно.", vss-description).
     6028   end.
     6029   FIND FIRST locked_trn-doc WHERE
     6030            locked_trn-doc.doc-code = buf_trn-doc.doc-code NO-LOCK .
     6031   glog = no.
     6032   RUN Inv-chk  in this-procedure (  input buf_Inkas.inkas-code
     6033                 , input v-curr-r-b
     6034                 , buffer buf_inkas
     6035                 , buffer buf_trn-doc
     6036                 , input r-or-v
     6037                 , input r-office
     6038                 , input rdoc-line) no-error .
     6039   IF error-status:error  then do:
     6040       undo, return error substitute("&1 Были ошибки при проверке документов на возможность разрезервирования:&2&3&2&4"
     6041                               , vss-description
     6042                               , chr(10)
     6043                               , error-status:get-message(1)
     6044                               , return-value).
     6045   end.
     6046   BadTrans = FALSE .
     6047   FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     6048   FIND FIRST locked_trn-doc WHERE
     6049              locked_trn-doc.doc-code = buf_inkas.inkas-code .
     6050   RUN UNRESERV in this-procedure (input p-is-tpsi-obj
     6051                                 , buffer locked_inkas
     6052                                 ) no-error .
     6053   IF error-status:error  then do:
     6054       undo, return error substitute("&1 Были ошибки при снятии резервов:&2&3 &4"
     6055                               , vss-description
     6056                               , chr(10)
     6057                               , error-status:get-message(1)
     6058                               , return-value).
     6059   end.
     6060   IF num_resv = 0
     6061   and not p-from-compense
     6062   then do:
     6063       undo, return error substitute("&1 Не найдено товара для снятия резервов." , vss-description).
     6064   end.
     6065   END PROCEDURE.
     6066   PROCEDURE RESERV:
     6067   define parameter buffer buf_inkas for ub.inkas.
     6068   define parameter buffer buf_trn-doc for ub.trn-doc.
     6069   define input parameter p-auto-fbr as logical no-undo .
     6070   define input parameter p-rsrv-prop-goods as logical no-undo .
     6071   define input parameter p-rest-dish as logical no-undo .
     6072   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     6073   define input parameter p-is-tpsi-obj  as logical no-undo .
     6074   define input parameter p-rest-tpsi as logical no-undo .
     6075   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     6076   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     6077   define variable v-is-dish as character no-undo .
     6078   define variable v-is-modificator as character no-undo .
     6079   define variable v-run-tpsi-line as logical no-undo .
     6080   define variable v-run-tpsi as logical no-undo .
     6081   define buffer buf_sale-doc for ub.sale-doc.
     6082   define buffer dop_trn-doc for ub.trn-doc.
     6083   define variable v-user-action  as character no-undo .
     6084   define variable v-printed      as logical   no-undo .
     6085   define variable v-old-num_rec as integer no-undo .
     6086   define variable v-attr-value              as character no-undo .
     6087   define variable v-type                   as character no-undo .
     6088   if buf_trn-doc.status_ = 'запрос':U then return.
     6089   assign
     6090   num_rec = 0
     6091   num_rec_res = 0
     6092   num_resv = 0
     6093   num_resv_res = 0
     6094   num_rec_other = 0
     6095   num_rec_other_res = 0
     6096   r-artic =      "":U
     6097   r-prod-type = "":U
     6098   r-prod-code = 0
     6099   r-prt-code = 0
     6100   .
     6101   for each tt0-info:
     6102     delete tt0-info.
     6103   end.
     6104   _buf_sale-doc:
     6105   for each buf_sale-doc where
     6106          buf_sale-doc.inkas-code = buf_inkas.inkas-code
     6107      and buf_sale-doc.order > 0
     6108   by buf_sale-doc.order
     6109   on error undo _buf_sale-doc, next _buf_sale-doc:
     6110     if r-or-v <> ?
     6111     and  (buf_sale-doc.doc-kind <> r-or-v
     6112          or
     6113          buf_sale-doc.chr-office <> r-office
     6114          )
     6115     then NEXT _buf_sale-doc.
     6116     if not (buf_sale-doc.doc-kind = 'es':U
     6117            and
     6118            buf_sale-doc.chr-office = 'т':U) then do:
     6119       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = buf_sale-doc.doc-code.
     6120     end.
     6121     if buf_sale-doc.doc-kind = 'rwo':U
     6122     and r-or-v <> 'rwo':U then next _buf_sale-doc.
     6123   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Резервирование товаров. &1", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ))                                       ).
     6124     _doc-line:
     6125     FOR EACH ub.doc-line EXCLUSIVE-LOCK WHERE
     6126               ub.doc-line.doc-code = buf_trn-doc.doc-code,
     6127         FIRST ub.goods WHERE
     6128                   ub.goods.artic = ub.doc-line.artic AND
     6129                   ub.goods.prod-type = ub.doc-line.prod-type AND
     6130                   ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK
     6131      on error undo _doc-line, next _doc-line :
     6132       IF ub.doc-line.fact-qnty = ub.doc-line.doc-qnty then NEXT _doc-line.
     6133       if buf_sale-doc.doc-kind = 'rs':U
     6134       then do :
     6135         find first ub.doc-fbr-gds no-lock where ub.doc-fbr-gds.out-code = replace(ub.doc-line.doc-code, "=", "-")
     6136                                             and ub.doc-fbr-gds.gds-code = ub.goods.gds-code
     6137                                             no-error.
     6138         if available ub.doc-fbr-gds and ub.doc-fbr-gds.fact-qnty < 0
     6139         then do :
     6140           if ub.doc-line.doc-qnty = abs(ub.doc-fbr-gds.fact-qnty) then NEXT _doc-line.
     6141         end.
     6142       end.
     6143       IF NOT (rdoc-line = ?) then do:
     6144         if  NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
     6145         assign
     6146         r-artic = ub.doc-line.artic
     6147         r-prod-type = ub.doc-line.prod-type
     6148         r-prod-code = ub.doc-line.prod-code
     6149         .
     6150       end.
     6151   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6153     (input  ub.goods.gds-code
     6154     ,input  '1':U
     6155     ,input  buf_inkas.shift-date
     6156     ,input  buf_inkas.host-code
     6157     ,input  buf_inkas.obj-type
     6158     ,input  buf_inkas.obj-code
     6159     ,output vat-value
     6160     ) no-error .
     6161       find first dop_trn-doc no-lock where
     6162                 dop_trn-doc.doc-code  = buf_sale-doc.doc-code.
     6163   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
     6164   (
     6165    input  recid(ub.goods)
     6166   ,input  recid(dop_trn-doc)
     6167   ,input  buf_sale-doc.pay-code
     6168   ,output slt-value
     6169   )
     6170   .
     6171       assign
     6172       doc-line.VAT-pc = vat-value
     6173       doc-line.slt-pc = slt-value
     6174       .
     6175       IF CAN-FIND(FIRST ub.doc-pl No-LOCK WHERE
     6176                         ub.doc-pl.out-code = ub.doc-line.doc-code AND
     6177                         ub.doc-pl.gds-code = ub.goods.gds-code)
     6178       then do:
     6179           FIND FIRST ub.gds-prt NO-LOCK WHERE
     6180                       ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     6181           cashplace = yes.
     6182       end.
     6183       else cashplace = no.
     6184       IF NOT cashplace then do:
     6185           IF CAN-FIND(FIRST ub.doc-prts No-LOCK WHERE
     6186                             ub.doc-prts.out-code = ub.doc-line.doc-code AND
     6187                             ub.doc-prts.gds-code = ub.goods.gds-code)
     6188           then do:
     6189               FIND FIRST ub.gds-prt NO-LOCK WHERE
     6190                           ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     6191               cashparts = yes.
     6192           end.
     6193           else cashparts = no.
     6194       end.
     6195       else cashparts = no.
     6196       FIND FIRST ub.units WHERE
     6197                   ub.units.unit-name = ub.goods.unit-base NO-LOCK .
     6198       if can-find(first ub.tax-units where
     6199                         ub.tax-units.tax-code = btltaxcd AND
     6200                         LOOKUP(ub.tax-units.type, units.type) > 0) then  do:
     6201           assign
     6202           bottle = yes.
     6203       end.
     6204       else do:
     6205           bottle = no.
     6206       end.
     6207       IF CAN-FIND(FIRST ub.doc-fbr-gds No-LOCK WHERE
     6208                         ub.doc-fbr-gds.out-code = ub.doc-line.doc-code AND
     6209                         ub.doc-fbr-gds.gds-code = ub.goods.gds-code)
     6210       then do:
     6211   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
     6213     (input  ub.doc-line.obj-type
     6214     ,input  ub.doc-line.obj-code
     6215     ,input  ub.goods.gds-code
     6216     ,input  'is-dish=request,is-modificator=request'
     6217     ,output v-is-dish
     6218     )  .
     6219         if not error-status:error
     6220         then assign
     6221         cashfbr = lookup('1':U, v-is-dish) > 0
     6222         no-error .
     6223       end.
     6224       else cashfbr = no.
     6225       rsrv-title = substitute("Резервирование. &1. Строк ", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )).
     6226       if buf_sale-doc.dir = 1 then do:
     6227         assign
     6228           v-old-num_rec = num_rec.
     6229         run RSRV-line in this-procedure (
     6230                       input 1,
     6231                       input p-auto-fbr,
     6232                       input p-rsrv-prop-goods,
     6233                       input auto-fbr,
     6234                       input p-rest-dish,
     6235                       input p-fbr-income-doc-code,
     6236                       input p-is-tpsi-obj,
     6237                       input p-rest-tpsi,
     6238                       input yes,
     6239                       input ub.goods.gds-code,
     6240                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
     6241                       output v-run-tpsi-line,
     6242                       buffer ub.doc-line,
     6243                       buffer buf_trn-doc,
     6244                       buffer buf_sale-doc
     6245                       ) no-error.
     6246         if ub.doc-line.fact-qnty <> ub.doc-line.doc-qnty and v-log-handle <> ?
     6247             and v-old-num_rec <> num_rec
     6248         then do:
     6249           run write-log-and-file in v-log-handle (
     6250                               input 1
     6251                             , input log-file-name
     6252                             , input 1
     6253                             , input substitute("Ошибка при резервировании товара артикул &1: требуемое кол-во &2 зарезервировано &3"
     6254                                           ,ub.doc-line.artic
     6255                                           ,ub.doc-line.fact-qnty
     6256                                           ,ub.doc-line.doc-qnty
     6257                                           )
     6258                             ).
     6259         end.
     6260       end.
     6261       else do:
     6262         RUN gds-attr-value (
     6263                             INPUT ub.goods.gds-code,
     6264                             INPUT 'mark-type':U,
     6265                             OUTPUT v-attr-value,
     6266                             OUTPUT v-type
     6267                             ).
     6268         if v-attr-value > ""
     6269         and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     6270         then do :
     6271           next _doc-line .
     6272         end .
     6273         run RSRV-line in this-procedure (
     6274                       input -1,
     6275                       input no,
     6276                       input no ,
     6277                       input auto-fbr,
     6278                       input p-rest-dish,
     6279                       input p-fbr-income-doc-code,
     6280                       input p-is-tpsi-obj,
     6281                       input p-rest-tpsi,
     6282                       input yes,
     6283                       input ub.goods.gds-code,
     6284                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
     6285                       output v-run-tpsi-line,
     6286                       buffer ub.doc-line,
     6287                       buffer buf_trn-doc,
     6288                       buffer buf_sale-doc
     6289                       ) no-error.
     6290       end.
     6291       if error-status:error then do:
     6292         if rdoc-line <> ? then do:
     6293           run waitfram-hide in this-procedure .
     6294           return error substitute("Ошибка при резервировании товаров:&1&2 &3"
     6295                                 , chr(10)
     6296                                 , error-status:get-message(1)
     6297                                 , return-value ).
     6298         end.
     6299         else next _doc-line.
     6300       end.
     6301       assign
     6302       doc-line.price-base = cost-base
     6303       doc-line.price-rubl = cost-rubl .
     6304       if buf_sale-doc.doc-kind = 'es':U
     6305       then do:
     6306         assign
     6307         v-run-tpsi = v-run-tpsi or v-run-tpsi-line.
     6308       end.
     6309     END.
     6310     if buf_sale-doc.doc-kind = 'es':U then do:
     6311       run waitfram-hide in this-procedure .
     6312       if not p-rsrv-prop-goods
     6313       and (p-is-tpsi-obj and v-run-tpsi)  then do:
     6314       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Ждите... Идет резервирование ЧУЖИХ товаров."                                       ).
     6315         run str/tpsirsrv.p (
     6316                         input parparentproc
     6317                         ,input p-parent-handle
     6318                         ,input p-log-handle
     6319                         ,input p-auto
     6320                         ,INPUT V-CURR-R-B
     6321                         ,input buf_inkas.inkas-code
     6322                         ,input buf_trn-doc.host-code
     6323                         ,input buf_trn-doc.obj-type
     6324                         ,input buf_trn-doc.obj-code
     6325                         ,input r-artic
     6326                         ,input r-prod-type
     6327                         ,input r-prod-code
     6328                         ,input r-prt-code
     6329                         ,input yes
     6330                         ,input "Резервирование ЧУЖИХ товаров. Расход. Строк "
     6331                         ,input-output num_rec_res
     6332                         ,output num_rec_other
     6333                         ,output num_rec_other_res
     6334                         ,buffer buf_trn-doc
     6335                       ) no-error .
     6336         if error-status:error then do:
     6337           if p-rsrv-prop-goods
     6338           or rdoc-line <> ? then do:
     6339             run waitfram-hide in this-procedure .
     6340             return error substitute("Ошибка при резервировании ЧУЖИХ товаров:&1&2 &3"
     6341                                     , chr(10)
     6342                                     , error-status:get-message(1)
     6343                                     , return-value ).
     6344           end.
     6345           else do:
     6346           end.
     6347           run waitfram-hide in this-procedure .
     6348         end.
     6349       end.
     6350     end.
     6351     assign
     6352     num_resv = num_resv + num_rec
     6353     num_resv_res = num_resv_res + num_rec_res
     6354     num_rec = 0
     6355     num_rec_res = 0
     6356     .
     6357   END.
     6358   if num_resv = num_resv_res and num_resv > 0 then do:
     6359     if NOT auto-close and r-qnty = ? and not p-auto-fbr then do:
     6360   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Резервирование прошло успешно"                                       ).
     6361     end.
     6362   end.
     6363   else do:
     6364     if auto-fbr then do:
     6365     end.
     6366     if  num_resv > 0 then do:
     6367   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Из &1 позиций, подлежащих резервированию, успешно зарезервировано &2 (не зарезервировано &3)"                         , num_resv                                                                                      , num_resv_res                         , num_resv - num_resv_res)                                       ).
     6368       if search (log-file-name) <> ? and not (auto-close or p-auto-fbr or g#auto) then do:
     6369         run gbl/prnfilen.w (
     6370               input "Список не зарезервированных товаров":U
     6371             , input 8
     6372             , input search (log-file-name)
     6373             , input 7
     6374             , output v-user-action
     6375             , output v-printed
     6376         ).
     6377         os-delete value(log-file-name) .
     6378       end.
     6379           if search ("alc-rsrv.log") <> ? and not (auto-close or p-auto-fbr or g#auto)  then do:
     6380               run gbl/prnfilen.w (
     6381                     input "Замечания по резервированию алкоголя":U
     6382                   , input 8
     6383                   , input search ("alc-rsrv.log")
     6384                   , input 7
     6385                   , output v-user-action
     6386                   , output v-printed
     6387               ).
     6388               os-delete value("alc-rsrv.log") .
     6389           end.
     6390     end.
     6391     if num_resv > 0
     6392     and (auto-close or p-auto-fbr) then return error "Не все товары, подлежащие резервированию, зарезервированы".
     6393   end.
     6394   END PROCEDURE.
     6395   PROCEDURE button-close:
     6396   define parameter buffer buf_trn-doc for ub.trn-doc.
     6397   define parameter buffer buf_ret-doc for ub.trn-doc.
     6398   define input parameter p-is-tpsi-obj as logical no-undo .
     6399   define input parameter auto-fbr as logical no-undo .
     6400   define input parameter p-neg-tpsi-weight as logical no-undo .
     6401   define input parameter p-neg-tpsi-qnty as decimal no-undo .
     6402   define input parameter p-neg-tpsi-oper as logical no-undo .
     6403   define output parameter b-close-enabled as logical no-undo .
     6404   define variable v-is-dish as character no-undo .
     6405   define variable v-doc-ii as integer no-undo .
     6406   define variable v-curr-doc-code like ub.trn-doc.doc-code no-undo .
     6407   define variable v-attr-value              as character no-undo .
     6408   define variable v-type                   as character no-undo .
     6409   define buffer buf_gds-dtl for ub.gds-dtl.
     6410   define buffer buf_goods for ub.goods.
     6411   define buffer buf_doc-line for ub.doc-line.
     6412   define buffer dop_trn-doc for ub.trn-doc.
     6413   define buffer buf_sale-doc for ub.sale-doc.
     6414   define buffer buf_units for ub.units.
     6415   if buf_trn-doc.status_ = 'запрос':U then do:
     6416       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка отсутствия зарезервированного товара..."                                       ).
     6417   end.
     6418   else do:
     6419       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка количества зарезервированного товара..."                                       ).
     6420     if auto-fbr then do:
     6421       _buf_sale-doc:
     6422       for each buf_sale-doc where
     6423               buf_sale-doc.inkas-code = buf_trn-doc.doc-code
     6424           and buf_sale-doc.order > 0
     6425       by buf_sale-doc.order:
     6426         if buf_sale-doc.doc-kind = 'es':U
     6427         or buf_sale-doc.doc-kind = 'rs':U then do:
     6428           for each buf_gds-dtl no-lock where
     6429                     buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     6430               AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty,
     6431             first buf_goods no-lock where
     6432                   buf_goods.artic = buf_gds-dtl.artic
     6433               AND buf_goods.prod-type = buf_gds-dtl.prod-type
     6434               AND buf_goods.prod-code = buf_gds-dtl.prod-code:
     6435             if is-gas(buf_goods.gds-code) then next.
     6436             RUN gds-attr-value (
     6437                                 INPUT buf_goods.gds-code,
     6438                                 INPUT 'mark-type':U,
     6439                                 OUTPUT v-attr-value,
     6440                                 OUTPUT v-type
     6441                                 ).
     6442             if v-attr-value > ""
     6443             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     6444             then do :
     6445               next .
     6446             end .
     6447   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
     6449     (input  buf_gds-dtl.obj-type
     6450     ,input  buf_gds-dtl.obj-code
     6451     ,input  buf_goods.gds-code
     6452     ,input  'is-dish=request,is-modificator=request'
     6453     ,output v-is-dish
     6454     ) no-error .
     6455             if error-status:error or lookup('1':U, v-is-dish) = 0 then do:
     6456               assign
     6457               b-close-enabled = no
     6458               .
     6459               run waitfram-hide in this-procedure .
     6460               return.
     6461             end.
     6462           end.
     6463         end.
     6464         else do:
     6465           if buf_sale-doc.doc-kind = 'rwo':U then do:
     6466             NEXT _buf_sale-doc.
     6467           end.
     6468           if buf_sale-doc.doc-kind = 'trf':U then do:
     6469             find first buf_gds-dtl NO-LOCK where
     6470                             buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     6471                         AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi no-error .
     6472             if available buf_gds-dtl
     6473             then do:
     6474               find first buf_goods no-lock where
     6475                     buf_goods.artic = buf_gds-dtl.artic
     6476                 AND buf_goods.prod-type = buf_gds-dtl.prod-type
     6477                 AND buf_goods.prod-code = buf_gds-dtl.prod-code .
     6478               RUN gds-attr-value (
     6479                                   INPUT buf_goods.gds-code,
     6480                                   INPUT 'mark-type':U,
     6481                                   OUTPUT v-attr-value,
     6482                                   OUTPUT v-type
     6483                                   ).
     6484               if v-attr-value > ""
     6485               and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     6486               then do :
     6487               end .
     6488               else
     6489               if not is-gas(buf_goods.gds-code)
     6490               then do :
     6491                 assign
     6492                 b-close-enabled = no
     6493                 .
     6494                 run waitfram-hide in this-procedure .
     6495                 return.
     6496               end.
     6497             end.
     6498           end.
     6499         end.
     6500       end.
     6501     end.
     6502     else do:
     6503       _buf_sale-doc2:
     6504       for each buf_sale-doc where
     6505              buf_sale-doc.inkas-code = buf_trn-doc.doc-code
     6506          and buf_sale-doc.order > 0
     6507       by buf_sale-doc.order:
     6508         if buf_sale-doc.doc-kind = 'rwo':U then do:
     6509           next _buf_sale-doc2.
     6510         end.
     6511         if buf_sale-doc.doc-code = buf_trn-doc.doc-code
     6512         and p-is-tpsi-obj
     6513         then do:
     6514           _tt:
     6515           for each buf_Doc-line no-lock where
     6516                   buf_doc-line.doc-code = buf_trn-doc.doc-code:
     6517             find first tt0-doc-line no-lock where
     6518                   tt0-doc-line.artic     = buf_doc-line.artic
     6519               AND tt0-doc-line.prod-type = buf_doc-line.prod-type
     6520               AND tt0-doc-line.prod-code = buf_doc-line.prod-code no-error .
     6521             if p-neg-tpsi-oper
     6522             and available tt0-doc-line
     6523             and not (tt0-doc-line.obj-type = buf_doc-line.obj-type
     6524                 and tt0-doc-line.obj-code = buf_doc-line.obj-code)
     6525             and can-find(first dtl-rests-mark where
     6526                               dtl-rests-mark.artic = buf_doc-line.artic
     6527                           and dtl-rests-mark.prod-type = buf_doc-line.prod-type
     6528                           and dtl-rests-mark.prod-code = buf_doc-line.prod-code) then do:
     6529               next  _tt.
     6530             END.
     6531             if  buf_doc-line.fact-qnty <= buf_doc-line.doc-qnty + (if available tt0-doc-line
     6532                                                                   then (tt0-doc-line.doc-qnty +  p-neg-tpsi-qnty)
     6533                                                                   else 0)
     6534                                                                   then do:
     6535               next  _tt.
     6536             end.
     6537             if p-neg-tpsi-weight then do:
     6538               find first buf_goods no-lock where
     6539                       buf_goods.artic = buf_doc-line.artic
     6540                   AND buf_goods.prod-type = buf_doc-line.prod-type
     6541                   AND buf_goods.prod-code = buf_doc-line.prod-code .
     6542               find first buf_units no-lock where
     6543                           buf_units.unit-name = buf_goods.unit-base.
     6544               if lookup('вес':U, buf_units.type) > 0 then do:
     6545                 next _tt.
     6546               end.
     6547             end.
     6548             b-close-enabled = no.
     6549             run waitfram-hide in this-procedure .
     6550             return.
     6551           end.
     6552         end.
     6553         else do:
     6554           _gds-dtl:
     6555           for each buf_gds-dtl NO-LOCK where
     6556                       buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     6557                   AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi :
     6558             find first goods no-lock where goods.artic = buf_gds-dtl.artic
     6559                                        and goods.prod-type = buf_gds-dtl.prod-type
     6560                                        and goods.prod-code = buf_gds-dtl.prod-code
     6561                                        .
     6562             RUN gds-attr-value (
     6563                                 INPUT goods.gds-code,
     6564                                 INPUT 'mark-type':U,
     6565                                 OUTPUT v-attr-value,
     6566                                 OUTPUT v-type
     6567                                 ).
     6568             if v-attr-value > ""
     6569             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     6570             then do :
     6571               next _gds-dtl .
     6572             end .
     6573             if buf_sale-doc.doc-kind = 'rs':U
     6574             then do :
     6575               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = replace(buf_gds-dtl.doc-code, "=", "-")
     6576                                                and doc-fbr-gds.gds-code = goods.gds-code
     6577                                                no-error .
     6578             end.
     6579             if buf_sale-doc.doc-kind = 'es':U
     6580             then do :
     6581               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = buf_gds-dtl.doc-code
     6582                                                and doc-fbr-gds.gds-code = goods.gds-code
     6583                                                no-error .
     6584             end.
     6585             if available doc-fbr-gds
     6586             then do :
     6587               next.
     6588             end.
     6589             assign
     6590             b-close-enabled = no
     6591             .
     6592             run waitfram-hide in this-procedure .
     6593             return.
     6594           end.
     6595         end.
     6596       END.
     6597     end.
     6598   end.
     6599   assign
     6600   b-close-enabled = yes.
     6601   run waitfram-hide in this-procedure .
     6602   END.
