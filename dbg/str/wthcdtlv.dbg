      748           then do:
      749             assign
      750               v-object-handle :row = v-object-handle :row + p-change-value
      751               no-error .
      752             if error-status :error
      753             or error-status :get-message(1) <> ""
      754             then do:
      755               undo move_block, retry move_block .
