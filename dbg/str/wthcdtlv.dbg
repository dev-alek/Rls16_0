      138   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139     define variable v-cntxt-db-num        as integer   no-undo .
      140     define variable v-cntxt-userid        as character no-undo .
      141     define variable v-cntxt-level         as character no-undo .
      142     define variable v-cntxt-host-code-obj as integer   no-undo .
      143     define variable v-cntxt-obj-type      as character no-undo .
      144     define variable v-cntxt-obj-code      as integer   no-undo .
      145     define variable v-cntxt-db-num-obj    as integer   no-undo .
      146     define variable v-cntxt-is-admin      as logical   no-undo .
      147   DEFine VARiable d_bef-sum LIKE ub.c-wth-doc.doc-sum NO-UNDO.
      148   DEFine VARiable d_aft-sum LIKE ub.c-wth-doc.doc-sum NO-UNDO.
      149   DEFine VARiable d_fact-sum LIKE ub.c-wth-doc.doc-sum NO-UNDO.
      150   define buffer buf_wth-par for ub.wth-par.
      151   define buffer buf_c-wth-doc for ub.c-wth-doc.
      152   DEFINE VARIABLE vardoc-status_ like ub.c-wth-doc.status_ no-undo .
      153   DEFINE BUTTON B-Help
      154        LABEL "Помо&щь"
      155        SIZE 3 BY 1
      156        BGCOLOR 8 .
      157   DEFINE BUTTON B-par
      158        LABEL "&Инфо"
      159        SIZE 10 BY 1.
      160   DEFINE BUTTON b-quit AUTO-END-KEY
      161        LABEL "Выход"
      162        SIZE 10 BY 1
      163        BGCOLOR 8 .
      164   DEFINE VARIABLE for-d_aft-sum AS CHARACTER FORMAT "X(15)":U
      165        LABEL "ИТОГО факт"
      166         VIEW-AS TEXT
      167        SIZE 19.9 BY .67
      168        FGCOLOR 4  NO-UNDO.
      169   DEFINE VARIABLE for-d_bef-sum AS CHARACTER FORMAT "X(15)":U
      170        LABEL "ИТОГО план"
      171         VIEW-AS TEXT
      172        SIZE 19.9 BY .67
      173        FGCOLOR 4  NO-UNDO.
      174   DEFINE VARIABLE for-d_fact-sum AS CHARACTER FORMAT "X(15)":U
      175        LABEL "ИТОГО расхождение"
      176         VIEW-AS TEXT
      177        SIZE 19.9 BY .67
      178        FGCOLOR 4  NO-UNDO.
      179   DEFINE QUERY BR-dtl FOR
      180         tt-par-dtl SCROLLING.
      181   DEFINE QUERY Dialog-Frame FOR
      182         buf_c-wth-line SCROLLING.
      183   DEFINE BROWSE BR-dtl
      184     QUERY BR-dtl DISPLAY
      185         tt-par-dtl.par-feat
      186         tt-par-dtl.par-val
      187         tt-par-dtl.par-unit
      188         tt-par-dtl.q-ty-bef
      189         tt-par-dtl.sum-bef
      190         tt-par-dtl.q-ty-aft
      191         tt-par-dtl.sum-aft
      192         (if vardoc-status_ = 'разрешен':U then tt-par-dtl.q-ty-bef - tt-par-dtl.q-ty-aft else 0)
      193         tt-par-dtl.sum-fact
      194   ENABLE
      195         tt-par-dtl.q-ty-bef
      196   tt-par-dtl.q-ty-aft
      197       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.4 BY 11.83.
      198   DEFINE FRAME Dialog-Frame
      199        b-quit AT ROW 1 COL 11.1
      200        B-par AT ROW 1 COL 21
      201        B-Help AT ROW 1 COL 95
      202        BR-dtl AT ROW 6.33 COL 1.4
      203        ub.wealth.wth-name AT ROW 3.27 COL 24.3 COLON-ALIGNED
      204              VIEW-AS TEXT
      205             SIZE 20.9 BY .67
      206             FGCOLOR 4
      207        ub.c-wth-line.bef-sum AT ROW 4.37 COL 24.1 COLON-ALIGNED
      208              VIEW-AS TEXT
      209             SIZE 21 BY .67
      210             FGCOLOR 4
      211        ub.c-wth-line.aft-sum AT ROW 4.47 COL 67.8 COLON-ALIGNED
      212              VIEW-AS TEXT
      213             SIZE 21 BY .67
      214             FGCOLOR 4
      215        ub.c-wth-line.fact-sum AT ROW 5.37 COL 36.8 COLON-ALIGNED
      216              VIEW-AS TEXT
      217             SIZE 21 BY .67
      218             FGCOLOR 4
      219        for-d_aft-sum AT ROW 18.57 COL 69.6 COLON-ALIGNED
      220        for-d_bef-sum AT ROW 18.63 COL 24.1 COLON-ALIGNED
      221        for-d_fact-sum AT ROW 19.7 COL 36.8 COLON-ALIGNED
      222        SPACE(44.17) SKIP(0.41)
      223       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      224            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      225            TITLE "<insert dialog title>"
      226            CANCEL-BUTTON b-quit.
      227   ASSIGN
      228          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      229          FRAME Dialog-Frame:HIDDEN           = TRUE.
      230   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   ON CHOOSE OF B-par IN FRAME Dialog-Frame
      235   DO:
      236   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if lookup(self :type
      238            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      239            ) = 0
      240   then do:
      241     message
      242       "$Workfile$"
      243       "Указанному интерфейсному элементу фокус не может быть передан" skip
      244       "Интерфейсный элемент" self :name  skip
      245       "Тип" self :type  skip
      246       "Процедура" this-procedure :file-name skip
      247       view-as alert-box .
      248   end.
      249   else do:
      250     apply "entry":u to self  .
      251     if focus :handle <> self :handle  then do:
      252       return no-apply .
      253     end.
      254   end.
      255    define variable glog as logical no-undo .
      256    define variable v-rep-rec as recid no-undo .
      257     DEF BUFFER buf-par FOR ub.wth-par.
      258     if not avail tt-par-dtl then return no-apply.
      259   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   do:
      261     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      262       (input  v-cntxt-db-num
      263       ,input  v-cntxt-userid
      264       ,input  0
      265       ,input  'actn_wealth_work':U
      266       ,input  'global':U
      267       ,input  0
      268       ,input  '':U
      269       ,input  0
      270       ,input  0
      271       ,input  0
      272       ,input  0
      273       ,input  true
      274       ,output glog
      275       )  .
      276   end.
      277     IF NOT glog THEN DO:
      278       RETURN NO-APPLY.
      279     END.
      280     FIND FIRST buf_wth-par NO-LOCK WHERE
      281                buf_wth-par.wth-code = buf_wealth.wth-code  AND
      282                buf_wth-par.par-code = tt-par-dtl.par-code NO-ERROR.
      283     IF NOT AVAIL buf_wth-par THEN DO:
      284       MESSAGE "Номинал не найден! " VIEW-AS ALERT-BOX ERROR.
      285       RETURN NO-APPLY.
      286     END.
      287       run ref/wthpform.w (
      288                        input parparentproc
      289                       ,input buf_c-wth-doc.host-code
      290                       ,input buf_c-wth-doc.obj-type
      291                       ,input buf_c-wth-doc.obj-code
      292                       ,INPUT buf_wth-par.wth-code
      293                       ,INPUT buf_wth-par.par-code
      294                       ,INPUT 'ПРОСМОТР':U
      295                      ,OUTPUT v-rep-rec
      296                    ).
      297   END.
      298   ON ROW-LEAVE OF BR-dtl IN FRAME Dialog-Frame
      299   DO:
      300     CASE vardoc-status_:
      301       when 'накл':U then do:
      302         ASSIGN
      303         tt-par-dtl.q-ty-bef = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-bef.
      304         ASSIGN
      305         d_bef-sum = d_bef-sum - tt-par-dtl.sum-bef.
      306         ASSIGN
      307         tt-par-dtl.sum-bef = tt-par-dtl.q-ty-bef * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      308         ASSIGN
      309         d_bef-sum = d_bef-sum + tt-par-dtl.sum-bef.
      310         DISPLAY
      311         tt-par-dtl.q-ty-bef
      312         tt-par-dtl.sum-bef
      313         WITH BROWSE BR-dtl.
      314         DISPLAY
      315         d_bef-sum @ for-d_bef-sum
      316         WITH FRAME Dialog-Frame.
      317       end.
      318       when 'разрешен':U then do:
      319         ASSIGN
      320         tt-par-dtl.q-ty-aft = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-aft.
      321         ASSIGN
      322         d_aft-sum = d_aft-sum - tt-par-dtl.sum-aft.
      323         ASSIGN
      324         tt-par-dtl.sum-aft = tt-par-dtl.q-ty-aft * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      325         ASSIGN
      326         d_aft-sum = d_aft-sum + tt-par-dtl.sum-aft.
      327         DISPLAY
      328         tt-par-dtl.q-ty-aft
      329         tt-par-dtl.sum-aft
      330         WITH BROWSE BR-dtl.
      331         DISPLAY
      332         d_aft-sum @ for-d_aft-sum
      333         WITH FRAME Dialog-Frame.
      334       end.
      335     END CASE.
      336   END.
      337   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      338   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      339   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   on help of frame Dialog-Frame
      341   do:
      342     run gbl/app_help.p
      343       (input this-procedure :file-name
      344       ,input ''
      345       ,input ?
      346       ) no-error.
      347     if error-status :error then do:
      348       message
      349         "Ошибка при вызове помощи"
      350         error-status :get-message(1)
      351         view-as alert-box .
      352     end.
      353   end.
      354   run minbtn-set in this-procedure .
      355   on choose of b-help in frame Dialog-Frame
      356   do:
      357     apply "help":u to frame Dialog-Frame .
      358   end.
      359   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure minbtn-set :
      361       do
      362           on error undo, return error return-value
      363           :
      364           define variable ii              as integer       no-undo .
      365           define variable fh              as widget-handle no-undo .
      366           define variable hh              as widget-handle no-undo .
      367           define variable v-h             as handle        extent 4 no-undo .
      368           define variable v-name-button   as character     no-undo .
      369           define variable v-help-old-x    as decimal       no-undo .
      370           define variable v-help-old-y    as decimal       no-undo .
      371           define variable v-help-old-size as decimal       no-undo .
      372           define variable v-frame-width   as decimal       no-undo .
      373           define variable jj              as integer       no-undo .
      374           do
      375               on error undo, return error
      376               :
      377               assign
      378                   v-frame-width = frame Dialog-Frame:width - 0.3
      379                   fh            = frame Dialog-Frame:first-child
      380                   hh            = fh:first-child
      381                   ii            = 1
      382                   .
      383               do while valid-handle(hh):
      384                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      385                   do:
      386                       case lc(hh:name) :
      387                           when "b-help" then
      388                               do:
      389                                   hh:load-image-up("cmp/b-help.bmp":u) .
      390                                   hh:load-image-down("cmp/b-help.bmp":u) .
      391                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      392                                   hh:TOOLTIP = "Помощь" .
      393                                   v-help-old-x = hh:column .
      394                                   v-help-old-y = hh:row    .
      395                                   v-help-old-size = hh:width .
      396                                   hh:width-chars = 2.5 .
      397                               end.
      398                           when "b-print" then
      399                               do:
      400                                   hh:load-image("cmp/b-print.bmp":u) .
      401                                   hh:TOOLTIP = "Печать" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-history" or
      407                           when "b-hist" then
      408                               do:
      409                                   hh:load-image("cmp/b-hist.bmp":u) .
      410                                   hh:TOOLTIP = "История" .
      411                                   v-h[ii] = hh:handle .
      412                                   ii = ii + 1 .
      413                                   hh:width-chars = 3 .
      414                               end.
      415                           when "b-sch" then
      416                               do:
      417                                   hh:load-image("cmp/b-sch.bmp":u) .
      418                                   hh:TOOLTIP = "Установка Фильтра" .
      419                                   v-h[ii] = hh:handle .
      420                                   ii = ii + 1 .
      421                                   hh:width-chars = 3 .
      422                               end.
      423                           when "b-hist-user" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История пользователя" .
      427                                   ii = ii + 1 .
      428                               end.
      429                       end case.
      430                   end.
      431                   hh = hh:next-sibling.
      432               end.
      433               b-help:column = v-frame-width - b-help:width-chars.
      434               jj = 0.
      435               repeat ii = 4 to 1 by -1 :
      436                   if valid-handle (v-h[ii] ) then
      437                   do:
      438                       jj  = jj + 1 .
      439                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      440                       v-h[ii]:row    = v-help-old-y .
      441                   end.
      442               end.
      443           end.
      444       end.
      445   end procedure.
      446   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
