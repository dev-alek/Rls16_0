      645           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      646         .
      647       end.
      648       for each buf_temp-diasize-handle
      649       :
      650         delete buf_temp-diasize-handle .
      651       end.
      652       assign
      653         v-field-group-handle = frame Dialog-Frame :first-child
      654       .
      655       do while valid-handle(v-field-group-handle)
      656       :
      657         assign
      658           v-object-handle = v-field-group-handle :first-child
      659         .
      660         do while valid-handle(v-object-handle)
      661         :
      662           if  v-object-handle <> v-diasize-browse-handle :handle
      663           and can-query(v-object-handle, "row")
      664           and can-query(v-object-handle, "height")
      665           and ( v-object-handle :row > v-diasize-browse-handle :row )
      666           then do:
      667             find first buf_temp-browse-handle
      668               where buf_temp-browse-handle.browse-type   = 'height':u
      669                 and buf_temp-browse-handle.browse-handle = v-object-handle
      670               no-error .
      671             if available buf_temp-browse-handle
      672             then do:
      673             end.
      674             else do:
      675               create buf_temp-diasize-handle .
      676               assign
      677                 buf_temp-diasize-handle.handle-value  = v-object-handle
      678                 buf_temp-diasize-handle.save-position = v-object-handle :row
      679               .
      680             end.
      681           end.
      682           assign
      683             v-object-handle = v-object-handle :next-sibling
      684           .
      685         end.
      686         assign
      687           v-field-group-handle = v-field-group-handle :next-sibling
      688         .
      689       end.
      690       do with frame Dialog-Frame
      691       :
      692         hide v-diasize-resize-button .
      693         assign
      694           v-diasize-resize-button :row    = 1
      695           v-diasize-resize-button :column = 1
      696         .
      697       end.
      698       if p-change-value > 0
      699       then do:
      700         if frame Dialog-Frame :scrollable = true
      701         then do:
      702           assign
      703             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      704             no-error .
      705           if error-status :error
      706           or error-status :get-message(1) <> ""
      707           then do:
      708             undo move_block, retry move_block .
      709           end.
      710         end.
      711         assign
      712           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      713           no-error .
      714         if error-status :error
      715         or error-status :get-message(1) <> ""
