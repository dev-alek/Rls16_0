     1120               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1121             no-error .
     1122           if error-status :error
     1123           or error-status :get-message(1) <> ""
     1124           then do:
     1125             undo move_block, retry move_block .
     1126           end.
     1127         end.
     1128         for each buf_temp-diasize-handle
     1129         on error undo move_block, retry move_block
     1130         :
     1131           assign
     1132             v-object-handle = buf_temp-diasize-handle.handle-value
     1133           .
     1134           if v-object-handle <> v-diasize-resize-button
     1135           then do:
     1136             assign
     1137               v-object-handle :col = v-object-handle :col + p-change-value
     1138               no-error .
     1139             if error-status :error
     1140             or error-status :get-message(1) <> ""
     1141             then do:
     1142               undo move_block, retry move_block .
     1143             end.
     1144           end.
     1145         end.
     1146       end.
     1147       else do:
     1148         for each buf_temp-diasize-handle
     1149         on error undo move_block, retry move_block
     1150         :
     1151           assign
     1152             v-object-handle = buf_temp-diasize-handle.handle-value
     1153           .
     1154           if v-object-handle <> v-diasize-resize-button
     1155           then do:
     1156             assign
     1157               v-object-handle :col = v-object-handle :col + p-change-value
     1158               no-error .
     1159             if error-status :error
     1160             or error-status :get-message(1) <> ""
     1161             then do:
     1162               undo move_block, retry move_block .
     1163             end.
     1164           end.
     1165         end.
     1166         for each buf_temp-browse-handle
     1167           where buf_temp-browse-handle.browse-type = 'width':u
     1168         on error undo move_block, retry move_block
     1169         :
     1170           assign
     1171             buf_temp-browse-handle.browse-handle :width
     1172               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1173             no-error .
     1174           if error-status :error
     1175           or error-status :get-message(1) <> ""
     1176           then do:
     1177             undo move_block, retry move_block .
     1178           end.
     1179         end.
     1180         assign
     1181           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1182           no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block.
     1187         end.
     1188         assign
     1189           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1190         no-error .
     1191         if error-status :error
     1192         or error-status :get-message(1) <> ""
     1193         then do:
     1194           undo move_block, retry move_block.
     1195         end.
     1196         if frame Dialog-Frame :scrollable = true
     1197         then do:
     1198           assign
     1199             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1200           no-error .
     1201           if error-status :error
     1202           or error-status :get-message(1) <> ""
     1203           then do:
     1204             undo move_block, retry move_block.
     1205           end.
     1206         end.
     1207       end.
     1208       if p-move-resize
     1209       then do:
     1210         run diasize_position-resize-button in this-procedure .
     1211       end.
     1212       if v-diasize-wndstore = true
     1213       then do:
     1214         if connected("ub") = true
     1215         then do:
     1216           define variable v-cntxt-db-num        as integer   no-undo .
     1217           define variable v-cntxt-userid        as character no-undo .
     1218           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1219                                             , OUTPUT v-cntxt-userid
     1220                                             ) .
     1221           run gbl/wndsizew.p
     1222             (input  v-cntxt-db-num
     1223             ,input  v-cntxt-userid
     1224             ,input  v-diasize-proc-name
     1225             ,input  'width':u
     1226             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1227             ) .
     1228         end.
     1229       end.
     1230     end.
     1231     assign
     1232       v-diasize-change-size = false
     1233     .
     1234   end procedure.
     1235   procedure diasize_set-width :
     1236     define input  parameter p-new-width  as decimal   no-undo .
     1237     define input  parameter p-move-resize as logical   no-undo .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       run diasize_change-width in this-procedure
     1242         (input  (p-new-width - frame Dialog-Frame :width)
     1243         ,input  p-move-resize
     1244         ) .
     1245     end.
     1246   end procedure.
     1247   procedure diasize_position-resize-button :
     1248     do with frame Dialog-Frame
     1249     :
     1250       hide v-diasize-resize-button .
     1251       assign
     1252         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1253                     - 1
     1254                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1255         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1256                     - 1
     1257                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1258       .
     1259       view v-diasize-resize-button .
     1260     end.
     1261   end procedure.
     1262   on alt-right anywhere
     1263   do:
     1264     run diasize_change-width in this-procedure
     1265       (input 1
     1266       ,input true
     1267       ) .
     1268     return no-apply .
     1269   end.
     1270   on alt-left anywhere
     1271   do:
     1272     run diasize_change-width in this-procedure
     1273       (input -1
     1274       ,input true
     1275       ) .
     1276     return no-apply .
     1277   end.
     1278   on alt-down anywhere
     1279   do:
     1280     run diasize_change-height in this-procedure
     1281       (input 1
     1282       ,input true
     1283       ) .
     1284     return no-apply .
     1285   end.
     1286   on alt-up anywhere
     1287   do:
     1288     run diasize_change-height in this-procedure
     1289       (input -1
     1290       ,input true
     1291       ) .
     1292     return no-apply .
     1293   end.
     1294   on alt-enter of frame Dialog-Frame
     1295   do:
     1296     run diasize_maximize in this-procedure
     1297       (input  ?
     1298       ).
     1299     return no-apply .
     1300   end.
     1301   procedure diasize_end-move :
     1302     do
     1303     on error undo, return error return-value
     1304     :
     1305       define variable v-row-delta as decimal   no-undo .
     1306       define variable v-col-delta as decimal   no-undo .
     1307       define variable v-new-row as decimal   no-undo .
     1308       define variable v-new-col as decimal   no-undo .
     1309       assign
     1310         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1311         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1312       .
     1313       assign
     1314         v-row-delta = v-new-row - frame Dialog-Frame :height
     1315         v-col-delta = v-new-col - frame Dialog-Frame :width
     1316       .
     1317       run diasize_change-height in this-procedure
     1318         (input v-row-delta
     1319         ,input true
     1320         ) .
     1321       run diasize_change-width in this-procedure
     1322         (input v-col-delta
     1323         ,input true
     1324         ) .
     1325     end.
     1326   end procedure.
     1327   procedure diasize_maximize :
     1328     define input  parameter p-action as logical   no-undo .
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       if p-action = ?
     1333       then do:
     1334         if v-diasize-need-maximize = true
     1335         then do:
     1336           assign
     1337             p-action = true
     1338           .
     1339         end.
     1340         else do:
     1341           assign
     1342             p-action = false
     1343           .
     1344         end.
     1345       end.
     1346       if p-action = true
     1347       then do:
     1348         run diasize_change-height in this-procedure
     1349           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1350               - frame Dialog-Frame :height-chars
     1351           ,input true
     1352           ) .
     1353         run diasize_change-width in this-procedure
     1354           (input session :width-chars
     1355               - frame Dialog-Frame :width-chars
     1356           ,input true
     1357           ) .
     1358         assign
     1359           v-diasize-need-maximize = false
     1360         .
     1361       end.
     1362       else do:
     1363         run diasize_change-width in this-procedure
     1364           (input v-diasize-orig-frame-width
     1365               - frame Dialog-Frame :width-chars
     1366           ,input true
     1367           ) .
     1368         run diasize_change-height in this-procedure
     1369           (input v-diasize-orig-frame-height
     1370               - frame Dialog-Frame :height-chars
     1371           ,input true
     1372           ) .
     1373         assign
     1374           v-diasize-need-maximize = true
     1375         .
     1376       end.
     1377     end.
     1378   end procedure.
     1379   procedure diasize_restore-orig-size :
     1380     do
     1381     on error undo, return error return-value
     1382     :
     1383       assign
     1384         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1385         v-diasize-current-frame-height = frame Dialog-Frame :height
     1386       .
     1387       run diasize_set-height in this-procedure
     1388         (input  v-diasize-orig-frame-height
     1389         ,input  true
     1390         ) .
     1391       run diasize_set-width in this-procedure
     1392         (input  v-diasize-orig-frame-width
     1393         ,input  true
     1394         ) .
     1395     end.
     1396   end procedure.
     1397   procedure diasize_restore-current-size :
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401       run diasize_set-height in this-procedure
     1402         (input  v-diasize-current-frame-height
     1403         ,input  true
     1404         ) .
     1405       run diasize_set-width in this-procedure
     1406         (input  v-diasize-current-frame-width
     1407         ,input  true
     1408         ) .
     1409     end.
     1410   end procedure.
     1411   procedure diasize_set-browse-handle :
     1412     define input  parameter p-browse-handle as handle   no-undo .
     1413     define buffer buf_temp-browse-handle for temp-browse-handle .
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417       assign
     1418         v-diasize-browse-handle = p-browse-handle
     1419       .
     1420       for each buf_temp-browse-handle
     1421       on error undo, return error return-value
     1422       :
     1423         delete buf_temp-browse-handle .
     1424       end.
     1425     end.
     1426   end procedure.
     1427   procedure diasize_add_browse :
     1428     define input  parameter p-browse-type   as character no-undo .
     1429     define input  parameter p-browse-handle as handle    no-undo .
     1430     define buffer buf_temp-browse-handle for temp-browse-handle .
     1431     do
     1432     on error undo, return error return-value
     1433     :
     1434       assign
     1435         v-diasize-browse-number = v-diasize-browse-number + 1
     1436       .
     1437       create buf_temp-browse-handle .
     1438       assign
     1439         buf_temp-browse-handle.browse-type   = p-browse-type
     1440         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1441         buf_temp-browse-handle.browse-handle = p-browse-handle
     1442       .
     1443     end.
     1444   end procedure.
     1445   procedure diasize_init :
     1446     define variable v-default-value    as logical   no-undo .
     1447     define variable v-restore-saved    as logical   no-undo .
     1448     define variable v-resize-value-str as character no-undo .
     1449     do
     1450     on error undo, return error return-value
     1451     :
     1452       do with frame Dialog-Frame
     1453       :
     1454         assign
     1455           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1456           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1457           v-diasize-browse-handle     = browse BR-dtl :handle
     1458         .
     1459         create button v-diasize-resize-button
     1460         assign
     1461           parent        = frame Dialog-Frame :first-child
     1462           label         = "s"
     1463           height-pixels = 16
     1464           width-pixels  = 16
     1465           visible       = true
     1466           sensitive     = true
     1467           movable       = true
     1468           triggers:
     1469             on end-move persistent run diasize_end-move in this-procedure .
     1470           end triggers.
     1471         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1472         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1473         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1474         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1475         assign
     1476           v-diasize-wndmax = false
     1477         .
     1478         if connected("ub") = true
     1479         then do:
     1480           define variable v-cntxt-db-num        as integer   no-undo .
     1481           define variable v-cntxt-userid        as character no-undo .
     1482           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1483                                             , OUTPUT v-cntxt-userid
     1484                                             ) .
     1485           run gbl/wndpar_r.p
     1486             (input  v-cntxt-db-num
     1487             ,input  v-cntxt-userid
     1488             ,input  'wndmax':U
     1489             ,output v-diasize-wndmax
     1490             ,output v-default-value
     1491             ) .
     1492         end.
     1493         assign
     1494           v-diasize-wndstore = false
     1495         .
     1496         if connected("ub") = true
     1497         then do:
     1498           run gbl/wndpar_r.p
     1499             (input  v-cntxt-db-num
     1500             ,input  v-cntxt-userid
     1501             ,input  'wndstore':U
     1502             ,output v-diasize-wndstore
     1503             ,output v-default-value
     1504             ) .
     1505         end.
     1506         assign
     1507           v-diasize-proc-name = entry(1, program-name(2), '.')
     1508         .
     1509         if v-diasize-wndstore = true
     1510         then do:
     1511           assign
     1512             v-restore-saved = false
     1513           .
     1514           if connected("ub") = true
     1515           then do:
     1516             run gbl/wndsizer.p
     1517               (input  v-cntxt-db-num
     1518               ,input  v-cntxt-userid
     1519               ,input  v-diasize-proc-name
     1520               ,input  'height':u
     1521               ,output v-resize-value-str
     1522               ) .
     1523             if v-resize-value-str <> '':U
     1524             then do:
     1525               run diasize_change-height in this-procedure
     1526                 (input  integer(v-resize-value-str)
     1527                 ,input  true
     1528                 ) .
     1529               assign
     1530                 v-restore-saved = true
     1531               .
     1532             end.
     1533           end.
     1534           if connected("ub") = true
     1535           then do:
     1536             run gbl/wndsizer.p
     1537               (input  v-cntxt-db-num
     1538               ,input  v-cntxt-userid
     1539               ,input  v-diasize-proc-name
     1540               ,input  'width':u
     1541               ,output v-resize-value-str
     1542               ) .
     1543             if v-resize-value-str <> '':U
     1544             then do:
     1545               run diasize_change-width in this-procedure
     1546                 (input  integer(v-resize-value-str)
     1547                 ,input  true
     1548                 ) .
     1549               assign
     1550                 v-restore-saved = true
     1551               .
     1552             end.
     1553           end.
     1554           if v-restore-saved <> true
     1555           then do:
     1556             if v-diasize-wndmax = true
     1557             then do:
     1558               run diasize_maximize in this-procedure
     1559                 (input  true
     1560                 ) .
     1561             end.
     1562           end.
     1563         end.
     1564         else do:
     1565           if v-diasize-wndmax = true
     1566           then do:
     1567             run diasize_maximize in this-procedure
     1568               (input  true
     1569               ) .
     1570           end.
     1571         end.
     1572       end.
     1573     end.
     1574   end procedure.
     1575   procedure diasize_need-full-display :
     1576     define output parameter p-need-full-display as logical   no-undo .
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       assign
     1581         p-need-full-display = v-diasize-need-full-display
     1582       .
     1583       assign
     1584         v-diasize-need-full-display = false
     1585       .
     1586     end.
     1587   end procedure.
     1588   procedure get-context :
     1589      define output parameter p-db-num as integer          no-undo.
     1590      define output parameter p-user-id as character        no-undo.
     1591      define variable v-login               as character    no-undo.
     1592      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1593      define buffer buf_user-login  for ub.user-login .
     1594      do
     1595      on error undo, return error
     1596      :
     1597            FIND FIRST buf_sys-ctrl no-lock.
     1598            ASSIGN
     1599               v-login = USERID("ub")
     1600               p-db-num = buf_sys-ctrl.db-num
     1601            .
     1602            FIND FIRST buf_user-login
     1603                 WHERE buf_user-login.db-num = p-db-num
     1604                   AND buf_user-login.user-login = v-login
     1605                 no-lock
     1606                 no-error
     1607                 .
     1608            IF AVAILABLE buf_user-login
     1609            THEN DO:
     1610               assign
     1611                  p-user-id = buf_user-login.user-id
     1612               .
     1613            END.
     1614      end.
     1615   end procedure.
     1616       run diasize_init in this-procedure .
     1617   MAIN-BLOCK:
     1618   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1619      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1620   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621     run mainmenu_getcntxt in parparentproc
     1622       (output v-cntxt-db-num
     1623       ,output v-cntxt-userid
     1624       ,output v-cntxt-level
     1625       ,output v-cntxt-host-code-obj
     1626       ,output v-cntxt-obj-type
     1627       ,output v-cntxt-obj-code
     1628       ,output v-cntxt-db-num-obj
     1629       ,output v-cntxt-is-admin
     1630       ) .
     1631     if par-mode <> 'ПРОСМОТР':U then do:
     1632         message vss-workfile vss-revision vss-description skip
     1633                     "Неверный параметр вызова par-mode"
     1634         view-as alert-box ERROR.
     1635         return error.
     1636     end.
     1637     if par-mode = 'ПРОСМОТР':U then do:
     1638           FIND FIRST buf_c-wth-line No-LOCK WHERE
     1639                      recid(buf_c-wth-line) = parline-rec No-ERROR.
     1640     end.
     1641     FIND FIRST buf_c-wth-doc No-LOCK WHERE
     1642                buf_c-wth-doc.doc-code = pardoc-code No-ERROR.
     1643     IF NOT AVAIL buf_c-wth-doc THEN DO:
     1644       MESSAGE  "Не найден документ движения МЦ"
     1645       VIEW-AS ALERT-BOX ERROR.
     1646       RETURN error.
     1647     END.
     1648     if buf_c-wth-doc.doc-type <> 'инв':U then do:
     1649       MESSAGE
     1650       vss-workfile vss-revision vss-description skip
     1651       "Неверный вызов - документ МЦ имеет тип" buf_c-wth-doc.doc-type
     1652       VIEW-AS ALERT-BOX ERROR.
     1653       RETURN error.
     1654     end.
     1655     vardoc-status_ = buf_c-wth-doc.status_.
     1656     FIND FIRST buf_wealth No-LOCK WHERE
     1657                 buf_wealth.wth-code = parwth-code NO-ERROR.
     1658     IF NOT AVAIL buf_wealth THEN DO:
     1659         MESSAGE
     1660           "Не найдена материальная ценность в справочнике!"
     1661         VIEW-AS ALERT-BOX ERROR.
     1662         RETURN error.
     1663     END.
     1664     run fill-tables in this-Procedure no-error.
     1665     if error-status:error then return error.
     1666     RUN Myenable.
     1667     WAIT-FOR GO OF FRAME Dialog-Frame.
     1668   END.
     1669   RUN disable_UI.
     1670   PROCEDURE disable_UI :
     1671     HIDE FRAME Dialog-Frame.
     1672   END PROCEDURE.
     1673   PROCEDURE enable_UI :
     1674     OPEN QUERY Dialog-Frame FOR EACH buf_c-wth-line SHARE-LOCK.
     1675     GET FIRST Dialog-Frame.
     1676     DISPLAY for-d_aft-sum for-d_bef-sum for-d_fact-sum
     1677         WITH FRAME Dialog-Frame.
     1678     IF AVAILABLE ub.c-wth-line THEN
     1679       DISPLAY ub.c-wth-line.bef-sum ub.c-wth-line.aft-sum ub.c-wth-line.fact-sum
     1680         WITH FRAME Dialog-Frame.
     1681     IF AVAILABLE ub.wealth THEN
     1682       DISPLAY ub.wealth.wth-name
     1683         WITH FRAME Dialog-Frame.
     1684     ENABLE b-quit B-par B-Help BR-dtl ub.wealth.wth-name ub.c-wth-line.bef-sum
     1685            ub.c-wth-line.aft-sum ub.c-wth-line.fact-sum for-d_aft-sum
     1686            for-d_bef-sum for-d_fact-sum
     1687         WITH FRAME Dialog-Frame.
     1688     VIEW FRAME Dialog-Frame.
     1689   END PROCEDURE.
     1690   PROCEDURE fill-tables :
     1691   if not can-find(first tt-par-dtl) then do:
     1692       FOR EACH ub.wth-par NO-LOCK WHERE
     1693                ub.wth-par.wth-code = buf_wealth.wth-code :
     1694         FIND FIRST tt-par-dtl WHERE
     1695                    tt-par-dtl.par-code = ub.wth-par.par-code NO-ERROR.
     1696         IF NOT AVAIL tt-par-dtl THEN DO:
     1697           CREATE tt-par-dtl.
     1698           ASSIGN
     1699             tt-par-dtl.par-code = ub.wth-par.par-code
     1700             tt-par-dtl.par-val  = ub.wth-par.par-val
     1701             tt-par-dtl.par-unit = ub.wth-par.par-unit
     1702             tt-par-dtl.par-feat = ub.wth-par.par-feat
     1703             tt-par-dtl.par-rate = ub.wth-par.par-rate / ub.wth-par.par-val
     1704             tt-par-dtl.q-ty-bef     = 0
     1705             tt-par-dtl.sum-bef  = 0
     1706             tt-par-dtl.q-ty-aft     = 0
     1707             tt-par-dtl.sum-aft  = 0
     1708             tt-par-dtl.sum-fact  = 0
     1709             .
     1710         END.
     1711       END.
     1712       FOR EACH ub.c-wth-dtl NO-LOCK WHERE
     1713               ub.c-wth-dtl.doc-code = pardoc-code
     1714           AND ub.c-wth-dtl.wth-code = parwth-code
     1715           AND ub.c-wth-dtl.w-p-code = parw-p-code
     1716           AND ub.c-wth-dtl.corr-user-db-num = parcorr-user-db-num
     1717           AND ub.c-wth-dtl.chip-num = parchip-num
     1718       BY
     1719       ub.c-wth-dtl.par-code :
     1720         FIND FIRST tt-par-dtl WHERE
     1721                    tt-par-dtl.par-code = ub.c-wth-dtl.par-code NO-ERROR.
     1722         IF NOT AVAIL tt-par-dtl THEN DO:
     1723           NEXT.
     1724         END.
     1725       ASSIGN
     1726       tt-par-dtl.sum-bef = ub.c-wth-dtl.bef-sum
     1727       tt-par-dtl.sum-aft = ub.c-wth-dtl.aft-sum
     1728       tt-par-dtl.sum-fact = if (vardoc-status_ = 'разрешен':U)
     1729                                                       then (ub.c-wth-dtl.aft-sum - ub.c-wth-dtl.bef-sum)
     1730                                                       else tt-par-dtl.sum-fact
     1731       .
     1732         ASSIGN
     1733         tt-par-dtl.q-ty-bef = tt-par-dtl.sum-bef / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1734         tt-par-dtl.q-ty-aft = tt-par-dtl.sum-aft / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1735         d_bef-sum   = d_bef-sum      + tt-par-dtl.sum-bef
     1736         d_aft-sum   = d_aft-sum      + tt-par-dtl.sum-aft
     1737         d_fact-sum = d_aft-sum - d_bef-sum
     1738         .
     1739       END.
     1740   end.
     1741   else do:
     1742    FOR EACH ub.c-wth-dtl NO-LOCK WHERE
     1743               ub.c-wth-dtl.doc-code = pardoc-code
     1744           AND ub.c-wth-dtl.wth-code = parwth-code
     1745           AND ub.c-wth-dtl.w-p-code = parw-p-code
     1746           AND ub.c-wth-dtl.corr-user-db-num = parcorr-user-db-num
     1747           AND ub.c-wth-dtl.chip-num = parchip-num
     1748       BY
     1749       ub.c-wth-dtl.par-code :
     1750         FIND FIRST tt-par-dtl WHERE
     1751                    tt-par-dtl.par-code = ub.c-wth-dtl.par-code NO-ERROR.
     1752         IF NOT AVAIL tt-par-dtl THEN DO:
     1753           NEXT.
     1754         END.
     1755       ASSIGN
     1756         d_bef-sum   = d_bef-sum      + tt-par-dtl.sum-bef
     1757         d_aft-sum   = d_aft-sum      + tt-par-dtl.sum-aft
     1758         d_fact-sum = d_aft-sum - d_bef-sum
     1759         .
     1760       end.
     1761   end.
     1762   END PROCEDURE.
     1763   PROCEDURE MyEnable :
     1764   IF par-mode = 'ПРОСМОТР':U THEN DO:
     1765     ASSIGN
     1766     tt-par-dtl.q-ty-bef:READ-ONLY IN BROWSE BR-dtl = YES
     1767     tt-par-dtl.q-ty-aft:READ-ONLY IN BROWSE BR-dtl = YES
     1768     .
     1769   END.
     1770     ASSIGN FRAME Dialog-Frame:TITLE = CAPS( buf_wealth.wth-name ) + " (номиналы)".
     1771     DISPLAY
     1772     buf_wealth.wth-name @ ub.wealth.wth-name
     1773     d_bef-sum @ for-d_bef-sum
     1774     d_aft-sum  @ for-d_aft-sum
     1775     d_fact-sum @  for-d_fact-sum
     1776     WITH FRAME Dialog-Frame.
     1777     DISPLAY
     1778     parbef-sum @ ub.c-wth-line.bef-sum
     1779     paraft-sum @ ub.c-wth-line.aft-sum
     1780     string(paraft-sum - parbef-sum) @ ub.c-wth-line.fact-sum
     1781     WITH FRAME Dialog-Frame.
     1782     ENABLE
     1783     b-quit
     1784     b-help
     1785     B-Par
     1786     BR-dtl
     1787     WITH FRAME Dialog-Frame.
     1788     CASE  buf_c-wth-doc.status_:
     1789       when 'накл':U then dO:
     1790         tt-par-dtl.q-ty-aft:READ-ONLY IN BROWSE BR-dtl = YES.
     1791         HIDE
     1792         c-wth-line.aft-sum
     1793         c-wth-line.fact-sum
     1794         for-d_aft-sum
     1795         for-d_fact-sum
     1796         in frame Dialog-Frame .
     1797       end.
     1798       when 'разрешен':U then do:
     1799         tt-par-dtl.q-ty-bef:READ-ONLY IN BROWSE BR-dtl = YES.
     1800       end.
     1801     end CASE.
     1802     VIEW FRAME Dialog-Frame.
     1803     OPEN QUERY BR-dtl FOR EACH tt-par-dtl USE-INDEX tt-i1.
     1804   END PROCEDURE.
