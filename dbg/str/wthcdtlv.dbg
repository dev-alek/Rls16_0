      473   procedure diasize_change-height :
      474     define input  parameter p-change-value  as decimal   no-undo .
      475     define input  parameter p-move-resize   as logical   no-undo .
      476     define variable v-field-group-handle    as handle    no-undo .
      477     define variable v-object-handle         as handle    no-undo .
      478     define variable v-frame-height          as decimal   no-undo .
      479     define variable v-frame-virtual-height  as decimal   no-undo .
      480     define variable v-browse-height         as decimal   no-undo .
      481     define variable v-window-height         as decimal   no-undo .
      482     define variable v-window-virtual-height as decimal   no-undo .
      483     define variable v-change-sign           as integer   no-undo .
      484     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      485     define buffer buf_temp-browse-handle  for temp-browse-handle .
      486     if p-change-value > 0
      487     then do:
      488       if frame Dialog-Frame :height + p-change-value
      489           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      490       then do:
      491         assign
      492           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      493                           - (frame Dialog-Frame :height-chars)
      494         .
      495         if p-change-value <= 0
      496         then do:
      497           run diasize_position-resize-button in this-procedure .
      498           return .
      499         end.
      500       end.
      501     end.
      502     if p-change-value < 0
      503     then do:
      504       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      505       then do:
      506         assign
      507           p-change-value = v-diasize-orig-frame-height
      508                          - (frame Dialog-Frame :height-chars)
      509         .
      510         if p-change-value >= 0
      511         then do:
      512           run diasize_position-resize-button in this-procedure .
      513           return .
      514         end.
      515       end.
      516     end.
      517     if p-change-value >= 0
      518     then do:
      519       assign
      520         v-change-sign = 1
      521       .
      522     end.
      523     else do:
      524       assign
      525         v-change-sign = -1
      526       .
      527     end.
      528     assign
      529       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      530     .
      531     if p-change-value = 0
      532     then do:
      533       run diasize_position-resize-button in this-procedure .
      534       return .
      535     end.
      536     move_block:
      537     do
      538     on error undo move_block, retry move_block
      539     :
      540       if retry
      541       then do:
      542         do
      543         on error undo move_block, leave move_block
      544         :
      545           if p-change-value > 0
      546           then do:
      547             for each buf_temp-diasize-handle
      548             on error undo, next
      549             :
      550               assign
      551                 v-object-handle = buf_temp-diasize-handle.handle-value
      552               .
      553               if v-object-handle <> v-diasize-resize-button
      554               then do:
      555                 assign
      556                   v-object-handle :row = buf_temp-diasize-handle.save-position
      557                 .
      558               end.
      559             end.
      560             assign
      561               v-diasize-browse-handle :height = v-browse-height
      562             .
      563             for each buf_temp-browse-handle
      564               where buf_temp-browse-handle.browse-type = 'height':u
      565             on error undo, next
      566             :
      567               assign
      568                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      569               .
      570             end.
      571             assign
      572               frame Dialog-Frame :height = v-frame-height
      573             .
      574             if frame Dialog-Frame :scrollable = true
      575             then do:
      576               assign
      577                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      578               .
      579             end.
      580             run diasize_position-resize-button in this-procedure .
      581           end.
      582           else do:
      583             if frame Dialog-Frame :scrollable = true
      584             then do:
      585               assign
      586                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      587               .
      588             end.
      589             assign
      590               frame Dialog-Frame :height = v-frame-height
      591             .
      592             assign
      593               v-diasize-browse-handle :height = v-browse-height
      594             .
      595             for each buf_temp-browse-handle
      596               where buf_temp-browse-handle.browse-type = 'height':u
      597             on error undo, next
