      719         assign
      720           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      721           no-error .
      722         if error-status :error
      723         or error-status :get-message(1) <> ""
      724         then do:
      725           undo move_block, retry move_block .
      726         end.
      727         for each buf_temp-browse-handle
      728           where buf_temp-browse-handle.browse-type = 'height':u
