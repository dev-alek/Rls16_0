      829           define variable v-cntxt-db-num        as integer   no-undo .
      830           define variable v-cntxt-userid        as character no-undo .
      831           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      832                                             , OUTPUT v-cntxt-userid
      833                                             ) .
      834           run gbl/wndsizew.p
      835             (input  v-cntxt-db-num
      836             ,input  v-cntxt-userid
      837             ,input  v-diasize-proc-name
      838             ,input  'height':u
      839             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      840             ) .
      841         end.
      842       end.
      843     end.
      844     assign
      845       v-diasize-change-size = false
      846     .
      847   end procedure.
      848   procedure diasize_set-height :
      849     define input  parameter p-new-height  as decimal   no-undo .
      850     define input  parameter p-move-resize as logical   no-undo .
      851     do
      852     on error undo, return error return-value
      853     :
      854       run diasize_change-height in this-procedure
      855         (input  (p-new-height - frame Dialog-Frame :height)
      856         ,input  p-move-resize
      857         ) .
      858     end.
