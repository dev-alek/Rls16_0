      432   procedure wth-pobj-hist :
      433   define parameter buffer buf_wth-pobj for ub.wth-pobj.
      434   define input parameter p-obj-type like ub.wth-pobj.obj-type no-undo .
      435   define input parameter p-obj-code like ub.wth-pobj.obj-code no-undo .
      436   define input parameter p-wth-code like ub.wth-pobj.wth-code no-undo .
      437   define input parameter p-w-p-code like ub.wth-pobj.w-p-code no-undo .
      438   define input parameter p-action-type as character no-undo .
      439   define input  parameter p-source-type        as character no-undo .
      440   define input  parameter p-source-ref         as character no-undo .
      441   define input  parameter p-source-date        as date      no-undo .
      442   define input  parameter p-corr-user-db-num   as integer   no-undo .
      443   define input  parameter p-corr-user-name     as character no-undo .
      444   define input  parameter p-corr-date          as date      no-undo .
      445   define input  parameter p-corr-time          as integer   no-undo .
      446   define input  parameter p-corr-time-str      as character no-undo .
      447   define variable v-new-chip-num as integer   no-undo .
      448   define buffer buf_c-wth-pobj for ub.c-wth-pobj .
      449     do
      450     for buf_c-wth-pobj
      451     transaction
      452     on error undo, return error return-value
      453     :
      454       find first buf_c-wth-pobj exclusive-lock
      455         where buf_c-wth-pobj.obj-type = buf_wth-pobj.obj-type
      456           and buf_c-wth-pobj.obj-code = buf_wth-pobj.obj-code
      457           and buf_c-wth-pobj.wth-code = buf_wth-pobj.wth-code
      458           and buf_c-wth-pobj.w-p-code = buf_wth-pobj.w-p-code
      459         use-index ishow
      460         no-error .
      461       if available buf_c-wth-pobj
      462       then do:
      463          assign
      464           v-new-chip-num = buf_c-wth-pobj.chip-num + 1
      465         .
      466       end.
      467       else do:
      468         assign
      469           v-new-chip-num = 1
      470         .
      471       end.
      472       create buf_c-wth-pobj .
      473       if p-action-type = 'delete':U
      474       and
      475       not available buf_wth-pobj then do:
      476         assign
      477         buf_c-wth-pobj.obj-type = p-obj-type
      478         buf_c-wth-pobj.obj-code = p-obj-code
      479         buf_c-wth-pobj.wth-code = p-wth-code
      480         buf_c-wth-pobj.w-p-code = p-w-p-code
      481         buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      482         .
      483       end.
      484       else do:
      485         buffer-copy buf_wth-pobj to buf_c-wth-pobj
      486         assign buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      487         .
      488       end.
      489       assign
      490         buf_c-wth-pobj.chip-num          = v-new-chip-num
      491         buf_c-wth-pobj.action-type       = p-action-type
      492         buf_c-wth-pobj.source-type       = p-source-type
      493         buf_c-wth-pobj.source-ref        = p-source-ref
      494         buf_c-wth-pobj.source-date       = p-source-date
      495         buf_c-wth-pobj.corr-user-name    = p-corr-user-name
      496         buf_c-wth-pobj.corr-date         = p-corr-date
      497         buf_c-wth-pobj.corr-time         = p-corr-time
      498         buf_c-wth-pobj.corr-time-str     = p-corr-time-str
      499       .
      500     end.
      501   end procedure.
