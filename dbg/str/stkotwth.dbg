     4077   end procedure.
     4078   define buffer bf_wth-doc      for ub.wth-doc.
     4079   define buffer bf_wth-line     for ub.wth-line.
     4080   define buffer prev_wth-doc    for ub.wth-doc.
     4081   define buffer bf_wth-obj      for ub.wth-obj.
     4082   define buffer bf_wth-pobj     for ub.wth-pobj.
     4083   define buffer bf_clients      for ub.clients.
     4084   define buffer bf_wth-parts    for ub.wth-parts.
     4085   define buffer bf_wth-dtl      for ub.wth-dtl.
     4086   define variable varattr-value as character no-undo.
     4087   define variable varattr-type  as character no-undo.
     4088   define variable v-bar-code    as character no-undo.
     4089   define variable v-doc-num     as character  no-undo.
     4090   define variable v-price-sale  as decimal no-undo.
     4091   define variable v-road-tax    as decimal   no-undo.
     4092   define variable v-excise      as decimal     no-undo.
     4093   define variable v-curr-r-b    as character    no-undo.
     4094   define variable v-base-rate   as decimal no-undo.
     4095   define variable v-base-scale  as decimal no-undo.
     4096   define variable v-sum-line-rubl    as decimal      no-undo.
     4097   define variable v-sum-line-base    as decimal      no-undo.
     4098   define variable v-sum-dtl-rubl    as decimal      no-undo.
     4099   define variable v-sum-dtl-base    as decimal      no-undo.
     4100   define variable v-gds-price-rubl    as decimal      no-undo.
     4101   define variable v-gds-price-base    as decimal      no-undo.
     4102   define temp-table temp-wth-line no-undo like ub.wth-line.
     4103   find first bf_wth-doc where recid(bf_wth-doc) = parrec_wth-doc no-error.
     4104   if not available bf_wth-doc then do:
     4105      return error
     4106      "Неправильные входные параметры файла stkotwth.p. Указан record id документа материальных ценностей: " +
     4107      string(parrec_wth-doc).
     4108   end.
     4109   if p-wth-code > 0 and   p-wth-doc-close = true  then do:
     4110     return error "Ошибка задания входных параметров. Закрытие документа для одной линии запрещено. Указан код МЦ:" +  string(p-wth-code).
     4111   end.
     4112   tr:
     4113   do transaction
     4114   on error undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4115   on stop  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4116   on quit  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4117   :
     4118     if p-wth-doc-close = true
     4119           then do:
     4120       run wth-arh-calctt-loc(input bf_wth-doc.doc-code
     4121                             ,input yes) no-error.
     4122           if error-status:error then undo tr, return error return-value + error-status:get-message(1).
     4123     end.
     4124     empty temp-table temp-wth-line.
     4125     for each bf_wth-line exclusive where
     4126             bf_wth-line.doc-code = bf_wth-doc.doc-code
     4127     by bf_wth-line.wth-code
     4128     on error undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4129     on stop  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4130     on quit  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4131     :
     4132       find first temp-wth-line where
     4133                 temp-wth-line.wth-code = bf_wth-line.wth-code no-error.
     4134       if not available temp-wth-line then do:
     4135         create temp-wth-line.
     4136         assign
     4137         temp-wth-line.wth-code = bf_wth-line.wth-code
     4138         .
     4139       end.
     4140       assign
     4141       temp-wth-line.fact-sum = temp-wth-line.fact-sum + bf_wth-line.fact-sum
     4142       temp-wth-line.doc-sum = temp-wth-line.doc-sum + bf_wth-line.doc-sum
     4143       temp-wth-line.aft-sum = temp-wth-line.aft-sum + bf_wth-line.aft-sum
     4144       .
     4145       release temp-wth-line.
     4146     end.
     4147     for each bf_wth-line exclusive where
     4148             bf_wth-line.doc-code = bf_wth-doc.doc-code
     4149     and (if p-wth-code > 0 then bf_wth-line.wth-code = p-wth-code else true)
     4150     break
     4151     by bf_wth-line.wth-code
     4152     on error undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4153     on stop  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4154     on quit  undo, return error "Ошибка при подсчете оборотов и остатков в файле stkotwth.p."
     4155     :
     4156       find first temp-wth-line where temp-wth-line.wth-code = bf_wth-line.wth-code.
     4157      v-sum-line-rubl = 0.
     4158      v-sum-line-base = 0.
     4159      if  (not g#news
     4160          or (g#news and  g#db-num  = 0))
     4161          and bf_wth-doc.ext-doc-type <> 'dc':U
     4162      then do:
     4163   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthobjcr in g#library
     4165     (input  bf_wth-doc.obj-type
     4166     ,input  bf_wth-doc.obj-code
     4167     ,input  bf_wth-line.wth-code
     4168     ,buffer bf_wth-obj
     4169     )  .
     4170         find current bf_wth-obj exclusive.
     4171   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthpobjc in g#library
     4173     (input  bf_wth-doc.obj-type
     4174     ,input  bf_wth-doc.obj-code
     4175     ,input  bf_wth-line.wth-code
     4176     ,input bf_wth-line.w-p-code
     4177     ,buffer bf_wth-pobj
     4178     )  .
     4179         find current bf_wth-pobj exclusive.
     4180         if parrecalc-doc = yes then do:
     4181            if lookup (bf_wth-doc.ext-doc-type, 'ij,pj,fj,jj,oj,ej':U) = 0 and
     4182            bf_wth-doc.ext-doc-type <> 'de':U
     4183            then do:
     4184   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4185   if lookup (bf_wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0   OR
     4186      (bf_wth-doc.ext-doc-type = 'iy':U AND temp-wth-line.fact-sum > 0) or
     4187      lookup (bf_wth-doc.ext-doc-type, 'rj,rf,rp':U) > 0   or
     4188      (bf_wth-doc.ext-doc-type = 'xc':U ) then do:
     4189          if bf_wth-doc.ext-doc-type = 'iy':U and bf_wth-doc.doc-code begins '1-' then do:
     4190               assign
     4191                 bf_wth-line.income       = bf_wth-obj.income +  temp-wth-line.aft-sum
     4192                 bf_wth-line.income-other = bf_wth-obj.income-other + temp-wth-line.aft-sum
     4193                 bf_wth-line.income-cassa = 0.
     4194                 end.
     4195          else do:
     4196              assign
     4197              bf_wth-line.income       = bf_wth-obj.income + temp-wth-line.fact-sum.
     4198              if bf_wth-doc.ext-doc-type = 'ci':U then
     4199              assign
     4200                 bf_wth-line.income-cassa = bf_wth-obj.income-cassa + temp-wth-line.fact-sum
     4201                 bf_wth-line.income-other = bf_wth-obj.income-other.
     4202              else
     4203              assign
     4204                 bf_wth-line.income-other = bf_wth-obj.income-other + temp-wth-line.fact-sum
     4205                 bf_wth-line.income-cassa = bf_wth-obj.income-cassa.
     4206         end.
     4207      assign bf_wth-line.incass       = bf_wth-obj.incass
     4208             bf_wth-line.incass-bank  = bf_wth-obj.incass-bank
     4209             bf_wth-line.incass-other = bf_wth-obj.incass-other
     4210             bf_wth-line.incass-cassa = bf_wth-obj.incass-cassa.
     4211   end.
     4212   else do:
     4213       if lookup (bf_wth-doc.ext-doc-type, 'ee,ei,ej,jj,oj,ce,ef,ep':U) > 0 OR  lookup (bf_wth-doc.ext-doc-type,'we,dc,dp,df':U) > 0
     4214           or (bf_wth-doc.ext-doc-type = 'iy':U AND temp-wth-line.fact-sum <= 0)
     4215           and bf_wth-doc.ext-doc-type <> 'dc':U then do:
     4216           if bf_wth-doc.ext-doc-type = 'iy':U then do:
     4217               if bf_wth-doc.doc-code begins '1-' then do:
     4218               assign
     4219                 bf_wth-line.incass       = bf_wth-obj.incass       - temp-wth-line.aft-sum
     4220                 bf_wth-line.incass-other = bf_wth-obj.incass-other - temp-wth-line.aft-sum
     4221                 bf_wth-line.incass-cassa = 0
     4222                 bf_wth-line.incass-bank  = 0.
     4223                 end.
     4224            else
     4225                assign
     4226                 bf_wth-line.incass       = bf_wth-obj.incass       - temp-wth-line.fact-sum
     4227                 bf_wth-line.incass-other = bf_wth-obj.incass-other - temp-wth-line.fact-sum
     4228                 bf_wth-line.incass-cassa = bf_wth-obj.incass-cassa
     4229                 bf_wth-line.incass-bank  = bf_wth-obj.incass-bank.
     4230           end.
     4231           else do:
     4232              assign
     4233                 bf_wth-line.incass       = bf_wth-obj.incass + temp-wth-line.fact-sum.
     4234              if bf_wth-doc.ext-doc-type = 'ce':U then do:
     4235                 assign bf_wth-line.incass-other = bf_wth-obj.incass-other
