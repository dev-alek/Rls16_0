     3892   procedure wth-arhdoc-delete:
     3893    define input parameter pardoc-code as char no-undo.
     3894     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     3895     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     3896     if not available buf-arh_wth-doc then do:
     3897       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     3898     end.
     3899     if buf-arh_wth-doc.status_ <> 'факт':U then do:
     3900       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
     3901     end.
     3902     if buf-arh_wth-doc.fact-order = 0 or
     3903       buf-arh_wth-doc.fact-order = ? then do:
     3904       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
     3905     end.
     3906     run wth-arh-calctt-loc(input buf-arh_wth-doc.doc-code
     3907                           ,input no) no-error.
     3908     if error-status:error then  return error return-value + error-status:get-message(1).
     3909     for each  tt-parts-tot on error undo, return error return-value:
     3910         find first  buf-arh-wth-tot where buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3911                                           and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
     3912                                           and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3913                                           and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3914                                           and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3915                                           and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type
     3916                                           and buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
     3917                                           no-error.
     3918         if available buf-arh-wth-tot then do:
     3919             delete buf-arh-wth-tot.
     3920         end.
     3921         for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
     3922               and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
     3923               and buf-recalc-tot.par-code = tt-parts-tot.par-code
     3924               and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
     3925               and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
     3926               and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3927               and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
     3928                :
     3929               assign buf-recalc-tot.out-qnty     = buf-recalc-tot.out-qnty - tt-parts-tot.out-qnty
     3930                     buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl - tt-parts-tot.out-sum-rubl
     3931                     buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base - tt-parts-tot.out-sum-base
     3932                     buf-recalc-tot.in-qnty       = buf-recalc-tot.in-qnty - tt-parts-tot.in-qnty
     3933                     buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl - tt-parts-tot.in-sum-rubl
     3934                     buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base - tt-parts-tot.in-sum-base
     3935                     .
     3936         end.
     3937     end.
     3938     for each  tt-parts-wp on error undo, return error return-value:
     3939         find first  buf-arh-wth-wp where buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
     3940                                           and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
     3941                                           and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
