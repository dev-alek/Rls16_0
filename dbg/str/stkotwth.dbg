      791   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   procedure cur-time :
      795      define output parameter p-today as date      no-undo .
      796      define output parameter p-time  as integer   no-undo .
      797     do
      798     on error undo, return error
      799     :
      800       define variable v-date1 as date      no-undo .
      801       define variable v-date2 as date      no-undo .
      802       define variable v-time  as integer   no-undo .
      803       assign
      804         v-date1 = today
      805         v-time  = time
      806         v-date2 = today
      807       .
      808       if v-date1 <> v-date2
      809       then do:
      810         assign
      811           v-date1 = today
      812           v-time  = v-time
      813         .
      814       end.
      815       assign
      816         p-today = v-date1
      817         p-time  = v-time
      818       .
      819     end.
      820   end.
      821   function cur-time-date returns character
      822   :
      823     return string(today, '99/99/9999':U) .
      824   end.
      825   function cur-time-mjd returns decimal
      826   :
      827     define variable v-date as date      no-undo .
      828     define variable v-time as integer   no-undo .
      829     run cur-time in this-procedure
      830       (output v-date
      831       ,output v-time
      832       ) .
      833     return integer(v-date) - 2400002 + (v-time / 86400) .
      834   end.
      835   function cur-time-get-ending-index returns integer
      836   (input p-number as integer
      837   )
      838   :
      839     if p-number < 0
      840     or p-number = ?
      841     then do:
      842       return 1 .
      843     end.
      844     define variable v-rest as integer   no-undo .
      845     assign
      846       p-number = p-number modulo 100
      847     .
      848     if p-number < 20
      849     then do:
      850       assign
      851         v-rest = p-number
      852       .
      853     end.
      854     else do:
      855       assign
      856         v-rest = p-number modulo 10
      857       .
      858     end.
      859     case v-rest :
      860       when 1
      861       then do:
      862         return 2 .
      863       end.
      864       when 2 or
      865       when 3 or
      866       when 4
      867       then do:
      868         return 3 .
      869       end.
      870       otherwise do:
      871         return 1 .
      872       end.
      873     end case .
      874   end.
      875   procedure cur-time-mjd-to-date :
      876      define input  parameter i-mjd-diff as decimal no-undo.
      877      define output parameter o-Date     as date    no-undo.
      878      define output parameter o-Time     as integer no-undo.
      879      define variable v-day-number as integer   no-undo .
      880      if    i-mjd-diff < 0
      881         or i-mjd-diff = ?
      882      then do:
      883         return "?" .
      884      end.
      885      assign
      886         v-day-number = truncate(i-mjd-diff,0).
      887         o-Date = date(v-day-number + 2400002).
      888         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      889     .
      890   end.
      891   function cur-time-mjd-to-string returns character
      892   (input p-mjd-diff as decimal
      893   )
      894   :
      895     define variable v-day-number as integer   no-undo .
      896     define variable v-seconds    as integer   no-undo .
      897     define variable v-hour       as integer   no-undo .
      898     define variable v-min        as integer   no-undo .
      899     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      900     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      901     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      902     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      903     if p-mjd-diff < 0
      904     or p-mjd-diff = ?
      905     then do:
      906       return "?" .
      907     end.
      908     assign
      909       v-day-number = integer(truncate(p-mjd-diff,0))
      910       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      911     .
      912     if v-seconds > 86400
      913     then do:
      914       assign
      915         v-seconds = 86400 - 1
      916       .
      917     end.
      918     if v-seconds < 0
      919     then do:
      920       assign
      921         v-seconds = 0
      922       .
      923     end.
      924     assign
      925       v-hour = truncate(v-seconds / 3600, 0)
      926     .
      927     assign
      928       v-seconds = v-seconds modulo 3600
      929     .
      930     assign
      931       v-min = truncate(v-seconds / 60, 0)
      932     .
      933     assign
      934       v-seconds = v-seconds modulo 60
      935     .
      936     return
      937         (if v-day-number <> 0
      938           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      939           else ""
      940         )
      941       + (if v-day-number <> 0 or v-hour <> 0
      942           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      943           else ""
      944         )
      945       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      946           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      947           else ""
      948         )
      949       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      950       .
      951   end.
      952   function cur-time-string returns character
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      961   end.
      962   function cur-time-string-sec returns character
      963   :
      964     define variable v-date as date      no-undo .
      965     define variable v-time as integer   no-undo .
      966     run cur-time in this-procedure
      967       (output v-date
      968       ,output v-time
      969       ) .
      970     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      971   end.
      972   function cur-time-custom  returns character
      973   (input p-prefix as character
      974   ,input p-date-format as character
      975   ,input p-delimiter as character
      976   ,input p-time-format as character
      977   ,input p-suffix as character
      978   )
      979   :
      980     define variable v-date as date      no-undo .
      981     define variable v-time as integer   no-undo .
      982     run cur-time in this-procedure
      983       (output v-date
      984       ,output v-time
      985       ) .
      986     return
      987       p-prefix
      988       + string(v-date, p-date-format)
      989       + p-delimiter
      990       + string(v-time, p-time-format)
      991       + p-suffix
      992       .
      993   end.
      994   function cur-time-print  returns character
      995   :
      996     define variable v-date as date      no-undo .
      997     define variable v-time as integer   no-undo .
      998     run cur-time in this-procedure
      999       (output v-date
     1000       ,output v-time
     1001       ) .
     1002     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1003   end.
     1004   function cur-time-datetime returns datetime
     1005   :
     1006     define variable v-char as character no-undo .
     1007     define variable v-datetime as datetime no-undo .
     1008     v-char = cur-time-string().
     1009     v-datetime = datetime(v-char).
     1010     return  v-datetime.
     1011   end.
     1012   function cur-time-string-msec returns character
     1013   :
     1014     define variable v-date as datetime  no-undo .
     1015     v-date = now.
     1016     return string(v-date) .
     1017   end.
     1018   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   procedure factord :
     1020     define input  parameter p-fact-date            as date    no-undo .
     1021     define input  parameter p-fact-time            as integer no-undo .
     1022     define input  parameter p-fact-num             as integer no-undo .
     1023     define input  parameter p-shift-date           as date    no-undo .
     1024     define input  parameter p-shift-num            as integer no-undo .
     1025     define input  parameter p-shift-on             as logical no-undo .
     1026     define output parameter p-fact-order           as decimal no-undo .
     1027     define output parameter p-shift-end-fact-order as decimal no-undo .
     1028     define output parameter p-day-end-fact-order   as decimal no-undo .
     1029     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1030     if p-fact-date = ?
     1031     then do:
     1032       return error "Не указана фактическая дата" .
     1033     end.
     1034     define variable v-fact-date-num as integer no-undo .
     1035     assign
     1036       v-fact-date-num = integer(p-fact-date)
     1037     .
     1038     if p-fact-num = ?
     1039     or p-fact-num = 0
     1040     then do:
     1041       return error "Не задан p-fact-num " + string(p-fact-num) .
     1042     end.
     1043     if p-fact-num < 0
     1044     then do:
     1045       return error "Отрицательный fact-num " + string(p-fact-num) .
     1046     end.
     1047     if p-fact-num >= 100000000
     1048     then do:
     1049       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1050     end.
     1051     if p-shift-on = true
     1052     then do:
     1053       if p-shift-date = ?
     1054       then do:
     1055         return error "Не задана дата смены" .
     1056       end.
     1057       if p-shift-num = ?
     1058       or p-shift-num = 0
     1059       then do:
     1060         return error "Не задан номер смены" .
     1061       end.
     1062     end.
     1063     else do:
     1064       assign
     1065         p-shift-date = p-fact-date
     1066         p-shift-num  = 24
     1067       .
     1068     end.
     1069     define variable v-shift-offset as integer no-undo .
     1070     if p-shift-date = p-fact-date
     1071     then do:
     1072       assign
     1073         v-shift-offset = 1
     1074       .
     1075     end.
     1076     if p-shift-date < p-fact-date
     1077     then do:
     1078       assign
     1079         v-shift-offset = 0
     1080       .
     1081     end.
     1082     if p-shift-date > p-fact-date
     1083     then do:
     1084       message
     1085         vss-workfile vss-revision vss-description skip
     1086         "Неправильная дата закрытия смены" skip
     1087         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1088         view-as alert-box error .
     1089       undo, return error
     1090         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1091           ,string(p-fact-date, '99/99/9999':U)
     1092           ,string(p-shift-date, '99/99/9999':U)
     1093           )
     1094       .
     1095     end.
     1096     if p-shift-num < 1
     1097     or p-shift-num > 24
     1098     then do:
     1099       message
     1100         vss-workfile vss-revision vss-description skip
     1101         "Неправильный номер смены" skip
     1102         "p-shift-num" p-shift-num skip
     1103         view-as alert-box error .
     1104       undo, return error return-value .
     1105     end.
     1106     assign
     1107       p-fact-order           = v-fact-date-num
     1108                              + v-shift-offset * 0.5
     1109                              + p-shift-num    * 0.02 - 0.01
     1110                              + p-fact-num     * 0.0000000001
     1111       p-shift-end-fact-order = v-fact-date-num
     1112                              + v-shift-offset * 0.5
     1113                              + p-shift-num    * 0.02
     1114       p-day-end-fact-order   = v-fact-date-num
     1115                              + 0.99
     1116     .
     1117     if p-fact-order           <= v-fact-date-num
     1118     or p-shift-end-fact-order <= v-fact-date-num
     1119     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1120     or p-shift-end-fact-order >= p-day-end-fact-order
     1121     then do:
     1122       message
     1123         vss-workfile vss-revision vss-description skip
     1124         "Внутренняя ошибка при генерации фактического номера" skip
     1125         "p-fact-date"            p-fact-date            skip
     1126         "p-fact-time"            p-fact-time            skip
     1127         "p-fact-num"             p-fact-num             skip
     1128         "p-shift-date"           p-shift-date           skip
     1129         "p-shift-num"            p-shift-num            skip
     1130         "p-shift-on"             p-shift-on             skip
     1131         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1132         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1133         "v-fact-date-num"        v-fact-date-num        skip
     1134         view-as alert-box error .
     1135       undo, return error return-value .
     1136     end.
     1137   end procedure.
     1138   procedure day-begin-fact-order :
     1139     define input  parameter p-fact-date            as date    no-undo .
     1140     define output parameter p-day-begin-fact-order as decimal no-undo .
     1141     do
     1142     on error undo, return error return-value
     1143     :
     1144       if p-fact-date = ?
     1145       then do:
     1146         assign
     1147           p-day-begin-fact-order = 0
     1148         .
     1149       end.
     1150       else do:
     1151         assign
     1152           p-day-begin-fact-order = integer(p-fact-date)
     1153         .
     1154       end.
     1155     end.
     1156   end procedure.
     1157   procedure factord-max-fact-order :
     1158     define output parameter p-max-fact-order as decimal   no-undo .
     1159     do
     1160     on error undo, return error return-value
     1161     :
     1162       run day-begin-fact-order in this-procedure
     1163         (input  date(1, 1, 5000)
     1164         ,output p-max-fact-order
     1165         ) .
     1166     end.
     1167   end procedure.
     1168   procedure factord-cut-archive :
     1169     define input  parameter p-obj-type             as character no-undo .
     1170     define input  parameter p-obj-code             as integer   no-undo .
     1171     define input  parameter p-fact-date            as date      no-undo .
     1172     define output parameter p-shift-on             as logical   no-undo .
     1173     define output parameter p-shift-date           as date      no-undo .
     1174     define output parameter p-shift-num            as integer   no-undo .
     1175     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1176     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1177     define variable v-fact-order as decimal   no-undo .
     1178     define buffer buf_shift-obj for ub.shift-obj .
     1179     do
     1180     on error undo, return error return-value
     1181     :
     1182   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1184     (input  p-obj-type
     1185     ,input  p-obj-code
     1186     ,input  'shift-on=request'
     1187     ,output p-shift-on
     1188     ) no-error .
     1189       if error-status :error
     1190       then do:
     1191         message
     1192           vss-workfile vss-revision vss-description skip
     1193           "Ошибка при определении атрибута объекта" skip
     1194           "Объект" p-obj-type p-obj-code skip
     1195           error-status :get-message(1) skip
     1196           return-value skip
     1197           view-as alert-box error .
     1198         undo, return error return-value .
     1199       end.
     1200       if p-shift-on = false
     1201       then do:
     1202         assign
     1203           p-shift-date               = ?
     1204           p-shift-num                = 0
     1205         .
     1206       end.
     1207       else do:
     1208         find first buf_shift-obj share-lock
     1209           where buf_shift-obj.obj-type   = p-obj-type
     1210             and buf_shift-obj.obj-code   = p-obj-code
     1211             and buf_shift-obj.shift-date > p-fact-date
     1212           use-index pi
     1213           no-error .
     1214         if not available buf_shift-obj
     1215         or buf_shift-obj.status_ <> 'зкр':U
     1216         then do:
     1217           message
     1218             vss-workfile vss-revision vss-description skip
     1219             "Невозможно вычислить последнюю смену" skip
     1220             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1221             "Объект" p-obj-type p-obj-code skip
     1222             "Дата" p-fact-date skip
     1223             view-as alert-box error .
     1224           undo, return error return-value .
     1225         end.
     1226         find last buf_shift-obj share-lock
     1227           where buf_shift-obj.obj-type = p-obj-type
     1228             and buf_shift-obj.obj-code = p-obj-code
     1229             and buf_shift-obj.shift-date <= p-fact-date
     1230           use-index pi
     1231           no-error .
     1232         if available buf_shift-obj
     1233         then do:
     1234           if  buf_shift-obj.status_ = 'зкр':U
     1235           then do:
     1236             assign
     1237               p-shift-date = buf_shift-obj.shift-date
     1238               p-shift-num  = buf_shift-obj.shift-num
     1239             .
     1240           end.
     1241           else do:
     1242             message
     1243               vss-workfile vss-revision vss-description skip
     1244               "Невозможно вычислить последнюю смену" skip
     1245               "Статус смены отличен от статуса" 'зкр':U skip
     1246               "Объект" p-obj-type p-obj-code skip
     1247               "Дата" p-fact-date skip
     1248               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1249               view-as alert-box error .
     1250             undo, return error return-value .
     1251           end.
     1252         end.
     1253         else do:
     1254           assign
     1255             p-shift-date = p-fact-date - 1
     1256             p-shift-num  = 1
     1257           .
     1258         end.
     1259       end.
     1260       run factord in this-procedure
     1261         (input  p-fact-date
     1262         ,input  1
     1263         ,input  1
     1264         ,input  p-shift-date
     1265         ,input  p-shift-num
     1266         ,input  p-shift-on
     1267         ,output v-fact-order
     1268         ,output p-shift-end-fact-order
     1269         ,output p-day-end-fact-order
     1270         ) no-error .
     1271       if error-status :error
     1272       then do:
     1273         message
     1274           vss-workfile vss-revision vss-description skip
     1275           "Ошибка при вызове процедуры factord"
     1276           error-status :get-message(1) skip
     1277           return-value skip
     1278           view-as alert-box error .
     1279         undo, return error return-value .
     1280       end.
     1281     end.
     1282   end procedure.
     1283   procedure factord-lock-shift :
     1284     define input  parameter p-obj-type  as character no-undo .
     1285     define input  parameter p-obj-code  as integer   no-undo .
     1286     define input  parameter p-fact-date as date      no-undo .
     1287     define parameter buffer buf_shift-obj for ub.shift-obj .
     1288     define variable v-shift-on      as logical   no-undo .
     1289     define variable v-extra-message as character no-undo .
     1290     define variable v-error as character no-undo .
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1296     (input  p-obj-type
     1297     ,input  p-obj-code
     1298     ,input  'shift-on=request'
     1299     ,output v-shift-on
     1300     ) no-error .
     1301       if error-status :error
     1302       then do:
     1303         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1304         undo, return error v-error .
     1305       end.
     1306       if v-shift-on = true
     1307       then do:
     1308         find first buf_shift-obj share-lock
     1309           where buf_shift-obj.obj-type   = p-obj-type
     1310             and buf_shift-obj.obj-code   = p-obj-code
     1311             and buf_shift-obj.shift-date > p-fact-date
     1312           use-index pi
     1313           no-error .
     1314         if not available buf_shift-obj
     1315         or buf_shift-obj.status_ <> 'зкр':U
     1316         then do:
     1317           find last buf_shift-obj
     1318             where buf_shift-obj.obj-type = p-obj-type
     1319               and buf_shift-obj.obj-code = p-obj-code
     1320               and buf_shift-obj.status_  = 'зкр':U
     1321             use-index stts
     1322             no-error .
     1323           if available buf_shift-obj
     1324           then do:
     1325             assign
     1326               v-extra-message =
     1327                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1328                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1329                               )
     1330             .
     1331           end.
     1332           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1333           undo, return error v-error .
     1334         end.
     1335       end.
     1336     end.
     1337   end procedure.
     1338   procedure factord-end-day :
     1339     define input  parameter p-fact-date            as date    no-undo .
     1340     define output parameter p-day-end-fact-order   as decimal no-undo .
     1341     do
     1342     on error undo, return error return-value
     1343     :
     1344       if p-fact-date = ?
     1345       then do:
     1346         return error "Не указана фактическая дата" .
     1347       end.
     1348       assign
     1349         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1350       .
     1351     end.
     1352   end procedure.
     1353   procedure factord-to-date :
     1354     define input  parameter p-fact-order as decimal no-undo .
     1355     define output parameter p-fact-date  as date    no-undo .
     1356     define variable v-ref-date  as date      no-undo .
     1357     define variable v-ref-delta as integer   no-undo .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       if p-fact-order = ?
     1362       or p-fact-order = 0
     1363       then do:
     1364         return error "Не указан fact-order" .
     1365       end.
     1366       assign
     1367         v-ref-date  = date(1, 1, 2000)
     1368       .
     1369       assign
     1370         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1371       .
     1372       assign
     1373         p-fact-date = v-ref-date + v-ref-delta
     1374       .
     1375     end.
     1376   end procedure.
     1377   procedure factord-to-fact-num :
     1378     define input  parameter p-fact-order as decimal no-undo .
     1379     define output parameter p-fact-num   as integer no-undo .
     1380     define variable v-fact-order-trunc as decimal no-undo .
     1381     do
     1382     on error undo, return error return-value
     1383     :
     1384       if p-fact-order = ?
     1385       or p-fact-order = 0
     1386       then do:
     1387         return error "Не указан fact-order" .
     1388       end.
     1389       assign
     1390        v-fact-order-trunc = truncate(p-fact-order, 2)
     1391       .
     1392       assign
     1393         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1394       .
     1395     end.
     1396   end procedure.
     1397   procedure factord-to-shift-num :
     1398     define input  parameter p-fact-order as decimal no-undo .
     1399     define output parameter p-shift-num   as integer no-undo .
     1400     define variable  p-shift-numd  as decimal   no-undo .
     1401     define variable v-fact-order-trunc as decimal no-undo .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       if p-fact-order = ?
     1406       or p-fact-order = 0
     1407       then do:
     1408         return error "Не указан fact-order" .
     1409       end.
     1410       assign
     1411        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1412       .
     1413       if v-fact-order-trunc < 0.5 then do:
     1414         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1415       end.
     1416       assign
     1417         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1418         .
     1419        assign
     1420         p-shift-num = truncate (p-shift-numd , 0)
     1421       .
     1422     end.
     1423   end procedure.
     1424   procedure fact-order-mpl :
     1425     do
     1426     on error undo, return error return-value
     1427     :
     1428   define input  parameter p-doc-date as date     no-undo .
     1429   define input  parameter p-obj-type as character no-undo .
     1430   define input  parameter p-obj-code as integer   no-undo .
     1431   define output parameter p-fact-order as decimal   no-undo .
     1432   define variable v-fact-date            as date    no-undo .
     1433   define variable v-fact-time            as integer no-undo .
     1434   define variable v-fact-order           as decimal no-undo .
     1435   define variable v-shift-end-fact-order as decimal no-undo .
     1436   define variable v-day-end-fact-order   as decimal no-undo .
     1437   define variable l-shift-on as logical no-undo .
     1438   define variable l-date as date      no-undo .
     1439   define variable l-time as integer   no-undo .
     1440   define variable shift-date as date      no-undo .
     1441   define variable shift-num  as integer   no-undo .
     1442   define variable shift-name as character no-undo .
     1443   define variable max-fact-order as decimal   no-undo .
     1444   define buffer buf_global-state for ub.global-state  .
     1445   find first buf_global-state no-lock no-error .
     1446   if not available buf_global-state then do:
     1447      message
     1448        "Не заданы параметры ценообразования!"
     1449        view-as alert-box error
     1450      .
     1451      return error return-value .
     1452   end.
     1453     run cur-time in this-procedure
     1454     ( output v-fact-date ,
     1455       output v-fact-time  ).
     1456   if p-doc-date = ? then do:
     1457   if buf_global-state.pl-use-sys-date-time  = true then do:
     1458         run factord in this-procedure
     1459           (input  v-fact-date
     1460           ,input  v-fact-time
     1461           ,input  v-fact-time
     1462           ,input  ?
     1463           ,input  ?
     1464           ,input  false
     1465           ,output v-fact-order
     1466           ,output v-shift-end-fact-order
     1467           ,output v-day-end-fact-order
     1468           ) no-error .
     1469         if error-status :error
     1470         or v-fact-order = ?
     1471         or v-fact-order = 0 then do:
     1472           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1473         end.
     1474         p-fact-order = v-fact-order .
     1475   end.
     1476   else do:
     1477   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1479     (input  p-obj-type
     1480     ,input  p-obj-code
     1481     ,input  'shift-on=request'
     1482     ,output l-shift-on
     1483     ) no-error .
     1484         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1485         if p-doc-date <> ? then do:
     1486         end.
     1487          run gbl/factdate.p
     1488          ( input        p-obj-type  ,
     1489            input        p-obj-code  ,
     1490            input-output v-fact-date ,
     1491            input-output v-fact-time ,
     1492            input-output shift-date      ,
     1493            input-output shift-num       ,
     1494            input-output shift-name      ,
     1495            input        yes
     1496            ) no-error .
     1497         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1498         run factord in this-procedure
     1499           (input  v-fact-date
     1500           ,input  v-fact-time
     1501           ,input  v-fact-time
     1502           ,input  shift-date
     1503           ,input  shift-num
     1504           ,input  l-shift-on
     1505           ,output v-fact-order
     1506           ,output v-shift-end-fact-order
     1507           ,output v-day-end-fact-order
     1508           ) no-error .
     1509         if error-status :error
     1510         or v-fact-order = ?
     1511         or v-fact-order = 0 then do:
     1512           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1513         end.
     1514         p-fact-order = v-fact-order .
     1515   end.
     1516   end.
     1517   else do:
     1518          run gbl/factdate.p
     1519          ( input        p-obj-type  ,
     1520            input        p-obj-code  ,
     1521            input-output v-fact-date ,
     1522            input-output v-fact-time ,
     1523            input-output shift-date      ,
     1524            input-output shift-num       ,
     1525            input-output shift-name      ,
     1526            input        yes
     1527            ) no-error .
     1528         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1529         v-fact-date = p-doc-date .
     1530         run factord in this-procedure
     1531           (input  v-fact-date
     1532           ,input  v-fact-time
     1533           ,input  v-fact-time
     1534           ,input  shift-date
     1535           ,input  shift-num
     1536           ,input  l-shift-on
     1537           ,output v-fact-order
     1538           ,output v-shift-end-fact-order
     1539           ,output v-day-end-fact-order
     1540           ) no-error .
     1541         if error-status :error
     1542         or v-fact-order = ?
     1543         or v-fact-order = 0 then do:
     1544           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1545         end.
     1546         p-fact-order = v-fact-order .
     1547   end.
     1548     end.
     1549   end procedure.
     1550   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1551   field sale-qnty as decimal
     1552   field sale-sum  as decimal
     1553   field sale-tnv  as decimal
     1554   field price-sale-base as decimal
     1555   field price-sale-rubl as decimal
     1556   field road-tax-base   as decimal
     1557   field road-tax-rubl   as decimal
     1558   field excise-base as decimal
     1559   field excise-rubl as decimal
     1560   field date-1 as date
     1561   field date-2 as date
     1562   field shift-1 as int
     1563   field shift-2 as int
     1564   field time-1 as int
     1565   field time-2 as int
     1566   field grp-name as char
     1567   field interv-name as char
     1568   field pay-name as char
     1569   field unit-cli as char
     1570   index pi
     1571   plt-priority DESCENDING
     1572   fact-order DESCENDING
     1573   qnty-from asc
     1574   sum-from asc
     1575   turnover-from asc
     1576   date-1 DESCENDING
     1577   time-1 DESCENDING
     1578   date-2 DESCENDING
     1579   time-2 DESCENDING
     1580   type-price DESCENDING
     1581   .
     1582   procedure mpl-autoprice :
     1583   define input  parameter p-only-b-code as logical   no-undo .
     1584   define input  parameter p-cli-type    as character no-undo .
     1585   define input  parameter p-cli-code    as integer   no-undo .
     1586   define input  parameter p-main-b-code as integer   no-undo .
     1587   define input  parameter p-b-code      as integer   no-undo .
     1588   define input  parameter p-obj-type    as character no-undo .
     1589   define input  parameter p-obj-code    as integer   no-undo .
     1590   define input  parameter p-qnty-doc    as decimal   no-undo .
     1591   define input  parameter p-sum-doc     as decimal   no-undo .
     1592   define input  parameter p-vid-pay        as character no-undo .
     1593   define input  parameter p-cash-pay-type  as character no-undo .
     1594   define input  parameter p-fact-order  as decimal   no-undo .
     1595   define output parameter p-plt-id          as integer   no-undo .
     1596   define output parameter p-plt-db-num      as integer   no-undo .
     1597   define output parameter p-pdf-id          as integer   no-undo .
     1598   define output parameter p-pdf-db-num      as integer   no-undo .
     1599   define output parameter p-sale-price-base as decimal   no-undo .
     1600   define output parameter p-sale-price-rubl as decimal   no-undo .
     1601   define output parameter p-road-tax-base as decimal   no-undo .
     1602   define output parameter p-road-tax-rubl as decimal   no-undo .
     1603   define output parameter p-excise-base   as decimal   no-undo .
     1604   define output parameter p-excise-rubl   as decimal   no-undo .
     1605   define variable v-cli-oborot-ALL as decimal   no-undo .
     1606   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1607   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1608   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1609   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1610   define buffer buf_price-all              for ub.price-all  .
     1611   define buffer buf_goods                  for ub.goods      .
     1612   define buffer buf_global-state           for ub.global-state  .
     1613   define buffer buf_buyer-group            for ub.buyer-group  .
     1614   define buffer buf_turnover-group         for ub.turnover-group  .
     1615   define buffer buf_main-code              for ub.bar-code  .
     1616   define buffer buf_bar-code               for ub.bar-code  .
     1617   define buffer buf_pay-type               for ub.pay-type  .
     1618   define buffer buf_cash-pay               for ub.cash-pay  .
     1619   define variable to-day          as date      no-undo .
     1620   define variable v-base-rate0    as decimal   no-undo .
     1621   define variable v-base-scale0   as decimal   no-undo .
     1622   define variable v-exch-rate0    as decimal   no-undo .
     1623   define variable v-exch-scale0   as decimal   no-undo .
     1624   define variable v-base-rate     as decimal   no-undo .
     1625   define variable v-base-scale    as decimal   no-undo .
     1626   define variable v-exch-rate     as decimal   no-undo .
     1627   define variable v-exch-scale    as decimal   no-undo .
     1628   define variable v-host-code     as integer   no-undo .
     1629   define variable v-curr-abbr     as character no-undo .
     1630   define variable v-grp-name      as character no-undo .
     1631   define variable v-date-1        as date      no-undo .
     1632   define variable v-date-2        as date      no-undo .
     1633   define variable v-interv        as character no-undo .
     1634   define variable v-pay-name      as character no-undo .
     1635   define variable v-cli-oborot    as decimal   no-undo .
     1636   define variable v-trn-pay-code  as integer   no-undo .
     1637   define variable v-cash-pay-curr as integer   no-undo .
     1638   define variable v-cash-pay-code as integer   no-undo .
     1639   do
     1640   on error undo, return error return-value
     1641   :
     1642   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1643   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1644   if p-fact-order = ? then do:
     1645     run fact-order-mpl (
     1646         input   today       ,
     1647         input   p-obj-type  ,
     1648         input   p-obj-code  ,
     1649         output  p-fact-order ).
     1650   end.
     1651   if p-vid-pay <> "" then do:
     1652      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1653      if available buf_pay-type
     1654         then v-trn-pay-code = buf_pay-type.obj-code.
     1655         else v-trn-pay-code =  0.
     1656   end.
     1657   else v-trn-pay-code = 0 .
     1658   if p-cash-pay-type <> "" then do:
     1659      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1660      if available buf_pay-type
     1661         then
     1662           assign
     1663             v-cash-pay-curr = buf_cash-pay.curr-code
     1664             v-cash-pay-code = buf_cash-pay.cdpay-code
     1665           .
     1666         else
     1667           assign
     1668             v-cash-pay-curr = 0
     1669             v-cash-pay-code = 0
     1670             .
     1671   end.
     1672   else
     1673     assign
     1674       v-cash-pay-curr = 0
     1675       v-cash-pay-code = 0
     1676       .
     1677   for each tt_price-all  : delete tt_price-all . end.
     1678   assign
     1679     p-plt-id             = ?
     1680     p-plt-db-num         = ?
     1681     p-pdf-id             = ?
     1682     p-pdf-db-num         = ?
     1683     p-sale-price-base    = ?
     1684     p-sale-price-rubl    = ?
     1685     v-cli-oborot         = 0
     1686   .
     1687   find first buf_global-state no-lock no-error .
     1688   if not available buf_global-state then do:
     1689      message
     1690        "Не заданы параметры ценообразования!"
     1691        view-as alert-box error
     1692      .
     1693      return error return-value .
     1694   end.
     1695   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1697     (input  p-obj-type
     1698     ,input  p-obj-code
     1699     ,output to-day
     1700     )  .
     1701   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1703     (input  p-obj-type
     1704     ,input  p-obj-code
     1705     ,output v-host-code
     1706     )  .
     1707   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1709     (input  v-host-code
     1710     ,input  to-day
     1711     ,output v-base-rate0
     1712     ,output v-base-scale0
     1713     )  .
     1714     v-cli-oborot-ALL  = 0 .
     1715     for each buf_turnover-buyer-main no-lock  where
     1716              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1717              buf_turnover-buyer-main.cli-code = p-cli-code
     1718              :
     1719              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1720     end.
     1721   for each buf_price-all no-lock where
     1722            buf_price-all.obj-type = p-obj-type and
     1723            buf_price-all.obj-code = p-obj-code and
     1724            buf_price-all.gds-code = buf_goods.gds-code and
     1725            buf_price-all.status_  = 'акт':U  and
     1726          ( p-only-b-code = false   or
     1727          ( buf_price-all.b-code = p-main-b-code or
     1728            buf_price-all.b-code = p-b-code))    and
     1729           ( p-only-b-code = true  or
     1730             buf_price-all.b-code = p-b-code)
     1731             and
     1732             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1733           ( buf_price-all.fact-order-sys-to = ? or
     1734             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1735           :
     1736            v-interv   = "" .
     1737            v-grp-name = "" .
     1738            v-pay-name = "" .
     1739            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1740            if buf_price-all.bgr-id > 0 then do:
     1741               find first buf_buyer-group no-lock where
     1742                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1743                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1744               if available buf_buyer-group then do:
     1745                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1746                  find first buf_buyer-in-buyer-group no-lock where
     1747                             buf_buyer-in-buyer-group.stts         = 0 and
     1748                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1749                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1750                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1751                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1752                             no-error .
     1753                             if not available buf_buyer-in-buyer-group then do:
     1754                                v-grp-name = "".
     1755                                next.
     1756                             end.
     1757                             v-grp-name = buf_buyer-group.name .
     1758                  end.
     1759               end.
     1760               else do:
     1761                    v-grp-name = "".
     1762                    next.
     1763               end.
     1764            end.
     1765            if buf_price-all.tog-id > 0 then do:
     1766               find first buf_turnover-group no-lock where
     1767                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1768                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1769               if available buf_turnover-group then do:
     1770                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1771                     v-cli-oborot = v-cli-oborot-all  .
     1772                     find first buf1_tnv-in-turnover-group no-lock where
     1773                                buf1_tnv-in-turnover-group.stts       =  0     and
     1774                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1775                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1776                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1777                     find first buf2_tnv-in-turnover-group no-lock where
     1778                                buf2_tnv-in-turnover-group.stts       =  0     and
     1779                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1780                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1781                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1782                     if not (available buf1_tnv-in-turnover-group and
     1783                             available buf2_tnv-in-turnover-group ) then do:
     1784                             v-grp-name = "".
     1785                             next .
     1786                     end.
     1787                     v-grp-name = buf_turnover-group.name.
     1788                  end.
     1789               end.
     1790               else do:
     1791                    v-grp-name = "".
     1792                    next.
     1793               end.
     1794            end.
     1795            if buf_price-all.plt-fix-cource-crc-base = true then
     1796               assign
     1797                 v-base-rate  = buf_price-all.pdf-base-rate
     1798                 v-base-scale = buf_price-all.pdf-base-scale
     1799               .
     1800               else
     1801               assign
     1802                 v-base-rate  = v-base-rate0
     1803                 v-base-scale = v-base-scale0
     1804               .
     1805            if buf_price-all.plt-fix-cource-crc-doc = true then
     1806               assign
     1807                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1808                 v-exch-scale = buf_price-all.pdf-exch-scale
     1809               .
     1810               else do:
     1811   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1813     (input  buf_price-all.curr-code
     1814     ,input  to-day
     1815     ,output v-exch-rate0
     1816     ,output v-exch-scale0
     1817     ,output v-curr-abbr
     1818     )  .
     1819               assign
     1820                 v-exch-rate  = v-exch-rate0
     1821                 v-exch-scale = v-exch-scale0
     1822                 .
     1823              end.
     1824              v-date-1 = date ( "" )  .
     1825              if buf_price-all.fact-order-sys-from > 0 then do:
     1826                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1827                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1828                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1829              end.
     1830              v-date-2 =  date ( "" )  .
     1831              if buf_price-all.fact-order-sys-to > 0 then do:
     1832                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1833                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1834                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1835              end.
     1836              if buf_price-all.qnty-from <> ? then do :
     1837                 if not (
     1838                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1839                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1840                 ) then do:
     1841                        v-interv = "".
     1842                        next.
     1843                 end.
     1844                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1845              end.
     1846              if buf_price-all.sum-from <> ? then do :
     1847                 if not (
     1848                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1849                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1850                 ) then do:
     1851                    v-interv = "".
     1852                    next.
     1853                 end.
     1854                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1855              end.
     1856              if buf_price-all.turnover-from <> ? then do :
     1857                 if not (
     1858                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1859                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1860                 ) then do:
     1861                    v-interv = "".
     1862                    next.
     1863                 end.
     1864                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1865              end.
     1866              if buf_price-all.use-pay-type = 1 then do :
     1867                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1868                    v-pay-name = "" .
     1869                    next.
     1870                  end.
     1871                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1872              end.
     1873              if buf_price-all.use-cash-pay = 1 then do :
     1874                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1875                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1876                   v-pay-name = "" .
     1877                   next.
     1878                 end.
     1879                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1880              end.
     1881             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1882             create tt_price-all .
     1883             buffer-copy buf_price-all to tt_price-all
     1884             assign
     1885               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1886               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1887               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1888               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1889               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1890               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1891               tt_price-all.price-sale     = buf_price-all.price-sale
     1892               tt_price-all.road-tax       = buf_price-all.road-tax
     1893               tt_price-all.excise         = buf_price-all.excise
     1894               tt_price-all.pdf-exch-rate   = v-exch-rate
     1895               tt_price-all.pdf-exch-scale  = v-exch-scale
     1896               tt_price-all.pdf-base-rate   = v-base-rate
     1897               tt_price-all.pdf-base-scale  = v-base-scale
     1898               tt_price-all.grp-name        = v-grp-name
     1899               tt_price-all.date-1          = v-date-1
     1900               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1901               tt_price-all.time-1          = buf_price-all.start-sys-time
     1902               tt_price-all.date-2          = v-date-2
     1903               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1904               tt_price-all.time-2          = buf_price-all.end-sys-time
     1905               tt_price-all.interv-name     = v-interv
     1906               tt_price-all.pay-name        = v-pay-name
     1907               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1908             .
     1909   end.
     1910   define variable vt-plt-id as integer   no-undo .
     1911   define variable vt-plt-db as integer   no-undo .
     1912   define variable vt-pdf-id as integer   no-undo .
     1913   define variable vt-pdf-db as integer   no-undo .
     1914   define buffer neos_price-all for tt_price-all  .
     1915   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1916       if available tt_price-all then do:
     1917        assign
     1918          vt-plt-id = tt_price-all.plt-id
     1919          vt-plt-db = tt_price-all.plt-db-num
     1920          vt-pdf-id = tt_price-all.pdf-id
     1921          vt-pdf-db = tt_price-all.pdf-db
     1922        .
     1923        if tt_price-all.b-code = p-b-code then do:
     1924             assign
     1925               p-plt-id           = tt_price-all.plt-id
     1926               p-plt-db-num       = tt_price-all.plt-db-num
     1927               p-pdf-id           = tt_price-all.pdf-id
     1928               p-pdf-db-num       = tt_price-all.pdf-db
     1929               p-sale-price-base  = tt_price-all.price-sale-base
     1930               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1931               p-road-tax-base    = tt_price-all.road-tax-base
     1932               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1933               p-excise-base      = tt_price-all.excise-base
     1934               p-excise-rubl      = tt_price-all.excise-rubl
     1935               .
     1936        end.
     1937        else do:
     1938          find first neos_price-all where
     1939                     neos_price-all.b-code     = p-b-code  and
     1940                     neos_price-all.plt-id     = vt-plt-id and
     1941                     neos_price-all.plt-db-num = vt-plt-db and
     1942                     neos_price-all.pdf-id     = vt-pdf-id and
     1943                     neos_price-all.pdf-db     = vt-pdf-db
     1944                     use-index pi no-error .
     1945            if available neos_price-all then do:
     1946             assign
     1947               p-plt-id           = tt_price-all.plt-id
     1948               p-plt-db-num       = tt_price-all.plt-db-num
     1949               p-pdf-id           = tt_price-all.pdf-id
     1950               p-pdf-db-num       = tt_price-all.pdf-db
     1951               p-sale-price-base  = neos_price-all.price-sale-base
     1952               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1953               p-road-tax-base    = neos_price-all.road-tax-base
     1954               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1955               p-excise-base      = neos_price-all.excise-base
     1956               p-excise-rubl      = neos_price-all.excise-rubl
     1957               .
     1958            end.
     1959            else do:
     1960                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1961                 if error-status :error    then do:
     1962                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1963                   return error return-value .
     1964                 end.
     1965             assign
     1966               p-plt-id           = tt_price-all.plt-id
     1967               p-plt-db-num       = tt_price-all.plt-db-num
     1968               p-pdf-id           = tt_price-all.pdf-id
     1969               p-pdf-db-num       = tt_price-all.pdf-db
     1970               p-sale-price-base  = tt_price-all.price-sale-base
     1971               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1972               p-road-tax-base    = tt_price-all.road-tax-base
     1973               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1974               p-excise-base      = tt_price-all.excise-base
     1975               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1976               .
     1977            end.
     1978        end.
     1979     end.
     1980   end.
     1981   end procedure.
     1982   procedure mpl-tpl-auto :
     1983   define input  parameter p-b-code     as integer   no-undo .
     1984   define input  parameter p-obj-type   as character no-undo .
     1985   define input  parameter p-obj-code   as integer   no-undo .
     1986   define input  parameter p-plt-id     as integer   no-undo .
     1987   define input  parameter p-plt-db-num as integer   no-undo .
     1988   define input  parameter p-fact-order as decimal   no-undo .
     1989   define output parameter p-sale-price as decimal   no-undo .
     1990   define output parameter p-pdf-id     as integer   no-undo .
     1991   define output parameter p-pdf-db-num as integer   no-undo .
     1992     do
     1993     on error undo, return error return-value
     1994     :
     1995   if p-fact-order = ? then do:
     1996     run fact-order-mpl (
     1997         input   today       ,
     1998         input   p-obj-type  ,
     1999         input   p-obj-code  ,
     2000         output  p-fact-order ) .
     2001   end.
     2002   assign
     2003     p-pdf-id      = ?
     2004     p-pdf-db-num  = ?
     2005     p-sale-price  = ?
     2006   .
     2007   define buffer buf_bar-code for ub.bar-code  .
     2008   define buffer buf_goods for ub.goods  .
     2009   find first buf_bar-code no-lock where
     2010              buf_bar-code.b-code = p-b-code
     2011              no-error .
     2012   if error-status :error then return error return-value .
     2013   find first buf_goods no-lock where
     2014              buf_goods.gds-code = buf_bar-code.gds-code
     2015              no-error .
     2016   if error-status :error then return error return-value .
     2017   define variable v-main-b-code as integer   no-undo .
     2018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2019     (input  buf_goods.gds-code
     2020     ,input  ?
     2021     ,output v-main-b-code
     2022     )  .
     2023   define buffer buf_price-all for ub.price-all  .
     2024   for each tt_price-all : delete tt_price-all. end.
     2025       for each buf_price-all no-lock where
     2026               buf_price-all.plt-id     = p-plt-id                 and
     2027               buf_price-all.plt-db-num = p-plt-db-num             and
     2028               buf_price-all.obj-type   = p-obj-type               and
     2029               buf_price-all.obj-code   = p-obj-code               and
     2030               buf_price-all.gds-code   = buf_goods.gds-code       and
     2031             ( buf_price-all.b-code = v-main-b-code or
     2032               buf_price-all.b-code = p-b-code)    and
     2033               buf_price-all.status_    = 'акт':U         and
     2034               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2035             ( buf_price-all.fact-order-sys-to = ? or
     2036               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2037               :
     2038                 create tt_price-all .
     2039                 buffer-copy buf_price-all to tt_price-all
     2040                 assign
     2041                   tt_price-all.price-sale  = buf_price-all.price-sale
     2042                 .
     2043       end.
     2044   define variable vt-plt-id as integer   no-undo .
     2045   define variable vt-plt-db as integer   no-undo .
     2046   define variable vt-pdf-id as integer   no-undo .
     2047   define variable vt-pdf-db as integer   no-undo .
     2048   define buffer neos_price-all for tt_price-all  .
     2049   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2050       if available tt_price-all then do:
     2051        assign
     2052          vt-plt-id = tt_price-all.plt-id
     2053          vt-plt-db = tt_price-all.plt-db-num
     2054          vt-pdf-id = tt_price-all.pdf-id
     2055          vt-pdf-db = tt_price-all.pdf-db
     2056        .
     2057        if tt_price-all.b-code = p-b-code then do:
     2058             assign
     2059               p-plt-id           = tt_price-all.plt-id
     2060               p-plt-db-num       = tt_price-all.plt-db-num
     2061               p-pdf-id           = tt_price-all.pdf-id
     2062               p-pdf-db-num       = tt_price-all.pdf-db
     2063               p-sale-price       = tt_price-all.price-sale
     2064               .
     2065        end.
     2066        else do:
     2067          find first neos_price-all where
     2068                     neos_price-all.b-code     = p-b-code  and
     2069                     neos_price-all.plt-id     = vt-plt-id and
     2070                     neos_price-all.plt-db-num = vt-plt-db and
     2071                     neos_price-all.pdf-id     = vt-pdf-id and
     2072                     neos_price-all.pdf-db     = vt-pdf-db
     2073                     use-index pi no-error .
     2074            if available neos_price-all then do:
     2075             assign
     2076               p-plt-id           = tt_price-all.plt-id
     2077               p-plt-db-num       = tt_price-all.plt-db-num
     2078               p-pdf-id           = tt_price-all.pdf-id
     2079               p-pdf-db-num       = tt_price-all.pdf-db
     2080               p-sale-price       = neos_price-all.price-sale
     2081               .
     2082            end.
     2083            else do:
     2084           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2085           if error-status :error    then do:
     2086              message "Не найден бар-код" p-b-code view-as alert-box error .
     2087              return error return-value .
     2088           end.
     2089             assign
     2090               p-plt-id           = tt_price-all.plt-id
     2091               p-plt-db-num       = tt_price-all.plt-db-num
     2092               p-pdf-id           = tt_price-all.pdf-id
     2093               p-pdf-db-num       = tt_price-all.pdf-db
     2094               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2095               .
     2096            end.
     2097        end.
     2098     end.
     2099     end.
     2100   end procedure.
     2101   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2102   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2103   procedure wthcattr-sprcli :
     2104   define input parameter parparentproc  as widget-handle no-undo.
     2105   define input parameter p-mode  as character no-undo.
     2106   define input-output parameter p-value as character no-undo .
     2107   define output parameter p-setted as logical no-undo .
     2108     DEFINE VARIABLE v-value as character no-undo .
     2109     define variable v-cli-type as character no-undo .
     2110     define variable v-cli-code as integer no-undo .
     2111     define buffer buf_clients   for ub.clients.
     2112     define variable v_rid as character no-undo.
     2113     define variable ref-rec as recid no-undo .
     2114     do
     2115     on error undo, return error
     2116     :
     2117         v-value = p-value.
     2118      if p-value <> '':U then do:
     2119       assign
     2120       v-cli-type = substring(p-value, 1, 3)
     2121       v-cli-code = integer(substring(p-value, 4))
     2122       no-error.
     2123       if error-status:error then do:
     2124         assign
     2125         v-cli-type = '':U
     2126         v-cli-code = 0
     2127         .
     2128       end.
     2129      end.
     2130      FIND FIRST buf_clients NO-LOCK WHERE
     2131               buf_clients.obj-type = v-cli-type AND
     2132               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2133      IF available(buf_clients) then do:
     2134       run ref/cli-all.w (
     2135                   input parparentproc
     2136                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2137                  ,input v-cli-type
     2138                  ,input 'все':U
     2139                  ,input 'все':U
     2140                  ,input RECID( buf_clients )
     2141                  ,input ",,,,,,NO"
     2142                  ,input ?
     2143                  ,OUTPUT v_rid ).
     2144     END.
     2145     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2146       run ref/cli-all.w (
     2147                    input parparentproc
     2148                   ,INPUT "b-sel":U
     2149                  ,input  v-cli-type
     2150                  ,input 'все':U
     2151                  ,input 'текущие':U
     2152                  ,input ?
     2153                  ,input ",,,,,,NO"
     2154                  ,input ?
     2155                  ,OUTPUT v_rid ).
     2156     END.
     2157     else do:
     2158       message
     2159       if p-value = "":U then 'Атрибут не задан!'
     2160       else substitute('Не найден клиент &1',p-value)
     2161       view-as alert-box warning.
     2162     end.
     2163     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2164       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2165       IF ERROR-STATUS:ERROR THEN DO:
     2166           RETURN NO-APPLY.
     2167       END.
     2168       FIND FIRST buf_clients NO-LOCK WHERE
     2169                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2170       IF AVAIL buf_clients THEN DO:
     2171         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2172       end.
     2173     end.
     2174     if v-value <> p-value then do:
     2175       p-value = v-value.
     2176       p-setted = yes.
     2177     end.
     2178     end.
     2179   end procedure.
     2180     define new global shared variable g#wthcalib as handle no-undo.
     2181   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     2182   define variable v-tth as handle no-undo .
     2183   assign
     2184   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2185   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     2186   Procedure wth-doc-close:
     2187       define input parameter p-rec        as recid     no-undo .
     2188       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2189     do
     2190     on error undo, return error return-value
     2191     :
     2192       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     2193       if not available cur-wth-parts then return error substitute("Не найдена партия").
     2194       CASE cur-wth-parts.ext-doc-type:
     2195           WHEN 'ie':U or when 'rf':U or when 'ff':U
     2196           OR WHEN 'fj':U
     2197           THEN DO:
     2198              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     2199           END.
     2200           WHEN 'ee':U THEN DO:
     2201               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2202           END.
     2203           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     2204             OR WHEN 'ip':U OR WHEN 'pc':U
     2205             OR WHEN 'pj':U
     2206              THEN DO:
     2207               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2208           END.
     2209           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     2210             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     2211           end.
     2212           when 'ep':U or when 'ef':U
     2213           OR WHEN 'oj':U or when 'jj':U
     2214           then .
     2215           when 'xc':U then do:
     2216             if cur-wth-parts.type = 'при':U then
     2217                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2218             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2219           end.
     2220           OTHERWISE DO:
     2221               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     2222                                    , cur-wth-parts.ext-doc-type
     2223                                       ).
     2224           END.
     2225       END CASE.
     2226       RELEASE cur-wth-parts.
     2227       END.
     2228   END.
     2229   PROCEDURE wth-parts-close:
     2230       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2231       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2232       define variable v-rec as recid.
     2233       if bfrom_wth-parts.stts  = 1 then return.
     2234          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     2235                     INPUT     bfrom_wth-parts.obj-type,
     2236                     INPUT     bfrom_wth-parts.obj-code,
     2237                     INPUT     bfrom_wth-parts.w-p-code,
     2238                     INPUT     bfrom_wth-parts.wth-code,
     2239                     INPUT     bfrom_wth-parts.par-code,
     2240                     INPUT     bfrom_wth-parts.in-code ,
     2241                     INPUT     p-zone,
     2242                     INPUT     bfrom_wth-parts.ser-code,
     2243                     INPUT     bfrom_wth-parts.db-num  ,
     2244                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2245                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2246                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2247                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     2248                     INPUT     bfrom_wth-parts.host-code     ,
     2249                     INPUT     bfrom_wth-parts.contract-code               ,
     2250                     INPUT     bfrom_wth-parts.price-rubl    ,
     2251                     INPUT     bfrom_wth-parts.price-base    ,
     2252                     INPUT     bfrom_wth-parts.supp-type,
     2253                     INPUT     bfrom_wth-parts.supp-code,
     2254                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2255                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2256                     INPUT     bfrom_wth-parts.ext-doc-type,
     2257                     INPUT     bfrom_wth-parts.gds-code,
     2258                     INPUT     bfrom_wth-parts.stts               ,
     2259                     INPUT     bfrom_wth-parts.beg-dt        ,
     2260                     INPUT     bfrom_wth-parts.end-dt        ,
     2261                     INPUT     bfrom_wth-parts.vat-pc        ,
     2262                     INPUT     bfrom_wth-parts.cli-code,
     2263                     INPUT     bfrom_wth-parts.cli-type,
     2264                     INPUT     bfrom_wth-parts.out-obj-code,
     2265                     INPUT     bfrom_wth-parts.out-obj-type,
     2266                     INPUT     bfrom_wth-parts.sale-obj-code,
     2267                     INPUT     bfrom_wth-parts.sale-obj-type,
     2268                     INPUT     bfrom_wth-parts.out-code ,
     2269                     INPUT  yes,
     2270                     INPUT     '':U ,
     2271                     INPUT-OUTPUT v-rec
     2272                     ) no-error.
     2273       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2274   END.
     2275   Procedure wth-doc-razrez:
     2276       define input parameter p-rec as recid NO-UNDO.
     2277       define input parameter p-doc-del AS log NO-UNDO.
     2278       define variable v-mess AS CHAR NO-UNDO.
     2279       define variable p-silent AS LOG INIT NO NO-UNDO.
     2280       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     2281       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2282       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     2287                                 EXCLUSIVE-LOCK .
     2288       IF AVAILABLE cur-wth-parts THEN DO:
     2289           CASE cur-wth-parts.ext-doc-type:
     2290               WHEN 'ie':U or when 'ip':U or when 'rp':U
     2291               or when 'ff':U or when 'rf':U
     2292               or when 'fj':U or when 'pj':U
     2293               THEN DO:
     2294                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     2295               END.
     2296               WHEN 'ee':U or when 'ef':U or when 'jj':U
     2297               THEN DO:
     2298                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     2299               END.
     2300               WHEN 'ep':U or when 'oj':U THEN DO:
     2301                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     2302               END.
     2303               WHEN 'pc':U THEN DO:
     2304                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2305               END.
     2306               WHEN 'dp':U THEN DO:
     2307                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     2308               END.
     2309               WHEN 'df':U THEN DO:
     2310                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     2311               END.
     2312               WHEN 'dc':U THEN DO:
     2313                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2314               END.
     2315               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     2316                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     2317               END.
     2318               when 'xc':U then do:
     2319                 if cur-wth-parts.type = 'при':U then
     2320                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     2321                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     2322               end.
     2323               OTHERWISE DO:
     2324                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     2325                                        , cur-wth-parts.ext-doc-type
     2326                                        , error-status:get-message(1)
     2327                                        , return-value
     2328                                        ).
     2329               END.
     2330           END CASE.
     2331       END.
     2332     END.
     2333   END.
     2334   PROCEDURE wth-parts-raz:
     2335       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2336       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2337       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     2338       define variable v-mes as char no-undo.
     2339       define variable v-rec as recid no-undo.
     2340       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     2345                                      ,bfrom_wth-parts.ser-code
     2346                                      ,bfrom_wth-parts.db-num
     2347                                      ,bfrom_wth-parts.doc-rangeFrom
     2348                                      ,bfrom_wth-parts.doc-rangeTo).
     2349       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     2350           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     2351                                , error-status:get-message(1)
     2352                                , bfrom_wth-parts.out-code
     2353                                , return-value
     2354                                ,chr(10)
     2355                                ,v-mes
     2356                                ).
     2357       END.
     2358       v-rec = recid(bfrom_wth-parts).
     2359       CASE bfrom_wth-parts.ext-doc-type:
     2360           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     2361               delete bfrom_wth-parts NO-ERROR.
     2362               if error-status:error then do:
     2363                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2364                                      , error-status:get-message(1)
     2365                                      , chr(10)
     2366                                      , return-value
     2367                                      ,v-mes
     2368                                      ).
     2369               END.
     2370           END.
     2371           when 'rp':U or when 'rf':U then do:
     2372             if p-doc-del then do:
     2373               delete bfrom_wth-parts NO-ERROR.
     2374               if error-status:error then do:
     2375                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2376                                      , error-status:get-message(1)
     2377                                      , chr(10)
     2378                                      , return-value
     2379                                      ,v-mes
     2380                                      ).
     2381               END.
     2382             end.
     2383             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     2384           end.
     2385           when 'ip':U or when 'ff':U then do:
     2386             if p-doc-del then do:
     2387               delete bfrom_wth-parts NO-ERROR.
     2388               if error-status:error then do:
     2389                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2390                                      , error-status:get-message(1)
     2391                                      , chr(10)
     2392                                      , return-value
     2393                                      ,v-mes
     2394                                      ).
     2395               END.
     2396             end.
     2397             else do:
     2398               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2399                     INPUT     bfrom_wth-parts.obj-type,
     2400                     INPUT     bfrom_wth-parts.obj-code,
     2401                     INPUT     bfrom_wth-parts.w-p-code,
     2402                     INPUT     bfrom_wth-parts.wth-code,
     2403                     INPUT     bfrom_wth-parts.par-code,
     2404                     INPUT     bfrom_wth-parts.in-code ,
     2405                     INPUT     bfrom_wth-parts.out-code,
     2406                     INPUT     bfrom_wth-parts.ser-code,
     2407                     INPUT     bfrom_wth-parts.db-num  ,
     2408                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2409                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2410                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     2411                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     2412                     INPUT     bfrom_wth-parts.host-code     ,
     2413                     INPUT     bfrom_wth-parts.contract-code ,
     2414                     INPUT     bfrom_wth-parts.price-rubl    ,
     2415                     INPUT     bfrom_wth-parts.price-base    ,
     2416                     INPUT     bfrom_wth-parts.supp-type,
     2417                     INPUT     bfrom_wth-parts.supp-code,
     2418                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2419                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2420                     INPUT     bfrom_wth-parts.ext-doc-type,
     2421                     INPUT     bfrom_wth-parts.gds-code,
     2422                     INPUT     1            ,
     2423                     INPUT     bfrom_wth-parts.beg-dt        ,
     2424                     INPUT     bfrom_wth-parts.end-dt        ,
     2425                     INPUT     bfrom_wth-parts.vat-pc        ,
     2426                     INPUT     bfrom_wth-parts.cli-code,
     2427                     INPUT     bfrom_wth-parts.cli-type,
     2428                     INPUT     bfrom_wth-parts.out-obj-code,
     2429                     INPUT     bfrom_wth-parts.out-obj-type,
     2430                     INPUT     bfrom_wth-parts.sale-obj-code,
     2431                     INPUT     bfrom_wth-parts.sale-obj-type,
     2432                     INPUT     bfrom_wth-parts.doc-code ,
     2433                     INPUT  yes,
     2434                     INPUT     bfrom_wth-parts.type ,
     2435                     INPUT-OUTPUT v-rec
     2436                     ) no-error.
     2437                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2438             end.
     2439           end.
     2440           OTHERWISE DO:
     2441            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2442                     INPUT     bfrom_wth-parts.obj-type,
     2443                     INPUT     bfrom_wth-parts.obj-code,
     2444                     INPUT     bfrom_wth-parts.w-p-code,
     2445                     INPUT     bfrom_wth-parts.wth-code,
     2446                     INPUT     bfrom_wth-parts.par-code,
     2447                     INPUT     bfrom_wth-parts.in-code ,
     2448                     INPUT     p-zone,
     2449                     INPUT     bfrom_wth-parts.ser-code,
     2450                     INPUT     bfrom_wth-parts.db-num  ,
     2451                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2452                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2453                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2454                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2455                     INPUT     bfrom_wth-parts.host-code     ,
     2456                     INPUT     bfrom_wth-parts.contract-code ,
     2457                     INPUT     bfrom_wth-parts.price-rubl    ,
     2458                     INPUT     bfrom_wth-parts.price-base    ,
     2459                     INPUT     bfrom_wth-parts.supp-type,
     2460                     INPUT     bfrom_wth-parts.supp-code,
     2461                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2462                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2463                     INPUT     bfrom_wth-parts.ext-doc-type,
     2464                     INPUT     bfrom_wth-parts.gds-code,
     2465                     INPUT     bfrom_wth-parts.stts             ,
     2466                     INPUT     bfrom_wth-parts.beg-dt        ,
     2467                     INPUT     bfrom_wth-parts.end-dt        ,
     2468                     INPUT     bfrom_wth-parts.vat-pc        ,
     2469                     INPUT     bfrom_wth-parts.cli-code,
     2470                     INPUT     bfrom_wth-parts.cli-type,
     2471                     INPUT     bfrom_wth-parts.out-obj-code,
     2472                     INPUT     bfrom_wth-parts.out-obj-type,
     2473                     INPUT     bfrom_wth-parts.sale-obj-code,
     2474                     INPUT     bfrom_wth-parts.sale-obj-type,
     2475                     INPUT     bfrom_wth-parts.doc-code ,
     2476                     INPUT  yes,
     2477                     INPUT      "":U ,
     2478                     INPUT-OUTPUT v-rec
     2479                     ) no-error.
     2480       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2481           END.
     2482       END CASE.
     2483     END.
     2484   END.
     2485   procedure wth-parts-rezerv:
     2486       define input parameter        p-param            as logical no-undo.
     2487       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2488       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2489       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2490       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2491       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2492       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2493       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2494       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2495       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2496       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2497       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2498       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2499       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2500       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2501       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2502       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2503       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2504       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2505       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2506       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2507       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2508       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2509       define input-output parameter p-rec        as recid     no-undo .
     2510     define buffer bfrom_wth-parts   for ub.wth-parts.
     2511     define buffer bufr_wth-doc      for ub.wth-doc.
     2512     define variable v-rec    as recid        no-undo.
     2513     define variable v-recDop as recid        no-undo.
     2514     define variable v-zone   as character    no-undo.
     2515     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2516     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2517     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2518     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2519     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2520     define variable v-mpl-date         as date      no-undo.
     2521     empty temp-table tt-wthlib-parts.
     2522   main-block:
     2523   do  transaction
     2524   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2525   on stop   undo main-block, return error
     2526   on endkey undo main-block, return error
     2527   :
     2528   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2529   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2530     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2531           then do:
     2532        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2533                     INPUT  p-obj-type,
     2534                     INPUT  p-obj-code,
     2535                     INPUT  p-w-p-code,
     2536                     INPUT  p-wth-code,
     2537                     INPUT  p-par-code,
     2538                     INPUT  p-in-code,
     2539                     INPUT  p-doc-code,
     2540                     INPUT  p-ser-code,
     2541                     INPUT  p-db-num  ,
     2542                     INPUT  p-Fact-RangeFrom ,
     2543                     INPUT  p-fact-rangeTo  ,
     2544                     INPUT  p-Fact-RangeFrom ,
     2545                     INPUT  p-fact-rangeTo ,
     2546                     INPUT  p-host-code     ,
     2547                     INPUT  0   ,
     2548                     INPUT  p-price-rubl    ,
     2549                     INPUT  p-price-base    ,
     2550                     INPUT  '':U,
     2551                     INPUT  0,
     2552                     INPUT  p-obj-type      ,
     2553                     INPUT  p-obj-code      ,
     2554                     INPUT  p-ext-doc-type,
     2555                     INPUT  p-gds-code,
     2556                     INPUT  0           ,
     2557                     INPUT  p-beg-dt        ,
     2558                     INPUT  p-end-dt        ,
     2559                     INPUT  p-vat-pc      ,
     2560                     INPUT  0,
     2561                     INPUT  '':U,
     2562                     INPUT  0,
     2563                     INPUT  '':U,
     2564                     INPUT  0,
     2565                     INPUT  '':U,
     2566                     INPUT  p-doc-code,
     2567                     INPUT  yes,
     2568                     INPUT p-type,
     2569                     INPUT-OUTPUT p-rec
     2570                     ) no-error.
     2571                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2572     end.
     2573     else do:
     2574       if p-rec <> ? then do:
     2575         find first bfrom_wth-parts exclusive-lock where
     2576                   recid(bfrom_wth-parts) = p-rec no-error.
     2577         if  available bfrom_wth-parts
     2578           and bfrom_wth-parts.wth-code = p-wth-code
     2579           and bfrom_wth-parts.par-code = p-par-code
     2580           and bfrom_wth-parts.ser-code = p-ser-code
     2581           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2582         then.
     2583         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2584         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2585                                      ,bfrom_wth-parts.ser-code
     2586                                      ,bfrom_wth-parts.db-num
     2587                                      ,bfrom_wth-parts.doc-rangeFrom
     2588                                      ,bfrom_wth-parts.doc-rangeTo).
     2589         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2590         if available bfrom_wth-parts
     2591            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2592            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2593         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2594                                            ,chr(10)
     2595                                            ,bfrom_wth-parts.doc-rangeFrom
     2596                                            ,bfrom_wth-parts.doc-rangeTo
     2597                                            ,p-fact-rangeFrom
     2598                                            ,p-fact-rangeTo).
     2599       end.
     2600       else do:
     2601         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2602           for first bfrom_wth-parts no-lock where
     2603                                     bfrom_wth-parts.wth-code = p-wth-code
     2604                                 and bfrom_wth-parts.par-code = p-par-code
     2605                                 and bfrom_wth-parts.ser-code = p-ser-code
     2606                                 and bfrom_wth-parts.db-num = p-db-num
     2607                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2608                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2609                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2610                                 and bfrom_wth-parts.stts = 0
     2611                                 and bfrom_wth-parts.cli-code = p-cli-code
     2612                                 and bfrom_wth-parts.cli-type = p-cli-type
     2613                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2614                                 use-index  wth-idnt:
     2615                                 p-rec = recid(bfrom_wth-parts).
     2616            end.
     2617           If p-rec = ? and p-in-code > '' then do:
     2618              for first bfrom_wth-parts no-lock where
     2619                                     bfrom_wth-parts.wth-code = p-wth-code
     2620                                 and bfrom_wth-parts.par-code = p-par-code
     2621                                 and bfrom_wth-parts.ser-code = p-ser-code
     2622                                 and bfrom_wth-parts.db-num = p-db-num
     2623                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2624                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2625                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2626                                 and bfrom_wth-parts.stts = 0
     2627                                 and bfrom_wth-parts.cli-code = p-cli-code
     2628                                 and bfrom_wth-parts.cli-type = p-cli-type
     2629                                 use-index  wth-idnt:
     2630                                 p-rec = recid(bfrom_wth-parts).
     2631                 end.
     2632           end.
     2633                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2634                   recid(bfrom_wth-parts) = p-rec no-error.
     2635         end.
     2636         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2637           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2638                                 and bfrom_wth-parts.par-code = p-par-code
     2639                                 and bfrom_wth-parts.ser-code = p-ser-code
     2640                                 and bfrom_wth-parts.db-num = p-db-num
     2641                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2642                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2643                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2644                                 and bfrom_wth-parts.stts = 0
     2645                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2646                                 use-index wth-idnt:
     2647                                 p-rec = recid(bfrom_wth-parts).
     2648            end.
     2649           If p-rec = ? and p-in-code > '' then do:
     2650            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2651                                 and bfrom_wth-parts.par-code = p-par-code
     2652                                 and bfrom_wth-parts.ser-code = p-ser-code
     2653                                 and bfrom_wth-parts.db-num = p-db-num
     2654                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2655                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2656                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2657                                 and bfrom_wth-parts.stts = 0
     2658                                 :
     2659                                 p-rec = recid(bfrom_wth-parts).
     2660            end.
     2661           end.
     2662           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2663                   recid(bfrom_wth-parts) = p-rec no-error.
     2664         end.
     2665         else do:
     2666           CASE p-ext-doc-type:
     2667                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2668                   or when 'jj':U THEN DO:
     2669                       v-zone = 'free-zone':U.
     2670                   END.
     2671                   WHEN 'ep':U or when 'oj':U THEN DO:
     2672                       v-zone = 'put-zone':U.
     2673                   END.
     2674                   WHEN 'df':U THEN DO:
     2675                       v-zone = 'free-zone':U.
     2676                   END.
     2677                   WHEN 'dp':U  THEN DO:
     2678                       v-zone = 'put-zone':U.
     2679                   END.
     2680                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2681                       v-zone = 'cli-zone':U.
     2682                   END.
     2683                   OTHERWISE DO:
     2684                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2685                                            , p-ext-doc-type
     2686                                               ).
     2687                   END.
     2688           END CASE.
     2689           find first bfrom_wth-parts no-lock where
     2690                                     bfrom_wth-parts.wth-code = p-wth-code
     2691                                 and bfrom_wth-parts.obj-code = p-obj-code
     2692                                 and bfrom_wth-parts.obj-type = p-obj-type
     2693                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2694                                 and bfrom_wth-parts.par-code = p-par-code
     2695                                 and bfrom_wth-parts.ser-code = p-ser-code
     2696                                 and bfrom_wth-parts.db-num = p-db-num
     2697                                 and bfrom_wth-parts.out-code = v-zone
     2698                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2699                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2700                                 and bfrom_wth-parts.stts = 0
     2701                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2702                                 no-error.
     2703          If not available bfrom_wth-parts and p-in-code > '' then do:
     2704                  find first bfrom_wth-parts no-lock where
     2705                                     bfrom_wth-parts.wth-code = p-wth-code
     2706                                 and bfrom_wth-parts.obj-code = p-obj-code
     2707                                 and bfrom_wth-parts.obj-type = p-obj-type
     2708                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2709                                 and bfrom_wth-parts.par-code = p-par-code
     2710                                 and bfrom_wth-parts.ser-code = p-ser-code
     2711                                 and bfrom_wth-parts.db-num = p-db-num
     2712                                 and bfrom_wth-parts.out-code = v-zone
     2713                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2714                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2715                                 and bfrom_wth-parts.stts = 0
     2716                                 no-error.
     2717          end.
     2718         end.
     2719       end.
     2720       if not available bfrom_wth-parts then do:
     2721            if g#news then do:
     2722             return error 'forged':U.
     2723            end.
     2724            else
     2725             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2726                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2727                                           p-fact-rangeTo).
     2728       end.
     2729       p-rec = recid(bfrom_wth-parts).
     2730       find current bfrom_wth-parts exclusive-lock.
     2731       create tt-wthlib-parts.
     2732       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2733           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2734                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2735                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2736                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2737                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2738       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2739           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2740               RUN init_prtdate ( INPUT p-obj-type
     2741                                                 ,INPUT p-obj-code
     2742                                                 ,INPUT p-ser-code
     2743                                                 ,INPUT p-db-num
     2744                                                 ,INPUT bufr_wth-doc.doc-date
     2745                                                 ,OUTPUT v-beg-dt
     2746                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2747               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2748           END.
     2749           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2750             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2751                                ,bufr_wth-doc.doc-date
     2752                                , v-beg-dt
     2753                                , output v-mpl-date) no-error.
     2754               RUN INIT_prtprice (
     2755                             p-host-code
     2756                           , p-obj-type
     2757                           , p-obj-code
     2758                           , p-cli-type
     2759                           , p-cli-code
     2760                           , p-wth-code
     2761                           , p-gds-code
     2762                           , p-par-code
     2763                           , v-mpl-date
     2764                           , OUTPUT  v-vat-pc
     2765                           , OUTPUT  v-price-rubl
     2766                           , OUTPUT  v-price-base
     2767                   ) NO-ERROR.
     2768             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2769           END.
     2770       END.
     2771         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2772                     INPUT     p-obj-type,
     2773                     INPUT     p-obj-code,
     2774                     INPUT     p-w-p-code,
     2775                     INPUT     bfrom_wth-parts.wth-code,
     2776                     INPUT     bfrom_wth-parts.par-code,
     2777                     INPUT     bfrom_wth-parts.in-code ,
     2778                     INPUT     p-doc-code,
     2779                     INPUT     bfrom_wth-parts.ser-code,
     2780                     INPUT     bfrom_wth-parts.db-num  ,
     2781                     INPUT     p-Fact-RangeFrom ,
     2782                     INPUT     p-fact-rangeTo  ,
     2783                     INPUT     p-Fact-RangeFrom ,
     2784                     INPUT     p-fact-rangeTo ,
     2785                     INPUT     bfrom_wth-parts.host-code     ,
     2786                     INPUT     bfrom_wth-parts.contract-code               ,
     2787                     INPUT     v-price-rubl ,
     2788                     INPUT     v-price-base  ,
     2789                     INPUT     bfrom_wth-parts.supp-type,
     2790                     INPUT     bfrom_wth-parts.supp-code,
     2791                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2792                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2793                     INPUT     p-ext-doc-type,
     2794                     INPUT     bfrom_wth-parts.gds-code,
     2795                     INPUT     0              ,
     2796                     INPUT     v-beg-dt    ,
     2797                     INPUT     v-end-dt   ,
     2798                     INPUT     v-vat-pc    ,
     2799                     INPUT     bfrom_wth-parts.cli-code,
     2800                     INPUT     bfrom_wth-parts.cli-type,
     2801                     INPUT     bfrom_wth-parts.out-obj-code,
     2802                     INPUT     bfrom_wth-parts.out-obj-type,
     2803                     INPUT     bfrom_wth-parts.sale-obj-code,
     2804                     INPUT     bfrom_wth-parts.sale-obj-type,
     2805                     INPUT     bfrom_wth-parts.doc-code,
     2806                     INPUT     yes,
     2807                     INPUT     p-type,
     2808                     INPUT-OUTPUT p-rec
     2809                     ) no-error.
     2810       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2811       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2812       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2813                     INPUT     tt-wthlib-parts.obj-type,
     2814                     INPUT     tt-wthlib-parts.obj-code,
     2815                     INPUT     tt-wthlib-parts.w-p-code,
     2816                     INPUT     tt-wthlib-parts.wth-code,
     2817                     INPUT     tt-wthlib-parts.par-code,
     2818                     INPUT     tt-wthlib-parts.in-code ,
     2819                     INPUT     tt-wthlib-parts.out-code,
     2820                     INPUT     tt-wthlib-parts.ser-code,
     2821                     INPUT     tt-wthlib-parts.db-num  ,
     2822                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2823                     INPUT     p-fact-rangeFrom - 1  ,
     2824                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2825                     INPUT     p-fact-rangeFrom - 1,
     2826                     INPUT     tt-wthlib-parts.host-code     ,
     2827                     INPUT     tt-wthlib-parts.contract-code               ,
     2828                     INPUT     tt-wthlib-parts.price-rubl    ,
     2829                     INPUT     tt-wthlib-parts.price-base    ,
     2830                     INPUT     tt-wthlib-parts.supp-type,
     2831                     INPUT     tt-wthlib-parts.supp-code,
     2832                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2833                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2834                     INPUT     tt-wthlib-parts.ext-doc-type,
     2835                     INPUT     tt-wthlib-parts.gds-code,
     2836                     INPUT     tt-wthlib-parts.stts               ,
     2837                     INPUT     tt-wthlib-parts.beg-dt        ,
     2838                     INPUT     tt-wthlib-parts.end-dt        ,
     2839                     INPUT     tt-wthlib-parts.vat-pc        ,
     2840                     INPUT     tt-wthlib-parts.cli-code,
     2841                     INPUT     tt-wthlib-parts.cli-type,
     2842                     INPUT     tt-wthlib-parts.out-obj-code,
     2843                     INPUT     tt-wthlib-parts.out-obj-type,
     2844                     INPUT     tt-wthlib-parts.sale-obj-code,
     2845                     INPUT     tt-wthlib-parts.sale-obj-type,
     2846                     INPUT     tt-wthlib-parts.doc-code,
     2847                     INPUT  yes,
     2848                     INPUT    tt-wthlib-parts.type,
     2849                     INPUT-OUTPUT v-recDop
     2850                     ) no-error.
     2851       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2852       end.
     2853       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2854               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2855                     INPUT     tt-wthlib-parts.obj-type,
     2856                     INPUT     tt-wthlib-parts.obj-code,
     2857                     INPUT     tt-wthlib-parts.w-p-code,
     2858                     INPUT     tt-wthlib-parts.wth-code,
     2859                     INPUT     tt-wthlib-parts.par-code,
     2860                     INPUT     tt-wthlib-parts.in-code ,
     2861                     INPUT     tt-wthlib-parts.out-code,
     2862                     INPUT     tt-wthlib-parts.ser-code,
     2863                     INPUT     tt-wthlib-parts.db-num  ,
     2864                     INPUT     p-fact-rangeTo + 1 ,
     2865                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2866                     INPUT     p-fact-rangeTo + 1 ,
     2867                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2868                     INPUT     tt-wthlib-parts.host-code     ,
     2869                     INPUT     tt-wthlib-parts.contract-code               ,
     2870                     INPUT     tt-wthlib-parts.price-rubl    ,
     2871                     INPUT     tt-wthlib-parts.price-base    ,
     2872                     INPUT     tt-wthlib-parts.supp-type,
     2873                     INPUT     tt-wthlib-parts.supp-code,
     2874                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2875                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2876                     INPUT     tt-wthlib-parts.ext-doc-type,
     2877                     INPUT     tt-wthlib-parts.gds-code,
     2878                     INPUT     tt-wthlib-parts.stts               ,
     2879                     INPUT     tt-wthlib-parts.beg-dt        ,
     2880                     INPUT     tt-wthlib-parts.end-dt        ,
     2881                     INPUT     tt-wthlib-parts.vat-pc        ,
     2882                     INPUT     tt-wthlib-parts.cli-code,
     2883                     INPUT     tt-wthlib-parts.cli-type,
     2884                     INPUT     tt-wthlib-parts.out-obj-code,
     2885                     INPUT     tt-wthlib-parts.out-obj-type,
     2886                     INPUT     tt-wthlib-parts.sale-obj-code,
     2887                     INPUT     tt-wthlib-parts.sale-obj-type,
     2888                     INPUT     tt-wthlib-parts.doc-code,
     2889                     INPUT     yes,
     2890                     INPUT     tt-wthlib-parts.type,
     2891                     INPUT-OUTPUT v-recDop
     2892                     ) no-error.
     2893         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2894       end.
     2895     end.
     2896   end.
     2897   end procedure.
     2898   procedure wth-parts-inter-edit:
     2899     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2900     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2901     define input-output parameter p-rec        as recid     no-undo .
     2902     define buffer bfrom_wth-parts   for ub.wth-parts.
     2903     define variable v-recDop as recid        no-undo.
     2904     do on error undo, return error:
     2905         find first bfrom_wth-parts exclusive-lock where
     2906                   recid(bfrom_wth-parts) = p-rec no-error.
     2907         if not available bfrom_wth-parts then return error
     2908           substitute('Не найдена партия (recid &1)', p-rec).
     2909         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2910            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2911            return error 'Нельзя увеличивать границы диапазона.'.
     2912         end.
     2913         empty temp-table tt-wthlib-parts.
     2914         create tt-wthlib-parts.
     2915         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2916         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2917                     INPUT     bfrom_wth-parts.obj-type,
     2918                     INPUT     bfrom_wth-parts.obj-code,
     2919                     INPUT     bfrom_wth-parts.w-p-code,
     2920                     INPUT     bfrom_wth-parts.wth-code,
     2921                     INPUT     bfrom_wth-parts.par-code,
     2922                     INPUT     bfrom_wth-parts.in-code ,
     2923                     INPUT     bfrom_wth-parts.doc-code,
     2924                     INPUT     bfrom_wth-parts.ser-code,
     2925                     INPUT     bfrom_wth-parts.db-num  ,
     2926                     INPUT     p-Fact-RangeFrom ,
     2927                     INPUT     p-fact-rangeTo  ,
     2928                     INPUT     p-Fact-RangeFrom ,
     2929                     INPUT     p-fact-rangeTo ,
     2930                     INPUT     bfrom_wth-parts.host-code     ,
     2931                     INPUT     bfrom_wth-parts.contract-code               ,
     2932                     INPUT     bfrom_wth-parts.price-rubl  ,
     2933                     INPUT     bfrom_wth-parts.price-base    ,
     2934                     INPUT     bfrom_wth-parts.supp-type,
     2935                     INPUT     bfrom_wth-parts.supp-code,
     2936                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2937                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2938                     INPUT     bfrom_wth-parts.ext-doc-type,
     2939                     INPUT     bfrom_wth-parts.gds-code,
     2940                     INPUT     0              ,
     2941                     INPUT     bfrom_wth-parts.beg-dt      ,
     2942                     INPUT     bfrom_wth-parts.end-dt      ,
     2943                     INPUT     bfrom_wth-parts.vat-pc      ,
     2944                     INPUT     bfrom_wth-parts.cli-code,
     2945                     INPUT     bfrom_wth-parts.cli-type,
     2946                     INPUT     bfrom_wth-parts.out-obj-code,
     2947                     INPUT     bfrom_wth-parts.out-obj-type,
     2948                     INPUT     bfrom_wth-parts.sale-obj-code,
     2949                     INPUT     bfrom_wth-parts.sale-obj-type,
     2950                     INPUT     bfrom_wth-parts.doc-code,
     2951                     INPUT     yes,
     2952                     INPUT     bfrom_wth-parts.type,
     2953                     INPUT-OUTPUT p-rec
     2954                     ) no-error.
     2955       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2956       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2957       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2958                     INPUT     tt-wthlib-parts.obj-type,
     2959                     INPUT     tt-wthlib-parts.obj-code,
     2960                     INPUT     tt-wthlib-parts.w-p-code,
     2961                     INPUT     tt-wthlib-parts.wth-code,
     2962                     INPUT     tt-wthlib-parts.par-code,
     2963                     INPUT     tt-wthlib-parts.in-code ,
     2964                     INPUT     tt-wthlib-parts.out-code,
     2965                     INPUT     tt-wthlib-parts.ser-code,
     2966                     INPUT     tt-wthlib-parts.db-num  ,
     2967                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2968                     INPUT     p-fact-rangeFrom - 1  ,
     2969                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2970                     INPUT     p-fact-rangeFrom - 1,
     2971                     INPUT     tt-wthlib-parts.host-code     ,
     2972                     INPUT     tt-wthlib-parts.contract-code               ,
     2973                     INPUT     tt-wthlib-parts.price-rubl    ,
     2974                     INPUT     tt-wthlib-parts.price-base    ,
     2975                     INPUT     tt-wthlib-parts.supp-type,
     2976                     INPUT     tt-wthlib-parts.supp-code,
     2977                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2978                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2979                     INPUT     tt-wthlib-parts.ext-doc-type,
     2980                     INPUT     tt-wthlib-parts.gds-code,
     2981                     INPUT     1             ,
     2982                     INPUT     tt-wthlib-parts.beg-dt        ,
     2983                     INPUT     tt-wthlib-parts.end-dt        ,
     2984                     INPUT     tt-wthlib-parts.vat-pc        ,
     2985                     INPUT     tt-wthlib-parts.cli-code,
     2986                     INPUT     tt-wthlib-parts.cli-type,
     2987                     INPUT     tt-wthlib-parts.out-obj-code,
     2988                     INPUT     tt-wthlib-parts.out-obj-type,
     2989                     INPUT     tt-wthlib-parts.sale-obj-code,
     2990                     INPUT     tt-wthlib-parts.sale-obj-type,
     2991                     INPUT     tt-wthlib-parts.doc-code,
     2992                     INPUT  yes,
     2993                     INPUT    tt-wthlib-parts.type,
     2994                     INPUT-OUTPUT v-recDop
     2995                     ) no-error.
     2996       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2997       end.
     2998       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2999               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     3000                     INPUT     tt-wthlib-parts.obj-type,
     3001                     INPUT     tt-wthlib-parts.obj-code,
     3002                     INPUT     tt-wthlib-parts.w-p-code,
     3003                     INPUT     tt-wthlib-parts.wth-code,
     3004                     INPUT     tt-wthlib-parts.par-code,
     3005                     INPUT     tt-wthlib-parts.in-code ,
     3006                     INPUT     tt-wthlib-parts.out-code,
     3007                     INPUT     tt-wthlib-parts.ser-code,
     3008                     INPUT     tt-wthlib-parts.db-num  ,
     3009                     INPUT     p-fact-rangeTo + 1 ,
     3010                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     3011                     INPUT     p-fact-rangeTo + 1 ,
     3012                     INPUT     tt-wthlib-parts.fact-rangeTo,
     3013                     INPUT     tt-wthlib-parts.host-code     ,
     3014                     INPUT     tt-wthlib-parts.contract-code               ,
     3015                     INPUT     tt-wthlib-parts.price-rubl    ,
     3016                     INPUT     tt-wthlib-parts.price-base    ,
     3017                     INPUT     tt-wthlib-parts.supp-type,
     3018                     INPUT     tt-wthlib-parts.supp-code,
     3019                     INPUT     tt-wthlib-parts.in-obj-type      ,
     3020                     INPUT     tt-wthlib-parts.in-obj-code      ,
     3021                     INPUT     tt-wthlib-parts.ext-doc-type,
     3022                     INPUT     tt-wthlib-parts.gds-code,
     3023                     INPUT     1             ,
     3024                     INPUT     tt-wthlib-parts.beg-dt        ,
     3025                     INPUT     tt-wthlib-parts.end-dt        ,
     3026                     INPUT     tt-wthlib-parts.vat-pc        ,
     3027                     INPUT     tt-wthlib-parts.cli-code,
     3028                     INPUT     tt-wthlib-parts.cli-type,
     3029                     INPUT     tt-wthlib-parts.out-obj-code,
     3030                     INPUT     tt-wthlib-parts.out-obj-type,
     3031                     INPUT     tt-wthlib-parts.sale-obj-code,
     3032                     INPUT     tt-wthlib-parts.sale-obj-type,
     3033                     INPUT     tt-wthlib-parts.doc-code,
     3034                     INPUT     yes,
     3035                     INPUT     tt-wthlib-parts.type,
     3036                     INPUT-OUTPUT v-recDop
     3037                     ) no-error.
     3038         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3039         end.
     3040     end.
     3041   end procedure.
     3042   PROCEDURE INIT_prtdate:
     3043       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     3044       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     3045       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     3046       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     3047       define input parameter        p-date                AS DATE no-undo .
     3048       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     3049       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     3050       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     3051       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     3052       define variable v-value-character as character no-undo .
     3053       define variable v-value-date as date no-undo .
     3054       define variable v-value-decimal as decimal no-undo .
     3055       define variable v-value-integer as INTEGER no-undo .
     3056       define variable v-value-logical AS LOGICAL no-undo .
     3057       define variable v-param-type as character no-undo .
     3058       FIND FIRST buf_wth-ser NO-LOCK
     3059           WHERE buf_wth-ser.ser-code = p-ser-code
     3060           AND buf_wth-ser.db-num = p-db-num.
     3061       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     3062           p-beg-dt = buf_wth-ser.beg-dt.
     3063       END.
     3064       IF buf_wth-ser.chk-edt = 2 THEN DO:
     3065           p-end-dt = buf_wth-ser.end-dt.
     3066       END.
     3067       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     3068           run adm/shattri.p (
     3069               input "get":U
     3070               ,input  p-obj-type
     3071               ,input  p-obj-code
     3072               ,input  'wthdoc_obj':U
     3073               ,input  'rangerule':U
     3074               ,output v-value-character
     3075               ,output v-value-date
     3076               ,output v-value-decimal
     3077               ,output v-value-integer
     3078               ,output v-value-logical
     3079               ,output v-param-type
     3080               ,INPUT-OUTPUT table-handle v-tth
     3081               ) no-error .
     3082           IF not error-status:error  then do:
     3083               v-rangeRule =  v-value-integer.
     3084           END.
     3085           CASE v-rangeRule:
     3086           WHEN 1 THEN DO:
     3087               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     3088                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     3089               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     3090                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     3091               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     3092                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     3093           END.
     3094           when 2 then do:
     3095             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     3096                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     3097             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     3098                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     3099                        .
     3100           end.
     3101           WHEN 3 THEN DO:
     3102               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     3103                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     3104               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     3105                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     3106               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     3107                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     3108               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     3109                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     3110           END.
     3111           when 4 then do:
     3112                p-beg-dt = p-date.
     3113                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     3114           end.
     3115           END CASE.
     3116       END.
     3117   END.
     3118   PROCEDURE INIT_prtprice:
     3119   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     3120   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     3121   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     3122   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     3123   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     3124   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     3125   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     3126   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     3127   define input parameter        p-date                AS DATE no-undo .
     3128   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     3129   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     3130   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     3131   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     3132   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     3133   DEF VAR v-cash-type-pay AS CHAR no-undo.
     3134   define variable p-plt-id AS INT no-undo.
     3135   define variable  p-plt-db-num   AS INT no-undo.
     3136   define variable  p-pdf-id  AS INT no-undo.
     3137   define variable  p-pdf-db-num AS INT no-undo.
     3138   define variable  p-sale-price-base AS DEC no-undo.
     3139   define variable  p-sale-price-rubl AS DEC no-undo.
     3140   define variable  p-road-tax-base AS DEC no-undo.
     3141   define variable  p-road-tax-rubl AS DEC no-undo.
     3142   define variable  p-excise-base AS DEC no-undo.
     3143   define variable  p-excise-rubl AS DEC no-undo.
     3144   define variable  p-fact-order  AS DEC no-undo.
     3145   do on error undo, return error return-value :
     3146     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     3147                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     3148     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     3149     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     3150     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     3151     ELSE v-cash-type-pay = ?.
     3152     run fact-order-mpl (
     3153         INPUT p-date ,
     3154         INPUT p-obj-type ,
     3155         INPUT p-obj-code ,
     3156         OUTPUT p-fact-order
     3157         ) no-error .
     3158     if error-status:error then do:
     3159       message   return-value skip error-status:get-message(1)
     3160       skip  'Получение цены из множественного прайс-листа отклонено.'
     3161       view-as alert-box.
     3162       return.
     3163     end.
     3164   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3166     (input  p-gds-code
     3167     ,input  '1':U
     3168     ,input  ?
     3169     ,input  p-host-code
     3170     ,input  p-obj-type
     3171     ,input  p-obj-code
     3172     ,output p-vat-pc
     3173     ) no-error .
     3174     run mpl-autoprice in this-procedure
     3175       ( input    false
     3176         ,input   p-cli-type
     3177         ,input   p-cli-code
     3178         ,input   p-gds-code
     3179         ,input   p-gds-code
     3180         ,input   p-obj-type
     3181         ,input   p-obj-code
     3182         ,input   0
     3183         ,input   0
     3184         ,input   ""
     3185         ,input   v-cash-type-pay
     3186         ,input   p-fact-order
     3187         ,output  p-plt-id
     3188         ,output  p-plt-db-num
     3189         ,output  p-pdf-id
     3190         ,output  p-pdf-db-num
     3191         ,output  p-sale-price-base
     3192         ,output  p-sale-price-rubl
     3193         ,output  p-road-tax-base
     3194         ,output  p-road-tax-rubl
     3195         ,output  p-excise-base
     3196         ,output  p-excise-rubl
     3197         ) no-error .
     3198     if error-status:error then do:
     3199       message   return-value skip error-status:get-message(1) view-as alert-box.
     3200       return.
     3201     end.
     3202     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     3203     p-price-base = p-sale-price-base * b-wth-par.par-val.
     3204   end.
     3205   END.
     3206   procedure  set-wthmpl-date:
     3207   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     3208   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     3209   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     3210   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     3211   define variable v-atrValue      as character no-undo .
     3212   define variable v-atrDsf      as CHARACTER no-undo .
     3213   define variable v-atrType     as character no-undo .
     3214   do on error undo, return error return-value :
     3215   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3216                           input 'wthdsf':U ,
     3217                          output v-atrValue ,
     3218                          output v-atrType )  .
     3219     p-date = date(v-atrValue) no-error.
     3220     if p-date = ? then p-date = p-beg-dt no-error.
     3221     if p-date = ? then p-date = p-doc-date.
     3222   end.
     3223   end procedure.
     3224   define temp-table tt-parts-cli    no-undo like ub.arh-wth-cli
     3225    .
     3226   define temp-table tt-parts-cli-tot    no-undo like ub.arh-wth-cli-tot
     3227    .
     3228   define temp-table tt-parts-cli-doc no-undo like ub.arh-wth-cli-doc
     3229   .
     3230   define temp-table tt-parts-tot    no-undo like ub.arh-wth-tot.
     3231   define temp-table tt-parts-wp     no-undo like ub.arh-wth-w-p.
     3232   define buffer buf-prev_arh-wth-cli   for ub.arh-wth-cli.
     3233   define buffer buf-arh-wth-cli        for ub.arh-wth-cli.
     3234   define buffer buf-recalc-cli         for ub.arh-wth-cli.
     3235   define buffer buf-prev_arh-wth-cli-doc   for ub.arh-wth-cli-doc.
     3236   define buffer buf-arh-wth-cli-doc    for ub.arh-wth-cli-doc.
     3237   define buffer buf-recalc-cli-doc     for ub.arh-wth-cli-doc.
     3238   define buffer buf-prev_arh-wth-tot   for ub.arh-wth-tot.
     3239   define buffer buf-arh-wth-tot        for ub.arh-wth-tot.
     3240   define buffer buf-recalc-tot         for ub.arh-wth-tot.
     3241   define buffer buf-prev_arh-wth-wp    for ub.arh-wth-w-p.
     3242   define buffer buf-arh-wth-wp         for ub.arh-wth-w-p.
     3243   define buffer buf-recalc-wp          for ub.arh-wth-w-p.
     3244   define buffer buf-arh_wth-doc        for ub.wth-doc.
     3245   define buffer buf-prev_arh-wth-cli-tot   for ub.arh-wth-cli-tot.
     3246   define buffer buf-arh-wth-cli-tot        for ub.arh-wth-cli-tot.
     3247   define buffer buf-recalc-cli-tot         for ub.arh-wth-cli-tot.
     3248   procedure wth-arh-mode:
     3249     define input  parameter parext-doc-type like ub.wth-doc.ext-doc-type no-undo.
     3250     define input  parameter pardoc-code like ub.wth-doc.doc-code no-undo.
     3251     define output parameter parinc-exp      as   integer                 no-undo.
     3252     define buffer buf_wth-parts   for ub.wth-parts.
     3253     case parext-doc-type:
     3254       when 'ee':U
     3255       or when 'pc':U
     3256       or when 'ps':U
     3257       or when 'pz':U
     3258       or when 'dc':U
     3259       or when 'xc':U
     3260       then do:
     3261         if can-find(first buf_wth-parts where buf_wth-parts.out-code = pardoc-code)
     3262         then parinc-exp = 1.
     3263         else parinc-exp = 0.
     3264       end.
     3265     end case.
     3266   end procedure.
     3267    procedure wth-arh-calctt-loc:
     3268     define input parameter pardoc-code as char no-undo.
     3269     define input parameter par-lock as log no-undo.
     3270     define var vararh-mode as int no-undo.
     3271     define buffer buf_wth-parts   for ub.wth-parts.
     3272     define variable v-cli-type    as character    no-undo.
     3273     define variable v-cli-code    as integer      no-undo.
     3274     define variable v-zone        as character    no-undo.
     3275     do on error undo, return error substitute ("Создание архивов по документу &4 &1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2),pardoc-code) :
     3276     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     3277     if not available buf-arh_wth-doc then do:
     3278       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     3279     end.
     3280     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
     3281             ,input buf-arh_wth-doc.doc-code
     3282             ,output vararh-mode).
     3283     empty temp-table tt-parts-cli.
     3284     empty temp-table tt-parts-cli-tot.
     3285     empty temp-table tt-parts-wp.
     3286     empty temp-table tt-parts-cli-doc.
     3287     empty temp-table tt-parts-tot   .
     3288     for each buf_wth-parts no-lock where
     3289              buf_wth-parts.out-code = pardoc-code
     3290          and buf_wth-parts.stts = 0 :
     3291      if  not g#news
     3292          or (g#news and  g#db-num  = 0)
     3293      then do:
     3294         find first tt-parts-tot where
     3295                   tt-parts-tot.wth-code = buf_wth-parts.wth-code
     3296               and tt-parts-tot.par-code = buf_wth-parts.par-code
     3297               and tt-parts-tot.obj-type = buf_wth-parts.obj-type
     3298               and tt-parts-tot.obj-code = buf_wth-parts.obj-code
     3299               and tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3300               and tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3301               no-error.
     3302         if not available tt-parts-tot then do:
     3303           create tt-parts-tot.
     3304           assign tt-parts-tot.wth-code = buf_wth-parts.wth-code
     3305                 tt-parts-tot.par-code = buf_wth-parts.par-code
     3306                 tt-parts-tot.gds-code = buf_wth-parts.gds-code
     3307                 tt-parts-tot.w-p-code = buf_wth-parts.w-p-code
     3308                 tt-parts-tot.obj-type = buf_wth-parts.obj-type
     3309                 tt-parts-tot.obj-code = buf_wth-parts.obj-code
     3310                 tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3311                 tt-parts-tot.doc-code = buf_wth-parts.out-code
     3312                 tt-parts-tot.host-code = buf_wth-parts.host-code
     3313                 tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3314           .
     3315         end.
     3316         if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) or  buf_wth-parts.type = 'возврат':U then      assign tt-parts-tot.in-qnty     = tt-parts-tot.in-qnty     + buf_wth-parts.fact-qnty            tt-parts-tot.in-sum-rubl = tt-parts-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl           tt-parts-tot.in-sum-base = tt-parts-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .    else   assign tt-parts-tot.out-qnty  = tt-parts-tot.out-qnty + buf_wth-parts.fact-qnty                               tt-parts-tot.out-sum-rubl = tt-parts-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl            tt-parts-tot.out-sum-base = tt-parts-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3317         if lookup(buf-arh_wth-doc.ext-doc-type,'ie,ff,rf':U) > 0
     3318         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'рас':U)
     3319         or lookup (buf-arh_wth-doc.ext-doc-type,'ee,ef,df':u) > 0 then
     3320         v-zone = 'free-zone':U.
     3321         else if lookup(buf-arh_wth-doc.ext-doc-type,'ip,pc,ps,pz,rp':u) > 0
     3322         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'при':U)
     3323         or lookup (buf-arh_wth-doc.ext-doc-type,'ep,dp':u) > 0 then
     3324         v-zone = 'put-zone':U.
     3325         if v-zone = 'free-zone':U or  v-zone = 'put-zone':U then do:
     3326           find first tt-parts-wp where
     3327                     tt-parts-wp.obj-type = buf_wth-parts.obj-type
     3328                 and tt-parts-wp.obj-code = buf_wth-parts.obj-code
     3329                 and tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
     3330                 and tt-parts-wp.wth-code = buf_wth-parts.wth-code
     3331                 and tt-parts-wp.par-code = buf_wth-parts.par-code
     3332                 and tt-parts-wp.out-code = v-zone
     3333                 no-error.
     3334           if not available tt-parts-wp then do:
     3335             create tt-parts-wp.
     3336             assign tt-parts-wp.wth-code = buf_wth-parts.wth-code
     3337                   tt-parts-wp.par-code = buf_wth-parts.par-code
     3338                   tt-parts-wp.gds-code = buf_wth-parts.gds-code
     3339                   tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
     3340                   tt-parts-wp.obj-type = buf_wth-parts.obj-type
     3341                   tt-parts-wp.obj-code = buf_wth-parts.obj-code
     3342                   tt-parts-wp.out-code = v-zone
     3343                   tt-parts-wp.ext-doc-type = buf_wth-parts.ext-doc-type
     3344                   tt-parts-wp.doc-code = buf_wth-parts.out-code
     3345                   tt-parts-wp.host-code = buf_wth-parts.host-code
     3346             .
     3347           end.
     3348           if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) then
     3349       assign tt-parts-wp.in-qnty     = tt-parts-wp.in-qnty     + buf_wth-parts.fact-qnty
     3350              tt-parts-wp.in-sum-rubl = tt-parts-wp.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3351              tt-parts-wp.in-sum-base = tt-parts-wp.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3352       else   assign tt-parts-wp.out-qnty  = tt-parts-wp.out-qnty + buf_wth-parts.fact-qnty
     3353              tt-parts-wp.out-sum-rubl = tt-parts-wp.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3354              tt-parts-wp.out-sum-base = tt-parts-wp.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3355         end.
     3356       end.
     3357       if vararh-mode = 1 then do:
     3358         if buf_wth-parts.in-code = 'фальшивый':U then
     3359         assign v-cli-type = '':U
     3360                v-cli-code = 0.
     3361         else assign v-cli-type = buf_wth-parts.cli-type
     3362                v-cli-code = buf_wth-parts.cli-code.
     3363         find first tt-parts-cli where
     3364                   tt-parts-cli.wth-code = buf_wth-parts.wth-code
     3365               and tt-parts-cli.par-code = buf_wth-parts.par-code
     3366               and tt-parts-cli.ser-code = buf_wth-parts.ser-code
     3367               and tt-parts-cli.db-num   = buf_wth-parts.db-num
     3368               and tt-parts-cli.cli-type = v-cli-type
     3369               and tt-parts-cli.cli-code = v-cli-code
     3370               and tt-parts-cli.obj-type = buf_wth-parts.obj-type
     3371               and tt-parts-cli.obj-code = buf_wth-parts.obj-code
     3372               and tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
     3373               and tt-parts-cli.gds-code = buf_wth-parts.gds-code
     3374               and tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3375               no-error.
     3376         if not available tt-parts-cli then do:
     3377           create tt-parts-cli.
     3378           assign tt-parts-cli.wth-code = buf_wth-parts.wth-code
     3379                 tt-parts-cli.par-code = buf_wth-parts.par-code
     3380                 tt-parts-cli.ser-code = buf_wth-parts.ser-code
     3381                 tt-parts-cli.db-num   = buf_wth-parts.db-num
     3382                 tt-parts-cli.cli-type = v-cli-type
     3383                 tt-parts-cli.cli-code = v-cli-code
     3384                 tt-parts-cli.obj-type = buf_wth-parts.obj-type
     3385                 tt-parts-cli.obj-code = buf_wth-parts.obj-code
     3386                 tt-parts-cli.doc-code  = buf_wth-parts.out-code
     3387                 tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
     3388                 tt-parts-cli.gds-code = buf_wth-parts.gds-code
     3389                 tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3390           .
     3391         end.
     3392       if buf-arh_wth-doc.doc-type = 'при':U
     3393       or buf-arh_wth-doc.doc-type = 'возврат':U
     3394       or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U)
     3395       then
     3396       assign tt-parts-cli.in-qnty     = tt-parts-cli.in-qnty     + buf_wth-parts.fact-qnty
     3397              tt-parts-cli.in-sum-rubl = tt-parts-cli.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3398              tt-parts-cli.in-sum-base = tt-parts-cli.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3399       else   assign tt-parts-cli.out-qnty  = tt-parts-cli.out-qnty + buf_wth-parts.fact-qnty
     3400              tt-parts-cli.out-sum-rubl = tt-parts-cli.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3401              tt-parts-cli.out-sum-base = tt-parts-cli.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3402         find first tt-parts-cli-doc where
     3403                   tt-parts-cli-doc.wth-code = buf_wth-parts.wth-code
     3404               and tt-parts-cli-doc.par-code = buf_wth-parts.par-code
     3405               and tt-parts-cli-doc.cli-type = v-cli-type
     3406               and tt-parts-cli-doc.cli-code = v-cli-code
     3407               and tt-parts-cli-doc.host-code = buf_wth-parts.host-code
     3408               and tt-parts-cli-doc.contract-code = buf_wth-parts.contract-code
     3409               and tt-parts-cli-doc.gds-code = buf_wth-parts.gds-code
     3410               and tt-parts-cli-doc.obj-type = buf_wth-parts.obj-type
     3411               and tt-parts-cli-doc.obj-code = buf_wth-parts.obj-code
     3412               and tt-parts-cli-doc.w-p-code = buf_wth-parts.w-p-code
     3413               and tt-parts-cli-doc.ext-doc-type = buf_wth-parts.ext-doc-type
     3414               and tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3415               no-error.
     3416         if not available tt-parts-cli-doc then do:
     3417           create tt-parts-cli-doc.
     3418           buffer-copy buf_wth-parts using wth-code
     3419                                           par-code
     3420                                           host-code
     3421                                           contract-code
     3422                                           gds-code
     3423                                           obj-type
     3424                                           obj-code
     3425                                           w-p-code
     3426                                           ext-doc-type
     3427                       to tt-parts-cli-doc.
     3428           assign tt-parts-cli-doc.doc-code = buf_wth-parts.out-code
     3429                  tt-parts-cli-doc.cli-code = v-cli-code
     3430                  tt-parts-cli-doc.cli-type = v-cli-type
     3431                  tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3432           .
     3433         end.
     3434         if buf-arh_wth-doc.doc-type = 'при':U
     3435         or buf-arh_wth-doc.doc-type = 'возврат':U
     3436         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
     3437         then
     3438       assign tt-parts-cli-doc.in-qnty     = tt-parts-cli-doc.in-qnty     + buf_wth-parts.fact-qnty
     3439              tt-parts-cli-doc.in-sum-rubl = tt-parts-cli-doc.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3440              tt-parts-cli-doc.in-sum-base = tt-parts-cli-doc.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3441       else   assign tt-parts-cli-doc.out-qnty  = tt-parts-cli-doc.out-qnty + buf_wth-parts.fact-qnty
     3442              tt-parts-cli-doc.out-sum-rubl = tt-parts-cli-doc.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3443              tt-parts-cli-doc.out-sum-base = tt-parts-cli-doc.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3444         find first tt-parts-cli-tot where
     3445                   tt-parts-cli-tot.cli-type = v-cli-type
     3446               and tt-parts-cli-tot.cli-code = v-cli-code
     3447               and tt-parts-cli-tot.obj-type = buf_wth-parts.obj-type
     3448               and tt-parts-cli-tot.obj-code = buf_wth-parts.obj-code
     3449               and tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3450               and tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3451         no-error.
     3452         if not available tt-parts-cli-tot then do:
     3453           create tt-parts-cli-tot.
     3454           assign tt-parts-cli-tot.cli-type = v-cli-type
     3455                 tt-parts-cli-tot.cli-code  = v-cli-code
     3456                 tt-parts-cli-tot.obj-type  = buf_wth-parts.obj-type
     3457                 tt-parts-cli-tot.obj-code  = buf_wth-parts.obj-code
     3458                 tt-parts-cli-tot.doc-code  = buf_wth-parts.out-code
     3459                 tt-parts-cli-tot.host-code = buf_wth-parts.host-code
     3460                 tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3461                 tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3462           .
     3463         end.
     3464         if buf-arh_wth-doc.doc-type = 'при':U
     3465         or buf-arh_wth-doc.doc-type = 'возврат':U
     3466         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
     3467         then
     3468         assign tt-parts-cli-tot.in-qnty     = tt-parts-cli-tot.in-qnty     + buf_wth-parts.fact-qnty
     3469               tt-parts-cli-tot.in-sum-rubl = tt-parts-cli-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3470               tt-parts-cli-tot.in-sum-base = tt-parts-cli-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3471         else   assign tt-parts-cli-tot.out-qnty = tt-parts-cli-tot.out-qnty  + buf_wth-parts.fact-qnty
     3472               tt-parts-cli-tot.out-sum-rubl = tt-parts-cli-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3473               tt-parts-cli-tot.out-sum-base = tt-parts-cli-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3474       end.
     3475     end.
     3476     if par-lock then do:
     3477       for each tt-parts-tot:
     3478         find last   buf-arh-wth-tot exclusive-lock  where
     3479                     buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3480                 and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
     3481                 and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3482                 and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3483                 and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3484                 and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type     no-error.
     3485         if not available buf-arh-wth-tot then do:
     3486           create buf-arh-wth-tot.
     3487           buffer-copy tt-parts-tot using
     3488                       wth-code
     3489                       par-code
     3490                       gds-code
     3491                       obj-type
     3492                       obj-code
     3493                       w-p-code
     3494                       sum-type
     3495                       ext-doc-type
     3496           to buf-arh-wth-tot.
     3497         end.
     3498       end.
     3499       for each tt-parts-wp:
     3500         find last   buf-arh-wth-wp exclusive-lock  where
     3501                     buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
     3502                 and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
     3503                 and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
     3504                 and buf-arh-wth-wp.obj-code = tt-parts-wp.obj-code
     3505                 and buf-arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     3506                 and buf-arh-wth-wp.out-code = tt-parts-wp.out-code     no-error.
     3507         if not available buf-arh-wth-wp then do:
     3508           create buf-arh-wth-wp.
     3509           buffer-copy tt-parts-wp using
     3510                       wth-code
     3511                       par-code
     3512                       gds-code
     3513                       obj-type
     3514                       obj-code
     3515                       w-p-code
     3516                       doc-code
     3517                       out-code
     3518                       ext-doc-type
     3519           to buf-arh-wth-wp.
     3520         end.
     3521       end.
     3522       for each tt-parts-cli:
     3523         find last  buf-arh-wth-cli exclusive-lock where
     3524                    buf-arh-wth-cli.wth-code =  tt-parts-cli.wth-code
     3525               and  buf-arh-wth-cli.par-code =  tt-parts-cli.par-code
     3526               and  buf-arh-wth-cli.ser-code =  tt-parts-cli.ser-code
     3527               and  buf-arh-wth-cli.db-num   =  tt-parts-cli.db-num
     3528               and  buf-arh-wth-cli.cli-type =  tt-parts-cli.cli-type
     3529               and  buf-arh-wth-cli.cli-code =  tt-parts-cli.cli-code
     3530               and  buf-arh-wth-cli.obj-type =  tt-parts-cli.obj-type
     3531               and  buf-arh-wth-cli.obj-code =  tt-parts-cli.obj-code
     3532               and  buf-arh-wth-cli.sum-type = tt-parts-cli.sum-type
     3533               and  buf-arh-wth-cli.ext-doc-type =  tt-parts-cli.ext-doc-type
     3534               and  buf-arh-wth-cli.gds-code =  tt-parts-cli.gds-code
     3535                no-error.
     3536         if not available buf-arh-wth-cli then do:
     3537           create buf-arh-wth-cli.
     3538           buffer-copy tt-parts-cli using wth-code
     3539                                          sum-type
     3540                                          par-code
     3541                                          ser-code
     3542                                          db-num
     3543                                          cli-type
     3544                                          cli-code
     3545                                          obj-type
     3546                                          obj-code
     3547                                          ext-doc-type
     3548                                          gds-code to buf-arh-wth-cli.
     3549         end.
     3550       end.
     3551       for each tt-parts-cli-doc:
     3552         find last buf-arh-wth-cli-doc exclusive-lock  where
     3553                    buf-arh-wth-cli-doc.wth-code = tt-parts-cli-doc.wth-code
     3554               and  buf-arh-wth-cli-doc.par-code = tt-parts-cli-doc.par-code
     3555               and  buf-arh-wth-cli-doc.cli-type = tt-parts-cli-doc.cli-type
     3556               and  buf-arh-wth-cli-doc.cli-code = tt-parts-cli-doc.cli-code
     3557               and  buf-arh-wth-cli-doc.host-code     = tt-parts-cli-doc.host-code
     3558               and  buf-arh-wth-cli-doc.contract-code = tt-parts-cli-doc.contract-code
     3559               and  buf-arh-wth-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
     3560               and  buf-arh-wth-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
     3561               and  buf-arh-wth-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
     3562               and  buf-arh-wth-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
     3563               and  buf-arh-wth-cli-doc.sum-type      = tt-parts-cli-doc.sum-type
     3564               and  buf-arh-wth-cli-doc.ext-doc-type  = tt-parts-cli-doc.ext-doc-type
     3565               no-error.
     3566         if not available buf-arh-wth-cli-doc then do:
     3567           create buf-arh-wth-cli-doc.
     3568           buffer-copy tt-parts-cli-doc using
     3569                       wth-code
     3570                       par-code
     3571                       cli-type
     3572                       cli-code
     3573                       host-code
     3574                       contract-code
     3575                       gds-code
     3576                       obj-type
     3577                       obj-code
     3578                       w-p-code
     3579                       ext-doc-type
     3580                       sum-type
     3581                       to buf-arh-wth-cli-doc.
     3582         end.
     3583       end.
     3584       for each tt-parts-cli-tot:
     3585         find last  buf-arh-wth-cli-tot exclusive-lock where
     3586                    buf-arh-wth-cli-tot.cli-type =  tt-parts-cli-tot.cli-type
     3587               and  buf-arh-wth-cli-tot.cli-code =  tt-parts-cli-tot.cli-code
     3588               and  buf-arh-wth-cli-tot.obj-type =  tt-parts-cli-tot.obj-type
     3589               and  buf-arh-wth-cli-tot.obj-code =  tt-parts-cli-tot.obj-code
     3590               and  buf-arh-wth-cli-tot.sum-type = tt-parts-cli-tot.sum-type
     3591               and  buf-arh-wth-cli-tot.ext-doc-type =  tt-parts-cli-tot.ext-doc-type
     3592         no-error.
     3593         if not available buf-arh-wth-cli-tot then do:
     3594           create buf-arh-wth-cli-tot.
     3595           buffer-copy tt-parts-cli-tot using cli-type sum-type cli-code obj-type obj-code ext-doc-type host-code to buf-arh-wth-cli-tot.
     3596         end.
     3597       end.
     3598     end.
     3599     end.
     3600    end procedure.
     3601    procedure wth-arhdoc-close:
     3602    define input parameter pardoc-code as char no-undo.
     3603    define variable vararh-mode  as integer      no-undo.
     3604     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     3605     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     3606     if not available buf-arh_wth-doc then do:
     3607       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     3608     end.
     3609     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
     3610             ,input buf-arh_wth-doc.doc-code
     3611             ,output vararh-mode).
     3612     if buf-arh_wth-doc.status_ <> 'факт':U then do:
     3613       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
     3614     end.
     3615     if buf-arh_wth-doc.fact-order = 0 or
     3616       buf-arh_wth-doc.fact-order = ? then do:
     3617       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
     3618     end.
     3619     if  not g#news
     3620          or (g#news and  g#db-num  = 0)
     3621     then do:
     3622       for each  tt-parts-tot on error undo, return error:
     3623           find last  buf-prev_arh-wth-tot where buf-prev_arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3624                                             and buf-prev_arh-wth-tot.par-code =  tt-parts-tot.par-code
     3625                                             and buf-prev_arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3626                                             and buf-prev_arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3627                                             and buf-prev_arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3628                                             and buf-prev_arh-wth-tot.sum-type = tt-parts-tot.sum-type
     3629                                             and buf-prev_arh-wth-tot.fact-order < buf-arh_wth-doc.fact-order
     3630                                             no-error.
     3631           if available buf-prev_arh-wth-tot and buf-prev_arh-wth-tot.fact-order = 0 then do:
     3632               find first buf-arh-wth-tot where recid(buf-arh-wth-tot) = recid(buf-prev_arh-wth-tot) exclusive-lock.
     3633           end.
     3634           else do:
     3635             create buf-arh-wth-tot.
     3636             buffer-copy tt-parts-tot to buf-arh-wth-tot .
     3637           end.
     3638           assign  buf-arh-wth-tot.doc-code = buf-arh_wth-doc.doc-code
     3639                   buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
     3640                   buf-arh-wth-tot.in-qnty     = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-qnty  else 0)    + tt-parts-tot.in-qnty
     3641                   buf-arh-wth-tot.in-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-rubl else 0) + tt-parts-tot.in-sum-rubl
     3642                   buf-arh-wth-tot.in-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-base else 0) + tt-parts-tot.in-sum-base
     3643                   buf-arh-wth-tot.out-qnty    = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-qnty else 0)    + tt-parts-tot.out-qnty
     3644                   buf-arh-wth-tot.out-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-rubl else 0) + tt-parts-tot.out-sum-rubl
     3645                   buf-arh-wth-tot.out-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-base else 0) + tt-parts-tot.out-sum-base
     3646                   .
     3647           for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
     3648                 and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
     3649                 and buf-recalc-tot.par-code = tt-parts-tot.par-code
     3650                 and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
     3651                 and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
     3652                 and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3653                 and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
     3654                 on error undo, return error :
     3655                 assign buf-recalc-tot.out-qnty    = buf-recalc-tot.out-qnty     + tt-parts-tot.out-qnty
     3656                       buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl + tt-parts-tot.out-sum-rubl
     3657                       buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base + tt-parts-tot.out-sum-base
     3658                       buf-recalc-tot.in-qnty      = buf-recalc-tot.in-qnty    + tt-parts-tot.in-qnty
     3659                       buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl + tt-parts-tot.in-sum-rubl
     3660                       buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base + tt-parts-tot.in-sum-base
     3661                       .
     3662           end.
     3663        end.
     3664        for each  tt-parts-wp on error undo, return error:
     3665           find last  buf-prev_arh-wth-wp where buf-prev_arh-wth-wp.wth-code  = tt-parts-wp.wth-code
     3666                                             and buf-prev_arh-wth-wp.par-code = tt-parts-wp.par-code
     3667                                             and buf-prev_arh-wth-wp.obj-type = tt-parts-wp.obj-type
     3668                                             and buf-prev_arh-wth-wp.obj-code = tt-parts-wp.obj-code
     3669                                             and buf-prev_arh-wth-wp.out-code = tt-parts-wp.out-code
     3670                                             and buf-prev_arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     3671                                             and buf-prev_arh-wth-wp.fact-order < buf-arh_wth-doc.fact-order
     3672                                             no-error.
     3673           if available buf-prev_arh-wth-wp and buf-prev_arh-wth-wp.fact-order = 0 then do:
     3674               find first buf-arh-wth-wp where recid(buf-arh-wth-wp) = recid(buf-prev_arh-wth-wp) exclusive-lock.
     3675           end.
     3676           else do:
     3677             create buf-arh-wth-wp.
     3678             buffer-copy tt-parts-wp to buf-arh-wth-wp .
     3679           end.
     3680           assign  buf-arh-wth-wp.doc-code = buf-arh_wth-doc.doc-code
     3681                   buf-arh-wth-wp.fact-order = buf-arh_wth-doc.fact-order
     3682                   buf-arh-wth-wp.ext-doc-type = buf-arh_wth-doc.ext-doc-type
     3683                   buf-arh-wth-wp.in-qnty     = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-qnty  else 0)    + tt-parts-wp.in-qnty
     3684                   buf-arh-wth-wp.in-sum-rubl = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-sum-rubl else 0) + tt-parts-wp.in-sum-rubl
     3685                   buf-arh-wth-wp.in-sum-base = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-sum-base else 0) + tt-parts-wp.in-sum-base
     3686                   buf-arh-wth-wp.out-qnty    = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.out-qnty else 0)    + tt-parts-wp.out-qnty
