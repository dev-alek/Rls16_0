      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure wth-obj-hist :
      365   define parameter buffer buf_wth-obj for ub.wth-obj.
      366   define input parameter p-obj-type like ub.wth-obj.obj-type no-undo .
      367   define input parameter p-obj-code like ub.wth-obj.obj-code no-undo .
      368   define input parameter p-wth-code like ub.wth-obj.wth-code no-undo .
      369   define input parameter p-action-type as character no-undo .
      370   define input  parameter p-source-type        as character no-undo .
      371   define input  parameter p-source-ref         as character no-undo .
      372   define input  parameter p-source-date        as date      no-undo .
      373   define input  parameter p-corr-user-db-num   as integer   no-undo .
      374   define input  parameter p-corr-user-name     as character no-undo .
      375   define input  parameter p-corr-date          as date      no-undo .
      376   define input  parameter p-corr-time          as integer   no-undo .
      377   define input  parameter p-corr-time-str      as character no-undo .
      378   define variable v-new-chip-num as integer   no-undo .
      379   define buffer buf_c-wth-obj for ub.c-wth-obj .
      380     do
      381     for buf_c-wth-obj
      382     transaction
      383     on error undo, return error return-value
      384     :
      385       find last buf_c-wth-obj exclusive-lock
      386         where buf_c-wth-obj.obj-type = buf_wth-obj.obj-type
      387           and buf_c-wth-obj.obj-code = buf_wth-obj.obj-code
      388           and buf_c-wth-obj.wth-code = buf_wth-obj.wth-code
      389           and buf_c-wth-obj.corr-user-db-num = p-corr-user-db-num
      390         use-index pi
      391         no-error .
      392       if available buf_c-wth-obj
      393       then do:
      394         assign
      395           v-new-chip-num = buf_c-wth-obj.chip-num + 1
      396         .
      397       end.
      398       else do:
      399         assign
      400           v-new-chip-num = 1
      401         .
      402       end.
      403       create buf_c-wth-obj .
      404       if p-action-type = 'delete':U
      405       and
      406       not available buf_wth-obj then do:
      407         assign
      408         buf_c-wth-obj.obj-type = p-obj-type
      409         buf_c-wth-obj.obj-code = p-obj-code
      410         buf_c-wth-obj.wth-code = p-wth-code
      411         .
      412       end.
      413       else do:
      414         buffer-copy buf_wth-obj to
      415         buf_c-wth-obj.
      416       end.
      417       assign
      418         buf_c-wth-obj.chip-num          = v-new-chip-num
      419         buf_c-wth-obj.action-type       = p-action-type
      420         buf_c-wth-obj.source-type       = p-source-type
      421         buf_c-wth-obj.source-ref        = p-source-ref
      422         buf_c-wth-obj.source-date       = p-source-date
      423         buf_c-wth-obj.corr-user-db-num  = p-corr-user-db-num
      424         buf_c-wth-obj.corr-user-name    = p-corr-user-name
