      664   define  stream PrnLibStream.
      665   procedure prn-lib-prn-file :
      666     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      667     define input parameter p-DIsabledoptions as integer no-undo .
      668     define variable v-report-name as character no-undo .
      669     define variable v-user-action as character no-undo .
      670     define variable v-printed     as logical   no-undo .
      671     define variable v-exist       as logical   no-undo .
      672     do
      673       on error undo, return error
      674       :
