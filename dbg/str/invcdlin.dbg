      898       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      899     .
      900     do ind = 1 to v-num-parfirst-list
      901     :
      902       assign
      903         v-elem = entry(ind, parfirst-list, pardelim)
      904       .
      905       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      906         assign
      907           v-result-list = v-result-list
      908                         + (if v-result-list > "" then pardelim else "")
      909                         + v-elem
      910         .
