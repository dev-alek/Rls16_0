      844   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   FUNCTION mark-string RETURNS CHARACTER
      846     ( input p-recid as recid, input mark-list as character  ) :
      847     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
