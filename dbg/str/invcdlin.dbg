     1240         VIEW-AS TEXT
     1241        SIZE 6 BY 1
     1242        FGCOLOR 4  NO-UNDO.
     1243   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(16)":U
     1244        LABEL "Код"
     1245        VIEW-AS FILL-IN
     1246        SIZE 17 BY 1 NO-UNDO.
     1247   DEFINE VARIABLE rs-calc AS LOGICAL
     1248        VIEW-AS RADIO-SET HORIZONTAL
     1249        RADIO-BUTTONS
     1250             "Все", ?,
     1251   "Посчитанные", yes,
     1252   "Непосчитанные", no
     1253        SIZE 40 BY 1 NO-UNDO.
     1254   DEFINE NEW SHARED QUERY br-invline FOR
     1255         X_chk-gds,
     1256         X_bar-code,
     1257         X_goods SCROLLING.
     1258   DEFINE NEW SHARED QUERY QUERY-chk-doc FOR
     1259         X_chk-doc SCROLLING.
     1260   DEFINE BROWSE br-invline
     1261     QUERY br-invline NO-LOCK DISPLAY
     1262         mark-string(recid(X_chk-gds), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1263               WIDTH 2
     1264         not (X_chk-gds.is-error) COLUMN-LABEL "Посчи!тан" FORMAT "+/":U
     1265         X_chk-gds.b-code FORMAT "999999999":U
     1266         X_chk-gds.doc-qnty FORMAT "->>,>>>,>>9.<<<":U
     1267         X_bar-code.unit-cli COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     1268         X_goods.gds-name FORMAT "X(48)":U
     1269         X_bar-code.gds-code FORMAT "999999999":U
     1270         get-prt-name ( buffer X_bar-code, buffer X_goods) COLUMN-LABEL "Шкала" FORMAT "X(20)":U
     1271               WIDTH 21
     1272         X_chk-gds.src-code COLUMN-LABEL "Бар-код в чеке" FORMAT "X(16)":U
     1273         X_chk-gds.src-qnty FORMAT "->>,>>>,>>9.<<<":U
     1274         X_chk-gds.line-num COLUMN-LABEL "Строка" FORMAT "99999":U
     1275         X_chk-gds.doc-code COLUMN-LABEL "Номер чека" FORMAT "X(20)":U
     1276     ENABLE
     1277         X_chk-gds.src-qnty
     1278       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19 EXPANDABLE.
     1279   DEFINE FRAME Dialog-Frame
     1280        b-quit AT ROW 1 COL 1
     1281        B-mark AT ROW 1 COL 11
     1282        b-sel AT ROW 1 COL 21
     1283        b-calc AT ROW 1 COL 51
     1284        B-sch AT ROW 1 COL 61
     1285        B-print AT ROW 1 COL 71
     1286        B-Help AT ROW 1 COL 81
     1287        rs-calc AT ROW 2 COL 2 NO-LABEL
     1288        sch-code AT ROW 2 COL 49 COLON-ALIGNED
     1289        br-invline AT ROW 3 COL 1.5
     1290        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1291        f-prod-name AT ROW 22.25 COL 1
     1292        SPACE(0.24) SKIP(0.15)
     1293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1295            TITLE "Список строк инвентаризации по кассе"
     1296            CANCEL-BUTTON b-quit.
     1297   ASSIGN
     1298          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1299          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1300   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1301   DO:
     1302     APPLY "END-ERROR":U TO SELF.
     1303   END.
     1304   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     1305   DO:
     1306   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1307   DEFINE VARIABLE v-ii-ok AS INTEGER NO-UNDO.
     1308   DEFINE VARIABLE is-all AS logical NO-UNDO.
     1309   DEFINE VARIABLE v-num AS INTEGER NO-UNDO.
     1310   define variable jj as integer no-undo .
     1311   define variable v-rec as recid no-undo .
     1312   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     1313   IF NOT AVAILABLE X_chk-gds THEN RETURN NO-APPLY.
     1314     run str/inc-invd.w (
     1315                      input parparentproc
     1316                     ,input 'ИЗМЕНЕНИЕ':U
     1317                     ,input '':U
     1318                     ,input (if v-rid-list = '':u then string(recid(X_chk-gds)) else v-rid-list)
     1319                     ,input buf_trn-doc.obj-type
     1320                     ,input buf_trn-doc.obj-code
     1321                     ,buffer buf_trn-doc
     1322                     ) NO-ERROR.
     1323   if error-status:error then do:
     1324     message error-status:get-message(1) return-value view-as alert-box .
     1325   end.
     1326   run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U) NO-ERROR.
     1327   END.
     1328   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1329   DO:
     1330    DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1331     if available X_chk-gds then do:
     1332   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   define variable v-str-recid12 as character no-undo .
     1334   define variable v-num-entry12 as integer   no-undo .
     1335   assign
     1336     v-str-recid12 = trim( string( recid( X_chk-gds ) , "->>>>>>>>>>>9":U ) )
     1337     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1338   .
     1339   if v-num-entry12 > 0 then do:
     1340     assign
     1341       entry( v-num-entry12, v-rid-list ) = "":U
     1342       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1343     .
     1344   end.
     1345   else do:
     1346     assign
     1347       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1348     .
     1349   end.
     1350       glog = br-invline:refresh() .
     1351       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1352         glog = br-invline:select-next-row ().
     1353         apply "VALUE-CHANGED" to br-invline in frame Dialog-Frame.
     1354       end.
     1355       if num-entries( v-rid-list ) = 0
     1356       then
     1357           hide mark-num in frame Dialog-Frame.
     1358       else
     1359           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1360     end.
     1361     apply "entry" to br-invline in frame Dialog-Frame.
     1362   END.
     1363   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1364   DO:
     1365     run proc-b-print IN THIS-PROCEDURE ( input rs-calc) NO-ERROR.
     1366     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1367   END.
     1368   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1369   DO:
     1370     run proc-b-sch in this-procedure no-error.
     1371     if error-status:error then return no-apply.
     1372   END.
     1373   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1374   DO:
     1375     if ( available X_chk-gds )
     1376     AND (( v-rid-list = "" )
     1377          or b-mark:sensitive in frame Dialog-Frame = no) then
     1378       v-rid-list = string( recid( X_chk-gds ) ) .
     1379     p-rid-list = v-rid-list.
     1380   END.
     1381   ON VALUE-CHANGED OF br-invline IN FRAME Dialog-Frame
     1382   DO:
     1383     IF NOT AVAILABLE X_goods THEN DO:
     1384        f-prod-name = '':U.
     1385     END.
     1386     ELSE DO:
     1387       FIND FIRST X_clients NO-LOCK WHERE
     1388               X_clients.obj-type = X_goods.prod-type
     1389           AND X_clients.obj-code = X_goods.prod-code NO-ERROR.
     1390       IF AVAILABLE X_clients THEN DO:
     1391          f-prod-name = X_clients.obj-name.
     1392       END.
     1393       ELSE DO:
     1394           f-prod-name = X_clients.obj-type + chr(32) + string(X_clients.obj-code).
     1395       END.
     1396     END.
     1397     DISPLAY
     1398     f-prod-name WITH FRAME Dialog-Frame.
     1399   END.
     1400   ON VALUE-CHANGED OF rs-calc IN FRAME Dialog-Frame
     1401   DO:
     1402     ASSIGN
     1403     rs-calc.
     1404     run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U) NO-ERROR.
     1405   END.
     1406   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1407   DO:
     1408     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1409     if error-status:error then return no-apply.
     1410   END.
     1411   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1412   DO:
     1413     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1414     if error-status:error then return no-apply.
     1415   END.
     1416   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1417   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1418   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419   on help of frame Dialog-Frame
     1420   do:
     1421     run gbl/app_help.p
     1422       (input this-procedure :file-name
     1423       ,input ''
     1424       ,input ?
     1425       ) no-error.
     1426     if error-status :error then do:
     1427       message
     1428         "Ошибка при вызове помощи"
     1429         error-status :get-message(1)
     1430         view-as alert-box .
     1431     end.
     1432   end.
     1433   run minbtn-set in this-procedure .
     1434   on choose of b-help in frame Dialog-Frame
     1435   do:
     1436     apply "help":u to frame Dialog-Frame .
     1437   end.
     1438   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1439   procedure minbtn-set :
     1440       do
     1441           on error undo, return error return-value
     1442           :
     1443           define variable ii              as integer       no-undo .
     1444           define variable fh              as widget-handle no-undo .
     1445           define variable hh              as widget-handle no-undo .
     1446           define variable v-h             as handle        extent 4 no-undo .
     1447           define variable v-name-button   as character     no-undo .
     1448           define variable v-help-old-x    as decimal       no-undo .
     1449           define variable v-help-old-y    as decimal       no-undo .
     1450           define variable v-help-old-size as decimal       no-undo .
     1451           define variable v-frame-width   as decimal       no-undo .
     1452           define variable jj              as integer       no-undo .
     1453           do
     1454               on error undo, return error
     1455               :
     1456               assign
     1457                   v-frame-width = frame Dialog-Frame:width - 0.3
     1458                   fh            = frame Dialog-Frame:first-child
     1459                   hh            = fh:first-child
     1460                   ii            = 1
     1461                   .
     1462               do while valid-handle(hh):
     1463                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1464                   do:
     1465                       case lc(hh:name) :
     1466                           when "b-help" then
     1467                               do:
     1468                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1469                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1470                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1471                                   hh:TOOLTIP = "Помощь" .
     1472                                   v-help-old-x = hh:column .
     1473                                   v-help-old-y = hh:row    .
     1474                                   v-help-old-size = hh:width .
     1475                                   hh:width-chars = 2.5 .
     1476                               end.
     1477                           when "b-print" then
     1478                               do:
     1479                                   hh:load-image("cmp/b-print.bmp":u) .
     1480                                   hh:TOOLTIP = "Печать" .
     1481                                   v-h[ii] = hh:handle .
     1482                                   ii = ii + 1 .
     1483                                   hh:width-chars = 3 .
     1484                               end.
     1485                           when "b-history" or
     1486                           when "b-hist" then
     1487                               do:
     1488                                   hh:load-image("cmp/b-hist.bmp":u) .
     1489                                   hh:TOOLTIP = "История" .
     1490                                   v-h[ii] = hh:handle .
     1491                                   ii = ii + 1 .
     1492                                   hh:width-chars = 3 .
     1493                               end.
     1494                           when "b-sch" then
     1495                               do:
     1496                                   hh:load-image("cmp/b-sch.bmp":u) .
     1497                                   hh:TOOLTIP = "Установка Фильтра" .
     1498                                   v-h[ii] = hh:handle .
     1499                                   ii = ii + 1 .
     1500                                   hh:width-chars = 3 .
     1501                               end.
     1502                           when "b-hist-user" then
     1503                               do:
     1504                                   hh:load-image("cmp/b-hist.bmp":u) .
     1505                                   hh:TOOLTIP = "История пользователя" .
     1506                                   ii = ii + 1 .
     1507                               end.
     1508                       end case.
     1509                   end.
     1510                   hh = hh:next-sibling.
     1511               end.
     1512               b-help:column = v-frame-width - b-help:width-chars.
     1513               jj = 0.
     1514               repeat ii = 4 to 1 by -1 :
     1515                   if valid-handle (v-h[ii] ) then
     1516                   do:
     1517                       jj  = jj + 1 .
     1518                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1519                       v-h[ii]:row    = v-help-old-y .
     1520                   end.
     1521               end.
     1522           end.
     1523       end.
     1524   end procedure.
     1525   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1526   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1527   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1528   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1529   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1530   define variable v-diasize-current-frame-height as decimal   no-undo .
     1531   define variable v-diasize-change-size          as logical   no-undo .
     1532   define variable v-diasize-resize-button        as handle    no-undo .
     1533   define variable v-diasize-wndmax               as logical   no-undo .
     1534   define variable v-diasize-wndstore             as logical   no-undo .
     1535   define variable v-diasize-proc-name            as character no-undo .
     1536   define variable v-diasize-browse-handle        as handle    no-undo .
     1537   define variable v-diasize-browse-number        as integer   no-undo .
     1538   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1539   define temp-table temp-diasize-handle no-undo
     1540     field handle-value  as handle
     1541     field save-position as decimal
     1542     index xpk is primary unique handle-value
     1543     .
     1544   define temp-table temp-browse-handle no-undo
     1545     field browse-type   as character
     1546     field browse-number as integer
     1547     field browse-handle as handle
     1548     field original-size as decimal
     1549     index xpk is primary unique browse-type browse-number
     1550     index xie browse-type browse-handle
     1551   .
     1552   procedure diasize_change-height :
     1553     define input  parameter p-change-value  as decimal   no-undo .
     1554     define input  parameter p-move-resize   as logical   no-undo .
     1555     define variable v-field-group-handle    as handle    no-undo .
     1556     define variable v-object-handle         as handle    no-undo .
     1557     define variable v-frame-height          as decimal   no-undo .
     1558     define variable v-frame-virtual-height  as decimal   no-undo .
     1559     define variable v-browse-height         as decimal   no-undo .
     1560     define variable v-window-height         as decimal   no-undo .
     1561     define variable v-window-virtual-height as decimal   no-undo .
     1562     define variable v-change-sign           as integer   no-undo .
     1563     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1564     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1565     if p-change-value > 0
     1566     then do:
     1567       if frame Dialog-Frame :height + p-change-value
     1568           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1569       then do:
     1570         assign
     1571           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1572                           - (frame Dialog-Frame :height-chars)
     1573         .
     1574         if p-change-value <= 0
     1575         then do:
     1576           run diasize_position-resize-button in this-procedure .
     1577           return .
     1578         end.
     1579       end.
     1580     end.
     1581     if p-change-value < 0
     1582     then do:
     1583       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1584       then do:
     1585         assign
     1586           p-change-value = v-diasize-orig-frame-height
     1587                          - (frame Dialog-Frame :height-chars)
     1588         .
     1589         if p-change-value >= 0
     1590         then do:
     1591           run diasize_position-resize-button in this-procedure .
     1592           return .
     1593         end.
     1594       end.
     1595     end.
     1596     if p-change-value >= 0
     1597     then do:
     1598       assign
     1599         v-change-sign = 1
     1600       .
     1601     end.
     1602     else do:
     1603       assign
     1604         v-change-sign = -1
     1605       .
     1606     end.
     1607     assign
     1608       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1609     .
     1610     if p-change-value = 0
     1611     then do:
