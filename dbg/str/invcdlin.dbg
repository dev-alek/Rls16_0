     1224        LABEL "&Выход"
     1225        SIZE 10 BY 1
     1226        BGCOLOR 8 .
     1227   DEFINE BUTTON B-sch
     1228        LABEL "&Фильтр"
     1229        SIZE 10 BY 1.
     1230   DEFINE BUTTON b-sel AUTO-GO
     1231        LABEL "Вы&бор"
     1232        SIZE 10 BY 1
     1233        BGCOLOR 8 .
     1234   DEFINE VARIABLE f-prod-name AS CHARACTER FORMAT "X(256)":U
     1235        LABEL "Произв-ль"
     1236         VIEW-AS TEXT
     1237        SIZE 87.5 BY .67
     1238        FGCOLOR 4  NO-UNDO.
