     3043   ASSIGN
     3044   X_chk-gds.src-qnty:READ-ONLY IN BROWSE br-invline = YES
     3045   X_goods.gds-name:resizable IN BROWSE br-invline = YES
     3046   X_goods.gds-name:width IN BROWSE br-invline = 25
     3047   .
     3048   IF p-mode = "":u  THEN rs-calc = ?.
     3049   IF p-mode = "calc":u  THEN rs-calc = YES.
     3050   IF p-mode = "not-calc":u  THEN rs-calc = no.
     3051   DISPLAY
     3052   rs-calc
     3053   sch-code
     3054   WITH FRAME Dialog-Frame.
     3055   ENABLE
     3056   b-quit
     3057   B-mark WHEN LOOKUP("b-mark", bttns) > 0
     3058   b-sel  WHEN LOOKUP("b-sel", bttns) > 0
     3059   b-calc WHEN (buf_trn-doc.STATUS_ = 'разрешен':U
     3060                AND
     3061                LOOKUP("b-calc", bttns) > 0
     3062                AND buf_trn-doc.obj-type = v-cntxt-obj-type
     3063                AND buf_trn-doc.obj-code = v-cntxt-obj-code)
     3064   B-sch
     3065   B-print
     3066   B-Help
     3067   rs-calc
     3068   sch-code
     3069   br-invline
     3070   WITH FRAME Dialog-Frame.
