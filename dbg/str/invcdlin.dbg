      849   function diff-list returns character (
      850     input parfirst-list  as character,
      851     input parsecond-list as character,
      852     input pardelim       as character).
      853     if pardelim = ""
      854     or pardelim = ?
      855     then do:
      856       assign
      857         pardelim = ","
      858       .
      859     end.
      860     def var ind as integer no-undo .
      861     def var v-elem as character no-undo .
      862     def var v-result-list as character no-undo init "".
      863     def var v-num-parfirst-list as integer no-undo .
      864     assign
      865       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      866     .
      867     do ind = 1 to v-num-parfirst-list
      868     :
      869       assign
      870         v-elem = entry(ind, parfirst-list, pardelim)
      871       .
      872       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      873         assign
      874           v-result-list = v-result-list
      875                         + (if v-result-list > "" then pardelim else "")
      876                         + v-elem
      877         .
      878       end.
      879     end.
      880     return v-result-list .
      881   end function.
      882   function add-list returns character (
