      967   function radio-label returns character (
      968    input par-rs-value  as character,
      969    input par-rs-radio-buttons as character)
      970    .
      971    DEFINE variable v-result-label as character no-undo.
      972    assign
      973    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      974                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      975                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      976                             ), par-rs-radio-buttons
      977                           )
      978    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      979    .
      980   return v-result-label.
      981   end function.
      982   function m-radio-label returns character (
      983    input par-rs-value  as character,
      984    input par-rs-radio-buttons as character,
      985    input par-delim as character
      986    )
      987    .
      988    DEFINE variable v-result-label as character no-undo.
      989    assign
      990    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      991                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      992                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      993                             ), par-rs-radio-buttons, par-delim
      994                           )
      995    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      996    .
      997   return v-result-label.
      998   end function.
      999   FUNCTION mixlist returns character
     1000   (
     1001    input parfirst-list  as character
     1002    ,input parsecond-list as character
     1003    ,input pardelim       as character
     1004    ,input pardelim-result as character ) :
     1005     if pardelim = ""
     1006     or pardelim = ?
     1007     then do:
     1008       assign
     1009         pardelim = ","
     1010       .
     1011     end.
     1012     def var ind as integer no-undo .
     1013     def var v-elem1 as character no-undo .
     1014     def var v-elem2 as character no-undo .
     1015     def var v-result-list as character no-undo init "".
     1016     do ind = 1 to num-entries(parfirst-list, pardelim)
     1017     :
     1018       assign
     1019         v-elem1 = entry(ind, parfirst-list, pardelim)
     1020         v-elem2 = entry(ind, parsecond-list, pardelim)
     1021       .
     1022         assign
     1023           v-result-list = v-result-list
     1024                         + (if v-result-list > "" then pardelim-result else "")
     1025                         + v-elem1 + pardelim-result + v-elem2
     1026         .
     1027     end.
     1028     return v-result-list .
     1029   END FUNCTION.
     1030   define new global shared variable g#libbcrcn as handle no-undo .
     1031   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1032   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1033   procedure fltopend_fltopend :
     1034   define input parameter p-parent-handle as handle no-undo .
     1035   define input parameter p-qh as handle no-undo .
     1036   define input parameter p-flt-open-open-query  as character no-undo .
     1037   define input parameter p-where-cond as character no-undo .
     1038   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1039   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1040   define input parameter p-indexed-reposition as character no-undo .
     1041     do
     1042     on error undo, return error
     1043     :
     1044   define variable v-prepare-string as character no-undo .
     1045   define variable glog as logical no-undo .
     1046   assign
     1047   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1048                      p-where-cond + chr(32)  +
     1049                      p-use-indFIRST-query-tail + chr(32) +
     1050                      p-use-ind-sort-clmn-by + chr(32) +
     1051                      p-indexed-reposition
     1052   .
     1053   assign
     1054   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1055   if not glog
     1056   or error-status:error then do:
     1057     message error-status:get-message(1) view-as alert-box .
     1058     undo, return error .
     1059   end.
     1060   assign
     1061   glog = p-qh:query-open no-error .
     1062   if not glog
     1063   or error-status:error then do:
     1064     message error-status:get-message(1) view-as alert-box .
     1065     undo, return error .
     1066   end.
     1067     end.
     1068   end procedure.
     1069   procedure fltopend_fltfindd :
     1070   define input parameter p-parent-handle as handle no-undo .
     1071   define input parameter p-qh as handle no-undo .
     1072   define input parameter p-rowid as rowid no-undo .
     1073   define input parameter p-next as logical no-undo .
     1074   define input parameter p-lock as integer no-undo .
     1075   define input parameter p-bh as handle no-undo .
     1076   define input parameter p-where-cond as character no-undo .
     1077   define input parameter p-use-index-phrase as character no-undo .
     1078   define variable glog as logical no-undo .
     1079   define variable v-qh as handle no-undo .
     1080   define variable v-bh as handle no-undo .
     1081   define variable v-recid as recid no-undo .
     1082   define variable v-prepare-string as character no-undo .
     1083   do
     1084   on error undo, return error
     1085   on stop undo, return error
     1086   :
     1087     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1088     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1089     create query v-qh.
     1090     v-qh:set-buffers(v-bh).
     1091     v-prepare-string = substitute("for each &1 &2 &3"
     1092                                     ,v-bh:name
     1093                                     ,p-where-cond
     1094                                     ,p-use-index-phrase).
     1095     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1096     if not glog then do:
     1097       delete object v-qh.
     1098       delete object v-bh.
     1099       undo, return error .
     1100     end.
     1101     glog = v-qh:query-open no-error .
     1102     if not glog then do:
     1103       delete object v-qh.
     1104       delete object v-bh.
     1105       undo, return error .
     1106     end.
     1107     if p-next then do:
     1108       v-qh:reposition-to-rowid(p-rowid) no-error .
     1109       glog = v-qh:get-next( p-lock) no-error .
     1110       glog = v-qh:get-next( p-lock) no-error .
     1111       if not glog or v-qh:query-off-end = yes then do:
     1112         glog = v-qh:get-first( p-lock) no-error .
     1113       end.
     1114     end.
     1115     else do:
     1116       glog = v-qh:get-first( p-lock) no-error .
     1117     end.
     1118     v-recid = v-bh:recid no-error .
     1119     delete object v-qh.
     1120     delete object v-bh.
     1121     return string(v-recid) .
     1122   end.
     1123   end procedure.
     1124   procedure fltopend_fltfindq :
     1125   define input parameter p-parent-handle as handle no-undo .
     1126   define input parameter p-qh as handle no-undo .
     1127   define input parameter p-next as logical no-undo .
     1128   define input parameter p-lock as integer no-undo .
     1129   define input parameter p-flt-open-open-query  as character no-undo .
     1130   define input parameter p-where-cond as character no-undo .
     1131   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1132   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1133   define input parameter p-indexed-reposition as character no-undo .
     1134   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1135   define variable glog as logical no-undo .
     1136   define variable v-qh as handle no-undo .
     1137   define variable v-bh as handle no-undo extent 18.
     1138   define variable v-rowid as rowid no-undo extent 18.
     1139   define variable v-ii as integer no-undo .
     1140   define variable v-prepare-string as character no-undo .
     1141   do
     1142   on error undo, return error
     1143   on stop undo, return error
     1144   :
     1145     create query v-qh.
     1146     do v-ii = 1 to p-qh:num-buffers:
     1147       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1148       assign
     1149       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1150       no-error.
     1151       v-qh:add-buffer(v-bh[v-ii]).
     1152     end.
     1153     assign
     1154     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1155                       p-where-cond + chr(32)  +
     1156                       p-use-indFIRST-query-tail + chr(32) +
     1157                       p-use-ind-sort-clmn-by + chr(32) +
     1158                       p-indexed-reposition
     1159     .
     1160     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1161     if not glog then do:
     1162       delete object v-qh.
     1163       do v-ii = 1 to p-qh:num-buffers:
     1164         delete object v-bh[v-ii].
     1165       end.
     1166       undo, return error .
     1167     end.
     1168     glog = v-qh:query-open no-error .
     1169     if not glog then do:
     1170       delete object v-qh.
     1171       do v-ii = 1 to p-qh:num-buffers:
     1172         delete object v-bh[v-ii].
     1173       end.
     1174       undo, return error .
     1175     end.
     1176     if p-next then do:
     1177       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1178       glog = v-qh:get-next( p-lock) no-error .
     1179       glog = v-qh:get-next( p-lock) no-error .
     1180       if not glog or v-qh:query-off-end = yes then do:
     1181         glog = v-qh:get-first( p-lock) no-error .
     1182       end.
     1183     end.
     1184     else do:
     1185       glog = v-qh:get-first( p-lock) no-error .
     1186     end.
     1187     do v-ii = 1 to p-qh:num-buffers:
     1188       assign
     1189       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1190       no-error.
     1191     end.
     1192     delete object v-qh.
     1193     do v-ii = 1 to p-qh:num-buffers:
     1194       delete object v-bh[v-ii].
     1195     end.
     1196   end.
     1197   end procedure.
     1198   define variable filter-label0 as character no-undo init "Список строк инвентаризации с кассы" .
     1199   define variable filter-point0 as character no-undo INIT "invcdlin":U .
