      932   function cross-list returns character (
      933    input parfirst-list  as character,
      934    input parsecond-list as character,
      935    input pardelim       as character).
      936     if pardelim = ""
      937     or pardelim = ?
      938     then do:
      939       assign
      940         pardelim = ","
      941       .
      942     end.
      943     def var ind as integer no-undo .
      944     def var v-elem as character no-undo .
      945     def var v-result-list as character no-undo init "".
      946     def var v-num-parfirst-list as integer no-undo .
      947     assign
      948       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      949     .
      950     do ind = 1 to v-num-parfirst-list
      951     :
      952       assign
      953         v-elem = entry(ind, parfirst-list, pardelim)
      954       .
      955       if lookup(v-elem, v-result-list, pardelim) = 0
      956       and lookup(v-elem, parsecond-list, pardelim) > 0
      957       then do:
