      368   on alt-shift-f4 anywhere do:
      369     run proc-alt-shift-f4 in this-procedure.
      370   end.
      371   on alt-f1 anywhere do:
      372     run proc-alt-f1 in this-procedure .
      373   end.
      374   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375     define variable v-cntxt-db-num        as integer   no-undo .
      376     define variable v-cntxt-userid        as character no-undo .
      377     define variable v-cntxt-level         as character no-undo .
      378     define variable v-cntxt-host-code-obj as integer   no-undo .
      379     define variable v-cntxt-obj-type      as character no-undo .
      380     define variable v-cntxt-obj-code      as integer   no-undo .
      381     define variable v-cntxt-db-num-obj    as integer   no-undo .
      382     define variable v-cntxt-is-admin      as logical   no-undo .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   define variable c-point  as character no-undo .
      385   define variable tbl      as character no-undo .
      386   define variable join-tbl as character no-undo .
      387   define variable fld      as character no-undo .
      388   define variable lab      as character no-undo .
      389   define variable spr      as character no-undo .
      390   define variable dim      as character no-undo .
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   procedure cur-time :
      393      define output parameter p-today as date      no-undo .
      394      define output parameter p-time  as integer   no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       define variable v-date1 as date      no-undo .
      399       define variable v-date2 as date      no-undo .
      400       define variable v-time  as integer   no-undo .
      401       assign
      402         v-date1 = today
      403         v-time  = time
      404         v-date2 = today
      405       .
      406       if v-date1 <> v-date2
      407       then do:
      408         assign
      409           v-date1 = today
      410           v-time  = v-time
      411         .
      412       end.
      413       assign
      414         p-today = v-date1
      415         p-time  = v-time
      416       .
      417     end.
      418   end.
      419   function cur-time-date returns character
      420   :
      421     return string(today, '99/99/9999':U) .
      422   end.
      423   function cur-time-mjd returns decimal
      424   :
      425     define variable v-date as date      no-undo .
      426     define variable v-time as integer   no-undo .
      427     run cur-time in this-procedure
      428       (output v-date
      429       ,output v-time
      430       ) .
      431     return integer(v-date) - 2400002 + (v-time / 86400) .
      432   end.
      433   function cur-time-get-ending-index returns integer
      434   (input p-number as integer
      435   )
      436   :
      437     if p-number < 0
      438     or p-number = ?
      439     then do:
      440       return 1 .
      441     end.
      442     define variable v-rest as integer   no-undo .
      443     assign
      444       p-number = p-number modulo 100
      445     .
      446     if p-number < 20
      447     then do:
      448       assign
      449         v-rest = p-number
      450       .
      451     end.
      452     else do:
      453       assign
      454         v-rest = p-number modulo 10
      455       .
      456     end.
      457     case v-rest :
      458       when 1
      459       then do:
      460         return 2 .
      461       end.
      462       when 2 or
      463       when 3 or
      464       when 4
      465       then do:
      466         return 3 .
      467       end.
      468       otherwise do:
      469         return 1 .
      470       end.
      471     end case .
      472   end.
      473   procedure cur-time-mjd-to-date :
      474      define input  parameter i-mjd-diff as decimal no-undo.
      475      define output parameter o-Date     as date    no-undo.
      476      define output parameter o-Time     as integer no-undo.
      477      define variable v-day-number as integer   no-undo .
      478      if    i-mjd-diff < 0
      479         or i-mjd-diff = ?
      480      then do:
      481         return "?" .
      482      end.
      483      assign
      484         v-day-number = truncate(i-mjd-diff,0).
      485         o-Date = date(v-day-number + 2400002).
      486         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      487     .
      488   end.
      489   function cur-time-mjd-to-string returns character
      490   (input p-mjd-diff as decimal
      491   )
      492   :
      493     define variable v-day-number as integer   no-undo .
      494     define variable v-seconds    as integer   no-undo .
      495     define variable v-hour       as integer   no-undo .
      496     define variable v-min        as integer   no-undo .
      497     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      498     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      499     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      500     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      501     if p-mjd-diff < 0
      502     or p-mjd-diff = ?
      503     then do:
      504       return "?" .
      505     end.
      506     assign
      507       v-day-number = integer(truncate(p-mjd-diff,0))
      508       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      509     .
      510     if v-seconds > 86400
      511     then do:
      512       assign
      513         v-seconds = 86400 - 1
      514       .
      515     end.
      516     if v-seconds < 0
      517     then do:
      518       assign
      519         v-seconds = 0
      520       .
      521     end.
      522     assign
      523       v-hour = truncate(v-seconds / 3600, 0)
      524     .
      525     assign
      526       v-seconds = v-seconds modulo 3600
      527     .
      528     assign
      529       v-min = truncate(v-seconds / 60, 0)
      530     .
      531     assign
      532       v-seconds = v-seconds modulo 60
      533     .
      534     return
      535         (if v-day-number <> 0
      536           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      537           else ""
      538         )
      539       + (if v-day-number <> 0 or v-hour <> 0
      540           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      541           else ""
      542         )
      543       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      544           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      545           else ""
      546         )
      547       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      548       .
      549   end.
      550   function cur-time-string returns character
      551   :
      552     define variable v-date as date      no-undo .
      553     define variable v-time as integer   no-undo .
      554     run cur-time in this-procedure
      555       (output v-date
      556       ,output v-time
      557       ) .
      558     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      559   end.
      560   function cur-time-string-sec returns character
      561   :
      562     define variable v-date as date      no-undo .
      563     define variable v-time as integer   no-undo .
      564     run cur-time in this-procedure
      565       (output v-date
      566       ,output v-time
      567       ) .
      568     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      569   end.
      570   function cur-time-custom  returns character
      571   (input p-prefix as character
      572   ,input p-date-format as character
      573   ,input p-delimiter as character
      574   ,input p-time-format as character
      575   ,input p-suffix as character
      576   )
      577   :
      578     define variable v-date as date      no-undo .
      579     define variable v-time as integer   no-undo .
      580     run cur-time in this-procedure
      581       (output v-date
      582       ,output v-time
      583       ) .
      584     return
      585       p-prefix
      586       + string(v-date, p-date-format)
      587       + p-delimiter
      588       + string(v-time, p-time-format)
      589       + p-suffix
      590       .
      591   end.
      592   function cur-time-print  returns character
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      601   end.
      602   function cur-time-datetime returns datetime
      603   :
      604     define variable v-char as character no-undo .
      605     define variable v-datetime as datetime no-undo .
      606     v-char = cur-time-string().
      607     v-datetime = datetime(v-char).
      608     return  v-datetime.
      609   end.
      610   function cur-time-string-msec returns character
      611   :
      612     define variable v-date as datetime  no-undo .
