     1205   define variable varscales-pref as character no-undo .
     1206   define variable varpgscales-pref as character no-undo .
     1207   define variable gds-rec as recid no-undo .
     1208   DEFINE BUFFER FIND_chk-gds FOR ub.chk-gds.
     1209   FUNCTION get-prt-name RETURNS CHARACTER (  BUFFER buf_bar-code FOR ub.bar-code, BUFFER buf_goods FOR ub.goods )  FORWARD.
     1210   DEFINE BUTTON b-calc
     1211        LABEL "&Посчитать"
     1212        SIZE 10 BY 1.
