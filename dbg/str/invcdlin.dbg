     3681   PROCEDURE proc-b-print :
     3682   DEFINE INPUT PARAMETER p-calc AS LOGICAL NO-UNDO.
     3683   DEFINE VARIABLE accum-count AS INTEGER NO-UNDO.
     3684   DEFINE variable ACCUM-SRC-QNTY AS DECIMAL NO-UNDO.
     3685   DEFINE variable ACCUM-DOC-QNTY AS DECIMAL NO-UNDO.
     3686   define variable date_string as character no-undo .
     3687   define variable line as character no-undo .
     3688   DEFINE BUFFER buf_chk-gds FOR ub.chk-gds.
     3689   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     3690   DEFINE BUFFER buf_goods FOR ub.goods.
     3691   DEFINE FRAME PrnFrame
     3692   buf_chk-gds.is-error COLUMN-LABEL "Посчи!тан" FORMAT "+/":U
     3693   buf_chk-gds.b-code FORMAT "999999999":U
     3694   buf_chk-gds.doc-qnty FORMAT "->>,>>>,>>9.<<<":U
     3695   buf_bar-code.unit-cli COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     3696   buf_goods.gds-name FORMAT "X(48)":U
     3697   buf_bar-code.gds-code FORMAT "999999999":U
     3698   buf_chk-gds.src-code COLUMN-LABEL "Бар-код в чеке" FORMAT "X(16)":U
     3699   buf_chk-gds.src-qnty FORMAT "->>,>>>,>>9.<<<":U
     3700   buf_chk-gds.line-num COLUMN-LABEL "Строка" FORMAT "99999":U
     3701   buf_chk-gds.doc-code COLUMN-LABEL "Номер чека" FORMAT "X(20)":U
     3702   HEADER  date_string AT 5 format "X(35)"
     3703   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     3704   Line format "X(198)" AT 1
     3705   with width 232 down stream-io use-text    .
     3706   Line = fill("-", 198).
     3707   date_string = cur-time-print() .
     3708   run prn-lib-open-stream  in this-procedure (
     3709                                                input parParentProc
     3710                                               ,input 43
     3711                                               ,input yes
     3712                                               ,input no
     3713                                               ).
     3714   PUT  STREAM PrnLibStream
     3715   ( frame Dialog-Frame:title )
     3716   format "x(198)" SKIP(1) .
     3717   FORM HEADER
     3718   Line format "X(198)" AT 1 SKIP
     3719   "Продолжение - на следующей странице" AT 30 SKIP
     3720   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3721   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3722   FORM with FRAME prnFrame  .
     3723   run waitfram-show in this-procedure (  input "Ждите...").
     3724   FOR EACH buf_CHK-GDS NO-LOCK WHERE
     3725           BUF_CHK-GDS.OUT-CODE = P-DOC-CODE:
     3726     FIND FIRST BUF_BAR-CODE NO-LOCK WHERE BUF_BAR-CODE.B-CODE = BUF_CHK-GDS.B-CODE NO-ERROR.
     3727     IF AVAILABLE BUF_BAR-CODE THEN DO:
     3728        FIND FIRST BUF_GOODS NO-LOCK WHERE
     3729                   BUF_GOODS.GDS-CODE = BUF_BAR-CODE.GDS-CODE NO-ERROR.
     3730     END.
     3731     if p-calc = ? then do:
     3732     end.
     3733     else do:
     3734       IF p-calc = YES AND buf_chk-gds.is-error THEN NEXT.
     3735       IF p-calc = no AND NOT buf_chk-gds.is-error THEN NEXT.
     3736     end.
     3737     Display STREAM PrnLibStream
     3738     NOT(buf_chk-gds.is-error) @ buf_chk-gds.is-error
     3739     buf_chk-gds.b-code
     3740     buf_chk-gds.doc-qnty
     3741     buf_chk-gds.src-code
     3742     buf_chk-gds.src-qnty
     3743     buf_chk-gds.line-num
     3744     buf_chk-gds.doc-code
     3745     buf_bar-code.unit-cli when available buf_bar-code
     3746     buf_bar-code.gds-code when available buf_bar-code
     3747     BUF_GOODS.GDS-NAME when available buf_goods
     3748     with FRAME prnFrame .
     3749     assign
     3750     accum-count = accum-count + 1
     3751     ACCUM-SRC-QNTY = ACCUM-SRC-QNTY + BUF_CHK-GDS.SRC-QNTY
     3752     ACCUM-DOC-QNTY = ACCUM-DOC-QNTY + BUF_CHK-GDS.DOC-QNTY
     3753     .
     3754   END.
     3755   UNDERLINE  STREAM PrnLibStream
     3756   buf_chk-gds.b-code
     3757   buf_chk-gds.doc-qnty
     3758   buf_chk-gds.src-code
     3759   buf_chk-gds.src-qnty
     3760   buf_chk-gds.line-num
     3761   buf_chk-gds.doc-code
     3762   buf_bar-code.unit-cli
     3763   buf_bar-code.gds-code
     3764   BUF_GOODS.GDS-NAME
     3765   with FRAME prnFrame .
     3766   DISPLAY STREAM PrnLibStream
     3767   accum-count @ buf_chk-gds.b-code
     3768   ACCUM-SRC-QNTY @ BUF_CHK-GDS.SRC-QNTY
     3769   ACCUM-DOC-QNTY @ BUF_CHK-GDS.doc-QNTY
     3770   with frame prnFrame.
     3771   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3772   HIDE  STREAM PrnLibStream FRAME PrnFrame.
     3773   output  STREAM PrnLibStream CLOSE.
     3774   run waitfram-hide in this-procedure.
     3775   run prn-lib-prn-file in this-procedure (
     3776                                             input parParentProc
     3777                                             ,input 8
     3778                                             ).
     3779   END PROCEDURE.
     3780   PROCEDURE proc-b-sch :
     3781   assign
     3782     tbl = 'chk-gds'
     3783     join-tbl = 'X_chk-gds'
     3784     fld = ""
     3785     lab = ""
     3786     spr = ""
     3787     dim = '0'
     3788     .
     3789   run fltfield-add in this-procedure('doc-code', 'Номер чека в базе', '',
     3790   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3791   run fltfield-add in this-procedure('line-num', 'Номер строки', '',
     3792   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3793   run fltfield-add in this-procedure('src-code', 'Код в чеке', '',
     3794   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3795   run fltfield-add in this-procedure('doc-qnty', 'Кол-во в чеке', '',
     3796   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3797   run fltfield-add in this-procedure('src-code', 'Код', '',
     3798   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3799   run fltfield-add in this-procedure('doc-qnty', 'Кол-во', '',
     3800   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3801   run fltfield-add in this-procedure('is-error', 'Посчитан', '',
     3802   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3803   Filter-Block:
     3804   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3805       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3806       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3807     run gbl/filter.w (
     3808                    INPUT parparentproc
     3809                  , INPUT (filter-point + chr(4) + filter-label)
     3810                  , INPUT tbl
     3811                  , INPUT join-tbl
     3812                  , INPUT fld
     3813                  , INPUT lab
     3814                  , INPUT spr
     3815                  , INPUT dim ).
     3816     if return-value = 'undo':U then return error.
     3817     run OpenBr in this-procedure ( input yes, input no, input '':U).
     3818   END.
     3819   END PROCEDURE.
     3820   PROCEDURE proc-find-code :
     3821   define input parameter par-next as logical no-undo.
     3822   define input parameter p-sch-code like ub.chk-gds.src-code no-undo.
     3823   DEFINE VARIABLE v-src-code AS CHARACTER NO-UNDO.
     3824   DEFINE VARIABLE varresult AS CHARACTER NO-UNDO.
     3825   DEFINE VARIABLE vartype-bc AS CHARACTER NO-UNDO.
     3826   define variable varweight   as decimal           no-undo.
     3827   define buffer buf_bar-code for ub.bar-code .
     3828   define buffer buf_prod-bc for ub.prod-bc.
     3829   define buffer buf_place for ub.place.
     3830   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     3831   (
     3832    input  parparentproc
     3833   ,input  p-sch-code
     3834   ,input  ?
     3835   ,input  buf_trn-doc.obj-type
     3836   ,input  buf_trn-doc.obj-code
     3837   ,input  yes
     3838   ,input  no
     3839   ,input  varscales-pref
     3840   ,input  varpgscales-pref
     3841   ,output varresult
     3842   ,output vartype-bc
     3843   ,output varweight
     3844   ,buffer buf_bar-code
     3845   ,buffer buf_prod-bc
     3846   ,buffer buf_place
     3847   ) no-error.
     3848   IF AVAILABLE buf_bar-code THEN DO:
     3849       run OpenBr in this-procedure (
     3850        input false
     3851       ,input par-next
     3852       ,input substitute("and X_chk-gds.b-code = &1 "
     3853         , buf_bar-code.b-code)
     3854       ).
     3855   END.
     3856   ELSE DO:
     3857      ASSIGN
     3858      v-src-code = chr(34) + p-sch-code + chr(34).
     3859       run OpenBr in this-procedure (
     3860        input false
     3861       ,input par-next
     3862       ,input substitute("and X_chk-gds.src-code = &1 "
     3863         , v-src-code)
     3864       ).
     3865   END.
     3866   apply "entry":u to sch-code in frame Dialog-Frame .
     3867   END PROCEDURE.
     3868   FUNCTION get-prt-name RETURNS CHARACTER (BUFFER buf_bar-code FOR ub.bar-code, BUFFER buf_goods FOR ub.goods):
     3869   define variable var-artic like ub.goods.artic no-undo.
     3870   define variable  pargds-name as character no-undo.
     3871   define variable  parprt-name as character no-undo.
     3872   define buffer loc_gds-prt for ub.gds-prt.
     3873   IF  AVAILABLE buf_bar-code then do:
     3874       FIND FIRST loc_gds-prt WHERE
     3875                          loc_gds-prt.node-code = buf_bar-code.node-code NO-LOCK.
     3876       assign
     3877       parprt-name =
     3878                       ( if loc_gds-prt.node-name = '_Пустая шкала':U then "-"
     3879                         else ( if loc_gds-prt.upper-code = buf_goods.prt-root
     3880                                   then "-------------------" else loc_gds-prt.f-name ) ) .
     3881   end.
     3882     RETURN parprt-name.
     3883   END FUNCTION.
