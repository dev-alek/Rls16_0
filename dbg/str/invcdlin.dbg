     3073   PROCEDURE OpenBr :
     3074   define input  parameter p-open-query     as logical   no-undo .
     3075   define input  parameter p-find-next      as logical   no-undo .
     3076   define input  parameter p-find-condition as character no-undo .
     3077   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     3078   run waitfram-show in this-procedure ( input "Ждите...").
     3079   DEFINE VARIABLE sort-column-phrase as character no-undo .
     3080   DEFINE VARIABLE title0 as character no-undo INIT "Список строк инвентаризации по кассе".
     3081   case sort-column-name :
     3082     when "" then do:
     3083       assign
     3084         sort-column-phrase = ""
     3085       .
     3086     end.
     3087     otherwise do:
     3088       assign
     3089         sort-column-phrase = "by " + sort-column-name
     3090       .
     3091     end.
     3092   end case.
     3093   define variable l-open-query as logical   no-undo .
     3094       ASSIGN
     3095       filter-point = filter-point0 + chr(44) + (if rs-calc = ? then chr(63) else string(rs-calc))
     3096       filter-label = filter-label0 + chr(32) + (if (radio-label(string(rs-calc), rs-calc:RADIO-BUTTONS IN FRAME Dialog-Frame)) = ?
     3097                                                       then chr(63)
     3098                                                       else radio-label(string(rs-calc), rs-calc:RADIO-BUTTONS IN FRAME Dialog-Frame)
     3099                                                       )
     3100       title0 = SUBSTITUTE ("&1 документ &2", title0 , p-doc-code)
     3101       .
     3102       if p-open-query then do:
     3103        ASSIGN frame Dialog-Frame:TITLE = substitute("&1 &2"
     3104                                                     , title0
     3105                                                     , (if rs-calc <> ?
     3106                                                        then ("Посчитаны:" + chr(32) + string(rs-calc, "+/"))
     3107                                                        else '':U)
     3108                                                      ).
     3109       end.
     3110   CASE Rs-calc:
     3111     when ? then do:
     3112   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3113   define variable  l-disable-where-28  as logical   no-undo .
     3114   define variable  l-filter-open-28    as logical   .
     3115   define variable  flt-rec-28       as recid     no-undo .
     3116   define variable  filter-name-28      as character no-undo .
     3117   define variable  where-phrase-28     as character no-undo .
     3118   define variable  sort-phrase-28      as character no-undo .
     3119   define variable  where-phrase-rus-28 as character no-undo .
     3120   define variable  sort-phrase-rus-28  as character no-undo .
     3121     run waitfram-show in this-procedure
     3122       (input "ЖДИТЕ ..."
     3123       ).
     3124   run gbl/flt-get.p
     3125     (input filter-point
     3126     ,output flt-rec-28
     3127     ,output filter-name-28
     3128     ,output where-phrase-28
     3129     ,output sort-phrase-28
     3130     ,output where-phrase-rus-28
     3131     ,output sort-phrase-rus-28
     3132     ).
     3133   if p-open-query then do:
     3134       run set-filter-name in this-procedure
     3135         (INPUT filter-name-28
     3136         ) no-error .
     3137     assign
     3138       l-filter-open-28 = false
     3139     .
     3140     if flt-rec-28 <> ?
     3141       or sort-column-phrase > ""
     3142     then do:
     3143       define variable  parameter-2-28 as character no-undo .
     3144       define variable  parameter-3-28 as character no-undo .
     3145       define variable  parameter-4-28 as character no-undo .
     3146       define variable  parameter-5-28 as character no-undo .
     3147       define variable  parameter-6-28 as character no-undo .
     3148       define variable  parameter-7-28 as character no-undo .
     3149         assign
     3150         parameter-3-28 =
     3151                                 "FOR EACH X_chk-gds"
     3152         parameter-4-28 =
     3153           (
     3154             if (" X_chk-gds.out-code = p-doc-code " + " " + where-phrase-28) <> ""
     3155             then  substitute('X_chk-gds.out-code = &1&2&1', chr(34), p-doc-code ) + " " + where-phrase-28
     3156             else "true"
     3157           )
     3158         parameter-5-28 = (" " + "" + " " + ", FIRST X_bar-code No-LOCK outer-join WHERE X_bar-code.b-code = X_chk-gds.b-code,  FIRST X_goods NO-LOCK OUTER-JOIN WHERE X_goods.gds-code = X_bar-code.gds-code")
     3159         parameter-6-28 = if sort-phrase-28 = ''
     3160                              then
     3161           (
     3162           " " + "  " +
     3163             " " + sort-column-phrase +
     3164           " " + " "
     3165           )
     3166                              else
     3167           (
     3168           " " + "  " +
     3169             " " + sort-column-phrase +
     3170           " " + sort-phrase-28
     3171           )
     3172         parameter-7-28 =
     3173           "   "
     3174       .
     3175       do
     3176       on stop undo, leave
     3177       on error undo, leave
     3178       :
     3179         assign
     3180           l-disable-where-28 =
     3181             (" X_chk-gds.out-code = p-doc-code " + " " + where-phrase-28 = "")
     3182         .
     3183         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3184                             ,input QUERY br-invline:handle
     3185                             ,input parameter-3-28
     3186                             ,input parameter-4-28
     3187                             ,input parameter-5-28
     3188                             ,input parameter-6-28
     3189                             ,input parameter-7-28
     3190                             )
     3191         .
     3192         assign
     3193           l-filter-open-28 = true
     3194         .
     3195       end.
     3196       if l-filter-open-28 = false then do:
     3197         message
     3198           "Ошибка при фильтрации / сортировке" skip
     3199           "Будут показаны записи без учета фильтра" skip
     3200           view-as alert-box .
     3201       end.
     3202       else do:
     3203           assign
     3204             l-query-was-opened = true
     3205           .
     3206       end.
     3207     end.
     3208     if l-filter-open-28 = false then do:
     3209       OPEN QUERY br-invline FOR EACH X_chk-gds
     3210         where  X_chk-gds.out-code = p-doc-code
     3211       , FIRST X_bar-code No-LOCK outer-join WHERE X_bar-code.b-code = X_chk-gds.b-code,  FIRST X_goods NO-LOCK OUTER-JOIN WHERE X_goods.gds-code = X_bar-code.gds-code
     3212     .
     3213         assign
     3214           l-query-was-opened = true
     3215         .
     3216     end.
     3217   end.
     3218   else do:
     3219     assign
     3220       v-doc-rec = recid( ub.chk-gds )
     3221     .
     3222     do
     3223     on stop undo, leave
     3224     on error undo, leave
     3225     :
     3226       if QUERY br-invline:handle:get-buffer-handle(1) = (buffer X_chk-gds:handle) then do:
     3227         assign
     3228         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3229         parameter-4-28 =
     3230           "where ":u +  substitute('X_chk-gds.out-code = &1&2&1', chr(34), p-doc-code ) + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3231         parameter-5-28 = "  "
     3232       .
     3233         run fltopend_fltfindd in this-procedure  (
     3234                             input this-procedure:handle
     3235                             ,input QUERY br-invline:handle
     3236                             ,input rowid(ub.chk-gds)
     3237                             ,input logical(parameter-2-28)
     3238                             ,input no-lock
     3239                             ,input (buffer ub.chk-gds:handle)
     3240                             ,input parameter-4-28
     3241                             ,input parameter-5-28
     3242                             ) no-error.
     3243         .
     3244         assign
     3245           v-doc-rec = integer(return-value)
     3246           v-fltopend-rowid[1] = ?
     3247         .
     3248       end.
     3249       else do:
     3250         assign
     3251         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3252         parameter-3-28 =  "FOR EACH X_chk-gds"
     3253         parameter-4-28 =
     3254           (
