    14202               v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
    14203               v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
    14204               .
    14205             end.
    14206           end.
    14207           LEAVE _do.
    14208         end.
    14209       end.
