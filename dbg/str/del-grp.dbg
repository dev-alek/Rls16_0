     8374   for each thbjattr_thbj-attr:
     8375     delete thbjattr_thbj-attr.
     8376   end.
     8377   assign
     8378   v-tth = buffer thbjattr_thbj-attr:table-handle .
     8379   run adm/shattri.p (
     8380       input "get":U
     8381       ,input  'маг':U
     8382       ,input  i-obj-code
     8383       ,input  'cd-inf-send':U
     8384       ,input  '':U
     8385       ,output v-value-character
     8386       ,output v-value-date
     8387       ,output v-value-decimal
     8388       ,output v-value-integer
     8389       ,output v-value-logical
     8390       ,output v-param-type
     8391       ,INPUT-OUTPUT table-handle v-tth
     8392       ) no-error .
     8393   if error-status:error then return error .
     8394   for each thbjattr_thbj-attr where
     8395           thbjattr_thbj-attr.obj-type = 'маг':U
     8396       and thbjattr_thbj-attr.obj-code = i-obj-code
     8397       and thbjattr_thbj-attr.upper-prop-code = 'cd-inf-send':U
     8398   on error undo, return error :
     8399     case thbjattr_thbj-attr.prop-code:
     8400       when 'nam-artc':U then do:
     8401         nam-artc = thbjattr_thbj-attr.property-value-logical.
     8402       end.
     8403       when 'cod-pcod':U then do:
     8404         cod-pcod = thbjattr_thbj-attr.property-value-logical.
     8405       end.
     8406       when 'tax-cass':U then do:
     8407         tax-cass = thbjattr_thbj-attr.property-value-logical.
     8408       end.
     8409       when 'nam-2str':U then do:
     8410         nam-2str = thbjattr_thbj-attr.property-value-logical.
     8411       end.
     8412       when 'name-2cd':U then do:
     8413         name-2cd = thbjattr_thbj-attr.property-value-character.
     8414       end.
     8415       when 'amntdisc':U then do:
     8416         amntdisc = thbjattr_thbj-attr.property-value-integer.
     8417       end.
     8418       when 'how-temp-disc':U then do:
     8419         how-temp-disc = thbjattr_thbj-attr.property-value-character.
     8420         if how-temp-disc = 'temp-disc-pdf':U then do:
     8421           run get-thbj-rule in this-procedure ( input 'маг':U
     8422                                                ,input i-obj-code
     8423                                                ,input ub.shop.host-code
     8424                                                ,input 'temp-disc-pdf':U
     8425                                                ,input dflt-cd
     8426                                                ,input "1,2,3"
     8427                                                ,buffer buf_dis-thbj-rule
     8428                                                ) no-error.
     8429           if available buf_dis-thbj-rule then do:
     8430             temp-discnt-rule_pdf = buf_dis-thbj-rule.rule-num.
     8431           end.
     8432         end.
     8433         else do:
     8434           temp-discnt-rule_pdf = 0.
     8435         end.
     8436       end.
     8437       when 'how-pcnt-kat':U then do:
     8438         how-pcnt-kat = thbjattr_thbj-attr.property-value-character.
     8439         if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
     8440           run get-thbj-rule in this-procedure ( input 'маг':U
     8441                                                ,input i-obj-code
     8442                                                ,input ub.shop.host-code
     8443                                                ,input 'pcnt-kat-pdf':U
     8444                                                ,input dflt-cd
     8445                                                ,input "1,2,3"
     8446                                                ,buffer buf_dis-thbj-rule
     8447                                                ) no-error.
     8448           if available buf_dis-thbj-rule then do:
     8449             kat-discnt-rule_pdf = buf_dis-thbj-rule.rule-num.
     8450           end.
     8451         end.
     8452         else do:
     8453           kat-discnt-rule_pdf = 0.
     8454         end.
     8455       end.
