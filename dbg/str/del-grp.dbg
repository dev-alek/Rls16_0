     7682   define variable v-main-prt-b-code as integer no-undo .
     7683   define variable IBM-good-code as character no-undo .
     7684   define variable IBM-good-code-2 as character no-undo .
     7685   define variable IBM2-short      as character no-undo .
     7686   define variable v-gds-null-price as character no-undo .
     7687   define variable iii as integer no-undo .
     7688   define variable v-mask-full as character no-undo .
     7689   define variable v-mask-short as character no-undo .
     7690   define variable vKKT as integer no-undo.
     7691   define variable attrValue as character no-undo.
     7692   define variable attrType  as character no-undo.
     7693   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7694   define buffer buf_price-list for ub.price-list.
     7695   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7696   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7697   define buffer main-prt-bar-code  for ub.bar-code.
     7698   define buffer buf_goods-attr for goods-attr.
     7699   define buffer b-code for code.
     7700   if action = "U" then do:
     7701     if loc-bar-code.stts = Integer('79':U) then return.
     7702       for-price = ?.
     7703   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7705     (input  'маг':U
     7706     ,input  ub.shop.obj-code
     7707     ,input  loc-bar-code.b-code
     7708     ,input  main-b-code
     7709     ,input  0
     7710     ,output v-doc-num
     7711     ,output for-price
     7712     ,output for-road
     7713     ,output for-excise
     7714     ) no-error .
     7715       if error-status:error then do:
     7716           if g#news
     7717           or g#auto
     7718           or g#esys
     7719           then return error.
     7720           else do:
     7721               error-status:error = no.
     7722               message "Ошибка при определении цены на товар "
     7723                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7724               view-as alert-box ERROR.
     7725               return.
     7726           end.
     7727       end.
     7728       if return-value = "error" then do:
     7729           if for-price = ? then do:
     7730             return.
     7731           end.
     7732           if not g#news
     7733           and not g#auto
     7734           and not g#esys
     7735           then
     7736           message prichina view-as alert-box ERROR.
     7737           return error.
     7738       end.
     7739       else if (for-price = ? or for-price = 0) then do:
     7740         if v-is-restaurant and v-is-null-price  then do:
     7741           assign
     7742           for-price = 0.
     7743         end.
     7744         else do:
     7745           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7746                                                  ,input 'null-price':U
     7747                                                  ,output v-gds-null-price
     7748                                                  ,output v-type) no-error.
     7749           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7750           return "NEXT".
     7751         end.
     7752       end.
     7753     end.
     7754     else do:
     7755           for-price = 0.
     7756     end.
     7757   for-price = round-m( for-price , rnd-znak ).
     7758   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7759   start-paket = no.
     7760   if not avail cash-gds then do:
     7761   create cash-gds.
     7762   error-status:error = false.
     7763   end.
     7764   cash-gds.crf = cr + 1.
     7765   cr = cr + 1.
     7766   if loc-bar-code.in-code <> ''
     7767   or loc-bar-code.part-code <> ''
     7768   then do:
     7769     find first main-prt-bar-code no-lock where
     7770               main-prt-bar-code.gds-code = loc-goods.gds-code
     7771           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7772           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7773           and main-prt-bar-code.part-code = ''
     7774           and main-prt-bar-code.in-code = '' no-error.
     7775     if available main-prt-bar-code then do:
     7776       v-main-prt-b-code = main-prt-bar-code.b-code.
     7777     end.
     7778   end.
     7779   else do:
     7780     v-main-prt-b-code = loc-bar-code.b-code.
     7781   end.
     7782   find first tt-tax no-lock where
     7783              tt-tax.tax-code = vattaxcd no-error .
     7784   do iii = 1 to num-entries(mask_s-c) :
     7785     assign
     7786       v-mask-full  = trim(entry(iii, mask_s-c))
     7787       v-mask-short = entry(1, v-mask-full, "*")
     7788       loc-prod-bc  = trim(loc-prod-bc)
     7789     .
     7790     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7791       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7792   end.
     7793   define variable vBc-on as logical no-undo.
     7794   if loc-prod-bc ne ?
     7795   then do:
     7796       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7797                            and prod-bc.b-str  eq loc-prod-bc
     7798                            no-lock no-error.
     7799       if available prod-bc
     7800       then
     7801          vBc-on = prod-bc.bc-on.
     7802       else
     7803          vBc-on = yes.
     7804   end.
     7805   else
     7806      vBc-on = yes.
     7807   run gdsoattr-value in this-procedure (
     7808     'dt-seasons':U,
     7809     loc-goods.gds-code,
     7810     parobj-type,
     7811     parobj-code,
     7812     output attrValue,
     7813     output attrType
     7814   ) no-error.
     7815   if attrValue <> "" then do:
     7816     find first b-code where
     7817                b-code.parent = "DTSeasons"
     7818            and b-code.code   = attrValue
     7819          no-lock no-error.
     7820     v-main-prt-b-code = integer(b-code.code).
     7821   end.
     7822   else release b-code.
     7823   assign
     7824   cash-gds.gds-code = loc-goods.gds-code
     7825   cash-gds.artic = loc-goods.artic
     7826   cash-gds.b-code = loc-bar-code.b-code
     7827   cash-gds.main-prt-b-code = v-main-prt-b-code
     7828   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7829   cash-gds.bc-on-type = loc-bc-on-type
     7830   cash-gds.bc-on = vBc-on
     7831   cash-gds.unit-cli = loc-bar-code.unit-cli
     7832   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7833   cash-gds.std-discnt-rule = std-discnt-rule_
     7834   cash-gds.gds-namelong = loc-goods.gds-name
     7835   cash-gds.gds-name = IF nam-2str
     7836                       then if available b-code then b-code.codename else loc-goods.gds-name
     7837                       else (
     7838                             IF nam-artc
     7839                             then loc-goods.artic
     7840                             else if available b-code
     7841                                  then b-code.codename
     7842                                  else (if loc-goods.chk-name <> ""
     7843                                        then loc-goods.chk-name
     7844                                        else loc-goods.gds-name)
     7845                            )
     7846   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7847   cash-gds.unit-base = loc-goods.unit-base
     7848   cash-gds.grp-code = for-grp-code
     7849   cash-gds.fp = for-fp
     7850   cash-gds.ingredient = loc-goods.struct
     7851   cash-gds.producer = for-producer
     7852   cash-gds.producer-int = for-producer-int
     7853   cash-gds.alpha1     = loc-goods.alpha1.
     7854     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7855                                            ,input 'office-type':U
     7856                                            ,output v-oss
     7857                                            ,output v-type) no-error.
     7858   cash-gds.office-type = v-oss.
     7859     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7860                                            ,input 'type-method-calc':U
     7861                                            ,output v-oss
     7862                                            ,output v-type) no-error.
     7863   if v-oss <> "" then
     7864     assign
     7865       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7866       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7867     .
     7868   else
     7869     assign
     7870       cash-gds.CalculationMethod = 0
     7871       cash-gds.CalculationMethodRestr = 0
     7872     .
     7873   assign
     7874   cash-gds.fact-qnty = for-fact-qnty
     7875   cash-gds.okei = loc-bc-units-okei
     7876   cash-gds.kat-discnt-method = kat-discnt-method_
     7877   cash-gds.temp-discnt-method = temp-discnt-method_
     7878   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7879                                then  kat-discnt-rule_pdf
     7880                                else  kat-discnt-rule_)
     7881   cash-gds.date-discnt-rule = date-discnt-rule_
     7882   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7883   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7884   cash-gds.wgd-rule = for-wgd
     7885   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7886                           then 1
     7887                           else 0)
     7888   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7889                        or for-petrol-purse
     7890                        then (cash-gds.gds-stat + 8)
     7891                        else cash-gds.gds-stat)
     7892   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7893                       then (cash-gds.gds-stat + 16)
     7894                       else cash-gds.gds-stat
     7895   cash-gds.gds-stat = if cash-gds.fp
     7896                       then (cash-gds.gds-stat + 2)
     7897                       else cash-gds.gds-stat
     7898   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7899                       then (cash-gds.gds-stat + 128)
     7900                       else cash-gds.gds-stat
     7901   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7902   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7903                                then temp-discnt-rule_pdf
     7904                                else temp-discnt-rule_)
     7905   cash-gds.wd-rule = for-wd
     7906   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7907   cash-gds.need-auth = (if need-auth then 1 else 0)
     7908   cash-gds.price-sale =  for-price
     7909   cash-gds.unit-type = loc-units.type
     7910   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7911   cash-gds.tax-string = tax-string
     7912   cash-gds.new-good = new-good
     7913   cash-gds.rc = recid(loc-goods)
     7914   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7915   cash-gds.vat-pc = (if avail tt-tax
     7916                      then tt-tax.rate-value
     7917                      else 0)
     7918   cash-gds.vat-code = (if avail tt-tax
     7919                        then tt-tax.rate-code
     7920                        else ?)
     7921   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7922   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7923   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7924   cash-gds.fbr-grp-code = v-fbr-grp-code
     7925   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7926   cash-gds.DepartID = v-fbr-obj-code
     7927   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7928   cash-gds.node-code = loc-bar-code.node-code
     7929   cash-gds.taracode = for-taracode
     7930   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7931                            and loc-bar-code.in-code = ""
     7932                            and loc-bar-code.part-code = ""
     7933                            and cash-gds.unit-base = cash-gds.unit-cli
     7934                            then yes
     7935                            else no)
     7936   cash-gds.obj-type = parobj-type
     7937   cash-gds.obj-code = parobj-code
     7938   .
     7939   assign
     7940   cash-gds.gds-name1 =   name-2cdf(
     7941                         input name-2cd
     7942                       , input yes
     7943                       , input cod-pcod
     7944                       , input cash-gds.b-code
     7945                       , input loc-goods.gds-code
     7946                       , input loc-goods.artic
     7947                       , input loc-goods.engl-name
     7948                       , input loc-bar-code.in-code
     7949                       , input loc-bar-code.part-code
     7950                       , input parobj-type
     7951                       , input parobj-code
     7952                       , input loc-goods.alpha1
     7953                       , output v-gtd
     7954                       )
     7955   cash-gds.gtd   = v-gtd
     7956   .
     7957   vKKT = 255.
     7958   find first b-code where
     7959              b-code.parent  = "okei-kkt"
     7960          and b-code.code    = string(cash-gds.okei)
     7961          and b-code.status_ = 0
     7962   no-lock no-error.
     7963   if avail b-code then
     7964      vKKT = integer(b-code.CodeName) no-error.
     7965   if error-status:error then vKKT = 255.
     7966   cash-gds.kkt = vKKT.
     7967   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7968      run gds-attr-value in this-procedure  (
     7969                                             input cash-gds.gds-code
     7970                                            ,input 'fuel-type':U
     7971                                            ,output v-is-gas
     7972                                            ,output v-type) no-error.
     7973      run gds-attr-value in this-procedure  (
     7974                                             input cash-gds.gds-code
     7975                                            ,input 'ptrl-as-good':U
     7976                                            ,output v-ptrl-as-good
     7977                                            ,output v-type) no-error.
     7978      assign
     7979      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7980      no-error .
     7981      assign
     7982      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7983      no-error .
     7984      if cash-gds.is-gas then do:
     7985        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7986      end.
     7987   end.
     7988      run gds-attr-value in this-procedure  (
     7989                                             input cash-gds.gds-code
     7990                                            ,input 'ban-bonus':U
     7991                                            ,output v-ban-bonus
     7992                                            ,output v-type) no-error.
     7993     assign
     7994      cash-gds.wd = int(logical(v-ban-bonus))
     7995      no-error .
     7996   if how-temp-disc = 'temp-disc':U then do:
     7997     case temp-discnt-method_:
     7998       when "" then do:
     7999       end.
     8000       when "bar-code.b-code" then do:
     8001         if loc-bar-code.in-code <> ''
     8002         or loc-bar-code.part-code <> ''
     8003         then do:
     8004           disc-b-code = cash-gds.main-prt-b-code.
     8005         end.
     8006         else do:
     8007           disc-b-code = cash-gds.b-code.
     8008         end.
     8009         find first buf_temp-dis-gds-rule where
     8010                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     8011             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     8012         if available buf_temp-dis-gds-rule then do:
     8013             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     8014         end.
     8015       end.
     8016       otherwise do:
     8017         cash-gds.temp-discnt-rule = 0.
     8018       end.
     8019     end.
     8020   end.
     8021   assign
     8022   cash-gds.gds-name1 =   name-2cdf(
     8023                         input name-2cd
     8024                       , input yes
     8025                       , input cod-pcod
     8026                       , input cash-gds.b-code
     8027                       , input loc-goods.gds-code
     8028                       , input loc-goods.artic
     8029                       , input loc-goods.engl-name
     8030                       , input loc-bar-code.in-code
     8031                       , input loc-bar-code.part-code
     8032                       , input parobj-type
     8033                       , input parobj-code
     8034                       , input loc-goods.alpha1
     8035                       , output v-gtd
     8036                       )
     8037   cash-gds.gtd   = v-gtd
     8038   .
     8039   assign
     8040   cash-gds.ean-lz = ''
     8041   cash-gds.ean-rz = ''
     8042   cash-gds.code-short = ''
     8043   .
     8044   run ibm-gdsc in this-procedure (input no
     8045                                 , output cash-gds.ean-lz
     8046                                 , output cash-gds.ean-rz
     8047                                 , output cash-gds.code-short
     8048                                 ) no-error .
     8049   if new-good then new-good = not new-good.
     8050   if action = "U" then do:
     8051     if cash-gds.kat-discnt-rule <> 0
     8052     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8053     then do:
     8054       for each cash-dis-rule no-lock where
     8055             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8056       :
     8057         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8058                                             ,input 'маг':U
     8059                                             ,input i-obj-code
     8060                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8061                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8062                                             ,input ?
     8063                                             ,output v-disc-price-sale
     8064                                             ,output v-pdf-id
     8065                                             ,output v-pdf-db-num ) no-error.
     8066         if error-status:error
     8067         or v-disc-price-sale = 0
     8068         or v-disc-price-sale = ?
     8069         then do:
     8070         end.
     8071         else do:
     8072           find first  cash-gds-discnt where
     8073                     cash-gds-discnt.b-code = cash-gds.b-code
     8074                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8075                   and cash-gds-discnt.obj-type = parobj-type
     8076                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8077           if not available cash-gds-discnt then do:
     8078             find first  cash-gds-discnt where
     8079                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8080             if not available cash-gds-discnt then do:
     8081               create cash-gds-discnt.
     8082               assign
     8083               cash-gds-discnt.crf = crgd + 1.
     8084             end.
     8085             crgd = crgd + 1.
     8086             assign
     8087             cash-gds-discnt.b-code = cash-gds.b-code
     8088             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8089             cash-gds-discnt.obj-type = parobj-type
     8090             cash-gds-discnt.obj-code = parobj-code
     8091             cash-gds-discnt.discnt-value = v-disc-price-sale
     8092             .
     8093             release cash-gds-discnt.
     8094           end.
     8095         end.
     8096       end.
     8097     end.
     8098     if cash-gds.temp-discnt-rule <> 0
     8099     and how-temp-disc = 'temp-disc-pdf':U
     8100     then do:
     8101       for each cash-dis-rule no-lock where
     8102             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8103         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8104         and cash-dis-rule.is-term = yes
     8105       :
     8106         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8107                                             ,input 'маг':U
     8108                                             ,input i-obj-code
     8109                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8110                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8111                                             ,input ?
     8112                                             ,output v-disc-price-sale
     8113                                             ,output v-pdf-id
     8114                                             ,output v-pdf-db-num ) no-error.
     8115         if error-status:error
     8116         or v-disc-price-sale = 0
     8117         or v-disc-price-sale = ?
     8118         then do:
     8119         end.
     8120         else do:
     8121           find first  cash-gds-discnt where
     8122                     cash-gds-discnt.b-code = cash-gds.b-code
     8123                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8124                   and cash-gds-discnt.obj-type = parobj-type
     8125                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8126           if not available cash-gds-discnt then do:
     8127             find first  cash-gds-discnt where
     8128                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8129             if not available cash-gds-discnt then do:
     8130               create cash-gds-discnt.
     8131               assign
     8132               cash-gds-discnt.crf = crgd + 1.
     8133             end.
     8134             crgd = crgd + 1.
     8135             assign
     8136             cash-gds-discnt.b-code = cash-gds.b-code
     8137             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8138             cash-gds-discnt.obj-type = parobj-type
     8139             cash-gds-discnt.obj-code = parobj-code
     8140             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8141             release cash-gds-discnt.
     8142           end.
     8143         end.
     8144       end.
     8145     end.
     8146   end.
     8147   END PROCEDURE.
