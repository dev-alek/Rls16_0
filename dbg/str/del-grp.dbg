     1534   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1537   procedure disrules-fill-properties:
     1538   define input  parameter p-templ-rl-root as integer   no-undo .
     1539   define buffer buf_drt-prop for ub.drt-prop.
     1540   define buffer buf_temp-drt-prop for temp-drt-prop.
     1541   do
     1542   on error undo, return error return-value
     1543   :
     1544     for each buf_temp-drt-prop:
     1545       delete buf_temp-drt-prop.
     1546     end.
     1547     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1548       create buf_temp-drt-prop.
     1549       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1550     end.
     1551   end.
     1552   end procedure.
     1553   ~
     1554   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   procedure discfgru-check :
     1556   define input parameter p-table-name as character no-undo .
     1557   define input parameter p-templ-rl-root as integer no-undo .
     1558   define input parameter p-time-templ-rl-root as integer no-undo .
     1559   define input parameter p-pos-type as character no-undo .
     1560   define output parameter p-disnct-role as character no-undo .
     1561   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1562     do
     1563     on error undo, return error return-value
     1564     :
     1565       find first buf_dis-cfg-rule no-lock where
     1566               buf_dis-cfg-rule.table-name = p-table-name
     1567           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1568           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1569           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1570       if not available buf_dis-cfg-rule
     1571       or p-pos-type = "":U
     1572       then do:
     1573          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1574                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1575                                  , p-templ-rl-root
     1576                                  , (if p-time-templ-rl-root = ?
     1577                                     then '':U
     1578                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1579                                     )
     1580                                  ).
     1581       end.
     1582       assign
     1583       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1584       .
     1585     end.
     1586   end procedure.
     1587   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1588   FUNCTION get-region RETURNS CHARACTER
     1589     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1590     define variable par-region as character no-undo.
     1591     if parhost-code = 0 and
     1592          parobj-type = "":U and
     1593          parobj-code = 0 then do:
     1594          par-region = "Глобально".
     1595          return par-region.
     1596       end.
     1597       if parobj-type = 'орг':U then do:
     1598          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1599          return par-region.
     1600       end.
     1601       if parobj-type = 'регион':U
     1602       then do:
     1603          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1604          return par-region.
     1605       end.
     1606       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1607       return par-region.
     1608   END FUNCTION.
     1609   FUNCTION get-objregion RETURNS CHARACTER
     1610     (  input parobj-type as character, input parobj-code as integer ) :
     1611     define variable par-region as character no-undo.
     1612     if  parobj-type = "":U and
     1613         parobj-code = 0
     1614     then do:
     1615        par-region = "Глобально".
     1616     end.
     1617     else if parobj-type = 'орг':U
     1618     then do:
     1619        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1620     end.
     1621     else if parobj-type = 'регион':U
     1622     then do:
     1623        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1624     end.
     1625     else
     1626        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1627     return par-region.
     1628   END FUNCTION.
     1629   procedure disgdsru-name :
     1630   define buffer buf_dis-rule for ub.dis-rule.
     1631   do
     1632     on error undo, return error
     1633     :
     1634     define input  parameter p-templ-rl-root  as integer no-undo .
     1635     define output parameter p-label          as character no-undo .
     1636     find first buf_dis-rule no-lock where
     1637               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1638     if available buf_dis-rule
     1639     then do:
     1640       if buf_dis-rule.rule-num > 0 then
     1641       p-label = buf_dis-rule.des.
     1642     end.
     1643     else do:
     1644       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1645     end.
     1646   end.
     1647   end procedure.
     1648   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1649   define variable v-rule-label as character no-undo .
     1650   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1651                                        ,output v-rule-label) no-error.
     1652   return v-rule-label.
     1653   end function.
     1654   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1655   define variable v-rule-label as character no-undo .
     1656   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1657   end function.
     1658   procedure disgdsru-write :
     1659     do
     1660     on error undo, return error
     1661     :
     1662       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1663       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1664       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1665       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1666       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1667       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1668       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1669       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1670       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1671       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1672       define buffer buf_dis-rule for ub.dis-rule.
     1673       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1674       define variable v-label          as character no-undo .
     1675       define variable v-discnt-role as character no-undo .
     1676       run discfgru-check in this-procedure (
     1677                                             input 'dis-gds-rule':U
     1678                                            ,input p-templ-rl-root
     1679                                            ,input p-time-templ-rl-root
     1680                                            ,input p-pos-type
     1681                                            ,output v-discnt-role
     1682                                             ) no-error .
     1683       if error-status :error then do:
     1684         undo, return error return-value .
     1685       end.
     1686       if p-discnt-role = ? then do:
     1687         p-discnt-role = v-discnt-role.
     1688       end.
     1689       if p-discnt-role <> v-discnt-role then do:
     1690         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1691                                 ,p-gds-code
     1692                                 ,p-obj-type
     1693                                 ,p-obj-code
     1694                                 ,p-pos-type
     1695                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1696                                 ,chr(10)
     1697                                 ,p-templ-rl-root
     1698                                 ,p-rule-num).
     1699       end.
     1700       if p-pos-type = ? then do:
     1701   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   define variable v-param-type24 as character no-undo .
     1703   define variable v-value-date24 as date no-undo .
     1704   define variable v-value-decimal24 as decimal no-undo .
     1705   define variable v-value-integer24 as INTEGER no-undo .
     1706   define variable v-value-logical24 AS LOGICAL no-undo .
     1707   define variable v-tth24 as handle no-undo .
     1708   run adm/shattri.p (
     1709       input "get":U
     1710       ,input  p-obj-type
     1711       ,input  p-obj-code
     1712       ,input  'cd-sending':U
     1713       ,input  'dflt-cd':U
     1714       ,output p-pos-type
     1715       ,output v-value-date24
     1716       ,output v-value-decimal24
     1717       ,output v-value-integer24
     1718       ,output v-value-logical24
     1719       ,output v-param-type24
     1720       ,INPUT-OUTPUT table-handle v-tth24
     1721       )  .
     1722   delete object v-tth24 no-error.
     1723       end.
     1724       find first buf_dis-rule no-lock where
     1725                 buf_dis-rule.rule-num = p-rule-num no-error.
     1726       if not available buf_Dis-rule then do:
     1727         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1728                                 ,p-gds-code
     1729                                 ,p-obj-type
     1730                                 ,p-obj-code
     1731                                 ,p-pos-type
     1732                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1733                                 ,chr(10)
     1734                                 ,p-rule-num).
     1735       end.
     1736       if buf_dis-rule.root <> yes then do:
     1737         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1738                                 ,p-gds-code
     1739                                 ,p-obj-type
     1740                                 ,p-obj-code
     1741                                 ,p-pos-type
     1742                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1743                                 ,chr(10)
     1744                                 ,p-rule-num).
     1745       end.
     1746       if not (p-obj-type = buf_dis-rule.obj-type
     1747           and p-obj-code = buf_dis-rule.obj-code)
     1748       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1749                and
     1750                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1751        then do:
     1752         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1753                                 ,p-gds-code
     1754                                 ,p-obj-type
     1755                                 ,p-obj-code
     1756                                 ,p-pos-type
     1757                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1758                                 ,chr(10)
     1759                                 ) +
     1760                             substitute("Правило скидки &1 определено для &2&3" +
     1761                                        "а привязка к товару для &4"
     1762                                        ,buf_dis-rule.rule-num
     1763                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1764                                        ,chr(10)
     1765                                        ,get-objregion( p-obj-type, p-obj-code)
     1766                                        ))
     1767                                 .
     1768       end.
     1769       find first buf_dis-gds-rule exclusive-lock where
     1770                  buf_dis-gds-rule.gds-code  = p-gds-code
     1771              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1772              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1773              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1774              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1775              and buf_dis-gds-rule.nonunique = p-nonunique
     1776              no-error .
     1777       if not available buf_dis-gds-rule then do:
     1778         find first buf_dis-gds-rule exclusive-lock where
     1779                   buf_dis-gds-rule.gds-code  = p-gds-code
     1780               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1781               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1782               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1783               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1784               no-error .
     1785         if available buf_Dis-gds-rule then do:
     1786           if p-nonunique = ''
     1787           and available buf_dis-gds-rule
     1788           then do:
     1789             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1790                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1791                                      , p-gds-code
     1792                                      , buf_Dis-rule.obj-type
     1793                                      , buf_Dis-rule.obj-code
     1794                                      , p-nonunique
     1795                                     ).
     1796           end.
     1797           if available buf_dis-gds-rule
     1798           and buf_dis-gds-rule.nonunique = ''
     1799           and p-nonunique <> ''then do:
     1800             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1801                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1802                                      , p-gds-code
     1803                                      , buf_Dis-rule.obj-type
     1804                                      , buf_Dis-rule.obj-code
     1805                                     ).
     1806           end.
     1807         end.
     1808         create buf_dis-gds-rule .
     1809         assign
     1810         buf_dis-gds-rule.gds-code  = p-gds-code
     1811         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1812         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1813         buf_dis-gds-rule.pos-type = p-pos-type
     1814         buf_dis-gds-rule.discnt-role = v-discnt-role
     1815         buf_dis-gds-rule.rule-num = p-rule-num
     1816         buf_dis-gds-rule.nonunique = p-nonunique
     1817         no-error
     1818         .
     1819       end.
     1820       ASSIGN
     1821       buf_dis-gds-rule.rule-num = p-rule-num
     1822       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1823       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1824       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1825       buf_dis-gds-rule.nonunique = p-nonunique
     1826       no-error.
     1827     end.
     1828   end procedure.
     1829   PROCEDURE cmp-disgdsru-write :
     1830   do
     1831   on error undo, return error
     1832   :
     1833     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1834     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1835     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1836     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1837     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1838     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1839     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1840     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1841     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1842     define variable v-rule-label          as character no-undo .
     1843     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1844     define buffer buf_dis-rule     for ub.dis-rule.
     1845     run disgdsru-name in this-procedure (
     1846                                         input  p-templ-rl-root
     1847                                         ,output v-rule-label
     1848                                         ) no-error .
     1849     if error-status :error then do:
     1850       undo, return error return-value .
     1851     end.
     1852     find first buf_tt0-dis-gds-rule exclusive-lock where
     1853                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1854             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1855             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1856             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1857             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1858             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1859             no-error .
     1860     if not available buf_tt0-dis-gds-rule then do:
     1861       create buf_tt0-dis-gds-rule .
     1862       assign
     1863       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1864       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1865       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1866       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1867       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1868       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1869       no-error
     1870       .
     1871     end.
     1872     find first buf_dis-rule no-lock where
     1873               buf_dis-rule.rule-num = p-rule-num.
     1874     ASSIGN
     1875     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1876     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1877     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1878     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1879     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1880     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1881     no-error.
     1882     release buf_tt0-dis-gds-rule no-error .
     1883     if error-status:error then do:
     1884       undo, return error return-value .
     1885     end.
     1886   end.
     1887   END PROCEDURE.
     1888   define variable vss-include-info25 as character format "X(65)" no-undo
     1889   initial "@(#)$Workfile$ $Revision$".
     1890   define variable v-bgelib-bgefmt        as character         no-undo.
