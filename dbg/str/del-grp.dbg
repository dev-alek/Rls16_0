    10547       if integer( substring( tmp-str88, 1, length( ncrpg-pfx ) ) ) <> 0
    10548       then do:
    10549         message
    10550           "Невозможно сформировать бар-код" SKIP
    10551           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10552           view-as alert-box error title "подрезание кода".
    10553         return error.
    10554       end.
    10555       else do:
    10556         assign
    10557           IBm-good-code = ncrpg-pfx + substring( tmp-str88, length( ncrpg-pfx ) + 1, length( tmp-str88 ) - length( ncrpg-pfx ) )
    10558           len-code88    = length( IBm-good-code )
    10559         .
