    13616                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    13617                 and crf <= cr-ncr-dis-kat
    13618           by buf_cash-ncr-dis-kat.cd-subject-code
    13619           by buf_cash-ncr-dis-kat.cd-disc-string
