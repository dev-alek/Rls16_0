    10574               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10575               view-as alert-box error title "подсчет контрольной суммы".
    10576             return error.
    10577           end.
    10578           assign
    10579             sum88 = sum88 + integer(v-sum-char88)
    10580           .
    10581         end.
    10582         if varcont88 = yes then do:
