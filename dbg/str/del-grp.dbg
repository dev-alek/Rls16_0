    10288   if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
    10289   FOR EACH cash-gds :
    10290       delete cash-gds.
    10291   END.
    10292   FOR EACH cash-txr :
    10293       delete cash-txr.
    10294   END.
    10295   run write-log-and-file in p-log-handle (
    10296         input 1
    10297       , input log-file-name
    10298       , input 1
    10299       , input substitute("Удалены товары c касс объекта &1&2", 'маг':U, i-obj-code)
    10300                                             ).
    10301   run finish-send in this-procedure no-error .
    10302   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10303   procedure ibm-gdsc :
    10304   define input  parameter p-zeros         as logical no-undo .
    10305   define output parameter IBM-good-code as character no-undo .
    10306   define output parameter IBM-good-code-2 as character no-undo .
    10307   define output parameter IBM2-short      as character no-undo .
    10308   define variable v-delim as character no-undo .
    10309   define variable v-format-str-16 as character no-undo .
    10310     do
    10311     on error undo, return error
    10312     :
    10313       if p-zeros then do:
    10314         assign
    10315         v-delim = '0'
    10316         v-format-str-16 =  "9999999999999999"
    10317         .
    10318       end.
    10319       else do:
    10320         assign
    10321         v-delim = chr(32)
    10322         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10323         .
    10324       end.
    10325       if cash-gds.b-str = "" then do:
    10326         assign
    10327         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10328         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10329         or cash-gds.unit-base <> cash-gds.unit-cli
    10330         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10331         then
    10332         do:
    10333           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10334               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10335             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10336             iBM2-short = bar_code.
    10337             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10338           END.
    10339           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10340               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10341             IBM-good-code-2 = b_code.
    10342           end.
    10343         end.
    10344       end.
    10345       else do:
    10346         IBm-good-code =
    10347         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10348           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10349            or
    10350            cash-gds.bc-on-type = 'pglc':U)
    10351         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10352         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10353       end.
    10354     end.
    10355   end procedure.
    10356   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10357   procedure ncr-gdsc :
    10358   define output parameter IBM-good-code as character no-undo .
    10359   define output parameter IBM-good-code-2 as character no-undo .
    10360   define output parameter is-sc as logical no-undo .
    10361   define output parameter p-taracode-bc as character no-undo .
    10362   define variable v-taracode-bc as character no-undo .
    10363   define variable v-type as character no-undo .
    10364   define variable v-bc-buf as character no-undo .
    10365   define variable iii as integer no-undo .
    10366     do
    10367     on error undo, return error
    10368     :
    10369       if cash-gds.b-str = "" then do:
    10370         assign
    10371         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
    10372         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
    10373           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10374               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10375             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10376             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
    10377           end.
    10378           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10379               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10380             IBM-good-code-2 = b_code.
    10381           end.
    10382         end.
    10383       end.
    10384       else do:
    10385         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10386         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10387                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10388                              or
    10389                              cash-gds.bc-on-type = 'pglc':U)
    10390                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10391                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10392                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10393          if action <> "D":U then do:
    10394           is-sc = no.
    10395           find first request_prod-bc no-lock where
    10396                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10397           if not avail request_prod-bc then do :
    10398             if mask_s-c <> "" then do :
    10399               iii_ :
    10400               do iii = 1 to num-entries(mask_s-c) :
    10401                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10402                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10403                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10404                   if available request_prod-bc then leave iii_ .
    10405                 end.
    10406               end.
    10407             end.
    10408           end.
    10409           if avail request_prod-bc then do :
    10410             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10411   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10413     (buffer request_prod-bc
    10414     ,input  'scaleable=request'
    10415     ,output is-sc
    10416     ) no-error .
    10417             end.
    10418             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10419                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10420                then do:
    10421   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10422     define variable tmp-str87  as character no-undo.
    10423     define variable tmp-num87  as character no-undo.
    10424     define variable i87        as integer   no-undo.
    10425     define variable sum87      as integer   no-undo.
    10426     define variable len-code87 as integer   no-undo.
    10427     define variable varcont87  as logical   initial yes no-undo.
    10428     CASE ncrsc-frmt :
    10429       WHEN "EAN13" THEN do:
    10430         assign
    10431           tmp-str87 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10432         .
    10433       end.
    10434       WHEN "EAN8" THEN do:
    10435         assign
    10436           tmp-str87 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10437         .
    10438       end.
    10439       OTHERWISE DO:
    10440           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    10441           view-as alert-box error.
    10442           return error.
    10443       END.
    10444     END CASE.
    10445     if varcont87 = yes then do:
    10446       if integer( substring( tmp-str87, 1, length( ncrsc-pfx ) ) ) <> 0
    10447       then do:
    10448         message
    10449           "Невозможно сформировать бар-код" SKIP
    10450           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10451           view-as alert-box error title "подрезание кода".
    10452         return error.
    10453       end.
    10454       else do:
    10455         assign
    10456           IBm-good-code = ncrsc-pfx + substring( tmp-str87, length( ncrsc-pfx ) + 1, length( tmp-str87 ) - length( ncrsc-pfx ) )
    10457           len-code87    = length( IBm-good-code )
    10458         .
    10459         define variable v-sum-char87 as character no-undo .
    10460         assign
    10461           sum87 = 0
    10462         .
    10463         do i87 = 1 to len-code87 by 2
    10464         :
    10465           assign
    10466             v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10467           .
    10468           if v-sum-char87 < "0"
    10469           or v-sum-char87 > "9"
    10470           then do:
    10471             message
    10472               "Невозможно сформировать бар-код" skip
    10473               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10474               view-as alert-box error title "подсчет контрольной суммы".
    10475             return error.
    10476           end.
    10477           assign
    10478             sum87 = sum87 + integer(v-sum-char87)
    10479           .
    10480         end.
    10481         if varcont87 = yes then do:
    10482           assign
    10483             sum87 = sum87 * 3
    10484           .
    10485           do i87 = 2 to len-code87 by 2
    10486           :
    10487             assign
    10488               v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10489             .
    10490             if v-sum-char87 < "0"
    10491             or v-sum-char87 > "9"
    10492             then do:
    10493               message
    10494                 "Невозможно сформировать бар-код" skip
    10495                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10496                 view-as alert-box error title "подсчет контрольной суммы".
    10497               return error.
    10498             end.
    10499             assign
    10500               sum87 = sum87 + integer(v-sum-char87)
    10501             .
    10502           end.
    10503           if varcont87 = yes then do:
    10504              if sum87 mod 10 = 0 then do:
    10505                assign
    10506                  IBm-good-code = IBm-good-code + '0'
    10507                .
    10508              end.
    10509              else do:
    10510                assign
    10511                  IBm-good-code = IBm-good-code + string(10 - sum87 mod 10)
    10512                .
    10513              end.
    10514           end.
    10515         end.
    10516       end.
    10517     end.
    10518             end.
    10519             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10520                cash-gds.bc-on-type = 'pglc':U
    10521                then do:
    10522   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10523     define variable tmp-str88  as character no-undo.
    10524     define variable tmp-num88  as character no-undo.
