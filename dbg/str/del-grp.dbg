    12853   define buffer buf_dis-rule for ub.dis-rule.
    12854   define buffer buf_place for ub.place.
    12855   define buffer buf_pl-gds for ub.pl-gds.
    12856   FOR EACH for-cash-desk NO-LOCK WHERE
    12857           for-cash-desk.db-num = g#db-num AND
    12858           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12859           for-cash-desk.obj-code = i-obj-code AND
    12860    for-cash-desk.cash-on  = yes
    12861       BREAK
    12862       BY for-cash-desk.db-num
    12863       BY for-cash-desk.obj-code
    12864       BY for-cash-desk.pos-type
    12865       BY for-cash-desk.cash-on
    12866       BY for-cash-desk.cash-num
    12867       :
    12868     if LOOKUP(ub.cash-desk.pos-type,
    12869               ('NCR-GM':U + chr(44) +
    12870                'IBM-XML':U + chr(44) +
    12871                'MAGIA-XML':U + chr(44) +
    12872                'NCR-AS@R':U  + chr(44) +
    12873                'Autotank':U
    12874                  )) > 0
    12875     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    12876     if LOOKUP(ub.cash-desk.pos-type,
    12877               'MARIA':U
    12878                  ) > 0 then do:
    12879       if for-cash-desk.autonomy = integer('2':U) then do:
    12880         assign
    12881         v-cd-list-update = for-cash-desk.addr-path
    12882         v-cd-list-delete = for-cash-desk.addr-path
    12883         .
    12884         NEXT.
    12885       end.
    12886       else do:
    12887         if v-cd-list-update = '':U then nExt.
    12888       end.
    12889     end.
    12890     run write-log-and-file in p-log-handle (
    12891           input 1
    12892         , input log-file-name
    12893         , input 1
    12894         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
    12895                           )
    12896                                           ).
    12897   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12898   case for-cash-desk.pos-type:
    12899       when 'IBM-XML':U or when 'Autotank':U
    12900         or
    12901       when 'InfoKiosk':U
    12902         or
    12903       when 'Autotank':U
    12904     then do:
