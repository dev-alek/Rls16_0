     7279   def var vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7280   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7281   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7282   procedure create-dis-rule :
     7283   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7284   define input parameter p-tree as logical no-undo .
     7285   define buffer buf_dis-rule for ub.dis-rule.
     7286   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7287   define buffer term_dis-rule for ub.dis-rule.
     7288   define buffer term_dis-time-rule for ub.dis-time-rule.
     7289   define buffer root_cash-dis-rule for cash-dis-rule.
     7290   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7291   define buffer term_cash-dis-rule for cash-dis-rule.
     7292   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7293     do
     7294     on error undo, return error
     7295     :
     7296       find first root_cash-dis-rule no-lock where                                                         ~
     7297                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7298       if not available root_cash-dis-rule then do:
     7299         find first buf_dis-rule no-lock where
     7300                   buf_dis-rule.rule-num = p-rule-num no-error.
     7301         if available buf_dis-rule then do:
     7302           if buf_dis-rule.time-rule-num <> 0 then do:
     7303             find first buf_dis-time-rule no-lock where
     7304                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7305           end.
     7306           create root_cash-dis-rule.
     7307           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7308           if available buf_dis-time-rule then do:
     7309             find first root_cash-dis-time-rule no-lock where
     7310                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7311             if not available root_cash-dis-time-rule then do:
     7312               create root_cash-dis-time-rule.
     7313               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7314             end.
     7315           end.
     7316           else do:
     7317             assign
     7318             root_cash-dis-rule.time-rule-num = 0.
     7319           end.
     7320           if buf_dis-rule.uniq-field <> "":U then do:
     7321             for each term_dis-rule no-lock where
     7322                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7323               if term_dis-rule.time-rule-num <> 0 then do:
     7324                 find first term_dis-time-rule no-lock where
     7325                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7326               end.
     7327               create term_cash-dis-rule.
     7328               buffer-copy term_dis-rule to term_cash-dis-rule.
     7329               if term_dis-rule.time-rule-num = 0
     7330               or available term_dis-time-rule
     7331               or root_cash-dis-rule.time-rule-num = 0
     7332               then do:
     7333                 if available term_dis-time-rule then do:
     7334                   find first term_cash-dis-time-rule no-lock where
     7335                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7336                   if not available term_cash-dis-time-rule then do:
     7337                     create term_cash-dis-time-rule.
     7338                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7339                   end.
     7340                 end.
     7341               end.
     7342             end.
     7343           end.
     7344         end.
     7345       end.
     7346     end.
     7347   end procedure.
     7348   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7349   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7350   function ncr-amnt-disc returns character (
     7351     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7352   define variable v-result as character no-undo .
     7353   define variable ii as integer no-undo .
     7354   define variable v-entry as character no-undo extent 3.
     7355   for each cash-dis-rule  no-lock where
     7356         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7357     assign
     7358     ii = ii + 1
     7359     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7360                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7361     .
     7362   end.
     7363   if v-entry[2] = "":U then
     7364   assign
     7365   v-entry[2] = v-entry[1]
     7366   .
     7367   if v-entry[3] = "":U then
     7368   assign
     7369   v-entry[3] = v-entry[2]
     7370   .
     7371   assign
     7372   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7373   .
     7374   return v-result.
     7375   END FUNCTION.
     7376   function ncr-date-disc returns character (
     7377     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7378   define variable v-result as character no-undo .
     7379   define variable ii as integer no-undo .
     7380   define variable v-entry as character no-undo extent 3.
     7381   for each cash-dis-rule  no-lock where
     7382         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7383       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7384     assign
     7385     ii = ii + 1
     7386     v-entry[ii] =
     7387                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7388                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7389                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7390                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7391                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7392                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7393                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7394   end.
     7395   if v-entry[2] = "":U then
     7396   assign
     7397   v-entry[2] = v-entry[1]
     7398   .
     7399   if v-entry[3] = "":U then
     7400   assign
     7401   v-entry[3] = v-entry[2]
     7402   .
     7403   assign
     7404   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7405   .
     7406   return v-result.
     7407   END FUNCTION.
     7408   function ncr-temp-disc returns character (
     7409     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7410   define variable v-result as character no-undo .
     7411   define variable ii as integer no-undo .
     7412   define variable v-entry as character no-undo extent 3.
     7413   define variable v-dec as decimal no-undo .
     7414   define variable v-disc-price-sale as decimal no-undo .
     7415   define variable v-pdf-id as integer no-undo .
     7416   define variable v-pdf-db-num as integer no-undo .
     7417   define buffer buf_cash-dis-rule for cash-dis-rule.
     7418   find first buf_cash-dis-rule where
     7419            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7420   if not available buf_cash-dis-rule then return "":U.
     7421   if buf_cash-dis-rule.templ-rl-root <> 29
     7422   and buf_cash-dis-rule.templ-rl-root <> 86
     7423   then do:
     7424     assign
     7425     v-entry[1] =
     7426     "000"                                                   +
     7427     "0"                                                     +
     7428     "0000"                                                  +
     7429     "2359"                                                     +
     7430      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7431      .
     7432   end.
     7433   else do:
     7434     for each cash-dis-rule  no-lock where
     7435           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7436         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7437       case cash-dis-rule.value-type:
     7438         when integer('1':U) then do:
     7439           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7440         end.
     7441         when integer('12':U) then do:
     7442           find first cash-gds-discnt where
     7443                     cash-gds-discnt.b-code = cash-gds.b-code
     7444                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7445                 and cash-gds-discnt.obj-type = 'маг':U
     7446                 and cash-gds-discnt.obj-code = i-obj-code
     7447                 no-error.
     7448           if not available cash-gds-discnt then do:
     7449             v-dec = cash-gds.price-sale.
     7450           end.
     7451           else do:
     7452             assign
     7453             v-dec = cash-gds-discnt.discnt-value
     7454             .
     7455           end.
     7456         end.
     7457         otherwise do:
     7458           v-dec = cash-gds.price-sale.
     7459         end.
     7460       end case.
     7461       assign
     7462       ii = ii + 1
     7463       v-entry[ii] =
     7464                     "000"                                                   +
     7465                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7466                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7467                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7468                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7469                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7470                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7471                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7472                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7473                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7474                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7475                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7476       .
     7477   if ii = 3 then leave.
     7478     end.
     7479   end.
     7480   if v-entry[2] = "":U then
     7481   assign
     7482   v-entry[2] = v-entry[1]
     7483   .
     7484   if v-entry[3] = "":U then
     7485   assign
     7486   v-entry[3] = v-entry[2]
     7487   .
     7488   assign
     7489   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7490   .
     7491   return v-result.
     7492   END FUNCTION.
     7493   function ncr-d-rank returns character (
     7494     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7495   define variable v-result as character no-undo .
     7496   define variable ii as integer no-undo .
     7497   do ii = 1 to length(p-d-rank):
     7498     CASE substr(p-d-rank, ii, 1):
     7499       when "X":U then do:
     7500         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7501       end.
     7502       when "T":U then do:
     7503         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7504       end.
     7505       when "D":U then do:
     7506         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7507       end.
     7508     END CASE.
     7509     if v-result <> "":U then LEAVE.
     7510   end.
     7511   if v-result = "":U then v-result = chr(32).
     7512   return v-result.
     7513   END FUNCTION.
     7514   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7515       define variable v-upper-code as int no-undo.
     7516       define variable v-value as character no-undo.
     7517       define variable v-type as character no-undo.
     7518       define buffer lc_gds-grp for ub.gds-grp.
     7519       define buffer lc_goods for ub.goods.
     7520      if p-gds-code <> 0 then do:
     7521       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7522       v-upper-code = lc_goods.grp-code.
     7523       do while v-upper-code > 0 :
     7524           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7525           run ggoattr-value(
     7526             input lc_gds-grp.node-code,
     7527             input 0,
     7528             input "",
     7529             input 0,
     7530             input 'ban-sales-via-cd':U,
     7531             output v-value,
     7532             output v-type
     7533           ).
     7534          if v-value = "yes" then
     7535             return true.
     7536          else
     7537          do:
     7538             run ggoattr-value(
     7539                input lc_gds-grp.node-code,
     7540                input shop.host-code,
     7541                input "",
     7542                input 0,
     7543                input 'ban-sales-via-cd':U,
     7544                output v-value,
     7545                output v-type
     7546                ).
     7547             if v-value = "yes" then
     7548                return true.
     7549             else
     7550             do:
     7551                run ggoattr-value(
     7552                   input lc_gds-grp.node-code,
     7553                   input shop.host-code,
     7554                   input 'маг':U,
     7555                   input i-obj-code,
     7556                   input 'ban-sales-via-cd':U,
     7557                   output v-value,
     7558                   output v-type
     7559                   ).
     7560                if v-value = "yes" then
     7561                   return true.
     7562                else v-upper-code = lc_gds-grp.upper-code.
     7563             end .
     7564          end.
     7565         end.
     7566       end.
     7567   end.
     7568   FUNCTION convert-tax-code returns integer
     7569                                             ( input p-rate-code as integer
     7570                                              ,input p-cdtaxlst  as character
     7571                                             ) :
     7572   define variable jj as integer no-undo .
     7573     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7574       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7575         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7576       end.
     7577     end.
     7578   END FUNCTION.
     7579   FUNCTION convert-maria-tax-code returns character
     7580                                             ( input p-vat-rate-code as integer
     7581                                              ,input p-slt-rate-code as integer
     7582                                              ,input p-cdtaxlst  as character
     7583                                             ) :
     7584   define variable jj as integer no-undo .
     7585   define variable aa as character no-undo extent 8.
     7586   define variable v-return-value as character no-undo .
     7587     do jj = 1 to 8:
     7588       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7589         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7590           aa[jj] = '1'.
     7591         end.
     7592         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7593           aa[jj] = '1'.
     7594         end.
     7595       end.
     7596       if aa[jj] = '':U then aa[jj] = '0'.
     7597       v-return-value = aa[jj] + v-return-value.
     7598     end.
     7599   return v-return-value.
     7600   END FUNCTION.
     7601   FUNCTION convert-maria-tax-code-2 returns integer
     7602                                             ( input p-rate-code as integer
     7603                                              ,input p-cdtaxlst  as character
     7604                                             ) :
     7605   define variable jj as integer no-undo .
     7606   define variable v-return-value as integer no-undo .
     7607     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7608       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7609         return jj.
     7610       end.
     7611     end.
     7612   return 0.
     7613   END FUNCTION.
