     1176                                   then integer(buf_prod-bc.b-str)
     1177                                   else buf_bar-code.b-code
     1178             buf_tt-tax.rate-value  = parroad-tax
     1179             buf_tt-tax.tax-rate-gds-rc  = ?
     1180             NO-ERROR.
