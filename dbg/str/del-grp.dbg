     6320   define input  parameter p-obj-type    as character no-undo .
     6321   define input  parameter p-obj-code    as integer   no-undo .
     6322   define input  parameter p-qnty-doc    as decimal   no-undo .
     6323   define input  parameter p-sum-doc     as decimal   no-undo .
