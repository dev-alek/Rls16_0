     8288       ,INPUT-OUTPUT table-handle v-tth
     8289       ) no-error .
     8290   IF not error-status:error
     8291   then mask_s-c = v-value-character.
     8292   else mask_s-c = "".
     8293   delete object v-tth.
     8294   if noautocs
     8295   then do:
     8296       message "Пошлите товары на кассы объекта МАГАЗИН "
     8297       if i-obj-code > 0
     8298       then i-obj-code
     8299       else (- i-obj-code)
     8300       view-as alert-box WARNING.
     8301       return.
     8302   end.
     8303     if (    ub.shop.cd-bc-alt
     8304           or ub.shop.cd-bc-base
     8305           or ub.shop.cd-loc-alt
     8306           or ub.shop.cd-loc-base
     8307           or ub.shop.cd-parts-all
     8308           or ub.shop.cd-parts-not-blank
     8309           or ub.shop.cd-parts-ser
     8310           or ub.shop.cd-pb-alt
     8311           or ub.shop.cd-pb-base
     8312           or ub.shop.cd-sc-base   ) = no then do:
     8313     run write-log-and-file in p-log-handle (
     8314           input 1
     8315         , input log-file-name
     8316         , input 1
     8317         , input substitute("Не выбраны типы кодов для пересылки на кассы &1&2", 'маг':U, abs(i-obj-code))
     8318                                               ).
     8319       run finish-send in this-procedure no-error .
     8320       return.
     8321     end.
     8322   run write-log-and-file in p-log-handle (
     8323         input 1
     8324       , input log-file-name
     8325       , input 1
     8326       , input substitute("Пересылка на кассы &1&2 информации о товарах", 'маг':U, abs(i-obj-code))
     8327                                             ).
     8328   if i-obj-code < 0 then i-obj-code = - i-obj-code.
     8329   FIND ub.sysconf WHERE ub.sysconf.host-code = ub.shop.host-code NO-LOCK.
     8330   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     8332     (input  ub.shop.host-code
     8333     ,output v-r-b-curr-magia
     8334     )  .
     8335   find first buf_currency no-lock where
     8336              buf_currency.curr-code = v-r-b-curr-magia no-error .
     8337   if not available buf_currency or
     8338   buf_currency.okv-code = 0 then do:
     8339     message
     8340     "Не задан код ОКВ для валюты с кодом" buf_currency.curr-code
     8341     view-as alert-box error .
     8342     return error .
     8343   end.
     8344   assign
     8345   v-r-b-curr-magia = (if buf_currency.curr-code = 0 then 1 else buf_Currency.okv-code)
     8346   v-is-restaurant = ub.shop.is-catering
     8347   .
     8348   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8349   define variable v-param-type60 as character no-undo .
     8350   define variable v-value-date60 as date no-undo .
     8351   define variable v-value-decimal60 as decimal no-undo .
     8352   define variable v-value-integer60 as INTEGER no-undo .
     8353   define variable v-value-logical60 AS LOGICAL no-undo .
     8354   define variable v-tth60 as handle no-undo .
     8355   run adm/shattri.p (
     8356       input "get":U
     8357       ,input  'маг':U
     8358       ,input  abs(i-obj-code)
     8359       ,input  'cd-sending':U
     8360       ,input  'dflt-cd':U
     8361       ,output dflt-cd
     8362       ,output v-value-date60
     8363       ,output v-value-decimal60
     8364       ,output v-value-integer60
     8365       ,output v-value-logical60
     8366       ,output v-param-type60
     8367       ,INPUT-OUTPUT table-handle v-tth60
     8368       ) no-error .
     8369   delete object v-tth60 no-error.
     8370   IF error-status:error then do:
     8371     assign
     8372     dflt-cd = ''.
