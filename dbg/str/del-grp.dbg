      164   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   def new shared var bc-frmt as character no-undo .
      166   def new shared var bc-pfx  as character no-undo .
      167   def var bc-par-type as character no-undo .
      168       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      169       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      170           do:
      171               message "Не задан или не верно задан ТИП собственного бар-кода!"
      172                   view-as alert-box ERROR TITLE "".
      173               return error.
      174           end.
      175       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      176       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      177           do:
      178               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      179                   view-as alert-box ERROR TITLE "".
      180               return error.
      181           end.
      182   PROCEDURE gen-bc:
      183     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      184     def output parameter full-b-code     as character init ""    no-undo .
      185   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186     define variable tmp-str5  as character no-undo.
      187     define variable tmp-num5  as character no-undo.
      188     define variable i5        as integer   no-undo.
      189     define variable sum5      as integer   no-undo.
      190     define variable len-code5 as integer   no-undo.
      191     define variable varcont5  as logical   initial yes no-undo.
      192     CASE bc-frmt :
      193       WHEN "EAN13" THEN do:
      194         assign
      195           tmp-str5 = string( internal-b-code, "999999999999" )
      196         .
      197       end.
      198       WHEN "EAN8" THEN do:
      199         assign
      200           tmp-str5 = string( internal-b-code, "9999999" )
      201         .
      202       end.
      203       OTHERWISE DO:
      204           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      205           view-as alert-box error.
      206           return error.
      207       END.
      208     END CASE.
      209     if varcont5 = yes then do:
      210       if integer( substring( tmp-str5, 1, length( bc-pfx ) ) ) <> 0
      211       then do:
      212         message
      213           "Невозможно сформировать бар-код" SKIP
      214           "для товара с кодом: " internal-b-code
      215           view-as alert-box error title "подрезание кода".
      216         return error.
      217       end.
      218       else do:
      219         assign
      220           full-b-code = bc-pfx + substring( tmp-str5, length( bc-pfx ) + 1, length( tmp-str5 ) - length( bc-pfx ) )
      221           len-code5    = length( full-b-code )
      222         .
      223         define variable v-sum-char5 as character no-undo .
      224         assign
      225           sum5 = 0
      226         .
      227         do i5 = 1 to len-code5 by 2
      228         :
      229           assign
      230             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      231           .
      232           if v-sum-char5 < "0"
      233           or v-sum-char5 > "9"
      234           then do:
      235             message
      236               "Невозможно сформировать бар-код" skip
      237               "для товара с кодом: " internal-b-code skip
      238               view-as alert-box error title "подсчет контрольной суммы".
      239             return error.
      240           end.
      241           assign
      242             sum5 = sum5 + integer(v-sum-char5)
      243           .
      244         end.
      245         if varcont5 = yes then do:
      246           assign
      247             sum5 = sum5 * 3
      248           .
      249           do i5 = 2 to len-code5 by 2
      250           :
      251             assign
      252               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      253             .
      254             if v-sum-char5 < "0"
      255             or v-sum-char5 > "9"
      256             then do:
      257               message
      258                 "Невозможно сформировать бар-код" skip
      259                 "для товара с кодом: " internal-b-code skip
      260                 view-as alert-box error title "подсчет контрольной суммы".
      261               return error.
      262             end.
      263             assign
      264               sum5 = sum5 + integer(v-sum-char5)
      265             .
      266           end.
      267           if varcont5 = yes then do:
      268              if sum5 mod 10 = 0 then do:
      269                assign
      270                  full-b-code = full-b-code + '0'
      271                .
      272              end.
      273              else do:
      274                assign
      275                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      276                .
      277              end.
      278           end.
      279         end.
      280       end.
      281     end.
      282   END PROCEDURE.
