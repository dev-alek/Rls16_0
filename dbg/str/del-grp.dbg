     6156   procedure fact-order-mpl :
     6157     do
     6158     on error undo, return error return-value
     6159     :
     6160   define input  parameter p-doc-date as date     no-undo .
     6161   define input  parameter p-obj-type as character no-undo .
     6162   define input  parameter p-obj-code as integer   no-undo .
     6163   define output parameter p-fact-order as decimal   no-undo .
     6164   define variable v-fact-date            as date    no-undo .
     6165   define variable v-fact-time            as integer no-undo .
     6166   define variable v-fact-order           as decimal no-undo .
     6167   define variable v-shift-end-fact-order as decimal no-undo .
     6168   define variable v-day-end-fact-order   as decimal no-undo .
     6169   define variable l-shift-on as logical no-undo .
     6170   define variable l-date as date      no-undo .
     6171   define variable l-time as integer   no-undo .
     6172   define variable shift-date as date      no-undo .
     6173   define variable shift-num  as integer   no-undo .
     6174   define variable shift-name as character no-undo .
     6175   define variable max-fact-order as decimal   no-undo .
     6176   define buffer buf_global-state for ub.global-state  .
     6177   find first buf_global-state no-lock no-error .
     6178   if not available buf_global-state then do:
     6179      message
     6180        "Не заданы параметры ценообразования!"
     6181        view-as alert-box error
     6182      .
     6183      return error return-value .
     6184   end.
     6185     run cur-time in this-procedure
     6186     ( output v-fact-date ,
     6187       output v-fact-time  ).
     6188   if p-doc-date = ? then do:
     6189   if buf_global-state.pl-use-sys-date-time  = true then do:
     6190         run factord in this-procedure
     6191           (input  v-fact-date
     6192           ,input  v-fact-time
     6193           ,input  v-fact-time
     6194           ,input  ?
     6195           ,input  ?
     6196           ,input  false
     6197           ,output v-fact-order
     6198           ,output v-shift-end-fact-order
     6199           ,output v-day-end-fact-order
     6200           ) no-error .
     6201         if error-status :error
     6202         or v-fact-order = ?
     6203         or v-fact-order = 0 then do:
     6204           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6205         end.
     6206         p-fact-order = v-fact-order .
     6207   end.
     6208   else do:
     6209   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6211     (input  p-obj-type
     6212     ,input  p-obj-code
     6213     ,input  'shift-on=request'
     6214     ,output l-shift-on
     6215     ) no-error .
     6216         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6217         if p-doc-date <> ? then do:
     6218         end.
     6219          run gbl/factdate.p
     6220          ( input        p-obj-type  ,
     6221            input        p-obj-code  ,
     6222            input-output v-fact-date ,
     6223            input-output v-fact-time ,
     6224            input-output shift-date      ,
     6225            input-output shift-num       ,
     6226            input-output shift-name      ,
     6227            input        yes
     6228            ) no-error .
     6229         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6230         run factord in this-procedure
     6231           (input  v-fact-date
     6232           ,input  v-fact-time
     6233           ,input  v-fact-time
     6234           ,input  shift-date
     6235           ,input  shift-num
     6236           ,input  l-shift-on
     6237           ,output v-fact-order
     6238           ,output v-shift-end-fact-order
     6239           ,output v-day-end-fact-order
     6240           ) no-error .
     6241         if error-status :error
     6242         or v-fact-order = ?
     6243         or v-fact-order = 0 then do:
     6244           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6245         end.
     6246         p-fact-order = v-fact-order .
     6247   end.
     6248   end.
     6249   else do:
     6250          run gbl/factdate.p
     6251          ( input        p-obj-type  ,
     6252            input        p-obj-code  ,
     6253            input-output v-fact-date ,
     6254            input-output v-fact-time ,
     6255            input-output shift-date      ,
     6256            input-output shift-num       ,
     6257            input-output shift-name      ,
     6258            input        yes
     6259            ) no-error .
     6260         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6261         v-fact-date = p-doc-date .
     6262         run factord in this-procedure
     6263           (input  v-fact-date
     6264           ,input  v-fact-time
     6265           ,input  v-fact-time
     6266           ,input  shift-date
     6267           ,input  shift-num
     6268           ,input  l-shift-on
     6269           ,output v-fact-order
     6270           ,output v-shift-end-fact-order
     6271           ,output v-day-end-fact-order
     6272           ) no-error .
     6273         if error-status :error
     6274         or v-fact-order = ?
     6275         or v-fact-order = 0 then do:
     6276           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6277         end.
     6278         p-fact-order = v-fact-order .
     6279   end.
     6280     end.
     6281   end procedure.
