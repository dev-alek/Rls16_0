    10585           .
    10586           do i88 = 2 to len-code88 by 2
    10587           :
    10588             assign
    10589               v-sum-char88 = substr(IBm-good-code, len-code88 - i88 + 1, 1)
    10590             .
    10591             if v-sum-char88 < "0"
    10592             or v-sum-char88 > "9"
    10593             then do:
    10594               message
    10595                 "Невозможно сформировать бар-код" skip
    10596                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10597                 view-as alert-box error title "подсчет контрольной суммы".
    10598               return error.
    10599             end.
    10600             assign
