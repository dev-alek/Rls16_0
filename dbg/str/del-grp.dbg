      425   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      426                                                                     input  orders as integer):
      427   define variable  round-m-sum as decimal no-undo.
      428   if orders >= 0 then
      429   round-m-sum = round(mysum,orders).
      430   else
      431   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      432   return round-m-sum.
      433   END FUNCTION.
      434   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   procedure factord :
      436     define input  parameter p-fact-date            as date    no-undo .
      437     define input  parameter p-fact-time            as integer no-undo .
      438     define input  parameter p-fact-num             as integer no-undo .
      439     define input  parameter p-shift-date           as date    no-undo .
      440     define input  parameter p-shift-num            as integer no-undo .
      441     define input  parameter p-shift-on             as logical no-undo .
      442     define output parameter p-fact-order           as decimal no-undo .
      443     define output parameter p-shift-end-fact-order as decimal no-undo .
      444     define output parameter p-day-end-fact-order   as decimal no-undo .
      445     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      446     if p-fact-date = ?
      447     then do:
      448       return error "Не указана фактическая дата" .
      449     end.
      450     define variable v-fact-date-num as integer no-undo .
      451     assign
      452       v-fact-date-num = integer(p-fact-date)
      453     .
      454     if p-fact-num = ?
      455     or p-fact-num = 0
      456     then do:
      457       return error "Не задан p-fact-num " + string(p-fact-num) .
      458     end.
      459     if p-fact-num < 0
      460     then do:
      461       return error "Отрицательный fact-num " + string(p-fact-num) .
      462     end.
      463     if p-fact-num >= 100000000
      464     then do:
      465       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      466     end.
      467     if p-shift-on = true
      468     then do:
      469       if p-shift-date = ?
      470       then do:
      471         return error "Не задана дата смены" .
      472       end.
      473       if p-shift-num = ?
      474       or p-shift-num = 0
      475       then do:
      476         return error "Не задан номер смены" .
      477       end.
      478     end.
      479     else do:
      480       assign
      481         p-shift-date = p-fact-date
      482         p-shift-num  = 24
      483       .
      484     end.
      485     define variable v-shift-offset as integer no-undo .
      486     if p-shift-date = p-fact-date
      487     then do:
      488       assign
      489         v-shift-offset = 1
      490       .
      491     end.
      492     if p-shift-date < p-fact-date
      493     then do:
      494       assign
      495         v-shift-offset = 0
      496       .
      497     end.
      498     if p-shift-date > p-fact-date
      499     then do:
      500       message
      501         vss-workfile vss-revision vss-description skip
      502         "Неправильная дата закрытия смены" skip
      503         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      504         view-as alert-box error .
      505       undo, return error
      506         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      507           ,string(p-fact-date, '99/99/9999':U)
      508           ,string(p-shift-date, '99/99/9999':U)
      509           )
      510       .
      511     end.
      512     if p-shift-num < 1
      513     or p-shift-num > 24
      514     then do:
      515       message
      516         vss-workfile vss-revision vss-description skip
      517         "Неправильный номер смены" skip
      518         "p-shift-num" p-shift-num skip
      519         view-as alert-box error .
      520       undo, return error return-value .
      521     end.
      522     assign
      523       p-fact-order           = v-fact-date-num
      524                              + v-shift-offset * 0.5
      525                              + p-shift-num    * 0.02 - 0.01
      526                              + p-fact-num     * 0.0000000001
      527       p-shift-end-fact-order = v-fact-date-num
      528                              + v-shift-offset * 0.5
      529                              + p-shift-num    * 0.02
      530       p-day-end-fact-order   = v-fact-date-num
      531                              + 0.99
      532     .
      533     if p-fact-order           <= v-fact-date-num
      534     or p-shift-end-fact-order <= v-fact-date-num
      535     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      536     or p-shift-end-fact-order >= p-day-end-fact-order
      537     then do:
      538       message
      539         vss-workfile vss-revision vss-description skip
      540         "Внутренняя ошибка при генерации фактического номера" skip
      541         "p-fact-date"            p-fact-date            skip
      542         "p-fact-time"            p-fact-time            skip
      543         "p-fact-num"             p-fact-num             skip
      544         "p-shift-date"           p-shift-date           skip
      545         "p-shift-num"            p-shift-num            skip
      546         "p-shift-on"             p-shift-on             skip
      547         "p-shift-end-fact-order" p-shift-end-fact-order skip
      548         "p-day-end-fact-order"   p-day-end-fact-order   skip
      549         "v-fact-date-num"        v-fact-date-num        skip
      550         view-as alert-box error .
      551       undo, return error return-value .
      552     end.
      553   end procedure.
      554   procedure day-begin-fact-order :
      555     define input  parameter p-fact-date            as date    no-undo .
      556     define output parameter p-day-begin-fact-order as decimal no-undo .
      557     do
      558     on error undo, return error return-value
      559     :
      560       if p-fact-date = ?
      561       then do:
      562         assign
      563           p-day-begin-fact-order = 0
      564         .
      565       end.
      566       else do:
      567         assign
      568           p-day-begin-fact-order = integer(p-fact-date)
      569         .
      570       end.
      571     end.
      572   end procedure.
      573   procedure factord-max-fact-order :
      574     define output parameter p-max-fact-order as decimal   no-undo .
      575     do
      576     on error undo, return error return-value
      577     :
      578       run day-begin-fact-order in this-procedure
      579         (input  date(1, 1, 5000)
      580         ,output p-max-fact-order
      581         ) .
      582     end.
      583   end procedure.
      584   procedure factord-cut-archive :
      585     define input  parameter p-obj-type             as character no-undo .
      586     define input  parameter p-obj-code             as integer   no-undo .
      587     define input  parameter p-fact-date            as date      no-undo .
      588     define output parameter p-shift-on             as logical   no-undo .
      589     define output parameter p-shift-date           as date      no-undo .
      590     define output parameter p-shift-num            as integer   no-undo .
      591     define output parameter p-day-end-fact-order   as decimal   no-undo .
      592     define output parameter p-shift-end-fact-order as decimal   no-undo .
      593     define variable v-fact-order as decimal   no-undo .
      594     define buffer buf_shift-obj for ub.shift-obj .
      595     do
      596     on error undo, return error return-value
      597     :
      598   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      600     (input  p-obj-type
      601     ,input  p-obj-code
      602     ,input  'shift-on=request'
      603     ,output p-shift-on
      604     ) no-error .
      605       if error-status :error
      606       then do:
      607         message
      608           vss-workfile vss-revision vss-description skip
      609           "Ошибка при определении атрибута объекта" skip
      610           "Объект" p-obj-type p-obj-code skip
      611           error-status :get-message(1) skip
      612           return-value skip
      613           view-as alert-box error .
      614         undo, return error return-value .
      615       end.
      616       if p-shift-on = false
      617       then do:
      618         assign
      619           p-shift-date               = ?
      620           p-shift-num                = 0
      621         .
      622       end.
      623       else do:
      624         find first buf_shift-obj share-lock
      625           where buf_shift-obj.obj-type   = p-obj-type
      626             and buf_shift-obj.obj-code   = p-obj-code
      627             and buf_shift-obj.shift-date > p-fact-date
      628           use-index pi
      629           no-error .
      630         if not available buf_shift-obj
      631         or buf_shift-obj.status_ <> 'зкр':U
      632         then do:
      633           message
      634             vss-workfile vss-revision vss-description skip
      635             "Невозможно вычислить последнюю смену" skip
      636             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      637             "Объект" p-obj-type p-obj-code skip
      638             "Дата" p-fact-date skip
      639             view-as alert-box error .
      640           undo, return error return-value .
      641         end.
      642         find last buf_shift-obj share-lock
      643           where buf_shift-obj.obj-type = p-obj-type
      644             and buf_shift-obj.obj-code = p-obj-code
      645             and buf_shift-obj.shift-date <= p-fact-date
      646           use-index pi
      647           no-error .
      648         if available buf_shift-obj
      649         then do:
      650           if  buf_shift-obj.status_ = 'зкр':U
      651           then do:
      652             assign
      653               p-shift-date = buf_shift-obj.shift-date
      654               p-shift-num  = buf_shift-obj.shift-num
      655             .
      656           end.
      657           else do:
      658             message
      659               vss-workfile vss-revision vss-description skip
      660               "Невозможно вычислить последнюю смену" skip
      661               "Статус смены отличен от статуса" 'зкр':U skip
      662               "Объект" p-obj-type p-obj-code skip
      663               "Дата" p-fact-date skip
      664               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      665               view-as alert-box error .
      666             undo, return error return-value .
      667           end.
      668         end.
      669         else do:
      670           assign
      671             p-shift-date = p-fact-date - 1
      672             p-shift-num  = 1
      673           .
      674         end.
      675       end.
      676       run factord in this-procedure
      677         (input  p-fact-date
      678         ,input  1
      679         ,input  1
      680         ,input  p-shift-date
      681         ,input  p-shift-num
      682         ,input  p-shift-on
      683         ,output v-fact-order
      684         ,output p-shift-end-fact-order
      685         ,output p-day-end-fact-order
      686         ) no-error .
      687       if error-status :error
      688       then do:
      689         message
      690           vss-workfile vss-revision vss-description skip
      691           "Ошибка при вызове процедуры factord"
      692           error-status :get-message(1) skip
      693           return-value skip
      694           view-as alert-box error .
      695         undo, return error return-value .
      696       end.
      697     end.
      698   end procedure.
      699   procedure factord-lock-shift :
      700     define input  parameter p-obj-type  as character no-undo .
      701     define input  parameter p-obj-code  as integer   no-undo .
      702     define input  parameter p-fact-date as date      no-undo .
      703     define parameter buffer buf_shift-obj for ub.shift-obj .
      704     define variable v-shift-on      as logical   no-undo .
      705     define variable v-extra-message as character no-undo .
      706     define variable v-error as character no-undo .
      707     do
      708     on error undo, return error return-value
      709     :
      710   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      712     (input  p-obj-type
      713     ,input  p-obj-code
      714     ,input  'shift-on=request'
      715     ,output v-shift-on
      716     ) no-error .
      717       if error-status :error
      718       then do:
      719         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      720         undo, return error v-error .
      721       end.
      722       if v-shift-on = true
      723       then do:
      724         find first buf_shift-obj share-lock
      725           where buf_shift-obj.obj-type   = p-obj-type
      726             and buf_shift-obj.obj-code   = p-obj-code
      727             and buf_shift-obj.shift-date > p-fact-date
      728           use-index pi
      729           no-error .
      730         if not available buf_shift-obj
      731         or buf_shift-obj.status_ <> 'зкр':U
      732         then do:
      733           find last buf_shift-obj
      734             where buf_shift-obj.obj-type = p-obj-type
      735               and buf_shift-obj.obj-code = p-obj-code
      736               and buf_shift-obj.status_  = 'зкр':U
      737             use-index stts
      738             no-error .
      739           if available buf_shift-obj
      740           then do:
      741             assign
      742               v-extra-message =
      743                     substitute("Дата начала последеней закрытой смены на объекте &1"
      744                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      745                               )
      746             .
      747           end.
      748           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      749           undo, return error v-error .
      750         end.
      751       end.
      752     end.
      753   end procedure.
      754   procedure factord-end-day :
      755     define input  parameter p-fact-date            as date    no-undo .
      756     define output parameter p-day-end-fact-order   as decimal no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760       if p-fact-date = ?
      761       then do:
      762         return error "Не указана фактическая дата" .
      763       end.
      764       assign
      765         p-day-end-fact-order = integer(p-fact-date) + 0.99
      766       .
      767     end.
      768   end procedure.
      769   procedure factord-to-date :
      770     define input  parameter p-fact-order as decimal no-undo .
      771     define output parameter p-fact-date  as date    no-undo .
      772     define variable v-ref-date  as date      no-undo .
      773     define variable v-ref-delta as integer   no-undo .
      774     do
      775     on error undo, return error return-value
      776     :
      777       if p-fact-order = ?
      778       or p-fact-order = 0
      779       then do:
      780         return error "Не указан fact-order" .
      781       end.
      782       assign
      783         v-ref-date  = date(1, 1, 2000)
      784       .
      785       assign
      786         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      787       .
      788       assign
      789         p-fact-date = v-ref-date + v-ref-delta
      790       .
      791     end.
      792   end procedure.
      793   procedure factord-to-fact-num :
      794     define input  parameter p-fact-order as decimal no-undo .
      795     define output parameter p-fact-num   as integer no-undo .
      796     define variable v-fact-order-trunc as decimal no-undo .
      797     do
      798     on error undo, return error return-value
      799     :
      800       if p-fact-order = ?
      801       or p-fact-order = 0
      802       then do:
      803         return error "Не указан fact-order" .
      804       end.
      805       assign
      806        v-fact-order-trunc = truncate(p-fact-order, 2)
      807       .
      808       assign
      809         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      810       .
      811     end.
      812   end procedure.
      813   procedure factord-to-shift-num :
      814     define input  parameter p-fact-order as decimal no-undo .
      815     define output parameter p-shift-num   as integer no-undo .
      816     define variable  p-shift-numd  as decimal   no-undo .
      817     define variable v-fact-order-trunc as decimal no-undo .
      818     do
      819     on error undo, return error return-value
      820     :
      821       if p-fact-order = ?
      822       or p-fact-order = 0
      823       then do:
      824         return error "Не указан fact-order" .
      825       end.
      826       assign
      827        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      828       .
      829       if v-fact-order-trunc < 0.5 then do:
      830         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      831       end.
      832       assign
      833         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      834         .
      835        assign
      836         p-shift-num = truncate (p-shift-numd , 0)
      837       .
      838     end.
      839   end procedure.
      840   define new global shared variable g#lib-trn  as handle no-undo .
      841   define new global shared variable g#lib-trn2 as handle no-undo .
      842   define new global shared variable g#lib-trn3 as handle no-undo .
      843   define new global shared variable g#lib-trn4 as handle no-undo .
      844   define temp-table  tt-tax no-undo
      845     field tax-code    like ub.tax.tax-code
      846     field individual  like ub.tax.individual
      847     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      848     field rate-code   like ub.tax-rate.rate-code
      849     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      850     field tax-type    like ub.tax.tax-type
      851     field rate-value  like ub.tax-rate-value.rate-value
      852     field tax-rate-gds-rc  as recid
      853     field to-cashdesk like ub.tax.to-cashdesk
      854     index tax-code is unique primary tax-code
      855     .
      856   procedure tax-val :
      857     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      858     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      859     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      860     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      861     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      862     define input  parameter       parunits-type like ub.units.type         no-undo.
      863     define input  parameter       parrec-id     as recid                   no-undo.
      864     define input  parameter       paris-log     as logical                 no-undo.
      865     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      866     define input  parameter       vattaxcdvalue as integer                 no-undo.
      867     define input  parameter       exctaxcdvalue as integer                 no-undo.
      868     define input  parameter       only-check    as logical                 no-undo.
      869     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      870     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      871     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      872     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      873     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      874     define output parameter       parerr-mes    as character               no-undo.
      875     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      881   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      882   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      883   define variable gp-excise     like ub.price-list.excise     no-undo.
      884   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      885   define variable gp-fact-order as decimal   no-undo .
      886   define variable gp-price-sale-parts as decimal   no-undo .
      887       define buffer buf_tax          for ub.tax .
      888       define buffer buf_tax-rate     for ub.tax-rate .
      889       define buffer buf_tax-units    for ub.tax-units .
      890       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      891       define buffer buf_goods        for ub.goods .
      892       define buffer buf_bar-code     for ub.bar-code .
      893       define buffer buf_prod-bc      for ub.prod-bc .
      894       define buffer buf_units        for ub.units .
      895       define buffer buf_shop         for ub.shop .
      896       define buffer buf_store        for ub.store .
      897       define buffer buf_gds-prt      for ub.gds-prt .
      898       define buffer buf_tt-tax       for tt-tax .
      899       define variable varrate-value    as decimal   initial ? no-undo.
      900       define variable pr-list-recid    as recid     initial ? no-undo.
      901       define variable varmes           as character no-undo.
      902       define variable varfactorrtvalue as char      initial ? no-undo.
      903       define variable varfactorrttype  as char      initial ? no-undo.
      904       define variable is-petrolium     as logical no-undo.
      905       define variable is-pieces        as logical no-undo.
      906       define variable vargds-code      like ub.goods.gds-code no-undo.
      907       define variable pargds-code      like ub.goods.gds-code no-undo.
      908       define variable var-fact-order   as decimal no-undo .
      909       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      910       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      911       define variable currate-gds-rc   as recid no-undo .
      912       define variable v-today          as date no-undo .
      913       define variable v-time           as integer no-undo .
      914       for each buf_tt-tax:
      915         delete buf_tt-tax.
      916       end.
      917       run cur-time in this-procedure(output v-today, output v-time).
      918       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      919       if parartic     = ?
      920       or parprod-type = ?
      921       or parprod-code = ?
      922       or parunit-base = ?
      923       then do:
      924         find first buf_goods no-lock
      925           where recid(buf_goods) = parrec-id
      926           no-error .
      927       end.
      928       else do:
      929         find first buf_goods no-lock
      930           where buf_goods.artic = parartic
      931             and buf_goods.prod-type = parprod-type
      932             and buf_goods.prod-code = parprod-code
      933           no-error .
      934       end.
      935       if not available buf_goods then do:
      936         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      937         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      938       end.
      939       assign
      940         parartic     = buf_goods.artic
      941         parprod-type = buf_goods.prod-type
      942         parprod-code = buf_goods.prod-code
      943         parunit-base = buf_goods.unit-base
      944         pargds-code  = buf_goods.gds-code
      945       .
      946       if parunits-type = ?
      947       then do:
      948         find buf_units no-lock
      949           where buf_units.unit-name = parunit-base
      950           no-error .
      951         if not available buf_units then do:
      952           assign
      953             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      954           .
      955           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      956         end.
      957         assign
      958           parunits-type = buf_units.type
      959         .
      960       end.
      961       if parhost-code = ?
      962       or parhost-code = 0
      963       then do:
      964   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      965   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      966     (input  parobj-type
      967     ,input  abs(parobj-code)
      968     ,output parhost-code
      969     ) no-error .
      970         if error-status :error then do:
      971           assign
      972             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      973               ,string(parobj-type)
      974               ,string(parobj-code)
      975               ) + chr(10)
      976           .
      977           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      978         end.
      979       end.
      980       assign
      981         vargds-code = buf_goods.gds-code
      982       .
      983       for each buf_tax-units no-lock
      984         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      985       ,first buf_tax no-lock
      986         where buf_tax.tax-code = buf_tax-units.tax-code
      987       :
      988         find first buf_tt-tax where
      989                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      990         if not available buf_tt-tax then do:
      991           create buf_tt-tax .
      992         end.
      993         assign
      994           buf_tt-tax.tax-code = buf_tax.tax-code
      995         .
      996         if buf_tax.individual = false then do:
      997           assign
      998             currate-gds-rc = ?
      999           .
     1000           _tax-rate-gds:
     1001           for each buf_tax-rate-gds no-lock where
     1002                   buf_tax-rate-gds.gds-code = pargds-code and
     1003                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
     1004           first buf_tax-rate where
     1005                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
     1006                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
     1007           by buf_tax-rate-gds.host-code
     1008           by buf_tax-rate-gds.obj-type
     1009           by buf_tax-rate-gds.obj-code
     1010           by buf_tax-rate-gds.fact-order
     1011           :
     1012             if buf_tax-rate-gds.fact-order > var-fact-order then do:
     1013               next _tax-rate-gds.
     1014             end.
     1015             if buf_tax-rate-gds.host-code = 0 or
     1016               ((buf_tax-rate-gds.host-code = parhost-code) or
     1017               (buf_tax-rate-gds.obj-type = parobj-type AND
     1018               buf_tax-rate-gds.obj-code = parobj-code))
     1019             then do:
     1020               assign
     1021               currate-code = buf_tax-rate.rate-code
     1022               currate-name = buf_tax-rate.rate-name
     1023               currate-gds-rc = recid(buf_tax-rate)
     1024               .
     1025             end.
     1026             else do:
     1027               next _tax-rate-gds.
     1028             end.
     1029           end.
     1030           if currate-gds-rc = ? then do:
     1031             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
     1032                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1033                             chr(10).
     1034             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1035           end.
     1036         end.
     1037         assign
     1038           buf_tt-tax.rate-code   = currate-code
     1039           buf_tt-tax.individual  = buf_tax.individual
     1040           buf_tt-tax.tax-name    = buf_tax.tax-name
     1041           buf_tt-tax.rate-name   = currate-name
     1042           buf_tt-tax.tax-type    = buf_tax.tax-type
     1043           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
     1044           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
     1045         .
     1046       end.
     1047       if parprice-sale = ?
     1048       or parexcise     = ?
     1049       or parroad-tax   = ?
     1050       then do:
     1051         if parnode-code = ? then do:
     1052             FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1053             parnode-code = buf_gds-prt.node-code.
     1054         end.
