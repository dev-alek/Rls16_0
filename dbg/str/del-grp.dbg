    10629                                               ,input 'taracode-bc':U
    10630                                               ,input 'маг':U
    10631                                               ,input i-obj-code
    10632                                               ,output v-taracode-bc
    10633                                               ,output v-type) no-error.
    10634           if not error-status:error
