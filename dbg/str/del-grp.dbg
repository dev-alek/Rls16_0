     1169                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1170               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1171             end.
     1172           end.
     1173           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1174             ASSIGN
