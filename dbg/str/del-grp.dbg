    10617       end.
    10618     end.
    10619             end.
    10620           end.
    10621         end.
    10622       end.
    10623       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10624       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
    10625             or
    10626             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
    10627       then do:
