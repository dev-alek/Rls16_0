     6428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6429     (input  p-obj-type
     6430     ,input  p-obj-code
     6431     ,output to-day
     6432     )  .
     6433   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6435     (input  p-obj-type
     6436     ,input  p-obj-code
     6437     ,output v-host-code
     6438     )  .
     6439   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6441     (input  v-host-code
     6442     ,input  to-day
     6443     ,output v-base-rate0
     6444     ,output v-base-scale0
     6445     )  .
     6446     v-cli-oborot-ALL  = 0 .
     6447     for each buf_turnover-buyer-main no-lock  where
     6448              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6449              buf_turnover-buyer-main.cli-code = p-cli-code
     6450              :
     6451              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6452     end.
     6453   for each buf_price-all no-lock where
     6454            buf_price-all.obj-type = p-obj-type and
     6455            buf_price-all.obj-code = p-obj-code and
     6456            buf_price-all.gds-code = buf_goods.gds-code and
     6457            buf_price-all.status_  = 'акт':U  and
     6458          ( p-only-b-code = false   or
     6459          ( buf_price-all.b-code = p-main-b-code or
     6460            buf_price-all.b-code = p-b-code))    and
     6461           ( p-only-b-code = true  or
     6462             buf_price-all.b-code = p-b-code)
     6463             and
     6464             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6465           ( buf_price-all.fact-order-sys-to = ? or
     6466             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6467           :
     6468            v-interv   = "" .
     6469            v-grp-name = "" .
     6470            v-pay-name = "" .
     6471            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6472            if buf_price-all.bgr-id > 0 then do:
     6473               find first buf_buyer-group no-lock where
     6474                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6475                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6476               if available buf_buyer-group then do:
     6477                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6478                  find first buf_buyer-in-buyer-group no-lock where
     6479                             buf_buyer-in-buyer-group.stts         = 0 and
     6480                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6481                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6482                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6483                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6484                             no-error .
     6485                             if not available buf_buyer-in-buyer-group then do:
     6486                                v-grp-name = "".
     6487                                next.
     6488                             end.
     6489                             v-grp-name = buf_buyer-group.name .
     6490                  end.
     6491               end.
     6492               else do:
     6493                    v-grp-name = "".
     6494                    next.
     6495               end.
     6496            end.
     6497            if buf_price-all.tog-id > 0 then do:
     6498               find first buf_turnover-group no-lock where
     6499                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6500                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6501               if available buf_turnover-group then do:
     6502                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6503                     v-cli-oborot = v-cli-oborot-all  .
     6504                     find first buf1_tnv-in-turnover-group no-lock where
     6505                                buf1_tnv-in-turnover-group.stts       =  0     and
     6506                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6507                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6508                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6509                     find first buf2_tnv-in-turnover-group no-lock where
     6510                                buf2_tnv-in-turnover-group.stts       =  0     and
     6511                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6512                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6513                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6514                     if not (available buf1_tnv-in-turnover-group and
     6515                             available buf2_tnv-in-turnover-group ) then do:
     6516                             v-grp-name = "".
     6517                             next .
     6518                     end.
     6519                     v-grp-name = buf_turnover-group.name.
     6520                  end.
     6521               end.
     6522               else do:
     6523                    v-grp-name = "".
     6524                    next.
     6525               end.
     6526            end.
     6527            if buf_price-all.plt-fix-cource-crc-base = true then
     6528               assign
     6529                 v-base-rate  = buf_price-all.pdf-base-rate
     6530                 v-base-scale = buf_price-all.pdf-base-scale
     6531               .
     6532               else
     6533               assign
     6534                 v-base-rate  = v-base-rate0
     6535                 v-base-scale = v-base-scale0
     6536               .
     6537            if buf_price-all.plt-fix-cource-crc-doc = true then
     6538               assign
     6539                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6540                 v-exch-scale = buf_price-all.pdf-exch-scale
     6541               .
     6542               else do:
     6543   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6545     (input  buf_price-all.curr-code
     6546     ,input  to-day
     6547     ,output v-exch-rate0
     6548     ,output v-exch-scale0
     6549     ,output v-curr-abbr
     6550     )  .
     6551               assign
     6552                 v-exch-rate  = v-exch-rate0
     6553                 v-exch-scale = v-exch-scale0
     6554                 .
     6555              end.
     6556              v-date-1 = date ( "" )  .
     6557              if buf_price-all.fact-order-sys-from > 0 then do:
     6558                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6559                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6560                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6561              end.
     6562              v-date-2 =  date ( "" )  .
     6563              if buf_price-all.fact-order-sys-to > 0 then do:
     6564                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6565                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6566                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6567              end.
     6568              if buf_price-all.qnty-from <> ? then do :
     6569                 if not (
     6570                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6571                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6572                 ) then do:
     6573                        v-interv = "".
     6574                        next.
     6575                 end.
     6576                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6577              end.
     6578              if buf_price-all.sum-from <> ? then do :
     6579                 if not (
     6580                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6581                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6582                 ) then do:
     6583                    v-interv = "".
     6584                    next.
     6585                 end.
     6586                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6587              end.
     6588              if buf_price-all.turnover-from <> ? then do :
     6589                 if not (
     6590                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6591                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6592                 ) then do:
     6593                    v-interv = "".
     6594                    next.
     6595                 end.
     6596                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6597              end.
     6598              if buf_price-all.use-pay-type = 1 then do :
     6599                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6600                    v-pay-name = "" .
     6601                    next.
     6602                  end.
     6603                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6604              end.
     6605              if buf_price-all.use-cash-pay = 1 then do :
     6606                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6607                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6608                   v-pay-name = "" .
     6609                   next.
     6610                 end.
     6611                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6612              end.
     6613             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6614             create tt_price-all .
     6615             buffer-copy buf_price-all to tt_price-all
     6616             assign
     6617               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6618               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6619               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6620               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6621               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6622               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6623               tt_price-all.price-sale     = buf_price-all.price-sale
     6624               tt_price-all.road-tax       = buf_price-all.road-tax
     6625               tt_price-all.excise         = buf_price-all.excise
     6626               tt_price-all.pdf-exch-rate   = v-exch-rate
     6627               tt_price-all.pdf-exch-scale  = v-exch-scale
     6628               tt_price-all.pdf-base-rate   = v-base-rate
     6629               tt_price-all.pdf-base-scale  = v-base-scale
     6630               tt_price-all.grp-name        = v-grp-name
     6631               tt_price-all.date-1          = v-date-1
     6632               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6633               tt_price-all.time-1          = buf_price-all.start-sys-time
     6634               tt_price-all.date-2          = v-date-2
     6635               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6636               tt_price-all.time-2          = buf_price-all.end-sys-time
     6637               tt_price-all.interv-name     = v-interv
     6638               tt_price-all.pay-name        = v-pay-name
     6639               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6640             .
     6641   end.
     6642   define variable vt-plt-id as integer   no-undo .
     6643   define variable vt-plt-db as integer   no-undo .
     6644   define variable vt-pdf-id as integer   no-undo .
     6645   define variable vt-pdf-db as integer   no-undo .
     6646   define buffer neos_price-all for tt_price-all  .
     6647   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6648       if available tt_price-all then do:
     6649        assign
     6650          vt-plt-id = tt_price-all.plt-id
     6651          vt-plt-db = tt_price-all.plt-db-num
     6652          vt-pdf-id = tt_price-all.pdf-id
     6653          vt-pdf-db = tt_price-all.pdf-db
     6654        .
     6655        if tt_price-all.b-code = p-b-code then do:
     6656             assign
     6657               p-plt-id           = tt_price-all.plt-id
     6658               p-plt-db-num       = tt_price-all.plt-db-num
     6659               p-pdf-id           = tt_price-all.pdf-id
     6660               p-pdf-db-num       = tt_price-all.pdf-db
     6661               p-sale-price-base  = tt_price-all.price-sale-base
     6662               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6663               p-road-tax-base    = tt_price-all.road-tax-base
     6664               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6665               p-excise-base      = tt_price-all.excise-base
     6666               p-excise-rubl      = tt_price-all.excise-rubl
     6667               .
     6668        end.
     6669        else do:
     6670          find first neos_price-all where
     6671                     neos_price-all.b-code     = p-b-code  and
     6672                     neos_price-all.plt-id     = vt-plt-id and
     6673                     neos_price-all.plt-db-num = vt-plt-db and
     6674                     neos_price-all.pdf-id     = vt-pdf-id and
     6675                     neos_price-all.pdf-db     = vt-pdf-db
     6676                     use-index pi no-error .
     6677            if available neos_price-all then do:
     6678             assign
     6679               p-plt-id           = tt_price-all.plt-id
     6680               p-plt-db-num       = tt_price-all.plt-db-num
     6681               p-pdf-id           = tt_price-all.pdf-id
     6682               p-pdf-db-num       = tt_price-all.pdf-db
     6683               p-sale-price-base  = neos_price-all.price-sale-base
     6684               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6685               p-road-tax-base    = neos_price-all.road-tax-base
     6686               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6687               p-excise-base      = neos_price-all.excise-base
     6688               p-excise-rubl      = neos_price-all.excise-rubl
     6689               .
     6690            end.
     6691            else do:
     6692                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6693                 if error-status :error    then do:
     6694                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6695                   return error return-value .
     6696                 end.
     6697             assign
     6698               p-plt-id           = tt_price-all.plt-id
     6699               p-plt-db-num       = tt_price-all.plt-db-num
     6700               p-pdf-id           = tt_price-all.pdf-id
     6701               p-pdf-db-num       = tt_price-all.pdf-db
     6702               p-sale-price-base  = tt_price-all.price-sale-base
     6703               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6704               p-road-tax-base    = tt_price-all.road-tax-base
     6705               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6706               p-excise-base      = tt_price-all.excise-base
     6707               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6708               .
     6709            end.
     6710        end.
     6711     end.
     6712   end.
     6713   end procedure.
     6714   procedure mpl-tpl-auto :
     6715   define input  parameter p-b-code     as integer   no-undo .
     6716   define input  parameter p-obj-type   as character no-undo .
     6717   define input  parameter p-obj-code   as integer   no-undo .
     6718   define input  parameter p-plt-id     as integer   no-undo .
     6719   define input  parameter p-plt-db-num as integer   no-undo .
     6720   define input  parameter p-fact-order as decimal   no-undo .
     6721   define output parameter p-sale-price as decimal   no-undo .
     6722   define output parameter p-pdf-id     as integer   no-undo .
     6723   define output parameter p-pdf-db-num as integer   no-undo .
     6724     do
     6725     on error undo, return error return-value
     6726     :
     6727   if p-fact-order = ? then do:
     6728     run fact-order-mpl (
     6729         input   today       ,
     6730         input   p-obj-type  ,
     6731         input   p-obj-code  ,
     6732         output  p-fact-order ) .
     6733   end.
     6734   assign
     6735     p-pdf-id      = ?
     6736     p-pdf-db-num  = ?
     6737     p-sale-price  = ?
     6738   .
     6739   define buffer buf_bar-code for ub.bar-code  .
     6740   define buffer buf_goods for ub.goods  .
     6741   find first buf_bar-code no-lock where
     6742              buf_bar-code.b-code = p-b-code
     6743              no-error .
     6744   if error-status :error then return error return-value .
     6745   find first buf_goods no-lock where
     6746              buf_goods.gds-code = buf_bar-code.gds-code
     6747              no-error .
     6748   if error-status :error then return error return-value .
     6749   define variable v-main-b-code as integer   no-undo .
     6750   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6751     (input  buf_goods.gds-code
     6752     ,input  ?
     6753     ,output v-main-b-code
     6754     )  .
     6755   define buffer buf_price-all for ub.price-all  .
     6756   for each tt_price-all : delete tt_price-all. end.
     6757       for each buf_price-all no-lock where
     6758               buf_price-all.plt-id     = p-plt-id                 and
     6759               buf_price-all.plt-db-num = p-plt-db-num             and
     6760               buf_price-all.obj-type   = p-obj-type               and
     6761               buf_price-all.obj-code   = p-obj-code               and
     6762               buf_price-all.gds-code   = buf_goods.gds-code       and
     6763             ( buf_price-all.b-code = v-main-b-code or
     6764               buf_price-all.b-code = p-b-code)    and
     6765               buf_price-all.status_    = 'акт':U         and
     6766               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6767             ( buf_price-all.fact-order-sys-to = ? or
     6768               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6769               :
     6770                 create tt_price-all .
     6771                 buffer-copy buf_price-all to tt_price-all
     6772                 assign
     6773                   tt_price-all.price-sale  = buf_price-all.price-sale
     6774                 .
     6775       end.
     6776   define variable vt-plt-id as integer   no-undo .
     6777   define variable vt-plt-db as integer   no-undo .
     6778   define variable vt-pdf-id as integer   no-undo .
     6779   define variable vt-pdf-db as integer   no-undo .
     6780   define buffer neos_price-all for tt_price-all  .
     6781   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6782       if available tt_price-all then do:
     6783        assign
     6784          vt-plt-id = tt_price-all.plt-id
     6785          vt-plt-db = tt_price-all.plt-db-num
     6786          vt-pdf-id = tt_price-all.pdf-id
     6787          vt-pdf-db = tt_price-all.pdf-db
     6788        .
     6789        if tt_price-all.b-code = p-b-code then do:
     6790             assign
     6791               p-plt-id           = tt_price-all.plt-id
     6792               p-plt-db-num       = tt_price-all.plt-db-num
     6793               p-pdf-id           = tt_price-all.pdf-id
     6794               p-pdf-db-num       = tt_price-all.pdf-db
     6795               p-sale-price       = tt_price-all.price-sale
     6796               .
     6797        end.
     6798        else do:
     6799          find first neos_price-all where
     6800                     neos_price-all.b-code     = p-b-code  and
     6801                     neos_price-all.plt-id     = vt-plt-id and
     6802                     neos_price-all.plt-db-num = vt-plt-db and
     6803                     neos_price-all.pdf-id     = vt-pdf-id and
     6804                     neos_price-all.pdf-db     = vt-pdf-db
     6805                     use-index pi no-error .
     6806            if available neos_price-all then do:
     6807             assign
     6808               p-plt-id           = tt_price-all.plt-id
     6809               p-plt-db-num       = tt_price-all.plt-db-num
     6810               p-pdf-id           = tt_price-all.pdf-id
     6811               p-pdf-db-num       = tt_price-all.pdf-db
     6812               p-sale-price       = neos_price-all.price-sale
     6813               .
     6814            end.
     6815            else do:
     6816           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6817           if error-status :error    then do:
     6818              message "Не найден бар-код" p-b-code view-as alert-box error .
     6819              return error return-value .
     6820           end.
     6821             assign
     6822               p-plt-id           = tt_price-all.plt-id
     6823               p-plt-db-num       = tt_price-all.plt-db-num
     6824               p-pdf-id           = tt_price-all.pdf-id
     6825               p-pdf-db-num       = tt_price-all.pdf-db
     6826               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6827               .
     6828            end.
     6829        end.
     6830     end.
     6831     end.
     6832   end procedure.
