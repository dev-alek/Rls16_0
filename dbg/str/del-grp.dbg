     1894   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1895   procedure cur-time :
     1896      define output parameter p-today as date      no-undo .
     1897      define output parameter p-time  as integer   no-undo .
     1898     do
     1899     on error undo, return error
     1900     :
     1901       define variable v-date1 as date      no-undo .
     1902       define variable v-date2 as date      no-undo .
     1903       define variable v-time  as integer   no-undo .
     1904       assign
     1905         v-date1 = today
     1906         v-time  = time
     1907         v-date2 = today
     1908       .
     1909       if v-date1 <> v-date2
     1910       then do:
     1911         assign
     1912           v-date1 = today
     1913           v-time  = v-time
     1914         .
     1915       end.
     1916       assign
     1917         p-today = v-date1
     1918         p-time  = v-time
     1919       .
     1920     end.
     1921   end.
     1922   function cur-time-date returns character
     1923   :
     1924     return string(today, '99/99/9999':U) .
     1925   end.
     1926   function cur-time-mjd returns decimal
     1927   :
     1928     define variable v-date as date      no-undo .
     1929     define variable v-time as integer   no-undo .
     1930     run cur-time in this-procedure
     1931       (output v-date
     1932       ,output v-time
     1933       ) .
     1934     return integer(v-date) - 2400002 + (v-time / 86400) .
     1935   end.
     1936   function cur-time-get-ending-index returns integer
     1937   (input p-number as integer
     1938   )
     1939   :
     1940     if p-number < 0
     1941     or p-number = ?
     1942     then do:
     1943       return 1 .
     1944     end.
     1945     define variable v-rest as integer   no-undo .
     1946     assign
     1947       p-number = p-number modulo 100
     1948     .
     1949     if p-number < 20
     1950     then do:
     1951       assign
     1952         v-rest = p-number
     1953       .
     1954     end.
     1955     else do:
     1956       assign
     1957         v-rest = p-number modulo 10
     1958       .
     1959     end.
     1960     case v-rest :
     1961       when 1
     1962       then do:
     1963         return 2 .
     1964       end.
     1965       when 2 or
     1966       when 3 or
     1967       when 4
     1968       then do:
     1969         return 3 .
     1970       end.
     1971       otherwise do:
     1972         return 1 .
     1973       end.
     1974     end case .
     1975   end.
     1976   procedure cur-time-mjd-to-date :
     1977      define input  parameter i-mjd-diff as decimal no-undo.
     1978      define output parameter o-Date     as date    no-undo.
     1979      define output parameter o-Time     as integer no-undo.
     1980      define variable v-day-number as integer   no-undo .
     1981      if    i-mjd-diff < 0
     1982         or i-mjd-diff = ?
     1983      then do:
     1984         return "?" .
     1985      end.
     1986      assign
     1987         v-day-number = truncate(i-mjd-diff,0).
     1988         o-Date = date(v-day-number + 2400002).
     1989         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1990     .
     1991   end.
     1992   function cur-time-mjd-to-string returns character
     1993   (input p-mjd-diff as decimal
     1994   )
     1995   :
     1996     define variable v-day-number as integer   no-undo .
     1997     define variable v-seconds    as integer   no-undo .
     1998     define variable v-hour       as integer   no-undo .
     1999     define variable v-min        as integer   no-undo .
     2000     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2001     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2002     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2003     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2004     if p-mjd-diff < 0
     2005     or p-mjd-diff = ?
     2006     then do:
     2007       return "?" .
     2008     end.
     2009     assign
     2010       v-day-number = integer(truncate(p-mjd-diff,0))
     2011       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2012     .
     2013     if v-seconds > 86400
     2014     then do:
     2015       assign
     2016         v-seconds = 86400 - 1
     2017       .
     2018     end.
     2019     if v-seconds < 0
     2020     then do:
     2021       assign
     2022         v-seconds = 0
     2023       .
     2024     end.
     2025     assign
     2026       v-hour = truncate(v-seconds / 3600, 0)
     2027     .
     2028     assign
     2029       v-seconds = v-seconds modulo 3600
     2030     .
     2031     assign
     2032       v-min = truncate(v-seconds / 60, 0)
     2033     .
     2034     assign
     2035       v-seconds = v-seconds modulo 60
     2036     .
     2037     return
     2038         (if v-day-number <> 0
     2039           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2040           else ""
     2041         )
     2042       + (if v-day-number <> 0 or v-hour <> 0
     2043           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2044           else ""
     2045         )
     2046       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2047           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2048           else ""
     2049         )
     2050       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2051       .
     2052   end.
     2053   function cur-time-string returns character
     2054   :
     2055     define variable v-date as date      no-undo .
     2056     define variable v-time as integer   no-undo .
     2057     run cur-time in this-procedure
     2058       (output v-date
     2059       ,output v-time
     2060       ) .
     2061     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2062   end.
     2063   function cur-time-string-sec returns character
     2064   :
     2065     define variable v-date as date      no-undo .
     2066     define variable v-time as integer   no-undo .
     2067     run cur-time in this-procedure
     2068       (output v-date
     2069       ,output v-time
     2070       ) .
     2071     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2072   end.
     2073   function cur-time-custom  returns character
     2074   (input p-prefix as character
     2075   ,input p-date-format as character
     2076   ,input p-delimiter as character
     2077   ,input p-time-format as character
     2078   ,input p-suffix as character
     2079   )
     2080   :
     2081     define variable v-date as date      no-undo .
     2082     define variable v-time as integer   no-undo .
     2083     run cur-time in this-procedure
     2084       (output v-date
     2085       ,output v-time
     2086       ) .
     2087     return
     2088       p-prefix
     2089       + string(v-date, p-date-format)
     2090       + p-delimiter
     2091       + string(v-time, p-time-format)
     2092       + p-suffix
     2093       .
     2094   end.
     2095   function cur-time-print  returns character
     2096   :
     2097     define variable v-date as date      no-undo .
     2098     define variable v-time as integer   no-undo .
     2099     run cur-time in this-procedure
     2100       (output v-date
     2101       ,output v-time
     2102       ) .
     2103     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2104   end.
     2105   function cur-time-datetime returns datetime
     2106   :
     2107     define variable v-char as character no-undo .
     2108     define variable v-datetime as datetime no-undo .
     2109     v-char = cur-time-string().
     2110     v-datetime = datetime(v-char).
     2111     return  v-datetime.
     2112   end.
     2113   function cur-time-string-msec returns character
     2114   :
     2115     define variable v-date as datetime  no-undo .
     2116     v-date = now.
     2117     return string(v-date) .
     2118   end.
     2119   define variable vss-include-info27 as character format "X(65)" no-undo
     2120   initial "@(#)$Workfile$ $Revision$".
     2121   procedure xmlchar-test :
     2122   define input parameter p-in-string          as character        no-undo.
     2123   define output parameter p-out-string-enc    as character        no-undo.
     2124   define output parameter p-out-string-dec    as character        no-undo.
     2125   do
     2126   on error undo, return error
     2127   :
     2128          run xmlchar-encode in this-procedure
     2129       (
     2130             input p-in-string
     2131           , output p-out-string-enc
     2132       ).
     2133          run xmlchar-decode in this-procedure
     2134       (
     2135             input p-out-string-enc
     2136           , output p-out-string-dec
     2137       ).
     2138   end.
     2139   end .
     2140   procedure xmlchar-encode :
     2141   define input parameter p-in-string      as character        no-undo.
     2142   define output parameter p-out-string    as character        no-undo.
     2143       define variable v-position      as integer      no-undo.
     2144       define variable v-current-char  as character    no-undo.
     2145   do
     2146   on error undo, return error
     2147   :
     2148       assign
     2149           p-out-string = "":U
     2150       .
     2151       case p-in-string
     2152       :
     2153           when ?
     2154           then do:
     2155               assign
     2156                   p-out-string = "?":U
     2157               .
     2158           end.
     2159           when "?":U
     2160           then do:
     2161               assign
     2162                   p-out-string = "&#63;":U
     2163               .
     2164           end.
     2165           otherwise do:
     2166               do v-position = 1 to length( p-in-string )
     2167               :
     2168                   assign
     2169                       v-current-char = substring( p-in-string, v-position, 1 )
     2170                   .
     2171                   case v-current-char
     2172                   :
     2173                       when "&":U
     2174                       then do:
     2175                           assign
     2176                               p-out-string = p-out-string + "&amp;":U
     2177                           .
     2178                       end.
     2179                       when ">":U
     2180                       then do:
     2181                           assign
     2182                               p-out-string = p-out-string + "&gt;":U
     2183                           .
     2184                       end.
     2185                       when "<":U
     2186                       then do:
     2187                           assign
     2188                               p-out-string = p-out-string + "&lt;":U
     2189                           .
     2190                       end.
     2191                       when "'":U
     2192                       then do:
     2193                           assign
     2194                               p-out-string = p-out-string + "&apos;":U
     2195                           .
     2196                       end.
     2197                       when '"':U
     2198                       then do:
     2199                           assign
     2200                               p-out-string = p-out-string + "&quot;":U
     2201                           .
     2202                       end.
     2203                       when chr(1)
     2204                       then do:
     2205                           assign
     2206                               p-out-string = p-out-string + "":U
     2207                           .
     2208                       end.
     2209                       when chr(2)
     2210                       then do:
     2211                           assign
     2212                               p-out-string = p-out-string + "":U
     2213                           .
     2214                       end.
     2215                       when chr(3)
     2216                       then do:
     2217                           assign
     2218                               p-out-string = p-out-string + "":U
     2219                           .
     2220                       end.
     2221                       when chr(4)
     2222                       then do:
     2223                           assign
     2224                               p-out-string = p-out-string + "":U
     2225                           .
     2226                       end.
     2227                       when chr(5)
     2228                       then do:
     2229                           assign
     2230                               p-out-string = p-out-string + "":U
     2231                           .
     2232                       end.
     2233                       when chr(6)
     2234                       then do:
     2235                           assign
     2236                               p-out-string = p-out-string + "":U
     2237                           .
     2238                       end.
     2239                       when chr(7)
     2240                       then do:
     2241                           assign
     2242                               p-out-string = p-out-string + "":U
     2243                           .
     2244                       end.
     2245                       when chr(8)
     2246                       then do:
     2247                           assign
     2248                               p-out-string = p-out-string + "":U
     2249                           .
     2250                       end.
     2251                       when chr(9)
     2252                       then do:
     2253                           assign
     2254                               p-out-string = p-out-string + "":U
     2255                           .
     2256                       end.
     2257                       when chr(29)
     2258                       then do:
     2259                           assign
     2260                               p-out-string = p-out-string + "":U
     2261                           .
     2262                       end.
     2263                       when chr(10)
     2264                       then do:
     2265                           assign
     2266                               p-out-string = p-out-string + "&#10;":U
     2267                           .
     2268                       end.
     2269                       when chr(13)
     2270                       then do:
     2271                           assign
     2272                               p-out-string = p-out-string + "&#13;":U
     2273                           .
     2274                       end.
     2275                       otherwise do:
     2276                           assign
     2277                               p-out-string = p-out-string + v-current-char
     2278                           .
     2279                       end.
     2280                   end case.
     2281               end.
     2282           end.
     2283       end case.
     2284   end.
     2285   end .
     2286   procedure xmlchar-encode-1c :
     2287   define input parameter p-in-string      as character        no-undo.
     2288   define output parameter p-out-string    as character        no-undo.
     2289       define variable v-position      as integer      no-undo.
     2290       define variable v-current-char  as character    no-undo.
     2291   do
     2292   on error undo, return error
     2293   :
     2294       assign
     2295           p-out-string = "":U
     2296       .
     2297       case p-in-string
     2298       :
     2299           when ?
     2300           then do:
     2301               assign
     2302                   p-out-string = "?":U
     2303               .
     2304           end.
     2305           otherwise do:
     2306               do v-position = 1 to length( p-in-string )
     2307               :
     2308                   assign
     2309                       v-current-char = substring( p-in-string, v-position, 1 )
     2310                   .
     2311                   case v-current-char
     2312                   :
     2313                       when chr(1)
     2314                       then do:
     2315                           assign
     2316                               p-out-string = p-out-string + " ":U
     2317                           .
     2318                       end.
     2319                       when chr(2)
     2320                       then do:
     2321                           assign
     2322                               p-out-string = p-out-string + " ":U
     2323                           .
     2324                       end.
     2325                       when chr(3)
     2326                       then do:
     2327                           assign
     2328                               p-out-string = p-out-string + " ":U
     2329                           .
     2330                       end.
     2331                       when chr(4)
     2332                       then do:
     2333                           assign
     2334                               p-out-string = p-out-string + " ":U
     2335                           .
     2336                       end.
     2337                       when chr(5)
     2338                       then do:
     2339                           assign
     2340                               p-out-string = p-out-string + " ":U
     2341                           .
     2342                       end.
     2343                       when chr(6)
     2344                       then do:
     2345                           assign
     2346                               p-out-string = p-out-string + " ":U
     2347                           .
     2348                       end.
     2349                       when chr(7)
     2350                       then do:
     2351                           assign
     2352                               p-out-string = p-out-string + " ":U
     2353                           .
     2354                       end.
     2355                       when chr(8)
     2356                       then do:
     2357                           assign
     2358                               p-out-string = p-out-string + " ":U
     2359                           .
     2360                       end.
     2361                       when chr(9)
     2362                       then do:
     2363                           assign
     2364                               p-out-string = p-out-string + " ":U
     2365                           .
     2366                       end.
     2367                       when chr(29)
     2368                       then do:
     2369                           assign
     2370                               p-out-string = p-out-string + " ":U
     2371                           .
     2372                       end.
     2373                       when chr(10)
     2374                       then do:
     2375                           assign
     2376                               p-out-string = p-out-string + " ":U
     2377                           .
     2378                       end.
     2379                       when chr(13)
     2380                       then do:
     2381                           assign
     2382                               p-out-string = p-out-string + " ":U
     2383                           .
     2384                       end.
     2385                       otherwise do:
     2386                           assign
     2387                               p-out-string = p-out-string + v-current-char
     2388                           .
     2389                       end.
     2390                   end case.
     2391               end.
     2392           end.
     2393       end case.
     2394   end.
     2395   end .
     2396   procedure xmlchar-decode :
     2397   define input parameter p-in-string      as character        no-undo.
     2398   define output parameter p-out-string    as character        no-undo.
     2399       define variable v-position      as integer      no-undo.
     2400       define variable v-last-position as integer      no-undo.
     2401       define variable v-temp-integer  as integer      no-undo.
     2402       define variable v-current-char  as character    no-undo.
     2403       define variable v-next-char     as character    no-undo.
     2404       define variable v-success       as logical      no-undo.
     2405   do
     2406   on error undo, return error
     2407   :
     2408       assign
     2409           p-out-string = "":U
     2410           v-position   = 0
     2411       .
     2412       replace-cycle:
     2413       do while yes
     2414       on error undo, return error
     2415       :
     2416           assign
     2417               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2418           .
     2419           if v-last-position <= v-position
     2420           then do:
     2421               if v-position = 0
     2422               then do:
     2423                   assign
     2424                       p-out-string = p-in-string
     2425                   .
     2426               end.
     2427               else do:
     2428                   assign
     2429                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2430                   .
     2431               end.
     2432               leave replace-cycle.
     2433           end.
     2434           else do:
     2435               assign
     2436                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2437                   v-position      = v-last-position
     2438                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2439               .
     2440               if v-current-char = "#":U
     2441               then do:
     2442                   assign
     2443                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2444                   .
     2445                   if v-last-position > 0
     2446                   then do:
     2447                       run xmlchar-read-integer in this-procedure
     2448                        (
     2449                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2450                           , output v-temp-integer
     2451                           , output v-success
     2452                       ).
     2453                       if v-success = yes
     2454                       and v-temp-integer >= 1
     2455                       and v-temp-integer <= 255
     2456                       then do:
     2457                           assign
     2458                               p-out-string = p-out-string + chr( v-temp-integer )
     2459                               v-position   = v-last-position + 1
     2460                           .
     2461                       end.
     2462                       else do:
     2463                           assign
     2464                               p-out-string = p-out-string + "&":U
     2465                               v-position   = v-position   + 1
     2466                           .
     2467                       end.
     2468                   end.
     2469                   else do:
     2470                       assign
     2471                           p-out-string = p-out-string + "&":U
     2472                           v-position   = v-position   + 1
     2473                       .
     2474                   end.
     2475               end.
     2476               else do:
     2477                   case substring( p-in-string, v-position + 1, 3 )
     2478                   :
     2479                       when "lt;":U
     2480                       then do:
     2481                           assign
     2482                               p-out-string = p-out-string + "<":U
     2483                               v-position   = v-position   + 3
     2484                           .
     2485                       end.
     2486                       when "gt;":U
     2487                       then do:
     2488                           assign
     2489                               p-out-string = p-out-string + ">":U
     2490                               v-position   = v-position   + 3
     2491                           .
     2492                       end.
     2493                       otherwise do:
     2494                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2495                           then do:
     2496                               assign
     2497                                   p-out-string = p-out-string + "&":U
     2498                                   v-position   = v-position   + 4
     2499                               .
     2500                           end.
     2501                           else do:
     2502                               case substring( p-in-string, v-position + 1, 5 )
     2503                               :
     2504                                   when "quot;":U
     2505                                   then do:
     2506                                       assign
     2507                                           p-out-string = p-out-string + '"':U
     2508                                           v-position   = v-position   + 5
     2509                                       .
     2510                                   end.
     2511                                   when "apos;":U
     2512                                   then do:
     2513                                       assign
     2514                                           p-out-string = p-out-string + "'":U
     2515                                           v-position   = v-position   + 5
     2516                                       .
     2517                                   end.
     2518                                   otherwise do:
     2519                                       assign
     2520                                           p-out-string = p-out-string + "&":U
     2521                                       .
     2522                                   end.
     2523                               end case.
     2524                           end.
     2525                       end.
     2526                   end case.
     2527               end.
     2528           end.
     2529       end.
     2530   end.
     2531   end .
     2532   procedure xmlchar-read-integer :
     2533   define input parameter p-input-string      as character        no-undo.
     2534   define output parameter p-output-integer   as integer          no-undo.
     2535   define output parameter p-success       as logical          no-undo.
     2536   do
     2537   on error undo, return error
     2538   :
     2539       assign
     2540           p-output-integer = integer( p-input-string )
     2541       no-error.
     2542       if error-status :error
     2543       then do:
     2544           assign
     2545               p-success           = no
     2546               p-output-integer    = 0
     2547           .
     2548       end.
     2549       else do:
     2550           assign
     2551               p-success           = yes
     2552           .
     2553       end.
     2554   end.
     2555   end.
     2556   define variable v-bgelib-bgeclall           as logical      no-undo.
     2557   define variable v-bgelib-bgedict            as logical      no-undo.
     2558   define temp-table temp_ext-doc-type no-undo
     2559       field edt-key               as integer
     2560       field ext-doc-type          as character
     2561       field ext-doc-type-label    as character
     2562       index pi is primary unique
     2563           edt-key
     2564   .
     2565   define temp-table temp_bgelib_goods no-undo
     2566       field gds-code as integer
     2567       index pi is primary unique
     2568           gds-code
     2569   .
     2570   define temp-table temp_bgelib_clients no-undo
     2571       field obj-type as character
     2572       field obj-code as integer
     2573       index pi is primary unique
     2574           obj-type
     2575           obj-code
     2576   .
     2577   define temp-table temp_bgelib_dis-card no-undo
     2578       field d-card as character
     2579       index pi is primary unique
     2580           d-card
     2581   .
     2582   define temp-table temp_bgelib_trn-doc no-undo
     2583       field doc-code as integer
     2584   .
     2585   procedure bgelib-tag-open:
     2586   do
     2587   on error undo, return error
     2588   :
     2589   define input parameter v-tag-level  as integer      no-undo.
     2590   define input parameter v-tag-name   as character    no-undo.
     2591   define input parameter v-tag-value  as character    no-undo.
     2592       put stream stmXMLOut unformatted
     2593           chr(10)
     2594           + fill(" ", 4 * v-tag-level)
     2595           + "<" + v-tag-name
     2596           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2597           + v-tag-value + ">"
     2598       .
     2599   end.
     2600   end procedure.
     2601   procedure bgelib-tag-put:
     2602   do
     2603   on error undo, return error
     2604   :
     2605   define input parameter v-tag-level      as integer      no-undo.
     2606   define input parameter v-tag-name       as character    no-undo.
     2607   define input parameter v-tag-value      as character    no-undo.
     2608   define input parameter v-empty-mode     as integer      no-undo.
     2609       v-tag-name = trim(v-tag-name).
     2610       if  v-empty-mode = 1
     2611       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2612       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2613       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2614       then do:
     2615           run xmlchar-encode in this-procedure (
     2616                 input v-tag-value
     2617               , output v-tag-value
     2618           ).
     2619           put stream stmXMLOut unformatted
     2620               chr(10) + fill(" ", 4 * v-tag-level)
     2621                           + '<' + v-tag-name + '>'
     2622                           + v-tag-value
     2623                           + '</' + v-tag-name + '>'
     2624           .
     2625       end.
     2626   end.
     2627   end procedure.
     2628   procedure bgelib-tag-close:
     2629   do
     2630   on error undo, return error
     2631   :
     2632   define input parameter v-tag-level as integer      no-undo.
     2633   define input parameter v-tag-name  as character    no-undo.
     2634       put stream stmXMLOut unformatted
     2635           chr(10)
     2636           + fill( " ", 4 * v-tag-level)
     2637           + '</' + v-tag-name + '>'
     2638       .
     2639   end.
     2640   end procedure.
     2641   procedure bgelib-write-log:
     2642   do
     2643   on error undo, return error
     2644   :
     2645   define input parameter v-filename   as character    no-undo.
     2646   define input parameter v-log-level  as integer      no-undo.
     2647   define input parameter v-out-string as character    no-undo.
     2648       output stream stmXMLLog to value( v-filename ) append.
     2649       put stream stmXMLLog unformatted
     2650           chr(10)
     2651       .
     2652       put stream stmXMLLog unformatted
     2653           ( if v-log-level = 0
     2654             or v-out-string = "&DLine"
     2655             or v-out-string = "&Line"
     2656             then ""
     2657             else cur-time-string-sec() + " " )
     2658       .
     2659       put stream stmXMLLog unformatted
     2660           ( if v-out-string = "&Line"
     2661             then fill( "-", 80 )
     2662             else if v-out-string = "&DLine"
     2663                  then fill( "=", 80 )
     2664                  else v-out-string )
     2665       .
     2666       output stream stmXMLLog close.
     2667   end.
     2668   end procedure.
     2669   procedure bgelib-write-edt:
     2670   do
     2671   on error undo, return error
     2672   :
     2673   define input parameter v-editor-handle    as handle       no-undo.
     2674   define input parameter v-log-level        as integer      no-undo.
     2675   define input parameter v-out-string       as character    no-undo.
     2676       if valid-handle ( v-editor-handle )
     2677       then do:
     2678           v-editor-handle :move-to-eof().
     2679           v-editor-handle :insert-string( ( if v-log-level = 0
     2680                                             or v-out-string = "&DLine"
     2681                                             or v-out-string = "&Line"
     2682                                             then ""
     2683                                             else cur-time-string-sec() + " "
     2684                                         ) ).
     2685           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2686                                             then fill( "-", 80 )
     2687                                             else if v-out-string = "&DLine" then fill("=", 80)
     2688                                             else fill( " ", v-log-level) + v-out-string
     2689                                         ) ).
     2690           v-editor-handle :insert-string( chr(10) ).
     2691       end.
     2692       process events.
     2693       output to 'bgescn.txt' append.
     2694           put unformatted
     2695               chr(10)
     2696               string( ( if v-log-level = 0
     2697                         or v-out-string = "&DLine"
     2698                         or v-out-string = "&Line"
     2699                         then ""
     2700                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2701                     ) )
     2702               string( ( if v-out-string = "&Line"
     2703                         then fill( "-", 80 )
     2704                         else if v-out-string = "&DLine"
     2705                              then fill( "=", 80 )
     2706                              else fill( " ", v-log-level ) + v-out-string
     2707                     ) )
     2708           .
     2709       output close.
     2710   end.
     2711   end procedure.
     2712   procedure bgelib-show-cnt:
     2713   do
     2714   on error undo, return error
     2715   :
     2716   define input parameter v-fillin-handle     as handle   no-undo.
     2717       if valid-handle( v-fillin-handle )
     2718       then do:
     2719           assign
     2720               v-fillin-handle :visible = true
     2721           .
     2722       end.
     2723   end.
     2724   end procedure.
     2725   procedure bgelib-hide-cnt:
     2726   do
     2727   on error undo, return error
     2728   :
     2729   define input parameter v-fillin-handle     as handle   no-undo.
     2730       if valid-handle( v-fillin-handle )
     2731       then do:
     2732           assign v-fillin-handle :visible = false.
     2733       end.
     2734   end.
     2735   end procedure.
     2736   procedure bgelib-write-cnt:
     2737   do
     2738   on error undo, return error
     2739   :
     2740   define input parameter v-fillin-handle    as handle       no-undo.
     2741   define input parameter v-fillin-string    as character    no-undo.
     2742       if valid-handle( v-fillin-handle )
     2743       then do:
     2744           assign
     2745               v-fillin-handle :SCREEN-value = v-fillin-string
     2746           .
     2747       end.
     2748   end.
     2749   end procedure.
     2750   procedure bgelib-write-header:
     2751   do
     2752   on error undo, return error
     2753   :
     2754   define input parameter p-first-file     as logical      no-undo.
     2755   define input parameter p-xml-file-name  as character    no-undo.
     2756   define input parameter p-list-file-name as character    no-undo.
     2757   define input parameter p-file-number    as integer      no-undo.
     2758   define input parameter p-have-prev      as logical      no-undo.
     2759   define input parameter p-prev-filename  as character    no-undo.
     2760   define input parameter p-obj-list       as character    no-undo.
     2761   define input parameter p-doc-type-list  as character    no-undo.
     2762   define input parameter p-parameter-list as character    no-undo.
     2763       define variable v-counter    as integer        no-undo.
     2764       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2765       put stream stmXMLOut unformatted
     2766           "<?xml version='1.0' encoding='windows-1251'?>"
     2767       .
     2768       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2769       run bgelib-tag-open( input 0, input "header", input "" ).
     2770       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2771       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2772       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2773       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2774       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2775       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2776       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2777       :
     2778           run bgelib-tag-put(
     2779                 input 1
     2780               , input entry( 2 * v-counter, p-parameter-list )
     2781               , input entry( 2 * v-counter + 1, p-parameter-list )
     2782               , input 0
     2783           ).
     2784       end.
     2785       run bgelib-tag-close( input 0, input "header" ).
     2786       output stream stmXMLOut close.
     2787       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2788       if p-first-file = yes
     2789       then do:
     2790           put stream stmXMLOut unformatted
     2791               "<?xml version='1.0' encoding='windows-1251'?>"
     2792           .
     2793           run bgelib-tag-open( input 0, input "export", input "" ).
     2794       end.
     2795       run bgelib-tag-open( input 1, input "file", input "" ).
     2796       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2797       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2798       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2799       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2800       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2801       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2802       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2803       :
     2804           run bgelib-tag-put(
     2805                 input 2
     2806               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2807               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2808               , input 0
     2809           ).
     2810       end.
     2811       run bgelib-tag-close( input 1, input "file" ).
     2812       output stream stmXMLOut close.
     2813   end.
     2814   end procedure.
     2815   procedure bgelib-write-footer:
     2816   do
     2817   on error undo, return error
     2818   :
     2819   define input parameter p-last-file      as logical      no-undo.
     2820   define input parameter p-xml-file-name  as character    no-undo.
     2821   define input parameter p-list-file-name as character    no-undo.
     2822   define input parameter p-have-next      as logical      no-undo.
     2823   define input parameter p-next-file-name as character    no-undo.
     2824       define variable v-error-num     as integer           no-undo.
     2825       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2826       if p-have-next = yes
     2827       then do:
     2828           run bgelib-tag-open( input 0, input "footer", "" ).
     2829           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2830           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2831           run bgelib-tag-close( input 0, input "footer" ).
     2832       end.
     2833       run bgelib-tag-close( input 0, input "root" ).
     2834       output stream stmXMLOut close.
     2835       run bge/os_copy.p (
     2836             input "M"
     2837           , input p-xml-file-name + "tmp"
     2838           , input p-xml-file-name + "xml"
     2839           , output v-error-num
     2840       ).
     2841       if p-last-file = yes
     2842       then do:
     2843           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2844               run bgelib-tag-close( input 0, input "export" ).
     2845           output stream stmXMLOut close.
     2846           run bge/os_copy.p (
     2847                 input "M"
     2848               , input p-list-file-name + "tmp"
     2849               , input p-list-file-name + "xml"
     2850               , output v-error-num
     2851           ).
     2852       end.
     2853   end.
     2854   end procedure.
     2855   procedure bgelib-filename :
     2856   do
     2857   on error undo, return error
     2858   :
     2859   define input parameter p-prefix             as character    no-undo.
     2860   define output parameter p-xml-file-name     as character    no-undo.
     2861   define output parameter p-log-file-name     as character    no-undo.
     2862   define output parameter p-list-file-name    as character    no-undo.
     2863       define variable v-home-dir  as character    no-undo.
     2864       define variable v-error-num as integer      no-undo.
     2865       get-key-value section "BGE" key "outdir" value v-home-dir.
     2866       if v-home-dir = ?
     2867       then do:
     2868           message
     2869             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2870             skip(1)
     2871             skip "Обратитесь к администратору."
     2872           view-as alert-box error.
     2873           undo, return error .
     2874       end.
     2875       run gbl/dir-cre.p (
     2876           input v-home-dir
     2877       ) no-error.
     2878       if error-status :error
     2879       then do:
     2880           message
     2881             skip "Неверно задан каталог экспорта."
     2882             skip(1)
     2883             skip "Обратитесь к администратору."
     2884           view-as alert-box error.
     2885           undo, return error .
     2886       end.
     2887       run bge/genfname.p (
     2888             input v-home-dir
     2889           , input p-prefix
     2890           , input ""
     2891           , input "xml"
     2892           , input "tmp"
     2893           , output p-xml-file-name
     2894       ).
     2895       assign
     2896           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2897           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2898           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2899       .
     2900   end.
     2901   end procedure.
     2902   procedure bgelib-read-config :
     2903   do
     2904   on error undo, return error
     2905   :
     2906   define variable v-par-type as character     no-undo.
     2907     define variable v-param-type      as character  no-undo .
     2908     define variable v-value-character as character  no-undo .
     2909     define variable v-value-date      as date       no-undo .
     2910     define variable v-value-decimal   as decimal    no-undo .
     2911     define variable v-value-integer   as integer    no-undo .
     2912     define variable v-value-logical   as logical    no-undo .
     2913     define variable v-tth             as handle     no-undo .
     2914       assign
     2915           v-bgelib-bgeclall = no
     2916           v-bgelib-bgedict  = no
     2917       .
     2918       run adm/shattri.p ( input "get":U
     2919                         , input  '':u
     2920                         , input  0
     2921                         , input  'bge-export':U
     2922                         , input  'bgeclall':U
     2923                         , output v-value-character
     2924                         , output v-value-date
     2925                         , output v-value-decimal
     2926                         , output v-value-integer
     2927                         , output v-value-logical
     2928                         , output v-param-type
     2929                         , input-output table-handle v-tth
     2930                         ) no-error .
     2931       if error-status :error
     2932       then do:
     2933         assign
     2934           v-bgelib-bgeclall = no
     2935         .
     2936       end.
     2937       else do:
     2938         assign
     2939           v-bgelib-bgeclall = v-value-logical
     2940         .
     2941       end.
     2942       delete object v-tth.
     2943       run adm/shattri.p ( input "get":U
     2944                         , input  '':u
     2945                         , input  0
     2946                         , input  'bge-export':U
     2947                         , input  'bgedict':U
     2948                         , output v-value-character
     2949                         , output v-value-date
     2950                         , output v-value-decimal
     2951                         , output v-value-integer
     2952                         , output v-value-logical
     2953                         , output v-param-type
     2954                         , input-output table-handle v-tth
     2955                         ) no-error .
     2956       if error-status :error
     2957       then do:
     2958         assign
     2959           v-bgelib-bgedict = no
     2960         .
     2961       end.
     2962       else do:
     2963         assign
     2964           v-bgelib-bgedict = v-value-logical
     2965         .
     2966       end.
     2967       delete object v-tth.
     2968       run adm/shattri.p ( input "get":U
     2969                         , input  '':u
     2970                         , input  0
     2971                         , input  'bge-export':U
     2972                         , input  'bgefmt':U
     2973                         , output v-value-character
     2974                         , output v-value-date
     2975                         , output v-value-decimal
     2976                         , output v-value-integer
     2977                         , output v-value-logical
     2978                         , output v-param-type
     2979                         , input-output table-handle v-tth
     2980                         ) no-error .
     2981       if error-status :error
     2982       then do:
     2983         assign
     2984           v-bgelib-bgefmt  = "xml":U
     2985         .
     2986       end.
     2987       else do:
     2988         assign
     2989           v-bgelib-bgefmt  = v-value-character
     2990         .
     2991       end.
     2992       delete object v-tth.
     2993       run adm/shattri.p ( input "get":U
     2994                         , input  '':u
     2995                         , input  0
     2996                         , input  'bge-export':U
     2997                         , input  'bgeflold':U
     2998                         , output v-value-character
     2999                         , output v-value-date
     3000                         , output v-value-decimal
     3001                         , output v-value-integer
     3002                         , output v-value-logical
     3003                         , output v-param-type
     3004                         , input-output table-handle v-tth
     3005                         ) no-error .
     3006       if error-status :error
     3007       then do:
     3008         assign
     3009           v-bgelib-bgeflold  = "old":U
     3010         .
     3011       end.
     3012       else do:
     3013         assign
     3014           v-bgelib-bgeflold  = v-value-character
     3015         .
     3016       end.
     3017       delete object v-tth.
     3018   end.
     3019   end procedure.
     3020   procedure bgelib-check-file-size :
     3021   do
     3022   on error undo, return error
     3023   :
     3024   define input parameter p-out-filename   as character    no-undo.
     3025   define output parameter p-is-big        as logical      no-undo.
     3026       define variable v-current-position    as integer        no-undo.
     3027       assign
     3028           v-current-position = seek( stmXMLOut )
     3029       .
     3030       if v-current-position / 1024 / 1024  >= 100
     3031       then do:
     3032           assign
     3033               p-is-big = yes
     3034           .
     3035       end.
     3036   end.
     3037   end procedure.
     3038   procedure bgelib-init-ext-doc-type :
     3039       define variable v-counter    as integer      no-undo.
     3040       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3041   do
     3042   for buf_temp_ext-doc-type
     3043   on error undo, return error
     3044   :
     3045       empty temp-table buf_temp_ext-doc-type.
     3046       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3047       :
     3048           create buf_temp_ext-doc-type.
     3049           assign
     3050               buf_temp_ext-doc-type.edt-key               = v-counter
     3051               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3052               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3053           .
     3054       end.
     3055   end.
     3056   end procedure.
     3057   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3058   define variable v-xml-file-name     as character            no-undo.
     3059   define variable v-xml-file-name-path as character            no-undo.
     3060   define variable v-log-file-name     as character            no-undo.
     3061   define variable v-locked            as logical              no-undo.
     3062   define variable v-log-string        as character            no-undo.
     3063   define variable v-oper-num          as integer              no-undo.
     3064   define variable v-obj-list          as character            no-undo.
     3065   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3066   DEF VAR intRep      AS INT NO-UNDO.
     3067   define variable hEDT             AS HANDLE NO-UNDO.
     3068   define variable hCNT             AS HANDLE NO-UNDO.
     3069   procedure xml-cd-write-header:
     3070   do
     3071   on error undo, return error
     3072   :
     3073   define input parameter p-xml-file-name       as character    no-undo.
     3074   define input parameter p-xml-file-name-path  as character    no-undo.
     3075   define input parameter p-doc-name            as character    no-undo.
     3076   define input parameter p-version             as character    no-undo.
     3077   define input parameter p-obj-list            as character    no-undo.
     3078   define input parameter p-correspondent       as character    no-undo .
     3079   define input parameter p-write-header        as logical      no-undo .
     3080   define variable OS-time as character no-undo .
     3081   define variable id as character no-undo .
     3082   define buffer buf_db for ub.db.
     3083   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3084   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3085   assign
     3086   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3087   .
     3088   run bgelib-tag-open in this-procedure (
     3089                                        1
     3090                                       ,p-doc-name
     3091                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3092                                         ).
     3093   if p-write-header then do:
     3094     run bgelib-tag-open(2, "Header","").
     3095     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3096     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3097     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3098     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3099     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3100     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3101     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3102     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3103     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3104     run bgelib-tag-close( 2, "Header" ).
     3105   end.
     3106   output stream stmXMLOut close.
     3107   end.
     3108   end procedure.
     3109   procedure xml-cd-write-footer:
     3110   do
     3111   on error undo, return error
     3112   :
     3113   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3114   define input parameter p-xml-file-name as character    no-undo.
     3115   define input parameter p-doc-name      as character    no-undo .
     3116   define variable v-error-num     as integer           no-undo.
     3117   define variable v-md5-signature as character no-undo .
     3118   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3119   run bgelib-tag-close( 0, p-doc-name ).
     3120   put stream stmXMLOut unformatted skip.
     3121   output stream stmXMLOut close.
     3122   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3123   if v-error-num > 0
     3124   then do:
     3125      return error.
     3126   end.
     3127   if opsys = "unix"
     3128   then do:
     3129       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3130   end.
     3131   end.
     3132   end procedure.
     3133   procedure xml-cd-filename :
     3134   do
     3135   on error undo, return error
     3136   :
     3137   define input parameter  p-out               as character no-undo .
     3138   define output parameter p-xml-file-name     as character    no-undo.
     3139   define output parameter p-xml-file-name-path   as character    no-undo.
     3140   define output parameter p-log-file-name     as character    no-undo.
     3141   define output parameter p-locked            as logical      no-undo.
     3142   define variable v-out as character     no-undo.
     3143   define variable loc#log as logical no-undo .
     3144   define variable BadFlag as logical no-undo .
     3145   define variable fq as integer no-undo .
     3146   define variable v-remote as character no-undo .
     3147   assign
     3148   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3149   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3150   p-log-file-name = p-out + "actions.log"
     3151   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3152   .
     3153   end.
     3154   end procedure.
     3155   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3156   define variable v-date-str as character no-undo .
     3157   assign
     3158   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3159                string(Month(p-date), "99":U) + "-":U +
     3160                string(DAY(p-date), "99":U).
     3161   return v-date-str.
     3162   END FUNCTION.
     3163   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3164   define variable v-date-str as character no-undo .
     3165   assign
     3166   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3167                string(Month(p-date), "99":U) + "-":U +
     3168                string(DAY(p-date), "99":U) + chr(32) +
     3169                string(p-time, "HH:MM:SS").
     3170   return v-date-str.
     3171   END FUNCTION.
     3172   function string-to-date returns date ( input p-string  as character):
     3173     define variable v-date as date no-undo .
     3174     assign
     3175     v-date = date(integer(substring(p-string, 4, 2))
     3176                   ,integer(substring(p-string, 1, 2))
     3177                   ,integer(substring(p-string, 7, 4))
     3178                  ) no-error .
     3179     if error-status:error then return ?.
     3180     return v-date.
     3181   END FUNCTION.
     3182   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3183   define variable v-time as integer no-undo init ?.
     3184   define variable v-dop1 as character no-undo .
     3185   define variable v-dop2 as character no-undo .
     3186   assign
     3187   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3188   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3189   no-error .
     3190   if error-status:error then return ?.
     3191   assign
     3192   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3193             integer(entry(2, v-dop2, ";":U)) * 60 +
     3194             integer(entry(3, v-dop2, ";":U)) no-error .
     3195   return v-time.
     3196   END FUNCTION.
     3197   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3198   procedure gdcstcod_cst-code :
     3199     define input  parameter p-obj-type  as character no-undo .
     3200     define input  parameter p-obj-code  as integer   no-undo .
     3201     define input  parameter p-gds-code  as integer   no-undo .
     3202     define input  parameter p-in-code   as character no-undo .
     3203     define input  parameter p-part-code as character no-undo .
     3204     define output parameter p-cst-code  as character no-undo .
     3205     define buffer buf_goods for ub.goods .
     3206     define buffer buf_parts for ub.parts .
     3207     do
     3208     on error undo, return error return-value
     3209     :
     3210       assign
     3211         p-cst-code = ''
     3212       .
     3213       find first buf_goods no-lock
     3214         where buf_goods.gds-code = p-gds-code
     3215         no-error .
     3216       if not available buf_goods
     3217       then do:
     3218         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3219       end.
     3220       if p-in-code = ?
     3221       then do:
     3222         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3223       end.
     3224       if p-part-code = ?
     3225       then do:
     3226         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3227       end.
     3228       if p-in-code = '':u
     3229       then do:
     3230         find first buf_parts no-lock
     3231           where buf_parts.obj-type  = p-obj-type
     3232             and buf_parts.obj-code  = p-obj-code
     3233             and buf_parts.artic     = buf_goods.artic
     3234             and buf_parts.prod-type = buf_goods.prod-type
     3235             and buf_parts.prod-code = buf_goods.prod-code
     3236             and buf_parts.out-code  = 'free-zone':U
     3237             and buf_parts.status_   = false
     3238           no-error .
     3239         if available buf_parts
     3240         then do:
     3241           assign
     3242             p-cst-code = buf_parts.cst-code
     3243           .
     3244         end.
     3245       end.
     3246       else do:
     3247         find first buf_parts no-lock
     3248           where buf_parts.obj-type  = p-obj-type
     3249             and buf_parts.obj-code  = p-obj-code
     3250             and buf_parts.artic     = buf_goods.artic
     3251             and buf_parts.prod-type = buf_goods.prod-type
     3252             and buf_parts.prod-code = buf_goods.prod-code
     3253             and buf_parts.out-code  = 'free-zone':U
     3254             and buf_parts.in-code   = p-in-code
     3255             and buf_parts.part-code = p-part-code
     3256           no-error .
     3257         if available buf_parts
     3258         then do:
     3259           assign
     3260             p-cst-code = buf_parts.cst-code
     3261           .
     3262         end.
     3263       end.
     3264     end.
     3265   end procedure.
     3266   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3267   define variable fname                        as character      no-undo .
     3268   define variable out                          as character      no-undo .
     3269   define variable out2                          as character      no-undo .
     3270   DEFINE VARIABLE in_                          as character      no-undo .
     3271   DEFINE VARIABLE spl                          as character      no-undo .
     3272   DEFINE VARIABLE sav                          as character      no-undo .
     3273   DEFINE VARIABLE v-remote                     as character      no-undo .
     3274   DEFINE VARIABLE start-paket                  as logical init yes no-undo .
     3275   define variable cr as integer no-undo.
     3276   define variable Cash-OS2                    as logical        no-undo .
     3277   define variable Cash-DOS                     as logical        no-undo .
     3278   define variable BadFlag                      as logical        no-undo .
     3279   define variable os-er                        as integer        no-undo .
     3280   DEFINE VARIABLE OS2-time                     as character      no-undo .
     3281   define variable glog as logical no-undo .
     3282   define variable log-file-name                as character      no-undo init "send-cd.txt".
     3283   define variable v-view-log                   as logical        no-undo .
     3284   define variable v-stop                       as logical        no-undo .
     3285   define variable v-md5-signature              as character      no-undo .
     3286   define variable v-cd-list-update             as character no-undo .
     3287   define variable v-cd-list-delete             as character no-undo .
     3288   define variable v-param-type as character no-undo .
     3289   define variable v-value-character as character no-undo .
     3290   define variable v-value-date as date no-undo .
     3291   define variable v-value-decimal as decimal no-undo .
     3292   define variable v-value-integer as INTEGER no-undo .
     3293   define variable v-value-logical AS LOGICAL no-undo .
     3294   define variable v-tth as handle no-undo .
     3295   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3296   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3297   assign
     3298   v-tth = buffer thbjattr_thbj-attr:table-handle .
     3299   define stream   IBMStream .
     3300   define temp-table temp-cd no-undo like ub.cash-desk .
     3301   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3302   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3303   procedure alienini-getkey :
     3304   define input parameter i-filename as char.
     3305   define input parameter i-section as char.
     3306   define input parameter i-key as char.
     3307   define output parameter o-value as char.
     3308   define variable EntryPointer as integer no-undo.
     3309   define variable mem1 as memptr no-undo.
     3310   define variable mem2 as memptr no-undo.
     3311   define variable mem1size as integer no-undo.
     3312   define variable mem2size as integer no-undo.
     3313   define variable ii       as integer    no-undo.
     3314   define variable cbReturnSize  as integer    no-undo.
     3315   assign
     3316   set-size(mem1)  = 4000
     3317   mem1size = 4000.
     3318   if i-key = "" then EntryPointer = 0.
     3319   else do:
     3320     assign
     3321     set-size(mem2) = 128
     3322     mem2size = 128
     3323     EntryPointer = get-pointer-value(mem2)
     3324     put-string(mem2, 1) = i-key.
     3325   end.
     3326   run getprivateprofilestringA
     3327                                 (i-section,
     3328                                  EntryPointer,
     3329                                  "",
     3330                                  get-pointer-value(mem1),
     3331                                  input mem1size,
     3332                                  i-filename,
     3333                                  output cbReturnSize).
     3334   do ii = 1 to cbReturnSize:
     3335     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3336                  then o-value + ","
     3337                  else o-value + chr(get-byte(mem1, ii)).
     3338   end.
     3339     set-size(mem1) = 0.
     3340     set-size(mem2) = 0.
     3341   end procedure.
     3342   procedure alienini-putkey :
     3343   define input parameter i-filename as char.
     3344   define input parameter i-section as char.
     3345   define input parameter i-key as char.
     3346   define input parameter i-value as char.
     3347   define variable cbReturnSize as integer.
     3348   run writeprivateprofilestringA
     3349                                  (i-section,
     3350                                   i-key,
     3351                                   i-value,
     3352                                   i-filename,
     3353                                   output cbReturnSize ).
     3354   end procedure.
     3355   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3356     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3357     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3358     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3359     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3360     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3361     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3362     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3363   END PROCEDURE.
     3364   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3365     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3366     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3367     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3368     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3369     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3370   END PROCEDURE.
     3371   define   temp-table temp-tekka-tsk no-undo
     3372   field filename      as character
     3373   field obj-num       as integer
     3374   field obj-name      as character
     3375   field num-records   as integer
     3376   field max-records   as integer
     3377   field min-plu       as integer
     3378   field max-plu       as integer
     3379   field num-fields    as integer
     3380   field task-num      as character
     3381   field by-record     as logical
     3382   field send-get      as character
     3383   field cash-num      as integer
     3384   field cash-num-char as character
     3385   field port-num      as character
     3386   field way           as character
     3387   field is-script     as logical
     3388   field pswd          as character
     3389   field waiting-sek   as integer
     3390   field other-info    as character
     3391   field order-num     as integer
     3392   field secondary     as integer
     3393   field shift-fields  as integer
     3394   field binary        as logical
     3395   field range         as integer
     3396   index pi is unique primary
     3397   filename
     3398   range
     3399   index lpi
     3400   filename
     3401   min-plu
     3402   index gpi
     3403   filename
     3404   max-plu
     3405   index iorder
     3406   order-num
     3407   .
     3408   define   temp-table temp-tekka-schema no-undo
     3409   field obj-num as integer
     3410   field obj-name as character
     3411   field field-num as integer
     3412   field field-name as character
     3413   field num-records as integer
     3414   field size_ as integer
     3415   field host as character
     3416   field progress-type as character
     3417   field custom-type as character
     3418   field start-pos as integer
     3419   field end-pos as integer
     3420   field bin-group as character
     3421   index pi is unique primary
     3422   host obj-num field-num
     3423   .
     3424   define temp-table temp-tekka-record no-undo
     3425   field obj-num as integer
     3426   field plu as integer
     3427   field body as character
     3428   field shift as integer
     3429   index pi is unique primary obj-num plu.
     3430   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3431   define variable v-is-closed-shift-journal as integer no-undo .
     3432   assign
     3433   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3434                               +
     3435                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3436                               +
     3437                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3438   .
     3439   return v-is-closed-shift-journal.
     3440   END FUNCTION.
     3441   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3442   define variable v-is-first-journal as logical no-undo .
     3443   assign
     3444   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3445                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3446                     or (p-journal-num =  integer(entry(1, '17':U)))
     3447                     or (p-journal-num = integer(entry(1, '16':U)))
     3448   .
     3449   return v-is-first-journal.
     3450   END FUNCTION.
     3451   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3452   define variable v-is-petrol-journal as logical no-undo .
     3453   assign
     3454   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3455   return v-is-petrol-journal.
     3456   END FUNCTION.
     3457   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3458   define variable v-max-record-num as integer no-undo .
     3459   assign
     3460   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3461                       then 1489
     3462                       else 2340).
     3463   return v-max-record-num.
     3464   END FUNCTION.
     3465   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3466   define variable v-max-record-num as integer no-undo .
     3467   assign
     3468   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3469                       then 1489 * num-entries('30,31,32,33':U)
     3470                       else 2340 * num-entries('17':U)).
     3471   return v-max-record-num.
     3472   END FUNCTION.
     3473   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3474                                           ,input p-rec-no as integer):
     3475   define variable v-num-recs as integer no-undo .
     3476   if tekka-is-petrol-journal (p-journal-num) then do:
     3477     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3478       assign
     3479       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3480       .
     3481     end.
     3482     else do:
     3483       assign
     3484       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3485       .
     3486     end.
     3487   end.
     3488   else do:
     3489     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3490       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3491         assign
     3492         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3493         .
     3494       end.
     3495       else do:
     3496         assign
     3497         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3498         .
     3499       end.
     3500     end.
     3501     else do:
     3502       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3503         assign
     3504         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3505         .
     3506       end.
     3507       else do:
     3508         assign
     3509         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3510         .
     3511       end.
     3512     end.
     3513   end.
     3514   return v-num-recs.
     3515   END FUNCTION.
     3516   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3517                                              ,input p-is-petrol as logical
     3518                                              ,input p-is-current as logical
     3519                                              ,output p-rec-no as decimal
     3520                                              ):
     3521   define variable v-obj-num0 as integer no-undo .
     3522   define variable v-obj-num as integer no-undo .
     3523   define variable v-obj-num2 as integer no-undo .
     3524   define variable p-num-recs2 as integer no-undo .
     3525   define variable p-rec-no2 as integer no-undo .
     3526   if p-is-petrol then do:
     3527     assign
     3528     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3529     .
     3530     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3531     then
     3532     assign
     3533     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3534     p-rec-no = p-num-recs modulo 1489
     3535     .
     3536     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3537     then
     3538     assign
     3539     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3540     p-rec-no = p-num-recs modulo 1489
     3541     .
     3542   end.
     3543   else do:
     3544     assign
     3545     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3546     p-num-recs = trunc(p-num-recs, 0)
     3547     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3548     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3549     .
     3550     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3551     then
     3552     assign
     3553     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3554     p-rec-no = p-num-recs modulo 2340
     3555     .
     3556     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3557     then
     3558     assign
     3559     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3560     p-rec-no = p-num-recs modulo 2340
     3561     .
     3562     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3563     then
     3564     assign
     3565     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3566     p-rec-no2 = p-num-recs2 modulo 2978
     3567     .
     3568     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3569     then
     3570     assign
     3571     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3572     p-rec-no2 = p-num-recs2 modulo 2978
     3573     .
     3574     assign
     3575     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3576     .
     3577   end.
     3578   if v-obj-num = 0 then v-obj-num = 100.
     3579   return v-obj-num.
     3580   END FUNCTION.
     3581   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3582   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3583   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3584      if p-is-ptrl then
     3585      return integer(entry(1, '26,27,28,29':U)).
     3586      if not p-is-ptrl then
     3587      return integer(entry(1, '16':U)).
     3588   end.
     3589   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3590   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3591   return 0.
     3592   END FUNCTION.
     3593   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3594   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3595   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3596     if p-is-ptrl then
     3597     return integer(entry(1, '26,27,28,29':U)).
     3598     if not p-is-ptrl then
     3599     return integer(entry(1, '16':U)).
     3600   end.
     3601   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3602   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3603   return 0.
     3604   END FUNCTION.
     3605   PROCEDURE maria-put:
     3606   define parameter buffer buf_cash-desk for ub.cash-desk.
     3607   define input parameter p-out    as character no-undo .
     3608   define input parameter p-fname as character no-undo .
     3609   define input parameter p-by-record as logical no-undo .
     3610   define input parameter p-shift-fields as integer no-undo .
     3611   define input parameter p-binary as logical no-undo .
     3612   define input parameter p-obj-num as integer no-undo .
     3613   define input parameter p-max-records as integer no-undo .
     3614   define input parameter p-plu as integer no-undo .
     3615   define input parameter p-value as character no-undo .
     3616   define variable v-file-name as character no-undo .
     3617   define variable v-create as logical no-undo .
     3618   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3619   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3620   output stream IBMSTREAM
     3621   to value(v-file-name) append .
     3622   Put  stream IBMSTREAM unformatted
     3623   p-plu
     3624   chr(3)
     3625   p-value
     3626   skip.
     3627   output stream IBMSTREAM
     3628   close.
     3629   if not p-by-record then do:
     3630     find first buf_temp-tekka-tsk where
     3631               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3632     if not available buf_temp-tekka-tsk then do:
     3633       v-create = yes.
     3634     end.
     3635   end.
     3636   else do:
     3637     find first buf_temp-tekka-tsk where
     3638               buf_temp-tekka-tsk.filename  = v-file-name
     3639           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3640     if not available buf_temp-tekka-tsk
     3641     then do:
     3642       find first buf_temp-tekka-tsk where
     3643                 buf_temp-tekka-tsk.filename  = v-file-name
     3644             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3645       if not available buf_temp-tekka-tsk
     3646       then do:
     3647         v-create = yes.
     3648       end.
     3649     end.
     3650   end.
     3651   if v-create then do:
     3652     create buf_temp-tekka-tsk.
     3653     assign
     3654     buf_temp-tekka-tsk.filename = v-file-name
     3655     buf_temp-tekka-tsk.range    = p-plu
     3656     buf_temp-tekka-tsk.obj-num = p-obj-num
     3657     buf_temp-tekka-tsk.obj-name = '':U
     3658     buf_temp-tekka-tsk.num-records = 0
     3659     buf_temp-tekka-tsk.max-records = p-max-records
     3660     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3661     buf_temp-tekka-tsk.task-num = p-fname
     3662     buf_temp-tekka-tsk.by-record = p-by-record
     3663     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3664     buf_temp-tekka-tsk.binary = p-binary
     3665     buf_temp-tekka-tsk.send-get = 'send'
     3666     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3667     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3668     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3669     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3670                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3671                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3672                                 then 'local'
     3673                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3674     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3675     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3676     buf_temp-tekka-tsk.waiting-sek = 30
     3677     buf_temp-tekka-tsk.min-plu     = p-plu
     3678     buf_temp-tekka-tsk.max-plu     = p-plu
     3679     .
     3680   end.
     3681   assign
     3682   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3683   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3684   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3685   .
     3686   END PROCEDURE.
     3687   PROCEDURE maria-get:
     3688   define parameter buffer buf_cash-desk for ub.cash-desk.
     3689   define input parameter p-out    as character no-undo .
     3690   define input parameter p-fname as character no-undo .
     3691   define input parameter p-by-record as logical no-undo .
     3692   define input parameter p-obj-num as integer no-undo .
     3693   define input parameter p-num-fields as integer no-undo .
     3694   define input parameter p-max-records as integer no-undo .
     3695   define input parameter p-min-plu as integer no-undo .
     3696   define input parameter p-max-plu as integer no-undo .
     3697   define input parameter p-other as character no-undo .
     3698   define input parameter p-order-num as integer no-undo .
     3699   define variable v-file-name as character no-undo .
     3700   define variable v-secondary-obj-num as character no-undo .
     3701   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3702   if p-by-record then do:
     3703     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3704   end.
     3705   else do:
     3706     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3707   end.
     3708   find first buf_temp-tekka-tsk where
     3709             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3710   if not available buf_temp-tekka-tsk then do:
     3711     create buf_temp-tekka-tsk.
     3712     assign
     3713     buf_temp-tekka-tsk.filename = v-file-name
     3714     buf_temp-tekka-tsk.obj-num = p-obj-num
     3715     buf_temp-tekka-tsk.obj-name = '':U
     3716     buf_temp-tekka-tsk.max-records = p-max-records
     3717     buf_temp-tekka-tsk.num-fields = p-num-fields
     3718     buf_temp-tekka-tsk.task-num = p-fname
     3719     buf_temp-tekka-tsk.by-record = p-by-record
     3720     buf_temp-tekka-tsk.send-get = 'get'
     3721     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3722     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3723     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3724     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3725                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3726                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3727                                   then 'local'
     3728                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3729     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3730     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3731     buf_temp-tekka-tsk.waiting-sek = 30
     3732     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3733     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3734     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3735                                       and p-max-plu <> ?
     3736                                       then p-max-plu - p-min-plu + 1
     3737                                       else 0)
     3738     buf_temp-tekka-tsk.other-info = p-other
     3739     buf_temp-tekka-tsk.order-num = p-order-num
     3740     .
     3741     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3742       assign
     3743       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3744       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3745       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3746       no-error
     3747       .
     3748       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3749     end.
     3750   end.
     3751   END PROCEDURE.
     3752   PROCEDURE maria-task:
     3753   define parameter buffer buf_cash-desk for ub.cash-desk.
     3754   define input parameter p-fname as character no-undo .
     3755   define input parameter p-obj-num-list as character no-undo .
     3756   define input parameter p-parameters as character no-undo .
     3757   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3758   find first buf_temp-tekka-tsk where
     3759             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3760   if not available buf_temp-tekka-tsk then do:
     3761     create buf_temp-tekka-tsk.
     3762     assign
     3763     buf_temp-tekka-tsk.filename = ''
     3764     buf_temp-tekka-tsk.range = 1
     3765     buf_temp-tekka-tsk.obj-num = 0
     3766     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3767     buf_temp-tekka-tsk.task-num = p-fname
     3768     buf_temp-tekka-tsk.by-record = no
     3769     buf_temp-tekka-tsk.send-get = 'task'
     3770     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3771     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3772     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3773     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3774                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3775                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3776                                   then 'local'
     3777                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3778     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3779     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3780     buf_temp-tekka-tsk.waiting-sek = 30
     3781     buf_temp-tekka-tsk.other-info = p-parameters
     3782     buf_temp-tekka-tsk.order-num = 0
     3783     .
     3784   end.
     3785   END PROCEDURE.
     3786   procedure tekkatsk-verify-schema :
     3787   define input parameter p-obj-list as character no-undo .
     3788   define input parameter p-dir-path as character no-undo .
     3789   define variable v-obj-num as integer no-undo .
     3790   define variable v-obj-name as character no-undo .
     3791   define variable v-num-records as integer no-undo .
     3792   define variable v-size_ as integer no-undo .
     3793   define variable v-value as character no-undo .
     3794   define variable ii as integer no-undo .
     3795   define variable jj as integer no-undo .
     3796   define variable ii-ibs as integer no-undo .
     3797   define variable ii-tekka as integer no-undo .
     3798   define variable v-result as character no-undo .
     3799   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3800   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3801     do
     3802     on error undo, return error
     3803     :
     3804        for each buf_temp-tekka-schema:
     3805          delete buf_temp-tekka-schema.
     3806        end.
     3807        input from value('tekkasch.d').
     3808        repeat :
     3809          create buf_temp-tekka-schema.
     3810          import buf_temp-tekka-schema.
     3811          assign
     3812          buf_temp-tekka-schema.host = 'IBS'
     3813          ii = ii + 1.
     3814          .
     3815        end.
     3816        input close.
     3817        ii-ibs = ii.
     3818         _ii:
     3819         do ii = 1 to 256:
     3820           if p-obj-list = "ALL"
     3821           or lookup(string(ii), p-obj-list) > 0 then do:
     3822             assign
     3823             v-obj-num = 0
     3824             v-obj-name = ''
     3825             v-num-records = 0
     3826             v-size_ = 0
     3827             .
     3828             run alienini-getkey in this-procedure (
     3829                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3830                                                     ,input ('obj' + string(ii, '999'))
     3831                                                     ,input 'oname'
     3832                                                     ,output v-value) no-error .
     3833             if v-value = ? then next _ii.
     3834             assign
     3835             v-obj-num = ii
     3836             v-obj-name = v-value
     3837             .
     3838             run alienini-getkey in this-procedure (
     3839                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3840                                                     ,input ('obj' + string(ii, '999'))
     3841                                                     ,input 'size'
     3842                                                     ,output v-value) no-error .
     3843             assign
     3844             v-num-records = integer(v-value) no-error  .
     3845             if error-status:error
     3846             or v-num-records = 0 then next _ii.
     3847             run alienini-getkey in this-procedure (
     3848                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3849                                                     ,input 'obj' + string(ii, '999')
     3850                                                     ,input 'f000'
     3851                                                     ,output v-value) no-error .
     3852             assign
     3853             v-size_ = integer(v-value) no-error  .
     3854             if error-status:error
     3855             or v-size_ = 0 then next _ii.
     3856             _jj:
     3857             do jj = 1 to 256:
     3858               run alienini-getkey in this-procedure (
     3859                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3860                                                       ,input 'obj' + string(ii, '999')
     3861                                                       ,input 'f' + string(jj, '999')
     3862                                                       ,output v-value) no-error .
     3863               if v-value = ? then next _ii.
     3864               create buf_temp-tekka-schema.
     3865               assign
     3866               buf_temp-tekka-schema.host = 'tekka'
     3867               buf_temp-tekka-schema.obj-num = v-obj-num
     3868               buf_temp-tekka-schema.obj-name = v-obj-name
     3869               buf_temp-tekka-schema.num-records = v-num-records
     3870               buf_temp-tekka-schema.size_ = v-size_
     3871               buf_temp-tekka-schema.field-num = jj
     3872               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3873               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3874                                                  then entry(2, entry(2, v-value, '#'), ':')
     3875                                                  else '':U)
     3876               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3877               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3878               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3879                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3880               no-error
     3881               .
     3882               if error-status:error then do:
     3883                 delete buf_temp-tekka-schema.
     3884                 next _jj.
     3885               end.
     3886               run alienini-getkey in this-procedure (
     3887                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3888                                                       ,input 'obj' + string(ii, '999') + 'name'
     3889                                                       ,input 'n' + string(jj, '999')
     3890                                                       ,output v-value) no-error .
     3891               if v-value <> ? then
     3892               buf_temp-tekka-schema.field-name = v-value.
     3893             end.
     3894           end.
     3895         end.
     3896         ii-tekka = ii - 1.
     3897        if p-obj-list <> 'ALL' then do:
     3898         if ii-tekka <> ii-ibs then do:
     3899           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3900                                   , ii-ibs
     3901                                   , ii-tekka).
     3902         end.
     3903        end.
     3904        for each buf_temp-tekka-schema where
     3905               buf_temp-tekka-schema.host = 'tekka':
     3906          find first buf2_temp-tekka-schema where
     3907                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3908                AND buf2_temp-tekka-schema.host = 'ibs'
     3909                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3910          if not available buf2_temp-tekka-schema then do:
     3911           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3912                                   , buf_temp-tekka-schema.field-num
     3913                                   , buf_temp-tekka-schema.obj-num).
     3914          end.
     3915          buffer-compare buf_temp-tekka-schema
     3916          to buf2_temp-tekka-schema
     3917          save result in v-result.
     3918          if v-result <> '':U then do:
     3919           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3920                                   , buf_temp-tekka-schema.field-num
     3921                                   , buf_temp-tekka-schema.obj-num).
     3922          end.
     3923        end.
     3924     end.
     3925   end procedure.
     3926   FUNCTION set-Sx returns character (input p-string as character):
     3927   return p-string.
     3928   END FUNCTION.
     3929   FUNCTION get-Sx returns character (input p-string  as character):
     3930   return p-string.
     3931   END FUNCTION.
     3932   FUNCTION set-B returns character (input p-string  as character):
     3933   return chr(integer(p-string)).
     3934   END FUNCTION.
     3935   FUNCTION get-B returns character (input p-string  as character):
     3936   return string(asc(p-string)).
     3937   END FUNCTION.
     3938   FUNCTION set-BF returns character (input p-string  as character):
     3939   define variable v-dopi as integer no-undo .
     3940   define variable ii as integer no-undo .
     3941   do ii = 1 to 8:
     3942     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3943   end.
     3944   return chr(v-dopi).
     3945   END FUNCTION.
     3946   FUNCTION get-BF returns character (input p-string  as character):
     3947   define variable v-dopi as integer no-undo .
     3948   define variable v-dops as character no-undo .
     3949   define variable ii as integer no-undo .
     3950   v-dopi = asc(p-string).
     3951   do ii = 8 to 1 BY -1:
     3952     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3953   end.
     3954   return v-dops.
     3955   END FUNCTION.
     3956   FUNCTION set-BN returns character (input p-string  as character
     3957                                     ,input p-bin-group as character):
     3958   define variable v-dopi as integer no-undo .
     3959   define variable ii as integer no-undo .
     3960   define variable jj as integer no-undo .
     3961   define variable v-grp-nums as integer no-undo .
     3962   define variable v-dopi2 as integer no-undo .
     3963   v-grp-nums = num-entries(p-bin-group).
     3964   do jj = 0 to v-grp-nums - 1:
     3965     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3966     do ii = 1 to 8:
     3967       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3968     end.
     3969   end.
     3970   return chr(v-dopi).
     3971   END FUNCTION.
     3972   FUNCTION get-BN returns character (input p-string  as character
     3973                                     ,input p-bin-group as character):
     3974   define variable v-dopi as integer no-undo .
     3975   define variable v-dops as character no-undo .
     3976   define variable v-grp-nums as integer no-undo .
     3977   define variable ii as integer no-undo .
     3978   define variable jj as integer no-undo .
     3979   v-dopi = asc(p-string).
     3980   v-grp-nums = num-entries(p-bin-group).
     3981   do jj = 1 to v-grp-nums:
     3982   do ii = 8 to 1 BY -1:
     3983     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3984   end.
     3985   end.
     3986   return v-dops.
     3987   END FUNCTION.
     3988   procedure fill-temp-cd :
     3989   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3990   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3991   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3992   define input parameter p-clear-table as logical no-undo .
     3993   define buffer buf_temp-cd for temp-cd.
     3994   define buffer buf_cash-desk for ub.cash-desk.
     3995     do
     3996     on error undo, return error
     3997     :
     3998        if p-clear-table  then do:
     3999          for each buf_temp-cd:
     4000            delete buf_temp-cd.
     4001          end.
     4002        end.
     4003        for each buf_cash-desk no-lock where
     4004               buf_cash-desk.db-num = p-db-num
     4005           AND buf_cash-desk.obj-code = p-obj-code
     4006           and buf_cash-desk.cash-on  = yes
     4007        BREAK by buf_cash-desk.pos-type:
     4008          if first-of(buf_cash-desk.pos-type) then do:
     4009            create buf_temp-cd.
     4010            buffer-copy buf_cash-desk to buf_temp-cd.
     4011          end.
     4012        end.
     4013     end.
     4014   end procedure.
     4015   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4016   FUNCTION name-2cdf returns character
     4017                      (  input p-name-2cd as character
     4018                       , input p-mode as logical
     4019                       , input p-cod-pcod as logical
     4020                       , input p-b-code  as integer
     4021                       , input p-gds-code as integer
     4022                       , input p-artic   as character
     4023                       , input p-engl-name  as character
     4024                       , input p-in-code as character
     4025                       , input p-part-code as character
     4026                       , input p-obj-type as character
     4027                       , input p-obj-code as integer
     4028                       , input p-alpha1 as character
     4029                       , output p-gtd as character
     4030                       ) :
     4031   define variable v-name-2cd as character no-undo .
     4032   define variable v-dop-alt-name as character no-undo.
     4033   define variable v-type as character no-undo.
     4034   define buffer buf_parts for ub.parts.
     4035   define buffer buf_code for ub.code.
     4036   if not p-mode and p-name-2cd = "PLU":U then do:
     4037     return "PLU кассы":U.
     4038   end.
     4039   if not p-mode then do:
     4040     if p-name-2cd <> "GTD":U
     4041     and  p-name-2cd <> "alpha1|gtd":U
     4042     then do:
     4043     assign
     4044     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4045   end.
     4046   end.
     4047   if p-part-code = "":U or p-cod-pcod = no then do:
     4048     run gdsoattr-value in this-procedure (
     4049       'dt-seasons':U,
     4050       p-gds-code,
     4051       p-obj-type,
     4052       p-obj-code,
     4053       output v-dop-alt-name,
     4054       output v-type
     4055     ) no-error.
     4056     if v-dop-alt-name <> "" then do:
     4057       find first buf_code where
     4058                  buf_code.parent = "DTSeasons"
     4059              and buf_code.code   = v-dop-alt-name
     4060            no-lock no-error.
     4061       if available buf_code then
     4062         assign
     4063           p-engl-name = ""
     4064           v-dop-alt-name =  buf_code.misc1
     4065         .
     4066     end.
     4067     else do:
     4068       run gdsoattr-value in this-procedure
     4069                           ( input  'dop-alt-name-o':U
     4070                            ,input  p-gds-code
     4071                            ,input  p-obj-type
     4072                            ,input  p-obj-code
     4073                            ,output v-dop-alt-name
     4074                            ,output v-type
     4075                           ) no-error .
     4076     end.
     4077     CASE p-name-2cd:
     4078       when "name" then do:
     4079         if p-mode then return p-engl-name + v-dop-alt-name.
     4080         return "Англ. название".
     4081       end.
     4082       when "code":U then do:
     4083         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4084         return "Лок. код товара"  .
     4085       end.
     4086       when "GTD":U
     4087       or
     4088       when "name-GTD":U
     4089       or
     4090       when "code-GTD":U
     4091       or
     4092       when "alpha1|gtd":U
     4093       or
     4094       when "name-alpha1|gtd":U
     4095       or
     4096       when "code-alpha1|gtd":U
     4097       then do:
     4098         if p-mode then do:
     4099           run gdcstcod_cst-code  in this-procedure (
     4100                                                       input  p-obj-type
     4101                                                       ,input  p-obj-code
     4102                                                       ,input  p-gds-code
     4103                                                       ,input  p-in-code
     4104                                                       ,input  p-part-code
     4105                                                       ,output p-gtd
     4106                                                       ) no-error .
     4107         end.
     4108         if p-name-2cd = "name-gtd":U then do:
     4109           if p-mode then return p-engl-name  + v-dop-alt-name.
     4110           return "Англ. название".
     4111         end.
     4112         if p-name-2cd = "name-alpha1|gtd":U then do:
     4113           if p-mode then return p-engl-name  + v-dop-alt-name.
     4114           return "Англ. название".
     4115         end.
     4116         if p-name-2cd = "code-GTD":U then do:
     4117           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4118           return "Лок. код товара"  .
     4119         end.
     4120         if p-name-2cd = "code-alpha1|gtd":U then do:
     4121           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4122           return "Лок. код товара"  .
     4123         end.
     4124         if p-mode then do:
     4125           if p-name-2cd = "GTD" then  return p-gtd.
     4126           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4127         end.
     4128         if p-name-2cd = "GTD" then  return "Код ГТД".
     4129         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4130       end.
     4131     END CASE.
     4132   end.
     4133   else do:
     4134     if p-name-2cd = "name-gtd":U
     4135     or p-name-2cd = "code-GTD":U
     4136     or p-name-2cd = "name-alpha1|GTD":U
     4137     or p-name-2cd = "code-alpha1|GTD":U
     4138     or p-name-2cd = "alpha1|GTD":U
     4139     then do:
     4140       if p-mode then do:
     4141         run gdcstcod_cst-code  in this-procedure (
     4142                                                      input  p-obj-type
     4143                                                     ,input  p-obj-code
     4144                                                     ,input  p-gds-code
     4145                                                     ,input  p-in-code
     4146                                                     ,input  p-part-code
     4147                                                     ,output p-gtd
     4148                                                     ) no-error .
     4149       end.
     4150       else do:
     4151         if p-name-2cd = "gtd":U then
     4152         p-gtd = "Код ГТД".
     4153         if p-name-2cd = "alpha1|Gtd":U then
     4154         p-gtd = "Страна|Код ГТД".
     4155       end.
     4156     end.
     4157     if p-mode then  return p-part-code.
     4158     return "Код партии".
     4159   end.
     4160   END FUNCTION.
     4161   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4162                                            ,input p-nam-2str as logical
     4163                                            ,input p-nam-artc as logical
     4164                                            ,input p-unit-cli-type as character
     4165                                            ,input p-unit-base as character
     4166                                            ,input p-unit-cli as character
     4167                                            ,input p-cli-base-rate as decimal
     4168                                            ,input p-artic as character
     4169                                            ,input p-f-name as character
     4170                                            ,input p-gds-name as character
     4171                                            ,input p-gds-name1 as character
     4172                                            ,output p-second-name as character):
     4173   define variable v-length as integer no-undo .
     4174   define variable nam-2str-shift as integer no-undo .
     4175   define variable chk_name as character no-undo .
     4176   assign
     4177   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4178   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4179   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4180               then 5
     4181               else v-length)
     4182   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4183   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4184   .
     4185   if p-nam-artc then do:
     4186     assign
     4187     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4188       .
     4189   end.
     4190   else  do:
     4191     assign
     4192     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4193     .
     4194   end.
     4195   if p-unit-base <> p-unit-cli then do:
     4196     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4197     assign
     4198     chk_name = string(substr(chk_name
     4199                               ,1
     4200                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4201                       "*":U +
     4202                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4203   end.
     4204   else do:
     4205     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4206   end.
     4207   if p-nam-2str then do:
     4208     assign
     4209     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4210     chk_name = substr(chk_name, 1, v-length)
     4211     .
     4212   end.
     4213   else do:
     4214     assign
     4215     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4216     p-second-name =   (chr(34) +
     4217                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4218                       + chr(34) )
     4219     .
     4220   end.
     4221   return chk_name.
     4222   end function.
     4223   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4224   procedure disrules-get-interface-form :
     4225   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4226   define output parameter p-form-name as character no-undo .
     4227   define buffer buf_temp-drt-prop for temp-drt-prop.
     4228   define buffer buf_drt-prop for ub.drt-prop.
     4229   find first buf_temp-drt-prop where
     4230             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4231         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4232         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4233   if not available buf_temp-drt-prop then do:
     4234     find first buf_drt-prop where
     4235               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4236           and buf_drt-prop.upper-prop-code = "InputForm"
     4237           and buf_drt-prop.prop-code = "FormName" no-error.
     4238     if available buf_drt-prop then do:
     4239       p-form-name = buf_drt-prop.property-value.
     4240     end.
     4241     else do:
     4242       p-form-name = "ref/dis-ruli.w".
     4243     end.
     4244   end.
     4245   else do:
     4246     p-form-name = buf_temp-drt-prop.property-value.
     4247   end.
     4248   end procedure.
