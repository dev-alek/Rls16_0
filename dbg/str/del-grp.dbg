     4788   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4789   PROCEDURE cd-mrkt_plu-marketer :
     4790   define input parameter p-silence as logical no-undo .
     4791   define parameter buffer buf_cash-desk for ub.cash-desk.
     4792   define input parameter p-id as character no-undo .
     4793   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4794   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4795   define input parameter p-loc-ean as logical no-undo .
     4796   define input parameter p-is-petrolium as logical no-undo .
     4797   define input parameter p-extra as character no-undo .
     4798   define variable v-tot-gds as integer no-undo .
     4799   define variable v-max-gds as integer no-undo .
     4800   define variable v-petrol-start as integer no-undo .
     4801   define variable v-petrol-range as integer no-undo .
     4802   DEFINE VARIABLE v-today as date no-undo .
     4803   DEFINE VARIABLE v-time as integer no-undo .
     4804   define variable v-plu-type as character no-undo .
     4805   define variable v-int as integer no-undo .
     4806   define buffer  buf_cd-plu for ub.cd-plu.
     4807   define buffer  loc_cd-plu for ub.cd-plu.
     4808   define variable  ii as integer no-undo.
     4809   define variable v-mes as character no-undo .
     4810   _main:
     4811   DO ON ERROR undo, leave on stop undo, leave:
     4812     if buf_cash-desk.pos-type <> 'MARIA':U
     4813     or buf_cash-desk.cash-num <> 0 then do:
     4814       assign
     4815       v-mes =
     4816       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4817                 , buf_cash-desk.pos-type).
     4818       if not p-silence then
     4819       message
     4820       v-mes
     4821       view-as alert-box error .
     4822       return error v-mes.
     4823     end.
     4824     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4825                                     ,input 'MARIA_operative':U
     4826                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4827                                           and p-is-petrolium
     4828                                           then 'tot-petrol':U
     4829                                           else 'tot-gds':U)
     4830                                     , output v-mes).
     4831     if v-tot-gds = ? then undo _main, return error v-mes.
     4832     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4833                                     ,input 'MARIA_general':U
     4834                                     ,input 'max-gds':U
     4835                                     ,output v-mes).
     4836     if v-max-gds = ? then undo _main, return error v-mes.
     4837     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4838                                          ,input 'petrolium-range':U
     4839                                          ,input 'petrolium-range':U
     4840                                          ,output v-mes).
     4841     if v-petrol-range = ? then undo _main, return error v-mes.
     4842     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4843       assign
     4844       v-petrol-start = 1
     4845       v-max-gds = (if p-is-petrolium
     4846                    then v-petrol-range
     4847                    else v-max-gds)
     4848       v-plu-type = (if p-is-petrolium
     4849                  then 'топ':U
     4850                  else '':U)
     4851       .
     4852       if p-is-petrolium then do:
     4853         if p-id = '':U then do:
     4854           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4855                               "Невозможно привязать к кассе типа &3"
     4856                               , p-b-str
     4857                               , chr(10)
     4858                               , 'MARIA':U).
     4859           if not p-silence then
     4860           message
     4861           v-mes
     4862           view-as alert-box error .
     4863           return error v-mes.
     4864         end.
     4865         assign
     4866         v-int = integer(p-id)
     4867         no-error
     4868         .
     4869         if error-status:error
     4870         or v-int > v-petrol-range then do:
     4871           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4872                               "в диапазоны номеров резервуаров для кассы типа &4"
     4873                               , p-id
     4874                               , p-b-str
     4875                               , chr(10)
     4876                               , 'MARIA':U).
     4877           if not p-silence then
     4878           message
     4879           v-mes
     4880           view-as alert-box error .
     4881           return error v-mes.
     4882         end.
     4883       end.
     4884     end.
     4885     if buf_cash-desk.pos-type = 'MARIA':U
     4886     and p-is-petrolium then do:
     4887       find first loc_cd-plu where
     4888                loc_cd-plu.obj-type = 'маг':U
     4889            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4890            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4891            and loc_cd-plu.plu-type = 'топ':U
     4892      no-error .
     4893      if available loc_cd-plu then do:
     4894        if loc_cd-plu.b-code = p-b-code
     4895        and loc_cd-plu.b-str = p-b-str then do:
     4896           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4897                               , p-id
     4898                               , p-b-str
     4899                               , chr(10)
     4900                               ).
     4901           if not p-silence then
     4902           message
     4903           v-mes
     4904           view-as alert-box WARNING .
     4905           return v-mes.
     4906        end.
     4907        else do:
     4908           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4909                               "нельзя его привязать к топливу &2&3"
     4910                               , p-id
     4911                               , loc_cd-plu.b-str
     4912                               , chr(10)
     4913                               , p-b-str).
     4914           if not p-silence then
     4915           message
     4916           v-mes
     4917           view-as alert-box error .
     4918           return error v-mes.
     4919        end.
     4920      end.
     4921      ii = v-int.
     4922     end.
     4923     else do:
     4924       DO ii = (if p-is-petrolium
     4925               then v-petrol-start
     4926               else (if buf_cash-desk.pos-type = 'MARIA':U
     4927                    then 1
     4928                    else (if v-petrol-start = 1
     4929                           then (v-petrol-range + 1)
     4930                           else 1)
     4931                   )
     4932               )
     4933         to v-max-gds :
     4934         if not can-find (loc_cd-plu where
     4935                         loc_cd-plu.obj-type = 'маг':U
     4936                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4937                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4938                      and loc_cd-plu.plu-type = v-plu-type
     4939                      and loc_cd-plu.plu-code = ii
     4940                       )
     4941         then LEAVE .
     4942       END .
     4943     end.
     4944     if ii > v-max-gds then do:
     4945         if not p-silence then
     4946         message
     4947         substitute("Превышено максимально допустимое количество &5 &1" +
     4948                   "для касс &2 &3&4"
     4949                   , chr(10)
     4950                   , v-max-gds
     4951                   , 'маг':U
     4952                   , buf_cash-desk.obj-code
     4953                   , (if p-is-petrolium then "топлив" else "товаров")
     4954                   )
     4955         view-as alert-box ERROR .
     4956         undo, return error "max-gds":U.
     4957     end.
     4958     DO ii = (if p-is-petrolium
     4959              then v-petrol-start
     4960              else (if v-petrol-start = 1
     4961                    then (v-petrol-range + 1)
     4962                    else 1)
     4963              )
     4964        to v-max-gds :
     4965       if not can-find (loc_cd-plu where
     4966                         loc_cd-plu.obj-type = 'маг':U
     4967                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4968                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4969                      and loc_cd-plu.plu-type = v-plu-type
     4970                      and loc_cd-plu.plu-code = ii
     4971                      )
     4972       then LEAVE .
     4973     END .
     4974     if ii > v-max-gds then do:
     4975         if not p-silence then
     4976         message
     4977         substitute("Превышено максимально допустимое количество &5 &1" +
     4978                   "для касс &2 &3&4"
     4979                   , chr(10)
     4980                   , v-max-gds
     4981                   , 'маг':U
     4982                   , buf_cash-desk.obj-code
     4983                   , (if p-is-petrolium then "топлив" else "товаров")
     4984                   )
     4985         view-as alert-box ERROR .
     4986         undo, return error "max-gds":U.
     4987     end.
     4988     run cur-time in this-procedure ( output v-today, output v-time).
     4989     create buf_cd-plu.
     4990     assign
     4991     buf_cd-plu.b-code = p-b-code
     4992     buf_cd-plu.b-str = p-b-str
     4993     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4994                                         then buf_cash-desk.addr-path
     4995                                         else "U":U)
     4996     buf_cd-plu.to-send = yes
     4997     buf_cd-plu.charkey_one = "":U
     4998     buf_cd-plu.to-del = no
     4999     buf_cd-plu.plu-code = ii
     5000     buf_cd-plu.obj-type = 'маг':U
     5001     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     5002     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     5003     buf_cd-plu.plu-type = v-plu-type
     5004     buf_cd-plu.logkey_one = p-loc-ean
     5005     buf_cd-plu.key#_one = integer(p-extra)
     5006     .
     5007     run cd-attr-write  in this-procedure (
     5008                                           input   buf_cash-desk.db-num
     5009                                           ,input  buf_cash-desk.obj-code
     5010                                           ,input  buf_cash-desk.pos-type
     5011                                           ,input  buf_cash-desk.cash-num
     5012                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     5013                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5014                                                 and p-is-petrolium
     5015                                                 then 'tot-petrol':U
     5016                                                 else 'tot-gds':U)
     5017                                           ,input ''
     5018                                           ,input ?
     5019                                           ,input 0.0
     5020                                           ,input  (v-tot-gds + 1)
     5021                                           ,input no
     5022                                          ) no-error .
     5023     if error-status:error then do:
     5024       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     5025                          ,buf_cash-desk.cash-num
     5026                          , 'маг':U
     5027                          ,buf_cash-desk.obj-code
     5028                          , chr(10)
     5029                          , error-status:get-message(1)
     5030                          , return-value
     5031                          ).
     5032       if not p-silence then
     5033       message
     5034       v-mes
     5035       view-as alert-box error .
     5036       undo _main, return error v-mes.
     5037     end.
     5038     run cd-attr-write  in this-procedure (
     5039                                           input   buf_cash-desk.db-num
     5040                                           ,input  buf_cash-desk.obj-code
     5041                                           ,input  buf_cash-desk.pos-type
     5042                                           ,input  buf_cash-desk.cash-num
     5043                                           ,input  'MARIA_operative':U
     5044                                           ,input  'to-send':U
     5045                                           ,input ''
     5046                                           ,input ?
     5047                                           ,input 0.0
     5048                                           ,input 0
     5049                                           ,input yes
     5050                                          ) no-error .
     5051     if error-status:error then do:
     5052       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5053                          ,buf_cash-desk.cash-num
     5054                          , 'маг':U
     5055                          ,buf_cash-desk.obj-code
     5056                          , chr(10)
     5057                          , error-status:get-message(1)
     5058                          , return-value
     5059                          ).
     5060       if not p-silence then
     5061       message
     5062       v-mes
     5063       view-as alert-box error .
     5064       undo _main, return error v-mes.
     5065     end.
     5066     return "":U.
     5067   end.
     5068   END PROCEDURE.
     5069   procedure cd-mrkt_update-marketer :
     5070   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5071   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5072   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5073   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5074   define input parameter p-is-petrolium as logical no-undo .
     5075   define variable v-to-send as logical no-undo .
     5076   define variable v-tot-gds as integer no-undo .
     5077   define variable v-max-plu as integer no-undo .
     5078   define buffer buf_cd-plu for ub.cd-plu.
     5079   define variable v-plu-type as character no-undo .
     5080     do
     5081     on error undo, return error
     5082     :
     5083       v-to-send = no.
     5084       v-tot-gds = 0.
     5085       assign
     5086       v-plu-type = (if p-is-petrolium
     5087                     then  'топ':U
     5088                     else '':U
     5089                 )
     5090       .
     5091       FOR EACH buf_cd-plu WHERE
     5092              buf_cd-plu.obj-type = 'маг':U
     5093         and  buf_cd-plu.obj-code = p-obj-code
     5094         and  buf_cd-plu.pos-type = p-pos-type
     5095         and  buf_cd-plu.plu-type = v-plu-type
     5096             :
     5097         if  buf_cd-plu.to-del
     5098         or  buf_cd-plu.to-send then do:
     5099           assign
     5100           v-to-send = yes.
     5101         end.
     5102         assign
     5103         v-tot-gds = v-tot-gds + 1.
     5104       end.
     5105       run cd-attr-write  in this-procedure (
     5106                                               input   p-db-num
     5107                                               ,input  p-obj-code
     5108                                               ,input  p-pos-type
     5109                                               ,input  p-cash-num
     5110                                               ,input  'MARIA_operative':U
     5111                                               ,input  (if p-pos-type = 'MARIA':U
     5112                                                        and p-is-petrolium
     5113                                                        then  'tot-petrol':U
     5114                                                        else 'tot-gds':U)
     5115                                               ,input ''
     5116                                               ,input ?
     5117                                               ,input 0.0
     5118                                               ,input v-tot-gds
     5119                                               ,input no
     5120                                                                                           ) no-error .
     5121       if error-status:error then do:
     5122           UNDO, RETURN ERROR RETURN-VALUE.
     5123       END.
     5124       run cd-attr-write  in this-procedure (
     5125                                               input   p-db-num
     5126                                               ,input  p-obj-code
     5127                                               ,input  p-pos-type
     5128                                               ,input  p-cash-num
     5129                                               ,input  'MARIA_operative':U
     5130                                               ,input  (if p-pos-type = 'MARIA':U
     5131                                                        and p-is-petrolium
     5132                                                        then  'petrol-to-send':U
     5133                                                        else 'to-send':U)
     5134                                               ,input ''
     5135                                               ,input ?
     5136                                               ,input 0.0
     5137                                               ,input 0
     5138                                               ,input v-to-send
     5139                                               ) no-error .
     5140       if error-status:error then do:
     5141           UNDO, RETURN ERROR RETURN-VALUE.
     5142       END.
     5143       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5144                buf_cd-plu.obj-type = 'маг':U
     5145            and buf_cd-plu.obj-code = p-obj-code
     5146            and buf_cd-plu.pos-type = p-pos-type
     5147            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5148       if available buf_cd-plu then do:
     5149         if v-max-plu < buf_cd-plu.plu-code
     5150         then
     5151         v-max-plu = buf_cd-plu.plu-code .
     5152       end.
     5153       else do:
     5154         v-max-plu = 0.
     5155       end.
     5156       run cd-attr-write  in this-procedure (
     5157                                             input   p-db-num
     5158                                             ,input  p-obj-code
     5159                                             ,input  p-pos-type
     5160                                             ,input  p-cash-num
     5161                                             ,input  'MARIA_operative':U
     5162                                             ,input  (if p-pos-type = 'MARIA':U
     5163                                                     and p-is-petrolium
     5164                                                     then 'max-petrol-plu':U
     5165                                                     else 'max-plu':U)
     5166                                               ,input ''
     5167                                               ,input ?
     5168                                               ,input 0.0
     5169                                               ,input v-max-plu
     5170                                               ,input no
     5171                                             ) no-error .
     5172       if error-status:error then do:
     5173           UNDO, RETURN ERROR RETURN-VALUE.
     5174       END.
     5175     end.
     5176   end procedure.
     5177   PROCEDURE cd-mrkt_clu-marketer :
     5178   define input parameter p-silence as logical no-undo .
     5179   define parameter buffer buf_cash-desk for ub.cash-desk.
     5180   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5181   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5182   define variable v-tot-cli as integer no-undo .
     5183   define variable v-max-cli as integer no-undo .
     5184   DEFINE VARIABLE v-today as date no-undo .
     5185   DEFINE VARIABLE v-time as integer no-undo .
     5186   define buffer  buf_cd-clu for ub.cd-clu.
     5187   define buffer  loc_cd-clu for ub.cd-clu.
     5188   define variable  ii as integer no-undo.
     5189   define variable v-mes as character no-undo .
     5190   _main:
     5191   DO ON ERROR undo, leave on stop undo, leave:
     5192     if buf_cash-desk.pos-type <> 'MARIA':U
     5193     or buf_cash-desk.cash-num <> 0 then do:
     5194       assign
     5195       v-mes =
     5196       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5197                 , buf_cash-desk.pos-type).
     5198       if not p-silence then
     5199       message
     5200       v-mes
     5201       view-as alert-box error .
     5202       return error v-mes.
     5203     end.
     5204     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5205                                     ,input 'MARIA_operative':U
     5206                                     ,input 'tot-cli':U
     5207                                     ,output v-mes).
     5208     if v-tot-cli = ? then undo _main, return error v-mes.
     5209     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5210                                     ,input 'MARIA_general':U
     5211                                     ,input 'max-cli':U
     5212                                     , output v-mes).
     5213     if v-max-cli = ? then undo _main, return error v-mes.
     5214     DO ii = 1
     5215        to v-max-cli :
     5216       if not can-find (loc_cd-clu where
     5217                       loc_cd-clu.obj-type = 'маг':U
     5218                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5219                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5220                   and loc_cd-clu.clu-type = '':U
     5221                   and loc_cd-clu.clu-code = ii
     5222                      )
     5223       then LEAVE .
     5224     END .
     5225     if ii > v-max-cli then do:
     5226         if not p-silence then
     5227         message
     5228         substitute("Превышено максимально допустимое количество клиентов &1" +
     5229                   "для касс &2 &3&4"
     5230                   , chr(10)
     5231                   , v-max-cli
     5232                   , 'маг':U
     5233                   , buf_cash-desk.obj-code
     5234                   )
     5235         view-as alert-box ERROR .
     5236         undo, return error "max-cli":U.
     5237     end.
     5238     run cur-time in this-procedure ( output v-today, output v-time).
     5239     create buf_cd-clu.
     5240     assign
     5241     buf_cd-clu.cli-code = p-obj-code
     5242     buf_cd-clu.cli-type = p-obj-type
     5243     buf_cd-clu.obj-type = 'маг':U
     5244     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5245     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5246     buf_cd-clu.clu-type = '':U
     5247     buf_cd-clu.to-send = yes
     5248     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5249                               then buf_cash-desk.addr-path
     5250                               else "U":U)
     5251     buf_cd-clu.clu-code = ii
     5252     .
     5253     run cd-attr-write  in this-procedure (
     5254                                           input   buf_cash-desk.db-num
     5255                                           ,input  buf_cash-desk.obj-code
     5256                                           ,input  buf_cash-desk.pos-type
     5257                                           ,input  buf_cash-desk.cash-num
     5258                                           ,input  'MARIA_operative':U
     5259                                           ,input  'tot-cli':U
     5260                                           ,input ''
     5261                                           ,input ?
     5262                                           ,input 0.0
     5263                                           ,input  (v-tot-cli + 1)
     5264                                           ,input no
     5265                                          ) no-error .
     5266     if error-status:error then do:
     5267       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5268                          ,buf_cash-desk.cash-num
     5269                          , 'маг':U
     5270                          ,buf_cash-desk.obj-code
     5271                          , chr(10)
     5272                          , error-status:get-message(1)
     5273                          , return-value
     5274                          ).
     5275       if not p-silence then
     5276       message
     5277       v-mes
     5278       view-as alert-box error .
     5279       undo _main, return error v-mes.
     5280     end.
     5281     run cd-attr-write  in this-procedure (
     5282                                           input   buf_cash-desk.db-num
     5283                                           ,input  buf_cash-desk.obj-code
     5284                                           ,input  buf_cash-desk.pos-type
     5285                                           ,input  buf_cash-desk.cash-num
     5286                                           ,input  'MARIA_operative':U
     5287                                           ,input  'cli-to-send':U
     5288                                           ,input ''
     5289                                           ,input ?
     5290                                           ,input 0.0
     5291                                           ,input 0
     5292                                           ,input yes
     5293                                          ) no-error .
     5294     if error-status:error then do:
     5295       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5296                          ,buf_cash-desk.cash-num
     5297                          , 'маг':U
     5298                          ,buf_cash-desk.obj-code
     5299                          , chr(10)
     5300                          , error-status:get-message(1)
     5301                          , return-value
     5302                          ).
     5303       if not p-silence then
     5304       message
     5305       v-mes
     5306       view-as alert-box error .
     5307       undo _main, return error v-mes.
     5308     end.
     5309     return "":U.
     5310   end.
     5311   END PROCEDURE.
     5312   procedure cd-mrkt_update-marketer-cli :
     5313   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5314   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5315   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5316   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5317   define variable v-cli-to-send as logical no-undo .
     5318   define variable v-tot-cli as integer no-undo .
     5319   define variable v-max-clu as integer no-undo .
     5320   define buffer buf_cd-clu for ub.cd-clu.
     5321   do
     5322   on error undo, return error return-value
     5323   :
     5324     v-cli-to-send = no.
     5325     v-tot-cli = 0.
     5326     FOR EACH buf_cd-clu WHERE
     5327           buf_cd-clu.obj-type = 'маг':U
     5328       and buf_cd-clu.obj-code =  p-obj-code
     5329       and buf_cd-clu.pos-type =  p-pos-type
     5330       and buf_cd-clu.clu-type =  '':U
     5331       :
     5332       if buf_cd-clu.to-del = yes then do:
     5333         assign
     5334         v-cli-to-send = yes.
     5335       end.
     5336       assign
     5337       v-tot-cli = v-tot-cli + 1.
     5338     end.
     5339     run cd-attr-write  in this-procedure (
     5340                                             input   p-db-num
     5341                                             ,input  p-obj-code
     5342                                             ,input  p-pos-type
     5343                                             ,input  p-cash-num
     5344                                             ,input  'MARIA_operative':U
     5345                                             ,input  'tot-cli':U
     5346                                             ,input ''
     5347                                             ,input ?
     5348                                             ,input 0.0
     5349                                             ,input v-tot-cli
     5350                                             ,input no
     5351                                             ) no-error .
     5352     if error-status:error then do:
     5353         UNDO, RETURN ERROR RETURN-VALUE.
     5354     END.
     5355     run cd-attr-write  in this-procedure (
     5356                                             input   p-db-num
     5357                                             ,input  p-obj-code
     5358                                             ,input  p-pos-type
     5359                                             ,input  p-cash-num
     5360                                             ,input  'MARIA_operative':U
     5361                                             ,input  'cli-to-send':U
     5362                                             ,input ''
     5363                                             ,input ?
     5364                                             ,input 0.0
     5365                                             ,input 0
     5366                                             ,input v-cli-to-send
     5367                                             ) no-error .
     5368     if error-status:error then do:
     5369         UNDO, RETURN ERROR RETURN-VALUE.
     5370     END.
     5371     FIND LAST buf_cd-clu WHERE
     5372             buf_cd-clu.obj-type = 'маг':U
     5373         and buf_cd-clu.obj-code = p-obj-code
     5374         and buf_cd-clu.pos-type = p-pos-type
     5375         and buf_cd-clu.clu-type = '':U
     5376         NO-LOCK use-index pi no-error .
     5377     if available buf_cd-clu then do:
     5378       if v-max-clu < buf_cd-clu.clu-code
     5379       then
     5380       v-max-clu = buf_cd-clu.clu-code.
     5381     end.
     5382     else do:
     5383       v-max-clu = 0.
     5384     end.
     5385     run cd-attr-write  in this-procedure (
     5386                                           input   p-db-num
     5387                                           ,input  p-obj-code
     5388                                           ,input  p-pos-type
     5389                                           ,input  p-cash-num
     5390                                           ,input  'MARIA_operative':U
     5391                                           ,input  'max-clu':U
     5392                                           ,input ''
     5393                                           ,input ?
     5394                                           ,input 0.0
     5395                                           ,input v-max-clu
     5396                                           ,input no
     5397                                           ) no-error .
     5398     if error-status:error then do:
     5399         UNDO, RETURN ERROR RETURN-VALUE.
     5400     END.
     5401   end.
     5402   end procedure.
