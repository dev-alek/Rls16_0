     6354   define variable v-exch-rate0    as decimal   no-undo .
     6355   define variable v-exch-scale0   as decimal   no-undo .
     6356   define variable v-base-rate     as decimal   no-undo .
     6357   define variable v-base-scale    as decimal   no-undo .
     6358   define variable v-exch-rate     as decimal   no-undo .
     6359   define variable v-exch-scale    as decimal   no-undo .
     6360   define variable v-host-code     as integer   no-undo .
     6361   define variable v-curr-abbr     as character no-undo .
     6362   define variable v-grp-name      as character no-undo .
     6363   define variable v-date-1        as date      no-undo .
     6364   define variable v-date-2        as date      no-undo .
     6365   define variable v-interv        as character no-undo .
     6366   define variable v-pay-name      as character no-undo .
     6367   define variable v-cli-oborot    as decimal   no-undo .
     6368   define variable v-trn-pay-code  as integer   no-undo .
     6369   define variable v-cash-pay-curr as integer   no-undo .
     6370   define variable v-cash-pay-code as integer   no-undo .
     6371   do
     6372   on error undo, return error return-value
     6373   :
     6374   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6375   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6376   if p-fact-order = ? then do:
     6377     run fact-order-mpl (
     6378         input   today       ,
     6379         input   p-obj-type  ,
     6380         input   p-obj-code  ,
     6381         output  p-fact-order ).
     6382   end.
     6383   if p-vid-pay <> "" then do:
     6384      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6385      if available buf_pay-type
     6386         then v-trn-pay-code = buf_pay-type.obj-code.
     6387         else v-trn-pay-code =  0.
     6388   end.
     6389   else v-trn-pay-code = 0 .
     6390   if p-cash-pay-type <> "" then do:
     6391      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6392      if available buf_pay-type
     6393         then
     6394           assign
     6395             v-cash-pay-curr = buf_cash-pay.curr-code
     6396             v-cash-pay-code = buf_cash-pay.cdpay-code
     6397           .
     6398         else
     6399           assign
     6400             v-cash-pay-curr = 0
     6401             v-cash-pay-code = 0
     6402             .
     6403   end.
     6404   else
     6405     assign
     6406       v-cash-pay-curr = 0
     6407       v-cash-pay-code = 0
     6408       .
     6409   for each tt_price-all  : delete tt_price-all . end.
     6410   assign
     6411     p-plt-id             = ?
     6412     p-plt-db-num         = ?
     6413     p-pdf-id             = ?
     6414     p-pdf-db-num         = ?
     6415     p-sale-price-base    = ?
     6416     p-sale-price-rubl    = ?
     6417     v-cli-oborot         = 0
     6418   .
     6419   find first buf_global-state no-lock no-error .
     6420   if not available buf_global-state then do:
     6421      message
     6422        "Не заданы параметры ценообразования!"
     6423        view-as alert-box error
     6424      .
     6425      return error return-value .
     6426   end.
