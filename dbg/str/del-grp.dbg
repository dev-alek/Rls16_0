    10642   procedure finish-send :
    10643     do
    10644     on error undo, return error
    10645     :
    10646   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10647   if v-view-log
    10648   and not g#news
    10649   and not g#auto
    10650   then do:
    10651     message
    10652     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10653     "!!!Внимательно прочитайте Log-file!!"
    10654     view-as alert-box error .
    10655        define variable v-user-action90   as character no-undo .
    10656     define variable v-printed90       as logical   no-undo .
    10657     run gbl/prnfilen.w
    10658       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10659       ,input  0
    10660       ,input  (string("./":U) + log-file-name)
    10661       ,input  7
    10662       ,output v-user-action90
    10663       ,output v-printed90
    10664       ) .
    10665   end.
    10666   if v-view-log = true
    10667   and (g#news
    10668   or g#auto)
    10669   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10670   then do:
    10671      run cb_set-view-log in p-parent-handle ( input yes).
    10672   end.
    10673       define variable v-save-file-name as character no-undo .
    10674       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10675       OS-APPEND value(log-file-name) value(v-save-file-name).
    10676       OS-DELETE value(log-file-name).
    10677     end.
    10678   end procedure.
