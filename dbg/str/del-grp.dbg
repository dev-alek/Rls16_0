     1163                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1164                   buf_bar-code.part-code = ""           and
     1165                   buf_bar-code.in-code   = ""           and
     1166                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1167             if not available buf_bar-code then do:
