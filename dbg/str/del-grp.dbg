     6325   define input  parameter p-cash-pay-type  as character no-undo .
     6326   define input  parameter p-fact-order  as decimal   no-undo .
     6327   define output parameter p-plt-id          as integer   no-undo .
     6328   define output parameter p-plt-db-num      as integer   no-undo .
     6329   define output parameter p-pdf-id          as integer   no-undo .
     6330   define output parameter p-pdf-db-num      as integer   no-undo .
     6331   define output parameter p-sale-price-base as decimal   no-undo .
     6332   define output parameter p-sale-price-rubl as decimal   no-undo .
     6333   define output parameter p-road-tax-base as decimal   no-undo .
     6334   define output parameter p-road-tax-rubl as decimal   no-undo .
     6335   define output parameter p-excise-base   as decimal   no-undo .
     6336   define output parameter p-excise-rubl   as decimal   no-undo .
     6337   define variable v-cli-oborot-ALL as decimal   no-undo .
     6338   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6339   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
