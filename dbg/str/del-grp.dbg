     8225       if thbjattr_thbj-attr.prop-code = 'unq-artc':U then unq-artc = thbjattr_thbj-attr.property-value-logical .
     8226   end.
     8227   assign
     8228   rdtaxcd  = integer('3':U)
     8229   vattaxcd = integer('1':U)
     8230   exctaxcd = integer('4':U).
     8231   assign
     8232   var-report-num = dynamic-next-value( "next-report":U, "ubflt":U)
     8233   .
     8234   FIND ub.shop WHERE ub.shop.obj-code = abs(i-obj-code) NO-LOCK .
     8235   find   FIRST ub.clients WHERE
     8236             ub.clients.obj-type = 'маг':U AND
     8237             ub.clients.obj-code = ub.shop.obj-code  no-error .
     8238   if available ub.clients then
     8239   assign
     8240   for-shop-name = ub.clients.obj-name.
     8241   else for-shop-name = 'маг':U + string(ub.shop.obj-code).
     8242   run adm/shattri.p (
     8243       input "get":U
     8244       ,input  'маг':U
     8245       ,input  abs(i-obj-code)
     8246       ,input  'cd-sending':U
     8247       ,input  'alllstcs':U
     8248       ,output v-value-character
     8249       ,output v-value-date
     8250       ,output v-value-decimal
     8251       ,output v-value-integer
     8252       ,output v-value-logical
     8253       ,output v-param-type
     8254       ,INPUT-OUTPUT table-handle v-tth
     8255       ) no-error .
     8256   IF not error-status:error
     8257   then alllstcs = v-value-logical.
     8258   delete object v-tth.
     8259   run adm/shattri.p (
     8260       input "get":U
     8261       ,input  'маг':U
     8262       ,input  abs(i-obj-code)
     8263       ,input  'cd-sending':U
     8264       ,input  'noautocs':U
