    12779       if conf-par = "X":U then do:
    12780         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12781         if ncr-disc-string <> '':U then
    12782         PUT stream IBMstream unformatted
    12783         chr(32)
    12784         "X":U
    12785         chr(32)
    12786         IBm-good-code
    12787         chr(32)
    12788         chr(32)
    12789         ncr-disc-string
    12790         chr(10)
    12791         .
    12792       end.
    12793     end.
    12794     if pos-type = 'NCR-AS@R':U
    12795     and cash-gds.kat-discnt-rule <> 0
    12796     then do:
    12797       case how-pcnt-kat :
    12798         when 'pcnt-kat-pdf':U then do:
    12799             v-kat-discnt = cash-gds.price-sale.
    12800           end.
    12801         otherwise do:
    12802           v-kat-discnt = ?.
    12803         end.
    12804       end case.
    12805       run create-ncr-kat-discnt in this-procedure (
    12806                                                    input string(cash-gds.gds-code)
    12807                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12808                                                   ,input chk_name
    12809                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12810                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12811                                                   ,input 'time-rule-num':U
    12812                                                   ,input v-kat-discnt
    12813                                                   ) no-error .
    12814       if error-status:error then do:
    12815       end.
    12816     end.
    12817     if IBM-good-code = IBM-good-code-2 then leave do2.
    12818     assign
    12819     IBM-good-code = IBM-good-code-2
    12820     .
    12821   end.
    12822       end.
    12823     END CASE .
    12824   END PROCEDURE .
    12825   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12826   PROCEDURE   for-cash-cycle:
    12827   DEFINE VARIABLE fname-list as character no-undo .
    12828   DEFINE VARIABLE out-list as character no-undo .
    12829   DEFINE VARIABLE var-file-num as integer no-undo .
    12830   DEFINE VARIABLE v-dir-remote as character no-undo .
