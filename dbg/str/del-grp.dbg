     7024   procedure grp-obj-notcorr-value :
     7025   do
     7026   on error undo, return error
     7027   :
     7028   define input parameter p-node-code             as integer      no-undo.
     7029   define input parameter p-obj-type              as character    no-undo.
     7030   define input parameter p-obj-code              as integer      no-undo.
     7031   define output parameter p-notcorr              as character    no-undo init ?.
     7032   define output parameter p-range-notcorr     as integer      no-undo.
     7033   define output parameter p-exists-notcorr    as logical      no-undo.
     7034   define variable v-host-code as integer      no-undo.
     7035   DEFINE VARIABLE v-found as logical no-undo .
     7036   DEFINE VARIABLE v-exists as logical no-undo .
     7037   DEFINE VARIABLE v-range as integer no-undo .
     7038   DEFINE VARIABLE jj as integer no-undo .
     7039   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7040   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7041   define buffer buf_gds-grp for ub.gds-grp.
     7042   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7043   find first buf_gds-grp no-lock where
     7044              buf_gds-grp.node-code = p-node-code no-error .
     7045   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7046     message
     7047       vss-workfile vss-revision vss-description
     7048       skip "Не удалось найти группу товаров с кодом" p-node-code
     7049       view-as alert-box error .
     7050     undo, return error .
     7051   end.
     7052   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7054     (input  p-obj-type
     7055     ,input  p-obj-code
     7056     ,output v-host-code
     7057     ) no-error .
     7058   if error-status :error
     7059   then do:
     7060       message
     7061         vss-workfile vss-revision vss-description
     7062         skip "Не удалось найти фирму объекта"
     7063         skip p-obj-type p-obj-code
     7064         skip return-value
     7065         skip trim(error-status :get-message(1))
     7066       view-as alert-box error.
     7067       undo, return error .
     7068   end.
     7069   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7070   do while v-found = no and jj < 2:
     7071     if v-range <> 3 then do:
     7072       find first buf_gds-grp-obj no-lock
     7073           where buf_gds-grp-obj.node-code = p-node-code
     7074             and buf_gds-grp-obj.host-code = v-host-code
     7075             and buf_gds-grp-obj.obj-type  = p-obj-type
     7076             and buf_gds-grp-obj.obj-code  = p-obj-code
     7077       no-error .
     7078     end.
     7079     if v-range = 3 or not available buf_gds-grp-obj
     7080     then do:
     7081        if v-range <> 2 then do:
     7082           find first buf_gds-grp-obj no-lock
     7083               where buf_gds-grp-obj.node-code = p-node-code
     7084                 and buf_gds-grp-obj.host-code = v-host-code
     7085                 and buf_gds-grp-obj.obj-type  = ""
     7086                 and buf_gds-grp-obj.obj-code  = 0
     7087           no-error .
     7088         end.
     7089         if v-range = 2 or not available buf_gds-grp-obj
     7090         then do:
     7091             if v-range <> 1 then do:
     7092               find first buf_gds-grp-obj no-lock
     7093                   where buf_gds-grp-obj.node-code = p-node-code
     7094                   and buf_gds-grp-obj.host-code = 0
     7095                   and buf_gds-grp-obj.obj-type  = ""
     7096                   and buf_gds-grp-obj.obj-code  = 0
     7097               no-error .
     7098             end.
     7099             if v-range = 1 or not available buf_gds-grp-obj
     7100             then do:
     7101                 assign
     7102                     v-exists = no
     7103                 .
     7104             end.
     7105             else do:
     7106                 assign
     7107                     v-exists = yes
     7108                     v-range = 1
     7109                 .
     7110             end.
     7111         end.
     7112         else do:
     7113             assign
     7114                 v-exists = yes
     7115                 v-range  = 2
     7116             .
     7117         end.
     7118     end.
     7119     else do:
     7120         assign
     7121             v-exists = yes
     7122             v-range  = 3
     7123         .
     7124     end.
     7125     if available buf_gds-grp-obj
     7126     then do:
     7127       find first buf_gds-grp-obj-attr no-lock
     7128         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7129           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7130           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7131           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7132           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7133         no-error .
     7134       if available buf_gds-grp-obj-attr then do:
     7135         assign
     7136           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7137         .
     7138       end.
     7139       else do:
     7140         assign
     7141           v-notcorr-value = ?
     7142         .
     7143       end.
     7144       assign
     7145       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7146                           then yes
     7147                           else p-exists-notcorr)
     7148       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7149                         then v-range
     7150                         else p-range-notcorr
     7151       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7152                         then v-notcorr-value
     7153                         else p-notcorr
     7154       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7155       jj = jj + 1
     7156       .
     7157     end.
     7158     else do:
     7159       assign
     7160       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7161       jj = jj + 1
     7162       .
     7163     end.
     7164   end.
     7165   end.
     7166   end procedure.
