      703   procedure thobjs :
      704      define input        parameter parparentproc     as widget-handle no-undo .
      705      define input        parameter i-bttns           as character     no-undo .
      706      define input        parameter i-list-mode       as character     no-undo.
      707      define input        parameter i-obj-type        as character     no-undo.
      708      define input        parameter i-db-num          as integer       no-undo.
      709      define input        parameter i-host-code       as integer       no-undo.
      710      define input-output parameter p-rid-list        as character     no-undo .
      711   run ref/thobjs.p
      712           ( input parparentproc
      713            ,input  this-procedure :handle
      714           , input i-bttns
      715           , input i-list-mode
      716           , input i-obj-type
      717           , input i-db-num
      718           , input i-host-code
      719           , input-output p-rid-list ) no-error .
      720   end.
      721   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   define temp-table temp-schedule-free no-undo
      723   field free-id as character
      724   field free-task-name as character
      725   field proc-run-name as character
      726   field proc-param-edit-name as character
      727   field conf-param as character
      728   field is-gbd as logical
      729   field is-ubd as logical
      730   field enable-concurrent-0 as logical
      731   field enable-concurrent-db as logical
      732   field other-info as character
      733   field enc-key as character
      734   field is-rum as logical
      735   index pi is unique primary
      736   free-id.
      737   procedure schedule-attr-name :
      738   do
      739     on error undo, return error
      740     :
      741     define input  parameter p-code           as character no-undo .
      742     define output parameter p-type           as character no-undo .
      743     define output parameter p-format         as character no-undo .
      744     define output parameter p-label          as character no-undo .
      745     define output parameter p-user-can-edit  as logical   no-undo .
      746     define output parameter p-output-display as logical   no-undo .
      747     define output parameter p-other          as character no-undo .
      748       if index(p-code, chr(4)) > 0 then do:
      749         p-code = entry(1, p-code, chr(4)).
      750       end.
      751       case p-code :
      752               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      753               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      754               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      755               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      756               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      757               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      758               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      759               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      760               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      761         otherwise do:
      762           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      763         end.
      764       end.
      765     end.
      766   end procedure.
      767   procedure schedule-attr-tooltip :
      768   do
      769     on error undo, return error
      770     :
      771       define input  parameter p-code    as character no-undo .
      772       define output parameter p-tooltip as character no-undo .
      773       define output parameter p-label   as character no-undo .
      774       if index(p-code, chr(4)) > 0 then do:
      775         p-code = entry(1, p-code, chr(4)).
      776       end.
      777       case p-code :
      778               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      779               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      780               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      781               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      782               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      783               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      784               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      785               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      786               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      787         otherwise do:
      788               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      789         end.
      790       end.
      791     end.
      792   end procedure.
      793   procedure schedule-attr-value :
      794   do
      795   on error undo, return error return-value
      796   :
      797   define input parameter  p-cre-db-num as integer    no-undo.
      798   define input parameter  p-task-type  as character  no-undo.
      799   define input parameter  p-task-num   as integer    no-undo.
      800   define input parameter  p-code       as character  no-undo.
      801   define output parameter p-value      as character  no-undo.
      802   define output parameter p-type       as character  no-undo.
      803       define variable v-format         as character no-undo .
      804       define variable v-label          as character no-undo .
      805       define variable v-user-can-edit  as logical   no-undo .
      806       define variable v-output-display as logical   no-undo .
      807       define variable v-other          as character no-undo .
      808       define buffer buf_schedule-attr for ub.schedule-attr.
      809       run schedule-attr-name in this-procedure (
      810             input  p-code
      811           , output p-type
      812           , output v-format
      813           , output v-label
      814           , output v-user-can-edit
      815           , output v-output-display
      816           , output v-other
      817       ) no-error .
      818       if error-status :error
      819       then do:
      820           undo, return error return-value .
      821       end.
      822       if p-code begins ('schd-free-id':U + chr(4))
      823       and entry(2, p-code, chr(4)) = '':U then do:
      824         find first buf_schedule-attr no-lock
      825             where buf_schedule-attr.cre-db-num = p-cre-db-num
      826               and buf_schedule-attr.task-type  = p-task-type
      827               and buf_schedule-attr.task-num   = p-task-num
      828               and buf_schedule-attr.attr-code  begins p-code
      829         no-error .
      830       end.
      831       else do:
      832         find first buf_schedule-attr no-lock
      833             where buf_schedule-attr.cre-db-num = p-cre-db-num
      834               and buf_schedule-attr.task-type  = p-task-type
      835               and buf_schedule-attr.task-num   = p-task-num
      836               and buf_schedule-attr.attr-code  = p-code
      837         no-error .
      838       end.
      839       if available buf_schedule-attr
      840       then do:
      841           assign
      842               p-value = buf_schedule-attr.attr-value
      843           .
      844       end.
      845       else do:
      846         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      847            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      848         end.
      849         else do:
      850           assign
      851               p-value = if p-type = 'L':U then "no":U else ""
      852           .
      853         end.
      854       end.
      855   end.
      856   end procedure.
      857   procedure schedule-attr-write :
      858   do
      859   on error undo, return error
      860   :
      861   define input parameter p-cre-db-num  as integer   no-undo.
      862   define input parameter p-task-type   as character no-undo.
      863   define input parameter p-task-num    as integer   no-undo.
      864   define input parameter p-code        as character no-undo.
      865   define input parameter p-value       as character no-undo.
      866       define variable v-type              as character                no-undo.
      867       define variable v-format            as character                no-undo.
      868       define variable v-label             as character                no-undo.
      869       define variable v-user-can-edit     as logical                  no-undo.
      870       define variable v-output-display    as logical                  no-undo.
      871       define variable v-other             as character                no-undo.
      872       define buffer buf_schedule-attr for ub.schedule-attr .
      873       run schedule-attr-name in this-procedure (
      874             input  p-code
      875           , output v-type
      876           , output v-format
      877           , output v-label
      878           , output v-user-can-edit
      879           , output v-output-display
      880           , output v-other
      881       ) no-error.
      882       if error-status :error
      883       then do:
      884           undo, return error return-value.
      885       end.
      886       find first buf_schedule-attr exclusive-lock
      887            where buf_schedule-attr.cre-db-num = p-cre-db-num
      888              and buf_schedule-attr.task-type  = p-task-type
      889              and buf_schedule-attr.task-num   = p-task-num
      890              and buf_schedule-attr.attr-code  = p-code
      891       no-error.
      892       if not available buf_schedule-attr
      893       then do:
      894           create buf_schedule-attr.
      895           assign
      896             buf_schedule-attr.cre-db-num = p-cre-db-num
      897             buf_schedule-attr.task-type  = p-task-type
      898             buf_schedule-attr.task-num   = p-task-num
      899             buf_schedule-attr.attr-code  = p-code
      900             buf_schedule-attr.attr-value = p-value
      901           .
      902       end.
      903       else do:
      904           assign
      905               buf_schedule-attr.attr-value = p-value
      906           .
      907       end.
      908   end.
      909   end procedure.
      910   procedure schedule-attr-delete :
      911   do
      912   on error undo, return error
      913   :
      914   define input  parameter p-cre-db-num  as integer   no-undo.
      915   define input  parameter p-task-type   as character no-undo.
      916   define input  parameter p-task-num    as integer   no-undo.
      917   define input  parameter p-code        as character no-undo.
      918   define output parameter p-deleted     as logical   no-undo.
      919       define buffer buf_schedule-attr for ub.schedule-attr .
      920       define variable v-type              as character                no-undo.
      921       define variable v-format            as character                no-undo.
      922       define variable v-label             as character                no-undo.
      923       define variable v-user-can-edit     as logical                  no-undo.
      924       define variable v-output-display    as logical                  no-undo.
      925       define variable v-other             as character                no-undo.
      926       run schedule-attr-name in this-procedure (
      927             input p-code
      928           , output v-type
      929           , output v-format
      930           , output v-label
      931           , output v-user-can-edit
      932           , output v-output-display
      933           , output v-other
      934       ) no-error .
      935       if error-status :error
      936       then do:
      937           undo, return error return-value .
      938       end.
      939       find first buf_schedule-attr exclusive-lock
      940            where buf_schedule-attr.cre-db-num = p-cre-db-num
      941              and buf_schedule-attr.task-type  = p-task-type
      942              and buf_schedule-attr.task-num   = p-task-num
      943              and buf_schedule-attr.attr-code  = p-code
      944       no-error.
      945       if not available buf_schedule-attr
      946       then do:
      947           assign
      948               p-deleted = no
      949           .
      950       end.
      951       else do:
      952           delete buf_schedule-attr.
      953           assign
      954               p-deleted = yes
      955           .
      956       end.
      957   end.
      958   end procedure.
      959   procedure schedule-attr-news :
      960   do
      961   on error undo, return error
      962   :
      963       define input  parameter p-code           as character no-undo .
      964       define output parameter p-news           as logical   no-undo .
      965       if index(p-code, chr(4)) > 0 then do:
      966         p-code = entry(1, p-code, chr(4)).
      967       end.
      968       case p-code :
      969               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      970               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      971               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      972               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      973               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      974               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      975               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      976               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      977               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      978         otherwise do:
      979           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      980         end.
      981       end.
      982   end.
      983   end procedure.
      984   procedure schedule-attr-extract-logical :
      985   do
      986   on error undo, return error
      987   :
      988   define input  parameter p-parameter-number   as integer      no-undo.
      989   define input  parameter p-parameter-list     as character    no-undo.
      990   define output parameter p-parameter-value   as logical      no-undo.
      991       if num-entries( p-parameter-list ) > p-parameter-number - 1
      992       then do:
      993           assign
      994               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      995           .
      996       end.
      997       else do:
      998           assign
      999               p-parameter-value   = no
     1000           .
     1001       end.
     1002   end.
     1003   end procedure.
     1004   procedure schedule-attr-get-free-id :
     1005   do
     1006   on error undo, return error return-value
     1007   :
     1008     define input  parameter p-cre-db-num  as integer   no-undo.
     1009     define input  parameter p-task-type   as character no-undo.
     1010     define input  parameter p-task-num    as integer   no-undo.
     1011     define output parameter p-free-id     as character no-undo.
     1012     define buffer buf_schedule-attr for ub.schedule-attr.
     1013     find first buf_schedule-attr no-lock
     1014         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1015           and buf_schedule-attr.task-type  = p-task-type
     1016           and buf_schedule-attr.task-num   = p-task-num
     1017           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1018     no-error .
     1019     if available buf_schedule-attr then
     1020     assign
     1021     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1022     no-error
     1023     .
     1024   end.
     1025   end procedure.
     1026   procedure schedule-attr-get-free-props :
     1027     define input parameter p-free-id as character no-undo .
     1028     define output parameter p-value as character no-undo .
     1029     define buffer buf_temp-schedule-free for temp-schedule-free.
     1030     do
     1031     on error undo, return error return-value
     1032     :
     1033       find first buf_temp-schedule-free no-lock no-error .
     1034       if not available buf_temp-schedule-free then do:
     1035         run schedule-attr-fill-free-props in this-procedure .
     1036       end.
     1037       find first buf_temp-schedule-free where
     1038               buf_temp-schedule-free.free-id = p-free-id no-error.
     1039       if available buf_temp-schedule-free then do:
     1040         assign
     1041         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1042                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1043                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1044                   buf_temp-schedule-free.conf-param           + chr(4) +
     1045                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1046                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1047                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1048                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1049                   buf_temp-schedule-free.other-info
     1050         .
     1051       end.
     1052       else do:
     1053        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1054                              "id произвольной задачи - &5"
     1055                              ,vss-workfile
     1056                              ,vss-revision
     1057                              ,vss-description
     1058                              ,chr(10)
     1059                              ,p-free-id).
     1060       end.
     1061     end.
     1062   end procedure.
     1063   procedure schedule-attr-is-rum-free-id :
     1064   define input parameter p-free-id as character no-undo .
     1065   define output parameter p-is-rum as logical no-undo .
     1066   define buffer buf_temp-schedule-free for temp-schedule-free.
     1067   do
     1068   on error undo, return error
     1069   :
     1070       find first buf_temp-schedule-free no-lock no-error .
     1071       if not available buf_temp-schedule-free then do:
     1072         run schedule-attr-fill-free-props in this-procedure .
     1073       end.
     1074       find first buf_temp-schedule-free where
     1075               buf_temp-schedule-free.free-id = p-free-id no-error.
     1076       if available buf_temp-schedule-free
     1077       and buf_temp-schedule-free.is-rum
     1078       then do:
     1079         p-is-rum = yes.
     1080       end.
     1081   end.
     1082   end procedure.
     1083   procedure schedule-attr-fill-free-props :
     1084   define variable v-path                    as character                no-undo .
     1085   DEFINE VARIABLE v-full-path               as character                no-undo .
     1086   DEFINE VARIABLE v-file-name               as character                no-undo .
     1087   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1088   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1089   define buffer buf_temp-schedule-free for temp-schedule-free.
     1090   define variable v-answer as logical no-undo .
     1091     do
     1092     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1093                                           ,vss-workfile
     1094                                           ,vss-revision
     1095                                           ,vss-description
     1096                                           ,chr(10)
     1097                                           ,error-status:get-message(1) )
     1098     :
     1099       run gbl/filename.p (
     1100                       input 'cmp/shd-free.d'
     1101                     ,output v-full-path
     1102                     ,output v-path
     1103                     ,output v-file-name
     1104                     ,output v-file-name-no-ext
     1105                     ,output v-file-name-ext
     1106                     ) .
     1107       input from value(v-full-path).
     1108       repeat :
     1109         create buf_temp-schedule-free.
     1110         import buf_temp-schedule-free.
     1111       END.
     1112       input close.
     1113       _ff:
     1114       for each buf_temp-schedule-free :
     1115         if buf_temp-schedule-free.free-id = '':U then do:
     1116            delete buf_temp-schedule-free.
     1117            next _ff.
     1118          end.
     1119          run schedule-attr-check-enc in this-procedure (
     1120                                                       input  buf_temp-schedule-free.free-id
     1121                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1122                                                               buf_temp-schedule-free.proc-param-edit-name +
     1123                                                               buf_temp-schedule-free.conf-param +
     1124                                                               string(buf_temp-schedule-free.is-gbd) +
     1125                                                               string(buf_temp-schedule-free.is-ubd) +
     1126                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1127                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1128                                                               string(buf_temp-schedule-free.other-info)
     1129                                                               )
     1130                                                       ,input  buf_temp-schedule-free.enc-key
     1131                                                       ,output v-answer    ) no-error .
     1132          if error-status:error
     1133          or not v-answer then delete buf_temp-schedule-free.
     1134        end.
     1135     end.
     1136   end procedure.
     1137   Function schedule-attr-reverse returns character (str as character).
     1138      define variable rev_incl_s as character init "" no-undo .
     1139      define variable rev_incl_i as integer no-undo .
     1140      define variable rev_incl_l as integer no-undo .
     1141      rev_incl_l = length(str).
     1142      do rev_incl_i = 1 to rev_incl_l:
     1143         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1144      end.
     1145      return rev_incl_s.
     1146   end.
     1147   procedure schedule-attr-check-enc.
     1148     define input  parameter p-free-id   as character no-undo .
     1149     define input  parameter p-value     as character no-undo .
     1150     define input  parameter p-enc-value as character no-undo .
     1151     define output parameter p-answer    as logical   no-undo .
     1152     define variable tmp         as character no-undo .
     1153     define variable v-enc-value as character no-undo .
     1154     assign
     1155     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1156     .
     1157     run schedule-attr-pswd-enc in this-procedure
     1158       ( input tmp
     1159        ,output v-enc-value
     1160       ) no-error .
     1161     if error-status:error then do:
     1162       message
     1163         vss-workfile vss-revision vss-description skip
     1164         "Ошибка при вызове процедуры pswd-enc" skip
     1165         return-value skip
     1166         error-status :get-message(1) skip
     1167         view-as alert-box error .
     1168       undo, return error .
     1169     end.
     1170     if v-enc-value = p-enc-value then do:
     1171       assign
     1172         p-answer = true
     1173       .
     1174     end.
     1175     else do:
     1176       assign
     1177         p-answer = false
     1178       .
     1179     end.
     1180   end.
     1181   procedure schedule-attr-conf-enc.
     1182     define input  parameter p-free-id   as character no-undo .
     1183     define input  parameter p-value     as character no-undo .
     1184     define output parameter p-enc-value as character no-undo .
     1185     define variable tmp         as character no-undo .
     1186     assign
     1187       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1188     .
     1189     run schedule-attr-pswd-enc in this-procedure
     1190       ( input tmp
     1191        ,output p-enc-value
     1192       ) no-error .
     1193     if error-status:error then do:
     1194       message
     1195         vss-workfile vss-revision vss-description skip
     1196         "Ошибка при вызове процедуры pswd-enc" skip
     1197         return-value skip
     1198         error-status :get-message(1) skip
     1199         view-as alert-box error .
     1200       undo, return error .
     1201     end.
     1202   end procedure.
     1203   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1204   procedure schedule-attr-pswd-enc :
     1205     define input parameter  pswd     as character no-undo .
     1206     define output parameter enc-pswd as character no-undo .
     1207     do
     1208     on error undo, return error return-value
     1209     :
     1210       assign
     1211         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1212       .
     1213     end.
     1214   end procedure.
     1215   define variable v-obj-list              as character    no-undo.
     1216   define variable v-host-code             as integer      no-undo.
     1217   define variable v-host-name             as character    no-undo.
     1218   dEFINE variable v-param-type            as character     no-undo.
     1219   define temp-table temp_obj-list no-undo
     1220       field obj-type as character
     1221       field obj-code as integer
     1222       index pi is primary unique obj-type obj-code
     1223   .
     1224   DEFINE BUTTON b-help
     1225        LABEL "Помо&щь"
     1226        SIZE 10 BY 1.
     1227   DEFINE BUTTON bt-sel-obj
     1228        IMAGE-UP FILE "btn-down-arrow":U
     1229        IMAGE-DOWN FILE "btn-down-arrow":U
     1230        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1231        LABEL "..."
     1232        SIZE 3.63 BY 1.04.
     1233   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1234        LABEL "&Отмена"
     1235        SIZE 10 BY 1
     1236        BGCOLOR 8 .
     1237   DEFINE BUTTON Btn_OK DEFAULT
     1238        LABEL "&Ввод"
     1239        SIZE 10 BY 1
     1240        BGCOLOR 8 .
     1241   DEFINE VARIABLE ed-object AS CHARACTER
     1242        VIEW-AS EDITOR NO-BOX
     1243        SIZE 40.75 BY 3.38
     1244        FGCOLOR 1  NO-UNDO.
     1245   DEFINE VARIABLE rs-1 AS INTEGER
     1246        VIEW-AS RADIO-SET VERTICAL
     1247        RADIO-BUTTONS
     1248             "все объекты БД", 1,
     1249   "все объекты БД по фирме", 2,
     1250   "объекты выборочно", 3
     1251        SIZE 28 BY 3.25 NO-UNDO.
     1252   DEFINE VARIABLE rs-remote AS INTEGER
     1253        VIEW-AS RADIO-SET VERTICAL
     1254        RADIO-BUTTONS
     1255             "Прием информации с локальных касс", 0,
     1256   "Запрос на удаленные кассы", 1
     1257        SIZE 49.5 BY 1.75 NO-UNDO.
     1258   DEFINE RECTANGLE rct-obj
     1259        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1260        SIZE 79 BY 4.25.
     1261   DEFINE RECTANGLE RECT-6
     1262        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1263        SIZE 79 BY 2.75.
     1264   DEFINE FRAME Dialog-Frame
     1265        Btn_OK AT ROW 1.25 COL 1.5
     1266        Btn_Cancel AT ROW 1.25 COL 11.5
     1267        b-help AT ROW 1.25 COL 71
     1268        rs-1 AT ROW 3.25 COL 3.5 NO-LABEL
     1269        ed-object AT ROW 3.25 COL 38 NO-LABEL
     1270        bt-sel-obj AT ROW 5.54 COL 33
     1271        rs-remote AT ROW 7.5 COL 3.5 NO-LABEL
     1272        rct-obj AT ROW 2.75 COL 2
     1273        RECT-6 AT ROW 7 COL 2
     1274        SPACE(0.37) SKIP(0.00)
     1275       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1276            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1277            TITLE "Параметры приема информации с касс по расписанию"
     1278            CANCEL-BUTTON Btn_Cancel.
     1279   ASSIGN
     1280          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1281          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1282   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1283   DO:
     1284     APPLY "END-ERROR":U TO SELF.
     1285   END.
     1286   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     1287   DO:
     1288     define variable v-exclude-obj-list     as character     no-undo.
     1289     assign
     1290       rs-1 :screen-value  = "3"
     1291     .
     1292   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   run userobjs_clear in this-procedure  .
     1294     define variable v-object-available as logical   no-undo .
     1295   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1297     (input  v-cntxt-db-num
     1298     ,input  0
     1299     ,input  v-cntxt-userid
     1300     ,input  v-cntxt-obj-type
     1301     ,input  v-cntxt-obj-code
     1302     ,output v-object-available
     1303     )  .
     1304     if v-object-available = true
     1305     then do:
     1306   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   run userobjs_append in this-procedure
     1308     (input  v-cntxt-obj-type
     1309     ,input  v-cntxt-obj-code
     1310     )  .
     1311     end.
     1312     define variable v-user-select as logical   no-undo .
     1313   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   run userobjs_select-many in this-procedure
     1315     (input  parparentproc
     1316     ,input  v-cntxt-db-num
     1317     ,input  v-cntxt-userid
     1318     ,input  v-cntxt-host-code-obj
     1319     ,input  v-cntxt-obj-type
     1320     ,input  v-cntxt-obj-code
     1321     ,output v-user-select
     1322     )  .
     1323     if v-user-select <> true
     1324     then do:
     1325       message
     1326         "Объект не выбран"
     1327         view-as alert-box information .
     1328       return no-apply .
     1329     end.
     1330     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1331     define variable v-store as integer   no-undo .
     1332     assign
     1333       v-store = 0
     1334     .
     1335     for each temp_obj-list :
     1336       delete temp_obj-list.
     1337     end.
     1338     for each buf_userobjs_temp-user-obj
     1339     on error undo, return no-apply
     1340     :
     1341       if buf_userobjs_temp-user-obj.obj-type = 'скл':U
     1342       then do:
     1343         assign
     1344           v-store = v-store + 1
     1345         .
     1346       end.
     1347       else do:
     1348         find first temp_obj-list where
     1349                 temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1350              and temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     1351         if not available temp_obj-list then do:
     1352           create temp_obj-list .
     1353           assign
     1354             temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1355             temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     1356           .
     1357         end.
     1358       end.
     1359     end.
     1360     if v-store > 0
     1361     then do:
     1362       message
     1363         substitute("Среди выбранных Вами объектов было &1 объекта типа &2 - ПРОПУЩЕНЫ"
     1364                   , v-store
     1365                   , 'скл':U
     1366                   )
     1367         view-as alert-box information .
     1368     end.
     1369     run select-objects-only-this-db in this-procedure
     1370       (output v-obj-list
     1371       ,output v-exclude-obj-list
     1372       ).
     1373       if v-exclude-obj-list <> ""
     1374       then do:
     1375           message
     1376               "Из списка выбранных объектов исключены"
     1377               skip "объекты, не принадлежащие БД, указанной в расписании:"
     1378               skip(1)
     1379               skip v-exclude-obj-list
     1380           view-as alert-box information.
     1381       end.
     1382       assign
     1383           ed-object :screen-value = v-obj-list
     1384       .
     1385   END.
     1386   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1387   DO:
     1388       assign
     1389           p-cancel = yes
     1390       .
     1391   END.
     1392   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1393   DO:
     1394       define variable v-obj-list as character     no-undo.
     1395       ASSIGN
     1396           rs-1
     1397           rs-remote
     1398       .
     1399       case rs-1
     1400       :
     1401       when 1
     1402       then do:
     1403           assign
     1404               v-obj-list = ""
     1405           .
     1406       end.
     1407       when 2
     1408       then do:
     1409           assign
     1410               v-obj-list = ""
     1411           .
     1412       end.
     1413       when 3
     1414       then do:
     1415           assign
     1416               v-obj-list = ""
     1417           .
     1418           for each temp_obj-list
     1419           :
     1420               assign
     1421                   v-obj-list = v-obj-list
     1422                           + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     1423                           + "," + string( temp_obj-list.obj-code )
     1424               .
     1425           end.
     1426       end.
     1427       end case.
     1428       find first temp_obj-list no-error.
     1429       if not available temp_obj-list
     1430       and rs-1 = 3
     1431       then do:
     1432           message
     1433               "Не выбраны объекты для приема информации с касс."
     1434           view-as alert-box warning.
     1435           undo, return no-apply.
     1436       end.
     1437       run attach-attr-to-schedule-line in this-procedure (
     1438             input rs-1
     1439           , input v-obj-list
     1440           , INPUT rs-remote
     1441       ).
     1442       APPLY "GO" TO FRAME Dialog-Frame.
     1443   END.
     1444   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     1445   DO:
     1446       assign
     1447           rs-1
     1448       .
     1449       run object-select in this-procedure (
     1450           input rs-1
     1451       ) .
     1452   END.
     1453   ON VALUE-CHANGED OF rs-remote IN FRAME Dialog-Frame
     1454   DO:
     1455        assign
     1456           rs-remote
     1457       .
     1458   END.
     1459   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1460   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1461   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1462   on help of frame Dialog-Frame
     1463   do:
     1464     run gbl/app_help.p
     1465       (input this-procedure :file-name
     1466       ,input ''
     1467       ,input ?
     1468       ) no-error.
     1469     if error-status :error then do:
     1470       message
     1471         "Ошибка при вызове помощи"
     1472         error-status :get-message(1)
     1473         view-as alert-box .
     1474     end.
     1475   end.
     1476   run minbtn-set in this-procedure .
     1477   on choose of b-help in frame Dialog-Frame
     1478   do:
     1479     apply "help":u to frame Dialog-Frame .
     1480   end.
     1481   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   procedure minbtn-set :
     1483       do
     1484           on error undo, return error return-value
     1485           :
     1486           define variable ii              as integer       no-undo .
     1487           define variable fh              as widget-handle no-undo .
     1488           define variable hh              as widget-handle no-undo .
     1489           define variable v-h             as handle        extent 4 no-undo .
     1490           define variable v-name-button   as character     no-undo .
     1491           define variable v-help-old-x    as decimal       no-undo .
     1492           define variable v-help-old-y    as decimal       no-undo .
     1493           define variable v-help-old-size as decimal       no-undo .
     1494           define variable v-frame-width   as decimal       no-undo .
     1495           define variable jj              as integer       no-undo .
     1496           do
     1497               on error undo, return error
     1498               :
     1499               assign
     1500                   v-frame-width = frame Dialog-Frame:width - 0.3
     1501                   fh            = frame Dialog-Frame:first-child
     1502                   hh            = fh:first-child
     1503                   ii            = 1
     1504                   .
     1505               do while valid-handle(hh):
     1506                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1507                   do:
     1508                       case lc(hh:name) :
     1509                           when "b-help" then
     1510                               do:
     1511                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1512                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1513                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1514                                   hh:TOOLTIP = "Помощь" .
     1515                                   v-help-old-x = hh:column .
     1516                                   v-help-old-y = hh:row    .
     1517                                   v-help-old-size = hh:width .
     1518                                   hh:width-chars = 2.5 .
     1519                               end.
     1520                           when "b-print" then
     1521                               do:
     1522                                   hh:load-image("cmp/b-print.bmp":u) .
     1523                                   hh:TOOLTIP = "Печать" .
     1524                                   v-h[ii] = hh:handle .
     1525                                   ii = ii + 1 .
     1526                                   hh:width-chars = 3 .
     1527                               end.
     1528                           when "b-history" or
     1529                           when "b-hist" then
     1530                               do:
     1531                                   hh:load-image("cmp/b-hist.bmp":u) .
     1532                                   hh:TOOLTIP = "История" .
     1533                                   v-h[ii] = hh:handle .
     1534                                   ii = ii + 1 .
     1535                                   hh:width-chars = 3 .
     1536                               end.
     1537                           when "b-sch" then
     1538                               do:
     1539                                   hh:load-image("cmp/b-sch.bmp":u) .
     1540                                   hh:TOOLTIP = "Установка Фильтра" .
     1541                                   v-h[ii] = hh:handle .
     1542                                   ii = ii + 1 .
     1543                                   hh:width-chars = 3 .
     1544                               end.
     1545                           when "b-hist-user" then
     1546                               do:
     1547                                   hh:load-image("cmp/b-hist.bmp":u) .
     1548                                   hh:TOOLTIP = "История пользователя" .
     1549                                   ii = ii + 1 .
     1550                               end.
     1551                       end case.
     1552                   end.
     1553                   hh = hh:next-sibling.
     1554               end.
     1555               b-help:column = v-frame-width - b-help:width-chars.
     1556               jj = 0.
     1557               repeat ii = 4 to 1 by -1 :
     1558                   if valid-handle (v-h[ii] ) then
     1559                   do:
     1560                       jj  = jj + 1 .
     1561                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1562                       v-h[ii]:row    = v-help-old-y .
     1563                   end.
     1564               end.
     1565           end.
     1566       end.
     1567   end procedure.
     1568   MAIN-BLOCK:
     1569   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1570      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1571       assign
     1572           frame Dialog-Frame :title = frame Dialog-Frame :title
     1573                       + ". " + p-task-type + ": Задача номер " + string( p-task-num )
     1574       .
     1575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576     run mainmenu_getcntxt in parparentproc
     1577       (output v-cntxt-db-num
     1578       ,output v-cntxt-userid
     1579       ,output v-cntxt-level
     1580       ,output v-cntxt-host-code-obj
     1581       ,output v-cntxt-obj-type
     1582       ,output v-cntxt-obj-code
     1583       ,output v-cntxt-db-num-obj
     1584       ,output v-cntxt-is-admin
     1585       ) .
     1586   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1588     (input  v-cntxt-obj-type
     1589     ,input  v-cntxt-obj-code
     1590     ,output v-host-code
     1591     ) no-error .
     1592       if error-status :error
     1593       then do:
     1594           message
     1595             vss-workfile vss-revision vss-description
     1596             skip "Ошибка при определении кода фирмы текущего объекта"
     1597             skip "Тип объекта:" v-cntxt-obj-type
     1598             skip "Код объекта:" v-cntxt-obj-code
     1599             skip "Выполнение приема информации с касс невозможно"
     1600             skip return-value
     1601             skip trim(error-status :get-message(1))
     1602                  trim(error-status :get-message(2))
     1603                  trim(error-status :get-message(3))
     1604           view-as alert-box error.
     1605           undo, return error.
     1606       end.
     1607       run get-host-name in this-procedure ( output v-host-name ) no-error .
     1608       if error-status :error
     1609       then do:
     1610           message
     1611             vss-workfile vss-revision vss-description
     1612             skip "Ошибка при определении имени фирмы"
     1613             skip "Код фирмы:" v-host-code
     1614             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-host-code ) + "'"
     1615             skip return-value
     1616             skip trim(error-status :get-message(1))
     1617                  trim(error-status :get-message(2))
     1618                  trim(error-status :get-message(3))
     1619           view-as alert-box warning.
     1620           assign
     1621               v-host-name = 'орг':U + string( v-host-code )
     1622           .
     1623       end.
     1624       run init-param-values in this-procedure (
     1625             input p-cre-db-num
     1626           , input p-task-type
     1627           , input p-task-num
     1628           , output v-obj-list
     1629           , output rs-1
     1630           , OUTPUT rs-remote
     1631       ).
     1632       run enable_UI.
     1633       run object-select in this-procedure (
     1634           input rs-1
     1635       ).
     1636       run init-fields in this-procedure .
     1637       WAIT-FOR GO OF FRAME Dialog-Frame.
     1638   END.
     1639   RUN disable_UI.
     1640   PROCEDURE attach-attr-to-schedule-line :
     1641   do
     1642   on error undo, return error
     1643   :
     1644       define input parameter p-rs-1               as integer      no-undo.
     1645       define input parameter p-object-list        as character    no-undo.
     1646       define input parameter p-rs-remote               as integer      no-undo.
     1647       define variable v-attr-value as character     no-undo.
     1648       define buffer buf_schedule      for ub.schedule.
     1649       define buffer buf_schedule-attr for ub.schedule-attr.
     1650       find first buf_schedule no-lock
     1651            where buf_schedule.cre-db-num = p-cre-db-num
     1652              and buf_schedule.task-type  = p-task-type
     1653              and buf_schedule.task-num   = p-task-num
     1654       no-error.
     1655       if not available buf_schedule
     1656       and (  p-task-type   <> 'autogcd':U
     1657           or p-task-num    <> -1 )
     1658       then do:
     1659           message
     1660             vss-workfile vss-revision vss-description
     1661             skip "Не найдена строка расписания."
     1662             skip return-value
     1663             skip trim(error-status :get-message(1))
     1664                  trim(error-status :get-message(2))
     1665                  trim(error-status :get-message(3))
     1666           view-as alert-box error.
     1667           undo, return error .
     1668       end.
     1669       assign
     1670           v-attr-value = string( p-rs-1 )
     1671                          + "," + string( v-cntxt-host-code-obj )
     1672                          + "," + string( p-rs-remote )
     1673       .
     1674       run schedule-attr-write in this-procedure (
     1675             input p-cre-db-num
     1676           , input p-task-type
     1677           , input p-task-num
     1678           , input 'schedule-param-list':U
     1679           , input v-attr-value
     1680       ).
     1681       run schedule-attr-write in this-procedure (
     1682             input p-cre-db-num
     1683           , input p-task-type
     1684           , input p-task-num
     1685           , input 'schedule-obj-list':U
     1686           , input p-object-list
     1687       ).
     1688       for each buf_schedule-attr
     1689       on error undo, return error
     1690       :
     1691           if buf_schedule-attr.cre-db-num <> p-cre-db-num
     1692           or buf_schedule-attr.task-type  <> 'autogcd':U
     1693           or buf_schedule-attr.task-num   <> -1
     1694           or (
     1695                   buf_schedule-attr.attr-code <> 'schedule-param-list':U
     1696               and buf_schedule-attr.attr-code <> 'schedule-obj-list':U
     1697   )
     1698           then do:
     1699               find first buf_schedule
     1700                    where buf_schedule.cre-db-num = buf_schedule-attr.cre-db-num
     1701                      and buf_schedule.task-type  = buf_schedule-attr.task-type
     1702                      and buf_schedule.task-num   = buf_schedule-attr.task-num
     1703               no-error.
     1704               if not available buf_schedule
     1705               then do:
     1706                   delete buf_schedule-attr.
     1707               end.
     1708           end.
     1709       end.
     1710   end.
     1711   END PROCEDURE.
     1712   PROCEDURE disable_UI :
     1713     HIDE FRAME Dialog-Frame.
     1714   END PROCEDURE.
     1715   PROCEDURE enable_UI :
     1716     DISPLAY rs-1 ed-object rs-remote
     1717         WITH FRAME Dialog-Frame.
     1718     ENABLE rct-obj RECT-6 Btn_OK Btn_Cancel b-help rs-1 bt-sel-obj rs-remote
     1719         WITH FRAME Dialog-Frame.
     1720     VIEW FRAME Dialog-Frame.
     1721   END PROCEDURE.
     1722   PROCEDURE get-host-name :
     1723   do
     1724   on error undo, return error
     1725   :
     1726   define output parameter p-host-name as character    no-undo.
     1727   define buffer buf_clients   for ub.clients.
     1728       find first buf_clients no-lock
     1729            where buf_clients.obj-type = 'орг':U
     1730              and buf_clients.obj-code = v-host-code
     1731       no-error.
     1732       if not available buf_clients
     1733       then do:
     1734           message
     1735             vss-workfile vss-revision vss-description
     1736             skip "Не удалось найти текущую фирму"
     1737             skip return-value
     1738             skip trim(error-status :get-message(1))
     1739                  trim(error-status :get-message(2))
     1740                  trim(error-status :get-message(3))
     1741                  trim(error-status :get-message(4))
     1742                  trim(error-status :get-message(5))
     1743           view-as alert-box error.
     1744           undo, return error .
     1745       end.
     1746       else do:
     1747           assign
     1748               p-host-name = buf_clients.obj-name
     1749           .
     1750       end.
     1751   end.
     1752   END PROCEDURE.
     1753   PROCEDURE init-fields :
     1754   do
     1755   on error undo, return error
     1756   :
     1757       define variable v-oper-num     as integer           no-undo.
     1758       run manage-options          in this-procedure.
     1759   end.
     1760   END PROCEDURE.
     1761   PROCEDURE init-param-values :
     1762   do
     1763   on error undo, return error
     1764   :
     1765   define input parameter p-cre-db-num             as integer      no-undo .
     1766   define input parameter p-task-type              as character    no-undo.
     1767   define input parameter p-task-num               as integer      no-undo.
     1768   define output parameter p-obj-list              as character    no-undo.
     1769   define output parameter p-rs-1                  as integer      no-undo.
     1770   define output parameter p-rs-remote             as integer      no-undo.
     1771       define variable v-counter       as integer       no-undo.
     1772       define variable v-param-list    as character     no-undo.
     1773       run schedule-attr-value in this-procedure (
     1774             input p-cre-db-num
     1775           , input p-task-type
     1776           , input p-task-num
     1777           , input 'schedule-obj-list':U
     1778           , output p-obj-list
     1779           , output v-param-type
     1780       ) .
     1781       for each temp_obj-list
     1782       :
     1783           delete temp_obj-list.
     1784       end.
     1785       do v-counter = 1 to num-entries( p-obj-list ) / 2
     1786       :
     1787           create temp_obj-list.
     1788           assign
     1789               temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-obj-list )
     1790               temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-obj-list ) )
     1791           .
     1792       end.
     1793       run schedule-attr-value in this-procedure (
     1794             input p-cre-db-num
     1795           , input p-task-type
     1796           , input p-task-num
     1797           , input 'schedule-param-list':U
     1798           , output v-param-list
     1799           , output v-param-type
     1800       ) .
     1801       if v-param-list = ""
     1802       then do:
     1803           assign
     1804               p-rs-1                  = 1
     1805               p-rs-remote             = 0
     1806           .
     1807       end.
     1808       else do:
     1809           assign
     1810               p-rs-1 = integer( entry( 1, v-param-list ) )
     1811               p-rs-remote = integer( entry( 3, v-param-list ) )
     1812           .
     1813       end.
     1814   end.
     1815   END PROCEDURE.
     1816   PROCEDURE manage-options :
     1817   do
     1818   on error undo, return error
     1819   :
     1820   assign
     1821       rct-obj             :visible in frame Dialog-Frame = yes
     1822       rs-1                :visible in frame Dialog-Frame = yes
     1823       bt-sel-obj          :visible in frame Dialog-Frame = yes
     1824       ed-object           :visible in frame Dialog-Frame = yes
     1825   .
     1826   run object-select in this-procedure (
     1827       input rs-1
     1828   ).
     1829   end.
     1830   END PROCEDURE.
     1831   PROCEDURE object-select :
     1832   do
     1833   on error undo, return error
     1834   :
     1835   define input parameter p-rs-1   as integer      no-undo.
     1836   case p-rs-1
     1837   :
     1838       when 1
     1839       then do:
     1840           assign
     1841               ed-object :screen-value in frame Dialog-frame = "Все объекты БД"
     1842           .
     1843       end.
     1844       when 2
     1845       then do:
     1846           assign
     1847               ed-object :screen-value = v-host-name
     1848           .
     1849       end.
     1850       when 3
     1851       then do:
     1852           assign
     1853               ed-object :screen-value = ""
     1854           .
     1855           for each temp_obj-list
     1856           :
     1857               assign
     1858                   ed-object :screen-value = ed-object :screen-value
     1859                       + ( if ed-object :screen-value = "" then "" else ", " )
     1860                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code )
     1861               .
     1862           end.
     1863       end.
     1864   end case.
     1865   end.
     1866   END PROCEDURE.
     1867   PROCEDURE select-objects-only-this-db :
     1868   do
     1869   on error undo, return error
     1870   :
     1871   define output parameter p-only-this-db-obj-list as character    no-undo.
     1872   define output parameter p-exclude-obj-list      as character    no-undo.
     1873       define variable v-db-num                as integer       no-undo.
     1874       define variable v-obj-type              as character     no-undo.
     1875       define variable v-obj-code              as integer       no-undo.
     1876       define buffer buf_clients       for ub.clients.
     1877       define buffer buf_temp_obj-list for temp_obj-list.
     1878       define buffer buf_schedule for ub.schedule.
     1879       assign
     1880           p-only-this-db-obj-list = ""
     1881           p-exclude-obj-list      = ""
     1882       .
     1883       if p-task-num > 0 then do:
     1884         find first buf_schedule no-lock where
     1885                   buf_schedule.cre-db-num = p-cre-db-num
     1886               and buf_schedule.task-type = p-task-type
     1887               and buf_schedule.task-num = p-task-num no-error.
     1888         if not available buf_schedule then do:
     1889           undo, return error .
     1890         end.
     1891         assign
     1892         v-db-num = ( if buf_schedule.db-num-char = "*" then -10 else integer( buf_schedule.db-num-char ) )
     1893         .
     1894       end.
     1895       else do:
     1896         v-db-num = v-cntxt-db-num.
     1897       end.
     1898       for each buf_temp_obj-list:
     1899           find first buf_clients no-lock
     1900                   where buf_clients.obj-type = buf_temp_obj-list.obj-type
     1901                   and buf_clients.obj-code = buf_temp_obj-list.obj-code
     1902           .
     1903           if buf_schedule.db-num-char = "*"
     1904           or buf_clients.db-num = v-db-num
     1905           then do:
     1906               assign
     1907                   p-only-this-db-obj-list = p-only-this-db-obj-list
     1908                                           + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     1909                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     1910               .
     1911           end.
     1912           else do:
     1913               assign
     1914                   p-exclude-obj-list = p-exclude-obj-list
     1915                                           + ( if p-exclude-obj-list <> "" then ", " else "" )
     1916                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     1917               .
     1918               delete buf_temp_obj-list.
     1919           end.
     1920       end.
     1921   end.
     1922   END PROCEDURE.
