      117   function diff-list returns character (
      118     input parfirst-list  as character,
      119     input parsecond-list as character,
      120     input pardelim       as character).
      121     if pardelim = ""
      122     or pardelim = ?
      123     then do:
      124       assign
      125         pardelim = ","
      126       .
      127     end.
      128     def var ind as integer no-undo .
      129     def var v-elem as character no-undo .
      130     def var v-result-list as character no-undo init "".
      131     def var v-num-parfirst-list as integer no-undo .
      132     assign
      133       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      134     .
      135     do ind = 1 to v-num-parfirst-list
      136     :
      137       assign
      138         v-elem = entry(ind, parfirst-list, pardelim)
      139       .
      140       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      141         assign
      142           v-result-list = v-result-list
      143                         + (if v-result-list > "" then pardelim else "")
      144                         + v-elem
      145         .
      146       end.
      147     end.
      148     return v-result-list .
      149   end function.
      150   function add-list returns character (
      151    input parfirst-list  as character,
      152    input parsecond-list as character,
      153    input pardelim       as character).
      154     if pardelim = ""
      155     or pardelim = ?
      156     then do:
      157       assign
      158         pardelim = ","
      159       .
      160     end.
      161     def var ind as integer no-undo .
      162     def var v-elem as character no-undo .
      163     def var v-result-list as character no-undo init "".
      164     def var v-num-parfirst-list as integer no-undo .
      165     assign
      166       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      167     .
      168     do ind = 1 to v-num-parfirst-list
      169     :
      170       assign
      171         v-elem = entry(ind, parfirst-list, pardelim)
      172       .
      173       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      174         assign
      175           v-result-list = v-result-list
      176                         + (if v-result-list > "" then pardelim else "")
      177                         + v-elem
      178         .
      179       end.
      180     end.
      181     def var v-num-parsecond-list as integer no-undo .
      182     assign
      183       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      184     .
      185     do ind = 1 to v-num-parsecond-list
      186     :
      187       assign
      188         v-elem = entry(ind, parsecond-list, pardelim)
      189       .
      190       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      191         assign
      192           v-result-list = v-result-list
      193                         + (if v-result-list > "" then pardelim else "")
      194                         + v-elem
      195         .
      196       end.
      197     end.
      198     return v-result-list .
      199   end function.
      200   function cross-list returns character (
      201    input parfirst-list  as character,
      202    input parsecond-list as character,
      203    input pardelim       as character).
      204     if pardelim = ""
      205     or pardelim = ?
      206     then do:
      207       assign
      208         pardelim = ","
      209       .
      210     end.
      211     def var ind as integer no-undo .
      212     def var v-elem as character no-undo .
      213     def var v-result-list as character no-undo init "".
      214     def var v-num-parfirst-list as integer no-undo .
      215     assign
      216       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      217     .
      218     do ind = 1 to v-num-parfirst-list
      219     :
      220       assign
      221         v-elem = entry(ind, parfirst-list, pardelim)
      222       .
      223       if lookup(v-elem, v-result-list, pardelim) = 0
      224       and lookup(v-elem, parsecond-list, pardelim) > 0
      225       then do:
      226         assign
      227           v-result-list = v-result-list
      228                         + (if v-result-list > "" then pardelim else "")
      229                         + v-elem
      230         .
      231       end.
      232     end.
      233     return v-result-list .
      234   end function.
      235   function radio-label returns character (
      236    input par-rs-value  as character,
      237    input par-rs-radio-buttons as character)
      238    .
      239    DEFINE variable v-result-label as character no-undo.
      240    assign
      241    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      242                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      243                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      244                             ), par-rs-radio-buttons
      245                           )
      246    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      247    .
      248   return v-result-label.
      249   end function.
      250   function m-radio-label returns character (
      251    input par-rs-value  as character,
      252    input par-rs-radio-buttons as character,
      253    input par-delim as character
      254    )
      255    .
      256    DEFINE variable v-result-label as character no-undo.
      257    assign
      258    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      259                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      260                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      261                             ), par-rs-radio-buttons, par-delim
      262                           )
      263    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      264    .
      265   return v-result-label.
      266   end function.
      267   FUNCTION mixlist returns character
      268   (
      269    input parfirst-list  as character
      270    ,input parsecond-list as character
      271    ,input pardelim       as character
      272    ,input pardelim-result as character ) :
      273     if pardelim = ""
      274     or pardelim = ?
      275     then do:
      276       assign
      277         pardelim = ","
      278       .
      279     end.
      280     def var ind as integer no-undo .
      281     def var v-elem1 as character no-undo .
      282     def var v-elem2 as character no-undo .
      283     def var v-result-list as character no-undo init "".
      284     do ind = 1 to num-entries(parfirst-list, pardelim)
      285     :
      286       assign
      287         v-elem1 = entry(ind, parfirst-list, pardelim)
      288         v-elem2 = entry(ind, parsecond-list, pardelim)
      289       .
      290         assign
      291           v-result-list = v-result-list
      292                         + (if v-result-list > "" then pardelim-result else "")
      293                         + v-elem1 + pardelim-result + v-elem2
      294         .
      295     end.
      296     return v-result-list .
      297   END FUNCTION.
      298   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   procedure cur-time :
      300      define output parameter p-today as date      no-undo .
      301      define output parameter p-time  as integer   no-undo .
      302     do
      303     on error undo, return error
      304     :
      305       define variable v-date1 as date      no-undo .
      306       define variable v-date2 as date      no-undo .
      307       define variable v-time  as integer   no-undo .
      308       assign
      309         v-date1 = today
      310         v-time  = time
      311         v-date2 = today
      312       .
      313       if v-date1 <> v-date2
      314       then do:
      315         assign
      316           v-date1 = today
      317           v-time  = v-time
      318         .
      319       end.
      320       assign
      321         p-today = v-date1
      322         p-time  = v-time
      323       .
      324     end.
      325   end.
      326   function cur-time-date returns character
      327   :
      328     return string(today, '99/99/9999':U) .
      329   end.
      330   function cur-time-mjd returns decimal
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return integer(v-date) - 2400002 + (v-time / 86400) .
      339   end.
      340   function cur-time-get-ending-index returns integer
      341   (input p-number as integer
      342   )
      343   :
      344     if p-number < 0
      345     or p-number = ?
      346     then do:
      347       return 1 .
      348     end.
      349     define variable v-rest as integer   no-undo .
      350     assign
      351       p-number = p-number modulo 100
      352     .
      353     if p-number < 20
      354     then do:
      355       assign
      356         v-rest = p-number
      357       .
      358     end.
      359     else do:
      360       assign
      361         v-rest = p-number modulo 10
      362       .
      363     end.
      364     case v-rest :
      365       when 1
      366       then do:
      367         return 2 .
      368       end.
      369       when 2 or
      370       when 3 or
      371       when 4
      372       then do:
      373         return 3 .
      374       end.
      375       otherwise do:
      376         return 1 .
      377       end.
      378     end case .
      379   end.
      380   procedure cur-time-mjd-to-date :
      381      define input  parameter i-mjd-diff as decimal no-undo.
      382      define output parameter o-Date     as date    no-undo.
      383      define output parameter o-Time     as integer no-undo.
      384      define variable v-day-number as integer   no-undo .
      385      if    i-mjd-diff < 0
      386         or i-mjd-diff = ?
      387      then do:
      388         return "?" .
      389      end.
      390      assign
      391         v-day-number = truncate(i-mjd-diff,0).
      392         o-Date = date(v-day-number + 2400002).
      393         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      394     .
      395   end.
      396   function cur-time-mjd-to-string returns character
      397   (input p-mjd-diff as decimal
      398   )
      399   :
      400     define variable v-day-number as integer   no-undo .
      401     define variable v-seconds    as integer   no-undo .
      402     define variable v-hour       as integer   no-undo .
      403     define variable v-min        as integer   no-undo .
      404     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      405     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      406     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      407     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      408     if p-mjd-diff < 0
      409     or p-mjd-diff = ?
      410     then do:
      411       return "?" .
      412     end.
      413     assign
      414       v-day-number = integer(truncate(p-mjd-diff,0))
      415       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      416     .
      417     if v-seconds > 86400
      418     then do:
      419       assign
      420         v-seconds = 86400 - 1
      421       .
      422     end.
      423     if v-seconds < 0
      424     then do:
      425       assign
      426         v-seconds = 0
      427       .
      428     end.
      429     assign
      430       v-hour = truncate(v-seconds / 3600, 0)
      431     .
      432     assign
      433       v-seconds = v-seconds modulo 3600
      434     .
      435     assign
      436       v-min = truncate(v-seconds / 60, 0)
      437     .
      438     assign
      439       v-seconds = v-seconds modulo 60
      440     .
      441     return
      442         (if v-day-number <> 0
      443           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      444           else ""
      445         )
      446       + (if v-day-number <> 0 or v-hour <> 0
      447           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      448           else ""
      449         )
      450       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      451           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      452           else ""
      453         )
      454       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      455       .
      456   end.
      457   function cur-time-string returns character
      458   :
      459     define variable v-date as date      no-undo .
      460     define variable v-time as integer   no-undo .
      461     run cur-time in this-procedure
      462       (output v-date
      463       ,output v-time
      464       ) .
      465     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      466   end.
      467   function cur-time-string-sec returns character
      468   :
      469     define variable v-date as date      no-undo .
      470     define variable v-time as integer   no-undo .
      471     run cur-time in this-procedure
      472       (output v-date
      473       ,output v-time
      474       ) .
      475     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      476   end.
      477   function cur-time-custom  returns character
      478   (input p-prefix as character
      479   ,input p-date-format as character
      480   ,input p-delimiter as character
      481   ,input p-time-format as character
      482   ,input p-suffix as character
      483   )
      484   :
      485     define variable v-date as date      no-undo .
      486     define variable v-time as integer   no-undo .
      487     run cur-time in this-procedure
      488       (output v-date
      489       ,output v-time
      490       ) .
      491     return
      492       p-prefix
      493       + string(v-date, p-date-format)
      494       + p-delimiter
      495       + string(v-time, p-time-format)
      496       + p-suffix
      497       .
      498   end.
      499   function cur-time-print  returns character
      500   :
      501     define variable v-date as date      no-undo .
      502     define variable v-time as integer   no-undo .
      503     run cur-time in this-procedure
      504       (output v-date
      505       ,output v-time
      506       ) .
      507     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      508   end.
      509   function cur-time-datetime returns datetime
      510   :
      511     define variable v-char as character no-undo .
      512     define variable v-datetime as datetime no-undo .
      513     v-char = cur-time-string().
      514     v-datetime = datetime(v-char).
      515     return  v-datetime.
      516   end.
      517   function cur-time-string-msec returns character
      518   :
      519     define variable v-date as datetime  no-undo .
      520     v-date = now.
      521     return string(v-date) .
      522   end.
      523   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524     define variable v-cntxt-db-num        as integer   no-undo .
      525     define variable v-cntxt-userid        as character no-undo .
      526     define variable v-cntxt-level         as character no-undo .
      527     define variable v-cntxt-host-code-obj as integer   no-undo .
      528     define variable v-cntxt-obj-type      as character no-undo .
      529     define variable v-cntxt-obj-code      as integer   no-undo .
      530     define variable v-cntxt-db-num-obj    as integer   no-undo .
      531     define variable v-cntxt-is-admin      as logical   no-undo .
      532   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   define temp-table userobjs_temp-user-obj no-undo
      534     field obj-type as character
      535     field obj-code as integer
      536     index xpk is primary unique obj-type obj-code
      537     .
      538   procedure userobjs_clear :
      539     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      540     do
      541     on error undo, return error return-value
      542     :
      543       for each buf_userobjs_temp-user-obj
      544       on error undo, return error return-value
      545       :
      546         delete buf_userobjs_temp-user-obj .
      547       end.
      548     end.
      549   end .
      550   procedure userobjs_object-count :
      551     define output parameter p-total-count as integer   no-undo .
      552     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      553     do
      554     on error undo, return error return-value
      555     :
      556       assign
      557         p-total-count = 0
      558       .
      559       for each buf_userobjs_temp-user-obj
      560       on error undo, return error return-value
      561       :
      562         assign
      563           p-total-count = p-total-count + 1
      564         .
      565       end.
      566     end.
      567   end.
      568   procedure userobjs_append :
      569      define input  parameter p-obj-type as character no-undo .
      570      define input  parameter p-obj-code as integer   no-undo .
      571     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      572     do
      573     on error undo, return error return-value
      574     :
      575       find first buf_userobjs_temp-user-obj
      576         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      577           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      578         no-error .
      579       if not available buf_userobjs_temp-user-obj
      580       then do:
      581         create buf_userobjs_temp-user-obj .
      582         assign
      583           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      584           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      585         .
      586       end.
      587     end.
      588   end.
      589   procedure userobjs_object-exist :
      590     define output parameter p-object-exist as logical   no-undo .
      591     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      592     do
      593     on error undo, return error return-value
      594     :
      595       find first buf_userobjs_temp-user-obj
      596         no-error .
      597       if not available buf_userobjs_temp-user-obj
      598       then do:
      599         assign
      600           p-object-exist = false
      601         .
      602       end.
      603       else do:
      604         assign
      605           p-object-exist = true
      606         .
      607       end.
      608     end.
      609   end.
      610   procedure userobjs_transfer :
      611     define input  parameter p-callback-handle as handle no-undo .
      612     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      613     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      614     do
      615     on error undo, return error return-value
      616     :
      617       if valid-handle(p-callback-handle) <> true
      618       then do:
      619         message
      620           vss-workfile vss-revision vss-description skip
      621           "Ошибка задания входных параметров" skip
      622           "Неизвестный указатель на процедуру" skip
      623           view-as alert-box error .
      624         undo, return error return-value .
      625       end.
      626       if p-callback-handle :get-signature("userobjs_append") = ""
      627       then do:
      628         message
      629           vss-workfile vss-revision vss-description skip
      630           "Ошибка задания входных параметров" skip
      631           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      632                     ,p-callback-handle :file-name
      633                     ) skip
      634           view-as alert-box error .
      635         undo, return error return-value .
      636       end.
      637       for each buf_userobjs_temp-user-obj
      638       on error undo, return error return-value
      639       :
      640         run userobjs_append in p-callback-handle
      641           (input  buf_userobjs_temp-user-obj.obj-type
      642           ,input  buf_userobjs_temp-user-obj.obj-code
      643           ) .
      644       end.
      645     end.
      646   end procedure.
      647   procedure userobjs_select-one :
      648      define input  parameter parparentproc     as widget-handle no-undo .
      649      define input  parameter p-db-num          as integer   no-undo .
      650      define input  parameter p-user-id         as character no-undo .
      651      define input  parameter p-host-code-obj   as integer   no-undo .
      652      define input  parameter p-obj-type        as character no-undo .
      653      define input  parameter p-obj-code        as integer   no-undo .
      654      define output parameter p-user-select     as logical   no-undo .
      655      define output parameter p-select-obj-type as character no-undo .
      656      define output parameter p-select-obj-code as character no-undo .
