      661         (input  parparentproc
      662         ,input  this-procedure :handle
      663         ,input  p-db-num
      664         ,input  p-user-id
      665         ,input  p-host-code-obj
      666         ,input  p-obj-type
      667         ,input  p-obj-code
      668         ,INPUT  "b-sel"
      669         ,output p-user-select
      670         ,output p-select-obj-type
      671         ,output p-select-obj-code
      672         ) .
