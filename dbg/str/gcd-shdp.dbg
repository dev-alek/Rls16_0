      679     define input  parameter p-host-code-obj as integer   no-undo .
      680     define input  parameter p-obj-type      as character no-undo .
      681     define input  parameter p-obj-code      as integer   no-undo .
      682     define output parameter p-user-select   as logical   no-undo .
      683     define variable v-select-obj-type as character no-undo .
