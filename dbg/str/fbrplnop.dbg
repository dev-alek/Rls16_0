        1   block-level on error undo, throw.
        2   define input parameter p-doc-code   as character    no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: fbrplnop.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/fbrplnop.p $":U .
        8   define variable vss-description as character no-undo init "ќткрытие документа план-меню".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67       define temp-table temp_fbr-objects no-undo
       68           field obj-type  as character
       69           field obj-code  as integer
       70           index pi is primary unique obj-type obj-code
       71       .
       72       define buffer buf_fbr-pln               for fbr-pln.
       73       define buffer buf_fbr-pln-line          for fbr-pln-line.
       74       define buffer buf_fbr-doc               for fbr-doc.
       75       define buffer buf_trn-doc               for trn-doc.
       76       define buffer buf_doc-line              for doc-line.
       77       define buffer buf_del_fbr-line          for fbr-line.
       78       define buffer buf_del_fbr-doc           for fbr-doc.
       79       define buffer buf_del_fbr-recipe        for fbr-recipe.
       80       define buffer buf_del_fbr-recipe-gds    for fbr-recipe-gds.
       81       define buffer buf_fbr-recipe            for fbr-recipe.
       82       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
       83   do
       84   for buf_fbr-pln
       85     , buf_fbr-pln-line
       86     , buf_fbr-doc
       87     , buf_trn-doc
       88     , buf_doc-line
       89     , buf_del_fbr-line
       90     , buf_del_fbr-doc
       91     , buf_del_fbr-recipe
       92     , buf_del_fbr-recipe-gds
       93     , buf_fbr-recipe
       94     , buf_fbr-recipe-gds
       95   on error undo, return error
       96   :
       97   if session :set-wait-state( "compiler" ) then.
       98       for each temp_fbr-objects
       99       on error undo, return error
      100       :
      101           delete temp_fbr-objects.
      102       end.
      103       for each buf_fbr-pln-line no-lock
      104          where buf_fbr-pln-line.doc-code     = p-doc-code
      105       on error undo, return error
      106       :
      107           find first temp_fbr-objects
      108                where temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
      109                  and temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
      110           no-error.
      111           if not available temp_fbr-objects
      112           then do:
      113               create temp_fbr-objects.
      114               assign
      115                   temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
      116                   temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
      117               .
      118           end.
      119       end.
      120       do transaction
      121       on error undo, return error
      122       :
      123           find first buf_fbr-pln exclusive-lock
      124                where buf_fbr-pln.doc-code = p-doc-code
      125           .
      126           if buf_fbr-pln.status_ <> 'разрешен':U
      127           then do:
      128               message
      129                   "ћожно открыть документ только в статусе разр."
      130               view-as alert-box error.
      131               undo, return error .
      132           end.
      133           for each temp_fbr-objects
      134           on error undo, return error
      135           :
      136               for each buf_fbr-doc no-lock
      137                  where buf_fbr-doc.out-code = p-doc-code
      138               on error undo, return error
      139               :
      140                   for each buf_trn-doc exclusive-lock
      141                       where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      142                   :
      143                       if buf_trn-doc.ext-doc-type = 'ev':U
      144                       and buf_trn-doc.status_     = 'запрос':U
      145                       then do:
      146                           for each buf_doc-line exclusive-lock
      147                              where buf_doc-line.doc-code = buf_trn-doc.doc-code
      148                           :
      149                               delete buf_doc-line.
      150                           end.
      151                           delete buf_trn-doc.
      152                       end.
      153                   end.
      154                   for each buf_fbr-recipe-gds no-lock
      155                      where buf_fbr-recipe-gds.doc-code      = buf_fbr-doc.doc-code
      156                   :
      157                       find first buf_del_fbr-recipe-gds exclusive-lock
      158                            where recid( buf_del_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
      159                       .
      160                       delete buf_del_fbr-recipe-gds.
      161                   end.
      162                   for each buf_fbr-recipe no-lock
      163                      where buf_fbr-recipe.doc-code      = buf_fbr-doc.doc-code
      164                   :
      165                       find first buf_del_fbr-recipe exclusive-lock
      166                            where recid( buf_del_fbr-recipe ) = recid( buf_fbr-recipe )
      167                       .
      168                       delete buf_del_fbr-recipe.
      169                   end.
      170                   for each fbr-line no-lock
      171                      where fbr-line.doc-code = buf_fbr-doc.doc-code
      172                   :
      173                       find first buf_del_fbr-line exclusive-lock
      174                            where recid( buf_del_fbr-line ) = recid( fbr-line )
      175                       .
      176                       delete buf_del_fbr-line.
      177                   end.
      178                   find first buf_del_fbr-doc exclusive-lock
      179                        where recid( buf_del_fbr-doc ) = recid( buf_fbr-doc )
      180                   .
      181                   delete buf_del_fbr-doc.
      182               end.
      183           end.
      184           assign
      185               buf_fbr-pln.status_ = 'новый':U
      186           .
      187       end.
      188   if session :set-wait-state( "" ) then.
      189   end.
