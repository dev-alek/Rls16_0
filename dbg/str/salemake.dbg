     1862                                               ) no-error .
     1863       if error-status:error then do:
     1864         v-mes = substitute("Ошибка при генерации записи связанного документа для расходной накладной по продаже &4:&1&2 &3"
     1865                           , chr(10)
     1866                           , error-status:get-message(1)
     1867                           , return-value
     1868                           , vardoc-code
     1869                           ).
     1870         undo, return error v-mes.
     1871       end.
     1872   end.
     1873   end procedure.
     1874   define variable v-input-error as logical no-undo .
     1875   define variable v-view-log as logical no-undo .
     1876   define variable v-esm as character no-undo .
     1877   define variable log-file-name as character no-undo init 'ext-sale.log'.
     1878   define shared temp-table temp-inkas no-undo like ub.inkas.
     1879   if num-entries(p-parameter, chr(4)) <> 5
     1880   then do:
     1881     assign
     1882     v-input-error = yes
     1883     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 5"
     1884                                , num-entries(p-parameter, chr(4))).
     1885     .
     1886   end.
     1887   else do:
     1888     assign
     1889     p-curr-obj-type = entry(1, p-parameter, chr(4))
     1890     p-curr-obj-code = integer(entry(2, p-parameter, chr(4)))
     1891     p-cre-db-num    = integer(entry(3, p-parameter, chr(4)))
     1892     p-task-type     = entry(4, p-parameter, chr(4))
     1893     p-task-num      = integer(entry(5, p-parameter, chr(4)))
     1894     no-error .
     1895     if error-status:error then do:
     1896       assign
     1897       v-esm = error-status:get-message(1)
     1898       v-input-error = yes
     1899       .
     1900     end.
     1901   end.
     1902   if v-input-error = yes then do:
     1903     run write-log-and-file in p-log-handle (
     1904           input 1
     1905         , input log-file-name
     1906         , input 1
     1907         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1908                            , p-parameter
     1909                            , chr(10)
     1910                            , v-esm
     1911                            , return-value
     1912                            )).
     1913     assign
     1914     v-view-log = yes.
     1915     return.
     1916   end.
     1917   run proc-main in this-procedure no-error .
     1918   if error-status:error then do:
     1919     run write-log-and-file in p-log-handle (
     1920           input 1
     1921         , input log-file-name
     1922         , input 1
     1923         , input substitute("Ошибка при создании продаж по шаблонам - задача &1 &2&3:&4&5 &6"
     1924                            , p-task-num
     1925                            ,  p-curr-obj-type
     1926                            ,  p-curr-obj-code
     1927                            , chr(10)
     1928                            , error-status:get-message(1)
     1929                            , return-value
     1930                            )).
     1931     assign
     1932     v-view-log = yes.
     1933     .
     1934     return "error":U.
     1935   end.
     1936   procedure proc-main :
     1937   define variable v-shift-date-str as character no-undo.
     1938   define variable v-shift-date-str-rus as character no-undo.
     1939   define variable v-shift-date     as date no-undo .
     1940   define variable v-shift-num      as integer no-undo.
     1941   define variable v-filter-str     as character no-undo .
     1942   define variable v-filter-str-rus as character no-undo .
     1943   define variable v-filter-name    as character no-undo .
     1944   define variable v-create         as logical no-undo .
     1945   DEFINE VARIABLE v-time           as integer no-undo .
     1946   define variable v-dop            as character no-undo .
     1947   define variable v-dop1           as character no-undo .
     1948   define variable v-dop2           as character no-undo .
     1949   define variable v-dop3           as character no-undo .
     1950   define variable v-dop-int        as integer   no-undo .
     1951   define variable v-today          as date      no-undo .
     1952   define variable v-filter-on      as logical no-undo .
     1953   define variable cas-shft         as logical no-undo .
     1954   define variable conf-attr        as character no-undo.
     1955   define variable conf-par         as character no-undo.
     1956   define variable par-type         as character no-undo.
     1957   define variable v-where-phrase   as character no-undo .
     1958   define variable v-where-phrase-rus as character no-undo .
     1959   define variable v-rid            as recid no-undo .
     1960   define buffer buf_schedule-attr for ub.schedule-attr.
     1961   define buffer buf2_schedule-attr for ub.schedule-attr.
     1962   define buffer buf_inkas for ub.inkas.
     1963   define buffer buf_doc-attr for ub.doc-attr.
     1964     do
     1965     on error undo, return error return-value
     1966     :
     1967       run cur-time in this-procedure (output v-today, output v-time).
     1968   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   define variable v-param-type14 as character no-undo .
     1970   define variable v-value-character14 as character no-undo .
     1971   define variable v-value-date14 as date no-undo .
     1972   define variable v-value-decimal14 as decimal no-undo .
     1973   define variable v-value-integer14 as INTEGER no-undo .
     1974   define variable v-tth14 as handle no-undo .
     1975   run adm/shattri.p (
     1976       input "get":U
     1977       ,input  p-curr-obj-type
     1978       ,input  p-curr-obj-code
     1979       ,input  'get-chk':U
     1980       ,input  'cas-shft':U
     1981       ,output v-value-character14
     1982       ,output v-value-date14
     1983       ,output v-value-decimal14
     1984       ,output v-value-integer14
     1985       ,output cas-shft
     1986       ,output v-param-type14
     1987       ,INPUT-OUTPUT table-handle v-tth14
     1988       )  .
     1989   delete object v-tth14.
     1990       _buf_schedule-attr:
     1991       for each buf_schedule-attr where
     1992               buf_schedule-attr.cre-db-num = p-cre-db-num
     1993           AND buf_schedule-attr.task-type = 'autosale':U
     1994           AND buf_schedule-attr.task-num = p-task-num
     1995           and buf_schedule-attr.attr-code begins ('schedule-date-list':U + chr(4)):
     1996          find first buf2_schedule-attr no-lock where
     1997               buf2_schedule-attr.cre-db-num = p-cre-db-num
     1998           AND buf2_schedule-attr.task-type = 'autosale':U
     1999           AND buf2_schedule-attr.task-num = p-task-num
     2000           and buf2_schedule-attr.attr-code =
     2001              ('schedule-filter':U + chr(4) +
     2002              string(integer(entry(2, buf_schedule-attr.attr-code, chr(4))))
     2003              ) no-error.
     2004          assign
     2005          v-create = no
     2006          v-filter-str = "":U
     2007          v-filter-str-rus = "":U
     2008          v-where-phrase = "":U
     2009          v-where-phrase-rus = "":U
     2010          v-filter-name      = "":U
     2011          .
     2012          assign
     2013          v-shift-date-str = entry(1, (entry(1, buf_schedule-attr.attr-value, chr(4))))
     2014          v-shift-date-str-rus = entry(1, (entry(2, buf_schedule-attr.attr-value, chr(4))))
     2015          v-shift-num      = integer(entry(2, (entry(1, buf_schedule-attr.attr-value, chr(4)))))
     2016          v-filter-name    = entry(3, buf_schedule-attr.attr-value, chr(4))
     2017          no-error .
     2018          if error-status:error then do:
     2019             assign
     2020             v-view-log = yes.
     2021            run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибка при получении параметров даты и номера смены в шаблоне создания продажи:&1" +                              "&2 &3"                                                                                                              , chr(10)                                                                                                      , error-status:get-message(1)                                                                                        , return-value )).
     2022            next _buf_schedule-attr.
     2023          end.
     2024         IF INDEX (v-shift-date-str, "today") = 0  THEN DO:
     2025           v-dop = str-decode(v-shift-date-str, "":U).
     2026           ASSIGN
     2027           v-dop = substring(v-dop, 6)
     2028           v-dop = TRIM(v-dop, ")")
     2029           v-dop1 = ENTRY(1, v-dop, chr(44))
     2030           v-dop2 = ENTRY(2, v-dop, chr(44))
     2031           v-dop3 = ENTRY(3, v-dop, chr(44)).
     2032           v-shift-date = DATE( INTEGER(v-dop1),
     2033                           INTEGER(v-dop2),
     2034                           INTEGER(v-dop3)
     2035                         )
     2036           no-error
     2037           .
     2038         END.
     2039         else do:
     2040           assign
     2041           v-dop = replace(v-shift-date-str, "today", "":U)
     2042           v-dop = replace(v-dop, "(", "":U)
     2043           v-dop = replace(v-dop, ")", "":U)
     2044           v-dop-int = integer(trim(v-dop))
     2045           v-shift-date = v-today + v-dop-int
     2046           no-error
     2047           .
     2048         end.
     2049         if error-status:error then do:
     2050           assign
     2051           v-view-log = yes.
     2052           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибка при получении параметров даты и номера смены в шаблоне создания продажи:&1" +                              "&2 &3"                                                                                                              , chr(10)                                                                                                      , error-status:get-message(1)                                                                                        , return-value )).
     2053           next _buf_schedule-attr.
     2054         end.
     2055         if available buf2_schedule-attr then do:
     2056            assign
     2057            v-filter-str  = entry(1, buf2_schedule-attr.attr-value, chr(4))
     2058            v-filter-str-rus  = entry(2, buf2_schedule-attr.attr-value, chr(4))
     2059            .
     2060         end.
     2061         v-create = yes.
     2062         _inkas:
     2063         for each buf_Inkas no-lock where
     2064                    buf_inkas.obj-type = p-curr-obj-type
     2065                AND buf_inkas.obj-code = p-curr-obj-code
     2066                and buf_inkas.shift-date = v-shift-date
     2067                and (cas-shft = no or buf_inkas.shift-num = v-shift-num)
     2068                and buf_inkas.status_ = 'новый':U :
     2069           if v-filter-str <> "":U then do:
     2070             assign
     2071             v-where-phrase = buf_inkas.sale-filter
     2072             v-where-phrase-rus = buf_Inkas.sale-filter-rus
     2073             .
     2074             if trim(v-where-phrase) = trim(v-filter-str)  then v-create = no.
     2075          end.
     2076          else do:
     2077             v-create = no.
     2078          end.
     2079          if v-create = no then leave _inkas.
     2080         end.
     2081         if v-create then do:
     2082           run cre-docs in this-procedure (
     2083                                            input 2
     2084                                           ,input p-curr-obj-type
     2085                                           ,input p-curr-obj-code
     2086                                           ,input v-shift-date
     2087                                           ,input (if cas-shft then v-shift-num else 0)
     2088                                           ,input v-filter-name
     2089                                           ,input v-filter-str
     2090                                           ,input v-filter-str-rus
     2091                                           ,input 'касс':U
     2092                                           ,output v-rid
     2093                                         ) no-error .
     2094           if error-status:error then do:
     2095             v-view-log = yes.
     2096             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("Ошибка при создании отчета о продаже по шаблону <&1> с параметрами:&2" +                             "&3&4 дата смены &5 № смены &6&2" +                                                            "ДОП. фильтр по чекам &7:&2"                                                                   , entry(3, buf_schedule-attr.attr-value, chr(4))                                       , chr(10)                                                                                , p-curr-obj-type                                                                              , p-curr-obj-code                                                                              , v-shift-date-str-rus                                                                         , v-shift-num                                                                                  , v-filter-str-rus) +                                                               substitute("&1 &2", error-status:get-message(1), return-value )).
     2097             NEXT _buf_schedule-attr.
     2098           end.
     2099           find first buf_Inkas no-lock where
     2100                     recid(buf_inkas) = v-rid .
     2101           create temp-inkas.
     2102           buffer-copy buf_inkas to temp-inkas.
     2103           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("Создан документ продажи &1 по шаблону <&2> с параметрами:&3" +                             "&4 дата смены &5 № смены &6&3" +                                                            "ДОП. фильтр по чекам &7&3"                                                                    , temp-inkas.inkas-code                                                                        , entry(3, buf_schedule-attr.attr-value, chr(4))                                       , chr(10)                                                                                , p-curr-obj-type + string(p-curr-obj-code)                                                    , v-shift-date-str-rus                                                                         , v-shift-num                                                                                  , v-filter-str-rus)).
     2104         end.
     2105         else do:
     2106           assign
     2107           v-view-log = yes.
     2108           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("Не будет создан документ продажи по шаблону <&1> с параметрами:&2" +                             "&3&4 дата смены &5 № смены &6&2" +                                                            "ДОП. фильтр по чекам &7&2" +                                                                 "Уже есть документ продажи с такими параметрами"                                                , entry(3, buf_schedule-attr.attr-value, chr(4))                                       , chr(10)                                                                                , p-curr-obj-type                                                                              , p-curr-obj-code                                                                              , v-shift-date-str-rus                                                                         , v-shift-num                                                                                  , v-filter-str-rus)).
     2109           NEXT _buf_schedule-attr.
     2110         end.
     2111       end.
     2112     end.
     2113   end procedure.
