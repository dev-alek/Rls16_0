        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable p-curr-obj-type    like ub.clients.obj-type no-undo .
        7   define variable p-curr-obj-code    like ub.clients.obj-code no-undo .
        8   define variable p-cre-db-num       like ub.schedule.cre-db-num no-undo .
        9   define variable p-task-type        like ub.schedule.task-type no-undo .
       10   define variable p-task-num         like ub.schedule.task-num no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: salemake.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: str/salemake.p $":U .
       16   define variable vss-description as character no-undo init "".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35       assign
       36         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-curr-obj-type,p-curr-obj-code,p-cre-db-num,p-task-type,p-task-num)
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define new global shared variable g#trdcalib as handle no-undo.
       91   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define temp-table temp-schedule-free no-undo
       93   field free-id as character
       94   field free-task-name as character
       95   field proc-run-name as character
       96   field proc-param-edit-name as character
       97   field conf-param as character
       98   field is-gbd as logical
       99   field is-ubd as logical
      100   field enable-concurrent-0 as logical
      101   field enable-concurrent-db as logical
      102   field other-info as character
      103   field enc-key as character
      104   field is-rum as logical
      105   index pi is unique primary
      106   free-id.
      107   procedure schedule-attr-name :
      108   do
      109     on error undo, return error
      110     :
      111     define input  parameter p-code           as character no-undo .
      112     define output parameter p-type           as character no-undo .
      113     define output parameter p-format         as character no-undo .
      114     define output parameter p-label          as character no-undo .
      115     define output parameter p-user-can-edit  as logical   no-undo .
      116     define output parameter p-output-display as logical   no-undo .
      117     define output parameter p-other          as character no-undo .
      118       if index(p-code, chr(4)) > 0 then do:
      119         p-code = entry(1, p-code, chr(4)).
      120       end.
      121       case p-code :
      122               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      123               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      124               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      125               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      126               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      127               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      128               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      129               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      130               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      131         otherwise do:
      132           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      133         end.
      134       end.
      135     end.
      136   end procedure.
      137   procedure schedule-attr-tooltip :
      138   do
      139     on error undo, return error
      140     :
      141       define input  parameter p-code    as character no-undo .
      142       define output parameter p-tooltip as character no-undo .
      143       define output parameter p-label   as character no-undo .
      144       if index(p-code, chr(4)) > 0 then do:
      145         p-code = entry(1, p-code, chr(4)).
      146       end.
      147       case p-code :
      148               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      149               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      150               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      151               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      152               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      153               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      154               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      155               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      156               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      157         otherwise do:
      158               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      159         end.
      160       end.
      161     end.
      162   end procedure.
      163   procedure schedule-attr-value :
      164   do
      165   on error undo, return error return-value
      166   :
      167   define input parameter  p-cre-db-num as integer    no-undo.
      168   define input parameter  p-task-type  as character  no-undo.
      169   define input parameter  p-task-num   as integer    no-undo.
      170   define input parameter  p-code       as character  no-undo.
      171   define output parameter p-value      as character  no-undo.
      172   define output parameter p-type       as character  no-undo.
      173       define variable v-format         as character no-undo .
      174       define variable v-label          as character no-undo .
      175       define variable v-user-can-edit  as logical   no-undo .
      176       define variable v-output-display as logical   no-undo .
      177       define variable v-other          as character no-undo .
      178       define buffer buf_schedule-attr for ub.schedule-attr.
      179       run schedule-attr-name in this-procedure (
      180             input  p-code
      181           , output p-type
      182           , output v-format
      183           , output v-label
      184           , output v-user-can-edit
      185           , output v-output-display
      186           , output v-other
      187       ) no-error .
      188       if error-status :error
      189       then do:
      190           undo, return error return-value .
      191       end.
      192       if p-code begins ('schd-free-id':U + chr(4))
      193       and entry(2, p-code, chr(4)) = '':U then do:
      194         find first buf_schedule-attr no-lock
      195             where buf_schedule-attr.cre-db-num = p-cre-db-num
      196               and buf_schedule-attr.task-type  = p-task-type
      197               and buf_schedule-attr.task-num   = p-task-num
      198               and buf_schedule-attr.attr-code  begins p-code
      199         no-error .
      200       end.
      201       else do:
      202         find first buf_schedule-attr no-lock
      203             where buf_schedule-attr.cre-db-num = p-cre-db-num
      204               and buf_schedule-attr.task-type  = p-task-type
      205               and buf_schedule-attr.task-num   = p-task-num
      206               and buf_schedule-attr.attr-code  = p-code
      207         no-error .
      208       end.
      209       if available buf_schedule-attr
      210       then do:
      211           assign
      212               p-value = buf_schedule-attr.attr-value
      213           .
      214       end.
      215       else do:
      216         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      217            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      218         end.
      219         else do:
      220           assign
      221               p-value = if p-type = 'L':U then "no":U else ""
      222           .
      223         end.
      224       end.
      225   end.
      226   end procedure.
      227   procedure schedule-attr-write :
      228   do
      229   on error undo, return error
      230   :
      231   define input parameter p-cre-db-num  as integer   no-undo.
      232   define input parameter p-task-type   as character no-undo.
      233   define input parameter p-task-num    as integer   no-undo.
      234   define input parameter p-code        as character no-undo.
      235   define input parameter p-value       as character no-undo.
      236       define variable v-type              as character                no-undo.
      237       define variable v-format            as character                no-undo.
      238       define variable v-label             as character                no-undo.
      239       define variable v-user-can-edit     as logical                  no-undo.
      240       define variable v-output-display    as logical                  no-undo.
      241       define variable v-other             as character                no-undo.
      242       define buffer buf_schedule-attr for ub.schedule-attr .
      243       run schedule-attr-name in this-procedure (
      244             input  p-code
      245           , output v-type
      246           , output v-format
      247           , output v-label
      248           , output v-user-can-edit
      249           , output v-output-display
      250           , output v-other
      251       ) no-error.
      252       if error-status :error
      253       then do:
      254           undo, return error return-value.
      255       end.
      256       find first buf_schedule-attr exclusive-lock
      257            where buf_schedule-attr.cre-db-num = p-cre-db-num
      258              and buf_schedule-attr.task-type  = p-task-type
      259              and buf_schedule-attr.task-num   = p-task-num
      260              and buf_schedule-attr.attr-code  = p-code
      261       no-error.
      262       if not available buf_schedule-attr
      263       then do:
      264           create buf_schedule-attr.
      265           assign
      266             buf_schedule-attr.cre-db-num = p-cre-db-num
      267             buf_schedule-attr.task-type  = p-task-type
      268             buf_schedule-attr.task-num   = p-task-num
      269             buf_schedule-attr.attr-code  = p-code
      270             buf_schedule-attr.attr-value = p-value
      271           .
      272       end.
      273       else do:
      274           assign
      275               buf_schedule-attr.attr-value = p-value
      276           .
      277       end.
      278   end.
      279   end procedure.
      280   procedure schedule-attr-delete :
      281   do
      282   on error undo, return error
      283   :
      284   define input  parameter p-cre-db-num  as integer   no-undo.
      285   define input  parameter p-task-type   as character no-undo.
      286   define input  parameter p-task-num    as integer   no-undo.
      287   define input  parameter p-code        as character no-undo.
      288   define output parameter p-deleted     as logical   no-undo.
      289       define buffer buf_schedule-attr for ub.schedule-attr .
      290       define variable v-type              as character                no-undo.
      291       define variable v-format            as character                no-undo.
      292       define variable v-label             as character                no-undo.
      293       define variable v-user-can-edit     as logical                  no-undo.
      294       define variable v-output-display    as logical                  no-undo.
      295       define variable v-other             as character                no-undo.
      296       run schedule-attr-name in this-procedure (
      297             input p-code
      298           , output v-type
      299           , output v-format
      300           , output v-label
      301           , output v-user-can-edit
      302           , output v-output-display
      303           , output v-other
      304       ) no-error .
      305       if error-status :error
      306       then do:
      307           undo, return error return-value .
      308       end.
      309       find first buf_schedule-attr exclusive-lock
      310            where buf_schedule-attr.cre-db-num = p-cre-db-num
      311              and buf_schedule-attr.task-type  = p-task-type
      312              and buf_schedule-attr.task-num   = p-task-num
      313              and buf_schedule-attr.attr-code  = p-code
      314       no-error.
      315       if not available buf_schedule-attr
      316       then do:
      317           assign
      318               p-deleted = no
      319           .
      320       end.
      321       else do:
      322           delete buf_schedule-attr.
      323           assign
      324               p-deleted = yes
      325           .
      326       end.
      327   end.
      328   end procedure.
      329   procedure schedule-attr-news :
      330   do
      331   on error undo, return error
      332   :
      333       define input  parameter p-code           as character no-undo .
      334       define output parameter p-news           as logical   no-undo .
      335       if index(p-code, chr(4)) > 0 then do:
      336         p-code = entry(1, p-code, chr(4)).
      337       end.
      338       case p-code :
      339               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      340               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      341               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      342               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      343               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      344               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      345               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      346               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      347               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      348         otherwise do:
      349           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      350         end.
      351       end.
      352   end.
      353   end procedure.
      354   procedure schedule-attr-extract-logical :
      355   do
      356   on error undo, return error
      357   :
      358   define input  parameter p-parameter-number   as integer      no-undo.
      359   define input  parameter p-parameter-list     as character    no-undo.
      360   define output parameter p-parameter-value   as logical      no-undo.
      361       if num-entries( p-parameter-list ) > p-parameter-number - 1
      362       then do:
      363           assign
      364               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      365           .
      366       end.
      367       else do:
      368           assign
      369               p-parameter-value   = no
      370           .
      371       end.
      372   end.
      373   end procedure.
      374   procedure schedule-attr-get-free-id :
      375   do
      376   on error undo, return error return-value
      377   :
      378     define input  parameter p-cre-db-num  as integer   no-undo.
      379     define input  parameter p-task-type   as character no-undo.
      380     define input  parameter p-task-num    as integer   no-undo.
      381     define output parameter p-free-id     as character no-undo.
      382     define buffer buf_schedule-attr for ub.schedule-attr.
      383     find first buf_schedule-attr no-lock
      384         where buf_schedule-attr.cre-db-num = p-cre-db-num
      385           and buf_schedule-attr.task-type  = p-task-type
      386           and buf_schedule-attr.task-num   = p-task-num
      387           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      388     no-error .
      389     if available buf_schedule-attr then
      390     assign
      391     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      392     no-error
      393     .
      394   end.
      395   end procedure.
      396   procedure schedule-attr-get-free-props :
      397     define input parameter p-free-id as character no-undo .
      398     define output parameter p-value as character no-undo .
      399     define buffer buf_temp-schedule-free for temp-schedule-free.
      400     do
      401     on error undo, return error return-value
      402     :
      403       find first buf_temp-schedule-free no-lock no-error .
      404       if not available buf_temp-schedule-free then do:
      405         run schedule-attr-fill-free-props in this-procedure .
      406       end.
      407       find first buf_temp-schedule-free where
      408               buf_temp-schedule-free.free-id = p-free-id no-error.
      409       if available buf_temp-schedule-free then do:
      410         assign
      411         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      412                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      413                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      414                   buf_temp-schedule-free.conf-param           + chr(4) +
      415                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      416                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      417                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      418                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      419                   buf_temp-schedule-free.other-info
      420         .
      421       end.
      422       else do:
      423        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      424                              "id произвольной задачи - &5"
      425                              ,vss-workfile
      426                              ,vss-revision
      427                              ,vss-description
      428                              ,chr(10)
      429                              ,p-free-id).
      430       end.
      431     end.
      432   end procedure.
      433   procedure schedule-attr-is-rum-free-id :
      434   define input parameter p-free-id as character no-undo .
      435   define output parameter p-is-rum as logical no-undo .
      436   define buffer buf_temp-schedule-free for temp-schedule-free.
      437   do
      438   on error undo, return error
      439   :
      440       find first buf_temp-schedule-free no-lock no-error .
      441       if not available buf_temp-schedule-free then do:
      442         run schedule-attr-fill-free-props in this-procedure .
      443       end.
      444       find first buf_temp-schedule-free where
      445               buf_temp-schedule-free.free-id = p-free-id no-error.
      446       if available buf_temp-schedule-free
      447       and buf_temp-schedule-free.is-rum
      448       then do:
      449         p-is-rum = yes.
      450       end.
      451   end.
      452   end procedure.
      453   procedure schedule-attr-fill-free-props :
      454   define variable v-path                    as character                no-undo .
      455   DEFINE VARIABLE v-full-path               as character                no-undo .
      456   DEFINE VARIABLE v-file-name               as character                no-undo .
      457   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      458   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      459   define buffer buf_temp-schedule-free for temp-schedule-free.
      460   define variable v-answer as logical no-undo .
      461     do
      462     on error undo, return error substitute("&1 &2 &3&4&5&4"
      463                                           ,vss-workfile
      464                                           ,vss-revision
      465                                           ,vss-description
      466                                           ,chr(10)
      467                                           ,error-status:get-message(1) )
      468     :
      469       run gbl/filename.p (
      470                       input 'cmp/shd-free.d'
      471                     ,output v-full-path
      472                     ,output v-path
      473                     ,output v-file-name
      474                     ,output v-file-name-no-ext
      475                     ,output v-file-name-ext
      476                     ) .
      477       input from value(v-full-path).
      478       repeat :
      479         create buf_temp-schedule-free.
      480         import buf_temp-schedule-free.
      481       END.
      482       input close.
      483       _ff:
      484       for each buf_temp-schedule-free :
      485         if buf_temp-schedule-free.free-id = '':U then do:
      486            delete buf_temp-schedule-free.
      487            next _ff.
      488          end.
      489          run schedule-attr-check-enc in this-procedure (
      490                                                       input  buf_temp-schedule-free.free-id
      491                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      492                                                               buf_temp-schedule-free.proc-param-edit-name +
      493                                                               buf_temp-schedule-free.conf-param +
      494                                                               string(buf_temp-schedule-free.is-gbd) +
      495                                                               string(buf_temp-schedule-free.is-ubd) +
      496                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      497                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      498                                                               string(buf_temp-schedule-free.other-info)
      499                                                               )
      500                                                       ,input  buf_temp-schedule-free.enc-key
      501                                                       ,output v-answer    ) no-error .
      502          if error-status:error
      503          or not v-answer then delete buf_temp-schedule-free.
      504        end.
      505     end.
      506   end procedure.
      507   Function schedule-attr-reverse returns character (str as character).
      508      define variable rev_incl_s as character init "" no-undo .
      509      define variable rev_incl_i as integer no-undo .
      510      define variable rev_incl_l as integer no-undo .
      511      rev_incl_l = length(str).
      512      do rev_incl_i = 1 to rev_incl_l:
      513         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      514      end.
      515      return rev_incl_s.
      516   end.
      517   procedure schedule-attr-check-enc.
      518     define input  parameter p-free-id   as character no-undo .
      519     define input  parameter p-value     as character no-undo .
      520     define input  parameter p-enc-value as character no-undo .
      521     define output parameter p-answer    as logical   no-undo .
      522     define variable tmp         as character no-undo .
      523     define variable v-enc-value as character no-undo .
      524     assign
      525     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      526     .
      527     run schedule-attr-pswd-enc in this-procedure
      528       ( input tmp
      529        ,output v-enc-value
      530       ) no-error .
      531     if error-status:error then do:
      532       message
      533         vss-workfile vss-revision vss-description skip
      534         "Ошибка при вызове процедуры pswd-enc" skip
      535         return-value skip
      536         error-status :get-message(1) skip
      537         view-as alert-box error .
      538       undo, return error .
      539     end.
      540     if v-enc-value = p-enc-value then do:
      541       assign
      542         p-answer = true
      543       .
      544     end.
      545     else do:
      546       assign
      547         p-answer = false
      548       .
      549     end.
      550   end.
      551   procedure schedule-attr-conf-enc.
      552     define input  parameter p-free-id   as character no-undo .
      553     define input  parameter p-value     as character no-undo .
      554     define output parameter p-enc-value as character no-undo .
      555     define variable tmp         as character no-undo .
      556     assign
      557       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      558     .
      559     run schedule-attr-pswd-enc in this-procedure
      560       ( input tmp
      561        ,output p-enc-value
      562       ) no-error .
      563     if error-status:error then do:
      564       message
      565         vss-workfile vss-revision vss-description skip
      566         "Ошибка при вызове процедуры pswd-enc" skip
      567         return-value skip
      568         error-status :get-message(1) skip
      569         view-as alert-box error .
      570       undo, return error .
      571     end.
      572   end procedure.
      573   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure schedule-attr-pswd-enc :
      575     define input parameter  pswd     as character no-undo .
      576     define output parameter enc-pswd as character no-undo .
      577     do
      578     on error undo, return error return-value
      579     :
      580       assign
      581         enc-pswd = encode(pswd + string(index(pswd, "k")))
      582       .
      583     end.
      584   end procedure.
      585   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   procedure cur-time :
      587      define output parameter p-today as date      no-undo .
      588      define output parameter p-time  as integer   no-undo .
      589     do
      590     on error undo, return error
      591     :
      592       define variable v-date1 as date      no-undo .
      593       define variable v-date2 as date      no-undo .
      594       define variable v-time  as integer   no-undo .
      595       assign
      596         v-date1 = today
      597         v-time  = time
      598         v-date2 = today
      599       .
      600       if v-date1 <> v-date2
      601       then do:
      602         assign
      603           v-date1 = today
      604           v-time  = v-time
      605         .
      606       end.
      607       assign
      608         p-today = v-date1
      609         p-time  = v-time
      610       .
      611     end.
      612   end.
      613   function cur-time-date returns character
      614   :
      615     return string(today, '99/99/9999':U) .
      616   end.
      617   function cur-time-mjd returns decimal
      618   :
      619     define variable v-date as date      no-undo .
      620     define variable v-time as integer   no-undo .
      621     run cur-time in this-procedure
      622       (output v-date
      623       ,output v-time
      624       ) .
      625     return integer(v-date) - 2400002 + (v-time / 86400) .
      626   end.
      627   function cur-time-get-ending-index returns integer
      628   (input p-number as integer
      629   )
      630   :
      631     if p-number < 0
      632     or p-number = ?
      633     then do:
      634       return 1 .
      635     end.
      636     define variable v-rest as integer   no-undo .
      637     assign
      638       p-number = p-number modulo 100
      639     .
      640     if p-number < 20
      641     then do:
      642       assign
      643         v-rest = p-number
      644       .
      645     end.
      646     else do:
      647       assign
      648         v-rest = p-number modulo 10
      649       .
      650     end.
      651     case v-rest :
      652       when 1
      653       then do:
      654         return 2 .
      655       end.
      656       when 2 or
      657       when 3 or
      658       when 4
      659       then do:
      660         return 3 .
      661       end.
      662       otherwise do:
      663         return 1 .
      664       end.
      665     end case .
      666   end.
      667   procedure cur-time-mjd-to-date :
      668      define input  parameter i-mjd-diff as decimal no-undo.
      669      define output parameter o-Date     as date    no-undo.
      670      define output parameter o-Time     as integer no-undo.
      671      define variable v-day-number as integer   no-undo .
      672      if    i-mjd-diff < 0
      673         or i-mjd-diff = ?
      674      then do:
      675         return "?" .
      676      end.
      677      assign
      678         v-day-number = truncate(i-mjd-diff,0).
      679         o-Date = date(v-day-number + 2400002).
      680         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      681     .
      682   end.
      683   function cur-time-mjd-to-string returns character
      684   (input p-mjd-diff as decimal
      685   )
      686   :
      687     define variable v-day-number as integer   no-undo .
      688     define variable v-seconds    as integer   no-undo .
      689     define variable v-hour       as integer   no-undo .
      690     define variable v-min        as integer   no-undo .
      691     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      692     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      693     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      694     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      695     if p-mjd-diff < 0
      696     or p-mjd-diff = ?
      697     then do:
      698       return "?" .
      699     end.
      700     assign
      701       v-day-number = integer(truncate(p-mjd-diff,0))
      702       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      703     .
      704     if v-seconds > 86400
      705     then do:
      706       assign
      707         v-seconds = 86400 - 1
      708       .
      709     end.
      710     if v-seconds < 0
      711     then do:
      712       assign
      713         v-seconds = 0
      714       .
      715     end.
      716     assign
      717       v-hour = truncate(v-seconds / 3600, 0)
      718     .
      719     assign
      720       v-seconds = v-seconds modulo 3600
      721     .
      722     assign
      723       v-min = truncate(v-seconds / 60, 0)
      724     .
      725     assign
      726       v-seconds = v-seconds modulo 60
      727     .
      728     return
      729         (if v-day-number <> 0
      730           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      731           else ""
      732         )
      733       + (if v-day-number <> 0 or v-hour <> 0
      734           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      735           else ""
      736         )
      737       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      738           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      739           else ""
      740         )
      741       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      742       .
      743   end.
      744   function cur-time-string returns character
      745   :
      746     define variable v-date as date      no-undo .
      747     define variable v-time as integer   no-undo .
      748     run cur-time in this-procedure
      749       (output v-date
      750       ,output v-time
      751       ) .
      752     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      753   end.
      754   function cur-time-string-sec returns character
      755   :
      756     define variable v-date as date      no-undo .
      757     define variable v-time as integer   no-undo .
      758     run cur-time in this-procedure
      759       (output v-date
      760       ,output v-time
      761       ) .
      762     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      763   end.
      764   function cur-time-custom  returns character
      765   (input p-prefix as character
      766   ,input p-date-format as character
      767   ,input p-delimiter as character
      768   ,input p-time-format as character
      769   ,input p-suffix as character
      770   )
      771   :
      772     define variable v-date as date      no-undo .
      773     define variable v-time as integer   no-undo .
      774     run cur-time in this-procedure
      775       (output v-date
      776       ,output v-time
      777       ) .
      778     return
      779       p-prefix
      780       + string(v-date, p-date-format)
      781       + p-delimiter
      782       + string(v-time, p-time-format)
      783       + p-suffix
      784       .
      785   end.
      786   function cur-time-print  returns character
      787   :
      788     define variable v-date as date      no-undo .
      789     define variable v-time as integer   no-undo .
      790     run cur-time in this-procedure
      791       (output v-date
      792       ,output v-time
      793       ) .
      794     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      795   end.
      796   function cur-time-datetime returns datetime
      797   :
      798     define variable v-char as character no-undo .
      799     define variable v-datetime as datetime no-undo .
      800     v-char = cur-time-string().
      801     v-datetime = datetime(v-char).
      802     return  v-datetime.
      803   end.
      804   function cur-time-string-msec returns character
      805   :
      806     define variable v-date as datetime  no-undo .
      807     v-date = now.
      808     return string(v-date) .
      809   end.
      810   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   function octal-to-char return character
      812   ( p-string as character ) :
      813     def var v-asc     as integer no-undo .
      814     def var v-new-asc as integer no-undo .
      815     def var ind       as integer no-undo .
      816     if length(p-string) <> 3 then do:
      817       return ? .
      818     end.
      819     assign
      820       v-asc = 0
      821     .
      822     do ind = 1 to length(p-string)
      823     :
      824       assign
      825         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      826       .
      827       if v-new-asc < 0 or v-new-asc >= 8 then do:
      828         return ? .
      829       end.
      830       assign
      831         v-asc = v-asc * 8 + v-new-asc
      832       .
      833     end.
      834     return chr(v-asc) .
      835   end function .
      836   function char-to-octal return character
      837   ( p-chr as character ) :
      838     def var v-asc    as integer   no-undo .
      839     def var ind      as integer   no-undo .
      840     def var v-string as character no-undo .
      841     if length(p-chr) <> 1 then do:
      842       return ? .
      843     end.
      844     assign
      845       v-asc    = asc(p-chr)
      846       v-string = ""
      847     .
      848     do ind = 1 to 3
      849     :
      850       assign
      851         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      852       .
      853       assign
      854         v-asc = truncate(v-asc / 8, 0)
      855       .
      856     end.
      857     return v-string .
      858   end.
      859   function str-encode return character
      860   (   p-init-string       as character
      861     , p-encode-char       as character
      862     , p-special-char-list as character
      863   ) :
      864     def var p-encode-string as character no-undo .
      865     def var ind                as integer no-undo .
      866     def var v-num-special-char as integer no-undo .
      867     def var v-special-char     as character no-undo .
      868     if p-encode-char = ?
      869     or p-encode-char = "" then do:
      870       assign
      871         p-encode-char = "~~"
      872       .
      873     end.
      874     if p-init-string = ? then do:
      875       return "?" .
      876     end.
      877     if p-init-string = "?" then do:
      878       return p-encode-char + char-to-octal("?") .
      879     end.
      880     assign
      881       v-num-special-char = length(p-special-char-list)
      882       p-encode-string    = replace(p-init-string
      883                                   ,p-encode-char
      884                                   ,p-encode-char + char-to-octal(p-encode-char)
      885                                   )
      886     .
      887     do ind = 1 to v-num-special-char
      888     :
      889       assign
      890         v-special-char = substring(p-special-char-list, ind, 1)
      891       .
      892       if v-special-char <> p-encode-char then do:
      893         assign
      894           p-encode-string = replace (p-encode-string
      895                                     ,v-special-char
      896                                     ,p-encode-char + char-to-octal(v-special-char)
      897                                     )
      898         .
      899       end.
      900     end.
      901     return p-encode-string .
      902   end.
      903   function str-decode returns character
      904     (p-init-string   as character
      905     ,p-encode-char   as character
      906     ) :
      907     def var p-decode-string as character no-undo .
      908     def var ind                       as integer no-undo .
      909     def var v-num-entries-init-string as integer no-undo .
      910     def var v-sub-phrase              as character no-undo .
      911     def var v-special-char            as character no-undo .
      912     if p-encode-char = ?
      913     or p-encode-char = "" then do:
      914       assign
      915         p-encode-char = "~~"
      916       .
      917     end.
      918     if p-init-string = "?" then do:
      919       return ? .
      920     end.
      921     assign
      922       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      923     .
      924     if v-num-entries-init-string > 1 then do:
      925       assign
      926         p-decode-string = entry(1, p-init-string, p-encode-char)
      927       .
      928       do ind = 2 to v-num-entries-init-string
      929       :
      930         assign
      931           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      932         .
      933         assign
      934           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      935         .
      936         if v-special-char <> ? then do:
      937           assign
      938             p-decode-string = p-decode-string
      939                             + v-special-char
      940                             + substring(v-sub-phrase, 4)
      941           .
      942         end.
      943         else do:
      944           assign
      945             p-decode-string = p-decode-string
      946                             + p-encode-char
      947                             + v-sub-phrase
      948           .
      949         end.
      950       end.
      951     end.
      952     else do:
      953       assign
      954         p-decode-string = p-init-string
      955       .
      956     end.
      957     return p-decode-string .
      958   end.
      959   define new global shared variable g#lib-trn  as handle no-undo .
      960   define new global shared variable g#lib-trn2 as handle no-undo .
      961   define new global shared variable g#lib-trn3 as handle no-undo .
      962   define new global shared variable g#lib-trn4 as handle no-undo .
      963   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   procedure doc-code:
      965   define input  parameter parmode          as   character           no-undo.
      966   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      967   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      968   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      969   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      970   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      971   define variable vardb-remote     as   logical             no-undo.
      972   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      973   define variable v-delimiter as character no-undo .
      974   do
      975   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      976   :
      977   find first buf_sys-ctrl no-lock .
      978   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      979     CASE parmode:
      980       when "main":u then do:
      981         if vardb-remote then do:
      982           assign
      983             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      984         end.
      985         else do:
      986           assign
      987             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      988         end.
      989       end.
      990       when "trio" then do:
      991         assign
      992           pardoc-code = replace (parroot-doc-code, "=", "*").
      993       end.
      994       otherwise do:
      995         assign
      996         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      997         no-error
      998         .
      999         if error-status:error  then do:
     1000           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1001                                         ,chr(10)
     1002                                         ,parmode
     1003                                         ).
     1004         end.
     1005         if num-entries(parmode) = 1
     1006         and parmode <> "chip":U
     1007         and parmode <> "chip_s":U
     1008         then do:
     1009           assign
     1010           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1011         end.
     1012         else if (lookup("chip":U, parmode) > 0
     1013                  or
     1014                  lookup("chip_s":U, parmode) > 0) then do:
     1015           assign
     1016             vartemp-doc-code = parroot-doc-code.
     1017           do while true:
     1018             if index (vartemp-doc-code , ".") = 0 then
     1019               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1020             else
     1021               vartemp-doc-code  =
     1022               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1023               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1024               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1025             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1026           end.
     1027           assign
     1028             pardoc-code = vartemp-doc-code.
     1029         end.
     1030       end.
     1031     end CASE.
     1032     if pardoc-code = '':U
     1033     or (parroot-doc-code <> '':U
     1034     and pardoc-code = parroot-doc-code) then do:
     1035       undo, return error substitute("Ошибка при генерации номера документа&1"
     1036                                     ,chr(10)).
     1037     end.
     1038   end.
     1039   end. // procedure/method
     1040   function get-doc-code-int64 returns int64
     1041     ( input p-doc-code as character ) :
     1042     define variable v-ind              as integer   no-undo .
     1043     define variable v-num-entries      as integer   no-undo .
     1044     define variable v-doc-code-int64   as int64     no-undo .
     1045     define variable v-canonic-doc-code as character no-undo .
     1046     assign
     1047       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1048       v-canonic-doc-code = p-doc-code
     1049     .
     1050     do v-ind = 1 to v-num-entries
     1051     :
     1052       assign
     1053         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1054       .
     1055     end.
     1056     assign
     1057       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1058     .
     1059     return v-doc-code-int64 .
     1060   end. // function/method
     1061   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1064   define variable v-ps as character no-undo .
     1065   if available buf_sale-doc then
     1066   assign
     1067   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1068                       , chr(4)
     1069                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     1070                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1071                       , buf_sale-doc.chk-amount
     1072                       , buf_sale-doc.gds-amount
     1073                       , buf_sale-doc.tot-lines
     1074                       , buf_sale-doc.tot-dtl
     1075                       ).
     1076   else  do:
     1077   assign
     1078   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1079                       , chr(4)
     1080                       , '':U
     1081                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1082                       , 0
     1083                       , 0
     1084                       , 0
     1085                       , 0
     1086                       ).
     1087   end.
     1088   return v-ps.
     1089   END FUNCTION.
     1090   FUNCTION get-sale-doc-kind returns character (
     1091                                                input p-doc-kind as character
     1092                                              , input p-ext-doc-type as character
     1093                                              , output p-order as integer
     1094                                              , output p-msign as integer
     1095                                              , output p-main as logical
     1096                                              , output p-in-inkas as logical
     1097                                              , output p-dir_ as integer
     1098                                              ):
     1099   define variable v-doc-kind as character no-undo.
     1100   define variable v-type as character no-undo .
     1101   define variable v-value as character no-undo .
     1102   CASE p-doc-kind:
     1103     when 'es':U then do:
     1104       assign
     1105       p-order = 100
     1106       p-msign = 1
     1107       p-main = yes
     1108       p-in-inkas = yes
     1109       p-dir_ = 1
     1110       .
     1111       return p-ext-doc-type.
     1112     end.
     1113     when  'rs':U then do:
     1114       assign
     1115       p-order = 200
     1116       p-msign = - 1
     1117       p-main = no
     1118       p-in-inkas = yes
     1119       p-dir_ = - 1
     1120       .
     1121       return p-ext-doc-type.
     1122     end.
     1123     when 'rwo':U then do:
     1124       assign
     1125       p-msign = - 1
     1126       p-main = no
     1127       p-in-inkas = no
     1128       p-order = 300
     1129       p-dir_ = 1
     1130       .
     1131       return 'rwo':U.
     1132     end.
     1133     when 'trf':U then do:
     1134       assign
     1135       p-msign = 1
     1136       p-main = no
     1137       p-in-inkas = no
     1138       p-order = 400
     1139       p-dir_ = 1
     1140       .
     1141       return 'trf':U.
     1142     end.
     1143     when 'swo':U then do:
     1144      assign
     1145      p-msign = 1
     1146      p-main = no
     1147      p-in-inkas = no
     1148      p-order =  500
     1149      p-dir_ = 1
     1150      .
     1151      return 'swo':U.
     1152    end.
     1153    when 'vir':U then do:
     1154      assign
     1155      p-msign = 1
     1156      p-main = no
     1157      p-in-inkas = no
     1158      p-order = 600
     1159      p-dir_ = 1
     1160      .
     1161      return 'vir':U.
     1162    end.
     1163    when 'itr':U then do:
     1164      assign
     1165      p-msign = 1
     1166      p-main = no
     1167      p-in-inkas = no
     1168      p-order = -1
     1169      p-dir_ = -1
     1170      .
     1171     return 'itr':U.
     1172    end.
     1173    when 'ngs':U then do:
     1174      assign
     1175      p-msign = 1
     1176      p-main = no
     1177      p-in-inkas = no
     1178      p-order = 700
     1179      p-dir_ = 1
     1180      .
     1181      return 'ngs':U.
     1182    end.
     1183    when 'rgs':U then do:
     1184      assign
     1185      p-msign = -1
     1186      p-main = no
     1187      p-in-inkas = no
     1188      p-order = 701
     1189      p-dir_ = -1
     1190      .
     1191      return 'rgs':U.
     1192    end.
     1193    otherwise do:
     1194       assign
     1195       p-msign = 1
     1196       p-main = no
     1197       p-in-inkas = no
     1198       p-order = -1.
     1199       return p-ext-doc-type.
     1200     end.
     1201   END CASE.
     1202   END FUNCTION.
     1203   procedure saledoc-create :
     1204   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1205   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1206   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1207   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1208   define input parameter p-doc-kind as character no-undo .
     1209   define input parameter p-office as character no-undo .
     1210   define input parameter p-tpsidoc as logical no-undo .
     1211   define input parameter p-alias-type-price as character no-undo .
     1212   define input parameter p-price-obj-type as character no-undo .
     1213   define input parameter p-price-obj-code as integer no-undo .
     1214   define parameter buffer buf_trn-doc for ub.trn-doc.
     1215   define variable v-order as integer no-undo.
     1216   define variable v-main as logical no-undo .
     1217   define variable v-in-inkas as logical no-undo .
     1218   define variable v-msign as integer no-undo .
     1219   define variable v-dir_ as integer no-undo .
     1220   define variable v-trn-doc-code as character no-undo .
     1221   define buffer buf_sale-doc for ub.sale-doc.
     1222   main-block:
     1223   do
     1224   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1225   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1226   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1227   :
     1228      if available buf_trn-doc then do:
     1229        v-trn-doc-code = buf_trn-doc.doc-code.
     1230      end.
     1231      find first buf_sale-doc where
     1232               buf_sale-doc.inkas-code = p-inkas-code
     1233           and buf_sale-doc.doc-kind = p-doc-kind
     1234           and buf_sale-doc.chr-office = p-office
     1235           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1236           no-error .
     1237      if not available buf_sale-doc  then do:
     1238         create buf_sale-doc.
     1239         assign
     1240         buf_sale-doc.inkas-code = p-inkas-code
     1241         buf_sale-doc.storage =  'trn-doc':U
     1242         buf_sale-doc.host-code = p-host-code
     1243         buf_sale-doc.obj-type = p-obj-type
     1244         buf_sale-doc.obj-code = p-obj-code
     1245         buf_sale-doc.doc-kind  = p-doc-kind
     1246         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1247         buf_sale-doc.chr-office = p-office
     1248         buf_sale-doc.doc-code = v-trn-doc-code
     1249         .
     1250      end.
     1251      if available buf_trn-doc then
     1252      buffer-copy buf_trn-doc
     1253      to buf_sale-doc
     1254      .
     1255     assign
     1256     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1257                                                input p-doc-kind
     1258                                               ,input buf_sale-doc.ext-doc-type
     1259                                               ,output v-order
     1260                                               ,output v-msign
     1261                                               ,output v-main
     1262                                               ,output v-in-inkas
     1263                                               ,output v-dir_).
     1264     assign
     1265     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1266     buf_sale-doc.main-doc = v-main
     1267     buf_sale-doc.in-inkas = v-in-inkas
     1268     buf_sale-doc.msign = v-msign
     1269     buf_sale-doc.dir = v-dir_
     1270     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1271     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1272     buf_sale-doc.poss-wro-codes = '':U
     1273     buf_sale-doc.chr-office = p-office
     1274     buf_sale-doc.tpsidoc = p-tpsidoc
     1275     buf_sale-doc.alias-type-price = p-alias-type-price
     1276     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1277                                    then p-price-obj-type
     1278                                    else '':U)
     1279     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1280                                    then p-price-obj-code
     1281                                    else 0)
     1282     .
     1283     assign
     1284     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1285     no-error.
     1286   end.
     1287   END.
     1288   procedure fbr-saledoc-create :
     1289   define input parameter p-inkas-code as character no-undo .
     1290   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1291   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1292   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1293   define buffer buf_fbr-doc for ub.fbr-doc.
     1294   define buffer buf_trn-doc for ub.trn-doc.
     1295   define buffer buf_sale-doc for ub.sale-doc.
     1296   define buffer buf2_sale-doc for ub.sale-doc.
     1297   define buffer buf2_trn-doc for ub.trn-doc.
     1298   define buffer buf_doc-line for ub.doc-line.
     1299   define buffer buf_gds-dtl for ub.gds-dtl.
     1300   define buffer buf_chk-gds for ub.chk-gds.
     1301   define buffer buf_chk-doc for ub.chk-doc.
     1302   do
     1303   on error undo, return error
     1304   :
     1305     for each buf_fbr-doc no-lock where
     1306           buf_fbr-doc.out-code = p-inkas-code:
     1307       for each buf_trn-doc no-lock where
     1308             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1309       by buf_trn-doc.fact-order
     1310       on error undo, return error:
     1311         if buf_trn-doc.ext-doc-type = 'em':U
     1312         or buf_trn-doc.ext-doc-type = 'im':U
     1313         or buf_trn-doc.ext-doc-type = 'wm':U
     1314         or buf_trn-doc.ext-doc-type = 'ev':U
     1315         or buf_trn-doc.ext-doc-type = 'iv':U
     1316         then do:
     1317           find first buf_sale-doc where
     1318                   buf_sale-doc.inkas-code = p-inkas-code
     1319               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1320               AND buf_sale-doc.storage  = 'trn-doc':U
     1321                   no-error .
     1322           if not available buf_sale-doc then do:
     1323           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     1324           end.
     1325           if buf_trn-doc.ext-doc-type = 'im':U then do:
     1326             assign
     1327             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     1328             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     1329             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     1330             .
     1331           end.
     1332           for each buf2_trn-doc no-lock where
     1333                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     1334             find first buf2_sale-doc where
     1335                     buf2_sale-doc.inkas-code = p-inkas-code
     1336                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     1337                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     1338             if not available buf2_sale-doc then do:
     1339               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     1340             end.
     1341           end.
     1342         end.
     1343       end.
     1344       find first buf_sale-doc where
     1345                 buf_sale-doc.inkas-code = p-inkas-code
     1346             AND buf_sale-doc.storage = 'fbr-doc':U
     1347             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     1348       if not available buf_sale-doc then do:
     1349         create buf_sale-doc.
     1350         assign
     1351         buf_sale-doc.storage       =  'fbr-doc':U
     1352         buf_sale-doc.doc-type      = 'производство':U
     1353         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     1354         buf_sale-doc.ext-doc-type  = 'производство':U
     1355         buf_sale-doc.doc-kind      = 'производство':U
     1356         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     1357         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     1358         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     1359         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     1360         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     1361         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     1362         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     1363         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     1364         buf_sale-doc.fbrsale       = yes
     1365         buf_sale-doc.inkas-code    = p-inkas-code
     1366         .
     1367       end.
     1368     end.
     1369   end.
     1370   end procedure.
     1371   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1373   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   procedure cre-docs.
     1375   define input parameter p-auto          as integer no-undo .
     1376   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
     1377   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
     1378   define input parameter p-shift-date    like ub.inkas.shift-date no-undo .
     1379   define input parameter p-shift-num     like ub.inkas.shift-num  no-undo .
     1380   define input parameter p-filter-name   as character             no-undo .
     1381   define input parameter p-filter-str    as character             no-undo .
     1382   define input parameter p-filter-str-rus as character            no-undo .
     1383   define input parameter p-doc-mode      as character no-undo .
     1384   define output parameter p-doc-rec      as recid no-undo.
     1385   DEFINE VARIABLE sys-today as date no-undo .
     1386   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
     1387   define variable varret-code like ub.trn-doc.doc-code no-undo.
     1388   define variable v-curr-r-b as character no-undo .
     1389   define variable v-chk-pay     like ub.shop.chk-pay no-undo .
     1390   define variable v-dead-doc   as character initial no no-undo.
     1391   define variable v-type       as character initial ? no-undo.
     1392   define variable conf-attr as char no-undo.
     1393   define variable conf-par as char no-undo.
     1394   define variable par-type as char no-undo.
     1395   define variable cas-shft as logical no-undo init no.
     1396   define variable l-shift-on as logical no-undo init no.
     1397   define variable v-shift-date like ub.shift-obj.shift-date no-undo.
     1398   define variable v-shift-num  like ub.shift-obj.shift-num no-undo.
     1399   define variable v-shift-name  like ub.shift-obj.shift-name no-undo.
     1400   define variable sale-filter as logical no-undo init no.
     1401   define variable one-sale-per-day as logical no-undo .
     1402   define variable v-index as integer no-undo .
     1403   define variable v-wrkr as integer no-undo .
     1404   define variable v-agnt as integer no-undo .
     1405   define variable v-boss as integer no-undo .
     1406   define buffer buf_ret-doc     for ub.trn-doc.
     1407   define buffer buf_trn-doc     for ub.trn-doc.
     1408   define buffer buf_inkas       for ub.inkas.
     1409   define buffer buf_curr-shop   for ub.curr-shop.
     1410   define buffer buf_shift-obj for ub.shift-obj.
     1411   define variable v-mes as character no-undo .
     1412   define variable v-ps as character no-undo .
     1413   define variable v-value-character as character no-undo .
     1414   define variable v-value-date as date no-undo .
     1415   define variable v-value-decimal as decimal no-undo .
     1416   define variable v-value-integer as INTEGER no-undo .
     1417   define variable v-value-logical AS LOGICAL no-undo .
     1418   define variable v-tth as handle no-undo .
     1419   assign
     1420   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1421   define buffer buf_shop for ub.shop.
     1422   define buffer buf_sysconf for ub.sysconf.
     1423   define buffer buf_clients for ub.clients .
     1424   define buffer real_clients for ub.clients .
