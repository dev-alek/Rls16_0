        1   define input parameter parparentproc        as widget-handle    no-undo.
        2   define input parameter p-mode               as character        no-undo.
        3   define input parameter p-doc-code           as character        no-undo.
        4   define input parameter p-gds-code           as integer          no-undo.
        5   define input parameter p-recipe-code        as character        no-undo.
        6   define input parameter p-fbr-obj-type       as character        no-undo.
        7   define input parameter p-fbr-obj-code       as integer          no-undo.
        8   define input parameter p-fact-qnty          as decimal          no-undo.
        9   define output parameter p-new-recipe-code   as character        no-undo.
       10   define output parameter p-new-fbr-obj-type  as character        no-undo.
       11   define output parameter p-new-fbr-obj-code  as integer          no-undo.
       12   define output parameter p-new-fact-qnty     as decimal          no-undo.
       13   define output parameter p-cancel            as logical          no-undo.
       14   define output parameter p-cancel-cycle      as logical          no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Просмотр и редактирование строки документа план-меню".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   function chkleave returns logical
       81   (input p-widget-enter as handle
       82   ,input p-button-list  as character
       83   ).
       84     if  valid-handle(p-widget-enter)
       85     and can-query(p-widget-enter, "name":u)
       86     and lookup(p-widget-enter :name, p-button-list) > 0
       87     then do:
       88       return false .
       89     end.
       90     return true .
       91   end function.
       92   procedure proc-alt-shift-f2:
       93     if not ibs.th.gbl.gbl-var:rcode
       94   then
       95     run gbl\inidebug.p .
       96   end.
       97   procedure proc-alt-shift-f3:
       98     run gbl/prvssinf.p
       99       ( input this-procedure
      100       ) .
      101   end.
      102   define variable v-inform-launched as logical no-undo initial false .
      103   procedure proc-alt-shift-f4:
      104     define variable v-action as character no-undo .
      105     if v-inform-launched = false then do:
      106       assign
      107         v-inform-launched = true
      108       .
      109       run gbl/d-inform.w
      110         (  input self
      111         ,  input this-procedure
      112         , output v-action
      113         ) no-error .
      114       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      115       assign
      116         v-inform-launched = false
      117       .
      118     end.
      119   end.
      120   procedure proc-alt-f1:
      121     run gbl/corrhelp.p
      122       (input this-procedure
      123       ) .
      124   end .
      125   on alt-shift-f2 anywhere do:
      126     run proc-alt-shift-f2.
      127   end.
      128   on alt-shift-f3 anywhere do:
      129     run proc-alt-shift-f3 in this-procedure .
      130   end.
      131   on alt-shift-f4 anywhere do:
      132     run proc-alt-shift-f4 in this-procedure.
      133   end.
      134   on alt-f1 anywhere do:
      135     run proc-alt-f1 in this-procedure .
      136   end.
      137   define variable v-fbrplnd-kitchen-selected      as logical init no  no-undo.
      138   define buffer buf_init_recipe    for recipe.
      139   define buffer buf_init_goods     for goods.
      140   define buffer buf_init_fbr-pln   for fbr-pln.
      141   DEFINE BUTTON b-cancel
      142        LABEL "&Отмена"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON b-exit
      146        LABEL "&Ввод"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON b-help
      150        LABEL "Помощ&ь"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE BUTTON b-stop-cycle
      154        LABEL "&СтопЦикл"
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE BUTTON bt-sel-kitchen
      158        IMAGE-UP FILE "btn-down-arrow":U
      159        IMAGE-DOWN FILE "btn-down-arrow":U
      160        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      161        LABEL "..."
      162        SIZE 3.63 BY 1.04.
      163   DEFINE BUTTON bt-sel-recipe
      164        IMAGE-UP FILE "btn-down-arrow":U
      165        IMAGE-DOWN FILE "btn-down-arrow":U
      166        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      167        LABEL "..."
      168        SIZE 3.63 BY 1.04.
      169   DEFINE VARIABLE fi-artic AS CHARACTER FORMAT "X(20)":U
      170        LABEL "Артикул"
      171        VIEW-AS FILL-IN
      172        SIZE 14.38 BY 1
      173        FGCOLOR 4  NO-UNDO.
      174   DEFINE VARIABLE fi-fact-qnty AS DECIMAL FORMAT ">>,>>9.99":U INITIAL 0
      175        LABEL "Количество"
      176        VIEW-AS FILL-IN
      177        SIZE 14.38 BY 1 NO-UNDO.
      178   DEFINE VARIABLE fi-kitchen-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      179        VIEW-AS FILL-IN
      180        SIZE 7.5 BY 1
      181        FGCOLOR 4  NO-UNDO.
      182   DEFINE VARIABLE fi-kitchen-type AS CHARACTER FORMAT "X(3)":U
      183        LABEL "Кухня"
      184        VIEW-AS FILL-IN
      185        SIZE 5 BY 1
      186        FGCOLOR 4  NO-UNDO.
      187   DEFINE VARIABLE fi-name AS CHARACTER FORMAT "X(256)":U
      188        LABEL "Наименование"
      189        VIEW-AS FILL-IN
      190        SIZE 47.5 BY 1
      191        FGCOLOR 4  NO-UNDO.
      192   DEFINE VARIABLE fi-recipe-code AS CHARACTER FORMAT "X(20)":U
      193        LABEL "Рецепт"
      194        VIEW-AS FILL-IN
      195        SIZE 14.38 BY 1
      196        FGCOLOR 4  NO-UNDO.
      197   DEFINE VARIABLE fi-recipe-name AS CHARACTER FORMAT "X(256)":U
      198        VIEW-AS FILL-IN
      199        SIZE 29.38 BY 1
      200        FGCOLOR 4  NO-UNDO.
      201   DEFINE FRAME Dialog-Frame
      202        b-exit AT ROW 1.17 COL 2
      203        b-cancel AT ROW 1.17 COL 12
      204        b-stop-cycle AT ROW 1.17 COL 22
      205        b-help AT ROW 1.17 COL 52.38
      206        fi-kitchen-type AT ROW 2.5 COL 13.5 COLON-ALIGNED
      207        fi-kitchen-code AT ROW 2.5 COL 18.88 COLON-ALIGNED NO-LABEL
      208        bt-sel-kitchen AT ROW 2.5 COL 28.25
      209        fi-artic AT ROW 3.79 COL 13.5 COLON-ALIGNED
      210        fi-name AT ROW 5.04 COL 1.5
      211        fi-recipe-code AT ROW 6.29 COL 13.5 COLON-ALIGNED
      212        bt-sel-recipe AT ROW 6.29 COL 29.88
      213        fi-recipe-name AT ROW 6.29 COL 31.63 COLON-ALIGNED NO-LABEL
      214        fi-fact-qnty AT ROW 7.54 COL 13.5 COLON-ALIGNED
      215        SPACE(33.36) SKIP(0.41)
      216       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      217            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      218            TITLE "Строка документа".
      219   ASSIGN
      220          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      221          FRAME Dialog-Frame:HIDDEN           = TRUE.
      222   ON GO OF FRAME Dialog-Frame
      223   DO:
      224   END.
      225   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      226   DO:
      227     APPLY "END-ERROR":U TO SELF.
      228   END.
      229   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      230   DO:
      231       assign
      232           p-cancel   = yes
      233       .
      234       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      235   END.
      236   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      237   DO:
      238       assign
      239           fi-fact-qnty
      240           fi-kitchen-type
      241           fi-kitchen-code
      242       .
      243       if fi-kitchen-type = ""
      244       or fi-kitchen-code = 0
      245       then do:
      246           message
      247               "Выберите объект, с которого"
      248               skip "должен будет переместиться товар."
      249           view-as alert-box error.
      250           apply "entry":U to fi-kitchen-code in frame Dialog-Frame .
      251           undo, return no-apply.
      252       end.
      253       assign
      254           p-new-fbr-obj-type  = fi-kitchen-type
      255           p-new-fbr-obj-code  = fi-kitchen-code
      256           p-new-fact-qnty     = fi-fact-qnty
      257           p-cancel            = no
      258           p-cancel-cycle      = no
      259       .
      260       if available buf_init_recipe
      261       then do:
      262           assign
      263               fi-recipe-code
      264           .
      265           assign
      266               p-new-recipe-code = fi-recipe-code
      267           .
      268       end.
      269       else do:
      270           assign
      271               p-new-recipe-code = ""
      272           .
      273       end.
      274       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      275   END.
      276   ON CHOOSE OF b-stop-cycle IN FRAME Dialog-Frame
      277   DO:
      278       assign
      279           p-cancel-cycle   = yes
      280       .
      281       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      282   END.
      283   ON CHOOSE OF bt-sel-kitchen IN FRAME Dialog-Frame
      284   DO:
      285       define variable v-is-invalid    as logical        no-undo.
      286       run select-kitchen in this-procedure (
      287             input fi-kitchen-type
      288           , input fi-kitchen-code
      289           , output fi-kitchen-type
      290           , output fi-kitchen-code
      291       ).
      292       display
      293           fi-kitchen-type
      294           fi-kitchen-code
      295       with frame Dialog-Frame.
      296       run check-object in this-procedure (
      297             input fi-kitchen-type :screen-value
      298           , input integer( fi-kitchen-code :screen-value )
      299           , output v-is-invalid
      300       ).
      301       if v-is-invalid = yes
      302       then do:
      303           message
      304               "Объект выбран неверно."
      305               skip(1)
      306               "Введите код объекта или выберите объект."
      307           view-as alert-box error.
      308           apply "entry" to fi-kitchen-code.
      309       end.
      310   END.
      311   ON CHOOSE OF bt-sel-recipe IN FRAME Dialog-Frame
      312   DO:
      313       define variable v-recipe-recid-list    as character      no-undo.
      314       define buffer buf_fbr-pln       for fbr-pln.
      315       find first buf_fbr-pln no-lock
      316            where buf_fbr-pln.doc-code = p-doc-code
      317       .
      318       run ref/rcp-all.w (
      319             input parparentproc
      320           , input "b-add,b-sel"
      321           , input 'все':U
      322           , input recid( buf_init_goods )
      323           , input buf_fbr-pln.obj-type
      324           , input buf_fbr-pln.obj-code
      325           , output v-recipe-recid-list
      326       ) no-error.
      327       if error-status :error
      328       or v-recipe-recid-list = ""
      329       then do:
      330       end.
      331       else do:
      332           find first buf_init_recipe no-lock
      333                where recid( buf_init_recipe ) = integer( entry( 1, v-recipe-recid-list ) )
      334           .
      335           assign
      336               fi-recipe-code  = buf_init_recipe.recipe-code
      337               fi-recipe-name  = buf_init_recipe.recipe-name
      338           .
      339           display
      340               fi-recipe-code
      341               fi-recipe-name
      342           with frame Dialog-Frame.
      343       end.
      344   END.
      345   ON RETURN OF fi-fact-qnty IN FRAME Dialog-Frame
      346   DO:
      347       apply "entry" to b-exit.
      348       return no-apply.
      349   END.
      350   ON LEAVE OF fi-kitchen-code IN FRAME Dialog-Frame
      351   DO:
      352       define variable v-is-invalid    as logical        no-undo.
      353       if chkleave (
      354            input last-event :widget-enter
      355          , input "b-cancel,b-help,b-stop-cycle":u
      356       )
      357       then do:
      358           run check-object in this-procedure (
      359                 input fi-kitchen-type :screen-value
      360               , input integer( fi-kitchen-code :screen-value )
      361               , output v-is-invalid
      362           ).
      363           if v-is-invalid = yes
      364           then do:
      365               message
      366                   "Неверно выбран объект."
      367                   skip "Выберите объект из списка."
      368               view-as alert-box warning.
      369               run select-kitchen in this-procedure (
      370                     input fi-kitchen-type :screen-value
      371                   , input integer( fi-kitchen-code :screen-value )
      372                   , output fi-kitchen-type
      373                   , output fi-kitchen-code
      374               ) no-error.
      375               if error-status :error
      376               then do:
      377                   message
      378                           vss-workfile vss-revision vss-description
      379                       skip(1)
      380                       skip "Ошибка выбора объекта."
      381                       skip return-value
      382                       skip trim(error-status :get-message(1))
      383                           trim(error-status :get-message(2))
      384                           trim(error-status :get-message(3))
      385                   view-as alert-box error.
      386                   undo, return no-apply .
      387               end.
      388               run check-object in this-procedure (
      389                     input fi-kitchen-type
      390                   , input fi-kitchen-code
      391                   , output v-is-invalid
      392               ).
      393               if v-is-invalid = yes
      394               then do:
      395                   message
      396                       "Объект не найден"
      397                       skip "или не определен тип объекта"
      398                   view-as alert-box error.
      399                   undo, return no-apply.
      400               end.
      401               display
      402                   fi-kitchen-type
      403                   fi-kitchen-code
      404               with frame Dialog-Frame.
      405               return no-apply.
      406           end.
      407       end.
      408   END.
      409   ON RETURN OF fi-kitchen-code IN FRAME Dialog-Frame
      410   DO:
      411       define variable v-is-invalid    as logical      no-undo.
      412       run get-obj-type in this-procedure (
      413             input integer( fi-kitchen-code :screen-value )
      414           , output fi-kitchen-type
      415       ) no-error.
      416       if error-status :error
      417       then do:
      418           message
      419                    vss-workfile vss-revision vss-description
      420               skip "Ошибка при определении типа объекта."
      421               skip return-value
      422               skip trim(error-status :get-message(1))
      423                    trim(error-status :get-message(2))
      424                    trim(error-status :get-message(3))
      425           view-as alert-box error.
      426           undo, return no-apply .
      427       end.
      428       if fi-kitchen-type = ?
      429       then do:
      430           run select-kitchen in this-procedure (
      431                 input fi-kitchen-type
      432               , input fi-kitchen-code
      433               , output fi-kitchen-type
      434               , output fi-kitchen-code
      435           ) no-error.
      436           if error-status :error
      437           then do:
      438               message
      439                        vss-workfile vss-revision vss-description
      440                   skip(1)
      441                   skip "Ошибка выбора объекта."
      442                   skip return-value
      443                   skip trim(error-status :get-message(1))
      444                        trim(error-status :get-message(2))
      445                        trim(error-status :get-message(3))
      446               view-as alert-box error.
      447               undo, return no-apply .
      448           end.
      449           run check-object in this-procedure (
      450                 input fi-kitchen-type
      451               , input fi-kitchen-code
      452               , output v-is-invalid
      453           ).
      454           if v-is-invalid = yes
      455           then do:
      456               message
      457                   "Объект не найден"
      458                   skip "или не определен тип объекта"
      459               view-as alert-box error.
      460               undo, return no-apply.
      461           end.
      462           display
      463               fi-kitchen-type
      464               fi-kitchen-code
      465           with frame Dialog-Frame.
      466       end.
      467       else do:
      468           display
      469               fi-kitchen-type
      470           with frame Dialog-Frame .
      471       end.
      472       apply "entry":U to fi-fact-qnty in frame Dialog-Frame .
      473       return no-apply.
      474   END.
      475   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   on help of frame Dialog-Frame
      477   do:
      478     run gbl/app_help.p
      479       (input this-procedure :file-name
      480       ,input ''
      481       ,input ?
      482       ) no-error.
      483     if error-status :error then do:
      484       message
      485         "Ошибка при вызове помощи"
      486         error-status :get-message(1)
      487         view-as alert-box .
      488     end.
      489   end.
      490   run minbtn-set in this-procedure .
      491   on choose of b-help in frame Dialog-Frame
      492   do:
      493     apply "help":u to frame Dialog-Frame .
      494   end.
      495   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   procedure minbtn-set :
      497       do
      498           on error undo, return error return-value
      499           :
      500           define variable ii              as integer       no-undo .
      501           define variable fh              as widget-handle no-undo .
      502           define variable hh              as widget-handle no-undo .
      503           define variable v-h             as handle        extent 4 no-undo .
      504           define variable v-name-button   as character     no-undo .
      505           define variable v-help-old-x    as decimal       no-undo .
      506           define variable v-help-old-y    as decimal       no-undo .
      507           define variable v-help-old-size as decimal       no-undo .
      508           define variable v-frame-width   as decimal       no-undo .
      509           define variable jj              as integer       no-undo .
      510           do
      511               on error undo, return error
      512               :
      513               assign
      514                   v-frame-width = frame Dialog-Frame:width - 0.3
      515                   fh            = frame Dialog-Frame:first-child
      516                   hh            = fh:first-child
      517                   ii            = 1
      518                   .
      519               do while valid-handle(hh):
      520                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      521                   do:
      522                       case lc(hh:name) :
      523                           when "b-help" then
      524                               do:
      525                                   hh:load-image-up("cmp/b-help.bmp":u) .
      526                                   hh:load-image-down("cmp/b-help.bmp":u) .
      527                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      528                                   hh:TOOLTIP = "Помощь" .
      529                                   v-help-old-x = hh:column .
      530                                   v-help-old-y = hh:row    .
      531                                   v-help-old-size = hh:width .
      532                                   hh:width-chars = 2.5 .
      533                               end.
      534                           when "b-print" then
      535                               do:
      536                                   hh:load-image("cmp/b-print.bmp":u) .
      537                                   hh:TOOLTIP = "Печать" .
      538                                   v-h[ii] = hh:handle .
      539                                   ii = ii + 1 .
      540                                   hh:width-chars = 3 .
      541                               end.
      542                           when "b-history" or
      543                           when "b-hist" then
      544                               do:
      545                                   hh:load-image("cmp/b-hist.bmp":u) .
      546                                   hh:TOOLTIP = "История" .
      547                                   v-h[ii] = hh:handle .
      548                                   ii = ii + 1 .
      549                                   hh:width-chars = 3 .
      550                               end.
      551                           when "b-sch" then
      552                               do:
      553                                   hh:load-image("cmp/b-sch.bmp":u) .
      554                                   hh:TOOLTIP = "Установка Фильтра" .
      555                                   v-h[ii] = hh:handle .
      556                                   ii = ii + 1 .
      557                                   hh:width-chars = 3 .
      558                               end.
      559                           when "b-hist-user" then
      560                               do:
      561                                   hh:load-image("cmp/b-hist.bmp":u) .
      562                                   hh:TOOLTIP = "История пользователя" .
      563                                   ii = ii + 1 .
      564                               end.
      565                       end case.
      566                   end.
      567                   hh = hh:next-sibling.
      568               end.
      569               b-help:column = v-frame-width - b-help:width-chars.
      570               jj = 0.
      571               repeat ii = 4 to 1 by -1 :
      572                   if valid-handle (v-h[ii] ) then
      573                   do:
      574                       jj  = jj + 1 .
      575                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      576                       v-h[ii]:row    = v-help-old-y .
      577                   end.
      578               end.
      579           end.
      580       end.
      581   end procedure.
      582   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      583   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      584   MAIN-BLOCK:
      585   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      586      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      587       run init-fields in this-procedure no-error.
      588       if error-status :error
      589       then do:
      590           assign
      591               p-cancel   = yes
      592           .
      593           apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      594       end.
      595       RUN enable_UI.
      596       if p-mode = 'ПРОСМОТР':U
      597       then do:
      598           apply "entry" to b-exit in frame Dialog-Frame .
      599           disable
      600               fi-fact-qnty
      601               bt-sel-recipe
      602               bt-sel-kitchen
      603               fi-kitchen-code
      604           with frame Dialog-Frame .
      605           assign
      606               fi-fact-qnty :fgcolor = 4
      607           .
      608       end.
      609       else do:
      610           if not available buf_init_recipe
      611           then do:
      612               disable
      613                   bt-sel-recipe
      614               with frame Dialog-Frame .
      615               apply "entry" to fi-kitchen-code in frame Dialog-Frame .
      616           end.
      617           else do:
      618               apply "entry" to fi-fact-qnty in frame Dialog-Frame .
      619           end.
      620       end.
      621       WAIT-FOR GO OF FRAME Dialog-Frame.
      622   END.
      623   RUN disable_UI.
      624   PROCEDURE check-object :
      625   do
      626   on error undo, return error
      627   :
      628   define input parameter p-obj-type       as character    no-undo.
      629   define input parameter p-obj-code       as integer      no-undo.
      630   define output parameter p-is-invalid    as logical      no-undo.
      631       define buffer buf_clients       for clients.
      632       find first buf_clients no-lock
      633            where buf_clients.obj-type = p-obj-type
      634              and buf_clients.obj-code = p-obj-code
      635       no-error.
      636       if not available buf_clients
      637       or ( buf_clients.obj-type <> 'маг':U
      638           and buf_clients.obj-type <> 'скл':U )
      639       then do:
      640           assign
      641               p-is-invalid = yes
      642           .
      643       end.
      644       else do:
      645           assign
      646               p-is-invalid = no
      647           .
      648       end.
      649   end.
      650   END PROCEDURE.
      651   PROCEDURE disable_UI :
      652     HIDE FRAME Dialog-Frame.
      653   END PROCEDURE.
      654   PROCEDURE enable_UI :
      655     DISPLAY fi-kitchen-type fi-kitchen-code fi-artic fi-name fi-recipe-code
      656             fi-recipe-name fi-fact-qnty
      657         WITH FRAME Dialog-Frame.
      658     ENABLE b-exit b-cancel b-stop-cycle b-help fi-kitchen-code bt-sel-kitchen
      659            bt-sel-recipe fi-fact-qnty
      660         WITH FRAME Dialog-Frame.
      661     VIEW FRAME Dialog-Frame.
      662   END PROCEDURE.
      663   PROCEDURE get-obj-type :
      664   do
      665   on error undo, return error
      666   :
      667   define input parameter p-obj-code   as integer      no-undo.
      668   define output parameter p-obj-type  as character    no-undo.
      669       define buffer buf_shop_clients      for clients.
      670       define buffer buf_stock_clients     for clients.
      671       find first buf_shop_clients no-lock
      672            where buf_shop_clients.obj-type = 'маг':U
      673              and buf_shop_clients.obj-code = p-obj-code
      674       no-error.
      675       find first buf_stock_clients no-lock
      676            where buf_stock_clients.obj-type = 'скл':U
      677              and buf_stock_clients.obj-code = p-obj-code
      678       no-error.
      679       if available buf_shop_clients
      680       then do:
      681           if available buf_stock_clients
      682           then do:
      683               run str/fbrplnds.w (
      684                     input "Выберите тип объекта:"
      685                   , output p-obj-type
      686               ) no-error.
      687               if error-status :error
      688               then do:
      689                   message
      690                            vss-workfile vss-revision vss-description
      691                       skip "Ошибка определения типа объекта."
      692                       skip return-value
      693                       skip trim(error-status :get-message(1))
      694                            trim(error-status :get-message(2))
      695                            trim(error-status :get-message(3))
      696                   view-as alert-box error.
      697                   assign
      698                       p-obj-type = ?
      699                   .
      700                   undo, return error .
      701               end.
      702           end.
      703           else do:
      704               assign
      705                   p-obj-type = buf_shop_clients.obj-type
      706               .
      707           end.
      708       end.
      709       else do:
      710           if available buf_stock_clients
      711           then do:
      712               assign
      713                   p-obj-type = buf_stock_clients.obj-type
      714               .
      715           end.
      716           else do:
      717               assign
      718                   p-obj-type = ?
      719               .
      720           end.
      721       end.
      722   end.
      723   END PROCEDURE.
      724   PROCEDURE init-fields :
      725   do
      726   on error undo, return error
      727   :
      728       define buffer buf_goods         for goods.
      729       define buffer buf_recipe        for recipe.
      730       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
      731       find first buf_init_fbr-pln no-lock
      732            where buf_init_fbr-pln.doc-code = p-doc-code
      733       .
      734       find first buf_init_goods no-lock
      735            where buf_init_goods.gds-code = p-gds-code
      736       .
      737       find first buf_recipe no-lock
      738            where buf_recipe.artic     = buf_init_goods.artic
      739              and buf_recipe.prod-type = buf_init_goods.prod-type
      740              and buf_recipe.prod-code = buf_init_goods.prod-code
      741       no-error.
      742       if available buf_recipe
      743       and ( buf_recipe.recipe-type = 'производство':U
      744          or buf_recipe.recipe-type = 'альтернатива':U )
      745       and p-fbr-obj-type = ""
      746       and p-fbr-obj-code = 0
      747       then do:
      748           find first buf_fbr-gds-obj no-lock
      749                where buf_fbr-gds-obj.obj-type = buf_init_fbr-pln.obj-type
      750                  and buf_fbr-gds-obj.obj-code = buf_init_fbr-pln.obj-code
      751                  and buf_fbr-gds-obj.gds-code = p-gds-code
      752           no-error.
      753           if not available buf_fbr-gds-obj
      754           then do:
      755               message
      756                   skip "Не задан объект для производства товара с рецептом."
      757                   skip "Товар: " buf_init_goods.artic buf_init_goods.gds-name
      758                   skip(1)
      759                   skip "Товар не может быть включен в план-меню."
      760                   skip(1)
      761                   skip "Необходимо определить атрибуты товара для ресторана."
      762                   skip return-value
      763                   skip trim(error-status :get-message(1))
      764                        trim(error-status :get-message(2))
      765                        trim(error-status :get-message(3))
      766               view-as alert-box error.
      767               undo, return error .
      768           end.
      769           else do:
      770               assign
      771                   p-fbr-obj-type  = buf_fbr-gds-obj.fbr-obj-type
      772                   p-fbr-obj-code  = buf_fbr-gds-obj.fbr-obj-code
      773               .
      774           end.
      775       end.
      776       find first buf_init_recipe no-lock
      777            where buf_init_recipe.recipe-code = p-recipe-code
      778       no-error.
      779       assign
      780           fi-artic        = buf_init_goods.artic
      781           fi-name         = buf_init_goods.gds-name
      782           fi-kitchen-type = p-fbr-obj-type
      783           fi-kitchen-code = p-fbr-obj-code
      784           fi-fact-qnty    = p-fact-qnty
      785       .
      786       if available buf_init_recipe
      787       then do:
      788           assign
      789               fi-recipe-code  = p-recipe-code
      790               fi-recipe-name  = buf_init_recipe.recipe-name
      791           .
      792       end.
      793       else do:
      794           assign
      795               fi-kitchen-type :label in frame Dialog-Frame = "Склад"
      796           .
      797       end.
      798   end.
      799   END PROCEDURE.
      800   PROCEDURE select-kitchen :
      801   define input parameter p-old-obj-type   as character    no-undo.
      802   define input parameter p-old-obj-code   as integer      no-undo.
      803   define output parameter p-new-obj-type   as character    no-undo.
      804   define output parameter p-new-obj-code   as integer      no-undo.
      805       define variable v-types as character no-undo .
      806       define variable v-old-cli-recid    as recid      no-undo.
      807       define variable v-new-cli-recid    as recid      no-undo.
      808       define buffer buf_clients       for clients.
      809   do
      810   on error undo, return error
      811   :
      812       assign
      813           v-types = 'маг':U
      814       .
      815       find first buf_clients no-lock
      816            where buf_clients.obj-type = p-old-obj-type
      817              and buf_clients.obj-code = p-old-obj-code
      818       no-error.
      819       if available buf_clients
      820       then do:
      821           assign
      822               v-old-cli-recid = recid( buf_clients )
      823           .
      824       end.
      825       else do:
      826           assign
      827               v-old-cli-recid = ?
      828           .
      829       end.
      830       run ref/cli-all.w (
      831             input parparentproc
      832           , input "b-sel"
      833           , input v-types
      834           , input ?
      835           , input ?
      836           , input v-old-cli-recid
      837           , input ?
      838           , input ?
      839           , output v-new-cli-recid
      840       ) .
      841       find first buf_clients no-lock
      842            where recid( buf_clients ) = v-new-cli-recid
      843       no-error.
      844       if available buf_clients
      845       then do:
      846           assign
      847               p-new-obj-type = buf_clients.obj-type
      848               p-new-obj-code = buf_clients.obj-code
      849           .
      850       end.
      851       else do:
      852           assign
      853               p-new-obj-type = ""
      854               p-new-obj-code = 0
      855           .
      856       end.
      857   end.
      858   END PROCEDURE.
