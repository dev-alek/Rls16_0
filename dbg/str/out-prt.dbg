     3502                     message
     3503                       substitute( "Ошибка по результатам сверки." ) skip
     3504                       substitute( "Место хранения: &1 .", v-pl-code ) skip
     3505                       substitute( "Количество залитого топлива: &1 (&2).", v-rvs-cli-qnty-after - v-rvs-cli-qnty-before, buf_goods.unit-cli ) skip
     3506                       view-as alert-box .
     3507                     undo block_tr, return error .
     3508                   end.
     3509                   assign
     3510                     v-rvs-density = (v-rvs-cli-qnty-after - v-rvs-cli-qnty-before) / (v-rvs-qnty-after - v-rvs-qnty-before)
     3511                   .
     3512                   if Valid-Density( v-rvs-density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true then do:
     3513                     message
     3514                       substitute( "Ошибка по результатам сверки." ) skip
     3515                       substitute( "Место хранения: &1 .", v-pl-code ) skip
     3516                       substitute( "Плотность залитого топлива: &1.", v-rvs-density ) skip
     3517                       view-as alert-box .
     3518                     undo block_tr, return error .
     3519                   end.
     3520                 end.
     3521               end.
     3522           end.
     3523         end.
     3524       end procedure.
     3525       procedure proc-b-addinfo :
     3526         define input        parameter parParentProc          as   handle                   no-undo .
     3527         define input        parameter p-mode                 as   character                no-undo .
     3528         define input        parameter p-doc-code             like ub.doc-line.doc-code     no-undo .
     3529         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     3530         define input        parameter p-stfactplvalue        as   character                no-undo .
     3531         define input        parameter p-auto-tank            as   logical                  no-undo .
     3532         define input        parameter p-fact-edit            as   logical                  no-undo .
     3533         define input        parameter p-doc-qnty             like ub.doc-line.doc-qnty     no-undo .
     3534         define input        parameter p-doc-density          like ub.doc-line.doc-density  no-undo .
     3535         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     3536         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     3537         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     3538         define input-output parameter p-prt-car-num          as   character                no-undo .
     3539         define input-output parameter p-prt-car-vol          as   character                no-undo .
     3540         define input-output parameter p-prt-tests            as   character                no-undo .
     3541         define input-output parameter p-prt-autoent-obj-type as   character                no-undo .
     3542         define input-output parameter p-prt-autoent-obj-code as   character                no-undo .
     3543         define input-output parameter p-prt-item-pour        as   character                no-undo .
     3544         define input-output parameter p-prt-time-pour        as   character                no-undo .
     3545         define input-output parameter p-prt-tank-vol         as   character                no-undo .
     3546         define input-output parameter p-prt-tank-temp        as   character                no-undo .
     3547         define input-output parameter p-prt-tank-water       as   character                no-undo .
     3548         define input-output parameter p-prt-tank-density     as   character                no-undo .
     3549         define input-output parameter p-prt-tank-weight      as   character                no-undo .
     3550         define input-output parameter p-prt-time-income      as   character                no-undo .
     3551         define input-output parameter p-prt-start-real-date  like ub.rvs-line.real-date    no-undo .
     3552         define input-output parameter p-prt-start-real-time  like ub.rvs-line.real-time    no-undo .
     3553         define input-output parameter p-prt-end-real-date    like ub.rvs-line.real-date    no-undo .
     3554         define input-output parameter p-prt-end-real-time    like ub.rvs-line.real-time    no-undo .
     3555         define input-output parameter p-prt-mouth            as   character                no-undo .
     3556         define input-output parameter p-prt-fio              as   character                no-undo .
     3557         define input-output parameter p-prt-ptbotype         as   character                no-undo .
     3558         define input-output parameter p-prt-ptbocode         as   character                no-undo .
     3559         define input-output parameter p-prt-a-b-tarir        as   character                no-undo .
     3560         define input-output parameter p-diameter             as   character                no-undo .
     3561         define input-output parameter p-place-si             as   character                no-undo .
     3562         define input-output parameter p-tank-density-pomi    as   character                no-undo .
     3563         define input-output parameter p-prt-certif-fuel      as character    no-undo .
     3564         define input-output parameter p-prt-norm-doc         as character    no-undo .
     3565         define input-output parameter p-prt-num-passport     as character    no-undo .
     3566         define input-output parameter p-prt-validity-certif  as character    no-undo .
     3567         define input-output parameter p-prt-passport-plotn   as   character             no-undo .
     3568         define input-output parameter p-prt-num-plotn        as   character             no-undo .
     3569         define input-output parameter p-prt-date-pov-plotn   like ub.rvs-line.real-date no-undo .
     3570         do
     3571         on error  undo, return error substitute( "&1 (proc-b-addinfo). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3572         on stop   undo, return error substitute( "&1 (proc-b-addinfo). stop", vss-workfile )
     3573         on endkey undo, return error substitute( "&1 (proc-b-addinfo). endkey", vss-workfile )
     3574         :
     3575           define buffer buf_rvs-doc  for ub.rvs-doc   .
     3576           define buffer buf_rvs-line for ub.rvs-line  .
     3577           define buffer buf_goods    for ub.goods .
     3578           define variable v-new-fact-qnty     like ub.doc-line.fact-qnty    no-undo .
     3579           define variable v-new-density       like ub.doc-line.fact-density no-undo .
     3580           define variable v-new-cli-fact-qnty like ub.doc-line.fact-qnty    no-undo .
     3581           define variable v-chg               as   logical                  no-undo .
     3582           define variable v-log               as   logical                  no-undo .
     3583           define variable v-st-doc            as   logical                  no-undo .
     3584           define variable v-setting           as   logical                  no-undo .
     3585           block_tr:
     3586           do transaction
     3587           on error  undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3588           on stop   undo block_tr, return error substitute( "&1. stop", vss-workfile )
     3589           on endkey undo block_tr, return error substitute( "&1. endkey", vss-workfile )
     3590           :
     3591             find first buf_goods no-lock
     3592               where buf_goods.gds-code = p-gds-code
     3593               .
     3594             if p-prt-start-real-date = ?
     3595               or p-prt-start-real-time = ?
     3596             then do:
     3597               find first buf_rvs-doc
     3598                 where buf_rvs-doc.rvs-type = 'перед_док':U
     3599                   and buf_rvs-doc.out-code = p-doc-code
     3600                 no-error .
     3601               if available buf_rvs-doc then do:
     3602                 for each buf_rvs-line
     3603                   where buf_rvs-line.gds-code = p-gds-code
     3604                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-type
     3605                     and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     3606                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     3607                 on error undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3608                 :
     3609                   if buf_rvs-line.real-date <> ?
     3610                     and buf_rvs-line.real-time <> ?
     3611                     and ( p-prt-start-real-date > buf_rvs-line.real-date
     3612                           or ( p-prt-start-real-date = buf_rvs-line.real-date
     3613                               and p-prt-start-real-time > buf_rvs-line.real-time
     3614                             )
     3615                         )
     3616                   then do:
     3617                     assign
     3618                       p-prt-start-real-date = buf_rvs-line.real-date
     3619                       p-prt-start-real-time = buf_rvs-line.real-time
     3620                     .
     3621                   end.
     3622                 end.
     3623               end.
     3624             end.
     3625             if p-prt-end-real-date = ?
     3626               or p-prt-end-real-time = ?
     3627             then do:
     3628               find first buf_rvs-doc
     3629                 where buf_rvs-doc.rvs-type = 'после_док':U
     3630                   and buf_rvs-doc.out-code = p-doc-code
     3631                 no-error .
     3632               if available buf_rvs-doc then do:
     3633                 for each buf_rvs-line
     3634                   where buf_rvs-line.gds-code = p-gds-code
     3635                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     3636                     and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     3637                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     3638                 on error undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3639                 :
     3640                   if buf_rvs-line.real-date <> ?
     3641                     and buf_rvs-line.real-time <> ?
     3642                     and ( p-prt-end-real-date < buf_rvs-line.real-date
     3643                           or ( p-prt-end-real-date = buf_rvs-line.real-date
     3644                               and p-prt-end-real-time < buf_rvs-line.real-time
     3645                             )
     3646                         )
     3647                   then do:
     3648                     assign
     3649                       p-prt-end-real-date = buf_rvs-line.real-date
     3650                       p-prt-end-real-time = buf_rvs-line.real-time
     3651                     .
     3652                   end.
     3653                 end.
     3654               end.
     3655             end.
     3656             run str/in-laddout.w
     3657               ( input        parParentProc
     3658                ,input        p-mode
     3659                ,input        p-doc-code
     3660                ,input        p-gds-code
     3661                ,input-output p-prt-car-num
     3662                ,input-output p-prt-car-vol
     3663                ,input-output p-prt-tests
     3664                ,input-output p-prt-autoent-obj-type
     3665                ,input-output p-prt-autoent-obj-code
     3666                ,input-output p-prt-item-pour
     3667                ,input-output p-prt-time-pour
     3668                ,input-output p-prt-tank-vol
     3669                ,input-output p-prt-tank-temp
     3670                ,input-output p-prt-tank-water
     3671                ,input-output p-prt-tank-density
     3672                ,input-output p-prt-tank-weight
     3673                ,input-output p-prt-time-income
     3674                ,input-output p-prt-start-real-date
     3675                ,input-output p-prt-start-real-time
     3676                ,input-output p-prt-end-real-date
     3677                ,input-output p-prt-end-real-time
     3678                ,input-output p-prt-mouth
     3679                ,input-output p-prt-fio
     3680                ,input-output p-prt-ptbotype
     3681                ,input-output p-prt-ptbocode
     3682                ,input-output p-prt-a-b-tarir
     3683                ,input-output p-diameter
     3684                ,input-output p-place-si
     3685                ,input-output p-tank-density-pomi
     3686                ,input-output p-prt-certif-fuel
     3687                ,input-output p-prt-norm-doc
     3688                ,input-output p-prt-num-passport
     3689                ,input-output p-prt-validity-certif
     3690                ,input-output p-prt-passport-plotn
     3691                ,input-output p-prt-num-plotn
     3692                ,input-output p-prt-date-pov-plotn
     3693                ,      output v-setting
     3694               ) no-error .
     3695             if error-status :error then do:
     3696               undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     3697             end.
     3698             if v-setting = true
     3699               and p-mode <> 'ПРОСМОТР':U
     3700               and p-stfactplvalue <> "":U
     3701               and p-auto-tank = true
     3702             then do:
     3703               assign
     3704                 v-new-fact-qnty = p-new-fact-qnty
     3705               .
     3706   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     3707     ( input        p-stfactplvalue
     3708     , input        p-doc-qnty
     3709     , input        p-doc-density
     3710     , input        0.00
     3711     , input        0.00
     3712     , input        p-prt-tank-vol
     3713     , input        decimal(p-prt-tank-density)
     3714     , input        no
     3715     , input-output v-new-fact-qnty
     3716     ,       output v-chg
     3717     ,       output v-st-doc
     3718     )              no-error
     3719   .
     3720               if error-status :error then do:
     3721                 undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     3722               end.
     3723               if p-new-fact-qnty <> v-new-fact-qnty
     3724                 or v-chg       =  yes
     3725                 or v-st-doc    =  yes
     3726               then do:
     3727                 assign
     3728                   v-new-density = ( if v-st-doc = yes then p-doc-density else decimal( p-prt-tank-density ) )
     3729                   v-log         = yes
     3730                 .
     3731                 if decimal( p-prt-tank-vol ) <> p-new-fact-qnty
     3732                   or v-new-density <> p-new-density
     3733                 then do:
     3734                   if p-fact-edit = true then do:
     3735                     message
     3736                       substitute( "По результатам измерения автоцистерны фактическое кол-во необходимо изменить." ) skip
     3737                       substitute( "Будем менять фактические" ) skip
     3738                       substitute( "количество на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     3739                       substitute( "плотность на &1 ?", v-new-density ) skip
     3740                       view-as alert-box question buttons yes-no update v-log .
     3741                   end.
     3742                   else do:
     3743                     message
     3744                       substitute( "По результатам измерения фактическое кол-во товара изменяется на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     3745                       substitute( "фактическая плотность на &1.", v-new-density ) skip
     3746                       view-as alert-box information .
     3747                   end.
     3748                 end.
     3749                 if v-log = yes then do:
     3750                   assign
     3751                     p-new-fact-qnty     = v-new-fact-qnty
     3752                     p-new-density       = v-new-density
     3753                     p-new-cli-fact-qnty = p-new-fact-qnty * p-new-density
     3754                   .
     3755                 end.
     3756               end.
     3757             end.
     3758           end.
     3759         end.
     3760       end procedure.
     3761       procedure chkdcrvs :
     3762         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     3763         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     3764         define output parameter p-ok       as   logical             no-undo .
     3765         do
     3766         on error undo, return error return-value
     3767         :
     3768           define buffer buf-before_rvs-doc  for ub.rvs-doc  .
     3769           define buffer buf-before_rvs-line for ub.rvs-line .
     3770           define buffer buf-after_rvs-doc   for ub.rvs-doc  .
     3771           define buffer buf-after_rvs-line  for ub.rvs-line .
     3772           assign
     3773             p-ok = false
     3774           .
     3775           find first tt-doc-pl no-lock
     3776             no-error .
     3777           if not available tt-doc-pl then do:
     3778             return error substitute( 'Документ "&1", товар &2: нет разбивки по местам хранения.', p-doc-code, p-gds-code ) .
     3779           end.
     3780           find first buf-before_rvs-doc no-lock
     3781             where buf-before_rvs-doc.rvs-type = 'перед_док':U
     3782               and buf-before_rvs-doc.out-code = p-doc-code
     3783             no-error .
     3784           if not available buf-before_rvs-doc then do:
     3785             return substitute( 'По документу "&1" нет сверки <<до налива топлива>>.', p-doc-code ).
     3786           end.
     3787           find first buf-after_rvs-doc no-lock
     3788             where buf-after_rvs-doc.rvs-type = 'после_док':U
     3789               and buf-after_rvs-doc.out-code = p-doc-code
     3790             no-error .
     3791           if not available buf-after_rvs-doc then do:
     3792             return substitute( 'По документу "&1" нет сверки <<после налива топлива>>.', p-doc-code ).
     3793           end.
     3794           for each tt-doc-pl no-lock
     3795           on error undo, return error return-value
     3796           :
     3797             find first buf-before_rvs-line no-lock
     3798               where buf-before_rvs-line.rvs-code = buf-before_rvs-doc.rvs-code
     3799                 and buf-before_rvs-line.obj-type = buf-before_rvs-doc.obj-type
     3800                 and buf-before_rvs-line.obj-code = buf-before_rvs-doc.obj-code
     3801                 and buf-before_rvs-line.pl-code  = tt-doc-pl.pl-code
     3802                 and buf-before_rvs-line.gds-code = tt-doc-pl.gds-code
     3803               no-error .
     3804             if not available buf-before_rvs-line then do:
     3805               return substitute( 'По документу "&1" для товара &2 на месте хранения &3 нет строки сверки <<до налива топлива>>.'
     3806                                  ,p-doc-code
     3807                                  ,p-gds-code
     3808                                  ,tt-doc-pl.pl-code
     3809                                ).
     3810             end.
     3811             find first buf-after_rvs-line no-lock
     3812               where buf-after_rvs-line.rvs-code = buf-after_rvs-doc.rvs-code
     3813                 and buf-after_rvs-line.obj-type = buf-after_rvs-doc.obj-type
     3814                 and buf-after_rvs-line.obj-code = buf-after_rvs-doc.obj-code
     3815                 and buf-after_rvs-line.pl-code  = tt-doc-pl.pl-code
     3816                 and buf-after_rvs-line.gds-code = tt-doc-pl.gds-code
     3817               no-error .
     3818             if not available buf-after_rvs-line then do:
     3819               return substitute( 'По документу "&1" для товара &2 на месте хранения &3 нет строки сверки <<после налива топлива>>.'
     3820                                  ,p-doc-code
     3821                                  ,p-gds-code
     3822                                  ,tt-doc-pl.pl-code
     3823                                ).
     3824             end.
     3825             if is-gas(buf-after_rvs-line.gds-code) then next.
     3826             run placelib_get-attr(input "place-virtual"
     3827                                    ,input buf-after_rvs-line.obj-code
     3828                                    ,input buf-after_rvs-line.obj-type
     3829                                    ,input buf-after_rvs-line.pl-code
     3830                                    ,output v-value
     3831                                    ,output v-ok) no-error.
     3832             is-vir = if (v-ok and logical(v-value)) then true else false.
     3833             if is-vir then next.
     3834             if buf-before_rvs-line.state-measure-qnty = ? then do:
     3835               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<до налива топлива>>.'
     3836                                  ,p-doc-code
     3837                                  ,p-gds-code
     3838                                  ,tt-doc-pl.pl-code
     3839                                  ,chr(10)
     3840                                  ,buf_goods.unit-base
     3841                                ).
     3842             end.
     3843             if buf-before_rvs-line.state-measure-cli-qnty = ? then do:
     3844               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<до налива топлива>>.'
     3845                                  ,p-doc-code
     3846                                  ,p-gds-code
     3847                                  ,tt-doc-pl.pl-code
     3848                                  ,chr(10)
     3849                                  ,buf_goods.unit-cli
     3850                                ).
     3851             end.
     3852             if buf-before_rvs-line.state-density = ? then do:
     3853               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задана плотность в сверке <<до налива топлива>>.'
     3854                                       ,p-doc-code
     3855                                       ,p-gds-code
     3856                                       ,tt-doc-pl.pl-code
     3857                                       ,chr(10)
     3858                                     ).
     3859             end.
     3860             if buf-after_rvs-line.state-measure-qnty = ? then do:
     3861               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<после налива топлива>>.'
     3862                                       ,p-doc-code
     3863                                       ,p-gds-code
     3864                                       ,tt-doc-pl.pl-code
     3865                                       ,chr(10)
     3866                                       ,buf_goods.unit-base
     3867                                     ).
     3868             end.
     3869             if buf-after_rvs-line.state-measure-cli-qnty = ? then do:
     3870               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<после налива топлива>>.'
     3871                                       ,p-doc-code
     3872                                       ,p-gds-code
     3873                                       ,tt-doc-pl.pl-code
     3874                                       ,chr(10)
     3875                                       ,buf_goods.unit-cli
     3876                                     ).
     3877             end.
     3878             if buf-after_rvs-line.state-density = ? then do:
     3879               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задана плотность в сверке <<после налива топлива>>.'
     3880                                       ,p-doc-code
     3881                                       ,p-gds-code
     3882                                       ,tt-doc-pl.pl-code
     3883                                       ,chr(10)
     3884                                     ).
     3885             end.
     3886           end.
     3887           assign
     3888             p-ok = true
     3889           .
     3890         end.
     3891       end procedure.
     3892       procedure local-state-fact-rvs :
     3893         define input        parameter p-doc-code             like ub.trn-doc.doc-code      no-undo .
     3894         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     3895         define input        parameter p-stfactplvalue        as   character                no-undo .
     3896         define input        parameter p-revision             as   logical                  no-undo .
     3897         define input        parameter p-fact-edit            as   logical                  no-undo .
     3898         define input        parameter p-doc-qnty             like ub.doc-line.doc-qnty     no-undo .
     3899         define input        parameter p-doc-density          like ub.doc-line.doc-density  no-undo .
     3900         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     3901         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     3902         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     3903         do
     3904         on error undo, return error return-value
     3905         :
     3906           define variable v-new-fact-qnty       like ub.doc-line.fact-qnty              no-undo .
     3907           define variable v-new-density         like ub.doc-line.doc-density            no-undo .
     3908           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     3909           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     3910           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     3911           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     3912           define variable v-log                 as   logical                            no-undo .
     3913           define variable v-chg                 as   logical                            no-undo .
     3914           define variable v-st-doc              as   logical                            no-undo .
     3915           if p-stfactplvalue <> "":U
     3916             and p-revision = true
     3917           then do:
     3918             assign
     3919               v-new-fact-qnty = p-new-fact-qnty
     3920             .
     3921             run return-rvs-qnty in this-procedure
     3922               (  input p-doc-code
     3923                 ,input p-gds-code
     3924                 ,input ?
     3925                 ,output v-rvs-qnty-before
     3926                 ,output v-rvs-qnty-after
     3927                 ,output v-rvs-cli-qnty-before
     3928                 ,output v-rvs-cli-qnty-after
     3929               ) no-error .
     3930             if error-status :error then do:
     3931               return error return-value .
     3932             end.
     3933             assign
     3934               v-new-density = ( v-rvs-cli-qnty-after - v-rvs-cli-qnty-before ) / ( v-rvs-qnty-after - v-rvs-qnty-before )
     3935             .
     3936   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     3937     ( input        p-stfactplvalue
     3938     , input        p-doc-qnty
     3939     , input        p-doc-density
     3940     , input        v-rvs-qnty-before
     3941     , input        v-rvs-qnty-after
     3942     , input        0.00
     3943     , input        0.00
     3944     , input        no
     3945     , input-output v-new-fact-qnty
     3946     ,       output v-chg
     3947     ,       output v-st-doc
     3948     )              no-error
     3949   .
     3950             if error-status :error then do:
     3951               return error return-value .
     3952             end.
     3953             if v-new-fact-qnty <> p-new-fact-qnty
     3954               or v-chg = true
     3955               or v-st-doc = true
     3956             then do:
     3957               if v-st-doc = true
     3958                 or v-new-density = ?
     3959               then do:
     3960                 assign
     3961                   v-new-density = p-doc-density
     3962                 .
     3963               end.
     3964               if v-new-fact-qnty <> p-new-fact-qnty
     3965                 or v-new-density <> p-new-density
     3966               then do:
     3967                 assign
     3968                   v-log = true
     3969                 .
     3970                 if p-fact-edit = true then do:
     3971                   message
     3972                     substitute( "По результатам измерения резервуаров фактическое кол-во необходимо изменить." ) skip
     3973                     substitute( "Будем менять фактические" ) skip
     3974                     substitute( "количество на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     3975                     substitute( "плотность на &1 ?", v-new-density ) skip
     3976                     view-as alert-box question buttons yes-no update v-log .
     3977                 end.
     3978                 else do:
     3979                   message
     3980                     substitute( "По результатам измерения фактическое кол-во товара изменяется на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     3981                     substitute( "фактическая плотность на &1.", v-new-density ) skip
     3982                     view-as alert-box information .
     3983                 end.
     3984                 if v-log = true then do:
     3985                   assign
     3986                     p-new-fact-qnty     = v-new-fact-qnty
     3987                     p-new-density       = v-new-density
     3988                     p-new-cli-fact-qnty = p-new-fact-qnty * p-new-density
     3989                   .
     3990                 end.
     3991               end.
     3992             end.
     3993           end.
     3994         end.
     3995       end procedure.
     3996       procedure eq-qnty-rvs-pl :
     3997         define input        parameter p-doc-code             like ub.trn-doc.doc-code      no-undo .
     3998         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     3999         define input        parameter p-fact-edit            as   logical                  no-undo .
     4000         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     4001         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     4002         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     4003         define output       parameter p-ok                   as   logical                  no-undo .
     4004         do
     4005         on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4006         on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4007         on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4008         :
     4009           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     4010           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     4011           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4012           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4013           define variable v-count-pl      as integer   no-undo .
     4014           define variable v-message       as character no-undo .
     4015           define variable v-tot-qnty-pl   as decimal   no-undo .
     4016           define variable v-tot-qnty-rvs  as decimal   no-undo .
     4017           define variable v-add-option-bt as character no-undo .
     4018           define variable v-add-option-ps as character no-undo .
     4019           define variable v-answ-num      as integer   no-undo .
     4020           define variable v-edit-doc-pl   as integer   no-undo .
     4021           define variable v-set-doc-pl    as integer   no-undo .
     4022           define buffer buf_goods for ub.goods .
     4023           find first buf_goods no-lock
     4024             where buf_goods.gds-code = p-gds-code
     4025             .
     4026           assign
     4027             p-ok           = true
     4028             v-message      = "":U
     4029             v-count-pl     = 0
     4030             v-tot-qnty-rvs = 0.0
     4031             v-tot-qnty-pl  = 0.0
     4032           .
     4033           for each tt-doc-pl no-lock
     4034           on error undo, return error return-value
     4035           :
     4036             run return-rvs-qnty in this-procedure
     4037               ( input  p-doc-code
     4038                ,input  p-gds-code
     4039                ,input  tt-doc-pl.pl-code
     4040                ,output v-rvs-qnty-before
     4041                ,output v-rvs-qnty-after
     4042                ,output v-rvs-cli-qnty-before
     4043                ,output v-rvs-cli-qnty-after
     4044               ) no-error .
     4045             if error-status :error then do:
     4046               return error return-value .
     4047             end.
     4048             assign
     4049               v-count-pl     = v-count-pl + 1
     4050               v-tot-qnty-rvs = v-tot-qnty-rvs + ( v-rvs-qnty-after - v-rvs-qnty-before )
     4051               v-tot-qnty-pl  = v-tot-qnty-pl  + tt-doc-pl.fact-qnty
     4052             .
     4053             if absolute( ( v-rvs-qnty-after - v-rvs-qnty-before ) - tt-doc-pl.fact-qnty ) > tt-doc-pl.fact-qnty * 0.0065 then do:
     4054               if v-message = "":U then do:
     4055                 assign
     4056                   v-message = "Факт. кол-во по местам хранения и по сверкам:".
     4057                 .
     4058               end.
     4059               assign
     4060                 v-message = v-message
     4061                             + chr(10)
     4062                             + substitute( "по месту хр. &1 (&4): &2, по сверкам: &3"
     4063                                         ,tt-doc-pl.pl-code
     4064                                         ,tt-doc-pl.cli-fact-qnty
     4065                                         ,( v-rvs-cli-qnty-after - v-rvs-cli-qnty-before )
     4066                                         ,buf_goods.unit-cli
     4067                                         ) .
     4068               .
     4069             end.
     4070           end.
     4071           if v-message <> "":U
     4072             and ( v-count-pl > 1
     4073                   or ( v-count-pl = 1
     4074                         and p-fact-edit = true
     4075                       )
     4076                 )
     4077           then do:
     4078             assign
     4079               v-edit-doc-pl = ?
     4080               v-set-doc-pl  = ?
     4081             .
     4082             if p-fact-edit = true
     4083               or ( p-fact-edit = false
     4084                    and v-tot-qnty-pl  = p-new-fact-qnty
     4085                    and v-tot-qnty-rvs = p-new-fact-qnty
     4086                  )
     4087             then do:
     4088               assign
     4089                 v-add-option-bt = v-add-option-bt + "|Редактировать"
     4090                 v-add-option-ps = v-add-option-ps + "|Редактировать товар на местах хранения"
     4091                 v-edit-doc-pl   = 3
     4092               .
     4093             end.
     4094             if p-fact-edit = true
     4095               or ( p-fact-edit = false
     4096                    and v-tot-qnty-rvs = p-new-fact-qnty
     4097                   )
     4098             then do:
     4099               assign
     4100                 v-add-option-bt = v-add-option-bt + "|Установить"
     4101                 v-add-option-ps = v-add-option-ps + "|Установить по местам хранения кол-вo из сверок (плотность по документу)"
     4102               .
     4103               if v-edit-doc-pl = ? then do:
     4104                 assign
     4105                   v-set-doc-pl = 3
     4106                 .
     4107               end.
     4108               else do:
     4109                 assign
     4110                   v-set-doc-pl = 4
     4111                 .
     4112               end.
     4113             end.
     4114             run gbl/d-askw.w
     4115               ( input "Расхождение значений по местам хранения с показаниями сверок"
     4116                ,input substitute( "&1", v-message ) + chr(10) + "Это вызовет расхождение фактических и расчетно-книжных остатков"
     4117                ,input "|^"
     4118                ,input "Сохранить|Отмена" + v-add-option-bt
     4119                ,input "Сохранить, игнорируя это расхождение|Отмена сохранения" + v-add-option-ps
     4120                ,input 1
     4121                ,input 2
     4122                ,output v-answ-num
     4123               ) .
     4124             if v-answ-num = 2 then do:
     4125               return error .
     4126             end.
     4127             if v-edit-doc-pl <> ?
     4128               and v-answ-num = v-edit-doc-pl
     4129             then do:
     4130               assign
     4131                 p-ok = false
     4132               .
     4133               run edit-doc-pl in this-procedure
     4134                 ( input 'ИЗМЕНЕНИЕ':U
     4135                 ).
     4136               return .
     4137             end.
     4138             if v-set-doc-pl <> ?
     4139               and v-answ-num = v-set-doc-pl
     4140             then do:
     4141               assign
     4142                 p-ok = false
     4143                 p-new-fact-qnty     = 0.0
     4144                 p-new-cli-fact-qnty = 0.0
     4145               .
     4146               for each tt-doc-pl
     4147               on error undo, return error return-value
     4148               :
     4149                 run return-rvs-qnty in this-procedure
     4150                   ( input  p-doc-code
     4151                    ,input  p-gds-code
     4152                    ,input  tt-doc-pl.pl-code
     4153                    ,output v-rvs-qnty-before
     4154                    ,output v-rvs-qnty-after
     4155                    ,output v-rvs-cli-qnty-before
     4156                    ,output v-rvs-cli-qnty-after
     4157                   ) no-error .
     4158                 if error-status :error then do:
     4159                   return error return-value .
     4160                 end.
     4161                 assign
     4162                   tt-doc-pl.fact-qnty     = v-rvs-qnty-after - v-rvs-qnty-before
     4163                   tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-new-density
     4164                   p-new-fact-qnty         = p-new-fact-qnty    + tt-doc-pl.fact-qnty
     4165                   p-new-cli-fact-qnty     = p-new-cli-fact-qnty + tt-doc-pl.cli-fact-qnty
     4166                 .
     4167               end.
     4168               assign
     4169                 p-new-density = p-new-cli-fact-qnty / p-new-fact-qnty
     4170               .
     4171               return .
     4172             end.
     4173           end.
     4174         end.
     4175       end procedure.
     4176   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4177   procedure find-new-price-sale :
     4178   define input  parameter  par-gm           as character no-undo .
     4179   define input  parameter  par-pr-nakl      as logical   no-undo .
     4180   define input  parameter  p-doc-code       as character no-undo .
     4181   define input  parameter  p-artic          as character no-undo .
     4182   define input  parameter  p-prod-type      as character no-undo .
     4183   define input  parameter  p-prod-code      as integer   no-undo .
     4184   define input  parameter  p-doc-price-rubl as decimal   no-undo .
     4185   define input  parameter  p-doc-price-base as decimal   no-undo .
     4186   define input  parameter  p-doc-vat-pc     as decimal   no-undo .
     4187   define input  parameter  p-doc-slt-pc     as decimal   no-undo .
     4188   define input-output parameter  p-new-price-sale as decimal   no-undo .
     4189   define buffer buf_trn-doc for ub.trn-doc  .
     4190   define variable is-petrolium as logical   no-undo .
     4191   define variable is-pieces    as logical   no-undo .
     4192     do
     4193     on error undo, return error return-value
     4194     :
     4195    find first buf_trn-doc no-lock where buf_trn-doc.doc-code =  p-doc-code no-error .
     4196   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4197     (
     4198        input p-artic
     4199     ,  input p-prod-type
     4200     ,  input p-prod-code
     4201     , output is-petrolium
     4202     , output is-pieces
     4203     ) .
     4204   if not (par-pr-nakl = yes and par-gm = 'before-margin':U and is-petrolium = false ) then return .
     4205     run str/in-prno.p (
     4206         input   parParentProc ,
     4207         input   p-doc-code    ,
     4208         input   p-artic       ,
     4209         input   p-prod-type   ,
     4210         input   p-prod-code   ,
     4211         input   p-doc-price-rubl ,
     4212         input   p-doc-price-base ,
     4213         input   p-doc-vat-pc ,
     4214         input   p-doc-slt-pc ,
     4215         input-output  p-new-price-sale ) .
     4216     end.
     4217   end procedure.
     4218   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4219   procedure lineattr-value :
     4220     do
     4221     on error undo, return error return-value
     4222     :
     4223       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4224       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4225       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4226       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     4227       define output parameter p-type     as character no-undo .
     4228       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4229       def var v-format         as character no-undo .
     4230       def var v-fillin_width   as integer   no-undo .
     4231       def var v-fillin_height  as integer   no-undo .
     4232       def var v-label          as character no-undo .
     4233       def var v-user-can-edit  as logical   no-undo .
     4234       def var v-output-display as logical   no-undo .
     4235       def var v-other          as character no-undo .
     4236       run lineattr-code in this-procedure
     4237         (input  p-code
     4238         ,output p-type
     4239         ,output v-format
     4240         ,output v-fillin_width
     4241         ,output v-fillin_height
     4242         ,output v-label
     4243         ,output v-user-can-edit
     4244         ,output v-output-display
     4245         ,output v-other
     4246         ) no-error .
     4247       if error-status :error then do:
     4248         undo, return error return-value .
     4249       end.
     4250       find first buf_doc-line-attr no-lock
     4251         where buf_doc-line-attr.doc-code  = p-doc-code
     4252           and buf_doc-line-attr.gds-code  = p-gds-code
     4253           and buf_doc-line-attr.attr-code = p-code
     4254         no-error .
     4255       if avail buf_doc-line-attr then do:
     4256         assign
     4257           p-value =  buf_doc-line-attr.attr-value
     4258         .
     4259       end.
     4260       else do:
     4261         assign
     4262           p-value = if p-type = 'L':U then "no":U else ""
     4263         .
     4264       end.
     4265     end.
     4266   end procedure.
     4267   procedure lineattr-write :
     4268     do
     4269     on error undo, return error return-value
     4270     :
     4271       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4272       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4273       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4274       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     4275       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4276       def var v-type           as character no-undo .
     4277       def var v-format         as character no-undo .
     4278       def var v-fillin_width   as integer   no-undo .
     4279       def var v-fillin_height  as integer   no-undo .
     4280       def var v-label          as character no-undo .
     4281       def var v-user-can-edit  as logical   no-undo .
     4282       def var v-output-display as logical   no-undo .
     4283       def var v-other          as character no-undo .
     4284       run lineattr-code in this-procedure
     4285         (input  p-code
     4286         ,output v-type
     4287         ,output v-format
     4288         ,output v-fillin_width
     4289         ,output v-fillin_height
     4290         ,output v-label
     4291         ,output v-user-can-edit
     4292         ,output v-output-display
     4293         ,output v-other
     4294         ) no-error .
     4295       if error-status :error then do:
     4296         undo, return error return-value .
     4297       end.
     4298       find first buf_doc-line-attr exclusive-lock
     4299         where buf_doc-line-attr.doc-code  = p-doc-code
     4300           and buf_doc-line-attr.gds-code  = p-gds-code
     4301           and buf_doc-line-attr.attr-code = p-code
     4302         no-error .
     4303       if not available buf_doc-line-attr then do:
     4304         create buf_doc-line-attr .
     4305         assign
     4306           buf_doc-line-attr.doc-code  = p-doc-code
     4307           buf_doc-line-attr.gds-code = p-gds-code
     4308           buf_doc-line-attr.attr-code = p-code
     4309         .
     4310       end.
     4311       assign
     4312         buf_doc-line-attr.attr-value = p-value
     4313       .
     4314        release buf_doc-line-attr.
     4315     end.
     4316   end procedure.
     4317   procedure lineattr-exist :
     4318     do
     4319     on error undo, return error return-value
     4320     :
     4321       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4322       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4323       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4324       define output parameter p-exist   as logical  no-undo .
     4325       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4326       def var v-type           as character no-undo .
     4327       def var v-format         as character no-undo .
     4328       def var v-fillin_width   as integer   no-undo .
     4329       def var v-fillin_height  as integer   no-undo .
     4330       def var v-label          as character no-undo .
     4331       def var v-user-can-edit  as logical   no-undo .
     4332       def var v-output-display as logical   no-undo .
     4333       def var v-other          as character no-undo .
     4334       run lineattr-code in this-procedure
     4335         (input  p-code
     4336         ,output v-type
     4337         ,output v-format
     4338         ,output v-fillin_width
     4339         ,output v-fillin_height
     4340         ,output v-label
     4341         ,output v-user-can-edit
     4342         ,output v-output-display
     4343         ,output v-other
     4344         ) no-error .
     4345       if error-status :error then do:
     4346         undo, return error return-value .
     4347       end.
     4348       find first buf_doc-line-attr no-lock
     4349         where buf_doc-line-attr.doc-code  = p-doc-code
     4350           and buf_doc-line-attr.gds-code = p-gds-code
     4351           and buf_doc-line-attr.attr-code = p-code
     4352         no-error .
     4353       if  available buf_doc-line-attr then do:
     4354         p-exist = yes.
     4355       end.
     4356     end.
     4357   end procedure.
     4358   procedure lineattr-delete :
     4359     do
     4360     on error undo, return error return-value
     4361     :
     4362       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4363       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4364       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4365       define output parameter p-deleted  as logical no-undo.
     4366       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4367       def var v-type           as character no-undo .
     4368       def var v-format         as character no-undo .
     4369       def var v-fillin_width   as integer   no-undo .
     4370       def var v-fillin_height  as integer   no-undo .
     4371       def var v-label          as character no-undo .
     4372       def var v-user-can-edit  as logical   no-undo .
     4373       def var v-output-display as logical   no-undo .
     4374       def var v-other          as character no-undo .
     4375       run lineattr-code in this-procedure
     4376         (input  p-code
     4377         ,output v-type
     4378         ,output v-format
     4379         ,output v-fillin_width
     4380         ,output v-fillin_height
     4381         ,output v-label
     4382         ,output v-user-can-edit
     4383         ,output v-output-display
     4384         ,output v-other
     4385         ) no-error .
     4386       if error-status :error then do:
     4387         undo, return error return-value .
     4388       end.
     4389       find first buf_doc-line-attr exclusive-lock
     4390         where buf_doc-line-attr.doc-code  = p-doc-code
     4391           and buf_doc-line-attr.gds-code  = p-gds-code
     4392           and buf_doc-line-attr.attr-code = p-code
     4393         no-error NO-WAIT.
     4394       if not available buf_doc-line-attr then do:
     4395         p-deleted = no.
     4396       end.
     4397       else do:
     4398         delete buf_doc-line-attr.
     4399         p-deleted = yes.
     4400       end.
     4401     end.
     4402   end procedure.
     4403   procedure lineattr-code :
     4404     do on error undo, return error return-value
     4405     :
     4406       define input  parameter p-code           as character no-undo .
     4407       define output parameter p-type           as character no-undo .
     4408       define output parameter p-format         as character no-undo .
     4409       define output parameter p-fillin_width   as integer   no-undo .
     4410       define output parameter p-fillin_height  as integer   no-undo .
     4411       define output parameter p-label          as character no-undo .
     4412       define output parameter p-user-can-edit  as logical   no-undo .
     4413       define output parameter p-output-display as logical   no-undo .
     4414       define output parameter p-other          as character no-undo .
     4415       case p-code :
     4416               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4417               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4418               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4419               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4420               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4421               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4422               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4423               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4424               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4425               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4426               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4427         otherwise do:
     4428           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     4429         end.
     4430       end.
     4431     end.
     4432   end procedure.
     4433   procedure lineattr-value-flora-gds :
     4434     do
     4435     on error undo, return error return-value
     4436     :
     4437       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     4438       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     4439       define input  parameter p-prt-code    as integer   no-undo .
     4440       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     4441       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     4442       define output parameter p-value       as    decimal   no-undo .
     4443       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4444       find first buf_doc-line-attr no-lock
     4445         where buf_doc-line-attr.doc-code  = p-doc-code
     4446           and buf_doc-line-attr.gds-code  = p-gds-code
     4447           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4448         no-error .
     4449       if avail buf_doc-line-attr then do:
     4450         assign
     4451           p-value = decimal( buf_doc-line-attr.attr-value)
     4452         .
     4453       end.
     4454       else do:
     4455         assign
     4456           p-value = 0
     4457         .
     4458       end.
     4459     end.
     4460   end procedure.
     4461   procedure lineattr-write-flora-gds :
     4462     do
     4463     on error undo, return error return-value
     4464     :
     4465       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4466       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4467       define input parameter p-prt-code    as integer   no-undo .
     4468       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4469       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4470       define input parameter p-value    as decimal   no-undo .
     4471       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4472       find first buf_doc-line-attr exclusive-lock
     4473         where buf_doc-line-attr.doc-code  = p-doc-code
     4474           and buf_doc-line-attr.gds-code  = p-gds-code
     4475           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4476         no-error .
     4477       if not available buf_doc-line-attr then do:
     4478         create buf_doc-line-attr .
     4479         assign
     4480           buf_doc-line-attr.doc-code  = p-doc-code
     4481           buf_doc-line-attr.gds-code  = p-gds-code
     4482           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4483         .
     4484       end.
     4485       assign
     4486         buf_doc-line-attr.attr-value = string( p-value )
     4487       .
     4488     end.
     4489   end procedure.
     4490   procedure lineattr-delete-flora-gds :
     4491     do
     4492     on error undo, return error return-value
     4493     :
     4494       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4495       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4496       define input  parameter p-prt-code    as integer   no-undo .
     4497       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4498       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4499       define output parameter p-deleted  as logical no-undo.
     4500       define buffer buf_doc-line-attr for ub.doc-line-attr .
