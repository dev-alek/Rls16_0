     1760   define variable vss-include-info20 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1761     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1762       define variable v-answ as logical no-undo .
     1763       if ( p-unit-base-cli-eq = true
     1764            and p-density = 1.0
     1765          )
     1766         or ( p-unit-base-cli-eq = false
     1767              and p-density <> ?
     1768              and p-density > 0.0
     1769              and p-density < 1.0
     1770            )
     1771       then do:
     1772         assign
     1773           v-answ = true
     1774         .
     1775       end.
     1776       else do:
     1777         assign
     1778           v-answ = false
     1779         .
     1780       end.
     1781       return v-answ.
     1782     end function.
     1783   procedure plgdsfnd :
     1784     define input  parameter p-chk-and-chs    as logical               no-undo .
     1785     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1786     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1787     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1788     define output parameter p-reserv-pl-code as   logical             no-undo .
     1789     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1790     define buffer buf_goods         for ub.goods .
     1791     define buffer buf_pl-gds        for ub.pl-gds .
     1792     define buffer buf_second_pl-gds for ub.pl-gds .
     1793     find first buf_goods no-lock where
     1794                buf_goods.gds-code = p-gds-code no-error .
     1795     if not available buf_goods
     1796     then do:
     1797       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1798     end.
     1799   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1801     (input  p-obj-type
     1802     ,input  p-obj-code
     1803     ,input  buf_goods.artic
     1804     ,input  buf_goods.prod-type
     1805     ,input  buf_goods.prod-code
     1806     ,input  'place-rsrv=request'
     1807     ,output p-reserv-pl-code
     1808     ) no-error .
     1809     if error-status :error
     1810     then do:
     1811       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1812     end.
     1813     if p-reserv-pl-code = no
     1814     then do:
     1815       return .
     1816     end.
     1817     if p-chk-and-chs <> yes
     1818     then do:
     1819       return .
     1820     end.
     1821     find first buf_pl-gds no-lock where
     1822                buf_pl-gds.obj-type = p-obj-type and
     1823                buf_pl-gds.obj-code = p-obj-code and
     1824                buf_pl-gds.gds-code = p-gds-code no-error .
     1825     if not available buf_pl-gds
     1826     then do:
     1827       return error "К товару не привязано ни одного места хранения" .
     1828     end.
     1829     find first buf_second_pl-gds no-lock where
     1830                buf_second_pl-gds.obj-type  = p-obj-type          and
     1831                buf_second_pl-gds.obj-code  = p-obj-code          and
     1832                buf_second_pl-gds.gds-code  = p-gds-code          and
     1833                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1834     if not available buf_second_pl-gds
     1835     then do:
     1836       assign
     1837         p-pl-code = buf_pl-gds.pl-code
     1838       .
     1839     end.
     1840     else do:
     1841       run str/plgdssel.p
     1842         (
     1843            input parparentproc
     1844         ,  input p-obj-type
     1845         ,  input p-obj-code
     1846         ,  input p-gds-code
     1847         , output p-pl-code
     1848         ) no-error .
     1849       if error-status :error
     1850       then do:
     1851         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1852                                , 'plgdssel.p':U
     1853                                , chr(10)
     1854                                , error-status :get-message( 1 )
     1855                                , return-value
     1856                                ) .
     1857       end.
     1858       if p-pl-code = ? or
     1859          p-pl-code = 0
     1860       then do:
     1861         return error "Не выбрано место хранения " + chr(10) .
     1862       end.
     1863     end.
     1864   end procedure.
     1865     define new global shared variable g#lib-rvs as handle no-undo.
     1866     define temp-table tt-param no-undo
     1867       field strfrfile as character
     1868       field strasi    as character
     1869       field flddb     as character
     1870       index pi        as primary   unique strfrfile
     1871       index asi strasi.
     1872     define temp-table tt-param-pump no-undo
     1873       field strfrfile as character
     1874       field meaning   as character
