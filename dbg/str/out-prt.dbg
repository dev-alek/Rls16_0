     2663     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2664     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     2665     define input parameter p-value     like ub.db-attr.attr-value no-undo .
     2666     do
     2667     on error undo, return error
     2668     :
     2669           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
     2670         (input p-db-num
     2671         ,input p-code
     2672         ,input p-value
     2673         ) no-error .
     2674       if error-status :error
     2675       then do:
     2676         undo, return error return-value .
     2677       end.
     2678     end.
     2679   end procedure.
