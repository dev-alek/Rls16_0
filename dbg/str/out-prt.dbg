    11494   PROCEDURE proc-case :
    11495     define variable v-action-name as character no-undo .
    11496     if is-petrolium = yes
    11497       and is-pieces = no
    11498     then do:
    11499       if available ub.inv-line then do:
    11500         assign
    11501           v-price-rubl-kg   = ub.inv-line.wast-rubl
    11502           v-price-base-kg   = ub.inv-line.wast-base
    11503           v-fact-qnty-kg    = ub.inv-line.wast-cli-qnty
