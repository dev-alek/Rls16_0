     9913     assign
     9914       stfactplvalue    = "":U
     9915       varupd-fact-qnty = false
     9916     .
     9917     if t-doc.ext-doc-type = 'iv':U then do:
     9918        varupd-fact-qnty = true .
     9919        if t-doc.status_ =  'запрос':U then do:
     9920           assign
     9921             v-work-with-qnty = "doc":U
     9922            .
     9923        end.
     9924        else do:
     9925           assign
     9926             v-work-with-qnty = "fact-doc":U
     9927           .
     9928        end.
     9929     end.
     9930     else do:
     9931       if t-doc.status_ <> 'факт':U
     9932         and t-doc.status_ <> 'разрешен':U
     9933         and t-doc.flag_ = false
     9934       then do:
     9935         assign
     9936           v-work-with-qnty = "doc":U
     9937         .
     9938       end.
     9939       else do:
     9940         assign
     9941           v-work-with-qnty = "fact":U
     9942         .
     9943         if t-doc.ext-doc-type <> 'rv':U then do:
     9944           assign
     9945             varupd-fact-qnty = true
     9946           .
     9947         end.
     9948       end.
     9949     end.
     9950     find buf_goods   no-lock
     9951       where recid( buf_goods ) = gds-rec
     9952       .
     9953     find ub.clients no-lock
     9954       where ub.clients.obj-code = buf_goods.prod-code
     9955         and ub.clients.obj-type = buf_goods.prod-type
     9956       .
     9957     find ub.prt-obj no-lock
     9958       where ub.prt-obj.prt-code  = ub.gds-prt.node-code
     9959         and ub.prt-obj.prod-code = buf_goods.prod-code
     9960         and ub.prt-obj.prod-type = buf_goods.prod-type
     9961         and ub.prt-obj.artic     = buf_goods.artic
     9962         and ub.prt-obj.obj-code  = t-doc.obj-code
     9963         and ub.prt-obj.obj-type  = t-doc.obj-type
     9964       no-error.
     9965     if prt-mode = 'ПРОСМОТР':U then do:
     9966       find ub.doc-line no-lock
     9967         where recid( ub.doc-line ) = line-rec
     9968         .
     9969       find ub.gds-dtl  no-lock
     9970         where ub.gds-dtl.prt-code  = ub.gds-prt.node-code
     9971           and ub.gds-dtl.prod-code = ub.doc-line.prod-code
     9972           and ub.gds-dtl.prod-type = ub.doc-line.prod-type
     9973           and ub.gds-dtl.artic     = ub.doc-line.artic
     9974           and ub.gds-dtl.doc-code  = t-doc.doc-code
     9975         no-error.
     9976       find ub.inv-line no-lock
     9977         where ub.inv-line.doc-code  = t-doc.doc-code
     9978           and ub.inv-line.artic     = ub.doc-line.artic
     9979           and ub.inv-line.prod-code = ub.doc-line.prod-code
     9980           and ub.inv-line.prod-type = ub.doc-line.prod-type
     9981         no-error.
     9982     end.
     9983     else do:
     9984       find first t-doc
     9985         where recid(t-doc) = doc-rec
     9986         .
     9987       find ub.doc-line exclusive-lock
     9988         where recid( ub.doc-line ) = line-rec
     9989         .
     9990       find ub.gds-dtl  exclusive-lock
     9991         where ub.gds-dtl.prt-code  = ub.gds-prt.node-code
