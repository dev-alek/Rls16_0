    11624                   assign
    11625                     v-action-name = 'actn_expense_price':U
    11626                   .
    11627                 end.
    11628                 when 'спи':U then do:
    11629                   assign
    11630                     v-action-name = 'actn_write-off_price':U
    11631                   .
    11632                 end.
    11633                 when 'возврат':U then do:
    11634                   assign
    11635                     v-action-name = 'actn_return_price':U
    11636                   .
    11637                 end.
    11638                 otherwise do:
    11639                   message
    11640                     vss-workfile vss-revision vss-description skip
    11641                     "Неизвестный тип документа" skip
    11642                     "Тип документа" t-doc.doc-type skip
    11643                     "Код документа" t-doc.doc-code skip
    11644                     view-as alert-box error .
    11645                   undo, return error return-value .
    11646                 end.
    11647               end case .
    11648   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11649   do:
    11650     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    11651       (input  v-cntxt-db-num
    11652       ,input  v-cntxt-userid
    11653       ,input  0
    11654       ,input  v-action-name
    11655       ,input  'object':U
