    10424     else do:
    10425       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code).
    10426       RUN gds-attr-value (
    10427                           INPUT buf_goods.gds-code,
