     9159       IF AVAILABLE buf_goods THEN
     9160       DO:
     9161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9162     (input  buf_goods.gds-code
     9163     ,input  ?
     9164     ,output v-main-code
     9165     )  .
     9166           RUN ref/imagelist.w (ParParentProc, "":U, v-main-code, 'ПРОСМОТР':U).
     9167       END.
     9168   END.
     9169   ON LEAVE OF gds-dtl.new-price-sale IN FRAME d-out-prt
     9170   DO:
     9171     if input frame d-out-prt ub.gds-dtl.new-price-sale   <>  ub.gds-dtl.new-price-sale  then do:
     9172         run lineattr-write in this-procedure (
     9173             t-doc.doc-code ,
     9174             buf_goods.gds-code ,
     9175             'corr-price-sale':U,
     9176             string(ub.gds-dtl.new-price-sale)
     9177             ).
     9178         ub.gds-dtl.price-corr = 1.
     9179        display b-corr-price-sale with frame d-out-prt .
     9180        assign ub.gds-dtl.new-price-sale .
     9181     end.
     9182   END.
     9183   ON LEAVE OF gds-dtl.price-base IN FRAME d-out-prt
     9184   DO:
     9185     if input frame d-out-prt ub.gds-dtl.price-base > 5000
     9186       and base-code = 1
     9187     then do:
     9188       message
     9189         "Внимание !!!" skip( 2 )
     9190         "ВАЛЮТНАЯ цена превышает 5,000 !" skip( 2 )
     9191         chr(9) "Вы не ошиблись ?"
     9192         view-as alert-box warning title " В Н И М А Н И Е  ! ! ! ".
     9193     end.
     9194     if ub.gds-dtl.price-base <> input frame d-out-prt ub.gds-dtl.price-base then do:
     9195       assign
     9196         ub.gds-dtl.price-base
     9197       .
     9198       assign
     9199         ub.gds-dtl.ov = yes
     9200         ub.gds-dtl.price-rubl = ub.gds-dtl.price-base * t-doc.base-rate / t-doc.base-scale
     9201         tot-rubl = ub.gds-dtl.doc-qnty * ( ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl )
     9202         tot-base = ub.gds-dtl.doc-qnty * ( ub.gds-dtl.price-base - ub.gds-dtl.discnt-base )
     9203       .
     9204       display
     9205         ub.gds-dtl.price-rubl
     9206         tot-rubl
     9207         tot-base
     9208         with frame d-out-prt.
     9209       if is-petrolium = true
     9210         and is-pieces = false
     9211         and
     9212     valid-density( ub.doc-line.doc-density, buf_goods.unit-base = buf_goods.unit-cli )
     9213     = true
     9214       then do:
     9215         assign
     9216           v-price-rubl-kg = ub.gds-dtl.price-rubl / ub.doc-line.fact-density
     9217           v-price-base-kg = ub.gds-dtl.price-base / ub.doc-line.fact-density
     9218         .
     9219         display
     9220           v-price-rubl-kg
     9221           v-price-base-kg
     9222         with frame d-out-prt.
     9223       end.
     9224     end.
     9225     run re-calcpr in this-procedure .
     9226   END.
