    11353   PROCEDURE l-fact-qnty :
    11354     run check-fact-qnty in this-procedure no-error .
    11355     if error-status:error then return error.
    11356   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
