    10759   PROCEDURE ch-price :
    10760   define variable v-cli-type    as character no-undo .
    10761   define variable v-cli-code    as integer   no-undo .
    10762   define variable v-main-b-code as integer   no-undo .
    10763   define variable v-b-code      as integer   no-undo .
    10764   define variable v-obj-type    as character no-undo .
    10765   define variable v-obj-code    as integer   no-undo .
    10766   define variable v-qnty-doc    as decimal   no-undo .
    10767   define variable v-sum-doc     as decimal   no-undo .
    10768   define variable v-fact-order  as decimal   no-undo .
    10769   define variable v-plt-id      as integer   no-undo .
    10770   define variable v-plt-db-num  as integer   no-undo .
    10771   define variable v-pdf-id      as integer   no-undo .
    10772   define variable v-pdf-db-num  as integer   no-undo .
    10773   define variable v-sale-price-base as decimal   no-undo .
    10774   define variable v-sale-price-rubl as decimal   no-undo .
    10775     do
    10776     on error undo, return error return-value
    10777     :
    10778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    10779     (input  b-c-b.gds-code
    10780     ,input  ?
    10781     ,output v-main-b-code
    10782     )  .
    10783    run fact-order-mpl  in this-procedure (
    10784        input t-doc.doc-date ,
    10785        input t-doc.obj-type ,
    10786        input t-doc.obj-code ,
    10787        output v-fact-order )
    10788        .
    10789   assign
    10790     v-cli-type      = t-doc.cli-type
    10791     v-cli-code      = t-doc.cli-code
    10792     v-b-code        = b-c-b.b-code
    10793     v-obj-type      = t-doc.obj-type
    10794     v-obj-code      = t-doc.obj-code
    10795     .
    10796     if ub.gds-dtl.doc-qnty:visible in frame d-out-prt and ub.gds-dtl.doc-qnty:SENSITIVE then
    10797        v-qnty-doc      = input frame d-out-prt ub.gds-dtl.doc-qnty.
    10798     if ub.gds-dtl.fact-qnty:visible in frame d-out-prt and ub.gds-dtl.fact-qnty:SENSITIVE then
    10799        v-qnty-doc      = input frame d-out-prt ub.gds-dtl.fact-qnty.
    10800    v-sum-doc       = 0 .
    10801    run str/chmpldoc.w
    10802           (input parparentproc
    10803           ,input  v-cli-type
    10804           ,input  v-cli-code
    10805           ,input  v-main-b-code
    10806           ,input  v-b-code
    10807           ,input  v-obj-type
    10808           ,input  v-obj-code
    10809           ,input  v-qnty-doc
    10810           ,input  v-sum-doc
    10811           ,input  string(t-doc.pay-code)
    10812           ,input  ""
    10813           ,input  v-fact-order
    10814           ,output v-plt-id
    10815           ,output v-plt-db-num
    10816           ,output v-pdf-id
    10817           ,output v-pdf-db-num
    10818           ,output v-sale-price-base
    10819           ,output v-sale-price-rubl
    10820           ).
    10821   if v-plt-id = ? then return.
    10822    if ub.gds-dtl.price-rubl:visible in frame d-out-prt and ub.gds-dtl.price-rubl:SENSITIVE then do:
    10823       display v-sale-price-rubl @ ub.gds-dtl.price-rubl with frame d-out-prt .
    10824       display v-sale-price-base @ ub.gds-dtl.price-base with frame  d-out-prt .
    10825       apply "leave" to ub.gds-dtl.price-rubl in frame d-out-prt.
    10826    end.
    10827    else do:
    10828       if ub.gds-dtl.price-base:visible and  ub.gds-dtl.price-base:SENSITIVE then do:
    10829           ub.gds-dtl.price-base = v-sale-price-base .
    10830           display ub.gds-dtl.price-base with frame d-out-prt .
    10831           display v-sale-price-rubl @ ub.gds-dtl.price-rubl with frame d-out-prt .
    10832           display v-sale-price-base @ ub.gds-dtl.price-base with frame  d-out-prt .
    10833           apply "leave" to ub.gds-dtl.price-base in frame d-out-prt.
    10834       end.
    10835     end.
    10836   end.
    10837   END PROCEDURE.
    10838   PROCEDURE check-place-rsrv :
    10839   define variable d_fact-qnty     as decimal no-undo initial 0.00 .
    10840     define variable d_doc-qnty      as decimal no-undo initial 0.00 .
    10841     define variable d_cli-qnty      as decimal no-undo initial 0.00 .
    10842     define variable d_cli-fact-qnty as decimal no-undo initial 0.00 .
    10843     define variable d_cli-doc-qnty  as decimal no-undo initial 0.00 .
    10844     define variable d_density       as decimal no-undo              .
    10845     do
    10846     on error undo, return error return-value
    10847     :
    10848       if v-place-rsrv <> true
    10849         or b-place :sensitive in frame d-out-prt <> true
    10850       then do:
    10851         return .
    10852       end.
    10853       if v-work-with-qnty = "fact":U
    10854         or v-work-with-qnty = "fact-doc":U
    10855       then do:
    10856         if input frame d-out-prt ub.gds-dtl.doc-qnty < input frame d-out-prt ub.gds-dtl.fact-qnty then do:
    10857           message
    10858             substitute( 'Фактическое количество в строке накладной (&1 &2) больше количества по документу (&3 &2).'
    10859                         ,input frame d-out-prt ub.gds-dtl.fact-qnty
    10860                         ,buf_goods.unit-base
    10861                         ,input frame d-out-prt ub.gds-dtl.doc-qnty
    10862                       )
    10863             view-as alert-box error .
    10864           undo, return error .
    10865         end.
    10866       end.
    10867       assign
    10868         d_fact-qnty     = 0.00
    10869         d_doc-qnty      = 0.00
    10870         d_cli-qnty      = 0.00
    10871         d_cli-fact-qnty = 0.00
    10872         d_cli-doc-qnty  = 0.00
    10873       .
    10874       for each tt-doc-pl no-lock
    10875       on error undo, return error return-value
    10876       :
    10877         assign
    10878           d_cli-qnty      = d_cli-qnty      + tt-doc-pl.cli-qnty
    10879           d_fact-qnty     = d_fact-qnty     + tt-doc-pl.fact-qnty
    10880           d_doc-qnty      = d_doc-qnty      + tt-doc-pl.doc-qnty
    10881           d_cli-fact-qnty = d_cli-fact-qnty + tt-doc-pl.cli-fact-qnty
    10882           d_cli-doc-qnty  = d_cli-doc-qnty  + tt-doc-pl.cli-doc-qnty
    10883         .
    10884       end.
    10885       if input frame d-out-prt ub.gds-dtl.doc-qnty <> d_doc-qnty then do:
    10886         message
    10887           substitute( 'Количество по документу в строке накладной: &1 &3'
    10888                       + 'НЕ СОВПАДАЕТ с суммарным количеством по местам хранения: &2.&3'
    10889                       , input frame d-out-prt ub.gds-dtl.doc-qnty
    10890                       , d_doc-qnty
    10891                       , chr(10)
    10892                     )
    10893           view-as alert-box error .
    10894         undo, return error .
    10895       end.
    10896       if ( v-qnty-kg :sensitive in frame d-out-prt = true
    10897           and input frame d-out-prt v-qnty-kg <> d_cli-doc-qnty
    10898         )
    10899         or
    10900         ( v-qnty-kg :sensitive in frame d-out-prt = false
    10901           and absolute( input frame d-out-prt v-qnty-kg - d_cli-doc-qnty ) > 0.001
    10902         )
    10903       then do:
    10904         message
    10905           substitute( 'Количество в ед.пост-ка в строке накладной: &1 &3'
    10906                       + 'НЕ СОВПАДАЕТ с суммарным количеством в ед.пост-ка по местам хранения: &2.&3'
    10907                       + 'Нажмите кнопку "&4" и исправьте количества по местам хранения&3'
    10908                       + 'или исправьте количество в строке накладной.'
    10909                       , input frame d-out-prt v-qnty-kg
    10910                       , d_cli-doc-qnty
    10911                       , chr(10)
    10912                       , replace( b-place :label in frame d-out-prt, "&", "":U )
    10913                     )
    10914           view-as alert-box error .
    10915         undo, return error .
    10916       end.
    10917       if v-work-with-qnty = "fact":U
    10918         or v-work-with-qnty = "fact-doc":U
    10919       then do:
    10920         if input frame d-out-prt ub.gds-dtl.fact-qnty <> d_fact-qnty then do:
    10921           message
    10922             substitute( 'Фактическое количество в строке накладной: &1 &3'
    10923                         + 'НЕ СОВПАДАЕТ &3 с суммарным фактическим количеством по местам хранения: &2.&3'
    10924                         , input frame d-out-prt ub.gds-dtl.fact-qnty
    10925                         , d_fact-qnty
    10926                         , chr(10)
    10927                       )
    10928             view-as alert-box error .
    10929           undo, return error .
    10930         end.
    10931         if ( v-fact-qnty-kg :sensitive in frame d-out-prt = true
    10932             and input frame d-out-prt v-fact-qnty-kg <> d_cli-fact-qnty
    10933           )
    10934           or
    10935           ( v-fact-qnty-kg :sensitive in frame d-out-prt = false
    10936             and absolute( input frame d-out-prt v-fact-qnty-kg - d_cli-fact-qnty ) > 0.001
    10937           )
    10938         then do:
    10939           message
    10940             substitute( 'Фактическое количество в ед.пост-ка в строке накладной: &1 &3'
    10941                         + 'НЕ СОВПАДАЕТ &3 с суммарным фактическим количеством в ед.пост-ка по местам хранения: &2.&3'
    10942                         + 'Нажмите кнопку "&4" и исправьте фактические количества в ед.пост-ка по местам хранения&3'
    10943                         + 'или исправьте фактическое количество в ед.пост-ка в строке накладной.'
    10944                         , input frame d-out-prt v-fact-qnty-kg
    10945                         , d_cli-fact-qnty
    10946                         , chr(10)
    10947                         , replace( b-place :label in frame d-out-prt, "&", "":U )
    10948                       )
    10949             view-as alert-box error .
    10950           undo, return error .
    10951         end.
    10952       end.
    10953       if buf_goods.unit-base <> buf_goods.unit-cli
    10954       and not is-gas(buf_goods.gds-code)
    10955       then do:
    10956         assign
    10957           d_density = d_cli-doc-qnty / d_doc-qnty
    10958         .
    10959         if ( d_density <= 0.00 or d_density >= 1.00 )
    10960           and ( ub.gds-dtl.doc-qnty :sensitive in frame d-out-prt
    10961                 or v-qnty-kg :sensitive in frame d-out-prt
    10962               )
    10963         then do:
    10964           message
    10965             substitute( 'Заявленная плотность топлива (&1) не соответствует ожидаемому. Кол-во: &2л и &3кг.'
    10966                         , d_density
    10967                         , d_doc-qnty
    10968                         , d_cli-doc-qnty
    10969                       )
    10970             view-as alert-box error .
    10971           undo, return error .
    10972         end.
    10973         assign
    10974           d_density = d_cli-fact-qnty / d_fact-qnty
    10975         .
    10976         if ( d_density <= 0.00 or d_density >= 1.00 )
    10977           and ub.gds-dtl.fact-qnty :sensitive in frame d-out-prt
    10978         then do:
    10979           message
    10980             substitute( 'Фактическая плотность топлива (&1) не соответствует ожидаемому. Кол-во: &2л и &3кг.'
    10981                       , d_density
    10982                       , d_fact-qnty
    10983                       , d_cli-fact-qnty
    10984                       )
    10985             view-as alert-box error .
    10986           undo, return error .
    10987         end.
    10988       end.
    10989     end.
    10990   end procedure.
    10991   PROCEDURE correct-fact-qnty :
    10992   define input parameter p-newfact-qnty like ub.doc-line.fact-qnty   no-undo .
    10993     define input parameter p-density      like ub.doc-line.doc-density no-undo .
    10994     do
    10995     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10996     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    10997     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    10998     :
    10999       define buffer buf-next_tt-doc-pl for tt-doc-pl .
    11000       assign
    11001         ub.doc-line.fact-density = p-density
    11002       .
    11003       display
    11004         p-newfact-qnty @ ub.gds-dtl.fact-qnty
    11005         p-newfact-qnty * p-density when v-fact-qnty-kg :visible = true @ v-fact-qnty-kg
    11006         with frame d-out-prt .
    11007       find first tt-doc-pl no-lock
    11008       .
    11009       find first buf-next_tt-doc-pl no-lock
    11010         where buf-next_tt-doc-pl.obj-type =  tt-doc-pl.obj-type
    11011           and buf-next_tt-doc-pl.obj-code =  tt-doc-pl.obj-code
    11012           and buf-next_tt-doc-pl.pl-code  <> tt-doc-pl.pl-code
    11013         no-error .
    11014       if available buf-next_tt-doc-pl then do:
    11015         for each tt-doc-pl
    11016         on error undo, return error return-value
    11017         :
    11018           assign
    11019             tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-density
    11020           .
    11021         end.
    11022         run edit-doc-pl in this-procedure
    11023           ( input 'АВТОИЗМЕНЕНИЕ':U
    11024           ) no-error .
    11025         if error-status :error then do:
    11026           return error return-value .
    11027         end.
    11028       end.
    11029       else do:
    11030         assign
    11031           tt-doc-pl.fact-qnty     = p-newfact-qnty
    11032           tt-doc-pl.cli-fact-qnty = p-newfact-qnty * p-density
    11033         .
    11034       end.
    11035     end.
    11036   END PROCEDURE.
    11037   PROCEDURE disable_UI :
    11038   HIDE FRAME d-out-prt NO-PAUSE.
    11039   END PROCEDURE.
    11040   PROCEDURE edit-doc-pl :
    11041   define input  parameter p-edit-doc-pl-mode as character no-undo .
    11042     define variable d_fact-qnty     as decimal   no-undo initial 0.00 .
    11043     define variable d_doc-qnty      as decimal   no-undo initial 0.00 .
    11044     define variable d_cli-fact-qnty as decimal   no-undo initial 0.00 .
    11045     define variable d_cli-doc-qnty  as decimal   no-undo initial 0.00 .
    11046     define variable v-log           as logical   no-undo .
    11047     define variable v-upd-units     as character no-undo .
    11048     if v-qnty-kg :sensitive  in frame d-out-prt = true
    11049       or v-fact-qnty-kg :sensitive  in frame d-out-prt = true
    11050     then do:
    11051       assign
    11052         v-upd-units = "cli":U
    11053       .
    11054     end.
    11055     else do:
    11056       assign
    11057         v-upd-units = "base":U
    11058       .
    11059     end.
    11060     if v-place-rsrv = false then do:
    11061       message
    11062         substitute( "Товар &1 не привязывается к местам хранения.", buf_goods.gds-code )
    11063         view-as alert-box.
    11064       return .
    11065     end.
    11066     if prt-mode = 'ПРОСМОТР':U
    11067       or t-doc.ext-doc-type = 'rv':U
    11068     then do:
    11069       assign
    11070         p-edit-doc-pl-mode = 'ПРОСМОТР':U
    11071       .
    11072     end.
    11073     else do:
    11074       if is-petrolium = yes
    11075         and is-pieces = no
    11076         and v-work-with-qnty = "doc":U
    11077       then do:
    11078         if ub.doc-line.doc-density = 0
    11079           or ub.doc-line.doc-density = ?
    11080         then do:
    11081           message
    11082             "Не указана плотность"
    11083             view-as alert-box information.
    11084           if ub.doc-line.doc-density :sensitive in frame d-out-prt then do:
    11085             apply "entry" to ub.doc-line.doc-density in frame d-out-prt .
    11086           end.
    11087           return error .
    11088         end.
    11089       end.
    11090     end.
    11091     run str/doc-pls.w
    11092       ( input parparentproc
    11093        ,input p-edit-doc-pl-mode
    11094        ,input v-work-with-qnty
    11095        ,input v-upd-units
    11096        ,input t-doc.doc-code
    11097        ,input buf_goods.gds-code
    11098        ,input ub.doc-line.unit-cli
    11099        ,input ub.doc-line.cli-base-rate
    11100        ,input ub.doc-line.doc-density
    11101        ,input ub.doc-line.fact-density
    11102        ,input input frame d-out-prt v-qnty-kg
    11103        ,input input frame d-out-prt ub.gds-dtl.doc-qnty
    11104        ,input input frame d-out-prt ub.gds-dtl.fact-qnty
    11105        ,input input frame d-out-prt v-qnty-kg
    11106        ,input input frame d-out-prt v-fact-qnty-kg
    11107        ,input ?
    11108        ,input ?
    11109        ,input ?
    11110       ) no-error .
    11111     if error-status :error then do:
    11112       message
    11113         vss-workfile vss-revision vss-description skip
    11114         "Ошибка при разбиении кол-ва по местам хранения." skip
    11115         error-status :get-message(1) skip
    11116         return-value skip
    11117         view-as alert-box error .
    11118     end.
    11119     if prt-mode <> 'ПРОСМОТР':U then do:
    11120       for each tt-doc-pl no-lock
    11121       on error undo, return error return-value
    11122       :
    11123         assign
    11124           d_fact-qnty     = d_fact-qnty     + tt-doc-pl.fact-qnty
    11125           d_doc-qnty      = d_doc-qnty      + tt-doc-pl.doc-qnty
    11126           d_cli-fact-qnty = d_cli-fact-qnty + tt-doc-pl.cli-fact-qnty
    11127           d_cli-doc-qnty  = d_cli-doc-qnty  + tt-doc-pl.cli-doc-qnty
    11128         .
    11129       end.
    11130       assign
    11131         v-log = true
    11132       .
    11133       if v-work-with-qnty = "doc":U
    11134         and ( input frame d-out-prt ub.gds-dtl.doc-qnty <> d_doc-qnty
    11135               or
    11136               ( ub.gds-dtl.doc-qnty :sensitive in frame d-out-prt = true
    11137                 and absolute( input frame d-out-prt v-qnty-kg - d_cli-doc-qnty ) > 0.001
    11138               )
    11139               or
    11140               ( v-qnty-kg :sensitive in frame d-out-prt = true
    11141                 and input frame d-out-prt v-qnty-kg <> d_cli-doc-qnty
    11142               )
    11143             )
    11144       then do:
    11145         message
    11146           substitute( "Документарная сумма по местам хранения: &1 &2 (&3 &4)", d_doc-qnty, buf_goods.unit-base, d_cli-doc-qnty, buf_goods.unit-cli ) skip
    11147           substitute( "Документарное кол-во по строке документа: &1 &2 (&3 &4)"
    11148                      ,input frame d-out-prt ub.gds-dtl.doc-qnty
    11149                      ,buf_goods.unit-base
    11150                      ,input frame d-out-prt v-qnty-kg
    11151                      ,buf_goods.unit-cli
    11152                     ) skip(1)
    11153           substitute( "Будем менять документарное количество по строке на &1 &2 (&3 &4)?", d_doc-qnty, buf_goods.unit-base, d_cli-doc-qnty, buf_goods.unit-cli )
    11154           view-as alert-box question buttons yes-no update v-log.
    11155         if v-log = true then do:
    11156           .
    11157           display
    11158             d_doc-qnty @ ub.gds-dtl.doc-qnty
    11159             d_doc-qnty * ub.doc-line.doc-density when v-qnty-kg :visible in frame d-out-prt = true @ v-qnty-kg
    11160             with frame d-out-prt .
    11161         end.
    11162       end.
    11163       if ( v-work-with-qnty = "fact":U
    11164            or v-work-with-qnty = "fact-doc":U
    11165          )
    11166         and varupd-fact-qnty = true
    11167         and ( input frame d-out-prt ub.gds-dtl.fact-qnty <> d_fact-qnty
    11168               or
    11169               ( v-fact-qnty-kg :sensitive in frame d-out-prt = true
    11170                 and input frame d-out-prt v-fact-qnty-kg <> d_cli-fact-qnty
    11171               )
    11172               or
    11173               ( ub.gds-dtl.fact-qnty :sensitive in frame d-out-prt = true
    11174                 and absolute( input frame d-out-prt v-fact-qnty-kg - d_cli-fact-qnty ) > 0.001
    11175               )
    11176             )
    11177       then do:
    11178         message
    11179           substitute( "Фактическая сумма по местам хранения: &1 &2 (&3 &4)", d_fact-qnty, buf_goods.unit-base, d_cli-fact-qnty, buf_goods.unit-cli ) skip
    11180           substitute( "Фактическое кол-во по строке документа: &1 &2 (&3 &4)"
    11181                       ,input frame d-out-prt ub.gds-dtl.fact-qnty
    11182                       ,buf_goods.unit-base
    11183                       ,input frame d-out-prt v-fact-qnty-kg
    11184                       ,buf_goods.unit-cli ) skip(1)
    11185           substitute( "Будем менять фактическое количество по строке на &1 &2 (&3 &4)?", d_fact-qnty, buf_goods.unit-base, d_cli-fact-qnty, buf_goods.unit-cli )
    11186           view-as alert-box question buttons yes-no update v-log.
    11187         if v-log = true then do:
    11188           assign
    11189             v-old-fact-qnty     = d_fact-qnty
    11190             v-old-fact-cli-qnty = d_cli-fact-qnty
    11191           .
    11192           display
    11193             d_fact-qnty @ ub.gds-dtl.fact-qnty
    11194             d_cli-fact-qnty when v-fact-qnty-kg :visible in frame d-out-prt = true @ v-fact-qnty-kg
    11195             with frame d-out-prt
    11196           .
    11197           if v-work-with-qnty = "fact-doc":U then do:
    11198             run str/doc-pls.w
    11199               ( input parparentproc
    11200               ,input 'АВТОИЗМЕНЕНИЕ':U + chr(4) + "calc-qnty":U
    11201               ,input v-work-with-qnty
    11202               ,input v-upd-units
    11203               ,input t-doc.doc-code
    11204               ,input buf_goods.gds-code
    11205               ,input ub.doc-line.unit-cli
    11206               ,input ub.doc-line.cli-base-rate
    11207               ,input ub.doc-line.doc-density
    11208               ,input ub.doc-line.fact-density
    11209               ,input input frame d-out-prt v-qnty-kg
    11210               ,input input frame d-out-prt ub.gds-dtl.doc-qnty
    11211               ,input input frame d-out-prt ub.gds-dtl.fact-qnty
    11212               ,input input frame d-out-prt v-qnty-kg
    11213               ,input input frame d-out-prt v-fact-qnty-kg
    11214               ,input ?
    11215               ,input ?
    11216               ,input ?
    11217               ) no-error .
    11218             if error-status :error then do:
    11219               message
    11220                 vss-workfile vss-revision vss-description skip
    11221                 "Ошибка при разбиении кол-ва по местам хранения." skip
    11222                 error-status :get-message(1) skip
    11223                 return-value skip
    11224                 view-as alert-box error .
    11225             end.
    11226           end.
    11227         end.
    11228       end.
    11229     end.
    11230   end procedure.
    11231   PROCEDURE l-doc-qnty :
    11232     define variable vGtin     as character no-undo.
    11233     define variable vGtinQnty as integer no-undo.
    11234     define variable v-mark-weight as decimal no-undo .
    11235     if v-isweighed
    11236     then do :
    11237       for each buf_marking-lines no-lock where
    11238                buf_marking-lines.out-code = t-doc.doc-code
    11239            and buf_marking-lines.obj-type = t-doc.obj-type
    11240            and buf_marking-lines.obj-code = t-doc.obj-code
    11241            and buf_marking-lines.gds-code = buf_goods.gds-code
    11242            and buf_marking-lines.doc-level = 1,
    11243           first buf_marking no-lock where
    11244                 buf_marking.mark = buf_marking-lines.mark
    11245       :
    11246         v-mark-weight = v-mark-weight + MarkWeight(buf_marking.mark).
    11247       end.
    11248       if v-mark-weight > input frame d-out-prt ub.gds-dtl.doc-qnty then
    11249       do:
    11250         message "Нельзя ввести количество меньше, чем просканировано марок по товару" view-as alert-box.
    11251         ub.gds-dtl.doc-qnty:screen-value = string(v-mark-weight).
    11252         apply "enrty" to ub.gds-dtl.doc-qnty in frame d-out-prt.
    11253         return error.
    11254       end.
    11255     end .
    11256     else
    11257     if vIsExemplarGoods then
    11258     do:
    11259       for each buf_marking-lines no-lock where
    11260                buf_marking-lines.out-code = t-doc.doc-code
    11261            and buf_marking-lines.obj-type = t-doc.obj-type
    11262            and buf_marking-lines.obj-code = t-doc.obj-code
    11263            and buf_marking-lines.gds-code = buf_goods.gds-code
    11264            and buf_marking-lines.doc-level = 1,
    11265           first buf_marking no-lock where
    11266                 buf_marking.mark = buf_marking-lines.mark
    11267       :
    11268         assign
    11269           vGtin     = getGtinByDM(buf_marking.mark)
    11270           vGtinQnty = vGtinQnty  + getQntyCodeByGtin(vGtin)
    11271         .
    11272       end.
    11273       if vGtinQnty > input frame d-out-prt ub.gds-dtl.doc-qnty then
