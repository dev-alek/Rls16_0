    12604             ub.gds-dtl.artic ub.gds-dtl.prod-code ub.gds-dtl.prod-type
    12605             ub.gds-dtl.price-rubl ub.gds-dtl.price-base
    12606             buf_goods.gds-name buf_goods.unit-base buf_goods.qnty-cart ub.doc-line.road-tax with frame d-out-prt.
    12607     if ptrlprop-expptrl = 'weight':U then do:
