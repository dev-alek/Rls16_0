    12636     if prt-mode <> 'ПРОСМОТР':U and v-is-return and vBackSale then
    12637     do:
    12638   define variable vss-include-info76 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12639   do:
    12640     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    12641       (input  v-cntxt-db-num
    12642       ,input  v-cntxt-userid
    12643       ,input  0
    12644       ,input  'actn_expense_price'
    12645       ,input  'object':U
    12646       ,input  t-doc.host-code
    12647       ,input  t-doc.obj-type
    12648       ,input  t-doc.obj-code
    12649       ,input  0
    12650       ,input  0
    12651       ,input  0
    12652       ,input  false
    12653       ,output isRightEditPrice
    12654       )  .
    12655   end.
    12656       if isRightEditPrice then
    12657         enable ub.gds-dtl.price-rubl with frame d-out-prt.
    12658     end.
    12659   end.
    12660   else if prt-mode <> 'ПРОСМОТР':U and t-doc.ext-doc-type = 'iv':U and is-petrolium and not is-pieces then do:
    12661       enable
    12662           ub.gds-dtl.fact-qnty
    12663           v-fact-qnty-kg
    12664           with frame d-out-prt
    12665       .
    12666   end.
    12667   else do:
    12668      hide r-price in frame d-out-prt.
    12669   end.
    12670   if t-doc.ext-doc-type = 'we':U then do:
    12671     if prt-mode <> 'ПРОСМОТР':U then enable c-reason with frame d-out-prt .
    12672     else disable c-reason with frame d-out-prt .
    12673   end.
    12674   else do:
    12675     c-reason:hidden in frame d-out-prt .
    12676   end.
    12677   g-image:SENSITIVE = g-image:VISIBLE.
    12678   if prt-mode <> 'ПРОСМОТР':U and ub.gds-dtl.price-corr = 0 then do :
    12679     define variable v-pr as decimal   no-undo .
    12680   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12681   run find-new-price-sale in this-procedure (
    12682      input  pr-genmrg
    12683     ,input  pr-naklvalue
    12684     ,input  t-doc.doc-code
    12685     ,input  ub.gds-dtl.artic
    12686     ,input  ub.gds-dtl.prod-type
    12687     ,input  ub.gds-dtl.prod-code
    12688     ,input  ub.gds-dtl.price-rubl
    12689     ,input  ub.gds-dtl.price-base
    12690     ,input  ub.gds-dtl.price-rubl
    12691     ,input  ub.gds-dtl.price-base
    12692     ,input-output v-pr
    12693       )
    12694       no-error .
    12695       display v-pr @ ub.gds-dtl.new-price-sale with frame d-out-prt .
    12696       assign ub.gds-dtl.new-price-sale.
    12697   end.
    12698   run new-price-s in this-procedure .
    12699   END PROCEDURE.
    12700   PROCEDURE write-doc-line-attr :
    12701   define input parameter p-doc-code       as character        no-undo.
    12702   define input parameter p-gds-code       as integer          no-undo.
    12703   define input parameter p-attr-code      as character        no-undo.
    12704   define input parameter p-attr-value     as character        no-undo.
    12705   define buffer buf_doc-line-attr       for ub.doc-line-attr.
    12706   do
    12707   for buf_doc-line-attr
    12708   on error undo, return error
    12709   :
    12710       find first buf_doc-line-attr exclusive-lock
    12711            where buf_doc-line-attr.doc-code     = p-doc-code
    12712              and buf_doc-line-attr.gds-code     = p-gds-code
    12713              and buf_doc-line-attr.attr-code    = p-attr-code
    12714       no-error.
    12715       if available buf_doc-line-attr
    12716       then do:
    12717           if p-attr-value = ?
    12718           or p-attr-value = "":U
    12719           then do:
    12720               delete buf_doc-line-attr.
    12721           end.
    12722           else do:
    12723               assign
    12724                   buf_doc-line-attr.attr-value = p-attr-value
    12725               .
    12726           end.
    12727       end.
    12728       else do:
    12729           if p-attr-value = ?
    12730           or p-attr-value = "":U
    12731           then do:
    12732             assign
    12733               p-attr-value = '':U
    12734             no-error .
    12735           end.
    12736           else do:
    12737               create buf_doc-line-attr.
    12738               assign
    12739                   buf_doc-line-attr.doc-code     = p-doc-code
    12740                   buf_doc-line-attr.gds-code     = p-gds-code
    12741                   buf_doc-line-attr.attr-code    = p-attr-code
    12742                   buf_doc-line-attr.attr-value   = p-attr-value
    12743               no-error .
    12744           end.
    12745       end.
    12746   end.
    12747   END PROCEDURE.
    12748   PROCEDURE init-temp :
    12749     define variable ii          as integer   no-undo .
    12750     define variable reason      as character no-undo .
    12751     define variable reason-code as character no-undo .
    12752     define variable reason-name as character no-undo .
    12753     define buffer buf_trn-reason for ub.trn-reason .
    12754   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12755   empty temp-table thbjattr_thbj-attr.
    12756   run adm/shattri.p (
    12757      input "get":U
    12758     ,input t-doc.obj-type
    12759     ,input t-doc.obj-code
    12760     ,input 'nakl_par':U
    12761     ,input  ""
    12762     ,output v-value-character
    12763     ,output v-value-date
    12764     ,output v-value-decimal
    12765     ,output v-value-integer
    12766     ,output v-value-logical
    12767     ,output par-type
    12768     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    12769     ) no-error .
    12770     for first thbjattr_thbj-attr no-lock where thbjattr_thbj-attr.prop-code = 'reasons-write-off':U:
    12771       reason-code  = thbjattr_thbj-attr.property-value-character .
    12772     end.
    12773     if reason-code <> "" then
    12774     do:
    12775       do ii = 1 to num-entries(reason-code):
    12776         reason-name = "" .
    12777         for first buf_trn-reason no-lock where buf_trn-reason.reason-code = integer(entry(ii,reason-code)):
    12778           reason-name = buf_trn-reason.reason-name .
    12779         end.
    12780         reason = reason + chr(44) + reason-name + chr(44) + entry(ii,reason-code) .
    12781       end.
    12782       reason = trim(reason,chr(44)).
    12783       ASSIGN
    12784         c-reason:LIST-ITEM-PAIRS  in frame d-out-prt = reason .
    12785     end.
    12786     if prt-mode <> 'ДОБАВЛЕНИЕ':U then do:
    12787           find first ub.doc-line-attr no-lock where ub.doc-line-attr.doc-code = t-doc.doc-code and
    12788           ub.doc-line-attr.gds-code = buf_goods.gds-code and
    12789           ub.doc-line-attr.attr-code = "reasonSpisan" no-error .
    12790           if available (ub.doc-line-attr) then do:
    12791             c-reason = integer (doc-line-attr.attr-value) .
    12792             display c-reason with frame d-out-prt .
    12793           end.
    12794       end.
    12795   END PROCEDURE.
