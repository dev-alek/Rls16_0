    10412         v-fact-qnty-kg:screen-value = string (v-fact-qnty-kg).
    10413         assign
    10414           ub.gds-dtl.price-rubl :label in frame d-out-prt = substitute("Цена,&1", buf_goods.unit-base )
    10415           v-price-rubl-kg       :label in frame d-out-prt = substitute("Цена,&1", buf_goods.unit-cli )
    10416           ub.gds-dtl.doc-qnty   :label in frame d-out-prt = substitute("По док,&1", buf_goods.unit-base )
    10417           ub.gds-dtl.fact-qnty  :label in frame d-out-prt = substitute("Факт,&1", buf_goods.unit-base )
    10418           v-qnty-kg             :label in frame d-out-prt = substitute("По док,&1", buf_goods.unit-cli )
    10419           v-fact-qnty-kg        :label in frame d-out-prt = substitute("Факт,&1", buf_goods.unit-cli )
    10420         .
    10421       end.
