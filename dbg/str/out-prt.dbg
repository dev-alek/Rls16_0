    11405   PROCEDURE check-fact-qnty :
    11406     if can-find( first ub.units where ub.units.unit-name = buf_goods.unit-base
    11407                         and lookup( 'шту':U, ub.units.type ) > 0 ) and
    11408       truncate( input frame d-out-prt ub.gds-dtl.fact-qnty,  0 )
    11409           <>    input frame d-out-prt ub.gds-dtl.fact-qnty
    11410     then do:
    11411       message "Базовая единица товара " buf_goods.unit-base " - штучная." skip
    11412               "Кол-во по факту должно быть целым."
    11413       view-as alert-box error.
    11414       return error.
    11415     end.
    11416     if ( ( lookup( t-doc.doc-type, 'при,возврат':U ) > 0
    11417            and t-doc.internal = true
    11418            and ( ub.gds-prt.upper-code = buf_goods.prt-root
    11419                  or can-find( out-dtl no-lock
    11420                               where out-dtl.doc-code  = t-doc.out-code
    11421                                 and out-dtl.artic     = ub.gds-dtl.artic
    11422                                 and out-dtl.prod-type = ub.gds-dtl.prod-type
    11423                                 and out-dtl.prod-code = ub.gds-dtl.prod-code
    11424                                 and out-dtl.prt-code  = ub.gds-dtl.prt-code
    11425                              )
    11426                )
    11427          )
    11428          or ( t-doc.doc-type = 'возврат':U
    11429               and t-doc.internal = false
    11430             )
    11431          or lookup( t-doc.doc-type, 'при,возврат':U ) = 0
    11432        )
    11433       and input frame d-out-prt ub.gds-dtl.fact-qnty - ub.gds-dtl.doc-qnty > ( if is-petrolium = true and is-pieces = false then 0.001 else 0.0 )
    11434     then do:
    11435       message
    11436         "Фактическое количество товара не может быть больше количества по накладной."
    11437         view-as alert-box.
    11438       apply "ENTRY":U to ub.gds-dtl.fact-qnty in frame d-out-prt.
    11439       return error.
    11440     end.
    11441   END PROCEDURE.
    11442   PROCEDURE leave-price-rubl :
    11443         run re-calcpr in this-procedure .
    11444   END PROCEDURE.
