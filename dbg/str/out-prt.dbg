     1560   procedure get-ptrl-prop :
     1561     define input  parameter p-obj-type as character no-undo .
     1562     define input  parameter p-obj-code as integer   no-undo .
     1563     do
     1564     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1565     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1566     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1567     :
     1568       define variable par-type          as character no-undo.
     1569       define variable v-value-character as character no-undo .
     1570       define variable v-value-date      as date      no-undo .
     1571       define variable v-value-decimal   as decimal   no-undo .
     1572       define variable v-value-integer   as integer   no-undo .
     1573       define variable v-value-logical   as logical   no-undo .
     1574       for each thbjattr_thbj-attr
     1575       :
     1576         delete thbjattr_thbj-attr .
     1577       end.
     1578       run adm/shattri.p
     1579         ( input "get":U
     1580         , input p-obj-type
     1581         , input p-obj-code
     1582         , input 'petrol':U
     1583         , input  ""
     1584         , output v-value-character
     1585         , output v-value-date
     1586         , output v-value-decimal
     1587         , output v-value-integer
     1588         , output v-value-logical
     1589         , output par-type
     1590         , input-output table thbjattr_thbj-attr
     1591         ) no-error .
     1592       for each thbjattr_thbj-attr
     1593       on error undo, return error return-value
     1594       :
     1595         case thbjattr_thbj-attr.prop-code :
     1596           when 'denstclc':U then do:
     1597             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1598               assign
     1599                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1600               .
     1601             end.
     1602           end.
     1603           when 'expptrl':U then do:
     1604             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1605               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1606             then do:
     1607               assign
     1608                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1609               .
     1610             end.
     1611           end.
     1612           when 'inpptrl':U then do:
     1613             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1614               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1615             then do:
     1616               assign
     1617                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1618               .
     1619             end.
     1620           end.
