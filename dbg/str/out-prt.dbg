     8105          b-addinf:HIDDEN IN FRAME d-out-prt           = TRUE.
     8106   ASSIGN
     8107          b-rvs-af:HIDDEN IN FRAME d-out-prt           = TRUE.
     8108   ASSIGN
     8109          b-rvs-bf:HIDDEN IN FRAME d-out-prt           = TRUE.
     8110   ON END-ERROR OF FRAME d-out-prt
     8111   DO:
     8112     apply "CHOOSE":U to b-quit in frame d-out-prt.
     8113     return no-apply.
     8114   END.
     8115   ON CHOOSE OF b-addinf IN FRAME d-out-prt
     8116   DO:
     8117     define variable v-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     8118     define variable v-new-density          like ub.doc-line.fact-density no-undo .
     8119     define variable v-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     8120     if t-doc.doc-type = 'при':U then do:
     8121       assign
     8122         v-new-fact-qnty     = ( input frame d-out-prt ub.gds-dtl.fact-qnty )
     8123         v-new-density       = ub.doc-line.fact-density
     8124         v-new-cli-fact-qnty = ( input frame d-out-prt v-fact-qnty-kg )
     8125       .
     8126       run proc-b-addinfo in this-procedure
     8127         ( input        parparentproc
     8128          ,input        ( if prt-mode <> 'ПРОСМОТР':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U )
     8129          ,input        ub.doc-line.doc-code
     8130          ,input        buf_goods.gds-code
     8131          ,input        stfactplvalue
     8132          ,input        varauto-tank
     8133          ,input        varupd-fact-qnty
     8134          ,input        input frame d-out-prt ub.gds-dtl.doc-qnty
     8135          ,input        ub.doc-line.doc-density
     8136          ,input-output v-new-fact-qnty
     8137          ,input-output v-new-density
     8138          ,input-output v-new-cli-fact-qnty
     8139          ,input-output v-prt-car-num
     8140          ,input-output v-prt-car-vol
     8141          ,input-output v-prt-tests
     8142          ,input-output v-prt-autoent-obj-type
     8143          ,input-output v-prt-autoent-obj-code
     8144          ,input-output v-prt-item-pour
     8145          ,input-output v-prt-time-pour
     8146          ,input-output v-prt-tank-vol
     8147          ,input-output v-prt-tank-temp
     8148          ,input-output v-prt-tank-water
     8149          ,input-output v-prt-tank-density
     8150          ,input-output v-prt-tank-weight
     8151          ,input-output v-prt-time-income
     8152          ,input-output v-prt-start-real-date
     8153          ,input-output v-prt-start-real-time
     8154          ,input-output v-prt-end-real-date
     8155          ,input-output v-prt-end-real-time
     8156          ,input-output v-prt-mouth
     8157          ,input-output v-prt-fio
     8158          ,input-output v-prt-ptbotype
     8159          ,input-output v-prt-ptbocode
     8160          ,input-output v-prt-a-b-tarir
     8161          ,input-output v-diameter
     8162          ,input-output v-place-si
     8163          ,input-output v-tank-density-pomi
     8164          ,input-output v-prt-certif-fuel
     8165          ,input-output v-prt-norm-doc
     8166          ,input-output v-prt-num-passport
     8167          ,input-output v-prt-validity-certif
     8168          ,input-output v-prt-passport-plotn
     8169          ,input-output v-prt-num-plotn
     8170          ,input-output v-prt-date-pov-plotn
     8171         ) no-error .
     8172       if error-status :error then do:
     8173         message
     8174           substitute("Ошибка при изменении дополнительной информации.") skip
     8175           error-status :get-message(1) skip
     8176           return-value skip
     8177           view-as alert-box error .
     8178         return no-apply .
     8179       end.
     8180       if ( input frame d-out-prt ub.gds-dtl.fact-qnty ) <> v-new-fact-qnty
     8181         or ( input frame d-out-prt v-fact-qnty-kg ) <> v-new-cli-fact-qnty
     8182         or ub.doc-line.fact-density <> v-new-density
     8183       then do:
     8184         run correct-fact-qnty in this-procedure
     8185           ( input v-new-fact-qnty
     8186            ,input v-new-density
     8187           ) no-error .
     8188       end.
     8189     end.
     8190     else do:
     8191       run str/out-ladd.w
     8192         ( input ParParentProc
     8193          ,input ( if prt-mode <> 'ПРОСМОТР':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U )
     8194          ,input-output v-prt-car-num
     8195          ,input-output v-prt-autoent-obj-type
     8196          ,input-output v-prt-autoent-obj-code
     8197         ) no-error.
     8198       if error-status :error then do:
     8199         message
     8200             vss-workfile vss-revision vss-description
     8201             skip(1)
     8202             skip "Ошибка дополнительных данных строки."
     8203             skip return-value
     8204             skip trim(error-status :get-message(1))
     8205                   trim(error-status :get-message(2))
     8206                   trim(error-status :get-message(3))
     8207         view-as alert-box error.
     8208         undo, return no-apply .
     8209       end.
     8210     end.
     8211   END.
     8212   ON CHOOSE OF b-arch IN FRAME d-out-prt
     8213   DO:
     8214     define variable calc_price-base as decimal no-undo.
     8215     define variable calc_price-rubl as decimal no-undo.
     8216     define variable v-chk-act-host-code as integer   no-undo .
     8217   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8219     (input  ub.doc-line.obj-type
     8220     ,input  ub.doc-line.obj-code
     8221     ,output v-chk-act-host-code
     8222     )  .
     8223   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8224   do:
     8225     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8226       (input  v-cntxt-db-num
     8227       ,input  v-cntxt-userid
     8228       ,input  0
     8229       ,input  'actn_archive_cost':U
     8230       ,input  'object':U
     8231       ,input  v-chk-act-host-code
     8232       ,input  ub.doc-line.obj-type
     8233       ,input  ub.doc-line.obj-code
     8234       ,input  0
     8235       ,input  0
     8236       ,input  0
     8237       ,input  true
     8238       ,output g#log
     8239       )  .
     8240   end.
     8241     if g#log <> yes then do: return no-apply. end.
     8242     assign
     8243       calc_price-base = ub.doc-line.price-base * ub.gds-dtl.fact-qnty
     8244       calc_price-rubl = ub.doc-line.price-rubl * ub.gds-dtl.fact-qnty
     8245     .
     8246     message "Сумма в ценах документа:" skip
     8247       string( calc_price-base,     "->>,>>>,>>>,>>9.99":U ) base-type skip
     8248       string( calc_price-rubl, "->>,>>>,>>>,>>>,>>9.99":U ) "РУБ"     skip( 2 )
     8249             "Сумма к оплате:" skip
     8250       string( tot-base,     "->>,>>>,>>>,>>9.99":U ) base-type skip
     8251       string( tot-rubl, "->>,>>>,>>>,>>>,>>9.99":U ) "РУБ"     skip( 2 )
     8252             "Разница:" skip
     8253       string( tot-base - calc_price-base,     "->>,>>>,>>>,>>9.99":U ) base-type skip
     8254       string( tot-rubl - calc_price-rubl, "->>,>>>,>>>,>>>,>>9.99":U ) "РУБ"     skip( 2 )
     8255             "Наценка:"
     8256       string( ( tot-base - calc_price-base ) / calc_price-base * 100, "->>9.9<%":U )
     8257     view-as alert-box title 'Товар: "' + buf_goods.gds-name + '".  Признак: "' + ub.gds-prt.f-name + '".'.
     8258   END.
     8259   ON CHOOSE OF b-corr-price-sale IN FRAME d-out-prt
     8260   DO:
     8261   END.
     8262   ON CHOOSE OF b-exit IN FRAME d-out-prt
     8263   DO:
     8264   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8265   if lookup(self :type
     8266            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     8267            ) = 0
     8268   then do:
     8269     message
     8270       "$Workfile$"
     8271       "Указанному интерфейсному элементу фокус не может быть передан" skip
     8272       "Интерфейсный элемент" self :name  skip
     8273       "Тип" self :type  skip
     8274       "Процедура" this-procedure :file-name skip
     8275       view-as alert-box .
     8276   end.
     8277   else do:
     8278     apply "entry":u to self  .
     8279     if focus :handle <> self :handle  then do:
     8280       return no-apply .
     8281     end.
     8282   end.
     8283     define variable total_gds-dtl_doc-qnty  like ub.gds-dtl.doc-qnty      no-undo.
     8284     define variable total_gds-dtl_fact-qnty like ub.gds-dtl.fact-qnty     no-undo.
     8285     define variable t_qty                   like ub.gds-dtl.fact-qnty     no-undo.
     8286     define variable varprt-obj_free-qnty    like ub.prt-obj.free-qnty     no-undo.
     8287     define variable v-ok                    as   logical                  no-undo .
     8288     define variable v-new-fact-qnty         like ub.doc-line.fact-qnty    no-undo .
     8289     define variable v-new-density           like ub.doc-line.fact-density no-undo .
     8290     define variable v-new-cli-fact-qnty     like ub.doc-line.fact-qnty    no-undo .
     8291     if prt-mode = 'ПРОСМОТР':U then do:
     8292       return no-apply.
     8293     end.
     8294         if t-doc.ext-doc-type = 'iv':U then
     8295         do:
     8296           if can-find(first buf_marking-lines where
     8297                             buf_marking-lines.out-code = t-doc.doc-code
     8298                         and buf_marking-lines.gds-code = buf_goods.gds-code) then
     8299             return .
     8300         end.
     8301     run check-fact-qnty in this-procedure no-error .
     8302     if error-status :error then return no-apply.
     8303     block_save:
     8304     do transaction
     8305     on error undo block_save, return no-apply
     8306     :
     8307       if can-find( first ub.units where ub.units.unit-name = buf_goods.unit-base
     8308                           and lookup( 'шту':U, ub.units.type) > 0 ) and
     8309         truncate( input frame d-out-prt ub.gds-dtl.doc-qnty,  0 )
     8310             <>    input frame d-out-prt ub.gds-dtl.doc-qnty
     8311       then do:
     8312         message "Базовая единица товара " buf_goods.unit-base " - штучная." skip
     8313                 "Кол-во по документу должно быть целым."
     8314         view-as alert-box error.
     8315         return no-apply.
     8316       end.
     8317       if t-doc.ext-doc-type = 'we':U then do:
     8318         if c-reason > 0 then do:
     8319           find first ub.doc-line-attr no-lock where ub.doc-line-attr.doc-code = t-doc.doc-code and
     8320           ub.doc-line-attr.gds-code = buf_goods.gds-code and
     8321           ub.doc-line-attr.attr-code = "reasonSpisan" no-error .
     8322           if not available (ub.doc-line-attr) then do:
     8323             create ub.doc-line-attr .
     8324             assign
     8325             ub.doc-line-attr.doc-code = t-doc.doc-code
     8326             ub.doc-line-attr.gds-code = buf_goods.gds-code
     8327             ub.doc-line-attr.attr-code = "reasonSpisan"
     8328             .
     8329           end.
     8330           ub.doc-line-attr.attr-value = string (c-reason) .
     8331         end.
     8332       end.
     8333       if t-doc.doc-type = 'рас':U
     8334       and buf_goods.qnty-cart <> 0
     8335       and not v-is-return
     8336       and not v-isweighed
     8337       then do:
     8338         if (input frame d-out-prt ub.gds-dtl.doc-qnty / buf_goods.qnty-cart) - round (input frame d-out-prt ub.gds-dtl.doc-qnty / buf_goods.qnty-cart, 0) <> 0 then do:
     8339           if available ub.prt-obj then do:
     8340             assign
     8341               varprt-obj_free-qnty = ub.prt-obj.free-qnty
     8342             .
     8343           end.
     8344           else do:
     8345             assign
     8346               varprt-obj_free-qnty = 0
     8347             .
     8348           end.
     8349           if t-doc.status_ = 'запрос':U or
     8350             ( varprt-obj_free-qnty + ub.gds-dtl.doc-qnty > buf_goods.qnty-cart and
     8351               varprt-obj_free-qnty + ub.gds-dtl.doc-qnty <> input frame d-out-prt ub.gds-dtl.doc-qnty ) then do:
     8352             assign
     8353               g#log = yes
     8354             .
     8355             message "Товар рекомендуется выписывать упаковками." skip( 2 )
     8356                     "Округлить до целого числа упаковок ?"
     8357             view-as alert-box question buttons YES-NO update g#log.
     8358             if g#log then do:
     8359               if round( input frame d-out-prt ub.gds-dtl.doc-qnty / buf_goods.qnty-cart, 0 ) = 0 then do:
     8360                 display
     8361                   buf_goods.qnty-cart @ ub.gds-dtl.doc-qnty
     8362                 with frame d-out-prt.
     8363               end.
     8364               else do:
     8365                 display
     8366                   round( input frame d-out-prt ub.gds-dtl.doc-qnty / buf_goods.qnty-cart, 0 ) *
     8367                                                   buf_goods.qnty-cart  @ ub.gds-dtl.doc-qnty
     8368                 with frame d-out-prt.
     8369               end.
     8370             end.
     8371           end.
     8372         end.
     8373       end.
     8374       if prt-mode = 'ШКАЛА':U or prt-mode = 'БЕЗ_ПРИЗНАКОВ':U then do:
     8375         assign
     8376           total_gds-dtl_doc-qnty  = 0
     8377           total_gds-dtl_fact-qnty = 0
     8378         .
     8379         for each g-d-b where g-d-b.prod-code = ub.doc-line.prod-code
     8380                         and g-d-b.prod-type = ub.doc-line.prod-type
     8381                         and g-d-b.artic     = ub.doc-line.artic
     8382                         and g-d-b.doc-code  = ub.doc-line.doc-code
     8383                         and g-d-b.prt-code <> ub.gds-dtl.prt-code :
     8384           assign
     8385             total_gds-dtl_doc-qnty  = total_gds-dtl_doc-qnty  + g-d-b.doc-qnty
     8386             total_gds-dtl_fact-qnty = total_gds-dtl_fact-qnty + g-d-b.fact-qnty
     8387           .
     8388         end.
     8389         assign
     8390           total_gds-dtl_doc-qnty  = total_gds-dtl_doc-qnty  + ( input frame d-out-prt ub.gds-dtl.doc-qnty  )
     8391           total_gds-dtl_fact-qnty = total_gds-dtl_fact-qnty + ( input frame d-out-prt ub.gds-dtl.fact-qnty )
     8392         .
     8393       end.
     8394       run re-calcpr in this-procedure .
     8395       if is-petrolium = yes
     8396         and is-pieces = no
     8397         and not is-gas(buf_goods.gds-code)
     8398       then do:
     8399         if
     8400     valid-density( ub.doc-line.doc-density, buf_goods.unit-base = buf_goods.unit-cli )
     8401     <> true then do:
     8402           message
     8403             "Неверное значение плотности для топлива:" ub.doc-line.doc-density "." skip
     8404             "Плотность топлива должна быть в диапазоне: больше 0 и меньше 1."
     8405             view-as alert-box error title " ОШИБКА!!! ".
     8406           apply "ENTRY":U to ub.doc-line.doc-density in frame d-out-prt.
     8407           return no-apply.
     8408         end.
     8409         if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     8410           if (ub.doc-line.doc-density) < v-min-dens
     8411           or (ub.doc-line.doc-density) > v-max-dens
     8412           then do:
     8413               message
     8414                 substitute("Введенное значение плотности находится вне заданного диапазона: &1.",
     8415                 v-gds-ptrl-densities )
     8416                 view-as alert-box error .
     8417               apply "ENTRY":U to ub.doc-line.doc-density in frame d-out-prt.
     8418               return no-apply .
     8419           end.
     8420         end.
     8421         if t-doc.doc-type = 'при':U then do:
     8422           if v-work-with-qnty = "fact":U
     8423             or v-work-with-qnty = "fact-doc":U
     8424           then do:
     8425             assign
     8426               v-ok = true
     8427             .
     8428             run chkdcrvs in this-procedure
     8429               ( input  t-doc.doc-code
     8430               ,input  buf_goods.gds-code
     8431               ,output v-ok
     8432               ) no-error .
     8433             if error-status :error then do:
     8434               message
     8435                 vss-workfile vss-revision vss-description skip
     8436                 error-status :get-message(1) skip
     8437                 return-value skip
     8438                 view-as alert-box error .
     8439               return no-apply .
     8440             end.
     8441             if v-ok = true then do:
     8442               assign
     8443                 v-new-fact-qnty     = (input frame d-out-prt ub.gds-dtl.fact-qnty)
     8444                 v-new-density       = ub.doc-line.fact-density
     8445                 v-new-cli-fact-qnty = (input frame d-out-prt v-fact-qnty-kg)
     8446               .
     8447               run local-state-fact-rvs in this-procedure
     8448                 ( input        t-doc.doc-code
     8449                 ,input        buf_goods.gds-code
     8450                 ,input        stfactplvalue
     8451                 ,input        varrevision
     8452                 ,input        varupd-fact-qnty
     8453                 ,input        (input frame d-out-prt ub.gds-dtl.doc-qnty)
     8454                 ,input        ub.doc-line.doc-density
     8455                 ,input-output v-new-fact-qnty
     8456                 ,input-output v-new-density
     8457                 ,input-output v-new-cli-fact-qnty
     8458                 ) no-error .
     8459               if error-status :error then do:
     8460                 message
     8461                   "Ошибка при установке факт кол-ва (revision)." skip
     8462                   return-value
     8463                   view-as alert-box error .
     8464                 undo block_save, return no-apply .
     8465               end.
     8466               if ( input frame d-out-prt ub.gds-dtl.fact-qnty ) <> v-new-fact-qnty
     8467                 or ( input frame d-out-prt v-fact-qnty-kg ) <> v-new-cli-fact-qnty
     8468                 or ub.doc-line.fact-density <> v-new-density
     8469               then do:
     8470                 run correct-fact-qnty in this-procedure
     8471                   ( input v-new-fact-qnty
     8472                   ,input v-new-density
     8473                   ) no-error .
     8474               end.
     8475               assign
     8476                 v-new-fact-qnty     = (input frame d-out-prt ub.gds-dtl.fact-qnty)
     8477                 v-new-density       = ub.doc-line.fact-density
     8478                 v-new-cli-fact-qnty = (input frame d-out-prt v-fact-qnty-kg)
     8479               .
     8480               run eq-qnty-rvs-pl in this-procedure
     8481                 ( input        t-doc.doc-code
     8482                 ,input        buf_goods.gds-code
     8483                 ,input        varupd-fact-qnty
     8484                 ,input-output v-new-fact-qnty
     8485                 ,input-output v-new-density
     8486                 ,input-output v-new-cli-fact-qnty
     8487                 ,      output v-ok
     8488                 ) no-error .
     8489               if error-status :error then do:
     8490                 message
     8491                   "Ошибка при установке факт кол-ва по местам хранения." skip
     8492                   return-value
     8493                   view-as alert-box error .
     8494                 undo block_save, return no-apply .
     8495               end.
     8496               if ( input frame d-out-prt ub.gds-dtl.fact-qnty ) <> v-new-fact-qnty
     8497                 or ( input frame d-out-prt v-fact-qnty-kg ) <> v-new-cli-fact-qnty
     8498                 or ub.doc-line.fact-density <> v-new-density
     8499               then do:
     8500                 assign
     8501                   ub.doc-line.fact-density = v-new-density
     8502                 .
     8503                 display
     8504                   v-new-fact-qnty @ ub.gds-dtl.fact-qnty
     8505                   v-new-fact-qnty * v-new-density when v-fact-qnty-kg :visible = true @ v-fact-qnty-kg
     8506                   with frame d-out-prt .
     8507               end.
     8508               if v-ok = false then do:
     8509                 return .
     8510               end.
     8511             end.
     8512           end.
     8513           run str/in-laddout.w
     8514             ( input        parParentProc
     8515             ,input        "set-attr":U
     8516             ,input        t-doc.doc-code
     8517             ,input        buf_goods.gds-code
     8518             ,input-output v-prt-car-num
     8519             ,input-output v-prt-car-vol
     8520             ,input-output v-prt-tests
     8521             ,input-output v-prt-autoent-obj-type
     8522             ,input-output v-prt-autoent-obj-code
     8523             ,input-output v-prt-item-pour
     8524             ,input-output v-prt-time-pour
     8525             ,input-output v-prt-tank-vol
     8526             ,input-output v-prt-tank-temp
     8527             ,input-output v-prt-tank-water
     8528             ,input-output v-prt-tank-density
     8529             ,input-output v-prt-tank-weight
     8530             ,input-output v-prt-time-income
     8531             ,input-output v-prt-start-real-date
     8532             ,input-output v-prt-start-real-time
     8533             ,input-output v-prt-end-real-date
     8534             ,input-output v-prt-end-real-time
     8535             ,input-output v-prt-mouth
     8536             ,input-output v-prt-fio
     8537             ,input-output v-prt-ptbotype
     8538             ,input-output v-prt-ptbocode
     8539             ,input-output v-prt-a-b-tarir
     8540             ,input-output v-diameter
     8541             ,input-output v-place-si
     8542             ,input-output v-tank-density-pomi
     8543             ,input-output v-prt-certif-fuel
     8544             ,input-output v-prt-norm-doc
     8545             ,input-output v-prt-num-passport
     8546             ,input-output v-prt-validity-certif
     8547             ,input-output v-prt-passport-plotn
     8548             ,input-output v-prt-num-plotn
     8549             ,input-output v-prt-date-pov-plotn
     8550             ,      output was_setting
     8551             ) no-error .
     8552           if error-status :error then do:
     8553             message
     8554               vss-workfile vss-revision vss-description skip
     8555               substitute("Ошибка при сохранении дополнительной информации!") skip
     8556               error-status :get-message(1) skip
     8557               return-value skip
     8558               view-as alert-box error .
     8559             return no-apply.
     8560           end.
     8561         end.
     8562         else do:
     8563           run write-doc-line-attr in this-procedure (
     8564                 input ub.doc-line.doc-code
     8565               , input buf_goods.gds-code
     8566               , input "car-num":U
     8567               , input v-prt-car-num
     8568           ).
     8569           run write-doc-line-attr in this-procedure (
     8570                 input ub.doc-line.doc-code
     8571               , input buf_goods.gds-code
     8572               , input "autoent-obj-type":U
     8573               , input v-prt-autoent-obj-type
     8574           ).
     8575           run write-doc-line-attr in this-procedure (
     8576                 input ub.doc-line.doc-code
     8577               , input buf_goods.gds-code
     8578               , input "autoent-obj-code":U
     8579               , input v-prt-autoent-obj-code
     8580           ).
     8581         end.
     8582       end.
     8583       run check-place-rsrv in this-procedure
     8584         no-error .
     8585       if error-status :error then do:
     8586         undo block_save, return no-apply.
     8587       end.
     8588       if ub.gds-dtl.fact-qnty :sensitive in frame d-out-prt = true
     8589         and input frame d-out-prt ub.gds-dtl.fact-qnty = 0.0
     8590         and ub.gds-dtl.doc-qnty = 0.0
     8591       then do:
     8592         message
     8593           "Установлено факт количество = 0. Изменения игнорируются."
     8594           view-as alert-box information.
     8595         undo block_save, return no-apply.
     8596       end.
     8597       if input frame d-out-prt ub.gds-dtl.doc-qnty = 0.0 then do:
     8598         if v-work-with-qnty = "doc":U then do:
     8599           message
     8600             "Установлено количество = 0. Изменения игнорируются."
     8601             view-as alert-box information.
     8602           undo block_save, return no-apply.
     8603         end.
     8604       end.
     8605       else do:
     8606         if ( ( input frame d-out-prt ub.gds-dtl.price-base = ? and not t-doc.print-rubl )
     8607               or
     8608               ( input frame d-out-prt ub.gds-dtl.price-rubl = ? and t-doc.print-rubl )
     8609             )
     8610           and t-doc.status_ <> 'запрос':U
     8611           and t-doc.ext-doc-type <> 'ep':U
     8612         then do:
     8613           message
     8614             "Указана неизвестная цена. Изменения игнорируются."
     8615             view-as alert-box information.
     8616           undo block_save, return no-apply.
     8617         end.
     8618       end.
     8619       if v-is-return
     8620       then do :
     8621         if v-work-with-qnty = "doc":U then do:
     8622           v-new-qnty = input frame d-out-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty .
     8623         end .
     8624         else do :
     8625           v-new-qnty = input frame d-out-prt ub.gds-dtl.fact-qnty - ub.gds-dtl.fact-qnty .
     8626         end .
     8627         find first in_parts no-lock where recid(in_parts) = in-part-rec no-error .
     8628         if available in_parts
     8629         then do :
     8630           v-free-qnty = in_parts.fact-qnty .
     8631           for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'parts':U
     8632                                           and buf_gen-attr.attr-code  = "in-part-key"
     8633                                           and buf_gen-attr.attr-value =  "parts"                + chr(3) +
     8634    in_parts.obj-type           + chr(3) +
     8635    string(in_parts.obj-code)   + chr(3) +
     8636    in_parts.artic              + chr(3) +
     8637    in_parts.prod-type          + chr(3) +
     8638    string(in_parts.prod-code)  + chr(3) +
     8639    in_parts.In-code            + chr(3) +
     8640    in_parts.Out-code           + chr(3) +
     8641    in_parts.part-Code          + chr(3) +
     8642    string(in_parts.prt-code)
     8643    ,
     8644           first out_parts no-lock where out_parts.obj-type  = entry(2, buf_gen-attr.p-key, chr(3))
     8645                                     and out_parts.obj-code  = integer(entry(3, buf_gen-attr.p-key, chr(3)))
     8646                                     and out_parts.artic     = entry(4, buf_gen-attr.p-key, chr(3))
     8647                                     and out_parts.prod-type = entry(5, buf_gen-attr.p-key, chr(3))
     8648                                     and out_parts.prod-code = integer(entry(6, buf_gen-attr.p-key, chr(3)))
     8649                                     and out_parts.in-code   = entry(7, buf_gen-attr.p-key, chr(3))
     8650                                     and out_parts.out-code  = entry(8, buf_gen-attr.p-key, chr(3))
     8651                                     and out_parts.part-code = entry(9, buf_gen-attr.p-key, chr(3))
     8652           :
     8653             v-free-qnty = v-free-qnty - out_parts.fact-qnty .
     8654           end .
     8655           find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = t-doc.obj-type
     8656                                            and buf_gds-obj.obj-code  = t-doc.obj-code
     8657                                            and buf_gds-obj.artic     = buf_goods.artic
     8658                                            and buf_gds-obj.prod-type = buf_goods.prod-type
     8659                                            and buf_gds-obj.prod-code = buf_goods.prod-code
     8660                                            no-error .
     8661           if error-status :error
     8662           then do:
     8663             message
     8664               error-status :get-message(1) skip
     8665               return-value skip
     8666               view-as alert-box error .
     8667             undo block_save, return no-apply.
     8668           end.
     8669           if buf_gds-obj.free-qnty < v-new-qnty
     8670           then do :
     8671             message substitute ("Возвращаемое количество превышает текущий остаток, равный &1. Возврат не возможен.", buf_gds-obj.free-qnty) view-as alert-box .
     8672             display
     8673               ub.gds-dtl.doc-qnty
     8674             with frame d-out-prt.
     8675             undo block_save, return no-apply.
     8676           end .
     8677           if v-new-qnty > v-free-qnty
     8678           then do :
     8679             if t-doc.reason-code = 25
     8680             then do :
     8681               v-no-add-marks = yes .
     8682               message "Введенное количество превышает максимально допустимое к возврату по выбранной партии. Количество установлено максимально возможным" view-as alert-box .
     8683               if node-type begins "scan-marks"
     8684               then do :
     8685                 if v-work-with-qnty = "doc":U
     8686                 then do:
     8687                   display
     8688                     ub.gds-dtl.doc-qnty
     8689                   with frame d-out-prt.
     8690                 end .
     8691                 else do :
     8692                   display
     8693                     ub.gds-dtl.fact-qnty
     8694                   with frame d-out-prt.
     8695                 end .
     8696               end .
     8697               else do :
     8698                 if v-work-with-qnty = "doc":U
     8699                 then do:
     8700                   display
     8701                     ub.gds-dtl.doc-qnty + v-free-qnty @ ub.gds-dtl.doc-qnty
     8702                   with frame d-out-prt.
     8703                 end .
     8704                 else do :
     8705                   display
     8706                     ub.gds-dtl.fact-qnty + v-free-qnty @ ub.gds-dtl.fact-qnty
     8707                   with frame d-out-prt.
     8708                 end .
     8709               end .
     8710             end .
     8711             if t-doc.reason-code = 23
     8712             then do :
     8713               if node-type begins "scan-marks"
     8714               and v-free-qnty < 0
     8715               then do : end .
     8716               else do :
     8717                 message "Введенное количество превышает максимально допустимое к возврату по выбранной партии, продолжить оформление возврата указанного количества?"
     8718                 view-as alert-box question buttons yes-no update g#log .
     8719                 if not g#log
     8720                 then do :
     8721                   v-no-add-marks = yes .
     8722                   if node-type begins "scan-marks"
     8723                   then do :
     8724                     display
     8725                       ub.gds-dtl.doc-qnty
     8726                     with frame d-out-prt.
     8727                   end .
     8728                   else do :
     8729                     display
     8730                       ub.gds-dtl.doc-qnty
     8731                     with frame d-out-prt.
     8732                     undo block_save, return no-apply.
     8733                   end .
     8734                 end .
     8735               end .
     8736             end .
     8737           end .
     8738           if buf_gds-obj.free-qnty < v-new-qnty
     8739           then do :
     8740             message substitute ("Возвращаемое количество превышает текущий остаток, равный &1. Возврат не возможен.", buf_gds-obj.free-qnty) view-as alert-box .
     8741             display
     8742               ub.gds-dtl.doc-qnty
     8743             with frame d-out-prt.
     8744             undo block_save, return no-apply.
     8745           end .
     8746           node-type = 'терм':U .
     8747         end .
     8748       end .
     8749       run rsrv-out in this-procedure
     8750         no-error .
     8751       if error-status :error then do:
     8752         message
     8753           error-status :get-message(1) skip
     8754           return-value skip
     8755           view-as alert-box error .
     8756         undo block_save, return no-apply.
     8757       end.
     8758       if v-is-return
     8759       and available in_parts
     8760       then do :
     8761         for each out_parts no-lock where out_parts.obj-type  = in_parts.obj-type
     8762                                      and out_parts.obj-code  = in_parts.obj-code
     8763                                      and out_parts.artic     = in_parts.artic
     8764                                      and out_parts.prod-type = in_parts.prod-type
     8765                                      and out_parts.prod-code = in_parts.prod-code
     8766                                      and out_parts.out-code  = t-doc.doc-code
     8767         :
     8768           find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'parts':U
     8769                                             and buf_gen-attr.p-key      =  "parts"                + chr(3) +
     8770    out_parts.obj-type           + chr(3) +
     8771    string(out_parts.obj-code)   + chr(3) +
     8772    out_parts.artic              + chr(3) +
     8773    out_parts.prod-type          + chr(3) +
     8774    string(out_parts.prod-code)  + chr(3) +
     8775    out_parts.In-code            + chr(3) +
     8776    out_parts.Out-code           + chr(3) +
     8777    out_parts.part-Code          + chr(3) +
     8778    string(out_parts.prt-code)
     8779                                             and buf_gen-attr.attr-code  = "in-part-key"
     8780                                             no-error .
     8781           if not available buf_gen-attr
     8782           then do :
     8783             create buf_gen-attr .
     8784             assign
     8785               buf_gen-attr.table-name = 'parts':U
     8786               buf_gen-attr.p-key      =  "parts"                + chr(3) +
     8787    out_parts.obj-type           + chr(3) +
     8788    string(out_parts.obj-code)   + chr(3) +
     8789    out_parts.artic              + chr(3) +
     8790    out_parts.prod-type          + chr(3) +
     8791    string(out_parts.prod-code)  + chr(3) +
     8792    out_parts.In-code            + chr(3) +
     8793    out_parts.Out-code           + chr(3) +
     8794    out_parts.part-Code          + chr(3) +
     8795    string(out_parts.prt-code)
     8796               buf_gen-attr.attr-code  = "in-part-key"
     8797               buf_gen-attr.attr-value =  "parts"                + chr(3) +
     8798    in_parts.obj-type           + chr(3) +
     8799    string(in_parts.obj-code)   + chr(3) +
     8800    in_parts.artic              + chr(3) +
     8801    in_parts.prod-type          + chr(3) +
     8802    string(in_parts.prod-code)  + chr(3) +
     8803    in_parts.In-code            + chr(3) +
     8804    in_parts.Out-code           + chr(3) +
     8805    in_parts.part-Code          + chr(3) +
     8806    string(in_parts.prt-code)
     8807             .
     8808           end .
     8809         end .
     8810       end .
     8811     end.
     8812   END.
     8813   ON CHOOSE OF b-history IN FRAME d-out-prt
     8814   DO:
     8815     define variable v-list as character no-undo.
     8816     run str/docclins.w (
     8817         input        parparentproc,
     8818         input        '':U,
     8819         input        'one':U,
     8820         input        ub.doc-line.obj-type,
     8821         input        ub.doc-line.obj-code,
     8822         input        ub.gds-dtl.doc-code,
     8823         input        ub.gds-dtl.artic,
     8824         input        ub.gds-dtl.prod-type ,
     8825         input        ub.gds-dtl.prod-code ,
     8826         input-output v-list
     8827         ).
     8828   END.
     8829   ON CHOOSE OF b-place IN FRAME d-out-prt
     8830   DO:
     8831   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8832   if lookup(self :type
     8833            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     8834            ) = 0
     8835   then do:
     8836     message
     8837       "$Workfile$"
     8838       "Указанному интерфейсному элементу фокус не может быть передан" skip
     8839       "Интерфейсный элемент" self :name  skip
     8840       "Тип" self :type  skip
     8841       "Процедура" this-procedure :file-name skip
     8842       view-as alert-box .
     8843   end.
     8844   else do:
     8845     apply "entry":u to self  .
     8846     if focus :handle <> self :handle  then do:
     8847       return no-apply .
     8848     end.
     8849   end.
     8850     if v-place-rsrv <> true
     8851       or b-place :sensitive in frame d-out-prt <> true
     8852     then do:
     8853       return .
     8854     end.
     8855     run edit-doc-pl in this-procedure
     8856       ( input (if t-doc.ext-doc-type = 'iv':U then t-doc.ext-doc-type else if prt-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U )
     8857       ).
     8858   END.
     8859   ON CHOOSE OF b-quit IN FRAME d-out-prt
     8860   DO:
     8861     if prt-mode <> 'ПРОСМОТР':U then do:
     8862       if add-def-mode = yes then do:
     8863         delete ub.gds-dtl.
     8864         assign
     8865           prt-rec = ?
     8866         .
     8867       end.
     8868       else do:
     8869         if decimal(trim(ub.gds-dtl.doc-qnty:screen-value   )) <> decimal(trim(string (ub.gds-dtl.doc-qnty    ,ub.gds-dtl.doc-qnty:format ) )  )
     8870           or decimal(trim(ub.gds-dtl.fact-qnty:screen-value  )) <> decimal(trim(string (ub.gds-dtl.fact-qnty   ,ub.gds-dtl.fact-qnty:format ))  )
     8871           or decimal(trim(ub.gds-dtl.price-base:screen-value )) <> decimal(trim(string (ub.gds-dtl.price-base  ,ub.gds-dtl.price-base:format )) )
     8872           or decimal(trim(ub.gds-dtl.price-rubl:screen-value )) <> decimal(trim(string (ub.gds-dtl.price-rubl  ,ub.gds-dtl.price-rubl:format )) )
     8873           or decimal(trim(ub.gds-dtl.discnt-base:screen-value)) <> decimal(trim(string (ub.gds-dtl.discnt-base ,ub.gds-dtl.discnt-base:format) ))
     8874           or decimal(trim(ub.doc-line.temperature:screen-value)) <> decimal(trim(string ( ub.doc-line.temperature , ub.doc-line.temperature:format )))
     8875           or decimal(trim(ub.doc-line.doc-density    :screen-value)) <> decimal(trim(string ( ub.doc-line.doc-density     , ub.doc-line.doc-density    :format )))
     8876           or decimal(trim(ub.gds-dtl.discnt-rubl:screen-value)) <> decimal(trim(string (ub.gds-dtl.discnt-rubl ,ub.gds-dtl.discnt-rubl:format )))
     8877         then do:
     8878           message
     8879             "Сделанные изменения будут отменены." skip
     8880             "Вы действительно хотите выйти без сохранения?"
     8881             view-as alert-box question buttons yes-no update g#log .
     8882           if g#log = false  then do:
     8883             return no-apply .
     8884           end.
     8885         end.
     8886       end.
     8887       assign
     8888         v-undo-all = true
     8889       .
     8890     end.
     8891   END.
     8892   ON LEAVE OF gds-dtl.discnt-base IN FRAME d-out-prt
     8893   DO:
     8894       assign
     8895       ub.gds-dtl.discnt-base
     8896     .
     8897   END.
     8898   ON LEAVE OF gds-dtl.discnt-pc IN FRAME d-out-prt
     8899   DO:
     8900       assign
     8901       ub.gds-dtl.discnt-pc
     8902     .
     8903   END.
     8904   ON LEAVE OF gds-dtl.discnt-rubl IN FRAME d-out-prt
     8905   DO:
     8906       assign
     8907       ub.gds-dtl.discnt-rubl
     8908     .
     8909   END.
     8910   ON VALUE-CHANGED OF gds-dtl.discnt-type IN FRAME d-out-prt
     8911   DO:
     8912       assign
     8913       ub.gds-dtl.discnt-type
     8914     .
     8915     if ub.gds-dtl.discnt-type  then do:
     8916       enable  ub.gds-dtl.discnt-pc                          with frame d-out-prt.
     8917       disable ub.gds-dtl.discnt-base ub.gds-dtl.discnt-rubl with frame d-out-prt.
     8918     end.
     8919     else do:
     8920       enable  ub.gds-dtl.discnt-rubl when     t-doc.print-rubl
     8921               ub.gds-dtl.discnt-base when not t-doc.print-rubl
     8922                                      with frame d-out-prt.
     8923       disable ub.gds-dtl.discnt-pc   with frame d-out-prt.
     8924     end.
     8925   END.
     8926   ON VALUE-CHANGED OF c-reason IN FRAME d-out-prt
     8927   DO:
     8928       assign
     8929       c-reason
     8930     .
     8931   END.
     8932   ON LEAVE OF doc-line.doc-density IN FRAME d-out-prt
     8933   DO:
     8934     define buffer buf_doc-pl for ub.doc-pl .
     8935     if input frame d-out-prt ub.doc-line.doc-density <> ub.doc-line.doc-density then do:
     8936       assign
     8937         ub.doc-line.doc-density
     8938       .
     8939       if is-petrolium = yes
     8940         and is-pieces = no
     8941       then do:
     8942         if
     8943     valid-density( ub.doc-line.doc-density, buf_goods.unit-base = buf_goods.unit-cli )
     8944     <> yes
     8945         then do:
     8946           message
     8947             "Неверное значение плотности."
     8948             view-as alert-box.
     8949           apply "ENTRY":U to ub.doc-line.doc-density in frame d-out-prt.
     8950           return no-apply.
     8951         end.
     8952         if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     8953           if ((ub.doc-line.doc-density) < v-min-dens or (ub.doc-line.doc-density) > v-max-dens)
     8954           then do:
     8955             message
     8956               "Плотность не входит в диапазон."
     8957               view-as alert-box.
     8958             apply "ENTRY":U to ub.doc-line.doc-density in frame d-out-prt.
     8959             return no-apply.
     8960           end.
     8961         end.
     8962         assign
     8963           ub.doc-line.cli-base-rate = 1.00 / ub.doc-line.doc-density
     8964           ub.doc-line.fact-density  = ub.doc-line.doc-density
     8965         .
     8966         if v-price-rubl-kg :sensitive in frame d-out-prt = true
     8967           and v-price-rubl-kg <> 0.0
     8968           and v-price-rubl-kg <> ?
     8969         then do:
     8970           assign
     8971             ub.gds-dtl.price-rubl = v-price-rubl-kg * ub.doc-line.doc-density
     8972             ub.gds-dtl.price-base = v-price-base-kg * ub.doc-line.doc-density
     8973           .
     8974           display
     8975             ub.gds-dtl.price-rubl
     8976             ub.gds-dtl.price-base
     8977             with frame d-out-prt.
     8978         end.
     8979         else do:
     8980           assign
     8981             v-price-rubl-kg = ub.gds-dtl.price-rubl / ub.doc-line.doc-density
     8982             v-price-base-kg = ub.gds-dtl.price-base / ub.doc-line.doc-density
     8983           .
     8984           display
     8985             v-price-rubl-kg
     8986             v-price-base-kg
     8987             with frame d-out-prt.
     8988         end.
     8989         if v-qnty-kg :sensitive in frame d-out-prt = true then do:
     8990           display
     8991             input frame d-out-prt v-qnty-kg / ub.doc-line.doc-density @ ub.gds-dtl.doc-qnty
     8992             with frame d-out-prt.
     8993         end.
     8994         else do:
     8995           display
     8996             input frame d-out-prt ub.gds-dtl.doc-qnty * ub.doc-line.doc-density @ v-qnty-kg
     8997             with frame d-out-prt.
     8998         end.
     8999         if v-place-rsrv = true
     9000           and not ( last-event :event-type   = "progress":u
     9001                     and last-event :widget-enter = b-place :handle
     9002                   )
     9003         then do:
     9004           find first tt-doc-pl
     9005             no-error .
     9006           if available tt-doc-pl then do:
     9007             run edit-doc-pl in this-procedure
     9008               ( input 'АВТОИЗМЕНЕНИЕ':U + chr(4) + "update-dens":U
     9009               ).
     9010           end.
     9011           else do:
     9012             run edit-doc-pl in this-procedure
     9013               ( input 'АВТОИЗМЕНЕНИЕ':U
     9014               ).
     9015           end.
     9016         end.
     9017       end.
     9018     end.
     9019   END.
     9020   ON RETURN OF doc-line.doc-density IN FRAME d-out-prt
     9021   DO:
     9022     if t-doc.doc-type = 'возврат':U then do:
     9023       if v-price-rubl-kg :sensitive then do:
     9024         apply "ENTRY":U to v-price-rubl-kg in frame d-out-prt.
     9025         return no-apply.
     9026       end.
     9027       else do:
     9028         if v-price-base-kg :sensitive then do:
     9029           apply "ENTRY":U to v-price-base-kg in frame d-out-prt.
     9030           return no-apply.
     9031         end.
     9032         else do:
     9033           if ub.gds-dtl.price-rubl :sensitive then do:
     9034             apply "ENTRY":U to ub.gds-dtl.price-rubl in frame d-out-prt.
     9035             return no-apply.
     9036           end.
     9037           else do:
     9038             if ub.gds-dtl.price-base :sensitive then do:
     9039               apply "ENTRY":U to ub.gds-dtl.price-base in frame d-out-prt.
     9040               return no-apply.
     9041             end.
     9042           end.
     9043         end.
     9044       end.
     9045     end.
     9046     else do:
     9047       if v-price-rubl-kg :sensitive
     9048         and ( (input frame d-out-prt v-price-rubl-kg ) = ?
     9049               or (input frame d-out-prt v-price-rubl-kg ) = 0.0
     9050             )
     9051       then do:
     9052         apply "ENTRY":U to v-price-rubl-kg in frame d-out-prt.
     9053         return no-apply.
     9054       end.
     9055       else do:
     9056         if v-price-base-kg :sensitive
     9057           and ( (input frame d-out-prt v-price-base-kg ) = ?
     9058                 or (input frame d-out-prt v-price-base-kg ) = 0.0
     9059               )
     9060         then do:
     9061           apply "ENTRY":U to v-price-base-kg in frame d-out-prt.
     9062           return no-apply.
     9063         end.
     9064         else do:
     9065           if ub.gds-dtl.price-rubl :sensitive
     9066             and (input frame d-out-prt ub.gds-dtl.price-rubl ) = ?
     9067           then do:
     9068             apply "ENTRY":U to ub.gds-dtl.price-rubl in frame d-out-prt.
     9069             return no-apply.
     9070           end.
     9071           else do:
     9072             if ub.gds-dtl.price-base :sensitive
     9073               and (input frame d-out-prt ub.gds-dtl.price-base ) = ?
     9074             then do:
     9075               apply "ENTRY":U to ub.gds-dtl.price-base in frame d-out-prt.
     9076               return no-apply.
     9077             end.
     9078             else do:
     9079               apply "leave":U to doc-line.doc-density in frame d-out-prt.
     9080               apply "CHOOSE":U to b-exit in frame d-out-prt.
     9081             end.
     9082           end.
     9083         end.
     9084       end.
     9085     end.
     9086   END.
     9087   ON ENTRY OF gds-dtl.doc-qnty IN FRAME d-out-prt
     9088   DO:
     9089     assign
     9090       v-old-doc-qnty = input frame d-out-prt ub.gds-dtl.doc-qnty
     9091     .
     9092   END.
     9093   ON LEAVE OF gds-dtl.doc-qnty IN FRAME d-out-prt
     9094   DO:
     9095     run l-doc-qnty in this-procedure no-error .
     9096     if error-status :error then return no-apply.
     9097   END.
     9098   ON return OF gds-dtl.doc-qnty IN FRAME d-out-prt
     9099   DO:
     9100     if t-doc.doc-type = 'возврат':U then do:
     9101       if ub.gds-dtl.price-rubl :sensitive then do:
     9102         apply "ENTRY":U to ub.gds-dtl.price-rubl in frame d-out-prt.
     9103         return no-apply.
     9104       end.
     9105       else if ub.gds-dtl.price-base :sensitive then do:
     9106         apply "ENTRY":U to ub.gds-dtl.price-base in frame d-out-prt.
     9107         return no-apply.
     9108       end.
     9109     end.
     9110     else do:
     9111       if ub.doc-line.doc-density:sensitive then do:
     9112         apply "entry" to ub.doc-line.doc-density in frame d-out-prt.
     9113         return no-apply.
     9114       end.
     9115       else do:
     9116         if ub.gds-dtl.price-rubl :sensitive
     9117           and (input frame d-out-prt ub.gds-dtl.price-rubl ) = ?
     9118         then do:
     9119           apply "ENTRY":U to ub.gds-dtl.price-rubl in frame d-out-prt.
     9120           return no-apply.
     9121         end.
     9122         else do:
     9123           if ub.gds-dtl.price-base :sensitive
     9124             and (input frame d-out-prt ub.gds-dtl.price-base ) = ?
     9125           then do:
