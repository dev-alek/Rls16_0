     2767       define variable v-prt-autoent-obj-type as character    no-undo .
     2768       define variable v-prt-autoent-obj-code as character    no-undo .
     2769       define variable v-prt-item-pour        as character    no-undo .
     2770       define variable v-prt-time-pour        as character    no-undo .
     2771       define variable v-prt-tank-vol         as character    no-undo .
     2772       define variable v-prt-tank-temp        as character    no-undo .
     2773       define variable v-prt-tank-water       as character    no-undo .
     2774       define variable v-prt-tank-density     as character    no-undo .
     2775       define variable v-prt-tank-weight      as character    no-undo .
     2776       define variable v-prt-time-income      as character    no-undo .
     2777       define variable v-prt-start-real-date  like ub.rvs-line.real-date    no-undo .
     2778       define variable v-prt-start-real-time  like ub.rvs-line.real-time    no-undo .
     2779       define variable v-prt-end-real-date    like ub.rvs-line.real-date    no-undo .
     2780       define variable v-prt-end-real-time    like ub.rvs-line.real-time    no-undo .
     2781       define variable v-prt-mouth            as character    no-undo .
     2782       define variable v-prt-fio              as character    no-undo .
     2783       define variable v-prt-ptbotype         as character    no-undo .
     2784       define variable v-prt-ptbocode         as character    no-undo .
     2785       define variable v-prt-a-b-tarir        as character    no-undo .
     2786       define variable v-diameter             as character    no-undo .
     2787       define variable v-place-si             as character    no-undo .
     2788       define variable v-tank-density-pomi    as character    no-undo .
     2789       define variable v-prt-certif-fuel      as character    no-undo .
     2790       define variable v-prt-norm-doc         as character    no-undo .
     2791       define variable v-prt-num-passport     as character    no-undo .
     2792       define variable v-prt-validity-certif  as character    no-undo .
     2793       define variable v-prt-passport-plotn   as character    no-undo .
     2794       define variable v-prt-num-plotn        as character    no-undo .
     2795       define variable v-prt-date-pov-plotn   as date    no-undo .
     2796       define variable was_setting            as logical      no-undo initial no .
     2797       define variable ptoldfilvalue          as character    no-undo.
     2798       define variable ptoldfiltype           as character    no-undo.
     2799       define variable stfactplvalue          as character    no-undo initial ? .
     2800       define variable stfactpltype           as character    no-undo initial ? .
     2801       define variable olddensvalue           as character    no-undo initial ? .
     2802       define variable olddenstype            as character    no-undo initial ? .
     2803       define variable varupd-fact-qnty       as logical      no-undo initial yes .
     2804       define variable varrevision            as logical      no-undo initial no  .
     2805       define variable varpercrev             as decimal      no-undo initial ?   .
     2806       define variable varauto-tank           as logical      no-undo initial no  .
     2807       define variable varpercauto            as decimal      no-undo initial ?   .
     2808       define variable varinv                 as logical      no-undo initial no  .
     2809       define variable varpercinv             as decimal      no-undo initial ?   .
     2810       define variable varinv-set             as logical      no-undo initial no  .
     2811       define variable is-vir as logical no-undo.
     2812       define variable v-value as character no-undo.
     2813       define variable v-ok as logical no-undo.
     2814       procedure return-rvs-qnty :
     2815         define  input parameter p-doc-code            like ub.trn-doc.doc-code            no-undo .
     2816         define  input parameter p-gds-code            like ub.goods.gds-code              no-undo .
     2817         define  input parameter p-pl-code             like ub.rvs-line.pl-code            no-undo .
     2818         define output parameter p-rvs-qnty-before     like ub.rvs-line.state-measure-qnty no-undo .
     2819         define output parameter p-rvs-qnty-after      like ub.rvs-line.state-measure-qnty no-undo .
     2820         define output parameter p-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     2821         define output parameter p-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     2822         define buffer bf_bef_rvs-doc  for ub.rvs-doc  .
     2823         define buffer bf_aft_rvs-doc  for ub.rvs-doc  .
     2824         define buffer bf_bef_rvs-line for ub.rvs-line .
     2825         define buffer bf_aft_rvs-line for ub.rvs-line .
     2826         assign
     2827           p-rvs-qnty-before     = 0.0
     2828           p-rvs-qnty-after      = 0.0
     2829           p-rvs-cli-qnty-before = 0.0
     2830           p-rvs-cli-qnty-after  = 0.0
     2831         .
     2832         find first bf_bef_rvs-doc no-lock
     2833           where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     2834             and bf_bef_rvs-doc.out-code = p-doc-code
     2835           no-error .
     2836         if available bf_bef_rvs-doc then do:
     2837           for each bf_bef_rvs-line no-lock
     2838             where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     2839               and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     2840               and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     2841               and bf_bef_rvs-line.gds-code = p-gds-code
     2842           :
     2843             if p-pl-code <> ?
     2844               and p-pl-code <> bf_bef_rvs-line.pl-code
     2845             then do:
     2846               next .
     2847             end.
     2848             assign
     2849               p-rvs-qnty-before     = p-rvs-qnty-before     + bf_bef_rvs-line.state-measure-qnty
     2850               p-rvs-cli-qnty-before = p-rvs-cli-qnty-before + bf_bef_rvs-line.state-measure-cli-qnty
     2851             .
     2852           end.
     2853         end.
     2854         find first bf_aft_rvs-doc no-lock
     2855           where bf_aft_rvs-doc.rvs-type = 'после_док':U
     2856             and bf_aft_rvs-doc.out-code = p-doc-code
     2857           no-error .
     2858         if available bf_aft_rvs-doc then do:
     2859           for each bf_aft_rvs-line no-lock
     2860             where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     2861               and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     2862               and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     2863               and bf_aft_rvs-line.gds-code = p-gds-code
     2864           :
     2865             if p-pl-code <> ?
     2866               and p-pl-code <> bf_aft_rvs-line.pl-code
     2867             then do:
     2868               next .
     2869             end.
     2870             assign
     2871               p-rvs-qnty-after     = p-rvs-qnty-after     + bf_aft_rvs-line.state-measure-qnty
     2872               p-rvs-cli-qnty-after = p-rvs-cli-qnty-after + bf_aft_rvs-line.state-measure-cli-qnty
     2873             .
     2874           end.
     2875         end.
     2876       end procedure.
     2877       procedure check-before :
     2878         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     2879         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     2880         define input  parameter p-pl-code  like ub.doc-pl.pl-code   no-undo .
     2881         define buffer buf_goods         for ub.goods .
     2882         define buffer bf_after_rvs-doc  for ub.rvs-doc  .
     2883         define buffer bf_after_rvs-line for ub.rvs-line .
     2884         do
     2885         on error undo, return error substitute( "&1 (check-before). &2&3&4", vss-include-info20, return-value, chr(10), error-status :get-message ( 1 ) )
     2886         :
     2887           find first buf_goods no-lock
     2888             where buf_goods.gds-code = p-gds-code
     2889             .
     2890           find first bf_after_rvs-doc no-lock
     2891             where bf_after_rvs-doc.rvs-type = 'после_док':U
     2892               and bf_after_rvs-doc.out-code = p-doc-code
     2893             no-error .
     2894           if available bf_after_rvs-doc then do:
     2895             for each tt-doc-pl no-lock
     2896             :
     2897               if p-pl-code <> ?
     2898                 and tt-doc-pl.pl-code <> p-pl-code
     2899               then do:
     2900                 next.
     2901               end.
     2902               find first bf_after_rvs-line no-lock
     2903                 where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     2904                   and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     2905                   and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     2906                   and bf_after_rvs-line.pl-code  = tt-doc-pl.pl-code
     2907                   and bf_after_rvs-line.gds-code = p-gds-code
     2908                 no-error .
     2909               if not available bf_after_rvs-line then do:
     2910                 message
     2911                   "По данному товару нет заготовки для сверки <<после налива топлива>>"
     2912                   "по резервуару" tt-doc-pl.pl-code "."
     2913                   view-as alert-box error .
     2914                 return error .
     2915               end.
     2916               if bf_after_rvs-line.state-measure-qnty <> ? then do:
     2917                 message
     2918                   "Уже задан фактический остаток в сверке <<после налива топлива>>"
     2919                   "по резервуару" tt-doc-pl.pl-code "."
     2920                   "Следует удалить сверки и создать их снова."
     2921                   view-as alert-box error .
     2922                 return error .
     2923               end.
     2924               if ptrlprop-olddens <> true
     2925                 and bf_after_rvs-line.state-density <> ?
     2926                 and buf_goods.unit-base <> buf_goods.unit-cli
     2927               then do:
     2928                 message
     2929                   "Уже задана фактическая плотность в сверке <<после налива топлива>>"
     2930                   "по резервуару" tt-doc-pl.pl-code "."
     2931                   "Следует удалить сверки и создать их снова."
     2932                   view-as alert-box error .
     2933                 return error .
     2934               end.
     2935             end.
     2936           end.
     2937           else do:
     2938             message "Не создана сверка <<после налива топлива>>." view-as alert-box error .
     2939             return error .
     2940           end.
     2941         end.
     2942       end procedure.
     2943       procedure check-after :
     2944         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     2945         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     2946         define input  parameter p-pl-code  like ub.doc-pl.pl-code   no-undo .
     2947         define buffer buf_before_rvs-doc  for ub.rvs-doc  .
     2948         define buffer buf_before_rvs-line for ub.rvs-line .
     2949         do
     2950         on error undo, return error return-value
     2951         :
     2952           find first buf_before_rvs-doc no-lock
     2953             where buf_before_rvs-doc.rvs-type = 'перед_док':U
     2954               and buf_before_rvs-doc.out-code = p-doc-code
     2955             no-error .
     2956           if available buf_before_rvs-doc then do:
     2957             for each tt-doc-pl no-lock
     2958             on error undo, return error return-value
     2959             :
     2960               if p-pl-code <> ?
     2961                 and tt-doc-pl.pl-code <> p-pl-code
     2962               then do:
     2963                 next.
     2964               end.
     2965               find first buf_before_rvs-line no-lock
     2966                 where buf_before_rvs-line.rvs-code = buf_before_rvs-doc.rvs-code
     2967                   and buf_before_rvs-line.obj-type = buf_before_rvs-doc.obj-type
     2968                   and buf_before_rvs-line.obj-code = buf_before_rvs-doc.obj-code
     2969                   and buf_before_rvs-line.pl-code  = tt-doc-pl.pl-code
     2970                   and buf_before_rvs-line.gds-code = p-gds-code
     2971                 no-error .
     2972               if not available buf_before_rvs-line then do:
     2973                 message
     2974                   "По данному товару нет заготовки для сверки <<до налива топлива>>"
     2975                   "по резервуару" tt-doc-pl.pl-code "."
     2976                   view-as alert-box error .
     2977                 return error .
     2978               end.
     2979               if is-gas(buf_before_rvs-line.gds-code) then next.
     2980               run placelib_get-attr(input "place-virtual"
     2981                                    ,input tt-doc-pl.obj-code
     2982                                    ,input tt-doc-pl.obj-type
     2983                                    ,input tt-doc-pl.pl-code
     2984                                    ,output v-value
     2985                                    ,output v-ok) no-error.
     2986               is-vir = if (v-ok and logical(v-value)) then true else false.
     2987               if is-vir then next.
     2988               if buf_before_rvs-line.state-measure-qnty = ?
     2989               then do:
     2990                 message
     2991                   "Не задан фактический остаток в сверке <<до налива топлива>>"
     2992                   "по резервуару" tt-doc-pl.pl-code "." skip
     2993                   "Следует удалить сверки и создать их снова."
     2994                   view-as alert-box error .
     2995                 return error .
     2996               end.
     2997               if buf_before_rvs-line.state-density = ?
     2998               then do:
     2999                 message
     3000                   "Не задана фактическая плотность в сверке <<до налива топлива>>"
     3001                   "по резервуару" tt-doc-pl.pl-code "." skip
     3002                   "Следует удалить сверки и создать их снова."
     3003                   view-as alert-box error .
     3004                 return error .
     3005               end.
     3006             end.
     3007           end.
     3008           else do:
     3009             message "Не создана сверка <<до налива топлива>>." view-as alert-box error .
     3010             return error .
     3011           end.
     3012         end.
     3013       end procedure.
     3014       procedure action-rvs-line :
     3015         define input parameter p-action      as   character           no-undo .
     3016         define input parameter p-action-type as   character           no-undo .
     3017         define input parameter p-rvs-type    like ub.rvs-doc.rvs-type no-undo .
     3018         block_tr:
     3019         do transaction
     3020         on error  undo block_tr, return error substitute( "&1 (action-rvs-line). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3021         on stop   undo block_tr, return error substitute( "&1 (action-rvs-line). stop", vss-workfile )
     3022         on endkey undo block_tr, return error substitute( "&1 (action-rvs-line). endkey", vss-workfile )
     3023         :
     3024           define variable v-pl-code      like ub.place.pl-code    no-undo .
     3025           define variable v-rvs-code     like ub.rvs-doc.rvs-code no-undo .
     3026           define variable v-act-name     as   character           no-undo .
     3027           define variable v-log          as   logical             no-undo .
     3028           define variable v-count-doc-pl as   integer             no-undo .
     3029           define variable is-rvs-place   as   logical             no-undo .
     3030           define variable varnum         as   integer             no-undo.
     3031           define variable varcur-rvs     as   integer             no-undo.
     3032           define variable v-today        as   date                no-undo.
     3033           define variable v-time         as   integer             no-undo.
     3034           define buffer buf_rvs-doc     for ub.rvs-doc .
     3035           define buffer buf_rvs-line    for ub.rvs-line .
     3036           define buffer buf_place       for ub.place .
     3037           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     3038           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     3039           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     3040           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     3041           define variable v-rvs-density         like ub.rvs-line.state-density          no-undo .
     3042           define variable v-asi-ip  as character no-undo .
     3043           define variable v-asi-port as character no-undo .
     3044           define variable v-asi-type as character no-undo .
     3045           define variable v-attr-type as character no-undo .
     3046           assign
     3047             v-pl-code = ?
     3048           .
     3049           find first buf_rvs-doc exclusive-lock
     3050             where buf_rvs-doc.rvs-type = p-rvs-type
