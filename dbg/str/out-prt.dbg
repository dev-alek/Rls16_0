     9502   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9503   on help of frame d-out-prt
     9504   do:
     9505     run gbl/app_help.p
     9506       (input this-procedure :file-name
     9507       ,input ''
     9508       ,input ?
     9509       ) no-error.
     9510     if error-status :error then do:
     9511       message
     9512         "Ошибка при вызове помощи"
     9513         error-status :get-message(1)
     9514         view-as alert-box .
     9515     end.
     9516   end.
     9517   run minbtn-set in this-procedure .
     9518   on choose of b-help in frame d-out-prt
     9519   do:
     9520     apply "help":u to frame d-out-prt .
     9521   end.
     9522   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9523   procedure minbtn-set :
     9524       do
     9525           on error undo, return error return-value
     9526           :
     9527           define variable ii              as integer       no-undo .
     9528           define variable fh              as widget-handle no-undo .
     9529           define variable hh              as widget-handle no-undo .
     9530           define variable v-h             as handle        extent 4 no-undo .
     9531           define variable v-name-button   as character     no-undo .
     9532           define variable v-help-old-x    as decimal       no-undo .
     9533           define variable v-help-old-y    as decimal       no-undo .
     9534           define variable v-help-old-size as decimal       no-undo .
     9535           define variable v-frame-width   as decimal       no-undo .
     9536           define variable jj              as integer       no-undo .
     9537           do
     9538               on error undo, return error
     9539               :
     9540               assign
     9541                   v-frame-width = frame d-out-prt:width - 0.3
     9542                   fh            = frame d-out-prt:first-child
     9543                   hh            = fh:first-child
     9544                   ii            = 1
     9545                   .
     9546               do while valid-handle(hh):
     9547                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     9548                   do:
     9549                       case lc(hh:name) :
     9550                           when "b-help" then
     9551                               do:
     9552                                   hh:load-image-up("cmp/b-help.bmp":u) .
     9553                                   hh:load-image-down("cmp/b-help.bmp":u) .
     9554                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     9555                                   hh:TOOLTIP = "Помощь" .
     9556                                   v-help-old-x = hh:column .
     9557                                   v-help-old-y = hh:row    .
     9558                                   v-help-old-size = hh:width .
     9559                                   hh:width-chars = 2.5 .
     9560                               end.
     9561                           when "b-print" then
     9562                               do:
     9563                                   hh:load-image("cmp/b-print.bmp":u) .
     9564                                   hh:TOOLTIP = "Печать" .
     9565                                   v-h[ii] = hh:handle .
     9566                                   ii = ii + 1 .
     9567                                   hh:width-chars = 3 .
     9568                               end.
     9569                           when "b-history" or
     9570                           when "b-hist" then
     9571                               do:
     9572                                   hh:load-image("cmp/b-hist.bmp":u) .
     9573                                   hh:TOOLTIP = "История" .
     9574                                   v-h[ii] = hh:handle .
     9575                                   ii = ii + 1 .
     9576                                   hh:width-chars = 3 .
     9577                               end.
     9578                           when "b-sch" then
     9579                               do:
     9580                                   hh:load-image("cmp/b-sch.bmp":u) .
     9581                                   hh:TOOLTIP = "Установка Фильтра" .
     9582                                   v-h[ii] = hh:handle .
     9583                                   ii = ii + 1 .
     9584                                   hh:width-chars = 3 .
     9585                               end.
     9586                           when "b-hist-user" then
     9587                               do:
     9588                                   hh:load-image("cmp/b-hist.bmp":u) .
     9589                                   hh:TOOLTIP = "История пользователя" .
     9590                                   ii = ii + 1 .
     9591                               end.
     9592                       end case.
     9593                   end.
     9594                   hh = hh:next-sibling.
     9595               end.
     9596               b-help:column = v-frame-width - b-help:width-chars.
     9597               jj = 0.
     9598               repeat ii = 4 to 1 by -1 :
     9599                   if valid-handle (v-h[ii] ) then
     9600                   do:
     9601                       jj  = jj + 1 .
     9602                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     9603                       v-h[ii]:row    = v-help-old-y .
     9604                   end.
     9605               end.
     9606           end.
     9607       end.
     9608   end procedure.
