    11725                   then
    11726                   enable
    11727                     ub.gds-dtl.price-base
    11728                     with frame d-out-prt
    11729                   .
    11730                 end.
    11731               end.
    11732             end.
    11733           end.
    11734           else do:
    11735             hide
    11736               ub.prt-obj.free-qnty  in frame d-out-prt
    11737               ub.price-list.doc-num in frame d-out-prt
    11738             .
    11739             if t-doc.ext-doc-type <> 'rv':U then do:
    11740               if is-petrolium = yes
    11741                 and is-pieces = no
    11742                 and ptrlprop-expptrl = 'weight':U
    11743                 and buf_goods.unit-base <> buf_goods.unit-cli
    11744               then do:
    11745                 enable
    11746                   v-fact-qnty-kg
    11747                   with frame d-out-prt.
    11748               end.
    11749               else do:
    11750                 enable
    11751                   ub.gds-dtl.fact-qnty
    11752                   with frame d-out-prt.
    11753               end.
    11754             end.
    11755           end.
    11756         end.
    11757         if ub.gds-dtl.ov = yes then do: hide ub.price-list.doc-num in frame d-out-prt. end.
    11758         if prt-mode = 'ПРОСМОТР':U then do: hide ub.prt-obj.free-qnty ub.price-list.doc-num in frame d-out-prt. end.
    11759         if t-doc.discnt-type = 'строка':U then do:
    11760           display ub.gds-dtl.discnt-type with frame d-out-prt.
    11761         end.
    11762         else do:
    11763           hide ub.gds-dtl.discnt-type in frame d-out-prt.
    11764         end.
    11765         if ub.gds-dtl.ov and t-doc.status_ <> 'факт':U then do:
    11766           assign
    11767             ub.price-list.doc-num :fgcolor = 4
    11768           .
    11769           display "Не цена объекта" @ ub.price-list.doc-num with frame d-out-prt.
    11770         end.
    11771         display ub.gds-dtl.discnt-base ub.gds-dtl.discnt-rubl ub.gds-dtl.discnt-pc with frame d-out-prt.
    11772         if t-doc.internal then do:
    11773           hide ub.gds-dtl.discnt-base ub.gds-dtl.discnt-rubl ub.gds-dtl.discnt-pc
    11774                   ub.gds-dtl.discnt-type in frame d-out-prt.
    11775         end.
    11776       end.
    11777       when 'при':U then do:
    11778         if prt-mode = 'БЕЗ_ПРИЗНАКОВ':U or prt-mode = 'ШКАЛА':U then do:
    11779           if v-work-with-qnty = "doc":U then do:
    11780             if ptrlprop-expptrl = 'weight':U
    11781               and buf_goods.unit-base <> buf_goods.unit-cli
    11782             then do:
    11783               enable
    11784                 v-qnty-kg
    11785               with frame d-out-prt.
    11786               if t-doc.status_ = 'запрос':U and t-doc.internal then do:
    11787                 if t-doc.print-rubl = yes then do:
    11788                   enable
    11789                     v-price-rubl-kg
    11790                   with frame d-out-prt.
    11791                 end.
    11792                 else do:
    11793                   enable
    11794                     v-price-base-kg
    11795                   with frame d-out-prt.
    11796                 end.
    11797               end.
    11798             end.
    11799             else do:
    11800               enable
    11801                 ub.gds-dtl.doc-qnty
    11802               with frame d-out-prt.
    11803               if t-doc.status_ = 'запрос':U and t-doc.internal then do:
    11804                 if t-doc.print-rubl = yes then do:
    11805                   enable
    11806                     ub.gds-dtl.price-rubl
    11807                   with frame d-out-prt.
    11808                 end.
    11809                 else do:
    11810                   enable
    11811                     ub.gds-dtl.price-base
    11812                   with frame d-out-prt.
    11813                 end.
    11814               end.
    11815             end.
    11816           end.
    11817           else do:
    11818             if varupd-fact-qnty = true then do:
    11819               if ptrlprop-expptrl = 'weight':U
    11820                 and buf_goods.unit-base <> buf_goods.unit-cli
    11821               then do:
    11822                 enable
    11823                   v-fact-qnty-kg
    11824                   with frame d-out-prt.
    11825               end.
    11826               else do:
    11827                 enable
    11828                   ub.gds-dtl.fact-qnty
    11829                   with frame d-out-prt.
    11830               end.
    11831             end.
    11832           end.
    11833         end.
    11834         hide ub.prt-obj.free-qnty ub.price-list.doc-num ub.gds-dtl.discnt-base ub.gds-dtl.discnt-rubl
    11835              ub.gds-dtl.discnt-pc ub.gds-dtl.discnt-type in frame d-out-prt.
    11836       end.
    11837     end case.
    11838   END PROCEDURE.
    11839   PROCEDURE re-calcpr :
    11840   if pr-naklvalue = yes and pr-genmrg = 'before-margin':U and prt-mode <> 'ПРОСМОТР':U then do:
    11841   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11842   run find-new-price-sale in this-procedure (
    11843      input  pr-genmrg
