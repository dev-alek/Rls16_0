    11858   PROCEDURE read-doc-line-attr :
    11859   define input parameter p-doc-code       as character        no-undo.
    11860   define input parameter p-gds-code       as integer          no-undo.
    11861   define input parameter p-attr-code      as character        no-undo.
    11862   define output parameter p-attr-value    as character        no-undo.
    11863      define buffer buf_doc-line-attr       for ub.doc-line-attr.
    11864   do
    11865   for buf_doc-line-attr
    11866   on error undo, return error
    11867   :
    11868       find first buf_doc-line-attr no-lock
    11869            where buf_doc-line-attr.doc-code     = p-doc-code
    11870              and buf_doc-line-attr.gds-code     = p-gds-code
    11871              and buf_doc-line-attr.attr-code    = p-attr-code
    11872       no-error.
    11873       if available buf_doc-line-attr
    11874       then do:
    11875           assign
    11876               p-attr-value = buf_doc-line-attr.attr-value
    11877           .
    11878       end.
    11879       else do:
    11880           assign
    11881               p-attr-value = "":U
    11882           .
    11883       end.
    11884   end.
    11885   END PROCEDURE.
    11886   PROCEDURE rsrv-out :
    11887   define variable v-chg-qnty      as decimal   no-undo .
    11888     define variable v-chg-doc-qnty  as decimal   no-undo .
    11889     define variable v-chg-fact-qnty as decimal   no-undo .
