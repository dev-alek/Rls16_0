    11691                 ub.doc-line.temperature
    11692                 ub.doc-line.doc-density
    11693                 with frame d-out-prt.
    11694             end.
    11695             if ( g#log and t-doc.ext-doc-type <> 'ep':U )
    11696               or ( t-doc.ext-doc-type = 'ep':U and t-doc.status_ = 'запрос':U )
    11697             then do:
    11698               if is-petrolium = true
    11699                 and is-pieces = false
    11700                 and ptrlprop-expptrl = 'weight':U
    11701                 and buf_goods.unit-base <> buf_goods.unit-cli
    11702               then do:
