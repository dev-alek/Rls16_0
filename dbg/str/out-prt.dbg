    12581     assign
    12582       tot-rubl = ub.gds-dtl.fact-qnty * ( ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl )
    12583       tot-base = ub.gds-dtl.fact-qnty * ( ub.gds-dtl.price-base - ub.gds-dtl.discnt-base )
    12584     .
