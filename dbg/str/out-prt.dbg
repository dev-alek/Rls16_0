    10626               if buf_marking.box-qnty = 0 then
    10627               do:
    10628                 vGtin     = getGtinByDM(buf_marking.mark) .
    10629                 vGtinQnty = getQntyCodeByGtin(vGtin).
    10630               end.
    10631               if v-isweighed
    10632               then do :
    10633                 v-mark-weight = MarkWeight(buf_marking.mark).
    10634                 if v-mark-weight = 0
    10635                 or v-mark-weight = ?
    10636                 then do :
