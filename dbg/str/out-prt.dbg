     2523   procedure placelib_write-attr:
     2524   define input  parameter p-code     like ub.place-attr.attr-code .
     2525   define input  parameter p-obj-code like ub.place-attr.obj-code .
     2526   define input  parameter p-obj-type like ub.place-attr.obj-type .
     2527   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     2528   define input  parameter p-value    like ub.place-attr.attr-value .
     2529   define output parameter p-ok       as logical.
     2530   define buffer buf_place-attr for ub.place-attr .
     2531     do on error undo, return error return-value :
     2532        p-ok = false.
     2533        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2534                                                   and buf_place-attr.obj-code    = p-obj-code
     2535                                                   and buf_place-attr.obj-type    = p-obj-type
     2536                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2537        if not available buf_place-attr then do :
     2538           create buf_place-attr.
     2539           assign
     2540             buf_place-attr.attr-code   = p-code
     2541             buf_place-attr.attr-value  = p-value
     2542             buf_place-attr.obj-code    = p-obj-code
     2543             buf_place-attr.obj-type    = p-obj-type
     2544             buf_place-attr.pl-code     = p-pl-code
     2545           .
     2546           p-ok = true.
     2547        end.
     2548        else do:
     2549           buf_place-attr.attr-value  = p-value .
     2550           p-ok = true.
     2551        end.
     2552     end.
     2553   end.
     2554   procedure placelib_get-attr:
     2555   define input  parameter  p-code     like ub.place-attr.attr-code .
     2556   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     2557   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     2558   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     2559   define output parameter  p-value    like ub.place-attr.attr-value .
     2560   define output parameter  p-ok       as logical.
     2561   define buffer buf_place-attr for ub.place-attr .
     2562     do on error undo, return error return-value :
     2563        p-ok = false.
     2564        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     2565                                                   and buf_place-attr.obj-code    = p-obj-code
     2566                                                   and buf_place-attr.obj-type    = p-obj-type
     2567                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2568        if available buf_place-attr then do :
     2569          p-value = buf_place-attr.attr-value.
     2570          p-ok = true.
     2571        end.
     2572        else do :
     2573          p-ok = false.
     2574        end.
     2575     end.
     2576   end.
     2577   procedure placelib_del-attr:
     2578   define input parameter  p-code     like ub.place-attr.attr-code .
     2579   define input parameter  p-obj-code like ub.place-attr.obj-code .
     2580   define input parameter  p-obj-type like ub.place-attr.obj-type .
     2581   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     2582   define input parameter  p-value    like ub.place-attr.attr-value .
     2583   define output parameter p-ok       as logical.
     2584   define buffer buf_place-attr for ub.place-attr .
     2585     do on error undo, return error return-value :
     2586        p-ok = false.
     2587        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2588                                                   and buf_place-attr.obj-code    = p-obj-code
     2589                                                   and buf_place-attr.obj-type    = p-obj-type
     2590                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2591        if available buf_place-attr then do :
     2592           delete buf_place-attr.
     2593           p-ok = true.
     2594        end.
     2595     end.
     2596   end.
