     9801   MAIN-BLOCK:
     9802   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     9803      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
     9804     define buffer buf_doc-pl   for ub.doc-pl.
     9805     define buffer buf_currency for ub.currency  .
     9806     define buffer buf_doc-pl-attr for ub.doc-pl-attr .
     9807     define buffer buf_contract    for ub.contract.
     9808     define variable vGtin     as character no-undo.
     9809     define variable vGtinQnty as integer no-undo.
     9810     define variable vExistGdsDtl as logical no-undo init true.
     9811     if num-entries(prt-mode, chr(4)) = 2
     9812     then do :
     9813       if entry(2, prt-mode, chr(4)) begins "return"
     9814       then do :
     9815         v-is-return = true .
     9816         in-part-rec = integer(trim(entry(2, prt-mode, chr(4)), "return=")) no-error .
     9817       end .
     9818       prt-mode = entry(1, prt-mode, chr(4)) .
     9819     end .
     9820     assign
     9821       v-undo-all = false
     9822       TEXT-1 = "РУБ"
     9823     .
     9824     display TEXT-1 with frame d-out-prt .
     9825     find first t-doc no-lock
     9826       where recid(t-doc) = doc-rec
     9827       .
     9828     if v-is-return then
     9829     do:
     9830       for first buf_contract no-lock where
     9831                 buf_contract.host-code     = t-doc.host-code
     9832             and buf_contract.contract-code = t-doc.contract-code
     9833       :
     9834         vBackSale = (buf_contract.spec-check = 23).
     9835       end.
     9836     end.
     9837     find first ub.gds-prt no-lock
     9838       where recid( ub.gds-prt ) = cur-rec
     9839       .
     9840     if prt-mode = 'ШКАЛА':U
     9841       and node-type <> 'терм':U
     9842     then do:
     9843       message
     9844         "В режиме ШКАЛА можно указывать количества только по терминальным признакам."
     9845         view-as alert-box.
     9846       undo main-block, return error.
     9847     end.
     9848   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
