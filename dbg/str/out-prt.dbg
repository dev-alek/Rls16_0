     7748   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     7749   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     7750   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     7751   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     7752   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     7753   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     7754   define variable v-param-types   as character  no-undo.
     7755   define variable v-value-char    as character  no-undo.
     7756   define variable v-val-date      as date       no-undo.
     7757   define variable v-val-decimal   as decimal    no-undo.
     7758   define variable v-val-integer   as integer    no-undo.
     7759   define variable v-val-logical   as logical    no-undo.
     7760   define variable v-tthd          as handle     no-undo.
     7761   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     7762   PROCEDURE imagelist_loaddef:
     7763       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     7764       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     7765       ASSIGN
     7766           vPar-val  = "":U
     7767           vPar-type = "":U
     7768           .
     7769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7770     (input  'photo':u
     7771     ,input  '':u
     7772     ,input  '':u
     7773     ,input  0
     7774     ,input  '':u
     7775     ,input  '':u
     7776     ,input  '':u
     7777     ,input  no
     7778     ,output vPar-val
     7779     ,output vPar-type
     7780     ) no-error .
     7781           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     7782       IF mImagePh THEN .
     7783       ELSE RETURN.
     7784       ASSIGN
     7785           vPar-val  = "":U
     7786           vPar-type = "":U
     7787           .
     7788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7789     (input  'ph-dir':u
     7790     ,input  '':u
     7791     ,input  '':u
     7792     ,input  0
     7793     ,input  '':u
     7794     ,input  '':u
     7795     ,input  '':u
     7796     ,input  NO
     7797     ,output vPar-val
     7798     ,output vPar-type
     7799     ) no-error .
     7800       IF LENGTH (vPar-val) = 0 THEN
     7801           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     7802       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     7803       ASSIGN
     7804           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     7805           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     7806           mImagePreDir = mImagePath
     7807           mImageDir    = mImagePreDir
     7808           mImageTrash  = mImagePath + "trash\":U
     7809           .
     7810       ASSIGN
     7811           vPar-val  = "":U
     7812           vPar-type = "":U
     7813           .
     7814               run adm/shattri.p (
     7815           input "get":U
     7816           ,input  '':U
     7817           ,input  0
     7818           ,input  'gds-ref':U
     7819           ,input  'shema-foto':U
     7820           ,output v-value-char
     7821           ,output v-val-date
     7822           ,output v-val-decimal
     7823           ,output v-val-integer
     7824           ,output v-val-logical
     7825           ,output v-param-types
     7826           ,INPUT-OUTPUT table-handle v-tthd
     7827           ) no-error.
     7828           delete object v-tthd.
     7829           mPhotomgd = IF v-val-integer = 2 then yes else no.
     7830   END PROCEDURE.
     7831   PROCEDURE imagelist_decode:
     7832       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     7833       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     7834       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     7835       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     7836       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     7837       ASSIGN
     7838           oImageList = iImageList
     7839           .
     7840       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     7841           vCh =ENTRY (vInt, iImageList, ",":U).
     7842           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     7843           ELSE
     7844           DO:
     7845               ASSIGN
     7846                   vCh = REPLACE (vCh, "~/":U, "\":U)
     7847                   vCh = REPLACE (vCh, "~\":U, "\":U)
     7848                   .
     7849               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     7850               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     7851               ENTRY (vInt, oImageList, ",":U) = vCh.
     7852           END.
     7853       END.
     7854   END PROCEDURE.
     7855   PROCEDURE imagelist_encode:
     7856       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     7857       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     7858       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     7859       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     7860       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     7861       ASSIGN
     7862           oImageList = iImageList
     7863           vLen       = LENGTH (mImageDir)
     7864           .
     7865       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     7866           vCh =ENTRY (vInt, iImageList, ",":U).
     7867           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     7868               ENTRY (vInt, oImageList, ",":U) =
     7869                   SUBSTRING (vCh, vLen + 1).
     7870       END.
     7871   END PROCEDURE.
