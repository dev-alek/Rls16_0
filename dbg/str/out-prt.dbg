    11657       ,input  t-doc.obj-type
    11658       ,input  t-doc.obj-code
    11659       ,input  0
    11660       ,input  0
    11661       ,input  0
    11662       ,input  false
    11663       ,output g#log
    11664       )  .
    11665   end.
    11666             end.
    11667             else do:
    11668               assign
    11669                 g#log = no
    11670               .
    11671             end.
    11672             if is-petrolium = true
    11673               and is-pieces = false
    11674               and ptrlprop-expptrl = 'weight':U
    11675               and buf_goods.unit-base <> buf_goods.unit-cli
    11676             then do:
