    11510     = yes then do:
    11511           assign
    11512             v-price-rubl-kg = ub.gds-dtl.price-rubl / ub.doc-line.doc-density
    11513             v-price-base-kg = ub.gds-dtl.price-base / ub.doc-line.doc-density
    11514             v-qnty-kg       = ub.gds-dtl.doc-qnty   * ub.doc-line.doc-density
    11515             v-fact-qnty-kg  = ub.gds-dtl.fact-qnty  * ub.doc-line.fact-density
    11516           .
    11517         end.
    11518         else do:
    11519           assign
    11520             v-price-rubl-kg = 0.0
    11521             v-price-base-kg = 0.0
    11522             v-qnty-kg       = 0.0
    11523             v-fact-qnty-kg  = 0.0
    11524           .
    11525         end.
    11526       end.
    11527       if prt-mode <> 'ПРОСМОТР':U
    11528         and buf_goods.unit-base = buf_goods.unit-cli
    11529         and ( ub.doc-line.doc-density = ?
