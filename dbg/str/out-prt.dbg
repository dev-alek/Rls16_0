    10605                 else do :
    10606                   ub.gds-dtl.doc-qnty:screen-value  = string(ub.gds-dtl.doc-qnty + 1).
    10607                 end .
    10608               end .
    10609             end .
    10610             else do :
    10611               if not available buf_marking
    10612               then do :
    10613                 undo, return error return-value .
    10614               end .
    10615               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB and
    10616                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB and
    10617                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB and
    10618                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB and
