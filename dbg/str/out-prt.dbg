     4502         where buf_doc-line-attr.doc-code  = p-doc-code
     4503           and buf_doc-line-attr.gds-code  = p-gds-code
     4504           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4505         no-error NO-WAIT.
     4506       if not available buf_doc-line-attr then do:
     4507         p-deleted = no.
     4508       end.
