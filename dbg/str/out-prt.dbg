    10671                     end .
    10672                   end .
    10673                 end case .
    10674               end .
    10675             end .
    10676             apply "LEAVE":U to ub.gds-dtl.doc-qnty in frame d-out-prt.
    10677             apply "CHOOSE":U to b-exit in frame d-out-prt.
