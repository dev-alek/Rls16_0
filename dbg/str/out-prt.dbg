      184   procedure tax-name:
      185   define input  parameter pardef-tax  as character           no-undo.
      186   define output parameter parname-tax as character initial ? no-undo.
      187   define buffer bf_tax for ub.tax.
      188   do on error undo, return error :
      189      case pardef-tax:
      190         when 'vat':U then do:
      191                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      192         end.
      193         when 'slt':U then do:
      194                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      195         end.
      196         when 'rdt':U then do:
      197                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      198         end.
      199         when 'exc':U then do:
      200                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      201         end.
      202         otherwise do:
      203            return error "Задан неверный параметр " + pardef-tax + " .".
      204         end.
      205      end case.
      206   end.
      207   end procedure.
      208   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   procedure cur-time :
      210      define output parameter p-today as date      no-undo .
      211      define output parameter p-time  as integer   no-undo .
      212     do
      213     on error undo, return error
      214     :
      215       define variable v-date1 as date      no-undo .
      216       define variable v-date2 as date      no-undo .
      217       define variable v-time  as integer   no-undo .
      218       assign
      219         v-date1 = today
      220         v-time  = time
      221         v-date2 = today
      222       .
      223       if v-date1 <> v-date2
      224       then do:
      225         assign
      226           v-date1 = today
      227           v-time  = v-time
      228         .
      229       end.
      230       assign
      231         p-today = v-date1
      232         p-time  = v-time
      233       .
      234     end.
      235   end.
      236   function cur-time-date returns character
      237   :
      238     return string(today, '99/99/9999':U) .
      239   end.
      240   function cur-time-mjd returns decimal
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return integer(v-date) - 2400002 + (v-time / 86400) .
      249   end.
      250   function cur-time-get-ending-index returns integer
      251   (input p-number as integer
      252   )
      253   :
      254     if p-number < 0
      255     or p-number = ?
      256     then do:
      257       return 1 .
      258     end.
      259     define variable v-rest as integer   no-undo .
      260     assign
      261       p-number = p-number modulo 100
      262     .
      263     if p-number < 20
      264     then do:
      265       assign
      266         v-rest = p-number
      267       .
      268     end.
      269     else do:
      270       assign
      271         v-rest = p-number modulo 10
      272       .
      273     end.
      274     case v-rest :
      275       when 1
      276       then do:
      277         return 2 .
      278       end.
      279       when 2 or
      280       when 3 or
      281       when 4
      282       then do:
      283         return 3 .
      284       end.
      285       otherwise do:
      286         return 1 .
      287       end.
      288     end case .
      289   end.
      290   procedure cur-time-mjd-to-date :
      291      define input  parameter i-mjd-diff as decimal no-undo.
      292      define output parameter o-Date     as date    no-undo.
      293      define output parameter o-Time     as integer no-undo.
      294      define variable v-day-number as integer   no-undo .
      295      if    i-mjd-diff < 0
      296         or i-mjd-diff = ?
      297      then do:
      298         return "?" .
      299      end.
      300      assign
      301         v-day-number = truncate(i-mjd-diff,0).
      302         o-Date = date(v-day-number + 2400002).
      303         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      304     .
      305   end.
      306   function cur-time-mjd-to-string returns character
      307   (input p-mjd-diff as decimal
      308   )
      309   :
      310     define variable v-day-number as integer   no-undo .
      311     define variable v-seconds    as integer   no-undo .
      312     define variable v-hour       as integer   no-undo .
      313     define variable v-min        as integer   no-undo .
      314     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      315     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      316     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      317     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      318     if p-mjd-diff < 0
      319     or p-mjd-diff = ?
      320     then do:
      321       return "?" .
      322     end.
      323     assign
      324       v-day-number = integer(truncate(p-mjd-diff,0))
      325       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      326     .
      327     if v-seconds > 86400
      328     then do:
      329       assign
      330         v-seconds = 86400 - 1
      331       .
      332     end.
      333     if v-seconds < 0
      334     then do:
      335       assign
      336         v-seconds = 0
      337       .
      338     end.
      339     assign
      340       v-hour = truncate(v-seconds / 3600, 0)
      341     .
      342     assign
      343       v-seconds = v-seconds modulo 3600
      344     .
      345     assign
      346       v-min = truncate(v-seconds / 60, 0)
      347     .
      348     assign
      349       v-seconds = v-seconds modulo 60
      350     .
      351     return
      352         (if v-day-number <> 0
      353           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      354           else ""
      355         )
      356       + (if v-day-number <> 0 or v-hour <> 0
      357           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      358           else ""
      359         )
      360       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      361           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      362           else ""
      363         )
      364       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      365       .
      366   end.
      367   function cur-time-string returns character
      368   :
      369     define variable v-date as date      no-undo .
      370     define variable v-time as integer   no-undo .
      371     run cur-time in this-procedure
      372       (output v-date
      373       ,output v-time
      374       ) .
      375     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      376   end.
      377   function cur-time-string-sec returns character
      378   :
      379     define variable v-date as date      no-undo .
      380     define variable v-time as integer   no-undo .
      381     run cur-time in this-procedure
      382       (output v-date
      383       ,output v-time
      384       ) .
      385     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      386   end.
      387   function cur-time-custom  returns character
      388   (input p-prefix as character
      389   ,input p-date-format as character
      390   ,input p-delimiter as character
      391   ,input p-time-format as character
      392   ,input p-suffix as character
      393   )
      394   :
      395     define variable v-date as date      no-undo .
      396     define variable v-time as integer   no-undo .
      397     run cur-time in this-procedure
      398       (output v-date
      399       ,output v-time
      400       ) .
      401     return
      402       p-prefix
      403       + string(v-date, p-date-format)
      404       + p-delimiter
      405       + string(v-time, p-time-format)
      406       + p-suffix
      407       .
      408   end.
      409   function cur-time-print  returns character
      410   :
      411     define variable v-date as date      no-undo .
      412     define variable v-time as integer   no-undo .
      413     run cur-time in this-procedure
      414       (output v-date
      415       ,output v-time
      416       ) .
      417     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      418   end.
      419   function cur-time-datetime returns datetime
      420   :
      421     define variable v-char as character no-undo .
      422     define variable v-datetime as datetime no-undo .
      423     v-char = cur-time-string().
      424     v-datetime = datetime(v-char).
      425     return  v-datetime.
      426   end.
      427   function cur-time-string-msec returns character
      428   :
      429     define variable v-date as datetime  no-undo .
      430     v-date = now.
      431     return string(v-date) .
      432   end.
      433   define new global shared variable g#lib-trn  as handle no-undo .
      434   define new global shared variable g#lib-trn2 as handle no-undo .
      435   define new global shared variable g#lib-trn3 as handle no-undo .
      436   define new global shared variable g#lib-trn4 as handle no-undo .
      437   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define new global shared variable g#lib-calc as handle no-undo .
      439   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      440   procedure factord :
      441     define input  parameter p-fact-date            as date    no-undo .
      442     define input  parameter p-fact-time            as integer no-undo .
      443     define input  parameter p-fact-num             as integer no-undo .
      444     define input  parameter p-shift-date           as date    no-undo .
      445     define input  parameter p-shift-num            as integer no-undo .
      446     define input  parameter p-shift-on             as logical no-undo .
      447     define output parameter p-fact-order           as decimal no-undo .
      448     define output parameter p-shift-end-fact-order as decimal no-undo .
      449     define output parameter p-day-end-fact-order   as decimal no-undo .
      450     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      451     if p-fact-date = ?
      452     then do:
      453       return error "Не указана фактическая дата" .
      454     end.
      455     define variable v-fact-date-num as integer no-undo .
      456     assign
      457       v-fact-date-num = integer(p-fact-date)
      458     .
      459     if p-fact-num = ?
      460     or p-fact-num = 0
      461     then do:
      462       return error "Не задан p-fact-num " + string(p-fact-num) .
      463     end.
      464     if p-fact-num < 0
      465     then do:
      466       return error "Отрицательный fact-num " + string(p-fact-num) .
      467     end.
      468     if p-fact-num >= 100000000
      469     then do:
      470       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      471     end.
      472     if p-shift-on = true
      473     then do:
      474       if p-shift-date = ?
      475       then do:
      476         return error "Не задана дата смены" .
      477       end.
      478       if p-shift-num = ?
      479       or p-shift-num = 0
      480       then do:
      481         return error "Не задан номер смены" .
      482       end.
      483     end.
      484     else do:
      485       assign
      486         p-shift-date = p-fact-date
      487         p-shift-num  = 24
      488       .
      489     end.
      490     define variable v-shift-offset as integer no-undo .
      491     if p-shift-date = p-fact-date
      492     then do:
      493       assign
      494         v-shift-offset = 1
      495       .
      496     end.
      497     if p-shift-date < p-fact-date
      498     then do:
      499       assign
      500         v-shift-offset = 0
      501       .
      502     end.
      503     if p-shift-date > p-fact-date
      504     then do:
      505       message
      506         vss-workfile vss-revision vss-description skip
      507         "Неправильная дата закрытия смены" skip
      508         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      509         view-as alert-box error .
      510       undo, return error
      511         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      512           ,string(p-fact-date, '99/99/9999':U)
      513           ,string(p-shift-date, '99/99/9999':U)
      514           )
      515       .
      516     end.
      517     if p-shift-num < 1
      518     or p-shift-num > 24
      519     then do:
      520       message
      521         vss-workfile vss-revision vss-description skip
      522         "Неправильный номер смены" skip
      523         "p-shift-num" p-shift-num skip
      524         view-as alert-box error .
      525       undo, return error return-value .
      526     end.
      527     assign
      528       p-fact-order           = v-fact-date-num
      529                              + v-shift-offset * 0.5
      530                              + p-shift-num    * 0.02 - 0.01
      531                              + p-fact-num     * 0.0000000001
      532       p-shift-end-fact-order = v-fact-date-num
      533                              + v-shift-offset * 0.5
      534                              + p-shift-num    * 0.02
      535       p-day-end-fact-order   = v-fact-date-num
      536                              + 0.99
      537     .
      538     if p-fact-order           <= v-fact-date-num
      539     or p-shift-end-fact-order <= v-fact-date-num
      540     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      541     or p-shift-end-fact-order >= p-day-end-fact-order
      542     then do:
      543       message
      544         vss-workfile vss-revision vss-description skip
      545         "Внутренняя ошибка при генерации фактического номера" skip
      546         "p-fact-date"            p-fact-date            skip
      547         "p-fact-time"            p-fact-time            skip
      548         "p-fact-num"             p-fact-num             skip
      549         "p-shift-date"           p-shift-date           skip
      550         "p-shift-num"            p-shift-num            skip
      551         "p-shift-on"             p-shift-on             skip
      552         "p-shift-end-fact-order" p-shift-end-fact-order skip
      553         "p-day-end-fact-order"   p-day-end-fact-order   skip
      554         "v-fact-date-num"        v-fact-date-num        skip
      555         view-as alert-box error .
      556       undo, return error return-value .
      557     end.
      558   end procedure.
      559   procedure day-begin-fact-order :
      560     define input  parameter p-fact-date            as date    no-undo .
      561     define output parameter p-day-begin-fact-order as decimal no-undo .
      562     do
      563     on error undo, return error return-value
      564     :
      565       if p-fact-date = ?
      566       then do:
      567         assign
      568           p-day-begin-fact-order = 0
      569         .
      570       end.
      571       else do:
      572         assign
      573           p-day-begin-fact-order = integer(p-fact-date)
      574         .
      575       end.
      576     end.
      577   end procedure.
      578   procedure factord-max-fact-order :
      579     define output parameter p-max-fact-order as decimal   no-undo .
      580     do
      581     on error undo, return error return-value
      582     :
      583       run day-begin-fact-order in this-procedure
      584         (input  date(1, 1, 5000)
      585         ,output p-max-fact-order
      586         ) .
      587     end.
      588   end procedure.
      589   procedure factord-cut-archive :
      590     define input  parameter p-obj-type             as character no-undo .
      591     define input  parameter p-obj-code             as integer   no-undo .
      592     define input  parameter p-fact-date            as date      no-undo .
      593     define output parameter p-shift-on             as logical   no-undo .
      594     define output parameter p-shift-date           as date      no-undo .
      595     define output parameter p-shift-num            as integer   no-undo .
      596     define output parameter p-day-end-fact-order   as decimal   no-undo .
      597     define output parameter p-shift-end-fact-order as decimal   no-undo .
      598     define variable v-fact-order as decimal   no-undo .
      599     define buffer buf_shift-obj for ub.shift-obj .
      600     do
      601     on error undo, return error return-value
      602     :
      603   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      605     (input  p-obj-type
      606     ,input  p-obj-code
      607     ,input  'shift-on=request'
      608     ,output p-shift-on
      609     ) no-error .
      610       if error-status :error
      611       then do:
      612         message
      613           vss-workfile vss-revision vss-description skip
      614           "Ошибка при определении атрибута объекта" skip
      615           "Объект" p-obj-type p-obj-code skip
      616           error-status :get-message(1) skip
      617           return-value skip
      618           view-as alert-box error .
      619         undo, return error return-value .
      620       end.
      621       if p-shift-on = false
      622       then do:
      623         assign
      624           p-shift-date               = ?
      625           p-shift-num                = 0
      626         .
      627       end.
      628       else do:
      629         find first buf_shift-obj share-lock
      630           where buf_shift-obj.obj-type   = p-obj-type
      631             and buf_shift-obj.obj-code   = p-obj-code
      632             and buf_shift-obj.shift-date > p-fact-date
      633           use-index pi
      634           no-error .
      635         if not available buf_shift-obj
      636         or buf_shift-obj.status_ <> 'зкр':U
      637         then do:
      638           message
      639             vss-workfile vss-revision vss-description skip
      640             "Невозможно вычислить последнюю смену" skip
      641             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      642             "Объект" p-obj-type p-obj-code skip
      643             "Дата" p-fact-date skip
      644             view-as alert-box error .
      645           undo, return error return-value .
      646         end.
      647         find last buf_shift-obj share-lock
      648           where buf_shift-obj.obj-type = p-obj-type
      649             and buf_shift-obj.obj-code = p-obj-code
      650             and buf_shift-obj.shift-date <= p-fact-date
      651           use-index pi
      652           no-error .
      653         if available buf_shift-obj
      654         then do:
      655           if  buf_shift-obj.status_ = 'зкр':U
      656           then do:
      657             assign
      658               p-shift-date = buf_shift-obj.shift-date
      659               p-shift-num  = buf_shift-obj.shift-num
      660             .
      661           end.
      662           else do:
      663             message
      664               vss-workfile vss-revision vss-description skip
      665               "Невозможно вычислить последнюю смену" skip
      666               "Статус смены отличен от статуса" 'зкр':U skip
      667               "Объект" p-obj-type p-obj-code skip
      668               "Дата" p-fact-date skip
      669               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      670               view-as alert-box error .
      671             undo, return error return-value .
      672           end.
      673         end.
      674         else do:
      675           assign
      676             p-shift-date = p-fact-date - 1
      677             p-shift-num  = 1
      678           .
      679         end.
      680       end.
      681       run factord in this-procedure
      682         (input  p-fact-date
      683         ,input  1
      684         ,input  1
      685         ,input  p-shift-date
      686         ,input  p-shift-num
      687         ,input  p-shift-on
      688         ,output v-fact-order
      689         ,output p-shift-end-fact-order
      690         ,output p-day-end-fact-order
      691         ) no-error .
      692       if error-status :error
      693       then do:
      694         message
      695           vss-workfile vss-revision vss-description skip
      696           "Ошибка при вызове процедуры factord"
      697           error-status :get-message(1) skip
      698           return-value skip
      699           view-as alert-box error .
      700         undo, return error return-value .
      701       end.
      702     end.
      703   end procedure.
      704   procedure factord-lock-shift :
      705     define input  parameter p-obj-type  as character no-undo .
      706     define input  parameter p-obj-code  as integer   no-undo .
      707     define input  parameter p-fact-date as date      no-undo .
      708     define parameter buffer buf_shift-obj for ub.shift-obj .
      709     define variable v-shift-on      as logical   no-undo .
      710     define variable v-extra-message as character no-undo .
      711     define variable v-error as character no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      717     (input  p-obj-type
      718     ,input  p-obj-code
      719     ,input  'shift-on=request'
      720     ,output v-shift-on
      721     ) no-error .
      722       if error-status :error
      723       then do:
      724         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      725         undo, return error v-error .
      726       end.
      727       if v-shift-on = true
      728       then do:
      729         find first buf_shift-obj share-lock
      730           where buf_shift-obj.obj-type   = p-obj-type
      731             and buf_shift-obj.obj-code   = p-obj-code
      732             and buf_shift-obj.shift-date > p-fact-date
      733           use-index pi
      734           no-error .
      735         if not available buf_shift-obj
      736         or buf_shift-obj.status_ <> 'зкр':U
      737         then do:
      738           find last buf_shift-obj
      739             where buf_shift-obj.obj-type = p-obj-type
      740               and buf_shift-obj.obj-code = p-obj-code
      741               and buf_shift-obj.status_  = 'зкр':U
      742             use-index stts
      743             no-error .
      744           if available buf_shift-obj
      745           then do:
      746             assign
      747               v-extra-message =
      748                     substitute("Дата начала последеней закрытой смены на объекте &1"
      749                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      750                               )
      751             .
      752           end.
      753           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      754           undo, return error v-error .
      755         end.
      756       end.
      757     end.
      758   end procedure.
      759   procedure factord-end-day :
      760     define input  parameter p-fact-date            as date    no-undo .
      761     define output parameter p-day-end-fact-order   as decimal no-undo .
      762     do
      763     on error undo, return error return-value
      764     :
      765       if p-fact-date = ?
      766       then do:
      767         return error "Не указана фактическая дата" .
      768       end.
      769       assign
      770         p-day-end-fact-order = integer(p-fact-date) + 0.99
      771       .
      772     end.
      773   end procedure.
      774   procedure factord-to-date :
      775     define input  parameter p-fact-order as decimal no-undo .
      776     define output parameter p-fact-date  as date    no-undo .
      777     define variable v-ref-date  as date      no-undo .
      778     define variable v-ref-delta as integer   no-undo .
      779     do
      780     on error undo, return error return-value
      781     :
      782       if p-fact-order = ?
      783       or p-fact-order = 0
      784       then do:
      785         return error "Не указан fact-order" .
      786       end.
      787       assign
      788         v-ref-date  = date(1, 1, 2000)
      789       .
      790       assign
      791         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      792       .
      793       assign
      794         p-fact-date = v-ref-date + v-ref-delta
      795       .
      796     end.
      797   end procedure.
      798   procedure factord-to-fact-num :
      799     define input  parameter p-fact-order as decimal no-undo .
      800     define output parameter p-fact-num   as integer no-undo .
      801     define variable v-fact-order-trunc as decimal no-undo .
      802     do
      803     on error undo, return error return-value
      804     :
      805       if p-fact-order = ?
      806       or p-fact-order = 0
      807       then do:
      808         return error "Не указан fact-order" .
      809       end.
      810       assign
      811        v-fact-order-trunc = truncate(p-fact-order, 2)
      812       .
      813       assign
      814         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      815       .
      816     end.
      817   end procedure.
      818   procedure factord-to-shift-num :
      819     define input  parameter p-fact-order as decimal no-undo .
      820     define output parameter p-shift-num   as integer no-undo .
      821     define variable  p-shift-numd  as decimal   no-undo .
      822     define variable v-fact-order-trunc as decimal no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826       if p-fact-order = ?
      827       or p-fact-order = 0
      828       then do:
      829         return error "Не указан fact-order" .
      830       end.
      831       assign
      832        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      833       .
      834       if v-fact-order-trunc < 0.5 then do:
      835         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      836       end.
      837       assign
      838         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      839         .
      840        assign
      841         p-shift-num = truncate (p-shift-numd , 0)
      842       .
      843     end.
      844   end procedure.
      845   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   procedure fact-order-mpl :
      850     do
      851     on error undo, return error return-value
      852     :
      853   define input  parameter p-doc-date as date     no-undo .
      854   define input  parameter p-obj-type as character no-undo .
      855   define input  parameter p-obj-code as integer   no-undo .
      856   define output parameter p-fact-order as decimal   no-undo .
      857   define variable v-fact-date            as date    no-undo .
      858   define variable v-fact-time            as integer no-undo .
      859   define variable v-fact-order           as decimal no-undo .
      860   define variable v-shift-end-fact-order as decimal no-undo .
      861   define variable v-day-end-fact-order   as decimal no-undo .
      862   define variable l-shift-on as logical no-undo .
      863   define variable l-date as date      no-undo .
      864   define variable l-time as integer   no-undo .
      865   define variable shift-date as date      no-undo .
      866   define variable shift-num  as integer   no-undo .
      867   define variable shift-name as character no-undo .
      868   define variable max-fact-order as decimal   no-undo .
      869   define buffer buf_global-state for ub.global-state  .
      870   find first buf_global-state no-lock no-error .
      871   if not available buf_global-state then do:
      872      message
      873        "Не заданы параметры ценообразования!"
      874        view-as alert-box error
      875      .
      876      return error return-value .
      877   end.
      878     run cur-time in this-procedure
      879     ( output v-fact-date ,
      880       output v-fact-time  ).
      881   if p-doc-date = ? then do:
      882   if buf_global-state.pl-use-sys-date-time  = true then do:
      883         run factord in this-procedure
      884           (input  v-fact-date
      885           ,input  v-fact-time
      886           ,input  v-fact-time
      887           ,input  ?
      888           ,input  ?
      889           ,input  false
      890           ,output v-fact-order
      891           ,output v-shift-end-fact-order
      892           ,output v-day-end-fact-order
      893           ) no-error .
      894         if error-status :error
      895         or v-fact-order = ?
      896         or v-fact-order = 0 then do:
      897           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      898         end.
      899         p-fact-order = v-fact-order .
      900   end.
      901   else do:
      902   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      904     (input  p-obj-type
      905     ,input  p-obj-code
      906     ,input  'shift-on=request'
      907     ,output l-shift-on
      908     ) no-error .
      909         if error-status :error then return error "Неопределена дата на объекте " + return-value .
      910         if p-doc-date <> ? then do:
      911         end.
      912          run gbl/factdate.p
      913          ( input        p-obj-type  ,
      914            input        p-obj-code  ,
      915            input-output v-fact-date ,
      916            input-output v-fact-time ,
      917            input-output shift-date      ,
      918            input-output shift-num       ,
      919            input-output shift-name      ,
      920            input        yes
      921            ) no-error .
      922         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
      923         run factord in this-procedure
      924           (input  v-fact-date
      925           ,input  v-fact-time
      926           ,input  v-fact-time
      927           ,input  shift-date
      928           ,input  shift-num
      929           ,input  l-shift-on
      930           ,output v-fact-order
      931           ,output v-shift-end-fact-order
      932           ,output v-day-end-fact-order
      933           ) no-error .
      934         if error-status :error
      935         or v-fact-order = ?
      936         or v-fact-order = 0 then do:
      937           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      938         end.
      939         p-fact-order = v-fact-order .
      940   end.
      941   end.
      942   else do:
      943          run gbl/factdate.p
      944          ( input        p-obj-type  ,
      945            input        p-obj-code  ,
      946            input-output v-fact-date ,
      947            input-output v-fact-time ,
      948            input-output shift-date      ,
      949            input-output shift-num       ,
      950            input-output shift-name      ,
      951            input        yes
      952            ) no-error .
      953         if error-status :error then return error "Ошибка factdate.p " + return-value .
      954         v-fact-date = p-doc-date .
      955         run factord in this-procedure
      956           (input  v-fact-date
      957           ,input  v-fact-time
      958           ,input  v-fact-time
      959           ,input  shift-date
      960           ,input  shift-num
      961           ,input  l-shift-on
      962           ,output v-fact-order
      963           ,output v-shift-end-fact-order
      964           ,output v-day-end-fact-order
      965           ) no-error .
      966         if error-status :error
      967         or v-fact-order = ?
      968         or v-fact-order = 0 then do:
      969           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      970         end.
      971         p-fact-order = v-fact-order .
      972   end.
      973     end.
      974   end procedure.
      975   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
      976   field sale-qnty as decimal
      977   field sale-sum  as decimal
      978   field sale-tnv  as decimal
      979   field price-sale-base as decimal
      980   field price-sale-rubl as decimal
      981   field road-tax-base   as decimal
      982   field road-tax-rubl   as decimal
      983   field excise-base as decimal
      984   field excise-rubl as decimal
      985   field date-1 as date
      986   field date-2 as date
      987   field shift-1 as int
      988   field shift-2 as int
      989   field time-1 as int
      990   field time-2 as int
      991   field grp-name as char
      992   field interv-name as char
      993   field pay-name as char
      994   field unit-cli as char
      995   index pi
      996   plt-priority DESCENDING
      997   fact-order DESCENDING
      998   qnty-from asc
      999   sum-from asc
     1000   turnover-from asc
     1001   date-1 DESCENDING
     1002   time-1 DESCENDING
     1003   date-2 DESCENDING
     1004   time-2 DESCENDING
     1005   type-price DESCENDING
     1006   .
     1007   procedure mpl-autoprice :
     1008   define input  parameter p-only-b-code as logical   no-undo .
     1009   define input  parameter p-cli-type    as character no-undo .
     1010   define input  parameter p-cli-code    as integer   no-undo .
     1011   define input  parameter p-main-b-code as integer   no-undo .
     1012   define input  parameter p-b-code      as integer   no-undo .
     1013   define input  parameter p-obj-type    as character no-undo .
     1014   define input  parameter p-obj-code    as integer   no-undo .
     1015   define input  parameter p-qnty-doc    as decimal   no-undo .
     1016   define input  parameter p-sum-doc     as decimal   no-undo .
     1017   define input  parameter p-vid-pay        as character no-undo .
     1018   define input  parameter p-cash-pay-type  as character no-undo .
     1019   define input  parameter p-fact-order  as decimal   no-undo .
     1020   define output parameter p-plt-id          as integer   no-undo .
     1021   define output parameter p-plt-db-num      as integer   no-undo .
     1022   define output parameter p-pdf-id          as integer   no-undo .
     1023   define output parameter p-pdf-db-num      as integer   no-undo .
     1024   define output parameter p-sale-price-base as decimal   no-undo .
     1025   define output parameter p-sale-price-rubl as decimal   no-undo .
     1026   define output parameter p-road-tax-base as decimal   no-undo .
     1027   define output parameter p-road-tax-rubl as decimal   no-undo .
     1028   define output parameter p-excise-base   as decimal   no-undo .
     1029   define output parameter p-excise-rubl   as decimal   no-undo .
     1030   define variable v-cli-oborot-ALL as decimal   no-undo .
     1031   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1032   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1033   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1034   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1035   define buffer buf_price-all              for ub.price-all  .
     1036   define buffer buf_goods                  for ub.goods      .
     1037   define buffer buf_global-state           for ub.global-state  .
     1038   define buffer buf_buyer-group            for ub.buyer-group  .
     1039   define buffer buf_turnover-group         for ub.turnover-group  .
     1040   define buffer buf_main-code              for ub.bar-code  .
     1041   define buffer buf_bar-code               for ub.bar-code  .
     1042   define buffer buf_pay-type               for ub.pay-type  .
     1043   define buffer buf_cash-pay               for ub.cash-pay  .
     1044   define variable to-day          as date      no-undo .
     1045   define variable v-base-rate0    as decimal   no-undo .
     1046   define variable v-base-scale0   as decimal   no-undo .
     1047   define variable v-exch-rate0    as decimal   no-undo .
     1048   define variable v-exch-scale0   as decimal   no-undo .
     1049   define variable v-base-rate     as decimal   no-undo .
     1050   define variable v-base-scale    as decimal   no-undo .
     1051   define variable v-exch-rate     as decimal   no-undo .
     1052   define variable v-exch-scale    as decimal   no-undo .
     1053   define variable v-host-code     as integer   no-undo .
     1054   define variable v-curr-abbr     as character no-undo .
     1055   define variable v-grp-name      as character no-undo .
     1056   define variable v-date-1        as date      no-undo .
     1057   define variable v-date-2        as date      no-undo .
     1058   define variable v-interv        as character no-undo .
     1059   define variable v-pay-name      as character no-undo .
     1060   define variable v-cli-oborot    as decimal   no-undo .
     1061   define variable v-trn-pay-code  as integer   no-undo .
     1062   define variable v-cash-pay-curr as integer   no-undo .
     1063   define variable v-cash-pay-code as integer   no-undo .
     1064   do
     1065   on error undo, return error return-value
     1066   :
     1067   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1068   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1069   if p-fact-order = ? then do:
     1070     run fact-order-mpl (
     1071         input   today       ,
     1072         input   p-obj-type  ,
     1073         input   p-obj-code  ,
     1074         output  p-fact-order ).
     1075   end.
     1076   if p-vid-pay <> "" then do:
     1077      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1078      if available buf_pay-type
     1079         then v-trn-pay-code = buf_pay-type.obj-code.
     1080         else v-trn-pay-code =  0.
     1081   end.
     1082   else v-trn-pay-code = 0 .
     1083   if p-cash-pay-type <> "" then do:
     1084      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1085      if available buf_pay-type
     1086         then
     1087           assign
     1088             v-cash-pay-curr = buf_cash-pay.curr-code
     1089             v-cash-pay-code = buf_cash-pay.cdpay-code
     1090           .
     1091         else
     1092           assign
     1093             v-cash-pay-curr = 0
     1094             v-cash-pay-code = 0
     1095             .
     1096   end.
     1097   else
     1098     assign
     1099       v-cash-pay-curr = 0
     1100       v-cash-pay-code = 0
     1101       .
     1102   for each tt_price-all  : delete tt_price-all . end.
     1103   assign
     1104     p-plt-id             = ?
     1105     p-plt-db-num         = ?
     1106     p-pdf-id             = ?
     1107     p-pdf-db-num         = ?
     1108     p-sale-price-base    = ?
     1109     p-sale-price-rubl    = ?
     1110     v-cli-oborot         = 0
     1111   .
     1112   find first buf_global-state no-lock no-error .
     1113   if not available buf_global-state then do:
     1114      message
     1115        "Не заданы параметры ценообразования!"
     1116        view-as alert-box error
     1117      .
     1118      return error return-value .
     1119   end.
     1120   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1122     (input  p-obj-type
     1123     ,input  p-obj-code
     1124     ,output to-day
     1125     )  .
     1126   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1128     (input  p-obj-type
     1129     ,input  p-obj-code
     1130     ,output v-host-code
     1131     )  .
     1132   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1134     (input  v-host-code
     1135     ,input  to-day
     1136     ,output v-base-rate0
     1137     ,output v-base-scale0
     1138     )  .
     1139     v-cli-oborot-ALL  = 0 .
     1140     for each buf_turnover-buyer-main no-lock  where
     1141              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1142              buf_turnover-buyer-main.cli-code = p-cli-code
     1143              :
     1144              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1145     end.
     1146   for each buf_price-all no-lock where
     1147            buf_price-all.obj-type = p-obj-type and
     1148            buf_price-all.obj-code = p-obj-code and
     1149            buf_price-all.gds-code = buf_goods.gds-code and
     1150            buf_price-all.status_  = 'акт':U  and
     1151          ( p-only-b-code = false   or
     1152          ( buf_price-all.b-code = p-main-b-code or
     1153            buf_price-all.b-code = p-b-code))    and
     1154           ( p-only-b-code = true  or
     1155             buf_price-all.b-code = p-b-code)
     1156             and
     1157             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1158           ( buf_price-all.fact-order-sys-to = ? or
     1159             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1160           :
     1161            v-interv   = "" .
     1162            v-grp-name = "" .
     1163            v-pay-name = "" .
     1164            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1165            if buf_price-all.bgr-id > 0 then do:
     1166               find first buf_buyer-group no-lock where
     1167                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1168                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1169               if available buf_buyer-group then do:
     1170                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1171                  find first buf_buyer-in-buyer-group no-lock where
     1172                             buf_buyer-in-buyer-group.stts         = 0 and
     1173                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1174                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1175                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1176                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1177                             no-error .
     1178                             if not available buf_buyer-in-buyer-group then do:
     1179                                v-grp-name = "".
     1180                                next.
     1181                             end.
     1182                             v-grp-name = buf_buyer-group.name .
     1183                  end.
     1184               end.
     1185               else do:
     1186                    v-grp-name = "".
     1187                    next.
     1188               end.
     1189            end.
     1190            if buf_price-all.tog-id > 0 then do:
     1191               find first buf_turnover-group no-lock where
     1192                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1193                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1194               if available buf_turnover-group then do:
     1195                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1196                     v-cli-oborot = v-cli-oborot-all  .
     1197                     find first buf1_tnv-in-turnover-group no-lock where
     1198                                buf1_tnv-in-turnover-group.stts       =  0     and
     1199                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1200                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1201                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1202                     find first buf2_tnv-in-turnover-group no-lock where
     1203                                buf2_tnv-in-turnover-group.stts       =  0     and
     1204                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1205                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1206                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1207                     if not (available buf1_tnv-in-turnover-group and
     1208                             available buf2_tnv-in-turnover-group ) then do:
     1209                             v-grp-name = "".
     1210                             next .
     1211                     end.
     1212                     v-grp-name = buf_turnover-group.name.
     1213                  end.
     1214               end.
     1215               else do:
     1216                    v-grp-name = "".
     1217                    next.
     1218               end.
     1219            end.
     1220            if buf_price-all.plt-fix-cource-crc-base = true then
     1221               assign
     1222                 v-base-rate  = buf_price-all.pdf-base-rate
     1223                 v-base-scale = buf_price-all.pdf-base-scale
     1224               .
     1225               else
     1226               assign
     1227                 v-base-rate  = v-base-rate0
     1228                 v-base-scale = v-base-scale0
     1229               .
     1230            if buf_price-all.plt-fix-cource-crc-doc = true then
     1231               assign
     1232                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1233                 v-exch-scale = buf_price-all.pdf-exch-scale
     1234               .
     1235               else do:
     1236   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1238     (input  buf_price-all.curr-code
     1239     ,input  to-day
     1240     ,output v-exch-rate0
     1241     ,output v-exch-scale0
     1242     ,output v-curr-abbr
     1243     )  .
     1244               assign
     1245                 v-exch-rate  = v-exch-rate0
     1246                 v-exch-scale = v-exch-scale0
     1247                 .
     1248              end.
     1249              v-date-1 = date ( "" )  .
     1250              if buf_price-all.fact-order-sys-from > 0 then do:
     1251                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1252                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1253                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1254              end.
     1255              v-date-2 =  date ( "" )  .
     1256              if buf_price-all.fact-order-sys-to > 0 then do:
     1257                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1258                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1259                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1260              end.
     1261              if buf_price-all.qnty-from <> ? then do :
     1262                 if not (
     1263                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1264                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1265                 ) then do:
     1266                        v-interv = "".
     1267                        next.
     1268                 end.
     1269                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1270              end.
     1271              if buf_price-all.sum-from <> ? then do :
     1272                 if not (
     1273                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1274                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1275                 ) then do:
     1276                    v-interv = "".
     1277                    next.
     1278                 end.
     1279                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1280              end.
     1281              if buf_price-all.turnover-from <> ? then do :
     1282                 if not (
     1283                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1284                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1285                 ) then do:
     1286                    v-interv = "".
     1287                    next.
     1288                 end.
     1289                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1290              end.
     1291              if buf_price-all.use-pay-type = 1 then do :
     1292                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1293                    v-pay-name = "" .
     1294                    next.
     1295                  end.
     1296                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1297              end.
     1298              if buf_price-all.use-cash-pay = 1 then do :
     1299                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1300                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1301                   v-pay-name = "" .
     1302                   next.
     1303                 end.
     1304                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1305              end.
     1306             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1307             create tt_price-all .
     1308             buffer-copy buf_price-all to tt_price-all
     1309             assign
     1310               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1311               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1312               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1313               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1314               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1315               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1316               tt_price-all.price-sale     = buf_price-all.price-sale
     1317               tt_price-all.road-tax       = buf_price-all.road-tax
     1318               tt_price-all.excise         = buf_price-all.excise
     1319               tt_price-all.pdf-exch-rate   = v-exch-rate
     1320               tt_price-all.pdf-exch-scale  = v-exch-scale
     1321               tt_price-all.pdf-base-rate   = v-base-rate
     1322               tt_price-all.pdf-base-scale  = v-base-scale
     1323               tt_price-all.grp-name        = v-grp-name
     1324               tt_price-all.date-1          = v-date-1
     1325               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1326               tt_price-all.time-1          = buf_price-all.start-sys-time
     1327               tt_price-all.date-2          = v-date-2
     1328               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1329               tt_price-all.time-2          = buf_price-all.end-sys-time
     1330               tt_price-all.interv-name     = v-interv
     1331               tt_price-all.pay-name        = v-pay-name
     1332               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1333             .
     1334   end.
     1335   define variable vt-plt-id as integer   no-undo .
     1336   define variable vt-plt-db as integer   no-undo .
     1337   define variable vt-pdf-id as integer   no-undo .
     1338   define variable vt-pdf-db as integer   no-undo .
     1339   define buffer neos_price-all for tt_price-all  .
     1340   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1341       if available tt_price-all then do:
     1342        assign
     1343          vt-plt-id = tt_price-all.plt-id
     1344          vt-plt-db = tt_price-all.plt-db-num
     1345          vt-pdf-id = tt_price-all.pdf-id
     1346          vt-pdf-db = tt_price-all.pdf-db
     1347        .
     1348        if tt_price-all.b-code = p-b-code then do:
     1349             assign
     1350               p-plt-id           = tt_price-all.plt-id
     1351               p-plt-db-num       = tt_price-all.plt-db-num
     1352               p-pdf-id           = tt_price-all.pdf-id
     1353               p-pdf-db-num       = tt_price-all.pdf-db
     1354               p-sale-price-base  = tt_price-all.price-sale-base
     1355               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1356               p-road-tax-base    = tt_price-all.road-tax-base
     1357               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1358               p-excise-base      = tt_price-all.excise-base
     1359               p-excise-rubl      = tt_price-all.excise-rubl
     1360               .
     1361        end.
     1362        else do:
     1363          find first neos_price-all where
     1364                     neos_price-all.b-code     = p-b-code  and
     1365                     neos_price-all.plt-id     = vt-plt-id and
     1366                     neos_price-all.plt-db-num = vt-plt-db and
     1367                     neos_price-all.pdf-id     = vt-pdf-id and
     1368                     neos_price-all.pdf-db     = vt-pdf-db
     1369                     use-index pi no-error .
     1370            if available neos_price-all then do:
     1371             assign
     1372               p-plt-id           = tt_price-all.plt-id
     1373               p-plt-db-num       = tt_price-all.plt-db-num
     1374               p-pdf-id           = tt_price-all.pdf-id
     1375               p-pdf-db-num       = tt_price-all.pdf-db
     1376               p-sale-price-base  = neos_price-all.price-sale-base
     1377               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1378               p-road-tax-base    = neos_price-all.road-tax-base
     1379               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1380               p-excise-base      = neos_price-all.excise-base
     1381               p-excise-rubl      = neos_price-all.excise-rubl
     1382               .
     1383            end.
     1384            else do:
     1385                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1386                 if error-status :error    then do:
     1387                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1388                   return error return-value .
     1389                 end.
     1390             assign
     1391               p-plt-id           = tt_price-all.plt-id
     1392               p-plt-db-num       = tt_price-all.plt-db-num
     1393               p-pdf-id           = tt_price-all.pdf-id
     1394               p-pdf-db-num       = tt_price-all.pdf-db
     1395               p-sale-price-base  = tt_price-all.price-sale-base
     1396               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1397               p-road-tax-base    = tt_price-all.road-tax-base
     1398               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1399               p-excise-base      = tt_price-all.excise-base
     1400               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1401               .
     1402            end.
     1403        end.
     1404     end.
     1405   end.
     1406   end procedure.
     1407   procedure mpl-tpl-auto :
     1408   define input  parameter p-b-code     as integer   no-undo .
     1409   define input  parameter p-obj-type   as character no-undo .
     1410   define input  parameter p-obj-code   as integer   no-undo .
     1411   define input  parameter p-plt-id     as integer   no-undo .
     1412   define input  parameter p-plt-db-num as integer   no-undo .
     1413   define input  parameter p-fact-order as decimal   no-undo .
     1414   define output parameter p-sale-price as decimal   no-undo .
     1415   define output parameter p-pdf-id     as integer   no-undo .
     1416   define output parameter p-pdf-db-num as integer   no-undo .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420   if p-fact-order = ? then do:
     1421     run fact-order-mpl (
     1422         input   today       ,
     1423         input   p-obj-type  ,
     1424         input   p-obj-code  ,
     1425         output  p-fact-order ) .
     1426   end.
     1427   assign
     1428     p-pdf-id      = ?
     1429     p-pdf-db-num  = ?
     1430     p-sale-price  = ?
     1431   .
     1432   define buffer buf_bar-code for ub.bar-code  .
     1433   define buffer buf_goods for ub.goods  .
     1434   find first buf_bar-code no-lock where
     1435              buf_bar-code.b-code = p-b-code
     1436              no-error .
     1437   if error-status :error then return error return-value .
     1438   find first buf_goods no-lock where
     1439              buf_goods.gds-code = buf_bar-code.gds-code
     1440              no-error .
     1441   if error-status :error then return error return-value .
     1442   define variable v-main-b-code as integer   no-undo .
     1443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1444     (input  buf_goods.gds-code
     1445     ,input  ?
     1446     ,output v-main-b-code
     1447     )  .
     1448   define buffer buf_price-all for ub.price-all  .
     1449   for each tt_price-all : delete tt_price-all. end.
     1450       for each buf_price-all no-lock where
     1451               buf_price-all.plt-id     = p-plt-id                 and
     1452               buf_price-all.plt-db-num = p-plt-db-num             and
     1453               buf_price-all.obj-type   = p-obj-type               and
     1454               buf_price-all.obj-code   = p-obj-code               and
     1455               buf_price-all.gds-code   = buf_goods.gds-code       and
     1456             ( buf_price-all.b-code = v-main-b-code or
     1457               buf_price-all.b-code = p-b-code)    and
     1458               buf_price-all.status_    = 'акт':U         and
     1459               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1460             ( buf_price-all.fact-order-sys-to = ? or
     1461               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1462               :
     1463                 create tt_price-all .
     1464                 buffer-copy buf_price-all to tt_price-all
     1465                 assign
     1466                   tt_price-all.price-sale  = buf_price-all.price-sale
     1467                 .
     1468       end.
     1469   define variable vt-plt-id as integer   no-undo .
     1470   define variable vt-plt-db as integer   no-undo .
     1471   define variable vt-pdf-id as integer   no-undo .
     1472   define variable vt-pdf-db as integer   no-undo .
     1473   define buffer neos_price-all for tt_price-all  .
     1474   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1475       if available tt_price-all then do:
     1476        assign
     1477          vt-plt-id = tt_price-all.plt-id
     1478          vt-plt-db = tt_price-all.plt-db-num
     1479          vt-pdf-id = tt_price-all.pdf-id
     1480          vt-pdf-db = tt_price-all.pdf-db
     1481        .
     1482        if tt_price-all.b-code = p-b-code then do:
     1483             assign
     1484               p-plt-id           = tt_price-all.plt-id
     1485               p-plt-db-num       = tt_price-all.plt-db-num
     1486               p-pdf-id           = tt_price-all.pdf-id
     1487               p-pdf-db-num       = tt_price-all.pdf-db
     1488               p-sale-price       = tt_price-all.price-sale
     1489               .
     1490        end.
     1491        else do:
     1492          find first neos_price-all where
     1493                     neos_price-all.b-code     = p-b-code  and
     1494                     neos_price-all.plt-id     = vt-plt-id and
     1495                     neos_price-all.plt-db-num = vt-plt-db and
     1496                     neos_price-all.pdf-id     = vt-pdf-id and
     1497                     neos_price-all.pdf-db     = vt-pdf-db
     1498                     use-index pi no-error .
     1499            if available neos_price-all then do:
     1500             assign
     1501               p-plt-id           = tt_price-all.plt-id
     1502               p-plt-db-num       = tt_price-all.plt-db-num
     1503               p-pdf-id           = tt_price-all.pdf-id
     1504               p-pdf-db-num       = tt_price-all.pdf-db
     1505               p-sale-price       = neos_price-all.price-sale
     1506               .
     1507            end.
     1508            else do:
     1509           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1510           if error-status :error    then do:
     1511              message "Не найден бар-код" p-b-code view-as alert-box error .
     1512              return error return-value .
     1513           end.
     1514             assign
     1515               p-plt-id           = tt_price-all.plt-id
     1516               p-plt-db-num       = tt_price-all.plt-db-num
     1517               p-pdf-id           = tt_price-all.pdf-id
     1518               p-pdf-db-num       = tt_price-all.pdf-db
     1519               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1520               .
     1521            end.
     1522        end.
     1523     end.
     1524     end.
     1525   end procedure.
