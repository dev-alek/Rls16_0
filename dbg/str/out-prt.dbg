     4515   procedure lineattr-delete-flora-all :
     4516     do
     4517     on error undo, return error return-value
     4518     :
     4519       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4520       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4521       define input  parameter p-prt-code    as integer   no-undo .
     4522       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4523       for each buf_doc-line-attr exclusive-lock
     4524         where buf_doc-line-attr.doc-code  = p-doc-code
     4525           and buf_doc-line-attr.gds-code  = p-gds-code
     4526           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     4527        :
     4528         delete buf_doc-line-attr.
     4529       end.
     4530    end.
     4531   end procedure.
     4532   procedure lineattr-exist-flora-gds :
     4533     do
     4534     on error undo, return error return-value
     4535     :
     4536       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     4537       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     4538       define input  parameter p-prt-code    as integer   no-undo .
     4539       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     4540       define output parameter p-exist as logical   no-undo .
     4541       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4542       p-exist = false .
     4543       find first buf_doc-line-attr no-lock
     4544         where buf_doc-line-attr.doc-code  = p-doc-code
     4545           and buf_doc-line-attr.gds-code  = p-gds-code
     4546           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4547         no-error .
     4548       if avail buf_doc-line-attr then do:
     4549         assign
     4550          p-exist = true
     4551         .
     4552       end.
     4553     end.
     4554   end procedure.
     4555   procedure lineattr-write-add-line-cli :
     4556   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4557   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     4558   define input  parameter p-cli-type      as character no-undo .
     4559   define input  parameter p-cli-code      as integer   no-undo .
     4560   define input  parameter p-contract-code as integer   no-undo .
     4561   define input  parameter p-host-code     as integer   no-undo .
     4562   define input  parameter p-exch-code     as integer   no-undo .
     4563   define input  parameter p-exch-rate     as decimal   no-undo .
     4564   define input  parameter p-exch-scale    as integer   no-undo .
     4565   define input  parameter p-sum-cli       as decimal   no-undo .
     4566   define input  parameter p-sum-vat       as decimal   no-undo .
     4567   define buffer buf_doc-line-attr for ub.doc-line-attr .
     4568     do
     4569     on error undo, return error return-value
     4570     :
     4571       find first buf_doc-line-attr exclusive-lock
     4572         where buf_doc-line-attr.doc-code  = p-doc-code
     4573           and buf_doc-line-attr.gds-code  = p-gds-code
     4574           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     4575                                             chr(4) + p-cli-type +
     4576                                             chr(4) + string(p-cli-code) +
     4577                                             chr(4) + string(p-contract-code) +
     4578                                             chr(4) + string(p-host-code)
     4579         no-error .
     4580       if not available buf_doc-line-attr then do:
     4581         create buf_doc-line-attr .
     4582         assign
     4583           buf_doc-line-attr.doc-code  = p-doc-code
     4584           buf_doc-line-attr.gds-code  = p-gds-code
     4585           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     4586                                         chr(4) + p-cli-type +
     4587                                         chr(4) + string(p-cli-code) +
     4588                                         chr(4) + string(p-contract-code) +
     4589                                         chr(4) + string(p-host-code)
     4590         .
     4591       end.
     4592       assign
     4593         buf_doc-line-attr.attr-value =
     4594         string(p-exch-code)  + chr(4) +
     4595         string(p-exch-rate)  + chr(4) +
     4596         string(p-exch-scale) + chr(4) +
     4597         string(p-sum-cli)    + chr(4) +
     4598         string(p-sum-vat)
     4599         .
     4600     end.
     4601   end procedure.
     4602   procedure lineattr-value-add-line-cli :
     4603   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4604   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     4605   define input   parameter p-cli-type      as character no-undo .
     4606   define input   parameter p-cli-code      as integer   no-undo .
     4607   define input   parameter p-contract-code as integer   no-undo .
     4608   define input   parameter p-host-code     as integer   no-undo .
     4609   define output  parameter p-exch-code     as integer   no-undo .
     4610   define output  parameter p-exch-rate     as decimal   no-undo .
     4611   define output  parameter p-exch-scale    as integer   no-undo .
     4612   define output  parameter p-sum-cli       as decimal   no-undo .
     4613   define output  parameter p-sum-vat       as decimal   no-undo .
     4614   define buffer buf_doc-line-attr for ub.doc-line-attr .
     4615     do
     4616     on error undo, return error return-value
     4617     :
     4618       find first buf_doc-line-attr exclusive-lock
     4619         where buf_doc-line-attr.doc-code  = p-doc-code
     4620           and buf_doc-line-attr.gds-code  = p-gds-code
     4621           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     4622                                             chr(4) + p-cli-type +
     4623                                             chr(4) + string(p-cli-code) +
     4624                                             chr(4) + string(p-contract-code) +
     4625                                             chr(4) + string(p-host-code)
     4626         no-error .
     4627       if available buf_doc-line-attr then do:
     4628        assign
     4629           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     4630           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     4631           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     4632           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     4633           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     4634          .
     4635        end.
     4636     end.
     4637   end procedure.
     4638   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     4639     define variable v-code as character no-undo .
     4640     define variable v-type as character no-undo .
     4641     define variable v-gds-code as integer   no-undo .
     4642   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4644     (input  local-doc-line.artic
     4645     ,input  local-doc-line.prod-type
     4646     ,input  local-doc-line.prod-code
     4647     ,output v-gds-code
     4648     )  .
     4649     run lineattr-value (
     4650         input   local-doc-line.doc-code ,
     4651         input   v-gds-code              ,
     4652         input   'reason-code':U ,
     4653         output  v-code                  ,
     4654         output  v-type ) .
     4655     find first ub.trn-reason no-lock where
     4656                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     4657     if not available ub.trn-reason then do:
     4658        return "" .
     4659     end.
     4660     else do:
     4661        return ub.trn-reason.reason-name .
     4662     end.
     4663   end function.
     4664   procedure lineattr-value-parts :
     4665     do
     4666     on error undo, return error return-value
     4667     :
     4668       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     4669       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     4670       define input  parameter p-part-code   as character no-undo .
     4671       define input  parameter p_in-code     as character no-undo .
     4672       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     4673       define output parameter p-value       as    decimal   no-undo .
     4674       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4675       find first buf_doc-line-attr no-lock
     4676         where buf_doc-line-attr.doc-code  = p-doc-code
     4677           and buf_doc-line-attr.gds-code  = p-gds-code
     4678           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     4679         no-error .
     4680       if avail buf_doc-line-attr then do:
     4681         assign
     4682           p-value = decimal( buf_doc-line-attr.attr-value)
     4683         .
     4684       end.
     4685       else do:
     4686         assign
     4687           p-value = 0
     4688         .
     4689       end.
     4690     end.
     4691   end procedure.
     4692   procedure lineattr-write-parts :
     4693     do
     4694     on error undo, return error return-value
     4695     :
     4696       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4697       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4698       define input parameter p-part-code  as character no-undo .
     4699       define input parameter p_in-code    as character no-undo .
     4700       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     4701       define input parameter p-value      as decimal   no-undo .
     4702       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4703       find first buf_doc-line-attr exclusive-lock
     4704         where buf_doc-line-attr.doc-code  = p-doc-code
     4705           and buf_doc-line-attr.gds-code  = p-gds-code
     4706           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     4707         no-error .
     4708       if not available buf_doc-line-attr then do:
     4709         create buf_doc-line-attr .
     4710         assign
     4711           buf_doc-line-attr.doc-code  = p-doc-code
     4712           buf_doc-line-attr.gds-code  = p-gds-code
     4713           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     4714         .
     4715       end.
     4716       assign
     4717         buf_doc-line-attr.attr-value = string( p-value )
     4718       .
     4719     end.
     4720   end procedure.
     4721   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4722   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4723   define variable par-type          as character no-undo.
     4724   define variable v-value-character as character no-undo .
     4725   define variable v-value-date      as date      no-undo .
     4726   define variable v-value-decimal   as decimal   no-undo .
     4727   define variable v-value-integer   as integer   no-undo .
     4728   define variable v-value-logical   as logical   no-undo .
     4729   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4730   procedure gen-key-rec :
     4731     define input  parameter p-tbl-name    as character no-undo.
     4732     define input  parameter p-bh_tbl-name as handle    no-undo.
     4733     define output parameter p-key-rec     as character no-undo.
     4734     do
     4735     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4736     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     4737     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     4738     :
     4739       define variable fh               as handle    no-undo .
     4740       define variable v-ok             as logical   no-undo .
     4741       define variable v-inform         as character no-undo .
     4742       define variable v-ind            as integer   no-undo .
     4743       define variable v-idx-field-qnty as integer   no-undo .
     4744       if p-tbl-name = ?
     4745         or p-tbl-name = "":U
     4746       then do:
     4747         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info31 ).
     4748       end.
     4749       if not p-bh_tbl-name:available then do:
     4750         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info31, p-tbl-name ).
     4751       end.
     4752       assign
     4753         p-key-rec = p-tbl-name
     4754         v-inform  = p-bh_tbl-name:index-information(1)
     4755         v-ind     = 2
     4756       .
     4757       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4758       on error undo, return error
     4759       :
     4760         assign
     4761           v-inform = p-bh_tbl-name:index-information( v-ind )
     4762           v-ind    = v-ind + 1
     4763         .
     4764       end.
     4765       if v-inform = ?
     4766         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4767         or entry( 3, v-inform, ",":U ) <> "1":U
     4768       then do:
     4769         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, p-tbl-name ).
     4770       end.
     4771       else do:
     4772         assign
     4773           v-idx-field-qnty = num-entries( v-inform ) - 4
     4774         .
     4775         if v-idx-field-qnty < 2 then do:
     4776           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, p-tbl-name ).
     4777         end.
     4778         do v-ind = 1 to v-idx-field-qnty by 2
     4779         on error undo, return error
     4780         :
     4781           assign
     4782             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     4783             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     4784           .
     4785         end.
     4786       end.
     4787       if p-key-rec = ? then do:
     4788         assign
     4789           p-key-rec = "":U
     4790         .
     4791         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info31, p-tbl-name ).
     4792       end.
     4793     end.
     4794     return.
     4795   end procedure.
     4796   procedure gen-where-keyr-tab :
     4797     define input  parameter i-tableSerach as character no-undo.
     4798     define input  parameter i-tablekey   as character  no-undo.
     4799     define input  parameter p-key-rec    as character  no-undo.
     4800     define input  parameter p-key-handle as handle     no-undo .
     4801     define input  parameter p-db-name    as character  no-undo .
     4802     define input  parameter p-tt-handle  as handle     no-undo .
     4803     define output parameter o-Where      as character  no-undo.
     4804     do
     4805     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4806     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4807     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     4808     :
     4809       define variable v-full-tbl-name  as character no-undo .
     4810       define variable bh_tbl-name      as handle    no-undo .
     4811       define variable fh_key           as handle    no-undo .
     4812       define variable fh_search        as handle    no-undo .
     4813       define variable v-field-num      as integer   no-undo .
     4814       define variable v-count-fld      as integer   no-undo .
     4815       define variable v-inform         as character no-undo .
     4816       define variable v-ind            as integer   no-undo .
     4817       define variable v-idx-field-qnty as integer   no-undo .
     4818       define variable v-field-name     as character no-undo .
     4819       define variable v-field-val      as character no-undo .
     4820       define variable v-word-link      as character no-undo .
     4821       define variable vTable           as character no-undo.
     4822       define variable bh_tbl-key       as handle    no-undo .
     4823       assign
     4824         p-key-rec = trim( p-key-rec )
     4825       .
     4826       if p-key-handle <> ? then do:
     4827         if not valid-handle(p-key-handle)
     4828            or p-key-handle:type <> "buffer"
     4829         then do:
     4830           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info31 ).
     4831         end.
     4832         if num-entries( p-key-rec, chr(3) ) > 1
     4833           or p-key-rec = ?
     4834           or p-key-rec = "":U
     4835         then do:
     4836           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info31, p-key-rec ).
     4837         end.
     4838       end.
     4839       else do:
     4840         if p-key-rec = ?
     4841           or p-key-rec = "":U
     4842         then do:
     4843           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info31 ).
     4844         end.
     4845       end.
     4846       assign
     4847         vTable = entry( 1 , p-key-rec, chr(3) )
     4848       .
     4849       if p-tt-handle <> ?
     4850         and ( not valid-handle(p-tt-handle)
     4851               or p-tt-handle:type <> "buffer"
     4852             )
     4853       then do:
     4854         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info31, vTable, chr(10) ).
     4855       end.
     4856       if p-tt-handle = ? then do:
     4857         assign
     4858           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     4859         .
     4860         create buffer bh_tbl-name for table v-full-tbl-name .
     4861       end.
     4862       else do:
     4863         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4864       end.
     4865       assign
     4866         v-inform = bh_tbl-name:index-information(1)
     4867         v-ind    = 2
     4868       .
     4869       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4870       on error undo, return error
     4871       :
     4872         assign
     4873           v-inform = bh_tbl-name:index-information( v-ind )
     4874           v-ind    = v-ind + 1
     4875         .
     4876       end.
     4877       if v-inform = ?
     4878         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4879         or entry( 3, v-inform, ",":U ) <> "1":U
     4880       then do:
     4881         delete object bh_tbl-name no-error.
     4882         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info31, vTable ).
     4883       end.
     4884       assign
     4885         v-idx-field-qnty = num-entries( v-inform ) - 4
     4886       .
     4887       if v-idx-field-qnty < 2 then do:
     4888         delete object bh_tbl-name no-error.
     4889         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, vTable ).
     4890       end.
     4891       assign
     4892         o-where     = "where":U
     4893         v-word-link = "":U
     4894         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     4895         v-count-fld = 0
     4896       .
     4897       if i-tablekey ne "" and i-tablekey ne ?
     4898       then do:
     4899         assign
     4900           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     4901         .
     4902         create buffer bh_tbl-key for table v-full-tbl-name .
     4903       end.
     4904       if i-tableSerach ne "" and i-tableSerach ne ?
     4905       then do:
     4906         delete object bh_tbl-name no-error.
     4907         assign
     4908           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     4909         .
     4910         create buffer bh_tbl-name for table v-full-tbl-name .
     4911       end.
     4912       block_where:
     4913       do v-ind = 1 to v-idx-field-qnty by 2
     4914       on error undo, return error
     4915       :
     4916         assign
     4917           v-count-fld = v-count-fld + 1
     4918         .
     4919         if p-key-handle = ?
     4920           and v-count-fld > v-field-num
     4921         then do:
     4922           leave block_where.
     4923         end.
     4924         define variable VfieldKeyTable as handle no-undo.
     4925         assign
     4926           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     4927           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     4928         .
     4929         if     bh_tbl-key ne ?
     4930         then do:
     4931            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     4932            if VfieldKeyTable eq ?
     4933            then next block_where.
     4934         end.
     4935         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     4936         then
     4937            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     4938         else
     4939            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     4940         if p-key-handle = ? then do:
     4941           assign
     4942             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     4943           .
     4944         end.
     4945         else do:
     4946           assign
     4947             fh_key = p-key-handle:buffer-field( v-field-name )
     4948           .
     4949           if fh_key = ?
     4950             or not valid-handle( fh_key )
     4951           then do:
     4952             delete object bh_tbl-name.
     4953             if     bh_tbl-key ne ?
     4954             then
     4955                delete object bh_tbl-key.
     4956             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info31, p-key-handle:name, v-field-name ).
     4957           end.
     4958           assign
     4959             v-field-val = fh_key:buffer-value
     4960           .
     4961         end.
     4962         if fh_search:data-type ="character":U then do:
     4963           assign
     4964             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     4965             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     4966             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     4967             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     4968             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     4969             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     4970             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     4971             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     4972             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     4973             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     4974             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     4975             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     4976             v-field-val = substitute( '"&1"', v-field-val )
     4977           .
     4978         end.
     4979         assign
     4980           o-where = substitute( "&1 &2", o-where, v-field-val )
     4981         .
     4982         if v-word-link = "":U then do:
     4983           assign
     4984             v-word-link = "and":U
     4985           .
     4986         end.
     4987       end.
     4988       delete object bh_tbl-name.
     4989       if     bh_tbl-key ne ?
     4990       then
     4991          delete object bh_tbl-key.
     4992       if p-key-handle = ?
     4993         and v-count-fld <> v-field-num
     4994       then do:
     4995         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info31, vTable ).
     4996       end.
     4997     end.
     4998   end procedure.
     4999   procedure gen-hn-keyr-tab :
     5000     define input  parameter i-tableSerach as character no-undo.
     5001     define input  parameter i-tablekey   as character no-undo.
     5002     define input  parameter p-key-rec    as character no-undo.
     5003     define input  parameter p-key-handle as handle    no-undo .
     5004     define input  parameter p-db-name    as character no-undo .
     5005     define input  parameter p-tt-handle  as handle    no-undo .
     5006     define input  parameter p-stts-lock  as integer   no-undo .
     5007     define output parameter o-hn         as handle    no-undo.
     5008     define variable v-full-tbl-name as character no-undo.
     5009     define variable v-where         as character no-undo.
     5010     define variable bh_tbl-name     as handle    no-undo.
     5011     define variable vTable          as character no-undo.
     5012     do
     5013     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5014     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5015     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5016         run gen-where-keyr-tab(i-tableSerach,
     5017                                i-tablekey,
     5018                                p-key-rec,
     5019                                p-key-handle,
     5020                                p-db-name,
     5021                                p-tt-handle,
     5022                                output v-where).
     5023         if i-tableSerach ne "" and i-tableSerach ne ?
     5024         then do:
     5025            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5026            create buffer bh_tbl-name for table v-full-tbl-name .
     5027         end.
     5028         else do:
     5029            if p-tt-handle = ? then do:
     5030               assign
     5031                  vTable = entry( 1 , p-key-rec, chr(3) )
     5032               .
     5033               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5034               create buffer bh_tbl-name for table v-full-tbl-name .
     5035            end.
     5036            else do:
     5037               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5038            end.
     5039         end.
     5040         if p-tt-handle = ? then do:
     5041            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5042         end.
     5043         else do:
     5044            bh_tbl-name:find-first( v-where ) no-error .
     5045         end.
     5046         o-hn = bh_tbl-name.
     5047      end.
     5048   end procedure.
     5049   procedure gen-hn-keyr :
     5050     define input  parameter p-key-rec    as character no-undo.
     5051     define input  parameter p-key-handle as handle    no-undo .
     5052     define input  parameter p-db-name    as character no-undo .
     5053     define input  parameter p-tt-handle  as handle    no-undo .
     5054     define input  parameter p-stts-lock  as integer   no-undo .
     5055     define output parameter o-hn         as handle    no-undo.
     5056     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5057   end.
     5058   procedure gen-row-keyr :
     5059     define input  parameter p-key-rec    as character no-undo.
     5060     define input  parameter p-key-handle as handle    no-undo .
     5061     define input  parameter p-db-name    as character no-undo .
     5062     define input  parameter p-tt-handle  as handle    no-undo .
     5063     define input  parameter p-stts-lock  as integer   no-undo .
     5064     define output parameter p-tbl-row    as rowid     no-undo.
     5065     define output parameter p-tbl-name   as character no-undo.
     5066     define variable vHn as handle no-undo.
     5067       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5068       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5069       p-tbl-name =  vHn:table.
     5070       delete object vHn no-error.
     5071     if p-tbl-row = ? then do:
     5072       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info31, p-tbl-name, p-key-rec ).
     5073     end.
     5074     else do:
     5075       return.
     5076     end.
     5077   end procedure.
     5078   procedure gen-key-fv :
     5079     define input  parameter p-key-rec    as character no-undo .
     5080     define output parameter p-field-list as character no-undo .
     5081     define output parameter p-value-list as character no-undo.
     5082     do
     5083     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5084     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5085     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5086     :
     5087       define variable v-full-tbl-name  as character no-undo .
     5088       define variable bh_tbl-name      as handle    no-undo .
     5089       define variable v-tbl-name       as character no-undo .
     5090       define variable v-field-num      as integer   no-undo .
     5091       define variable v-count-fld      as integer   no-undo .
     5092       define variable v-inform         as character no-undo .
     5093       define variable v-ind            as integer   no-undo .
     5094       define variable v-idx-field-qnty as integer   no-undo .
     5095       define variable v-delim-key      as character no-undo .
     5096       if p-key-rec = ?
     5097         or p-key-rec = "":U
     5098       then do:
     5099         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info31 ).
     5100       end.
     5101       assign
     5102         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5103         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5104       .
     5105       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5106       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info31 ).
     5107       assign
     5108         v-inform = bh_tbl-name:index-information(1)
     5109         v-ind    = 2
     5110       .
     5111       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5112       on error undo, return error
     5113       :
     5114         assign
     5115           v-inform = bh_tbl-name:index-information( v-ind )
     5116           v-ind    = v-ind + 1
     5117         .
     5118       end.
     5119       if v-inform = ?
     5120         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5121         or entry( 3, v-inform, ",":U ) <> "1":U
     5122       then do:
     5123         delete object bh_tbl-name no-error.
     5124         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, v-tbl-name ).
     5125       end.
     5126       assign
     5127         v-idx-field-qnty = num-entries( v-inform ) - 4
     5128       .
     5129       if v-idx-field-qnty < 2 then do:
     5130         delete object bh_tbl-name no-error.
     5131         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, v-tbl-name ).
     5132       end.
     5133       assign
     5134         p-field-list = "":U
     5135         p-value-list = "":U
     5136         v-delim-key  = "":U
     5137         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5138         v-count-fld  = 0
     5139       .
     5140       block_where:
     5141       do v-ind = 1 to v-idx-field-qnty by 2
     5142       on error undo, return error
     5143       :
     5144         assign
     5145           v-count-fld = v-count-fld + 1
     5146         .
     5147         if v-count-fld > v-field-num then do:
     5148           leave block_where.
     5149         end.
     5150         assign
     5151           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5152           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5153         .
     5154         if v-ind = 1 then do:
     5155           assign
     5156             v-delim-key = chr(3)
     5157           .
     5158         end.
     5159       end.
     5160       delete object bh_tbl-name.
     5161       if v-count-fld <> v-field-num then do:
     5162         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info31, v-tbl-name ).
     5163       end.
     5164     end.
     5165   end procedure.
     5166   procedure gen-key-field :
     5167     define input  parameter p-table      as character no-undo .
     5168     define output parameter p-field-list as character no-undo .
     5169     do
     5170     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5171     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5172     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5173     :
     5174       define variable v-full-tbl-name  as character no-undo .
     5175       define variable bh_tbl-name      as handle    no-undo .
     5176       define variable v-tbl-name       as character no-undo .
     5177       define variable v-field-num      as integer   no-undo .
     5178       define variable v-count-fld      as integer   no-undo .
     5179       define variable v-inform         as character no-undo .
     5180       define variable v-ind            as integer   no-undo .
     5181       define variable v-idx-field-qnty as integer   no-undo .
     5182       define variable v-delim-key      as character no-undo .
     5183       if p-table = ?
     5184         or p-table = "":U
     5185       then do:
     5186         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info31 ).
     5187       end.
     5188       assign
     5189         v-tbl-name      = p-table
     5190         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5191       .
     5192       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5193       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info31 ).
     5194       assign
     5195         v-inform = bh_tbl-name:index-information(1)
     5196         v-ind    = 2
     5197       .
     5198       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5199       on error undo, return error
     5200       :
     5201         assign
     5202           v-inform = bh_tbl-name:index-information( v-ind )
     5203           v-ind    = v-ind + 1
     5204         .
     5205       end.
     5206       if v-inform = ?
     5207         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5208         or entry( 3, v-inform, ",":U ) <> "1":U
     5209       then do:
     5210         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, v-tbl-name ).
     5211       end.
     5212       assign
     5213         v-idx-field-qnty = num-entries( v-inform ) - 4
     5214       .
     5215       if v-idx-field-qnty < 2 then do:
     5216         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, v-tbl-name ).
     5217       end.
     5218       assign
     5219         p-field-list = "":U
     5220         v-delim-key  = "":U
     5221         v-count-fld  = 0
     5222       .
     5223       block_where:
     5224       do v-ind = 1 to v-idx-field-qnty by 2
     5225       on error undo, return error
     5226       :
     5227         assign
     5228           v-count-fld = v-count-fld + 1
     5229         .
     5230         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     5231         if v-ind = 1 then do:
     5232           assign
     5233             v-delim-key = chr(3)
     5234           .
     5235         end.
     5236       end.
     5237       delete object bh_tbl-name.
     5238     end.
     5239   end procedure.
     5240   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5241   PROCEDURE verify-ini-entry:
     5242   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     5243   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     5244   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     5245   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     5246   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     5247   define variable v-mess as character no-undo .
     5248   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     5249   if ini-entry-value = ? and ini-key-name begins "spl"
     5250   then
     5251   get-key-value section ini-section-name key "splall" value ini-entry-value.
     5252   if ini-entry-value = ? and ini-key-name begins "sav"
     5253   then
     5254   get-key-value section ini-section-name key "savall" value ini-entry-value.
     5255   if ini-entry-value = ? then do:
     5256     assign
     5257     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     5258                       , chr(10)
     5259                       , ini-section-name
     5260                       , ini-key-name
     5261                       , error-msg-text).
     5262       if not silence then do:
     5263         message
     5264         v-mess
     5265         view-as alert-box ERROR  .
     5266         return error.
     5267       end.
     5268       else do:
     5269         return error v-mess.
     5270       end.
     5271   end.
     5272   END PROCEDURE.
     5273   PROCEDURE verify-file:
     5274   DEFINE INPUT  PARAMETER filename       as character no-undo.
     5275   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     5276   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     5277   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     5278   file-info:file-name = filename.
     5279   found = NOT (file-info:full-pathname = ?).
     5280   if NOT found  then do:
     5281     if not silence then do:
     5282       message error-msg-text
     5283       view-as alert-box ERROR.
     5284       return error.
     5285     end.
     5286     else return error error-msg-text.
     5287   end.
     5288   END PROCEDURE.
     5289   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5290   define variable vss-include-info34 as character format "X(65)" no-undo
     5291   initial "@(#)$Workfile$ $Revision$".
     5292   procedure xmlchar-test :
     5293   define input parameter p-in-string          as character        no-undo.
     5294   define output parameter p-out-string-enc    as character        no-undo.
     5295   define output parameter p-out-string-dec    as character        no-undo.
     5296   do
     5297   on error undo, return error
     5298   :
     5299          run xmlchar-encode in this-procedure
     5300       (
     5301             input p-in-string
     5302           , output p-out-string-enc
     5303       ).
     5304          run xmlchar-decode in this-procedure
     5305       (
     5306             input p-out-string-enc
     5307           , output p-out-string-dec
     5308       ).
     5309   end.
     5310   end .
     5311   procedure xmlchar-encode :
     5312   define input parameter p-in-string      as character        no-undo.
     5313   define output parameter p-out-string    as character        no-undo.
     5314       define variable v-position      as integer      no-undo.
     5315       define variable v-current-char  as character    no-undo.
     5316   do
     5317   on error undo, return error
     5318   :
     5319       assign
     5320           p-out-string = "":U
     5321       .
     5322       case p-in-string
     5323       :
     5324           when ?
     5325           then do:
     5326               assign
     5327                   p-out-string = "?":U
     5328               .
     5329           end.
     5330           when "?":U
     5331           then do:
     5332               assign
     5333                   p-out-string = "&#63;":U
     5334               .
     5335           end.
     5336           otherwise do:
     5337               do v-position = 1 to length( p-in-string )
     5338               :
     5339                   assign
     5340                       v-current-char = substring( p-in-string, v-position, 1 )
     5341                   .
     5342                   case v-current-char
     5343                   :
     5344                       when "&":U
     5345                       then do:
     5346                           assign
     5347                               p-out-string = p-out-string + "&amp;":U
     5348                           .
     5349                       end.
     5350                       when ">":U
     5351                       then do:
     5352                           assign
     5353                               p-out-string = p-out-string + "&gt;":U
     5354                           .
     5355                       end.
     5356                       when "<":U
     5357                       then do:
     5358                           assign
     5359                               p-out-string = p-out-string + "&lt;":U
     5360                           .
     5361                       end.
     5362                       when "'":U
     5363                       then do:
     5364                           assign
     5365                               p-out-string = p-out-string + "&apos;":U
     5366                           .
     5367                       end.
     5368                       when '"':U
     5369                       then do:
     5370                           assign
     5371                               p-out-string = p-out-string + "&quot;":U
     5372                           .
     5373                       end.
     5374                       when chr(1)
     5375                       then do:
     5376                           assign
     5377                               p-out-string = p-out-string + "":U
     5378                           .
     5379                       end.
     5380                       when chr(2)
     5381                       then do:
     5382                           assign
     5383                               p-out-string = p-out-string + "":U
     5384                           .
     5385                       end.
     5386                       when chr(3)
     5387                       then do:
     5388                           assign
     5389                               p-out-string = p-out-string + "":U
     5390                           .
     5391                       end.
     5392                       when chr(4)
     5393                       then do:
     5394                           assign
     5395                               p-out-string = p-out-string + "":U
     5396                           .
     5397                       end.
     5398                       when chr(5)
     5399                       then do:
     5400                           assign
     5401                               p-out-string = p-out-string + "":U
     5402                           .
     5403                       end.
     5404                       when chr(6)
     5405                       then do:
     5406                           assign
     5407                               p-out-string = p-out-string + "":U
     5408                           .
     5409                       end.
     5410                       when chr(7)
     5411                       then do:
     5412                           assign
     5413                               p-out-string = p-out-string + "":U
     5414                           .
     5415                       end.
     5416                       when chr(8)
     5417                       then do:
     5418                           assign
     5419                               p-out-string = p-out-string + "":U
     5420                           .
     5421                       end.
     5422                       when chr(9)
     5423                       then do:
     5424                           assign
     5425                               p-out-string = p-out-string + "":U
     5426                           .
     5427                       end.
     5428                       when chr(29)
     5429                       then do:
     5430                           assign
     5431                               p-out-string = p-out-string + "":U
     5432                           .
     5433                       end.
     5434                       when chr(10)
     5435                       then do:
     5436                           assign
     5437                               p-out-string = p-out-string + "&#10;":U
     5438                           .
     5439                       end.
     5440                       when chr(13)
     5441                       then do:
     5442                           assign
     5443                               p-out-string = p-out-string + "&#13;":U
     5444                           .
     5445                       end.
     5446                       otherwise do:
     5447                           assign
     5448                               p-out-string = p-out-string + v-current-char
     5449                           .
     5450                       end.
     5451                   end case.
     5452               end.
     5453           end.
     5454       end case.
     5455   end.
     5456   end .
     5457   procedure xmlchar-encode-1c :
     5458   define input parameter p-in-string      as character        no-undo.
     5459   define output parameter p-out-string    as character        no-undo.
     5460       define variable v-position      as integer      no-undo.
     5461       define variable v-current-char  as character    no-undo.
     5462   do
     5463   on error undo, return error
     5464   :
     5465       assign
     5466           p-out-string = "":U
     5467       .
     5468       case p-in-string
     5469       :
     5470           when ?
     5471           then do:
     5472               assign
     5473                   p-out-string = "?":U
     5474               .
     5475           end.
     5476           otherwise do:
     5477               do v-position = 1 to length( p-in-string )
     5478               :
     5479                   assign
     5480                       v-current-char = substring( p-in-string, v-position, 1 )
     5481                   .
     5482                   case v-current-char
     5483                   :
     5484                       when chr(1)
     5485                       then do:
     5486                           assign
     5487                               p-out-string = p-out-string + " ":U
     5488                           .
     5489                       end.
     5490                       when chr(2)
     5491                       then do:
     5492                           assign
     5493                               p-out-string = p-out-string + " ":U
     5494                           .
     5495                       end.
     5496                       when chr(3)
     5497                       then do:
     5498                           assign
     5499                               p-out-string = p-out-string + " ":U
     5500                           .
     5501                       end.
     5502                       when chr(4)
     5503                       then do:
     5504                           assign
     5505                               p-out-string = p-out-string + " ":U
     5506                           .
     5507                       end.
     5508                       when chr(5)
     5509                       then do:
     5510                           assign
     5511                               p-out-string = p-out-string + " ":U
     5512                           .
     5513                       end.
     5514                       when chr(6)
     5515                       then do:
     5516                           assign
     5517                               p-out-string = p-out-string + " ":U
     5518                           .
     5519                       end.
     5520                       when chr(7)
     5521                       then do:
     5522                           assign
     5523                               p-out-string = p-out-string + " ":U
     5524                           .
     5525                       end.
     5526                       when chr(8)
     5527                       then do:
     5528                           assign
     5529                               p-out-string = p-out-string + " ":U
     5530                           .
     5531                       end.
     5532                       when chr(9)
     5533                       then do:
     5534                           assign
     5535                               p-out-string = p-out-string + " ":U
     5536                           .
     5537                       end.
     5538                       when chr(29)
     5539                       then do:
     5540                           assign
     5541                               p-out-string = p-out-string + " ":U
     5542                           .
     5543                       end.
     5544                       when chr(10)
     5545                       then do:
     5546                           assign
     5547                               p-out-string = p-out-string + " ":U
     5548                           .
     5549                       end.
     5550                       when chr(13)
     5551                       then do:
     5552                           assign
     5553                               p-out-string = p-out-string + " ":U
     5554                           .
     5555                       end.
     5556                       otherwise do:
     5557                           assign
     5558                               p-out-string = p-out-string + v-current-char
     5559                           .
     5560                       end.
     5561                   end case.
     5562               end.
     5563           end.
     5564       end case.
     5565   end.
     5566   end .
     5567   procedure xmlchar-decode :
     5568   define input parameter p-in-string      as character        no-undo.
     5569   define output parameter p-out-string    as character        no-undo.
     5570       define variable v-position      as integer      no-undo.
     5571       define variable v-last-position as integer      no-undo.
     5572       define variable v-temp-integer  as integer      no-undo.
     5573       define variable v-current-char  as character    no-undo.
     5574       define variable v-next-char     as character    no-undo.
     5575       define variable v-success       as logical      no-undo.
     5576   do
     5577   on error undo, return error
     5578   :
     5579       assign
     5580           p-out-string = "":U
     5581           v-position   = 0
     5582       .
     5583       replace-cycle:
     5584       do while yes
     5585       on error undo, return error
     5586       :
     5587           assign
     5588               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     5589           .
     5590           if v-last-position <= v-position
     5591           then do:
     5592               if v-position = 0
     5593               then do:
     5594                   assign
     5595                       p-out-string = p-in-string
     5596                   .
     5597               end.
     5598               else do:
     5599                   assign
     5600                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     5601                   .
     5602               end.
     5603               leave replace-cycle.
     5604           end.
     5605           else do:
     5606               assign
     5607                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     5608                   v-position      = v-last-position
     5609                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     5610               .
     5611               if v-current-char = "#":U
     5612               then do:
     5613                   assign
     5614                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     5615                   .
     5616                   if v-last-position > 0
     5617                   then do:
     5618                       run xmlchar-read-integer in this-procedure
     5619                        (
     5620                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     5621                           , output v-temp-integer
     5622                           , output v-success
     5623                       ).
     5624                       if v-success = yes
     5625                       and v-temp-integer >= 1
     5626                       and v-temp-integer <= 255
     5627                       then do:
     5628                           assign
     5629                               p-out-string = p-out-string + chr( v-temp-integer )
     5630                               v-position   = v-last-position + 1
     5631                           .
     5632                       end.
     5633                       else do:
     5634                           assign
     5635                               p-out-string = p-out-string + "&":U
     5636                               v-position   = v-position   + 1
     5637                           .
     5638                       end.
     5639                   end.
     5640                   else do:
     5641                       assign
     5642                           p-out-string = p-out-string + "&":U
     5643                           v-position   = v-position   + 1
     5644                       .
     5645                   end.
     5646               end.
     5647               else do:
     5648                   case substring( p-in-string, v-position + 1, 3 )
     5649                   :
     5650                       when "lt;":U
     5651                       then do:
     5652                           assign
     5653                               p-out-string = p-out-string + "<":U
     5654                               v-position   = v-position   + 3
     5655                           .
     5656                       end.
     5657                       when "gt;":U
     5658                       then do:
     5659                           assign
     5660                               p-out-string = p-out-string + ">":U
     5661                               v-position   = v-position   + 3
     5662                           .
     5663                       end.
     5664                       otherwise do:
     5665                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     5666                           then do:
     5667                               assign
     5668                                   p-out-string = p-out-string + "&":U
     5669                                   v-position   = v-position   + 4
     5670                               .
     5671                           end.
     5672                           else do:
     5673                               case substring( p-in-string, v-position + 1, 5 )
     5674                               :
     5675                                   when "quot;":U
     5676                                   then do:
     5677                                       assign
     5678                                           p-out-string = p-out-string + '"':U
     5679                                           v-position   = v-position   + 5
     5680                                       .
     5681                                   end.
     5682                                   when "apos;":U
     5683                                   then do:
     5684                                       assign
     5685                                           p-out-string = p-out-string + "'":U
     5686                                           v-position   = v-position   + 5
     5687                                       .
     5688                                   end.
     5689                                   otherwise do:
     5690                                       assign
     5691                                           p-out-string = p-out-string + "&":U
     5692                                       .
     5693                                   end.
     5694                               end case.
     5695                           end.
     5696                       end.
     5697                   end case.
     5698               end.
     5699           end.
     5700       end.
     5701   end.
     5702   end .
     5703   procedure xmlchar-read-integer :
     5704   define input parameter p-input-string      as character        no-undo.
     5705   define output parameter p-output-integer   as integer          no-undo.
     5706   define output parameter p-success       as logical          no-undo.
     5707   do
     5708   on error undo, return error
     5709   :
     5710       assign
     5711           p-output-integer = integer( p-input-string )
     5712       no-error.
     5713       if error-status :error
     5714       then do:
     5715           assign
     5716               p-success           = no
     5717               p-output-integer    = 0
     5718           .
     5719       end.
     5720       else do:
     5721           assign
     5722               p-success           = yes
     5723           .
     5724       end.
     5725   end.
     5726   end.
     5727   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     5728   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     5729   define variable mMRCCode  as logical    no-undo.
     5730   define variable mTypeMark as character  no-undo.
     5731   function IS-NeedMark returns logical
     5732   ( input ib-code as integer  ,
     5733     input ib-str as character ):
     5734      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     5735      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     5736                                    and buf_prod-bc-attr.b-str  eq ib-str
     5737                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     5738        no-lock no-error.
     5739      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     5740   end.
     5741   function repTegforDm return char
     5742   (iDM as char ):
     5743       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     5744       define variable vteg as character no-undo.
     5745       define variable oDM as character no-undo.
     5746       define variable vi as integer no-undo.
     5747       oDM = iDm.
     5748       do vi = 1 to num-entries(vTeglist):
     5749          vTeg = entry(vi,vTeglist).
     5750          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     5751       end.
     5752       return oDM.
     5753   end.
     5754   function repSpecSimbforDm return char
     5755   (iDM as char ):
     5756       define variable oDM as character no-undo.
     5757     run
     5758       xmlchar-decode(iDM, output oDM).
     5759     return repTegforDm (oDM).
     5760   end.
     5761   function CheckGtin return logical
     5762   (iGtin as char):
     5763      define variable bar_code as character no-undo.
     5764      define variable vGtin as logical no-undo init "yes".
     5765      if length(iGtin) eq 14
     5766      then do:
     5767         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     5768         run str/chk-sum.p
     5769          (input-output bar_code ) no-error .
     5770         if iGtin ne  bar_code
     5771         then
     5772            vGtin = no.
     5773      end.
     5774      else
     5775         vGtin = no.
     5776      return vgtin.
     5777   end.
     5778   function repSpecSimbforXlm return char
     5779   (iDM as char ):
     5780       iDM = replace(iDM,chr(29),"").
     5781       return iDM.
     5782   end.
     5783   function getGtinByDM return char
     5784   (IDM as char):
     5785      define variable VTXT as char no-undo.
     5786      define variable vGtin as char no-undo.
     5787      vTXt = IdM.
     5788      vGtin = IDM.
     5789      if    length(vtxt) > 14
     5790      then do:
     5791         if   vtxt begins "(01)"
     5792                or vtxt begins "(02)"
     5793         then
     5794            vGtin = substring(vtxt,5,14).
     5795         else if   (vtxt begins "01"
     5796                or vtxt begins "02" )
     5797                and (   (    substring(iDm,17,2) eq "21"
     5798                         and length(vtxt) >= 21)
     5799                     or substring(iDm,17,2) eq "37"
     5800                     or substring(iDm,17,4) eq "(37)" )
     5801         then do:
     5802            vGtin = substring(vtxt,3,14).
     5803            if not checkGtin(vGtin)
     5804            then
     5805               vGtin = substring(vtxt,1,14).
     5806         end.
     5807         else if     length(vtxt) eq 14 + 7 + 4 + 4
     5808             or length(vtxt) eq 14 + 7 + 4
     5809             or length(vtxt) eq 14 + 7
     5810         then
     5811            vGtin = substring(vtxt,1,14).
     5812      end.
     5813      if not checkGtin(vGtin)
     5814      then
     5815         vGtin = "".
     5816      return vgtin.
     5817   end.
     5818   function getGdsCodeByGtin return int
     5819   (iGtin as char):
     5820      define buffer prod-bc  for ub.prod-bc.
     5821      define buffer bar-code for ub.bar-code.
     5822      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     5823      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5824      return if avail bar-code then bar-code.gds-code else ?.
     5825   end.
     5826   function getQntyCodeByGtin return decimal
     5827   (iGtin as char):
     5828      define buffer prod-bc  for ub.prod-bc.
     5829      define buffer bar-code for ub.bar-code.
     5830      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     5831      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5832      return if avail bar-code then bar-code.cli-base-rate else ?.
     5833   end.
     5834   function getGdsCodeByDM return int
     5835   (iDm as char):
     5836      define variable vGtin as char no-undo.
     5837      define buffer prod-bc for ub.prod-bc.
     5838      vGtin  = getGtinByDM (IDM ).
     5839      return getGdsCodeByGtin (vGtin).
     5840   end.
     5841   function ChekTypeMarkByGds return logical
     5842   (iGds-code as integer ):
     5843      define buffer goods-attr for ub.goods-attr.
     5844      find first goods-attr where goods-attr.gds-code   = iGds-code
     5845                              and goods-attr.attr-code  = 'mark-type':U
     5846      no-lock no-error.
     5847      if available goods-attr
     5848      then do:
     5849         mTypeMark = goods-attr.attr-value.
     5850         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     5851           .
     5852      end.
     5853      else
     5854         return no.
     5855   end.
     5856   function ChekTypeMarkByDm return logical
     5857   (iDM as char ):
     5858      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     5859   end.
     5860   function ChekTypeMarkByGtin return logical
     5861   (iGtin as char ):
     5862      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     5863   end.
     5864   function GetNextElement return character
     5865     (input iAllTeg        as logical
     5866     ,output oteg          as character
     5867     ,output otegval       as character
     5868     ,input-output pstr    as character
     5869      ):
     5870        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     5871        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     5872        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     5873        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     5874        define variable vTeg as character no-undo.
     5875        define variable vLength as integer no-undo.
     5876        define variable vi as integer no-undo.
     5877        define variable vj as integer no-undo.
     5878        define buffer code for ub.code.
     5879        find first code where Code.parent eq "MarkType"
     5880                          and Code.CodeValue   eq mTypeMark
     5881                          no-lock no-error.
     5882        if     available code
     5883           and Code.misc1 ne ""
     5884           and Code.misc1 ne ?
     5885        then do:
     5886           integer (Code.misc1) no-error.
     5887           if not error-status:error
     5888           then
     5889             entry (4,vlistleng) = Code.misc1.
     5890        end.
     5891        if iAllTeg
     5892        then
     5893           assign
     5894              vlistElem     = vlistElem    + vlistElemDop
     5895              vlistleng     = vlistleng    + vlistlengDop
     5896           .
     5897        else if mMRCCode
     5898        then
     5899           assign
     5900              vlistElem     = vlistElem    + ",(8005),8005"
     5901              vlistleng     = vlistleng    + ",000006,0006"
     5902           .
     5903       block-elem:
     5904       do vi = 1 to num-entries(vlistElem):
     5905          vTeg = entry(vi,vlistElem).
     5906          if pstr begins vTeg
     5907          then do:
     5908             if    vTeg eq "21"
     5909             then
     5910                vLength = index(pstr,chr(29)) - 2 no-error.
     5911             if vLength  <= 0
     5912             then
     5913                vLength = int(entry(vi,vlistleng)).
     5914             otegval = substring (pstr,length(vteg) + 1, vLength).
     5915             oteg = replace(replace(vteg,")",""),"(","").
     5916             vTeg = vteg + otegval.
     5917             otegval = replace(otegval,chr(29),"").
     5918             oteg = replace(replace(oteg,")",""),"(","").
     5919             pstr = substring (pstr,length(vTeg)+ 1).
     5920             vTeg = replace(vTeg,chr(29),"").
     5921             leave block-elem.
     5922          end.
     5923          else
     5924             vTeg = "".
     5925       end.
     5926       return vteg.
     5927   end.
     5928   function GetCodeIdent return character
     5929   (iDm as char):
     5930      define variable Velement   as character no-undo init "first".
     5931      define variable oCodeIdent as character no-undo.
     5932      define variable vteg as character no-undo.
     5933      define variable vtegval as character no-undo.
     5934      define variable vGtin as character no-undo.
     5935      define buffer marking for ub.marking.
     5936      for first marking no-lock where
     5937                marking.mark eq iDm
     5938            and marking.unit-ext = "LEVEL2"
     5939      :
     5940        return iDm.
     5941      end.
     5942      vGtin  = getGtinByDM (iDm ).
     5943      ChekTypeMarkByDm(idm).
     5944      if iDm begins 'tech_':U
     5945      then
     5946         oCodeIdent = iDm.
     5947      else if length(iDm) < 21
     5948      then do:
     5949         find first marking where marking.mark eq idm
     5950         no-lock no-error.
     5951         oCodeIdent = if available marking then marking.mark else  ?.
     5952      end.
     5953      else if     length(iDm) eq 29
     5954         and not iDm begins "01"
     5955         and not iDm begins "02"
     5956      then
     5957         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5958      else  if     length(iDm) >= 24
     5959               and (  iDm begins "01"
     5960                   or iDm begins "02")
     5961               and  substring(iDm,17,2) ne "21"
     5962      then do:
     5963         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5964                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5965         then
     5966            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5967         else
     5968            oCodeIdent = iDM.
     5969      end.
     5970      else  if     (   length(iDm) eq 25
     5971                    or length(iDm) eq 21)
     5972               and (not iDm begins "01"
     5973               and  not iDm begins "02")
     5974      then
     5975         oCodeIdent = substring(iDm,1,21).
     5976      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5977      then
     5978         oCodeIdent = substring(iDm,1,21).
     5979      else do while Velement ne "" and idm ne "":
     5980         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5981         oCodeIdent = oCodeIdent + Velement.
     5982      end.
     5983      return oCodeIdent.
     5984   end.
     5985   function GetTegCod return character
     5986   (icodeIdent as char, iTeg as char):
     5987      define variable Velement   as character no-undo init "first".
     5988      define variable oTeg as character no-undo init ?.
     5989      define variable vteg as character no-undo.
     5990      define variable vtegval as character no-undo.
     5991      if     ((length(icodeIdent) eq 21
     5992         and not icodeIdent begins "01"
     5993         and not icodeIdent begins "02")
     5994         or
     5995             ( length(icodeIdent) eq 25
     5996               and not icodeIdent begins "01"
     5997               and not icodeIdent begins "02"))
     5998      then do:
     5999         if iTeg eq "01" or iTeg eq "02"
     6000         then
     6001            oTeg = substring(icodeIdent,1,21).
     6002         else  if  iTeg eq "21"
     6003         then
     6004            oTeg = substring(icodeIdent,15,7).
     6005      end.
     6006      else do:
     6007         ChekTypeMarkByDm(icodeIdent).
     6008         block-teg:
     6009            do while Velement ne "" and icodeIdent ne "":
     6010            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     6011            if    Velement begins iTeg
     6012               or Velement begins "(" + iTeg + ")"
     6013            then do:
     6014               oTeg = vtegval.
     6015               leave block-teg.
     6016            end.
     6017         end.
     6018      end.
     6019      return oTeg.
     6020   end.
     6021   function isOAD return logical
     6022   (icodeIdent as character):
     6023      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     6024   end.
     6025   function isMark return logical
     6026   (icodeIdent as character):
     6027      define buffer buf_marking for ub.marking.
     6028      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     6029             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     6030   end.
     6031   function addBracketForCode return character
     6032   (icodeIdent as char):
     6033      define variable Velement   as character no-undo init "first".
     6034      define variable oTeg as character no-undo.
     6035      define variable vteg as character no-undo.
     6036      define variable vtegval as character no-undo.
     6037      define buffer marking for ub.marking.
     6038      find first marking no-lock where
     6039                 marking.mark begins icodeIdent no-error.
     6040      if    not ChekTypeMarkByDm(icodeIdent)
     6041         or length(icodeIdent) le 24
     6042         or (avail marking and marking.unit-ext = "LEVEL2")
     6043      then
     6044         oTeg = icodeIdent.
     6045      else do:
     6046         if (  icodeIdent begins "01"
     6047            or icodeIdent begins "02"
     6048            ) and CheckGtin(substring (icodeIdent,3,14))
     6049            and substring (icodeIdent,17,2) eq "21"
     6050         then do:
     6051            mMRCCode = yes.
     6052            ChekTypeMarkByDm(icodeIdent).
     6053            block-teg:
     6054            do while Velement ne "" and icodeIdent ne "":
     6055               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     6056               if vteg ne ""
     6057               then
     6058                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     6059            end.
     6060            mMRCCode = no.
     6061         end.
     6062         else do:
     6063            oTeg = icodeIdent.
     6064         end.
     6065      end.
     6066      return oTeg.
     6067   end.
     6068   function getlevelByCodId return int
     6069   (iCode as char):
     6070      define variable vLength as int no-undo.
     6071      define variable vLevel  as int no-undo.
     6072      if not ChekTypeMarkByDM (icode) then return ?.
     6073      vLength = length(iCode).
     6074      if    vLength eq 18
     6075         or vLength eq 20
     6076      then
     6077         Vlevel = 4.
     6078      else if vLength eq 21
     6079      then
     6080         Vlevel = 1.
     6081      else if vLength eq 25
     6082      then do:
     6083         if  iCode begins "01"
     6084         then
     6085            Vlevel = 3.
     6086         else
     6087            Vlevel = 1.
     6088      end.
     6089      else if     vLength >= 26
     6090              and vLength <= 46
     6091      then do:
     6092         if    substring(iCode,17,2) eq "11"
     6093            or substring(iCode,17,2) eq "13"
     6094            or (    substring(iCode,17,2) eq "21"
     6095                and vLength >= 33
     6096                and substring(iCode,26,4) ne "8005")
     6097         then
     6098            Vlevel = 4.
     6099         else if    vLength eq 31
     6100                 or vLength eq 38
     6101                 or vLength eq 39
     6102                 or vLength eq 45
     6103         then
     6104            Vlevel = 1.
     6105         else if    vLength eq 35
     6106                 or vLength eq 43
     6107         then
     6108            Vlevel = 3.
     6109         else
     6110            Vlevel = ?.
     6111      end.
     6112      else
     6113         Vlevel = ?.
     6114      return Vlevel.
     6115   end.
     6116   function getLevelMotpBycodid return character
     6117   (iDm as char):
     6118      define variable vLevel as integer no-undo.
     6119      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6120      vLevel = getlevelByCodId(iDm).
     6121      if    vLevel eq ?
     6122         or vLevel < 1
     6123         or vLevel > 6
     6124      then
     6125         return ?.
     6126      else
     6127         return entry(vlevel,vList).
     6128   end.
     6129   function getLevelUTDByLevelMotp return character
     6130   (iUnit as char):
     6131      define variable vLevel as integer no-undo.
     6132      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6133      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6134      vLevel = lookup(iUnit,vListMOTP).
     6135      if    vLevel eq ?
     6136         or vLevel < 1
     6137         or vLevel > 4
     6138      then
     6139         return ?.
     6140      else
     6141         return entry(vlevel,vListutd).
     6142   end.
     6143   function getLevelMotpByDM return character
     6144   (iDm as char):
     6145      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     6146   end.
     6147   function getLevelUTDByCodId return character
     6148   (iDm as char):
     6149      define variable vLevel as integer no-undo.
     6150      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6151      vLevel = getlevelByCodId(iDm).
     6152      if    vLevel eq ?
     6153         or vLevel < 1
     6154         or vLevel > 4
     6155      then
     6156         return ?.
     6157      else
     6158         return entry(vlevel,vList).
     6159   end.
     6160   function getLevelUTDByDM return character
     6161   (iDm as char):
     6162      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     6163   end.
     6164   define variable mNotMarkQnty as logical no-undo.
     6165   function getQntyUTDByCodId return decimal
     6166   (iDM as char):
     6167      define variable vLevel as integer no-undo.
     6168      define variable vList as character no-undo init "1,5,10,500".
     6169      define variable vGtin as character no-undo.
     6170      define variable vqnty as decimal no-undo init ?.
     6171      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     6172      if vqnty eq ?
     6173      then do:
     6174         if not mNotMarkQnty
     6175         then do:
     6176            define buffer marking for ub.marking.
     6177            define variable vCodident as character no-undo.
     6178            vCodident = GetCodeIdent(idm).
     6179            find first marking where marking.mark begins vCodident no-lock no-error.
     6180            if     available marking
     6181               and marking.box-qnty ne ?
     6182            then
     6183               return marking.box-qnty.
     6184         end.
     6185         vGtin = getGtinByDm(iDM).
     6186         if ChekTypeMarkByGtin (vGtin)
     6187         then do:
     6188            vLevel = getlevelByCodId(iDM).
     6189            if     vLevel >= 1
     6190               and vLevel <= 4
     6191            then
     6192               vqnty = int(entry(vlevel,vList)).
     6193         end.
     6194         else
     6195            vqnty = getQntyCodeByGtin(vgtin).
     6196      end.
     6197      return vqnty.
     6198   end.
     6199   function getQntyUTDByDM return decimal
     6200   (iDm as char):
     6201      define variable vDM as character no-undo.
     6202      if     length (iDm) ne 25
     6203         and length (iDm) ne 29
     6204         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     6205      then
     6206         vDM = substring (iDm,1,length (iDm) - 6 ).
     6207      else
     6208         vDM = substring (iDm,1,length (iDm) - 4 ).
     6209      return getQntyUTDByCodId(vDM).
     6210   end.
     6211   function getMRC4 return decimal
     6212   (iMRC as char):
     6213      define variable oMrc     as decimal no-undo init ?.
     6214      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     6215      define variable vi       as integer no-undo.
     6216      define variable vfound   as integer no-undo.
     6217      define variable vposStart   as integer no-undo.
     6218      do:
     6219      OMRc = 0.
     6220      do vi = 1 to 4:
     6221         define variable vsimb as character no-undo.
     6222         vsimb = substring(iMRC,vi,1).
     6223         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     6224         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     6225         if vfound > 0
     6226         then
     6227            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     6228         end.
     6229         OMRc = OMRc / 100.
     6230      end.
     6231      return OMRc.
     6232   end.
     6233   function getMRCByDM return decimal
     6234   (iDm as char):
     6235      define variable vMRC     as character no-undo.
     6236      define variable oMrc     as decimal no-undo init ?.
     6237      define variable Velement as character no-undo init "empty".
     6238      define variable vteg as character no-undo.
     6239      define variable vtegval as character no-undo.
     6240      if    length(idm) eq 14 + 7 + 4 + 4
     6241         or length(idm) eq 14 + 7 + 4
     6242      then do:
     6243         vMRC = substring(idm,22,4).
     6244         omrc = getMRC4(vMRC).
     6245      end.
     6246      else do:
     6247          ChekTypeMarkByDm(iDm).
     6248          block-mrc:
     6249          do while Velement ne "" and idm ne "":
     6250             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     6251             if Velement begins "8005"
     6252             then do:
     6253                vMRC = substring(Velement,5,6).
     6254                leave block-mrc.
     6255             end.
     6256             else if Velement begins "(8005)"
     6257             then do:
     6258                vMRC = substring(Velement,7,6).
     6259                leave block-mrc.
     6260             end.
     6261          end.
     6262          if vMRC ne ""
     6263          then
     6264             OMRc = dec(vmrc) / 100 no-error.
     6265      end.
     6266      return OMRc.
     6267   end.
     6268   function MoveDate return Date
     6269   (idate as date,
     6270    iMonth as int64):
     6271      define variable vMonth   as int64 no-undo.
     6272      define variable vYear    as int64 no-undo.
     6273      define variable vDateNew as date  no-undo.
     6274       define variable vDay     as int64 no-undo.
     6275       vMonth = month(iDate) + iMonth.
     6276       vYear =  year(iDate).
     6277       if vMonth <= 0
     6278       then assign
     6279          vMonth = vMonth + 12
     6280           vYear  = vYear - 1
     6281       .
     6282       else if vMonth > 12
     6283       then assign
     6284          vMonth = vMonth - 12
     6285           vYear  = vYear + 1
     6286       .
     6287       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     6288       do while error-status:error eq yes:
     6289          VDay = vDay + 1.
     6290          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     6291       end.
     6292       if VDay > 0
     6293       then
     6294          vDateNew + 1.
     6295       return vDateNew.
     6296   end.
     6297   procedure checkEMRC:
     6298   define input  parameter iDm as character no-undo.
     6299   define output parameter vok as logical   no-undo init yes.
     6300      define variable v-value-emrc as character no-undo.
     6301      define variable v-type-emrc  as character no-undo.
     6302      define variable vDateIso     as character no-undo.
     6303      define variable vMRC         as decimal no-undo.
     6304      define variable vqnty        as decimal no-undo.
     6305      define variable vPrice       as decimal no-undo.
     6306      define variable vparent      as character no-undo.
     6307      define variable vgds-code    as integer no-undo.
     6308      define buffer code for ub.code.
     6309      vMRC = getMRCByDM(iDm).
     6310      if vMRC > 0
     6311      then do:
     6312         vgds-code = getGdsCodeByDM(iDm).
     6313         vqnty     = getQntyUTDByDM(iDm).
     6314               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6315            (
     6316             input   vgds-code
     6317            ,input   'emrc-type':U
     6318            ,output   v-value-emrc
     6319            ,output   v-type-emrc
     6320          ) no-error.
     6321          if     v-value-emrc ne ""
     6322             and v-value-emrc ne ?
     6323          then do:
     6324             vDateIso = iso-date(today).
     6325             vPrice = vMRC / vqnty.
     6326             vparent ="emc" + chr(4) + v-value-emrc.
     6327             find last code where Code.parent      eq vparent
     6328                              and Code.code        le vDateIso
     6329                              and code.status_  eq 0
     6330             no-lock no-error.
     6331             if not available code or ( vPrice  >= dec(Code.CodeValue))
     6332             then
     6333                vOk = true .
     6334             else do:
     6335                 define variable vText      as character no-undo.
     6336                 define variable vDate      as date no-undo.
     6337                 define variable vDateLast  as character no-undo.
     6338                 define variable vDateFirst as character no-undo.
     6339                 define variable vDate3     as date no-undo.
     6340                 vdate = date(code.misc1).
     6341                 vDateLast = code.misc1.
     6342                 vDate3 = MoveDate(today, - 3 ).
     6343                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     6344                                      string(vDate3  , "99/99/9999"),
     6345                                      string(vDate   , "99/99/9999")
     6346                                      ).
     6347                 vdateIso = iso-date(vdate3).
     6348                 find last code  where Code.parent      eq vparent
     6349                                   and Code.code        le vDateIso
     6350                                   and code.status_  eq 0 no-lock no-error.
     6351                 if available code
     6352                 then
     6353                    vDateIso = code.code.
     6354                 vDateFirst = vDateIso.
     6355                 vDateLast = iso-date(vdate).
     6356                 define variable vGood as logical no-undo.
     6357                 define variable vDateSale as date no-undo.
     6358                 define buffer bcode for code.
     6359                 for last code where Code.parent   eq vparent
     6360                                 and code.status_  eq 0
     6361                                 and code.code     < vDateLast
     6362                                 and code.code     >= vDateFirst
     6363                 no-lock:
     6364                    find first bcode where bCode.parent   eq vparent
     6365                                       and bcode.status_  eq 0
     6366                                       and bcode.code     > code.code no-lock no-error.
     6367                    if available bcode
     6368                    then do:
     6369                       if vPrice < dec(Code.CodeValue)
     6370                       then
     6371                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     6372                                                     chr(10),
     6373                                                     string(    date( code.misc1)       ,"99/99/9999"),
     6374                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     6375                                                     ).
     6376                       else do:
     6377                          vGood = yes.
     6378                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     6379                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     6380                                                     chr(10),
     6381                                                     string(    date( code.misc1)         ,"99/99/9999"),
     6382                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     6383                                                     string(         vDateSale            ,"99/99/9999"),
     6384                                                     string(vDateSale - today)
     6385                                                     ).
     6386                       end.
     6387                    end.
     6388                 end.
     6389                 if vgood
     6390                 then do:
     6391                    define variable choice as integer no-undo .
     6392                    run gbl/d-askw.w (input "Уточнение"
     6393                           ,input  vText
     6394                           ,input "|"
     6395                           ,input "Принять|Вернуть"
     6396                           ,input "Принять данный товар|Вернуть товар постащику"
     6397                           ,input 1
     6398                           ,input 2
     6399                           ,output choice) no-error.
     6400                    vok = choice eq 1.
     6401                 end.
     6402                 else
     6403                    vok =false.
     6404             end.
     6405          end.
     6406      end.
     6407   end.
     6408   function addGs2Mark return character
     6409   (iMark as char):
     6410      define variable vDM   as character no-undo.
     6411      define variable vIdx  as integer   no-undo.
     6412      if index(iMark,chr(29),1) > 0
     6413      then return iMark.
     6414      if substring(iMark,26,4) = "8005" then
     6415      do:
     6416        vIdx = index(iMark,"93",26 + 4 + 5).
     6417        if vIdx > 1 then do:
     6418          vDM = substitute("&1&4&2&4&3",
     6419                           substring(iMark,1,25),
     6420                           substring(iMark,26,vIdx - 25 - 1),
     6421                           substring(iMark,vIdx),
     6422                           chr(29)) no-error.
     6423          vIdx = index(vDm,"240",vIdx + 4).
     6424          if vIdx > 0 then
     6425          do:
     6426            vDM = substitute("&1&3&2",
     6427                             substring(vDm,1,vIdx - 1),
     6428                             substring(vDm,vIdx),
     6429                             chr(29)) no-error.
     6430          end.
     6431        end.
     6432        else
     6433          vDM = substitute("&1&3&2",
     6434                           substring(iMark,1,25),
     6435                           substring(iMark,26),
     6436                           chr(29)) no-error.
     6437      end.
     6438      else if substring(iMark,32,2) = "91" then
     6439      do:
     6440        vIdx = index(iMark,"92",32).
     6441        if vIdx > 1 then
     6442          vDM = substitute("&1&4&2&4&3",
     6443                           substring(iMark,1,31),
     6444                           substring(iMark,32,vIdx - 31 - 1),
     6445                           substring(iMark,vIdx),
     6446                           chr(29)) no-error.
     6447        else
     6448          vDM = substitute("&1&3&2",
     6449                           substring(iMark,1,31),
     6450                           substring(iMark,32),
     6451                           chr(29)) no-error.
     6452      end.
     6453      else if substring(iMark,39,2) = "91" then
     6454      do:
     6455        vIdx = index(iMark,"92",38).
     6456        if vIdx > 1 then
     6457          vDM = substitute("&1&4&2&4&3",
     6458                           substring(iMark,1,38),
     6459                           substring(iMark,39,vIdx - 38 - 1),
     6460                           substring(iMark,vIdx),
     6461                           chr(29)) no-error.
     6462        else
     6463          vDM = substitute("&1&3&2",
     6464                           substring(iMark,1,38),
     6465                           substring(iMark,39),
     6466                           chr(29)) no-error.
     6467      end.
     6468      else if substring(iMark,25,2) = "93" then
     6469      do:
     6470        vIdx = index(iMark,"92",25).
     6471        if vIdx > 1 then
     6472          vDM = substitute("&1&4&2&4&3",
     6473                           substring(iMark,1,24),
     6474                           substring(iMark,25,vIdx - 24 - 1),
     6475                           substring(iMark,vIdx),
     6476                           chr(29)) no-error.
     6477        else
     6478          vIdx = index(iMark,"3103",25).
     6479          if vIdx > 0 then
     6480          vDM = substitute("&1&4&2&4&3",
     6481                           substring(iMark,1,24),
     6482                           substring(iMark,25,vIdx - 24 - 1),
     6483                           substring(iMark,vIdx),
     6484                           chr(29)) no-error.
     6485          else
     6486            vDM = substitute("&1&3&2",
     6487                             substring(iMark,1,24),
     6488                             substring(iMark,25),
     6489                             chr(29)) no-error.
     6490      end.
     6491      else if substring(iMark,32,2) = "93" then
     6492      do:
     6493        vDM = substitute("&1&3&2",
     6494              substring(iMark,1,31),
     6495              substring(iMark,32),
     6496              chr(29)) no-error.
     6497      end.
     6498      return if vDM <> "" then vDm else iMark.
     6499   end.
     6500   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6501   function getattrUtdex returns char
     6502   (idb-num   as integer,
     6503    idoc-id   as integer,
     6504    iattrcode as character,
     6505    iExValue  as character  ):
     6506      define buffer utd-attr for utd-attr.
     6507      find first utd-attr where utd-attr.db-num eq idb-num
     6508                            and utd-attr.doc-id eq idoc-id
     6509                            and utd-attr.attr-code eq iattrcode
     6510      no-lock no-error.
     6511      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     6512   end.
     6513   function getattrUtd returns char
     6514   (idb-num   as integer,
     6515    idoc-id   as integer,
     6516    iattrcode as character ):
     6517     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     6518   end.
     6519   function setattrUtd returns logical
     6520   (idb-num   as integer,
     6521    idoc-id   as integer,
     6522    iattrcode as character,
     6523    iattrval  as character ):
     6524      define buffer utd-attr for utd-attr.
     6525      find first utd-attr where utd-attr.db-num eq idb-num
     6526                            and utd-attr.doc-id eq idoc-id
     6527                            and utd-attr.attr-code eq iattrcode
     6528      no-lock no-error.
     6529      if not available utd-attr
     6530      then do:
     6531         create utd-attr.
     6532         assign
     6533            utd-attr.db-num    = idb-num
     6534            utd-attr.doc-id    = idoc-id
     6535            utd-attr.attr-code = iattrcode
     6536            utd-attr.attr-value = iattrval
     6537         .
     6538      end.
     6539      else do:
     6540         if utd-attr.attr-value ne iattrval
     6541         then do:
     6542            find current utd-attr exclusive-lock no-error.
     6543            if available utd-attr
     6544            then
     6545               utd-attr.attr-value = iattrval.
     6546         end.
     6547      end.
     6548      release utd-attr.
     6549   end.
     6550   function GetAttrUtdlinesEx returns char
     6551   (idb-num   as integer,
     6552    idoc-id   as integer,
     6553    ilinenum  as integer,
     6554    iattrcode as character,
     6555    iExValue  as character  ):
     6556      define buffer utd-lines-attr for utd-lines-attr.
     6557      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     6558                                  and utd-lines-attr.doc-id    eq idoc-id
     6559                                  and utd-lines-attr.lineNum   eq ilineNum
     6560                                  and utd-lines-attr.attr-code eq iattrcode
     6561      no-lock no-error.
     6562      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     6563   end.
     6564   function GetAttrUtdlines returns char
     6565   (idb-num   as integer,
     6566    idoc-id   as integer,
     6567    ilinenum  as integer,
     6568    iattrcode as character ):
     6569      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     6570   end.
     6571   function setattrUtdlines returns logical
     6572   (idb-num   as integer,
     6573    idoc-id   as integer,
     6574    ilinenum  as integer,
     6575    iattrcode as character,
     6576    iattrval  as character ):
     6577      define buffer utd-lines-attr for utd-lines-attr.
     6578      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     6579                                  and utd-lines-attr.doc-id    eq idoc-id
     6580                                  and utd-lines-attr.lineNum   eq ilineNum
     6581                                  and utd-lines-attr.attr-code eq iattrcode
     6582      no-lock no-error.
     6583      if not available utd-lines-attr
     6584      then do:
     6585         if iattrval ne ?
     6586            and iattrval ne ""
     6587         then do:
     6588            create utd-lines-attr.
     6589            assign
     6590               utd-lines-attr.db-num    = idb-num
     6591               utd-lines-attr.doc-id    = idoc-id
     6592               utd-lines-attr.lineNum   = ilineNum
     6593               utd-lines-attr.attr-code = iattrcode
     6594               utd-lines-attr.attr-value = iattrval
     6595            .
     6596         end.
     6597      end.
     6598      else do:
     6599         if utd-lines-attr.attr-value ne iattrval
     6600         then do:
     6601            find current utd-lines-attr exclusive-lock no-error.
     6602            if available utd-lines-attr
     6603            then do:
     6604               if    iattrval eq ?
     6605                  or iattrval eq ""
     6606               then do:
     6607                  delete utd-lines-attr.
     6608               end.
     6609               else do:
     6610                  utd-lines-attr.attr-value = iattrval.
     6611               end.
     6612            end.
     6613         end.
     6614      end.
     6615      release utd-lines-attr.
     6616   end.
     6617   function GetAttrUtdMarkingLinesEx returns char
     6618   (idb-num   as integer,
     6619    idoc-id   as integer,
     6620    ilinenum  as integer,
     6621    imark     as character,
     6622    iattrcode as character,
     6623    iExValue  as character  ):
     6624      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     6625      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     6626                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     6627                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     6628                                          and utd-marking-lines-attr.mark      eq imark
     6629                                          and utd-marking-lines-attr.attr-code eq iattrcode
     6630      no-lock no-error.
     6631      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     6632   end.
     6633   function GetAttrUtdMarkingLines returns char
     6634   (idb-num   as integer,
     6635    idoc-id   as integer,
     6636    ilinenum  as integer,
     6637    imark     as character,
     6638    iattrcode as character ):
     6639      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     6640   end.
     6641   function setattrUtdMarkingLines returns logical
     6642   (idb-num   as integer,
     6643    idoc-id   as integer,
     6644    ilinenum  as integer,
     6645    imark     as character,
     6646    iattrcode as character,
     6647    iattrval  as character ):
     6648      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     6649      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     6650                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     6651                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     6652                                          and utd-marking-lines-attr.mark      eq imark
     6653                                          and utd-marking-lines-attr.attr-code eq iattrcode
     6654      no-lock no-error.
     6655      if not available utd-marking-lines-attr
     6656      then do:
     6657         if iattrval ne ?
     6658            and iattrval ne ""
     6659         then do:
     6660            create utd-marking-lines-attr.
     6661            assign
     6662               utd-marking-lines-attr.db-num     = idb-num
     6663               utd-marking-lines-attr.doc-id     = idoc-id
     6664               utd-marking-lines-attr.lineNum    = ilineNum
     6665               utd-marking-lines-attr.mark       = imark
     6666               utd-marking-lines-attr.attr-code  = iattrcode
     6667               utd-marking-lines-attr.attr-value = iattrval
     6668            .
     6669         end.
     6670      end.
     6671      else do:
     6672         if utd-marking-lines-attr.attr-value ne iattrval
     6673         then do:
     6674            find current utd-marking-lines-attr exclusive-lock no-error.
     6675            if available utd-marking-lines-attr
     6676            then do:
     6677               if    iattrval eq ?
     6678                  or iattrval eq ""
     6679               then do:
     6680                  delete utd-marking-lines-attr.
     6681               end.
     6682               else do:
     6683                  utd-marking-lines-attr.attr-value = iattrval.
     6684               end.
     6685            end.
     6686         end.
     6687      end.
     6688      release utd-marking-lines-attr.
     6689   end.
     6690   def var vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6691   def var vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6692   def var vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6693   function AddUtdErrForTab returns logical
     6694   (idb-num         as integer ,
     6695    idoc-id         as integer ,
     6696    iTab            as character,
     6697    iObj            as handle ,
     6698    iCheckType      as character,
     6699    iCodeErr        as character,
     6700    iCheckObj       as character ):
     6701      define buffer utd-err for utd-err.
     6702      define buffer utd for utd.
     6703      find first utd where utd.db-num     eq idb-num
     6704                       and utd.doc-id     eq idoc-id
     6705                       and utd.Direction  eq 'Outbound'
     6706      no-lock no-error.
     6707      if available utd
     6708      then
     6709         return no.
     6710      define variable vRecKey as character no-undo.
     6711            run gen-key-rec (input iTab,
     6712                             input  iObj,
     6713                             output vRecKey).
     6714      find first utd-err where utd-err.db-num     eq idb-num
     6715                           and utd-err.doc-id     eq idoc-id
     6716                           and utd-err.CheckType  eq iCheckType
     6717                           and utd-err.CodeErr    eq iCodeErr
     6718                           and utd-err.CheckObj   eq iCheckObj
     6719      exclusive-lock no-error.
     6720      if not available utd-err
     6721      then do:
     6722         create utd-err.
     6723         assign
     6724            utd-err.db-num         = idb-num
     6725            utd-err.doc-id         = idoc-id
     6726            utd-err.CheckType      = iCheckType
     6727            utd-err.CodeErr        = iCodeErr
     6728            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6729            utd-err.reckey         = vRecKey
     6730            utd-err.qnty           = 1
     6731         .
     6732      end.
     6733      else
     6734         utd-err.qnty = utd-err.qnty + 1.
     6735      return utd-err.qnty eq 1.
     6736   end.
     6737   function AddUtdErr returns logical
     6738   (idb-num         as integer ,
     6739    idoc-id         as integer ,
     6740    iObj            as handle ,
     6741    iCheckType      as character,
     6742    iCodeErr        as character,
     6743    iCheckObj       as character ):
     6744      AddUtdErrForTab
     6745         (idb-num,
     6746          idoc-id,
     6747          iObj:table,
     6748          iObj,
     6749          iCheckType,
     6750          iCodeErr,
     6751          iCheckObj).
     6752   end.
     6753   function ClearUtdErrTypeCode returns logical
     6754   (idb-num         as integer,
     6755    idoc-id         as integer ,
     6756    iCheckType      as character,
     6757    iCodeErr        as character
     6758    ):
     6759      define buffer utd-err for utd-err.
     6760      if    iCheckType eq "*"
     6761         or iCheckType eq ?
     6762      then do:
     6763         if     iCodeErr ne ?
     6764            and iCodeErr ne "*"
     6765         then
     6766            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6767            view-as alert-box.
     6768         else
     6769         for each utd-err where utd-err.db-num  eq idb-num
     6770                            and utd-err.doc-id  eq idoc-id
     6771         exclusive-lock:
     6772            delete utd-err.
     6773         end.
     6774      end.
     6775      else do:
     6776         if    iCodeErr eq ?
     6777            or iCodeErr eq "*"
     6778         then do:
     6779            for each utd-err where utd-err.db-num     eq idb-num
     6780                               and utd-err.doc-id     eq idoc-id
     6781                               and utd-err.CheckType  eq iCheckType
     6782            exclusive-lock:
     6783               delete utd-err.
     6784            end.
     6785         end.
     6786         else do:
     6787            for each utd-err where utd-err.db-num     eq idb-num
     6788                               and utd-err.doc-id     eq idoc-id
     6789                               and utd-err.CheckType  eq iCheckType
     6790                               and ub.utd-err.CodeErr eq iCodeErr
     6791            exclusive-lock:
     6792               delete utd-err.
     6793            end.
     6794         end.
     6795      end.
     6796   end.
     6797   function ClearUtdErr returns logical
     6798   (idb-num         as integer,
     6799    idoc-id         as integer ,
     6800    iCheckType      as character
     6801    ):
     6802      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6803   end.
     6804   function GetMesError returns character
     6805   (itxt as character,
     6806    iobj as character ):
     6807    define variable vi as integer no-undo.
     6808    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6809       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6810    end.
     6811    return itxt.
     6812   end.
     6813   function GetTextErrorType returns character
     6814   (iCheckType as character,
     6815    iCodeErr   as character,
     6816    iChechObj  as character,
     6817    iType      as character  ):
     6818      define buffer code    for code.
     6819      define variable vError as character no-undo.
     6820      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6821                        and code.code   eq iCodeErr
     6822      no-lock no-error.
     6823      if available code
     6824      then do:
     6825         define variable vType as integer no-undo.
     6826         if code.misc3 eq "error"
     6827         then
     6828            vType = 0.
     6829         else if code.misc3 eq "warning"
     6830         then
     6831            vType = 1.
     6832         else if code.misc3 eq "Hiden"
     6833         then
     6834            vType = 2.
     6835         else
     6836            vtype = int(code.misc3) no-error.
     6837         case itype:
     6838            when "error"
     6839            then do:
     6840               if vtype eq 0
     6841               then
     6842                  vError = GetMesError(Code.CodeValue,iChechObj).
     6843            end.
     6844            when "warning"
     6845            then do:
     6846               if vtype <= 1
     6847               then
     6848                  vError = GetMesError(Code.CodeValue,iChechObj).
     6849            end.
     6850            otherwise do:
     6851               vError = GetMesError(Code.CodeValue,iChechObj).
     6852            end.
     6853         end.
     6854      end.
     6855      else
     6856         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6857      return vError.
     6858   end.
     6859   function GetTypeError returns integer
     6860   (iCheckType as character,
     6861    iCodeErr   as character):
     6862      define buffer code    for code.
     6863      define variable vType as integer no-undo.
     6864      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6865                        and code.code   eq iCodeErr
     6866      no-lock no-error.
     6867      if     not available code
     6868         and code.misc3 eq "error"
     6869      then
     6870         vType = 0.
     6871      else if code.misc3 eq "warning"
     6872      then
     6873         vType = 1.
     6874      else if code.misc3 eq "Hiden"
     6875      then
     6876         vType = 2.
     6877      else
     6878         vtype = int(code.misc3) no-error.
     6879      return vtype.
     6880   end.
     6881   function GetTextError returns character
     6882   (iCheckType as character,
     6883    iCodeErr   as character,
     6884    iChechObj  as character ):
     6885      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6886   end.
     6887   function GetErrForUtdStr returns character
     6888   (idb-num     as integer ,
     6889    idoc-id     as integer ,
     6890    iCheckType  as character
     6891    ):
     6892      define buffer utd-err for utd-err.
     6893      define buffer code    for code.
     6894      define variable vHQry as handle no-undo.
     6895      define variable vError as longchar no-undo.
     6896      define variable vErrorOne as longchar  no-undo.
     6897      define variable oError as character no-undo.
     6898      create query vHQry.
     6899      vHQry:set-buffers(buffer utd-err:handle).
     6900      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6901                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6902                               + if    iCheckType eq "*"
     6903                                    or iCheckType eq ?
     6904                                 then       ""
     6905                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6906      vHQry:query-open().
     6907      vHQry:get-first().
     6908      QRY-BLOCK:
     6909      repeat while not vHQry:query-off-end:
     6910         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6911         if     vErrorOne ne ""
     6912            and vErrorOne ne ?
     6913         then
     6914            vError = vError + ", " + vErrorOne.
     6915         vHQry:get-next().
     6916      end.
     6917      oError = substring(vError,3,4002).
     6918      return oError.
     6919   end.
     6920   function GetErrJsonForUtd returns character
     6921   (idb-num         as integer ,
     6922    idoc-id         as integer ,
     6923    iCheckType      as character
     6924    ):
     6925      define buffer utd-err for utd-err.
     6926      define variable vHQry as handle no-undo.
     6927      define variable vError as longchar no-undo.
     6928      define variable oError as character no-undo.
     6929      create query vHQry.
     6930      define variable vi as integer no-undo.
     6931      vHQry:set-buffers(buffer utd-err:handle).
     6932      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6933                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6934                               + if    iCheckType eq "*"
     6935                                    or iCheckType eq ?
     6936                                 then       ""
     6937                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6938      vHQry:query-open().
     6939      vHQry:get-first().
     6940      QRY-BLOCK:
     6941      repeat while not vHQry:query-off-end:
     6942         define variable vErrorOne as character no-undo.
     6943         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6944         if     vErrorOne ne ?
     6945            and vErrorOne ne ""
     6946         then do:
     6947            vi = vi + 1.
     6948            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6949                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6950                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6951         end.
     6952         vHQry:get-next().
     6953      end.
     6954      for first utd where utd.db-num eq idb-num
     6955                      and utd.doc-id eq idoc-id
     6956                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6957      no-lock,
     6958         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6959                                  and utd-marking-lines.doc-id eq idoc-id
     6960                                  and utd-marking-lines.doc-level eq 1
     6961      no-lock,
     6962         first marking where marking.mark eq utd-marking-lines.mark
     6963                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6964      no-lock:
     6965         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6966         if     vErrorOne ne ?
     6967            and vErrorOne ne ""
     6968         then do:
     6969            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6970                            + '","ОбъектОш":"' + marking.mark
     6971                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6972         end.
     6973      end.
     6974      if vError ne ""
     6975      then
     6976         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6977      return oError.
     6978   end.
     6979   function GetErrJsonForUtdReturn returns character
     6980   (idb-num         as integer ,
     6981    idoc-id         as integer ,
     6982    iCheckType      as character
     6983    ):
     6984      define buffer utd-err for utd-err.
     6985      define variable vHQry as handle no-undo.
     6986      define variable vError as longchar no-undo.
     6987      define variable oError as character no-undo.
     6988      define variable vi as integer no-undo.
     6989      create query vHQry.
     6990      vHQry:set-buffers(buffer utd-err:handle).
     6991      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6992                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6993                               + if    iCheckType eq "*"
     6994                                    or iCheckType eq ?
     6995                                 then       ""
     6996                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6997      vHQry:query-open().
     6998      vHQry:get-first().
     6999      QRY-BLOCK:
     7000      repeat while not vHQry:query-off-end:
     7001         define variable vErrorOne as character no-undo.
     7002         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     7003         if     vErrorOne ne ?
     7004            and vErrorOne ne ""
     7005         then do:
     7006            vi = vi + 1.
     7007            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     7008                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     7009                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     7010         end.
     7011         vHQry:get-next().
     7012      end.
     7013      if vError ne ""
     7014      then
     7015         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     7016      return oError.
     7017   end.
     7018   function GetCodeTextError returns character
     7019   (iCheckType as character,
     7020    iCodeErr   as character,
     7021    iChechObj  as character,
     7022    output oCode as character,
     7023    output ovalue as character ):
     7024      define buffer code    for code.
     7025      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     7026                        and code.code   eq iCodeErr
     7027      no-lock no-error.
     7028      if     available code
     7029      then do:
     7030         define variable vi as integer no-undo init ?.
     7031         vi = int(Code.misc3) no-error.
     7032         if    code.misc3 ne "error"
     7033            and vi ne 0
     7034         then
     7035            oCode = ?.
     7036         else if     Code.misc1 ne ?
     7037                 and Code.misc1 ne ""
     7038         then
     7039            assign
     7040               oCode  = GetMesError(Code.misc1,iChechObj)
     7041               ovalue = GetMesError(Code.misc2,iChechObj)
     7042            .
     7043      end.
     7044      return if oCode eq ""
     7045             then ""
     7046             else (oCode + "_" + ovalue).
     7047   end.
     7048   define temp-table TT-err no-undo
     7049     field code_ as character
     7050     field text_ as character
     7051   index code_ code_.
     7052   function GetErrTxtForUtd returns character
     7053   (idb-num         as integer ,
     7054    idoc-id         as integer ,
     7055    iCheckType      as character
     7056    ):
     7057      define buffer utd-err for utd-err.
     7058      define variable vHQry as handle no-undo.
     7059      define variable oError as character no-undo.
     7060      create query vHQry.
     7061      define variable vi as integer no-undo.
     7062      for each tt-err :
     7063         delete tt-err.
     7064      end.
     7065      vHQry:set-buffers(buffer utd-err:handle).
     7066      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     7067                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     7068                               + if    iCheckType eq "*"
     7069                                    or iCheckType eq ?
     7070                                 then       ""
     7071                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     7072      vHQry:query-open().
     7073      vHQry:get-first().
     7074      define variable vcode as character no-undo.
     7075      define variable vvalue as character no-undo.
     7076      QRY-BLOCK:
     7077      repeat while not vHQry:query-off-end:
     7078         vi = vi + 1.
     7079         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     7080         if vcode ne ?
     7081         then do:
     7082            find first tt-err where tt-err.code eq vcode
     7083            no-error.
     7084            if not available tt-err
     7085            then do:
     7086               create tt-err.
     7087               assign
     7088                  tt-err.code_ = vcode
     7089                  tt-err.text_ = vvalue
     7090               .
     7091            end.
     7092            else
     7093               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     7094         end.
     7095         vHQry:get-next().
     7096      end.
     7097     find first utd where utd.db-num eq idb-num
     7098                         and utd.doc-id eq idoc-id
     7099         no-lock.
     7100      define buffer cancel_utd-lines for utd-lines.
     7101      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     7102                                  and cancel_utd-lines.doc-id eq idoc-id
     7103      no-lock:
     7104         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     7105         then do:
     7106            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     7107                                        and utd-marking-lines.doc-id eq idoc-id
     7108                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     7109            no-lock,
     7110               first marking where marking.mark eq utd-marking-lines.mark
     7111                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     7112            no-lock:
     7113               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     7114               find first tt-err where tt-err.code eq vcode
     7115               no-error.
     7116               if not available tt-err
     7117               then do:
     7118                  create tt-err.
     7119                  assign
     7120                     tt-err.code_ = vcode
     7121                     tt-err.text_ = vvalue
     7122                  .
     7123               end.
     7124               else
     7125                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     7126            end.
     7127         end.
     7128         else do:
     7129            define variable vqnty as decimal no-undo.
     7130            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     7131            if vqnty eq ? then vqnty = 0.
     7132            if vqnty ne cancel_utd-lines.Quantity
     7133            then do:
     7134               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     7135               find first tt-err where tt-err.code eq vcode
     7136               no-error.
     7137               if not available tt-err
     7138               then do:
     7139                  create tt-err.
     7140                  assign
     7141                     tt-err.code_ = vcode
     7142                     tt-err.text_ = vvalue
     7143                  .
     7144               end.
     7145               else
     7146                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     7147            end.
     7148         end.
     7149      end.
     7150      for each tt-err:
     7151         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     7152      end.
     7153      return oError.
     7154   end.
     7155   define variable mFormatErr as character no-undo init "text".
     7156   function GetErrForUtd returns character
     7157   (idb-num         as integer ,
     7158    idoc-id         as integer ,
     7159    iType           as character
     7160    ):
     7161      if mFormatErr eq "text"
     7162      then
     7163         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     7164      else do:
     7165         if itype eq "return"
     7166         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     7167         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     7168      end.
     7169   end.
     7170   function GetErrComText returns longchar
     7171   (icomment as character,
     7172    itext    as longchar ):
     7173       define variable vText as longchar no-undo.
     7174      if mFormatErr eq "text"
     7175      then do:
     7176         if icomment ne ""
     7177         then
     7178            icomment = substitute("comment:|&1|",icomment).
     7179         vText = icomment + itext.
     7180      end.
     7181      else do:
     7182         icomment = if icomment begins  '"'
     7183                    then icomment
     7184                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     7185         vText = icomment + "," + itext.
     7186         vText = "~{" + trim(vText,",") + "~}".
     7187      end.
     7188      return vText.
     7189   end.
     7190   function CheckTypeForMarkLineType returns logical
     7191   (iObj            as handle,
     7192    iCheckType      as character,
     7193    iCodeErr        as character ,
     7194    iTypeErr        as character ):
     7195      define variable vRecKey-markLine as character no-undo.
     7196      define variable vGoodMark        as logical no-undo.
     7197      define variable vdb-num          as integer no-undo.
     7198      define variable vdoc-id          as integer no-undo.
     7199      define variable vlinenum         as integer no-undo.
     7200      define variable vErrorOne as character no-undo.
     7201      define buffer buf_utd-err for utd-err.
     7202      run gen-key-rec (input "utd-marking-lines",
     7203                       input  iObj,
     7204                       output vRecKey-markLine).
     7205      vGoodMark = yes.
     7206      vdb-num = iObj::db-num.
     7207      vdoc-id = iObj::doc-id.
     7208      vlinenum = iObj::linenum.
     7209      block-mark-err:
     7210      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7211                               and buf_utd-err.db-num = vdb-num
     7212                               and buf_utd-err.reckey = vRecKey-markLine
     7213                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     7214                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     7215      no-lock:
     7216         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     7217         if     vErrorOne ne ?
     7218            and vErrorOne ne ""
     7219         then do:
     7220            vGoodMark = no.
     7221            leave block-mark-err.
     7222         end.
     7223      end.
     7224      return not vGoodMark.
     7225   end.
     7226   function CheckErrForMarkLineType returns logical
     7227   (iObj            as handle,
     7228    iType           as character  ):
     7229      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     7230   end.
     7231   function CheckErrForMarkLine returns logical
     7232   (iObj            as handle):
     7233      return CheckErrForMarkLineType(iObj,"*").
     7234   end.
     7235   function CheckErrForLineTypeCode returns logical
     7236   (iObj                 as handle,
     7237    iCheckType           as character,
     7238    iCodeErr             as character,
     7239    iTypeErr             as character,
     7240    iOneErr              as logical):
     7241      define variable vRecKey-line     as character no-undo.
     7242      define buffer buf_utd-err for utd-err.
     7243      define variable vUtdlineError as logical no-undo.
     7244      define variable vErrorOne as character no-undo.
     7245            run gen-key-rec (input "utd-lines",
     7246                             input  iObj,
     7247                             output vRecKey-line).
     7248         define variable vdb-num as integer no-undo.
     7249         define variable vdoc-id as integer no-undo.
     7250         define variable vlinenum as integer no-undo.
     7251         vdb-num = iObj::db-num.
     7252         vdoc-id = iObj::doc-id.
     7253         vlinenum = iObj::linenum.
     7254         block-err:
     7255         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7256                                  and buf_utd-err.db-num = vdb-num
     7257                                  and buf_utd-err.reckey = vRecKey-line
     7258                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     7259                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     7260         no-lock:
     7261            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     7262            if     vErrorOne ne ?
     7263               and vErrorOne ne ""
     7264            then do:
     7265               vUtdlineError = yes.
     7266               leave block-err.
     7267            end.
     7268         end.
     7269         if  not vUtdlineError
     7270         then do:
     7271            define variable vGoodMark as logical no-undo.
     7272            vGoodMark = yes.
     7273            block-line-err:
     7274            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     7275                                         and utd-marking-lines.doc-id  eq vdoc-id
     7276                                         and utd-marking-lines.LineNum eq vLineNum
     7277            no-lock:
     7278               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     7279               if     vGoodMark
     7280                  and iOneErr eq no
     7281               then
     7282                  leave block-line-err.
     7283               if     iOneErr = yes
     7284                  and not vGoodMark
     7285               then
     7286                  leave block-line-err.
     7287            end.
     7288            vUtdlineError = not vGoodMark.
     7289         end.
     7290      return vUtdlineError.
     7291   end.
     7292   function getErrForLineType returns character
     7293   (iObj            as handle,
     7294    iType           as character  ):
     7295      define variable vRecKey-line     as character no-undo.
     7296      define buffer buf_utd-err for utd-err.
     7297      define variable vUtdlineError as logical no-undo.
     7298      define variable vErrorOne as character no-undo.
     7299      define variable oError as character no-undo.
     7300            run gen-key-rec (input "utd-lines",
     7301                             input  iObj,
     7302                             output vRecKey-line).
     7303         define variable vdb-num as integer no-undo.
     7304         define variable vdoc-id as integer no-undo.
     7305         define variable vlinenum as integer no-undo.
     7306         vdb-num = iObj::db-num.
     7307         vdoc-id = iObj::doc-id.
     7308         vlinenum = iObj::linenum.
     7309         block-err:
     7310         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7311                                  and buf_utd-err.db-num = vdb-num
     7312                                  and buf_utd-err.reckey = vRecKey-line
     7313                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     7314         no-lock:
     7315            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     7316            if     vErrorOne ne ?
     7317               and vErrorOne ne ""
     7318            then do:
     7319               oError = oError + vErrorOne + " ".
     7320            end.
     7321         end.
     7322      return oError.
     7323   end.
     7324   function CheckErrForLineType returns logical
     7325   (iObj            as handle,
     7326    iType           as character  ):
     7327       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     7328   end.
     7329   function CheckErrForLine returns logical
     7330   (iObj            as handle):
     7331      return CheckErrForLineType(iobj,"*").
     7332   end.
     7333   function CheckErrForUtd returns logical
     7334   (idb-num         as integer ,
     7335    idoc-id         as integer ):
     7336      for each utd-lines where utd-lines.db-num eq idb-num
     7337                           and utd-lines.doc-id eq idoc-id
     7338      no-lock :
     7339         if not CheckErrForLine (buffer ub.utd-lines:handle)
     7340         then
     7341            return no.
     7342      end.
     7343      return yes.
     7344   end.
     7345   function CheckMarkUtd-28rel return logical
     7346    (input idb-num as integer,
     7347    input idoc-id as integer):
     7348    define buffer utd                   for utd.
     7349    define buffer utd-lines             for utd-lines.
     7350    define buffer utd-marking-lines     for utd-marking-lines.
     7351    define variable v-par-type as character no-undo.
     7352    define variable vgdsNoMark as logical no-undo.
     7353    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7354      define variable v-par-val  as character no-undo.
     7355      find first utd where utd.db-num eq idb-num
     7356                       and utd.doc-id eq idoc-id
     7357      no-lock no-error.
     7358      if available utd
     7359      then do:
     7360         if     utd.obj-code ne ?
     7361            and utd.obj-type ne ?
     7362         then do:
     7363            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     7364            Block-utd-lines:
     7365            for each utd-lines where utd-lines.db-num eq idb-num
     7366                                 and utd-lines.doc-id eq idoc-id
     7367            no-lock:
     7368               if     utd-lines.gds-code ne ?
     7369                  and utd-lines.gds-code ne 0
     7370               then do:
     7371                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7372                       ( utd-lines.gds-code,
     7373                         'mark-type':U,
     7374                          output v-par-val,
     7375                          output v-par-type
     7376                       ).
     7377                  if     EDOParSec:IsEdo
     7378                     and EDOParSec:GetIsEDOForType(v-par-val)
     7379                  then do:
     7380                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     7381                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     7382                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     7383                                                    and length(utd-marking-lines.mark) > 13
     7384                     no-lock no-error.
     7385                     if     avail utd-marking-lines
     7386                        and not CheckErrForLine(buffer utd-lines:handle)
     7387                     then
     7388                        leave Block-utd-lines.
     7389                  end.
     7390                  else
     7391                     vgdsNoMark = yes.
     7392               end.
     7393            end.
     7394            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     7395            if vgdsNoMark then return available utd-lines . else return yes .
     7396         end.
     7397      end.
     7398      return yes.
     7399   end.
     7400   function CheckMarkUtd return logical
     7401    (input idb-num  as integer,
     7402     input idoc-id  as integer):
     7403     define buffer utd-lines             for ub.utd-lines.
     7404     block-line:
     7405     for each utd-lines where utd-lines.db-num eq idb-num
     7406                          and utd-lines.doc-id eq idoc-id
     7407     no-lock:
     7408        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     7409        then
     7410           leave block-line.
     7411     end.
     7412     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     7413     return available utd-lines.
     7414   end.
     7415   function CheckNotMarkUtd return logical
     7416    (input idb-num  as integer,
     7417     input idoc-id  as integer):
     7418     define buffer utd-lines             for ub.utd-lines.
     7419     for each utd-lines where utd-lines.db-num eq idb-num
     7420                          and utd-lines.doc-id eq idoc-id
     7421     no-lock:
     7422        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     7423        then
     7424           return yes.
     7425     end.
     7426     return no.
     7427   end.
     7428   function CheckMarkUtdLine return logical
     7429    (input idb-num  as integer,
     7430     input idoc-id  as integer,
     7431     input iLineNum as integer):
     7432    define buffer utd                   for utd.
     7433    define buffer utd-lines             for utd-lines.
     7434    define buffer utd-marking-lines     for utd-marking-lines.
     7435    define variable v-par-type as character no-undo.
     7436    define variable vMarking        as logical no-undo.
     7437    define variable vArtic          as logical no-undo.
     7438    define variable vTransitional   as logical no-undo.
     7439    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7440      define variable v-par-val  as character no-undo.
     7441      find first utd where utd.db-num eq idb-num
     7442                       and utd.doc-id eq idoc-id
     7443      no-lock no-error.
     7444      if available utd
     7445      then do:
     7446         if     utd.obj-code ne ?
     7447            and utd.obj-type ne ?
     7448         then do:
     7449            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     7450            Block-utd-lines:
     7451            for each utd-lines where utd-lines.db-num   eq idb-num
     7452                                 and utd-lines.doc-id   eq idoc-id
     7453                                 and utd-lines.LineNum  eq iLineNum
     7454            no-lock:
     7455               if     utd-lines.gds-code ne ?
     7456                  and utd-lines.gds-code ne 0
     7457               then do:
     7458                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7459                       ( utd-lines.gds-code,
     7460                         'mark-type':U,
     7461                          output v-par-val,
     7462                          output v-par-type
     7463                       ).
     7464                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     7465                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     7466                  if vMarking
     7467                  then do:
     7468                     block-marking:
     7469                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7470                                                    and utd-marking-lines.doc-id   eq idoc-id
     7471                                                    and utd-marking-lines.LineNum  eq iLineNum
     7472                                                    and length(utd-marking-lines.mark) > 13
     7473                     no-lock:
     7474                        if isOAD(utd-marking-lines.mark)
     7475                        then do:
     7476                           assign
     7477                              vArtic   = yes
     7478                              vMarking = no
     7479                           .
     7480                           leave block-marking.
     7481                        end.
     7482                     end.
     7483                  end.
     7484                  if vArtic
     7485                  then do:
     7486                     block-artic:
     7487                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7488                                                    and utd-marking-lines.doc-id   eq idoc-id
     7489                                                    and utd-marking-lines.LineNum  eq iLineNum
     7490                                                    and length(utd-marking-lines.mark) > 13
     7491                     no-lock:
     7492                        if isMark(utd-marking-lines.mark)
     7493                        then do:
     7494                           assign
     7495                              vArtic   = no
     7496                              vMarking = yes
     7497                           .
     7498                           leave block-artic.
     7499                        end.
     7500                     end.
     7501                  end.
     7502                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     7503                  if vTransitional
     7504                  then do:
     7505                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7506                                                    and utd-marking-lines.doc-id   eq idoc-id
     7507                                                    and utd-marking-lines.LineNum  eq iLineNum
     7508                                                    and length(utd-marking-lines.mark) > 13
     7509                     no-lock no-error.
     7510                     if not available utd-marking-lines
     7511                     then assign
     7512                        vMarking = no
     7513                        vArtic   = no
     7514                     .
     7515                  end.
     7516               end.
     7517               else
     7518                  assign
     7519                     vMarking      = yes
     7520                     vArtic        = no
     7521                     vTransitional = no
     7522                  .
     7523               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     7524               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     7525               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     7526            end.
     7527         end.
     7528      end.
     7529      return vMarking or vArtic.
     7530   end.
     7531   function getMarkUtdLine return logical
     7532    (input  idb-num  as integer,
     7533     input  idoc-id  as integer,
     7534     input  iLineNum as integer,
     7535     output oMarking        as logical,
     7536     output oArtic          as logical,
     7537     output oTransitional   as logical):
     7538     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     7539     oArtic        = not oMarking
     7540            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     7541     oTransitional = (oMarking or oArtic)
     7542            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     7543   end.
     7544   function CheckMarking return logical
     7545    (input idb-num as integer,
     7546    input idoc-id as integer,
     7547    input iTypeErr as character ):
     7548     define variable vMarkutd as logical no-undo.
     7549     define variable vCrErr   as logical no-undo.
     7550     define buffer utd-lines         for utd-lines.
     7551     define buffer utd-marking-lines for utd-marking-lines.
     7552     define buffer marking           for marking.
     7553     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     7554      block-line:
     7555      for each utd-lines where utd-lines.db-num eq idb-num
     7556                           and utd-lines.doc-id eq idoc-id
     7557      no-lock:
     7558         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     7559         then do:
     7560            for each utd-marking-lines
     7561                     where utd-marking-lines.db-num  = utd-lines.db-num
     7562                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     7563                       and utd-marking-lines.LineNum = utd-lines.LineNum
     7564            no-lock:
     7565               if isMark(utd-marking-lines.mark)
     7566               then do:
     7567                  find first marking where marking.mark eq utd-marking-lines.mark
     7568                  no-lock no-error.
     7569                  if not available marking
     7570                  then do:
     7571                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     7572                     vCrErr = yes.
     7573                     next block-line.
     7574                  end.
     7575               end.
     7576            end.
     7577         end.
     7578      end.
     7579      return vCrErr.
     7580   end.
     7581   function CheckMarkForType return logical
     7582    (input idb-num   as integer,
     7583     input idoc-id   as integer):
     7584      define variable vMarking        as logical no-undo.
     7585      define variable vArtic          as logical no-undo.
     7586      define variable vTransitional   as logical no-undo.
     7587      define buffer utd-lines         for utd-lines.
     7588      define buffer utd-marking-lines for utd-marking-lines.
     7589      block-line:
     7590      for each utd-lines where utd-lines.db-num eq idb-num
     7591                           and utd-lines.doc-id eq idoc-id
     7592      no-lock:
     7593         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     7594                          output vMarking         , output vArtic          , output vTransitional).
     7595         for each utd-marking-lines
     7596                     where utd-marking-lines.db-num  = utd-lines.db-num
     7597                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     7598                       and utd-marking-lines.LineNum = utd-lines.LineNum
     7599         no-lock:
     7600            if length(utd-marking-lines.mark) < 14
     7601            then do:
     7602               if (vMarking or vArtic) and not vTransitional
     7603               then
     7604                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     7605            end.
     7606            else if not isMark(utd-marking-lines.mark)
     7607            then do:
     7608               if vMarking
     7609               then
     7610                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     7611            end.
     7612            else do:
     7613            end.
     7614         end.
     7615      end.
     7616   end.
     7617   function WeighedProd return logical
     7618      ( input p-gds-code as integer) :
     7619      define variable v-par-val  as character no-undo.
     7620      define variable v-par-type as character no-undo.
     7621              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7622               ( p-gds-code,
     7623                 'weighed-gds':U,
     7624                  output v-par-val,
     7625                  output v-par-type
     7626               ).
     7627      return logical(v-par-val).
     7628   end.
     7629   function WghProdVariable return logical
     7630       (input p-obj-type as char,
     7631        input p-obj-code as integer,
     7632        input p-gds-code as integer) :
     7633      define variable v-wgh-val  as character no-undo.
     7634      define variable v-par-val  as character no-undo.
     7635      define variable v-par-type as character no-undo.
     7636      define variable vMarking        as logical no-undo.
     7637      define variable vArtic          as logical no-undo.
     7638      define variable vTransitional   as logical no-undo.
     7639      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7640         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7641           ( p-gds-code,
     7642             'weighed-gds':U,
     7643              output v-wgh-val,
     7644              output v-par-type
     7645           ).
     7646       if logical(v-wgh-val) = yes then do:
     7647           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7648               ( p-gds-code,
     7649                 'mark-type':U,
     7650                  output v-par-val,
     7651                  output v-par-type
     7652               ).
     7653           if v-par-val <> "" then do:
     7654               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     7655               assign
     7656                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     7657                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     7658                  .
     7659           end.
     7660      end.
     7661      if v-wgh-val > "" and (vMarking or vArtic)
     7662      then return yes.
     7663      else return no.
     7664   end.
     7665   function MarkWeight return decimal
     7666      ( input p-mark as character) :
     7667      define buffer  buf_marking-attr for  ub.marking-attr.
     7668      define variable vMarkWeight as decimal no-undo.
     7669      vMarkWeight = 0.
     7670      if p-mark <> "" and p-mark <> ?
     7671      then do:
     7672          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     7673                                        and buf_marking-attr.attr-code eq "weight"
     7674             no-lock no-error.
     7675          if not available buf_marking-attr
     7676          then do :
     7677            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     7678                                          and buf_marking-attr.attr-code eq "weight"
     7679               no-lock no-error.
     7680          end .
     7681          if avail buf_marking-attr
     7682          then vMarkWeight = dec(buf_marking-attr.attr-value).
     7683      end.
     7684      return vMarkWeight.
     7685   end.
