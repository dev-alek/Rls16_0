    10638                   undo, return error .
    10639                 end .
    10640                 find first buf_marking-lines no-lock where buf_marking-lines.mark = buf_marking.mark-parent
    10641                                                        and buf_marking-lines.out-code = ub.gds-dtl.doc-code
    10642                                                        no-error .
    10643                 if not available buf_marking-lines
    10644                 then do :
    10645                   ub.gds-dtl.doc-qnty:screen-value  = string(ub.gds-dtl.doc-qnty + v-mark-weight).
    10646                 end .
    10647               end .
    10648               else do :
    10649                 case buf_marking.unit-ext :
    10650                   when "LEVEL2"
    10651                   then do :
    10652                     ub.gds-dtl.doc-qnty:screen-value  = string(ub.gds-dtl.doc-qnty + if buf_marking.box-qnty <> 0 then buf_marking.box-qnty else vGtinQnty).
    10653                   end .
    10654                   when "LEVEL1"
    10655                   then do :
    10656                     assign v-pack-qnty = 0 .
    10657                     for each buf_marking-child no-lock where buf_marking-child.mark-parent = buf_marking.mark,
    10658                     first buf_marking-lines no-lock where buf_marking-lines.mark = buf_marking-child.mark-parent
    10659                                                       and buf_marking-lines.out-code = ub.gds-dtl.doc-code :
    10660                       assign v-pack-qnty = v-pack-qnty + 1 .
    10661                     end .
    10662                     ub.gds-dtl.doc-qnty:screen-value  = string(ub.gds-dtl.doc-qnty + buf_marking.box-qnty - v-pack-qnty).
    10663                   end .
    10664                   otherwise do :
    10665                     find first buf_marking-lines no-lock where buf_marking-lines.mark = buf_marking.mark-parent
    10666                                                            and buf_marking-lines.out-code = ub.gds-dtl.doc-code
    10667                                                            no-error .
    10668                     if not available buf_marking-lines
    10669                     then do :
