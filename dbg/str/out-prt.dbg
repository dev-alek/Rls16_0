    11534           ub.doc-line.doc-density   = 1.0
    11535           ub.doc-line.cli-base-rate = 1.0
    11536           ub.doc-line.fact-density  = 1.0
    11537         .
    11538       end.
    11539       display
    11540         v-price-rubl-kg
    11541         v-price-base-kg
    11542         v-qnty-kg
    11543         v-fact-qnty-kg
    11544         ub.doc-line.doc-density
    11545         ub.doc-line.temperature
    11546         with frame d-out-prt.
    11547       if (t-doc.flag_ = true or t-doc.status_ = 'факт':U)
    11548       and t-doc.ext-doc-type <> 'io':U and t-doc.ext-doc-type <> 'eo':U
    11549       then do:
    11550         enable
    11551           b-addinf
    11552           with frame d-out-prt.
    11553         if t-doc.doc-type = 'при':U
    11554           and lookup(v-ptrl-without-rvs, 'true,yes':u) = 0
    11555         then do:
    11556           enable
    11557             b-rvs-bf
    11558             b-rvs-af
    11559             with frame d-out-prt.
    11560         end.
    11561       end.
    11562     end.
    11563     else do:
    11564       hide
    11565         v-price-rubl-kg
    11566         v-price-base-kg
    11567         v-qnty-kg
    11568         v-fact-qnty-kg
    11569         ub.doc-line.doc-density
    11570         ub.doc-line.temperature
    11571         in frame d-out-prt
    11572       .
    11573     end.
    11574     case t-doc.doc-type :
    11575       when 'рас':U
    11576       or when 'спи':U
    11577       or when 'возврат':U
    11578       then do:
    11579         if prt-mode = 'БЕЗ_ПРИЗНАКОВ':U
    11580           or prt-mode = 'ШКАЛА':U
    11581         then do:
    11582           if v-work-with-qnty = "doc":U then do:
    11583             if t-doc.discnt-type = 'строка':U then do:
    11584               if ub.gds-dtl.discnt-type  then do:
    11585                 assign
    11586                   ub.gds-dtl.discnt-base = ub.gds-dtl.price-base * ub.gds-dtl.discnt-pc / 100
    11587                   ub.gds-dtl.discnt-rubl = ub.gds-dtl.price-rubl * ub.gds-dtl.discnt-pc / 100
    11588                 .
    11589                 enable ub.gds-dtl.discnt-pc with frame d-out-prt.
    11590               end.
    11591               else do:
    11592                 if t-doc.print-rubl then do:
    11593                   assign
    11594                     ub.gds-dtl.discnt-pc   = ub.gds-dtl.discnt-rubl * 100 / ub.gds-dtl.price-rubl
    11595                     ub.gds-dtl.discnt-base = ub.gds-dtl.discnt-rubl       / t-doc.base-rate * t-doc.base-scale
    11596                   .
    11597                   if ub.gds-dtl.discnt-pc = ? then do:
    11598                     assign
    11599                       ub.gds-dtl.discnt-pc = 0.
    11600                   end.
    11601                   enable ub.gds-dtl.discnt-rubl with frame d-out-prt.
    11602                 end.
    11603                 else do:
    11604                   assign
    11605                     ub.gds-dtl.discnt-pc   = ub.gds-dtl.discnt-base * 100 / ub.gds-dtl.price-base
    11606                     ub.gds-dtl.discnt-rubl = ub.gds-dtl.discnt-base *       t-doc.base-rate / t-doc.base-scale
    11607                   .
    11608                   if ub.gds-dtl.discnt-pc = ? then do:
    11609                     assign
    11610                       ub.gds-dtl.discnt-pc = 0.
    11611                   end.
    11612                   enable ub.gds-dtl.discnt-base with frame d-out-prt.
    11613                 end.
    11614               end.
    11615               enable ub.gds-dtl.discnt-type with frame d-out-prt.
    11616             end.
    11617             if lookup( t-doc.doc-type, 'рас,спи':U ) > 0 then do:
    11618               if available ub.prt-obj    then do: display ub.prt-obj.free-qnty  with frame d-out-prt. end.
    11619               if available ub.price-list then do: display ub.price-list.doc-num with frame d-out-prt. end.
    11620             end.
    11621             if t-doc.internal = false then do:
    11622               case t-doc.doc-type :
