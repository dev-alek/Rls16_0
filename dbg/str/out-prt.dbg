       71   define new global shared variable g#vssrevis-logger as handle    no-undo .
       72   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       73   define variable v-vssrevis-logger                   as handle    no-undo .
       74   procedure vss-logevent :
       75     define input  parameter p-extra-paramters as character no-undo .
       76     define variable v-vssrevis-parameters as character no-undo .
       77     do
       78     on error undo, return error return-value
       79     :
       80       if  valid-handle(v-vssrevis-logger)
       81       and v-vssrevis-logger :get-signature("logevent") <> ""
       82       then do:
       83         run vss-get-parameters in this-procedure
       84           (output v-vssrevis-parameters
       85           ).
       86         run logevent in v-vssrevis-logger
       87           (input vss-workfile
       88           ,input vss-revision
       89           ,input v-vssrevis-parameters
       90           ,input p-extra-paramters
       91           ).
       92       end.
       93     end.
       94   end procedure.
       95   assign
       96     v-vssrevis-logger = g#vssrevis-logger
       97   .
       98   if  valid-handle(v-vssrevis-logger)
       99   and v-vssrevis-logger :get-signature("logevent") <> ""
      100   then do:
      101     assign
      102       v-vssrevis-logevent = true
      103     .
      104     run vss-logevent in this-procedure (input vss-description) .
      105   end.
