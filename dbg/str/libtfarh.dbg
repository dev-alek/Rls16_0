     4483             bf-reclc_arh-trn-doc-contract.exp-sum-slt-rubl    = bf-reclc_arh-trn-doc-contract.exp-sum-slt-rubl    + tt-cnt-parts.slt-rubl-acc
     4484             bf-reclc_arh-trn-doc-contract.exp-sum-rdt-base    = bf-reclc_arh-trn-doc-contract.exp-sum-rdt-base    + tt-cnt-parts.road-tax-base-acc
     4485             bf-reclc_arh-trn-doc-contract.exp-sum-rdt-rubl    = bf-reclc_arh-trn-doc-contract.exp-sum-rdt-rubl    + tt-cnt-parts.road-tax-rubl-acc
     4486             bf-reclc_arh-trn-doc-contract.exp-sum-transp-base = bf-reclc_arh-trn-doc-contract.exp-sum-transp-base + tt-cnt-parts.transport-base-acc
     4487             bf-reclc_arh-trn-doc-contract.exp-sum-transp-rubl = bf-reclc_arh-trn-doc-contract.exp-sum-transp-rubl + tt-cnt-parts.transport-rubl-acc
     4488             bf-reclc_arh-trn-doc-contract.exp-sum-other-base  = bf-reclc_arh-trn-doc-contract.exp-sum-other-base  + tt-cnt-parts.other-base-acc
     4489             bf-reclc_arh-trn-doc-contract.exp-sum-other-rubl  = bf-reclc_arh-trn-doc-contract.exp-sum-other-rubl  + tt-cnt-parts.other-rubl-acc
     4490           .
     4491         end.
     4492       end.
     4493     end.
     4494   end.
     4495   end.
     4496   end procedure.
     4497   define temp-table tt-contract-code no-undo
     4498   field host-code     like ub.contract.host-code
     4499   field contract-code like ub.contract.contract-code
     4500   field cli-type      like ub.clients.obj-type
     4501   field cli-code      like ub.clients.obj-code
     4502   index pi is unique primary host-code contract-code cli-type cli-code.
     4503   procedure libtfarh_latrncnt :
     4504   define input parameter pardoc-code    like ub.trn-doc.doc-code no-undo.
     4505   define buffer bf_trn-doc  for ub.trn-doc.
     4506   define buffer bf_parts    for ub.parts.
     4507   define buffer bf_contract for ub.contract.
     4508   define variable varinc-exp as integer no-undo.
     4509   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4510   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     4511   if not available bf_trn-doc then do:
     4512     return error substitute ("Не найден складской документ с номером &1.", pardoc-code).
     4513   end.
     4514   run libtfarh_finincex in this-procedure (
     4515       input  bf_trn-doc.ext-doc-type,
     4516       output varinc-exp).
     4517   if varinc-exp <> 1 and
     4518      varinc-exp <> 2 then do:
     4519     return.
     4520   end.
     4521   for each tt-contract-code on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4522     delete tt-contract-code.
     4523   end.
     4524   for each bf_parts where bf_parts.out-code      = bf_trn-doc.doc-code and
     4525                           bf_parts.obj-type      = bf_trn-doc.obj-type and
     4526                           bf_parts.obj-code      = bf_trn-doc.obj-code no-lock on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4527     find first tt-contract-code where tt-contract-code.host-code     = bf_parts.host-code     and
     4528                                       tt-contract-code.contract-code = bf_parts.contract-code and
     4529                                       tt-contract-code.cli-type      = bf_parts.supp-type     and
     4530                                       tt-contract-code.cli-code      = bf_parts.supp-code     no-error.
     4531     if not available tt-contract-code then do:
     4532       create tt-contract-code.
     4533       assign
     4534         tt-contract-code.host-code     = bf_parts.host-code
     4535         tt-contract-code.contract-code = bf_parts.contract-code
     4536         tt-contract-code.cli-type      = bf_parts.supp-type
     4537         tt-contract-code.cli-code      = bf_parts.supp-code
     4538       .
     4539     end.
     4540   end.
     4541   for each tt-contract-code on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4542     run libtfarh_lptrncnt in this-procedure
     4543                           (input tt-contract-code.host-code,
     4544                            input tt-contract-code.contract-code,
     4545                            input tt-contract-code.cli-type,
     4546                            input tt-contract-code.cli-code,
     4547                            input bf_trn-doc.obj-type,
     4548                            input bf_trn-doc.obj-code,
     4549                            input bf_trn-doc.ext-doc-type,
     4550                            input "":u).
     4551   end.
     4552   end.
     4553   end procedure.
     4554   procedure libtfarh_lptrncnt :
     4555   define input parameter parhost-code     like ub.trn-doc.host-code      no-undo.
     4556   define input parameter parcontract-code like ub.contract.contract-code no-undo.
     4557   define input parameter parcli-type      like ub.clients.obj-type       no-undo.
     4558   define input parameter parcli-code      like ub.clients.obj-code       no-undo.
     4559   define input parameter parobj-type      like ub.trn-doc.obj-type       no-undo.
     4560   define input parameter parobj-code      like ub.trn-doc.obj-code       no-undo.
     4561   define input parameter parext-doc-type  like ub.trn-doc.ext-doc-type   no-undo.
     4562   define input parameter parsum-type      as   character                 no-undo.
     4563   define buffer bf_arh-trn-doc-contract for ub.arh-trn-doc-contract.
     4564   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4565   find last bf_arh-trn-doc-contract where bf_arh-trn-doc-contract.host-code      = parhost-code     and
     4566                                           bf_arh-trn-doc-contract.contract-code  = parcontract-code and
     4567                                           bf_arh-trn-doc-contract.cli-type       = parcli-type      and
     4568                                           bf_arh-trn-doc-contract.cli-code       = parcli-code      and
     4569                                           bf_arh-trn-doc-contract.obj-type       = parobj-type      and
     4570                                           bf_arh-trn-doc-contract.obj-code       = parobj-code      and
     4571                                           bf_arh-trn-doc-contract.ext-doc-type   = parext-doc-type  and
     4572                                           bf_arh-trn-doc-contract.sum-type       = parsum-type      exclusive-lock no-error.
     4573   if not available bf_arh-trn-doc-contract then do:
     4574     create bf_arh-trn-doc-contract.
     4575     assign
     4576       bf_arh-trn-doc-contract.host-code      = parhost-code
     4577       bf_arh-trn-doc-contract.contract-code  = parcontract-code
     4578       bf_arh-trn-doc-contract.cli-type       = parcli-type
     4579       bf_arh-trn-doc-contract.cli-code       = parcli-code
     4580       bf_arh-trn-doc-contract.obj-type       = parobj-type
     4581       bf_arh-trn-doc-contract.obj-code       = parobj-code
     4582       bf_arh-trn-doc-contract.ext-doc-type   = parext-doc-type
     4583       bf_arh-trn-doc-contract.sum-type       = parsum-type
     4584       bf_arh-trn-doc-contract.fact-order     = 0.
     4585   end.
     4586   end.
     4587   end procedure.
     4588   define temp-table tt-parts-cntr no-undo like ub.parts.
     4589   procedure libtfarh_lkcontr:
     4590   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     4591   define buffer bf_trn-doc  for ub.trn-doc.
     4592   define buffer bf_parts    for ub.parts.
     4593   define buffer bf_contract for ub.contract.
     4594   define buffer bf_host-lk  for ub.host-lk.
     4595   do transaction on error undo, return error return-value :
     4596   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code exclusive-lock.
     4597   for each tt-parts-cntr on error undo, return error return-value :
     4598     delete tt-parts-cntr.
     4599   end.
     4600   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code on error undo, return error return-value :
     4601     create tt-parts-cntr.
     4602     buffer-copy bf_parts to tt-parts-cntr.
     4603   end.
     4604   for each tt-parts-cntr use-index contr on error undo, return error return-value :
     4605     if tt-parts-cntr.contract-code <> 0 then do:
     4606       find first bf_contract where bf_contract.host-code     = tt-parts-cntr.host-code     and
     4607                                    bf_contract.contract-code = tt-parts-cntr.contract-code exclusive-lock.
     4608     end.
     4609   end.
     4610   end.
     4611   end procedure.
