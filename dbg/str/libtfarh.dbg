     2093   define temp-table tt-parts-for-cnt no-undo like ub.parts.
     2094   define temp-table tt-cnt-parts no-undo
     2095   field host-code          like ub.contract.host-code
     2096   field contract-code      like ub.contract.contract-code
     2097   field sum-dsc-base-acc   like ub.doc-line.price-base
     2098   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     2099   field vat-base-acc       like ub.doc-line.price-base
     2100   field vat-rubl-acc       like ub.doc-line.price-base
     2101   field slt-base-acc       like ub.doc-line.price-base
     2102   field slt-rubl-acc       like ub.doc-line.price-base
     2103   field road-tax-base-acc  like ub.doc-line.price-base
     2104   field road-tax-rubl-acc  like ub.doc-line.price-base
     2105   field excise-base-acc    like ub.doc-line.price-base
     2106   field excise-rubl-acc    like ub.doc-line.price-base
     2107   field transport-base-acc like ub.doc-line.price-base
     2108   field transport-rubl-acc like ub.doc-line.price-base
     2109   field other-base-acc     like ub.doc-line.price-base
     2110   field other-rubl-acc     like ub.doc-line.price-base
     2111   field contract-prn-code  like ub.contract.contract-prn-code
     2112   field supp-type          like ub.parts.supp-type
     2113   field supp-code          like ub.parts.supp-code
     2114   field supp-name          like ub.clients.obj-name
     2115   index pi is unique primary host-code contract-code supp-type supp-code.
     2116   procedure cntparts_calc-table-cnt :
     2117   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     2118   define buffer bf_trn-doc  for ub.trn-doc.
     2119   define buffer bf_parts    for ub.parts.
     2120   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2121   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     2122   if not available bf_trn-doc then do:
     2123     return error substitute("Не найден документ с номером &1.", pardoc-code).
     2124   end.
     2125   for each tt-parts-for-cnt on error undo, return error return-value :
     2126     delete tt-parts-for-cnt.
     2127   end.
     2128   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code no-lock on error undo, return error return-value :
     2129     create tt-parts-for-cnt.
     2130     buffer-copy bf_parts to tt-parts-for-cnt.
     2131   end.
     2132   run cntparts_calc-tt-table-cnt in this-procedure.
     2133   end.
     2134   end procedure.
     2135   procedure cntparts_calc-tt-table-cnt:
     2136   define buffer bf_contract for ub.contract.
     2137   define buffer bf_clients  for ub.clients.
     2138   do on error undo, return error return-value :
     2139   for each tt-cnt-parts on error undo, return error return-value :
     2140     delete tt-cnt-parts.
     2141   end.
     2142   for each tt-parts-for-cnt on error undo, return error return-value :
     2143     for each tt-allsum on error undo, return error return-value :
     2144       delete tt-allsum.
     2145     end.
     2146     for each tt-clcparts on error undo, return error return-value :
     2147       delete tt-clcparts.
     2148     end.
     2149     create tt-clcparts.
     2150     buffer-copy tt-parts-for-cnt to tt-clcparts.
     2151     run clcprtsl_calc-parts (
     2152         input recid(tt-clcparts),
     2153         input no,
     2154         input no,
     2155         input 0,
     2156         input 0,
     2157         input 0,
     2158         input 0,
     2159         input 0,
     2160         input 0,
     2161         input 0,
     2162         input 0,
     2163         input 0,
     2164         input 0,
     2165         input 0,
     2166         input 0,
     2167         input 0,
     2168         input 0) no-error.
     2169     if error-status:error then do:
     2170       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2171     end.
     2172     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2173     find first tt-cnt-parts where tt-cnt-parts.host-code     = tt-parts-for-cnt.host-code     and
     2174                                      tt-cnt-parts.contract-code = tt-parts-for-cnt.contract-code and
     2175                                      tt-cnt-parts.supp-type     = tt-parts-for-cnt.supp-type     and
     2176                                      tt-cnt-parts.supp-code     = tt-parts-for-cnt.supp-code     no-error.
     2177     if not available tt-cnt-parts then do:
     2178       create tt-cnt-parts.
     2179       assign
     2180         tt-cnt-parts.host-code     = tt-parts-for-cnt.host-code
     2181         tt-cnt-parts.contract-code = tt-parts-for-cnt.contract-code.
     2182       if tt-parts-for-cnt.contract-code <> 0 then do:
     2183         find first bf_contract where bf_contract.host-code     = tt-parts-for-cnt.host-code     and
     2184                                      bf_contract.contract-code = tt-parts-for-cnt.contract-code no-lock no-error.
     2185         if not available bf_contract then do:
     2186           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", tt-parts-for-cnt.host-code, tt-parts-for-cnt.contract-code).
     2187         end.
     2188         assign
     2189           tt-cnt-parts.contract-prn-code = bf_contract.contract-prn-code.
     2190       end.
     2191       else do:
     2192         assign
     2193           tt-cnt-parts.contract-prn-code = "без договора".
     2194       end.
     2195       find first bf_clients where bf_clients.obj-type = tt-parts-for-cnt.supp-type and
     2196                                   bf_clients.obj-code = tt-parts-for-cnt.supp-code no-lock no-error.
     2197       if not available bf_clients then do:
     2198         return error substitute ("Не найден поставщик &1 &2.", tt-parts-for-cnt.supp-type, tt-parts-for-cnt.supp-code).
     2199       end.
     2200       assign
     2201         tt-cnt-parts.supp-type = bf_clients.obj-type
     2202         tt-cnt-parts.supp-code = bf_clients.obj-code
     2203         tt-cnt-parts.supp-name = bf_clients.obj-name.
     2204     end.
     2205     assign
     2206       tt-cnt-parts.sum-dsc-base-acc   = tt-cnt-parts.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2207       tt-cnt-parts.sum-dsc-rubl-acc   = tt-cnt-parts.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2208       tt-cnt-parts.vat-base-acc       = tt-cnt-parts.vat-base-acc       + tt-allsum.vat-base-acc
     2209       tt-cnt-parts.vat-rubl-acc       = tt-cnt-parts.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2210       tt-cnt-parts.slt-base-acc       = tt-cnt-parts.slt-base-acc       + tt-allsum.slt-base-acc
     2211       tt-cnt-parts.slt-rubl-acc       = tt-cnt-parts.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2212       tt-cnt-parts.road-tax-base-acc  = tt-cnt-parts.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2213       tt-cnt-parts.road-tax-rubl-acc  = tt-cnt-parts.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2214       tt-cnt-parts.excise-base-acc    = tt-cnt-parts.excise-base-acc    + tt-allsum.excise-base-acc
     2215       tt-cnt-parts.excise-rubl-acc    = tt-cnt-parts.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2216       tt-cnt-parts.transport-base-acc = tt-cnt-parts.transport-base-acc + tt-allsum.transport-base-acc
     2217       tt-cnt-parts.transport-rubl-acc = tt-cnt-parts.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2218       tt-cnt-parts.other-base-acc     = tt-cnt-parts.other-base-acc     + tt-allsum.other-base-acc
     2219       tt-cnt-parts.other-rubl-acc     = tt-cnt-parts.other-rubl-acc     + tt-allsum.other-rubl-acc
     2220     .
     2221   end.
     2222   end.
     2223   end procedure.
     2224   procedure cntparts_calc-c-table-cnt :
     2225   define input parameter pardoc-code like ub.c-trn-doc.doc-code no-undo.
     2226   define input parameter parchip-num like ub.c-trn-doc.chip-num no-undo.
     2227   define buffer bf_c-trn-doc for ub.c-trn-doc.
     2228   define buffer bf_c-parts   for ub.c-parts.
     2229   define buffer bf_contract for ub.contract.
     2230   define buffer bf_clients  for ub.clients.
     2231   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2232   find first bf_c-trn-doc where bf_c-trn-doc.doc-code = pardoc-code and
     2233                                 bf_c-trn-doc.chip-num = parchip-num no-lock no-error.
     2234   if not available bf_c-trn-doc then do:
     2235     return error substitute("Не найден удаленный документ с номером &1.", pardoc-code).
     2236   end.
     2237   for each bf_c-parts where bf_c-parts.out-code = bf_c-trn-doc.doc-code and
     2238                             bf_c-parts.chip-num = bf_c-trn-doc.chip-num no-lock on error undo, return error return-value :
     2239     for each tt-allsum on error undo, return error return-value :
     2240       delete tt-allsum.
     2241     end.
     2242     for each tt-clcparts on error undo, return error return-value :
     2243       delete tt-clcparts.
     2244     end.
     2245     create tt-clcparts.
     2246     buffer-copy bf_c-parts to tt-clcparts.
     2247     run clcprtsl_calc-parts (
     2248         input recid(tt-clcparts),
     2249         input no,
     2250         input no,
     2251         input 0,
     2252         input 0,
     2253         input 0,
     2254         input 0,
     2255         input 0,
     2256         input 0,
     2257         input 0,
     2258         input 0,
     2259         input 0,
     2260         input 0,
     2261         input 0,
     2262         input 0,
     2263         input 0,
     2264         input 0) no-error.
     2265     if error-status:error then do:
     2266       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2267     end.
     2268     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2269     find first tt-cnt-parts where tt-cnt-parts.host-code     = bf_c-parts.host-code     and
     2270                                      tt-cnt-parts.contract-code = bf_c-parts.contract-code and
     2271                                      tt-cnt-parts.supp-type     = bf_c-parts.supp-type     and
     2272                                      tt-cnt-parts.supp-code     = bf_c-parts.supp-code     no-error.
     2273     if not available tt-cnt-parts then do:
     2274       create tt-cnt-parts.
     2275       assign
     2276         tt-cnt-parts.host-code     = bf_c-parts.host-code
     2277         tt-cnt-parts.contract-code = bf_c-parts.contract-code.
     2278       if bf_c-parts.contract-code <> 0 then do:
     2279         find first bf_contract where bf_contract.host-code     = bf_c-parts.host-code     and
     2280                                      bf_contract.contract-code = bf_c-parts.contract-code no-lock no-error.
     2281         if not available bf_contract then do:
     2282           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", bf_c-parts.host-code, bf_c-parts.contract-code).
     2283         end.
     2284         assign
     2285           tt-cnt-parts.contract-prn-code = bf_contract.contract-prn-code.
     2286       end.
     2287       else do:
     2288         assign
     2289           tt-cnt-parts.contract-prn-code = "без договора".
     2290       end.
     2291       find first bf_clients where bf_clients.obj-type = bf_c-parts.supp-type and
     2292                                   bf_clients.obj-code = bf_c-parts.supp-code no-lock no-error.
     2293       if not available bf_clients then do:
     2294         return error substitute ("Не найден поставщик &1 &2.", bf_c-parts.supp-type, bf_c-parts.supp-code).
     2295       end.
     2296       assign
     2297         tt-cnt-parts.supp-type = bf_clients.obj-type
     2298         tt-cnt-parts.supp-code = bf_clients.obj-code
     2299         tt-cnt-parts.supp-name = bf_clients.obj-name.
     2300     end.
     2301     assign
     2302       tt-cnt-parts.sum-dsc-base-acc   = tt-cnt-parts.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2303       tt-cnt-parts.sum-dsc-rubl-acc   = tt-cnt-parts.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2304       tt-cnt-parts.vat-base-acc       = tt-cnt-parts.vat-base-acc       + tt-allsum.vat-base-acc
     2305       tt-cnt-parts.vat-rubl-acc       = tt-cnt-parts.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2306       tt-cnt-parts.slt-base-acc       = tt-cnt-parts.slt-base-acc       + tt-allsum.slt-base-acc
     2307       tt-cnt-parts.slt-rubl-acc       = tt-cnt-parts.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2308       tt-cnt-parts.road-tax-base-acc  = tt-cnt-parts.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2309       tt-cnt-parts.road-tax-rubl-acc  = tt-cnt-parts.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2310       tt-cnt-parts.excise-base-acc    = tt-cnt-parts.excise-base-acc    + tt-allsum.excise-base-acc
     2311       tt-cnt-parts.excise-rubl-acc    = tt-cnt-parts.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2312       tt-cnt-parts.transport-base-acc = tt-cnt-parts.transport-base-acc + tt-allsum.transport-base-acc
     2313       tt-cnt-parts.transport-rubl-acc = tt-cnt-parts.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2314       tt-cnt-parts.other-base-acc     = tt-cnt-parts.other-base-acc     + tt-allsum.other-base-acc
     2315       tt-cnt-parts.other-rubl-acc     = tt-cnt-parts.other-rubl-acc     + tt-allsum.other-rubl-acc
     2316     .
     2317   end.
     2318   end.
     2319   end procedure.
     2320   define temp-table tt-parts-for-cnt-lk no-undo like ub.parts.
     2321   define temp-table tt-cnt-parts-lk no-undo
     2322   field host-code          like ub.contract.host-code
     2323   field contract-code      like ub.contract.contract-code
     2324   field sum-dsc-base-acc   like ub.doc-line.price-base
