     2334   field transport-base-acc like ub.doc-line.price-base
     2335   field transport-rubl-acc like ub.doc-line.price-base
     2336   field other-base-acc     like ub.doc-line.price-base
     2337   field other-rubl-acc     like ub.doc-line.price-base
     2338   field contract-prn-code  like ub.contract.contract-prn-code
     2339   field supp-type          like ub.parts.supp-type
     2340   field supp-code          like ub.parts.supp-code
     2341   field supp-name          like ub.clients.obj-name
     2342   index pi is unique primary host-code contract-code supp-type supp-code.
     2343   procedure cntparts_calc-table-cnt-lk :
     2344   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     2345   define buffer bf_trn-doc  for ub.trn-doc.
     2346   define buffer bf_parts    for ub.parts.
     2347   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2348   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     2349   if not available bf_trn-doc then do:
     2350     return error substitute("Не найден документ с номером &1.", pardoc-code).
     2351   end.
     2352   for each tt-parts-for-cnt-lk on error undo, return error return-value :
     2353     delete tt-parts-for-cnt-lk.
     2354   end.
     2355   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code no-lock on error undo, return error return-value :
     2356     create tt-parts-for-cnt-lk.
     2357     buffer-copy bf_parts to tt-parts-for-cnt-lk.
     2358   end.
     2359   run cntparts_calc-tt-table-cnt-lk in this-procedure.
     2360   end.
     2361   end procedure.
     2362   procedure cntparts_calc-tt-table-cnt-lk:
     2363   define buffer bf_contract for ub.contract.
     2364   define buffer bf_clients  for ub.clients.
     2365   do on error undo, return error return-value :
     2366   for each tt-cnt-parts-lk on error undo, return error return-value :
     2367     delete tt-cnt-parts-lk.
     2368   end.
     2369   for each tt-parts-for-cnt-lk on error undo, return error return-value :
     2370     for each tt-allsum on error undo, return error return-value :
     2371       delete tt-allsum.
     2372     end.
     2373     for each tt-clcparts on error undo, return error return-value :
     2374       delete tt-clcparts.
     2375     end.
     2376     create tt-clcparts.
     2377     buffer-copy tt-parts-for-cnt-lk to tt-clcparts.
     2378     run clcprtsl_calc-parts (
     2379         input recid(tt-clcparts),
     2380         input no,
     2381         input no,
     2382         input 0,
     2383         input 0,
     2384         input 0,
     2385         input 0,
     2386         input 0,
     2387         input 0,
     2388         input 0,
     2389         input 0,
     2390         input 0,
     2391         input 0,
     2392         input 0,
     2393         input 0,
     2394         input 0,
     2395         input 0) no-error.
     2396     if error-status:error then do:
     2397       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2398     end.
     2399     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2400     find first tt-cnt-parts-lk where tt-cnt-parts-lk.host-code     = tt-parts-for-cnt-lk.host-code     and
     2401                                      tt-cnt-parts-lk.contract-code = tt-parts-for-cnt-lk.contract-code and
     2402                                      tt-cnt-parts-lk.supp-type     = tt-parts-for-cnt-lk.supp-type     and
     2403                                      tt-cnt-parts-lk.supp-code     = tt-parts-for-cnt-lk.supp-code     no-error.
     2404     if not available tt-cnt-parts-lk then do:
     2405       create tt-cnt-parts-lk.
     2406       assign
     2407         tt-cnt-parts-lk.host-code     = tt-parts-for-cnt-lk.host-code
     2408         tt-cnt-parts-lk.contract-code = tt-parts-for-cnt-lk.contract-code.
     2409       if tt-parts-for-cnt-lk.contract-code <> 0 then do:
     2410         find first bf_contract where bf_contract.host-code     = tt-parts-for-cnt-lk.host-code     and
     2411                                      bf_contract.contract-code = tt-parts-for-cnt-lk.contract-code no-lock no-error.
     2412         if not available bf_contract then do:
     2413           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", tt-parts-for-cnt-lk.host-code, tt-parts-for-cnt-lk.contract-code).
     2414         end.
     2415         assign
     2416           tt-cnt-parts-lk.contract-prn-code = bf_contract.contract-prn-code.
     2417       end.
     2418       else do:
     2419         assign
     2420           tt-cnt-parts-lk.contract-prn-code = "без договора".
     2421       end.
     2422       find first bf_clients where bf_clients.obj-type = tt-parts-for-cnt-lk.supp-type and
     2423                                   bf_clients.obj-code = tt-parts-for-cnt-lk.supp-code no-lock no-error.
     2424       if not available bf_clients then do:
     2425         return error substitute ("Не найден поставщик &1 &2.", tt-parts-for-cnt-lk.supp-type, tt-parts-for-cnt-lk.supp-code).
     2426       end.
     2427       assign
     2428         tt-cnt-parts-lk.supp-type = bf_clients.obj-type
     2429         tt-cnt-parts-lk.supp-code = bf_clients.obj-code
     2430         tt-cnt-parts-lk.supp-name = bf_clients.obj-name.
     2431     end.
     2432     assign
     2433       tt-cnt-parts-lk.sum-dsc-base-acc   = tt-cnt-parts-lk.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2434       tt-cnt-parts-lk.sum-dsc-rubl-acc   = tt-cnt-parts-lk.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2435       tt-cnt-parts-lk.vat-base-acc       = tt-cnt-parts-lk.vat-base-acc       + tt-allsum.vat-base-acc
     2436       tt-cnt-parts-lk.vat-rubl-acc       = tt-cnt-parts-lk.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2437       tt-cnt-parts-lk.slt-base-acc       = tt-cnt-parts-lk.slt-base-acc       + tt-allsum.slt-base-acc
     2438       tt-cnt-parts-lk.slt-rubl-acc       = tt-cnt-parts-lk.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2439       tt-cnt-parts-lk.road-tax-base-acc  = tt-cnt-parts-lk.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2440       tt-cnt-parts-lk.road-tax-rubl-acc  = tt-cnt-parts-lk.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2441       tt-cnt-parts-lk.excise-base-acc    = tt-cnt-parts-lk.excise-base-acc    + tt-allsum.excise-base-acc
     2442       tt-cnt-parts-lk.excise-rubl-acc    = tt-cnt-parts-lk.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2443       tt-cnt-parts-lk.transport-base-acc = tt-cnt-parts-lk.transport-base-acc + tt-allsum.transport-base-acc
     2444       tt-cnt-parts-lk.transport-rubl-acc = tt-cnt-parts-lk.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2445       tt-cnt-parts-lk.other-base-acc     = tt-cnt-parts-lk.other-base-acc     + tt-allsum.other-base-acc
     2446       tt-cnt-parts-lk.other-rubl-acc     = tt-cnt-parts-lk.other-rubl-acc     + tt-allsum.other-rubl-acc
     2447     .
     2448   end.
     2449   end.
     2450   end procedure.
     2451   procedure cntparts_calc-c-table-cnt-lk :
     2452   define input parameter pardoc-code like ub.c-trn-doc.doc-code no-undo.
     2453   define input parameter parchip-num like ub.c-trn-doc.chip-num no-undo.
     2454   define buffer bf_c-trn-doc for ub.c-trn-doc.
     2455   define buffer bf_c-parts   for ub.c-parts.
     2456   define buffer bf_contract for ub.contract.
     2457   define buffer bf_clients  for ub.clients.
     2458   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2459   find first bf_c-trn-doc where bf_c-trn-doc.doc-code = pardoc-code and
     2460                                 bf_c-trn-doc.chip-num = parchip-num no-lock no-error.
     2461   if not available bf_c-trn-doc then do:
     2462     return error substitute("Не найден удаленный документ с номером &1.", pardoc-code).
     2463   end.
     2464   for each bf_c-parts where bf_c-parts.out-code = bf_c-trn-doc.doc-code and
     2465                             bf_c-parts.chip-num = bf_c-trn-doc.chip-num no-lock on error undo, return error return-value :
     2466     for each tt-allsum on error undo, return error return-value :
     2467       delete tt-allsum.
     2468     end.
     2469     for each tt-clcparts on error undo, return error return-value :
     2470       delete tt-clcparts.
     2471     end.
     2472     create tt-clcparts.
     2473     buffer-copy bf_c-parts to tt-clcparts.
     2474     run clcprtsl_calc-parts (
     2475         input recid(tt-clcparts),
     2476         input no,
     2477         input no,
     2478         input 0,
     2479         input 0,
     2480         input 0,
     2481         input 0,
     2482         input 0,
     2483         input 0,
     2484         input 0,
     2485         input 0,
     2486         input 0,
     2487         input 0,
     2488         input 0,
     2489         input 0,
     2490         input 0,
     2491         input 0) no-error.
     2492     if error-status:error then do:
     2493       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2494     end.
     2495     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2496     find first tt-cnt-parts-lk where tt-cnt-parts-lk.host-code     = bf_c-parts.host-code     and
     2497                                      tt-cnt-parts-lk.contract-code = bf_c-parts.contract-code and
     2498                                      tt-cnt-parts-lk.supp-type     = bf_c-parts.supp-type     and
     2499                                      tt-cnt-parts-lk.supp-code     = bf_c-parts.supp-code     no-error.
     2500     if not available tt-cnt-parts-lk then do:
     2501       create tt-cnt-parts-lk.
     2502       assign
     2503         tt-cnt-parts-lk.host-code     = bf_c-parts.host-code
     2504         tt-cnt-parts-lk.contract-code = bf_c-parts.contract-code.
     2505       if bf_c-parts.contract-code <> 0 then do:
     2506         find first bf_contract where bf_contract.host-code     = bf_c-parts.host-code     and
     2507                                      bf_contract.contract-code = bf_c-parts.contract-code no-lock no-error.
     2508         if not available bf_contract then do:
     2509           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", bf_c-parts.host-code, bf_c-parts.contract-code).
     2510         end.
     2511         assign
     2512           tt-cnt-parts-lk.contract-prn-code = bf_contract.contract-prn-code.
     2513       end.
     2514       else do:
     2515         assign
     2516           tt-cnt-parts-lk.contract-prn-code = "без договора".
     2517       end.
     2518       find first bf_clients where bf_clients.obj-type = bf_c-parts.supp-type and
     2519                                   bf_clients.obj-code = bf_c-parts.supp-code no-lock no-error.
     2520       if not available bf_clients then do:
     2521         return error substitute ("Не найден поставщик &1 &2.", bf_c-parts.supp-type, bf_c-parts.supp-code).
     2522       end.
     2523       assign
     2524         tt-cnt-parts-lk.supp-type = bf_clients.obj-type
     2525         tt-cnt-parts-lk.supp-code = bf_clients.obj-code
     2526         tt-cnt-parts-lk.supp-name = bf_clients.obj-name.
     2527     end.
     2528     assign
     2529       tt-cnt-parts-lk.sum-dsc-base-acc   = tt-cnt-parts-lk.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2530       tt-cnt-parts-lk.sum-dsc-rubl-acc   = tt-cnt-parts-lk.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2531       tt-cnt-parts-lk.vat-base-acc       = tt-cnt-parts-lk.vat-base-acc       + tt-allsum.vat-base-acc
     2532       tt-cnt-parts-lk.vat-rubl-acc       = tt-cnt-parts-lk.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2533       tt-cnt-parts-lk.slt-base-acc       = tt-cnt-parts-lk.slt-base-acc       + tt-allsum.slt-base-acc
     2534       tt-cnt-parts-lk.slt-rubl-acc       = tt-cnt-parts-lk.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2535       tt-cnt-parts-lk.road-tax-base-acc  = tt-cnt-parts-lk.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2536       tt-cnt-parts-lk.road-tax-rubl-acc  = tt-cnt-parts-lk.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2537       tt-cnt-parts-lk.excise-base-acc    = tt-cnt-parts-lk.excise-base-acc    + tt-allsum.excise-base-acc
     2538       tt-cnt-parts-lk.excise-rubl-acc    = tt-cnt-parts-lk.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2539       tt-cnt-parts-lk.transport-base-acc = tt-cnt-parts-lk.transport-base-acc + tt-allsum.transport-base-acc
     2540       tt-cnt-parts-lk.transport-rubl-acc = tt-cnt-parts-lk.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2541       tt-cnt-parts-lk.other-base-acc     = tt-cnt-parts-lk.other-base-acc     + tt-allsum.other-base-acc
     2542       tt-cnt-parts-lk.other-rubl-acc     = tt-cnt-parts-lk.other-rubl-acc     + tt-allsum.other-rubl-acc
     2543     .
     2544   end.
     2545   end.
     2546   end procedure.
     2547   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2548   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2549   procedure partslib-clear-temp-parts :
     2550     define buffer buf_temp-parts for temp-parts .
     2551     do
     2552     on error undo, return error
     2553     :
     2554       for each buf_temp-parts
     2555       on error undo, return error
     2556       :
     2557         delete buf_temp-parts .
     2558       end.
     2559     end.
     2560   end procedure.
     2561   procedure partslib-create-temp-parts :
     2562     define parameter buffer buf_parts       for ub.parts .
     2563     define parameter buffer buf_temp-parts  for temp-parts .
     2564     define input  parameter p-goods-twounit as logical   no-undo .
     2565     define variable v-base-part-code as character no-undo .
     2566     do
     2567     on error undo, return error
     2568     :
     2569       if p-goods-twounit = true
     2570       then do:
     2571         assign
     2572           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2573         .
     2574       end.
     2575       else do:
     2576         assign
     2577           v-base-part-code = buf_parts.part-code
     2578         .
     2579       end.
     2580       find first buf_temp-parts exclusive-lock
     2581         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2582           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2583           and buf_temp-parts.artic     = buf_parts.artic
     2584           and buf_temp-parts.prod-type = buf_parts.prod-type
     2585           and buf_temp-parts.prod-code = buf_parts.prod-code
     2586           and buf_temp-parts.in-code   = buf_parts.in-code
     2587           and buf_temp-parts.out-code  = 'free-zone':U
     2588           and buf_temp-parts.part-code = v-base-part-code
     2589         no-error.
     2590       if not available buf_temp-parts
     2591       then do:
     2592         create buf_temp-parts .
     2593         buffer-copy buf_parts to buf_temp-parts
     2594         assign
     2595           buf_temp-parts.out-code  = 'free-zone':U
     2596           buf_temp-parts.part-code = v-base-part-code
     2597           buf_temp-parts.rsrv-free = yes
     2598           buf_temp-parts.status_   = no
     2599           buf_temp-parts.qnty      = 0
     2600           buf_temp-parts.fact-qnty = 0
     2601           buf_temp-parts.real-qnty = 0
     2602           buf_temp-parts.cli-qnty  = 0
     2603         .
     2604       end.
     2605     end.
     2606   end procedure.
     2607   procedure partslib-init-temp-parts :
     2608     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2609     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2610     define input parameter p-artic           like ub.parts.artic     no-undo .
     2611     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2612     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2613     define buffer buf_parts      for ub.parts .
     2614     define buffer buf_temp-parts for temp-parts .
     2615     define variable v-goods-twounit    as logical   no-undo .
     2616     do
     2617     on error undo, return error
     2618     :
     2619   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2621     (input  p-artic
     2622     ,input  p-prod-type
     2623     ,input  p-prod-code
     2624     ,input  'twounit=request':u
     2625     ,output v-goods-twounit
     2626     ) no-error .
     2627       if error-status :error
     2628       then do:
     2629         message
     2630           vss-workfile vss-revision vss-description skip
     2631           vss-include-info14 skip
     2632           "Ошибка при определении атрибута товара" skip
     2633           "Артикул" p-artic p-prod-type p-prod-code skip
     2634           "twounit=request" skip
     2635           error-status :get-message(1) skip
     2636           return-value skip
     2637           view-as alert-box error .
     2638         undo, return error return-value .
     2639       end.
     2640       run partslib-clear-temp-parts in this-procedure .
     2641       for each buf_parts
     2642         where buf_parts.obj-type  = p-obj-type
     2643           and buf_parts.obj-code  = p-obj-code
     2644           and buf_parts.artic     = p-artic
     2645           and buf_parts.prod-type = p-prod-type
     2646           and buf_parts.prod-code = p-prod-code
     2647           and buf_parts.rsrv-free = yes
     2648           and buf_parts.status_   = no
     2649           and buf_parts.in-code   <> buf_parts.out-code
     2650       on error undo, return error
     2651       :
     2652         run partslib-create-temp-parts in this-procedure
     2653           (buffer buf_parts
     2654           ,buffer buf_temp-parts
     2655           ,input  v-goods-twounit
     2656           ) .
     2657         define variable v-parts-qnty          as decimal   no-undo .
     2658         define variable v-parts-cli-qnty      as decimal   no-undo .
     2659         define variable v-parts-free-qnty     as decimal   no-undo .
     2660         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2661         if buf_parts.out-code = 'free-zone':U
     2662         then do:
     2663           assign
     2664             v-parts-qnty          = buf_parts.qnty
     2665             v-parts-cli-qnty      = buf_parts.cli-qnty
     2666             v-parts-free-qnty     = buf_parts.qnty
     2667             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2668           .
     2669         end.
     2670         else do:
     2671           assign
     2672             v-parts-qnty          = abs(buf_parts.qnty)
     2673             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2674             v-parts-free-qnty     = 0
     2675             v-parts-free-cli-qnty = 0
     2676           .
     2677         end.
     2678         assign
     2679           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2680           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2681           buf_temp-parts.real-qnty     = 0
     2682           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2683           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2684           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2685         .
     2686       end.
     2687     end.
     2688   end procedure.
     2689   procedure partslib-init-temp-parts-by-factord :
     2690     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2691     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2692     define input parameter p-artic              like ub.parts.artic     no-undo .
     2693     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2694     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2695     define input parameter p-fact-order         as decimal   no-undo .
     2696     define input parameter p-include-fact-order as logical   no-undo .
     2697     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2698     define buffer buf_gds-obj  for ub.gds-obj .
     2699     do
     2700     on error undo, return error
     2701     :
     2702       do transaction
     2703       on error undo, return error
     2704       :
     2705   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2707     (input  p-obj-type
     2708     ,input  p-obj-code
     2709     ,input  p-artic
     2710     ,input  p-prod-type
     2711     ,input  p-prod-code
     2712     ,buffer buf_gds-obj
     2713     ) no-error .
     2714         if error-status :error
     2715         then do:
     2716           message
     2717             vss-workfile vss-revision vss-description skip
     2718             vss-include-info14 skip
     2719             "Невозможно найти товар на объекте" skip
     2720             "Объект" p-obj-type p-obj-code skip
     2721             "Артикул" p-artic p-prod-type p-prod-code skip
     2722             error-status :get-message(1) skip
     2723             return-value skip
     2724             view-as alert-box error .
     2725           undo, return error .
     2726         end.
     2727         find current buf_gds-obj exclusive-lock .
     2728       end.
     2729       run partslib-init-temp-parts in this-procedure
     2730         (input p-obj-type
     2731         ,input p-obj-code
     2732         ,input p-artic
     2733         ,input p-prod-type
     2734         ,input p-prod-code
     2735         ) no-error .
     2736       if error-status :error
     2737       then do:
     2738         message
     2739           vss-workfile vss-revision vss-description skip
     2740           vss-include-info14 skip
     2741           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     2742           "Объект" p-obj-type p-obj-code skip
     2743           "Артикул" p-artic p-prod-type p-prod-code skip
     2744           "p-fact-order" p-fact-order skip
     2745           view-as alert-box error .
     2746         undo, return error .
     2747       end.
     2748       if p-include-fact-order = true
     2749       then do:
     2750         assign
     2751           p-fact-order = p-fact-order - 0.0000000001
     2752         .
     2753       end.
     2754       define variable v-max-fact-order as character no-undo .
     2755       run factord-max-fact-order in this-procedure
     2756         (output v-max-fact-order
     2757         ) no-error .
     2758       if error-status :error
     2759       then do:
     2760         message
     2761           vss-workfile vss-revision vss-description skip
     2762           vss-include-info14 skip
     2763           "Ошибка при вызове процедуры factord-max-fact-order" skip
     2764           "Объект" p-obj-type p-obj-code skip
     2765           "Артикул" p-artic p-prod-type p-prod-code skip
     2766           "p-fact-order" p-fact-order skip
     2767           view-as alert-box error .
     2768         undo, return error .
     2769       end.
     2770       run partslib-update-by-factord in this-procedure
     2771         (input p-obj-type
     2772         ,input p-obj-code
     2773         ,input p-artic
     2774         ,input p-prod-type
     2775         ,input p-prod-code
     2776         ,input p-fact-order
     2777         ,input v-max-fact-order
     2778         ,input false
     2779         ) no-error .
     2780       if error-status :error
     2781       then do:
     2782         message
     2783           vss-workfile vss-revision vss-description skip
     2784           vss-include-info14 skip
     2785           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     2786           "Объект" p-obj-type p-obj-code skip
     2787           "Артикул" p-artic p-prod-type p-prod-code skip
     2788           "p-fact-order" p-fact-order skip
     2789           "v-max-fact-order" v-max-fact-order skip
     2790           view-as alert-box error .
     2791         undo, return error .
     2792       end.
     2793     end.
     2794   end procedure.
     2795   procedure partslib-update-by-factord :
     2796     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2797     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2798     define input parameter p-artic              like ub.parts.artic     no-undo .
     2799     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2800     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2801     define input parameter p-start-fact-order   as decimal   no-undo .
     2802     define input parameter p-end-fact-order     as decimal   no-undo .
     2803     define input parameter p-lock-gds-obj       as logical   no-undo .
     2804     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2805     define buffer buf_gds-obj  for ub.gds-obj .
     2806     define buffer buf_doc-line for ub.doc-line .
     2807     define variable v-total-parts-qnty as decimal   no-undo .
     2808     define variable v-goods-gds-goods  as logical   no-undo .
     2809     define variable v-goods-twounit    as logical   no-undo .
     2810     do
     2811     on error undo, return error
     2812     :
     2813       if p-start-fact-order > p-end-fact-order
     2814       then do:
     2815         message
     2816           vss-workfile vss-revision vss-description skip
     2817           vss-include-info14 skip
     2818           "Ошибка задания входных параметров" skip
     2819           "Начало интервала превышает конец интервала" skip
     2820           "Объект" p-obj-type p-obj-code skip
     2821           "Артикул" p-artic p-prod-type p-prod-code skip
     2822           "p-start-fact-order" p-start-fact-order skip
     2823           "p-end-fact-order"   p-end-fact-order skip
     2824           view-as alert-box error .
     2825         undo, return error .
     2826       end.
     2827       if p-lock-gds-obj = true
     2828       then do:
     2829         do transaction
     2830         on error undo, return error
     2831         :
     2832   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2834     (input  p-obj-type
     2835     ,input  p-obj-code
     2836     ,input  p-artic
     2837     ,input  p-prod-type
     2838     ,input  p-prod-code
     2839     ,buffer buf_gds-obj
     2840     ) no-error .
     2841           if error-status :error
     2842           then do:
     2843             message
     2844               vss-workfile vss-revision vss-description skip
     2845               vss-include-info14 skip
     2846               "Невозможно найти gds-obj" skip
     2847               error-status :get-message(1) skip
     2848               return-value skip
     2849               view-as alert-box error .
     2850             undo, return error .
     2851           end.
     2852           find current buf_gds-obj exclusive-lock .
     2853         end.
     2854       end.
     2855   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2857     (input  p-artic
     2858     ,input  p-prod-type
     2859     ,input  p-prod-code
     2860     ,input  'gds-goods=request':u
     2861     ,output v-goods-gds-goods
     2862     ) no-error .
     2863       if error-status :error
     2864       then do:
     2865         message
     2866           vss-workfile vss-revision vss-description skip
     2867           vss-include-info14 skip
     2868           "Ошибка при определении атрибута товара" skip
     2869           "Артикул" p-artic p-prod-type p-prod-code skip
     2870           "gds-goods=request" skip
     2871           error-status :get-message(1) skip
     2872           return-value skip
     2873           view-as alert-box error .
     2874         undo, return error return-value .
     2875       end.
     2876   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2878     (input  p-artic
     2879     ,input  p-prod-type
     2880     ,input  p-prod-code
     2881     ,input  'twounit=request':u
     2882     ,output v-goods-twounit
     2883     ) no-error .
     2884       if error-status :error
     2885       then do:
     2886         message
     2887           vss-workfile vss-revision vss-description skip
     2888           vss-include-info14 skip
     2889           "Ошибка при определении атрибута товара" skip
     2890           "Артикул" p-artic p-prod-type p-prod-code skip
     2891           "twounit=request" skip
     2892           error-status :get-message(1) skip
     2893           return-value skip
     2894           view-as alert-box error .
     2895         undo, return error return-value .
     2896       end.
     2897       for each buf_doc-line no-lock
     2898         where buf_doc-line.obj-type   = p-obj-type
     2899           and buf_doc-line.obj-code   = p-obj-code
     2900           and buf_doc-line.artic      = p-artic
     2901           and buf_doc-line.prod-type  = p-prod-type
     2902           and buf_doc-line.prod-code  = p-prod-code
     2903           and buf_doc-line.status_    = 'факт':U
     2904           and buf_doc-line.fact-order > p-start-fact-order
     2905           and buf_doc-line.fact-order <= p-end-fact-order
     2906       on error undo, return error
     2907       :
     2908         run partslib-process-document in this-procedure
     2909           (input  buf_doc-line.doc-code
     2910           ,input  p-obj-type
     2911           ,input  p-obj-code
     2912           ,input  p-artic
     2913           ,input  p-prod-type
     2914           ,input  p-prod-code
     2915           ,input  v-goods-gds-goods
     2916           ,input  v-goods-twounit
     2917           ,output v-total-parts-qnty
     2918           ) no-error .
     2919         if error-status :error
     2920         then do:
     2921           message
     2922             vss-workfile vss-revision vss-description skip
     2923             vss-include-info14 skip
     2924             "Ошибка при вызове процедуры partslib-process-document" skip
     2925             "Документ" buf_doc-line.doc-code skip
     2926             "Объект" p-obj-type p-obj-code skip
     2927             "Артикул" p-artic p-prod-type p-prod-code skip
     2928             "p-start-fact-order" p-start-fact-order skip
     2929             "p-end-fact-order" p-end-fact-order skip
     2930             error-status :get-message(1) skip
     2931             return-value skip
     2932             view-as alert-box error .
     2933           undo, return error return-value .
     2934         end.
     2935       end.
     2936     end.
     2937   end procedure.
     2938   procedure partslib-process-document :
     2939     define input  parameter p-doc-code         as character no-undo .
     2940     define input  parameter p-obj-type         as character no-undo .
     2941     define input  parameter p-obj-code         as integer   no-undo .
     2942     define input  parameter p-artic            as character no-undo .
     2943     define input  parameter p-prod-type        as character no-undo .
     2944     define input  parameter p-prod-code        as integer   no-undo .
     2945     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2946     define input  parameter p-goods-twounit    as logical   no-undo .
     2947     define output parameter p-total-parts-qnty as decimal   no-undo .
     2948     define variable v-parts-sign as integer   no-undo .
     2949     define buffer buf_trn-doc    for ub.trn-doc .
     2950     define buffer buf_doc-line   for ub.doc-line .
     2951     define buffer buf_parts      for ub.parts .
     2952     define buffer buf_temp-parts for temp-parts .
     2953     do
     2954     on error undo, return error return-value
     2955     :
     2956       find first buf_trn-doc no-lock
     2957         where buf_trn-doc.doc-code = p-doc-code
     2958         no-error .
     2959       if not available buf_trn-doc
     2960       then do:
     2961         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2962                                      ,p-doc-code
     2963                                      ) .
     2964       end.
     2965       case buf_trn-doc.doc-type
     2966       :
     2967         when 'при':U or
     2968         when 'возврат':U or
     2969         when 'инв':U
     2970         then do:
     2971           assign
     2972             v-parts-sign = -1
     2973           .
     2974         end.
     2975         when 'рас':U or
     2976         when 'спи':U
     2977         then do:
     2978           assign
     2979             v-parts-sign = 1
     2980           .
     2981         end.
     2982         otherwise do:
     2983           undo, return error substitute("Неизвестный тип документа &1"
     2984                                       ,buf_trn-doc.doc-type
     2985                                       ) .
     2986         end.
     2987       end.
     2988       find first buf_doc-line no-lock
     2989         where buf_doc-line.doc-code  = p-doc-code
     2990           and buf_doc-line.artic     = p-artic
     2991           and buf_doc-line.prod-type = p-prod-type
     2992           and buf_doc-line.prod-code = p-prod-code
     2993         no-error .
     2994       if not available buf_doc-line
     2995       then do:
     2996         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2997                                      ,p-doc-code
     2998                                      ,artic
     2999                                      ,prod-type
     3000                                      ,prod-code
     3001                                      ) .
     3002       end.
     3003       assign
     3004         p-total-parts-qnty = 0
     3005       .
     3006       if p-goods-gds-goods = true
     3007       then do:
     3008         for each buf_parts no-lock
     3009           where buf_parts.out-code  = p-doc-code
     3010             and buf_parts.obj-type  = p-obj-type
     3011             and buf_parts.obj-code  = p-obj-code
     3012             and buf_parts.artic     = p-artic
     3013             and buf_parts.prod-type = p-prod-type
     3014             and buf_parts.prod-code = p-prod-code
     3015         on error undo, return error
     3016         :
     3017           run partslib-create-temp-parts in this-procedure
     3018             (buffer buf_parts
     3019             ,buffer buf_temp-parts
     3020             ,input  p-goods-twounit
     3021             ) .
     3022           assign
     3023             p-total-parts-qnty        = p-total-parts-qnty
     3024                                       + v-parts-sign * buf_parts.fact-qnty
     3025             buf_temp-parts.qnty       = buf_temp-parts.qnty
     3026                                       + v-parts-sign * buf_parts.fact-qnty
     3027             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     3028                                       + v-parts-sign * buf_parts.fact-qnty
     3029             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     3030                                       + v-parts-sign * buf_parts.cli-qnty
     3031           .
     3032           if buf_temp-parts.qnty = 0
     3033           then do:
     3034             delete buf_temp-parts .
     3035           end.
     3036         end.
     3037       end.
     3038       else do:
     3039         assign
     3040           p-total-parts-qnty = p-total-parts-qnty
     3041                              + v-parts-sign * buf_doc-line.fact-qnty
     3042         .
     3043       end.
     3044     end.
     3045   end procedure.
     3046   procedure partslib-init-temp-parts-by-date :
     3047     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     3048     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     3049     define input parameter p-artic           like ub.parts.artic     no-undo .
     3050     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     3051     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     3052     define input parameter p-fact-date       as date      no-undo .
     3053     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     3054     do
     3055     on error undo, return error
     3056     :
     3057       define variable v-fact-order                as decimal   no-undo .
     3058       define variable v-shift-end-fact-order      as decimal   no-undo .
     3059       define variable v-day-end-fact-order        as decimal   no-undo .
     3060       run factord in this-procedure
     3061         (input  p-fact-date
     3062         ,input  1
     3063         ,input  1
     3064         ,input  ?
     3065         ,input  0
     3066         ,input  false
     3067         ,output v-fact-order
     3068         ,output v-shift-end-fact-order
     3069         ,output v-day-end-fact-order
     3070         ) no-error .
     3071       if error-status :error
     3072       then do:
     3073         message
     3074           vss-workfile vss-revision vss-description skip
     3075           vss-include-info14 skip
     3076           "Ошибка при определении момента времени, на который требуется остаток" skip
     3077           "Объект" p-obj-type p-obj-code skip
     3078           "Артикул" p-artic p-prod-type p-prod-code skip
     3079           "Дата" p-fact-date skip
     3080           view-as alert-box error .
     3081         undo, return error .
     3082       end.
     3083       run partslib-init-temp-parts-by-factord in this-procedure
     3084         (input p-obj-type
     3085         ,input p-obj-code
     3086         ,input p-artic
     3087         ,input p-prod-type
     3088         ,input p-prod-code
     3089         ,input v-day-end-fact-order
     3090         ,input false
     3091         ) no-error .
     3092       if error-status :error
     3093       then do:
     3094         message
     3095           vss-workfile vss-revision vss-description skip
     3096           vss-include-info14 skip
     3097           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     3098           "Объект" p-obj-type p-obj-code skip
     3099           "Артикул" p-artic p-prod-type p-prod-code skip
     3100           "Дата" p-fact-date skip
     3101           view-as alert-box error .
     3102         undo, return error .
     3103       end.
     3104     end.
     3105   end procedure.
     3106   procedure partslib-calc-cost :
     3107     define output parameter p-fact-qnty      as decimal   no-undo .
     3108     define output parameter p-vat-pc         as decimal   no-undo .
     3109     define output parameter p-slt-pc         as decimal   no-undo .
     3110     define output parameter p-sum-base       as decimal   no-undo .
     3111     define output parameter p-sum-rubl       as decimal   no-undo .
     3112     define output parameter p-vat-base       as decimal   no-undo .
     3113     define output parameter p-vat-rubl       as decimal   no-undo .
     3114     define output parameter p-slt-base       as decimal   no-undo .
     3115     define output parameter p-slt-rubl       as decimal   no-undo .
     3116     define output parameter p-road-tax-base  as decimal   no-undo .
     3117     define output parameter p-road-tax-rubl  as decimal   no-undo .
     3118     define output parameter p-transport-base as decimal   no-undo .
     3119     define output parameter p-transport-rubl as decimal   no-undo .
     3120     define output parameter p-other-base     as decimal   no-undo .
     3121     define output parameter p-other-rubl     as decimal   no-undo .
     3122     define output parameter p-excise-base    as decimal   no-undo .
     3123     define output parameter p-excise-rubl    as decimal   no-undo .
     3124     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     3125     do
     3126     on error undo, return error return-value
     3127     :
     3128       define buffer buf_temp-parts for temp-parts .
     3129       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3130       define buffer   in-vatp-parts    for ub.parts   .
     3131       define buffer   in-vatp-doc      for ub.trn-doc .
     3132       define buffer   in-vatp-goods    for ub.goods   .
     3133       define buffer   in-vatp-sysconf  for ub.sysconf .
     3134       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3135       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3136       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3137       define variable varinvprb                  as   character              no-undo.
     3138       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3139       define variable cli-base-rate              as   decimal                no-undo.
     3140       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3141       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3142       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3143       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3144       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3145       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3146       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3147       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3148       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3149       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3150       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3151       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3152       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3153       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3154       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3155       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3156       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3157       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3158       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3159       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3160       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3161       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3162       define variable varinvatp-envd             as   character              no-undo.
     3163       define variable varinvatp-type             as   character              no-undo.
     3164       for each buf_temp-parts
     3165       on error undo, return error
     3166       :
     3167   assign
     3168     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     3169     price-base-with-tax-loc = buf_temp-parts.price-base
     3170   .
     3171   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3173     (output varinvprb
     3174     )  .
     3175     if buf_temp-parts.out-code = 'free-zone':U     or
     3176        buf_temp-parts.out-code = 'out-zone':U   or
     3177        buf_temp-parts.doc-type = 'акт':U then do:
     3178       assign
     3179         in-vatp-have-vat-slt = yes.
     3180     end.
     3181     else do:
     3182       find first in-vatp_doc-attr no-lock
     3183         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     3184           and in-vatp_doc-attr.attr-code = 'envd':U
     3185         no-error .
     3186       if not available in-vatp_doc-attr then do:
     3187         assign
     3188           in-vatp-have-vat-slt = yes.
     3189       end.
     3190       else do:
     3191            in-vatp-have-vat-slt = no.
     3192       end.
     3193     end.
     3194     assign
     3195      price-cli-with-tax-loc = buf_temp-parts.price-cli
     3196      cli-base-rate          = buf_temp-parts.cli-base-rate.
     3197     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     3198              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     3199     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     3200             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     3201             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     3202             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     3203             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     3204             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     3205             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3206       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3207     assign
     3208       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     3209     assign
     3210       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3211       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3212       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3213       transport-cli-loc  = 0
     3214       other-cli-loc      = 0
     3215     .
     3216   ASSIGN
     3217             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3218       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3219   .
     3220         assign
     3221           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     3222           p-vat-pc         = p-vat-pc         + vat-pc-loc
     3223           p-slt-pc         = p-slt-pc         + slt-pc-loc
     3224           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     3225           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     3226           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     3227           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     3228           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     3229           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     3230           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     3231           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     3232           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     3233           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     3234           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     3235           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     3236           p-excise-base    = p-excise-base    + 0
     3237           p-excise-rubl    = p-excise-rubl    + 0
     3238         .
     3239       end.
     3240       if p-fact-qnty      = ?
     3241       or p-sum-base       = ?
     3242       or p-sum-rubl       = ?
     3243       or p-vat-base       = ?
     3244       or p-vat-rubl       = ?
     3245       or p-slt-base       = ?
     3246       or p-slt-rubl       = ?
     3247       or p-road-tax-base  = ?
     3248       or p-road-tax-rubl  = ?
     3249       or p-transport-base = ?
     3250       or p-transport-rubl = ?
     3251       or p-other-base     = ?
     3252       or p-other-rubl     = ?
     3253       or p-excise-base    = ?
     3254       or p-excise-rubl    = ?
     3255       then do:
     3256         message
     3257           vss-workfile vss-revision vss-description skip
     3258           vss-include-info14 skip
     3259           "Программа in-vatp.i вернула неопределенные значения" skip
     3260           "p-fact-qnty"      p-fact-qnty      skip
     3261           "p-sum-base"       p-sum-base       skip
     3262           "p-sum-rubl"       p-sum-rubl       skip
     3263           "p-vat-base"       p-vat-base       skip
     3264           "p-vat-rubl"       p-vat-rubl       skip
     3265           "p-slt-base"       p-slt-base       skip
     3266           "p-slt-rubl"       p-slt-rubl       skip
     3267           "p-road-tax-base"  p-road-tax-base  skip
     3268           "p-road-tax-rubl"  p-road-tax-rubl  skip
     3269           "p-transport-base" p-transport-base skip
     3270           "p-transport-rubl" p-transport-rubl skip
     3271           "p-other-base"     p-other-base     skip
     3272           "p-other-rubl"     p-other-rubl     skip
     3273           "p-excise-base"    p-excise-base    skip
     3274           "p-excise-rubl"    p-excise-rubl    skip
     3275           view-as alert-box error .
     3276         undo, return error .
     3277       end.
     3278     end.
     3279   end procedure.
     3280   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3281   procedure factord :
     3282     define input  parameter p-fact-date            as date    no-undo .
     3283     define input  parameter p-fact-time            as integer no-undo .
     3284     define input  parameter p-fact-num             as integer no-undo .
     3285     define input  parameter p-shift-date           as date    no-undo .
     3286     define input  parameter p-shift-num            as integer no-undo .
     3287     define input  parameter p-shift-on             as logical no-undo .
     3288     define output parameter p-fact-order           as decimal no-undo .
     3289     define output parameter p-shift-end-fact-order as decimal no-undo .
     3290     define output parameter p-day-end-fact-order   as decimal no-undo .
     3291     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3292     if p-fact-date = ?
     3293     then do:
     3294       return error "Не указана фактическая дата" .
     3295     end.
     3296     define variable v-fact-date-num as integer no-undo .
     3297     assign
     3298       v-fact-date-num = integer(p-fact-date)
     3299     .
     3300     if p-fact-num = ?
     3301     or p-fact-num = 0
     3302     then do:
     3303       return error "Не задан p-fact-num " + string(p-fact-num) .
     3304     end.
     3305     if p-fact-num < 0
     3306     then do:
     3307       return error "Отрицательный fact-num " + string(p-fact-num) .
     3308     end.
     3309     if p-fact-num >= 100000000
     3310     then do:
     3311       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3312     end.
     3313     if p-shift-on = true
     3314     then do:
     3315       if p-shift-date = ?
     3316       then do:
     3317         return error "Не задана дата смены" .
     3318       end.
     3319       if p-shift-num = ?
     3320       or p-shift-num = 0
     3321       then do:
     3322         return error "Не задан номер смены" .
     3323       end.
     3324     end.
     3325     else do:
     3326       assign
     3327         p-shift-date = p-fact-date
     3328         p-shift-num  = 24
     3329       .
     3330     end.
     3331     define variable v-shift-offset as integer no-undo .
     3332     if p-shift-date = p-fact-date
     3333     then do:
     3334       assign
     3335         v-shift-offset = 1
     3336       .
     3337     end.
     3338     if p-shift-date < p-fact-date
     3339     then do:
     3340       assign
     3341         v-shift-offset = 0
     3342       .
     3343     end.
     3344     if p-shift-date > p-fact-date
     3345     then do:
     3346       message
     3347         vss-workfile vss-revision vss-description skip
     3348         "Неправильная дата закрытия смены" skip
     3349         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3350         view-as alert-box error .
     3351       undo, return error
     3352         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3353           ,string(p-fact-date, '99/99/9999':U)
     3354           ,string(p-shift-date, '99/99/9999':U)
     3355           )
     3356       .
     3357     end.
     3358     if p-shift-num < 1
     3359     or p-shift-num > 24
     3360     then do:
     3361       message
     3362         vss-workfile vss-revision vss-description skip
     3363         "Неправильный номер смены" skip
     3364         "p-shift-num" p-shift-num skip
     3365         view-as alert-box error .
     3366       undo, return error return-value .
     3367     end.
     3368     assign
     3369       p-fact-order           = v-fact-date-num
     3370                              + v-shift-offset * 0.5
     3371                              + p-shift-num    * 0.02 - 0.01
     3372                              + p-fact-num     * 0.0000000001
     3373       p-shift-end-fact-order = v-fact-date-num
     3374                              + v-shift-offset * 0.5
     3375                              + p-shift-num    * 0.02
     3376       p-day-end-fact-order   = v-fact-date-num
     3377                              + 0.99
     3378     .
     3379     if p-fact-order           <= v-fact-date-num
     3380     or p-shift-end-fact-order <= v-fact-date-num
     3381     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3382     or p-shift-end-fact-order >= p-day-end-fact-order
     3383     then do:
     3384       message
     3385         vss-workfile vss-revision vss-description skip
     3386         "Внутренняя ошибка при генерации фактического номера" skip
     3387         "p-fact-date"            p-fact-date            skip
     3388         "p-fact-time"            p-fact-time            skip
     3389         "p-fact-num"             p-fact-num             skip
     3390         "p-shift-date"           p-shift-date           skip
     3391         "p-shift-num"            p-shift-num            skip
     3392         "p-shift-on"             p-shift-on             skip
     3393         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3394         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3395         "v-fact-date-num"        v-fact-date-num        skip
     3396         view-as alert-box error .
     3397       undo, return error return-value .
     3398     end.
     3399   end procedure.
     3400   procedure day-begin-fact-order :
     3401     define input  parameter p-fact-date            as date    no-undo .
     3402     define output parameter p-day-begin-fact-order as decimal no-undo .
     3403     do
     3404     on error undo, return error return-value
     3405     :
     3406       if p-fact-date = ?
     3407       then do:
     3408         assign
     3409           p-day-begin-fact-order = 0
     3410         .
     3411       end.
     3412       else do:
     3413         assign
     3414           p-day-begin-fact-order = integer(p-fact-date)
     3415         .
     3416       end.
     3417     end.
     3418   end procedure.
     3419   procedure factord-max-fact-order :
     3420     define output parameter p-max-fact-order as decimal   no-undo .
     3421     do
     3422     on error undo, return error return-value
     3423     :
     3424       run day-begin-fact-order in this-procedure
     3425         (input  date(1, 1, 5000)
     3426         ,output p-max-fact-order
     3427         ) .
     3428     end.
     3429   end procedure.
     3430   procedure factord-cut-archive :
     3431     define input  parameter p-obj-type             as character no-undo .
     3432     define input  parameter p-obj-code             as integer   no-undo .
     3433     define input  parameter p-fact-date            as date      no-undo .
     3434     define output parameter p-shift-on             as logical   no-undo .
     3435     define output parameter p-shift-date           as date      no-undo .
     3436     define output parameter p-shift-num            as integer   no-undo .
     3437     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3438     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3439     define variable v-fact-order as decimal   no-undo .
     3440     define buffer buf_shift-obj for ub.shift-obj .
     3441     do
     3442     on error undo, return error return-value
     3443     :
     3444   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3446     (input  p-obj-type
     3447     ,input  p-obj-code
     3448     ,input  'shift-on=request'
     3449     ,output p-shift-on
     3450     ) no-error .
     3451       if error-status :error
     3452       then do:
     3453         message
     3454           vss-workfile vss-revision vss-description skip
     3455           "Ошибка при определении атрибута объекта" skip
     3456           "Объект" p-obj-type p-obj-code skip
     3457           error-status :get-message(1) skip
     3458           return-value skip
     3459           view-as alert-box error .
     3460         undo, return error return-value .
     3461       end.
     3462       if p-shift-on = false
     3463       then do:
     3464         assign
     3465           p-shift-date               = ?
     3466           p-shift-num                = 0
     3467         .
     3468       end.
     3469       else do:
     3470         find first buf_shift-obj share-lock
     3471           where buf_shift-obj.obj-type   = p-obj-type
     3472             and buf_shift-obj.obj-code   = p-obj-code
     3473             and buf_shift-obj.shift-date > p-fact-date
     3474           use-index pi
     3475           no-error .
     3476         if not available buf_shift-obj
     3477         or buf_shift-obj.status_ <> 'зкр':U
     3478         then do:
     3479           message
     3480             vss-workfile vss-revision vss-description skip
     3481             "Невозможно вычислить последнюю смену" skip
     3482             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3483             "Объект" p-obj-type p-obj-code skip
     3484             "Дата" p-fact-date skip
     3485             view-as alert-box error .
     3486           undo, return error return-value .
     3487         end.
     3488         find last buf_shift-obj share-lock
     3489           where buf_shift-obj.obj-type = p-obj-type
     3490             and buf_shift-obj.obj-code = p-obj-code
     3491             and buf_shift-obj.shift-date <= p-fact-date
     3492           use-index pi
     3493           no-error .
     3494         if available buf_shift-obj
     3495         then do:
     3496           if  buf_shift-obj.status_ = 'зкр':U
     3497           then do:
     3498             assign
     3499               p-shift-date = buf_shift-obj.shift-date
     3500               p-shift-num  = buf_shift-obj.shift-num
     3501             .
     3502           end.
     3503           else do:
     3504             message
     3505               vss-workfile vss-revision vss-description skip
     3506               "Невозможно вычислить последнюю смену" skip
     3507               "Статус смены отличен от статуса" 'зкр':U skip
     3508               "Объект" p-obj-type p-obj-code skip
     3509               "Дата" p-fact-date skip
     3510               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3511               view-as alert-box error .
     3512             undo, return error return-value .
     3513           end.
     3514         end.
     3515         else do:
     3516           assign
     3517             p-shift-date = p-fact-date - 1
     3518             p-shift-num  = 1
     3519           .
     3520         end.
     3521       end.
     3522       run factord in this-procedure
     3523         (input  p-fact-date
     3524         ,input  1
     3525         ,input  1
     3526         ,input  p-shift-date
     3527         ,input  p-shift-num
     3528         ,input  p-shift-on
     3529         ,output v-fact-order
     3530         ,output p-shift-end-fact-order
     3531         ,output p-day-end-fact-order
     3532         ) no-error .
     3533       if error-status :error
     3534       then do:
     3535         message
     3536           vss-workfile vss-revision vss-description skip
     3537           "Ошибка при вызове процедуры factord"
     3538           error-status :get-message(1) skip
     3539           return-value skip
     3540           view-as alert-box error .
     3541         undo, return error return-value .
     3542       end.
     3543     end.
     3544   end procedure.
     3545   procedure factord-lock-shift :
     3546     define input  parameter p-obj-type  as character no-undo .
     3547     define input  parameter p-obj-code  as integer   no-undo .
     3548     define input  parameter p-fact-date as date      no-undo .
     3549     define parameter buffer buf_shift-obj for ub.shift-obj .
     3550     define variable v-shift-on      as logical   no-undo .
     3551     define variable v-extra-message as character no-undo .
     3552     define variable v-error as character no-undo .
     3553     do
     3554     on error undo, return error return-value
     3555     :
     3556   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3558     (input  p-obj-type
     3559     ,input  p-obj-code
     3560     ,input  'shift-on=request'
     3561     ,output v-shift-on
     3562     ) no-error .
     3563       if error-status :error
     3564       then do:
     3565         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3566         undo, return error v-error .
     3567       end.
     3568       if v-shift-on = true
     3569       then do:
     3570         find first buf_shift-obj share-lock
     3571           where buf_shift-obj.obj-type   = p-obj-type
     3572             and buf_shift-obj.obj-code   = p-obj-code
     3573             and buf_shift-obj.shift-date > p-fact-date
     3574           use-index pi
     3575           no-error .
     3576         if not available buf_shift-obj
     3577         or buf_shift-obj.status_ <> 'зкр':U
     3578         then do:
     3579           find last buf_shift-obj
     3580             where buf_shift-obj.obj-type = p-obj-type
     3581               and buf_shift-obj.obj-code = p-obj-code
     3582               and buf_shift-obj.status_  = 'зкр':U
     3583             use-index stts
     3584             no-error .
     3585           if available buf_shift-obj
     3586           then do:
     3587             assign
     3588               v-extra-message =
     3589                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3590                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3591                               )
     3592             .
     3593           end.
     3594           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3595           undo, return error v-error .
     3596         end.
     3597       end.
     3598     end.
     3599   end procedure.
     3600   procedure factord-end-day :
     3601     define input  parameter p-fact-date            as date    no-undo .
     3602     define output parameter p-day-end-fact-order   as decimal no-undo .
     3603     do
     3604     on error undo, return error return-value
     3605     :
     3606       if p-fact-date = ?
     3607       then do:
     3608         return error "Не указана фактическая дата" .
     3609       end.
     3610       assign
     3611         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3612       .
     3613     end.
     3614   end procedure.
     3615   procedure factord-to-date :
     3616     define input  parameter p-fact-order as decimal no-undo .
     3617     define output parameter p-fact-date  as date    no-undo .
     3618     define variable v-ref-date  as date      no-undo .
     3619     define variable v-ref-delta as integer   no-undo .
     3620     do
     3621     on error undo, return error return-value
     3622     :
     3623       if p-fact-order = ?
     3624       or p-fact-order = 0
     3625       then do:
     3626         return error "Не указан fact-order" .
     3627       end.
     3628       assign
     3629         v-ref-date  = date(1, 1, 2000)
     3630       .
     3631       assign
     3632         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3633       .
     3634       assign
     3635         p-fact-date = v-ref-date + v-ref-delta
     3636       .
     3637     end.
     3638   end procedure.
     3639   procedure factord-to-fact-num :
     3640     define input  parameter p-fact-order as decimal no-undo .
     3641     define output parameter p-fact-num   as integer no-undo .
     3642     define variable v-fact-order-trunc as decimal no-undo .
     3643     do
     3644     on error undo, return error return-value
     3645     :
     3646       if p-fact-order = ?
     3647       or p-fact-order = 0
     3648       then do:
     3649         return error "Не указан fact-order" .
     3650       end.
     3651       assign
     3652        v-fact-order-trunc = truncate(p-fact-order, 2)
     3653       .
     3654       assign
     3655         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3656       .
     3657     end.
     3658   end procedure.
     3659   procedure factord-to-shift-num :
     3660     define input  parameter p-fact-order as decimal no-undo .
     3661     define output parameter p-shift-num   as integer no-undo .
     3662     define variable  p-shift-numd  as decimal   no-undo .
     3663     define variable v-fact-order-trunc as decimal no-undo .
     3664     do
     3665     on error undo, return error return-value
     3666     :
     3667       if p-fact-order = ?
     3668       or p-fact-order = 0
     3669       then do:
     3670         return error "Не указан fact-order" .
     3671       end.
     3672       assign
     3673        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3674       .
     3675       if v-fact-order-trunc < 0.5 then do:
     3676         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3677       end.
     3678       assign
     3679         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3680         .
     3681        assign
     3682         p-shift-num = truncate (p-shift-numd , 0)
     3683       .
     3684     end.
     3685   end procedure.
     3686   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3687   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3688   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3689   define variable par-type          as character no-undo.
     3690   define variable v-value-character as character no-undo .
     3691   define variable v-value-date      as date      no-undo .
     3692   define variable v-value-decimal   as decimal   no-undo .
     3693   define variable v-value-integer   as integer   no-undo .
     3694   define variable v-value-logical   as logical   no-undo .
     3695   if valid-handle (g#libtfarh)
     3696   and g#libtfarh <> this-procedure :handle
     3697   and g#libtfarh :get-signature('libtfarh_finincex':u) <> ""
     3698   then do:
     3699     message
     3700       vss-workfile vss-revision vss-description skip
     3701       "Попытка повторной загрузки библиотеки для работы с финансовыми архивами по складским документам"  skip
     3702       g#libtfarh skip
     3703       g#libtfarh :type skip
     3704       g#libtfarh :file-name skip
     3705       valid-handle(g#libtfarh) skip
     3706       this-procedure :handle skip
     3707       this-procedure :type skip
     3708       this-procedure :file-name skip
     3709       valid-handle(this-procedure) skip
     3710       view-as alert-box error .
     3711     undo, return error .
     3712   end.
     3713   else do:
     3714     assign
     3715       g#libtfarh = this-procedure :handle
     3716     .
     3717   end.
     3718   on delete of this-procedure do:
     3719     assign
     3720       g#libtfarh = ?
     3721     .
     3722   end.
     3723   define stream str-err.
     3724   procedure libtfarh_finincex:
     3725   define input  parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     3726   define output parameter parinc-exp      as   integer                 no-undo.
     3727   do on error undo, return error return-value :
     3728   case parext-doc-type:
     3729     when 'ie':U          or
     3730     when 're':U      or
     3731     when 'rs':U or
     3732     when 'ap':U     then do:
     3733       assign
     3734         parinc-exp = 1.
     3735     end.
     3736     when 'ep':U       or
     3737     when 'ee':U          or
     3738     when 'es':U     or
     3739     when 'we':U          or
     3740     when 'em':U           or
     3741     when 'wm':U           or
     3742     when 'vt':U                or
     3743     when 'vp':U           or
     3744     when 'mp':U   then do:
     3745       assign
     3746         parinc-exp = 2.
     3747     end.
     3748     when 'iv':U      or
     3749     when 'ev':U      or
     3750     when 'io':U     or
     3751     when 'eo':U     or
     3752     when 'rv':U  or
     3753     when 'im':U       or
     3754     when 'pc':U or
     3755     when 'ot':U       then do:
     3756       assign
     3757         parinc-exp = 0.
     3758     end.
     3759     otherwise do:
     3760       return error substitute ("Не могу обработать расширенный тип документа &1 для обработки финансов.", parext-doc-type).
     3761     end.
     3762   end case.
     3763   end.
     3764   end procedure.
     3765   procedure libtfarh_finincexforgenfo:
     3766   define input  parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     3767   define output parameter parinc-exp      as   integer                 no-undo.
     3768   do on error undo, return error return-value :
     3769   case parext-doc-type:
     3770     when 'ie':U          or
     3771     when 'ap':U     or
     3772     when 'ep':U       then do:
     3773       assign
     3774         parinc-exp = 1.
     3775     end.
     3776     when 'ee':U          or
     3777     when 'es':U     or
     3778     when 'we':U          or
     3779     when 'em':U           or
     3780     when 'wm':U           or
     3781     when 're':U      or
     3782     when 'rs':U or
     3783     when 'pc':U     or
     3784     when 'vt':U                or
     3785     when 'mp':U   then do:
     3786       assign
     3787         parinc-exp = 2.
     3788     end.
     3789     when 'vp':U           then do:
     3790       assign
     3791         parinc-exp = 3.
     3792     end.
     3793     when 'iv':U      or
     3794     when 'ev':U      or
     3795     when 'io':U     or
     3796     when 'eo':U     or
     3797     when 'rv':U  or
     3798     when 'im':U       or
     3799     when 'ot':U       then do:
     3800       assign
     3801         parinc-exp = 0.
     3802     end.
     3803     otherwise do:
     3804       return error substitute ("Не могу обработать расширенный тип документа &1 для обработки финансов.", parext-doc-type).
     3805     end.
     3806   end case.
     3807   end.
     3808   end procedure.
     3809   procedure libtfarh_st-fo:
     3810   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     3811   define variable varcr-buyfo as logical no-undo.
     3812   define variable varcr-expfo as logical no-undo.
     3813   define variable varcr-incfo as logical no-undo.
     3814   define variable varundef    as logical no-undo.
     3815   define variable varundefb   as logical no-undo.
     3816   define variable varinc-exp  as integer no-undo.
     3817   define buffer buf_trn-doc  for ub.trn-doc.
     3818   define buffer buf_parts    for ub.parts.
     3819   define buffer buf_contract for ub.contract.
     3820   define buffer buf_doc-attr for ub.doc-attr  .
     3821   define buffer buf_fin-ob-trn for ub.fin-ob-trn.
     3822   define buffer buf_fin-ob     for ub.fin-ob.
     3823   do on error undo, return error return-value :
     3824   find first buf_trn-doc where buf_trn-doc.doc-code = pardoc-code exclusive-lock.
     3825   if buf_trn-doc.status_ = 'факт':U then do :
     3826   assign
     3827     buf_trn-doc.expfo-date      = 01/01/1990
     3828     buf_trn-doc.incfo-date      = 01/01/1990
     3829     buf_trn-doc.factur-date     = 01/01/1990
     3830     buf_trn-doc.buyer-fo-date   = 01/01/1990
     3831     buf_trn-doc.cr-incfo        = no
     3832     buf_trn-doc.cr-expfo        = no
     3833     buf_trn-doc.cr-incorexpfo   = no
     3834     buf_trn-doc.cr-factur       = no
     3835     buf_trn-doc.cr-fo-buyer     = no
     3836     buf_trn-doc.need-expfo      = 0
     3837     buf_trn-doc.need-incfo      = 0
     3838     buf_trn-doc.need-incorexpfo = 0
     3839     buf_trn-doc.need-factur     = 0
     3840     buf_trn-doc.need-buyer      = 0
     3841   .
     3842   assign
     3843     varcr-buyfo = no
     3844     varcr-expfo = no
     3845     varcr-incfo = no
     3846     varundefb   = no
     3847     varundef    = no.
     3848   run libtfarh_finincexforgenfo in this-procedure (input  buf_trn-doc.ext-doc-type,
     3849                                                    output varinc-exp ) no-error.
     3850   if error-status:error then do:
     3851     return error return-value.
     3852   end.
     3853   find first buf_doc-attr no-lock where
     3854              buf_doc-attr.doc-code  = buf_trn-doc.doc-code and
     3855              buf_doc-attr.attr-code = 'olsuppcntr':U  no-error .
     3856   if available buf_doc-attr  then do:
     3857      if buf_doc-attr.attr-value = "yes" then  varinc-exp = 0 .
     3858   end.
     3859   case varinc-exp:
     3860     when 1 then do:
     3861       parts-cycle:
     3862       for each buf_parts where buf_parts.out-code = buf_trn-doc.doc-code no-lock on error undo, return error return-value :
     3863         if buf_parts.contract-code <> 0 then do:
     3864           find first buf_contract where buf_contract.contract-code = buf_parts.contract-code no-lock no-error.
     3865           if available buf_contract then do:
     3866             if lookup (buf_contract.usl-opl, 'По факту поставки,Отсрочка платежа (по поставке)') > 0 then do:
     3867               assign
     3868                 varcr-incfo = yes.
     3869               leave parts-cycle.
     3870             end.
     3871             if buf_contract.usl-opl = 'Не определено':U then do:
     3872               assign
     3873                 varundef = yes.
     3874             end.
     3875           end.
     3876         end.
     3877       end.
     3878       if varcr-incfo = yes then do:
     3879         assign
     3880           buf_trn-doc.need-incfo      = 1
     3881           buf_trn-doc.need-incorexpfo = 1.
     3882       end.
     3883       else do:
     3884         if varundef = yes then do:
     3885           assign
     3886             buf_trn-doc.need-incfo      = 2
     3887             buf_trn-doc.need-incorexpfo = 2.
     3888         end.
     3889       end.
     3890     end.
     3891     when 2 then do:
     3892       parts-cycle:
     3893       for each buf_parts where buf_parts.out-code = buf_trn-doc.doc-code no-lock on error undo, return error return-value :
     3894         if buf_parts.contract-code <> 0 then do:
     3895           find first buf_contract where buf_contract.contract-code = buf_parts.contract-code no-lock no-error.
     3896           if available buf_contract then do:
     3897             if lookup (buf_contract.usl-opl, 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)') > 0 and
     3898                not (buf_parts.purch-code = integer('1':U) and buf_contract.contract-type = 'Ответственного хранения':U) then do:
     3899               assign
     3900                 varcr-expfo = yes.
     3901               leave parts-cycle.
     3902             end.
     3903             if buf_contract.usl-opl = 'Не определено':U then do:
     3904               assign
     3905                 varundef = yes.
     3906             end.
     3907           end.
     3908         end.
     3909       end.
     3910       if varcr-expfo = yes then do:
     3911         assign
     3912           buf_trn-doc.need-expfo      = 1
     3913           buf_trn-doc.need-incorexpfo = 1.
     3914       end.
     3915       else do:
     3916         if varundef = yes then do:
     3917           assign
     3918             buf_trn-doc.need-expfo      = 2
     3919             buf_trn-doc.need-incorexpfo = 2.
     3920         end.
     3921       end.
     3922     end.
     3923       when 3 then do:
     3924       parts-cycle:
     3925       for each buf_parts where buf_parts.out-code = buf_trn-doc.doc-code no-lock on error undo, return error return-value :
     3926         if buf_parts.contract-code <> 0  and buf_parts.fact-qnty < 0 then do:
     3927           find first buf_contract where buf_contract.contract-code = buf_parts.contract-code no-lock no-error.
     3928           if available buf_contract then do:
     3929             if lookup (buf_contract.usl-opl, 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)') > 0 and
     3930                not (buf_parts.purch-code = integer('1':U) and buf_contract.contract-type = 'Ответственного хранения':U) then do:
     3931               assign
     3932                 varcr-expfo = yes.
     3933               leave parts-cycle.
     3934             end.
     3935             if buf_contract.usl-opl = 'Не определено':U then do:
     3936               assign
     3937                 varundef = yes.
     3938             end.
     3939           end.
     3940         end.
     3941       end.
     3942       if varcr-expfo = yes then do:
     3943         assign
     3944           buf_trn-doc.need-expfo      = 1
     3945           buf_trn-doc.need-incorexpfo = 1.
     3946       end.
     3947       else do:
     3948         if varundef = yes then do:
     3949           assign
     3950             buf_trn-doc.need-expfo      = 2
     3951             buf_trn-doc.need-incorexpfo = 2.
     3952         end.
     3953       end.
     3954     end.
     3955     when 0 then do:
     3956     end.
     3957     otherwise do:
     3958       return error substitute ("Неизвестный параметр &1 получен от процедуры libtfarh_fin-inc-exp.", varinc-exp).
     3959     end.
     3960   end case.
     3961    if buf_trn-doc.ext-doc-type = 'ie':U  then do:
     3962      find first buf_contract where buf_contract.contract-code = buf_trn-doc.contract-code no-lock no-error.
     3963      if available buf_contract then do:
     3964        if (buf_contract.gen-factur = 1 or buf_contract.gen-factur = 11 or buf_contract.gen-factur = 101 or buf_contract.gen-factur = 111) then do:
     3965          assign  buf_trn-doc.need-factur = 1 .
     3966        end.
     3967      end.
     3968    end.
     3969    if buf_trn-doc.ext-doc-type = 'pc':U then do:
     3970      define buffer bf_trn-doc for ub.trn-doc .
     3971      for each buf_parts no-lock where buf_parts.out-code = buf_trn-doc.doc-code :
     3972        find first bf_trn-doc no-lock where bf_trn-doc.doc-code = buf_parts.in-code no-error .
     3973        if available bf_trn-doc then do:
     3974          find first buf_contract where buf_contract.contract-code = bf_trn-doc.contract-code no-lock no-error.
     3975          if available buf_contract then do:
     3976            if buf_contract.gen-factur = 4 or buf_contract.gen-factur = 14 or buf_contract.gen-factur = 104 or buf_contract.gen-factur = 114 then do:
     3977              assign  buf_trn-doc.need-factur = 1 .
     3978              LEAVE.
     3979            end.
     3980          end.
     3981        end.
     3982      end.
     3983    end.
     3984   end.
     3985   if ( buf_trn-doc.ext-doc-type = 'ee':U or
     3986        buf_trn-doc.ext-doc-type = 're':U ) and
     3987        buf_trn-doc.contract-code <> 0 then
     3988           for first buf_contract where buf_contract.contract-code = buf_trn-doc.contract-code no-lock :
     3989             if buf_contract.doc-type = 'рас':U and lookup (buf_contract.usl-opl, 'Предоплата,Предоплата(%)') > 0 then do :
     3990                define variable v-fo-gen as integer no-undo .
     3991   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3992   empty temp-table thbjattr_thbj-attr.
     3993   run adm/shattri.p (
     3994      input "get":U
     3995     ,input ''
     3996     ,input 0
     3997     ,input 'fin-global':U
     3998     ,input  ""
     3999     ,output v-value-character
     4000     ,output v-value-date
     4001     ,output v-value-decimal
     4002     ,output v-value-integer
     4003     ,output v-value-logical
     4004     ,output par-type
     4005     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4006     ) no-error .
     4007                 for each thbjattr_thbj-attr :
     4008                     if thbjattr_thbj-attr.prop-code = 'fo-gen':U  then v-fo-gen = thbjattr_thbj-attr.property-value-integer .
     4009                 end.
     4010                 if buf_trn-doc.status_ = 'накл':U and buf_trn-doc.flag_ and (v-fo-gen = 2 or v-fo-gen = 3) then buf_trn-doc.need-buyer = 1.
     4011                 if buf_trn-doc.status_ = 'разрешен':U                  and (v-fo-gen = 4 or v-fo-gen = 5) then buf_trn-doc.need-buyer = 1.
     4012                 if buf_trn-doc.status_ = 'факт':U                       and (v-fo-gen = 6 or v-fo-gen = 7) then buf_trn-doc.need-buyer = 1.
     4013                 if buf_trn-doc.status_ = 'факт':U then do :
     4014                   for each buf_fin-ob-trn where buf_fin-ob-trn.trn-doc-code = buf_trn-doc.doc-code  and
     4015                                                 buf_fin-ob-trn.host-code    = buf_trn-doc.host-code exclusive-lock,
     4016                           each buf_fin-ob where buf_fin-ob.doc-code = buf_fin-ob-trn.doc-code  exclusive-lock
     4017                           :
     4018                              if buf_fin-ob.status_ <> 'факт':U then do :
     4019                               undo, return error "Данная накладная не может быть закрыта на факт, т.к. по ней есть незакрытое ФО" .
     4020                              end.
     4021                   end.
     4022                 end.
     4023             end.
     4024             if buf_trn-doc.status_ = 'факт':U and lookup (buf_contract.usl-opl, 'По факту поставки покупателю,Отсрочка платежа по поставке') > 0 then do:
     4025                 assign
     4026                   buf_trn-doc.need-buyer = 1.
     4027             end.
     4028             if buf_trn-doc.status_ = 'факт':U and buf_contract.usl-opl = 'Не определено':U then do:
     4029               assign
     4030                 buf_trn-doc.need-buyer = 2.
     4031             end.
     4032   end.
     4033   end.
     4034   end procedure.
     4035   procedure libtfarh_datrncnt :
     4036   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     4037   define buffer bf_trn-doc for ub.trn-doc.
     4038   define buffer bf_arh-trn-doc-contract        for ub.arh-trn-doc-contract.
     4039   define buffer bf-reclc_arh-trn-doc-contract  for ub.arh-trn-doc-contract.
     4040   define variable varinc-exp as integer no-undo.
     4041   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     4042   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     4043   if not available bf_trn-doc then do:
     4044     return error substitute ("Не найден складской документ с номером &1.", pardoc-code).
     4045   end.
