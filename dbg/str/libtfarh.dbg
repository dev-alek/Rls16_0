     1808     (input  bf_trn-doc.obj-type
     1809     ,input  bf_trn-doc.obj-code
     1810     ,input  varb-code
     1811     ,input  0
     1812     ,input  bf_trn-doc.fact-order
     1813     ,output vardoc-num
     1814     ,output varprice-sale
     1815     ,output varroad-tax
     1816     ,output varexcise
     1817     )  .
     1818             if varprice-sale = ?
     1819             then do:
     1820               assign
     1821                 varprice-sale = 0
     1822                 varroad-tax   = 0
     1823                 varexcise     = 0
     1824               .
     1825             end.
     1826             assign
     1827               varlastcur-base     = varprice-sale
     1828               varlastcur-road-tax = varroad-tax
     1829               varlastcur-excise   = varexcise
     1830               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1831               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1832               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1833               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1834             .
     1835         end.
     1836       end.
     1837       if varcur-fact-qnty = 0 then do:
     1838         assign
     1839           varcur-base      = varlastcur-base
     1840           varcur-road-tax  = varlastcur-road-tax
     1841           varcur-excise    = varlastcur-excise
     1842         .
     1843       end.
     1844       else do:
     1845         assign
     1846           varcur-base      = varcur-base      / varcur-fact-qnty
     1847           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1848           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1849         .
     1850       end.
     1851       if varcur-vat-pc = ?
