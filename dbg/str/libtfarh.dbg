      643   end.
      644   else do:
      645     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
      646                                  and out-vatp_partscl.obj-type   = parobj-type
      647                                  and out-vatp_partscl.obj-code   = parobj-code
      648                                  and out-vatp_partscl.artic      = parartic
      649                                  and out-vatp_partscl.prod-type  = parprod-type
      650                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      651       if out-vatp_partscl.purch-code = 2 then do:
      652   assign
      653     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
      654     price-base-with-tax-lococl = out-vatp_partscl.price-base
      655   .
      656   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      658     (output varinvprbocl
      659     )  .
      660     if out-vatp_partscl.out-code = 'free-zone':U     or
      661        out-vatp_partscl.out-code = 'out-zone':U   or
      662        out-vatp_partscl.doc-type = 'акт':U then do:
      663       assign
      664         in-vatp-have-vat-sltocl = yes.
      665     end.
      666     else do:
      667       find first in-vatp_doc-attrocl no-lock
      668         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
      669           and in-vatp_doc-attrocl.attr-code = 'envd':U
      670         no-error .
      671       if not available in-vatp_doc-attrocl then do:
      672         assign
      673           in-vatp-have-vat-sltocl = yes.
      674       end.
      675       else do:
      676            in-vatp-have-vat-sltocl = no.
      677       end.
      678     end.
      679     assign
      680      price-cli-with-tax-lococl = out-vatp_partscl.price-cli
      681      cli-base-rateocl          = out-vatp_partscl.cli-base-rate.
      682     ASSIGN   road-tax-base-lococl  = (if out-vatp_partscl.road-tax-base  = ? then 0 else out-vatp_partscl.road-tax-base)
      683              road-tax-rubl-lococl  = (if out-vatp_partscl.road-tax-rubl  = ? then 0 else out-vatp_partscl.road-tax-rubl).
      684     ASSIGN  transport-base-lococl = (if out-vatp_partscl.transport-base = ? then 0 else out-vatp_partscl.transport-base)
      685             transport-rubl-lococl = (if out-vatp_partscl.transport-rubl = ? then 0 else out-vatp_partscl.transport-rubl)
      686             other-base-lococl     = (if out-vatp_partscl.other-base     = ? then 0 else out-vatp_partscl.other-base)
      687             other-rubl-lococl     = (if out-vatp_partscl.other-rubl     = ? then 0 else out-vatp_partscl.other-rubl)
      688             vat-pc-lococl         = (if out-vatp_partscl.vat-pc         = ? then 0 else out-vatp_partscl.vat-pc)
      689             slt-pc-lococl         = (if out-vatp_partscl.slt-pc         = ? then 0 else out-vatp_partscl.slt-pc).
      690             ASSIGN   slt-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      691       ASSIGN   slt-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      692     assign
      693       exch-rate-cli-lococl = (out-vatp_partscl.price-rubl - transport-rubl-lococl - other-rubl-lococl - road-tax-rubl-lococl - (if out-vatp_partscl.vat-type <> 'в т. ч.':U then vat-rubl-lococl else 0) - (if out-vatp_partscl.slt-type <> 'в т. ч.':U then slt-rubl-lococl else 0)) / out-vatp_partscl.price-cli .
      694     assign
      695       slt-cli-lococl        = slt-rubl-lococl       / exch-rate-cli-lococl
      696       vat-cli-lococl        = vat-rubl-lococl       / exch-rate-cli-lococl
      697       road-tax-cli-lococl   = road-tax-rubl-lococl  / exch-rate-cli-lococl
      698       transport-cli-lococl  = 0
      699       other-cli-lococl      = 0
      700     .
      701   ASSIGN
      702             price-base-without-tax-lococl = price-base-with-tax-lococl - vat-base-lococl - slt-base-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))
      703       price-rubl-without-tax-lococl = price-rubl-with-tax-lococl - vat-rubl-lococl - slt-rubl-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))
      704   .
