        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Smart browser общения со связкой ТРК-пистолет".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable varmes-log as logical no-undo.
      132   define variable parparentproc as widget-handle no-undo .
      133   define variable varobj-type like ub.clients.obj-type no-undo.
      134   define variable varobj-code like ub.clients.obj-code no-undo.
      135   define variable varbuttons  as   character        no-undo.
      136   define variable varps-upd   as   logical          no-undo.
      137   procedure pumpnzdv:
      138   define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      139   define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      140   define input parameter parpump-code   like ub.pump.pump-code     no-undo.
      141   define input parameter parnozzle-code like ub.nozzle.nozzle-code no-undo.
      142   define buffer bf_clients        for ub.clients.
      143   define buffer bf_pump-nozzle    for ub.pump-nozzle.
      144   define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
      145   define variable varrec-id as recid no-undo.
      146   define variable varmes-log as logical no-undo.
      147   define variable varobj-type like ub.clients.obj-type no-undo.
      148   define variable varobj-code like ub.clients.obj-code no-undo.
      149   define variable varbuttons  as   character        no-undo.
      150   define variable varps-upd   as   logical          no-undo.
      151   find first bf_clients where bf_clients.obj-type = parobj-type and
      152                               bf_clients.obj-code = parobj-code no-lock no-error.
      153   if not available bf_clients then
      154      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      155   find first bf_pump-nozzle where bf_pump-nozzle.obj-type    = parobj-type   and
      156                                   bf_pump-nozzle.obj-code    = parobj-code   and
      157                                   bf_pump-nozzle.pump-code   = parpump-code  and
      158                                   bf_pump-nozzle.nozzle-code = parnozzle-code
      159                                   no-lock no-error.
      160   if not available bf_pump-nozzle then
      161      return error SUBSTITUTE("Не найден запись ТРК-пистлет с номером ТРК &1 и номером пистлета &2", parpump-code, parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      162   assign varrec-id = RECID(bf_pump-nozzle).
      163   run chkcsptr (input parobj-type,
      164                 input parobj-code) no-error.
      165   if error-status:error then return error trim(return-value) +
      166                                           trim(error-status:get-message(1)) +
      167                                           trim(error-status:get-message(2)) +
      168                                           trim(error-status:get-message(3)) +
      169                                           trim(error-status:get-message(4)) +
      170                                           trim(error-status:get-message(5)).
      171   tr:
      172   do transaction on error undo tr, return error
      173                  on stop  undo tr, return error
      174                  on quit  undo tr, return error :
      175     for each bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = parobj-type    and
      176                                      bf_pl-pump-nozzle.obj-code    = parobj-code    and
      177                                      bf_pl-pump-nozzle.pump-code   = parpump-code   and
      178                                      bf_pl-pump-nozzle.nozzle-code = parnozzle-code exclusive-lock
      179                                      on error undo tr, return error
      180                                      on stop  undo tr, return error
      181                                      on quit  undo tr, return error :
      182         delete bf_pl-pump-nozzle.
      183     end.
      184     find first bf_pump-nozzle where RECID(bf_pump-nozzle) = varrec-id exclusive-lock.
      185     delete bf_pump-nozzle.
      186   end.
      187   end procedure.
      188   procedure chkcsptr:
      189   define input parameter parobj-type   like ub.clients.obj-type     no-undo.
      190   define input parameter parobj-code   like ub.clients.obj-code     no-undo.
      191   define variable        varretobjat   as   character            no-undo.
      192   define variable        varshift-date like ub.shift-obj.shift-date no-undo.
      193   define variable        varshift-num  like ub.shift-obj.shift-num  no-undo.
      194   define buffer bf_clients   for ub.clients.
      195   define buffer bf_shift-obj for ub.shift-obj.
      196   define buffer bf_rvs-doc   for ub.rvs-doc.
      197   find first bf_clients where bf_clients.obj-type = parobj-type and
      198                               bf_clients.obj-code = parobj-code no-lock no-error.
      199   if not available bf_clients then return error "Нет такого объекта " + parobj-type +
      200                                                 " "                   + string(parobj-code) + ".".
      201   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      203     (input  parobj-type
      204     ,input  parobj-code
      205     ,input  'shift-on=request'
      206     ,output varretobjat
      207     ) no-error .
      208   if error-status:error then  return error "Ошибка при вызове файла library.p: objat".
      209   if varretobjat <> "yes" then do:
      210      return error "Фатальная ошибка. На объекте " + parobj-type + " " + string(parobj-code) + " не включены смены.".
      211   end.
      212   find first bf_shift-obj
      213        where bf_shift-obj.obj-type = parobj-type
      214          and bf_shift-obj.obj-code = parobj-code
      215          and bf_shift-obj.status_  = 'тек':U
      216         use-index pi no-error .
      217   if available bf_shift-obj then do:
      218      find first bf_rvs-doc where bf_rvs-doc.obj-type   = parobj-type             and
      219                                  bf_rvs-doc.obj-code   = parobj-code             and
      220                                  bf_rvs-doc.shift-date = bf_shift-obj.shift-date and
      221                                  bf_rvs-doc.shift-num  = bf_shift-obj.shift-num  and
      222                                  bf_rvs-doc.status_    = 'факт':U                 and
      223                                  bf_rvs-doc.rvs-type   = 'смена':U            no-lock no-error.
      224      if not available bf_rvs-doc then
      225      return error "Смена открыта и не сделан документ сверки типа 'смена' за текущую смену.".
      226   end.
      227   end procedure.
      228   define variable is-ef-chr as character no-undo .
      229   define variable var-type as character no-undo .
      230   define variable is-ef as logical no-undo .
      231   define variable gds-rec             AS recid     no-undo.
      232   define variable v-chk-act-host-code as integer   no-undo .
      233   define variable glog                as logical   no-undo .
      234   define variable v-userid            as character no-undo .
      235   define variable v-db-num            as integer   no-undo .
      236   define variable v-host-code         as integer   no-undo .
      237   define variable v-obj-type          as character no-undo .
      238   define variable v-obj-code          as integer   no-undo .
      239   define variable v-active as character no-undo .
      240   define variable pl-list as character no-undo .
      241   FUNCTION Get-activ RETURNS CHARACTER
      242     ( v-pum-code as integer, v-nozzle-code as integer )  FORWARD.
      243   RUN set-attribute-list (
      244       'Keys-Accepted = ,
      245        Keys-Supplied = ':U).
      246   RUN set-attribute-list (
      247       'SortBy-Options = ""':U).
      248   DEFINE BUTTON b-add
      249        LABEL "&Добавить"
      250        SIZE 10 BY 1.
      251   DEFINE BUTTON b-del
      252        LABEL "&Удалить"
      253        SIZE 10 BY 1.
      254   DEFINE BUTTON b-help
      255        LABEL "&Помощь"
      256        SIZE 10 BY 1.
      257   DEFINE BUTTON b-hist
      258        LABEL "&История"
      259        SIZE 10 BY 1.
      260   DEFINE VARIABLE lef-nid AS CHARACTER FORMAT "X(20)":U INITIAL "Идентиф. EasyFuel"
      261         VIEW-AS TEXT
      262        SIZE 18 BY .67 NO-UNDO.
      263   DEFINE VARIABLE varef-nid AS CHARACTER FORMAT "X(8)":U
      264        VIEW-AS FILL-IN
      265        SIZE 9 BY 1 NO-UNDO.
      266   DEFINE VARIABLE varps AS CHARACTER FORMAT "X(256)":U
      267        VIEW-AS FILL-IN
      268        SIZE 46.3 BY 1.87 NO-UNDO.
      269   DEFINE VARIABLE varis-meas AS LOGICAL INITIAL no
      270        LABEL "Измеряется"
      271        VIEW-AS TOGGLE-BOX
      272        SIZE 17.3 BY .83 NO-UNDO.
      273   DEFINE VARIABLE varis-activ AS LOGICAL INITIAL yes
      274        LABEL "Активно в МП"
      275        VIEW-AS TOGGLE-BOX
      276        SIZE 17.25 BY .83 NO-UNDO.
      277   DEFINE QUERY br_table FOR
      278         ub.pump-nozzle SCROLLING.
      279   DEFINE BROWSE br_table
      280     QUERY br_table NO-LOCK DISPLAY
      281         pump-nozzle.pump-code
      282         pump-nozzle.nozzle-code
      283         Get-activ(pump-nozzle.pump-code, pump-nozzle.nozzle-code) column-label "Актив."
      284       WITH NO-ASSIGN SEPARATORS SIZE 35.88 BY 7.29.
      285   DEFINE FRAME F-Main
      286        br_table AT ROW 1 COL 1
      287        varis-meas AT ROW 4.37 COL 39.63
      288        varef-nid AT ROW 7.13 COL 39.63 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      289            varis-activ AT ROW 5.28 COL 39.63
      290            varps AT ROW 8.43 COL 1 NO-LABEL AUTO-RETURN
      291        b-add AT ROW 10.53 COL 1.4
      292        b-del AT ROW 10.53 COL 11.8
      293        b-hist AT ROW 10.53 COL 22.1
      294        b-help AT ROW 10.53 COL 32.5
      295        lef-nid AT ROW 6.13 COL 36.63 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      296       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      297            SIDE-LABELS NO-UNDERLINE THREE-D
      298            AT COL 1 ROW 1 SCROLLABLE
      299            BGCOLOR 8 FGCOLOR 0 .
      300   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      301   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      302   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      303   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      304   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      305   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      306   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      307   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      308   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      309   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      310   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      311         adm-object-hdl = FRAME F-Main:HANDLE.
      312   RUN ensure-broker.
      313   THIS-PROCEDURE:ADM-DATA =
      314        'ADM1.1~`':U +
      315        'SmartObject~`':U +
      316        '~`':U +
      317        'YES~`':U +
      318        '~`':U +
      319        'pump-nozzle~`':U +
      320        '~`':U +
      321        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      322           + "~`":U +
      323        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      324        'Record-Source,Record-Target,TableIO-Target~`':U +
      325        '~`':U +
      326        '~`~`~`~`~`~`~`~`~`~`~`':U +
      327        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      328            THEN "^^":U
      329        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      330             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      331   PROCEDURE adm-apply-entry :
      332     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      333   END PROCEDURE.
      334   PROCEDURE adm-destroy :
      335    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      336   END PROCEDURE.
      337   PROCEDURE adm-disable :
      338       DISABLE br_table varis-meas varef-nid varis-activ varps b-add b-del b-hist b-help lef-nid WITH FRAME F-Main.
      339       RUN dispatch ('disable-fields':U).
      340       RUN set-attribute-list ('ENABLED=no':U).
      341       RETURN.
      342   END PROCEDURE.
      343   PROCEDURE adm-edit-attribute-list :
      344         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      345         RETURN.
      346   END PROCEDURE.
      347   PROCEDURE adm-enable :
      348       ENABLE UNLESS-HIDDEN br_table varis-meas varef-nid varis-activ varps b-add b-del b-hist b-help lef-nid WITH FRAME F-Main.
      349       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      350       RUN set-attribute-list ('ENABLED=yes':U).
      351       RETURN.
      352   END PROCEDURE.
      353   PROCEDURE adm-exit :
      354        RUN notify ('exit':U).
      355     RETURN.
      356   END PROCEDURE.
      357   PROCEDURE adm-hide :
      358     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      359   END PROCEDURE.
      360   PROCEDURE adm-initialize :
      361     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      362   END PROCEDURE.
      363   PROCEDURE adm-show-errors :
      364       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      365       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      366           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      367       END.
      368       RETURN.
      369   END PROCEDURE.
      370   PROCEDURE adm-UIB-mode :
      371     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      372   END PROCEDURE.
      373   PROCEDURE adm-view :
      374     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      375   END PROCEDURE.
      376   PROCEDURE dispatch :
      377       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      378       RUN broker-dispatch IN adm-broker-hdl
      379           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      380       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      381   END PROCEDURE.
      382   PROCEDURE ensure-broker :
      383   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      384   IF RETURN-VALUE NE "ADM-Broker":U THEN
      385   DO:
      386       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      387       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      388   END.
      389   END PROCEDURE.
      390   PROCEDURE get-attribute :
      391     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      392     RUN broker-get-attribute IN adm-broker-hdl
      393         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      394     RETURN RETURN-VALUE.
      395   END PROCEDURE.
      396   PROCEDURE get-attribute-list :
      397     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      398     RUN broker-get-attribute-list IN adm-broker-hdl
      399         (INPUT THIS-PROCEDURE,
      400          INPUT ?,
      401          OUTPUT p-attr-list) NO-ERROR.
      402     RETURN.
      403   END PROCEDURE.
      404   PROCEDURE new-state :
      405     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      406     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      407     RETURN.
      408   END PROCEDURE.
      409   PROCEDURE notify :
      410     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      411     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      412     IF RETURN-VALUE = "ADM-ERROR":U THEN
      413         RETURN "ADM-ERROR":U.
      414     RETURN.
      415   END PROCEDURE.
      416   PROCEDURE set-attribute-list :
      417     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      418     RUN ensure-broker.
      419     RUN broker-set-attribute-list IN adm-broker-hdl
      420         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      421     RETURN.
      422   END PROCEDURE.
      423   PROCEDURE set-position :
      424       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      425       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      426       IF VALID-HANDLE(adm-object-hdl) THEN
      427       DO:
      428         ASSIGN adm-object-hdl:ROW    =   p-row
      429                adm-object-hdl:COLUMN =   p-col.
      430       END.
      431       RETURN.
      432   END PROCEDURE.
      433     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      434     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      435     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      436     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      437     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      438     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      439     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      440     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      441     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      442     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      443     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      444     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      445     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      446     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      447     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      448     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      449     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      450     IF "":U = "":U THEN
      451       RUN modify-list-attribute IN adm-broker-hdl
      452         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      453     RUN use-create-on-add(?).
      454   PROCEDURE adm-add-record :
      455       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      456          "must have at least one Enabled Table to perform Add.":U
      457          VIEW-AS ALERT-BOX ERROR.
      458       RETURN.
      459   END PROCEDURE.
      460   PROCEDURE adm-assign-record :
      461    MESSAGE
      462          "Object ":U THIS-PROCEDURE:FILE-NAME
      463            "must have at least one Enabled Table to perform Assign.":U
      464              VIEW-AS ALERT-BOX ERROR.
      465      RETURN.
      466     END PROCEDURE.
      467   PROCEDURE adm-assign-statement :
      468     RETURN.
      469   END PROCEDURE.
      470   PROCEDURE adm-cancel-record :
      471      RETURN.
      472     END PROCEDURE.
      473   PROCEDURE adm-copy-record :
      474       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      475        "must have at least one Enabled Table to perform Copy.":U
      476          VIEW-AS ALERT-BOX ERROR.
      477       RETURN.
      478   END PROCEDURE.
      479   PROCEDURE adm-create-record :
      480      RETURN.
      481   END PROCEDURE.
      482   PROCEDURE adm-current-changed :
      483     RETURN.
      484   END PROCEDURE.
      485   PROCEDURE adm-delete-record :
      486    MESSAGE
      487          "Object ":U THIS-PROCEDURE:FILE-NAME
      488            "must have at least one Enabled Table to perform Delete.":U
      489              VIEW-AS ALERT-BOX ERROR.
      490       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      491       RETURN.
      492   END PROCEDURE.
      493   PROCEDURE adm-disable-fields :
      494         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      495       RETURN.
      496   END PROCEDURE.
      497   PROCEDURE adm-enable-fields :
      498       RETURN.
      499   END PROCEDURE.
      500   PROCEDURE adm-end-update :
      501     RETURN.
      502   END PROCEDURE.
      503   PROCEDURE adm-reset-record :
      504       RETURN.
      505   END PROCEDURE.
      506   PROCEDURE adm-update-record :
      507       MESSAGE
      508         "Object ":U THIS-PROCEDURE:FILE-NAME
      509           "must have at least one Enabled Table to perform Update.":U
      510             VIEW-AS ALERT-BOX ERROR.
      511      RETURN.
      512   END PROCEDURE.
      513   PROCEDURE check-modified :
      514   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      515   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      516   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      517   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      518     IF check-state = "check":U THEN
      519     DO:
      520       RUN get-link-handle IN adm-broker-hdl
      521         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      522            OUTPUT group-target-list).
      523       IF group-target-list NE "":U THEN
      524       DO i = 1 TO NUM-ENTRIES(group-target-list):
      525         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      526         RUN check-modified IN curr-widget ('group-check':U).
      527         IF RETURN-VALUE NE "":U THEN
      528         DO:
      529           RUN check-modified-message(RETURN-VALUE).
      530           RETURN "":U.
      531         END.
      532       END.
      533     END.
      534     RETURN "":U.
      535   END PROCEDURE.
      536   PROCEDURE check-modified-message :
      537     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      538        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      539           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      540        IF RETURN-VALUE = "YES":U THEN
      541           RUN notify ('view,CONTAINER-SOURCE':U).
      542        MESSAGE IF p-changed-table NE ? THEN
      543           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      544           ELSE "Current values have been changed."
      545           SKIP "  Do you wish to save those changes?"
      546           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      547        IF ANS THEN
      548        DO:
      549           IF group-assign-target THEN
      550             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      551           ELSE RUN dispatch('update-record':U).
      552           IF RETURN-VALUE = "ADM-ERROR":U THEN
      553           DO:
      554               MESSAGE "Changes to the previous record were not saved."
      555                 VIEW-AS ALERT-BOX ERROR.
      556               IF group-assign-target THEN
      557                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      558               ELSE RUN dispatch ('cancel-record':U).
      559           END.
      560        END.
      561        ELSE DO:
      562          IF group-assign-target THEN
      563             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      564          ELSE RUN dispatch('cancel-record':U).
      565        END.
      566        RETURN.
      567   END PROCEDURE.
      568   PROCEDURE get-rowid :
      569       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      570       ASSIGN
      571       p-table   =   adm-first-table.
      572       RETURN.
      573   END PROCEDURE.
      574   PROCEDURE init-group-assign :
      575       RUN request-attribute IN adm-broker-hdl
      576         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      577       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      578         group-assign-target = yes.
      579       ELSE group-assign-target = no.
      580       RETURN.
      581   END PROCEDURE.
      582   PROCEDURE set-editors :
      583       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      584       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      585       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      586       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      587       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      588       DO WHILE VALID-HANDLE (curr-widget):
      589           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      590              curr-widget:HIDDEN = no THEN DO:
      591             CASE p-field-setting:
      592               WHEN "INITIALIZE":U THEN
      593               DO:
      594                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      595                     read-only-list +
      596                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      597                        STRING(curr-widget).
      598               END.
      599               WHEN "DISABLE":U OR
      600               WHEN "ENABLE":U THEN
      601               DO:
      602                   curr-widget:SENSITIVE = yes.
      603                   RUN get-attribute ('Read-Only-Editors':U).
      604                   IF RETURN-VALUE = ? OR
      605                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      606                       curr-widget:READ-ONLY =
      607                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      608               END.
      609               WHEN "CLEAR":U THEN
      610                   curr-widget:SCREEN-VALUE = "":U.
      611             END CASE.
      612           END.
      613           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      614       END.
      615       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      616         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      617           + '"':U).
      618       RETURN.
      619   END PROCEDURE.
      620   PROCEDURE use-check-modified-all :
      621    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      622     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      623     RETURN.
      624   END PROCEDURE.
      625   PROCEDURE use-create-on-add :
      626   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      627      RETURN.
      628   END PROCEDURE.
      629   PROCEDURE use-initial-lock :
      630     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      631     ASSIGN adm-initial-lock = p-attr-value.
      632     RETURN.
      633   END PROCEDURE.
      634   PROCEDURE adm-display-fields :
      635         IF AVAILABLE pump-nozzle THEN
      636             DISPLAY pump-nozzle.pump-code pump-nozzle.nozzle-code WITH BROWSE br_table
      637               NO-ERROR.
      638         DISPLAY UNLESS-HIDDEN varis-meas varef-nid varis-activ varps lef-nid
      639             WITH FRAME F-Main NO-ERROR.
      640       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      641       RETURN.
      642   END PROCEDURE.
      643   PROCEDURE adm-open-query :
      644               RUN dispatch ('open-query-cases':U).
      645           adm-query-opened = yes.
      646           IF NUM-RESULTS("br_table":U) = 0 THEN
      647               RUN new-state ('no-record-available,SELF':U).
      648           ELSE DO:
      649               RUN new-state ('record-available,SELF':U).
      650               RUN new-state ('first-record,SELF':U).
      651           END.
      652           IF NOT adm-updating-record THEN
      653               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      654     RETURN.
      655   END PROCEDURE.
      656   PROCEDURE adm-row-changed :
      657         IF VALID-HANDLE(adm-object-hdl) THEN
      658           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      659         RUN notify ('row-available':U).
      660         RETURN.
      661   END PROCEDURE.
      662   PROCEDURE reposition-query :
      663       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      664       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      665       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      666       IF table-name <> ? THEN
      667           REPOSITION br_table TO ROWID table-name NO-ERROR.
      668       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      669       RETURN.
      670   END PROCEDURE.
      671     adm-sts = br_table:SET-REPOSITIONED-ROW
      672       (br_table:DOWN,"CONDITIONAL":U).
      673     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      674   PROCEDURE set-size :
      675     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      676     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      677     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      678     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      679     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      680     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      681     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      682     ASSIGN pd_height = MAX(pd_height, 2.0)
      683            pd_width  = MAX(pd_width, 2.0)
      684            hBrowse     = br_table:HANDLE IN FRAME F-Main
      685            hFieldGroup = hBrowse:PARENT
      686            htmpWidget  = hFieldGroup:FIRST-CHILD
      687            hFrame      = hFieldGroup:PARENT.
      688     Search-For-Siblings:
      689     REPEAT WHILE VALID-HANDLE(htmpWidget):
      690       IF htmpWidget NE hBrowse THEN DO:
      691         IF htmpWidget:TYPE NE "BUTTON" OR
      692            htmpWidget:X    NE 4 OR
      693            htmpWidget:Y    NE 4 THEN DO:
      694           RETURN.
      695         END.
      696       END.
      697       htmpWidget = htmpWidget:NEXT-SIBLING.
      698     END.
      699     IF pd_width < hBrowse:WIDTH THEN
      700       ASSIGN hBrowse:WIDTH = pd_width
      701              hFrame:WIDTH  = pd_width     NO-ERROR.
      702     ELSE
      703       ASSIGN hFrame:WIDTH  = pd_width
      704              hBrowse:WIDTH = pd_width     NO-ERROR.
      705     IF pd_height < hBrowse:HEIGHT THEN
      706       ASSIGN hBrowse:HEIGHT = pd_height
      707              hFrame:HEIGHT  = pd_height     NO-ERROR.
      708     ELSE
      709       ASSIGN hFrame:HEIGHT  = pd_height
      710              hBrowse:HEIGHT = pd_height     NO-ERROR.
      711   END PROCEDURE.
      712   ASSIGN
      713          FRAME F-Main:SCROLLABLE       = FALSE
      714          FRAME F-Main:HIDDEN           = TRUE.
      715   ON CHOOSE OF b-add IN FRAME F-Main
      716   DO:
      717   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   do:
      719     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      720       (input  v-db-num
      721       ,input  v-userid
      722       ,input  0
      723       ,input  'actn_pump-reference_work':U
      724       ,input  'object':U
      725       ,input  v-host-code
      726       ,input  v-obj-type
      727       ,input  v-obj-code
      728       ,input  0
      729       ,input  0
      730       ,input  0
      731       ,input  true
      732       ,output glog
      733       )  .
      734   end.
      735     if NOT glog then return no-apply.
      736   define variable varrec-id as recid no-undo.
      737     CASE "pumpnz"
      738     :
      739      WHEN "nozzle" THEN DO:
      740        run str/d-nozzle.w (input  varobj-type,
      741                        input  varobj-code,
      742                        output varrec-id) no-error.
      743      END.
      744      WHEN "plpmnz" THEN DO:
      745        run str/d-plpmnz.w
      746         ( input parparentproc
      747          ,input varobj-type
      748          ,input varobj-code
      749          ,output varrec-id
      750         ) no-error.
      751      END.
      752      WHEN "plpump" THEN DO:
      753        run str/d-plpump.w
      754         ( input parparentproc
      755          ,input varobj-type
      756          ,input varobj-code
      757          ,output varrec-id
      758         ) no-error.
      759      END.
      760      WHEN "pump" THEN DO:
      761        run str/d-pump.w
      762         ( input parparentproc
      763          ,input varobj-type
      764          ,input  varobj-code
      765          ,output varrec-id
      766         ) no-error.
      767      END.
      768      WHEN "pumpnz" THEN DO:
      769        run str/d-pumpnz.w
      770         ( input parparentproc
      771          ,input varobj-type
      772          ,input varobj-code
      773          ,output varrec-id
      774         ) no-error.
      775      END.
      776      OTHERWISE DO:
      777   message
      778     vss-workfile vss-revision vss-description skip
      779     "Неверное имя файла d-pumpnz.w." skip
      780     "-----------Cистемная ошибка------------" skip
      781     return-value skip
      782     "------Ошибка исполнения программы------" skip
      783     trim(error-status :get-message(1)) +
      784     trim(error-status :get-message(2)) +
      785     trim(error-status :get-message(3)) +
      786     trim(error-status :get-message(4)) +
      787     trim(error-status :get-message(5)) skip
      788     view-as alert-box error .
      789        return no-apply.
      790      END.
      791     END CASE.
      792     if error-status:error then do:
      793   message
      794     vss-workfile vss-revision vss-description skip
      795     "Ошибка при вызове файла d-pumpnz.w." skip
      796     "-----------Cистемная ошибка------------" skip
      797     return-value skip
      798     "------Ошибка исполнения программы------" skip
      799     trim(error-status :get-message(1)) +
      800     trim(error-status :get-message(2)) +
      801     trim(error-status :get-message(3)) +
      802     trim(error-status :get-message(4)) +
      803     trim(error-status :get-message(5)) skip
      804     view-as alert-box error .
      805        return no-apply.
      806     end.
      807     if varrec-id <> ? then do:
      808        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      809        REPOSITION br_table to recid varrec-id.
      810     end.
      811   END.
      812   ON CHOOSE OF b-del IN FRAME F-Main
      813   DO:
      814   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   do:
      816     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      817       (input  v-db-num
      818       ,input  v-userid
      819       ,input  0
      820       ,input  'actn_pump-reference_work':U
      821       ,input  'object':U
      822       ,input  v-host-code
      823       ,input  v-obj-type
      824       ,input  v-obj-code
      825       ,input  0
      826       ,input  0
      827       ,input  0
      828       ,input  true
      829       ,output glog
      830       )  .
      831   end.
      832     if NOT glog then return no-apply.
      833   if available ub.pump-nozzle then do:
      834      assign varmes-log = no.
      835      message "Вы хотите удалить запись <<ТРК-пистолет>> с номером ТРК " ub.pump-nozzle.pump-code
      836              " и номером пистолета " ub.pump-nozzle.nozzle-code " ?" skip
      837              "ПРИ ЭТОМ БУДУТ УДАЛЕНА СВЯЗЬ ТРК-пистолет С РЕЗЕРВУАРОМ!!!" skip
      838              "Вы уверены?"
      839              view-as alert-box question buttons yes-no update varmes-log.
      840     if varmes-log = yes then do:
      841        run pumpnzdv (input ub.pump-nozzle.obj-type,
      842                      input ub.pump-nozzle.obj-code,
      843                      input ub.pump-nozzle.pump-code,
      844                      input ub.pump-nozzle.nozzle-code) no-error.
      845        if error-status:error then do:
      846   message
      847     vss-workfile vss-revision vss-description skip
      848     "Ошибка при удалении записи ТРК-резервуар." skip
      849     "-----------Cистемная ошибка------------" skip
      850     return-value skip
      851     "------Ошибка исполнения программы------" skip
      852     trim(error-status :get-message(1)) +
      853     trim(error-status :get-message(2)) +
      854     trim(error-status :get-message(3)) +
      855     trim(error-status :get-message(4)) +
      856     trim(error-status :get-message(5)) skip
      857     view-as alert-box error .
      858           return no-apply.
      859        end.
      860        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      861     end.
      862   end.
      863   END.
      864   ON CHOOSE OF b-hist IN FRAME F-Main
      865   DO:
      866     define variable v-rec-list as character no-undo.
      867     if available ub.pump-nozzle then do:
      868         run ref/cpmphist.w (
      869                          INPUT parParentProc
      870                        , input ub.pump-nozzle.obj-type
      871                        , input ub.pump-nozzle.obj-code
      872                        , input "":U
      873                        , input "subject":U
      874                        , input ub.pump-nozzle.obj-type
      875                        , input ub.pump-nozzle.obj-code
      876                        , input ub.pump-nozzle.pump-code
      877                        , input 0
      878                        , input 0
      879                        , input ub.pump-nozzle.nozzle-code
      880                        , input 'pump-nozzle':U
      881                        , input-output v-rec-list
      882                        ) no-error .
      883     end.
      884     apply "ENTRY":U to browse br_table.
      885   END.
      886   ON ROW-ENTRY OF br_table IN FRAME F-Main
      887   DO:
      888   END.
      889   ON ROW-LEAVE OF br_table IN FRAME F-Main
      890   DO:
      891   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      892   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      893   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      894     widget-enter = last-event:widget-enter.
      895     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      896     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      897       THEN widget-frame = widget-enter:FRAME.
      898     IF ((NOT VALID-HANDLE(widget-enter)) OR
      899         (widget-parent:TYPE = "BROWSE":U) OR
      900         (NOT VALID-HANDLE(widget-frame)) OR
      901         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      902     THEN DO:
      903         IF adm-brs-in-update THEN
      904         DO:
      905           MESSAGE
      906           "You must complete or cancel the update before leaving the current row."
      907               VIEW-AS ALERT-BOX WARNING.
      908           RETURN NO-APPLY.
      909         END.
      910         IF br_table:CURRENT-ROW-MODIFIED  OR
      911           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      912         DO:
      913           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      914           THEN DO:
      915             MESSAGE
      916             "Current record has been changed. " SKIP
      917             "Do you wish to save those changes?"
      918               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      919             IF l-save THEN
      920             DO:
      921                RUN dispatch('update-record':U).
      922                IF RETURN-VALUE = "ADM-ERROR":U THEN
      923                    RETURN NO-APPLY.
      924             END.
      925             ELSE RUN dispatch ('cancel-record':U).
      926           END.
      927           ELSE DO:
      928             RUN dispatch('update-record':U).
      929             IF RETURN-VALUE = "ADM-ERROR":U THEN
      930                 RETURN NO-APPLY.
      931           END.
      932         END.
      933     END.
      934   END.
      935   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      936   DO:
      937   RUN get-attribute('ADM-NEW-RECORD':U).
      938   IF RETURN-VALUE NE "YES":U THEN
      939     RUN notify ('row-available':U).
      940   varis-activ = true .
      941     if available ub.pump-nozzle then do:
      942        assign varPS = ub.pump-nozzle.pS
      943               varis-meas = ub.pump-nozzle.is-meas
      944               varef-nid = ub.pump-nozzle.ef-nid
      945               .
      946             find first ub.pump-nozzle-attr exclusive-lock where ub.pump-nozzle-attr.attr-code = "is-activ" and
      947                                                            ub.pump-nozzle-attr.nozzle-code = ub.pump-nozzle.nozzle-code and
      948                                                            ub.pump-nozzle-attr.obj-code = ub.pump-nozzle.obj-code and
      949                                                            ub.pump-nozzle-attr.obj-type = ub.pump-nozzle.obj-type and
      950                                                            ub.pump-nozzle-attr.pump-code = ub.pump-nozzle.pump-code and
      951                                                            ub.pump-nozzle-attr.attr-value <> "" no-error .
      952       if available (ub.pump-nozzle-attr) then varis-activ = logical (ub.pump-nozzle-attr.attr-value) .
      953        display
      954        varPS
      955        varis-meas
      956        varef-nid when is-ef
      957            varis-activ
      958        with frame F-Main.
      959     end.
      960   END.
      961   ON LEAVE OF varef-nid IN FRAME F-Main
      962   DO:
      963     define buffer bf_pumpnz for ub.pump-nozzle.
      964     IF is-ef  THEN DO:
      965     if available ub.pump-nozzle then do:
      966        if ub.pump-nozzle.ef-nid <> input frame F-Main varef-nid then do:
      967           assign varmes-log = yes.
      968           message "Вы хотите изменить атрибут?"
      969           view-as alert-box question buttons yes-no update varmes-log.
      970           if varmes-log then do:
      971              find first bf_pumpnz where recid(bf_pumpnz) = recid(ub.pump-nozzle) exclusive.
      972              assign frame F-Main varef-nid.
      973              assign bf_pumpnz.ef-nid = varef-nid.
      974           end.
      975           else do:
      976               assign varef-nid = ub.pump-nozzle.ef-nid.
      977               DISPLAY varef-nid with frame F-Main.
      978           end.
      979        end.
      980     end.
      981     END.
      982   END.
      983   ON VALUE-CHANGED OF varis-meas IN FRAME F-Main
      984   DO:
      985     define buffer bf_pumpnz for ub.pump-nozzle.
      986   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   do:
      988     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      989       (input  v-db-num
      990       ,input  v-userid
      991       ,input  0
      992       ,input  'actn_pump-reference_work':U
      993       ,input  'object':U
      994       ,input  v-host-code
      995       ,input  v-obj-type
      996       ,input  v-obj-code
      997       ,input  0
      998       ,input  0
      999       ,input  0
     1000       ,input  true
     1001       ,output glog
     1002       )  .
     1003   end.
     1004     if NOT glog then do:
     1005       assign
     1006         varis-meas = ub.pump-nozzle.is-meas.
     1007       display varis-meas with frame F-Main.
     1008       return no-apply.
     1009     end.
     1010     if available ub.pump-nozzle then do:
     1011        if ub.pump-nozzle.is-meas <> input frame F-Main varis-meas then do:
     1012           assign varmes-log = yes.
     1013           message "Вы хотите изменить атрибут?"
     1014           view-as alert-box question buttons yes-no update varmes-log.
     1015           if varmes-log then do:
     1016              find first bf_pumpnz where recid(bf_pumpnz) = recid(ub.pump-nozzle) exclusive.
     1017              assign frame F-Main varis-meas.
     1018              assign bf_pumpnz.is-meas = varis-meas.
     1019           end.
     1020           else do:
     1021               assign varis-meas = ub.pump-nozzle.is-meas.
     1022               display varis-meas with frame F-Main.
     1023           end.
     1024        end.
     1025     end.
     1026   END.
     1027   ON VALUE-CHANGED OF varis-activ IN FRAME F-Main
     1028      DO:
     1029         define buffer bf_pumpnz      for ub.pump-nozzle.
     1030         define buffer bf_pumpnz-attr for ub.pump-nozzle-attr.
     1031         define variable rec_pump as recid no-undo .
     1032   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   do:
     1034     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1035       (input  v-db-num
     1036       ,input  v-userid
     1037       ,input  0
     1038       ,input  'actn_pump-reference_work':U
     1039       ,input  'object':U
     1040       ,input  v-host-code
     1041       ,input  v-obj-type
     1042       ,input  v-obj-code
     1043       ,input  0
     1044       ,input  0
     1045       ,input  0
     1046       ,input  true
     1047       ,output glog
     1048       )  .
     1049   end.
     1050         if NOT glog then
     1051         do:
     1052            find first bf_pumpnz-attr exclusive-lock where bf_pumpnz-attr.attr-code = "is-activ" and
     1053               bf_pumpnz-attr.nozzle-code = ub.pump-nozzle.nozzle-code and
     1054               bf_pumpnz-attr.obj-code = ub.pump-nozzle.obj-code and
     1055               bf_pumpnz-attr.obj-type = ub.pump-nozzle.obj-type and
     1056               bf_pumpnz-attr.pump-code = ub.pump-nozzle.pump-code and
     1057               bf_pumpnz-attr.attr-value <> "" no-error .
     1058            if available (bf_pumpnz-attr) then varis-activ = logical(bf_pumpnz-attr.attr-value) .
     1059            display varis-activ with frame F-Main.
     1060            return no-apply.
     1061         end.
     1062         if available ub.pump-nozzle then
     1063         do:
     1064            find first bf_pumpnz-attr exclusive-lock where bf_pumpnz-attr.attr-code = "is-activ" and
     1065               bf_pumpnz-attr.nozzle-code = ub.pump-nozzle.nozzle-code and
     1066               bf_pumpnz-attr.obj-code = ub.pump-nozzle.obj-code and
     1067               bf_pumpnz-attr.obj-type = ub.pump-nozzle.obj-type and
     1068               bf_pumpnz-attr.pump-code = ub.pump-nozzle.pump-code and
     1069               bf_pumpnz-attr.attr-value <> "" no-error .
     1070            if available (bf_pumpnz-attr) then varis-activ = logical (bf_pumpnz-attr.attr-value) .
     1071            else varis-activ = true .
     1072            if varis-activ <> logical(varis-activ:screen-value) then
     1073            do:
     1074               assign
     1075                  varmes-log = yes.
     1076               message "Вы хотите изменить атрибут?"
     1077                  view-as alert-box question buttons yes-no update varmes-log.
     1078               if varmes-log then
     1079               do:
     1080                  rec_pump = recid(pump-nozzle) .
     1081                  find first bf_pumpnz where recid(bf_pumpnz) = recid(pump-nozzle) exclusive.
     1082                  find first bf_pumpnz-attr exclusive-lock where bf_pumpnz-attr.attr-code = "is-activ" and
     1083                     bf_pumpnz-attr.nozzle-code = ub.pump-nozzle.nozzle-code and
     1084                     bf_pumpnz-attr.obj-code = ub.pump-nozzle.obj-code and
     1085                     bf_pumpnz-attr.obj-type = ub.pump-nozzle.obj-type and
     1086                     bf_pumpnz-attr.pump-code = ub.pump-nozzle.pump-code no-error .
     1087                  if not available (bf_pumpnz-attr) then
     1088                  do:
     1089                     create bf_pumpnz-attr .
     1090                     assign
     1091                        bf_pumpnz-attr.attr-code   = "is-activ"
     1092                        bf_pumpnz-attr.nozzle-code = ub.pump-nozzle.nozzle-code
     1093                        bf_pumpnz-attr.obj-code    = ub.pump-nozzle.obj-code
     1094                        bf_pumpnz-attr.obj-type    = ub.pump-nozzle.obj-type
     1095                        bf_pumpnz-attr.pump-code   = ub.pump-nozzle.pump-code
     1096                        .
     1097                  end.
     1098                  pl-list =
     1099                     string(ub.pump-nozzle.nozzle-code) + ":" +
     1100                     string(ub.pump-nozzle.pump-code)
     1101                     .
     1102                  if  logical(varis-activ:screen-value) = true then
     1103                  do:
     1104                     run str/diallog.w ( input parparentproc
     1105                        ,input this-procedure
     1106                        ,input 'str/get-block-nozzle.p':U
     1107                        ,input (v-cntxt-obj-type + chr(4) +
     1108                        string(v-cntxt-obj-code) + chr(4) +
     1109                        string(0) + chr(4) +
     1110                        string(0) + chr(4) +
     1111                        chr(4) +
     1112                        chr(4) +
     1113                        chr(4) +
     1114                        substitute("&1,&2"
     1115                        ,"NOACTIVE"
     1116                        ,pl-list))
     1117                        ,input yes
     1118                        ,input ''
     1119                        ,input 'Разблокировка пистолетов') no-error .
     1120                     if error-status:error then
     1121                     do:
     1122                        assign
     1123                           bf_pumpnz-attr.attr-value = string(varis-activ).
     1124                        message "При разблокировке пистолета произошла ошибка"
     1125                           view-as alert-box.
     1126                        return no-apply .
     1127                     end.
     1128                  end.
     1129                  else
     1130                  do:
     1131                     run str/diallog.w ( input parparentproc
     1132                        ,input this-procedure
     1133                        ,input 'str/get-block-nozzle.p':U
     1134                        ,input (v-cntxt-obj-type + chr(4) +
     1135                        string(v-cntxt-obj-code) + chr(4) +
     1136                        string(0) + chr(4) +
     1137                        string(0) + chr(4) +
     1138                        chr(4) +
     1139                        chr(4) +
     1140                        chr(4) +
     1141                        substitute("&1,&2"
     1142                        ,"ACTIVE"
     1143                        ,pl-list))
     1144                        ,input yes
     1145                        ,input ''
     1146                        ,input 'Блокировка пистолетов') no-error .
     1147                     if error-status:error then
     1148                     do:
     1149                        assign
     1150                           bf_pumpnz-attr.attr-value = string(varis-activ).
     1151                        message "При блокировке пистолета произошла ошибка"
     1152                           view-as alert-box.
     1153                        return no-apply .
     1154                     end.
     1155                  end.
     1156                  assign frame F-Main varis-activ.
     1157                  assign
     1158                     bf_pumpnz-attr.attr-value = string(varis-activ).
     1159                  reposition br_table to recid rec_pump .
     1160               end.
     1161               else
     1162               do:
     1163                  display varis-activ with frame F-Main .
     1164               end.
     1165            end.
     1166         end.
     1167      END.
     1168   ON LEAVE OF varps IN FRAME F-Main
     1169   DO:
     1170     define buffer bf_pump-nozzle for ub.pump-nozzle.
     1171     if available ub.pump-nozzle then do:
     1172       if ub.pump-nozzle.ps <> input frame F-Main varps then do:
     1173         if varps-upd = no then do:
     1174             message
     1175               "Вы не можете изменять примечание!"
     1176               view-as alert-box.
     1177             display
     1178               ub.pump-nozzle.ps @ varps
     1179               with frame F-Main
     1180             .
     1181         end.
     1182         else do:
     1183           assign
     1184             varmes-log = yes
     1185           .
     1186           message
     1187             "Вы хотите изменить примечание к " "ТРК-пистолет"
     1188             view-as alert-box question buttons yes-no update varmes-log.
     1189           if varmes-log = true then do:
     1190             do transaction
     1191             on error  undo, retry
     1192             on stop   undo, retry
     1193             on endkey undo, retry
     1194             :
     1195               if retry then do:
     1196                 message
     1197                   vss-workfile vss-revision vss-description skip(1)
     1198                   "Ошибка при сохранении PS!!!" skip
     1199                   error-status :get-message(1) skip
     1200                   return-value skip
     1201                   view-as alert-box error .
     1202                 return no-apply.
     1203               end.
     1204               find first bf_pump-nozzle exclusive-lock
     1205                 where recid(bf_pump-nozzle) = recid(ub.pump-nozzle)
     1206               .
     1207               assign
     1208                 frame F-Main varps
     1209               .
     1210               assign
     1211                 bf_pump-nozzle.ps = varps
     1212               .
     1213             end.
     1214           end.
     1215           else do:
     1216             assign
     1217               varps = ub.pump-nozzle.ps
     1218             .
     1219             display
     1220               varps
     1221               with frame F-Main
     1222             .
     1223           end.
     1224         end.
     1225       end.
     1226     end.
     1227   END.
     1228   if not this-procedure :persistent
     1229   then do:
     1230     message
     1231       vss-workfile vss-revision vss-description skip
     1232       "Ошибка при запуске процедуры" skip
     1233       "Данную процедуру следует запускать только с параметром persistent" skip
     1234       view-as alert-box error .
     1235     undo, return error .
     1236   end.
     1237   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   on help of frame F-Main
     1239   do:
     1240     run gbl/app_help.p
     1241       (input this-procedure :file-name
     1242       ,input ''
     1243       ,input ?
     1244       ) no-error.
     1245     if error-status :error then do:
     1246       message
     1247         "Ошибка при вызове помощи"
     1248         error-status :get-message(1)
     1249         view-as alert-box .
     1250     end.
     1251   end.
     1252   run minbtn-set in this-procedure .
     1253   on choose of b-help in frame F-Main
     1254   do:
     1255     apply "help":u to frame F-Main .
     1256   end.
     1257   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1258   procedure minbtn-set :
     1259       do
     1260           on error undo, return error return-value
     1261           :
     1262           define variable ii              as integer       no-undo .
     1263           define variable fh              as widget-handle no-undo .
     1264           define variable hh              as widget-handle no-undo .
     1265           define variable v-h             as handle        extent 4 no-undo .
     1266           define variable v-name-button   as character     no-undo .
     1267           define variable v-help-old-x    as decimal       no-undo .
     1268           define variable v-help-old-y    as decimal       no-undo .
     1269           define variable v-help-old-size as decimal       no-undo .
     1270           define variable v-frame-width   as decimal       no-undo .
     1271           define variable jj              as integer       no-undo .
     1272           do
     1273               on error undo, return error
     1274               :
     1275               assign
     1276                   v-frame-width = frame F-Main:width - 0.3
     1277                   fh            = frame F-Main:first-child
     1278                   hh            = fh:first-child
     1279                   ii            = 1
     1280                   .
     1281               do while valid-handle(hh):
     1282                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1283                   do:
     1284                       case lc(hh:name) :
     1285                           when "b-help" then
     1286                               do:
     1287                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1288                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1289                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1290                                   hh:TOOLTIP = "Помощь" .
     1291                                   v-help-old-x = hh:column .
     1292                                   v-help-old-y = hh:row    .
     1293                                   v-help-old-size = hh:width .
     1294                                   hh:width-chars = 2.5 .
     1295                               end.
     1296                           when "b-print" then
     1297                               do:
     1298                                   hh:load-image("cmp/b-print.bmp":u) .
     1299                                   hh:TOOLTIP = "Печать" .
     1300                                   v-h[ii] = hh:handle .
     1301                                   ii = ii + 1 .
     1302                                   hh:width-chars = 3 .
     1303                               end.
     1304                           when "b-history" or
     1305                           when "b-hist" then
     1306                               do:
     1307                                   hh:load-image("cmp/b-hist.bmp":u) .
     1308                                   hh:TOOLTIP = "История" .
     1309                                   v-h[ii] = hh:handle .
     1310                                   ii = ii + 1 .
     1311                                   hh:width-chars = 3 .
     1312                               end.
     1313                           when "b-sch" then
     1314                               do:
     1315                                   hh:load-image("cmp/b-sch.bmp":u) .
     1316                                   hh:TOOLTIP = "Установка Фильтра" .
     1317                                   v-h[ii] = hh:handle .
     1318                                   ii = ii + 1 .
     1319                                   hh:width-chars = 3 .
     1320                               end.
     1321                           when "b-hist-user" then
     1322                               do:
     1323                                   hh:load-image("cmp/b-hist.bmp":u) .
     1324                                   hh:TOOLTIP = "История пользователя" .
     1325                                   ii = ii + 1 .
     1326                               end.
     1327                       end case.
     1328                   end.
     1329                   hh = hh:next-sibling.
     1330               end.
     1331               b-help:column = v-frame-width - b-help:width-chars.
     1332               jj = 0.
     1333               repeat ii = 4 to 1 by -1 :
     1334                   if valid-handle (v-h[ii] ) then
     1335                   do:
     1336                       jj  = jj + 1 .
     1337                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1338                       v-h[ii]:row    = v-help-old-y .
     1339                   end.
     1340               end.
     1341           end.
     1342       end.
     1343   end procedure.
     1344   PROCEDURE adm-open-query-cases :
     1345     OPEN QUERY br_table FOR EACH pump-nozzle WHERE pump-nozzle.obj-type = varobj-type and pump-nozzle.obj-code = varobj-code NO-LOCK      INDEXED-REPOSITION.
     1346   END PROCEDURE.
     1347   PROCEDURE adm-row-available :
     1348     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1349     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1350     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1351     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1352     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1353     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1354     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1355     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1356     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1357     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1358     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1359     IF adm-updating-record THEN RETURN.
     1360     RUN get-attribute ('FIELDS-ENABLED':U).
     1361     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1362     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1363         OUTPUT link-handle) NO-ERROR.
     1364     IF link-handle = "":U THEN
     1365         RETURN.
     1366     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1367     IF NUM-ENTRIES(link-handle) > 1 THEN
     1368         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1369             "encountered more than one RECORD-SOURCE.":U SKIP
     1370             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1371                VIEW-AS ALERT-BOX ERROR.
     1372     RUN get-attribute ('Key-Name':U).
     1373     key-name = RETURN-VALUE.
     1374     IF key-name = "":U THEN key-name = ?.
     1375     IF key-name NE ? THEN DO:
     1376       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1377         NO-ERROR.
     1378       IF key-value NE ? THEN
     1379         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1380     END.
     1381   IF VALID-HANDLE (adm-object-hdl) THEN
     1382       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1383     IF key-name ne ? OR different-row
     1384     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1385     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1386   END PROCEDURE.
     1387   PROCEDURE check-open-doc :
     1388     define input parameter parobj-type like ub.clients.obj-type no-undo.
     1389     define input parameter parobj-code like ub.clients.obj-code no-undo.
     1390     define buffer bf_rvs-doc  for ub.rvs-doc.
     1391     define buffer bf_icnt-doc for ub.icnt-doc.
     1392    find first bf_rvs-doc where bf_rvs-doc.obj-type =  parobj-type       and
     1393                                bf_rvs-doc.obj-code =  parobj-code       and
     1394                                bf_rvs-doc.status_  <> 'факт':U           and
     1395                                bf_rvs-doc.rvs-type <> 'перед_док':U and
     1396                                bf_rvs-doc.rvs-type <> 'после_док':U  and
     1397                                bf_rvs-doc.rvs-type <> 'проверка':U       no-lock no-error.
     1398   if available bf_rvs-doc then do:
     1399      return error SUBSTITUTE("На объекте есть открытый документ сверки &1 .", bf_rvs-doc.rvs-code).
     1400   end.
     1401   find first bf_icnt-doc where bf_icnt-doc.obj-type  =  parobj-type and
     1402                                bf_icnt-doc.obj-code  =  parobj-code and
     1403                                bf_icnt-doc.status_   <> 'факт':U     no-lock no-error.
     1404   if available bf_icnt-doc then do:
     1405      return error SUBSTITUTE("На объекте есть открытый документ инвентаризации счетчиков ТРК &1 .", bf_icnt-doc.doc-code).
     1406   end.
     1407   END PROCEDURE.
     1408   PROCEDURE disable_UI :
     1409     HIDE FRAME F-Main.
     1410     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1411   END PROCEDURE.
     1412   PROCEDURE local-initialize :
     1413   RUN request-attribute IN adm-broker-hdl
     1414       (INPUT THIS-PROCEDURE,
     1415        INPUT 'Container-Source':U,
     1416        INPUT 'parparentproc':U) NO-ERROR.
     1417   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "parparentproc" + " для получения данных." view-as alert-box error. return error.                    end.
     1418   assign parparentproc = widget-handle(return-value).
     1419   RUN request-attribute IN adm-broker-hdl
     1420       (INPUT THIS-PROCEDURE,
     1421        INPUT 'Container-Source':U,
     1422        INPUT 'obj-type':U) NO-ERROR.
     1423   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-type" + " для получения данных." view-as alert-box error. return error.                    end.
     1424   assign varobj-type = return-value.
     1425   RUN request-attribute IN adm-broker-hdl
     1426       (INPUT THIS-PROCEDURE,
     1427        INPUT 'Container-Source':U,
     1428        INPUT 'obj-code':U) NO-ERROR.
     1429   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-code" + " для получения данных." view-as alert-box error. return error.                    end.
     1430   assign varobj-code = integer(return-value).
     1431   RUN request-attribute IN adm-broker-hdl
     1432       (INPUT THIS-PROCEDURE,
     1433        INPUT 'Container-Source':U,
     1434        INPUT 'buttons':U) NO-ERROR.
     1435   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "buttons" + " для получения данных." view-as alert-box error. return error.                    end.
     1436   assign varbuttons = return-value.
     1437   assign varbuttons = replace (varbuttons, "|", ",").
     1438   if lookup('b-add', varbuttons) = 0 then do:
     1439     assign
     1440       b-add:sensitive in frame F-Main = no
     1441       b-add:visible   in frame F-Main = no
     1442       varps:read-only in frame F-Main = yes
     1443       varps-upd                    = no
     1444     .
     1445   end.
     1446   else do:
     1447     assign
     1448       varps-upd = yes
     1449     .
     1450   end.
     1451   if lookup('b-del', varbuttons) = 0 then
     1452      assign b-del:sensitive in frame F-Main = no
     1453             b-del:visible   in frame F-Main = no.
     1454     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1456     (input  'is-ef'
     1457     ,input  ''
     1458     ,input  ''
     1459     ,input  0
     1460     ,input  ''
     1461     ,input  ''
     1462     ,input  ''
     1463     ,input  no
     1464     ,output is-ef-chr
     1465     ,output var-type
     1466     ) no-error .
     1467     if NOT error-status:error
     1468     and logical(is-ef-chr) = yes then do:
     1469       is-ef = YES.
     1470     end.
     1471     IF NOT is-ef THEN DO:
     1472       HIDE
     1473       varef-nid IN frame F-Main.
     1474     END.
     1475   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476     run mainmenu_getcntxt in parparentproc
     1477       (output v-cntxt-db-num
     1478       ,output v-cntxt-userid
     1479       ,output v-cntxt-level
     1480       ,output v-cntxt-host-code-obj
     1481       ,output v-cntxt-obj-type
     1482       ,output v-cntxt-obj-code
     1483       ,output v-cntxt-db-num-obj
     1484       ,output v-cntxt-is-admin
     1485       ) .
     1486         assign
     1487           v-db-num    = v-cntxt-db-num
     1488           v-host-code = v-cntxt-host-code-obj
     1489           v-obj-code  = v-cntxt-obj-code
     1490           v-obj-type  = v-cntxt-obj-type
     1491           v-userid    = v-cntxt-userid
     1492           .
     1493     if available ub.pump-nozzle then do:
     1494        assign
     1495          varis-meas = ub.pump-nozzle.is-meas
     1496          varps      = ub.pump-nozzle.ps
     1497          varef-nid   = ub.pump-nozzle.ef-nid
     1498        .
     1499        find first ub.pump-nozzle-attr exclusive-lock where ub.pump-nozzle-attr.attr-code = "is-activ" and
     1500                                                            ub.pump-nozzle-attr.nozzle-code = ub.pump-nozzle.nozzle-code and
     1501                                                            ub.pump-nozzle-attr.obj-code = ub.pump-nozzle.obj-code and
     1502                                                            ub.pump-nozzle-attr.obj-type = ub.pump-nozzle.obj-type and
     1503                                                            ub.pump-nozzle-attr.pump-code = ub.pump-nozzle.pump-code and
     1504                                                            ub.pump-nozzle-attr.attr-value <> "" no-error .
     1505       if available (ub.pump-nozzle-attr) then varis-activ = logical (ub.pump-nozzle-attr.attr-value) .
     1506        display
     1507          varis-meas
     1508          varis-activ
     1509          varps
     1510          varef-nid   when is-ef
     1511          with frame F-Main
     1512        .
     1513     end.
     1514     if lookup('b-add', varbuttons) = 0 then do:
     1515       assign
     1516         varis-meas:sensitive in frame F-Main = no
     1517         varef-nid:sensitive in frame F-Main = no
     1518       .
     1519     end.
     1520     if not is-ef then do:
     1521       hide
     1522       varef-nid
     1523       lef-nid
     1524       in frame F-Main .
     1525     end.
     1526   END PROCEDURE.
     1527   PROCEDURE send-key :
     1528   END PROCEDURE.
     1529   PROCEDURE send-records :
     1530     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1531     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1532     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1533     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1534     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1535     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1536         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1537         CASE ENTRY(i, p-tbl-list):
     1538       WHEN "ub.pump-nozzle":U THEN p-rowid-list = p-rowid-list +
     1539           IF AVAILABLE ub.pump-nozzle THEN STRING(ROWID(ub.pump-nozzle))
     1540           ELSE "?":U.
     1541           OTHERWISE
     1542           DO:
     1543               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1544                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1545               IF link-handle NE "":U THEN
     1546               DO:
     1547                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1548                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1549                               "encountered more than one RECORD-SOURCE.":U SKIP
     1550                               "The first will be used.":U
     1551                               VIEW-AS ALERT-BOX ERROR.
     1552                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1553                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1554                   p-rowid-list = p-rowid-list + rowid-string.
     1555               END.
     1556               ELSE
     1557               DO:
     1558                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1559                           "does not match tables in send-records":U
     1560                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1561                           "Check that objects are linked properly and that":U
     1562                           "database qualification is consistent.":U
     1563                       VIEW-AS ALERT-BOX ERROR.
     1564                   RETURN ERROR.
     1565               END.
     1566           END.
     1567           END CASE.
     1568       END.
     1569   END PROCEDURE.
     1570   PROCEDURE state-changed :
     1571     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1572     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1573     CASE p-state:
     1574       WHEN "update-begin":U THEN
     1575       DO:
     1576           adm-brs-in-update = yes.
     1577           RUN dispatch ('enable-fields':U).
     1578           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1579           DO:
     1580             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1581             RUN new-state('update-complete':U).
     1582           END.
     1583           ELSE DO:
     1584             RUN dispatch ('apply-entry':U).
     1585             RUN new-state('update':U).
     1586           END.
     1587       END.
     1588       WHEN "update":U THEN
     1589         DO:
     1590           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1591           RUN get-link-handle IN adm-broker-hdl
     1592               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1593                   NO-ERROR.
     1594           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1595             br_table:SENSITIVE IN FRAME F-Main = no.
     1596         END.
     1597       WHEN "update-complete":U THEN DO:
     1598           br_table:SENSITIVE IN FRAME F-Main = yes.
     1599           adm-brs-in-update = no.
     1600           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1601           IF RETURN-VALUE NE "YES":U THEN
     1602           DO:
     1603             IF NUM-RESULTS("br_table":U) NE ? AND
     1604                NUM-RESULTS("br_table":U) NE 0
     1605             THEN DO:
     1606               GET CURRENT br_table.
     1607               RUN dispatch ('row-changed':U).
     1608             END.
     1609           END.
     1610           RUN new-state ('update-complete':U).
     1611       END.
     1612       WHEN "delete-complete":U THEN DO:
     1613          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1614          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1615          IF NUM-RESULTS("br_table":U) = 0 THEN
     1616            RUN notify('row-available':U).
     1617       END.
     1618       WHEN   'first-record':U        OR
     1619         WHEN 'last-record':U         OR
     1620         WHEN 'only-record':U         OR
     1621         WHEN 'not-first-or-last':U   OR
     1622         WHEN 'no-record-available':U OR
     1623         WHEN 'no-external-record-available':U THEN
     1624           RUN set-attribute-list('Query-Position=':U + p-state).
     1625     END CASE.
     1626   END PROCEDURE.
     1627   FUNCTION Get-activ RETURNS CHARACTER
     1628     ( v-pum-code as integer, v-nozzle-code as integer ) :
     1629        find first ub.pump-nozzle-attr exclusive-lock where ub.pump-nozzle-attr.attr-code = "is-activ" and
     1630                                                            ub.pump-nozzle-attr.nozzle-code = v-nozzle-code and
     1631                                                            ub.pump-nozzle-attr.obj-code = ub.pump-nozzle.obj-code and
     1632                                                            ub.pump-nozzle-attr.obj-type = ub.pump-nozzle.obj-type and
     1633                                                            ub.pump-nozzle-attr.pump-code = v-pum-code no-error .
     1634       if available (ub.pump-nozzle-attr) then do:
     1635       if logical(ub.pump-nozzle-attr.attr-value) then return "+".
     1636       else return "-" .
     1637       end.
     1638       else return "+" .
     1639    END FUNCTION.
