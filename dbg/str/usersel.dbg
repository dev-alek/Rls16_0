        1   block-level on error undo, throw.
        2   define input parameter parparentproc            as handle           no-undo.
        3   define input parameter p-old-user-id            as character        no-undo.
        4   define output parameter p-new-user-id           as character        no-undo.
        5   define output parameter p-new-parent-user-id    as character        no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: usersel.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/usersel.p $":U .
       11   define variable vss-description as character no-undo init "Диалог выбора пользователя".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   define temp-table temp_onewin_items no-undo
       75       field itm-key       as integer
       76       field itmExtKey     as character
       77       field itmName       as character
       78       field itmDesc       as character
       79       field itmSelected   as logical
       80       index pi is primary unique
       81           itm-key
       82       index ie
       83           itmExtKey
       84   .
       85   define temp-table temp_onewin_itemsSelected no-undo
       86       field its-key   as integer
       87       field itm-key   as integer
       88       field itmExtKey as character
       89       index pi is primary unique
       90           its-key
       91       index im
       92           itm-key
       93   .
       94   define variable v-onewin0-itm-key    as integer      no-undo.
       95   procedure onewin_clear :
       96       define buffer buf_temp_onewin_items        for temp_onewin_items.
       97   do
       98   for buf_temp_onewin_items
       99   on error undo, return error
      100   :
      101       empty temp-table buf_temp_onewin_items.
      102   end.
      103   end procedure.
      104   procedure onewin_add-item :
      105   define input parameter p-ext-key   as character        no-undo.
      106   define input parameter p-item-name as character        no-undo.
      107   define input parameter p-item-desc as character        no-undo.
      108   define input parameter p-selected  as logical          no-undo.
      109       define buffer buf_temp_onewin_items        for temp_onewin_items.
      110   do
      111   for buf_temp_onewin_items
      112   on error undo, return error
      113   :
      114       find last buf_temp_onewin_items no-error.
      115       if available buf_temp_onewin_items then do:
      116         v-onewin0-itm-key = buf_temp_onewin_items.itm-key.
      117       end.
      118       else do:
      119         v-onewin0-itm-key = 0.
      120       end.
      121       assign
      122           v-onewin0-itm-key = v-onewin0-itm-key + 1
      123       .
      124       create buf_temp_onewin_items.
      125       assign
      126       buf_temp_onewin_items.itm-key      = v-onewin0-itm-key
      127       buf_temp_onewin_items.itmExtKey    = p-ext-key
      128       buf_temp_onewin_items.itmName      = p-item-name
      129       buf_temp_onewin_items.itmDesc      = p-item-desc
      130       buf_temp_onewin_items.itmSelected  = p-selected
      131       .
      132   end.
      133   end procedure.
      134   procedure onewin_create-selection :
      135   define input parameter p-itm-key as integer no-undo .
      136   define input parameter p-itmextkey as character no-undo .
      137   define variable v-counter as integer no-undo .
      138   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      139   do
      140   on error undo, return error
      141   :
      142     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      143     if available buf_temp_onewin_itemsSelected then do:
      144       v-counter = buf_temp_onewin_itemsSelected.its-key.
      145     end.
      146     find first buf_temp_onewin_itemsSelected where
      147          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      148     if not available buf_temp_onewin_itemsSelected then do:
      149       create buf_temp_onewin_itemsSelected.
      150       assign
      151       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      152       v-counter = v-counter + 1
      153       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      154       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      155       .
      156     end.
      157   end.
      158   end procedure.
      159   procedure onewin_check-item :
      160   define input parameter p-ext-key   as character        no-undo.
      161   define output parameter p-exists as logical no-undo .
      162   define buffer buf_temp_onewin_items for temp_onewin_items.
      163   find first buf_temp_onewin_items where
      164   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      165   if available buf_temp_onewin_items then do:
      166     p-exists = yes.
      167   end.
      168   end procedure.
      169       define variable v-accepted      as logical      no-undo.
      170       define variable v-cur-ext-key   as character    no-undo.
      171       define variable v-login-string  as character    no-undo.
      172       define variable v-cntxt-userid as character no-undo .
      173       define variable v-cntxt-db-num as integer no-undo .
      174       define buffer buf_user-account      for user-account.
      175       define buffer buf_user-login        for user-login.
      176   do
      177   for buf_user-account
      178     , buf_user-login
      179   on error undo, return error
      180   :
      181       run get-userid in parparentproc ( output v-cntxt-userid).
      182       run get-db-num in parparentproc ( output v-cntxt-db-num).
      183       assign
      184           p-new-user-id = p-old-user-id
      185       .
      186       run onewin_clear in this-procedure.
      187       for each buf_user-account no-lock
      188       on error undo, return error
      189       :
      190           assign
      191               v-login-string = "":U
      192           .
      193           for each buf_user-login no-lock
      194              where buf_user-login.user-id = buf_user-account.user-id
      195           by buf_user-login.db-num
      196           :
      197               assign
      198                   v-login-string = substitute( "&1&2БД &3: &4"
      199                                               , v-login-string
      200                                               , ( if v-login-string = "":U then "":U else ", ":U )
      201                                               , buf_user-login.db-num
      202                                               , buf_user-login.user-login
      203                                               )
      204               .
      205           end.
      206           run onewin_add-item in this-procedure (
      207                 input buf_user-account.user-id
      208               , input buf_user-account.nik
      209               , input substitute( "Фамилия, Имя, Отчество:   &2&1Уникальный идентификатор: &4&1Логины:             &5"
      210                                   , chr(10)
      211                                   , trim( substitute( "&1 &2 &3", buf_user-account.last-name, buf_user-account.first-name, buf_user-account.second-name ) )
      212                                   , v-cntxt-db-num
      213                                   , buf_user-account.user-id
      214                                   , v-login-string
      215                                   )
      216               , input ( buf_user-account.user-id = v-cntxt-userid )
      217           ).
      218       end.
      219       run gbl/onewin.w (
      220             input parparentproc
      221           , input 2
      222           , input "Список псевдонимов пользователей"
      223           , input "":U
      224           , input "":U
      225           , input table temp_onewin_items
      226           , output table temp_onewin_itemsSelected
      227           , output v-cur-ext-key
      228           , output v-accepted
      229       ).
      230       if v-accepted = yes
      231       then do:
      232           assign
      233               p-new-user-id = v-cur-ext-key
      234           .
      235           find first buf_user-account no-lock
      236                where buf_user-account.user-id = p-new-user-id
      237           no-error.
      238           if available buf_user-account
      239           then do:
      240               assign
      241                   p-new-parent-user-id = buf_user-account.parent-user-id
      242               .
      243           end.
      244       end.
      245       else do:
      246           assign
      247               p-new-user-id           = "":U
      248               p-new-parent-user-id    = "":U
      249           .
      250       end.
      251   end.
