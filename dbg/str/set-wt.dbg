        1   CREATE WIDGET-POOL.
        2   DEFINE INPUT  PARAMETER parartic     LIKE ub.goods.artic     NO-UNDO.
        3   DEFINE INPUT  PARAMETER parprod-type LIKE ub.goods.prod-type NO-UNDO.
        4   DEFINE INPUT  PARAMETER parprod-code LIKE ub.goods.prod-code NO-UNDO.
        5   DEFINE OUTPUT PARAMETER parnum-place LIKE ub.doc-line.num-place NO-UNDO.
        6   DEFINE OUTPUT PARAMETER parwt-brutto LIKE ub.doc-line.wt-brutto NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Программа редактирования веса".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE VAR W-Win AS WIDGET-HANDLE NO-UNDO.
      117   DEFINE BUTTON b-exit
      118        LABEL "&Выход "
      119        SIZE 9 BY 1.
      120   DEFINE BUTTON b-help
      121        LABEL "Помо&щь"
      122        SIZE 9 BY 1.
      123   DEFINE VARIABLE varnum-place AS DECIMAL FORMAT ">>,>>9.999":U INITIAL 1
      124        LABEL "Количество мест"
      125        VIEW-AS FILL-IN
      126        SIZE 15.75 BY 1 NO-UNDO.
      127   DEFINE VARIABLE varwt-brutto AS DECIMAL FORMAT ">,>>>,>>9.999":U INITIAL 0
      128        LABEL "Вес брутто товара"
      129        VIEW-AS FILL-IN
      130        SIZE 22.13 BY 1 NO-UNDO.
      131   DEFINE FRAME F-Main
      132        ub.goods.artic AT ROW 1.13 COL 42.75 COLON-ALIGNED
      133             VIEW-AS FILL-IN
      134             SIZE 17 BY 1
      135        b-exit AT ROW 1.21 COL 1.75
      136        b-help AT ROW 1.21 COL 12.88
      137        ub.goods.prod-code AT ROW 2.13 COL 42.75 COLON-ALIGNED
      138             VIEW-AS FILL-IN
      139             SIZE 6 BY 1
      140        ub.goods.prod-type AT ROW 3.13 COL 42.75 COLON-ALIGNED
      141             VIEW-AS FILL-IN
      142             SIZE 9 BY 1
      143        varnum-place AT ROW 4.63 COL 2.5
      144        varwt-brutto AT ROW 4.67 COL 56 COLON-ALIGNED
      145       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      146            SIDE-LABELS NO-UNDERLINE THREE-D
      147            VIEW-AS DIALOG-BOX
      148            AT COL 1 ROW 1
      149            SIZE 90 BY 6.
      150   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      151     CREATE WINDOW W-Win ASSIGN
      152            HIDDEN             = YES
      153            TITLE              = "Введите вес брутто товара вручную, т.к товар впервые на объекте"
      154            HEIGHT             = 5
      155            WIDTH              = 80.25
      156            MAX-HEIGHT         = 23.04
      157            MAX-WIDTH          = 100
      158            VIRTUAL-HEIGHT     = 23.04
      159            VIRTUAL-WIDTH      = 100
      160            RESIZE             = no
      161            SCROLL-BARS        = no
      162            STATUS-AREA        = no
      163            BGCOLOR            = ?
      164            FGCOLOR            = ?
      165            THREE-D            = yes
      166            MESSAGE-AREA       = no
      167            SENSITIVE          = yes.
      168   ELSE W-Win = CURRENT-WINDOW.
      169   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(W-Win)
      170   THEN W-Win:HIDDEN = yes.
      171   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      172   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      173   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      174   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      175   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      176   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      177   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      178   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      179       ASSIGN adm-object-hdl    =   W-Win.
      180   RUN ensure-broker.
      181   THIS-PROCEDURE:ADM-DATA =
      182        'ADM1.1~`':U +
      183        'SmartWindow~`':U +
      184        'WINDOW~`':U +
      185        'NO ~`':U +
      186        '~`':U +
      187        '~`':U +
      188        '~`':U +
      189        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      190           + "~`":U +
      191        'Layout,Hide-on-Init~`':U +
      192        '~`':U +
      193        '~`':U +
      194        '~`~`~`~`~`~`~`~`~`~`~`':U +
      195        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      196            THEN "^^":U
      197        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      198             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      199   PROCEDURE adm-apply-entry :
      200     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      201   END PROCEDURE.
      202   PROCEDURE adm-destroy :
      203    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      204   END PROCEDURE.
      205   PROCEDURE adm-disable :
      206       DISABLE b-exit b-help varnum-place varwt-brutto WITH FRAME F-Main.
      207       RUN dispatch ('disable-fields':U).
      208       RUN set-attribute-list ('ENABLED=no':U).
      209       RETURN.
      210   END PROCEDURE.
      211   PROCEDURE adm-edit-attribute-list :
      212         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      213         RETURN.
      214   END PROCEDURE.
      215   PROCEDURE adm-enable :
      216       ENABLE UNLESS-HIDDEN b-exit b-help varnum-place varwt-brutto WITH FRAME F-Main.
      217       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      218       RUN set-attribute-list ('ENABLED=yes':U).
      219       RETURN.
      220   END PROCEDURE.
      221   PROCEDURE adm-exit :
      222        RUN notify ('exit':U).
      223     RETURN.
      224   END PROCEDURE.
      225   PROCEDURE adm-hide :
      226     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      227   END PROCEDURE.
      228   PROCEDURE adm-initialize :
      229     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      230   END PROCEDURE.
      231   PROCEDURE adm-show-errors :
      232       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      233       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      234           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      235       END.
      236       RETURN.
      237   END PROCEDURE.
      238   PROCEDURE adm-UIB-mode :
      239     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      240   END PROCEDURE.
      241   PROCEDURE adm-view :
      242     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      243   END PROCEDURE.
      244   PROCEDURE dispatch :
      245       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      246       RUN broker-dispatch IN adm-broker-hdl
      247           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      248       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      249   END PROCEDURE.
      250   PROCEDURE ensure-broker :
      251   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      252   IF RETURN-VALUE NE "ADM-Broker":U THEN
      253   DO:
      254       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      255       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      256   END.
      257   END PROCEDURE.
      258   PROCEDURE get-attribute :
      259     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      260     RUN broker-get-attribute IN adm-broker-hdl
      261         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      262     RETURN RETURN-VALUE.
      263   END PROCEDURE.
      264   PROCEDURE get-attribute-list :
      265     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      266     RUN broker-get-attribute-list IN adm-broker-hdl
      267         (INPUT THIS-PROCEDURE,
      268          INPUT ?,
      269          OUTPUT p-attr-list) NO-ERROR.
      270     RETURN.
      271   END PROCEDURE.
      272   PROCEDURE new-state :
      273     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      274     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      275     RETURN.
      276   END PROCEDURE.
      277   PROCEDURE notify :
      278     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      279     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      280     IF RETURN-VALUE = "ADM-ERROR":U THEN
      281         RETURN "ADM-ERROR":U.
      282     RETURN.
      283   END PROCEDURE.
      284   PROCEDURE set-attribute-list :
      285     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      286     RUN ensure-broker.
      287     RUN broker-set-attribute-list IN adm-broker-hdl
      288         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      289     RETURN.
      290   END PROCEDURE.
      291   PROCEDURE set-position :
      292       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      293       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      294       IF VALID-HANDLE(adm-object-hdl) THEN
      295       DO:
      296           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      297           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      298           DO:
      299             IF p-row = 0 THEN p-row =
      300               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      301             IF p-col = 0 THEN p-col =
      302               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      303           END.
      304           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      305           DO:
      306             parent-hdl = adm-object-hdl:PARENT.
      307             IF p-row = 0 THEN p-row =
      308               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      309                 parent-hdl:ROW.
      310             IF p-col = 0 THEN p-col =
      311               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      312                 parent-hdl:COL.
      313           END.
      314           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      315           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      316         ASSIGN adm-object-hdl:ROW    =   p-row
      317                adm-object-hdl:COLUMN =   p-col.
      318       END.
      319       RETURN.
      320   END PROCEDURE.
      321   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      322       STRING(adm-object-hdl)).
      323   PAUSE 0 BEFORE-HIDE.
      324   PROCEDURE adm-change-page :
      325     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      326     END PROCEDURE.
      327   PROCEDURE delete-page :
      328     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      329     RUN broker-delete-page IN adm-broker-hdl
      330         (INPUT THIS-PROCEDURE, INPUT p-page#).
      331     END PROCEDURE.
      332   PROCEDURE init-object :
      333     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      334     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      335     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      336     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      337     RUN broker-init-object IN adm-broker-hdl
      338         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      339          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      340     RETURN.
      341   END PROCEDURE.
      342   PROCEDURE init-pages :
      343     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      344     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      345         INPUT p-page-list) NO-ERROR.
      346     END PROCEDURE.
      347   PROCEDURE select-page :
      348     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      349     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      350         INPUT p-page#) NO-ERROR.
      351     END PROCEDURE.
      352   PROCEDURE view-page :
      353     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      354     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      355         INPUT p-page#).
      356     END PROCEDURE.
      357   ON END-ERROR OF W-Win
      358   OR ENDKEY OF W-Win ANYWHERE DO:
      359     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      360   END.
      361   ON WINDOW-CLOSE OF W-Win
      362   DO:
      363     APPLY "CLOSE":U TO THIS-PROCEDURE.
      364     RETURN NO-APPLY.
      365   END.
      366   ON CHOOSE OF b-exit IN FRAME F-Main
      367   DO:
      368     ASSIGN parnum-place = input frame F-Main varnum-place
      369            parwt-brutto = input frame F-Main varwt-brutto.
      370     RUN dispatch IN THIS-PROCEDURE ('exit':U).
      371   END.
      372   ON RETURN OF varwt-brutto IN FRAME F-Main
      373   DO:
      374     APPLY "ENTRY" TO b-exit IN frame F-Main.
      375     RETURN NO-APPLY.
      376   END.
      377   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   on help of frame F-Main
      379   do:
      380     run gbl/app_help.p
      381       (input this-procedure :file-name
      382       ,input ''
      383       ,input ?
      384       ) no-error.
      385     if error-status :error then do:
      386       message
      387         "Ошибка при вызове помощи"
      388         error-status :get-message(1)
      389         view-as alert-box .
      390     end.
      391   end.
      392   run minbtn-set in this-procedure .
      393   on choose of b-help in frame F-Main
      394   do:
      395     apply "help":u to frame F-Main .
      396   end.
      397   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   procedure minbtn-set :
      399       do
      400           on error undo, return error return-value
      401           :
      402           define variable ii              as integer       no-undo .
      403           define variable fh              as widget-handle no-undo .
      404           define variable hh              as widget-handle no-undo .
      405           define variable v-h             as handle        extent 4 no-undo .
      406           define variable v-name-button   as character     no-undo .
      407           define variable v-help-old-x    as decimal       no-undo .
      408           define variable v-help-old-y    as decimal       no-undo .
      409           define variable v-help-old-size as decimal       no-undo .
      410           define variable v-frame-width   as decimal       no-undo .
      411           define variable jj              as integer       no-undo .
      412           do
      413               on error undo, return error
      414               :
      415               assign
      416                   v-frame-width = frame F-Main:width - 0.3
      417                   fh            = frame F-Main:first-child
      418                   hh            = fh:first-child
      419                   ii            = 1
      420                   .
      421               do while valid-handle(hh):
      422                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      423                   do:
      424                       case lc(hh:name) :
      425                           when "b-help" then
      426                               do:
      427                                   hh:load-image-up("cmp/b-help.bmp":u) .
      428                                   hh:load-image-down("cmp/b-help.bmp":u) .
      429                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      430                                   hh:TOOLTIP = "Помощь" .
      431                                   v-help-old-x = hh:column .
      432                                   v-help-old-y = hh:row    .
      433                                   v-help-old-size = hh:width .
      434                                   hh:width-chars = 2.5 .
      435                               end.
      436                           when "b-print" then
      437                               do:
      438                                   hh:load-image("cmp/b-print.bmp":u) .
      439                                   hh:TOOLTIP = "Печать" .
      440                                   v-h[ii] = hh:handle .
      441                                   ii = ii + 1 .
      442                                   hh:width-chars = 3 .
      443                               end.
      444                           when "b-history" or
      445                           when "b-hist" then
      446                               do:
      447                                   hh:load-image("cmp/b-hist.bmp":u) .
      448                                   hh:TOOLTIP = "История" .
      449                                   v-h[ii] = hh:handle .
      450                                   ii = ii + 1 .
      451                                   hh:width-chars = 3 .
      452                               end.
      453                           when "b-sch" then
      454                               do:
      455                                   hh:load-image("cmp/b-sch.bmp":u) .
      456                                   hh:TOOLTIP = "Установка Фильтра" .
      457                                   v-h[ii] = hh:handle .
      458                                   ii = ii + 1 .
      459                                   hh:width-chars = 3 .
      460                               end.
      461                           when "b-hist-user" then
      462                               do:
      463                                   hh:load-image("cmp/b-hist.bmp":u) .
      464                                   hh:TOOLTIP = "История пользователя" .
      465                                   ii = ii + 1 .
      466                               end.
      467                       end case.
      468                   end.
      469                   hh = hh:next-sibling.
      470               end.
      471               b-help:column = v-frame-width - b-help:width-chars.
      472               jj = 0.
      473               repeat ii = 4 to 1 by -1 :
      474                   if valid-handle (v-h[ii] ) then
      475                   do:
      476                       jj  = jj + 1 .
      477                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      478                       v-h[ii]:row    = v-help-old-y .
      479                   end.
      480               end.
      481           end.
      482       end.
      483   end procedure.
      484   find first ub.goods where ub.goods.artic     = parartic and
      485                          ub.goods.prod-code = parprod-code and
      486                          ub.goods.prod-type = parprod-type no-lock.
      487   IF VALID-HANDLE(W-Win) THEN DO:
      488       ASSIGN CURRENT-WINDOW                = W-Win
      489          W-Win:KEEP-FRAME-Z-ORDER = YES
      490          THIS-PROCEDURE:CURRENT-WINDOW = W-Win.
      491       ON CLOSE OF THIS-PROCEDURE
      492          RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      493       RUN dispatch ('create-objects':U).
      494   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      495       MAIN-BLOCK:
      496       DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      497          ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      498          RUN dispatch ('initialize':U).
      499          IF NOT THIS-PROCEDURE:PERSISTENT THEN
      500              WAIT-FOR CLOSE OF THIS-PROCEDURE.
      501       END.
      502   END.
      503   END.
      504   PROCEDURE adm-create-objects :
      505   END PROCEDURE.
      506   PROCEDURE adm-row-available :
      507     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      508     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      509     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      510     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      511     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      512     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      513     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      514     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      515     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      516     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      517     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      518     IF adm-updating-record THEN RETURN.
      519     RUN get-attribute ('FIELDS-ENABLED':U).
      520     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      521     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      522         OUTPUT link-handle) NO-ERROR.
      523     IF link-handle = "":U THEN
      524         RETURN.
      525     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      526     IF NUM-ENTRIES(link-handle) > 1 THEN
      527         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      528             "encountered more than one RECORD-SOURCE.":U SKIP
      529             "The first - ":U record-source-hdl:file-name " - will be used.":U
      530                VIEW-AS ALERT-BOX ERROR.
      531     RUN get-attribute ('Key-Name':U).
      532     key-name = RETURN-VALUE.
      533     IF key-name = "":U THEN key-name = ?.
      534     IF key-name NE ? THEN DO:
      535       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      536         NO-ERROR.
      537       IF key-value NE ? THEN
      538         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      539     END.
      540   IF VALID-HANDLE (adm-object-hdl) THEN
      541       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      542   RUN notify IN THIS-PROCEDURE ('row-available':U).
      543   END PROCEDURE.
      544   PROCEDURE disable_UI :
      545     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(W-Win)
      546     THEN DELETE WIDGET W-Win.
      547     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      548   END PROCEDURE.
      549   PROCEDURE enable_UI :
      550     DISPLAY varnum-place varwt-brutto
      551         WITH FRAME F-Main IN WINDOW W-Win.
      552     IF AVAILABLE ub.goods THEN
      553       DISPLAY ub.goods.artic ub.goods.prod-code ub.goods.prod-type
      554         WITH FRAME F-Main IN WINDOW W-Win.
      555     ENABLE b-exit b-help varnum-place varwt-brutto
      556         WITH FRAME F-Main IN WINDOW W-Win.
      557     APPLY "ENTRY" TO varwt-brutto IN FRAME F-Main.
      558     VIEW W-Win.
      559   END PROCEDURE.
      560   PROCEDURE local-exit :
      561      APPLY "CLOSE":U TO THIS-PROCEDURE.
      562      RETURN.
      563   END PROCEDURE.
      564   PROCEDURE send-records :
      565   END PROCEDURE.
      566   PROCEDURE state-changed :
      567     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      568     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      569   END PROCEDURE.
