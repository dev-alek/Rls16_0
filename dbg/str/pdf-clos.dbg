     1267   define output parameter p-update           as logical                  no-undo.
     1268   define variable kk as integer no-undo .
     1269   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1270   define variable p-hostcode as int no-undo .
     1271   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1272   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1273   define buffer buf_price-doc        for ub.price-doc.
     1274   define buffer buf_price-list       for ub.price-list.
     1275   define buffer buf_bar-code         for ub.bar-code.
     1276   define buffer buf_goods            for ub.goods.
     1277   define buffer buf_root_gds-prt     for ub.gds-prt.
     1278   define buffer buf_gds-prt          for ub.gds-prt.
     1279   find first buf_price-doc no-lock
     1280        where recid( buf_price-doc ) = p-price-doc-recid
     1281   .
     1282   find first buf_goods no-lock
     1283        where buf_goods.gds-code = p-gds-code
     1284   .
     1285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1286     (input  p-gds-code
     1287     ,input  ?
     1288     ,output v-b-code
     1289     ) no-error .
     1290   if error-status :error
     1291   then do:
     1292       message
     1293           "Не найден основной бар-код"
     1294           skip "для товара "
     1295           skip string(buf_goods.artic)
     1296           skip buf_goods.gds-name
     1297       view-as alert-box
     1298       title "Ошибка при выполнении prcreate.i".
     1299       undo, return error .
     1300   end.
     1301   find first buf_bar-code no-lock
     1302        where buf_bar-code.b-code = v-b-code
     1303   no-error.
     1304   if error-status :error
     1305   then do:
     1306       message
     1307           "Не найдена запись bar-code"
     1308           skip "для товара "
     1309           skip string(buf_goods.artic)
     1310           skip buf_goods.gds-name
     1311           skip "С основным бар-кодом"
     1312           skip string(v-b-code)
     1313       view-as alert-box
     1314       title "Ошибка при выполнении prcreate.i".
     1315       undo, return error .
     1316   end.
     1317   find first buf_root_gds-prt no-lock
     1318        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1319   .
     1320   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1321     and buf_bar-code.in-code <> ""
     1322   then do:
     1323       message
     1324           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1325           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1326           view-as alert-box error.
     1327       undo, return error.
     1328   end.
     1329   find first buf_gds-prt no-lock
     1330        where buf_gds-prt.node-code = buf_bar-code.node-code
     1331   .
     1332   find first buf_price-list
     1333        where buf_price-list.doc-num = buf_price-doc.doc-num
     1334          and buf_price-list.b-code  = v-b-code
     1335   no-error.
     1336   if available buf_price-list
     1337   then do:
     1338       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1339          skip "  Цена:   " buf_price-list.price-sale
     1340          skip "Цена будет изменена"
     1341       view-as alert-box warning.
     1342       assign
     1343           p-update = yes
     1344       .
     1345   end.
     1346   else do:
     1347   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
