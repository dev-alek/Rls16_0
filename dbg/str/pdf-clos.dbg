     1404   define output parameter p-pdf-id     as integer   no-undo .
     1405   define output parameter p-plt-db-num as integer   no-undo .
     1406   define output parameter p-plt-id     as integer   no-undo .
     1407   define buffer buf_price-list-type for ub.price-list-type  .
     1408   define variable v-host-code  as integer   no-undo .
     1409   define variable v-base-rate  as decimal   no-undo .
     1410   define variable v-base-scale as integer   no-undo .
     1411   define variable v-exch-rate  as decimal   no-undo .
