     4661           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     4662           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     4663           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     4664         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     4665         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     4666         if transport-base-loc = ? then transport-base-loc = 0.
     4667         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     4668         if other-base-loc     = ? then other-base-loc     = 0.
     4669         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     4670         assign
     4671           transport-cli-loc      = 0
     4672           other-cli-loc          = 0
     4673           road-tax-cli-loc       = ?
     4674           vat-cli-loc            = ?
     4675           slt-cli-loc            = ?
     4676           price-cli-with-tax-loc = ?.
     4677      end.
     4678   ASSIGN
     4679             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4680       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4681   .
     4682                if var-pr-r-b = "rubl" then
     4683                    s-cost = price-rubl-with-tax-loc.
     4684                  else
     4685                    s-cost = price-base-with-tax-loc.
     4686                s-qnty = b_doc-line.fact-qnty .
     4687              end.
     4688              else do:
     4689                assign
     4690                 s-cost = 0
     4691                 s-qnty = 0
     4692                .
     4693              end.
     4694              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     4695           end.
     4696           when "cost-vat":u then do:
     4697                run str/gdsnovat.p ('Уч+накл-НДС':U,
     4698                        b_trn-doc.obj-type,
     4699                        b_trn-doc.obj-code,
     4700                        b_trn-doc.host-code,
     4701                        b_doc-line.artic,
     4702                        b_doc-line.prod-type,
     4703                        b_doc-line.prod-code,
     4704                        0 ,
     4705                        b_doc-line.doc-code,
     4706                        ?,
     4707                        ?,
     4708                        output cost-base   ,
     4709                        output cost-rubl   ,
     4710                        output v-price-base  ,
     4711                        output v-price-rubl  ,
     4712                        output cur-rt-base ,
     4713                        output cur-rt-rubl ).
     4714                        if var-pr-r-b = "rubl"
     4715                           then l_price = v-price-rubl.
     4716                           else l_price = v-price-base.
     4717           end.
     4718           when "sale":u then do:
     4719                 l_price = ( if var-pr-r-b = "rubl"
     4720                                then b_doc-line.price-rubl
     4721                                else b_doc-line.price-base ).
     4722           end.
     4723           when "prod":u then do:
     4724   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4725   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4726   (  input  b_price-doc-forming-gds.b-code
     4727    , input  p-obj-type
     4728    , input  p-obj-code
     4729    , output l_pricewithoutvat
     4730    , output l_price
     4731    , output l_prod-vat
     4732    , output v-str2
     4733    , output v-str2
     4734           )  .
     4735       end.
     4736      when "prod-vat":u then do:
     4737   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4739   (  input  b_price-doc-forming-gds.b-code
     4740    , input  p-obj-type
     4741    , input  p-obj-code
     4742    , output l_price
     4743    , output l_pricewithvat
     4744    , output l_prod-vat
     4745    , output v-str2
     4746    , output v-str2
     4747           )  .
     4748       end.
     4749         end case.
     4750           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     4751           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     4752      end.
     4753   end.
     4754     if  p-prc-max <> ? then do:
     4755       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     4756       then do:
     4757         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     4758             else "По признаку"  )
     4759             b_price-doc-forming-gds.artic
     4760             b_price-doc-forming-gds.prod-type
     4761             b_price-doc-forming-gds.prod-code skip
     4762             "бар-код: " b_price-doc-forming-gds.b-code
     4763              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     4764                else "" ) skip
     4765             fnc-pr  (buffer b_price-doc-forming-gds)
     4766             skip
     4767           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     4768           "Процент не менее :" p-prc-min "%" skip
     4769           "Процент не более :" p-prc-max "%" skip
     4770           "Процент фактический :" t-prc  "%"  skip
     4771           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     4772           "БД" b_price-doc-forming-gds.pdf-db
     4773             view-as alert-box error .
     4774                 p-err = true .
     4775                 undo , return error .
     4776       end.
     4777       else do:
     4778          if  t-prc = ? then  do:
     4779             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     4780             else "По признаку"  )
     4781             b_price-doc-forming-gds.artic
     4782             b_price-doc-forming-gds.prod-type
     4783             b_price-doc-forming-gds.prod-code skip
     4784             "бар-код: " b_price-doc-forming-gds.b-code
     4785              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     4786                else "" ) skip
     4787             fnc-pr  (buffer b_price-doc-forming-gds)
     4788             skip
     4789             "Нет базовой цены для расчета процента наценки !" skip
     4790             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     4791             "Процент не менее :" p-prc-min "%" skip
     4792             "Процент не более :" p-prc-max "%" skip
     4793             "Процент фактический :" t-prc  "%"  skip
     4794             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     4795             "БД" b_price-doc-forming-gds.pdf-db
     4796             view-as alert-box error .
     4797             p-err = true .
     4798             undo , return error .
     4799          end.
     4800       end.
     4801     end.
     4802   end.
     4803     end.
     4804   end procedure.
     4805   procedure del-doc-line :
     4806   define input  parameter p-recid as recid no-undo .
     4807     do
     4808     on error undo, return error return-value
     4809     :
     4810     find first ub.price-doc-forming-gds exclusive-lock where
     4811          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     4812      if available ub.price-doc-forming-gds then do:
     4813         delete ub.price-doc-forming-gds no-error .
     4814      end.
     4815     end.
     4816   end procedure.
     4817   def var vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4818   procedure check-use-bar-code :
     4819     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     4820     do
     4821     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info60, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4822     on stop   undo, return error substitute( "&1. stop", vss-include-info60 )
     4823     on endkey undo, return error substitute( "&1. endkey", vss-include-info60 )
     4824     :
     4825       define buffer buf_bar-code for ub.bar-code .
     4826       find first buf_bar-code no-lock
     4827         where buf_bar-code.b-code     = p-b-code
     4828         no-error .
     4829       if not available buf_bar-code then do:
     4830         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info60, p-b-code ) .
     4831       end.
     4832       if buf_bar-code.stts = integer('99':U) then do:
     4833         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     4834                                 + "Выполняется удаление бар-кода"
     4835                                 ,vss-include-info60
     4836                                 ,p-b-code
     4837                                 ,chr(10)
     4838                               ) .
     4839       end.
     4840       if buf_bar-code.stts = integer('79':U) then do:
     4841         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     4842                                 + "Бар-код выключен"
     4843                                 ,vss-include-info60
     4844                                 ,p-b-code
     4845                                 ,chr(10)
     4846                               ) .
     4847       end.
     4848       return .
     4849     end.
     4850   end procedure.
